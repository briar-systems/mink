# the format registry's tables, checked and rendered as mach source
#
# every format mink is built with is one line of LISTED: its registration,
# the module that holds it and, for one with pairs, the module that holds
# them, each with the alias the table imports it by. the generator checks
# every registration, its pairs, each pair's relocation set and every entry
# of the link's table of formats, refusing any that does not hold, and
# renders mink.format.builtin from them: the
# registrations in listed order, the readers index in the same order, and
# the lookup of every pair's relocation set, ascending by format name, then
# architecture name. mink reads the tables as they are and checks nothing
# when it runs. the layout is the one `mach fmt` keeps: one declaration per
# paragraph and each literal on one line.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.vectors;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use mink.catalog.format.Format;
use format_ar: mink.format.ar;
use mink.format.ar.write.Variant;
use format_coff: mink.format.coff;
use coff_pairs:  mink.format.coff.pairs;
use mink.format.contract;
use mink.format.contract.Identify;
use mink.format.contract.Reader;
use format_elf:   mink.format.elf;
use elf_pairs:    mink.format.elf.pairs;
use format_flat:  mink.format.flat;
use format_macho: mink.format.macho;
use macho_pairs:  mink.format.macho.pairs;
use mink.format.pair;
use mink.format.pair.Pair;
use mink.format.readers;
use mink.format.registration.Registration;
use format_res:       mink.format.res;
use format_spirv:     mink.format.spirv;
use spirv_reloc:      mink.format.spirv.reloc;
use format_tbd:       mink.format.tbd;
use format_universal: mink.format.universal;
use format_wasm:      mink.format.wasm;
use wasm_reloc:       mink.format.wasm.reloc;
use mink.link.formats;
use mink.link.formats.Entry;
use mink.link.template;
use mink.link.template.Arched;
use mink.reloc.field;
use mink.reloc.row;
use mink.reloc.row.Lookup;
use mink.reloc.row.Paired;
use mink.reloc.row.Row;
use mink.reloc.row.Set;

# the table's path under mink's root
pub val PATH: str = "src/format/builtin.mach";

# a format mink is built with, as the table names it
# ---
# registration: its registration
# module:       the module that holds the registration and its reader
# alias:        the alias the table imports the module by
# reader:       its reader, the module's READER, none for a format mink only
#               writes
# pairs:        its pairs, the pairs module's PAIRS, none for a format with
#               none
# pairs_module: the module that holds its pairs, nil for none
# pairs_alias:  the alias the table imports that module by, nil for none
rec Listed {
    registration: *Registration;
    module:       str;
    alias:        str;
    reader:       opt[*Reader];
    pairs:        opt[*Pair];
    pairs_module: str;
    pairs_alias:  str;
}

# the formats mink is built with, one line each, in registration order
val LISTED_COUNT: usize                = 10;
val LISTED:       [LISTED_COUNT]Listed = [LISTED_COUNT]Listed{
    Listed{registration: ?format_ar.REGISTRATION, module: "mink.format.ar", alias: "format_ar", reader: opt[*Reader].some{?format_ar.READER}, pairs: opt[*Pair].none{}},
    Listed{registration: ?format_coff.REGISTRATION, module: "mink.format.coff", alias: "format_coff", reader: opt[*Reader].some{?format_coff.READER}, pairs: opt[*Pair].some{?coff_pairs.PAIRS[0]}, pairs_module: "mink.format.coff.pairs", pairs_alias: "coff_pairs"},
    Listed{registration: ?format_elf.REGISTRATION, module: "mink.format.elf", alias: "format_elf", reader: opt[*Reader].some{?format_elf.READER}, pairs: opt[*Pair].some{?elf_pairs.PAIRS[0]}, pairs_module: "mink.format.elf.pairs", pairs_alias: "elf_pairs"},
    Listed{registration: ?format_flat.REGISTRATION, module: "mink.format.flat", alias: "format_flat", reader: opt[*Reader].none{}, pairs: opt[*Pair].none{}},
    Listed{registration: ?format_macho.REGISTRATION, module: "mink.format.macho", alias: "format_macho", reader: opt[*Reader].some{?format_macho.READER}, pairs: opt[*Pair].some{?macho_pairs.PAIRS[0]}, pairs_module: "mink.format.macho.pairs", pairs_alias: "macho_pairs"},
    Listed{registration: ?format_res.REGISTRATION, module: "mink.format.res", alias: "format_res", reader: opt[*Reader].some{?format_res.READER}, pairs: opt[*Pair].none{}},
    Listed{registration: ?format_spirv.REGISTRATION, module: "mink.format.spirv", alias: "format_spirv", reader: opt[*Reader].some{?format_spirv.READER}, pairs: opt[*Pair].some{?spirv_reloc.PAIRS[0]}, pairs_module: "mink.format.spirv.reloc", pairs_alias: "spirv_reloc"},
    Listed{registration: ?format_tbd.REGISTRATION, module: "mink.format.tbd", alias: "format_tbd", reader: opt[*Reader].some{?format_tbd.READER}, pairs: opt[*Pair].none{}},
    Listed{registration: ?format_universal.REGISTRATION, module: "mink.format.universal", alias: "format_universal", reader: opt[*Reader].some{?format_universal.READER}, pairs: opt[*Pair].none{}},
    Listed{registration: ?format_wasm.REGISTRATION, module: "mink.format.wasm", alias: "format_wasm", reader: opt[*Reader].some{?format_wasm.READER}, pairs: opt[*Pair].some{?wasm_reloc.PAIRS[0]}, pairs_module: "mink.format.wasm.reloc", pairs_alias: "wasm_reloc"},
};

# a pair's relocation set with the lookup the generator built of it
# ---
# lookup: the lookup, its tables in the run's allocator
# listed: the format whose pair it is
# pair:   the pair's position among the format's pairs
rec Built {
    lookup: Lookup;
    listed: *Listed;
    pair:   usize;
}

# a position named by `name`, for ordering positions by name
rec Named {
    name: str;
    at:   u32;
}

fun by_name(a: *Named, b: *Named) i64 {
    ret str_compare(a.name, b.name);
}

# a row with its position in its set, for ordering positions by their rows
rec Ranked {
    row: *Row;
    at:  u32;
}

fun by_reading(a: *Ranked, b: *Ranked) i64 {
    ret row.reading_order(a.row, b.row);
}

fun by_kind(a: *Ranked, b: *Ranked) i64 {
    ret row.kind_order(a.row, b.row);
}

fun by_placing(a: *Ranked, b: *Ranked) i64 {
    ret row.placed_order(a.row, b.row);
}

fun by_width(a: *Paired, b: *Paired) i64 {
    if (a.bits < b.bits) { ret -1; }
    if (a.bits > b.bits) { ret 1; }
    ret 0;
}

fun by_pair(a: *Built, b: *Built) i64 {
    val f: i64 = str_compare(a.lookup.set.format.name, b.lookup.set.format.name);
    if (f != 0) { ret f; }
    ret str_compare(a.lookup.set.arch.name, b.lookup.set.arch.name);
}

# the positions of `items` once sorted under `cmp`, in `a`
fun positions(a: *A.Allocator, items: *Vector[Ranked], cmp: fun(*Ranked, *Ranked) i64) res[*u32, Fail] {
    val n: usize = vector.length[Ranked](items);
    if (n == 0) { ret res[*u32, Fail].ok{nil}; }
    sort.sort_by[Ranked](items.data, n, cmp);
    var out: Vector[u32] = vector.init[u32](a);
    var i:   usize       = 0;
    for (i < n) {
        val p: err[Fail] = vectors.push[u32](?out, items.data[i].at);
        if (sel p.err) { ret res[*u32, Fail].err{p.err}; }
        i = i + 1;
    }
    ret res[*u32, Fail].ok{out.data};
}

# the position of the one row of `l` that reads `key`, none when no row or
# several do
fun reader_of_key(l: *Lookup, key: u32) opt[u32] {
    val r: res[*Row, Fail] = row.by_key(l, key);
    if (sel r.err) { ret opt[u32].none{}; }
    var i: usize = 0;
    for (i < l.key_count) {
        if (?l.set.rows[l.keys[i]::usize] == r.ok) { ret opt[u32].some{l.keys[i]}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the difference rows of `l`'s set with the rows they write, ascending by
# width, and their positions ascending by the name of their kind
fun pair_differences(a: *A.Allocator, l: *Lookup) err[Fail] {
    val s: *Set = l.set;
    l.paired_count = s.difference_count;
    if (s.difference_count == 0) { ret err[Fail].ok{}; }
    var paired: Vector[Paired] = vector.init[Paired](a);
    var i:      usize          = 0;
    for (i < s.difference_count) {
        val d:    *row.Difference = ?s.differences[i];
        val plus: opt[u32]        = reader_of_key(l, d.plus);
        if (sel plus.none) { ret err[Fail].err{fail.in_indexed(fail.internal("difference row adds with a record that has no row"), "difference row", i::u64)}; }
        val minus: opt[u32] = reader_of_key(l, d.minus);
        if (sel minus.none) { ret err[Fail].err{fail.in_indexed(fail.internal("difference row subtracts with a record that has no row"), "difference row", i::u64)}; }
        val bits: u32       = field.width(s.rows[plus.some::usize].fields[0].field);
        val p:    err[Fail] = vectors.push[Paired](?paired, Paired{difference: i::u32, plus: plus.some, minus: minus.some, bits: bits});
        if (sel p.err) { ret p; }
        i = i + 1;
    }
    sort.sort_by[Paired](paired.data, s.difference_count, by_width);
    l.paired = paired.data;
    var kinds: Vector[Named] = vector.init[Named](a);
    i = 0;
    for (i < s.difference_count) {
        val d: *row.Difference = ?s.differences[paired.data[i].difference::usize];
        val p: err[Fail]       = vectors.push[Named](?kinds, Named{name: d.kind.name, at: i::u32});
        if (sel p.err) { ret p; }
        i = i + 1;
    }
    sort.sort_by[Named](kinds.data, s.difference_count, by_name);
    var at: Vector[u32] = vector.init[u32](a);
    i = 0;
    for (i < s.difference_count) {
        val p: err[Fail] = vectors.push[u32](?at, kinds.data[i].at);
        if (sel p.err) { ret p; }
        i = i + 1;
    }
    l.paired_kinds = at.data;
    ret err[Fail].ok{};
}

# the lookup of the set `s`, built in `a` and checked
fun lookup_of(a: *A.Allocator, s: *Set) res[Lookup, Fail] {
    var l:     Lookup         = Lookup{set: s, key_count: s.count};
    var keys:  Vector[Ranked] = vector.init[Ranked](a);
    var kinds: Vector[Ranked] = vector.init[Ranked](a);
    var place: Vector[Ranked] = vector.init[Ranked](a);
    var i:     usize          = 0;
    for (i < s.count + s.write_count) {
        var r: *Row = nil;
        if (i < s.count) {
            r = ?s.rows[i];
            val k: err[Fail] = vectors.push[Ranked](?keys, Ranked{row: r, at: i::u32});
            if (sel k.err) { ret res[Lookup, Fail].err{k.err}; }
        }
        or                                         { r = ?s.writes[i - s.count]; }
        if (r.field_count == 0 || r.fields == nil) { ret res[Lookup, Fail].err{fail.in_indexed(fail.internal("relocation row has no field"), "relocation row", i::u64)}; }
        if (row.writes_kind(r)) {
            val w: err[Fail] = vectors.push[Ranked](?kinds, Ranked{row: r, at: i::u32});
            if (sel w.err) { ret res[Lookup, Fail].err{w.err}; }
        }
        or (row.places(r)) {
            val p: err[Fail] = vectors.push[Ranked](?place, Ranked{row: r, at: i::u32});
            if (sel p.err) { ret res[Lookup, Fail].err{p.err}; }
        }
        i = i + 1;
    }
    val k: res[*u32, Fail] = positions(a, ?keys, by_reading);
    if (sel k.err) { ret res[Lookup, Fail].err{k.err}; }
    l.keys = k.ok;
    val w: res[*u32, Fail] = positions(a, ?kinds, by_kind);
    if (sel w.err) { ret res[Lookup, Fail].err{w.err}; }
    l.kinds      = w.ok;
    l.kind_count = vector.length[Ranked](?kinds);
    val p: res[*u32, Fail] = positions(a, ?place, by_placing);
    if (sel p.err) { ret res[Lookup, Fail].err{p.err}; }
    l.placed       = p.ok;
    l.placed_count = vector.length[Ranked](?place);
    val d: err[Fail] = pair_differences(a, ?l);
    if (sel d.err) { ret res[Lookup, Fail].err{d.err}; }
    val c: err[Fail] = row.check(a, ?l);
    if (sel c.err) { ret res[Lookup, Fail].err{c.err}; }
    val v: err[Fail] = vendors(a, s);
    if (sel v.err) { ret res[Lookup, Fail].err{v.err}; }
    ret res[Lookup, Fail].ok{l};
}

# every vendor set of `s` holds and every vendor is named once
fun vendors(a: *A.Allocator, s: *Set) err[Fail] {
    var i: usize = 0;
    for (i < s.vendor_count) {
        val v: *row.Vendor = ?s.vendors[i];
        var j: usize       = 0;
        for (j < i) {
            if (str_equals(s.vendors[j].symbol, v.symbol)) { ret err[Fail].err{fail.in_indexed(fail.internal("two vendor sets share a vendor"), "vendor set", i::u64)}; }
            j = j + 1;
        }
        val b: res[Lookup, Fail] = lookup_of(a, v.set);
        if (sel b.err) { ret err[Fail].err{fail.in_indexed(b.err, "vendor set", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the listed format whose registration names `f`, none when none does
fun listed_by_format(f: *Format) opt[*Listed] {
    var i: usize = 0;
    for (i < LISTED_COUNT) {
        if (LISTED[i].registration.format == f) { ret opt[*Listed].some{?LISTED[i]}; }
        i = i + 1;
    }
    ret opt[*Listed].none{};
}

# refuse a registration whose archive variant is a thin one, which holds
# references to files and so is never a static library's variant
fun archive_holds(r: *Registration) err[Fail] {
    val v: opt[*Variant] = r.archive;
    if (sel v.none)  { ret err[Fail].ok{}; }
    if (v.some.thin) { ret err[Fail].err{fail.in_record(fail.internal("a format's archive variant is a thin one"), r.format.name)}; }
    ret err[Fail].ok{};
}

# refuse an entry of the link's table of formats that does not hold: a
# format listed twice or not registered, one that links as another without
# naming its image writer, as one not listed, as one that links as another
# or while its registration states an archive variant, and a code template
# set of an architecture the format has no pair for, of an architecture
# named twice, or with a template no relocation row of its pair patches
fun linking_holds(built: *Vector[Built]) err[Fail] {
    var i: usize = 0;
    for (i < formats.count()) {
        val e: *Entry = formats.at(i);
        var j: usize  = 0;
        for (j < i) {
            if (formats.at(j).format == e.format) { ret err[Fail].err{fail.in_record(fail.internal("the link's table lists a format twice"), e.format.name)}; }
            j = j + 1;
        }
        val listed: opt[*Listed] = listed_by_format(e.format);
        if (sel listed.none) { ret err[Fail].err{fail.in_record(fail.internal("the link's table lists a format that is not registered"), e.format.name)}; }
        val via: opt[*Format] = e.links_as;
        if (sel via.some) {
            if (sel e.linking.writer.none)                 { ret err[Fail].err{fail.in_record(fail.internal("a format that links as another names no image writer"), e.format.name)}; }
            if (sel listed.some.registration.archive.some) { ret err[Fail].err{fail.in_record(fail.internal("a format that links as another states an archive variant"), e.format.name)}; }
            val base: res[*Entry, Fail] = formats.of(via.some);
            if (sel base.err)              { ret err[Fail].err{fail.about(fail.in_record(fail.internal("a format links as one that has no link of its own"), e.format.name), via.some.name)}; }
            if (sel base.ok.links_as.some) { ret err[Fail].err{fail.about(fail.in_record(fail.internal("a format links as one that links as another"), e.format.name), via.some.name)}; }
        }
        val sets: *template.Sets = ?e.linking.templates;
        j = 0;
        for (j < sets.count) {
            val s: *Arched = ?sets.rows[j];
            var k: usize   = 0;
            for (k < j) {
                if (sets.rows[k].arch == s.arch) { ret err[Fail].err{fail.about(fail.in_record(fail.internal("two code template sets name one architecture"), e.format.name), s.arch.name)}; }
                k = k + 1;
            }
            val lookup: res[*Lookup, Fail] = built_of(built, e.format, s.arch);
            if (sel lookup.err) { ret err[Fail].err{fail.about(fail.in_record(lookup.err, e.format.name), s.arch.name)}; }
            val c: err[Fail] = template.check(s.set, lookup.ok);
            if (sel c.err) { ret err[Fail].err{fail.about(fail.in_record(c.err, e.format.name), s.arch.name)}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# refuse the reader of the listed format at `i`: one the line does not name
# as the registration does, one of another format, one that identifies its
# files by no magic, and one whose magic could match an input an earlier
# reader's magic matches
fun reader_holds(i: usize) err[Fail] {
    val l:      *Listed       = ?LISTED[i];
    val r:      *Registration = l.registration;
    val stated: opt[*Reader]  = r.reader;
    if (sel stated.none) {
        if (sel l.reader.some) { ret err[Fail].err{fail.in_record(fail.internal("the generator lists a reader the registration does not name"), r.format.name)}; }
        ret err[Fail].ok{};
    }
    if (sel l.reader.none)            { ret err[Fail].err{fail.in_record(fail.internal("the generator lists no reader for a registration that names one"), r.format.name)}; }
    if (l.reader.some != stated.some) { ret err[Fail].err{fail.in_record(fail.internal("the generator lists another reader than the registration names"), r.format.name)}; }
    val rd: *Reader = stated.some;
    if (rd.format != r.format) { ret err[Fail].err{fail.in_record(fail.internal("a registration's reader reads another format"), r.format.name)}; }
    val id: Identify = rd.codec.identify;
    if (!sel id.magics)       { ret err[Fail].ok{}; }
    if (id.magics.count == 0) { ret err[Fail].err{fail.in_record(fail.internal("format registers no magic"), r.format.name)}; }
    var j: usize = 0;
    for (j < i) {
        val other: opt[*Reader] = LISTED[j].registration.reader;
        j = j + 1;
        if (sel other.none)                                         { cnt; }
        if (readers.claims_shared(?other.some.codec.identify, ?id)) { ret err[Fail].err{fail.in_record(fail.internal("two formats claim one magic"), r.format.name)}; }
    }
    ret err[Fail].ok{};
}

# the built lookup of the pair (`f`, `a`)
fun built_of(built: *Vector[Built], f: *Format, a: *Arch) res[*Lookup, Fail] {
    var i: usize = 0;
    for (i < vector.length[Built](built)) {
        val b: *Built = ?built.data[i];
        if (b.lookup.set.format == f && b.lookup.set.arch == a) { ret res[*Lookup, Fail].ok{?b.lookup}; }
        i = i + 1;
    }
    ret res[*Lookup, Fail].err{fail.internal("no relocation set was built for this pair")};
}

# refuse the pairs of `l` that do not hold: a pair whose code or relocation
# rows are not its own, or two pairs of one architecture
fun pairs_hold(l: *Listed) err[Fail] {
    val r: *Registration = l.registration;
    var i: usize         = 0;
    for (i < r.pair_count) {
        val p: *Pair = ?r.pairs[i];
        if (!pair.sound(p, r.format)) { ret err[Fail].err{fail.about(fail.in_record(fail.internal("a pair's code or relocation rows are not its own"), r.format.name), p.arch.name)}; }
        var j: usize = 0;
        for (j < i) {
            if (r.pairs[j].arch == p.arch) { ret err[Fail].err{fail.about(fail.in_record(fail.internal("two pairs name one architecture"), r.format.name), p.arch.name)}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# check every listed registration and build the lookup of each of its pairs'
# relocation sets into `built`, then check the link's table of formats
# against them, refusing the first that does not hold
fun admit(a: *A.Allocator, built: *Vector[Built]) err[Fail] {
    var i: usize = 0;
    for (i < LISTED_COUNT) {
        val l: *Listed       = ?LISTED[i];
        val r: *Registration = l.registration;
        if (r.revision_count == 0) { ret err[Fail].err{fail.in_record(fail.internal("format registers no revision"), r.format.name)}; }
        var j: usize = 0;
        for (j < i) {
            val other: *Format = LISTED[j].registration.format;
            if (other == r.format || str_equals(other.name, r.format.name)) { ret err[Fail].err{fail.in_record(fail.internal("two registrations name one format"), r.format.name)}; }
            j = j + 1;
        }
        val rd: err[Fail] = reader_holds(i);
        if (sel rd.err) { ret rd; }
        if (r.pair_count > 0) {
            if (sel l.pairs.none)        { ret err[Fail].err{fail.in_record(fail.internal("the generator lists no pairs for a registration that names them"), r.format.name)}; }
            if (l.pairs.some != r.pairs) { ret err[Fail].err{fail.in_record(fail.internal("the generator lists other pairs than the registration names"), r.format.name)}; }
        }
        or (sel l.pairs.some) { ret err[Fail].err{fail.in_record(fail.internal("the generator lists pairs for a registration that names none"), r.format.name)}; }
        j = 0;
        for (j < r.pair_count) {
            val s: *Set              = r.pairs[j].relocs;
            val b: res[Lookup, Fail] = lookup_of(a, s);
            if (sel b.err) { ret err[Fail].err{fail.about(fail.in_record(b.err, s.format.name), s.arch.name)}; }
            val p: err[Fail] = vectors.push[Built](built, Built{lookup: b.ok, listed: l, pair: j});
            if (sel p.err) { ret p; }
            j = j + 1;
        }
        val ph: err[Fail] = pairs_hold(l);
        if (sel ph.err) { ret ph; }
        val ah: err[Fail] = archive_holds(r);
        if (sel ah.err)                                                     { ret ah; }
        if (sel r.traits.some && !contract.consistent_codec(r.traits.some)) { ret err[Fail].err{fail.in_record(fail.internal("a trait codec's encodings do not ascend by axis"), r.format.name)}; }
        i = i + 1;
    }
    val n: usize = vector.length[Built](built);
    sort.sort_by[Built](built.data, n, by_pair);
    i = 1;
    for (i < n) {
        if (by_pair(?built.data[i - 1], ?built.data[i]) == 0) { ret err[Fail].err{fail.in_record(fail.internal("two relocation sets bind one pair"), built.data[i].lookup.set.format.name)}; }
        i = i + 1;
    }
    ret linking_holds(built);
}

# the writes of one rendering, the first failure kept
rec Out {
    s:      *Sink;
    failed: bool;
    first:  Fail;
}

fun keep(o: *Out, e: err[Fail]) {
    if (o.failed) { ret; }
    if (sel e.err) {
        o.failed = true;
        o.first  = e.err;
    }
}

fun t(o: *Out, text: str) {
    keep(o, sink.text(o.s, text));
}

fun n(o: *Out, v: u64) {
    keep(o, sink.number(o.s, v, 10));
}

# `text` in upper case, any byte but a letter or a digit an underscore
fun upper(o: *Out, text: str) {
    var i: usize = 0;
    for (text[i] != 0) {
        val c: u8 = text[i];
        if (c >= 'a' && c <= 'z') { keep(o, sink.u8(o.s, c - 32)); }
        or (c >= 'A' && c <= 'Z') { keep(o, sink.u8(o.s, c)); }
        or (c >= '0' && c <= '9') { keep(o, sink.u8(o.s, c)); }
        or                        { keep(o, sink.u8(o.s, '_')); }
        i = i + 1;
    }
}

# the name of the array `part` of the lookup `b`
fun array_name(o: *Out, b: *Built, part: str) {
    upper(o, b.lookup.set.format.name);
    t(o, "_");
    upper(o, b.lookup.set.arch.name);
    t(o, "_");
    t(o, part);
}

# the `count` positions at `at` as the array `part` of `b`, nothing for none
fun position_array(o: *Out, b: *Built, part: str, at: *u32, count: usize) {
    if (count == 0) { ret; }
    t(o, "val ");
    array_name(o, b, part);
    t(o, ": [");
    n(o, count::u64);
    t(o, "]u32 = [");
    n(o, count::u64);
    t(o, "]u32{");
    var i: usize = 0;
    for (i < count) {
        if (i > 0) { t(o, ", "); }
        n(o, at[i]::u64);
        i = i + 1;
    }
    t(o, "};\n\n");
}

fun paired_array(o: *Out, b: *Built) {
    val l: *Lookup = ?b.lookup;
    if (l.paired_count == 0) { ret; }
    t(o, "val ");
    array_name(o, b, "PAIRED");
    t(o, ": [");
    n(o, l.paired_count::u64);
    t(o, "]Paired = [");
    n(o, l.paired_count::u64);
    t(o, "]Paired{");
    var i: usize = 0;
    for (i < l.paired_count) {
        val p: *Paired = ?l.paired[i];
        if (i > 0) { t(o, ", "); }
        t(o, "Paired{difference: ");
        n(o, p.difference::u64);
        t(o, ", plus: ");
        n(o, p.plus::u64);
        t(o, ", minus: ");
        n(o, p.minus::u64);
        t(o, ", bits: ");
        n(o, p.bits::u64);
        t(o, "}");
        i = i + 1;
    }
    t(o, "};\n\n");
}

# a field of a lookup naming the array `part` of `b`, nil for none
fun reference(o: *Out, b: *Built, part: str, count: usize) {
    if (count == 0) {
        t(o, "nil");
        ret;
    }
    t(o, "?");
    array_name(o, b, part);
    t(o, "[0]");
}

fun lookup_line(o: *Out, b: *Built) {
    val l: *Lookup = ?b.lookup;
    t(o, "    Lookup{set: ");
    t(o, b.listed.pairs_alias);
    t(o, ".PAIRS[");
    n(o, b.pair::u64);
    t(o, "].relocs, keys: ");
    reference(o, b, "KEYS", l.key_count);
    t(o, ", key_count: ");
    n(o, l.key_count::u64);
    t(o, ", kinds: ");
    reference(o, b, "KINDS", l.kind_count);
    t(o, ", kind_count: ");
    n(o, l.kind_count::u64);
    t(o, ", placed: ");
    reference(o, b, "PLACED", l.placed_count);
    t(o, ", placed_count: ");
    n(o, l.placed_count::u64);
    t(o, ", paired: ");
    reference(o, b, "PAIRED", l.paired_count);
    t(o, ", paired_kinds: ");
    reference(o, b, "PAIRED_KINDS", l.paired_count);
    t(o, ", paired_count: ");
    n(o, l.paired_count::u64);
    t(o, "},\n");
}

# the longest alias the table imports a module by
fun widest() usize {
    var w: usize = 0;
    var i: usize = 0;
    for (i < LISTED_COUNT) {
        if (str_len(LISTED[i].alias) > w)                                       { w = str_len(LISTED[i].alias); }
        if (LISTED[i].pairs_alias != nil && str_len(LISTED[i].pairs_alias) > w) { w = str_len(LISTED[i].pairs_alias); }
        i = i + 1;
    }
    ret w;
}

# one import of `module` by `alias`, the module aligned past `width` as
# `mach fmt` aligns a run of aliased imports
fun import(o: *Out, alias: str, module: str, width: usize) {
    t(o, "use ");
    t(o, alias);
    t(o, ":");
    var pad: usize = str_len(alias);
    for (pad <= width) {
        t(o, " ");
        pad = pad + 1;
    }
    t(o, module);
    t(o, ";\n");
}

fun render_tables(o: *Out, built: *Vector[Built]) {
    val width: usize = widest();
    t(o, "# the formats mink is built with and the tables its registry is, generated\n");
    t(o, "# by gen from the registrations gen/src/registry.mach lists once it has\n");
    t(o, "# checked every one. regenerate it with gen, never by hand\n\n");
    t(o, "use std.types.size.usize;\n\n");
    t(o, "use mink.format.contract.Reader;\n");
    t(o, "use mink.format.registration.Registration;\n");
    t(o, "use mink.reloc.row.Lookup;\n");
    t(o, "use mink.reloc.row.Paired;\n\n");
    var i: usize = 0;
    for (i < LISTED_COUNT) {
        val l: *Listed = ?LISTED[i];
        import(o, l.alias, l.module, width);
        if (l.pairs_module != nil) { import(o, l.pairs_alias, l.pairs_module, width); }
        i = i + 1;
    }
    t(o, "\npub val ENTRY_COUNT: usize = ");
    n(o, LISTED_COUNT::u64);
    t(o, ";\n\npub val ENTRIES: [");
    n(o, LISTED_COUNT::u64);
    t(o, "]*Registration = [");
    n(o, LISTED_COUNT::u64);
    t(o, "]*Registration{\n");
    i = 0;
    for (i < LISTED_COUNT) {
        t(o, "    ?");
        t(o, LISTED[i].alias);
        t(o, ".REGISTRATION,\n");
        i = i + 1;
    }
    t(o, "};\n\n");
    var readers: usize = 0;
    i = 0;
    for (i < LISTED_COUNT) {
        if (sel LISTED[i].reader.some) { readers = readers + 1; }
        i = i + 1;
    }
    t(o, "pub val READER_COUNT: usize = ");
    n(o, readers::u64);
    t(o, ";\n\npub val READERS: [");
    n(o, readers::u64);
    t(o, "]*Reader = [");
    n(o, readers::u64);
    t(o, "]*Reader{\n");
    i = 0;
    for (i < LISTED_COUNT) {
        if (sel LISTED[i].reader.some) {
            t(o, "    ?");
            t(o, LISTED[i].alias);
            t(o, ".READER,\n");
        }
        i = i + 1;
    }
    t(o, "};\n\n");
    val count: usize = vector.length[Built](built);
    i = 0;
    for (i < count) {
        val b: *Built = ?built.data[i];
        position_array(o, b, "KEYS", b.lookup.keys, b.lookup.key_count);
        position_array(o, b, "KINDS", b.lookup.kinds, b.lookup.kind_count);
        position_array(o, b, "PLACED", b.lookup.placed, b.lookup.placed_count);
        paired_array(o, b);
        position_array(o, b, "PAIRED_KINDS", b.lookup.paired_kinds, b.lookup.paired_count);
        i = i + 1;
    }
    t(o, "pub val LOOKUP_COUNT: usize = ");
    n(o, count::u64);
    t(o, ";\n\npub val LOOKUPS: [");
    n(o, count::u64);
    t(o, "]Lookup = [");
    n(o, count::u64);
    t(o, "]Lookup{\n");
    i = 0;
    for (i < count) {
        lookup_line(o, ?built.data[i]);
        i = i + 1;
    }
    t(o, "};\n");
}

# the registry's tables, checked and rendered in a sink of their own. every
# lookup lives in `a`, which outlives the run
pub fun render(a: *A.Allocator) res[Sink, Fail] {
    var built: Vector[Built] = vector.init[Built](a);
    val c:     err[Fail]     = admit(a, ?built);
    if (sel c.err) { ret res[Sink, Fail].err{c.err}; }
    var s: Sink = sink.make(a, LITTLE);
    var o: Out  = Out{s: ?s};
    render_tables(?o, ?built);
    if (o.failed) {
        val dropped: err[Fail] = sink.release(?s);
        ret res[Sink, Fail].err{o.first};
    }
    ret res[Sink, Fail].ok{s};
}
