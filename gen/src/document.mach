# a json grammar file, parsed whole and read through checked lookups
#
# every lookup refuses what the generator expects and does not find, naming
# the file and the member, so a grammar the generator cannot read is found
# from the message alone. strings come back decoded, as owned text.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use json;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.format.contract.Input;

# a parsed grammar file
# ---
# file: the file it was read from, which its strings point into
# root: its top value
pub rec Document {
    file: *Input;
    root: json.Value;
}

fun refuse[T](d: *Document, text: str, subject: str) res[T, Fail] {
    ret res[T, Fail].err{fail.about(fail.in_file(fail.malformed(text), d.file.file), subject)};
}

# `f` parsed as json, refused at the offset of its first defect
pub fun read(a: *A.Allocator, f: *Input) res[Document, Fail] {
    val parsed: res[json.Value, json.JsonError] = json.parse(f.data, f.len, a);
    if (sel parsed.err) {
        val e: json.JsonError = parsed.err;
        if (sel e.syntax) { ret res[Document, Fail].err{fail.at_offset(fail.in_file(fail.malformed("the grammar is not json"), f.file), e.syntax::u64)}; }
        or (sel e.depth)  { ret res[Document, Fail].err{fail.at_offset(fail.in_file(fail.malformed("the grammar nests too deep"), f.file), e.depth::u64)}; }
        ret res[Document, Fail].err{fail.in_file(fail.refused(e.alloc), f.file)};
    }
    ret res[Document, Fail].ok{Document{file: f, root: parsed.ok}};
}

# member `key` of the object `v`
pub fun member(d: *Document, v: *json.Value, key: str) res[*json.Value, Fail] {
    if (v.kind != json.OBJECT) { ret refuse[*json.Value](d, "a value is not an object", key); }
    val found: opt[*json.Value] = json.value_find(v, key);
    if (sel found.none) { ret refuse[*json.Value](d, "a member is missing", key); }
    ret res[*json.Value, Fail].ok{found.some};
}

# member `key` of the object `v`, none when it is absent
pub fun optional(d: *Document, v: *json.Value, key: str) res[opt[*json.Value], Fail] {
    if (v.kind != json.OBJECT) { ret refuse[opt[*json.Value]](d, "a value is not an object", key); }
    ret res[opt[*json.Value], Fail].ok{json.value_find(v, key)};
}

# how many items the array `v` holds
pub fun count(d: *Document, v: *json.Value, subject: str) res[usize, Fail] {
    if (v.kind != json.ARRAY) { ret refuse[usize](d, "a value is not an array", subject); }
    ret res[usize, Fail].ok{v.count};
}

# item `i` of the array `v`, which `count` has bounded
pub fun item(v: *json.Value, i: usize) *json.Value {
    ret ?v.children[i];
}

# the decoded text of the string `v`, owned
pub fun text(a: *A.Allocator, d: *Document, v: *json.Value, subject: str) res[str, Fail] {
    if (v.kind != json.STRING) { ret refuse[str](d, "a value is not a string", subject); }
    val got: res[*u8, A.Error] = A.allocate[u8](a, v.str_len + 1);
    if (sel got.err) { ret res[str, Fail].err{fail.refused(got.err)}; }
    val decoded: res[usize, json.JsonError] = json.value_string_decode(v, got.ok, v.str_len);
    if (sel decoded.err) { ret refuse[str](d, "a string holds a malformed escape", subject); }
    val len: usize = decoded.ok;
    if (len > v.str_len) { ret refuse[str](d, "a string holds a malformed escape", subject); }
    got.ok[len] = 0;
    ret res[str, Fail].ok{got.ok};
}

# the integer `v`, written as a number or as a string of hexadecimal digits
# after `0x`, refused unless it fits in 32 bits
pub fun word(d: *Document, v: *json.Value, subject: str) res[u32, Fail] {
    if (v.kind == json.NUMBER && !json.value_is_float(v)) {
        val n: i64 = json.value_number(v);
        if (n < 0 || n > 0xFFFF_FFFF) { ret refuse[u32](d, "a number does not fit in a word", subject); }
        ret res[u32, Fail].ok{n::u32};
    }
    if (v.kind != json.STRING || v.str_len < 3 || v.str_len > 10 || v.str_val[0] != '0' || v.str_val[1] != 'x') {
        ret refuse[u32](d, "a value is not a number", subject);
    }
    var n: u32   = 0;
    var i: usize = 2;
    for (i < v.str_len) {
        val c: u8 = v.str_val[i];
        var x: u8 = 0;
        if (c >= '0' && c <= '9') { x = c - '0'; }
        or (c >= 'a' && c <= 'f') { x = c - 'a' + 10; }
        or (c >= 'A' && c <= 'F') { x = c - 'A' + 10; }
        or                        { ret refuse[u32](d, "a value is not a number", subject); }
        n = (n << 4) | x::u32;
        i = i + 1;
    }
    ret res[u32, Fail].ok{n};
}
