# the table generator program
#
# usage: gen [--check] [<mink root>]. it writes mink's generated tables, the
# SPIR-V grammar table and the format registry's, or with --check reports
# whether a committed one drifted from what the generator emits, and exits 1
# on drift or a refusal, a registration that does not hold among them. the
# root defaults to the working directory.

use std.print;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.arena;
use std.allocator.page;
use fs: std.filesystem;

use mink.base.diag;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.file;

use gen.run;
use gen.run.Outcome;

fun usage() i64 {
    print.eprintln("usage: gen [--check] [<mink root>]");
    ret 2;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var check: bool = false;
    var root:  str  = ".";
    var given: bool = false;
    var i:     i64  = 1;
    for (i < argc) {
        val arg: str = argv[i]::str;
        if (str_equals(arg, "--check")) { check = true; }
        or (!given && arg[0] != '-') {
            root  = arg;
            given = true;
        }
        or { ret usage(); }
        i = i + 1;
    }
    var back: A.Allocator;
    page.make(?back);
    var ar:       arena.Arena;
    var a:        A.Allocator;
    val err_made: err[A.Error] = arena.init(?ar, ?back, 1 << 24);
    if (sel err_made.err) {
        print.eprintln("gen: out of memory");
        ret 1;
    }
    arena.allocator(?a, ?ar);
    fin { arena.dnit(?ar); }
    val res_ran: res[Outcome, Fail] = run.run(?a, root, check);
    if (sel res_ran.err) {
        var s:          Sink      = sink.init(?a, LITTLE);
        val err_render: err[Fail] = diag.render(diag.PREFIX, res_ran.err, ?s);
        if (sel err_render.ok) {
            val err_emit: err[Fail] = file.emit(fs.STDERR, ?s);
        }
        ret 1;
    }
    if (sel res_ran.ok.changed) {
        print.eprintlnf("gen: {}:{}: differs from what the generator emits", res_ran.ok.changed.path, res_ran.ok.changed.line);
        ret 1;
    }
    ret 0;
}
