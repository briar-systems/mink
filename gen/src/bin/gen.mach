# the table generator program
#
# usage: gen [--check] [<mink root>]. it writes mink's generated SPIR-V
# grammar table, or with --check reports whether the committed one drifted
# from what the generator emits, and exits 1 on drift or a refusal. the root
# defaults to the working directory.

use std.print;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.arena;
use std.allocator.page;
use fs: std.filesystem;

use mink.base.diag;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.file;

use gen.emit;
use gen.run;
use gen.run.Outcome;

fun usage() i64 {
    print.eprintln("usage: gen [--check] [<mink root>]");
    ret 2;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var check: bool = false;
    var root:  str  = ".";
    var given: bool = false;
    var i:     i64  = 1;
    for (i < argc) {
        val arg: str = argv[i]::str;
        if (str_equals(arg, "--check")) { check = true; }
        or (!given && arg[0] != '-') {
            root  = arg;
            given = true;
        }
        or { ret usage(); }
        i = i + 1;
    }
    var back: A.Allocator;
    page.make(?back);
    var ar:   arena.Arena;
    var a:    A.Allocator;
    val made: err[A.Error] = arena.init(?ar, ?back, 1 << 24);
    if (sel made.err) {
        print.eprintln("gen: out of memory");
        ret 1;
    }
    arena.make(?a, ?ar);
    fin { arena.dnit(?ar); }
    val ran: res[Outcome, Fail] = run.run(?a, root, check);
    if (sel ran.err) {
        var s: Sink      = sink.make(?a, LITTLE);
        val r: err[Fail] = diag.render(ran.err, ?s);
        if (sel r.ok) {
            val e: err[Fail] = file.emit(fs.STDERR, ?s);
        }
        ret 1;
    }
    if (sel ran.ok.changed) {
        print.eprintlnf("gen: {}:{}: differs from what the generator emits", emit.PATH, ran.ok.changed);
        ret 1;
    }
    ret 0;
}
