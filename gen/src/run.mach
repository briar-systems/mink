# one run of the generator: the table written into mink's tree, or checked
#
# a run reads the vendored grammar under gen/vendor/spirv-headers of the
# tree it is given and nothing else, renders the table in memory, then writes
# it over the committed file or, checking, compares the two and reports the
# first line they differ at. nothing is ever fetched.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.contract.Input;
use mink.format.file;
use mink.format.file.Loaded;

use gen.emit;
use gen.spirv;
use gen.spirv.Grammar;

# what a run found
# ---
# written: the table was written
# same:    the committed table is what the generator emits
# changed: the committed table differs, first at this line, from 1
pub tag Outcome: u8 {
    written;
    same;
    changed: u64;
}

# the line of `want` at which `got` first differs from it, 0 for none
pub fun compare(want: *u8, want_len: usize, got: *u8, got_len: usize) u64 {
    var line: u64   = 1;
    var i:    usize = 0;
    for (i < want_len && i < got_len) {
        if (want[i] != got[i]) { ret line; }
        if (want[i] == '\n')   { line = line + 1; }
        i = i + 1;
    }
    if (want_len == got_len) { ret 0; }
    ret line;
}

fun joined(r: res[str, StrError]) res[str, Fail] {
    if (sel r.err) { ret res[str, Fail].err{fail.internal("a path cannot be joined")}; }
    ret res[str, Fail].ok{r.ok};
}

fun load(a: *A.Allocator, root: str, name: str) res[Loaded, Fail] {
    val path: res[str, Fail] = joined(str_join(a, root, "/gen/vendor/spirv-headers/", name));
    if (sel path.err) { ret res[Loaded, Fail].err{path.err}; }
    ret file.load(a, path.ok);
}

# the table rendered from the grammar vendored under `root`, mink's root,
# then written into its tree or, when `check` holds, compared with the one
# committed there. everything lives in `a`, which outlives the run
pub fun run(a: *A.Allocator, root: str, check: bool) res[Outcome, Fail] {
    val core: res[Loaded, Fail] = load(a, root, spirv.CORE);
    if (sel core.err) { ret res[Outcome, Fail].err{core.err}; }
    var core_file: Loaded = core.ok;
    var sets:      [spirv.SET_COUNT]Input;
    var i:         usize  = 0;
    for (i < spirv.SET_COUNT) {
        val s: res[Loaded, Fail] = load(a, root, spirv.SETS[i].file);
        if (sel s.err) { ret res[Outcome, Fail].err{s.err}; }
        sets[i] = s.ok.input;
        i       = i + 1;
    }
    val g: res[Grammar, Fail] = spirv.read(a, ?core_file.input, ?sets[0]);
    if (sel g.err) { ret res[Outcome, Fail].err{g.err}; }
    var grammar:  Grammar         = g.ok;
    val rendered: res[Sink, Fail] = emit.render(a, ?grammar);
    if (sel rendered.err) { ret res[Outcome, Fail].err{rendered.err}; }
    var out:  Sink           = rendered.ok;
    val path: res[str, Fail] = joined(str_join(a, root, "/", emit.PATH));
    if (sel path.err) { ret res[Outcome, Fail].err{path.err}; }
    if (!check) {
        val saved: err[Fail] = file.save(path.ok, ?out);
        if (sel saved.err) { ret res[Outcome, Fail].err{saved.err}; }
        ret res[Outcome, Fail].ok{Outcome.written{}};
    }
    val committed: res[Loaded, Fail] = file.load(a, path.ok);
    if (sel committed.err) { ret res[Outcome, Fail].err{committed.err}; }
    val line: u64 = compare(sink.data(?out), sink.len(?out), committed.ok.input.data, committed.ok.input.len);
    if (line == 0) { ret res[Outcome, Fail].ok{Outcome.same{}}; }
    ret res[Outcome, Fail].ok{Outcome.changed{line}};
}

test compare__a_committed_table_differs_first_at_the_line_it_changes {
    val want: str   = "# head\n\nval A: u32 = 1;\nval B: u32 = 2;\n";
    val got:  str   = "# head\n\nval A: u32 = 1;\nval B: u32 = 3;\n";
    val n:    usize = str_len(want);
    if (compare(want, n, want, n) != 0)  { ret 1; }
    if (compare(want, n, got, n) != 4)   { ret 2; }
    if (compare(want, n, want, 17) != 3) { ret 3; }
    ret 0;
}
