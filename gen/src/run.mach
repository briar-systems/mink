# one run of the generator: the tables written into mink's tree, or checked
#
# a run renders each table in memory, then writes it over the committed file
# or, checking, compares the two and reports the first line they differ at.
# the SPIR-V table reads the vendored grammar under gen/vendor/spirv-headers
# of the tree it is given and nothing else, and the registry's tables read
# the registrations mink is built with, refusing any that does not hold.
# nothing is ever fetched.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.contract.Input;
use mink.format.file;
use mink.format.file.Loaded;

use gen.emit;
use gen.registry;
use gen.spirv;
use gen.spirv.Grammar;

# a committed table that differs from what the generator emits
# ---
# path: the table's path under mink's root
# line: the line it first differs at, from 1
pub rec Drift {
    path: str;
    line: u64;
}

# what a run found
# ---
# written: the tables were written
# same:    every committed table is what the generator emits
# changed: a committed table differs
pub tag Outcome: u8 {
    written;
    same;
    changed: Drift;
}

# the line of `want` at which `got` first differs from it, 0 for none
pub fun compare(want: *u8, want_len: usize, got: *u8, got_len: usize) u64 {
    var line: u64   = 1;
    var i:    usize = 0;
    for (i < want_len && i < got_len) {
        if (want[i] != got[i]) { ret line; }
        if (want[i] == '\n')   { line = line + 1; }
        i = i + 1;
    }
    if (want_len == got_len) { ret 0; }
    ret line;
}

fun joined(r: res[str, StrError]) res[str, Fail] {
    if (sel r.err) { ret res[str, Fail].err{fail.internal("a path cannot be joined")}; }
    ret res[str, Fail].ok{r.ok};
}

fun load(a: *A.Allocator, root: str, name: str) res[Loaded, Fail] {
    val path: res[str, Fail] = joined(str_join(a, root, "/gen/vendor/spirv-headers/", name));
    if (sel path.err) { ret res[Loaded, Fail].err{path.err}; }
    ret file.load(a, path.ok);
}

# the table `out` written over the one at `path` under `root`, or when
# `check` holds compared with it
fun settle(a: *A.Allocator, root: str, path: str, out: *Sink, check: bool) res[Outcome, Fail] {
    val at: res[str, Fail] = joined(str_join(a, root, "/", path));
    if (sel at.err) { ret res[Outcome, Fail].err{at.err}; }
    if (!check) {
        val saved: err[Fail] = file.save(at.ok, out);
        if (sel saved.err) { ret res[Outcome, Fail].err{saved.err}; }
        ret res[Outcome, Fail].ok{Outcome.written{}};
    }
    val committed: res[Loaded, Fail] = file.load(a, at.ok);
    if (sel committed.err) { ret res[Outcome, Fail].err{committed.err}; }
    val line: u64 = compare(sink.data(out), sink.len(out), committed.ok.input.data, committed.ok.input.len);
    if (line == 0) { ret res[Outcome, Fail].ok{Outcome.same{}}; }
    ret res[Outcome, Fail].ok{Outcome.changed{Drift{path: path, line: line}}};
}

# the SPIR-V table rendered from the grammar vendored under `root`, mink's
# root
fun grammar_table(a: *A.Allocator, root: str) res[Sink, Fail] {
    val core: res[Loaded, Fail] = load(a, root, spirv.CORE);
    if (sel core.err) { ret res[Sink, Fail].err{core.err}; }
    var core_file: Loaded = core.ok;
    var sets:      [spirv.SET_COUNT]Input;
    var i:         usize  = 0;
    for (i < spirv.SET_COUNT) {
        val s: res[Loaded, Fail] = load(a, root, spirv.SETS[i].file);
        if (sel s.err) { ret res[Sink, Fail].err{s.err}; }
        sets[i] = s.ok.input;
        i       = i + 1;
    }
    val g: res[Grammar, Fail] = spirv.read(a, ?core_file.input, ?sets[0]);
    if (sel g.err) { ret res[Sink, Fail].err{g.err}; }
    var grammar: Grammar = g.ok;
    ret emit.render(a, ?grammar);
}

# every table rendered, then written into the tree under `root`, mink's
# root, or when `check` holds compared with the ones committed there, the
# first that differs reported. everything lives in `a`, which outlives the
# run
pub fun run(a: *A.Allocator, root: str, check: bool) res[Outcome, Fail] {
    val grammar: res[Sink, Fail] = grammar_table(a, root);
    if (sel grammar.err) { ret res[Outcome, Fail].err{grammar.err}; }
    val tables: res[Sink, Fail] = registry.render(a);
    if (sel tables.err) { ret res[Outcome, Fail].err{tables.err}; }
    var grammar_out: Sink               = grammar.ok;
    var tables_out:  Sink               = tables.ok;
    val first:       res[Outcome, Fail] = settle(a, root, emit.PATH, ?grammar_out, check);
    if (sel first.err)        { ret first; }
    if (sel first.ok.changed) { ret first; }
    ret settle(a, root, registry.PATH, ?tables_out, check);
}

test compare__a_committed_table_differs_first_at_the_line_it_changes {
    val want: str   = "# head\n\nval A: u32 = 1;\nval B: u32 = 2;\n";
    val got:  str   = "# head\n\nval A: u32 = 1;\nval B: u32 = 3;\n";
    val n:    usize = str_len(want);
    if (compare(want, n, want, n) != 0)  { ret 1; }
    if (compare(want, n, got, n) != 4)   { ret 2; }
    if (compare(want, n, want, 17) != 3) { ret 3; }
    ret 0;
}
