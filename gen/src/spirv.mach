# the SPIR-V grammar rows mink carries, read from the vendored grammar
#
# the generator reads the core grammar and the extended instruction set
# grammars named below, and keeps of them only the operand shapes: every
# operand kind, the enumerants that take parameters, every opcode's operands
# and every extended instruction's operands. a kind is resolved by its name,
# so a grammar that names a kind it never declares is refused naming it, as
# is an id or literal kind the generator has no shape for. where the grammar
# names a kind too wide for what the specification says of an operand, the
# generator adds a synthetic kind and overrides that operand with it.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;

use A: std.allocator;

use json;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.format.contract.Input;

use gen.document;
use gen.document.Document;

# the categories of an operand kind
pub val ID:         u8 = 0;
pub val LITERAL:    u8 = 1;
pub val COMPOSITE:  u8 = 2;
pub val VALUE_ENUM: u8 = 3;
pub val BIT_ENUM:   u8 = 4;

# how many times an operand occurs, as the grammar's quantifier states
pub val ONE:      u8 = 0;
pub val OPTIONAL: u8 = 1;
pub val MANY:     u8 = 2;

# the shape an id or literal kind takes, by its name in the grammar
rec Shaped {
    kind:  str;
    shape: str;
}

val SHAPED_COUNT: usize                = 11;
val SHAPED:       [SHAPED_COUNT]Shaped = [SHAPED_COUNT]Shaped{
    Shaped{kind: "IdMemorySemantics", shape: "id"},
    Shaped{kind: "IdRef", shape: "id"},
    Shaped{kind: "IdResult", shape: "result"},
    Shaped{kind: "IdResultType", shape: "result_type"},
    Shaped{kind: "IdScope", shape: "id"},
    Shaped{kind: "LiteralContextDependentNumber", shape: "number"},
    Shaped{kind: "LiteralExtInstInteger", shape: "instruction"},
    Shaped{kind: "LiteralFloat", shape: "word"},
    Shaped{kind: "LiteralInteger", shape: "word"},
    Shaped{kind: "LiteralSpecConstantOpInteger", shape: "opcode"},
    Shaped{kind: "LiteralString", shape: "string"},
};

# a grammar file of the vendored copy and, for an extended instruction set,
# the name an OpExtInstImport imports it by
pub rec Source {
    file: str;
    name: str;
}

# the core grammar
pub val CORE: str = "spirv.core.grammar.json";

# the extended instruction sets, ascending by name
pub val SET_COUNT: usize             = 3;
pub val SETS:      [SET_COUNT]Source = [SET_COUNT]Source{
    Source{file: "extinst.glsl.std.450.grammar.json", name: "GLSL.std.450"},
    Source{file: "extinst.nonsemantic.shader.debuginfo.100.grammar.json", name: "NonSemantic.Shader.DebugInfo.100"},
    Source{file: "extinst.opencl.std.100.grammar.json", name: "OpenCL.std"},
};

# a constant the generated table names for mink's code: an opcode by its
# name, or an enumerant of a kind
# ---
# constant: the constant's name
# kind:     the enumerant's kind, nil for an opcode
# name:     the opcode's or the enumerant's name in the grammar
pub rec Named {
    constant: str;
    kind:     str;
    name:     str;
}

pub val NAMED_COUNT: usize              = 36;
pub val NAMED:       [NAMED_COUNT]Named = [NAMED_COUNT]Named{
    Named{constant: "CAPABILITY_LINKAGE", kind: "Capability", name: "Linkage"},
    Named{constant: "DECORATION_LINKAGE_ATTRIBUTES", kind: "Decoration", name: "LinkageAttributes"},
    Named{constant: "LINKAGE_EXPORT", kind: "LinkageType", name: "Export"},
    Named{constant: "LINKAGE_IMPORT", kind: "LinkageType", name: "Import"},
    Named{constant: "LINKAGE_LINK_ONCE_ODR", kind: "LinkageType", name: "LinkOnceODR"},
    Named{constant: "OP_CAPABILITY", kind: nil, name: "OpCapability"},
    Named{constant: "OP_DECORATE", kind: nil, name: "OpDecorate"},
    Named{constant: "OP_DECORATE_ID", kind: nil, name: "OpDecorateId"},
    Named{constant: "OP_DECORATE_STRING", kind: nil, name: "OpDecorateString"},
    Named{constant: "OP_DECORATION_GROUP", kind: nil, name: "OpDecorationGroup"},
    Named{constant: "OP_ENTRY_POINT", kind: nil, name: "OpEntryPoint"},
    Named{constant: "OP_EXECUTION_MODE", kind: nil, name: "OpExecutionMode"},
    Named{constant: "OP_EXECUTION_MODE_ID", kind: nil, name: "OpExecutionModeId"},
    Named{constant: "OP_EXTENSION", kind: nil, name: "OpExtension"},
    Named{constant: "OP_EXT_INST", kind: nil, name: "OpExtInst"},
    Named{constant: "OP_EXT_INST_IMPORT", kind: nil, name: "OpExtInstImport"},
    Named{constant: "OP_FUNCTION", kind: nil, name: "OpFunction"},
    Named{constant: "OP_FUNCTION_END", kind: nil, name: "OpFunctionEnd"},
    Named{constant: "OP_GROUP_DECORATE", kind: nil, name: "OpGroupDecorate"},
    Named{constant: "OP_GROUP_MEMBER_DECORATE", kind: nil, name: "OpGroupMemberDecorate"},
    Named{constant: "OP_LABEL", kind: nil, name: "OpLabel"},
    Named{constant: "OP_LINE", kind: nil, name: "OpLine"},
    Named{constant: "OP_MEMBER_DECORATE", kind: nil, name: "OpMemberDecorate"},
    Named{constant: "OP_MEMBER_DECORATE_STRING", kind: nil, name: "OpMemberDecorateString"},
    Named{constant: "OP_MEMBER_NAME", kind: nil, name: "OpMemberName"},
    Named{constant: "OP_MEMORY_MODEL", kind: nil, name: "OpMemoryModel"},
    Named{constant: "OP_MODULE_PROCESSED", kind: nil, name: "OpModuleProcessed"},
    Named{constant: "OP_NAME", kind: nil, name: "OpName"},
    Named{constant: "OP_NO_LINE", kind: nil, name: "OpNoLine"},
    Named{constant: "OP_SOURCE", kind: nil, name: "OpSource"},
    Named{constant: "OP_SOURCE_CONTINUED", kind: nil, name: "OpSourceContinued"},
    Named{constant: "OP_SOURCE_EXTENSION", kind: nil, name: "OpSourceExtension"},
    Named{constant: "OP_STRING", kind: nil, name: "OpString"},
    Named{constant: "OP_TYPE_FLOAT", kind: nil, name: "OpTypeFloat"},
    Named{constant: "OP_TYPE_INT", kind: nil, name: "OpTypeInt"},
    Named{constant: "OP_VARIABLE", kind: nil, name: "OpVariable"},
};

# a kind the grammar does not declare, which the generator adds because the
# grammar names a kind too wide for what the specification says of an
# operand
# ---
# name:   its name
# shape:  the shape of a literal kind, nil for a composite
# first:  the first kind of a composite
# second: the second kind of a composite
rec Synthetic {
    name:   str;
    shape:  str;
    first:  str;
    second: str;
}

# OpSwitch's literals are as wide as its selector's type, where the grammar
# names a plain LiteralInteger
val SYNTHETIC_COUNT: usize                      = 2;
val SYNTHETIC:       [SYNTHETIC_COUNT]Synthetic = [SYNTHETIC_COUNT]Synthetic{
    Synthetic{name: "LiteralSelector", shape: "selector"},
    Synthetic{name: "PairLiteralSelectorIdRef", first: "LiteralSelector", second: "IdRef"},
};

# an operand of an opcode that takes a synthetic kind in place of the one the
# grammar names
rec Override {
    op:   str;
    from: str;
    to:   str;
}

val OVERRIDE_COUNT: usize                    = 1;
val OVERRIDES:      [OVERRIDE_COUNT]Override = [OVERRIDE_COUNT]Override{
    Override{op: "OpSwitch", from: "PairLiteralIntegerIdRef", to: "PairLiteralSelectorIdRef"},
};

# kind:       the index of its kind
# quantifier: how many times it occurs
pub rec Operand {
    kind:       usize;
    quantifier: u8;
}

# the operands of a row: where the first lies among the grammar's operands,
# and how many
pub rec Span {
    first: usize;
    count: usize;
}

pub rec Enumerant {
    value:    u32;
    name:     str;
    operands: Span;
}

# name:       its name in the grammar
# category:   its category
# shape:      the shape of an id or literal kind
# first:      the first kind of a composite
# second:     the second kind of a composite
# enumerants: the enumerants of an enum that take parameters, where the first
#             lies among the grammar's enumerants and how many
# used:       whether an operand of a row the table holds reaches it
# source:     its object in the grammar
pub rec Kind {
    name:       str;
    category:   u8;
    shape:      str;
    first:      usize;
    second:     usize;
    enumerants: Span;
    used:       bool;
    source:     *json.Value;
}

pub rec Op {
    code:     u32;
    name:     str;
    operands: Span;
}

pub rec Instruction {
    number:   u32;
    name:     str;
    operands: Span;
}

# name:         the name it is imported by
# instructions: where its first instruction lies among the grammar's, and how
#               many
pub rec Set {
    name:         str;
    instructions: Span;
}

# a constant the table names and its value
pub rec Constant {
    name:  str;
    value: u32;
}

# major, minor, revision: the version of the core grammar
# kinds: every operand kind, ascending by name
pub rec Grammar {
    a:            *A.Allocator;
    major:        u32;
    minor:        u32;
    revision:     u32;
    kinds:        Table[Kind];
    operands:     Table[Operand];
    enumerants:   Table[Enumerant];
    ops:          Table[Op];
    instructions: Table[Instruction];
    sets:         Table[Set];
    constants:    Table[Constant];
}

fun refuse[T](d: *Document, text: str, subject: str) res[T, Fail] {
    ret res[T, Fail].err{fail.about(fail.in_file(fail.malformed(text), d.file.file), subject)};
}

fun by_name(a: *Kind, b: *Kind) i64 {
    ret str_compare(a.name, b.name);
}

fun by_code(a: *Op, b: *Op) i64 {
    if (a.code < b.code) { ret -1; }
    if (a.code > b.code) { ret 1; }
    ret 0;
}

fun by_number(a: *Instruction, b: *Instruction) i64 {
    if (a.number < b.number) { ret -1; }
    if (a.number > b.number) { ret 1; }
    ret 0;
}

fun by_value(a: *Enumerant, b: *Enumerant) i64 {
    if (a.value < b.value) { ret -1; }
    if (a.value > b.value) { ret 1; }
    ret 0;
}

# the index of the kind named `name`, refused naming it when the core grammar
# declares none
fun kind_of(g: *Grammar, d: *Document, name: str) res[usize, Fail] {
    var probe: Kind           = Kind{name: name};
    val pos:   SearchPosition = sort.binary_search_by[Kind](table.items[Kind](?g.kinds), table.count[Kind](?g.kinds), ?probe, by_name);
    if (sel pos.found) { ret res[usize, Fail].ok{pos.found}; }
    ret refuse[usize](d, "an operand names a kind the core grammar does not declare", name);
}

fun category_of(d: *Document, name: str, c: str) res[u8, Fail] {
    if (str_equals(c, "Id"))        { ret res[u8, Fail].ok{ID}; }
    if (str_equals(c, "Literal"))   { ret res[u8, Fail].ok{LITERAL}; }
    if (str_equals(c, "Composite")) { ret res[u8, Fail].ok{COMPOSITE}; }
    if (str_equals(c, "ValueEnum")) { ret res[u8, Fail].ok{VALUE_ENUM}; }
    if (str_equals(c, "BitEnum"))   { ret res[u8, Fail].ok{BIT_ENUM}; }
    ret refuse[u8](d, "a kind is of a category the generator does not know", name);
}

fun shape_of(d: *Document, name: str) res[str, Fail] {
    var i: usize = 0;
    for (i < SHAPED_COUNT) {
        if (str_equals(SHAPED[i].kind, name)) { ret res[str, Fail].ok{SHAPED[i].shape}; }
        i = i + 1;
    }
    ret refuse[str](d, "an id or literal kind has no shape", name);
}

# append the operands the array `list` states to the grammar's
fun operands(g: *Grammar, d: *Document, list: opt[*json.Value]) res[Span, Fail] {
    val first: usize = table.count[Operand](?g.operands);
    if (sel list.none) { ret res[Span, Fail].ok{Span{first: first, count: 0}}; }
    val n: res[usize, Fail] = document.count(d, list.some, "operands");
    if (sel n.err) { ret res[Span, Fail].err{n.err}; }
    var i: usize = 0;
    for (i < n.ok) {
        val o:  *json.Value            = document.item(list.some, i);
        val kv: res[*json.Value, Fail] = document.member(d, o, "kind");
        if (sel kv.err) { ret res[Span, Fail].err{kv.err}; }
        val name: res[str, Fail] = document.text(g.a, d, kv.ok, "kind");
        if (sel name.err) { ret res[Span, Fail].err{name.err}; }
        val k: res[usize, Fail] = kind_of(g, d, name.ok);
        if (sel k.err) { ret res[Span, Fail].err{k.err}; }
        var q:  u8                          = ONE;
        val qv: res[opt[*json.Value], Fail] = document.optional(d, o, "quantifier");
        if (sel qv.err) { ret res[Span, Fail].err{qv.err}; }
        if (sel qv.ok.some) {
            val qt: res[str, Fail] = document.text(g.a, d, qv.ok.some, "quantifier");
            if (sel qt.err)             { ret res[Span, Fail].err{qt.err}; }
            if (str_equals(qt.ok, "?")) { q = OPTIONAL; }
            or (str_equals(qt.ok, "*")) { q = MANY; }
            or                          { ret refuse[Span](d, "an operand has an unknown quantifier", qt.ok); }
        }
        val p: res[Id[Operand], Fail] = table.push[Operand](?g.operands, Operand{kind: k.ok, quantifier: q});
        if (sel p.err) { ret res[Span, Fail].err{p.err}; }
        i = i + 1;
    }
    ret res[Span, Fail].ok{Span{first: first, count: n.ok}};
}

# every kind of the core grammar, ascending by name, with only its name,
# category and object read
fun declare(g: *Grammar, d: *Document) err[Fail] {
    val kv: res[*json.Value, Fail] = document.member(d, ?d.root, "operand_kinds");
    if (sel kv.err) { ret err[Fail].err{kv.err}; }
    val n: res[usize, Fail] = document.count(d, kv.ok, "operand_kinds");
    if (sel n.err) { ret err[Fail].err{n.err}; }
    var i: usize = 0;
    for (i < n.ok) {
        val o:  *json.Value            = document.item(kv.ok, i);
        val nv: res[*json.Value, Fail] = document.member(d, o, "kind");
        if (sel nv.err) { ret err[Fail].err{nv.err}; }
        val name: res[str, Fail] = document.text(g.a, d, nv.ok, "kind");
        if (sel name.err) { ret err[Fail].err{name.err}; }
        val cv: res[*json.Value, Fail] = document.member(d, o, "category");
        if (sel cv.err) { ret err[Fail].err{cv.err}; }
        val ct: res[str, Fail] = document.text(g.a, d, cv.ok, "category");
        if (sel ct.err) { ret err[Fail].err{ct.err}; }
        val c: res[u8, Fail] = category_of(d, name.ok, ct.ok);
        if (sel c.err) { ret err[Fail].err{c.err}; }
        var shape: str = nil;
        if (c.ok == ID || c.ok == LITERAL) {
            val s: res[str, Fail] = shape_of(d, name.ok);
            if (sel s.err) { ret err[Fail].err{s.err}; }
            shape = s.ok;
        }
        val p: res[Id[Kind], Fail] = table.push[Kind](?g.kinds, Kind{name: name.ok, category: c.ok, shape: shape, source: o});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < SYNTHETIC_COUNT) {
        val y: *Synthetic = ?SYNTHETIC[i];
        var c: u8         = LITERAL;
        if (y.shape == nil) { c = COMPOSITE; }
        val p: res[Id[Kind], Fail] = table.push[Kind](?g.kinds, Kind{name: y.name, category: c, shape: y.shape, source: nil});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    val at:    *Kind = table.items[Kind](?g.kinds);
    val count: usize = table.count[Kind](?g.kinds);
    sort.sort_by[Kind](at, count, by_name);
    i = 1;
    for (i < count) {
        if (str_equals(at[i - 1].name, at[i].name)) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("a kind is declared twice"), d.file.file), at[i].name)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bases of each composite and the enumerants of each enum that take
# parameters, every reference resolved
fun define(g: *Grammar, d: *Document) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind       = table.at[Kind](?g.kinds, table.nth[Kind](i));
        val o: *json.Value = k.source;
        if (o == nil) {
            i = i + 1;
            cnt;
        }
        if (k.category == COMPOSITE) {
            val bv: res[*json.Value, Fail] = document.member(d, o, "bases");
            if (sel bv.err) { ret err[Fail].err{bv.err}; }
            val n: res[usize, Fail] = document.count(d, bv.ok, "bases");
            if (sel n.err) { ret err[Fail].err{n.err}; }
            if (n.ok != 2) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("a composite kind is not a pair"), d.file.file), k.name)}; }
            val f: res[str, Fail] = document.text(g.a, d, document.item(bv.ok, 0), "bases");
            if (sel f.err) { ret err[Fail].err{f.err}; }
            val s: res[str, Fail] = document.text(g.a, d, document.item(bv.ok, 1), "bases");
            if (sel s.err) { ret err[Fail].err{s.err}; }
            val fk: res[usize, Fail] = kind_of(g, d, f.ok);
            if (sel fk.err) { ret err[Fail].err{fk.err}; }
            val sk: res[usize, Fail] = kind_of(g, d, s.ok);
            if (sel sk.err) { ret err[Fail].err{sk.err}; }
            val again: *Kind = table.at[Kind](?g.kinds, table.nth[Kind](i));
            again.first  = fk.ok;
            again.second = sk.ok;
        }
        or (k.category == VALUE_ENUM || k.category == BIT_ENUM) {
            val e: err[Fail] = enumerants(g, d, i);
            if (sel e.err) { ret e; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bases of every synthetic composite
fun synthesize(g: *Grammar, d: *Document) err[Fail] {
    var i: usize = 0;
    for (i < SYNTHETIC_COUNT) {
        val y: *Synthetic = ?SYNTHETIC[i];
        i = i + 1;
        if (y.shape != nil) { cnt; }
        val k: res[usize, Fail] = kind_of(g, d, y.name);
        if (sel k.err) { ret err[Fail].err{k.err}; }
        val f: res[usize, Fail] = kind_of(g, d, y.first);
        if (sel f.err) { ret err[Fail].err{f.err}; }
        val s: res[usize, Fail] = kind_of(g, d, y.second);
        if (sel s.err) { ret err[Fail].err{s.err}; }
        val at: *Kind = table.at[Kind](?g.kinds, table.nth[Kind](k.ok));
        at.first  = f.ok;
        at.second = s.ok;
    }
    ret err[Fail].ok{};
}

# every override applied to the operands of its opcode, refused when it
# changes no operand
fun override(g: *Grammar, d: *Document) err[Fail] {
    var i: usize = 0;
    for (i < OVERRIDE_COUNT) {
        val v:    *Override        = ?OVERRIDES[i];
        val from: res[usize, Fail] = kind_of(g, d, v.from);
        if (sel from.err) { ret err[Fail].err{from.err}; }
        val to: res[usize, Fail] = kind_of(g, d, v.to);
        if (sel to.err) { ret err[Fail].err{to.err}; }
        var changed: usize = 0;
        var k:       usize = 0;
        for (k < table.count[Op](?g.ops)) {
            val op: *Op = table.at[Op](?g.ops, table.nth[Op](k));
            k = k + 1;
            if (!str_equals(op.name, v.op)) { cnt; }
            var o: usize = 0;
            for (o < op.operands.count) {
                val at: *Operand = table.at[Operand](?g.operands, table.nth[Operand](op.operands.first + o));
                if (at.kind == from.ok) {
                    at.kind = to.ok;
                    changed = changed + 1;
                }
                o = o + 1;
            }
        }
        if (changed == 0) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("an override changes no operand"), d.file.file), v.op)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# mark the kind of every operand of an opcode or an extended instruction used
fun mark_rows(g: *Grammar) {
    var i: usize = 0;
    for (i < table.count[Op](?g.ops)) {
        mark_span(g, table.at[Op](?g.ops, table.nth[Op](i)).operands);
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Instruction](?g.instructions)) {
        mark_span(g, table.at[Instruction](?g.instructions, table.nth[Instruction](i)).operands);
        i = i + 1;
    }
}

fun mark_span(g: *Grammar, s: Span) {
    var o: usize = 0;
    for (o < s.count) {
        val m: bool = mark(g, table.at[Operand](?g.operands, table.nth[Operand](s.first + o)).kind);
        o = o + 1;
    }
}

# the enumerants of the enum kind `index` that take parameters, ascending by
# value
fun enumerants(g: *Grammar, d: *Document, index: usize) err[Fail] {
    val k:  *Kind                  = table.at[Kind](?g.kinds, table.nth[Kind](index));
    val ev: res[*json.Value, Fail] = document.member(d, k.source, "enumerants");
    if (sel ev.err) { ret err[Fail].err{ev.err}; }
    val n: res[usize, Fail] = document.count(d, ev.ok, "enumerants");
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val first: usize = table.count[Enumerant](?g.enumerants);
    var i:     usize = 0;
    for (i < n.ok) {
        val o:  *json.Value                 = document.item(ev.ok, i);
        val pv: res[opt[*json.Value], Fail] = document.optional(d, o, "parameters");
        if (sel pv.err) { ret err[Fail].err{pv.err}; }
        i = i + 1;
        if (sel pv.ok.none) { cnt; }
        val nv: res[*json.Value, Fail] = document.member(d, o, "enumerant");
        if (sel nv.err) { ret err[Fail].err{nv.err}; }
        val name: res[str, Fail] = document.text(g.a, d, nv.ok, "enumerant");
        if (sel name.err) { ret err[Fail].err{name.err}; }
        val vv: res[*json.Value, Fail] = document.member(d, o, "value");
        if (sel vv.err) { ret err[Fail].err{vv.err}; }
        val value: res[u32, Fail] = document.word(d, vv.ok, name.ok);
        if (sel value.err) { ret err[Fail].err{value.err}; }
        val ops: res[Span, Fail] = operands(g, d, pv.ok);
        if (sel ops.err) { ret err[Fail].err{ops.err}; }
        val p: res[Id[Enumerant], Fail] = table.push[Enumerant](?g.enumerants, Enumerant{value: value.ok, name: name.ok, operands: ops.ok});
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    val count: usize      = table.count[Enumerant](?g.enumerants) - first;
    val at:    *Enumerant = ?table.items[Enumerant](?g.enumerants)[first];
    sort.sort_by[Enumerant](at, count, by_value);
    i = 1;
    for (i < count) {
        if (at[i - 1].value == at[i].value) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("two enumerants that take parameters share a value"), d.file.file), at[i].name)}; }
        i = i + 1;
    }
    val again: *Kind = table.at[Kind](?g.kinds, table.nth[Kind](index));
    again.enumerants = Span{first: first, count: count};
    ret err[Fail].ok{};
}

# every instruction of the core grammar, ascending by opcode
fun instructions(g: *Grammar, d: *Document) err[Fail] {
    val iv: res[*json.Value, Fail] = document.member(d, ?d.root, "instructions");
    if (sel iv.err) { ret err[Fail].err{iv.err}; }
    val n: res[usize, Fail] = document.count(d, iv.ok, "instructions");
    if (sel n.err) { ret err[Fail].err{n.err}; }
    var i: usize = 0;
    for (i < n.ok) {
        val o:  *json.Value            = document.item(iv.ok, i);
        val nv: res[*json.Value, Fail] = document.member(d, o, "opname");
        if (sel nv.err) { ret err[Fail].err{nv.err}; }
        val name: res[str, Fail] = document.text(g.a, d, nv.ok, "opname");
        if (sel name.err) { ret err[Fail].err{name.err}; }
        val cv: res[*json.Value, Fail] = document.member(d, o, "opcode");
        if (sel cv.err) { ret err[Fail].err{cv.err}; }
        val code: res[u32, Fail] = document.word(d, cv.ok, name.ok);
        if (sel code.err)     { ret err[Fail].err{code.err}; }
        if (code.ok > 0xFFFF) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("an opcode does not fit in half a word"), d.file.file), name.ok)}; }
        val ov: res[opt[*json.Value], Fail] = document.optional(d, o, "operands");
        if (sel ov.err) { ret err[Fail].err{ov.err}; }
        val ops: res[Span, Fail] = operands(g, d, ov.ok);
        if (sel ops.err) { ret err[Fail].err{ops.err}; }
        val p: res[Id[Op], Fail] = table.push[Op](?g.ops, Op{code: code.ok, name: name.ok, operands: ops.ok});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    val at:    *Op   = table.items[Op](?g.ops);
    val count: usize = table.count[Op](?g.ops);
    sort.sort_by[Op](at, count, by_code);
    i = 1;
    for (i < count) {
        if (at[i - 1].code == at[i].code) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("two instructions share an opcode"), d.file.file), at[i].name)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the extended instruction set `s` read from `d`, ascending by number
fun set(g: *Grammar, d: *Document, s: *Source) err[Fail] {
    val iv: res[*json.Value, Fail] = document.member(d, ?d.root, "instructions");
    if (sel iv.err) { ret err[Fail].err{iv.err}; }
    val n: res[usize, Fail] = document.count(d, iv.ok, "instructions");
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val first: usize = table.count[Instruction](?g.instructions);
    var i:     usize = 0;
    for (i < n.ok) {
        val o:  *json.Value            = document.item(iv.ok, i);
        val nv: res[*json.Value, Fail] = document.member(d, o, "opname");
        if (sel nv.err) { ret err[Fail].err{nv.err}; }
        val name: res[str, Fail] = document.text(g.a, d, nv.ok, "opname");
        if (sel name.err) { ret err[Fail].err{name.err}; }
        val cv: res[*json.Value, Fail] = document.member(d, o, "opcode");
        if (sel cv.err) { ret err[Fail].err{cv.err}; }
        val number: res[u32, Fail] = document.word(d, cv.ok, name.ok);
        if (sel number.err) { ret err[Fail].err{number.err}; }
        val ov: res[opt[*json.Value], Fail] = document.optional(d, o, "operands");
        if (sel ov.err) { ret err[Fail].err{ov.err}; }
        val ops: res[Span, Fail] = operands(g, d, ov.ok);
        if (sel ops.err) { ret err[Fail].err{ops.err}; }
        val p: res[Id[Instruction], Fail] = table.push[Instruction](?g.instructions, Instruction{number: number.ok, name: name.ok, operands: ops.ok});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    val count: usize        = table.count[Instruction](?g.instructions) - first;
    val at:    *Instruction = ?table.items[Instruction](?g.instructions)[first];
    sort.sort_by[Instruction](at, count, by_number);
    i = 1;
    for (i < count) {
        if (at[i - 1].number == at[i].number) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("two instructions share a number"), d.file.file), at[i].name)}; }
        i = i + 1;
    }
    val p: res[Id[Set], Fail] = table.push[Set](?g.sets, Set{name: s.name, instructions: Span{first: first, count: count}});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# mark every kind a used kind reaches, through its bases and the operands of
# its enumerants, used
fun close(g: *Grammar) {
    var changed: bool = true;
    for (changed) {
        changed = false;
        var i: usize = 0;
        for (i < table.count[Kind](?g.kinds)) {
            val k: *Kind = table.at[Kind](?g.kinds, table.nth[Kind](i));
            i = i + 1;
            if (!k.used) { cnt; }
            if (k.category == COMPOSITE) {
                changed = mark(g, k.first) || changed;
                changed = mark(g, k.second) || changed;
            }
            var e: usize = 0;
            for (e < k.enumerants.count) {
                val n: *Enumerant = table.at[Enumerant](?g.enumerants, table.nth[Enumerant](k.enumerants.first + e));
                var o: usize      = 0;
                for (o < n.operands.count) {
                    val op: *Operand = table.at[Operand](?g.operands, table.nth[Operand](n.operands.first + o));
                    changed = mark(g, op.kind) || changed;
                    o       = o + 1;
                }
                e = e + 1;
            }
        }
    }
}

# mark the kind `index` used, answering whether it was not before
fun mark(g: *Grammar, index: usize) bool {
    val k: *Kind = table.at[Kind](?g.kinds, table.nth[Kind](index));
    if (k.used) { ret false; }
    k.used = true;
    ret true;
}

# the value of the named constant `n`
fun constant(g: *Grammar, d: *Document, n: *Named) res[u32, Fail] {
    if (n.kind == nil) {
        var i: usize = 0;
        for (i < table.count[Op](?g.ops)) {
            val o: *Op = table.at[Op](?g.ops, table.nth[Op](i));
            if (str_equals(o.name, n.name)) { ret res[u32, Fail].ok{o.code}; }
            i = i + 1;
        }
        ret refuse[u32](d, "a named opcode is not in the grammar", n.name);
    }
    val k: res[usize, Fail] = kind_of(g, d, n.kind);
    if (sel k.err) { ret res[u32, Fail].err{k.err}; }
    val ev: res[*json.Value, Fail] = document.member(d, table.at[Kind](?g.kinds, table.nth[Kind](k.ok)).source, "enumerants");
    if (sel ev.err) { ret res[u32, Fail].err{ev.err}; }
    val count: res[usize, Fail] = document.count(d, ev.ok, "enumerants");
    if (sel count.err) { ret res[u32, Fail].err{count.err}; }
    var i: usize = 0;
    for (i < count.ok) {
        val o:  *json.Value            = document.item(ev.ok, i);
        val nv: res[*json.Value, Fail] = document.member(d, o, "enumerant");
        if (sel nv.err) { ret res[u32, Fail].err{nv.err}; }
        val name: res[str, Fail] = document.text(g.a, d, nv.ok, "enumerant");
        if (sel name.err) { ret res[u32, Fail].err{name.err}; }
        if (str_equals(name.ok, n.name)) {
            val vv: res[*json.Value, Fail] = document.member(d, o, "value");
            if (sel vv.err) { ret res[u32, Fail].err{vv.err}; }
            ret document.word(d, vv.ok, n.name);
        }
        i = i + 1;
    }
    ret refuse[u32](d, "a named enumerant is not in the grammar", n.name);
}

# the grammar the core file `core` and the extended instruction set files
# `sets`, one per row of SETS, state
pub fun read(a: *A.Allocator, core: *Input, sets: *Input) res[Grammar, Fail] {
    var g: Grammar = Grammar{
        a:            a,
        kinds:        table.make[Kind](a),
        operands:     table.make[Operand](a),
        enumerants:   table.make[Enumerant](a),
        ops:          table.make[Op](a),
        instructions: table.make[Instruction](a),
        sets:         table.make[Set](a),
        constants:    table.make[Constant](a),
    };
    val parsed: res[Document, Fail] = document.read(a, core);
    if (sel parsed.err) { ret res[Grammar, Fail].err{parsed.err}; }
    var d:       Document = parsed.ok;
    val version: [3]str   = [3]str{"major_version", "minor_version", "revision"};
    var parts:   [3]u32;
    var i:       usize    = 0;
    for (i < 3) {
        val v: res[*json.Value, Fail] = document.member(?d, ?d.root, version[i]);
        if (sel v.err) { ret res[Grammar, Fail].err{v.err}; }
        val w: res[u32, Fail] = document.word(?d, v.ok, version[i]);
        if (sel w.err) { ret res[Grammar, Fail].err{w.err}; }
        parts[i] = w.ok;
        i        = i + 1;
    }
    g.major    = parts[0];
    g.minor    = parts[1];
    g.revision = parts[2];
    val declared: err[Fail] = declare(?g, ?d);
    if (sel declared.err) { ret res[Grammar, Fail].err{declared.err}; }
    val defined: err[Fail] = define(?g, ?d);
    if (sel defined.err) { ret res[Grammar, Fail].err{defined.err}; }
    val synthesized: err[Fail] = synthesize(?g, ?d);
    if (sel synthesized.err) { ret res[Grammar, Fail].err{synthesized.err}; }
    val read_ops: err[Fail] = instructions(?g, ?d);
    if (sel read_ops.err) { ret res[Grammar, Fail].err{read_ops.err}; }
    val overridden: err[Fail] = override(?g, ?d);
    if (sel overridden.err) { ret res[Grammar, Fail].err{overridden.err}; }
    i = 0;
    for (i < SET_COUNT) {
        if (i > 0 && str_compare(SETS[i - 1].name, SETS[i].name) >= 0) {
            ret res[Grammar, Fail].err{fail.about(fail.internal("the extended instruction sets do not ascend by name"), SETS[i].name)};
        }
        val sd: res[Document, Fail] = document.read(a, ?sets[i]);
        if (sel sd.err) { ret res[Grammar, Fail].err{sd.err}; }
        var sdoc: Document  = sd.ok;
        val got:  err[Fail] = set(?g, ?sdoc, ?SETS[i]);
        if (sel got.err) { ret res[Grammar, Fail].err{got.err}; }
        i = i + 1;
    }
    mark_rows(?g);
    close(?g);
    i = 0;
    for (i < NAMED_COUNT) {
        if (i > 0 && str_compare(NAMED[i - 1].constant, NAMED[i].constant) >= 0) {
            ret res[Grammar, Fail].err{fail.about(fail.internal("the named constants do not ascend by name"), NAMED[i].constant)};
        }
        val v: res[u32, Fail] = constant(?g, ?d, ?NAMED[i]);
        if (sel v.err) { ret res[Grammar, Fail].err{v.err}; }
        val p: res[Id[Constant], Fail] = table.push[Constant](?g.constants, Constant{name: NAMED[i].constant, value: v.ok});
        if (sel p.err) { ret res[Grammar, Fail].err{p.err}; }
        i = i + 1;
    }
    ret res[Grammar, Fail].ok{g};
}
