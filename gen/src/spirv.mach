# the SPIR-V grammar rows mink carries, read from the vendored grammar
#
# the generator reads the core grammar and the extended instruction set
# grammars named below, and keeps of them every operand kind, every
# enumerant, every opcode and every extended instruction, each with its
# operands, availability and aliases, and the grammar's version. a kind is
# resolved by its name,
# so a grammar that names a kind it never declares is refused naming it, as
# is an id or literal kind the generator has no shape for. where the grammar
# names a kind too wide for what the specification says of an operand, the
# generator adds a synthetic kind and overrides that operand with it.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;

use A: std.allocator;

use json.value;
use json.value.Value;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.format.contract.Input;

use gen.document;
use gen.document.Document;

# the categories of an operand kind
pub val ID:         u8 = 0;
pub val LITERAL:    u8 = 1;
pub val COMPOSITE:  u8 = 2;
pub val VALUE_ENUM: u8 = 3;
pub val BIT_ENUM:   u8 = 4;

# how many times an operand occurs, as the grammar's quantifier states
pub val ONE:      u8 = 0;
pub val OPTIONAL: u8 = 1;
pub val MANY:     u8 = 2;

# the shape an id or literal kind takes, by its name in the grammar
rec Shaped {
    kind:  str;
    shape: str;
}

val SHAPED_COUNT: usize                = 11;
val SHAPED:       [SHAPED_COUNT]Shaped = [SHAPED_COUNT]Shaped{
    Shaped{kind: "IdMemorySemantics", shape: "id"},
    Shaped{kind: "IdRef", shape: "id"},
    Shaped{kind: "IdResult", shape: "result"},
    Shaped{kind: "IdResultType", shape: "result_type"},
    Shaped{kind: "IdScope", shape: "id"},
    Shaped{kind: "LiteralContextDependentNumber", shape: "number"},
    Shaped{kind: "LiteralExtInstInteger", shape: "instruction"},
    Shaped{kind: "LiteralFloat", shape: "word"},
    Shaped{kind: "LiteralInteger", shape: "word"},
    Shaped{kind: "LiteralSpecConstantOpInteger", shape: "opcode"},
    Shaped{kind: "LiteralString", shape: "string"},
};

# a grammar file of the vendored copy and, for an extended instruction set,
# the name an OpExtInstImport imports it by
pub rec Source {
    file: str;
    name: str;
}

# the core grammar
pub val CORE: str = "spirv.core.grammar.json";

# the extended instruction sets, ascending by name
pub val SET_COUNT: usize             = 3;
pub val SETS:      [SET_COUNT]Source = [SET_COUNT]Source{
    Source{file: "extinst.glsl.std.450.grammar.json", name: "GLSL.std.450"},
    Source{file: "extinst.nonsemantic.shader.debuginfo.100.grammar.json", name: "NonSemantic.Shader.DebugInfo.100"},
    Source{file: "extinst.opencl.std.100.grammar.json", name: "OpenCL.std"},
};

# a constant the generated table names for mink's code: an opcode by its
# name, or an enumerant of a kind
# ---
# constant: the constant's name
# kind:     the enumerant's kind, nil for an opcode
# name:     the opcode's or the enumerant's name in the grammar
pub rec Named {
    constant: str;
    kind:     str;
    name:     str;
}

pub val NAMED_COUNT: usize              = 49;
pub val NAMED:       [NAMED_COUNT]Named = [NAMED_COUNT]Named{
    Named{constant: "ADDRESSING_LOGICAL", kind: "AddressingModel", name: "Logical"},
    Named{constant: "ADDRESSING_PHYSICAL32", kind: "AddressingModel", name: "Physical32"},
    Named{constant: "ADDRESSING_PHYSICAL64", kind: "AddressingModel", name: "Physical64"},
    Named{constant: "ADDRESSING_PHYSICAL_STORAGE_BUFFER64", kind: "AddressingModel", name: "PhysicalStorageBuffer64"},
    Named{constant: "CAPABILITY_LINKAGE", kind: "Capability", name: "Linkage"},
    Named{constant: "CAPABILITY_SHADER", kind: "Capability", name: "Shader"},
    Named{constant: "DECORATION_LINKAGE_ATTRIBUTES", kind: "Decoration", name: "LinkageAttributes"},
    Named{constant: "DECORATION_USER_SEMANTIC", kind: "Decoration", name: "UserSemantic"},
    Named{constant: "LINKAGE_EXPORT", kind: "LinkageType", name: "Export"},
    Named{constant: "LINKAGE_IMPORT", kind: "LinkageType", name: "Import"},
    Named{constant: "LINKAGE_LINK_ONCE_ODR", kind: "LinkageType", name: "LinkOnceODR"},
    Named{constant: "MEMORY_MODEL_GLSL450", kind: "MemoryModel", name: "GLSL450"},
    Named{constant: "MEMORY_MODEL_OPENCL", kind: "MemoryModel", name: "OpenCL"},
    Named{constant: "MEMORY_MODEL_SIMPLE", kind: "MemoryModel", name: "Simple"},
    Named{constant: "MEMORY_MODEL_VULKAN", kind: "MemoryModel", name: "Vulkan"},
    Named{constant: "OP_CAPABILITY", kind: nil, name: "OpCapability"},
    Named{constant: "OP_DECORATE", kind: nil, name: "OpDecorate"},
    Named{constant: "OP_DECORATE_ID", kind: nil, name: "OpDecorateId"},
    Named{constant: "OP_DECORATE_STRING", kind: nil, name: "OpDecorateString"},
    Named{constant: "OP_DECORATION_GROUP", kind: nil, name: "OpDecorationGroup"},
    Named{constant: "OP_ENTRY_POINT", kind: nil, name: "OpEntryPoint"},
    Named{constant: "OP_EXECUTION_MODE", kind: nil, name: "OpExecutionMode"},
    Named{constant: "OP_EXECUTION_MODE_ID", kind: nil, name: "OpExecutionModeId"},
    Named{constant: "OP_EXTENSION", kind: nil, name: "OpExtension"},
    Named{constant: "OP_EXT_INST", kind: nil, name: "OpExtInst"},
    Named{constant: "OP_EXT_INST_IMPORT", kind: nil, name: "OpExtInstImport"},
    Named{constant: "OP_FUNCTION", kind: nil, name: "OpFunction"},
    Named{constant: "OP_FUNCTION_CALL", kind: nil, name: "OpFunctionCall"},
    Named{constant: "OP_FUNCTION_END", kind: nil, name: "OpFunctionEnd"},
    Named{constant: "OP_GROUP_DECORATE", kind: nil, name: "OpGroupDecorate"},
    Named{constant: "OP_GROUP_MEMBER_DECORATE", kind: nil, name: "OpGroupMemberDecorate"},
    Named{constant: "OP_LABEL", kind: nil, name: "OpLabel"},
    Named{constant: "OP_LINE", kind: nil, name: "OpLine"},
    Named{constant: "OP_MEMBER_DECORATE", kind: nil, name: "OpMemberDecorate"},
    Named{constant: "OP_MEMBER_DECORATE_STRING", kind: nil, name: "OpMemberDecorateString"},
    Named{constant: "OP_MEMBER_NAME", kind: nil, name: "OpMemberName"},
    Named{constant: "OP_MEMORY_MODEL", kind: nil, name: "OpMemoryModel"},
    Named{constant: "OP_MODULE_PROCESSED", kind: nil, name: "OpModuleProcessed"},
    Named{constant: "OP_NAME", kind: nil, name: "OpName"},
    Named{constant: "OP_NO_LINE", kind: nil, name: "OpNoLine"},
    Named{constant: "OP_SOURCE", kind: nil, name: "OpSource"},
    Named{constant: "OP_SOURCE_CONTINUED", kind: nil, name: "OpSourceContinued"},
    Named{constant: "OP_SOURCE_EXTENSION", kind: nil, name: "OpSourceExtension"},
    Named{constant: "OP_STRING", kind: nil, name: "OpString"},
    Named{constant: "OP_TYPE_FLOAT", kind: nil, name: "OpTypeFloat"},
    Named{constant: "OP_TYPE_FUNCTION", kind: nil, name: "OpTypeFunction"},
    Named{constant: "OP_TYPE_INT", kind: nil, name: "OpTypeInt"},
    Named{constant: "OP_TYPE_VOID", kind: nil, name: "OpTypeVoid"},
    Named{constant: "OP_VARIABLE", kind: nil, name: "OpVariable"},
};

# a kind the grammar does not declare, which the generator adds because the
# grammar names a kind too wide for what the specification says of an
# operand
# ---
# name:   its name
# shape:  the shape of a literal kind, nil for a composite
# first:  the first kind of a composite
# second: the second kind of a composite
rec Synthetic {
    name:   str;
    shape:  str;
    first:  str;
    second: str;
}

# OpSwitch's literals are as wide as its selector's type, where the grammar
# names a plain LiteralInteger
val SYNTHETIC_COUNT: usize                      = 2;
val SYNTHETIC:       [SYNTHETIC_COUNT]Synthetic = [SYNTHETIC_COUNT]Synthetic{
    Synthetic{name: "LiteralSelector", shape: "selector"},
    Synthetic{name: "PairLiteralSelectorIdRef", first: "LiteralSelector", second: "IdRef"},
};

# an operand of an opcode that takes a synthetic kind in place of the one the
# grammar names
rec Override {
    op:   str;
    from: str;
    to:   str;
}

val OVERRIDE_COUNT: usize                    = 1;
val OVERRIDES:      [OVERRIDE_COUNT]Override = [OVERRIDE_COUNT]Override{
    Override{op: "OpSwitch", from: "PairLiteralIntegerIdRef", to: "PairLiteralSelectorIdRef"},
};

# kind:       the index of its kind
# quantifier: how many times it occurs
# name:       its name in the grammar, nil for none
pub rec Operand {
    kind:       usize;
    quantifier: u8;
    name:       str;
}

# the operands of a row: where the first lies among the grammar's operands,
# and how many
pub rec Span {
    first: usize;
    count: usize;
}

# what makes a row available: the first and the last core version that hold
# it as version words, 0 for none, and its extensions and capabilities among
# the grammar's names
pub rec Availability {
    version:      u32;
    last:         u32;
    extensions:   Span;
    capabilities: Span;
}

pub rec Enumerant {
    value:        u32;
    name:         str;
    operands:     Span;
    availability: Availability;
    aliases:      Span;
}

# name:       its name in the grammar
# category:   its category
# shape:      the shape of an id or literal kind
# first:      the first kind of a composite
# second:     the second kind of a composite
# enumerants: the enumerants of an enum, where the first lies among the
#             grammar's enumerants and how many
# source:     its object in the grammar
pub rec Kind {
    name:       str;
    category:   u8;
    shape:      str;
    first:      usize;
    second:     usize;
    enumerants: Span;
    source:     *Value;
}

pub rec Op {
    code:         u32;
    name:         str;
    class:        str;
    operands:     Span;
    availability: Availability;
    aliases:      Span;
}

pub rec Instruction {
    number:       u32;
    name:         str;
    operands:     Span;
    availability: Availability;
}

# name:         the name it is imported by
# version:      the version its grammar states
# revision:     the revision its grammar states
# instructions: where its first instruction lies among the grammar's, and how
#               many
pub rec Set {
    name:         str;
    version:      u32;
    revision:     u32;
    instructions: Span;
}

# a constant the table names and its value
pub rec Constant {
    name:  str;
    value: u32;
}

# major, minor, revision: the version of the core grammar
# kinds: every operand kind, ascending by name
# names: the extensions, capabilities and aliases rows name, in the order
#        they are read
pub rec Grammar {
    a:            *A.Allocator;
    major:        u32;
    minor:        u32;
    revision:     u32;
    kinds:        Table[Kind];
    operands:     Table[Operand];
    enumerants:   Table[Enumerant];
    ops:          Table[Op];
    instructions: Table[Instruction];
    sets:         Table[Set];
    names:        Table[str];
    constants:    Table[Constant];
}

fun refuse[T](d: *Document, text: str, subject: str) res[T, Fail] {
    ret res[T, Fail].err{fail.about(fail.in_file(fail.malformed(text), d.file.file), subject)};
}

fun by_name(a: *Kind, b: *Kind) i64 {
    ret str_compare(a.name, b.name);
}

fun by_code(a: *Op, b: *Op) i64 {
    if (a.code < b.code) { ret -1; }
    if (a.code > b.code) { ret 1; }
    ret 0;
}

fun by_number(a: *Instruction, b: *Instruction) i64 {
    if (a.number < b.number) { ret -1; }
    if (a.number > b.number) { ret 1; }
    ret 0;
}

fun by_value(a: *Enumerant, b: *Enumerant) i64 {
    if (a.value < b.value) { ret -1; }
    if (a.value > b.value) { ret 1; }
    ret 0;
}

# the index of the kind named `name`, refused naming it when the core grammar
# declares none
fun kind_of(g: *Grammar, d: *Document, name: str) res[usize, Fail] {
    var probe: Kind           = Kind{name: name};
    val pos:   SearchPosition = sort.binary_search_by[Kind](table.items[Kind](?g.kinds), table.count[Kind](?g.kinds), ?probe, by_name);
    if (sel pos.found) { ret res[usize, Fail].ok{pos.found}; }
    ret refuse[usize](d, "an operand names a kind the core grammar does not declare", name);
}

fun category_of(d: *Document, name: str, c: str) res[u8, Fail] {
    if (str_equals(c, "Id"))        { ret res[u8, Fail].ok{ID}; }
    if (str_equals(c, "Literal"))   { ret res[u8, Fail].ok{LITERAL}; }
    if (str_equals(c, "Composite")) { ret res[u8, Fail].ok{COMPOSITE}; }
    if (str_equals(c, "ValueEnum")) { ret res[u8, Fail].ok{VALUE_ENUM}; }
    if (str_equals(c, "BitEnum"))   { ret res[u8, Fail].ok{BIT_ENUM}; }
    ret refuse[u8](d, "a kind is of a category the generator does not know", name);
}

fun shape_of(d: *Document, name: str) res[str, Fail] {
    var i: usize = 0;
    for (i < SHAPED_COUNT) {
        if (str_equals(SHAPED[i].kind, name)) { ret res[str, Fail].ok{SHAPED[i].shape}; }
        i = i + 1;
    }
    ret refuse[str](d, "an id or literal kind has no shape", name);
}

# the text of member `key` of `v`, nil when it is absent
fun optional_text(g: *Grammar, d: *Document, v: *Value, key: str) res[str, Fail] {
    val res_found: res[opt[*Value], Fail] = document.optional(d, v, key);
    if (sel res_found.err)     { ret res[str, Fail].err{res_found.err}; }
    if (sel res_found.ok.none) { ret res[str, Fail].ok{nil}; }
    ret document.text(g.a, d, res_found.ok.some, key);
}

# append the strings of the array member `key` of `v` to the grammar's names,
# none when it is absent
fun names(g: *Grammar, d: *Document, v: *Value, key: str) res[Span, Fail] {
    val first:     usize                  = table.count[str](?g.names);
    val res_found: res[opt[*Value], Fail] = document.optional(d, v, key);
    if (sel res_found.err)     { ret res[Span, Fail].err{res_found.err}; }
    if (sel res_found.ok.none) { ret res[Span, Fail].ok{Span{first: first, count: 0}}; }
    val res_count: res[usize, Fail] = document.count(d, res_found.ok.some, key);
    if (sel res_count.err) { ret res[Span, Fail].err{res_count.err}; }
    var i: usize = 0;
    for (i < res_count.ok) {
        val res_text: res[str, Fail] = document.text(g.a, d, document.item(res_found.ok.some, i), key);
        if (sel res_text.err) { ret res[Span, Fail].err{res_text.err}; }
        val res_names_pushed: res[Id[str], Fail] = table.push[str](?g.names, res_text.ok);
        if (sel res_names_pushed.err) { ret res[Span, Fail].err{res_names_pushed.err}; }
        i = i + 1;
    }
    ret res[Span, Fail].ok{Span{first: first, count: res_count.ok}};
}

# the version word of the version `key` of `v` states as major.minor, 0 when
# it is absent or states None
fun version(g: *Grammar, d: *Document, v: *Value, key: str) res[u32, Fail] {
    val res_optional_text: res[str, Fail] = optional_text(g, d, v, key);
    if (sel res_optional_text.err)                                               { ret res[u32, Fail].err{res_optional_text.err}; }
    if (res_optional_text.ok == nil || str_equals(res_optional_text.ok, "None")) { ret res[u32, Fail].ok{0}; }
    var major: u32   = 0;
    var minor: u32   = 0;
    var dot:   bool  = false;
    var digit: bool  = false;
    var i:     usize = 0;
    for (res_optional_text.ok[i] != 0) {
        val c: u8 = res_optional_text.ok[i];
        i = i + 1;
        if (c == '.' && !dot && digit) {
            dot   = true;
            digit = false;
            cnt;
        }
        if (c < '0' || c > '9') { ret refuse[u32](d, "a version is not a major and a minor number", res_optional_text.ok); }
        digit = true;
        if (dot)                          { minor = minor * 10 + (c - '0')::u32; }
        or                                { major = major * 10 + (c - '0')::u32; }
        if (major > 0xFF || minor > 0xFF) { ret refuse[u32](d, "a version is not a major and a minor number", res_optional_text.ok); }
    }
    if (!dot || !digit) { ret refuse[u32](d, "a version is not a major and a minor number", res_optional_text.ok); }
    ret res[u32, Fail].ok{(major << 16) | (minor << 8)};
}

# the availability the object `v` states
fun availability(g: *Grammar, d: *Document, v: *Value) res[Availability, Fail] {
    val res_first: res[u32, Fail] = version(g, d, v, "version");
    if (sel res_first.err) { ret res[Availability, Fail].err{res_first.err}; }
    val res_last: res[u32, Fail] = version(g, d, v, "lastVersion");
    if (sel res_last.err) { ret res[Availability, Fail].err{res_last.err}; }
    val res_ext: res[Span, Fail] = names(g, d, v, "extensions");
    if (sel res_ext.err) { ret res[Availability, Fail].err{res_ext.err}; }
    val res_caps: res[Span, Fail] = names(g, d, v, "capabilities");
    if (sel res_caps.err) { ret res[Availability, Fail].err{res_caps.err}; }
    ret res[Availability, Fail].ok{Availability{version: res_first.ok, last: res_last.ok, extensions: res_ext.ok, capabilities: res_caps.ok}};
}

# append the operands the array `list` states to the grammar's
fun operands(g: *Grammar, d: *Document, list: opt[*Value]) res[Span, Fail] {
    val first: usize = table.count[Operand](?g.operands);
    if (sel list.none) { ret res[Span, Fail].ok{Span{first: first, count: 0}}; }
    val res_count: res[usize, Fail] = document.count(d, list.some, "operands");
    if (sel res_count.err) { ret res[Span, Fail].err{res_count.err}; }
    var i: usize = 0;
    for (i < res_count.ok) {
        val o:          *Value            = document.item(list.some, i);
        val res_member: res[*Value, Fail] = document.member(d, o, "kind");
        if (sel res_member.err) { ret res[Span, Fail].err{res_member.err}; }
        val res_name: res[str, Fail] = document.text(g.a, d, res_member.ok, "kind");
        if (sel res_name.err) { ret res[Span, Fail].err{res_name.err}; }
        val res_kind_of: res[usize, Fail] = kind_of(g, d, res_name.ok);
        if (sel res_kind_of.err) { ret res[Span, Fail].err{res_kind_of.err}; }
        var q:            u8                     = ONE;
        val res_optional: res[opt[*Value], Fail] = document.optional(d, o, "quantifier");
        if (sel res_optional.err) { ret res[Span, Fail].err{res_optional.err}; }
        if (sel res_optional.ok.some) {
            val res_text: res[str, Fail] = document.text(g.a, d, res_optional.ok.some, "quantifier");
            if (sel res_text.err)             { ret res[Span, Fail].err{res_text.err}; }
            if (str_equals(res_text.ok, "?")) { q = OPTIONAL; }
            or (str_equals(res_text.ok, "*")) { q = MANY; }
            or                                { ret refuse[Span](d, "an operand has an unknown quantifier", res_text.ok); }
        }
        val res_named: res[str, Fail] = optional_text(g, d, o, "name");
        if (sel res_named.err) { ret res[Span, Fail].err{res_named.err}; }
        val res_operands_pushed: res[Id[Operand], Fail] = table.push[Operand](?g.operands, Operand{kind: res_kind_of.ok, quantifier: q, name: res_named.ok});
        if (sel res_operands_pushed.err) { ret res[Span, Fail].err{res_operands_pushed.err}; }
        i = i + 1;
    }
    ret res[Span, Fail].ok{Span{first: first, count: res_count.ok}};
}

# every kind of the core grammar, ascending by name, with only its name,
# category and object read
fun declare(g: *Grammar, d: *Document) err[Fail] {
    val res_member: res[*Value, Fail] = document.member(d, ?d.root, "operand_kinds");
    if (sel res_member.err) { ret err[Fail].err{res_member.err}; }
    val res_count: res[usize, Fail] = document.count(d, res_member.ok, "operand_kinds");
    if (sel res_count.err) { ret err[Fail].err{res_count.err}; }
    var i: usize = 0;
    for (i < res_count.ok) {
        val o:          *Value            = document.item(res_member.ok, i);
        val res_member: res[*Value, Fail] = document.member(d, o, "kind");
        if (sel res_member.err) { ret err[Fail].err{res_member.err}; }
        val res_name: res[str, Fail] = document.text(g.a, d, res_member.ok, "kind");
        if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
        val res_member_category: res[*Value, Fail] = document.member(d, o, "category");
        if (sel res_member_category.err) { ret err[Fail].err{res_member_category.err}; }
        val res_text: res[str, Fail] = document.text(g.a, d, res_member_category.ok, "category");
        if (sel res_text.err) { ret err[Fail].err{res_text.err}; }
        val res_category_of: res[u8, Fail] = category_of(d, res_name.ok, res_text.ok);
        if (sel res_category_of.err) { ret err[Fail].err{res_category_of.err}; }
        var shape: str = nil;
        if (res_category_of.ok == ID || res_category_of.ok == LITERAL) {
            val res_shape_of: res[str, Fail] = shape_of(d, res_name.ok);
            if (sel res_shape_of.err) { ret err[Fail].err{res_shape_of.err}; }
            shape = res_shape_of.ok;
        }
        val res_kinds_pushed: res[Id[Kind], Fail] = table.push[Kind](?g.kinds, Kind{name: res_name.ok, category: res_category_of.ok, shape: shape, source: o});
        if (sel res_kinds_pushed.err) { ret err[Fail].err{res_kinds_pushed.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < SYNTHETIC_COUNT) {
        val y: *Synthetic = ?SYNTHETIC[i];
        var c: u8         = LITERAL;
        if (y.shape == nil) { c = COMPOSITE; }
        val res_kinds_pushed: res[Id[Kind], Fail] = table.push[Kind](?g.kinds, Kind{name: y.name, category: c, shape: y.shape, source: nil});
        if (sel res_kinds_pushed.err) { ret err[Fail].err{res_kinds_pushed.err}; }
        i = i + 1;
    }
    val at:    *Kind = table.items[Kind](?g.kinds);
    val count: usize = table.count[Kind](?g.kinds);
    sort.sort_by[Kind](at, count, by_name);
    i = 1;
    for (i < count) {
        if (str_equals(at[i - 1].name, at[i].name)) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("a kind is declared twice"), d.file.file), at[i].name)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bases of each composite and the enumerants of each enum, every
# reference resolved
fun define(g: *Grammar, d: *Document) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind  = table.at[Kind](?g.kinds, table.nth[Kind](i));
        val o: *Value = k.source;
        if (o == nil) {
            i = i + 1;
            cnt;
        }
        if (k.category == COMPOSITE) {
            val res_member: res[*Value, Fail] = document.member(d, o, "bases");
            if (sel res_member.err) { ret err[Fail].err{res_member.err}; }
            val res_count: res[usize, Fail] = document.count(d, res_member.ok, "bases");
            if (sel res_count.err) { ret err[Fail].err{res_count.err}; }
            if (res_count.ok != 2) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("a composite kind is not a pair"), d.file.file), k.name)}; }
            val res_text: res[str, Fail] = document.text(g.a, d, document.item(res_member.ok, 0), "bases");
            if (sel res_text.err) { ret err[Fail].err{res_text.err}; }
            val res_text_item: res[str, Fail] = document.text(g.a, d, document.item(res_member.ok, 1), "bases");
            if (sel res_text_item.err) { ret err[Fail].err{res_text_item.err}; }
            val res_kind_of: res[usize, Fail] = kind_of(g, d, res_text.ok);
            if (sel res_kind_of.err) { ret err[Fail].err{res_kind_of.err}; }
            val res_second: res[usize, Fail] = kind_of(g, d, res_text_item.ok);
            if (sel res_second.err) { ret err[Fail].err{res_second.err}; }
            val again: *Kind = table.at[Kind](?g.kinds, table.nth[Kind](i));
            again.first  = res_kind_of.ok;
            again.second = res_second.ok;
        }
        or (k.category == VALUE_ENUM || k.category == BIT_ENUM) {
            val err_enumerants: err[Fail] = enumerants(g, d, i);
            if (sel err_enumerants.err) { ret err_enumerants; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bases of every synthetic composite
fun synthesize(g: *Grammar, d: *Document) err[Fail] {
    var i: usize = 0;
    for (i < SYNTHETIC_COUNT) {
        val y: *Synthetic = ?SYNTHETIC[i];
        i = i + 1;
        if (y.shape != nil) { cnt; }
        val res_kind_of: res[usize, Fail] = kind_of(g, d, y.name);
        if (sel res_kind_of.err) { ret err[Fail].err{res_kind_of.err}; }
        val res_kind_of_first: res[usize, Fail] = kind_of(g, d, y.first);
        if (sel res_kind_of_first.err) { ret err[Fail].err{res_kind_of_first.err}; }
        val res_kind_of_second: res[usize, Fail] = kind_of(g, d, y.second);
        if (sel res_kind_of_second.err) { ret err[Fail].err{res_kind_of_second.err}; }
        val at: *Kind = table.at[Kind](?g.kinds, table.nth[Kind](res_kind_of.ok));
        at.first  = res_kind_of_first.ok;
        at.second = res_kind_of_second.ok;
    }
    ret err[Fail].ok{};
}

# every override applied to the operands of its opcode, refused when it
# changes no operand
fun override(g: *Grammar, d: *Document) err[Fail] {
    var i: usize = 0;
    for (i < OVERRIDE_COUNT) {
        val v:        *Override        = ?OVERRIDES[i];
        val res_from: res[usize, Fail] = kind_of(g, d, v.from);
        if (sel res_from.err) { ret err[Fail].err{res_from.err}; }
        val res_kind_of: res[usize, Fail] = kind_of(g, d, v.to);
        if (sel res_kind_of.err) { ret err[Fail].err{res_kind_of.err}; }
        var changed: usize = 0;
        var k:       usize = 0;
        for (k < table.count[Op](?g.ops)) {
            val op: *Op = table.at[Op](?g.ops, table.nth[Op](k));
            k = k + 1;
            if (!str_equals(op.name, v.op)) { cnt; }
            var o: usize = 0;
            for (o < op.operands.count) {
                val at: *Operand = table.at[Operand](?g.operands, table.nth[Operand](op.operands.first + o));
                if (at.kind == res_from.ok) {
                    at.kind = res_kind_of.ok;
                    changed = changed + 1;
                }
                o = o + 1;
            }
        }
        if (changed == 0) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("an override changes no operand"), d.file.file), v.op)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the enumerants of the enum kind `index`, ascending by value
fun enumerants(g: *Grammar, d: *Document, index: usize) err[Fail] {
    val k:          *Kind             = table.at[Kind](?g.kinds, table.nth[Kind](index));
    val res_member: res[*Value, Fail] = document.member(d, k.source, "enumerants");
    if (sel res_member.err) { ret err[Fail].err{res_member.err}; }
    val res_count: res[usize, Fail] = document.count(d, res_member.ok, "enumerants");
    if (sel res_count.err) { ret err[Fail].err{res_count.err}; }
    val first: usize = table.count[Enumerant](?g.enumerants);
    var i:     usize = 0;
    for (i < res_count.ok) {
        val o:            *Value                 = document.item(res_member.ok, i);
        val res_optional: res[opt[*Value], Fail] = document.optional(d, o, "parameters");
        if (sel res_optional.err) { ret err[Fail].err{res_optional.err}; }
        i = i + 1;
        val res_member: res[*Value, Fail] = document.member(d, o, "enumerant");
        if (sel res_member.err) { ret err[Fail].err{res_member.err}; }
        val res_name: res[str, Fail] = document.text(g.a, d, res_member.ok, "enumerant");
        if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
        val res_member_value: res[*Value, Fail] = document.member(d, o, "value");
        if (sel res_member_value.err) { ret err[Fail].err{res_member_value.err}; }
        val res_value: res[u32, Fail] = document.word(d, res_member_value.ok, res_name.ok);
        if (sel res_value.err) { ret err[Fail].err{res_value.err}; }
        val res_ops: res[Span, Fail] = operands(g, d, res_optional.ok);
        if (sel res_ops.err) { ret err[Fail].err{res_ops.err}; }
        val res_avail: res[Availability, Fail] = availability(g, d, o);
        if (sel res_avail.err) { ret err[Fail].err{res_avail.err}; }
        val res_aliases: res[Span, Fail] = names(g, d, o, "aliases");
        if (sel res_aliases.err) { ret err[Fail].err{res_aliases.err}; }
        val res_enumerants_pushed: res[Id[Enumerant], Fail] = table.push[Enumerant](?g.enumerants, Enumerant{value: res_value.ok, name: res_name.ok, operands: res_ops.ok, availability: res_avail.ok, aliases: res_aliases.ok});
        if (sel res_enumerants_pushed.err) { ret err[Fail].err{res_enumerants_pushed.err}; }
    }
    val count: usize      = table.count[Enumerant](?g.enumerants) - first;
    val at:    *Enumerant = ?table.items[Enumerant](?g.enumerants)[first];
    sort.sort_by[Enumerant](at, count, by_value);
    i = 1;
    for (i < count) {
        if (at[i - 1].value == at[i].value) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("two enumerants share a value"), d.file.file), at[i].name)}; }
        i = i + 1;
    }
    val again: *Kind = table.at[Kind](?g.kinds, table.nth[Kind](index));
    again.enumerants = Span{first: first, count: count};
    ret err[Fail].ok{};
}

# every instruction of the core grammar, ascending by opcode
fun instructions(g: *Grammar, d: *Document) err[Fail] {
    val res_member: res[*Value, Fail] = document.member(d, ?d.root, "instructions");
    if (sel res_member.err) { ret err[Fail].err{res_member.err}; }
    val res_count: res[usize, Fail] = document.count(d, res_member.ok, "instructions");
    if (sel res_count.err) { ret err[Fail].err{res_count.err}; }
    var i: usize = 0;
    for (i < res_count.ok) {
        val o:          *Value            = document.item(res_member.ok, i);
        val res_member: res[*Value, Fail] = document.member(d, o, "opname");
        if (sel res_member.err) { ret err[Fail].err{res_member.err}; }
        val res_name: res[str, Fail] = document.text(g.a, d, res_member.ok, "opname");
        if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
        val res_member_opcode: res[*Value, Fail] = document.member(d, o, "opcode");
        if (sel res_member_opcode.err) { ret err[Fail].err{res_member_opcode.err}; }
        val res_code: res[u32, Fail] = document.word(d, res_member_opcode.ok, res_name.ok);
        if (sel res_code.err)     { ret err[Fail].err{res_code.err}; }
        if (res_code.ok > 0xFFFF) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("an opcode does not fit in half a word"), d.file.file), res_name.ok)}; }
        val res_optional: res[opt[*Value], Fail] = document.optional(d, o, "operands");
        if (sel res_optional.err) { ret err[Fail].err{res_optional.err}; }
        val res_ops: res[Span, Fail] = operands(g, d, res_optional.ok);
        if (sel res_ops.err) { ret err[Fail].err{res_ops.err}; }
        val res_class: res[str, Fail] = optional_text(g, d, o, "class");
        if (sel res_class.err) { ret err[Fail].err{res_class.err}; }
        val res_avail: res[Availability, Fail] = availability(g, d, o);
        if (sel res_avail.err) { ret err[Fail].err{res_avail.err}; }
        val res_aliases: res[Span, Fail] = names(g, d, o, "aliases");
        if (sel res_aliases.err) { ret err[Fail].err{res_aliases.err}; }
        val res_ops_pushed: res[Id[Op], Fail] = table.push[Op](?g.ops, Op{code: res_code.ok, name: res_name.ok, class: res_class.ok, operands: res_ops.ok, availability: res_avail.ok, aliases: res_aliases.ok});
        if (sel res_ops_pushed.err) { ret err[Fail].err{res_ops_pushed.err}; }
        i = i + 1;
    }
    val at:    *Op   = table.items[Op](?g.ops);
    val count: usize = table.count[Op](?g.ops);
    sort.sort_by[Op](at, count, by_code);
    i = 1;
    for (i < count) {
        if (at[i - 1].code == at[i].code) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("two instructions share an opcode"), d.file.file), at[i].name)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the extended instruction set `s` read from `d`, ascending by number
fun set(g: *Grammar, d: *Document, s: *Source) err[Fail] {
    val res_member: res[*Value, Fail] = document.member(d, ?d.root, "instructions");
    if (sel res_member.err) { ret err[Fail].err{res_member.err}; }
    val res_count: res[usize, Fail] = document.count(d, res_member.ok, "instructions");
    if (sel res_count.err) { ret err[Fail].err{res_count.err}; }
    val first: usize = table.count[Instruction](?g.instructions);
    var i:     usize = 0;
    for (i < res_count.ok) {
        val o:          *Value            = document.item(res_member.ok, i);
        val res_member: res[*Value, Fail] = document.member(d, o, "opname");
        if (sel res_member.err) { ret err[Fail].err{res_member.err}; }
        val res_name: res[str, Fail] = document.text(g.a, d, res_member.ok, "opname");
        if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
        val res_member_opcode: res[*Value, Fail] = document.member(d, o, "opcode");
        if (sel res_member_opcode.err) { ret err[Fail].err{res_member_opcode.err}; }
        val res_number: res[u32, Fail] = document.word(d, res_member_opcode.ok, res_name.ok);
        if (sel res_number.err) { ret err[Fail].err{res_number.err}; }
        val res_optional: res[opt[*Value], Fail] = document.optional(d, o, "operands");
        if (sel res_optional.err) { ret err[Fail].err{res_optional.err}; }
        val res_ops: res[Span, Fail] = operands(g, d, res_optional.ok);
        if (sel res_ops.err) { ret err[Fail].err{res_ops.err}; }
        val res_avail: res[Availability, Fail] = availability(g, d, o);
        if (sel res_avail.err) { ret err[Fail].err{res_avail.err}; }
        val res_instructions_pushed: res[Id[Instruction], Fail] = table.push[Instruction](?g.instructions, Instruction{number: res_number.ok, name: res_name.ok, operands: res_ops.ok, availability: res_avail.ok});
        if (sel res_instructions_pushed.err) { ret err[Fail].err{res_instructions_pushed.err}; }
        i = i + 1;
    }
    val count: usize        = table.count[Instruction](?g.instructions) - first;
    val at:    *Instruction = ?table.items[Instruction](?g.instructions)[first];
    sort.sort_by[Instruction](at, count, by_number);
    i = 1;
    for (i < count) {
        if (at[i - 1].number == at[i].number) { ret err[Fail].err{fail.about(fail.in_file(fail.malformed("two instructions share a number"), d.file.file), at[i].name)}; }
        i = i + 1;
    }
    var stated: [2]u32;
    val keys:   [2]str = [2]str{"version", "revision"};
    i = 0;
    for (i < 2) {
        val res_member: res[*Value, Fail] = document.member(d, ?d.root, keys[i]);
        if (sel res_member.err) { ret err[Fail].err{res_member.err}; }
        val res_word: res[u32, Fail] = document.word(d, res_member.ok, keys[i]);
        if (sel res_word.err) { ret err[Fail].err{res_word.err}; }
        stated[i] = res_word.ok;
        i         = i + 1;
    }
    val res_sets_pushed: res[Id[Set], Fail] = table.push[Set](?g.sets, Set{name: s.name, version: stated[0], revision: stated[1], instructions: Span{first: first, count: count}});
    if (sel res_sets_pushed.err) { ret err[Fail].err{res_sets_pushed.err}; }
    ret err[Fail].ok{};
}

# the value of the named constant `n`
fun constant(g: *Grammar, d: *Document, n: *Named) res[u32, Fail] {
    if (n.kind == nil) {
        var i: usize = 0;
        for (i < table.count[Op](?g.ops)) {
            val o: *Op = table.at[Op](?g.ops, table.nth[Op](i));
            if (str_equals(o.name, n.name)) { ret res[u32, Fail].ok{o.code}; }
            i = i + 1;
        }
        ret refuse[u32](d, "a named opcode is not in the grammar", n.name);
    }
    val res_kind_of: res[usize, Fail] = kind_of(g, d, n.kind);
    if (sel res_kind_of.err) { ret res[u32, Fail].err{res_kind_of.err}; }
    val res_member: res[*Value, Fail] = document.member(d, table.at[Kind](?g.kinds, table.nth[Kind](res_kind_of.ok)).source, "enumerants");
    if (sel res_member.err) { ret res[u32, Fail].err{res_member.err}; }
    val res_count: res[usize, Fail] = document.count(d, res_member.ok, "enumerants");
    if (sel res_count.err) { ret res[u32, Fail].err{res_count.err}; }
    var i: usize = 0;
    for (i < res_count.ok) {
        val o:          *Value            = document.item(res_member.ok, i);
        val res_member: res[*Value, Fail] = document.member(d, o, "enumerant");
        if (sel res_member.err) { ret res[u32, Fail].err{res_member.err}; }
        val res_name: res[str, Fail] = document.text(g.a, d, res_member.ok, "enumerant");
        if (sel res_name.err) { ret res[u32, Fail].err{res_name.err}; }
        if (str_equals(res_name.ok, n.name)) {
            val res_member: res[*Value, Fail] = document.member(d, o, "value");
            if (sel res_member.err) { ret res[u32, Fail].err{res_member.err}; }
            ret document.word(d, res_member.ok, n.name);
        }
        i = i + 1;
    }
    ret refuse[u32](d, "a named enumerant is not in the grammar", n.name);
}

# the grammar the core file `core` and the extended instruction set files
# `sets`, one per row of SETS, state
pub fun read(a: *A.Allocator, core: *Input, sets: *Input) res[Grammar, Fail] {
    var g: Grammar = Grammar{
        a:            a,
        kinds:        table.make[Kind](a),
        operands:     table.make[Operand](a),
        enumerants:   table.make[Enumerant](a),
        ops:          table.make[Op](a),
        instructions: table.make[Instruction](a),
        sets:         table.make[Set](a),
        names:        table.make[str](a),
        constants:    table.make[Constant](a),
    };
    val res_parsed: res[Document, Fail] = document.read(a, core);
    if (sel res_parsed.err) { ret res[Grammar, Fail].err{res_parsed.err}; }
    var d:       Document = res_parsed.ok;
    val version: [3]str   = [3]str{"major_version", "minor_version", "revision"};
    var parts:   [3]u32;
    var i:       usize    = 0;
    for (i < 3) {
        val res_member: res[*Value, Fail] = document.member(?d, ?d.root, version[i]);
        if (sel res_member.err) { ret res[Grammar, Fail].err{res_member.err}; }
        val res_word: res[u32, Fail] = document.word(?d, res_member.ok, version[i]);
        if (sel res_word.err) { ret res[Grammar, Fail].err{res_word.err}; }
        parts[i] = res_word.ok;
        i        = i + 1;
    }
    g.major    = parts[0];
    g.minor    = parts[1];
    g.revision = parts[2];
    val err_declared: err[Fail] = declare(?g, ?d);
    if (sel err_declared.err) { ret res[Grammar, Fail].err{err_declared.err}; }
    val err_defined: err[Fail] = define(?g, ?d);
    if (sel err_defined.err) { ret res[Grammar, Fail].err{err_defined.err}; }
    val err_synthesized: err[Fail] = synthesize(?g, ?d);
    if (sel err_synthesized.err) { ret res[Grammar, Fail].err{err_synthesized.err}; }
    val err_read_ops: err[Fail] = instructions(?g, ?d);
    if (sel err_read_ops.err) { ret res[Grammar, Fail].err{err_read_ops.err}; }
    val err_overridden: err[Fail] = override(?g, ?d);
    if (sel err_overridden.err) { ret res[Grammar, Fail].err{err_overridden.err}; }
    i = 0;
    for (i < SET_COUNT) {
        if (i > 0 && str_compare(SETS[i - 1].name, SETS[i].name) >= 0) {
            ret res[Grammar, Fail].err{fail.about(fail.internal("the extended instruction sets do not ascend by name"), SETS[i].name)};
        }
        val res_read: res[Document, Fail] = document.read(a, ?sets[i]);
        if (sel res_read.err) { ret res[Grammar, Fail].err{res_read.err}; }
        var sdoc:         Document  = res_read.ok;
        val err_sdoc_set: err[Fail] = set(?g, ?sdoc, ?SETS[i]);
        if (sel err_sdoc_set.err) { ret res[Grammar, Fail].err{err_sdoc_set.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < NAMED_COUNT) {
        if (i > 0 && str_compare(NAMED[i - 1].constant, NAMED[i].constant) >= 0) {
            ret res[Grammar, Fail].err{fail.about(fail.internal("the named constants do not ascend by name"), NAMED[i].constant)};
        }
        val res_constant: res[u32, Fail] = constant(?g, ?d, ?NAMED[i]);
        if (sel res_constant.err) { ret res[Grammar, Fail].err{res_constant.err}; }
        val res_constants_pushed: res[Id[Constant], Fail] = table.push[Constant](?g.constants, Constant{name: NAMED[i].constant, value: res_constant.ok});
        if (sel res_constants_pushed.err) { ret res[Grammar, Fail].err{res_constants_pushed.err}; }
        i = i + 1;
    }
    ret res[Grammar, Fail].ok{g};
}
