# the generated table, rendered as mach source
#
# the grammar renders as the static rows of mink.format.spirv.tables, typed
# by the records of mink.format.spirv.grammar. the output depends only on the
# grammar: kinds are written ascending by name, rows in the order the
# grammar's keys sort them, and every operand list is laid out once in one
# array in that order. the layout is the one `mach fmt` keeps: one
# declaration per paragraph and one array item per line.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_len;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

use gen.spirv;
use gen.spirv.Enumerant;
use gen.spirv.Grammar;
use gen.spirv.Instruction;
use gen.spirv.Kind;
use gen.spirv.Op;
use gen.spirv.Operand;
use gen.spirv.Set;
use gen.spirv.Span;

# the table's path under mink's root
pub val PATH: str = "src/format/spirv/tables.mach";

# the records the table is typed by, ascending
val USES_COUNT: usize           = 11;
val USES:       [USES_COUNT]str = [USES_COUNT]str{
    "Enum", "Enumerant", "Grammar", "Instruction", "Kind", "Op", "Operand", "Pair", "Quantifier", "Set", "Shape",
};

# the writes of one rendering, the first failure kept
rec Out {
    s:      *Sink;
    failed: bool;
    first:  Fail;
}

fun keep(o: *Out, e: err[Fail]) {
    if (o.failed) { ret; }
    if (sel e.err) {
        o.failed = true;
        o.first  = e.err;
    }
}

fun t(o: *Out, text: str) {
    keep(o, sink.text(o.s, text));
}

fun n(o: *Out, v: u64) {
    keep(o, sink.number(o.s, v, 10));
}

# whether `c` is an uppercase letter
fun upper(c: u8) bool {
    ret c >= 'A' && c <= 'Z';
}

# `name` in upper snake case: a lowercase letter or digit and the capital
# after it, and the last capital of a run before a lowercase letter, part
fun snake(o: *Out, name: str) {
    val len: usize = str_len(name);
    var i:   usize = 0;
    for (i < len) {
        val c: u8 = name[i];
        if (i > 0 && upper(c)) {
            val prev: u8 = name[i - 1];
            if (!upper(prev) || (i + 1 < len && name[i + 1] >= 'a' && name[i + 1] <= 'z')) { t(o, "_"); }
        }
        var w: [2]u8 = [2]u8{c, 0};
        if (c >= 'a' && c <= 'z') { w[0] = c - 'a' + 'A'; }
        t(o, ?w[0]);
        i = i + 1;
    }
}

fun quoted(o: *Out, name: str) {
    t(o, "\"");
    t(o, name);
    t(o, "\"");
}

fun kind_at(g: *Grammar, index: usize) *Kind {
    ret table.at[Kind](?g.kinds, table.nth[Kind](index));
}

fun operand_at(g: *Grammar, index: usize) *Operand {
    ret table.at[Operand](?g.operands, table.nth[Operand](index));
}

fun enumerant_at(g: *Grammar, index: usize) *Enumerant {
    ret table.at[Enumerant](?g.enumerants, table.nth[Enumerant](index));
}

# a reference to the `count` items of `array` from `at`, nil for none
fun slice(o: *Out, array: str, at: usize, count: usize) {
    if (count == 0) {
        t(o, "nil");
        ret;
    }
    t(o, "?");
    t(o, array);
    t(o, "[");
    n(o, at::u64);
    t(o, "]");
}

fun shape(o: *Out, k: *Kind) {
    if (k.category == spirv.VALUE_ENUM || k.category == spirv.BIT_ENUM) {
        if (k.category == spirv.VALUE_ENUM) { t(o, "Shape.value{?E_"); }
        or                                  { t(o, "Shape.bits{?E_"); }
        snake(o, k.name);
        t(o, "}");
        ret;
    }
    if (k.category == spirv.COMPOSITE) {
        t(o, "Shape.pair{?C_");
        snake(o, k.name);
        t(o, "}");
        ret;
    }
    t(o, "Shape.");
    t(o, k.shape);
    t(o, "{}");
}

fun kinds(o: *Out, g: *Grammar) {
    var i: usize = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind = kind_at(g, i);
        i = i + 1;
        if (!k.used) { cnt; }
        t(o, "val K_");
        snake(o, k.name);
        t(o, ": Kind = Kind{name: ");
        quoted(o, k.name);
        t(o, ", shape: ");
        shape(o, k);
        t(o, "};\n\n");
    }
}

fun pairs(o: *Out, g: *Grammar) {
    var i: usize = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind = kind_at(g, i);
        i = i + 1;
        if (!k.used || k.category != spirv.COMPOSITE) { cnt; }
        t(o, "val C_");
        snake(o, k.name);
        t(o, ": Pair = Pair{first: ?K_");
        snake(o, kind_at(g, k.first).name);
        t(o, ", second: ?K_");
        snake(o, kind_at(g, k.second).name);
        t(o, "};\n\n");
    }
}

fun enums(o: *Out, g: *Grammar) {
    var at: usize = 0;
    var i:  usize = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind = kind_at(g, i);
        i = i + 1;
        if (!k.used || (k.category != spirv.VALUE_ENUM && k.category != spirv.BIT_ENUM)) { cnt; }
        t(o, "val E_");
        snake(o, k.name);
        t(o, ": Enum = Enum{enumerants: ");
        slice(o, "ENUMERANTS", at, k.enumerants.count);
        t(o, ", count: ");
        n(o, k.enumerants.count::u64);
        t(o, "};\n\n");
        at = at + k.enumerants.count;
    }
}

# the head of the array `name` of `count` items of `of`
fun array(o: *Out, name: str, of: str, count: usize) {
    t(o, "val ");
    t(o, name);
    t(o, ": [");
    n(o, count::u64);
    t(o, "]");
    t(o, of);
    t(o, " = [");
    n(o, count::u64);
    t(o, "]");
    t(o, of);
    t(o, "{\n");
}

fun list(o: *Out, g: *Grammar, s: Span) {
    var i: usize = 0;
    for (i < s.count) {
        val op: *Operand = operand_at(g, s.first + i);
        t(o, "    Operand{kind: ?K_");
        snake(o, kind_at(g, op.kind).name);
        if (op.quantifier == spirv.ONE)      { t(o, ", quantifier: Quantifier.one{}},\n"); }
        or (op.quantifier == spirv.OPTIONAL) { t(o, ", quantifier: Quantifier.optional{}},\n"); }
        or                                   { t(o, ", quantifier: Quantifier.many{}},\n"); }
        i = i + 1;
    }
}

# the enumerants of every used enum kind, in kind order
fun each_enumerant(g: *Grammar, visit: fun(*Out, *Grammar, *Enumerant, usize) usize, o: *Out, at: usize) usize {
    var next: usize = at;
    var i:    usize = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind = kind_at(g, i);
        i = i + 1;
        if (!k.used) { cnt; }
        var e: usize = 0;
        for (e < k.enumerants.count) {
            next = visit(o, g, enumerant_at(g, k.enumerants.first + e), next);
            e    = e + 1;
        }
    }
    ret next;
}

fun count_enumerant(o: *Out, g: *Grammar, e: *Enumerant, at: usize) usize {
    ret at + 1;
}

fun count_operands(o: *Out, g: *Grammar, e: *Enumerant, at: usize) usize {
    ret at + e.operands.count;
}

fun list_enumerant(o: *Out, g: *Grammar, e: *Enumerant, at: usize) usize {
    list(o, g, e.operands);
    ret at + e.operands.count;
}

fun row_enumerant(o: *Out, g: *Grammar, e: *Enumerant, at: usize) usize {
    t(o, "    Enumerant{value: ");
    n(o, e.value::u64);
    t(o, ", name: ");
    quoted(o, e.name);
    t(o, ", operands: ");
    slice(o, "OPERANDS", at, e.operands.count);
    t(o, ", count: ");
    n(o, e.operands.count::u64);
    t(o, "},\n");
    ret at + e.operands.count;
}

fun operand_total(g: *Grammar, o: *Out) usize {
    var total: usize = each_enumerant(g, count_operands, o, 0);
    var i:     usize = 0;
    for (i < table.count[Op](?g.ops)) {
        total = total + table.at[Op](?g.ops, table.nth[Op](i)).operands.count;
        i     = i + 1;
    }
    i = 0;
    for (i < table.count[Instruction](?g.instructions)) {
        total = total + table.at[Instruction](?g.instructions, table.nth[Instruction](i)).operands.count;
        i     = i + 1;
    }
    ret total;
}

fun operands(o: *Out, g: *Grammar) {
    array(o, "OPERANDS", "Operand", operand_total(g, o));
    each_enumerant(g, list_enumerant, o, 0);
    var i: usize = 0;
    for (i < table.count[Op](?g.ops)) {
        list(o, g, table.at[Op](?g.ops, table.nth[Op](i)).operands);
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Instruction](?g.instructions)) {
        list(o, g, table.at[Instruction](?g.instructions, table.nth[Instruction](i)).operands);
        i = i + 1;
    }
    t(o, "};\n\n");
}

fun rows(o: *Out, g: *Grammar) {
    array(o, "ENUMERANTS", "Enumerant", each_enumerant(g, count_enumerant, o, 0));
    var at: usize = each_enumerant(g, row_enumerant, o, 0);
    t(o, "};\n\n");
    val ops: usize = table.count[Op](?g.ops);
    array(o, "OPS", "Op", ops);
    var i: usize = 0;
    for (i < ops) {
        val op: *Op = table.at[Op](?g.ops, table.nth[Op](i));
        t(o, "    Op{code: ");
        n(o, op.code::u64);
        t(o, ", name: ");
        quoted(o, op.name);
        t(o, ", operands: ");
        slice(o, "OPERANDS", at, op.operands.count);
        t(o, ", count: ");
        n(o, op.operands.count::u64);
        t(o, "},\n");
        at = at + op.operands.count;
        i  = i + 1;
    }
    t(o, "};\n\n");
    val insts: usize = table.count[Instruction](?g.instructions);
    array(o, "INSTRUCTIONS", "Instruction", insts);
    i = 0;
    for (i < insts) {
        val x: *Instruction = table.at[Instruction](?g.instructions, table.nth[Instruction](i));
        t(o, "    Instruction{number: ");
        n(o, x.number::u64);
        t(o, ", name: ");
        quoted(o, x.name);
        t(o, ", operands: ");
        slice(o, "OPERANDS", at, x.operands.count);
        t(o, ", count: ");
        n(o, x.operands.count::u64);
        t(o, "},\n");
        at = at + x.operands.count;
        i  = i + 1;
    }
    t(o, "};\n\n");
    val sets: usize = table.count[Set](?g.sets);
    array(o, "SETS", "Set", sets);
    i = 0;
    for (i < sets) {
        val s: *Set = table.at[Set](?g.sets, table.nth[Set](i));
        t(o, "    Set{name: ");
        quoted(o, s.name);
        t(o, ", instructions: ");
        slice(o, "INSTRUCTIONS", s.instructions.first, s.instructions.count);
        t(o, ", count: ");
        n(o, s.instructions.count::u64);
        t(o, "},\n");
        i = i + 1;
    }
    t(o, "};\n\n");
    t(o, "pub val GRAMMAR: Grammar = Grammar{ops: ?OPS[0], count: ");
    n(o, ops::u64);
    t(o, ", sets: ?SETS[0], set_count: ");
    n(o, sets::u64);
    t(o, "};\n");
}

# whether every name the table writes in a string is spelled with letters,
# digits, `_` and `.` alone, so it needs no escape
fun plain(name: str) bool {
    var i: usize = 0;
    for (name[i] != 0) {
        val c: u8 = name[i];
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.')) { ret false; }
        i = i + 1;
    }
    ret i > 0;
}

fun refuse_name(name: str) err[Fail] {
    ret err[Fail].err{fail.about(fail.malformed("a name holds a byte the table cannot write plainly"), name)};
}

# refuse a grammar whose names need escaping or whose used kinds two of
# take one identifier
fun check(a: *A.Allocator, g: *Grammar) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind = kind_at(g, i);
        if (k.used && !plain(k.name)) { ret refuse_name(k.name); }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Enumerant](?g.enumerants)) {
        if (!plain(enumerant_at(g, i).name)) { ret refuse_name(enumerant_at(g, i).name); }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Op](?g.ops)) {
        val op: *Op = table.at[Op](?g.ops, table.nth[Op](i));
        if (!plain(op.name)) { ret refuse_name(op.name); }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Instruction](?g.instructions)) {
        val x: *Instruction = table.at[Instruction](?g.instructions, table.nth[Instruction](i));
        if (!plain(x.name)) { ret refuse_name(x.name); }
        i = i + 1;
    }
    var idents: Table[Sink] = table.make[Sink](a);
    i = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind = kind_at(g, i);
        i = i + 1;
        if (!k.used) { cnt; }
        var s: Sink = sink.make(a, LITTLE);
        var o: Out  = Out{s: ?s};
        snake(?o, k.name);
        keep(?o, sink.u8(?s, 0));
        if (o.failed) { ret err[Fail].err{o.first}; }
        val p: res[table.Id[Sink], Fail] = table.push[Sink](?idents, s);
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    val at: *Sink = table.items[Sink](?idents);
    val m:  usize = table.count[Sink](?idents);
    sort.sort_by[Sink](at, m, by_text);
    i = 1;
    for (i < m) {
        if (by_text(?at[i - 1], ?at[i]) == 0) { ret err[Fail].err{fail.about(fail.malformed("two kinds take one identifier"), sink.data(?at[i])::str)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun by_text(a: *Sink, b: *Sink) i64 {
    ret str_compare(sink.data(a)::str, sink.data(b)::str);
}

# the table `g` renders as, in a sink of its own
pub fun render(a: *A.Allocator, g: *Grammar) res[Sink, Fail] {
    val c: err[Fail] = check(a, g);
    if (sel c.err) { ret res[Sink, Fail].err{c.err}; }
    var s: Sink = sink.make(a, LITTLE);
    var o: Out  = Out{s: ?s};
    t(?o, "# the SPIR-V grammar rows mink carries, generated by gen from the grammar\n");
    t(?o, "# of SPIR-V ");
    n(?o, g.major::u64);
    t(?o, ".");
    n(?o, g.minor::u64);
    t(?o, " revision ");
    n(?o, g.revision::u64);
    t(?o, " vendored in gen/vendor/spirv-headers.\n");
    t(?o, "# regenerate it with gen, never by hand\n\n");
    var i: usize = 0;
    for (i < USES_COUNT) {
        t(?o, "use mink.format.spirv.grammar.");
        t(?o, USES[i]);
        t(?o, ";\n");
        i = i + 1;
    }
    t(?o, "\n");
    i = 0;
    for (i < table.count[spirv.Constant](?g.constants)) {
        val k: *spirv.Constant = table.at[spirv.Constant](?g.constants, table.nth[spirv.Constant](i));
        t(?o, "pub val ");
        t(?o, k.name);
        t(?o, ": u32 = ");
        n(?o, k.value::u64);
        t(?o, ";\n\n");
        i = i + 1;
    }
    kinds(?o, g);
    pairs(?o, g);
    enums(?o, g);
    operands(?o, g);
    rows(?o, g);
    if (o.failed) {
        val dropped: err[Fail] = sink.release(?s);
        ret res[Sink, Fail].err{o.first};
    }
    ret res[Sink, Fail].ok{s};
}
