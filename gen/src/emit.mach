# the generated table, rendered as mach source
#
# the grammar renders as the static rows of mink.format.spirv.tables, typed
# by the records of mink.format.spirv.grammar. the output depends only on the
# grammar: kinds are written ascending by name, rows in the order the
# grammar's keys sort them, and every operand list and every list of names
# is laid out once in one array, in the order the generator read them. the
# layout is the one `mach fmt` keeps: one declaration per paragraph and one
# array item per line.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_len;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

use gen.spirv;
use gen.spirv.Availability;
use gen.spirv.Enumerant;
use gen.spirv.Grammar;
use gen.spirv.Instruction;
use gen.spirv.Kind;
use gen.spirv.Op;
use gen.spirv.Operand;
use gen.spirv.Set;
use gen.spirv.Span;

# the table's path under mink's root
pub val PATH: str = "src/format/spirv/tables.mach";

# the records the table is typed by, ascending
val USES_COUNT: usize           = 12;
val USES:       [USES_COUNT]str = [USES_COUNT]str{
    "Availability", "Enum", "Enumerant", "Grammar", "Instruction", "Kind", "Op", "Operand", "Pair", "Quantifier", "Set", "Shape",
};

# the writes of one rendering, the first failure kept
rec Out {
    s:      *Sink;
    failed: bool;
    first:  Fail;
}

fun keep(o: *Out, e: err[Fail]) {
    if (o.failed) { ret; }
    if (sel e.err) {
        o.failed = true;
        o.first  = e.err;
    }
}

fun t(o: *Out, text: str) {
    keep(o, sink.text(o.s, text));
}

fun n(o: *Out, v: u64) {
    keep(o, sink.number(o.s, v, 10));
}

fun hex(o: *Out, v: u64) {
    if (v == 0) {
        t(o, "0");
        ret;
    }
    t(o, "0x");
    keep(o, sink.number(o.s, v, 16));
}

# whether `c` is an uppercase letter
fun upper(c: u8) bool {
    ret c >= 'A' && c <= 'Z';
}

# `name` in upper snake case: a lowercase letter or digit and the capital
# after it, and the last capital of a run before a lowercase letter, part
fun snake(o: *Out, name: str) {
    val len: usize = str_len(name);
    var i:   usize = 0;
    for (i < len) {
        val c: u8 = name[i];
        if (i > 0 && upper(c)) {
            val prev: u8 = name[i - 1];
            if (!upper(prev) || (i + 1 < len && name[i + 1] >= 'a' && name[i + 1] <= 'z')) { t(o, "_"); }
        }
        var w: [2]u8 = [2]u8{c, 0};
        if (c >= 'a' && c <= 'z') { w[0] = c - 'a' + 'A'; }
        t(o, ?w[0]);
        i = i + 1;
    }
}

# `text` as a string literal, nil for none, a quote, a backslash and a line
# break escaped
fun quoted(o: *Out, text: str) {
    if (text == nil) {
        t(o, "nil");
        ret;
    }
    t(o, "\"");
    var i: usize = 0;
    for (text[i] != 0) {
        val c: u8 = text[i];
        i = i + 1;
        if (c == '"')  { t(o, "\\\""); }
        or (c == '\\') { t(o, "\\\\"); }
        or (c == '\n') { t(o, "\\n"); }
        or {
            var w: [2]u8 = [2]u8{c, 0};
            t(o, ?w[0]);
        }
    }
    t(o, "\"");
}

fun kind_at(g: *Grammar, index: usize) *Kind {
    ret table.at[Kind](?g.kinds, table.nth[Kind](index));
}

fun operand_at(g: *Grammar, index: usize) *Operand {
    ret table.at[Operand](?g.operands, table.nth[Operand](index));
}

fun enumerant_at(g: *Grammar, index: usize) *Enumerant {
    ret table.at[Enumerant](?g.enumerants, table.nth[Enumerant](index));
}

# a reference to the `count` items of `array` from `at`, nil for none
fun slice(o: *Out, array: str, at: usize, count: usize) {
    if (count == 0) {
        t(o, "nil");
        ret;
    }
    t(o, "?");
    t(o, array);
    t(o, "[");
    n(o, at::u64);
    t(o, "]");
}

# a span of `array` and its count field `field`
fun spanned(o: *Out, array: str, s: Span, field: str) {
    slice(o, array, s.first, s.count);
    t(o, ", ");
    t(o, field);
    t(o, ": ");
    n(o, s.count::u64);
}

fun available(o: *Out, v: *Availability) {
    t(o, "Availability{version: ");
    hex(o, v.version::u64);
    t(o, ", last: ");
    hex(o, v.last::u64);
    t(o, ", extensions: ");
    spanned(o, "NAMES", v.extensions, "extension_count");
    t(o, ", capabilities: ");
    spanned(o, "NAMES", v.capabilities, "capability_count");
    t(o, "}");
}

fun shape(o: *Out, k: *Kind) {
    if (k.category == spirv.VALUE_ENUM || k.category == spirv.BIT_ENUM) {
        if (k.category == spirv.VALUE_ENUM) { t(o, "Shape.value{?E_"); }
        or                                  { t(o, "Shape.bits{?E_"); }
        snake(o, k.name);
        t(o, "}");
        ret;
    }
    if (k.category == spirv.COMPOSITE) {
        t(o, "Shape.pair{?C_");
        snake(o, k.name);
        t(o, "}");
        ret;
    }
    t(o, "Shape.");
    t(o, k.shape);
    t(o, "{}");
}

fun kinds(o: *Out, g: *Grammar) {
    var i: usize = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind = kind_at(g, i);
        i = i + 1;
        t(o, "val K_");
        snake(o, k.name);
        t(o, ": Kind = Kind{name: ");
        quoted(o, k.name);
        t(o, ", shape: ");
        shape(o, k);
        t(o, "};\n\n");
    }
}

fun pairs(o: *Out, g: *Grammar) {
    var i: usize = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind = kind_at(g, i);
        i = i + 1;
        if (k.category != spirv.COMPOSITE) { cnt; }
        t(o, "val C_");
        snake(o, k.name);
        t(o, ": Pair = Pair{first: ?K_");
        snake(o, kind_at(g, k.first).name);
        t(o, ", second: ?K_");
        snake(o, kind_at(g, k.second).name);
        t(o, "};\n\n");
    }
}

fun enums(o: *Out, g: *Grammar) {
    var i: usize = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind = kind_at(g, i);
        i = i + 1;
        if (k.category != spirv.VALUE_ENUM && k.category != spirv.BIT_ENUM) { cnt; }
        t(o, "val E_");
        snake(o, k.name);
        t(o, ": Enum = Enum{enumerants: ");
        spanned(o, "ENUMERANTS", k.enumerants, "count");
        t(o, "};\n\n");
    }
}

# the head of the array `name` of `count` items of `of`
fun array(o: *Out, name: str, of: str, count: usize) {
    t(o, "val ");
    t(o, name);
    t(o, ": [");
    n(o, count::u64);
    t(o, "]");
    t(o, of);
    t(o, " = [");
    n(o, count::u64);
    t(o, "]");
    t(o, of);
    t(o, "{\n");
}

fun kind_list(o: *Out, g: *Grammar) {
    val count: usize = table.count[Kind](?g.kinds);
    array(o, "KINDS", "*Kind", count);
    var i: usize = 0;
    for (i < count) {
        t(o, "    ?K_");
        snake(o, kind_at(g, i).name);
        t(o, ",\n");
        i = i + 1;
    }
    t(o, "};\n\n");
}

fun names(o: *Out, g: *Grammar) {
    val count: usize = table.count[str](?g.names);
    array(o, "NAMES", "str", count);
    var i: usize = 0;
    for (i < count) {
        t(o, "    ");
        quoted(o, @table.at[str](?g.names, table.nth[str](i)));
        t(o, ",\n");
        i = i + 1;
    }
    t(o, "};\n\n");
}

fun operands(o: *Out, g: *Grammar) {
    val count: usize = table.count[Operand](?g.operands);
    array(o, "OPERANDS", "Operand", count);
    var i: usize = 0;
    for (i < count) {
        val op: *Operand = operand_at(g, i);
        t(o, "    Operand{kind: ?K_");
        snake(o, kind_at(g, op.kind).name);
        if (op.quantifier == spirv.ONE)      { t(o, ", quantifier: Quantifier.one{}"); }
        or (op.quantifier == spirv.OPTIONAL) { t(o, ", quantifier: Quantifier.optional{}"); }
        or                                   { t(o, ", quantifier: Quantifier.many{}"); }
        t(o, ", name: ");
        quoted(o, op.name);
        t(o, "},\n");
        i = i + 1;
    }
    t(o, "};\n\n");
}

fun rows(o: *Out, g: *Grammar) {
    val enumerants: usize = table.count[Enumerant](?g.enumerants);
    array(o, "ENUMERANTS", "Enumerant", enumerants);
    var i: usize = 0;
    for (i < enumerants) {
        val e: *Enumerant = enumerant_at(g, i);
        t(o, "    Enumerant{value: ");
        n(o, e.value::u64);
        t(o, ", name: ");
        quoted(o, e.name);
        t(o, ", operands: ");
        spanned(o, "OPERANDS", e.operands, "count");
        t(o, ", availability: ");
        available(o, ?e.availability);
        t(o, ", aliases: ");
        spanned(o, "NAMES", e.aliases, "alias_count");
        t(o, "},\n");
        i = i + 1;
    }
    t(o, "};\n\n");
    val ops: usize = table.count[Op](?g.ops);
    array(o, "OPS", "Op", ops);
    i = 0;
    for (i < ops) {
        val op: *Op = table.at[Op](?g.ops, table.nth[Op](i));
        t(o, "    Op{code: ");
        n(o, op.code::u64);
        t(o, ", name: ");
        quoted(o, op.name);
        t(o, ", class: ");
        quoted(o, op.class);
        t(o, ", operands: ");
        spanned(o, "OPERANDS", op.operands, "count");
        t(o, ", availability: ");
        available(o, ?op.availability);
        t(o, ", aliases: ");
        spanned(o, "NAMES", op.aliases, "alias_count");
        t(o, "},\n");
        i = i + 1;
    }
    t(o, "};\n\n");
    val insts: usize = table.count[Instruction](?g.instructions);
    array(o, "INSTRUCTIONS", "Instruction", insts);
    i = 0;
    for (i < insts) {
        val x: *Instruction = table.at[Instruction](?g.instructions, table.nth[Instruction](i));
        t(o, "    Instruction{number: ");
        n(o, x.number::u64);
        t(o, ", name: ");
        quoted(o, x.name);
        t(o, ", operands: ");
        spanned(o, "OPERANDS", x.operands, "count");
        t(o, ", availability: ");
        available(o, ?x.availability);
        t(o, "},\n");
        i = i + 1;
    }
    t(o, "};\n\n");
    val sets: usize = table.count[Set](?g.sets);
    array(o, "SETS", "Set", sets);
    i = 0;
    for (i < sets) {
        val s: *Set = table.at[Set](?g.sets, table.nth[Set](i));
        t(o, "    Set{name: ");
        quoted(o, s.name);
        t(o, ", version: ");
        n(o, s.version::u64);
        t(o, ", revision: ");
        n(o, s.revision::u64);
        t(o, ", instructions: ");
        spanned(o, "INSTRUCTIONS", s.instructions, "count");
        t(o, "},\n");
        i = i + 1;
    }
    t(o, "};\n\n");
    t(o, "pub val GRAMMAR: Grammar = Grammar{major: ");
    n(o, g.major::u64);
    t(o, ", minor: ");
    n(o, g.minor::u64);
    t(o, ", revision: ");
    n(o, g.revision::u64);
    t(o, ", kinds: ?KINDS[0], kind_count: ");
    n(o, table.count[Kind](?g.kinds)::u64);
    t(o, ", ops: ?OPS[0], count: ");
    n(o, ops::u64);
    t(o, ", sets: ?SETS[0], set_count: ");
    n(o, sets::u64);
    t(o, "};\n");
}

# whether a name the table writes as an identifier is spelled with letters,
# digits and `_` alone
fun plain(name: str) bool {
    var i: usize = 0;
    for (name[i] != 0) {
        val c: u8 = name[i];
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_')) { ret false; }
        i = i + 1;
    }
    ret i > 0;
}

# whether `text` holds only bytes a string literal writes as they are or as
# the escapes `quoted` writes
fun printable(text: str) bool {
    if (text == nil) { ret true; }
    var i: usize = 0;
    for (text[i] != 0) {
        val c: u8 = text[i];
        if ((c < 0x20 && c != '\n') || c >= 0x7F) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun refuse_name(name: str) err[Fail] {
    ret err[Fail].err{fail.about(fail.malformed("a name holds a byte the table cannot write"), name)};
}

# refuse a grammar whose kind names are no identifiers, whose texts hold a
# byte a string literal cannot write, or whose kinds two of take one
# identifier
fun check(a: *A.Allocator, g: *Grammar) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind = kind_at(g, i);
        if (!plain(k.name)) { ret refuse_name(k.name); }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Enumerant](?g.enumerants)) {
        if (!printable(enumerant_at(g, i).name)) { ret refuse_name(enumerant_at(g, i).name); }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Op](?g.ops)) {
        val op: *Op = table.at[Op](?g.ops, table.nth[Op](i));
        if (!printable(op.name))  { ret refuse_name(op.name); }
        if (!printable(op.class)) { ret refuse_name(op.class); }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Instruction](?g.instructions)) {
        val x: *Instruction = table.at[Instruction](?g.instructions, table.nth[Instruction](i));
        if (!printable(x.name)) { ret refuse_name(x.name); }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Operand](?g.operands)) {
        if (!printable(operand_at(g, i).name)) { ret refuse_name(operand_at(g, i).name); }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[str](?g.names)) {
        val name: str = @table.at[str](?g.names, table.nth[str](i));
        if (!printable(name)) { ret refuse_name(name); }
        i = i + 1;
    }
    var idents: Table[Sink] = table.make[Sink](a);
    i = 0;
    for (i < table.count[Kind](?g.kinds)) {
        val k: *Kind = kind_at(g, i);
        i = i + 1;
        var s: Sink = sink.make(a, LITTLE);
        var o: Out  = Out{s: ?s};
        snake(?o, k.name);
        keep(?o, sink.u8(?s, 0));
        if (o.failed) { ret err[Fail].err{o.first}; }
        val p: res[table.Id[Sink], Fail] = table.push[Sink](?idents, s);
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    val at: *Sink = table.items[Sink](?idents);
    val m:  usize = table.count[Sink](?idents);
    sort.sort_by[Sink](at, m, by_text);
    i = 1;
    for (i < m) {
        if (by_text(?at[i - 1], ?at[i]) == 0) { ret err[Fail].err{fail.about(fail.malformed("two kinds take one identifier"), sink.data(?at[i])::str)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun by_text(a: *Sink, b: *Sink) i64 {
    ret str_compare(sink.data(a)::str, sink.data(b)::str);
}

# the table `g` renders as, in a sink of its own
pub fun render(a: *A.Allocator, g: *Grammar) res[Sink, Fail] {
    val c: err[Fail] = check(a, g);
    if (sel c.err) { ret res[Sink, Fail].err{c.err}; }
    var s: Sink = sink.make(a, LITTLE);
    var o: Out  = Out{s: ?s};
    t(?o, "# the SPIR-V grammar rows mink carries, generated by gen from the grammar\n");
    t(?o, "# of SPIR-V ");
    n(?o, g.major::u64);
    t(?o, ".");
    n(?o, g.minor::u64);
    t(?o, " revision ");
    n(?o, g.revision::u64);
    t(?o, " vendored in gen/vendor/spirv-headers.\n");
    t(?o, "# regenerate it with gen, never by hand\n\n");
    var i: usize = 0;
    for (i < USES_COUNT) {
        t(?o, "use mink.format.spirv.grammar.");
        t(?o, USES[i]);
        t(?o, ";\n");
        i = i + 1;
    }
    t(?o, "\n");
    i = 0;
    for (i < table.count[spirv.Constant](?g.constants)) {
        val k: *spirv.Constant = table.at[spirv.Constant](?g.constants, table.nth[spirv.Constant](i));
        t(?o, "pub val ");
        t(?o, k.name);
        t(?o, ": u32 = ");
        n(?o, k.value::u64);
        t(?o, ";\n\n");
        i = i + 1;
    }
    kinds(?o, g);
    pairs(?o, g);
    enums(?o, g);
    kind_list(?o, g);
    names(?o, g);
    operands(?o, g);
    rows(?o, g);
    if (o.failed) {
        val dropped: err[Fail] = sink.release(?s);
        ret res[Sink, Fail].err{o.first};
    }
    ret res[Sink, Fail].ok{s};
}
