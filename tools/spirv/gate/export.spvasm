; a module exporting the function f, which import.spvasm calls
               OpCapability Shader
               OpCapability Linkage
               OpMemoryModel Logical GLSL450
               OpDecorate %f LinkageAttributes "f" Export
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
          %f = OpFunction %void None %fn
      %entry = OpLabel
               OpReturn
               OpFunctionEnd
