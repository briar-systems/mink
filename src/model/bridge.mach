# the bridges between code of two conventions that share one image
#
# an image that holds code of two conventions, as an ARM64EC image holds
# ARM64EC and x64 code, crosses between them through thunks the compiler
# makes: an entry thunk an emulated caller enters a native function through,
# and an exit thunk a native caller leaves for an emulated callee through
# ("entry and exit thunks", understanding Arm64EC ABI and assembly code). an
# object states which thunk serves which symbol as a bridge, a row of the
# roles below, and the link reads the role: what it keeps the thunk alive
# with, and the word it lays before the function the thunk enters.

use std.types.size.usize;
use std.types.string.str;

# what keeps a bridge's thunk alive
# ---
# function: the function it serves, as an entry thunk lives while its
#           function does
# import:   a reference to its symbol that binds to a shared library, as the
#           exit thunk of an imported callee serves the check that leaves
#           for it
# code:     the code that refers to it, as any other code is kept
pub tag Keeps: u8 {
    function;
    import;
    code;
}

# what a bridge is to the link
# ---
# name:  its spelling in a diagnostic
# keeps: what keeps its thunk alive
# lead:  the bytes the link lays right before the function a bridge of the
#        role serves, holding the distance from the function to the thunk,
#        zero for a role that lays none. the emulator "reads the four bytes
#        before the start of the function, masks out the lower two bits, and
#        adds that amount to the address of the function" ("entry thunks",
#        understanding Arm64EC ABI and assembly code)
pub rec Role {
    name:  str;
    keeps: Keeps;
    lead:  u64;
}

# the thunk an emulated caller enters the function through
pub val ENTRY: Role = Role{name: "entry thunk", keeps: Keeps.function{}, lead: 4};
# the thunk a native caller leaves for the emulated callee through
pub val EXIT: Role = Role{name: "exit thunk", keeps: Keeps.import{}, lead: 0};
# the native stand-in for a callee the image may define in emulated code, as
# a weak definition of the native name that leaves through the callee's exit
# thunk
pub val GUEST_EXIT: Role = Role{name: "guest exit thunk", keeps: Keeps.code{}, lead: 0};

val ROLE_COUNT: usize             = 3;
val ROLES:      [ROLE_COUNT]*Role = [ROLE_COUNT]*Role{?ENTRY, ?EXIT, ?GUEST_EXIT};

pub fun role_count() usize {
    ret ROLE_COUNT;
}

pub fun role_at(index: usize) *Role {
    ret ROLES[index];
}
