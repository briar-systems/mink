# the capabilities the dynamic linking model states of a reference's target,
# by how its binding resolves in the link. the dynamic phase states them of
# every target, its rules read them, and a relocation form's condition holds
# over them

pub def Caps: u64;

# target: the image defines it
pub val DEFINED: Caps = 0x1;
# target: a shared library defines it
pub val IMPORTED: Caps = 0x2;
# target: the image defines it and another image's definition may preempt it
pub val PREEMPTIBLE: Caps = 0x4;
# target: nothing defines it, as a weak reference or an output that keeps
# undefined references allows
pub val UNDEFINED: Caps = 0x8;
# target: the loader decides its address, since it is imported, preemptible,
# or undefined in an output a loader binds
pub val BOUND: Caps = 0x10;
# target: its value is fixed rather than an address in the image
pub val ABSOLUTE: Caps = 0x20;
# target: names code
pub val CODE: Caps = 0x40;
# target: names data
pub val DATA: Caps = 0x80;
# target: names thread-local data
pub val THREAD: Caps = 0x200;
# target: names the cell the loader fills with an import's address
pub val CELL: Caps = 0x400;
# target: the start of its image's thread-local block, the base a descriptor
# access counts a module's offsets from, whose thread pointer offset is zero
# to the local exec form such an access takes
pub val BASE: Caps = 0x800;
