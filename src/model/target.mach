# what an object or an image is for: an architecture, the system and
# environment it runs under, and the versions it states
#
# a link's options, every object, the synthesizers' context and the image
# carry one target. an object read from a file states the architecture its
# format codes, and a system or a version only where the file states one, so
# a fact the file does not state is absent, never a default.

use std.types.option.opt;

use mink.catalog.arch.Arch;
use mink.catalog.arch.x86;
use mink.catalog.os.Env;
use mink.catalog.os.Host;
use mink.catalog.os.System;
use mink.catalog.os.Version;
use mink.catalog.os.windows;
use mink.catalog.subsystem;
use mink.catalog.subsystem.Subsystem;

# arch:      the architecture
# system:    the system it runs on, none for an object that states none
# env:       the environment of the system, none for a system that has none
# version:   the oldest system version it runs on, none where none is stated
# sdk:       the SDK version it was built against, none where none is stated
# subsystem: the PE subsystem it states, none where it states none
pub rec Target {
    arch:      *Arch;
    system:    opt[*System];
    env:       opt[*Env];
    version:   opt[Version];
    sdk:       opt[Version];
    subsystem: opt[*Subsystem];
}

# the target of an architecture alone, as an object a producer builds for it
# before it states anything else
pub fun of(a: *Arch) Target {
    ret Target{arch: a, system: opt[*System].none{}, env: opt[*Env].none{}, version: opt[Version].none{}, sdk: opt[Version].none{}, subsystem: opt[*Subsystem].none{}};
}

# the PE subsystem an image of `t` on host `h` states: the target's, else the
# host's default, none where neither states one
pub fun subsystem_on(t: *Target, h: *Host) opt[*Subsystem] {
    if (sel t.subsystem.some) { ret t.subsystem; }
    ret h.subsystem;
}

val CONSOLE_HOST: Host = Host{system: ?windows.WINDOWS, env: opt[*Env].some{?windows.MSVC}, arch: ?x86.X86_64, subsystem: opt[*Subsystem].some{?subsystem.CONSOLE}};
val BARE_HOST:    Host = Host{system: ?windows.WINDOWS, env: opt[*Env].some{?windows.MSVC}, arch: ?x86.X86_64};

test target__a_stated_subsystem_wins_and_an_unstated_one_reads_the_host {
    var t: Target          = of(?x86.X86_64);
    val d: opt[*Subsystem] = subsystem_on(?t, ?CONSOLE_HOST);
    if (!sel d.some)                  { ret 1; }
    if (d.some != ?subsystem.CONSOLE) { ret 1; }
    val n: opt[*Subsystem] = subsystem_on(?t, ?BARE_HOST);
    if (!sel n.none) { ret 2; }
    t.subsystem = opt[*Subsystem].some{?subsystem.WINDOWS};
    val s: opt[*Subsystem] = subsystem_on(?t, ?CONSOLE_HOST);
    if (!sel s.some)                  { ret 3; }
    if (s.some != ?subsystem.WINDOWS) { ret 3; }
    ret 0;
}
