# the pieces of the debug records a neutral object states
#
# a producer states the source types and variables a debugger reads as
# records, the same as it states line sequences and frames, and the format the
# object is written or linked as encodes them, as DWARF debugging information
# entries in its lowering. every size and offset a record holds is the
# producer's, which owns its layout, and every register is named by the number
# the architecture's DWARF register mapping gives it. the records that name a
# place in the code or a symbol of the object, the globals, the functions and
# the code inlined into them, live on the object beside the tables these
# pieces are kept in. a record names others by id or by a run of a table, and
# the lowering refuses one whose id or run lies past its table.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;

use mink.base.intern.Name;
use mink.base.table.Id;
use mink.model.line.File;

# the items of a table a record names: where the first lies and how many
# there are
pub rec Run {
    first: usize;
    count: usize;
}

# how a scalar's bits read
pub tag Encoding: u8 {
    address;
    boolean;
    float;
    signed;
    unsigned;
    character;
}

# a scalar of `bits` bits, at least one
pub rec Base {
    encoding: Encoding;
    bits:     u32;
}

# a member of an aggregate
# ---
# name:   its source name, empty for an anonymous one
# type:   its type
# offset: its byte offset in the aggregate the record describes
pub rec Member {
    name:   Id[Name];
    type:   Id[Type];
    offset: u64;
}

# a structure or a union: its size in bytes and its members, a run of the
# members table, in source order
pub rec Aggregate {
    size:    u64;
    members: Run;
}

# a case of a tagged union: the discriminant value that selects it and the
# member its payload is, none for a case with no payload
pub rec Case {
    value:   u64;
    payload: opt[Member];
}

# a tagged union: its size in bytes, the member its discriminant is and its
# cases, a run of the cases table, in source order
pub rec Tagged {
    size:         u64;
    discriminant: Member;
    cases:        Run;
}

# a named value of an enumeration
pub rec Enumerator {
    name:  Id[Name];
    value: u64;
}

# an enumeration: the type its values are of, its size in bytes and its
# values, a run of the enumerators table, in source order
pub rec Enumeration {
    base:        Id[Type];
    size:        u64;
    enumerators: Run;
}

# an array of `count` elements of `element`
pub rec Array {
    element: Id[Type];
    count:   u64;
}

# a function type: its result, none for a function that returns nothing, and
# its parameters, a run of the parameters table
pub rec Routine {
    result: opt[Id[Type]];
    params: Run;
}

# the kind of a type declared and never defined, whose shape is unknown
# ---
# structure:   a structure or a tagged union
# union:       a union
# enumeration: an enumeration
# other:       any other kind, which a declaration cannot state the shape of
pub tag Declared: u8 {
    structure;
    union;
    enumeration;
    other;
}

# what a type is
# ---
# declared:    a type declared and never defined
# base:        a scalar
# structure:   a structure
# union:       a union
# tagged:      a tagged union
# enumeration: an enumeration
# array:       an array
# pointer:     a pointer, to the type it names or to nothing stated, the
#              size of an address
# routine:     a function type
pub tag Shape: u8 {
    declared:    Declared;
    base:        Base;
    structure:   Aggregate;
    union:       Aggregate;
    tagged:      Tagged;
    enumeration: Enumeration;
    array:       Array;
    pointer:     opt[Id[Type]];
    routine:     Routine;
}

# a source type: its name, empty for an anonymous one, and what it is
pub rec Type {
    name:  Id[Name];
    shape: Shape;
}

# the widths in bits a step reads and gives
pub rec Widths {
    from: u32;
    to:   u32;
}

# a step that recovers a variable's value from what its location holds,
# applied in order
# ---
# plus:            add a constant, wrapping
# minus:           subtract a constant, wrapping
# extend_signed:   sign extend
# extend_unsigned: zero extend
# truncate:        keep the low bits
pub tag Step: u8 {
    plus:            u64;
    minus:           u64;
    extend_signed:   Widths;
    extend_unsigned: Widths;
    truncate:        Widths;
}

# where a value is
# ---
# register: in the register of this DWARF number
# frame:    in memory at this offset from the function's frame base, the
#           canonical frame address
# constant: nowhere, being this constant
# local:    in the webassembly local of this index
# operand:  on the webassembly operand stack, at this depth from the top
pub tag Where: u8 {
    register: u32;
    frame:    i64;
    constant: u64;
    local:    u32;
    operand:  u32;
}

# a location and the steps over what it holds, a run of the steps table
pub rec Located {
    where: Where;
    steps: Run;
}

# a piece of a variable of `bits` bits, the next above the pieces before it,
# and where it is, none for a piece that is nowhere
pub rec Piece {
    bits:    u64;
    located: opt[Located];
}

# where a variable is over a range of code
# ---
# single: whole, in one place
# pieces: in pieces, a run of the pieces table, from its lowest bits up
pub tag Location: u8 {
    single: Located;
    pieces: Run;
}

# a place in a source file
pub rec Position {
    file:   Id[File];
    line:   u32;
    column: u32;
}

# a variable of a function
# ---
# name:      its source name
# type:      its type
# parameter: it is one of the function's parameters
# declared:  where its declaration is
# ranges:    where it is over the function's code, a run of the object's
#            debug ranges, each range one where it is somewhere
pub rec Variable {
    name:      Id[Name];
    type:      Id[Type];
    parameter: bool;
    declared:  Position;
    ranges:    Run;
}

# a call whose callee's code was inlined
# ---
# callee: the symbol name of the function inlined, which names it in every
#         object
# call:   where the call is
# parent: the site the call was itself inlined at, none for a call in the
#         function compiled
pub rec Site {
    callee: Id[Name];
    call:   Position;
    parent: opt[Id[Site]];
}

# the unit the records describe
# ---
# language:  the DWARF code of its source language, none for a unit that
#            states none
# producer:  the name of what produced it
# name:      the name of its primary source file
# directory: the directory it was produced in
pub rec Unit {
    language:  opt[u16];
    producer:  Id[Name];
    name:      Id[Name];
    directory: Id[Name];
}
