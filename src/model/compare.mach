# whether two objects are the same
#
# names are compared by their bytes, as an id depends on the order of
# interning, and byte contents by their bytes. sections, symbols, relocations,
# groups, notes, facts and entries are compared in order, traits by axis.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use mink.catalog.trait;
use mink.catalog.trait.Trait;
use mink.intern.Name;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Definition;
use mink.model.object.Object;
use mink.store;
use mink.store.Bytes;
use mink.table;
use mink.table.Id;

fun same_name(a: *Object, x: Id[Name], b: *Object, y: Id[Name]) bool {
    val p: View = object.name_of(a, x);
    val q: View = object.name_of(b, y);
    if (p.len != q.len) { ret false; }
    var i: usize = 0;
    for (i < p.len) {
        if (p.data[i] != q.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_optional_name(a: *Object, x: opt[Id[Name]], b: *Object, y: opt[Id[Name]]) bool {
    if (sel x.some) {
        if (sel y.some) { ret same_name(a, x.some, b, y.some); }
        ret false;
    }
    ret sel y.none;
}

fun same_contents(a: *Object, x: *Contents, b: *Object, y: *Contents) bool {
    if (sel x.zero) {
        if (sel y.zero) { ret y.zero == x.zero; }
        ret false;
    }
    if (sel y.zero) { ret false; }
    val p: Bytes = object.bytes(a, x);
    val q: Bytes = object.bytes(b, y);
    if (p.len != q.len) { ret false; }
    var i: usize = 0;
    for (i < p.len) {
        if (p.data[i] != q.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_def(x: Definition, y: Definition) bool {
    if (sel x.undefined) { ret sel y.undefined; }
    if (sel x.absolute) {
        if (sel y.absolute) { ret y.absolute == x.absolute; }
        ret false;
    }
    if (sel x.common) {
        if (sel y.common) { ret y.common.size == x.common.size && y.common.align == x.common.align; }
        ret false;
    }
    if (sel x.placed) {
        if (sel y.placed) { ret y.placed.section.index == x.placed.section.index && y.placed.offset == x.placed.offset; }
        ret false;
    }
    if (sel x.entry) {
        if (sel y.entry) { ret y.entry.index == x.entry.index; }
        ret false;
    }
    ret false;
}

fun same_u32(x: opt[u32], y: opt[u32]) bool {
    if (sel x.some) {
        if (sel y.some) { ret x.some == y.some; }
        ret false;
    }
    ret sel y.none;
}

fun same_u64(x: opt[u64], y: opt[u64]) bool {
    if (sel x.some) {
        if (sel y.some) { ret x.some == y.some; }
        ret false;
    }
    ret sel y.none;
}

fun same_target(x: object.Target, y: object.Target) bool {
    if (sel x.symbol) {
        if (sel y.symbol) { ret x.symbol.index == y.symbol.index; }
        ret false;
    }
    if (sel x.entry) {
        if (sel y.entry) { ret x.entry.index == y.entry.index; }
        ret false;
    }
    ret sel y.none;
}

fun section_index(x: opt[Id[object.Section]]) opt[u32] {
    if (sel x.some) { ret opt[u32].some{x.some.index}; }
    ret opt[u32].none{};
}

fun group_index(x: opt[Id[object.Group]]) opt[u32] {
    if (sel x.some) { ret opt[u32].some{x.some.index}; }
    ret opt[u32].none{};
}

fun symbol_index(x: opt[Id[object.Symbol]]) opt[u32] {
    if (sel x.some) { ret opt[u32].some{x.some.index}; }
    ret opt[u32].none{};
}

fun same_version(a: *Object, x: opt[object.Version], b: *Object, y: opt[object.Version]) bool {
    if (sel x.some) {
        if (sel y.some) { ret x.some.default == y.some.default && same_name(a, x.some.name, b, y.some.name); }
        ret false;
    }
    ret sel y.none;
}

fun same_setting(a: *Object, x: trait.Setting, b: *Object, y: trait.Setting) bool {
    if (sel x.text) {
        if (sel y.text) { ret trait.same_bytes(store.bytes(?a.store, ?x.text), store.bytes(?b.store, ?y.text)); }
        ret false;
    }
    ret trait.same(x, y);
}

fun same_import(a: *Object, x: opt[object.Import], b: *Object, y: opt[object.Import]) bool {
    if (sel x.some) {
        if (sel y.some) { ret same_name(a, x.some.module, b, y.some.module) && same_name(a, x.some.field, b, y.some.field); }
        ret false;
    }
    ret sel y.none;
}

fun same_body(x: opt[object.Place], y: opt[object.Place]) bool {
    if (sel x.some) {
        if (sel y.some) { ret x.some.section.index == y.some.section.index && x.some.offset == y.some.offset; }
        ret false;
    }
    ret sel y.none;
}

fun entry_index(x: opt[Id[object.Entry]]) opt[u32] {
    if (sel x.some) { ret opt[u32].some{x.some.index}; }
    ret opt[u32].none{};
}

fun same_library(a: *Object, x: opt[object.Library], b: *Object, y: opt[object.Library]) bool {
    if (sel x.some) {
        if (sel y.some) { ret same_optional_name(a, x.some.loader, b, y.some.loader); }
        ret false;
    }
    ret sel y.none;
}

fun differs_in_sections(a: *Object, b: *Object) str {
    var i: usize = 0;
    for (i < table.count[object.Section](?a.sections)) {
        val x: *object.Section = object.section_at(a, table.nth[object.Section](i));
        val y: *object.Section = object.section_at(b, table.nth[object.Section](i));
        i = i + 1;
        if (!same_optional_name(a, x.name, b, y.name))                 { ret "section name"; }
        if (x.kind != y.kind || x.flags != y.flags)                    { ret "section kind or flags"; }
        if (x.align != y.align || x.entsize != y.entsize)              { ret "section alignment or entry size"; }
        if (x.disposition != y.disposition)                            { ret "section disposition"; }
        if (!same_contents(a, ?x.contents, b, ?y.contents))            { ret "section contents"; }
        if (!same_u32(section_index(x.owner), section_index(y.owner))) { ret "section owner"; }
        if (!same_u32(group_index(x.group), group_index(y.group)))     { ret "section group"; }
    }
    ret nil;
}

fun differs_in_symbols(a: *Object, b: *Object) str {
    var i: usize = 0;
    for (i < table.count[object.Symbol](?a.symbols)) {
        val x: *object.Symbol = object.symbol_at(a, table.nth[object.Symbol](i));
        val y: *object.Symbol = object.symbol_at(b, table.nth[object.Symbol](i));
        i = i + 1;
        if (!same_name(a, x.name, b, y.name))                       { ret "symbol name"; }
        if (x.binding != y.binding || x.visibility != y.visibility) { ret "symbol binding or visibility"; }
        if (x.kind != y.kind)                                       { ret "symbol kind"; }
        if (!same_def(x.def, y.def))                                { ret "symbol definition"; }
        if (!same_u64(x.size, y.size))                              { ret "symbol size"; }
        if (!same_version(a, x.version, b, y.version))              { ret "symbol version"; }
    }
    ret nil;
}

fun differs_in_relocs(a: *Object, b: *Object) str {
    var i: usize = 0;
    for (i < table.count[object.Reloc](?a.relocs)) {
        val x: *object.Reloc = table.at[object.Reloc](?a.relocs, table.nth[object.Reloc](i));
        val y: *object.Reloc = table.at[object.Reloc](?b.relocs, table.nth[object.Reloc](i));
        i = i + 1;
        if (x.section.index != y.section.index || x.offset != y.offset || x.kind != y.kind || x.addend != y.addend) { ret "relocation"; }
        if (!same_target(x.target, y.target))                                                                       { ret "relocation target"; }
        if (!same_u32(symbol_index(x.minus), symbol_index(y.minus)))                                                { ret "relocation subtrahend"; }
    }
    ret nil;
}

fun differs_in_the_rest(a: *Object, b: *Object) str {
    var i: usize = 0;
    for (i < table.count[object.Group](?a.groups)) {
        val x: *object.Group = object.group_at(a, table.nth[object.Group](i));
        val y: *object.Group = object.group_at(b, table.nth[object.Group](i));
        i = i + 1;
        if (!same_name(a, x.signature, b, y.signature) || x.rule != y.rule) { ret "group"; }
        if (!same_u32(section_index(x.leader), section_index(y.leader)))    { ret "group leader"; }
    }
    i = 0;
    for (i < table.count[object.Note](?a.notes)) {
        val x: *object.Note = table.at[object.Note](?a.notes, table.nth[object.Note](i));
        val y: *object.Note = table.at[object.Note](?b.notes, table.nth[object.Note](i));
        i = i + 1;
        if (!same_name(a, x.owner, b, y.owner) || x.kind != y.kind) { ret "note"; }
        if (!same_contents(a, ?x.desc, b, ?y.desc))                 { ret "note descriptor"; }
    }
    i = 0;
    for (i < table.count[object.Fact](?a.facts)) {
        val x: *object.Fact = table.at[object.Fact](?a.facts, table.nth[object.Fact](i));
        val y: *object.Fact = table.at[object.Fact](?b.facts, table.nth[object.Fact](i));
        i = i + 1;
        if (x.format != y.format || x.key != y.key || x.value != y.value) { ret "fact"; }
        if (!same_contents(a, ?x.data, b, ?y.data))                       { ret "fact data"; }
    }
    i = 0;
    for (i < table.count[object.Entry](?a.entries)) {
        val x: *object.Entry = table.at[object.Entry](?a.entries, table.nth[object.Entry](i));
        val y: *object.Entry = table.at[object.Entry](?b.entries, table.nth[object.Entry](i));
        i = i + 1;
        if (x.space != y.space || !same_optional_name(a, x.name, b, y.name))      { ret "entry"; }
        if (!same_import(a, x.import, b, y.import) || !same_body(x.body, y.body)) { ret "entry origin"; }
        if (!same_u32(entry_index(x.signature), entry_index(y.signature)))        { ret "entry signature"; }
    }
    i = 0;
    for (i < table.count[Trait](?a.traits)) {
        val x: *Trait = table.at[Trait](?a.traits, table.nth[Trait](i));
        val y: *Trait = table.at[Trait](?b.traits, table.nth[Trait](i));
        i = i + 1;
        if (x.axis != y.axis || !same_setting(a, x.setting, b, y.setting)) { ret "trait"; }
    }
    if (!same_library(a, a.library, b, b.library)) { ret "library"; }
    ret nil;
}

# what differs between two objects, nothing when they are the same
pub fun difference(a: *Object, b: *Object) str {
    if (a.arch != b.arch)                                                                     { ret "architecture"; }
    if (table.count[object.Section](?a.sections) != table.count[object.Section](?b.sections)) { ret "section count"; }
    if (table.count[object.Symbol](?a.symbols) != table.count[object.Symbol](?b.symbols))     { ret "symbol count"; }
    if (table.count[object.Reloc](?a.relocs) != table.count[object.Reloc](?b.relocs))         { ret "relocation count"; }
    if (table.count[object.Group](?a.groups) != table.count[object.Group](?b.groups))         { ret "group count"; }
    if (table.count[object.Note](?a.notes) != table.count[object.Note](?b.notes))             { ret "note count"; }
    if (table.count[object.Fact](?a.facts) != table.count[object.Fact](?b.facts))             { ret "fact count"; }
    if (table.count[object.Entry](?a.entries) != table.count[object.Entry](?b.entries))       { ret "entry count"; }
    if (table.count[Trait](?a.traits) != table.count[Trait](?b.traits))                       { ret "trait count"; }
    val s: str = differs_in_sections(a, b);
    if (s != nil) { ret s; }
    val y: str = differs_in_symbols(a, b);
    if (y != nil) { ret y; }
    val r: str = differs_in_relocs(a, b);
    if (r != nil) { ret r; }
    ret differs_in_the_rest(a, b);
}
