# whether two objects are the same
#
# names are compared by their bytes, as an id depends on the order of
# interning, and byte contents by their bytes.
#
# an order carries meaning only where something depends on it, and only that
# order is compared. sections are compared in order, as input order decides
# output order and a section's identity is its place in that order, so a
# symbol's or relocation's section is compared by index. relocations are
# compared in order within each section, as a pair such as a RISC-V HI20 and
# its LO12 depends on it, while the order of sections' relocations among each
# other carries nothing. groups, notes, facts and entries are compared in
# order, traits by axis, and libraries, directives, frames and constant-time
# ranges in order.
#
# a section that states no name is named by its format from its kind when it
# is written, so the name it reads back with is not one it stated. a section
# is compared by its kind and its place in section order, and by its name only
# when both sides state one.
#
# symbol order carries nothing: a format orders its table by its own rules, as
# ELF puts locals first. symbols are compared as a multiset of whole symbols,
# and a relocation's target by the identity of the symbol it names, its name,
# binding, visibility, kind and definition, never by its index. two symbols
# alike in all of these are the same symbol, as two local labels of one name
# at one place are, and are told apart from others by their definition.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.catalog.arch.x86;
use mink.catalog.os.Version;
use mink.catalog.trait;
use mink.catalog.trait.Trait;
use mink.model.frame;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Definition;
use mink.model.object.Object;
use mink.model.reloc;
use mink.model.section;
use mink.model.symbol;
use mink.model.target.Target;

# a symbol and the object that holds it, for an order over symbols of
# different objects
rec Ref {
    o: *Object;
    s: *object.Symbol;
}

# the symbols of one object in symbol order, and its relocations in section
# order, each section's in their own order
# ---
# refs:   the symbols, sorted by symbol_order
# relocs: the relocation indexes, section after section
# starts: per section, where its relocations start in relocs, then the end
rec Side {
    refs:   Table[Ref];
    relocs: Table[u32];
    starts: Table[u32];
}

fun same_name(a: *Object, x: Id[Name], b: *Object, y: Id[Name]) bool {
    val p: View = object.name_of(a, x);
    val q: View = object.name_of(b, y);
    if (p.len != q.len) { ret false; }
    var i: usize = 0;
    for (i < p.len) {
        if (p.data[i] != q.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_optional_name(a: *Object, x: opt[Id[Name]], b: *Object, y: opt[Id[Name]]) bool {
    if (sel x.some) {
        if (sel y.some) { ret same_name(a, x.some, b, y.some); }
        ret false;
    }
    ret sel y.none;
}

# whether two section names agree, which they do unless both are stated and
# differ
fun stated_names_agree(a: *Object, x: opt[Id[Name]], b: *Object, y: opt[Id[Name]]) bool {
    if (sel x.none) { ret true; }
    if (sel y.none) { ret true; }
    ret same_name(a, x.some, b, y.some);
}

fun same_contents(a: *Object, x: *Contents, b: *Object, y: *Contents) bool {
    if (sel x.zero) {
        if (sel y.zero) { ret y.zero == x.zero; }
        ret false;
    }
    if (sel y.zero) { ret false; }
    val p: Bytes = object.bytes(a, x);
    val q: Bytes = object.bytes(b, y);
    if (p.len != q.len) { ret false; }
    var i: usize = 0;
    for (i < p.len) {
        if (p.data[i] != q.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun order_u64(x: u64, y: u64) i64 {
    if (x < y) { ret -1; }
    if (x > y) { ret 1; }
    ret 0;
}

fun order_bytes(p: View, q: View) i64 {
    var n: usize = p.len;
    if (q.len < n) { n = q.len; }
    var i: usize = 0;
    for (i < n) {
        if (p.data[i] != q.data[i]) { ret order_u64(p.data[i]::u64, q.data[i]::u64); }
        i = i + 1;
    }
    ret order_u64(p.len::u64, q.len::u64);
}

fun order_row(x: ptr, y: ptr) i64 {
    ret order_u64(x:~u64, y:~u64);
}

fun def_rank(d: Definition) u64 {
    if (sel d.undefined) { ret 0; }
    if (sel d.placed)    { ret 1; }
    if (sel d.absolute)  { ret 2; }
    if (sel d.common)    { ret 3; }
    ret 4;
}

fun order_def(x: Definition, y: Definition) i64 {
    val r: i64 = order_u64(def_rank(x), def_rank(y));
    if (r != 0) { ret r; }
    if (sel x.placed) {
        if (sel y.placed) {
            val s: i64 = order_u64(x.placed.section.index::u64, y.placed.section.index::u64);
            if (s != 0) { ret s; }
            ret order_u64(x.placed.offset, y.placed.offset);
        }
    }
    if (sel x.absolute) {
        if (sel y.absolute) { ret order_u64(x.absolute, y.absolute); }
    }
    if (sel x.common) {
        if (sel y.common) {
            val s: i64 = order_u64(x.common.size, y.common.size);
            if (s != 0) { ret s; }
            ret order_u64(x.common.align, y.common.align);
        }
    }
    if (sel x.entry) {
        if (sel y.entry) { ret order_u64(x.entry.index::u64, y.entry.index::u64); }
    }
    ret 0;
}

# the order over what makes a symbol the symbol it is: its name, binding,
# visibility, kind and definition
fun identity_order(x: *Ref, y: *Ref) i64 {
    var r: i64 = order_bytes(object.name_of(x.o, x.s.name), object.name_of(y.o, y.s.name));
    if (r != 0) { ret r; }
    r = order_row(x.s.binding::ptr, y.s.binding::ptr);
    if (r != 0) { ret r; }
    r = order_row(x.s.visibility::ptr, y.s.visibility::ptr);
    if (r != 0) { ret r; }
    r = order_row(x.s.kind::ptr, y.s.kind::ptr);
    if (r != 0) { ret r; }
    ret order_def(x.s.def, y.s.def);
}

fun order_size(x: opt[u64], y: opt[u64]) i64 {
    if (sel x.some) {
        if (sel y.some) { ret order_u64(x.some, y.some); }
        ret 1;
    }
    if (sel y.some) { ret -1; }
    ret 0;
}

fun order_version(a: *Object, x: opt[object.Version], b: *Object, y: opt[object.Version]) i64 {
    if (sel x.some) {
        if (sel y.some) {
            val r: i64 = order_u64(x.some.default::u64, y.some.default::u64);
            if (r != 0) { ret r; }
            ret order_bytes(object.name_of(a, x.some.name), object.name_of(b, y.some.name));
        }
        ret 1;
    }
    if (sel y.some) { ret -1; }
    ret 0;
}

# the order over whole symbols: identity, then size and version, then
# retention and whether it is an alternate entry
fun symbol_order(x: *Ref, y: *Ref) i64 {
    var r: i64 = identity_order(x, y);
    if (r != 0) { ret r; }
    r = order_size(x.s.size, y.s.size);
    if (r != 0) { ret r; }
    r = order_version(x.o, x.s.version, y.o, y.s.version);
    if (r != 0) { ret r; }
    r = order_u64(x.s.retain::u64, y.s.retain::u64);
    if (r != 0) { ret r; }
    ret order_u64(x.s.alt_entry::u64, y.s.alt_entry::u64);
}

fun same_symbol(a: *Object, x: Id[object.Symbol], b: *Object, y: Id[object.Symbol]) bool {
    var p: Ref = Ref{o: a, s: object.symbol_at(a, x)};
    var q: Ref = Ref{o: b, s: object.symbol_at(b, y)};
    ret identity_order(?p, ?q) == 0;
}

fun same_target(a: *Object, x: object.Target, b: *Object, y: object.Target) bool {
    if (sel x.symbol) {
        if (sel y.symbol) { ret same_symbol(a, x.symbol, b, y.symbol); }
        ret false;
    }
    if (sel x.entry) {
        if (sel y.entry) { ret x.entry.index == y.entry.index; }
        ret false;
    }
    ret sel y.none;
}

fun same_minus(a: *Object, x: opt[Id[object.Symbol]], b: *Object, y: opt[Id[object.Symbol]]) bool {
    if (sel x.some) {
        if (sel y.some) { ret same_symbol(a, x.some, b, y.some); }
        ret false;
    }
    ret sel y.none;
}

fun same_u32(x: opt[u32], y: opt[u32]) bool {
    if (sel x.some) {
        if (sel y.some) { ret x.some == y.some; }
        ret false;
    }
    ret sel y.none;
}

fun section_index(x: opt[Id[object.Section]]) opt[u32] {
    if (sel x.some) { ret opt[u32].some{x.some.index}; }
    ret opt[u32].none{};
}

fun group_index(x: opt[Id[object.Group]]) opt[u32] {
    if (sel x.some) { ret opt[u32].some{x.some.index}; }
    ret opt[u32].none{};
}

# whether the setting `x` of `a` and `y` of `b` are the same value, what lies
# in bytes by its bytes
pub fun same_setting(a: *Object, x: trait.Setting, b: *Object, y: trait.Setting) bool {
    if (sel x.text) {
        if (sel y.text) { ret store.same_bytes(store.bytes(?a.store, ?x.text), store.bytes(?b.store, ?y.text)); }
        ret false;
    }
    or (sel x.set) {
        if (sel y.set) { ret store.same_bytes(store.bytes(?a.store, ?x.set), store.bytes(?b.store, ?y.set)); }
        ret false;
    }
    or (sel x.pair) {
        if (sel y.pair) { ret x.pair.number == y.pair.number && store.same_bytes(store.bytes(?a.store, ?x.pair.text), store.bytes(?b.store, ?y.pair.text)); }
        ret false;
    }
    ret trait.same(x, y);
}

fun same_import(a: *Object, x: opt[object.Import], b: *Object, y: opt[object.Import]) bool {
    if (sel x.some) {
        if (sel y.some) {
            if (!same_name(a, x.some.module, b, y.some.module) || !same_name(a, x.some.field, b, y.some.field)) { ret false; }
            ret same_u32(library_index(x.some.library), library_index(y.some.library)) && same_u16(x.some.ordinal, y.some.ordinal);
        }
        ret false;
    }
    ret sel y.none;
}

fun library_index(x: opt[Id[object.Library]]) opt[u32] {
    if (sel x.some) { ret opt[u32].some{x.some.index}; }
    ret opt[u32].none{};
}

fun same_u16(x: opt[u16], y: opt[u16]) bool {
    if (sel x.some) {
        if (sel y.some) { ret x.some == y.some; }
        ret false;
    }
    ret sel y.none;
}

fun same_version(x: opt[Version], y: opt[Version]) bool {
    if (sel x.some) {
        if (sel y.some) { ret x.some.major == y.some.major && x.some.minor == y.some.minor && x.some.patch == y.some.patch; }
        ret false;
    }
    ret sel y.none;
}

# whether two objects are for the same target
fun same_target_of(x: *Target, y: *Target) bool {
    if (x.arch != y.arch)                           { ret false; }
    if ((sel x.system.none) != (sel y.system.none)) { ret false; }
    if (sel x.system.some) {
        if (sel y.system.some) {
            if (x.system.some != y.system.some) { ret false; }
        }
    }
    if ((sel x.env.none) != (sel y.env.none)) { ret false; }
    if (sel x.env.some) {
        if (sel y.env.some) {
            if (x.env.some != y.env.some) { ret false; }
        }
    }
    ret same_version(x.version, y.version) && same_version(x.sdk, y.sdk);
}

fun same_body(x: opt[object.Place], y: opt[object.Place]) bool {
    if (sel x.some) {
        if (sel y.some) { ret x.some.section.index == y.some.section.index && x.some.offset == y.some.offset; }
        ret false;
    }
    ret sel y.none;
}

fun entry_index(x: opt[Id[object.Entry]]) opt[u32] {
    if (sel x.some) { ret opt[u32].some{x.some.index}; }
    ret opt[u32].none{};
}

fun same_library(a: *Object, x: opt[object.Library], b: *Object, y: opt[object.Library]) bool {
    if (sel x.some) {
        if (sel y.some) { ret same_library_row(a, ?x.some, b, ?y.some); }
        ret false;
    }
    ret sel y.none;
}

fun same_library_row(a: *Object, x: *object.Library, b: *Object, y: *object.Library) bool {
    if (!same_optional_name(a, x.loader, b, y.loader))  { ret false; }
    if (x.reexports != y.reexports || x.weak != y.weak) { ret false; }
    if ((sel x.versions.none) != (sel y.versions.none)) { ret false; }
    if (sel x.versions.some) {
        if (sel y.versions.some) {
            ret x.versions.some.current == y.versions.some.current && x.versions.some.compat == y.versions.some.compat;
        }
    }
    ret true;
}

fun same_optional_symbol(a: *Object, x: opt[Id[object.Symbol]], b: *Object, y: opt[Id[object.Symbol]]) bool {
    ret same_minus(a, x, b, y);
}

fun same_offset(x: frame.Offset, y: frame.Offset) bool {
    ret x.reg == y.reg && x.offset == y.offset;
}

# whether the rule `x` of `a` and `y` of `b` are the same, an expression by
# its bytes
fun same_rule(a: *Object, x: *frame.Rule, b: *Object, y: *frame.Rule) bool {
    if (sel x.def_cfa) {
        if (sel y.def_cfa) { ret same_offset(x.def_cfa, y.def_cfa); }
        ret false;
    }
    or (sel x.cfa_offset) {
        if (sel y.cfa_offset) { ret x.cfa_offset == y.cfa_offset; }
        ret false;
    }
    or (sel x.cfa_register) {
        if (sel y.cfa_register) { ret x.cfa_register == y.cfa_register; }
        ret false;
    }
    or (sel x.offset) {
        if (sel y.offset) { ret same_offset(x.offset, y.offset); }
        ret false;
    }
    or (sel x.val_offset) {
        if (sel y.val_offset) { ret same_offset(x.val_offset, y.val_offset); }
        ret false;
    }
    or (sel x.register) {
        if (sel y.register) { ret x.register.reg == y.register.reg && x.register.from == y.register.from; }
        ret false;
    }
    or (sel x.same) {
        if (sel y.same) { ret x.same == y.same; }
        ret false;
    }
    or (sel x.undefined) {
        if (sel y.undefined) { ret x.undefined == y.undefined; }
        ret false;
    }
    or (sel x.remember) {
        ret sel y.remember;
    }
    or (sel x.restore_state) {
        ret sel y.restore_state;
    }
    or (sel x.restore) {
        if (sel y.restore) { ret x.restore == y.restore; }
        ret false;
    }
    or (sel x.expression) {
        if (sel y.expression) {
            var p: Held = x.expression;
            var q: Held = y.expression;
            ret store.same_bytes(store.bytes(?a.store, ?p), store.bytes(?b.store, ?q));
        }
        ret false;
    }
    or (sel x.scaled) {
        if (sel y.scaled) { ret x.scaled.reg == y.scaled.reg && x.scaled.offset == y.scaled.offset && x.scaled.quantity == y.scaled.quantity; }
        ret false;
    }
    or (sel x.prologue_end) {
        ret sel y.prologue_end;
    }
    if (sel y.epilogue) { ret x.epilogue.begin == y.epilogue.begin && x.epilogue.end == y.epilogue.end; }
    ret false;
}

fun same_rules(a: *Object, x: *Table[frame.Rule], b: *Object, y: *Table[frame.Rule]) bool {
    if (table.count[frame.Rule](x) != table.count[frame.Rule](y)) { ret false; }
    var i: usize = 0;
    for (i < table.count[frame.Rule](x)) {
        if (!same_rule(a, table.at[frame.Rule](x, table.nth[frame.Rule](i)), b, table.at[frame.Rule](y, table.nth[frame.Rule](i)))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_steps(a: *Object, x: *Table[frame.Step], b: *Object, y: *Table[frame.Step]) bool {
    if (table.count[frame.Step](x) != table.count[frame.Step](y)) { ret false; }
    var i: usize = 0;
    for (i < table.count[frame.Step](x)) {
        val p: *frame.Step = table.at[frame.Step](x, table.nth[frame.Step](i));
        val q: *frame.Step = table.at[frame.Step](y, table.nth[frame.Step](i));
        if (p.at != q.at || !same_rule(a, ?p.rule, b, ?q.rule)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_frame(a: *Object, x: *object.Frame, b: *Object, y: *object.Frame) bool {
    if (!same_symbol(a, x.function, b, y.function))                   { ret false; }
    if (x.start != y.start || x.end != y.end || x.signal != y.signal) { ret false; }
    if (x.cie.code_align != y.cie.code_align)                         { ret false; }
    if (x.cie.data_align != y.cie.data_align)                         { ret false; }
    if (!same_rules(a, ?x.cie.initial, b, ?y.cie.initial))            { ret false; }
    if (!same_steps(a, ?x.steps, b, ?y.steps))                        { ret false; }
    if (!same_optional_symbol(a, x.personality, b, y.personality))    { ret false; }
    ret same_optional_symbol(a, x.lsda, b, y.lsda);
}

fun differs_in_sections(a: *Object, b: *Object) str {
    var i: usize = 0;
    for (i < table.count[object.Section](?a.sections)) {
        val x: *object.Section = object.section_at(a, table.nth[object.Section](i));
        val y: *object.Section = object.section_at(b, table.nth[object.Section](i));
        i = i + 1;
        if (!stated_names_agree(a, x.name, b, y.name))                 { ret "section name"; }
        if (x.kind != y.kind || x.flags != y.flags)                    { ret "section kind or flags"; }
        if (x.align != y.align || x.entsize != y.entsize)              { ret "section alignment or entry size"; }
        if (x.disposition != y.disposition)                            { ret "section disposition"; }
        if (!same_contents(a, ?x.contents, b, ?y.contents))            { ret "section contents"; }
        if (!same_u32(section_index(x.owner), section_index(y.owner))) { ret "section owner"; }
        if (!same_u32(group_index(x.group), group_index(y.group)))     { ret "section group"; }
        if (!same_u32(x.priority, y.priority))                         { ret "section priority"; }
    }
    ret nil;
}

fun differs_in_symbols(x: *Side, y: *Side) str {
    var i: usize = 0;
    for (i < table.count[Ref](?x.refs)) {
        val p: *Ref = table.at[Ref](?x.refs, table.nth[Ref](i));
        val q: *Ref = table.at[Ref](?y.refs, table.nth[Ref](i));
        i = i + 1;
        if (identity_order(p, q) != 0)                                  { ret "symbol name, binding, visibility, kind or definition"; }
        if (p.s.retain != q.s.retain || p.s.alt_entry != q.s.alt_entry) { ret "symbol retention or alternate entry"; }
        if (symbol_order(p, q) != 0)                                    { ret "symbol size or version"; }
    }
    ret nil;
}

fun differs_in_relocs(a: *Object, x: *Side, b: *Object, y: *Side) str {
    var i: usize = 0;
    for (i < table.count[u32](?x.relocs)) {
        val p: *object.Reloc = table.at[object.Reloc](?a.relocs, Id[object.Reloc]{index: table.items[u32](?x.relocs)[i]});
        val q: *object.Reloc = table.at[object.Reloc](?b.relocs, Id[object.Reloc]{index: table.items[u32](?y.relocs)[i]});
        i = i + 1;
        if (p.section.index != q.section.index || p.offset != q.offset || p.kind != q.kind || p.addend != q.addend) { ret "relocation"; }
        if (!same_target(a, p.target, b, q.target))                                                                 { ret "relocation target"; }
        if (!same_minus(a, p.minus, b, q.minus))                                                                    { ret "relocation subtrahend"; }
    }
    ret nil;
}

fun differs_in_the_rest(a: *Object, b: *Object) str {
    var i: usize = 0;
    for (i < table.count[object.Group](?a.groups)) {
        val x: *object.Group = object.group_at(a, table.nth[object.Group](i));
        val y: *object.Group = object.group_at(b, table.nth[object.Group](i));
        i = i + 1;
        if (!same_name(a, x.signature, b, y.signature) || x.rule != y.rule) { ret "group"; }
        if (!same_u32(section_index(x.leader), section_index(y.leader)))    { ret "group leader"; }
    }
    i = 0;
    for (i < table.count[object.Note](?a.notes)) {
        val x: *object.Note = table.at[object.Note](?a.notes, table.nth[object.Note](i));
        val y: *object.Note = table.at[object.Note](?b.notes, table.nth[object.Note](i));
        i = i + 1;
        if (!same_name(a, x.owner, b, y.owner) || x.kind != y.kind) { ret "note"; }
        if (!same_contents(a, ?x.desc, b, ?y.desc))                 { ret "note descriptor"; }
    }
    i = 0;
    for (i < table.count[object.Fact](?a.facts)) {
        val x: *object.Fact = table.at[object.Fact](?a.facts, table.nth[object.Fact](i));
        val y: *object.Fact = table.at[object.Fact](?b.facts, table.nth[object.Fact](i));
        i = i + 1;
        if (x.format != y.format || x.key != y.key || x.value != y.value) { ret "fact"; }
        if (!same_contents(a, ?x.data, b, ?y.data))                       { ret "fact data"; }
    }
    i = 0;
    for (i < table.count[object.Entry](?a.entries)) {
        val x: *object.Entry = table.at[object.Entry](?a.entries, table.nth[object.Entry](i));
        val y: *object.Entry = table.at[object.Entry](?b.entries, table.nth[object.Entry](i));
        i = i + 1;
        if (x.space != y.space || !same_optional_name(a, x.name, b, y.name))      { ret "entry"; }
        if (!same_import(a, x.import, b, y.import) || !same_body(x.body, y.body)) { ret "entry origin"; }
        if (!same_u32(entry_index(x.signature), entry_index(y.signature)))        { ret "entry signature"; }
    }
    i = 0;
    for (i < table.count[Trait](?a.traits)) {
        val x: *Trait = table.at[Trait](?a.traits, table.nth[Trait](i));
        val y: *Trait = table.at[Trait](?b.traits, table.nth[Trait](i));
        i = i + 1;
        if (x.axis != y.axis || !same_setting(a, x.setting, b, y.setting)) { ret "trait"; }
    }
    if (!same_library(a, a.library, b, b.library)) { ret "library"; }
    i = 0;
    for (i < table.count[object.Library](?a.libraries)) {
        val x: *object.Library = table.at[object.Library](?a.libraries, table.nth[object.Library](i));
        val y: *object.Library = table.at[object.Library](?b.libraries, table.nth[object.Library](i));
        i = i + 1;
        if (!same_library_row(a, x, b, y)) { ret "linked library"; }
    }
    i = 0;
    for (i < table.count[object.Directive](?a.directives)) {
        val x: *object.Directive = table.at[object.Directive](?a.directives, table.nth[object.Directive](i));
        val y: *object.Directive = table.at[object.Directive](?b.directives, table.nth[object.Directive](i));
        i = i + 1;
        if (x.kind != y.kind || !same_name(a, x.text, b, y.text)) { ret "directive"; }
        if (!same_optional_name(a, x.symbol, b, y.symbol))        { ret "directive symbol"; }
    }
    i = 0;
    for (i < table.count[object.Frame](?a.frames)) {
        val x: *object.Frame = table.at[object.Frame](?a.frames, table.nth[object.Frame](i));
        val y: *object.Frame = table.at[object.Frame](?b.frames, table.nth[object.Frame](i));
        i = i + 1;
        if (!same_frame(a, x, b, y)) { ret "frame"; }
    }
    i = 0;
    for (i < table.count[object.CtRange](?a.ct)) {
        val x: *object.CtRange = table.at[object.CtRange](?a.ct, table.nth[object.CtRange](i));
        val y: *object.CtRange = table.at[object.CtRange](?b.ct, table.nth[object.CtRange](i));
        i = i + 1;
        if (x.section.index != y.section.index || x.start != y.start || x.end != y.end) { ret "constant-time range"; }
    }
    ret nil;
}

fun make_side(al: *A.Allocator) Side {
    ret Side{refs: table.make[Ref](al), relocs: table.make[u32](al), starts: table.make[u32](al)};
}

fun release_side(x: *Side) err[Fail] {
    val r: err[Fail] = table.release[Ref](?x.refs);
    val s: err[Fail] = table.release[u32](?x.relocs);
    val t: err[Fail] = table.release[u32](?x.starts);
    if (sel r.err) { ret r; }
    if (sel s.err) { ret s; }
    ret t;
}

fun symbol_in_range(o: *Object, x: Id[object.Symbol]) bool {
    ret x.index::usize < table.count[object.Symbol](?o.symbols);
}

# fill `x` from `o`: its symbols sorted, and its relocations bucketed by
# section in their own order, every reference they make checked
fun sides_of(o: *Object, x: *Side) err[Fail] {
    val ns: usize              = table.count[object.Symbol](?o.symbols);
    val gr: res[Id[Ref], Fail] = table.grow[Ref](?x.refs, ns);
    if (sel gr.err) { ret err[Fail].err{gr.err}; }
    var k: usize = 0;
    for (k < ns) {
        table.items[Ref](?x.refs)[k] = Ref{o: o, s: object.symbol_at(o, table.nth[object.Symbol](k))};
        k                            = k + 1;
    }
    sort.sort_by[Ref](table.items[Ref](?x.refs), ns, symbol_order);
    val nsec: usize              = table.count[object.Section](?o.sections);
    val nr:   usize              = table.count[object.Reloc](?o.relocs);
    val gs:   res[Id[u32], Fail] = table.grow[u32](?x.starts, nsec + 1);
    if (sel gs.err) { ret err[Fail].err{gs.err}; }
    val go: res[Id[u32], Fail] = table.grow[u32](?x.relocs, nr);
    if (sel go.err) { ret err[Fail].err{go.err}; }
    val starts: *u32  = table.items[u32](?x.starts);
    var i:      usize = 0;
    for (i < nr) {
        val r:  *object.Reloc = table.at[object.Reloc](?o.relocs, table.nth[object.Reloc](i));
        val tg: object.Target = r.target;
        if (r.section.index::usize >= nsec)                        { ret err[Fail].err{fail.in_indexed(fail.malformed("relocation names a section the object does not have"), "relocation", i::u64)}; }
        if (sel tg.symbol && !symbol_in_range(o, tg.symbol))       { ret err[Fail].err{fail.in_indexed(fail.malformed("relocation names a symbol the object does not have"), "relocation", i::u64)}; }
        if (sel r.minus.some && !symbol_in_range(o, r.minus.some)) { ret err[Fail].err{fail.in_indexed(fail.malformed("relocation subtracts a symbol the object does not have"), "relocation", i::u64)}; }
        starts[r.section.index::usize + 1] = starts[r.section.index::usize + 1] + 1;
        i                                  = i + 1;
    }
    var n: usize = 0;
    for (n < nsec) {
        starts[n + 1] = starts[n + 1] + starts[n];
        n             = n + 1;
    }
    i = 0;
    for (i < nr) {
        val at: usize = table.at[object.Reloc](?o.relocs, table.nth[object.Reloc](i)).section.index::usize;
        table.items[u32](?x.relocs)[starts[at]::usize] = i::u32;
        starts[at]                                     = starts[at] + 1;
        i                                              = i + 1;
    }
    ret err[Fail].ok{};
}

fun differs_in_sides(al: *A.Allocator, a: *Object, b: *Object) res[str, Fail] {
    var x:  Side      = make_side(al);
    var y:  Side      = make_side(al);
    val fx: err[Fail] = sides_of(a, ?x);
    var fy: err[Fail] = err[Fail].ok{};
    if (sel fx.ok) { fy = sides_of(b, ?y); }
    var d: str = nil;
    if (sel fx.ok && sel fy.ok) {
        d = differs_in_symbols(?x, ?y);
        if (d == nil) { d = differs_in_relocs(a, ?x, b, ?y); }
    }
    val rx: err[Fail] = release_side(?x);
    val ry: err[Fail] = release_side(?y);
    if (sel fx.err) { ret res[str, Fail].err{fx.err}; }
    if (sel fy.err) { ret res[str, Fail].err{fy.err}; }
    if (sel rx.err) { ret res[str, Fail].err{rx.err}; }
    if (sel ry.err) { ret res[str, Fail].err{ry.err}; }
    ret res[str, Fail].ok{d};
}

# what differs between two objects, nil when they are the same. it refuses
# an object whose relocations refer past its sections or symbols, and a
# failed allocation
pub fun difference(al: *A.Allocator, a: *Object, b: *Object) res[str, Fail] {
    if (a.target.arch != b.target.arch)                                                               { ret res[str, Fail].ok{"architecture"}; }
    if (!same_target_of(?a.target, ?b.target))                                                        { ret res[str, Fail].ok{"target"}; }
    if (table.count[object.Section](?a.sections) != table.count[object.Section](?b.sections))         { ret res[str, Fail].ok{"section count"}; }
    if (table.count[object.Symbol](?a.symbols) != table.count[object.Symbol](?b.symbols))             { ret res[str, Fail].ok{"symbol count"}; }
    if (table.count[object.Reloc](?a.relocs) != table.count[object.Reloc](?b.relocs))                 { ret res[str, Fail].ok{"relocation count"}; }
    if (table.count[object.Group](?a.groups) != table.count[object.Group](?b.groups))                 { ret res[str, Fail].ok{"group count"}; }
    if (table.count[object.Note](?a.notes) != table.count[object.Note](?b.notes))                     { ret res[str, Fail].ok{"note count"}; }
    if (table.count[object.Fact](?a.facts) != table.count[object.Fact](?b.facts))                     { ret res[str, Fail].ok{"fact count"}; }
    if (table.count[object.Entry](?a.entries) != table.count[object.Entry](?b.entries))               { ret res[str, Fail].ok{"entry count"}; }
    if (table.count[Trait](?a.traits) != table.count[Trait](?b.traits))                               { ret res[str, Fail].ok{"trait count"}; }
    if (table.count[object.Library](?a.libraries) != table.count[object.Library](?b.libraries))       { ret res[str, Fail].ok{"linked library count"}; }
    if (table.count[object.Directive](?a.directives) != table.count[object.Directive](?b.directives)) { ret res[str, Fail].ok{"directive count"}; }
    if (table.count[object.Frame](?a.frames) != table.count[object.Frame](?b.frames))                 { ret res[str, Fail].ok{"frame count"}; }
    if (table.count[object.CtRange](?a.ct) != table.count[object.CtRange](?b.ct))                     { ret res[str, Fail].ok{"constant-time range count"}; }
    val s: str = differs_in_sections(a, b);
    if (s != nil) { ret res[str, Fail].ok{s}; }
    val d: res[str, Fail] = differs_in_sides(al, a, b);
    if (sel d.err)   { ret d; }
    if (d.ok != nil) { ret d; }
    ret res[str, Fail].ok{differs_in_the_rest(a, b)};
}

# an object with one text section
fun blank(al: *A.Allocator) res[Object, Fail] {
    var o:  Object              = object.make(al, ?x86.X86_64);
    val nm: res[Id[Name], Fail] = object.name_str(?o, ".text");
    if (sel nm.err) { ret res[Object, Fail].err{nm.err}; }
    val s: res[Id[object.Section], Fail] = object.add_section(?o, object.Section{name: opt[Id[Name]].some{nm.ok}, kind: ?section.TEXT, flags: section.TEXT.flags, align: 16, contents: Contents.zero{16}});
    if (sel s.err) { ret res[Object, Fail].err{s.err}; }
    ret res[Object, Fail].ok{o};
}

# a symbol named `name` of binding `b` at `at` in the text section
fun put(o: *Object, name: str, b: *symbol.Binding, at: u64) res[Id[object.Symbol], Fail] {
    val nm: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel nm.err) { ret res[Id[object.Symbol], Fail].err{nm.err}; }
    ret object.add_symbol(o, object.Symbol{
        name:       nm.ok,
        binding:    b,
        visibility: ?symbol.DEFAULT,
        kind:       ?symbol.NOTYPE,
        def:        Definition.placed{object.Place{section: table.nth[object.Section](0), offset: at}},
    });
}

fun refer(o: *Object, to: Id[object.Symbol]) err[Fail] {
    val r: res[Id[object.Reloc], Fail] = object.add_reloc(o, object.Reloc{section: table.nth[object.Section](0), offset: 8, kind: ?reloc.ABS64, target: object.Target.symbol{to}});
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

test compare__same_named_locals_are_told_apart_by_definition {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val al: *A.Allocator      = T.allocator_of(?t);
    val ga: res[Object, Fail] = blank(al);
    val gb: res[Object, Fail] = blank(al);
    val gc: res[Object, Fail] = blank(al);
    if (sel ga.err) { ret 1; }
    if (sel gb.err) { ret 1; }
    if (sel gc.err) { ret 1; }
    var a:  Object                       = ga.ok;
    var b:  Object                       = gb.ok;
    var c:  Object                       = gc.ok;
    val a1: res[Id[object.Symbol], Fail] = put(?a, ".L", ?symbol.LOCAL, 0);
    val a2: res[Id[object.Symbol], Fail] = put(?a, ".L", ?symbol.LOCAL, 4);
    val b1: res[Id[object.Symbol], Fail] = put(?b, ".L", ?symbol.LOCAL, 4);
    val b2: res[Id[object.Symbol], Fail] = put(?b, ".L", ?symbol.LOCAL, 0);
    val c1: res[Id[object.Symbol], Fail] = put(?c, ".L", ?symbol.LOCAL, 0);
    val c2: res[Id[object.Symbol], Fail] = put(?c, ".L", ?symbol.LOCAL, 0);
    if (sel a1.err) { ret 1; }
    if (sel a2.err) { ret 1; }
    if (sel b1.err) { ret 1; }
    if (sel b2.err) { ret 1; }
    if (sel c1.err) { ret 1; }
    if (sel c2.err) { ret 1; }

    val same: res[str, Fail] = difference(al, ?a, ?b);
    if (sel same.err)   { ret 2; }
    if (same.ok != nil) { ret 2; }
    val other: res[str, Fail] = difference(al, ?a, ?c);
    if (sel other.err)   { ret 3; }
    if (other.ok == nil) { ret 3; }

    val ra: err[Fail] = object.release(?a);
    val rb: err[Fail] = object.release(?b);
    val rc: err[Fail] = object.release(?c);
    if (sel ra.err)            { ret 1; }
    if (sel rb.err)            { ret 1; }
    if (sel rc.err)            { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test compare__a_relocation_target_is_its_identity_not_its_index {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val al: *A.Allocator      = T.allocator_of(?t);
    val ga: res[Object, Fail] = blank(al);
    val gb: res[Object, Fail] = blank(al);
    val gc: res[Object, Fail] = blank(al);
    if (sel ga.err) { ret 1; }
    if (sel gb.err) { ret 1; }
    if (sel gc.err) { ret 1; }
    var a:  Object                       = ga.ok;
    var b:  Object                       = gb.ok;
    var c:  Object                       = gc.ok;
    val af: res[Id[object.Symbol], Fail] = put(?a, "f", ?symbol.GLOBAL, 0);
    val ag: res[Id[object.Symbol], Fail] = put(?a, "g", ?symbol.GLOBAL, 4);
    val bg: res[Id[object.Symbol], Fail] = put(?b, "g", ?symbol.GLOBAL, 4);
    val bf: res[Id[object.Symbol], Fail] = put(?b, "f", ?symbol.GLOBAL, 0);
    val cg: res[Id[object.Symbol], Fail] = put(?c, "g", ?symbol.GLOBAL, 4);
    val cf: res[Id[object.Symbol], Fail] = put(?c, "f", ?symbol.GLOBAL, 0);
    if (sel af.err) { ret 1; }
    if (sel ag.err) { ret 1; }
    if (sel bg.err) { ret 1; }
    if (sel bf.err) { ret 1; }
    if (sel cg.err) { ret 1; }
    if (sel cf.err) { ret 1; }
    val ra: err[Fail] = refer(?a, ag.ok);
    val rb: err[Fail] = refer(?b, bg.ok);
    val rc: err[Fail] = refer(?c, cf.ok);
    if (sel ra.err) { ret 1; }
    if (sel rb.err) { ret 1; }
    if (sel rc.err) { ret 1; }

    val same: res[str, Fail] = difference(al, ?a, ?b);
    if (sel same.err)   { ret 2; }
    if (same.ok != nil) { ret 2; }
    val other: res[str, Fail] = difference(al, ?a, ?c);
    if (sel other.err)   { ret 3; }
    if (other.ok == nil) { ret 3; }

    val la: err[Fail] = object.release(?a);
    val lb: err[Fail] = object.release(?b);
    val lc: err[Fail] = object.release(?c);
    if (sel la.err)            { ret 1; }
    if (sel lb.err)            { ret 1; }
    if (sel lc.err)            { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
