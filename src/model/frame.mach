# call frame records: how to unwind each function, as rules over its offsets
#
# a producer states a frame per function and mink owns the bytes of every
# format's encoding of it. the return address column is the architecture's,
# never the producer's, and a rule a format cannot encode is refused naming
# the rule.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;

# a register and an offset from it, or from the canonical frame address
pub rec Offset {
    reg:    u16;
    offset: i64;
}

# a register saved at an offset from the canonical frame address, `width`
# bytes of it from its least significant byte up
# ---
# reg:    the register saved
# offset: the offset from the canonical frame address it is saved at
# width:  the bytes saved, NATURAL for the width the architecture's calling
#         convention preserves the register at
pub rec Saved {
    reg:    u16;
    offset: i64;
    width:  u16;
}

# the width of a save that preserves the part of the register the calling
# convention preserves, as an arm64 d8 to d15 save keeps only the low 64 bits
pub val NATURAL: u16 = 0;

# a register saved in another register
pub rec Moved {
    reg:  u16;
    from: u16;
}

# a register and a linear offset, fixed plus scale times the run time value of
# another register, as a vector length scales an SVE or RVV frame. as a
# canonical frame address it is from the register, as a save from the
# canonical frame address
# ---
# reg:      the register the address is from, or the register saved
# fixed:    the bytes of the offset that do not scale
# scale:    the multiple of quantity's value the offset adds, never zero
# quantity: the register whose value scales the offset, vlenb or vg
pub rec Scaled {
    reg:      u16;
    fixed:    i64;
    scale:    i64;
    quantity: u16;
}

# the offsets of an epilogue, from `begin` up to, and not including, `end`
pub rec Span {
    begin: u64;
    end:   u64;
}

# one unwinding rule, as DWARF's call frame instructions state them, plus the
# prologue and epilogue marks other encodings need
pub tag Rule: u8 {
    def_cfa:        Offset;
    def_cfa_scaled: Scaled;
    cfa_offset:     i64;
    cfa_register:   u16;
    offset:         Saved;
    val_offset:     Offset;
    register:       Moved;
    same:           u16;
    undefined:      u16;
    remember;
    restore_state;
    restore:    u16;
    expression: Held;
    scaled:     Scaled;
    prologue_end;
    epilogue: Span;
}

# a rule that takes effect at offset `at` of the function
pub rec Step {
    at:   u64;
    rule: Rule;
}

# a table an object's frames lower to, as an assembler's .cfi_sections names
# one. each format states which it offers and how it writes each
# ---
# name: how .cfi_sections spells it, on every format
# bit:  its member of a set of destinations, one per row
pub rec Destination {
    name: str;
    bit:  u8;
}

# the table a runtime unwinder reads
pub val UNWIND: Destination = Destination{name: ".eh_frame", bit: 0};
# the table only a debugger reads, as DWARF's .debug_frame
pub val DEBUG: Destination = Destination{name: ".debug_frame", bit: 1};

# every destination
pub val DESTINATIONS:      [2]*Destination = [2]*Destination{?UNWIND, ?DEBUG};
pub val DESTINATION_COUNT: usize           = 2;

# a set of destinations, each a member by its row's bit
pub rec Destinations {
    bits: u64;
}

# the set with no destination, as .cfi_sections with none asks for
pub val NOWHERE: Destinations = Destinations{bits: 0};

pub fun has(s: Destinations, d: *Destination) bool {
    ret (s.bits & (1::u64 << d.bit::u64)) != 0;
}

# `s` with `d` a member too
pub fun with(s: Destinations, d: *Destination) Destinations {
    ret Destinations{bits: s.bits | (1::u64 << d.bit::u64)};
}

# the destination .cfi_sections spells `b`, none for none
pub fun named(b: Bytes) opt[*Destination] {
    var i: usize = 0;
    for (i < DESTINATION_COUNT) {
        val d: *Destination = DESTINATIONS[i];
        if (store.same_bytes(Bytes{data: d.name, len: str_len(d.name)}, b)) { ret opt[*Destination].some{d}; }
        i = i + 1;
    }
    ret opt[*Destination].none{};
}
