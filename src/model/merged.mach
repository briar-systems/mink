# the copies of a merged definition
#
# a merged definition is one every object needing it holds a copy of, a link
# keeping one. a copy is a group whose signature is the definition's name, the
# separator and the copy's identity in sixteen lowercase hex digits, and that
# defines the name. the identity names what the definition was made from and
# the settings that change what it computes, so copies of one name and one
# identity share a signature, and a link keeps the first in link order and
# drops the others. copies of one name and different identities are different
# groups that both define the name, a duplicate definition every format
# refuses. on Mach-O, which has no groups, a copy is
# a weak definition starting an atom, and the mink note carries its identity.
#
# an identity has three parts, so a refusal can say which differed: its high
# 32 bits name the source the copy was made from, the next 16 the float
# relaxations it was compiled under and the low 16 the instruction set it may
# use. copies that differ in source were made from different sources. copies
# of one source that differ in the other two were compiled with different
# settings, which change what the code computes or where it runs, so they
# are no more one definition than copies of two sources, and rebuilding both
# with the same settings is the remedy. a producer whose copies hold no such
# setting states zero in its part. a linker of the format reads the signature
# whole and refuses either difference as a duplicate definition.
#
# the identity is not an authentication: an object made by hand that copies a
# real identity onto other code is merged as one of the copies.

use std.memory;
use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

# the byte between a copy's name and its identity, in no name the mach
# compiler mangles
pub val SEPARATOR: u8 = '%';

# the hex digits of an identity
pub val DIGITS: usize = 16;

# the bytes a copy signature holds past its name
pub val EXTRA: usize = 17;

# the identity a group signed `signature` gives the copy of `name` it holds,
# none when the signature is not a copy signature of `name`
pub fun identity_of(signature: View, name: View) opt[u64] {
    if (signature.len != name.len + EXTRA)                                { ret opt[u64].none{}; }
    if (!memory.raw_equal(signature.data::ptr, name.data::ptr, name.len)) { ret opt[u64].none{}; }
    ret digits(signature, name.len);
}

# the name a copy signature `signature` signs for, none for a signature of
# another form
pub fun name_of(signature: View) opt[View] {
    if (signature.len <= EXTRA) { ret opt[View].none{}; }
    val at: usize    = signature.len - EXTRA;
    val id: opt[u64] = digits(signature, at);
    if (sel id.none) { ret opt[View].none{}; }
    ret opt[View].some{View{data: signature.data, len: at}};
}

# the identity spelled from `at` of `signature`: the separator then sixteen
# lowercase hex digits ending it
fun digits(signature: View, at: usize) opt[u64] {
    if (signature.data[at]::u8 != SEPARATOR) { ret opt[u64].none{}; }
    var v: u64   = 0;
    var i: usize = at + 1;
    for (i < signature.len) {
        val c: u8  = signature.data[i]::u8;
        var d: u64 = 0;
        if (c >= '0' && c <= '9') { d = (c - '0')::u64; }
        or (c >= 'a' && c <= 'f') { d = (c - 'a')::u64 + 10; }
        or                        { ret opt[u64].none{}; }
        v = (v << 4) | d;
        i = i + 1;
    }
    ret opt[u64].some{v};
}

# the identity of a copy made from source `source`, compiled under the float
# relaxations `floats` for the instruction set `isa`
pub fun compose(source: u32, floats: u16, isa: u16) u64 {
    ret (source::u64 << 32) | (floats::u64 << 16) | isa::u64;
}

# the source part of an identity
pub fun source_of(identity: u64) u32 {
    ret (identity >> 32)::u32;
}

# the float relaxations part of an identity
pub fun floats_of(identity: u64) u16 {
    ret ((identity >> 16) & 0xffff)::u16;
}

# the instruction set part of an identity
pub fun isa_of(identity: u64) u16 {
    ret (identity & 0xffff)::u16;
}

# why copies of one name with the identities `a` and `b`, which differ, are
# not one definition, and what to do about it
pub fun mismatch(a: u64, b: u64) str {
    if (source_of(a) != source_of(b)) { ret "copies of a merged definition were built from different sources"; }
    val floats: bool = floats_of(a) != floats_of(b);
    val isa:    bool = isa_of(a) != isa_of(b);
    if (floats && isa) { ret "copies of a merged definition were built from the same source with different float relaxations and instruction set extensions: build both with the same ones (mach: `relax` and `ext`)"; }
    if (floats)        { ret "copies of a merged definition were built from the same source with different float relaxations: build both with the same ones (mach: `relax`)"; }
    ret "copies of a merged definition were built from the same source with different instruction set extensions: build both with the same ones (mach: `ext`)";
}

# write the copy signature of `name` for `identity` to `out`, which holds
# `name.len + EXTRA` bytes
pub fun signature(name: View, identity: u64, out: *u8) {
    memory.raw_copy(out::ptr, name.data::ptr, name.len);
    out[name.len] = SEPARATOR;
    var i: usize = 0;
    for (i < DIGITS) {
        val d: u64 = (identity >> ((DIGITS - 1 - i) * 4)::u64) & 0xf;
        var c: u8  = '0' + d::u8;
        if (d >= 10) { c = 'a' + (d - 10)::u8; }
        out[name.len + 1 + i] = c;
        i                     = i + 1;
    }
}
