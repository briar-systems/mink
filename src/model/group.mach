# the rules a group of sections is resolved by
#
# ELF COMDAT groups and every COFF COMDAT selection are rows of one table.
# when several objects define a group of one signature, the rule decides which
# copy is kept and whether the copies must agree.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub def Caps: u64;

# a second definition of the signature is an error
pub val UNIQUE: Caps = 0x1;
# copies must have the same size
pub val SAME_SIZE: Caps = 0x2;
# copies must have the same contents
pub val SAME_CONTENTS: Caps = 0x4;
# the largest copy is kept
pub val LARGEST: Caps = 0x8;
# kept exactly when the section it is associated with is kept
pub val ASSOCIATIVE: Caps = 0x10;

pub rec Rule {
    name: str;
    caps: Caps;
}

pub val ANY:         Rule = Rule{name: "any", caps: 0};
pub val NODUPLICATE: Rule = Rule{name: "noduplicates", caps: UNIQUE};
pub val SAMESIZE:    Rule = Rule{name: "same_size", caps: SAME_SIZE};
pub val EXACT:       Rule = Rule{name: "exact_match", caps: SAME_SIZE | SAME_CONTENTS};
pub val ASSOCIATE:   Rule = Rule{name: "associative", caps: ASSOCIATIVE};
pub val LARGEST_ONE: Rule = Rule{name: "largest", caps: LARGEST};

val ROW_COUNT: usize            = 6;
val ROWS:      [ROW_COUNT]*Rule = [ROW_COUNT]*Rule{?ANY, ?NODUPLICATE, ?SAMESIZE, ?EXACT, ?ASSOCIATE, ?LARGEST_ONE};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Rule {
    ret ROWS[index];
}

pub fun has(r: *Rule, c: Caps) bool {
    ret (r.caps & c) == c;
}

# a rule picks one copy by at most one criterion, and an associative rule
# decides nothing of its own
fun consistent(r: *Rule) bool {
    if (has(r, UNIQUE) && r.caps != UNIQUE)                             { ret false; }
    if (has(r, ASSOCIATIVE) && r.caps != ASSOCIATIVE)                   { ret false; }
    if (has(r, LARGEST) && (r.caps & (SAME_SIZE | SAME_CONTENTS)) != 0) { ret false; }
    if (has(r, SAME_CONTENTS) && !has(r, SAME_SIZE))                    { ret false; }
    ret true;
}

test group__rules_are_unique_and_consistent {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        var j: usize = i + 1;
        for (j < ROW_COUNT) {
            if (str_equals(ROWS[i].name, ROWS[j].name)) { ret 1; }
            if (ROWS[i].caps == ROWS[j].caps)           { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}
