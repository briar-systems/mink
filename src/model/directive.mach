# the kinds of directive an object hands the link
#
# a directive is an instruction an object carries for whoever links it rather
# than bytes of the image: a library to link, a symbol to export, a text to
# report. each format writes them its own way, as ELF's .deplibs and
# .gnu.warning sections, COFF's .drectve and Mach-O's LC_LINKER_OPTION, and
# reads them back into these rows.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.string.str;

use mink.base.intern.Name;
use mink.base.table.Id;

# name: the kind's spelling in a diagnostic
pub rec Kind {
    name: str;
}

# a library to link, by its name
pub val LIBRARY: Kind = Kind{name: "library"};
# a framework to link, by its name
pub val FRAMEWORK: Kind = Kind{name: "framework"};
# a symbol the image exports, about the symbol, its text the name the image
# exports it by, with the attributes `Export` names. it states no format's
# spelling: whether the export is code or data is the kind of the symbol's
# definition, and each format lowers it its own way, as COFF's /EXPORT, or
# as ELF's and Mach-O's default visibility
pub val EXPORT: Kind = Kind{name: "export"};
# a symbol the link keeps as though referenced
pub val INCLUDE: Kind = Kind{name: "include"};
# a symbol another stands in for when it is not defined
pub val ALTERNATE: Kind = Kind{name: "alternate"};
# a text the link reports when its symbol, or the object, is linked
pub val WARNING: Kind = Kind{name: "warning"};
# a linker option in the format's own spelling
pub val OPTION: Kind = Kind{name: "option"};

# what an export directive states past its symbol and the name it exports
# by, shaped against a PE export (PE Format, The .edata Section). a producer
# states none of them, and a format with no form for one refuses it naming
# it
# ---
# ordinal: the ordinal the export takes, none for one the image chooses
# noname:  the export is found by its ordinal alone, naming it nowhere, which
#          only an export stating its ordinal may be
# private: an import library of the image leaves the export out
# forward: the export of another image it forwards to, as `dll.name` or
#          `dll.#ordinal`, an export about no symbol of its own
# data:    a forwarder forwards to data, which an importer reaches only
#          through its import address cell. an export about a symbol states
#          none, as the kind of the symbol's definition says so
pub rec Export {
    ordinal: opt[u16];
    noname:  bool;
    private: bool;
    forward: opt[Id[Name]];
    data:    bool;
}

# the name of the first attribute `e` states, none for an export that
# states only its symbol and name
pub fun attribute(e: *Export) opt[str] {
    if (sel e.forward.some) { ret opt[str].some{"forwarder"}; }
    if (sel e.ordinal.some) { ret opt[str].some{"ordinal"}; }
    if (e.noname)           { ret opt[str].some{"NONAME"}; }
    if (e.private)          { ret opt[str].some{"PRIVATE"}; }
    ret opt[str].none{};
}

# whether `e` states only the symbol and the name
pub fun plain(e: *Export) bool {
    val a: opt[str] = attribute(e);
    ret sel a.none;
}
