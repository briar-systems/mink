# the source line facts of the neutral model
#
# a producer states which source line each stretch of code comes from, as a
# file table and line sequences on the object, and never as DWARF or CodeView
# bytes. each format lowers the same records when it writes an object: DWARF 5
# .debug_line takes the file table as its directory and file tables and each
# sequence as a line program, and CodeView takes each sequence as one
# DEBUG_S_LINES subsection with a block per run of rows in one file and the
# files as DEBUG_S_FILECHKSMS entries. a row is anchored to a place in a
# section, so what moves or drops that code moves or drops the row with it.

use std.types.option.opt;

use mink.intern.Name;
use mink.table.Id;

pub def Flags: u32;

# the row is a recommended place for a breakpoint, a statement boundary. a row
# without it is not one, so a producer states it on the rows it means
pub val STATEMENT: Flags = 0x1;
# the row starts a basic block
pub val BLOCK: Flags = 0x2;
# the row is where a function's prologue ends
pub val PROLOGUE_END: Flags = 0x4;
# the row is where a function's epilogue begins
pub val EPILOGUE_BEGIN: Flags = 0x8;

# an MD5 digest of a source file
pub rec Md5 {
    bytes: [16]u8;
}

# a source file
# ---
# directory: the directory name, absent when the file is named relative to the
#            producer's own directory. a lowering joins it to the name
# name:      the file's name
# md5:       the digest of the file's contents, absent when the producer states
#            none
pub rec File {
    directory: opt[Id[Name]];
    name:      Id[Name];
    md5:       opt[Md5];
}

# a source line fact at a place in a sequence's section
# ---
# at:            the offset within the section of the first byte the row
#                describes, which stays until the next row
# file:          the file the line is in
# line:          the line, zero when the code has no source line
# column:        the column, zero when the producer states none
# flags:         the row's flags
# isa:           the instruction set variant the code is in, zero for the
#                default one
# discriminator: tells apart the blocks of one line, zero when the line has
#                one block
pub rec Row {
    at:            u64;
    file:          Id[File];
    line:          u32;
    column:        u32;
    flags:         Flags;
    isa:           u32;
    discriminator: u32;
}

# where a file sits in the index of the object's file table
pub rec FileKey {
    directory: opt[Id[Name]];
    name:      Id[Name];
    file:      Id[File];
}

fun rank(d: opt[Id[Name]]) u64 {
    if (sel d.some) { ret d.some.index::u64 + 1; }
    ret 0;
}

fun order(a: u64, b: u64) i64 {
    if (a < b) { ret -1; }
    if (a > b) { ret 1; }
    ret 0;
}

# the order the file index is kept in: by directory, then by name
pub fun order_files(a: *FileKey, b: *FileKey) i64 {
    val d: i64 = order(rank(a.directory), rank(b.directory));
    if (d != 0) { ret d; }
    ret order(a.name.index::u64, b.name.index::u64);
}
