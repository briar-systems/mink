# the neutral object, the form the linker works in
#
# every format converts its own model to and from this one, and every
# producer hands mink an object in this form. it is shaped against the union
# of the formats: no field is named after one, and a fact only one format has
# is a format fact keyed by that format. an ABI fact of the architecture is a
# trait, stated as a row of the trait catalog, never as a format's bits. a fact
# an input does not state is absent, never a default.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Store;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.list;
use mink.catalog.arch.riscv;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.isa;
use mink.catalog.isa.Base;
use mink.catalog.merge;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.model.directive;
use mink.model.frame;
use mink.model.group;
use mink.model.group.Rule;
use mink.model.line;
use mink.model.line.File;
use mink.model.line.FileKey;
use mink.model.line.Row;
use mink.model.reloc;
use mink.model.section;
use mink.model.space.Space;
use mink.model.symbol;
use mink.model.target;

# what a section or record holds
# ---
# zero: a zero fill of this many bytes, with nothing in the file
# held: bytes of an input or of the object's store
pub tag Contents: u8 {
    zero: u64;
    held: Held;
}

# name:        the section's name, none for a section that states only its
#              kind, which a format names from its kind when it lowers it
# kind:        the role it plays
# flags:       the flags it carries
# align:       its alignment, a power of two
# entsize:     the size of one entry of a merge section or of an unwind
#              index of fixed entries, zero otherwise
# contents:    its bytes or zero fill
# owner:       the section it depends on, as a COFF associative member or an
#              ELF link-order section does
# group:       the group it is a member of
# disposition: how garbage collection treats it
# priority:    where a table of functions the loader runs orders among the
#              tables of its kind, a lower priority first, none for a table
#              that states none
pub rec Section {
    name:        opt[Id[Name]];
    kind:        *section.Kind;
    flags:       section.Flags;
    align:       u64;
    entsize:     u64;
    contents:    Contents;
    owner:       opt[Id[Section]];
    group:       opt[Id[Group]];
    disposition: *section.Disposition;
    priority:    opt[u32];
}

# a place in a section
pub rec Place {
    section: Id[Section];
    offset:  u64;
}

# a stretch of code in one section and the source lines it comes from
#
# the sequence covers the offsets from `start` up to, and not including, `end`.
# it has no end marker row: the end it states is the whole of it, and a format
# whose encoding closes a sequence with one writes it
# ---
# start: where the code begins, the place of the function it is for
# end:   the offset within the section where the code ends
# rows:  the rows, in ascending offset order, each in [start, end)
pub rec Sequence {
    start: Place;
    end:   u64;
    rows:  Table[Row];
}

# a common block the linker allocates
pub rec Common {
    size:  u64;
    align: u64;
}

# where a symbol's value comes from
# ---
# undefined: another object defines it
# placed:    a place in a section
# absolute:  a fixed value
# common:    a common block
# entry:     an entry of an index space
pub tag Definition: u8 {
    undefined;
    placed:   Place;
    absolute: u64;
    common:   Common;
    entry:    Id[Entry];
}

# a symbol version, as ELF verdef and verneed name one
# ---
# name:    the version's name
# default: the version an unversioned reference binds, as `name@@VER`
#          defines it. a reference names a version and leaves this false
pub rec Version {
    name:    Id[Name];
    default: bool;
}

# size:      the size the input states, a known nonzero size or absent. no format
#            tells a zero size from none, so add_symbol refuses some(0) and
#            `sized` gives the one form a zero takes
# version:   the version it defines or refers to, absent where the format
#            has none or the input states none
# retain:    garbage collection keeps the atom it defines whether referenced
#            or not
# alt_entry: it names a further entry into the atom of the symbol before it,
#            rather than starting an atom of its own
pub rec Symbol {
    name:       Id[Name];
    binding:    *symbol.Binding;
    visibility: *symbol.Visibility;
    kind:       *symbol.Kind;
    def:        Definition;
    size:       opt[u64];
    version:    opt[Version];
    retain:     bool;
    alt_entry:  bool;
}

# what a relocation refers to
# ---
# symbol: a symbol of the object
# entry:  an entry of an index space
# none:   nothing, as a marker computes no value and so has nothing to refer to
pub tag Target: u8 {
    symbol: Id[Symbol];
    entry:  Id[Entry];
    none;
}

# section: the section the relocation patches
# offset:  the place within it
# kind:    what it computes
# target:  what it refers to
# addend:  the addend, read from the record or from the field
# minus:   the symbol subtracted, for a difference kind
pub rec Reloc {
    section: Id[Section];
    offset:  u64;
    kind:    *reloc.Kind;
    target:  Target;
    addend:  i64;
    minus:   opt[Id[Symbol]];
}

# signature: the name copies of the group are matched by
# rule:      how a copy is chosen
# leader:    for an associative group, the section it is kept with
pub rec Group {
    signature: Id[Name];
    rule:      *Rule;
    leader:    opt[Id[Section]];
}

# a system note: an owner's name, its type and its descriptor
pub rec Note {
    owner: Id[Name];
    kind:  u32;
    desc:  Contents;
}

# a fact only one format carries, keyed by that format, as a Mach-O build
# version or the ELF e_flags bits no trait row maps are. `key` is the
# format's own
pub rec Fact {
    format: *Format;
    key:    u32;
    value:  u64;
    data:   Contents;
}

# an imported entry or symbol: the module and the field it comes from
# ---
# library: the library of the object's table it comes from, none where the
#          input names none
# ordinal: the number it is imported by instead of its name, none for an
#          import by name
pub rec Import {
    module:  Id[Name];
    field:   Id[Name];
    library: opt[Id[Library]];
    ordinal: opt[u16];
}

# an entry of an index space
# ---
# space:     the space it is in
# name:      its name, absent when it has none
# import:    where it comes from, absent when the object defines it
# body:      where its definition sits, absent for an import
# signature: its entry in the type space, absent where the space has no types
pub rec Entry {
    space:     *Space;
    name:      opt[Id[Name]];
    import:    opt[Import];
    body:      opt[Place];
    signature: opt[Id[Entry]];
}

# the versions of a shared library, as a Mach-O dylib states them
# ---
# current: the version the library is
# compat:  the oldest version an image built against it may load instead
pub rec Versions {
    current: u32;
    compat:  u32;
}

# a shared library: what an object is when it describes one, an input that
# defines symbols for the loader to bind and contributes no sections, or one
# an object links against
# ---
# loader:    the name the loader knows it by, as an ELF DT_SONAME, a Mach-O
#            install name or a DLL name, absent when it states none
# versions:  its versions, absent where the input states none
# reexports: an image linked against the object also sees the library's
#            definitions as its own
# weak:      the loader runs the image when the library is missing
pub rec Library {
    loader:    opt[Id[Name]];
    versions:  opt[Versions];
    reexports: bool;
    weak:      bool;
}

# an instruction the object carries for whoever links it
# ---
# kind:   what it asks
# text:   its text: a library or framework name, an option, a warning, or
#         the name an alternate stands in for
# symbol: the name of the symbol it is about, none for a directive about no
#         symbol. a directive names a symbol the link resolves, which need
#         not be one the object holds, as an export or a warning may not be
pub rec Directive {
    kind:   *directive.Kind;
    text:   Id[Name];
    symbol: opt[Id[Name]];
}

# the part of a section, from `start` up to, and not including, `end`, whose
# code a producer built to run in constant time. it is set only by a producer
# in memory and never serialized, so an object read from a file holds none
pub rec CtRange {
    section: Id[Section];
    start:   u64;
    end:     u64;
}

# the facts a frame's rules begin from, as a DWARF CIE states them
# ---
# code_align: the factor code offsets are stated in
# data_align: the factor data offsets are stated in
# initial:    the rules in effect at the function's start
pub rec Cie {
    code_align: u64;
    data_align: i64;
    initial:    Table[frame.Rule];
}

# how to unwind one function
# ---
# function:    the symbol of the function
# start:       the offset in its section where the function starts
# end:         the offset where it ends
# cie:         the facts its rules begin from
# steps:       the rules, each at its offset, in ascending offset order
# personality: the personality routine, none for a function with none
# lsda:        the language specific data, none for a function with none
# signal:      the frame is a signal handler's
pub rec Frame {
    function:    Id[Symbol];
    start:       u64;
    end:         u64;
    cie:         Cie;
    steps:       Table[frame.Step];
    personality: opt[Id[Symbol]];
    lsda:        opt[Id[Symbol]];
    signal:      bool;
}

# target:     what the object is for
# files:      the source files line rows name
# file_index: the files in the order of `line.order_files`, by which a file is
#             found. add_file keeps it, nothing else writes it
# sequences:  the line sequences, which a format lowers to its line table
# traits:     the trait axes the object states, one value each
# library:    what the object describes when it is a shared library, absent
#             for an object to link
# libraries:  the shared libraries it links against
# directives: what it asks of whoever links it
# frames:     how to unwind each of its functions
# ct:         the ranges of code built to run in constant time
pub rec Object {
    target:     target.Target;
    names:      Interner;
    store:      Store;
    sections:   Table[Section];
    symbols:    Table[Symbol];
    relocs:     Table[Reloc];
    groups:     Table[Group];
    notes:      Table[Note];
    facts:      Table[Fact];
    entries:    Table[Entry];
    files:      Table[File];
    file_index: Table[FileKey];
    sequences:  Table[Sequence];
    traits:     Table[Trait];
    library:    opt[Library];
    libraries:  Table[Library];
    directives: Table[Directive];
    frames:     Table[Frame];
    ct:         Table[CtRange];
}

# an empty object for the architecture `arch`, stating nothing else of its
# target
pub fun make(a: *A.Allocator, arch: *Arch) Object {
    ret Object{
        target:     target.of(arch),
        names:      intern.make(a),
        store:      store.make(a),
        sections:   table.make[Section](a),
        symbols:    table.make[Symbol](a),
        relocs:     table.make[Reloc](a),
        groups:     table.make[Group](a),
        notes:      table.make[Note](a),
        facts:      table.make[Fact](a),
        entries:    table.make[Entry](a),
        files:      table.make[File](a),
        file_index: table.make[FileKey](a),
        sequences:  table.make[Sequence](a),
        traits:     table.make[Trait](a),
        libraries:  table.make[Library](a),
        directives: table.make[Directive](a),
        frames:     table.make[Frame](a),
        ct:         table.make[CtRange](a),
    };
}

# give everything the object owns back, reporting the first refusal
pub fun release(o: *Object) err[Fail] {
    var first: err[Fail] = intern.release(?o.names);
    first = kept(first, store.release(?o.store));
    first = kept(first, table.release[Section](?o.sections));
    first = kept(first, table.release[Symbol](?o.symbols));
    first = kept(first, table.release[Reloc](?o.relocs));
    first = kept(first, table.release[Group](?o.groups));
    first = kept(first, table.release[Note](?o.notes));
    first = kept(first, table.release[Fact](?o.facts));
    first = kept(first, table.release[Trait](?o.traits));
    first = kept(first, table.release[File](?o.files));
    first = kept(first, table.release[FileKey](?o.file_index));
    first = kept(first, release_sequences(o));
    first = kept(first, release_frames(o));
    first = kept(first, table.release[Library](?o.libraries));
    first = kept(first, table.release[Directive](?o.directives));
    first = kept(first, table.release[CtRange](?o.ct));
    ret kept(first, table.release[Entry](?o.entries));
}

# a copy of `o` that owns what `o` owns, so changing it, as lowering its
# records does, leaves `o` as it was. what `o` borrows the copy borrows too.
# a refusal leaves nothing behind
pub fun copy(a: *A.Allocator, o: *Object) res[Object, Fail] {
    var c: Object = make(a, o.target.arch);
    c.target  = o.target;
    c.library = o.library;
    val r: err[Fail] = copied(o, ?c);
    if (sel r.err) {
        val dropped: err[Fail] = release(?c);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{c};
}

fun copied(o: *Object, c: *Object) err[Fail] {
    var i: usize = 0;
    for (i < intern.count(?o.names)) {
        val v:  View                = intern.bytes_of(?o.names, table.nth[Name](i));
        val id: res[Id[Name], Fail] = intern.intern(?c.names, v.data, v.len);
        if (sel id.err)              { ret err[Fail].err{id.err}; }
        if (id.ok.index::usize != i) { ret err[Fail].err{fail.internal("a copied name takes another id")}; }
        i = i + 1;
    }
    val n: usize = store.size(?o.store);
    if (n != 0) {
        val held: res[Held, Fail] = store.own(?c.store, store.base(?o.store), n);
        if (sel held.err) { ret err[Fail].err{held.err}; }
    }
    var r: err[Fail] = copy_table[Section](?o.sections, ?c.sections);
    r = kept(r, copy_table[Symbol](?o.symbols, ?c.symbols));
    r = kept(r, copy_table[Reloc](?o.relocs, ?c.relocs));
    r = kept(r, copy_table[Group](?o.groups, ?c.groups));
    r = kept(r, copy_table[Note](?o.notes, ?c.notes));
    r = kept(r, copy_table[Fact](?o.facts, ?c.facts));
    r = kept(r, copy_table[Entry](?o.entries, ?c.entries));
    r = kept(r, copy_table[File](?o.files, ?c.files));
    r = kept(r, copy_table[FileKey](?o.file_index, ?c.file_index));
    r = kept(r, copy_table[Trait](?o.traits, ?c.traits));
    r = kept(r, copy_table[Library](?o.libraries, ?c.libraries));
    r = kept(r, copy_table[Directive](?o.directives, ?c.directives));
    r = kept(r, copy_table[CtRange](?o.ct, ?c.ct));
    if (sel r.err) { ret r; }
    i = 0;
    for (i < table.count[Sequence](?o.sequences)) {
        val q:    *Sequence = table.at[Sequence](?o.sequences, table.nth[Sequence](i));
        var dup:  Sequence  = Sequence{start: q.start, end: q.end, rows: table.make[Row](c.sequences.a)};
        val rows: err[Fail] = copy_table[Row](?q.rows, ?dup.rows);
        if (sel rows.err) {
            val dropped: err[Fail] = table.release[Row](?dup.rows);
            ret rows;
        }
        val p: res[Id[Sequence], Fail] = table.push[Sequence](?c.sequences, dup);
        if (sel p.err) {
            val dropped: err[Fail] = table.release[Row](?dup.rows);
            ret err[Fail].err{p.err};
        }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Frame](?o.frames)) {
        val f:   *Frame = table.at[Frame](?o.frames, table.nth[Frame](i));
        var dup: Frame  = @f;
        dup.cie.initial = table.make[frame.Rule](c.frames.a);
        dup.steps       = table.make[frame.Step](c.frames.a);
        var e: err[Fail] = copy_table[frame.Rule](?f.cie.initial, ?dup.cie.initial);
        e = kept(e, copy_table[frame.Step](?f.steps, ?dup.steps));
        var pushed: err[Fail] = e;
        if (sel e.ok) {
            val p: res[Id[Frame], Fail] = table.push[Frame](?c.frames, dup);
            if (sel p.err) { pushed = err[Fail].err{p.err}; }
        }
        e = pushed;
        if (sel e.err) {
            val r1: err[Fail] = table.release[frame.Rule](?dup.cie.initial);
            val r2: err[Fail] = table.release[frame.Step](?dup.steps);
            ret e;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun copy_table[T](from: *Table[T], to: *Table[T]) err[Fail] {
    val n: usize = table.count[T](from);
    if (n == 0) { ret err[Fail].ok{}; }
    val r: res[Id[T], Fail] = table.extend[T](to, table.items[T](from), n);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

# whether `o` states records a format lowers into sections when it writes
# the object, as its line sequences
pub fun has_records(o: *Object) bool {
    ret table.count[Sequence](?o.sequences) != 0;
}

# give the line records back, as a format does once it has lowered them into
# sections and relocations
pub fun drop_lines(o: *Object) err[Fail] {
    val q: err[Fail] = release_sequences(o);
    val f: err[Fail] = table.release[File](?o.files);
    val k: err[Fail] = table.release[FileKey](?o.file_index);
    ret kept(kept(q, f), k);
}

# whether `o` holds no name, entry or trait, no record and describes no
# library
pub fun empty(o: *Object) bool {
    if (intern.count(?o.names) != 0)                                                                                          { ret false; }
    if (table.count[Section](?o.sections) != 0 || table.count[Symbol](?o.symbols) != 0 || table.count[Reloc](?o.relocs) != 0) { ret false; }
    if (table.count[Group](?o.groups) != 0 || table.count[Note](?o.notes) != 0 || table.count[Fact](?o.facts) != 0)           { ret false; }
    if (table.count[Trait](?o.traits) != 0 || table.count[Entry](?o.entries) != 0)                                            { ret false; }
    if (table.count[Library](?o.libraries) != 0 || table.count[Directive](?o.directives) != 0)                                { ret false; }
    if (table.count[Frame](?o.frames) != 0 || table.count[CtRange](?o.ct) != 0)                                               { ret false; }
    ret sel o.library.none;
}

# an empty object for the architecture of `o`, in the allocator `o` lives in,
# for a conversion to build and commit to `o` only once it succeeds
pub fun blank(o: *Object) Object {
    ret make(o.sections.a, o.target.arch);
}

# replace the empty object `o` by `built`, which `o` owns from then on. a
# refused release of `o` gives `built` back too, and leaves `o` empty
pub fun commit(o: *Object, built: *Object) err[Fail] {
    val old: err[Fail] = release(o);
    if (sel old.err) {
        val dropped: err[Fail] = release(built);
        ret old;
    }
    val moved: Object = @built;
    @o = moved;
    ret err[Fail].ok{};
}

pub fun name(o: *Object, p: *u8, n: usize) res[Id[Name], Fail] {
    ret intern.intern(?o.names, p, n);
}

pub fun name_str(o: *Object, s: str) res[Id[Name], Fail] {
    ret intern.intern_str(?o.names, s);
}

# the bytes of a name, valid until the next name is interned
pub fun name_of(o: *Object, id: Id[Name]) View {
    ret intern.bytes_of(?o.names, id);
}

# the name section `s` is written with: its own, or the one `naming` gives its
# kind when it states none
pub fun section_name(o: *Object, s: *Section, naming: fun(*section.Kind) res[str, Fail]) res[View, Fail] {
    if (sel s.name.some) { ret res[View, Fail].ok{name_of(o, s.name.some)}; }
    val given: res[str, Fail] = naming(s.kind);
    if (sel given.err) { ret res[View, Fail].err{given.err}; }
    ret res[View, Fail].ok{View{data: given.ok, len: str_len(given.ok)}};
}

# a copy of the `n` bytes at `p` the object owns
pub fun own(o: *Object, p: *u8, n: usize) res[Contents, Fail] {
    val h: res[Held, Fail] = store.own(?o.store, p, n);
    if (sel h.err) { ret res[Contents, Fail].err{h.err}; }
    ret res[Contents, Fail].ok{Contents.held{h.ok}};
}

# the bytes of `c`, nil for a zero fill. owned bytes stay valid until the
# object next owns bytes
pub fun bytes(o: *Object, c: *Contents) Bytes {
    if (sel c.held) { ret store.bytes(?o.store, ?c.held); }
    ret Bytes{data: nil, len: 0};
}

pub fun add_section(o: *Object, s: Section) res[Id[Section], Fail] {
    ret table.push[Section](?o.sections, s);
}

# the symbol size a stated byte count is: none for zero
pub fun sized(n: u64) opt[u64] {
    if (n == 0) { ret opt[u64].none{}; }
    ret opt[u64].some{n};
}

pub fun add_symbol(o: *Object, s: Symbol) res[Id[Symbol], Fail] {
    if (sel s.size.some) {
        if (s.size.some == 0) {
            ret res[Id[Symbol], Fail].err{fail.in_indexed(fail.malformed("a symbol states a size of zero, which is none"), "symbol", table.count[Symbol](?o.symbols)::u64)};
        }
    }
    ret table.push[Symbol](?o.symbols, s);
}

# a relocation whose kind and target disagree on whether it refers to anything
# is refused here, before any write or link, and names its place
pub fun add_reloc(o: *Object, r: Reloc) res[Id[Reloc], Fail] {
    val fits: err[Fail] = reloc.allows_target(r.kind, sel r.target.none);
    if (sel fits.err) { ret res[Id[Reloc], Fail].err{fail.at_offset(fail.in_indexed(fits.err, "relocation", table.count[Reloc](?o.relocs)::u64), r.offset)}; }
    ret table.push[Reloc](?o.relocs, r);
}

# add the source file `f`, refusing a file the table already holds under the
# same directory and name. the id names it in rows, and is the existing file's
# when `file_named` finds it
pub fun add_file(o: *Object, f: File) res[Id[File], Fail] {
    val key: FileKey        = FileKey{directory: f.directory, name: f.name, file: table.nth[File](table.count[File](?o.files))};
    val at:  SearchPosition = file_position(o, ?key);
    if (sel at.found) {
        val held: Id[File] = table.at[FileKey](?o.file_index, table.nth[FileKey](at.found)).file;
        ret res[Id[File], Fail].err{fail.in_indexed(fail.malformed("the file table already holds a file of this directory and name"), "file", held.index::u64)};
    }
    val gf: err[Fail] = table.reserve[File](?o.files, 1);
    if (sel gf.err) { ret res[Id[File], Fail].err{gf.err}; }
    val gi: err[Fail] = table.reserve[FileKey](?o.file_index, 1);
    if (sel gi.err) { ret res[Id[File], Fail].err{gi.err}; }
    val id: res[Id[File], Fail] = table.push[File](?o.files, f);
    if (sel id.err) { ret id; }
    val ins: err[Fail] = table.insert[FileKey](?o.file_index, at.insertion, key);
    if (sel ins.err) { ret res[Id[File], Fail].err{ins.err}; }
    ret id;
}

# the file of `directory` and `name`, none when the table holds none
pub fun file_named(o: *Object, directory: opt[Id[Name]], name: Id[Name]) opt[Id[File]] {
    var probe: FileKey        = FileKey{directory: directory, name: name};
    val at:    SearchPosition = file_position(o, ?probe);
    if (sel at.found) { ret opt[Id[File]].some{table.at[FileKey](?o.file_index, table.nth[FileKey](at.found)).file}; }
    ret opt[Id[File]].none{};
}

# begin a line sequence over the code from `start` up to `end` in one section.
# a sequence over a section that is not code, one that ends before it starts
# and one that ends past the section's size are refused as malformed. a
# section whose contents are not stated yet has no size to check against
pub fun add_sequence(o: *Object, start: Place, end: u64) res[Id[Sequence], Fail] {
    val index: u64 = table.count[Sequence](?o.sequences)::u64;
    if (start.section.index::usize >= table.count[Section](?o.sections)) {
        ret res[Id[Sequence], Fail].err{fail.in_indexed(fail.malformed("the line sequence names a section that is not in the object"), "line sequence", index)};
    }
    val s: *Section = section_at(o, start.section);
    if ((s.flags & section.EXEC) == 0) {
        ret res[Id[Sequence], Fail].err{fail.at_offset(fail.in_indexed(fail.malformed("the line sequence is over a section that is not code"), "line sequence", index), start.offset)};
    }
    if (end < start.offset) {
        ret res[Id[Sequence], Fail].err{fail.at_offset(fail.in_indexed(fail.malformed("the line sequence ends before it starts"), "line sequence", index), start.offset)};
    }
    val size: u64 = size_of(o, s);
    if (size != 0 && end > size) {
        ret res[Id[Sequence], Fail].err{fail.at_offset(fail.in_indexed(fail.malformed("the line sequence ends past the end of its section"), "line sequence", index), end)};
    }
    ret table.push[Sequence](?o.sequences, Sequence{start: start, end: end, rows: table.make[Row](o.sections.a)});
}

# add the row `r` to the sequence `seq`, after the rows it holds. the id is the
# row's index within the sequence. a row is refused as malformed, naming the
# row and the sequence, when
# - it names a file the table does not hold
# - its offset is past the section's size, where the section states one
# - its offset is outside the sequence, before its start or at or after its end
# - its offset is below the previous row's
# - its end column is before its column
pub fun add_row(o: *Object, seq: Id[Sequence], r: Row) res[Id[Row], Fail] {
    if (seq.index::usize >= table.count[Sequence](?o.sequences)) {
        ret res[Id[Row], Fail].err{fail.valued(fail.at_offset(fail.in_record(fail.malformed("the row names a line sequence that is not in the object"), "line row"), r.at), seq.index::i128)};
    }
    val q:     *Sequence = table.at[Sequence](?o.sequences, seq);
    val index: u64       = table.count[Row](?q.rows)::u64;
    if (r.file.index::usize >= table.count[File](?o.files)) {
        ret res[Id[Row], Fail].err{row_fault(fail.malformed("the row names a file that is not in the file table"), seq, index, r.at)};
    }
    val size: u64 = size_of(o, section_at(o, q.start.section));
    if (size != 0 && r.at >= size) {
        ret res[Id[Row], Fail].err{row_fault(fail.malformed("the row is past the end of its section"), seq, index, r.at)};
    }
    if (sel r.end_column.some && r.end_column.some < r.column) {
        ret res[Id[Row], Fail].err{row_fault(fail.malformed("the row's end column is before its column"), seq, index, r.at)};
    }
    if (r.at < q.start.offset || r.at >= q.end) {
        ret res[Id[Row], Fail].err{row_fault(fail.malformed("the row is outside its line sequence"), seq, index, r.at)};
    }
    if (index != 0 && r.at < table.at[Row](?q.rows, table.nth[Row]((index - 1)::usize)).at) {
        ret res[Id[Row], Fail].err{row_fault(fail.malformed("the row is below the previous row"), seq, index, r.at)};
    }
    ret table.push[Row](?q.rows, r);
}

pub fun add_group(o: *Object, g: Group) res[Id[Group], Fail] {
    ret table.push[Group](?o.groups, g);
}

pub fun add_note(o: *Object, n: Note) res[Id[Note], Fail] {
    ret table.push[Note](?o.notes, n);
}

pub fun add_fact(o: *Object, f: Fact) res[Id[Fact], Fail] {
    ret table.push[Fact](?o.facts, f);
}

pub fun add_entry(o: *Object, e: Entry) res[Id[Entry], Fail] {
    ret table.push[Entry](?o.entries, e);
}

pub fun add_library(o: *Object, l: Library) res[Id[Library], Fail] {
    ret table.push[Library](?o.libraries, l);
}

# add the directive `d`, refusing one whose text or symbol is not a name of
# the object
pub fun add_directive(o: *Object, d: Directive) res[Id[Directive], Fail] {
    val index: u64 = table.count[Directive](?o.directives)::u64;
    if (d.text.index::usize >= intern.count(?o.names)) {
        ret res[Id[Directive], Fail].err{fail.in_indexed(fail.malformed("the directive's text is not a name of the object"), "directive", index)};
    }
    if (sel d.symbol.some) {
        if (d.symbol.some.index::usize >= intern.count(?o.names)) {
            ret res[Id[Directive], Fail].err{fail.in_indexed(fail.malformed("the directive's symbol is not a name of the object"), "directive", index)};
        }
    }
    ret table.push[Directive](?o.directives, d);
}

# mark the range `r` as code built to run in constant time, refusing a range
# outside its section or one that ends before it starts. only a producer marks
# a range, and no format reads or writes one
pub fun mark_ct(o: *Object, r: CtRange) res[Id[CtRange], Fail] {
    val index: u64 = table.count[CtRange](?o.ct)::u64;
    if (r.section.index::usize >= table.count[Section](?o.sections)) {
        ret res[Id[CtRange], Fail].err{fail.in_indexed(fail.malformed("the constant-time range names a section that is not in the object"), "constant-time range", index)};
    }
    val size: u64 = size_of(o, section_at(o, r.section));
    if (r.end < r.start || r.end > size) {
        ret res[Id[CtRange], Fail].err{fail.at_offset(fail.in_indexed(fail.malformed("the constant-time range is not within its section"), "constant-time range", index), r.start)};
    }
    ret table.push[CtRange](?o.ct, r);
}

# begin the frame of the function `function`, from `start` up to `end` of its
# section, whose rules begin from a CIE of the alignment factors `code_align`
# and `data_align`. a frame of a symbol the object does not hold, or that ends
# before it starts, is refused
pub fun add_frame(o: *Object, function: Id[Symbol], start: u64, end: u64, code_align: u64, data_align: i64) res[Id[Frame], Fail] {
    val index: u64 = table.count[Frame](?o.frames)::u64;
    if (function.index::usize >= table.count[Symbol](?o.symbols)) {
        ret res[Id[Frame], Fail].err{fail.in_indexed(fail.malformed("the frame names a symbol that is not in the object"), "frame", index)};
    }
    if (end < start) {
        ret res[Id[Frame], Fail].err{fail.at_offset(fail.in_indexed(fail.malformed("the frame ends before it starts"), "frame", index), start)};
    }
    val a: *A.Allocator = o.sections.a;
    ret table.push[Frame](?o.frames, Frame{function: function, start: start, end: end, cie: Cie{code_align: code_align, data_align: data_align, initial: table.make[frame.Rule](a)}, steps: table.make[frame.Step](a)});
}

# add `r` to the rules frame `f` begins from
pub fun add_initial(o: *Object, f: Id[Frame], r: frame.Rule) err[Fail] {
    val pushed: res[Id[frame.Rule], Fail] = table.push[frame.Rule](?table.at[Frame](?o.frames, f).cie.initial, r);
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

# add the step `s` to frame `f`, after its steps. a step outside the frame or
# below the previous step is refused
pub fun add_step(o: *Object, f: Id[Frame], s: frame.Step) err[Fail] {
    val fr:    *Frame = table.at[Frame](?o.frames, f);
    val index: u64    = table.count[frame.Step](?fr.steps)::u64;
    if (s.at < fr.start || s.at > fr.end) {
        ret err[Fail].err{fail.at_offset(fail.in_indexed(fail.malformed("the frame step is outside its frame"), "frame step", index), s.at)};
    }
    if (index != 0 && s.at < table.at[frame.Step](?fr.steps, table.nth[frame.Step]((index - 1)::usize)).at) {
        ret err[Fail].err{fail.at_offset(fail.in_indexed(fail.malformed("the frame step is below the previous step"), "frame step", index), s.at)};
    }
    val pushed: res[Id[frame.Step], Fail] = table.push[frame.Step](?fr.steps, s);
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

# state `s` on the trait axis `x`, refused for an axis the object's
# architecture does not have, a value the axis does not have, an axis already
# stated, an ISA string for another row, and a value of an axis the row fixes
# other than the one it fixes. a value that means what leaving the axis
# unstated means, and the value the row fixes, are held as nothing, so one
# meaning has one form
pub fun state(o: *Object, x: *Axis, s: Setting) err[Fail] {
    if (!arch.has_axis(o.target.arch, x)) {
        ret err[Fail].err{fail.about(fail.malformed("the architecture has no such trait axis"), x.name)};
    }
    val fixed: opt[Setting] = arch.fixed_value(o.target.arch, x);
    if (sel fixed.some) {
        if (!trait.same(fixed.some, s)) { ret err[Fail].err{fail.about(fail.malformed("the object states a value of a trait axis its architecture fixes otherwise"), x.name)}; }
        ret err[Fail].ok{};
    }
    if (sel x.merge.extensions) {
        if (sel s.text) {
            var held: Held       = s.text;
            val text: Bytes      = store.bytes(?o.store, ?held);
            val base: opt[*Base] = isa.base_of(x.merge.extensions, text);
            if (sel base.none)                                   { ret err[Fail].err{not_based(x)}; }
            if (!str_equals(base.some.arch, o.target.arch.name)) { ret err[Fail].err{not_based(x)}; }
        }
    }
    or (sel x.merge.set) {
        if (sel s.set) {
            var held: Held = s.set;
            if (!merge.written_set(x.merge.set, store.bytes(?o.store, ?held))) {
                ret err[Fail].err{fail.about(fail.malformed("a set is not written as its trait axis writes one"), x.name)};
            }
        }
    }
    ret trait.state(?o.traits, Trait{axis: x, setting: s});
}

# what the object states on `x`, none when it states nothing
pub fun stated(o: *Object, x: *Axis) opt[Setting] {
    val t: opt[*Trait] = trait.find(?o.traits, x);
    if (sel t.some) { ret opt[Setting].some{t.some.setting}; }
    ret opt[Setting].none{};
}

# what the object holds on `x`: what it states, what its architecture fixes,
# or what leaving the axis unstated means, none when that places no
# constraint
pub fun effective(o: *Object, x: *Axis) opt[Setting] {
    val t: opt[*Trait] = trait.find(?o.traits, x);
    if (sel t.some) { ret opt[Setting].some{t.some.setting}; }
    val fixed: opt[Setting] = arch.fixed_value(o.target.arch, x);
    if (sel fixed.some) { ret fixed; }
    ret trait.absent_value(x);
}

# whether a shared library offers `s` to other images: it is external,
# defined and of a visibility the image exports
pub fun offers(s: *Symbol) bool {
    ret symbol.binds(s.binding, symbol.EXTERNAL) && !(sel s.def.undefined) && symbol.shows(s.visibility, symbol.EXPORTED);
}

pub fun section_at(o: *Object, id: Id[Section]) *Section {
    ret table.at[Section](?o.sections, id);
}

pub fun symbol_at(o: *Object, id: Id[Symbol]) *Symbol {
    ret table.at[Symbol](?o.symbols, id);
}

pub fun file_at(o: *Object, id: Id[File]) *File {
    ret table.at[File](?o.files, id);
}

pub fun sequence_at(o: *Object, id: Id[Sequence]) *Sequence {
    ret table.at[Sequence](?o.sequences, id);
}

pub fun group_at(o: *Object, id: Id[Group]) *Group {
    ret table.at[Group](?o.groups, id);
}

# the fact `f` states under `key`, none when it states none
pub fun fact(o: *Object, f: *Format, key: u32) opt[*Fact] {
    var i: usize = 0;
    for (i < table.count[Fact](?o.facts)) {
        val x: *Fact = table.at[Fact](?o.facts, table.nth[Fact](i));
        if (x.format == f && x.key == key) { ret opt[*Fact].some{x}; }
        i = i + 1;
    }
    ret opt[*Fact].none{};
}

# the section whose fate `s` shares: `s` itself, or for a member of an
# associative group, the section that group is kept with, followed to the end.
# a chain that comes back on itself is malformed
pub fun leader_of(o: *Object, s: Id[Section]) res[Id[Section], Fail] {
    var at:    Id[Section] = s;
    var steps: usize       = 0;
    for {
        val g: opt[Id[Group]] = section_at(o, at).group;
        if (sel g.none) { ret res[Id[Section], Fail].ok{at}; }
        val grp: *Group = group_at(o, g.some);
        if (!group.has(grp.rule, group.ASSOCIATIVE)) { ret res[Id[Section], Fail].ok{at}; }
        if (sel grp.leader.none) {
            ret res[Id[Section], Fail].err{fail.malformed("associative group has no leader section")};
        }
        steps = steps + 1;
        if (steps > table.count[Section](?o.sections)) {
            ret res[Id[Section], Fail].err{fail.malformed("associative groups form a cycle")};
        }
        at = grp.leader.some;
    }
    ret res[Id[Section], Fail].ok{at};
}

fun row_fault(f: Fail, seq: Id[Sequence], index: u64, at: u64) Fail {
    ret fail.valued(fail.about(fail.at_offset(fail.in_indexed(f, "line row", index), at), "line sequence"), seq.index::i128);
}

# where `key` sits in the file index
fun file_position(o: *Object, key: *FileKey) SearchPosition {
    ret sort.binary_search_by[FileKey](table.items[FileKey](?o.file_index), table.count[FileKey](?o.file_index), key, line.order_files);
}

# the size of the contents of `s`, zero while it states none
fun size_of(o: *Object, s: *Section) u64 {
    if (sel s.contents.zero) { ret s.contents.zero; }
    ret bytes(o, ?s.contents).len::u64;
}

# give every sequence's rows back, then the sequences, reporting the first
# refusal
fun release_sequences(o: *Object) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[Sequence](?o.sequences)) {
        first = kept(first, table.release[Row](?table.at[Sequence](?o.sequences, table.nth[Sequence](i)).rows));
        i     = i + 1;
    }
    ret kept(first, table.release[Sequence](?o.sequences));
}

fun not_based(x: *Axis) Fail {
    ret fail.about(fail.malformed("the ISA string's base is not the architecture's"), x.name);
}

# give every frame's rules back, then the frames, reporting the first refusal
fun release_frames(o: *Object) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[Frame](?o.frames)) {
        val f: *Frame = table.at[Frame](?o.frames, table.nth[Frame](i));
        first = kept(first, table.release[frame.Rule](?f.cie.initial));
        first = kept(first, table.release[frame.Step](?f.steps));
        i     = i + 1;
    }
    ret kept(first, table.release[Frame](?o.frames));
}

fun kept(first: err[Fail], next: err[Fail]) err[Fail] {
    if (sel first.err) { ret first; }
    ret next;
}

# a fresh object for a test over `t`
fun scratch(t: *T.Testing) res[Object, Fail] {
    val x: res[*Arch, Fail] = list.by_name("x86_64");
    if (sel x.err) { ret res[Object, Fail].err{x.err}; }
    ret res[Object, Fail].ok{make(T.allocator_of(t), x.ok)};
}

# a section named `n` of kind text
fun text(o: *Object, n: str) res[Id[Section], Fail] {
    val nm: res[Id[Name], Fail] = name_str(o, n);
    if (sel nm.err) { ret res[Id[Section], Fail].err{nm.err}; }
    ret add_section(o, Section{name: opt[Id[Name]].some{nm.ok}, kind: ?section.TEXT, flags: section.TEXT.flags, align: 16});
}

test object__an_absent_fact_stays_absent {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val s: res[Id[Section], Fail] = text(?o, ".text");
    if (sel s.err) { ret 1; }
    val nm: res[Id[Name], Fail] = name_str(?o, "f");
    if (sel nm.err) { ret 1; }
    val sym: res[Id[Symbol], Fail] = add_symbol(?o, Symbol{
        name:       nm.ok,
        binding:    ?symbol.GLOBAL,
        visibility: ?symbol.DEFAULT,
        kind:       ?symbol.FUNCTION,
        def:        Definition.placed{Place{section: s.ok, offset: 0}},
    });
    if (sel sym.err) { ret 1; }
    val stored: *Symbol = symbol_at(?o, sym.ok);
    if (sel stored.size.some) { ret 1; }
    val none: Symbol = Symbol{};
    if (sel none.size.some)      { ret 1; }
    if (!sel none.def.undefined) { ret 1; }
    val flags: opt[*Fact] = fact(?o, ?format.ELF, 0);
    if (sel flags.some) { ret 1; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test object__a_marker_refuses_a_symbol_target {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val s: res[Id[Section], Fail] = text(?o, ".text");
    if (sel s.err) { ret 1; }
    val nm: res[Id[Name], Fail] = name_str(?o, "f");
    if (sel nm.err) { ret 1; }
    val sym: res[Id[Symbol], Fail] = add_symbol(?o, Symbol{name: nm.ok, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.FUNCTION});
    if (sel sym.err) { ret 1; }

    val marker: res[Id[Reloc], Fail] = add_reloc(?o, Reloc{section: s.ok, offset: 4, kind: ?reloc.RELAX, target: Target.symbol{sym.ok}});
    if (sel marker.ok)                                      { ret 1; }
    if (!sel marker.err.cause.malformed)                    { ret 1; }
    if (!str_equals(marker.err.subject, "relax"))           { ret 1; }
    if (!marker.err.at.indexed || marker.err.at.index != 0) { ret 1; }
    if (!marker.err.at.placed || marker.err.at.offset != 4) { ret 1; }
    if (table.count[Reloc](?o.relocs) != 0)                 { ret 1; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test object__a_symbol_basis_relocation_refuses_no_target {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val s: res[Id[Section], Fail] = text(?o, ".text");
    if (sel s.err) { ret 1; }
    val nm: res[Id[Name], Fail] = name_str(?o, "f");
    if (sel nm.err) { ret 1; }
    val sym: res[Id[Symbol], Fail] = add_symbol(?o, Symbol{name: nm.ok, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.FUNCTION});
    if (sel sym.err) { ret 1; }

    val value: res[Id[Reloc], Fail] = add_reloc(?o, Reloc{section: s.ok, offset: 8, kind: ?reloc.ABS64, target: Target.none{}});
    if (sel value.ok)                                     { ret 1; }
    if (!sel value.err.cause.malformed)                   { ret 1; }
    if (!str_equals(value.err.subject, "abs64"))          { ret 1; }
    if (!value.err.at.indexed || value.err.at.index != 0) { ret 1; }
    if (!value.err.at.placed || value.err.at.offset != 8) { ret 1; }
    if (table.count[Reloc](?o.relocs) != 0)               { ret 1; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test object__an_associative_member_is_kept_with_its_leader {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val lead: res[Id[Section], Fail] = text(?o, ".text$f");
    if (sel lead.err) { ret 1; }
    val member: res[Id[Section], Fail] = text(?o, ".pdata$f");
    if (sel member.err) { ret 1; }
    val sig: res[Id[Name], Fail] = name_str(?o, "f");
    if (sel sig.err) { ret 1; }
    val any: res[Id[Group], Fail] = add_group(?o, Group{signature: sig.ok, rule: ?group.ANY});
    if (sel any.err) { ret 1; }
    val assoc: res[Id[Group], Fail] = add_group(?o, Group{
        signature: sig.ok,
        rule:      ?group.ASSOCIATE,
        leader:    opt[Id[Section]].some{lead.ok},
    });
    if (sel assoc.err) { ret 1; }
    section_at(?o, lead.ok).group   = opt[Id[Group]].some{any.ok};
    section_at(?o, member.ok).group = opt[Id[Group]].some{assoc.ok};
    section_at(?o, member.ok).owner = opt[Id[Section]].some{lead.ok};

    val l: res[Id[Section], Fail] = leader_of(?o, member.ok);
    if (sel l.err)                   { ret 1; }
    if (l.ok.index != lead.ok.index) { ret 1; }
    val self: res[Id[Section], Fail] = leader_of(?o, lead.ok);
    if (sel self.err)                   { ret 1; }
    if (self.ok.index != lead.ok.index) { ret 1; }

    group_at(?o, assoc.ok).leader = opt[Id[Section]].some{member.ok};
    val cycle: res[Id[Section], Fail] = leader_of(?o, member.ok);
    if (sel cycle.ok) { ret 1; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test object__ids_stay_stable_as_the_model_grows {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val first: res[Id[Section], Fail] = text(?o, ".text.first");
    if (sel first.err) { ret 1; }
    val nm: res[Id[Name], Fail] = name_str(?o, "first");
    if (sel nm.err) { ret 1; }
    val sym: res[Id[Symbol], Fail] = add_symbol(?o, Symbol{
        name:       nm.ok,
        binding:    ?symbol.LOCAL,
        visibility: ?symbol.DEFAULT,
        kind:       ?symbol.DATA,
        def:        Definition.absolute{7},
    });
    if (sel sym.err) { ret 1; }
    var i: usize = 0;
    for (i < 500) {
        val more: res[Id[Section], Fail] = text(?o, ".text.more");
        if (sel more.err) { ret 1; }
        val s: res[Id[Symbol], Fail] = add_symbol(?o, Symbol{name: nm.ok, binding: ?symbol.LOCAL, visibility: ?symbol.DEFAULT, kind: ?symbol.NOTYPE});
        if (sel s.err) { ret 1; }
        i = i + 1;
    }
    val named: opt[Id[Name]] = section_at(?o, first.ok).name;
    if (sel named.none) { ret 1; }
    val v: View = name_of(?o, named.some);
    if (v.len != 11 || v.data[10] != 't') { ret 1; }
    val d: Definition = symbol_at(?o, sym.ok).def;
    if (!sel d.absolute) { ret 1; }
    if (d.absolute != 7) { ret 1; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test object__a_file_with_an_md5_enters_the_table_and_a_duplicate_is_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val dir: res[Id[Name], Fail] = name_str(?o, "/src");
    if (sel dir.err) { ret 1; }
    val nm: res[Id[Name], Fail] = name_str(?o, "main.c");
    if (sel nm.err) { ret 1; }
    var digest: line.Md5;
    digest.bytes[0]  = 0xd4;
    digest.bytes[15] = 0x7e;

    val bare: res[Id[File], Fail] = add_file(?o, File{name: nm.ok});
    if (sel bare.err) { ret 1; }
    val f: res[Id[File], Fail] = add_file(?o, File{directory: opt[Id[Name]].some{dir.ok}, name: nm.ok, md5: opt[line.Md5].some{digest}});
    if (sel f.err)       { ret 1; }
    if (f.ok.index != 1) { ret 1; }
    val held: *File = file_at(?o, f.ok);
    if (!sel held.md5.some)                                                { ret 1; }
    if (held.md5.some.bytes[0] != 0xd4 || held.md5.some.bytes[15] != 0x7e) { ret 1; }
    val found: opt[Id[File]] = file_named(?o, opt[Id[Name]].some{dir.ok}, nm.ok);
    if (!sel found.some)       { ret 1; }
    if (found.some.index != 1) { ret 1; }
    val bare_found: opt[Id[File]] = file_named(?o, opt[Id[Name]].none{}, nm.ok);
    if (!sel bare_found.some)       { ret 1; }
    if (bare_found.some.index != 0) { ret 1; }

    val again: res[Id[File], Fail] = add_file(?o, File{directory: opt[Id[Name]].some{dir.ok}, name: nm.ok});
    if (sel again.ok)                                     { ret 1; }
    if (!sel again.err.cause.malformed)                   { ret 1; }
    if (!again.err.at.indexed || again.err.at.index != 1) { ret 1; }
    if (table.count[File](?o.files) != 2)                 { ret 1; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test object__a_row_naming_an_unknown_file_is_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val s: res[Id[Section], Fail] = text(?o, ".text");
    if (sel s.err) { ret 1; }
    val seq: res[Id[Sequence], Fail] = add_sequence(?o, Place{section: s.ok, offset: 0}, 32);
    if (sel seq.err) { ret 1; }

    val row: res[Id[Row], Fail] = add_row(?o, seq.ok, Row{at: 4, file: table.nth[File](0), line: 3, flags: line.STATEMENT});
    if (sel row.ok)                                           { ret 1; }
    if (!sel row.err.cause.malformed)                         { ret 1; }
    if (!row.err.at.indexed || row.err.at.index != 0)         { ret 1; }
    if (!row.err.at.placed || row.err.at.offset != 4)         { ret 1; }
    if (table.count[Row](?sequence_at(?o, seq.ok).rows) != 0) { ret 1; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test object__a_row_below_the_previous_row_is_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val s: res[Id[Section], Fail] = text(?o, ".text");
    if (sel s.err) { ret 1; }
    val nm: res[Id[Name], Fail] = name_str(?o, "main.c");
    if (sel nm.err) { ret 1; }
    val f: res[Id[File], Fail] = add_file(?o, File{name: nm.ok});
    if (sel f.err) { ret 1; }
    val seq: res[Id[Sequence], Fail] = add_sequence(?o, Place{section: s.ok, offset: 0}, 32);
    if (sel seq.err) { ret 1; }

    val first: res[Id[Row], Fail] = add_row(?o, seq.ok, Row{at: 8, file: f.ok, line: 3, flags: line.STATEMENT});
    if (sel first.err) { ret 1; }
    val same: res[Id[Row], Fail] = add_row(?o, seq.ok, Row{at: 8, file: f.ok, line: 4, flags: line.STATEMENT});
    if (sel same.err) { ret 1; }

    val back: res[Id[Row], Fail] = add_row(?o, seq.ok, Row{at: 4, file: f.ok, line: 5, flags: line.STATEMENT});
    if (sel back.ok)                                          { ret 1; }
    if (!sel back.err.cause.malformed)                        { ret 1; }
    if (!back.err.at.indexed || back.err.at.index != 2)       { ret 1; }
    if (!back.err.at.placed || back.err.at.offset != 4)       { ret 1; }
    if (!sel back.err.value.some)                             { ret 1; }
    if (back.err.value.some != 0)                             { ret 1; }
    if (table.count[Row](?sequence_at(?o, seq.ok).rows) != 2) { ret 1; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test object__a_symbol_refuses_a_stated_zero_size {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val nm: res[Id[Name], Fail] = name_str(?o, "f");
    if (sel nm.err) { ret 1; }
    val zero: res[Id[Symbol], Fail] = add_symbol(?o, Symbol{name: nm.ok, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.FUNCTION, size: opt[u64].some{0}});
    if (!sel zero.err)                        { ret 1; }
    if (table.count[Symbol](?o.symbols) != 0) { ret 1; }
    val none: opt[u64] = sized(0);
    if (sel none.some) { ret 1; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test object__frames_hold_their_rules_and_refuse_steps_outside_them {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val code: res[Id[Section], Fail] = text(?o, ".text");
    if (sel code.err) { ret 1; }
    val nm: res[Id[Name], Fail] = name_str(?o, "f");
    if (sel nm.err) { ret 1; }
    val f: res[Id[Symbol], Fail] = add_symbol(?o, Symbol{name: nm.ok, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.FUNCTION, def: Definition.placed{Place{section: code.ok, offset: 0}}});
    if (sel f.err) { ret 1; }

    val fr: res[Id[Frame], Fail] = add_frame(?o, f.ok, 0, 32, 1, -8);
    if (sel fr.err) { ret 2; }
    val i1: err[Fail] = add_initial(?o, fr.ok, frame.Rule.def_cfa{frame.Offset{reg: 7, offset: 8}});
    val i2: err[Fail] = add_initial(?o, fr.ok, frame.Rule.offset{frame.Offset{reg: 16, offset: -8}});
    if (sel i1.err) { ret 2; }
    if (sel i2.err) { ret 2; }
    val s1: err[Fail] = add_step(?o, fr.ok, frame.Step{at: 4, rule: frame.Rule.cfa_offset{16}});
    val s2: err[Fail] = add_step(?o, fr.ok, frame.Step{at: 8, rule: frame.Rule.scaled{frame.Scaled{reg: 31, offset: 16, quantity: 46}}});
    if (sel s1.err) { ret 2; }
    if (sel s2.err) { ret 2; }

    # a step below the previous one, one past the frame, and a frame of a
    # symbol the object does not hold are refused
    val below: err[Fail] = add_step(?o, fr.ok, frame.Step{at: 6, rule: frame.Rule.remember{}});
    val past:  err[Fail] = add_step(?o, fr.ok, frame.Step{at: 40, rule: frame.Rule.restore_state{}});
    if (!sel below.err) { ret 3; }
    if (!sel past.err)  { ret 3; }
    val stray: res[Id[Frame], Fail] = add_frame(?o, Id[Symbol]{index: 9}, 0, 8, 1, -8);
    if (!sel stray.err) { ret 3; }
    val held: *Frame = table.at[Frame](?o.frames, fr.ok);
    if (table.count[frame.Rule](?held.cie.initial) != 2) { ret 4; }
    if (table.count[frame.Step](?held.steps) != 2)       { ret 4; }

    # a constant-time range outside its section is refused
    val ct: res[Id[CtRange], Fail] = mark_ct(?o, CtRange{section: code.ok, start: 0, end: 8});
    if (!sel ct.err) { ret 5; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err)           { ret 6; }
    if (T.live_count(?t) != 0) { ret 6; }
    T.dnit(?t);
    ret 0;
}

test object__a_value_its_axis_or_row_implies_is_held_as_nothing {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var o: Object = make(T.allocator_of(?t), ?riscv.RISCV64E);

    # clear compressed code is what leaving it unstated means, and the
    # embedded base is what the row fixes, so neither is held
    val clear: err[Fail] = state(?o, ?riscv.RISCV_RVC, Setting.flag{false});
    val base:  err[Fail] = state(?o, ?riscv.RISCV_RVE, Setting.flag{true});
    if (sel clear.err || sel base.err)      { ret 2; }
    if (table.count[Trait](?o.traits) != 0) { ret 2; }
    val held: opt[Setting] = effective(?o, ?riscv.RISCV_RVE);
    if (sel held.none)                              { ret 3; }
    if (!trait.same(held.some, Setting.flag{true})) { ret 3; }
    val unconstrained: opt[Setting] = effective(?o, ?riscv.RISCV_FLOAT_ABI);
    if (sel unconstrained.some) { ret 3; }

    # the full base contradicts the row
    val full: err[Fail] = state(?o, ?riscv.RISCV_RVE, Setting.flag{false});
    if (!sel full.err)                      { ret 4; }
    if (!sel full.err.cause.malformed)      { ret 4; }
    if (table.count[Trait](?o.traits) != 0) { ret 4; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
