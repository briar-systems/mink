# the bindings, visibilities and kinds of a neutral symbol, and the searches
# of a weak external's fallback
#
# each is a table of rows a format maps its own codes to, read through what a
# row declares.

use std.types.bool.bool;
use std.types.size.usize;
use std.types.string.str;

pub def Caps: u64;

# binding: other objects may refer to the symbol
pub val EXTERNAL: Caps = 0x1;
# binding: a strong definition elsewhere overrides it, and it may stay undefined
pub val WEAK: Caps = 0x2;
# binding: one definition is used across the whole process
pub val UNIQUE: Caps = 0x4;

# visibility: the symbol is exported from the image
pub val EXPORTED: Caps = 0x8;
# visibility: a definition in another image may preempt it
pub val PREEMPTIBLE: Caps = 0x10;

# kind: names code
pub val CODE: Caps = 0x20;
# kind: names data
pub val OBJECT: Caps = 0x40;
# kind: names a section
pub val SECTION: Caps = 0x80;
# kind: names the source file
pub val FILE: Caps = 0x100;
# kind: names thread-local data
pub val THREAD: Caps = 0x200;
# kind: a common block the linker allocates
pub val COMMON: Caps = 0x400;
# kind: names an entry of an index space
pub val ENTRY: Caps = 0x800;
# kind: names the cell the loader fills with another symbol's address, as a
# PE `__imp_` symbol names its import address table entry
pub val CELL: Caps = 0x2000;

# kind: names what a native caller of an image holding code of two
# conventions reaches an import through, as an ARM64EC import's auxiliary
# address cell and the `#` code that jumps through it do, apart from the
# cell and the code an emulated caller reaches it through
pub val NATIVE: Caps = 0x10000;

# search: the link pulls an archive member that defines the symbol before
# its fallback stands in
pub val PULLS: Caps = 0x4000;
# search: the fallback is followed one step only, never chained through a
# fallback of its own. a search without it chains, refusing a cycle
pub val UNCHAINED: Caps = 0x8000;

# how far a symbol is visible across objects
pub rec Binding {
    name: str;
    caps: Caps;
}

# how far a symbol is visible across images. merging two symbols keeps the
# visibility of higher rank
pub rec Visibility {
    name: str;
    caps: Caps;
    rank: u8;
}

# what a symbol names
pub rec Kind {
    name: str;
    caps: Caps;
}

# how the link looks for a definition of a weak external before its fallback
# stands in for it. the caps state what the link does, whatever the format's
# own words for the search
pub rec Search {
    name: str;
    caps: Caps;
}

pub val LOCAL:    Binding = Binding{name: "local", caps: 0};
pub val GLOBAL:   Binding = Binding{name: "global", caps: EXTERNAL};
pub val WEAKLY:   Binding = Binding{name: "weak", caps: EXTERNAL | WEAK};
pub val UNIQUELY: Binding = Binding{name: "unique", caps: EXTERNAL | UNIQUE};

pub val DEFAULT:   Visibility = Visibility{name: "default", caps: EXPORTED | PREEMPTIBLE, rank: 0};
pub val PROTECTED: Visibility = Visibility{name: "protected", caps: EXPORTED, rank: 1};
pub val HIDDEN:    Visibility = Visibility{name: "hidden", caps: 0, rank: 2};
pub val INTERNAL:  Visibility = Visibility{name: "internal", caps: 0, rank: 3};

pub val NOTYPE:   Kind = Kind{name: "notype", caps: 0};
pub val FUNCTION: Kind = Kind{name: "function", caps: CODE};
pub val DATA:     Kind = Kind{name: "data", caps: OBJECT};
pub val SECTIONS: Kind = Kind{name: "section", caps: SECTION};
pub val SOURCE:   Kind = Kind{name: "file", caps: FILE};
pub val TLS:      Kind = Kind{name: "tls", caps: OBJECT | THREAD};
pub val COMMONS:  Kind = Kind{name: "common", caps: OBJECT | COMMON};
pub val INDEXED:  Kind = Kind{name: "entry", caps: ENTRY};
pub val ADDRESS:  Kind = Kind{name: "address", caps: OBJECT | CELL};
# the cell and the code a native caller reaches an import through
pub val NATIVE_ADDRESS:  Kind = Kind{name: "native address", caps: OBJECT | CELL | NATIVE};
pub val NATIVE_FUNCTION: Kind = Kind{name: "native function", caps: CODE | NATIVE};

pub val NO_LIBRARY: Search = Search{name: "no library", caps: 0};
# a library search pulls an archive member that defines the name before the fallback stands in (PE format, auxiliary format 3: weak externals)
pub val LIBRARY:    Search = Search{name: "library", caps: PULLS};
pub val ALIAS:      Search = Search{name: "alias", caps: 0};
# an anti-dependency stands its fallback in for the name unless an input the
# link takes defines the name, and makes the link take nothing for it: the
# reference states no dependency on a definition of the name, as an ARM64EC
# plain name binds to its `#` definition unless an x64 definition of it is
# linked (ARM64EC function name decoration, overview of ARM64EC ABI
# conventions)
pub val ANTI_DEPENDENCY: Search = Search{name: "anti-dependency", caps: UNCHAINED};

val BINDING_COUNT:    usize                         = 4;
val BINDINGS:         [BINDING_COUNT]*Binding       = [BINDING_COUNT]*Binding{?LOCAL, ?GLOBAL, ?WEAKLY, ?UNIQUELY};
val VISIBILITY_COUNT: usize                         = 4;
val VISIBILITIES:     [VISIBILITY_COUNT]*Visibility = [VISIBILITY_COUNT]*Visibility{?DEFAULT, ?PROTECTED, ?HIDDEN, ?INTERNAL};
val KIND_COUNT:       usize                         = 11;
val SEARCH_COUNT:     usize                         = 4;
val SEARCH_ROWS:      [SEARCH_COUNT]*Search         = [SEARCH_COUNT]*Search{?NO_LIBRARY, ?LIBRARY, ?ALIAS, ?ANTI_DEPENDENCY};
val KINDS:            [KIND_COUNT]*Kind             = [KIND_COUNT]*Kind{
    ?NOTYPE, ?FUNCTION, ?DATA, ?SECTIONS, ?SOURCE, ?TLS, ?COMMONS, ?INDEXED, ?ADDRESS, ?NATIVE_ADDRESS, ?NATIVE_FUNCTION,
};

pub fun binding_count() usize {
    ret BINDING_COUNT;
}

pub fun binding_at(index: usize) *Binding {
    ret BINDINGS[index];
}

pub fun visibility_count() usize {
    ret VISIBILITY_COUNT;
}

pub fun visibility_at(index: usize) *Visibility {
    ret VISIBILITIES[index];
}

pub fun kind_count() usize {
    ret KIND_COUNT;
}

pub fun kind_at(index: usize) *Kind {
    ret KINDS[index];
}

pub fun search_count() usize {
    ret SEARCH_COUNT;
}

pub fun search_at(index: usize) *Search {
    ret SEARCH_ROWS[index];
}

pub fun binds(b: *Binding, c: Caps) bool {
    ret (b.caps & c) == c;
}

pub fun shows(v: *Visibility, c: Caps) bool {
    ret (v.caps & c) == c;
}

pub fun names(k: *Kind, c: Caps) bool {
    ret (k.caps & c) == c;
}

pub fun looks(s: *Search, c: Caps) bool {
    ret (s.caps & c) == c;
}

# the visibility two symbols merged into one carry: the more constraining
pub fun merged(a: *Visibility, b: *Visibility) *Visibility {
    if (b.rank > a.rank) { ret b; }
    ret a;
}
