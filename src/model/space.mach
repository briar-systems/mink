# the index spaces of the neutral model
#
# a module format that names its entries by index rather than by address, as
# wasm and SPIR-V do, keeps them in index spaces. each space is a row stating
# how a link numbers it, so the assign phase reads the row and never asks
# which format or space it is.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

# name:          the space's spelling in a diagnostic
# first:         the index its first entry takes
# last:          the highest index it holds, past which a link is refused
# imports_first: the entries a link keeps as imports take the lowest indexes,
#                before every definition, as wasm's do
pub rec Space {
    name:          str;
    first:         u64;
    last:          u64;
    imports_first: bool;
}

val WASM_LAST: u64 = 0xFFFF_FFFF;

pub val FUNCTIONS: Space = Space{name: "function", first: 0, last: WASM_LAST, imports_first: true};
pub val GLOBALS:   Space = Space{name: "global", first: 0, last: WASM_LAST, imports_first: true};
pub val TABLES:    Space = Space{name: "table", first: 0, last: WASM_LAST, imports_first: true};
pub val MEMORIES:  Space = Space{name: "memory", first: 0, last: WASM_LAST, imports_first: true};
pub val TAGS:      Space = Space{name: "tag", first: 0, last: WASM_LAST, imports_first: true};
pub val TYPES:     Space = Space{name: "type", first: 0, last: WASM_LAST, imports_first: false};
pub val SEGMENTS:  Space = Space{name: "data_segment", first: 0, last: WASM_LAST, imports_first: false};
pub val ELEMENTS:  Space = Space{name: "element_segment", first: 0, last: WASM_LAST, imports_first: false};
# SPIR-V result ids: zero is no id, and the module's bound, one past the
# highest, is a word
pub val IDS: Space = Space{name: "id", first: 1, last: 0xFFFF_FFFE, imports_first: false};

val ROW_COUNT: usize             = 9;
val ROWS:      [ROW_COUNT]*Space = [ROW_COUNT]*Space{
    ?FUNCTIONS, ?GLOBALS, ?TABLES, ?MEMORIES, ?TAGS, ?TYPES, ?SEGMENTS, ?ELEMENTS, ?IDS,
};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Space {
    ret ROWS[index];
}
