# the link claims an object carries for whoever links it
#
# a claim is a requirement of the object's link: a system library or a
# framework by name, or a local file by its path, with the kind a library
# named must be, whether the image loads it when no live import references
# it, the versions of a shared library where the producer states them, and
# the symbols it provides, each with whether the producer knows it as code or
# as data. a producer states them with a writer, one call per requirement,
# and the writer adds them to the object as one section named `.mink.claims`
# of the metadata kind, flagged excluded, so every image leaves it out and a
# format carries it as it carries any section the link drops. its bytes are
# the same on every format: a sequence of records, each a version byte, the
# form, the kind and the inclusion as one byte each, the name as a ULEB128
# length and its bytes, a byte that is one where the versions follow, the
# current and the compatibility version each as a ULEB128, then the number of
# symbols as a ULEB128 and each symbol as its sort byte, a length and its
# bytes. each record states its version, so sections a linker concatenated
# read as one sequence. no record relies on an address, so the section
# carries no relocation.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.vectors;
use mink.bytes.reader;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Section;
use mink.model.object.Versions;
use mink.model.section;

# the name of the section that holds an object's claims, on every format
pub val NAME: str = ".mink.claims";

# the record version this module writes and reads
pub val VERSION: u8 = 2;

# what a claim names
# ---
# system:    a library, found by its name in the library directories
# framework: a framework, found by its name in the framework directories
# local:     a file, at its path
pub tag Form: u8 {
    system;
    framework;
    local;
}

# the one kind a library a claim names by name must be, with no fallback
pub tag LibraryKind: u8 {
    shared;
    static;
}

# what the producer knows a symbol a claim provides to be
# ---
# unstated: nothing, as of a name a manifest attributes for an archive
# code:     a function
# data:     a variable
pub tag Sort: u8 {
    unstated;
    code;
    data;
}

# a symbol a claim provides
# ---
# name: its link name, as the object names it
# sort: what the producer knows it to be
pub rec Provided {
    name: View;
    sort: Sort;
}

# form:         what it names
# name:         the library's or framework's name, or the file's path
# kind:         the kind a library or framework must be, none for a local
#               file, whose contents state its kind. a producer stating none
#               for a library claims a shared one
# referenced:   the image loads the library only when a live import
#               references it, rather than whether or not one does
# versions:     the versions of a shared library, as a Mach-O load command
#               names them, none where the producer states none
# symbols:      the symbols it provides
# symbol_count: how many
# record:       the bytes of the record a claim was read from, which name it
#               whole, empty for a claim a producer states
pub rec Claim {
    form:         Form;
    name:         View;
    kind:         opt[LibraryKind];
    referenced:   bool;
    versions:     opt[Versions];
    symbols:      *Provided;
    symbol_count: usize;
    record:       View;
}

val FORM_SYSTEM:    u8 = 1;
val FORM_FRAMEWORK: u8 = 2;
val FORM_LOCAL:     u8 = 3;

val KIND_NONE:   u8 = 0;
val KIND_SHARED: u8 = 1;
val KIND_STATIC: u8 = 2;

val INCLUDE_ALWAYS:     u8 = 1;
val INCLUDE_REFERENCED: u8 = 2;

val SORT_UNSTATED: u8 = 0;
val SORT_CODE:     u8 = 1;
val SORT_DATA:     u8 = 2;

# what states an object's claims until they are added to it
# ---
# o:     the object they are added to
# out:   the records written so far
# count: how many
pub rec Writer {
    o:     *Object;
    out:   Sink;
    count: usize;
}

# a writer of the claims of `o`
pub fun writer(o: *Object) Writer {
    ret Writer{o: o, out: sink.make(o.a, LITTLE), count: 0};
}

# state the claim `c`. a name or symbol that is empty or holds a NUL is
# refused, as is a kind or versions stated for a local file. a refusal
# leaves `w` as it was
pub fun add(w: *Writer, c: *Claim) err[Fail] {
    val err_checked: err[Fail] = valid(c);
    if (sel err_checked.err) { ret err_checked; }
    val mark:       usize     = sink.len(?w.out);
    val err_record: err[Fail] = record(?w.out, c);
    if (sel err_record.err) {
        sink.truncate(?w.out, mark);
        ret err_record;
    }
    w.count = w.count + 1;
    ret err[Fail].ok{};
}

# add the claims `w` states to its object as one section, nothing for none,
# and give back what `w` holds. an object that holds a claims section already
# is refused and left as it was
pub fun finish(w: *Writer) err[Fail] {
    var err_added: err[Fail] = err[Fail].ok{};
    if (w.count != 0) { err_added = added(w); }
    ret fail.kept(err_added, sink.release(?w.out));
}

fun added(w: *Writer) err[Fail] {
    val o: *Object = w.o;
    var i: usize   = 0;
    for (i < table.count[Section](?o.sections)) {
        if (holds(o, object.section_at(o, table.nth[Section](i)))) {
            ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("the object holds its claims section already"), NAME), "section", i::u64)};
        }
        i = i + 1;
    }
    val res_name: res[Id[Name], Fail] = object.name_str(o, NAME);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    val res_held: res[object.Contents, Fail] = object.own(o, sink.data(?w.out), sink.len(?w.out));
    if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
    val res_add_section: res[Id[Section], Fail] = object.add_section(o, Section{
        name:        opt[Id[Name]].some{res_name.ok},
        kind:        ?section.METADATA,
        flags:       section.METADATA.flags | section.EXCLUDE,
        align:       1,
        contents:    res_held.ok,
        disposition: ?section.WHOLE,
    });
    if (sel res_add_section.err) { ret err[Fail].err{res_add_section.err}; }
    ret err[Fail].ok{};
}

fun valid(c: *Claim) err[Fail] {
    val err_named: err[Fail] = named(c.name, "a claim's name is empty", "a claim's name holds a NUL");
    if (sel err_named.err)                       { ret err_named; }
    if (sel c.form.local && sel c.kind.some)     { ret err[Fail].err{fail.malformed("a local claim names a file, whose contents state its kind")}; }
    if (sel c.form.local && sel c.versions.some) { ret err[Fail].err{fail.malformed("a local claim names a file, whose contents state its versions")}; }
    var i: usize = 0;
    for (i < c.symbol_count) {
        val err_named: err[Fail] = named(c.symbols[i].name, "a claimed symbol's name is empty", "a claimed symbol's name holds a NUL");
        if (sel err_named.err) { ret err[Fail].err{fail.in_indexed(err_named.err, "claimed symbol", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# `v` refused with `empty` when it is empty and with `nul` when it holds a NUL
fun named(v: View, empty: str, nul: str) err[Fail] {
    if (v.len == 0) { ret err[Fail].err{fail.malformed(empty)}; }
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == 0) { ret err[Fail].err{fail.at_offset(fail.malformed(nul), i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun record(out: *Sink, c: *Claim) err[Fail] {
    var form: u8 = FORM_SYSTEM;
    if (sel c.form.framework) { form = FORM_FRAMEWORK; }
    or (sel c.form.local)     { form = FORM_LOCAL; }
    var kind: u8 = KIND_SHARED;
    if (sel c.form.local)                          { kind = KIND_NONE; }
    or (sel c.kind.some && sel c.kind.some.static) { kind = KIND_STATIC; }
    var include: u8 = INCLUDE_ALWAYS;
    if (c.referenced) { include = INCLUDE_REFERENCED; }
    var err_u8: err[Fail] = sink.u8(out, VERSION);
    err_u8 = fail.kept(err_u8, sink.u8(out, form));
    err_u8 = fail.kept(err_u8, sink.u8(out, kind));
    err_u8 = fail.kept(err_u8, sink.u8(out, include));
    err_u8 = fail.kept(err_u8, spelled(out, c.name));
    val opt_versions: opt[Versions] = c.versions;
    if (sel opt_versions.some) {
        err_u8 = fail.kept(err_u8, sink.u8(out, 1));
        err_u8 = fail.kept(err_u8, sink.uleb(out, opt_versions.some.current::u64));
        err_u8 = fail.kept(err_u8, sink.uleb(out, opt_versions.some.compat::u64));
    }
    or { err_u8 = fail.kept(err_u8, sink.u8(out, 0)); }
    err_u8 = fail.kept(err_u8, sink.uleb(out, c.symbol_count::u64));
    var i: usize = 0;
    for (i < c.symbol_count && sel err_u8.ok) {
        var sort: u8 = SORT_UNSTATED;
        if (sel c.symbols[i].sort.code) { sort = SORT_CODE; }
        or (sel c.symbols[i].sort.data) { sort = SORT_DATA; }
        err_u8 = sink.u8(out, sort);
        err_u8 = fail.kept(err_u8, spelled(out, c.symbols[i].name));
        i      = i + 1;
    }
    ret err_u8;
}

fun spelled(out: *Sink, v: View) err[Fail] {
    val err_uleb: err[Fail] = sink.uleb(out, v.len::u64);
    if (sel err_uleb.err) { ret err_uleb; }
    ret sink.bytes(out, v.data, v.len);
}

# whether the section `s` of `o` holds claims
pub fun holds(o: *Object, s: *Section) bool {
    if (sel s.name.none) { ret false; }
    val v: View  = object.name_of(o, s.name.some);
    val n: usize = str_len(NAME);
    if (v.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != NAME[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the records of one claims section, read in order
# ---
# r:     what is left to read
# index: the next claim's index in the section
pub rec Records {
    r:     Reader;
    index: u64;
}

# the records of the claims section `s` of `o`, refused for a zero fill of
# any size, which holds no bytes to read
pub fun records(o: *Object, s: *Section) res[Records, Fail] {
    if (sel s.contents.zero && s.contents.zero != 0) { ret res[Records, Fail].err{fail.malformed("a claims section holds no bytes")}; }
    val b: Bytes = object.bytes(o, ?s.contents);
    ret res[Records, Fail].ok{Records{r: reader.make(nil, b.data, b.len, LITTLE)}};
}

# read the next claim of `rs` into `out`, its symbols held in `symbols`,
# which is emptied first and whose names they borrow, as the name and the
# record do, from the section's bytes, until either is next written. false at
# the end. a record cut short, of an unknown form, kind, inclusion or sort, of
# a kind or versions its form takes none of, or whose name or a symbol is
# empty or holds a NUL, is refused, as is a record of a later version
pub fun next(rs: *Records, out: *Claim, symbols: *Vector[Provided]) res[bool, Fail] {
    if (reader.remaining(?rs.r) == 0) { ret res[bool, Fail].ok{false}; }
    vector.clear[Provided](symbols);
    val start:       usize           = rs.r.pos;
    val res_decoded: res[bool, Fail] = decode(?rs.r, out, symbols);
    if (sel res_decoded.err) { ret res[bool, Fail].err{fail.in_indexed(res_decoded.err, "claim", rs.index)}; }
    out.record = View{data: ?rs.r.data[start], len: rs.r.pos - start};
    rs.index   = rs.index + 1;
    ret res_decoded;
}

fun decode(r: *Reader, out: *Claim, symbols: *Vector[Provided]) res[bool, Fail] {
    val res_version: res[u8, Fail] = reader.u8(r);
    if (sel res_version.err)       { ret res[bool, Fail].err{res_version.err}; }
    if (res_version.ok != VERSION) { ret res[bool, Fail].err{fail.valued(fail.unsupported("a claim of a version this link does not read"), res_version.ok::i128)}; }
    val res_form: res[u8, Fail] = reader.u8(r);
    if (sel res_form.err) { ret res[bool, Fail].err{res_form.err}; }
    val res_kind: res[u8, Fail] = reader.u8(r);
    if (sel res_kind.err) { ret res[bool, Fail].err{res_kind.err}; }
    val res_include: res[u8, Fail] = reader.u8(r);
    if (sel res_include.err) { ret res[bool, Fail].err{res_include.err}; }
    var c: Claim = Claim{};
    if (res_form.ok == FORM_SYSTEM)    { c.form = Form.system{}; }
    or (res_form.ok == FORM_FRAMEWORK) { c.form = Form.framework{}; }
    or (res_form.ok == FORM_LOCAL)     { c.form = Form.local{}; }
    or                                 { ret res[bool, Fail].err{fail.valued(fail.malformed("a claim of an unknown form"), res_form.ok::i128)}; }
    val local: bool = sel c.form.local;
    if (local && res_kind.ok == KIND_NONE)    { c.kind = opt[LibraryKind].none{}; }
    or (!local && res_kind.ok == KIND_SHARED) { c.kind = opt[LibraryKind].some{LibraryKind.shared{}}; }
    or (!local && res_kind.ok == KIND_STATIC) { c.kind = opt[LibraryKind].some{LibraryKind.static{}}; }
    or                                        { ret res[bool, Fail].err{fail.valued(fail.malformed("a claim states a kind its form does not take"), res_kind.ok::i128)}; }
    if (res_include.ok == INCLUDE_ALWAYS)     { c.referenced = false; }
    or (res_include.ok == INCLUDE_REFERENCED) { c.referenced = true; }
    or                                        { ret res[bool, Fail].err{fail.valued(fail.malformed("a claim of an unknown inclusion"), res_include.ok::i128)}; }
    val res_name: res[View, Fail] = read_spelled(r, "a claim's name is empty", "a claim's name holds a NUL");
    if (sel res_name.err) { ret res[bool, Fail].err{res_name.err}; }
    c.name = res_name.ok;
    val res_stated: res[u8, Fail] = reader.u8(r);
    if (sel res_stated.err) { ret res[bool, Fail].err{res_stated.err}; }
    if (res_stated.ok > 1)  { ret res[bool, Fail].err{fail.valued(fail.malformed("a claim's versions are neither stated nor left out"), res_stated.ok::i128)}; }
    if (res_stated.ok == 1) {
        if (local) { ret res[bool, Fail].err{fail.malformed("a local claim states versions, which its file's contents state")}; }
        val res_current: res[u32, Fail] = version_of(r);
        if (sel res_current.err) { ret res[bool, Fail].err{res_current.err}; }
        val res_compat: res[u32, Fail] = version_of(r);
        if (sel res_compat.err) { ret res[bool, Fail].err{res_compat.err}; }
        c.versions = opt[Versions].some{Versions{current: res_current.ok, compat: res_compat.ok}};
    }
    val res_count: res[u64, Fail] = reader.uleb(r);
    if (sel res_count.err)                       { ret res[bool, Fail].err{res_count.err}; }
    if (res_count.ok > reader.remaining(r)::u64) { ret res[bool, Fail].err{fail.valued(fail.truncated("a claim states more symbols than its bytes hold"), res_count.ok::i128)}; }
    var i: u64 = 0;
    for (i < res_count.ok) {
        val res_sym: res[Provided, Fail] = read_provided(r);
        if (sel res_sym.err) { ret res[bool, Fail].err{fail.in_indexed(res_sym.err, "claimed symbol", i)}; }
        val err_symbols_pushed: err[Fail] = vectors.push[Provided](symbols, res_sym.ok);
        if (sel err_symbols_pushed.err) { ret res[bool, Fail].err{err_symbols_pushed.err}; }
        i = i + 1;
    }
    c.symbols      = symbols.data;
    c.symbol_count = vector.length[Provided](symbols);
    @out           = c;
    ret res[bool, Fail].ok{true};
}

# a version a ULEB128 holds, refused past the 32 bits a load command holds
fun version_of(r: *Reader) res[u32, Fail] {
    val res_uleb: res[u64, Fail] = reader.uleb(r);
    if (sel res_uleb.err)          { ret res[u32, Fail].err{res_uleb.err}; }
    if (res_uleb.ok > 0xffff_ffff) { ret res[u32, Fail].err{fail.valued(fail.malformed("a claim's version does not fit in 32 bits"), res_uleb.ok::i128)}; }
    ret res[u32, Fail].ok{res_uleb.ok::u32};
}

fun read_provided(r: *Reader) res[Provided, Fail] {
    val res_sort: res[u8, Fail] = reader.u8(r);
    if (sel res_sort.err) { ret res[Provided, Fail].err{res_sort.err}; }
    var out: Provided = Provided{};
    if (res_sort.ok == SORT_UNSTATED) { out.sort = Sort.unstated{}; }
    or (res_sort.ok == SORT_CODE)     { out.sort = Sort.code{}; }
    or (res_sort.ok == SORT_DATA)     { out.sort = Sort.data{}; }
    or                                { ret res[Provided, Fail].err{fail.valued(fail.malformed("a claimed symbol of an unknown sort"), res_sort.ok::i128)}; }
    val res_name: res[View, Fail] = read_spelled(r, "a claimed symbol's name is empty", "a claimed symbol's name holds a NUL");
    if (sel res_name.err) { ret res[Provided, Fail].err{res_name.err}; }
    out.name = res_name.ok;
    ret res[Provided, Fail].ok{out};
}

fun read_spelled(r: *Reader, empty: str, nul: str) res[View, Fail] {
    val res_uleb: res[u64, Fail] = reader.uleb(r);
    if (sel res_uleb.err) { ret res[View, Fail].err{res_uleb.err}; }
    val res_bytes: res[*u8, Fail] = reader.bytes(r, res_uleb.ok);
    if (sel res_bytes.err) { ret res[View, Fail].err{res_bytes.err}; }
    val v:         View      = View{data: res_bytes.ok, len: res_uleb.ok::usize};
    val err_named: err[Fail] = named(v, empty, nul);
    if (sel err_named.err) { ret res[View, Fail].err{err_named.err}; }
    ret res[View, Fail].ok{v};
}
