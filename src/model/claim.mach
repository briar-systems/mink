# the link claims an object carries for whoever links it
#
# a claim is a requirement of the object's link: a system library or a
# framework by name, or a local file by its path, with the kind a library
# named must be, whether the image loads it when no live import references
# it, the versions of a shared library where the producer states them, and
# the symbols it provides, each with whether the producer knows it as code or
# as data. a producer states them with a writer, one call per requirement,
# and the writer adds them to the object as one section named `.mink.claims`
# of the metadata kind, flagged excluded, so every image leaves it out and a
# format carries it as it carries any section the link drops. its bytes are
# the same on every format: a sequence of records, each a version byte, the
# form, the kind and the inclusion as one byte each, the name as a ULEB128
# length and its bytes, a byte that is one where the versions follow, the
# current and the compatibility version each as a ULEB128, then the number of
# symbols as a ULEB128 and each symbol as its sort byte, a length and its
# bytes. each record states its version, so sections a linker concatenated
# read as one sequence. no record relies on an address, so the section
# carries no relocation.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.vectors;
use mink.bytes.reader;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Section;
use mink.model.object.Versions;
use mink.model.section;

# the name of the section that holds an object's claims, on every format
pub val NAME: str = ".mink.claims";

# the record version this module writes and reads
pub val VERSION: u8 = 2;

# what a claim names
# ---
# system:    a library, found by its name in the library directories
# framework: a framework, found by its name in the framework directories
# local:     a file, at its path
pub tag Form: u8 {
    system;
    framework;
    local;
}

# the one kind a library a claim names by name must be, with no fallback
pub tag LibraryKind: u8 {
    shared;
    static;
}

# what the producer knows a symbol a claim provides to be
# ---
# unstated: nothing, as of a name a manifest attributes for an archive
# code:     a function
# data:     a variable
pub tag Sort: u8 {
    unstated;
    code;
    data;
}

# a symbol a claim provides
# ---
# name: its link name, as the object names it
# sort: what the producer knows it to be
pub rec Provided {
    name: View;
    sort: Sort;
}

# form:         what it names
# name:         the library's or framework's name, or the file's path
# kind:         the kind a library or framework must be, none for a local
#               file, whose contents state its kind. a producer stating none
#               for a library claims a shared one
# referenced:   the image loads the library only when a live import
#               references it, rather than whether or not one does
# versions:     the versions of a shared library, as a Mach-O load command
#               names them, none where the producer states none
# symbols:      the symbols it provides
# symbol_count: how many
# record:       the bytes of the record a claim was read from, which name it
#               whole, empty for a claim a producer states
pub rec Claim {
    form:         Form;
    name:         View;
    kind:         opt[LibraryKind];
    referenced:   bool;
    versions:     opt[Versions];
    symbols:      *Provided;
    symbol_count: usize;
    record:       View;
}

val FORM_SYSTEM:    u8 = 1;
val FORM_FRAMEWORK: u8 = 2;
val FORM_LOCAL:     u8 = 3;

val KIND_NONE:   u8 = 0;
val KIND_SHARED: u8 = 1;
val KIND_STATIC: u8 = 2;

val INCLUDE_ALWAYS:     u8 = 1;
val INCLUDE_REFERENCED: u8 = 2;

val SORT_UNSTATED: u8 = 0;
val SORT_CODE:     u8 = 1;
val SORT_DATA:     u8 = 2;

# what states an object's claims until they are added to it
# ---
# o:     the object they are added to
# out:   the records written so far
# count: how many
pub rec Writer {
    o:     *Object;
    out:   Sink;
    count: usize;
}

# a writer of the claims of `o`
pub fun writer(o: *Object) Writer {
    ret Writer{o: o, out: sink.make(o.a, LITTLE), count: 0};
}

# state the claim `c`. a name or symbol that is empty or holds a NUL is
# refused, as is a kind or versions stated for a local file. a refusal
# leaves `w` as it was
pub fun add(w: *Writer, c: *Claim) err[Fail] {
    val checked: err[Fail] = valid(c);
    if (sel checked.err) { ret checked; }
    val mark: usize     = sink.len(?w.out);
    val r:    err[Fail] = record(?w.out, c);
    if (sel r.err) {
        sink.truncate(?w.out, mark);
        ret r;
    }
    w.count = w.count + 1;
    ret err[Fail].ok{};
}

# add the claims `w` states to its object as one section, nothing for none,
# and give back what `w` holds. an object that holds a claims section already
# is refused and left as it was
pub fun finish(w: *Writer) err[Fail] {
    var r: err[Fail] = err[Fail].ok{};
    if (w.count != 0) { r = added(w); }
    ret fail.kept(r, sink.release(?w.out));
}

fun added(w: *Writer) err[Fail] {
    val o: *Object = w.o;
    var i: usize   = 0;
    for (i < table.count[Section](?o.sections)) {
        if (holds(o, object.section_at(o, table.nth[Section](i)))) {
            ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("the object holds its claims section already"), NAME), "section", i::u64)};
        }
        i = i + 1;
    }
    val name: res[Id[Name], Fail] = object.name_str(o, NAME);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    val held: res[object.Contents, Fail] = object.own(o, sink.data(?w.out), sink.len(?w.out));
    if (sel held.err) { ret err[Fail].err{held.err}; }
    val s: res[Id[Section], Fail] = object.add_section(o, Section{
        name:        opt[Id[Name]].some{name.ok},
        kind:        ?section.METADATA,
        flags:       section.METADATA.flags | section.EXCLUDE,
        align:       1,
        contents:    held.ok,
        disposition: ?section.WHOLE,
    });
    if (sel s.err) { ret err[Fail].err{s.err}; }
    ret err[Fail].ok{};
}

fun valid(c: *Claim) err[Fail] {
    val n: err[Fail] = named(c.name, "a claim's name is empty", "a claim's name holds a NUL");
    if (sel n.err)                               { ret n; }
    if (sel c.form.local && sel c.kind.some)     { ret err[Fail].err{fail.malformed("a local claim names a file, whose contents state its kind")}; }
    if (sel c.form.local && sel c.versions.some) { ret err[Fail].err{fail.malformed("a local claim names a file, whose contents state its versions")}; }
    var i: usize = 0;
    for (i < c.symbol_count) {
        val s: err[Fail] = named(c.symbols[i].name, "a claimed symbol's name is empty", "a claimed symbol's name holds a NUL");
        if (sel s.err) { ret err[Fail].err{fail.in_indexed(s.err, "claimed symbol", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# `v` refused with `empty` when it is empty and with `nul` when it holds a NUL
fun named(v: View, empty: str, nul: str) err[Fail] {
    if (v.len == 0) { ret err[Fail].err{fail.malformed(empty)}; }
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == 0) { ret err[Fail].err{fail.at_offset(fail.malformed(nul), i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun record(out: *Sink, c: *Claim) err[Fail] {
    var form: u8 = FORM_SYSTEM;
    if (sel c.form.framework) { form = FORM_FRAMEWORK; }
    or (sel c.form.local)     { form = FORM_LOCAL; }
    var kind: u8 = KIND_SHARED;
    if (sel c.form.local)                          { kind = KIND_NONE; }
    or (sel c.kind.some && sel c.kind.some.static) { kind = KIND_STATIC; }
    var include: u8 = INCLUDE_ALWAYS;
    if (c.referenced) { include = INCLUDE_REFERENCED; }
    var r: err[Fail] = sink.u8(out, VERSION);
    r = fail.kept(r, sink.u8(out, form));
    r = fail.kept(r, sink.u8(out, kind));
    r = fail.kept(r, sink.u8(out, include));
    r = fail.kept(r, spelled(out, c.name));
    val v: opt[Versions] = c.versions;
    if (sel v.some) {
        r = fail.kept(r, sink.u8(out, 1));
        r = fail.kept(r, sink.uleb(out, v.some.current::u64));
        r = fail.kept(r, sink.uleb(out, v.some.compat::u64));
    }
    or { r = fail.kept(r, sink.u8(out, 0)); }
    r = fail.kept(r, sink.uleb(out, c.symbol_count::u64));
    var i: usize = 0;
    for (i < c.symbol_count && sel r.ok) {
        var sort: u8 = SORT_UNSTATED;
        if (sel c.symbols[i].sort.code) { sort = SORT_CODE; }
        or (sel c.symbols[i].sort.data) { sort = SORT_DATA; }
        r = sink.u8(out, sort);
        r = fail.kept(r, spelled(out, c.symbols[i].name));
        i = i + 1;
    }
    ret r;
}

fun spelled(out: *Sink, v: View) err[Fail] {
    val n: err[Fail] = sink.uleb(out, v.len::u64);
    if (sel n.err) { ret n; }
    ret sink.bytes(out, v.data, v.len);
}

# whether the section `s` of `o` holds claims
pub fun holds(o: *Object, s: *Section) bool {
    if (sel s.name.none) { ret false; }
    val v: View  = object.name_of(o, s.name.some);
    val n: usize = str_len(NAME);
    if (v.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != NAME[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the records of one claims section, read in order
# ---
# r:     what is left to read
# index: the next claim's index in the section
pub rec Records {
    r:     Reader;
    index: u64;
}

# the records of the claims section `s` of `o`, refused for a zero fill of
# any size, which holds no bytes to read
pub fun records(o: *Object, s: *Section) res[Records, Fail] {
    if (sel s.contents.zero && s.contents.zero != 0) { ret res[Records, Fail].err{fail.malformed("a claims section holds no bytes")}; }
    val b: Bytes = object.bytes(o, ?s.contents);
    ret res[Records, Fail].ok{Records{r: reader.make(nil, b.data, b.len, LITTLE)}};
}

# read the next claim of `rs` into `out`, its symbols held in `symbols`,
# which is emptied first and whose names they borrow, as the name and the
# record do, from the section's bytes, until either is next written. false at
# the end. a record cut short, of an unknown form, kind, inclusion or sort, of
# a kind or versions its form takes none of, or whose name or a symbol is
# empty or holds a NUL, is refused, as is a record of a later version
pub fun next(rs: *Records, out: *Claim, symbols: *Vector[Provided]) res[bool, Fail] {
    if (reader.remaining(?rs.r) == 0) { ret res[bool, Fail].ok{false}; }
    vector.clear[Provided](symbols);
    val start:   usize           = rs.r.pos;
    val decoded: res[bool, Fail] = decode(?rs.r, out, symbols);
    if (sel decoded.err) { ret res[bool, Fail].err{fail.in_indexed(decoded.err, "claim", rs.index)}; }
    out.record = View{data: ?rs.r.data[start], len: rs.r.pos - start};
    rs.index   = rs.index + 1;
    ret decoded;
}

fun decode(r: *Reader, out: *Claim, symbols: *Vector[Provided]) res[bool, Fail] {
    val version: res[u8, Fail] = reader.u8(r);
    if (sel version.err)       { ret res[bool, Fail].err{version.err}; }
    if (version.ok != VERSION) { ret res[bool, Fail].err{fail.valued(fail.unsupported("a claim of a version this link does not read"), version.ok::i128)}; }
    val form: res[u8, Fail] = reader.u8(r);
    if (sel form.err) { ret res[bool, Fail].err{form.err}; }
    val kind: res[u8, Fail] = reader.u8(r);
    if (sel kind.err) { ret res[bool, Fail].err{kind.err}; }
    val include: res[u8, Fail] = reader.u8(r);
    if (sel include.err) { ret res[bool, Fail].err{include.err}; }
    var c: Claim = Claim{};
    if (form.ok == FORM_SYSTEM)    { c.form = Form.system{}; }
    or (form.ok == FORM_FRAMEWORK) { c.form = Form.framework{}; }
    or (form.ok == FORM_LOCAL)     { c.form = Form.local{}; }
    or                             { ret res[bool, Fail].err{fail.valued(fail.malformed("a claim of an unknown form"), form.ok::i128)}; }
    val local: bool = sel c.form.local;
    if (local && kind.ok == KIND_NONE)    { c.kind = opt[LibraryKind].none{}; }
    or (!local && kind.ok == KIND_SHARED) { c.kind = opt[LibraryKind].some{LibraryKind.shared{}}; }
    or (!local && kind.ok == KIND_STATIC) { c.kind = opt[LibraryKind].some{LibraryKind.static{}}; }
    or                                    { ret res[bool, Fail].err{fail.valued(fail.malformed("a claim states a kind its form does not take"), kind.ok::i128)}; }
    if (include.ok == INCLUDE_ALWAYS)     { c.referenced = false; }
    or (include.ok == INCLUDE_REFERENCED) { c.referenced = true; }
    or                                    { ret res[bool, Fail].err{fail.valued(fail.malformed("a claim of an unknown inclusion"), include.ok::i128)}; }
    val name: res[View, Fail] = read_spelled(r, "a claim's name is empty", "a claim's name holds a NUL");
    if (sel name.err) { ret res[bool, Fail].err{name.err}; }
    c.name = name.ok;
    val stated: res[u8, Fail] = reader.u8(r);
    if (sel stated.err) { ret res[bool, Fail].err{stated.err}; }
    if (stated.ok > 1)  { ret res[bool, Fail].err{fail.valued(fail.malformed("a claim's versions are neither stated nor left out"), stated.ok::i128)}; }
    if (stated.ok == 1) {
        if (local) { ret res[bool, Fail].err{fail.malformed("a local claim states versions, which its file's contents state")}; }
        val current: res[u32, Fail] = version_of(r);
        if (sel current.err) { ret res[bool, Fail].err{current.err}; }
        val compat: res[u32, Fail] = version_of(r);
        if (sel compat.err) { ret res[bool, Fail].err{compat.err}; }
        c.versions = opt[Versions].some{Versions{current: current.ok, compat: compat.ok}};
    }
    val count: res[u64, Fail] = reader.uleb(r);
    if (sel count.err)                       { ret res[bool, Fail].err{count.err}; }
    if (count.ok > reader.remaining(r)::u64) { ret res[bool, Fail].err{fail.valued(fail.truncated("a claim states more symbols than its bytes hold"), count.ok::i128)}; }
    var i: u64 = 0;
    for (i < count.ok) {
        val sym: res[Provided, Fail] = read_provided(r);
        if (sel sym.err) { ret res[bool, Fail].err{fail.in_indexed(sym.err, "claimed symbol", i)}; }
        val p: err[Fail] = vectors.push[Provided](symbols, sym.ok);
        if (sel p.err) { ret res[bool, Fail].err{p.err}; }
        i = i + 1;
    }
    c.symbols      = symbols.data;
    c.symbol_count = vector.length[Provided](symbols);
    @out           = c;
    ret res[bool, Fail].ok{true};
}

# a version a ULEB128 holds, refused past the 32 bits a load command holds
fun version_of(r: *Reader) res[u32, Fail] {
    val v: res[u64, Fail] = reader.uleb(r);
    if (sel v.err)          { ret res[u32, Fail].err{v.err}; }
    if (v.ok > 0xffff_ffff) { ret res[u32, Fail].err{fail.valued(fail.malformed("a claim's version does not fit in 32 bits"), v.ok::i128)}; }
    ret res[u32, Fail].ok{v.ok::u32};
}

fun read_provided(r: *Reader) res[Provided, Fail] {
    val sort: res[u8, Fail] = reader.u8(r);
    if (sel sort.err) { ret res[Provided, Fail].err{sort.err}; }
    var out: Provided = Provided{};
    if (sort.ok == SORT_UNSTATED) { out.sort = Sort.unstated{}; }
    or (sort.ok == SORT_CODE)     { out.sort = Sort.code{}; }
    or (sort.ok == SORT_DATA)     { out.sort = Sort.data{}; }
    or                            { ret res[Provided, Fail].err{fail.valued(fail.malformed("a claimed symbol of an unknown sort"), sort.ok::i128)}; }
    val name: res[View, Fail] = read_spelled(r, "a claimed symbol's name is empty", "a claimed symbol's name holds a NUL");
    if (sel name.err) { ret res[Provided, Fail].err{name.err}; }
    out.name = name.ok;
    ret res[Provided, Fail].ok{out};
}

fun read_spelled(r: *Reader, empty: str, nul: str) res[View, Fail] {
    val n: res[u64, Fail] = reader.uleb(r);
    if (sel n.err) { ret res[View, Fail].err{n.err}; }
    val p: res[*u8, Fail] = reader.bytes(r, n.ok);
    if (sel p.err) { ret res[View, Fail].err{p.err}; }
    val v: View      = View{data: p.ok, len: n.ok::usize};
    val c: err[Fail] = named(v, empty, nul);
    if (sel c.err) { ret res[View, Fail].err{c.err}; }
    ret res[View, Fail].ok{v};
}
