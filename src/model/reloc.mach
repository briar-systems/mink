    ?MOVW_PREL_G2, ?MOVW_PREL_G2_NC, ?MOVW_PREL_G3, ?MOVW_SABS_G0, ?MOVW_SABS_G1, ?MOVW_SABS_G2,
    ?MOVW_UABS_G0, ?MOVW_UABS_G0_NC, ?MOVW_UABS_G1, ?MOVW_UABS_G1_NC, ?MOVW_UABS_G2, ?MOVW_UABS_G2_NC,
    ?MOVW_UABS_G3, ?NONE, ?PAGE21, ?PATCHINST, ?PC16, ?PC32, ?PC64, ?PC8, ?PCREL_HI20, ?PCREL_LO12_I,
    ?PCREL_LO12_S, ?PLT32, ?PLT_ABS32, ?PLTOFF64, ?RELATIVE, ?RELATIVE64, ?RELAX, ?REX_GOTPCREL32_RELAXABLE,
    ?RVA32, ?RVC_BRANCH, ?RVC_JUMP, ?SECREL32, ?SECTION16, ?SECTION_OFFSET_I32, ?SET16, ?SET32, ?SET6, ?SET8,
    ?SET_ULEB128, ?SIZE32, ?SIZE64, ?SUB16, ?SUB32, ?SUB6, ?SUB64, ?SUB8, ?SUB_ULEB128, ?TABLE_INDEX_I32,
    ?TABLE_INDEX_I64, ?TABLE_INDEX_SLEB, ?TABLE_INDEX_SLEB64, ?TABLE_NUMBER_LEB, ?TAG_INDEX_LEB, ?TLS_DESC,
    ?TLS_DESC_CALL, ?TLS_GD, ?TLS_GD_32, ?TLS_GD_CALL, ?TLS_GD_PCREL_HI20, ?TLS_GD_POP, ?TLS_GD_PUSH,
    ?TLS_GOT_PCREL_HI20, ?TLS_GOTDESC, ?TLS_GOTIE, ?TLS_IE, ?TLS_IE_32, ?TLS_LDM, ?TLS_LDM_32, ?TLS_LDM_CALL,
    ?TLS_LDM_POP, ?TLS_LDM_PUSH, ?TLSDESC, ?TLSDESC_ADD, ?TLSDESC_ADD_LO12, ?TLSDESC_ADR_PAGE21,
    ?TLSDESC_ADR_PREL21, ?TLSDESC_CALL, ?TLSDESC_HI20, ?TLSDESC_LD64_LO12, ?TLSDESC_LD_PREL19, ?TLSDESC_LDR,
    ?TLSDESC_OFF_G0_NC, ?TLSDESC_OFF_G1, ?TLSDESC_PCREL_ADD_LO12, ?TLSDESC_PCREL_CALL, ?TLSDESC_PCREL_LOAD_LO12, ?TLSGD32,
    ?TLSGD_ADD_LO12_NC, ?TLSGD_ADR_PAGE21, ?TLSGD_ADR_PREL21, ?TLSGD_MOVW_G0_NC, ?TLSGD_MOVW_G1,
    ?TLSIE_ADR_GOTTPREL_PAGE21, ?TLSIE_LD64_GOTTPREL_LO12_NC, ?TLSIE_LD_GOTTPREL_PREL19,
    ?TLSIE_MOVW_GOTTPREL_G0_NC, ?TLSIE_MOVW_GOTTPREL_G1, ?TLSLD32, ?TLSLD_ADD_DTPREL_HI12,
    ?TLSLD_ADD_DTPREL_LO12, ?TLSLD_ADD_DTPREL_LO12_NC, ?TLSLD_ADD_LO12_NC, ?TLSLD_ADR_PAGE21,
    ?TLSLD_ADR_PREL21, ?TLSLD_LD_PREL19, ?TLSLD_LDST128_DTPREL_LO12, ?TLSLD_LDST128_DTPREL_LO12_NC,
    ?TLSLD_LDST16_DTPREL_LO12, ?TLSLD_LDST16_DTPREL_LO12_NC, ?TLSLD_LDST32_DTPREL_LO12,
    ?TLSLD_LDST32_DTPREL_LO12_NC, ?TLSLD_LDST64_DTPREL_LO12, ?TLSLD_LDST64_DTPREL_LO12_NC,
    ?TLSLD_LDST8_DTPREL_LO12, ?TLSLD_LDST8_DTPREL_LO12_NC, ?TLSLD_MOVW_DTPREL_G0, ?TLSLD_MOVW_DTPREL_G0_NC,
    ?TLSLD_MOVW_DTPREL_G1, ?TLSLD_MOVW_DTPREL_G1_NC, ?TLSLD_MOVW_DTPREL_G2, ?TLSLD_MOVW_G0_NC, ?TLSLD_MOVW_G1,
    ?TLSLE_ADD_TPREL_HI12, ?TLSLE_ADD_TPREL_LO12, ?TLSLE_ADD_TPREL_LO12_NC, ?TLSLE_LDST128_TPREL_LO12,
    ?TLSLE_LDST128_TPREL_LO12_NC, ?TLSLE_LDST16_TPREL_LO12, ?TLSLE_LDST16_TPREL_LO12_NC,
    ?TLSLE_LDST32_TPREL_LO12, ?TLSLE_LDST32_TPREL_LO12_NC, ?TLSLE_LDST64_TPREL_LO12,
    ?TLSLE_LDST64_TPREL_LO12_NC, ?TLSLE_LDST8_TPREL_LO12, ?TLSLE_LDST8_TPREL_LO12_NC, ?TLSLE_MOVW_TPREL_G0,
    ?TLSLE_MOVW_TPREL_G0_NC, ?TLSLE_MOVW_TPREL_G1, ?TLSLE_MOVW_TPREL_G1_NC, ?TLSLE_MOVW_TPREL_G2, ?TPOFF32,
    ?TPOFF32_DYN, ?TPOFF32_REV, ?TPOFF32_REV_DYN, ?TPOFF64, ?TPREL_ADD, ?TPREL_HI20, ?TPREL_LO12_I,
    ?TPREL_LO12_S, ?TYPE_INDEX_LEB, ?VENDOR,
};

fun order_names(a: **Kind, b: **Kind) i64 {
    ret str_compare(a[0].name, b[0].name);
}

pub fun by_name(name: str) res[*Kind, Fail] {
    var probe: Kind       = Kind{name: name};
    val row:   opt[*Kind] = index.find[Kind](?NAMES[0], ROW_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*Kind, Fail].err{fail.unsupported("no relocation kind has this name")}; }
    ret res[*Kind, Fail].ok{row.some};
}

# whether `k` is a row of this catalog
pub fun member(k: *Kind) bool {
    if (k == nil) { ret false; }
    val row: res[*Kind, Fail] = by_name(k.name);
    if (sel row.err) { ret false; }
    ret row.ok == k;
}

pub fun has(k: *Kind, c: Caps) bool {
    ret (k.caps & c) == c;
}

# one basis, a second symbol exactly for differences, the linker-made
# entries only for values that reach a target by address, a marker carrying
# only what a marker may, and a target for every value computed from one
fun consistent(k: *Kind) bool {
    val basis: Caps = k.caps & BASES;
    if (basis == 0 || (basis & (basis - 1)) != 0)                        { ret false; }
    if (has(k, PAIR) != has(k, DIFF))                                    { ret false; }
    if ((k.caps & (GOT | PLT | PAGE)) != 0 && (basis & (ABS | PC)) == 0) { ret false; }
    if (has(k, MARKER) && (k.caps & ~(MARKER | MARKS_WITH)) != 0)        { ret false; }
    if (k.takes == nil || (!k.takes.named && !k.takes.nameless))         { ret false; }
    if (!k.takes.named && (basis & (MARKER | IMAGE)) == 0)               { ret false; }
    ret true;
}

# whether a relocation of kind `k` may refer to a target, or to none when
# `nameless`, as the kind's row states
pub fun allows_target(k: *Kind, nameless: bool) err[Fail] {
    if (!nameless && !k.takes.named)   { ret err[Fail].err{fail.about(fail.malformed("a relocation of a kind that takes no target refers to one"), k.name)}; }
    if (nameless && !k.takes.nameless) { ret err[Fail].err{fail.about(fail.malformed("a relocation of a kind that takes a target refers to none"), k.name)}; }
    ret err[Fail].ok{};
}

test reloc__a_kind_takes_the_targets_its_row_states {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val named: err[Fail] = allows_target(ROWS[i], false);
        val none:  err[Fail] = allows_target(ROWS[i], true);
        if ((sel named.ok) != ROWS[i].takes.named)   { ret 1; }
        if ((sel none.ok) != ROWS[i].takes.nameless) { ret 2; }
        i = i + 1;
    }
    if (TPREL_ADD.takes != ?NAMED || TLSDESC_CALL.takes != ?NAMED) { ret 3; }
    if (RELAX.takes != ?NAMELESS || NONE.takes != ?EITHER)         { ret 4; }
    ret 0;
}

val DUPLICATE_NAMES: [2]*Kind = [2]*Kind{?NONE, ?NONE};

test reloc__kinds_are_consistent_and_indexed {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        if (!member(ROWS[i]))     { ret 1; }
        val r: res[*Kind, Fail] = by_name(ROWS[i].name);
        if (sel r.err)       { ret 1; }
        if (r.ok != ROWS[i]) { ret 1; }
        i = i + 1;
    }
    val rows:  [ROW_COUNT]*Kind = ROWS;
    val built: err[Fail]        = index.verify[Kind](?NAMES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_names);
    if (sel built.err) { ret 1; }
    val miss: res[*Kind, Fail] = by_name("no_such_kind");
    if (sel miss.ok) { ret 1; }
    var copy: Kind = NONE;
    if (member(?copy) || member(nil)) { ret 1; }
    val bad: err[Fail] = index.verify[Kind](?DUPLICATE_NAMES[0], 2, ?rows[0], 2, order_names);
    if (sel bad.ok) { ret 1; }
    ret 0;
}

test reloc__a_marker_carries_only_what_a_marker_may {
    if (!consistent(?TLSDESC_PCREL_CALL) || !consistent(?COPY)) { ret 1; }
    var bit: Caps = 1;
    for (bit != 0) {
        if ((bit & (MARKER | MARKS_WITH)) == 0) {
            var k: Kind = Kind{name: "marker", caps: MARKER | bit, takes: ?NAMED};
            if (consistent(?k)) { ret 2; }
        }
        bit = bit << 1;
    }
    ret 0;
}
