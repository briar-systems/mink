# the relocation kinds of the neutral model
#
# a kind is what a relocation computes and asks of the linker. a format reads
# each of its relocation codes as one kind and writes each kind it maps as one
# code, and how a kind is applied to the bytes of one architecture is that
# pair's relocation table, whose rows state the direction of each mapping. this
# module holds the kind type, its capability vocabulary and the kinds every
# pair shares, the absolute, place-relative and difference forms of each
# width, a branch the link may route through a stub, a sign-extended
# absolute and the padded LEB128 of a symbol's value, and the kinds the pairs of one architecture family share, which
# each format of the family maps or refuses. a kind of one format or
# architecture is a row of the pair module that uses it, which lists it in its
# set.
#
# whether a kind reaches a linker-made entry and of which role is its slot,
# and which thread-local access model it serves is its tls. the GOT, PLT, TLS
# and model capabilities are read from those two, never stated beside them.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Family;
use mink.catalog.arch.aarch64;
use mink.catalog.slot;
use mink.catalog.slot.SlotRole;

pub def Caps: u64;

# the value a kind computes is relative to exactly one basis
# ---
# ABS:    the target's address, S+A
# PC:     the distance from the place, S+A-P
# IMAGE:  the distance from the image base
# SECREL: the offset within the target's section
# SECIDX: the index of the target's section
# DIFF:   the difference of two symbols, or one half of it whose pair
#         record names the other
# INDEX:  the target's index in its index space
# MARKER: nothing, the row marks the place for the linker
# SIZE:   the target's size
# GOTREL: the distance from the GOT base, which reaches no GOT entry and
#         the link fixes in any image
pub val ABS:    Caps = 0x1;
pub val PC:     Caps = 0x2;
pub val IMAGE:  Caps = 0x4;
pub val SECREL: Caps = 0x8;
pub val SECIDX: Caps = 0x10;
pub val DIFF:   Caps = 0x20;
pub val INDEX:  Caps = 0x40;
pub val MARKER: Caps = 0x80;
pub val SIZE:   Caps = 0x4000;
pub val GOTREL: Caps = 0x4000000;

# applied by the dynamic loader or start code, never patched by the linker
pub val LOADER: Caps = 0x8000;

# the target is reached through an entry the linker reserves and the code
# loads from, read from the kind's slot and never stated
pub val GOT: Caps = 0x100;
# the target may be reached through a PLT entry or a stub, read from the
# kind's slot and never stated
pub val PLT: Caps = 0x200;
# the value is a thread-local offset or descriptor, read from the kind's tls
# and never stated
pub val TLS: Caps = 0x400;
# the target is reached through an entry that holds it or stands for it, as a
# function table slot does, read from the kind's slot and never stated
pub val HELD: Caps = 0x40000;
# the thread-local access model the value serves, one per model, read from
# the kind's tls and never stated
pub val TLS_GD:   Caps = 0x80000;
pub val TLS_LD:   Caps = 0x100000;
pub val TLS_IE:   Caps = 0x200000;
pub val TLS_LE:   Caps = 0x400000;
pub val TLS_DESC: Caps = 0x800000;
pub val TLS_TLV:  Caps = 0x1000000;
pub val TLS_WIN:  Caps = 0x2000000;
# the value is taken at page granularity
pub val PAGE: Caps = 0x800;
# the relocation names a second symbol to subtract
pub val PAIR: Caps = 0x1000;
# the relocation needs a partner relocation at another place
pub val PARTNER: Caps = 0x2000;
# the linker may change the length of the code at the place, as relaxation
# deletes bytes, so a distance across it is known only once the link lays the
# section out
pub val RESIZES: Caps = 0x10000;
# the value is a pointer signed with a pointer authentication code
pub val AUTH: Caps = 0x20000;
# the place is a branch the link may send through a veneer it lays within the
# branch's reach, as it does for a target past that reach
pub val DETOURS: Caps = 0x8000000;

# every thread-local access model's capability
pub val TLS_MODELS: Caps = TLS_GD | TLS_LD | TLS_IE | TLS_LE | TLS_DESC | TLS_TLV | TLS_WIN;

# the capabilities read from a kind's slot and tls
val DERIVED: Caps = GOT | PLT | TLS | HELD | TLS_MODELS;

val BASES: Caps = ABS | PC | IMAGE | SECREL | SECIDX | DIFF | INDEX | MARKER | SIZE | GOTREL;

# the capabilities a marker may carry: a marker the loader applies, a marker
# whose target is its partner's place, and a marker that lets the linker
# resize the code it marks
val MARKS_WITH: Caps = LOADER | PARTNER | RESIZES;

# whether a relocation of a kind refers to a target, its symbol or section
# ---
# name:     the spelling in a dump
# named:    whether it may refer to one
# nameless: whether it may refer to none
pub rec Takes {
    name:     str;
    named:    bool;
    nameless: bool;
}

# the value is computed from the target, so there is one
pub val NAMED: Takes = Takes{name: "named", named: true, nameless: false};
# the value is computed from the place or the image alone, or the relocation
# marks its place, and it refers to nothing
pub val NAMELESS: Takes = Takes{name: "nameless", named: false, nameless: true};
# the target is optional: a marker that may name the symbol it keeps alive, or
# a loader value that stands for the image itself when it names none
pub val EITHER: Takes = Takes{name: "either", named: true, nameless: true};

# the thread-local access model a kind serves
# ---
# none: it is no thread-local access
# gd:   general dynamic, a module and offset pair resolved at run time
# ld:   local dynamic, the module of the image and an offset within its block
# ie:   initial exec, a thread pointer offset loaded from a slot
# le:   local exec, a thread pointer offset the link fixes
# desc: a descriptor whose resolver gives the offset
# tlv:  a Mach-O thread-local variable descriptor
# win:  the Windows TLS index and offset
pub tag Tls: u8 {
    none;
    gd;
    ld;
    ie;
    le;
    desc;
    tlv;
    win;
}

# name:  the kind's spelling
# caps:  what it computes and asks of the linker, the slot's and tls's
#        capabilities aside
# takes: whether it refers to a target
# tls:   the thread-local access model it serves
# slot:  the role of the linker-made entry it reaches, none for a kind that
#        reaches its target itself
pub rec Kind {
    name:  str;
    caps:  Caps;
    takes: *Takes;
    tls:   Tls;
    slot:  opt[*SlotRole];
}

pub val NONE:   Kind = Kind{name: "none", caps: MARKER, takes: ?EITHER};
pub val ABS8:   Kind = Kind{name: "abs8", caps: ABS, takes: ?NAMED};
pub val ABS16:  Kind = Kind{name: "abs16", caps: ABS, takes: ?NAMED};
pub val ABS32:  Kind = Kind{name: "abs32", caps: ABS, takes: ?NAMED};
pub val ABS64:  Kind = Kind{name: "abs64", caps: ABS, takes: ?NAMED};
pub val PC8:    Kind = Kind{name: "pc8", caps: PC, takes: ?NAMED};
pub val PC16:   Kind = Kind{name: "pc16", caps: PC, takes: ?NAMED};
pub val PC32:   Kind = Kind{name: "pc32", caps: PC, takes: ?NAMED};
pub val PC64:   Kind = Kind{name: "pc64", caps: PC, takes: ?NAMED};
pub val DIFF8:  Kind = Kind{name: "diff8", caps: DIFF | PAIR, takes: ?NAMED};
pub val DIFF16: Kind = Kind{name: "diff16", caps: DIFF | PAIR, takes: ?NAMED};
pub val DIFF32: Kind = Kind{name: "diff32", caps: DIFF | PAIR, takes: ?NAMED};
pub val DIFF64: Kind = Kind{name: "diff64", caps: DIFF | PAIR, takes: ?NAMED};
# a place-relative 32-bit branch or call the link may route through a stub it
# makes, as for a target another image defines or may interpose
pub val BRANCH32: Kind = Kind{name: "branch32", caps: PC, takes: ?NAMED, slot: opt[*SlotRole].some{?slot.PLT}};
# a 32-bit absolute the processor sign-extends to a wider address, as a
# displacement or an immediate of 64-bit code
pub val ABS32S: Kind = Kind{name: "abs32s", caps: ABS, takes: ?NAMED};

# the LEB128 of a symbol's value plus the addend, unsigned or signed, as a
# reference to a value only the writer or the link knows, such as a location
# view, takes it. the site is a LEB128 padded to a fixed width, the 32-bit
# kinds `LEB32_BYTES` bytes and the 64-bit ones `LEB64_BYTES`, so its size
# never changes once the producer lays it out. no format has a relocation for
# it: a writer folds the value of a symbol absolute when the object is written
# into the site, and the link writes the value it settled
pub val ULEB32: Kind = Kind{name: "uleb32", caps: ABS, takes: ?NAMED};
pub val ULEB64: Kind = Kind{name: "uleb64", caps: ABS, takes: ?NAMED};
pub val SLEB32: Kind = Kind{name: "sleb32", caps: ABS, takes: ?NAMED};
pub val SLEB64: Kind = Kind{name: "sleb64", caps: ABS, takes: ?NAMED};

# the bytes of the padded LEB128 site of a 32-bit and of a 64-bit LEB128 kind
pub val LEB32_BYTES: u8 = 5;
pub val LEB64_BYTES: u8 = 10;

# the kinds the AArch64 pairs share. a page offset is one kind per access: the
# add that takes the offset whole and a load or store of each size, which
# scales it, so a format that names the size in its code and one whose single
# code takes the size from the instruction read and write the same kinds
pub val PAGE21:        Kind = Kind{name: "page21", caps: PC | PAGE, takes: ?NAMED};
pub val LO12_ADD:      Kind = Kind{name: "lo12_add", caps: ABS, takes: ?NAMED};
pub val LO12_LDST8:    Kind = Kind{name: "lo12_ldst8", caps: ABS, takes: ?NAMED};
pub val LO12_LDST16:   Kind = Kind{name: "lo12_ldst16", caps: ABS, takes: ?NAMED};
pub val LO12_LDST32:   Kind = Kind{name: "lo12_ldst32", caps: ABS, takes: ?NAMED};
pub val LO12_LDST64:   Kind = Kind{name: "lo12_ldst64", caps: ABS, takes: ?NAMED};
pub val LO12_LDST128:  Kind = Kind{name: "lo12_ldst128", caps: ABS, takes: ?NAMED};
pub val JUMP26:        Kind = Kind{name: "jump26", caps: PC | DETOURS, takes: ?NAMED, slot: opt[*SlotRole].some{?slot.PLT}};
pub val CALL26:        Kind = Kind{name: "call26", caps: PC | DETOURS, takes: ?NAMED, slot: opt[*SlotRole].some{?slot.PLT}};
pub val BRANCH19:      Kind = Kind{name: "branch19", caps: PC, takes: ?NAMED};
pub val BRANCH14:      Kind = Kind{name: "branch14", caps: PC, takes: ?NAMED};
pub val LD_PREL_LO19:  Kind = Kind{name: "ld_prel_lo19", caps: PC, takes: ?NAMED};
pub val ADR_PREL_LO21: Kind = Kind{name: "adr_prel_lo21", caps: PC, takes: ?NAMED};
# the page of the target's GOT slot, and the slot's offset in it as an
# eight-byte load takes it
pub val GOT_PAGE21: Kind = Kind{name: "got_page21", caps: PC | PAGE, takes: ?NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val GOT_LO12:   Kind = Kind{name: "got_lo12", caps: ABS, takes: ?NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
# the TLS descriptor forms. the markers name the instructions of the sequence
# for the linker and serve no model themselves
pub val TLSDESC_LD_PREL19:  Kind = Kind{name: "tlsdesc_ld_prel19", caps: PC, takes: ?NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val TLSDESC_ADR_PREL21: Kind = Kind{name: "tlsdesc_adr_prel21", caps: PC, takes: ?NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val TLSDESC_ADR_PAGE21: Kind = Kind{name: "tlsdesc_adr_page21", caps: PC | PAGE, takes: ?NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val TLSDESC_LD64_LO12:  Kind = Kind{name: "tlsdesc_ld64_lo12", caps: ABS, takes: ?NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val TLSDESC_ADD_LO12:   Kind = Kind{name: "tlsdesc_add_lo12", caps: ABS, takes: ?NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val TLSDESC_OFF_G1:     Kind = Kind{name: "tlsdesc_off_g1", caps: ABS, takes: ?NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val TLSDESC_OFF_G0_NC:  Kind = Kind{name: "tlsdesc_off_g0_nc", caps: ABS, takes: ?NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val TLSDESC_LDR:        Kind = Kind{name: "tlsdesc_ldr", caps: MARKER, takes: ?NAMED};
pub val TLSDESC_ADD:        Kind = Kind{name: "tlsdesc_add", caps: MARKER, takes: ?NAMED};
# the initial exec forms, which load the thread pointer offset from its slot
pub val TLSIE_MOVW_GOTTPREL_G1:      Kind = Kind{name: "tlsie_movw_gottprel_g1", caps: ABS, takes: ?NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
pub val TLSIE_MOVW_GOTTPREL_G0_NC:   Kind = Kind{name: "tlsie_movw_gottprel_g0_nc", caps: ABS, takes: ?NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
pub val TLSIE_ADR_GOTTPREL_PAGE21:   Kind = Kind{name: "tlsie_adr_gottprel_page21", caps: PC | PAGE, takes: ?NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
pub val TLSIE_LD64_GOTTPREL_LO12_NC: Kind = Kind{name: "tlsie_ld64_gottprel_lo12_nc", caps: ABS, takes: ?NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
pub val TLSIE_LD_GOTTPREL_PREL19:    Kind = Kind{name: "tlsie_ld_gottprel_prel19", caps: PC, takes: ?NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
# the page of a thread-local variable's descriptor, and its offset in it as an
# eight-byte load takes it
pub val TLV_PAGE21: Kind = Kind{name: "tlv_page21", caps: PC | PAGE, takes: ?NAMED, tls: Tls.tlv{}};
pub val TLV_LO12:   Kind = Kind{name: "tlv_lo12", caps: ABS, takes: ?NAMED, tls: Tls.tlv{}};
# the offset of a thread-local variable in its section, which the Windows
# model adds to the thread's block: the upper twelve bits as an add takes
# them, and the lower twelve per access as the page offsets are
pub val SECREL_HI12:         Kind = Kind{name: "secrel_hi12", caps: SECREL, takes: ?NAMED, tls: Tls.win{}};
pub val SECREL_LO12_ADD:     Kind = Kind{name: "secrel_lo12_add", caps: SECREL, takes: ?NAMED, tls: Tls.win{}};
pub val SECREL_LO12_LDST8:   Kind = Kind{name: "secrel_lo12_ldst8", caps: SECREL, takes: ?NAMED, tls: Tls.win{}};
pub val SECREL_LO12_LDST16:  Kind = Kind{name: "secrel_lo12_ldst16", caps: SECREL, takes: ?NAMED, tls: Tls.win{}};
pub val SECREL_LO12_LDST32:  Kind = Kind{name: "secrel_lo12_ldst32", caps: SECREL, takes: ?NAMED, tls: Tls.win{}};
pub val SECREL_LO12_LDST64:  Kind = Kind{name: "secrel_lo12_ldst64", caps: SECREL, takes: ?NAMED, tls: Tls.win{}};
pub val SECREL_LO12_LDST128: Kind = Kind{name: "secrel_lo12_ldst128", caps: SECREL, takes: ?NAMED, tls: Tls.win{}};

# every capability of `k`: its stated ones, GOT, PLT or HELD as its slot is
# loaded from, called or holds the target, and TLS and its model's capability
# when it serves a thread-local access
pub fun caps(k: *Kind) Caps {
    var c: Caps = k.caps | model(k.tls);
    if (!sel k.tls.none) { c = c | TLS; }
    if (sel k.slot.some) {
        val r: *SlotRole = k.slot.some;
        if (sel r.reach.loaded) { c = c | GOT; }
        or (sel r.reach.called) { c = c | PLT; }
        or                      { c = c | HELD; }
    }
    ret c;
}

# the capability of the thread-local access model `t`, none for no access
fun model(t: Tls) Caps {
    if (sel t.gd)   { ret TLS_GD; }
    or (sel t.ld)   { ret TLS_LD; }
    or (sel t.ie)   { ret TLS_IE; }
    or (sel t.le)   { ret TLS_LE; }
    or (sel t.desc) { ret TLS_DESC; }
    or (sel t.tlv)  { ret TLS_TLV; }
    or (sel t.win)  { ret TLS_WIN; }
    ret 0;
}

pub fun has(k: *Kind, c: Caps) bool {
    ret (caps(k) & c) == c;
}

# one basis, a second symbol only for differences, the linker-made
# entries only for values that reach a target by address, a marker carrying
# only what a marker may, a target for every value computed from one, and no
# capability stated that the slot or tls owns
pub fun consistent(k: *Kind) bool {
    if ((k.caps & DERIVED) != 0) { ret false; }
    val all:   Caps = caps(k);
    val basis: Caps = all & BASES;
    if (basis == 0 || (basis & (basis - 1)) != 0)                     { ret false; }
    if ((all & PAIR) != 0 && (all & DIFF) == 0)                       { ret false; }
    if ((all & (GOT | PLT | PAGE)) != 0 && (basis & (ABS | PC)) == 0) { ret false; }
    if ((all & MARKER) != 0 && (all & ~(MARKER | MARKS_WITH)) != 0)   { ret false; }
    if (k.takes == nil || (!k.takes.named && !k.takes.nameless))      { ret false; }
    if (!k.takes.named && (basis & (MARKER | IMAGE)) == 0)            { ret false; }
    ret true;
}

# the absolute kind of a field of `bytes` bytes, refused for a width no
# absolute kind holds
pub fun absolute_of(bytes: u8) res[*Kind, Fail] {
    if (bytes == 4) { ret res[*Kind, Fail].ok{?ABS32}; }
    if (bytes == 8) { ret res[*Kind, Fail].ok{?ABS64}; }
    ret res[*Kind, Fail].err{fail.valued(fail.unsupported("no absolute relocation kind holds a field of this size"), bytes::i128)};
}

# the place-relative kind of a field of `bytes` bytes, refused for a width
# no place-relative kind holds
pub fun relative_of(bytes: u8) res[*Kind, Fail] {
    if (bytes == 2) { ret res[*Kind, Fail].ok{?PC16}; }
    if (bytes == 4) { ret res[*Kind, Fail].ok{?PC32}; }
    if (bytes == 8) { ret res[*Kind, Fail].ok{?PC64}; }
    ret res[*Kind, Fail].err{fail.valued(fail.unsupported("no place-relative relocation kind holds a field of this size"), bytes::i128)};
}

# whether a relocation of kind `k` may refer to a target, or to none when
# `nameless`, as the kind's row states
pub fun allows_target(k: *Kind, nameless: bool) err[Fail] {
    if (!nameless && !k.takes.named)   { ret err[Fail].err{fail.about(fail.malformed("a relocation of a kind that takes no target refers to one"), k.name)}; }
    if (nameless && !k.takes.nameless) { ret err[Fail].err{fail.about(fail.malformed("a relocation of a kind that takes a target refers to none"), k.name)}; }
    ret err[Fail].ok{};
}

# the kinds every pair shares, each of which every pair maps or refuses
pub val NEUTRAL_COUNT: usize                = 19;
pub val NEUTRAL:       [NEUTRAL_COUNT]*Kind = [NEUTRAL_COUNT]*Kind{
    ?NONE, ?ABS8, ?ABS16, ?ABS32, ?ABS64, ?PC8, ?PC16, ?PC32, ?PC64, ?DIFF8, ?DIFF16, ?DIFF32, ?DIFF64, ?BRANCH32, ?ABS32S,
    ?ULEB32, ?ULEB64, ?SLEB32, ?SLEB64,
};

val AARCH64_COUNT: usize                = 38;
val AARCH64_KINDS: [AARCH64_COUNT]*Kind = [AARCH64_COUNT]*Kind{
    ?PAGE21, ?LO12_ADD, ?LO12_LDST8, ?LO12_LDST16, ?LO12_LDST32, ?LO12_LDST64, ?LO12_LDST128, ?JUMP26, ?CALL26, ?BRANCH19,
    ?BRANCH14, ?LD_PREL_LO19, ?ADR_PREL_LO21, ?GOT_PAGE21, ?GOT_LO12, ?TLSDESC_LD_PREL19, ?TLSDESC_ADR_PREL21,
    ?TLSDESC_ADR_PAGE21, ?TLSDESC_LD64_LO12, ?TLSDESC_ADD_LO12, ?TLSDESC_OFF_G1, ?TLSDESC_OFF_G0_NC, ?TLSDESC_LDR,
    ?TLSDESC_ADD, ?TLSIE_MOVW_GOTTPREL_G1, ?TLSIE_MOVW_GOTTPREL_G0_NC, ?TLSIE_ADR_GOTTPREL_PAGE21,
    ?TLSIE_LD64_GOTTPREL_LO12_NC, ?TLSIE_LD_GOTTPREL_PREL19, ?TLV_PAGE21, ?TLV_LO12, ?SECREL_HI12, ?SECREL_LO12_ADD,
    ?SECREL_LO12_LDST8, ?SECREL_LO12_LDST16, ?SECREL_LO12_LDST32, ?SECREL_LO12_LDST64, ?SECREL_LO12_LDST128,
};

# the kinds the pairs of one architecture family share besides the kinds
# every pair shares, each of which every pair of the family maps or refuses
# ---
# family: the architecture family
# kinds:  the kinds, static
# count:  how many
pub rec Shared {
    family: *Family;
    kinds:  **Kind;
    count:  usize;
}

pub val SHARED_COUNT: usize                = 1;
pub val SHARED:       [SHARED_COUNT]Shared = [SHARED_COUNT]Shared{
    Shared{family: ?aarch64.AARCH64_FAMILY, kinds: ?AARCH64_KINDS[0], count: AARCH64_COUNT},
};

# the kinds the family of `a` shares besides every pair's, none when it
# shares no more
pub fun shared_by(a: *Arch) opt[*Shared] {
    var i: usize = 0;
    for (i < SHARED_COUNT) {
        if (SHARED[i].family == a.family) { ret opt[*Shared].some{?SHARED[i]}; }
        i = i + 1;
    }
    ret opt[*Shared].none{};
}

# whether every pair of the architecture `a` maps or refuses `k`: a kind every
# pair shares, or one its family shares
pub fun neutral_for(a: *Arch, k: *Kind) bool {
    var i: usize = 0;
    for (i < NEUTRAL_COUNT) {
        if (NEUTRAL[i] == k) { ret true; }
        i = i + 1;
    }
    val s: opt[*Shared] = shared_by(a);
    if (sel s.none) { ret false; }
    val f: *Shared = s.some;
    i = 0;
    for (i < f.count) {
        if (f.kinds[i] == k) { ret true; }
        i = i + 1;
    }
    ret false;
}

test reloc__shared_kinds_are_consistent_and_take_the_targets_they_state {
    var i: usize = 0;
    for (i < NEUTRAL_COUNT) {
        val k: *Kind = NEUTRAL[i];
        if (!consistent(k)) { ret 1; }
        val named: err[Fail] = allows_target(k, false);
        val none:  err[Fail] = allows_target(k, true);
        if ((sel named.ok) != k.takes.named)   { ret 2; }
        if ((sel none.ok) != k.takes.nameless) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

val GOT_LOAD:  Kind = Kind{name: "got load", caps: PC, takes: ?NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
val PLT_CALL:  Kind = Kind{name: "plt call", caps: PC, takes: ?NAMED, slot: opt[*SlotRole].some{?slot.PLT}};
val GD_LOAD:   Kind = Kind{name: "gd load", caps: PC, takes: ?NAMED, tls: Tls.gd{}, slot: opt[*SlotRole].some{?slot.TLS_GD}};
val LE_VALUE:  Kind = Kind{name: "le value", caps: ABS, takes: ?NAMED, tls: Tls.le{}};
val STATED:    Kind = Kind{name: "stated got", caps: PC | GOT, takes: ?NAMED};
val HELD_SLOT: Kind = Kind{name: "held", caps: INDEX, takes: ?NAMED, slot: opt[*SlotRole].some{?slot.FUNCTION_TABLE}};

test reloc__got_plt_held_and_tls_are_read_from_the_slot_and_tls {
    if (!has(?GOT_LOAD, GOT) || has(?GOT_LOAD, PLT) || has(?GOT_LOAD, TLS))     { ret 1; }
    if (!has(?PLT_CALL, PLT) || has(?PLT_CALL, GOT))                            { ret 2; }
    if (!has(?GD_LOAD, GOT | TLS) || has(?GD_LOAD, PLT))                        { ret 3; }
    if (!has(?LE_VALUE, TLS) || has(?LE_VALUE, GOT))                            { ret 4; }
    if (has(?HELD_SLOT, GOT) || has(?HELD_SLOT, PLT) || !has(?HELD_SLOT, HELD)) { ret 5; }
    if (!consistent(?GOT_LOAD) || !consistent(?GD_LOAD) || consistent(?STATED)) { ret 6; }
    ret 0;
}

test reloc__a_marker_carries_only_what_a_marker_may {
    if (!consistent(?NONE)) { ret 1; }
    var bit: Caps = 1;
    for (bit != 0) {
        if ((bit & (MARKER | MARKS_WITH | DERIVED)) == 0) {
            var k: Kind = Kind{name: "marker", caps: MARKER | bit, takes: ?NAMED};
            if (consistent(?k)) { ret 2; }
        }
        bit = bit << 1;
    }
    ret 0;
}
