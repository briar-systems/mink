# the section kinds of the neutral model and the flags a section carries
#
# a kind is the role a section plays, a row a format maps its own section
# types and flags to, and names its use: whether a link lays the section out
# as image content or takes it some other way. the linker reads what a row
# declares and never which row it is.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;

use mink.base.fail;
use mink.base.fail.Fail;

pub def Flags: u64;

# occupies memory in the image
pub val ALLOC: Flags = 0x1;
# writable at run time
pub val WRITE: Flags = 0x2;
# holds code
pub val EXEC: Flags = 0x4;
# kept by garbage collection whether referenced or not
pub val RETAIN: Flags = 0x8;
# equal entries of the section's entry size may be merged
pub val MERGE: Flags = 0x10;
# entries are NUL-terminated strings
pub val STRINGS: Flags = 0x20;
# thread-local storage
pub val TLS: Flags = 0x40;

pub def Roles: u64;

# carries bytes in the file, rather than only a zero-fill size
pub val BITS: Roles = 0x1;
# read only once relocations are applied at load
pub val RELRO: Roles = 0x2;
# call frame or unwind tables
pub val UNWIND: Roles = 0x4;
# debugging information
pub val DEBUG: Roles = 0x8;
# a system note
pub val NOTE: Roles = 0x10;
# a table of functions run before the entry
pub val INIT: Roles = 0x20;
# a table of functions run at exit
pub val FINI: Roles = 0x40;
# a table of functions run before any shared object's initializers
pub val PREINIT: Roles = 0x80;

# what a link does with a section of a kind
# ---
# name:   the use's spelling in a diagnostic
# placed: the section's bytes are image content, laid out where its kind and
#         flags put them. a use that is not placed is taken by the link's own
#         row for it, and one the link has no row for is refused
pub rec Use {
    name:   str;
    placed: bool;
}

pub val CONTENT: Use = Use{name: "content", placed: true};
# which symbols have their address taken, by symbol table index, which code
# folding reads and which means nothing once the link renumbers the symbols
pub val SIGNIFICANCE: Use = Use{name: "address significance"};
# NUL-terminated strings naming the tools that made the object, merged so the
# image holds each distinct one once
pub val IDENTIFICATION: Use = Use{name: "identification"};
# what the stack must allow, stated by the section's flags: an executable
# stack by EXEC
pub val STACK: Use = Use{name: "stack"};
# records the link reads to build the image's own unwind table, such as
# Mach-O compact unwind or COFF function tables, cut into one record per
# function described
pub val CONSUMED_UNWIND: Use = Use{name: "consumed unwind"};
# a text the link reports when its symbol is referenced
pub val WARNING: Use = Use{name: "link warning"};

# the element sizes a kind is keyed by, bit w set for a size of w bytes
pub def Widths: u64;

# what makes two entries of a kind equal
# ---
# bytes:  their bytes, so a section that carries relocations is not cut, its
#         bytes alone not saying what its entries hold
# target: the one relocation each entry carries at its start, by the target
#         it reaches and its addend, so an entry that carries none, carries
#         more or carries one elsewhere is refused
pub tag Equal: u8 {
    bytes;
    target;
}

# how a section of mergeable entries is cut into entries, the rule its kind
# states, so a link merges a section by its kind and never by its format
# ---
# name:  the rule's spelling in a diagnostic
# cut:   the entry that starts `offset` bytes into the `len` bytes at
#        `data`, whose elements are `width` bytes, in a section aligned to
#        `align`, refused when the bytes left hold no whole entry
# equal: what makes two entries equal
# tails: an entry may be kept as the tail of a longer one ending in the same
#        elements, as a string may
pub rec Entries {
    name:  str;
    cut:   fun(*u8, u64, u64, u64, u64) res[Entry, Fail];
    equal: Equal;
    tails: bool;
}

# an entry as its rule cuts it
# ---
# size:    its size, its terminator included
# padding: the bytes after it that only align the next entry, which are no
#          entry of their own
pub rec Entry {
    size:    u64;
    padding: u64;
}

# strings of elements, each ending with its first element that is all zero
pub val STRING_ENTRIES: Entries = Entries{name: "strings", cut: string_entry, equal: Equal.bytes{}, tails: true};
# constants of one element each
pub val CONSTANT_ENTRIES: Entries = Entries{name: "constants", cut: constant_entry, equal: Equal.bytes{}, tails: false};
# pointers of one element each, equal when they point at the same target
pub val POINTER_ENTRIES: Entries = Entries{name: "pointers", cut: pointer_entry, equal: Equal.target{}, tails: false};

# a string, and the zero elements after it up to the next offset the
# section's alignment allows, as the assemblers pad an aligned string with
fun string_entry(data: *u8, len: u64, offset: u64, width: u64, align: u64) res[Entry, Fail] {
    var at: u64 = offset;
    for (width != 0 && at <= len && len - at >= width) {
        val zero: bool = zero_element(data, at, width);
        at = at + width;
        if (zero) {
            var end: u64 = at;
            for (align != 0 && end % align != 0 && len - end >= width && zero_element(data, end, width)) {
                end = end + width;
            }
            ret res[Entry, Fail].ok{Entry{size: at - offset, padding: end - at}};
        }
    }
    ret res[Entry, Fail].err{fail.at_offset(fail.malformed("a merged string is not terminated"), offset)};
}

# whether the element of `width` bytes at `at` is all zero
fun zero_element(data: *u8, at: u64, width: u64) bool {
    var i: u64 = 0;
    for (i < width) {
        if (data[(at + i)::usize] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun constant_entry(data: *u8, len: u64, offset: u64, width: u64, align: u64) res[Entry, Fail] {
    ret element(len, offset, width, "a merged constant runs past its section");
}

fun pointer_entry(data: *u8, len: u64, offset: u64, width: u64, align: u64) res[Entry, Fail] {
    ret element(len, offset, width, "a merged pointer runs past its section");
}

# the one element of `width` bytes at `offset` of `len` bytes, refused with
# `text` when the bytes left hold none
fun element(len: u64, offset: u64, width: u64, text: str) res[Entry, Fail] {
    if (width == 0 || offset > len || len - offset < width) {
        ret res[Entry, Fail].err{fail.at_offset(fail.malformed(text), offset)};
    }
    ret res[Entry, Fail].ok{Entry{size: width}};
}

# name:    the kind's spelling in a dump
# flags:   the flags a section of this kind starts with
# roles:   what the kind is to the linker
# use:     what a link does with a section of the kind
# widths:  the element sizes a section of the kind may hold, its entsize, for
#          a kind a format names from its element size as well, zero for a
#          kind keyed by none
# joins:   the kind whose output section a link lays a section of the kind
#          into, as merged strings are read-only data, nil for a kind whose
#          sections make their own
# entries: how a link cuts a section of the kind into the entries it merges,
#          nil for a kind whose sections a link places whole
pub rec Kind {
    name:    str;
    flags:   Flags;
    roles:   Roles;
    use:     *Use;
    widths:  Widths;
    joins:   *Kind;
    entries: *Entries;
}

pub val TEXT:          Kind = Kind{name: "text", flags: ALLOC | EXEC, roles: BITS, use: ?CONTENT};
pub val RODATA:        Kind = Kind{name: "rodata", flags: ALLOC, roles: BITS, use: ?CONTENT};
pub val DATA:          Kind = Kind{name: "data", flags: ALLOC | WRITE, roles: BITS, use: ?CONTENT};
pub val RELRO_DATA:    Kind = Kind{name: "relro", flags: ALLOC | WRITE, roles: BITS | RELRO, use: ?CONTENT};
pub val BSS:           Kind = Kind{name: "bss", flags: ALLOC | WRITE, roles: 0, use: ?CONTENT};
pub val TLS_DATA:      Kind = Kind{name: "tdata", flags: ALLOC | WRITE | TLS, roles: BITS, use: ?CONTENT};
pub val TLS_BSS:       Kind = Kind{name: "tbss", flags: ALLOC | WRITE | TLS, roles: 0, use: ?CONTENT};
pub val INIT_ARRAY:    Kind = Kind{name: "init_array", flags: ALLOC | WRITE, roles: BITS | RELRO | INIT, use: ?CONTENT};
pub val FINI_ARRAY:    Kind = Kind{name: "fini_array", flags: ALLOC | WRITE, roles: BITS | RELRO | FINI, use: ?CONTENT};
pub val PREINIT_ARRAY: Kind = Kind{name: "preinit_array", flags: ALLOC | WRITE, roles: BITS | RELRO | PREINIT, use: ?CONTENT};
pub val UNWIND_INFO:   Kind = Kind{name: "unwind", flags: ALLOC, roles: BITS | UNWIND, use: ?CONTENT};
pub val NOTE_INFO:     Kind = Kind{name: "note", flags: ALLOC, roles: BITS | NOTE, use: ?CONTENT};
pub val DEBUG_INFO:    Kind = Kind{name: "debug", flags: 0, roles: BITS | DEBUG, use: ?CONTENT};
# bytes no image loads and no rule above names, such as a wasm custom section
pub val METADATA:        Kind = Kind{name: "metadata", flags: 0, roles: BITS, use: ?CONTENT};
pub val ADDRSIG_TABLE:   Kind = Kind{name: "addrsig", flags: 0, roles: BITS, use: ?SIGNIFICANCE};
pub val COMMENT_STRINGS: Kind = Kind{name: "comment", flags: MERGE | STRINGS, roles: BITS, use: ?IDENTIFICATION};
pub val STACK_NOTE:      Kind = Kind{name: "stack", flags: 0, roles: BITS, use: ?STACK};
pub val UNWIND_RECORDS:  Kind = Kind{name: "unwind records", flags: 0, roles: BITS | UNWIND, use: ?CONSUMED_UNWIND};
pub val LINK_WARNING:    Kind = Kind{name: "warning", flags: 0, roles: BITS, use: ?WARNING};
# loaded read-only NUL-terminated strings of 1, 2 or 4 byte elements whose
# addresses do not matter, so equal ones may be merged
pub val MERGED_STRINGS: Kind = Kind{name: "merged strings", flags: ALLOC | MERGE | STRINGS, roles: BITS, use: ?CONTENT, widths: (1u64 << 1) | (1u64 << 2) | (1u64 << 4), joins: ?RODATA, entries: ?STRING_ENTRIES};
# loaded read-only constants of 4, 8, 16 or 32 bytes whose addresses do not
# matter, so equal ones may be merged
pub val MERGED_CONSTANTS: Kind = Kind{name: "merged constants", flags: ALLOC | MERGE, roles: BITS, use: ?CONTENT, widths: (1u64 << 4) | (1u64 << 8) | (1u64 << 16) | (1u64 << 32), joins: ?RODATA, entries: ?CONSTANT_ENTRIES};
# loaded pointers of 4 or 8 bytes, each relocated to its target, whose
# addresses do not matter, so pointers to one target may be merged
pub val MERGED_POINTERS: Kind = Kind{name: "merged pointers", flags: ALLOC | WRITE | MERGE, roles: BITS, use: ?CONTENT, widths: (1u64 << 4) | (1u64 << 8), joins: ?DATA, entries: ?POINTER_ENTRIES};

val ROW_COUNT: usize            = 22;
val ROWS:      [ROW_COUNT]*Kind = [ROW_COUNT]*Kind{
    ?TEXT, ?RODATA, ?DATA, ?RELRO_DATA, ?BSS, ?TLS_DATA, ?TLS_BSS, ?INIT_ARRAY,
    ?FINI_ARRAY, ?PREINIT_ARRAY, ?UNWIND_INFO, ?NOTE_INFO, ?DEBUG_INFO, ?METADATA,
    ?ADDRSIG_TABLE, ?COMMENT_STRINGS, ?STACK_NOTE, ?UNWIND_RECORDS, ?LINK_WARNING,
    ?MERGED_STRINGS, ?MERGED_CONSTANTS, ?MERGED_POINTERS,
};

# a kind and the element size a format names it by, zero for a kind keyed by
# none
pub rec Key {
    kind:    *Kind;
    entsize: u64;
}

# the widest element size a kind may be keyed by
val WIDEST: u64 = 63;

# whether a format names a section of kind `k` from its element size as well
pub fun keyed(k: *Kind) bool {
    ret k.widths != 0;
}

# whether `entsize` is an element size kind `k` takes
pub fun takes(k: *Kind, entsize: u64) bool {
    if (entsize == 0 || entsize > WIDEST) { ret false; }
    ret ((k.widths >> entsize) & 1) != 0;
}

# the key a section of kind `k` and element size `entsize` is named by
pub fun key_of(k: *Kind, entsize: u64) Key {
    if (!keyed(k)) { ret Key{kind: k, entsize: 0}; }
    ret Key{kind: k, entsize: entsize};
}

# how key `a` orders against key `b`: by kind name, then by element size
pub fun order(a: Key, b: Key) i64 {
    val c: i64 = str_compare(a.kind.name, b.kind.name);
    if (c != 0)                { ret c; }
    if (a.entsize < b.entsize) { ret -1; }
    if (a.entsize > b.entsize) { ret 1; }
    ret 0;
}

# the kind whose output section a section of kind `k` joins
pub fun joined(k: *Kind) *Kind {
    if (k.joins != nil) { ret k.joins; }
    ret k;
}

# the flags that set which keyed kind a section is
val SHAPE: Flags = ALLOC | WRITE | EXEC | TLS | MERGE | STRINGS;

# the keyed kind a section of `flags` and element size `entsize` is, none
# when no keyed kind starts with those flags and takes that size
pub fun merged(flags: Flags, entsize: u64) opt[*Kind] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val k: *Kind = ROWS[i];
        i = i + 1;
        if (keyed(k) && (flags & SHAPE) == k.flags && takes(k, entsize)) { ret opt[*Kind].some{k}; }
    }
    ret opt[*Kind].none{};
}

# how many keys the kinds have: one per kind keyed by no size, and one per
# size of a keyed kind
pub fun key_count() usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < ROW_COUNT) {
        n = n + widths_of(ROWS[i]);
        i = i + 1;
    }
    ret n;
}

# how many keys kind `k` has
fun widths_of(k: *Kind) usize {
    if (!keyed(k)) { ret 1; }
    var n: usize = 0;
    var w: u64   = 1;
    for (w <= WIDEST) {
        if (takes(k, w)) { n = n + 1; }
        w = w + 1;
    }
    ret n;
}

# the key at `index` of key_count, the kinds in catalog order and a keyed
# kind's sizes ascending
pub fun key_at(index: usize) Key {
    var left: usize = index;
    var i:    usize = 0;
    for (i < ROW_COUNT && left >= widths_of(ROWS[i])) {
        left = left - widths_of(ROWS[i]);
        i    = i + 1;
    }
    val k: *Kind = ROWS[i];
    if (!keyed(k)) { ret Key{kind: k, entsize: 0}; }
    var w: u64 = 1;
    for (w <= WIDEST) {
        if (takes(k, w)) {
            if (left == 0) { brk; }
            left = left - 1;
        }
        w = w + 1;
    }
    ret Key{kind: k, entsize: w};
}

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Kind {
    ret ROWS[index];
}

pub fun by_name(name: str) res[*Kind, Fail] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].name, name)) { ret res[*Kind, Fail].ok{ROWS[i]}; }
        i = i + 1;
    }
    ret res[*Kind, Fail].err{fail.unsupported("no section kind has this name")};
}

# whether the `n` keys at `stated`, those a format's rows and refusals name,
# hold every key exactly once
pub fun once_each(stated: *Key, n: usize) bool {
    if (n != key_count()) { ret false; }
    var i: usize = 0;
    for (i < n) {
        val k:    Key   = key_at(i);
        var seen: usize = 0;
        var j:    usize = 0;
        for (j < n) {
            if (stated[j].kind == k.kind && stated[j].entsize == k.entsize) { seen = seen + 1; }
            j = j + 1;
        }
        if (seen != 1) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the roles of a section garbage collection keeps whether referenced or not:
# notes and the tables of functions the loader runs
pub val RETAINED: Roles = NOTE | INIT | FINI | PREINIT;

pub def Treats: u64;

# kept whole whether referenced or not
pub val KEEP: Treats = 0x1;
# one atom per defined symbol, each kept or dropped on its own
pub val ATOMS: Treats = 0x2;
# lives exactly while the section it belongs to does
pub val FOLLOW: Treats = 0x4;
# cut into unwind records, each living exactly while the function it
# describes does
pub val CUT: Treats = 0x8;

# how garbage collection treats a section, a row a format chooses for each
# section it converts
# ---
# name:     the disposition's spelling in a dump
# caps:     what it asks of garbage collection
# fallback: the disposition taken when the section cannot be treated as this
#           one asks, nil for one that always can
pub rec Disposition {
    name:     str;
    caps:     Treats;
    fallback: *Disposition;
}

pub val ROOT:  Disposition = Disposition{name: "root", caps: KEEP};
pub val WHOLE: Disposition = Disposition{name: "whole", caps: 0};
# a split section whose atom boundaries cannot be trusted is one atom
pub val SPLIT:     Disposition = Disposition{name: "split", caps: ATOMS, fallback: ?WHOLE};
pub val DEPENDENT: Disposition = Disposition{name: "dependent", caps: FOLLOW};
# an unwind section whose records cannot be read is kept whole
pub val RECORDS: Disposition = Disposition{name: "records", caps: CUT, fallback: ?ROOT};

pub fun treats(d: *Disposition, t: Treats) bool {
    ret (d.caps & t) == t;
}

pub fun has(k: *Kind, r: Roles) bool {
    ret (k.roles & r) == r;
}

# code and writable or thread-local data are loaded, relro is writable data,
# only loaded kinds run as initializers, a kind that is not image content is
# not loaded, a keyed kind holds entries to merge and states how a link cuts
# them, only placed content is cut, a kind of strings cuts strings, entries
# equal by their target share no tails, and a kind joins a placed kind that
# joins none
fun consistent(k: *Kind) bool {
    val alloc: bool = (k.flags & ALLOC) != 0;
    if (k.use == nil)                                                                     { ret false; }
    if (keyed(k) && ((k.flags & MERGE) == 0 || (k.widths & 1) != 0 || k.entries == nil))  { ret false; }
    if (k.entries != nil && (!keyed(k) || !k.use.placed))                                 { ret false; }
    if (k.entries != nil && ((k.flags & STRINGS) != 0) != k.entries.tails)                { ret false; }
    if (k.entries != nil && sel k.entries.equal.target && k.entries.tails)                { ret false; }
    if (k.joins != nil && (k.joins.joins != nil || !k.joins.use.placed || !k.use.placed)) { ret false; }
    if (!k.use.placed && alloc)                                                           { ret false; }
    if ((k.flags & (EXEC | WRITE | TLS)) != 0 && !alloc)                                  { ret false; }
    if (has(k, RELRO) && (k.flags & WRITE) == 0)                                          { ret false; }
    if ((k.roles & (INIT | FINI | PREINIT)) != 0 && !alloc)                               { ret false; }
    if (has(k, DEBUG) && alloc)                                                           { ret false; }
    ret true;
}

test section__kinds_are_unique_and_consistent {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        var j: usize = i + 1;
        for (j < ROW_COUNT) {
            if (str_equals(ROWS[i].name, ROWS[j].name)) { ret 1; }
            j = j + 1;
        }
        val back: res[*Kind, Fail] = by_name(ROWS[i].name);
        if (sel back.err)       { ret 1; }
        if (back.ok != ROWS[i]) { ret 1; }
        i = i + 1;
    }
    # each keyed kind is the one its own flags and each of its sizes give
    var n: usize = 0;
    for (n < key_count()) {
        val key: Key = key_at(n);
        n = n + 1;
        if (!keyed(key.kind)) { cnt; }
        val again: opt[*Kind] = merged(key.kind.flags, key.entsize);
        if (sel again.none)         { ret 2; }
        if (again.some != key.kind) { ret 2; }
        val odd: opt[*Kind] = merged(key.kind.flags, 3);
        if (sel odd.some) { ret 2; }
    }
    ret 0;
}

test section__strings_report_the_padding_that_aligns_the_next_and_constants_none {
    # "calls \0", one zero pad, "\n\0", as gcc emits an 8 byte aligned string section
    val gcc:   [10]u8           = [10]u8{0x63, 0x61, 0x6c, 0x6c, 0x73, 0x20, 0x00, 0x00, 0x0a, 0x00};
    val first: res[Entry, Fail] = STRING_ENTRIES.cut(?gcc[0], 10, 0, 1, 8);
    if (sel first.err)                               { ret 1; }
    if (first.ok.size != 7 || first.ok.padding != 1) { ret 1; }
    val second: res[Entry, Fail] = STRING_ENTRIES.cut(?gcc[0], 10, 8, 1, 8);
    if (sel second.err)                                { ret 2; }
    if (second.ok.size != 2 || second.ok.padding != 0) { ret 2; }
    # an empty string at an aligned offset is an entry, not padding
    val empty: [9]u8            = [9]u8{0x61, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
    val a:     res[Entry, Fail] = STRING_ENTRIES.cut(?empty[0], 9, 0, 1, 8);
    if (sel a.err)                           { ret 3; }
    if (a.ok.size != 2 || a.ok.padding != 6) { ret 3; }
    val e: res[Entry, Fail] = STRING_ENTRIES.cut(?empty[0], 9, 8, 1, 8);
    if (sel e.err)                           { ret 4; }
    if (e.ok.size != 1 || e.ok.padding != 0) { ret 4; }
    # a zero constant is an entry and reports no padding
    val c: res[Entry, Fail] = CONSTANT_ENTRIES.cut(?empty[0], 9, 2, 1, 8);
    if (sel c.err)                           { ret 5; }
    if (c.ok.size != 1 || c.ok.padding != 0) { ret 5; }
    ret 0;
}
