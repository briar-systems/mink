# the section kinds of the neutral model and the flags a section carries
#
# a kind is the role a section plays, a row a format maps its own section
# types and flags to. the linker reads what a row declares and never which
# row it is.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mink.fail;
use mink.fail.Fail;

pub def Flags: u64;

# occupies memory in the image
pub val ALLOC: Flags = 0x1;
# writable at run time
pub val WRITE: Flags = 0x2;
# holds code
pub val EXEC: Flags = 0x4;
# kept by garbage collection whether referenced or not
pub val RETAIN: Flags = 0x8;
# equal entries of the section's entry size may be merged
pub val MERGE: Flags = 0x10;
# entries are NUL-terminated strings
pub val STRINGS: Flags = 0x20;
# thread-local storage
pub val TLS: Flags = 0x40;

pub def Roles: u64;

# carries bytes in the file, rather than only a zero-fill size
pub val BITS: Roles = 0x1;
# read only once relocations are applied at load
pub val RELRO: Roles = 0x2;
# call frame or unwind tables
pub val UNWIND: Roles = 0x4;
# debugging information
pub val DEBUG: Roles = 0x8;
# a system note
pub val NOTE: Roles = 0x10;
# a table of functions run before the entry
pub val INIT: Roles = 0x20;
# a table of functions run at exit
pub val FINI: Roles = 0x40;
# a table of functions run before any shared object's initializers
pub val PREINIT: Roles = 0x80;

# name:  the kind's spelling in a dump
# flags: the flags a section of this kind starts with
# roles: what the kind is to the linker
pub rec Kind {
    name:  str;
    flags: Flags;
    roles: Roles;
}

pub val TEXT:          Kind = Kind{name: "text", flags: ALLOC | EXEC, roles: BITS};
pub val RODATA:        Kind = Kind{name: "rodata", flags: ALLOC, roles: BITS};
pub val DATA:          Kind = Kind{name: "data", flags: ALLOC | WRITE, roles: BITS};
pub val RELRO_DATA:    Kind = Kind{name: "relro", flags: ALLOC | WRITE, roles: BITS | RELRO};
pub val BSS:           Kind = Kind{name: "bss", flags: ALLOC | WRITE, roles: 0};
pub val TLS_DATA:      Kind = Kind{name: "tdata", flags: ALLOC | WRITE | TLS, roles: BITS};
pub val TLS_BSS:       Kind = Kind{name: "tbss", flags: ALLOC | WRITE | TLS, roles: 0};
pub val INIT_ARRAY:    Kind = Kind{name: "init_array", flags: ALLOC | WRITE, roles: BITS | INIT};
pub val FINI_ARRAY:    Kind = Kind{name: "fini_array", flags: ALLOC | WRITE, roles: BITS | FINI};
pub val PREINIT_ARRAY: Kind = Kind{name: "preinit_array", flags: ALLOC | WRITE, roles: BITS | PREINIT};
pub val UNWIND_INFO:   Kind = Kind{name: "unwind", flags: ALLOC, roles: BITS | UNWIND};
pub val NOTE_INFO:     Kind = Kind{name: "note", flags: ALLOC, roles: BITS | NOTE};
pub val DEBUG_INFO:    Kind = Kind{name: "debug", flags: 0, roles: BITS | DEBUG};
# bytes no image loads and no rule above names, such as a comment or a wasm
# custom section
pub val METADATA: Kind = Kind{name: "metadata", flags: 0, roles: BITS};

val ROW_COUNT: usize            = 14;
val ROWS:      [ROW_COUNT]*Kind = [ROW_COUNT]*Kind{
    ?TEXT, ?RODATA, ?DATA, ?RELRO_DATA, ?BSS, ?TLS_DATA, ?TLS_BSS, ?INIT_ARRAY,
    ?FINI_ARRAY, ?PREINIT_ARRAY, ?UNWIND_INFO, ?NOTE_INFO, ?DEBUG_INFO, ?METADATA,
};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Kind {
    ret ROWS[index];
}

pub fun by_name(name: str) res[*Kind, Fail] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].name, name)) { ret res[*Kind, Fail].ok{ROWS[i]}; }
        i = i + 1;
    }
    ret res[*Kind, Fail].err{fail.unsupported("no section kind has this name")};
}

# whether the `n` kinds at `stated`, those a format's rows and refusals name,
# hold every kind exactly once
pub fun once_each(stated: **Kind, n: usize) bool {
    if (n != ROW_COUNT) { ret false; }
    var i: usize = 0;
    for (i < ROW_COUNT) {
        var seen: usize = 0;
        var j:    usize = 0;
        for (j < n) {
            if (stated[j] == ROWS[i]) { seen = seen + 1; }
            j = j + 1;
        }
        if (seen != 1) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the roles of a section garbage collection keeps whether referenced or not:
# notes and the tables of functions the loader runs
pub val RETAINED: Roles = NOTE | INIT | FINI | PREINIT;

pub def Treats: u64;

# kept whole whether referenced or not
pub val KEEP: Treats = 0x1;
# one atom per defined symbol, each kept or dropped on its own
pub val ATOMS: Treats = 0x2;
# lives exactly while the section it belongs to does
pub val FOLLOW: Treats = 0x4;
# cut into unwind records, each living exactly while the function it
# describes does
pub val CUT: Treats = 0x8;

# how garbage collection treats a section, a row a format chooses for each
# section it converts
# ---
# name:     the disposition's spelling in a dump
# caps:     what it asks of garbage collection
# fallback: the disposition taken when the section cannot be treated as this
#           one asks, nil for one that always can
pub rec Disposition {
    name:     str;
    caps:     Treats;
    fallback: *Disposition;
}

pub val ROOT:  Disposition = Disposition{name: "root", caps: KEEP};
pub val WHOLE: Disposition = Disposition{name: "whole", caps: 0};
# a split section whose atom boundaries cannot be trusted is one atom
pub val SPLIT:     Disposition = Disposition{name: "split", caps: ATOMS, fallback: ?WHOLE};
pub val DEPENDENT: Disposition = Disposition{name: "dependent", caps: FOLLOW};
# an unwind section whose records cannot be read is kept whole
pub val RECORDS: Disposition = Disposition{name: "records", caps: CUT, fallback: ?ROOT};

pub fun treats(d: *Disposition, t: Treats) bool {
    ret (d.caps & t) == t;
}

pub fun has(k: *Kind, r: Roles) bool {
    ret (k.roles & r) == r;
}

# code and writable or thread-local data are loaded, relro is writable data,
# and only loaded kinds run as initializers
fun consistent(k: *Kind) bool {
    val alloc: bool = (k.flags & ALLOC) != 0;
    if ((k.flags & (EXEC | WRITE | TLS)) != 0 && !alloc)    { ret false; }
    if (has(k, RELRO) && (k.flags & WRITE) == 0)            { ret false; }
    if ((k.roles & (INIT | FINI | PREINIT)) != 0 && !alloc) { ret false; }
    if (has(k, DEBUG) && alloc)                             { ret false; }
    ret true;
}

test section__kinds_are_unique_and_consistent {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        var j: usize = i + 1;
        for (j < ROW_COUNT) {
            if (str_equals(ROWS[i].name, ROWS[j].name)) { ret 1; }
            j = j + 1;
        }
        val back: res[*Kind, Fail] = by_name(ROWS[i].name);
        if (sel back.err)       { ret 1; }
        if (back.ok != ROWS[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}
