# the compression methods a format's compressed bytes are coded with
#
# a method decompresses a whole stream into exactly the size its container
# states, refusing a stream that holds more or fewer bytes, and compresses a
# whole input onto a sink. a method whose library builds no encoder
# states why and refuses to compress.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use V: std.collections.vector;

use D: deflate.deflate;
use I: deflate.inflate;
use deflate.zlib;
use zstd.decode;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

# name:      how a command line and a refusal name it
# inflate:   the stream `src` decompressed into `dst`, which takes the stated
#            size, and how many bytes it wrote
# deflate:   the input `src` compressed onto `out`
# unwritten: why the method compresses nothing, nil where it compresses
pub rec Method {
    name:      str;
    inflate:   fun(*A.Allocator, *u8, usize, *u8, usize) res[usize, Fail];
    deflate:   fun(*A.Allocator, *u8, usize, *Sink) err[Fail];
    unwritten: str;
}

pub val ZLIB: Method = Method{name: "zlib", inflate: zlib_inflate, deflate: zlib_deflate, unwritten: nil};
pub val ZSTD: Method = Method{name: "zstd", inflate: zstd_inflate, deflate: zstd_deflate, unwritten: "zstd output is not supported yet, zlib is"};

val METHOD_COUNT: usize                 = 2;
val METHODS:      [METHOD_COUNT]*Method = [METHOD_COUNT]*Method{?ZLIB, ?ZSTD};

# the method named `name`
pub fun by_name(name: str) res[*Method, Fail] {
    var i: usize = 0;
    for (i < METHOD_COUNT) {
        if (str_equals(METHODS[i].name, name)) { ret res[*Method, Fail].ok{METHODS[i]}; }
        i = i + 1;
    }
    ret res[*Method, Fail].err{fail.about(fail.unsupported("no compression method has this name"), name)};
}

# the `n` bytes of `src` decompressed by `m` onto the end of `out`, refused
# unless they decompress to exactly `size` bytes
pub fun inflate(m: *Method, a: *A.Allocator, src: *u8, n: usize, size: usize, out: *Sink) err[Fail] {
    val start: usize     = sink.len(out);
    val z:     err[Fail] = sink.zeros(out, size);
    if (sel z.err) { ret z; }
    val got: res[usize, Fail] = m.inflate(a, src, n, ?sink.data(out)[start], size);
    if (sel got.err)    { ret err[Fail].err{fail.about(got.err, m.name)}; }
    if (got.ok != size) { ret err[Fail].err{fail.about(fail.malformed("compressed bytes decompress to fewer bytes than stated"), m.name)}; }
    ret err[Fail].ok{};
}

# refused when `m` compresses nothing
pub fun writes(m: *Method) err[Fail] {
    if (m.unwritten != nil) { ret err[Fail].err{fail.unsupported(m.unwritten)}; }
    ret err[Fail].ok{};
}

# the `n` bytes of `src` compressed by `m` onto the end of `out`
pub fun deflate(m: *Method, a: *A.Allocator, src: *u8, n: usize, out: *Sink) err[Fail] {
    val w: err[Fail] = writes(m);
    if (sel w.err) { ret w; }
    val r: err[Fail] = m.deflate(a, src, n, out);
    if (sel r.err) { ret err[Fail].err{fail.about(r.err, m.name)}; }
    ret r;
}

val MORE:   str = "compressed bytes decompress to more bytes than stated";
val BROKEN: str = "compressed bytes do not decompress";

fun zlib_inflate(a: *A.Allocator, src: *u8, n: usize, dst: *u8, size: usize) res[usize, Fail] {
    val r: res[usize, I.InflateError] = zlib.decompress_into(a, src, n, dst, size);
    if (sel r.ok) { ret res[usize, Fail].ok{r.ok}; }
    val e: I.InflateError = r.err;
    if (sel e.alloc) { ret res[usize, Fail].err{fail.refused(e.alloc)}; }
    or (sel e.full)  { ret res[usize, Fail].err{fail.malformed(MORE)}; }
    ret res[usize, Fail].err{fail.malformed(BROKEN)};
}

fun zlib_deflate(a: *A.Allocator, src: *u8, n: usize, out: *Sink) err[Fail] {
    val r: res[V.Vector[u8], D.DeflateError] = zlib.compress_alloc(a, D.DEFAULT_LEVEL, src, n);
    if (sel r.err) {
        val e: D.DeflateError = r.err;
        if (sel e.alloc) { ret err[Fail].err{fail.refused(e.alloc)}; }
        ret err[Fail].err{fail.internal("the zlib encoder refused its input")};
    }
    var v: V.Vector[u8] = r.ok;
    val w: err[Fail]    = sink.bytes(out, v.data, v.len);
    val d: err[A.Error] = V.dnit[u8](?v);
    if (sel w.err) { ret w; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}

# a window as large as the stated size, which no frame of it needs to exceed,
# and never under the decoder's minimum
fun zstd_inflate(a: *A.Allocator, src: *u8, n: usize, dst: *u8, size: usize) res[usize, Fail] {
    var limits: decode.Limits = decode.limits_default();
    if (size > limits.max_window) { limits.max_window = size; }
    val r: res[usize, decode.ZstdError] = decode.decompress_into(a, limits, src, n, dst, size);
    if (sel r.ok) { ret res[usize, Fail].ok{r.ok}; }
    val e: decode.ZstdError = r.err;
    if (sel e.alloc) { ret res[usize, Fail].err{fail.refused(e.alloc)}; }
    or (sel e.full)  { ret res[usize, Fail].err{fail.malformed(MORE)}; }
    ret res[usize, Fail].err{fail.malformed(BROKEN)};
}

fun zstd_deflate(a: *A.Allocator, src: *u8, n: usize, out: *Sink) err[Fail] {
    ret writes(?ZSTD);
}
