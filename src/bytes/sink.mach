# the one growable output buffer every writer appends to
#
# a refused allocation while growing is a failure, and the bytes already
# written stay as they were.

use std.encoding.binary;
use std.encoding.leb128;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use std.memory;

use mink.base.buffer;
use mink.base.buffer.Buffer;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.reader.Order;

# bytes: what has been written
# order: the byte order of multi-byte writes
pub rec Sink {
    bytes: Buffer;
    order: Order;
}

pub fun make(a: *A.Allocator, order: Order) Sink {
    ret Sink{bytes: buffer.make(a), order: order};
}

pub fun len(s: *Sink) usize {
    ret buffer.len(?s.bytes);
}

# the bytes written, valid until the sink next grows
pub fun data(s: *Sink) *u8 {
    ret buffer.at(?s.bytes, 0);
}

pub fun bytes(s: *Sink, p: *u8, n: usize) err[Fail] {
    val r: res[usize, Fail] = buffer.extend(?s.bytes, p, n);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

pub fun text(s: *Sink, t: str) err[Fail] {
    ret bytes(s, t::*u8, str_len(t));
}

# `n` zero bytes
pub fun zeros(s: *Sink, n: usize) err[Fail] {
    val r: res[usize, Fail] = buffer.grow(?s.bytes, n);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

# `n` bytes of the value `v`
pub fun fill(s: *Sink, v: u8, n: usize) err[Fail] {
    val start: usize     = len(s);
    val z:     err[Fail] = zeros(s, n);
    if (sel z.err) { ret z; }
    if (v == 0)    { ret z; }
    memory.raw_fill((data(s)::usize + start)::ptr, v, n);
    ret z;
}

# zero bytes up to the next multiple of `align`, a power of two
pub fun pad_to(s: *Sink, align: usize) err[Fail] {
    val rem: usize = len(s) & (align - 1);
    if (rem == 0) { ret err[Fail].ok{}; }
    ret zeros(s, align - rem);
}

pub fun u8(s: *Sink, v: u8) err[Fail] {
    ret uint(s, v::u64, 1);
}

pub fun u16(s: *Sink, v: u16) err[Fail] {
    ret uint(s, v::u64, 2);
}

pub fun u32(s: *Sink, v: u32) err[Fail] {
    ret uint(s, v::u64, 4);
}

pub fun u64(s: *Sink, v: u64) err[Fail] {
    ret uint(s, v, 8);
}

# an unsigned integer of `size` bytes, 1 to 8, in the sink's order
pub fun uint(s: *Sink, v: u64, size: usize) err[Fail] {
    var buf: [8]u8;
    binary.put_uint(?buf[0], v, size, s.order);
    ret bytes(s, ?buf[0], size);
}

pub fun uleb(s: *Sink, v: u64) err[Fail] {
    var buf: [10]u8;
    ret bytes(s, ?buf[0], leb128.put_unsigned(?buf[0], v));
}

pub fun sleb(s: *Sink, v: i64) err[Fail] {
    var buf: [10]u8;
    ret bytes(s, ?buf[0], leb128.put_signed(?buf[0], v));
}

# `v` as text in `radix`, 10 or 16, lowercase
pub fun number(s: *Sink, v: u64, radix: u64) err[Fail] {
    ret digits(s, v::u128, radix::u128);
}

# `v` as decimal text, with a leading `-` when negative
pub fun signed(s: *Sink, v: i128) err[Fail] {
    if (v >= 0) { ret digits(s, v::u128, 10); }
    val w: err[Fail] = text(s, "-");
    if (sel w.err) { ret w; }
    ret digits(s, (0::u128) - v::u128, 10);
}

# the digits past 64 bits take the 128-bit division, the rest the native one
fun digits(s: *Sink, v: u128, radix: u128) err[Fail] {
    var buf:  [40]u8;
    var i:    usize = 40;
    var wide: u128  = v;
    for (wide > U64_MAX) {
        i      = i - 1;
        buf[i] = digit((wide % radix)::u8);
        wide   = wide / radix;
    }
    var x:    u64 = wide::u64;
    val base: u64 = radix::u64;
    for {
        i      = i - 1;
        buf[i] = digit((x % base)::u8);
        x      = x / base;
        if (x == 0) { brk; }
    }
    ret bytes(s, ?buf[i], 40 - i);
}

fun digit(d: u8) u8 {
    if (d >= 10) { ret d - 10 + 'a'; }
    ret d + '0';
}

val U64_MAX: u128 = 0xffff_ffff_ffff_ffff;

# overwrite `size` bytes at `pos` with `v`, the bytes already written
pub fun patch(s: *Sink, pos: usize, v: u64, size: usize) err[Fail] {
    if (pos > len(s) || size > len(s) - pos) {
        ret err[Fail].err{fail.at_offset(fail.truncated("patch past the end of the output"), pos::u64)};
    }
    binary.put_uint(?data(s)[pos], v, size, s.order);
    ret err[Fail].ok{};
}

pub fun release(s: *Sink) err[Fail] {
    ret buffer.release(?s.bytes);
}
