# a bounded cursor over a byte span
#
# every read is checked against the span's end and a read past it is a
# truncated failure at the absolute offset it was asked for. the reader knows
# nothing of any format: endianness is a parameter, not a type.

use std.encoding.binary;
use std.encoding.leb128;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;

pub def Order: binary.Order;
pub val LITTLE: Order = binary.LITTLE;
pub val BIG:    Order = binary.BIG;

# file:  the input's name, carried into every failure
# data:  the span's first byte
# len:   the span's length
# pos:   the next byte to read, relative to data
# base:  the absolute offset of data in the file
# order: the byte order of multi-byte reads
pub rec Reader {
    file:  str;
    data:  *u8;
    len:   usize;
    pos:   usize;
    base:  u64;
    order: Order;
}

# a reader at the start of a span that is itself at file offset zero
# ---
# file:  the input's name, carried into every failure, borrowed
# data:  the span's first byte, borrowed
# len:   the span's length
# order: the byte order of multi-byte reads
# ret:   the reader
pub fun make(file: str, data: *u8, len: usize, order: Order) Reader {
    ret Reader{file: file, data: data, len: len, order: order};
}

# the absolute offset of the next byte
pub fun offset(r: *Reader) u64 {
    ret r.base + r.pos::u64;
}

# the location of the next byte
pub fun here(r: *Reader) Location {
    ret Location{file: r.file, offset: offset(r), placed: true};
}

# how many bytes of the span are left to read
# ---
# r:   the reader
# ret: the bytes from the next one to the span's end
pub fun remaining(r: *Reader) usize {
    ret r.len - r.pos;
}

# move to `pos` in the span, which may be its end
pub fun seek(r: *Reader, pos: u64) res[usize, Fail] {
    if (pos > r.len::u64) { ret res[usize, Fail].err{past(r, pos)}; }
    r.pos = pos::usize;
    ret res[usize, Fail].ok{r.pos};
}

# the `n` bytes at `pos` as a reader of their own, reporting absolute offsets
pub fun sub(r: *Reader, pos: u64, n: u64) res[Reader, Fail] {
    if (pos > r.len::u64 || n > r.len::u64 - pos) { ret res[Reader, Fail].err{past(r, pos)}; }
    var out: Reader = @r;
    out.data = ?r.data[pos::usize];
    out.len  = n::usize;
    out.pos  = 0;
    out.base = r.base + pos;
    ret res[Reader, Fail].ok{out};
}

# the next `n` bytes, borrowed from the span
pub fun bytes(r: *Reader, n: u64) res[*u8, Fail] {
    val res_taken: res[usize, Fail] = take(r, n);
    if (sel res_taken.err) { ret res[*u8, Fail].err{res_taken.err}; }
    ret res[*u8, Fail].ok{?r.data[res_taken.ok]};
}

# the next byte as an unsigned integer in the reader's order
# ---
# r:   the reader, moved past the value
# ret: the value, or a truncated failure at the read's offset
pub fun u8(r: *Reader) res[u8, Fail] {
    val res_uint: res[u64, Fail] = uint(r, 1);
    if (sel res_uint.err) { ret res[u8, Fail].err{res_uint.err}; }
    ret res[u8, Fail].ok{res_uint.ok::u8};
}

# the next 2 bytes as an unsigned integer in the reader's order
# ---
# r:   the reader, moved past the value
# ret: the value, or a truncated failure at the read's offset
pub fun u16(r: *Reader) res[u16, Fail] {
    val res_uint: res[u64, Fail] = uint(r, 2);
    if (sel res_uint.err) { ret res[u16, Fail].err{res_uint.err}; }
    ret res[u16, Fail].ok{res_uint.ok::u16};
}

# the next 4 bytes as an unsigned integer in the reader's order
# ---
# r:   the reader, moved past the value
# ret: the value, or a truncated failure at the read's offset
pub fun u32(r: *Reader) res[u32, Fail] {
    val res_uint: res[u64, Fail] = uint(r, 4);
    if (sel res_uint.err) { ret res[u32, Fail].err{res_uint.err}; }
    ret res[u32, Fail].ok{res_uint.ok::u32};
}

# the next 8 bytes as an unsigned integer in the reader's order
# ---
# r:   the reader, moved past the value
# ret: the value, or a truncated failure at the read's offset
pub fun u64(r: *Reader) res[u64, Fail] {
    ret uint(r, 8);
}

# an unsigned integer of `size` bytes, 1 to 8, in the reader's order
pub fun uint(r: *Reader, size: usize) res[u64, Fail] {
    val res_u64_taken: res[usize, Fail] = take(r, size::u64);
    if (sel res_u64_taken.err) { ret res[u64, Fail].err{res_u64_taken.err}; }
    ret res[u64, Fail].ok{binary.get_uint(?r.data[res_u64_taken.ok], size, r.order)};
}

# the next unsigned LEB128 value
# ---
# r:   the reader, moved past the value
# ret: the value, or a truncated failure when it runs past the span or a
#      malformed one when it exceeds 64 bits, at the value's offset
pub fun uleb(r: *Reader) res[u64, Fail] {
    val at:           u64                                = offset(r);
    val res_unsigned: res[leb128.Unsigned, leb128.Error] = leb128.get_unsigned(?r.data[r.pos], remaining(r));
    if (sel res_unsigned.err) { ret res[u64, Fail].err{leb_fail(r, at, res_unsigned.err)}; }
    r.pos = r.pos + res_unsigned.ok.size;
    ret res[u64, Fail].ok{res_unsigned.ok.value};
}

# the next signed LEB128 value
# ---
# r:   the reader, moved past the value
# ret: the value, or a truncated failure when it runs past the span or a
#      malformed one when it exceeds 64 bits, at the value's offset
pub fun sleb(r: *Reader) res[i64, Fail] {
    val at:         u64                              = offset(r);
    val res_signed: res[leb128.Signed, leb128.Error] = leb128.get_signed(?r.data[r.pos], remaining(r));
    if (sel res_signed.err) { ret res[i64, Fail].err{leb_fail(r, at, res_signed.err)}; }
    r.pos = r.pos + res_signed.ok.size;
    ret res[i64, Fail].ok{res_signed.ok.value};
}

# claim the next `n` bytes, returning the position of the first
fun take(r: *Reader, n: u64) res[usize, Fail] {
    if (n > remaining(r)::u64) { ret res[usize, Fail].err{past(r, r.pos::u64)}; }
    val at: usize = r.pos;
    r.pos = r.pos + n::usize;
    ret res[usize, Fail].ok{at};
}

# a read at span position `pos` that runs past the end
fun past(r: *Reader, pos: u64) Fail {
    ret fail.at_offset(fail.in_file(fail.truncated("read past the end of the data"), r.file), r.base + pos);
}

# the failure of a LEB128 read that began at absolute offset `at`
fun leb_fail(r: *Reader, at: u64, e: leb128.Error) Fail {
    var f: Fail = fail.malformed("LEB128 value exceeds 64 bits");
    if (sel e.short) { f = fail.truncated("read past the end of the data"); }
    ret fail.at_offset(fail.in_file(f, r.file), at);
}
