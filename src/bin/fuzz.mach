# the hostile input driver's child, one read of one input
#
# `fuzz readers` lists every reader, `fuzz sniff <file>` names the reader whose
# magic a file carries and `fuzz read <reader> <file>` reads the file with it.
# the input sits flush against an unmapped page, so a read past its end faults.
# a read that completes or refuses exits 0 or 1, anything else is a defect.
# test/run.sh --fuzz drives it.

use std.print;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.heap;
use std.memory;
use std.system.os;

use mink.lib.catalog.format;
use mink.lib.catalog.format.Format;
use mink.lib.elf.model;
use mink.lib.elf.model.Elf;
use mink.lib.elf.read;
use mink.lib.fail.Fail;
use mink.lib.format.contract;
use mink.lib.format.contract.Input;
use mink.lib.format.contract.Model;
use mink.lib.format.contract.Registration;
use mink.lib.format.file;
use mink.lib.format.file.Loaded;
use mink.lib.format.registry;
use mink.lib.format.registry.Registry;
use mink.lib.format.shell;

# a reader that is not registered yet: its format, the magic that claims a
# file, and a read that releases what it made. a format found in the registry
# is read through its registration and its row here is ignored
rec Extra {
    format:    *Format;
    magic:     *u8;
    magic_len: usize;
    read:      fun(*A.Allocator, *Input) err[Fail];
}

val ELF_MAGIC: [4]u8 = [4]u8{0x7f, 'E', 'L', 'F'};

val EXTRA_COUNT: usize              = 1;
val EXTRA:       [EXTRA_COUNT]Extra = [EXTRA_COUNT]Extra{Extra{format: ?format.ELF, magic: ?ELF_MAGIC[0], magic_len: 4, read: read_elf}};

val PROT_NONE: u32 = 0;

val EXIT_READ:    i64 = 0;
val EXIT_REFUSED: i64 = 1;
val EXIT_USAGE:   i64 = 2;

fun read_elf(a: *A.Allocator, in: *Input) err[Fail] {
    val r: res[Elf, Fail] = read.read(a, in);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    var m: Elf = r.ok;
    ret model.release(?m);
}

fun registered(reg: *Registry, f: *Format) bool {
    val got: res[*Registration, Fail] = registry.by_format(reg, f);
    ret sel got.ok;
}

fun claims(magic: *u8, len: usize, in: *Input) bool {
    if (in.len < len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (in.data[i] != magic[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the input copied flush against an unmapped page
fun fence(in: *Input, out: *Input) bool {
    val page: usize = os.page_size();
    val body: usize = ((in.len + page - 1) / page) * page;
    val base: ptr   = os.allocate(body + page);
    if (base == nil) { ret false; }
    val edge: usize = base::usize + body;
    if (os.protect(edge::ptr, page, PROT_NONE) != 0) { ret false; }
    val at: *u8 = (edge - in.len)::*u8;
    memory.raw_copy(at::ptr, in.data::ptr, in.len);
    @out = Input{file: in.file, data: at, len: in.len};
    ret true;
}

fun list(reg: *Registry) i64 {
    var i: usize = 0;
    for (i < reg.count) {
        print.println(reg.entries[i].format.name);
        i = i + 1;
    }
    i = 0;
    for (i < EXTRA_COUNT) {
        if (!registered(reg, EXTRA[i].format)) { print.println(EXTRA[i].format.name); }
        i = i + 1;
    }
    ret EXIT_READ;
}

fun load(a: *A.Allocator, path: str, out: *Input) bool {
    val l: res[Loaded, Fail] = file.load(a, path);
    if (sel l.err) {
        print.eprintln("fuzz: cannot read the input");
        ret false;
    }
    var loaded: Loaded = l.ok;
    if (!fence(?loaded.input, out)) {
        print.eprintln("fuzz: cannot fence the input");
        ret false;
    }
    ret true;
}

fun sniff(a: *A.Allocator, reg: *Registry, path: str) i64 {
    var in: Input;
    if (!load(a, path, ?in)) { ret EXIT_USAGE; }
    val got: res[*Registration, Fail] = registry.sniff(reg, ?in);
    if (sel got.ok) {
        print.println(got.ok.format.name);
        ret EXIT_READ;
    }
    var i: usize = 0;
    for (i < EXTRA_COUNT) {
        if (!registered(reg, EXTRA[i].format) && claims(EXTRA[i].magic, EXTRA[i].magic_len, ?in)) {
            print.println(EXTRA[i].format.name);
            ret EXIT_READ;
        }
        i = i + 1;
    }
    ret EXIT_REFUSED;
}

fun read_one(a: *A.Allocator, reg: *Registry, name: str, path: str) i64 {
    var in: Input;
    if (!load(a, path, ?in)) { ret EXIT_USAGE; }
    var i: usize = 0;
    for (i < reg.count) {
        val r: *Registration = reg.entries[i];
        if (str_equals(r.format.name, name)) {
            val m: res[Model, Fail] = shell.run(r, a, ?in);
            if (sel m.err) { ret EXIT_REFUSED; }
            var model: Model     = m.ok;
            val d:     err[Fail] = contract.release(?model);
            if (sel d.err) { ret EXIT_REFUSED; }
            ret EXIT_READ;
        }
        i = i + 1;
    }
    i = 0;
    for (i < EXTRA_COUNT) {
        if (str_equals(EXTRA[i].format.name, name)) {
            val e: err[Fail] = EXTRA[i].read(a, ?in);
            if (sel e.err) { ret EXIT_REFUSED; }
            ret EXIT_READ;
        }
        i = i + 1;
    }
    print.eprintln("fuzz: no such reader");
    ret EXIT_USAGE;
}

fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    val reg: res[Registry, Fail] = registry.builtin();
    if (sel reg.err) { ret EXIT_USAGE; }
    var r: Registry = reg.ok;
    if (argc == 2 && str_equals(argv[1]::str, "readers")) { ret list(?r); }
    if (argc == 3 && str_equals(argv[1]::str, "sniff"))   { ret sniff(a, ?r, argv[2]::str); }
    if (argc == 4 && str_equals(argv[1]::str, "read"))    { ret read_one(a, ?r, argv[2]::str, argv[3]::str); }
    print.eprintln("usage: fuzz readers | sniff <file> | read <reader> <file>");
    ret EXIT_USAGE;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret EXIT_USAGE; }
    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret EXIT_USAGE; }
    ret run(?a, argc, argv);
}
