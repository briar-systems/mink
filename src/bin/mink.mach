# mink, the linker of the mach toolchain

use std.runtime;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.heap;
use fs: std.filesystem;
use std.text.parse;

use mink.bin.args;
use mink.bin.args.Option;
use mink.bin.args.Parsed;
use mink.lib.catalog.format;
use mink.lib.catalog.format.Format;
use mink.lib.diag;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;
use mink.lib.format.contract;
use mink.lib.format.contract.Model;
use mink.lib.format.contract.Registration;
use mink.lib.format.file;
use mink.lib.format.file.Loaded;
use mink.lib.format.registry;
use mink.lib.format.registry.Registry;
use mink.lib.reader.LITTLE;
use mink.lib.sink;
use mink.lib.sink.Sink;

val HELP_OPTIONS: [1]Option = [1]Option{Option{name: "--help", short: "-h", value: "", arity: args.FLAG, doc: "show this page"}};
val OUT_OPTIONS:  [2]Option = [2]Option{
    Option{name: "--help", short: "-h", value: "", arity: args.FLAG, doc: "show this page"},
    Option{name: "--output", short: "-o", value: "path", arity: args.VALUE, doc: "write the file here"},
};

val OVERVIEW: str = "mink, the linker of the mach toolchain\n\nusage: mink <command> [operands] [options]\n\ncommands:\n  dump <file>                 print the model of an object file, field by field\n  sniff <file>                print the format of a file\n  locate <file> <offset>      print the record of a file's model that holds a byte\n  formats                     list every format and whether mink is built with it\n  roundtrip <file> -o <path>  read a file and write its model back out\n  help [command]              show this page, or a command's\n\noptions:\n  -h, --help                  show a command's page\n";

val DUMP_PAGE:      str = "usage: mink dump <file>\n\nread a file as the format its magic names and print its model, one field per line\n";
val SNIFF_PAGE:     str = "usage: mink sniff <file>\n\nprint the name of the format a file's magic names\n";
val LOCATE_PAGE:    str = "usage: mink locate <file> <offset>\n\nread a file and print the record of its model that holds the byte at offset, as `record` or `record index`\nan offset no record holds prints nothing and fails\n";
val FORMATS_PAGE:   str = "usage: mink formats\n\nprint every format as `name registered` or `name unregistered`\n";
val ROUNDTRIP_PAGE: str = "usage: mink roundtrip <file> -o <path>\n\nread a file and write its model back to a path, byte for byte as the writer lays it out\n\noptions:\n  -o, --output <path>  write the file here\n";

rec Run {
    a:      *A.Allocator;
    reg:    Registry;
    parsed: Parsed;
}

# print the diagnostic of `f` on stderr
fun report(a: *A.Allocator, f: Fail) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val r: err[Fail] = diag.render(f, ?s);
    if (sel r.err) { ret 2; }
    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    if (sel e.err) { ret 2; }
    ret 1;
}

fun say(a: *A.Allocator, text: str) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val t: err[Fail] = sink.text(?s, text);
    if (sel t.err) { ret report(a, t.err); }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret report(a, e.err); }
    ret 0;
}

fun usage(a: *A.Allocator, bad: str, why: str) i64 {
    ret report(a, fail.in_record(fail.malformed(why), bad));
}

fun read_file(r: *Run, path: str, loaded: *Loaded, m: *Model) i64 {
    val l: res[Loaded, Fail] = file.load(r.a, path);
    if (sel l.err) { ret report(r.a, l.err); }
    @loaded = l.ok;
    val g: res[Model, Fail] = registry.read(?r.reg, r.a, ?loaded.input);
    if (sel g.err) { ret report(r.a, g.err); }
    @m = g.ok;
    ret 0;
}

fun cmd_dump(r: *Run, path: str) i64 {
    var loaded: Loaded;
    var m:      Model;
    val code:   i64 = read_file(r, path, ?loaded, ?m);
    if (code != 0) { ret code; }
    var s: Sink      = sink.make(r.a, LITTLE);
    val d: err[Fail] = contract.describe(?m, ?s);
    if (sel d.err) { ret report(r.a, d.err); }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret report(r.a, e.err); }
    ret 0;
}

fun cmd_sniff(r: *Run, path: str) i64 {
    val l: res[Loaded, Fail] = file.load(r.a, path);
    if (sel l.err) { ret report(r.a, l.err); }
    var loaded: Loaded                   = l.ok;
    val reg:    res[*Registration, Fail] = registry.sniff(?r.reg, ?loaded.input);
    if (sel reg.err) { ret report(r.a, reg.err); }
    var s: Sink      = sink.make(r.a, LITTLE);
    val t: err[Fail] = sink.text(?s, reg.ok.format.name);
    if (sel t.err) { ret report(r.a, t.err); }
    val n: err[Fail] = sink.text(?s, "\n");
    if (sel n.err) { ret report(r.a, n.err); }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret report(r.a, e.err); }
    ret 0;
}

fun cmd_locate(r: *Run, path: str, at: str) i64 {
    val n: res[u64, parse.ParseError] = parse.parse_u64_exact(at, 0);
    if (sel n.err) { ret usage(r.a, at, "is not an offset"); }
    var loaded: Loaded;
    var m:      Model;
    val code:   i64 = read_file(r, path, ?loaded, ?m);
    if (code != 0) { ret code; }
    val where: Location = contract.locate(?m, n.ok);
    if (where.record == nil) { ret report(r.a, fail.in_file(fail.at_offset(fail.malformed("no record of the model holds this offset"), n.ok), path)); }
    var s:  Sink      = sink.make(r.a, LITTLE);
    val wr: err[Fail] = sink.text(?s, where.record);
    if (sel wr.err) { ret report(r.a, wr.err); }
    if (where.indexed) {
        val ws: err[Fail] = sink.text(?s, " ");
        if (sel ws.err) { ret report(r.a, ws.err); }
        val wi: err[Fail] = sink.number(?s, where.index, 10);
        if (sel wi.err) { ret report(r.a, wi.err); }
    }
    val wn: err[Fail] = sink.text(?s, "\n");
    if (sel wn.err) { ret report(r.a, wn.err); }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret report(r.a, e.err); }
    ret 0;
}

fun cmd_formats(r: *Run) i64 {
    var s: Sink  = sink.make(r.a, LITTLE);
    var i: usize = 0;
    for (i < format.count()) {
        val f:    *Format                  = format.at(i);
        val got:  res[*Registration, Fail] = registry.by_format(?r.reg, f);
        var tail: str                      = " unregistered\n";
        if (sel got.ok) { tail = " registered\n"; }
        val wn: err[Fail] = sink.text(?s, f.name);
        if (sel wn.err) { ret report(r.a, wn.err); }
        val wt: err[Fail] = sink.text(?s, tail);
        if (sel wt.err) { ret report(r.a, wt.err); }
        i = i + 1;
    }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret report(r.a, e.err); }
    ret 0;
}

fun cmd_roundtrip(r: *Run, path: str, out: str) i64 {
    var loaded: Loaded;
    var m:      Model;
    val code:   i64 = read_file(r, path, ?loaded, ?m);
    if (code != 0) { ret code; }
    val w: res[Sink, Fail] = contract.write(?m);
    if (sel w.err) { ret report(r.a, w.err); }
    var s: Sink      = w.ok;
    val e: err[Fail] = file.save(out, ?s);
    if (sel e.err) { ret report(r.a, e.err); }
    ret 0;
}

fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    val reg: res[Registry, Fail] = registry.builtin();
    if (sel reg.err) { ret report(a, reg.err); }
    var r: Run = Run{a: a, reg: reg.ok};
    if (argc < 2) { ret say(a, OVERVIEW); }
    val word: str = argv[1]::str;
    if (str_equals(word, "help") || str_equals(word, "--help") || str_equals(word, "-h")) {
        args.parse(argc::usize, argv, 2, ?HELP_OPTIONS[0], 1, ?r.parsed);
        if (r.parsed.bad != nil)         { ret usage(a, r.parsed.bad, r.parsed.why); }
        if (r.parsed.operand_count == 0) { ret say(a, OVERVIEW); }
        val topic: str = r.parsed.operands[0];
        if (str_equals(topic, "dump"))      { ret say(a, DUMP_PAGE); }
        if (str_equals(topic, "sniff"))     { ret say(a, SNIFF_PAGE); }
        if (str_equals(topic, "locate"))    { ret say(a, LOCATE_PAGE); }
        if (str_equals(topic, "formats"))   { ret say(a, FORMATS_PAGE); }
        if (str_equals(topic, "roundtrip")) { ret say(a, ROUNDTRIP_PAGE); }
        ret usage(a, topic, "unknown command");
    }
    var page: str   = nil;
    var want: usize = 1;
    if (str_equals(word, "dump"))  { page = DUMP_PAGE; }
    or (str_equals(word, "sniff")) { page = SNIFF_PAGE; }
    or (str_equals(word, "locate")) {
        page = LOCATE_PAGE;
        want = 2;
    }
    or (str_equals(word, "formats")) {
        page = FORMATS_PAGE;
        want = 0;
    }
    or (str_equals(word, "roundtrip")) { page = ROUNDTRIP_PAGE; }
    or                                 { ret usage(a, word, "unknown command"); }
    args.parse(argc::usize, argv, 2, ?OUT_OPTIONS[0], 2, ?r.parsed);
    if (r.parsed.bad != nil)            { ret usage(a, r.parsed.bad, r.parsed.why); }
    if (r.parsed.facts[0] == 1)         { ret say(a, page); }
    if (r.parsed.operand_count != want) { ret usage(a, word, "wrong number of operands, see `mink help`"); }
    val out: str = r.parsed.values[1];
    if (!str_equals(word, "roundtrip") && out != nil) { ret usage(a, "--output", "only roundtrip takes it"); }
    if (str_equals(word, "formats"))                  { ret cmd_formats(?r); }
    val path: str = r.parsed.operands[0];
    if (str_equals(word, "dump"))   { ret cmd_dump(?r, path); }
    if (str_equals(word, "sniff"))  { ret cmd_sniff(?r, path); }
    if (str_equals(word, "locate")) { ret cmd_locate(?r, path, r.parsed.operands[1]); }
    if (out == nil)                 { ret usage(a, word, "needs --output"); }
    ret cmd_roundtrip(?r, path, out);
}

# every allocation lives in the heap, which is given back whole when the command ends
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret 2; }
    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret 2; }
    val code: i64          = run(?a, argc, argv);
    val d:    err[A.Error] = heap.dnit(?h);
    if (sel d.err) { ret 2; }
    ret code;
}
