# the oracle lane of the PE/COFF dump, one file per run
#
# `coffdump <file>` reads a COFF object or PE image and prints its model as the dump
# prints it, for tools/coff/readobj.sh to compare with llvm-readobj. it runs locally and is
# never part of CI.

use std.print;
use std.runtime;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;
use std.allocator.heap;
use fs: std.filesystem;

use coff_dump: mink.lib.coff.dump;
use mink.lib.coff.model;
use mink.lib.coff.model.Coff;
use mink.lib.coff.read;
use mink.lib.fail.Fail;
use format_dump: mink.lib.format.dump;
use mink.lib.format.dump.Dumper;
use mink.lib.format.file;
use mink.lib.format.file.Loaded;
use mink.lib.reader.LITTLE;
use mink.lib.sink;
use mink.lib.sink.Sink;

fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    if (argc < 2) {
        print.println("usage: coffdump <file>");
        ret 2;
    }
    val l: res[Loaded, Fail] = file.load(a, argv[1]::str);
    if (sel l.err) {
        print.printlnf("cannot load: {}", l.err.text);
        ret 2;
    }
    var ld: Loaded          = l.ok;
    val r:  res[Coff, Fail] = read.read(a, ?ld.input);
    if (sel r.err) {
        print.printlnf("read refused: {}", r.err.text);
        ret 1;
    }
    var m: Coff      = r.ok;
    var s: Sink      = sink.make(a, LITTLE);
    var d: Dumper    = format_dump.make(?s, ?coff_dump.FIELDS[0], coff_dump.FIELD_COUNT);
    val w: err[Fail] = coff_dump.describe(?m, ?d);
    if (sel w.err) {
        print.printlnf("dump refused: {} in {}", w.err.text, w.err.at.record);
        ret 1;
    }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret 2; }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret 2; }
    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret 2; }
    ret run(?a, argc, argv);
}
