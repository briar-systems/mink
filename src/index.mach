# the sorted indexes every catalog and relocation set is looked up through
#
# a table keeps its rows in the order its author wrote them and answers "which
# row has this key" through an index of entries sorted by key, searched with
# std's binary search. a catalog's index is static and written beside its rows,
# and `verify` proves it sorted, complete and in agreement with them. a set of
# rows that is itself data is indexed when it is registered, into a table the
# registry owns, and `seal` sorts it. either way a key that two rows share is
# refused when the index is made, so a lookup never depends on row order.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.fail;
use mink.fail.Fail;
use mink.table;
use mink.table.Table;

# one name and the row it names
# ---
# key: the name, as its row states it
# row: the row's position in its table
pub rec Entry {
    key: str;
    row: u32;
}

# entries as a pointer to static entries and a count, ascending by key
pub rec Index {
    at:  *Entry;
    len: u32;
}

# one number and the row it names
# ---
# key: the number, as its row states it
# row: the row's position in its table
pub rec Number {
    key: u64;
    row: u32;
}

# numeric entries as a pointer to entries and a count, ascending by key
pub rec Numbers {
    at:  *Number;
    len: u32;
}

# how the names of two entries order, bytewise
pub fun order_entries(a: *Entry, b: *Entry) i64 {
    ret str_compare(a.key, b.key);
}

# how the numbers of two entries order
pub fun order_numbers(a: *Number, b: *Number) i64 {
    if (a.key < b.key) { ret -1; }
    if (a.key > b.key) { ret 1; }
    ret 0;
}

# the row of `index` named `key`, by binary search
pub fun find(index: *Index, key: str) opt[u32] {
    if (index.len == 0) { ret opt[u32].none{}; }
    var target: Entry          = Entry{key: key};
    val at:     SearchPosition = sort.binary_search_by[Entry](index.at, index.len::usize, ?target, order_entries);
    if (sel at.found) { ret opt[u32].some{index.at[at.found].row}; }
    ret opt[u32].none{};
}

# the row of `index` numbered `key`, by binary search
pub fun find_number(index: *Numbers, key: u64) opt[u32] {
    if (index.len == 0) { ret opt[u32].none{}; }
    var target: Number         = Number{key: key};
    val at:     SearchPosition = sort.binary_search_by[Number](index.at, index.len::usize, ?target, order_numbers);
    if (sel at.found) { ret opt[u32].some{index.at[at.found].row}; }
    ret opt[u32].none{};
}

# whether a static index is strictly ascending, holds one entry for each of the
# `count` rows and names each row as that row does. `key_of` is a row's own name
pub fun verify(index: *Index, count: usize, key_of: fun(usize) str) err[Fail] {
    if (index.len::usize != count) { ret err[Fail].err{fail.internal("an index does not hold one entry per row")}; }
    var i: usize = 0;
    for (i < count) {
        val e: *Entry = ?index.at[i];
        if (e.row::usize >= count || str_compare(key_of(e.row::usize), e.key) != 0) {
            ret err[Fail].err{fail.internal("an index entry does not name its row")};
        }
        if (i != 0 && str_compare(index.at[i - 1].key, e.key) >= 0) {
            ret err[Fail].err{fail.internal("an index is not ascending or holds a name twice")};
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# sort the entries of `t` by key, refusing a key that two entries share
pub fun seal(t: *Table[Number]) err[Fail] {
    val n: usize = table.count[Number](t);
    sort.sort_by[Number](table.items[Number](t), n, order_numbers);
    var i: usize = 1;
    for (i < n) {
        val p: *Number = table.items[Number](t);
        if (p[i - 1].key == p[i].key) { ret err[Fail].err{fail.internal("two rows share one key")}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the entries of `t` as an index
pub fun view(t: *Table[Number]) Numbers {
    ret Numbers{at: table.items[Number](t), len: table.count[Number](t)::u32};
}

val T_ENTRIES:   [3]Entry = [3]Entry{Entry{key: "a", row: 2}, Entry{key: "b", row: 0}, Entry{key: "ba", row: 1}};
val T_DUPLICATE: [3]Entry = [3]Entry{Entry{key: "a", row: 2}, Entry{key: "a", row: 2}, Entry{key: "b", row: 0}};
val T_NAMES:     [3]str   = [3]str{"b", "ba", "a"};

fun t_name(row: usize) str {
    ret T_NAMES[row];
}

test index__a_name_finds_its_row_and_a_duplicate_is_refused {
    val index: Index    = Index{at: ?T_ENTRIES[0], len: 3};
    val a:     opt[u32] = find(?index, "a");
    val ba:    opt[u32] = find(?index, "ba");
    val c:     opt[u32] = find(?index, "c");
    val empty: Index    = Index{};
    val none:  opt[u32] = find(?empty, "a");
    if (!(sel a.some && a.some == 2))   { ret 1; }
    if (!(sel ba.some && ba.some == 1)) { ret 2; }
    if (!sel c.none || !sel none.none)  { ret 3; }
    val bad: Index     = Index{at: ?T_DUPLICATE[0], len: 3};
    val ok:  err[Fail] = verify(?index, 3, t_name);
    if (sel ok.err) { ret 4; }
    val dup: err[Fail] = verify(?bad, 3, t_name);
    if (sel dup.ok) { ret 5; }
    ret 0;
}
