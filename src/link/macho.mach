# how Mach-O links: the linking row of the Mach-O format and the rows it names

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

use mink.base.rule.Axis;
use mink.catalog.output;
use mink.format.layout.Rules;
use mink.format.macho.layout;
use mink.link.collect.Leaving;
use mink.link.collect.Superseding;
use mink.link.common;
use mink.link.consume;
use mink.link.dynamic;
use mink.link.fold;
use mink.link.image.Writer;
use mink.link.layout.Participant;
use mink.link.layout.Participants;
use mink.link.linking.Linking;
use mink.link.linking.Synthesizers;
use mink.link.macho.convention;
use mink.link.macho.image;
use mink.link.macho.made;
use mink.link.macho.templates;
use mink.link.macho.unwind;
use mink.link.needs;
use mink.link.relax;
use mink.link.reserve;
use mink.link.reserve.Declarer;
use mink.link.reserve.Declarers;
use mink.link.resolve;
use mink.link.resolve.Weak;
use mink.link.synthesizer;
use mink.link.thunk;
use mink.model.directive;

# the sections that are not image content a Mach-O link takes
val USE_COUNT: usize                   = 4;
val USES:      [USE_COUNT]*consume.Row = [USE_COUNT]*consume.Row{?consume.SIGNIFICANCE, ?consume.STRINGS, ?consume.STACK, ?consume.UNWIND_RECORDS};

# resolution reads an export directive as the default visibility of the name
# it is about, which the dynamic phase exports
val DIRECTIVES: [1]*directive.Kind = [1]*directive.Kind{?directive.EXPORT};

val DECLARER_COUNT: usize                     = 5;
val DECLARERS:      [DECLARER_COUNT]*Declarer = [DECLARER_COUNT]*Declarer{?reserve.HEADER_TABLE, ?image.SIGNATURE_TABLE, ?unwind.TABLE, ?convention.SLOTS, ?image.ACCESSOR_WORDS};

val SYNTHESIZER_COUNT: usize                               = 2;
val SYNTHESIZERS:      [SYNTHESIZER_COUNT]*synthesizer.Row = [SYNTHESIZER_COUNT]*synthesizer.Row{?common.ROW, ?needs.ROW};

# relaxation rewrites the relocations whose rows state forms, as an arm64
# GOT or TLV page reference takes the page of the address its add form
# takes, and thunks send a branch past its reach through a veneer in an
# island
val PARTICIPANT_COUNT: usize                           = 2;
val PARTICIPANTS:      [PARTICIPANT_COUNT]*Participant = [PARTICIPANT_COUNT]*Participant{?relax.RELAX, ?thunk.THUNKS};

# every archive is searched again while a name is left undefined. whether a
# common definition pulls a member that defines its name as data is not
# verified, so the row leaves it off. an undefined weak reference resolves to
# zero. each distinct C string is kept whole and shares no tails. sections
# nothing reaches are kept unless -dead_strip is given. only a dylib's
# exports are roots, as an executable's trie carries the visible definitions
# the link keeps. an image loads every dylib linked. a function's FDE is left
# out when its compact unwind entry does not defer to DWARF, as the unwinder
# then never reads it
pub val LINKING: Linking = Linking{
    caps:         0,
    search:       resolve.REVISIT,
    hooks:        ?resolve.PLAIN,
    weak:         Weak.zero{},
    folds:        fold.NONE,
    layout:       opt[*Rules].some{?layout.LAYOUT},
    tails:        false,
    collects:     false,
    exports:      Axis{need: output.EXPORTS, deny: 0},
    dynamic:      ?convention.DYNAMIC,
    maker:        opt[*dynamic.Maker].some{?made.MAKER},
    loads_all:    true,
    runtime:      convention.RUNTIME,
    facts:        ?convention.FACTS,
    writer:       opt[*Writer].some{?image.WRITER},
    bounds:       image.BOUNDS,
    declarers:    Declarers{rows: ?DECLARERS[0], count: DECLARER_COUNT},
    measures:     image.MEASURES,
    uses:         consume.Uses{rows: ?USES[0], count: USE_COUNT, directives: ?DIRECTIVES[0], directive_count: 1},
    synthesizers: Synthesizers{rows: ?SYNTHESIZERS[0], count: SYNTHESIZER_COUNT},
    participants: Participants{rows: ?PARTICIPANTS[0], count: PARTICIPANT_COUNT},
    superseding:  opt[*Superseding].some{?unwind.SUPERSEDING},
    leaving:      opt[*Leaving].none{},
    templates:    templates.SETS,
};
