use std.types.view.View;

# what a link's search made and loaded, which the sources it hands the link
# point into
# ---
# paths:  the paths and names it made, each a zero after it
# loaded: the files it loaded
pub rec Found {
    a:      *A.Allocator;
    paths:  Vector[str];
    loaded: Vector[Loaded];
}

# the most linker scripts one may name in a chain, one naming the next
val SCRIPT_DEPTH: usize = 16;

# a search under way: what resolves a link's requests to sources and finds
# what the inputs' link claims name while the link runs. it stays where it
# is opened until it is closed, as the claimant and its own sources point
# into it
# ---
# found:    where what the search makes is held
# readers:  the formats a file is sniffed through
# options:  the link's options, borrowed while the search is open
# notes:    where the directories a refused search tried are written
# resolved: the sources the requests resolve to, in link order
# sources:  where the request being resolved appends its sources: resolved,
#           or what a claim gives
# search:   where the target's host finds a library or a framework by name
# libdirs:  the directories a library is searched in, in order, once listed
# fwdirs:   the directories a framework is searched in, in order, once listed
# listed:   whether they are
# depth:    how many linker scripts the one being read lies inside
# prefer:   which files a linker script's `-l<name>` entries are searched
#           for first, as the request being resolved states
# cwd:      the working directory a relative path lies in, once read
# relocs:   the relocation rows a library is converted through to read what
#           it re-exports
# follow:   what the following of re-exports knows, across the requests and
#           the claims the link finds
# claims:   each claim found, by its form, kind, inclusion and name
pub rec Finding {
    found:    *Found;
    readers:  *Readers;
    options:  *Options;
    notes:    *Sink;
    resolved: Vector[Source];
    sources:  *Vector[Source];
    search:   os.Search;
    libdirs:  Vector[str];
    fwdirs:   Vector[str];
    listed:   bool;
    depth:    usize;
    prefer:   Prefer;
    cwd:      str;
    relocs:   *reloc_row.Registry;
    follow:   Following;
    claims:   Interner;
}

pub fun make(a: *A.Allocator) Found {
    ret Found{a: a, paths: vector.init[str](a), loaded: vector.init[Loaded](a)};
}

# give back every file loaded and every path made, reporting the first
# refusal
pub fun release(f: *Found) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < vector.length[Loaded](?f.loaded)) {
        first = fail.kept(first, file.unload(?f.loaded.data[i]));
        i     = i + 1;
    }
    first = fail.kept(first, vectors.release[Loaded](?f.loaded));
    i     = 0;
    for (i < vector.length[str](?f.paths)) {
        val s: str          = f.paths.data[i];
        val d: err[A.Error] = A.deallocate[char](f.a, s, str_len(s) + 1);
        if (sel d.err) { first = fail.kept(first, err[Fail].err{fail.refused(d.err)}); }
        i = i + 1;
    }
    ret fail.kept(first, vectors.release[str](?f.paths));
}

# open a search at `c` for the link `o` states through the formats of `g`,
# what it makes held in `f` and the directories a refused search tried
# written to `notes`. the search is given back by close
pub fun open(c: *Finding, f: *Found, g: *Registry, o: *Options, notes: *Sink) {
    @c = Finding{
        found:    f,
        readers:  ?g.readers,
        options:  o,
        notes:    notes,
        resolved: vector.init[Source](f.a),
        search:   os.search(o.target.host),
        libdirs:  vector.init[str](f.a),
        fwdirs:   vector.init[str](f.a),
        relocs:   ?g.relocs,
        follow:   Following{names: intern.make(f.a), loaders: vector.init[bool](f.a), asked: vector.init[bool](f.a), wanted: vector.init[Id[Name]](f.a)},
        claims:   intern.make(f.a),
    };
    c.sources = ?c.resolved;
}

# resolve the `count` requests at `requests` in order to the sources they
# name, appended to the search's resolved sources, and follow the re-exports
# of what they enter
pub fun find(c: *Finding, requests: *Request, count: usize) err[Fail] {
    var i: usize = 0;
    for (i < count) {
        val e: err[Fail] = request(c, ?requests[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    ret follow_all(c, 0);
}

# what finds the files the inputs' link claims name through the search `c`,
# for as long as it is open
pub fun claimant(c: *Finding) Claimant {
    ret Claimant{context: c::ptr, find: claim};
}

# give back what the search holds beside what it found, reporting the first
# refusal
pub fun close(c: *Finding) err[Fail] {
    var back: err[Fail] = vectors.release[Source](?c.resolved);
    back = fail.kept(back, vectors.release[str](?c.libdirs));
    back = fail.kept(back, vectors.release[str](?c.fwdirs));
    back = fail.kept(back, intern.release(?c.follow.names));
    back = fail.kept(back, vectors.release[bool](?c.follow.loaders));
    back = fail.kept(back, vectors.release[bool](?c.follow.asked));
    back = fail.kept(back, vectors.release[Id[Name]](?c.follow.wanted));
    ret fail.kept(back, intern.release(?c.claims));
}

fun request(c: *Finding, r: *Request) err[Fail] {
    if (sel r.source) {
        val p: err[Fail] = vectors.push[Source](c.sources, r.source);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        ret err[Fail].ok{};
    }
    or (sel r.file) {
        c.prefer = Prefer.shared_first{};
        ret named(c, r.file.path, r.file.include, false);
    }
    c.prefer = Prefer.shared_first{};
    if (sel r.library.prefer.static_first || sel r.library.prefer.static_only) { c.prefer = Prefer.static_first{}; }
    ret library(c, r.library, opt[*Tally].none{});
}

# the claimant's find: the claim `cl` found as the request it states, a
# library by its kind alone, with the re-exports of what it enters followed,
# the sources it gives appended to `out`. a claim found before gives nothing
fun claim(context: ptr, cl: *Claim, out: *Vector[Source]) err[Fail] {
    val c:     *Finding        = context::*Finding;
    val fresh: res[bool, Fail] = first_claim(c, cl);
    if (sel fresh.err) { ret err[Fail].err{fresh.err}; }
    if (!fresh.ok)     { ret err[Fail].ok{}; }
    val name: res[str, Fail] = copied(c, cl.name.data, 0, cl.name.len);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    var include: Include = Include.always{};
    if (cl.referenced) { include = Include.referenced{}; }
    var prefer: Prefer = Prefer.shared_only{};
    if (sel cl.kind.some && sel cl.kind.some.static) { prefer = Prefer.static_only{}; }
    var r: Request = Request.library{Wanted{form: Form.system{}, name: name.ok, include: include, prefer: prefer}};
    if (sel cl.form.framework) { r = Request.library{Wanted{form: Form.framework{}, name: name.ok, include: include, prefer: prefer}}; }
    or (sel cl.form.local)     { r = Request.file{File{path: name.ok, include: include}}; }
    val stated: *Vector[Source] = c.sources;
    c.sources = out;
    val from: usize     = vector.length[Source](out);
    val e:    err[Fail] = request(c, ?r);
    var done: err[Fail] = e;
    if (sel e.ok) { done = follow_all(c, from); }
    c.sources = stated;
    ret done;
}

# whether the claim `cl` is the first of its form, kind, inclusion and name
fun first_claim(c: *Finding, cl: *Claim) res[bool, Fail] {
    var key:   Sink            = sink.make(c.found.a, LITTLE);
    val out:   res[bool, Fail] = keyed(c, cl, ?key);
    val freed: err[Fail]       = sink.release(?key);
    if (sel out.err)   { ret out; }
    if (sel freed.err) { ret res[bool, Fail].err{freed.err}; }
    ret out;
}

# whether the key of the claim `cl`, made in `key`, is new to the claims
# found
fun keyed(c: *Finding, cl: *Claim, key: *Sink) res[bool, Fail] {
    var form: u8 = 0;
    if (sel cl.form.framework) { form = 1; }
    or (sel cl.form.local)     { form = 2; }
    var kind: u8 = 0;
    if (sel cl.kind.some && sel cl.kind.some.static) { kind = 1; }
    var w: err[Fail] = sink.u8(key, form);
    w = fail.kept(w, sink.u8(key, kind));
    w = fail.kept(w, sink.u8(key, cl.referenced::u8));
    w = fail.kept(w, sink.bytes(key, cl.name.data, cl.name.len));
    if (sel w.err) { ret res[bool, Fail].err{w.err}; }
    val before: usize               = intern.count(?c.claims);
    val n:      res[Id[Name], Fail] = intern.intern(?c.claims, sink.data(key), sink.len(key));
    if (sel n.err) { ret res[bool, Fail].err{n.err}; }
    ret res[bool, Fail].ok{intern.count(?c.claims) != before};
}

# a kind a file can be to a search for one kind
# ---
# said: how a note names it
rec Sort {
    said: str;
}

val SHARED:  Sort = Sort{said: "a shared library"};
val STATIC:  Sort = Sort{said: "a static library"};
val NEITHER: Sort = Sort{said: "neither kind of library"};

# a search for one kind alone
# ---
# sort:   the kind
# sought: how a note names what it looks for, ahead of the name
# missed: the refusal of a search that met no file of the name
# wrong:  the refusal of a search that met only files of another kind
rec Alone {
    sort:   *Sort;
    sought: str;
    missed: str;
    wrong:  str;
}

val SHARED_ALONE: Alone = Alone{sort: ?SHARED, sought: "a shared library of the name ", missed: "no directory searched holds a shared library of the name", wrong: "the files of the name are not the shared library asked for"};
val STATIC_ALONE: Alone = Alone{sort: ?STATIC, sought: "a static library of the name ", missed: "no directory searched holds a static library of the name", wrong: "the files of the name are not the static library asked for"};

# what the entries of a linker script being sorted are
# ---
# binds:   one is a shared library
# files:   one is another file
# foreign: one is for another architecture
rec Tally {
    binds:   bool;
    files:   bool;
    foreign: bool;
}

# how a linker script is read
# ---
# include:  how its entries enter
# searched: whether a search found it
# tally:    where its entries are counted, none to enter them
rec Walk {
    include:  Include;
    searched: bool;
    tally:    opt[*Tally];
}

# one search for a name
# ---
# name:    the name as the link states it, which a refusal names
# include: how what it finds enters
# alone:   the one kind it asks for, none for a search by preference
# tally:   where what it takes is counted, for the linker script being
#          sorted, none to enter it
# wrong:   the notes of the files of another kind it has met, which reach
#          the link's notes only if it is refused
rec Seeking {
    name:    str;
    include: Include;
    alone:   opt[*Alone];
    tally:   opt[*Tally];
    wrong:   Sink;
}

# what the following of re-exports knows
# ---
# names:   the install names met
# loaders: per name, a library entered has it as its install name
# asked:   per name, a library entered re-exports it
# wanted:  the re-exported names, in the order met
# looked:  how many of them were looked for
rec Following {
    names:   Interner;
    loaders: Vector[bool];
    asked:   Vector[bool];
    wanted:  Vector[Id[Name]];
    looked:  usize;
}

# follow the re-exports of every shared library the search entered from the
# source at `from` on, each library a re-export finds entered and followed in
# turn, until none is found that is not entered already
fun follow_all(c: *Finding, from: usize) err[Fail] {
    val f:    *Following = ?c.follow;
    var next: usize      = from;
    for {
        val end: usize = vector.length[Source](c.sources);
        for (next < end) {
            val e: err[Fail] = facts(c, f, c.sources.data[next]);
            if (sel e.err) { ret e; }
            next = next + 1;
        }
        for (f.looked < vector.length[Id[Name]](?f.wanted)) {
            val n: Id[Name] = f.wanted.data[f.looked];
            f.looked = f.looked + 1;
            if (marked(?f.loaders, n)) { cnt; }
            val e: err[Fail] = locate(c, intern.bytes_of(?f.names, n));
            if (sel e.err) { ret e; }
        }
        if (vector.length[Source](c.sources) == end) { brk; }
    }
    ret err[Fail].ok{};
}

# whether `t` marks the name `n`
fun marked(t: *Vector[bool], n: Id[Name]) bool {
    ret n.index::usize < vector.length[bool](t) && t.data[n.index::usize];
}

# mark the name `n` in `t`, the table growing to hold it, true when it was
# not marked before
fun mark(t: *Vector[bool], n: Id[Name]) res[bool, Fail] {
    val have: usize = vector.length[bool](t);
    if (n.index::usize >= have) {
        val g: err[Fail] = vectors.grow[bool](t, n.index::usize + 1 - have);
        if (sel g.err) { ret res[bool, Fail].err{g.err}; }
    }
    val was: bool = t.data[n.index::usize];
    t.data[n.index::usize] = true;
    ret res[bool, Fail].ok{!was};
}

# what the source `s` states of the libraries: the install name of the
# shared library it is and the libraries it re-exports. a source of no file,
# and one no format reads, states nothing, and a container states what its
# member for the link's architecture does
fun facts(c: *Finding, f: *Following, s: Source) err[Fail] {
    if (!sel s.included) { ret err[Fail].ok{}; }
    ret input_facts(c, f, s.included.input);
}

fun input_facts(c: *Finding, f: *Following, in: contract.Input) err[Fail] {
    var probe: contract.Input              = in;
    val known: res[*contract.Reader, Fail] = readers.sniff(c.readers, ?probe);
    if (sel known.err) { ret err[Fail].ok{}; }
    val m: res[Model, Fail] = shell.run(known.ok, c.found.a, ?probe);
    if (sel m.err) { ret err[Fail].err{m.err}; }
    var model: Model     = m.ok;
    val r:     err[Fail] = model_facts(c, f, ?model, in.file);
    ret fail.kept(r, contract.release(?model));
}

fun model_facts(c: *Finding, f: *Following, m: *Model, file: str) err[Fail] {
    val held: res[bool, Fail] = contract.is_container(m);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    if (held.ok)      { ret member_facts(c, f, m, file); }
    val k: res[*kind.Kind, Fail] = contract.kind(m);
    if (sel k.err)                   { ret err[Fail].err{k.err}; }
    if (!kind.has(k.ok, kind.BINDS)) { ret err[Fail].ok{}; }
    var o: Object    = object.make(c.found.a, c.options.target.arch, nil);
    val r: err[Fail] = object_facts(c, f, m, ?o);
    val g: err[Fail] = object.release(?o);
    if (sel r.err) { ret err[Fail].err{fail.in_file(r.err, file)}; }
    ret g;
}

# what the member of the container `m` for the link's architecture states
fun member_facts(c: *Finding, f: *Following, m: *Model, file: str) err[Fail] {
    var members: Table[Member] = table.make[Member](c.found.a);
    var r:       err[Fail]     = contract.members(m, file, ?members);
    var i:       usize         = 0;
    for (i < table.count[Member](?members) && sel r.ok) {
        val member: *Member = table.at[Member](?members, table.nth[Member](i));
        i = i + 1;
        if (sel member.arch.none) { cnt; }
        var code: Stated           = member.arch.some;
        val fits: res[*Arch, Fail] = arch_list.by_code(?code);
        if (!(sel fits.ok && fits.ok == c.options.target.arch)) { cnt; }
        r = input_facts(c, f, member.input);
        brk;
    }
    ret fail.kept(r, table.release[Member](?members));
}

fun object_facts(c: *Finding, f: *Following, m: *Model, o: *Object) err[Fail] {
    val conv: err[Fail] = contract.to_neutral(m, c.relocs, o);
    if (sel conv.err)       { ret conv; }
    if (sel o.library.none) { ret err[Fail].ok{}; }
    val own: opt[Id[Name]] = o.library.some.loader;
    if (sel own.some) {
        val v: View                = object.name_of(o, own.some);
        val n: res[Id[Name], Fail] = intern.intern(?f.names, v.data, v.len);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        val l: res[bool, Fail] = mark(?f.loaders, n.ok);
        if (sel l.err) { ret err[Fail].err{l.err}; }
    }
    var k: usize = 0;
    for (k < table.count[object.Dependency](?o.libraries)) {
        val d: *object.Dependency = table.at[object.Dependency](?o.libraries, table.nth[object.Dependency](k));
        k = k + 1;
        if (!d.reexports) { cnt; }
        val dep: opt[Id[Name]] = d.library.loader;
        if (sel dep.none) { cnt; }
        val v: View                = object.name_of(o, dep.some);
        val n: res[Id[Name], Fail] = intern.intern(?f.names, v.data, v.len);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        val fresh: res[bool, Fail] = mark(?f.asked, n.ok);
        if (sel fresh.err) { ret err[Fail].err{fresh.err}; }
        if (!fresh.ok)     { cnt; }
        val p: err[Fail] = vectors.push[Id[Name]](?f.wanted, n.ok);
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    ret err[Fail].ok{};
}

# the suffix of a dylib's install name, which its text stub replaces
val DYLIB: str = ".dylib";
# the suffix of a text stub
val STUB: str = ".tbd";

# look for the library of install name `install` and enter it where found:
# its text stub beside it under the sysroot, then the file itself, then a
# file of its name in each library directory, the stub first
fun locate(c: *Finding, install: View) err[Fail] {
    val path: res[str, Fail] = copied(c, install.data, 0, install.len);
    if (sel path.err) { ret err[Fail].err{path.err}; }
    val stem: res[str, Fail] = stem_of_path(c, path.ok);
    if (sel stem.err) { ret err[Fail].err{stem.err}; }
    val root: str             = c.options.sysroot;
    val hit:  res[bool, Fail] = reexported_at(c, str_join(c.found.a, root, stem.ok, STUB));
    if (sel hit.err) { ret err[Fail].err{hit.err}; }
    if (hit.ok)      { ret err[Fail].ok{}; }
    val whole: res[bool, Fail] = reexported_at(c, str_join(c.found.a, root, path.ok));
    if (sel whole.err) { ret err[Fail].err{whole.err}; }
    if (whole.ok)      { ret err[Fail].ok{}; }
    val l: err[Fail] = listed(c);
    if (sel l.err) { ret l; }
    val base:      str   = base_of(path.ok);
    val base_stem: str   = base_of(stem.ok);
    var d:         usize = 0;
    for (d < vector.length[str](?c.libdirs)) {
        val dir: str = c.libdirs.data[d];
        d = d + 1;
        val s: res[bool, Fail] = reexported_at(c, str_join(c.found.a, dir, "/", base_stem, STUB));
        if (sel s.err) { ret err[Fail].err{s.err}; }
        if (s.ok)      { ret err[Fail].ok{}; }
        val w: res[bool, Fail] = reexported_at(c, str_join(c.found.a, dir, "/", base));
        if (sel w.err) { ret err[Fail].err{w.err}; }
        if (w.ok)      { ret err[Fail].ok{}; }
    }
    ret err[Fail].ok{};
}

# whether the file at `made` is a shared library for the link, entered as
# one the image loads only when a reference binds to it
fun reexported_at(c: *Finding, made: res[str, StrError]) res[bool, Fail] {
    var s: Seeking = Seeking{include: Include.referenced{}};
    ret candidate(c, made, ?s, true, false);
}

# the path `path` without the dylib suffix where it ends in it
fun stem_of_path(c: *Finding, path: str) res[str, Fail] {
    val n: usize = str_len(path);
    val s: usize = str_len(DYLIB);
    if (n <= s || !memory.raw_equal((path::usize + n - s)::ptr, DYLIB::ptr, s)) { ret res[str, Fail].ok{path}; }
    ret copied(c, path::*u8, 0, n - s);
}

# the file name of the path `path`, what follows its last separator
fun base_of(path: str) str {
    val n:  usize = str_len(path);
    var at: usize = 0;
    var i:  usize = 0;
    for (i < n) {
        if (path[i] == '/') { at = i + 1; }
        i = i + 1;
    }
    ret (path::usize + at)::str;
}

# whether the link's system reads a library file no format reads as a GNU
# linker script
fun reads_scripts(c: *Finding) bool {
    val n: opt[*Naming] = c.search.naming;
    if (sel n.none) { ret false; }
    ret n.some.scripts;
}

# hold `r`, a string made for the search, until the search is released
fun own(c: *Finding, r: res[str, StrError]) res[str, Fail] {
    if (sel r.err) {
        val e: StrError = r.err;
        if (sel e.alloc) { ret res[str, Fail].err{fail.refused(e.alloc)}; }
        ret res[str, Fail].err{fail.internal("a path could not be made")};
    }
    val p: err[Fail] = vectors.push[str](?c.found.paths, r.ok);
    if (sel p.err) {
        drop(c, r.ok);
        ret res[str, Fail].err{p.err};
    }
    ret res[str, Fail].ok{r.ok};
}

# give back `s`, a string made for the search and not held
fun drop(c: *Finding, s: str) {
    val d: err[A.Error] = A.deallocate[char](c.found.a, s, str_len(s) + 1);
}

# the `len` bytes at `at` of `data`, held with a zero after them
fun copied(c: *Finding, data: *u8, at: usize, len: usize) res[str, Fail] {
    val got: res[str, A.Error] = A.allocate[char](c.found.a, len + 1);
    if (sel got.err) { ret res[str, Fail].err{fail.refused(got.err)}; }
    memory.raw_copy(got.ok::ptr, (data::usize + at)::ptr, len);
    got.ok[len] = 0;
    ret own(c, res[str, StrError].ok{got.ok});
}

# list the directories a library and a framework are searched in: those the
# link adds, then the system's under the sysroot
fun listed(c: *Finding) err[Fail] {
    if (c.listed) { ret err[Fail].ok{}; }
    val s: *os.Search = ?c.search;
    val o: *Options   = c.options;
    var i: usize      = 0;
    for (i < o.libdir_count) {
        val e: err[Fail] = listed_one(c, ?c.libdirs, nil, o.libdirs[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    i = 0;
    for (i < s.libdir_count) {
        val e: err[Fail] = listed_one(c, ?c.libdirs, o.sysroot, s.libdirs[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    i = 0;
    for (i < o.fwdir_count) {
        val e: err[Fail] = listed_one(c, ?c.fwdirs, nil, o.fwdirs[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    i = 0;
    for (i < s.framework_count) {
        val e: err[Fail] = listed_one(c, ?c.fwdirs, o.sysroot, s.frameworks[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    c.listed = true;
    ret err[Fail].ok{};
}

# append `dir` under `root`, nil for none, to `into`
fun listed_one(c: *Finding, into: *Vector[str], root: str, dir: str) err[Fail] {
    val d: res[str, Fail] = own(c, str_join(c.found.a, root, dir));
    if (sel d.err) { ret err[Fail].err{d.err}; }
    val p: err[Fail] = vectors.push[str](into, d.ok);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the library or the framework `w`, found by its name, and counted in `tally`
# where one is given instead of entered
fun library(c: *Finding, w: Wanted, tally: opt[*Tally]) err[Fail] {
    val n: opt[*Naming] = c.search.naming;
    if (sel n.none) { ret err[Fail].err{fail.about(fail.in_record(fail.malformed("the system's linker finds no library by name"), c.options.target.sys.name), w.name)}; }
    val l: err[Fail] = listed(c);
    if (sel l.err) { ret l; }
    var seeking: Seeking = Seeking{name: w.name, include: w.include, tally: tally, wrong: sink.make(c.found.a, LITTLE)};
    if (sel w.prefer.shared_only) { seeking.alone = opt[*Alone].some{?SHARED_ALONE}; }
    or (sel w.prefer.static_only) { seeking.alone = opt[*Alone].some{?STATIC_ALONE}; }
    var out: err[Fail] = err[Fail].ok{};
    if (sel w.form.framework) { out = framework(c, n.some, w, ?seeking); }
    or                        { out = system_library(c, n.some, w, ?seeking); }
    ret fail.kept(out, sink.release(?seeking.wrong));
}

# the library `w`, found by the steps of the naming's order for its
# preference, its stem dropped first. a search for one kind tries every step
# whatever the output kind, since the contents of a file decide. a shared
# library alone is refused outright for an output kind that imports nothing
fun system_library(c: *Finding, naming: *Naming, w: Wanted, seeking: *Seeking) err[Fail] {
    val name: res[str, Fail] = stem_of(c, naming, w.name);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    val imports: bool = output.has(c.options.kind, output.IMPORTS);
    if (sel w.prefer.shared_only && !imports) { ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the output kind imports nothing, so no shared library can be taken"), c.options.kind.name), w.name)}; }
    var order: *Order = ?naming.shared_first;
    if (sel w.prefer.static_first || sel w.prefer.static_only) { order = ?naming.static_first; }
    val every: bool  = imports || sel seeking.alone.some;
    var s:     usize = 0;
    for (s < order.count) {
        val step: *Step = ?order.steps[s];
        s = s + 1;
        var hit: res[bool, Fail] = res[bool, Fail].ok{false};
        if (sel step.files) { hit = files_step(c, ?step.files, name.ok, seeking, every); }
        or (sel step.majors) {
            if (every) { hit = majors_step(c, step.majors, name.ok, seeking); }
        }
        if (sel hit.err) { ret err[Fail].err{hit.err}; }
        if (hit.ok)      { ret err[Fail].ok{}; }
    }
    ret refused(c, seeking, ?c.libdirs);
}

# whether a library directory holds one of the files `f` of the name `name`
# that is taken, each directory tried for every file in order
fun files_step(c: *Finding, f: *Files, name: str, seeking: *Seeking, every: bool) res[bool, Fail] {
    var d: usize = 0;
    for (d < vector.length[str](?c.libdirs)) {
        val dir: str   = c.libdirs.data[d];
        var k:   usize = 0;
        d = d + 1;
        for (k < f.count) {
            val p: *Pattern = f.rows[k];
            k = k + 1;
            if (p.loaded && !every) { cnt; }
            val made: res[str, StrError] = str_join(c.found.a, dir, "/", p.prefix, name, p.suffix);
            val hit:  res[bool, Fail]    = candidate(c, made, seeking, p.loaded, p.loaded);
            if (sel hit.err) { ret hit; }
            if (hit.ok)      { ret hit; }
        }
    }
    ret res[bool, Fail].ok{false};
}

# a file of a major version a directory holds: its major and where the
# directory's listing holds its name
rec Versioned {
    major: u64;
    at:    usize;
}

fun by_major(x: *Versioned, y: *Versioned) i64 {
    if (x.major < y.major) { ret -1; }
    if (x.major > y.major) { ret 1; }
    ret 0;
}

# whether a library directory holds a file of a major version of the name
# `name` that is taken, each directory tried for its majors, the highest
# first
fun majors_step(c: *Finding, m: *Major, name: str, seeking: *Seeking) res[bool, Fail] {
    var d: usize = 0;
    for (d < vector.length[str](?c.libdirs)) {
        val dir: str             = c.libdirs.data[d];
        val hit: res[bool, Fail] = majors_in(c, dir, m, name, seeking);
        d = d + 1;
        if (sel hit.err) { ret hit; }
        if (hit.ok)      { ret hit; }
    }
    ret res[bool, Fail].ok{false};
}

fun majors_in(c: *Finding, dir: str, m: *Major, name: str, seeking: *Seeking) res[bool, Fail] {
    val there: res[bool, io_error.Error] = fs.is_dir(dir);
    if (sel there.err) { ret res[bool, Fail].err{file.io_refusal(there.err, "cannot tell whether the directory exists", dir)}; }
    if (!there.ok)     { ret res[bool, Fail].ok{false}; }
    val listing: res[Vector[fs.Listed], fs.FsError] = fs.read_dir(c.found.a, dir);
    if (sel listing.err) { ret res[bool, Fail].err{file.refusal(listing.err, "cannot list the directory", dir)}; }
    var entries: Vector[fs.Listed] = listing.ok;
    var found:   Vector[Versioned] = vector.init[Versioned](c.found.a);
    var listed:  err[Fail]         = err[Fail].ok{};
    var i:       usize             = 0;
    for (i < entries.len && sel listed.ok) {
        val e: fs.Listed = entries.data[i];
        i = i + 1;
        var n: opt[u64] = opt[u64].none{};
        if (sel e.name) { n = major_of(e.name, m, name); }
        if (sel n.none) { cnt; }
        val p: err[Fail] = vectors.push[Versioned](?found, Versioned{major: n.some, at: i - 1});
        if (sel p.err) { listed = err[Fail].err{p.err}; }
    }
    var out: res[bool, Fail] = res[bool, Fail].ok{false};
    if (sel listed.err) { out = res[bool, Fail].err{listed.err}; }
    or {
        sort.sort_by[Versioned](found.data, vector.length[Versioned](?found), by_major);
        out = highest(c, dir, ?entries, ?found, seeking);
    }
    fs.listed_free(?entries);
    ret settled(out, vectors.release[Versioned](?found));
}

# whether a file of the majors `found`, sorted, of the listing `entries` of
# `dir` is taken, the highest first
fun highest(c: *Finding, dir: str, entries: *Vector[fs.Listed], found: *Vector[Versioned], seeking: *Seeking) res[bool, Fail] {
    var k: usize = vector.length[Versioned](found);
    for (k > 0) {
        k = k - 1;
        val e: fs.Listed = entries.data[found.data[k].at];
        if (sel e.name) {
            val hit: res[bool, Fail] = candidate(c, str_join(c.found.a, dir, "/", e.name), seeking, true, false);
            if (sel hit.err) { ret hit; }
            if (hit.ok)      { ret hit; }
        }
    }
    ret res[bool, Fail].ok{false};
}

# `out`, or the refusal of giving back what made it when it holds none
fun settled(out: res[bool, Fail], back: err[Fail]) res[bool, Fail] {
    if (sel out.err)  { ret out; }
    if (sel back.err) { ret res[bool, Fail].err{back.err}; }
    ret out;
}

# the major version the file `file` carries as a file of the major `m` of
# the name `name`, none when it is no such file: the major is decimal, with
# no leading zero but a lone one, and fits in 64 bits
fun major_of(file: str, m: *Major, name: str) opt[u64] {
    val n:    usize = str_len(file);
    val head: usize = str_len(m.prefix) + str_len(name) + str_len(m.infix);
    val tail: usize = str_len(m.suffix);
    if (n <= head + tail)                                                                                                                                                   { ret opt[u64].none{}; }
    if (!spans(file, 0, m.prefix) || !spans(file, str_len(m.prefix), name) || !spans(file, str_len(m.prefix) + str_len(name), m.infix) || !spans(file, n - tail, m.suffix)) { ret opt[u64].none{}; }
    val digits: usize = n - head - tail;
    if (digits > 1 && file[head] == '0') { ret opt[u64].none{}; }
    var v: u64   = 0;
    var i: usize = head;
    for (i < head + digits) {
        val b: u8 = file[i];
        if (b < '0' || b > '9') { ret opt[u64].none{}; }
        val d: u64 = (b - '0')::u64;
        if (v > (0xffff_ffff_ffff_ffff - d) / 10) { ret opt[u64].none{}; }
        v = v * 10 + d;
        i = i + 1;
    }
    ret opt[u64].some{v};
}

# whether `text` lies in `s` at `at`, which is in bounds for it
fun spans(s: str, at: usize, text: str) bool {
    var i: usize = 0;
    for (i < str_len(text)) {
        if (s[at + i] != text[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the framework `w` in the first framework directory whose bundle of its
# name holds a file the naming states that is taken
fun framework(c: *Finding, naming: *Naming, w: Wanted, seeking: *Seeking) err[Fail] {
    if (naming.bundle == nil) { ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the system has no frameworks"), c.options.target.sys.name), w.name)}; }
    var d: usize = 0;
    for (d < vector.length[str](?c.fwdirs)) {
        val dir: str   = c.fwdirs.data[d];
        var k:   usize = 0;
        d = d + 1;
        for (k < naming.bundle_count) {
            val p:    *Pattern           = ?naming.bundles[k];
            val made: res[str, StrError] = str_join(c.found.a, dir, "/", w.name, naming.bundle, "/", p.prefix, w.name, p.suffix);
            val hit:  res[bool, Fail]    = candidate(c, made, seeking, p.loaded, false);
            k = k + 1;
            if (sel hit.err) { ret err[Fail].err{hit.err}; }
            if (hit.ok)      { ret err[Fail].ok{}; }
        }
    }
    ret refused(c, seeking, ?c.fwdirs);
}

# `name` without the naming's stem when it ends in it, compared without case
fun stem_of(c: *Finding, naming: *Naming, name: str) res[str, Fail] {
    if (naming.stem == nil) { ret res[str, Fail].ok{name}; }
    val n: usize = str_len(name);
    val s: usize = str_len(naming.stem);
    if (n <= s) { ret res[str, Fail].ok{name}; }
    var i: usize = 0;
    for (i < s) {
        if (folded(name[n - s + i]) != folded(naming.stem[i])) { ret res[str, Fail].ok{name}; }
        i = i + 1;
    }
    ret copied(c, name::*u8, 0, n - s);
}

fun folded(b: u8) u8 {
    if (b >= 'A' && b <= 'Z') { ret b + ('a' - 'A'); }
    ret b;
}

# whether the file at `made`, a path made for the search, is the library:
# it is a file and is taken, and its sources are entered. `loaded` says the
# file is one the loader loads, and `scripts` that it may be a linker script.
# a search for one kind takes it by what it is instead. a file not taken is
# let go with its path, leaving the search as it was
fun candidate(c: *Finding, made: res[str, StrError], seeking: *Seeking, loaded: bool, scripts: bool) res[bool, Fail] {
    val paths: usize          = vector.length[str](?c.found.paths);
    val files: usize          = vector.length[Loaded](?c.found.loaded);
    val path:  res[str, Fail] = own(c, made);
    if (sel path.err) { ret res[bool, Fail].err{path.err}; }
    val present: res[bool, Fail] = is_file(path.ok);
    if (sel present.err) { ret present; }
    if (!present.ok) {
        val gone: err[Fail] = rewind(c, paths, files);
        if (sel gone.err) { ret res[bool, Fail].err{gone.err}; }
        ret present;
    }
    val l: res[contract.Input, Fail] = load(c, path.ok);
    if (sel l.err) { ret res[bool, Fail].err{l.err}; }
    var fits: res[bool, Fail] = res[bool, Fail].ok{false};
    if (sel seeking.alone.some) { fits = of_kind(c, l.ok, seeking, seeking.alone.some); }
    or                          { fits = taken(c, l.ok, loaded, scripts); }
    if (sel fits.err)           { ret fits; }
    if (!fits.ok) {
        val gone: err[Fail] = rewind(c, paths, files);
        if (sel gone.err) { ret res[bool, Fail].err{gone.err}; }
        ret fits;
    }
    if (sel seeking.tally.some) {
        val counted: err[Fail] = count(c, l.ok, seeking.tally.some);
        if (sel counted.err) { ret res[bool, Fail].err{counted.err}; }
        val gone: err[Fail] = rewind(c, paths, files);
        if (sel gone.err) { ret res[bool, Fail].err{gone.err}; }
        ret fits;
    }
    val e: err[Fail] = enter(c, l.ok, seeking.include, true);
    if (sel e.err) { ret res[bool, Fail].err{e.err}; }
    ret res[bool, Fail].ok{true};
}

# give back every file and path the search made after it held `files` and
# `paths`, leaving it as it was then
fun rewind(c: *Finding, paths: usize, files: usize) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = vector.length[Loaded](?c.found.loaded);
    for (i > files) {
        i     = i - 1;
        first = fail.kept(first, file.unload(?c.found.loaded.data[i]));
    }
    vectors.truncate[Loaded](?c.found.loaded, files);
    i = vector.length[str](?c.found.paths);
    for (i > paths) {
        i = i - 1;
        drop(c, c.found.paths.data[i]);
    }
    vectors.truncate[str](?c.found.paths, paths);
    ret first;
}

# count what the file `in`, an entry of a linker script being sorted, is
fun count(c: *Finding, in: contract.Input, t: *Tally) err[Fail] {
    val got: res[opt[*Sort], Fail] = sorted(c, in);
    if (sel got.err) { ret err[Fail].err{got.err}; }
    val is: opt[*Sort] = got.ok;
    if (sel is.none) {
        t.foreign = true;
        ret err[Fail].ok{};
    }
    if (is.some == ?SHARED) { t.binds = true; }
    or                      { t.files = true; }
    ret err[Fail].ok{};
}

# whether the candidate `in` is the kind `alone` asks for. one of the wrong
# kind is set down for the refusal the search may end in, and one for another
# architecture counts as absent
fun of_kind(c: *Finding, in: contract.Input, seeking: *Seeking, alone: *Alone) res[bool, Fail] {
    val got: res[opt[*Sort], Fail] = sorted(c, in);
    if (sel got.err) { ret res[bool, Fail].err{got.err}; }
    val is: opt[*Sort] = got.ok;
    if (sel is.none)           { ret res[bool, Fail].ok{false}; }
    if (is.some == alone.sort) { ret res[bool, Fail].ok{true}; }
    val w: err[Fail] = found_wrong(?seeking.wrong, in.file, seeking.name, is.some, alone.sort);
    if (sel w.err) { ret res[bool, Fail].err{w.err}; }
    ret res[bool, Fail].ok{false};
}

# set down in `out` that the file `file` of the name `name` is `is`, not `asked`
fun found_wrong(out: *Sink, file: str, name: str, is: *Sort, asked: *Sort) err[Fail] {
    val w0: err[Fail] = sink.text(out, "found ");
    if (sel w0.err) { ret w0; }
    val w1: err[Fail] = sink.text(out, file);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = sink.text(out, " for ");
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = sink.text(out, name);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = sink.text(out, ": ");
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = sink.text(out, is.said);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = sink.text(out, ", not ");
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = sink.text(out, asked.said);
    if (sel w7.err) { ret w7; }
    ret sink.text(out, "\n");
}

# what the candidate `in` is, none when it is for another architecture
fun sorted(c: *Finding, in: contract.Input) res[opt[*Sort], Fail] {
    var probe: contract.Input              = in;
    val known: res[*contract.Reader, Fail] = readers.sniff(c.readers, ?probe);
    if (sel known.err) {
        var scripted: bool = false;
        if (textual(in)) { scripted = reads_scripts(c); }
        if (scripted)    { ret sorted_script(c, in); }
        ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?NEITHER}};
    }
    val m: res[Model, Fail] = shell.run(known.ok, c.found.a, ?probe);
    if (sel m.err) { ret res[opt[*Sort], Fail].err{m.err}; }
    var model: Model                 = m.ok;
    val out:   res[opt[*Sort], Fail] = sorted_model(c, ?model, in.file);
    val r:     err[Fail]             = contract.release(?model);
    if (sel out.err) { ret out; }
    if (sel r.err)   { ret res[opt[*Sort], Fail].err{r.err}; }
    ret out;
}

# what the linker script `in` is: a shared library when any file it names is,
# a static one when it names another, none when all it names are for another
# architecture, and neither when it names no file. the first file that binds
# settles it, and nothing the sorting holds outlives it
fun sorted_script(c: *Finding, in: contract.Input) res[opt[*Sort], Fail] {
    val paths: usize     = vector.length[str](?c.found.paths);
    val files: usize     = vector.length[Loaded](?c.found.loaded);
    var t:     Tally     = Tally{};
    var w:     Walk      = Walk{include: Include.referenced{}, tally: opt[*Tally].some{?t}};
    val read:  err[Fail] = script(c, in, ?w);
    if (sel read.err) { ret res[opt[*Sort], Fail].err{read.err}; }
    val gone: err[Fail] = rewind(c, paths, files);
    if (sel gone.err) { ret res[opt[*Sort], Fail].err{gone.err}; }
    if (t.binds)      { ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?SHARED}}; }
    if (t.files)      { ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?STATIC}}; }
    if (t.foreign)    { ret res[opt[*Sort], Fail].ok{opt[*Sort].none{}}; }
    ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?NEITHER}};
}

# what the model `m` of the candidate `file` is, as `sorted` states
fun sorted_model(c: *Finding, m: *Model, file: str) res[opt[*Sort], Fail] {
    val held: res[bool, Fail] = contract.is_container(m);
    if (sel held.err)  { ret res[opt[*Sort], Fail].err{held.err}; }
    if (held.ok)       { ret sorted_container(c, m, file); }
    if (foreign(c, m)) { ret res[opt[*Sort], Fail].ok{opt[*Sort].none{}}; }
    val k: res[*kind.Kind, Fail] = contract.kind(m);
    if (sel k.err)                   { ret res[opt[*Sort], Fail].err{k.err}; }
    if (kind.has(k.ok, kind.BINDS))  { ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?SHARED}}; }
    if (kind.has(k.ok, kind.OBJECT)) { ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?STATIC}}; }
    ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?NEITHER}};
}

# what the container `m` named `file` is: what its member for the link's
# architecture is when its members state theirs, else a shared library when
# any member binds and a static one otherwise
fun sorted_container(c: *Finding, m: *Model, file: str) res[opt[*Sort], Fail] {
    var members: Table[Member]         = table.make[Member](c.found.a);
    val listed:  err[Fail]             = contract.members(m, file, ?members);
    var out:     res[opt[*Sort], Fail] = res[opt[*Sort], Fail].err{fail.internal("no member was read")};
    if (sel listed.err) { out = res[opt[*Sort], Fail].err{listed.err}; }
    or {
        val fit: Fitting = fitting(c, ?members);
        if (!fit.coded)        { out = bound_by(c, ?members); }
        or (sel fit.pick.some) { out = sorted(c, fit.pick.some); }
        or                     { out = res[opt[*Sort], Fail].ok{opt[*Sort].none{}}; }
    }
    val back: err[Fail] = table.release[Member](?members);
    if (sel out.err)  { ret out; }
    if (sel back.err) { ret res[opt[*Sort], Fail].err{back.err}; }
    ret out;
}

# a shared library when any of `members` binds, asked of each member's own
# format from its headers, and a static one otherwise. the walk stops at the
# first that binds and reads no member's model. a member no format reads
# binds nothing
fun bound_by(c: *Finding, members: *Table[Member]) res[opt[*Sort], Fail] {
    var i: usize = 0;
    for (i < table.count[Member](members)) {
        var in: contract.Input = table.at[Member](members, table.nth[Member](i)).input;
        i = i + 1;
        val known: res[*contract.Reader, Fail] = readers.sniff(c.readers, ?in);
        if (sel known.err) { cnt; }
        val binds: res[bool, Fail] = known.ok.codec.binds(?in);
        if (sel binds.err) { ret res[opt[*Sort], Fail].err{binds.err}; }
        if (binds.ok)      { ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?SHARED}}; }
    }
    ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?STATIC}};
}

# what a container's members state of the link's architecture
# ---
# coded: a member states its architecture
# pick:  the first member for the link's architecture
rec Fitting {
    coded: bool;
    pick:  opt[contract.Input];
}

fun fitting(c: *Finding, members: *Table[Member]) Fitting {
    var fit: Fitting = Fitting{};
    var i:   usize   = 0;
    for (i < table.count[Member](members)) {
        val member: *Member = table.at[Member](members, table.nth[Member](i));
        i = i + 1;
        if (sel member.arch.none) { cnt; }
        fit.coded = true;
        var code: Stated           = member.arch.some;
        val row:  res[*Arch, Fail] = arch_list.by_code(?code);
        val fits: bool             = sel row.ok && row.ok == c.options.target.arch;
        if (sel fit.pick.none && fits) { fit.pick = opt[contract.Input].some{member.input}; }
    }
    ret fit;
}

# whether the model `m` states an architecture other than the link's
fun foreign(c: *Finding, m: *Model) bool {
    val stated: opt[Stated] = contract.stated(m);
    if (sel stated.none) { ret false; }
    var code: Stated           = stated.some;
    val row:  res[*Arch, Fail] = arch_list.by_code(?code);
    ret !(sel row.ok && row.ok == c.options.target.arch);
}

# whether a regular file lies at `path`, refused when that cannot be told
fun is_file(path: str) res[bool, Fail] {
    val f: res[bool, io_error.Error] = fs.is_file(path);
    if (sel f.err) { ret res[bool, Fail].err{file.io_refusal(f.err, "cannot tell whether the file exists", path)}; }
    ret res[bool, Fail].ok{f.ok};
}

# refuse the search `seeking`, which took nothing from `dirs`
fun refused(c: *Finding, seeking: *Seeking, dirs: *Vector[str]) err[Fail] {
    if (sel seeking.alone.none) { ret unfound(c, seeking.name, dirs); }
    val alone: *Alone    = seeking.alone.some;
    val w:     err[Fail] = searched(c, alone.sought, seeking.name, dirs);
    if (sel w.err)                     { ret w; }
    if (sink.len(?seeking.wrong) == 0) { ret err[Fail].err{fail.about(fail.missing(alone.missed), seeking.name)}; }
    val n: err[Fail] = sink.bytes(c.notes, sink.data(?seeking.wrong), sink.len(?seeking.wrong));
    if (sel n.err) { ret n; }
    ret err[Fail].err{fail.about(fail.missing(alone.wrong), seeking.name)};
}

# refuse the name `name` found in none of `dirs`, each written to the notes
fun unfound(c: *Finding, name: str, dirs: *Vector[str]) err[Fail] {
    val w: err[Fail] = searched(c, "", name, dirs);
    if (sel w.err) { ret w; }
    ret err[Fail].err{fail.about(fail.missing("no directory searched holds a file of the name"), name)};
}

# write each of `dirs` to the notes as searched for `what` and the name `name`
fun searched(c: *Finding, what: str, name: str, dirs: *Vector[str]) err[Fail] {
    var d: usize = 0;
    for (d < vector.length[str](dirs)) {
        val w0: err[Fail] = sink.text(c.notes, "searched for ");
        if (sel w0.err) { ret w0; }
        val wk: err[Fail] = sink.text(c.notes, what);
        if (sel wk.err) { ret wk; }
        val w1: err[Fail] = sink.text(c.notes, name);
        if (sel w1.err) { ret w1; }
        val w2: err[Fail] = sink.text(c.notes, " in ");
        if (sel w2.err) { ret w2; }
        val w3: err[Fail] = sink.text(c.notes, dirs.data[d]);
        if (sel w3.err) { ret w3; }
        val w4: err[Fail] = sink.text(c.notes, "\n");
        if (sel w4.err) { ret w4; }
        d = d + 1;
    }
    ret err[Fail].ok{};
}

# the whole of the file at `path`, held until the search is released
fun load(c: *Finding, path: str) res[contract.Input, Fail] {
    val l: res[Loaded, Fail] = file.load(c.found.a, path);
    if (sel l.err) { ret res[contract.Input, Fail].err{l.err}; }
    var held: Loaded    = l.ok;
    val p:    err[Fail] = vectors.push[Loaded](?c.found.loaded, held);
    if (sel p.err) {
        val gone: err[Fail] = file.unload(?held);
        ret res[contract.Input, Fail].err{p.err};
    }
    ret res[contract.Input, Fail].ok{held.input};
}

# whether the candidate `in` is taken. a file the loader loads is taken when
# it is a shared library stating the link's architecture or none, a
# container holding such a member for the architecture, an archive whose
# members state none, or, where `scripts` says it may be, a linker script.
# any other file is taken unless it states another architecture, and one of
# no format mink reads is left to be read as a script or refused by the link
fun taken(c: *Finding, in: contract.Input, loaded: bool, scripts: bool) res[bool, Fail] {
    var probe: contract.Input              = in;
    val known: res[*contract.Reader, Fail] = readers.sniff(c.readers, ?probe);
    if (sel known.err) {
        if (!loaded)                  { ret res[bool, Fail].ok{true}; }
        if (!scripts || !textual(in)) { ret res[bool, Fail].ok{false}; }
        ret res[bool, Fail].ok{reads_scripts(c)};
    }
    val m: res[Model, Fail] = shell.run(known.ok, c.found.a, ?probe);
    if (sel m.err) { ret res[bool, Fail].err{m.err}; }
    var model: Model           = m.ok;
    val out:   res[bool, Fail] = judged(c, ?model, in.file, loaded);
    val r:     err[Fail]       = contract.release(?model);
    if (sel out.err) { ret out; }
    if (sel r.err)   { ret res[bool, Fail].err{r.err}; }
    ret out;
}

# whether the model `m` of the candidate `file` is taken, as `taken` states
fun judged(c: *Finding, m: *Model, file: str, loaded: bool) res[bool, Fail] {
    val held: res[bool, Fail] = contract.is_container(m);
    if (sel held.err)  { ret held; }
    if (held.ok)       { ret holds(c, m, file, loaded); }
    if (foreign(c, m)) { ret res[bool, Fail].ok{false}; }
    if (!loaded)       { ret res[bool, Fail].ok{true}; }
    val k: res[*kind.Kind, Fail] = contract.kind(m);
    if (sel k.err) { ret res[bool, Fail].err{k.err}; }
    ret res[bool, Fail].ok{kind.has(k.ok, kind.BINDS)};
}

# whether the container `m` named `file` is taken: an archive whose members
# state no architecture is, and one whose members state theirs is when the
# member for the link's architecture is
fun holds(c: *Finding, m: *Model, file: str, loaded: bool) res[bool, Fail] {
    var members: Table[Member]   = table.make[Member](c.found.a);
    val listed:  err[Fail]       = contract.members(m, file, ?members);
    var out:     res[bool, Fail] = res[bool, Fail].ok{true};
    if (sel listed.err) { out = res[bool, Fail].err{listed.err}; }
    var fit: Fitting = fitting(c, ?members);
    var ok:  bool    = sel out.ok;
    if (ok && fit.coded) {
        out = res[bool, Fail].ok{false};
        if (sel fit.pick.some) { out = taken(c, fit.pick.some, loaded, false); }
    }
    ret settled(out, table.release[Member](?members));
}

# the file at `path`, read and entered
fun named(c: *Finding, path: str, include: Include, searched: bool) err[Fail] {
    val l: res[contract.Input, Fail] = load(c, path);
    if (sel l.err) { ret err[Fail].err{l.err}; }
    ret enter(c, l.ok, include, searched);
}

# enter the bytes `in` of the file `in.file`: as a source when a format reads
# them, with the file's absolute path, else as a GNU linker script where the
# system reads them, else as a source the link refuses
fun enter(c: *Finding, in: contract.Input, include: Include, searched: bool) err[Fail] {
    var probe: contract.Input              = in;
    val known: res[*contract.Reader, Fail] = readers.sniff(c.readers, ?probe);
    if (sel known.err) {
        if (reads_scripts(c)) {
            var w: Walk = Walk{include: include, searched: searched};
            ret script(c, in, ?w);
        }
    }
    val path: res[str, Fail] = absolute(c, in.file);
    if (sel path.err) { ret err[Fail].err{path.err}; }
    val s: Source    = Source.included{Included{input: in, include: include, searched: searched, path: path.ok}};
    val p: err[Fail] = vectors.push[Source](c.sources, s);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the absolute path of `path`: itself when absolute, else under the working
# directory, read once
fun absolute(c: *Finding, path: str) res[str, Fail] {
    if (is_abs(path)) { ret res[str, Fail].ok{path}; }
    if (c.cwd == nil) {
        val d: res[OwnedString, env.EnvError] = env.current_dir(c.found.a);
        if (sel d.err) {
            val e: env.EnvError = d.err;
            if (sel e.alloc) { ret res[str, Fail].err{fail.refused(e.alloc)}; }
            ret res[str, Fail].err{fail.io("cannot read the working directory a relative path lies in")};
        }
        var held: OwnedString    = d.ok;
        val made: res[str, Fail] = own(c, str_join(c.found.a, held.data));
        val back: err[A.Error]   = owned_release(?held);
        if (sel made.err) { ret made; }
        if (sel back.err) { ret res[str, Fail].err{fail.refused(back.err)}; }
        c.cwd = made.ok;
    }
    ret own(c, str_join(c.found.a, c.cwd, "/", path));
}

# a span of a script's bytes
rec Span {
    at:  usize;
    len: usize;
}

# a token of a script
# ---
# end:   the script ends
# open:  an opening parenthesis
# close: a closing parenthesis
# word:  a name, a path or an entry
tag Token: u8 {
    end;
    open;
    close;
    word: Span;
}

# where a script is read
rec Lexer {
    data: *u8;
    len:  usize;
    at:   usize;
}

# a byte that separates tokens: white space, and a comma, which a list may
# separate its entries by
fun blank(b: u8) bool {
    ret b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == '\x0b' || b == '\x0c' || b == ',';
}

# whether `in` holds text: no control byte but white space
fun textual(in: contract.Input) bool {
    var i: usize = 0;
    for (i < in.len) {
        val b: u8 = in.data[i];
        if ((b < ' ' && !blank(b)) || b == '\x7f') { ret false; }
        i = i + 1;
    }
    ret true;
}

# the next token, past white space and comments
fun lex(l: *Lexer) res[Token, Fail] {
    for (l.at < l.len) {
        val b: u8 = l.data[l.at];
        if (blank(b)) {
            l.at = l.at + 1;
            cnt;
        }
        if (b != '/' || l.at + 1 >= l.len || l.data[l.at + 1] != '*') { brk; }
        var k:      usize = l.at + 2;
        var closed: bool  = false;
        for (k + 1 < l.len && !closed) {
            if (l.data[k] == '*' && l.data[k + 1] == '/') { closed = true; }
            or                                            { k = k + 1; }
        }
        if (!closed) { ret res[Token, Fail].err{fail.at_offset(fail.malformed("a linker script's comment is not closed"), l.at::u64)}; }
        l.at = k + 2;
    }
    if (l.at >= l.len) { ret res[Token, Fail].ok{Token.end{}}; }
    val b: u8 = l.data[l.at];
    if (b == '(') {
        l.at = l.at + 1;
        ret res[Token, Fail].ok{Token.open{}};
    }
    if (b == ')') {
        l.at = l.at + 1;
        ret res[Token, Fail].ok{Token.close{}};
    }
    val start: usize = l.at;
    for (l.at < l.len && !blank(l.data[l.at]) && l.data[l.at] != '(' && l.data[l.at] != ')') {
        l.at = l.at + 1;
    }
    ret res[Token, Fail].ok{Token.word{Span{at: start, len: l.at - start}}};
}

# whether the word `w` of `l` is `text`
fun spelled(l: *Lexer, w: Span, text: str) bool {
    if (str_len(text) != w.len) { ret false; }
    var i: usize = 0;
    for (i < w.len) {
        if (l.data[w.at + i] != text[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# read the GNU linker script `in`, as `w` states what becomes of what it names
fun script(c: *Finding, in: contract.Input, w: *Walk) err[Fail] {
    if (!textual(in))            { ret err[Fail].err{fail.in_file(fail.unsupported("the file is of no format mink reads, nor a GNU linker script"), in.file)}; }
    if (c.depth >= SCRIPT_DEPTH) { ret err[Fail].err{fail.in_file(fail.malformed("linker scripts name one another more deeply than mink follows"), in.file)}; }
    c.depth = c.depth + 1;
    var l: Lexer     = Lexer{data: in.data, len: in.len};
    val r: err[Fail] = commands(c, ?l, in.file, w);
    c.depth = c.depth - 1;
    if (sel r.err) { ret err[Fail].err{fail.in_file(r.err, in.file)}; }
    ret err[Fail].ok{};
}

# the commands of the script `file` read through `l`
fun commands(c: *Finding, l: *Lexer, file: str, walk: *Walk) err[Fail] {
    for {
        val t: res[Token, Fail] = lex(l);
        if (sel t.err) { ret err[Fail].err{t.err}; }
        val tok: Token = t.ok;
        if (sel tok.end) { ret err[Fail].ok{}; }
        or (sel tok.word) {
            val w: Span = tok.word;
            if (spelled(l, w, "GROUP") || spelled(l, w, "INPUT")) {
                val e: err[Fail] = list(c, l, file, walk);
                if (sel e.err) { ret e; }
                cnt;
            }
            if (spelled(l, w, "OUTPUT_FORMAT")) {
                val e: err[Fail] = skipped(l);
                if (sel e.err) { ret e; }
                cnt;
            }
            val name: res[str, Fail] = copied(c, l.data, w.at, w.len);
            if (sel name.err) { ret err[Fail].err{name.err}; }
            ret err[Fail].err{fail.about(fail.at_offset(fail.unsupported("a linker script command mink does not read"), w.at::u64), name.ok)};
        }
        ret err[Fail].err{fail.at_offset(fail.malformed("a linker script holds a parenthesis outside a command"), l.at::u64)};
    }
    ret err[Fail].ok{};
}

# the opening parenthesis a command's arguments follow
fun opened(l: *Lexer) err[Fail] {
    val t: res[Token, Fail] = lex(l);
    if (sel t.err) { ret err[Fail].err{t.err}; }
    val tok: Token = t.ok;
    if (sel tok.open) { ret err[Fail].ok{}; }
    ret err[Fail].err{fail.at_offset(fail.malformed("a linker script command is not followed by its parenthesis"), l.at::u64)};
}

# the arguments of a command the link needs nothing of, words up to its
# closing parenthesis
fun skipped(l: *Lexer) err[Fail] {
    val o: err[Fail] = opened(l);
    if (sel o.err) { ret o; }
    for {
        val t: res[Token, Fail] = lex(l);
        if (sel t.err) { ret err[Fail].err{t.err}; }
        val tok: Token = t.ok;
        if (sel tok.close) { ret err[Fail].ok{}; }
        or (sel tok.word)  { cnt; }
        or (sel tok.end)   { ret err[Fail].err{fail.at_offset(fail.malformed("a linker script command's parenthesis is not closed"), l.at::u64)}; }
        ret err[Fail].err{fail.at_offset(fail.malformed("a linker script command's arguments hold a parenthesis"), l.at::u64)};
    }
    ret err[Fail].ok{};
}

# the entries of a GROUP, an INPUT or an AS_NEEDED list, each taken as `walk`
# states, those of an AS_NEEDED list entering only when referenced
fun list(c: *Finding, l: *Lexer, file: str, walk: *Walk) err[Fail] {
    val o: err[Fail] = opened(l);
    if (sel o.err) { ret o; }
    for {
        val t: res[Token, Fail] = lex(l);
        if (sel t.err) { ret err[Fail].err{t.err}; }
        val tok: Token = t.ok;
        if (sel tok.close) { ret err[Fail].ok{}; }
        or (sel tok.word) {
            val w: Span = tok.word;
            if (spelled(l, w, "AS_NEEDED")) {
                var needed: Walk = @walk;
                needed.include = Include.referenced{};
                val e: err[Fail] = list(c, l, file, ?needed);
                if (sel e.err) { ret e; }
                cnt;
            }
            val e: err[Fail] = entry(c, l, w, file, walk);
            if (sel e.err) { ret err[Fail].err{fail.at_offset(e.err, w.at::u64)}; }
            cnt;
        }
        or (sel tok.end) { ret err[Fail].err{fail.at_offset(fail.malformed("a linker script list is not closed"), l.at::u64)}; }
        ret err[Fail].err{fail.at_offset(fail.malformed("a linker script list holds a parenthesis"), l.at::u64)};
    }
    ret err[Fail].ok{};
}

# the entry `w` of the script `file`: a library by name after -l, an
# absolute path, under the sysroot when the script lies under it, or a
# relative one, in the working directory or else a library directory. an
# entry of a script already known to bind is not looked for
fun entry(c: *Finding, l: *Lexer, w: Span, file: str, walk: *Walk) err[Fail] {
    if (sel walk.tally.some && walk.tally.some.binds) { ret err[Fail].ok{}; }
    val text: res[str, Fail] = copied(c, l.data, w.at, w.len);
    if (sel text.err) { ret err[Fail].err{text.err}; }
    val t: str = text.ok;
    if (w.len > 2 && t[0] == '-' && t[1] == 'l') { ret library(c, Wanted{form: Form.system{}, name: (?t[2])::str, include: walk.include, prefer: c.prefer}, walk.tally); }
    if (is_abs(t)) {
        val root: str = c.options.sysroot;
        if (root == nil || !str_starts_with(file, root)) { ret walked(c, t, walk); }
        val under: res[str, Fail] = own(c, str_join(c.found.a, root, t));
        if (sel under.err) { ret err[Fail].err{under.err}; }
        ret walked(c, under.ok, walk);
    }
    val here: res[bool, Fail] = is_file(t);
    if (sel here.err) { ret err[Fail].err{here.err}; }
    if (here.ok)      { ret walked(c, t, walk); }
    val listing: err[Fail] = listed(c);
    if (sel listing.err) { ret listing; }
    var d: usize = 0;
    for (d < vector.length[str](?c.libdirs)) {
        val dir:  str            = c.libdirs.data[d];
        val made: res[str, Fail] = own(c, str_join(c.found.a, dir, "/", t));
        d = d + 1;
        if (sel made.err) { ret err[Fail].err{made.err}; }
        val present: res[bool, Fail] = is_file(made.ok);
        if (sel present.err) { ret err[Fail].err{present.err}; }
        if (present.ok)      { ret walked(c, made.ok, walk); }
    }
    ret unfound(c, t, ?c.libdirs);
}

# the file at `path` a script names, entered or counted as `walk` states
fun walked(c: *Finding, path: str, walk: *Walk) err[Fail] {
    if (sel walk.tally.none) { ret named(c, path, walk.include, walk.searched); }
    val paths: usize                     = vector.length[str](?c.found.paths);
    val files: usize                     = vector.length[Loaded](?c.found.loaded);
    val l:     res[contract.Input, Fail] = load(c, path);
    if (sel l.err) { ret err[Fail].err{l.err}; }
    val counted: err[Fail] = count(c, l.ok, walk.tally.some);
    if (sel counted.err) { ret counted; }
    ret rewind(c, paths, files);
}
