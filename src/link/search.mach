# a link's inputs as its caller names them
#
# a link names each input as a file at a path, as a library or a framework by
# name, or as a source it holds in memory, in link order, each library with
# whether the image loads it when no live import references it. a name is
# looked for through the search the catalog states for the link's system,
# environment and architecture: in the directories the link adds, then in
# the system's directories under the sysroot, each directory tried for every
# file the system's naming states in order, a file the loader loads only for
# an output kind that imports. a file whose model states another
# architecture is skipped, as GNU ld skips an incompatible library. a file no
# format reads is read as a GNU linker script where the naming says the
# system's linker reads them: its GROUP and INPUT entries enter in order, as
# the script is included, and those inside AS_NEEDED only when referenced.
# OUTPUT_FORMAT names nothing the link needs, since every file an entry names
# is checked for the link's architecture as it is read, and any other command
# is refused naming it. an entry `-l<name>` is a library by name, an absolute
# path lies under the sysroot when the script does, and a relative one is
# looked for in the working directory, then in the library directories. a
# name or an entry found nowhere is refused naming it, with every directory
# searched written to the link's notes.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A:        std.allocator;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.memory;
use std.types.path.is_abs;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Stated;
use arch_list: mink.catalog.arch.list;
use mink.catalog.os;
use mink.catalog.os.Naming;
use mink.catalog.os.Pattern;
use mink.catalog.os.System;
use mink.catalog.output;
use mink.format.contract;
use mink.format.contract.Model;
use mink.format.file;
use mink.format.file.Loaded;
use mink.format.readers;
use mink.format.readers.Readers;
use mink.format.registry.Registry;
use mink.link.input.Include;
use mink.link.input.Included;
use mink.link.input.Source;
use mink.link.options.Options;
use mink.link.state;

# what a link names by name
# ---
# system:    a library, looked for as the naming's files in the library
#            directories
# framework: a framework, looked for as the naming's bundle files in the
#            framework directories
pub tag Form: u8 {
    system;
    framework;
}

# a library or a framework a link names
# ---
# form:    which it is
# name:    its name, as `m` names libm and `Cocoa` the Cocoa framework
# include: whether the image loads it when no live import references it
pub rec Wanted {
    form:    Form;
    name:    str;
    include: Include;
}

# a file a link names by its path
# ---
# path:    the path, borrowed for as long as the link's refusal is reported
# include: whether the image loads the library the file describes when no
#          live import references it
pub rec File {
    path:    str;
    include: Include;
}

# one input of a link as its caller names it
# ---
# source:  what the caller holds, linked as the source states
# file:    a file at a path
# library: a library or a framework found by name
pub tag Request: u8 {
    source:  Source;
    file:    File;
    library: Wanted;
}

# what a link's search made and loaded, which every name its refusal carries
# may point into, so it is released once the refusal is reported
# ---
# paths:  the paths and names it made, each a zero after it
# loaded: the files it loaded
pub rec Found {
    a:      *A.Allocator;
    paths:  Table[str];
    loaded: Table[Loaded];
}

# the most linker scripts one may name in a chain, one naming the next
val SCRIPT_DEPTH: usize = 16;

# found:   where what the search makes is held
# readers: the formats a file is sniffed through
# options: the link's options
# notes:   where the directories a refused search tried are written
# sources: the sources the requests resolve to, in link order
# search:  the catalog's search for the link, once known
# system:  the link's system, once the search is known
# known:   whether it is
# libdirs: the directories a library is searched in, in order, once listed
# fwdirs:  the directories a framework is searched in, in order, once listed
# listed:  whether they are
# depth:   how many linker scripts the one being read lies inside
rec Context {
    found:   *Found;
    readers: *Readers;
    options: *Options;
    notes:   *Sink;
    sources: *Table[Source];
    search:  os.Search;
    system:  *System;
    known:   bool;
    libdirs: Table[str];
    fwdirs:  Table[str];
    listed:  bool;
    depth:   usize;
}

pub fun make(a: *A.Allocator) Found {
    ret Found{a: a, paths: table.make[str](a), loaded: table.make[Loaded](a)};
}

# give back every file loaded and every path made, reporting the first
# refusal
pub fun release(f: *Found) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[Loaded](?f.loaded)) {
        first = fail.kept(first, file.unload(table.at[Loaded](?f.loaded, table.nth[Loaded](i))));
        i     = i + 1;
    }
    first = fail.kept(first, table.release[Loaded](?f.loaded));
    i     = 0;
    for (i < table.count[str](?f.paths)) {
        val s: str          = @table.at[str](?f.paths, table.nth[str](i));
        val d: err[A.Error] = A.deallocate[char](f.a, s, str_len(s) + 1);
        if (sel d.err) { first = fail.kept(first, err[Fail].err{fail.refused(d.err)}); }
        i = i + 1;
    }
    ret fail.kept(first, table.release[str](?f.paths));
}

# link the `count` requests at `requests` through the formats of `g` in one
# call, each resolved in order to the sources it names, what the search
# makes held in `f`. the image's bytes are returned and the link's report is
# appended to `notes`, or when it is refused, what its refusal cannot carry
pub fun link(f: *Found, g: *Registry, o: Options, requests: *Request, count: usize, notes: *Sink) res[Sink, Fail] {
    var sources: Table[Source] = table.make[Source](f.a);
    var stated:  Options       = o;
    var c:       Context       = Context{
        found:   f,
        readers: ?g.readers,
        options: ?stated,
        notes:   notes,
        sources: ?sources,
        libdirs: table.make[str](f.a),
        fwdirs:  table.make[str](f.a),
    };
    var e: err[Fail] = err[Fail].ok{};
    var i: usize     = 0;
    for (i < count && sel e.ok) {
        e = request(?c, ?requests[i]);
        i = i + 1;
    }
    var out: res[Sink, Fail];
    if (sel e.err) { out = res[Sink, Fail].err{e.err}; }
    or             { out = state.link(f.a, g, o, table.items[Source](?sources), table.count[Source](?sources), notes); }
    var back: err[Fail] = table.release[Source](?sources);
    back = fail.kept(back, table.release[str](?c.libdirs));
    back = fail.kept(back, table.release[str](?c.fwdirs));
    if (sel out.err) { ret out; }
    if (sel back.err) {
        var image:   Sink      = out.ok;
        val dropped: err[Fail] = sink.release(?image);
        ret res[Sink, Fail].err{back.err};
    }
    ret out;
}

fun request(c: *Context, r: *Request) err[Fail] {
    if (sel r.source) {
        val p: res[table.Id[Source], Fail] = table.push[Source](c.sources, r.source);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        ret err[Fail].ok{};
    }
    or (sel r.file) {
        ret named(c, r.file.path, r.file.include, false);
    }
    ret library(c, r.library);
}

# the catalog's search for the link's system, environment and architecture
fun row(c: *Context) res[*os.Search, Fail] {
    if (c.known) { ret res[*os.Search, Fail].ok{?c.search}; }
    val system: opt[*System] = c.options.target.system;
    if (sel system.none)              { ret res[*os.Search, Fail].err{fail.malformed("the link names no system, whose directories a name is searched in")}; }
    if (c.options.target.arch == nil) { ret res[*os.Search, Fail].err{fail.malformed("the link names no architecture, whose directories a name is searched in")}; }
    val s: res[os.Search, Fail] = os.search(system.some, c.options.target.env, c.options.target.arch);
    if (sel s.err) { ret res[*os.Search, Fail].err{s.err}; }
    c.search = s.ok;
    c.system = system.some;
    c.known  = true;
    ret res[*os.Search, Fail].ok{?c.search};
}

# whether the link's system reads a library file no format reads as a GNU
# linker script. a link naming no system reads none, and is refused by the
# link itself
fun reads_scripts(c: *Context) res[bool, Fail] {
    val system: opt[*System] = c.options.target.system;
    if (sel system.none || c.options.target.arch == nil) { ret res[bool, Fail].ok{false}; }
    val s: res[*os.Search, Fail] = row(c);
    if (sel s.err) { ret res[bool, Fail].err{s.err}; }
    val n: opt[*Naming] = s.ok.naming;
    if (sel n.none) { ret res[bool, Fail].ok{false}; }
    ret res[bool, Fail].ok{n.some.scripts};
}

# hold `r`, a string made for the search, until the search is released
fun own(c: *Context, r: res[str, StrError]) res[str, Fail] {
    if (sel r.err) {
        val e: StrError = r.err;
        if (sel e.alloc) { ret res[str, Fail].err{fail.refused(e.alloc)}; }
        ret res[str, Fail].err{fail.internal("a path could not be made")};
    }
    val p: res[table.Id[str], Fail] = table.push[str](?c.found.paths, r.ok);
    if (sel p.err) {
        drop(c, r.ok);
        ret res[str, Fail].err{p.err};
    }
    ret res[str, Fail].ok{r.ok};
}

# give back `s`, a string made for the search and not held
fun drop(c: *Context, s: str) {
    val d: err[A.Error] = A.deallocate[char](c.found.a, s, str_len(s) + 1);
}

# the `len` bytes at `at` of `data`, held with a zero after them
fun copied(c: *Context, data: *u8, at: usize, len: usize) res[str, Fail] {
    val got: res[str, A.Error] = A.allocate[char](c.found.a, len + 1);
    if (sel got.err) { ret res[str, Fail].err{fail.refused(got.err)}; }
    memory.raw_copy(got.ok::ptr, (data::usize + at)::ptr, len);
    got.ok[len] = 0;
    ret own(c, res[str, StrError].ok{got.ok});
}

# list the directories a library and a framework are searched in: those the
# link adds, then the system's under the sysroot
fun listed(c: *Context) err[Fail] {
    if (c.listed) { ret err[Fail].ok{}; }
    val s: res[*os.Search, Fail] = row(c);
    if (sel s.err) { ret err[Fail].err{s.err}; }
    val o: *Options = c.options;
    var i: usize    = 0;
    for (i < o.libdir_count) {
        val e: err[Fail] = listed_one(c, ?c.libdirs, nil, o.libdirs[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    i = 0;
    for (i < s.ok.libdir_count) {
        val e: err[Fail] = listed_one(c, ?c.libdirs, o.sysroot, s.ok.libdirs[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    i = 0;
    for (i < o.fwdir_count) {
        val e: err[Fail] = listed_one(c, ?c.fwdirs, nil, o.fwdirs[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    i = 0;
    for (i < s.ok.framework_count) {
        val e: err[Fail] = listed_one(c, ?c.fwdirs, o.sysroot, s.ok.frameworks[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    c.listed = true;
    ret err[Fail].ok{};
}

# append `dir` under `root`, nil for none, to `into`
fun listed_one(c: *Context, into: *Table[str], root: str, dir: str) err[Fail] {
    val d: res[str, Fail] = own(c, str_join(c.found.a, root, dir));
    if (sel d.err) { ret err[Fail].err{d.err}; }
    val p: res[table.Id[str], Fail] = table.push[str](into, d.ok);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the library or the framework `w`, found by its name
fun library(c: *Context, w: Wanted) err[Fail] {
    val s: res[*os.Search, Fail] = row(c);
    if (sel s.err) { ret err[Fail].err{s.err}; }
    val n: opt[*Naming] = s.ok.naming;
    if (sel n.none)            { ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the system's linker finds no library by name"), c.system.name), w.name)}; }
    if (c.options.kind == nil) { ret err[Fail].err{fail.about(fail.malformed("the link names no output kind, which decides the files a name is looked for as"), w.name)}; }
    val l: err[Fail] = listed(c);
    if (sel l.err)            { ret l; }
    if (sel w.form.framework) { ret framework(c, n.some, w); }
    ret system_library(c, n.some, w);
}

# the library `w` in the first library directory holding a file of its
# name the naming states, its stem dropped first
fun system_library(c: *Context, naming: *Naming, w: Wanted) err[Fail] {
    val name: res[str, Fail] = stem_of(c, naming, w.name);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    val imports: bool  = output.has(c.options.kind, output.IMPORTS);
    var d:       usize = 0;
    for (d < table.count[str](?c.libdirs)) {
        val dir: str   = @table.at[str](?c.libdirs, table.nth[str](d));
        var k:   usize = 0;
        d = d + 1;
        for (k < naming.file_count) {
            val p: *Pattern = ?naming.files[k];
            k = k + 1;
            if (p.loaded && !imports) { cnt; }
            val made: res[str, StrError] = str_join(c.found.a, dir, "/", p.prefix, name.ok, p.suffix);
            val hit:  res[bool, Fail]    = candidate(c, made, w.include);
            if (sel hit.err) { ret err[Fail].err{hit.err}; }
            if (hit.ok)      { ret err[Fail].ok{}; }
        }
    }
    ret unfound(c, w.name, ?c.libdirs);
}

# the framework `w` in the first framework directory whose bundle of its
# name holds a file the naming states
fun framework(c: *Context, naming: *Naming, w: Wanted) err[Fail] {
    if (naming.bundle == nil) { ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the system has no frameworks"), c.system.name), w.name)}; }
    var d: usize = 0;
    for (d < table.count[str](?c.fwdirs)) {
        val dir: str   = @table.at[str](?c.fwdirs, table.nth[str](d));
        var k:   usize = 0;
        d = d + 1;
        for (k < naming.bundle_count) {
            val p:    *Pattern           = ?naming.bundles[k];
            val made: res[str, StrError] = str_join(c.found.a, dir, "/", w.name, naming.bundle, "/", p.prefix, w.name, p.suffix);
            val hit:  res[bool, Fail]    = candidate(c, made, w.include);
            k = k + 1;
            if (sel hit.err) { ret err[Fail].err{hit.err}; }
            if (hit.ok)      { ret err[Fail].ok{}; }
        }
    }
    ret unfound(c, w.name, ?c.fwdirs);
}

# `name` without the naming's stem when it ends in it, compared without case
fun stem_of(c: *Context, naming: *Naming, name: str) res[str, Fail] {
    if (naming.stem == nil) { ret res[str, Fail].ok{name}; }
    val n: usize = str_len(name);
    val s: usize = str_len(naming.stem);
    if (n <= s) { ret res[str, Fail].ok{name}; }
    var i: usize = 0;
    for (i < s) {
        if (folded(name[n - s + i]) != folded(naming.stem[i])) { ret res[str, Fail].ok{name}; }
        i = i + 1;
    }
    ret copied(c, name::*u8, 0, n - s);
}

fun folded(b: u8) u8 {
    if (b >= 'A' && b <= 'Z') { ret b + ('a' - 'A'); }
    ret b;
}

# whether the file at `made`, a path made for the search, is the library:
# it is a file and states no other architecture, and its sources are entered
fun candidate(c: *Context, made: res[str, StrError], include: Include) res[bool, Fail] {
    val path: res[str, Fail] = own(c, made);
    if (sel path.err) { ret res[bool, Fail].err{path.err}; }
    val present: res[bool, Fail] = is_file(path.ok);
    if (sel present.err) { ret present; }
    if (!present.ok)     { ret res[bool, Fail].ok{false}; }
    val l: res[contract.Input, Fail] = load(c, path.ok);
    if (sel l.err) { ret res[bool, Fail].err{l.err}; }
    val fits: res[bool, Fail] = compatible(c, l.ok);
    if (sel fits.err) { ret fits; }
    if (!fits.ok)     { ret res[bool, Fail].ok{false}; }
    val e: err[Fail] = enter(c, l.ok, include, true);
    if (sel e.err) { ret res[bool, Fail].err{e.err}; }
    ret res[bool, Fail].ok{true};
}

# whether a regular file lies at `path`, refused when that cannot be told
fun is_file(path: str) res[bool, Fail] {
    val f: res[bool, io_error.Error] = fs.is_file(path);
    if (sel f.err) { ret res[bool, Fail].err{fail.in_file(fail.io("cannot tell whether the file exists"), path)}; }
    ret res[bool, Fail].ok{f.ok};
}

# refuse the name `name` found in none of `dirs`, each written to the notes
fun unfound(c: *Context, name: str, dirs: *Table[str]) err[Fail] {
    var d: usize = 0;
    for (d < table.count[str](dirs)) {
        val w0: err[Fail] = sink.text(c.notes, "searched for ");
        if (sel w0.err) { ret w0; }
        val w1: err[Fail] = sink.text(c.notes, name);
        if (sel w1.err) { ret w1; }
        val w2: err[Fail] = sink.text(c.notes, " in ");
        if (sel w2.err) { ret w2; }
        val w3: err[Fail] = sink.text(c.notes, @table.at[str](dirs, table.nth[str](d)));
        if (sel w3.err) { ret w3; }
        val w4: err[Fail] = sink.text(c.notes, "\n");
        if (sel w4.err) { ret w4; }
        d = d + 1;
    }
    ret err[Fail].err{fail.about(fail.io("no directory searched holds a file of the name"), name)};
}

# the whole of the file at `path`, held until the search is released
fun load(c: *Context, path: str) res[contract.Input, Fail] {
    val l: res[Loaded, Fail] = file.load(c.found.a, path);
    if (sel l.err) { ret res[contract.Input, Fail].err{l.err}; }
    var held: Loaded                      = l.ok;
    val p:    res[table.Id[Loaded], Fail] = table.push[Loaded](?c.found.loaded, held);
    if (sel p.err) {
        val gone: err[Fail] = file.unload(?held);
        ret res[contract.Input, Fail].err{p.err};
    }
    ret res[contract.Input, Fail].ok{held.input};
}

# whether `in` states the link's architecture or none. a file of no format
# mink reads is left to be read as a script or refused by the link
fun compatible(c: *Context, in: contract.Input) res[bool, Fail] {
    var probe: contract.Input              = in;
    val known: res[*contract.Reader, Fail] = readers.sniff(c.readers, ?probe);
    if (sel known.err) { ret res[bool, Fail].ok{true}; }
    val m: res[Model, Fail] = readers.read(c.readers, c.found.a, ?probe);
    if (sel m.err) { ret res[bool, Fail].err{m.err}; }
    var model:  Model       = m.ok;
    val stated: opt[Stated] = contract.stated(?model);
    val r:      err[Fail]   = contract.release(?model);
    if (sel r.err)       { ret res[bool, Fail].err{r.err}; }
    if (sel stated.none) { ret res[bool, Fail].ok{true}; }
    var code: Stated           = stated.some;
    val row:  res[*Arch, Fail] = arch_list.by_code(?code);
    ret res[bool, Fail].ok{sel row.ok && row.ok == c.options.target.arch};
}

# the file at `path`, read and entered
fun named(c: *Context, path: str, include: Include, searched: bool) err[Fail] {
    val l: res[contract.Input, Fail] = load(c, path);
    if (sel l.err) { ret err[Fail].err{l.err}; }
    ret enter(c, l.ok, include, searched);
}

# enter the bytes `in`: as a source when a format reads them, else as a GNU
# linker script where the system reads them, else as a source the link
# refuses
fun enter(c: *Context, in: contract.Input, include: Include, searched: bool) err[Fail] {
    var probe: contract.Input              = in;
    val known: res[*contract.Reader, Fail] = readers.sniff(c.readers, ?probe);
    if (sel known.err) {
        val scripts: res[bool, Fail] = reads_scripts(c);
        if (sel scripts.err) { ret err[Fail].err{scripts.err}; }
        if (scripts.ok)      { ret script(c, in, include, searched); }
    }
    var s: Source = Source.bytes{in};
    if (!(sel include.unstated) || searched) { s = Source.included{Included{input: in, include: include, searched: searched}}; }
    val p: res[table.Id[Source], Fail] = table.push[Source](c.sources, s);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# a span of a script's bytes
rec Span {
    at:  usize;
    len: usize;
}

# a token of a script
# ---
# end:   the script ends
# open:  an opening parenthesis
# close: a closing parenthesis
# word:  a name, a path or an entry
tag Token: u8 {
    end;
    open;
    close;
    word: Span;
}

# where a script is read
rec Lexer {
    data: *u8;
    len:  usize;
    at:   usize;
}

# a byte that separates tokens: white space, and a comma, which a list may
# separate its entries by
fun blank(b: u8) bool {
    ret b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == '\x0b' || b == '\x0c' || b == ',';
}

# whether `in` holds text: no control byte but white space
fun textual(in: contract.Input) bool {
    var i: usize = 0;
    for (i < in.len) {
        val b: u8 = in.data[i];
        if ((b < ' ' && !blank(b)) || b == '\x7f') { ret false; }
        i = i + 1;
    }
    ret true;
}

# the next token, past white space and comments
fun lex(l: *Lexer) res[Token, Fail] {
    for (l.at < l.len) {
        val b: u8 = l.data[l.at];
        if (blank(b)) {
            l.at = l.at + 1;
            cnt;
        }
        if (b != '/' || l.at + 1 >= l.len || l.data[l.at + 1] != '*') { brk; }
        var k:      usize = l.at + 2;
        var closed: bool  = false;
        for (k + 1 < l.len && !closed) {
            if (l.data[k] == '*' && l.data[k + 1] == '/') { closed = true; }
            or                                            { k = k + 1; }
        }
        if (!closed) { ret res[Token, Fail].err{fail.at_offset(fail.malformed("a linker script's comment is not closed"), l.at::u64)}; }
        l.at = k + 2;
    }
    if (l.at >= l.len) { ret res[Token, Fail].ok{Token.end{}}; }
    val b: u8 = l.data[l.at];
    if (b == '(') {
        l.at = l.at + 1;
        ret res[Token, Fail].ok{Token.open{}};
    }
    if (b == ')') {
        l.at = l.at + 1;
        ret res[Token, Fail].ok{Token.close{}};
    }
    val start: usize = l.at;
    for (l.at < l.len && !blank(l.data[l.at]) && l.data[l.at] != '(' && l.data[l.at] != ')') {
        l.at = l.at + 1;
    }
    ret res[Token, Fail].ok{Token.word{Span{at: start, len: l.at - start}}};
}

# whether the word `w` of `l` is `text`
fun spelled(l: *Lexer, w: Span, text: str) bool {
    if (str_len(text) != w.len) { ret false; }
    var i: usize = 0;
    for (i < w.len) {
        if (l.data[w.at + i] != text[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# read the GNU linker script `in`, entering what it names
fun script(c: *Context, in: contract.Input, include: Include, searched: bool) err[Fail] {
    if (!textual(in))            { ret err[Fail].err{fail.in_file(fail.unsupported("the file is of no format mink reads, nor a GNU linker script"), in.file)}; }
    if (c.depth >= SCRIPT_DEPTH) { ret err[Fail].err{fail.in_file(fail.malformed("linker scripts name one another more deeply than mink follows"), in.file)}; }
    c.depth = c.depth + 1;
    var l: Lexer     = Lexer{data: in.data, len: in.len};
    val r: err[Fail] = commands(c, ?l, in.file, include, searched);
    c.depth = c.depth - 1;
    if (sel r.err) { ret err[Fail].err{fail.in_file(r.err, in.file)}; }
    ret err[Fail].ok{};
}

# the commands of the script `file` read through `l`
fun commands(c: *Context, l: *Lexer, file: str, include: Include, searched: bool) err[Fail] {
    for {
        val t: res[Token, Fail] = lex(l);
        if (sel t.err) { ret err[Fail].err{t.err}; }
        val tok: Token = t.ok;
        if (sel tok.end) { ret err[Fail].ok{}; }
        or (sel tok.word) {
            val w: Span = tok.word;
            if (spelled(l, w, "GROUP") || spelled(l, w, "INPUT")) {
                val e: err[Fail] = list(c, l, file, include, searched);
                if (sel e.err) { ret e; }
                cnt;
            }
            if (spelled(l, w, "OUTPUT_FORMAT")) {
                val e: err[Fail] = skipped(l);
                if (sel e.err) { ret e; }
                cnt;
            }
            val name: res[str, Fail] = copied(c, l.data, w.at, w.len);
            if (sel name.err) { ret err[Fail].err{name.err}; }
            ret err[Fail].err{fail.about(fail.at_offset(fail.unsupported("a linker script command mink does not read"), w.at::u64), name.ok)};
        }
        ret err[Fail].err{fail.at_offset(fail.malformed("a linker script holds a parenthesis outside a command"), l.at::u64)};
    }
    ret err[Fail].ok{};
}

# the opening parenthesis a command's arguments follow
fun opened(l: *Lexer) err[Fail] {
    val t: res[Token, Fail] = lex(l);
    if (sel t.err) { ret err[Fail].err{t.err}; }
    val tok: Token = t.ok;
    if (sel tok.open) { ret err[Fail].ok{}; }
    ret err[Fail].err{fail.at_offset(fail.malformed("a linker script command is not followed by its parenthesis"), l.at::u64)};
}

# the arguments of a command the link needs nothing of, words up to its
# closing parenthesis
fun skipped(l: *Lexer) err[Fail] {
    val o: err[Fail] = opened(l);
    if (sel o.err) { ret o; }
    for {
        val t: res[Token, Fail] = lex(l);
        if (sel t.err) { ret err[Fail].err{t.err}; }
        val tok: Token = t.ok;
        if (sel tok.close) { ret err[Fail].ok{}; }
        or (sel tok.word)  { cnt; }
        or (sel tok.end)   { ret err[Fail].err{fail.at_offset(fail.malformed("a linker script command's parenthesis is not closed"), l.at::u64)}; }
        ret err[Fail].err{fail.at_offset(fail.malformed("a linker script command's arguments hold a parenthesis"), l.at::u64)};
    }
    ret err[Fail].ok{};
}

# the entries of a GROUP, an INPUT or an AS_NEEDED list, each entered as
# `include` states, those of an AS_NEEDED list only when referenced
fun list(c: *Context, l: *Lexer, file: str, include: Include, searched: bool) err[Fail] {
    val o: err[Fail] = opened(l);
    if (sel o.err) { ret o; }
    for {
        val t: res[Token, Fail] = lex(l);
        if (sel t.err) { ret err[Fail].err{t.err}; }
        val tok: Token = t.ok;
        if (sel tok.close) { ret err[Fail].ok{}; }
        or (sel tok.word) {
            val w: Span = tok.word;
            if (spelled(l, w, "AS_NEEDED")) {
                val e: err[Fail] = list(c, l, file, Include.referenced{}, searched);
                if (sel e.err) { ret e; }
                cnt;
            }
            val e: err[Fail] = entry(c, l, w, file, include, searched);
            if (sel e.err) { ret err[Fail].err{fail.at_offset(e.err, w.at::u64)}; }
            cnt;
        }
        or (sel tok.end) { ret err[Fail].err{fail.at_offset(fail.malformed("a linker script list is not closed"), l.at::u64)}; }
        ret err[Fail].err{fail.at_offset(fail.malformed("a linker script list holds a parenthesis"), l.at::u64)};
    }
    ret err[Fail].ok{};
}

# the entry `w` of the script `file`: a library by name after -l, an
# absolute path, under the sysroot when the script lies under it, or a
# relative one, in the working directory or else a library directory
fun entry(c: *Context, l: *Lexer, w: Span, file: str, include: Include, searched: bool) err[Fail] {
    val text: res[str, Fail] = copied(c, l.data, w.at, w.len);
    if (sel text.err) { ret err[Fail].err{text.err}; }
    val t: str = text.ok;
    if (w.len > 2 && t[0] == '-' && t[1] == 'l') { ret library(c, Wanted{form: Form.system{}, name: (?t[2])::str, include: include}); }
    if (is_abs(t)) {
        val root: str = c.options.sysroot;
        if (root == nil || !str_starts_with(file, root)) { ret named(c, t, include, searched); }
        val under: res[str, Fail] = own(c, str_join(c.found.a, root, t));
        if (sel under.err) { ret err[Fail].err{under.err}; }
        ret named(c, under.ok, include, searched);
    }
    val here: res[bool, Fail] = is_file(t);
    if (sel here.err) { ret err[Fail].err{here.err}; }
    if (here.ok)      { ret named(c, t, include, searched); }
    val listing: err[Fail] = listed(c);
    if (sel listing.err) { ret listing; }
    var d: usize = 0;
    for (d < table.count[str](?c.libdirs)) {
        val dir:  str            = @table.at[str](?c.libdirs, table.nth[str](d));
        val made: res[str, Fail] = own(c, str_join(c.found.a, dir, "/", t));
        d = d + 1;
        if (sel made.err) { ret err[Fail].err{made.err}; }
        val present: res[bool, Fail] = is_file(made.ok);
        if (sel present.err) { ret err[Fail].err{present.err}; }
        if (present.ok)      { ret named(c, made.ok, include, searched); }
    }
    ret unfound(c, t, ?c.libdirs);
}
