# a link's inputs as its caller names them
#
# a link names each input as a file at a path, as a library or a framework by
# name, or as a source it holds in memory, in link order, each library with
# whether the image loads it when no live import references it, and whether
# its name is searched for shared or static first. a name is looked for
# through the search the catalog states for the link's system, environment
# and architecture, in the directories the link adds, then in the system's
# directories under the sysroot. the naming states the steps of the search
# for each preference, and each step tries every directory before the next
# begins: one for each of its files in order, or one for the files of each
# single-number major version present, the highest first. a file the loader
# loads is tried only for an output kind that imports, and is taken only
# when it is a shared library for the link's architecture, a container with
# such a member for it, an archive whose members state no architecture, as
# an import library is, or, for a file of a plain name, a linker script.
# any other candidate is skipped, and an archive is skipped only when its
# model states another architecture. a library a shared library the search
# entered re-exports is looked for by its install name where no library
# entered has it: its text stub beside it under the sysroot, then the file
# itself, then a file of its name in each library directory, the stub
# first. one so found enters as a library the image loads only when a
# reference binds to it, since the link binds what it offers through the
# library re-exporting it, and its own re-exports are followed in turn. one
# found nowhere is left to the link, which offers nothing for it.
# a file no format reads is read as a GNU linker script where the naming says
# the system's linker reads them: its GROUP and INPUT entries enter in order,
# as the script is included, and those inside AS_NEEDED only when referenced.
# OUTPUT_FORMAT names nothing the link needs, since every file an entry names
# is checked for the link's architecture as it is read, and any other command
# is refused naming it. an entry `-l<name>` is a library by name, an absolute
# path lies under the sysroot when the script does, and a relative one is
# looked for in the working directory, then in the library directories. a
# name or an entry found nowhere is refused naming it, with every directory
# searched written to the link's notes. every file the search reads enters
# with its absolute path, from which the link takes the directory a runtime
# search path names.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.OwnedString;
use std.types.string.StrError;
use std.types.string.owned_release;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use std.collections.sort;
use std.collections.vector.Vector;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.memory;
use std.process.env;
use std.types.path.is_abs;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Stated;
use arch_list: mink.catalog.arch.list;
use mink.catalog.kind;
use mink.catalog.os;
use mink.catalog.os.Files;
use mink.catalog.os.Major;
use mink.catalog.os.Naming;
use mink.catalog.os.Order;
use mink.catalog.os.Pattern;
use mink.catalog.os.Step;
use mink.catalog.os.System;
use mink.catalog.output;
use mink.format.contract;
use mink.format.contract.Member;
use mink.format.contract.Model;
use mink.format.file;
use mink.format.file.Loaded;
use mink.format.readers;
use mink.format.readers.Readers;
use mink.format.registry.Registry;
use mink.link.input.Include;
use mink.link.input.Included;
use mink.link.input.Source;
use mink.link.options.Options;
use mink.link.state;
use mink.model.object;
use mink.model.object.Object;
use reloc_row: mink.reloc.row;
use std.types.view.View;

# what a link names by name
# ---
# system:    a library, looked for as the naming's files in the library
#            directories
# framework: a framework, looked for as the naming's bundle files in the
#            framework directories
pub tag Form: u8 {
    system;
    framework;
}

# which files a library's name is searched for first, falling back to the
# others, by the steps the system's naming states for each
# ---
# shared_first: the shared library first, as the system's linker searches
# static_first: the archive first
pub tag Prefer: u8 {
    shared_first;
    static_first;
}

# a library or a framework a link names
# ---
# form:    which it is
# name:    its name, as `m` names libm and `Cocoa` the Cocoa framework
# include: whether the image loads it when no live import references it
# prefer:  which files a library's name is searched for first. a framework
#          is found by its bundle, whatever it states
pub rec Wanted {
    form:    Form;
    name:    str;
    include: Include;
    prefer:  Prefer;
}

# a file a link names by its path
# ---
# path:    the path, borrowed for as long as the link's refusal is reported
# include: whether the image loads the library the file describes when no
#          live import references it
pub rec File {
    path:    str;
    include: Include;
}

# one input of a link as its caller names it
# ---
# source:  what the caller holds, linked as the source states
# file:    a file at a path
# library: a library or a framework found by name
pub tag Request: u8 {
    source:  Source;
    file:    File;
    library: Wanted;
}

# what a link's search made and loaded, which every name its refusal carries
# may point into, so it is released once the refusal is reported
# ---
# paths:  the paths and names it made, each a zero after it
# loaded: the files it loaded
pub rec Found {
    a:      *A.Allocator;
    paths:  Table[str];
    loaded: Table[Loaded];
}

# the most linker scripts one may name in a chain, one naming the next
val SCRIPT_DEPTH: usize = 16;

# found:   where what the search makes is held
# readers: the formats a file is sniffed through
# options: the link's options
# notes:   where the directories a refused search tried are written
# sources: the sources the requests resolve to, in link order
# search:  the catalog's search for the link, once known
# system:  the link's system, once the search is known
# known:   whether it is
# libdirs: the directories a library is searched in, in order, once listed
# fwdirs:  the directories a framework is searched in, in order, once listed
# listed:  whether they are
# depth:   how many linker scripts the one being read lies inside
# prefer:  which files the request being resolved searches a name for
#          first, which a linker script's `-l<name>` entries take
# cwd:     the working directory a relative path lies in, once read
# relocs:  the relocation rows a library is converted through to read what
#          it re-exports
rec Context {
    found:   *Found;
    readers: *Readers;
    options: *Options;
    notes:   *Sink;
    sources: *Table[Source];
    search:  os.Search;
    system:  *System;
    known:   bool;
    libdirs: Table[str];
    fwdirs:  Table[str];
    listed:  bool;
    depth:   usize;
    prefer:  Prefer;
    cwd:     str;
    relocs:  *reloc_row.Registry;
}

pub fun make(a: *A.Allocator) Found {
    ret Found{a: a, paths: table.make[str](a), loaded: table.make[Loaded](a)};
}

# give back every file loaded and every path made, reporting the first
# refusal
pub fun release(f: *Found) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[Loaded](?f.loaded)) {
        first = fail.kept(first, file.unload(table.at[Loaded](?f.loaded, table.nth[Loaded](i))));
        i     = i + 1;
    }
    first = fail.kept(first, table.release[Loaded](?f.loaded));
    i     = 0;
    for (i < table.count[str](?f.paths)) {
        val s: str          = @table.at[str](?f.paths, table.nth[str](i));
        val d: err[A.Error] = A.deallocate[char](f.a, s, str_len(s) + 1);
        if (sel d.err) { first = fail.kept(first, err[Fail].err{fail.refused(d.err)}); }
        i = i + 1;
    }
    ret fail.kept(first, table.release[str](?f.paths));
}

# link the `count` requests at `requests` through the formats of `g` in one
# call, each resolved in order to the sources it names, what the search
# makes held in `f`. the image's bytes are returned and the link's report is
# appended to `notes`, or when it is refused, what its refusal cannot carry
pub fun link(f: *Found, g: *Registry, o: Options, requests: *Request, count: usize, notes: *Sink) res[Sink, Fail] {
    var sources: Table[Source] = table.make[Source](f.a);
    var stated:  Options       = o;
    var c:       Context       = Context{
        found:   f,
        readers: ?g.readers,
        options: ?stated,
        notes:   notes,
        sources: ?sources,
        libdirs: table.make[str](f.a),
        fwdirs:  table.make[str](f.a),
        relocs:  ?g.relocs,
    };
    var e: err[Fail] = err[Fail].ok{};
    var i: usize     = 0;
    for (i < count && sel e.ok) {
        e = request(?c, ?requests[i]);
        i = i + 1;
    }
    var out: res[Sink, Fail];
    if (sel e.err) { out = res[Sink, Fail].err{e.err}; }
    or {
        val reexported: err[Fail] = followed(?c);
        if (sel reexported.err) { out = res[Sink, Fail].err{reexported.err}; }
        or                      { out = state.link(f.a, g, o, table.items[Source](?sources), table.count[Source](?sources), notes); }
    }
    var back: err[Fail] = table.release[Source](?sources);
    back = fail.kept(back, table.release[str](?c.libdirs));
    back = fail.kept(back, table.release[str](?c.fwdirs));
    if (sel out.err) { ret out; }
    if (sel back.err) {
        var image:   Sink      = out.ok;
        val dropped: err[Fail] = sink.release(?image);
        ret res[Sink, Fail].err{back.err};
    }
    ret out;
}

fun request(c: *Context, r: *Request) err[Fail] {
    if (sel r.source) {
        val p: res[table.Id[Source], Fail] = table.push[Source](c.sources, r.source);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        ret err[Fail].ok{};
    }
    or (sel r.file) {
        c.prefer = Prefer.shared_first{};
        ret named(c, r.file.path, r.file.include, false);
    }
    c.prefer = r.library.prefer;
    ret library(c, r.library);
}

# what the following of re-exports knows
# ---
# names:   the install names met
# loaders: per name, a library entered has it as its install name
# asked:   per name, a library entered re-exports it
# wanted:  the re-exported names, in the order met
rec Following {
    names:   Interner;
    loaders: Table[bool];
    asked:   Table[bool];
    wanted:  Table[Id[Name]];
}

# follow the re-exports of every shared library the search entered, each
# library a re-export finds entered and followed in turn, until none is
# found that is not entered already
fun followed(c: *Context) err[Fail] {
    val a:    *A.Allocator = c.found.a;
    var f:    Following    = Following{names: intern.make(a), loaders: table.make[bool](a), asked: table.make[bool](a), wanted: table.make[Id[Name]](a)};
    val r:    err[Fail]    = follow_all(c, ?f);
    var back: err[Fail]    = intern.release(?f.names);
    back = fail.kept(back, table.release[bool](?f.loaders));
    back = fail.kept(back, table.release[bool](?f.asked));
    back = fail.kept(back, table.release[Id[Name]](?f.wanted));
    if (sel r.err) { ret r; }
    ret back;
}

fun follow_all(c: *Context, f: *Following) err[Fail] {
    var next:  usize = 0;
    var asked: usize = 0;
    for {
        val end: usize = table.count[Source](c.sources);
        for (next < end) {
            val e: err[Fail] = facts(c, f, table.items[Source](c.sources)[next]);
            if (sel e.err) { ret e; }
            next = next + 1;
        }
        for (asked < table.count[Id[Name]](?f.wanted)) {
            val n: Id[Name] = table.items[Id[Name]](?f.wanted)[asked];
            asked = asked + 1;
            if (marked(?f.loaders, n)) { cnt; }
            val e: err[Fail] = locate(c, intern.bytes_of(?f.names, n));
            if (sel e.err) { ret e; }
        }
        if (table.count[Source](c.sources) == end) { brk; }
    }
    ret err[Fail].ok{};
}

# whether `t` marks the name `n`
fun marked(t: *Table[bool], n: Id[Name]) bool {
    ret n.index::usize < table.count[bool](t) && table.items[bool](t)[n.index::usize];
}

# mark the name `n` in `t`, the table growing to hold it, true when it was
# not marked before
fun mark(t: *Table[bool], n: Id[Name]) res[bool, Fail] {
    val have: usize = table.count[bool](t);
    if (n.index::usize >= have) {
        val g: res[Id[bool], Fail] = table.grow[bool](t, n.index::usize + 1 - have);
        if (sel g.err) { ret res[bool, Fail].err{g.err}; }
    }
    val was: bool = table.items[bool](t)[n.index::usize];
    table.items[bool](t)[n.index::usize] = true;
    ret res[bool, Fail].ok{!was};
}

# what the source `s` states of the libraries: the install name of the
# shared library it is and the libraries it re-exports. a source of no file,
# and one no format reads, states nothing, and a container states what its
# member for the link's architecture does
fun facts(c: *Context, f: *Following, s: Source) err[Fail] {
    if (!sel s.included) { ret err[Fail].ok{}; }
    ret input_facts(c, f, s.included.input);
}

fun input_facts(c: *Context, f: *Following, in: contract.Input) err[Fail] {
    var probe: contract.Input              = in;
    val known: res[*contract.Reader, Fail] = readers.sniff(c.readers, ?probe);
    if (sel known.err) { ret err[Fail].ok{}; }
    val m: res[Model, Fail] = readers.read(c.readers, c.found.a, ?probe);
    if (sel m.err) { ret err[Fail].err{m.err}; }
    var model: Model     = m.ok;
    val r:     err[Fail] = model_facts(c, f, ?model, in.file);
    ret fail.kept(r, contract.release(?model));
}

fun model_facts(c: *Context, f: *Following, m: *Model, file: str) err[Fail] {
    val held: res[bool, Fail] = contract.is_container(m);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    if (held.ok)      { ret member_facts(c, f, m, file); }
    val k: res[*kind.Kind, Fail] = contract.kind(m);
    if (sel k.err)                   { ret err[Fail].err{k.err}; }
    if (!kind.has(k.ok, kind.BINDS)) { ret err[Fail].ok{}; }
    var o: Object    = object.make(c.found.a, c.options.target.arch, nil);
    val r: err[Fail] = object_facts(c, f, m, ?o);
    val g: err[Fail] = object.release(?o);
    if (sel r.err) { ret err[Fail].err{fail.in_file(r.err, file)}; }
    ret g;
}

# what the member of the container `m` for the link's architecture states
fun member_facts(c: *Context, f: *Following, m: *Model, file: str) err[Fail] {
    var members: Table[Member] = table.make[Member](c.found.a);
    var r:       err[Fail]     = contract.members(m, file, ?members);
    var i:       usize         = 0;
    for (i < table.count[Member](?members) && sel r.ok) {
        val member: *Member = table.at[Member](?members, table.nth[Member](i));
        i = i + 1;
        if (sel member.arch.none) { cnt; }
        var code: Stated           = member.arch.some;
        val fits: res[*Arch, Fail] = arch_list.by_code(?code);
        if (!(sel fits.ok && fits.ok == c.options.target.arch)) { cnt; }
        r = input_facts(c, f, member.input);
        brk;
    }
    ret fail.kept(r, table.release[Member](?members));
}

fun object_facts(c: *Context, f: *Following, m: *Model, o: *Object) err[Fail] {
    val conv: err[Fail] = contract.to_neutral(m, c.relocs, o);
    if (sel conv.err)       { ret conv; }
    if (sel o.library.none) { ret err[Fail].ok{}; }
    val own: opt[Id[Name]] = o.library.some.loader;
    if (sel own.some) {
        val v: View                = object.name_of(o, own.some);
        val n: res[Id[Name], Fail] = intern.intern(?f.names, v.data, v.len);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        val l: res[bool, Fail] = mark(?f.loaders, n.ok);
        if (sel l.err) { ret err[Fail].err{l.err}; }
    }
    var k: usize = 0;
    for (k < table.count[object.Dependency](?o.libraries)) {
        val d: *object.Dependency = table.at[object.Dependency](?o.libraries, table.nth[object.Dependency](k));
        k = k + 1;
        if (!d.reexports) { cnt; }
        val dep: opt[Id[Name]] = d.library.loader;
        if (sel dep.none) { cnt; }
        val v: View                = object.name_of(o, dep.some);
        val n: res[Id[Name], Fail] = intern.intern(?f.names, v.data, v.len);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        val fresh: res[bool, Fail] = mark(?f.asked, n.ok);
        if (sel fresh.err) { ret err[Fail].err{fresh.err}; }
        if (!fresh.ok)     { cnt; }
        val p: res[Id[Id[Name]], Fail] = table.push[Id[Name]](?f.wanted, n.ok);
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    ret err[Fail].ok{};
}

# the suffix of a dylib's install name, which its text stub replaces
val DYLIB: str = ".dylib";
# the suffix of a text stub
val STUB: str = ".tbd";

# look for the library of install name `install` and enter it where found:
# its text stub beside it under the sysroot, then the file itself, then a
# file of its name in each library directory, the stub first
fun locate(c: *Context, install: View) err[Fail] {
    val path: res[str, Fail] = copied(c, install.data, 0, install.len);
    if (sel path.err) { ret err[Fail].err{path.err}; }
    val stem: res[str, Fail] = stem_of_path(c, path.ok);
    if (sel stem.err) { ret err[Fail].err{stem.err}; }
    val root: str             = c.options.sysroot;
    val hit:  res[bool, Fail] = reexported_at(c, str_join(c.found.a, root, stem.ok, STUB));
    if (sel hit.err) { ret err[Fail].err{hit.err}; }
    if (hit.ok)      { ret err[Fail].ok{}; }
    val whole: res[bool, Fail] = reexported_at(c, str_join(c.found.a, root, path.ok));
    if (sel whole.err) { ret err[Fail].err{whole.err}; }
    if (whole.ok)      { ret err[Fail].ok{}; }
    val l: err[Fail] = listed(c);
    if (sel l.err) { ret l; }
    val base:      str   = base_of(path.ok);
    val base_stem: str   = base_of(stem.ok);
    var d:         usize = 0;
    for (d < table.count[str](?c.libdirs)) {
        val dir: str = @table.at[str](?c.libdirs, table.nth[str](d));
        d = d + 1;
        val s: res[bool, Fail] = reexported_at(c, str_join(c.found.a, dir, "/", base_stem, STUB));
        if (sel s.err) { ret err[Fail].err{s.err}; }
        if (s.ok)      { ret err[Fail].ok{}; }
        val w: res[bool, Fail] = reexported_at(c, str_join(c.found.a, dir, "/", base));
        if (sel w.err) { ret err[Fail].err{w.err}; }
        if (w.ok)      { ret err[Fail].ok{}; }
    }
    ret err[Fail].ok{};
}

# whether the file at `made` is a shared library for the link, entered as
# one the image loads only when a reference binds to it
fun reexported_at(c: *Context, made: res[str, StrError]) res[bool, Fail] {
    ret candidate(c, made, Include.referenced{}, true, false);
}

# the path `path` without the dylib suffix where it ends in it
fun stem_of_path(c: *Context, path: str) res[str, Fail] {
    val n: usize = str_len(path);
    val s: usize = str_len(DYLIB);
    if (n <= s || !memory.raw_equal((path::usize + n - s)::ptr, DYLIB::ptr, s)) { ret res[str, Fail].ok{path}; }
    ret copied(c, path::*u8, 0, n - s);
}

# the file name of the path `path`, what follows its last separator
fun base_of(path: str) str {
    val n:  usize = str_len(path);
    var at: usize = 0;
    var i:  usize = 0;
    for (i < n) {
        if (path[i] == '/') { at = i + 1; }
        i = i + 1;
    }
    ret (path::usize + at)::str;
}

# the catalog's search for the link's system, environment and architecture
fun row(c: *Context) res[*os.Search, Fail] {
    if (c.known) { ret res[*os.Search, Fail].ok{?c.search}; }
    val system: opt[*System] = c.options.target.system;
    if (sel system.none)              { ret res[*os.Search, Fail].err{fail.malformed("the link names no system, whose directories a name is searched in")}; }
    if (c.options.target.arch == nil) { ret res[*os.Search, Fail].err{fail.malformed("the link names no architecture, whose directories a name is searched in")}; }
    val s: res[os.Search, Fail] = os.search(system.some, c.options.target.env, c.options.target.arch);
    if (sel s.err) { ret res[*os.Search, Fail].err{s.err}; }
    c.search = s.ok;
    c.system = system.some;
    c.known  = true;
    ret res[*os.Search, Fail].ok{?c.search};
}

# whether the link's system reads a library file no format reads as a GNU
# linker script. a link naming no system reads none, and is refused by the
# link itself
fun reads_scripts(c: *Context) res[bool, Fail] {
    val system: opt[*System] = c.options.target.system;
    if (sel system.none || c.options.target.arch == nil) { ret res[bool, Fail].ok{false}; }
    val s: res[*os.Search, Fail] = row(c);
    if (sel s.err) { ret res[bool, Fail].err{s.err}; }
    val n: opt[*Naming] = s.ok.naming;
    if (sel n.none) { ret res[bool, Fail].ok{false}; }
    ret res[bool, Fail].ok{n.some.scripts};
}

# hold `r`, a string made for the search, until the search is released
fun own(c: *Context, r: res[str, StrError]) res[str, Fail] {
    if (sel r.err) {
        val e: StrError = r.err;
        if (sel e.alloc) { ret res[str, Fail].err{fail.refused(e.alloc)}; }
        ret res[str, Fail].err{fail.internal("a path could not be made")};
    }
    val p: res[table.Id[str], Fail] = table.push[str](?c.found.paths, r.ok);
    if (sel p.err) {
        drop(c, r.ok);
        ret res[str, Fail].err{p.err};
    }
    ret res[str, Fail].ok{r.ok};
}

# give back `s`, a string made for the search and not held
fun drop(c: *Context, s: str) {
    val d: err[A.Error] = A.deallocate[char](c.found.a, s, str_len(s) + 1);
}

# the `len` bytes at `at` of `data`, held with a zero after them
fun copied(c: *Context, data: *u8, at: usize, len: usize) res[str, Fail] {
    val got: res[str, A.Error] = A.allocate[char](c.found.a, len + 1);
    if (sel got.err) { ret res[str, Fail].err{fail.refused(got.err)}; }
    memory.raw_copy(got.ok::ptr, (data::usize + at)::ptr, len);
    got.ok[len] = 0;
    ret own(c, res[str, StrError].ok{got.ok});
}

# list the directories a library and a framework are searched in: those the
# link adds, then the system's under the sysroot
fun listed(c: *Context) err[Fail] {
    if (c.listed) { ret err[Fail].ok{}; }
    val s: res[*os.Search, Fail] = row(c);
    if (sel s.err) { ret err[Fail].err{s.err}; }
    val o: *Options = c.options;
    var i: usize    = 0;
    for (i < o.libdir_count) {
        val e: err[Fail] = listed_one(c, ?c.libdirs, nil, o.libdirs[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    i = 0;
    for (i < s.ok.libdir_count) {
        val e: err[Fail] = listed_one(c, ?c.libdirs, o.sysroot, s.ok.libdirs[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    i = 0;
    for (i < o.fwdir_count) {
        val e: err[Fail] = listed_one(c, ?c.fwdirs, nil, o.fwdirs[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    i = 0;
    for (i < s.ok.framework_count) {
        val e: err[Fail] = listed_one(c, ?c.fwdirs, o.sysroot, s.ok.frameworks[i]);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    c.listed = true;
    ret err[Fail].ok{};
}

# append `dir` under `root`, nil for none, to `into`
fun listed_one(c: *Context, into: *Table[str], root: str, dir: str) err[Fail] {
    val d: res[str, Fail] = own(c, str_join(c.found.a, root, dir));
    if (sel d.err) { ret err[Fail].err{d.err}; }
    val p: res[table.Id[str], Fail] = table.push[str](into, d.ok);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the library or the framework `w`, found by its name
fun library(c: *Context, w: Wanted) err[Fail] {
    val s: res[*os.Search, Fail] = row(c);
    if (sel s.err) { ret err[Fail].err{s.err}; }
    val n: opt[*Naming] = s.ok.naming;
    if (sel n.none)            { ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the system's linker finds no library by name"), c.system.name), w.name)}; }
    if (c.options.kind == nil) { ret err[Fail].err{fail.about(fail.malformed("the link names no output kind, which decides the files a name is looked for as"), w.name)}; }
    val l: err[Fail] = listed(c);
    if (sel l.err)            { ret l; }
    if (sel w.form.framework) { ret framework(c, n.some, w); }
    ret system_library(c, n.some, w);
}

# the library `w`, found by the steps of the naming's order for its
# preference, its stem dropped first
fun system_library(c: *Context, naming: *Naming, w: Wanted) err[Fail] {
    val name: res[str, Fail] = stem_of(c, naming, w.name);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    val imports: bool   = output.has(c.options.kind, output.IMPORTS);
    var order:   *Order = ?naming.shared_first;
    if (sel w.prefer.static_first) { order = ?naming.static_first; }
    var s: usize = 0;
    for (s < order.count) {
        val step: *Step = ?order.steps[s];
        s = s + 1;
        var hit: res[bool, Fail] = res[bool, Fail].ok{false};
        if (sel step.files) { hit = files_step(c, ?step.files, name.ok, w.include, imports); }
        or (sel step.majors) {
            if (imports) { hit = majors_step(c, step.majors, name.ok, w.include); }
        }
        if (sel hit.err) { ret err[Fail].err{hit.err}; }
        if (hit.ok)      { ret err[Fail].ok{}; }
    }
    ret unfound(c, w.name, ?c.libdirs);
}

# whether a library directory holds one of the files `f` of the name `name`
# that is taken, each directory tried for every file in order
fun files_step(c: *Context, f: *Files, name: str, include: Include, imports: bool) res[bool, Fail] {
    var d: usize = 0;
    for (d < table.count[str](?c.libdirs)) {
        val dir: str   = @table.at[str](?c.libdirs, table.nth[str](d));
        var k:   usize = 0;
        d = d + 1;
        for (k < f.count) {
            val p: *Pattern = f.rows[k];
            k = k + 1;
            if (p.loaded && !imports) { cnt; }
            val made: res[str, StrError] = str_join(c.found.a, dir, "/", p.prefix, name, p.suffix);
            val hit:  res[bool, Fail]    = candidate(c, made, include, p.loaded, p.loaded);
            if (sel hit.err) { ret hit; }
            if (hit.ok)      { ret hit; }
        }
    }
    ret res[bool, Fail].ok{false};
}

# a file of a major version a directory holds: its major and where the
# directory's listing holds its name
rec Versioned {
    major: u64;
    at:    usize;
}

fun by_major(x: *Versioned, y: *Versioned) i64 {
    if (x.major < y.major) { ret -1; }
    if (x.major > y.major) { ret 1; }
    ret 0;
}

# whether a library directory holds a file of a major version of the name
# `name` that is taken, each directory tried for its majors, the highest
# first
fun majors_step(c: *Context, m: *Major, name: str, include: Include) res[bool, Fail] {
    var d: usize = 0;
    for (d < table.count[str](?c.libdirs)) {
        val dir: str             = @table.at[str](?c.libdirs, table.nth[str](d));
        val hit: res[bool, Fail] = majors_in(c, dir, m, name, include);
        d = d + 1;
        if (sel hit.err) { ret hit; }
        if (hit.ok)      { ret hit; }
    }
    ret res[bool, Fail].ok{false};
}

fun majors_in(c: *Context, dir: str, m: *Major, name: str, include: Include) res[bool, Fail] {
    val there: res[bool, io_error.Error] = fs.is_dir(dir);
    if (sel there.err) { ret res[bool, Fail].err{file.io_refusal(there.err, "cannot tell whether the directory exists", dir)}; }
    if (!there.ok)     { ret res[bool, Fail].ok{false}; }
    val listing: res[Vector[fs.Listed], fs.FsError] = fs.read_dir(c.found.a, dir);
    if (sel listing.err) { ret res[bool, Fail].err{file.refusal(listing.err, "cannot list the directory", dir)}; }
    var entries: Vector[fs.Listed] = listing.ok;
    var found:   Table[Versioned]  = table.make[Versioned](c.found.a);
    var listed:  err[Fail]         = err[Fail].ok{};
    var i:       usize             = 0;
    for (i < entries.len && sel listed.ok) {
        val e: fs.Listed = entries.data[i];
        i = i + 1;
        var n: opt[u64] = opt[u64].none{};
        if (sel e.name) { n = major_of(e.name, m, name); }
        if (sel n.none) { cnt; }
        val p: res[table.Id[Versioned], Fail] = table.push[Versioned](?found, Versioned{major: n.some, at: i - 1});
        if (sel p.err) { listed = err[Fail].err{p.err}; }
    }
    var out: res[bool, Fail] = res[bool, Fail].ok{false};
    if (sel listed.err) { out = res[bool, Fail].err{listed.err}; }
    or {
        sort.sort_by[Versioned](table.items[Versioned](?found), table.count[Versioned](?found), by_major);
        out = highest(c, dir, ?entries, ?found, include);
    }
    fs.listed_free(?entries);
    ret settled(out, table.release[Versioned](?found));
}

# whether a file of the majors `found`, sorted, of the listing `entries` of
# `dir` is taken, the highest first
fun highest(c: *Context, dir: str, entries: *Vector[fs.Listed], found: *Table[Versioned], include: Include) res[bool, Fail] {
    var k: usize = table.count[Versioned](found);
    for (k > 0) {
        k = k - 1;
        val e: fs.Listed = entries.data[table.items[Versioned](found)[k].at];
        if (sel e.name) {
            val hit: res[bool, Fail] = candidate(c, str_join(c.found.a, dir, "/", e.name), include, true, false);
            if (sel hit.err) { ret hit; }
            if (hit.ok)      { ret hit; }
        }
    }
    ret res[bool, Fail].ok{false};
}

# `out`, or the refusal of giving back what made it when it holds none
fun settled(out: res[bool, Fail], back: err[Fail]) res[bool, Fail] {
    if (sel out.err)  { ret out; }
    if (sel back.err) { ret res[bool, Fail].err{back.err}; }
    ret out;
}

# the major version the file `file` carries as a file of the major `m` of
# the name `name`, none when it is no such file: the major is decimal, with
# no leading zero but a lone one, and fits in 64 bits
fun major_of(file: str, m: *Major, name: str) opt[u64] {
    val n:    usize = str_len(file);
    val head: usize = str_len(m.prefix) + str_len(name) + str_len(m.infix);
    val tail: usize = str_len(m.suffix);
    if (n <= head + tail)                                                                                                                                                   { ret opt[u64].none{}; }
    if (!spans(file, 0, m.prefix) || !spans(file, str_len(m.prefix), name) || !spans(file, str_len(m.prefix) + str_len(name), m.infix) || !spans(file, n - tail, m.suffix)) { ret opt[u64].none{}; }
    val digits: usize = n - head - tail;
    if (digits > 1 && file[head] == '0') { ret opt[u64].none{}; }
    var v: u64   = 0;
    var i: usize = head;
    for (i < head + digits) {
        val b: u8 = file[i];
        if (b < '0' || b > '9') { ret opt[u64].none{}; }
        val d: u64 = (b - '0')::u64;
        if (v > (0xffff_ffff_ffff_ffff - d) / 10) { ret opt[u64].none{}; }
        v = v * 10 + d;
        i = i + 1;
    }
    ret opt[u64].some{v};
}

# whether `text` lies in `s` at `at`, which is in bounds for it
fun spans(s: str, at: usize, text: str) bool {
    var i: usize = 0;
    for (i < str_len(text)) {
        if (s[at + i] != text[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the framework `w` in the first framework directory whose bundle of its
# name holds a file the naming states
fun framework(c: *Context, naming: *Naming, w: Wanted) err[Fail] {
    if (naming.bundle == nil) { ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the system has no frameworks"), c.system.name), w.name)}; }
    var d: usize = 0;
    for (d < table.count[str](?c.fwdirs)) {
        val dir: str   = @table.at[str](?c.fwdirs, table.nth[str](d));
        var k:   usize = 0;
        d = d + 1;
        for (k < naming.bundle_count) {
            val p:    *Pattern           = ?naming.bundles[k];
            val made: res[str, StrError] = str_join(c.found.a, dir, "/", w.name, naming.bundle, "/", p.prefix, w.name, p.suffix);
            val hit:  res[bool, Fail]    = candidate(c, made, w.include, p.loaded, false);
            k = k + 1;
            if (sel hit.err) { ret err[Fail].err{hit.err}; }
            if (hit.ok)      { ret err[Fail].ok{}; }
        }
    }
    ret unfound(c, w.name, ?c.fwdirs);
}

# `name` without the naming's stem when it ends in it, compared without case
fun stem_of(c: *Context, naming: *Naming, name: str) res[str, Fail] {
    if (naming.stem == nil) { ret res[str, Fail].ok{name}; }
    val n: usize = str_len(name);
    val s: usize = str_len(naming.stem);
    if (n <= s) { ret res[str, Fail].ok{name}; }
    var i: usize = 0;
    for (i < s) {
        if (folded(name[n - s + i]) != folded(naming.stem[i])) { ret res[str, Fail].ok{name}; }
        i = i + 1;
    }
    ret copied(c, name::*u8, 0, n - s);
}

fun folded(b: u8) u8 {
    if (b >= 'A' && b <= 'Z') { ret b + ('a' - 'A'); }
    ret b;
}

# whether the file at `made`, a path made for the search, is the library:
# it is a file and is taken, and its sources are entered. `loaded` says the
# file is one the loader loads, and `scripts` that it may be a linker script
fun candidate(c: *Context, made: res[str, StrError], include: Include, loaded: bool, scripts: bool) res[bool, Fail] {
    val path: res[str, Fail] = own(c, made);
    if (sel path.err) { ret res[bool, Fail].err{path.err}; }
    val present: res[bool, Fail] = is_file(path.ok);
    if (sel present.err) { ret present; }
    if (!present.ok)     { ret res[bool, Fail].ok{false}; }
    val l: res[contract.Input, Fail] = load(c, path.ok);
    if (sel l.err) { ret res[bool, Fail].err{l.err}; }
    val fits: res[bool, Fail] = taken(c, l.ok, loaded, scripts);
    if (sel fits.err) { ret fits; }
    if (!fits.ok)     { ret res[bool, Fail].ok{false}; }
    val e: err[Fail] = enter(c, l.ok, include, true);
    if (sel e.err) { ret res[bool, Fail].err{e.err}; }
    ret res[bool, Fail].ok{true};
}

# whether a regular file lies at `path`, refused when that cannot be told
fun is_file(path: str) res[bool, Fail] {
    val f: res[bool, io_error.Error] = fs.is_file(path);
    if (sel f.err) { ret res[bool, Fail].err{file.io_refusal(f.err, "cannot tell whether the file exists", path)}; }
    ret res[bool, Fail].ok{f.ok};
}

# refuse the name `name` found in none of `dirs`, each written to the notes
fun unfound(c: *Context, name: str, dirs: *Table[str]) err[Fail] {
    var d: usize = 0;
    for (d < table.count[str](dirs)) {
        val w0: err[Fail] = sink.text(c.notes, "searched for ");
        if (sel w0.err) { ret w0; }
        val w1: err[Fail] = sink.text(c.notes, name);
        if (sel w1.err) { ret w1; }
        val w2: err[Fail] = sink.text(c.notes, " in ");
        if (sel w2.err) { ret w2; }
        val w3: err[Fail] = sink.text(c.notes, @table.at[str](dirs, table.nth[str](d)));
        if (sel w3.err) { ret w3; }
        val w4: err[Fail] = sink.text(c.notes, "\n");
        if (sel w4.err) { ret w4; }
        d = d + 1;
    }
    ret err[Fail].err{fail.about(fail.io("no directory searched holds a file of the name"), name)};
}

# the whole of the file at `path`, held until the search is released
fun load(c: *Context, path: str) res[contract.Input, Fail] {
    val l: res[Loaded, Fail] = file.load(c.found.a, path);
    if (sel l.err) { ret res[contract.Input, Fail].err{l.err}; }
    var held: Loaded                      = l.ok;
    val p:    res[table.Id[Loaded], Fail] = table.push[Loaded](?c.found.loaded, held);
    if (sel p.err) {
        val gone: err[Fail] = file.unload(?held);
        ret res[contract.Input, Fail].err{p.err};
    }
    ret res[contract.Input, Fail].ok{held.input};
}

# whether the candidate `in` is taken. a file the loader loads is taken when
# it is a shared library stating the link's architecture or none, a
# container holding such a member for the architecture, an archive whose
# members state none, or, where `scripts` says it may be, a linker script.
# any other file is taken unless it states another architecture, and one of
# no format mink reads is left to be read as a script or refused by the link
fun taken(c: *Context, in: contract.Input, loaded: bool, scripts: bool) res[bool, Fail] {
    var probe: contract.Input              = in;
    val known: res[*contract.Reader, Fail] = readers.sniff(c.readers, ?probe);
    if (sel known.err) {
        if (!loaded)                  { ret res[bool, Fail].ok{true}; }
        if (!scripts || !textual(in)) { ret res[bool, Fail].ok{false}; }
        ret reads_scripts(c);
    }
    val m: res[Model, Fail] = readers.read(c.readers, c.found.a, ?probe);
    if (sel m.err) { ret res[bool, Fail].err{m.err}; }
    var model: Model           = m.ok;
    val out:   res[bool, Fail] = judged(c, ?model, in.file, loaded);
    val r:     err[Fail]       = contract.release(?model);
    if (sel out.err) { ret out; }
    if (sel r.err)   { ret res[bool, Fail].err{r.err}; }
    ret out;
}

# whether the model `m` of the candidate `file` is taken, as `taken` states
fun judged(c: *Context, m: *Model, file: str, loaded: bool) res[bool, Fail] {
    val held: res[bool, Fail] = contract.is_container(m);
    if (sel held.err) { ret held; }
    if (held.ok)      { ret holds(c, m, file, loaded); }
    val stated: opt[Stated] = contract.stated(m);
    if (sel stated.some) {
        var code: Stated           = stated.some;
        val row:  res[*Arch, Fail] = arch_list.by_code(?code);
        if (!(sel row.ok && row.ok == c.options.target.arch)) { ret res[bool, Fail].ok{false}; }
    }
    if (!loaded) { ret res[bool, Fail].ok{true}; }
    val k: res[*kind.Kind, Fail] = contract.kind(m);
    if (sel k.err) { ret res[bool, Fail].err{k.err}; }
    ret res[bool, Fail].ok{kind.has(k.ok, kind.BINDS)};
}

# whether the container `m` named `file` is taken: an archive whose members
# state no architecture is, and one whose members state theirs is when the
# member for the link's architecture is
fun holds(c: *Context, m: *Model, file: str, loaded: bool) res[bool, Fail] {
    var members: Table[Member]   = table.make[Member](c.found.a);
    val listed:  err[Fail]       = contract.members(m, file, ?members);
    var out:     res[bool, Fail] = res[bool, Fail].ok{true};
    if (sel listed.err) { out = res[bool, Fail].err{listed.err}; }
    var coded: bool                = false;
    var pick:  opt[contract.Input] = opt[contract.Input].none{};
    var i:     usize               = 0;
    for (i < table.count[Member](?members) && sel out.ok) {
        val member: *Member = table.at[Member](?members, table.nth[Member](i));
        i = i + 1;
        if (sel member.arch.none) { cnt; }
        coded = true;
        var code: Stated           = member.arch.some;
        val row:  res[*Arch, Fail] = arch_list.by_code(?code);
        val fits: bool             = sel row.ok && row.ok == c.options.target.arch;
        if (sel pick.none && fits) { pick = opt[contract.Input].some{member.input}; }
    }
    var ok: bool = sel out.ok;
    if (ok && coded) {
        out = res[bool, Fail].ok{false};
        if (sel pick.some) { out = taken(c, pick.some, loaded, false); }
    }
    ret settled(out, table.release[Member](?members));
}

# the file at `path`, read and entered
fun named(c: *Context, path: str, include: Include, searched: bool) err[Fail] {
    val l: res[contract.Input, Fail] = load(c, path);
    if (sel l.err) { ret err[Fail].err{l.err}; }
    ret enter(c, l.ok, include, searched);
}

# enter the bytes `in` of the file `in.file`: as a source when a format reads
# them, with the file's absolute path, else as a GNU linker script where the
# system reads them, else as a source the link refuses
fun enter(c: *Context, in: contract.Input, include: Include, searched: bool) err[Fail] {
    var probe: contract.Input              = in;
    val known: res[*contract.Reader, Fail] = readers.sniff(c.readers, ?probe);
    if (sel known.err) {
        val scripts: res[bool, Fail] = reads_scripts(c);
        if (sel scripts.err) { ret err[Fail].err{scripts.err}; }
        if (scripts.ok)      { ret script(c, in, include, searched); }
    }
    val path: res[str, Fail] = absolute(c, in.file);
    if (sel path.err) { ret err[Fail].err{path.err}; }
    val s: Source                      = Source.included{Included{input: in, include: include, searched: searched, path: path.ok}};
    val p: res[table.Id[Source], Fail] = table.push[Source](c.sources, s);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the absolute path of `path`: itself when absolute, else under the working
# directory, read once
fun absolute(c: *Context, path: str) res[str, Fail] {
    if (is_abs(path)) { ret res[str, Fail].ok{path}; }
    if (c.cwd == nil) {
        val d: res[OwnedString, env.EnvError] = env.current_dir(c.found.a);
        if (sel d.err) {
            val e: env.EnvError = d.err;
            if (sel e.alloc) { ret res[str, Fail].err{fail.refused(e.alloc)}; }
            ret res[str, Fail].err{fail.io("cannot read the working directory a relative path lies in")};
        }
        var held: OwnedString    = d.ok;
        val made: res[str, Fail] = own(c, str_join(c.found.a, held.data));
        val back: err[A.Error]   = owned_release(?held);
        if (sel made.err) { ret made; }
        if (sel back.err) { ret res[str, Fail].err{fail.refused(back.err)}; }
        c.cwd = made.ok;
    }
    ret own(c, str_join(c.found.a, c.cwd, "/", path));
}

# a span of a script's bytes
rec Span {
    at:  usize;
    len: usize;
}

# a token of a script
# ---
# end:   the script ends
# open:  an opening parenthesis
# close: a closing parenthesis
# word:  a name, a path or an entry
tag Token: u8 {
    end;
    open;
    close;
    word: Span;
}

# where a script is read
rec Lexer {
    data: *u8;
    len:  usize;
    at:   usize;
}

# a byte that separates tokens: white space, and a comma, which a list may
# separate its entries by
fun blank(b: u8) bool {
    ret b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == '\x0b' || b == '\x0c' || b == ',';
}

# whether `in` holds text: no control byte but white space
fun textual(in: contract.Input) bool {
    var i: usize = 0;
    for (i < in.len) {
        val b: u8 = in.data[i];
        if ((b < ' ' && !blank(b)) || b == '\x7f') { ret false; }
        i = i + 1;
    }
    ret true;
}

# the next token, past white space and comments
fun lex(l: *Lexer) res[Token, Fail] {
    for (l.at < l.len) {
        val b: u8 = l.data[l.at];
        if (blank(b)) {
            l.at = l.at + 1;
            cnt;
        }
        if (b != '/' || l.at + 1 >= l.len || l.data[l.at + 1] != '*') { brk; }
        var k:      usize = l.at + 2;
        var closed: bool  = false;
        for (k + 1 < l.len && !closed) {
            if (l.data[k] == '*' && l.data[k + 1] == '/') { closed = true; }
            or                                            { k = k + 1; }
        }
        if (!closed) { ret res[Token, Fail].err{fail.at_offset(fail.malformed("a linker script's comment is not closed"), l.at::u64)}; }
        l.at = k + 2;
    }
    if (l.at >= l.len) { ret res[Token, Fail].ok{Token.end{}}; }
    val b: u8 = l.data[l.at];
    if (b == '(') {
        l.at = l.at + 1;
        ret res[Token, Fail].ok{Token.open{}};
    }
    if (b == ')') {
        l.at = l.at + 1;
        ret res[Token, Fail].ok{Token.close{}};
    }
    val start: usize = l.at;
    for (l.at < l.len && !blank(l.data[l.at]) && l.data[l.at] != '(' && l.data[l.at] != ')') {
        l.at = l.at + 1;
    }
    ret res[Token, Fail].ok{Token.word{Span{at: start, len: l.at - start}}};
}

# whether the word `w` of `l` is `text`
fun spelled(l: *Lexer, w: Span, text: str) bool {
    if (str_len(text) != w.len) { ret false; }
    var i: usize = 0;
    for (i < w.len) {
        if (l.data[w.at + i] != text[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# read the GNU linker script `in`, entering what it names
fun script(c: *Context, in: contract.Input, include: Include, searched: bool) err[Fail] {
    if (!textual(in))            { ret err[Fail].err{fail.in_file(fail.unsupported("the file is of no format mink reads, nor a GNU linker script"), in.file)}; }
    if (c.depth >= SCRIPT_DEPTH) { ret err[Fail].err{fail.in_file(fail.malformed("linker scripts name one another more deeply than mink follows"), in.file)}; }
    c.depth = c.depth + 1;
    var l: Lexer     = Lexer{data: in.data, len: in.len};
    val r: err[Fail] = commands(c, ?l, in.file, include, searched);
    c.depth = c.depth - 1;
    if (sel r.err) { ret err[Fail].err{fail.in_file(r.err, in.file)}; }
    ret err[Fail].ok{};
}

# the commands of the script `file` read through `l`
fun commands(c: *Context, l: *Lexer, file: str, include: Include, searched: bool) err[Fail] {
    for {
        val t: res[Token, Fail] = lex(l);
        if (sel t.err) { ret err[Fail].err{t.err}; }
        val tok: Token = t.ok;
        if (sel tok.end) { ret err[Fail].ok{}; }
        or (sel tok.word) {
            val w: Span = tok.word;
            if (spelled(l, w, "GROUP") || spelled(l, w, "INPUT")) {
                val e: err[Fail] = list(c, l, file, include, searched);
                if (sel e.err) { ret e; }
                cnt;
            }
            if (spelled(l, w, "OUTPUT_FORMAT")) {
                val e: err[Fail] = skipped(l);
                if (sel e.err) { ret e; }
                cnt;
            }
            val name: res[str, Fail] = copied(c, l.data, w.at, w.len);
            if (sel name.err) { ret err[Fail].err{name.err}; }
            ret err[Fail].err{fail.about(fail.at_offset(fail.unsupported("a linker script command mink does not read"), w.at::u64), name.ok)};
        }
        ret err[Fail].err{fail.at_offset(fail.malformed("a linker script holds a parenthesis outside a command"), l.at::u64)};
    }
    ret err[Fail].ok{};
}

# the opening parenthesis a command's arguments follow
fun opened(l: *Lexer) err[Fail] {
    val t: res[Token, Fail] = lex(l);
    if (sel t.err) { ret err[Fail].err{t.err}; }
    val tok: Token = t.ok;
    if (sel tok.open) { ret err[Fail].ok{}; }
    ret err[Fail].err{fail.at_offset(fail.malformed("a linker script command is not followed by its parenthesis"), l.at::u64)};
}

# the arguments of a command the link needs nothing of, words up to its
# closing parenthesis
fun skipped(l: *Lexer) err[Fail] {
    val o: err[Fail] = opened(l);
    if (sel o.err) { ret o; }
    for {
        val t: res[Token, Fail] = lex(l);
        if (sel t.err) { ret err[Fail].err{t.err}; }
        val tok: Token = t.ok;
        if (sel tok.close) { ret err[Fail].ok{}; }
        or (sel tok.word)  { cnt; }
        or (sel tok.end)   { ret err[Fail].err{fail.at_offset(fail.malformed("a linker script command's parenthesis is not closed"), l.at::u64)}; }
        ret err[Fail].err{fail.at_offset(fail.malformed("a linker script command's arguments hold a parenthesis"), l.at::u64)};
    }
    ret err[Fail].ok{};
}

# the entries of a GROUP, an INPUT or an AS_NEEDED list, each entered as
# `include` states, those of an AS_NEEDED list only when referenced
fun list(c: *Context, l: *Lexer, file: str, include: Include, searched: bool) err[Fail] {
    val o: err[Fail] = opened(l);
    if (sel o.err) { ret o; }
    for {
        val t: res[Token, Fail] = lex(l);
        if (sel t.err) { ret err[Fail].err{t.err}; }
        val tok: Token = t.ok;
        if (sel tok.close) { ret err[Fail].ok{}; }
        or (sel tok.word) {
            val w: Span = tok.word;
            if (spelled(l, w, "AS_NEEDED")) {
                val e: err[Fail] = list(c, l, file, Include.referenced{}, searched);
                if (sel e.err) { ret e; }
                cnt;
            }
            val e: err[Fail] = entry(c, l, w, file, include, searched);
            if (sel e.err) { ret err[Fail].err{fail.at_offset(e.err, w.at::u64)}; }
            cnt;
        }
        or (sel tok.end) { ret err[Fail].err{fail.at_offset(fail.malformed("a linker script list is not closed"), l.at::u64)}; }
        ret err[Fail].err{fail.at_offset(fail.malformed("a linker script list holds a parenthesis"), l.at::u64)};
    }
    ret err[Fail].ok{};
}

# the entry `w` of the script `file`: a library by name after -l, an
# absolute path, under the sysroot when the script lies under it, or a
# relative one, in the working directory or else a library directory
fun entry(c: *Context, l: *Lexer, w: Span, file: str, include: Include, searched: bool) err[Fail] {
    val text: res[str, Fail] = copied(c, l.data, w.at, w.len);
    if (sel text.err) { ret err[Fail].err{text.err}; }
    val t: str = text.ok;
    if (w.len > 2 && t[0] == '-' && t[1] == 'l') { ret library(c, Wanted{form: Form.system{}, name: (?t[2])::str, include: include, prefer: c.prefer}); }
    if (is_abs(t)) {
        val root: str = c.options.sysroot;
        if (root == nil || !str_starts_with(file, root)) { ret named(c, t, include, searched); }
        val under: res[str, Fail] = own(c, str_join(c.found.a, root, t));
        if (sel under.err) { ret err[Fail].err{under.err}; }
        ret named(c, under.ok, include, searched);
    }
    val here: res[bool, Fail] = is_file(t);
    if (sel here.err) { ret err[Fail].err{here.err}; }
    if (here.ok)      { ret named(c, t, include, searched); }
    val listing: err[Fail] = listed(c);
    if (sel listing.err) { ret listing; }
    var d: usize = 0;
    for (d < table.count[str](?c.libdirs)) {
        val dir:  str            = @table.at[str](?c.libdirs, table.nth[str](d));
        val made: res[str, Fail] = own(c, str_join(c.found.a, dir, "/", t));
        d = d + 1;
        if (sel made.err) { ret err[Fail].err{made.err}; }
        val present: res[bool, Fail] = is_file(made.ok);
        if (sel present.err) { ret err[Fail].err{present.err}; }
        if (present.ok)      { ret named(c, made.ok, include, searched); }
    }
    ret unfound(c, t, ?c.libdirs);
}
