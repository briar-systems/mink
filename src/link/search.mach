# the most bytes a found set keeps of one name the failure of a link borrows,
# its terminator included: a path of any host fits, and a longer name is cut
# and ends in `...`
val NAME_ROOM: usize = 4096;
val CUT_BYTES: usize = 3;

# room for one name the failure of a link borrows, zero terminated
pub rec Kept {
    bytes: [NAME_ROOM]u8;
}

# a file the link read
# ---
# path:      its identity, as the input set knows it
# searched:  a search found it
# requested: it is the file a request named by its path
pub rec Read {
    path:      str;
    searched:  bool;
    requested: bool;
}

# what a link's search made and loaded, which the sources it hands the link
# point into, and the names of the failure the link returns, which outlive
# the link's state
# ---
# paths:   the paths and names it made, each a zero after it
# loaded:  the files it loaded
# read:    each file it entered, once
# file:    the file the link's failure names
# record:  the record it names
# subject: the subject it names
# given:   the text its refused value was given as
pub rec Found {
    a:       *A.Allocator;
    paths:   Vector[str];
    loaded:  Vector[Loaded];
    read:    Vector[Read];
    file:    Kept;
    record:  Kept;
    subject: Kept;
    given:   Kept;
}

# copy the `len` bytes at `from` into `to`, cut to its room, returning how
# many it holds
fun keep(to: *Kept, from: *u8, len: usize) usize {
    var i: usize = 0;
    for (i < len && i < NAME_ROOM - 1) {
        to.bytes[i] = from[i];
        i           = i + 1;
    }
    to.bytes[i] = 0;
    if (i == len) { ret i; }
    var k: usize = i;
    for (k > NAME_ROOM - 1 - CUT_BYTES) {
        k           = k - 1;
        to.bytes[k] = '.';
    }
    ret i;
}

# the name `name` kept in `to`, nil when nil
fun keep_name(to: *Kept, name: str) str {
    if (name == nil) { ret nil; }
    val held: usize = keep(to, name, str_len(name));
    ret ?to.bytes[0];
}

# the failure `f` a link returns, every name it borrows copied into `found`,
# so it borrows nothing the link frees and holds until `found` is released or
# holds the next. what its refused value accepts is read from rows the
# link's caller owns
pub fun hold(found: *Found, f: Fail) Fail {
    var out: Fail = f;
    out.at.file   = keep_name(?found.file, f.at.file);
    out.at.record = keep_name(?found.record, f.at.record);
    out.subject   = keep_name(?found.subject, f.subject);
    if (sel out.refused.some) {
        val g: View = out.refused.some.given;
        out.refused.some.given = View{data: ?found.given.bytes[0], len: keep(?found.given, g.data, g.len)};
    }
    ret out;
}

# the most linker scripts one may name in a chain, one naming the next
val SCRIPT_DEPTH: usize = 16;

# a search under way: what resolves a link's requests to sources and finds
# what the inputs' link claims name while the link runs. it stays where it
# is opened until it is closed, as the claimant and its own sources point
# into it
# ---
# found:    where what the search makes is held
# registry: the formats a file is sniffed and converted through
# options:  the link's options, borrowed while the search is open
# notes:    where the directories a refused search tried are written
# resolved: the sources the requests resolve to, in link order
# sources:  where the request being resolved appends its sources: resolved,
#           or what a claim gives
# search:   where the target's host finds a library or a framework by name
# libdirs:  the directories a library is searched in, in order, once listed
# fwdirs:   the directories a framework is searched in, in order, once listed
# listed:   whether they are
# depth:    how many linker scripts the one being read lies inside
# prefer:   which files a linker script's `-l<name>` entries are searched
#           for first, as the request being resolved states
# cwd:      the working directory a relative path lies in, once read
# follow:   what the following of re-exports knows, across the requests and
#           the claims the link finds
# claims:   each claim found, by its form, kind, inclusion and name
# entered:  the identity of each file entered, parallel to what it found
pub rec Finding {
    found:    *Found;
    registry: *Registry;
    options:  *Options;
    notes:    *Sink;
    resolved: Vector[Source];
    sources:  *Vector[Source];
    search:   os.Search;
    libdirs:  Vector[str];
    fwdirs:   Vector[str];
    listed:   bool;
    depth:    usize;
    prefer:   Prefer;
    cwd:      str;
    follow:   Following;
    claims:   Interner;
    entered:  Interner;
}

pub fun init(a: *A.Allocator) Found {
    ret Found{a: a, paths: vector.init[str](a), loaded: vector.init[Loaded](a), read: vector.init[Read](a)};
}

# give back every file loaded and every path made, reporting the first
# refusal
pub fun dnit(f: *Found) err[Fail] {
    var err_first: err[Fail] = err[Fail].ok{};
    var i:         usize     = 0;
    for (i < vector.length[Loaded](?f.loaded)) {
        err_first = fail.kept(err_first, file.unload(?f.loaded.data[i]));
        i         = i + 1;
    }
    err_first = fail.kept(err_first, vectors.dnit[Loaded](?f.loaded));
    err_first = fail.kept(err_first, vectors.dnit[Read](?f.read));
    i         = 0;
    for (i < vector.length[str](?f.paths)) {
        val s:              str          = f.paths.data[i];
        val err_deallocate: err[A.Error] = A.deallocate[char](f.a, s, str_len(s) + 1);
        if (sel err_deallocate.err) { err_first = fail.kept(err_first, err[Fail].err{fail.refused(err_deallocate.err)}); }
        i = i + 1;
    }
    ret fail.kept(err_first, vectors.dnit[str](?f.paths));
}

# open a search at `c` for the link `o` states through the formats of `g`,
# what it makes held in `f` and the directories a refused search tried
# written to `notes`. the search is given back by close
pub fun finding_init(c: *Finding, f: *Found, g: *Registry, o: *Options, notes: *Sink) {
    @c = Finding{
        found:    f,
        registry: g,
        options:  o,
        notes:    notes,
        resolved: vector.init[Source](f.a),
        search:   os.search(o.target.host),
        libdirs:  vector.init[str](f.a),
        fwdirs:   vector.init[str](f.a),
        follow:   Following{names: intern.init(f.a), loaders: vector.init[bool](f.a), asked: vector.init[bool](f.a), wanted: vector.init[Id[Name]](f.a)},
        claims:   intern.init(f.a),
        entered:  intern.init(f.a),
    };
    c.sources = ?c.resolved;
}

# resolve the `count` requests at `requests` in order to the sources they
# name, appended to the search's resolved sources, and follow the re-exports
# of what they enter. the file a request names by its path is listed as
# requested
pub fun find(c: *Finding, requests: *Request, count: usize) err[Fail] {
    var i: usize = 0;
    for (i < count) {
        val req:         *Request  = ?requests[i];
        val first:       usize     = vector.length[Read](?c.found.read);
        val err_request: err[Fail] = request(c, req);
        if (sel err_request.err) { ret err_request; }
        val by_path: bool = sel req.file;
        if (by_path && vector.length[Read](?c.found.read) > first) { c.found.read.data[first].requested = true; }
        i = i + 1;
    }
    ret follow_all(c, 0);
}

# what finds the files the inputs' link claims name through the search `c`,
# for as long as it is open
pub fun claimant(c: *Finding) Claimant {
    ret Claimant{context: c::ptr, find: claim};
}

# give back what the search holds beside what it found, reporting the first
# refusal
pub fun finding_dnit(c: *Finding) err[Fail] {
    var err_back: err[Fail] = vectors.dnit[Source](?c.resolved);
    err_back = fail.kept(err_back, vectors.dnit[str](?c.libdirs));
    err_back = fail.kept(err_back, vectors.dnit[str](?c.fwdirs));
    err_back = fail.kept(err_back, intern.dnit(?c.follow.names));
    err_back = fail.kept(err_back, vectors.dnit[bool](?c.follow.loaders));
    err_back = fail.kept(err_back, vectors.dnit[bool](?c.follow.asked));
    err_back = fail.kept(err_back, vectors.dnit[Id[Name]](?c.follow.wanted));
    err_back = fail.kept(err_back, intern.dnit(?c.claims));
    ret fail.kept(err_back, intern.dnit(?c.entered));
}

fun request(c: *Finding, r: *Request) err[Fail] {
    if (sel r.source) {
        val err_sources_pushed: err[Fail] = vectors.push[Source](c.sources, r.source);
        if (sel err_sources_pushed.err) { ret err[Fail].err{err_sources_pushed.err}; }
        ret err[Fail].ok{};
    }
    or (sel r.file) {
        c.prefer = Prefer.shared_first{};
        ret named(c, r.file.path, r.file.include, false);
    }
    c.prefer = Prefer.shared_first{};
    if (sel r.library.prefer.static_first || sel r.library.prefer.static_only) { c.prefer = Prefer.static_first{}; }
    ret library(c, r.library, opt[*Tally].none{});
}

# the claimant's find: the claim `cl` found as the request it states, a
# library by its kind alone, with the re-exports of what it enters followed,
# the sources it gives appended to `out`. a claim found before gives nothing
fun claim(context: ptr, cl: *Claim, out: *Vector[Source]) err[Fail] {
    val c:         *Finding        = context::*Finding;
    val res_fresh: res[bool, Fail] = first_claim(c, cl);
    if (sel res_fresh.err) { ret err[Fail].err{res_fresh.err}; }
    if (!res_fresh.ok)     { ret err[Fail].ok{}; }
    val res_name: res[str, Fail] = copied(c, cl.name.data, 0, cl.name.len);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    var include: Include = Include.always{};
    if (cl.referenced) { include = Include.referenced{}; }
    var prefer: Prefer = Prefer.shared_only{};
    if (sel cl.kind.some && sel cl.kind.some.static) { prefer = Prefer.static_only{}; }
    var r: Request = Request.library{Wanted{form: Form.system{}, name: res_name.ok, include: include, prefer: prefer}};
    if (sel cl.form.framework) { r = Request.library{Wanted{form: Form.framework{}, name: res_name.ok, include: include, prefer: prefer}}; }
    or (sel cl.form.local)     { r = Request.file{File{path: res_name.ok, include: include}}; }
    val stated: *Vector[Source] = c.sources;
    c.sources = out;
    val from:        usize     = vector.length[Source](out);
    val err_request: err[Fail] = request(c, ?r);
    var err_done:    err[Fail] = err_request;
    if (sel err_request.ok) { err_done = follow_all(c, from); }
    c.sources = stated;
    ret err_done;
}

# whether the claim `cl` is the first of its form, kind, inclusion and name
fun first_claim(c: *Finding, cl: *Claim) res[bool, Fail] {
    var key:       Sink            = sink.init(c.found.a, LITTLE);
    val res_out:   res[bool, Fail] = keyed(c, cl, ?key);
    val err_freed: err[Fail]       = sink.dnit(?key);
    if (sel res_out.err)   { ret res_out; }
    if (sel err_freed.err) { ret res[bool, Fail].err{err_freed.err}; }
    ret res_out;
}

# whether the key of the claim `cl`, made in `key`, is new to the claims
# found
fun keyed(c: *Finding, cl: *Claim, key: *Sink) res[bool, Fail] {
    var form: u8 = 0;
    if (sel cl.form.framework) { form = 1; }
    or (sel cl.form.local)     { form = 2; }
    var kind: u8 = 0;
    if (sel cl.kind.some && sel cl.kind.some.static) { kind = 1; }
    var err_u8: err[Fail] = sink.u8(key, form);
    err_u8 = fail.kept(err_u8, sink.u8(key, kind));
    err_u8 = fail.kept(err_u8, sink.u8(key, cl.referenced::u8));
    err_u8 = fail.kept(err_u8, sink.bytes(key, cl.name.data, cl.name.len));
    if (sel err_u8.err) { ret res[bool, Fail].err{err_u8.err}; }
    val before:     usize               = intern.count(?c.claims);
    val res_intern: res[Id[Name], Fail] = intern.intern(?c.claims, sink.data(key), sink.len(key));
    if (sel res_intern.err) { ret res[bool, Fail].err{res_intern.err}; }
    ret res[bool, Fail].ok{intern.count(?c.claims) != before};
}

# a kind a file can be to a search for one kind
# ---
# said: how a note names it
rec Sort {
    said: str;
}

val SHARED:  Sort = Sort{said: "a shared library"};
val STATIC:  Sort = Sort{said: "a static library"};
val NEITHER: Sort = Sort{said: "neither kind of library"};

# a search for one kind alone
# ---
# sort:   the kind
# sought: how a note names what it looks for, ahead of the name
# missed: the refusal of a search that met no file of the name
# wrong:  the refusal of a search that met only files of another kind
rec Alone {
    sort:   *Sort;
    sought: str;
    missed: str;
    wrong:  str;
}

val SHARED_ALONE: Alone = Alone{sort: ?SHARED, sought: "a shared library of the name ", missed: "no directory searched holds a shared library of the name", wrong: "the files of the name are not the shared library asked for"};
val STATIC_ALONE: Alone = Alone{sort: ?STATIC, sought: "a static library of the name ", missed: "no directory searched holds a static library of the name", wrong: "the files of the name are not the static library asked for"};

# what the entries of a linker script being sorted are
# ---
# binds:   one is a shared library
# files:   one is another file
# foreign: one is for another architecture
rec Tally {
    binds:   bool;
    files:   bool;
    foreign: bool;
}

# how a linker script is read
# ---
# include:  how its entries enter
# searched: whether a search found it
# tally:    where its entries are counted, none to enter them
rec Walk {
    include:  Include;
    searched: bool;
    tally:    opt[*Tally];
}

# one search for a name
# ---
# name:    the name as the link states it, which a refusal names
# include: how what it finds enters
# alone:   the one kind it asks for, none for a search by preference
# tally:   where what it takes is counted, for the linker script being
#          sorted, none to enter it
# wrong:   the notes of the files of another kind it has met, which reach
#          the link's notes only if it is refused
rec Seeking {
    name:    str;
    include: Include;
    alone:   opt[*Alone];
    tally:   opt[*Tally];
    wrong:   Sink;
}

# what the following of re-exports knows
# ---
# names:   the install names met
# loaders: per name, a library entered has it as its install name
# asked:   per name, a library entered re-exports it
# wanted:  the re-exported names, in the order met
# looked:  how many of them were looked for
rec Following {
    names:   Interner;
    loaders: Vector[bool];
    asked:   Vector[bool];
    wanted:  Vector[Id[Name]];
    looked:  usize;
}

# follow the re-exports of every shared library the search entered from the
# source at `from` on, each library a re-export finds entered and followed in
# turn, until none is found that is not entered already
fun follow_all(c: *Finding, from: usize) err[Fail] {
    val f:    *Following = ?c.follow;
    var next: usize      = from;
    for {
        val end: usize = vector.length[Source](c.sources);
        for (next < end) {
            val err_facts: err[Fail] = facts(c, f, c.sources.data[next]);
            if (sel err_facts.err) { ret err_facts; }
            next = next + 1;
        }
        for (f.looked < vector.length[Id[Name]](?f.wanted)) {
            val n: Id[Name] = f.wanted.data[f.looked];
            f.looked = f.looked + 1;
            if (marked(?f.loaders, n)) { cnt; }
            val err_locate: err[Fail] = locate(c, intern.bytes_of(?f.names, n));
            if (sel err_locate.err) { ret err_locate; }
        }
        if (vector.length[Source](c.sources) == end) { brk; }
    }
    ret err[Fail].ok{};
}

# whether `t` marks the name `n`
fun marked(t: *Vector[bool], n: Id[Name]) bool {
    ret n.index::usize < vector.length[bool](t) && t.data[n.index::usize];
}

# mark the name `n` in `t`, the table growing to hold it, true when it was
# not marked before
fun mark(t: *Vector[bool], n: Id[Name]) res[bool, Fail] {
    val have: usize = vector.length[bool](t);
    if (n.index::usize >= have) {
        val err_grow: err[Fail] = vectors.grow[bool](t, n.index::usize + 1 - have);
        if (sel err_grow.err) { ret res[bool, Fail].err{err_grow.err}; }
    }
    val was: bool = t.data[n.index::usize];
    t.data[n.index::usize] = true;
    ret res[bool, Fail].ok{!was};
}

# what the source `s` states of the libraries: the install name of the
# shared library it is and the libraries it re-exports. a source of no file,
# and one no format reads, states nothing, and a container states what its
# member for the link's architecture does
fun facts(c: *Finding, f: *Following, s: Source) err[Fail] {
    if (!sel s.included) { ret err[Fail].ok{}; }
    ret input_facts(c, f, s.included.input);
}

fun input_facts(c: *Finding, f: *Following, in: contract.Input) err[Fail] {
    var probe:     contract.Input              = in;
    val res_known: res[*contract.Reader, Fail] = readers.sniff(?c.registry.readers, ?probe);
    if (sel res_known.err) { ret err[Fail].ok{}; }
    val res_probe_run: res[Model, Fail] = shell.run(res_known.ok, c.found.a, ?probe);
    if (sel res_probe_run.err) { ret err[Fail].err{res_probe_run.err}; }
    var model:           Model     = res_probe_run.ok;
    val err_model_facts: err[Fail] = model_facts(c, f, ?model, in.file);
    ret fail.kept(err_model_facts, contract.dnit(?model));
}

fun model_facts(c: *Finding, f: *Following, m: *Model, file: str) err[Fail] {
    val res_held: res[bool, Fail] = contract.is_container(m);
    if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
    if (res_held.ok)      { ret member_facts(c, f, m, file); }
    val res_kind: res[*kind.Kind, Fail] = contract.kind(m);
    if (sel res_kind.err)                   { ret err[Fail].err{res_kind.err}; }
    if (!kind.has(res_kind.ok, kind.BINDS)) { ret err[Fail].ok{}; }
    var o:                Object    = object.init(c.found.a, c.options.target.arch, nil);
    val err_object_facts: err[Fail] = object_facts(c, f, m, ?o);
    val err_release:      err[Fail] = object.dnit(?o);
    if (sel err_object_facts.err) { ret err[Fail].err{fail.in_file(err_object_facts.err, file)}; }
    ret err_release;
}

# what the member of the container `m` for the link's architecture states
fun member_facts(c: *Finding, f: *Following, m: *Model, file: str) err[Fail] {
    var members:     Table[Member] = table.init[Member](c.found.a);
    var err_members: err[Fail]     = contract.members(m, file, ?members);
    var i:           usize         = 0;
    for (i < table.count[Member](?members) && sel err_members.ok) {
        val member: *Member = table.at[Member](?members, table.nth[Member](i));
        i = i + 1;
        if (sel member.arch.none) { cnt; }
        var code:     Stated           = member.arch.some;
        val res_fits: res[*Arch, Fail] = arch_list.by_code(?code);
        if (!(sel res_fits.ok && res_fits.ok == c.options.target.arch)) { cnt; }
        err_members = input_facts(c, f, member.input);
        brk;
    }
    ret fail.kept(err_members, table.dnit[Member](?members));
}

fun object_facts(c: *Finding, f: *Following, m: *Model, o: *Object) err[Fail] {
    val err_conv: err[Fail] = registry.to_neutral(c.registry, m, o);
    if (sel err_conv.err)   { ret err_conv; }
    if (sel o.library.none) { ret err[Fail].ok{}; }
    val opt_own: opt[Id[Name]] = o.library.some.loader;
    if (sel opt_own.some) {
        val v:          View                = object.name_of(o, opt_own.some);
        val res_intern: res[Id[Name], Fail] = intern.intern(?f.names, v.data, v.len);
        if (sel res_intern.err) { ret err[Fail].err{res_intern.err}; }
        val res_mark: res[bool, Fail] = mark(?f.loaders, res_intern.ok);
        if (sel res_mark.err) { ret err[Fail].err{res_mark.err}; }
    }
    var k: usize = 0;
    for (k < table.count[object.Dependency](?o.libraries)) {
        val d: *object.Dependency = table.at[object.Dependency](?o.libraries, table.nth[object.Dependency](k));
        k = k + 1;
        if (!d.reexports) { cnt; }
        val opt_dep: opt[Id[Name]] = d.library.loader;
        if (sel opt_dep.none) { cnt; }
        val v:          View                = object.name_of(o, opt_dep.some);
        val res_intern: res[Id[Name], Fail] = intern.intern(?f.names, v.data, v.len);
        if (sel res_intern.err) { ret err[Fail].err{res_intern.err}; }
        val res_fresh: res[bool, Fail] = mark(?f.asked, res_intern.ok);
        if (sel res_fresh.err) { ret err[Fail].err{res_fresh.err}; }
        if (!res_fresh.ok)     { cnt; }
        val err_wanted_pushed: err[Fail] = vectors.push[Id[Name]](?f.wanted, res_intern.ok);
        if (sel err_wanted_pushed.err) { ret err[Fail].err{err_wanted_pushed.err}; }
    }
    ret err[Fail].ok{};
}

# the suffix of a dylib's install name, which its text stub replaces
val DYLIB: str = ".dylib";
# the suffix of a text stub
val STUB: str = ".tbd";

# look for the library of install name `install` and enter it where found:
# its text stub beside it under the sysroot, then the file itself, then a
# file of its name in each library directory, the stub first
fun locate(c: *Finding, install: View) err[Fail] {
    val res_path: res[str, Fail] = copied(c, install.data, 0, install.len);
    if (sel res_path.err) { ret err[Fail].err{res_path.err}; }
    val res_stem: res[str, Fail] = stem_of_path(c, res_path.ok);
    if (sel res_stem.err) { ret err[Fail].err{res_stem.err}; }
    val root:    str             = c.options.sysroot;
    val res_hit: res[bool, Fail] = reexported_at(c, str_join(c.found.a, root, res_stem.ok, STUB));
    if (sel res_hit.err) { ret err[Fail].err{res_hit.err}; }
    if (res_hit.ok)      { ret err[Fail].ok{}; }
    val res_whole: res[bool, Fail] = reexported_at(c, str_join(c.found.a, root, res_path.ok));
    if (sel res_whole.err) { ret err[Fail].err{res_whole.err}; }
    if (res_whole.ok)      { ret err[Fail].ok{}; }
    val err_listed: err[Fail] = listed(c);
    if (sel err_listed.err) { ret err_listed; }
    val base:      str   = base_of(res_path.ok);
    val base_stem: str   = base_of(res_stem.ok);
    var d:         usize = 0;
    for (d < vector.length[str](?c.libdirs)) {
        val dir: str = c.libdirs.data[d];
        d = d + 1;
        val res_reexported_at: res[bool, Fail] = reexported_at(c, str_join(c.found.a, dir, "/", base_stem, STUB));
        if (sel res_reexported_at.err) { ret err[Fail].err{res_reexported_at.err}; }
        if (res_reexported_at.ok)      { ret err[Fail].ok{}; }
        val res_reexported_at_str_join: res[bool, Fail] = reexported_at(c, str_join(c.found.a, dir, "/", base));
        if (sel res_reexported_at_str_join.err) { ret err[Fail].err{res_reexported_at_str_join.err}; }
        if (res_reexported_at_str_join.ok)      { ret err[Fail].ok{}; }
    }
    ret err[Fail].ok{};
}

# whether the file at `made` is a shared library for the link, entered as
# one the image loads only when a reference binds to it
fun reexported_at(c: *Finding, made: res[str, StrError]) res[bool, Fail] {
    var s: Seeking = Seeking{include: Include.referenced{}};
    ret candidate(c, made, ?s, true, false);
}

# the path `path` without the dylib suffix where it ends in it
fun stem_of_path(c: *Finding, path: str) res[str, Fail] {
    val n: usize = str_len(path);
    val s: usize = str_len(DYLIB);
    if (n <= s || !memory.raw_equal((path::usize + n - s)::ptr, DYLIB::ptr, s)) { ret res[str, Fail].ok{path}; }
    ret copied(c, path::*u8, 0, n - s);
}

# the file name of the path `path`, what follows its last separator
fun base_of(path: str) str {
    val n:  usize = str_len(path);
    var at: usize = 0;
    var i:  usize = 0;
    for (i < n) {
        if (path[i] == '/') { at = i + 1; }
        i = i + 1;
    }
    ret (path::usize + at)::str;
}

# whether the link's system reads a library file no format reads as a GNU
# linker script
fun reads_scripts(c: *Finding) bool {
    val opt_naming: opt[*Naming] = c.search.naming;
    if (sel opt_naming.none) { ret false; }
    ret opt_naming.some.scripts;
}

# hold `r`, a string made for the search, until the search is released
fun own(c: *Finding, r: res[str, StrError]) res[str, Fail] {
    if (sel r.err) {
        val e: StrError = r.err;
        if (sel e.alloc) { ret res[str, Fail].err{fail.refused(e.alloc)}; }
        ret res[str, Fail].err{fail.internal("a path could not be made")};
    }
    ret kept_path(c, r.ok);
}

# hold `s`, a string made for the search, until the search is released
fun kept_path(c: *Finding, s: str) res[str, Fail] {
    val err_pushed: err[Fail] = vectors.push[str](?c.found.paths, s);
    if (sel err_pushed.err) {
        free(c, s);
        ret res[str, Fail].err{err_pushed.err};
    }
    ret res[str, Fail].ok{s};
}

# give back `s`, a string made for the search and not held
fun free(c: *Finding, s: str) {
    val err_deallocate: err[A.Error] = A.deallocate[char](c.found.a, s, str_len(s) + 1);
}

# the `len` bytes at `at` of `data`, held with a zero after them
fun copied(c: *Finding, data: *u8, at: usize, len: usize) res[str, Fail] {
    val res_allocate: res[str, A.Error] = A.allocate[char](c.found.a, len + 1);
    if (sel res_allocate.err) { ret res[str, Fail].err{fail.refused(res_allocate.err)}; }
    memory.raw_copy(res_allocate.ok::ptr, (data::usize + at)::ptr, len);
    res_allocate.ok[len] = 0;
    ret own(c, res[str, StrError].ok{res_allocate.ok});
}

# list the directories a library and a framework are searched in: those the
# link adds, then the system's under the sysroot
fun listed(c: *Finding) err[Fail] {
    if (c.listed) { ret err[Fail].ok{}; }
    val s: *os.Search = ?c.search;
    val o: *Options   = c.options;
    var i: usize      = 0;
    for (i < o.libdir_count) {
        val err_listed_one: err[Fail] = listed_one(c, ?c.libdirs, nil, o.libdirs[i]);
        if (sel err_listed_one.err) { ret err_listed_one; }
        i = i + 1;
    }
    i = 0;
    for (i < s.libdir_count) {
        val err_listed_one: err[Fail] = listed_one(c, ?c.libdirs, o.sysroot, s.libdirs[i]);
        if (sel err_listed_one.err) { ret err_listed_one; }
        i = i + 1;
    }
    i = 0;
    for (i < o.fwdir_count) {
        val err_listed_one: err[Fail] = listed_one(c, ?c.fwdirs, nil, o.fwdirs[i]);
        if (sel err_listed_one.err) { ret err_listed_one; }
        i = i + 1;
    }
    i = 0;
    for (i < s.framework_count) {
        val err_listed_one: err[Fail] = listed_one(c, ?c.fwdirs, o.sysroot, s.frameworks[i]);
        if (sel err_listed_one.err) { ret err_listed_one; }
        i = i + 1;
    }
    c.listed = true;
    ret err[Fail].ok{};
}

# append `dir` under `root`, nil for none, to `into`
fun listed_one(c: *Finding, into: *Vector[str], root: str, dir: str) err[Fail] {
    val res_own: res[str, Fail] = own(c, str_join(c.found.a, root, dir));
    if (sel res_own.err) { ret err[Fail].err{res_own.err}; }
    val err_into_pushed: err[Fail] = vectors.push[str](into, res_own.ok);
    if (sel err_into_pushed.err) { ret err[Fail].err{err_into_pushed.err}; }
    ret err[Fail].ok{};
}

# the library or the framework `w`, found by its name, and counted in `tally`
# where one is given instead of entered
fun library(c: *Finding, w: Wanted, tally: opt[*Tally]) err[Fail] {
    val opt_naming: opt[*Naming] = c.search.naming;
    if (sel opt_naming.none) { ret err[Fail].err{fail.about(fail.in_record(fail.malformed("the system's linker finds no library by name"), c.options.target.sys.name), w.name)}; }
    val err_listed: err[Fail] = listed(c);
    if (sel err_listed.err) { ret err_listed; }
    var seeking: Seeking = Seeking{name: w.name, include: w.include, tally: tally, wrong: sink.init(c.found.a, LITTLE)};
    if (sel w.prefer.shared_only) { seeking.alone = opt[*Alone].some{?SHARED_ALONE}; }
    or (sel w.prefer.static_only) { seeking.alone = opt[*Alone].some{?STATIC_ALONE}; }
    var err_out: err[Fail] = err[Fail].ok{};
    if (sel w.form.framework) { err_out = framework(c, opt_naming.some, w, ?seeking); }
    or                        { err_out = system_library(c, opt_naming.some, w, ?seeking); }
    ret fail.kept(err_out, sink.dnit(?seeking.wrong));
}

# the library `w`, found by the steps of the naming's order for its
# preference, its stem dropped first. a search for one kind tries every step
# whatever the output kind, since the contents of a file decide. a shared
# library alone is refused outright for an output kind that imports nothing
fun system_library(c: *Finding, naming: *Naming, w: Wanted, seeking: *Seeking) err[Fail] {
    val res_name: res[str, Fail] = stem_of(c, naming, w.name);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    val imports: bool = output.has(c.options.kind, output.IMPORTS);
    if (sel w.prefer.shared_only && !imports) { ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the output kind imports nothing, so no shared library can be taken"), c.options.kind.name), w.name)}; }
    var order: *Order = ?naming.shared_first;
    if (sel w.prefer.static_first || sel w.prefer.static_only) { order = ?naming.static_first; }
    val every: bool  = imports || sel seeking.alone.some;
    var s:     usize = 0;
    for (s < order.count) {
        val step: *Step = ?order.steps[s];
        s = s + 1;
        var res_hit: res[bool, Fail] = res[bool, Fail].ok{false};
        if (sel step.files) { res_hit = files_step(c, ?step.files, res_name.ok, seeking, every); }
        or (sel step.majors) {
            if (every) { res_hit = majors_step(c, step.majors, res_name.ok, seeking); }
        }
        if (sel res_hit.err) { ret err[Fail].err{res_hit.err}; }
        if (res_hit.ok)      { ret err[Fail].ok{}; }
    }
    ret refused(c, seeking, ?c.libdirs);
}

# whether a library directory holds one of the files `f` of the name `name`
# that is taken, each directory tried for every file in order
fun files_step(c: *Finding, f: *Files, name: str, seeking: *Seeking, every: bool) res[bool, Fail] {
    var d: usize = 0;
    for (d < vector.length[str](?c.libdirs)) {
        val dir: str   = c.libdirs.data[d];
        var k:   usize = 0;
        d = d + 1;
        for (k < f.count) {
            val p: *Pattern = f.rows[k];
            k = k + 1;
            if (p.loaded && !every) { cnt; }
            val res_made: res[str, StrError] = str_join(c.found.a, dir, "/", p.prefix, name, p.suffix);
            val res_hit:  res[bool, Fail]    = candidate(c, res_made, seeking, p.loaded, p.loaded);
            if (sel res_hit.err) { ret res_hit; }
            if (res_hit.ok)      { ret res_hit; }
        }
    }
    ret res[bool, Fail].ok{false};
}

# a file of a major version a directory holds: its major and where the
# directory's listing holds its name
rec Versioned {
    major: u64;
    at:    usize;
}

fun by_major(x: *Versioned, y: *Versioned) i64 {
    if (x.major < y.major) { ret -1; }
    if (x.major > y.major) { ret 1; }
    ret 0;
}

# whether a library directory holds a file of a major version of the name
# `name` that is taken, each directory tried for its majors, the highest
# first
fun majors_step(c: *Finding, m: *Major, name: str, seeking: *Seeking) res[bool, Fail] {
    var d: usize = 0;
    for (d < vector.length[str](?c.libdirs)) {
        val dir:     str             = c.libdirs.data[d];
        val res_hit: res[bool, Fail] = majors_in(c, dir, m, name, seeking);
        d = d + 1;
        if (sel res_hit.err) { ret res_hit; }
        if (res_hit.ok)      { ret res_hit; }
    }
    ret res[bool, Fail].ok{false};
}

fun majors_in(c: *Finding, dir: str, m: *Major, name: str, seeking: *Seeking) res[bool, Fail] {
    val res_there: res[bool, io_error.Error] = fs.is_dir(dir);
    if (sel res_there.err) { ret res[bool, Fail].err{file.io_refusal(res_there.err, "cannot tell whether the directory exists", dir)}; }
    if (!res_there.ok)     { ret res[bool, Fail].ok{false}; }
    val res_listing: res[Vector[fs.Listed], fs.FsError] = fs.read_dir(c.found.a, dir);
    if (sel res_listing.err) { ret res[bool, Fail].err{file.refusal(res_listing.err, "cannot list the directory", dir)}; }
    var entries:    Vector[fs.Listed] = res_listing.ok;
    var found:      Vector[Versioned] = vector.init[Versioned](c.found.a);
    var err_listed: err[Fail]         = err[Fail].ok{};
    var i:          usize             = 0;
    for (i < entries.len && sel err_listed.ok) {
        val e: fs.Listed = entries.data[i];
        i = i + 1;
        var opt_major_of: opt[u64] = opt[u64].none{};
        if (sel e.name)            { opt_major_of = major_of(e.name, m, name); }
        if (sel opt_major_of.none) { cnt; }
        val err_found_pushed: err[Fail] = vectors.push[Versioned](?found, Versioned{major: opt_major_of.some, at: i - 1});
        if (sel err_found_pushed.err) { err_listed = err[Fail].err{err_found_pushed.err}; }
    }
    var res_out: res[bool, Fail] = res[bool, Fail].ok{false};
    if (sel err_listed.err) { res_out = res[bool, Fail].err{err_listed.err}; }
    or {
        sort.sort_by[Versioned](found.data, vector.length[Versioned](?found), by_major);
        res_out = highest(c, dir, ?entries, ?found, seeking);
    }
    fs.listed_dnit(?entries);
    ret settled(res_out, vectors.dnit[Versioned](?found));
}

# whether a file of the majors `found`, sorted, of the listing `entries` of
# `dir` is taken, the highest first
fun highest(c: *Finding, dir: str, entries: *Vector[fs.Listed], found: *Vector[Versioned], seeking: *Seeking) res[bool, Fail] {
    var k: usize = vector.length[Versioned](found);
    for (k > 0) {
        k = k - 1;
        val e: fs.Listed = entries.data[found.data[k].at];
        if (sel e.name) {
            val res_hit: res[bool, Fail] = candidate(c, str_join(c.found.a, dir, "/", e.name), seeking, true, false);
            if (sel res_hit.err) { ret res_hit; }
            if (res_hit.ok)      { ret res_hit; }
        }
    }
    ret res[bool, Fail].ok{false};
}

# `out`, or the refusal of giving back what made it when it holds none
fun settled(out: res[bool, Fail], back: err[Fail]) res[bool, Fail] {
    if (sel out.err)  { ret out; }
    if (sel back.err) { ret res[bool, Fail].err{back.err}; }
    ret out;
}

# the major version the file `file` carries as a file of the major `m` of
# the name `name`, none when it is no such file: the major is decimal, with
# no leading zero but a lone one, and fits in 64 bits
fun major_of(file: str, m: *Major, name: str) opt[u64] {
    val n:    usize = str_len(file);
    val head: usize = str_len(m.prefix) + str_len(name) + str_len(m.infix);
    val tail: usize = str_len(m.suffix);
    if (n <= head + tail)                                                                                                                                                   { ret opt[u64].none{}; }
    if (!spans(file, 0, m.prefix) || !spans(file, str_len(m.prefix), name) || !spans(file, str_len(m.prefix) + str_len(name), m.infix) || !spans(file, n - tail, m.suffix)) { ret opt[u64].none{}; }
    val digits: usize = n - head - tail;
    if (digits > 1 && file[head] == '0') { ret opt[u64].none{}; }
    var v: u64   = 0;
    var i: usize = head;
    for (i < head + digits) {
        val b: u8 = file[i];
        if (b < '0' || b > '9') { ret opt[u64].none{}; }
        val d: u64 = (b - '0')::u64;
        if (v > (0xffff_ffff_ffff_ffff - d) / 10) { ret opt[u64].none{}; }
        v = v * 10 + d;
        i = i + 1;
    }
    ret opt[u64].some{v};
}

# whether `text` lies in `s` at `at`, which is in bounds for it
fun spans(s: str, at: usize, text: str) bool {
    var i: usize = 0;
    for (i < str_len(text)) {
        if (s[at + i] != text[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the framework `w` in the first framework directory whose bundle of its
# name holds a file the naming states that is taken
fun framework(c: *Finding, naming: *Naming, w: Wanted, seeking: *Seeking) err[Fail] {
    if (naming.bundle == nil) { ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the system has no frameworks"), c.options.target.sys.name), w.name)}; }
    var d: usize = 0;
    for (d < vector.length[str](?c.fwdirs)) {
        val dir: str   = c.fwdirs.data[d];
        var k:   usize = 0;
        d = d + 1;
        for (k < naming.bundle_count) {
            val p:        *Pattern           = ?naming.bundles[k];
            val res_made: res[str, StrError] = str_join(c.found.a, dir, "/", w.name, naming.bundle, "/", p.prefix, w.name, p.suffix);
            val res_hit:  res[bool, Fail]    = candidate(c, res_made, seeking, p.loaded, false);
            k = k + 1;
            if (sel res_hit.err) { ret err[Fail].err{res_hit.err}; }
            if (res_hit.ok)      { ret err[Fail].ok{}; }
        }
    }
    ret refused(c, seeking, ?c.fwdirs);
}

# `name` without the naming's stem when it ends in it, compared without case
fun stem_of(c: *Finding, naming: *Naming, name: str) res[str, Fail] {
    if (naming.stem == nil) { ret res[str, Fail].ok{name}; }
    val n: usize = str_len(name);
    val s: usize = str_len(naming.stem);
    if (n <= s) { ret res[str, Fail].ok{name}; }
    var i: usize = 0;
    for (i < s) {
        if (folded(name[n - s + i]) != folded(naming.stem[i])) { ret res[str, Fail].ok{name}; }
        i = i + 1;
    }
    ret copied(c, name::*u8, 0, n - s);
}

fun folded(b: u8) u8 {
    if (b >= 'A' && b <= 'Z') { ret b + ('a' - 'A'); }
    ret b;
}

# whether the file at `made`, a path made for the search, is the library:
# it is a file and is taken, and its sources are entered. `loaded` says the
# file is one the loader loads, and `scripts` that it may be a linker script.
# a search for one kind takes it by what it is instead. a file not taken is
# let go with its path, leaving the search as it was
fun candidate(c: *Finding, made: res[str, StrError], seeking: *Seeking, loaded: bool, scripts: bool) res[bool, Fail] {
    val paths:    usize          = vector.length[str](?c.found.paths);
    val files:    usize          = vector.length[Loaded](?c.found.loaded);
    val res_path: res[str, Fail] = own(c, made);
    if (sel res_path.err) { ret res[bool, Fail].err{res_path.err}; }
    val res_present: res[bool, Fail] = is_file(res_path.ok);
    if (sel res_present.err) { ret res_present; }
    if (!res_present.ok) {
        val err_gone: err[Fail] = rewind(c, paths, files);
        if (sel err_gone.err) { ret res[bool, Fail].err{err_gone.err}; }
        ret res_present;
    }
    val res_load: res[contract.Input, Fail] = load(c, res_path.ok);
    if (sel res_load.err) { ret res[bool, Fail].err{res_load.err}; }
    var res_fits: res[bool, Fail] = res[bool, Fail].ok{false};
    if (sel seeking.alone.some) { res_fits = of_kind(c, res_load.ok, seeking, seeking.alone.some); }
    or                          { res_fits = taken(c, res_load.ok, loaded, scripts); }
    if (sel res_fits.err)       { ret res_fits; }
    if (!res_fits.ok) {
        val err_gone: err[Fail] = rewind(c, paths, files);
        if (sel err_gone.err) { ret res[bool, Fail].err{err_gone.err}; }
        ret res_fits;
    }
    if (sel seeking.tally.some) {
        val err_counted: err[Fail] = count(c, res_load.ok, seeking.tally.some);
        if (sel err_counted.err) { ret res[bool, Fail].err{err_counted.err}; }
        val err_gone: err[Fail] = rewind(c, paths, files);
        if (sel err_gone.err) { ret res[bool, Fail].err{err_gone.err}; }
        ret res_fits;
    }
    val err_enter: err[Fail] = enter(c, res_load.ok, seeking.include, true);
    if (sel err_enter.err) { ret res[bool, Fail].err{err_enter.err}; }
    ret res[bool, Fail].ok{true};
}

# give back every file and path the search made after it held `files` and
# `paths`, leaving it as it was then
fun rewind(c: *Finding, paths: usize, files: usize) err[Fail] {
    var err_first: err[Fail] = err[Fail].ok{};
    var i:         usize     = vector.length[Loaded](?c.found.loaded);
    for (i > files) {
        i         = i - 1;
        err_first = fail.kept(err_first, file.unload(?c.found.loaded.data[i]));
    }
    vectors.truncate[Loaded](?c.found.loaded, files);
    i = vector.length[str](?c.found.paths);
    for (i > paths) {
        i = i - 1;
        free(c, c.found.paths.data[i]);
    }
    vectors.truncate[str](?c.found.paths, paths);
    ret err_first;
}

# count what the file `in`, an entry of a linker script being sorted, is
fun count(c: *Finding, in: contract.Input, t: *Tally) err[Fail] {
    val res_sorted: res[opt[*Sort], Fail] = sorted(c, in);
    if (sel res_sorted.err) { ret err[Fail].err{res_sorted.err}; }
    val opt_sort: opt[*Sort] = res_sorted.ok;
    if (sel opt_sort.none) {
        t.foreign = true;
        ret err[Fail].ok{};
    }
    if (opt_sort.some == ?SHARED) { t.binds = true; }
    or                            { t.files = true; }
    ret err[Fail].ok{};
}

# whether the candidate `in` is the kind `alone` asks for. one of the wrong
# kind is set down for the refusal the search may end in, and one for another
# architecture counts as absent
fun of_kind(c: *Finding, in: contract.Input, seeking: *Seeking, alone: *Alone) res[bool, Fail] {
    val res_sorted: res[opt[*Sort], Fail] = sorted(c, in);
    if (sel res_sorted.err) { ret res[bool, Fail].err{res_sorted.err}; }
    val opt_sort: opt[*Sort] = res_sorted.ok;
    if (sel opt_sort.none)           { ret res[bool, Fail].ok{false}; }
    if (opt_sort.some == alone.sort) { ret res[bool, Fail].ok{true}; }
    val err_found_wrong: err[Fail] = found_wrong(?seeking.wrong, in.file, seeking.name, opt_sort.some, alone.sort);
    if (sel err_found_wrong.err) { ret res[bool, Fail].err{err_found_wrong.err}; }
    ret res[bool, Fail].ok{false};
}

# set down in `out` that the file `file` of the name `name` is `is`, not `asked`
fun found_wrong(out: *Sink, file: str, name: str, is: *Sort, asked: *Sort) err[Fail] {
    val err_found_text_written: err[Fail] = sink.text(out, "found ");
    if (sel err_found_text_written.err) { ret err_found_text_written; }
    val err_file_written: err[Fail] = sink.text(out, file);
    if (sel err_file_written.err) { ret err_file_written; }
    val err_for_text_written: err[Fail] = sink.text(out, " for ");
    if (sel err_for_text_written.err) { ret err_for_text_written; }
    val err_name_written: err[Fail] = sink.text(out, name);
    if (sel err_name_written.err) { ret err_name_written; }
    val err_colon_written: err[Fail] = sink.text(out, ": ");
    if (sel err_colon_written.err) { ret err_colon_written; }
    val err_is_written: err[Fail] = sink.text(out, is.said);
    if (sel err_is_written.err) { ret err_is_written; }
    val err_not_text_written: err[Fail] = sink.text(out, ", not ");
    if (sel err_not_text_written.err) { ret err_not_text_written; }
    val err_asked_written: err[Fail] = sink.text(out, asked.said);
    if (sel err_asked_written.err) { ret err_asked_written; }
    ret sink.text(out, "\n");
}

# what the candidate `in` is, none when it is for another architecture
fun sorted(c: *Finding, in: contract.Input) res[opt[*Sort], Fail] {
    var probe:     contract.Input              = in;
    val res_known: res[*contract.Reader, Fail] = readers.sniff(?c.registry.readers, ?probe);
    if (sel res_known.err) {
        var scripted: bool = false;
        if (textual(in)) { scripted = reads_scripts(c); }
        if (scripted)    { ret sorted_script(c, in); }
        ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?NEITHER}};
    }
    val res_probe_run: res[Model, Fail] = shell.run(res_known.ok, c.found.a, ?probe);
    if (sel res_probe_run.err) { ret res[opt[*Sort], Fail].err{res_probe_run.err}; }
    var model:       Model                 = res_probe_run.ok;
    val res_out:     res[opt[*Sort], Fail] = sorted_model(c, ?model, in.file);
    val err_release: err[Fail]             = contract.dnit(?model);
    if (sel res_out.err)     { ret res_out; }
    if (sel err_release.err) { ret res[opt[*Sort], Fail].err{err_release.err}; }
    ret res_out;
}

# what the linker script `in` is: a shared library when any file it names is,
# a static one when it names another, none when all it names are for another
# architecture, and neither when it names no file. the first file that binds
# settles it, and nothing the sorting holds outlives it
fun sorted_script(c: *Finding, in: contract.Input) res[opt[*Sort], Fail] {
    val paths:    usize     = vector.length[str](?c.found.paths);
    val files:    usize     = vector.length[Loaded](?c.found.loaded);
    var t:        Tally     = Tally{};
    var w:        Walk      = Walk{include: Include.referenced{}, tally: opt[*Tally].some{?t}};
    val err_read: err[Fail] = script(c, in, ?w);
    if (sel err_read.err) { ret res[opt[*Sort], Fail].err{err_read.err}; }
    val err_gone: err[Fail] = rewind(c, paths, files);
    if (sel err_gone.err) { ret res[opt[*Sort], Fail].err{err_gone.err}; }
    if (t.binds)          { ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?SHARED}}; }
    if (t.files)          { ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?STATIC}}; }
    if (t.foreign)        { ret res[opt[*Sort], Fail].ok{opt[*Sort].none{}}; }
    ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?NEITHER}};
}

# what the model `m` of the candidate `file` is, as `sorted` states
fun sorted_model(c: *Finding, m: *Model, file: str) res[opt[*Sort], Fail] {
    val res_held: res[bool, Fail] = contract.is_container(m);
    if (sel res_held.err) { ret res[opt[*Sort], Fail].err{res_held.err}; }
    if (res_held.ok)      { ret sorted_container(c, m, file); }
    if (foreign(c, m))    { ret res[opt[*Sort], Fail].ok{opt[*Sort].none{}}; }
    val res_kind: res[*kind.Kind, Fail] = contract.kind(m);
    if (sel res_kind.err)                   { ret res[opt[*Sort], Fail].err{res_kind.err}; }
    if (kind.has(res_kind.ok, kind.BINDS))  { ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?SHARED}}; }
    if (kind.has(res_kind.ok, kind.OBJECT)) { ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?STATIC}}; }
    ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?NEITHER}};
}

# what the container `m` named `file` is: what its member for the link's
# architecture is when its members state theirs, else a shared library when
# any member binds and a static one otherwise
fun sorted_container(c: *Finding, m: *Model, file: str) res[opt[*Sort], Fail] {
    var members:    Table[Member]         = table.init[Member](c.found.a);
    val err_listed: err[Fail]             = contract.members(m, file, ?members);
    var res_out:    res[opt[*Sort], Fail] = res[opt[*Sort], Fail].err{fail.internal("no member was read")};
    if (sel err_listed.err) { res_out = res[opt[*Sort], Fail].err{err_listed.err}; }
    or {
        val fit: Fitting = fitting(c, ?members);
        if (!fit.coded)        { res_out = bound_by(c, ?members); }
        or (sel fit.pick.some) { res_out = sorted(c, fit.pick.some); }
        or                     { res_out = res[opt[*Sort], Fail].ok{opt[*Sort].none{}}; }
    }
    val err_back: err[Fail] = table.dnit[Member](?members);
    if (sel res_out.err)  { ret res_out; }
    if (sel err_back.err) { ret res[opt[*Sort], Fail].err{err_back.err}; }
    ret res_out;
}

# a shared library when any of `members` binds, asked of each member's own
# format from its headers, and a static one otherwise. the walk stops at the
# first that binds and reads no member's model. a member no format reads
# binds nothing
fun bound_by(c: *Finding, members: *Table[Member]) res[opt[*Sort], Fail] {
    var i: usize = 0;
    for (i < table.count[Member](members)) {
        var in: contract.Input = table.at[Member](members, table.nth[Member](i)).input;
        i = i + 1;
        val res_known: res[*contract.Reader, Fail] = readers.sniff(?c.registry.readers, ?in);
        if (sel res_known.err) { cnt; }
        val res_binds: res[bool, Fail] = res_known.ok.codec.binds(?in);
        if (sel res_binds.err) { ret res[opt[*Sort], Fail].err{res_binds.err}; }
        if (res_binds.ok)      { ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?SHARED}}; }
    }
    ret res[opt[*Sort], Fail].ok{opt[*Sort].some{?STATIC}};
}

# what a container's members state of the link's architecture
# ---
# coded: a member states its architecture
# pick:  the first member for the link's architecture
rec Fitting {
    coded: bool;
    pick:  opt[contract.Input];
}

fun fitting(c: *Finding, members: *Table[Member]) Fitting {
    var fit: Fitting = Fitting{};
    var i:   usize   = 0;
    for (i < table.count[Member](members)) {
        val member: *Member = table.at[Member](members, table.nth[Member](i));
        i = i + 1;
        if (sel member.arch.none) { cnt; }
        fit.coded = true;
        var code:    Stated           = member.arch.some;
        val res_row: res[*Arch, Fail] = arch_list.by_code(?code);
        val fits:    bool             = sel res_row.ok && res_row.ok == c.options.target.arch;
        if (sel fit.pick.none && fits) { fit.pick = opt[contract.Input].some{member.input}; }
    }
    ret fit;
}

# whether the model `m` states an architecture other than the link's
fun foreign(c: *Finding, m: *Model) bool {
    val opt_stated: opt[Stated] = contract.stated(m);
    if (sel opt_stated.none) { ret false; }
    var code:    Stated           = opt_stated.some;
    val res_row: res[*Arch, Fail] = arch_list.by_code(?code);
    ret !(sel res_row.ok && res_row.ok == c.options.target.arch);
}

# whether a regular file lies at `path`, refused when that cannot be told
fun is_file(path: str) res[bool, Fail] {
    val res_is_file: res[bool, io_error.Error] = fs.is_file(path);
    if (sel res_is_file.err) { ret res[bool, Fail].err{file.io_refusal(res_is_file.err, "cannot tell whether the file exists", path)}; }
    ret res[bool, Fail].ok{res_is_file.ok};
}

# refuse the search `seeking`, which took nothing from `dirs`
fun refused(c: *Finding, seeking: *Seeking, dirs: *Vector[str]) err[Fail] {
    if (sel seeking.alone.none) { ret unfound(c, seeking.name, dirs); }
    val alone:        *Alone    = seeking.alone.some;
    val err_searched: err[Fail] = searched(c, alone.sought, seeking.name, dirs);
    if (sel err_searched.err)          { ret err_searched; }
    if (sink.len(?seeking.wrong) == 0) { ret err[Fail].err{fail.about(fail.missing(alone.missed), seeking.name)}; }
    val err_bytes: err[Fail] = sink.bytes(c.notes, sink.data(?seeking.wrong), sink.len(?seeking.wrong));
    if (sel err_bytes.err) { ret err_bytes; }
    ret err[Fail].err{fail.about(fail.missing(alone.wrong), seeking.name)};
}

# refuse the name `name` found in none of `dirs`, each written to the notes
fun unfound(c: *Finding, name: str, dirs: *Vector[str]) err[Fail] {
    val err_searched: err[Fail] = searched(c, "", name, dirs);
    if (sel err_searched.err) { ret err_searched; }
    ret err[Fail].err{fail.about(fail.missing("no directory searched holds a file of the name"), name)};
}

# write each of `dirs` to the notes as searched for `what` and the name `name`
fun searched(c: *Finding, what: str, name: str, dirs: *Vector[str]) err[Fail] {
    var d: usize = 0;
    for (d < vector.length[str](dirs)) {
        val err_searched_text_written: err[Fail] = sink.text(c.notes, "searched for ");
        if (sel err_searched_text_written.err) { ret err_searched_text_written; }
        val err_text: err[Fail] = sink.text(c.notes, what);
        if (sel err_text.err) { ret err_text; }
        val err_name_written: err[Fail] = sink.text(c.notes, name);
        if (sel err_name_written.err) { ret err_name_written; }
        val err_in_text_written: err[Fail] = sink.text(c.notes, " in ");
        if (sel err_in_text_written.err) { ret err_in_text_written; }
        val err_dir_written: err[Fail] = sink.text(c.notes, dirs.data[d]);
        if (sel err_dir_written.err) { ret err_dir_written; }
        val err_newline_written: err[Fail] = sink.text(c.notes, "\n");
        if (sel err_newline_written.err) { ret err_newline_written; }
        d = d + 1;
    }
    ret err[Fail].ok{};
}

# the whole of the file at `path`, held until the search is released
fun load(c: *Finding, path: str) res[contract.Input, Fail] {
    val res_load: res[Loaded, Fail] = file.load(c.found.a, path);
    if (sel res_load.err) { ret res[contract.Input, Fail].err{res_load.err}; }
    var held:              Loaded    = res_load.ok;
    val err_loaded_pushed: err[Fail] = vectors.push[Loaded](?c.found.loaded, held);
    if (sel err_loaded_pushed.err) {
        val err_gone: err[Fail] = file.unload(?held);
        ret res[contract.Input, Fail].err{err_loaded_pushed.err};
    }
    ret res[contract.Input, Fail].ok{held.input};
}

# whether the candidate `in` is taken. a file the loader loads is taken when
# it is a shared library stating the link's architecture or none, a
# container holding such a member for the architecture, an archive whose
# members state none, or, where `scripts` says it may be, a linker script.
# any other file is taken unless it states another architecture, and one of
# no format mink reads is left to be read as a script or refused by the link
fun taken(c: *Finding, in: contract.Input, loaded: bool, scripts: bool) res[bool, Fail] {
    var probe:     contract.Input              = in;
    val res_known: res[*contract.Reader, Fail] = readers.sniff(?c.registry.readers, ?probe);
    if (sel res_known.err) {
        if (!loaded)                  { ret res[bool, Fail].ok{true}; }
        if (!scripts || !textual(in)) { ret res[bool, Fail].ok{false}; }
        ret res[bool, Fail].ok{reads_scripts(c)};
    }
    val res_probe_run: res[Model, Fail] = shell.run(res_known.ok, c.found.a, ?probe);
    if (sel res_probe_run.err) { ret res[bool, Fail].err{res_probe_run.err}; }
    var model:       Model           = res_probe_run.ok;
    val res_out:     res[bool, Fail] = judged(c, ?model, in.file, loaded);
    val err_release: err[Fail]       = contract.dnit(?model);
    if (sel res_out.err)     { ret res_out; }
    if (sel err_release.err) { ret res[bool, Fail].err{err_release.err}; }
    ret res_out;
}

# whether the model `m` of the candidate `file` is taken, as `taken` states
fun judged(c: *Finding, m: *Model, file: str, loaded: bool) res[bool, Fail] {
    val res_held: res[bool, Fail] = contract.is_container(m);
    if (sel res_held.err) { ret res_held; }
    if (res_held.ok)      { ret holds(c, m, file, loaded); }
    if (foreign(c, m))    { ret res[bool, Fail].ok{false}; }
    if (!loaded)          { ret res[bool, Fail].ok{true}; }
    val res_kind: res[*kind.Kind, Fail] = contract.kind(m);
    if (sel res_kind.err) { ret res[bool, Fail].err{res_kind.err}; }
    ret res[bool, Fail].ok{kind.has(res_kind.ok, kind.BINDS)};
}

# whether the container `m` named `file` is taken: an archive whose members
# state no architecture is, and one whose members state theirs is when the
# member for the link's architecture is
fun holds(c: *Finding, m: *Model, file: str, loaded: bool) res[bool, Fail] {
    var members:    Table[Member]   = table.init[Member](c.found.a);
    val err_listed: err[Fail]       = contract.members(m, file, ?members);
    var res_out:    res[bool, Fail] = res[bool, Fail].ok{true};
    if (sel err_listed.err) { res_out = res[bool, Fail].err{err_listed.err}; }
    var fit: Fitting = fitting(c, ?members);
    var ok:  bool    = sel res_out.ok;
    if (ok && fit.coded) {
        res_out = res[bool, Fail].ok{false};
        if (sel fit.pick.some) { res_out = taken(c, fit.pick.some, loaded, false); }
    }
    ret settled(res_out, table.dnit[Member](?members));
}

# the file at `path`, read and entered
fun named(c: *Finding, path: str, include: Include, searched: bool) err[Fail] {
    val res_load: res[contract.Input, Fail] = load(c, path);
    if (sel res_load.err) { ret err[Fail].err{res_load.err}; }
    ret enter(c, res_load.ok, include, searched);
}

# enter the bytes `in` of the file `in.file`, listed among the files the link
# read: as a source when a format reads them, with the file's absolute path,
# else as a GNU linker script where the system reads them, else as a source
# the link refuses
fun enter(c: *Finding, in: contract.Input, include: Include, searched: bool) err[Fail] {
    val res_path: res[str, Fail] = absolute(c, in.file);
    if (sel res_path.err) { ret err[Fail].err{res_path.err}; }
    val err_noted: err[Fail] = note_read(c, res_path.ok, searched);
    if (sel err_noted.err) { ret err_noted; }
    var probe:     contract.Input              = in;
    val res_known: res[*contract.Reader, Fail] = readers.sniff(?c.registry.readers, ?probe);
    if (sel res_known.err) {
        if (reads_scripts(c)) {
            var w: Walk = Walk{include: include, searched: searched};
            ret script(c, in, ?w);
        }
    }
    val s:                  Source    = Source.included{Included{input: in, include: include, searched: searched, path: res_path.ok}};
    val err_sources_pushed: err[Fail] = vectors.push[Source](c.sources, s);
    if (sel err_sources_pushed.err) { ret err[Fail].err{err_sources_pushed.err}; }
    ret err[Fail].ok{};
}

# list the file at the absolute path `path` among those the link read, by its
# identity, unless it is listed already
fun note_read(c: *Finding, path: str, searched: bool) err[Fail] {
    val res_identity: res[str, Fail] = input.identity(c.found.a, path);
    if (sel res_identity.err) { ret err[Fail].err{res_identity.err}; }
    val before:    usize               = intern.count(?c.entered);
    val res_known: res[Id[Name], Fail] = intern.intern_str(?c.entered, res_identity.ok);
    if (sel res_known.err || intern.count(?c.entered) == before) {
        free(c, res_identity.ok);
        if (sel res_known.err) { ret err[Fail].err{res_known.err}; }
        ret err[Fail].ok{};
    }
    val res_held: res[str, Fail] = kept_path(c, res_identity.ok);
    if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
    ret vectors.push[Read](?c.found.read, Read{path: res_held.ok, searched: searched});
}

# the absolute path of `path`: itself when absolute, else under the working
# directory, read once
fun absolute(c: *Finding, path: str) res[str, Fail] {
    if (is_abs(path)) { ret res[str, Fail].ok{path}; }
    if (c.cwd == nil) {
        val res_current_dir: res[OwnedString, env.EnvError] = env.current_dir(c.found.a);
        if (sel res_current_dir.err) {
            val e: env.EnvError = res_current_dir.err;
            if (sel e.alloc) { ret res[str, Fail].err{fail.refused(e.alloc)}; }
            ret res[str, Fail].err{fail.io("cannot read the working directory a relative path lies in")};
        }
        var held:     OwnedString    = res_current_dir.ok;
        val res_made: res[str, Fail] = own(c, str_join(c.found.a, held.data));
        val err_back: err[A.Error]   = owned_dnit(?held);
        if (sel res_made.err) { ret res_made; }
        if (sel err_back.err) { ret res[str, Fail].err{fail.refused(err_back.err)}; }
        c.cwd = res_made.ok;
    }
    ret own(c, str_join(c.found.a, c.cwd, "/", path));
}

# a span of a script's bytes
rec Span {
    at:  usize;
    len: usize;
}

# a token of a script
# ---
# end:   the script ends
# open:  an opening parenthesis
# close: a closing parenthesis
# word:  a name, a path or an entry
tag Token: u8 {
    end;
    open;
    close;
    word: Span;
}

# where a script is read
rec Lexer {
    data: *u8;
    len:  usize;
    at:   usize;
}

# a byte that separates tokens: white space, and a comma, which a list may
# separate its entries by
fun is_blank(b: u8) bool {
    ret b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == '\x0b' || b == '\x0c' || b == ',';
}

# whether `in` holds text: no control byte but white space
fun textual(in: contract.Input) bool {
    var i: usize = 0;
    for (i < in.len) {
        val b: u8 = in.data[i];
        if ((b < ' ' && !is_blank(b)) || b == '\x7f') { ret false; }
        i = i + 1;
    }
    ret true;
}

# the next token, past white space and comments
fun lex(l: *Lexer) res[Token, Fail] {
    for (l.at < l.len) {
        val b: u8 = l.data[l.at];
        if (is_blank(b)) {
            l.at = l.at + 1;
            cnt;
        }
        if (b != '/' || l.at + 1 >= l.len || l.data[l.at + 1] != '*') { brk; }
        var k:      usize = l.at + 2;
        var closed: bool  = false;
        for (k + 1 < l.len && !closed) {
            if (l.data[k] == '*' && l.data[k + 1] == '/') { closed = true; }
            or                                            { k = k + 1; }
        }
        if (!closed) { ret res[Token, Fail].err{fail.at_offset(fail.malformed("a linker script's comment is not closed"), l.at::u64)}; }
        l.at = k + 2;
    }
    if (l.at >= l.len) { ret res[Token, Fail].ok{Token.end{}}; }
    val b: u8 = l.data[l.at];
    if (b == '(') {
        l.at = l.at + 1;
        ret res[Token, Fail].ok{Token.open{}};
    }
    if (b == ')') {
        l.at = l.at + 1;
        ret res[Token, Fail].ok{Token.close{}};
    }
    val start: usize = l.at;
    for (l.at < l.len && !is_blank(l.data[l.at]) && l.data[l.at] != '(' && l.data[l.at] != ')') {
        l.at = l.at + 1;
    }
    ret res[Token, Fail].ok{Token.word{Span{at: start, len: l.at - start}}};
}

# whether the word `w` of `l` is `text`
fun spelled(l: *Lexer, w: Span, text: str) bool {
    if (str_len(text) != w.len) { ret false; }
    var i: usize = 0;
    for (i < w.len) {
        if (l.data[w.at + i] != text[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# read the GNU linker script `in`, as `w` states what becomes of what it names
fun script(c: *Finding, in: contract.Input, w: *Walk) err[Fail] {
    if (!textual(in))            { ret err[Fail].err{fail.in_file(fail.unsupported("the file is of no format mink reads, nor a GNU linker script"), in.file)}; }
    if (c.depth >= SCRIPT_DEPTH) { ret err[Fail].err{fail.in_file(fail.malformed("linker scripts name one another more deeply than mink follows"), in.file)}; }
    c.depth = c.depth + 1;
    var l:            Lexer     = Lexer{data: in.data, len: in.len};
    val err_commands: err[Fail] = commands(c, ?l, in.file, w);
    c.depth = c.depth - 1;
    if (sel err_commands.err) { ret err[Fail].err{fail.in_file(err_commands.err, in.file)}; }
    ret err[Fail].ok{};
}

# the commands of the script `file` read through `l`
fun commands(c: *Finding, l: *Lexer, file: str, walk: *Walk) err[Fail] {
    for {
        val res_lex: res[Token, Fail] = lex(l);
        if (sel res_lex.err) { ret err[Fail].err{res_lex.err}; }
        val tok: Token = res_lex.ok;
        if (sel tok.end) { ret err[Fail].ok{}; }
        or (sel tok.word) {
            val w: Span = tok.word;
            if (spelled(l, w, "GROUP") || spelled(l, w, "INPUT")) {
                val err_list: err[Fail] = list(c, l, file, walk);
                if (sel err_list.err) { ret err_list; }
                cnt;
            }
            if (spelled(l, w, "OUTPUT_FORMAT")) {
                val err_skipped: err[Fail] = skipped(l);
                if (sel err_skipped.err) { ret err_skipped; }
                cnt;
            }
            val res_name: res[str, Fail] = copied(c, l.data, w.at, w.len);
            if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
            ret err[Fail].err{fail.about(fail.at_offset(fail.unsupported("a linker script command mink does not read"), w.at::u64), res_name.ok)};
        }
        ret err[Fail].err{fail.at_offset(fail.malformed("a linker script holds a parenthesis outside a command"), l.at::u64)};
    }
    ret err[Fail].ok{};
}

# the opening parenthesis a command's arguments follow
fun opened(l: *Lexer) err[Fail] {
    val res_lex: res[Token, Fail] = lex(l);
    if (sel res_lex.err) { ret err[Fail].err{res_lex.err}; }
    val tok: Token = res_lex.ok;
    if (sel tok.open) { ret err[Fail].ok{}; }
    ret err[Fail].err{fail.at_offset(fail.malformed("a linker script command is not followed by its parenthesis"), l.at::u64)};
}

# the arguments of a command the link needs nothing of, words up to its
# closing parenthesis
fun skipped(l: *Lexer) err[Fail] {
    val err_opened: err[Fail] = opened(l);
    if (sel err_opened.err) { ret err_opened; }
    for {
        val res_lex: res[Token, Fail] = lex(l);
        if (sel res_lex.err) { ret err[Fail].err{res_lex.err}; }
        val tok: Token = res_lex.ok;
        if (sel tok.close) { ret err[Fail].ok{}; }
        or (sel tok.word)  { cnt; }
        or (sel tok.end)   { ret err[Fail].err{fail.at_offset(fail.malformed("a linker script command's parenthesis is not closed"), l.at::u64)}; }
        ret err[Fail].err{fail.at_offset(fail.malformed("a linker script command's arguments hold a parenthesis"), l.at::u64)};
    }
    ret err[Fail].ok{};
}

# the entries of a GROUP, an INPUT or an AS_NEEDED list, each taken as `walk`
# states, those of an AS_NEEDED list entering only when referenced
fun list(c: *Finding, l: *Lexer, file: str, walk: *Walk) err[Fail] {
    val err_opened: err[Fail] = opened(l);
    if (sel err_opened.err) { ret err_opened; }
    for {
        val res_lex: res[Token, Fail] = lex(l);
        if (sel res_lex.err) { ret err[Fail].err{res_lex.err}; }
        val tok: Token = res_lex.ok;
        if (sel tok.close) { ret err[Fail].ok{}; }
        or (sel tok.word) {
            val w: Span = tok.word;
            if (spelled(l, w, "AS_NEEDED")) {
                var needed: Walk = @walk;
                needed.include = Include.referenced{};
                val err_list: err[Fail] = list(c, l, file, ?needed);
                if (sel err_list.err) { ret err_list; }
                cnt;
            }
            val err_entry: err[Fail] = entry(c, l, w, file, walk);
            if (sel err_entry.err) { ret err[Fail].err{fail.at_offset(err_entry.err, w.at::u64)}; }
            cnt;
        }
        or (sel tok.end) { ret err[Fail].err{fail.at_offset(fail.malformed("a linker script list is not closed"), l.at::u64)}; }
        ret err[Fail].err{fail.at_offset(fail.malformed("a linker script list holds a parenthesis"), l.at::u64)};
    }
    ret err[Fail].ok{};
}

# the entry `w` of the script `file`: a library by name after -l, an
# absolute path, under the sysroot when the script lies under it, or a
# relative one, in the working directory or else a library directory. an
# entry of a script already known to bind is not looked for
fun entry(c: *Finding, l: *Lexer, w: Span, file: str, walk: *Walk) err[Fail] {
    if (sel walk.tally.some && walk.tally.some.binds) { ret err[Fail].ok{}; }
    val res_text: res[str, Fail] = copied(c, l.data, w.at, w.len);
    if (sel res_text.err) { ret err[Fail].err{res_text.err}; }
    val t: str = res_text.ok;
    if (w.len > 2 && t[0] == '-' && t[1] == 'l') { ret library(c, Wanted{form: Form.system{}, name: (?t[2])::str, include: walk.include, prefer: c.prefer}, walk.tally); }
    if (is_abs(t)) {
        val root: str = c.options.sysroot;
        if (root == nil || !str_starts_with(file, root)) { ret walked(c, t, walk); }
        val res_under: res[str, Fail] = own(c, str_join(c.found.a, root, t));
        if (sel res_under.err) { ret err[Fail].err{res_under.err}; }
        ret walked(c, res_under.ok, walk);
    }
    val res_here: res[bool, Fail] = is_file(t);
    if (sel res_here.err) { ret err[Fail].err{res_here.err}; }
    if (res_here.ok)      { ret walked(c, t, walk); }
    val err_listing: err[Fail] = listed(c);
    if (sel err_listing.err) { ret err_listing; }
    var d: usize = 0;
    for (d < vector.length[str](?c.libdirs)) {
        val dir:      str            = c.libdirs.data[d];
        val res_made: res[str, Fail] = own(c, str_join(c.found.a, dir, "/", t));
        d = d + 1;
        if (sel res_made.err) { ret err[Fail].err{res_made.err}; }
        val res_present: res[bool, Fail] = is_file(res_made.ok);
        if (sel res_present.err) { ret err[Fail].err{res_present.err}; }
        if (res_present.ok)      { ret walked(c, res_made.ok, walk); }
    }
    ret unfound(c, t, ?c.libdirs);
}

# the file at `path` a script names, entered or counted as `walk` states
fun walked(c: *Finding, path: str, walk: *Walk) err[Fail] {
    if (sel walk.tally.none) { ret named(c, path, walk.include, walk.searched); }
    val paths:    usize                     = vector.length[str](?c.found.paths);
    val files:    usize                     = vector.length[Loaded](?c.found.loaded);
    val res_load: res[contract.Input, Fail] = load(c, path);
    if (sel res_load.err) { ret err[Fail].err{res_load.err}; }
    val err_counted: err[Fail] = count(c, res_load.ok, walk.tally.some);
    if (sel err_counted.err) { ret err_counted; }
    ret rewind(c, paths, files);
}
