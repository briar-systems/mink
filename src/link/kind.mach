# the output kinds a link builds
#
# one row per kind, each naming the formats whose images can be of that kind.
# a link asks the row whether its format builds the kind and never compares a
# kind against a constant. which kinds a format's image writer builds yet is
# the writer's own row, so a kind can be in this table before any writer
# builds it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mink.catalog.format;
use mink.catalog.format.Format;
use mink.fail;
use mink.fail.Fail;

pub def Caps: u64;

# the output may keep strong undefined references, for a later link or the
# loader to bind
pub val UNRESOLVED: Caps = 0x1;
# the output starts at an entry symbol
pub val ENTERED: Caps = 0x2;
# every definition the output exports is reachable from outside it
pub val EXPORTS: Caps = 0x4;
# the output keeps every input section, for the link that takes it
pub val KEEPS: Caps = 0x8;
# a loader binds shared libraries into the output, so it may import
pub val IMPORTS: Caps = 0x10;
# the loader may place the output at any address, so an address it holds is
# one the loader relocates
pub val PIC: Caps = 0x20;
# a definition the output exports may be preempted by another image's
# definition of the same name, as a shared library's may
pub val INTERPOSED: Caps = 0x40;

# name:         the kind's spelling on the command line and in a diagnostic
# formats:      the formats whose images can be of this kind
# format_count: how many
# caps:         the capabilities the kind declares
pub rec Kind {
    name:         str;
    formats:      **Format;
    format_count: usize;
    caps:         Caps;
}

val RELOCATABLE_FORMATS: [4]*Format = [4]*Format{?format.ELF, ?format.COFF, ?format.MACHO, ?format.WASM};
val STATIC_FORMATS:      [4]*Format = [4]*Format{?format.ELF, ?format.COFF, ?format.MACHO, ?format.FLAT};
val DYNAMIC_FORMATS:     [3]*Format = [3]*Format{?format.ELF, ?format.COFF, ?format.MACHO};
val SHARED_FORMATS:      [4]*Format = [4]*Format{?format.ELF, ?format.COFF, ?format.MACHO, ?format.WASM};
val MODULE_FORMATS:      [2]*Format = [2]*Format{?format.WASM, ?format.SPIRV};

# an object a later link takes as input
pub val RELOCATABLE: Kind = Kind{name: "relocatable", formats: ?RELOCATABLE_FORMATS[0], format_count: 4, caps: UNRESOLVED | KEEPS};
# an executable at a fixed address that loads no library
pub val STATIC: Kind = Kind{name: "static", formats: ?STATIC_FORMATS[0], format_count: 4, caps: ENTERED};
# an executable at a fixed address whose loader binds libraries into it
pub val DYNAMIC: Kind = Kind{name: "dynamic", formats: ?DYNAMIC_FORMATS[0], format_count: 3, caps: ENTERED | IMPORTS};
# an executable its loader may place at any address
pub val PIE: Kind = Kind{name: "pie", formats: ?DYNAMIC_FORMATS[0], format_count: 3, caps: ENTERED | IMPORTS | PIC};
# a library loaded into another image at run time
pub val SHARED: Kind = Kind{name: "shared", formats: ?SHARED_FORMATS[0], format_count: 4, caps: UNRESOLVED | EXPORTS | IMPORTS | PIC | INTERPOSED};
# a module a runtime instantiates rather than a loader maps, as a wasm or a
# SPIR-V module is
pub val MODULE: Kind = Kind{name: "module", formats: ?MODULE_FORMATS[0], format_count: 2, caps: ENTERED};

val ROW_COUNT: usize            = 6;
val ROWS:      [ROW_COUNT]*Kind = [ROW_COUNT]*Kind{?RELOCATABLE, ?STATIC, ?DYNAMIC, ?PIE, ?SHARED, ?MODULE};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Kind {
    ret ROWS[index];
}

pub fun by_name(name: str) res[*Kind, Fail] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].name, name)) { ret res[*Kind, Fail].ok{ROWS[i]}; }
        i = i + 1;
    }
    ret res[*Kind, Fail].err{fail.unsupported("no output kind has this name")};
}

pub fun has(k: *Kind, c: Caps) bool {
    ret (k.caps & c) == c;
}

# whether an image of format `f` can be of kind `k`
pub fun builds(k: *Kind, f: *Format) bool {
    var i: usize = 0;
    for (i < k.format_count) {
        if (k.formats[i] == f) { ret true; }
        i = i + 1;
    }
    ret false;
}
