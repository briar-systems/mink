# the resolve phase: every reference binds to exactly one definition, and
# archives contribute the members the link needs
#
# resolution runs in three passes. loading notes what every input defines and
# refers to, in input order, and searches each archive for the names still
# undefined when the search reaches it, pulling a member only for a strong
# reference and repeating to a fixed point. grouping keeps one copy of every
# group signature by what its rule row declares. binding picks each name's
# winning definition: a strong one over a common one, a common one over a weak
# one, and any object's over a shared library's, and merges the commons of a
# name to the largest size and alignment any of them asks for. a weak
# reference nothing defines whose symbol names a fallback, a COFF weak
# external, binds to what its fallback binds to: its search row says whether
# the reference pulls an archive member that defines the name, and whether a
# fallback that is itself undefined is followed on to its own fallback, a
# cycle being refused. one that reaches no definition is an undefined
# reference of the input that declares it. a format's conventions reach the
# phase only as search capabilities and the hooks below, never as a question
# of which format it is.
#
# inputs made after resolution join through extend, which resolves only them
# against the answers already bound.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.memory;
use std.types.path.filename;

use mink.base.checked;
use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.format.contract;
use mink.format.contract.Model;
use mink.format.readers;
use mink.format.readers.Readers;
use mink.link.boundary;
use mink.link.boundary.Bound;
use mink.link.gather;
use mink.link.input;
use mink.link.input.Input;
use mink.link.input.Inputs;
use mink.model.directive;
use mink.model.group;
use mink.model.object;
use mink.model.object.Group;
use mink.model.object.Object;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.symbol;
use mink.model.symbol.Visibility;
use mink.model.target;
use mink.reloc.row;

pub def Caps: u64;

# every archive is searched again while a later input leaves a name
# undefined, as one group, rather than once where it stands
pub val REVISIT: Caps = 0x1;

# an archive member that defines a name as data is pulled to replace a common
# definition of it, as when a name is undefined, rather than the commons
# standing as the definition
pub val COMMON_PULL: Caps = 0x2;

# the points where a format's own resolution rules join the phase
# ---
# name:     the link name a symbol of an object resolves under, as a
#           versioned name maps to its base name and version
# library:  whether an input is a shared library, offering its definitions
#           through offer when it is
# imported: called once for every name the link imports, as a two-level
#           namespace records the library ordinal it binds through
# asked:    called before any archive is searched, and asks the link for each
#           name the format's image needs through ask
pub rec Hooks {
    name:     fun(*Context, *Object, *Symbol) res[Id[Name], Fail];
    library:  fun(*Context, Id[Input]) res[bool, Fail];
    imported: fun(*Context, Id[Import]) err[Fail];
    asked:    fun(*Context) err[Fail];
}

# the hooks of a format with no rules of its own: a symbol resolves under its
# own name, a shared library offers what its neutral object exports, an
# import records nothing more and the link asks for no name
pub val PLAIN: Hooks = Hooks{name: plain_name, library: shared, imported: no_record, asked: asks_none};

# how a format resolves a reference to a weak symbol nothing defines
# ---
# zero:     the reference has the value zero
# fallback: the reference resolves to what its fallback binds to, as resolution
#           binds it, and one that reaches no definition is refused
# unruled:  the format states no rule
pub tag Weak: u8 {
    zero;
    fallback;
    unruled;
}

# inputs:   the set to resolve, which archive members are appended to
# names:    the link's names
# readers:  the formats archive members are read through
# relocs:   the registry's index of relocation rows, which a member's
#           conversion reads
# arch:     the architecture a member's object is converted for
# kind:     the output kind, which says whether undefined references may stay
# search:   how the format's linker searches archives
# hooks:    the format's resolution rules
# bounds:   the names the format's link defines at places of its layout
# notes:    the caller's sink, where a refusal writes what its failure
#           cannot carry, such as the link's own names
# directed: the format's link exports by directive, not by visibility, so
#           an export directive leaves the visibility of its name as it is.
#           otherwise the name an object input's export directive is about
#           takes the default visibility, which shows it exported
# promised: the names synthesizers after resolution define, nil for none
# reached:  how many of the link's synthesizer stages have run, so a promise
#           of a stage at or past it excuses a reference to its name
pub rec In {
    inputs:   *Inputs;
    names:    *Interner;
    readers:  *Readers;
    relocs:   *row.Registry;
    arch:     *Arch;
    kind:     *Kind;
    search:   Caps;
    hooks:    *Hooks;
    bounds:   boundary.Bounds;
    notes:    *Sink;
    directed: bool;
    promised: *Table[Promise];
    reached:  usize;
}

# a name a synthesizer that runs after resolution defines, which resolution
# takes as defined until its stage has run
# ---
# prefix: the format's prefix of the name
# name:   the name after it
# stage:  the position of the synthesizer's stage among the link's stages
pub rec Promise {
    prefix: str;
    name:   str;
    stage:  usize;
}

# where a name is defined: the winning symbol of an input, and the visibility
# every symbol of the name merges to. `alias` marks the binding of a base name
# a default version's definition answers, which stands bound under its own
# versioned link name as well, so an image names it once, by that
pub rec Binding {
    name:       Id[Name];
    input:      Id[Input];
    symbol:     Id[Symbol];
    visibility: *Visibility;
    alias:      bool;
}

# a winning definition: its binding's id, and the binding, whose input and
# symbol define it
pub rec Won {
    id:      Id[Binding];
    binding: *Binding;
}

# a name a loader binds at run time, and the library that defines it
pub rec Import {
    name:    Id[Name];
    library: Id[Name];
}

# an archive member the link loaded: the archive's input and the member's
pub rec Member {
    archive: Id[Input];
    loaded:  Id[Input];
}

# a name whose winning definition is common, and the storage its commons
# merge to: the largest size and the largest alignment any of them asks for
pub rec Storage {
    name:    Id[Name];
    binding: Id[Binding];
    size:    u64;
    align:   u64;
}

# two inputs the link cannot take together over one name: a symbol both
# define strongly, or a group signature both hold where the rule refuses it
# ---
# why: the refusal, static
pub rec Clash {
    name:   Id[Name];
    first:  Id[Input];
    second: Id[Input];
    why:    str;
}

# an input that refers to a name
pub rec Reference {
    name:  Id[Name];
    input: Id[Input];
}

# bindings:  every defined name's winning definition, in the order names were
#            first seen
# imports:   every name a shared library defines for the link
# members:   the archive members loaded, in load order
# named:     each binding's index plus one, indexed by the link's name id,
#            zero for a name with none
# commons:   every name bound to a common definition, in binding order, and
#            the storage its commons merge to. a name later given a definition
#            by extend leaves it
# kept:      whether each group of each input is kept, input by input
# firsts:    the index in kept of each input's first group
# clashes:   what the link was refused for, holding both inputs
# undefined: every input that refers strongly to a name nothing defines, a
#            refusal unless the output kind keeps such references, grouped
#            by name in the order names were first referred to and each
#            name's inputs in input order
# libraries: whether each input is a shared library, indexed by input, an
#            input past its end being none
# links:     the link name of each symbol of each object input and shared
#            library, its id plus one, zero for a local symbol
# starts:    the index in links of each input's first symbol
# linked:    every name the link defines itself, at a place of its layout, in
#            the order names were first seen
# linking:   each linked name's index in linked plus one, indexed by the
#            link's name id, zero for a name with none
# lent:      every library input whose exports a shared library offers as
#            its own, as one it re-exports, each re-exporter's together
# lending:   where each input's run of lent starts and how many it holds,
#            indexed by input, an input past its end lending none
pub rec Resolved {
    bindings:  Table[Binding];
    imports:   Table[Import];
    members:   Table[Member];
    named:     Table[u32];
    commons:   Table[Storage];
    kept:      Table[bool];
    firsts:    Table[u32];
    clashes:   Table[Clash];
    undefined: Table[Reference];
    libraries: Table[bool];
    links:     Table[u32];
    starts:    Table[u32];
    linked:    Table[Linked];
    linking:   Table[u32];
    lent:      Table[Id[Input]];
    lending:   Table[Lending];
}

# a run of lent: where it starts and how many it holds
pub rec Lending {
    first: u32;
    count: u32;
}

# a name the link defines itself, and the row of the format's bound symbols
# that places it. `weak`: only weak references reach it, so it stays
# undefined where its place names an output section the image does not hold
pub rec Linked {
    name:  Id[Name];
    bound: *Bound;
    weak:  bool;
}

# what the phase knows of one name of the link
# ---
# seen:     the name is in the order
# defined:  some loaded input defines it
# common:   some loaded input defines it common
# regular:  some loaded input defines it, and not common
# wanted:   the name is queued for an archive search
# has:      a definition is bound, of rank `rank`
# unique:   the bound definition is one of many a process shares
# library:  the shared library of a bound offer
# referred: the last input that refers to it strongly, plus one
# strong:   some input refers to it strongly
# vis:      the merged visibility of every symbol of the name
# size:     the largest size of its commons
# align:    the largest alignment of its commons
# weak:     the first weak reference to it that names a fallback, plus one in
#           its input, and that reference's symbol
# fell:     the bound definition is its fallback's
# alias:    the name is the base name the bound default version answers
# spelled:  whether symbols reach it by a plain name or a versioned one, zero
#           before any does
# bound:    the link defines it, at the place of this row of the format's
#           bound symbols, while no input does
rec Slot {
    seen:     bool;
    defined:  bool;
    common:   bool;
    regular:  bool;
    wanted:   bool;
    has:      bool;
    rank:     u8;
    unique:   bool;
    input:    Id[Input];
    symbol:   Id[Symbol];
    library:  opt[Id[Name]];
    referred: u32;
    strong:   bool;
    vis:      *Visibility;
    size:     u64;
    align:    u64;
    weak:     u32;
    weak_sym: Id[Symbol];
    fell:     bool;
    alias:    bool;
    spelled:  u8;
    bound:    *Bound;
}

# how symbols reach a slot
val PLAIN_SPELLED:     u8 = 1;
val VERSIONED_SPELLED: u8 = 2;

# the byte that parts a name from its version in a link name
val AT: u8 = '@';

# the names a symbol of an object resolves under
# ---
# own:  its link name, which its relocations bind through
# bare: the base name a default version's definition also answers, none for
#       any other symbol
rec Keys {
    own:  Id[Name];
    bare: opt[Id[Name]];
}

# a key a member of an archive is found by
# ---
# key:  the key, in the archive's own keys
# next: the next of the key's members plus one, zero for its last
rec Defines {
    key:    Id[Name];
    member: Id[contract.Member];
    next:   u32;
}

# an archive of the link and the members each name finds in it
# ---
# keyed:   whether its keys are taken, from its index or by reading its
#          members when it has none
# keys:    every link name some member of it is found by
# defines: each key's members, in the order its index or its members name them
# heads:   each key's first in defines plus one, indexed by the key's id
rec Archive {
    input:   Id[Input];
    members: Table[contract.Member];
    loaded:  Table[bool];
    keyed:   bool;
    keys:    Interner;
    defines: Table[Defines];
    heads:   Table[u32];
}

# a copy of a group signature
rec Copy {
    input: Id[Input];
    group: Id[Group];
}

# what a hook reads, and the phase's own state
# ---
# in:  the phase's input
# out: the phase's output
pub rec Context {
    in:       *In;
    out:      *Resolved;
    slots:    Table[Slot];
    order:    Table[Id[Name]];
    pending:  Table[Id[Name]];
    offers:   Table[Import];
    archives: Table[Archive];
    refs:     Table[Reference];
    stays:    Table[bool];
    loaders:  Table[u32];
    indexed:  bool;
    states:   Table[u8];
    walked:   Table[u32];
}

# the rank of a definition: a shared library's lowest, then a weak
# definition, a common block and a strong definition. a weak definition does
# not displace a common one, as the System V ABI states under symbol binding.
# the link's own definition of a bound name ranks below them all, so any
# input's definition displaces it
val LINKED:  u8 = 0;
val OFFERED: u8 = 1;
val WEAK:    u8 = 2;
val COMMON:  u8 = 3;
val STRONG:  u8 = 4;

pub fun make(a: *A.Allocator) Resolved {
    ret Resolved{
        bindings:  table.make[Binding](a),
        imports:   table.make[Import](a),
        members:   table.make[Member](a),
        named:     table.make[u32](a),
        commons:   table.make[Storage](a),
        kept:      table.make[bool](a),
        firsts:    table.make[u32](a),
        clashes:   table.make[Clash](a),
        undefined: table.make[Reference](a),
        libraries: table.make[bool](a),
        links:     table.make[u32](a),
        starts:    table.make[u32](a),
        linked:    table.make[Linked](a),
        linking:   table.make[u32](a),
        lent:      table.make[Id[Input]](a),
        lending:   table.make[Lending](a),
    };
}

pub fun run(in: *In, out: *Resolved) err[Fail] {
    val a: *A.Allocator = in.inputs.a;
    var c: Context      = Context{
        in:       in,
        out:      out,
        slots:    table.make[Slot](a),
        order:    table.make[Id[Name]](a),
        pending:  table.make[Id[Name]](a),
        offers:   table.make[Import](a),
        archives: table.make[Archive](a),
        refs:     table.make[Reference](a),
        stays:    table.make[bool](a),
        loaders:  table.make[u32](a),
        states:   table.make[u8](a),
        walked:   table.make[u32](a),
    };
    val r: err[Fail] = resolve(?c);
    val d: err[Fail] = drop(?c);
    if (sel r.err) { ret r; }
    ret d;
}

# ask the archives for the member that defines `name`, as a reference would,
# without the link needing it: a name nothing defines stays undefined and
# refuses nothing. the asked hook calls it
pub fun ask(c: *Context, name: Id[Name]) err[Fail] {
    val s: res[*Slot, Fail] = slot_of(c, name);
    if (sel s.err)   { ret err[Fail].err{s.err}; }
    if (s.ok.wanted) { ret err[Fail].ok{}; }
    s.ok.wanted = true;
    val pushed: res[Id[Id[Name]], Fail] = table.push[Id[Name]](?c.pending, name);
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

# offer `name`, which the shared library `library` defines, to the link. the
# library hook calls it for each name a library input exports
pub fun offer(c: *Context, name: Id[Name], library: Id[Name]) err[Fail] {
    val s: res[*Slot, Fail] = slot_of(c, name);
    if (sel s.err) { ret err[Fail].err{s.err}; }
    s.ok.defined = true;
    val pushed: res[Id[Import], Fail] = table.push[Import](?c.offers, Import{name: name, library: library});
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

# whether the input `id` describes a shared library, offering each symbol it
# exports under the library's loader name when it does: under the names it
# resolves under, so a versioned reference finds its version and an
# unversioned one only the default version. a library offering one name at
# several versions offers each under its own versioned name
pub fun shared(c: *Context, id: Id[Input]) res[bool, Fail] {
    val o: *Object = input.object_of(c.in.inputs, id);
    if (sel o.library.none) { ret res[bool, Fail].ok{false}; }
    val lib: res[Id[Name], Fail] = loader(c.in.inputs, c.in.names, id);
    if (sel lib.err) { ret res[bool, Fail].err{lib.err}; }
    val own: err[Fail] = offer_all(c, id, lib.ok);
    if (sel own.err) { ret res[bool, Fail].err{own.err}; }
    val r: err[Fail] = reexports(c, id, lib.ok);
    if (sel r.err) { ret res[bool, Fail].err{r.err}; }
    ret res[bool, Fail].ok{true};
}

# offer each symbol the shared library `id` exports under the loader name
# `lib`
fun offer_all(c: *Context, id: Id[Input], lib: Id[Name]) err[Fail] {
    val o: *Object = input.object_of(c.in.inputs, id);
    var k: usize   = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val sym: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
        k = k + 1;
        if (!object.offers(sym)) { cnt; }
        val ks: res[Keys, Fail] = keys_of(c, o, sym);
        if (sel ks.err) { ret err[Fail].err{fail.in_indexed(ks.err, "symbol", (k - 1)::u64)}; }
        val e: err[Fail] = offer(c, ks.ok.own, lib);
        if (sel e.err) { ret e; }
        val bare: opt[Id[Name]] = ks.ok.bare;
        if (sel bare.none) { cnt; }
        val b: err[Fail] = offer(c, bare.some, lib);
        if (sel b.err) { ret b; }
    }
    ret err[Fail].ok{};
}

# offer the exports of every library the shared library `id` re-exports
# under its own loader name `lib`, as an image binds them through the library
# it loads, and those of the libraries they re-export in turn. a re-exported
# library is the library input whose loader name its dependency names, and
# one no input describes offers nothing. a re-export that leads back to a
# library on its way is refused
fun reexports(c: *Context, id: Id[Input], lib: Id[Name]) err[Fail] {
    val ix: err[Fail] = index_loaders(c);
    if (sel ix.err) { ret ix; }
    val states: usize = table.count[u8](?c.states);
    val n:      usize = input.count(c.in.inputs);
    if (n > states) {
        val g: res[Id[u8], Fail] = table.grow[u8](?c.states, n - states);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    table.clear[u32](?c.walked);
    val first: usize     = table.count[Id[Input]](?c.out.lent);
    val r:     err[Fail] = reexported(c, id, lib);
    var i:     usize     = 0;
    for (i < table.count[u32](?c.walked)) {
        table.items[u8](?c.states)[table.items[u32](?c.walked)[i]::usize] = 0;
        i                                                                 = i + 1;
    }
    if (sel r.err) {
        table.truncate[Id[Input]](?c.out.lent, first);
        ret r;
    }
    val count: usize = table.count[Id[Input]](?c.out.lent) - first;
    if (count == 0) { ret err[Fail].ok{}; }
    val runs: usize = table.count[Lending](?c.out.lending);
    if (id.index::usize >= runs) {
        val g: res[Id[Lending], Fail] = table.grow[Lending](?c.out.lending, id.index::usize + 1 - runs);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    table.items[Lending](?c.out.lending)[id.index::usize] = Lending{first: first::u32, count: count::u32};
    ret err[Fail].ok{};
}

# the libraries the library `id` re-exports, offered under `lib`, `id` on the
# way while they are
fun reexported(c: *Context, id: Id[Input], lib: Id[Name]) err[Fail] {
    val at: *u8 = ?table.items[u8](?c.states)[id.index::usize];
    if (@at == 1) { ret err[Fail].err{fail.in_file(fail.malformed("re-exported libraries form a cycle"), input.at(c.in.inputs, id).name)}; }
    if (@at == 2) { ret err[Fail].ok{}; }
    @at = 1;
    val w: res[Id[u32], Fail] = table.push[u32](?c.walked, id.index);
    if (sel w.err) { ret err[Fail].err{w.err}; }
    val o: *Object = input.object_of(c.in.inputs, id);
    var k: usize   = 0;
    for (k < table.count[object.Dependency](?o.libraries)) {
        val d: *object.Dependency = table.at[object.Dependency](?o.libraries, table.nth[object.Dependency](k));
        k = k + 1;
        if (!d.reexports) { cnt; }
        val named: opt[Id[Name]] = d.library.loader;
        if (sel named.none) { cnt; }
        val text: View          = object.name_of(o, named.some);
        val nm:   opt[Id[Name]] = intern.find(c.in.names, text.data, text.len);
        if (sel nm.none) { cnt; }
        val by: u32 = loader_input(c, nm.some);
        if (by == 0) { cnt; }
        val dep:   Id[Input] = table.nth[Input]((by - 1)::usize);
        val state: u8        = table.items[u8](?c.states)[dep.index::usize];
        if (state == 2) { cnt; }
        if (state == 0) {
            val l: res[Id[Id[Input]], Fail] = table.push[Id[Input]](?c.out.lent, dep);
            if (sel l.err) { ret err[Fail].err{l.err}; }
            val e: err[Fail] = offer_all(c, dep, lib);
            if (sel e.err) { ret err[Fail].err{fail.in_file(e.err, input.at(c.in.inputs, dep).name)}; }
        }
        val r: err[Fail] = reexported(c, dep, lib);
        if (sel r.err) { ret r; }
    }
    table.items[u8](?c.states)[id.index::usize] = 2;
    ret err[Fail].ok{};
}

# the library input whose loader name is `n`, plus one, zero for none
fun loader_input(c: *Context, n: Id[Name]) u32 {
    if (n.index::usize >= table.count[u32](?c.loaders)) { ret 0; }
    ret table.items[u32](?c.loaders)[n.index::usize];
}

# index every library input of the link by its loader name, the first of
# several that describe one library, once
fun index_loaders(c: *Context) err[Fail] {
    if (c.indexed) { ret err[Fail].ok{}; }
    val n: usize = input.count(c.in.inputs);
    var i: usize = 0;
    for (i < n) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(c.in.inputs, id);
        i = i + 1;
        if (o == nil || sel o.library.none) { cnt; }
        val lib: res[Id[Name], Fail] = loader(c.in.inputs, c.in.names, id);
        if (sel lib.err) { ret err[Fail].err{lib.err}; }
        val have: usize = table.count[u32](?c.loaders);
        if (lib.ok.index::usize >= have) {
            val g: res[Id[u32], Fail] = table.grow[u32](?c.loaders, lib.ok.index::usize + 1 - have);
            if (sel g.err) { ret err[Fail].err{g.err}; }
        }
        val slot: *u32 = ?table.items[u32](?c.loaders)[lib.ok.index::usize];
        if (@slot == 0) { @slot = i::u32; }
    }
    c.indexed = true;
    ret err[Fail].ok{};
}

# the name the loader knows the shared library `id` by: the one it states, or
# when it states none, as an ELF library without a DT_SONAME, its file's name
# when a search found it and the name it was given by otherwise
pub fun loader(inputs: *Inputs, names: *Interner, id: Id[Input]) res[Id[Name], Fail] {
    val o:     *Object             = input.object_of(inputs, id);
    var known: opt[object.Library] = opt[object.Library].none{};
    if (o != nil) { known = o.library; }
    if (sel known.none) {
        ret res[Id[Name], Fail].err{fail.in_file(fail.internal("an input that is no shared library has no loader name"), input.at(inputs, id).name)};
    }
    val stated: opt[Id[Name]] = known.some.loader;
    val e:      *Input        = input.at(inputs, id);
    if (sel stated.none && e.searched) { ret intern.intern_str(names, filename(e.name)); }
    if (sel stated.none)               { ret intern.intern_str(names, e.name); }
    val text: View = object.name_of(o, stated.some);
    ret intern.intern(names, text.data, text.len);
}

# the link's own definition of `name`, none when an input defines it or
# nothing does
pub fun linked_of(r: *Resolved, name: Id[Name]) opt[*Linked] {
    if (name.index::usize >= table.count[u32](?r.linking)) { ret opt[*Linked].none{}; }
    val at: u32 = table.items[u32](?r.linking)[name.index];
    if (at == 0) { ret opt[*Linked].none{}; }
    ret opt[*Linked].some{table.at[Linked](?r.linked, table.nth[Linked](at::usize - 1))};
}

# whether some name the link defines itself lies at an output section
pub fun sectioned(r: *Resolved) bool {
    var i: usize = 0;
    for (i < table.count[Linked](?r.linked)) {
        if (boundary.by_section(table.items[Linked](?r.linked)[i].bound.place)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# settle where each name the link defines at an output section lies: at its
# row's place when `landed` marks the section, by the section's name id. a
# name whose section the image does not hold is left undefined when only weak
# references reach it, as the gABI resolves an undefined weak reference. a
# strong reference to one is refused, the section named to `notes`, and the
# refusal leaves `r` as it was
pub fun unplaced(r: *Resolved, names: *Interner, landed: *Table[bool], notes: *Sink) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Linked](?r.linked)) {
        val ln: Linked = table.items[Linked](?r.linked)[i];
        i = i + 1;
        if (ln.weak || stands(names, landed, ln)) { cnt; }
        val sec: View      = boundary.section_of(ln.bound, intern.bytes_of(names, ln.name));
        val w:   err[Fail] = diag.note_named(Location{}, sec, "a bound symbol names this output section, which the image does not hold", notes);
        if (sel w.err) { ret w; }
        ret err[Fail].err{fail.in_record(fail.malformed("a bound symbol names an output section the image does not hold"), ln.bound.name)};
    }
    var kept: usize = 0;
    i = 0;
    for (i < table.count[Linked](?r.linked)) {
        val ln: Linked = table.items[Linked](?r.linked)[i];
        i = i + 1;
        if (!stands(names, landed, ln)) {
            table.items[u32](?r.linking)[ln.name.index] = 0;
            cnt;
        }
        table.items[Linked](?r.linked)[kept]        = ln;
        kept                                        = kept + 1;
        table.items[u32](?r.linking)[ln.name.index] = kept::u32;
    }
    table.truncate[Linked](?r.linked, kept);
    ret err[Fail].ok{};
}

# whether the place of `ln` stands: anywhere but at an output section, or
# at one `landed` marks
fun stands(names: *Interner, landed: *Table[bool], ln: Linked) bool {
    if (!boundary.by_section(ln.bound.place)) { ret true; }
    ret landed_at(names, landed, boundary.section_of(ln.bound, intern.bytes_of(names, ln.name)));
}

# whether `landed` marks the output section named `sec`
fun landed_at(names: *Interner, landed: *Table[bool], sec: View) bool {
    val nm: opt[Id[Name]] = intern.find(names, sec.data, sec.len);
    if (sel nm.none) { ret false; }
    val at: usize = nm.some.index::usize;
    ret at < table.count[bool](landed) && table.items[bool](landed)[at];
}

# the winning definition of `name`, none when nothing defines it in an object
pub fun bound(r: *Resolved, name: Id[Name]) opt[Won] {
    if (name.index::usize >= table.count[u32](?r.named)) { ret opt[Won].none{}; }
    val at: u32 = table.items[u32](?r.named)[name.index];
    if (at == 0) { ret opt[Won].none{}; }
    val id: Id[Binding] = Id[Binding]{index: at - 1};
    ret opt[Won].some{Won{id: id, binding: table.at[Binding](?r.bindings, id)}};
}

# the winning definition of what the symbol `s` of the input `in` names, none
# for a local symbol or a name nothing defines in an object
pub fun winning(r: *Resolved, in: Id[Input], s: Id[Symbol]) opt[Won] {
    val ln: opt[Id[Name]] = link_name(r, in, s);
    if (sel ln.none) { ret opt[Won].none{}; }
    ret bound(r, ln.some);
}

# whether the section `s` of `in`, an input the phase resolved, is kept: it
# is in no group or in a group whose copy was kept
pub fun keeps(r: *Resolved, in: Id[Input], s: *Section) bool {
    val g: opt[Id[Group]] = s.group;
    if (sel g.none) { ret true; }
    val first: u32 = table.items[u32](?r.firsts)[in.index];
    ret table.items[bool](?r.kept)[first + g.some.index];
}

# whether the input `in` is a shared library
pub fun library(r: *Resolved, in: Id[Input]) bool {
    if (in.index::usize >= table.count[bool](?r.libraries)) { ret false; }
    ret table.items[bool](?r.libraries)[in.index];
}

# the link name the symbol `s` of the object input `in` resolves under, none
# for a local symbol
pub fun link_name(r: *Resolved, in: Id[Input], s: Id[Symbol]) opt[Id[Name]] {
    if (in.index::usize >= table.count[u32](?r.starts)) { ret opt[Id[Name]].none{}; }
    val at: usize = table.items[u32](?r.starts)[in.index]::usize + s.index::usize;
    if (at >= table.count[u32](?r.links)) { ret opt[Id[Name]].none{}; }
    val n: u32 = table.items[u32](?r.links)[at];
    if (n == 0) { ret opt[Id[Name]].none{}; }
    ret opt[Id[Name]].some{Id[Name]{index: n - 1}};
}

pub fun release(r: *Resolved) err[Fail] {
    var first: err[Fail] = table.release[Binding](?r.bindings);
    first = fail.kept(first, table.release[Import](?r.imports));
    first = fail.kept(first, table.release[Member](?r.members));
    first = fail.kept(first, table.release[u32](?r.named));
    first = fail.kept(first, table.release[Storage](?r.commons));
    first = fail.kept(first, table.release[bool](?r.kept));
    first = fail.kept(first, table.release[u32](?r.firsts));
    first = fail.kept(first, table.release[Clash](?r.clashes));
    first = fail.kept(first, table.release[Reference](?r.undefined));
    first = fail.kept(first, table.release[bool](?r.libraries));
    first = fail.kept(first, table.release[u32](?r.links));
    first = fail.kept(first, table.release[u32](?r.starts));
    first = fail.kept(first, table.release[Linked](?r.linked));
    first = fail.kept(first, table.release[u32](?r.linking));
    first = fail.kept(first, table.release[Id[Input]](?r.lent));
    ret fail.kept(first, table.release[Lending](?r.lending));
}

# the library inputs whose exports the shared library `id` offers as its own,
# the libraries it re-exports and theirs in turn
pub fun lent_of(r: *Resolved, id: Id[Input]) Lending {
    if (id.index::usize >= table.count[Lending](?r.lending)) { ret Lending{}; }
    ret table.items[Lending](?r.lending)[id.index::usize];
}

fun resolve(c: *Context) err[Fail] {
    val l: err[Fail] = load(c);
    if (sel l.err) { ret l; }
    val g: err[Fail] = choose_groups(c);
    if (sel g.err) { ret g; }
    val b: err[Fail] = bind(c);
    if (sel b.err) { ret b; }
    ret finish(c);
}

fun drop(c: *Context) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[Archive](?c.archives)) {
        val arc: *Archive = table.at[Archive](?c.archives, table.nth[Archive](i));
        first = fail.kept(first, table.release[contract.Member](?arc.members));
        first = fail.kept(first, table.release[bool](?arc.loaded));
        first = fail.kept(first, intern.release(?arc.keys));
        first = fail.kept(first, table.release[Defines](?arc.defines));
        first = fail.kept(first, table.release[u32](?arc.heads));
        i     = i + 1;
    }
    first = fail.kept(first, table.release[Archive](?c.archives));
    first = fail.kept(first, table.release[Slot](?c.slots));
    first = fail.kept(first, table.release[Id[Name]](?c.order));
    first = fail.kept(first, table.release[Id[Name]](?c.pending));
    first = fail.kept(first, table.release[Import](?c.offers));
    first = fail.kept(first, table.release[Reference](?c.refs));
    first = fail.kept(first, table.release[bool](?c.stays));
    first = fail.kept(first, table.release[u32](?c.loaders));
    first = fail.kept(first, table.release[u8](?c.states));
    ret fail.kept(first, table.release[u32](?c.walked));
}

# the slot of `name`, the table growing to hold it and the order taking it
# when it is new. the slot stays where it is until the next slot is made
fun slot_of(c: *Context, name: Id[Name]) res[*Slot, Fail] {
    val have: usize = table.count[Slot](?c.slots);
    if (name.index::usize >= have) {
        val grown: res[Id[Slot], Fail] = table.grow[Slot](?c.slots, name.index::usize + 1 - have);
        if (sel grown.err) { ret res[*Slot, Fail].err{grown.err}; }
    }
    val s: *Slot = table.at[Slot](?c.slots, table.nth[Slot](name.index::usize));
    if (!s.seen) {
        val pushed: res[Id[Id[Name]], Fail] = table.push[Id[Name]](?c.order, name);
        if (sel pushed.err) { ret res[*Slot, Fail].err{pushed.err}; }
        s.seen = true;
    }
    ret res[*Slot, Fail].ok{s};
}

fun slot_at(c: *Context, name: Id[Name]) *Slot {
    ret table.at[Slot](?c.slots, table.nth[Slot](name.index::usize));
}

fun load(c: *Context) err[Fail] {
    val asked: err[Fail] = c.in.hooks.asked(c);
    if (sel asked.err) { ret asked; }
    val revisit: bool  = (c.in.search & REVISIT) != 0;
    val given:   usize = input.count(c.in.inputs);
    var i:       usize = 0;
    for (i < given) {
        val id: Id[Input] = table.nth[Input](i);
        val e:  *Input    = input.at(c.in.inputs, id);
        if (sel e.content.container) {
            val arc: res[Id[Archive], Fail] = enlist(c, id);
            if (sel arc.err) { ret err[Fail].err{arc.err}; }
            if (!revisit) {
                val s: res[bool, Fail] = search(c, arc.ok);
                if (sel s.err) { ret err[Fail].err{s.err}; }
            }
        }
        or {
            val n: err[Fail] = note(c, id);
            if (sel n.err) { ret n; }
        }
        i = i + 1;
    }
    if (!revisit) { ret err[Fail].ok{}; }
    for {
        var progress: bool  = false;
        var k:        usize = 0;
        for (k < table.count[Archive](?c.archives)) {
            val s: res[bool, Fail] = search(c, table.nth[Archive](k));
            if (sel s.err) { ret err[Fail].err{s.err}; }
            if (s.ok)      { progress = true; }
            k = k + 1;
        }
        if (!progress) { brk; }
    }
    ret err[Fail].ok{};
}

# note what the input `id` defines and refers to
fun note(c: *Context, id: Id[Input]) err[Fail] {
    val have: usize = table.count[bool](?c.out.libraries);
    if (id.index::usize >= have) {
        val grown: res[Id[bool], Fail] = table.grow[bool](?c.out.libraries, id.index::usize + 1 - have);
        if (sel grown.err) { ret err[Fail].err{grown.err}; }
    }
    val name: str             = input.at(c.in.inputs, id).name;
    val lib:  res[bool, Fail] = c.in.hooks.library(c, id);
    if (sel lib.err) { ret err[Fail].err{fail.in_file(lib.err, name)}; }
    table.items[bool](?c.out.libraries)[id.index] = lib.ok;
    if (lib.ok) { ret err[Fail].ok{}; }
    val o: *Object = input.object_of(c.in.inputs, id);
    var k: usize   = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val sym: *Symbol   = object.symbol_at(o, table.nth[Symbol](k));
        val e:   err[Fail] = note_symbol(c, o, sym);
        if (sel e.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(e.err, "symbol", k::u64), name)}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

fun note_symbol(c: *Context, o: *Object, sym: *Symbol) err[Fail] {
    if (!symbol.binds(sym.binding, symbol.EXTERNAL)) { ret err[Fail].ok{}; }
    val k: res[Keys, Fail] = keys_of(c, o, sym);
    if (sel k.err) { ret err[Fail].err{k.err}; }
    val n: err[Fail] = note_key(c, sym, k.ok.own, sel sym.version.some);
    if (sel n.err) { ret n; }
    val bare: opt[Id[Name]] = k.ok.bare;
    if (sel bare.some) { ret note_key(c, sym, bare.some, false); }
    ret err[Fail].ok{};
}

# note that `sym` defines or refers to `name`
fun note_key(c: *Context, sym: *Symbol, name: Id[Name], versioned: bool) err[Fail] {
    val s: res[*Slot, Fail] = keyed(c, name, versioned);
    if (sel s.err) { ret err[Fail].err{s.err}; }
    if (!sel sym.def.undefined) {
        s.ok.defined = true;
        if (!sel sym.def.common) {
            s.ok.regular = true;
            ret err[Fail].ok{};
        }
        s.ok.common = true;
        if ((c.in.search & COMMON_PULL) == 0 || s.ok.wanted) { ret err[Fail].ok{}; }
        s.ok.wanted = true;
        val queued: res[Id[Id[Name]], Fail] = table.push[Id[Name]](?c.pending, name);
        if (sel queued.err) { ret err[Fail].err{queued.err}; }
        ret err[Fail].ok{};
    }
    if ((symbol.binds(sym.binding, symbol.WEAK) && !pulls(sym)) || s.ok.wanted) { ret err[Fail].ok{}; }
    s.ok.wanted = true;
    val pushed: res[Id[Id[Name]], Fail] = table.push[Id[Name]](?c.pending, name);
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

# the names `sym` of `o` resolves under. a symbol that states a version
# resolves under its name and version, spelled `name@version` as GNU tools
# spell a versioned reference, and a default version's definition answers its
# base name too, as an unversioned reference binds to the default version. a
# name or version holding `@` would spell another key, a common block has no
# version, and only a definition states a default one, so each of those is
# refused
fun keys_of(c: *Context, o: *Object, sym: *Symbol) res[Keys, Fail] {
    val base: res[Id[Name], Fail] = c.in.hooks.name(c, o, sym);
    if (sel base.err) { ret res[Keys, Fail].err{base.err}; }
    val v: opt[object.Version] = sym.version;
    if (sel v.none)         { ret res[Keys, Fail].ok{Keys{own: base.ok, bare: opt[Id[Name]].none{}}}; }
    if (sel sym.def.common) { ret res[Keys, Fail].err{fail.unsupported("a common symbol states a version")}; }
    val dflt: bool = v.some.default;
    if (dflt && sel sym.def.undefined) { ret res[Keys, Fail].err{fail.malformed("a reference names a default version, which only a definition states")}; }
    var out: Sink                = sink.make(c.in.inputs.a, LITTLE);
    val own: res[Id[Name], Fail] = versioned(c, ?out, base.ok, object.name_of(o, v.some.name));
    val rel: err[Fail]           = sink.release(?out);
    if (sel own.err) { ret res[Keys, Fail].err{own.err}; }
    if (sel rel.err) { ret res[Keys, Fail].err{rel.err}; }
    var bare: opt[Id[Name]] = opt[Id[Name]].none{};
    if (dflt) { bare = opt[Id[Name]].some{base.ok}; }
    ret res[Keys, Fail].ok{Keys{own: own.ok, bare: bare}};
}

# the link name of `base` at `version`, spelled through `out`
fun versioned(c: *Context, out: *Sink, base: Id[Name], version: View) res[Id[Name], Fail] {
    val b: View = intern.bytes_of(c.in.names, base);
    if (version.len == 0 || holds_at(b) || holds_at(version)) {
        ret res[Id[Name], Fail].err{fail.unsupported("a versioned symbol's name or version holds `@` or its version is empty, which spells no link name")};
    }
    val wb: err[Fail] = sink.bytes(out, b.data, b.len);
    if (sel wb.err) { ret res[Id[Name], Fail].err{wb.err}; }
    val wa: err[Fail] = sink.u8(out, AT);
    if (sel wa.err) { ret res[Id[Name], Fail].err{wa.err}; }
    val wv: err[Fail] = sink.bytes(out, version.data, version.len);
    if (sel wv.err) { ret res[Id[Name], Fail].err{wv.err}; }
    ret intern.intern(c.in.names, sink.data(out), sink.len(out));
}

# the base name of the link name `name`, which spells it without a version,
# `name` itself for a link name of none, and none when the link holds no
# such base name
pub fun unversioned(names: *Interner, name: Id[Name]) opt[Id[Name]] {
    val v: View  = intern.bytes_of(names, name);
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == AT) { ret intern.find(names, v.data, i); }
        i = i + 1;
    }
    ret opt[Id[Name]].some{name};
}

fun holds_at(v: View) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == AT) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the slot of `name`, which symbols reach by a versioned link name when
# `versioned` and by a plain name otherwise. a plain name that spells a
# versioned one's link name would bind both as one and is refused
fun keyed(c: *Context, name: Id[Name], versioned: bool) res[*Slot, Fail] {
    val got: res[*Slot, Fail] = slot_of(c, name);
    if (sel got.err) { ret got; }
    var want: u8 = PLAIN_SPELLED;
    if (versioned) { want = VERSIONED_SPELLED; }
    val s: *Slot = got.ok;
    if (s.spelled == 0)    { s.spelled = want; }
    or (s.spelled != want) { ret res[*Slot, Fail].err{fail.malformed("a plain symbol's name spells a versioned symbol's link name")}; }
    ret got;
}

# whether the weak reference `sym` pulls an archive member that defines its
# name, as its fallback's search says
fun pulls(sym: *Symbol) bool {
    val f: opt[object.Fallback] = sym.fallback;
    if (sel f.some) { ret symbol.looks(f.some.search, symbol.PULLS); }
    ret false;
}

# take the container `id` into the archives the phase searches
fun enlist(c: *Context, id: Id[Input]) res[Id[Archive], Fail] {
    val a:      *A.Allocator           = c.in.inputs.a;
    val pushed: res[Id[Archive], Fail] = table.push[Archive](?c.archives, Archive{
        input:   id,
        members: table.make[contract.Member](a),
        loaded:  table.make[bool](a),
        keys:    intern.make(a),
        defines: table.make[Defines](a),
        heads:   table.make[u32](a),
    });
    if (sel pushed.err) { ret pushed; }
    val e: *Input = input.at(c.in.inputs, id);
    if (sel e.model.none) { ret res[Id[Archive], Fail].err{fail.in_file(fail.internal("a container has no model"), e.name)}; }
    val arc:    *Archive  = table.at[Archive](?c.archives, pushed.ok);
    val listed: err[Fail] = contract.members(table.at[Model](?c.in.inputs.models, e.model.some), e.name, ?arc.members);
    if (sel listed.err) { ret res[Id[Archive], Fail].err{listed.err}; }
    val grown: res[Id[bool], Fail] = table.grow[bool](?arc.loaded, table.count[contract.Member](?arc.members));
    if (sel grown.err) { ret res[Id[Archive], Fail].err{grown.err}; }
    ret pushed;
}

# pull from the archive `aid` every member that defines a name some loaded
# input refers to strongly and none defines, until none is left to pull. where
# the format pulls for commons, a name only commons define pulls the members
# that define it as data. true when it pulled any
fun search(c: *Context, aid: Id[Archive]) res[bool, Fail] {
    var found: Table[Id[contract.Member]] = table.make[Id[contract.Member]](c.in.inputs.a);
    val r:     res[bool, Fail]            = searched(c, aid, ?found);
    val rel:   err[Fail]                  = table.release[Id[contract.Member]](?found);
    if (sel r.err)   { ret r; }
    if (sel rel.err) { ret res[bool, Fail].err{rel.err}; }
    ret r;
}

fun searched(c: *Context, aid: Id[Archive], found: *Table[Id[contract.Member]]) res[bool, Fail] {
    var any: bool = false;
    for {
        var progress: bool  = false;
        var i:        usize = 0;
        for (i < table.count[Id[Name]](?c.pending)) {
            val name: Id[Name] = table.items[Id[Name]](?c.pending)[i];
            i = i + 1;
            val s: *Slot = slot_at(c, name);
            if (!wants(c, s)) { cnt; }
            val tentative: bool = s.defined;
            table.clear[Id[contract.Member]](found);
            val f: err[Fail] = find(c, aid, name, found);
            if (sel f.err) { ret res[bool, Fail].err{f.err}; }
            var k: usize = 0;
            for (k < table.count[Id[contract.Member]](found)) {
                val m:   Id[contract.Member] = table.items[Id[contract.Member]](found)[k];
                val arc: *Archive            = table.at[Archive](?c.archives, aid);
                if (m.index::usize >= table.count[bool](?arc.loaded)) {
                    val file: str = input.at(c.in.inputs, arc.input).name;
                    ret res[bool, Fail].err{fail.in_file(fail.malformed("the symbol table names a member the archive does not hold"), file)};
                }
                if (!table.items[bool](?arc.loaded)[m.index]) {
                    if (tentative) {
                        val d: res[bool, Fail] = defines_data(c, aid, m, name);
                        if (sel d.err) { ret res[bool, Fail].err{d.err}; }
                        if (!d.ok) {
                            k = k + 1;
                            cnt;
                        }
                    }
                    val p: err[Fail] = pull(c, aid, m);
                    if (sel p.err) { ret res[bool, Fail].err{p.err}; }
                    progress = true;
                    brk;
                }
                k = k + 1;
            }
        }
        if (!progress) { brk; }
        any = true;
    }
    ret res[bool, Fail].ok{any};
}

# append to `out` the members of the archive `aid` that define `name`, its
# keys taken the first time it is searched
fun find(c: *Context, aid: Id[Archive], name: Id[Name], out: *Table[Id[contract.Member]]) err[Fail] {
    if (!table.at[Archive](?c.archives, aid).keyed) {
        val k: err[Fail] = take_keys(c, aid);
        if (sel k.err) { ret k; }
    }
    val arc:  *Archive      = table.at[Archive](?c.archives, aid);
    val text: View          = intern.bytes_of(c.in.names, name);
    val key:  opt[Id[Name]] = intern.find(?arc.keys, text.data, text.len);
    if (sel key.none) { ret err[Fail].ok{}; }
    var at: u32 = table.items[u32](?arc.heads)[key.some.index];
    for (at != 0) {
        val d:      *Defines                           = table.at[Defines](?arc.defines, table.nth[Defines](at::usize - 1));
        val pushed: res[Id[Id[contract.Member]], Fail] = table.push[Id[contract.Member]](out, d.member);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        at = d.next;
    }
    ret err[Fail].ok{};
}

# take the keys of the archive `aid` from its index, or by reading its members
# when it has none, and chain each key's members in the order they came. a
# refusal leaves the archive unkeyed
fun take_keys(c: *Context, aid: Id[Archive]) err[Fail] {
    val e: *Input = input.at(c.in.inputs, table.at[Archive](?c.archives, aid).input);
    if (sel e.model.none) { ret err[Fail].err{fail.in_file(fail.internal("a container has no model"), e.name)}; }
    val model:   *Model                = table.at[Model](?c.in.inputs.models, e.model.some);
    var entries: Table[contract.Entry] = table.make[contract.Entry](c.in.inputs.a);
    var spelled: Table[u8]             = table.make[u8](c.in.inputs.a);
    val r:       err[Fail]             = keys_from(c, aid, model, e.name, ?entries, ?spelled);
    val re:      err[Fail]             = table.release[contract.Entry](?entries);
    val rs:      err[Fail]             = table.release[u8](?spelled);
    val kept:    err[Fail]             = fail.kept(fail.kept(r, re), rs);
    val arc:     *Archive              = table.at[Archive](?c.archives, aid);
    if (sel kept.ok) {
        val chained: err[Fail] = chain(arc);
        if (sel chained.ok) { ret chained; }
        ret fail.kept(chained, unkey(arc));
    }
    ret fail.kept(kept, unkey(arc));
}

# drop the keys of `arc`, as before they were taken
fun unkey(arc: *Archive) err[Fail] {
    table.clear[Defines](?arc.defines);
    table.clear[u32](?arc.heads);
    ret intern.truncate(?arc.keys, 0);
}

fun keys_from(c: *Context, aid: Id[Archive], model: *Model, file: str, entries: *Table[contract.Entry], spelled: *Table[u8]) err[Fail] {
    val listed: res[bool, Fail] = contract.indexed(model, file, entries);
    if (sel listed.err) { ret err[Fail].err{listed.err}; }
    if (listed.ok)      { ret key_entries(c, aid, entries, spelled); }
    ret scan(c, aid);
}

# key each entry of the index of the archive `aid` under the link names a
# reference finds it by. an entry spelling a default version `name@@version`
# answers `name@version` and `name`, as a reference with or without the
# version binds to the default version, and any other entry answers its own
# spelling. `spelled` holds a respelled name
fun key_entries(c: *Context, aid: Id[Archive], entries: *Table[contract.Entry], spelled: *Table[u8]) err[Fail] {
    var k: usize = 0;
    for (k < table.count[contract.Entry](entries)) {
        val en:  *contract.Entry = table.at[contract.Entry](entries, table.nth[contract.Entry](k));
        val n:   Bytes           = en.name;
        var cut: usize           = 0;
        for (cut < n.len && n.data[cut] != AT) { cut = cut + 1; }
        if (cut + 1 < n.len && n.data[cut + 1] == AT) {
            table.truncate[u8](spelled, 0);
            val wb: res[Id[u8], Fail] = table.extend[u8](spelled, n.data, cut + 1);
            if (sel wb.err) { ret err[Fail].err{wb.err}; }
            val wv: res[Id[u8], Fail] = table.extend[u8](spelled, ?n.data[cut + 2], n.len - cut - 2);
            if (sel wv.err) { ret err[Fail].err{wv.err}; }
            val dv: err[Fail] = define(c, aid, table.items[u8](spelled), table.count[u8](spelled), en.member);
            if (sel dv.err) { ret dv; }
            val db: err[Fail] = define(c, aid, n.data, cut, en.member);
            if (sel db.err) { ret db; }
        }
        or {
            val d: err[Fail] = define(c, aid, n.data, n.len, en.member);
            if (sel d.err) { ret d; }
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# link each key of `arc` to its members, first to last
fun chain(arc: *Archive) err[Fail] {
    val grown: res[Id[u32], Fail] = table.grow[u32](?arc.heads, intern.count(?arc.keys));
    if (sel grown.err) { ret err[Fail].err{grown.err}; }
    val heads: *u32  = table.items[u32](?arc.heads);
    var i:     usize = table.count[Defines](?arc.defines);
    for (i > 0) {
        i = i - 1;
        val d: *Defines = table.at[Defines](?arc.defines, table.nth[Defines](i));
        d.next             = heads[d.key.index];
        heads[d.key.index] = (i + 1)::u32;
    }
    arc.keyed = true;
    ret err[Fail].ok{};
}

# read every member of the archive `aid` once and note the names it defines
fun scan(c: *Context, aid: Id[Archive]) err[Fail] {
    val file:  str   = input.at(c.in.inputs, table.at[Archive](?c.archives, aid).input).name;
    val count: usize = table.count[contract.Member](?table.at[Archive](?c.archives, aid).members);
    var i:     usize = 0;
    for (i < count) {
        val e: err[Fail] = scan_member(c, aid, table.nth[contract.Member](i));
        if (sel e.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(e.err, "member", i::u64), file)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun scan_member(c: *Context, aid: Id[Archive], m: Id[contract.Member]) err[Fail] {
    ret visit(c, aid, m, nil, defined_by);
}

# what a member is read for: a name and whether the member defines it as data
rec Probe {
    name:  Id[Name];
    found: bool;
}

# whether the member `m` of the archive `aid` defines `name` as data, which
# only reading the member says
fun defines_data(c: *Context, aid: Id[Archive], m: Id[contract.Member], name: Id[Name]) res[bool, Fail] {
    var probe: Probe     = Probe{name: name};
    val e:     err[Fail] = visit(c, aid, m, (?probe)::ptr, probe_data);
    if (sel e.err) { ret res[bool, Fail].err{e.err}; }
    ret res[bool, Fail].ok{probe.found};
}

# the member `m` of the archive `aid`, read as `model`, converted into `o`
# and handed to `each`, refused when it holds other files
fun member_in(c: *Context, aid: Id[Archive], m: Id[contract.Member], contains: bool, model: *Model, o: *Object, probe: ptr, each: fun(*Context, Id[Archive], Id[contract.Member], *Object, ptr) err[Fail]) err[Fail] {
    if (contains) { ret err[Fail].err{fail.unsupported("an archive member holds other files")}; }
    val conv: err[Fail] = contract.to_neutral(model, c.in.relocs, o);
    if (sel conv.err) { ret conv; }
    ret each(c, aid, m, o, probe);
}

# read the member `m` of the archive `aid` into a neutral object and hand it
# to `each`, releasing both after
fun visit(c: *Context, aid: Id[Archive], m: Id[contract.Member], probe: ptr, each: fun(*Context, Id[Archive], Id[contract.Member], *Object, ptr) err[Fail]) err[Fail] {
    var bytes: contract.Input   = table.at[contract.Member](?table.at[Archive](?c.archives, aid).members, m).input;
    val read:  res[Model, Fail] = readers.read(c.in.readers, c.in.inputs.a, ?bytes);
    if (sel read.err) { ret err[Fail].err{read.err}; }
    var model: Model           = read.ok;
    var o:     Object          = object.make(c.in.inputs.a, c.in.arch, nil);
    var r:     err[Fail]       = err[Fail].ok{};
    val held:  res[bool, Fail] = contract.is_container(?model);
    if (sel held.err) { r = err[Fail].err{held.err}; }
    if (sel held.ok)  { r = member_in(c, aid, m, held.ok, ?model, ?o, probe, each); }
    r = fail.kept(r, object.release(?o));
    ret fail.kept(r, contract.release(?model));
}

fun defined_by(c: *Context, aid: Id[Archive], m: Id[contract.Member], o: *Object, probe: ptr) err[Fail] {
    var k: usize = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val sym: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
        if (symbol.binds(sym.binding, symbol.EXTERNAL) && !(sel sym.def.undefined)) {
            val ks: res[Keys, Fail] = keys_of(c, o, sym);
            if (sel ks.err) { ret err[Fail].err{fail.in_indexed(ks.err, "symbol", k::u64)}; }
            val d: err[Fail] = define_name(c, aid, ks.ok.own, m);
            if (sel d.err) { ret d; }
            val bare: opt[Id[Name]] = ks.ok.bare;
            if (sel bare.some) {
                val db: err[Fail] = define_name(c, aid, bare.some, m);
                if (sel db.err) { ret db; }
            }
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# note that the member `m` of the archive `aid` defines the link name `name`
fun define_name(c: *Context, aid: Id[Archive], name: Id[Name], m: Id[contract.Member]) err[Fail] {
    val text: View = intern.bytes_of(c.in.names, name);
    ret define(c, aid, text.data, text.len, m);
}

# note that the member `m` of the archive `aid` is found by the `n` bytes at `p`
fun define(c: *Context, aid: Id[Archive], p: *u8, n: usize, m: Id[contract.Member]) err[Fail] {
    val arc: *Archive            = table.at[Archive](?c.archives, aid);
    val key: res[Id[Name], Fail] = intern.intern(?arc.keys, p, n);
    if (sel key.err) { ret err[Fail].err{key.err}; }
    val pushed: res[Id[Defines], Fail] = table.push[Defines](?arc.defines, Defines{key: key.ok, member: m});
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

fun probe_data(c: *Context, aid: Id[Archive], m: Id[contract.Member], o: *Object, probe: ptr) err[Fail] {
    val want: *Probe = probe::*Probe;
    var k:    usize  = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val sym: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
        if (symbol.binds(sym.binding, symbol.EXTERNAL) && !(sel sym.def.undefined) && !(sel sym.def.common) && !(sel sym.def.library)) {
            val ks: res[Keys, Fail] = keys_of(c, o, sym);
            if (sel ks.err)                         { ret err[Fail].err{fail.in_indexed(ks.err, "symbol", k::u64)}; }
            if (ks.ok.own.index == want.name.index) { want.found = true; }
            val bare: opt[Id[Name]] = ks.ok.bare;
            if (sel bare.some) {
                if (bare.some.index == want.name.index) { want.found = true; }
            }
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# whether a search still has a member to find for a name: nothing defines it,
# or only commons do and the format pulls a data definition over them
fun wants(c: *Context, s: *Slot) bool {
    if (!s.defined) { ret true; }
    ret s.common && !s.regular && (c.in.search & COMMON_PULL) != 0;
}

# load the member `m` of the archive `aid` as an input of the link
fun pull(c: *Context, aid: Id[Archive], m: Id[contract.Member]) err[Fail] {
    val arc: *Archive = table.at[Archive](?c.archives, aid);
    table.items[bool](?arc.loaded)[m.index] = true;
    val from:    Id[Input]      = arc.input;
    val src:     contract.Input = table.at[contract.Member](?arc.members, m).input;
    val held:    *Input         = input.at(c.in.inputs, from);
    val include: input.Include  = held.include;
    val found:   bool           = held.searched;
    val before:  usize          = input.count(c.in.inputs);
    val l:       err[Fail]      = gather.load(c.in.readers, c.in.relocs, c.in.arch, src, c.in.inputs);
    if (sel l.err) { ret err[Fail].err{fail.in_indexed(l.err, "member", m.index::u64)}; }
    var i: usize = before;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val e:  *Input    = input.at(c.in.inputs, id);
        if (sel e.content.container) {
            ret err[Fail].err{fail.in_file(fail.in_indexed(fail.unsupported("an archive member holds other files"), "member", m.index::u64), e.name)};
        }
        e.include  = include;
        e.searched = found;
        val pushed: res[Id[Member], Fail] = table.push[Member](?c.out.members, Member{archive: from, loaded: id});
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        val n: err[Fail] = note(c, id);
        if (sel n.err) { ret n; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# keep one copy of every group signature by its rule, the first copy's rule
# deciding, and an associative group with the group of its leader
fun choose_groups(c: *Context) err[Fail] {
    var holders: Table[u32]  = table.make[u32](c.in.inputs.a);
    var copies:  Table[Copy] = table.make[Copy](c.in.inputs.a);
    val r:       err[Fail]   = chosen(c, ?holders, ?copies);
    val rh:      err[Fail]   = table.release[u32](?holders);
    val rc:      err[Fail]   = table.release[Copy](?copies);
    ret fail.kept(fail.kept(r, rh), rc);
}

fun chosen(c: *Context, holders: *Table[u32], copies: *Table[Copy]) err[Fail] {
    val laid: err[Fail] = lay_out(c, 0);
    if (sel laid.err) { ret laid; }
    var i: usize = 0;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = grouped(c, id);
        var g:  usize     = 0;
        if (o != nil) {
            for (g < table.count[Group](?o.groups)) {
                val e: err[Fail] = copy_of(c, holders, copies, id, o, table.nth[Group](g));
                if (sel e.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(e.err, "group", g::u64), input.at(c.in.inputs, id).name)}; }
                g = g + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = grouped(c, id);
        var g:  usize     = 0;
        if (o != nil) {
            for (g < table.count[Group](?o.groups)) {
                val e: err[Fail] = follow(c, id, o, table.nth[Group](g));
                if (sel e.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(e.err, "group", g::u64), input.at(c.in.inputs, id).name)}; }
                g = g + 1;
            }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# give each input from `from` on its place in the group tables: where its
# groups begin, every group kept
fun lay_out(c: *Context, from: usize) err[Fail] {
    var i: usize = from;
    for (i < input.count(c.in.inputs)) {
        val id:     Id[Input]          = table.nth[Input](i);
        val pushed: res[Id[u32], Fail] = table.push[u32](?c.out.firsts, table.count[bool](?c.out.kept)::u32);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        val o: *Object = grouped(c, id);
        if (o != nil) {
            val n: usize = table.count[Group](?o.groups);
            if (n != 0) {
                val grown: res[Id[bool], Fail] = table.grow[bool](?c.out.kept, n);
                if (sel grown.err) { ret err[Fail].err{grown.err}; }
                memory.fill[bool](?table.items[bool](?c.out.kept)[grown.ok.index], true, n);
            }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the object of `id` whose groups count, nil for a container or a library
fun grouped(c: *Context, id: Id[Input]) *Object {
    if (library(c.out, id)) { ret nil; }
    ret input.object_of(c.in.inputs, id);
}

fun kept_at(c: *Context, id: Id[Input], g: Id[Group]) *bool {
    val first: u32 = table.items[u32](?c.out.firsts)[id.index];
    ret ?table.items[bool](?c.out.kept)[first + g.index];
}

# decide the copy `g` of `id` against the copy its signature holds so far
fun copy_of(c: *Context, holders: *Table[u32], copies: *Table[Copy], id: Id[Input], o: *Object, g: Id[Group]) err[Fail] {
    val grp: *Group = object.group_at(o, g);
    if (group.has(grp.rule, group.ASSOCIATIVE)) { ret err[Fail].ok{}; }
    val text: View                = object.name_of(o, grp.signature);
    val sig:  res[Id[Name], Fail] = intern.intern(c.in.names, text.data, text.len);
    if (sel sig.err) { ret err[Fail].err{sig.err}; }
    val have: usize = table.count[u32](holders);
    if (sig.ok.index::usize >= have) {
        val grown: res[Id[u32], Fail] = table.grow[u32](holders, sig.ok.index::usize + 1 - have);
        if (sel grown.err) { ret err[Fail].err{grown.err}; }
    }
    val holder: *u32 = ?table.items[u32](holders)[sig.ok.index];
    if (@holder == 0) {
        val pushed: res[Id[Copy], Fail] = table.push[Copy](copies, Copy{input: id, group: g});
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        @holder = pushed.ok.index + 1;
        ret err[Fail].ok{};
    }
    val held:  Copy        = table.items[Copy](copies)[@holder - 1];
    val first: *Object     = input.object_of(c.in.inputs, held.input);
    val rule:  *group.Rule = object.group_at(first, held.group).rule;
    if (group.has(rule, group.UNIQUE)) {
        val dropped: *bool = kept_at(c, id, g);
        @dropped = false;
        ret clash(c, sig.ok, held.input, id, "a group signature is defined in more than one input");
    }
    val before: res[u64, Fail] = size_of(first, held.group);
    if (sel before.err) { ret err[Fail].err{before.err}; }
    val now: res[u64, Fail] = size_of(o, g);
    if (sel now.err) { ret err[Fail].err{now.err}; }
    if (group.has(rule, group.LARGEST) && now.ok > before.ok) {
        val lost: *bool = kept_at(c, held.input, held.group);
        @lost = false;
        val pushed: res[Id[Copy], Fail] = table.push[Copy](copies, Copy{input: id, group: g});
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        table.items[u32](holders)[sig.ok.index] = pushed.ok.index + 1;
        ret err[Fail].ok{};
    }
    val dropped: *bool = kept_at(c, id, g);
    @dropped = false;
    if (group.has(rule, group.SAME_SIZE) && now.ok != before.ok) {
        ret clash(c, sig.ok, held.input, id, "copies of a group differ in size");
    }
    if (group.has(rule, group.SAME_CONTENTS) && !same_contents(first, held.group, o, g)) {
        ret clash(c, sig.ok, held.input, id, "copies of a group differ in contents");
    }
    ret err[Fail].ok{};
}

# an associative group is kept exactly when the group of its leader is
fun follow(c: *Context, id: Id[Input], o: *Object, g: Id[Group]) err[Fail] {
    val grp: *Group = object.group_at(o, g);
    if (!group.has(grp.rule, group.ASSOCIATIVE)) { ret err[Fail].ok{}; }
    if (sel grp.leader.none)                     { ret err[Fail].err{fail.malformed("associative group has no leader section")}; }
    if (grp.leader.some.index::usize >= table.count[Section](?o.sections)) {
        ret err[Fail].err{fail.malformed("associative group's leader is not a section")};
    }
    val lead: res[Id[Section], Fail] = object.leader_of(o, grp.leader.some);
    if (sel lead.err) { ret err[Fail].err{lead.err}; }
    val owner: opt[Id[Group]] = object.section_at(o, lead.ok).group;
    if (sel owner.some) {
        val fate: *bool = kept_at(c, id, g);
        @fate = @kept_at(c, id, owner.some);
    }
    ret err[Fail].ok{};
}

fun clash(c: *Context, name: Id[Name], first: Id[Input], second: Id[Input], why: str) err[Fail] {
    val pushed: res[Id[Clash], Fail] = table.push[Clash](?c.out.clashes, Clash{name: name, first: first, second: second, why: why});
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

fun section_size(o: *Object, s: *Section) u64 {
    if (sel s.contents.zero) { ret s.contents.zero; }
    ret object.bytes(o, ?s.contents).len::u64;
}

# the size of the copy `g` of `o`: every member section's
fun size_of(o: *Object, g: Id[Group]) res[u64, Fail] {
    val at:    Location = Location{record: "group"};
    var total: u64      = 0;
    var i:     usize    = 0;
    for (i < table.count[Section](?o.sections)) {
        val s: *Section = object.section_at(o, table.nth[Section](i));
        if (sel s.group.some && s.group.some.index == g.index) {
            val sum: res[u64, Fail] = checked.add(at, total, section_size(o, s));
            if (sel sum.err) { ret sum; }
            total = sum.ok;
        }
        i = i + 1;
    }
    ret res[u64, Fail].ok{total};
}

# the next member section of `g` in `o` at or after `from`, the count of
# sections when there is none
fun next_member(o: *Object, g: Id[Group], from: usize) usize {
    var i: usize = from;
    for (i < table.count[Section](?o.sections)) {
        val s: *Section = object.section_at(o, table.nth[Section](i));
        if (sel s.group.some && s.group.some.index == g.index) { ret i; }
        i = i + 1;
    }
    ret i;
}

# whether two copies hold the same sections, byte for byte, in order
fun same_contents(a: *Object, ga: Id[Group], b: *Object, gb: Id[Group]) bool {
    var i: usize = next_member(a, ga, 0);
    var j: usize = next_member(b, gb, 0);
    for (i < table.count[Section](?a.sections) && j < table.count[Section](?b.sections)) {
        val x:  *Section = object.section_at(a, table.nth[Section](i));
        val y:  *Section = object.section_at(b, table.nth[Section](j));
        val xz: bool     = sel x.contents.zero;
        val yz: bool     = sel y.contents.zero;
        if (xz != yz)                                 { ret false; }
        if (section_size(a, x) != section_size(b, y)) { ret false; }
        if (!xz) {
            val p: Bytes = object.bytes(a, ?x.contents);
            val q: Bytes = object.bytes(b, ?y.contents);
            if (!memory.raw_equal(p.data::ptr, q.data::ptr, p.len)) { ret false; }
        }
        i = next_member(a, ga, i + 1);
        j = next_member(b, gb, j + 1);
    }
    ret i == table.count[Section](?a.sections) && j == table.count[Section](?b.sections);
}

# the rank of a definition
fun rank_of(sym: *Symbol) u8 {
    if (sel sym.def.common)                     { ret COMMON; }
    if (symbol.binds(sym.binding, symbol.WEAK)) { ret WEAK; }
    ret STRONG;
}

fun bind(c: *Context) err[Fail] {
    val d: err[Fail] = defined_bounds(c);
    if (sel d.err) { ret d; }
    var i: usize = 0;
    for (i < table.count[Import](?c.offers)) {
        val o: *Import = table.at[Import](?c.offers, table.nth[Import](i));
        val s: *Slot   = slot_at(c, o.name);
        if (!s.has) {
            s.has     = true;
            s.rank    = OFFERED;
            s.library = opt[Id[Name]].some{o.library};
        }
        i = i + 1;
    }
    val b: err[Fail] = bind_inputs(c, 0);
    if (sel b.err) { ret b; }
    ret fallbacks(c);
}

# hold each name a bound row has the link define for the output kind whether
# or not a reference reaches it, until an input's definition displaces it
fun defined_bounds(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < c.in.bounds.count) {
        val b: *Bound = ?c.in.bounds.rows[i];
        i = i + 1;
        if (!boundary.defines(b, c.in.kind)) { cnt; }
        val n: res[Id[Name], Fail] = intern.intern_str(c.in.names, b.name);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        val got: res[*Slot, Fail] = keyed(c, n.ok, false);
        if (sel got.err) { ret err[Fail].err{fail.in_record(got.err, b.name)}; }
        got.ok.has    = true;
        got.ok.rank   = LINKED;
        got.ok.bound  = b;
        got.ok.strong = true;
    }
    ret err[Fail].ok{};
}

# bind each weak reference nothing defines to what its fallback binds to
fun fallbacks(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Id[Name]](?c.order)) {
        val name: Id[Name] = table.items[Id[Name]](?c.order)[i];
        val s:    *Slot    = slot_at(c, name);
        i = i + 1;
        if (s.has || s.weak == 0) { cnt; }
        val r: err[Fail] = fall_back(c, name);
        if (sel r.err) { ret err[Fail].err{fail.in_file(r.err, input.at(c.in.inputs, table.nth[Input]((s.weak - 1)::usize)).name)}; }
    }
    ret err[Fail].ok{};
}

# follow the fallbacks of `name`'s weak reference to a definition. a
# reference whose search is unchained stops at its fallback
fun fall_back(c: *Context, name: Id[Name]) err[Fail] {
    val first: *Slot      = slot_at(c, name);
    var id:    Id[Input]  = table.nth[Input]((first.weak - 1)::usize);
    var k:     Id[Symbol] = first.weak_sym;
    var steps: usize      = 0;
    for {
        val o:   *Object              = input.object_of(c.in.inputs, id);
        val sym: *Symbol              = object.symbol_at(o, k);
        val f:   opt[object.Fallback] = sym.fallback;
        if (sel f.none) { ret err[Fail].err{fail.internal("a weak reference lost its fallback")}; }
        val fb: object.Fallback = f.some;
        if (fb.symbol.index::usize >= table.count[Symbol](?o.symbols)) { ret err[Fail].err{fail.malformed("a fallback names a symbol the object does not hold")}; }
        val target: *Symbol = object.symbol_at(o, fb.symbol);
        if (!symbol.binds(target.binding, symbol.EXTERNAL)) {
            if (sel target.def.undefined) { ret err[Fail].err{fail.malformed("a fallback is a local symbol with no definition")}; }
            val own: *Slot = slot_at(c, name);
            own.has    = true;
            own.fell   = true;
            own.alias  = false;
            own.rank   = rank_of(target);
            own.input  = id;
            own.symbol = fb.symbol;
            ret err[Fail].ok{};
        }
        val tk: res[Keys, Fail] = keys_of(c, o, target);
        if (sel tk.err) { ret err[Fail].err{tk.err}; }
        val got: res[*Slot, Fail] = slot_of(c, tk.ok.own);
        if (sel got.err) { ret err[Fail].err{got.err}; }
        val t:         *Slot = got.ok;
        val unchained: bool  = symbol.looks(fb.search, symbol.UNCHAINED);
        if (t.has && !(t.fell && unchained)) {
            val again: *Slot = slot_at(c, name);
            again.has     = true;
            again.fell    = true;
            again.alias   = false;
            again.rank    = t.rank;
            again.unique  = t.unique;
            again.input   = t.input;
            again.symbol  = t.symbol;
            again.library = t.library;
            ret err[Fail].ok{};
        }
        if (unchained || t.weak == 0) { ret unresolved(c, name); }
        steps = steps + 1;
        if (steps > table.count[Id[Name]](?c.order)) { ret err[Fail].err{fail.malformed("weak external fallbacks form a cycle")}; }
        id = table.nth[Input]((t.weak - 1)::usize);
        k  = t.weak_sym;
    }
    ret err[Fail].ok{};
}

# the weak reference of `name` reaches no definition, an undefined reference
# of the input that declares it
fun unresolved(c: *Context, name: Id[Name]) err[Fail] {
    val s:      *Slot                    = slot_at(c, name);
    val pushed: res[Id[Reference], Fail] = table.push[Reference](?c.refs, Reference{name: name, input: table.nth[Input]((s.weak - 1)::usize)});
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

# bind the symbols of the inputs from `from` on
fun bind_inputs(c: *Context, from: usize) err[Fail] {
    var i: usize = from;
    for (i < input.count(c.in.inputs)) {
        val id:    Id[Input]          = table.nth[Input](i);
        val o:     *Object            = grouped(c, id);
        val start: res[Id[u32], Fail] = table.push[u32](?c.out.starts, table.count[u32](?c.out.links)::u32);
        if (sel start.err) { ret err[Fail].err{start.err}; }
        if (o != nil && table.count[Symbol](?o.symbols) != 0) {
            val grown: res[Id[u32], Fail] = table.grow[u32](?c.out.links, table.count[Symbol](?o.symbols));
            if (sel grown.err) { ret err[Fail].err{grown.err}; }
        }
        if (library(c.out, id)) {
            val named: err[Fail] = name_library(c, id);
            if (sel named.err) { ret err[Fail].err{fail.in_file(named.err, input.at(c.in.inputs, id).name)}; }
        }
        if (o != nil) {
            val st: err[Fail] = staying(c, o);
            if (sel st.err) { ret err[Fail].err{fail.in_file(st.err, input.at(c.in.inputs, id).name)}; }
            var k: usize = 0;
            for (k < table.count[Symbol](?o.symbols)) {
                val e: err[Fail] = bind_symbol(c, id, o, table.nth[Symbol](k), table.items[bool](?c.stays)[k]);
                if (sel e.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(e.err, "symbol", k::u64), input.at(c.in.inputs, id).name)}; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret intended(c, from);
}

# give the name each export directive of an object input from `from` on is
# about the default visibility, on a format whose link exports by
# visibility. a name nothing binds is left to the export check to refuse
fun intended(c: *Context, from: usize) err[Fail] {
    if (c.in.directed) { ret err[Fail].ok{}; }
    var i: usize = from;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(c.in.inputs, id);
        i = i + 1;
        if (o == nil || library(c.out, id)) { cnt; }
        var k: usize = 0;
        for (k < table.count[object.Directive](?o.directives)) {
            val d: *object.Directive = table.at[object.Directive](?o.directives, table.nth[object.Directive](k));
            k = k + 1;
            if (d.kind != ?directive.EXPORT) { cnt; }
            val about: opt[Id[Name]] = d.symbol;
            if (sel about.none) { cnt; }
            val text: View          = object.name_of(o, about.some);
            val nm:   opt[Id[Name]] = intern.find(c.in.names, text.data, text.len);
            if (sel nm.none)                                         { cnt; }
            if (nm.some.index::usize >= table.count[Slot](?c.slots)) { cnt; }
            val s: *Slot = slot_at(c, nm.some);
            if (s.vis != nil) { s.vis = ?symbol.DEFAULT; }
        }
    }
    ret err[Fail].ok{};
}

# note the link name of every external symbol of the shared library `id`,
# which binds nothing itself
fun name_library(c: *Context, id: Id[Input]) err[Fail] {
    val o:     *Object            = input.object_of(c.in.inputs, id);
    val count: usize              = table.count[Symbol](?o.symbols);
    val start: u32                = table.items[u32](?c.out.starts)[id.index];
    val grown: res[Id[u32], Fail] = table.grow[u32](?c.out.links, count);
    if (sel grown.err) { ret err[Fail].err{grown.err}; }
    var k: usize = 0;
    for (k < count) {
        val sym: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
        if (symbol.binds(sym.binding, symbol.EXTERNAL)) {
            val nm: res[Id[Name], Fail] = c.in.hooks.name(c, o, sym);
            if (sel nm.err) { ret err[Fail].err{fail.in_indexed(nm.err, "symbol", k::u64)}; }
            table.items[u32](?c.out.links)[start::usize + k] = nm.ok.index + 1;
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# mark each symbol of `o` a staying import names, whose reference stands
# when nothing defines it
fun staying(c: *Context, o: *Object) err[Fail] {
    table.clear[bool](?c.stays);
    val n: usize = table.count[Symbol](?o.symbols);
    if (n == 0) { ret err[Fail].ok{}; }
    val g: res[Id[bool], Fail] = table.grow[bool](?c.stays, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < table.count[object.Entry](?o.entries)) {
        val en: *object.Entry = table.at[object.Entry](?o.entries, table.nth[object.Entry](i));
        i = i + 1;
        if (sel en.import.none)    { cnt; }
        if (!en.import.some.stays) { cnt; }
        val by: opt[Id[Symbol]] = en.import.some.symbol;
        if (sel by.none)               { cnt; }
        if (by.some.index::usize >= n) { ret err[Fail].err{fail.in_indexed(fail.malformed("an import names a symbol the object does not hold"), "entry", (i - 1)::u64)}; }
        table.items[bool](?c.stays)[by.some.index] = true;
    }
    ret err[Fail].ok{};
}

# `stays`: a staying import names the symbol, so an undefined reference by it
# stands when nothing defines its name
fun bind_symbol(c: *Context, id: Id[Input], o: *Object, k: Id[Symbol], stays: bool) err[Fail] {
    val sym: *Symbol = object.symbol_at(o, k);
    if (!symbol.binds(sym.binding, symbol.EXTERNAL)) { ret err[Fail].ok{}; }
    val ks: res[Keys, Fail] = keys_of(c, o, sym);
    if (sel ks.err) { ret err[Fail].err{ks.err}; }
    val start: u32 = table.items[u32](?c.out.starts)[id.index];
    table.items[u32](?c.out.links)[start + k.index] = ks.ok.own.index + 1;
    if (sel sym.def.placed) {
        if (sym.def.placed.section.index::usize >= table.count[Section](?o.sections)) {
            ret err[Fail].err{fail.malformed("symbol is placed in a section the object does not hold")};
        }
        if (!keeps(c.out, id, object.section_at(o, sym.def.placed.section))) { ret err[Fail].ok{}; }
    }
    val before: usize     = table.count[Clash](?c.out.clashes);
    val b:      err[Fail] = bind_under(c, id, k, sym, ks.ok.own, sel sym.version.some, false, stays);
    if (sel b.err) { ret b; }
    val bare: opt[Id[Name]] = ks.ok.bare;
    if (sel bare.none)                                { ret err[Fail].ok{}; }
    if (table.count[Clash](?c.out.clashes) != before) { ret err[Fail].ok{}; }
    ret bind_under(c, id, k, sym, bare.some, false, true, false);
}

# bind `sym`, the symbol `k` of the input `id`, under `name`, which reaches it
# by a versioned link name when `versioned`, and as the base name its default
# version answers when `alias`. `stays`: a staying import names it, so an
# undefined reference by it stands when nothing defines its name
fun bind_under(c: *Context, id: Id[Input], k: Id[Symbol], sym: *Symbol, name: Id[Name], versioned: bool, alias: bool, stays: bool) err[Fail] {
    val got: res[*Slot, Fail] = keyed(c, name, versioned);
    if (sel got.err) { ret err[Fail].err{got.err}; }
    val s: *Slot = got.ok;
    if (s.vis == nil) { s.vis = sym.visibility; }
    or                { s.vis = symbol.merged(s.vis, sym.visibility); }
    if (sel sym.def.undefined) {
        if (!s.has) {
            val b: opt[*Bound] = boundary.find(?c.in.bounds, intern.bytes_of(c.in.names, name));
            if (sel b.some) {
                s.has   = true;
                s.rank  = LINKED;
                s.bound = b.some;
            }
        }
        if (sel sym.fallback.some && s.weak == 0) {
            s.weak     = id.index + 1;
            s.weak_sym = k;
        }
        if (stays || symbol.binds(sym.binding, symbol.WEAK)) { ret err[Fail].ok{}; }
        s.strong = true;
        if (s.referred == id.index + 1) { ret err[Fail].ok{}; }
        s.referred = id.index + 1;
        val pushed: res[Id[Reference], Fail] = table.push[Reference](?c.refs, Reference{name: name, input: id});
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        ret err[Fail].ok{};
    }
    if (sel sym.def.common) {
        val block: object.Common = sym.def.common;
        if (block.align == 0 || (block.align & (block.align - 1)) != 0) {
            ret err[Fail].err{fail.malformed("a common symbol's alignment is not a power of two")};
        }
        if (block.size > s.size)   { s.size = block.size; }
        if (block.align > s.align) { s.align = block.align; }
    }
    val rank:   u8   = rank_of(sym);
    val unique: bool = symbol.binds(sym.binding, symbol.UNIQUE);
    if (s.has && rank == s.rank && rank == STRONG && !unique && !s.unique) {
        ret clash(c, name, s.input, id, "a symbol is defined in more than one input");
    }
    if (s.has && rank <= s.rank) { ret err[Fail].ok{}; }
    s.has     = true;
    s.rank    = rank;
    s.unique  = unique;
    s.input   = id;
    s.symbol  = k;
    s.library = opt[Id[Name]].none{};
    s.alias   = alias;
    s.bound   = nil;
    ret err[Fail].ok{};
}

fun finish(c: *Context) err[Fail] {
    val p: err[Fail] = publish(c, true);
    if (sel p.err) { ret p; }
    ret judged(c);
}

# write each bound name into the output: an import for a name a library
# offers, a binding for every other, and the storage of a common one. the
# imports are recorded and announced to the hook only when `fresh`, since
# otherwise they are already there
fun publish(c: *Context, fresh: bool) err[Fail] {
    val count: usize              = intern.count(c.in.names);
    val grown: res[Id[u32], Fail] = table.grow[u32](?c.out.named, count);
    if (sel grown.err) { ret err[Fail].err{grown.err}; }
    var i: usize = 0;
    for (i < table.count[Id[Name]](?c.order)) {
        val name: Id[Name]      = table.items[Id[Name]](?c.order)[i];
        val s:    *Slot         = slot_at(c, name);
        val lib:  opt[Id[Name]] = s.library;
        if (!s.has) {
            i = i + 1;
            cnt;
        }
        if (s.bound != nil) {
            val e: err[Fail] = link_defined(c, name, s.bound, !s.strong);
            if (sel e.err) { ret e; }
            i = i + 1;
            cnt;
        }
        if (sel lib.some) {
            if (fresh) {
                val im: res[Id[Import], Fail] = table.push[Import](?c.out.imports, Import{name: name, library: lib.some});
                if (sel im.err) { ret err[Fail].err{im.err}; }
                val h: err[Fail] = c.in.hooks.imported(c, im.ok);
                if (sel h.err) { ret h; }
            }
        }
        or {
            val b: res[Id[Binding], Fail] = table.push[Binding](?c.out.bindings, Binding{name: name, input: s.input, symbol: s.symbol, visibility: s.vis, alias: s.alias});
            if (sel b.err) { ret err[Fail].err{b.err}; }
            table.items[u32](?c.out.named)[name.index] = b.ok.index + 1;
            if (s.rank == COMMON) {
                val st: res[Id[Storage], Fail] = table.push[Storage](?c.out.commons, Storage{name: name, binding: b.ok, size: s.size, align: s.align});
                if (sel st.err) { ret err[Fail].err{st.err}; }
            }
        }
        i = i + 1;
    }
    ret publish_undefined(c);
}

# write the link's own definition of `name` at the place `b` states, which
# only weak references reach when `weak`
fun link_defined(c: *Context, name: Id[Name], b: *Bound, weak: bool) err[Fail] {
    val have: usize = table.count[u32](?c.out.linking);
    if (name.index::usize >= have) {
        val g: res[Id[u32], Fail] = table.grow[u32](?c.out.linking, name.index::usize + 1 - have);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    val p: res[Id[Linked], Fail] = table.push[Linked](?c.out.linked, Linked{name: name, bound: b, weak: weak});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    table.items[u32](?c.out.linking)[name.index] = p.ok.index + 1;
    ret err[Fail].ok{};
}

# write every reference to a name nothing defines into the output, grouped by
# name. `next` holds, by name, how many references a name has, then where its
# next reference goes plus one
fun publish_undefined(c: *Context) err[Fail] {
    var count: Table[u32] = table.make[u32](c.in.inputs.a);
    var next:  Table[u32] = table.make[u32](c.in.inputs.a);
    val r:     err[Fail]  = group_undefined(c, ?count, ?next);
    val rc:    err[Fail]  = table.release[u32](?count);
    val rn:    err[Fail]  = table.release[u32](?next);
    ret fail.kept(fail.kept(r, rc), rn);
}

fun group_undefined(c: *Context, count: *Table[u32], next: *Table[u32]) err[Fail] {
    val names: usize              = intern.count(c.in.names);
    val gc:    res[Id[u32], Fail] = table.grow[u32](count, names);
    if (sel gc.err) { ret err[Fail].err{gc.err}; }
    val gn: res[Id[u32], Fail] = table.grow[u32](next, names);
    if (sel gn.err) { ret err[Fail].err{gn.err}; }
    val refs:  *Reference = table.items[Reference](?c.refs);
    val n:     usize      = table.count[Reference](?c.refs);
    var total: usize      = 0;
    var i:     usize      = 0;
    for (i < n) {
        if (!slot_at(c, refs[i].name).has) {
            table.items[u32](count)[refs[i].name.index] = table.items[u32](count)[refs[i].name.index] + 1;
            total                                       = total + 1;
        }
        i = i + 1;
    }
    val base: usize                    = table.count[Reference](?c.out.undefined);
    val grow: res[Id[Reference], Fail] = table.grow[Reference](?c.out.undefined, total);
    if (sel grow.err) { ret err[Fail].err{grow.err}; }
    var placed: u32 = 0;
    i = 0;
    for (i < n) {
        val name: u32 = refs[i].name.index;
        if (!slot_at(c, refs[i].name).has && table.items[u32](next)[name] == 0) {
            table.items[u32](next)[name] = placed + 1;
            placed                       = placed + table.items[u32](count)[name];
        }
        i = i + 1;
    }
    val out: *Reference = table.items[Reference](?c.out.undefined);
    i = 0;
    for (i < n) {
        val name: u32 = refs[i].name.index;
        if (!slot_at(c, refs[i].name).has) {
            out[base + (table.items[u32](next)[name] - 1)::usize] = refs[i];
            table.items[u32](next)[name]                          = table.items[u32](next)[name] + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun judged(c: *Context) err[Fail] {
    if (table.count[Clash](?c.out.clashes) != 0) {
        val first: *Clash = table.at[Clash](?c.out.clashes, table.nth[Clash](0));
        ret err[Fail].err{fail.in_file(fail.malformed(first.why), input.at(c.in.inputs, first.second).name)};
    }
    val refs: usize = table.count[Reference](?c.out.undefined);
    if (refs == 0 || output.has(c.in.kind, output.UNRESOLVED)) { ret err[Fail].ok{}; }
    val first: opt[usize] = first_unexcused(c);
    if (sel first.none) { ret err[Fail].ok{}; }
    val at:      *Reference = table.at[Reference](?c.out.undefined, table.nth[Reference](first.some));
    val names:   i128       = undefined_names(c);
    val f:       Fail       = fail.valued(fail.malformed("the link refers to symbols nothing defines"), names);
    val refused: err[Fail]  = err[Fail].err{fail.in_file(f, input.at(c.in.inputs, at.input).name)};
    ret fail.kept(refused, tell_undefined(c));
}

# the first undefined reference no promise excuses, none when each names what
# a stage of the link still to come promises to define
fun first_unexcused(c: *Context) opt[usize] {
    val refs: *Reference = table.items[Reference](?c.out.undefined);
    var i:    usize      = 0;
    for (i < table.count[Reference](?c.out.undefined)) {
        if (!excused(c, refs[i].name)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# whether a promise of a stage still to come names `name`, which binds once
# that stage has run. a promise of a stage that has run is kept or broken,
# so it excuses nothing
fun excused(c: *Context, name: Id[Name]) bool {
    if (c.in.promised == nil) { ret false; }
    val v:  View     = intern.bytes_of(c.in.names, name);
    val at: *Promise = table.items[Promise](c.in.promised);
    var i:  usize    = 0;
    for (i < table.count[Promise](c.in.promised)) {
        if (at[i].stage >= c.in.reached && spells(v, at[i].prefix, at[i].name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `v` is `prefix` then `name`
fun spells(v: View, prefix: str, name: str) bool {
    var p: usize = 0;
    if (prefix != nil) { p = str_len(prefix); }
    val n: usize = str_len(name);
    if (v.len != p + n) { ret false; }
    var i: usize = 0;
    for (i < v.len) {
        var want: u8 = 0;
        if (i < p)             { want = prefix[i]; }
        or                     { want = name[i - p]; }
        if (v.data[i] != want) { ret false; }
        i = i + 1;
    }
    ret true;
}

# how many names the undefined references no promise excuses, grouped by
# name, refer to
fun undefined_names(c: *Context) i128 {
    val refs:  *Reference = table.items[Reference](?c.out.undefined);
    var names: i128       = 0;
    var i:     usize      = 0;
    for (i < table.count[Reference](?c.out.undefined)) {
        if ((i == 0 || refs[i].name.index != refs[i - 1].name.index) && !excused(c, refs[i].name)) { names = names + 1; }
        i = i + 1;
    }
    ret names;
}

# write to the notes a line naming each name nothing defines and no promise
# excuses, then a line naming each input that refers to it
fun tell_undefined(c: *Context) err[Fail] {
    val refs: *Reference = table.items[Reference](?c.out.undefined);
    var i:    usize      = 0;
    for (i < table.count[Reference](?c.out.undefined)) {
        if (excused(c, refs[i].name)) {
            i = i + 1;
            cnt;
        }
        val name: View = intern.bytes_of(c.in.names, refs[i].name);
        if (i == 0 || refs[i].name.index != refs[i - 1].name.index) {
            val w: err[Fail] = diag.note_named(Location{}, name, "nothing defines the symbol", c.in.notes);
            if (sel w.err) { ret w; }
        }
        val at: Location  = Location{file: input.at(c.in.inputs, refs[i].input).name};
        val w:  err[Fail] = diag.note_named(at, name, "refers to the symbol", c.in.notes);
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# resolve the inputs from `first` on, which a synthesizer made after resolution
# had run, against the answers `out` already holds. the inputs before `first`
# are not read again: each name's standing is rebuilt from its binding, so a
# definition among the new inputs wins or loses against it by the same ranks,
# and the bindings, imports, commons and undefined references are written
# again, every earlier name keeping its place. archives are not searched
# again, since a new input may not enlarge the link, so a strong reference
# among them to a name nothing defines is an undefined reference like any
# other. a new input holds no group, since its copy could displace one that
# bindings already stand on. `in` supplies the inputs, names, kind and hooks
pub fun extend(in: *In, out: *Resolved, first: usize) err[Fail] {
    val a: *A.Allocator = in.inputs.a;
    var c: Context      = Context{
        in:       in,
        out:      out,
        slots:    table.make[Slot](a),
        order:    table.make[Id[Name]](a),
        pending:  table.make[Id[Name]](a),
        offers:   table.make[Import](a),
        archives: table.make[Archive](a),
        refs:     table.make[Reference](a),
        stays:    table.make[bool](a),
    };
    val r: err[Fail] = extended(?c, first);
    val d: err[Fail] = drop(?c);
    if (sel r.err) { ret r; }
    ret d;
}

fun extended(c: *Context, first: usize) err[Fail] {
    var i: usize = first;
    for (i < input.count(c.in.inputs)) {
        val o: *Object = input.object_of(c.in.inputs, table.nth[Input](i));
        if (o != nil && table.count[Group](?o.groups) != 0) {
            ret err[Fail].err{fail.in_file(fail.unsupported("an input made after resolution holds a group"), input.at(c.in.inputs, table.nth[Input](i)).name)};
        }
        i = i + 1;
    }
    val s: err[Fail] = seed(c);
    if (sel s.err) { ret s; }
    val l: err[Fail] = lay_out(c, first);
    if (sel l.err) { ret l; }
    val b: err[Fail] = bind_inputs(c, first);
    if (sel b.err) { ret b; }
    val f: err[Fail] = fallbacks(c);
    if (sel f.err) { ret f; }
    val w: err[Fail] = rewind(c);
    if (sel w.err) { ret w; }
    val p: err[Fail] = publish(c, false);
    if (sel p.err) { ret p; }
    ret judged(c);
}

# the standing of every name `out` answers, rebuilt from its answers: a
# binding's rank is its winning symbol's, an import's is a library's
fun seed(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Binding](?c.out.bindings)) {
        val b:   Binding          = table.items[Binding](?c.out.bindings)[i];
        val got: res[*Slot, Fail] = slot_of(c, b.name);
        if (sel got.err) { ret err[Fail].err{got.err}; }
        val sym: *Symbol = object.symbol_at(input.object_of(c.in.inputs, b.input), b.symbol);
        val s:   *Slot   = got.ok;
        s.defined = true;
        s.has     = true;
        s.rank    = rank_of(sym);
        s.unique  = symbol.binds(sym.binding, symbol.UNIQUE);
        s.input   = b.input;
        s.symbol  = b.symbol;
        s.vis     = b.visibility;
        s.alias   = b.alias;
        i         = i + 1;
    }
    i = 0;
    for (i < table.count[Import](?c.out.imports)) {
        val im:  Import           = table.items[Import](?c.out.imports)[i];
        val got: res[*Slot, Fail] = slot_of(c, im.name);
        if (sel got.err) { ret err[Fail].err{got.err}; }
        got.ok.defined = true;
        got.ok.has     = true;
        got.ok.rank    = OFFERED;
        got.ok.library = opt[Id[Name]].some{im.library};
        i              = i + 1;
    }
    i = 0;
    for (i < table.count[Linked](?c.out.linked)) {
        val ln:  Linked           = table.items[Linked](?c.out.linked)[i];
        val got: res[*Slot, Fail] = slot_of(c, ln.name);
        if (sel got.err) { ret err[Fail].err{got.err}; }
        got.ok.has    = true;
        got.ok.rank   = LINKED;
        got.ok.bound  = ln.bound;
        got.ok.strong = !ln.weak;
        i             = i + 1;
    }
    i = 0;
    for (i < table.count[Storage](?c.out.commons)) {
        val st: Storage = table.items[Storage](?c.out.commons)[i];
        val s:  *Slot   = slot_at(c, st.name);
        s.size  = st.size;
        s.align = st.align;
        i       = i + 1;
    }
    i = 0;
    for (i < table.count[Reference](?c.out.undefined)) {
        val r:   Reference        = table.items[Reference](?c.out.undefined)[i];
        val got: res[*Slot, Fail] = slot_of(c, r.name);
        if (sel got.err) { ret err[Fail].err{got.err}; }
        val pushed: res[Id[Reference], Fail] = table.push[Reference](?c.refs, r);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# empty the answers that publish writes again, and drop the imports a new
# definition displaced
fun rewind(c: *Context) err[Fail] {
    table.clear[Binding](?c.out.bindings);
    table.clear[u32](?c.out.named);
    table.clear[Storage](?c.out.commons);
    table.clear[Reference](?c.out.undefined);
    table.clear[Linked](?c.out.linked);
    table.clear[u32](?c.out.linking);
    var left: Table[Import] = table.make[Import](c.in.inputs.a);
    var i:    usize         = 0;
    for (i < table.count[Import](?c.out.imports)) {
        val im:       Import        = table.items[Import](?c.out.imports)[i];
        val standing: opt[Id[Name]] = slot_at(c, im.name).library;
        if (sel standing.some) {
            val pushed: res[Id[Import], Fail] = table.push[Import](?left, im);
            if (sel pushed.err) {
                table.release[Import](?left);
                ret err[Fail].err{pushed.err};
            }
        }
        i = i + 1;
    }
    val old: err[Fail] = table.release[Import](?c.out.imports);
    c.out.imports = left;
    ret old;
}

pub fun plain_name(c: *Context, o: *Object, s: *Symbol) res[Id[Name], Fail] {
    val text: View = object.name_of(o, s.name);
    ret intern.intern(c.in.names, text.data, text.len);
}

pub fun no_record(c: *Context, id: Id[Import]) err[Fail] {
    ret err[Fail].ok{};
}

fun asks_none(c: *Context) err[Fail] {
    ret err[Fail].ok{};
}
