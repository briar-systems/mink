# the resolve phase: every reference binds to exactly one definition, and
# archives contribute the members the link needs
#
# resolution runs in three passes. loading notes what every input defines and
# refers to, in input order, and searches each archive for the names still
# undefined when the search reaches it, pulling a member only for a strong
# reference and repeating to a fixed point. grouping keeps one copy of every
# group signature by what its rule row declares, and a definition in a copy
# it discards, placed or an entry's, leaves resolution. binding picks each name's
# winning definition: a strong one over a common one, a common one over a weak
# one, and any object's over a shared library's, and merges the commons of a
# name to the largest size and alignment any of them asks for. a weak
# reference nothing defines whose symbol names a fallback, a COFF weak
# external, binds to what its fallback binds to: its search row says whether
# the reference pulls an archive member that defines the name, and whether a
# fallback that is itself undefined is followed on to its own fallback, a
# cycle being refused. one that reaches no definition is an undefined
# reference of the input that declares it. a format's conventions reach the
# phase only as search capabilities and the hooks below, never as a question
# of which format it is.
#
# loading reads the link claims of each object input as it notes it, an
# archive member only once it is pulled, and what they name enters right
# after it. a shared system library a claim names, on a format whose hooks
# describe one, is the library the claim describes, made by the format from
# the claim alone with no file looked for: the claims of one record's bytes
# make it once, and the claims of other objects naming the library each make
# a library input of the same loader name, which the dynamic phase takes as
# one library. a name two such libraries of different loader names provide
# is refused. every other claim names files, found by the caller's claimant as
# the requests it states are.
#
# the copies of a merged definition (model/merged) are compared in archive
# members the link does not load as well, since a member is pulled only for a
# name nothing defines yet, so a second library's copy of a name the first
# defined would otherwise never be read. once binding is done, every member
# whose archive index offers the name of a bound copy and that the link left
# unloaded is read for its symbols and groups, and never loaded: its copies
# are compared with the kept one, and the first two holders of the name, in
# command line order, that differ are refused as loaded copies would be. a
# member mink reads no format of is not part of the link and is passed over.
# one of a format mink reads that claims a copy's name and cannot be read is
# refused, as the archive then claims a definition of the name that cannot be
# compared.
#
# inputs made after resolution join through extend, which resolves only them
# against the answers already bound.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use std.memory;
use std.types.path.filename;

use mink.base.checked;
use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.base.vectors;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.kind;
use mink.catalog.os.Host;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.format.contract;
use mink.format.contract.Model;
use mink.format.contract.Naming;
use mink.format.registration.Registration;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.link.boundary;
use mink.link.boundary.Bound;
use mink.link.gather;
use mink.link.input;
use mink.link.input.Claimant;
use mink.link.input.Include;
use mink.link.input.Input;
use mink.link.input.Inputs;
use mink.link.input.Source;
use mink.model.claim;
use mink.model.claim.Claim;
use mink.model.claim.Provided;
use mink.model.directive;
use mink.model.group;
use mink.model.merged;
use mink.model.object;
use mink.model.object.Entry;
use mink.model.object.Group;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.section;
use mink.model.symbol;
use mink.model.symbol.Visibility;
use mink.model.target;

pub def Caps: u64;

# every archive is searched again while a later input leaves a name
# undefined, as one group, rather than once where it stands
pub val REVISIT: Caps = 0x1;

# an archive member that defines a name as data is pulled to replace a common
# definition of it, as when a name is undefined, rather than the commons
# standing as the definition
pub val COMMON_PULL: Caps = 0x2;

# the points where a format's own resolution rules join the phase
# ---
# name:      the link name a symbol of an object resolves under, as a
#            versioned name maps to its base name and version
# library:   whether an input is a shared library, offering its definitions
#            through offer when it is
# imported:  called once for every name the link imports, as a two-level
#            namespace records the library ordinal it binds through
# asked:     called before any archive is searched, and asks the link for each
#            name the format's image needs through ask
# describes: how the format makes the shared library a claim describes, none
#            for a format whose shared libraries are always files
pub rec Hooks {
    name:      fun(*Context, *Object, *Symbol) res[Id[Name], Fail];
    library:   fun(*Context, Id[Input]) res[bool, Fail];
    imported:  fun(*Context, Id[Import]) err[Fail];
    asked:     fun(*Context) err[Fail];
    describes: opt[*Describer];
}

# how a format makes the interface of a shared system library from the claim
# that names it, with no file: what an image importing from it needs, which
# is the library the loader knows by the claim's name, at the versions the
# claim states, defining each symbol the claim provides as the format's
# import of a symbol of its sort is defined
# ---
# describe: fill the empty object `o`, of the stub kind, with the library the
#           claim `cl` describes for an image the host `h` runs
# named:    refuse a name the format names no library a claim describes by,
#           which describe refuses as well, so a producer can check a name
#           where it states it
pub rec Describer {
    describe: fun(*Object, *Claim, *Host) err[Fail];
    named:    fun(View) err[Fail];
}

# the hooks of a format with no rules of its own: a symbol resolves under its
# own name, a shared library offers what its neutral object exports, an
# import records nothing more and the link asks for no name
pub val PLAIN: Hooks = Hooks{name: plain_name, library: shared, imported: no_record, asked: asks_none};

# how a format resolves a reference to a weak symbol nothing defines
# ---
# zero:     the reference has the value zero
# fallback: the reference resolves to what its fallback binds to, as resolution
#           binds it, and one that reaches no definition is refused
# unruled:  the format states no rule
pub tag Weak: u8 {
    zero;
    fallback;
    unruled;
}

# inputs:   the set to resolve, which archive members are appended to
# names:    the link's names
# registry: the formats archive members are read and converted through
# reading:  how the link reads an input, which pulled members and found
#           claims are read by
# arch:     the architecture a member's object is converted for
# kind:     the output kind, which says whether undefined references may stay
# search:   how the format's linker searches archives
# hooks:    the format's resolution rules
# bounds:   the names the format's link defines at places of its layout
# notes:    the caller's sink, where a refusal writes what its failure
#           cannot carry, such as the link's own names
# directed: the format's link exports by directive, not by visibility, so
#           an export directive leaves the visibility of its name as it is.
#           otherwise the name an object input's export directive is about
#           takes the default visibility, which shows it exported
# claimant: what finds the files the link claims of an object input name,
#           none for a link that finds none, which refuses an input stating
#           a claim that names a file
# host:     the host the image runs on, which a format's describer reads
pub rec In {
    inputs:   *Inputs;
    names:    *Interner;
    registry: *Registry;
    reading:  gather.Reading;
    host:     *Host;
    arch:     *Arch;
    kind:     *Kind;
    search:   Caps;
    hooks:    *Hooks;
    bounds:   boundary.Bounds;
    notes:    *Sink;
    directed: bool;
    claimant: opt[*Claimant];
}

# where a name is defined: the winning symbol of an input, and the visibility
# every symbol of the name merges to. `alias` marks the binding of a base name
# a default version's definition answers, which stands bound under its own
# versioned link name as well, so an image names it once, by that
pub rec Binding {
    name:       Id[Name];
    input:      Id[Input];
    symbol:     Id[Symbol];
    visibility: *Visibility;
    alias:      bool;
}

# a winning definition: its binding's id, and the binding, whose input and
# symbol define it
pub rec Won {
    id:      Id[Binding];
    binding: *Binding;
}

# a name a loader binds at run time, and the library that defines it
pub rec Import {
    name:    Id[Name];
    library: Id[Name];
}

# an archive member the link loaded: the archive's input and the member's
pub rec Member {
    archive: Id[Input];
    loaded:  Id[Input];
}

# a name whose winning definition is common, and the storage its commons
# merge to: the largest size and the largest alignment any of them asks for
pub rec Storage {
    name:    Id[Name];
    binding: Id[Binding];
    size:    u64;
    align:   u64;
}

# who holds a definition a clash is over: an input of the link, or an archive
# member it compared without loading, by the offset of its spelling
# `archive(member)` in the resolution's spellings
pub tag Party: u8 {
    input:  Id[Input];
    member: usize;
}

# two holders the link cannot take together over one name: a symbol both
# define strongly, a group signature both hold where the rule refuses it, or
# copies of a merged definition that differ
# ---
# why:  the refusal, static, `{}` the name
# held: a note's sentence of what one holder holds, `{at}` its file and `{}` the name, static
pub rec Clash {
    name:   Id[Name];
    first:  Party;
    second: Party;
    why:    str;
    held:   str;
}

# an input that refers to a name
pub rec Reference {
    name:  Id[Name];
    input: Id[Input];
}

# bindings:  every defined name's winning definition, in the order names were
#            first seen
# imports:   every name a shared library defines for the link
# members:   the archive members loaded, in load order
# named:     each binding's index plus one, indexed by the link's name id,
#            zero for a name with none
# commons:   every name bound to a common definition, in binding order, and
#            the storage its commons merge to. a name later given a definition
#            by extend leaves it
# kept:      whether each group of each input is kept, input by input
# firsts:    the index in kept of each input's first group
# clashes:   what the link was refused for, holding both inputs
# undefined: every input that refers strongly to a name nothing defines, a
#            refusal unless the output kind keeps such references, grouped
#            by name in the order names were first referred to and each
#            name's inputs in input order
# libraries: whether each input is a shared library, indexed by input, an
#            input past its end being none
# links:     the link name of each symbol of each object input and shared
#            library, its id plus one, zero for a local symbol
# starts:    the index in links of each input's first symbol
# linked:    every name the link defines itself, at a place of its layout, in
#            the order names were first seen
# linking:   each linked name's index in linked plus one, indexed by the
#            link's name id, zero for a name with none
# lent:      every library input whose exports a shared library offers as
#            its own, as one it re-exports, each re-exporter's together
# lending:   where each input's run of lent starts and how many it holds,
#            indexed by input, an input past its end lending none
# spelled:   the spellings of the archive members a clash names, each ended
#            by a zero byte
pub rec Resolved {
    bindings:  Table[Binding];
    imports:   Table[Import];
    members:   Vector[Member];
    named:     Vector[u32];
    commons:   Vector[Storage];
    kept:      Vector[bool];
    firsts:    Vector[u32];
    clashes:   Vector[Clash];
    undefined: Vector[Reference];
    libraries: Vector[bool];
    links:     Vector[u32];
    starts:    Vector[u32];
    linked:    Table[Linked];
    linking:   Vector[u32];
    lent:      Vector[Id[Input]];
    spelled:   Vector[u8];
    lending:   Vector[Lending];
}

# a run of lent: where it starts and how many it holds
pub rec Lending {
    first: u32;
    count: u32;
}

# a name the link defines itself, and the row of the format's bound symbols
# that places it
# ---
# weak:    only weak references reach it, so it stays undefined where its
#          place names an output section no kept section is laid into
# section: the name of the output section its place names, none for a place
#          at no one section
# missing: the kind the format's naming convention gives that section where
#          no kept section is laid into it, which layout binds an empty range
#          of where the section would land, none where one is
pub rec Linked {
    name:    Id[Name];
    bound:   *Bound;
    weak:    bool;
    section: opt[Id[Name]];
    missing: opt[*section.Kind];
}

# what the phase knows of one name of the link
# ---
# seen:     the name is in the order
# defined:  some loaded input defines it
# common:   some loaded input defines it common
# regular:  some loaded input defines it, and not common
# wanted:   the name is queued for an archive search
# has:      a definition is bound, of rank `rank`
# unique:   the bound definition is one of many a process shares
# library:  the shared library of a bound offer
# referred: the last input that refers to it strongly, plus one
# strong:   some input refers to it strongly
# vis:      the merged visibility of every symbol of the name
# size:     the largest size of its commons
# align:    the largest alignment of its commons
# weak:     the first weak reference to it that names a fallback, plus one in
#           its input, and that reference's symbol
# fell:     the bound definition is its fallback's
# copy:     the bound definition is a copy of a group its name signs
# alias:    the name is the base name the bound default version answers
# spelled:  whether symbols reach it by a plain name or a versioned one, zero
#           before any does
# bound:    the link defines it, at the place of this row of the format's
#           bound symbols, while no input does
rec Slot {
    seen:     bool;
    defined:  bool;
    common:   bool;
    regular:  bool;
    wanted:   bool;
    has:      bool;
    rank:     u8;
    unique:   bool;
    input:    Id[Input];
    symbol:   Id[Symbol];
    library:  opt[Id[Name]];
    referred: u32;
    strong:   bool;
    vis:      *Visibility;
    size:     u64;
    align:    u64;
    weak:     u32;
    weak_sym: Id[Symbol];
    fell:     bool;
    copy:     bool;
    alias:    bool;
    spelled:  u8;
    bound:    *Bound;
}

# how symbols reach a slot
val PLAIN_SPELLED:     u8 = 1;
val VERSIONED_SPELLED: u8 = 2;

# the byte that parts a name from its version in a link name
val AT: u8 = '@';

# the names a symbol of an object resolves under
# ---
# own:  its link name, which its relocations bind through
# bare: the base name a default version's definition also answers, none for
#       any other symbol
rec Keys {
    own:  Id[Name];
    bare: opt[Id[Name]];
}

# a key a member of an archive is found by
# ---
# key:  the key, in the archive's own keys
# next: the next of the key's members plus one, zero for its last
rec Defines {
    key:    Id[Name];
    member: Id[contract.Member];
    next:   u32;
}

# an archive of the link and the members each name finds in it
# ---
# keyed:   whether its keys are taken, from its index or by reading its
#          members when it has none
# keys:    every link name some member of it is found by
# defines: each key's members, in the order its index or its members name them
# heads:   each key's first in defines plus one, indexed by the key's id
rec Archive {
    input:   Id[Input];
    members: Table[contract.Member];
    loaded:  Vector[bool];
    keyed:   bool;
    keys:    Interner;
    defines: Vector[Defines];
    heads:   Vector[u32];
}

# a copy of a group signature
rec Copy {
    input: Id[Input];
    group: Id[Group];
}

# a library a claim describes, made and waiting to join the link
# ---
# name:    the input's name, the library's loader name
# object:  the library, which the link owns from when it is made
# include: whether the image loads it when no live import references it
rec Described {
    name:    str;
    object:  Object;
    include: Include;
}

# what a hook reads, and the phase's own state
# ---
# in:        the phase's input
# out:       the phase's output
# slots:     what the phase knows of each name, by the link's name id
# order:     each name in the order first seen
# pending:   the names queued for an archive search
# offers:    each name a shared library offers, and its loader name
# archives:  each archive of the link, in the order it was met
# refs:      each input's strong reference to a name, and each weak one no
#            fallback resolves, before the undefined are picked out
# stays:     per symbol of the input being bound, a staying import names it
# loaders:   per loader name, the first library input of it plus one
# indexed:   how many inputs loaders has indexed
# states:    per input, where a walk of re-exports stands: zero unseen, one
#            on the way and two done
# walked:    the inputs the walk of re-exports marked
# claimed:   the bytes of each claim that made a described library
# providers: per link name, the loader name of the described library that
#            provides it, plus one, zero for none
# pulled:    per input pulled from an archive, its place in command line
#            order, zero for an input given where it stands
pub rec Context {
    in:        *In;
    out:       *Resolved;
    slots:     Vector[Slot];
    order:     Vector[Id[Name]];
    pending:   Vector[Id[Name]];
    offers:    Table[Import];
    archives:  Table[Archive];
    refs:      Vector[Reference];
    stays:     Vector[bool];
    loaders:   Vector[u32];
    indexed:   usize;
    states:    Vector[u8];
    walked:    Vector[u32];
    claimed:   Interner;
    providers: Vector[u32];
    pulled:    Vector[u64];
}

# the rank of a definition: a shared library's lowest, then a weak
# definition, a common block and a strong definition. a weak definition does
# not displace a common one, as the System V ABI states under symbol binding.
# the link's own definition of a bound name ranks below them all, so any
# input's definition displaces it
val LINKED:  u8 = 0;
val OFFERED: u8 = 1;
val WEAK:    u8 = 2;
val COMMON:  u8 = 3;
val STRONG:  u8 = 4;

# an empty resolution, before the phase runs
# ---
# a:   the allocator its tables grow in
# ret: the record, owned by the caller and released with dnit
pub fun init(a: *A.Allocator) Resolved {
    ret Resolved{
        bindings:  table.init[Binding](a),
        imports:   table.init[Import](a),
        members:   vector.init[Member](a),
        named:     vector.init[u32](a),
        commons:   vector.init[Storage](a),
        kept:      vector.init[bool](a),
        firsts:    vector.init[u32](a),
        clashes:   vector.init[Clash](a),
        undefined: vector.init[Reference](a),
        libraries: vector.init[bool](a),
        links:     vector.init[u32](a),
        starts:    vector.init[u32](a),
        linked:    table.init[Linked](a),
        linking:   vector.init[u32](a),
        lent:      vector.init[Id[Input]](a),
        lending:   vector.init[Lending](a),
        spelled:   vector.init[u8](a),
    };
}

# resolve the inputs: load them and search the archives, keep one copy of
# each group, bind every name, compare the copies unloaded members hold, then
# publish the answers into `out`
# ---
# in:  what the phase reads, whose inputs pulled members join
# out: the resolution, filled
# ret: the first refusal, a clash or an undefined reference the output kind
#      does not keep, its holders written to the notes
pub fun run(in: *In, out: *Resolved) err[Fail] {
    val a: *A.Allocator = in.inputs.a;
    var c: Context      = Context{
        in:        in,
        out:       out,
        slots:     vector.init[Slot](a),
        order:     vector.init[Id[Name]](a),
        pending:   vector.init[Id[Name]](a),
        offers:    table.init[Import](a),
        archives:  table.init[Archive](a),
        refs:      vector.init[Reference](a),
        stays:     vector.init[bool](a),
        loaders:   vector.init[u32](a),
        states:    vector.init[u8](a),
        walked:    vector.init[u32](a),
        claimed:   intern.init(a),
        providers: vector.init[u32](a),
        pulled:    vector.init[u64](a),
    };
    val err_resolve: err[Fail] = resolve(?c);
    val err_drop:    err[Fail] = context_dnit(?c);
    if (sel err_resolve.err) { ret err_resolve; }
    ret err_drop;
}

# ask the archives for the member that defines `name`, as a reference would,
# without the link needing it: a name nothing defines stays undefined and
# refuses nothing. the asked hook calls it
pub fun ask(c: *Context, name: Id[Name]) err[Fail] {
    val res_slot_of: res[*Slot, Fail] = slot_of(c, name);
    if (sel res_slot_of.err)   { ret err[Fail].err{res_slot_of.err}; }
    if (res_slot_of.ok.wanted) { ret err[Fail].ok{}; }
    res_slot_of.ok.wanted = true;
    val err_pushed: err[Fail] = vectors.push[Id[Name]](?c.pending, name);
    if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
    ret err[Fail].ok{};
}

# offer `name`, which the shared library `library` defines, to the link. the
# library hook calls it for each name a library input exports
pub fun offer(c: *Context, name: Id[Name], library: Id[Name]) err[Fail] {
    val res_slot_of: res[*Slot, Fail] = slot_of(c, name);
    if (sel res_slot_of.err) { ret err[Fail].err{res_slot_of.err}; }
    res_slot_of.ok.defined = true;
    val res_pushed: res[Id[Import], Fail] = table.push[Import](?c.offers, Import{name: name, library: library});
    if (sel res_pushed.err) { ret err[Fail].err{res_pushed.err}; }
    ret err[Fail].ok{};
}

# whether the input `id` describes a shared library, offering each symbol it
# exports under the library's loader name when it does: under the names it
# resolves under, so a versioned reference finds its version and an
# unversioned one only the default version. a library offering one name at
# several versions offers each under its own versioned name
pub fun shared(c: *Context, id: Id[Input]) res[bool, Fail] {
    val o: *Object = input.object_of(c.in.inputs, id);
    if (sel o.library.none) { ret res[bool, Fail].ok{false}; }
    val res_lib: res[Id[Name], Fail] = loader(c.in.inputs, c.in.names, id);
    if (sel res_lib.err) { ret res[bool, Fail].err{res_lib.err}; }
    val err_own: err[Fail] = offer_all(c, id, res_lib.ok);
    if (sel err_own.err) { ret res[bool, Fail].err{err_own.err}; }
    val err_reexports: err[Fail] = reexports(c, id, res_lib.ok);
    if (sel err_reexports.err) { ret res[bool, Fail].err{err_reexports.err}; }
    ret res[bool, Fail].ok{true};
}

# offer each symbol the shared library `id` exports under the loader name
# `lib`
fun offer_all(c: *Context, id: Id[Input], lib: Id[Name]) err[Fail] {
    val o: *Object = input.object_of(c.in.inputs, id);
    var k: usize   = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val sym: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
        k = k + 1;
        if (!object.offers(sym)) { cnt; }
        val res_keys_of: res[Keys, Fail] = keys_of(c, o, sym);
        if (sel res_keys_of.err) { ret err[Fail].err{fail.in_indexed(res_keys_of.err, "symbol", (k - 1)::u64)}; }
        val err_offer: err[Fail] = offer(c, res_keys_of.ok.own, lib);
        if (sel err_offer.err) { ret err_offer; }
        val opt_bare: opt[Id[Name]] = res_keys_of.ok.bare;
        if (sel opt_bare.none) { cnt; }
        val err_offer_some: err[Fail] = offer(c, opt_bare.some, lib);
        if (sel err_offer_some.err) { ret err_offer_some; }
    }
    ret err[Fail].ok{};
}

# offer the exports of every library the shared library `id` re-exports
# under its own loader name `lib`, as an image binds them through the library
# it loads, and those of the libraries they re-export in turn. a re-exported
# library is the library input whose loader name its dependency names, and
# one no input describes offers nothing. a re-export that leads back to a
# library on its way is refused
fun reexports(c: *Context, id: Id[Input], lib: Id[Name]) err[Fail] {
    val err_index_loaders: err[Fail] = index_loaders(c);
    if (sel err_index_loaders.err) { ret err_index_loaders; }
    val states: usize = vector.length[u8](?c.states);
    val n:      usize = input.count(c.in.inputs);
    if (n > states) {
        val err_grow: err[Fail] = vectors.grow[u8](?c.states, n - states);
        if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    }
    vector.clear[u32](?c.walked);
    val first:          usize     = vector.length[Id[Input]](?c.out.lent);
    val err_reexported: err[Fail] = reexported(c, id, lib);
    var i:              usize     = 0;
    for (i < vector.length[u32](?c.walked)) {
        c.states.data[c.walked.data[i]::usize] = 0;
        i                                      = i + 1;
    }
    if (sel err_reexported.err) {
        vectors.truncate[Id[Input]](?c.out.lent, first);
        ret err_reexported;
    }
    val count: usize = vector.length[Id[Input]](?c.out.lent) - first;
    if (count == 0) { ret err[Fail].ok{}; }
    val runs: usize = vector.length[Lending](?c.out.lending);
    if (id.index::usize >= runs) {
        val err_grow: err[Fail] = vectors.grow[Lending](?c.out.lending, id.index::usize + 1 - runs);
        if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    }
    c.out.lending.data[id.index::usize] = Lending{first: first::u32, count: count::u32};
    ret err[Fail].ok{};
}

# the libraries the library `id` re-exports, offered under `lib`, `id` on the
# way while they are
fun reexported(c: *Context, id: Id[Input], lib: Id[Name]) err[Fail] {
    val at: *u8 = ?c.states.data[id.index::usize];
    if (@at == 1) { ret err[Fail].err{fail.in_file(fail.malformed("re-exported libraries form a cycle"), input.at(c.in.inputs, id).name)}; }
    if (@at == 2) { ret err[Fail].ok{}; }
    @at = 1;
    val err_walked_pushed: err[Fail] = vectors.push[u32](?c.walked, id.index);
    if (sel err_walked_pushed.err) { ret err[Fail].err{err_walked_pushed.err}; }
    val o: *Object = input.object_of(c.in.inputs, id);
    var k: usize   = 0;
    for (k < table.count[object.Dependency](?o.libraries)) {
        val d: *object.Dependency = table.at[object.Dependency](?o.libraries, table.nth[object.Dependency](k));
        k = k + 1;
        if (!d.reexports) { cnt; }
        val opt_named: opt[Id[Name]] = d.library.loader;
        if (sel opt_named.none) { cnt; }
        val text:     View          = object.name_of(o, opt_named.some);
        val opt_find: opt[Id[Name]] = intern.find(c.in.names, text.data, text.len);
        if (sel opt_find.none) { cnt; }
        val by: u32 = loader_input(c, opt_find.some);
        if (by == 0) { cnt; }
        val dep:   Id[Input] = table.nth[Input]((by - 1)::usize);
        val state: u8        = c.states.data[dep.index::usize];
        if (state == 2) { cnt; }
        if (state == 0) {
            val err_lent_pushed: err[Fail] = vectors.push[Id[Input]](?c.out.lent, dep);
            if (sel err_lent_pushed.err) { ret err[Fail].err{err_lent_pushed.err}; }
            val err_offer_all: err[Fail] = offer_all(c, dep, lib);
            if (sel err_offer_all.err) { ret err[Fail].err{fail.in_file(err_offer_all.err, input.at(c.in.inputs, dep).name)}; }
        }
        val err_reexported: err[Fail] = reexported(c, dep, lib);
        if (sel err_reexported.err) { ret err_reexported; }
    }
    c.states.data[id.index::usize] = 2;
    ret err[Fail].ok{};
}

# the library input whose loader name is `n`, plus one, zero for none
fun loader_input(c: *Context, n: Id[Name]) u32 {
    if (n.index::usize >= vector.length[u32](?c.loaders)) { ret 0; }
    ret c.loaders.data[n.index::usize];
}

# index every library input of the link by its loader name, the first of
# several that describe one library, each input once as it is first met
fun index_loaders(c: *Context) err[Fail] {
    val n: usize = input.count(c.in.inputs);
    var i: usize = c.indexed;
    for (i < n) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(c.in.inputs, id);
        i = i + 1;
        if (o == nil || sel o.library.none) { cnt; }
        val res_lib: res[Id[Name], Fail] = loader(c.in.inputs, c.in.names, id);
        if (sel res_lib.err) { ret err[Fail].err{res_lib.err}; }
        val have: usize = vector.length[u32](?c.loaders);
        if (res_lib.ok.index::usize >= have) {
            val err_grow: err[Fail] = vectors.grow[u32](?c.loaders, res_lib.ok.index::usize + 1 - have);
            if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
        }
        val slot: *u32 = ?c.loaders.data[res_lib.ok.index::usize];
        if (@slot == 0) { @slot = i::u32; }
    }
    c.indexed = n;
    ret err[Fail].ok{};
}

# the name the loader knows the shared library `id` by: the one it states, or
# when it states none, as an ELF library without a DT_SONAME, its file's name
# when a search found it and the name it was given by otherwise
pub fun loader(inputs: *Inputs, names: *Interner, id: Id[Input]) res[Id[Name], Fail] {
    val o:         *Object             = input.object_of(inputs, id);
    var opt_known: opt[object.Library] = opt[object.Library].none{};
    if (o != nil) { opt_known = o.library; }
    if (sel opt_known.none) {
        ret res[Id[Name], Fail].err{fail.in_file(fail.internal("an input that is no shared library has no loader name"), input.at(inputs, id).name)};
    }
    val opt_stated: opt[Id[Name]] = opt_known.some.loader;
    val e:          *Input        = input.at(inputs, id);
    if (sel opt_stated.none && e.searched) { ret intern.intern_str(names, filename(e.name)); }
    if (sel opt_stated.none)               { ret intern.intern_str(names, e.name); }
    val text: View = object.name_of(o, opt_stated.some);
    ret intern.intern(names, text.data, text.len);
}

# the link's own definition of `name`, none when an input defines it or
# nothing does
pub fun linked_of(r: *Resolved, name: Id[Name]) opt[*Linked] {
    val opt_linked_at: opt[Id[Linked]] = linked_at(r, name);
    if (sel opt_linked_at.none) { ret opt[*Linked].none{}; }
    ret opt[*Linked].some{table.at[Linked](?r.linked, opt_linked_at.some)};
}

# where the link's own definition of `name` lies among the names it defines,
# none when an input defines it or nothing does
pub fun linked_at(r: *Resolved, name: Id[Name]) opt[Id[Linked]] {
    if (name.index::usize >= vector.length[u32](?r.linking)) { ret opt[Id[Linked]].none{}; }
    val at: u32 = r.linking.data[name.index];
    if (at == 0) { ret opt[Id[Linked]].none{}; }
    ret opt[Id[Linked]].some{table.nth[Linked](at::usize - 1)};
}

# whether some name the link defines itself lies at an output section
pub fun sectioned(r: *Resolved) bool {
    var i: usize = 0;
    for (i < table.count[Linked](?r.linked)) {
        if (boundary.by_section(table.items[Linked](?r.linked)[i].bound.place)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# settle where each name the link defines at an output section lies: at its
# row's place when `landed` marks the section, by the section's name id. a
# name whose section no kept section is laid into is left undefined when only
# weak references reach it, as the gABI resolves an undefined weak
# reference. a strong reference to one takes the kind `naming` gives the
# section's name, and layout binds it to an empty range where that section
# would land. one whose section's name `naming` gives no kind is refused, the
# section named to `notes`, and the refusal leaves `r` as it was
pub fun unplaced(r: *Resolved, names: *Interner, landed: *Vector[bool], naming: opt[*Naming], notes: *Sink) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Linked](?r.linked)) {
        val ln: Linked = table.items[Linked](?r.linked)[i];
        i = i + 1;
        if (ln.weak || stands(landed, ln)) { cnt; }
        if (sel ln.section.none)           { ret err[Fail].err{fail.in_record(fail.internal("a bound symbol at an output section names none"), ln.bound.name)}; }
        val opt_kind: opt[*section.Kind] = missing_kind(names, naming, ln.section.some);
        if (sel opt_kind.some) { cnt; }
        val sec:            View      = intern.bytes_of(names, ln.section.some);
        val err_note_named: err[Fail] = diag.note_named(Location{}, sec, "a bound symbol names the output section {}, which the image does not hold and whose name the format gives no kind", notes);
        if (sel err_note_named.err) { ret err_note_named; }
        ret err[Fail].err{fail.in_record(fail.malformed("a bound symbol names an output section the image does not hold, of no kind the format's naming gives"), ln.bound.name)};
    }
    var kept: usize = 0;
    i = 0;
    for (i < table.count[Linked](?r.linked)) {
        var ln: Linked = table.items[Linked](?r.linked)[i];
        i = i + 1;
        if (!stands(landed, ln) && ln.weak) {
            r.linking.data[ln.name.index] = 0;
            cnt;
        }
        if (sel ln.section.some) {
            if (!stands(landed, ln)) { ln.missing = missing_kind(names, naming, ln.section.some); }
        }
        table.items[Linked](?r.linked)[kept] = ln;
        kept                                 = kept + 1;
        r.linking.data[ln.name.index]        = kept::u32;
    }
    table.truncate[Linked](?r.linked, kept);
    ret err[Fail].ok{};
}

# the kind `naming` gives the output section named `name`, none where the
# format names no sections or gives the name no kind
fun missing_kind(names: *Interner, naming: opt[*Naming], name: Id[Name]) opt[*section.Kind] {
    if (sel naming.none) { ret opt[*section.Kind].none{}; }
    val text:    View             = intern.bytes_of(names, name);
    val opt_key: opt[section.Key] = naming.some.kind_of(Bytes{data: text.data, len: text.len});
    if (sel opt_key.none) { ret opt[*section.Kind].none{}; }
    ret opt[*section.Kind].some{opt_key.some.kind};
}

# whether the place of `ln` stands: anywhere but at an output section, or
# at one `landed` marks by its name
fun stands(landed: *Vector[bool], ln: Linked) bool {
    if (sel ln.section.none) { ret true; }
    val at: usize = ln.section.some.index::usize;
    ret at < vector.length[bool](landed) && landed.data[at];
}

# the winning definition of `name`, none when nothing defines it in an object
pub fun bound(r: *Resolved, name: Id[Name]) opt[Won] {
    if (name.index::usize >= vector.length[u32](?r.named)) { ret opt[Won].none{}; }
    val at: u32 = r.named.data[name.index];
    if (at == 0) { ret opt[Won].none{}; }
    val id: Id[Binding] = Id[Binding]{index: at - 1};
    ret opt[Won].some{Won{id: id, binding: table.at[Binding](?r.bindings, id)}};
}

# the winning definition of what the symbol `s` of the input `in` names, none
# for a local symbol or a name nothing defines in an object
pub fun winning(r: *Resolved, in: Id[Input], s: Id[Symbol]) opt[Won] {
    val opt_link_name: opt[Id[Name]] = link_name(r, in, s);
    if (sel opt_link_name.none) { ret opt[Won].none{}; }
    ret bound(r, opt_link_name.some);
}

# whether the section `s` of `in`, an input the phase resolved, is kept: it
# is in no group or in a group whose copy was kept
pub fun keeps(r: *Resolved, in: Id[Input], s: *Section) bool {
    val opt_group: opt[Id[Group]] = s.group;
    if (sel opt_group.none) { ret true; }
    val first: u32 = r.firsts.data[in.index];
    ret r.kept.data[first + opt_group.some.index];
}

# whether the symbol `sym` of `in`, an input the phase resolved, is kept: it
# starts no atom copy, or one of a group whose copy was kept
pub fun keeps_symbol(r: *Resolved, in: Id[Input], sym: *Symbol) bool {
    val opt_group: opt[Id[Group]] = sym.group;
    if (sel opt_group.none) { ret true; }
    val first: u32 = r.firsts.data[in.index];
    ret r.kept.data[first + opt_group.some.index];
}

# whether the input `in` is a shared library
pub fun library(r: *Resolved, in: Id[Input]) bool {
    if (in.index::usize >= vector.length[bool](?r.libraries)) { ret false; }
    ret r.libraries.data[in.index];
}

# the link name the symbol `s` of the object input `in` resolves under, none
# for a local symbol
pub fun link_name(r: *Resolved, in: Id[Input], s: Id[Symbol]) opt[Id[Name]] {
    if (in.index::usize >= vector.length[u32](?r.starts)) { ret opt[Id[Name]].none{}; }
    val at: usize = r.starts.data[in.index]::usize + s.index::usize;
    if (at >= vector.length[u32](?r.links)) { ret opt[Id[Name]].none{}; }
    val n: u32 = r.links.data[at];
    if (n == 0) { ret opt[Id[Name]].none{}; }
    ret opt[Id[Name]].some{Id[Name]{index: n - 1}};
}

# release everything the resolution owns
# ---
# r:   the resolution
# ret: the first failure releasing its tables, after every one is released
pub fun dnit(r: *Resolved) err[Fail] {
    var err_first: err[Fail] = table.dnit[Binding](?r.bindings);
    err_first = fail.kept(err_first, table.dnit[Import](?r.imports));
    err_first = fail.kept(err_first, vectors.dnit[Member](?r.members));
    err_first = fail.kept(err_first, vectors.dnit[u32](?r.named));
    err_first = fail.kept(err_first, vectors.dnit[Storage](?r.commons));
    err_first = fail.kept(err_first, vectors.dnit[bool](?r.kept));
    err_first = fail.kept(err_first, vectors.dnit[u32](?r.firsts));
    err_first = fail.kept(err_first, vectors.dnit[Clash](?r.clashes));
    err_first = fail.kept(err_first, vectors.dnit[Reference](?r.undefined));
    err_first = fail.kept(err_first, vectors.dnit[bool](?r.libraries));
    err_first = fail.kept(err_first, vectors.dnit[u32](?r.links));
    err_first = fail.kept(err_first, vectors.dnit[u32](?r.starts));
    err_first = fail.kept(err_first, table.dnit[Linked](?r.linked));
    err_first = fail.kept(err_first, vectors.dnit[u32](?r.linking));
    err_first = fail.kept(err_first, vectors.dnit[Id[Input]](?r.lent));
    err_first = fail.kept(err_first, vectors.dnit[u8](?r.spelled));
    ret fail.kept(err_first, vectors.dnit[Lending](?r.lending));
}

# the library inputs whose exports the shared library `id` offers as its own,
# the libraries it re-exports and theirs in turn
pub fun lent_of(r: *Resolved, id: Id[Input]) Lending {
    if (id.index::usize >= vector.length[Lending](?r.lending)) { ret Lending{}; }
    ret r.lending.data[id.index::usize];
}

# the phase's passes in order: load, choose groups, bind, compare unloaded
# copies and finish
fun resolve(c: *Context) err[Fail] {
    val err_load: err[Fail] = load(c);
    if (sel err_load.err) { ret err_load; }
    val err_choose_groups: err[Fail] = choose_groups(c);
    if (sel err_choose_groups.err) { ret err_choose_groups; }
    val err_bind: err[Fail] = bind(c);
    if (sel err_bind.err) { ret err_bind; }
    val err_unloaded: err[Fail] = unloaded_copies(c);
    if (sel err_unloaded.err) { ret err_unloaded; }
    ret finish(c);
}

# release the phase's own state, every archive's tables with it
fun context_dnit(c: *Context) err[Fail] {
    var err_first: err[Fail] = err[Fail].ok{};
    var i:         usize     = 0;
    for (i < table.count[Archive](?c.archives)) {
        val arc: *Archive = table.at[Archive](?c.archives, table.nth[Archive](i));
        err_first = fail.kept(err_first, table.dnit[contract.Member](?arc.members));
        err_first = fail.kept(err_first, vectors.dnit[bool](?arc.loaded));
        err_first = fail.kept(err_first, intern.dnit(?arc.keys));
        err_first = fail.kept(err_first, vectors.dnit[Defines](?arc.defines));
        err_first = fail.kept(err_first, vectors.dnit[u32](?arc.heads));
        i         = i + 1;
    }
    err_first = fail.kept(err_first, table.dnit[Archive](?c.archives));
    err_first = fail.kept(err_first, vectors.dnit[Slot](?c.slots));
    err_first = fail.kept(err_first, vectors.dnit[Id[Name]](?c.order));
    err_first = fail.kept(err_first, vectors.dnit[Id[Name]](?c.pending));
    err_first = fail.kept(err_first, table.dnit[Import](?c.offers));
    err_first = fail.kept(err_first, vectors.dnit[Reference](?c.refs));
    err_first = fail.kept(err_first, vectors.dnit[bool](?c.stays));
    err_first = fail.kept(err_first, vectors.dnit[u32](?c.loaders));
    err_first = fail.kept(err_first, vectors.dnit[u8](?c.states));
    err_first = fail.kept(err_first, vectors.dnit[u32](?c.walked));
    err_first = fail.kept(err_first, intern.dnit(?c.claimed));
    err_first = fail.kept(err_first, vectors.dnit[u64](?c.pulled));
    ret fail.kept(err_first, vectors.dnit[u32](?c.providers));
}

# the slot of `name`, the table growing to hold it and the order taking it
# when it is new. the slot stays where it is until the next slot is made
fun slot_of(c: *Context, name: Id[Name]) res[*Slot, Fail] {
    val have: usize = vector.length[Slot](?c.slots);
    if (name.index::usize >= have) {
        val err_grown: err[Fail] = vectors.grow[Slot](?c.slots, name.index::usize + 1 - have);
        if (sel err_grown.err) { ret res[*Slot, Fail].err{err_grown.err}; }
    }
    val s: *Slot = ?c.slots.data[name.index::usize];
    if (!s.seen) {
        val err_pushed: err[Fail] = vectors.push[Id[Name]](?c.order, name);
        if (sel err_pushed.err) { ret res[*Slot, Fail].err{err_pushed.err}; }
        s.seen = true;
    }
    ret res[*Slot, Fail].ok{s};
}

fun slot_at(c: *Context, name: Id[Name]) *Slot {
    ret ?c.slots.data[name.index::usize];
}

# run the format's asked hook, take every input given where it stands, then
# where the format revisits archives, search them all again until none pulls
# a member
fun load(c: *Context) err[Fail] {
    val err_asked: err[Fail] = c.in.hooks.asked(c);
    if (sel err_asked.err) { ret err_asked; }
    val revisit: bool  = (c.in.search & REVISIT) != 0;
    val given:   usize = input.count(c.in.inputs);
    var i:       usize = 0;
    for (i < given) {
        val err_entered: err[Fail] = entered(c, table.nth[Input](i));
        if (sel err_entered.err) { ret err_entered; }
        i = i + 1;
    }
    if (!revisit) { ret err[Fail].ok{}; }
    for {
        var progress: bool  = false;
        var k:        usize = 0;
        for (k < table.count[Archive](?c.archives)) {
            val res_search: res[bool, Fail] = search(c, table.nth[Archive](k));
            if (sel res_search.err) { ret err[Fail].err{res_search.err}; }
            if (res_search.ok)      { progress = true; }
            k = k + 1;
        }
        if (!progress) { brk; }
    }
    ret err[Fail].ok{};
}

# take the input `id` where it stands: an archive enlisted, and searched
# there unless every archive is searched again as one group, and any other
# input noted
fun entered(c: *Context, id: Id[Input]) err[Fail] {
    val e: *Input = input.at(c.in.inputs, id);
    if (sel e.content.container) {
        val res_arc: res[Id[Archive], Fail] = enlist(c, id);
        if (sel res_arc.err)              { ret err[Fail].err{res_arc.err}; }
        if ((c.in.search & REVISIT) != 0) { ret err[Fail].ok{}; }
        val res_search: res[bool, Fail] = search(c, res_arc.ok);
        if (sel res_search.err) { ret err[Fail].err{res_search.err}; }
        ret err[Fail].ok{};
    }
    ret note(c, id);
}

# note what the input `id` defines and refers to, and join what its claims
# name
fun note(c: *Context, id: Id[Input]) err[Fail] {
    val have: usize = vector.length[bool](?c.out.libraries);
    if (id.index::usize >= have) {
        val err_grown: err[Fail] = vectors.grow[bool](?c.out.libraries, id.index::usize + 1 - have);
        if (sel err_grown.err) { ret err[Fail].err{err_grown.err}; }
    }
    val name:    str             = input.at(c.in.inputs, id).name;
    val res_lib: res[bool, Fail] = c.in.hooks.library(c, id);
    if (sel res_lib.err) { ret err[Fail].err{fail.in_file(res_lib.err, name)}; }
    c.out.libraries.data[id.index] = res_lib.ok;
    if (res_lib.ok) { ret err[Fail].ok{}; }
    val o: *Object = input.object_of(c.in.inputs, id);
    var k: usize   = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val sym:             *Symbol   = object.symbol_at(o, table.nth[Symbol](k));
        val err_note_symbol: err[Fail] = note_symbol(c, o, sym);
        if (sel err_note_symbol.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(err_note_symbol.err, "symbol", k::u64), name)}; }
        k = k + 1;
    }
    ret claimed(c, id);
}

# join what each claim of the object input `id` names, as though the link
# stated it right after the input: each claim is found or described first,
# then each file found enters and is taken where it stands, its own claims
# joined in turn, then each library described. an input pulled from an
# archive is noted only once it is pulled, so a member the link never pulls
# claims nothing
fun claimed(c: *Context, id: Id[Input]) err[Fail] {
    val a:             *A.Allocator      = c.in.inputs.a;
    var found:         Vector[Source]    = vector.init[Source](a);
    var symbols:       Vector[Provided]  = vector.init[Provided](a);
    var made:          Vector[Described] = vector.init[Described](a);
    var err_claims_of: err[Fail]         = claims_of(c, id, ?found, ?symbols, ?made);
    err_claims_of = fail.kept(err_claims_of, vectors.dnit[Provided](?symbols));
    val read: bool = sel err_claims_of.ok;
    if (read) { err_claims_of = joined(c, ?found); }
    err_claims_of = fail.kept(err_claims_of, vectors.dnit[Source](?found));
    err_claims_of = fail.kept(err_claims_of, described_joined(c, ?made, sel err_claims_of.ok));
    if (sel err_claims_of.err) { ret err[Fail].err{fail.in_file(err_claims_of.err, input.at(c.in.inputs, id).name)}; }
    ret err_claims_of;
}

# find what each claim of the object input `id` names into `found`, and make
# each library a claim describes into `made`, the claims' symbols read into
# `symbols`. no input enters while the object's sections are read
fun claims_of(c: *Context, id: Id[Input], found: *Vector[Source], symbols: *Vector[Provided], made: *Vector[Described]) err[Fail] {
    val o: *Object = input.object_of(c.in.inputs, id);
    var i: usize   = 0;
    for (i < table.count[Section](?o.sections)) {
        val s: *Section = object.section_at(o, table.nth[Section](i));
        i = i + 1;
        if (!claim.holds(o, s)) { cnt; }
        val err_section_claims: err[Fail] = section_claims(c, o, s, (i - 1)::u64, found, symbols, made);
        if (sel err_section_claims.err) { ret err_section_claims; }
    }
    ret err[Fail].ok{};
}

# the claims of the section `s`, the `index`th of `o`. a record that does not
# read is placed at its index, and a library that is not found or described
# is named by its failure, as every object carries the claims of its link and
# the one that met it first is no cause
fun section_claims(c: *Context, o: *Object, s: *Section, index: u64, found: *Vector[Source], symbols: *Vector[Provided], made: *Vector[Described]) err[Fail] {
    val res_records: res[claim.Records, Fail] = claim.records(o, s);
    if (sel res_records.err) { ret err[Fail].err{fail.in_indexed(res_records.err, "section", index)}; }
    var records: claim.Records = res_records.ok;
    for {
        val at:       u64             = records.index;
        var one:      Claim           = Claim{};
        val res_more: res[bool, Fail] = claim.next(?records, ?one, symbols);
        if (sel res_more.err) { ret err[Fail].err{fail.in_indexed(res_more.err, "claim", at)}; }
        if (!res_more.ok)     { brk; }
        val opt_describer_of: opt[*Describer] = describer_of(c, ?one);
        if (sel opt_describer_of.some) {
            val err_describe: err[Fail] = describe(c, opt_describer_of.some, ?one, made);
            if (sel err_describe.err) { ret err_describe; }
            cnt;
        }
        val opt_finder: opt[*Claimant] = c.in.claimant;
        if (sel opt_finder.none) { ret err[Fail].err{fail.in_indexed(fail.unsupported("the link finds nothing a claim names"), "claim", at)}; }
        val err_find: err[Fail] = opt_finder.some.find(opt_finder.some.context, ?one, found);
        if (sel err_find.err) { ret err_find; }
    }
    ret err[Fail].ok{};
}

# the format's describer where the claim `cl` names a shared system library
# and the format describes one, none where the claim names a file
fun describer_of(c: *Context, cl: *Claim) opt[*Describer] {
    val opt_describes: opt[*Describer] = c.in.hooks.describes;
    if (sel opt_describes.none) { ret opt_describes; }
    if (!(sel cl.form.system))  { ret opt[*Describer].none{}; }
    val opt_kind: opt[claim.LibraryKind] = cl.kind;
    if (sel opt_kind.some && sel opt_kind.some.shared) { ret opt_describes; }
    ret opt[*Describer].none{};
}

# make the library the claim `cl` describes into `made`, unless a claim of
# the same bytes made it before. a symbol a described library of another
# loader name provides is refused, naming the symbol and both libraries to
# the notes
fun describe(c: *Context, by: *Describer, cl: *Claim, made: *Vector[Described]) err[Fail] {
    val before:  usize               = intern.count(?c.claimed);
    val res_key: res[Id[Name], Fail] = intern.intern(?c.claimed, cl.record.data, cl.record.len);
    if (sel res_key.err)                    { ret err[Fail].err{res_key.err}; }
    if (intern.count(?c.claimed) == before) { ret err[Fail].ok{}; }
    val err_provided: err[Fail] = providing(c, cl);
    if (sel err_provided.err) { ret err_provided; }
    val res_named: res[str, Fail] = input.text(c.in.inputs, cl.name);
    if (sel res_named.err) { ret err[Fail].err{res_named.err}; }
    var o:            Object    = object.init(c.in.inputs.a, c.in.arch, ?kind.STUB);
    val err_describe: err[Fail] = by.describe(?o, cl, c.in.host);
    if (sel err_describe.err) {
        val err_dropped: err[Fail] = object.dnit(?o);
        ret err[Fail].err{fail.about(err_describe.err, res_named.ok)};
    }
    var include: Include = Include.always{};
    if (cl.referenced) { include = Include.referenced{}; }
    val err_made_pushed: err[Fail] = vectors.push[Described](made, Described{name: res_named.ok, object: o, include: include});
    if (sel err_made_pushed.err) {
        val err_dropped: err[Fail] = object.dnit(?o);
        ret err_made_pushed;
    }
    ret err[Fail].ok{};
}

# record the loader name of the library `cl` describes as the provider of
# each symbol it provides, refusing a symbol another loader name provides
fun providing(c: *Context, cl: *Claim) err[Fail] {
    val res_lib: res[Id[Name], Fail] = intern.intern(c.in.names, cl.name.data, cl.name.len);
    if (sel res_lib.err) { ret err[Fail].err{res_lib.err}; }
    var i: usize = 0;
    for (i < cl.symbol_count) {
        val v:          View                = cl.symbols[i].name;
        val res_intern: res[Id[Name], Fail] = intern.intern(c.in.names, v.data, v.len);
        if (sel res_intern.err) { ret err[Fail].err{res_intern.err}; }
        i = i + 1;
        val have: usize = vector.length[u32](?c.providers);
        if (res_intern.ok.index::usize >= have) {
            val err_grow: err[Fail] = vectors.grow[u32](?c.providers, res_intern.ok.index::usize + 1 - have);
            if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
        }
        val at: *u32 = ?c.providers.data[res_intern.ok.index];
        if (@at == 0) {
            @at = res_lib.ok.index + 1;
            cnt;
        }
        if (@at == res_lib.ok.index + 1) { cnt; }
        val other:          Id[Name]  = Id[Name]{index: @at - 1};
        var err_note_named: err[Fail] = diag.note_named(Location{}, intern.bytes_of(c.in.names, res_intern.ok), "{} is claimed from two libraries", c.in.notes);
        err_note_named = fail.kept(err_note_named, diag.note_named(Location{}, intern.bytes_of(c.in.names, other), "{} is one of them", c.in.notes));
        err_note_named = fail.kept(err_note_named, diag.note_named(Location{}, intern.bytes_of(c.in.names, res_lib.ok), "{} is one of them", c.in.notes));
        ret fail.kept(err[Fail].err{fail.malformed("a symbol is claimed from two libraries")}, err_note_named);
    }
    ret err[Fail].ok{};
}

# enter each library of `made` where it stands when `go`, each the set's from
# when it enters, and give back every one that does not enter
fun described_joined(c: *Context, made: *Vector[Described], go: bool) err[Fail] {
    var err_kept: err[Fail] = err[Fail].ok{};
    var k:        usize     = 0;
    for (k < vector.length[Described](made)) {
        val d: *Described = ?made.data[k];
        k = k + 1;
        if (!go || sel err_kept.err) {
            err_kept = fail.kept(err_kept, object.dnit(?d.object));
            cnt;
        }
        val res_inputs_taken: res[Id[Input], Fail] = input.take(c.in.inputs, d.name, d.object, opt[Id[Model]].none{});
        if (sel res_inputs_taken.err) {
            err_kept = err[Fail].err{res_inputs_taken.err};
            cnt;
        }
        input.at(c.in.inputs, res_inputs_taken.ok).include = d.include;
        err_kept                                           = entered(c, res_inputs_taken.ok);
    }
    ret fail.kept(err_kept, vectors.dnit[Described](made));
}

# enter each file of `found` and take each input it gives where it stands
fun joined(c: *Context, found: *Vector[Source]) err[Fail] {
    var k: usize = 0;
    for (k < vector.length[Source](found)) {
        val before:     usize     = input.count(c.in.inputs);
        val err_source: err[Fail] = gather.source(?c.in.reading, ?found.data[k], c.in.inputs);
        if (sel err_source.err) { ret err_source; }
        k = k + 1;
        val after: usize = input.count(c.in.inputs);
        var i:     usize = before;
        for (i < after) {
            val err_entered: err[Fail] = entered(c, table.nth[Input](i));
            if (sel err_entered.err) { ret err_entered; }
            i = i + 1;
        }
    }
    ret err[Fail].ok{};
}

# note what the external symbol `sym` of `o` defines or refers to, under each
# name it resolves under
fun note_symbol(c: *Context, o: *Object, sym: *Symbol) err[Fail] {
    if (!symbol.binds(sym.binding, symbol.EXTERNAL)) { ret err[Fail].ok{}; }
    val res_keys_of: res[Keys, Fail] = keys_of(c, o, sym);
    if (sel res_keys_of.err) { ret err[Fail].err{res_keys_of.err}; }
    val err_note_key: err[Fail] = note_key(c, sym, res_keys_of.ok.own, sel sym.version.some);
    if (sel err_note_key.err) { ret err_note_key; }
    val opt_bare: opt[Id[Name]] = res_keys_of.ok.bare;
    if (sel opt_bare.some) { ret note_key(c, sym, opt_bare.some, false); }
    ret err[Fail].ok{};
}

# note that `sym` defines or refers to `name`
fun note_key(c: *Context, sym: *Symbol, name: Id[Name], versioned: bool) err[Fail] {
    val res_keyed: res[*Slot, Fail] = keyed(c, name, versioned);
    if (sel res_keyed.err) { ret err[Fail].err{res_keyed.err}; }
    if (!sel sym.def.undefined) {
        res_keyed.ok.defined = true;
        if (!sel sym.def.common) {
            res_keyed.ok.regular = true;
            ret err[Fail].ok{};
        }
        res_keyed.ok.common = true;
        if ((c.in.search & COMMON_PULL) == 0 || res_keyed.ok.wanted) { ret err[Fail].ok{}; }
        res_keyed.ok.wanted = true;
        val err_queued: err[Fail] = vectors.push[Id[Name]](?c.pending, name);
        if (sel err_queued.err) { ret err[Fail].err{err_queued.err}; }
        ret err[Fail].ok{};
    }
    if ((symbol.binds(sym.binding, symbol.WEAK) && !pulls(sym)) || res_keyed.ok.wanted) { ret err[Fail].ok{}; }
    res_keyed.ok.wanted = true;
    val err_pushed: err[Fail] = vectors.push[Id[Name]](?c.pending, name);
    if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
    ret err[Fail].ok{};
}

# the names `sym` of `o` resolves under. a symbol that states a version
# resolves under its name and version, spelled `name@version` as GNU tools
# spell a versioned reference, and a default version's definition answers its
# base name too, as an unversioned reference binds to the default version. a
# name or version holding `@` would spell another key, a common block has no
# version, and only a definition states a default one, so each of those is
# refused
fun keys_of(c: *Context, o: *Object, sym: *Symbol) res[Keys, Fail] {
    val res_base: res[Id[Name], Fail] = c.in.hooks.name(c, o, sym);
    if (sel res_base.err) { ret res[Keys, Fail].err{res_base.err}; }
    val opt_version: opt[object.Version] = sym.version;
    if (sel opt_version.none) { ret res[Keys, Fail].ok{Keys{own: res_base.ok, bare: opt[Id[Name]].none{}}}; }
    if (sel sym.def.common)   { ret res[Keys, Fail].err{fail.unsupported("a common symbol states a version")}; }
    val dflt: bool = opt_version.some.default;
    if (dflt && sel sym.def.undefined) { ret res[Keys, Fail].err{fail.malformed("a reference names a default version, which only a definition states")}; }
    var out:     Sink                = sink.init(c.in.inputs.a, LITTLE);
    val res_own: res[Id[Name], Fail] = versioned(c, ?out, res_base.ok, object.name_of(o, opt_version.some.name));
    val err_rel: err[Fail]           = sink.dnit(?out);
    if (sel res_own.err) { ret res[Keys, Fail].err{res_own.err}; }
    if (sel err_rel.err) { ret res[Keys, Fail].err{err_rel.err}; }
    var opt_bare: opt[Id[Name]] = opt[Id[Name]].none{};
    if (dflt) { opt_bare = opt[Id[Name]].some{res_base.ok}; }
    ret res[Keys, Fail].ok{Keys{own: res_own.ok, bare: opt_bare}};
}

# the link name of `base` at `version`, spelled through `out`
fun versioned(c: *Context, out: *Sink, base: Id[Name], version: View) res[Id[Name], Fail] {
    val b: View = intern.bytes_of(c.in.names, base);
    if (version.len == 0 || holds_at(b) || holds_at(version)) {
        ret res[Id[Name], Fail].err{fail.unsupported("a versioned symbol's name or version holds `@` or its version is empty, which spells no link name")};
    }
    val err_bytes: err[Fail] = sink.bytes(out, b.data, b.len);
    if (sel err_bytes.err) { ret res[Id[Name], Fail].err{err_bytes.err}; }
    val err_u8: err[Fail] = sink.u8(out, AT);
    if (sel err_u8.err) { ret res[Id[Name], Fail].err{err_u8.err}; }
    val err_bytes_out: err[Fail] = sink.bytes(out, version.data, version.len);
    if (sel err_bytes_out.err) { ret res[Id[Name], Fail].err{err_bytes_out.err}; }
    ret intern.intern(c.in.names, sink.data(out), sink.len(out));
}

# the base name of the link name `name`, which spells it without a version,
# `name` itself for a link name of none, and none when the link holds no
# such base name
pub fun unversioned(names: *Interner, name: Id[Name]) opt[Id[Name]] {
    val v: View  = intern.bytes_of(names, name);
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == AT) { ret intern.find(names, v.data, i); }
        i = i + 1;
    }
    ret opt[Id[Name]].some{name};
}

# whether `v` holds the byte that parts a name from its version
fun holds_at(v: View) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == AT) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the slot of `name`, which symbols reach by a versioned link name when
# `versioned` and by a plain name otherwise. a plain name that spells a
# versioned one's link name would bind both as one and is refused
fun keyed(c: *Context, name: Id[Name], versioned: bool) res[*Slot, Fail] {
    val res_slot_of: res[*Slot, Fail] = slot_of(c, name);
    if (sel res_slot_of.err) { ret res_slot_of; }
    var want: u8 = PLAIN_SPELLED;
    if (versioned) { want = VERSIONED_SPELLED; }
    val s: *Slot = res_slot_of.ok;
    if (s.spelled == 0)    { s.spelled = want; }
    or (s.spelled != want) { ret res[*Slot, Fail].err{fail.malformed("a plain symbol's name spells a versioned symbol's link name")}; }
    ret res_slot_of;
}

# whether the weak reference `sym` pulls an archive member that defines its
# name, as its fallback's search says
fun pulls(sym: *Symbol) bool {
    val opt_fallback: opt[object.Fallback] = sym.fallback;
    if (sel opt_fallback.some) { ret symbol.looks(opt_fallback.some.search, symbol.PULLS); }
    ret false;
}

# take the container `id` into the archives the phase searches
fun enlist(c: *Context, id: Id[Input]) res[Id[Archive], Fail] {
    val a:          *A.Allocator           = c.in.inputs.a;
    val res_pushed: res[Id[Archive], Fail] = table.push[Archive](?c.archives, Archive{
        input:   id,
        members: table.init[contract.Member](a),
        loaded:  vector.init[bool](a),
        keys:    intern.init(a),
        defines: vector.init[Defines](a),
        heads:   vector.init[u32](a),
    });
    if (sel res_pushed.err) { ret res_pushed; }
    val e: *Input = input.at(c.in.inputs, id);
    if (sel e.model.none) { ret res[Id[Archive], Fail].err{fail.in_file(fail.internal("a container has no model"), e.name)}; }
    val arc:        *Archive  = table.at[Archive](?c.archives, res_pushed.ok);
    val err_listed: err[Fail] = contract.members(table.at[Model](?c.in.inputs.models, e.model.some), e.name, ?arc.members);
    if (sel err_listed.err) { ret res[Id[Archive], Fail].err{err_listed.err}; }
    val err_grown: err[Fail] = vectors.grow[bool](?arc.loaded, table.count[contract.Member](?arc.members));
    if (sel err_grown.err) { ret res[Id[Archive], Fail].err{err_grown.err}; }
    ret res_pushed;
}

# pull from the archive `aid` every member that defines a name some loaded
# input refers to strongly and none defines, until none is left to pull. where
# the format pulls for commons, a name only commons define pulls the members
# that define it as data. true when it pulled any
fun search(c: *Context, aid: Id[Archive]) res[bool, Fail] {
    var found:        Vector[Id[contract.Member]] = vector.init[Id[contract.Member]](c.in.inputs.a);
    val res_searched: res[bool, Fail]             = searched(c, aid, ?found);
    val err_rel:      err[Fail]                   = vectors.dnit[Id[contract.Member]](?found);
    if (sel res_searched.err) { ret res_searched; }
    if (sel err_rel.err)      { ret res[bool, Fail].err{err_rel.err}; }
    ret res_searched;
}

# search the archive `aid` as search does, `found` scratch for the members of
# one name
fun searched(c: *Context, aid: Id[Archive], found: *Vector[Id[contract.Member]]) res[bool, Fail] {
    var any: bool = false;
    for {
        var progress: bool  = false;
        var i:        usize = 0;
        for (i < vector.length[Id[Name]](?c.pending)) {
            val name: Id[Name] = c.pending.data[i];
            i = i + 1;
            val s: *Slot = slot_at(c, name);
            if (!wants(c, s)) { cnt; }
            val tentative: bool = s.defined;
            vector.clear[Id[contract.Member]](found);
            val err_find: err[Fail] = find(c, aid, name, found);
            if (sel err_find.err) { ret res[bool, Fail].err{err_find.err}; }
            var k: usize = 0;
            for (k < vector.length[Id[contract.Member]](found)) {
                val m:   Id[contract.Member] = found.data[k];
                val arc: *Archive            = table.at[Archive](?c.archives, aid);
                if (m.index::usize >= vector.length[bool](?arc.loaded)) {
                    val file: str = input.at(c.in.inputs, arc.input).name;
                    ret res[bool, Fail].err{fail.in_file(fail.malformed("the symbol table names a member the archive does not hold"), file)};
                }
                if (!arc.loaded.data[m.index]) {
                    if (tentative) {
                        val res_defines_data: res[bool, Fail] = defines_data(c, aid, m, name);
                        if (sel res_defines_data.err) { ret res[bool, Fail].err{res_defines_data.err}; }
                        if (!res_defines_data.ok) {
                            k = k + 1;
                            cnt;
                        }
                    }
                    val err_pull: err[Fail] = pull(c, aid, m);
                    if (sel err_pull.err) { ret res[bool, Fail].err{err_pull.err}; }
                    progress = true;
                    brk;
                }
                k = k + 1;
            }
        }
        if (!progress) { brk; }
        any = true;
    }
    ret res[bool, Fail].ok{any};
}

# append to `out` the members of the archive `aid` that define `name`, its
# keys taken the first time it is searched
fun find(c: *Context, aid: Id[Archive], name: Id[Name], out: *Vector[Id[contract.Member]]) err[Fail] {
    if (!table.at[Archive](?c.archives, aid).keyed) {
        val err_take_keys: err[Fail] = take_keys(c, aid);
        if (sel err_take_keys.err) { ret err_take_keys; }
    }
    val arc:     *Archive      = table.at[Archive](?c.archives, aid);
    val text:    View          = intern.bytes_of(c.in.names, name);
    val opt_key: opt[Id[Name]] = intern.find(?arc.keys, text.data, text.len);
    if (sel opt_key.none) { ret err[Fail].ok{}; }
    var at: u32 = arc.heads.data[opt_key.some.index];
    for (at != 0) {
        val d:          *Defines  = ?arc.defines.data[at::usize - 1];
        val err_pushed: err[Fail] = vectors.push[Id[contract.Member]](out, d.member);
        if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
        at = d.next;
    }
    ret err[Fail].ok{};
}

# take the keys of the archive `aid` from its index, or by reading its members
# when it has none, and chain each key's members in the order they came. a
# refusal leaves the archive unkeyed
fun take_keys(c: *Context, aid: Id[Archive]) err[Fail] {
    val e: *Input = input.at(c.in.inputs, table.at[Archive](?c.archives, aid).input);
    if (sel e.model.none) { ret err[Fail].err{fail.in_file(fail.internal("a container has no model"), e.name)}; }
    val model:               *Model                 = table.at[Model](?c.in.inputs.models, e.model.some);
    var entries:             Vector[contract.Entry] = vector.init[contract.Entry](c.in.inputs.a);
    var spelled:             Vector[u8]             = vector.init[u8](c.in.inputs.a);
    val err_keys_from:       err[Fail]              = keys_from(c, aid, model, e.name, ?entries, ?spelled);
    val err_release:         err[Fail]              = vectors.dnit[contract.Entry](?entries);
    val err_release_spelled: err[Fail]              = vectors.dnit[u8](?spelled);
    val err_kept:            err[Fail]              = fail.kept(fail.kept(err_keys_from, err_release), err_release_spelled);
    val arc:                 *Archive               = table.at[Archive](?c.archives, aid);
    if (sel err_kept.ok) {
        val err_chained: err[Fail] = chain(arc);
        if (sel err_chained.ok) { ret err_chained; }
        unkey(arc);
        ret err_chained;
    }
    unkey(arc);
    ret err_kept;
}

# drop the keys of `arc`, as before they were taken
fun unkey(arc: *Archive) {
    vector.clear[Defines](?arc.defines);
    vector.clear[u32](?arc.heads);
    intern.truncate(?arc.keys, 0);
}

# key the archive `aid` from the index of `model` read into `entries`, or by
# scanning its members when it has none
fun keys_from(c: *Context, aid: Id[Archive], model: *Model, file: str, entries: *Vector[contract.Entry], spelled: *Vector[u8]) err[Fail] {
    val res_listed: res[bool, Fail] = contract.indexed(model, file, entries);
    if (sel res_listed.err) { ret err[Fail].err{res_listed.err}; }
    if (res_listed.ok)      { ret key_entries(c, aid, entries, spelled); }
    ret scan(c, aid);
}

# key each entry of the index of the archive `aid` under the link names a
# reference finds it by. an entry spelling a default version `name@@version`
# answers `name@version` and `name`, as a reference with or without the
# version binds to the default version, and any other entry answers its own
# spelling. `spelled` holds a respelled name
fun key_entries(c: *Context, aid: Id[Archive], entries: *Vector[contract.Entry], spelled: *Vector[u8]) err[Fail] {
    var k: usize = 0;
    for (k < vector.length[contract.Entry](entries)) {
        val en:  *contract.Entry = ?entries.data[k];
        val n:   Bytes           = en.name;
        var cut: usize           = 0;
        for (cut < n.len && n.data[cut] != AT) { cut = cut + 1; }
        if (cut + 1 < n.len && n.data[cut + 1] == AT) {
            vectors.truncate[u8](spelled, 0);
            val err_extend: err[Fail] = vectors.extend[u8](spelled, n.data, cut + 1);
            if (sel err_extend.err) { ret err[Fail].err{err_extend.err}; }
            val err_extend_spelled: err[Fail] = vectors.extend[u8](spelled, ?n.data[cut + 2], n.len - cut - 2);
            if (sel err_extend_spelled.err) { ret err[Fail].err{err_extend_spelled.err}; }
            val err_define: err[Fail] = define(c, aid, spelled.data, vector.length[u8](spelled), en.member);
            if (sel err_define.err) { ret err_define; }
            val err_define_aid: err[Fail] = define(c, aid, n.data, cut, en.member);
            if (sel err_define_aid.err) { ret err_define_aid; }
        }
        or {
            val err_define: err[Fail] = define(c, aid, n.data, n.len, en.member);
            if (sel err_define.err) { ret err_define; }
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# link each key of `arc` to its members, first to last
fun chain(arc: *Archive) err[Fail] {
    val err_grown: err[Fail] = vectors.grow[u32](?arc.heads, intern.count(?arc.keys));
    if (sel err_grown.err) { ret err[Fail].err{err_grown.err}; }
    val heads: *u32  = arc.heads.data;
    var i:     usize = vector.length[Defines](?arc.defines);
    for (i > 0) {
        i = i - 1;
        val d: *Defines = ?arc.defines.data[i];
        d.next             = heads[d.key.index];
        heads[d.key.index] = (i + 1)::u32;
    }
    arc.keyed = true;
    ret err[Fail].ok{};
}

# read every member of the archive `aid` once and note the names it defines
fun scan(c: *Context, aid: Id[Archive]) err[Fail] {
    val file:  str   = input.at(c.in.inputs, table.at[Archive](?c.archives, aid).input).name;
    val count: usize = table.count[contract.Member](?table.at[Archive](?c.archives, aid).members);
    var i:     usize = 0;
    for (i < count) {
        val err_scan_member: err[Fail] = scan_member(c, aid, table.nth[contract.Member](i));
        if (sel err_scan_member.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(err_scan_member.err, "member", i::u64), file)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# read the member `m` of the archive `aid` and key it by the names it defines
fun scan_member(c: *Context, aid: Id[Archive], m: Id[contract.Member]) err[Fail] {
    ret visit(c, aid, m, nil, defined_by);
}

# what a member is read for: a name and whether the member defines it as data
rec Probe {
    name:  Id[Name];
    found: bool;
}

# whether the member `m` of the archive `aid` defines `name` as data, which
# only reading the member says
fun defines_data(c: *Context, aid: Id[Archive], m: Id[contract.Member], name: Id[Name]) res[bool, Fail] {
    var probe:     Probe     = Probe{name: name};
    val err_visit: err[Fail] = visit(c, aid, m, (?probe)::ptr, probe_data);
    if (sel err_visit.err) { ret res[bool, Fail].err{err_visit.err}; }
    ret res[bool, Fail].ok{probe.found};
}

# the member `m` of the archive `aid`, read as `model`, converted into `o`
# and handed to `each`, refused when it holds other files
fun member_in(c: *Context, aid: Id[Archive], m: Id[contract.Member], contains: bool, model: *Model, o: *Object, probe: ptr, each: fun(*Context, Id[Archive], Id[contract.Member], *Object, ptr) err[Fail]) err[Fail] {
    if (contains) { ret err[Fail].err{fail.unsupported("an archive member holds other files")}; }
    val err_conv: err[Fail] = registry.to_neutral(c.in.registry, model, o);
    if (sel err_conv.err) { ret err_conv; }
    ret each(c, aid, m, o, probe);
}

# read the member `m` of the archive `aid` into a neutral object and hand it
# to `each`, releasing both after
fun visit(c: *Context, aid: Id[Archive], m: Id[contract.Member], probe: ptr, each: fun(*Context, Id[Archive], Id[contract.Member], *Object, ptr) err[Fail]) err[Fail] {
    var bytes:    contract.Input   = table.at[contract.Member](?table.at[Archive](?c.archives, aid).members, m).input;
    val res_read: res[Model, Fail] = registry.read(c.in.registry, c.in.inputs.a, ?bytes);
    if (sel res_read.err) { ret err[Fail].err{res_read.err}; }
    var model:         Model           = res_read.ok;
    var o:             Object          = object.init(c.in.inputs.a, c.in.arch, nil);
    var err_member_in: err[Fail]       = err[Fail].ok{};
    val res_held:      res[bool, Fail] = contract.is_container(?model);
    if (sel res_held.err) { err_member_in = err[Fail].err{res_held.err}; }
    if (sel res_held.ok)  { err_member_in = member_in(c, aid, m, res_held.ok, ?model, ?o, probe, each); }
    err_member_in = fail.kept(err_member_in, object.dnit(?o));
    ret fail.kept(err_member_in, contract.dnit(?model));
}

# key the member `m` of the archive `aid`, read as `o`, by each link name its
# external definitions resolve under
fun defined_by(c: *Context, aid: Id[Archive], m: Id[contract.Member], o: *Object, probe: ptr) err[Fail] {
    var k: usize = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val sym: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
        if (symbol.binds(sym.binding, symbol.EXTERNAL) && !(sel sym.def.undefined)) {
            val res_keys_of: res[Keys, Fail] = keys_of(c, o, sym);
            if (sel res_keys_of.err) { ret err[Fail].err{fail.in_indexed(res_keys_of.err, "symbol", k::u64)}; }
            val err_define_name: err[Fail] = define_name(c, aid, res_keys_of.ok.own, m);
            if (sel err_define_name.err) { ret err_define_name; }
            val opt_bare: opt[Id[Name]] = res_keys_of.ok.bare;
            if (sel opt_bare.some) {
                val err_define_name: err[Fail] = define_name(c, aid, opt_bare.some, m);
                if (sel err_define_name.err) { ret err_define_name; }
            }
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# note that the member `m` of the archive `aid` defines the link name `name`
fun define_name(c: *Context, aid: Id[Archive], name: Id[Name], m: Id[contract.Member]) err[Fail] {
    val text: View = intern.bytes_of(c.in.names, name);
    ret define(c, aid, text.data, text.len, m);
}

# note that the member `m` of the archive `aid` is found by the `n` bytes at `p`
fun define(c: *Context, aid: Id[Archive], p: *u8, n: usize, m: Id[contract.Member]) err[Fail] {
    val arc:     *Archive            = table.at[Archive](?c.archives, aid);
    val res_key: res[Id[Name], Fail] = intern.intern(?arc.keys, p, n);
    if (sel res_key.err) { ret err[Fail].err{res_key.err}; }
    val err_pushed: err[Fail] = vectors.push[Defines](?arc.defines, Defines{key: res_key.ok, member: m});
    if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
    ret err[Fail].ok{};
}

# mark the probe found when `o` defines its name as data: an external
# definition that is not common and no library's
fun probe_data(c: *Context, aid: Id[Archive], m: Id[contract.Member], o: *Object, probe: ptr) err[Fail] {
    val want: *Probe = probe::*Probe;
    var k:    usize  = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val sym: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
        if (symbol.binds(sym.binding, symbol.EXTERNAL) && !(sel sym.def.undefined) && !(sel sym.def.common) && !(sel sym.def.library)) {
            val res_keys_of: res[Keys, Fail] = keys_of(c, o, sym);
            if (sel res_keys_of.err)                         { ret err[Fail].err{fail.in_indexed(res_keys_of.err, "symbol", k::u64)}; }
            if (res_keys_of.ok.own.index == want.name.index) { want.found = true; }
            val opt_bare: opt[Id[Name]] = res_keys_of.ok.bare;
            if (sel opt_bare.some) {
                if (opt_bare.some.index == want.name.index) { want.found = true; }
            }
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# whether a search still has a member to find for a name: nothing defines it,
# or only commons do and the format pulls a data definition over them
fun wants(c: *Context, s: *Slot) bool {
    if (!s.defined) { ret true; }
    ret s.common && !s.regular && (c.in.search & COMMON_PULL) != 0;
}

# load the member `m` of the archive `aid` as an input of the link
fun pull(c: *Context, aid: Id[Archive], m: Id[contract.Member]) err[Fail] {
    val arc: *Archive = table.at[Archive](?c.archives, aid);
    arc.loaded.data[m.index] = true;
    val from:     Id[Input]      = arc.input;
    val src:      contract.Input = table.at[contract.Member](?arc.members, m).input;
    val held:     *Input         = input.at(c.in.inputs, from);
    val include:  input.Include  = held.include;
    val found:    bool           = held.searched;
    val before:   usize          = input.count(c.in.inputs);
    val err_load: err[Fail]      = gather.load(?c.in.reading, src, c.in.inputs);
    if (sel err_load.err) { ret err[Fail].err{fail.in_indexed(err_load.err, "member", m.index::u64)}; }
    val after: usize = input.count(c.in.inputs);
    var i:     usize = before;
    for (i < after) {
        val id: Id[Input] = table.nth[Input](i);
        val e:  *Input    = input.at(c.in.inputs, id);
        if (sel e.content.container) {
            ret err[Fail].err{fail.in_file(fail.in_indexed(fail.unsupported("an archive member holds other files"), "member", m.index::u64), e.name)};
        }
        e.include  = include;
        e.searched = found;
        val err_placed: err[Fail] = pulled_at(c, id, from, m);
        if (sel err_placed.err) { ret err_placed; }
        val err_pushed: err[Fail] = vectors.push[Member](?c.out.members, Member{archive: from, loaded: id});
        if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
        val err_note: err[Fail] = note(c, id);
        if (sel err_note.err) { ret err_note; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# keep one copy of every group signature by its rule, the first copy's rule
# deciding, and an associative group with the group of its leader
fun choose_groups(c: *Context) err[Fail] {
    var holders:            Vector[u32] = vector.init[u32](c.in.inputs.a);
    var copies:             Table[Copy] = table.init[Copy](c.in.inputs.a);
    val err_chosen:         err[Fail]   = chosen(c, ?holders, ?copies);
    val err_release:        err[Fail]   = vectors.dnit[u32](?holders);
    val err_release_copies: err[Fail]   = table.dnit[Copy](?copies);
    ret fail.kept(fail.kept(err_chosen, err_release), err_release_copies);
}

# choose the groups as choose_groups does, `holders` holding per signature the
# copy kept so far plus one, an index into `copies`
fun chosen(c: *Context, holders: *Vector[u32], copies: *Table[Copy]) err[Fail] {
    val err_laid: err[Fail] = lay_out(c, 0);
    if (sel err_laid.err) { ret err_laid; }
    var i: usize = 0;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = grouped(c, id);
        var g:  usize     = 0;
        if (o != nil) {
            for (g < table.count[Group](?o.groups)) {
                val err_copy_of: err[Fail] = copy_of(c, holders, copies, id, o, table.nth[Group](g));
                if (sel err_copy_of.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(err_copy_of.err, "group", g::u64), input.at(c.in.inputs, id).name)}; }
                g = g + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = grouped(c, id);
        var g:  usize     = 0;
        if (o != nil) {
            for (g < table.count[Group](?o.groups)) {
                val err_follow: err[Fail] = follow(c, id, o, table.nth[Group](g));
                if (sel err_follow.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(err_follow.err, "group", g::u64), input.at(c.in.inputs, id).name)}; }
                g = g + 1;
            }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# give each input from `from` on its place in the group tables: where its
# groups begin, every group kept
fun lay_out(c: *Context, from: usize) err[Fail] {
    var i: usize = from;
    for (i < input.count(c.in.inputs)) {
        val id:         Id[Input] = table.nth[Input](i);
        val err_pushed: err[Fail] = vectors.push[u32](?c.out.firsts, vector.length[bool](?c.out.kept)::u32);
        if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
        val o: *Object = grouped(c, id);
        if (o != nil) {
            val n: usize = table.count[Group](?o.groups);
            if (n != 0) {
                val start:     usize     = vector.length[bool](?c.out.kept);
                val err_grown: err[Fail] = vectors.grow[bool](?c.out.kept, n);
                if (sel err_grown.err) { ret err[Fail].err{err_grown.err}; }
                memory.fill[bool](?c.out.kept.data[start], true, n);
            }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the object of `id` whose groups count, nil for a container or a library
fun grouped(c: *Context, id: Id[Input]) *Object {
    if (library(c.out, id)) { ret nil; }
    ret input.object_of(c.in.inputs, id);
}

# where the group tables say whether the group `g` of `id` is kept
fun kept_at(c: *Context, id: Id[Input], g: Id[Group]) *bool {
    val first: u32 = c.out.firsts.data[id.index];
    ret ?c.out.kept.data[first + g.index];
}

# decide the copy `g` of `id` against the copy its signature holds so far
fun copy_of(c: *Context, holders: *Vector[u32], copies: *Table[Copy], id: Id[Input], o: *Object, g: Id[Group]) err[Fail] {
    val grp: *Group = object.group_at(o, g);
    if (group.has(grp.rule, group.ASSOCIATIVE)) { ret err[Fail].ok{}; }
    val text:    View                = object.name_of(o, grp.signature);
    val res_sig: res[Id[Name], Fail] = intern.intern(c.in.names, text.data, text.len);
    if (sel res_sig.err) { ret err[Fail].err{res_sig.err}; }
    val have: usize = vector.length[u32](holders);
    if (res_sig.ok.index::usize >= have) {
        val err_grown: err[Fail] = vectors.grow[u32](holders, res_sig.ok.index::usize + 1 - have);
        if (sel err_grown.err) { ret err[Fail].err{err_grown.err}; }
    }
    val holder: *u32 = ?holders.data[res_sig.ok.index];
    if (@holder == 0) {
        val res_pushed: res[Id[Copy], Fail] = table.push[Copy](copies, Copy{input: id, group: g});
        if (sel res_pushed.err) { ret err[Fail].err{res_pushed.err}; }
        @holder = res_pushed.ok.index + 1;
        ret err[Fail].ok{};
    }
    val held:  Copy        = table.items[Copy](copies)[@holder - 1];
    val first: *Object     = input.object_of(c.in.inputs, held.input);
    val rule:  *group.Rule = object.group_at(first, held.group).rule;
    if (group.has(rule, group.UNIQUE)) {
        val dropped: *bool = kept_at(c, id, g);
        @dropped = false;
        ret clash(c, res_sig.ok, held.input, id, "group {} is defined in more than one input", HOLDS_GROUP);
    }
    # the sizes of the two copies, read only for a rule that compares them
    var before: u64 = 0;
    var now:    u64 = 0;
    if (group.has(rule, group.LARGEST) || group.has(rule, group.SAME_SIZE)) {
        val res_earlier: res[u64, Fail] = size_of(first, held.group);
        if (sel res_earlier.err) { ret err[Fail].err{res_earlier.err}; }
        val res_later: res[u64, Fail] = size_of(o, g);
        if (sel res_later.err) { ret err[Fail].err{res_later.err}; }
        before = res_earlier.ok;
        now    = res_later.ok;
    }
    if (group.has(rule, group.LARGEST) && now > before) {
        val lost: *bool = kept_at(c, held.input, held.group);
        @lost = false;
        val res_pushed: res[Id[Copy], Fail] = table.push[Copy](copies, Copy{input: id, group: g});
        if (sel res_pushed.err) { ret err[Fail].err{res_pushed.err}; }
        holders.data[res_sig.ok.index] = res_pushed.ok.index + 1;
        ret err[Fail].ok{};
    }
    val dropped: *bool = kept_at(c, id, g);
    @dropped = false;
    if (group.has(rule, group.SAME_SIZE) && now != before) {
        ret clash(c, res_sig.ok, held.input, id, "copies of group {} differ in size", HOLDS_GROUP);
    }
    if (group.has(rule, group.SAME_CONTENTS) && !same_contents(first, held.group, o, g)) {
        ret clash(c, res_sig.ok, held.input, id, "copies of group {} differ in contents", HOLDS_GROUP);
    }
    ret err[Fail].ok{};
}

# an associative group is kept exactly when the group of its leader is
fun follow(c: *Context, id: Id[Input], o: *Object, g: Id[Group]) err[Fail] {
    val grp: *Group = object.group_at(o, g);
    if (!group.has(grp.rule, group.ASSOCIATIVE)) { ret err[Fail].ok{}; }
    if (sel grp.leader.none)                     { ret err[Fail].err{fail.malformed("associative group has no leader section")}; }
    if (grp.leader.some.index::usize >= table.count[Section](?o.sections)) {
        ret err[Fail].err{fail.malformed("associative group's leader is not a section")};
    }
    val res_lead: res[Id[Section], Fail] = object.leader_of(o, grp.leader.some);
    if (sel res_lead.err) { ret err[Fail].err{res_lead.err}; }
    val opt_owner: opt[Id[Group]] = object.section_at(o, res_lead.ok).group;
    if (sel opt_owner.some) {
        val fate: *bool = kept_at(c, id, g);
        @fate = @kept_at(c, id, opt_owner.some);
    }
    ret err[Fail].ok{};
}

# what a holder of a clash holds, as each note of it says
val DEFINES:     str = "{at} defines {}";
val HOLDS_GROUP: str = "{at} holds group {}";
val HOLDS_COPY:  str = "{at} holds a copy of {}";

# record the clash of two inputs over `name`, as clash_of does
fun clash(c: *Context, name: Id[Name], first: Id[Input], second: Id[Input], why: str, held: str) err[Fail] {
    ret clash_of(c, name, Party.input{first}, Party.input{second}, why, held);
}

# record the clash of `first` and `second` over `name`, refused `why`, each
# holder's note `held`. the phase is refused once resolution ends
fun clash_of(c: *Context, name: Id[Name], first: Party, second: Party, why: str, held: str) err[Fail] {
    val err_pushed: err[Fail] = vectors.push[Clash](?c.out.clashes, Clash{name: name, first: first, second: second, why: why, held: held});
    if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
    ret err[Fail].ok{};
}

# the bytes the section `s` of `o` takes, a zero fill's included
fun section_size(o: *Object, s: *Section) u64 {
    if (sel s.contents.zero) { ret s.contents.zero; }
    ret object.bytes(o, ?s.contents).len::u64;
}

# the size of the copy `g` of `o`: every member section's
fun size_of(o: *Object, g: Id[Group]) res[u64, Fail] {
    val at:    Location = Location{record: "group"};
    var total: u64      = 0;
    var i:     usize    = 0;
    for (i < table.count[Section](?o.sections)) {
        val s: *Section = object.section_at(o, table.nth[Section](i));
        if (sel s.group.some && s.group.some.index == g.index) {
            val res_sum: res[u64, Fail] = checked.add(at, total, section_size(o, s));
            if (sel res_sum.err) { ret res_sum; }
            total = res_sum.ok;
        }
        i = i + 1;
    }
    ret res[u64, Fail].ok{total};
}

# the next member section of `g` in `o` at or after `from`, the count of
# sections when there is none
fun next_member(o: *Object, g: Id[Group], from: usize) usize {
    var i: usize = from;
    for (i < table.count[Section](?o.sections)) {
        val s: *Section = object.section_at(o, table.nth[Section](i));
        if (sel s.group.some && s.group.some.index == g.index) { ret i; }
        i = i + 1;
    }
    ret i;
}

# whether two copies hold the same sections, byte for byte and relocation for
# relocation, in order. bytes alone would pass two copies that call different
# functions where the addend lives in the relocation
fun same_contents(a: *Object, ga: Id[Group], b: *Object, gb: Id[Group]) bool {
    var i: usize = next_member(a, ga, 0);
    var j: usize = next_member(b, gb, 0);
    for (i < table.count[Section](?a.sections) && j < table.count[Section](?b.sections)) {
        val x:  *Section = object.section_at(a, table.nth[Section](i));
        val y:  *Section = object.section_at(b, table.nth[Section](j));
        val xz: bool     = sel x.contents.zero;
        val yz: bool     = sel y.contents.zero;
        if (xz != yz)                                 { ret false; }
        if (section_size(a, x) != section_size(b, y)) { ret false; }
        if (!xz) {
            val p: Bytes = object.bytes(a, ?x.contents);
            val q: Bytes = object.bytes(b, ?y.contents);
            if (!memory.raw_equal(p.data::ptr, q.data::ptr, p.len)) { ret false; }
        }
        val pa: Copied = Copied{o: a, g: ga};
        val pb: Copied = Copied{o: b, g: gb};
        if (!same_relocs(?pa, table.nth[Section](i), ?pb, table.nth[Section](j))) { ret false; }
        i = next_member(a, ga, i + 1);
        j = next_member(b, gb, j + 1);
    }
    ret i == table.count[Section](?a.sections) && j == table.count[Section](?b.sections);
}

# a copy: its object and group
rec Copied {
    o: *Object;
    g: Id[Group];
}

# the next relocation of `o` in section `s` at or after `from`, the count of
# relocations when there is none
fun next_reloc(o: *Object, s: Id[Section], from: usize) usize {
    var i: usize = from;
    for (i < table.count[object.Reloc](?o.relocs)) {
        val r: *object.Reloc = table.at[object.Reloc](?o.relocs, table.nth[object.Reloc](i));
        if (r.section.index == s.index) { ret i; }
        i = i + 1;
    }
    ret i;
}

# whether section `x` of copy `p` and section `y` of copy `q` hold the same
# relocations in order: at the same offset, of the same kind and addend,
# aimed at the same target
fun same_relocs(p: *Copied, x: Id[Section], q: *Copied, y: Id[Section]) bool {
    var i: usize = next_reloc(p.o, x, 0);
    var j: usize = next_reloc(q.o, y, 0);
    for (i < table.count[object.Reloc](?p.o.relocs) && j < table.count[object.Reloc](?q.o.relocs)) {
        val r: *object.Reloc = table.at[object.Reloc](?p.o.relocs, table.nth[object.Reloc](i));
        val t: *object.Reloc = table.at[object.Reloc](?q.o.relocs, table.nth[object.Reloc](j));
        if (r.offset != t.offset || r.kind != t.kind || r.addend != t.addend) { ret false; }
        if (!same_target(p, r.target, q, t.target))                           { ret false; }
        val opt_minus:   opt[Id[Symbol]] = r.minus;
        val opt_t_minus: opt[Id[Symbol]] = t.minus;
        if (sel opt_minus.some) {
            if (!sel opt_t_minus.some)                                { ret false; }
            if (!same_symbol(p, opt_minus.some, q, opt_t_minus.some)) { ret false; }
        }
        or (sel opt_t_minus.some) { ret false; }
        i = next_reloc(p.o, x, i + 1);
        j = next_reloc(q.o, y, j + 1);
    }
    ret i == table.count[object.Reloc](?p.o.relocs) && j == table.count[object.Reloc](?q.o.relocs);
}

# whether the target `x` of copy `p` and the target `y` of copy `q` are alike:
# the same symbol, the same entry or the same kind of target with none
fun same_target(p: *Copied, x: object.Target, q: *Copied, y: object.Target) bool {
    if (sel x.symbol) {
        if (!sel y.symbol) { ret false; }
        ret same_symbol(p, x.symbol, q, y.symbol);
    }
    if (sel x.entry) {
        if (!sel y.entry) { ret false; }
        ret x.entry.index == y.entry.index;
    }
    if (sel x.none)     { ret sel y.none; }
    if (sel x.absolute) { ret sel y.absolute; }
    ret sel y.lines;
}

# whether two symbols name the same thing to their copies: a place in the
# copy itself at the same member and offset, else the same name
fun same_symbol(p: *Copied, sa: Id[Symbol], q: *Copied, sb: Id[Symbol]) bool {
    val x:            *Symbol     = object.symbol_at(p.o, sa);
    val y:            *Symbol     = object.symbol_at(q.o, sb);
    val opt_inside:   opt[Within] = inside(p, x);
    val opt_y_inside: opt[Within] = inside(q, y);
    if (sel opt_inside.some) {
        if (!sel opt_y_inside.some) { ret false; }
        ret opt_inside.some.member == opt_y_inside.some.member && opt_inside.some.offset == opt_y_inside.some.offset;
    }
    if (sel opt_y_inside.some) { ret false; }
    val a: View = object.name_of(p.o, x.name);
    val b: View = object.name_of(q.o, y.name);
    if (a.len != b.len) { ret false; }
    ret memory.raw_equal(a.data::ptr, b.data::ptr, a.len);
}

# a place in a copy: the ordinal of its member section and the offset in it
rec Within {
    member: usize;
    offset: u64;
}

# where a symbol placed in a member of copy `c` lies in it, none for one
# placed elsewhere
fun inside(c: *Copied, sym: *Symbol) opt[Within] {
    val d: object.Definition = sym.def;
    if (!sel d.placed) { ret opt[Within].none{}; }
    val at:      Place = d.placed;
    var ordinal: usize = 0;
    var i:       usize = next_member(c.o, c.g, 0);
    for (i < table.count[Section](?c.o.sections)) {
        if (i == at.section.index::usize) { ret opt[Within].some{Within{member: ordinal, offset: at.offset}}; }
        ordinal = ordinal + 1;
        i       = next_member(c.o, c.g, i + 1);
    }
    ret opt[Within].none{};
}

# the rank of a definition
fun rank_of(sym: *Symbol) u8 {
    if (sel sym.def.common)                     { ret COMMON; }
    if (symbol.binds(sym.binding, symbol.WEAK)) { ret WEAK; }
    ret STRONG;
}

# bind every name: the link's own definitions first, then each library's
# offers, then the inputs' symbols, then the weak references' fallbacks
fun bind(c: *Context) err[Fail] {
    val err_defined_bounds: err[Fail] = defined_bounds(c);
    if (sel err_defined_bounds.err) { ret err_defined_bounds; }
    var i: usize = 0;
    for (i < table.count[Import](?c.offers)) {
        val o: *Import = table.at[Import](?c.offers, table.nth[Import](i));
        val s: *Slot   = slot_at(c, o.name);
        if (!s.has) {
            s.has     = true;
            s.rank    = OFFERED;
            s.library = opt[Id[Name]].some{o.library};
        }
        i = i + 1;
    }
    val err_bind_inputs: err[Fail] = bind_inputs(c, 0);
    if (sel err_bind_inputs.err) { ret err_bind_inputs; }
    ret fallbacks(c);
}

# hold each name a bound row has the link define for the output kind whether
# or not a reference reaches it, until an input's definition displaces it
fun defined_bounds(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < c.in.bounds.count) {
        val b: *Bound = ?c.in.bounds.rows[i];
        i = i + 1;
        if (!boundary.defines(b, c.in.kind)) { cnt; }
        val res_intern_str: res[Id[Name], Fail] = intern.intern_str(c.in.names, b.name);
        if (sel res_intern_str.err) { ret err[Fail].err{res_intern_str.err}; }
        val res_keyed: res[*Slot, Fail] = keyed(c, res_intern_str.ok, false);
        if (sel res_keyed.err) { ret err[Fail].err{fail.in_record(res_keyed.err, b.name)}; }
        res_keyed.ok.has    = true;
        res_keyed.ok.rank   = LINKED;
        res_keyed.ok.bound  = b;
        res_keyed.ok.strong = true;
    }
    ret err[Fail].ok{};
}

# bind each weak reference nothing defines to what its fallback binds to
fun fallbacks(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Id[Name]](?c.order)) {
        val name: Id[Name] = c.order.data[i];
        val s:    *Slot    = slot_at(c, name);
        i = i + 1;
        if (s.has || s.weak == 0) { cnt; }
        val err_fall_back: err[Fail] = fall_back(c, name);
        if (sel err_fall_back.err) { ret err[Fail].err{fail.in_file(err_fall_back.err, input.at(c.in.inputs, table.nth[Input]((s.weak - 1)::usize)).name)}; }
    }
    ret err[Fail].ok{};
}

# follow the fallbacks of `name`'s weak reference to a definition. a
# reference whose search is unchained stops at its fallback
fun fall_back(c: *Context, name: Id[Name]) err[Fail] {
    val first: *Slot      = slot_at(c, name);
    var id:    Id[Input]  = table.nth[Input]((first.weak - 1)::usize);
    var k:     Id[Symbol] = first.weak_sym;
    var steps: usize      = 0;
    for {
        val o:            *Object              = input.object_of(c.in.inputs, id);
        val sym:          *Symbol              = object.symbol_at(o, k);
        val opt_fallback: opt[object.Fallback] = sym.fallback;
        if (sel opt_fallback.none) { ret err[Fail].err{fail.internal("a weak reference lost its fallback")}; }
        val fb: object.Fallback = opt_fallback.some;
        if (fb.symbol.index::usize >= table.count[Symbol](?o.symbols)) { ret err[Fail].err{fail.malformed("a fallback names a symbol the object does not hold")}; }
        val target: *Symbol = object.symbol_at(o, fb.symbol);
        if (!symbol.binds(target.binding, symbol.EXTERNAL)) {
            if (sel target.def.undefined) { ret err[Fail].err{fail.malformed("a fallback is a local symbol with no definition")}; }
            val own: *Slot = slot_at(c, name);
            own.has    = true;
            own.fell   = true;
            own.alias  = false;
            own.rank   = rank_of(target);
            own.input  = id;
            own.symbol = fb.symbol;
            ret err[Fail].ok{};
        }
        val res_keys_of: res[Keys, Fail] = keys_of(c, o, target);
        if (sel res_keys_of.err) { ret err[Fail].err{res_keys_of.err}; }
        val res_slot_of: res[*Slot, Fail] = slot_of(c, res_keys_of.ok.own);
        if (sel res_slot_of.err) { ret err[Fail].err{res_slot_of.err}; }
        val t:         *Slot = res_slot_of.ok;
        val unchained: bool  = symbol.looks(fb.search, symbol.UNCHAINED);
        if (t.has && !(t.fell && unchained)) {
            val again: *Slot = slot_at(c, name);
            again.has     = true;
            again.fell    = true;
            again.alias   = false;
            again.rank    = t.rank;
            again.unique  = t.unique;
            again.input   = t.input;
            again.symbol  = t.symbol;
            again.library = t.library;
            again.bound   = t.bound;
            ret err[Fail].ok{};
        }
        if (unchained || t.weak == 0) { ret unresolved(c, name); }
        steps = steps + 1;
        if (steps > vector.length[Id[Name]](?c.order)) { ret err[Fail].err{fail.malformed("weak external fallbacks form a cycle")}; }
        id = table.nth[Input]((t.weak - 1)::usize);
        k  = t.weak_sym;
    }
    ret err[Fail].ok{};
}

# the weak reference of `name` reaches no definition, an undefined reference
# of the input that declares it
fun unresolved(c: *Context, name: Id[Name]) err[Fail] {
    val s:          *Slot     = slot_at(c, name);
    val err_pushed: err[Fail] = vectors.push[Reference](?c.refs, Reference{name: name, input: table.nth[Input]((s.weak - 1)::usize)});
    if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
    ret err[Fail].ok{};
}

# bind the symbols of the inputs from `from` on
fun bind_inputs(c: *Context, from: usize) err[Fail] {
    var i: usize = from;
    for (i < input.count(c.in.inputs)) {
        val id:        Id[Input] = table.nth[Input](i);
        val o:         *Object   = grouped(c, id);
        val err_start: err[Fail] = vectors.push[u32](?c.out.starts, vector.length[u32](?c.out.links)::u32);
        if (sel err_start.err) { ret err[Fail].err{err_start.err}; }
        if (o != nil && table.count[Symbol](?o.symbols) != 0) {
            val err_grown: err[Fail] = vectors.grow[u32](?c.out.links, table.count[Symbol](?o.symbols));
            if (sel err_grown.err) { ret err[Fail].err{err_grown.err}; }
        }
        if (library(c.out, id)) {
            val err_named: err[Fail] = name_library(c, id);
            if (sel err_named.err) { ret err[Fail].err{fail.in_file(err_named.err, input.at(c.in.inputs, id).name)}; }
        }
        if (o != nil) {
            val err_staying: err[Fail] = staying(c, o);
            if (sel err_staying.err) { ret err[Fail].err{fail.in_file(err_staying.err, input.at(c.in.inputs, id).name)}; }
            var k: usize = 0;
            for (k < table.count[Symbol](?o.symbols)) {
                val err_bind_symbol: err[Fail] = bind_symbol(c, id, o, table.nth[Symbol](k), c.stays.data[k]);
                if (sel err_bind_symbol.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(err_bind_symbol.err, "symbol", k::u64), input.at(c.in.inputs, id).name)}; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret intended(c, from);
}

# give the name each export directive of an object input from `from` on is
# about the default visibility, on a format whose link exports by
# visibility, unless its visibility already exports it, as protected does. a
# name nothing binds is left to the export check to refuse
fun intended(c: *Context, from: usize) err[Fail] {
    if (c.in.directed) { ret err[Fail].ok{}; }
    var i: usize = from;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(c.in.inputs, id);
        i = i + 1;
        if (o == nil || library(c.out, id)) { cnt; }
        var k: usize = 0;
        for (k < table.count[object.Directive](?o.directives)) {
            val d: *object.Directive = table.at[object.Directive](?o.directives, table.nth[object.Directive](k));
            k = k + 1;
            if (d.kind != ?directive.EXPORT) { cnt; }
            val opt_about: opt[Id[Name]] = d.symbol;
            if (sel opt_about.none) { cnt; }
            val text:     View          = object.name_of(o, opt_about.some);
            val opt_find: opt[Id[Name]] = intern.find(c.in.names, text.data, text.len);
            if (sel opt_find.none)                                           { cnt; }
            if (opt_find.some.index::usize >= vector.length[Slot](?c.slots)) { cnt; }
            val s: *Slot = slot_at(c, opt_find.some);
            if (s.vis != nil && (s.vis.caps & symbol.EXPORTED) == 0) { s.vis = ?symbol.DEFAULT; }
        }
    }
    ret err[Fail].ok{};
}

# note the link name of every external symbol of the shared library `id`,
# which binds nothing itself
fun name_library(c: *Context, id: Id[Input]) err[Fail] {
    val o:         *Object   = input.object_of(c.in.inputs, id);
    val count:     usize     = table.count[Symbol](?o.symbols);
    val start:     u32       = c.out.starts.data[id.index];
    val err_grown: err[Fail] = vectors.grow[u32](?c.out.links, count);
    if (sel err_grown.err) { ret err[Fail].err{err_grown.err}; }
    var k: usize = 0;
    for (k < count) {
        val sym: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
        if (symbol.binds(sym.binding, symbol.EXTERNAL)) {
            val res_name: res[Id[Name], Fail] = c.in.hooks.name(c, o, sym);
            if (sel res_name.err) { ret err[Fail].err{fail.in_indexed(res_name.err, "symbol", k::u64)}; }
            c.out.links.data[start::usize + k] = res_name.ok.index + 1;
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# mark each symbol of `o` a staying import names, whose reference stands
# when nothing defines it
fun staying(c: *Context, o: *Object) err[Fail] {
    vector.clear[bool](?c.stays);
    val n: usize = table.count[Symbol](?o.symbols);
    if (n == 0) { ret err[Fail].ok{}; }
    val err_grow: err[Fail] = vectors.grow[bool](?c.stays, n);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < table.count[object.Entry](?o.entries)) {
        val en: *object.Entry = table.at[object.Entry](?o.entries, table.nth[object.Entry](i));
        i = i + 1;
        if (sel en.import.none)    { cnt; }
        if (!en.import.some.stays) { cnt; }
        val opt_symbol: opt[Id[Symbol]] = en.import.some.symbol;
        if (sel opt_symbol.none)               { cnt; }
        if (opt_symbol.some.index::usize >= n) { ret err[Fail].err{fail.in_indexed(fail.malformed("an import names a symbol the object does not hold"), "entry", (i - 1)::u64)}; }
        c.stays.data[opt_symbol.some.index] = true;
    }
    ret err[Fail].ok{};
}

# the section the definition `sym` of `o` lies in, placed there or as an entry's
# body, none for a definition no section holds
fun home_of(o: *Object, sym: *Symbol) res[opt[Id[Section]], Fail] {
    var opt_home: opt[Id[Section]] = opt[Id[Section]].none{};
    if (sel sym.def.placed) { opt_home = opt[Id[Section]].some{sym.def.placed.section}; }
    or (sel sym.def.entry) {
        if (sym.def.entry.index::usize >= table.count[Entry](?o.entries)) {
            ret res[opt[Id[Section]], Fail].err{fail.malformed("a symbol is defined by an entry the object does not hold")};
        }
        val opt_body: opt[Place] = table.at[Entry](?o.entries, sym.def.entry).body;
        if (sel opt_body.some) { opt_home = opt[Id[Section]].some{opt_body.some.section}; }
    }
    if (sel opt_home.some) {
        if (opt_home.some.index::usize >= table.count[Section](?o.sections)) {
            ret res[opt[Id[Section]], Fail].err{fail.malformed("a symbol is defined in a section the object does not hold")};
        }
    }
    ret res[opt[Id[Section]], Fail].ok{opt_home};
}

# `stays`: a staying import names the symbol, so an undefined reference by it
# stands when nothing defines its name
fun bind_symbol(c: *Context, id: Id[Input], o: *Object, k: Id[Symbol], stays: bool) err[Fail] {
    val sym: *Symbol = object.symbol_at(o, k);
    if (!symbol.binds(sym.binding, symbol.EXTERNAL)) { ret err[Fail].ok{}; }
    val res_keys_of: res[Keys, Fail] = keys_of(c, o, sym);
    if (sel res_keys_of.err) { ret err[Fail].err{res_keys_of.err}; }
    val start: u32 = c.out.starts.data[id.index];
    c.out.links.data[start + k.index] = res_keys_of.ok.own.index + 1;
    val res_home: res[opt[Id[Section]], Fail] = home_of(o, sym);
    if (sel res_home.err) { ret err[Fail].err{res_home.err}; }
    val opt_home: opt[Id[Section]] = res_home.ok;
    var copy:     bool             = false;
    if (sel opt_home.some) {
        val sec: *Section = object.section_at(o, opt_home.some);
        if (!keeps(c.out, id, sec)) { ret err[Fail].ok{}; }
        copy = signs(o, sec, sym);
    }
    val opt_own: opt[Id[Group]] = sym.group;
    if (sel opt_own.some) {
        if (!@kept_at(c, id, opt_own.some)) { ret err[Fail].ok{}; }
        copy = copy_in(o, opt_own.some, sym);
    }
    val before:         usize     = vector.length[Clash](?c.out.clashes);
    val err_bind_under: err[Fail] = bind_under(c, id, k, sym, res_keys_of.ok.own, sel sym.version.some, false, stays, copy);
    if (sel err_bind_under.err) { ret err_bind_under; }
    val opt_bare: opt[Id[Name]] = res_keys_of.ok.bare;
    if (sel opt_bare.none)                              { ret err[Fail].ok{}; }
    if (vector.length[Clash](?c.out.clashes) != before) { ret err[Fail].ok{}; }
    ret bind_under(c, id, k, sym, opt_bare.some, false, true, false, copy);
}

# whether `sym`, defined in `sec`, is a copy of the group `sec` is in, the
# group's signature being its name
fun signs(o: *Object, sec: *Section, sym: *Symbol) bool {
    val opt_group: opt[Id[Group]] = sec.group;
    if (sel opt_group.none) { ret false; }
    ret copy_in(o, opt_group.some, sym);
}

# why the copy symbol `ak` of `a` and the copy symbol `bk` of `b`, two copies
# of one name in different groups, differ (model/merged)
fun differing(c: *Context, a: Id[Input], ak: Id[Symbol], b: Id[Input], bk: Id[Symbol]) str {
    val opt_identity_at: opt[u64] = identity_at(c, a, ak);
    val opt_b_identity:  opt[u64] = identity_at(c, b, bk);
    if (sel opt_identity_at.some) {
        if (sel opt_b_identity.some) { ret merged.mismatch(opt_identity_at.some, opt_b_identity.some); }
    }
    ret "copies of {} differ in a group whose identity cannot be read";
}

# the identity of the copy the symbol `k` of `in` is, read from the signature
# of its group, none when its group is no copy's
fun identity_at(c: *Context, in: Id[Input], k: Id[Symbol]) opt[u64] {
    val o:       *Object        = input.object_of(c.in.inputs, in);
    val sym:     *Symbol        = object.symbol_at(o, k);
    val opt_own: opt[Id[Group]] = sym.group;
    if (sel opt_own.some) { ret signed(o, opt_own.some, sym); }
    val res_home: res[opt[Id[Section]], Fail] = home_of(o, sym);
    if (sel res_home.err)     { ret opt[u64].none{}; }
    if (sel res_home.ok.none) { ret opt[u64].none{}; }
    val opt_group: opt[Id[Group]] = object.section_at(o, res_home.ok.some).group;
    if (sel opt_group.none) { ret opt[u64].none{}; }
    ret signed(o, opt_group.some, sym);
}

# the identity the signature of group `g` of `o` gives the copy `sym`
fun signed(o: *Object, g: Id[Group], sym: *Symbol) opt[u64] {
    val grp: *Group = object.group_at(o, g);
    ret merged.identity_of(object.name_of(o, grp.signature), object.name_of(o, sym.name));
}

# whether `sym` is the copy group `g` holds of a merged definition: the
# group is signed by its name's copy signature (model/merged)
fun copy_in(o: *Object, g: Id[Group], sym: *Symbol) bool {
    val grp: *Group = object.group_at(o, g);
    if (group.has(grp.rule, group.ASSOCIATIVE)) { ret false; }
    val opt_identity_of: opt[u64] = merged.identity_of(object.name_of(o, grp.signature), object.name_of(o, sym.name));
    ret sel opt_identity_of.some;
}

# bind `sym`, the symbol `k` of the input `id`, under `name`, which reaches it
# by a versioned link name when `versioned`, and as the base name its default
# version answers when `alias`. `stays`: a staying import names it, so an
# undefined reference by it stands when nothing defines its name. `copy`: it
# is a copy of a merged definition, whose copies are the name's only
# definitions, so any other definition of the name is refused, weak or
# strong, and a second copy bound, one of another group, was made from
# another source
fun bind_under(c: *Context, id: Id[Input], k: Id[Symbol], sym: *Symbol, name: Id[Name], versioned: bool, alias: bool, stays: bool, copy: bool) err[Fail] {
    val res_keyed: res[*Slot, Fail] = keyed(c, name, versioned);
    if (sel res_keyed.err) { ret err[Fail].err{res_keyed.err}; }
    val s: *Slot = res_keyed.ok;
    if (s.vis == nil) { s.vis = sym.visibility; }
    or                { s.vis = symbol.merged(s.vis, sym.visibility); }
    if (sel sym.def.undefined) {
        if (!s.has) {
            val opt_find: opt[*Bound] = boundary.find(?c.in.bounds, intern.bytes_of(c.in.names, name));
            if (sel opt_find.some) {
                s.has   = true;
                s.rank  = LINKED;
                s.bound = opt_find.some;
            }
        }
        if (sel sym.fallback.some && s.weak == 0) {
            s.weak     = id.index + 1;
            s.weak_sym = k;
        }
        if (stays || symbol.binds(sym.binding, symbol.WEAK)) { ret err[Fail].ok{}; }
        s.strong = true;
        if (s.referred == id.index + 1) { ret err[Fail].ok{}; }
        s.referred = id.index + 1;
        val err_pushed: err[Fail] = vectors.push[Reference](?c.refs, Reference{name: name, input: id});
        if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
        ret err[Fail].ok{};
    }
    if (sel sym.def.common) {
        val block: object.Common = sym.def.common;
        if (block.align == 0 || (block.align & (block.align - 1)) != 0) {
            ret err[Fail].err{fail.malformed("a common symbol's alignment is not a power of two")};
        }
        if (block.size > s.size)   { s.size = block.size; }
        if (block.align > s.align) { s.align = block.align; }
    }
    val rank:   u8   = rank_of(sym);
    val unique: bool = symbol.binds(sym.binding, symbol.UNIQUE);
    if (s.has && s.rank >= WEAK && rank >= WEAK && s.copy != copy) {
        ret clash(c, name, s.input, id, "{} is defined beside the copies of its merged definition", DEFINES);
    }
    if (s.has && s.copy && copy && (s.input.index != id.index || s.symbol.index != k.index)) {
        ret clash(c, name, s.input, id, differing(c, s.input, s.symbol, id, k), HOLDS_COPY);
    }
    if (s.has && rank == s.rank && rank == STRONG && !unique && !s.unique) {
        ret clash(c, name, s.input, id, "{} is defined in more than one input", DEFINES);
    }
    if (s.has && rank <= s.rank) { ret err[Fail].ok{}; }
    s.has     = true;
    s.rank    = rank;
    s.unique  = unique;
    s.copy    = copy;
    s.input   = id;
    s.symbol  = k;
    s.library = opt[Id[Name]].none{};
    s.alias   = alias;
    s.bound   = nil;
    ret err[Fail].ok{};
}

# publish the answers, then refuse a clash or an undefined reference
fun finish(c: *Context) err[Fail] {
    val err_publish: err[Fail] = publish(c, true);
    if (sel err_publish.err) { ret err_publish; }
    ret judged(c);
}

# write each bound name into the output: an import for a name a library
# offers, a binding for every other, and the storage of a common one. the
# imports are recorded and announced to the hook only when `fresh`, since
# otherwise they are already there
fun publish(c: *Context, fresh: bool) err[Fail] {
    val count:     usize     = intern.count(c.in.names);
    val err_grown: err[Fail] = vectors.grow[u32](?c.out.named, count);
    if (sel err_grown.err) { ret err[Fail].err{err_grown.err}; }
    var i: usize = 0;
    for (i < vector.length[Id[Name]](?c.order)) {
        val name:    Id[Name]      = c.order.data[i];
        val s:       *Slot         = slot_at(c, name);
        val opt_lib: opt[Id[Name]] = s.library;
        if (!s.has) {
            i = i + 1;
            cnt;
        }
        if (s.bound != nil) {
            val err_link_defined: err[Fail] = link_defined(c, name, s.bound, !s.strong);
            if (sel err_link_defined.err) { ret err_link_defined; }
            i = i + 1;
            cnt;
        }
        if (sel opt_lib.some) {
            if (fresh) {
                val res_imports_pushed: res[Id[Import], Fail] = table.push[Import](?c.out.imports, Import{name: name, library: opt_lib.some});
                if (sel res_imports_pushed.err) { ret err[Fail].err{res_imports_pushed.err}; }
                val err_imported: err[Fail] = c.in.hooks.imported(c, res_imports_pushed.ok);
                if (sel err_imported.err) { ret err_imported; }
            }
        }
        or {
            val res_bindings_pushed: res[Id[Binding], Fail] = table.push[Binding](?c.out.bindings, Binding{name: name, input: s.input, symbol: s.symbol, visibility: s.vis, alias: s.alias});
            if (sel res_bindings_pushed.err) { ret err[Fail].err{res_bindings_pushed.err}; }
            c.out.named.data[name.index] = res_bindings_pushed.ok.index + 1;
            if (s.rank == COMMON) {
                val err_commons_pushed: err[Fail] = vectors.push[Storage](?c.out.commons, Storage{name: name, binding: res_bindings_pushed.ok, size: s.size, align: s.align});
                if (sel err_commons_pushed.err) { ret err[Fail].err{err_commons_pushed.err}; }
            }
        }
        i = i + 1;
    }
    ret publish_undefined(c);
}

# write the link's own definition of `name` at the place `b` states, which
# only weak references reach when `weak`
fun link_defined(c: *Context, name: Id[Name], b: *Bound, weak: bool) err[Fail] {
    val have: usize = vector.length[u32](?c.out.linking);
    if (name.index::usize >= have) {
        val err_grow: err[Fail] = vectors.grow[u32](?c.out.linking, name.index::usize + 1 - have);
        if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    }
    var opt_section_name: opt[Id[Name]] = opt[Id[Name]].none{};
    if (boundary.by_section(b.place)) {
        val res_sec: res[Id[Name], Fail] = boundary.section_name(b, name, c.in.names, c.in.inputs.a);
        if (sel res_sec.err) { ret err[Fail].err{res_sec.err}; }
        opt_section_name = opt[Id[Name]].some{res_sec.ok};
    }
    val res_linked_pushed: res[Id[Linked], Fail] = table.push[Linked](?c.out.linked, Linked{name: name, bound: b, weak: weak, section: opt_section_name, missing: opt[*section.Kind].none{}});
    if (sel res_linked_pushed.err) { ret err[Fail].err{res_linked_pushed.err}; }
    c.out.linking.data[name.index] = res_linked_pushed.ok.index + 1;
    ret err[Fail].ok{};
}

# write every reference to a name nothing defines into the output, grouped by
# name. `next` holds, by name, how many references a name has, then where its
# next reference goes plus one
fun publish_undefined(c: *Context) err[Fail] {
    var count:               Vector[u32] = vector.init[u32](c.in.inputs.a);
    var next:                Vector[u32] = vector.init[u32](c.in.inputs.a);
    val err_group_undefined: err[Fail]   = group_undefined(c, ?count, ?next);
    val err_release:         err[Fail]   = vectors.dnit[u32](?count);
    val err_release_next:    err[Fail]   = vectors.dnit[u32](?next);
    ret fail.kept(fail.kept(err_group_undefined, err_release), err_release_next);
}

# append the references to names nothing defines to the output's undefined,
# grouped by name, as publish_undefined does
fun group_undefined(c: *Context, count: *Vector[u32], next: *Vector[u32]) err[Fail] {
    val names:    usize     = intern.count(c.in.names);
    val err_grow: err[Fail] = vectors.grow[u32](count, names);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    val err_grow_next: err[Fail] = vectors.grow[u32](next, names);
    if (sel err_grow_next.err) { ret err[Fail].err{err_grow_next.err}; }
    val refs:  *Reference = c.refs.data;
    val n:     usize      = vector.length[Reference](?c.refs);
    var total: usize      = 0;
    var i:     usize      = 0;
    for (i < n) {
        if (!slot_at(c, refs[i].name).has) {
            count.data[refs[i].name.index] = count.data[refs[i].name.index] + 1;
            total                          = total + 1;
        }
        i = i + 1;
    }
    val base:               usize     = vector.length[Reference](?c.out.undefined);
    val err_grow_undefined: err[Fail] = vectors.grow[Reference](?c.out.undefined, total);
    if (sel err_grow_undefined.err) { ret err[Fail].err{err_grow_undefined.err}; }
    var placed: u32 = 0;
    i = 0;
    for (i < n) {
        val name: u32 = refs[i].name.index;
        if (!slot_at(c, refs[i].name).has && next.data[name] == 0) {
            next.data[name] = placed + 1;
            placed          = placed + count.data[name];
        }
        i = i + 1;
    }
    val out: *Reference = c.out.undefined.data;
    i = 0;
    for (i < n) {
        val name: u32 = refs[i].name.index;
        if (!slot_at(c, refs[i].name).has) {
            out[base + (next.data[name] - 1)::usize] = refs[i];
            next.data[name]                          = next.data[name] + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# refuse the first clash, naming every holder to the notes, or else an
# undefined reference the output kind does not keep, naming each to the notes
fun judged(c: *Context) err[Fail] {
    if (vector.length[Clash](?c.out.clashes) != 0) {
        val first:     *Clash         = ?c.out.clashes.data[0];
        val res_named: res[str, Fail] = spelled_name(c, first.name);
        if (sel res_named.err) { ret err[Fail].err{res_named.err}; }
        # the name is spelled before the file is read, since spelling it may move what the file points into
        val refused:     Fail      = fail.about(fail.in_file(fail.malformed(first.why), party_name(c, first.second)), res_named.ok);
        val err_refused: err[Fail] = err[Fail].err{refused};
        ret fail.kept(err_refused, tell_clashes(c));
    }
    val refs: usize = vector.length[Reference](?c.out.undefined);
    if (refs == 0 || output.has(c.in.kind, output.UNRESOLVED)) { ret err[Fail].ok{}; }
    val at:          *Reference = ?c.out.undefined.data[0];
    val f:           Fail       = fail.malformed("the link refers to symbols nothing defines");
    val err_refused: err[Fail]  = err[Fail].err{fail.in_file(f, input.at(c.in.inputs, at.input).name)};
    ret fail.kept(err_refused, tell_undefined(c));
}

# the name `name` spelled into the room the caller owns, ended by a zero byte, so the failure
# that names it outlives the link's names
fun spelled_name(c: *Context, name: Id[Name]) res[str, Fail] {
    val bytes:       View      = intern.bytes_of(c.in.names, name);
    val at:          usize     = vector.length[u8](?c.out.spelled);
    var err_spelled: err[Fail] = vectors.extend[u8](?c.out.spelled, bytes.data, bytes.len);
    if (!sel err_spelled.err) { err_spelled = vectors.push[u8](?c.out.spelled, 0); }
    if (sel err_spelled.err)  { ret res[str, Fail].err{err_spelled.err}; }
    ret res[str, Fail].ok{(?c.out.spelled.data[at])::str};
}

# whether two parties of a clash are one holder, as when a refusal is over a
# single archive member
fun same_party(a: Party, b: Party) bool {
    if (sel a.input) {
        if (sel b.input) { ret a.input.index == b.input.index; }
        ret false;
    }
    if (sel a.member) {
        if (sel b.member) { ret a.member == b.member; }
    }
    ret false;
}

# the file a party of a clash is named by
fun party_name(c: *Context, p: Party) str {
    if (sel p.input) { ret input.at(c.in.inputs, p.input).name; }
    ret (?c.out.spelled.data[p.member])::str;
}

# write to the notes a line for each holder of each clash, naming the symbol or
# the group signature it is over
fun tell_clashes(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Clash](?c.out.clashes)) {
        val at:        *Clash    = ?c.out.clashes.data[i];
        val name:      View      = intern.bytes_of(c.in.names, at.name);
        val err_first: err[Fail] = diag.note_named(Location{file: party_name(c, at.first)}, name, at.held, c.in.notes);
        if (sel err_first.err) { ret err_first; }
        i = i + 1;
        if (same_party(at.first, at.second)) { cnt; }
        val err_second: err[Fail] = diag.note_named(Location{file: party_name(c, at.second)}, name, at.held, c.in.notes);
        if (sel err_second.err) { ret err_second; }
    }
    ret err[Fail].ok{};
}

# write to the notes a line naming each name nothing defines, then a line
# naming each input that refers to it, then a line for each library a shared
# library of the link depends on that no input describes. on a format whose
# shared libraries claims describe, the line says no claim names a library
# for it, which is how such a format imports a name
fun tell_undefined(c: *Context) err[Fail] {
    val refs:          *Reference      = c.out.undefined.data;
    val opt_describes: opt[*Describer] = c.in.hooks.describes;
    var why:           str             = "nothing defines {}";
    if (sel opt_describes.some) { why = "nothing defines {}, and no claim names a library that provides it"; }
    var i: usize = 0;
    for (i < vector.length[Reference](?c.out.undefined)) {
        val name: View = intern.bytes_of(c.in.names, refs[i].name);
        if (i == 0 || refs[i].name.index != refs[i - 1].name.index) {
            val err_note_named: err[Fail] = diag.note_named(Location{}, name, why, c.in.notes);
            if (sel err_note_named.err) { ret err_note_named; }
        }
        val at:             Location  = Location{file: input.at(c.in.inputs, refs[i].input).name};
        val err_note_named: err[Fail] = diag.note_named(at, name, "{at} refers to {}", c.in.notes);
        if (sel err_note_named.err) { ret err_note_named; }
        i = i + 1;
    }
    ret tell_unlinked(c);
}

# write to the notes a line for each library a shared library input depends on
# that no input of the link describes, once for each library the inputs
# describe, since a name nothing defines may be one only it defines
fun tell_unlinked(c: *Context) err[Fail] {
    val err_index_loaders: err[Fail] = index_loaders(c);
    if (sel err_index_loaders.err) { ret err_index_loaders; }
    var i: usize = 0;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(c.in.inputs, id);
        i = i + 1;
        if (o == nil || sel o.library.none) { cnt; }
        val res_lib: res[Id[Name], Fail] = loader(c.in.inputs, c.in.names, id);
        if (sel res_lib.err)                       { ret err[Fail].err{res_lib.err}; }
        if (loader_input(c, res_lib.ok) != i::u32) { cnt; }
        val at: Location = Location{file: input.at(c.in.inputs, id).name};
        var k:  usize    = 0;
        for (k < table.count[object.Dependency](?o.libraries)) {
            val d: *object.Dependency = table.at[object.Dependency](?o.libraries, table.nth[object.Dependency](k));
            k = k + 1;
            val opt_named: opt[Id[Name]] = d.library.loader;
            if (sel opt_named.none) { cnt; }
            val text:     View          = object.name_of(o, opt_named.some);
            val opt_find: opt[Id[Name]] = intern.find(c.in.names, text.data, text.len);
            if (sel opt_find.some && loader_input(c, opt_find.some) != 0) { cnt; }
            val err_note_named: err[Fail] = diag.note_named(at, text, "{at} depends on {}, which the link does not name", c.in.notes);
            if (sel err_note_named.err) { ret err_note_named; }
        }
    }
    ret err[Fail].ok{};
}

# resolve the inputs from `first` on, which a synthesizer made after resolution
# had run, against the answers `out` already holds. the inputs before `first`
# are not read again: each name's standing is rebuilt from its binding, so a
# definition among the new inputs wins or loses against it by the same ranks,
# and the bindings, imports, commons and undefined references are written
# again, every earlier name keeping its place. archives are not searched
# again, since a new input may not enlarge the link, so a strong reference
# among them to a name nothing defines is an undefined reference like any
# other. a new input holds no group, since its copy could displace one that
# bindings already stand on. `in` supplies the inputs, names, kind and hooks
pub fun extend(in: *In, out: *Resolved, first: usize) err[Fail] {
    val a: *A.Allocator = in.inputs.a;
    var c: Context      = Context{
        in:        in,
        out:       out,
        slots:     vector.init[Slot](a),
        order:     vector.init[Id[Name]](a),
        pending:   vector.init[Id[Name]](a),
        offers:    table.init[Import](a),
        archives:  table.init[Archive](a),
        refs:      vector.init[Reference](a),
        stays:     vector.init[bool](a),
        claimed:   intern.init(a),
        providers: vector.init[u32](a),
    };
    val err_extended: err[Fail] = extended(?c, first);
    val err_drop:     err[Fail] = context_dnit(?c);
    if (sel err_extended.err) { ret err_extended; }
    ret err_drop;
}

# resolve the inputs from `first` on as extend does, refusing one that holds a
# group
fun extended(c: *Context, first: usize) err[Fail] {
    var i: usize = first;
    for (i < input.count(c.in.inputs)) {
        val o: *Object = input.object_of(c.in.inputs, table.nth[Input](i));
        if (o != nil && table.count[Group](?o.groups) != 0) {
            ret err[Fail].err{fail.in_file(fail.unsupported("an input made after resolution holds a group"), input.at(c.in.inputs, table.nth[Input](i)).name)};
        }
        i = i + 1;
    }
    val err_seed: err[Fail] = seed(c);
    if (sel err_seed.err) { ret err_seed; }
    val err_lay_out: err[Fail] = lay_out(c, first);
    if (sel err_lay_out.err) { ret err_lay_out; }
    val err_bind_inputs: err[Fail] = bind_inputs(c, first);
    if (sel err_bind_inputs.err) { ret err_bind_inputs; }
    val err_fallbacks: err[Fail] = fallbacks(c);
    if (sel err_fallbacks.err) { ret err_fallbacks; }
    val err_rewind: err[Fail] = rewind(c);
    if (sel err_rewind.err) { ret err_rewind; }
    val err_publish: err[Fail] = publish(c, false);
    if (sel err_publish.err) { ret err_publish; }
    ret judged(c);
}

# the standing of every name `out` answers, rebuilt from its answers: a
# binding's rank is its winning symbol's, an import's is a library's
fun seed(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Binding](?c.out.bindings)) {
        val b:           Binding          = table.items[Binding](?c.out.bindings)[i];
        val res_slot_of: res[*Slot, Fail] = slot_of(c, b.name);
        if (sel res_slot_of.err) { ret err[Fail].err{res_slot_of.err}; }
        val o:        *Object                     = input.object_of(c.in.inputs, b.input);
        val sym:      *Symbol                     = object.symbol_at(o, b.symbol);
        val s:        *Slot                       = res_slot_of.ok;
        val res_home: res[opt[Id[Section]], Fail] = home_of(o, sym);
        if (sel res_home.err) { ret err[Fail].err{res_home.err}; }
        val opt_home: opt[Id[Section]] = res_home.ok;
        s.copy = false;
        if (sel opt_home.some) { s.copy = signs(o, object.section_at(o, opt_home.some), sym); }
        val opt_own: opt[Id[Group]] = sym.group;
        if (sel opt_own.some) { s.copy = copy_in(o, opt_own.some, sym); }
        s.defined = true;
        s.has     = true;
        s.rank    = rank_of(sym);
        s.unique  = symbol.binds(sym.binding, symbol.UNIQUE);
        s.input   = b.input;
        s.symbol  = b.symbol;
        s.vis     = b.visibility;
        s.alias   = b.alias;
        i         = i + 1;
    }
    i = 0;
    for (i < table.count[Import](?c.out.imports)) {
        val im:          Import           = table.items[Import](?c.out.imports)[i];
        val res_slot_of: res[*Slot, Fail] = slot_of(c, im.name);
        if (sel res_slot_of.err) { ret err[Fail].err{res_slot_of.err}; }
        res_slot_of.ok.defined = true;
        res_slot_of.ok.has     = true;
        res_slot_of.ok.rank    = OFFERED;
        res_slot_of.ok.library = opt[Id[Name]].some{im.library};
        i                      = i + 1;
    }
    i = 0;
    for (i < table.count[Linked](?c.out.linked)) {
        val ln:          Linked           = table.items[Linked](?c.out.linked)[i];
        val res_slot_of: res[*Slot, Fail] = slot_of(c, ln.name);
        if (sel res_slot_of.err) { ret err[Fail].err{res_slot_of.err}; }
        res_slot_of.ok.has    = true;
        res_slot_of.ok.rank   = LINKED;
        res_slot_of.ok.bound  = ln.bound;
        res_slot_of.ok.strong = !ln.weak;
        i                     = i + 1;
    }
    i = 0;
    for (i < vector.length[Storage](?c.out.commons)) {
        val st: Storage = c.out.commons.data[i];
        val s:  *Slot   = slot_at(c, st.name);
        s.size  = st.size;
        s.align = st.align;
        i       = i + 1;
    }
    i = 0;
    for (i < vector.length[Reference](?c.out.undefined)) {
        val r:           Reference        = c.out.undefined.data[i];
        val res_slot_of: res[*Slot, Fail] = slot_of(c, r.name);
        if (sel res_slot_of.err) { ret err[Fail].err{res_slot_of.err}; }
        val err_pushed: err[Fail] = vectors.push[Reference](?c.refs, r);
        if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# empty the answers that publish writes again, and drop the imports a new
# definition displaced
fun rewind(c: *Context) err[Fail] {
    table.clear[Binding](?c.out.bindings);
    vector.clear[u32](?c.out.named);
    vector.clear[Storage](?c.out.commons);
    vector.clear[Reference](?c.out.undefined);
    table.clear[Linked](?c.out.linked);
    vector.clear[u32](?c.out.linking);
    var left: Table[Import] = table.init[Import](c.in.inputs.a);
    var i:    usize         = 0;
    for (i < table.count[Import](?c.out.imports)) {
        val im:           Import        = table.items[Import](?c.out.imports)[i];
        val opt_standing: opt[Id[Name]] = slot_at(c, im.name).library;
        if (sel opt_standing.some) {
            val res_pushed: res[Id[Import], Fail] = table.push[Import](?left, im);
            if (sel res_pushed.err) {
                table.dnit[Import](?left);
                ret err[Fail].err{res_pushed.err};
            }
        }
        i = i + 1;
    }
    val err_old: err[Fail] = table.dnit[Import](?c.out.imports);
    c.out.imports = left;
    ret err_old;
}

# the plain name hook: the link name of `s` is its own name
# ---
# c:   the phase
# o:   the object holding the symbol
# s:   the symbol
# ret: the name, interned in the link's names, or a refusal to intern it
pub fun plain_name(c: *Context, o: *Object, s: *Symbol) res[Id[Name], Fail] {
    val text: View = object.name_of(o, s.name);
    ret intern.intern(c.in.names, text.data, text.len);
}

# the plain imported hook, which records nothing of an import
# ---
# c:   the phase
# id:  the import
# ret: never a failure
pub fun no_record(c: *Context, id: Id[Import]) err[Fail] {
    ret err[Fail].ok{};
}

# the plain asked hook, which asks the link for no name
# ---
# c:   the phase
# ret: never a failure
pub fun asks_none(c: *Context) err[Fail] {
    ret err[Fail].ok{};
}

# note that the input `id` is the member `m` of the archive input `from`, for
# the command line order the copies of a merged definition are compared in
fun pulled_at(c: *Context, id: Id[Input], from: Id[Input], m: Id[contract.Member]) err[Fail] {
    val have: usize = vector.length[u64](?c.pulled);
    if (id.index::usize >= have) {
        val err_grown: err[Fail] = vectors.grow[u64](?c.pulled, id.index::usize + 1 - have);
        if (sel err_grown.err) { ret err_grown; }
    }
    c.pulled.data[id.index] = order_of(from.index, m.index + 1);
    ret err[Fail].ok{};
}

# a place in command line order: an input, or within an archive input one
# of its members by its index plus one
fun order_of(input_index: u32, member: u32) u64 {
    ret (input_index::u64 << 32) | member::u64;
}

# where the loaded input `id` stands in command line order
fun loaded_order(c: *Context, id: Id[Input]) u64 {
    if (id.index::usize < vector.length[u64](?c.pulled)) {
        val at: u64 = c.pulled.data[id.index];
        if (at != 0) { ret at; }
    }
    ret order_of(id.index, 0);
}

# one holder of a copy's name the comparison found: where it stands, the
# identity of its copy, none for a definition that is no copy, and who it is
rec Holder {
    name:     Id[Name];
    order:    u64;
    identity: opt[u64];
    party:    Party;
}

# what reading one unloaded member for comparison takes
# ---
# holders: every holder found, the kept copies' among them
# order:   the member's place in command line order
# party:   the member, as a clash names it
rec Comparing {
    holders: *Vector[Holder];
    order:   u64;
    party:   Party;
}

# compare the copies of merged definitions the link's archive members hold
# without loading them with the copies the link kept, and refuse the first
# two holders of a name in command line order that differ
fun unloaded_copies(c: *Context) err[Fail] {
    var holders:      Vector[Holder] = vector.init[Holder](c.in.inputs.a);
    var err_compared: err[Fail]      = gather_holders(c, ?holders);
    if (!sel err_compared.err) { err_compared = refuse_differing(c, ?holders); }
    ret fail.kept(err_compared, vectors.dnit[Holder](?holders));
}

# gather into `holders` every definition of a bound copy's name that an
# unloaded archive member holds, nothing when no name is bound to a copy
fun gather_holders(c: *Context, holders: *Vector[Holder]) err[Fail] {
    if (!any_copy(c)) { ret err[Fail].ok{}; }
    var offered:      Vector[bool] = vector.init[bool](c.in.inputs.a);
    var err_gathered: err[Fail]    = err[Fail].ok{};
    var i:            usize        = 0;
    for (i < table.count[Archive](?c.archives) && sel err_gathered.ok) {
        err_gathered = archive_holders(c, table.nth[Archive](i), ?offered, holders);
        i            = i + 1;
    }
    ret fail.kept(err_gathered, vectors.dnit[bool](?offered));
}

# whether any name is bound to a copy of a merged definition
fun any_copy(c: *Context) bool {
    var i: usize = 0;
    for (i < vector.length[Id[Name]](?c.order)) {
        if (bound_copy(c, c.order.data[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the name `name` is bound to a copy of a merged definition
fun bound_copy(c: *Context, name: Id[Name]) bool {
    if (name.index::usize >= vector.length[Slot](?c.slots)) { ret false; }
    val s: *Slot = slot_at(c, name);
    ret s.has && s.copy;
}

# read every member of the archive `aid` the link left unloaded whose index
# offers the name of a bound copy, `offered` marking them
fun archive_holders(c: *Context, aid: Id[Archive], offered: *Vector[bool], holders: *Vector[Holder]) err[Fail] {
    if (!table.at[Archive](?c.archives, aid).keyed) {
        # an archive whose keys cannot be taken was never searched, and offers nothing
        val err_keys: err[Fail] = take_keys(c, aid);
        if (sel err_keys.err) { ret err[Fail].ok{}; }
    }
    val arc: *Archive = table.at[Archive](?c.archives, aid);
    vector.clear[bool](offered);
    val err_grown: err[Fail] = vectors.grow[bool](offered, table.count[contract.Member](?arc.members));
    if (sel err_grown.err) { ret err_grown; }
    var any: bool  = false;
    var d:   usize = 0;
    for (d < vector.length[Defines](?arc.defines)) {
        val at: *Defines = ?arc.defines.data[d];
        d = d + 1;
        if (at.member.index::usize >= vector.length[bool](offered) || arc.loaded.data[at.member.index]) { cnt; }
        val text:     View          = intern.bytes_of(?arc.keys, at.key);
        val opt_name: opt[Id[Name]] = intern.find(c.in.names, text.data, text.len);
        if (sel opt_name.none)             { cnt; }
        if (!bound_copy(c, opt_name.some)) { cnt; }
        offered.data[at.member.index] = true;
        any                           = true;
    }
    if (!any) { ret err[Fail].ok{}; }
    var m: usize = 0;
    for (m < vector.length[bool](offered)) {
        if (offered.data[m]) {
            val err_held: err[Fail] = member_holders(c, aid, table.nth[contract.Member](m), holders);
            if (sel err_held.err) { ret err_held; }
        }
        m = m + 1;
    }
    ret err[Fail].ok{};
}

# the spelling `archive(member)` of the member `m` of the archive `aid` in
# the resolution's spellings, a party of a clash
fun member_party(c: *Context, aid: Id[Archive], m: Id[contract.Member]) res[Party, Fail] {
    val arc:         *Archive  = table.at[Archive](?c.archives, aid);
    val file:        str       = input.at(c.in.inputs, arc.input).name;
    val name:        Bytes     = table.at[contract.Member](?arc.members, m).name;
    val at:          usize     = vector.length[u8](?c.out.spelled);
    var err_spelled: err[Fail] = vectors.extend[u8](?c.out.spelled, file::*u8, str_len(file));
    if (!sel err_spelled.err) { err_spelled = vectors.push[u8](?c.out.spelled, '('); }
    if (!sel err_spelled.err) { err_spelled = vectors.extend[u8](?c.out.spelled, name.data, name.len); }
    if (!sel err_spelled.err) { err_spelled = vectors.push[u8](?c.out.spelled, ')'); }
    if (!sel err_spelled.err) { err_spelled = vectors.push[u8](?c.out.spelled, 0); }
    if (sel err_spelled.err)  { ret res[Party, Fail].err{err_spelled.err}; }
    ret res[Party, Fail].ok{Party.member{at}};
}

# read the member `m` of the archive `aid` for its copies, never loading it
fun member_holders(c: *Context, aid: Id[Archive], m: Id[contract.Member], holders: *Vector[Holder]) err[Fail] {
    val res_party: res[Party, Fail] = member_party(c, aid, m);
    if (sel res_party.err) { ret err[Fail].err{res_party.err}; }
    val arc:       *Archive                 = table.at[Archive](?c.archives, aid);
    var bytes:     contract.Input           = table.at[contract.Member](?arc.members, m).input;
    val res_known: res[*Registration, Fail] = registry.sniff(c.in.registry, ?bytes);
    if (sel res_known.err) { ret err[Fail].ok{}; }
    var comparing: Comparing = Comparing{holders: holders, order: order_of(arc.input.index, m.index + 1), party: res_party.ok};
    val err_read:  err[Fail] = visit(c, aid, m, (?comparing)::ptr, held_copies);
    if (sel err_read.ok) { ret err_read; }
    val opt_first: opt[Id[Name]] = offered_copy(c, aid, m);
    if (sel opt_first.none) { ret err[Fail].ok{}; }
    ret clash_of(c, opt_first.some, res_party.ok, res_party.ok, "an archive member offering a copy of {} cannot be read to compare its copy", HOLDS_COPY);
}

# the first name of a bound copy the archive `aid` offers in its member `m`
fun offered_copy(c: *Context, aid: Id[Archive], m: Id[contract.Member]) opt[Id[Name]] {
    val arc: *Archive = table.at[Archive](?c.archives, aid);
    var d:   usize    = 0;
    for (d < vector.length[Defines](?arc.defines)) {
        val at: *Defines = ?arc.defines.data[d];
        d = d + 1;
        if (at.member.index != m.index) { cnt; }
        val text:     View          = intern.bytes_of(?arc.keys, at.key);
        val opt_name: opt[Id[Name]] = intern.find(c.in.names, text.data, text.len);
        if (sel opt_name.none)            { cnt; }
        if (bound_copy(c, opt_name.some)) { ret opt_name; }
    }
    ret opt[Id[Name]].none{};
}

# every definition the member `o` holds of a bound copy's name, its copy's
# identity or none for a definition that is no copy
fun held_copies(c: *Context, aid: Id[Archive], m: Id[contract.Member], o: *Object, probe: ptr) err[Fail] {
    val comparing: *Comparing = probe::*Comparing;
    if (!arch.links(c.in.arch, o.target.arch)) { ret err[Fail].ok{}; }
    var k: usize = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val sym: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
        k = k + 1;
        if (!symbol.binds(sym.binding, symbol.EXTERNAL) || sel sym.def.undefined) { cnt; }
        val res_keys: res[Keys, Fail] = keys_of(c, o, sym);
        if (sel res_keys.err)                { ret err[Fail].err{res_keys.err}; }
        if (!bound_copy(c, res_keys.ok.own)) { cnt; }
        val opt_own:      opt[Id[Group]] = sym.group;
        var opt_identity: opt[u64]       = opt[u64].none{};
        if (sel opt_own.some) { opt_identity = signed(o, opt_own.some, sym); }
        or {
            val res_home: res[opt[Id[Section]], Fail] = home_of(o, sym);
            if (sel res_home.err) { ret err[Fail].err{res_home.err}; }
            if (sel res_home.ok.some) {
                val opt_group: opt[Id[Group]] = object.section_at(o, res_home.ok.some).group;
                if (sel opt_group.some) { opt_identity = signed(o, opt_group.some, sym); }
            }
        }
        val err_pushed: err[Fail] = vectors.push[Holder](comparing.holders, Holder{name: res_keys.ok.own, order: comparing.order, identity: opt_identity, party: comparing.party});
        if (sel err_pushed.err) { ret err_pushed; }
    }
    ret err[Fail].ok{};
}

# refuse, for each name some unloaded member holds a different definition
# of, the first two of its holders in command line order that differ, the
# kept copy among them
fun refuse_differing(c: *Context, holders: *Vector[Holder]) err[Fail] {
    val found: usize = vector.length[Holder](holders);
    var i:     usize = 0;
    for (i < found) {
        val name: Id[Name] = holders.data[i].name;
        i = i + 1;
        if (claimed_before(holders, i - 1)) { cnt; }
        val s:     *Slot  = slot_at(c, name);
        var first: Holder = Holder{name: name, order: loaded_order(c, s.input), identity: identity_at(c, s.input, s.symbol), party: Party.input{s.input}};
        var k:     usize  = i - 1;
        for (k < found) {
            val h: Holder = holders.data[k];
            k = k + 1;
            if (h.name.index == name.index && h.order < first.order) { first = h; }
        }
        val opt_second: opt[Holder] = differs_after(c, holders, name, first, s);
        if (sel opt_second.none) { cnt; }
        val held:               Holder   = opt_second.some;
        var why:                str      = "{} is defined beside the copies of its merged definition";
        val opt_first_identity: opt[u64] = first.identity;
        val opt_held_identity:  opt[u64] = held.identity;
        if (sel opt_first_identity.some) {
            if (sel opt_held_identity.some) { why = merged.mismatch(opt_first_identity.some, opt_held_identity.some); }
        }
        val err_clash: err[Fail] = clash_of(c, name, first.party, held.party, why, HOLDS_COPY);
        if (sel err_clash.err) { ret err_clash; }
    }
    ret err[Fail].ok{};
}

# whether a holder before the `at`th already named its name, which is then
# judged
fun claimed_before(holders: *Vector[Holder], at: usize) bool {
    var k: usize = 0;
    for (k < at) {
        if (holders.data[k].name.index == holders.data[at].name.index) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the earliest holder of `name` in command line order after `first` whose
# definition differs from it, the kept copy `s` among the holders
fun differs_after(c: *Context, holders: *Vector[Holder], name: Id[Name], first: Holder, s: *Slot) opt[Holder] {
    var opt_best: opt[Holder] = opt[Holder].none{};
    val kept:     Holder      = Holder{name: name, order: loaded_order(c, s.input), identity: identity_at(c, s.input, s.symbol), party: Party.input{s.input}};
    if (kept.order > first.order && !same_definition(kept, first)) { opt_best = opt[Holder].some{kept}; }
    var k: usize = 0;
    for (k < vector.length[Holder](holders)) {
        val h: Holder = holders.data[k];
        k = k + 1;
        if (h.name.index != name.index || h.order <= first.order || same_definition(h, first)) { cnt; }
        val opt_sofar: opt[Holder] = opt_best;
        if (sel opt_sofar.some) {
            if (opt_sofar.some.order <= h.order) { cnt; }
        }
        opt_best = opt[Holder].some{h};
    }
    ret opt_best;
}

# whether two holders define a name alike: copies of one identity
fun same_definition(a: Holder, b: Holder) bool {
    val opt_a: opt[u64] = a.identity;
    val opt_b: opt[u64] = b.identity;
    if (sel opt_a.some) {
        if (sel opt_b.some) { ret opt_a.some == opt_b.some; }
    }
    ret false;
}
