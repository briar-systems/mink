# the largest section the image makes from the settled record, whose size a
# 32-bit field holds
val MADE_LIMIT: u64 = 0xffff_ffff;

# a neutral section flag and the segment permission it maps to
rec Permission {
    flag: section.Flags;
    bit:  *Constant;
}

val PERMISSION_COUNT: usize                        = 3;
val PERMISSIONS:      [PERMISSION_COUNT]Permission = [PERMISSION_COUNT]Permission{
    Permission{flag: section.ALLOC, bit: ?tables.PF_R},
    Permission{flag: section.WRITE, bit: ?tables.PF_W},
    Permission{flag: section.EXEC, bit: ?tables.PF_X},
};

val KINDS: [4]*Kind = [4]*Kind{?output.STATIC, ?output.DYNAMIC, ?output.PIE, ?output.SHARED};

# the ELF image writer, which builds static and dynamic executables, PIEs and
# shared libraries
pub val WRITER: Writer = Writer{kinds: ?KINDS[0], kind_count: 4, compresses: true, offsets: false, sizing: Sizing.ceiling{}, stack: Stacking{records: Stack.none{}, needs: 0}, write: write, interface: opt[Interfacer].none{}};

# the sections the ELF image makes from the settled record: the GNU property
# note, the build attributes, the identification strings and the table of
# the image's FDEs
pub val TABLES: Declarer = Declarer{declare: declare};

# the settled record a section the image makes is made from: its facts, the
# bytes they own, its traits, what the sections that are not image content
# state and what collection kept
rec Record {
    facts:    *Table[object.Fact];
    store:    *Vector[u8];
    traits:   *Vector[Trait];
    consumed: *Consumed;
    live:     *Live;
}

# the settled record of the image `img`
fun record_of(img: *Image) Record {
    val s: *Settled = img.settled;
    ret Record{facts: ?s.facts, store: ?s.store, traits: ?s.traits, consumed: ?s.consumed, live: img.live};
}

# the bytes of the settled contents `c`, nil for a zero fill
fun settled_bytes(s: *Record, c: *Contents) Bytes {
    if (sel c.zero) { ret Bytes{data: nil, len: 0}; }
    val h: Held = c.held;
    if (sel h.borrowed) { ret h.borrowed; }
    ret Bytes{data: ?s.store.data[h.owned.start], len: h.owned.len};
}

# what the settled facts and traits state for the header of an image for `a`
# in `order`. a build attribute is the attributes section's, and a settled
# ELF fact of one input's section or symbol has no place in an image
fun stated(s: *Record, a: *Arch, order: Order, out: *Header) err[Fail] {
    var i: usize = 0;
    for (i < table.count[object.Fact](s.facts)) {
        val f: *object.Fact = table.at[object.Fact](s.facts, table.nth[object.Fact](i));
        i = i + 1;
        if (f.format != ?format.ELF || fact.attribute(f.key)) { cnt; }
        val res_took: res[bool, Fail] = fact.take(out, f, settled_bytes(s, ?f.data), order);
        if (sel res_took.err) { ret err[Fail].err{fail.in_indexed(res_took.err, "settled fact", (i - 1)::u64)}; }
        if (!res_took.ok) {
            ret err[Fail].err{fail.in_indexed(fail.unsupported("a settled ELF fact names a section or symbol of one input"), "settled fact", (i - 1)::u64)};
        }
    }
    ret fact.encode(out, a, s.traits);
}

# a section the image makes from the settled record, which its declarer
# reserves before layout and the writer fills where layout placed it
# ---
# name:      its name
# kind:      the role it plays
# flags:     its flags
# type:      its sh_type
# segment:   the p_type of the program header that locates it, nil for none
# align:     its alignment
# entsize:   the size of one of its entries, zero for none
# placement: where layout puts it
# reason:    why one past the limit is refused
# bytes:     its bytes
# late:      its bytes are as many zeros as it takes until the writer reads
#            the relocated image for them
# at:        its reservation, once the writer finds it
# placed:    where layout put it, once the writer finds it
rec Made {
    name:      str;
    kind:      *section.Kind;
    flags:     section.Flags;
    type:      *Constant;
    segment:   *Constant;
    align:     u64;
    entsize:   u64;
    placement: Placement;
    reason:    str;
    bytes:     Sink;
    late:      bool;
    at:        Id[Reservation];
    placed:    Placed;
}

# every section the image makes from the settled record `s` for `arch`, each
# that holds bytes, into `out`
fun made(a: *A.Allocator, s: *Record, arch: *Arch, m: *Machine, out: *Vector[Made]) err[Fail] {
    val err_note_made: err[Fail] = note_made(a, s, arch, m, out);
    if (sel err_note_made.err) { ret err_note_made; }
    val err_attributes_made: err[Fail] = attributes_made(a, s, arch, m, out);
    if (sel err_attributes_made.err) { ret err_attributes_made; }
    val err_identification_made: err[Fail] = identification_made(a, s, m, out);
    if (sel err_identification_made.err) { ret err_identification_made; }
    ret header_made(a, s, m, out);
}

# release the bytes of every made section of `t`, then `t`
fun made_dnit(t: *Vector[Made]) err[Fail] {
    var err_first: err[Fail] = err[Fail].ok{};
    var i:         usize     = 0;
    for (i < vector.length[Made](t)) {
        err_first = fail.kept(err_first, sink.dnit(?t.data[i].bytes));
        i         = i + 1;
    }
    ret fail.kept(err_first, vectors.dnit[Made](t));
}

# keep the section `row` in `out`, or release its bytes when it holds none
fun keep(row: Made, out: *Vector[Made]) err[Fail] {
    var r: Made = row;
    if (sink.len(?r.bytes) == 0) { ret sink.dnit(?r.bytes); }
    val err_out_pushed: err[Fail] = vectors.push[Made](out, r);
    if (sel err_out_pushed.err) {
        val err_dropped: err[Fail] = sink.dnit(?r.bytes);
        ret err[Fail].err{err_out_pushed.err};
    }
    ret err[Fail].ok{};
}

# the GNU property note the settled facts and traits state
fun note_made(a: *A.Allocator, s: *Record, arch: *Arch, m: *Machine, out: *Vector[Made]) err[Fail] {
    var h:             Header    = fact.init(a);
    var bytes:         Sink      = sink.init(a, m.shape.order);
    val err_note_body: err[Fail] = note_body(?h, s, arch, m, ?bytes);
    val err_rel:       err[Fail] = fact.dnit(?h);
    if (sel err_note_body.err || sel err_rel.err) {
        val err_dropped: err[Fail] = sink.dnit(?bytes);
        if (sel err_note_body.err) { ret err_note_body; }
        ret err_rel;
    }
    ret keep(Made{
        name:      traits.PROPERTY_SECTION,
        kind:      ?section.NOTE_INFO,
        flags:     section.ALLOC,
        type:      ?tables.SHT_NOTE,
        segment:   ?tables.PT_GNU_PROPERTY,
        align:     m.shape.class.addr::u64,
        placement: Placement.region_end{?reserve.NOTE_END},
        reason:    "the GNU property note passes 4 GiB",
        bytes:     bytes,
    }, out);
}

# the GNU property note the settled record states into `out` through the
# header `h`, nothing when it states no property
fun note_body(h: *Header, s: *Record, arch: *Arch, m: *Machine, out: *Sink) err[Fail] {
    val err_stated: err[Fail] = stated(s, arch, m.shape.order, h);
    if (sel err_stated.err)      { ret err_stated; }
    if (fact.properties(h) == 0) { ret err[Fail].ok{}; }
    ret fact.note(h, out, m.shape.class.addr);
}

# the architecture's build attributes section that the settled traits and
# facts state. an architecture with no such section has no attributes
fun attributes_made(a: *A.Allocator, s: *Record, arch: *Arch, m: *Machine, out: *Vector[Made]) err[Fail] {
    val opt_section_of: opt[*attributes.Section] = traits.section_of(arch);
    if (sel opt_section_of.none) { ret unvendored(s); }
    var parts:               Vector[Part]      = vector.init[Part](a);
    var list:                Vector[Attribute] = vector.init[Attribute](a);
    var bytes:               Sink              = sink.init(a, m.shape.order);
    val err_attributes_body: err[Fail]         = attributes_body(opt_section_of.some, s, arch, ?parts, ?list, ?bytes);
    val err_relp:            err[Fail]         = vectors.dnit[Part](?parts);
    val err_rel:             err[Fail]         = vectors.dnit[Attribute](?list);
    if (sel err_attributes_body.err || sel err_rel.err || sel err_relp.err) {
        val err_dropped: err[Fail] = sink.dnit(?bytes);
        if (sel err_attributes_body.err) { ret err_attributes_body; }
        if (sel err_relp.err)            { ret err_relp; }
        ret err_rel;
    }
    ret keep(Made{
        name:      opt_section_of.some.name,
        kind:      ?section.METADATA,
        type:      opt_section_of.some.type,
        segment:   opt_section_of.some.segment,
        align:     1,
        placement: Placement.region_end{?reserve.UNLOADED_END},
        reason:    "the build attributes pass 4 GiB",
        bytes:     bytes,
    }, out);
}

# the build attributes section `v` the settled record states into `out`,
# through the caller's scratch `parts` and `list`, nothing when it states none
fun attributes_body(v: *attributes.Section, s: *Record, arch: *Arch, parts: *Vector[Part], list: *Vector[Attribute], out: *Sink) err[Fail] {
    val err_attributes_of: err[Fail] = elf_neutral.attributes_of(arch, v, s.traits, s.facts, s.store.data, parts, list);
    if (sel err_attributes_of.err)           { ret err_attributes_of; }
    if (vector.length[Attribute](list) == 0) { ret err[Fail].ok{}; }
    ret attributes.write(v, parts.data, vector.length[Part](parts), list.data, vector.length[Attribute](list), out);
}

# refuse a build attribute the settled facts state for an architecture that
# has none
fun unvendored(s: *Record) err[Fail] {
    var i: usize = 0;
    for (i < table.count[object.Fact](s.facts)) {
        val f: *object.Fact = table.at[object.Fact](s.facts, table.nth[object.Fact](i));
        if (f.format == ?format.ELF && fact.attribute(f.key)) {
            ret err[Fail].err{fail.in_indexed(fail.malformed("the link states build attributes its architecture has none of"), "settled fact", i::u64)};
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the identification strings the inputs state, each distinct one once, in the
# section the naming row gives the kind
fun identification_made(a: *A.Allocator, s: *Record, m: *Machine, out: *Vector[Made]) err[Fail] {
    val k:       section.Key            = section.key_of(?section.COMMENT_STRINGS, 0);
    val res_row: res[*naming.Row, Fail] = naming.row_of(k);
    if (sel res_row.err) { ret err[Fail].err{res_row.err}; }
    val res_name: res[str, Fail] = naming.name_of(k);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    var bytes:       Sink      = sink.init(a, m.shape.order);
    val err_strings: err[Fail] = consume.strings(a, s.consumed, ?bytes);
    if (sel err_strings.err) {
        val err_dropped: err[Fail] = sink.dnit(?bytes);
        ret err_strings;
    }
    ret keep(Made{
        name:      res_name.ok,
        kind:      k.kind,
        flags:     k.kind.flags,
        type:      res_row.ok.type,
        align:     1,
        entsize:   1,
        placement: Placement.region_end{?reserve.UNLOADED_END},
        reason:    "the identification strings pass 4 GiB",
        bytes:     bytes,
    }, out);
}

# the table of the FDEs collection kept, none where it kept none
fun header_made(a: *A.Allocator, s: *Record, m: *Machine, out: *Vector[Made]) err[Fail] {
    val n: u64 = vector.length[collect.Framing](?s.live.frames)::u64;
    if (n == 0) { ret err[Fail].ok{}; }
    val res_size: res[u64, Fail] = eh_header.size_of(n);
    if (sel res_size.err) { ret err[Fail].err{res_size.err}; }
    var bytes:     Sink      = sink.init(a, m.shape.order);
    val err_zeros: err[Fail] = sink.zeros(?bytes, res_size.ok::usize);
    if (sel err_zeros.err) {
        val err_dropped: err[Fail] = sink.dnit(?bytes);
        ret err_zeros;
    }
    ret keep(Made{
        name:      eh_header.SECTION,
        kind:      ?section.UNWIND_INFO,
        flags:     section.ALLOC,
        type:      ?tables.SHT_PROGBITS,
        segment:   ?tables.PT_GNU_EH_FRAME,
        align:     eh_header.ALIGN,
        placement: Placement.region_end{?reserve.CONST_END},
        reason:    "the table of the image's FDEs passes 4 GiB",
        bytes:     bytes,
        late:      true,
    }, out);
}

# refuse an image holding a section of unwind records the link could not cut
# into them, since the table of its FDEs would leave those out and an
# unwinder would not find them
fun listed(in: *reserve.In) err[Fail] {
    if (vector.length[Ref](?in.live.unread) == 0) { ret err[Fail].ok{}; }
    val r: Ref = in.live.unread.data[0];
    ret err[Fail].err{fail.in_file(fail.in_indexed(fail.malformed("the records of an unwind section cannot be read, so the image's table cannot list its FDEs"), "section", r.section.index::u64), input.at(in.inputs, r.input).name)};
}

# program headers beyond one per load segment and one per run of loaded
# notes: PT_PHDR, PT_INTERP, PT_DYNAMIC, PT_TLS, PT_GNU_RELRO, PT_GNU_STACK,
# PT_GNU_EH_FRAME, PT_GNU_PROPERTY and the architecture's attributes
val EXTRA_HEADERS: u64 = 9;

# the file header and a program header for each load segment of the laid out
# image and each other program header the image may carry, a PT_NOTE for each
# loaded note section, the most runs of them there can be
fun headers(img: *Image) res[u64, Fail] {
    val res_machine_of: res[Machine, Fail] = traits.machine_of(img.target.arch);
    if (sel res_machine_of.err) { ret res[u64, Fail].err{res_machine_of.err}; }
    val c:     *Class   = res_machine_of.ok.shape.class;
    val at:    Location = Location{record: "program header"};
    val l:     *Layout  = img.layout;
    var count: u64      = table.count[layout.Segment](?l.segments)::u64 + EXTRA_HEADERS;
    var i:     usize    = 0;
    for (i < table.count[Merged](?l.merged)) {
        val g: *Merged = table.at[Merged](?l.merged, table.nth[Merged](i));
        if (section.has(g.kind, section.NOTE) && sel g.segment.some) { count = count + 1; }
        i = i + 1;
    }
    val res_room: res[u64, Fail] = checked.mul(at, count, c.segment.size::u64);
    if (sel res_room.err) { ret res[u64, Fail].err{res_room.err}; }
    ret checked.add(at, c.header.size::u64, res_room.ok);
}

val MEASURE_COUNT: usize                   = 12;
val MEASURES_ROWS: [MEASURE_COUNT]Measured = [MEASURE_COUNT]Measured{
    Measured{key: ?reserve.HEADERS, measure: headers},
    Measured{key: ?elf_dynamic.INTERP, measure: elf_dynamic.measure_interp},
    Measured{key: ?elf_dynamic.SYMBOLS, measure: elf_dynamic.measure_symbols},
    Measured{key: ?elf_dynamic.STRINGS, measure: elf_dynamic.measure_strings},
    Measured{key: ?elf_dynamic.HASH, measure: elf_dynamic.measure_hash},
    Measured{key: ?elf_dynamic.GNU_HASH, measure: elf_dynamic.measure_gnu_hash},
    Measured{key: ?elf_dynamic.RELOCS, measure: elf_dynamic.measure_relocs},
    Measured{key: ?elf_dynamic.DYNAMIC, measure: elf_dynamic.measure_dynamic},
    Measured{key: ?elf_dynamic.VERSYM, measure: elf_dynamic.measure_versym},
    Measured{key: ?elf_dynamic.VERDEF, measure: elf_dynamic.measure_verdef},
    Measured{key: ?elf_dynamic.VERNEED, measure: elf_dynamic.measure_verneed},
    Measured{key: ?elf_dynamic.PLT_RELOCS, measure: elf_dynamic.measure_plt_relocs},
};

# the measures of the ELF image's headers and dynamic tables
pub val MEASURES: Measures = Measures{rows: ?MEASURES_ROWS[0], count: MEASURE_COUNT};

# reserve every section the image makes from the settled record
fun declare(in: *reserve.In, out: *Reserved) err[Fail] {
    val res_machine_of: res[Machine, Fail] = traits.machine_of(in.arch);
    if (sel res_machine_of.err) { ret err[Fail].err{res_machine_of.err}; }
    val err_listed: err[Fail] = listed(in);
    if (sel err_listed.err) { ret err_listed; }
    var rows:         Vector[Made] = vector.init[Made](in.inputs.a);
    var s:            Record       = Record{facts: in.facts, store: in.store, traits: in.traits, consumed: in.consumed, live: in.live};
    val err_made:     err[Fail]    = made(in.inputs.a, ?s, in.arch, ?res_machine_of.ok, ?rows);
    var err_declared: err[Fail]    = err_made;
    if (!sel err_made.err) { err_declared = declared(in, out, ?rows); }
    val err_rel: err[Fail] = made_dnit(?rows);
    if (sel err_declared.err) { ret err_declared; }
    ret err_rel;
}

# reserve each made section of `rows` at its fixed size
fun declared(in: *reserve.In, out: *Reserved, rows: *Vector[Made]) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Made](rows)) {
        val row:   *Made = ?rows.data[i];
        val size:  u64   = sink.len(?row.bytes)::u64;
        var count: u64   = 0;
        if (row.entsize != 0) { count = size / row.entsize; }
        val res_declare: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
            name:       row.name,
            kind:       row.kind,
            flags:      row.flags,
            align:      row.align,
            sizing:     reserve.Sizing.fixed{size},
            entry_size: row.entsize,
            count:      count,
            placement:  row.placement,
            limit:      MADE_LIMIT,
            reason:     row.reason,
        });
        if (sel res_declare.err) { ret err[Fail].err{res_declare.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the image being built
# ---
# img:     the image record
# machine: the machine, class and byte order
# m:       the model
# names:   the section names
# snames:  the symbol names
# ids:     per model section, its name
# sym_ids: per symbol, its name
# syms:    the symbols, locals first
# index:   per symbol, the index of its section or the reserved index it takes
# shndx:   per symbol, its extended section index, empty when none needs one
# made:    the sections the image makes from the settled record
# tables:  the dynamic tables, for an image a loader binds libraries into
# loaded:  the image is one a loader binds libraries into
# phdr:    the index of its PT_PHDR among the program headers, for such an
#          image
# outputs: how many output sections the model holds after the null section
# first:   the index of the first global symbol
# symtab, strtab, shstrs:
#          the model index of the symbol table, its names and the section
#          names
# syms_given, shndx_given:
#          whether the model holds the symbols, and the extended indexes
rec Build {
    a:           *A.Allocator;
    img:         *Image;
    machine:     Machine;
    m:           Elf;
    names:       Strtab;
    snames:      Strtab;
    ids:         Vector[Id[Name]];
    sym_ids:     Vector[Id[Name]];
    syms:        Table[model.Symbol];
    index:       Vector[Index];
    shndx:       Vector[u32];
    made:        Vector[Made];
    tables:      elf_dynamic.Tables;
    loaded:      bool;
    phdr:        usize;
    outputs:     usize;
    first:       u32;
    symtab:      u32;
    strtab:      u32;
    shstrs:      u32;
    syms_given:  bool;
    shndx_given: bool;
}

# write the image `img` as an ELF executable or shared library
fun write(a: *A.Allocator, img: *Image) res[Sink, Fail] {
    val res_built: res[Elf, Fail] = built(a, img);
    if (sel res_built.err) { ret res[Sink, Fail].err{res_built.err}; }
    var e:       Elf             = res_built.ok;
    val res_out: res[Sink, Fail] = elf_write.write(a, ?e);
    val err_rel: err[Fail]       = model.dnit(?e);
    if (sel res_out.err) { ret res_out; }
    if (sel err_rel.err) {
        var got:         Sink      = res_out.ok;
        val err_release: err[Fail] = sink.dnit(?got);
        ret res[Sink, Fail].err{err_rel.err};
    }
    ret res_out;
}

# the ELF model of the image `img`, every extent in file order, which the
# caller releases with model.dnit. its bytes are its own or borrowed from
# the image's relocated record, so it lives no longer than the image
pub fun built(a: *A.Allocator, img: *Image) res[Elf, Fail] {
    val res_machine: res[Machine, Fail] = traits.machine_of(img.target.arch);
    if (sel res_machine.err) { ret res[Elf, Fail].err{res_machine.err}; }
    val conv: strtab.Convention = strtab.Convention{lead: true, term: strtab.NUL};
    var b:    Build             = Build{
        a:       a,
        img:     img,
        machine: res_machine.ok,
        m:       model.init(a, res_machine.ok.shape),
        names:   strtab.init(a, conv),
        snames:  strtab.init(a, conv),
        ids:     vector.init[Id[Name]](a),
        sym_ids: vector.init[Id[Name]](a),
        syms:    table.init[model.Symbol](a),
        index:   vector.init[Index](a),
        shndx:   vector.init[u32](a),
        made:    vector.init[Made](a),
        tables:  elf_dynamic.tables_init(a),
        loaded:  output.has(img.kind, output.IMPORTS),
    };
    val err_build: err[Fail] = build(?b);
    val err_first: err[Fail] = fail.kept(err_build, parts_dnit(?b));
    if (sel err_first.ok) { ret res[Elf, Fail].ok{b.m}; }
    val err_dropped: err[Fail] = model.dnit(?b.m);
    ret res[Elf, Fail].err{err_first.err};
}

# release what the build holds beside its model
fun parts_dnit(b: *Build) err[Fail] {
    var err_first: err[Fail] = strtab.dnit(?b.names);
    err_first = fail.kept(err_first, strtab.dnit(?b.snames));
    err_first = fail.kept(err_first, vectors.dnit[Id[Name]](?b.ids));
    err_first = fail.kept(err_first, vectors.dnit[Id[Name]](?b.sym_ids));
    err_first = fail.kept(err_first, vectors.dnit[Index](?b.index));
    err_first = fail.kept(err_first, made_dnit(?b.made));
    err_first = fail.kept(err_first, elf_dynamic.tables_dnit(?b.tables));
    if (!b.syms_given)  { err_first = fail.kept(err_first, table.dnit[model.Symbol](?b.syms)); }
    if (!b.shndx_given) { err_first = fail.kept(err_first, vectors.dnit[u32](?b.shndx)); }
    ret err_first;
}

# fill the model of `b`: the made sections, the dynamic tables, the header,
# the sections, the symbols, the tables after them, the program headers and
# the extents in file order
fun build(b: *Build) err[Fail] {
    val err_needs: err[Fail] = needs(b.img);
    if (sel err_needs.err) { ret err_needs; }
    val err_made_out: err[Fail] = made_out(b);
    if (sel err_made_out.err) { ret err_made_out; }
    val err_write: err[Fail] = elf_dynamic.write(b.img, ?b.m, ?b.machine, ?b.tables);
    if (sel err_write.err) { ret err_write; }
    val err_header_out: err[Fail] = header_out(b);
    if (sel err_header_out.err) { ret err_header_out; }
    val err_sections_out: err[Fail] = sections_out(b);
    if (sel err_sections_out.err) { ret err_sections_out; }
    val err_symbols_out: err[Fail] = symbols_out(b);
    if (sel err_symbols_out.err) { ret err_symbols_out; }
    val err_tables_out: err[Fail] = tables_out(b);
    if (sel err_tables_out.err) { ret err_tables_out; }
    val err_segments_out: err[Fail] = segments_out(b);
    if (sel err_segments_out.err) { ret err_segments_out; }
    ret extents_out(b);
}

# refuse a link that needs what the image cannot hold: in an image no loader
# binds libraries into, a relocation or slot a loader applies
fun needs(img: *Image) err[Fail] {
    if (output.has(img.kind, output.IMPORTS))      { ret err[Fail].ok{}; }
    if (vector.length[Site](?img.sites.list) == 0) { ret err[Fail].ok{}; }
    ret err[Fail].err{fail.unsupported("a static image holds no relocations for a loader to apply")};
}

# the file header: the machine, the settled e_flags, EI_OSABI and
# EI_ABIVERSION, the entry, zero for an image that starts at none, and ET_DYN
# for an image the loader may place anywhere
fun header_out(b: *Build) err[Fail] {
    val img:        *Image    = b.img;
    val c:          *Class    = b.machine.shape.class;
    var head:       Header    = fact.init(b.a);
    var rec:        Record    = record_of(img);
    val err_stated: err[Fail] = stated(?rec, img.target.arch, b.machine.shape.order, ?head);
    val opt_osabi:  opt[u8]   = head.osabi;
    var h:          model.Header;
    h.ident.abiversion = head.abiversion;
    val res_flags: res[u32, Fail] = traits.fixed_flags(?b.machine, head.flags);
    val err_rel:   err[Fail]      = fact.dnit(?head);
    if (sel err_stated.err) { ret err_stated; }
    if (sel err_rel.err)    { ret err_rel; }
    if (sel res_flags.err)  { ret err[Fail].err{res_flags.err}; }
    h.flags = res_flags.ok;
    if (sel opt_osabi.some) {
        h.ident.osabi = opt_osabi.some;
    }
    or {
        val sys:      *System       = img.host.sys;
        val opt_code: opt[*os.Code] = os.code(sys, ?format.ELF);
        if (sel opt_code.none)          { ret err[Fail].err{fail.about(fail.unsupported("no input states an ELF OSABI and the system has no ELF code"), sys.name)}; }
        if (opt_code.some.value > 0xff) { ret err[Fail].err{fail.about(fail.overflow("the system's ELF code is wider than EI_OSABI"), sys.name)}; }
        h.ident.osabi = opt_code.some.value::u8;
    }
    var start: u64 = 0;
    if (!sel img.entry.none) {
        val res_entry: res[u64, Fail] = link_image.address_of(?img.entry);
        if (sel res_entry.err) { ret err[Fail].err{res_entry.err}; }
        start = res_entry.ok;
    }
    h.ident.version = tables.EV_CURRENT.value::u8;
    h.type          = tables.ET_EXEC.value::u16;
    if (output.has(img.kind, output.PIC)) { h.type = tables.ET_DYN.value::u16; }
    h.machine   = b.machine.machine;
    h.version   = tables.EV_CURRENT.value::u32;
    h.entry     = start;
    h.ehsize    = c.header.size::u16;
    h.phentsize = c.segment.size::u16;
    h.shentsize = c.section.size::u16;
    b.m.header  = h;
    ret err[Fail].ok{};
}

# push section `s` named `name` into the model
fun push(b: *Build, s: model.Section, name: Id[Name]) err[Fail] {
    val err_room: err[Fail] = vectors.reserve[Id[Name]](?b.ids, 1);
    if (sel err_room.err) { ret err_room; }
    val res_sections_pushed: res[Id[model.Section], Fail] = table.push[model.Section](?b.m.sections, s);
    if (sel res_sections_pushed.err) { ret err[Fail].err{res_sections_pushed.err}; }
    val err_ids_pushed: err[Fail] = vectors.push[Id[Name]](?b.ids, name);
    if (sel err_ids_pushed.err) { ret err[Fail].err{err_ids_pushed.err}; }
    ret err[Fail].ok{};
}

# push section `s` named `name` into the model, its model index
fun push_named(b: *Build, s: model.Section, name: str) res[u32, Fail] {
    val res_add_str: res[Id[Name], Fail] = strtab.add_str(?b.names, name);
    if (sel res_add_str.err) { ret res[u32, Fail].err{res_add_str.err}; }
    val at:         u32       = table.count[model.Section](?b.m.sections)::u32;
    val err_pushed: err[Fail] = push(b, s, res_add_str.ok);
    if (sel err_pushed.err) { ret res[u32, Fail].err{err_pushed.err}; }
    ret res[u32, Fail].ok{at};
}

# the sections the image makes from the settled record, each with the
# reservation its declarer made for it
fun made_out(b: *Build) err[Fail] {
    var rec:      Record    = record_of(b.img);
    val err_made: err[Fail] = made(b.a, ?rec, b.img.target.arch, ?b.machine, ?b.made);
    if (sel err_made.err) { ret err_made; }
    var by:              MapBy[Reserving, u32] = map.init_by[Reserving, u32](b.a, reserving_hash, reserving_equal);
    val err_reserved_by: err[Fail]             = reserved_by(b.img, ?by);
    val err_kept:        err[Fail]             = fail.kept(err_reserved_by, matched(b, ?by));
    val err_dnit_by:     err[A.Error]          = map.dnit_by[Reserving, u32](?by);
    if (sel err_kept.err)    { ret err_kept; }
    if (sel err_dnit_by.err) { ret err[Fail].err{fail.refused(err_dnit_by.err)}; }
    ret late_out(b);
}

# read the bytes of every section the relocated image holds them for, into
# the place layout gave it
fun late_out(b: *Build) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Made](?b.made)) {
        val row: *Made = ?b.made.data[i];
        i = i + 1;
        if (!row.late) { cnt; }
        val m:         *Merged   = table.at[Merged](?b.img.layout.merged, row.placed.merged);
        var bytes:     Sink      = sink.init(b.a, b.machine.shape.order);
        val err_write: err[Fail] = eh_header.write(b.a, b.img, m.address + row.placed.offset, ?bytes);
        if (sel err_write.ok && sink.len(?bytes) != sink.len(?row.bytes)) {
            val err_dropped: err[Fail] = sink.dnit(?bytes);
            ret err[Fail].err{fail.about(fail.internal("a section the image makes is not the size its declarer reserved"), row.name)};
        }
        if (sel err_write.err) {
            val err_dropped: err[Fail] = sink.dnit(?bytes);
            ret err_write;
        }
        val err_release: err[Fail] = sink.dnit(?row.bytes);
        row.bytes = bytes;
        if (sel err_release.err) { ret err_release; }
    }
    ret err[Fail].ok{};
}

# a reservation's name and kind, which find it
rec Reserving {
    name: u32;
    kind: *section.Kind;
}

# the hash of a reservation's key, by its name alone
fun reserving_hash(k: *Reserving) u64 {
    ret fnv1a.step_u32(fnv1a.FNV_INIT, k.name);
}

# whether two reservation keys name one name and kind
fun reserving_equal(x: *Reserving, y: *Reserving) bool {
    ret x.name == y.name && x.kind == y.kind;
}

# index every reservation by its name and kind, the first of each
fun reserved_by(img: *Image, by: *MapBy[Reserving, u32]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Reservation](?img.reserved.tables)) {
        val t:   *Reservation = table.at[Reservation](?img.reserved.tables, table.nth[Reservation](i));
        var key: Reserving    = Reserving{name: t.name.index, kind: t.kind};
        i = i + 1;
        if (map.contains_by[Reserving, u32](by, ?key)) { cnt; }
        val res_put: res[bool, A.Error] = map.insert_by[Reserving, u32](by, key, (i - 1)::u32);
        if (sel res_put.err) { ret err[Fail].err{fail.refused(res_put.err)}; }
    }
    ret err[Fail].ok{};
}

# give each made section its reservation in `by` and where layout put it,
# refused when one is not reserved, is not the size reserved or was not laid
# in an output section
fun matched(b: *Build, by: *MapBy[Reserving, u32]) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Made](?b.made)) {
        val row:                *Made                = ?b.made.data[i];
        val opt_reservation_of: opt[Id[Reservation]] = reservation_of(b.img, by, row);
        if (sel opt_reservation_of.none) { ret err[Fail].err{fail.about(fail.internal("a section the image makes is not reserved"), row.name)}; }
        if (table.at[Reservation](?b.img.reserved.tables, opt_reservation_of.some).size != sink.len(?row.bytes)::u64) {
            ret err[Fail].err{fail.about(fail.internal("a section the image makes is not the size its declarer reserved"), row.name)};
        }
        val sp: Spot = b.img.layout.tables.data[opt_reservation_of.some.index::usize];
        if (!sel sp.section) { ret err[Fail].err{fail.about(fail.internal("a section the image makes lies in no output section"), row.name)}; }
        row.at     = opt_reservation_of.some;
        row.placed = sp.section;
        i          = i + 1;
    }
    ret err[Fail].ok{};
}

# the reservation of the section `row` in the index `by`, none when the
# declarer made none
fun reservation_of(img: *Image, by: *MapBy[Reserving, u32], row: *Made) opt[Id[Reservation]] {
    val opt_find: opt[Id[Name]] = intern.find(img.names, row.name, str_len(row.name));
    if (sel opt_find.none) { ret opt[Id[Reservation]].none{}; }
    var key:       Reserving = Reserving{name: opt_find.some.index, kind: row.kind};
    val opt_found: opt[*u32] = map.get_by[Reserving, u32](by, ?key);
    if (sel opt_found.none) { ret opt[Id[Reservation]].none{}; }
    ret opt[Id[Reservation]].some{Id[Reservation]{index: @opt_found.some}};
}

# where layout placed the section `row`
fun placed_of(b: *Build, row: *Made) Placed {
    ret row.placed;
}

# whether output section `id` holds a section the image makes
fun holds(b: *Build, id: Id[Merged]) bool {
    var i: usize = 0;
    for (i < vector.length[Made](?b.made)) {
        if (placed_of(b, ?b.made.data[i]).merged.index == id.index) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the null section, then every output section in image order, each at the
# index layout gives it
fun sections_out(b: *Build) err[Fail] {
    val l:         *Layout             = b.img.layout;
    val res_empty: res[Id[Name], Fail] = strtab.add_str(?b.names, "");
    if (sel res_empty.err) { ret err[Fail].err{res_empty.err}; }
    val err_section_pushed: err[Fail] = push(b, model.Section{body: Body.empty{}}, res_empty.ok);
    if (sel err_section_pushed.err) { ret err_section_pushed; }
    val n: usize = vector.length[Id[Merged]](?l.order);
    var i: usize = 0;
    for (i < n) {
        val id:                Id[Merged] = l.order.data[i];
        val opt_section_index: opt[u64]   = layout.section_index(l, id);
        if (sel opt_section_index.none)             { ret err[Fail].err{fail.internal("layout numbers no output section")}; }
        if (opt_section_index.some != (i + 1)::u64) { ret err[Fail].err{fail.in_indexed(fail.internal("layout numbers an output section other than its place in the section table"), "output section", i::u64)}; }
        val err_section_out: err[Fail] = section_out(b, id);
        if (sel err_section_out.err) { ret err[Fail].err{fail.in_indexed(err_section_out.err, "output section", i::u64)}; }
        i = i + 1;
    }
    b.outputs = n;
    ret err[Fail].ok{};
}

# push the output section `id` into the model: its header from layout, the
# type of a made section it holds, a dynamic table's own header and body, or
# its relocated bytes, compressed where the image asks
fun section_out(b: *Build, id: Id[Merged]) err[Fail] {
    val m:               *Merged             = table.at[Merged](?b.img.layout.merged, id);
    val v:               View                = intern.bytes_of(b.img.names, m.name);
    val res_names_added: res[Id[Name], Fail] = strtab.add(?b.names, v.data, v.len);
    if (sel res_names_added.err) { ret err[Fail].err{res_names_added.err}; }
    val res_row: res[*naming.Row, Fail] = naming.row_of(section.key_of(m.kind, m.entsize));
    if (sel res_row.err) { ret err[Fail].err{res_row.err}; }
    var s: model.Section = model.Section{
        type:      res_row.ok.type.value::u32,
        flags:     elf_neutral.elf_flags(m.flags),
        addr:      m.address,
        offset:    m.offset,
        length:    m.size,
        addralign: m.align,
        entsize:   m.entsize,
        body:      Body.empty{},
    };
    var i: usize = 0;
    for (i < vector.length[Made](?b.made)) {
        val row: *Made = ?b.made.data[i];
        if (placed_of(b, row).merged.index == id.index) {
            s.type = row.type.value::u32;
        }
        i = i + 1;
    }
    val opt_dyn: opt[*elf_dynamic.Written] = elf_dynamic.written_in(?b.tables, id);
    if (sel opt_dyn.some) { ret dynamic_out(b, s, opt_dyn.some, res_names_added.ok); }
    if (!section.has(m.kind, section.BITS)) {
        s.type = tables.SHT_NOBITS.value::u32;
    }
    or (m.size != 0) {
        val res_body: res[Body, Fail] = contents(b, id, m);
        if (sel res_body.err) { ret err[Fail].err{res_body.err}; }
        s.body = res_body.ok;
        val err_compressed_out: err[Fail] = compressed_out(b, ?s, m, v);
        if (sel err_compressed_out.err) { ret err_compressed_out; }
    }
    ret push(b, s, res_names_added.ok);
}

# the output section `s` the dynamic table `w` fills, its header and body the
# table's, which the model takes
fun dynamic_out(b: *Build, s: model.Section, w: *elf_dynamic.Written, name: Id[Name]) err[Fail] {
    var t: model.Section = s;
    t.type    = w.type;
    t.link    = w.link;
    t.info    = w.info;
    t.entsize = w.entsize;
    if (w.linked)    { t.flags = t.flags | tables.SHF_INFO_LINK.value; }
    if (w.size != 0) { t.body = w.body; }
    val err_name_pushed: err[Fail] = push(b, t, name);
    if (sel err_name_pushed.ok && w.size != 0) { w.given = true; }
    ret err_name_pushed;
}

val DEBUG_PREFIX: str   = ".debug_";
val DEBUG_LEN:    usize = 7;

# whether `v` names a debug section
fun debug_named(v: View) bool {
    if (v.len < DEBUG_LEN) { ret false; }
    var i: usize = 0;
    for (i < DEBUG_LEN) {
        if (v.data[i] != DEBUG_PREFIX[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# compress section `s`, of output section `m` named `v`, when the image asks
# for it and `s` is a debug section no segment loads. the compression header
# aligns to the class's address size
fun compressed_out(b: *Build, s: *model.Section, m: *Merged, v: View) err[Fail] {
    val opt_method: opt[*Method] = b.img.compress;
    if (sel opt_method.none)                                        { ret err[Fail].ok{}; }
    if ((s.flags & tables.SHF_ALLOC.value) != 0 || !debug_named(v)) { ret err[Fail].ok{}; }
    if (sel m.segment.some)                                         { ret err[Fail].err{fail.internal("a debug section no loader maps lies in a segment")}; }
    if (!sel s.body.raw)                                            { ret err[Fail].err{fail.internal("a debug section holds no bytes to compress")}; }
    ret compressed_body(b, s, opt_method.some, model.bytes(?b.m, ?s.body.raw.bytes));
}

# section `s` holding the bytes `bytes` compressed by `method`
fun compressed_body(b: *Build, s: *model.Section, method: *Method, bytes: Bytes) err[Fail] {
    val res_deflate: res[model.Compressed, Fail] = compressed.deflate(b.a, ?b.m, method, bytes.data, bytes.len, s.addralign);
    if (sel res_deflate.err) { ret err[Fail].err{res_deflate.err}; }
    val c:        *Class         = b.machine.shape.class;
    val res_size: res[u64, Fail] = checked.add(Location{record: "output section"}, c.chdr.size::u64, model.bytes(?b.m, ?res_deflate.ok.data).len::u64);
    if (sel res_size.err) { ret err[Fail].err{res_size.err}; }
    s.body      = Body.compressed{res_deflate.ok};
    s.flags     = s.flags | tables.SHF_COMPRESSED.value;
    s.length    = res_size.ok;
    s.addralign = c.addr::u64;
    ret err[Fail].ok{};
}

# the bytes of output section `id`: the relocated bytes, borrowed, or a copy
# of them holding the sections the image makes where layout placed them
fun contents(b: *Build, id: Id[Merged], m: *Merged) res[Body, Fail] {
    val at:      Location       = Location{record: "output section"};
    val rel:     *Vector[u8]    = ?b.img.relocated.bytes;
    val res_end: res[u64, Fail] = checked.add(at, m.offset, m.size);
    if (sel res_end.err)                          { ret res[Body, Fail].err{res_end.err}; }
    if (res_end.ok > vector.length[u8](rel)::u64) { ret res[Body, Fail].err{fail.internal("an output section lies past the relocated bytes")}; }
    val res_to_usize: res[usize, Fail] = checked.to_usize(at, m.size);
    if (sel res_to_usize.err) { ret res[Body, Fail].err{res_to_usize.err}; }
    val base: *u8 = ?rel.data[m.offset::usize];
    if (!holds(b, id)) {
        ret res[Body, Fail].ok{Body.raw{Raw{bytes: Held.borrowed{Bytes{data: base, len: res_to_usize.ok}}, why: Why.opaque{}}}};
    }
    var copy:        Sink            = sink.init(b.a, b.machine.shape.order);
    val res_held:    res[Held, Fail] = filled(b, ?copy, id, base, res_to_usize.ok);
    val err_release: err[Fail]       = sink.dnit(?copy);
    if (sel res_held.err)    { ret res[Body, Fail].err{res_held.err}; }
    if (sel err_release.err) { ret res[Body, Fail].err{err_release.err}; }
    ret res[Body, Fail].ok{Body.raw{Raw{bytes: res_held.ok, why: Why.opaque{}}}};
}

# the `n` bytes at `base` with every section the image makes in output
# section `id` written over them where layout placed it, held by the model,
# built in `copy`
fun filled(b: *Build, copy: *Sink, id: Id[Merged], base: *u8, n: usize) res[Held, Fail] {
    val err_bytes: err[Fail] = sink.bytes(copy, base, n);
    if (sel err_bytes.err) { ret res[Held, Fail].err{err_bytes.err}; }
    var i: usize = 0;
    for (i < vector.length[Made](?b.made)) {
        val row:    *Made  = ?b.made.data[i];
        val placed: Placed = placed_of(b, row);
        i = i + 1;
        if (placed.merged.index != id.index) { cnt; }
        val err_splice: err[Fail] = splice(copy, row, placed.offset);
        if (sel err_splice.err) { ret res[Held, Fail].err{err_splice.err}; }
    }
    ret model.own(?b.m, sink.data(copy), sink.len(copy));
}

# write the bytes of the section `row` over `copy` at `offset`
fun splice(copy: *Sink, row: *Made, offset: u64) err[Fail] {
    val n: usize = sink.len(?row.bytes);
    if (offset + n::u64 > sink.len(copy)::u64) { ret err[Fail].err{fail.about(fail.internal("a section the image makes lies past its output section"), row.name)}; }
    val dst: *u8   = sink.data(copy);
    val src: *u8   = sink.data(?row.bytes);
    var k:   usize = 0;
    for (k < n) {
        dst[offset::usize + k] = src[k];
        k                      = k + 1;
    }
    ret err[Fail].ok{};
}

# the symbol table: the null symbol, the local symbols of every object input
# and the definitions the image keeps local, then the global definitions,
# each with the value its kind's value row writes from the one layout gave
# it, and the names the link defines itself among them by their rows. a
# symbol with no value in the image, as one of a dropped section, is left out
fun symbols_out(b: *Build) err[Fail] {
    val img:       *Image              = b.img;
    val n:         usize               = table.count[Binding](?img.resolved.bindings);
    val res_empty: res[Id[Name], Fail] = strtab.add_str(?b.snames, "");
    if (sel res_empty.err) { ret err[Fail].err{res_empty.err}; }
    val err_symbol_put: err[Fail] = put(b, res_empty.ok, model.Symbol{}, Index.reserved{tables.SHN_UNDEF.value::u16});
    if (sel err_symbol_put.err) { ret err_symbol_put; }
    var i: usize = 0;
    for (i < input.count(img.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(img.inputs, id);
        i = i + 1;
        if (o == nil || resolve.library(img.resolved, id)) { cnt; }
        var k: usize = 0;
        for (k < table.count[Symbol](?o.symbols)) {
            val err_local_out: err[Fail] = local_out(b, id, o, table.nth[Symbol](k));
            if (sel err_local_out.err) { ret err[Fail].err{fail.in_indexed(fail.in_file(err_local_out.err, input.at(img.inputs, id).name), "symbol", k::u64)}; }
            k = k + 1;
        }
    }
    val err_marks_out: err[Fail] = marks_out(b);
    if (sel err_marks_out.err) { ret err_marks_out; }
    var pass: u8 = 0;
    for (pass < 2) {
        if (pass == 1) { b.first = table.count[model.Symbol](?b.syms)::u32; }
        var k: usize = 0;
        for (k < n) {
            val bd:    *Binding = table.at[Binding](?img.resolved.bindings, table.nth[Binding](k));
            val shown: bool     = symbol.shows(bd.visibility, symbol.EXPORTED);
            if (shown == (pass == 1)) {
                val err_global_out: err[Fail] = global_out(b, table.nth[Binding](k), !shown);
                if (sel err_global_out.err) { ret err[Fail].err{fail.in_indexed(err_global_out.err, "binding", k::u64)}; }
            }
            k = k + 1;
        }
        val err_linked_out: err[Fail] = linked_out(b, pass == 1);
        if (sel err_linked_out.err) { ret err_linked_out; }
        pass = pass + 1;
    }
    ret err[Fail].ok{};
}

# the mapping symbols that mark the islands, local symbols of no type
fun marks_out(b: *Build) err[Fail] {
    val img:           *Image       = b.img;
    var all:           Vector[Mark] = vector.init[Mark](b.a);
    val err_islands:   err[Fail]    = marks.islands(b.a, img.inputs, img.resolved, img.layout, img.reserved, img.mapping, ?all);
    var err_marks_put: err[Fail]    = err_islands;
    if (sel err_islands.ok) { err_marks_put = marks_put(b, ?all); }
    ret fail.kept(err_marks_put, vectors.dnit[Mark](?all));
}

# put each mark of `all` as a local symbol of no type at its address
fun marks_put(b: *Build, all: *Vector[Mark]) err[Fail] {
    val res_codes: res[Coded, Fail] = elf_neutral.symbol_codes(?symbol.LOCAL, ?symbol.NOTYPE, ?symbol.DEFAULT);
    if (sel res_codes.err) { ret err[Fail].err{res_codes.err}; }
    var i: usize = 0;
    for (i < vector.length[Mark](all)) {
        val mk:                *Mark    = ?all.data[i];
        val opt_section_index: opt[u64] = layout.section_index(b.img.layout, mk.merged);
        i = i + 1;
        if (sel opt_section_index.none)           { ret err[Fail].err{fail.internal("layout numbers no output section")}; }
        if (opt_section_index.some > 0xffff_ffff) { ret err[Fail].err{fail.overflow("a section index passes 32 bits")}; }
        val res_snames_added: res[Id[Name], Fail] = strtab.add(?b.snames, mk.name.data, mk.name.len);
        if (sel res_snames_added.err) { ret err[Fail].err{res_snames_added.err}; }
        val err_symbol_put: err[Fail] = put(b, res_snames_added.ok, model.Symbol{info: res_codes.ok.info, other: res_codes.ok.other, value: mk.address}, Index.section{opt_section_index.some::u32});
        if (sel err_symbol_put.err) { ret err_symbol_put; }
    }
    ret err[Fail].ok{};
}

# the names the link defines itself whose binding the image writes global
# when `shown`, local otherwise, each at the value layout gave it, in the
# output section it lies relative to or absolute, with its row's binding,
# local when its visibility exports it from no image, visibility and kind
fun linked_out(b: *Build, shown: bool) err[Fail] {
    val img: *Image = b.img;
    val n:   usize  = table.count[resolve.Linked](?img.resolved.linked);
    if (vector.length[Bounded](?img.layout.bounds) != n) { ret err[Fail].err{fail.internal("layout valued other than the names the link defines")}; }
    var i: usize = 0;
    for (i < n) {
        val ln: *resolve.Linked = table.at[resolve.Linked](?img.resolved.linked, table.nth[resolve.Linked](i));
        val bd: *Bounded        = ?img.layout.bounds.data[i];
        i = i + 1;
        val row:  *boundary.Bound = ln.bound;
        val kept: bool            = symbol.binds(row.binding, symbol.EXTERNAL) && symbol.shows(row.visibility, symbol.EXPORTED);
        if (kept != shown) { cnt; }
        var bind: *symbol.Binding = row.binding;
        if (!kept) { bind = ?symbol.LOCAL; }
        val res_codes: res[Coded, Fail] = elf_neutral.symbol_codes(bind, row.kind, row.visibility);
        if (sel res_codes.err) { ret err[Fail].err{fail.in_record(res_codes.err, row.name)}; }
        var index: Index = Index.reserved{tables.SHN_ABS.value::u16};
        if (sel bd.merged.some) {
            val opt_section_index: opt[u64] = layout.section_index(img.layout, bd.merged.some);
            if (sel opt_section_index.none)           { ret err[Fail].err{fail.internal("layout numbers no output section")}; }
            if (opt_section_index.some > 0xffff_ffff) { ret err[Fail].err{fail.overflow("a section index passes 32 bits")}; }
            index = Index.section{opt_section_index.some::u32};
        }
        val v:                View                = intern.bytes_of(img.names, ln.name);
        val res_snames_added: res[Id[Name], Fail] = strtab.add(?b.snames, v.data, v.len);
        if (sel res_snames_added.err) { ret err[Fail].err{res_snames_added.err}; }
        val err_symbol_put: err[Fail] = put(b, res_snames_added.ok, model.Symbol{info: res_codes.ok.info, other: res_codes.ok.other, value: bd.value}, index);
        if (sel err_symbol_put.err) { ret err_symbol_put; }
    }
    ret err[Fail].ok{};
}

# a local symbol of an input, unless it is nameless, a section's, one the
# image leaves out or has no value in the image. a symbol with a link name is
# its binding's
fun local_out(b: *Build, id: Id[Input], o: *Object, k: Id[Symbol]) err[Fail] {
    val s:          *Symbol       = object.symbol_at(o, k);
    val opt_linked: opt[Id[Name]] = resolve.link_name(b.img.resolved, id, k);
    if (sel opt_linked.some)        { ret err[Fail].ok{}; }
    if (s.kind == ?symbol.SECTIONS) { ret err[Fail].ok{}; }
    val v: View = object.name_of(o, s.name);
    if (v.len == 0 || link_image.dropped(b.img, v)) { ret err[Fail].ok{}; }
    val opt_value: opt[u64] = layout.value_of(b.img.layout, id, k);
    if (sel opt_value.none) { ret err[Fail].ok{}; }
    val res_written: res[u64, Fail] = elf_dynamic.symbol_value(b.img.layout, s, opt_value.some);
    if (sel res_written.err) { ret err[Fail].err{res_written.err}; }
    val res_codes: res[Coded, Fail] = elf_neutral.symbol_codes(s.binding, s.kind, s.visibility);
    if (sel res_codes.err) { ret err[Fail].err{res_codes.err}; }
    var size: u64 = 0;
    if (sel s.size.some) { size = s.size.some; }
    ret emit(b, v, res_codes.ok, s, id, res_written.ok, size);
}

# the definition a binding names, local when the image does not export it
fun global_out(b: *Build, id: Id[Binding], local: bool) err[Fail] {
    val img: *Image   = b.img;
    val bd:  *Binding = table.at[Binding](?img.resolved.bindings, id);
    if (bd.alias || resolve.library(img.resolved, bd.input)) { ret err[Fail].ok{}; }
    val opt_value: opt[u64] = layout.value_of(img.layout, bd.input, bd.symbol);
    if (sel opt_value.none) { ret err[Fail].ok{}; }
    val o:           *Symbol        = object.symbol_at(input.object_of(img.inputs, bd.input), bd.symbol);
    val res_written: res[u64, Fail] = elf_dynamic.symbol_value(img.layout, o, opt_value.some);
    if (sel res_written.err) { ret err[Fail].err{res_written.err}; }
    var bind: *symbol.Binding = o.binding;
    var kind: *symbol.Kind    = o.kind;
    var size: u64             = 0;
    if (sel o.size.some) { size = o.size.some; }
    if (local)           { bind = ?symbol.LOCAL; }
    val res_codes: res[Coded, Fail] = elf_neutral.symbol_codes(bind, kind, bd.visibility);
    if (sel res_codes.err)  { ret err[Fail].err{res_codes.err}; }
    if (sel o.version.none) { ret emit(b, intern.bytes_of(img.names, bd.name), res_codes.ok, o, bd.input, res_written.ok, size); }
    val res_index: res[Index, Fail] = elf_dynamic.symbol_index(img.layout, o, bd.input);
    if (sel res_index.err) { ret err[Fail].err{res_index.err}; }
    val res_name_out: res[Id[Name], Fail] = version.name_out(b.a, input.object_of(img.inputs, bd.input), o, ?b.snames);
    if (sel res_name_out.err) { ret err[Fail].err{res_name_out.err}; }
    ret put(b, res_name_out.ok, model.Symbol{info: res_codes.ok.info, other: res_codes.ok.other, value: res_written.ok, bytes: size}, res_index.ok);
}

# add symbol `s` of input `in` named `v` at `value`
fun emit(b: *Build, v: View, codes: Coded, s: *Symbol, in: Id[Input], value: u64, size: u64) err[Fail] {
    val res_index: res[Index, Fail] = elf_dynamic.symbol_index(b.img.layout, s, in);
    if (sel res_index.err) { ret err[Fail].err{res_index.err}; }
    val res_snames_added: res[Id[Name], Fail] = strtab.add(?b.snames, v.data, v.len);
    if (sel res_snames_added.err) { ret err[Fail].err{res_snames_added.err}; }
    ret put(b, res_snames_added.ok, model.Symbol{info: codes.info, other: codes.other, value: value, bytes: size}, res_index.ok);
}

# add the symbol `s` named `name` with the section index `index`
fun put(b: *Build, name: Id[Name], s: model.Symbol, index: Index) err[Fail] {
    val res_syms_pushed: res[Id[model.Symbol], Fail] = table.push[model.Symbol](?b.syms, s);
    if (sel res_syms_pushed.err) { ret err[Fail].err{res_syms_pushed.err}; }
    val err_sym_ids_pushed: err[Fail] = vectors.push[Id[Name]](?b.sym_ids, name);
    if (sel err_sym_ids_pushed.err) { ret err[Fail].err{err_sym_ids_pushed.err}; }
    val err_index_pushed: err[Fail] = vectors.push[Index](?b.index, index);
    if (sel err_index_pushed.err) { ret err[Fail].err{err_index_pushed.err}; }
    ret err[Fail].ok{};
}

# the offset of the name `id` in `t`, refused past 32 bits
fun offset_u32(t: *Strtab, id: Id[Name]) res[u32, Fail] {
    val at: u64 = strtab.offset(t, id);
    if (at > 0xffff_ffff) { ret res[u32, Fail].err{fail.overflow("string table is too large for its offsets")}; }
    ret res[u32, Fail].ok{at::u32};
}

# the bytes of string table `t`, held by the model
fun names_body(b: *Build, t: *Strtab) res[Body, Fail] {
    var out:       Sink            = sink.init(b.a, b.machine.shape.order);
    val err_write: err[Fail]       = strtab.write(t, ?out);
    var res_held:  res[Held, Fail] = res[Held, Fail].err{fail.internal("the string table was not written")};
    if (sel err_write.ok) { res_held = model.own(?b.m, sink.data(?out), sink.len(?out)); }
    val err_rel: err[Fail] = sink.dnit(?out);
    if (sel err_write.err) { ret res[Body, Fail].err{err_write.err}; }
    if (sel res_held.err)  { ret res[Body, Fail].err{res_held.err}; }
    if (sel err_rel.err)   { ret res[Body, Fail].err{err_rel.err}; }
    ret res[Body, Fail].ok{Body.raw{Raw{bytes: res_held.ok, why: Why.opaque{}}}};
}

# the symbol table, its names and the section names after the output
# sections, with the extended section indexes when a symbol needs one
fun tables_out(b: *Build) err[Fail] {
    val c:    *Class = b.machine.shape.class;
    val nsym: usize  = table.count[model.Symbol](?b.syms);
    var wide: bool   = false;
    var k:    usize  = 0;
    for (k < nsym) {
        val ix: *Index        = ?b.index.data[k];
        val e:  *model.Symbol = table.at[model.Symbol](?b.syms, table.nth[model.Symbol](k));
        if (sel ix.reserved) { e.shndx = ix.reserved; }
        or (sel ix.section) {
            e.shndx = ix.section::u16;
            if (ix.section >= tables.SHN_LORESERVE.value::u32) {
                e.shndx = tables.SHN_XINDEX.value::u16;
                wide    = true;
            }
        }
        k = k + 1;
    }
    if (wide) {
        val err_grow: err[Fail] = vectors.grow[u32](?b.shndx, nsym);
        if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
        k = 0;
        for (k < nsym) {
            val ix: *Index = ?b.index.data[k];
            if (sel ix.section) { b.shndx.data[k] = ix.section; }
            k = k + 1;
        }
    }
    val err_finish: err[Fail] = strtab.finish(?b.snames);
    if (sel err_finish.err) { ret err_finish; }
    k = 0;
    for (k < nsym) {
        val res_offset_u32: res[u32, Fail] = offset_u32(?b.snames, b.sym_ids.data[k]);
        if (sel res_offset_u32.err) { ret err[Fail].err{res_offset_u32.err}; }
        table.at[model.Symbol](?b.syms, table.nth[model.Symbol](k)).name = res_offset_u32.ok;
        k                                                                = k + 1;
    }
    val res_sizes: res[u64, Fail] = checked.mul(Location{record: ".symtab"}, nsym::u64, c.symbol.size::u64);
    if (sel res_sizes.err) { ret err[Fail].err{res_sizes.err}; }
    b.symtab = table.count[model.Section](?b.m.sections)::u32;
    b.strtab = b.symtab + 1;
    b.shstrs = b.symtab + 2;
    val res_push_named: res[u32, Fail] = push_named(b, model.Section{
        type:      tables.SHT_SYMTAB.value::u32,
        link:      b.strtab,
        info:      b.first,
        addralign: c.addr::u64,
        entsize:   c.symbol.size::u64,
        length:    res_sizes.ok,
        body:      Body.symbols{b.syms},
    }, ".symtab");
    if (sel res_push_named.err) { ret err[Fail].err{res_push_named.err}; }
    b.syms_given = true;
    val res_names: res[Body, Fail] = names_body(b, ?b.snames);
    if (sel res_names.err) { ret err[Fail].err{res_names.err}; }
    val res_push_named_section: res[u32, Fail] = push_named(b, model.Section{type: tables.SHT_STRTAB.value::u32, addralign: 1, length: strtab.size(?b.snames), body: res_names.ok}, ".strtab");
    if (sel res_push_named_section.err) { ret err[Fail].err{res_push_named_section.err}; }
    val res_strtab_pushed: res[u32, Fail] = push_named(b, model.Section{type: tables.SHT_STRTAB.value::u32, addralign: 1, body: Body.empty{}}, ".shstrtab");
    if (sel res_strtab_pushed.err) { ret err[Fail].err{res_strtab_pushed.err}; }
    if (wide) {
        val res_words: res[u64, Fail] = checked.mul(Location{record: ".symtab_shndx"}, nsym::u64, model.WORD::u64);
        if (sel res_words.err) { ret err[Fail].err{res_words.err}; }
        val res_push_named: res[u32, Fail] = push_named(b, model.Section{
            type:      tables.SHT_SYMTAB_SHNDX.value::u32,
            link:      b.symtab,
            addralign: model.WORD::u64,
            entsize:   model.WORD::u64,
            length:    res_words.ok,
            body:      Body.shndx{b.shndx},
        }, ".symtab_shndx");
        if (sel res_push_named.err) { ret err[Fail].err{res_push_named.err}; }
        b.shndx_given = true;
    }
    val err_finish_names: err[Fail] = strtab.finish(?b.names);
    if (sel err_finish_names.err) { ret err_finish_names; }
    var i: usize = 0;
    for (i < table.count[model.Section](?b.m.sections)) {
        val res_offset_u32: res[u32, Fail] = offset_u32(?b.names, b.ids.data[i]);
        if (sel res_offset_u32.err) { ret err[Fail].err{res_offset_u32.err}; }
        model.section_at(?b.m, table.nth[model.Section](i)).name = res_offset_u32.ok;
        i                                                        = i + 1;
    }
    val res_body: res[Body, Fail] = names_body(b, ?b.names);
    if (sel res_body.err) { ret err[Fail].err{res_body.err}; }
    val shstrs: *model.Section = model.section_at(?b.m, table.nth[model.Section](b.shstrs::usize));
    shstrs.body   = res_body.ok;
    shstrs.length = strtab.size(?b.names);
    ret err[Fail].ok{};
}

# the segment permissions of the section flags `f`
pub fun permissions(f: section.Flags) u32 {
    var out: u32   = 0;
    var i:   usize = 0;
    for (i < PERMISSION_COUNT) {
        if ((f & PERMISSIONS[i].flag) != 0) { out = out | PERMISSIONS[i].bit.value::u32; }
        i = i + 1;
    }
    ret out;
}

# push the program header `s` into the model
fun segment(b: *Build, s: Segment) err[Fail] {
    val res_segments_pushed: res[Id[Segment], Fail] = table.push[Segment](?b.m.segments, s);
    if (sel res_segments_pushed.err) { ret err[Fail].err{res_segments_pushed.err}; }
    ret err[Fail].ok{};
}

# the program headers: PT_PHDR for an image a loader binds libraries into
# and PT_INTERP for one it starts, a PT_LOAD per segment of the layout,
# PT_DYNAMIC, then the program header of each section the image makes that
# has one, PT_TLS, PT_GNU_RELRO, PT_GNU_STACK and a PT_NOTE per run of loaded
# notes, all within the room layout left for them
fun segments_out(b: *Build) err[Fail] {
    val l: *Layout = b.img.layout;
    val c: *Class  = b.machine.shape.class;
    val r: u32     = tables.PF_R.value::u32;
    var i: usize   = 0;
    if (b.loaded) {
        b.phdr = table.count[Segment](?b.m.segments);
        val err_segment: err[Fail] = segment(b, Segment{type: tables.PT_PHDR.value::u32, flags: r, offset: c.header.size::u64, align: c.addr::u64});
        if (sel err_segment.err) { ret err_segment; }
        val opt_interp_of: opt[*elf_dynamic.Written] = elf_dynamic.interp_of(?b.tables);
        if (sel opt_interp_of.some) {
            val err_segment: err[Fail] = segment(b, table_segment(opt_interp_of.some, ?tables.PT_INTERP, r, 1));
            if (sel err_segment.err) { ret err_segment; }
        }
    }
    val res_relro_run: res[opt[Relro], Fail] = relro_run(b);
    if (sel res_relro_run.err) { ret err[Fail].err{res_relro_run.err}; }
    val opt_relro: opt[Relro] = res_relro_run.ok;
    for (i < table.count[layout.Segment](?l.segments)) {
        val g:      *layout.Segment = table.at[layout.Segment](?l.segments, table.nth[layout.Segment](i));
        var memory: u64             = g.memory_size;
        if (sel opt_relro.some) {
            val run: Relro = opt_relro.some;
            if (run.segment == i::u32 && run.run.vaddr + run.run.memsz - g.address > memory) { memory = run.run.vaddr + run.run.memsz - g.address; }
        }
        val err_segment: err[Fail] = segment(b, Segment{
            type:   tables.PT_LOAD.value::u32,
            flags:  permissions(g.flags),
            offset: g.offset,
            vaddr:  g.address,
            paddr:  g.loads,
            filesz: g.file_size,
            memsz:  memory,
            align:  g.align,
        });
        if (sel err_segment.err) { ret err_segment; }
        i = i + 1;
    }
    if (b.loaded) {
        val res_dynamic_of: res[*elf_dynamic.Written, Fail] = elf_dynamic.dynamic_of(?b.tables);
        if (sel res_dynamic_of.err) { ret err[Fail].err{res_dynamic_of.err}; }
        val err_segment: err[Fail] = segment(b, table_segment(res_dynamic_of.ok, ?tables.PT_DYNAMIC, r | tables.PF_W.value::u32, c.addr::u64));
        if (sel err_segment.err) { ret err_segment; }
    }
    var k: usize = 0;
    for (k < vector.length[Made](?b.made)) {
        val row: *Made = ?b.made.data[k];
        k = k + 1;
        if (row.segment == nil) { cnt; }
        val err_located: err[Fail] = located(b, row);
        if (sel err_located.err) { ret err_located; }
    }
    val err_tls_out: err[Fail] = tls_out(b);
    if (sel err_tls_out.err) { ret err_tls_out; }
    if (sel opt_relro.some) {
        val err_segment: err[Fail] = segment(b, opt_relro.some.run);
        if (sel err_segment.err) { ret err_segment; }
    }
    var stack: u32 = r | tables.PF_W.value::u32;
    if (executable_stack(b.img)) { stack = stack | tables.PF_X.value::u32; }
    val err_segment: err[Fail] = segment(b, Segment{type: tables.PT_GNU_STACK.value::u32, flags: stack});
    if (sel err_segment.err) { ret err_segment; }
    val err_notes_out: err[Fail] = notes_out(b);
    if (sel err_notes_out.err) { ret err_notes_out; }
    val res_room: res[u64, Fail] = checked.mul(Location{record: "program header"}, table.count[Segment](?b.m.segments)::u64, c.segment.size::u64);
    if (sel res_room.err)                            { ret err[Fail].err{res_room.err}; }
    if (c.header.size::u64 + res_room.ok > l.header) { ret err[Fail].err{fail.overflow("the program headers pass the room layout left for them")}; }
    if (b.loaded)                                    { ret phdr_out(b, res_room.ok); }
    ret err[Fail].ok{};
}

# the program header over the dynamic table `w`, of type `type`, with the
# permissions `flags` and the alignment `align`
fun table_segment(w: *elf_dynamic.Written, type: *Constant, flags: u32, align: u64) Segment {
    ret Segment{type: type.value::u32, flags: flags, offset: w.laid.file, vaddr: w.laid.address, paddr: w.laid.address, filesz: w.size, memsz: w.size, align: align};
}

# PT_PHDR over the `size` bytes of program headers after the file header, at
# the address of the load segment that maps them, refused when none does
fun phdr_out(b: *Build, size: u64) err[Fail] {
    val l:   *Layout  = b.img.layout;
    val off: u64      = b.machine.shape.class.header.size::u64;
    val g:   *Segment = model.segment_at(?b.m, table.nth[Segment](b.phdr));
    var i:   usize    = 0;
    for (i < table.count[layout.Segment](?l.segments)) {
        val s: *layout.Segment = table.at[layout.Segment](?l.segments, table.nth[layout.Segment](i));
        i = i + 1;
        if (off < s.offset || off + size > s.offset + s.file_size) { cnt; }
        g.vaddr  = s.address + (off - s.offset);
        g.paddr  = g.vaddr;
        g.filesz = size;
        g.memsz  = size;
        ret err[Fail].ok{};
    }
    ret err[Fail].err{fail.unsupported("no load segment maps the program headers, which the loader of a dynamic image reads")};
}

# the program header that locates the section `row`: its bytes in the file,
# and in memory when the section is loaded
fun located(b: *Build, row: *Made) err[Fail] {
    val l:        *Layout        = b.img.layout;
    val placed:   Placed         = placed_of(b, row);
    val m:        *Merged        = table.at[Merged](?l.merged, placed.merged);
    val size:     u64            = sink.len(?row.bytes)::u64;
    val at:       Location       = Location{record: row.name};
    val res_off:  res[u64, Fail] = checked.add(at, m.offset, placed.offset);
    val res_addr: res[u64, Fail] = checked.add(at, m.address, placed.offset);
    val res_lma:  res[u64, Fail] = checked.add(at, m.loads, placed.offset);
    if (sel res_off.err)  { ret err[Fail].err{res_off.err}; }
    if (sel res_addr.err) { ret err[Fail].err{res_addr.err}; }
    if (sel res_lma.err)  { ret err[Fail].err{res_lma.err}; }
    var g: Segment = Segment{type: row.segment.value::u32, flags: tables.PF_R.value::u32, offset: res_off.ok, filesz: size, align: row.align};
    if ((row.flags & section.ALLOC) != 0) {
        g.vaddr = res_addr.ok;
        g.paddr = res_lma.ok;
        g.memsz = size;
    }
    ret segment(b, g);
}

# a PT_TLS over the thread-local block, none when the image has none: the
# initialized data the file holds, then the zero fill, in one segment, with
# the block's alignment
fun tls_out(b: *Build) err[Fail] {
    val l:       *Layout  = b.img.layout;
    val opt_tls: opt[Tls] = l.tls;
    if (sel opt_tls.none) { ret err[Fail].ok{}; }
    val block: Tls      = opt_tls.some;
    var run:   Segment  = Segment{type: tables.PT_TLS.value::u32, flags: tables.PF_R.value::u32, vaddr: block.address, paddr: block.address, memsz: block.size, align: block.align};
    var open:  bool     = false;
    var fill:  bool     = false;
    var seg:   u32      = 0;
    val at:    Location = Location{record: "thread-local block"};
    var i:     usize    = 0;
    for (i < vector.length[Id[Merged]](?l.order)) {
        val m: *Merged = table.at[Merged](?l.merged, l.order.data[i]);
        i = i + 1;
        if ((m.flags & section.TLS) == 0) { cnt; }
        val opt_segment: opt[Id[layout.Segment]] = m.segment;
        if (sel opt_segment.none) { ret err[Fail].err{fail.in_indexed(fail.internal("a thread-local section is not loaded"), "output section", (i - 1)::u64)}; }
        if (!open) {
            if (m.address != block.address) { ret err[Fail].err{fail.in_indexed(fail.internal("the first thread-local section does not open the block"), "output section", (i - 1)::u64)}; }
            open       = true;
            seg        = opt_segment.some.index;
            run.offset = m.offset;
            run.paddr  = m.loads;
        }
        if (opt_segment.some.index != seg) { ret err[Fail].err{fail.in_indexed(fail.unsupported("thread-local sections lie in more than one segment"), "output section", (i - 1)::u64)}; }
        if (!section.has(m.kind, section.BITS)) {
            fill = true;
            cnt;
        }
        if (fill) { ret err[Fail].err{fail.in_indexed(fail.internal("initialized thread-local data follows the zero fill"), "output section", (i - 1)::u64)}; }
        val res_offset_added: res[u64, Fail] = checked.add(at, m.offset, m.size);
        if (sel res_offset_added.err) { ret err[Fail].err{res_offset_added.err}; }
        run.filesz = res_offset_added.ok - run.offset;
    }
    ret segment(b, run);
}

# whether the loader writes output section `m` at start and may then protect
# it: it is writable, and its kind is read only once relocated or it is
# thread-local data, whose image the loader only copies from
fun relro(m: *Merged) bool {
    ret (section.has(m.kind, section.RELRO) || (m.flags & section.TLS) != 0) && (m.flags & section.WRITE) != 0;
}

# a PT_GNU_RELRO and the index among the layout's segments of the one it lies
# in, whose PT_LOAD maps memory up to the run's end so every page the loader
# protects is mapped, as a loader whose page is smaller than the run's
# rounding protects up to the end it reads
rec Relro {
    run:     Segment;
    segment: u32;
}

# a PT_GNU_RELRO over the run of writable output sections whose kind is read
# only once relocated or that hold thread-local data, its end rounded up to
# the system's page, the granule the loader protects it in. none when no such
# section holds bytes or no loader maps the image. the run lies in one
# segment, and no other section lies on the pages it covers
fun relro_run(b: *Build) res[opt[Relro], Fail] {
    if (!b.img.host.sys.mapped) { ret res[opt[Relro], Fail].ok{opt[Relro].none{}}; }
    val l:    *Layout  = b.img.layout;
    val at:   Location = Location{record: "relro"};
    var open: bool     = false;
    var run:  Segment  = Segment{type: tables.PT_GNU_RELRO.value::u32, flags: tables.PF_R.value::u32, align: 1};
    var seg:  u32      = 0;
    var i:    usize    = 0;
    for (i < vector.length[Id[Merged]](?l.order)) {
        val m: *Merged = table.at[Merged](?l.merged, l.order.data[i]);
        i = i + 1;
        if (!relro(m) || m.size == 0) { cnt; }
        val opt_segment: opt[Id[layout.Segment]] = m.segment;
        if (sel opt_segment.none) { ret res[opt[Relro], Fail].err{fail.in_indexed(fail.internal("a relro section is not loaded"), "output section", (i - 1)::u64)}; }
        if (!open) {
            open       = true;
            seg        = opt_segment.some.index;
            run.offset = m.offset;
            run.vaddr  = m.address;
            run.paddr  = m.loads;
        }
        if (opt_segment.some.index != seg) { ret res[opt[Relro], Fail].err{fail.in_indexed(fail.unsupported("relro sections lie in more than one segment"), "output section", (i - 1)::u64)}; }
        if (m.address < run.vaddr || m.offset < run.offset) {
            ret res[opt[Relro], Fail].err{fail.in_indexed(fail.internal("a relro section lies before the start of its run"), "output section", (i - 1)::u64)};
        }
        val res_end: res[u64, Fail] = checked.add(at, m.address, m.size);
        if (sel res_end.err)                    { ret res[opt[Relro], Fail].err{res_end.err}; }
        if (res_end.ok - run.vaddr > run.memsz) { run.memsz = res_end.ok - run.vaddr; }
        if (section.has(m.kind, section.BITS)) {
            val res_offset_added: res[u64, Fail] = checked.add(at, m.offset, m.size);
            if (sel res_offset_added.err)                      { ret res[opt[Relro], Fail].err{res_offset_added.err}; }
            if (res_offset_added.ok - run.offset > run.filesz) { run.filesz = res_offset_added.ok - run.offset; }
        }
    }
    if (!open) { ret res[opt[Relro], Fail].ok{opt[Relro].none{}}; }
    val page: u64 = b.img.host.page;
    if (page == 0) { ret res[opt[Relro], Fail].err{fail.about(fail.unsupported("the system states no page size to protect relro data in"), b.img.host.sys.name)}; }
    val res_stop: res[u64, Fail] = checked.align_up(at, run.vaddr + run.memsz, page);
    if (sel res_stop.err) { ret res[opt[Relro], Fail].err{res_stop.err}; }
    run.memsz = res_stop.ok - run.vaddr;
    i         = 0;
    for (i < vector.length[Id[Merged]](?l.order)) {
        val m: *Merged = table.at[Merged](?l.merged, l.order.data[i]);
        i = i + 1;
        if (relro(m) || m.size == 0 || sel m.segment.none) { cnt; }
        if (m.address < res_stop.ok && m.address + m.size > run.vaddr) {
            ret res[opt[Relro], Fail].err{fail.in_indexed(fail.unsupported("a section that is not relro lies on a page the relro run covers"), "output section", (i - 1)::u64)};
        }
    }
    ret res[opt[Relro], Fail].ok{opt[Relro].some{Relro{run: run, segment: seg}}};
}

# whether an input's stack section asks for an executable stack
fun executable_stack(img: *Image) bool {
    ret (consume.flags_of(?img.settled.consumed, ?section.STACK) & section.EXEC) != 0;
}

# a PT_NOTE over each run of loaded notes that lie end to end in one segment
# with one alignment
fun notes_out(b: *Build) err[Fail] {
    val l:    *Layout = b.img.layout;
    var open: bool    = false;
    var run:  Segment = Segment{type: tables.PT_NOTE.value::u32, flags: tables.PF_R.value::u32};
    var seg:  u32     = 0;
    var i:    usize   = 0;
    for (i < vector.length[Id[Merged]](?l.order)) {
        val m: *Merged = table.at[Merged](?l.merged, l.order.data[i]);
        i = i + 1;
        if (!section.has(m.kind, section.NOTE) || m.size == 0) { cnt; }
        val opt_segment: opt[Id[layout.Segment]] = m.segment;
        if (sel opt_segment.none) { cnt; }
        if (open && opt_segment.some.index == seg && m.align == run.align && m.address == run.vaddr + run.memsz && m.offset == run.offset + run.filesz) {
            run.filesz = run.filesz + m.size;
            run.memsz  = run.memsz + m.size;
            cnt;
        }
        if (open) {
            val err_segment: err[Fail] = segment(b, run);
            if (sel err_segment.err) { ret err_segment; }
        }
        open       = true;
        seg        = opt_segment.some.index;
        run.offset = m.offset;
        run.vaddr  = m.address;
        run.paddr  = m.loads;
        run.filesz = m.size;
        run.memsz  = m.size;
        run.align  = m.align;
    }
    if (open) { ret segment(b, run); }
    ret err[Fail].ok{};
}

val ZEROS: [8]u8 = [8]u8{0, 0, 0, 0, 0, 0, 0, 0};

# push the extent `e` into the model's file order
fun extent(b: *Build, e: Extent) err[Fail] {
    val err_extents_pushed: err[Fail] = vectors.push[Extent](?b.m.extents, e);
    if (sel err_extents_pushed.err) { ret err[Fail].err{err_extents_pushed.err}; }
    ret err[Fail].ok{};
}

# the bytes from `from` up to `to`, which no record covers: the relocated
# bytes there where layout placed what lies around them, or else zeros
fun gap(b: *Build, from: u64, to: u64, placed: bool) err[Fail] {
    if (to <= from) { ret err[Fail].ok{}; }
    val rel:  *Vector[u8] = ?b.img.relocated.bytes;
    var held: Held;
    if (!placed && to <= vector.length[u8](rel)::u64) {
        held = Held.borrowed{Bytes{data: ?rel.data[from::usize], len: (to - from)::usize}};
    }
    or (to - from <= 8) {
        held = Held.borrowed{Bytes{data: ?ZEROS[0], len: (to - from)::usize}};
    }
    or (placed) {
        val res_to_usize: res[usize, Fail] = checked.to_usize(Location{record: "image"}, to - from);
        if (sel res_to_usize.err) { ret err[Fail].err{res_to_usize.err}; }
        var pad:       Sink      = sink.init(b.a, b.machine.shape.order);
        val err_zeros: err[Fail] = sink.zeros(?pad, res_to_usize.ok);
        if (sel err_zeros.err) {
            val err_dropped: err[Fail] = sink.dnit(?pad);
            ret err_zeros;
        }
        val res_own:   res[Held, Fail] = model.own(?b.m, sink.data(?pad), res_to_usize.ok);
        val err_freed: err[Fail]       = sink.dnit(?pad);
        if (sel res_own.err)   { ret err[Fail].err{res_own.err}; }
        if (sel err_freed.err) { ret err_freed; }
        held = res_own.ok;
    }
    or {
        ret err[Fail].err{fail.internal("a gap past the relocated bytes is wider than alignment")};
    }
    ret extent(b, Extent.raw{Raw{bytes: held, why: Why.opaque{}}});
}

# whether section `s` holds bytes in the file
fun filed(s: *model.Section) bool {
    ret !sel s.body.empty;
}

# the offsets of the output sections no segment loads, as layout places them
# at the sizes the writer gave them
fun tail_out(b: *Build) err[Fail] {
    val l:                *Layout        = b.img.layout;
    val first:            usize          = l.tail.first::usize;
    var sizes:            Vector[Tailed] = vector.init[Tailed](b.a);
    var offs:             Vector[u64]    = vector.init[u64](b.a);
    val err_tail_placed:  err[Fail]      = tail_placed(b, first, ?sizes, ?offs);
    val err_release:      err[Fail]      = vectors.dnit[Tailed](?sizes);
    val err_release_offs: err[Fail]      = vectors.dnit[u64](?offs);
    ret fail.kept(fail.kept(err_tail_placed, err_release), err_release_offs);
}

# the output sections from `first` in image order given the offsets layout
# places them at, in `sizes` and `offs`
fun tail_placed(b: *Build, first: usize, sizes: *Vector[Tailed], offs: *Vector[u64]) err[Fail] {
    var i: usize = first;
    for (i < b.outputs) {
        val s:    *model.Section = model.section_at(?b.m, table.nth[model.Section](i + 1));
        var size: u64            = 0;
        if (filed(s)) { size = s.length; }
        val err_sizes_pushed: err[Fail] = vectors.push[Tailed](sizes, Tailed{size: size, align: s.addralign});
        if (sel err_sizes_pushed.err) { ret err[Fail].err{err_sizes_pushed.err}; }
        i = i + 1;
    }
    val res_end: res[u64, Fail] = layout.place_tail(b.img.layout, sizes, offs);
    if (sel res_end.err) { ret err[Fail].err{res_end.err}; }
    i = first;
    for (i < b.outputs) {
        val s: *model.Section = model.section_at(?b.m, table.nth[model.Section](i + 1));
        s.offset = offs.data[i - first];
        i        = i + 1;
    }
    ret err[Fail].ok{};
}

# the file in order: the header, the program headers, the output sections at
# the offsets layout gave them, the tables after them, then the section
# headers, every byte between them held raw
fun extents_out(b: *Build) err[Fail] {
    val c:          *Class    = b.machine.shape.class;
    val at:         Location  = Location{record: "image"};
    val err_extent: err[Fail] = extent(b, Extent.header{});
    if (sel err_extent.err) { ret err_extent; }
    val err_extent_segments: err[Fail] = extent(b, Extent.segments{});
    if (sel err_extent_segments.err) { ret err_extent_segments; }
    b.m.header.phoff = c.header.size::u64;
    val err_tail_out: err[Fail] = tail_out(b);
    if (sel err_tail_out.err) { ret err_tail_out; }
    var cursor: u64   = c.header.size::u64 + table.count[Segment](?b.m.segments)::u64 * c.segment.size::u64;
    var i:      usize = 1;
    for (i <= b.outputs) {
        val s:      *model.Section = model.section_at(?b.m, table.nth[model.Section](i));
        val placed: bool           = i - 1 >= b.img.layout.tail.first::usize;
        if (filed(s)) {
            if (s.offset < cursor) { ret err[Fail].err{fail.in_indexed(fail.internal("an output section overlaps what lies before it"), "section", i::u64)}; }
            val err_gap: err[Fail] = gap(b, cursor, s.offset, placed);
            if (sel err_gap.err) { ret err_gap; }
            val err_extent: err[Fail] = extent(b, Extent.section{table.nth[model.Section](i)});
            if (sel err_extent.err) { ret err_extent; }
            cursor = s.offset + s.length;
        }
        i = i + 1;
    }
    for (i < table.count[model.Section](?b.m.sections)) {
        val s:         *model.Section = model.section_at(?b.m, table.nth[model.Section](i));
        val res_start: res[u64, Fail] = checked.align_up(at, cursor, s.addralign);
        if (sel res_start.err) { ret err[Fail].err{res_start.err}; }
        val err_gap: err[Fail] = gap(b, cursor, res_start.ok, true);
        if (sel err_gap.err) { ret err_gap; }
        s.offset = res_start.ok;
        val err_extent: err[Fail] = extent(b, Extent.section{table.nth[model.Section](i)});
        if (sel err_extent.err) { ret err_extent; }
        val res_next: res[u64, Fail] = checked.add(at, res_start.ok, s.length);
        if (sel res_next.err) { ret err[Fail].err{res_next.err}; }
        cursor = res_next.ok;
        i      = i + 1;
    }
    val res_shoff: res[u64, Fail] = checked.align_up(at, cursor, c.addr::u64);
    if (sel res_shoff.err) { ret err[Fail].err{res_shoff.err}; }
    val err_gap: err[Fail] = gap(b, cursor, res_shoff.ok, true);
    if (sel err_gap.err) { ret err_gap; }
    b.m.header.shoff = res_shoff.ok;
    val err_extent_sections: err[Fail] = extent(b, Extent.sections{});
    if (sel err_extent_sections.err) { ret err_extent_sections; }
    ret model.renumber(?b.m, opt[Id[model.Section]].some{table.nth[model.Section](b.shstrs::usize)});
}
