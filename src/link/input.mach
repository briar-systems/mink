# the inputs of a link: the one form a caller names them in, and the set the
# link reads them into
#
# a caller names every input as a request, in link order: a source it holds,
# a file at a path, or a library or a framework found by name, which the
# link's search resolves to sources.
#
# every input a link reads is one entry here, in the order it entered: first
# what the caller hands over, then what the link makes itself. an entry holds
# a neutral object, borrowed from the caller or owned by the set, or a
# container kept whole, and the format model it was read from when it was
# read from bytes. the set owns every object and model it holds and gives them
# back in one release.
#
# the set holds the link's input rule, so gather and resolve, which append
# to it, refuse what a link does not take: a neutral object enters when its
# kind is one a link takes as an object, or one it binds against as a library
# the object describes. every other kind is refused naming the input and the
# kind.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use std.memory;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.base.vectors;
use mink.catalog.kind;
use mink.format.contract;
use mink.format.contract.Model;
use mink.model.claim.Claim;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Section;

# a neutral object the caller built, as a compiler hands its output over in
# memory, borrowed for as long as the link lives
pub rec Given {
    name:   str;
    object: *Object;
}

# whether the image loads a library no live import references
# ---
# unstated:   as the output format's linking row loads such a library
# always:     it loads it whether or not a live import references it
# referenced: it loads it only when a live import references it
pub tag Include: u8 {
    unstated;
    always;
    referenced;
}

# bytes of the caller's with what it states of the library they describe
# ---
# input:    the bytes, as a source's bytes are
# include:  whether the image loads the library when nothing references it
# searched: the caller found them by searching for a library rather than
#           naming them
# path:     the absolute path of the file they are, from which the link
#           takes the directory a runtime search path names, nil for bytes
#           that are no file
pub rec Included {
    input:    contract.Input;
    include:  Include;
    searched: bool;
    path:     str;
}

# what the caller hands a link
# ---
# object:   a neutral object, linked as it is
# bytes:    the bytes of an object, an archive or a library the caller named,
#           sniffed through the format registry, borrowed for as long as the
#           link lives
# included: bytes as `bytes` holds them, with how the image includes the
#           library they describe and whether a search found them
pub tag Source: u8 {
    object:   Given;
    bytes:    contract.Input;
    included: Included;
}

# what a link names by name
# ---
# system:    a library, looked for as the naming's files in the library
#            directories
# framework: a framework, looked for as the naming's bundle files in the
#            framework directories
pub tag Form: u8 {
    system;
    framework;
}

# which files a library's name is searched for, by the steps the system's
# naming states
# ---
# shared_first: the shared library first, falling back to the archive, as the
#               system's linker searches
# static_first: the archive first, falling back to the shared library
# shared_only:  a shared library or a refusal
# static_only:  a static library or a refusal
pub tag Prefer: u8 {
    shared_first;
    static_first;
    shared_only;
    static_only;
}

# a library or a framework a link names
# ---
# form:    which it is
# name:    its name, as `m` names libm and `Cocoa` the Cocoa framework
# include: whether the image loads it when no live import references it
# prefer:  which files a library's name is searched for. a framework is
#          found by its bundle whichever comes first, and one kind alone
#          holds the bundle's file to that kind
pub rec Wanted {
    form:    Form;
    name:    str;
    include: Include;
    prefer:  Prefer;
}

# a file a link names by its path
# ---
# path:    the path, borrowed for as long as the link's refusal is reported
# include: whether the image loads the library the file describes when no
#          live import references it
pub rec File {
    path:    str;
    include: Include;
}

# one input of a link as its caller names it
# ---
# source:  what the caller holds, linked as the source states
# file:    a file at a path
# library: a library or a framework found by name
pub tag Request: u8 {
    source:  Source;
    file:    File;
    library: Wanted;
}

# what finds the files a link claim names, as the caller finds what it names
# itself
# ---
# context: the caller's state, handed back to find
# find:    append to `out` the sources of what the claim names, found as
#          the caller finds a requirement it states, a library by the
#          claim's kind alone with no fallback, nothing for a claim it has
#          found before, and refuse a claim it finds nothing for
pub rec Claimant {
    context: ptr;
    find:    fun(ptr, *Claim, *Vector[Source]) err[Fail];
}

# where an entry's object lives
# ---
# borrowed: the caller's
# owned:    in the set's objects
pub tag Held: u8 {
    borrowed: *Object;
    owned:    Id[Object];
}

# what an entry is
# ---
# object:    a neutral object, and where it lives
# container: a container kept whole, its model the entry's, whose members
#            resolve loads as the link needs them
pub tag Content: u8 {
    object: Held;
    container;
}

# name:     the input's name, for every failure
# content:  what it is
# model:    the format model it was read from, none for a given object or one
#           the link made
# searched: it was found by a search rather than named
# include:  whether the image loads the library it describes when nothing
#           references it
# path:     the absolute path of the file it was read from, or of the
#           container it is a member of, nil when it was read from no file
pub rec Input {
    name:     str;
    content:  Content;
    model:    opt[Id[Model]];
    searched: bool;
    include:  Include;
    path:     str;
}

# a run of entries one phase appended
pub rec Appended {
    first: usize;
    count: usize;
}

# texts: the names of inputs the link made itself, each a copy the set owns
pub rec Inputs {
    a:       *A.Allocator;
    entries: Table[Input];
    objects: Table[Object];
    models:  Table[Model];
    texts:   Vector[str];
}

pub fun make(a: *A.Allocator) Inputs {
    ret Inputs{
        a:       a,
        entries: table.make[Input](a),
        objects: table.make[Object](a),
        models:  table.make[Model](a),
        texts:   vector.init[str](a),
    };
}

# a copy of the bytes `v` with a terminator, which the set owns, to name an
# input the link makes itself
pub fun text(s: *Inputs, v: View) res[str, Fail] {
    val made: res[*u8, A.Error] = A.allocate[u8](s.a, v.len + 1);
    if (sel made.err) { ret res[str, Fail].err{fail.refused(made.err)}; }
    memory.raw_copy(made.ok::ptr, v.data::ptr, v.len);
    made.ok[v.len] = 0;
    val kept: err[Fail] = vectors.push[str](?s.texts, made.ok::str);
    if (sel kept.err) {
        val dropped: err[A.Error] = A.deallocate[u8](s.a, made.ok, v.len + 1);
        ret res[str, Fail].err{kept.err};
    }
    ret res[str, Fail].ok{made.ok::str};
}

pub fun count(s: *Inputs) usize {
    ret table.count[Input](?s.entries);
}

pub fun at(s: *Inputs, id: Id[Input]) *Input {
    ret table.at[Input](?s.entries, id);
}

# the neutral object of `id`, nil for a container. an owned object stays
# where it is until the set next takes one
pub fun object_of(s: *Inputs, id: Id[Input]) *Object {
    val e: *Input = at(s, id);
    if (sel e.content.container)       { ret nil; }
    if (sel e.content.object.borrowed) { ret e.content.object.borrowed; }
    ret table.at[Object](?s.objects, e.content.object.owned);
}

# refuse the object `o` of the input `name` unless a link takes it: as an
# object when its kind declares OBJECT and it describes no library, or as a
# library it binds against when its kind declares BINDS and it describes one
pub fun admit(name: str, o: *Object) err[Fail] {
    if (o.kind == nil) { ret err[Fail].err{fail.in_file(fail.unsupported("an input states no kind of file"), name)}; }
    val binds: bool = kind.has(o.kind, kind.BINDS);
    if (!kind.has(o.kind, kind.OBJECT) && !binds) {
        ret err[Fail].err{fail.about(fail.in_file(fail.malformed("a link takes no input of this kind"), name), o.kind.name)};
    }
    if (binds != (sel o.library.some)) {
        ret err[Fail].err{fail.about(fail.in_file(fail.malformed("an input's kind disagrees with whether it describes a library"), name), o.kind.name)};
    }
    ret err[Fail].ok{};
}

# append the caller's object `g`, refusing one a link does not take
pub fun borrow(s: *Inputs, g: Given) res[Id[Input], Fail] {
    val ok: err[Fail] = admit(g.name, g.object);
    if (sel ok.err) { ret res[Id[Input], Fail].err{ok.err}; }
    ret table.push[Input](?s.entries, Input{name: g.name, content: Content.object{Held.borrowed{g.object}}});
}

# append `o` as an input named `name`, the set owning it from now on, even
# when appending it is refused, as one a link does not take is
pub fun take(s: *Inputs, name: str, o: Object, model: opt[Id[Model]]) res[Id[Input], Fail] {
    var held: Object    = o;
    val ok:   err[Fail] = admit(name, ?held);
    if (sel ok.err) {
        val dropped: err[Fail] = object.release(?held);
        ret res[Id[Input], Fail].err{ok.err};
    }
    # a link binds against what a library describes, never the image it is
    if (sel held.library.some) { table.clear[Section](?held.sections); }
    val id: res[Id[Object], Fail] = table.push[Object](?s.objects, held);
    if (sel id.err) {
        object.release(?held);
        ret res[Id[Input], Fail].err{id.err};
    }
    ret table.push[Input](?s.entries, Input{name: name, content: Content.object{Held.owned{id.ok}}, model: model});
}

# append the container read into the set's model `m` as an input named `name`
pub fun contain(s: *Inputs, name: str, m: Id[Model]) res[Id[Input], Fail] {
    ret table.push[Input](?s.entries, Input{name: name, content: Content.container{}, model: opt[Id[Model]].some{m}});
}

# hold `m` for the life of the link, the set owning it from now on, even when
# holding it is refused
pub fun keep(s: *Inputs, m: Model) res[Id[Model], Fail] {
    var held: Model                = m;
    val id:   res[Id[Model], Fail] = table.push[Model](?s.models, held);
    if (sel id.err) { contract.release(?held); }
    ret id;
}

# give back every owned object and every model, reporting the first refusal
pub fun release(s: *Inputs) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[Object](?s.objects)) {
        val r: err[Fail] = object.release(table.at[Object](?s.objects, table.nth[Object](i)));
        if (sel r.err && sel first.ok) { first = r; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Model](?s.models)) {
        val r: err[Fail] = contract.release(table.at[Model](?s.models, table.nth[Model](i)));
        if (sel r.err && sel first.ok) { first = r; }
        i = i + 1;
    }
    i = 0;
    for (i < vector.length[str](?s.texts)) {
        val t: str          = s.texts.data[i];
        val d: err[A.Error] = A.deallocate[u8](s.a, t::*u8, str_len(t) + 1);
        if (sel d.err) { first = fail.kept(first, err[Fail].err{fail.refused(d.err)}); }
        i = i + 1;
    }
    val rt: err[Fail] = vectors.release[str](?s.texts);
    if (sel rt.err && sel first.ok) { first = rt; }
    val ro: err[Fail] = table.release[Object](?s.objects);
    val rm: err[Fail] = table.release[Model](?s.models);
    val re: err[Fail] = table.release[Input](?s.entries);
    if (sel first.err) { ret first; }
    if (sel ro.err)    { ret ro; }
    if (sel rm.err)    { ret rm; }
    ret re;
}
