# the dynamic linking model: what crosses the image's boundary and what each
# reference needs to cross it
#
# a shared library enters the link as an input that defines symbols for the
# loader to bind and contributes no sections, and several inputs may describe
# one library, as each member of an import library describes its DLL. the
# phase records each library the link takes once, by the name its loader
# knows it by, and what each library input offers, binds every reference a
# library answers to an import of the version the reference names, ranks the
# libraries by the first reference bound to each, decides which the image
# loads, exports every definition another image reaches, and decides for
# every live relocation what it needs:
# its static value alone, a relocation the loader or the start code applies at
# its site, a GOT slot, a PLT entry or stub, a copy of a library's data, a
# function table slot, or a refusal. the decision is the one row of the output
# format's rules whose every axis holds: the relocation kind's capabilities,
# the field it patches, the target's binding, the output kind's capabilities
# and the format's. the rows are disjoint, so their order means nothing. an
# entry a reference reaches is of the slot role the format's route of the
# reach states for the architecture, and a call may go through a code entry
# on its way, so the phase names no slot role. no writer decides any of this
# again, and nothing asks which format it is. a relocation to an index space
# entry rather than a symbol binds nothing across the boundary, so it needs
# its static value alone when its row computes only the entry's index, and is
# refused otherwise.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view.View;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.rule;
use mink.base.rule.Axis;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.kind;
use mink.catalog.os;
use mink.catalog.output;
use mink.catalog.output.Kind;
use catalog_slot: mink.catalog.slot;
use mink.catalog.slot.Reach;
use mink.catalog.slot.SlotRole;
use mink.format.contract.Reader;
use mink.format.readers.Readers;
use mink.link.boundary;
use mink.link.collect;
use mink.link.collect.Live;
use mink.link.collect.Range;
use mink.link.collect.Ref;
use mink.link.input;
use mink.link.input.Given;
use mink.link.input.Input;
use mink.link.input.Inputs;
use mink.link.resolve;
use mink.link.resolve.Binding;
use mink.link.resolve.Resolved;
use mink.model.object;
use mink.model.object.Definition;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Reloc;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.object.Version;
use mink.model.reloc;
use mink.model.section;
use mink.model.symbol;
use mink.model.symbol.Visibility;
use mink.reloc.compute;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.row;

pub def Caps: u64;

# target: the image defines it
pub val DEFINED: Caps = 0x1;
# target: a shared library defines it
pub val IMPORTED: Caps = 0x2;
# target: the image defines it and another image's definition may preempt it
pub val PREEMPTIBLE: Caps = 0x4;
# target: nothing defines it, as a weak reference or an output that keeps
# undefined references allows
pub val UNDEFINED: Caps = 0x8;
# target: the loader decides its address, since it is imported, preemptible,
# or undefined in an output a loader binds
pub val BOUND: Caps = 0x10;
# target: its value is fixed rather than an address in the image
pub val ABSOLUTE: Caps = 0x20;
# target: names code
pub val CODE: Caps = 0x40;
# target: names data
pub val DATA: Caps = 0x80;
# target: names the resolver of an indirect function
pub val RESOLVER: Caps = 0x100;
# target: names thread-local data
pub val THREAD: Caps = 0x200;
# target: names the cell the loader fills with an import's address
pub val CELL: Caps = 0x400;

# site: the field holds a whole address in plain data
pub val WORD: Caps = 0x1;
# site: the section it patches is written at run time, so the loader may
# patch it
pub val WRITABLE: Caps = 0x2;
# site: the field takes only the bits of the value below the page size, which
# do not move with the image
pub val LOW: Caps = 0x4;

# format: a definition in one image may preempt another image's of the same
# name, as a flat symbol lookup lets it
pub val INTERPOSES: Caps = 0x1;
# format: the loader copies a library's data into the executable that refers
# to it directly
pub val COPIES: Caps = 0x2;
# format: a symbol carries a version a reference binds
pub val VERSIONED: Caps = 0x4;

val FORMAT_CAPS: Caps = INTERPOSES | COPIES | VERSIONED;

# outcome: the reference reaches its target itself
pub val AT_TARGET: Caps = 0x1;
# outcome: the reference reaches the target's GOT slot
pub val AT_GOT: Caps = 0x2;
# outcome: the reference reaches the target's PLT entry or stub
pub val AT_PLT: Caps = 0x4;
# outcome: the reference reaches the image's copy of the target
pub val AT_COPY: Caps = 0x8;
# outcome: the reference reaches the target's function table slot, the index
# an indirect call reaches it by
pub val AT_TABLE: Caps = 0x1000;
# outcome: the loader binds the entry reached to the target's name
pub val BIND_ENTRY: Caps = 0x10;
# outcome: the entry reached holds the target's address, moved with the image
pub val REBASE_ENTRY: Caps = 0x20;
# outcome: the entry reached is filled by calling the target's resolver
pub val RESOLVE_ENTRY: Caps = 0x40;
# outcome: the loader binds the site to the target's name
pub val BIND_SITE: Caps = 0x80;
# outcome: the site holds an address the loader moves with the image
pub val REBASE_SITE: Caps = 0x100;
# outcome: the start code fills the entry, since no loader runs
pub val START: Caps = 0x200;
# outcome: the reference is refused, for the reason its row gives
pub val REFUSE: Caps = 0x400;
# outcome: the refusal is of a form mink does not build yet
pub val UNBUILT: Caps = 0x800;

val REACHES: Caps = AT_TARGET | AT_GOT | AT_PLT | AT_COPY | AT_TABLE;
# the reaches to an entry the link makes, each of which a route states
val ENTRY_REACHES: Caps = AT_GOT | AT_PLT | AT_COPY | AT_TABLE;
val ENTRIES:       Caps = BIND_ENTRY | REBASE_ENTRY | RESOLVE_ENTRY;
val SITES:         Caps = BIND_SITE | REBASE_SITE;

# what a reference needs, a row the decision table names
pub rec Outcome {
    name: str;
    caps: Caps;
}

pub val STATIC:             Outcome = Outcome{name: "static", caps: AT_TARGET};
pub val REBASE:             Outcome = Outcome{name: "rebase", caps: AT_TARGET | REBASE_SITE};
pub val BIND:               Outcome = Outcome{name: "bind", caps: AT_TARGET | BIND_SITE};
pub val GOT_STATIC:         Outcome = Outcome{name: "got static", caps: AT_GOT};
pub val GOT_REBASE:         Outcome = Outcome{name: "got rebase", caps: AT_GOT | REBASE_ENTRY};
pub val GOT_BIND:           Outcome = Outcome{name: "got bind", caps: AT_GOT | BIND_ENTRY};
pub val GOT_RESOLVE:        Outcome = Outcome{name: "got resolve", caps: AT_GOT | RESOLVE_ENTRY};
pub val GOT_RESOLVE_START:  Outcome = Outcome{name: "got resolve at start", caps: AT_GOT | RESOLVE_ENTRY | START};
pub val PLT_BIND:           Outcome = Outcome{name: "plt bind", caps: AT_PLT | BIND_ENTRY};
pub val PLT_BIND_REBASE:    Outcome = Outcome{name: "plt bind and rebase", caps: AT_PLT | BIND_ENTRY | REBASE_SITE};
pub val PLT_RESOLVE:        Outcome = Outcome{name: "plt resolve", caps: AT_PLT | RESOLVE_ENTRY};
pub val PLT_RESOLVE_REBASE: Outcome = Outcome{name: "plt resolve and rebase", caps: AT_PLT | RESOLVE_ENTRY | REBASE_SITE};
pub val PLT_RESOLVE_START:  Outcome = Outcome{name: "plt resolve at start", caps: AT_PLT | RESOLVE_ENTRY | START};
pub val COPY:               Outcome = Outcome{name: "copy", caps: AT_COPY | BIND_ENTRY};
pub val TABLE_SLOT:         Outcome = Outcome{name: "function table slot", caps: AT_TABLE};
pub val REFUSED:            Outcome = Outcome{name: "refused", caps: REFUSE};
pub val UNSUPPORTED:        Outcome = Outcome{name: "unsupported", caps: REFUSE | UNBUILT};

# a reach to an entry the link makes
# ---
# reach: the reach
# name:  how a refusal names it
# lands: how a reference of the reach reaches the first entry on its route
rec Reached {
    reach: Caps;
    name:  str;
    lands: Reach;
}

val REACHED_COUNT: usize                  = 4;
val REACHED:       [REACHED_COUNT]Reached = [REACHED_COUNT]Reached{
    Reached{reach: AT_GOT, name: "got", lands: Reach.loaded{}},
    Reached{reach: AT_PLT, name: "plt", lands: Reach.called{}},
    Reached{reach: AT_COPY, name: "copy", lands: Reach.held{}},
    Reached{reach: AT_TABLE, name: "function table", lands: Reach.held{}},
};

# where `reach` sits among the reaches to an entry, none for any other
fun reached_at(reach: Caps) opt[usize] {
    var i: usize = 0;
    for (i < REACHED_COUNT) {
        if (REACHED[i].reach == reach) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# where a reach lands in a format's images on the architectures and hosts
# the route holds for: the slot role of the entry the reference's target
# takes, and for a call the code entry it goes through to that entry
# ---
# name:    how a refusal names the route
# reach:   the reach, one to an entry the link makes
# arch:    over the architecture's capabilities
# host:    over the capabilities the host offers the image, as a loader
#          that binds through chained fixups binds a call's slot at load
# role:    the slot role of the entry the reach lands in
# through: the slot role of the code entry a call goes through on its way to
#          that entry, whose template fills it, none for a reach that lands
#          in its entry directly
pub rec Route {
    name:    str;
    reach:   Caps;
    arch:    Axis;
    host:    Axis;
    role:    *SlotRole;
    through: opt[*SlotRole];
}

# the route of `r` the reach `reach` takes on `a` for a host that offers the
# image `host`, refused naming the reach and the format when the format
# states none
pub fun route_of(r: *Rules, reach: Caps, a: *Arch, host: os.Caps) res[*Route, Fail] {
    val at: opt[usize] = reached_at(reach);
    if (sel at.none) { ret res[*Route, Fail].err{fail.in_record(fail.internal("a route is asked for a reach to no entry"), r.name)}; }
    var i: usize = 0;
    for (i < r.route_count) {
        val w: *Route = ?r.routes[i];
        if (w.reach == reach && rule.holds(?w.arch, a.caps) && rule.holds(?w.host, host)) { ret res[*Route, Fail].ok{w}; }
        i = i + 1;
    }
    ret res[*Route, Fail].err{fail.about(fail.in_record(fail.unsupported("the format states no slot role the reach lands in"), r.name), REACHED[at.some].name)};
}

# the slot role whose entries a reference decided `d` sees as its target:
# the code entry it goes through, or the entry it lands in when that is not
# one it loads from. none for a reference that sees its target itself
pub fun standing(d: *Decision) opt[*SlotRole] {
    if (d.route == nil) { ret opt[*SlotRole].none{}; }
    val w: *Route = d.route;
    if (sel w.through.some)      { ret w.through; }
    if (sel w.role.reach.loaded) { ret opt[*SlotRole].none{}; }
    ret opt[*SlotRole].some{w.role};
}

# the entries the dynamic phase needs of the slot role `r`, in the order the
# reserve phase lays them
pub fun entries_of(d: *Dynamic, r: *SlotRole) *Table[Entry] {
    ret ?d.entries[r.at::usize];
}

# whether the link holds an entry in any slot role
pub fun slotted(d: *Dynamic) bool {
    var i: usize = 0;
    for (i < catalog_slot.SLOT_ROLES) {
        if (table.count[Entry](?d.entries[i]) != 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# one row of a format's decision table
# ---
# name:    how a refusal of the table names the row
# kind:    over the relocation kind's capabilities
# site:    over the field and section the relocation patches
# target:  over the target's binding
# output:  over the output kind's capabilities
# format:  over the format's capabilities
# outcome: what a reference the row holds for needs
# reason:  why a refusing row refuses, nil for any other
pub rec Row {
    name:    str;
    kind:    Axis;
    site:    Axis;
    target:  Axis;
    output:  Axis;
    format:  Axis;
    outcome: *Outcome;
    reason:  str;
}

# a format's dynamic linking rules: its capabilities, its decision table,
# whose rows are disjoint, and its routes, no two of one reach holding on one
# architecture and host
pub rec Rules {
    name:        str;
    caps:        Caps;
    rows:        *Row;
    count:       usize;
    routes:      *Route;
    route_count: usize;
}

# a reference the format's linker makes itself rather than one an input's
# relocation states, which loads its target through a GOT slot
# ---
# reloc: the relocation `reloc` of the input `input` names the target, in a
#        section the link leaves to a table of the format's, as a compact
#        unwind entry names its personality routine. the decision is the
#        relocation's own
# named: a name the loader binds, which a library the link takes offers, as
#        the routine a lazy pointer binds through. the decision is the name's
#        among the named ones
pub tag Made: u8 {
    reloc: Placed;
    named: Id[Name];
}

# a relocation of an input
pub rec Placed {
    input: Id[Input];
    reloc: u32;
}

# the references a format's linker makes, listed once every relocation is
# decided, in `out`
# ---
# make: lists them
pub rec Maker {
    make: fun(*In, *Dynamic, *Table[Made]) err[Fail];
}

# a name the loader binds that the format's linker reaches itself, and what
# the reference to it needs
pub rec Wanted {
    name:     Id[Name];
    decision: Decision;
}

val UNBOUND_ROWS: [2]Row = [2]Row{
    Row{name: "bound", target: Axis{need: BOUND}, outcome: ?UNSUPPORTED, reason: "the format binds no symbol at load time"},
    Row{name: "static", target: Axis{deny: BOUND}, outcome: ?STATIC},
};

# the rules of a format whose images no loader binds symbols into
pub val UNBOUND: Rules = Rules{name: "unbound", caps: 0, rows: ?UNBOUND_ROWS[0], count: 2, routes: nil, route_count: 0};

# what the table decides a reference by
# ---
# kind:   the relocation kind
# site:   the field and section it patches
# target: the target's binding
pub rec Reference {
    kind:   *reloc.Kind;
    site:   Caps;
    target: Caps;
}

pub fun has(o: *Outcome, c: Caps) bool {
    ret (o.caps & c) == c;
}

# a format's dynamic linking rules, checked, with the index decide looks
# their rows up through
pub rec Checked {
    rules: *Rules;
    index: rule.Index;
}

# the axes of a row, in the order axis reads them
val AXES: usize = 5;

# the row of `x` deciding the reference `f` in an output of kind `k`: the one
# whose every axis holds
pub fun decide(x: *Checked, f: *Reference, k: *Kind) res[*Row, Fail] {
    val r:    *Rules     = x.rules;
    var caps: [AXES]u64  = [AXES]u64{reloc.caps(f.kind), f.site, f.target, k.caps, r.caps};
    val w:    opt[usize] = rule.find[Row](?x.index, r.rows, AXES, axis, ?caps[0]);
    if (sel w.some) { ret res[*Row, Fail].ok{?r.rows[w.some]}; }
    ret res[*Row, Fail].err{fail.in_record(fail.internal("no dynamic linking row decides the reference"), r.name)};
}

fun axis(w: *Row, at: usize) *Axis {
    if (at == 0) { ret ?w.kind; }
    or (at == 1) { ret ?w.site; }
    or (at == 2) { ret ?w.target; }
    or (at == 3) { ret ?w.output; }
    ret ?w.format;
}

# whether a definition of visibility `v` in an output of kind `k` may be
# preempted at load time: its visibility allows it, the output's definitions
# may be interposed, and the format lets one image's definition preempt
# another's
pub fun preemptible(r: *Rules, k: *Kind, v: *Visibility) bool {
    ret symbol.shows(v, symbol.PREEMPTIBLE) && output.has(k, output.INTERPOSED) && (r.caps & INTERPOSES) != 0;
}

# refuse rules with a row that cannot stand, a defect of mink: an axis that
# needs what it denies, an outcome of no single reach, a refusal without a
# reason or a reason without one, a binding for a target the loader does not
# bind, a rebase in an output the loader does not move, a resolver run by a
# loader that does not run or at a start that does, a copy anywhere but a
# fixed executable's direct reference to a library's data, two rows that
# can both hold, a route that cannot stand or two routes of one reach that
# can both hold. the index of the rows is built in `a` as they are checked
pub fun check(r: *Rules, a: *A.Allocator) res[Checked, Fail] {
    if ((r.caps & ~FORMAT_CAPS) != 0) { ret res[Checked, Fail].err{fail.in_record(fail.internal("dynamic rules declare an unknown capability"), r.name)}; }
    if (r.count == 0)                 { ret res[Checked, Fail].err{fail.in_record(fail.internal("dynamic rules have no rows"), r.name)}; }
    if (r.route_count != 0 && r.routes == nil) {
        ret res[Checked, Fail].err{fail.in_record(fail.internal("dynamic rules count routes they do not list"), r.name)};
    }
    var i: usize = 0;
    for (i < r.count) {
        val e: err[Fail] = sound(?r.rows[i]);
        if (sel e.err) { ret res[Checked, Fail].err{fail.about(fail.in_record(e.err, r.rows[i].name), r.name)}; }
        i = i + 1;
    }
    i = 0;
    for (i < r.route_count) {
        val e: err[Fail] = routed_soundly(?r.routes[i]);
        if (sel e.err) { ret res[Checked, Fail].err{fail.about(fail.in_record(e.err, r.routes[i].name), r.name)}; }
        i = i + 1;
    }
    val apart: err[Fail] = rule.disjoint[Route](r.routes, r.route_count, routes_meet, route_name);
    if (sel apart.err) { ret res[Checked, Fail].err{fail.in_record(apart.err, r.name)}; }
    val x: res[rule.Index, Fail] = rule.index[Row](a, r.name, r.rows, r.count, AXES, axis, row_name);
    if (sel x.err) { ret res[Checked, Fail].err{x.err}; }
    ret res[Checked, Fail].ok{Checked{rules: r, index: x.ok}};
}

# refuse two rows of `r` that can both hold, reading every pair of rows
# rather than the index check builds
pub fun disjoint(r: *Rules) err[Fail] {
    ret rule.disjoint[Row](r.rows, r.count, meet, row_name);
}

fun meet(a: *Row, b: *Row) bool {
    ret rule.rows_meet[Row](a, b, AXES, axis);
}

pub fun release_checked(x: *Checked) err[Fail] {
    ret rule.release(?x.index);
}

fun row_name(w: *Row) str {
    ret w.name;
}

fun route_name(w: *Route) str {
    ret w.name;
}

fun routes_meet(a: *Route, b: *Route) bool {
    ret a.reach == b.reach && rule.meets(?a.arch, ?b.arch) && rule.meets(?a.host, ?b.host);
}

fun same_reach(a: *Reach, b: *Reach) bool {
    if (sel a.loaded) { ret sel b.loaded; }
    or (sel a.called) { ret sel b.called; }
    ret sel b.held;
}

# refuse a route that cannot stand: one of no reach to an entry, one that
# names no slot role, or one whose entries are not reached the way its reach
# reaches them. a call that goes through a code entry goes through one a
# template fills, to an entry it loads from
fun routed_soundly(w: *Route) err[Fail] {
    if (!coherent(?w.arch) || !coherent(?w.host)) { ret err[Fail].err{fail.internal("an axis needs what it denies")}; }
    val at: opt[usize] = reached_at(w.reach);
    if (sel at.none)   { ret err[Fail].err{fail.internal("a route is of no reach to an entry")}; }
    if (w.role == nil) { ret err[Fail].err{fail.internal("a route names no slot role")}; }
    val lands: *Reach         = ?REACHED[at.some].lands;
    val by:    opt[*SlotRole] = w.through;
    if (sel by.none) {
        if (!same_reach(?w.role.reach, lands)) { ret err[Fail].err{fail.internal("a route lands in an entry its reach does not reach that way")}; }
        ret err[Fail].ok{};
    }
    val code: *SlotRole = by.some;
    if (code == nil || !sel lands.called || !sel code.reach.called || sel code.template.none) {
        ret err[Fail].err{fail.internal("a route goes through what is not a call's code entry a template fills")};
    }
    if (!sel w.role.reach.loaded) { ret err[Fail].err{fail.internal("a call goes through a code entry to an entry it does not load from")}; }
    ret err[Fail].ok{};
}

fun coherent(x: *Axis) bool {
    ret (x.need & x.deny) == 0;
}

# at most one capability of `c`
fun single(c: Caps) bool {
    ret (c & (c - 1)) == 0;
}

fun sound(w: *Row) err[Fail] {
    if (!coherent(?w.kind) || !coherent(?w.site) || !coherent(?w.target) || !coherent(?w.output) || !coherent(?w.format)) {
        ret err[Fail].err{fail.internal("an axis needs what it denies")};
    }
    if (w.outcome == nil) { ret err[Fail].err{fail.internal("a dynamic row names no outcome")}; }
    val o: *Outcome = w.outcome;
    if (has(o, REFUSE) != (w.reason != nil)) { ret err[Fail].err{fail.internal("a reason is given exactly for a refusal")}; }
    if (has(o, REFUSE)) {
        if ((o.caps & ~(REFUSE | UNBUILT)) != 0) { ret err[Fail].err{fail.internal("a refusal needs nothing else")}; }
        ret err[Fail].ok{};
    }
    if (has(o, UNBUILT)) { ret err[Fail].err{fail.internal("an outcome that is not refused is built")}; }
    val reach: Caps = o.caps & REACHES;
    val entry: Caps = o.caps & ENTRIES;
    val site:  Caps = o.caps & SITES;
    if (reach == 0 || !single(reach) || !single(entry) || !single(site)) {
        ret err[Fail].err{fail.internal("an outcome has more than one reach, entry or site relocation")};
    }
    if (reach == AT_TARGET && entry != 0)               { ret err[Fail].err{fail.internal("a reference reaching its target fills no entry")}; }
    if (reach == AT_TABLE && (entry != 0 || site != 0)) { ret err[Fail].err{fail.internal("a function table slot is filled by the link alone")}; }
    if ((reach == AT_PLT || reach == AT_COPY) && entry == 0) {
        ret err[Fail].err{fail.internal("a PLT entry or a copy is filled at load or start")};
    }
    if (reach == AT_COPY && entry != BIND_ENTRY) { ret err[Fail].err{fail.internal("a copy is bound to its library's symbol")}; }
    if (site == BIND_SITE && reach != AT_TARGET) { ret err[Fail].err{fail.internal("a site is bound only where it reaches its target")}; }
    if (has(o, START) && (entry != RESOLVE_ENTRY || site != 0)) {
        ret err[Fail].err{fail.internal("the start code runs resolvers and nothing else")};
    }
    if ((o.caps & (BIND_ENTRY | BIND_SITE)) != 0 && (w.target.need & BOUND) == 0) {
        ret err[Fail].err{fail.internal("a binding is made only for a target the loader binds")};
    }
    if ((o.caps & (REBASE_ENTRY | REBASE_SITE)) != 0 && (w.output.need & output.PIC) == 0) {
        ret err[Fail].err{fail.internal("a rebase is made only in an output the loader moves")};
    }
    if (entry == RESOLVE_ENTRY && has(o, START) != ((w.output.deny & output.IMPORTS) != 0)) {
        ret err[Fail].err{fail.internal("a resolver runs at start exactly where no loader runs")};
    }
    if (entry == RESOLVE_ENTRY && !has(o, START) && (w.output.need & output.IMPORTS) == 0) {
        ret err[Fail].err{fail.internal("a loader runs a resolver only in an output it loads")};
    }
    if (reach == AT_COPY) {
        val target: bool = (w.target.need & (IMPORTED | DATA)) == (IMPORTED | DATA);
        if (!target || (w.output.deny & output.PIC) == 0 || (w.format.need & COPIES) == 0) {
            ret err[Fail].err{fail.internal("a copy is made only of a library's data for a fixed executable of a format that copies")};
        }
    }
    ret err[Fail].ok{};
}

# a shared library the link takes, one per name its loader knows it by
# ---
# loader:   the name the loader knows it by, in the link's names
# input:    the first library input that describes it, whose object states
#           the library's facts
# searched: that input was found by a search rather than named
# rank:     where the first reference bound to it falls among the libraries'
#           first references, from zero, none when no reference binds to it
# loaded:   the image loads it, as the format's linking row decides for a
#           library no reference binds to
pub rec Library {
    loader:   Id[Name];
    input:    Id[Input];
    searched: bool;
    rank:     opt[u32];
    loaded:   bool;
}

# a symbol a library input offers other images
# ---
# library: the library the input describes
# input:   the library input offering it
# name:    its link name
# symbol:  its symbol in the input's object
# version: the version it is defined at, in the link's names, absent when it
#          has none
# default: it is the version an unversioned reference binds
pub rec Offer {
    library: Id[Library];
    input:   Id[Input];
    name:    Id[Name];
    symbol:  Id[Symbol];
    version: opt[Id[Name]];
    default: bool;
}

# a name the loader binds to a library's symbol, one per name and offer, in
# the order the link first refers to each
# ---
# name:    the link name
# library: the library that defines it
# offer:   the symbol it binds
# weak:    every reference to it is weak, so the loader may leave it unbound
pub rec Import {
    name:    Id[Name];
    library: Id[Library];
    offer:   Id[Offer];
    weak:    bool;
}

# a definition the image exports
# ---
# binding:     its binding
# preemptible: another image's definition may preempt it
pub rec Export {
    binding:     Id[Binding];
    preemptible: bool;
}

# a symbol of an input that no other input names
pub rec Local {
    input:  Id[Input];
    symbol: Id[Symbol];
}

# what a reference aims at
# ---
# bound:    a definition of the image
# imported: an import
# local:    a symbol no other input names
# absent:   a name nothing defines
# entry:    an index space entry of the relocating input
# linked:   a name the link defines itself at a place of its layout
# absolute: the absolute address zero
pub tag Aim: u8 {
    bound:    Id[Binding];
    imported: Id[Import];
    local:    Local;
    absent:   Id[Name];
    entry:    Id[object.Entry];
    linked:   Id[Name];
    absolute;
}

# an entry of one slot role the image holds for one target
# ---
# aim:     the target
# outcome: the outcome that first asked for it, which says how it is filled
# lands:   for a code entry a call goes through, the index of the entry it
#          goes to among the entries of its route's role
pub rec Entry {
    aim:     Aim;
    outcome: *Outcome;
    lands:   u32;
}

# what one relocation needs
# ---
# row:     the row deciding it, nil for a relocation of what did not survive
# aim:     what it aims at
# route:   where its reach lands, nil where it reaches its target itself
# entry:   the index of the entry it lands in among those of its route's role
# through: the index of the code entry it goes through among those of its
#          route's code role, where its route goes through one
pub rec Decision {
    row:     *Row;
    aim:     Aim;
    route:   *Route;
    entry:   u32;
    through: u32;
}

# libraries: every shared library the link takes, once, in input order
# offers:    what each library input offers, input by input
# named:     each name's first offer plus one, by name, zero for none
# onward:    the next offer of the same name plus one, by offer, zero for none
# imports:   every name the loader binds to a library's symbol
# exports:   every definition the image exports, in binding order
# entries:   the entries the image needs, by slot role, each role's in the
#            order the link first reaches them
# decisions: what each relocation of each object input needs, input by input
# starts:    the index in decisions of each input's first relocation
# hidden:    every reference from a library to a definition the image hides
# wanted:    every name the format's linker reaches itself, in the order it
#            lists them
pub rec Dynamic {
    libraries: Table[Library];
    offers:    Table[Offer];
    named:     Table[u32];
    onward:    Table[u32];
    imports:   Table[Import];
    exports:   Table[Export];
    entries:   [catalog_slot.SLOT_ROLES]Table[Entry];
    decisions: Table[Decision];
    starts:    Table[u32];
    hidden:    Table[resolve.Reference];
    wanted:    Table[Wanted];
}

# relocs:    the output pair's relocation rows, the fields of relocations are
#            read from
# rules:     the output format's rules
# loads_all: the image loads every library the link takes, rather than only
#            those a reference binds to
# host:      the capabilities the host offers the image, which a route may
#            hold over
# maker:     what lists the references the output format's linker makes
#            itself, none for a format whose linker makes none
pub rec In {
    inputs:    *Inputs;
    names:     *Interner;
    resolved:  *Resolved;
    live:      *Live;
    kind:      *Kind;
    arch:      *Arch;
    rules:     *Rules;
    relocs:    *row.Lookup;
    loads_all: bool;
    host:      os.Caps;
    maker:     opt[*Maker];
}

# where the entries of one table are found by what they aim at, each an index
# plus one, zero for none
rec Index {
    bound:    Table[u32];
    imported: Table[u32];
    local:    Table[u32];
    absent:   Table[u32];
    linked:   Table[u32];
    absolute: Table[u32];
}

# the phase's own state
# ---
# importing: each resolve import's index plus one, by name
# loaders:   each library's index plus one, by the name its loader knows it
#            by
# chain:     the next import of the same name, plus one, by import
# heads:     the first import of each name, plus one, by name
# bases:     the index in kept of each input's first section
# kept:      whether each section of each input survived
# dropped:   the first range each section dropped, plus one
# next:      the next range dropped from the same section, plus one
# index:     where each slot role's entries are found by what they aim at
# routes:    the route of each reach to an entry on the link's architecture,
#            or why the format states none
# ranked:    how many libraries a reference binds to so far
pub rec Context {
    in:        *In;
    out:       *Dynamic;
    importing: Table[u32];
    loaders:   Table[u32];
    chain:     Table[u32];
    heads:     Table[u32];
    bases:     Table[u32];
    kept:      Table[bool];
    dropped:   Table[u32];
    next:      Table[u32];
    index:     [catalog_slot.SLOT_ROLES]Index;
    routes:    [REACHED_COUNT]res[*Route, Fail];
    checked:   Checked;
    ranked:    u32;
}

pub fun make(a: *A.Allocator) Dynamic {
    var d: Dynamic = Dynamic{
        libraries: table.make[Library](a),
        offers:    table.make[Offer](a),
        named:     table.make[u32](a),
        onward:    table.make[u32](a),
        imports:   table.make[Import](a),
        exports:   table.make[Export](a),
        decisions: table.make[Decision](a),
        starts:    table.make[u32](a),
        hidden:    table.make[resolve.Reference](a),
        wanted:    table.make[Wanted](a),
    };
    var i: usize = 0;
    for (i < catalog_slot.SLOT_ROLES) {
        d.entries[i] = table.make[Entry](a);
        i            = i + 1;
    }
    ret d;
}

pub fun release(d: *Dynamic) err[Fail] {
    var first: err[Fail] = table.release[Library](?d.libraries);
    first = fail.kept(first, table.release[Offer](?d.offers));
    first = fail.kept(first, table.release[u32](?d.named));
    first = fail.kept(first, table.release[u32](?d.onward));
    first = fail.kept(first, table.release[Import](?d.imports));
    first = fail.kept(first, table.release[Export](?d.exports));
    var i: usize = 0;
    for (i < catalog_slot.SLOT_ROLES) {
        first = fail.kept(first, table.release[Entry](?d.entries[i]));
        i     = i + 1;
    }
    first = fail.kept(first, table.release[Decision](?d.decisions));
    first = fail.kept(first, table.release[u32](?d.starts));
    first = fail.kept(first, table.release[resolve.Reference](?d.hidden));
    ret fail.kept(first, table.release[Wanted](?d.wanted));
}

# record the libraries and exports of the link and decide every live
# relocation. an output a later link takes decides nothing, since its
# relocations travel with it
pub fun run(in: *In, out: *Dynamic) err[Fail] {
    if (output.has(in.kind, output.KEEPS)) { ret err[Fail].ok{}; }
    val a: *A.Allocator = in.inputs.a;
    # the rules are static, so one index per process could serve every run
    val ck: res[Checked, Fail] = check(in.rules, a);
    if (sel ck.err) { ret err[Fail].err{ck.err}; }
    var c: Context = Context{
        in:        in,
        out:       out,
        importing: table.make[u32](a),
        loaders:   table.make[u32](a),
        chain:     table.make[u32](a),
        heads:     table.make[u32](a),
        bases:     table.make[u32](a),
        kept:      table.make[bool](a),
        dropped:   table.make[u32](a),
        next:      table.make[u32](a),
        checked:   ck.ok,
    };
    var i: usize = 0;
    for (i < catalog_slot.SLOT_ROLES) {
        c.index[i] = index(a);
        i          = i + 1;
    }
    i = 0;
    for (i < REACHED_COUNT) {
        c.routes[i] = route_of(in.rules, REACHED[i].reach, in.arch, in.host);
        i           = i + 1;
    }
    val r: err[Fail] = dynamic(?c);
    val d: err[Fail] = drop(?c);
    if (sel r.err) { ret r; }
    ret d;
}

# the offer of the library `l` a reference to `name` binds: the one at the
# version `wants` names, or for an unversioned reference the default version,
# or the library's first unversioned offer. none when the library offers no
# such version
pub fun bind_version(d: *Dynamic, l: Id[Library], name: Id[Name], wants: opt[Id[Name]]) opt[Id[Offer]] {
    var plain: opt[Id[Offer]] = opt[Id[Offer]].none{};
    var at:    u32            = 0;
    if (name.index::usize < table.count[u32](?d.named)) { at = table.items[u32](?d.named)[name.index]; }
    for (at != 0) {
        val id: Id[Offer] = table.nth[Offer](at::usize - 1);
        val o:  *Offer    = table.at[Offer](?d.offers, id);
        at = table.items[u32](?d.onward)[at - 1];
        if (o.library.index != l.index) { cnt; }
        val stated: opt[Id[Name]] = o.version;
        if (sel wants.some) {
            if (sel stated.some && stated.some.index == wants.some.index) { ret opt[Id[Offer]].some{id}; }
            cnt;
        }
        if (o.default)                         { ret opt[Id[Offer]].some{id}; }
        if (sel stated.none && sel plain.none) { plain = opt[Id[Offer]].some{id}; }
    }
    ret plain;
}

fun index(a: *A.Allocator) Index {
    ret Index{bound: table.make[u32](a), imported: table.make[u32](a), local: table.make[u32](a), absent: table.make[u32](a), linked: table.make[u32](a), absolute: table.make[u32](a)};
}

fun drop_index(x: *Index) err[Fail] {
    var first: err[Fail] = table.release[u32](?x.bound);
    first = fail.kept(first, table.release[u32](?x.imported));
    first = fail.kept(first, table.release[u32](?x.local));
    first = fail.kept(first, table.release[u32](?x.absent));
    first = fail.kept(first, table.release[u32](?x.linked));
    ret fail.kept(first, table.release[u32](?x.absolute));
}

fun drop(c: *Context) err[Fail] {
    var first: err[Fail] = table.release[u32](?c.importing);
    first = fail.kept(first, table.release[u32](?c.loaders));
    first = fail.kept(first, table.release[u32](?c.chain));
    first = fail.kept(first, table.release[u32](?c.heads));
    first = fail.kept(first, table.release[u32](?c.bases));
    first = fail.kept(first, table.release[bool](?c.kept));
    first = fail.kept(first, table.release[u32](?c.dropped));
    first = fail.kept(first, table.release[u32](?c.next));
    var i: usize = 0;
    for (i < catalog_slot.SLOT_ROLES) {
        first = fail.kept(first, drop_index(?c.index[i]));
        i     = i + 1;
    }
    ret fail.kept(first, release_checked(?c.checked));
}

fun dynamic(c: *Context) err[Fail] {
    val names: usize     = intern.count(c.in.names);
    var first: err[Fail] = grown(?c.importing, names);
    first = fail.kept(first, grown(?c.heads, names));
    if (sel first.err) { ret first; }
    var i: usize = 0;
    for (i < table.count[resolve.Import](?c.in.resolved.imports)) {
        val im: *resolve.Import = table.at[resolve.Import](?c.in.resolved.imports, table.nth[resolve.Import](i));
        table.items[u32](?c.importing)[im.name.index] = i::u32 + 1;
        i                                             = i + 1;
    }
    val l: err[Fail] = offered(c);
    if (sel l.err) { ret l; }
    val e: err[Fail] = exports(c);
    if (sel e.err) { ret e; }
    val s: err[Fail] = survivors(c);
    if (sel s.err) { ret s; }
    val d: err[Fail] = decisions(c);
    if (sel d.err) { ret d; }
    val m: err[Fail] = made(c);
    if (sel m.err) { ret m; }
    loads(c.out, c.in.loads_all);
    ret err[Fail].ok{};
}

# a relocation kind that stands for a reference the format's linker makes,
# which loads its target through a GOT slot
val MADE_KIND: reloc.Kind = reloc.Kind{name: "linker-made GOT load", caps: reloc.GOT, takes: ?reloc.NAMED};

# decide every reference the format's linker makes, as a GOT load whose
# field the decision reads nothing of
fun made(c: *Context) err[Fail] {
    val maker: opt[*Maker] = c.in.maker;
    if (sel maker.none) { ret err[Fail].ok{}; }
    var refs: Table[Made] = table.make[Made](c.in.inputs.a);
    var r:    err[Fail]   = maker.some.make(c.in, c.out, ?refs);
    var i:    usize       = 0;
    for (i < table.count[Made](?refs) && sel r.ok) {
        r = made_one(c, table.items[Made](?refs)[i]);
        i = i + 1;
    }
    ret fail.kept(r, table.release[Made](?refs));
}

fun made_one(c: *Context, m: Made) err[Fail] {
    if (sel m.named) { ret wanted(c, m.named); }
    val p:  Placed    = m.reloc;
    val id: Id[Input] = p.input;
    val o:  *Object   = input.object_of(c.in.inputs, id);
    if (o == nil || p.reloc::usize >= table.count[Reloc](?o.relocs)) { ret err[Fail].err{fail.internal("a linker-made reference names a relocation no input holds")}; }
    val rel: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc](p.reloc::usize));
    if (!sel rel.target.symbol) { ret err[Fail].err{fail.in_file(fail.in_indexed(fail.malformed("a linker-made reference names no symbol"), "relocation", p.reloc::u64), input.at(c.in.inputs, id).name)}; }
    val sid: Id[Symbol] = rel.target.symbol;
    if (sid.index::usize >= table.count[Symbol](?o.symbols)) { ret err[Fail].err{fail.in_file(fail.in_indexed(fail.malformed("a relocation names a symbol the object does not hold"), "relocation", p.reloc::u64), input.at(c.in.inputs, id).name)}; }
    val t: res[Target, Fail] = target(c, id, o, sid);
    if (sel t.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(t.err, "relocation", p.reloc::u64), input.at(c.in.inputs, id).name)}; }
    val at: usize               = table.items[u32](?c.out.starts)[id.index]::usize + p.reloc::usize;
    val d:  res[Decision, Fail] = needed(c, Reference{kind: ?MADE_KIND, target: t.ok.caps}, t.ok);
    if (sel d.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(d.err, "relocation", p.reloc::u64), input.at(c.in.inputs, id).name)}; }
    table.items[Decision](?c.out.decisions)[at] = d.ok;
    ret err[Fail].ok{};
}

# the name `name` the format's linker reaches itself, bound to the first
# library the link takes that offers it
fun wanted(c: *Context, name: Id[Name]) err[Fail] {
    var k: usize = 0;
    for (k < table.count[Wanted](?c.out.wanted)) {
        if (table.items[Wanted](?c.out.wanted)[k].name.index == name.index) { ret err[Fail].ok{}; }
        k = k + 1;
    }
    var first: u32 = 0;
    if (name.index::usize < table.count[u32](?c.out.named)) { first = table.items[u32](?c.out.named)[name.index]; }
    if (first == 0)                                         { ret err[Fail].err{fail.malformed("no library the link takes offers a name the format's loader binds through")}; }
    val lib:   Id[Library]    = table.at[Offer](?c.out.offers, table.nth[Offer](first::usize - 1)).library;
    val offer: opt[Id[Offer]] = bind_version(c.out, lib, name, opt[Id[Name]].none{});
    if (sel offer.none) { ret err[Fail].err{fail.malformed("no library the link takes offers a name the format's loader binds through")}; }
    val made_import: res[Id[Import], Fail] = import_of(c, name, offer.some, false);
    if (sel made_import.err) { ret err[Fail].err{made_import.err}; }
    val off: *Offer              = table.at[Offer](?c.out.offers, offer.some);
    val def: *Symbol             = object.symbol_at(input.object_of(c.in.inputs, off.input), off.symbol);
    val t:   Target              = Target{caps: IMPORTED | BOUND | named(def.kind), aim: Aim.imported{made_import.ok}};
    val d:   res[Decision, Fail] = needed(c, Reference{kind: ?MADE_KIND, target: t.caps}, t);
    if (sel d.err) { ret err[Fail].err{d.err}; }
    val pushed: res[Id[Wanted], Fail] = table.push[Wanted](?c.out.wanted, Wanted{name: name, decision: d.ok});
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

# decide which libraries the image loads: each a reference binds to, and
# every other too when the format loads all
fun loads(d: *Dynamic, all: bool) {
    var i: usize = 0;
    for (i < table.count[Library](?d.libraries)) {
        val l: *Library = table.at[Library](?d.libraries, table.nth[Library](i));
        l.loaded = all || sel l.rank.some;
        i        = i + 1;
    }
}

# grow `t` with zeros to hold at least `n` entries
fun grown(t: *Table[u32], n: usize) err[Fail] {
    val have: usize = table.count[u32](t);
    if (n <= have) { ret err[Fail].ok{}; }
    val g: res[Id[u32], Fail] = table.grow[u32](t, n - have);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    ret err[Fail].ok{};
}

# the entry of `t` at the index of `id`, the table growing to hold it
fun slot(t: *Table[u32], at: usize) res[*u32, Fail] {
    val g: err[Fail] = grown(t, at + 1);
    if (sel g.err) { ret res[*u32, Fail].err{g.err}; }
    ret res[*u32, Fail].ok{?table.items[u32](t)[at]};
}

# record every library once, in input order, and what each library input
# offers, and chain each name's offers in input order
fun offered(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        i = i + 1;
        if (!resolve.library(c.in.resolved, id)) { cnt; }
        val e: err[Fail] = offers_of(c, id);
        if (sel e.err) { ret err[Fail].err{fail.in_file(e.err, input.at(c.in.inputs, id).name)}; }
    }
    ret chain_offers(c.out, intern.count(c.in.names));
}

# link each offer to the next of its name, first to last
fun chain_offers(d: *Dynamic, names: usize) err[Fail] {
    val g: err[Fail] = grown(?d.named, names);
    if (sel g.err) { ret g; }
    val n: usize = table.count[Offer](?d.offers);
    if (n != 0) {
        val o: res[Id[u32], Fail] = table.grow[u32](?d.onward, n);
        if (sel o.err) { ret err[Fail].err{o.err}; }
    }
    var i: usize = n;
    for (i > 0) {
        i = i - 1;
        val name: Id[Name] = table.at[Offer](?d.offers, table.nth[Offer](i)).name;
        table.items[u32](?d.onward)[i]         = table.items[u32](?d.named)[name.index];
        table.items[u32](?d.named)[name.index] = (i + 1)::u32;
    }
    ret err[Fail].ok{};
}

fun offers_of(c: *Context, id: Id[Input]) err[Fail] {
    val loader: res[Id[Name], Fail] = resolve.loader(c.in.inputs, c.in.names, id);
    if (sel loader.err) { ret err[Fail].err{loader.err}; }
    val lib: res[Id[Library], Fail] = library_of(c, loader.ok, id);
    if (sel lib.err) { ret err[Fail].err{lib.err}; }
    val o: *Object = input.object_of(c.in.inputs, id);
    var k: usize   = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val sid: Id[Symbol] = table.nth[Symbol](k);
        val sym: *Symbol    = object.symbol_at(o, sid);
        k = k + 1;
        if (!object.offers(sym)) { cnt; }
        val nm: opt[Id[Name]] = resolve.link_name(c.in.resolved, id, sid);
        if (sel nm.none) { ret err[Fail].err{fail.in_indexed(fail.internal("an offered symbol has no link name"), "symbol", k::u64 - 1)}; }
        var version: opt[Id[Name]] = opt[Id[Name]].none{};
        var default: bool          = false;
        val v:       opt[Version]  = sym.version;
        if (sel v.some) {
            val text: View                = object.name_of(o, v.some.name);
            val vn:   res[Id[Name], Fail] = intern.intern(c.in.names, text.data, text.len);
            if (sel vn.err) { ret err[Fail].err{vn.err}; }
            version = opt[Id[Name]].some{vn.ok};
            default = v.some.default;
        }
        val pushed: res[Id[Offer], Fail] = table.push[Offer](?c.out.offers, Offer{library: lib.ok, input: id, name: nm.some, symbol: sid, version: version, default: default});
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    }
    ret err[Fail].ok{};
}

# export every definition the output exports and every definition a library
# refers to, refusing a library's reference to a definition the image hides
fun exports(c: *Context) err[Fail] {
    val count: usize       = table.count[Binding](?c.in.resolved.bindings);
    var out:   Table[bool] = table.make[bool](c.in.inputs.a);
    val r:     err[Fail]   = exported(c, ?out, count);
    val rel:   err[Fail]   = table.release[bool](?out);
    ret fail.kept(r, rel);
}

fun exported(c: *Context, out: *Table[bool], count: usize) err[Fail] {
    if (count != 0) {
        val g: res[Id[bool], Fail] = table.grow[bool](out, count);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    val all: bool  = output.has(c.in.kind, output.EXPORTS);
    var i:   usize = 0;
    for (i < count) {
        val b: *Binding = table.at[Binding](?c.in.resolved.bindings, table.nth[Binding](i));
        table.items[bool](out)[i] = all && symbol.shows(b.visibility, symbol.EXPORTED);
        i                         = i + 1;
    }
    var l: usize = 0;
    for (l < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](l);
        l = l + 1;
        if (!resolve.library(c.in.resolved, id)) { cnt; }
        val e: err[Fail] = reached(c, out, id);
        if (sel e.err) { ret err[Fail].err{fail.in_file(e.err, input.at(c.in.inputs, id).name)}; }
    }
    i = 0;
    for (i < count) {
        if (table.items[bool](out)[i]) {
            val b:   *Binding = table.at[Binding](?c.in.resolved.bindings, table.nth[Binding](i));
            val def: *Symbol  = object.symbol_at(input.object_of(c.in.inputs, b.input), b.symbol);
            if (sel def.version.some) {
                ret err[Fail].err{fail.in_indexed(fail.unsupported("exporting a versioned symbol takes version sections, which no image writes yet"), "binding", i::u64)};
            }
            val pushed: res[Id[Export], Fail] = table.push[Export](?c.out.exports, Export{
                binding:     table.nth[Binding](i),
                preemptible: preemptible(c.in.rules, c.in.kind, b.visibility),
            });
            if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# mark every definition of the image the library `id` refers to exported
fun reached(c: *Context, out: *Table[bool], id: Id[Input]) err[Fail] {
    val o: *Object = input.object_of(c.in.inputs, id);
    var k: usize   = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val sid: Id[Symbol] = table.nth[Symbol](k);
        val sym: *Symbol    = object.symbol_at(o, sid);
        k = k + 1;
        if (!symbol.binds(sym.binding, symbol.EXTERNAL) || !sel sym.def.undefined) { cnt; }
        val w: opt[resolve.Won] = resolve.winning(c.in.resolved, id, sid);
        if (sel w.none) { cnt; }
        if (!symbol.shows(w.some.binding.visibility, symbol.EXPORTED)) {
            val pushed: res[Id[resolve.Reference], Fail] = table.push[resolve.Reference](?c.out.hidden, resolve.Reference{name: w.some.binding.name, input: id});
            if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
            ret err[Fail].err{fail.in_indexed(fail.malformed("a hidden symbol is referred to from another image"), "symbol", k::u64 - 1)};
        }
        table.items[bool](out)[w.some.id.index] = true;
    }
    ret err[Fail].ok{};
}

# index which sections survived and the ranges dropped from each
fun survivors(c: *Context) err[Fail] {
    var total: usize = 0;
    var i:     usize = 0;
    for (i < input.count(c.in.inputs)) {
        val pushed: res[Id[u32], Fail] = table.push[u32](?c.bases, total::u32);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        val o: *Object = input.object_of(c.in.inputs, table.nth[Input](i));
        if (o != nil) { total = total + table.count[Section](?o.sections); }
        i = i + 1;
    }
    if (total != 0) {
        val g: res[Id[bool], Fail] = table.grow[bool](?c.kept, total);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    val d: err[Fail] = grown(?c.dropped, total);
    if (sel d.err) { ret d; }
    i = 0;
    for (i < table.count[Ref](?c.in.live.kept)) {
        val r: Ref = table.items[Ref](?c.in.live.kept)[i];
        table.items[bool](?c.kept)[section_index(c, r)] = true;
        i                                               = i + 1;
    }
    i = 0;
    for (i < table.count[Range](?c.in.live.dropped)) {
        val at:     usize              = section_index(c, table.items[Range](?c.in.live.dropped)[i].at);
        val pushed: res[Id[u32], Fail] = table.push[u32](?c.next, table.items[u32](?c.dropped)[at]);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        table.items[u32](?c.dropped)[at] = i::u32 + 1;
        i                                = i + 1;
    }
    ret err[Fail].ok{};
}

fun section_index(c: *Context, r: Ref) usize {
    ret table.items[u32](?c.bases)[r.input.index]::usize + r.section.index::usize;
}

# whether the place `offset` of the section `s` of `id` survived
fun live(c: *Context, id: Id[Input], s: Id[Section], offset: u64) bool {
    val at: usize = section_index(c, Ref{input: id, section: s});
    if (!table.items[bool](?c.kept)[at]) { ret false; }
    var d: u32 = table.items[u32](?c.dropped)[at];
    for (d != 0) {
        val r: Range = table.items[Range](?c.in.live.dropped)[d - 1];
        if (offset >= r.start && offset < r.end) { ret false; }
        d = table.items[u32](?c.next)[d - 1];
    }
    ret true;
}

fun decisions(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < input.count(c.in.inputs)) {
        val id:     Id[Input]          = table.nth[Input](i);
        val pushed: res[Id[u32], Fail] = table.push[u32](?c.out.starts, table.count[Decision](?c.out.decisions)::u32);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        i = i + 1;
        val o: *Object = input.object_of(c.in.inputs, id);
        if (o == nil || resolve.library(c.in.resolved, id) || table.count[Reloc](?o.relocs) == 0) { cnt; }
        val start: usize                   = table.count[Decision](?c.out.decisions);
        val g:     res[Id[Decision], Fail] = table.grow[Decision](?c.out.decisions, table.count[Reloc](?o.relocs));
        if (sel g.err) { ret err[Fail].err{g.err}; }
        var k: usize = 0;
        for (k < table.count[Reloc](?o.relocs)) {
            val e: err[Fail] = decision(c, id, o, k, start + k);
            if (sel e.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(e.err, "relocation", k::u64), input.at(c.in.inputs, id).name)}; }
            k = k + 1;
        }
    }
    ret err[Fail].ok{};
}

# what a reference's target is to the decision, and what it aims at
rec Target {
    caps: Caps;
    aim:  Aim;
}

fun decision(c: *Context, id: Id[Input], o: *Object, k: usize, at: usize) err[Fail] {
    val r: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc](k));
    if (r.section.index::usize >= table.count[Section](?o.sections)) {
        ret err[Fail].err{fail.malformed("a relocation patches a section the object does not hold")};
    }
    if (!live(c, id, r.section, r.offset)) { ret err[Fail].ok{}; }
    if (sel r.target.none)                 { ret err[Fail].ok{}; }
    or (sel r.target.entry)                { ret indexed(c, o, r, r.target.entry, at); }
    or (sel r.target.absolute)             { ret decided(c, o, r, at, Target{caps: DEFINED | ABSOLUTE, aim: Aim.absolute{}}); }
    val sid: Id[Symbol] = r.target.symbol;
    if (sid.index::usize >= table.count[Symbol](?o.symbols)) {
        ret err[Fail].err{fail.malformed("a relocation names a symbol the object does not hold")};
    }
    val t: res[Target, Fail] = target(c, id, o, sid);
    if (sel t.err) { ret err[Fail].err{t.err}; }
    ret decided(c, o, r, at, t.ok);
}

# decide the relocation `r` of `o` with the target `t`, its decision the `at`th
fun decided(c: *Context, o: *Object, r: *Reloc, at: usize, t: Target) err[Fail] {
    val s: res[Caps, Fail] = site(c, o, r);
    if (sel s.err) { ret err[Fail].err{s.err}; }
    val d: res[Decision, Fail] = needed(c, Reference{kind: r.kind, site: s.ok, target: t.caps}, t);
    if (sel d.err) { ret err[Fail].err{d.err}; }
    table.items[Decision](?c.out.decisions)[at] = d.ok;
    ret err[Fail].ok{};
}

# what the reference `f` to the target `t` needs, and the entries it
# reaches, made on the first reference to each
fun needed(c: *Context, f: Reference, t: Target) res[Decision, Fail] {
    var by: Reference       = f;
    val w:  res[*Row, Fail] = decide(?c.checked, ?by, c.in.kind);
    if (sel w.err) { ret res[Decision, Fail].err{w.err}; }
    val out: *Outcome = w.ok.outcome;
    if (has(out, UNBUILT)) { ret res[Decision, Fail].err{fail.unsupported(w.ok.reason)}; }
    if (has(out, REFUSE))  { ret res[Decision, Fail].err{fail.malformed(w.ok.reason)}; }
    val reach: Caps = out.caps & ENTRY_REACHES;
    if (reach == 0) { ret res[Decision, Fail].ok{Decision{row: w.ok, aim: t.aim}}; }
    val pos: opt[usize] = reached_at(reach);
    if (sel pos.none) { ret res[Decision, Fail].err{fail.internal("an outcome reaches more than one entry")}; }
    val route: res[*Route, Fail] = c.routes[pos.some];
    if (sel route.err) { ret res[Decision, Fail].err{route.err}; }
    if (has(out, AT_COPY)) {
        val sized: err[Fail] = copyable(c, t.aim);
        if (sel sized.err) { ret res[Decision, Fail].err{sized.err}; }
    }
    val n: res[u32, Fail] = entry_of(c, route.ok.role, t.aim, out, 0);
    if (sel n.err) { ret res[Decision, Fail].err{n.err}; }
    var through: u32            = 0;
    val code:    opt[*SlotRole] = route.ok.through;
    if (sel code.some) {
        val k: res[u32, Fail] = entry_of(c, code.some, t.aim, out, n.ok);
        if (sel k.err) { ret res[Decision, Fail].err{k.err}; }
        through = k.ok;
    }
    ret res[Decision, Fail].ok{Decision{row: w.ok, aim: t.aim, route: route.ok, entry: n.ok, through: through}};
}

# what a reference needs that reaches an index space entry by its row
val ENTRY_ROW: Row = Row{name: "index space entry", outcome: ?STATIC};

# the relocation `r` of `o` to the index space entry `e`, which binds nothing
# across the image's boundary: static when its row computes the entry's index
# alone, refused otherwise
fun indexed(c: *Context, o: *Object, r: *Reloc, e: Id[object.Entry], at: usize) err[Fail] {
    if (e.index::usize >= table.count[object.Entry](?o.entries)) {
        ret err[Fail].err{fail.malformed("a relocation names an entry the object does not hold")};
    }
    val w: res[*row.Row, Fail] = row.targeting(c.in.relocs, r.kind, sel r.minus.some);
    if (sel w.err) { ret err[Fail].err{fail.in_record(w.err, r.kind.name)}; }
    if (w.ok.value.needs != compute.NEEDS_INDEX) {
        ret err[Fail].err{fail.about(fail.unsupported("a relocation to an index space entry computes more than the entry's index"), r.kind.name)};
    }
    table.items[Decision](?c.out.decisions)[at] = Decision{row: ?ENTRY_ROW, aim: Aim.entry{e}};
    ret err[Fail].ok{};
}

# what the symbol `sid` of the input `id` binds to
fun target(c: *Context, id: Id[Input], o: *Object, sid: Id[Symbol]) res[Target, Fail] {
    val sym: *Symbol = object.symbol_at(o, sid);
    if (!symbol.binds(sym.binding, symbol.EXTERNAL)) {
        if (sel sym.def.undefined) { ret res[Target, Fail].err{fail.malformed("a local symbol is undefined")}; }
        ret res[Target, Fail].ok{Target{caps: DEFINED | defined(sym), aim: Aim.local{Local{input: id, symbol: sid}}}};
    }
    val nm: opt[Id[Name]] = resolve.link_name(c.in.resolved, id, sid);
    if (sel nm.none) { ret res[Target, Fail].err{fail.internal("an external symbol has no link name")}; }
    val w: opt[resolve.Won] = resolve.winning(c.in.resolved, id, sid);
    if (sel w.some) {
        val bd:   *Binding = w.some.binding;
        val def:  *Symbol  = object.symbol_at(input.object_of(c.in.inputs, bd.input), bd.symbol);
        var caps: Caps     = DEFINED | defined(def);
        if (preemptible(c.in.rules, c.in.kind, bd.visibility)) { caps = caps | PREEMPTIBLE | BOUND; }
        ret res[Target, Fail].ok{Target{caps: caps, aim: Aim.bound{w.some.id}}};
    }
    val own: opt[*resolve.Linked] = resolve.linked_of(c.in.resolved, nm.some);
    if (sel own.some) {
        var caps: Caps = DEFINED | named(sym.kind);
        if (!boundary.relative(own.some.bound.place)) { caps = caps | ABSOLUTE; }
        ret res[Target, Fail].ok{Target{caps: caps, aim: Aim.linked{nm.some}}};
    }
    if (nm.some.index::usize < table.count[u32](?c.importing) && table.items[u32](?c.importing)[nm.some.index] != 0) {
        ret imported(c, o, sym, nm.some);
    }
    var caps: Caps = UNDEFINED | named(sym.kind);
    if (output.has(c.in.kind, output.IMPORTS)) { caps = caps | BOUND; }
    ret res[Target, Fail].ok{Target{caps: caps, aim: Aim.absent{nm.some}}};
}

# the capabilities a definition gives its target
fun defined(s: *Symbol) Caps {
    var caps: Caps = named(s.kind);
    if (sel s.def.absolute) { caps = caps | ABSOLUTE; }
    ret caps;
}

# the capabilities what a symbol names gives its target
fun named(k: *symbol.Kind) Caps {
    var caps: Caps = 0;
    if (symbol.names(k, symbol.CODE))     { caps = caps | CODE; }
    if (symbol.names(k, symbol.OBJECT))   { caps = caps | DATA; }
    if (symbol.names(k, symbol.RESOLVER)) { caps = caps | RESOLVER; }
    if (symbol.names(k, symbol.THREAD))   { caps = caps | THREAD; }
    if (symbol.names(k, symbol.CELL))     { caps = caps | CELL; }
    ret caps;
}

# the import a reference by `sym` of `o` to `name`, which a library answers,
# binds: the library's offer at the version the reference names
fun imported(c: *Context, o: *Object, sym: *Symbol, name: Id[Name]) res[Target, Fail] {
    val im:  *resolve.Import = table.at[resolve.Import](?c.in.resolved.imports, table.nth[resolve.Import](table.items[u32](?c.importing)[name.index]::usize - 1));
    var lib: u32             = 0;
    if (im.library.index::usize < table.count[u32](?c.loaders)) { lib = table.items[u32](?c.loaders)[im.library.index]; }
    if (lib == 0)                                               { ret res[Target, Fail].err{fail.internal("an import names a library the link does not take")}; }
    var wants: opt[Id[Name]] = opt[Id[Name]].none{};
    val v:     opt[Version]  = sym.version;
    if (sel v.some) {
        if ((c.in.rules.caps & VERSIONED) == 0) { ret res[Target, Fail].err{fail.unsupported("the format binds no symbol versions")}; }
        val text:  View          = object.name_of(o, v.some.name);
        val found: opt[Id[Name]] = intern.find(c.in.names, text.data, text.len);
        if (sel found.none) { ret res[Target, Fail].err{fail.malformed("the library offers no symbol at the version the reference names")}; }
        wants = found;
    }
    val offer: opt[Id[Offer]] = bind_version(c.out, table.nth[Library](lib::usize - 1), name, wants);
    if (sel offer.none) { ret res[Target, Fail].err{fail.malformed("the library offers no symbol at the version the reference names")}; }
    val weak: bool                  = symbol.binds(sym.binding, symbol.WEAK);
    val made: res[Id[Import], Fail] = import_of(c, name, offer.some, weak);
    if (sel made.err) { ret res[Target, Fail].err{made.err}; }
    val off: *Offer  = table.at[Offer](?c.out.offers, offer.some);
    val def: *Symbol = object.symbol_at(input.object_of(c.in.inputs, off.input), off.symbol);
    ret res[Target, Fail].ok{Target{caps: IMPORTED | BOUND | named(def.kind), aim: Aim.imported{made.ok}}};
}

# the import of `name` binding `offer`, made on the first reference to it,
# which ranks its library on the first import from it. it stays weak while
# every reference to it is
fun import_of(c: *Context, name: Id[Name], offer: Id[Offer], weak: bool) res[Id[Import], Fail] {
    var at: u32 = table.items[u32](?c.heads)[name.index];
    for (at != 0) {
        val im: *Import = table.at[Import](?c.out.imports, table.nth[Import](at::usize - 1));
        if (im.offer.index == offer.index) {
            if (!weak) { im.weak = false; }
            ret res[Id[Import], Fail].ok{table.nth[Import](at::usize - 1)};
        }
        at = table.items[u32](?c.chain)[at - 1];
    }
    val lib: Id[Library] = table.at[Offer](?c.out.offers, offer).library;
    val l:   *Library    = table.at[Library](?c.out.libraries, lib);
    val was: opt[u32]    = l.rank;
    if (sel was.none) {
        l.rank   = opt[u32].some{c.ranked};
        c.ranked = c.ranked + 1;
    }
    val pushed: res[Id[Import], Fail] = table.push[Import](?c.out.imports, Import{name: name, library: lib, offer: offer, weak: weak});
    if (sel pushed.err) { ret pushed; }
    val linked: res[Id[u32], Fail] = table.push[u32](?c.chain, table.items[u32](?c.heads)[name.index]);
    if (sel linked.err) { ret res[Id[Import], Fail].err{linked.err}; }
    table.items[u32](?c.heads)[name.index] = pushed.ok.index + 1;
    ret pushed;
}

# the library its loader knows as `loader`, made when the library input `id`
# is the first to describe it
fun library_of(c: *Context, loader: Id[Name], id: Id[Input]) res[Id[Library], Fail] {
    val known: res[*u32, Fail] = slot(?c.loaders, loader.index::usize);
    if (sel known.err)  { ret res[Id[Library], Fail].err{known.err}; }
    if (@known.ok != 0) { ret res[Id[Library], Fail].ok{table.nth[Library]((@known.ok - 1)::usize)}; }
    val pushed: res[Id[Library], Fail] = table.push[Library](?c.out.libraries, Library{loader: loader, input: id, searched: input.at(c.in.inputs, id).searched});
    if (sel pushed.err) { ret pushed; }
    table.items[u32](?c.loaders)[loader.index] = pushed.ok.index + 1;
    ret pushed;
}

# what the field and section the relocation `r` of `o` patches give the
# decision, a field shape counting only when every field the row may write
# has it. a marker patches no field
fun site(c: *Context, o: *Object, r: *Reloc) res[Caps, Fail] {
    if (reloc.has(r.kind, reloc.MARKER)) { ret res[Caps, Fail].ok{0}; }
    val w: res[*row.Row, Fail] = row.targeting(c.in.relocs, r.kind, sel r.minus.some);
    if (sel w.err) { ret res[Caps, Fail].err{fail.in_record(w.err, r.kind.name)}; }
    val page: u32   = page_bits(c.in.arch);
    var caps: Caps  = WORD | LOW;
    var i:    usize = 0;
    for (i < w.ok.field_count) {
        val f:     *Field = w.ok.fields[i].field;
        val width: u32    = field.width(f);
        if (f.insn || f.shift != 0 || f.bytes != word_bytes(c.in.arch) || width != f.bytes::u32 * 8) { caps = caps & ~WORD; }
        if (!f.insn || page == 0 || f.shift::u32 + width > page)                                     { caps = caps & ~LOW; }
        i = i + 1;
    }
    if ((object.section_at(o, r.section).flags & section.WRITE) != 0) { caps = caps | WRITABLE; }
    ret res[Caps, Fail].ok{caps};
}

# how many bits an offset within a page takes, zero where there are no pages
fun page_bits(a: *Arch) u32 {
    if (sel a.pages.none) { ret 0; }
    val size: u64 = a.pages.some.size;
    var bits: u32 = 0;
    for (bits < 64 && (size >> bits) > 1) { bits = bits + 1; }
    ret bits;
}

# the bytes of an address of `a`, zero where addressing is not the
# architecture's, so no field is a word
fun word_bytes(a: *Arch) u8 {
    if (sel a.pointer.some) { ret a.pointer.some.bytes; }
    ret 0;
}

# the entry of role `r` the outcome `o` reaches for `aim`, made on the first
# reference, going to the `lands`th entry of its route's role when it is a
# code entry a call goes through
fun entry_of(c: *Context, r: *SlotRole, aim: Aim, o: *Outcome, lands: u32) res[u32, Fail] {
    val entries: *Table[Entry]   = ?c.out.entries[r.at::usize];
    val at:      res[*u32, Fail] = keyed(c, ?c.index[r.at::usize], aim);
    if (sel at.err)  { ret res[u32, Fail].err{at.err}; }
    if (@at.ok != 0) { ret res[u32, Fail].ok{@at.ok - 1}; }
    val pushed: res[Id[Entry], Fail] = table.push[Entry](entries, Entry{aim: aim, outcome: o, lands: lands});
    if (sel pushed.err) { ret res[u32, Fail].err{pushed.err}; }
    @at.ok = pushed.ok.index + 1;
    ret res[u32, Fail].ok{pushed.ok.index};
}

# a copy needs the size its library states for the symbol
fun copyable(c: *Context, aim: Aim) err[Fail] {
    if (!sel aim.imported) { ret err[Fail].err{fail.internal("a copy is made of an import only")}; }
    val im:  *Import = table.at[Import](?c.out.imports, aim.imported);
    val off: *Offer  = table.at[Offer](?c.out.offers, im.offer);
    val sym: *Symbol = object.symbol_at(input.object_of(c.in.inputs, off.input), off.symbol);
    if (sel sym.size.none) { ret err[Fail].err{fail.malformed("a copy relocation needs the size the library states for the symbol")}; }
    ret err[Fail].ok{};
}

# the place in `x` holding the entry for `aim`
fun keyed(c: *Context, x: *Index, aim: Aim) res[*u32, Fail] {
    if (sel aim.bound)    { ret slot(?x.bound, aim.bound.index::usize); }
    or (sel aim.imported) { ret slot(?x.imported, aim.imported.index::usize); }
    or (sel aim.absent)   { ret slot(?x.absent, aim.absent.index::usize); }
    or (sel aim.linked)   { ret slot(?x.linked, aim.linked.index::usize); }
    or (sel aim.entry)    { ret res[*u32, Fail].err{fail.internal("an index space entry takes no linker-made entry")}; }
    or (sel aim.absolute) { ret slot(?x.absolute, 0); }
    val at: usize = table.items[u32](?c.in.resolved.starts)[aim.local.input.index]::usize + aim.local.symbol.index::usize;
    ret slot(?x.local, at);
}

# a reference of an object a test links alone: a relocation of `kind` to an
# undefined symbol `name` of its own, which names what `names` says
#[testing]
pub rec Sample {
    name:  str;
    names: *symbol.Kind;
    kind:  *reloc.Kind;
}

# decide the `count` references at `samples`, each patching the next four bytes
# of the code of one object for `ar` linked alone into an output of kind `k`
# under the rules `r` with the relocation rows `relocs`, for a host offering
# the image `host`, into `out`, for a test of a format's rules below a whole
# link
#[testing]
pub fun decide_alone(a: *A.Allocator, ar: *Arch, host: os.Caps, samples: *Sample, count: usize, r: *Rules, k: *Kind, relocs: *row.Lookup, out: *Dynamic) err[Fail] {
    var o:     Object    = object.make(a, ar, ?kind.RELOCATABLE);
    val built: err[Fail] = sampled(?o, samples, count);
    var first: err[Fail] = built;
    if (sel built.ok) { first = alone(a, ?o, r, ar, host, k, relocs, out); }
    ret fail.kept(first, object.release(?o));
}

# the code section of `o` and the symbols and relocations of the samples
#[testing]
fun sampled(o: *Object, samples: *Sample, count: usize) err[Fail] {
    val text: res[Id[Name], Fail] = object.name_str(o, ".text");
    if (sel text.err) { ret err[Fail].err{text.err}; }
    val sec: res[Id[Section], Fail] = object.add_section(o, Section{name: opt[Id[Name]].some{text.ok}, kind: ?section.TEXT, flags: section.TEXT.flags, align: 4, contents: object.Contents.zero{count::u64 * 4}, disposition: ?section.WHOLE});
    if (sel sec.err) { ret err[Fail].err{sec.err}; }
    var i: usize = 0;
    for (i < count) {
        val nm: res[Id[Name], Fail] = object.name_str(o, samples[i].name);
        if (sel nm.err) { ret err[Fail].err{nm.err}; }
        val sym: res[Id[Symbol], Fail] = object.add_symbol(o, Symbol{name: nm.ok, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: samples[i].names, def: Definition.undefined{}});
        if (sel sym.err) { ret err[Fail].err{sym.err}; }
        val rel: res[Id[Reloc], Fail] = object.add_reloc(o, Reloc{section: sec.ok, offset: i::u64 * 4, kind: samples[i].kind, target: object.Target.symbol{sym.ok}});
        if (sel rel.err) { ret err[Fail].err{rel.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

#[testing]
fun alone(a: *A.Allocator, o: *Object, r: *Rules, ar: *Arch, host: os.Caps, k: *Kind, relocs: *row.Lookup, out: *Dynamic) err[Fail] {
    var inputs: Inputs    = input.make(a);
    var names:  Interner  = intern.make(a);
    var res_of: Resolved  = resolve.make(a);
    var live:   Live      = collect.make(a);
    var notes:  Sink      = sink.make(a, LITTLE);
    var first:  err[Fail] = linked_alone(?inputs, ?names, ?res_of, ?live, ?notes, o, r, ar, host, k, relocs, out);
    first = fail.kept(first, sink.release(?notes));
    first = fail.kept(first, collect.release(?live));
    first = fail.kept(first, resolve.release(?res_of));
    first = fail.kept(first, intern.release(?names));
    ret fail.kept(first, input.release(?inputs));
}

#[testing]
fun linked_alone(inputs: *Inputs, names: *Interner, res_of: *Resolved, live: *Live, notes: *Sink, o: *Object, r: *Rules, ar: *Arch, host: os.Caps, k: *Kind, relocs: *row.Lookup, out: *Dynamic) err[Fail] {
    val took: res[Id[Input], Fail] = input.borrow(inputs, Given{name: "a.o", object: o});
    if (sel took.err) { ret err[Fail].err{took.err}; }
    var rd:  Readers    = Readers{rows: table.make[Reader](inputs.a)};
    var rin: resolve.In = resolve.In{inputs: inputs, names: names, readers: ?rd, arch: ar, kind: k, search: 0, hooks: ?resolve.PLAIN, notes: notes};
    val rs:  err[Fail]  = resolve.run(?rin, res_of);
    if (sel rs.err) { ret rs; }
    var cin: collect.In = collect.In{inputs: inputs, names: names, resolved: res_of, kind: k, collects: false};
    val cs:  err[Fail]  = collect.run(?cin, live);
    if (sel cs.err) { ret cs; }
    var din: In = In{inputs: inputs, names: names, resolved: res_of, live: live, kind: k, arch: ar, rules: r, relocs: relocs, host: host};
    ret run(?din, out);
}

# rules a test decides with: a format that interposes and versions symbols,
# whose one row resolves every reference statically
val TEST_ROWS: [1]Row = [1]Row{Row{outcome: ?STATIC}};
val TEST:      Rules  = Rules{name: "test", caps: INTERPOSES | VERSIONED, rows: ?TEST_ROWS[0], count: 1, routes: nil, route_count: 0};
val SOLITARY:  Rules  = Rules{name: "solitary", caps: 0, rows: ?TEST_ROWS[0], count: 1, routes: nil, route_count: 0};

test dynamic__default_visibility_is_preemptible_and_hidden_and_protected_are_not {
    if (!preemptible(?TEST, ?output.SHARED, ?symbol.DEFAULT))  { ret 1; }
    if (preemptible(?TEST, ?output.SHARED, ?symbol.PROTECTED)) { ret 1; }
    if (preemptible(?TEST, ?output.SHARED, ?symbol.HIDDEN))    { ret 1; }
    if (preemptible(?TEST, ?output.SHARED, ?symbol.INTERNAL))  { ret 1; }
    # an executable's definitions come first in every lookup, and a format
    # that binds through a library's own namespace interposes nothing
    if (preemptible(?TEST, ?output.PIE, ?symbol.DEFAULT))        { ret 1; }
    if (preemptible(?SOLITARY, ?output.SHARED, ?symbol.DEFAULT)) { ret 1; }
    ret 0;
}

# rules whose one route lands a GOT reach in a signed GOT slot, stated only
# where pointers are signed
val ROUTED_ROUTES: [1]Route = [1]Route{Route{name: "signed got", reach: AT_GOT, arch: Axis{need: arch.SIGNED}, role: ?catalog_slot.AUTH_GOT}};
val ROUTED:        Rules    = Rules{name: "routed", caps: 0, rows: ?TEST_ROWS[0], count: 1, routes: ?ROUTED_ROUTES[0], route_count: 1};

test dynamic__a_reach_whose_role_the_format_does_not_state_is_refused_naming_the_reach_and_the_format {
    val signed: res[*Route, Fail] = route_of(?ROUTED, AT_GOT, ?aarch64.ARM64E, 0);
    if (sel signed.err)                           { ret 1; }
    if (signed.ok.role != ?catalog_slot.AUTH_GOT) { ret 1; }
    val plain: res[*Route, Fail] = route_of(?ROUTED, AT_GOT, ?x86.X86_64, 0);
    if (sel plain.ok)                                                                        { ret 2; }
    if (!sel plain.err.cause.unsupported)                                                    { ret 2; }
    if (!str_equals(plain.err.subject, "got") || !str_equals(plain.err.at.record, "routed")) { ret 2; }
    val call: res[*Route, Fail] = route_of(?ROUTED, AT_PLT, ?aarch64.ARM64E, 0);
    if (sel call.ok)                          { ret 3; }
    if (!str_equals(call.err.subject, "plt")) { ret 3; }
    ret 0;
}

fun intern_of(n: *Interner, s: str) Id[Name] {
    val r: res[Id[Name], Fail] = intern.intern_str(n, s);
    if (sel r.err) { ret Id[Name]{index: 0xFFFF_FFFF}; }
    ret r.ok;
}

fun bound_to(d: *Dynamic, l: u32, name: Id[Name], wants: opt[Id[Name]]) i64 {
    val o: opt[Id[Offer]] = bind_version(d, Id[Library]{index: l}, name, wants);
    if (sel o.none) { ret -1; }
    ret o.some.index::i64;
}

test dynamic__a_versioned_reference_binds_its_version_and_the_default_wins_an_unversioned_one {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:     *A.Allocator = T.allocator_of(?t);
    var names: Interner     = intern.make(a);
    var d:     Dynamic      = make(a);
    val foo:   Id[Name]     = intern_of(?names, "foo");
    val bar:   Id[Name]     = intern_of(?names, "bar");
    val one:   Id[Name]     = intern_of(?names, "V1");
    val two:   Id[Name]     = intern_of(?names, "V2");
    val three: Id[Name]     = intern_of(?names, "V3");
    val lib:   Id[Library]  = Id[Library]{index: 0};
    val other: Id[Library]  = Id[Library]{index: 1};

    # foo@V1, foo@@V2 and an unversioned bar, and another library's foo
    var offers: [4]Offer = [4]Offer{
        Offer{library: other, name: foo},
        Offer{library: lib, name: foo, version: opt[Id[Name]].some{one}},
        Offer{library: lib, name: foo, version: opt[Id[Name]].some{two}, default: true},
        Offer{library: lib, name: bar},
    };
    val o:  res[Id[Offer], Fail] = table.extend[Offer](?d.offers, ?offers[0], 4);
    var ok: bool                 = sel o.ok && fine(chain_offers(?d, intern.count(?names)));
    ok = ok && bound_to(?d, 0, foo, opt[Id[Name]].some{one}) == 1;
    ok = ok && bound_to(?d, 0, foo, opt[Id[Name]].some{two}) == 2;
    ok = ok && bound_to(?d, 0, foo, opt[Id[Name]].none{}) == 2;
    ok = ok && bound_to(?d, 1, foo, opt[Id[Name]].none{}) == 0;
    ok = ok && bound_to(?d, 0, bar, opt[Id[Name]].none{}) == 3;
    ok = ok && bound_to(?d, 0, foo, opt[Id[Name]].some{three}) == -1;
    ok = ok && bound_to(?d, 0, bar, opt[Id[Name]].some{one}) == -1;

    ok = fine(release(?d)) && ok;
    ok = fine(intern.release(?names)) && ok;
    if (!ok || T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

fun fine(e: err[Fail]) bool {
    ret sel e.ok;
}

fun borrowed(s: *Inputs, name: str, o: *Object) bool {
    val r: res[Id[Input], Fail] = input.borrow(s, Given{name: name, object: o});
    ret sel r.ok;
}

# a symbol named `name` of `o`
fun add(o: *Object, name: str, vis: *Visibility, def: Definition) bool {
    val nm: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel nm.err) { ret false; }
    val s: res[Id[Symbol], Fail] = object.add_symbol(o, Symbol{name: nm.ok, binding: ?symbol.GLOBAL, visibility: vis, kind: ?symbol.DATA, def: def});
    ret sel s.ok;
}

test dynamic__a_hidden_symbol_referenced_from_a_library_is_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator = T.allocator_of(?t);
    var main: Object       = object.make(a, ?x86.X86_64, ?kind.RELOCATABLE);
    var lib:  Object       = object.make(a, ?x86.X86_64, ?kind.SHARED);
    lib.library = opt[object.Library].some{object.Library{}};

    # the executable defines environ hidden, and the library refers to it
    val data: res[Id[Name], Fail] = object.name_str(?main, ".data");
    if (sel data.err) { ret 1; }
    val sec: res[Id[Section], Fail] = object.add_section(?main, Section{name: opt[Id[Name]].some{data.ok}, kind: ?section.DATA, flags: section.DATA.flags, align: 8, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel sec.err) { ret 1; }
    var ok: bool = add(?main, "environ", ?symbol.HIDDEN, Definition.placed{Place{section: sec.ok, offset: 0}});
    ok = ok && add(?lib, "environ", ?symbol.DEFAULT, Definition.undefined{});

    var inputs: Inputs   = input.make(a);
    var names:  Interner = intern.make(a);
    var r:      Resolved = resolve.make(a);
    var l:      Live     = collect.make(a);
    var d:      Dynamic  = make(a);
    ok = ok && borrowed(?inputs, "main.o", ?main) && borrowed(?inputs, "libc.so", ?lib);
    var rd:    Readers    = Readers{rows: table.make[Reader](a)};
    var notes: Sink       = sink.make(a, LITTLE);
    var rin:   resolve.In = resolve.In{inputs: ?inputs, names: ?names, readers: ?rd, arch: ?x86.X86_64, kind: ?output.PIE, search: 0, hooks: ?resolve.PLAIN, notes: ?notes};
    ok = ok && fine(resolve.run(?rin, ?r));
    ok = fine(sink.release(?notes)) && ok;
    var cin: collect.In = collect.In{inputs: ?inputs, names: ?names, resolved: ?r, kind: ?output.PIE, collects: false};
    ok = ok && fine(collect.run(?cin, ?l));
    var relocs: row.Lookup = row.Lookup{};
    var din:    In         = In{inputs: ?inputs, names: ?names, resolved: ?r, live: ?l, kind: ?output.PIE, arch: ?x86.X86_64, rules: ?TEST, relocs: ?relocs};
    if (ok) {
        val got: err[Fail] = run(?din, ?d);
        ok = sel got.err && str_equals(got.err.at.file, "libc.so");
        ok = ok && table.count[resolve.Reference](?d.hidden) == 1;
        if (ok) {
            val h: *resolve.Reference = table.at[resolve.Reference](?d.hidden, table.nth[resolve.Reference](0));
            val v: View               = intern.bytes_of(?names, h.name);
            ok = h.input.index == 1 && v.len == 7 && v.data[0] == 'e';
        }
    }

    ok = fine(release(?d)) && ok;
    ok = fine(collect.release(?l)) && ok;
    ok = fine(resolve.release(?r)) && ok;
    ok = fine(intern.release(?names)) && ok;
    ok = fine(input.release(?inputs)) && ok;
    ok = fine(object.release(?main)) && ok;
    ok = fine(object.release(?lib)) && ok;
    if (!ok || T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

# a library object of `dll` offering `name`, as one member of an import
# library describes its DLL
fun describing(a: *A.Allocator, o: *Object, dll: str, name: str) bool {
    @o = object.make(a, ?x86.X86_64, ?kind.STUB);
    val l: res[Id[Name], Fail] = object.name_str(o, dll);
    if (sel l.err) { ret false; }
    o.library = opt[object.Library].some{object.Library{loader: opt[Id[Name]].some{l.ok}}};
    val n: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel n.err) { ret false; }
    ret add(o, name, ?symbol.DEFAULT, Definition.library{object.Export.named{object.Named{name: n.ok}}});
}

# a marker of the text section of `o` at `offset` referring to its symbol `k`
fun marked(o: *Object, offset: u64, k: u32) bool {
    val r: res[Id[Reloc], Fail] = object.add_reloc(o, Reloc{section: Id[Section]{index: 0}, offset: offset, kind: ?reloc.NONE, target: object.Target.symbol{Id[Symbol]{index: k}}});
    ret sel r.ok;
}

# whether library `at` of `d` is `want`, first described by input `from`,
# ranked `rank` or unranked when it is -1, and loaded as `loaded` says
fun library_is(n: *Interner, d: *Dynamic, at: usize, want: str, from: u32, rank: i64, loaded: bool) bool {
    val l: *Library = table.at[Library](?d.libraries, table.nth[Library](at));
    val v: View     = intern.bytes_of(n, l.loader);
    if (l.input.index != from || v.len != 5 || v.data[0] != want[0] || l.loaded != loaded) { ret false; }
    val r: opt[u32] = l.rank;
    if (sel r.some) { ret r.some::i64 == rank; }
    ret rank == -1;
}

test dynamic__every_library_is_listed_once_in_input_order_with_its_first_reference_rank {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator = T.allocator_of(?t);
    var main: Object       = object.make(a, ?x86.X86_64, ?kind.RELOCATABLE);
    var libs: [4]Object;

    # main.o refers to b1 of b.dll first, then to a1 and a2 of a.dll, each
    # of which one input describes, and to nothing of c.dll
    val text: res[Id[Name], Fail] = object.name_str(?main, ".text");
    if (sel text.err) { ret 1; }
    val sec: res[Id[Section], Fail] = object.add_section(?main, Section{name: opt[Id[Name]].some{text.ok}, kind: ?section.TEXT, flags: section.TEXT.flags, align: 4, contents: object.Contents.zero{16}, disposition: ?section.WHOLE});
    if (sel sec.err) { ret 1; }
    var ok: bool = add(?main, "b1", ?symbol.DEFAULT, Definition.undefined{}) && add(?main, "a1", ?symbol.DEFAULT, Definition.undefined{});
    ok = ok && add(?main, "a2", ?symbol.DEFAULT, Definition.undefined{});
    ok = ok && marked(?main, 0, 0) && marked(?main, 4, 1) && marked(?main, 8, 2) && marked(?main, 12, 1);
    ok = describing(a, ?libs[0], "a.dll", "a1") && ok;
    ok = describing(a, ?libs[1], "a.dll", "a2") && ok;
    ok = describing(a, ?libs[2], "b.dll", "b1") && ok;
    ok = describing(a, ?libs[3], "c.dll", "c1") && ok;

    var inputs: Inputs   = input.make(a);
    var names:  Interner = intern.make(a);
    var r:      Resolved = resolve.make(a);
    var l:      Live     = collect.make(a);
    var d:      Dynamic  = make(a);
    ok = ok && borrowed(?inputs, "main.o", ?main) && borrowed(?inputs, "a1.o", ?libs[0]);
    ok = ok && borrowed(?inputs, "a2.o", ?libs[1]) && borrowed(?inputs, "b1.o", ?libs[2]) && borrowed(?inputs, "c1.o", ?libs[3]);
    var rd:    Readers    = Readers{rows: table.make[Reader](a)};
    var notes: Sink       = sink.make(a, LITTLE);
    var rin:   resolve.In = resolve.In{inputs: ?inputs, names: ?names, readers: ?rd, arch: ?x86.X86_64, kind: ?output.PIE, search: 0, hooks: ?resolve.PLAIN, notes: ?notes};
    ok = ok && fine(resolve.run(?rin, ?r));
    ok = fine(sink.release(?notes)) && ok;
    var cin: collect.In = collect.In{inputs: ?inputs, names: ?names, resolved: ?r, kind: ?output.PIE, collects: false};
    ok = ok && fine(collect.run(?cin, ?l));
    var relocs: row.Lookup = row.Lookup{};
    var din:    In         = In{inputs: ?inputs, names: ?names, resolved: ?r, live: ?l, kind: ?output.PIE, arch: ?x86.X86_64, rules: ?TEST, relocs: ?relocs};
    ok = ok && fine(run(?din, ?d));
    ok = ok && table.count[Import](?d.imports) == 3 && table.count[Library](?d.libraries) == 3;
    ok = ok && library_is(?names, ?d, 0, "a.dll", 1, 1, true) && library_is(?names, ?d, 1, "b.dll", 3, 0, true);
    ok = ok && library_is(?names, ?d, 2, "c.dll", 4, -1, false);

    ok = fine(release(?d)) && ok;
    ok = fine(collect.release(?l)) && ok;
    ok = fine(resolve.release(?r)) && ok;
    ok = fine(intern.release(?names)) && ok;
    ok = fine(input.release(?inputs)) && ok;
    ok = fine(object.release(?main)) && ok;
    var k: usize = 0;
    for (k < 4) {
        ok = fine(object.release(?libs[k])) && ok;
        k  = k + 1;
    }
    if (!ok || T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
