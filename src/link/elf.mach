# how ELF links: the linking row of the ELF format and the rows it names

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

use mink.base.rule.Axis;
use mink.catalog.output;
use mink.format.elf.layout;
use mink.format.layout.Rules;
use mink.link.common;
use mink.link.consume;
use mink.link.elf.convention;
use mink.link.elf.dynamic;
use mink.link.elf.image;
use mink.link.elf.templates;
use mink.link.fold;
use mink.link.image.Writer;
use mink.link.layout.Participant;
use mink.link.layout.Participants;
use mink.link.linking;
use mink.link.linking.Linking;
use mink.link.linking.Synthesizers;
use mink.link.needs;
use mink.link.relax;
use mink.link.reserve;
use mink.link.reserve.Declarer;
use mink.link.reserve.Declarers;
use mink.link.resolve;
use mink.link.resolve.Weak;
use mink.link.synthesizer;
use mink.link.thunk;
use mink.model.directive;

# the sections that are not image content an ELF link takes
val USE_COUNT: usize                   = 3;
val USES:      [USE_COUNT]*consume.Row = [USE_COUNT]*consume.Row{?consume.SIGNIFICANCE, ?consume.STRINGS, ?consume.STACK};

# resolution reads an export directive as the default visibility of the name
# it is about, which the dynamic phase exports
val DIRECTIVES: [1]*directive.Kind = [1]*directive.Kind{?directive.EXPORT};

val SYNTHESIZER_COUNT: usize                               = 2;
val SYNTHESIZERS:      [SYNTHESIZER_COUNT]*synthesizer.Row = [SYNTHESIZER_COUNT]*synthesizer.Row{?common.ROW, ?needs.ROW};

# relaxation rewrites the relocations whose rows state forms, as a RISC-V
# ALIGN deletes the padding its alignment does not need, and thunks send a
# branch past its reach through a veneer in an island
val PARTICIPANT_COUNT: usize                           = 2;
val PARTICIPANTS:      [PARTICIPANT_COUNT]*Participant = [PARTICIPANT_COUNT]*Participant{?relax.RELAX, ?thunk.THUNKS};

val DECLARER_COUNT: usize                     = 4;
val DECLARERS:      [DECLARER_COUNT]*Declarer = [DECLARER_COUNT]*Declarer{?reserve.HEADER_TABLE, ?image.TABLES, ?dynamic.TABLES, ?convention.SLOTS};

# an archive is searched once where it stands, and a common definition pulls a
# member that defines its name as data, since a tentative definition and the
# member's definition are one object. an undefined weak reference resolves to
# zero, as the gABI states. merged strings share the tails of longer ones.
# sections nothing reaches are kept unless --gc-sections is given. only a
# shared library exports the definitions its visibility shows, as an
# executable's dynamic symbol table holds only what a library refers to. an
# image needs every shared library named
pub val LINKING: Linking = Linking{
    caps:         linking.SHARED_CIES | linking.UNBROKEN_FRAMES,
    search:       resolve.COMMON_PULL,
    hooks:        ?resolve.PLAIN,
    weak:         Weak.zero{},
    folds:        fold.NONE,
    layout:       opt[*Rules].some{?layout.LAYOUT},
    tails:        true,
    collects:     false,
    exports:      Axis{need: output.EXPORTS, deny: 0},
    dynamic:      ?convention.DYNAMIC,
    loads_all:    true,
    facts:        ?convention.FACTS,
    writer:       opt[*Writer].some{?image.WRITER},
    declarers:    Declarers{rows: ?DECLARERS[0], count: DECLARER_COUNT},
    measures:     image.MEASURES,
    uses:         consume.Uses{rows: ?USES[0], count: USE_COUNT, directives: ?DIRECTIVES[0], directive_count: 1},
    synthesizers: Synthesizers{rows: ?SYNTHESIZERS[0], count: SYNTHESIZER_COUNT},
    participants: Participants{rows: ?PARTICIPANTS[0], count: PARTICIPANT_COUNT},
    bounds:       dynamic.BOUNDS,
    calls:        dynamic.CALLS,
    templates:    templates.SETS,
};
