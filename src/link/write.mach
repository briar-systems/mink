# the write phase: the image record through its format's image writer

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.format;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.link.image;
use mink.link.image.Image;
use mink.link.image.Writer;

# a:      the allocator the image's bytes live in
# writer: the output format's image writer, none where none is built yet
# image:  what the link built
pub rec In {
    a:      *A.Allocator;
    writer: opt[*Writer];
    image:  *Image;
}

# the image's bytes into `out`, which holds nothing before
pub fun run(in: *In, out: *Sink) err[Fail] {
    if (sel in.writer.none) {
        ret err[Fail].err{fail.in_record(fail.unsupported("no image writer is built for this format yet"), in.image.format.name)};
    }
    val w: *Writer = in.writer.some;
    if (!image.builds(w, in.image.kind)) {
        ret err[Fail].err{fail.in_record(fail.unsupported("the image writer does not build this output kind yet"), in.image.kind.name)};
    }
    val r: res[Sink, Fail] = w.write(in.a, in.image);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    @out = r.ok;
    ret err[Fail].ok{};
}

val STUB_KINDS: [1]*Kind = [1]*Kind{?output.RELOCATABLE};
val STUB:       Writer   = Writer{kinds: ?STUB_KINDS[0], kind_count: 1, write: stub_write};

fun stub_write(a: *A.Allocator, img: *Image) res[Sink, Fail] {
    var out: Sink      = sink.make(a, LITTLE);
    val w:   err[Fail] = sink.text(?out, img.kind.name);
    if (sel w.err) { ret res[Sink, Fail].err{w.err}; }
    ret res[Sink, Fail].ok{out};
}

test write__refuses_a_kind_its_writer_does_not_build {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var img: Image = Image{kind: ?output.SHARED, format: ?format.ELF};
    var in:  In    = In{a: T.allocator_of(?t), writer: opt[*Writer].some{?STUB}, image: ?img};
    var out: Sink;

    val shared: err[Fail] = run(?in, ?out);
    if (sel shared.ok)                     { ret 1; }
    if (!sel shared.err.cause.unsupported) { ret 1; }
    img.kind  = ?output.RELOCATABLE;
    in.writer = opt[*Writer].none{};
    val unwritten: err[Fail] = run(?in, ?out);
    if (sel unwritten.ok)                     { ret 1; }
    if (!sel unwritten.err.cause.unsupported) { ret 1; }
    in.writer = opt[*Writer].some{?STUB};
    val built: err[Fail] = run(?in, ?out);
    if (sel built.err)        { ret 1; }
    if (sink.len(?out) != 11) { ret 1; }

    val rel: err[Fail] = sink.release(?out);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
