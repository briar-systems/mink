# the write phase: the image record through its format's image writer
#
# an image whose kind exports, written by a writer that makes an interface
# file, comes with that file, the one a later link binds against the image
# through in its place, as a DLL's import library.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.output;
use mink.link.image;
use mink.link.image.Image;
use mink.link.image.Writer;

# a:      the allocator the image's bytes live in
# writer: the output format's image writer, none where none is built yet
# image:  what the link built
pub rec In {
    a:      *A.Allocator;
    writer: opt[*Writer];
    image:  *Image;
}

# what a link writes
# ---
# image:     the image's bytes
# interface: the bytes of the file a later link binds against the image
#            through in its place, none for an image whose kind exports
#            nothing or whose format's links bind against the image itself
pub rec Written {
    image:     Sink;
    interface: opt[Sink];
}

# nothing written yet, in `a`
pub fun make(a: *A.Allocator) Written {
    ret Written{image: sink.make(a, LITTLE), interface: opt[Sink].none{}};
}

# give back what `w` holds
pub fun release(w: *Written) err[Fail] {
    var first: err[Fail] = sink.release(?w.image);
    if (sel w.interface.some) { first = fail.kept(first, sink.release(?w.interface.some)); }
    w.interface = opt[Sink].none{};
    ret first;
}

# the image's bytes, and its interface file where it has one, into `out`,
# which holds nothing before
pub fun run(in: *In, out: *Written) err[Fail] {
    if (sel in.writer.none) {
        ret err[Fail].err{fail.in_record(fail.unsupported("no image writer is built for this format yet"), in.image.format.name)};
    }
    val w: *Writer = in.writer.some;
    if (!image.builds(w, in.image.kind)) {
        ret err[Fail].err{fail.in_record(fail.unsupported("the image writer does not build this output kind yet"), in.image.kind.name)};
    }
    if (sel in.image.compress.some && !w.compresses) {
        ret err[Fail].err{fail.in_record(fail.unsupported("the image writer does not compress debug sections"), in.image.format.name)};
    }
    if ((sel in.image.size.some || sel in.image.fill.some) && sel w.sizing.refused) {
        ret err[Fail].err{fail.in_record(fail.unsupported("the image writer's format has no image a stated size bounds or a fill pads"), in.image.format.name)};
    }
    if (sel in.image.fill.some && sel w.sizing.ceiling) {
        ret err[Fail].err{fail.in_record(fail.unsupported("an image of this format loads no byte outside its segments, so it takes no fill"), in.image.format.name)};
    }
    val r: res[Sink, Fail] = w.write(in.a, in.image);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    var made: opt[Sink]             = opt[Sink].none{};
    val face: opt[image.Interfacer] = w.interface;
    if (sel face.some) {
        if (output.has(in.image.kind, output.EXPORTS)) {
            val interfacer: image.Interfacer = face.some;
            val f:          res[Sink, Fail]  = interfacer(in.a, in.image);
            if (sel f.err) {
                var lost:    Sink      = r.ok;
                val dropped: err[Fail] = sink.release(?lost);
                ret err[Fail].err{f.err};
            }
            made = opt[Sink].some{f.ok};
        }
    }
    out.image     = r.ok;
    out.interface = made;
    ret err[Fail].ok{};
}
