# the write phase: the image record through its format's image writer
#
# an image whose kind exports, written by a writer that makes an interface
# file, comes with that file, the one a later link binds against the image
# through in its place, as a DLL's import library.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.link.image;
use mink.link.image.Image;
use mink.link.image.Writer;
use mink.link.options;

# a:      the allocator the image's bytes live in
# writer: the output format's image writer, none where none is built yet
# image:  what the link built
pub rec In {
    a:      *A.Allocator;
    writer: opt[*Writer];
    image:  *Image;
}

# what a link writes
# ---
# image:     the image's bytes
# interface: the bytes of the file a later link binds against the image
#            through in its place, none for an image whose kind exports
#            nothing or whose format's links bind against the image itself
pub rec Written {
    image:     Sink;
    interface: opt[Sink];
}

# nothing written yet, in `a`
pub fun make(a: *A.Allocator) Written {
    ret Written{image: sink.make(a, LITTLE), interface: opt[Sink].none{}};
}

# give back what `w` holds
pub fun release(w: *Written) err[Fail] {
    var err_first: err[Fail] = sink.release(?w.image);
    if (sel w.interface.some) { err_first = fail.kept(err_first, sink.release(?w.interface.some)); }
    w.interface = opt[Sink].none{};
    ret err_first;
}

# the image's bytes, and its interface file where it has one, into `out`,
# which holds nothing before
pub fun run(in: *In, out: *Written) err[Fail] {
    if (sel in.writer.none) {
        ret err[Fail].err{fail.in_record(fail.unsupported("no image writer is built for this format yet"), in.image.format.name)};
    }
    val w: *Writer = in.writer.some;
    if (!image.builds(w, in.image.kind)) {
        ret err[Fail].err{fail.of_option(fail.in_record(fail.unsupported("the image writer does not build this output kind yet"), in.image.kind.name), options.KIND)};
    }
    if (sel in.image.compress.some && !w.compresses) {
        ret err[Fail].err{fail.of_option(fail.in_record(fail.unsupported("the image writer does not compress debug sections"), in.image.format.name), options.COMPRESS)};
    }
    if ((sel in.image.size.some || sel in.image.fill.some) && sel w.sizing.refused) {
        var stated: fail.Option = options.SIZE;
        if (sel in.image.size.none) { stated = options.FILL; }
        ret err[Fail].err{fail.of_option(fail.in_record(fail.unsupported("the image writer's format has no image a stated size bounds or a fill pads"), in.image.format.name), stated)};
    }
    if (sel in.image.fill.some && sel w.sizing.ceiling) {
        ret err[Fail].err{fail.of_option(fail.in_record(fail.unsupported("an image of this format loads no byte outside its segments, so it takes no fill"), in.image.format.name), options.FILL)};
    }
    val err_stacks: err[Fail] = image.stacks(w, in.image);
    if (sel err_stacks.err) { ret err_stacks; }
    val res_write: res[Sink, Fail] = w.write(in.a, in.image);
    if (sel res_write.err) { ret err[Fail].err{res_write.err}; }
    var opt_made: opt[Sink]             = opt[Sink].none{};
    val opt_face: opt[image.Interfacer] = w.interface;
    if (sel opt_face.some) {
        if (in.image.exports) {
            val interfacer:     image.Interfacer     = opt_face.some;
            val res_interfacer: res[opt[Sink], Fail] = interfacer(in.a, in.image);
            if (sel res_interfacer.err) {
                var lost:        Sink      = res_write.ok;
                val err_dropped: err[Fail] = sink.release(?lost);
                ret err[Fail].err{res_interfacer.err};
            }
            opt_made = res_interfacer.ok;
        }
    }
    out.image     = res_write.ok;
    out.interface = opt_made;
    ret err[Fail].ok{};
}
