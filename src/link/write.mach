# the write phase: the image record through its format's image writer
#
# an image whose kind exports, written by a writer that makes an interface
# file, comes with that file, the one a later link binds against the image
# through in its place, as a DLL's import library.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.OwnedString;
use std.types.string.owned_dnit;
use std.types.string.owned_dup;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.link.image;
use mink.link.image.Image;
use mink.link.image.Writer;
use mink.link.options;

# what the write phase reads
# ---
# a:      the allocator the image's bytes live in
# writer: the output format's image writer, none where none is built yet
# image:  what the link built
pub rec In {
    a:      *A.Allocator;
    writer: opt[*Writer];
    image:  *Image;
}

# where the written image starts, the entry the link resolved and gave the
# image
# ---
# none:   its kind starts at no entry, as a library or an object does
# points: it names its own entry points, which its format states, as a SPIR-V
#         module does
# absent: its kind starts at the entry symbol of this spelling, which the
#         host leaves optional and the link defines nowhere, so it starts at
#         none
# symbol: it starts at the entry symbol of this spelling
pub tag Started: u8 {
    none;
    points;
    absent: OwnedString;
    symbol: OwnedString;
}

# what a link writes
# ---
# image:     the image's bytes
# interface: the bytes of the file a later link binds against the image
#            through in its place, none for an image whose kind exports
#            nothing or whose format's links bind against the image itself
# entry:     where the image starts
pub rec Written {
    image:     Sink;
    interface: opt[Sink];
    entry:     Started;
}

# nothing written yet, in `a`
pub fun init(a: *A.Allocator) Written {
    ret Written{image: sink.init(a, LITTLE), interface: opt[Sink].none{}, entry: Started.none{}};
}

# give back what `w` holds
pub fun dnit(w: *Written) err[Fail] {
    var err_first: err[Fail] = sink.dnit(?w.image);
    if (sel w.interface.some) { err_first = fail.kept(err_first, sink.dnit(?w.interface.some)); }
    w.interface = opt[Sink].none{};
    err_first   = fail.kept(err_first, started_dnit(?w.entry));
    w.entry     = Started.none{};
    ret err_first;
}

# the image's bytes, and its interface file where it has one, into `out`,
# which holds nothing before
pub fun run(in: *In, out: *Written) err[Fail] {
    if (sel in.writer.none) {
        ret err[Fail].err{fail.in_record(fail.unsupported("no image writer is built for this format yet"), in.image.format.name)};
    }
    val w: *Writer = in.writer.some;
    if (!image.builds(w, in.image.kind)) {
        ret err[Fail].err{fail.of_option(fail.in_record(fail.unsupported("the image writer does not build this output kind yet"), in.image.kind.name), options.KIND)};
    }
    if (sel in.image.compress.some && !w.compresses) {
        ret err[Fail].err{fail.of_option(fail.in_record(fail.unsupported("the image writer does not compress debug sections"), in.image.format.name), options.COMPRESS)};
    }
    if ((sel in.image.size.some || sel in.image.fill.some) && sel w.sizing.refused) {
        var stated: fail.Option = options.SIZE;
        if (sel in.image.size.none) { stated = options.FILL; }
        ret err[Fail].err{fail.of_option(fail.in_record(fail.unsupported("the image writer's format has no image a stated size bounds or a fill pads"), in.image.format.name), stated)};
    }
    if (sel in.image.fill.some && sel w.sizing.ceiling) {
        ret err[Fail].err{fail.of_option(fail.in_record(fail.unsupported("an image of this format loads no byte outside its segments, so it takes no fill"), in.image.format.name), options.FILL)};
    }
    if (in.image.pad && !sel w.sizing.pads) {
        ret err[Fail].err{fail.of_option(fail.in_record(fail.unsupported("only a flat image is padded to its size, as a loader maps an image of this format by its segments"), in.image.format.name), options.PAD)};
    }
    if (in.image.pad && sel in.image.size.none) {
        ret err[Fail].err{fail.of_option(fail.malformed("a pad fills the image to its size, which the link states none of"), options.PAD)};
    }
    if (!in.image.headers && !w.headerless) {
        ret err[Fail].err{fail.of_option(fail.in_record(fail.unsupported("the loader of an image of this format reads its section table, so the image keeps it"), in.image.format.name), options.HEADERS)};
    }
    val err_stacks: err[Fail] = image.stacks(w, in.image);
    if (sel err_stacks.err) { ret err_stacks; }
    val res_started: res[Started, Fail] = started(in.a, ?in.image.entry);
    if (sel res_started.err) { ret err[Fail].err{res_started.err}; }
    var entry:     Started         = res_started.ok;
    val res_write: res[Sink, Fail] = w.write(in.a, in.image);
    if (sel res_write.err) {
        val err_dropped: err[Fail] = started_dnit(?entry);
        ret err[Fail].err{res_write.err};
    }
    var opt_made: opt[Sink]             = opt[Sink].none{};
    val opt_face: opt[image.Interfacer] = w.interface;
    if (sel opt_face.some) {
        if (in.image.exports) {
            val interfacer:     image.Interfacer     = opt_face.some;
            val res_interfacer: res[opt[Sink], Fail] = interfacer(in.a, in.image);
            if (sel res_interfacer.err) {
                var lost:        Sink      = res_write.ok;
                val err_dropped: err[Fail] = sink.dnit(?lost);
                val err_unnamed: err[Fail] = started_dnit(?entry);
                ret err[Fail].err{res_interfacer.err};
            }
            opt_made = res_interfacer.ok;
        }
    }
    out.image     = res_write.ok;
    out.interface = opt_made;
    out.entry     = entry;
    ret err[Fail].ok{};
}

# where an image starting at `e` starts, its entry symbol's spelling owned in
# `a`
fun started(a: *A.Allocator, e: *image.Entry) res[Started, Fail] {
    if (sel e.points) { ret res[Started, Fail].ok{Started.points{}}; }
    if (sel e.absent) {
        val res_absent: res[OwnedString, A.Error] = owned_dup(a, e.absent);
        if (sel res_absent.err) { ret res[Started, Fail].err{fail.refused(res_absent.err)}; }
        ret res[Started, Fail].ok{Started.absent{res_absent.ok}};
    }
    if (sel e.symbol) {
        val res_name: res[OwnedString, A.Error] = owned_dup(a, e.symbol.name);
        if (sel res_name.err) { ret res[Started, Fail].err{fail.refused(res_name.err)}; }
        ret res[Started, Fail].ok{Started.symbol{res_name.ok}};
    }
    ret res[Started, Fail].ok{Started.none{}};
}

# give back the spelling `s` owns, for a caller that takes a written link
# apart rather than giving it all back with dnit
pub fun started_dnit(s: *Started) err[Fail] {
    var err_name: err[A.Error] = err[A.Error].ok{};
    if (sel s.absent)     { err_name = owned_dnit(?s.absent); }
    or (sel s.symbol)     { err_name = owned_dnit(?s.symbol); }
    if (sel err_name.err) { ret err[Fail].err{fail.refused(err_name.err)}; }
    ret err[Fail].ok{};
}
