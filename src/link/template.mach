# code templates: the linker-made code and slots as rows
#
# a PLT entry, a stub, a veneer or a thunk is a template row:
# fixed bytes, their length and alignment, and the points patched in them. a
# patch point is a field offset, a neutral relocation kind and the target it
# reaches, applied through the relocation row of the pair, so no template
# encodes an instruction by hand. a set is the templates of one (format,
# architecture) pair, which the pair's row names, and the format registry
# checks every row of each against the pair's relocation rows as it builds.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.rule;
use mink.base.table.Table;
use mink.catalog.arch;
use mink.catalog.os;
use mink.catalog.output;
use mink.catalog.slot;
use mink.catalog.slot.Role;
use mink.catalog.trait;
use mink.catalog.trait.Trait;
use mink.link.boundary.Anchor;
use mink.model.reloc.Kind;
use mink.reloc.compute;
use mink.reloc.engine;
use mink.reloc.engine.Site;
use mink.reloc.row;
use mink.reloc.row.Condition;

# what a template is shaped for beyond its role, as the code a feature of
# the target asks for
pub rec Variant {
    name: str;
}

# the form no feature asks for
pub val PLAIN: Variant = Variant{name: "plain"};
# the form that marks indirect branch targets, as x86 IBT asks
pub val IBT: Variant = Variant{name: "ibt"};
# the form that marks branch targets, as AArch64 BTI asks
pub val BTI: Variant = Variant{name: "bti"};
# the form that authenticates the pointer it loads, as AArch64 PAC asks
pub val PAC: Variant = Variant{name: "pac"};
# the form that reaches its slot relative to itself, as an image the loader
# may place anywhere asks
pub val PIC: Variant = Variant{name: "pic"};

# what a patch point reaches, bound to a value when a template is emitted
pub rec Target {
    name: str;
}

# the start of the GOT of the PLT
pub val GOT_PLT: Target = Target{name: "got.plt"};
# the GOT slot of this entry
pub val SLOT: Target = Target{name: "slot"};
# the PLT header
pub val HEADER: Target = Target{name: "header"};
# this entry's own PLT entry
pub val ENTRY: Target = Target{name: "entry"};
# this entry's index among the relocations the loader binds lazily
pub val INDEX: Target = Target{name: "index"};
# the dynamic section
pub val DYNAMIC: Target = Target{name: "dynamic"};
# where the code the template stands for goes
pub val DESTINATION: Target = Target{name: "destination"};
# the slot the loader's routine that binds a lazy pointer is reached through
pub val BINDER: Target = Target{name: "binder"};
# the cell the loader's routine that binds a lazy pointer keeps the image's
# state in
pub val CACHE: Target = Target{name: "cache"};

# the dynamic section, which a table names so a template can reach it
pub val DYNAMIC_SECTION: Anchor = Anchor{name: "dynamic section"};

# a point patched in a template
# ---
# offset:   where its field starts in the template
# kind:     the neutral relocation kind patching it
# target:   what it reaches
# addend:   the addend
# base:     what its target is reached from, its value taken from the
#           target's, none to reach the target itself
# optional: its target may be absent from the link, as the dynamic section
#           is from a static image, and the template's bytes then stand
pub rec Patch {
    offset:   u64;
    kind:     *Kind;
    target:   *Target;
    addend:   i64;
    base:     opt[*Target];
    optional: bool;
}

# role:        what the template is to the linker
# variant:     the form it is of its role
# when:        what must hold of the output and the traits for the link to
#              take it, naming no target and no value range
# name:        its spelling in a diagnostic
# bytes:       its fixed bytes, static
# len:         how many bytes
# align:       its alignment, a power of two
# patches:     the points patched in it
# patch_count: how many
pub rec Template {
    role:        *Role;
    variant:     *Variant;
    when:        Condition;
    name:        str;
    bytes:       *u8;
    len:         u64;
    align:       u64;
    patches:     *Patch;
    patch_count: usize;
}

# the templates of one (format, architecture) pair
# ---
# rows:  pointers to the templates, static
# roles: the same pointers ascending by role name, then variant name, static
# count: how many
pub rec Set {
    rows:  **Template;
    roles: **Template;
    count: usize;
}

fun order_roles(a: **Template, b: **Template) i64 {
    val r: i64 = str_compare(a[0].role.name, b[0].role.name);
    if (r != 0) { ret r; }
    ret str_compare(a[0].variant.name, b[0].variant.name);
}

fun order_role(a: **Template, b: **Template) i64 {
    ret str_compare(a[0].role.name, b[0].role.name);
}

# the template that fills an entry of the template role `r` in an output of
# kind `k` whose merged traits are `ts`, of the pair whose templates are `s`:
# the one row of the role whose condition holds. a pair with no templates or
# no row of the role that holds is refused
pub fun chosen(s: opt[*Set], r: *Role, k: *output.Kind, ts: *Table[Trait]) res[*Template, Fail] {
    if (sel s.none) { ret res[*Template, Fail].err{fail.about(fail.unsupported("the output pair states no code templates"), r.name)}; }
    val set:  *Set           = s.some;
    var role: Template       = Template{role: r};
    val at:   opt[*Template] = index.find[Template](set.roles, set.count, ?role, order_role);
    if (sel at.none) { ret res[*Template, Fail].err{fail.about(fail.unsupported("no code template has this role"), r.name)}; }
    var first: usize = 0;
    for (first < set.count && set.roles[first] != at.some) { first = first + 1; }
    for (first > 0 && set.roles[first - 1].role == r) { first = first - 1; }
    var found: *Template = nil;
    var i:     usize     = first;
    for (i < set.count && set.roles[i].role == r) {
        val t: *Template = set.roles[i];
        i = i + 1;
        if (!holds(?t.when, k, ts)) { cnt; }
        if (found != nil)           { ret res[*Template, Fail].err{fail.about(fail.internal("two code templates of one role hold for one output"), r.name)}; }
        found = t;
    }
    if (found == nil) { ret res[*Template, Fail].err{fail.about(fail.unsupported("no code template of the role holds for the output and its traits"), r.name)}; }
    ret res[*Template, Fail].ok{found};
}

# whether the condition `w` holds of an output of kind `k` whose merged
# traits are `ts`, an axis no input states holding its absent value
fun holds(w: *Condition, k: *output.Kind, ts: *Table[Trait]) bool {
    if (!rule.holds(?w.output, k.caps)) { ret false; }
    var i: usize = 0;
    for (i < w.trait_count) {
        val want: *os.When    = ?w.traits[i];
        val have: opt[*Trait] = trait.find(ts, want.axis);
        i = i + 1;
        if (sel have.some) {
            if (!trait.same(have.some.setting, want.setting)) { ret false; }
            cnt;
        }
        val absent: opt[trait.Setting] = trait.absent_value(want.axis);
        if (sel absent.none)                        { ret false; }
        if (!trait.same(absent.some, want.setting)) { ret false; }
    }
    ret true;
}

# whether the conditions `a` and `b` can both hold: their outputs meet and
# no axis both state takes two settings
fun conditions_meet(a: *Condition, b: *Condition) bool {
    if (!rule.meets(?a.output, ?b.output)) { ret false; }
    var i: usize = 0;
    for (i < a.trait_count) {
        var k: usize = 0;
        for (k < b.trait_count) {
            if (a.traits[i].axis == b.traits[k].axis && !trait.same(a.traits[i].setting, b.traits[k].setting)) { ret false; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret true;
}

# refuse a set with a malformed row, a defect of mink: an empty template, a
# condition over a target, a value range, the architecture or an input's own
# traits, an alignment that is not a power of two, a role index that is not sound, two
# rows of one role whose conditions can both hold, or a patch point with no
# target, no relocation row of the pair, or a field past the template's end
pub fun check(s: *Set, relocs: *row.Lookup) err[Fail] {
    val x: err[Fail] = index.verify[Template](s.roles, s.count, s.rows, s.count, order_roles);
    if (sel x.err) { ret x; }
    var i: usize = 0;
    for (i < s.count) {
        val e: err[Fail] = sound(s, relocs, i);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "code template", i::u64)}; }
        i = i + 1;
    }
    i = 0;
    for (i + 1 < s.count) {
        val a: *Template = s.roles[i];
        var k: usize     = i + 1;
        for (k < s.count && s.roles[k].role == a.role) {
            if (conditions_meet(?a.when, ?s.roles[k].when)) { ret err[Fail].err{fail.about(fail.internal("two code templates of one role can both hold"), a.role.name)}; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun sound(s: *Set, relocs: *row.Lookup, i: usize) err[Fail] {
    val t: *Template = s.rows[i];
    if (t.len == 0 || t.bytes == nil) { ret err[Fail].err{fail.internal("code template is empty")}; }
    if (t.variant == nil)             { ret err[Fail].err{fail.internal("code template names no form")}; }
    if (t.when.target.need != 0 || t.when.target.deny != 0 || sel t.when.range.some) {
        ret err[Fail].err{fail.internal("code template's condition names a target or a value range")};
    }
    if (t.when.trait_count != 0 && t.when.traits == nil) { ret err[Fail].err{fail.internal("code template's condition counts traits it does not list")}; }
    if (t.when.arch.need != 0 || t.when.arch.deny != 0 || t.when.own_count != 0) {
        ret err[Fail].err{fail.internal("code template's condition names the architecture or an input's own traits, which its pair and the link's traits settle")};
    }
    if (t.align == 0 || (t.align & (t.align - 1)) != 0) {
        ret err[Fail].err{fail.internal("code template alignment is not a power of two")};
    }
    var k: usize = 0;
    for (k < t.patch_count) {
        val p: *Patch = ?t.patches[k];
        if (p.target == nil)                       { ret err[Fail].err{fail.internal("code template patch point has no target")}; }
        if (sel p.base.some && p.base.some == nil) { ret err[Fail].err{fail.internal("code template patch point names no base")}; }
        val r: res[*row.Row, Fail] = row.by_kind(relocs, p.kind);
        if (sel r.err) { ret err[Fail].err{fail.internal("code template patch point has no relocation row")}; }
        val bytes: u64 = row.container(r.ok)::u64;
        if (p.offset > t.len || bytes > t.len - p.offset) {
            ret err[Fail].err{fail.internal("code template patch point runs past its end")};
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the value a target takes in one emitted copy
pub rec Bound {
    target: *Target;
    value:  u64;
}

# copy `t` into `out`, which holds its length, as the copy loaded at
# `address`, and patch every point through the relocation rows `relocs` of its
# pair with the value its target takes among the `count` at `bound`, leaving
# an optional point whose target is not bound as the template's bytes have it
pub fun emit(relocs: *row.Lookup, t: *Template, out: *u8, address: u64, bound: *Bound, count: usize) err[Fail] {
    var i: usize = 0;
    for (i < t.len::usize) {
        out[i] = t.bytes[i];
        i      = i + 1;
    }
    var k: usize = 0;
    for (k < t.patch_count) {
        val p: *Patch = ?t.patches[k];
        val v: *Bound = value_of(p.target, bound, count);
        k = k + 1;
        if (v == nil) {
            if (p.optional) { cnt; }
            ret err[Fail].err{fail.in_record(fail.internal("code template patch point's target is not bound"), t.name)};
        }
        var s: u64 = v.value;
        if (sel p.base.some) {
            val from: *Bound = value_of(p.base.some, bound, count);
            if (from == nil) { ret err[Fail].err{fail.in_record(fail.internal("code template patch point's base is not bound"), t.name)}; }
            s = s - from.value;
        }
        val r: res[*row.Row, Fail] = row.by_kind(relocs, p.kind);
        if (sel r.err) { ret err[Fail].err{fail.in_record(r.err, t.name)}; }
        var site: Site           = Site{section: t.name, data: out, size: t.len, offset: p.offset, order: relocs.set.arch.order};
        var x:    compute.Inputs = compute.Inputs{s: s, a: p.addend, p: address + p.offset, page: arch.page_bytes(relocs.set.arch), width: arch.pointer_bytes(relocs.set.arch)};
        reached(?x, s);
        val e: err[Fail] = engine.apply(r.ok, ?site, ?x);
        if (sel e.err) { ret e; }
    }
    ret err[Fail].ok{};
}

# a patch point reaches its bound value itself, so a row that reads where a
# linker-made entry of its target lies, as a branch reads its stub, reads
# that value
fun reached(x: *compute.Inputs, value: u64) {
    x.g = value;
    var i: usize = 0;
    for (i < slot.SLOT_ROLES) {
        x.anchors[i] = value;
        i            = i + 1;
    }
}

fun value_of(t: *Target, bound: *Bound, count: usize) *Bound {
    var i: usize = 0;
    for (i < count) {
        if (bound[i].target == t) { ret ?bound[i]; }
        i = i + 1;
    }
    ret nil;
}
