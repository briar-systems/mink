# common storage, the synthesizer that gives common symbols their bytes
#
# resolution merges the commons of a name: the largest size and alignment any
# of them asks for, a strong definition winning over them and a weak one not,
# as the System V ABI states under symbol binding: "the link editor honors the
# common definition and ignores the weak ones". the names still bound to a
# common definition when resolution ends, those of archive members it pulled
# in included, are read from its output, so no input is read again and no
# format is known here. each gets one zero-fill section holding one symbol, as
# large as the merged size and aligned to the merged alignment, at the stage
# after resolve. the symbol is a strong definition whatever its commons were,
# which is what makes it take the name over them when the input it joins is
# resolved, so a name gets its storage exactly once.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.catalog.arch.x86;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.format.contract;
use mink.link.input;
use mink.link.input.Appended;
use mink.link.input.Input;
use mink.link.input.Source;
use mink.link.resolve;
use mink.link.resolve.Binding;
use mink.link.resolve.Storage;
use mink.link.synthesizer;
use mink.link.synthesizer.Context;
use mink.link.synthesizer.Row;
use mink.model.object;
use mink.model.object.Common;
use mink.model.object.Definition;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.section;
use mink.model.symbol;
use mink.model.target;
use mink.model.target.Target;

# every kind but a relocatable object, which keeps its commons for the link
# that takes it
val KINDS: [7]*Kind = [7]*Kind{?output.STATIC, ?output.DYNAMIC, ?output.PIE, ?output.STATIC_PIE, ?output.SHARED, ?output.BUNDLE, ?output.MODULE};

pub val ROW: Row = Row{name: "common storage", stage: ?synthesizer.AFTER_RESOLVE, needs: arch.ADDRESSED, kinds: ?KINDS[0], kind_count: 7, make: make};

pub fun make(c: *Context, out: *Object) res[bool, Fail] {
    val count: usize = table.count[Storage](?c.resolved.commons);
    if (count == 0) { ret res[bool, Fail].ok{false}; }
    val section_name: res[Id[Name], Fail] = object.name_str(out, ".bss");
    if (sel section_name.err) { ret res[bool, Fail].err{section_name.err}; }
    var i: usize = 0;
    for (i < count) {
        val s: Storage   = table.items[Storage](?c.resolved.commons)[i];
        val e: err[Fail] = emit(c, out, section_name.ok, s);
        if (sel e.err) { ret res[bool, Fail].err{e.err}; }
        i = i + 1;
    }
    ret res[bool, Fail].ok{true};
}

fun emit(c: *Context, out: *Object, section_name: Id[Name], s: Storage) err[Fail] {
    val sec: res[Id[Section], Fail] = object.add_section(out, Section{
        name:        opt[Id[Name]].some{section_name},
        kind:        ?section.BSS,
        flags:       section.BSS.flags,
        align:       s.align,
        contents:    object.Contents.zero{s.size},
        disposition: ?section.WHOLE,
    });
    if (sel sec.err) { ret err[Fail].err{sec.err}; }
    val text: View                = intern.bytes_of(c.names, s.name);
    val own:  res[Id[Name], Fail] = object.name(out, text.data, text.len);
    if (sel own.err) { ret err[Fail].err{own.err}; }
    val bound: *Binding              = table.at[Binding](?c.resolved.bindings, s.binding);
    val sym:   res[Id[Symbol], Fail] = object.add_symbol(out, Symbol{
        name:       own.ok,
        binding:    ?symbol.GLOBAL,
        visibility: bound.visibility,
        kind:       ?symbol.DATA,
        def:        Definition.placed{Place{section: sec.ok, offset: 0}},
        size:       object.sized(s.size),
    });
    if (sel sym.err) { ret err[Fail].err{sym.err}; }
    ret err[Fail].ok{};
}

#[testing]
fun zeroed(s: *Section) u64 {
    if (sel s.contents.zero) { ret s.contents.zero; }
    ret 0;
}

val FAR: [9]u8 = [9]u8{'S', 'Y', 'M', '!', 'C', 'f', 'a', 'r', ';'};
val BUF: [9]u8 = [9]u8{'S', 'Y', 'M', '!', 'D', 'b', 'u', 'f', ';'};

# the storage common storage makes is the names' only definition after the
# stage, and the format decides whether a data definition in an archive
# replaces a common one
test common__is_allocated_after_resolve_from_the_merged_commons {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:     *A.Allocator = T.allocator_of(?t);
    var main:  Object       = object.make(a, ?x86.X86_64);
    var other: Object       = object.make(a, ?x86.X86_64);

    # buf and keep are common in main, far is referred to there and defined
    # common only by an archive member, and other asks for more alignment of
    # keep. the archive also holds a data definition of buf
    val bodies: [2]Bytes = [2]Bytes{Bytes{data: ?FAR[0], len: 9}, Bytes{data: ?BUF[0], len: 9}};
    val names:  [2]str   = [2]str{"far.o", "buf.o"};
    var lib:    Sink;
    if (resolve.bad(resolve.built_archive(a, ?bodies[0], ?names[0], 2, ?lib)))                                     { ret 1; }
    if (resolve.bad(resolve.named(?main, "buf", ?symbol.GLOBAL, Definition.common{Common{size: 4, align: 4}})))    { ret 1; }
    if (resolve.bad(resolve.named(?main, "keep", ?symbol.WEAKLY, Definition.common{Common{size: 8, align: 8}})))   { ret 1; }
    if (resolve.bad(resolve.named(?main, "far", ?symbol.GLOBAL, Definition.undefined{})))                          { ret 1; }
    if (resolve.bad(resolve.named(?other, "keep", ?symbol.GLOBAL, Definition.common{Common{size: 4, align: 32}}))) { ret 1; }

    # without the capability buf, keep and far get storage, with it a data
    # definition replaces buf's common and only keep and far do
    val caps:     [2]resolve.Caps = [2]resolve.Caps{0, resolve.COMMON_PULL};
    val expected: [2]usize        = [2]usize{3, 2};
    var i:        usize           = 0;
    for (i < 2) {
        var sources: [3]Source = [3]Source{
            resolve.given("main", ?main),
            resolve.given("other", ?other),
            Source.bytes{contract.Input{file: "lib.a", data: sink.data(?lib), len: sink.len(?lib)}},
        };
        var r: resolve.Run;
        if (resolve.bad(resolve.linked(?t, ?sources[0], 3, caps[i], ?r)) || resolve.bad(r.got)) { ret 1; }
        if (table.count[Storage](?r.out.commons) != expected[i])                                { ret 1; }
        val bindings: usize = table.count[Binding](?r.out.bindings);

        var tg:   Target              = target.of(?x86.X86_64);
        var c:    Context             = Context{inputs: ?r.inputs, names: ?r.names, resolved: ?r.out, kind: ?output.STATIC, target: ?tg};
        val rows: [1]*Row             = [1]*Row{?ROW};
        val got:  res[Appended, Fail] = synthesizer.apply(?c, ?rows[0], 1, ?synthesizer.AFTER_RESOLVE);
        if (sel got.err) { ret 1; }
        val ap: Appended = got.ok;
        if (ap.count != 1) { ret 1; }
        val made_by: *Object = input.object_of(?r.inputs, table.nth[Input](ap.first));
        if (table.count[Section](?made_by.sections) != expected[i] || table.count[Symbol](?made_by.symbols) != expected[i]) { ret 1; }
        val keep: *Section = table.at[Section](?made_by.sections, table.nth[Section](expected[i] - 2));
        val far:  *Section = table.at[Section](?made_by.sections, table.nth[Section](expected[i] - 1));
        if (keep.kind != ?section.BSS || keep.align != 32 || far.align != 8) { ret 1; }
        if (zeroed(keep) != 8 || zeroed(far) != 16)                          { ret 1; }

        # the new input is resolved alone, and takes its names over the commons
        var in: resolve.In = resolve.In{inputs: ?r.inputs, names: ?r.names, arch: ?x86.X86_64, kind: ?output.STATIC, search: caps[i], hooks: ?resolve.PLAIN};
        if (resolve.bad(resolve.extend(?in, ?r.out, ap.first)))                                        { ret 1; }
        if (table.count[Storage](?r.out.commons) != 0)                                                 { ret 1; }
        if (table.count[Binding](?r.out.bindings) != bindings)                                         { ret 1; }
        if (resolve.winner(?r, "far") != ap.first::i64 || resolve.winner(?r, "keep") != ap.first::i64) { ret 1; }
        var buf_input: i64 = ap.first::i64;
        if (i == 1)                                 { buf_input = 3; }
        if (resolve.winner(?r, "buf") != buf_input) { ret 1; }
        if (resolve.dropped(?r))                    { ret 1; }
        i = i + 1;
    }

    if (resolve.bad(sink.release(?lib)) || resolve.bad(object.release(?main)) || resolve.bad(object.release(?other))) { ret 1; }
    if (T.live_count(?t) != 0)                                                                                        { ret 1; }
    T.dnit(?t);
    ret 0;
}
