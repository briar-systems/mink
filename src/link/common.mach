# common storage, the synthesizer that gives common symbols their bytes
#
# resolution merges the commons of a name: the largest size and alignment any
# of them asks for, a strong definition winning over them and a weak one not,
# as the System V ABI states under symbol binding: "the link editor honors the
# common definition and ignores the weak ones". the names still bound to a
# common definition when resolution ends, those of archive members it pulled
# in included, are read from its output, so no input is read again and no
# format is known here. each gets one zero-fill section holding one symbol, as
# large as the merged size and aligned to the merged alignment, at the stage
# after resolve. the symbol is a strong definition whatever its commons were,
# which is what makes it take the name over them when the input it joins is
# resolved, so a name gets its storage exactly once.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_len;
use std.types.view.View;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.catalog.arch;
use mink.catalog.kind;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.link.resolve.Binding;
use mink.link.resolve.Storage;
use mink.link.synthesizer;
use mink.link.synthesizer.Context;
use mink.link.synthesizer.Row;
use mink.model.object;
use mink.model.object.Definition;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.section;
use mink.model.symbol;

use std.collections.vector;

# every kind but a relocatable object, which keeps its commons for the link
# that takes it
val KINDS: [5]*Kind = [5]*Kind{?output.STATIC, ?output.DYNAMIC, ?output.PIE, ?output.SHARED, ?output.MODULE};

pub val ROW: Row = Row{name: "common storage", stage: ?synthesizer.AFTER_RESOLVE, needs: arch.ADDRESSED, kinds: ?KINDS[0], kind_count: 5, make: make};

# add to `out` one zero-fill section and one strong data symbol for each
# common the resolution left bound
# ---
# c:   the synthesizer context, whose resolution holds the commons and whose
#      commons names the section the format lays them out in
# out: the empty object the storage is added to
# ret: true when any storage was made, false when there were no commons, or
#      the failure of naming or adding a section or symbol, internal when the
#      format names no section for common blocks
pub fun make(c: *Context, out: *Object) res[bool, Fail] {
    val count: usize = vector.length[Storage](?c.resolved.commons);
    if (count == 0)              { ret res[bool, Fail].ok{false}; }
    if (str_len(c.commons) == 0) { ret res[bool, Fail].err{fail.internal("the format lays out no common blocks")}; }
    val res_section_name: res[Id[Name], Fail] = object.name_str(out, c.commons);
    if (sel res_section_name.err) { ret res[bool, Fail].err{res_section_name.err}; }
    var i: usize = 0;
    for (i < count) {
        val s:        Storage   = c.resolved.commons.data[i];
        val err_emit: err[Fail] = emit(c, out, res_section_name.ok, s);
        if (sel err_emit.err) { ret res[bool, Fail].err{err_emit.err}; }
        i = i + 1;
    }
    ret res[bool, Fail].ok{true};
}

fun emit(c: *Context, out: *Object, section_name: Id[Name], s: Storage) err[Fail] {
    val res_sec: res[Id[Section], Fail] = object.add_section(out, Section{
        name:        opt[Id[Name]].some{section_name},
        kind:        ?section.BSS,
        flags:       section.BSS.flags,
        align:       s.align,
        contents:    object.Contents.zero{s.size},
        disposition: ?section.WHOLE,
    });
    if (sel res_sec.err) { ret err[Fail].err{res_sec.err}; }
    val text:    View                = intern.bytes_of(c.names, s.name);
    val res_own: res[Id[Name], Fail] = object.name(out, text.data, text.len);
    if (sel res_own.err) { ret err[Fail].err{res_own.err}; }
    val bound:   *Binding              = table.at[Binding](?c.resolved.bindings, s.binding);
    val res_sym: res[Id[Symbol], Fail] = object.add_symbol(out, Symbol{
        name:       res_own.ok,
        binding:    ?symbol.GLOBAL,
        visibility: bound.visibility,
        kind:       ?symbol.DATA,
        def:        Definition.placed{Place{section: res_sec.ok, offset: 0}},
        size:       object.sized(s.size),
    });
    if (sel res_sym.err) { ret err[Fail].err{res_sym.err}; }
    ret err[Fail].ok{};
}
