# the link's table of formats: the linking row of every format the link
# builds images of, keyed by format
#
# a format's row lives with its link rules, and the registry's generator
# checks every entry against the registrations: a format listed once and
# registered, a format it links as listed and linking by its own row, and
# every code template patched through its pair's relocation rows. nothing
# is checked when mink runs. a format that links as another states only its
# image writer and what its images export, its images built by that format's
# link from that format's objects.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.catalog.arch.Arch;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.format.ar.write.Variant;
use mink.format.pair.Pair;
use mink.format.registration;
use mink.format.registration.Registration;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.link.coff;
use mink.link.elf;
use mink.link.flat;
use mink.link.linking.Linking;
use mink.link.macho;
use mink.link.spirv;
use mink.link.wasm;

# format:   the format
# linking:  how the link builds its images
# links_as: the format whose link builds its images from that format's
#           objects, none for a format whose own row links them
pub rec Entry {
    format:   *Format;
    linking:  *Linking;
    links_as: opt[*Format];
}

val ENTRY_COUNT: usize              = 6;
val ENTRIES:     [ENTRY_COUNT]Entry = [ENTRY_COUNT]Entry{
    Entry{format: ?format.COFF, linking: ?coff.LINKING, links_as: opt[*Format].none{}},
    Entry{format: ?format.ELF, linking: ?elf.LINKING, links_as: opt[*Format].none{}},
    Entry{format: ?format.FLAT, linking: ?flat.LINKING, links_as: opt[*Format].some{?format.ELF}},
    Entry{format: ?format.MACHO, linking: ?macho.LINKING, links_as: opt[*Format].none{}},
    Entry{format: ?format.SPIRV, linking: ?spirv.LINKING, links_as: opt[*Format].none{}},
    Entry{format: ?format.WASM, linking: ?wasm.LINKING, links_as: opt[*Format].none{}},
};

pub fun count() usize {
    ret ENTRY_COUNT;
}

pub fun at(index: usize) *Entry {
    ret ?ENTRIES[index];
}

# the entry of `f`, refused for a format the link builds no image of
pub fun of(f: *Format) res[*Entry, Fail] {
    var i: usize = 0;
    for (i < ENTRY_COUNT) {
        if (ENTRIES[i].format == f) { ret res[*Entry, Fail].ok{?ENTRIES[i]}; }
        i = i + 1;
    }
    ret res[*Entry, Fail].err{fail.in_record(fail.unsupported("the format has no linking rules"), f.name)};
}

# the entry whose link builds the images of `f`: the one it links as, else
# its own
pub fun builder(f: *Format) res[*Entry, Fail] {
    val e: res[*Entry, Fail] = of(f);
    if (sel e.err) { ret e; }
    val via: opt[*Format] = e.ok.links_as;
    if (sel via.none) { ret e; }
    ret of(via.some);
}

# the registration of the format whose link builds the images of `f`
fun builder_registration(g: *Registry, f: *Format) res[*Registration, Fail] {
    val e: res[*Entry, Fail] = builder(f);
    if (sel e.err) { ret res[*Registration, Fail].err{e.err}; }
    ret registry.by_format(g, e.ok.format);
}

# the variant a static library of `f`'s objects is written in, the variant
# of the format it links as for one that links as another, refused for a
# format whose objects mink archives in no variant
pub fun archive(g: *Registry, f: *Format) res[*Variant, Fail] {
    val owner: res[*Registration, Fail] = builder_registration(g, f);
    if (sel owner.err) { ret res[*Variant, Fail].err{owner.err}; }
    val v: opt[*Variant] = owner.ok.archive;
    if (sel v.none) { ret res[*Variant, Fail].err{fail.in_record(fail.unsupported("the format's objects are archived in no variant"), f.name)}; }
    ret res[*Variant, Fail].ok{v.some};
}

# the prefix a C symbol's name carries in an object for the architecture `a`
# that the link of the format `f` takes, empty for none: the pair's of the
# format whose link builds `f`'s images. refused when the format has no
# linking rules or states nothing for the architecture
pub fun c_prefix(g: *Registry, f: *Format, a: *Arch) res[str, Fail] {
    val r: res[*Registration, Fail] = builder_registration(g, f);
    if (sel r.err) { ret res[str, Fail].err{fail.about(r.err, a.name)}; }
    val p: res[*Pair, Fail] = registration.pair_of(r.ok, a);
    if (sel p.err) { ret res[str, Fail].err{p.err}; }
    ret res[str, Fail].ok{p.ok.prefix};
}
