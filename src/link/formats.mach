# the link's table of formats: how the link builds the images of every
# format it links, keyed by format
#
# each row names the format's link rules, which live under mink.link.<fmt>,
# and the registry's generator checks every entry against the
# registrations: a format listed once and registered, a format it links as
# listed and linking by its own row, and every code template patched
# through its pair's relocation rows. nothing is checked when mink runs. a
# format that links as another states only its image writer and what its
# images export, its images built by that format's link from that format's
# objects.

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.rule;
use mink.base.rule.Axis;
use mink.catalog.arch.Arch;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.output;
use mink.format.ar.write.Variant;
use mink.format.layout.Rules;
use mink.format.macho.neutral.naming;
use mink.format.pair.Pair;
use mink.format.registration;
use mink.format.registration.Registration;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.format.spirv.rules;
use mink.link.assign;
use mink.link.boundary;
use coff_convention: mink.link.coff.convention;
use coff_image:      mink.link.coff.image;
use mink.link.collect.Leaving;
use mink.link.collect.Superseding;
use mink.link.common;
use mink.link.consume;
use mink.link.dynamic;
use elf_convention: mink.link.elf.convention;
use elf_dynamic:    mink.link.elf.dynamic;
use elf_image:      mink.link.elf.image;
use elf_templates:  mink.link.elf.templates;
use mink.link.flat;
use mink.link.fold;
use mink.link.image.Writer;
use mink.link.layout.Participant;
use mink.link.layout.Participants;
use mink.link.linking;
use mink.link.linking.Linking;
use mink.link.linking.Measures;
use mink.link.linking.Synthesizers;
use macho_convention: mink.link.macho.convention;
use macho_image:      mink.link.macho.image;
use mink.link.macho.made;
use macho_templates: mink.link.macho.templates;
use mink.link.macho.unwind;
use mink.link.needs;
use mink.link.relax;
use mink.link.reserve;
use mink.link.reserve.Declarer;
use mink.link.reserve.Declarers;
use mink.link.resolve;
use mink.link.resolve.Weak;
use mink.link.spirv;
use mink.link.synthesizer;
use mink.link.thunk;
use mink.link.wasm;
use wasm_image: mink.link.wasm.image;
use wasm_made:  mink.link.wasm.made;
use mink.link.wasm.types;
use mink.model.directive;
use mink.model.section;

# format:   the format
# linking:  how the link builds its images
# links_as: the format whose link builds its images from that format's
#           objects, none for a format whose own row links them
pub rec Entry {
    format:   *Format;
    linking:  *Linking;
    links_as: opt[*Format];
}

# the one directive kind every link takes: an export directive, which
# resolution reads as the default visibility of the name it is about where
# the format exports by visibility, and the image writer exports by its name
# where the format exports by directive
val DIRECTIVES: [1]*directive.Kind = [1]*directive.Kind{?directive.EXPORT};

# the inputs a link makes common storage and needed-library entries with
val SYNTHESIZER_COUNT: usize                               = 2;
val SYNTHESIZERS:      [SYNTHESIZER_COUNT]*synthesizer.Row = [SYNTHESIZER_COUNT]*synthesizer.Row{?common.ROW, ?needs.ROW};

# relaxation rewrites the relocations whose rows state forms, as a RISC-V
# ALIGN deletes the padding its alignment does not need and an arm64 GOT or
# TLV page reference takes the page of the address its add form takes, and
# thunks send a branch past its reach through a veneer in an island
val RELAXED_COUNT: usize                       = 2;
val RELAXED:       [RELAXED_COUNT]*Participant = [RELAXED_COUNT]*Participant{?relax.RELAX, ?thunk.THUNKS};

# the sections that are not image content an ELF link takes
val ELF_USE_COUNT: usize                       = 3;
val ELF_USES:      [ELF_USE_COUNT]*consume.Row = [ELF_USE_COUNT]*consume.Row{?consume.SIGNIFICANCE, ?consume.STRINGS, ?consume.STACK};

val ELF_DECLARER_COUNT: usize                         = 4;
val ELF_DECLARERS:      [ELF_DECLARER_COUNT]*Declarer = [ELF_DECLARER_COUNT]*Declarer{?reserve.HEADER_TABLE, ?elf_image.TABLES, ?elf_dynamic.TABLES, ?elf_convention.SLOTS};

# an archive is searched once where it stands, and a common definition pulls a
# member that defines its name as data, since a tentative definition and the
# member's definition are one object. an undefined weak reference resolves to
# zero, as the gABI states. merged strings share the tails of longer ones.
# sections nothing reaches are kept unless --gc-sections is given. only a
# shared library exports the definitions its visibility shows, as an
# executable's dynamic symbol table holds only what a library refers to. an
# image needs every shared library named
val ELF: Linking = Linking{
    caps:         linking.SHARED_CIES | linking.UNBROKEN_FRAMES,
    search:       resolve.COMMON_PULL,
    hooks:        ?resolve.PLAIN,
    weak:         Weak.zero{},
    folds:        fold.NONE,
    layout:       opt[*Rules].some{?elf_convention.LAYOUT},
    tails:        true,
    collects:     false,
    exports:      Axis{need: output.EXPORTS, deny: 0},
    dynamic:      ?elf_convention.DYNAMIC,
    loads_all:    true,
    facts:        ?elf_convention.FACTS,
    writer:       opt[*Writer].some{?elf_image.WRITER},
    declarers:    Declarers{rows: ?ELF_DECLARERS[0], count: ELF_DECLARER_COUNT},
    measures:     elf_image.MEASURES,
    uses:         consume.Uses{rows: ?ELF_USES[0], count: ELF_USE_COUNT, directives: ?DIRECTIVES[0], directive_count: 1},
    synthesizers: Synthesizers{rows: ?SYNTHESIZERS[0], count: SYNTHESIZER_COUNT},
    participants: Participants{rows: ?RELAXED[0], count: RELAXED_COUNT},
    bounds:       elf_dynamic.BOUNDS,
    calls:        elf_dynamic.CALLS,
    templates:    elf_templates.SETS,
};

# the sections that are not image content a COFF link takes, the resource
# trees among them, which the image writer merges with the inputs' resources
val COFF_USE_COUNT: usize                        = 4;
val COFF_USES:      [COFF_USE_COUNT]*consume.Row = [COFF_USE_COUNT]*consume.Row{?consume.SIGNIFICANCE, ?consume.STRINGS, ?consume.STACK, ?consume.RESOURCE_TREES};

val COFF_DECLARER_COUNT: usize                          = 3;
val COFF_DECLARERS:      [COFF_DECLARER_COUNT]*Declarer = [COFF_DECLARER_COUNT]*Declarer{?reserve.HEADER_TABLE, ?coff_image.TABLES, ?coff_convention.SLOTS};

val COFF_SYNTHESIZER_COUNT: usize                                    = 3;
val COFF_SYNTHESIZERS:      [COFF_SYNTHESIZER_COUNT]*synthesizer.Row = [COFF_SYNTHESIZER_COUNT]*synthesizer.Row{?common.ROW, ?coff_image.CALLBACK_BOUNDS, ?needs.ROW};

# thunks send a branch past its reach through a veneer in an island
val COFF_PARTICIPANTS: [1]*Participant = [1]*Participant{?thunk.THUNKS};

# the PLAIN hooks, and the link asking the archives for the load configuration
val COFF_HOOKS: resolve.Hooks = resolve.Hooks{name: resolve.plain_name, library: resolve.shared, imported: resolve.no_record, asked: coff_image.asked};

# every archive is searched again while a name is left undefined. whether a
# common definition pulls a member that defines its name as data is not
# verified, so the row leaves it off. an undefined weak reference takes its
# fallback. COFF inputs hold no merged strings, so no tails are shared.
# sections nothing reaches are left out. an image imports only from the DLLs a
# reference binds to. the link defines _tls_index where no input does, in the
# index cell of an image that supplies its own TLS directory. every image
# exports what its inputs' export directives name, an executable as a DLL
# does, as PE/COFF 6.3 lets any image carry an export table and COFF symbols
# carry no visibility that exports them. an image leaves the CodeView
# sections out
val COFF: Linking = Linking{
    caps:         linking.DIRECTED_EXPORTS,
    search:       resolve.REVISIT,
    hooks:        ?COFF_HOOKS,
    weak:         Weak.fallback{},
    folds:        fold.NONE,
    layout:       opt[*Rules].some{?coff_convention.LAYOUT},
    tails:        false,
    collects:     true,
    exports:      Axis{need: 0, deny: output.KEEPS},
    dynamic:      ?coff_convention.DYNAMIC,
    loads_all:    false,
    facts:        ?coff_convention.FACTS,
    writer:       opt[*Writer].some{?coff_image.WRITER},
    declarers:    Declarers{rows: ?COFF_DECLARERS[0], count: COFF_DECLARER_COUNT},
    measures:     coff_image.MEASURES,
    uses:         consume.Uses{rows: ?COFF_USES[0], count: COFF_USE_COUNT, directives: ?DIRECTIVES[0], directive_count: 1, resources: true, export_attributes: true},
    synthesizers: Synthesizers{rows: ?COFF_SYNTHESIZERS[0], count: COFF_SYNTHESIZER_COUNT},
    participants: Participants{rows: ?COFF_PARTICIPANTS[0], count: 1},
    bounds:       coff_image.BOUNDS,
    calls:        coff_image.CALLS,
    leaving:      opt[*Leaving].some{?coff_convention.LEAVING},
    templates:    coff_convention.TEMPLATES,
};

# the sections that are not image content a Mach-O link takes
val MACHO_USE_COUNT: usize                         = 4;
val MACHO_USES:      [MACHO_USE_COUNT]*consume.Row = [MACHO_USE_COUNT]*consume.Row{?consume.SIGNIFICANCE, ?consume.STRINGS, ?consume.STACK, ?consume.UNWIND_RECORDS};

val MACHO_DECLARER_COUNT: usize                           = 5;
val MACHO_DECLARERS:      [MACHO_DECLARER_COUNT]*Declarer = [MACHO_DECLARER_COUNT]*Declarer{?reserve.HEADER_TABLE, ?macho_image.SIGNATURE_TABLE, ?unwind.TABLE, ?macho_convention.SLOTS, ?macho_image.ACCESSOR_WORDS};

# every archive is searched again while a name is left undefined. whether a
# common definition pulls a member that defines its name as data is not
# verified, so the row leaves it off. an undefined weak reference resolves to
# zero. each distinct C string is kept whole and shares no tails. sections
# nothing reaches are kept unless -dead_strip is given. only a dylib's
# exports are roots, as an executable's trie carries the visible definitions
# the link keeps. an image loads every dylib linked. a function's FDE is left
# out when its compact unwind entry does not defer to DWARF, as the unwinder
# then never reads it
val MACHO: Linking = Linking{
    caps:         0,
    search:       resolve.REVISIT,
    hooks:        ?resolve.PLAIN,
    weak:         Weak.zero{},
    folds:        fold.NONE,
    layout:       opt[*Rules].some{?naming.LAYOUT},
    tails:        false,
    collects:     false,
    exports:      Axis{need: output.EXPORTS, deny: 0},
    dynamic:      ?macho_convention.DYNAMIC,
    maker:        opt[*dynamic.Maker].some{?made.MAKER},
    loads_all:    true,
    runtime:      macho_convention.RUNTIME,
    facts:        ?macho_convention.FACTS,
    writer:       opt[*Writer].some{?macho_image.WRITER},
    bounds:       macho_image.BOUNDS,
    declarers:    Declarers{rows: ?MACHO_DECLARERS[0], count: MACHO_DECLARER_COUNT},
    measures:     macho_image.MEASURES,
    uses:         consume.Uses{rows: ?MACHO_USES[0], count: MACHO_USE_COUNT, directives: ?DIRECTIVES[0], directive_count: 1},
    synthesizers: Synthesizers{rows: ?SYNTHESIZERS[0], count: SYNTHESIZER_COUNT},
    participants: Participants{rows: ?RELAXED[0], count: RELAXED_COUNT},
    superseding:  opt[*Superseding].some{?unwind.SUPERSEDING},
    leaving:      opt[*Leaving].none{},
    templates:    macho_templates.SETS,
};

# types, constants and globals that are no variable fold as their contents
# and references decide, and so do extended instruction set imports and
# decorations, so a link holds each once
val SPIRV_FOLD_COUNT: usize                       = 2;
val SPIRV_FOLDS:      [SPIRV_FOLD_COUNT]fold.Rule = [SPIRV_FOLD_COUNT]fold.Rule{
    fold.Rule{kind: ?section.RODATA, equal: ?fold.CONTENTS},
    fold.Rule{kind: ?section.METADATA, equal: ?fold.CONTENTS},
};

# a module has no addresses, so a link gives each id its index and lays no
# image out. it searches archives once, binds nothing dynamically and leaves
# an undefined weak reference unruled, as a module has none. it defines no
# symbol at a place of its layout, as it lays none out. it keeps what nothing
# reaches, as spirv-link runs no dead code pass (source/link/linker.cpp of
# SPIRV-Tools), so no export of a module is a root
val SPIRV: Linking = Linking{
    caps:      linking.INDEXED_LAYOUT,
    search:    0,
    hooks:     ?resolve.PLAIN,
    weak:      Weak.unruled{},
    folds:     fold.Rules{rows: ?SPIRV_FOLDS[0], count: SPIRV_FOLD_COUNT},
    layout:    opt[*Rules].none{},
    collects:  false,
    exports:   rule.NEVER,
    dynamic:   ?dynamic.UNBOUND,
    loads_all: false,
    facts:     ?rules.FACTS,
    writer:    opt[*Writer].some{?spirv.WRITER},
    bounds:    boundary.NONE,
};

val WASM_DECLARERS: [1]*Declarer = [1]*Declarer{?wasm.TABLE};

val WASM_SYNTHESIZER_COUNT: usize                                    = 2;
val WASM_SYNTHESIZERS:      [WASM_SYNTHESIZER_COUNT]*synthesizer.Row = [WASM_SYNTHESIZER_COUNT]*synthesizer.Row{?wasm_made.ROW, ?needs.ROW};

# archives are searched until nothing more resolves, and an undefined weak
# reference resolves to zero. what nothing reaches is left out unless
# --no-gc-sections is given, for every output but a relocatable one. a
# module exports what its inputs' export directives name, by the names they
# state, whatever the visibility of the symbols, in every kind of image, as
# the export section is the one way a host reaches a definition
val WASM: Linking = Linking{
    caps:         linking.INDEXED_LAYOUT | linking.WEAK_STUBS | linking.DIRECTED_EXPORTS | linking.BUILT_BY_ENTRY,
    sharing:      opt[*assign.Sharing].some{?types.SHARING},
    search:       resolve.REVISIT,
    hooks:        ?resolve.PLAIN,
    weak:         Weak.zero{},
    folds:        fold.NONE,
    layout:       opt[*Rules].some{?wasm.LAYOUT},
    collects:     true,
    exports:      Axis{need: 0, deny: output.KEEPS},
    dynamic:      ?wasm.DYNAMIC,
    loads_all:    false,
    facts:        ?wasm.FACTS,
    writer:       opt[*Writer].some{?wasm_image.WRITER},
    declarers:    Declarers{rows: ?WASM_DECLARERS[0], count: 1},
    measures:     Measures{rows: nil, count: 0},
    uses:         consume.Uses{rows: nil, count: 0, directives: ?DIRECTIVES[0], directive_count: 1},
    synthesizers: Synthesizers{rows: ?WASM_SYNTHESIZERS[0], count: WASM_SYNTHESIZER_COUNT},
    participants: Participants{rows: nil, count: 0},
    bounds:       wasm.BOUNDS,
};

# a flat image links as ELF, naming only its image writer and that it
# exports nothing, as a flat image holds no symbols
val FLAT: Linking = Linking{exports: rule.NEVER, writer: opt[*Writer].some{?flat.WRITER}};

val ENTRY_COUNT: usize              = 6;
val ENTRIES:     [ENTRY_COUNT]Entry = [ENTRY_COUNT]Entry{
    Entry{format: ?format.COFF, linking: ?COFF, links_as: opt[*Format].none{}},
    Entry{format: ?format.ELF, linking: ?ELF, links_as: opt[*Format].none{}},
    Entry{format: ?format.FLAT, linking: ?FLAT, links_as: opt[*Format].some{?format.ELF}},
    Entry{format: ?format.MACHO, linking: ?MACHO, links_as: opt[*Format].none{}},
    Entry{format: ?format.SPIRV, linking: ?SPIRV, links_as: opt[*Format].none{}},
    Entry{format: ?format.WASM, linking: ?WASM, links_as: opt[*Format].none{}},
};

pub fun count() usize {
    ret ENTRY_COUNT;
}

pub fun at(index: usize) *Entry {
    ret ?ENTRIES[index];
}

# the entry of `f`, refused for a format the link builds no image of
pub fun of(f: *Format) res[*Entry, Fail] {
    var i: usize = 0;
    for (i < ENTRY_COUNT) {
        if (ENTRIES[i].format == f) { ret res[*Entry, Fail].ok{?ENTRIES[i]}; }
        i = i + 1;
    }
    ret res[*Entry, Fail].err{fail.in_record(fail.unsupported("the format has no linking rules"), f.name)};
}

# the entry whose link builds the images of `f`: the one it links as, else
# its own
pub fun builder(f: *Format) res[*Entry, Fail] {
    val e: res[*Entry, Fail] = of(f);
    if (sel e.err) { ret e; }
    val via: opt[*Format] = e.ok.links_as;
    if (sel via.none) { ret e; }
    ret of(via.some);
}

# the registration of the format whose link builds the images of `f`
fun builder_registration(g: *Registry, f: *Format) res[*Registration, Fail] {
    val e: res[*Entry, Fail] = builder(f);
    if (sel e.err) { ret res[*Registration, Fail].err{e.err}; }
    ret registry.by_format(g, e.ok.format);
}

# the variant a static library of `f`'s objects is written in, the variant
# of the format it links as for one that links as another, refused for a
# format whose objects mink archives in no variant
pub fun archive(g: *Registry, f: *Format) res[*Variant, Fail] {
    val owner: res[*Registration, Fail] = builder_registration(g, f);
    if (sel owner.err) { ret res[*Variant, Fail].err{owner.err}; }
    val v: opt[*Variant] = owner.ok.archive;
    if (sel v.none) { ret res[*Variant, Fail].err{fail.in_record(fail.unsupported("the format's objects are archived in no variant"), f.name)}; }
    ret res[*Variant, Fail].ok{v.some};
}

# the prefix a C symbol's name carries in an object for the architecture `a`
# that the link of the format `f` takes, empty for none: the pair's of the
# format whose link builds `f`'s images. refused when the format has no
# linking rules or states nothing for the architecture
pub fun c_prefix(g: *Registry, f: *Format, a: *Arch) res[str, Fail] {
    val r: res[*Registration, Fail] = builder_registration(g, f);
    if (sel r.err) { ret res[str, Fail].err{fail.about(r.err, a.name)}; }
    val p: res[*Pair, Fail] = registration.pair_of(r.ok, a);
    if (sel p.err) { ret res[str, Fail].err{p.err}; }
    ret res[str, Fail].ok{p.ok.prefix};
}
