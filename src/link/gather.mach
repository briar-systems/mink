# the gather phase: the caller's sources become the link's inputs
#
# a given neutral object first takes the read form of the output format's
# conversion, as a copy the set owns, when the conversion normalizes it, so
# the link cuts and roots it the one way it does a file of the format. it
# then enters with the records it states, such as line sequences, lowered in
# place into sections and relocations in the output format's encoding, the
# step the format's from_neutral takes, so the link takes them the one way it
# takes a file's. an object in read form with no records enters as it is.
# bytes are sniffed through the format
# registry, read into their format's model and converted to a neutral object,
# and the set keeps both. a container is kept whole for resolve to load its
# members, except one whose members are chosen by architecture, which gives
# the member for the link's architecture in its place. a file the set read
# before, however it was named, appends nothing again. what this phase appends
# is owned by the set the moment it is made, so a failure part way leaves
# nothing unowned.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Stated;
use mink.catalog.arch.list;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.format.contract;
use mink.format.contract.Member;
use mink.format.contract.Model;
use mink.format.contract.Neutral;
use mink.format.pair.Mapping;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.link.crew;
use mink.link.crew.Crew;
use mink.link.input;
use mink.link.input.Inputs;
use mink.link.input.Source;
use mink.lower.Lowering;
use mink.lower.encode;
use mink.model.object;
use mink.model.object.Object;
use mink.model.target.Target;
use mink.reloc.row;

# reading: how each source is read
# sources: what the caller hands over, in order
# count:   how many
# crew:    the threads the sources are read on
pub rec In {
    reading: Reading;
    sources: *Source;
    count:   usize;
    crew:    *Crew;
}

# how the link reads an input
# ---
# registry: the formats the input is read and converted through
# target:   the target the input is read for
# format:   the output format, whose encodings records are lowered in
# lowering: its encodings
# mapping:  its mapping symbols for the target's architecture
# neutral:  the output format's conversion, whose normalize gives a given
#           object its read form, none where it has none
pub rec Reading {
    registry: *Registry;
    target:   Target;
    format:   *Format;
    lowering: opt[*Lowering];
    mapping:  opt[*Mapping];
    neutral:  opt[*Neutral];
}

# what reading one source made, before the set takes any of it
# ---
# err:       how reading it ended
# model:     the model its bytes were read into, which the set keeps even
#            when reading failed past it, as the failure may name what the
#            model holds
# object:    the object the set owns from now on: a given object's copy in
#            read form or with its records lowered, or one converted from
#            bytes, its records lowered
# container: the model is a container, which the set keeps whole or loads
#            the member of
# lowered:   the object's records were lowered, so a refusal of taking it
#            names the file it was read from
rec Read {
    err:       err[Fail];
    model:     opt[Model];
    object:    opt[Object];
    container: bool;
    lowered:   bool;
}

# the sources being read: how each is read, the set whose allocators the
# reads draw from and what each read made
rec Batch {
    reading: *Reading;
    sources: *Source;
    out:     *Inputs;
    reads:   *Read;
}

# read every source, then append what each gives in order. each source is
# read alone, into objects and models nothing else reads, so the sources are
# read on the crew's lanes at once, and only appending them, which numbers
# the inputs, objects and models and knows a file met before, runs in order
# on the caller's thread. the first source in order whose appending fails is
# the phase's failure, and what the sources after it made is given back
pub fun run(in: *In, out: *Inputs) err[Fail] {
    if (in.count == 0) { ret err[Fail].ok{}; }
    val res_reads: res[*Read, A.Error] = A.allocate[Read](out.a, in.count);
    if (sel res_reads.err) { ret err[Fail].err{fail.refused(res_reads.err)}; }
    # every read holds, so every slot is written before it is read
    var r: Batch = Batch{reading: ?in.reading, sources: in.sources, out: out, reads: res_reads.ok};
    crew.each(in.crew, in.count, (?r)::ptr, read_one);
    var err_out: err[Fail] = err[Fail].ok{};
    var failed:  bool      = false;
    var i:       usize     = 0;
    for (i < in.count) {
        if (failed) { read_dnit(?r.reads[i]); }
        or {
            err_out = enter(?in.reading, ?in.sources[i], ?r.reads[i], out);
            failed  = sel err_out.err;
        }
        i = i + 1;
    }
    val err_freed: err[A.Error] = A.deallocate[Read](out.a, res_reads.ok, in.count);
    if (sel err_out.err)   { ret err_out; }
    if (sel err_freed.err) { ret err[Fail].err{fail.refused(err_freed.err)}; }
    ret err[Fail].ok{};
}

# read the source `index` on any lane. a read that fails holds its failure
# for appending, which may find the file met before and drop it, so every
# source is read
fun read_one(context: ptr, lane: u32, index: usize) bool {
    val r: *Batch = context::*Batch;
    read(r.reading, ?r.sources[index], r.out, ?r.reads[index]);
    ret true;
}

# give back what the read `r` made and the set never took
fun read_dnit(r: *Read) {
    if (sel r.object.some) { val err_dropped: err[Fail] = object.dnit(?r.object.some); }
    if (sel r.model.some)  { val err_dropped: err[Fail] = contract.dnit(?r.model.some); }
    @r = Read{};
}

# append what the source `s` gives to `out`
pub fun source(in: *Reading, s: *Source, out: *Inputs) err[Fail] {
    var r: Read;
    read(in, s, out, ?r);
    ret enter(in, s, ?r, out);
}

# read the source `s` into `r`, its objects and models drawn from the
# allocators of `out`, whose tables reading never touches
fun read(in: *Reading, s: *Source, out: *Inputs, r: *Read) {
    if (sel s.object) { given(in, s.object, out, r); }
    or (sel s.bytes)  { loaded(in, s.bytes, out.a, r); }
    or                { loaded(in, s.included.input, out.a, r); }
}

# `r` read as far as it got: how it ended and the model it read, no object
fun ended(r: *Read, e: err[Fail], model: opt[Model]) {
    r.err       = e;
    r.model     = model;
    r.object    = opt[Object].none{};
    r.container = false;
    r.lowered   = false;
}

# append what the read `r` of the source `s` made to `out`. the read is
# spent whether or not appending succeeds: what it made is the set's or given
# back
fun enter(in: *Reading, s: *Source, r: *Read, out: *Inputs) err[Fail] {
    if (sel s.object) {
        val err_given: err[Fail] = entered_given(s.object, r, out);
        if (sel err_given.err) { ret err[Fail].err{fail.in_file(err_given.err, s.object.name)}; }
        ret err_given;
    }
    or (sel s.bytes) {
        ret entered_load(in, s.bytes, r, out);
    }
    ret included(in, s.included, r, out);
}

# the caller's object `g` read into `r`: borrowed as it is when it is in read
# form and states no records, and otherwise a copy the set will own, in read
# form and its records lowered. the caller's object stays as it was
fun given(in: *Reading, g: input.Given, out: *Inputs, r: *Read) {
    var opt_normalize: opt[contract.Normalize] = opt[contract.Normalize].none{};
    if (sel in.neutral.some) { opt_normalize = in.neutral.some.normalize; }
    if (sel opt_normalize.some) {
        var o:        Object          = object.init(table.allocator[Object](?out.objects), g.object.target.arch, g.object.kind);
        val res_some: res[bool, Fail] = opt_normalize.some(?in.registry.relocs, g.object, ?o);
        if (sel res_some.err) {
            val err_dropped: err[Fail] = object.dnit(?o);
            ret ended(r, err[Fail].err{res_some.err}, opt[Model].none{});
        }
        if (res_some.ok) { ret lowered(in, o, opt[Model].none{}, r); }
        val err_dropped: err[Fail] = object.dnit(?o);
        if (sel err_dropped.err) { ret ended(r, err_dropped, opt[Model].none{}); }
    }
    if (object.has_records(g.object)) {
        val res_copy: res[Object, Fail] = object.copy(table.allocator[Object](?out.objects), g.object);
        if (sel res_copy.err) { ret ended(r, err[Fail].err{res_copy.err}, opt[Model].none{}); }
        ret lowered(in, res_copy.ok, opt[Model].none{}, r);
    }
    ended(r, err[Fail].ok{}, opt[Model].none{});
}

# append what the given object's read `r` made: the object it made, which the
# set owns from now on, or the caller's object `g` borrowed
fun entered_given(g: input.Given, r: *Read, out: *Inputs) err[Fail] {
    if (sel r.err.err) { ret r.err; }
    if (sel r.object.some) {
        val res_out_taken: res[Id[input.Input], Fail] = input.take(out, g.name, r.object.some, opt[Id[Model]].none{});
        if (sel res_out_taken.err) { ret err[Fail].err{res_out_taken.err}; }
        ret err[Fail].ok{};
    }
    val res_borrow: res[Id[input.Input], Fail] = input.borrow(out, g);
    if (sel res_borrow.err) { ret err[Fail].err{res_borrow.err}; }
    ret err[Fail].ok{};
}

# the read `r` of `o`, an object the read owns even when lowering it is
# refused, read from `model`, its records lowered in the output format's
# encodings where it lies in the read
fun lowered(in: *Reading, o: Object, model: opt[Model], r: *Read) {
    ended(r, err[Fail].ok{}, model);
    r.object  = opt[Object].some{o};
    r.lowered = true;
    if (sel r.object.some) {
        val res_rows:             res[*row.Lookup, Fail] = row.find(?in.registry.relocs, in.format, r.object.some.target.arch);
        var err_lowering_applied: err[Fail]              = err[Fail].ok{};
        if (sel res_rows.err) { err_lowering_applied = err[Fail].err{res_rows.err}; }
        if (sel res_rows.ok)  { err_lowering_applied = encode.apply(in.lowering, ?r.object.some, res_rows.ok, in.mapping); }
        if (sel err_lowering_applied.err) {
            val err_dropped: err[Fail] = object.dnit(?r.object.some);
            ended(r, err_lowering_applied, model);
        }
    }
}

# append what the bytes of `src` hold, read as `r`, each input they give
# marked with what `src` states of the library. a file the set read before
# appends nothing
fun included(in: *Reading, src: input.Included, r: *Read, out: *Inputs) err[Fail] {
    if (src.path != nil) {
        val res_again: res[bool, Fail] = input.again(out, src.path, src.include);
        if (sel res_again.err) {
            read_dnit(r);
            ret err[Fail].err{fail.in_file(res_again.err, src.input.file)};
        }
        if (res_again.ok) {
            read_dnit(r);
            ret err[Fail].ok{};
        }
    }
    val first:    usize     = input.count(out);
    val err_load: err[Fail] = entered_load(in, src.input, r, out);
    if (sel err_load.err) { ret err_load; }
    var i: usize = first;
    for (i < input.count(out)) {
        val e: *input.Input = input.at(out, table.nth[input.Input](i));
        e.searched = src.searched;
        e.include  = src.include;
        e.path     = src.path;
        i          = i + 1;
    }
    if (src.path == nil) { ret err[Fail].ok{}; }
    ret input.entered(out, src.path, input.Appended{first: first, count: input.count(out) - first});
}

# append what the bytes `src` hold to `out`, read through the registry, an
# object converted for the target and a container kept whole. the object states the link's target only until its
# conversion, which holds the file against it and states the file's own
pub fun load(in: *Reading, src: contract.Input, out: *Inputs) err[Fail] {
    var r: Read;
    loaded(in, src, out.a, ?r);
    ret entered_load(in, src, ?r, out);
}

# the bytes `src` read into `r`: their model, drawn from `a`, and when they
# hold an object, it converted for the target and its records lowered
fun loaded(in: *Reading, src: contract.Input, a: *A.Allocator, r: *Read) {
    var bytes:    contract.Input   = src;
    val res_read: res[Model, Fail] = registry.read(in.registry, a, ?bytes);
    if (sel res_read.err) { ret ended(r, err[Fail].err{res_read.err}, opt[Model].none{}); }
    ended(r, err[Fail].ok{}, opt[Model].some{res_read.ok});
    if (sel r.model.none) { ret; }
    val res_held: res[bool, Fail] = contract.is_container(?r.model.some);
    if (sel res_held.err) {
        r.err = err[Fail].err{fail.in_file(res_held.err, bytes.file)};
        ret;
    }
    if (res_held.ok) {
        r.container = true;
        ret;
    }
    val err_same: err[Fail] = object_format(in, bytes.file, ?r.model.some);
    if (sel err_same.err) {
        r.err = err_same;
        ret;
    }
    var o: Object = object.init(a, in.target.arch, nil);
    o.target = in.target;
    val err_conv: err[Fail] = registry.to_neutral(in.registry, ?r.model.some, ?o);
    if (sel err_conv.err) {
        val err_dropped: err[Fail] = object.dnit(?o);
        r.err = err[Fail].err{fail.in_file(err_conv.err, bytes.file)};
        ret;
    }
    if (!object.has_records(?o)) {
        r.object = opt[Object].some{o};
        ret;
    }
    lowered(in, o, r.model, r);
    val err_low: err[Fail] = r.err;
    if (sel err_low.err) { r.err = err[Fail].err{fail.in_file(err_low.err, bytes.file)}; }
}

# append what the read `r` of the bytes `src` made: its model kept, then the
# container it is or the object it converted to, the read spent whether or
# not appending succeeds
fun entered_load(in: *Reading, src: contract.Input, r: *Read, out: *Inputs) err[Fail] {
    if (sel r.model.none) { ret r.err; }
    val res_keep: res[Id[Model], Fail] = input.keep(out, r.model.some);
    if (sel res_keep.err) {
        if (sel r.object.some) { val err_dropped: err[Fail] = object.dnit(?r.object.some); }
        ret err[Fail].err{res_keep.err};
    }
    if (sel r.err.err)     { ret r.err; }
    if (r.container)       { ret container(in, src.file, res_keep.ok, out); }
    if (sel r.object.none) { ret err[Fail].err{fail.internal("an object read from bytes was not converted")}; }
    val res_out_taken: res[Id[input.Input], Fail] = input.take(out, src.file, r.object.some, opt[Id[Model]].some{res_keep.ok});
    if (sel res_out_taken.err) {
        if (r.lowered) { ret err[Fail].err{fail.in_file(res_out_taken.err, src.file)}; }
        ret err[Fail].err{res_out_taken.err};
    }
    ret err[Fail].ok{};
}

# refuse the object or library `m`, named `file`, when it is of another
# object format than the link builds. a format that lowers no records is no
# object format, as a resource file and a text stub are not, and the link of
# any object format takes them
fun object_format(in: *Reading, file: str, m: *Model) err[Fail] {
    val f: *Format = m.reader.format;
    if (f == in.format)             { ret err[Fail].ok{}; }
    if (sel m.reader.lowering.none) { ret err[Fail].ok{}; }
    ret err[Fail].err{fail.cited(fail.about(fail.in_file(fail.malformed("an input is of another object format than the link's, which the citation names"), file), f.name), in.format.name)};
}

# the container `m` named `file`: kept whole, or the member for the link's
# architecture when its members carry architecture codes
fun container(in: *Reading, file: str, m: Id[Model], out: *Inputs) err[Fail] {
    var members:    Table[Member] = table.init[Member](out.a);
    val err_listed: err[Fail]     = contract.members(table.at[Model](?out.models, m), file, ?members);
    if (sel err_listed.err) {
        val err_dropped: err[Fail] = table.dnit[Member](?members);
        ret err_listed;
    }
    var coded:    bool                = false;
    var opt_pick: opt[contract.Input] = opt[contract.Input].none{};
    var i:        usize               = 0;
    for (i < table.count[Member](?members)) {
        val member: *Member = table.at[Member](?members, table.nth[Member](i));
        if (sel member.arch.some) {
            coded = true;
            if (sel opt_pick.none && for_arch(in.target.arch, ?member.arch.some)) { opt_pick = opt[contract.Input].some{member.input}; }
        }
        i = i + 1;
    }
    val err_dropped: err[Fail] = table.dnit[Member](?members);
    if (sel err_dropped.err) { ret err_dropped; }
    if (!coded) {
        val res_contain: res[Id[input.Input], Fail] = input.contain(out, file, m);
        if (sel res_contain.err) { ret err[Fail].err{res_contain.err}; }
        ret err[Fail].ok{};
    }
    if (sel opt_pick.none) {
        ret err[Fail].err{fail.in_file(fail.unsupported("the container holds no member for the link's architecture"), file)};
    }
    ret load(in, opt_pick.some, out);
}

# whether `s` names exactly the architecture `a`
fun for_arch(a: *Arch, s: *Stated) bool {
    val res_row: res[*Arch, Fail] = list.by_code(s);
    ret sel res_row.ok && res_row.ok == a;
}
