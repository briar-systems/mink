# the gather phase: the caller's sources become the link's inputs
#
# a given neutral object first takes the read form of the output format's
# conversion, as a copy the set owns, when the conversion normalizes it, so
# the link cuts and roots it the one way it does a file of the format. it
# then enters with the records it states, such as line sequences, lowered in
# place into sections and relocations in the output format's encoding, the
# step the format's from_neutral takes, so the link takes them the one way it
# takes a file's. an object in read form with no records enters as it is.
# bytes are sniffed through the format
# registry, read into their format's model and converted to a neutral object,
# and the set keeps both. a container is kept whole for resolve to load its
# members, except one whose members are chosen by architecture, which gives
# the member for the link's architecture in its place. what this phase appends
# is owned by the set the moment it is made, so a failure part way leaves
# nothing unowned.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Stated;
use mink.catalog.arch.list;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.format.contract;
use mink.format.contract.Member;
use mink.format.contract.Model;
use mink.format.contract.Neutral;
use mink.format.pair.Mapping;
use mink.format.readers;
use mink.format.readers.Readers;
use mink.link.input;
use mink.link.input.Inputs;
use mink.link.input.Source;
use mink.lower.Lowering;
use mink.lower.encode;
use mink.model.object;
use mink.model.object.Object;
use mink.model.target.Target;
use mink.reloc.row;

# reading: how each source is read
# sources: what the caller hands over, in order
# count:   how many
pub rec In {
    reading: Reading;
    sources: *Source;
    count:   usize;
}

# how the link reads an input
# ---
# readers:  the readers of every format
# relocs:   the relocation rows
# target:   the target the input is read for
# format:   the output format, whose encodings records are lowered in
# lowering: its encodings
# mapping:  its mapping symbols for the target's architecture
# neutral:  the output format's conversion, whose normalize gives a given
#           object its read form, none where it has none
pub rec Reading {
    readers:  *Readers;
    relocs:   *row.Registry;
    target:   Target;
    format:   *Format;
    lowering: opt[*Lowering];
    mapping:  opt[*Mapping];
    neutral:  opt[*Neutral];
}

pub fun run(in: *In, out: *Inputs) err[Fail] {
    var i: usize = 0;
    for (i < in.count) {
        val g: err[Fail] = source(?in.reading, ?in.sources[i], out);
        if (sel g.err) { ret g; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# append what the source `s` gives to `out`
pub fun source(in: *Reading, s: *Source, out: *Inputs) err[Fail] {
    if (sel s.object) {
        val g: err[Fail] = given(in, s.object, out);
        if (sel g.err) { ret err[Fail].err{fail.in_file(g.err, s.object.name)}; }
        ret g;
    }
    or (sel s.bytes) {
        ret load(in, s.bytes, out);
    }
    ret included(in, s.included, out);
}

# append the caller's object `g`: borrowed as it is when it is in read form
# and states no records, and otherwise a copy the set owns, in read form and
# its records lowered. the caller's object stays as it was, and a refusal
# appends nothing
fun given(in: *Reading, g: input.Given, out: *Inputs) err[Fail] {
    var normalize: opt[contract.Normalize] = opt[contract.Normalize].none{};
    if (sel in.neutral.some) { normalize = in.neutral.some.normalize; }
    if (sel normalize.some) {
        var o: Object          = object.make(table.allocator[Object](?out.objects), g.object.target.arch, g.object.kind);
        val n: res[bool, Fail] = normalize.some(in.relocs, g.object, ?o);
        if (sel n.err) {
            val dropped: err[Fail] = object.release(?o);
            ret err[Fail].err{n.err};
        }
        if (n.ok) { ret lowered(in, g.name, o, opt[Id[Model]].none{}, out); }
        val dropped: err[Fail] = object.release(?o);
        if (sel dropped.err) { ret dropped; }
    }
    if (object.has_records(g.object)) {
        val c: res[Object, Fail] = object.copy(table.allocator[Object](?out.objects), g.object);
        if (sel c.err) { ret err[Fail].err{c.err}; }
        ret lowered(in, g.name, c.ok, opt[Id[Model]].none{}, out);
    }
    val b: res[Id[input.Input], Fail] = input.borrow(out, g);
    if (sel b.err) { ret err[Fail].err{b.err}; }
    ret err[Fail].ok{};
}

# append `o`, an object the set owns from now on even when appending it is
# refused, as an input named `name` read from `model`, its records lowered in
# the output format's encodings. a refusal appends nothing
fun lowered(in: *Reading, name: str, o: Object, model: opt[Id[Model]], out: *Inputs) err[Fail] {
    var copy: Object                 = o;
    val rows: res[*row.Lookup, Fail] = row.find(in.relocs, in.format, copy.target.arch);
    var r:    err[Fail]              = err[Fail].ok{};
    if (sel rows.err) { r = err[Fail].err{rows.err}; }
    if (sel rows.ok)  { r = encode.apply(in.lowering, ?copy, rows.ok, in.mapping); }
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?copy);
        ret r;
    }
    val t: res[Id[input.Input], Fail] = input.take(out, name, copy, model);
    if (sel t.err) { ret err[Fail].err{t.err}; }
    ret err[Fail].ok{};
}

# append what the bytes of `src` hold, each input they give marked with
# what `src` states of the library
fun included(in: *Reading, src: input.Included, out: *Inputs) err[Fail] {
    val first: usize     = input.count(out);
    val l:     err[Fail] = load(in, src.input, out);
    if (sel l.err) { ret l; }
    var i: usize = first;
    for (i < input.count(out)) {
        val e: *input.Input = input.at(out, table.nth[input.Input](i));
        e.searched = src.searched;
        e.include  = src.include;
        e.path     = src.path;
        i          = i + 1;
    }
    ret err[Fail].ok{};
}

# append what the bytes `src` hold to `out`, sniffed through `r`, an object
# converted for the target `target` through the rows of `rows` and a
# container kept whole. the object states the link's target only until its
# conversion, which holds the file against it and states the file's own
pub fun load(in: *Reading, src: contract.Input, out: *Inputs) err[Fail] {
    var bytes: contract.Input   = src;
    val read:  res[Model, Fail] = readers.read(in.readers, out.a, ?bytes);
    if (sel read.err) { ret err[Fail].err{read.err}; }
    val m: res[Id[Model], Fail] = input.keep(out, read.ok);
    if (sel m.err) { ret err[Fail].err{m.err}; }
    val held: res[bool, Fail] = contract.is_container(table.at[Model](?out.models, m.ok));
    if (sel held.err) { ret err[Fail].err{fail.in_file(held.err, bytes.file)}; }
    if (held.ok)      { ret container(in, bytes.file, m.ok, out); }
    var o: Object = object.make(out.a, in.target.arch, nil);
    o.target = in.target;
    val conv: err[Fail] = contract.to_neutral(table.at[Model](?out.models, m.ok), in.relocs, ?o);
    if (sel conv.err) {
        val dropped: err[Fail] = object.release(?o);
        ret err[Fail].err{fail.in_file(conv.err, bytes.file)};
    }
    if (object.has_records(?o)) {
        val low: err[Fail] = lowered(in, bytes.file, o, opt[Id[Model]].some{m.ok}, out);
        if (sel low.err) { ret err[Fail].err{fail.in_file(low.err, bytes.file)}; }
        ret low;
    }
    val e: res[Id[input.Input], Fail] = input.take(out, bytes.file, o, opt[Id[Model]].some{m.ok});
    if (sel e.err) { ret err[Fail].err{e.err}; }
    ret err[Fail].ok{};
}

# the container `m` named `file`: kept whole, or the member for the link's
# architecture when its members carry architecture codes
fun container(in: *Reading, file: str, m: Id[Model], out: *Inputs) err[Fail] {
    var members: Table[Member] = table.make[Member](out.a);
    val listed:  err[Fail]     = contract.members(table.at[Model](?out.models, m), file, ?members);
    if (sel listed.err) {
        val dropped: err[Fail] = table.release[Member](?members);
        ret listed;
    }
    var coded: bool                = false;
    var pick:  opt[contract.Input] = opt[contract.Input].none{};
    var i:     usize               = 0;
    for (i < table.count[Member](?members)) {
        val member: *Member = table.at[Member](?members, table.nth[Member](i));
        if (sel member.arch.some) {
            coded = true;
            if (sel pick.none && for_arch(in.target.arch, ?member.arch.some)) { pick = opt[contract.Input].some{member.input}; }
        }
        i = i + 1;
    }
    val dropped: err[Fail] = table.release[Member](?members);
    if (sel dropped.err) { ret dropped; }
    if (!coded) {
        val e: res[Id[input.Input], Fail] = input.contain(out, file, m);
        if (sel e.err) { ret err[Fail].err{e.err}; }
        ret err[Fail].ok{};
    }
    if (sel pick.none) {
        ret err[Fail].err{fail.in_file(fail.unsupported("the container holds no member for the link's architecture"), file)};
    }
    ret load(in, pick.some, out);
}

# whether `s` names exactly the architecture `a`
fun for_arch(a: *Arch, s: *Stated) bool {
    val row: res[*Arch, Fail] = list.by_code(s);
    ret sel row.ok && row.ok == a;
}
