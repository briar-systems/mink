# what a link tells the caller who watches it: each stage of its work as it
# closes, and each item a stage processed as it finishes
#
# a stage is a span of the link a person reads as one step, the way mach's
# readout reads a build's phases: reading the inputs, resolving their names,
# laying out the image and writing it. each of the link's phases belongs to
# one stage, the stages run in their table's order and each at most once, and
# an archive, which resolves and lays out nothing, reads and writes. a stage
# closes with its wall time and what it made, read through its row: a count
# of its noun, or the bytes it wrote. a stage the link was refused in closes
# with the errors it reported and no count, and no stage follows it.
#
# a watcher is a function and its context. every event reaches it on the
# thread that called the link, in the order the events happened, so it keeps
# no lock, and what an event names is borrowed for the call alone. a link no
# one watches reads no clock and makes no event. a new stage is a row of the
# table and a new kind of event a variant of `Event`, which a watcher that
# selects only what it knows reads without change.

use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use std.chrono.duration.Duration;
use std.chrono.time;

# a stage of the link, an index into the table of stages
pub def Stage: u8;

pub val READ:    Stage = 0;
pub val RESOLVE: Stage = 1;
pub val LAYOUT:  Stage = 2;
pub val WRITE:   Stage = 3;

pub val STAGE_COUNT: usize = 4;

# what the count a stage closes with measures
pub def Measure: u8;

pub val COUNTED: Measure = 0; # things of the stage's noun
pub val SIZED:   Measure = 1; # bytes

# the longest label a stage has, the room a log line keeps for it
pub val LABEL_MAX: usize = 11;

# one stage
# ---
# label:   its name in a log line, a word of at most LABEL_MAX bytes
# measure: what its count measures
# one:     the noun of a count of one, nil for a sized stage
# many:    the noun of any other count, nil for a sized stage
pub rec Row {
    label:   str;
    measure: Measure;
    one:     str;
    many:    str;
}

val ROWS: [STAGE_COUNT]Row = [STAGE_COUNT]Row{
    Row{label: "read", measure: COUNTED, one: "input", many: "inputs"},
    Row{label: "resolve", measure: COUNTED, one: "object", many: "objects"},
    Row{label: "layout", measure: COUNTED, one: "section", many: "sections"},
    Row{label: "write", measure: SIZED, one: nil, many: nil},
};

# the row of the stage `s`
pub fun row(s: Stage) *Row {
    ret ?ROWS[s];
}

# an item a stage finished, as the inputs it read
# ---
# stage:   the stage
# name:    the item, as its stage names it, borrowed for the call
# elapsed: how long it took on the thread that ran it
pub rec Item {
    stage:   Stage;
    name:    str;
    elapsed: Duration;
}

# a stage closed
# ---
# stage:   the stage
# elapsed: its wall time
# count:   what it made, read through its row's measure, zero when it was
#          refused
# errors:  the errors it reported, so it made nothing after them
pub rec Close {
    stage:   Stage;
    elapsed: Duration;
    count:   u64;
    errors:  u32;
}

# what a link tells its watcher
pub tag Event: u8 {
    item:  Item;
    close: Close;
}

# who watches a link
# ---
# context: the watcher's own, handed back with each event
# on:      what reads each event
pub rec Watcher {
    context: ptr;
    on:      fun(ptr, *Event);
}

# an instant a duration is measured from, none when the clock refused it,
# so a duration measured from it is zero rather than invented
pub def Instant: opt[time.Instant];

# the instant now, none on a host with no clock or when the clock refused
pub fun sample() Instant {
    $if (capability.HAS_CLOCK) {
        val res_instant: time.InstantClock = time.instant();
        if (sel res_instant.ok) { ret Instant.some{res_instant.ok}; }
    }
    ret Instant.none{};
}

# the time since `start`, zero when either sample is absent
pub fun elapsed(start: Instant) Duration {
    if (sel start.none) { ret 0; }
    $if (capability.HAS_CLOCK) {
        val res_instant: time.InstantClock = time.instant();
        if (sel res_instant.ok) { ret time.instant_sub(res_instant.ok, start.some); }
    }
    ret 0;
}

# the stage a link has open, as the link tells its watcher of it
# ---
# watcher: who watches, nil for a link no one watches
# stage:   the stage open
# opened:  when it opened
# open:    whether a stage is open
pub rec Watch {
    watcher: *Watcher;
    stage:   Stage;
    opened:  Instant;
    open:    bool;
}

# a watch of a link for `w`, nil for none
pub fun watch(w: *Watcher) Watch {
    ret Watch{watcher: w, stage: READ, opened: Instant.none{}, open: false};
}

# whether anyone watches the link of `w`, so it times what it does
pub fun watched(w: *Watch) bool {
    ret w.watcher != nil;
}

# whether `s` is the stage open in `w`
pub fun within(w: *Watch, s: Stage) bool {
    ret w.open && w.stage == s;
}

# open the stage `s` in `w`, once the stage open before it is closed
pub fun enter(w: *Watch, s: Stage) {
    if (!watched(w)) { ret; }
    w.stage  = s;
    w.opened = sample();
    w.open   = true;
}

# close the stage open in `w`, which made `count` as its row measures, and
# tell the watcher. nothing is open after
pub fun close(w: *Watch, count: u64) {
    ended(w, count, 0);
}

# close the stage open in `w` as the one the link was refused in, and tell
# the watcher. nothing is open after
pub fun refused(w: *Watch) {
    ended(w, 0, 1);
}

fun ended(w: *Watch, count: u64, errors: u32) {
    if (!watched(w) || !w.open) { ret; }
    w.open = false;
    var ev: Event = Event.close{Close{stage: w.stage, elapsed: elapsed(w.opened), count: count, errors: errors}};
    w.watcher.on(w.watcher.context, ?ev);
}

# tell the watcher of `w` that the stage open finished the item `name`,
# which took `took`
pub fun item(w: *Watch, name: str, took: Duration) {
    if (!watched(w) || !w.open) { ret; }
    var ev: Event = Event.item{Item{stage: w.stage, name: name, elapsed: took}};
    w.watcher.on(w.watcher.context, ?ev);
}
