# what the caller states about a link
#
# the options are the facts a link is asked for, plain data the link holds for
# as long as it lives. the formats the link reads are a dependency, handed to
# the link beside the options and never one of them.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.bytes.compress.Method;
use mink.catalog.format.Format;
use mink.catalog.output.Kind;
use mink.model.target.Target;

# a memory region the link states
# ---
# name:   how the link's other statements name it
# origin: the address it starts at
# length: how many bytes it spans
# access: what it allows, of layout's READABLE, WRITABLE and EXECUTABLE
pub rec Area {
    name:   str;
    origin: u64;
    length: u64;
    access: u8;
}

# an output section the link states lies in a region
# ---
# section: the output section's name
# region:  the region, by its index in the options' regions
pub rec Within {
    section: str;
    region:  usize;
}

# an output section the link states starts at an offset from the start of
# the region it runs in, from the image base where it runs in none
pub rec Offset {
    section: str;
    offset:  u64;
}

# kind:             the output kind
# format:           the output format
# target:           what the image is for, which names its system
# entry:            the entry symbol, nil for the system's
# keep:             the names kept whether referenced or not
# keep_count:       how many
# sections:         the output sections placed ahead of the rest, in the
#                   order named
# section_count:    how many
# base:             the address the image is laid out from, none for the
#                   host's
# regions:          the memory regions the link states
# region_count:     how many
# runs:             the output sections stated to run in a region
# run_count:        how many
# loads:            the output sections whose bytes are stated to load in a
#                   region other than the one they run in
# load_count:       how many
# offsets:          the output sections stated at an offset
# offset_count:     how many
# size:             the most bytes the image loads from its base, exactly
#                   what an image its writer pads takes, none where the link
#                   states none
# fill:             the byte every byte of the image no section loads holds,
#                   none where the link states none
# gc_sections:      whether sections nothing reaches from the roots are left
#                   out of the image, none for the output format's default
# keep_temporaries: whether the image keeps the inputs' temporary symbols,
#                   none for the default of the format's pair for the
#                   architecture
# tail_merge:       whether merged strings share the tail of a longer string
#                   ending in the same elements, none for the output format's
#                   rule
# output:           the path the caller writes the image to, which names
#                   the image where its format records a name, nil where the
#                   caller states none
# sign:             whether the image carries a code signature, none for the
#                   host's rule
# state:            the path of the link's one state file, nil for a link
#                   that keeps none. mink writes no other file
# compress:         the method the image's non-alloc debug sections are
#                   compressed with, none to keep them as they are
# sysroot:          the root the system's library and framework directories
#                   are searched under, nil for the host's own
# libdirs:          the directories a library named is searched in ahead of
#                   the system's, in order
# libdir_count:     how many
# fwdirs:           the directories a framework named is searched in ahead
#                   of the system's, in order
# fwdir_count:      how many
# timing_mode:      whether the image requires the timing mode, which
#                   mink.link.needs carries in a cell its start-up reads,
#                   false by default
pub rec Options {
    kind:             *Kind;
    format:           *Format;
    target:           Target;
    entry:            str;
    keep:             *str;
    keep_count:       usize;
    sections:         *str;
    section_count:    usize;
    base:             opt[u64];
    regions:          *Area;
    region_count:     usize;
    runs:             *Within;
    run_count:        usize;
    loads:            *Within;
    load_count:       usize;
    offsets:          *Offset;
    offset_count:     usize;
    size:             opt[u64];
    fill:             opt[u8];
    gc_sections:      opt[bool];
    keep_temporaries: opt[bool];
    tail_merge:       opt[bool];
    output:           str;
    sign:             opt[bool];
    state:            str;
    compress:         opt[*Method];
    sysroot:          str;
    libdirs:          *str;
    libdir_count:     usize;
    fwdirs:           *str;
    fwdir_count:      usize;
    timing_mode:      bool;
}
