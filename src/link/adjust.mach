# what layout participants change of the inputs' bytes and relocations
#
# a participant that relaxes code edits the bytes of input sections and
# chooses the forms relocations take, and layout and relocate read what it
# recorded: layout cuts what an edit deletes, moving every label after it in
# that section, and relocate writes what an edit writes and applies each
# relocation as the form chosen for it. an edit that restores the alignment
# of the bytes after it, as a padding deletion does, lets layout remove
# exactly the range a dropped atom leaves in that section rather than a
# multiple of the section's alignment. a participant that lays veneers sends
# a relocation whose target lies past its reach through one, and relocate
# applies it to the veneer. every record names the participant that made
# it, which restates its own each pass and leaves the others'.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.collections.sort;

use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.link.collect.Ref;
use mink.link.input.Input;
use mink.model.object.Reloc;
use mink.model.reloc.Kind;
use mink.reloc.row;
use mink.reloc.row.Rewrite;

# bytes an edit writes, `len` of the record's store from `first`
pub rec Written {
    first: usize;
    len:   usize;
}

# what an edit does at its offset
# ---
# write:  writes bytes over the section's
# delete: deletes this many bytes, so the bytes after move back
pub tag Change: u8 {
    write:  Written;
    delete: u64;
}

# an edit of the bytes of an input section
# ---
# by:       the participant that made it, by name
# at:       the section
# offset:   where in it the edit applies
# change:   what it does there
# restores: the edit restores the alignment of the bytes after it
pub rec Edit {
    by:       str;
    at:       Ref;
    offset:   u64;
    change:   Change;
    restores: bool;
}

# the form a relocation takes
# ---
# by:      the participant that chose it, by name
# input:   the input holding the relocation
# reloc:   the relocation
# rewrite: the form chosen, from the row of the record that heads it
# nth:     which record of the form the relocation is, zero for the head and
#          one on for the partners it consumes
pub rec Choice {
    by:      str;
    input:   Id[Input];
    reloc:   Id[Reloc];
    rewrite: *Rewrite;
    nth:     u8;
}

# a relocation sent through a veneer, which leads on to its target
# ---
# by:     the participant that sent it, by name
# input:  the input holding the relocation
# reloc:  the relocation
# veneer: the veneer, by its index among the link's veneers
pub rec Detour {
    by:     str;
    input:  Id[Input];
    reloc:  Id[Reloc];
    veneer: u32;
}

# edits:     every edit, in the order the participants made them
# chosen:    every form chosen, ascending by input and relocation once sealed
# detours:   every relocation sent through a veneer, ascending by input and
#            relocation once sealed
# restoring: the sections an edit restores alignment in, ascending once
#            sealed
# bytes:     the bytes the edits write
pub rec Adjusted {
    edits:     Table[Edit];
    chosen:    Table[Choice];
    detours:   Table[Detour];
    restoring: Table[Ref];
    bytes:     Table[u8];
}

pub fun make(a: *A.Allocator) Adjusted {
    ret Adjusted{edits: table.make[Edit](a), chosen: table.make[Choice](a), detours: table.make[Detour](a), restoring: table.make[Ref](a), bytes: table.make[u8](a)};
}

# record the edit `e`
pub fun edit(a: *Adjusted, e: Edit) err[Fail] {
    val p: res[Id[Edit], Fail] = table.push[Edit](?a.edits, e);
    if (sel p.err)   { ret err[Fail].err{p.err}; }
    if (!e.restores) { ret err[Fail].ok{}; }
    val r: res[Id[Ref], Fail] = table.push[Ref](?a.restoring, e.at);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

# record that `by` writes the `len` bytes at `data` at `offset` of the
# section `at`
pub fun write(a: *Adjusted, by: str, at: Ref, offset: u64, data: *u8, len: usize) err[Fail] {
    val first: usize             = table.count[u8](?a.bytes);
    val x:     res[Id[u8], Fail] = table.extend[u8](?a.bytes, data, len);
    if (sel x.err) { ret err[Fail].err{x.err}; }
    ret edit(a, Edit{by: by, at: at, offset: offset, change: Change.write{Written{first: first, len: len}}});
}

# the bytes the write `w` writes
pub fun written(a: *Adjusted, w: Written) *u8 {
    ret ?table.items[u8](?a.bytes)[w.first];
}

# record that the relocation of `c` takes its form
pub fun choose(a: *Adjusted, c: Choice) err[Fail] {
    val p: res[Id[Choice], Fail] = table.push[Choice](?a.chosen, c);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# record that the relocation of `d` goes through its veneer
pub fun detour(a: *Adjusted, d: Detour) err[Fail] {
    val p: res[Id[Detour], Fail] = table.push[Detour](?a.detours, d);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the kind the relocation of `c` becomes
pub fun kind_of(c: *Choice) *Kind {
    ret c.rewrite.kinds[c.nth];
}

# the kind a relocation is applied as, the offset of its place, and the
# form layout rewrote it to, none for none
pub rec Taken {
    kind:   *Kind;
    offset: u64;
    form:   opt[*Rewrite];
}

# how the relocation `rel`, the `r`th of the input `in`, is applied: as the
# kind of the form chosen for it at the place the form moves it to, or as
# itself
pub fun taken(a: *Adjusted, in: Id[Input], r: Id[Reloc], rel: *Reloc) res[Taken, Fail] {
    val ch: opt[*Choice] = choice_of(a, in, r);
    if (sel ch.none) { ret res[Taken, Fail].ok{Taken{kind: rel.kind, offset: rel.offset, form: opt[*Rewrite].none{}}}; }
    val chosen: *Choice       = ch.some;
    val form:   opt[*Rewrite] = opt[*Rewrite].some{chosen.rewrite};
    if (chosen.nth != 0) { ret res[Taken, Fail].ok{Taken{kind: kind_of(chosen), offset: rel.offset, form: form}}; }
    val offset: res[u64, Fail] = row.moved(chosen.rewrite, rel.offset);
    if (sel offset.err) { ret res[Taken, Fail].err{offset.err}; }
    ret res[Taken, Fail].ok{Taken{kind: kind_of(chosen), offset: offset.ok, form: form}};
}

fun order_refs(x: *Ref, y: *Ref) i64 {
    if (x.input.index != y.input.index)     { ret ordered(x.input.index < y.input.index); }
    if (x.section.index != y.section.index) { ret ordered(x.section.index < y.section.index); }
    ret 0;
}

fun order_choices(x: *Choice, y: *Choice) i64 {
    if (x.input.index != y.input.index) { ret ordered(x.input.index < y.input.index); }
    if (x.reloc.index != y.reloc.index) { ret ordered(x.reloc.index < y.reloc.index); }
    ret 0;
}

fun order_detours(x: *Detour, y: *Detour) i64 {
    if (x.input.index != y.input.index) { ret ordered(x.input.index < y.input.index); }
    if (x.reloc.index != y.reloc.index) { ret ordered(x.reloc.index < y.reloc.index); }
    ret 0;
}

fun ordered(less: bool) i64 {
    if (less) { ret -1; }
    ret 1;
}

# order the sections an edit restores alignment in, the forms chosen and the
# detours, so restores, choice_of and detour_of can find them
pub fun seal(a: *Adjusted) {
    sort.sort_by[Ref](table.items[Ref](?a.restoring), table.count[Ref](?a.restoring), order_refs);
    sort.sort_by[Choice](table.items[Choice](?a.chosen), table.count[Choice](?a.chosen), order_choices);
    sort.sort_by[Detour](table.items[Detour](?a.detours), table.count[Detour](?a.detours), order_detours);
}

# whether an edit restores alignment in the section `at`, the record sealed
pub fun restores(a: *Adjusted, at: Ref) bool {
    val refs: *Ref  = table.items[Ref](?a.restoring);
    var low:  usize = 0;
    var high: usize = table.count[Ref](?a.restoring);
    for (low < high) {
        val mid: usize = low + (high - low) / 2;
        val c:   i64   = order_refs(?refs[mid], ?at);
        if (c == 0) { ret true; }
        if (c < 0)  { low = mid + 1; }
        or          { high = mid; }
    }
    ret false;
}

# the form chosen for the relocation `r` of the input `in`, none when it
# keeps its own, the record sealed
pub fun choice_of(a: *Adjusted, in: Id[Input], r: Id[Reloc]) opt[*Choice] {
    val all:   *Choice = table.items[Choice](?a.chosen);
    var probe: Choice  = Choice{input: in, reloc: r};
    var low:   usize   = 0;
    var high:  usize   = table.count[Choice](?a.chosen);
    for (low < high) {
        val mid: usize = low + (high - low) / 2;
        val c:   i64   = order_choices(?all[mid], ?probe);
        if (c == 0) { ret opt[*Choice].some{?all[mid]}; }
        if (c < 0)  { low = mid + 1; }
        or          { high = mid; }
    }
    ret opt[*Choice].none{};
}

# the detour of the relocation `r` of the input `in`, none when it goes to
# its target itself, the record sealed
pub fun detour_of(a: *Adjusted, in: Id[Input], r: Id[Reloc]) opt[*Detour] {
    val all:   *Detour = table.items[Detour](?a.detours);
    var probe: Detour  = Detour{input: in, reloc: r};
    var low:   usize   = 0;
    var high:  usize   = table.count[Detour](?a.detours);
    for (low < high) {
        val mid: usize = low + (high - low) / 2;
        val c:   i64   = order_detours(?all[mid], ?probe);
        if (c == 0) { ret opt[*Detour].some{?all[mid]}; }
        if (c < 0)  { low = mid + 1; }
        or          { high = mid; }
    }
    ret opt[*Detour].none{};
}

# whether the records `by` made in `a` are exactly those of `next`, in order
pub fun same(a: *Adjusted, by: str, next: *Adjusted) bool {
    var j: usize = 0;
    var i: usize = 0;
    for (i < table.count[Edit](?a.edits)) {
        val e: *Edit = table.at[Edit](?a.edits, table.nth[Edit](i));
        i = i + 1;
        if (!str_equals(e.by, by))                                                   { cnt; }
        if (j >= table.count[Edit](?next.edits))                                     { ret false; }
        if (!same_edit(a, e, next, table.at[Edit](?next.edits, table.nth[Edit](j)))) { ret false; }
        j = j + 1;
    }
    if (j != table.count[Edit](?next.edits)) { ret false; }
    j = 0;
    i = 0;
    for (i < table.count[Choice](?a.chosen)) {
        val c: *Choice = table.at[Choice](?a.chosen, table.nth[Choice](i));
        i = i + 1;
        if (!str_equals(c.by, by))                  { cnt; }
        if (j >= table.count[Choice](?next.chosen)) { ret false; }
        val d: *Choice = table.at[Choice](?next.chosen, table.nth[Choice](j));
        if (c.input.index != d.input.index || c.reloc.index != d.reloc.index || c.rewrite != d.rewrite || c.nth != d.nth) { ret false; }
        j = j + 1;
    }
    if (j != table.count[Choice](?next.chosen)) { ret false; }
    j = 0;
    i = 0;
    for (i < table.count[Detour](?a.detours)) {
        val c: *Detour = table.at[Detour](?a.detours, table.nth[Detour](i));
        i = i + 1;
        if (!str_equals(c.by, by))                   { cnt; }
        if (j >= table.count[Detour](?next.detours)) { ret false; }
        val d: *Detour = table.at[Detour](?next.detours, table.nth[Detour](j));
        if (c.input.index != d.input.index || c.reloc.index != d.reloc.index || c.veneer != d.veneer) { ret false; }
        j = j + 1;
    }
    ret j == table.count[Detour](?next.detours);
}

fun same_edit(a: *Adjusted, e: *Edit, next: *Adjusted, f: *Edit) bool {
    if (e.at.input.index != f.at.input.index || e.at.section.index != f.at.section.index || e.offset != f.offset || e.restores != f.restores) { ret false; }
    if (sel e.change.delete) {
        if (!sel f.change.delete) { ret false; }
        ret e.change.delete == f.change.delete;
    }
    if (!sel f.change.write) { ret false; }
    val x: Written = e.change.write;
    val y: Written = f.change.write;
    if (x.len != y.len) { ret false; }
    val p: *u8   = written(a, x);
    val q: *u8   = written(next, y);
    var k: usize = 0;
    for (k < x.len) {
        if (p[k] != q[k]) { ret false; }
        k = k + 1;
    }
    ret true;
}

# replace the records `by` made in `a` with those of `next`, keeping every
# other participant's
pub fun restate(a: *Adjusted, by: str, next: *Adjusted) err[Fail] {
    val edits: *Edit = table.items[Edit](?a.edits);
    val data:  *u8   = table.items[u8](?a.bytes);
    var kept:  usize = 0;
    var top:   usize = 0;
    var i:     usize = 0;
    for (i < table.count[Edit](?a.edits)) {
        var e: Edit = edits[i];
        i = i + 1;
        if (str_equals(e.by, by)) { cnt; }
        var moved: opt[Written] = opt[Written].none{};
        if (sel e.change.write) { moved = opt[Written].some{e.change.write}; }
        if (sel moved.some) {
            val w: Written = moved.some;
            var k: usize   = 0;
            for (k < w.len) {
                data[top + k] = data[w.first + k];
                k             = k + 1;
            }
            e.change = Change.write{Written{first: top, len: w.len}};
            top      = top + w.len;
        }
        edits[kept] = e;
        kept        = kept + 1;
    }
    table.truncate[Edit](?a.edits, kept);
    table.truncate[u8](?a.bytes, top);
    val choices: *Choice = table.items[Choice](?a.chosen);
    var held:    usize   = 0;
    i = 0;
    for (i < table.count[Choice](?a.chosen)) {
        if (!str_equals(choices[i].by, by)) {
            choices[held] = choices[i];
            held          = held + 1;
        }
        i = i + 1;
    }
    table.truncate[Choice](?a.chosen, held);
    val detours: *Detour = table.items[Detour](?a.detours);
    held = 0;
    i    = 0;
    for (i < table.count[Detour](?a.detours)) {
        if (!str_equals(detours[i].by, by)) {
            detours[held] = detours[i];
            held          = held + 1;
        }
        i = i + 1;
    }
    table.truncate[Detour](?a.detours, held);
    i = 0;
    for (i < table.count[Edit](?next.edits)) {
        val e: *Edit = table.at[Edit](?next.edits, table.nth[Edit](i));
        i = i + 1;
        if (sel e.change.write) {
            val w: Written   = e.change.write;
            val r: err[Fail] = write(a, by, e.at, e.offset, written(next, w), w.len);
            if (sel r.err) { ret r; }
            cnt;
        }
        var own: Edit = @e;
        own.by = by;
        val r: res[Id[Edit], Fail] = table.push[Edit](?a.edits, own);
        if (sel r.err) { ret err[Fail].err{r.err}; }
    }
    i = 0;
    for (i < table.count[Choice](?next.chosen)) {
        var c: Choice = @table.at[Choice](?next.chosen, table.nth[Choice](i));
        c.by = by;
        val r: err[Fail] = choose(a, c);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Detour](?next.detours)) {
        var d: Detour = @table.at[Detour](?next.detours, table.nth[Detour](i));
        d.by = by;
        val r: err[Fail] = detour(a, d);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    table.clear[Ref](?a.restoring);
    i = 0;
    for (i < table.count[Edit](?a.edits)) {
        val e: *Edit = table.at[Edit](?a.edits, table.nth[Edit](i));
        i = i + 1;
        if (!e.restores) { cnt; }
        val r: res[Id[Ref], Fail] = table.push[Ref](?a.restoring, e.at);
        if (sel r.err) { ret err[Fail].err{r.err}; }
    }
    seal(a);
    ret err[Fail].ok{};
}

# forget every edit, choice and detour, as a link that starts afresh does
pub fun clear(a: *Adjusted) {
    table.clear[Edit](?a.edits);
    table.clear[Choice](?a.chosen);
    table.clear[Detour](?a.detours);
    table.clear[Ref](?a.restoring);
    table.clear[u8](?a.bytes);
}

pub fun release(a: *Adjusted) err[Fail] {
    val e: err[Fail] = table.release[Edit](?a.edits);
    val c: err[Fail] = table.release[Choice](?a.chosen);
    val d: err[Fail] = table.release[Detour](?a.detours);
    val r: err[Fail] = table.release[Ref](?a.restoring);
    val b: err[Fail] = table.release[u8](?a.bytes);
    if (sel e.err) { ret e; }
    if (sel c.err) { ret c; }
    if (sel d.err) { ret d; }
    if (sel r.err) { ret r; }
    ret b;
}
