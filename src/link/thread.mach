# how a thread pointer relates to the thread-local block, a fact of one
# (format, architecture) pair that the pair's row names and layout reads

use std.types.string.str;

# where the thread pointer lies against a thread-local block
# ---
# above: the block lies above the thread pointer, past a control block of its
#        own, as a variant I layout has it
# below: the block ends at the thread pointer, as a variant II layout has it
pub tag Side: u8 {
    above;
    below;
}

# side:     which side of the thread pointer the block lies
# tcb:      the control block, in bytes, a block above the thread pointer lies
#           past
# tp_bias:  how far past the point the block's offsets count from the thread
#           pointer's offsets count
# dtp_bias: the same for the dynamic thread vector's offsets
# source:   the specification section the row follows
pub rec Thread {
    side:     Side;
    tcb:      u64;
    tp_bias:  i64;
    dtp_bias: i64;
    source:   str;
}
