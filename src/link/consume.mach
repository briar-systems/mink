# what a link does with the sections that are not image content
#
# a section's kind names its use. a use that is placed is laid out as image
# content, and every other use the output format takes has one row in its
# linking row, keyed by the use, stating how the link takes a section of it
# and the stage of the link that takes it: dropped, kept as what the section
# states for a reader of the record, as its strings or its flags, or left to
# the image writer, which reads it from its input. the
# rows are declared here and the formats name the ones they take. a section of
# a use no row names is refused, naming the section and the use, so no section
# reaches an image for want of a rule. a link takes the directives of the
# kinds its format's row lists, which its image writer reads from the inputs,
# and an input carrying a directive of another kind is refused naming its
# kind. a link takes an input's resources only when its row says its image
# writer builds a resource tree from them, and refuses them otherwise. settle
# takes every object
# input's sections through the rows of its stage, all of an input or none, and
# collect never places them. what the rows keep is one table of what each
# section stated, in the order the link took it, so taking an input is undone
# by cutting the table back.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.model.directive;
use mink.model.object;
use mink.model.object.Directive;
use mink.model.object.Object;
use mink.model.object.Section;
use mink.model.section;
use mink.model.section.Use;

# a moment of the link at which consume rows take their sections
pub rec Stage {
    name: str;
}

# as settle takes each object input
pub val SETTLE: Stage = Stage{name: "settle"};
# as the image writer reads the sections from the inputs, so no phase takes
# them into the record
pub val IMAGE: Stage = Stage{name: "image"};

# what one section that is not image content stated, as its row kept it
# ---
# use:   the section's use
# start: where its bytes start in the record's store
# len:   how many bytes it kept
# flags: the flags it carried
pub rec Taken {
    use:   *Use;
    start: usize;
    len:   usize;
    flags: section.Flags;
}

# what the inputs' sections that are not image content state for the output
# ---
# taken: each section a row kept, in the order the link took it
# store: the bytes the taken sections kept
pub rec Consumed {
    taken: Table[Taken];
    store: Table[u8];
}

# what a consumed record held at a point, so taking an input can be undone
pub rec Mark {
    taken: usize;
    store: usize;
}

# use:   the use the row takes
# stage: the stage of the link that takes a section of the use
# take:  takes the section `s` of `o` into the record
pub rec Row {
    use:   *Use;
    stage: *Stage;
    take:  fun(*Consumed, *Object, *Section) err[Fail];
}

# the rows of a format, at most one per use, the directive kinds its link
# takes, and whether its image writer builds a resource tree from the inputs'
# resources
pub rec Uses {
    rows:            **Row;
    count:           usize;
    directives:      **directive.Kind;
    directive_count: usize;
    resources:       bool;
}

# whether `u` takes a directive of the kind `k`
fun takes(u: *Uses, k: *directive.Kind) bool {
    var i: usize = 0;
    for (i < u.directive_count) {
        if (u.directives[i] == k) { ret true; }
        i = i + 1;
    }
    ret false;
}

# nothing folds identical code yet, so which addresses are significant is
# never read and the table is dropped
pub val SIGNIFICANCE: Row = Row{use: ?section.SIGNIFICANCE, stage: ?SETTLE, take: dropped};
pub val STRINGS:      Row = Row{use: ?section.IDENTIFICATION, stage: ?SETTLE, take: strings_of};
pub val STACK:        Row = Row{use: ?section.STACK, stage: ?SETTLE, take: stack_of};
# the image writer reads the inputs' unwind records to build the image's own
# unwind table
pub val UNWIND_RECORDS: Row = Row{use: ?section.CONSUMED_UNWIND, stage: ?IMAGE, take: read_by_image};
# the image writer reads the inputs' resource trees to build the image's one
# resource tree
pub val RESOURCE_TREES: Row = Row{use: ?section.RESOURCES, stage: ?IMAGE, take: read_by_image};

fun row_of(u: *Uses, use: *Use) opt[*Row] {
    var i: usize = 0;
    for (i < u.count) {
        if (u.rows[i].use == use) { ret opt[*Row].some{u.rows[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

pub fun make(a: *A.Allocator) Consumed {
    ret Consumed{taken: table.make[Taken](a), store: table.make[u8](a)};
}

pub fun release(c: *Consumed) err[Fail] {
    val t: err[Fail] = table.release[Taken](?c.taken);
    val s: err[Fail] = table.release[u8](?c.store);
    if (sel t.err) { ret t; }
    ret s;
}

pub fun mark(c: *Consumed) Mark {
    ret Mark{taken: table.count[Taken](?c.taken), store: table.count[u8](?c.store)};
}

# give back everything taken since `m`
pub fun restore(c: *Consumed, m: Mark) err[Fail] {
    table.truncate[Taken](?c.taken, m.taken);
    table.truncate[u8](?c.store, m.store);
    ret err[Fail].ok{};
}

# keep the `n` bytes at `p` and the flags `flags` a section of use `u` stated
fun keep(c: *Consumed, u: *Use, p: *u8, n: usize, flags: section.Flags) err[Fail] {
    val start: usize             = table.count[u8](?c.store);
    val grown: res[Id[u8], Fail] = table.grow[u8](?c.store, n);
    if (sel grown.err) { ret err[Fail].err{grown.err}; }
    var i: usize = 0;
    for (i < n) {
        table.items[u8](?c.store)[start + i] = p[i];
        i                                    = i + 1;
    }
    val t: res[Id[Taken], Fail] = table.push[Taken](?c.taken, Taken{use: u, start: start, len: n, flags: flags});
    if (sel t.err) { ret err[Fail].err{t.err}; }
    ret err[Fail].ok{};
}

# the row of section `s` among `u`, refused naming its use when the link has
# none
fun row_for(u: *Uses, s: *Section) res[*Row, Fail] {
    val row: opt[*Row] = row_of(u, s.kind.use);
    if (sel row.none) {
        ret res[*Row, Fail].err{fail.about(fail.unsupported("the link has no rule for a section of this use"), s.kind.use.name)};
    }
    ret res[*Row, Fail].ok{row.some};
}

# take every section of `o` whose use is not placed and whose row among `u`
# is of the stage `at`, all or none: a refusal names the section by its index
# and leaves the record as it was
pub fun take(c: *Consumed, u: *Uses, o: *Object, at: *Stage) err[Fail] {
    var k: usize = 0;
    for (k < table.count[Directive](?o.directives)) {
        val d: *Directive = table.at[Directive](?o.directives, table.nth[Directive](k));
        if (!takes(u, d.kind)) { ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("the link takes no directive of this kind"), d.kind.name), "directive", k::u64)}; }
        k = k + 1;
    }
    if (!u.resources && table.count[object.Resource](?o.resources) != 0) {
        ret err[Fail].err{fail.in_indexed(fail.unsupported("the format's image holds no resource tree"), "resource", 0)};
    }
    val m: Mark  = mark(c);
    var i: usize = 0;
    for (i < table.count[Section](?o.sections)) {
        val s: *Section = object.section_at(o, table.nth[Section](i));
        i = i + 1;
        if (s.kind.use.placed) { cnt; }
        val row: res[*Row, Fail] = row_for(u, s);
        var r:   err[Fail]       = err[Fail].ok{};
        if (sel row.err) { r = err[Fail].err{row.err}; }
        if (sel row.ok) {
            if (row.ok.stage != at) { cnt; }
            r = row.ok.take(c, o, s);
        }
        if (sel r.err) {
            val undone: err[Fail] = restore(c, m);
            if (sel undone.err) { ret undone; }
            ret err[Fail].err{fail.in_indexed(r.err, "section", (i - 1)::u64)};
        }
    }
    ret err[Fail].ok{};
}

# write each distinct identification string to `out`, NUL-terminated, in the
# order an input first states it, interned in `a`
pub fun strings(a: *A.Allocator, c: *Consumed, out: *Sink) err[Fail] {
    var seen:  Interner  = intern.make(a);
    val r:     err[Fail] = distinct(c, ?seen, out);
    val freed: err[Fail] = intern.release(?seen);
    if (sel r.err) { ret r; }
    ret freed;
}

fun distinct(c: *Consumed, seen: *Interner, out: *Sink) err[Fail] {
    val bytes: *u8   = table.items[u8](?c.store);
    var i:     usize = 0;
    for (i < table.count[Taken](?c.taken)) {
        val t: *Taken = table.at[Taken](?c.taken, table.nth[Taken](i));
        i = i + 1;
        if (t.use != ?section.IDENTIFICATION) { cnt; }
        var start: usize = t.start;
        var k:     usize = t.start;
        for (k < t.start + t.len) {
            if (bytes[k] == 0) {
                val before: usize               = intern.count(seen);
                val n:      res[Id[Name], Fail] = intern.intern(seen, ?bytes[start], k - start);
                if (sel n.err) { ret err[Fail].err{n.err}; }
                if (intern.count(seen) != before) {
                    val w: err[Fail] = sink.bytes(out, ?bytes[start], k - start);
                    if (sel w.err) { ret w; }
                    val z: err[Fail] = sink.u8(out, 0);
                    if (sel z.err) { ret z; }
                }
                start = k + 1;
            }
            k = k + 1;
        }
    }
    ret err[Fail].ok{};
}

# the flags every section of the use `u` stated, together
pub fun flags_of(c: *Consumed, u: *Use) section.Flags {
    var f: section.Flags = 0;
    var i: usize         = 0;
    for (i < table.count[Taken](?c.taken)) {
        val t: *Taken = table.at[Taken](?c.taken, table.nth[Taken](i));
        if (t.use == u) { f = f | t.flags; }
        i = i + 1;
    }
    ret f;
}

fun dropped(c: *Consumed, o: *Object, s: *Section) err[Fail] {
    ret err[Fail].ok{};
}

# the image writer reads the section from its input, so the record keeps
# nothing of it
fun read_by_image(c: *Consumed, o: *Object, s: *Section) err[Fail] {
    ret err[Fail].ok{};
}

# the NUL-terminated strings of `s`, a zero fill being empty strings, which
# keep as one. bytes after the last NUL are refused
fun strings_of(c: *Consumed, o: *Object, s: *Section) err[Fail] {
    if (sel s.contents.zero) {
        if (s.contents.zero == 0) { ret err[Fail].ok{}; }
        ret keep(c, s.kind.use, ?NUL[0], 1, s.flags);
    }
    val b:     Bytes = object.bytes(o, ?s.contents);
    var start: usize = 0;
    var i:     usize = 0;
    for (i < b.len) {
        if (b.data[i] == 0) { start = i + 1; }
        i = i + 1;
    }
    if (start != b.len) { ret err[Fail].err{fail.at_offset(fail.malformed("an identification string is not NUL-terminated"), start::u64)}; }
    ret keep(c, s.kind.use, b.data, b.len, s.flags);
}

fun stack_of(c: *Consumed, o: *Object, s: *Section) err[Fail] {
    ret keep(c, s.kind.use, nil, 0, s.flags);
}

val NUL: [1]u8 = [1]u8{0};
