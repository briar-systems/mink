# what a link does with the sections that are not image content
#
# a section's kind names its use. a use that is placed is laid out as image
# content, and every other use the output format takes has one row in its
# linking row, keyed by the use, stating how the link takes a section of it:
# dropped, its strings merged, or read as a fact the image carries. the rows
# are declared here and the formats name the ones they take. a section of a
# use no row names is refused, naming the section and the use, so no section
# reaches an image for want of a rule. no link takes a directive yet, so an
# input carrying one is refused naming its kind. settle takes every object input's
# sections through these rows, all of an input or none, and collect never
# places them.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_equals;
use std.types.view.View;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.x86;
use mink.model.directive;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Directive;
use mink.model.object.Object;
use mink.model.object.Section;
use mink.model.section;
use mink.model.section.Use;

# what the inputs' sections that are not image content state for the output
# ---
# strings: the identification strings, each distinct one once, in the order
#          an input first states it
# stack:   the flags the stack sections state, together
pub rec Consumed {
    strings: Interner;
    stack:   section.Flags;
}

# what a consumed record held at a point, so taking an input can be undone
pub rec Mark {
    strings: usize;
    stack:   section.Flags;
}

# use:  the use the row takes
# take: takes the section `s` of `o` into the record
pub rec Row {
    use:  *Use;
    take: fun(*Consumed, *Object, *Section) err[Fail];
}

# the rows of a format, at most one per use
pub rec Uses {
    rows:  **Row;
    count: usize;
}

# nothing folds identical code yet, so which addresses are significant is
# never read and the table is dropped
pub val SIGNIFICANCE: Row = Row{use: ?section.SIGNIFICANCE, take: dropped};
pub val STRINGS:      Row = Row{use: ?section.IDENTIFICATION, take: strings_of};
pub val STACK:        Row = Row{use: ?section.STACK, take: stack_of};

fun row_of(u: *Uses, use: *Use) opt[*Row] {
    var i: usize = 0;
    for (i < u.count) {
        if (u.rows[i].use == use) { ret opt[*Row].some{u.rows[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# refuse rows that take a placed use, or two rows of one use, a defect of
# mink
pub fun check(u: *Uses) err[Fail] {
    var i: usize = 0;
    for (i < u.count) {
        if (u.rows[i].use.placed) { ret err[Fail].err{fail.about(fail.internal("a consume row takes a placed use"), u.rows[i].use.name)}; }
        var j: usize = 0;
        for (j < i) {
            if (u.rows[j].use == u.rows[i].use) { ret err[Fail].err{fail.about(fail.internal("two consume rows take one use"), u.rows[i].use.name)}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

pub fun make(a: *A.Allocator) Consumed {
    ret Consumed{strings: intern.make(a)};
}

pub fun release(c: *Consumed) err[Fail] {
    ret intern.release(?c.strings);
}

pub fun mark(c: *Consumed) Mark {
    ret Mark{strings: intern.count(?c.strings), stack: c.stack};
}

# give back everything taken since `m`
pub fun restore(c: *Consumed, m: Mark) err[Fail] {
    c.stack = m.stack;
    ret intern.truncate(?c.strings, m.strings);
}

# the row of section `s` among `u`, refused naming its use when the link has
# none
fun row_for(u: *Uses, s: *Section) res[*Row, Fail] {
    val row: opt[*Row] = row_of(u, s.kind.use);
    if (sel row.none) {
        ret res[*Row, Fail].err{fail.about(fail.unsupported("the link has no rule for a section of this use"), s.kind.use.name)};
    }
    ret res[*Row, Fail].ok{row.some};
}

# take every section of `o` whose use is not placed through its row among
# `u`, all or none: a refusal names the section by its index and leaves the
# record as it was
pub fun take(c: *Consumed, u: *Uses, o: *Object) err[Fail] {
    if (table.count[Directive](?o.directives) != 0) {
        val d: *Directive = table.at[Directive](?o.directives, table.nth[Directive](0));
        ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("the link takes no directive of this kind"), d.kind.name), "directive", 0)};
    }
    val m: Mark  = mark(c);
    var i: usize = 0;
    for (i < table.count[Section](?o.sections)) {
        val s: *Section = object.section_at(o, table.nth[Section](i));
        i = i + 1;
        if (s.kind.use.placed) { cnt; }
        val row: res[*Row, Fail] = row_for(u, s);
        var r:   err[Fail]       = err[Fail].ok{};
        if (sel row.err) { r = err[Fail].err{row.err}; }
        if (sel row.ok)  { r = row.ok.take(c, o, s); }
        if (sel r.err) {
            val undone: err[Fail] = restore(c, m);
            if (sel undone.err) { ret undone; }
            ret err[Fail].err{fail.in_indexed(r.err, "section", (i - 1)::u64)};
        }
    }
    ret err[Fail].ok{};
}

# write each identification string to `out`, NUL-terminated, in order
pub fun strings(c: *Consumed, out: *Sink) err[Fail] {
    var i: usize = 0;
    for (i < intern.count(?c.strings)) {
        val v: View      = intern.bytes_of(?c.strings, table.nth[Name](i));
        val w: err[Fail] = sink.bytes(out, v.data::*u8, v.len);
        if (sel w.err) { ret w; }
        val z: err[Fail] = sink.u8(out, 0);
        if (sel z.err) { ret z; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun dropped(c: *Consumed, o: *Object, s: *Section) err[Fail] {
    ret err[Fail].ok{};
}

# each NUL-terminated string of `s`, a zero fill being empty strings. bytes
# after the last NUL are refused
fun strings_of(c: *Consumed, o: *Object, s: *Section) err[Fail] {
    if (sel s.contents.zero) {
        if (s.contents.zero == 0) { ret err[Fail].ok{}; }
        val e: res[Id[Name], Fail] = intern.intern(?c.strings, ?WARNED[0], 0);
        if (sel e.err) { ret err[Fail].err{e.err}; }
        ret err[Fail].ok{};
    }
    val b:     Bytes = object.bytes(o, ?s.contents);
    var start: usize = 0;
    var i:     usize = 0;
    for (i < b.len) {
        if (b.data[i] == 0) {
            val r: res[Id[Name], Fail] = intern.intern(?c.strings, ?b.data[start], i - start);
            if (sel r.err) { ret err[Fail].err{r.err}; }
            start = i + 1;
        }
        i = i + 1;
    }
    if (start != b.len) { ret err[Fail].err{fail.at_offset(fail.malformed("an identification string is not NUL-terminated"), start::u64)}; }
    ret err[Fail].ok{};
}

fun stack_of(c: *Consumed, o: *Object, s: *Section) err[Fail] {
    c.stack = c.stack | s.flags;
    ret err[Fail].ok{};
}

val WARNED: [3]u8 = [3]u8{0x6f, 0x6b, 0};

# a section of `o` of kind `k` holding `n` bytes at `p`
fun add(o: *Object, k: *section.Kind, p: *u8, n: usize) err[Fail] {
    val c: res[Contents, Fail] = object.own(o, p, n);
    if (sel c.err) { ret err[Fail].err{c.err}; }
    val s: res[Id[Section], Fail] = object.add_section(o, Section{kind: k, flags: k.flags, align: 1, contents: c.ok, disposition: ?section.ROOT});
    if (sel s.err) { ret err[Fail].err{s.err}; }
    ret err[Fail].ok{};
}

val ROWS:  [3]*Row = [3]*Row{?SIGNIFICANCE, ?STRINGS, ?STACK};
val TWICE: [2]*Row = [2]*Row{?STACK, ?STACK};

test consume__a_section_of_a_use_with_no_rule_is_refused_naming_it {
    var uses:  Uses      = Uses{rows: ?ROWS[0], count: 3};
    val sound: err[Fail] = check(?uses);
    if (sel sound.err) { ret 1; }
    var twice: Uses      = Uses{rows: ?TWICE[0], count: 2};
    val bad:   err[Fail] = check(?twice);
    if (!sel bad.err) { ret 1; }
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);
    var o: Object       = object.make(a, ?x86.X86_64);
    var c: Consumed     = make(a);
    val s: err[Fail]    = add(?o, ?section.COMMENT_STRINGS, ?WARNED[0], 3);
    val w: err[Fail]    = add(?o, ?section.LINK_WARNING, ?WARNED[0], 3);
    if (sel s.err || sel w.err) { ret 1; }

    # the warning has no row, so the input is refused naming it and its use,
    # and the strings before it are not taken
    val r: err[Fail] = take(?c, ?uses, ?o);
    if (!sel r.err)                                 { ret 2; }
    if (!sel r.err.cause.unsupported)               { ret 2; }
    if (!str_equals(r.err.subject, "link warning")) { ret 2; }
    if (!str_equals(r.err.at.record, "section"))    { ret 2; }
    if (!r.err.at.indexed || r.err.at.index != 1)   { ret 2; }
    if (intern.count(?c.strings) != 0)              { ret 3; }

    val r1: err[Fail] = release(?c);
    val r2: err[Fail] = object.release(?o);
    if (sel r1.err || sel r2.err) { ret 4; }
    if (T.live_count(?t) != 0)    { ret 4; }
    T.dnit(?t);
    ret 0;
}

test consume__an_input_carrying_a_directive_is_refused_naming_its_kind {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator        = T.allocator_of(?t);
    var o:    Object              = object.make(a, ?x86.X86_64);
    var c:    Consumed            = make(a);
    var uses: Uses                = Uses{rows: ?ROWS[0], count: 3};
    val n:    res[Id[Name], Fail] = object.name_str(?o, "m");
    if (sel n.err) { ret 1; }
    val d: res[Id[Directive], Fail] = object.add_directive(?o, Directive{kind: ?directive.LIBRARY, text: n.ok, symbol: opt[Id[Name]].none{}});
    if (sel d.err) { ret 1; }

    val r: err[Fail] = take(?c, ?uses, ?o);
    if (!sel r.err)                                { ret 2; }
    if (!sel r.err.cause.unsupported)              { ret 2; }
    if (!str_equals(r.err.subject, "library"))     { ret 2; }
    if (!str_equals(r.err.at.record, "directive")) { ret 2; }

    val r1: err[Fail] = release(?c);
    val r2: err[Fail] = object.release(?o);
    if (sel r1.err || sel r2.err) { ret 3; }
    if (T.live_count(?t) != 0)    { ret 3; }
    T.dnit(?t);
    ret 0;
}
