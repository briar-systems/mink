# what a link does with the sections that are not image content
#
# a section's kind names its use. a use that is placed is laid out as image
# content, and every other use the output format takes has one row in its
# linking row, keyed by the use, stating how the link takes a section of it
# and the stage of the link that takes it: dropped, kept as what the section
# states for a reader of the record, as its strings or its flags, or left to
# the image writer, which reads it from its input. the
# rows are declared here and the formats name the ones they take, and a format
# declares a row whose take reads its own naming, as ELF names the symbol a
# link warning is about by the warning section's name. a section of
# a use no row names is refused, naming the section and the use, so no section
# reaches an image for want of a rule. a link takes the directives of the
# kinds its format's row lists, which its image writer reads from the inputs,
# and an input carrying a directive of another kind is refused naming its
# kind. settle takes every object
# input's sections through the rows of its stage, all of an input or none, and
# collect never places them. what the rows keep is one table of what each
# section stated, in the order the link took it, so taking an input is undone
# by cutting the table back. once the link is done, report writes a note
# for each link warning a live input calls for.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view.View;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.x86;
use mink.catalog.kind;
use mink.link.input;
use mink.link.input.Input;
use mink.link.input.Inputs;
use mink.link.resolve;
use mink.link.resolve.Resolved;
use mink.model.directive;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Directive;
use mink.model.object.Object;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.section;
use mink.model.section.Use;

# a moment of the link at which consume rows take their sections
pub rec Stage {
    name: str;
}

# as settle takes each object input
pub val SETTLE: Stage = Stage{name: "settle"};
# as the image writer reads the sections from the inputs, so no phase takes
# them into the record
pub val IMAGE: Stage = Stage{name: "image"};

# what one section that is not image content stated, as its row kept it
# ---
# use:   the section's use
# start: where its bytes start in the record's store
# len:   how many bytes it kept
# flags: the flags it carried
# input: the input whose section it was
# about: how many bytes after the kept ones name the symbol a link warning is
#        about, none for a section about no symbol
pub rec Taken {
    use:   *Use;
    start: usize;
    len:   usize;
    flags: section.Flags;
    input: Id[Input];
    about: opt[usize];
}

# what the inputs' sections that are not image content state for the output
# ---
# taken: each section a row kept, in the order the link took it
# store: the bytes the taken sections kept
pub rec Consumed {
    taken: Table[Taken];
    store: Table[u8];
}

# what a consumed record held at a point, so taking an input can be undone
pub rec Mark {
    taken: usize;
    store: usize;
}

# use:   the use the row takes
# stage: the stage of the link that takes a section of the use
# take:  takes the section `s` of `o` into the record
pub rec Row {
    use:   *Use;
    stage: *Stage;
    take:  fun(*Consumed, *Object, *Section) err[Fail];
}

# the rows of a format, at most one per use, and the directive kinds its link
# takes
pub rec Uses {
    rows:            **Row;
    count:           usize;
    directives:      **directive.Kind;
    directive_count: usize;
}

# whether `u` takes a directive of the kind `k`
fun takes(u: *Uses, k: *directive.Kind) bool {
    var i: usize = 0;
    for (i < u.directive_count) {
        if (u.directives[i] == k) { ret true; }
        i = i + 1;
    }
    ret false;
}

# nothing folds identical code yet, so which addresses are significant is
# never read and the table is dropped
pub val SIGNIFICANCE: Row = Row{use: ?section.SIGNIFICANCE, stage: ?SETTLE, take: dropped};
pub val STRINGS:      Row = Row{use: ?section.IDENTIFICATION, stage: ?SETTLE, take: strings_of};
pub val STACK:        Row = Row{use: ?section.STACK, stage: ?SETTLE, take: stack_of};
# the image writer reads the inputs' unwind records to build the image's own
# unwind table
pub val UNWIND_RECORDS: Row = Row{use: ?section.CONSUMED_UNWIND, stage: ?IMAGE, take: read_by_image};

fun row_of(u: *Uses, use: *Use) opt[*Row] {
    var i: usize = 0;
    for (i < u.count) {
        if (u.rows[i].use == use) { ret opt[*Row].some{u.rows[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# refuse rows that take a placed use, or two rows of one use, a defect of
# mink
pub fun check(u: *Uses) err[Fail] {
    var i: usize = 0;
    for (i < u.count) {
        if (u.rows[i].use.placed)   { ret err[Fail].err{fail.about(fail.internal("a consume row takes a placed use"), u.rows[i].use.name)}; }
        if (u.rows[i].stage == nil) { ret err[Fail].err{fail.about(fail.internal("a consume row names no stage"), u.rows[i].use.name)}; }
        var j: usize = 0;
        for (j < i) {
            if (u.rows[j].use == u.rows[i].use) { ret err[Fail].err{fail.about(fail.internal("two consume rows take one use"), u.rows[i].use.name)}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

pub fun make(a: *A.Allocator) Consumed {
    ret Consumed{taken: table.make[Taken](a), store: table.make[u8](a)};
}

pub fun release(c: *Consumed) err[Fail] {
    val t: err[Fail] = table.release[Taken](?c.taken);
    val s: err[Fail] = table.release[u8](?c.store);
    if (sel t.err) { ret t; }
    ret s;
}

pub fun mark(c: *Consumed) Mark {
    ret Mark{taken: table.count[Taken](?c.taken), store: table.count[u8](?c.store)};
}

# give back everything taken since `m`
pub fun restore(c: *Consumed, m: Mark) err[Fail] {
    table.truncate[Taken](?c.taken, m.taken);
    table.truncate[u8](?c.store, m.store);
    ret err[Fail].ok{};
}

# keep the `n` bytes at `p` and the flags `flags` a section of use `u` stated
fun keep(c: *Consumed, u: *Use, p: *u8, n: usize, flags: section.Flags) err[Fail] {
    val start: usize     = table.count[u8](?c.store);
    val s:     err[Fail] = stored(c, p, n);
    if (sel s.err) { ret s; }
    val t: res[Id[Taken], Fail] = table.push[Taken](?c.taken, Taken{use: u, start: start, len: n, flags: flags, about: opt[usize].none{}});
    if (sel t.err) { ret err[Fail].err{t.err}; }
    ret err[Fail].ok{};
}

# append the `n` bytes at `p` to the record's store
fun stored(c: *Consumed, p: *u8, n: usize) err[Fail] {
    val start: usize             = table.count[u8](?c.store);
    val grown: res[Id[u8], Fail] = table.grow[u8](?c.store, n);
    if (sel grown.err) { ret err[Fail].err{grown.err}; }
    var i: usize = 0;
    for (i < n) {
        table.items[u8](?c.store)[start + i] = p[i];
        i                                    = i + 1;
    }
    ret err[Fail].ok{};
}

# keep the link warning `s` of `o`: its text, up to its first NUL, and the
# name of the symbol it is about, none for a warning about its input, which
# the link reports when the input is linked
pub fun warning(c: *Consumed, o: *Object, s: *Section, about: opt[Bytes]) err[Fail] {
    val b: Bytes = object.bytes(o, ?s.contents);
    var n: usize = 0;
    for (n < b.len) {
        if (b.data[n] == 0) { brk; }
        n = n + 1;
    }
    val m:    Mark      = mark(c);
    val kept: err[Fail] = keep(c, s.kind.use, b.data, n, s.flags);
    if (sel kept.err)   { ret kept; }
    if (sel about.none) { ret err[Fail].ok{}; }
    val named: err[Fail] = stored(c, about.some.data, about.some.len);
    if (sel named.err) {
        val undone: err[Fail] = restore(c, m);
        if (sel undone.err) { ret undone; }
        ret named;
    }
    val t: *Taken = table.at[Taken](?c.taken, table.nth[Taken](m.taken));
    t.about = opt[usize].some{about.some.len};
    ret err[Fail].ok{};
}

# the row of section `s` among `u`, refused naming its use when the link has
# none
fun row_for(u: *Uses, s: *Section) res[*Row, Fail] {
    val row: opt[*Row] = row_of(u, s.kind.use);
    if (sel row.none) {
        ret res[*Row, Fail].err{fail.about(fail.unsupported("the link has no rule for a section of this use"), s.kind.use.name)};
    }
    ret res[*Row, Fail].ok{row.some};
}

# take every section of `o`, the input `id`, whose use is not placed and
# whose row among `u` is of the stage `at`, all or none: a refusal names the
# section by its index and leaves the record as it was
pub fun take(c: *Consumed, u: *Uses, o: *Object, id: Id[Input], at: *Stage) err[Fail] {
    var k: usize = 0;
    for (k < table.count[Directive](?o.directives)) {
        val d: *Directive = table.at[Directive](?o.directives, table.nth[Directive](k));
        if (!takes(u, d.kind)) { ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("the link takes no directive of this kind"), d.kind.name), "directive", k::u64)}; }
        k = k + 1;
    }
    val m: Mark  = mark(c);
    var i: usize = 0;
    for (i < table.count[Section](?o.sections)) {
        val s: *Section = object.section_at(o, table.nth[Section](i));
        i = i + 1;
        if (s.kind.use.placed) { cnt; }
        val row: res[*Row, Fail] = row_for(u, s);
        var r:   err[Fail]       = err[Fail].ok{};
        if (sel row.err) { r = err[Fail].err{row.err}; }
        if (sel row.ok) {
            if (row.ok.stage != at) { cnt; }
            r = row.ok.take(c, o, s);
        }
        if (sel r.err) {
            val undone: err[Fail] = restore(c, m);
            if (sel undone.err) { ret undone; }
            ret err[Fail].err{fail.in_indexed(r.err, "section", (i - 1)::u64)};
        }
    }
    var j: usize = m.taken;
    for (j < table.count[Taken](?c.taken)) {
        val t: *Taken = table.at[Taken](?c.taken, table.nth[Taken](j));
        t.input = id;
        j       = j + 1;
    }
    ret err[Fail].ok{};
}

# write to `out` a note for each link warning a live input of `inputs`, the
# link's object inputs and the archive members it loaded, calls for: a
# warning about its input as the input is linked, and one about a symbol when
# a live input refers to the symbol, naming the first that does, as GNU ld
# warns (warning_callback in ld/ldmain.c). `names` and `r` are the link's
pub fun report(c: *Consumed, inputs: *Inputs, names: *Interner, r: *Resolved, out: *Sink) err[Fail] {
    var refers: Table[u32] = table.make[u32](c.store.a);
    val w:      err[Fail]  = warned(c, inputs, names, r, ?refers, out);
    val freed:  err[Fail]  = table.release[u32](?refers);
    if (sel w.err) { ret w; }
    ret freed;
}

fun warned(c: *Consumed, inputs: *Inputs, names: *Interner, r: *Resolved, refers: *Table[u32], out: *Sink) err[Fail] {
    val bytes: *u8   = table.items[u8](?c.store);
    var i:     usize = 0;
    for (i < table.count[Taken](?c.taken)) {
        val t: *Taken = table.at[Taken](?c.taken, table.nth[Taken](i));
        i = i + 1;
        if (t.use != ?section.WARNING) { cnt; }
        val text: View = View{data: ?bytes[t.start], len: t.len};
        if (sel t.about.none) {
            val w: err[Fail] = diag.warning(Location{file: input.at(inputs, t.input).name}, opt[View].none{}, text, out);
            if (sel w.err) { ret w; }
            cnt;
        }
        val name: View = View{data: ?bytes[t.start + t.len], len: t.about.some};
        if (table.count[u32](refers) == 0) {
            val built: err[Fail] = referrers(inputs, names, r, refers);
            if (sel built.err) { ret built; }
        }
        val id: opt[Id[Name]] = intern.find(names, name.data, name.len);
        if (sel id.none) { cnt; }
        val by: u32 = table.items[u32](refers)[id.some.index];
        if (by == 0) { cnt; }
        val at: Location  = Location{file: input.at(inputs, Id[Input]{index: by - 1}).name};
        val w:  err[Fail] = diag.warning(at, opt[View].some{name}, text, out);
        if (sel w.err) { ret w; }
    }
    ret err[Fail].ok{};
}

# fill `refers`, indexed by the link's name id, with the first live input
# that refers to each name, plus one, zero for a name none refers to
fun referrers(inputs: *Inputs, names: *Interner, r: *Resolved, refers: *Table[u32]) err[Fail] {
    val grown: res[Id[u32], Fail] = table.grow[u32](refers, intern.count(names));
    if (sel grown.err) { ret err[Fail].err{grown.err}; }
    var i: usize = 0;
    for (i < input.count(inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(inputs, id);
        i = i + 1;
        if (o == nil || !(sel o.library.none) || resolve.library(r, id)) { cnt; }
        var k: usize = 0;
        for (k < table.count[Symbol](?o.symbols)) {
            val sid: Id[Symbol] = table.nth[Symbol](k);
            k = k + 1;
            val sym: *Symbol = object.symbol_at(o, sid);
            if (!(sel sym.def.undefined)) { cnt; }
            val ln: opt[Id[Name]] = resolve.link_name(r, id, sid);
            if (sel ln.none) { cnt; }
            val slot: *u32 = ?table.items[u32](refers)[ln.some.index];
            if (@slot == 0) { @slot = id.index + 1; }
        }
    }
    ret err[Fail].ok{};
}

# write each distinct identification string to `out`, NUL-terminated, in the
# order an input first states it, interned in `a`
pub fun strings(a: *A.Allocator, c: *Consumed, out: *Sink) err[Fail] {
    var seen:  Interner  = intern.make(a);
    val r:     err[Fail] = distinct(c, ?seen, out);
    val freed: err[Fail] = intern.release(?seen);
    if (sel r.err) { ret r; }
    ret freed;
}

fun distinct(c: *Consumed, seen: *Interner, out: *Sink) err[Fail] {
    val bytes: *u8   = table.items[u8](?c.store);
    var i:     usize = 0;
    for (i < table.count[Taken](?c.taken)) {
        val t: *Taken = table.at[Taken](?c.taken, table.nth[Taken](i));
        i = i + 1;
        if (t.use != ?section.IDENTIFICATION) { cnt; }
        var start: usize = t.start;
        var k:     usize = t.start;
        for (k < t.start + t.len) {
            if (bytes[k] == 0) {
                val before: usize               = intern.count(seen);
                val n:      res[Id[Name], Fail] = intern.intern(seen, ?bytes[start], k - start);
                if (sel n.err) { ret err[Fail].err{n.err}; }
                if (intern.count(seen) != before) {
                    val w: err[Fail] = sink.bytes(out, ?bytes[start], k - start);
                    if (sel w.err) { ret w; }
                    val z: err[Fail] = sink.u8(out, 0);
                    if (sel z.err) { ret z; }
                }
                start = k + 1;
            }
            k = k + 1;
        }
    }
    ret err[Fail].ok{};
}

# the flags every section of the use `u` stated, together
pub fun flags_of(c: *Consumed, u: *Use) section.Flags {
    var f: section.Flags = 0;
    var i: usize         = 0;
    for (i < table.count[Taken](?c.taken)) {
        val t: *Taken = table.at[Taken](?c.taken, table.nth[Taken](i));
        if (t.use == u) { f = f | t.flags; }
        i = i + 1;
    }
    ret f;
}

fun dropped(c: *Consumed, o: *Object, s: *Section) err[Fail] {
    ret err[Fail].ok{};
}

# the image writer reads the section from its input, so the record keeps
# nothing of it
fun read_by_image(c: *Consumed, o: *Object, s: *Section) err[Fail] {
    ret err[Fail].ok{};
}

# the NUL-terminated strings of `s`, a zero fill being empty strings, which
# keep as one. bytes after the last NUL are refused
fun strings_of(c: *Consumed, o: *Object, s: *Section) err[Fail] {
    if (sel s.contents.zero) {
        if (s.contents.zero == 0) { ret err[Fail].ok{}; }
        ret keep(c, s.kind.use, ?NUL[0], 1, s.flags);
    }
    val b:     Bytes = object.bytes(o, ?s.contents);
    var start: usize = 0;
    var i:     usize = 0;
    for (i < b.len) {
        if (b.data[i] == 0) { start = i + 1; }
        i = i + 1;
    }
    if (start != b.len) { ret err[Fail].err{fail.at_offset(fail.malformed("an identification string is not NUL-terminated"), start::u64)}; }
    ret keep(c, s.kind.use, b.data, b.len, s.flags);
}

fun stack_of(c: *Consumed, o: *Object, s: *Section) err[Fail] {
    ret keep(c, s.kind.use, nil, 0, s.flags);
}

val NUL: [1]u8 = [1]u8{0};

val WARNED: [3]u8 = [3]u8{0x6f, 0x6b, 0};

# a section of `o` of kind `k` holding `n` bytes at `p`
fun add(o: *Object, k: *section.Kind, p: *u8, n: usize) err[Fail] {
    val c: res[Contents, Fail] = object.own(o, p, n);
    if (sel c.err) { ret err[Fail].err{c.err}; }
    val s: res[Id[Section], Fail] = object.add_section(o, Section{kind: k, flags: k.flags, align: 1, contents: c.ok, disposition: ?section.ROOT});
    if (sel s.err) { ret err[Fail].err{s.err}; }
    ret err[Fail].ok{};
}

val ROWS:  [3]*Row = [3]*Row{?SIGNIFICANCE, ?STRINGS, ?STACK};
val TWICE: [2]*Row = [2]*Row{?STACK, ?STACK};

test consume__a_section_of_a_use_with_no_rule_is_refused_naming_it {
    var uses:  Uses      = Uses{rows: ?ROWS[0], count: 3};
    val sound: err[Fail] = check(?uses);
    if (sel sound.err) { ret 1; }
    var twice: Uses      = Uses{rows: ?TWICE[0], count: 2};
    val bad:   err[Fail] = check(?twice);
    if (!sel bad.err) { ret 1; }
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);
    var o: Object       = object.make(a, ?x86.X86_64, ?kind.RELOCATABLE);
    var c: Consumed     = make(a);
    val s: err[Fail]    = add(?o, ?section.COMMENT_STRINGS, ?WARNED[0], 3);
    val w: err[Fail]    = add(?o, ?section.LINK_WARNING, ?WARNED[0], 3);
    if (sel s.err || sel w.err) { ret 1; }

    # the warning has no row, so the input is refused naming it and its use,
    # and the strings before it are not taken
    val r: err[Fail] = take(?c, ?uses, ?o, table.nth[Input](0), ?SETTLE);
    if (!sel r.err)                                 { ret 2; }
    if (!sel r.err.cause.unsupported)               { ret 2; }
    if (!str_equals(r.err.subject, "link warning")) { ret 2; }
    if (!str_equals(r.err.at.record, "section"))    { ret 2; }
    if (!r.err.at.indexed || r.err.at.index != 1)   { ret 2; }
    if (table.count[Taken](?c.taken) != 0)          { ret 3; }

    val r1: err[Fail] = release(?c);
    val r2: err[Fail] = object.release(?o);
    if (sel r1.err || sel r2.err) { ret 4; }
    if (T.live_count(?t) != 0)    { ret 4; }
    T.dnit(?t);
    ret 0;
}

# a stage no phase runs yet, for a test of a row of another stage
val LATER:       Stage   = Stage{name: "later"};
val LATER_STACK: Row     = Row{use: ?section.STACK, stage: ?LATER, take: stack_of};
val STAGED:      [2]*Row = [2]*Row{?STRINGS, ?LATER_STACK};

test consume__a_row_takes_its_sections_only_at_its_stage {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator = T.allocator_of(?t);
    var o:    Object       = object.make(a, ?x86.X86_64, ?kind.RELOCATABLE);
    var c:    Consumed     = make(a);
    var uses: Uses         = Uses{rows: ?STAGED[0], count: 2};
    val s:    err[Fail]    = add(?o, ?section.COMMENT_STRINGS, ?WARNED[0], 3);
    val k:    err[Fail]    = add(?o, ?section.STACK_NOTE, ?WARNED[0], 1);
    if (sel s.err || sel k.err) { ret 1; }

    # settle takes the strings and leaves the stack to its own stage
    val r: err[Fail] = take(?c, ?uses, ?o, table.nth[Input](0), ?SETTLE);
    if (sel r.err)                                                                     { ret 2; }
    if (table.count[Taken](?c.taken) != 1)                                             { ret 2; }
    if (table.at[Taken](?c.taken, table.nth[Taken](0)).use != ?section.IDENTIFICATION) { ret 2; }
    val later: err[Fail] = take(?c, ?uses, ?o, table.nth[Input](0), ?LATER);
    if (sel later.err)                     { ret 3; }
    if (table.count[Taken](?c.taken) != 2) { ret 3; }

    val r1: err[Fail] = release(?c);
    val r2: err[Fail] = object.release(?o);
    if (sel r1.err || sel r2.err) { ret 4; }
    if (T.live_count(?t) != 0)    { ret 4; }
    T.dnit(?t);
    ret 0;
}

val TEST_DIRECTIVES: [1]*directive.Kind = [1]*directive.Kind{?directive.EXPORT};

test consume__an_input_carrying_a_directive_of_a_kind_the_link_does_not_take_is_refused_naming_its_kind {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator        = T.allocator_of(?t);
    var o:    Object              = object.make(a, ?x86.X86_64, ?kind.RELOCATABLE);
    var c:    Consumed            = make(a);
    var uses: Uses                = Uses{rows: ?ROWS[0], count: 3, directives: ?TEST_DIRECTIVES[0], directive_count: 1};
    val n:    res[Id[Name], Fail] = object.name_str(?o, "m");
    if (sel n.err) { ret 1; }
    val x: res[Id[Directive], Fail] = object.add_directive(?o, Directive{kind: ?directive.EXPORT, text: n.ok, symbol: opt[Id[Name]].some{n.ok}});
    if (sel x.err) { ret 1; }
    val d: res[Id[Directive], Fail] = object.add_directive(?o, Directive{kind: ?directive.LIBRARY, text: n.ok, symbol: opt[Id[Name]].none{}});
    if (sel d.err) { ret 1; }

    # the export is taken, the library refused

    val r: err[Fail] = take(?c, ?uses, ?o, table.nth[Input](0), ?SETTLE);
    if (!sel r.err)                                { ret 2; }
    if (!sel r.err.cause.unsupported)              { ret 2; }
    if (!str_equals(r.err.subject, "library"))     { ret 2; }
    if (!str_equals(r.err.at.record, "directive")) { ret 2; }

    val r1: err[Fail] = release(?c);
    val r2: err[Fail] = object.release(?o);
    if (sel r1.err || sel r2.err) { ret 3; }
    if (T.live_count(?t) != 0)    { ret 3; }
    T.dnit(?t);
    ret 0;
}
