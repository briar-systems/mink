# the contract of a synthesizer, the one way the link makes an input itself
#
# a synthesizer is a row in a table. it reads the link so far through a
# context and either makes one more neutral object or declines. what it makes
# is appended to the input set as an ordinary input, owned by the set from
# then on, so resolution and garbage collection treat its definitions like any
# other object's. declining appends nothing. a refusal or a malformed result
# is a failure, never a declined synthesizer. a synthesizer applies from the
# capabilities of the architecture and the output kind, never from which
# format or architecture it is.
#
# a row declares the stage it runs at, a row of the stage table below, so one
# table covers every moment the link makes inputs. the synthesize phase runs
# the rows of a stage at that stage's moment, in table order, and an input a
# stage makes after resolution is resolved without resolving again the inputs
# already bound.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.x86;
use mink.catalog.os.Host;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.format.contract.Model;
use mink.link.collect.Live;
use mink.link.input;
use mink.link.input.Appended;
use mink.link.input.Input;
use mink.link.input.Inputs;
use mink.link.resolve.Resolved;
use mink.link.settle.Settled;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Section;
use mink.model.section;

# a moment of the link at which synthesizers run
# ---
# name:     the moment, for a diagnostic
# resolves: what the stage makes is resolved once the stage ends, since
#           resolution has already run. a stage before resolution leaves it
#           to the resolve phase
# keeps:    what the stage makes survives garbage collection whole, since
#           collection has already run
pub rec Stage {
    name:     str;
    resolves: bool;
    keeps:    bool;
}

pub val BEFORE_RESOLVE: Stage = Stage{name: "before resolve", resolves: false, keeps: false};
pub val AFTER_RESOLVE:  Stage = Stage{name: "after resolve", resolves: true, keeps: false};
pub val AFTER_COLLECT:  Stage = Stage{name: "after collect", resolves: true, keeps: true};

pub val STAGE_COUNT: usize = 3;

# the stages in the order the link reaches them
pub val STAGES: [STAGE_COUNT]*Stage = [STAGE_COUNT]*Stage{?BEFORE_RESOLVE, ?AFTER_RESOLVE, ?AFTER_COLLECT};

# where `s` stands in the stage table
pub fun position(s: *Stage) usize {
    var i: usize = 0;
    for (i < STAGE_COUNT) {
        if (STAGES[i] == s) { ret i; }
        i = i + 1;
    }
    ret STAGE_COUNT;
}

# what a synthesizer reads of the link so far, which it does not change
# ---
# inputs:   the inputs so far, those earlier synthesizers made included
# names:    the link's names, shared by every input
# settled:  the settled facts
# resolved: what resolution answered, nil at the stages before it
# live:     what survived garbage collection, nil at the stages before it
# kind:     the output kind
# arch:     the architecture
# host:     what the system says for the architecture
pub rec Context {
    inputs:   *Inputs;
    names:    *Interner;
    settled:  *Settled;
    resolved: *Resolved;
    live:     *Live;
    kind:     *Kind;
    arch:     *Arch;
    host:     *Host;
}

# name:       what it makes, which names the input and any failure
# stage:      the moment it runs at
# needs:      the architecture capabilities it needs to apply
# kinds:      the output kinds it applies to
# kind_count: how many
# make:       fill the empty object with what the link needs, true when it
#             made something and false when it declines
pub rec Row {
    name:       str;
    stage:      *Stage;
    needs:      arch.Caps;
    kinds:      **Kind;
    kind_count: usize;
    make:       fun(*Context, *Object) res[bool, Fail];
}

# whether the row applies to a link of this context
pub fun applies(r: *Row, c: *Context) bool {
    if (!arch.has(c.arch, r.needs)) { ret false; }
    var i: usize = 0;
    for (i < r.kind_count) {
        if (r.kinds[i] == c.kind) { ret true; }
        i = i + 1;
    }
    ret false;
}

# run each of the `count` rows at `rows` that declares `stage` and applies, in
# order, appending what it makes to the context's inputs
pub fun apply(c: *Context, rows: **Row, count: usize, stage: *Stage) res[Appended, Fail] {
    val first: usize = input.count(c.inputs);
    var i:     usize = 0;
    for (i < count) {
        val r: *Row = rows[i];
        if (r.stage == stage && applies(r, c)) {
            val e: err[Fail] = synthesize(c, r);
            if (sel e.err) { ret res[Appended, Fail].err{e.err}; }
        }
        i = i + 1;
    }
    ret res[Appended, Fail].ok{Appended{first: first, count: input.count(c.inputs) - first}};
}

fun synthesize(c: *Context, r: *Row) err[Fail] {
    var made: Object          = object.make(c.inputs.a, c.arch);
    val m:    res[bool, Fail] = r.make(c, ?made);
    if (sel m.err) {
        object.release(?made);
        ret err[Fail].err{fail.in_record(m.err, r.name)};
    }
    if (!m.ok) { ret object.release(?made); }
    val taken: res[Id[Input], Fail] = input.take(c.inputs, r.name, made, opt[Id[Model]].none{});
    if (sel taken.err) { ret err[Fail].err{fail.in_record(taken.err, r.name)}; }
    ret err[Fail].ok{};
}

fun make_one(c: *Context, o: *Object) res[bool, Fail] {
    val nm: res[Id[Name], Fail] = object.name_str(o, ".made");
    if (sel nm.err) { ret res[bool, Fail].err{nm.err}; }
    val s: res[Id[Section], Fail] = object.add_section(o, Section{name: opt[Id[Name]].some{nm.ok}, kind: ?section.DATA, flags: section.DATA.flags, align: 8});
    if (sel s.err) { ret res[bool, Fail].err{s.err}; }
    ret res[bool, Fail].ok{true};
}

fun make_none(c: *Context, o: *Object) res[bool, Fail] {
    val nm: res[Id[Name], Fail] = object.name_str(o, ".unused");
    if (sel nm.err) { ret res[bool, Fail].err{nm.err}; }
    ret res[bool, Fail].ok{false};
}

#[testing]
pub fun failed(e: err[Fail]) bool {
    ret sel e.err;
}

val ALL: [6]*Kind = [6]*Kind{?output.RELOCATABLE, ?output.STATIC, ?output.DYNAMIC, ?output.PIE, ?output.SHARED, ?output.MODULE};
val ONE: [1]*Kind = [1]*Kind{?output.STATIC};

val MAKES:    Row = Row{name: "made", stage: ?BEFORE_RESOLVE, needs: arch.ADDRESSED, kinds: ?ALL[0], kind_count: 6, make: make_one};
val DECLINES: Row = Row{name: "decline", stage: ?BEFORE_RESOLVE, needs: 0, kinds: ?ALL[0], kind_count: 6, make: make_none};
val SKIPPED:  Row = Row{name: "skipped", stage: ?BEFORE_RESOLVE, needs: arch.INDEXED, kinds: ?ALL[0], kind_count: 6, make: make_one};
val OTHER:    Row = Row{name: "other", stage: ?BEFORE_RESOLVE, needs: 0, kinds: ?ONE[0], kind_count: 1, make: make_one};
val LATER:    Row = Row{name: "later", stage: ?AFTER_RESOLVE, needs: 0, kinds: ?ALL[0], kind_count: 6, make: make_one};
val LATEST:   Row = Row{name: "latest", stage: ?AFTER_COLLECT, needs: 0, kinds: ?ALL[0], kind_count: 6, make: make_one};
val THEN:     Row = Row{name: "then", stage: ?AFTER_RESOLVE, needs: 0, kinds: ?ALL[0], kind_count: 6, make: make_one};

test synthesizer__rows_run_at_their_stage_in_table_order {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var inputs: Inputs   = input.make(T.allocator_of(?t));
    var names:  Interner = intern.make(T.allocator_of(?t));
    var c:      Context  = Context{inputs: ?inputs, names: ?names, kind: ?output.PIE, arch: ?x86.X86_64};
    val rows:   [7]*Row  = [7]*Row{?SKIPPED, ?THEN, ?OTHER, ?LATEST, ?MAKES, ?DECLINES, ?LATER};

    # a row that does not apply to the link makes nothing at its stage, and a
    # stage runs only its own rows
    val got: res[Appended, Fail] = apply(?c, ?rows[0], 7, ?BEFORE_RESOLVE);
    if (sel got.err)                            { ret 1; }
    if (got.ok.first != 0 || got.ok.count != 1) { ret 1; }
    if (input.count(?inputs) != 1)              { ret 1; }
    val e: *Input = input.at(?inputs, table.nth[Input](0));
    if (!str_equals(e.name, "made") || sel e.model.some) { ret 1; }
    if (!sel e.content.object)                           { ret 1; }
    if (!sel e.content.object.owned)                     { ret 1; }
    val o: *Object = input.object_of(?inputs, table.nth[Input](0));
    if (table.count[Section](?o.sections) != 1) { ret 1; }

    val after: res[Appended, Fail] = apply(?c, ?rows[0], 7, ?AFTER_RESOLVE);
    if (sel after.err)                                                     { ret 1; }
    if (after.ok.first != 1 || after.ok.count != 2)                        { ret 1; }
    if (!str_equals(input.at(?inputs, table.nth[Input](1)).name, "then"))  { ret 1; }
    if (!str_equals(input.at(?inputs, table.nth[Input](2)).name, "later")) { ret 1; }

    val last: res[Appended, Fail] = apply(?c, ?rows[0], 7, ?AFTER_COLLECT);
    if (sel last.err)                                                    { ret 1; }
    if (last.ok.first != 3 || last.ok.count != 1)                        { ret 1; }
    if (position(?BEFORE_RESOLVE) != 0 || position(?AFTER_COLLECT) != 2) { ret 1; }

    if (failed(input.release(?inputs))) { ret 1; }
    if (failed(intern.release(?names))) { ret 1; }
    if (T.live_count(?t) != 0)          { ret 1; }
    T.dnit(?t);
    ret 0;
}

test synthesizer__a_declining_row_appends_nothing {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var inputs: Inputs   = input.make(T.allocator_of(?t));
    var names:  Interner = intern.make(T.allocator_of(?t));
    var c:      Context  = Context{inputs: ?inputs, names: ?names, kind: ?output.PIE, arch: ?x86.X86_64};
    val rows:   [1]*Row  = [1]*Row{?DECLINES};

    val got: res[Appended, Fail] = apply(?c, ?rows[0], 1, ?BEFORE_RESOLVE);
    if (sel got.err)               { ret 1; }
    if (got.ok.count != 0)         { ret 1; }
    if (input.count(?inputs) != 0) { ret 1; }

    if (failed(input.release(?inputs))) { ret 1; }
    if (T.live_count(?t) != 0)          { ret 1; }
    T.dnit(?t);
    ret 0;
}
