# what an image exports of its own definitions
#
# an output whose kind exports exports what its format's link chooses. a
# format whose link exports by directive, as a PE DLL and a wasm module do,
# exports every definition an object input's export directive names, since
# its symbols carry no visibility that says so. any other exports every
# definition whose visibility shows it, as an ELF or Mach-O library does,
# where resolution has read each export directive as the default visibility
# of the name it is about, and refuses a directive exporting a symbol by
# another name than its own, which such a format has no form for. a
# forwarder exports no definition of the image, which only a format whose
# link exports by directive takes. a directive naming what no object input
# defines is refused. collection roots what this chooses and the dynamic phase
# exports it, so the choice is made here once.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.link.input;
use mink.link.input.Input;
use mink.link.input.Inputs;
use mink.link.resolve;
use mink.link.resolve.Binding;
use mink.link.resolve.Resolved;
use mink.model.directive;
use mink.model.object;
use mink.model.object.Directive;
use mink.model.object.Object;
use mink.model.symbol;

# whether each binding of `resolved` is a definition an output of kind `k`
# exports into `out`, by binding, which holds nothing before. `directed` says
# the format's link exports by directive rather than by visibility
pub fun exported(inputs: *Inputs, names: *Interner, resolved: *Resolved, k: *Kind, directed: bool, out: *Table[bool]) err[Fail] {
    val count: usize = table.count[Binding](?resolved.bindings);
    if (count != 0) {
        val g: res[Id[bool], Fail] = table.grow[bool](out, count);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    if (!output.has(k, output.EXPORTS)) { ret err[Fail].ok{}; }
    if (!directed) {
        var i: usize = 0;
        for (i < count) {
            val b: *Binding = table.at[Binding](?resolved.bindings, table.nth[Binding](i));
            table.items[bool](out)[i] = symbol.shows(b.visibility, symbol.EXPORTED);
            i                         = i + 1;
        }
    }
    ret intents(inputs, names, resolved, directed, out);
}

# check every export directive of an object input, and where `directed`
# export the definition each names
fun intents(inputs: *Inputs, names: *Interner, resolved: *Resolved, directed: bool, out: *Table[bool]) err[Fail] {
    var i: usize = 0;
    for (i < input.count(inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(inputs, id);
        i = i + 1;
        if (o == nil || resolve.library(resolved, id)) { cnt; }
        var k: usize = 0;
        for (k < table.count[Directive](?o.directives)) {
            val d: *Directive = table.at[Directive](?o.directives, table.nth[Directive](k));
            k = k + 1;
            if (d.kind != ?directive.EXPORT)           { cnt; }
            if (directed && sel d.export.forward.some) { cnt; }
            val b: res[Id[Binding], Fail] = intended(names, resolved, o, d, directed);
            if (sel b.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(b.err, "directive", (k - 1)::u64), input.at(inputs, id).name)}; }
            if (directed)  { table.items[bool](out)[b.ok.index] = true; }
        }
    }
    ret err[Fail].ok{};
}

# the binding of the definition the export directive `d` of the object
# input `o` names, refused where it forwards or no object input defines it, or where the link exports by visibility, not `by_directive`,
# and it exports by another name than the symbol's
pub fun intended(names: *Interner, resolved: *Resolved, o: *Object, d: *Directive, by_directive: bool) res[Id[Binding], Fail] {
    val about: opt[Id[Name]] = d.symbol;
    if (sel about.none) { ret res[Id[Binding], Fail].err{fail.unsupported("a forwarder exports no definition of the image")}; }
    if (!by_directive && about.some.index != d.text.index) {
        ret res[Id[Binding], Fail].err{fail.unsupported("the output's format exports a symbol only by its own name")};
    }
    ret directed(names, resolved, o, about.some);
}

fun directed(names: *Interner, resolved: *Resolved, o: *Object, about: Id[Name]) res[Id[Binding], Fail] {
    val missing: Fail          = fail.malformed("an export directive names a symbol the image does not define");
    val text:    View          = object.name_of(o, about);
    val nm:      opt[Id[Name]] = intern.find(names, text.data, text.len);
    if (sel nm.none) { ret res[Id[Binding], Fail].err{missing}; }
    val w: opt[resolve.Won] = resolve.bound(resolved, nm.some);
    if (sel w.none)                                      { ret res[Id[Binding], Fail].err{missing}; }
    if (resolve.library(resolved, w.some.binding.input)) { ret res[Id[Binding], Fail].err{missing}; }
    ret res[Id[Binding], Fail].ok{w.some.id};
}
