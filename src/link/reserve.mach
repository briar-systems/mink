# the reserve phase: the tables the linker makes, sized before layout
#
# every linker-made table, a GOT, a PLT, stubs, import tables, an unwind index
# or a thunk island, declares a shape: its section, its size, its entries, its
# flags and a placement. the phase collects every declared shape before any
# address is given, so layout sees the tables as ordinary sections and places
# them by their placement rows. a declarer is a row bound to the format it
# declares tables for, and nothing asks which format a link is for.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.catalog.arch.Arch;
use mink.catalog.format.Format;
use mink.catalog.trait.Trait;
use mink.checked;
use mink.fail;
use mink.fail.Fail;
use mink.fail.Location;
use mink.intern;
use mink.intern.Interner;
use mink.intern.Name;
use mink.link.collect.Live;
use mink.link.dynamic.Dynamic;
use mink.link.input.Inputs;
use mink.link.kind.Kind;
use mink.link.resolve.Resolved;
use mink.model.object.Fact;
use mink.model.section;
use mink.table;
use mink.table.Id;
use mink.table.Table;

# where layout puts a table. a table that does not take a segment of its own
# ends its region, the output sections whose flags and kind's roles hold the
# row's, extending the section that ends the region when it has the same name
# ---
# name:  the placement's spelling in a diagnostic
# flags: the flags every section of its region carries
# roles: the roles every section of its region plays
# own:   whether the table takes a segment of its own after the last one, on a
#        page of its own
pub rec Placement {
    name:  str;
    flags: section.Flags;
    roles: section.Roles;
    own:   bool;
}

# at the end of the code, so no data lies between the code and the table
pub val CODE_END: Placement = Placement{name: "code end", flags: section.ALLOC | section.EXEC};
# at the end of the read-only data the loader writes once, ahead of the zero-fill
pub val RELRO_END: Placement = Placement{name: "relro end", flags: section.ALLOC | section.WRITE, roles: section.RELRO};
# in a segment of its own after the last one, on a page of its own
pub val OWN_SEGMENT: Placement = Placement{name: "own segment", flags: section.ALLOC, own: true};
# at the end of the loaded notes
pub val NOTE_END: Placement = Placement{name: "note end", flags: section.ALLOC, roles: section.NOTE};

# what a table takes
# ---
# name:       its section's name
# kind:       the role its section plays
# flags:      the flags of its section, or of its segment when it takes one
# align:      its alignment, a power of two
# size:       its size in bytes
# entry_size: the size of one entry, zero for a table of no fixed entries
# count:      how many entries it holds
# placement:  where layout puts it
# limit:      the largest size the format allows its section
# reason:     why a section past the limit is refused
pub rec Shape {
    name:       str;
    kind:       *section.Kind;
    flags:      section.Flags;
    align:      u64;
    size:       u64;
    entry_size: u64;
    count:      u64;
    placement:  *Placement;
    limit:      u64;
    reason:     str;
}

# facts, store, traits:
#            the settled facts, the bytes they own and the settled traits,
#            which tables such as a property note carry
# dynamic:   what each reference needs, whose GOT slots, PLT entries and
#            copies the declarers reserve
# declarers: the rows that declare tables, run for the output format
pub rec In {
    inputs:    *Inputs;
    names:     *Interner;
    facts:     *Table[Fact];
    store:     *Table[u8];
    traits:    *Table[Trait];
    resolved:  *Resolved;
    live:      *Live;
    dynamic:   *Dynamic;
    kind:      *Kind;
    format:    *Format;
    arch:      *Arch;
    declarers: Declarers;
}

# a table the linker makes, a shape whose name is in the link's names
# ---
# name:       its section's name, in the link's names
# kind:       the role its section plays
# flags:      the flags of its section, or of its segment when it takes one
# align:      its alignment
# size:       its size in bytes
# entry_size: the size of one entry
# count:      how many entries it holds
# placement:  where layout puts it
# limit:      the largest size the format allows its section
# reason:     why a section past the limit is refused
pub rec Reservation {
    name:       Id[Name];
    kind:       *section.Kind;
    flags:      section.Flags;
    align:      u64;
    size:       u64;
    entry_size: u64;
    count:      u64;
    placement:  *Placement;
    limit:      u64;
    reason:     str;
}

# where the entries one of dynamic's tables needs lie in the table that holds
# them
# ---
# table:   the reservation holding them, none while no declarer reserved one
# offsets: the offset in that table of each entry, in the order of dynamic's
#          entries, whether the table's entries are of one size or not
pub rec Entries {
    table:   opt[Id[Reservation]];
    offsets: Table[u64];
}

# tables: every table the declarers reserved, in order
# got:    the GOT slots, the GOT's address being its table's
# plt:    the PLT entries or stubs
# copies: the copies of library data
pub rec Reserved {
    tables: Table[Reservation];
    got:    Entries;
    plt:    Entries;
    copies: Entries;
}

# the tables of one format
# ---
# format:  the format whose tables it declares
# declare: declares each table through declare
pub rec Declarer {
    format:  *Format;
    declare: fun(*In, *Reserved) err[Fail];
}

pub rec Declarers {
    rows:  **Declarer;
    count: usize;
}

pub fun make(a: *A.Allocator) Reserved {
    ret Reserved{
        tables: table.make[Reservation](a),
        got:    Entries{offsets: table.make[u64](a)},
        plt:    Entries{offsets: table.make[u64](a)},
        copies: Entries{offsets: table.make[u64](a)},
    };
}

# run every declarer bound to the output format, in order
pub fun run(in: *In, out: *Reserved) err[Fail] {
    var i: usize = 0;
    for (i < in.declarers.count) {
        val d: *Declarer = in.declarers.rows[i];
        if (d.format == in.format) {
            val r: err[Fail] = d.declare(in, out);
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# reserve the table `s` declares, refused when its shape is unsound or its
# size passes the format's limit
pub fun declare(in: *In, out: *Reserved, s: Shape) res[Id[Reservation], Fail] {
    val c: err[Fail] = sound(?s);
    if (sel c.err) { ret res[Id[Reservation], Fail].err{fail.in_record(c.err, s.name)}; }
    val n: res[Id[Name], Fail] = intern.intern_str(in.names, s.name);
    if (sel n.err) { ret res[Id[Reservation], Fail].err{n.err}; }
    ret table.push[Reservation](?out.tables, Reservation{
        name:       n.ok,
        kind:       s.kind,
        flags:      s.flags,
        align:      s.align,
        size:       s.size,
        entry_size: s.entry_size,
        count:      s.count,
        placement:  s.placement,
        limit:      s.limit,
        reason:     s.reason,
    });
}

# state that `count` entries of `stride` bytes lie in the table `t` for `e`,
# the first at offset `first`, a declarer's fixed-size tables. a table of
# entries of other sizes pushes each offset itself
pub fun lay_entries(out: *Reserved, e: *Entries, t: Id[Reservation], first: u64, stride: u64, count: u64) err[Fail] {
    val at:   Location       = Location{record: "reserved table"};
    val r:    *Reservation   = table.at[Reservation](?out.tables, t);
    val span: res[u64, Fail] = checked.mul(at, stride, count);
    if (sel span.err) { ret err[Fail].err{span.err}; }
    val stop: res[u64, Fail] = checked.add(at, first, span.ok);
    if (sel stop.err)     { ret err[Fail].err{stop.err}; }
    if (stop.ok > r.size) { ret err[Fail].err{fail.internal("table entries pass its size")}; }
    e.table = opt[Id[Reservation]].some{t};
    var i: u64 = 0;
    for (i < count) {
        val p: res[Id[u64], Fail] = table.push[u64](?e.offsets, first + i * stride);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# whether a section of `flags` and `k` lies in the region `p` names
pub fun in_region(p: *Placement, flags: section.Flags, k: *section.Kind) bool {
    ret (flags & p.flags) == p.flags && section.has(k, p.roles);
}

fun sound(s: *Shape) err[Fail] {
    if (s.kind == nil || s.placement == nil) { ret err[Fail].err{fail.internal("table shape names no kind or placement")}; }
    if (s.align == 0 || (s.align & (s.align - 1)) != 0) {
        ret err[Fail].err{fail.internal("table alignment is not a power of two")};
    }
    if (!in_region(s.placement, s.flags, s.kind)) {
        ret err[Fail].err{fail.internal("table lies outside the region its placement ends")};
    }
    val entries: res[u64, Fail] = checked.mul(Location{record: s.name}, s.entry_size, s.count);
    if (sel entries.err)     { ret err[Fail].err{entries.err}; }
    if (entries.ok > s.size) { ret err[Fail].err{fail.internal("table entries pass its size")}; }
    if (s.size > s.limit)    { ret err[Fail].err{fail.overflow(s.reason)}; }
    ret err[Fail].ok{};
}

pub fun release(r: *Reserved) err[Fail] {
    var first: err[Fail] = table.release[Reservation](?r.tables);
    first = kept(first, table.release[u64](?r.got.offsets));
    first = kept(first, table.release[u64](?r.plt.offsets));
    ret kept(first, table.release[u64](?r.copies.offsets));
}

fun kept(first: err[Fail], next: err[Fail]) err[Fail] {
    if (sel first.err) { ret first; }
    ret next;
}
