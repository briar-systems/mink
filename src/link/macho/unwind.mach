# the image's __unwind_info, built from the inputs' compact unwind entries
#
# each object input's __compact_unwind holds one fixed entry per function: its
# start and length, its encoding, its personality routine and its language
# specific data. the link leaves those sections to this table, which reads
# each entry's addresses through its relocations once the image is laid out,
# so an entry of a function the link dropped is dropped with it. the entries
# are sorted by address and folded, then laid out: the common encodings by how
# often they occur, a first-level index of second-level pages, compressed
# where the entries fit and regular where more of them fit that way, the
# language specific data index, and a sentinel at the end of the last
# function. a measure sizes the table from the laid out image and the image
# writer fills it, each through the one builder here.
#
# a function whose encoding defers to DWARF points at its FDE in the image's
# __eh_frame, by the FDE's offset there, and a function with an FDE the link
# kept and no compact entry takes an entry of that mode. the link keeps only
# the FDEs such entries need: every function whose compact entry does not
# defer to DWARF has its FDE superseded, which this table states for the
# collection. an entry's personality routine is reached through the GOT
# slot the dynamic phase gave the relocation naming it, the table's
# personalities holding each slot's offset from the mach header and the
# entry's encoding its index among them, at most three.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.base.vectors;
use mink.bytes.reader;
use mink.bytes.reader.Reader;
use mink.bytes.slot;
use linkedit_unwind: mink.format.macho.linkedit.unwind;
use mink.format.macho.model.model;
use mink.format.macho.model.model.UnwindCompressed;
use mink.format.macho.model.model.UnwindEntry;
use mink.format.macho.model.model.UnwindIndex;
use mink.format.macho.model.model.UnwindInfo;
use mink.format.macho.model.model.UnwindLsda;
use mink.format.macho.model.model.UnwindPage;
use mink.format.macho.model.model.UnwindRegular;
use mink.format.macho.model.model.UnwindShape;
use mink.format.macho.neutral.neutral;
use mink.link.collect.Ref;
use mink.link.collect.Superseding;
use mink.link.dynamic;
use mink.link.image.Image;
use mink.link.input;
use mink.link.input.Input;
use mink.link.layout;
use mink.link.reserve;
use mink.link.reserve.Declarer;
use mink.link.resolve;
use mink.lower.unwind.compact;
use mink.lower.unwind.compact.Encodings;
use mink.lower.unwind.parse;
use mink.lower.unwind.parse.Framed;
use mink.model.object;
use mink.model.object.Definition;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Reloc;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.reloc;
use mink.model.section;

# the bits of an encoding that state its personality's index plus one, and
# the most personalities they index, as mach-o/compact_unwind_encoding.h
# gives them
val PERSONALITY_MASK:  u32   = 0x3000_0000;
val PERSONALITY_SHIFT: u32   = 28;
val PERSONALITY_MAX:   usize = 3;

# the version of the table libunwind reads
val VERSION: u32 = 1;

# a second-level page, and its words
val PAGE_BYTES: u64   = 4096;
val PAGE_WORDS: usize = 1024;

# common encodings are indexes 0 to 126, and a compressed page's own take the
# rest of its 8-bit index
val COMMON_MAX:  usize = 127;
val COMPACT_MAX: usize = 256;

# the fields of an entry a relocation may patch, as slots of its fields table
val FUNCTION:    usize = 0;
val PERSONALITY: usize = 1;
val LSDA:        usize = 2;
val FIELDS:      usize = 3;

val NONE: usize = 0xffff_ffff_ffff_ffff;

# the measure the table is sized by, which the image's linking row binds
pub val MEASURE: reserve.Measure = reserve.Measure{name: "unwind info"};

# the table, declared for a link whose inputs hold compact unwind entries
pub val TABLE: Declarer = Declarer{declare: declare};

# the functions whose FDE a compact entry supersedes
pub val SUPERSEDING: Superseding = Superseding{superseded: superseded};

# an entry of the image's table
# ---
# address:  where its function starts
# length:   how many bytes its function runs
# encoding: how its function unwinds
# lsda:     the address of its language specific data, none for none
rec Entry {
    address:  u64;
    length:   u32;
    encoding: u32;
    lsda:     opt[u64];
}

# an FDE the link kept
# ---
# function: the address of its function
# range:    how many bytes its function runs
# offset:   its offset in the image's __eh_frame
# used:     an entry points at it
rec Fde {
    function: u64;
    range:    u64;
    offset:   u64;
    used:     bool;
}

fun by_function(a: *Fde, b: *Fde) i64 {
    if (a.function < b.function) { ret -1; }
    if (a.function > b.function) { ret 1; }
    ret 0;
}

# a relocation of a section, by its offset there
rec Patch {
    offset: u64;
    reloc:  u32;
}

fun by_offset(a: *Patch, b: *Patch) i64 {
    if (a.offset < b.offset) { ret -1; }
    if (a.offset > b.offset) { ret 1; }
    if (a.reloc < b.reloc)   { ret -1; }
    if (a.reloc > b.reloc)   { ret 1; }
    ret 0;
}

# a second-level page of the table
# ---
# first:       its first entry among the folded entries
# count:       how many entries it holds
# compressed:  it is compressed rather than regular
# local_first: its first own encoding among every page's own encodings
# local_count: how many own encodings it has
rec Split {
    first:       usize;
    count:       usize;
    compressed:  bool;
    local_first: usize;
    local_count: usize;
}

# an encoding and how many folded entries use it
rec Frequency {
    encoding: u32;
    count:    usize;
}

fun by_address(a: *Entry, b: *Entry) i64 {
    if (a.address < b.address) { ret -1; }
    if (a.address > b.address) { ret 1; }
    ret 0;
}

fun by_encoding(a: *u32, b: *u32) i64 {
    if (@a < @b) { ret -1; }
    if (@a > @b) { ret 1; }
    ret 0;
}

# the more often used first, a tie the greater encoding first
fun by_frequency(a: *Frequency, b: *Frequency) i64 {
    if (a.count > b.count)       { ret -1; }
    if (a.count < b.count)       { ret 1; }
    if (a.encoding > b.encoding) { ret -1; }
    if (a.encoding < b.encoding) { ret 1; }
    ret 0;
}

# whether section `s` holds compact unwind entries the image reads
fun holds_entries(s: *Section) bool {
    ret s.kind.use == ?section.CONSUMED_UNWIND;
}

# declare the table when the image keeps unwind records and an object input
# holds compact unwind entries, to end the constant data of __TEXT
fun declare(in: *reserve.In, out: *reserve.Reserved) err[Fail] {
    if (!in.unwinds) { ret err[Fail].ok{}; }
    var i:     usize = 0;
    var found: bool  = false;
    for (i < input.count(in.inputs) && !found) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(in.inputs, id);
        i = i + 1;
        if (o == nil || resolve.library(in.resolved, id)) { cnt; }
        var k: usize = 0;
        for (k < table.count[Section](?o.sections)) {
            if (holds_entries(object.section_at(o, table.nth[Section](k)))) { found = true; }
            k = k + 1;
        }
    }
    if (!found) { ret err[Fail].ok{}; }
    val res_declare: res[Id[reserve.Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
        name:      "__TEXT,__unwind_info",
        kind:      ?section.RODATA,
        flags:     section.ALLOC,
        align:     4,
        sizing:    reserve.Sizing.measured{?MEASURE},
        placement: reserve.Placement.region_end{?reserve.CONST_END},
        limit:     0xffff_ffff,
        reason:    "the unwind info passes 4 GiB, past what its offsets reach",
    });
    if (sel res_declare.err) { ret err[Fail].err{res_declare.err}; }
    ret err[Fail].ok{};
}

# the relocation of each compact unwind entry of the object inputs that
# names its personality routine, which the image reaches through a GOT slot,
# none for an image that keeps no unwind records
pub fun personalities(in: *dynamic.In, out: *Vector[dynamic.Made]) err[Fail] {
    if (!in.unwinds) { ret err[Fail].ok{}; }
    val res_shape: res[model.Shape, Fail] = neutral.shape_of(in.arch);
    if (sel res_shape.err) { ret err[Fail].err{res_shape.err}; }
    val size:   u64   = res_shape.ok.class.unwind.size::u64;
    val within: u64   = res_shape.ok.class.unwind.personality.offset::u64;
    var i:      usize = 0;
    for (i < input.count(in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(in.inputs, id);
        i = i + 1;
        if (o == nil || resolve.library(in.resolved, id)) { cnt; }
        var k: usize = 0;
        for (k < table.count[Reloc](?o.relocs)) {
            val rel: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc](k));
            k = k + 1;
            if (rel.section.index::usize >= table.count[Section](?o.sections)) { cnt; }
            if (!holds_entries(object.section_at(o, rel.section)))             { cnt; }
            if (rel.offset % size != within)                                   { cnt; }
            val err_out_pushed: err[Fail] = vectors.push[dynamic.Made](out, dynamic.Made.reloc{dynamic.Placed{input: id, reloc: (k - 1)::u32}});
            if (sel err_out_pushed.err) { ret err[Fail].err{err_out_pushed.err}; }
        }
    }
    ret err[Fail].ok{};
}

# the image's table, every offset counted from the mach header at `base`
pub fun build(a: *A.Allocator, img: *Image, base: u64) res[UnwindInfo, Fail] {
    val res_rules: res[*Encodings, Fail] = compact.of(img.target.arch);
    if (sel res_rules.err) { ret res[UnwindInfo, Fail].err{res_rules.err}; }
    val res_shape: res[model.Shape, Fail] = neutral.shape_of(img.target.arch);
    if (sel res_shape.err) { ret res[UnwindInfo, Fail].err{res_shape.err}; }
    var entries:    Vector[Entry]         = vector.init[Entry](a);
    var fdes:       Vector[Fde]           = vector.init[Fde](a);
    var pers:       Vector[u32]           = vector.init[u32](a);
    var res_out:    res[UnwindInfo, Fail] = res[UnwindInfo, Fail].err{fail.internal("the unwind info was not built")};
    val err_gather: err[Fail]             = gather(a, img, ?res_shape.ok.class.unwind, res_shape.ok, res_rules.ok, base, ?pers, ?fdes, ?entries);
    if (sel err_gather.err) { res_out = res[UnwindInfo, Fail].err{err_gather.err}; }
    or                      { res_out = lay(a, ?entries, res_rules.ok, base, ?pers); }
    val err_rel: err[Fail] = fail.kept(fail.kept(vectors.dnit[Entry](?entries), vectors.dnit[Fde](?fdes)), vectors.dnit[u32](?pers));
    if (sel res_out.err) { ret res_out; }
    if (sel err_rel.err) {
        var dead:        UnwindInfo = res_out.ok;
        val err_dropped: err[Fail]  = model.unwind_info_dnit(?dead);
        ret res[UnwindInfo, Fail].err{err_rel.err};
    }
    ret res_out;
}

# every entry of every object input whose function survived the link, and
# one deferring to DWARF for each kept FDE no entry points at
fun gather(a: *A.Allocator, img: *Image, u: *UnwindShape, shape: model.Shape, rules: *Encodings, base: u64, pers: *Vector[u32], fdes: *Vector[Fde], out: *Vector[Entry]) err[Fail] {
    val err_frames: err[Fail] = frames(a, img, shape, fdes);
    if (sel err_frames.err) { ret err_frames; }
    var bases:    Vector[usize] = vector.init[usize](a);
    var fields:   Vector[u32]   = vector.init[u32](a);
    var err_kept: err[Fail]     = err[Fail].ok{};
    var i:        usize         = 0;
    for (i < input.count(img.inputs) && sel err_kept.ok) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(img.inputs, id);
        i = i + 1;
        if (o == nil || resolve.library(img.resolved, id)) { cnt; }
        vector.clear[usize](?bases);
        vector.clear[u32](?fields);
        val err_gather_input: err[Fail] = gather_input(img, u, shape, rules, base, pers, id, o, ?bases, ?fields, fdes, out);
        if (sel err_gather_input.err) { err_kept = err[Fail].err{fail.in_file(err_gather_input.err, input.at(img.inputs, id).name)}; }
    }
    err_kept = fail.kept(err_kept, vectors.dnit[usize](?bases));
    err_kept = fail.kept(err_kept, vectors.dnit[u32](?fields));
    if (sel err_kept.err) { ret err_kept; }
    ret unclaimed(rules, fdes, out);
}

# an entry deferring to DWARF for each kept FDE no entry points at, as a
# function with no compact entry takes
fun unclaimed(rules: *Encodings, fdes: *Vector[Fde], out: *Vector[Entry]) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Fde](fdes)) {
        val f: Fde = fdes.data[i];
        i = i + 1;
        if (f.used)                { cnt; }
        if (f.range > 0xffff_ffff) { ret err[Fail].err{fail.valued(fail.overflow("a function an FDE describes runs past what a compact unwind entry's length holds"), f.range::i128)}; }
        val res_enc: res[u32, Fail] = dwarf_encoding(rules.dwarf, f.offset);
        if (sel res_enc.err) { ret err[Fail].err{res_enc.err}; }
        val err_out_pushed: err[Fail] = vectors.push[Entry](out, Entry{address: f.function, length: f.range::u32, encoding: res_enc.ok, lsda: opt[u64].none{}});
        if (sel err_out_pushed.err) { ret err[Fail].err{err_out_pushed.err}; }
    }
    ret err[Fail].ok{};
}

# an encoding of mode `mode` deferring to the FDE at `offset` of the image's
# __eh_frame
fun dwarf_encoding(mode: u32, offset: u64) res[u32, Fail] {
    if (offset > compact.DWARF_OFFSET::u64) { ret res[u32, Fail].err{fail.valued(fail.overflow("an FDE lies past what a compact unwind encoding's offset reaches in __eh_frame"), offset::i128)}; }
    ret res[u32, Fail].ok{mode | offset::u32};
}

# whether section `s` is a runtime unwinder's table the image lays out
fun holds_frames(s: *Section) bool {
    ret s.kind.use.placed && section.has(s.kind, section.UNWIND);
}

# every FDE the link kept, by its function's address
fun frames(a: *A.Allocator, img: *Image, shape: model.Shape, fdes: *Vector[Fde]) err[Fail] {
    var patches:  Vector[Patch]     = vector.init[Patch](a);
    var cies:     Vector[parse.Cie] = vector.init[parse.Cie](a);
    var err_kept: err[Fail]         = err[Fail].ok{};
    var i:        usize             = 0;
    for (i < input.count(img.inputs) && sel err_kept.ok) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(img.inputs, id);
        i = i + 1;
        if (o == nil || resolve.library(img.resolved, id)) { cnt; }
        var k: usize = 0;
        for (k < table.count[Section](?o.sections) && sel err_kept.ok) {
            val s: *Section = object.section_at(o, table.nth[Section](k));
            k = k + 1;
            if (!holds_frames(s) || sel s.contents.zero) { cnt; }
            val opt_landing_of: opt[Id[layout.Landing]] = layout.landing_of(img.layout, Ref{input: id, section: table.nth[Section](k - 1)});
            if (sel opt_landing_of.none) { cnt; }
            val err_frames_of: err[Fail] = frames_of(img, shape, id, o, (k - 1)::u32, ?patches, ?cies, fdes);
            if (sel err_frames_of.err) { err_kept = err[Fail].err{fail.in_file(fail.in_indexed(err_frames_of.err, "section", (k - 1)::u64), input.at(img.inputs, id).name)}; }
        }
    }
    err_kept = fail.kept(err_kept, vectors.dnit[Patch](?patches));
    err_kept = fail.kept(err_kept, vectors.dnit[parse.Cie](?cies));
    if (sel err_kept.err) { ret err_kept; }
    val n: usize = vector.length[Fde](fdes);
    sort.sort_by[Fde](fdes.data, n, by_function);
    i = 1;
    for (i < n) {
        if (fdes.data[i].function == fdes.data[i - 1].function) { ret err[Fail].err{fail.malformed("two FDEs the link kept describe one function")}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the FDEs the link kept of the section `k` of `o`, each found at its
# function's start by the relocation of its first field
fun frames_of(img: *Image, shape: model.Shape, id: Id[Input], o: *Object, k: u32, patches: *Vector[Patch], cies: *Vector[parse.Cie], fdes: *Vector[Fde]) err[Fail] {
    vector.clear[Patch](patches);
    vector.clear[parse.Cie](cies);
    var ri: usize = 0;
    for (ri < table.count[Reloc](?o.relocs)) {
        val rel: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc](ri));
        ri = ri + 1;
        if (rel.section.index != k) { cnt; }
        val err_patches_pushed: err[Fail] = vectors.push[Patch](patches, Patch{offset: rel.offset, reloc: (ri - 1)::u32});
        if (sel err_patches_pushed.err) { ret err[Fail].err{err_patches_pushed.err}; }
    }
    sort.sort_by[Patch](patches.data, vector.length[Patch](patches), by_offset);
    val ref: Ref    = Ref{input: id, section: Id[Section]{index: k}};
    val b:   Bytes  = object.bytes(o, ?object.section_at(o, ref.section).contents);
    var r:   Reader = reader.make(input.at(img.inputs, id).name, b.data, b.len, shape.order);
    var off: u64    = 0;
    for (off < b.len::u64) {
        val res_framed: res[Framed, Fail] = parse.framed(?r, off, b.len::u64);
        if (sel res_framed.err)       { ret err[Fail].err{res_framed.err}; }
        if (sel res_framed.ok.broken) { ret err[Fail].err{fail.at_offset(fail.malformed("a call frame record does not frame within its table"), off)}; }
        or (sel res_framed.ok.ended)  { brk; }
        val rec: parse.Record = res_framed.ok.record;
        off = rec.end;
        if (sel rec.cie.none) {
            val res_cie: res[parse.Cie, Fail] = parse.cie(?r, rec, shape.class.addr::u8);
            if (sel res_cie.err) { ret err[Fail].err{res_cie.err}; }
            val err_cies_pushed: err[Fail] = vectors.push[parse.Cie](cies, res_cie.ok);
            if (sel err_cies_pushed.err) { ret err[Fail].err{err_cies_pushed.err}; }
            cnt;
        }
        val res_pos: res[opt[layout.Position], Fail] = layout.locate(img.layout, img.pieces, ref, rec.start);
        if (sel res_pos.err)     { ret err[Fail].err{res_pos.err}; }
        if (sel res_pos.ok.none) { cnt; }
        val c: *parse.Cie = parse.cie_at(cies, rec.cie.some);
        if (c == nil) { ret err[Fail].err{fail.at_offset(fail.malformed("an FDE names no CIE of its table"), rec.start)}; }
        val res_fde: res[parse.Fde, Fail] = parse.fde(?r, rec, c, shape.class.addr::u8);
        if (sel res_fde.err) { ret err[Fail].err{res_fde.err}; }
        val opt_patch_at: opt[u32] = patch_at(patches, res_fde.ok.begin.at);
        if (sel opt_patch_at.none) { ret err[Fail].err{fail.at_offset(fail.malformed("an FDE's function start is relocated by no relocation"), res_fde.ok.begin.at)}; }
        val res_target_address: res[opt[u64], Fail] = target_address(img, id, o, opt_patch_at.some::usize);
        if (sel res_target_address.err)     { ret err[Fail].err{res_target_address.err}; }
        if (sel res_target_address.ok.none) { ret err[Fail].err{fail.at_offset(fail.malformed("an FDE the link kept describes a function it dropped"), rec.start)}; }
        val m:               *layout.Merged = table.at[layout.Merged](?img.layout.merged, res_pos.ok.some.merged);
        val err_fdes_pushed: err[Fail]      = vectors.push[Fde](fdes, Fde{function: res_target_address.ok.some, range: res_fde.ok.range, offset: res_pos.ok.some.address - m.address});
        if (sel err_fdes_pushed.err) { ret err[Fail].err{err_fdes_pushed.err}; }
    }
    ret err[Fail].ok{};
}

# the one relocation at `offset` among `patches`, ordered, none for none or
# for two
fun patch_at(patches: *Vector[Patch], offset: u64) opt[u32] {
    val n:  usize = vector.length[Patch](patches);
    var lo: usize = 0;
    var hi: usize = n;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (patches.data[mid].offset < offset) { lo = mid + 1; }
        or                                     { hi = mid; }
    }
    if (lo >= n || patches.data[lo].offset != offset)        { ret opt[u32].none{}; }
    if (lo + 1 < n && patches.data[lo + 1].offset == offset) { ret opt[u32].none{}; }
    ret opt[u32].some{patches.data[lo].reloc};
}

# the kept FDE of the function at `address` among `fdes`, by function, nil
# for none
fun fde_of(fdes: *Vector[Fde], address: u64) *Fde {
    var lo: usize = 0;
    var hi: usize = vector.length[Fde](fdes);
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (fdes.data[mid].function < address) { lo = mid + 1; }
        or                                     { hi = mid; }
    }
    if (lo < vector.length[Fde](fdes) && fdes.data[lo].function == address) { ret ?fdes.data[lo]; }
    ret nil;
}

# the compact unwind entries of `o` in `bases` and `fields`: each section of
# entries takes its run of `fields`, one cell per field a relocation may
# patch, holding the index of the relocation patching it plus one, zero for
# none, and every other section NONE in `bases`. the number of cells
fun index_cells(u: *UnwindShape, o: *Object, bases: *Vector[usize], fields: *Vector[u32]) res[usize, Fail] {
    val size:      usize     = u.size;
    val n:         usize     = table.count[Section](?o.sections);
    val err_grown: err[Fail] = vectors.grow[usize](bases, n);
    if (sel err_grown.err) { ret res[usize, Fail].err{err_grown.err}; }
    var total: usize = 0;
    var k:     usize = 0;
    for (k < n) {
        val s: *Section = object.section_at(o, table.nth[Section](k));
        bases.data[k] = NONE;
        k             = k + 1;
        if (!holds_entries(s))   { cnt; }
        if (sel s.contents.zero) { ret res[usize, Fail].err{fail.in_indexed(fail.malformed("compact unwind holds no bytes"), "section", (k - 1)::u64)}; }
        val b: Bytes = object.bytes(o, ?s.contents);
        if (b.len % size != 0) { ret res[usize, Fail].err{fail.in_indexed(fail.malformed("compact unwind is not a whole number of entries"), "section", (k - 1)::u64)}; }
        bases.data[k - 1] = total;
        total             = total + b.len / size * FIELDS;
    }
    if (total == 0) { ret res[usize, Fail].ok{0}; }
    val err_cells: err[Fail] = vectors.grow[u32](fields, total);
    if (sel err_cells.err) { ret res[usize, Fail].err{err_cells.err}; }
    var ri: usize = 0;
    for (ri < table.count[Reloc](?o.relocs)) {
        val rel: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc](ri));
        ri = ri + 1;
        if (rel.section.index::usize >= n) { ret res[usize, Fail].err{fail.in_indexed(fail.malformed("a relocation patches a section the object does not hold"), "relocation", (ri - 1)::u64)}; }
        val base: usize = bases.data[rel.section.index];
        if (base == NONE) { cnt; }
        val len: usize = object.bytes(o, ?object.section_at(o, rel.section).contents).len;
        if (rel.offset >= len::u64) { ret res[usize, Fail].err{fail.in_indexed(fail.malformed("a relocation lies past its compact unwind"), "relocation", (ri - 1)::u64)}; }
        val within: usize = (rel.offset % size::u64)::usize;
        var field:  usize = NONE;
        if (within == u.start.offset::usize)       { field = FUNCTION; }
        or (within == u.personality.offset::usize) { field = PERSONALITY; }
        or (within == u.lsda.offset::usize)        { field = LSDA; }
        if (field == NONE)                         { ret res[usize, Fail].err{fail.in_indexed(fail.malformed("a relocation patches no address of a compact unwind entry"), "relocation", (ri - 1)::u64)}; }
        val cell: *u32 = ?fields.data[base + (rel.offset / size::u64)::usize * FIELDS + field];
        if (@cell != 0) { ret res[usize, Fail].err{fail.in_indexed(fail.malformed("two relocations patch one field of a compact unwind entry"), "relocation", (ri - 1)::u64)}; }
        @cell = ri::u32;
    }
    ret res[usize, Fail].ok{total};
}

# the entries of the object `o`
fun gather_input(img: *Image, u: *UnwindShape, shape: model.Shape, rules: *Encodings, image_base: u64, pers: *Vector[u32], id: Id[Input], o: *Object, bases: *Vector[usize], fields: *Vector[u32], fdes: *Vector[Fde], out: *Vector[Entry]) err[Fail] {
    val res_total: res[usize, Fail] = index_cells(u, o, bases, fields);
    if (sel res_total.err) { ret err[Fail].err{res_total.err}; }
    if (res_total.ok == 0) { ret err[Fail].ok{}; }
    val size: usize = u.size;
    var k:    usize = 0;
    for (k < table.count[Section](?o.sections)) {
        val base: usize    = bases.data[k];
        val s:    *Section = object.section_at(o, table.nth[Section](k));
        k = k + 1;
        if (base == NONE) { cnt; }
        val b: Bytes = object.bytes(o, ?s.contents);
        var j: usize = 0;
        for (j < b.len / size) {
            val err_entry_of: err[Fail] = entry_of(img, u, shape, rules, image_base, pers, id, o, ?b.data[j * size], ?fields.data[base + j * FIELDS], fdes, out);
            if (sel err_entry_of.err) { ret err[Fail].err{fail.in_indexed(fail.in_indexed(err_entry_of.err, "compact unwind entry", j::u64), "section", (k - 1)::u64)}; }
            j = j + 1;
        }
    }
    ret err[Fail].ok{};
}

# the functions of `o` whose compact entry does not defer to DWARF, whose
# FDE the entry supersedes. an entry naming a function another object
# defines states nothing, so that function's FDE is kept
fun superseded(o: *Object, out: *Table[Place]) err[Fail] {
    var any: bool  = false;
    var k:   usize = 0;
    for (k < table.count[Section](?o.sections) && !any) {
        any = holds_entries(object.section_at(o, table.nth[Section](k)));
        k   = k + 1;
    }
    if (!any) { ret err[Fail].ok{}; }
    val res_rules: res[*Encodings, Fail] = compact.of(o.target.arch);
    if (sel res_rules.err) { ret err[Fail].err{res_rules.err}; }
    val res_shape: res[model.Shape, Fail] = neutral.shape_of(o.target.arch);
    if (sel res_shape.err) { ret err[Fail].err{res_shape.err}; }
    var bases:         Vector[usize] = vector.init[usize](table.allocator[Place](out));
    var fields:        Vector[u32]   = vector.init[u32](table.allocator[Place](out));
    var err_supersede: err[Fail]     = supersede(o, ?res_shape.ok.class.unwind, res_shape.ok, res_rules.ok, ?bases, ?fields, out);
    err_supersede = fail.kept(err_supersede, vectors.dnit[usize](?bases));
    ret fail.kept(err_supersede, vectors.dnit[u32](?fields));
}

fun supersede(o: *Object, u: *UnwindShape, shape: model.Shape, rules: *Encodings, bases: *Vector[usize], fields: *Vector[u32], out: *Table[Place]) err[Fail] {
    val res_total: res[usize, Fail] = index_cells(u, o, bases, fields);
    if (sel res_total.err) { ret err[Fail].err{res_total.err}; }
    val size: usize = u.size;
    var k:    usize = 0;
    for (k < table.count[Section](?o.sections) && res_total.ok != 0) {
        val base: usize    = bases.data[k];
        val s:    *Section = object.section_at(o, table.nth[Section](k));
        k = k + 1;
        if (base == NONE) { cnt; }
        val b: Bytes = object.bytes(o, ?s.contents);
        var j: usize = 0;
        for (j < b.len / size) {
            val p:    *u8 = ?b.data[j * size];
            val cell: u32 = fields.data[base + j * FIELDS + FUNCTION];
            j = j + 1;
            if ((slot.field(p, u.encoding, shape.order)::u32 & compact.MODE_MASK) == rules.dwarf) { cnt; }
            if (cell == 0)                                                                        { ret err[Fail].err{fail.in_indexed(fail.in_indexed(fail.malformed("a compact unwind entry names no function"), "compact unwind entry", (j - 1)::u64), "section", (k - 1)::u64)}; }
            val rel: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc]((cell - 1)::usize));
            if (!sel rel.target.symbol) { ret err[Fail].err{fail.in_indexed(fail.malformed("a compact unwind address names no symbol"), "relocation", (cell - 1)::u64)}; }
            val def: *Definition = ?object.symbol_at(o, rel.target.symbol).def;
            if (!sel def.placed) { cnt; }
            val off: i128 = def.placed.offset::i128 + rel.addend::i128;
            if (off < 0 || off > 0xffff_ffff_ffff_ffff) { ret err[Fail].err{fail.in_indexed(fail.malformed("a compact unwind address lies outside its section"), "relocation", (cell - 1)::u64)}; }
            val res_pushed: res[Id[Place], Fail] = table.push[Place](out, Place{section: def.placed.section, offset: off::u64});
            if (sel res_pushed.err) { ret err[Fail].err{res_pushed.err}; }
        }
    }
    ret err[Fail].ok{};
}

# the entry at `p`, whose relocations `cells` name, taken when its function
# survived the link, its personality's index in its encoding. one deferring
# to DWARF points at its function's FDE
fun entry_of(img: *Image, u: *UnwindShape, shape: model.Shape, rules: *Encodings, base: u64, pers: *Vector[u32], id: Id[Input], o: *Object, p: *u8, cells: *u32, fdes: *Vector[Fde], out: *Vector[Entry]) err[Fail] {
    var encoding: u32 = slot.field(p, u.encoding, shape.order)::u32;
    if (cells[PERSONALITY] == 0 && slot.field(p, u.personality, shape.order) != 0) { ret err[Fail].err{fail.malformed("a compact unwind entry holds a personality address no relocation names")}; }
    if (cells[FUNCTION] == 0)                                                      { ret err[Fail].err{fail.malformed("a compact unwind entry names no function")}; }
    val res_address_of: res[opt[u64], Fail] = address_of(img, id, o, cells[FUNCTION]);
    if (sel res_address_of.err)     { ret err[Fail].err{res_address_of.err}; }
    if (sel res_address_of.ok.none) { ret err[Fail].ok{}; }
    if ((encoding & compact.MODE_MASK) == rules.dwarf) {
        val fde: *Fde = fde_of(fdes, res_address_of.ok.some);
        if (fde == nil) { ret err[Fail].err{fail.malformed("a function whose compact unwind encoding defers to DWARF has no FDE")}; }
        val res_enc: res[u32, Fail] = dwarf_encoding(encoding & ~compact.DWARF_OFFSET, fde.offset);
        if (sel res_enc.err) { ret err[Fail].err{res_enc.err}; }
        fde.used = true;
        encoding = res_enc.ok;
    }
    if (cells[PERSONALITY] != 0) {
        val res_personality_of: res[u32, Fail] = personality_of(img, base, pers, id, cells[PERSONALITY] - 1);
        if (sel res_personality_of.err) { ret err[Fail].err{res_personality_of.err}; }
        encoding = (encoding & ~PERSONALITY_MASK) | (res_personality_of.ok << PERSONALITY_SHIFT);
    }
    var opt_lsda: opt[u64] = opt[u64].none{};
    if (cells[LSDA] != 0) {
        val res_address_of: res[opt[u64], Fail] = address_of(img, id, o, cells[LSDA]);
        if (sel res_address_of.err)     { ret err[Fail].err{res_address_of.err}; }
        if (sel res_address_of.ok.none) { ret err[Fail].err{fail.malformed("a function's language specific data did not survive the link")}; }
        opt_lsda = opt[u64].some{res_address_of.ok.some};
    }
    or (slot.field(p, u.lsda, shape.order) != 0) { ret err[Fail].err{fail.malformed("a compact unwind entry holds a language specific data address no relocation names")}; }
    val err_pushed: err[Fail] = vectors.push[Entry](out, Entry{address: res_address_of.ok.some, length: slot.field(p, u.length, shape.order)::u32, encoding: encoding, lsda: opt_lsda});
    if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
    ret err[Fail].ok{};
}

# the index plus one among the personalities `pers` of the GOT slot the
# relocation `ri` of the input `id` reaches its personality routine through,
# added on its first use, refused past the most an encoding indexes
fun personality_of(img: *Image, base: u64, pers: *Vector[u32], id: Id[Input], ri: u32) res[u32, Fail] {
    val at: usize             = img.dynamic.starts.data[id.index]::usize + ri::usize;
    val d:  *dynamic.Decision = ?img.dynamic.decisions.data[at];
    if (d.route == nil || !sel d.route.role.reach.loaded) { ret res[u32, Fail].err{fail.in_indexed(fail.internal("a personality routine is reached through no GOT slot"), "relocation", ri::u64)}; }
    val res_slot_at: res[u64, Fail] = layout.slot_address(img.layout, img.reserved, d.route.role, d.entry);
    if (sel res_slot_at.err) { ret res[u32, Fail].err{res_slot_at.err}; }
    val res_off: res[u32, Fail] = offset_of(res_slot_at.ok, base);
    if (sel res_off.err) { ret res_off; }
    var k: usize = 0;
    for (k < vector.length[u32](pers)) {
        if (pers.data[k] == res_off.ok) { ret res[u32, Fail].ok{(k + 1)::u32}; }
        k = k + 1;
    }
    if (k == PERSONALITY_MAX) { ret res[u32, Fail].err{fail.unsupported("the image's functions name more personality routines than a compact unwind encoding indexes")}; }
    val err_pers_pushed: err[Fail] = vectors.push[u32](pers, res_off.ok);
    if (sel err_pers_pushed.err) { ret res[u32, Fail].err{err_pers_pushed.err}; }
    ret res[u32, Fail].ok{(k + 1)::u32};
}

# the address the relocation `cell` less one of `o` names, an absolute
# address, none when the link dropped what it names
fun address_of(img: *Image, id: Id[Input], o: *Object, cell: u32) res[opt[u64], Fail] {
    val rel: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc]((cell - 1)::usize));
    if (rel.kind.caps != reloc.ABS || sel rel.minus.some) {
        ret res[opt[u64], Fail].err{fail.in_indexed(fail.about(fail.unsupported("a compact unwind address is relocated by no absolute address"), rel.kind.name), "relocation", (cell - 1)::u64)};
    }
    ret target_address(img, id, o, (cell - 1)::usize);
}

# the address the relocation `ri` of `o` names, none when the link dropped
# what it names: the place of its symbol, or of the winning definition of an
# undefined one, and its addend
fun target_address(img: *Image, id: Id[Input], o: *Object, ri: usize) res[opt[u64], Fail] {
    val rel: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc](ri));
    if (!sel rel.target.symbol) { ret res[opt[u64], Fail].err{fail.in_indexed(fail.malformed("an unwind address names no symbol"), "relocation", ri::u64)}; }
    var holder: Id[Input]  = id;
    var sym:    Id[Symbol] = rel.target.symbol;
    val own:    *Symbol    = object.symbol_at(o, sym);
    if (sel own.def.undefined) {
        val opt_winning: opt[resolve.Won] = resolve.winning(img.resolved, id, sym);
        if (sel opt_winning.none) { ret res[opt[u64], Fail].err{fail.in_indexed(fail.malformed("an unwind address names a symbol the link does not define"), "relocation", ri::u64)}; }
        holder = opt_winning.some.binding.input;
        sym    = opt_winning.some.binding.symbol;
    }
    if (resolve.library(img.resolved, holder)) { ret res[opt[u64], Fail].err{fail.in_indexed(fail.malformed("an unwind address names a symbol a library defines"), "relocation", ri::u64)}; }
    val def: *Definition = ?object.symbol_at(input.object_of(img.inputs, holder), sym).def;
    if (sel def.placed) {
        val off: i128 = def.placed.offset::i128 + rel.addend::i128;
        if (off < 0 || off > 0xffff_ffff_ffff_ffff) { ret res[opt[u64], Fail].err{fail.in_indexed(fail.malformed("an unwind address lies outside its section"), "relocation", ri::u64)}; }
        val res_pos: res[opt[layout.Position], Fail] = layout.locate(img.layout, img.pieces, Ref{input: holder, section: def.placed.section}, off::u64);
        if (sel res_pos.err)     { ret res[opt[u64], Fail].err{fail.in_indexed(res_pos.err, "relocation", ri::u64)}; }
        if (sel res_pos.ok.none) { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
        ret res[opt[u64], Fail].ok{opt[u64].some{res_pos.ok.some.address}};
    }
    ret res[opt[u64], Fail].err{fail.in_indexed(fail.unsupported("an unwind address names a symbol placed in no section"), "relocation", ri::u64)};
}

# whether an entry of `encoding` may share the entry before it
fun foldable(rules: *Encodings, encoding: u32) bool {
    val opt_unfoldable: opt[u32] = compact.unfoldable(rules);
    if (sel opt_unfoldable.some && (encoding & compact.MODE_MASK) == opt_unfoldable.some) { ret false; }
    ret true;
}

# `v` less `base`, the offset from the mach header a 32-bit field holds
fun offset_of(v: u64, base: u64) res[u32, Fail] {
    if (v < base || v - base > 0xffff_ffff) { ret res[u32, Fail].err{fail.overflow("an address of the unwind info lies outside 4 GiB of the mach header")}; }
    ret res[u32, Fail].ok{(v - base)::u32};
}

# the index of `encoding` among the `n` encodings at `p`, none when absent.
# a table holds at most COMPACT_MAX encodings
fun index_in(p: *u32, n: usize, encoding: u32) opt[usize] {
    var i: usize = 0;
    for (i < n) {
        if (p[i] == encoding) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# the working tables of a layout
rec Work {
    kept:   Vector[Entry];
    sorted: Vector[u32];
    freqs:  Vector[Frequency];
    common: Vector[u32];
    locals: Vector[u32];
    splits: Vector[Split];
    before: Vector[u32];
}

fun work_dnit(w: *Work) err[Fail] {
    var err_first: err[Fail] = vectors.dnit[Entry](?w.kept);
    err_first = fail.kept(err_first, vectors.dnit[u32](?w.sorted));
    err_first = fail.kept(err_first, vectors.dnit[Frequency](?w.freqs));
    err_first = fail.kept(err_first, vectors.dnit[u32](?w.common));
    err_first = fail.kept(err_first, vectors.dnit[u32](?w.locals));
    err_first = fail.kept(err_first, vectors.dnit[Split](?w.splits));
    ret fail.kept(err_first, vectors.dnit[u32](?w.before));
}

# the table of `entries`, sorted, folded and paged
fun lay(a: *A.Allocator, entries: *Vector[Entry], rules: *Encodings, base: u64, pers: *Vector[u32]) res[UnwindInfo, Fail] {
    var w: Work = Work{
        kept:   vector.init[Entry](a),
        sorted: vector.init[u32](a),
        freqs:  vector.init[Frequency](a),
        common: vector.init[u32](a),
        locals: vector.init[u32](a),
        splits: vector.init[Split](a),
        before: vector.init[u32](a),
    };
    var info: UnwindInfo = UnwindInfo{
        version:       VERSION,
        common:        vector.init[u32](a),
        personalities: vector.init[u32](a),
        index:         vector.init[UnwindIndex](a),
        lsdas:         vector.init[UnwindLsda](a),
        pages:         vector.init[UnwindPage](a),
    };
    var err_laid: err[Fail] = laid(?w, entries, rules, base, pers, ?info);
    err_laid = fail.kept(err_laid, work_dnit(?w));
    if (sel err_laid.err) {
        val err_dropped: err[Fail] = model.unwind_info_dnit(?info);
        ret res[UnwindInfo, Fail].err{err_laid.err};
    }
    ret res[UnwindInfo, Fail].ok{info};
}

# the personalities `pers`, then the table's steps
fun laid(w: *Work, entries: *Vector[Entry], rules: *Encodings, base: u64, pers: *Vector[u32], info: *UnwindInfo) err[Fail] {
    val err_extend: err[Fail] = vectors.extend[u32](?info.personalities, pers.data, vector.length[u32](pers));
    if (sel err_extend.err) { ret err[Fail].err{err_extend.err}; }
    ret steps(w, entries, rules, base, info);
}

fun steps(w: *Work, entries: *Vector[Entry], rules: *Encodings, base: u64, info: *UnwindInfo) err[Fail] {
    val err_fold: err[Fail] = fold(w, entries, rules);
    if (sel err_fold.err) { ret err_fold; }
    val err_rank: err[Fail] = rank(w);
    if (sel err_rank.err) { ret err_rank; }
    val err_paginate: err[Fail] = paginate(w);
    if (sel err_paginate.err) { ret err_paginate; }
    ret emit(w, entries, base, info);
}

# sort the entries by address, refusing two of one function, and keep each
# that cannot share the run before it: one of another encoding, one with
# language specific data or after one, or one whose encoding reads its own
# function's code
fun fold(w: *Work, entries: *Vector[Entry], rules: *Encodings) err[Fail] {
    val n: usize = vector.length[Entry](entries);
    sort.sort_by[Entry](entries.data, n, by_address);
    var i: usize = 0;
    for (i < n) {
        val e: Entry = entries.data[i];
        i = i + 1;
        if (i > 1 && entries.data[i - 2].address == e.address) {
            ret err[Fail].err{fail.malformed("two compact unwind entries describe one function")};
        }
        val k: usize = vector.length[Entry](?w.kept);
        if (k != 0) {
            val head: Entry = w.kept.data[k - 1];
            if (head.encoding == e.encoding && sel head.lsda.none && sel e.lsda.none && foldable(rules, e.encoding)) { cnt; }
        }
        val err_kept_pushed: err[Fail] = vectors.push[Entry](?w.kept, e);
        if (sel err_kept_pushed.err) { ret err[Fail].err{err_kept_pushed.err}; }
    }
    ret err[Fail].ok{};
}

# the common encodings: the folded entries' encodings by how often they
# occur, at most COMMON_MAX
fun rank(w: *Work) err[Fail] {
    val n: usize = vector.length[Entry](?w.kept);
    var i: usize = 0;
    for (i < n) {
        val err_sorted_pushed: err[Fail] = vectors.push[u32](?w.sorted, w.kept.data[i].encoding);
        if (sel err_sorted_pushed.err) { ret err[Fail].err{err_sorted_pushed.err}; }
        i = i + 1;
    }
    sort.sort_by[u32](w.sorted.data, n, by_encoding);
    i = 0;
    for (i < n) {
        val enc: u32   = w.sorted.data[i];
        var j:   usize = i;
        for (j < n && w.sorted.data[j] == enc) { j = j + 1; }
        val err_freqs_pushed: err[Fail] = vectors.push[Frequency](?w.freqs, Frequency{encoding: enc, count: j - i});
        if (sel err_freqs_pushed.err) { ret err[Fail].err{err_freqs_pushed.err}; }
        i = j;
    }
    val m: usize = vector.length[Frequency](?w.freqs);
    sort.sort_by[Frequency](w.freqs.data, m, by_frequency);
    i = 0;
    for (i < m && i < COMMON_MAX) {
        val err_common_pushed: err[Fail] = vectors.push[u32](?w.common, w.freqs.data[i].encoding);
        if (sel err_common_pushed.err) { ret err[Fail].err{err_common_pushed.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# split the folded entries into pages: a compressed page takes entries while
# its words last, each within 24 bits of its first function and its encoding
# common or one of its own, and a page that is not the last is regular when
# more entries fit that way
fun paginate(w: *Work) err[Fail] {
    val n:       usize    = vector.length[Entry](?w.kept);
    val common:  usize    = vector.length[u32](?w.common);
    val regular: usize    = (PAGE_BYTES::usize - linkedit_unwind.REGULAR_HEADER) / linkedit_unwind.REGULAR_ENTRY;
    val at:      Location = Location{record: "unwind info"};
    var i:       usize    = 0;
    for (i < n) {
        val first:     usize          = i;
        val res_limit: res[u64, Fail] = checked.add(at, w.kept.data[i].address, linkedit_unwind.COMPRESSED_OFFSET_MASK::u64);
        if (sel res_limit.err) { ret err[Fail].err{res_limit.err}; }
        val local_first: usize = vector.length[u32](?w.locals);
        var words:       usize = PAGE_WORDS - linkedit_unwind.COMPRESSED_HEADER / 4;
        for (words >= 1 && i < n) {
            val e:     *Entry = ?w.kept.data[i];
            val local: usize  = vector.length[u32](?w.locals) - local_first;
            if (e.address >= res_limit.ok) { brk; }
            val opt_in_common: opt[usize] = index_in(w.common.data, common, e.encoding);
            val opt_in_page:   opt[usize] = index_in(?w.locals.data[local_first], local, e.encoding);
            if (sel opt_in_common.some || sel opt_in_page.some) {
                i     = i + 1;
                words = words - 1;
            }
            or (words >= 2 && common + local < COMPACT_MAX) {
                val err_locals_pushed: err[Fail] = vectors.push[u32](?w.locals, e.encoding);
                if (sel err_locals_pushed.err) { ret err[Fail].err{err_locals_pushed.err}; }
                i     = i + 1;
                words = words - 2;
            }
            or { brk; }
        }
        var s: Split = Split{first: first, count: i - first, compressed: true, local_first: local_first, local_count: vector.length[u32](?w.locals) - local_first};
        if (i < n && s.count < regular) {
            s.count = n - first;
            if (s.count > regular) { s.count = regular; }
            s.compressed  = false;
            s.local_count = 0;
            vectors.truncate[u32](?w.locals, local_first);
            i = first + s.count;
        }
        val err_splits_pushed: err[Fail] = vectors.push[Split](?w.splits, s);
        if (sel err_splits_pushed.err) { ret err[Fail].err{err_splits_pushed.err}; }
    }
    ret err[Fail].ok{};
}

# the table's parts in order: the header, the common encodings, the
# personalities, the index and its sentinel, the language specific data and
# the pages, each page a whole 4 KiB
fun emit(w: *Work, entries: *Vector[Entry], base: u64, info: *UnwindInfo) err[Fail] {
    val at:     Location = Location{record: "unwind info"};
    val n:      usize    = vector.length[Entry](?w.kept);
    val common: usize    = vector.length[u32](?w.common);
    val pages:  usize    = vector.length[Split](?w.splits);
    var lsdas:  u32      = 0;
    var i:      usize    = 0;
    for (i < n) {
        val err_before_pushed: err[Fail] = vectors.push[u32](?w.before, lsdas);
        if (sel err_before_pushed.err) { ret err[Fail].err{err_before_pushed.err}; }
        val e: *Entry = ?w.kept.data[i];
        if (sel e.lsda.some) { lsdas = lsdas + 1; }
        i = i + 1;
    }
    val pers:     u64            = linkedit_unwind.HEADER_SIZE::u64 + 4 * common::u64;
    val index:    u64            = pers + 4 * vector.length[u32](?info.personalities)::u64;
    val lsda:     u64            = index + linkedit_unwind.INDEX_SIZE::u64 * (pages::u64 + 1);
    val level2:   u64            = lsda + linkedit_unwind.LSDA_SIZE::u64 * lsdas::u64;
    val res_size: res[u64, Fail] = checked.add(at, level2, PAGE_BYTES * pages::u64);
    if (sel res_size.err)          { ret err[Fail].err{res_size.err}; }
    if (res_size.ok > 0xffff_ffff) { ret err[Fail].err{fail.overflow("the unwind info passes 4 GiB, past what its offsets reach")}; }
    info.common_offset      = linkedit_unwind.HEADER_SIZE::u32;
    info.personality_offset = pers::u32;
    info.index_offset       = index::u32;
    info.size               = res_size.ok::u32;
    val err_extend: err[Fail] = vectors.extend[u32](?info.common, w.common.data, common);
    if (sel err_extend.err) { ret err[Fail].err{err_extend.err}; }
    var p: usize = 0;
    for (p < pages) {
        val s:             Split          = w.splits.data[p];
        val res_offset_of: res[u32, Fail] = offset_of(w.kept.data[s.first].address, base);
        if (sel res_offset_of.err) { ret err[Fail].err{res_offset_of.err}; }
        val err_index_pushed: err[Fail] = vectors.push[UnwindIndex](?info.index, UnwindIndex{
            function: res_offset_of.ok, page: (level2 + PAGE_BYTES * p::u64)::u32, lsda: (lsda + linkedit_unwind.LSDA_SIZE::u64 * w.before.data[s.first]::u64)::u32,
        });
        if (sel err_index_pushed.err) { ret err[Fail].err{err_index_pushed.err}; }
        val err_page_of: err[Fail] = page_of(w, s, base, info);
        if (sel err_page_of.err) { ret err[Fail].err{fail.in_indexed(err_page_of.err, "second-level page", p::u64)}; }
        p = p + 1;
    }
    var end: u64   = base;
    val all: usize = vector.length[Entry](entries);
    if (all != 0) {
        val last:     Entry          = entries.data[all - 1];
        val res_stop: res[u64, Fail] = checked.add(at, last.address, last.length::u64);
        if (sel res_stop.err) { ret err[Fail].err{res_stop.err}; }
        end = res_stop.ok;
    }
    val res_offset_of: res[u32, Fail] = offset_of(end, base);
    if (sel res_offset_of.err) { ret err[Fail].err{res_offset_of.err}; }
    val err_sentinel: err[Fail] = vectors.push[UnwindIndex](?info.index, UnwindIndex{function: res_offset_of.ok, page: 0, lsda: level2::u32});
    if (sel err_sentinel.err) { ret err[Fail].err{err_sentinel.err}; }
    i = 0;
    for (i < n) {
        val e: Entry = w.kept.data[i];
        i = i + 1;
        if (sel e.lsda.some) {
            val res_offset_of: res[u32, Fail] = offset_of(e.address, base);
            if (sel res_offset_of.err) { ret err[Fail].err{res_offset_of.err}; }
            val res_offset_of_some: res[u32, Fail] = offset_of(e.lsda.some, base);
            if (sel res_offset_of_some.err) { ret err[Fail].err{res_offset_of_some.err}; }
            val err_lsdas_pushed: err[Fail] = vectors.push[UnwindLsda](?info.lsdas, UnwindLsda{function: res_offset_of.ok, lsda: res_offset_of_some.ok});
            if (sel err_lsdas_pushed.err) { ret err[Fail].err{err_lsdas_pushed.err}; }
        }
    }
    ret err[Fail].ok{};
}

# the second-level page of the split `s`
fun page_of(w: *Work, s: Split, base: u64, info: *UnwindInfo) err[Fail] {
    val a: *A.Allocator = info.pages.a;
    if (!s.compressed) {
        var pg:          UnwindRegular = UnwindRegular{entry_offset: linkedit_unwind.REGULAR_HEADER::u16, entries: vector.init[UnwindEntry](a)};
        var err_regular: err[Fail]     = regular(w, s, base, ?pg);
        if (sel err_regular.ok) {
            val err_pages_pushed: err[Fail] = vectors.push[UnwindPage](?info.pages, UnwindPage.regular{pg});
            if (sel err_pages_pushed.ok) { ret err[Fail].ok{}; }
            ret fail.kept(err[Fail].err{err_pages_pushed.err}, vectors.dnit[UnwindEntry](?pg.entries));
        }
        ret fail.kept(err_regular, vectors.dnit[UnwindEntry](?pg.entries));
    }
    var pg: UnwindCompressed = UnwindCompressed{
        entry_offset:     linkedit_unwind.COMPRESSED_HEADER::u16,
        encodings_offset: (linkedit_unwind.COMPRESSED_HEADER + 4 * s.count)::u16,
        entries:          vector.init[u32](a),
        encodings:        vector.init[u32](a),
    };
    val err_compressed: err[Fail] = compressed(w, s, ?pg);
    if (sel err_compressed.ok) {
        val err_pages_pushed: err[Fail] = vectors.push[UnwindPage](?info.pages, UnwindPage.compressed{pg});
        if (sel err_pages_pushed.ok) { ret err[Fail].ok{}; }
        ret fail.kept(fail.kept(err[Fail].err{err_pages_pushed.err}, vectors.dnit[u32](?pg.entries)), vectors.dnit[u32](?pg.encodings));
    }
    ret fail.kept(fail.kept(err_compressed, vectors.dnit[u32](?pg.entries)), vectors.dnit[u32](?pg.encodings));
}

# the entries of a regular page: each function's offset and its encoding
fun regular(w: *Work, s: Split, base: u64, pg: *UnwindRegular) err[Fail] {
    var i: usize = 0;
    for (i < s.count) {
        val e:             Entry          = w.kept.data[s.first + i];
        val res_offset_of: res[u32, Fail] = offset_of(e.address, base);
        i = i + 1;
        if (sel res_offset_of.err) { ret err[Fail].err{res_offset_of.err}; }
        val err_entries_pushed: err[Fail] = vectors.push[UnwindEntry](?pg.entries, UnwindEntry{function: res_offset_of.ok, encoding: e.encoding});
        if (sel err_entries_pushed.err) { ret err[Fail].err{err_entries_pushed.err}; }
    }
    ret err[Fail].ok{};
}

# the entries and own encodings of a compressed page: each entry the index of
# its encoding, the common ones first, and its function's offset from the
# page's first
fun compressed(w: *Work, s: Split, pg: *UnwindCompressed) err[Fail] {
    val common:  usize     = vector.length[u32](?w.common);
    val own:     *u32      = ?w.locals.data[s.local_first];
    val start:   u64       = w.kept.data[s.first].address;
    val err_enc: err[Fail] = vectors.extend[u32](?pg.encodings, own, s.local_count);
    if (sel err_enc.err) { ret err[Fail].err{err_enc.err}; }
    var i: usize = 0;
    for (i < s.count) {
        val e:       Entry      = w.kept.data[s.first + i];
        val opt_idx: opt[usize] = encoding_index(w.common.data, common, own, s.local_count, e.encoding);
        i = i + 1;
        if (sel opt_idx.none) { ret err[Fail].err{fail.internal("a compressed page's entry has no encoding of its page")}; }
        val word:               u32       = (opt_idx.some::u32 << linkedit_unwind.COMPRESSED_OFFSET_BITS) | (e.address - start)::u32;
        val err_entries_pushed: err[Fail] = vectors.push[u32](?pg.entries, word);
        if (sel err_entries_pushed.err) { ret err[Fail].err{err_entries_pushed.err}; }
    }
    ret err[Fail].ok{};
}

# the index of `encoding` on a compressed page: among the `n` common ones at
# `common`, else past them among the page's `m` own at `own`
fun encoding_index(common: *u32, n: usize, own: *u32, m: usize, encoding: u32) opt[usize] {
    val opt_index_in: opt[usize] = index_in(common, n, encoding);
    if (sel opt_index_in.some) { ret opt_index_in; }
    val opt_index_in_own: opt[usize] = index_in(own, m, encoding);
    if (sel opt_index_in_own.some) { ret opt[usize].some{n + opt_index_in_own.some}; }
    ret opt[usize].none{};
}
