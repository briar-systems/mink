# the references the Mach-O linker makes itself
#
# each compact unwind entry's personality routine is reached through a GOT
# slot the entry's personality offset names, and where a lazy pointer leads
# to the stub helper, the helper's head calls the loader's lazy binder
# through a GOT slot of its own. each thread-local variable descriptor binds
# the accessor the system's loader provides at its first word.

use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.base.vectors;
use mink.catalog.os;
use mink.catalog.slot;
use mink.link.dynamic;
use mink.link.dynamic.Dynamic;
use mink.link.dynamic.Entry;
use mink.link.dynamic.Made;
use macho_unwind: mink.link.macho.unwind;

use std.collections.vector.Vector;

fun make(in: *dynamic.In, d: *Dynamic, out: *Vector[Made]) err[Fail] {
    val p: err[Fail] = macho_unwind.personalities(in, out);
    if (sel p.err) { ret p; }
    val t: err[Fail] = accessor(in, d, out);
    if (sel t.err)                                                      { ret t; }
    if (table.count[Entry](dynamic.entries_of(d, ?slot.LAZY_PTR)) == 0) { ret err[Fail].ok{}; }
    val text: res[str, Fail] = os.symbol_of(in.sys, ?os.STUB_BINDER);
    if (sel text.err) { ret err[Fail].err{text.err}; }
    val n: res[Id[Name], Fail] = intern.intern_str(in.names, text.ok);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val m: err[Fail] = vectors.push[Made](out, Made.named{n.ok});
    if (sel m.err) { ret err[Fail].err{m.err}; }
    ret err[Fail].ok{};
}

# the accessor the descriptors bind, where the link lays one
fun accessor(in: *dynamic.In, d: *Dynamic, out: *Vector[Made]) err[Fail] {
    if (table.count[Entry](dynamic.entries_of(d, ?slot.TLV)) == 0) { ret err[Fail].ok{}; }
    val text: res[str, Fail] = os.symbol_of(in.sys, ?os.TLV_BOOTSTRAP);
    if (sel text.err) { ret err[Fail].err{text.err}; }
    val n: res[Id[Name], Fail] = intern.intern_str(in.names, text.ok);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val m: err[Fail] = vectors.push[Made](out, Made.bound{n.ok});
    if (sel m.err) { ret err[Fail].err{m.err}; }
    ret err[Fail].ok{};
}

pub val MAKER: dynamic.Maker = dynamic.Maker{make: make};
