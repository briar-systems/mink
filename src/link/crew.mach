# the threads a link spreads its divisible steps over
#
# a crew runs the items of one step, each independent of the others once the
# serial phases before it fixed the facts they read. a step hands it a count
# and a function, and every item runs exactly once, on the caller's thread or
# on one of the crew's, its index taken in ascending order from one counter.
# each item writes only what its index owns and returns whether it held, and
# the step merges what the items made in index order once every item ran, so
# what a link makes never depends on which thread ran which item or when.
#
# a crew of one lane starts no thread: its items run in sequence on the
# caller's thread, the same calls in the same order. a crew of more lanes
# starts one thread fewer than its lanes, the caller's thread being lane
# zero, each thread with STACK_RESERVE of address space for its stack. an
# item that fails stops the items after it from starting, and every item
# before it runs, so the first failure in index order is the same at every
# lane count.
#
# the items of a step share the link's allocator, so a crew of more than one
# lane needs one that is safe to share between threads.

use std.system.capability;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;

$if (capability.HAS_CLOCK && capability.HAS_THREADS) {
    use std.sync.atomic;
    use std.sync.channel;
    use std.sync.thread;
    use std.sync.worker_pool;
}

# the address space each of a crew's threads reserves for its stack, as much
# as the thread that drives a link may hold, of which only what is touched is
# committed
pub val STACK_RESERVE: usize = 64 * 1024 * 1024;

# one item of a step: given the step's context, the lane it runs on, below
# the crew's lanes, and its index, it writes only what the index owns and
# what the lane owns, and returns whether it held
pub def Item: fun(ptr, u32, usize) bool;

# a step's items as the lanes take them
# ---
# context: the step's own, which every item reads
# run:     what runs each item
# count:   how many items
# next:    the index the next lane to ask takes
# failed:  the lowest index whose item failed, count while none did
rec Step {
    context: ptr;
    run:     Item;
    count:   usize;
    next:    i64;
    failed:  i64;
}

$if (capability.HAS_CLOCK && capability.HAS_THREADS) {
    # one thread's share of a step: the items it takes until none is left,
    # then its lane sent on the finished channel
    rec Share {
        step:     *Step;
        lane:     u32;
        finished: *channel.Channel[u32];
    }

    # a:        what the crew's storage is drawn from
    # lanes:    the lanes a step runs on, the caller's thread among them
    # pool:     the threads, one fewer than the lanes
    # queue:    the pool's queue, one task per thread
    # threads:  the pool's threads
    # workers:  the pool's worker records
    # shares:   each thread's share of the step running
    # finished: the lanes whose share ran out, which only the caller reads
    # slots:    the finished channel's storage
    # held:     how many of each record the storage holds
    pub rec Crew {
        a:        *A.Allocator;
        lanes:    u32;
        held:     usize;
        pool:     worker_pool.Pool;
        queue:    *worker_pool.Task;
        threads:  *thread.Thread;
        workers:  *worker_pool.Worker;
        shares:   *Share;
        finished: channel.Channel[u32];
        slots:    *u32;
    }
}
$or {
    # a host with no threads runs every crew on one lane
    pub rec Crew {
        a:     *A.Allocator;
        lanes: u32;
    }
}

# a crew of one lane, which starts no thread and holds nothing
pub fun init(a: *A.Allocator) Crew {
    ret Crew{a: a, lanes: 1};
}

# the lanes of `c`
pub fun lanes(c: *Crew) u32 {
    ret c.lanes;
}

# open `c`, made by init, to run its steps on `lanes` lanes, starting a
# thread for each lane past the caller's. none or one starts nothing, as a
# host with no threads does for any count, and a host that refuses a thread
# leaves `c` on one lane. `c` must not move while it is open,
# and is released by dnit whether or not opening it succeeds
pub fun open(c: *Crew, lanes: u32) err[Fail] {
    if (lanes <= 1) { ret err[Fail].ok{}; }
    $if (capability.HAS_CLOCK && capability.HAS_THREADS) {
        ret started(c, lanes);
    }
    $or {
        ret err[Fail].ok{};
    }
}

$if (capability.HAS_CLOCK && capability.HAS_THREADS) {
    fun started(c: *Crew, lanes: u32) err[Fail] {
        val n: usize = (lanes - 1)::usize;
        c.held = n;
        val res_queue: res[*worker_pool.Task, A.Error] = A.allocate[worker_pool.Task](c.a, n);
        if (sel res_queue.err) { ret err[Fail].err{fail.refused(res_queue.err)}; }
        c.queue = res_queue.ok;
        val res_threads: res[*thread.Thread, A.Error] = A.allocate[thread.Thread](c.a, n);
        if (sel res_threads.err) { ret err[Fail].err{fail.refused(res_threads.err)}; }
        c.threads = res_threads.ok;
        val res_workers: res[*worker_pool.Worker, A.Error] = A.allocate[worker_pool.Worker](c.a, n);
        if (sel res_workers.err) { ret err[Fail].err{fail.refused(res_workers.err)}; }
        c.workers = res_workers.ok;
        val res_shares: res[*Share, A.Error] = A.allocate[Share](c.a, n);
        if (sel res_shares.err) { ret err[Fail].err{fail.refused(res_shares.err)}; }
        c.shares = res_shares.ok;
        val res_slots: res[*u32, A.Error] = A.allocate[u32](c.a, n);
        if (sel res_slots.err) { ret err[Fail].err{fail.refused(res_slots.err)}; }
        c.slots = res_slots.ok;
        val err_channel: channel.Operation = channel.make[u32](?c.finished, c.slots, n);
        if (sel err_channel.err) { ret err[Fail].err{fail.internal("the channel of a crew's finished shares could not be made")}; }
        var config: thread.Config;
        thread.config_default(?config);
        config.stack_reserve = STACK_RESERVE;
        config.name          = "mink link";
        val made: worker_pool.Status = worker_pool.make_with_config(?c.pool, c.queue, n, c.threads, c.workers, n, ?config);
        if (sel made.spawn_failed) {
            # a refused spawn leaves the pool joined, and the crew runs on one lane
            val err_pool: worker_pool.Operation = worker_pool.dnit(?c.pool);
            dnit(c);
            ret err[Fail].ok{};
        }
        if (!sel made.accepted) { ret err[Fail].err{fail.internal("the threads of a crew could not be started")}; }
        c.lanes = lanes;
        ret err[Fail].ok{};
    }

    fun share_run(context: ptr) bool {
        val s: *Share = context::*Share;
        take(s.step, s.lane);
        val sent: channel.Status[u32] = channel.send[u32](s.finished, s.lane);
        ret sel sent.sent;
    }

    # run the items of `s` on the lane `lane` until none is left, or none
    # past a failure
    fun take(s: *Step, lane: u32) {
        for {
            val i: i64 = atomic.fetch_add(?s.next, 1);
            if (i >= s.count::i64)          { ret; }
            if (i > atomic.load(?s.failed)) { ret; }
            if (!s.run(s.context, lane, i::usize)) {
                var seen: i64 = atomic.load(?s.failed);
                for (i < seen) {
                    if (atomic.cas(?s.failed, ?seen, i)) { brk; }
                }
            }
        }
    }
}

# run the `count` items of a step through `run`, each given `context`, and
# answer the lowest index whose item failed, none when every item held. every
# item below that index ran and held, and an item above it may or may not
# have run, so the step tells which ran by what each wrote
pub fun each(c: *Crew, count: usize, context: ptr, run: Item) opt[usize] {
    $if (capability.HAS_CLOCK && capability.HAS_THREADS) {
        if (c.lanes > 1 && count > 1) { ret spread(c, count, context, run); }
    }
    var i: usize = 0;
    for (i < count) {
        if (!run(context, 0, i)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

$if (capability.HAS_CLOCK && capability.HAS_THREADS) {
    fun spread(c: *Crew, count: usize, context: ptr, run: Item) opt[usize] {
        var s:       Step  = Step{context: context, run: run, count: count, next: 0, failed: count::i64};
        var helpers: usize = (c.lanes - 1)::usize;
        if (helpers > count - 1) { helpers = count - 1; }
        # a share the pool refuses leaves its items to the lanes that run
        var handed: usize = 0;
        var k:      usize = 0;
        for (k < helpers) {
            c.shares[handed] = Share{step: ?s, lane: (handed + 1)::u32, finished: ?c.finished};
            val status: worker_pool.Status = worker_pool.submit(?c.pool, worker_pool.Task{context: (?c.shares[handed])::ptr, fn_run: share_run});
            if (sel status.accepted) { handed = handed + 1; }
            k = k + 1;
        }
        take(?s, 0);
        var back: usize = 0;
        for (back < handed) {
            val got: channel.Status[u32] = channel.receive[u32](?c.finished);
            if (!sel got.received) { brk; }
            back = back + 1;
        }
        if (s.failed < count::i64) { ret opt[usize].some{s.failed::usize}; }
        ret opt[usize].none{};
    }
}

# stop the crew's threads and give back what it holds. a crew of one lane
# holds nothing
pub fun dnit(c: *Crew) {
    $if (capability.HAS_CLOCK && capability.HAS_THREADS) {
        if (c.lanes > 1) {
            val closing:  worker_pool.Status    = worker_pool.close_drain(?c.pool);
            val joined:   worker_pool.Status    = worker_pool.join(?c.pool);
            val err_gone: worker_pool.Operation = worker_pool.dnit(?c.pool);
        }
        if (c.slots != nil) {
            val closed:      channel.Transition = channel.close[u32](?c.finished);
            val err_dropped: channel.Operation  = channel.dnit[u32](?c.finished);
        }
        if (c.queue != nil)   { A.deallocate[worker_pool.Task](c.a, c.queue, c.held); }
        if (c.threads != nil) { A.deallocate[thread.Thread](c.a, c.threads, c.held); }
        if (c.workers != nil) { A.deallocate[worker_pool.Worker](c.a, c.workers, c.held); }
        if (c.shares != nil)  { A.deallocate[Share](c.a, c.shares, c.held); }
        if (c.slots != nil)   { A.deallocate[u32](c.a, c.slots, c.held); }
    }
    @c = init(c.a);
}
