# how each output format's linker resolves symbols, lays an image out and
# binds it
#
# one row per format: how its linker searches archives, the hooks its own
# resolution rules join the resolve phase through, the rules layout reads, and
# the rules that decide what each reference needs across the image's boundary.
# a phase reads the row and never asks which format it is.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mink.catalog.format;
use mink.catalog.format.Format;
use mink.coff.import;
use coff_rules: mink.coff.rules;
use elf_rules:  mink.elf.rules;
use mink.fail;
use mink.fail.Fail;
use mink.link.dynamic;
use mink.link.layout;
use mink.link.layout.Rules;
use mink.link.relocate.Weak;
use mink.link.resolve;
use mink.link.resolve.Hooks;
use macho_rules: mink.macho.rules;
use mink.rule;

# format:  the output format
# search:  how its linker searches archives, and whether a common definition
#          pulls an archive member that defines its name as data
# hooks:   its resolution rules
# layout:  how its images are laid out, none for a format mink lays out no
#          image of yet
# dynamic: its dynamic linking rules
# weak:    how it resolves an undefined weak reference
pub rec Convention {
    format:  *Format;
    search:  resolve.Caps;
    hooks:   *Hooks;
    layout:  opt[*Rules];
    dynamic: *dynamic.Rules;
    weak:    Weak;
}

# GNU ld searches an archive once where it stands, link.exe, ld64 and wasm-ld
# search every archive again while a name is left undefined.
#
# a common definition pulls a member that defines its name as data in GNU ld,
# whose archive search includes the member when it defines a symbol held as
# common (elf_link_add_archive_symbols in bfd/elflink.c). lld does so only
# with --fortran-common, which the ELF row does not follow, since a mink link
# takes GNU ld as the reference. whether link.exe and ld64 do so is not
# verified, so the COFF and Mach-O rows leave the capability off. wasm objects
# have no common symbols and a SPIR-V or flat image has no archive search
val ELF:   Convention = Convention{format: ?format.ELF, search: resolve.COMMON_PULL, hooks: ?resolve.PLAIN, layout: opt[*Rules].some{?elf_rules.LAYOUT}, dynamic: ?elf_rules.DYNAMIC, weak: Weak.zero{}};
val COFF:  Convention = Convention{format: ?format.COFF, search: resolve.REVISIT, hooks: ?resolve.PLAIN, layout: opt[*Rules].some{?coff_rules.LAYOUT}, dynamic: ?coff_rules.DYNAMIC, weak: Weak.fallback{}};
val MACHO: Convention = Convention{format: ?format.MACHO, search: resolve.REVISIT, hooks: ?resolve.PLAIN, layout: opt[*Rules].some{?macho_rules.LAYOUT}, dynamic: ?macho_rules.DYNAMIC, weak: Weak.zero{}};
val WASM:  Convention = Convention{format: ?format.WASM, search: resolve.REVISIT, hooks: ?resolve.PLAIN, layout: opt[*Rules].none{}, dynamic: ?dynamic.UNBOUND, weak: Weak.unruled{}};
val SPIRV: Convention = Convention{format: ?format.SPIRV, search: 0, hooks: ?resolve.PLAIN, layout: opt[*Rules].none{}, dynamic: ?dynamic.UNBOUND, weak: Weak.unruled{}};
val FLAT:  Convention = Convention{format: ?format.FLAT, search: 0, hooks: ?resolve.PLAIN, layout: opt[*Rules].none{}, dynamic: ?dynamic.UNBOUND, weak: Weak.unruled{}};

val ROW_COUNT: usize                  = 6;
val ROWS:      [ROW_COUNT]*Convention = [ROW_COUNT]*Convention{?ELF, ?COFF, ?MACHO, ?WASM, ?SPIRV, ?FLAT};

# the convention of the output format `f`
pub fun of(f: *Format) res[*Convention, Fail] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].format == f) { ret res[*Convention, Fail].ok{ROWS[i]}; }
        i = i + 1;
    }
    ret res[*Convention, Fail].err{fail.in_record(fail.unsupported("the format has no symbol resolution convention"), f.name)};
}

test convention__every_decision_table_and_class_table_is_sound {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);
    var i: usize        = 0;
    for (i < ROW_COUNT) {
        var e: res[dynamic.Checked, Fail] = dynamic.check(ROWS[i].dynamic, a);
        if (sel e.err) { ret 1; }
        val de: err[Fail] = dynamic.release_checked(?e.ok);
        if (sel de.err) { ret 1; }
        val l: opt[*Rules] = ROWS[i].layout;
        if (sel l.some) {
            var c: res[rule.Index, Fail] = layout.check(l.some, a);
            if (sel c.err) { ret 1; }
            val ce: err[Fail] = rule.release(?c.ok);
            if (sel ce.err) { ret 1; }
        }
        i = i + 1;
    }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test convention__every_rule_table_is_pairwise_disjoint {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val d: err[Fail] = dynamic.disjoint(ROWS[i].dynamic);
        if (sel d.err) { ret 1; }
        val l: opt[*Rules] = ROWS[i].layout;
        if (sel l.some) {
            val c: err[Fail] = layout.disjoint(l.some);
            if (sel c.err) { ret 1; }
        }
        i = i + 1;
    }
    val f: err[Fail] = import.check_forms();
    if (sel f.err) { ret 1; }
    ret 0;
}
