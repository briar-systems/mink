# the native command line of a link
#
# one flag table whose rows each write one field of the link's options or of
# the command: the output kind, the output format, the target's architecture,
# system, environment, versions and subsystem, the entry, the kept names,
# keeping every section, keeping the temporary symbols, sharing the tails of
# merged strings, the state file and the output path. the operands are the input files, read in the order they
# are named. a flag no row names, a repeated flag and a value no catalog row
# names are refused, and a fact the link must be told is never filled in. the
# help text is built from the same rows.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;
use std.args;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use arch_list: mink.catalog.arch.list;
use mink.catalog.arch.spirv;
use mink.catalog.arch.wasm;
use mink.catalog.arch.x86;
use mink.catalog.kind;
use mink.catalog.os;
use mink.catalog.os.Env;
use mink.catalog.os.System;
use mink.catalog.os.Version;
use mink.catalog.os.linux;
use os_list: mink.catalog.os.list;
use mink.catalog.output;
use mink.catalog.subsystem;
use mink.catalog.subsystem.Subsystem;
use mink.format.contract;
use mink.format.file;
use mink.format.file.Loaded;
use mink.format.registration.Registration;
use mink.format.registry;
use mink.format.registry.Registry;
use spirv_fixture: mink.format.spirv.fixture;
use wasm_fixture:  mink.format.wasm.fixture;
use link_gather:   mink.link.gather;
use mink.link.input;
use mink.link.input.Inputs;
use mink.link.input.Source;
use mink.link.options.Options;
use mink.link.state;

# a link as its command line states it
# ---
# a:        the allocator its tables live in
# registry: the formats the link reads and writes
# options:  the link's options
# inputs:   the input files, in the order they are named
# keep:     the names kept, which options.keep points into
# output:   the path the image is written to
# env:      the environment's name, resolved against the system once every flag is read
# help:     the help page was asked for, and nothing else is read
pub rec Command {
    a:        *A.Allocator;
    registry: *Registry;
    options:  Options;
    inputs:   Table[str];
    keep:     Table[str];
    output:   str;
    env:      str;
    help:     bool;
}

# one flag and the field it writes
# ---
# flag: the flag as std.args reads it, first so that the flag is the row
# set:  write the flag's value, nil for a switch, into the command
rec Row {
    flag: args.Flag;
    set:  fun(*Command, str) err[Fail];
}

val OUTPUT:         Row = Row{flag: args.Flag{name: "--output", short: "-o", kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "path", doc: "write the image here"}, set: set_output};
val KIND:           Row = Row{flag: args.Flag{name: "--kind", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "kind", doc: "the output kind, such as static, pie or shared"}, set: set_kind};
val FORMAT:         Row = Row{flag: args.Flag{name: "--format", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "format", doc: "the output format, as `mink formats` names it"}, set: set_format};
val ARCH:           Row = Row{flag: args.Flag{name: "--arch", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "arch", doc: "the target architecture"}, set: set_arch};
val SYSTEM:         Row = Row{flag: args.Flag{name: "--system", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "system", doc: "the system the image runs on"}, set: set_system};
val ENV:            Row = Row{flag: args.Flag{name: "--env", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "env", doc: "the environment of the system"}, set: set_env};
val SYSTEM_VERSION: Row = Row{flag: args.Flag{name: "--system-version", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "x.y[.z]", doc: "the oldest system version the image runs on"}, set: set_system_version};
val SDK_VERSION:    Row = Row{flag: args.Flag{name: "--sdk-version", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "x.y[.z]", doc: "the SDK version the image is built against"}, set: set_sdk_version};
val SUBSYSTEM:      Row = Row{flag: args.Flag{name: "--subsystem", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "subsystem", doc: "the PE subsystem the image states, the system's when not given"}, set: set_subsystem};
val ENTRY:          Row = Row{flag: args.Flag{name: "--entry", short: "-e", kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "symbol", doc: "the entry symbol, the system's when not given"}, set: set_entry};
val KEEP:           Row = Row{flag: args.Flag{name: "--keep", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "symbol", doc: "keep this name whether referenced or not, once per name"}, set: set_keep};
val KEEP_ALL:       Row = Row{flag: args.Flag{name: "--keep-all", short: nil, kind: args.SWITCH, negatable: false, occurs: args.Occurs.once{}, value: nil, doc: "keep every input section"}, set: set_keep_all};
val TEMPORARIES:    Row = Row{flag: args.Flag{name: "--temporaries", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "kept|discarded", doc: "keep or leave out the assemblers' local labels, the format's default for the architecture when not given"}, set: set_temporaries};
val TAIL_MERGE:     Row = Row{flag: args.Flag{name: "--tail-merge", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "on|off", doc: "share or keep apart the tails of merged strings, the format's rule when not given"}, set: set_tail_merge};
val STATE:          Row = Row{flag: args.Flag{name: "--state", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "path", doc: "the link's state file"}, set: set_state};
val HELP:           Row = Row{flag: args.Flag{name: "--help", short: "-h", kind: args.SWITCH, negatable: false, occurs: args.Occurs.once{}, value: nil, doc: "show this page"}, set: set_help};

val ROW_COUNT: usize           = 16;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{?OUTPUT, ?KIND, ?FORMAT, ?ARCH, ?SYSTEM, ?ENV, ?SYSTEM_VERSION, ?SDK_VERSION, ?SUBSYSTEM, ?ENTRY, ?KEEP, ?KEEP_ALL, ?TEMPORARIES, ?TAIL_MERGE, ?STATE, ?HELP};

fun bad_value(f: Fail, value: str) err[Fail] {
    ret err[Fail].err{fail.about(f, value)};
}

fun set_output(c: *Command, v: str) err[Fail] {
    c.output = v;
    ret err[Fail].ok{};
}

fun set_kind(c: *Command, v: str) err[Fail] {
    val k: res[*output.Kind, Fail] = output.by_name(v);
    if (sel k.err) { ret bad_value(k.err, v); }
    c.options.kind = k.ok;
    ret err[Fail].ok{};
}

fun set_format(c: *Command, v: str) err[Fail] {
    val r: res[*Registration, Fail] = registry.by_name(c.registry, v);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    c.options.format = r.ok.format;
    ret err[Fail].ok{};
}

fun set_arch(c: *Command, v: str) err[Fail] {
    val r: res[*Arch, Fail] = arch_list.by_name(v);
    if (sel r.err) { ret bad_value(r.err, v); }
    c.options.target.arch = r.ok;
    ret err[Fail].ok{};
}

fun set_system(c: *Command, v: str) err[Fail] {
    val r: res[*System, Fail] = os_list.by_name(v);
    if (sel r.err) { ret bad_value(r.err, v); }
    c.options.target.system = opt[*System].some{r.ok};
    ret err[Fail].ok{};
}

fun set_env(c: *Command, v: str) err[Fail] {
    c.env = v;
    ret err[Fail].ok{};
}

fun set_system_version(c: *Command, v: str) err[Fail] {
    val r: res[Version, Fail] = version(v);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    c.options.target.version = opt[Version].some{r.ok};
    ret err[Fail].ok{};
}

fun set_sdk_version(c: *Command, v: str) err[Fail] {
    val r: res[Version, Fail] = version(v);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    c.options.target.sdk = opt[Version].some{r.ok};
    ret err[Fail].ok{};
}

fun set_subsystem(c: *Command, v: str) err[Fail] {
    val r: res[*Subsystem, Fail] = subsystem.by_name(v);
    if (sel r.err) { ret bad_value(r.err, v); }
    c.options.target.subsystem = opt[*Subsystem].some{r.ok};
    ret err[Fail].ok{};
}

fun set_entry(c: *Command, v: str) err[Fail] {
    c.options.entry = v;
    ret err[Fail].ok{};
}

fun set_keep(c: *Command, v: str) err[Fail] {
    val p: res[table.Id[str], Fail] = table.push[str](?c.keep, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_keep_all(c: *Command, v: str) err[Fail] {
    c.options.keep_all = true;
    ret err[Fail].ok{};
}

fun set_temporaries(c: *Command, v: str) err[Fail] {
    if (str_equals(v, "kept"))      { c.options.keep_temporaries = opt[bool].some{true}; }
    or (str_equals(v, "discarded")) { c.options.keep_temporaries = opt[bool].some{false}; }
    or                              { ret bad_value(fail.malformed("temporaries are `kept` or `discarded`"), v); }
    ret err[Fail].ok{};
}

fun set_tail_merge(c: *Command, v: str) err[Fail] {
    if (str_equals(v, "on"))  { c.options.tail_merge = opt[bool].some{true}; }
    or (str_equals(v, "off")) { c.options.tail_merge = opt[bool].some{false}; }
    or                        { ret bad_value(fail.malformed("tail merging is `on` or `off`"), v); }
    ret err[Fail].ok{};
}

fun set_state(c: *Command, v: str) err[Fail] {
    c.options.state = v;
    ret err[Fail].ok{};
}

fun set_help(c: *Command, v: str) err[Fail] {
    c.help = true;
    ret err[Fail].ok{};
}

# the decimal number of `text[at..]` up to a dot or the end, at most `max`,
# with `next` left at the byte after it
fun component(text: str, at: usize, max: u64, next: *usize) res[u64, Fail] {
    var i: usize = at;
    var n: u64   = 0;
    for (text[i] >= '0' && text[i] <= '9') {
        n = n * 10 + (text[i] - '0')::u64;
        if (n > max) { ret res[u64, Fail].err{fail.overflow("a version component is too large")}; }
        i = i + 1;
    }
    if (i == at) { ret res[u64, Fail].err{fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal")}; }
    @next = i;
    ret res[u64, Fail].ok{n};
}

# the version `text` writes as `major.minor` or `major.minor.patch`, a patch
# not written being zero as the notation states
pub fun version(text: str) res[Version, Fail] {
    var at:    usize          = 0;
    val major: res[u64, Fail] = component(text, at, 0xffff, ?at);
    if (sel major.err)   { ret res[Version, Fail].err{fail.about(major.err, text)}; }
    if (text[at] != '.') { ret res[Version, Fail].err{fail.about(fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal"), text)}; }
    val minor: res[u64, Fail] = component(text, at + 1, 0xff, ?at);
    if (sel minor.err) { ret res[Version, Fail].err{fail.about(minor.err, text)}; }
    var patch: u64 = 0;
    if (text[at] == '.') {
        val p: res[u64, Fail] = component(text, at + 1, 0xff, ?at);
        if (sel p.err) { ret res[Version, Fail].err{fail.about(p.err, text)}; }
        patch = p.ok;
    }
    if (text[at] != 0) { ret res[Version, Fail].err{fail.about(fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal"), text)}; }
    ret res[Version, Fail].ok{Version{major: major.ok::u16, minor: minor.ok::u8, patch: patch::u8}};
}

fun refusal(e: args.Error) Fail {
    if (sel e.unknown)       { ret fail.in_record(fail.malformed("unknown option"), e.unknown.flag); }
    or (sel e.missing_value) { ret fail.in_record(fail.malformed("needs a value"), e.missing_value.flag); }
    ret fail.in_record(fail.malformed("given more than once"), e.repeated.flag);
}

fun needs(row: *Row) err[Fail] {
    ret err[Fail].err{fail.in_record(fail.malformed("the link needs this flag"), row.flag.name)};
}

# the row of the flag `f` the reader matched. a row's flag is its first field
# and the reader reads only the rows' own flags, so the flag is the row
fun row_of(f: *args.Flag) *Row {
    ret f::*Row;
}

# check what the flags stated together, and resolve the environment against
# the system
fun finish(c: *Command) err[Fail] {
    if (c.help)                       { ret err[Fail].ok{}; }
    if (c.options.kind == nil)        { ret needs(?KIND); }
    if (c.options.format == nil)      { ret needs(?FORMAT); }
    if (c.options.target.arch == nil) { ret needs(?ARCH); }
    val system: opt[*System] = c.options.target.system;
    if (sel system.none)                  { ret needs(?SYSTEM); }
    if (c.output == nil)                  { ret needs(?OUTPUT); }
    if (table.count[str](?c.inputs) == 0) { ret err[Fail].err{fail.malformed("the link names no input file")}; }
    if (c.env != nil) {
        val e: res[*Env, Fail] = os_list.env_by_name(system.some, c.env);
        if (sel e.err) { ret err[Fail].err{fail.in_record(fail.about(e.err, c.env), ENV.flag.name)}; }
        c.options.target.env = opt[*Env].some{e.ok};
    }
    c.options.keep       = table.items[str](?c.keep);
    c.options.keep_count = table.count[str](?c.keep);
    ret err[Fail].ok{};
}

# read the command line `a` from argument `start` into `c`, whose tables live
# in `alloc` and whose formats are those of `g`. `c` is released by release
# whether or not reading succeeds
pub fun parse(c: *Command, alloc: *A.Allocator, g: *Registry, a: args.Args, start: usize) err[Fail] {
    @c = Command{a: alloc, registry: g, inputs: table.make[str](alloc), keep: table.make[str](alloc)};
    var flags:    [ROW_COUNT]*args.Flag;
    var settings: [ROW_COUNT]args.Setting;
    var i:        usize = 0;
    for (i < ROW_COUNT) {
        flags[i] = ?ROWS[i].flag;
        i        = i + 1;
    }
    var r: args.Reader = args.reader(a, start, ?flags[0], ROW_COUNT, ?settings[0]);
    for {
        val e: res[args.Event, args.Error] = args.read(?r);
        if (sel e.err)     { ret err[Fail].err{refusal(e.err)}; }
        if (sel e.ok.done) { brk; }
        if (sel e.ok.operand) {
            val p: res[table.Id[str], Fail] = table.push[str](?c.inputs, a.argv[e.ok.operand]::str);
            if (sel p.err) { ret err[Fail].err{p.err}; }
        }
        or (sel e.ok.hit) {
            val row: *Row      = row_of(e.ok.hit.flag);
            val s:   err[Fail] = row.set(c, e.ok.hit.value);
            if (sel s.err) { ret err[Fail].err{fail.in_record(s.err, row.flag.name)}; }
        }
    }
    ret finish(c);
}

fun spaces(out: *Sink, n: usize) err[Fail] {
    var i: usize = 0;
    for (i < n) {
        val w: err[Fail] = sink.text(out, " ");
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

val HELP_HEAD:   str   = "usage: mink link <input>... -o <path> --kind <kind> --format <format> --arch <arch> --system <system> [options]\n\nlink the input files, objects, archives and libraries, in the order they are named, into one image\n\noptions:\n";
val HELP_COLUMN: usize = 30;

# append the help page of the link command, one line per row
pub fun help(out: *Sink) err[Fail] {
    val h: err[Fail] = sink.text(out, HELP_HEAD);
    if (sel h.err) { ret h; }
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val f:    *args.Flag = ?ROWS[i].flag;
        var used: usize      = 2;
        val w0:   err[Fail]  = sink.text(out, "  ");
        if (sel w0.err) { ret w0; }
        if (f.short != nil) {
            val w1: err[Fail] = sink.text(out, f.short);
            if (sel w1.err) { ret w1; }
            val w2: err[Fail] = sink.text(out, ", ");
            if (sel w2.err) { ret w2; }
            used = used + str_len(f.short) + 2;
        }
        val w3: err[Fail] = sink.text(out, f.name);
        if (sel w3.err) { ret w3; }
        used = used + str_len(f.name);
        if (f.kind != args.SWITCH) {
            val w4: err[Fail] = sink.text(out, " <");
            if (sel w4.err) { ret w4; }
            val w5: err[Fail] = sink.text(out, f.value);
            if (sel w5.err) { ret w5; }
            val w6: err[Fail] = sink.text(out, ">");
            if (sel w6.err) { ret w6; }
            used = used + str_len(f.value) + 3;
        }
        var pad: usize = 2;
        if (used + 2 < HELP_COLUMN) { pad = HELP_COLUMN - used; }
        val w7: err[Fail] = spaces(out, pad);
        if (sel w7.err) { ret w7; }
        val w8: err[Fail] = sink.text(out, f.doc);
        if (sel w8.err) { ret w8; }
        val w9: err[Fail] = sink.text(out, "\n");
        if (sel w9.err) { ret w9; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the sources of a link: the `count` at `given`, then each input file loaded
# into `loaded`
fun gather(c: *Command, given: *Source, count: usize, loaded: *Table[Loaded], sources: *Table[Source]) err[Fail] {
    var i: usize = 0;
    for (i < count) {
        val p: res[table.Id[Source], Fail] = table.push[Source](sources, given[i]);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[str](?c.inputs)) {
        val l: res[Loaded, Fail] = file.load(c.a, @table.at[str](?c.inputs, table.nth[str](i)));
        if (sel l.err) { ret err[Fail].err{l.err}; }
        var held: Loaded                      = l.ok;
        val p:    res[table.Id[Loaded], Fail] = table.push[Loaded](loaded, held);
        if (sel p.err) { ret fail.kept(err[Fail].err{p.err}, file.unload(?held)); }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Loaded](loaded)) {
        val p: res[table.Id[Source], Fail] = table.push[Source](sources, Source.bytes{table.at[Loaded](loaded, table.nth[Loaded](i)).input});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# link what `c` states in one call: the `count` sources at `given`, objects
# a caller holds in memory among them, then the input files in the order
# they are named. the image's bytes are returned and the link's report is
# appended to `notes`
pub fun link(c: *Command, given: *Source, count: usize, notes: *Sink) res[Sink, Fail] {
    var loaded:  Table[Loaded] = table.make[Loaded](c.a);
    var sources: Table[Source] = table.make[Source](c.a);
    val g:       err[Fail]     = gather(c, given, count, ?loaded, ?sources);
    var out:     res[Sink, Fail];
    if (sel g.err) { out = res[Sink, Fail].err{g.err}; }
    or             { out = state.link(c.a, c.registry, c.options, table.items[Source](?sources), table.count[Source](?sources), notes); }
    var back: err[Fail] = err[Fail].ok{};
    var i:    usize     = 0;
    for (i < table.count[Loaded](?loaded)) {
        back = fail.kept(back, file.unload(table.at[Loaded](?loaded, table.nth[Loaded](i))));
        i    = i + 1;
    }
    back = fail.kept(back, table.release[Loaded](?loaded));
    back = fail.kept(back, table.release[Source](?sources));
    if (sel out.err) { ret out; }
    if (sel back.err) {
        var image:   Sink      = out.ok;
        val dropped: err[Fail] = sink.release(?image);
        ret res[Sink, Fail].err{back.err};
    }
    ret out;
}

# give back the command's tables
pub fun release(c: *Command) err[Fail] {
    val ri: err[Fail] = table.release[str](?c.inputs);
    ret fail.kept(ri, table.release[str](?c.keep));
}

fun names_version(v: opt[Version], major: u16, minor: u8, patch: u8) bool {
    if (sel v.none) { ret false; }
    ret v.some.major == major && v.some.minor == minor && v.some.patch == patch;
}

fun refused_at(e: err[Fail], record: str) bool {
    if (sel e.ok) { ret false; }
    ret sel e.err.cause.malformed && str_equals(e.err.at.record, record);
}

fun parsed(c: *Command, a: *A.Allocator, g: *Registry, argv: **u8, argc: usize) err[Fail] {
    ret parse(c, a, g, args.of(argc, argv), 2);
}

test command__each_flag_writes_its_field {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator        = T.allocator_of(?t);
    var g: res[Registry, Fail] = registry.builtin(a);
    if (sel g.err) { ret 1; }
    var v: [26]*u8   = [26]*u8{"mink", "link", "a.o", "-o", "out", "--kind", "static", "--format", "elf", "--arch", "x86_64", "--system", "linux", "--env", "gnu", "--system-version", "5.4.1", "--keep", "x", "b.a", "--keep", "y", "--temporaries", "discarded", "--tail-merge", "off",};
    var c: Command;
    val p: err[Fail] = parsed(?c, a, ?g.ok, ?v[0], 26);
    if (sel p.err)                                                                                                { ret 2; }
    if (table.count[str](?c.inputs) != 2 || !str_equals(@table.at[str](?c.inputs, table.nth[str](1)), "b.a"))     { ret 3; }
    if (!str_equals(c.output, "out") || c.options.kind != ?output.STATIC || c.options.target.arch != ?x86.X86_64) { ret 4; }
    val system: opt[*System] = c.options.target.system;
    val env:    opt[*Env]    = c.options.target.env;
    if (!(sel system.some && system.some == ?linux.LINUX) || !(sel env.some && env.some == ?linux.GNU)) { ret 5; }
    val ver: opt[Version] = c.options.target.version;
    if (!names_version(ver, 5, 4, 1))                                                           { ret 6; }
    if (c.options.keep_count != 2 || !str_equals(c.options.keep[1], "y") || c.options.keep_all) { ret 7; }
    val temporaries: opt[bool] = c.options.keep_temporaries;
    if (!(sel temporaries.some && !temporaries.some)) { ret 7; }
    val tails: opt[bool] = c.options.tail_merge;
    if (!(sel tails.some && !tails.some)) { ret 7; }
    val r: err[Fail] = release(?c);
    if (sel r.err) { ret 8; }
    val rg: err[Fail] = registry.release(?g.ok);
    if (sel rg.err || T.live_count(?t) != 0) { ret 9; }
    T.dnit(?t);
    ret 0;
}

test command__refuses_unknown_repeated_and_missing_flags {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator        = T.allocator_of(?t);
    var g: res[Registry, Fail] = registry.builtin(a);
    if (sel g.err) { ret 1; }
    var unknown:  [5]*u8    = [5]*u8{"mink", "link", "a.o", "--bogus", "x"};
    var repeated: [8]*u8    = [8]*u8{"mink", "link", "a.o", "--kind", "static", "-o", "o", "--kind=pie"};
    var missing:  [9]*u8    = [9]*u8{"mink", "link", "a.o", "-o", "o", "--kind", "static", "--arch", "x86_64"};
    var badver:   [4]*u8    = [4]*u8{"mink", "link", "--sdk-version", "11"};
    var c:        Command;
    val u:        err[Fail] = parsed(?c, a, ?g.ok, ?unknown[0], 5);
    val ru:       err[Fail] = release(?c);
    val r:        err[Fail] = parsed(?c, a, ?g.ok, ?repeated[0], 8);
    val rr:       err[Fail] = release(?c);
    val m:        err[Fail] = parsed(?c, a, ?g.ok, ?missing[0], 9);
    val rm:       err[Fail] = release(?c);
    val b:        err[Fail] = parsed(?c, a, ?g.ok, ?badver[0], 4);
    val rb:       err[Fail] = release(?c);
    if (!refused_at(u, "--bogus"))       { ret 2; }
    if (!refused_at(r, "--kind=pie"))    { ret 3; }
    if (!refused_at(m, "--format"))      { ret 4; }
    if (!refused_at(b, "--sdk-version")) { ret 5; }
    val rg: err[Fail] = registry.release(?g.ok);
    if (sel rg.err || T.live_count(?t) != 0) { ret 6; }
    T.dnit(?t);
    ret 0;
}

test command__subsystem_names_a_catalog_row {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator        = T.allocator_of(?t);
    var g: res[Registry, Fail] = registry.builtin(a);
    if (sel g.err) { ret 1; }
    var i: usize = 0;
    for (i < subsystem.count()) {
        var v:  [5]*u8          = [5]*u8{"mink", "link", "a.o", "--subsystem", subsystem.at(i).name::*u8};
        var c:  Command;
        val p:  err[Fail]       = parsed(?c, a, ?g.ok, ?v[0], 5);
        val s:  opt[*Subsystem] = c.options.target.subsystem;
        val ok: bool            = !(sel p.err) || refused_at(p, "--kind");
        val r:  err[Fail]       = release(?c);
        if (!ok || sel r.err)          { ret 2; }
        if (sel s.none)                { ret 3; }
        if (s.some != subsystem.at(i)) { ret 3; }
        i = i + 1;
    }
    var bad: [5]*u8    = [5]*u8{"mink", "link", "a.o", "--subsystem", "os2"};
    var c:   Command;
    val u:   err[Fail] = parsed(?c, a, ?g.ok, ?bad[0], 5);
    val ru:  err[Fail] = release(?c);
    if (sel u.ok)                                                                         { ret 4; }
    if (!str_equals(u.err.at.record, "--subsystem") || !str_equals(u.err.subject, "os2")) { ret 4; }
    val rg: err[Fail] = registry.release(?g.ok);
    if (sel rg.err || T.live_count(?t) != 0) { ret 5; }
    T.dnit(?t);
    ret 0;
}

# whether loading the module `bytes` as `file` for `target` through `g` is
# refused naming the file and the module kind, appending no input
#[testing]
fun refused_module(g: *Registry, a: *A.Allocator, file: str, target: *Arch, bytes: *Sink) bool {
    var out:  Inputs    = input.make(a);
    val l:    err[Fail] = link_gather.load(?g.readers, ?g.relocs, target, contract.Input{file: file, data: sink.data(bytes), len: sink.len(bytes)}, ?out);
    val none: bool      = input.count(?out) == 0;
    val rel:  err[Fail] = input.release(?out);
    if (sel rel.err || !none) { ret false; }
    if (!sel l.err)           { ret false; }
    val f: Fail = l.err;
    ret sel f.cause.unsupported && str_equals(f.at.file, file) && str_equals(f.subject, kind.MODULE.name);
}

test command__a_module_is_refused_as_a_link_input_naming_it_and_its_kind {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator        = T.allocator_of(?t);
    var g: res[Registry, Fail] = registry.builtin(a);
    if (sel g.err) { ret 1; }

    # a SPIR-V shader module declaring no Linkage, and a wasm module with no
    # linking section, each a module a runtime instantiates
    var shader: Sink      = sink.make(a, LITTLE);
    val ws:     err[Fail] = spirv_fixture.module(?shader, false);
    var module: Sink      = sink.make(a, LITTLE);
    val wm:     err[Fail] = wasm_fixture.module(?module);
    if (sel ws.err || sel wm.err)                                        { ret 1; }
    if (!refused_module(?g.ok, a, "shader.spv", ?spirv.SPIRV, ?shader))  { ret 2; }
    if (!refused_module(?g.ok, a, "module.wasm", ?wasm.WASM32, ?module)) { ret 3; }

    val r1: err[Fail] = sink.release(?module);
    val r2: err[Fail] = sink.release(?shader);
    val r3: err[Fail] = registry.release(?g.ok);
    if (sel r1.err || sel r2.err || sel r3.err) { ret 4; }
    if (T.live_count(?t) != 0)                  { ret 4; }
    T.dnit(?t);
    ret 0;
}
