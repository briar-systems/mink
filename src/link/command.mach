# the native command line of a link
#
# one flag table whose rows each write one field of the link's options or of
# the command: the output kind, the output format, the target's architecture,
# system, environment, versions and subsystem, the entry, the kept names,
# collecting what nothing reaches, keeping the temporary symbols, sharing the
# tails of merged strings, the image base, the placed sections, the memory
# regions, the regions a section runs and loads in, a section's offset, the
# image's size and fill, whether it requires the timing mode, the state file
# and the output path. the operands are
# the input files, and libraries and frameworks are named by flags among them,
# all read in the order they are named, each library loaded when nothing
# references it as the as-needed switch before it states, and searched for
# static or shared first as the static-first switch before it states. the
# directories a
# name is searched in and the root they lie under are flags too. a flag no row
# names, a flag repeated where its row takes one and a value no catalog row
# names are refused, and a fact the link must be told is never filled in. the
# help text is built from the same rows.
#
# the placement rows are the keys of a link plan too: a plan's line is applied
# through the row its key names, where the plan flag stands among the flags,
# so a plan and the flags it spells give the same options. a plan key no
# placement row names is refused, and a key stated by both a plan and a flag
# counts as given twice. a value of several fields separates them by commas,
# the fields after the first split from the right, so a section's name may
# hold a comma. a region a statement names resolves once every flag is read.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.args;
use std.collections.map;
use std.collections.map.MapBy;
use std.crypto.hash.fnv1a;
use std.text.parse.ParseError;
use std.text.parse.parse_u64_exact;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.compress;
use mink.bytes.compress.Method;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use arch_list: mink.catalog.arch.list;
use mink.catalog.kind;
use mink.catalog.os.Env;
use mink.catalog.os.System;
use mink.catalog.os.Version;
use os_list: mink.catalog.os.list;
use mink.catalog.output;
use mink.catalog.subsystem;
use mink.catalog.subsystem.Subsystem;
use mink.format.registration.Registration;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.link.input.Include;
use mink.link.input.Source;
use mink.link.layout;
use mink.link.options.Area;
use mink.link.options.Offset;
use mink.link.options.Options;
use mink.link.options.Within;
use mink.link.plan;
use mink.link.search;
use mink.link.search.Prefer;
use mink.link.search.Request;
use mink.link.search.Wanted;

# a link as its command line states it
# ---
# a:        the allocator its tables live in
# registry: the formats the link reads and writes
# options:  the link's options
# inputs:   the input files, libraries and frameworks, in the order they
#           are named
# keep:     the names kept, which options.keep points into
# sections: the sections placed ahead of the rest, which options.sections
#           points into
# regions:  the memory regions stated, which options.regions points into
# runs:     the sections stated to run in a region, by the region's name
# loads:    the sections stated to load in a region, by the region's name
# ran:      the runs with their regions resolved, which options.runs
#           points into
# loaded:   the loads with their regions resolved, which options.loads
#           points into
# offsets:  the sections stated at an offset, which options.offsets points
#           into
# pieces:   the fields copied out of values, each a zero after it, which
#           the statements point into
# plan:     the link plan read, whose text the values it stated point into
# settings: what each row was given, by the flags and the plan together
# env:      the environment's name, resolved against the system once every flag is read
# help:     the help page was asked for, and nothing else is read
# include:  how a library named from here on is included, as the as-needed
#           switch last stated
# prefer:   which files a library named from here on is searched for first,
#           as the static-first switch last stated
# libdirs:  the library directories stated, which options.libdirs
#           points into
# fwdirs:   the framework directories stated, which options.fwdirs
#           points into
# found:    what the link's search makes, which its refusal may point into
pub rec Command {
    a:        *A.Allocator;
    registry: *Registry;
    options:  Options;
    inputs:   Table[Request];
    keep:     Table[str];
    sections: Table[str];
    regions:  Table[Area];
    runs:     Table[Named];
    loads:    Table[Named];
    ran:      Table[Within];
    loaded:   Table[Within];
    offsets:  Table[Offset];
    pieces:   Table[str];
    plan:     plan.Plan;
    settings: [ROW_COUNT]args.Setting;
    env:      str;
    help:     bool;
    include:  Include;
    prefer:   Prefer;
    libdirs:  Table[str];
    fwdirs:   Table[str];
    found:    search.Found;
}

# an output section stated to lie in the region of a name
pub rec Named {
    section: str;
    region:  str;
}

# one flag and the field it writes
# ---
# flag:      the flag as std.args reads it, first so that the flag is the row
# placement: the flag states where the image's bytes go, and is a key of a
#            link plan, spelled as its long name without the dashes
# set:       write the flag's value, nil for a switch, into the command, with
#            whether a switch was given rather than negated
rec Row {
    flag:      args.Flag;
    placement: bool;
    set:       fun(*Command, str, bool) err[Fail];
}

val OUTPUT:         Row = Row{flag: args.Flag{name: "--output", short: "-o", kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "path", doc: "write the image here"}, placement: false, set: set_output};
val KIND:           Row = Row{flag: args.Flag{name: "--kind", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "kind", doc: "the output kind, such as static, pie or shared"}, placement: false, set: set_kind};
val FORMAT:         Row = Row{flag: args.Flag{name: "--format", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "format", doc: "the output format, as `mink formats` names it"}, placement: false, set: set_format};
val ARCH:           Row = Row{flag: args.Flag{name: "--arch", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "arch", doc: "the target architecture"}, placement: false, set: set_arch};
val SYSTEM:         Row = Row{flag: args.Flag{name: "--system", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "system", doc: "the system the image runs on"}, placement: false, set: set_system};
val ENV:            Row = Row{flag: args.Flag{name: "--env", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "env", doc: "the environment of the system"}, placement: false, set: set_env};
val SYSTEM_VERSION: Row = Row{flag: args.Flag{name: "--system-version", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "x.y[.z]", doc: "the oldest system version the image runs on"}, placement: false, set: set_system_version};
val SDK_VERSION:    Row = Row{flag: args.Flag{name: "--sdk-version", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "x.y[.z]", doc: "the SDK version the image is built against"}, placement: false, set: set_sdk_version};
val SUBSYSTEM:      Row = Row{flag: args.Flag{name: "--subsystem", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "subsystem", doc: "the PE subsystem the image states, the system's when not given"}, placement: false, set: set_subsystem};
val ENTRY:          Row = Row{flag: args.Flag{name: "--entry", short: "-e", kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "symbol", doc: "the entry symbol, the system's when not given"}, placement: false, set: set_entry};
val KEEP:           Row = Row{flag: args.Flag{name: "--keep", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "symbol", doc: "keep this name whether referenced or not, once per name"}, placement: false, set: set_keep};
val GC_SECTIONS:    Row = Row{flag: args.Flag{name: "--gc-sections", short: nil, kind: args.SWITCH, negatable: true, occurs: args.Occurs.override{}, value: nil, doc: "leave out the sections nothing reaches, or keep them with --no-gc-sections, the format's default when not given"}, placement: false, set: set_gc_sections};
val TEMPORARIES:    Row = Row{flag: args.Flag{name: "--temporaries", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "kept|discarded", doc: "keep or leave out the assemblers' local labels, the format's default for the architecture when not given"}, placement: false, set: set_temporaries};
val TAIL_MERGE:     Row = Row{flag: args.Flag{name: "--tail-merge", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "on|off", doc: "share or keep apart the tails of merged strings, the format's rule when not given"}, placement: false, set: set_tail_merge};
val COMPRESS:       Row = Row{flag: args.Flag{name: "--compress-debug-sections", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "none|zlib|zstd", doc: "compress the non-alloc debug sections of the image, none when not given"}, placement: false, set: set_compress};
val BASE:           Row = Row{flag: args.Flag{name: "--base", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "address", doc: "the address the image is laid out from, the host's when not given"}, placement: true, set: set_base};
val SECTION:        Row = Row{flag: args.Flag{name: "--section", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "name", doc: "place this output section ahead of the rest, in the order named, once per section"}, placement: true, set: set_section};
val REGION:         Row = Row{flag: args.Flag{name: "--region", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "name,origin,length,rwx", doc: "state a memory region: its name, start, size in bytes and the access it allows of r, w and x, once per region"}, placement: true, set: set_region};
val RUN_REGION:     Row = Row{flag: args.Flag{name: "--run-region", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "section,region", doc: "run this output section in this region, once per section"}, placement: true, set: set_run_region};
val LOAD_REGION:    Row = Row{flag: args.Flag{name: "--load-region", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "section,region", doc: "load this output section's bytes in this region, where it runs when not given, once per section"}, placement: true, set: set_load_region};
val OFFSET:         Row = Row{flag: args.Flag{name: "--offset", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "section,offset", doc: "start this output section at this offset from the start of the region it runs in, from the image base when it runs in none, once per section"}, placement: true, set: set_offset};
val SIZE:           Row = Row{flag: args.Flag{name: "--size", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "bytes", doc: "the most bytes the image loads from its base, refusing a larger one, and a flat image is padded to exactly this many"}, placement: true, set: set_size};
val FILL:           Row = Row{flag: args.Flag{name: "--fill", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "byte", doc: "the byte every byte of a flat image no section loads holds, zero when not given"}, placement: true, set: set_fill};
val LIBRARY:        Row = Row{flag: args.Flag{name: "--library", short: "-l", kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "name", doc: "link the library of this name, found in the library directories, where it stands among the input files"}, placement: false, set: set_library};
val FRAMEWORK:      Row = Row{flag: args.Flag{name: "--framework", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "name", doc: "link the framework of this name, found in the framework directories, where it stands among the input files"}, placement: false, set: set_framework};
val LIBRARY_DIR:    Row = Row{flag: args.Flag{name: "--library-dir", short: "-L", kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "dir", doc: "search this directory for a library ahead of the system's, once per directory"}, placement: false, set: set_library_dir};
val FRAMEWORK_DIR:  Row = Row{flag: args.Flag{name: "--framework-dir", short: "-F", kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "dir", doc: "search this directory for a framework ahead of the system's, once per directory"}, placement: false, set: set_framework_dir};
val SYSROOT:        Row = Row{flag: args.Flag{name: "--sysroot", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "path", doc: "search the system's library and framework directories under this root, the host's own when not given"}, placement: false, set: set_sysroot};
val AS_NEEDED:      Row = Row{flag: args.Flag{name: "--as-needed", short: nil, kind: args.SWITCH, negatable: true, occurs: args.Occurs.override{}, value: nil, doc: "load each library named after it only when a live import references it, or whether or not with --no-as-needed, the format's rule when not given"}, placement: false, set: set_as_needed};
val STATIC_FIRST:   Row = Row{flag: args.Flag{name: "--static-first", short: nil, kind: args.SWITCH, negatable: true, occurs: args.Occurs.override{}, value: nil, doc: "search each library named after it for its archive before its shared library, falling back to it, or shared first with --no-static-first, as the system's linker does when not given"}, placement: false, set: set_static_first};
val TIMING_MODE:    Row = Row{flag: args.Flag{name: "--require-timing-mode", short: nil, kind: args.SWITCH, negatable: false, occurs: args.Occurs.once{}, value: nil, doc: "mark the image as requiring the timing mode under which data independent timing holds, which its start-up checks"}, placement: false, set: set_timing_mode};
val PLAN:           Row = Row{flag: args.Flag{name: "--plan", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "path", doc: "read placement flags from this link plan, a `key = value` line each"}, placement: false, set: set_plan};
val STATE:          Row = Row{flag: args.Flag{name: "--state", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "path", doc: "the link's state file"}, placement: false, set: set_state};
val HELP:           Row = Row{flag: args.Flag{name: "--help", short: "-h", kind: args.SWITCH, negatable: false, occurs: args.Occurs.once{}, value: nil, doc: "show this page"}, placement: false, set: set_help};

val ROW_COUNT: usize           = 34;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{?OUTPUT, ?KIND, ?FORMAT, ?ARCH, ?SYSTEM, ?ENV, ?SYSTEM_VERSION, ?SDK_VERSION, ?SUBSYSTEM, ?ENTRY, ?KEEP, ?GC_SECTIONS, ?TEMPORARIES, ?TAIL_MERGE, ?COMPRESS, ?BASE, ?SECTION, ?REGION, ?RUN_REGION, ?LOAD_REGION, ?OFFSET, ?SIZE, ?FILL, ?LIBRARY, ?FRAMEWORK, ?LIBRARY_DIR, ?FRAMEWORK_DIR, ?SYSROOT, ?AS_NEEDED, ?STATIC_FIRST, ?TIMING_MODE, ?PLAN, ?STATE, ?HELP};

fun bad_value(f: Fail, value: str) err[Fail] {
    ret err[Fail].err{fail.about(f, value)};
}

fun set_output(c: *Command, v: str, on: bool) err[Fail] {
    c.options.output = v;
    ret err[Fail].ok{};
}

fun set_kind(c: *Command, v: str, on: bool) err[Fail] {
    val k: res[*output.Kind, Fail] = output.by_name(v);
    if (sel k.err) { ret bad_value(k.err, v); }
    c.options.kind = k.ok;
    ret err[Fail].ok{};
}

fun set_format(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[*Registration, Fail] = registry.by_name(c.registry, v);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    c.options.format = r.ok.format;
    ret err[Fail].ok{};
}

fun set_arch(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[*Arch, Fail] = arch_list.by_name(v);
    if (sel r.err) { ret bad_value(r.err, v); }
    c.options.target.arch = r.ok;
    ret err[Fail].ok{};
}

fun set_system(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[*System, Fail] = os_list.by_name(v);
    if (sel r.err) { ret bad_value(r.err, v); }
    c.options.target.system = opt[*System].some{r.ok};
    ret err[Fail].ok{};
}

fun set_env(c: *Command, v: str, on: bool) err[Fail] {
    c.env = v;
    ret err[Fail].ok{};
}

fun set_system_version(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[Version, Fail] = version(v);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    c.options.target.version = opt[Version].some{r.ok};
    ret err[Fail].ok{};
}

fun set_sdk_version(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[Version, Fail] = version(v);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    c.options.target.sdk = opt[Version].some{r.ok};
    ret err[Fail].ok{};
}

fun set_subsystem(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[*Subsystem, Fail] = subsystem.by_name(v);
    if (sel r.err) { ret bad_value(r.err, v); }
    c.options.target.subsystem = opt[*Subsystem].some{r.ok};
    ret err[Fail].ok{};
}

fun set_entry(c: *Command, v: str, on: bool) err[Fail] {
    c.options.entry = v;
    ret err[Fail].ok{};
}

fun set_keep(c: *Command, v: str, on: bool) err[Fail] {
    val p: res[table.Id[str], Fail] = table.push[str](?c.keep, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_gc_sections(c: *Command, v: str, on: bool) err[Fail] {
    c.options.gc_sections = opt[bool].some{on};
    ret err[Fail].ok{};
}

fun set_temporaries(c: *Command, v: str, on: bool) err[Fail] {
    if (str_equals(v, "kept"))      { c.options.keep_temporaries = opt[bool].some{true}; }
    or (str_equals(v, "discarded")) { c.options.keep_temporaries = opt[bool].some{false}; }
    or                              { ret bad_value(fail.malformed("temporaries are `kept` or `discarded`"), v); }
    ret err[Fail].ok{};
}

fun set_tail_merge(c: *Command, v: str, on: bool) err[Fail] {
    if (str_equals(v, "on"))  { c.options.tail_merge = opt[bool].some{true}; }
    or (str_equals(v, "off")) { c.options.tail_merge = opt[bool].some{false}; }
    or                        { ret bad_value(fail.malformed("tail merging is `on` or `off`"), v); }
    ret err[Fail].ok{};
}

fun set_compress(c: *Command, v: str, on: bool) err[Fail] {
    if (str_equals(v, "none")) {
        c.options.compress = opt[*Method].none{};
        ret err[Fail].ok{};
    }
    val m: res[*Method, Fail] = compress.by_name(v);
    if (sel m.err) { ret err[Fail].err{m.err}; }
    val w: err[Fail] = compress.writes(m.ok);
    if (sel w.err) { ret bad_value(w.err, v); }
    c.options.compress = opt[*Method].some{m.ok};
    ret err[Fail].ok{};
}

# the number `v` writes, in decimal or after a 0x, 0o or 0b prefix
fun number(v: str) res[u64, Fail] {
    val n: res[u64, ParseError] = parse_u64_exact(v, 0);
    if (sel n.err) {
        val e: ParseError = n.err;
        if (sel e.overflow) { ret res[u64, Fail].err{fail.about(fail.overflow("a number does not fit in 64 bits"), v)}; }
        ret res[u64, Fail].err{fail.about(fail.malformed("a number is written in decimal or after a 0x, 0o or 0b prefix"), v)};
    }
    ret res[u64, Fail].ok{n.ok};
}

fun set_base(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    c.options.base = opt[u64].some{n.ok};
    ret err[Fail].ok{};
}

fun set_section(c: *Command, v: str, on: bool) err[Fail] {
    val p: res[table.Id[str], Fail] = table.push[str](?c.sections, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the most fields a value holds
val FIELDS: usize = 4;

# split `v` into `n` fields, two or more, at its last `n - 1` commas into
# `out`, the last
# borrowed from `v` and every other copied into the command's pieces. a
# value with fewer commas or an empty field is refused as `grammar` states
fun fields(c: *Command, v: str, n: usize, grammar: str, out: *str) err[Fail] {
    val len:  usize = str_len(v);
    var stop: usize = len;
    var k:    usize = n;
    for (k > 1) {
        var at:    usize = stop;
        var found: bool  = false;
        for (at > 0 && !found) {
            at = at - 1;
            if (v[at] == ',') { found = true; }
        }
        if (!found || at + 1 == stop) { ret bad_value(fail.malformed(grammar), v); }
        if (k == n)                   { out[k - 1] = (?v[at + 1])::str; }
        or {
            val p: res[str, Fail] = piece(c, v, at + 1, stop - at - 1);
            if (sel p.err) { ret err[Fail].err{p.err}; }
            out[k - 1] = p.ok;
        }
        stop = at;
        k    = k - 1;
    }
    if (stop == 0) { ret bad_value(fail.malformed(grammar), v); }
    val p: res[str, Fail] = piece(c, v, 0, stop);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    out[0] = p.ok;
    ret err[Fail].ok{};
}

# the `len` bytes of `v` from `at`, copied with a zero after them into the
# command's pieces
fun piece(c: *Command, v: str, at: usize, len: usize) res[str, Fail] {
    val s: res[str, StrError] = str_copy_slice(c.a, v, at, len);
    if (sel s.err) {
        val e: StrError = s.err;
        if (sel e.alloc) { ret res[str, Fail].err{fail.refused(e.alloc)}; }
        ret res[str, Fail].err{fail.internal("a field lies outside its value")};
    }
    val p: res[table.Id[str], Fail] = table.push[str](?c.pieces, s.ok);
    if (sel p.err) {
        val d: err[A.Error] = A.deallocate[char](c.a, s.ok, len + 1);
        ret res[str, Fail].err{p.err};
    }
    ret res[str, Fail].ok{s.ok};
}

# the access `v` writes as r, w and x, each at most once
fun access(v: str) res[u8, Fail] {
    var bits: u8    = 0;
    var i:    usize = 0;
    for (v[i] != 0) {
        var bit: u8 = 0;
        if (v[i] == 'r')                   { bit = layout.READABLE; }
        or (v[i] == 'w')                   { bit = layout.WRITABLE; }
        or (v[i] == 'x')                   { bit = layout.EXECUTABLE; }
        if (bit == 0 || (bits & bit) != 0) { ret res[u8, Fail].err{fail.about(fail.malformed("a region's access is some of r, w and x, each once"), v)}; }
        bits = bits | bit;
        i    = i + 1;
    }
    if (bits == 0) { ret res[u8, Fail].err{fail.about(fail.malformed("a region's access is some of r, w and x, each once"), v)}; }
    ret res[u8, Fail].ok{bits};
}

fun set_region(c: *Command, v: str, on: bool) err[Fail] {
    var f: [FIELDS]str;
    val s: err[Fail] = fields(c, v, 4, "a region is `name,origin,length,access`", ?f[0]);
    if (sel s.err) { ret s; }
    val origin: res[u64, Fail] = number(f[1]);
    if (sel origin.err) { ret err[Fail].err{origin.err}; }
    val length: res[u64, Fail] = number(f[2]);
    if (sel length.err) { ret err[Fail].err{length.err}; }
    val bits: res[u8, Fail] = access(f[3]);
    if (sel bits.err) { ret err[Fail].err{bits.err}; }
    val p: res[table.Id[Area], Fail] = table.push[Area](?c.regions, Area{name: f[0], origin: origin.ok, length: length.ok, access: bits.ok});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the section and the region's name `v` states, into `into`
fun named_region(c: *Command, v: str, into: *Table[Named]) err[Fail] {
    var f: [FIELDS]str;
    val s: err[Fail] = fields(c, v, 2, "a section in a region is `section,region`", ?f[0]);
    if (sel s.err) { ret s; }
    val p: res[table.Id[Named], Fail] = table.push[Named](into, Named{section: f[0], region: f[1]});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_run_region(c: *Command, v: str, on: bool) err[Fail] {
    ret named_region(c, v, ?c.runs);
}

fun set_load_region(c: *Command, v: str, on: bool) err[Fail] {
    ret named_region(c, v, ?c.loads);
}

fun set_offset(c: *Command, v: str, on: bool) err[Fail] {
    var f: [FIELDS]str;
    val s: err[Fail] = fields(c, v, 2, "a section's offset is `section,offset`", ?f[0]);
    if (sel s.err) { ret s; }
    val n: res[u64, Fail] = number(f[1]);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val p: res[table.Id[Offset], Fail] = table.push[Offset](?c.offsets, Offset{section: f[0], offset: n.ok});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_timing_mode(c: *Command, v: str, on: bool) err[Fail] {
    c.options.timing_mode = on;
    ret err[Fail].ok{};
}

fun set_size(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    c.options.size = opt[u64].some{n.ok};
    ret err[Fail].ok{};
}

fun set_fill(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err)   { ret err[Fail].err{n.err}; }
    if (n.ok > 0xff) { ret bad_value(fail.overflow("a fill is one byte"), v); }
    c.options.fill = opt[u8].some{n.ok::u8};
    ret err[Fail].ok{};
}

# read the plan at `v` and apply each of its lines through its key's row
fun set_plan(c: *Command, v: str, on: bool) err[Fail] {
    val r: err[Fail] = plan.read(?c.plan, c.a, v);
    if (sel r.err) { ret r; }
    var i: usize = 0;
    for (i < table.count[plan.Line](?c.plan.lines)) {
        val l: *plan.Line = table.at[plan.Line](?c.plan.lines, table.nth[plan.Line](i));
        val s: err[Fail]  = stated(c, l);
        if (sel s.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(s.err, "line", l.line), v)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the index of the row whose long name, without its dashes, is `key`
fun key_row(key: str) opt[usize] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val name: str = ROWS[i].flag.name;
        if (str_equals((?name[2])::str, key)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# apply the plan line `l` through the placement row its key names, counted
# with the flags' occurrences of that row
fun stated(c: *Command, l: *plan.Line) err[Fail] {
    val k: opt[usize] = key_row(l.key);
    if (sel k.none) { ret bad_value(fail.malformed("a plan key is a placement flag's name"), l.key); }
    val row: *Row = ROWS[k.some];
    if (!row.placement)                                 { ret bad_value(fail.malformed("a plan key is a placement flag's name"), l.key); }
    if (row.flag.kind == args.SWITCH && l.value != nil) { ret bad_value(fail.malformed("a switch takes no value"), l.key); }
    if (row.flag.kind == args.VALUE && l.value == nil)  { ret bad_value(fail.malformed("needs a value"), l.key); }
    val s: *args.Setting = ?c.settings[k.some];
    if ((sel row.flag.occurs.once) && s.count != 0) { ret bad_value(fail.malformed("given more than once"), l.key); }
    s.count = s.count + 1;
    ret row.set(c, l.value, true);
}

# append the request `r` to the inputs, where it stands among them
fun named(c: *Command, r: Request) err[Fail] {
    val p: res[table.Id[Request], Fail] = table.push[Request](?c.inputs, r);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_library(c: *Command, v: str, on: bool) err[Fail] {
    ret named(c, Request.library{Wanted{form: search.Form.system{}, name: v, include: c.include, prefer: c.prefer}});
}

fun set_framework(c: *Command, v: str, on: bool) err[Fail] {
    ret named(c, Request.library{Wanted{form: search.Form.framework{}, name: v, include: c.include}});
}

fun set_library_dir(c: *Command, v: str, on: bool) err[Fail] {
    val p: res[table.Id[str], Fail] = table.push[str](?c.libdirs, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_framework_dir(c: *Command, v: str, on: bool) err[Fail] {
    val p: res[table.Id[str], Fail] = table.push[str](?c.fwdirs, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_sysroot(c: *Command, v: str, on: bool) err[Fail] {
    c.options.sysroot = v;
    ret err[Fail].ok{};
}

fun set_as_needed(c: *Command, v: str, on: bool) err[Fail] {
    if (on) { c.include = Include.referenced{}; }
    or      { c.include = Include.always{}; }
    ret err[Fail].ok{};
}

fun set_static_first(c: *Command, v: str, on: bool) err[Fail] {
    if (on) { c.prefer = Prefer.static_first{}; }
    or      { c.prefer = Prefer.shared_first{}; }
    ret err[Fail].ok{};
}

fun set_state(c: *Command, v: str, on: bool) err[Fail] {
    c.options.state = v;
    ret err[Fail].ok{};
}

fun set_help(c: *Command, v: str, on: bool) err[Fail] {
    c.help = true;
    ret err[Fail].ok{};
}

# the decimal number of `text[at..]` up to a dot or the end, at most `max`,
# with `next` left at the byte after it
fun component(text: str, at: usize, max: u64, next: *usize) res[u64, Fail] {
    var i: usize = at;
    var n: u64   = 0;
    for (text[i] >= '0' && text[i] <= '9') {
        n = n * 10 + (text[i] - '0')::u64;
        if (n > max) { ret res[u64, Fail].err{fail.overflow("a version component is too large")}; }
        i = i + 1;
    }
    if (i == at) { ret res[u64, Fail].err{fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal")}; }
    @next = i;
    ret res[u64, Fail].ok{n};
}

# the version `text` writes as `major.minor` or `major.minor.patch`, a patch
# not written being zero as the notation states
pub fun version(text: str) res[Version, Fail] {
    var at:    usize          = 0;
    val major: res[u64, Fail] = component(text, at, 0xffff, ?at);
    if (sel major.err)   { ret res[Version, Fail].err{fail.about(major.err, text)}; }
    if (text[at] != '.') { ret res[Version, Fail].err{fail.about(fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal"), text)}; }
    val minor: res[u64, Fail] = component(text, at + 1, 0xff, ?at);
    if (sel minor.err) { ret res[Version, Fail].err{fail.about(minor.err, text)}; }
    var patch: u64 = 0;
    if (text[at] == '.') {
        val p: res[u64, Fail] = component(text, at + 1, 0xff, ?at);
        if (sel p.err) { ret res[Version, Fail].err{fail.about(p.err, text)}; }
        patch = p.ok;
    }
    if (text[at] != 0) { ret res[Version, Fail].err{fail.about(fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal"), text)}; }
    ret res[Version, Fail].ok{Version{major: major.ok::u16, minor: minor.ok::u8, patch: patch::u8}};
}

fun refusal(e: args.Error) Fail {
    if (sel e.unknown)       { ret fail.in_record(fail.malformed("unknown option"), e.unknown.flag); }
    or (sel e.missing_value) { ret fail.in_record(fail.malformed("needs a value"), e.missing_value.flag); }
    ret fail.in_record(fail.malformed("given more than once"), e.repeated.flag);
}

fun needs(row: *Row) err[Fail] {
    ret err[Fail].err{fail.in_record(fail.malformed("the link needs this flag"), row.flag.name)};
}

# the row of the flag `f` the reader matched. a row's flag is its first field
# and the reader reads only the rows' own flags, so the flag is the row
fun row_of(f: *args.Flag) *Row {
    ret f::*Row;
}

# check what the flags stated together, and resolve the environment against
# the system
fun finish(c: *Command) err[Fail] {
    if (c.help)                       { ret err[Fail].ok{}; }
    if (c.options.kind == nil)        { ret needs(?KIND); }
    if (c.options.format == nil)      { ret needs(?FORMAT); }
    if (c.options.target.arch == nil) { ret needs(?ARCH); }
    val system: opt[*System] = c.options.target.system;
    if (sel system.none)                      { ret needs(?SYSTEM); }
    if (c.options.output == nil)              { ret needs(?OUTPUT); }
    if (table.count[Request](?c.inputs) == 0) { ret err[Fail].err{fail.malformed("the link names no input file")}; }
    if (c.env != nil) {
        val e: res[*Env, Fail] = os_list.env_by_name(system.some, c.env);
        if (sel e.err) { ret err[Fail].err{fail.in_record(fail.about(e.err, c.env), ENV.flag.name)}; }
        c.options.target.env = opt[*Env].some{e.ok};
    }
    c.options.keep          = table.items[str](?c.keep);
    c.options.keep_count    = table.count[str](?c.keep);
    c.options.sections      = table.items[str](?c.sections);
    c.options.section_count = table.count[str](?c.sections);
    c.options.libdirs       = table.items[str](?c.libdirs);
    c.options.libdir_count  = table.count[str](?c.libdirs);
    c.options.fwdirs        = table.items[str](?c.fwdirs);
    c.options.fwdir_count   = table.count[str](?c.fwdirs);
    ret placements(c);
}

fun name_hash(k: *str) u64 {
    ret fnv1a.step_bytes(fnv1a.FNV_INIT, (@k)::*u8, str_len(@k));
}

fun name_equal(a: *str, b: *str) bool {
    ret str_equals(@a, @b);
}

# resolve the regions the runs and the loads name against the regions
# stated, each region stated once, and hand the statements to the options
fun placements(c: *Command) err[Fail] {
    var by: MapBy[str, usize] = map.init_by[str, usize](c.a, name_hash, name_equal);
    val r:  err[Fail]         = resolved(c, ?by);
    val d:  err[A.Error]      = map.dnit_by[str, usize](?by);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    c.options.regions      = table.items[Area](?c.regions);
    c.options.region_count = table.count[Area](?c.regions);
    c.options.runs         = table.items[Within](?c.ran);
    c.options.run_count    = table.count[Within](?c.ran);
    c.options.loads        = table.items[Within](?c.loaded);
    c.options.load_count   = table.count[Within](?c.loaded);
    c.options.offsets      = table.items[Offset](?c.offsets);
    c.options.offset_count = table.count[Offset](?c.offsets);
    ret err[Fail].ok{};
}

fun resolved(c: *Command, by: *MapBy[str, usize]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Area](?c.regions)) {
        val name: str                = table.at[Area](?c.regions, table.nth[Area](i)).name;
        val put:  res[bool, A.Error] = map.insert_by[str, usize](by, name, i);
        if (sel put.err) { ret err[Fail].err{fail.refused(put.err)}; }
        if (!put.ok)     { ret err[Fail].err{fail.in_record(fail.about(fail.malformed("a region is stated more than once"), name), REGION.flag.name)}; }
        i = i + 1;
    }
    val rs: err[Fail] = within(by, ?c.runs, RUN_REGION.flag.name, ?c.ran);
    if (sel rs.err) { ret rs; }
    ret within(by, ?c.loads, LOAD_REGION.flag.name, ?c.loaded);
}

# each statement of `from` with its region resolved through `by`, into `out`
fun within(by: *MapBy[str, usize], from: *Table[Named], flag: str, out: *Table[Within]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Named](from)) {
        val n:     *Named      = table.at[Named](from, table.nth[Named](i));
        var probe: str         = n.region;
        val found: opt[*usize] = map.get_by[str, usize](by, ?probe);
        if (sel found.none) { ret err[Fail].err{fail.in_record(fail.about(fail.malformed("names no region the link states"), n.region), flag)}; }
        val p: res[table.Id[Within], Fail] = table.push[Within](out, Within{section: n.section, region: @found.some});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# read the command line `a` from argument `start` into `c`, whose tables live
# in `alloc` and whose formats are those of `g`. `c` is released by release
# whether or not reading succeeds
pub fun parse(c: *Command, alloc: *A.Allocator, g: *Registry, a: args.Args, start: usize) err[Fail] {
    @c = Command{
        a:        alloc,
        registry: g,
        inputs:   table.make[Request](alloc),
        keep:     table.make[str](alloc),
        sections: table.make[str](alloc),
        regions:  table.make[Area](alloc),
        runs:     table.make[Named](alloc),
        loads:    table.make[Named](alloc),
        ran:      table.make[Within](alloc),
        loaded:   table.make[Within](alloc),
        offsets:  table.make[Offset](alloc),
        pieces:   table.make[str](alloc),
        plan:     plan.make(alloc),
        libdirs:  table.make[str](alloc),
        fwdirs:   table.make[str](alloc),
        found:    search.make(alloc),
    };
    var flags: [ROW_COUNT]*args.Flag;
    var i:     usize = 0;
    for (i < ROW_COUNT) {
        flags[i] = ?ROWS[i].flag;
        i        = i + 1;
    }
    var r: args.Reader = args.reader(a, start, ?flags[0], ROW_COUNT, ?c.settings[0]);
    for {
        val e: res[args.Event, args.Error] = args.read(?r);
        if (sel e.err)     { ret err[Fail].err{refusal(e.err)}; }
        if (sel e.ok.done) { brk; }
        if (sel e.ok.operand) {
            val p: err[Fail] = named(c, Request.file{search.File{path: a.argv[e.ok.operand]::str, include: c.include}});
            if (sel p.err) { ret p; }
        }
        or (sel e.ok.hit) {
            val row: *Row      = row_of(e.ok.hit.flag);
            val s:   err[Fail] = row.set(c, e.ok.hit.value, e.ok.hit.on);
            if (sel s.err) { ret err[Fail].err{fail.in_record(s.err, row.flag.name)}; }
        }
    }
    ret finish(c);
}

fun spaces(out: *Sink, n: usize) err[Fail] {
    var i: usize = 0;
    for (i < n) {
        val w: err[Fail] = sink.text(out, " ");
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

val HELP_HEAD:   str   = "usage: mink link <input>... -o <path> --kind <kind> --format <format> --arch <arch> --system <system> [options]\n\nlink the input files, objects, archives and libraries, in the order they are named, into one image\n\noptions:\n";
val HELP_COLUMN: usize = 30;

# append the help page of the link command, one line per row
pub fun help(out: *Sink) err[Fail] {
    val h: err[Fail] = sink.text(out, HELP_HEAD);
    if (sel h.err) { ret h; }
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val f:    *args.Flag = ?ROWS[i].flag;
        var used: usize      = 2;
        val w0:   err[Fail]  = sink.text(out, "  ");
        if (sel w0.err) { ret w0; }
        if (f.short != nil) {
            val w1: err[Fail] = sink.text(out, f.short);
            if (sel w1.err) { ret w1; }
            val w2: err[Fail] = sink.text(out, ", ");
            if (sel w2.err) { ret w2; }
            used = used + str_len(f.short) + 2;
        }
        val w3: err[Fail] = sink.text(out, f.name);
        if (sel w3.err) { ret w3; }
        used = used + str_len(f.name);
        if (f.kind != args.SWITCH) {
            val w4: err[Fail] = sink.text(out, " <");
            if (sel w4.err) { ret w4; }
            val w5: err[Fail] = sink.text(out, f.value);
            if (sel w5.err) { ret w5; }
            val w6: err[Fail] = sink.text(out, ">");
            if (sel w6.err) { ret w6; }
            used = used + str_len(f.value) + 3;
        }
        var pad: usize = 2;
        if (used + 2 < HELP_COLUMN) { pad = HELP_COLUMN - used; }
        val w7: err[Fail] = spaces(out, pad);
        if (sel w7.err) { ret w7; }
        val w8: err[Fail] = sink.text(out, f.doc);
        if (sel w8.err) { ret w8; }
        val w9: err[Fail] = sink.text(out, "\n");
        if (sel w9.err) { ret w9; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# link what `c` states in one call: the `count` sources at `given`, objects
# a caller holds in memory among them, then the inputs in the order they are
# named. the image's bytes are returned and the link's report is appended to
# `notes`
pub fun link(c: *Command, given: *Source, count: usize, notes: *Sink) res[Sink, Fail] {
    var requests: Table[Request] = table.make[Request](c.a);
    var e:        err[Fail]      = table.reserve[Request](?requests, count + table.count[Request](?c.inputs));
    var i:        usize          = 0;
    for (i < count && sel e.ok) {
        val p: res[table.Id[Request], Fail] = table.push[Request](?requests, Request.source{given[i]});
        if (sel p.err) { e = err[Fail].err{p.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Request](?c.inputs) && sel e.ok) {
        val p: res[table.Id[Request], Fail] = table.push[Request](?requests, @table.at[Request](?c.inputs, table.nth[Request](i)));
        if (sel p.err) { e = err[Fail].err{p.err}; }
        i = i + 1;
    }
    var out: res[Sink, Fail];
    if (sel e.err) { out = res[Sink, Fail].err{e.err}; }
    or             { out = search.link(?c.found, c.registry, c.options, table.items[Request](?requests), table.count[Request](?requests), notes); }
    val back: err[Fail] = table.release[Request](?requests);
    if (sel out.err) { ret out; }
    if (sel back.err) {
        var image:   Sink      = out.ok;
        val dropped: err[Fail] = sink.release(?image);
        ret res[Sink, Fail].err{back.err};
    }
    ret out;
}

# give back the command's tables
pub fun release(c: *Command) err[Fail] {
    var first: err[Fail] = table.release[Request](?c.inputs);
    first = fail.kept(first, table.release[str](?c.keep));
    first = fail.kept(first, table.release[str](?c.sections));
    first = fail.kept(first, table.release[Area](?c.regions));
    first = fail.kept(first, table.release[Named](?c.runs));
    first = fail.kept(first, table.release[Named](?c.loads));
    first = fail.kept(first, table.release[Within](?c.ran));
    first = fail.kept(first, table.release[Within](?c.loaded));
    first = fail.kept(first, table.release[Offset](?c.offsets));
    first = fail.kept(first, table.release[str](?c.libdirs));
    first = fail.kept(first, table.release[str](?c.fwdirs));
    first = fail.kept(first, search.release(?c.found));
    var i: usize = 0;
    for (i < table.count[str](?c.pieces)) {
        val s: str          = @table.at[str](?c.pieces, table.nth[str](i));
        val d: err[A.Error] = A.deallocate[char](c.a, s, str_len(s) + 1);
        if (sel d.err) { first = fail.kept(first, err[Fail].err{fail.refused(d.err)}); }
        i = i + 1;
    }
    first = fail.kept(first, table.release[str](?c.pieces));
    ret fail.kept(first, plan.release(?c.plan));
}
