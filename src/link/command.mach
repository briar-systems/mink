# the native command line of a link
#
# one flag table whose rows each write one field of the link's options or of
# the command: the product, the linkage of an executable, the target and what narrows it, a format no
# system implies, the versions and the subsystem, the entry, the kept names,
# collecting what nothing reaches, keeping the temporary symbols, sharing the
# tails of merged strings, the image base, the placed sections, the memory
# regions, the regions a section runs and loads in, a section's offset, the
# image's size and fill, the stack it reserves and commits, whether it requires
# the timing mode, the output path and the path of a library's interface file.
# the operands are the input files, and libraries and frameworks are
# named by flags among them, all read in the order they are named, each
# library loaded when nothing references it as the as-needed switch before it
# states, and searched shared first, falling back to the archive, or for one
# kind alone as the library kind before it states. the directories a name is searched in and the root they
# lie under are flags too. the rows are the flags a command lists to
# std.args, which refuses a flag no row names, parse refuses a flag that
# does not repeat given twice, and std.args.help renders the help page from
# the same rows. a
# value no catalog row names is refused here, and a fact the link must be told
# is never filled in.
#
# the placement rows are the keys of a link plan too: a plan's line is applied
# through the row its key names, where the plan flag stands among the flags,
# so a plan and the flags it spells give the same options. a plan key no
# placement row names is refused, and a key stated by both a plan and a flag
# counts as given twice. a value of several fields separates them by commas,
# the fields after the first split from the right, so a section's name may
# hold a comma. a region a statement names resolves once every flag is read.
# a plan key counts as given by a flag wherever on the command line the flag
# stands.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use std.args;
use std.collections.map;
use std.collections.map.MapBy;
use std.collections.slice.Slice;
use std.crypto.hash.fnv1a;
use std.text.parse.ParseError;
use std.text.parse.parse_u64_exact;

use mink.base.fail;
use mink.base.fail.Detached;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.compress;
use mink.bytes.compress.Method;
use mink.bytes.sink.Sink;
use mink.catalog.format.Format;
use mink.catalog.kind;
use mink.catalog.os;
use mink.catalog.os.System;
use mink.catalog.os.Version;
use os_list: mink.catalog.os.list;
use mink.catalog.output.linkage.Linkage;
use mink.catalog.output.product;
use mink.catalog.output.product.Makes;
use mink.catalog.output.product.Product;
use mink.catalog.subsystem;
use mink.catalog.subsystem.Subsystem;
use mink.catalog.target;
use mink.catalog.target.Refusal;
use mink.catalog.target.Spec;
use mink.format.registration.Registration;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.link.archive;
use mink.link.input.Include;
use mink.link.input.Source;
use mink.link.layout;
use mink.link.options.Area;
use mink.link.options.Offset;
use mink.link.options.Options;
use mink.link.options.Within;
use mink.link.plan;
use mink.link.search;
use mink.link.search.Prefer;
use mink.link.search.Request;
use mink.link.search.Wanted;
use mink.link.write;
use mink.link.write.Written;

# a link as its command line states it
# ---
# a:         the allocator its tables live in
# registry:  the formats the link reads and writes
# options:   the link's options
# inputs:    the input files, libraries and frameworks, in the order they
#            are named
# keep:      the names kept, which options.keep points into
# sections:  the sections placed ahead of the rest, which options.sections
#            points into
# regions:   the memory regions stated, which options.regions points into
# runs:      the sections stated to run in a region, by the region's name
# loads:     the sections stated to load in a region, by the region's name
# ran:       the runs with their regions resolved, which options.runs
#            points into
# loaded:    the loads with their regions resolved, which options.loads
#            points into
# offsets:   the sections stated at an offset, which options.offsets points
#            into
# pieces:    the fields copied out of values, each a zero after it, which
#            the statements point into
# plan:      the link plan read, whose text the values it stated point into
# line:      the command line read, while parse reads it
# stated:    how many plan lines stated each row
# target:    the target's spelling, resolved under the narrowing once every
#            flag is read
# narrowing: what the narrowing flags state, its extensions pointing into ext
# ext:       the extensions stated, in the order named
# refused:   why the target was refused, none while it is not
# include:   how a library named from here on is included, as the as-needed
#            switch last stated
# prefer:    which files a library named from here on is searched for, as
#            the library kind last stated
# libdirs:   the library directories stated, which options.libdirs
#            points into
# fwdirs:    the framework directories stated, which options.fwdirs
#            points into
# found:     what the link's search makes, which its sources point into
# interface: the path the interface file of a library is written to, nil
#            where the command line states none
# product:   what the link makes, nil while the command line names none
# linkage:   the linkage of an executable as given, nil where it is left out
#            and the target's default is taken
pub rec Command {
    a:         *A.Allocator;
    registry:  *Registry;
    options:   Options;
    inputs:    Table[Request];
    keep:      Table[str];
    sections:  Table[str];
    regions:   Table[Area];
    runs:      Table[Named];
    loads:     Table[Named];
    ran:       Table[Within];
    loaded:    Table[Within];
    offsets:   Table[Offset];
    pieces:    Table[str];
    plan:      plan.Plan;
    line:      *args.Parsed;
    stated:    [ROW_COUNT]usize;
    target:    str;
    narrowing: target.Narrowing;
    ext:       Table[str];
    refused:   opt[Refusal];
    include:   Include;
    prefer:    Prefer;
    libdirs:   Table[str];
    fwdirs:    Table[str];
    found:     search.Found;
    interface: str;
    product:   *Product;
    linkage:   str;
}

# an output section stated to lie in the region of a name
pub rec Named {
    section: str;
    region:  str;
}

# one flag and the field it writes
# ---
# flag:      the flag as std.args reads it
# placement: the flag states where the image's bytes go, and is a key of a
#            link plan, spelled as its long name without the dashes
# set:       write the flag's value, nil for a switch, into the command, with
#            whether a switch was given rather than negated
rec Row {
    flag:      args.Flag;
    placement: bool;
    set:       fun(*Command, str, bool) err[Fail];
}

val OUTPUT:        Row = Row{flag: args.Flag{long: "output", short: 'o', value: "path", repeat: false, negatable: false, help: "write the image here"}, placement: false, set: set_output};
val INTERFACE:     Row = Row{flag: args.Flag{long: "interface", short: 0, value: "path", repeat: false, negatable: false, help: "write the file a later link binds against the library through here, as a DLL's import library"}, placement: false, set: set_interface};
val KIND:          Row = Row{flag: args.Flag{long: "kind", short: 'k', value: "bin|static|shared|object|module", repeat: false, negatable: false, help: "what the link makes: an executable, a static library, a shared library, an object or a module"}, placement: false, set: set_kind};
val LINKAGE:       Row = Row{flag: args.Flag{long: "linkage", short: 0, value: "pie|dynamic|static", repeat: false, negatable: false, help: "how an executable is linked, only with --kind bin, the target's default when not given"}, placement: false, set: set_linkage};
val TARGET:        Row = Row{flag: args.Flag{long: "target", short: 't', value: "sys-arch", repeat: false, negatable: false, help: "the target, a system and an architecture as `mach info targets` spells them, such as linux-x86_64"}, placement: false, set: set_target};
val ENV:           Row = Row{flag: args.Flag{long: "env", short: 0, value: "env", repeat: false, negatable: false, help: "the environment of the system, the system's when not given"}, placement: false, set: set_env};
val ABI:           Row = Row{flag: args.Flag{long: "abi", short: 0, value: "abi", repeat: false, negatable: false, help: "the calling convention, by its psABI name, the system's when not given"}, placement: false, set: set_abi};
val ISA:           Row = Row{flag: args.Flag{long: "isa", short: 0, value: "isa", repeat: false, negatable: false, help: "the instruction set the target's machine implements, in masc's selection spelling, the system's floor when not given"}, placement: false, set: set_isa};
val EXT:           Row = Row{flag: args.Flag{long: "ext", short: 0, value: "name", repeat: true, negatable: false, help: "an extension the target adds to its instruction set, once per extension"}, placement: false, set: set_ext};
val CODE_MODEL:    Row = Row{flag: args.Flag{long: "code-model", short: 0, value: "name", repeat: false, negatable: false, help: "the code model, as the target's psABI names it, the system's when not given"}, placement: false, set: set_code_model};
val FORMAT:        Row = Row{flag: args.Flag{long: "format", short: 0, value: "format", repeat: false, negatable: false, help: "an output format no system implies, such as flat, the system accepts in place of its own, the system's when not given"}, placement: false, set: set_format};
val SYS_VERSION:   Row = Row{flag: args.Flag{long: "sys-version", short: 0, value: "x.y[.z]", repeat: false, negatable: false, help: "the oldest system version the image runs on"}, placement: false, set: set_sys_version};
val SDK_VERSION:   Row = Row{flag: args.Flag{long: "sdk-version", short: 0, value: "x.y[.z]", repeat: false, negatable: false, help: "the SDK version the image is built against"}, placement: false, set: set_sdk_version};
val SUBSYSTEM:     Row = Row{flag: args.Flag{long: "subsystem", short: 0, value: "subsystem", repeat: false, negatable: false, help: "the PE subsystem the image states, the system's when not given"}, placement: false, set: set_subsystem};
val ENTRY:         Row = Row{flag: args.Flag{long: "entry", short: 0, value: "symbol", repeat: false, negatable: false, help: "the entry symbol, the system's when not given"}, placement: false, set: set_entry};
val KEEP:          Row = Row{flag: args.Flag{long: "keep", short: 0, value: "symbol", repeat: true, negatable: false, help: "keep this name whether referenced or not, once per name"}, placement: false, set: set_keep};
val GC_SECTIONS:   Row = Row{flag: args.Flag{long: "gc-sections", short: 0, value: nil, repeat: true, negatable: true, help: "leave out the sections nothing reaches, or keep them with --no-gc-sections, the format's default when not given"}, placement: false, set: set_gc_sections};
val TEMPORARIES:   Row = Row{flag: args.Flag{long: "temporaries", short: 0, value: "kept|discarded", repeat: false, negatable: false, help: "keep or leave out the assemblers' local labels, the format's default for the architecture when not given"}, placement: false, set: set_temporaries};
val TAIL_MERGE:    Row = Row{flag: args.Flag{long: "tail-merge", short: 0, value: "on|off", repeat: false, negatable: false, help: "share or keep apart the tails of merged strings, the format's rule when not given"}, placement: false, set: set_tail_merge};
val COMPRESS:      Row = Row{flag: args.Flag{long: "compress-debug-sections", short: 0, value: "none|zlib|zstd", repeat: false, negatable: false, help: "compress the non-alloc debug sections of the image, none when not given"}, placement: false, set: set_compress};
val BASE:          Row = Row{flag: args.Flag{long: "base", short: 0, value: "address", repeat: false, negatable: false, help: "the address the image is laid out from, the host's when not given"}, placement: true, set: set_base};
val SECTION:       Row = Row{flag: args.Flag{long: "section", short: 0, value: "name", repeat: true, negatable: false, help: "place this output section ahead of the rest, in the order named, once per section"}, placement: true, set: set_section};
val REGION:        Row = Row{flag: args.Flag{long: "region", short: 0, value: "name,origin,length,rwx", repeat: true, negatable: false, help: "state a memory region: its name, start, size in bytes and the access it allows of r, w and x, once per region"}, placement: true, set: set_region};
val RUN_REGION:    Row = Row{flag: args.Flag{long: "run-region", short: 0, value: "section,region", repeat: true, negatable: false, help: "run this output section in this region, once per section"}, placement: true, set: set_run_region};
val LOAD_REGION:   Row = Row{flag: args.Flag{long: "load-region", short: 0, value: "section,region", repeat: true, negatable: false, help: "load this output section's bytes in this region, where it runs when not given, once per section"}, placement: true, set: set_load_region};
val OFFSET:        Row = Row{flag: args.Flag{long: "offset", short: 0, value: "section,offset", repeat: true, negatable: false, help: "start this output section at this offset from the start of the region it runs in, from the image base when it runs in none, once per section"}, placement: true, set: set_offset};
val SIZE:          Row = Row{flag: args.Flag{long: "size", short: 0, value: "bytes", repeat: false, negatable: false, help: "the most bytes the image loads from its base, refusing a larger one, and a flat image is padded to exactly this many"}, placement: true, set: set_size};
val FILL:          Row = Row{flag: args.Flag{long: "fill", short: 0, value: "byte", repeat: false, negatable: false, help: "the byte every byte of a flat image no section loads holds, zero when not given"}, placement: true, set: set_fill};
val STACK_RESERVE: Row = Row{flag: args.Flag{long: "stack-reserve", short: 0, value: "bytes", repeat: false, negatable: false, help: "the bytes the image reserves for its stack, refused by a format that records none, the format's default when not given"}, placement: false, set: set_stack_reserve};
val STACK_COMMIT:  Row = Row{flag: args.Flag{long: "stack-commit", short: 0, value: "bytes", repeat: false, negatable: false, help: "the bytes of the reserved stack the image commits at start, refused by a format that records none, the format's default when not given"}, placement: false, set: set_stack_commit};
val LIBRARY:       Row = Row{flag: args.Flag{long: "library", short: 'l', value: "name", repeat: true, negatable: false, help: "link the library of this name, found in the library directories, where it stands among the input files"}, placement: false, set: set_library};
val FRAMEWORK:     Row = Row{flag: args.Flag{long: "framework", short: 0, value: "name", repeat: true, negatable: false, help: "link the framework of this name, found in the framework directories, where it stands among the input files"}, placement: false, set: set_framework};
val LIBRARY_DIR:   Row = Row{flag: args.Flag{long: "library-dir", short: 'L', value: "dir", repeat: true, negatable: false, help: "search this directory for a library ahead of the system's, once per directory"}, placement: false, set: set_library_dir};
val FRAMEWORK_DIR: Row = Row{flag: args.Flag{long: "framework-dir", short: 'F', value: "dir", repeat: true, negatable: false, help: "search this directory for a framework ahead of the system's, once per directory"}, placement: false, set: set_framework_dir};
val SYSROOT:       Row = Row{flag: args.Flag{long: "sysroot", short: 0, value: "path", repeat: false, negatable: false, help: "search the system's library and framework directories under this root, the host's own when not given"}, placement: false, set: set_sysroot};
val AS_NEEDED:     Row = Row{flag: args.Flag{long: "as-needed", short: 0, value: nil, repeat: true, negatable: true, help: "load each library named after it only when a live import references it, or whether or not with --no-as-needed, the format's rule when not given"}, placement: false, set: set_as_needed};
val LIBRARY_KIND:  Row = Row{flag: args.Flag{long: "library-kind", short: 0, value: "shared|static", repeat: true, negatable: false, help: "take each library and framework named after it only as this kind, read from what its file is, refusing it otherwise with no fallback"}, placement: false, set: set_library_kind};
val TIMING_MODE:   Row = Row{flag: args.Flag{long: "require-timing-mode", short: 0, value: nil, repeat: false, negatable: false, help: "mark the image as requiring the timing mode under which data independent timing holds, which its start-up checks"}, placement: false, set: set_timing_mode};
val PLAN:          Row = Row{flag: args.Flag{long: "plan", short: 0, value: "path", repeat: false, negatable: false, help: "read placement flags from this link plan, a `key = value` line each"}, placement: false, set: set_plan};

val ROW_COUNT: usize           = 39;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{?OUTPUT, ?INTERFACE, ?KIND, ?LINKAGE, ?TARGET, ?ENV, ?ABI, ?ISA, ?EXT, ?CODE_MODEL, ?FORMAT, ?SYS_VERSION, ?SDK_VERSION, ?SUBSYSTEM, ?ENTRY, ?KEEP, ?GC_SECTIONS, ?TEMPORARIES, ?TAIL_MERGE, ?COMPRESS, ?BASE, ?SECTION, ?REGION, ?RUN_REGION, ?LOAD_REGION, ?OFFSET, ?SIZE, ?FILL, ?STACK_RESERVE, ?STACK_COMMIT, ?LIBRARY, ?FRAMEWORK, ?LIBRARY_DIR, ?FRAMEWORK_DIR, ?SYSROOT, ?AS_NEEDED, ?LIBRARY_KIND, ?TIMING_MODE, ?PLAN};

# the flag every mink command lists asking for its page in place of a run,
# which the command line's caller answers and parse ignores
pub val HELP: args.Flag = args.Flag{long: "help", short: 'h', value: nil, repeat: false, negatable: false, help: "show this command's page"};

# every flag of a link in help order, the help flag first
val FLAG_COUNT: usize                  = 40;
val FLAGS:      [FLAG_COUNT]*args.Flag = [FLAG_COUNT]*args.Flag{?HELP, ?OUTPUT.flag, ?INTERFACE.flag, ?KIND.flag, ?LINKAGE.flag, ?TARGET.flag, ?ENV.flag, ?ABI.flag, ?ISA.flag, ?EXT.flag, ?CODE_MODEL.flag, ?FORMAT.flag, ?SYS_VERSION.flag, ?SDK_VERSION.flag, ?SUBSYSTEM.flag, ?ENTRY.flag, ?KEEP.flag, ?GC_SECTIONS.flag, ?TEMPORARIES.flag, ?TAIL_MERGE.flag, ?COMPRESS.flag, ?BASE.flag, ?SECTION.flag, ?REGION.flag, ?RUN_REGION.flag, ?LOAD_REGION.flag, ?OFFSET.flag, ?SIZE.flag, ?FILL.flag, ?STACK_RESERVE.flag, ?STACK_COMMIT.flag, ?LIBRARY.flag, ?FRAMEWORK.flag, ?LIBRARY_DIR.flag, ?FRAMEWORK_DIR.flag, ?SYSROOT.flag, ?AS_NEEDED.flag, ?LIBRARY_KIND.flag, ?TIMING_MODE.flag, ?PLAN.flag};

# the link's flags, which the command that runs a link lists
pub val LIST: Slice[*args.Flag] = Slice[*args.Flag]{data: ?FLAGS[0], size: FLAG_COUNT};

fun bad_value(f: Fail, value: str) err[Fail] {
    ret err[Fail].err{fail.about(f, value)};
}

fun set_output(c: *Command, v: str, on: bool) err[Fail] {
    c.options.output = v;
    ret err[Fail].ok{};
}

fun set_interface(c: *Command, v: str, on: bool) err[Fail] {
    c.interface = v;
    ret err[Fail].ok{};
}

fun set_kind(c: *Command, v: str, on: bool) err[Fail] {
    val p: res[*Product, Fail] = product.by_name(v);
    if (sel p.err) { ret bad_value(p.err, v); }
    c.product = p.ok;
    ret err[Fail].ok{};
}

fun set_linkage(c: *Command, v: str, on: bool) err[Fail] {
    c.linkage = v;
    ret err[Fail].ok{};
}

# whether `f` is the format some system implies, the first its row lists
fun implied(f: *Format) bool {
    var i: usize = 0;
    for (i < os_list.count()) {
        val s: *System = os_list.at(i);
        if (s.format_count > 0 && s.formats[0] == f) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun set_format(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[*Registration, Fail] = registry.by_name(c.registry, v);
    if (sel r.err)            { ret err[Fail].err{r.err}; }
    if (implied(r.ok.format)) { ret bad_value(fail.malformed("a system implies this format, so the target states it"), v); }
    c.options.format = r.ok.format;
    ret err[Fail].ok{};
}

fun set_target(c: *Command, v: str, on: bool) err[Fail] {
    c.target = v;
    ret err[Fail].ok{};
}

fun set_env(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.env = v;
    ret err[Fail].ok{};
}

fun set_abi(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.abi = v;
    ret err[Fail].ok{};
}

fun set_isa(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.isa = v;
    ret err[Fail].ok{};
}

fun set_ext(c: *Command, v: str, on: bool) err[Fail] {
    val p: res[table.Id[str], Fail] = table.push[str](?c.ext, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_code_model(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.code_model = v;
    ret err[Fail].ok{};
}

fun set_sys_version(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[Version, Fail] = version(v);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    c.options.target.version = opt[Version].some{r.ok};
    ret err[Fail].ok{};
}

fun set_sdk_version(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[Version, Fail] = version(v);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    c.options.target.sdk = opt[Version].some{r.ok};
    ret err[Fail].ok{};
}

fun set_subsystem(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[*Subsystem, Fail] = subsystem.by_name(v);
    if (sel r.err) { ret bad_value(r.err, v); }
    c.options.target.subsystem = opt[*Subsystem].some{r.ok};
    ret err[Fail].ok{};
}

fun set_entry(c: *Command, v: str, on: bool) err[Fail] {
    c.options.entry = v;
    ret err[Fail].ok{};
}

fun set_keep(c: *Command, v: str, on: bool) err[Fail] {
    val p: res[table.Id[str], Fail] = table.push[str](?c.keep, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_gc_sections(c: *Command, v: str, on: bool) err[Fail] {
    c.options.gc_sections = opt[bool].some{on};
    ret err[Fail].ok{};
}

fun set_temporaries(c: *Command, v: str, on: bool) err[Fail] {
    if (str_equals(v, "kept"))      { c.options.keep_temporaries = opt[bool].some{true}; }
    or (str_equals(v, "discarded")) { c.options.keep_temporaries = opt[bool].some{false}; }
    or                              { ret bad_value(fail.malformed("temporaries are `kept` or `discarded`"), v); }
    ret err[Fail].ok{};
}

fun set_tail_merge(c: *Command, v: str, on: bool) err[Fail] {
    if (str_equals(v, "on"))  { c.options.tail_merge = opt[bool].some{true}; }
    or (str_equals(v, "off")) { c.options.tail_merge = opt[bool].some{false}; }
    or                        { ret bad_value(fail.malformed("tail merging is `on` or `off`"), v); }
    ret err[Fail].ok{};
}

fun set_compress(c: *Command, v: str, on: bool) err[Fail] {
    if (str_equals(v, "none")) {
        c.options.compress = opt[*Method].none{};
        ret err[Fail].ok{};
    }
    val m: res[*Method, Fail] = compress.by_name(v);
    if (sel m.err) { ret err[Fail].err{m.err}; }
    val w: err[Fail] = compress.writes(m.ok);
    if (sel w.err) { ret bad_value(w.err, v); }
    c.options.compress = opt[*Method].some{m.ok};
    ret err[Fail].ok{};
}

# the number `v` writes, in decimal or after a 0x, 0o or 0b prefix
fun number(v: str) res[u64, Fail] {
    val n: res[u64, ParseError] = parse_u64_exact(v, 0);
    if (sel n.err) {
        val e: ParseError = n.err;
        if (sel e.overflow) { ret res[u64, Fail].err{fail.about(fail.overflow("a number does not fit in 64 bits"), v)}; }
        ret res[u64, Fail].err{fail.about(fail.malformed("a number is written in decimal or after a 0x, 0o or 0b prefix"), v)};
    }
    ret res[u64, Fail].ok{n.ok};
}

fun set_base(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    c.options.base = opt[u64].some{n.ok};
    ret err[Fail].ok{};
}

fun set_section(c: *Command, v: str, on: bool) err[Fail] {
    val p: res[table.Id[str], Fail] = table.push[str](?c.sections, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the most fields a value holds
val FIELDS: usize = 4;

# split `v` into `n` fields, two or more, at its last `n - 1` commas into
# `out`, the last
# borrowed from `v` and every other copied into the command's pieces. a
# value with fewer commas or an empty field is refused as `grammar` states
fun fields(c: *Command, v: str, n: usize, grammar: str, out: *str) err[Fail] {
    val len:  usize = str_len(v);
    var stop: usize = len;
    var k:    usize = n;
    for (k > 1) {
        var at:    usize = stop;
        var found: bool  = false;
        for (at > 0 && !found) {
            at = at - 1;
            if (v[at] == ',') { found = true; }
        }
        if (!found || at + 1 == stop) { ret bad_value(fail.malformed(grammar), v); }
        if (k == n)                   { out[k - 1] = (?v[at + 1])::str; }
        or {
            val p: res[str, Fail] = piece(c, v, at + 1, stop - at - 1);
            if (sel p.err) { ret err[Fail].err{p.err}; }
            out[k - 1] = p.ok;
        }
        stop = at;
        k    = k - 1;
    }
    if (stop == 0) { ret bad_value(fail.malformed(grammar), v); }
    val p: res[str, Fail] = piece(c, v, 0, stop);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    out[0] = p.ok;
    ret err[Fail].ok{};
}

# the `len` bytes of `v` from `at`, copied with a zero after them into the
# command's pieces
fun piece(c: *Command, v: str, at: usize, len: usize) res[str, Fail] {
    val s: res[str, StrError] = str_copy_slice(c.a, v, at, len);
    if (sel s.err) {
        val e: StrError = s.err;
        if (sel e.alloc) { ret res[str, Fail].err{fail.refused(e.alloc)}; }
        ret res[str, Fail].err{fail.internal("a field lies outside its value")};
    }
    val p: res[table.Id[str], Fail] = table.push[str](?c.pieces, s.ok);
    if (sel p.err) {
        val d: err[A.Error] = A.deallocate[char](c.a, s.ok, len + 1);
        ret res[str, Fail].err{p.err};
    }
    ret res[str, Fail].ok{s.ok};
}

# the access `v` writes as r, w and x, each at most once
fun access(v: str) res[u8, Fail] {
    var bits: u8    = 0;
    var i:    usize = 0;
    for (v[i] != 0) {
        var bit: u8 = 0;
        if (v[i] == 'r')                   { bit = layout.READABLE; }
        or (v[i] == 'w')                   { bit = layout.WRITABLE; }
        or (v[i] == 'x')                   { bit = layout.EXECUTABLE; }
        if (bit == 0 || (bits & bit) != 0) { ret res[u8, Fail].err{fail.about(fail.malformed("a region's access is some of r, w and x, each once"), v)}; }
        bits = bits | bit;
        i    = i + 1;
    }
    if (bits == 0) { ret res[u8, Fail].err{fail.about(fail.malformed("a region's access is some of r, w and x, each once"), v)}; }
    ret res[u8, Fail].ok{bits};
}

fun set_region(c: *Command, v: str, on: bool) err[Fail] {
    var f: [FIELDS]str;
    val s: err[Fail] = fields(c, v, 4, "a region is `name,origin,length,access`", ?f[0]);
    if (sel s.err) { ret s; }
    val origin: res[u64, Fail] = number(f[1]);
    if (sel origin.err) { ret err[Fail].err{origin.err}; }
    val length: res[u64, Fail] = number(f[2]);
    if (sel length.err) { ret err[Fail].err{length.err}; }
    val bits: res[u8, Fail] = access(f[3]);
    if (sel bits.err) { ret err[Fail].err{bits.err}; }
    val p: res[table.Id[Area], Fail] = table.push[Area](?c.regions, Area{name: f[0], origin: origin.ok, length: length.ok, access: bits.ok});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the section and the region's name `v` states, into `into`
fun named_region(c: *Command, v: str, into: *Table[Named]) err[Fail] {
    var f: [FIELDS]str;
    val s: err[Fail] = fields(c, v, 2, "a section in a region is `section,region`", ?f[0]);
    if (sel s.err) { ret s; }
    val p: res[table.Id[Named], Fail] = table.push[Named](into, Named{section: f[0], region: f[1]});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_run_region(c: *Command, v: str, on: bool) err[Fail] {
    ret named_region(c, v, ?c.runs);
}

fun set_load_region(c: *Command, v: str, on: bool) err[Fail] {
    ret named_region(c, v, ?c.loads);
}

fun set_offset(c: *Command, v: str, on: bool) err[Fail] {
    var f: [FIELDS]str;
    val s: err[Fail] = fields(c, v, 2, "a section's offset is `section,offset`", ?f[0]);
    if (sel s.err) { ret s; }
    val n: res[u64, Fail] = number(f[1]);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val p: res[table.Id[Offset], Fail] = table.push[Offset](?c.offsets, Offset{section: f[0], offset: n.ok});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_timing_mode(c: *Command, v: str, on: bool) err[Fail] {
    c.options.timing_mode = on;
    ret err[Fail].ok{};
}

fun set_size(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    c.options.size = opt[u64].some{n.ok};
    ret err[Fail].ok{};
}

fun set_fill(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err)   { ret err[Fail].err{n.err}; }
    if (n.ok > 0xff) { ret bad_value(fail.overflow("a fill is one byte"), v); }
    c.options.fill = opt[u8].some{n.ok::u8};
    ret err[Fail].ok{};
}

fun set_stack_reserve(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    c.options.stack_reserve = opt[u64].some{n.ok};
    ret err[Fail].ok{};
}

fun set_stack_commit(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    c.options.stack_commit = opt[u64].some{n.ok};
    ret err[Fail].ok{};
}

# read the plan at `v` and apply each of its lines through its key's row
fun set_plan(c: *Command, v: str, on: bool) err[Fail] {
    val r: err[Fail] = plan.read(?c.plan, c.a, v);
    if (sel r.err) { ret r; }
    var i: usize = 0;
    for (i < table.count[plan.Line](?c.plan.lines)) {
        val l: *plan.Line = table.at[plan.Line](?c.plan.lines, table.nth[plan.Line](i));
        val s: err[Fail]  = stated(c, l);
        if (sel s.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(s.err, "line", l.line), v)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the index of the row whose long name is `key`
fun key_row(key: str) opt[usize] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].flag.long, key)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# apply the plan line `l` through the placement row its key names, counted
# with the flags' occurrences of that row
fun stated(c: *Command, l: *plan.Line) err[Fail] {
    val k: opt[usize] = key_row(l.key);
    if (sel k.none) { ret bad_value(fail.malformed("a plan key is a placement flag's name"), l.key); }
    val row: *Row = ROWS[k.some];
    if (!row.placement) { ret bad_value(fail.malformed("a plan key is a placement flag's name"), l.key); }
    val takes: bool = args.takes_value(?row.flag);
    if (!takes && l.value != nil) { ret bad_value(fail.malformed("a switch takes no value"), l.key); }
    if (takes && l.value == nil)  { ret bad_value(fail.malformed("needs a value"), l.key); }
    val given: usize = args.occurrences(c.line, ?row.flag) + c.stated[k.some];
    if (!row.flag.repeat && given != 0) { ret bad_value(fail.malformed("given more than once"), l.key); }
    c.stated[k.some] = c.stated[k.some] + 1;
    ret row.set(c, l.value, true);
}

# append the request `r` to the inputs, where it stands among them
fun named(c: *Command, r: Request) err[Fail] {
    val p: res[table.Id[Request], Fail] = table.push[Request](?c.inputs, r);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_library(c: *Command, v: str, on: bool) err[Fail] {
    ret named(c, Request.library{Wanted{form: search.Form.system{}, name: v, include: c.include, prefer: c.prefer}});
}

fun set_framework(c: *Command, v: str, on: bool) err[Fail] {
    ret named(c, Request.library{Wanted{form: search.Form.framework{}, name: v, include: c.include, prefer: c.prefer}});
}

fun set_library_dir(c: *Command, v: str, on: bool) err[Fail] {
    val p: res[table.Id[str], Fail] = table.push[str](?c.libdirs, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_framework_dir(c: *Command, v: str, on: bool) err[Fail] {
    val p: res[table.Id[str], Fail] = table.push[str](?c.fwdirs, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_sysroot(c: *Command, v: str, on: bool) err[Fail] {
    c.options.sysroot = v;
    ret err[Fail].ok{};
}

fun set_as_needed(c: *Command, v: str, on: bool) err[Fail] {
    if (on) { c.include = Include.referenced{}; }
    or      { c.include = Include.always{}; }
    ret err[Fail].ok{};
}

fun set_library_kind(c: *Command, v: str, on: bool) err[Fail] {
    if (str_equals(v, "shared")) { c.prefer = Prefer.shared_only{}; }
    or (str_equals(v, "static")) { c.prefer = Prefer.static_only{}; }
    or                           { ret err[Fail].err{fail.about(fail.malformed("--library-kind takes shared or static"), v)}; }
    ret err[Fail].ok{};
}

# the decimal number of `text[at..]` up to a dot or the end, at most `max`,
# with `next` left at the byte after it
fun component(text: str, at: usize, max: u64, next: *usize) res[u64, Fail] {
    var i: usize = at;
    var n: u64   = 0;
    for (text[i] >= '0' && text[i] <= '9') {
        n = n * 10 + (text[i] - '0')::u64;
        if (n > max) { ret res[u64, Fail].err{fail.overflow("a version component is too large")}; }
        i = i + 1;
    }
    if (i == at) { ret res[u64, Fail].err{fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal")}; }
    @next = i;
    ret res[u64, Fail].ok{n};
}

# the version `text` writes as `major.minor` or `major.minor.patch`, a patch
# not written being zero as the notation states
pub fun version(text: str) res[Version, Fail] {
    var at:    usize          = 0;
    val major: res[u64, Fail] = component(text, at, 0xffff, ?at);
    if (sel major.err)   { ret res[Version, Fail].err{fail.about(major.err, text)}; }
    if (text[at] != '.') { ret res[Version, Fail].err{fail.about(fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal"), text)}; }
    val minor: res[u64, Fail] = component(text, at + 1, 0xff, ?at);
    if (sel minor.err) { ret res[Version, Fail].err{fail.about(minor.err, text)}; }
    var patch: u64 = 0;
    if (text[at] == '.') {
        val p: res[u64, Fail] = component(text, at + 1, 0xff, ?at);
        if (sel p.err) { ret res[Version, Fail].err{fail.about(p.err, text)}; }
        patch = p.ok;
    }
    if (text[at] != 0) { ret res[Version, Fail].err{fail.about(fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal"), text)}; }
    ret res[Version, Fail].ok{Version{major: major.ok::u16, minor: minor.ok::u8, patch: patch::u8}};
}

fun needs(row: *Row) err[Fail] {
    ret err[Fail].err{fail.in_record(fail.malformed("the link needs this flag"), row.flag.long)};
}

# the row whose canonical flag is `f`, none for a flag of another table the
# command composes. a scan of the rows, the cost std.args pays per token too
fun row_of(f: *args.Flag) opt[*Row] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (?ROWS[i].flag == f) { ret opt[*Row].some{ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# the refusal `r` of the target, kept for the caller to write whole and
# given back as a failure
fun refuse(c: *Command, r: Refusal) err[Fail] {
    var kept: Refusal = r;
    c.refused = opt[Refusal].some{r};
    ret err[Fail].err{target.as_fail(?kept)};
}

# resolve the target under the narrowing, and the format: the system's own,
# or one it accepts that no system implies
fun targeted(c: *Command) err[Fail] {
    if (c.target == nil) { ret needs(?TARGET); }
    val spec: res[Spec, Refusal] = target.parse(c.target);
    if (sel spec.err) { ret refuse(c, spec.err); }
    c.narrowing.ext       = table.items[str](?c.ext);
    c.narrowing.ext_count = table.count[str](?c.ext);
    val t: res[target.Target, Refusal] = target.resolve(spec.ok, ?c.narrowing);
    if (sel t.err) { ret refuse(c, t.err); }
    c.options.target.arch = t.ok.arch;
    c.options.target.sys  = opt[*System].some{t.ok.sys};
    c.options.target.env  = t.ok.env;
    var resolved: target.Target = t.ok;
    val made:     err[Fail]     = made_of(c, ?resolved);
    if (sel made.err) { ret made; }
    if (c.options.format == nil) {
        c.options.format = t.ok.format;
        ret err[Fail].ok{};
    }
    if (!os.accepts(t.ok.sys, c.options.format)) { ret err[Fail].err{fail.in_record(fail.about(fail.malformed("the system does not accept this output format"), t.ok.sys.name), FORMAT.flag.long)}; }
    ret err[Fail].ok{};
}

# the image kind the product resolves to on `t`: an executable's from its
# linkage, the one given or the target's default, and an image product's its
# own. an archive has none. a linkage given with a product other than bin is
# refused naming both
fun made_of(c: *Command, t: *target.Target) err[Fail] {
    if (c.product == nil) { ret needs(?KIND); }
    val makes: Makes = c.product.makes;
    if (sel makes.linked) {
        val l: res[*Linkage, Refusal] = target.linkage(t, c.linkage);
        if (sel l.err) { ret refuse(c, l.err); }
        c.options.kind = l.ok.kind;
        ret err[Fail].ok{};
    }
    if (c.linkage != nil) {
        val both: res[str, StrError] = str_join(c.a, "--kind ", c.product.name, " --linkage ", c.linkage);
        if (sel both.err) {
            val e: StrError = both.err;
            if (sel e.alloc) { ret err[Fail].err{fail.refused(e.alloc)}; }
            ret err[Fail].err{fail.internal("the refusal's subject could not be joined")};
        }
        val kept: res[table.Id[str], Fail] = table.push[str](?c.pieces, both.ok);
        if (sel kept.err) {
            val d: err[A.Error] = A.deallocate[char](c.a, both.ok, str_len(both.ok) + 1);
            ret err[Fail].err{kept.err};
        }
        ret err[Fail].err{fail.about(fail.malformed("a linkage applies only to --kind bin, as only an executable is linked as one"), both.ok)};
    }
    if (sel makes.image) { c.options.kind = makes.image; }
    ret err[Fail].ok{};
}

# check what the flags stated together, and resolve the target
fun finish(c: *Command) err[Fail] {
    val t: err[Fail] = targeted(c);
    if (sel t.err)                            { ret t; }
    if (c.options.output == nil)              { ret needs(?OUTPUT); }
    if (table.count[Request](?c.inputs) == 0) { ret err[Fail].err{fail.malformed("the link names no input file")}; }
    c.options.keep          = table.items[str](?c.keep);
    c.options.keep_count    = table.count[str](?c.keep);
    c.options.sections      = table.items[str](?c.sections);
    c.options.section_count = table.count[str](?c.sections);
    c.options.libdirs       = table.items[str](?c.libdirs);
    c.options.libdir_count  = table.count[str](?c.libdirs);
    c.options.fwdirs        = table.items[str](?c.fwdirs);
    c.options.fwdir_count   = table.count[str](?c.fwdirs);
    ret placements(c);
}

fun name_hash(k: *str) u64 {
    ret fnv1a.step_bytes(fnv1a.FNV_INIT, (@k)::*u8, str_len(@k));
}

fun name_equal(a: *str, b: *str) bool {
    ret str_equals(@a, @b);
}

# resolve the regions the runs and the loads name against the regions
# stated, each region stated once, and hand the statements to the options
fun placements(c: *Command) err[Fail] {
    var by: MapBy[str, usize] = map.init_by[str, usize](c.a, name_hash, name_equal);
    val r:  err[Fail]         = resolved(c, ?by);
    val d:  err[A.Error]      = map.dnit_by[str, usize](?by);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    c.options.regions      = table.items[Area](?c.regions);
    c.options.region_count = table.count[Area](?c.regions);
    c.options.runs         = table.items[Within](?c.ran);
    c.options.run_count    = table.count[Within](?c.ran);
    c.options.loads        = table.items[Within](?c.loaded);
    c.options.load_count   = table.count[Within](?c.loaded);
    c.options.offsets      = table.items[Offset](?c.offsets);
    c.options.offset_count = table.count[Offset](?c.offsets);
    ret err[Fail].ok{};
}

fun resolved(c: *Command, by: *MapBy[str, usize]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Area](?c.regions)) {
        val name: str                = table.at[Area](?c.regions, table.nth[Area](i)).name;
        val put:  res[bool, A.Error] = map.insert_by[str, usize](by, name, i);
        if (sel put.err) { ret err[Fail].err{fail.refused(put.err)}; }
        if (!put.ok)     { ret err[Fail].err{fail.in_record(fail.about(fail.malformed("a region is stated more than once"), name), REGION.flag.long)}; }
        i = i + 1;
    }
    val rs: err[Fail] = within(by, ?c.runs, RUN_REGION.flag.long, ?c.ran);
    if (sel rs.err) { ret rs; }
    ret within(by, ?c.loads, LOAD_REGION.flag.long, ?c.loaded);
}

# each statement of `from` with its region resolved through `by`, into `out`
fun within(by: *MapBy[str, usize], from: *Table[Named], flag: str, out: *Table[Within]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Named](from)) {
        val n:     *Named      = table.at[Named](from, table.nth[Named](i));
        var probe: str         = n.region;
        val found: opt[*usize] = map.get_by[str, usize](by, ?probe);
        if (sel found.none) { ret err[Fail].err{fail.in_record(fail.about(fail.malformed("names no region the link states"), n.region), flag)}; }
        val p: res[table.Id[Within], Fail] = table.push[Within](out, Within{section: n.section, region: @found.some});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# read the command line `line` into `c`, whose tables live in `alloc` and
# whose formats are those of `g`. `line` is read against a command that
# lists LIST, without a refusal and not asking for help, and the help flag is
# left to the caller. a flag that does not repeat given twice is refused. `c` is released by release whether
# or not reading succeeds
pub fun parse(c: *Command, alloc: *A.Allocator, g: *Registry, line: *args.Parsed) err[Fail] {
    @c = Command{
        a:        alloc,
        registry: g,
        inputs:   table.make[Request](alloc),
        keep:     table.make[str](alloc),
        sections: table.make[str](alloc),
        regions:  table.make[Area](alloc),
        runs:     table.make[Named](alloc),
        loads:    table.make[Named](alloc),
        ran:      table.make[Within](alloc),
        loaded:   table.make[Within](alloc),
        offsets:  table.make[Offset](alloc),
        pieces:   table.make[str](alloc),
        plan:     plan.make(alloc),
        line:     line,
        libdirs:  table.make[str](alloc),
        fwdirs:   table.make[str](alloc),
        ext:      table.make[str](alloc),
        found:    search.make(alloc),
    };
    if (sel line.refusal.some) { ret err[Fail].err{fail.internal("the link reads a command line std.args refused")}; }
    var once: usize = 0;
    for (once < ROW_COUNT) {
        val row: *Row = ROWS[once];
        once = once + 1;
        if (!row.flag.repeat && args.occurrences(line, ?row.flag) > 1) { ret err[Fail].err{fail.in_record(fail.malformed("given more than once"), row.flag.long)}; }
    }
    var w: args.Walk = args.walk(line);
    for {
        val e: args.Event = args.step(?w);
        if (sel e.done) { brk; }
        if (sel e.operand) {
            val p: err[Fail] = named(c, Request.file{search.File{path: line.args.argv[e.operand]::str, include: c.include}});
            if (sel p.err) { ret p; }
        }
        or (sel e.hit) {
            val row: opt[*Row] = row_of(e.hit.flag);
            if (sel row.some) {
                val s: err[Fail] = row.some.set(c, e.hit.value, e.hit.on);
                if (sel s.err) { ret err[Fail].err{fail.in_record(s.err, row.some.flag.long)}; }
            }
        }
    }
    ret finish(c);
}

# link what `c` states in one call: the `count` sources at `given`, objects
# a caller holds in memory among them, then the inputs in the order they are
# named, or for a static library archive the input files. the image's bytes and its interface file are returned and the
# link's report is appended to `notes`
pub fun link(c: *Command, given: *Source, count: usize, notes: *Sink) res[Written, Detached] {
    var requests: Table[Request] = table.make[Request](c.a);
    var e:        err[Fail]      = table.reserve[Request](?requests, count + table.count[Request](?c.inputs));
    var i:        usize          = 0;
    for (i < count && sel e.ok) {
        val p: res[table.Id[Request], Fail] = table.push[Request](?requests, Request.source{given[i]});
        if (sel p.err) { e = err[Fail].err{p.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Request](?c.inputs) && sel e.ok) {
        val p: res[table.Id[Request], Fail] = table.push[Request](?requests, @table.at[Request](?c.inputs, table.nth[Request](i)));
        if (sel p.err) { e = err[Fail].err{p.err}; }
        i = i + 1;
    }
    val makes: Makes = c.product.makes;
    var out:   res[Written, Detached];
    if (sel e.err) { out = res[Written, Detached].err{fail.detach(e.err)}; }
    or (sel makes.archive) {
        val built: res[Sink, Fail] = archive.build(c.a, c.registry, ?c.options, table.items[Request](?requests), table.count[Request](?requests));
        if (sel built.err) { out = res[Written, Detached].err{fail.detach(built.err)}; }
        or                 { out = res[Written, Detached].ok{Written{image: built.ok, interface: opt[Sink].none{}}}; }
    }
    or { out = search.link(?c.found, c.registry, c.options, table.items[Request](?requests), table.count[Request](?requests), notes); }
    val back: err[Fail] = table.release[Request](?requests);
    if (sel out.err) { ret out; }
    if (sel back.err) {
        var written: Written   = out.ok;
        val dropped: err[Fail] = write.release(?written);
        ret res[Written, Detached].err{fail.detach(back.err)};
    }
    ret out;
}

# give back the command's tables
pub fun release(c: *Command) err[Fail] {
    var first: err[Fail] = table.release[Request](?c.inputs);
    first = fail.kept(first, table.release[str](?c.keep));
    first = fail.kept(first, table.release[str](?c.sections));
    first = fail.kept(first, table.release[Area](?c.regions));
    first = fail.kept(first, table.release[Named](?c.runs));
    first = fail.kept(first, table.release[Named](?c.loads));
    first = fail.kept(first, table.release[Within](?c.ran));
    first = fail.kept(first, table.release[Within](?c.loaded));
    first = fail.kept(first, table.release[Offset](?c.offsets));
    first = fail.kept(first, table.release[str](?c.libdirs));
    first = fail.kept(first, table.release[str](?c.fwdirs));
    first = fail.kept(first, table.release[str](?c.ext));
    first = fail.kept(first, search.release(?c.found));
    var i: usize = 0;
    for (i < table.count[str](?c.pieces)) {
        val s: str          = @table.at[str](?c.pieces, table.nth[str](i));
        val d: err[A.Error] = A.deallocate[char](c.a, s, str_len(s) + 1);
        if (sel d.err) { first = fail.kept(first, err[Fail].err{fail.refused(d.err)}); }
        i = i + 1;
    }
    first = fail.kept(first, table.release[str](?c.pieces));
    ret fail.kept(first, plan.release(?c.plan));
}
