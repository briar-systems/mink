# runtime needs, the requirements of a program as a whole its start-up reads
#
# a need is a row: what it is, the output kinds whose images carry it, by
# their capabilities, the systems it applies on, by the capabilities their
# rows declare for the architecture, the cell that carries it and the value
# the link states in it. its support is a hidden read-only cell of one byte
# defined by a global symbol of the cell's name, with the prefix the format
# gives a C symbol's name, which std's start code reads. the rows run through
# the one synthesizer row below at the stage after collection, so a need
# follows the code that survived it, and every cell lies in one ordinary
# input the later phases place and relocate like any definition. a need that
# states no value makes no cell, and std reads an absent cell as a need the
# image does not have.
#
# the timing mode need: the caller states that the image requires the timing
# mode, the processor or system mode under which data independent timing
# holds. an executable linked so carries a cell holding one on every system,
# one whose row declares no way to provide the mode included, so std's
# start-up is the one that refuses to run where the mode is missing. an
# image linked without it carries no cell.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.rule;
use mink.base.rule.Axis;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.catalog.arch;
use mink.catalog.os;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.link.synthesizer;
use mink.link.synthesizer.Context;
use mink.link.synthesizer.Row;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Definition;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.section;
use mink.model.symbol;

# name:    the need, for a diagnostic
# cell:    the name of the symbol that defines its cell, before the format's
#          prefix
# outputs: the capabilities of the output kinds whose images carry it
# systems: the capabilities the system's row declares where it applies
# value:   the byte its cell holds in the link of the context, none for no
#          cell
pub rec Need {
    name:    str;
    cell:    str;
    outputs: Axis;
    systems: Axis;
    value:   fun(*Context) res[opt[u8], Fail];
}

# the name of the cell of the timing mode need
pub val TIMING_MODE_CELL: str = "__mach_timing_mode_required";

# the image requires the timing mode, as the caller states, in every
# executable on every system
pub val TIMING_MODE: Need = Need{name: "timing mode required", cell: TIMING_MODE_CELL, outputs: Axis{need: output.ENTERED, deny: 0}, systems: Axis{need: 0, deny: 0}, value: timing_mode};

val NEED_COUNT: usize             = 1;
val NEEDS:      [NEED_COUNT]*Need = [NEED_COUNT]*Need{?TIMING_MODE};

# every kind but a relocatable object, whose needs the link that takes it
# decides, each need's outputs narrowing it further
val KIND_COUNT: usize             = 7;
val KINDS:      [KIND_COUNT]*Kind = [KIND_COUNT]*Kind{?output.STATIC, ?output.DYNAMIC, ?output.PIE, ?output.STATIC_PIE, ?output.SHARED, ?output.BUNDLE, ?output.MODULE};

pub val ROW: Row = Row{name: "runtime needs", stage: ?synthesizer.AFTER_COLLECT, needs: arch.ADDRESSED, kinds: ?KINDS[0], kind_count: KIND_COUNT, make: make};

fun timing_mode(c: *Context) res[opt[u8], Fail] {
    if (c.options.timing_mode) { ret res[opt[u8], Fail].ok{opt[u8].some{1}}; }
    ret res[opt[u8], Fail].ok{opt[u8].none{}};
}

# the cell of every need that applies to the link and states a value, into
# `out`, declining when none does
pub fun make(c: *Context, out: *Object) res[bool, Fail] {
    var made: bool  = false;
    var i:    usize = 0;
    for (i < NEED_COUNT) {
        val n: *Need = NEEDS[i];
        i = i + 1;
        if (!rule.holds(?n.outputs, c.kind.caps)) { cnt; }
        val applies: res[bool, Fail] = on_system(c, n);
        if (sel applies.err) { ret res[bool, Fail].err{fail.in_record(applies.err, n.name)}; }
        if (!applies.ok)     { cnt; }
        val v: res[opt[u8], Fail] = n.value(c);
        if (sel v.err) { ret res[bool, Fail].err{fail.in_record(v.err, n.name)}; }
        val value: opt[u8] = v.ok;
        if (sel value.none) { cnt; }
        val e: err[Fail] = cell(c, out, n, value.some);
        if (sel e.err) { ret res[bool, Fail].err{fail.in_record(e.err, n.name)}; }
        made = true;
    }
    ret res[bool, Fail].ok{made};
}

# whether the system's row declares what `n` asks of it
fun on_system(c: *Context, n: *Need) res[bool, Fail] {
    if (n.systems.need == 0 && n.systems.deny == 0) { ret res[bool, Fail].ok{true}; }
    if (c.host == nil)                              { ret res[bool, Fail].err{fail.unsupported("the link states no system whose row declares what the need asks of it")}; }
    val caps: res[os.Caps, Fail] = os.caps_of(c.host, c.target.version);
    if (sel caps.err) { ret res[bool, Fail].err{caps.err}; }
    ret res[bool, Fail].ok{rule.holds(?n.systems, caps.ok)};
}

# a read-only section of `out` holding the byte `value`, defined by the
# hidden global symbol of `n`'s cell
fun cell(c: *Context, out: *Object, n: *Need, value: u8) err[Fail] {
    var byte: [1]u8               = [1]u8{value};
    val held: res[Contents, Fail] = object.own(out, ?byte[0], 1);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    val sec: res[Id[Section], Fail] = object.add_section(out, Section{kind: ?section.RODATA, flags: section.RODATA.flags, align: 1, contents: held.ok, disposition: ?section.ROOT});
    if (sel sec.err) { ret err[Fail].err{sec.err}; }
    val name: res[Id[Name], Fail] = prefixed(out, c.pair.prefix, n.cell);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    val sym: res[Id[Symbol], Fail] = object.add_symbol(out, Symbol{
        name:       name.ok,
        binding:    ?symbol.GLOBAL,
        visibility: ?symbol.HIDDEN,
        kind:       ?symbol.DATA,
        def:        Definition.placed{Place{section: sec.ok, offset: 0}},
        size:       object.sized(1),
    });
    if (sel sym.err) { ret err[Fail].err{sym.err}; }
    ret err[Fail].ok{};
}

# the name `prefix` then `name` spell, interned in `o`
fun prefixed(o: *Object, prefix: str, name: str) res[Id[Name], Fail] {
    var text:  Table[u8]           = table.make[u8](o.sections.a);
    val named: res[Id[Name], Fail] = spelled(o, ?text, prefix, name);
    val freed: err[Fail]           = table.release[u8](?text);
    if (sel named.err) { ret named; }
    if (sel freed.err) { ret res[Id[Name], Fail].err{freed.err}; }
    ret named;
}

fun spelled(o: *Object, text: *Table[u8], prefix: str, name: str) res[Id[Name], Fail] {
    val p: err[Fail] = spell(text, prefix);
    if (sel p.err) { ret res[Id[Name], Fail].err{p.err}; }
    val n: err[Fail] = spell(text, name);
    if (sel n.err) { ret res[Id[Name], Fail].err{n.err}; }
    ret object.name(o, table.items[u8](text), table.count[u8](text));
}

fun spell(t: *Table[u8], s: str) err[Fail] {
    var i: usize = 0;
    for (i < str_len(s)) {
        val p: res[Id[u8], Fail] = table.push[u8](t, s[i]);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}
