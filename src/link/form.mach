# the forms a relocation may take by the facts known before layout
#
# a form of a relocation's row may be taken where its target's binding and
# the output kind meet its axes, the link's traits hold its settings, the
# relocation states the addend it asks, the records after the relocation lie
# where the partners it consumes do, with their kinds and, where it asks,
# the relocation's target and addend, and the bytes at the place, read from
# the input, hold its patterns and its equal runs of bits. a form that does not keep the constant-time class of its code
# may not be taken where its bytes meet a constant-time range of the input,
# which a file carries in the mink note, and one that must apply there is
# refused. a relocation a required form is selected for whose records and
# bytes meet no selected form is refused. none of this moves with layout, so the dynamic phase weighs it
# once, before any table is reserved. a form's range is weighed by the
# relaxation participant alone, from the addresses of each pass.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.rule;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.Order;
use mink.catalog.output.Kind;
use mink.catalog.trait;
use mink.catalog.trait.Trait;
use mink.model.object;
use mink.model.object.CtRange;
use mink.model.object.Object;
use mink.model.object.Reloc;
use mink.model.reloc;
use mink.reloc.engine;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.row;
use mink.reloc.row.Copy;
use mink.reloc.row.Delete;
use mink.reloc.row.InsnPattern;
use mink.reloc.row.Rewrite;
use mink.reloc.row.Row;

# what every form of a link is weighed against
# ---
# kind:   the output kind
# traits: the link's merged traits
# order:  the architecture's byte order
# relocs: the output pair's relocation rows, which say where a record's
#         addend lives
pub rec Facts {
    kind:   *Kind;
    traits: *Table[Trait];
    order:  Order;
    relocs: *row.Lookup;
}

# a constant-time range of a section of one object, the ranges of one
# section joined where they meet
pub rec Constant {
    section: u32;
    start:   u64;
    end:     u64;
}

# a relocation whose forms are weighed
# ---
# o:      its object
# k:      its index among the object's relocations
# rel:    the relocation
# bytes:  the bytes of the section it patches
# target: the capabilities of its target's binding, none for a record that
#         names no target
# row:    the row of its record
pub rec At {
    o:      *Object;
    k:      usize;
    rel:    *Reloc;
    bytes:  Bytes;
    target: u64;
    row:    *Row;
}

fun order_constant(a: *Constant, b: *Constant) i64 {
    if (a.section != b.section) { ret ordered(a.section < b.section); }
    if (a.start != b.start)     { ret ordered(a.start < b.start); }
    ret 0;
}

fun ordered(less: bool) i64 {
    if (less) { ret -1; }
    ret 1;
}

# every constant-time range of `o` in `out`, ordered, those of one section
# that meet joined
pub fun constants(o: *Object, out: *Table[Constant]) err[Fail] {
    table.clear[Constant](out);
    var k: usize = 0;
    for (k < table.count[CtRange](?o.ct)) {
        val r: *CtRange                = table.at[CtRange](?o.ct, table.nth[CtRange](k));
        val p: res[Id[Constant], Fail] = table.push[Constant](out, Constant{section: r.section.index, start: r.start, end: r.end});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        k = k + 1;
    }
    val n:   usize     = table.count[Constant](out);
    val all: *Constant = table.items[Constant](out);
    sort.sort_by[Constant](all, n, order_constant);
    var kept: usize = 0;
    var j:    usize = 0;
    for (j < n) {
        val c: Constant = all[j];
        j = j + 1;
        if (kept != 0) {
            val last: *Constant = ?all[kept - 1];
            if (last.section == c.section && c.start <= last.end) {
                if (c.end > last.end) { last.end = c.end; }
                cnt;
            }
        }
        all[kept] = c;
        kept      = kept + 1;
    }
    table.truncate[Constant](out, kept);
    ret err[Fail].ok{};
}

# what the forms of one object's relocations are weighed against besides
# the link's facts
# ---
# constants: its constant-time ranges, ordered, those of one section that
#            meet joined
# unsafe:    the targets of its sections a uniform form is not taken for,
#            each the section's index above the symbol's, ordered
pub rec Local {
    constants: Table[Constant];
    unsafe:    Table[u64];
}

pub fun local(a: *A.Allocator) Local {
    ret Local{constants: table.make[Constant](a), unsafe: table.make[u64](a)};
}

pub fun release(l: *Local) err[Fail] {
    val c: err[Fail] = table.release[Constant](?l.constants);
    ret fail.kept(c, table.release[u64](?l.unsafe));
}

# the kinds the uniform forms of the rows of `l` consume as partners, once
pub fun uniform_partners(l: *row.Lookup, out: *Table[*reloc.Kind]) err[Fail] {
    table.clear[*reloc.Kind](out);
    var i: usize = 0;
    for (i < table.count[*Row](?l.keys)) {
        val r: *Row = table.items[*Row](?l.keys)[i];
        i = i + 1;
        var f: usize = 0;
        for (f < r.rewrite_count) {
            val w: *Rewrite = r.rewrites[f];
            f = f + 1;
            if (!w.when.uniform) { cnt; }
            var j: u8 = 0;
            for (j < w.span) {
                val k: *reloc.Kind = w.when.partners[j].kind;
                j = j + 1;
                if (listed(out, k)) { cnt; }
                val p: res[Id[*reloc.Kind], Fail] = table.push[*reloc.Kind](out, k);
                if (sel p.err) { ret err[Fail].err{p.err}; }
            }
        }
    }
    ret err[Fail].ok{};
}

fun listed(t: *Table[*reloc.Kind], k: *reloc.Kind) bool {
    var i: usize = 0;
    for (i < table.count[*reloc.Kind](t)) {
        if (table.items[*reloc.Kind](t)[i] == k) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the targets of each section of `o` a uniform form is not taken for into
# `l`, as lld relaxes a symbol's GOT loads in a section all or none: a
# record whose row states uniform forms where none may be taken, its
# partners missing or apart, its bytes another instruction or its place in
# a constant-time range, and a record of a kind a uniform form consumes as a
# partner that no record heading such a form consumes. the target's binding
# is the symbol's in every record, so it is not weighed here. `partners` are
# the kinds uniform forms consume. the object's constant-time ranges are in
# `l` already
pub fun unsafe_targets(x: *Facts, o: *Object, partners: *Table[*reloc.Kind], l: *Local) err[Fail] {
    table.clear[u64](?l.unsafe);
    var k: usize = 0;
    val n: usize = table.count[Reloc](?o.relocs);
    for (k < n) {
        val r: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc](k));
        k = k + 1;
        if (!sel r.target.symbol || sel r.minus.some) { cnt; }
        val rw: res[*Row, Fail] = row.by_kind(x.relocs, r.kind);
        if (sel rw.err) { cnt; }
        if (!uniform_row(rw.ok)) {
            if (listed(partners, r.kind)) {
                val e: err[Fail] = mark(l, r);
                if (sel e.err) { ret e; }
            }
            cnt;
        }
        if (r.section.index::usize >= table.count[object.Section](?o.sections)) { ret err[Fail].err{fail.malformed("a relocation patches a section the object does not hold")}; }
        val s: *object.Section = object.section_at(o, r.section);
        if (sel s.contents.zero) { cnt; }
        var at:   At    = At{o: o, k: k - 1, rel: r, bytes: object.bytes(o, ?s.contents), row: rw.ok};
        var safe: bool  = false;
        var span: u8    = 0;
        var f:    usize = 0;
        for (f < rw.ok.rewrite_count) {
            val w: *Rewrite = rw.ok.rewrites[f];
            f = f + 1;
            if (!w.when.uniform) { cnt; }
            val h: res[bool, Fail] = unbound(x, ?at, w);
            if (sel h.err) { ret err[Fail].err{fail.about(h.err, w.name)}; }
            if (h.ok && !in_constant(l, ?at, w)) {
                safe = true;
                if (w.span > span) { span = w.span; }
            }
        }
        if (safe) {
            k = k + span::usize;
            cnt;
        }
        val e: err[Fail] = mark(l, r);
        if (sel e.err) { ret e; }
    }
    val all: *u64 = table.items[u64](?l.unsafe);
    sort.sort_by[u64](all, table.count[u64](?l.unsafe), order_key);
    ret err[Fail].ok{};
}

fun uniform_row(r: *Row) bool {
    var f: usize = 0;
    for (f < r.rewrite_count) {
        if (r.rewrites[f].when.uniform) { ret true; }
        f = f + 1;
    }
    ret false;
}

fun key_of(r: *Reloc) u64 {
    val t: object.Target = r.target;
    if (sel t.symbol) { ret (r.section.index::u64 << 32) | t.symbol.index::u64; }
    ret 0xffff_ffff_ffff_ffff;
}

fun mark(l: *Local, r: *Reloc) err[Fail] {
    val p: res[Id[u64], Fail] = table.push[u64](?l.unsafe, key_of(r));
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun order_key(a: *u64, b: *u64) i64 {
    if (@a == @b) { ret 0; }
    ret ordered(@a < @b);
}

# whether the target of the relocation `at` is one its section holds unsafe
fun unsafe(l: *Local, at: *At) bool {
    val want: u64   = key_of(at.rel);
    val all:  *u64  = table.items[u64](?l.unsafe);
    var low:  usize = 0;
    var high: usize = table.count[u64](?l.unsafe);
    for (low < high) {
        val mid: usize = low + (high - low) / 2;
        if (all[mid] < want) { low = mid + 1; }
        or                   { high = mid; }
    }
    ret low < table.count[u64](?l.unsafe) && all[low] == want;
}

# whether the bytes `start` up to `end` of the section `section` meet a
# constant-time range of `cs`
fun constant(cs: *Table[Constant], section: u32, start: u64, end: u64) bool {
    val all:   *Constant = table.items[Constant](cs);
    var probe: Constant  = Constant{section: section, start: end};
    var low:   usize     = 0;
    var high:  usize     = table.count[Constant](cs);
    for (low < high) {
        val mid: usize = low + (high - low) / 2;
        if (order_constant(?all[mid], ?probe) < 0) { low = mid + 1; }
        or                                         { high = mid; }
    }
    if (low == 0) { ret false; }
    val c: *Constant = ?all[low - 1];
    ret c.section == section && c.end > start;
}

# whether `f` may be taken for the relocation `at` by the facts known before
# layout, its range aside: its condition holds, a uniform form's target is
# not one the object's section holds unsafe for it, and it may apply where
# its bytes lie among the object's constant-time ranges. a form that must
# apply and may not there is refused
pub fun may(x: *Facts, at: *At, local: *Local, f: *Rewrite) res[bool, Fail] {
    if (!selected(x, at, f)) { ret res[bool, Fail].ok{false}; }
    val h: res[bool, Fail] = placed(x, at, f);
    if (sel h.err)                           { ret res[bool, Fail].err{fail.about(h.err, f.name)}; }
    if (!h.ok)                               { ret h; }
    if (f.when.uniform && unsafe(local, at)) { ret res[bool, Fail].ok{false}; }
    if (!in_constant(local, at, f))          { ret h; }
    if (f.must)                              { ret res[bool, Fail].err{fail.about(fail.unsupported("a form the relocation must take does not keep the constant-time class of the range it lies in"), f.name)}; }
    ret res[bool, Fail].ok{false};
}

# the required form of the row of `at` its target, output and traits select
# where the records and bytes at its place meet no form of the row they
# select, which the relocation is refused for, none where they meet one or
# no required form is selected
pub fun unmet(x: *Facts, at: *At) res[opt[*Rewrite], Fail] {
    var want: *Rewrite = nil;
    var i:    usize    = 0;
    for (i < at.row.rewrite_count) {
        val f: *Rewrite = at.row.rewrites[i];
        i = i + 1;
        if (!selected(x, at, f)) { cnt; }
        val h: res[bool, Fail] = placed(x, at, f);
        if (sel h.err) { ret res[opt[*Rewrite], Fail].err{fail.about(h.err, f.name)}; }
        if (h.ok)      { ret res[opt[*Rewrite], Fail].ok{opt[*Rewrite].none{}}; }
        if (f.required && want == nil) { want = f; }
    }
    if (want == nil) { ret res[opt[*Rewrite], Fail].ok{opt[*Rewrite].none{}}; }
    ret res[opt[*Rewrite], Fail].ok{opt[*Rewrite].some{want}};
}

# whether the target, the output kind and the link's traits select `f`
fun selected(x: *Facts, at: *At, f: *Rewrite) bool {
    ret rule.holds(?f.when.target, at.target) && linked(x, f);
}

# whether the output kind and the link's traits meet `f`
fun linked(x: *Facts, f: *Rewrite) bool {
    if (!rule.holds(?f.when.output, x.kind.caps)) { ret false; }
    var t: usize = 0;
    for (t < f.when.trait_count) {
        val found: opt[*trait.Trait] = trait.find(x.traits, f.when.traits[t].axis);
        if (sel found.none)                                            { ret false; }
        if (!trait.same(found.some.setting, f.when.traits[t].setting)) { ret false; }
        t = t + 1;
    }
    ret true;
}

# whether the condition of `f` holds at `at` but for its target axis
fun unbound(x: *Facts, at: *At, f: *Rewrite) res[bool, Fail] {
    if (!linked(x, f)) { ret res[bool, Fail].ok{false}; }
    ret placed(x, at, f);
}

# whether `f` does not keep the constant-time class of its code and its
# bytes at `at` meet a constant-time range of the object
fun in_constant(l: *Local, at: *At, f: *Rewrite) bool {
    if (f.keeps_ct) { ret false; }
    val e: Extent = extent(at, f);
    ret constant(?l.constants, at.rel.section.index, e.start, e.end);
}

# whether the conditions of `f` over the records and bytes at the place of
# `at` hold: its addend, its partners, its patterns and its equal bits
fun placed(x: *Facts, at: *At, f: *Rewrite) res[bool, Fail] {
    if (sel f.when.addend.some) {
        val a: res[opt[i64], Fail] = addend_of(x, at.row, at.bytes, at.rel);
        if (sel a.err)                       { ret res[bool, Fail].err{a.err}; }
        if (sel a.ok.none)                   { ret res[bool, Fail].ok{false}; }
        if (a.ok.some != f.when.addend.some) { ret res[bool, Fail].ok{false}; }
    }
    var j: u8 = 0;
    for (j < f.span) {
        val n: usize = at.k + 1 + j::usize;
        if (n >= table.count[Reloc](?at.o.relocs)) { ret res[bool, Fail].ok{false}; }
        val p:    *Reloc              = table.at[Reloc](?at.o.relocs, table.nth[Reloc](n));
        val want: *row.Partner        = ?f.when.partners[j];
        val lies: res[opt[u64], Fail] = within(at.bytes, at.rel.offset, want.at, 0);
        if (sel lies.err)                                                                               { ret res[bool, Fail].err{lies.err}; }
        if (sel lies.ok.none)                                                                           { ret res[bool, Fail].ok{false}; }
        if (p.section.index != at.rel.section.index || p.offset != lies.ok.some || p.kind != want.kind) { ret res[bool, Fail].ok{false}; }
        if (want.same) {
            val m: res[bool, Fail] = same(x, at, p);
            if (sel m.err) { ret m; }
            if (!m.ok)     { ret m; }
        }
        j = j + 1;
    }
    var q: usize = 0;
    for (q < f.when.shape_count) {
        val s:  *InsnPattern        = ?f.when.shape[q];
        val in: res[opt[u64], Fail] = within(at.bytes, at.rel.offset, s.at, s.len::u64);
        if (sel in.err)                                                                    { ret res[bool, Fail].err{in.err}; }
        if (sel in.ok.none)                                                                { ret res[bool, Fail].ok{false}; }
        if ((word(?at.bytes.data[in.ok.some::usize], s.len, x.order) & s.mask) != s.value) { ret res[bool, Fail].ok{false}; }
        q = q + 1;
    }
    var e: usize = 0;
    for (e < f.when.equal_count) {
        val m: res[bool, Fail] = equal(x, at, ?f.when.equal[e]);
        if (sel m.err) { ret m; }
        if (!m.ok)     { ret m; }
        e = e + 1;
    }
    ret res[bool, Fail].ok{true};
}

# whether the partner record `p` names the target of the relocation `at` and
# states its addend
fun same(x: *Facts, at: *At, p: *Reloc) res[bool, Fail] {
    if (!same_target(at.rel.target, p.target)) { ret res[bool, Fail].ok{false}; }
    val r: res[*Row, Fail] = row.by_kind(x.relocs, p.kind);
    if (sel r.err) { ret res[bool, Fail].err{r.err}; }
    val mine:   res[opt[i64], Fail] = addend_of(x, at.row, at.bytes, at.rel);
    val theirs: res[opt[i64], Fail] = addend_of(x, r.ok, at.bytes, p);
    if (sel mine.err)   { ret res[bool, Fail].err{mine.err}; }
    if (sel theirs.err) { ret res[bool, Fail].err{theirs.err}; }
    val a: opt[i64] = mine.ok;
    val b: opt[i64] = theirs.ok;
    if (sel a.none) { ret res[bool, Fail].ok{false}; }
    if (sel b.none) { ret res[bool, Fail].ok{false}; }
    ret res[bool, Fail].ok{a.some == b.some};
}

# whether `u` names the symbol `t` names, or both the absolute address zero
fun same_target(t: object.Target, u: object.Target) bool {
    if (sel t.symbol) {
        if (sel u.symbol) { ret u.symbol.index == t.symbol.index; }
        ret false;
    }
    if (sel t.absolute) { ret sel u.absolute; }
    ret false;
}

# the addend the relocation `rel` of the row `r` states over `bytes`, none
# when its field lies past them
fun addend_of(x: *Facts, r: *Row, bytes: Bytes, rel: *Reloc) res[opt[i64], Fail] {
    if (rel.offset > bytes.len::u64) { ret res[opt[i64], Fail].ok{opt[i64].none{}}; }
    var site: engine.Site = engine.Site{
        file:    "input",
        section: "section",
        data:    ?bytes.data[rel.offset::usize],
        size:    bytes.len::u64 - rel.offset,
        order:   x.order,
    };
    val a: res[i64, Fail] = engine.addend(r, ?site, rel.addend);
    if (sel a.err) { ret res[opt[i64], Fail].err{a.err}; }
    ret res[opt[i64], Fail].ok{opt[i64].some{a.ok}};
}

# whether the two runs of instruction bits `q` names at the place of `at`
# hold the same bits
fun equal(x: *Facts, at: *At, q: *row.Equal) res[bool, Fail] {
    val one: res[opt[u64], Fail] = within(at.bytes, at.rel.offset, q.at, q.len::u64);
    val two: res[opt[u64], Fail] = within(at.bytes, at.rel.offset, q.other, q.len::u64);
    if (sel one.err) { ret res[bool, Fail].err{one.err}; }
    if (sel two.err) { ret res[bool, Fail].err{two.err}; }
    val p: opt[u64] = one.ok;
    val r: opt[u64] = two.ok;
    if (sel p.none) { ret res[bool, Fail].ok{false}; }
    if (sel r.none) { ret res[bool, Fail].ok{false}; }
    val mask: u64 = (1::u64 << q.width::u64) - 1;
    val a:    u64 = (word(?at.bytes.data[p.some::usize], q.len, x.order) >> q.shift::u64) & mask;
    val b:    u64 = (word(?at.bytes.data[r.some::usize], q.len, x.order) >> q.other_shift::u64) & mask;
    ret res[bool, Fail].ok{a == b};
}

# the offset in `bytes` of the `len` bytes `at` past the place `place`,
# none when they lie outside them
pub fun within(bytes: Bytes, place: u64, at: i8, len: u64) res[opt[u64], Fail] {
    if (at < 0 && (-(at::i64))::u64 > place) { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    var start: u64 = place + at::u64;
    if (at < 0)                                                 { start = place - (-(at::i64))::u64; }
    if (start > bytes.len::u64 || len > bytes.len::u64 - start) { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    ret res[opt[u64], Fail].ok{opt[u64].some{start}};
}

# the `n` byte word at `data` in the byte order `order`
fun word(data: *u8, n: u8, order: Order) u64 {
    val piece: Piece = Piece{at: 0, width: n * 8};
    val shape: Field = Field{bytes: n, pieces: ?piece, count: 1};
    ret field.get(?shape, data, order);
}

# the bytes of the section a form touches, from the place's own record field
# and every byte it reads, writes or removes
rec Extent {
    start: u64;
    end:   u64;
}

fun extent(at: *At, f: *Rewrite) Extent {
    var low:  i64      = 0;
    var high: i64      = row.container(at.row)::i64;
    val e:    row.Emit = f.emit;
    if (e.bytes.len != 0) {
        if (e.bytes.at::i64 < low)                     { low = e.bytes.at::i64; }
        if (e.bytes.at::i64 + e.bytes.len::i64 > high) { high = e.bytes.at::i64 + e.bytes.len::i64; }
    }
    if (sel e.removal.bytes) {
        val d: Delete = e.removal.bytes;
        if (d.at::i64 < low)               { low = d.at::i64; }
        if (d.at::i64 + d.len::i64 > high) { high = d.at::i64 + d.len::i64; }
    }
    if (sel e.removal.pad) {
        if (at.rel.addend > high) { high = at.rel.addend; }
    }
    var q: usize = 0;
    for (q < f.when.shape_count) {
        val s: *InsnPattern = ?f.when.shape[q];
        if (s.at::i64 < low)               { low = s.at::i64; }
        if (s.at::i64 + s.len::i64 > high) { high = s.at::i64 + s.len::i64; }
        q = q + 1;
    }
    var c: usize = 0;
    for (c < e.copy_count) {
        val y: *Copy = ?e.copies[c];
        if (y.from::i64 < low)               { low = y.from::i64; }
        if (y.from::i64 + y.len::i64 > high) { high = y.from::i64 + y.len::i64; }
        c = c + 1;
    }
    val place: i64 = at.rel.offset::i64;
    var start: i64 = place + low;
    if (start < 0) { start = 0; }
    ret Extent{start: start::u64, end: (place + high)::u64};
}
