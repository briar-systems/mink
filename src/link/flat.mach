# how a flat image links: as ELF, its own linking row naming only its image
# writer and that it exports nothing, as a flat image holds no symbols

use std.types.option.opt;

use mink.base.rule;
use mink.link.flat.write;
use mink.link.image.Writer;
use mink.link.linking.Linking;

pub val LINKING: Linking = Linking{exports: rule.NEVER, writer: opt[*Writer].some{?write.WRITER}};
