# the flat image writer: the loaded bytes of an image
#
# a flat image is what a loader of the image would put in memory, from the
# first byte a segment loads to the last byte a segment loads from the file,
# with every byte between segments the link's fill, zero where it states none.
# the format links as ELF, so the image is the one the ELF image build
# makes, and each PT_LOAD of its model projects its file bytes to its load
# address, its p_paddr, less the lowest load address, as GNU objcopy -O binary
# does. an image laid out from its base starts at the base, and one laid into
# memory regions at the lowest address a region loads, so no byte below what
# the regions place is written. a stated size is a ceiling, which layout
# holds the loaded bytes within, and an image the link asks to pad is padded
# with the fill to exactly that size. a flat image has no header, no section
# and no note, so it carries no mink note. two loaded segments whose bytes
# overlap where they load are refused, naming both, and so is an image past
# its stated size.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.sort;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.table;
use mink.base.vectors;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.format.elf.model.model;
use mink.format.elf.model.model.Elf;
use mink.format.elf.model.model.Segment;
use mink.format.elf.model.tables;
use elf_write: mink.format.elf.write;
use elf_image: mink.link.elf.image;
use mink.link.image.Image;
use mink.link.image.Interfacer;
use mink.link.image.Sizing;
use mink.link.image.Stack;
use mink.link.image.Stacking;
use mink.link.image.Writer;

val KINDS: [1]*Kind = [1]*Kind{?output.STATIC};

pub val WRITER: Writer = Writer{kinds: ?KINDS[0], kind_count: 1, compresses: false, offsets: true, sizing: Sizing.pads{}, headerless: true, stack: Stacking{records: Stack.none{}, needs: 0}, write: write, interface: opt[Interfacer].none{}};

# a loaded segment and its index among the program headers
rec Load {
    index:   usize;
    segment: Segment;
}

# by load address, ascending
fun by_address(a: *Load, b: *Load) i64 {
    if (a.segment.paddr < b.segment.paddr) { ret -1; }
    if (a.segment.paddr > b.segment.paddr) { ret 1; }
    ret 0;
}

# write the image `img` as its loaded bytes from the base it was laid out from
fun write(a: *A.Allocator, img: *Image) res[Sink, Fail] {
    val res_built: res[Elf, Fail] = elf_image.built(a, img);
    if (sel res_built.err) { ret res[Sink, Fail].err{res_built.err}; }
    var e:        Elf             = res_built.ok;
    val res_file: res[Sink, Fail] = elf_write.write(a, ?e);
    if (sel res_file.err) {
        val err_dropped: err[Fail] = model.dnit(?e);
        ret res[Sink, Fail].err{res_file.err};
    }
    var bytes:         Sink         = res_file.ok;
    var loads:         Vector[Load] = vector.init[Load](a);
    var out:           Sink         = sink.init(a, bytes.order);
    val err_loaded:    err[Fail]    = loaded(?e, ?loads);
    var err_projected: err[Fail]    = err_loaded;
    if (!sel err_loaded.err)    { err_projected = projected(fill_of(img), ?loads, ?bytes, ?out); }
    if (!sel err_projected.err) { err_projected = padded(img, ?out); }
    var err_first: err[Fail] = fail.kept(err_projected, vectors.dnit[Load](?loads));
    err_first = fail.kept(err_first, sink.dnit(?bytes));
    err_first = fail.kept(err_first, model.dnit(?e));
    if (sel err_first.ok) { ret res[Sink, Fail].ok{out}; }
    val err_dropped: err[Fail] = sink.dnit(?out);
    ret res[Sink, Fail].err{err_first.err};
}

# the byte every byte no segment loads holds: the link's fill, else zero
fun fill_of(img: *Image) u8 {
    val opt_fill: opt[u8] = img.fill;
    if (sel opt_fill.some) { ret opt_fill.some; }
    ret 0;
}

# `out` refused past the image's stated size, and padded with the fill to it
# when the link asks for a pad
fun padded(img: *Image, out: *Sink) err[Fail] {
    val opt_size: opt[u64] = img.size;
    if (sel opt_size.none) { ret err[Fail].ok{}; }
    val have: u64 = sink.len(out)::u64;
    if (have > opt_size.some) { ret err[Fail].err{fail.valued(fail.internal("the image runs past its stated size by the value in bytes"), (have - opt_size.some)::i128)}; }
    if (!img.pad)             { ret err[Fail].ok{}; }
    val res_to_usize: res[usize, Fail] = checked.to_usize(Location{record: "image"}, opt_size.some - have);
    if (sel res_to_usize.err) { ret err[Fail].err{res_to_usize.err}; }
    ret sink.fill(out, fill_of(img), res_to_usize.ok);
}

# the PT_LOAD segments of `e` into `out`, ascending by load address
fun loaded(e: *Elf, out: *Vector[Load]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Segment](?e.segments)) {
        val s: *Segment = table.at[Segment](?e.segments, table.nth[Segment](i));
        if (s.type == tables.PT_LOAD.value::u32) {
            val err_out_pushed: err[Fail] = vectors.push[Load](out, Load{index: i, segment: @s});
            if (sel err_out_pushed.err) { ret err[Fail].err{err_out_pushed.err}; }
        }
        i = i + 1;
    }
    sort.sort_by[Load](out.data, vector.length[Load](out), by_address);
    ret err[Fail].ok{};
}

# the file bytes of each segment of `loads` from the ELF file `file`, at its
# load address less the first, into `out`, every byte between them `fill`
fun projected(fill: u8, loads: *Vector[Load], file: *Sink, out: *Sink) err[Fail] {
    val at:    Location = Location{record: "segment"};
    var prev:  usize    = 0;
    var seen:  bool     = false;
    var first: u64      = 0;
    var end:   u64      = 0;
    var i:     usize    = 0;
    for (i < vector.length[Load](loads)) {
        val l: *Load    = ?loads.data[i];
        val s: *Segment = ?l.segment;
        i = i + 1;
        # a segment loaded where it runs takes its zero fill there too, one
        # loaded elsewhere only the bytes copied from it, and a segment that
        # takes nothing lies nowhere in the image
        var held: u64 = s.memsz;
        if (s.paddr != s.vaddr) { held = s.filesz; }
        if (held == 0)          { cnt; }
        if (!seen) {
            seen  = true;
            first = s.paddr;
        }
        or (s.paddr < end) {
            ret err[Fail].err{fail.valued(fail.in_indexed(fail.unsupported("a loaded segment overlaps another, whose program header index the value is"), "segment", l.index::u64), prev::i128)};
        }
        val res_top: res[u64, Fail] = checked.add(at, s.paddr, held);
        if (sel res_top.err) { ret err[Fail].err{fail.in_indexed(res_top.err, "segment", l.index::u64)}; }
        prev = l.index;
        end  = res_top.ok;
        if (s.filesz == 0) { cnt; }
        val res_stop: res[u64, Fail] = checked.add(at, s.offset, s.filesz);
        if (sel res_stop.err)                  { ret err[Fail].err{fail.in_indexed(res_stop.err, "segment", l.index::u64)}; }
        if (res_stop.ok > sink.len(file)::u64) { ret err[Fail].err{fail.in_indexed(fail.internal("a loaded segment lies past the file the image build wrote"), "segment", l.index::u64)}; }
        val res_place: res[usize, Fail] = checked.to_usize(at, s.paddr - first);
        if (sel res_place.err) { ret err[Fail].err{res_place.err}; }
        val res_to_usize: res[usize, Fail] = checked.to_usize(at, s.filesz);
        if (sel res_to_usize.err) { ret err[Fail].err{res_to_usize.err}; }
        val err_fill: err[Fail] = sink.fill(out, fill, res_place.ok - sink.len(out));
        if (sel err_fill.err) { ret err_fill; }
        val err_bytes: err[Fail] = sink.bytes(out, ?sink.data(file)[s.offset::usize], res_to_usize.ok);
        if (sel err_bytes.err) { ret err_bytes; }
    }
    ret err[Fail].ok{};
}
