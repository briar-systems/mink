# thunks, the layout participant that sends a branch whose target lies past
# its reach through a veneer it lays in an island within that reach
#
# after each layout pass the participant walks every relocation of every
# section that landed, in input and record order, whose kind is a branch the
# link may detour. the branch leads to the entry standing for its target
# where its decision routes it through one, as a PLT entry, a stub or an
# import thunk, and to its target's definition otherwise. a branch whose
# value from its place fits its row goes there itself. one that does not
# goes through a veneer toward the same place, with the same addend: one
# already laid that lies within its reach, or a new one at the end of the
# island right after its own input section, or of the one right before it
# where only that lies within reach, as the early branches of a section
# larger than their reach find, which the first branch there that needs one
# makes. a veneer serves every branch in its reach. a veneer whose
# template's indirect branch must land on a pad its destination does not
# start with leads there through a landing pad, laid in the island right
# before or right after the destination's section within the pad's reach and
# shared by every veneer toward that place. islands and veneers only ever
# grow, so the walk settles once a pass lays none and sends every branch as
# the last pass did. a relocatable output keeps its relocations, so nothing
# is sent for one.

use std.collections.map;
use std.collections.map.MapBy;
use std.crypto.hash.fnv1a;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.catalog.arch;
use mink.catalog.output;
use mink.catalog.slot;
use mink.catalog.slot.SlotRole;
use mink.link.adjust;
use mink.link.adjust.Adjusted;
use mink.link.collect.Ref;
use mink.link.dynamic;
use mink.link.dynamic.Decision;
use mink.link.input;
use mink.link.input.Input;
use mink.link.layout;
use mink.link.layout.Isles;
use mink.link.layout.Landing;
use mink.link.layout.Layout;
use mink.link.layout.Merged;
use mink.link.layout.Participant;
use mink.link.layout.Placed;
use mink.link.layout.Position;
use mink.link.pieces;
use mink.link.reserve;
use mink.link.reserve.Reservation;
use mink.link.reserve.Reserved;
use mink.link.reserve.Toward;
use mink.link.resolve;
use mink.link.template;
use mink.link.value;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Reloc;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.reloc;
use mink.reloc.compute;
use mink.reloc.engine;
use mink.reloc.row;
use mink.reloc.row.Row;

# the participant's name, which its records carry
val NAME: str = "thunks";

pub val THUNKS: Participant = Participant{name: NAME, step: step};

# what veneers lead to, as an index finds them: the symbol's input and index
# with no role, or the entry's role and index, and the addend
rec Key {
    input:  u32;
    symbol: u32;
    role:   *SlotRole;
    index:  u32;
    addend: i64;
}

fun key_of(t: Toward, addend: i64) Key {
    if (sel t.entry) { ret Key{role: t.entry.role, index: t.entry.index, addend: addend}; }
    ret Key{input: t.symbol.input.index, symbol: t.symbol.symbol.index, addend: addend};
}

fun key_hash(k: *Key) u64 {
    var h: u64 = fnv1a.step_u32(fnv1a.FNV_INIT, k.input);
    h = fnv1a.step_u32(h, k.symbol);
    h = fnv1a.step_u32(h, k.index);
    if (k.role != nil) { h = fnv1a.step_u32(h, k.role.at::u32 + 1); }
    val a: u64 = k.addend:~u64;
    h = fnv1a.step_u32(h, (a & 0xffff_ffff)::u32);
    ret fnv1a.step_u32(h, (a >> 32)::u32);
}

fun key_equal(a: *Key, b: *Key) bool {
    ret a.input == b.input && a.symbol == b.symbol && a.role == b.role && a.index == b.index && a.addend == b.addend;
}

# what one walk reads and makes
# ---
# in:       the layout's inputs
# l:        the layout the last pass made
# from:     what a branch's value inputs are gathered from, at the last
#           pass's addresses
# rv:       the table spread into islands
# template: the veneer's template, nil until a branch needs one
# pad:      the landing pad's template, nil until a veneer needs one
# last:     per place veneers lead to, the last veneer laid toward it plus one
# pads:     per place landing pads lead to, the last pad laid toward it plus
#           one
# earlier:  per veneer or landing pad, the one laid toward its place before
#           it plus one, zero for the first
# isles:    per landing, the islands that lie beside it
# sizes:    per island the last pass laid, its size then
# next:     the detours this walk makes
# grew:     whether the walk laid a veneer
rec Walk {
    in:       *layout.In;
    l:        *Layout;
    from:     value.Sources;
    rv:       *Reservation;
    template: *template.Template;
    pad:      *template.Template;
    last:     MapBy[Key, u32];
    pads:     MapBy[Key, u32];
    earlier:  Table[u32];
    isles:    Table[Isles];
    sizes:    Table[u64];
    next:     Adjusted;
    grew:     bool;
}

fun step(in: *layout.In, l: *Layout) res[bool, Fail] {
    if (output.has(in.kind, output.KEEPS)) { ret res[bool, Fail].ok{false}; }
    val isl: opt[Id[Reservation]] = in.reserved.islanded;
    if (sel isl.none) { ret res[bool, Fail].ok{false}; }
    val a: *A.Allocator = in.inputs.a;
    var w: Walk         = Walk{
        in:   in,
        l:    l,
        from: value.Sources{
            inputs:   in.inputs,
            resolved: in.resolved,
            reserved: in.reserved,
            assigned: in.assigned,
            pieces:   in.pieces,
            layout:   l,
            arch:     in.target.arch,
            weak:     in.weak,
        },
        rv:      table.at[Reservation](?in.reserved.tables, isl.some),
        last:    map.init_by[Key, u32](a, key_hash, key_equal),
        pads:    map.init_by[Key, u32](a, key_hash, key_equal),
        earlier: table.make[u32](a),
        isles:   table.make[Isles](a),
        sizes:   table.make[u64](a),
        next:    adjust.make(a),
    };
    var r: res[bool, Fail] = walked(?w);
    var e: err[Fail]       = released(map.dnit_by[Key, u32](?w.last));
    e = fail.kept(e, released(map.dnit_by[Key, u32](?w.pads)));
    e = fail.kept(e, table.release[u32](?w.earlier));
    e = fail.kept(e, table.release[Isles](?w.isles));
    e = fail.kept(e, table.release[u64](?w.sizes));
    e = fail.kept(e, adjust.release(?w.next));
    if (sel r.err) { ret r; }
    if (sel e.err) { ret res[bool, Fail].err{e.err}; }
    ret r;
}

fun released(r: err[A.Error]) err[Fail] {
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}

fun walked(w: *Walk) res[bool, Fail] {
    val x: err[Fail] = indexed(w);
    if (sel x.err) { ret res[bool, Fail].err{x.err}; }
    var i: usize = 0;
    for (i < input.count(w.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        i = i + 1;
        val o: *Object = input.object_of(w.in.inputs, id);
        if (o == nil || resolve.library(w.in.resolved, id)) { cnt; }
        val e: err[Fail] = sent(w, id, o);
        if (sel e.err) { ret res[bool, Fail].err{fail.in_file(e.err, input.at(w.in.inputs, id).name)}; }
    }
    adjust.seal(?w.next);
    if (adjust.same(w.in.adjusted, NAME, ?w.next)) { ret res[bool, Fail].ok{w.grew}; }
    val r: err[Fail] = adjust.restate(w.in.adjusted, NAME, ?w.next);
    if (sel r.err) { ret res[bool, Fail].err{r.err}; }
    ret res[bool, Fail].ok{true};
}

# index the veneers laid before by the place they lead to, the islands by
# the landing of the input section each lies beside, and the size of each
# island the last pass laid
fun indexed(w: *Walk) err[Fail] {
    val r: *Reserved = w.in.reserved;
    var v: usize     = 0;
    for (v < table.count[reserve.Veneer](?r.veneers)) {
        val e: err[Fail] = listed(w, v::u32);
        if (sel e.err) { ret e; }
        v = v + 1;
    }
    val sd: err[Fail] = layout.sides(w.l, r, ?w.isles);
    if (sel sd.err) { ret sd; }
    var i: usize = 0;
    for (i < table.count[Placed](?w.l.islands)) {
        val p: res[Id[u64], Fail] = table.push[u64](?w.sizes, table.at[reserve.Island](?r.islands, table.nth[reserve.Island](i)).size);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# list the veneer or landing pad `v` as the last toward its place
fun listed(w: *Walk, v: u32) err[Fail] {
    val vn:    *reserve.Veneer  = table.at[reserve.Veneer](?w.in.reserved.veneers, table.nth[reserve.Veneer](v::usize));
    var k:     Key              = key_of(vn.toward, vn.addend);
    val index: *MapBy[Key, u32] = index_of(w, vn.role);
    var prior: u32              = 0;
    val found: opt[*u32]        = map.get_by[Key, u32](index, ?k);
    if (sel found.some) { prior = @found.some; }
    val p: res[Id[u32], Fail] = table.push[u32](?w.earlier, prior);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    val put: res[bool, A.Error] = map.insert_by[Key, u32](index, k, v + 1);
    if (sel put.err) { ret err[Fail].err{fail.refused(put.err)}; }
    ret err[Fail].ok{};
}

# the index of what is laid of the template role `role`: the veneers, the
# role of the entries of the table spread into islands, or the landing pads
fun index_of(w: *Walk, role: *slot.Role) *MapBy[Key, u32] {
    val own: opt[*slot.Role] = w.rv.roles[0].template;
    if (sel own.some) {
        if (own.some == role) { ret ?w.last; }
    }
    ret ?w.pads;
}

# send each branch of `o` past its reach through a veneer
fun sent(w: *Walk, id: Id[Input], o: *Object) err[Fail] {
    var k: usize = 0;
    for (k < table.count[Reloc](?o.relocs)) {
        val e: err[Fail] = branch(w, id, o, k);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "relocation", k::u64)}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# send the relocation `k` of `o` through a veneer when it is a branch whose
# target lies past its reach. a relocation of a section that did not land,
# of a merged one or a zero-fill one, one whose place lies in dropped code,
# one the loader applies and one whose target has no address are left to
# relocate, which places or refuses them
fun branch(w: *Walk, id: Id[Input], o: *Object, k: usize) err[Fail] {
    val rel: *Reloc           = table.at[Reloc](?o.relocs, table.nth[Reloc](k));
    val ref: Ref              = Ref{input: id, section: rel.section};
    val lid: opt[Id[Landing]] = layout.landing_of(w.l, ref);
    if (sel lid.none) { ret err[Fail].ok{}; }
    val member: opt[Id[pieces.Member]] = pieces.member_of(w.in.pieces, ref);
    if (sel member.some) { ret err[Fail].ok{}; }
    val tk: res[adjust.Taken, Fail] = adjust.taken(w.in.adjusted, id, Id[Reloc]{index: k::u32}, rel);
    if (sel tk.err)                            { ret err[Fail].err{tk.err}; }
    if (!reloc.has(tk.ok.kind, reloc.DETOURS)) { ret err[Fail].ok{}; }
    if (!sel rel.target.symbol)                { ret err[Fail].ok{}; }
    val s: *Section = object.section_at(o, rel.section);
    if (sel s.contents.zero) { ret err[Fail].ok{}; }
    val dec: res[*Decision, Fail] = dynamic.decision_of(w.in.dynamic, id, k::u32);
    if (sel dec.err)                                        { ret err[Fail].err{dec.err}; }
    if (dec.ok.row == nil)                                  { ret err[Fail].ok{}; }
    if (dynamic.has(dec.ok.row.outcome, dynamic.BIND_SITE)) { ret err[Fail].ok{}; }
    val tw: opt[Toward] = toward(w, id, rel.target.symbol, dec.ok);
    if (sel tw.none) { ret err[Fail].ok{}; }
    val rw: res[*Row, Fail] = row.targeting(w.in.relocs, tk.ok.kind, sel rel.minus.some);
    if (sel rw.err) { ret err[Fail].ok{}; }
    val pos: res[opt[Position], Fail] = layout.locate(w.l, w.in.pieces, ref, tk.ok.offset);
    if (sel pos.err)     { ret err[Fail].err{pos.err}; }
    if (sel pos.ok.none) { ret err[Fail].ok{}; }
    val held: Bytes = object.bytes(o, ?s.contents);
    if (rel.offset > held.len::u64) { ret err[Fail].err{fail.malformed("a relocation's place lies past its section")}; }
    var site: engine.Site = engine.Site{
        file:    input.at(w.in.inputs, id).name,
        section: "section",
        data:    ?held.data[rel.offset::usize],
        size:    held.len::u64 - rel.offset,
        order:   w.in.target.arch.order,
    };
    var ask: value.Ask = value.Ask{
        input:    id,
        reloc:    rel,
        kind:     tk.ok.kind,
        row:      rw.ok,
        holds:    rw.ok,
        site:     ?site,
        section:  s,
        decision: dec.ok,
        place:    pos.ok.some.address,
    };
    val gathered: res[value.Gathered, Fail] = value.gather(?w.from, ?ask);
    if (sel gathered.err)     { ret err[Fail].err{gathered.err}; }
    if (sel gathered.ok.dead) { ret err[Fail].ok{}; }
    val x:     compute.Inputs  = gathered.ok.inputs;
    val there: res[bool, Fail] = fits(rw.ok, ?site, x);
    if (sel there.err) { ret err[Fail].err{there.err}; }
    if (there.ok)      { ret err[Fail].ok{}; }
    val key: Key                 = key_of(tw.some, x.a);
    val got: res[opt[u32], Fail] = within(w, rw.ok, ?site, x, key);
    if (sel got.err) { ret err[Fail].err{got.err}; }
    var v: u32 = 0;
    if (sel got.ok.some) { v = got.ok.some; }
    or {
        val made: res[u32, Fail] = laid(w, lid.some, ref, key, tw.some, rw.ok, ?site, x);
        if (sel made.err) { ret err[Fail].err{made.err}; }
        v = made.ok;
    }
    ret adjust.detour(?w.next, adjust.Detour{by: NAME, input: id, reloc: Id[Reloc]{index: k::u32}, veneer: v});
}

# where the branch decided `d` from the symbol `s` of `id` leads: the entry
# standing for its target where its route has one, or its target's winning
# definition, none for a target with no address
fun toward(w: *Walk, id: Id[Input], s: Id[Symbol], d: *Decision) opt[Toward] {
    val stands: opt[*SlotRole] = dynamic.standing(d);
    if (sel stands.some) {
        var index: u32            = d.entry;
        val by:    opt[*SlotRole] = d.route.through;
        if (sel by.some) {
            if (by.some == stands.some) { index = d.through; }
        }
        ret opt[Toward].some{Toward.entry{reserve.Entered{role: stands.some, index: index}}};
    }
    var at:  Id[Input]        = id;
    var sy:  Id[Symbol]       = s;
    val won: opt[resolve.Won] = resolve.winning(w.in.resolved, id, s);
    if (sel won.some) {
        at = won.some.binding.input;
        sy = won.some.binding.symbol;
    }
    val v: opt[u64] = layout.value_of(w.l, at, sy);
    if (sel v.none) { ret opt[Toward].none{}; }
    ret opt[Toward].some{Toward.symbol{reserve.Defined{input: at, symbol: sy}}};
}

# whether the value the row `rw` computes from `x` at `site` fits its range
fun fits(rw: *Row, site: *engine.Site, x: compute.Inputs) res[bool, Fail] {
    var y: compute.Inputs  = x;
    val v: res[i128, Fail] = engine.value(rw, site, ?y);
    if (sel v.err) { ret res[bool, Fail].err{v.err}; }
    ret engine.within(rw, rw.range, v.ok, ?y);
}

# a veneer toward the place `k` names that the branch of the row `rw` at
# `site`, whose value inputs are `x`, reaches when sent through it, the
# latest laid first, none when none does
fun within(w: *Walk, rw: *Row, site: *engine.Site, x: compute.Inputs, k: Key) res[opt[u32], Fail] {
    var probe: Key       = k;
    val found: opt[*u32] = map.get_by[Key, u32](?w.last, ?probe);
    if (sel found.none) { ret res[opt[u32], Fail].ok{opt[u32].none{}}; }
    var at: u32 = @found.some;
    for (at != 0) {
        val v:     u32            = at - 1;
        val where: res[u64, Fail] = address(w, v);
        if (sel where.err) { ret res[opt[u32], Fail].err{where.err}; }
        var y: compute.Inputs = x;
        value.through(?y, where.ok);
        val r: res[bool, Fail] = fits(rw, site, y);
        if (sel r.err) { ret res[opt[u32], Fail].err{r.err}; }
        if (r.ok)      { ret res[opt[u32], Fail].ok{opt[u32].some{v}}; }
        at = table.items[u32](?w.earlier)[v::usize];
    }
    ret res[opt[u32], Fail].ok{opt[u32].none{}};
}

# where the veneer `v` lies, as its branches see it in the last pass's
# addresses
fun address(w: *Walk, v: u32) res[u64, Fail] {
    val r:    *Reserved       = w.in.reserved;
    val vn:   *reserve.Veneer = table.at[reserve.Veneer](?r.veneers, table.nth[reserve.Veneer](v::usize));
    val isle: *reserve.Island = table.at[reserve.Island](?r.islands, table.nth[reserve.Island](vn.island::usize));
    ret spot(w, vn.island, isle, isle.size, vn.offset);
}

# where a place `offset` bytes into the island `i`, which holds `size` bytes,
# lies as the branches of its input section see it in the last pass's
# addresses. an island the last pass laid lies where it did, one before its
# section reading closer by what it grew since, as the section moves on by
# that. an island the walk made lies right after its section as the section
# landed, or right before it, ending where the section started
fun spot(w: *Walk, i: u32, isle: *reserve.Island, size: u64, offset: u64) res[u64, Fail] {
    val at: Location         = Location{record: "island"};
    val id: opt[Id[Landing]] = layout.landing_of(w.l, isle.beside);
    if (sel id.none) { ret res[u64, Fail].err{fail.internal("an island lies beside an input section that did not land")}; }
    val g: *Landing = table.at[Landing](?w.l.landings, id.some);
    val m: *Merged  = table.at[Merged](?w.l.merged, g.merged);
    if (offset > size) { ret res[u64, Fail].err{fail.internal("a place lies past the end of its island")}; }
    if (i::usize < table.count[Placed](?w.l.islands)) {
        val p:     Placed         = table.items[Placed](?w.l.islands)[i::usize];
        val pm:    *Merged        = table.at[Merged](?w.l.merged, p.merged);
        val start: res[u64, Fail] = checked.add(at, pm.address, p.offset);
        if (sel start.err) { ret start; }
        val place: res[u64, Fail] = checked.add(at, start.ok, offset);
        if (sel place.err) { ret place; }
        if (!isle.before)  { ret place; }
        val was: u64 = table.items[u64](?w.sizes)[i::usize];
        if (size < was) { ret res[u64, Fail].err{fail.internal("an island shrank")}; }
        ret checked.sub(at, place.ok, size - was);
    }
    val begin: res[u64, Fail] = checked.add(at, m.address, g.offset);
    if (sel begin.err) { ret begin; }
    if (isle.before)   { ret checked.sub(at, begin.ok, size - offset); }
    val end: res[u64, Fail] = checked.add(at, begin.ok, g.size);
    if (sel end.err) { ret end; }
    val start: res[u64, Fail] = checked.align_up(at, end.ok, isle.align);
    if (sel start.err) { ret start; }
    ret checked.add(at, start.ok, offset);
}

# where a veneer of `len` bytes laid now at the end of the island `have`,
# the island plus one, zero to make one right before the input section `ref`
# when `before`, right after it otherwise, would lie
fun prospect(w: *Walk, ref: Ref, before: bool, have: u32, len: u64, align: u64) res[u64, Fail] {
    val at: Location = Location{record: "island"};
    if (have == 0) {
        var fresh: reserve.Island = reserve.Island{beside: ref, before: before, size: len, align: align};
        ret spot(w, NOT_LAID, ?fresh, len, 0);
    }
    val isle:  *reserve.Island = table.at[reserve.Island](?w.in.reserved.islands, table.nth[reserve.Island]((have - 1)::usize));
    val start: res[u64, Fail]  = checked.align_up(at, isle.size, isle.align);
    if (sel start.err) { ret start; }
    val stop: res[u64, Fail] = checked.add(at, start.ok, len);
    if (sel stop.err) { ret stop; }
    ret spot(w, have - 1, isle, stop.ok, start.ok);
}

# the index of an island no pass has laid
val NOT_LAID: u32 = 0xffff_ffff;

# whether the island `i` holds one of `index` toward the place `k` names
fun holds(w: *Walk, index: *MapBy[Key, u32], i: u32, k: Key) bool {
    var probe: Key       = k;
    val found: opt[*u32] = map.get_by[Key, u32](index, ?probe);
    if (sel found.none) { ret false; }
    var at: u32 = @found.some;
    for (at != 0) {
        val held: *reserve.Veneer = table.at[reserve.Veneer](?w.in.reserved.veneers, table.nth[reserve.Veneer]((at - 1)::usize));
        if (held.island == i) { ret true; }
        at = table.items[u32](?w.earlier)[(at - 1)::usize];
    }
    ret false;
}

# lay a veneer toward `t`, `addend` past it, for the branch of the row `rw`
# at `site` whose value inputs are `x`, in the island right after the input
# section `ref`, which lands as `lid`, or else right before it, at the end
# of the first whose veneer the branch reaches, making the island where there
# is none. an island that already holds a veneer toward the place, which the
# branch did not reach, takes no other, and where neither island takes one
# the branch is refused
fun laid(w: *Walk, lid: Id[Landing], ref: Ref, k: Key, t: Toward, rw: *Row, site: *engine.Site, x: compute.Inputs) res[u32, Fail] {
    val tp: res[*template.Template, Fail] = veneer(w);
    if (sel tp.err) { ret res[u32, Fail].err{tp.err}; }
    val via: res[opt[u32], Fail] = landing(w, tp.ok, k, t);
    if (sel via.err) { ret res[u32, Fail].err{via.err}; }
    var side: u8 = 0;
    for (side < 2) {
        val before: bool  = side == 1;
        val sides:  Isles = table.items[Isles](?w.isles)[lid.index::usize];
        side = side + 1;
        var have: u32 = sides.after;
        if (before)                                      { have = sides.before; }
        if (have != 0 && holds(w, ?w.last, have - 1, k)) { cnt; }
        val where: res[u64, Fail] = prospect(w, ref, before, have, tp.ok.len, tp.ok.align);
        if (sel where.err) { ret res[u32, Fail].err{where.err}; }
        var y: compute.Inputs = x;
        value.through(?y, where.ok);
        val reach: res[bool, Fail] = fits(rw, site, y);
        if (sel reach.err) { ret res[u32, Fail].err{reach.err}; }
        if (!reach.ok)     { cnt; }
        ret lay(w, ?w.last, Placing{landing: lid, beside: ref, before: before, have: have}, k, t, tp.ok, via.ok);
    }
    ret res[u32, Fail].err{fail.unsupported("no island right before or right after the branch's section lies within its reach")};
}

# where a veneer or landing pad is laid: at the end of the island `have`,
# the island plus one, or of one made right before the input section
# `beside`, which lands as `landing`, when `before`, right after it otherwise
rec Placing {
    landing: Id[Landing];
    beside:  Ref;
    before:  bool;
    have:    u32;
}

# lay one of the template `tp` toward the place `k` names, `t` past its
# addend, through the landing pad `via` where it has one, where `at` says,
# listed in `index`
fun lay(w: *Walk, index: *MapBy[Key, u32], at: Placing, k: Key, t: Toward, tp: *template.Template, via: opt[u32]) res[u32, Fail] {
    val r:      *Reserved   = w.in.reserved;
    val lid:    Id[Landing] = at.landing;
    val ref:    Ref         = at.beside;
    val before: bool        = at.before;
    val have:   u32         = at.have;
    var i:      u32         = 0;
    if (have != 0) { i = have - 1; }
    or {
        val made: res[u32, Fail] = reserve.add_island(r, ref, before, tp.align);
        if (sel made.err) { ret made; }
        i = made.ok;
        val sides: *Isles = ?table.items[Isles](?w.isles)[lid.index::usize];
        if (before) { sides.before = i + 1; }
        or          { sides.after = i + 1; }
    }
    var probe: Key       = k;
    val found: opt[*u32] = map.get_by[Key, u32](index, ?probe);
    var prior: u32       = 0;
    if (sel found.some) { prior = @found.some; }
    val v: res[u32, Fail] = reserve.add_veneer(r, i, tp.len, tp.align, tp.role, t, k.addend, via);
    if (sel v.err) { ret v; }
    val p: res[Id[u32], Fail] = table.push[u32](?w.earlier, prior);
    if (sel p.err) { ret res[u32, Fail].err{p.err}; }
    val put: res[bool, A.Error] = map.insert_by[Key, u32](index, k, v.ok + 1);
    if (sel put.err) { ret res[u32, Fail].err{fail.refused(put.err)}; }
    w.grew = true;
    ret v;
}

# the landing pad a veneer of the template `tp` toward the place `k` names,
# `t` past its addend, reaches it through, none where the template needs no
# pad there or the destination starts with one. a pad toward the place whose
# branch reaches it serves, the latest laid first, and otherwise one is laid
# in the island right before the destination's section or else right after
# it, the first within the pad's reach. a destination that is an entry with
# no pad, that lies in no section of its own or that no island beside its
# section reaches is refused
fun landing(w: *Walk, tp: *template.Template, k: Key, t: Toward) res[opt[u32], Fail] {
    val ld: opt[*template.Landing] = tp.lands;
    if (sel ld.none) { ret res[opt[u32], Fail].ok{opt[u32].none{}}; }
    val pt: res[*template.Template, Fail] = pad_template(w, ld.some);
    if (sel pt.err) { ret res[opt[u32], Fail].err{pt.err}; }
    val on: res[bool, Fail] = padded(w, ld.some, t, k.addend);
    if (sel on.err)  { ret res[opt[u32], Fail].err{on.err}; }
    if (on.ok)       { ret res[opt[u32], Fail].ok{opt[u32].none{}}; }
    if (sel t.entry) { ret res[opt[u32], Fail].err{fail.about(fail.unsupported("a veneer's indirect branch leads to an entry that starts with no landing pad"), t.entry.role.name)}; }
    val d: res[u64, Fail] = layout.destination(w.l, w.in.reserved, t);
    if (sel d.err) { ret res[opt[u32], Fail].err{d.err}; }
    val dest:  u64       = d.ok + (k.addend:~u64);
    var probe: Key       = k;
    val found: opt[*u32] = map.get_by[Key, u32](?w.pads, ?probe);
    var at:    u32       = 0;
    if (sel found.some) { at = @found.some; }
    for (at != 0) {
        val v:     u32            = at - 1;
        val where: res[u64, Fail] = address(w, v);
        if (sel where.err) { ret res[opt[u32], Fail].err{where.err}; }
        val r: res[bool, Fail] = pad_reaches(w, pt.ok, where.ok, dest);
        if (sel r.err) { ret res[opt[u32], Fail].err{r.err}; }
        if (r.ok)      { ret res[opt[u32], Fail].ok{opt[u32].some{v}}; }
        at = table.items[u32](?w.earlier)[v::usize];
    }
    val o:   *Object           = input.object_of(w.in.inputs, t.symbol.input);
    val def: object.Definition = object.symbol_at(o, t.symbol.symbol).def;
    if (!sel def.placed) { ret res[opt[u32], Fail].err{fail.unsupported("a veneer's destination starts with no landing pad and lies in no section a pad can lie beside")}; }
    val ref: Ref              = Ref{input: t.symbol.input, section: def.placed.section};
    val lid: opt[Id[Landing]] = layout.landing_of(w.l, ref);
    if (sel lid.none) { ret res[opt[u32], Fail].err{fail.unsupported("a veneer's destination starts with no landing pad and lies in a section that takes no place of its own")}; }
    var side: u8 = 0;
    for (side < 2) {
        val before: bool  = side == 0;
        val sides:  Isles = table.items[Isles](?w.isles)[lid.some.index::usize];
        side = side + 1;
        var have: u32 = sides.after;
        if (before)                                      { have = sides.before; }
        if (have != 0 && holds(w, ?w.pads, have - 1, k)) { cnt; }
        val where: res[u64, Fail] = prospect(w, ref, before, have, pt.ok.len, pt.ok.align);
        if (sel where.err) { ret res[opt[u32], Fail].err{where.err}; }
        val r: res[bool, Fail] = pad_reaches(w, pt.ok, where.ok, dest);
        if (sel r.err) { ret res[opt[u32], Fail].err{r.err}; }
        if (!r.ok)     { cnt; }
        val made: res[u32, Fail] = lay(w, ?w.pads, Placing{landing: lid.some, beside: ref, before: before, have: have}, k, t, pt.ok, opt[u32].none{});
        if (sel made.err) { ret res[opt[u32], Fail].err{made.err}; }
        ret res[opt[u32], Fail].ok{opt[u32].some{made.ok}};
    }
    ret res[opt[u32], Fail].err{fail.unsupported("no island right before or right after the destination's section lies within reach of the landing pad it needs")};
}

# whether the destination `t`, `addend` past it, starts with a pad the
# landing `l` names: the bytes of the entry's template, or of the input
# section the symbol lies in, at that place. a symbol with no bytes there
# starts with none
fun padded(w: *Walk, l: *template.Landing, t: Toward, addend: i64) res[bool, Fail] {
    if (addend < 0) { ret res[bool, Fail].ok{false}; }
    val off: u64 = addend::u64;
    if (sel t.entry) {
        val held: opt[*slot.Role] = t.entry.role.template;
        if (sel held.none) { ret res[bool, Fail].ok{false}; }
        val et: res[*template.Template, Fail] = template.chosen(w.in.templates, held.some, w.in.kind, w.in.traits);
        if (sel et.err)       { ret res[bool, Fail].err{et.err}; }
        if (off >= et.ok.len) { ret res[bool, Fail].ok{false}; }
        ret res[bool, Fail].ok{template.lands_on(l, ?et.ok.bytes[off::usize], et.ok.len - off, w.in.target.arch.order)};
    }
    val o:   *Object           = input.object_of(w.in.inputs, t.symbol.input);
    val def: object.Definition = object.symbol_at(o, t.symbol.symbol).def;
    if (!sel def.placed)                                                      { ret res[bool, Fail].ok{false}; }
    if (def.placed.section.index::usize >= table.count[Section](?o.sections)) { ret res[bool, Fail].err{fail.malformed("a symbol lies in a section the object does not hold")}; }
    val s: *Section = object.section_at(o, def.placed.section);
    if (sel s.contents.zero) { ret res[bool, Fail].ok{false}; }
    val held: Bytes          = object.bytes(o, ?s.contents);
    val at:   res[u64, Fail] = checked.add(Location{record: "symbol"}, def.placed.offset, off);
    if (sel at.err)             { ret res[bool, Fail].err{at.err}; }
    if (at.ok >= held.len::u64) { ret res[bool, Fail].ok{false}; }
    ret res[bool, Fail].ok{template.lands_on(l, ?held.data[at.ok::usize], held.len::u64 - at.ok, w.in.target.arch.order)};
}

# whether the landing pad of the template `pt` laid at `where` reaches
# `dest`
fun pad_reaches(w: *Walk, pt: *template.Template, where: u64, dest: u64) res[bool, Fail] {
    var bound: [1]template.Bound = [1]template.Bound{template.Bound{target: ?template.DESTINATION, value: dest}};
    ret template.reaches(w.in.relocs, pt, where, ?bound[0], 1);
}

# the template of the landing pad `l` names, chosen once a veneer needs one
fun pad_template(w: *Walk, l: *template.Landing) res[*template.Template, Fail] {
    if (w.pad != nil) { ret res[*template.Template, Fail].ok{w.pad}; }
    val t: res[*template.Template, Fail] = template.chosen(w.in.templates, l.role, w.in.kind, w.in.traits);
    if (sel t.err) { ret t; }
    w.pad = t.ok;
    ret t;
}

# the template of the role whose entries the table spread into islands
# holds, chosen once a branch needs a veneer
fun veneer(w: *Walk) res[*template.Template, Fail] {
    if (w.template != nil) { ret res[*template.Template, Fail].ok{w.template}; }
    val role: *SlotRole = w.rv.roles[0];
    if (sel role.template.none) { ret res[*template.Template, Fail].err{fail.about(fail.internal("a table spread into islands is of a role no template fills"), role.name)}; }
    val t: res[*template.Template, Fail] = template.chosen(w.in.templates, role.template.some, w.in.kind, w.in.traits);
    if (sel t.err) { ret t; }
    w.template = t.ok;
    ret t;
}
