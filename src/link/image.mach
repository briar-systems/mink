# the image record and the image writer table
#
# a format's image writer, which its linking row names, receives one image
# record, the whole of a link as its phases left it, and returns the image's
# bytes. a writer row names the output kinds it builds, so a kind the writer
# does not build yet is refused by the link before the writer runs. the link
# resolves the entry once, so a writer reads where the image starts and
# computes no address of its own.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.table.Id;
use mink.bytes.compress.Method;
use mink.bytes.sink.Sink;
use mink.catalog.format.Format;
use mink.catalog.os.Host;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.format.pair.Mapping;
use mink.link.assign;
use mink.link.assign.Assigned;
use mink.link.assign.Index;
use mink.link.collect.Live;
use mink.link.dynamic.Dynamic;
use mink.link.fold.Folded;
use mink.link.input;
use mink.link.input.Inputs;
use mink.link.layout;
use mink.link.layout.Layout;
use mink.link.needs;
use mink.link.pieces.Pieces;
use mink.link.relocate.Relocated;
use mink.link.reserve.Reserved;
use mink.link.resolve;
use mink.link.resolve.Binding;
use mink.link.resolve.Resolved;
use mink.link.settle.Settled;
use mink.link.sites.Sites;
use mink.link.template;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Symbol;
use mink.model.target.Target;
use mink.reloc.row;

# what a writer reads, every record borrowed from the link
# ---
# kind:      the output kind
# format:    the output format
# target:    what the image is for
# host:      what the system says for the architecture
# entry:     where the image starts, as the link resolved it
# inputs:    the input set
# names:     the link's names
# settled:   the settled facts
# resolved:  where every name is defined, and the dynamic imports
# live:      the sections that survived
# folded:    the sections folded into others, which the image holds once,
#            as the sections they were folded into
# dynamic:   the libraries, imports and exports, and what each reference
#            needs across the image's boundary
# assigned:  the index of every entry the image keeps in its space, what each
#            entry and symbol reaches, and for an image with no addresses the
#            bytes of each section it keeps with its index relocations applied
# pieces:    the pieces of the merged sections and the copies the image
#            keeps of them
# reserved:  the linker-made tables
# layout:    the output sections and where every input section landed
# sites:     the loader relocation sites
# relocated: the relocated bytes of the output sections
# relocs:    the relocation rows of the output pair, which a writer emitting
#            a code template patches it through
# templates: the code templates of the output pair, none for a pair with none
# mapping:   the mapping symbols of the output pair, none where it marks code
#            and data with none
# temporary: the start of the names of the temporary symbols the image
#            leaves out, none when it keeps them
# prefix:    the prefix the format gives a C symbol's name
# output:    the path the caller writes the image to, nil where it states
#            none
# compress:  the method the non-alloc debug sections are compressed with,
#            none to keep them as they are
# size:      the most bytes the image loads from its base, exactly what an
#            image its writer pads takes, none where the link states none
# fill:      the byte every byte of the image no segment loads holds, none
#            where the link states none
pub rec Image {
    kind:      *Kind;
    format:    *Format;
    target:    *Target;
    host:      *Host;
    entry:     Entry;
    inputs:    *Inputs;
    names:     *Interner;
    settled:   *Settled;
    resolved:  *Resolved;
    live:      *Live;
    folded:    *Folded;
    dynamic:   *Dynamic;
    assigned:  *Assigned;
    pieces:    *Pieces;
    reserved:  *Reserved;
    layout:    *Layout;
    sites:     *Sites;
    relocated: *Relocated;
    relocs:    *row.Lookup;
    templates: opt[*template.Set];
    mapping:   opt[*Mapping];
    temporary: opt[str];
    prefix:    str;
    output:    str;
    compress:  opt[*Method];
    size:      opt[u64];
    fill:      opt[u8];
}

# where an image starts
# ---
# none:   the output kind starts at no entry, as a library or an object does
# points: the output names its own entry points, as a SPIR-V module does,
#         which its writer states by its format's own rule
# symbol: the output starts at the entry symbol
pub tag Entry: u8 {
    none;
    points;
    symbol: Start;
}

# the entry symbol as the link resolved it
# ---
# name: its spelling
# at:   where it lies
pub rec Start {
    name: str;
    at:   At;
}

# where the entry symbol lies
# ---
# address: at the address the layout gave it
# index:   at an entry of an index space, which the image reaches by the
#          index the assigned record gave it
pub tag At: u8 {
    address: u64;
    index:   *Index;
}

# where an image of kind `k` starts, `name` being the entry symbol the link
# names for the kind, nil for none. a kind that starts at an entry symbol is
# refused when the link names none, and naming it when the image defines it
# nowhere: no input defines it, a library does, or the layout or the assigned
# record gives its definition no place
pub fun entry_of(k: *Kind, name: str, inputs: *Inputs, names: *Interner, resolved: *Resolved, assigned: *Assigned, l: *Layout) res[Entry, Fail] {
    if (!output.has(k, output.ENTERED)) {
        if (output.has(k, output.ENTRY_POINTS)) { ret res[Entry, Fail].ok{Entry.points{}}; }
        ret res[Entry, Fail].ok{Entry.none{}};
    }
    if (name == nil) { ret res[Entry, Fail].err{fail.malformed("the link names no entry symbol")}; }
    val missing: Fail          = fail.about(fail.malformed("the link does not define the entry symbol"), name);
    val nm:      opt[Id[Name]] = intern.find(names, name, str_len(name));
    if (sel nm.none) { ret res[Entry, Fail].err{missing}; }
    val w: opt[resolve.Won] = resolve.bound(resolved, nm.some);
    if (sel w.none) { ret res[Entry, Fail].err{missing}; }
    val bn: *Binding = w.some.binding;
    val o:  *Object  = input.object_of(inputs, bn.input);
    if (o == nil || resolve.library(resolved, bn.input)) { ret res[Entry, Fail].err{missing}; }
    val sym: *Symbol = object.symbol_at(o, bn.symbol);
    if (sel sym.def.entry) {
        val x: opt[*Index] = assign.symbol_index(assigned, bn.input, bn.symbol);
        if (sel x.none) { ret res[Entry, Fail].err{missing}; }
        ret res[Entry, Fail].ok{Entry.symbol{Start{name: name, at: At.index{x.some}}}};
    }
    val v: opt[u64] = layout.value_of(l, bn.input, bn.symbol);
    if (sel v.none) { ret res[Entry, Fail].err{missing}; }
    ret res[Entry, Fail].ok{Entry.symbol{Start{name: name, at: At.address{v.some}}}};
}

# the address the image starts at, refused for one that starts at no entry
# symbol or at an entry of an index space, as no writer that reads it builds
# such an image
pub fun address_of(e: *Entry) res[u64, Fail] {
    if (sel e.symbol) {
        val at: At = e.symbol.at;
        if (sel at.address) { ret res[u64, Fail].ok{at.address}; }
    }
    ret res[u64, Fail].err{fail.internal("the image starts at no address")};
}

# the file name of the path the image is written to, which names the image
# where its format records a name, refused when the link states none
pub fun file_name(img: *Image) res[View, Fail] {
    val path: str = img.output;
    if (path == nil) { ret res[View, Fail].err{fail.unsupported("the image is named by the file it is written to, which the link states none of")}; }
    val p:     *u8   = path::*u8;
    val n:     usize = str_len(path);
    var start: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (p[i] == '/') { start = i + 1; }
        i = i + 1;
    }
    if (start == n) { ret res[View, Fail].err{fail.about(fail.unsupported("the path the image is written to names no file, which names the image"), path)}; }
    ret res[View, Fail].ok{View{data: ?p[start], len: n - start}};
}

# whether an input's local symbol named `v` is one the image leaves out: a
# temporary, or the mark of a runtime need
pub fun dropped(img: *Image, v: View) bool {
    if (needs.is_mark(img.prefix, v)) { ret true; }
    val t: opt[str] = img.temporary;
    if (sel t.none) { ret false; }
    var i: usize = 0;
    for (t.some[i] != 0) {
        if (i >= v.len || v.data[i] != t.some[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# what a writer makes of a stated size, which layout holds the loaded bytes
# within whenever it is stated
# ---
# refused: the format has no image a size bounds, so a size or a fill is
#          refused
# ceiling: the size bounds the loaded bytes alone, as an image the loader
#          maps by its segments loads no byte outside them, so a fill is
#          refused
# padded:  the image is its loaded bytes, padded with the fill to exactly
#          the size, the fill also standing between its segments
pub tag Sizing: u8 {
    refused;
    ceiling;
    padded;
}

# the bytes of the file a later link binds against an image through in its
# place, as a DLL's import library, in a sink in the format's own byte order
pub def Interfacer: fun(*A.Allocator, *Image) res[Sink, Fail];

# kinds:      the output kinds it builds
# kind_count: how many
# compresses: whether it compresses debug sections
# offsets:    whether it places a section at a stated offset, as a flat image
#             does
# sizing:     what it makes of a stated size and fill
# write:      the image's bytes, in a sink in the format's own byte order
# interface:  the interface file of an image whose kind exports, none for a
#             format whose links bind against the image itself
pub rec Writer {
    kinds:      **Kind;
    kind_count: usize;
    compresses: bool;
    offsets:    bool;
    sizing:     Sizing;
    write:      fun(*A.Allocator, *Image) res[Sink, Fail];
    interface:  opt[Interfacer];
}

# whether `w` builds images of kind `k`
pub fun builds(w: *Writer, k: *Kind) bool {
    var i: usize = 0;
    for (i < w.kind_count) {
        if (w.kinds[i] == k) { ret true; }
        i = i + 1;
    }
    ret false;
}
