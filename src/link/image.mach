# the image record and the image writer table
#
# a format's image writer receives one image record, the whole of a link as
# its phases left it, and returns the image's bytes. a writer row names the
# output kinds it builds, so a kind the writer does not build yet is refused
# by the link before the writer runs.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.catalog.arch.Arch;
use mink.catalog.format.Format;
use mink.catalog.os.Host;
use mink.catalog.os.Os;
use mink.fail.Fail;
use mink.intern.Interner;
use mink.link.collect.Live;
use mink.link.dynamic.Dynamic;
use mink.link.input.Inputs;
use mink.link.kind.Kind;
use mink.link.layout.Layout;
use mink.link.relocate.Relocated;
use mink.link.reserve.Reserved;
use mink.link.resolve.Resolved;
use mink.link.settle.Settled;
use mink.sink.Sink;

# what a writer reads, every record borrowed from the link
# ---
# kind:      the output kind
# format:    the output format
# arch:      the architecture
# os:        the system
# host:      what the system says for the architecture
# entry:     the entry symbol, nil where the link has none
# inputs:    the input set
# names:     the link's names
# settled:   the settled facts
# resolved:  where every name is defined, and the dynamic imports
# live:      the sections that survived
# dynamic:   the libraries, imports and exports, and what each reference
#            needs across the image's boundary
# reserved:  the linker-made tables
# layout:    the output sections and where every input section landed
# relocated: the relocated bytes of the output sections
pub rec Image {
    kind:      *Kind;
    format:    *Format;
    arch:      *Arch;
    os:        *Os;
    host:      *Host;
    entry:     str;
    inputs:    *Inputs;
    names:     *Interner;
    settled:   *Settled;
    resolved:  *Resolved;
    live:      *Live;
    dynamic:   *Dynamic;
    reserved:  *Reserved;
    layout:    *Layout;
    relocated: *Relocated;
}

# format:     the format the writer writes
# kinds:      the output kinds it builds
# kind_count: how many
# write:      the image's bytes, in a sink in the format's own byte order
pub rec Writer {
    format:     *Format;
    kinds:      **Kind;
    kind_count: usize;
    write:      fun(*A.Allocator, *Image) res[Sink, Fail];
}

pub rec Writers {
    rows:  **Writer;
    count: usize;
}

# the image writers mink is built with, one line each
val BUILTIN_COUNT: usize    = 0;
val BUILTIN:       **Writer = nil;

pub fun builtin() Writers {
    ret Writers{rows: BUILTIN, count: BUILTIN_COUNT};
}

# the writer of format `f`, nil where none is built
pub fun writer_of(w: *Writers, f: *Format) *Writer {
    var i: usize = 0;
    for (i < w.count) {
        if (w.rows[i].format == f) { ret w.rows[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether `w` builds images of kind `k`
pub fun builds(w: *Writer, k: *Kind) bool {
    var i: usize = 0;
    for (i < w.kind_count) {
        if (w.kinds[i] == k) { ret true; }
        i = i + 1;
    }
    ret false;
}
