# the garbage collection phase: only what is reachable from the roots survives
#
# a section whose kind's use is not image content is never placed, as settle
# took it, and one whose use marks is cut by its disposition and marked
# through like a placed one, so its live records keep what they name, while
# collection never reports it as kept. every section a link places starts from the disposition its format
# chose for it, a row: kept whole, one atom, one atom per defined symbol,
# living with the section it belongs to, or cut into unwind records living
# with the functions they describe. a disposition that cannot be honoured
# falls back to the row it names. the roots are the entry, the names the
# caller keeps, the atom of every retained symbol, every exported definition
# of an output that exports, every definition a shared library refers to, and
# every section whose flags or roles retain it. a link that does not collect
# also roots every atom that lives through nothing else, so only a group copy
# resolution discarded and what lives through one are left out. marking walks
# relocations from live atoms, except those of debug information, which only
# describes code. the output is the sections that survived, their live atoms
# and the ranges each dropped atom leaves.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.rule;
use mink.base.rule.Axis;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.x86;
use mink.catalog.kind;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.format.contract;
use mink.format.readers.Readers;
use mink.link.input;
use mink.link.input.Appended;
use mink.link.input.Input;
use mink.link.input.Inputs;
use mink.link.resolve;
use mink.link.resolve.Binding;
use mink.link.resolve.Resolved;
use mink.lower.unwind.parse;
use mink.lower.unwind.parse.Framed;
use mink.model.group;
use mink.model.object;
use mink.model.object.Entry;
use mink.model.object.Group;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Reloc;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.reloc;
use mink.model.section;
use mink.model.section.Disposition;
use mink.model.symbol;

# names:       the link's names
# kind:        the output kind, whose capabilities say what is a root
# entry:       the entry symbol, a root, nil where the link has none
# keep:        the names the caller asks to keep
# keep_count:  how many
# collects:    sections nothing reaches from the roots are left out. a link
#              that does not collect keeps every section it places, all but
#              what is always left out: a group copy resolution discarded, a
#              section depending on one and an unwind record of a function
#              in one
# superseding: what states the functions whose frame record another table
#              supersedes, none for a format that states none
# leaving:     the sections the format's image leaves out beyond the excluded
#              ones every image does, none for a format whose image leaves
#              no others out
pub rec In {
    inputs:      *Inputs;
    names:       *Interner;
    resolved:    *Resolved;
    kind:        *Kind;
    entry:       str;
    keep:        *str;
    keep_count:  usize;
    collects:    bool;
    superseding: opt[*Superseding];
    leaving:     opt[*Leaving];
}

# the input sections a format's image leaves out whatever reaches them, as a
# Mach-O image leaves out every debugging section: those whose flags `flags`
# holds, in an output whose kind's capabilities `output` holds. none is placed
# and none of their relocations is applied
pub rec Leaving {
    flags:  Axis;
    output: Axis;
}

# what every image leaves out, whatever its format: the excluded sections,
# which a relocatable output keeps
val EXCLUDED: Leaving = Leaving{flags: Axis{need: section.EXCLUDE}, output: Axis{deny: output.KEEPS}};

# what a format states of the functions whose call frame record another of
# its tables supersedes, as a Mach-O __compact_unwind entry whose encoding
# does not defer to DWARF supersedes the function's FDE. the record of such a
# function is never kept, whatever keeps its function
# ---
# superseded: push onto `out` the place of each function of `o` whose record
#             another table supersedes, in any order
pub rec Superseding {
    superseded: fun(*Object, *Table[Place]) err[Fail];
}

# a section of an input
pub rec Ref {
    input:   Id[Input];
    section: Id[Section];
}

# the bytes from start up to end of a section
pub rec Range {
    at:    Ref;
    start: u64;
    end:   u64;
}

# the field of a kept FDE that names its CIE by the distance back to it,
# which the link restates once both are laid out, since dropping a record
# between them moves one against the other
# ---
# at:    the section holding both
# field: the offset of the field
# cie:   the offset of the CIE it names
pub rec Framing {
    at:    Ref;
    field: u64;
    cie:   u64;
}

# kept:    every section that survived, in input order
# atoms:   every live atom that holds bytes
# dropped: every byte range a dropped atom leaves
# frames:  the CIE field of every kept FDE
pub rec Live {
    kept:    Table[Ref];
    atoms:   Table[Range];
    dropped: Table[Range];
    frames:  Table[Framing];
}

val NONE: u32 = 0xFFFF_FFFF;

# a section the link places, or one whose records it reads against what
# survives
# ---
# present:     resolution kept it, and the link places it or marks through it
# placed:      the image holds its bytes, so collection reports it
# disposition: how it is treated, after any fallback
# reaches:     its relocations keep what they name alive and mark the places
#              they name
# by_place:    something refers into it by a section symbol and an offset, so
#              its symbols do not mark where references land
# atoms:       its first atom and how many
# sites:       its first relocation site and how many
# points:      its first symbol and how many
# dependents:  the first section living through it
# sibling:     the next section living through the same owner
# ring:        the next member of its group
rec Sec {
    at:          Ref;
    present:     bool;
    placed:      bool;
    disposition: *Disposition;
    size:        u64;
    reaches:     bool;
    by_place:    bool;
    live:        bool;
    atom_first:  u32;
    atom_count:  u32;
    site_first:  u32;
    site_count:  u32;
    point_first: u32;
    point_count: u32;
    dependents:  u32;
    sibling:     u32;
    ring:        u32;
}

# a unit kept or dropped whole: start up to end, of which start up to cover is
# the symbol or record and the rest padding
# ---
# field:      for an unwind record, where the relocation naming its function is
# names:      for an FDE, the field naming its CIE and the CIE's offset
# owned:      its liveness follows another atom's, or it can never live
# dependents: the first atom living through it
# sibling:    the next atom living through the same owner
# cie:        for an FDE, the atom of the CIE it names, which lives through it
rec Atom {
    sec:        u32;
    start:      u64;
    end:        u64;
    cover:      u64;
    field:      opt[u64];
    names:      opt[Named];
    owned:      bool;
    live:       bool;
    dependents: u32;
    sibling:    u32;
    cie:        u32;
}

# the CIE an FDE names: the offset of its field and of the CIE
rec Named {
    field: u64;
    cie:   u64;
}

# a relocation of a placed section, at an offset of it
rec Site {
    sec:    u32;
    offset: u64;
    reloc:  Id[Reloc];
}

# a symbol placed in a section, with its size when the input states one
rec Point {
    sec:    u32;
    offset: u64;
    size:   opt[u64];
}

# where a reference lands: an offset of a placed section, and whether it was
# named by a section symbol and an offset
rec Spot {
    sec:    u32;
    offset: u64;
    place:  bool;
}

# what a reference names
# ---
# none: nothing the link places, such as an import or an absolute value
# gone: a section resolution discarded
# at:   a place in a section the link places
tag Reach: u8 {
    none;
    gone;
    at: Spot;
}

rec Context {
    in:     *In;
    out:    *Live;
    bases:  Table[u32];
    secs:   Table[Sec];
    atoms:  Table[Atom];
    trial:  Table[Atom];
    sites:  Table[Site];
    points: Table[Point];
    work:   Table[u32];
    depth:  usize;
    rings:  Table[u32];
}

pub fun make(a: *A.Allocator) Live {
    ret Live{kept: table.make[Ref](a), atoms: table.make[Range](a), dropped: table.make[Range](a), frames: table.make[Framing](a)};
}

pub fun run(in: *In, out: *Live) err[Fail] {
    val a: *A.Allocator = in.inputs.a;
    var c: Context      = Context{
        in:     in,
        out:    out,
        bases:  table.make[u32](a),
        secs:   table.make[Sec](a),
        atoms:  table.make[Atom](a),
        trial:  table.make[Atom](a),
        sites:  table.make[Site](a),
        points: table.make[Point](a),
        work:   table.make[u32](a),
        rings:  table.make[u32](a),
    };
    val r: err[Fail] = collect(?c);
    val d: err[Fail] = drop(?c);
    if (sel r.err) { ret r; }
    ret d;
}

# keep whole every section of image content of the inputs `made` appended
# after collection, which were made from what survived and are not collected
# again. each takes
# the whole disposition and, holding bytes, one live atom spanning it, as a
# section collection kept whole does
pub fun adopt(l: *Live, s: *Inputs, made: Appended) err[Fail] {
    var i: usize = made.first;
    for (i < made.first + made.count) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(s, id);
        var k:  usize     = 0;
        if (o != nil) {
            for (k < table.count[Section](?o.sections)) {
                val sid: Id[Section] = table.nth[Section](k);
                val sec: *Section    = object.section_at(o, sid);
                k = k + 1;
                if (!sec.kind.use.placed) { cnt; }
                sec.disposition = ?section.WHOLE;
                val at:     Ref                = Ref{input: id, section: sid};
                val pushed: res[Id[Ref], Fail] = table.push[Ref](?l.kept, at);
                if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
                val size: u64 = section_size(o, sec);
                if (size != 0) {
                    val atom: res[Id[Range], Fail] = table.push[Range](?l.atoms, Range{at: at, start: 0, end: size});
                    if (sel atom.err) { ret err[Fail].err{atom.err}; }
                }
            }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

pub fun release(l: *Live) err[Fail] {
    val rk: err[Fail] = table.release[Ref](?l.kept);
    val ra: err[Fail] = table.release[Range](?l.atoms);
    val rd: err[Fail] = table.release[Range](?l.dropped);
    ret fail.kept(fail.kept(fail.kept(rk, ra), rd), table.release[Framing](?l.frames));
}

fun collect(c: *Context) err[Fail] {
    val s: err[Fail] = index_sections(c);
    if (sel s.err) { ret s; }
    val r: err[Fail] = index_sites(c);
    if (sel r.err) { ret r; }
    val p: err[Fail] = index_points(c);
    if (sel p.err) { ret p; }
    val b: err[Fail] = note_places(c);
    if (sel b.err) { ret b; }
    val t: err[Fail] = atomize(c);
    if (sel t.err) { ret t; }
    val o: err[Fail] = link_owners(c);
    if (sel o.err) { ret o; }
    val g: err[Fail] = ring_groups(c);
    if (sel g.err) { ret g; }
    val m: err[Fail] = mark_roots(c);
    if (sel m.err) { ret m; }
    val w: err[Fail] = propagate(c);
    if (sel w.err) { ret w; }
    ret report(c);
}

fun drop(c: *Context) err[Fail] {
    var first: err[Fail] = table.release[u32](?c.bases);
    first = fail.kept(first, table.release[Sec](?c.secs));
    first = fail.kept(first, table.release[Atom](?c.atoms));
    first = fail.kept(first, table.release[Atom](?c.trial));
    first = fail.kept(first, table.release[Site](?c.sites));
    first = fail.kept(first, table.release[Point](?c.points));
    first = fail.kept(first, table.release[u32](?c.work));
    ret fail.kept(first, table.release[u32](?c.rings));
}

# the object of `id` whose sections the link places, nil for a container or a
# shared library
fun placed(c: *Context, id: Id[Input]) *Object {
    if (resolve.library(c.in.resolved, id)) { ret nil; }
    ret input.object_of(c.in.inputs, id);
}

fun name_of(c: *Context, id: Id[Input]) str {
    ret input.at(c.in.inputs, id).name;
}

fun sec_at(c: *Context, i: u32) *Sec {
    ret table.at[Sec](?c.secs, Id[Sec]{index: i});
}

fun atom_at(c: *Context, i: u32) *Atom {
    ret table.at[Atom](?c.atoms, Id[Atom]{index: i});
}

fun base_of(c: *Context, id: Id[Input]) u32 {
    ret table.items[u32](?c.bases)[id.index];
}

fun section_size(o: *Object, s: *Section) u64 {
    if (sel s.contents.zero) { ret s.contents.zero; }
    ret object.bytes(o, ?s.contents).len::u64;
}

# a section retained whatever references it: by the output kind keeping
# everything, by its retain flag, or by a role the loader runs or reads
fun retained(c: *Context, s: *Section) bool {
    if (output.has(c.in.kind, output.KEEPS)) { ret true; }
    if ((s.flags & section.RETAIN) != 0)     { ret true; }
    ret (s.kind.roles & section.RETAINED) != 0;
}

# whether the image leaves the section `s` out, as every image does an
# excluded section or as the format's does
fun left(c: *Context, s: *Section) bool {
    if (leaves(c, ?EXCLUDED, s)) { ret true; }
    val l: opt[*Leaving] = c.in.leaving;
    if (sel l.none) { ret false; }
    ret leaves(c, l.some, s);
}

fun leaves(c: *Context, l: *Leaving, s: *Section) bool {
    ret rule.holds(?l.flags, s.flags) && rule.holds(?l.output, c.in.kind.caps);
}

# whether the section `s`, which the image does not place, is cut into
# records by the disposition `d` its use marks through
fun marks(s: *Section, d: *Disposition) bool {
    ret s.kind.use.marks && section.treats(d, section.CUT);
}

fun index_sections(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < input.count(c.in.inputs)) {
        val id:     Id[Input]          = table.nth[Input](i);
        val pushed: res[Id[u32], Fail] = table.push[u32](?c.bases, table.count[Sec](?c.secs)::u32);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        val o: *Object = placed(c, id);
        var k: usize   = 0;
        if (o != nil) {
            for (k < table.count[Section](?o.sections)) {
                val sid: Id[Section] = table.nth[Section](k);
                val s:   *Section    = object.section_at(o, sid);
                if (s.disposition == nil) {
                    ret err[Fail].err{fail.in_file(fail.in_indexed(fail.malformed("a section has no disposition"), "section", k::u64), name_of(c, id))};
                }
                var d: *Disposition = s.disposition;
                if (retained(c, s)) { d = ?section.ROOT; }
                val reaches: bool               = !section.describes(s.kind);
                val kept:    bool               = resolve.keeps(c.in.resolved, id, s) && !left(c, s);
                val sec:     res[Id[Sec], Fail] = table.push[Sec](?c.secs, Sec{
                    at:          Ref{input: id, section: sid},
                    present:     kept && (s.kind.use.placed || marks(s, d)),
                    placed:      kept && s.kind.use.placed,
                    disposition: d,
                    size:        section_size(o, s),
                    reaches:     reaches,
                    dependents:  NONE,
                    sibling:     NONE,
                    ring:        NONE,
                });
                if (sel sec.err) { ret err[Fail].err{sec.err}; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun site_order(a: *Site, b: *Site) i64 {
    if (a.sec != b.sec) {
        if (a.sec < b.sec) { ret -1; }
        ret 1;
    }
    if (a.offset != b.offset) {
        if (a.offset < b.offset) { ret -1; }
        ret 1;
    }
    if (a.reloc.index < b.reloc.index) { ret -1; }
    if (a.reloc.index > b.reloc.index) { ret 1; }
    ret 0;
}

fun point_order(a: *Point, b: *Point) i64 {
    if (a.sec != b.sec) {
        if (a.sec < b.sec) { ret -1; }
        ret 1;
    }
    if (a.offset < b.offset) { ret -1; }
    if (a.offset > b.offset) { ret 1; }
    ret 0;
}

# every relocation of a placed section, ordered by section and offset
fun index_sites(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = placed(c, id);
        var k:  usize     = 0;
        if (o != nil) {
            for (k < table.count[Reloc](?o.relocs)) {
                val r: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc](k));
                if (r.section.index::usize >= table.count[Section](?o.sections)) {
                    ret err[Fail].err{fail.in_file(fail.in_indexed(fail.malformed("a relocation patches a section the object does not hold"), "relocation", k::u64), name_of(c, id))};
                }
                val flat: u32 = base_of(c, id) + r.section.index;
                if (sec_at(c, flat).present) {
                    val pushed: res[Id[Site], Fail] = table.push[Site](?c.sites, Site{sec: flat, offset: r.offset, reloc: table.nth[Reloc](k)});
                    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    val n: usize = table.count[Site](?c.sites);
    sort.sort_by[Site](table.items[Site](?c.sites), n, site_order);
    var j: usize = 0;
    for (j < n) {
        val s: *Sec = sec_at(c, table.items[Site](?c.sites)[j].sec);
        if (s.site_count == 0) { s.site_first = j::u32; }
        s.site_count = s.site_count + 1;
        j            = j + 1;
    }
    ret err[Fail].ok{};
}

# every symbol placed in a section the link places, ordered by section and
# offset. section and file symbols mark no atom
fun index_points(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = placed(c, id);
        var k:  usize     = 0;
        if (o != nil) {
            for (k < table.count[Symbol](?o.symbols)) {
                val sym:   *Symbol = object.symbol_at(o, table.nth[Symbol](k));
                val marks: bool    = !symbol.names(sym.kind, symbol.SECTION) && !symbol.names(sym.kind, symbol.FILE);
                var p:     Place;
                var at:    bool    = false;
                if (sel sym.def.placed) {
                    p  = sym.def.placed;
                    at = marks;
                }
                if (at) {
                    if (p.section.index::usize >= table.count[Section](?o.sections)) {
                        ret err[Fail].err{fail.in_file(fail.in_indexed(fail.malformed("symbol is placed in a section the object does not hold"), "symbol", k::u64), name_of(c, id))};
                    }
                    val flat: u32 = base_of(c, id) + p.section.index;
                    if (sec_at(c, flat).present) {
                        val pushed: res[Id[Point], Fail] = table.push[Point](?c.points, Point{sec: flat, offset: p.offset, size: sym.size});
                        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
                    }
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    val n: usize = table.count[Point](?c.points);
    sort.sort_by[Point](table.items[Point](?c.points), n, point_order);
    var j: usize = 0;
    for (j < n) {
        val s: *Sec = sec_at(c, table.items[Point](?c.points)[j].sec);
        if (s.point_count == 0) { s.point_first = j::u32; }
        s.point_count = s.point_count + 1;
        j             = j + 1;
    }
    ret err[Fail].ok{};
}

# where the symbol `k` of `id` is defined, an external symbol by the
# definition its name binds to. a section symbol lands `addend` bytes in
fun reach(c: *Context, id: Id[Input], k: Id[Symbol], addend: i64) res[Reach, Fail] {
    val o: *Object = input.object_of(c.in.inputs, id);
    if (k.index::usize >= table.count[Symbol](?o.symbols)) {
        ret res[Reach, Fail].err{fail.malformed("a relocation names a symbol the object does not hold")};
    }
    var at:  Id[Input] = id;
    var sym: *Symbol   = object.symbol_at(o, k);
    if (symbol.binds(sym.binding, symbol.EXTERNAL)) {
        val w: opt[resolve.Won] = resolve.winning(c.in.resolved, id, k);
        if (sel w.none) { ret res[Reach, Fail].ok{Reach.none{}}; }
        at  = w.some.binding.input;
        sym = object.symbol_at(input.object_of(c.in.inputs, at), w.some.binding.symbol);
    }
    if (sel sym.def.placed) { ret res[Reach, Fail].ok{landing(c, at, sym.def.placed, symbol.names(sym.kind, symbol.SECTION), addend)}; }
    if (sel sym.def.entry)  { ret entry_reach(c, at, sym.def.entry); }
    ret res[Reach, Fail].ok{Reach.none{}};
}

fun entry_reach(c: *Context, id: Id[Input], e: Id[Entry]) res[Reach, Fail] {
    val o: *Object = input.object_of(c.in.inputs, id);
    if (e.index::usize >= table.count[Entry](?o.entries)) {
        ret res[Reach, Fail].err{fail.malformed("a reference names an entry the object does not hold")};
    }
    val body: opt[Place] = table.at[Entry](?o.entries, e).body;
    if (sel body.none) { ret res[Reach, Fail].ok{Reach.none{}}; }
    ret res[Reach, Fail].ok{landing(c, id, body.some, false, 0)};
}

# the spot `p` of `id` names, `addend` bytes on for a place named by its
# section, held within the section
fun landing(c: *Context, id: Id[Input], p: Place, place: bool, addend: i64) Reach {
    val flat: u32  = base_of(c, id) + p.section.index;
    val s:    *Sec = sec_at(c, flat);
    if (!s.present) { ret Reach.gone{}; }
    var off: u64 = p.offset;
    if (place) {
        if (off > s.size) { off = s.size; }
        if (addend < 0) {
            val back: u64 = (0 - (addend + 1))::u64 + 1;
            if (back > off) { off = 0; }
            or              { off = off - back; }
        }
        or (addend::u64 > s.size - off) { off = s.size; }
        or                              { off = off + addend::u64; }
    }
    ret Reach.at{Spot{sec: flat, offset: off, place: place}};
}

# what the relocation at site `i` names, its second operand when `minus`
fun target(c: *Context, i: u32, minus: bool) res[Reach, Fail] {
    val st: Site      = table.items[Site](?c.sites)[i];
    val id: Id[Input] = sec_at(c, st.sec).at.input;
    val o:  *Object   = input.object_of(c.in.inputs, id);
    val r:  *Reloc    = table.at[Reloc](?o.relocs, st.reloc);
    if (minus) {
        if (sel r.minus.none) { ret res[Reach, Fail].ok{Reach.none{}}; }
        ret reach(c, id, r.minus.some, 0);
    }
    if (sel r.target.none)     { ret res[Reach, Fail].ok{Reach.none{}}; }
    or (sel r.target.absolute) { ret res[Reach, Fail].ok{Reach.none{}}; }
    or (sel r.target.entry)    { ret entry_reach(c, id, r.target.entry); }
    ret reach(c, id, r.target.symbol, r.addend);
}

fun site_failed(c: *Context, i: u32, f: Fail) err[Fail] {
    val st: Site      = table.items[Site](?c.sites)[i];
    val id: Id[Input] = sec_at(c, st.sec).at.input;
    ret err[Fail].err{fail.in_file(fail.in_indexed(f, "relocation", st.reloc.index::u64), name_of(c, id))};
}

# a section named by a section symbol and an offset cannot have its atoms
# chosen by symbol, unless the reference is an unwind record's, whose offset
# is the place itself, or a section's that only describes code, which the
# link resolves by the place it names
fun note_places(c: *Context) err[Fail] {
    var i: u32 = 0;
    for (i::usize < table.count[Site](?c.sites)) {
        val from: *Sec = sec_at(c, table.items[Site](?c.sites)[i].sec);
        if (from.reaches && !section.treats(from.disposition, section.CUT)) {
            var second: bool = false;
            for {
                val t: res[Reach, Fail] = target(c, i, second);
                if (sel t.err) { ret site_failed(c, i, t.err); }
                val r: Reach = t.ok;
                if (sel r.at) {
                    if (r.at.place) { sec_at(c, r.at.sec).by_place = true; }
                }
                if (second) { brk; }
                second = true;
            }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# cut every present section into atoms by its disposition, taking the
# disposition's fallback where the section cannot be cut as it asks
fun atomize(c: *Context) err[Fail] {
    var i: u32 = 0;
    for (i::usize < table.count[Sec](?c.secs)) {
        if (sec_at(c, i).present) {
            var d: *Disposition = sec_at(c, i).disposition;
            for {
                table.clear[Atom](?c.trial);
                var cut: res[bool, Fail] = res[bool, Fail].ok{true};
                if (section.treats(d, section.CUT))   { cut = records(c, i); }
                or (section.treats(d, section.ATOMS)) { cut = split(c, i); }
                if (sel cut.err)                      { ret err[Fail].err{cut.err}; }
                if (cut.ok)                           { brk; }
                if (d.fallback == nil)                { ret err[Fail].err{fail.internal("a disposition that can fail has no fallback")}; }
                d = d.fallback;
            }
            val s: *Sec = sec_at(c, i);
            s.disposition = d;
            if (table.count[Atom](?c.trial) == 0) {
                val one: err[Fail] = try_atom(c, Atom{sec: i, start: 0, end: s.size, cover: s.size});
                if (sel one.err) { ret one; }
            }
            s.atom_first = table.count[Atom](?c.atoms)::u32;
            s.atom_count = table.count[Atom](?c.trial)::u32;
            val moved: res[Id[Atom], Fail] = table.extend[Atom](?c.atoms, table.items[Atom](?c.trial), table.count[Atom](?c.trial));
            if (sel moved.err) { ret err[Fail].err{moved.err}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# a candidate atom of the section being cut, living through nothing yet
fun try_atom(c: *Context, a: Atom) err[Fail] {
    var fresh: Atom = a;
    fresh.dependents = NONE;
    fresh.sibling    = NONE;
    fresh.cie        = NONE;
    val pushed: res[Id[Atom], Fail] = table.push[Atom](?c.trial, fresh);
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

# one atom per distinct sized symbol, each running to the next. false when
# the boundaries cannot be trusted: a symbol overlaps the next, the first does
# not start the section, an unsized symbol falls outside every atom, or
# something refers into the section by place
fun split(c: *Context, i: u32) res[bool, Fail] {
    val s: Sec = @sec_at(c, i);
    if (s.by_place) { ret res[bool, Fail].ok{false}; }
    val at: Location = Location{record: "symbol"};
    var j:  u32      = s.point_first;
    for (j < s.point_first + s.point_count) {
        val p: Point = table.items[Point](?c.points)[j];
        j = j + 1;
        if (sel p.size.none) { cnt; }
        val end: res[u64, Fail] = checked.add(at, p.offset, p.size.some);
        if (sel end.err)     { ret res[bool, Fail].err{end.err}; }
        if (end.ok > s.size) { ret res[bool, Fail].ok{false}; }
        val n: usize = table.count[Atom](?c.trial);
        if (n == 0 && p.offset != 0) { ret res[bool, Fail].ok{false}; }
        if (n != 0) {
            val prev: *Atom = table.at[Atom](?c.trial, table.nth[Atom](n - 1));
            if (p.offset == prev.start && end.ok == prev.cover) { cnt; }
            if (p.offset < prev.cover)                          { ret res[bool, Fail].ok{false}; }
            prev.end = p.offset;
        }
        val e: err[Fail] = try_atom(c, Atom{sec: i, start: p.offset, end: s.size, cover: end.ok});
        if (sel e.err) { ret res[bool, Fail].err{e.err}; }
    }
    if (table.count[Atom](?c.trial) == 0) { ret res[bool, Fail].ok{false}; }
    j = s.point_first;
    for (j < s.point_first + s.point_count) {
        val p: Point = table.items[Point](?c.points)[j];
        j = j + 1;
        if (sel p.size.some) { cnt; }
        val holder: *Atom = table.at[Atom](?c.trial, table.nth[Atom](holding(table.items[Atom](?c.trial), table.count[Atom](?c.trial), p.offset)));
        if (p.offset >= holder.cover) { ret res[bool, Fail].ok{false}; }
    }
    ret res[bool, Fail].ok{true};
}

# one atom per unwind record, and one for whatever follows a terminator.
# false when the records cannot be read
fun records(c: *Context, i: u32) res[bool, Fail] {
    val s: Sec      = @sec_at(c, i);
    val o: *Object  = input.object_of(c.in.inputs, s.at.input);
    val x: *Section = object.section_at(o, s.at.section);
    if (sel x.contents.zero) { ret res[bool, Fail].ok{false}; }
    if (x.entsize != 0) {
        if (s.size % x.entsize != 0) { ret res[bool, Fail].ok{false}; }
        var off: u64 = 0;
        for (off < s.size) {
            val e: err[Fail] = try_atom(c, Atom{sec: i, start: off, end: off + x.entsize, cover: off + x.entsize, field: opt[u64].some{off}});
            if (sel e.err) { ret res[bool, Fail].err{e.err}; }
            off = off + x.entsize;
        }
        ret res[bool, Fail].ok{true};
    }
    val b:   Bytes  = object.bytes(o, ?x.contents);
    var r:   Reader = reader.make(name_of(c, s.at.input), b.data, b.len, o.target.arch.order);
    var off: u64    = 0;
    for (off < s.size) {
        val e: res[bool, Fail] = record(c, i, ?r, ?off);
        if (sel e.err) {
            if (fail.is_refused(e.err)) { ret res[bool, Fail].err{e.err}; }
            ret res[bool, Fail].ok{false};
        }
        if (!e.ok) { ret res[bool, Fail].ok{false}; }
    }
    ret res[bool, Fail].ok{true};
}

# the call frame record at `off`, which moves past it. a CIE lives through
# the FDEs naming it in a link that collects, and lives on its own in one
# that does not, and an FDE names its function by the relocation at the
# field past its id. false when the record does not frame or names no CIE
# before it
fun record(c: *Context, i: u32, r: *Reader, off: *u64) res[bool, Fail] {
    val size: u64               = sec_at(c, i).size;
    val at:   u64               = @off;
    val f:    res[Framed, Fail] = parse.framed(r, at, size);
    if (sel f.err)       { ret res[bool, Fail].err{f.err}; }
    if (sel f.ok.broken) { ret res[bool, Fail].ok{false}; }
    or (sel f.ok.ended) {
        val e: err[Fail] = try_atom(c, Atom{sec: i, start: at, end: size, cover: size});
        if (sel e.err) { ret res[bool, Fail].err{e.err}; }
        @off = size;
        ret res[bool, Fail].ok{true};
    }
    val rec: parse.Record = f.ok.record;
    var a:   Atom         = Atom{sec: i, start: at, end: rec.end, cover: rec.end, owned: c.in.collects};
    if (sel rec.cie.some) {
        val n: usize = table.count[Atom](?c.trial);
        if (n == 0) { ret res[bool, Fail].ok{false}; }
        val named: *Atom = table.at[Atom](?c.trial, table.nth[Atom](holding(table.items[Atom](?c.trial), n, rec.cie.some)));
        if (named.start != rec.cie.some || sel named.names.some) { ret res[bool, Fail].ok{false}; }
        a.field = opt[u64].some{rec.id + 4};
        a.names = opt[Named].some{Named{field: rec.id, cie: rec.cie.some}};
        a.owned = false;
    }
    val e: err[Fail] = try_atom(c, a);
    if (sel e.err) { ret res[bool, Fail].err{e.err}; }
    @off = rec.end;
    ret res[bool, Fail].ok{true};
}

# the index among the `n` atoms at `atoms`, ordered by start, of the one
# holding `off`: the last starting at or before it
fun holding(atoms: *Atom, n: usize, off: u64) usize {
    var lo: usize = 0;
    var hi: usize = n;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (atoms[mid].start <= off) { lo = mid + 1; }
        or                           { hi = mid; }
    }
    if (lo == 0) { ret 0; }
    ret lo - 1;
}

# the atom of section `i` holding `off`
fun atom_holding(c: *Context, i: u32, off: u64) u32 {
    val s: *Sec = sec_at(c, i);
    ret s.atom_first + holding(?table.items[Atom](?c.atoms)[s.atom_first], s.atom_count::usize, off)::u32;
}

# the relocation site of section `i` at `off`, NONE where there is none
fun site_at(c: *Context, i: u32, off: u64) u32 {
    val s:  *Sec = sec_at(c, i);
    var lo: u32  = s.site_first;
    var hi: u32  = s.site_first + s.site_count;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (table.items[Site](?c.sites)[mid].offset < off) { lo = mid + 1; }
        or                                                 { hi = mid; }
    }
    if (lo < s.site_first + s.site_count && table.items[Site](?c.sites)[lo].offset == off) { ret lo; }
    ret NONE;
}

# tie each unwind record to the atom holding its function, each FDE's CIE to
# the FDE and each dependent section to its owner. a record naming a
# discarded function, or one whose function another table supersedes, never
# lives, and one naming nothing the link places stands on its own
fun link_owners(c: *Context) err[Fail] {
    var spots: Table[Spot] = table.make[Spot](c.in.inputs.a);
    val r:     err[Fail]   = fail.kept(tie(c, ?spots), table.release[Spot](?spots));
    if (sel r.err) { ret r; }
    ret own_sections(c);
}

fun spot_order(a: *Spot, b: *Spot) i64 {
    if (a.sec != b.sec) {
        if (a.sec < b.sec) { ret -1; }
        ret 1;
    }
    if (a.offset < b.offset) { ret -1; }
    if (a.offset > b.offset) { ret 1; }
    ret 0;
}

# the place of each function whose record another table supersedes, in
# `spots`, ordered
fun superseded(c: *Context, spots: *Table[Spot]) err[Fail] {
    if (sel c.in.superseding.none) { ret err[Fail].ok{}; }
    var places: Table[Place] = table.make[Place](c.in.inputs.a);
    var r:      err[Fail]    = err[Fail].ok{};
    var i:      usize        = 0;
    for (i < input.count(c.in.inputs) && sel r.ok) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = placed(c, id);
        i = i + 1;
        if (o == nil) { cnt; }
        table.clear[Place](?places);
        val s: err[Fail] = c.in.superseding.some.superseded(o, ?places);
        if (sel s.err) {
            r = err[Fail].err{fail.in_file(s.err, name_of(c, id))};
            cnt;
        }
        var k: usize = 0;
        for (k < table.count[Place](?places) && sel r.ok) {
            val p: Place = table.items[Place](?places)[k];
            k = k + 1;
            if (p.section.index::usize >= table.count[Section](?o.sections)) {
                r = err[Fail].err{fail.in_file(fail.malformed("a superseded function lies in a section the object does not hold"), name_of(c, id))};
                cnt;
            }
            val pushed: res[Id[Spot], Fail] = table.push[Spot](spots, Spot{sec: base_of(c, id) + p.section.index, offset: p.offset});
            if (sel pushed.err) { r = err[Fail].err{pushed.err}; }
        }
    }
    r = fail.kept(r, table.release[Place](?places));
    if (sel r.err) { ret r; }
    sort.sort_by[Spot](table.items[Spot](spots), table.count[Spot](spots), spot_order);
    ret err[Fail].ok{};
}

# whether `spots`, ordered, holds the place `at`
fun holds_spot(spots: *Table[Spot], at: Spot) bool {
    var lo: usize = 0;
    var hi: usize = table.count[Spot](spots);
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (spot_order(?table.items[Spot](spots)[mid], ?at) < 0) { lo = mid + 1; }
        or                                                       { hi = mid; }
    }
    ret lo < table.count[Spot](spots) && spot_order(?table.items[Spot](spots)[lo], ?at) == 0;
}

fun tie(c: *Context, spots: *Table[Spot]) err[Fail] {
    val sp: err[Fail] = superseded(c, spots);
    if (sel sp.err) { ret sp; }
    var a: u32 = 0;
    for (a::usize < table.count[Atom](?c.atoms)) {
        val named: opt[Named] = atom_at(c, a).names;
        if (sel named.some) { atom_at(c, a).cie = atom_holding(c, atom_at(c, a).sec, named.some.cie); }
        val f: opt[u64] = atom_at(c, a).field;
        if (sel f.some) {
            val site: u32 = site_at(c, atom_at(c, a).sec, f.some);
            if (site != NONE) {
                val t: res[Reach, Fail] = target(c, site, false);
                if (sel t.err)                                                                        { ret site_failed(c, site, t.err); }
                if (sel t.ok.gone)                                                                    { atom_at(c, a).owned = true; }
                if (sel t.ok.at && holds_spot(spots, Spot{sec: t.ok.at.sec, offset: t.ok.at.offset})) { atom_at(c, a).owned = true; }
                or (sel t.ok.at) {
                    val owner: u32 = atom_holding(c, t.ok.at.sec, t.ok.at.offset);
                    if (owner != a) {
                        atom_at(c, a).owned          = true;
                        atom_at(c, a).sibling        = atom_at(c, owner).dependents;
                        atom_at(c, owner).dependents = a;
                    }
                }
            }
        }
        a = a + 1;
    }
    ret err[Fail].ok{};
}

# tie each dependent section to its owner
fun own_sections(c: *Context) err[Fail] {
    var i: u32 = 0;
    for (i::usize < table.count[Sec](?c.secs)) {
        val s: *Sec = sec_at(c, i);
        if (s.present && section.treats(s.disposition, section.FOLLOW)) {
            val o:     *Object          = input.object_of(c.in.inputs, s.at.input);
            val owner: opt[Id[Section]] = object.section_at(o, s.at.section).owner;
            var of:    u32              = NONE;
            if (sel owner.some) {
                if (owner.some.index::usize < table.count[Section](?o.sections)) { of = base_of(c, s.at.input) + owner.some.index; }
            }
            if (of == NONE) {
                ret err[Fail].err{fail.in_file(fail.in_indexed(fail.malformed("a dependent section names no section it belongs to"), "section", s.at.section.index::u64), name_of(c, s.at.input))};
            }
            if (sec_at(c, of).present) {
                s.sibling                = sec_at(c, of).dependents;
                sec_at(c, of).dependents = i;
            }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# ring the present members of every group that is not associative, so that
# reaching one reaches them all
fun ring_groups(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = placed(c, id);
        if (o != nil && table.count[Group](?o.groups) != 0) {
            val n: usize = table.count[Group](?o.groups);
            table.clear[u32](?c.rings);
            val grown: res[Id[u32], Fail] = table.grow[u32](?c.rings, n * 2);
            if (sel grown.err) { ret err[Fail].err{grown.err}; }
            val ends: *u32  = table.items[u32](?c.rings);
            var k:    usize = 0;
            for (k < table.count[Section](?o.sections)) {
                val g:    opt[Id[Group]] = object.section_at(o, table.nth[Section](k)).group;
                val flat: u32            = base_of(c, id) + k::u32;
                var gi:   u32            = NONE;
                if (sel g.some) { gi = g.some.index; }
                if (gi != NONE && sec_at(c, flat).present) {
                    if (gi::usize >= n) {
                        ret err[Fail].err{fail.in_file(fail.in_indexed(fail.malformed("a section is in a group the object does not hold"), "section", k::u64), name_of(c, id))};
                    }
                    if (!group.has(object.group_at(o, Id[Group]{index: gi}).rule, group.ASSOCIATIVE)) {
                        val first: usize = gi::usize * 2;
                        if (ends[first] == 0) { ends[first] = flat + 1; }
                        or                    { sec_at(c, ends[first + 1] - 1).ring = flat; }
                        ends[first + 1] = flat + 1;
                    }
                }
                k = k + 1;
            }
            k = 0;
            for (k < n) {
                if (ends[k * 2] != ends[k * 2 + 1]) { sec_at(c, ends[k * 2 + 1] - 1).ring = ends[k * 2] - 1; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun mark(c: *Context, a: u32) err[Fail] {
    val at: *Atom = atom_at(c, a);
    if (at.live) { ret err[Fail].ok{}; }
    at.live = true;
    if (c.depth < table.count[u32](?c.work)) {
        table.items[u32](?c.work)[c.depth] = a;
    }
    or {
        val pushed: res[Id[u32], Fail] = table.push[u32](?c.work, a);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    }
    c.depth = c.depth + 1;
    ret err[Fail].ok{};
}

fun mark_section(c: *Context, i: u32) err[Fail] {
    val s: Sec = @sec_at(c, i);
    var a: u32 = s.atom_first;
    for (a < s.atom_first + s.atom_count) {
        val e: err[Fail] = mark(c, a);
        if (sel e.err) { ret e; }
        a = a + 1;
    }
    ret err[Fail].ok{};
}

fun mark_reach(c: *Context, r: Reach) err[Fail] {
    if (sel r.at) { ret mark(c, atom_holding(c, r.at.sec, r.at.offset)); }
    ret err[Fail].ok{};
}

fun mark_binding(c: *Context, won: *Binding) err[Fail] {
    val r: res[Reach, Fail] = reach(c, won.input, won.symbol, 0);
    if (sel r.err) { ret err[Fail].err{fail.in_file(r.err, name_of(c, won.input))}; }
    ret mark_reach(c, r.ok);
}

fun mark_name(c: *Context, name: str) err[Fail] {
    if (name == nil) { ret err[Fail].ok{}; }
    val nm: opt[Id[Name]] = intern.find(c.in.names, name, str_len(name));
    if (sel nm.none) { ret err[Fail].ok{}; }
    val w: opt[resolve.Won] = resolve.bound(c.in.resolved, nm.some);
    if (sel w.none) { ret err[Fail].ok{}; }
    ret mark_binding(c, w.some.binding);
}

# mark the atom each retained symbol of an object input defines, which keeps
# that atom and not the rest of its section
fun mark_retained(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(c.in.inputs, id);
        i = i + 1;
        if (o == nil || resolve.library(c.in.resolved, id)) { cnt; }
        var k: usize = 0;
        for (k < table.count[Symbol](?o.symbols)) {
            val sym: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
            k = k + 1;
            if (!sym.retain) { cnt; }
            var r: Reach = Reach.none{};
            if (sel sym.def.placed) { r = landing(c, id, sym.def.placed, false, 0); }
            or (sel sym.def.entry) {
                val at: res[Reach, Fail] = entry_reach(c, id, sym.def.entry);
                if (sel at.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(at.err, "symbol", (k - 1)::u64), name_of(c, id))}; }
                r = at.ok;
            }
            val e: err[Fail] = mark_reach(c, r);
            if (sel e.err) { ret err[Fail].err{fail.in_file(e.err, name_of(c, id))}; }
        }
    }
    ret err[Fail].ok{};
}

# mark every definition a shared library of the link refers to, which the
# image exports for it
fun mark_reached(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        i = i + 1;
        if (!resolve.library(c.in.resolved, id)) { cnt; }
        val o: *Object = input.object_of(c.in.inputs, id);
        var k: usize   = 0;
        for (k < table.count[Symbol](?o.symbols)) {
            val sid: Id[Symbol] = table.nth[Symbol](k);
            val sym: *Symbol    = object.symbol_at(o, sid);
            k = k + 1;
            if (!symbol.binds(sym.binding, symbol.EXTERNAL) || !sel sym.def.undefined) { cnt; }
            val w: opt[resolve.Won] = resolve.winning(c.in.resolved, id, sid);
            if (sel w.none) { cnt; }
            val e: err[Fail] = mark_binding(c, w.some.binding);
            if (sel e.err) { ret e; }
        }
    }
    ret err[Fail].ok{};
}

fun mark_roots(c: *Context) err[Fail] {
    var i: u32 = 0;
    for (i::usize < table.count[Sec](?c.secs)) {
        val s: Sec = @sec_at(c, i);
        if (s.present && section.treats(s.disposition, section.KEEP)) {
            val e: err[Fail] = mark_section(c, i);
            if (sel e.err) { ret e; }
        }
        or (s.present && (section.treats(s.disposition, section.CUT) || (!c.in.collects && !section.treats(s.disposition, section.FOLLOW)))) {
            var a: u32 = s.atom_first;
            for (a < s.atom_first + s.atom_count) {
                if (!atom_at(c, a).owned) {
                    val e: err[Fail] = mark(c, a);
                    if (sel e.err) { ret e; }
                }
                a = a + 1;
            }
        }
        i = i + 1;
    }
    val kept: err[Fail] = mark_retained(c);
    if (sel kept.err) { ret kept; }
    val en: err[Fail] = mark_name(c, c.in.entry);
    if (sel en.err) { ret en; }
    var k: usize = 0;
    for (k < c.in.keep_count) {
        val e: err[Fail] = mark_name(c, c.in.keep[k]);
        if (sel e.err) { ret e; }
        k = k + 1;
    }
    val reached: err[Fail] = mark_reached(c);
    if (sel reached.err)                        { ret reached; }
    if (!output.has(c.in.kind, output.EXPORTS)) { ret err[Fail].ok{}; }
    k = 0;
    for (k < table.count[Binding](?c.in.resolved.bindings)) {
        val b: *Binding = table.at[Binding](?c.in.resolved.bindings, table.nth[Binding](k));
        if (symbol.shows(b.visibility, symbol.EXPORTED)) {
            val e: err[Fail] = mark_binding(c, b);
            if (sel e.err) { ret e; }
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# a live atom reaches what its relocations name and the records describing
# it, and the first time its section is reached, the sections living through
# that section and the rest of its group
fun propagate(c: *Context) err[Fail] {
    for (c.depth != 0) {
        c.depth = c.depth - 1;
        val a:  u32  = table.items[u32](?c.work)[c.depth];
        val at: Atom = @atom_at(c, a);
        val s:  *Sec = sec_at(c, at.sec);
        if (!s.live) {
            s.live = true;
            val ring: u32 = s.ring;
            var dep:  u32 = s.dependents;
            if (ring != NONE) {
                val e: err[Fail] = mark_section(c, ring);
                if (sel e.err) { ret e; }
            }
            for (dep != NONE) {
                val e: err[Fail] = mark_section(c, dep);
                if (sel e.err) { ret e; }
                dep = sec_at(c, dep).sibling;
            }
        }
        if (at.cie != NONE) {
            val e: err[Fail] = mark(c, at.cie);
            if (sel e.err) { ret e; }
        }
        var d: u32 = at.dependents;
        for (d != NONE) {
            val e: err[Fail] = mark(c, d);
            if (sel e.err) { ret e; }
            d = atom_at(c, d).sibling;
        }
        val e: err[Fail] = reach_from(c, at);
        if (sel e.err) { ret e; }
    }
    ret err[Fail].ok{};
}

# mark what the relocations of a live atom name, unless its section only
# describes code
fun reach_from(c: *Context, at: Atom) err[Fail] {
    val s: Sec = @sec_at(c, at.sec);
    if (!s.reaches) { ret err[Fail].ok{}; }
    var i: u32 = s.site_first;
    for (i < s.site_first + s.site_count) {
        val off: u64 = table.items[Site](?c.sites)[i].offset;
        if (off >= at.start && off < at.end) {
            val t: res[Reach, Fail] = target(c, i, false);
            if (sel t.err) { ret site_failed(c, i, t.err); }
            val e: err[Fail] = mark_reach(c, t.ok);
            if (sel e.err) { ret e; }
            val m: res[Reach, Fail] = target(c, i, true);
            if (sel m.err) { ret site_failed(c, i, m.err); }
            val f: err[Fail] = mark_reach(c, m.ok);
            if (sel f.err) { ret f; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun report(c: *Context) err[Fail] {
    var i: u32 = 0;
    for (i::usize < table.count[Sec](?c.secs)) {
        val s: Sec = @sec_at(c, i);
        if (s.live && s.placed) {
            val pushed: res[Id[Ref], Fail] = table.push[Ref](?c.out.kept, s.at);
            if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        }
        i = i + 1;
    }
    var a: u32 = 0;
    for (a::usize < table.count[Atom](?c.atoms)) {
        val at: Atom = @atom_at(c, a);
        if (!sec_at(c, at.sec).placed) {
            a = a + 1;
            cnt;
        }
        if (at.end > at.start) {
            val span: Range         = Range{at: sec_at(c, at.sec).at, start: at.start, end: at.end};
            var to:   *Table[Range] = ?c.out.dropped;
            if (at.live) { to = ?c.out.atoms; }
            val pushed: res[Id[Range], Fail] = table.push[Range](to, span);
            if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        }
        if (at.live) {
            if (sel at.names.some) {
                val pushed: res[Id[Framing], Fail] = table.push[Framing](?c.out.frames, Framing{at: sec_at(c, at.sec).at, field: at.names.some.field, cie: at.names.some.cie});
                if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
            }
        }
        a = a + 1;
    }
    ret err[Fail].ok{};
}

# resolve and collect the inputs alone for a static executable entered at
# _start, collecting what nothing reaches when `collects` is set
fun resolved(inputs: *Inputs, names: *Interner, r: *Resolved, collects: bool, out: *Live) err[Fail] {
    var rd:    Readers    = Readers{rows: table.make[contract.Reader](inputs.a)};
    var notes: Sink       = sink.make(inputs.a, LITTLE);
    var rin:   resolve.In = resolve.In{inputs: inputs, names: names, readers: ?rd, arch: ?x86.X86_64, kind: ?output.STATIC, search: 0, hooks: ?resolve.PLAIN, notes: ?notes};
    val got:   err[Fail]  = fail.kept(resolve.run(?rin, r), sink.release(?notes));
    if (sel got.err) { ret got; }
    var in: In = In{inputs: inputs, names: names, resolved: r, kind: ?output.STATIC, entry: "_start", collects: collects};
    ret run(?in, out);
}
