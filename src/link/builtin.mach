# the format rows of the link mink is built with
#
# a format joins the link's image writers and its table declarers by one line
# in a table here. the tables live apart from the contracts they fill, since a
# format's rows build on those contracts.

use std.types.result.res;
use std.types.size.usize;

use mink.catalog.arch.Arch;
use mink.catalog.format.Format;
use mink.catalog.os.Os;
use elf_image: mink.elf.image;
use mink.fail.Fail;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.link.image.Writer;
use mink.link.image.Writers;
use mink.link.kind.Kind;
use mink.link.reserve.Declarer;
use mink.link.reserve.Declarers;
use mink.link.state.Options;

val WRITER_COUNT: usize                 = 1;
val WRITERS:      [WRITER_COUNT]*Writer = [WRITER_COUNT]*Writer{?elf_image.WRITER};

val DECLARER_COUNT: usize                     = 1;
val DECLARERS:      [DECLARER_COUNT]*Declarer = [DECLARER_COUNT]*Declarer{?elf_image.TABLES};

# the image writers mink is built with
pub fun writers() Writers {
    ret Writers{rows: ?WRITERS[0], count: WRITER_COUNT};
}

# the table declarers mink is built with
pub fun declarers() Declarers {
    ret Declarers{rows: ?DECLARERS[0], count: DECLARER_COUNT};
}

# the options of a link of `k` in format `f` for `a` on `o`, with the formats,
# image writers and table declarers mink is built with, the system's entry
# symbol, nothing kept beyond the roots and no state file
pub fun options(k: *Kind, f: *Format, a: *Arch, o: *Os) res[Options, Fail] {
    val r: res[Registry, Fail] = registry.builtin();
    if (sel r.err) { ret res[Options, Fail].err{r.err}; }
    ret res[Options, Fail].ok{Options{kind: k, format: f, arch: a, os: o, registry: r.ok, writers: writers(), declarers: declarers()}};
}
