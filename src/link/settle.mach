# the settle phase: the inputs' machine flags and attributes become the one
# set the output carries, and inputs that cannot combine are refused

use std.types.error.err;

use A: std.allocator;

use mink.fail;
use mink.fail.Fail;
use mink.link.input.Inputs;
use mink.model.object.Fact;
use mink.table;
use mink.table.Table;

pub rec In {
    inputs: *Inputs;
}

# facts: the settled facts, keyed by format as an object's are
# store: the bytes those facts own
pub rec Settled {
    facts: Table[Fact];
    store: Table[u8];
}

pub fun make(a: *A.Allocator) Settled {
    ret Settled{facts: table.make[Fact](a), store: table.make[u8](a)};
}

pub fun run(in: *In, out: *Settled) err[Fail] {
    ret err[Fail].err{fail.unsupported("settling inputs is not supported yet")};
}

pub fun release(s: *Settled) err[Fail] {
    val rf: err[Fail] = table.release[Fact](?s.facts);
    val rs: err[Fail] = table.release[u8](?s.store);
    if (sel rf.err) { ret rf; }
    ret rs;
}
