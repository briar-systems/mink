# the settle phase: the inputs' machine flags and attributes become the one
# set the output carries, and inputs that cannot combine are refused
#
# every object input is for the link's architecture. one for another, as an
# RV64E object is in an RV64I link, is refused naming it and the first input
# for the link's.
#
# each trait axis merges by its catalog rule across every object input that
# states it. an input that leaves an axis unstated places no constraint on
# it. every rule is order-free: the same inputs in any order settle to the
# same record, or are refused alike. an axis whose rule drops it on a
# disagreement is recorded as dropped, with the inputs that disagree, and
# stays dropped whatever later inputs state. each fact of the output format
# combines by the format's fact rules, a fact of another format has no rule,
# and a fact that describes one section
# or symbol travels with its input. a shared library is not merged, since it
# is linked against rather than into the image. the sections an input holds
# that are not image content are taken through the link's row for their use,
# all of an input with its traits and facts or none. settling folds the
# inputs it has not seen yet, so the link settles again after a phase appends
# inputs, as resolve does with archive members.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use A: std.allocator;

use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Span;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use arch_riscv: mink.catalog.arch.riscv;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.kind;
use mink.catalog.merge;
use mink.catalog.merge.Joined;
use mink.catalog.merge.Merged;
use mink.catalog.merge.Rule;
use mink.catalog.os;
use mink.catalog.os.Ceiling;
use mink.catalog.os.Host;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.format.elf.rules.traits;
use mink.link.consume;
use mink.link.consume.Consumed;
use mink.link.input;
use mink.link.input.Inputs;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Fact;
use mink.model.object.Object;

# inputs: the inputs to settle
# format: the output format, the one format whose facts settle combines
# facts:  how its facts combine
# uses:   how it takes the sections that are not image content
pub rec In {
    inputs: *Inputs;
    arch:   *Arch;
    format: *Format;
    facts:  *merge.Rules;
    uses:   *consume.Uses;
}

# a trait axis the link carries no value of, as its inputs state different
# values and its rule drops it
# ---
# axis: the axis
# held: an earlier input that states one value
# next: the input that states another
pub rec Dropped {
    axis: *Axis;
    held: Id[input.Input];
    next: Id[input.Input];
}

# a format fact the link drops, as its rule drops what no tool must
# understand
# ---
# input:  the input that states it
# format: the format whose fact it is
# key:    its key
# value:  its value
pub rec Ignored {
    input:  Id[input.Input];
    format: *Format;
    key:    u32;
    value:  u64;
}

# facts:    the settled facts, keyed by format as an object's are, in the order
#           of their format's name, their key and what tells facts of the key
#           apart
# store:    the bytes those facts and the traits' values own
# traits:   the merged value of each trait axis the inputs hold a value of,
#           none where that value is what leaving the axis unstated means
# dropped:  each axis dropped, in the order of the axes' names
# ignored:  each fact the link drops, in the order the inputs state them
# consumed: what the sections that are not image content state
# folded:   how many inputs, in input order, the traits merge
# objects:  how many of those are objects, whose traits merged
pub rec Settled {
    facts:    Table[Fact];
    store:    Table[u8];
    traits:   Table[Trait];
    dropped:  Table[Dropped];
    ignored:  Table[Ignored];
    consumed: Consumed;
    folded:   usize;
    objects:  usize;
}

pub fun make(a: *A.Allocator) Settled {
    ret Settled{facts: table.make[Fact](a), store: table.make[u8](a), traits: table.make[Trait](a), dropped: table.make[Dropped](a), ignored: table.make[Ignored](a), consumed: consume.make(a)};
}

fun order_dropped(a: *Dropped, b: *Dropped) i64 {
    ret str_compare(a.axis.name, b.axis.name);
}

fun dropped_position(s: *Settled, x: *Axis) SearchPosition {
    var probe: Dropped = Dropped{axis: x};
    ret sort.binary_search_by[Dropped](table.items[Dropped](?s.dropped), table.count[Dropped](?s.dropped), ?probe, order_dropped);
}

# the record of `x` dropped, none when the link has not dropped it
pub fun dropped(s: *Settled, x: *Axis) opt[*Dropped] {
    val at: SearchPosition = dropped_position(s, x);
    if (sel at.found) {
        val d: *Dropped = table.at[Dropped](?s.dropped, table.nth[Dropped](at.found));
        if (d.axis == x) { ret opt[*Dropped].some{d}; }
    }
    ret opt[*Dropped].none{};
}

# append to `out` a line for each axis the link dropped, naming the inputs
# of `inputs` that state different values of it
pub fun report(s: *Settled, inputs: *Inputs, out: *Sink) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Dropped](?s.dropped)) {
        val d:  *Dropped  = table.at[Dropped](?s.dropped, table.nth[Dropped](i));
        val at: Location  = Location{file: input.at(inputs, d.next).name, record: input.at(inputs, d.held).name};
        val w:  err[Fail] = diag.note(at, d.axis.name, "the inputs state different values of a trait its rule drops, so the link drops it", out);
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Ignored](?s.ignored)) {
        val g:  *Ignored  = table.at[Ignored](?s.ignored, table.nth[Ignored](i));
        val at: Location  = Location{file: input.at(inputs, g.input).name, record: "format fact", index: g.key::u64, indexed: true};
        val w:  err[Fail] = diag.note_valued(at, g.format.name, g.value::i128, "the input states a fact a tool may ignore and no rule knows, so the link drops it", out);
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# refuse the merged traits `ts` when one states, on an ordered axis the host
# `h` bounds, a choice past its ceiling. the refusal names the host, the
# stated choice, the axis and the ceiling
pub fun admit(h: *Host, ts: *Table[Trait]) err[Fail] {
    var i: usize = 0;
    for (i < h.ceiling_count) {
        val c: *Ceiling = ?h.ceilings[i];
        i = i + 1;
        val t: opt[*Trait] = trait.find(ts, c.axis);
        if (sel t.none) { cnt; }
        val s: Setting = t.some.setting;
        if (!sel s.choice)                  { ret err[Fail].err{fail.about(fail.internal("an ordered axis the host bounds holds a value that is no choice"), c.axis.name)}; }
        if (os.admits(h, c.axis, s.choice)) { cnt; }
        var host: str = h.sys.name;
        if (sel h.env.some) { host = h.env.some.name; }
        ret err[Fail].err{fail.cited(fail.about(fail.in_record(fail.in_file(fail.unsupported("the traits state a choice past the host's ceiling"), host), s.choice.name), c.axis.name), c.highest.name)};
    }
    ret err[Fail].ok{};
}

# merge every input not merged yet, in input order. an input that cannot be
# merged is refused, naming it, the earlier input it clashes with and the
# axis or fact, and leaves the settled record as it was
pub fun run(in: *In, out: *Settled) err[Fail] {
    for (out.folded < input.count(in.inputs)) {
        val id: Id[input.Input] = table.nth[input.Input](out.folded);
        val o:  *Object         = input.object_of(in.inputs, id);
        if (o != nil && (sel o.library.none)) {
            val r: err[Fail] = fold(in, out, id, o);
            if (sel r.err) { ret r; }
        }
        out.folded = out.folded + 1;
    }
    ret err[Fail].ok{};
}

# what one input does to an axis of the link's architecture
# ---
# none:    the input holds no value of the axis, or the row fixes it
# kept:    the axis carries this value
# dropped: the axis is dropped, as this earlier input holds another value
# passed:  the axis is dropped already, and the input changes nothing
tag Outcome: u8 {
    none;
    kept:    Setting;
    dropped: Id[input.Input];
    passed;
}

# a settled fact a later input raises to a higher value of its order
# ---
# at:    where the fact is among the settled facts
# value: its new value
rec Raised {
    at:    usize;
    value: u64;
}

# what folding one input changes
# ---
# outcomes: what it does to each axis of the link's architecture, in the
#           order of the row's axes
# facts:    the facts it adds, in the settled order
# keyings:  what tells each fact it adds apart, by its place in facts
# raised:   the settled facts it raises
# ignored:  the facts it states that the link drops
rec Plan {
    outcomes: Table[Outcome];
    facts:    Table[Fact];
    keyings:  Table[*merge.Keying];
    raised:   Table[Raised];
    ignored:  Table[Ignored];
}

# merge the traits and facts of `o`, the input `id`, and take its sections
# that are not image content, all or none
# refuse the input `id` when it is for another architecture than the link,
# naming it, its architecture and the first earlier input for the link's
fun architecture(in: *In, id: Id[input.Input], o: *Object) err[Fail] {
    if (o.target.arch == in.arch) { ret err[Fail].ok{}; }
    val f: Fail  = fail.about(fail.in_file(fail.malformed("an input is for another architecture than the link"), input.at(in.inputs, id).name), o.target.arch.name);
    var k: usize = 0;
    for (k < id.index::usize) {
        val other: Id[input.Input] = table.nth[input.Input](k);
        val p:     *Object         = input.object_of(in.inputs, other);
        k = k + 1;
        if (p == nil || !(sel p.library.none)) { cnt; }
        if (p.target.arch == in.arch)          { ret err[Fail].err{fail.in_record(f, input.at(in.inputs, other).name)}; }
    }
    ret err[Fail].err{f};
}

fun fold(in: *In, out: *Settled, id: Id[input.Input], o: *Object) err[Fail] {
    val other: err[Fail] = architecture(in, id, o);
    if (sel other.err) { ret other; }
    val a:    *A.Allocator = table.allocator[Trait](?out.traits);
    val mark: usize        = table.count[u8](?out.store);
    var plan: Plan         = Plan{outcomes: table.make[Outcome](a), facts: table.make[Fact](a), keyings: table.make[*merge.Keying](a), raised: table.make[Raised](a), ignored: table.make[Ignored](a)};
    val p:    err[Fail]    = planned(in, out, id, o, ?plan);
    var r:    err[Fail]    = p;
    if (sel p.ok)  { r = taken(in, out, id, o, ?plan); }
    if (sel r.err) { table.truncate[u8](?out.store, mark); }
    val ro: err[Fail] = table.release[Outcome](?plan.outcomes);
    val rf: err[Fail] = fail.kept(table.release[Fact](?plan.facts), table.release[*merge.Keying](?plan.keyings));
    val rr: err[Fail] = table.release[Raised](?plan.raised);
    val ri: err[Fail] = table.release[Ignored](?plan.ignored);
    if (sel r.err)  { ret r; }
    if (sel ro.err) { ret ro; }
    if (sel rf.err) { ret rf; }
    if (sel rr.err) { ret rr; }
    ret ri;
}

# take the sections of `o`, the input `id`, that are not image content, then
# commit its plan, undoing what was taken when the commit is refused
fun taken(in: *In, out: *Settled, id: Id[input.Input], o: *Object, plan: *Plan) err[Fail] {
    val held: consume.Mark = consume.mark(?out.consumed);
    val took: err[Fail]    = consume.take(?out.consumed, in.uses, o, ?consume.SETTLE);
    if (sel took.err) { ret err[Fail].err{fail.in_file(took.err, input.at(in.inputs, id).name)}; }
    val r: err[Fail] = applied(out, id, o, plan);
    if (sel r.ok) { ret r; }
    val undone: err[Fail] = consume.restore(?out.consumed, held);
    if (sel undone.err) { ret undone; }
    ret r;
}

# plan what `o`, the input `id`, does to each axis it holds a value of, as
# it states one or its axis says what leaving it unstated means, and to the
# facts. an axis the row fixes holds one value for every input, so it merges
# nothing
fun planned(in: *In, out: *Settled, id: Id[input.Input], o: *Object, plan: *Plan) err[Fail] {
    val inputs: *Inputs   = in.inputs;
    val a:      *Arch     = o.target.arch;
    val room:   err[Fail] = table.reserve[Outcome](?plan.outcomes, a.axis_count);
    if (sel room.err) { ret room; }
    var i: usize = 0;
    for (i < a.axis_count) {
        val x: *Axis              = a.axes[i];
        var s: res[Outcome, Fail] = res[Outcome, Fail].ok{Outcome.none{}};
        if (!(sel x.owner.fixed)) {
            val v: opt[Setting] = object.effective(o, x);
            if (sel v.some) { s = merged(inputs, out, id, o, x, v.some); }
        }
        if (sel s.err) { ret err[Fail].err{s.err}; }
        val p: res[Id[Outcome], Fail] = table.push[Outcome](?plan.outcomes, s.ok);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Fact](?o.facts)) {
        val r: err[Fail] = planned_fact(in, out, id, o, table.at[Fact](?o.facts, table.nth[Fact](i)), plan);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bytes of `h` as the settled record holds them
fun settled_bytes(out: *Settled, h: *Held) Bytes {
    ret store.at(table.items[u8](?out.store), h);
}

# a copy of the bytes `b` the settled record owns
fun own(out: *Settled, b: Bytes) res[Held, Fail] {
    val start: usize             = table.count[u8](?out.store);
    val r:     res[Id[u8], Fail] = table.extend[u8](?out.store, b.data, b.len);
    if (sel r.err) { ret res[Held, Fail].err{r.err}; }
    ret res[Held, Fail].ok{Held.owned{Span{start: start, len: b.len}}};
}

# what `s`, the value `o`, the input `id`, holds on `x`, does to the axis,
# what lies in bytes kept owned by the settled record
fun merged(inputs: *Inputs, out: *Settled, id: Id[input.Input], o: *Object, x: *Axis, s: Setting) res[Outcome, Fail] {
    val gone: opt[*Dropped] = dropped(out, x);
    if (sel gone.some) { ret res[Outcome, Fail].ok{Outcome.passed{}}; }
    val held: opt[*Trait] = trait.find(?out.traits, x);
    if (sel held.none && out.objects != 0) {
        val base: opt[Setting] = trait.absent_value(x);
        if (sel base.some) { ret joined(inputs, id, x, base.some, s); }
    }
    if (trait.bytes_held(s)) {
        val next: Bytes = store.bytes(?o.store, held_of(s));
        if (sel held.none) {
            val copy: res[Held, Fail] = own(out, next);
            if (sel copy.err) { ret res[Outcome, Fail].err{copy.err}; }
            ret res[Outcome, Fail].ok{Outcome.kept{held_at(s, copy.ok)}};
        }
        ret merged_bytes(inputs, out, id, x, held.some, s, next);
    }
    if (sel held.none) { ret res[Outcome, Fail].ok{Outcome.kept{s}}; }
    ret joined(inputs, id, x, held.some.setting, s);
}

# what merging `s`, which the input `id` holds on `x`, into `held` does to
# the axis. an earlier input that left an axis unstated whose absence means a
# value held that value, which the settled record holds as nothing
fun joined(inputs: *Inputs, id: Id[input.Input], x: *Axis, held: Setting, s: Setting) res[Outcome, Fail] {
    val m: Joined[Setting] = trait.merge(x, held, s);
    if (sel m.refused) { ret res[Outcome, Fail].err{clash(inputs, id, x)}; }
    or (sel m.dropped) { ret dropped_by(inputs, id, x); }
    ret res[Outcome, Fail].ok{Outcome.kept{m.kept}};
}

# the bytes a text, a pair or a set holds
fun held_of(s: Setting) *Held {
    var h: *Held = nil;
    if (sel s.text) { h = ?s.text; }
    or (sel s.set)  { h = ?s.set; }
    or (sel s.pair) { h = ?s.pair.text; }
    ret h;
}

# `s`, a text, a pair or a set, with its bytes at `h`
fun held_at(s: Setting, h: Held) Setting {
    if (sel s.set)  { ret Setting.set{h}; }
    or (sel s.pair) { ret Setting.pair{trait.Paired{number: s.pair.number, text: h}}; }
    ret Setting.text{h};
}

# the merge of `s`, whose bytes are `next`, the input `id` holds on `x` into
# the value `held` the settled record holds. a pair is the same when its
# number and bytes are
fun merged_bytes(inputs: *Inputs, out: *Settled, id: Id[input.Input], x: *Axis, held: *Trait, s: Setting, next: Bytes) res[Outcome, Fail] {
    if (!trait.bytes_held(held.setting)) { ret res[Outcome, Fail].err{fail.about(fail.internal("an axis whose values lie in bytes holds one that does not"), x.name)}; }
    val was: Bytes             = settled_bytes(out, held_of(held.setting));
    var m:   res[Merged, Fail] = res[Merged, Fail].ok{Merged.refused{}};
    if (sel s.pair) {
        var same: bool = false;
        if (sel held.setting.pair) { same = held.setting.pair.number == s.pair.number && store.same_bytes(was, next); }
        if (same)                  { m = res[Merged, Fail].ok{Merged.held{}}; }
        or (sel x.merge.agreed)    { m = res[Merged, Fail].ok{Merged.dropped{}}; }
    }
    or                    { m = merge.merge_bytes(table.allocator[u8](?out.store), x.merge, was, next, ?out.store); }
    if (sel m.err)        { ret res[Outcome, Fail].err{fail.about(fail.in_file(m.err, input.at(inputs, id).name), x.name)}; }
    if (sel m.ok.refused) { ret res[Outcome, Fail].err{clash(inputs, id, x)}; }
    or (sel m.ok.dropped) { ret dropped_by(inputs, id, x); }
    or (sel m.ok.held)    { ret res[Outcome, Fail].ok{Outcome.kept{held.setting}}; }
    ret res[Outcome, Fail].ok{Outcome.kept{held_at(s, Held.owned{m.ok.written})}};
}

# the drop of `x` the input `id` makes by stating a value an earlier input
# does not
fun dropped_by(inputs: *Inputs, id: Id[input.Input], x: *Axis) res[Outcome, Fail] {
    val e: opt[Id[input.Input]] = earlier(inputs, id, x);
    if (sel e.none) { ret res[Outcome, Fail].err{fail.about(fail.internal("a trait axis is dropped that no earlier input states"), x.name)}; }
    ret res[Outcome, Fail].ok{Outcome.dropped{e.some}};
}

# the bytes `c` holds in a store whose owned bytes begin at `base`, none for
# a zero fill
fun contents_of(base: *u8, c: *Contents) Bytes {
    if (sel c.held) { ret store.at(base, ?c.held); }
    ret Bytes{data: nil, len: 0};
}

# how many bytes `c` holds
fun contents_len(base: *u8, c: *Contents) u64 {
    if (sel c.zero) { ret c.zero; }
    ret contents_of(base, c).len::u64;
}

# whether `c` holds only zero bytes
fun all_zero(base: *u8, c: *Contents) bool {
    val b: Bytes = contents_of(base, c);
    var i: usize = 0;
    for (i < b.len) {
        if (b.data[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the byte `i` of `c`
fun contents_at(base: *u8, c: *Contents, i: u64) u8 {
    if (sel c.zero) { ret 0; }
    ret contents_of(base, c).data[i::usize];
}

# whether two facts' data hold the same bytes
fun same_contents(a_base: *u8, a: *Contents, b_base: *u8, b: *Contents) bool {
    val n: u64 = contents_len(a_base, a);
    if (n != contents_len(b_base, b)) { ret false; }
    var i: u64 = 0;
    for (i < n) {
        if (contents_at(a_base, a, i) != contents_at(b_base, b, i)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the order of two byte strings, by their bytes
fun order_bytes(x: Bytes, y: Bytes) i64 {
    var i: usize = 0;
    for (i < x.len && i < y.len) {
        if (x.data[i] < y.data[i]) { ret -1; }
        if (x.data[i] > y.data[i]) { ret 1; }
        i = i + 1;
    }
    if (x.len < y.len) { ret -1; }
    if (x.len > y.len) { ret 1; }
    ret 0;
}

# the settled order of facts: by the name of their format, their key and what
# tells facts of the key apart under `by`, their value or their data, each
# held in a store whose owned bytes begin at its base
fun order_facts(x: *Fact, x_base: *u8, y: *Fact, y_base: *u8, by: *merge.Keying) i64 {
    val names: i64 = str_compare(x.format.name, y.format.name);
    if (names != 0)    { ret names; }
    if (x.key < y.key) { ret -1; }
    if (x.key > y.key) { ret 1; }
    if (sel by.value) {
        if (x.value < y.value) { ret -1; }
        if (x.value > y.value) { ret 1; }
    }
    or (sel by.data) {
        ret order_bytes(contents_of(x_base, ?x.data), contents_of(y_base, ?y.data));
    }
    ret 0;
}

# where the fact `f` is in `t`, which holds facts in the settled order: the
# fact of its identity `t` holds, if any, and where `f` goes
rec Located {
    held: opt[usize];
    at:   usize;
}

# where `f`, held in a store whose owned bytes begin at `f_base`, is in `t`,
# whose facts' bytes begin at `t_base`, its identity told by `by`
fun locate(t: *Table[Fact], t_base: *u8, f: *Fact, f_base: *u8, by: *merge.Keying) Located {
    var lo: usize = 0;
    var hi: usize = table.count[Fact](t);
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val c:   i64   = order_facts(?table.items[Fact](t)[mid], t_base, f, f_base, by);
        if (c == 0) { ret Located{held: opt[usize].some{mid}, at: mid}; }
        if (c < 0)  { lo = mid + 1; }
        or          { hi = mid; }
    }
    ret Located{held: opt[usize].none{}, at: lo};
}

# plan the fact `f` of `o`, the input `id`
fun planned_fact(in: *In, out: *Settled, id: Id[input.Input], o: *Object, f: *Fact, plan: *Plan) err[Fail] {
    val inputs: *Inputs    = in.inputs;
    val name:   str        = input.at(inputs, id).name;
    var row:    opt[*Rule] = opt[*Rule].none{};
    if (f.format == in.format) { row = merge.rule_of(in.facts, f.key); }
    if (sel row.none) {
        ret err[Fail].err{fail.valued(fail.about(fail.in_file(fail.unsupported("settle has no rule for this format fact"), name), f.format.name), f.key::i128)};
    }
    val r:    *Rule = row.some;
    val base: *u8   = store.base(?o.store);
    if (sel r.merge.local) { ret err[Fail].ok{}; }
    if (sel r.merge.refused) {
        ret err[Fail].err{fail.valued(fail.about(fail.in_file(fail.unsupported("the input states a fact a tool must not ignore and no rule knows"), name), f.format.name), f.value::i128)};
    }
    if (sel r.merge.dropped) {
        val g: res[Id[Ignored], Fail] = table.push[Ignored](?plan.ignored, Ignored{input: id, format: f.format, key: f.key, value: f.value});
        if (sel g.err) { ret err[Fail].err{g.err}; }
        ret err[Fail].ok{};
    }
    if (sel r.merge.drained) {
        if (all_zero(base, ?f.data)) { ret err[Fail].ok{}; }
        ret err[Fail].err{fail.valued(fail.about(fail.in_file(fail.unsupported("settling bits of a format fact no trait row maps is not supported"), name), f.format.name), f.value::i128)};
    }
    val at: Located = locate(?out.facts, table.items[u8](?out.store), f, base, r.by);
    if (sel at.held.some) {
        val h:     *Fact = table.at[Fact](?out.facts, table.nth[Fact](at.held.some));
        val clash: Fail  = fact_clash(inputs, id, f, base, r.by, nil);
        if (!sel r.by.data && !same_contents(table.items[u8](?out.store), ?h.data, base, ?f.data)) { ret err[Fail].err{clash}; }
        if (h.value == f.value)                                                                    { ret err[Fail].ok{}; }
        if (sel r.merge.union)                                                                     { ret raised(plan, at.held.some, h.value, h.value | f.value); }
        if (sel r.merge.highest) {
            val kept: opt[u64] = merge.highest(r.merge.highest, h.value, f.value);
            if (sel kept.none) { ret err[Fail].err{fact_clash(inputs, id, f, base, r.by, r.merge.highest)}; }
            ret raised(plan, at.held.some, h.value, kept.some);
        }
        ret err[Fail].err{clash};
    }
    val twice: Located = locate(?plan.facts, table.items[u8](?out.store), f, base, r.by);
    if (sel twice.held.some) {
        ret err[Fail].err{fail.valued(fail.about(fail.in_file(fail.malformed("a format fact is stated twice"), name), f.format.name), f.key::i128)};
    }
    var copy: Fact = @f;
    if (sel f.data.held) {
        val b: res[Held, Fail] = own(out, store.at(base, ?f.data.held));
        if (sel b.err) { ret err[Fail].err{b.err}; }
        copy.data = Contents.held{b.ok};
    }
    val k: err[Fail] = table.insert[*merge.Keying](?plan.keyings, twice.at, r.by);
    if (sel k.err) { ret k; }
    ret table.insert[Fact](?plan.facts, twice.at, copy);
}

# the raise of the settled fact at `at`, which holds `held`, to the value
# `kept` its rule merges it into
fun raised(plan: *Plan, at: usize, held: u64, kept: u64) err[Fail] {
    if (kept == held) { ret err[Fail].ok{}; }
    val p: res[Id[Raised], Fail] = table.push[Raised](?plan.raised, Raised{at: at, value: kept});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# commit the plan of `o`, the input `id`, refusing only before anything
# changes
fun applied(out: *Settled, id: Id[input.Input], o: *Object, plan: *Plan) err[Fail] {
    val a:       *Arch    = o.target.arch;
    val results: *Outcome = table.items[Outcome](?plan.outcomes);
    var added:   usize    = 0;
    var gone:    usize    = 0;
    var i:       usize    = 0;
    for (i < a.axis_count) {
        val held: opt[*Trait] = trait.find(?out.traits, a.axes[i]);
        if (sel results[i].dropped)               { gone = gone + 1; }
        or (sel results[i].kept && sel held.none) { added = added + 1; }
        i = i + 1;
    }
    val room: err[Fail] = table.reserve[Trait](?out.traits, added);
    if (sel room.err) { ret room; }
    val drops: err[Fail] = table.reserve[Dropped](?out.dropped, gone);
    if (sel drops.err) { ret drops; }
    val facts: err[Fail] = table.reserve[Fact](?out.facts, table.count[Fact](?plan.facts));
    if (sel facts.err) { ret facts; }
    val ignored: res[Id[Ignored], Fail] = table.extend[Ignored](?out.ignored, table.items[Ignored](?plan.ignored), table.count[Ignored](?plan.ignored));
    if (sel ignored.err) { ret err[Fail].err{ignored.err}; }
    i = 0;
    for (i < a.axis_count) {
        val r: err[Fail] = outcome_applied(out, id, a.axes[i], ?results[i]);
        i = i + 1;
        if (sel r.err) { ret r; }
    }
    i = 0;
    for (i < table.count[Raised](?plan.raised)) {
        val up: *Raised = table.at[Raised](?plan.raised, table.nth[Raised](i));
        table.at[Fact](?out.facts, table.nth[Fact](up.at)).value = up.value;
        i                                                        = i + 1;
    }
    i = 0;
    for (i < table.count[Fact](?plan.facts)) {
        val f:    *Fact     = table.at[Fact](?plan.facts, table.nth[Fact](i));
        val base: *u8       = table.items[u8](?out.store);
        val at:   Located   = locate(?out.facts, base, f, base, table.items[*merge.Keying](?plan.keyings)[i]);
        val r:    err[Fail] = table.insert[Fact](?out.facts, at.at, @f);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    out.objects = out.objects + 1;
    ret err[Fail].ok{};
}

# what the outcome `s` of a trait on `x` of the input `id` does to the
# settled record, whose tables hold room for it
fun outcome_applied(out: *Settled, id: Id[input.Input], x: *Axis, s: *Outcome) err[Fail] {
    if (sel s.passed) { ret err[Fail].ok{}; }
    or (sel s.none)   { ret err[Fail].ok{}; }
    or (sel s.dropped) {
        # a value its absence means is held as nothing, so there is nothing to remove
        val stated: opt[*Trait] = trait.find(?out.traits, x);
        if (sel stated.some) {
            val gone: err[Fail] = trait.remove(?out.traits, x);
            if (sel gone.err) { ret gone; }
        }
        val at: SearchPosition = dropped_position(out, x);
        if (sel at.found) { ret err[Fail].err{fail.about(fail.internal("a trait axis is dropped twice"), x.name)}; }
        ret table.insert[Dropped](?out.dropped, at.insertion, Dropped{axis: x, held: s.dropped, next: id});
    }
    val held: opt[*Trait] = trait.find(?out.traits, x);
    if (trait.unstated(x, s.kept)) {
        if (sel held.some) { ret trait.remove(?out.traits, x); }
        ret err[Fail].ok{};
    }
    if (sel held.some) {
        held.some.setting = s.kept;
        ret err[Fail].ok{};
    }
    ret trait.add(?out.traits, Trait{axis: x, setting: s.kept});
}

# the first input before `id` that holds a value of `x`, none when no earlier
# input does
fun earlier(inputs: *Inputs, id: Id[input.Input], x: *Axis) opt[Id[input.Input]] {
    var k: usize = 0;
    for (k < id.index::usize) {
        val e: Id[input.Input] = table.nth[input.Input](k);
        val o: *Object         = input.object_of(inputs, e);
        if (o != nil && (sel o.library.none)) {
            val s: opt[Setting] = object.effective(o, x);
            if (sel s.some) { ret opt[Id[input.Input]].some{e}; }
        }
        k = k + 1;
    }
    ret opt[Id[input.Input]].none{};
}

# the refusal of input `id` stating on `x` what the earlier inputs' merged
# value cannot take, naming the first earlier input that states `x`
fun clash(inputs: *Inputs, id: Id[input.Input], x: *Axis) Fail {
    val f: Fail                 = fail.about(fail.in_file(fail.malformed("an input states a trait value an earlier input contradicts"), input.at(inputs, id).name), x.name);
    val e: opt[Id[input.Input]] = earlier(inputs, id, x);
    if (sel e.some) { ret fail.in_record(f, input.at(inputs, e.some).name); }
    ret f;
}

# the refusal of input `id` stating the fact `f`, held in a store whose owned
# bytes begin at `base`, which an earlier input states otherwise, naming the
# first earlier input that states a fact of its identity under `by`, past
# those at the bottom of `order` when the row ranks its values
fun fact_clash(inputs: *Inputs, id: Id[input.Input], f: *Fact, base: *u8, by: *merge.Keying, order: *merge.Order) Fail {
    var shown: u64 = f.key::u64;
    if (sel by.value) { shown = f.value; }
    val e: Fail  = fail.valued(fail.about(fail.in_file(fail.malformed("an input states a format fact an earlier input contradicts"), input.at(inputs, id).name), f.format.name), shown::i128);
    var k: usize = 0;
    for (k < id.index::usize) {
        val other: Id[input.Input] = table.nth[input.Input](k);
        val o:     *Object         = input.object_of(inputs, other);
        k = k + 1;
        if (o == nil || !(sel o.library.none)) { cnt; }
        var j: usize = 0;
        for (j < table.count[Fact](?o.facts)) {
            val g: *Fact = table.at[Fact](?o.facts, table.nth[Fact](j));
            j = j + 1;
            val same: bool = g.format == f.format && order_facts(g, store.base(?o.store), f, base, by) == 0;
            if (same && (order == nil || !merge.bottom(order, g.value))) { ret fail.in_record(e, input.at(inputs, other).name); }
        }
    }
    ret e;
}

pub fun release(s: *Settled) err[Fail] {
    val rf: err[Fail] = table.release[Fact](?s.facts);
    val rs: err[Fail] = table.release[u8](?s.store);
    val rt: err[Fail] = table.release[Trait](?s.traits);
    val rd: err[Fail] = table.release[Dropped](?s.dropped);
    val ri: err[Fail] = table.release[Ignored](?s.ignored);
    val rc: err[Fail] = consume.release(?s.consumed);
    if (sel rf.err) { ret rf; }
    if (sel rs.err) { ret rs; }
    if (sel rt.err) { ret rt; }
    if (sel rd.err) { ret rd; }
    if (sel ri.err) { ret ri; }
    ret rc;
}

# a riscv64 object stating the float ABI `abi` and, when `rvc`, compressed code
fun riscv(a: *A.Allocator, abi: *trait.Choice, rvc: bool) res[Object, Fail] {
    var o: Object    = object.make(a, ?arch_riscv.RISCV64, ?kind.RELOCATABLE);
    var r: err[Fail] = object.state(?o, ?arch_riscv.RISCV_FLOAT_ABI, Setting.choice{abi});
    if (sel r.ok && rvc) { r = object.state(?o, ?arch_riscv.RISCV_RVC, Setting.flag{true}); }
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}
