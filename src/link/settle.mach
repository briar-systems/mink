# the settle phase: the inputs' machine flags and attributes become the one
# set the output carries, and inputs that cannot combine are refused
#
# every object input is for the link's architecture. one for another, as an
# RV64E object is in an RV64I link, is refused naming it and the first input
# for the link's.
#
# each trait axis merges by its catalog rule across every object input that
# states it. an input that leaves an axis unstated places no constraint on
# it. every rule is order-free: the same inputs in any order settle to the
# same record, or are refused alike. an axis whose rule drops it on a
# disagreement is recorded as dropped, with the inputs that disagree, and
# stays dropped whatever later inputs state. each fact of the output format
# combines by the format's fact rules, a fact of another format has no rule,
# and a fact that describes one section
# or symbol travels with its input. a shared library is not merged, since it
# is linked against rather than into the image. the sections an input holds
# that are not image content are taken through the link's row for their use,
# all of an input with its traits and facts or none. settling folds the
# inputs it has not seen yet, so the link settles again after a phase appends
# inputs, as resolve does with archive members.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Span;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.list;
use arch_riscv: mink.catalog.arch.riscv;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.isa;
use mink.catalog.merge;
use mink.catalog.merge.Joined;
use mink.catalog.merge.Merged;
use mink.catalog.merge.Rule;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.format.contract;
use mink.format.contract.Reading;
use mink.format.elf.model.tables;
use elf_fact:       mink.format.elf.neutral.fact;
use elf_convention: mink.format.elf.rules.convention;
use mink.format.elf.rules.traits;
use mink.format.elf.rules.traits.Word;
use mink.format.elf.rules.traits.Words;
use mink.link.consume;
use mink.link.consume.Consumed;
use mink.link.input;
use mink.link.input.Given;
use mink.link.input.Inputs;
use mink.model.compare;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Fact;
use mink.model.object.Object;

# inputs: the inputs to settle
# format: the output format, the one format whose facts settle combines
# facts:  how its facts combine
# uses:   how it takes the sections that are not image content
pub rec In {
    inputs: *Inputs;
    arch:   *Arch;
    format: *Format;
    facts:  *merge.Rules;
    uses:   *consume.Uses;
}

# a trait axis the link carries no value of, as its inputs state different
# values and its rule drops it
# ---
# axis: the axis
# held: an earlier input that states one value
# next: the input that states another
pub rec Dropped {
    axis: *Axis;
    held: Id[input.Input];
    next: Id[input.Input];
}

# a format fact the link drops, as its rule drops what no tool must
# understand
# ---
# input:  the input that states it
# format: the format whose fact it is
# key:    its key
# value:  its value
pub rec Ignored {
    input:  Id[input.Input];
    format: *Format;
    key:    u32;
    value:  u64;
}

# facts:    the settled facts, keyed by format as an object's are, in the order
#           of their format's name, their key and their value
# store:    the bytes those facts and the traits' values own
# traits:   the merged value of each trait axis the inputs hold a value of,
#           none where that value is what leaving the axis unstated means
# dropped:  each axis dropped, in the order of the axes' names
# ignored:  each fact the link drops, in the order the inputs state them
# consumed: what the sections that are not image content state
# folded:   how many inputs, in input order, the traits merge
# objects:  how many of those are objects, whose traits merged
pub rec Settled {
    facts:    Table[Fact];
    store:    Table[u8];
    traits:   Table[Trait];
    dropped:  Table[Dropped];
    ignored:  Table[Ignored];
    consumed: Consumed;
    folded:   usize;
    objects:  usize;
}

pub fun make(a: *A.Allocator) Settled {
    ret Settled{facts: table.make[Fact](a), store: table.make[u8](a), traits: table.make[Trait](a), dropped: table.make[Dropped](a), ignored: table.make[Ignored](a), consumed: consume.make(a)};
}

fun order_dropped(a: *Dropped, b: *Dropped) i64 {
    ret str_compare(a.axis.name, b.axis.name);
}

fun dropped_position(s: *Settled, x: *Axis) SearchPosition {
    var probe: Dropped = Dropped{axis: x};
    ret sort.binary_search_by[Dropped](table.items[Dropped](?s.dropped), table.count[Dropped](?s.dropped), ?probe, order_dropped);
}

# the record of `x` dropped, none when the link has not dropped it
pub fun dropped(s: *Settled, x: *Axis) opt[*Dropped] {
    val at: SearchPosition = dropped_position(s, x);
    if (sel at.found) {
        val d: *Dropped = table.at[Dropped](?s.dropped, table.nth[Dropped](at.found));
        if (d.axis == x) { ret opt[*Dropped].some{d}; }
    }
    ret opt[*Dropped].none{};
}

# append to `out` a line for each axis the link dropped, naming the inputs
# of `inputs` that state different values of it
pub fun report(s: *Settled, inputs: *Inputs, out: *Sink) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Dropped](?s.dropped)) {
        val d:  *Dropped  = table.at[Dropped](?s.dropped, table.nth[Dropped](i));
        val at: Location  = Location{file: input.at(inputs, d.next).name, record: input.at(inputs, d.held).name};
        val w:  err[Fail] = diag.note(at, d.axis.name, "the inputs state different values of a trait its rule drops, so the link drops it", out);
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Ignored](?s.ignored)) {
        val g:  *Ignored  = table.at[Ignored](?s.ignored, table.nth[Ignored](i));
        val at: Location  = Location{file: input.at(inputs, g.input).name, record: "format fact", index: g.key::u64, indexed: true};
        val w:  err[Fail] = diag.note_valued(at, g.format.name, g.value::i128, "the input states a fact a tool may ignore and no rule knows, so the link drops it", out);
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# merge every input not merged yet, in input order. an input that cannot be
# merged is refused, naming it, the earlier input it clashes with and the
# axis or fact, and leaves the settled record as it was
pub fun run(in: *In, out: *Settled) err[Fail] {
    for (out.folded < input.count(in.inputs)) {
        val id: Id[input.Input] = table.nth[input.Input](out.folded);
        val o:  *Object         = input.object_of(in.inputs, id);
        if (o != nil && (sel o.library.none)) {
            val r: err[Fail] = fold(in, out, id, o);
            if (sel r.err) { ret r; }
        }
        out.folded = out.folded + 1;
    }
    ret err[Fail].ok{};
}

# what one input does to an axis of the link's architecture
# ---
# none:    the input holds no value of the axis, or the row fixes it
# kept:    the axis carries this value
# dropped: the axis is dropped, as this earlier input holds another value
# passed:  the axis is dropped already, and the input changes nothing
tag Outcome: u8 {
    none;
    kept:    Setting;
    dropped: Id[input.Input];
    passed;
}

# a settled fact a later input raises to a higher value of its order
# ---
# at:    where the fact is among the settled facts
# value: its new value
rec Raised {
    at:    usize;
    value: u64;
}

# what folding one input changes
# ---
# outcomes: what it does to each axis of the link's architecture, in the
#           order of the row's axes
# facts:    the facts it adds, in the settled order
# raised:   the settled facts it raises
# ignored:  the facts it states that the link drops
rec Plan {
    outcomes: Table[Outcome];
    facts:    Table[Fact];
    raised:   Table[Raised];
    ignored:  Table[Ignored];
}

# merge the traits and facts of `o`, the input `id`, and take its sections
# that are not image content, all or none
# refuse the input `id` when it is for another architecture than the link,
# naming it, its architecture and the first earlier input for the link's
fun architecture(in: *In, id: Id[input.Input], o: *Object) err[Fail] {
    if (o.target.arch == in.arch) { ret err[Fail].ok{}; }
    val f: Fail  = fail.about(fail.in_file(fail.malformed("an input is for another architecture than the link"), input.at(in.inputs, id).name), o.target.arch.name);
    var k: usize = 0;
    for (k < id.index::usize) {
        val other: Id[input.Input] = table.nth[input.Input](k);
        val p:     *Object         = input.object_of(in.inputs, other);
        k = k + 1;
        if (p == nil || !(sel p.library.none)) { cnt; }
        if (p.target.arch == in.arch)          { ret err[Fail].err{fail.in_record(f, input.at(in.inputs, other).name)}; }
    }
    ret err[Fail].err{f};
}

fun fold(in: *In, out: *Settled, id: Id[input.Input], o: *Object) err[Fail] {
    val other: err[Fail] = architecture(in, id, o);
    if (sel other.err) { ret other; }
    val a:    *A.Allocator = out.traits.a;
    val mark: usize        = table.count[u8](?out.store);
    var plan: Plan         = Plan{outcomes: table.make[Outcome](a), facts: table.make[Fact](a), raised: table.make[Raised](a), ignored: table.make[Ignored](a)};
    val p:    err[Fail]    = planned(in, out, id, o, ?plan);
    var r:    err[Fail]    = p;
    if (sel p.ok)  { r = taken(in, out, id, o, ?plan); }
    if (sel r.err) { table.truncate[u8](?out.store, mark); }
    val ro: err[Fail] = table.release[Outcome](?plan.outcomes);
    val rf: err[Fail] = table.release[Fact](?plan.facts);
    val rr: err[Fail] = table.release[Raised](?plan.raised);
    val ri: err[Fail] = table.release[Ignored](?plan.ignored);
    if (sel r.err)  { ret r; }
    if (sel ro.err) { ret ro; }
    if (sel rf.err) { ret rf; }
    if (sel rr.err) { ret rr; }
    ret ri;
}

# take the sections of `o`, the input `id`, that are not image content, then
# commit its plan, undoing what was taken when the commit is refused
fun taken(in: *In, out: *Settled, id: Id[input.Input], o: *Object, plan: *Plan) err[Fail] {
    val held: consume.Mark = consume.mark(?out.consumed);
    val took: err[Fail]    = consume.take(?out.consumed, in.uses, o);
    if (sel took.err) { ret err[Fail].err{fail.in_file(took.err, input.at(in.inputs, id).name)}; }
    val r: err[Fail] = applied(out, id, o, plan);
    if (sel r.ok) { ret r; }
    val undone: err[Fail] = consume.restore(?out.consumed, held);
    if (sel undone.err) { ret undone; }
    ret r;
}

# plan what `o`, the input `id`, does to each axis it holds a value of, as
# it states one or its axis says what leaving it unstated means, and to the
# facts. an axis the row fixes holds one value for every input, so it merges
# nothing
fun planned(in: *In, out: *Settled, id: Id[input.Input], o: *Object, plan: *Plan) err[Fail] {
    val inputs: *Inputs   = in.inputs;
    val a:      *Arch     = o.target.arch;
    val room:   err[Fail] = table.reserve[Outcome](?plan.outcomes, a.axis_count);
    if (sel room.err) { ret room; }
    var i: usize = 0;
    for (i < a.axis_count) {
        val x: *Axis              = a.axes[i];
        var s: res[Outcome, Fail] = res[Outcome, Fail].ok{Outcome.none{}};
        if (!(sel x.owner.fixed)) {
            val v: opt[Setting] = object.effective(o, x);
            if (sel v.some) { s = merged(inputs, out, id, o, x, v.some); }
        }
        if (sel s.err) { ret err[Fail].err{s.err}; }
        val p: res[Id[Outcome], Fail] = table.push[Outcome](?plan.outcomes, s.ok);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Fact](?o.facts)) {
        val r: err[Fail] = planned_fact(in, out, id, o, table.at[Fact](?o.facts, table.nth[Fact](i)), plan);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bytes of `h` as the settled record holds them
fun settled_bytes(out: *Settled, h: *Held) Bytes {
    ret store.at(table.items[u8](?out.store), h);
}

# a copy of the bytes `b` the settled record owns
fun own(out: *Settled, b: Bytes) res[Held, Fail] {
    val start: usize             = table.count[u8](?out.store);
    val r:     res[Id[u8], Fail] = table.extend[u8](?out.store, b.data, b.len);
    if (sel r.err) { ret res[Held, Fail].err{r.err}; }
    ret res[Held, Fail].ok{Held.owned{Span{start: start, len: b.len}}};
}

# what `s`, the value `o`, the input `id`, holds on `x`, does to the axis,
# what lies in bytes kept owned by the settled record
fun merged(inputs: *Inputs, out: *Settled, id: Id[input.Input], o: *Object, x: *Axis, s: Setting) res[Outcome, Fail] {
    val gone: opt[*Dropped] = dropped(out, x);
    if (sel gone.some) { ret res[Outcome, Fail].ok{Outcome.passed{}}; }
    val held: opt[*Trait] = trait.find(?out.traits, x);
    if (sel held.none && out.objects != 0) {
        val base: opt[Setting] = trait.absent_value(x);
        if (sel base.some) { ret joined(inputs, id, x, base.some, s); }
    }
    if (trait.bytes_held(s)) {
        val next: Bytes = store.bytes(?o.store, held_of(s));
        if (sel held.none) {
            val copy: res[Held, Fail] = own(out, next);
            if (sel copy.err) { ret res[Outcome, Fail].err{copy.err}; }
            ret res[Outcome, Fail].ok{Outcome.kept{held_at(s, copy.ok)}};
        }
        ret merged_bytes(inputs, out, id, x, held.some, s, next);
    }
    if (sel held.none) { ret res[Outcome, Fail].ok{Outcome.kept{s}}; }
    ret joined(inputs, id, x, held.some.setting, s);
}

# what merging `s`, which the input `id` holds on `x`, into `held` does to
# the axis. an earlier input that left an axis unstated whose absence means a
# value held that value, which the settled record holds as nothing
fun joined(inputs: *Inputs, id: Id[input.Input], x: *Axis, held: Setting, s: Setting) res[Outcome, Fail] {
    val m: Joined[Setting] = trait.merge(x, held, s);
    if (sel m.refused) { ret res[Outcome, Fail].err{clash(inputs, id, x)}; }
    or (sel m.dropped) { ret dropped_by(inputs, id, x); }
    ret res[Outcome, Fail].ok{Outcome.kept{m.kept}};
}

# the bytes a text, a pair or a set holds
fun held_of(s: Setting) *Held {
    var h: *Held = nil;
    if (sel s.text) { h = ?s.text; }
    or (sel s.set)  { h = ?s.set; }
    or (sel s.pair) { h = ?s.pair.text; }
    ret h;
}

# `s`, a text, a pair or a set, with its bytes at `h`
fun held_at(s: Setting, h: Held) Setting {
    if (sel s.set)  { ret Setting.set{h}; }
    or (sel s.pair) { ret Setting.pair{trait.Paired{number: s.pair.number, text: h}}; }
    ret Setting.text{h};
}

# the merge of `s`, whose bytes are `next`, the input `id` holds on `x` into
# the value `held` the settled record holds. a pair is the same when its
# number and bytes are
fun merged_bytes(inputs: *Inputs, out: *Settled, id: Id[input.Input], x: *Axis, held: *Trait, s: Setting, next: Bytes) res[Outcome, Fail] {
    if (!trait.bytes_held(held.setting)) { ret res[Outcome, Fail].err{fail.about(fail.internal("an axis whose values lie in bytes holds one that does not"), x.name)}; }
    val was: Bytes             = settled_bytes(out, held_of(held.setting));
    var m:   res[Merged, Fail] = res[Merged, Fail].ok{Merged.refused{}};
    if (sel s.pair) {
        var same: bool = false;
        if (sel held.setting.pair) { same = held.setting.pair.number == s.pair.number && store.same_bytes(was, next); }
        if (same)                  { m = res[Merged, Fail].ok{Merged.held{}}; }
        or (sel x.merge.agreed)    { m = res[Merged, Fail].ok{Merged.dropped{}}; }
    }
    or                    { m = merge.merge_bytes(out.store.a, x.merge, was, next, ?out.store); }
    if (sel m.err)        { ret res[Outcome, Fail].err{fail.about(fail.in_file(m.err, input.at(inputs, id).name), x.name)}; }
    if (sel m.ok.refused) { ret res[Outcome, Fail].err{clash(inputs, id, x)}; }
    or (sel m.ok.dropped) { ret dropped_by(inputs, id, x); }
    or (sel m.ok.held)    { ret res[Outcome, Fail].ok{Outcome.kept{held.setting}}; }
    ret res[Outcome, Fail].ok{Outcome.kept{held_at(s, Held.owned{m.ok.written})}};
}

# the drop of `x` the input `id` makes by stating a value an earlier input
# does not
fun dropped_by(inputs: *Inputs, id: Id[input.Input], x: *Axis) res[Outcome, Fail] {
    val e: opt[Id[input.Input]] = earlier(inputs, id, x);
    if (sel e.none) { ret res[Outcome, Fail].err{fail.about(fail.internal("a trait axis is dropped that no earlier input states"), x.name)}; }
    ret res[Outcome, Fail].ok{Outcome.dropped{e.some}};
}

# the bytes `c` holds in a store whose owned bytes begin at `base`, none for
# a zero fill
fun contents_of(base: *u8, c: *Contents) Bytes {
    if (sel c.held) { ret store.at(base, ?c.held); }
    ret Bytes{data: nil, len: 0};
}

# how many bytes `c` holds
fun contents_len(base: *u8, c: *Contents) u64 {
    if (sel c.zero) { ret c.zero; }
    ret contents_of(base, c).len::u64;
}

# whether `c` holds only zero bytes
fun all_zero(base: *u8, c: *Contents) bool {
    val b: Bytes = contents_of(base, c);
    var i: usize = 0;
    for (i < b.len) {
        if (b.data[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the byte `i` of `c`
fun contents_at(base: *u8, c: *Contents, i: u64) u8 {
    if (sel c.zero) { ret 0; }
    ret contents_of(base, c).data[i::usize];
}

# whether two facts' data hold the same bytes
fun same_contents(a_base: *u8, a: *Contents, b_base: *u8, b: *Contents) bool {
    val n: u64 = contents_len(a_base, a);
    if (n != contents_len(b_base, b)) { ret false; }
    var i: u64 = 0;
    for (i < n) {
        if (contents_at(a_base, a, i) != contents_at(b_base, b, i)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the settled order of facts: by the name of their format, their key and their value
fun order_facts(a: *Fact, b: *Fact) i64 {
    val names: i64 = str_compare(a.format.name, b.format.name);
    if (names != 0)        { ret names; }
    if (a.key < b.key)     { ret -1; }
    if (a.key > b.key)     { ret 1; }
    if (a.value < b.value) { ret -1; }
    if (a.value > b.value) { ret 1; }
    ret 0;
}

# where the fact `f` is in `t`, which holds facts in the settled order: the
# fact of its identity `t` holds, if any, and where `f` goes
rec Located {
    held: opt[usize];
    at:   usize;
}

fun locate(t: *Table[Fact], f: *Fact, keyed: bool) Located {
    var probe: Fact = Fact{format: f.format, key: f.key, value: f.value};
    if (!keyed) { probe.value = 0; }
    val pos: SearchPosition = sort.binary_search_by[Fact](table.items[Fact](t), table.count[Fact](t), ?probe, order_facts);
    if (sel pos.found) { ret Located{held: opt[usize].some{pos.found}, at: pos.found}; }
    val at: usize = pos.insertion;
    if (!keyed && at < table.count[Fact](t)) {
        val next: *Fact = ?table.items[Fact](t)[at];
        if (next.format == f.format && next.key == f.key) { ret Located{held: opt[usize].some{at}, at: at}; }
    }
    ret Located{held: opt[usize].none{}, at: at};
}

# plan the fact `f` of `o`, the input `id`
fun planned_fact(in: *In, out: *Settled, id: Id[input.Input], o: *Object, f: *Fact, plan: *Plan) err[Fail] {
    val inputs: *Inputs    = in.inputs;
    val name:   str        = input.at(inputs, id).name;
    var row:    opt[*Rule] = opt[*Rule].none{};
    if (f.format == in.format) { row = merge.rule_of(in.facts, f.key); }
    if (sel row.none) {
        ret err[Fail].err{fail.valued(fail.about(fail.in_file(fail.unsupported("settle has no rule for this format fact"), name), f.format.name), f.key::i128)};
    }
    val r:    *Rule = row.some;
    val base: *u8   = store.base(?o.store);
    if (sel r.merge.local) { ret err[Fail].ok{}; }
    if (sel r.merge.refused) {
        ret err[Fail].err{fail.valued(fail.about(fail.in_file(fail.unsupported("the input states a fact a tool must not ignore and no rule knows"), name), f.format.name), f.value::i128)};
    }
    if (sel r.merge.dropped) {
        val g: res[Id[Ignored], Fail] = table.push[Ignored](?plan.ignored, Ignored{input: id, format: f.format, key: f.key, value: f.value});
        if (sel g.err) { ret err[Fail].err{g.err}; }
        ret err[Fail].ok{};
    }
    if (sel r.merge.drained) {
        if (all_zero(base, ?f.data)) { ret err[Fail].ok{}; }
        ret err[Fail].err{fail.valued(fail.about(fail.in_file(fail.unsupported("settling bits of a format fact no trait row maps is not supported"), name), f.format.name), f.value::i128)};
    }
    val at: Located = locate(?out.facts, f, r.keyed);
    if (sel at.held.some) {
        val h: *Fact = table.at[Fact](?out.facts, table.nth[Fact](at.held.some));
        if (!same_contents(table.items[u8](?out.store), ?h.data, base, ?f.data)) { ret err[Fail].err{fact_clash(inputs, id, f, r.keyed, nil)}; }
        if (r.keyed || h.value == f.value)                                       { ret err[Fail].ok{}; }
        if (sel r.merge.highest)                                                 { ret raised(inputs, id, f, r.merge.highest, at.held.some, h.value, plan); }
        ret err[Fail].err{fact_clash(inputs, id, f, r.keyed, nil)};
    }
    val twice: Located = locate(?plan.facts, f, r.keyed);
    if (sel twice.held.some) {
        ret err[Fail].err{fail.valued(fail.about(fail.in_file(fail.malformed("a format fact is stated twice"), name), f.format.name), f.key::i128)};
    }
    var copy: Fact = @f;
    if (sel f.data.held) {
        val b: res[Held, Fail] = own(out, store.at(base, ?f.data.held));
        if (sel b.err) { ret err[Fail].err{b.err}; }
        copy.data = Contents.held{b.ok};
    }
    ret table.insert[Fact](?plan.facts, twice.at, copy);
}

# the raise of the settled fact at `at`, which holds `held`, to the value of
# `f` the input `id` states, when the highest rule over `order` keeps it
fun raised(inputs: *Inputs, id: Id[input.Input], f: *Fact, order: *merge.Order, at: usize, held: u64, plan: *Plan) err[Fail] {
    val kept: opt[u64] = merge.highest(order, held, f.value);
    if (sel kept.none)     { ret err[Fail].err{fact_clash(inputs, id, f, false, order)}; }
    if (kept.some == held) { ret err[Fail].ok{}; }
    val p: res[Id[Raised], Fail] = table.push[Raised](?plan.raised, Raised{at: at, value: kept.some});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# commit the plan of `o`, the input `id`, refusing only before anything
# changes
fun applied(out: *Settled, id: Id[input.Input], o: *Object, plan: *Plan) err[Fail] {
    val a:       *Arch    = o.target.arch;
    val results: *Outcome = table.items[Outcome](?plan.outcomes);
    var added:   usize    = 0;
    var gone:    usize    = 0;
    var i:       usize    = 0;
    for (i < a.axis_count) {
        val held: opt[*Trait] = trait.find(?out.traits, a.axes[i]);
        if (sel results[i].dropped)               { gone = gone + 1; }
        or (sel results[i].kept && sel held.none) { added = added + 1; }
        i = i + 1;
    }
    val room: err[Fail] = table.reserve[Trait](?out.traits, added);
    if (sel room.err) { ret room; }
    val drops: err[Fail] = table.reserve[Dropped](?out.dropped, gone);
    if (sel drops.err) { ret drops; }
    val facts: err[Fail] = table.reserve[Fact](?out.facts, table.count[Fact](?plan.facts));
    if (sel facts.err) { ret facts; }
    val ignored: res[Id[Ignored], Fail] = table.extend[Ignored](?out.ignored, table.items[Ignored](?plan.ignored), table.count[Ignored](?plan.ignored));
    if (sel ignored.err) { ret err[Fail].err{ignored.err}; }
    i = 0;
    for (i < a.axis_count) {
        val r: err[Fail] = outcome_applied(out, id, a.axes[i], ?results[i]);
        i = i + 1;
        if (sel r.err) { ret r; }
    }
    i = 0;
    for (i < table.count[Raised](?plan.raised)) {
        val up: *Raised = table.at[Raised](?plan.raised, table.nth[Raised](i));
        table.at[Fact](?out.facts, table.nth[Fact](up.at)).value = up.value;
        i                                                        = i + 1;
    }
    i = 0;
    for (i < table.count[Fact](?plan.facts)) {
        val f:  *Fact     = table.at[Fact](?plan.facts, table.nth[Fact](i));
        val at: Located   = locate(?out.facts, f, true);
        val r:  err[Fail] = table.insert[Fact](?out.facts, at.at, @f);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    out.objects = out.objects + 1;
    ret err[Fail].ok{};
}

# what the outcome `s` of a trait on `x` of the input `id` does to the
# settled record, whose tables hold room for it
fun outcome_applied(out: *Settled, id: Id[input.Input], x: *Axis, s: *Outcome) err[Fail] {
    if (sel s.passed) { ret err[Fail].ok{}; }
    or (sel s.none)   { ret err[Fail].ok{}; }
    or (sel s.dropped) {
        val gone: err[Fail] = trait.remove(?out.traits, x);
        if (sel gone.err) { ret gone; }
        val at: SearchPosition = dropped_position(out, x);
        if (sel at.found) { ret err[Fail].err{fail.about(fail.internal("a trait axis is dropped twice"), x.name)}; }
        ret table.insert[Dropped](?out.dropped, at.insertion, Dropped{axis: x, held: s.dropped, next: id});
    }
    val held: opt[*Trait] = trait.find(?out.traits, x);
    if (trait.unstated(x, s.kept)) {
        if (sel held.some) { ret trait.remove(?out.traits, x); }
        ret err[Fail].ok{};
    }
    if (sel held.some) {
        held.some.setting = s.kept;
        ret err[Fail].ok{};
    }
    ret trait.add(?out.traits, Trait{axis: x, setting: s.kept});
}

# the first input before `id` that holds a value of `x`, none when no earlier
# input does
fun earlier(inputs: *Inputs, id: Id[input.Input], x: *Axis) opt[Id[input.Input]] {
    var k: usize = 0;
    for (k < id.index::usize) {
        val e: Id[input.Input] = table.nth[input.Input](k);
        val o: *Object         = input.object_of(inputs, e);
        if (o != nil && (sel o.library.none)) {
            val s: opt[Setting] = object.effective(o, x);
            if (sel s.some) { ret opt[Id[input.Input]].some{e}; }
        }
        k = k + 1;
    }
    ret opt[Id[input.Input]].none{};
}

# the refusal of input `id` stating on `x` what the earlier inputs' merged
# value cannot take, naming the first earlier input that states `x`
fun clash(inputs: *Inputs, id: Id[input.Input], x: *Axis) Fail {
    val f: Fail                 = fail.about(fail.in_file(fail.malformed("an input states a trait value an earlier input contradicts"), input.at(inputs, id).name), x.name);
    val e: opt[Id[input.Input]] = earlier(inputs, id, x);
    if (sel e.some) { ret fail.in_record(f, input.at(inputs, e.some).name); }
    ret f;
}

# the refusal of input `id` stating the fact `f` an earlier input states
# otherwise, naming the first earlier input that states a fact of its
# identity, past those at the bottom of `order` when the row ranks its values
fun fact_clash(inputs: *Inputs, id: Id[input.Input], f: *Fact, keyed: bool, order: *merge.Order) Fail {
    var shown: u64 = f.key::u64;
    if (keyed) { shown = f.value; }
    val e: Fail  = fail.valued(fail.about(fail.in_file(fail.malformed("an input states a format fact an earlier input contradicts"), input.at(inputs, id).name), f.format.name), shown::i128);
    var k: usize = 0;
    for (k < id.index::usize) {
        val other: Id[input.Input] = table.nth[input.Input](k);
        val o:     *Object         = input.object_of(inputs, other);
        k = k + 1;
        if (o == nil || !(sel o.library.none)) { cnt; }
        var j: usize = 0;
        for (j < table.count[Fact](?o.facts)) {
            val g: *Fact = table.at[Fact](?o.facts, table.nth[Fact](j));
            j = j + 1;
            val same: bool = g.format == f.format && g.key == f.key && (!keyed || g.value == f.value);
            if (same && (order == nil || !merge.bottom(order, g.value))) { ret fail.in_record(e, input.at(inputs, other).name); }
        }
    }
    ret e;
}

pub fun release(s: *Settled) err[Fail] {
    val rf: err[Fail] = table.release[Fact](?s.facts);
    val rs: err[Fail] = table.release[u8](?s.store);
    val rt: err[Fail] = table.release[Trait](?s.traits);
    val rd: err[Fail] = table.release[Dropped](?s.dropped);
    val ri: err[Fail] = table.release[Ignored](?s.ignored);
    val rc: err[Fail] = consume.release(?s.consumed);
    if (sel rf.err) { ret rf; }
    if (sel rs.err) { ret rs; }
    if (sel rt.err) { ret rt; }
    if (sel rd.err) { ret rd; }
    if (sel ri.err) { ret ri; }
    ret rc;
}

# a riscv64 object stating the float ABI `abi` and, when `rvc`, compressed code
fun riscv(a: *A.Allocator, abi: *trait.Choice, rvc: bool) res[Object, Fail] {
    var o: Object    = object.make(a, ?arch_riscv.RISCV64);
    var r: err[Fail] = object.state(?o, ?arch_riscv.RISCV_FLOAT_ABI, Setting.choice{abi});
    if (sel r.ok && rvc) { r = object.state(?o, ?arch_riscv.RISCV_RVC, Setting.flag{true}); }
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}

# a settle over the given objects `objects`, named `names`, the same count of each
fun settled(a: *A.Allocator, objects: *Object, names: *str, n: usize, out: *Settled) err[Fail] {
    var inputs: Inputs = input.make(a);
    var i:      usize  = 0;
    for (i < n) {
        val b: res[Id[input.Input], Fail] = input.borrow(?inputs, Given{name: names[i], object: ?objects[i]});
        if (sel b.err) {
            val dropped: err[Fail] = input.release(?inputs);
            ret err[Fail].err{b.err};
        }
        i = i + 1;
    }
    var in:  In        = In{inputs: ?inputs, arch: objects[0].target.arch, format: ?format.ELF, facts: ?elf_convention.FACTS, uses: ?TEST_USES};
    val r:   err[Fail] = run(?in, out);
    val rel: err[Fail] = input.release(?inputs);
    if (sel r.err) { ret r; }
    ret rel;
}

fun release_all(objects: *Object, n: usize) bool {
    var ok: bool  = true;
    var i:  usize = 0;
    for (i < n) {
        val r: err[Fail] = object.release(?objects[i]);
        if (sel r.err) { ok = false; }
        i = i + 1;
    }
    ret ok;
}

test settle__each_axis_merges_by_its_rule {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # compressed code in one input sets rvc for all, an input that states
    # nothing constrains nothing, and the float ABI every input states is kept
    val one: res[Object, Fail] = riscv(a, ?arch_riscv.RISCV_DOUBLE, true);
    if (sel one.err) { ret 1; }
    val two: res[Object, Fail] = riscv(a, ?arch_riscv.RISCV_DOUBLE, false);
    if (sel two.err) { ret 1; }
    var objects: [3]Object = [3]Object{one.ok, object.make(a, ?arch_riscv.RISCV64), two.ok};
    var names:   [3]str    = [3]str{"one.o", "bare.o", "two.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 3, ?s);
    if (sel r.err)                          { ret 1; }
    if (table.count[Trait](?s.traits) != 2) { ret 1; }
    val f: opt[*Trait] = trait.find(?s.traits, ?arch_riscv.RISCV_FLOAT_ABI);
    if (sel f.none)                                                            { ret 1; }
    if (!trait.same(f.some.setting, Setting.choice{?arch_riscv.RISCV_DOUBLE})) { ret 1; }
    val c: opt[*Trait] = trait.find(?s.traits, ?arch_riscv.RISCV_RVC);
    if (sel c.none)                                      { ret 1; }
    if (!trait.same(c.some.setting, Setting.flag{true})) { ret 1; }
    if (s.folded != 3)                                   { ret 1; }

    val rel: err[Fail] = release(?s);
    if (sel rel.err)                  { ret 1; }
    if (!release_all(?objects[0], 3)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}

test settle__an_input_for_another_architecture_is_refused_naming_both_inputs {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    var objects: [2]Object = [2]Object{object.make(a, ?arch_riscv.RISCV64), object.make(a, ?arch_riscv.RISCV64E)};
    var names:   [2]str    = [2]str{"full.o", "base.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 2, ?s);
    if (sel r.ok)                               { ret 1; }
    if (!sel r.err.cause.malformed)             { ret 1; }
    if (!str_equals(r.err.at.file, "base.o"))   { ret 1; }
    if (!str_equals(r.err.at.record, "full.o")) { ret 1; }
    if (!str_equals(r.err.subject, "riscv64e")) { ret 1; }
    if (s.folded != 1)                          { ret 1; }

    val rel: err[Fail] = release(?s);
    if (sel rel.err)                  { ret 1; }
    if (!release_all(?objects[0], 2)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}

test settle__different_float_abis_are_refused_naming_both_inputs_and_the_axis {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    val soft: res[Object, Fail] = riscv(a, ?arch_riscv.RISCV_SOFT, false);
    if (sel soft.err) { ret 1; }
    val double: res[Object, Fail] = riscv(a, ?arch_riscv.RISCV_DOUBLE, true);
    if (sel double.err) { ret 1; }
    var objects: [2]Object = [2]Object{soft.ok, double.ok};
    var names:   [2]str    = [2]str{"soft.o", "double.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 2, ?s);
    if (sel r.ok)                                      { ret 1; }
    if (!sel r.err.cause.malformed)                    { ret 1; }
    if (!str_equals(r.err.at.file, "double.o"))        { ret 1; }
    if (!str_equals(r.err.at.record, "soft.o"))        { ret 1; }
    if (!str_equals(r.err.subject, "riscv-float-abi")) { ret 1; }
    # the refused input merged nothing, its rvc included
    if (table.count[Trait](?s.traits) != 1) { ret 1; }
    if (s.folded != 1)                      { ret 1; }

    val rel: err[Fail] = release(?s);
    if (sel rel.err)                  { ret 1; }
    if (!release_all(?objects[0], 2)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}

# a riscv64 object stating the atomics ABI `abi`
fun riscv_atomic(a: *A.Allocator, abi: *trait.Choice) res[Object, Fail] {
    var o: Object    = object.make(a, ?arch_riscv.RISCV64);
    val r: err[Fail] = object.state(?o, ?arch_riscv.RISCV_ATOMIC_ABI, Setting.choice{abi});
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}

# the atomics ABI a settle over objects stating `abis` gives, none when refused
fun atomic_settled(a: *A.Allocator, abis: **trait.Choice, n: usize) res[opt[*trait.Choice], Fail] {
    var objects: [3]Object = [3]Object{object.make(a, ?arch_riscv.RISCV64), object.make(a, ?arch_riscv.RISCV64), object.make(a, ?arch_riscv.RISCV64)};
    var names:   [3]str    = [3]str{"a.o", "b.o", "c.o"};
    var i:       usize     = 0;
    for (i < n) {
        val o: res[Object, Fail] = riscv_atomic(a, abis[i]);
        if (sel o.err) { ret res[opt[*trait.Choice], Fail].err{o.err}; }
        val old: err[Fail] = object.release(?objects[i]);
        if (sel old.err) { ret res[opt[*trait.Choice], Fail].err{old.err}; }
        objects[i] = o.ok;
        i          = i + 1;
    }
    var s:   Settled            = make(a);
    val r:   err[Fail]          = settled(a, ?objects[0], ?names[0], n, ?s);
    var got: opt[*trait.Choice] = opt[*trait.Choice].none{};
    if (sel r.ok) {
        val x: opt[*Trait] = trait.find(?s.traits, ?arch_riscv.RISCV_ATOMIC_ABI);
        if (sel x.some) {
            if (sel x.some.setting.choice) { got = opt[*trait.Choice].some{x.some.setting.choice}; }
        }
    }
    val rel: err[Fail] = release(?s);
    if (!release_all(?objects[0], 3)) { ret res[opt[*trait.Choice], Fail].err{fail.internal("an object did not release")}; }
    if (sel rel.err)                  { ret res[opt[*trait.Choice], Fail].err{rel.err}; }
    ret res[opt[*trait.Choice], Fail].ok{got};
}

test settle__an_ordered_axis_merges_into_the_choice_containing_every_input {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # the psABI table: unknown and A6S merge into A6C in either order, and
    # A6S and A7 into A7
    val up:   [3]*trait.Choice              = [3]*trait.Choice{?arch_riscv.RISCV_ATOMIC_UNKNOWN, ?arch_riscv.RISCV_ATOMIC_A6S, ?arch_riscv.RISCV_ATOMIC_A6C};
    val down: [3]*trait.Choice              = [3]*trait.Choice{?arch_riscv.RISCV_ATOMIC_A6C, ?arch_riscv.RISCV_ATOMIC_A6S, ?arch_riscv.RISCV_ATOMIC_UNKNOWN};
    val a7:   [2]*trait.Choice              = [2]*trait.Choice{?arch_riscv.RISCV_ATOMIC_A6S, ?arch_riscv.RISCV_ATOMIC_A7};
    val r1:   res[opt[*trait.Choice], Fail] = atomic_settled(a, ?up[0], 3);
    val r2:   res[opt[*trait.Choice], Fail] = atomic_settled(a, ?down[0], 3);
    val r3:   res[opt[*trait.Choice], Fail] = atomic_settled(a, ?a7[0], 2);
    if (sel r1.err)                                                      { ret 1; }
    if (sel r2.err)                                                      { ret 1; }
    if (sel r3.err)                                                      { ret 1; }
    if (!(sel r1.ok.some && r1.ok.some == ?arch_riscv.RISCV_ATOMIC_A6C)) { ret 2; }
    if (!(sel r2.ok.some && r2.ok.some == ?arch_riscv.RISCV_ATOMIC_A6C)) { ret 3; }
    if (!(sel r3.ok.some && r3.ok.some == ?arch_riscv.RISCV_ATOMIC_A7))  { ret 4; }

    # A7 and A6C are refused, naming both inputs and the axis
    val a7o: res[Object, Fail] = riscv_atomic(a, ?arch_riscv.RISCV_ATOMIC_A7);
    if (sel a7o.err) { ret 1; }
    val a6c: res[Object, Fail] = riscv_atomic(a, ?arch_riscv.RISCV_ATOMIC_A6C);
    if (sel a6c.err) { ret 1; }
    var objects: [2]Object = [2]Object{a7o.ok, a6c.ok};
    var names:   [2]str    = [2]str{"a7.o", "a6c.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 2, ?s);
    if (sel r.ok)                                       { ret 5; }
    if (!str_equals(r.err.at.file, "a6c.o"))            { ret 5; }
    if (!str_equals(r.err.at.record, "a7.o"))           { ret 5; }
    if (!str_equals(r.err.subject, "riscv-atomic-abi")) { ret 5; }
    val rel: err[Fail] = release(?s);
    if (sel rel.err)                  { ret 1; }
    if (!release_all(?objects[0], 2)) { ret 1; }

    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

# a riscv64 object stating the ISA string `isa`
fun riscv_arch(a: *A.Allocator, isa: str) res[Object, Fail] {
    var o: Object    = object.make(a, ?arch_riscv.RISCV64);
    val r: err[Fail] = object.state(?o, ?arch_riscv.RISCV_ARCH, Setting.text{Held.borrowed{Bytes{data: isa::*u8, len: str_len(isa)}}});
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}

test settle__riscv_attributes_merge_their_architecture_strings {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # every extension either names, at the higher version, in canonical order
    val one: res[Object, Fail] = riscv_arch(a, "rv64i2p1_m2p0_a2p1_c2p0_zicsr2p0");
    if (sel one.err) { ret 1; }
    val two: res[Object, Fail] = riscv_arch(a, "rv64i2p0_m2p0_f2p2_d2p2_zifencei2p0_zicsr2p0");
    if (sel two.err) { ret 1; }
    var objects: [2]Object = [2]Object{one.ok, two.ok};
    var names:   [2]str    = [2]str{"one.o", "two.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 2, ?s);
    if (sel r.err) { ret 1; }
    val isa: opt[*Trait] = trait.find(?s.traits, ?arch_riscv.RISCV_ARCH);
    if (sel isa.none)               { ret 1; }
    if (!sel isa.some.setting.text) { ret 1; }
    val got:  Bytes = settled_bytes(?s, ?isa.some.setting.text);
    val want: str   = "rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0_zicsr2p0_zifencei2p0";
    if (!store.same_bytes(got, Bytes{data: want::*u8, len: str_len(want)})) { ret 1; }

    val rel: err[Fail] = release(?s);
    if (sel rel.err)                  { ret 1; }
    if (!release_all(?objects[0], 2)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}

# an x86_64 object whose GNU property ISA_1_NEEDED word is `needed`, as the
# ELF rows decode it, and without the property for none
fun x86_needing(a: *A.Allocator, needed: u32) res[Object, Fail] {
    var o:     Object    = object.make(a, ?x86.X86_64);
    var w:     Words     = traits.make_words(a, 0);
    var added: err[Fail] = err[Fail].ok{};
    if (needed != 0) { added = traits.add_word(?w, Word{type: tables.GNU_PROPERTY_X86_ISA_1_NEEDED.value::u32, value: needed}); }
    var rs: Table[Reading] = table.make[Reading](a);
    var r:  err[Fail]      = added;
    if (!(sel r.err)) { r = traits.decode(?x86.X86_64, ?w, ?rs); }
    if (!(sel r.err)) { r = contract.reconcile(?rs, nil, ?o.traits); }
    val rel: err[Fail] = traits.release_words(?w);
    val rr:  err[Fail] = table.release[Reading](?rs);
    if (sel r.err || sel rel.err || sel rr.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{fail.internal("the test object was not built")};
    }
    ret res[Object, Fail].ok{o};
}

test settle__x86_isa_levels_are_or_ed {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # baseline and v2 in one input and v3 in another need all three, and an
    # input without the property needs none
    val low: res[Object, Fail] = x86_needing(a, 0x3);
    if (sel low.err) { ret 1; }
    val bare: res[Object, Fail] = x86_needing(a, 0);
    if (sel bare.err) { ret 1; }
    val high: res[Object, Fail] = x86_needing(a, 0x4);
    if (sel high.err) { ret 1; }
    var objects: [3]Object = [3]Object{low.ok, bare.ok, high.ok};
    var names:   [3]str    = [3]str{"low.o", "bare.o", "high.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 3, ?s);
    if (sel r.err) { ret 1; }
    var w:  Words     = traits.make_words(a, 0);
    val en: err[Fail] = traits.encode(?x86.X86_64, ?s.traits, ?w);
    if (sel en.err) { ret 1; }
    val needed: opt[*Word] = traits.word(?w, tables.GNU_PROPERTY_X86_ISA_1_NEEDED.value::u32);
    if (sel needed.none)          { ret 1; }
    if (needed.some.value != 0x7) { ret 1; }

    val rw:  err[Fail] = traits.release_words(?w);
    val rel: err[Fail] = release(?s);
    if (sel rw.err)                   { ret 1; }
    if (sel rel.err)                  { ret 1; }
    if (!release_all(?objects[0], 3)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}

# an x86_64 object stating the ELF OSABI `osabi`
fun x86_osabi(a: *A.Allocator, osabi: u64) res[Object, Fail] {
    var o: Object                     = object.make(a, ?x86.X86_64);
    val f: res[Id[object.Fact], Fail] = object.add_fact(?o, Fact{format: ?format.ELF, key: elf_fact.OSABI, value: osabi, data: Contents.zero{0}});
    if (sel f.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{f.err};
    }
    ret res[Object, Fail].ok{o};
}

# copy the bytes, facts and traits of `s` into the empty object `o`, whose
# store then holds the settled bytes at the places they settled at
fun filled(o: *Object, s: *Settled) err[Fail] {
    val n: usize = table.count[u8](?s.store);
    if (n != 0) {
        val b: res[Held, Fail] = store.own(?o.store, table.items[u8](?s.store), n);
        if (sel b.err) { ret err[Fail].err{b.err}; }
    }
    val f: res[Id[Fact], Fail] = table.extend[Fact](?o.facts, table.items[Fact](?s.facts), table.count[Fact](?s.facts));
    if (sel f.err) { ret err[Fail].err{f.err}; }
    val t: res[Id[Trait], Fail] = table.extend[Trait](?o.traits, table.items[Trait](?s.traits), table.count[Trait](?s.traits));
    if (sel t.err) { ret err[Fail].err{t.err}; }
    ret err[Fail].ok{};
}

# the settled record `s` as an object for `target`, so compare reads it
fun as_object(a: *A.Allocator, s: *Settled, target: *arch.Arch) res[Object, Fail] {
    var o: Object    = object.make(a, target);
    val r: err[Fail] = filled(?o, s);
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}

# whether two settles of the same inputs for `target` give the same record:
# both refused alike, or the same facts, traits and dropped axes, which
# compare reads
fun alike(a: *A.Allocator, target: *arch.Arch, x: err[Fail], s: *Settled, y: err[Fail], u: *Settled) bool {
    if (sel x.err) {
        if (sel y.err) { ret x.err.text == y.err.text; }
        ret false;
    }
    if (sel y.err)                                                            { ret false; }
    if (table.count[Dropped](?s.dropped) != table.count[Dropped](?u.dropped)) { ret false; }
    var i: usize = 0;
    for (i < table.count[Dropped](?s.dropped)) {
        if (table.items[Dropped](?s.dropped)[i].axis != table.items[Dropped](?u.dropped)[i].axis) { ret false; }
        i = i + 1;
    }
    val p: res[Object, Fail] = as_object(a, s, target);
    if (sel p.err) { ret false; }
    var po: Object            = p.ok;
    val q:  res[Object, Fail] = as_object(a, u, target);
    var d:  res[str, Fail]    = res[str, Fail].ok{"unbuilt"};
    if (sel q.ok) {
        var qo: Object = q.ok;
        d = compare.difference(a, ?po, ?qo);
        val rq: err[Fail] = object.release(?qo);
        if (sel rq.err) { d = res[str, Fail].ok{"unreleased"}; }
    }
    val rp: err[Fail] = object.release(?po);
    if (sel rp.err) { ret false; }
    if (sel d.err)  { ret false; }
    ret d.ok == nil;
}

# settle `objects`, named `names`, two of each, in their order into `s` and
# in the other into `u`, and say whether the two are alike
fun both_orders(a: *A.Allocator, target: *arch.Arch, objects: *Object, names: *str, s: *Settled, u: *Settled) bool {
    var back:  [2]Object = [2]Object{objects[1], objects[0]};
    var named: [2]str    = [2]str{names[1], names[0]};
    val x:     err[Fail] = settled(a, objects, names, 2, s);
    val y:     err[Fail] = settled(a, ?back[0], ?named[0], 2, u);
    ret alike(a, target, x, s, y, u);
}

# whether an object stating the OSABI `low` and one stating `high` settle
# to `high` in either order
fun osabi_raised(a: *A.Allocator, low: u64, high: u64) bool {
    val p:  res[Object, Fail] = x86_osabi(a, low);
    val q:  res[Object, Fail] = x86_osabi(a, high);
    var ok: bool              = false;
    if (sel p.ok) {
        if (sel q.ok) {
            var objects: [2]Object = [2]Object{p.ok, q.ok};
            var names:   [2]str    = [2]str{"low.o", "high.o"};
            var s:       Settled   = make(a);
            var u:       Settled   = make(a);
            ok = both_orders(a, ?x86.X86_64, ?objects[0], ?names[0], ?s, ?u) && table.count[Fact](?s.facts) == 1;
            if (ok) {
                val f: *Fact = table.at[Fact](?s.facts, table.nth[Fact](0));
                ok = f.key == elf_fact.OSABI && f.value == high;
            }
            val rs: err[Fail] = release(?s);
            val ru: err[Fail] = release(?u);
            ok = ok && (sel rs.ok) && (sel ru.ok) && release_all(?objects[0], 2);
        }
    }
    ret ok;
}

test settle__osabi_settles_to_the_highest_above_its_bottom_in_either_order {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # NONE is the bottom, so it gives way to GNU above it and to FREEBSD
    # outside the order alike
    if (!osabi_raised(a, tables.ELFOSABI_NONE.value, tables.ELFOSABI_GNU.value))     { ret 1; }
    if (!osabi_raised(a, tables.ELFOSABI_NONE.value, tables.ELFOSABI_FREEBSD.value)) { ret 1; }

    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test settle__an_osabi_outside_the_order_that_differs_is_refused_naming_both_inputs {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # the input at the bottom contradicts neither, so the refusal names the other
    val none: res[Object, Fail] = x86_osabi(a, tables.ELFOSABI_NONE.value);
    if (sel none.err) { ret 1; }
    val gnu: res[Object, Fail] = x86_osabi(a, tables.ELFOSABI_GNU.value);
    if (sel gnu.err) { ret 1; }
    val freebsd: res[Object, Fail] = x86_osabi(a, tables.ELFOSABI_FREEBSD.value);
    if (sel freebsd.err) { ret 1; }
    var objects: [3]Object = [3]Object{none.ok, gnu.ok, freebsd.ok};
    var names:   [3]str    = [3]str{"none.o", "gnu.o", "freebsd.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 3, ?s);
    if (sel r.ok)                                { ret 1; }
    if (!sel r.err.cause.malformed)              { ret 1; }
    if (!str_equals(r.err.at.file, "freebsd.o")) { ret 1; }
    if (!str_equals(r.err.at.record, "gnu.o"))   { ret 1; }

    val rs: err[Fail] = release(?s);
    if (sel rs.err)                   { ret 1; }
    if (!release_all(?objects[0], 3)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}

# a riscv64 object stating the privileged specification version `major`
fun riscv_priv(a: *A.Allocator, major: u64) res[Object, Fail] {
    var o: Object    = object.make(a, ?arch_riscv.RISCV64);
    val r: err[Fail] = object.state(?o, ?arch_riscv.RISCV_PRIV_SPEC, Setting.number{major});
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}

test settle__a_priv_spec_disagreement_is_dropped_and_reported {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # the drop stands when a later input agrees with either value
    val one: res[Object, Fail] = riscv_priv(a, 1);
    if (sel one.err) { ret 1; }
    val two: res[Object, Fail] = riscv_priv(a, 2);
    if (sel two.err) { ret 1; }
    val again: res[Object, Fail] = riscv_priv(a, 1);
    if (sel again.err) { ret 1; }
    var objects: [3]Object = [3]Object{one.ok, two.ok, again.ok};
    var names:   [3]str    = [3]str{"one.o", "two.o", "again.o"};
    var inputs:  Inputs    = input.make(a);
    var i:       usize     = 0;
    for (i < 3) {
        val b: res[Id[input.Input], Fail] = input.borrow(?inputs, Given{name: names[i], object: ?objects[i]});
        if (sel b.err) { ret 1; }
        i = i + 1;
    }
    var s:  Settled   = make(a);
    var in: In        = In{inputs: ?inputs, arch: objects[0].target.arch, format: ?format.ELF, facts: ?elf_convention.FACTS, uses: ?TEST_USES};
    val r:  err[Fail] = run(?in, ?s);
    if (sel r.err)                          { ret 1; }
    if (table.count[Trait](?s.traits) != 0) { ret 1; }
    val d: opt[*Dropped] = dropped(?s, ?arch_riscv.RISCV_PRIV_SPEC);
    if (sel d.none)                                       { ret 1; }
    if (d.some.held.index != 0 || d.some.next.index != 1) { ret 1; }
    if (table.count[Dropped](?s.dropped) != 1)            { ret 1; }

    var out:  Sink      = sink.make(a, reader.LITTLE);
    val w:    err[Fail] = report(?s, ?inputs, ?out);
    val want: str       = "mink: two.o: one.o: riscv-priv-spec: the inputs state different values of a trait its rule drops, so the link drops it\n";
    if (sel w.err)                                                                                                        { ret 1; }
    if (!store.same_bytes(Bytes{data: sink.data(?out), len: sink.len(?out)}, Bytes{data: want::*u8, len: str_len(want)})) { ret 1; }

    val ro:  err[Fail] = sink.release(?out);
    val rel: err[Fail] = release(?s);
    val ri:  err[Fail] = input.release(?inputs);
    if (sel ro.err)                   { ret 1; }
    if (sel rel.err || sel ri.err)    { ret 1; }
    if (!release_all(?objects[0], 3)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}

# the sections that are not image content a test link takes, as ELF does
val TEST_USE_ROWS: [3]*consume.Row = [3]*consume.Row{?consume.SIGNIFICANCE, ?consume.STRINGS, ?consume.STACK};
val TEST_USES:     consume.Uses    = consume.Uses{rows: ?TEST_USE_ROWS[0], count: 3};

# write into `out` an ISA string of the grammar `g`: its base, a width, its
# first base extension and that extension's version `minor`
fun isa_string(g: *isa.Grammar, target: *arch.Arch, minor: u8, out: *Table[u8]) bool {
    val base: opt[*isa.Base] = isa.base_for(g, target.name);
    if (sel base.none) { ret false; }
    val head: Bytes             = Bytes{data: base.some.spelling::*u8, len: str_len(base.some.spelling)};
    var tail: [3]u8             = [3]u8{'2', 'p', '0' + minor};
    val b:    res[Id[u8], Fail] = table.extend[u8](out, head.data, head.len);
    val c:    res[Id[u8], Fail] = table.extend[u8](out, ?tail[0], 3);
    ret (sel b.ok) && (sel c.ok);
}

# an object for `target` stating the `which`th of two different values of
# `x`, a text value written into `text` first
fun stating(a: *A.Allocator, target: *arch.Arch, x: *Axis, which: u8, text: *Table[u8]) res[Object, Fail] {
    var s: Setting = Setting.number{1 + which::u64};
    if (sel x.value.flag)   { s = Setting.flag{which == 1}; }
    or (sel x.value.choice) { s = Setting.choice{x.choices[which::usize]}; }
    or (sel x.value.text) {
        var made: bool = false;
        if (sel x.merge.extensions) { made = isa_string(x.merge.extensions, target, which, text); }
        or {
            var word: [2]u8             = [2]u8{'a', 'a' + which};
            val w:    res[Id[u8], Fail] = table.extend[u8](text, ?word[0], 2);
            made = sel w.ok;
        }
        if (!made) { ret res[Object, Fail].err{fail.internal("the test text was not written")}; }
        s = Setting.text{Held.borrowed{Bytes{data: table.items[u8](text), len: table.count[u8](text)}}};
    }
    var o: Object    = object.make(a, target);
    val r: err[Fail] = object.state(?o, x, s);
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}

# whether two inputs stating different values of `x` settle alike in either
# order
fun order_free(a: *A.Allocator, target: *arch.Arch, x: *Axis) bool {
    var first:  Table[u8]         = table.make[u8](a);
    var second: Table[u8]         = table.make[u8](a);
    val p:      res[Object, Fail] = stating(a, target, x, 0, ?first);
    val q:      res[Object, Fail] = stating(a, target, x, 1, ?second);
    var ok:     bool              = false;
    if (sel p.ok) {
        if (sel q.ok) {
            var objects: [2]Object = [2]Object{p.ok, q.ok};
            var names:   [2]str    = [2]str{"p.o", "q.o"};
            var s:       Settled   = make(a);
            var u:       Settled   = make(a);
            ok = both_orders(a, target, ?objects[0], ?names[0], ?s, ?u);
            val rs: err[Fail] = release(?s);
            val ru: err[Fail] = release(?u);
            ok = ok && (sel rs.ok) && (sel ru.ok) && release_all(?objects[0], 2);
        }
    }
    val rf: err[Fail] = table.release[u8](?first);
    val rg: err[Fail] = table.release[u8](?second);
    ret ok && (sel rf.ok) && (sel rg.ok);
}

test settle__every_built_in_axis_settles_alike_in_either_order {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    var i: usize = 0;
    for (i < list.count()) {
        val target: *arch.Arch = list.at(i);
        var j:      usize      = 0;
        for (j < target.axis_count) {
            val x: *Axis = target.axes[j];
            j = j + 1;
            # an axis the row fixes holds one value, which merges nothing
            if (sel x.owner.fixed)         { cnt; }
            if (!order_free(a, target, x)) { ret 1; }
        }
        i = i + 1;
    }

    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test settle__an_input_leaving_an_axis_unstated_holds_what_its_absence_means {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # shadow stacks are kept only when every input has them, and an input
    # that leaves them unstated has them clear, in either order
    var k: usize = 0;
    for (k < 2) {
        var full: Object    = object.make(a, ?arch_riscv.RISCV64);
        val st:   err[Fail] = object.state(?full, ?arch_riscv.RISCV_CFI_SS, Setting.flag{true});
        if (sel st.err) { ret 1; }
        var objects: [2]Object = [2]Object{full, object.make(a, ?arch_riscv.RISCV64)};
        if (k == 1) { objects = [2]Object{objects[1], objects[0]}; }
        var names: [2]str    = [2]str{"a.o", "b.o"};
        var s:     Settled   = make(a);
        val r:     err[Fail] = settled(a, ?objects[0], ?names[0], 2, ?s);
        if (sel r.err)                          { ret 2; }
        if (table.count[Trait](?s.traits) != 0) { ret 3; }
        val rel: err[Fail] = release(?s);
        if (sel rel.err)                  { ret 1; }
        if (!release_all(?objects[0], 2)) { ret 1; }
        k = k + 1;
    }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

# a riscv64 object stating a build attribute no row knows, of tag `tag` and
# the number `value`, under the fact key `key`
fun unknown_attribute(a: *A.Allocator, key: u32, tag: u64, value: u8) res[Object, Fail] {
    var o:     Object              = object.make(a, ?arch_riscv.RISCV64);
    var data:  [1]u8               = [1]u8{value};
    val owned: res[Contents, Fail] = object.own(?o, ?data[0], 1);
    var r:     err[Fail]           = err[Fail].ok{};
    if (sel owned.err) { r = err[Fail].err{owned.err}; }
    if (sel owned.ok) {
        val f: res[Id[object.Fact], Fail] = object.add_fact(?o, Fact{format: ?format.ELF, key: key, value: tag, data: owned.ok});
        if (sel f.err) { r = err[Fail].err{f.err}; }
    }
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}

test settle__an_unknown_attribute_a_tool_must_not_ignore_is_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    val one: res[Object, Fail] = unknown_attribute(a, elf_fact.ATTRIBUTE, 2, 1);
    if (sel one.err) { ret 1; }
    var objects: [1]Object = [1]Object{one.ok};
    var names:   [1]str    = [1]str{"one.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 1, ?s);
    if (sel r.ok)                            { ret 2; }
    if (!sel r.err.cause.unsupported)        { ret 3; }
    if (!str_equals(r.err.at.file, "one.o")) { ret 4; }
    if (sel r.err.value.none)                { ret 5; }
    if (r.err.value.some != 2)               { ret 5; }
    if (table.count[Fact](?s.facts) != 0)    { ret 6; }

    val rel: err[Fail] = release(?s);
    if (sel rel.err)                  { ret 1; }
    if (!release_all(?objects[0], 1)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}

test settle__an_unknown_attribute_a_tool_may_ignore_is_dropped_and_reported {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # the inputs disagree on its value, which no rule merges, and the link
    # carries neither
    val one: res[Object, Fail] = unknown_attribute(a, elf_fact.IGNORABLE, 70, 1);
    if (sel one.err) { ret 1; }
    val two: res[Object, Fail] = unknown_attribute(a, elf_fact.IGNORABLE, 70, 2);
    if (sel two.err) { ret 1; }
    var objects: [2]Object = [2]Object{one.ok, two.ok};
    var names:   [2]str    = [2]str{"one.o", "two.o"};
    var inputs:  Inputs    = input.make(a);
    var i:       usize     = 0;
    for (i < 2) {
        val b: res[Id[input.Input], Fail] = input.borrow(?inputs, Given{name: names[i], object: ?objects[i]});
        if (sel b.err) { ret 1; }
        i = i + 1;
    }
    var s:  Settled   = make(a);
    var in: In        = In{inputs: ?inputs, arch: objects[0].target.arch, format: ?format.ELF, facts: ?elf_convention.FACTS, uses: ?TEST_USES};
    val r:  err[Fail] = run(?in, ?s);
    if (sel r.err)                             { ret 2; }
    if (table.count[Fact](?s.facts) != 0)      { ret 3; }
    if (table.count[Ignored](?s.ignored) != 2) { ret 4; }

    var out:  Sink      = sink.make(a, reader.LITTLE);
    val w:    err[Fail] = report(?s, ?inputs, ?out);
    val want: str       = "mink: one.o: format fact 11: elf, value 70: the input states a fact a tool may ignore and no rule knows, so the link drops it\nmink: two.o: format fact 11: elf, value 70: the input states a fact a tool may ignore and no rule knows, so the link drops it\n";
    if (sel w.err)                                                                                                        { ret 5; }
    if (!store.same_bytes(Bytes{data: sink.data(?out), len: sink.len(?out)}, Bytes{data: want::*u8, len: str_len(want)})) { ret 6; }

    val ro:  err[Fail] = sink.release(?out);
    val rel: err[Fail] = release(?s);
    val ri:  err[Fail] = input.release(?inputs);
    if (sel ro.err)                   { ret 1; }
    if (sel rel.err || sel ri.err)    { ret 1; }
    if (!release_all(?objects[0], 2)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}
