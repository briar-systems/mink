# the settle phase: the inputs' machine flags and attributes become the one
# set the output carries, and inputs that cannot combine are refused
#
# each trait axis merges by its catalog rule across every object input that
# states it. an input that leaves an axis unstated places no constraint on
# it. each format fact combines by its format's row of the convention table,
# and a fact that describes one section or symbol travels with its input. a
# shared library is not merged, since it is linked against rather than into
# the image. the sections an input holds that are not image content are taken
# through the link's row for their use, all of an input with its traits and
# facts or none. settling folds the inputs it has not seen yet, so the link
# settles again after a phase appends inputs, as resolve does with archive
# members.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mink.catalog.arch;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Merged;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.elf.tables;
use mink.elf.traits;
use mink.elf.traits.Reading;
use mink.elf.traits.Word;
use mink.elf.traits.Words;
use mink.fail;
use mink.fail.Fail;
use mink.link.consume;
use mink.link.consume.Consumed;
use mink.link.convention;
use mink.link.convention.Convention;
use mink.link.fact;
use mink.link.fact.Rule;
use mink.link.input;
use mink.link.input.Given;
use mink.link.input.Inputs;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Fact;
use mink.model.object.Object;
use mink.store;
use mink.store.Bytes;
use mink.store.Held;
use mink.store.Span;
use mink.table;
use mink.table.Id;
use mink.table.Table;

pub rec In {
    inputs: *Inputs;
}

# facts:    the settled facts, keyed by format as an object's are, in the order
#           of their format's name, their key and their value
# store:    the bytes those facts and the traits' texts own
# traits:   the merged value of each trait axis some input states
# consumed: what the sections that are not image content state
# folded:   how many inputs, in input order, the traits merge
pub rec Settled {
    facts:    Table[Fact];
    store:    Table[u8];
    traits:   Table[Trait];
    consumed: Consumed;
    folded:   usize;
}

pub fun make(a: *A.Allocator) Settled {
    ret Settled{facts: table.make[Fact](a), store: table.make[u8](a), traits: table.make[Trait](a), consumed: consume.make(a)};
}

# merge every input not merged yet, in input order. an input that cannot be
# merged is refused, naming it, the earlier input it clashes with and the
# axis or fact, and leaves the settled record as it was
pub fun run(in: *In, out: *Settled) err[Fail] {
    for (out.folded < input.count(in.inputs)) {
        val id: Id[input.Input] = table.nth[input.Input](out.folded);
        val o:  *Object         = input.object_of(in.inputs, id);
        if (o != nil && (sel o.library.none)) {
            val r: err[Fail] = fold(in.inputs, out, id, o);
            if (sel r.err) { ret r; }
        }
        out.folded = out.folded + 1;
    }
    ret err[Fail].ok{};
}

# what folding one input changes
# ---
# settings: the value each of its traits leaves on its axis, in the order of
#           its traits
# facts:    the facts it adds, in the settled order
rec Plan {
    settings: Table[Setting];
    facts:    Table[Fact];
}

# merge the traits and facts of `o`, the input `id`, and take its sections
# that are not image content, all or none
fun fold(inputs: *Inputs, out: *Settled, id: Id[input.Input], o: *Object) err[Fail] {
    val a:    *A.Allocator = out.traits.a;
    val mark: usize        = table.count[u8](?out.store);
    var plan: Plan         = Plan{settings: table.make[Setting](a), facts: table.make[Fact](a)};
    val p:    err[Fail]    = planned(inputs, out, id, o, ?plan);
    var r:    err[Fail]    = p;
    if (sel p.ok)  { r = taken(inputs, out, id, o, ?plan); }
    if (sel r.err) { table.truncate[u8](?out.store, mark); }
    val rs: err[Fail] = table.release[Setting](?plan.settings);
    val rf: err[Fail] = table.release[Fact](?plan.facts);
    if (sel r.err)  { ret r; }
    if (sel rs.err) { ret rs; }
    ret rf;
}

# take the sections of `o`, the input `id`, that are not image content, then
# commit its plan, undoing what was taken when the commit is refused
fun taken(inputs: *Inputs, out: *Settled, id: Id[input.Input], o: *Object, plan: *Plan) err[Fail] {
    val held: consume.Mark = consume.mark(?out.consumed);
    val took: err[Fail]    = consume.take(?out.consumed, o);
    if (sel took.err) { ret err[Fail].err{fail.in_file(took.err, input.at(inputs, id).name)}; }
    val r: err[Fail] = applied(out, o, plan);
    if (sel r.ok) { ret r; }
    val undone: err[Fail] = consume.restore(?out.consumed, held);
    if (sel undone.err) { ret undone; }
    ret r;
}

fun planned(inputs: *Inputs, out: *Settled, id: Id[input.Input], o: *Object, plan: *Plan) err[Fail] {
    val n:    usize     = table.count[Trait](?o.traits);
    val room: err[Fail] = table.reserve[Setting](?plan.settings, n);
    if (sel room.err) { ret room; }
    var i: usize = 0;
    for (i < n) {
        val t: *Trait             = table.at[Trait](?o.traits, table.nth[Trait](i));
        val s: res[Setting, Fail] = merged(inputs, out, id, o, t);
        if (sel s.err) { ret err[Fail].err{s.err}; }
        val p: res[Id[Setting], Fail] = table.push[Setting](?plan.settings, s.ok);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Fact](?o.facts)) {
        val r: err[Fail] = planned_fact(inputs, out, id, o, table.at[Fact](?o.facts, table.nth[Fact](i)), plan);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bytes of `h` as the settled record holds them
fun settled_bytes(out: *Settled, h: *Held) Bytes {
    ret store.at(table.items[u8](?out.store), h);
}

# a copy of the bytes `b` the settled record owns
fun own(out: *Settled, b: Bytes) res[Held, Fail] {
    val start: usize             = table.count[u8](?out.store);
    val r:     res[Id[u8], Fail] = table.extend[u8](?out.store, b.data, b.len);
    if (sel r.err) { ret res[Held, Fail].err{r.err}; }
    ret res[Held, Fail].ok{Held.owned{Span{start: start, len: b.len}}};
}

# the value the trait `t` of `o`, the input `id`, leaves on its axis, a text
# owned by the settled record
fun merged(inputs: *Inputs, out: *Settled, id: Id[input.Input], o: *Object, t: *Trait) res[Setting, Fail] {
    val held: opt[*Trait] = trait.find(?out.traits, t.axis);
    if (sel t.setting.text) {
        val next: Bytes = store.bytes(?o.store, ?t.setting.text);
        if (sel held.none) {
            val copy: res[Held, Fail] = own(out, next);
            if (sel copy.err) { ret res[Setting, Fail].err{copy.err}; }
            ret res[Setting, Fail].ok{Setting.text{copy.ok}};
        }
        ret merged_text(inputs, out, id, t, held.some, next);
    }
    if (sel held.none) { ret res[Setting, Fail].ok{t.setting}; }
    val m: opt[Setting] = trait.merge(t.axis, held.some.setting, t.setting);
    if (sel m.none) { ret res[Setting, Fail].err{clash(inputs, id, t.axis)}; }
    ret res[Setting, Fail].ok{m.some};
}

# the merge of the text `next` the trait `t` of the input `id` states into
# the text `held` states
fun merged_text(inputs: *Inputs, out: *Settled, id: Id[input.Input], t: *Trait, held: *Trait, next: Bytes) res[Setting, Fail] {
    if (!(sel held.setting.text)) { ret res[Setting, Fail].err{fail.about(fail.internal("a text axis holds a value that is not text"), t.axis.name)}; }
    val was: Bytes             = settled_bytes(out, ?held.setting.text);
    val m:   res[Merged, Fail] = trait.merge_text(out.store.a, t.axis, was, next, ?out.store);
    if (sel m.err)        { ret res[Setting, Fail].err{fail.about(fail.in_file(m.err, input.at(inputs, id).name), t.axis.name)}; }
    if (sel m.ok.refused) { ret res[Setting, Fail].err{clash(inputs, id, t.axis)}; }
    or (sel m.ok.held)    { ret res[Setting, Fail].ok{held.setting}; }
    ret res[Setting, Fail].ok{Setting.text{Held.owned{m.ok.written}}};
}

# the bytes `c` holds in a store whose owned bytes begin at `base`, none for
# a zero fill
fun contents_of(base: *u8, c: *Contents) Bytes {
    if (sel c.held) { ret store.at(base, ?c.held); }
    ret Bytes{data: nil, len: 0};
}

# how many bytes `c` holds
fun contents_len(base: *u8, c: *Contents) u64 {
    if (sel c.zero) { ret c.zero; }
    ret contents_of(base, c).len::u64;
}

# whether `c` holds only zero bytes
fun all_zero(base: *u8, c: *Contents) bool {
    val b: Bytes = contents_of(base, c);
    var i: usize = 0;
    for (i < b.len) {
        if (b.data[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the byte `i` of `c`
fun contents_at(base: *u8, c: *Contents, i: u64) u8 {
    if (sel c.zero) { ret 0; }
    ret contents_of(base, c).data[i::usize];
}

# whether two facts' data hold the same bytes
fun same_contents(a_base: *u8, a: *Contents, b_base: *u8, b: *Contents) bool {
    val n: u64 = contents_len(a_base, a);
    if (n != contents_len(b_base, b)) { ret false; }
    var i: u64 = 0;
    for (i < n) {
        if (contents_at(a_base, a, i) != contents_at(b_base, b, i)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the settled order of facts: by the name of their format, their key and their value
fun order_facts(a: *Fact, b: *Fact) i64 {
    val names: i64 = str_compare(a.format.name, b.format.name);
    if (names != 0)        { ret names; }
    if (a.key < b.key)     { ret -1; }
    if (a.key > b.key)     { ret 1; }
    if (a.value < b.value) { ret -1; }
    if (a.value > b.value) { ret 1; }
    ret 0;
}

# where the fact `f` is in `t`, which holds facts in the settled order: the
# fact of its identity `t` holds, if any, and where `f` goes
rec Located {
    held: opt[usize];
    at:   usize;
}

fun locate(t: *Table[Fact], f: *Fact, keyed: bool) Located {
    var probe: Fact = Fact{format: f.format, key: f.key, value: f.value};
    if (!keyed) { probe.value = 0; }
    val pos: SearchPosition = sort.binary_search_by[Fact](table.items[Fact](t), table.count[Fact](t), ?probe, order_facts);
    if (sel pos.found) { ret Located{held: opt[usize].some{pos.found}, at: pos.found}; }
    val at: usize = pos.insertion;
    if (!keyed && at < table.count[Fact](t)) {
        val next: *Fact = ?table.items[Fact](t)[at];
        if (next.format == f.format && next.key == f.key) { ret Located{held: opt[usize].some{at}, at: at}; }
    }
    ret Located{held: opt[usize].none{}, at: at};
}

# plan the fact `f` of `o`, the input `id`
fun planned_fact(inputs: *Inputs, out: *Settled, id: Id[input.Input], o: *Object, f: *Fact, plan: *Plan) err[Fail] {
    val name: str                    = input.at(inputs, id).name;
    val conv: res[*Convention, Fail] = convention.of(f.format);
    if (sel conv.err) { ret err[Fail].err{fail.in_file(conv.err, name)}; }
    val row: opt[*Rule] = fact.rule_of(conv.ok.facts, f.key);
    if (sel row.none) {
        ret err[Fail].err{fail.valued(fail.about(fail.in_file(fail.unsupported("settle has no rule for this format fact"), name), f.format.name), f.key::i128)};
    }
    val r:    *Rule = row.some;
    val base: *u8   = store.base(?o.store);
    if (sel r.combine.local) { ret err[Fail].ok{}; }
    if (sel r.combine.drained) {
        if (all_zero(base, ?f.data)) { ret err[Fail].ok{}; }
        ret err[Fail].err{fail.valued(fail.about(fail.in_file(fail.unsupported("settling bits of a format fact no trait row maps is not supported"), name), f.format.name), f.value::i128)};
    }
    val at: Located = locate(?out.facts, f, r.keyed);
    if (sel at.held.some) {
        if (sel r.combine.first) { ret err[Fail].ok{}; }
        val h: *Fact = table.at[Fact](?out.facts, table.nth[Fact](at.held.some));
        if ((r.keyed || h.value == f.value) && same_contents(table.items[u8](?out.store), ?h.data, base, ?f.data)) { ret err[Fail].ok{}; }
        ret err[Fail].err{fact_clash(inputs, id, f, r.keyed)};
    }
    val twice: Located = locate(?plan.facts, f, r.keyed);
    if (sel twice.held.some) {
        ret err[Fail].err{fail.valued(fail.about(fail.in_file(fail.malformed("a format fact is stated twice"), name), f.format.name), f.key::i128)};
    }
    var copy: Fact = @f;
    if (sel f.data.held) {
        val b: res[Held, Fail] = own(out, store.at(base, ?f.data.held));
        if (sel b.err) { ret err[Fail].err{b.err}; }
        copy.data = Contents.held{b.ok};
    }
    ret table.insert[Fact](?plan.facts, twice.at, copy);
}

# commit the plan of `o`, refusing only before anything changes
fun applied(out: *Settled, o: *Object, plan: *Plan) err[Fail] {
    val n:     usize = table.count[Trait](?o.traits);
    var added: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        val held: opt[*Trait] = trait.find(?out.traits, table.at[Trait](?o.traits, table.nth[Trait](i)).axis);
        if (sel held.none) { added = added + 1; }
        i = i + 1;
    }
    val room: err[Fail] = table.reserve[Trait](?out.traits, added);
    if (sel room.err) { ret room; }
    val facts: err[Fail] = table.reserve[Fact](?out.facts, table.count[Fact](?plan.facts));
    if (sel facts.err) { ret facts; }
    i = 0;
    for (i < n) {
        val t:    *Trait      = table.at[Trait](?o.traits, table.nth[Trait](i));
        val s:    Setting     = table.items[Setting](?plan.settings)[i];
        val held: opt[*Trait] = trait.find(?out.traits, t.axis);
        i = i + 1;
        if (sel held.some) {
            held.some.setting = s;
            cnt;
        }
        val r: err[Fail] = trait.add(?out.traits, Trait{axis: t.axis, setting: s});
        if (sel r.err) { ret r; }
    }
    i = 0;
    for (i < table.count[Fact](?plan.facts)) {
        val f:  *Fact     = table.at[Fact](?plan.facts, table.nth[Fact](i));
        val at: Located   = locate(?out.facts, f, true);
        val r:  err[Fail] = table.insert[Fact](?out.facts, at.at, @f);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the refusal of input `id` stating on `x` what the earlier inputs' merged
# value cannot take, naming the first earlier input that states `x`
fun clash(inputs: *Inputs, id: Id[input.Input], x: *Axis) Fail {
    val f: Fail  = fail.about(fail.in_file(fail.malformed("an input states a trait value an earlier input contradicts"), input.at(inputs, id).name), x.name);
    var k: usize = 0;
    for (k < id.index::usize) {
        val e: Id[input.Input] = table.nth[input.Input](k);
        val o: *Object         = input.object_of(inputs, e);
        if (o != nil && (sel o.library.none)) {
            val s: opt[*Trait] = trait.find(?o.traits, x);
            if (sel s.some) { ret fail.in_record(f, input.at(inputs, e).name); }
        }
        k = k + 1;
    }
    ret f;
}

# the refusal of input `id` stating the fact `f` an earlier input states
# otherwise, naming the first earlier input that states a fact of its identity
fun fact_clash(inputs: *Inputs, id: Id[input.Input], f: *Fact, keyed: bool) Fail {
    var shown: u64 = f.key::u64;
    if (keyed) { shown = f.value; }
    val e: Fail  = fail.valued(fail.about(fail.in_file(fail.malformed("an input states a format fact an earlier input contradicts"), input.at(inputs, id).name), f.format.name), shown::i128);
    var k: usize = 0;
    for (k < id.index::usize) {
        val other: Id[input.Input] = table.nth[input.Input](k);
        val o:     *Object         = input.object_of(inputs, other);
        k = k + 1;
        if (o == nil || !(sel o.library.none)) { cnt; }
        var j: usize = 0;
        for (j < table.count[Fact](?o.facts)) {
            val g: *Fact = table.at[Fact](?o.facts, table.nth[Fact](j));
            j = j + 1;
            if (g.format == f.format && g.key == f.key && (!keyed || g.value == f.value)) { ret fail.in_record(e, input.at(inputs, other).name); }
        }
    }
    ret e;
}

pub fun release(s: *Settled) err[Fail] {
    val rf: err[Fail] = table.release[Fact](?s.facts);
    val rs: err[Fail] = table.release[u8](?s.store);
    val rt: err[Fail] = table.release[Trait](?s.traits);
    val rc: err[Fail] = consume.release(?s.consumed);
    if (sel rf.err) { ret rf; }
    if (sel rs.err) { ret rs; }
    if (sel rt.err) { ret rt; }
    ret rc;
}

# a riscv64 object stating the float ABI `abi` and, when `rvc`, compressed code
fun riscv(a: *A.Allocator, abi: *trait.Choice, rvc: bool) res[Object, Fail] {
    var o: Object    = object.make(a, ?arch.RISCV64);
    var r: err[Fail] = object.state(?o, ?arch.RISCV_FLOAT_ABI, Setting.choice{abi});
    if (sel r.ok && rvc) { r = object.state(?o, ?arch.RISCV_RVC, Setting.flag{true}); }
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}

# a settle over the given objects `objects`, named `names`, the same count of each
fun settled(a: *A.Allocator, objects: *Object, names: *str, n: usize, out: *Settled) err[Fail] {
    var inputs: Inputs = input.make(a);
    var i:      usize  = 0;
    for (i < n) {
        val b: res[Id[input.Input], Fail] = input.borrow(?inputs, Given{name: names[i], object: ?objects[i]});
        if (sel b.err) {
            val dropped: err[Fail] = input.release(?inputs);
            ret err[Fail].err{b.err};
        }
        i = i + 1;
    }
    var in:  In        = In{inputs: ?inputs};
    val r:   err[Fail] = run(?in, out);
    val rel: err[Fail] = input.release(?inputs);
    if (sel r.err) { ret r; }
    ret rel;
}

fun release_all(objects: *Object, n: usize) bool {
    var ok: bool  = true;
    var i:  usize = 0;
    for (i < n) {
        val r: err[Fail] = object.release(?objects[i]);
        if (sel r.err) { ok = false; }
        i = i + 1;
    }
    ret ok;
}

test settle__each_axis_merges_by_its_rule {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # compressed code in one input sets rvc for all, an input that states
    # nothing constrains nothing, and the float ABI every input states is kept
    val one: res[Object, Fail] = riscv(a, ?arch.RISCV_DOUBLE, true);
    if (sel one.err) { ret 1; }
    val two: res[Object, Fail] = riscv(a, ?arch.RISCV_DOUBLE, false);
    if (sel two.err) { ret 1; }
    var objects: [3]Object = [3]Object{one.ok, object.make(a, ?arch.RISCV64), two.ok};
    var names:   [3]str    = [3]str{"one.o", "bare.o", "two.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 3, ?s);
    if (sel r.err)                          { ret 1; }
    if (table.count[Trait](?s.traits) != 2) { ret 1; }
    val f: opt[*Trait] = trait.find(?s.traits, ?arch.RISCV_FLOAT_ABI);
    if (sel f.none)                                                      { ret 1; }
    if (!trait.same(f.some.setting, Setting.choice{?arch.RISCV_DOUBLE})) { ret 1; }
    val c: opt[*Trait] = trait.find(?s.traits, ?arch.RISCV_RVC);
    if (sel c.none)                                      { ret 1; }
    if (!trait.same(c.some.setting, Setting.flag{true})) { ret 1; }
    if (s.folded != 3)                                   { ret 1; }

    val rel: err[Fail] = release(?s);
    if (sel rel.err)                  { ret 1; }
    if (!release_all(?objects[0], 3)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}

test settle__different_float_abis_are_refused_naming_both_inputs_and_the_axis {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    val soft: res[Object, Fail] = riscv(a, ?arch.RISCV_SOFT, false);
    if (sel soft.err) { ret 1; }
    val double: res[Object, Fail] = riscv(a, ?arch.RISCV_DOUBLE, true);
    if (sel double.err) { ret 1; }
    var objects: [2]Object = [2]Object{soft.ok, double.ok};
    var names:   [2]str    = [2]str{"soft.o", "double.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 2, ?s);
    if (sel r.ok)                                      { ret 1; }
    if (!sel r.err.cause.malformed)                    { ret 1; }
    if (!str_equals(r.err.at.file, "double.o"))        { ret 1; }
    if (!str_equals(r.err.at.record, "soft.o"))        { ret 1; }
    if (!str_equals(r.err.subject, "riscv-float-abi")) { ret 1; }
    # the refused input merged nothing, its rvc included
    if (table.count[Trait](?s.traits) != 1) { ret 1; }
    if (s.folded != 1)                      { ret 1; }

    val rel: err[Fail] = release(?s);
    if (sel rel.err)                  { ret 1; }
    if (!release_all(?objects[0], 2)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}

# a riscv64 object stating the atomics ABI `abi`
fun riscv_atomic(a: *A.Allocator, abi: *trait.Choice) res[Object, Fail] {
    var o: Object    = object.make(a, ?arch.RISCV64);
    val r: err[Fail] = object.state(?o, ?arch.RISCV_ATOMIC_ABI, Setting.choice{abi});
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}

# the atomics ABI a settle over objects stating `abis` gives, none when refused
fun atomic_settled(a: *A.Allocator, abis: **trait.Choice, n: usize) res[opt[*trait.Choice], Fail] {
    var objects: [3]Object = [3]Object{object.make(a, ?arch.RISCV64), object.make(a, ?arch.RISCV64), object.make(a, ?arch.RISCV64)};
    var names:   [3]str    = [3]str{"a.o", "b.o", "c.o"};
    var i:       usize     = 0;
    for (i < n) {
        val o: res[Object, Fail] = riscv_atomic(a, abis[i]);
        if (sel o.err) { ret res[opt[*trait.Choice], Fail].err{o.err}; }
        val old: err[Fail] = object.release(?objects[i]);
        if (sel old.err) { ret res[opt[*trait.Choice], Fail].err{old.err}; }
        objects[i] = o.ok;
        i          = i + 1;
    }
    var s:   Settled            = make(a);
    val r:   err[Fail]          = settled(a, ?objects[0], ?names[0], n, ?s);
    var got: opt[*trait.Choice] = opt[*trait.Choice].none{};
    if (sel r.ok) {
        val x: opt[*Trait] = trait.find(?s.traits, ?arch.RISCV_ATOMIC_ABI);
        if (sel x.some) {
            if (sel x.some.setting.choice) { got = opt[*trait.Choice].some{x.some.setting.choice}; }
        }
    }
    val rel: err[Fail] = release(?s);
    if (!release_all(?objects[0], 3)) { ret res[opt[*trait.Choice], Fail].err{fail.internal("an object did not release")}; }
    if (sel rel.err)                  { ret res[opt[*trait.Choice], Fail].err{rel.err}; }
    ret res[opt[*trait.Choice], Fail].ok{got};
}

test settle__an_ordered_axis_merges_into_the_choice_containing_every_input {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # the psABI table: unknown and A6S merge into A6C in either order, and
    # A6S and A7 into A7
    val up:   [3]*trait.Choice              = [3]*trait.Choice{?arch.RISCV_ATOMIC_UNKNOWN, ?arch.RISCV_ATOMIC_A6S, ?arch.RISCV_ATOMIC_A6C};
    val down: [3]*trait.Choice              = [3]*trait.Choice{?arch.RISCV_ATOMIC_A6C, ?arch.RISCV_ATOMIC_A6S, ?arch.RISCV_ATOMIC_UNKNOWN};
    val a7:   [2]*trait.Choice              = [2]*trait.Choice{?arch.RISCV_ATOMIC_A6S, ?arch.RISCV_ATOMIC_A7};
    val r1:   res[opt[*trait.Choice], Fail] = atomic_settled(a, ?up[0], 3);
    val r2:   res[opt[*trait.Choice], Fail] = atomic_settled(a, ?down[0], 3);
    val r3:   res[opt[*trait.Choice], Fail] = atomic_settled(a, ?a7[0], 2);
    if (sel r1.err)                                                { ret 1; }
    if (sel r2.err)                                                { ret 1; }
    if (sel r3.err)                                                { ret 1; }
    if (!(sel r1.ok.some && r1.ok.some == ?arch.RISCV_ATOMIC_A6C)) { ret 2; }
    if (!(sel r2.ok.some && r2.ok.some == ?arch.RISCV_ATOMIC_A6C)) { ret 3; }
    if (!(sel r3.ok.some && r3.ok.some == ?arch.RISCV_ATOMIC_A7))  { ret 4; }

    # A7 and A6C are refused, naming both inputs and the axis
    val a7o: res[Object, Fail] = riscv_atomic(a, ?arch.RISCV_ATOMIC_A7);
    if (sel a7o.err) { ret 1; }
    val a6c: res[Object, Fail] = riscv_atomic(a, ?arch.RISCV_ATOMIC_A6C);
    if (sel a6c.err) { ret 1; }
    var objects: [2]Object = [2]Object{a7o.ok, a6c.ok};
    var names:   [2]str    = [2]str{"a7.o", "a6c.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 2, ?s);
    if (sel r.ok)                                       { ret 5; }
    if (!str_equals(r.err.at.file, "a6c.o"))            { ret 5; }
    if (!str_equals(r.err.at.record, "a7.o"))           { ret 5; }
    if (!str_equals(r.err.subject, "riscv-atomic-abi")) { ret 5; }
    val rel: err[Fail] = release(?s);
    if (sel rel.err)                  { ret 1; }
    if (!release_all(?objects[0], 2)) { ret 1; }

    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

# a riscv64 object stating the ISA string `isa`
fun riscv_arch(a: *A.Allocator, isa: str) res[Object, Fail] {
    var o: Object    = object.make(a, ?arch.RISCV64);
    val r: err[Fail] = object.state(?o, ?arch.RISCV_ARCH, Setting.text{Held.borrowed{Bytes{data: isa::*u8, len: str_len(isa)}}});
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}

test settle__riscv_attributes_merge_their_architecture_strings {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # every extension either names, at the higher version, in canonical order
    val one: res[Object, Fail] = riscv_arch(a, "rv64i2p1_m2p0_a2p1_c2p0_zicsr2p0");
    if (sel one.err) { ret 1; }
    val two: res[Object, Fail] = riscv_arch(a, "rv64i2p0_m2p0_f2p2_d2p2_zifencei2p0_zicsr2p0");
    if (sel two.err) { ret 1; }
    var objects: [2]Object = [2]Object{one.ok, two.ok};
    var names:   [2]str    = [2]str{"one.o", "two.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 2, ?s);
    if (sel r.err) { ret 1; }
    val isa: opt[*Trait] = trait.find(?s.traits, ?arch.RISCV_ARCH);
    if (sel isa.none)               { ret 1; }
    if (!sel isa.some.setting.text) { ret 1; }
    val got:  Bytes = settled_bytes(?s, ?isa.some.setting.text);
    val want: str   = "rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0_zicsr2p0_zifencei2p0";
    if (!trait.same_bytes(got, Bytes{data: want::*u8, len: str_len(want)})) { ret 1; }

    val rel: err[Fail] = release(?s);
    if (sel rel.err)                  { ret 1; }
    if (!release_all(?objects[0], 2)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}

# an x86_64 object whose GNU property ISA_1_NEEDED word is `needed`, as the
# ELF rows decode it, and without the property for none
fun x86_needing(a: *A.Allocator, needed: u32) res[Object, Fail] {
    var o:     Object    = object.make(a, ?arch.X86_64);
    var w:     Words     = traits.make_words(a, 0);
    var added: err[Fail] = err[Fail].ok{};
    if (needed != 0) { added = traits.add_word(?w, Word{type: tables.GNU_PROPERTY_X86_ISA_1_NEEDED.value::u32, value: needed}); }
    var rs: Table[Reading] = table.make[Reading](a);
    var r:  err[Fail]      = added;
    if (!(sel r.err)) { r = traits.decode(?arch.X86_64, ?w, ?rs); }
    if (!(sel r.err)) { r = traits.reconcile(?rs, nil, ?o.traits); }
    val rel: err[Fail] = traits.release_words(?w);
    val rr:  err[Fail] = table.release[Reading](?rs);
    if (sel r.err || sel rel.err || sel rr.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{fail.internal("the test object was not built")};
    }
    ret res[Object, Fail].ok{o};
}

test settle__x86_isa_levels_are_or_ed {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # baseline and v2 in one input and v3 in another need all three, and an
    # input without the property needs none
    val low: res[Object, Fail] = x86_needing(a, 0x3);
    if (sel low.err) { ret 1; }
    val bare: res[Object, Fail] = x86_needing(a, 0);
    if (sel bare.err) { ret 1; }
    val high: res[Object, Fail] = x86_needing(a, 0x4);
    if (sel high.err) { ret 1; }
    var objects: [3]Object = [3]Object{low.ok, bare.ok, high.ok};
    var names:   [3]str    = [3]str{"low.o", "bare.o", "high.o"};
    var s:       Settled   = make(a);
    val r:       err[Fail] = settled(a, ?objects[0], ?names[0], 3, ?s);
    if (sel r.err) { ret 1; }
    var w:  Words     = traits.make_words(a, 0);
    val en: err[Fail] = traits.encode(?arch.X86_64, ?s.traits, ?w);
    if (sel en.err) { ret 1; }
    val needed: opt[*Word] = traits.word(?w, tables.GNU_PROPERTY_X86_ISA_1_NEEDED.value::u32);
    if (sel needed.none)          { ret 1; }
    if (needed.some.value != 0x7) { ret 1; }

    val rw:  err[Fail] = traits.release_words(?w);
    val rel: err[Fail] = release(?s);
    if (sel rw.err || sel rel.err)    { ret 1; }
    if (!release_all(?objects[0], 3)) { ret 1; }
    if (T.live_count(?t) != 0)        { ret 1; }
    T.dnit(?t);
    ret 0;
}
