# the merge phase: the pieces of mergeable sections merged into one
#
# a section of mergeable entries, as strings or constants of one size, is cut
# into pieces, and pieces of equal bytes in sections of one output section
# are kept once, every reference to a piece reaching the one kept. the phase
# runs before tables are reserved, so layout sees the merged sizes. no format
# merges yet, so the phase merges nothing and the record stays empty.

use std.types.error.err;

use A: std.allocator;

use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.link.collect.Live;
use mink.link.collect.Ref;
use mink.link.input.Inputs;

# a piece of a mergeable section and the piece it is kept as
# ---
# at:     the section holding the piece
# offset: where in it the piece starts
# kept:   the index in pieces of the piece kept for it, its own when it is
#         the one kept
pub rec Piece {
    at:     Ref;
    offset: u64;
    kept:   u32;
}

# pieces: every piece of every mergeable section, by section then offset
pub rec Merged {
    pieces: Table[Piece];
}

pub rec In {
    inputs: *Inputs;
    live:   *Live;
}

pub fun make(a: *A.Allocator) Merged {
    ret Merged{pieces: table.make[Piece](a)};
}

# merge the pieces of the mergeable sections, of which no format has any yet
pub fun run(in: *In, out: *Merged) err[Fail] {
    ret err[Fail].ok{};
}

pub fun release(m: *Merged) err[Fail] {
    ret table.release[Piece](?m.pieces);
}
