# what a caller hands a link, which the API takes
fwd mink.link.input.Given;
fwd mink.link.input.Source;

# every fact the caller states about a link
# ---
# kind:       the output kind
# format:     the output format
# target:     what the image is for, which names its system
# entry:      the entry symbol, nil for the system's
# keep:       the names kept whether referenced or not
# keep_count: how many
# keep_all:   every input section is kept, as when stripping is off
# state:      the path of the link's one state file, nil for a link that keeps
#             none. mink writes no other file
# registry:   the formats, borrowed for as long as the state lives
pub rec Options {
    kind:       *Kind;
    format:     *Format;
    target:     Target;
    entry:      str;
    keep:       *str;
    keep_count: usize;
    keep_all:   bool;
    state:      str;
    registry:   *Registry;
}

# how far a phase got
# ---
# pending:      it has not run
# ran:          it ran to the end
# inapplicable: the architecture lacks a capability it needs, so it did not run
# failed:       it failed
pub tag Step: u8 {
    pending;
    ran;
    inapplicable;
    failed;
}

# name:  the phase's spelling in a diagnostic
# needs: the architecture capabilities it needs to apply
# run:   the phase over the state, from its input record to its output record
pub rec Phase {
    name:  str;
    needs: arch.Caps;
    run:   fun(*State) err[Fail];
}

pub val PHASE_COUNT: usize = 12;

# the layout phase's row, which relayout runs again
val LAYOUT: usize = 9;

# options:      what the caller stated
# system:       the system the link's target names
# registration: the output format's registration
# linking:      how the output format links
# pair:         what the output format states for the architecture
# relocs:       the pair's relocation rows
# host:         what the system says for the architecture under the merged
#               traits, nil until the inputs first settle
# sources:      what the caller handed over, borrowed
# count:        how many
# names:        the link's names
# inputs:       the gather phase's output, which synthesized inputs join
# placing:      where the link states its sections go
# output:       the image's bytes
# phase:        the phase running, or the last that ran
# steps:        how far each phase got
pub rec State {
    a:            *A.Allocator;
    options:      Options;
    system:       *System;
    registration: *Registration;
    linking:      *Linking;
    pair:         *Pair;
    relocs:       row.Lookup;
    host:         *Host;
    sources:      *Source;
    count:        usize;
    names:        Interner;
    inputs:       Inputs;
    settled:      Settled;
    synthesized:  Synthesized;
    resolved:     Resolved;
    live:         Live;
    dynamic:      Dynamic;
    reserved:     Reserved;
    placing:      Constraints;
    layout:       Layout;
    relocated:    Relocated;
    image:        Image;
    output:       Sink;
    phase:        usize;
    steps:        [PHASE_COUNT]Step;
}

val PHASES: [PHASE_COUNT]Phase = [PHASE_COUNT]Phase{
    Phase{name: "gather", needs: 0, run: gather_phase},
    Phase{name: "settle", needs: 0, run: settle_phase},
    Phase{name: "synthesize before resolve", needs: 0, run: synthesize_before_resolve},
    Phase{name: "resolve", needs: 0, run: resolve_phase},
    Phase{name: "synthesize after resolve", needs: 0, run: synthesize_after_resolve},
    Phase{name: "collect", needs: 0, run: collect_phase},
    Phase{name: "synthesize after collect", needs: 0, run: synthesize_after_collect},
    Phase{name: "dynamic", needs: arch.ADDRESSED, run: dynamic_phase},
    Phase{name: "reserve", needs: arch.ADDRESSED, run: reserve_phase},
    Phase{name: "layout", needs: arch.ADDRESSED, run: layout_phase},
    Phase{name: "relocate", needs: 0, run: relocate_phase},
    Phase{name: "write", needs: 0, run: write_phase},
};

pub fun phase_at(index: usize) *Phase {
    ret ?PHASES[index];
}

# make the state of a link at `st`, which stays where it is until released.
# the state is released by release whether or not opening it succeeds
pub fun open(st: *State, a: *A.Allocator, o: Options) err[Fail] {
    @st = State{
        a:         a,
        options:   o,
        names:     intern.make(a),
        inputs:    input.make(a),
        settled:   settle.make(a),
        resolved:  resolve.make(a),
        live:      collect.make(a),
        dynamic:   dynamic.make(a),
        reserved:  reserve.make(a),
        placing:   layout.constraints(a),
        layout:    layout.make(a),
        relocated: relocate.make(a),
        output:    sink.make(a, LITTLE),
    };
    if (!output.builds(o.kind, o.format)) {
        ret err[Fail].err{fail.in_record(fail.unsupported("the output format cannot build this output kind"), o.kind.name)};
    }
    val system: opt[*System] = o.target.system;
    if (sel system.none) { ret err[Fail].err{fail.unsupported("the link names no system")}; }
    st.system = system.some;
    if (!os.accepts(system.some, o.format)) {
        ret err[Fail].err{fail.in_record(fail.unsupported("the system does not take this output format"), o.format.name)};
    }
    if (!os.runs(system.some, o.target.env, o.target.arch)) {
        ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the system does not run this architecture"), system.some.name), o.target.arch.name)};
    }
    val reg: res[*Registration, Fail] = registry.by_format(o.registry, o.format);
    if (sel reg.err) { ret err[Fail].err{reg.err}; }
    st.registration = reg.ok;
    val l: res[*Linking, Fail] = registration.linking(reg.ok);
    if (sel l.err) { ret err[Fail].err{l.err}; }
    st.linking = l.ok;
    val p: res[*Pair, Fail] = registration.pair_of(reg.ok, o.target.arch);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    st.pair = p.ok;
    val relocs: res[row.Lookup, Fail] = row.build(a, p.ok.relocs);
    if (sel relocs.err) { ret err[Fail].err{relocs.err}; }
    st.relocs = relocs.ok;
    if (o.state != nil) {
        ret err[Fail].err{fail.unsupported("keeping a link state file is not supported yet")};
    }
    ret err[Fail].ok{};
}

# link the `count` sources at `sources`, borrowed for as long as the state
# lives, running every phase in order
pub fun run(st: *State, sources: *Source, count: usize) err[Fail] {
    st.sources = sources;
    st.count   = count;
    ret drive(st, ?PHASES[0], PHASE_COUNT);
}

# lay the image out again after a later phase grew a table, every address
# read back afresh
pub fun relayout(st: *State) err[Fail] {
    layout.clear(?st.layout);
    val row: *Phase = ?PHASES[LAYOUT];
    if (!arch.has(st.options.target.arch, row.needs)) { ret err[Fail].ok{}; }
    ret row.run(st);
}

# the image's bytes, which the caller owns from now on
pub fun take(st: *State) Sink {
    val out: Sink = st.output;
    st.output = sink.make(st.a, LITTLE);
    ret out;
}

# give back everything the link built, reporting the first refusal. releasing
# again gives back nothing
pub fun release(st: *State) err[Fail] {
    var first: err[Fail] = sink.release(?st.output);
    first = kept(first, relocate.release(?st.relocated));
    first = kept(first, layout.release(?st.layout));
    first = kept(first, layout.release_constraints(?st.placing));
    first = kept(first, reserve.release(?st.reserved));
    first = kept(first, dynamic.release(?st.dynamic));
    first = kept(first, collect.release(?st.live));
    first = kept(first, resolve.release(?st.resolved));
    first = kept(first, settle.release(?st.settled));
    first = kept(first, input.release(?st.inputs));
    if (st.relocs.set != nil) {
        first         = kept(first, row.release_lookup(?st.relocs));
        st.relocs.set = nil;
    }
    ret kept(first, intern.release(?st.names));
}

# append to `out` the link's report of what it did that its image does not
# show, a line for each trait axis it dropped
pub fun report(st: *State, out: *Sink) err[Fail] {
    ret settle.report(?st.settled, ?st.inputs, out);
}

# link the `count` sources at `sources` in one call, returning the image's
# bytes and appending the link's report to `notes`
pub fun link(a: *A.Allocator, o: Options, sources: *Source, count: usize, notes: *Sink) res[Sink, Fail] {
    var st:     State;
    val opened: err[Fail] = open(?st, a, o);
    var ran:    err[Fail] = opened;
    if (sel opened.ok) { ran = run(?st, sources, count); }
    var told: err[Fail] = ran;
    if (sel ran.ok) { told = report(?st, notes); }
    var out:   Sink      = take(?st);
    val rel:   err[Fail] = release(?st);
    val first: err[Fail] = kept(told, rel);
    if (sel first.ok) { ret res[Sink, Fail].ok{out}; }
    val reported: err[Fail] = kept(first, sink.release(?out));
    if (sel reported.err) { ret res[Sink, Fail].err{reported.err}; }
    ret res[Sink, Fail].err{first.err};
}

fun drive(st: *State, rows: *Phase, count: usize) err[Fail] {
    var i: usize = 0;
    for (i < count) {
        st.phase = i;
        if (!arch.has(st.options.target.arch, rows[i].needs)) {
            st.steps[i] = Step.inapplicable{};
            i           = i + 1;
            cnt;
        }
        val r: err[Fail] = rows[i].run(st);
        if (sel r.err) {
            st.steps[i] = Step.failed{};
            ret r;
        }
        st.steps[i] = Step.ran{};
        i           = i + 1;
    }
    ret err[Fail].ok{};
}

fun gather_phase(st: *State) err[Fail] {
    var in: gather.In = gather.In{
        readers:  ?st.options.registry.readers,
        format:   st.options.format,
        lowering: st.registration.lowering,
        relocs:   st.pair.relocs,
        arch:     st.options.target.arch,
        sources:  st.sources,
        count:    st.count,
    };
    ret gather.run(?in, ?st.inputs);
}

# settle the inputs, then take the host the merged traits choose, once
fun settle_phase(st: *State) err[Fail] {
    var in: settle.In = settle.In{inputs: ?st.inputs, arch: st.options.target.arch, format: st.options.format, facts: st.linking.facts, uses: ?st.linking.uses};
    val r:  err[Fail] = settle.run(?in, ?st.settled);
    if (sel r.err)      { ret r; }
    if (st.host != nil) { ret r; }
    val h: res[*Host, Fail] = os.host(st.system, st.options.target.env, st.options.target.arch, ?st.settled.traits);
    if (sel h.err) { ret err[Fail].err{h.err}; }
    st.host = h.ok;
    ret r;
}

# settle the inputs a phase that ran as `r` appended, so the settled record
# covers every input before the next phase reads it
fun settled_after(st: *State, r: err[Fail]) err[Fail] {
    if (sel r.err) { ret r; }
    ret settle_phase(st);
}

fun synthesize_before_resolve(st: *State) err[Fail] {
    var in: synthesize.In = synthesize.In{context: context(st), resolve: nil, rows: ?st.linking.synthesizers};
    ret settled_after(st, synthesize.run(?in, ?st.synthesized, ?synthesizer.BEFORE_RESOLVE));
}

fun synthesize_after_resolve(st: *State) err[Fail] {
    var again: resolve.In;
    val r:     err[Fail] = resolving(st, ?again);
    if (sel r.err) { ret r; }
    var in: synthesize.In = synthesize.In{context: context(st), resolve: ?again, rows: ?st.linking.synthesizers};
    in.context.resolved = ?st.resolved;
    ret settled_after(st, synthesize.run(?in, ?st.synthesized, ?synthesizer.AFTER_RESOLVE));
}

fun synthesize_after_collect(st: *State) err[Fail] {
    var again: resolve.In;
    val r:     err[Fail] = resolving(st, ?again);
    if (sel r.err) { ret r; }
    var in: synthesize.In = synthesize.In{context: context(st), resolve: ?again, rows: ?st.linking.synthesizers};
    in.context.resolved = ?st.resolved;
    in.context.live     = ?st.live;
    ret settled_after(st, synthesize.run(?in, ?st.synthesized, ?synthesizer.AFTER_COLLECT));
}

# what the synthesizers read of the link so far, whose answers a stage adds
fun context(st: *State) Context {
    ret Context{
        inputs:  ?st.inputs,
        names:   ?st.names,
        settled: ?st.settled,
        kind:    st.options.kind,
        target:  ?st.options.target,
        host:    st.host,
    };
}

# the resolve phase's input, which extending resolution after a stage reads
# too
fun resolving(st: *State, in: *resolve.In) err[Fail] {
    @in = resolve.In{
        inputs:  ?st.inputs,
        names:   ?st.names,
        readers: ?st.options.registry.readers,
        arch:    st.options.target.arch,
        kind:    st.options.kind,
        search:  st.linking.search,
        hooks:   st.linking.hooks,
    };
    ret err[Fail].ok{};
}

fun resolve_phase(st: *State) err[Fail] {
    var in: resolve.In;
    val r:  err[Fail] = resolving(st, ?in);
    if (sel r.err) { ret r; }
    ret settled_after(st, resolve.run(?in, ?st.resolved));
}

# the entry symbol of the link: the options', or the host's for the output
# kind where they name none, for a kind that has one
fun entry_of(st: *State) str {
    val o: *Options = ?st.options;
    if (!output.has(o.kind, output.ENTERED)) { ret nil; }
    if (o.entry != nil)                      { ret o.entry; }
    ret os.entry(st.host, o.kind);
}

fun collect_phase(st: *State) err[Fail] {
    var in: collect.In = collect.In{
        inputs:     ?st.inputs,
        names:      ?st.names,
        resolved:   ?st.resolved,
        kind:       st.options.kind,
        entry:      entry_of(st),
        keep:       st.options.keep,
        keep_count: st.options.keep_count,
        keep_all:   st.options.keep_all,
    };
    ret collect.run(?in, ?st.live);
}

fun dynamic_phase(st: *State) err[Fail] {
    var in: dynamic.In = dynamic.In{
        inputs:   ?st.inputs,
        names:    ?st.names,
        resolved: ?st.resolved,
        live:     ?st.live,
        kind:     st.options.kind,
        arch:     st.options.target.arch,
        rules:    st.linking.dynamic,
        relocs:   ?st.relocs,
    };
    ret dynamic.run(?in, ?st.dynamic);
}

fun reserve_phase(st: *State) err[Fail] {
    var in: reserve.In = reserve.In{
        inputs:    ?st.inputs,
        names:     ?st.names,
        facts:     ?st.settled.facts,
        store:     ?st.settled.store,
        traits:    ?st.settled.traits,
        consumed:  ?st.settled.consumed,
        resolved:  ?st.resolved,
        live:      ?st.live,
        dynamic:   ?st.dynamic,
        kind:      st.options.kind,
        format:    st.options.format,
        arch:      st.options.target.arch,
        declarers: st.linking.declarers,
    };
    ret reserve.run(?in, ?st.reserved);
}

fun layout_phase(st: *State) err[Fail] {
    var in: layout.In = layout.In{
        inputs:       ?st.inputs,
        names:        ?st.names,
        resolved:     ?st.resolved,
        live:         ?st.live,
        reserved:     ?st.reserved,
        kind:         st.options.kind,
        target:       ?st.options.target,
        host:         st.host,
        rules:        st.linking.layout,
        thread:       st.pair.thread,
        constraints:  ?st.placing,
        participants: st.linking.participants,
        limit:        layout.PASSES,
    };
    ret layout.run(?in, ?st.layout);
}

fun relocate_phase(st: *State) err[Fail] {
    var in: relocate.In = relocate.In{
        inputs:   ?st.inputs,
        resolved: ?st.resolved,
        reserved: ?st.reserved,
        dynamic:  ?st.dynamic,
        layout:   ?st.layout,
        kind:     st.options.kind,
        arch:     st.options.target.arch,
        host:     st.host,
        relocs:   ?st.relocs,
        weak:     st.linking.weak,
    };
    ret relocate.run(?in, ?st.relocated);
}

fun write_phase(st: *State) err[Fail] {
    st.image = Image{
        kind:      st.options.kind,
        format:    st.options.format,
        target:    ?st.options.target,
        host:      st.host,
        entry:     entry_of(st),
        inputs:    ?st.inputs,
        names:     ?st.names,
        settled:   ?st.settled,
        resolved:  ?st.resolved,
        live:      ?st.live,
        dynamic:   ?st.dynamic,
        reserved:  ?st.reserved,
        layout:    ?st.layout,
        relocated: ?st.relocated,
    };
    var in: write.In = write.In{a: st.a, writer: st.linking.writer, image: ?st.image};
    ret write.run(?in, ?st.output);
}

fun kept(first: err[Fail], next: err[Fail]) err[Fail] {
    if (sel first.err) { ret first; }
    ret next;
}

# a stub format a test links: "STB!" and nothing else, read into one owned
# word and converted to one text section
val STUB_FORMAT:    Format       = Format{name: "stub"};
val STUB_BYTES:     [4]u8        = [4]u8{'S', 'T', 'B', '!'};
val STUB_MAGICS:    [1]Magic     = [1]Magic{Magic{offset: 0, bytes: ?STUB_BYTES[0], len: 4}};
val STUB_REVISIONS: [1]Revision  = [1]Revision{Revision{spec: "stub", revision: "1"}};
val STUB_CODEC:     Codec        = Codec{identify: Identify.magics{Magics{rows: ?STUB_MAGICS[0], count: 1}}, read: stub_read, write: stub_write, dump: stub_dump, kind: stub_kind, locate: stub_locate, release: stub_release};
val STUB_NEUTRAL:   Neutral      = Neutral{to: stub_to_neutral, from: stub_from_neutral};
val STUB:           Registration = Registration{
    format:         ?STUB_FORMAT,
    codec:          opt[*Codec].some{?STUB_CODEC},
    neutral:        opt[*Neutral].some{?STUB_NEUTRAL},
    revisions:      ?STUB_REVISIONS[0],
    revision_count: 1,
};

fun stub_from_neutral(a: *A.Allocator, o: *Object, t: *Target, l: opt[*Lowering]) res[ptr, Fail] {
    ret res[ptr, Fail].err{fail.unsupported("the stub format builds no model")};
}

fun stub_read(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val m: res[*u64, A.Error] = A.allocate[u64](a, 1);
    if (sel m.err) { ret res[ptr, Fail].err{fail.refused(m.err)}; }
    ret res[ptr, Fail].ok{m.ok::ptr};
}

fun stub_write(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret res[Sink, Fail].err{fail.unsupported("the stub format is read only")};
}

fun stub_dump(m: ptr, d: *Dumper) err[Fail] {
    ret err[Fail].ok{};
}

fun stub_to_neutral(m: ptr, o: *Object) err[Fail] {
    val nm: res[Id[intern.Name], Fail] = object.name_str(o, ".text");
    if (sel nm.err) { ret err[Fail].err{nm.err}; }
    val s: res[Id[object.Section], Fail] = object.add_section(o, object.Section{name: opt[Id[intern.Name]].some{nm.ok}, kind: ?section.TEXT, flags: section.TEXT.flags, align: 1});
    if (sel s.err) { ret err[Fail].err{s.err}; }
    ret err[Fail].ok{};
}

fun stub_kind(m: ptr) res[*catalog_kind.Kind, Fail] {
    ret res[*catalog_kind.Kind, Fail].ok{?catalog_kind.RELOCATABLE};
}

fun stub_locate(m: ptr, offset: u64) Location {
    ret Location{record: "header", offset: offset, placed: true};
}

fun stub_release(a: *A.Allocator, m: ptr) err[Fail] {
    val r: err[A.Error] = A.deallocate[u64](a, m::*u64, 1);
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}

# the options of a static x86_64 linux ELF link through `g`
fun stub_options(g: *Registry) Options {
    ret Options{kind: ?output.STATIC, format: ?format.ELF, target: Target{arch: ?x86.X86_64, system: opt[*System].some{?linux.LINUX}, env: opt[*Env].some{?linux.GNU}}, registry: g};
}

val STUB_ENTRIES: [2]*Registration = [2]*Registration{?elf.REGISTRATION, ?STUB};

# a format a test links that registers no codec and states a pair for an
# architecture with no addresses, whose linking row builds no image
val INDEXED_RELOCS:  row.Set      = row.Set{format: ?format.SPIRV, arch: ?spirv.SPIRV};
val INDEXED_PAIRS:   [1]Pair      = [1]Pair{Pair{arch: ?spirv.SPIRV, code: ?spirv.SPIRV_CODES[0], relocs: ?INDEXED_RELOCS}};
val INDEXED_LINKING: Linking      = Linking{hooks: ?resolve.PLAIN, weak: Weak.unruled{}, layout: ?elf_convention.LAYOUT, dynamic: ?dynamic.UNBOUND, facts: ?merge.NONE};
val INDEXED:         Registration = Registration{
    format:         ?format.SPIRV,
    pairs:          ?INDEXED_PAIRS[0],
    pair_count:     1,
    link:           opt[*Linking].some{?INDEXED_LINKING},
    revisions:      ?STUB_REVISIONS[0],
    revision_count: 1,
};
val INDEXED_ENTRIES: [1]*Registration = [1]*Registration{?INDEXED};

# the phase a test fails at, and the phases a test saw run, in order
var FAIL_AT: usize = PHASE_COUNT;
var SEEN:    [PHASE_COUNT]usize;
var SEEN_N:  usize = 0;

# what each phase of a test builds into its own output record, then fails
# where the test says
fun building(st: *State) err[Fail] {
    val i: usize     = st.phase;
    var r: err[Fail] = err[Fail].ok{};
    if (i == 0) {
        r = gather_phase(st);
    }
    or (i == 1) {
        val f: res[Id[object.Fact], Fail] = table.push[object.Fact](?st.settled.facts, object.Fact{format: ?format.ELF});
        if (sel f.err) { r = err[Fail].err{f.err}; }
    }
    or (i == 2 || i == 4 || i == 6) {
        val e: res[Id[input.Input], Fail] = input.take(?st.inputs, "made", object.make(st.a, st.options.target.arch), opt[Id[Model]].none{});
        if (sel e.err) { r = err[Fail].err{e.err}; }
    }
    or (i == 3) {
        val b: res[Id[resolve.Binding], Fail] = table.push[resolve.Binding](?st.resolved.bindings, resolve.Binding{});
        if (sel b.err) { r = err[Fail].err{b.err}; }
    }
    or (i == 5) {
        val k: res[Id[collect.Ref], Fail] = table.push[collect.Ref](?st.live.kept, collect.Ref{});
        if (sel k.err) { r = err[Fail].err{k.err}; }
    }
    or (i == 7) {
        val x: res[Id[dynamic.Export], Fail] = table.push[dynamic.Export](?st.dynamic.exports, dynamic.Export{});
        if (sel x.err) { r = err[Fail].err{x.err}; }
    }
    or (i == 8) {
        val t: res[Id[reserve.Reservation], Fail] = table.push[reserve.Reservation](?st.reserved.tables, reserve.Reservation{kind: ?section.DATA});
        if (sel t.err) { r = err[Fail].err{t.err}; }
    }
    or (i == 9) {
        val m: res[Id[layout.Merged], Fail] = table.push[layout.Merged](?st.layout.merged, layout.Merged{kind: ?section.TEXT});
        if (sel m.err) { r = err[Fail].err{m.err}; }
    }
    or (i == 10) {
        val b: res[Id[u8], Fail] = table.grow[u8](?st.relocated.bytes, 64);
        if (sel b.err) { r = err[Fail].err{b.err}; }
    }
    or {
        r = sink.zeros(?st.output, 64);
    }
    if (sel r.err)    { ret r; }
    if (i == FAIL_AT) { ret err[Fail].err{fail.internal("a test phase fails here")}; }
    ret r;
}

fun recording(st: *State) err[Fail] {
    SEEN[SEEN_N] = st.phase;
    SEEN_N       = SEEN_N + 1;
    ret err[Fail].ok{};
}

test state__releases_everything_once_on_a_failure_at_each_phase {
    var at: usize = 0;
    for (at < PHASE_COUNT) {
        var t:    T.Testing;
        val made: err[A.Error] = T.make(?t);
        if (sel made.err) { ret 1; }
        var g: res[Registry, Fail] = registry.make(T.allocator_of(?t), ?STUB_ENTRIES[0], 2);
        if (sel g.err) { ret 1; }
        val good:    [8]u8     = [8]u8{'S', 'T', 'B', '!', 0, 0, 0, 0};
        val bad:     [8]u8     = [8]u8{'B', 'A', 'D', '!', 0, 0, 0, 0};
        var sources: [3]Source = [3]Source{
            Source.bytes{Input{file: "a.stb", data: ?good[0], len: 8}},
            Source.bytes{Input{file: "b.stb", data: ?good[0], len: 8}},
            Source.bytes{Input{file: "c.bad", data: ?bad[0], len: 8}},
        };
        var count: usize = 2;
        if (at == 0) { count = 3; }

        var rows: [PHASE_COUNT]Phase;
        var i:    usize = 0;
        for (i < PHASE_COUNT) {
            rows[i]     = PHASES[i];
            rows[i].run = building;
            i           = i + 1;
        }
        FAIL_AT = at;
        var st:     State;
        val opened: err[Fail] = open(?st, T.allocator_of(?t), stub_options(?g.ok));
        if (sel opened.err) { ret 1; }
        st.sources = ?sources[0];
        st.count   = count;
        val r: err[Fail] = drive(?st, ?rows[0], PHASE_COUNT);
        if (sel r.ok)                 { ret 1; }
        if (st.phase != at)           { ret 1; }
        if (!sel st.steps[at].failed) { ret 1; }

        val first: err[Fail] = release(?st);
        if (sel first.err) { ret 1; }
        val again: err[Fail] = release(?st);
        if (sel again.err) { ret 1; }
        val freed: err[Fail] = registry.release(?g.ok);
        if (sel freed.err)                { ret 1; }
        if (T.live_count(?t) != 0)        { ret 1; }
        if (T.double_free_count(?t) != 0) { ret 1; }
        T.dnit(?t);
        at = at + 1;
    }
    ret 0;
}

test state__phases_run_in_their_fixed_order {
    val names: [PHASE_COUNT]str = [PHASE_COUNT]str{
        "gather", "settle", "synthesize before resolve", "resolve", "synthesize after resolve", "collect",
        "synthesize after collect", "dynamic", "reserve", "layout", "relocate", "write",
    };
    var rows: [PHASE_COUNT]Phase;
    var i:    usize = 0;
    for (i < PHASE_COUNT) {
        if (!str_equals(phase_at(i).name, names[i])) { ret 1; }
        rows[i]     = PHASES[i];
        rows[i].run = recording;
        i           = i + 1;
    }
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var reg: res[Registry, Fail] = registry.make(T.allocator_of(?t), ?INDEXED_ENTRIES[0], 1);
    if (sel reg.err) { ret 1; }
    var st:     State;
    val opened: err[Fail] = open(?st, T.allocator_of(?t), Options{kind: ?output.MODULE, format: ?format.SPIRV, target: Target{arch: ?spirv.SPIRV, system: opt[*System].some{?os_spirv.VULKAN}}, registry: ?reg.ok});
    if (sel opened.err) { ret 1; }
    val r: err[Fail] = drive(?st, ?rows[0], PHASE_COUNT);
    if (sel r.err) { ret 1; }

    # the architecture has no addresses, so reserving tables and layout do not
    # apply
    if (SEEN_N != 9) { ret 1; }
    var seen: usize = 0;
    i = 0;
    for (i < PHASE_COUNT) {
        val skipped: bool = sel st.steps[i].inapplicable;
        if (skipped != (PHASES[i].needs != 0)) { ret 1; }
        if (!skipped) {
            if (SEEN[seen] != i) { ret 1; }
            seen = seen + 1;
        }
        i = i + 1;
    }

    # the format builds no image, so a real link is refused at the write
    val real: err[Fail] = run(?st, nil, 0);
    if (sel real.ok)                                  { ret 1; }
    if (!sel real.err.cause.unsupported)              { ret 1; }
    if (!sel st.steps[0].ran || !sel st.steps[1].ran) { ret 1; }
    val last: usize = PHASE_COUNT - 1;
    if (!sel st.steps[last].failed) { ret 1; }
    val rel: err[Fail] = release(?st);
    if (sel rel.err) { ret 1; }
    val freed: err[Fail] = registry.release(?reg.ok);
    if (sel freed.err)         { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
