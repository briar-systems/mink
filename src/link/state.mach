# what a caller hands a link, which the API takes
fwd mink.link.input.Given;
fwd mink.link.input.Source;

# how far a phase got
# ---
# pending:      it has not run
# ran:          it ran to the end
# inapplicable: the architecture lacks a capability it needs, so it did not run
# failed:       it failed
pub tag Step: u8 {
    pending;
    ran;
    inapplicable;
    failed;
}

# what a phase needs to apply
# ---
# arch:   the architecture capabilities
# link:   the capabilities of the output format's link
# output: the output kind's capabilities
pub rec Need {
    arch:   arch.Caps;
    link:   linking.Caps;
    output: output.Caps;
}

# name:  the phase's spelling in a diagnostic
# needs: what it needs to apply
# run:   the phase over the state, from its input record to its output record
pub rec Phase {
    name:  str;
    needs: Need;
    run:   fun(*State) err[Fail];
}

pub val PHASE_COUNT: usize = 16;

# the layout phase's row, which relayout runs again
val LAYOUT: usize = 13;

# options:      what the caller stated
# registry:     the formats, borrowed for as long as the state lives
# system:       the system the link's target names
# registration: the registration whose link builds the image: the output
#               format's, or the one it links as
# linking:      how that registration links
# writer:       the output format's image writer, none where none is built
# pair:         what the linking format states for the architecture
# relocs:       the pair's relocation rows, in the registry's index
# host:         what the system says for the architecture under the merged
#               traits, nil until the inputs first settle
# sources:      what the caller handed over, borrowed
# count:        how many
# notes:        the caller's sink for what a refusal cannot carry, borrowed
# names:        the link's names
# inputs:       the gather phase's output, which synthesized inputs join
# merging:      the merge phase's output
# placing:      where the link states its sections go
# adjusted:     what layout's participants changed of the inputs' bytes
# output:       the image's bytes
# phase:        the phase running, or the last that ran
# steps:        how far each phase got
pub rec State {
    a:            *A.Allocator;
    options:      Options;
    registry:     *Registry;
    system:       *System;
    registration: *Registration;
    linking:      *Linking;
    writer:       opt[*Writer];
    pair:         *Pair;
    relocs:       *row.Lookup;
    host:         *Host;
    sources:      *Source;
    count:        usize;
    notes:        *Sink;
    names:        Interner;
    inputs:       Inputs;
    settled:      Settled;
    synthesized:  Synthesized;
    resolved:     Resolved;
    live:         Live;
    folded:       Folded;
    dynamic:      Dynamic;
    assigned:     Assigned;
    merging:      Pieces;
    reserved:     Reserved;
    placing:      Constraints;
    adjusted:     Adjusted;
    layout:       Layout;
    sites:        Sites;
    relocated:    Relocated;
    image:        Image;
    output:       Sink;
    phase:        usize;
    steps:        [PHASE_COUNT]Step;
}

val ADDRESSED: Need = Need{arch: arch.ADDRESSED};

val PHASES: [PHASE_COUNT]Phase = [PHASE_COUNT]Phase{
    Phase{name: "gather", run: gather_phase},
    Phase{name: "settle", run: settle_phase},
    Phase{name: "synthesize before resolve", run: synthesize_before_resolve},
    Phase{name: "resolve", run: resolve_phase},
    Phase{name: "synthesize after resolve", run: synthesize_after_resolve},
    Phase{name: "collect", run: collect_phase},
    Phase{name: "fold", run: fold_phase},
    Phase{name: "synthesize after collect", run: synthesize_after_collect},
    Phase{name: "bounds", needs: ADDRESSED, run: bounds_phase},
    Phase{name: "dynamic", needs: ADDRESSED, run: dynamic_phase},
    Phase{name: "assign", needs: Need{link: linking.INDEXED_LAYOUT}, run: assign_phase},
    Phase{name: "merge", needs: ADDRESSED, run: merge_phase},
    Phase{name: "reserve", needs: ADDRESSED, run: reserve_phase},
    Phase{name: "layout", needs: ADDRESSED, run: layout_phase},
    Phase{name: "relocate", needs: ADDRESSED, run: relocate_phase},
    Phase{name: "write", run: write_phase},
};

pub fun phase_at(index: usize) *Phase {
    ret ?PHASES[index];
}

# whether the link of `st` declares everything the phase `p` needs
pub fun applies(st: *State, p: *Phase) bool {
    if (!arch.has(st.options.target.arch, p.needs.arch))  { ret false; }
    if ((st.linking.caps & p.needs.link) != p.needs.link) { ret false; }
    ret output.has(st.options.kind, p.needs.output);
}

# make the state of a link at `st` through the formats of `g`, which stays
# where it is until released. the state is released by release whether or
# not opening it succeeds
pub fun open(st: *State, a: *A.Allocator, g: *Registry, o: Options) err[Fail] {
    @st = State{
        a:         a,
        options:   o,
        registry:  g,
        names:     intern.make(a),
        inputs:    input.make(a),
        settled:   settle.make(a),
        resolved:  resolve.make(a),
        live:      collect.make(a),
        folded:    fold.make(a),
        dynamic:   dynamic.make(a),
        assigned:  assign.make(a),
        merging:   pieces.make(a),
        reserved:  reserve.make(a),
        placing:   layout.constraints(a),
        adjusted:  adjust.make(a),
        layout:    layout.make(a),
        sites:     sites.make(a),
        relocated: relocate.make(a),
        output:    sink.make(a, LITTLE),
    };
    if (!output.builds(o.kind, o.format)) {
        ret err[Fail].err{fail.in_record(fail.unsupported("the output format cannot build this output kind"), o.kind.name)};
    }
    val system: opt[*System] = o.target.system;
    if (sel system.none) { ret err[Fail].err{fail.unsupported("the link names no system")}; }
    st.system = system.some;
    if (!os.accepts(system.some, o.format)) {
        ret err[Fail].err{fail.in_record(fail.unsupported("the system does not take this output format"), o.format.name)};
    }
    if (!os.runs(system.some, o.target.env, o.target.arch)) {
        ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the system does not run this architecture"), system.some.name), o.target.arch.name)};
    }
    val out: res[*Registration, Fail] = registry.by_format(g, o.format);
    if (sel out.err) { ret err[Fail].err{out.err}; }
    val written: res[*Linking, Fail] = registration.linking(out.ok);
    if (sel written.err) { ret err[Fail].err{written.err}; }
    st.writer = written.ok.writer;
    val reg: res[*Registration, Fail] = registry.links_of(g, out.ok);
    if (sel reg.err) { ret err[Fail].err{reg.err}; }
    st.registration = reg.ok;
    val l: res[*Linking, Fail] = registration.linking(reg.ok);
    if (sel l.err) { ret err[Fail].err{l.err}; }
    st.linking = l.ok;
    val p: res[*Pair, Fail] = registration.pair_of(reg.ok, o.target.arch);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    st.pair = p.ok;
    val kept: opt[bool] = o.keep_temporaries;
    if (sel p.ok.temporaries.none) {
        if (sel kept.some) {
            if (!kept.some) { ret err[Fail].err{fail.about(fail.unsupported("the format names no temporary symbols for this architecture"), o.target.arch.name)}; }
        }
    }
    val relocs: res[*row.Lookup, Fail] = row.find(?g.relocs, reg.ok.format, o.target.arch);
    if (sel relocs.err) { ret err[Fail].err{relocs.err}; }
    st.relocs = relocs.ok;
    if (o.state != nil) {
        ret err[Fail].err{fail.unsupported("keeping a link state file is not supported yet")};
    }
    ret placed(st);
}

# the placement constraints the options state: the memory regions, and one
# constraint for each section they place, gathering its rank among the
# sections placed ahead of the rest in the order they name them, the region
# it runs in, the region it loads in and its offset. a section given one of
# these twice is refused, naming it
fun placed(st: *State) err[Fail] {
    if (st.options.section_count > 0xffff_ffff) { ret err[Fail].err{fail.overflow("the link places more sections than a rank reaches")}; }
    st.placing.size = st.options.size;
    var i: usize = 0;
    for (i < st.options.region_count) {
        val r:  *Area               = ?st.options.regions[i];
        val id: res[Id[Name], Fail] = intern.intern_str(?st.names, r.name);
        if (sel id.err) { ret err[Fail].err{id.err}; }
        val p: res[Id[layout.Region], Fail] = table.push[layout.Region](?st.placing.regions, layout.Region{name: id.ok, start: r.origin, size: r.length, access: r.access});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    var by: MapBy[u32, u32] = map.init_by[u32, u32](st.a, name_hash, name_equal);
    val e:  err[Fail]       = gathered(st, ?by);
    val d:  err[A.Error]    = map.dnit_by[u32, u32](?by);
    if (sel e.err) { ret e; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}

fun name_hash(k: *u32) u64 {
    ret fnv1a.step_u32(fnv1a.FNV_INIT, @k);
}

fun name_equal(a: *u32, b: *u32) bool {
    ret @a == @b;
}

fun gathered(st: *State, by: *MapBy[u32, u32]) err[Fail] {
    val o: *Options = ?st.options;
    var i: usize    = 0;
    for (i < o.section_count) {
        val c: res[*Constraint, Fail] = constraint_of(st, by, o.sections[i]);
        if (sel c.err) { ret err[Fail].err{c.err}; }
        val k:     *Constraint = c.ok;
        val prior: opt[u32]    = k.order;
        if (sel prior.some) { ret twice(o.sections[i], "a section is placed ahead of the rest more than once"); }
        k.order = opt[u32].some{i::u32};
        i       = i + 1;
    }
    i = 0;
    for (i < o.run_count) {
        val w: *Within                = ?o.runs[i];
        val c: res[*Constraint, Fail] = constraint_of(st, by, w.section);
        if (sel c.err) { ret err[Fail].err{c.err}; }
        val k:     *Constraint            = c.ok;
        val prior: opt[Id[layout.Region]] = k.region;
        if (sel prior.some) { ret twice(w.section, "a section is stated to run in more than one region"); }
        k.region = opt[Id[layout.Region]].some{Id[layout.Region]{index: w.region::u32}};
        i        = i + 1;
    }
    i = 0;
    for (i < o.load_count) {
        val w: *Within                = ?o.loads[i];
        val c: res[*Constraint, Fail] = constraint_of(st, by, w.section);
        if (sel c.err) { ret err[Fail].err{c.err}; }
        val k:     *Constraint            = c.ok;
        val prior: opt[Id[layout.Region]] = k.load;
        if (sel prior.some) { ret twice(w.section, "a section is stated to load in more than one region"); }
        k.load = opt[Id[layout.Region]].some{Id[layout.Region]{index: w.region::u32}};
        i      = i + 1;
    }
    i = 0;
    for (i < o.offset_count) {
        val f: *Offset                = ?o.offsets[i];
        val c: res[*Constraint, Fail] = constraint_of(st, by, f.section);
        if (sel c.err) { ret err[Fail].err{c.err}; }
        val k:     *Constraint = c.ok;
        val prior: opt[u64]    = k.offset;
        if (sel prior.some) { ret twice(f.section, "a section is stated at more than one offset"); }
        k.offset = opt[u64].some{f.offset};
        i        = i + 1;
    }
    ret err[Fail].ok{};
}

fun twice(section: str, why: str) err[Fail] {
    ret err[Fail].err{fail.about(fail.malformed(why), section)};
}

# the constraint on the output sections named `name`, made empty the first
# time a statement names them
fun constraint_of(st: *State, by: *MapBy[u32, u32], name: str) res[*Constraint, Fail] {
    val id: res[Id[Name], Fail] = intern.intern_str(?st.names, name);
    if (sel id.err) { ret res[*Constraint, Fail].err{id.err}; }
    var key:   u32       = id.ok.index;
    val found: opt[*u32] = map.get_by[u32, u32](by, ?key);
    if (sel found.some) { ret res[*Constraint, Fail].ok{table.at[Constraint](?st.placing.sections, table.nth[Constraint]((@found.some)::usize))}; }
    val c: res[Id[Constraint], Fail] = table.push[Constraint](?st.placing.sections, Constraint{section: id.ok, spelling: name});
    if (sel c.err) { ret res[*Constraint, Fail].err{c.err}; }
    val put: res[bool, A.Error] = map.insert_by[u32, u32](by, key, c.ok.index);
    if (sel put.err) { ret res[*Constraint, Fail].err{fail.refused(put.err)}; }
    ret res[*Constraint, Fail].ok{table.at[Constraint](?st.placing.sections, c.ok)};
}

# link the `count` sources at `sources`, running every phase in order and
# writing to `notes` what a refusal cannot carry, both borrowed for as long as
# the state lives
pub fun run(st: *State, sources: *Source, count: usize, notes: *Sink) err[Fail] {
    st.sources = sources;
    st.count   = count;
    st.notes   = notes;
    ret drive(st, ?PHASES[0], PHASE_COUNT);
}

# lay the image out again after a later phase grew a table, every address
# read back afresh
pub fun relayout(st: *State) err[Fail] {
    layout.clear(?st.layout);
    val row: *Phase = ?PHASES[LAYOUT];
    if (!applies(st, row)) { ret err[Fail].ok{}; }
    ret row.run(st);
}

# the image's bytes, which the caller owns from now on
pub fun take(st: *State) Sink {
    val out: Sink = st.output;
    st.output = sink.make(st.a, LITTLE);
    ret out;
}

# give back everything the link built, reporting the first refusal. releasing
# again gives back nothing
pub fun release(st: *State) err[Fail] {
    var first: err[Fail] = sink.release(?st.output);
    first = fail.kept(first, relocate.release(?st.relocated));
    first = fail.kept(first, sites.release(?st.sites));
    first = fail.kept(first, layout.release(?st.layout));
    first = fail.kept(first, adjust.release(?st.adjusted));
    first = fail.kept(first, layout.release_constraints(?st.placing));
    first = fail.kept(first, reserve.release(?st.reserved));
    first = fail.kept(first, pieces.release(?st.merging));
    first = fail.kept(first, assign.release(?st.assigned));
    first = fail.kept(first, dynamic.release(?st.dynamic));
    first = fail.kept(first, fold.release(?st.folded));
    first = fail.kept(first, collect.release(?st.live));
    first = fail.kept(first, resolve.release(?st.resolved));
    first = fail.kept(first, settle.release(?st.settled));
    first = fail.kept(first, input.release(?st.inputs));
    ret fail.kept(first, intern.release(?st.names));
}

# append to `out` the link's report of what it did that its image does not
# show, a line for each trait axis it dropped
pub fun report(st: *State, out: *Sink) err[Fail] {
    ret settle.report(?st.settled, ?st.inputs, out);
}

# link the `count` sources at `sources` through the formats of `g` in one
# call, returning the image's bytes and appending the link's report to
# `notes`, or when the link is refused, what its refusal cannot carry
pub fun link(a: *A.Allocator, g: *Registry, o: Options, sources: *Source, count: usize, notes: *Sink) res[Sink, Fail] {
    var st:     State;
    val opened: err[Fail] = open(?st, a, g, o);
    var ran:    err[Fail] = opened;
    if (sel opened.ok) { ran = run(?st, sources, count, notes); }
    var told: err[Fail] = ran;
    if (sel ran.ok) { told = report(?st, notes); }
    var out:   Sink      = take(?st);
    val rel:   err[Fail] = release(?st);
    val first: err[Fail] = fail.kept(told, rel);
    if (sel first.ok) { ret res[Sink, Fail].ok{out}; }
    val reported: err[Fail] = fail.kept(first, sink.release(?out));
    if (sel reported.err) { ret res[Sink, Fail].err{reported.err}; }
    ret res[Sink, Fail].err{first.err};
}

fun drive(st: *State, rows: *Phase, count: usize) err[Fail] {
    var i: usize = 0;
    for (i < count) {
        st.phase = i;
        if (!applies(st, ?rows[i])) {
            st.steps[i] = Step.inapplicable{};
            i           = i + 1;
            cnt;
        }
        val r: err[Fail] = rows[i].run(st);
        if (sel r.err) {
            st.steps[i] = Step.failed{};
            ret r;
        }
        st.steps[i] = Step.ran{};
        i           = i + 1;
    }
    ret err[Fail].ok{};
}

fun gather_phase(st: *State) err[Fail] {
    var in: gather.In = gather.In{
        readers:  ?st.registry.readers,
        format:   st.registration.format,
        lowering: st.registration.lowering,
        neutral:  st.registration.neutral,
        mapping:  st.pair.mapping,
        relocs:   ?st.registry.relocs,
        arch:     st.options.target.arch,
        sources:  st.sources,
        count:    st.count,
    };
    ret gather.run(?in, ?st.inputs);
}

# settle the inputs, then take the host the merged traits choose, once,
# refusing an output kind its loader cannot run
fun settle_phase(st: *State) err[Fail] {
    var in: settle.In = settle.In{inputs: ?st.inputs, arch: st.options.target.arch, format: st.registration.format, facts: st.linking.facts, uses: ?st.linking.uses};
    val r:  err[Fail] = settle.run(?in, ?st.settled);
    if (sel r.err)      { ret r; }
    if (st.host != nil) { ret settle.admit(st.host, ?st.settled.traits); }
    val h: res[*Host, Fail] = os.host(st.system, st.options.target.env, st.options.target.arch, ?st.settled.traits);
    if (sel h.err) { ret err[Fail].err{h.err}; }
    val placed: err[Fail] = os.places(h.ok, st.options.kind);
    if (sel placed.err) { ret placed; }
    st.host = h.ok;
    ret settle.admit(st.host, ?st.settled.traits);
}

# settle the inputs a phase that ran as `r` appended, so the settled record
# covers every input before the next phase reads it
fun settled_after(st: *State, r: err[Fail]) err[Fail] {
    if (sel r.err) { ret r; }
    ret settle_phase(st);
}

fun synthesize_before_resolve(st: *State) err[Fail] {
    var in: synthesize.In = synthesize.In{context: context(st), resolve: nil, rows: ?st.linking.synthesizers};
    ret settled_after(st, synthesize.run(?in, ?st.synthesized, ?synthesizer.BEFORE_RESOLVE));
}

fun synthesize_after_resolve(st: *State) err[Fail] {
    var again: resolve.In;
    val r:     err[Fail] = resolving(st, ?again);
    if (sel r.err) { ret r; }
    var in: synthesize.In = synthesize.In{context: context(st), resolve: ?again, rows: ?st.linking.synthesizers};
    in.context.resolved = ?st.resolved;
    ret settled_after(st, synthesize.run(?in, ?st.synthesized, ?synthesizer.AFTER_RESOLVE));
}

fun synthesize_after_collect(st: *State) err[Fail] {
    var again: resolve.In;
    val r:     err[Fail] = resolving(st, ?again);
    if (sel r.err) { ret r; }
    var in: synthesize.In = synthesize.In{context: context(st), resolve: ?again, rows: ?st.linking.synthesizers};
    in.context.resolved = ?st.resolved;
    in.context.live     = ?st.live;
    ret settled_after(st, synthesize.run(?in, ?st.synthesized, ?synthesizer.AFTER_COLLECT));
}

# what the synthesizers read of the link so far, whose answers a stage adds
fun context(st: *State) Context {
    ret Context{
        inputs:  ?st.inputs,
        names:   ?st.names,
        settled: ?st.settled,
        kind:    st.options.kind,
        target:  ?st.options.target,
        host:    st.host,
        base:    base_of(st),
        pair:    st.pair,
        options: ?st.options,
        commons: commons_of(st),
    };
}

# the output section the format's layout allocates common blocks in
fun commons_of(st: *State) str {
    if (sel st.linking.layout.some) { ret st.linking.layout.some.commons; }
    ret "";
}

# the resolve phase's input, which extending resolution after a stage reads
# too
fun resolving(st: *State, in: *resolve.In) err[Fail] {
    @in = resolve.In{
        inputs:  ?st.inputs,
        names:   ?st.names,
        readers: ?st.registry.readers,
        relocs:  ?st.registry.relocs,
        arch:    st.options.target.arch,
        kind:    st.options.kind,
        search:  st.linking.search,
        hooks:   st.linking.hooks,
        bounds:  st.linking.bounds,
        notes:   st.notes,
    };
    ret err[Fail].ok{};
}

fun resolve_phase(st: *State) err[Fail] {
    var in: resolve.In;
    val r:  err[Fail] = resolving(st, ?in);
    if (sel r.err) { ret r; }
    ret settled_after(st, resolve.run(?in, ?st.resolved));
}

# the entry symbol of the link: the options', or the host's for the output
# kind where they name none, for a kind that has one
fun entry_of(st: *State) str {
    val o: *Options = ?st.options;
    if (!output.has(o.kind, output.ENTERED)) { ret nil; }
    if (o.entry != nil)                      { ret o.entry; }
    ret os.entry(st.host, o.kind);
}

fun collect_phase(st: *State) err[Fail] {
    var in: collect.In = collect.In{
        inputs:      ?st.inputs,
        names:       ?st.names,
        resolved:    ?st.resolved,
        kind:        st.options.kind,
        entry:       entry_of(st),
        keep:        st.options.keep,
        keep_count:  st.options.keep_count,
        calls:       st.linking.calls,
        collects:    collects_of(st),
        superseding: st.linking.superseding,
        leaving:     st.linking.leaving,
    };
    ret collect.run(?in, ?st.live);
}

# whether the link collects what nothing reaches: as the options state, else
# as the output format's link does
fun collects_of(st: *State) bool {
    val stated: opt[bool] = st.options.gc_sections;
    if (sel stated.some) { ret stated.some; }
    ret st.linking.collects;
}

fun fold_phase(st: *State) err[Fail] {
    var in: fold.In = fold.In{
        inputs:   ?st.inputs,
        resolved: ?st.resolved,
        live:     ?st.live,
        relocs:   st.relocs,
        arch:     st.options.target.arch,
        rules:    ?st.linking.folds,
    };
    ret fold.run(?in, ?st.folded);
}

fun assign_phase(st: *State) err[Fail] {
    var in: assign.In = assign.In{
        inputs:   ?st.inputs,
        resolved: ?st.resolved,
        live:     ?st.live,
        folded:   ?st.folded,
        relocs:   st.relocs,
        arch:     st.options.target.arch,
        stubs:    (st.linking.caps & linking.WEAK_STUBS) != 0,
    };
    ret assign.run(?in, ?st.assigned);
}

fun merge_phase(st: *State) err[Fail] {
    var in: link_merge.In = link_merge.In{inputs: ?st.inputs, names: ?st.names, live: ?st.live, resolved: ?st.resolved, relocs: st.relocs, rules: st.linking.layout, tails: tails_of(st)};
    ret link_merge.run(?in, ?st.merging);
}

# the address the image is laid out from: as the options state, else the
# host's
fun base_of(st: *State) u64 {
    val stated: opt[u64] = st.options.base;
    if (sel stated.some) { ret stated.some; }
    ret st.host.image_base;
}

# whether merged strings share tails: as the options state, else as the
# output format's link does
fun tails_of(st: *State) bool {
    val stated: opt[bool] = st.options.tail_merge;
    if (sel stated.some) { ret stated.some; }
    ret st.linking.tails;
}

# settle each name the link defines at an output section before dynamic
# decides how each name is reached: one at a section no kept section is laid
# into stays undefined when only weak references reach it, and is refused
# otherwise. a format that lays out no image has no output section, and
# layout refuses it
fun bounds_phase(st: *State) err[Fail] {
    val rules: opt[*layout.Rules] = st.linking.layout;
    if (sel rules.none)                   { ret err[Fail].ok{}; }
    if (!resolve.sectioned(?st.resolved)) { ret err[Fail].ok{}; }
    var landed: Table[bool] = table.make[bool](st.a);
    val r:      err[Fail]   = unplaced(st, rules.some, ?landed);
    ret fail.kept(r, table.release[bool](?landed));
}

fun unplaced(st: *State, rules: *layout.Rules, landed: *Table[bool]) err[Fail] {
    val l: err[Fail] = layout.landed(?st.names, rules, ?st.inputs, ?st.live, landed);
    if (sel l.err) { ret l; }
    ret resolve.unplaced(?st.resolved, ?st.names, landed, st.notes);
}

fun dynamic_phase(st: *State) err[Fail] {
    val host: res[os.Caps, Fail] = os.caps_of(st.host, st.options.target.version);
    if (sel host.err) { ret err[Fail].err{host.err}; }
    var in: dynamic.In = dynamic.In{
        inputs:    ?st.inputs,
        names:     ?st.names,
        resolved:  ?st.resolved,
        live:      ?st.live,
        kind:      st.options.kind,
        arch:      st.options.target.arch,
        rules:     st.linking.dynamic,
        relocs:    st.relocs,
        loads_all: st.linking.loads_all,
        runtime:   st.linking.runtime,
        host:      host.ok,
        system:    st.host,
        maker:     st.linking.maker,
        traits:    ?st.settled.traits,
    };
    ret dynamic.run(?in, ?st.dynamic);
}

fun reserve_phase(st: *State) err[Fail] {
    var in: reserve.In = reserve.In{
        inputs:    ?st.inputs,
        names:     ?st.names,
        facts:     ?st.settled.facts,
        store:     ?st.settled.store,
        traits:    ?st.settled.traits,
        consumed:  ?st.settled.consumed,
        resolved:  ?st.resolved,
        live:      ?st.live,
        dynamic:   ?st.dynamic,
        kind:      st.options.kind,
        format:    st.registration.format,
        arch:      st.options.target.arch,
        relocs:    st.relocs,
        templates: st.pair.templates,
        host:      st.host,
        sign:      st.options.sign,
        got:       st.pair.got,
        declarers: st.linking.declarers,
    };
    ret reserve.run(?in, ?st.reserved);
}

# list the loader relocation sites, lay the image out, then measure each
# measured table from it, laying it out again while a size changes, refused
# once the passes reach the limit. layout places every surviving section, so
# a link that folded any is refused
fun layout_phase(st: *State) err[Fail] {
    if (table.count[fold.Fold](?st.folded.folds) != 0) { ret err[Fail].err{fail.unsupported("laying out an image with folded sections is not supported yet")}; }
    var sin: sites.In  = sites.In{inputs: ?st.inputs, dynamic: ?st.dynamic, pieces: ?st.merging, reserved: ?st.reserved, arch: st.options.target.arch};
    val e:   err[Fail] = sites.run(?sin, ?st.sites);
    if (sel e.err) { ret e; }
    var passes: u32 = 0;
    for {
        val r: err[Fail] = laid_out(st);
        if (sel r.err) { ret r; }
        passes = passes + 1;
        val moved: res[bool, Fail] = remeasure(st);
        if (sel moved.err)           { ret err[Fail].err{moved.err}; }
        if (!moved.ok)               { ret err[Fail].ok{}; }
        if (passes >= layout.PASSES) { ret err[Fail].err{fail.overflow("the measured tables do not settle within the pass limit")}; }
        layout.clear(?st.layout);
    }
    ret err[Fail].ok{};
}

# measure each measured table from the image as laid out, true when a size
# changed. a table at the end of the file moves no other byte, so the image
# writer measures it where the file ends
fun remeasure(st: *State) res[bool, Fail] {
    val img: res[Image, Fail] = image_of(st);
    if (sel img.err) { ret res[bool, Fail].err{img.err}; }
    st.image = img.ok;
    var moved: bool  = false;
    var i:     usize = 0;
    for (i < table.count[reserve.Reservation](?st.reserved.tables)) {
        val t:  Id[reserve.Reservation] = table.nth[reserve.Reservation](i);
        val rv: *reserve.Reservation    = table.at[reserve.Reservation](?st.reserved.tables, t);
        val m:  opt[*reserve.Measure]   = rv.measure;
        i = i + 1;
        if (sel m.none)                { cnt; }
        if (sel rv.placement.file_end) { cnt; }
        val by: res[*Measured, Fail] = measure_of(st.linking, m.some);
        if (sel by.err) { ret res[bool, Fail].err{by.err}; }
        val size: res[u64, Fail] = by.ok.measure(?st.image);
        if (sel size.err) { ret res[bool, Fail].err{fail.in_record(size.err, m.some.name)}; }
        val c: res[bool, Fail] = reserve.measured(?st.reserved, t, size.ok);
        if (sel c.err) { ret c; }
        if (c.ok)      { moved = true; }
    }
    ret res[bool, Fail].ok{moved};
}

# the output format's measure of the key `k`
fun measure_of(l: *Linking, k: *reserve.Measure) res[*Measured, Fail] {
    var i: usize = 0;
    for (i < l.measures.count) {
        if (l.measures.rows[i].key == k) { ret res[*Measured, Fail].ok{?l.measures.rows[i]}; }
        i = i + 1;
    }
    ret res[*Measured, Fail].err{fail.about(fail.internal("the output format binds no measure to a measured table's key"), k.name)};
}

# lay the image out by the output format's layout rules, refused for a format
# that states none
fun laid_out(st: *State) err[Fail] {
    val rules: opt[*layout.Rules] = st.linking.layout;
    if (sel rules.none) { ret err[Fail].err{fail.in_record(fail.unsupported("the output format lays out no image"), st.registration.format.name)}; }
    var in: layout.In = layout.In{
        inputs:       ?st.inputs,
        names:        ?st.names,
        resolved:     ?st.resolved,
        live:         ?st.live,
        pieces:       ?st.merging,
        reserved:     ?st.reserved,
        kind:         st.options.kind,
        target:       ?st.options.target,
        host:         st.host,
        base:         base_of(st),
        rules:        rules.some,
        thread:       st.pair.thread,
        constraints:  ?st.placing,
        participants: st.linking.participants,
        adjusted:     ?st.adjusted,
        relocs:       st.relocs,
        dynamic:      ?st.dynamic,
        traits:       ?st.settled.traits,
        templates:    st.pair.templates,
        assigned:     ?st.assigned,
        weak:         st.linking.weak,
        limit:        layout.PASSES,
    };
    val r: err[Fail] = layout.run(?in, ?st.layout);
    if (sel r.ok) { ret r; }
    ret fail.kept(r, parties(st));
}

# write to the notes a line naming each party of each placement the layout
# was refused over, a refusal about one section naming it once
fun parties(st: *State) err[Fail] {
    val at: Location = Location{record: "placement"};
    var i:  usize    = 0;
    for (i < table.count[layout.Conflict](?st.layout.conflicts)) {
        val c: *layout.Conflict = table.at[layout.Conflict](?st.layout.conflicts, table.nth[layout.Conflict](i));
        val w: err[Fail]        = diag.note_named(at, intern.bytes_of(?st.names, c.first), "a party of the refused placement", st.notes);
        if (sel w.err) { ret w; }
        if (c.second.index != c.first.index) {
            val v: err[Fail] = diag.note_named(at, intern.bytes_of(?st.names, c.second), "a party of the refused placement", st.notes);
            if (sel v.err) { ret v; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun relocate_phase(st: *State) err[Fail] {
    var in: relocate.In = relocate.In{
        inputs:    ?st.inputs,
        resolved:  ?st.resolved,
        reserved:  ?st.reserved,
        dynamic:   ?st.dynamic,
        assigned:  ?st.assigned,
        pieces:    ?st.merging,
        layout:    ?st.layout,
        adjusted:  ?st.adjusted,
        kind:      st.options.kind,
        arch:      st.options.target.arch,
        relocs:    st.relocs,
        templates: st.pair.templates,
        traits:    ?st.settled.traits,
        weak:      st.linking.weak,
        live:      ?st.live,
        sites:     ?st.sites,
    };
    ret relocate.run(?in, ?st.relocated);
}

fun write_phase(st: *State) err[Fail] {
    val img: res[Image, Fail] = image_of(st);
    if (sel img.err) { ret err[Fail].err{img.err}; }
    st.image = img.ok;
    var in: write.In = write.In{a: st.a, writer: st.writer, image: ?st.image};
    ret write.run(?in, ?st.output);
}

# the image record of the link as far as its phases got, its entry resolved
# from the layout as it stands
fun image_of(st: *State) res[Image, Fail] {
    val entry: res[image.Entry, Fail] = image.entry_of(st.options.kind, entry_of(st), ?st.inputs, ?st.names, ?st.resolved, ?st.assigned, ?st.layout);
    if (sel entry.err) { ret res[Image, Fail].err{entry.err}; }
    ret res[Image, Fail].ok{Image{
        kind:      st.options.kind,
        format:    st.options.format,
        target:    ?st.options.target,
        host:      st.host,
        entry:     entry.ok,
        inputs:    ?st.inputs,
        names:     ?st.names,
        settled:   ?st.settled,
        resolved:  ?st.resolved,
        live:      ?st.live,
        folded:    ?st.folded,
        dynamic:   ?st.dynamic,
        assigned:  ?st.assigned,
        pieces:    ?st.merging,
        reserved:  ?st.reserved,
        layout:    ?st.layout,
        sites:     ?st.sites,
        relocated: ?st.relocated,
        relocs:    st.relocs,
        templates: st.pair.templates,
        mapping:   st.pair.mapping,
        temporary: temporary_of(st),
        output:    st.options.output,
        compress:  st.options.compress,
        size:      st.options.size,
        fill:      st.options.fill,
    }};
}

# the start of the names of the temporary symbols the image leaves out: the
# pair's when the options or, failing them, the pair discard them
fun temporary_of(st: *State) opt[str] {
    val t: opt[*Temporaries] = st.pair.temporaries;
    if (sel t.none) { ret opt[str].none{}; }
    var discarded: bool      = t.some.discarded;
    val kept:      opt[bool] = st.options.keep_temporaries;
    if (sel kept.some) { discarded = !kept.some; }
    if (!discarded)    { ret opt[str].none{}; }
    ret opt[str].some{t.some.prefix};
}
