# the relocate phase: every relocation of a surviving section is applied to
# the bytes of the output section it landed in
#
# the bytes of every surviving input section are copied to where layout put
# them, the atoms collection dropped cut out, and each kept piece of a merged
# section to its place in its group's block. each relocation then finds its
# row in the set of the output format and architecture by its neutral kind,
# takes its addresses from the layout, the addresses of the GOT slot, PLT entry
# or copy its decision reaches, the thread-local anchors and the index of its
# target's output section from the records that publish them, the index of its
# target from the assign phase where it computes one, and is applied through
# the relocation engine. a relocation the loader binds is left alone, one it
# moves is patched with its static value, and one whose target lies in
# dropped code or has no address in the image is refused, unless it is in
# debug information, which only describes code and is left as it is, or
# given the tombstone, every bit set, where it writes an absolute address
# alone, so a consumer skips what it describes. a pair whose one half is left
# so leaves its other half as well, as their field holds one value of both. a relocation to an index space entry takes
# the entry's index in the output. a function table slot stands for its
# target, so a reference that reaches one takes the slot's address as its
# target's. an undefined weak
# reference resolves by the format's rule. a reference by a section symbol
# names the byte its addend counts to as the format holds it, so one into a
# merged section reaches that byte of the copy kept for it. a relocation of
# a merged piece is applied only where the piece is kept, the copy that
# holds another piece carrying its own. a relocatable
# output keeps its relocations, so its bytes are copied and not patched.
#
# each slot of a table the format states as holding its target's address is
# written with that address, unless the loader binds it, whose image writer
# encodes the bind. each entry of a table of code is its role's template,
# patched through the pair's relocation rows with its own address and the
# address of the entry it lands in. a relocation a layout participant sent
# through a veneer reaches the veneer, and each veneer is its table's
# template led to where it leads. the address of every loader relocation
# site is filled in last.
#
# the padding alignment leaves between two sections of unwind records reads
# as a terminator, so the record before it is restated to run across it, its
# zero bytes being call frame no-ops.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use std.encoding.binary;
use std.memory;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.base.vectors;
use mink.bytes.reader;
use mink.bytes.reader.Reader;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.kind;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.catalog.slot;
use mink.catalog.slot.SlotRole;
use mink.catalog.trait.Trait;
use mink.link.adjust;
use mink.link.adjust.Adjusted;
use mink.link.assign.Assigned;
use mink.link.collect;
use mink.link.collect.Live;
use mink.link.collect.Ref;
use mink.link.dynamic;
use mink.link.dynamic.Decision;
use mink.link.dynamic.Dynamic;
use mink.link.input;
use mink.link.input.Input;
use mink.link.input.Inputs;
use mink.link.layout;
use mink.link.layout.Cut;
use mink.link.layout.Landing;
use mink.link.layout.Layout;
use mink.link.layout.Merged;
use mink.link.pieces;
use mink.link.pieces.Piece;
use mink.link.pieces.Pieces;
use mink.link.reserve;
use mink.link.reserve.Reserved;
use mink.link.resolve;
use mink.link.resolve.Resolved;
use mink.link.resolve.Weak;
use link_rows: mink.link.rows;
use mink.link.rows.Rows;
use mink.link.sites;
use mink.link.sites.Sites;
use mink.link.template;
use mink.link.value;
use mink.lower.unwind.parse;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Reloc;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.reloc;
use mink.model.section;
use mink.model.target;
use mink.reloc.compute;
use mink.reloc.engine;
use mink.reloc.engine.Mark;
use mink.reloc.engine.Site;
use mink.reloc.row;
use mink.reloc.row.Lookup;
use mink.reloc.row.Pairing;
use mink.reloc.row.Row;

# dynamic:   what each relocation needs, which says whether the loader
#            applies it
# assigned:  the index every entry and symbol reaches, which a relocation
#            that computes an index reads
# pieces:    the pieces of the merged sections and the copies kept
# kind:      the output kind, whose relocatable outputs keep their relocations
# arch:      the architecture
# relocs:    the relocation rows of the output pair
# rows:      the rows each object's relocations are read through
# templates: the code templates of the output pair, which fill the code
#            entries, none for a pair with none
# traits:    the settled traits, which choose each template's form
# weak:      how the format resolves an undefined weak reference
# live:      what collection kept, whose kept FDEs name their CIEs
# sites:     the loader relocation sites, whose addresses this phase fills in
pub rec In {
    inputs:    *Inputs;
    resolved:  *Resolved;
    reserved:  *Reserved;
    dynamic:   *Dynamic;
    assigned:  *Assigned;
    pieces:    *Pieces;
    layout:    *Layout;
    adjusted:  *Adjusted;
    kind:      *Kind;
    arch:      *Arch;
    relocs:    *Lookup;
    rows:      *Rows;
    templates: opt[*template.Set];
    traits:    *Vector[Trait];
    weak:      Weak;
    live:      *Live;
    sites:     *Sites;
}

# a debug relocation whose target lies in dropped code or has no address in
# the image, left as it was or given the tombstone
# ---
# input:   the input holding it
# section: the section it patches
# offset:  its offset in that section
# kind:    the debug section's kind
pub rec Dead {
    input:   Id[Input];
    section: Id[Section];
    offset:  u64;
    kind:    *section.Kind;
}

# bytes: the contents of the output sections, relocated, each at its file
#        offset
# dead:  the relocations of debug information whose target lies in dropped
#        code or has no address in the image
pub rec Relocated {
    bytes: Vector[u8];
    dead:  Vector[Dead];
}

pub fun init(a: *A.Allocator) Relocated {
    ret Relocated{bytes: vector.init[u8](a), dead: vector.init[Dead](a)};
}

# a relocation of one section in the order they are applied
rec Item {
    section: u32;
    reloc:   u32;
}

# a relocation ready to apply
# ---
# row:    its row
# x:      the addresses its value is computed from
# at:     the file offset of its field
# room:   the bytes from its field to the end of its section's bytes
# offset: its offset in the input section
# dead:   it is in debug information and its target lies in dropped code or
#         has no address in the image, so it is left as it was or given the
#         tombstone. it is queued so its partner finds it and is left with it
# first:  it is the record of a difference applied first, which only the
#         record after it completes
# alone:  it writes its field by itself, neither half of a difference nor
#         paired with a partner
rec Prep {
    row:    *Row;
    x:      compute.Inputs;
    at:     u64;
    room:   u64;
    offset: u64;
    dead:   bool;
    first:  bool;
    alone:  bool;
}

rec Context {
    in:    *In;
    from:  value.Sources;
    out:   *Relocated;
    items: Vector[Item];
    preps: Vector[Prep];
    marks: Vector[Mark];
    slots: Vector[engine.Slot];
}

# copy the surviving bytes to their places and apply every relocation of the
# surviving sections. running again starts afresh
pub fun run(in: *In, out: *Relocated) err[Fail] {
    vector.clear[u8](?out.bytes);
    vector.clear[Dead](?out.dead);
    val a: *A.Allocator = in.inputs.a;
    var c: Context      = Context{
        in:   in,
        from: value.Sources{
            inputs:   in.inputs,
            resolved: in.resolved,
            reserved: in.reserved,
            assigned: in.assigned,
            pieces:   in.pieces,
            layout:   in.layout,
            arch:     in.arch,
            weak:     in.weak,
        },
        out:   out,
        items: vector.init[Item](a),
        preps: vector.init[Prep](a),
        marks: vector.init[Mark](a),
        slots: vector.init[engine.Slot](a),
    };
    var err_first: err[Fail] = work(?c);
    err_first = fail.kept(err_first, vectors.dnit[Item](?c.items));
    err_first = fail.kept(err_first, vectors.dnit[Prep](?c.preps));
    err_first = fail.kept(err_first, vectors.dnit[Mark](?c.marks));
    ret fail.kept(err_first, vectors.dnit[engine.Slot](?c.slots));
}

pub fun dnit(r: *Relocated) err[Fail] {
    val err_release: err[Fail] = vectors.dnit[u8](?r.bytes);
    ret fail.kept(err_release, vectors.dnit[Dead](?r.dead));
}

fun work(c: *Context) err[Fail] {
    val l:        *Layout          = c.in.layout;
    val res_size: res[usize, Fail] = checked.to_usize(Location{record: "image"}, l.end);
    if (sel res_size.err) { ret err[Fail].err{res_size.err}; }
    val err_grow: err[Fail] = vectors.grow[u8](?c.out.bytes, res_size.ok);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < table.count[Landing](?l.landings)) {
        val land: *Landing = table.at[Landing](?l.landings, table.nth[Landing](i));
        i = i + 1;
        val opt_member: opt[Id[pieces.Member]] = pieces.member_of(c.in.pieces, land.at);
        if (sel opt_member.some) { cnt; }
        val err_copy_landing: err[Fail] = copy_landing(c, land);
        if (sel err_copy_landing.err) { ret err_copy_landing; }
    }
    val err_kept: err[Fail] = copy_pieces(c);
    if (sel err_kept.err) { ret err_kept; }
    val err_edited: err[Fail] = write_edits(c);
    if (sel err_edited.err) { ret err_edited; }
    val err_led: err[Fail] = write_leads(c);
    if (sel err_led.err)                     { ret err_led; }
    if (output.has(c.in.kind, output.KEEPS)) { ret err[Fail].ok{}; }
    i = 0;
    for (i < input.count(c.in.inputs)) {
        val err_patch_input: err[Fail] = patch_input(c, table.nth[Input](i));
        if (sel err_patch_input.err) { ret err_patch_input; }
        i = i + 1;
    }
    val err_restate_frames: err[Fail] = restate_frames(c);
    if (sel err_restate_frames.err) { ret err_restate_frames; }
    val err_closed: err[Fail] = close_gaps(c);
    if (sel err_closed.err) { ret err_closed; }
    val err_fill_slots: err[Fail] = fill_slots(c);
    if (sel err_fill_slots.err) { ret err_fill_slots; }
    val err_fill_veneers: err[Fail] = fill_veneers(c);
    if (sel err_fill_veneers.err) { ret err_fill_veneers; }
    ret sites.fill(c.in.sites, c.in.layout, c.in.pieces, c.in.reserved);
}

# write the word right before every function a bridge lays one before: the
# distance from the function to its thunk with the low bit set, which the
# emulator masks off ("entry thunks", understanding Arm64EC ABI and assembly
# code). layout gave the word its bytes
fun write_leads(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < input.count(c.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(c.in.inputs, id);
        i = i + 1;
        if (o == nil) { cnt; }
        var k: usize = 0;
        for (k < vector.length[object.Bridge](?o.bridges)) {
            val b: *object.Bridge = ?o.bridges.data[k];
            k = k + 1;
            if (b.role.lead == 0) { cnt; }
            val err_write_lead: err[Fail] = write_lead(c, id, b);
            if (sel err_write_lead.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(err_write_lead.err, "bridge", (k - 1)::u64), input.at(c.in.inputs, id).name)}; }
        }
    }
    ret err[Fail].ok{};
}

fun write_lead(c: *Context, id: Id[Input], b: *object.Bridge) err[Fail] {
    val opt_value_of:        opt[u64] = layout.value_of(c.in.layout, id, b.symbol);
    val opt_value_of_layout: opt[u64] = layout.value_of(c.in.layout, id, b.thunk);
    if (sel opt_value_of.none)        { ret err[Fail].ok{}; }
    if (sel opt_value_of_layout.none) { ret err[Fail].ok{}; }
    var at:          Id[Input]        = id;
    var sid:         Id[Symbol]       = b.symbol;
    val opt_winning: opt[resolve.Won] = resolve.winning(c.in.resolved, id, b.symbol);
    if (sel opt_winning.some) {
        at  = opt_winning.some.binding.input;
        sid = opt_winning.some.binding.symbol;
    }
    val def: *Symbol = object.symbol_at(input.object_of(c.in.inputs, at), sid);
    if (!sel def.def.placed) { ret err[Fail].ok{}; }
    val ref:     Ref              = Ref{input: at, section: def.def.placed.section};
    val opt_lid: opt[Id[Landing]] = layout.landing_of(c.in.layout, ref);
    if (sel opt_lid.none) { ret err[Fail].ok{}; }
    val g: *Landing = table.at[Landing](?c.in.layout.landings, opt_lid.some);
    if (g.lead < b.role.lead) { ret err[Fail].err{fail.internal("layout laid no word before a bridged function")}; }
    val res_pos: res[opt[layout.Position], Fail] = layout.locate(c.in.layout, c.in.pieces, ref, 0);
    if (sel res_pos.err)     { ret err[Fail].err{res_pos.err}; }
    if (sel res_pos.ok.none) { ret err[Fail].ok{}; }
    val distance: i64 = (opt_value_of_layout.some - opt_value_of.some):~i64;
    if (distance < -0x8000_0000 || distance > 0x7fff_ffff) { ret err[Fail].err{fail.about(fail.overflow("a thunk lies more than 2 GiB from the function it enters"), b.role.name)}; }
    val word: u64 = (distance:~u64 | 1) & 0xffff_ffff;
    binary.put_uint(?c.out.bytes.data[(res_pos.ok.some.file - b.role.lead)::usize], word, b.role.lead::usize, c.in.arch.order);
    ret err[Fail].ok{};
}

# restate the field of every kept FDE that names its CIE by the distance back
# to it, from where the two were laid out
fun restate_frames(c: *Context) err[Fail] {
    val frames: *Vector[collect.Framing] = ?c.in.live.frames;
    var i:      usize                    = 0;
    for (i < vector.length[collect.Framing](frames)) {
        val f: collect.Framing = frames.data[i];
        i = i + 1;
        val res_locate: res[opt[layout.Position], Fail] = layout.locate(c.in.layout, c.in.pieces, f.at, f.field);
        if (sel res_locate.err) { ret err[Fail].err{res_locate.err}; }
        val res_locate_layout: res[opt[layout.Position], Fail] = layout.locate(c.in.layout, c.in.pieces, f.holds, f.cie);
        if (sel res_locate_layout.err) { ret err[Fail].err{res_locate_layout.err}; }
        if (sel res_locate.ok.none)    { ret err[Fail].err{placed(fail.internal("a kept FDE was not laid out"), c, f.at.input, f.at.section.index, f.field)}; }
        val p: layout.Position = res_locate.ok.some;
        if (sel res_locate_layout.ok.none) { ret err[Fail].err{placed(fail.internal("the CIE a kept FDE names was not laid out"), c, f.at.input, f.at.section.index, f.field)}; }
        val q: layout.Position = res_locate_layout.ok.some;
        if (q.address > p.address || p.address - q.address > 0xffff_ffff) { ret err[Fail].err{placed(fail.overflow("an FDE lies past 4 GiB after the CIE it names"), c, f.at.input, f.at.section.index, f.field)}; }
        binary.put_uint(?c.out.bytes.data[p.file::usize], p.address - q.address, 4, c.in.arch.order);
    }
    ret err[Fail].ok{};
}

# a section of unwind records where layout put it
# ---
# at:     the section
# last:   the offset of its last record, none where a terminator is all it
#         keeps
# merged: its output section
# start:  where in that it starts
# end:    where in that it ends
rec Run {
    at:     Ref;
    last:   opt[u64];
    merged: u32;
    start:  u64;
    end:    u64;
}

fun run_order(a: *Run, b: *Run) i64 {
    if (a.merged != b.merged) {
        if (a.merged < b.merged) { ret -1; }
        ret 1;
    }
    if (a.start < b.start) { ret -1; }
    if (a.start > b.start) { ret 1; }
    ret 0;
}

# run the last record before every gap between two sections of unwind records
# across the gap
fun close_gaps(c: *Context) err[Fail] {
    if (vector.length[collect.Tail](?c.in.live.tails) == 0) { ret err[Fail].ok{}; }
    var runs:            Vector[Run] = vector.init[Run](c.in.inputs.a);
    val err_gaps_closed: err[Fail]   = gaps_closed(c, ?runs);
    ret fail.kept(err_gaps_closed, vectors.dnit[Run](?runs));
}

fun gaps_closed(c: *Context, runs: *Vector[Run]) err[Fail] {
    val tails: *Vector[collect.Tail] = ?c.in.live.tails;
    var i:     usize                 = 0;
    for (i < vector.length[collect.Tail](tails)) {
        val t: collect.Tail = tails.data[i];
        i = i + 1;
        val opt_landing_of: opt[Id[Landing]] = layout.landing_of(c.in.layout, t.at);
        if (sel opt_landing_of.none) { ret err[Fail].err{placed(fail.internal("a section of kept records was not laid out"), c, t.at.input, t.at.section.index, 0)}; }
        val g:               *Landing  = table.at[Landing](?c.in.layout.landings, opt_landing_of.some);
        val err_runs_pushed: err[Fail] = vectors.push[Run](runs, Run{at: t.at, last: t.last, merged: g.merged.index, start: g.offset, end: g.offset + g.size});
        if (sel err_runs_pushed.err) { ret err[Fail].err{err_runs_pushed.err}; }
    }
    val n: usize = vector.length[Run](runs);
    sort.sort_by[Run](runs.data, n, run_order);
    var k: usize = 0;
    for (k + 1 < n) {
        val a: Run = runs.data[k];
        val b: Run = runs.data[k + 1];
        k = k + 1;
        if (a.merged != b.merged || a.end == b.start) { cnt; }
        if (b.start < a.end)                          { ret err[Fail].err{placed(fail.internal("two sections of records overlap in their output section"), c, b.at.input, b.at.section.index, 0)}; }
        val err_run_across: err[Fail] = run_across(c, a, b.start - a.end);
        if (sel err_run_across.err) { ret err_run_across; }
    }
    ret err[Fail].ok{};
}

# run the last record of `r`, which ends where `r` does, `gap` bytes further
fun run_across(c: *Context, r: Run, gap: u64) err[Fail] {
    if (sel r.last.none) { ret err[Fail].err{placed(fail.internal("a kept terminator lies before kept records"), c, r.at.input, r.at.section.index, 0)}; }
    val at:         u64                             = r.last.some;
    val res_locate: res[opt[layout.Position], Fail] = layout.locate(c.in.layout, c.in.pieces, r.at, at);
    if (sel res_locate.err)     { ret err[Fail].err{res_locate.err}; }
    if (sel res_locate.ok.none) { ret err[Fail].err{placed(fail.internal("a kept record was not laid out"), c, r.at.input, r.at.section.index, at)}; }
    val pos:        layout.Position         = res_locate.ok.some;
    val bytes:      *Vector[u8]             = ?c.out.bytes;
    val size:       u64                     = vector.length[u8](bytes)::u64;
    var t:          Reader                  = reader.make("image", bytes.data, size::usize, c.in.arch.order);
    val res_framed: res[parse.Framed, Fail] = parse.framed(?t, pos.file, size);
    if (sel res_framed.err)        { ret err[Fail].err{res_framed.err}; }
    if (!sel res_framed.ok.record) { ret err[Fail].err{placed(fail.internal("a kept record frames no bytes in the image"), c, r.at.input, r.at.section.index, at)}; }
    val rec: parse.Record = res_framed.ok.record;
    if (rec.end - rec.start != r.end - pos.offset) { ret err[Fail].err{placed(fail.internal("the last record of a section ends short of the section"), c, r.at.input, r.at.section.index, at)}; }
    val l:      parse.Length = parse.length_of(rec);
    val longer: u64          = l.value + gap;
    if (l.bytes == 4 && longer > parse.LENGTH_LIMIT) { ret err[Fail].err{placed(fail.overflow("a record run across a gap passes what its length holds"), c, r.at.input, r.at.section.index, at)}; }
    binary.put_uint(?bytes.data[l.at::usize], longer, l.bytes::usize, c.in.arch.order);
    ret err[Fail].ok{};
}

# write every slot of each table the format states the contents of: the
# target's address, thread pointer offset, module and offset or descriptor
# argument in a slot that holds it, unless the loader binds the slot, and its
# role's template in an entry a template fills, the table's head first where
# it has one. a slot or a code entry the image writer writes is left to it,
# and a copy is the loader's to fill. a table laid along another role's
# entries holds one entry per entry of that role
fun fill_slots(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < slot.SLOT_ROLES) {
        val role:    *SlotRole               = slot.at(i);
        val opt_row: opt[*reserve.SlotTable] = c.in.reserved.stated[i];
        var n:       usize                   = table.count[dynamic.Entry](dynamic.entries_of(c.in.dynamic, role));
        i = i + 1;
        if (sel opt_row.none)                                                          { cnt; }
        if (sel opt_row.some.order.along)                                              { n = table.count[dynamic.Entry](dynamic.entries_of(c.in.dynamic, opt_row.some.order.along)); }
        if (n == 0 && (!sel opt_row.some.contents.code || sel opt_row.some.head.none)) { cnt; }
        val contents: reserve.Contents = opt_row.some.contents;
        if (sel contents.written || sel contents.emitted || sel contents.copied) { cnt; }
        if (!sel contents.code) {
            var k: usize = 0;
            for (k < n) {
                val err_fill_slot: err[Fail] = fill_slot(c, role, k::u32, contents);
                if (sel err_fill_slot.err) { ret err[Fail].err{fail.in_indexed(fail.in_record(err_fill_slot.err, opt_row.some.name), "slot", k::u64)}; }
                k = k + 1;
            }
            cnt;
        }
        val err_fill_table: err[Fail] = fill_table(c, role, opt_row.some, n);
        if (sel err_fill_table.err) { ret err[Fail].err{fail.in_record(err_fill_table.err, opt_row.some.name)}; }
    }
    ret err[Fail].ok{};
}

# the facts every entry of a table may be bound with
# ---
# record: the bytes one record of the relocations the loader binds lazily
#         takes, none where the image holds no such table
# lazy:   the role of the table laid along the table's own entries, where
#         each of its slots leads until the loader binds it, none for none
rec Along {
    record: opt[u64];
    lazy:   opt[*SlotRole];
}

# what every entry of the table of role `r` may be bound with
fun along_of(c: *Context, r: *SlotRole) Along {
    var out:          Along                        = Along{};
    val opt_anchored: opt[Id[reserve.Reservation]] = reserve.anchored(c.in.reserved, ?template.LAZY_RELOCATIONS);
    if (sel opt_anchored.some) { out.record = opt[u64].some{table.at[reserve.Reservation](?c.in.reserved.tables, opt_anchored.some).entry_size}; }
    var i: usize = 0;
    for (i < slot.SLOT_ROLES) {
        val opt_row: opt[*reserve.SlotTable] = c.in.reserved.stated[i];
        i = i + 1;
        if (sel opt_row.none) { cnt; }
        val o: reserve.Order = opt_row.some.order;
        if (sel o.along && o.along == r) { out.lazy = opt[*SlotRole].some{opt_row.some.role}; }
    }
    ret out;
}

# write the head and each of the `n` entries of the table `row` of role `r`
# its role's template fills. a slot's template is bound through the code
# entry that goes to it, found by an index built once, and an entry of a
# table laid along another role's entries through that role's entry
fun fill_table(c: *Context, r: *SlotRole, row: *reserve.SlotTable, n: usize) err[Fail] {
    val opt_head: opt[*slot.Role] = row.head;
    if (sel opt_head.some) {
        val err_fill_head: err[Fail] = fill_head(c, r, opt_head.some);
        if (sel err_fill_head.err) { ret err_fill_head; }
    }
    if (n == 0) { ret err[Fail].ok{}; }
    val opt_filled: opt[*slot.Role] = r.template;
    if (sel opt_filled.none) { ret err[Fail].err{fail.about(fail.internal("a table of code is of a role no template fills"), r.name)}; }
    val res_chosen: res[*template.Template, Fail] = template.chosen(c.in.templates, opt_filled.some, c.in.kind, c.in.traits);
    if (sel res_chosen.err) { ret err[Fail].err{res_chosen.err}; }
    val with: Along = along_of(c, r);
    if (sel row.order.along) {
        var j: usize = 0;
        for (j < n) {
            val err_fill_along: err[Fail] = fill_along(c, r, row.order.along, j::u32, res_chosen.ok, with);
            if (sel err_fill_along.err) { ret err[Fail].err{fail.in_indexed(err_fill_along.err, "slot", j::u64)}; }
            j = j + 1;
        }
        ret err[Fail].ok{};
    }
    var back:        Vector[u32] = vector.init[u32](c.in.inputs.a);
    var err_goes_to: err[Fail]   = err[Fail].ok{};
    if (!sel r.reach.called) { err_goes_to = goes_to(c, r, n, ?back); }
    var k: usize = 0;
    for (k < n && sel err_goes_to.ok) {
        val err_fill_code: err[Fail] = fill_code(c, r, k::u32, res_chosen.ok, ?back, with);
        if (sel err_fill_code.err) { err_goes_to = err[Fail].err{fail.in_indexed(err_fill_code.err, "slot", k::u64)}; }
        k = k + 1;
    }
    ret fail.kept(err_goes_to, vectors.dnit[u32](?back));
}

# in `back`, per slot of role `r`, the index plus one of the code entry that
# goes to it, zero for none
fun goes_to(c: *Context, r: *SlotRole, n: usize, back: *Vector[u32]) err[Fail] {
    val err_grow: err[Fail] = vectors.grow[u32](back, n);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    val first: *dynamic.Entry = table.at[dynamic.Entry](dynamic.entries_of(c.in.dynamic, r), table.nth[dynamic.Entry](0));
    val w:     *dynamic.Route = first.route;
    if (w == nil) { ret err[Fail].err{fail.internal("a slot was made by no route")}; }
    val opt_through: opt[*SlotRole] = w.through;
    if (sel opt_through.none) { ret err[Fail].ok{}; }
    if (w.role != r)          { ret err[Fail].ok{}; }
    val code: *Table[dynamic.Entry] = dynamic.entries_of(c.in.dynamic, opt_through.some);
    var j:    usize                 = 0;
    for (j < table.count[dynamic.Entry](code)) {
        val lands: u32 = table.at[dynamic.Entry](code, table.nth[dynamic.Entry](j)).lands;
        if (lands::usize >= n) { ret err[Fail].err{fail.internal("a code entry lands past the slots of its route's role")}; }
        back.data[lands::usize] = (j + 1)::u32;
        j                       = j + 1;
    }
    ret err[Fail].ok{};
}

# where the table the format's row for role `r` laid starts, none when it
# laid none
fun table_start(c: *Context, r: *SlotRole) res[opt[layout.Position], Fail] {
    val opt_held: opt[Id[reserve.Reservation]] = c.in.reserved.held[r.at::usize];
    if (sel opt_held.none) { ret res[opt[layout.Position], Fail].ok{opt[layout.Position].none{}}; }
    val res_table_position: res[layout.Position, Fail] = layout.table_position(c.in.layout, opt_held.some);
    if (sel res_table_position.err) { ret res[opt[layout.Position], Fail].err{res_table_position.err}; }
    ret res[opt[layout.Position], Fail].ok{opt[layout.Position].some{res_table_position.ok}};
}

# the values every template of the link may reach whatever entry it fills:
# the start of the GOT of the PLT and the dynamic section, each bound only
# where the link holds it
fun shared_bounds(c: *Context, bound: *template.Bound, count: *usize) err[Fail] {
    val res_table_start: res[opt[layout.Position], Fail] = table_start(c, ?slot.GOT_PLT);
    if (sel res_table_start.err) { ret err[Fail].err{res_table_start.err}; }
    if (sel res_table_start.ok.some) {
        bound[@count] = template.Bound{target: ?template.GOT_PLT, value: res_table_start.ok.some.address};
        @count        = @count + 1;
    }
    val opt_anchored: opt[Id[reserve.Reservation]] = reserve.anchored(c.in.reserved, ?template.DYNAMIC_SECTION);
    if (sel opt_anchored.some) {
        val res_span_of: res[layout.Span, Fail] = layout.span_of(c.in.layout, c.in.reserved, opt_anchored.some);
        if (sel res_span_of.err) { ret err[Fail].err{res_span_of.err}; }
        bound[@count] = template.Bound{target: ?template.DYNAMIC, value: res_span_of.ok.address};
        @count        = @count + 1;
    }
    ret err[Fail].ok{};
}

# the address of the head of the table holding the entries of role `r`,
# none when its table has no head
fun head_of(c: *Context, r: *SlotRole) res[opt[u64], Fail] {
    val opt_row: opt[*reserve.SlotTable] = c.in.reserved.stated[r.at::usize];
    if (sel opt_row.none)           { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    if (sel opt_row.some.head.none) { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    val res_table_start: res[opt[layout.Position], Fail] = table_start(c, r);
    if (sel res_table_start.err)     { ret res[opt[u64], Fail].err{res_table_start.err}; }
    if (sel res_table_start.ok.none) { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    ret res[opt[u64], Fail].ok{opt[u64].some{res_table_start.ok.some.address}};
}

# write the head of the template role `h` at the start of the table of the
# entries of role `r`
fun fill_head(c: *Context, r: *SlotRole, h: *slot.Role) err[Fail] {
    val res_chosen: res[*template.Template, Fail] = template.chosen(c.in.templates, h, c.in.kind, c.in.traits);
    if (sel res_chosen.err) { ret err[Fail].err{res_chosen.err}; }
    val res_table_start: res[opt[layout.Position], Fail] = table_start(c, r);
    if (sel res_table_start.err)     { ret err[Fail].err{res_table_start.err}; }
    if (sel res_table_start.ok.none) { ret err[Fail].err{fail.internal("a table with a head was not laid")}; }
    val p: layout.Position = res_table_start.ok.some;
    val m: *Merged         = table.at[Merged](?c.in.layout.merged, p.merged);
    if (!section.has(m.kind, section.BITS))                                { ret err[Fail].err{fail.internal("a table's head lies in zero fill")}; }
    if (p.file + res_chosen.ok.len > vector.length[u8](?c.out.bytes)::u64) { ret err[Fail].err{fail.internal("a table's head lies outside the image bytes")}; }
    var bound: [BOUNDS]template.Bound;
    bound[0] = template.Bound{target: ?template.HEADER, value: p.address};
    var count:             usize     = 1;
    val err_shared_bounds: err[Fail] = shared_bounds(c, ?bound[0], ?count);
    if (sel err_shared_bounds.err) { ret err_shared_bounds; }
    ret template.emit(c.in.relocs, res_chosen.ok, ?c.out.bytes.data[p.file::usize], p.address, ?bound[0], count);
}

# the most values one emitted template is bound with
val BOUNDS: usize = 8;

# the offset of the `index`th record of the relocations the loader binds
# lazily in their table, bound where the image holds the table
fun record_bound(with: Along, index: u64, bound: *template.Bound, count: *usize) {
    if (sel with.record.none) { ret; }
    bound[@count] = template.Bound{target: ?template.RECORD, value: index * with.record.some};
    @count        = @count + 1;
}

# write the entry `k` of role `r`, a table laid along the entries of role
# `along`, with the template `t`: patched with its own address and index,
# the `k`th entry of `along`, the head of its own table and the offset of
# its lazily bound relocation
fun fill_along(c: *Context, r: *SlotRole, along: *SlotRole, k: u32, t: *template.Template, with: Along) err[Fail] {
    val res_slot_position: res[layout.Position, Fail] = layout.slot_position(c.in.layout, c.in.reserved, r, k);
    if (sel res_slot_position.err) { ret err[Fail].err{res_slot_position.err}; }
    val m: *Merged = table.at[Merged](?c.in.layout.merged, res_slot_position.ok.merged);
    if (!section.has(m.kind, section.BITS))                                       { ret err[Fail].err{fail.internal("a code entry lies in zero fill")}; }
    if (res_slot_position.ok.file + t.len > vector.length[u8](?c.out.bytes)::u64) { ret err[Fail].err{fail.internal("a code entry lies outside the image bytes")}; }
    val res_slot_address: res[u64, Fail] = layout.slot_address(c.in.layout, c.in.reserved, along, k);
    if (sel res_slot_address.err) { ret err[Fail].err{res_slot_address.err}; }
    var bound: [BOUNDS]template.Bound;
    bound[0] = template.Bound{target: ?template.ENTRY, value: res_slot_position.ok.address};
    bound[1] = template.Bound{target: ?template.INDEX, value: k::u64};
    bound[2] = template.Bound{target: ?template.SLOT, value: res_slot_address.ok};
    var count:       usize               = 3;
    val res_head_of: res[opt[u64], Fail] = head_of(c, r);
    if (sel res_head_of.err) { ret err[Fail].err{res_head_of.err}; }
    if (sel res_head_of.ok.some) {
        bound[count] = template.Bound{target: ?template.HEADER, value: res_head_of.ok.some};
        count        = count + 1;
    }
    record_bound(with, k::u64, ?bound[0], ?count);
    val err_shared_bounds: err[Fail] = shared_bounds(c, ?bound[0], ?count);
    if (sel err_shared_bounds.err) { ret err_shared_bounds; }
    ret template.emit(c.in.relocs, t, ?c.out.bytes.data[res_slot_position.ok.file::usize], res_slot_position.ok.address, ?bound[0], count);
}

# write the entry of role `r` the target `k` takes with the template `t`. a
# code entry is patched with its own address, the slot it lands in and that
# slot's index and lazily bound relocation's offset, and the head of its
# table. a slot is patched with its own address and index, the address of
# the code entry that goes to it, which `back` holds, and the head of that
# entry's table, and the entry laid along it where a table is
fun fill_code(c: *Context, r: *SlotRole, k: u32, t: *template.Template, back: *Vector[u32], with: Along) err[Fail] {
    val e:                 *dynamic.Entry             = table.at[dynamic.Entry](dynamic.entries_of(c.in.dynamic, r), table.nth[dynamic.Entry](k::usize));
    val res_slot_position: res[layout.Position, Fail] = layout.slot_position(c.in.layout, c.in.reserved, r, k);
    if (sel res_slot_position.err) { ret err[Fail].err{res_slot_position.err}; }
    val m: *Merged = table.at[Merged](?c.in.layout.merged, res_slot_position.ok.merged);
    if (!section.has(m.kind, section.BITS))                                       { ret err[Fail].err{fail.internal("a code entry lies in zero fill")}; }
    if (res_slot_position.ok.file + t.len > vector.length[u8](?c.out.bytes)::u64) { ret err[Fail].err{fail.internal("a code entry lies outside the image bytes")}; }
    val w: *dynamic.Route = e.route;
    if (w == nil) { ret err[Fail].err{fail.internal("a code entry was made by no route")}; }
    var bound:       [BOUNDS]template.Bound;
    var count:       usize          = 0;
    var code:        *SlotRole      = r;
    var at:          u64            = res_slot_position.ok.address;
    val opt_through: opt[*SlotRole] = w.through;
    if (sel r.reach.called) {
        if (leads(w, r)) {
            val res_lands: res[u64, Fail] = layout.slot_address(c.in.layout, c.in.reserved, w.role, e.lands);
            if (sel res_lands.err) { ret err[Fail].err{res_lands.err}; }
            bound[0] = template.Bound{target: ?template.SLOT, value: res_lands.ok};
            bound[1] = template.Bound{target: ?template.INDEX, value: e.lands::u64};
            count    = 2;
            record_bound(with, e.lands::u64, ?bound[0], ?count);
        }
    }
    or {
        bound[0] = template.Bound{target: ?template.SLOT, value: res_slot_position.ok.address};
        bound[1] = template.Bound{target: ?template.INDEX, value: k::u64};
        count    = 2;
        val opt_lazy: opt[*SlotRole] = with.lazy;
        if (sel opt_lazy.some) {
            val res_slot_address: res[u64, Fail] = layout.slot_address(c.in.layout, c.in.reserved, opt_lazy.some, k);
            if (sel res_slot_address.err) { ret err[Fail].err{res_slot_address.err}; }
            bound[count] = template.Bound{target: ?template.LAZY, value: res_slot_address.ok};
            count        = count + 1;
        }
        val j: u32 = back.data[k::usize];
        code = nil;
        if (sel opt_through.some) {
            if (j != 0) {
                val res_from: res[u64, Fail] = layout.slot_address(c.in.layout, c.in.reserved, opt_through.some, j - 1);
                if (sel res_from.err) { ret err[Fail].err{res_from.err}; }
                code = opt_through.some;
                at   = res_from.ok;
            }
        }
    }
    if (code != nil) {
        bound[count] = template.Bound{target: ?template.ENTRY, value: at};
        count        = count + 1;
        val res_head_of: res[opt[u64], Fail] = head_of(c, code);
        if (sel res_head_of.err) { ret err[Fail].err{res_head_of.err}; }
        if (sel res_head_of.ok.some) {
            bound[count] = template.Bound{target: ?template.HEADER, value: res_head_of.ok.some};
            count        = count + 1;
        }
    }
    val err_shared_bounds: err[Fail] = shared_bounds(c, ?bound[0], ?count);
    if (sel err_shared_bounds.err) { ret err_shared_bounds; }
    ret template.emit(c.in.relocs, t, ?c.out.bytes.data[res_slot_position.ok.file::usize], res_slot_position.ok.address, ?bound[0], count);
}

# write every veneer and landing pad with the template of its role, led to
# where it leads
fun fill_veneers(c: *Context) err[Fail] {
    val r: *Reserved = c.in.reserved;
    if (table.count[reserve.Veneer](?r.veneers) == 0) { ret err[Fail].ok{}; }
    if (sel r.islanded.none)                          { ret err[Fail].err{fail.internal("veneers are laid where no table is spread into islands")}; }
    var i: usize = 0;
    for (i < table.count[reserve.Veneer](?r.veneers)) {
        val vn:         *reserve.Veneer               = table.at[reserve.Veneer](?r.veneers, table.nth[reserve.Veneer](i));
        val res_chosen: res[*template.Template, Fail] = template.chosen(c.in.templates, vn.role, c.in.kind, c.in.traits);
        if (sel res_chosen.err) { ret err[Fail].err{fail.in_indexed(res_chosen.err, "veneer", i::u64)}; }
        val err_fill_veneer: err[Fail] = fill_veneer(c, i::u32, res_chosen.ok);
        if (sel err_fill_veneer.err) { ret err[Fail].err{fail.in_indexed(err_fill_veneer.err, "veneer", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# write the veneer `v` with the template `t`, its destination bound to the
# address it leads to
fun fill_veneer(c: *Context, v: u32, t: *template.Template) err[Fail] {
    val res_veneer_position: res[layout.Position, Fail] = layout.veneer_position(c.in.layout, c.in.reserved, v);
    if (sel res_veneer_position.err) { ret err[Fail].err{res_veneer_position.err}; }
    val m: *Merged = table.at[Merged](?c.in.layout.merged, res_veneer_position.ok.merged);
    if (!section.has(m.kind, section.BITS))                                         { ret err[Fail].err{fail.internal("a veneer lies in zero fill")}; }
    if (res_veneer_position.ok.file + t.len > vector.length[u8](?c.out.bytes)::u64) { ret err[Fail].err{fail.internal("a veneer lies outside the image bytes")}; }
    val res_lead: res[u64, Fail] = layout.lead(c.in.layout, c.in.reserved, v);
    if (sel res_lead.err) { ret err[Fail].err{res_lead.err}; }
    var bound: [1]template.Bound = [1]template.Bound{template.Bound{target: ?template.DESTINATION, value: res_lead.ok}};
    ret template.emit(c.in.relocs, t, ?c.out.bytes.data[res_veneer_position.ok.file::usize], res_veneer_position.ok.address, ?bound[0], 1);
}

# write the slot of role `r` the target `k` takes, of the contents `contents`
# its table states: its target's address, or the address of the entry it
# leads to when a reference goes through it, or its thread pointer offset, or
# for a slot the loader fills from the image's thread-local block, its offset
# in the block. a module slot holds the module index the table states and
# its target's offset from the block's dynamic thread vector anchor, the
# loader filling the index for the image's own block, and a descriptor holds
# its target's offset in the block as the argument the loader reads
fun fill_slot(c: *Context, r: *SlotRole, k: u32, contents: reserve.Contents) err[Fail] {
    val e: *dynamic.Entry = table.at[dynamic.Entry](dynamic.entries_of(c.in.dynamic, r), table.nth[dynamic.Entry](k::usize));
    if (dynamic.has(e.outcome, dynamic.BIND_ENTRY)) { ret err[Fail].ok{}; }
    val opt_width: opt[u8] = arch.pointer_bytes(c.in.arch);
    if (sel opt_width.none) { ret err[Fail].err{fail.about(fail.unsupported("the architecture states no pointer width a slot holds"), c.in.arch.name)}; }
    val res_slot_position: res[layout.Position, Fail] = layout.slot_position(c.in.layout, c.in.reserved, r, k);
    if (sel res_slot_position.err) { ret err[Fail].err{res_slot_position.err}; }
    val m: *Merged = table.at[Merged](?c.in.layout.merged, res_slot_position.ok.merged);
    if (!section.has(m.kind, section.BITS)) { ret err[Fail].err{fail.internal("a slot the link writes lies in zero fill")}; }
    val n:     u64  = opt_width.some::u64;
    val block: bool = dynamic.has(e.outcome, dynamic.BLOCK_ENTRY);
    if (sel contents.module) {
        var index: u64 = contents.module;
        if (block) { index = 0; }
        val err_slot_word_put: err[Fail] = put_word(c, res_slot_position.ok, 0, res[u64, Fail].ok{index}, n);
        if (sel err_slot_word_put.err) { ret err_slot_word_put; }
        var res_offset: res[u64, Fail] = res[u64, Fail].ok{0};
        if (!r.whole) { res_offset = dtp_offset(c, e.aim, n); }
        ret put_word(c, res_slot_position.ok, n, res_offset, n);
    }
    if (sel contents.descriptor) {
        if (!block) { ret err[Fail].err{fail.internal("a thread-local descriptor is filled by no loader")}; }
        var res_offset: res[u64, Fail] = res[u64, Fail].ok{0};
        if (!r.whole) { res_offset = block_offset(c, e.aim); }
        ret put_word(c, res_slot_position.ok, n, res_offset, n);
    }
    var res_slot_address: res[u64, Fail] = res[u64, Fail].err{fail.internal("a slot's value was never taken")};
    val w:                *dynamic.Route = e.route;
    if (leads(w, r)) { res_slot_address = layout.slot_address(c.in.layout, c.in.reserved, w.role, e.lands); }
    or               { res_slot_address = slot_value(c, e, n, sel contents.offset); }
    ret put_word(c, res_slot_position.ok, 0, res_slot_address, n);
}

# write the value `v` as the pointer of `n` bytes `at` bytes into the slot at
# `p`
fun put_word(c: *Context, p: layout.Position, at: u64, v: res[u64, Fail], n: u64) err[Fail] {
    if (sel v.err)                                              { ret err[Fail].err{v.err}; }
    if (n < 8 && (v.ok >> (n * 8)) != 0)                        { ret err[Fail].err{fail.valued(fail.overflow("a slot's target does not fit its pointer"), v.ok::i128)}; }
    if (p.file + at + n > vector.length[u8](?c.out.bytes)::u64) { ret err[Fail].err{fail.internal("a slot lies outside the image bytes")}; }
    binary.put_uint(?c.out.bytes.data[(p.file + at)::usize], v.ok, n::usize, c.in.arch.order);
    ret err[Fail].ok{};
}

# whether an entry of role `r` made by the route `w` is one a reference goes
# through on its way to the entry it leads to
fun leads(w: *dynamic.Route, r: *SlotRole) bool {
    if (w == nil) { ret false; }
    val opt_through: opt[*SlotRole] = w.through;
    if (sel opt_through.some) { ret opt_through.some == r; }
    ret false;
}

# what a slot of `n` bytes for the entry `e` holds: its target's address, or
# when `offset` its thread pointer offset, or its offset in the thread-local
# block where the loader adds the image's thread pointer offset
fun slot_value(c: *Context, e: *dynamic.Entry, n: u64, offset: bool) res[u64, Fail] {
    val block: bool = dynamic.has(e.outcome, dynamic.BLOCK_ENTRY);
    if (block && !offset) { ret res[u64, Fail].err{fail.internal("the loader fills a slot that holds an address from the image's thread-local block")}; }
    if (block)            { ret block_offset(c, e.aim); }
    if (offset)           { ret thread_offset(c, e.aim, n); }
    ret aimed(c, e.aim);
}

# the offset of what a slot aims at in the image's thread-local block
fun block_offset(c: *Context, aim: dynamic.Aim) res[u64, Fail] {
    if (sel aim.absent) { ret res[u64, Fail].err{fail.unsupported("a thread-local variable nothing defines has no offset in a thread-local block")}; }
    val res_aimed: res[u64, Fail] = aimed(c, aim);
    if (sel res_aimed.err) { ret res_aimed; }
    ret layout.block_offset(c.in.layout, res_aimed.ok);
}

# the offset from the thread pointer of what a slot aims at, as the `n` bytes
# of a pointer hold it
fun thread_offset(c: *Context, aim: dynamic.Aim, n: u64) res[u64, Fail] {
    ret anchored_offset(c, aim, n, ?compute.TPOFF);
}

# the offset from the dynamic thread vector anchor of what a slot aims at, as
# the `n` bytes of a pointer hold it
fun dtp_offset(c: *Context, aim: dynamic.Aim, n: u64) res[u64, Fail] {
    ret anchored_offset(c, aim, n, ?compute.DTPOFF);
}

# the offset of what a slot aims at the computation `by` gives from the
# thread-local block's anchors, as the `n` bytes of a pointer hold it
fun anchored_offset(c: *Context, aim: dynamic.Aim, n: u64, by: *compute.Computation) res[u64, Fail] {
    if (sel aim.absent) { ret res[u64, Fail].err{fail.unsupported("a thread-local variable nothing defines has no thread pointer offset")}; }
    val res_aimed: res[u64, Fail] = aimed(c, aim);
    if (sel res_aimed.err) { ret res_aimed; }
    val res_thread_anchors: res[layout.Anchors, Fail] = layout.thread_anchors(c.in.layout);
    if (sel res_thread_anchors.err) { ret res[u64, Fail].err{res_thread_anchors.err}; }
    var x:         compute.Inputs  = compute.Inputs{s: res_aimed.ok, tp: res_thread_anchors.ok.tp, dtp: res_thread_anchors.ok.dtp};
    val res_value: res[i128, Fail] = by.value(?x);
    if (sel res_value.err) { ret res[u64, Fail].err{res_value.err}; }
    val bits: u64  = n * 8;
    val half: i128 = 1::i128 << (bits - 1)::i128;
    if (res_value.ok < -half || res_value.ok >= half) { ret res[u64, Fail].err{fail.valued(fail.overflow("a thread pointer offset does not fit its slot"), res_value.ok)}; }
    var w: i128 = res_value.ok;
    if (w < 0) { w = w + (1::i128 << bits::i128); }
    ret res[u64, Fail].ok{w::u64};
}

# the address of what a slot aims at: its definition's, the place a name
# the link defines puts it at, zero for the absolute address and, by the
# format's rule, for a weak name nothing defines
fun aimed(c: *Context, aim: dynamic.Aim) res[u64, Fail] {
    val in:             *In      = c.in;
    var opt_address_of: opt[u64] = opt[u64].none{};
    if (sel aim.bound || sel aim.local || sel aim.linked) { opt_address_of = address_of(in.layout, in.resolved, aim); }
    or (sel aim.absolute)                                 { ret res[u64, Fail].ok{0}; }
    or (sel aim.absent) {
        if (sel in.weak.zero)     { ret res[u64, Fail].ok{0}; }
        if (sel in.weak.fallback) { ret res[u64, Fail].err{fail.malformed("a weak reference reaches no definition through a fallback")}; }
        ret res[u64, Fail].err{fail.unsupported("the format has no rule for an undefined weak reference")};
    }
    or (sel aim.imported)        { ret res[u64, Fail].err{fail.internal("a slot the link writes aims at an import, which the loader binds")}; }
    or (sel aim.entry)           { ret res[u64, Fail].err{fail.internal("a slot aims at an index space entry")}; }
    if (sel opt_address_of.none) { ret res[u64, Fail].err{fail.malformed("a slot's target has no address in the image")}; }
    ret res[u64, Fail].ok{opt_address_of.some};
}

# the address in the image of what `aim` names: its definition's, or the
# place a name the link defines puts it at. none for an aim that names no
# place of the image, as an import or a dropped definition
pub fun address_of(l: *Layout, r: *Resolved, aim: dynamic.Aim) opt[u64] {
    if (sel aim.bound) {
        val b: *resolve.Binding = table.at[resolve.Binding](?r.bindings, aim.bound);
        ret layout.value_of(l, b.input, b.symbol);
    }
    or (sel aim.local)  { ret layout.value_of(l, aim.local.input, aim.local.symbol); }
    or (sel aim.linked) { ret layout.linked_value(l, r, aim.linked); }
    ret opt[u64].none{};
}

fun by_reloc(a: *Item, b: *Item) i64 {
    if (a.section != b.section) {
        if (a.section < b.section) { ret -1; }
        ret 1;
    }
    if (a.reloc < b.reloc) { ret -1; }
    if (a.reloc > b.reloc) { ret 1; }
    ret 0;
}

# the bytes of a landed section, in the runs its cuts leave, which layout
# keeps in ascending order
fun copy_landing(c: *Context, g: *Landing) err[Fail] {
    val l: *Layout  = c.in.layout;
    val o: *Object  = input.object_of(c.in.inputs, g.at.input);
    val s: *Section = object.section_at(o, g.at.section);
    if (sel s.contents.zero) { ret err[Fail].ok{}; }
    val b:        Bytes          = object.bytes(o, ?s.contents);
    val m:        *Merged        = table.at[Merged](?l.merged, g.merged);
    val at:       Location       = Location{file: input.at(c.in.inputs, g.at.input).name, record: "output section"};
    val res_head: res[u64, Fail] = checked.add(at, m.offset, g.offset);
    if (sel res_head.err) { ret err[Fail].err{res_head.err}; }
    val n:     u32 = g.cut_count;
    var from:  u64 = 0;
    var shift: u64 = 0;
    var i:     u32 = 0;
    for (i <= n) {
        var stop: u64 = g.source;
        if (i < n)       { stop = l.cuts.data[(g.cut_first + i)::usize].start; }
        if (stop < from) { ret err[Fail].err{fail.in_file(fail.internal("the cut ranges of a section overlap"), at.file)}; }
        if (stop > from) {
            val res_kept: res[u64, Fail] = checked.sub(at, from, shift);
            if (sel res_kept.err) { ret err[Fail].err{res_kept.err}; }
            val res_dest: res[u64, Fail] = checked.add(at, res_head.ok, res_kept.ok);
            if (sel res_dest.err) { ret err[Fail].err{res_dest.err}; }
            val err_copy_run: err[Fail] = copy_run(c, b, from, stop, res_dest.ok, at);
            if (sel err_copy_run.err) { ret err_copy_run; }
        }
        if (i < n) {
            val cut: *Cut = ?l.cuts.data[(g.cut_first + i)::usize];
            from  = cut.end;
            shift = shift + cut.removed;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bytes every edit of a participant writes, over the copied bytes of the
# section it edits, where layout put them
fun write_edits(c: *Context) err[Fail] {
    val a: *Adjusted = c.in.adjusted;
    var i: usize     = 0;
    for (i < vector.length[adjust.Edit](?a.edits)) {
        val e: *adjust.Edit = ?a.edits.data[i];
        i = i + 1;
        if (!sel e.change.write) { cnt; }
        val w:       adjust.Written                  = e.change.write;
        val res_pos: res[opt[layout.Position], Fail] = layout.locate(c.in.layout, c.in.pieces, e.at, e.offset);
        if (sel res_pos.err)     { ret err[Fail].err{res_pos.err}; }
        if (sel res_pos.ok.none) { ret err[Fail].err{fail.in_indexed(fail.internal("an edit writes bytes that did not land"), "edit", (i - 1)::u64)}; }
        val o:              *Object          = input.object_of(c.in.inputs, e.at.input);
        val s:              *Section         = object.section_at(o, e.at.section);
        val end:            u64              = e.offset + w.len::u64;
        val opt_landing_of: opt[Id[Landing]] = layout.landing_of(c.in.layout, e.at);
        val past:           Fail             = fail.in_indexed(fail.internal("an edit writes past the bytes of its section"), "edit", (i - 1)::u64);
        if (sel opt_landing_of.none)                                                    { ret err[Fail].err{past}; }
        if (end > table.at[Landing](?c.in.layout.landings, opt_landing_of.some).source) { ret err[Fail].err{past}; }
        if (sel s.contents.zero)                                                        { ret err[Fail].err{past}; }
        val at: u64 = res_pos.ok.some.file;
        if (at + w.len::u64 > vector.length[u8](?c.out.bytes)::u64) { ret err[Fail].err{fail.in_indexed(fail.internal("an edit writes outside the image bytes"), "edit", (i - 1)::u64)}; }
        memory.copy[u8](?c.out.bytes.data[at::usize], adjust.written(a, w), w.len);
    }
    ret err[Fail].ok{};
}

# the bytes of every kept piece, at its place in its group's block
fun copy_pieces(c: *Context) err[Fail] {
    val p: *Pieces = c.in.pieces;
    var i: usize   = 0;
    for (i < table.count[Piece](?p.pieces)) {
        val id: Id[Piece] = table.nth[Piece](i);
        val pc: *Piece    = table.at[Piece](?p.pieces, id);
        i = i + 1;
        if (!pc.live || pc.kept.index != id.index) { cnt; }
        val at:      Ref                             = table.at[pieces.Member](?p.members, pc.member).at;
        val res_pos: res[opt[layout.Position], Fail] = layout.locate(c.in.layout, p, at, pc.offset);
        if (sel res_pos.err)     { ret err[Fail].err{res_pos.err}; }
        if (sel res_pos.ok.none) { ret err[Fail].err{fail.internal("a kept piece of a merged section did not land")}; }
        val o:        *Object        = input.object_of(c.in.inputs, at.input);
        val b:        Bytes          = object.bytes(o, ?object.section_at(o, at.section).contents);
        val here:     Location       = Location{file: input.at(c.in.inputs, at.input).name, record: "merged section"};
        val res_stop: res[u64, Fail] = checked.add(here, pc.offset, pc.size);
        if (sel res_stop.err) { ret err[Fail].err{res_stop.err}; }
        val err_copy_run: err[Fail] = copy_run(c, b, pc.offset, res_stop.ok, res_pos.ok.some.file, here);
        if (sel err_copy_run.err) { ret err_copy_run; }
    }
    ret err[Fail].ok{};
}

# the bytes `from` up to `stop` of `b`, copied to `dest` in the image bytes. a
# run that is not inside `b`, or lands outside the image bytes, is refused,
# naming the input, and nothing is copied
fun copy_run(c: *Context, b: Bytes, from: u64, stop: u64, dest: u64, at: Location) err[Fail] {
    if (from > stop || stop > b.len::u64 || (stop > from && b.data == nil)) {
        ret err[Fail].err{fail.in_file(fail.internal("a section's run lies outside the bytes the input holds for it"), at.file)};
    }
    val res_end: res[u64, Fail] = checked.add(at, dest, stop - from);
    if (sel res_end.err) { ret err[Fail].err{res_end.err}; }
    if (res_end.ok > vector.length[u8](?c.out.bytes)::u64) {
        ret err[Fail].err{fail.in_file(fail.internal("a section lands outside the image bytes"), at.file)};
    }
    if (stop == from) { ret err[Fail].ok{}; }
    memory.copy[u8](?c.out.bytes.data[dest::usize], ?b.data[from::usize], (stop - from)::usize);
    ret err[Fail].ok{};
}

fun patch_input(c: *Context, id: Id[Input]) err[Fail] {
    val o: *Object = input.object_of(c.in.inputs, id);
    if (o == nil) { ret err[Fail].ok{}; }
    val n: usize = table.count[Reloc](?o.relocs);
    vector.clear[Item](?c.items);
    var i: usize = 0;
    for (i < n) {
        val r:                *Reloc    = table.at[Reloc](?o.relocs, table.nth[Reloc](i));
        val err_items_pushed: err[Fail] = vectors.push[Item](?c.items, Item{section: r.section.index, reloc: i::u32});
        if (sel err_items_pushed.err) { ret err[Fail].err{err_items_pushed.err}; }
        i = i + 1;
    }
    sort.sort_by[Item](c.items.data, n, by_reloc);
    var first: usize = 0;
    for (first < n) {
        val sec:  u32   = c.items.data[first].section;
        var last: usize = first;
        for (last < n && c.items.data[last].section == sec) {
            last = last + 1;
        }
        val err_patch_section: err[Fail] = patch_section(c, id, o, sec, first, last);
        if (sel err_patch_section.err) { ret err_patch_section; }
        first = last;
    }
    ret err[Fail].ok{};
}

# the relocations first up to last of the section `sec`, prepared and then
# applied, so a relocation can read its partner's
fun patch_section(c: *Context, id: Id[Input], o: *Object, sec: u32, first: usize, last: usize) err[Fail] {
    val ref:     Ref              = Ref{input: id, section: Id[Section]{index: sec}};
    val opt_lid: opt[Id[Landing]] = layout.landing_of(c.in.layout, ref);
    if (sel opt_lid.none) { ret err[Fail].ok{}; }
    val g: *Landing = table.at[Landing](?c.in.layout.landings, opt_lid.some);
    vector.clear[Prep](?c.preps);
    vector.clear[Mark](?c.marks);
    var k: usize = first;
    for (k < last) {
        val ri:          u32       = c.items.data[k].reloc;
        val err_prepare: err[Fail] = prepare(c, id, o, ref, g, ri);
        if (sel err_prepare.err) { ret err[Fail].err{placed(err_prepare.err, c, id, sec, table.at[Reloc](?o.relocs, table.nth[Reloc](ri::usize)).offset)}; }
        k = k + 1;
    }
    val err_ordered: err[Fail] = engine.order(c.marks.data, vector.length[Mark](?c.marks), ?c.slots);
    if (sel err_ordered.err) { ret err_ordered; }
    var i: usize = 0;
    for (i < vector.length[Prep](?c.preps)) {
        val err_apply_one: err[Fail] = apply_one(c, id, o, ref.section, i);
        if (sel err_apply_one.err) { ret err[Fail].err{placed(err_apply_one.err, c, id, sec, c.preps.data[i].offset)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the failure `f` in the section `sec` of the input `id`, at the field's offset
fun placed(f: Fail, c: *Context, id: Id[Input], sec: u32, offset: u64) Fail {
    if (fail.is_refused(f)) { ret f; }
    var out: Fail = f;
    out.at = Location{
        file:    input.at(c.in.inputs, id).name,
        record:  "section",
        index:   sec::u64,
        indexed: true,
        offset:  offset,
        placed:  true,
    };
    ret out;
}

fun site_of(c: *Context, id: Id[Input], at: u64, room: u64) Site {
    ret Site{
        file:    input.at(c.in.inputs, id).name,
        section: "section",
        data:    ?c.out.bytes.data[at::usize],
        size:    room,
        order:   c.in.arch.order,
    };
}

# prepare the relocation `ri`, leaving it out when it patches nothing here
fun prepare(c: *Context, id: Id[Input], o: *Object, ref: Ref, g: *Landing, ri: u32) err[Fail] {
    val in:        *In                     = c.in;
    val rel:       *Reloc                  = table.at[Reloc](?o.relocs, table.nth[Reloc](ri::usize));
    val res_taken: res[adjust.Taken, Fail] = adjust.taken(in.adjusted, id, Id[Reloc]{index: ri}, rel);
    if (sel res_taken.err) { ret err[Fail].err{res_taken.err}; }
    val kind:   *reloc.Kind = res_taken.ok.kind;
    val offset: u64         = res_taken.ok.offset;
    if (reloc.has(kind, reloc.MARKER)) { ret err[Fail].ok{}; }
    val res_own: res[bool, Fail] = pieces.own_copy(in.pieces, ref, offset);
    if (sel res_own.err) { ret err[Fail].err{res_own.err}; }
    if (!res_own.ok)     { ret err[Fail].ok{}; }
    val res_pos: res[opt[layout.Position], Fail] = layout.locate(in.layout, in.pieces, ref, offset);
    if (sel res_pos.err)     { ret err[Fail].err{res_pos.err}; }
    if (sel res_pos.ok.none) { ret err[Fail].ok{}; }
    val p:       layout.Position      = res_pos.ok.some;
    val res_dec: res[*Decision, Fail] = dynamic.decided_as(c.in.dynamic, id, ri, res_taken.ok.form);
    if (sel res_dec.err)                                        { ret err[Fail].err{res_dec.err}; }
    if (res_dec.ok.row == nil)                                  { ret err[Fail].ok{}; }
    if (dynamic.has(res_dec.ok.row.outcome, dynamic.BIND_SITE)) { ret err[Fail].ok{}; }
    val s: *Section = object.section_at(o, rel.section);
    if (sel s.contents.zero) { ret err[Fail].err{fail.malformed("a relocation patches a zero-fill section")}; }
    val res_rows: res[*Lookup, Fail] = link_rows.for_object(c.in.rows, o);
    if (sel res_rows.err) { ret err[Fail].err{res_rows.err}; }
    val res_targeting: res[*Row, Fail] = row.targeting(res_rows.ok, kind, sel rel.minus.some);
    if (sel res_targeting.err) { ret err[Fail].err{res_targeting.err}; }

    val m:            *Merged                   = table.at[Merged](?in.layout.merged, g.merged);
    val room:         u64                       = m.offset + g.offset + g.size - p.file;
    var site:         Site                      = site_of(c, id, p.file, room);
    var ask:          value.Ask                 = value.Ask{input: id, reloc: rel, kind: kind, row: res_targeting.ok, holds: res_targeting.ok, site: ?site, section: s, decision: res_dec.ok, place: p.address};
    val res_gathered: res[value.Gathered, Fail] = value.gather(?c.from, ?ask);
    if (sel res_gathered.err) { ret err[Fail].err{res_gathered.err}; }
    val dead: bool           = sel res_gathered.ok.dead;
    var x:    compute.Inputs = compute.Inputs{};
    if (sel res_gathered.ok.inputs) {
        x = res_gathered.ok.inputs;
        val err_sent: err[Fail] = detoured(c, id, ri, ?x);
        if (sel err_sent.err) { ret err_sent; }
    }

    if (sel rel.minus.none) { ret queued(c, res_targeting.ok, x, p, room, offset, dead, false, sel res_targeting.ok.pair.none); }
    # a difference is its set's two records, one adding the target and the
    # addend, one subtracting the second symbol
    val res_pair: res[Pairing, Fail] = row.difference_of(res_rows.ok, kind);
    if (sel res_pair.err) { ret err[Fail].err{res_pair.err}; }
    val distance: i128 = x.s::i128 + x.a::i128 - x.b::i128;
    if (!dead && !difference_fits(distance, res_pair.ok.bits)) {
        ret err[Fail].err{fail.valued(fail.about(fail.overflow("a difference does not fit its field"), res_targeting.ok.name), distance)};
    }
    var less: compute.Inputs = x;
    less.s = x.b;
    less.a = 0;
    if (res_pair.ok.difference.minus_first) {
        val err_queued: err[Fail] = queued(c, res_pair.ok.minus, less, p, room, offset, dead, true, false);
        if (sel err_queued.err) { ret err_queued; }
        ret queued(c, res_targeting.ok, x, p, room, offset, dead, false, false);
    }
    val err_plus: err[Fail] = queued(c, res_targeting.ok, x, p, room, offset, dead, true, false);
    if (sel err_plus.err) { ret err_plus; }
    ret queued(c, res_pair.ok.minus, less, p, room, offset, dead, false, false);
}

# whether a field of `bits` bits holds the difference `d`, signed or unsigned
fun difference_fits(d: i128, bits: u32) bool {
    val top: i128 = (1::i128) << bits::i128;
    ret d >= -(top >> 1) && d < top;
}

# send the relocation `ri` of the input `id` to its veneer where a
# participant sent it through one: the veneer stands for its target, the
# addend with it, as the place the branch reaches
fun detoured(c: *Context, id: Id[Input], ri: u32, x: *compute.Inputs) err[Fail] {
    val opt_detour_of: opt[*adjust.Detour] = adjust.detour_of(c.in.adjusted, id, Id[Reloc]{index: ri});
    if (sel opt_detour_of.none) { ret err[Fail].ok{}; }
    val res_veneer_address: res[u64, Fail] = layout.veneer_address(c.in.layout, c.in.reserved, opt_detour_of.some.veneer);
    if (sel res_veneer_address.err) { ret err[Fail].err{res_veneer_address.err}; }
    value.through(x, res_veneer_address.ok);
    ret err[Fail].ok{};
}

# queue the record of row `rw` with the inputs `x` at the position `p`, not
# computed when `dead`
fun queued(c: *Context, rw: *Row, x: compute.Inputs, p: layout.Position, room: u64, offset: u64, dead: bool, first: bool, alone: bool) err[Fail] {
    val err_preps_pushed: err[Fail] = vectors.push[Prep](?c.preps, Prep{row: rw, x: x, at: p.file, room: room, offset: offset, dead: dead, first: first, alone: alone});
    if (sel err_preps_pushed.err) { ret err[Fail].err{err_preps_pushed.err}; }
    val err_marks_pushed: err[Fail] = vectors.push[Mark](?c.marks, Mark{row: rw, place: p.address, label: x.s + (x.a:~u64)});
    if (sel err_marks_pushed.err) { ret err[Fail].err{err_marks_pushed.err}; }
    ret err[Fail].ok{};
}

# apply the prepared relocation `i` of the section `sec` of `o`, with the
# value of its partner when its row takes one, or nothing when its partner
# writes the field for both. one that is dead, or whose partner is, is left
# as it was, except a dead absolute address written alone, which takes the
# tombstone
fun apply_one(c: *Context, id: Id[Input], o: *Object, sec: Id[Section], i: usize) err[Fail] {
    val pr: *Prep          = ?c.preps.data[i];
    var x:  compute.Inputs = pr.x;
    if (pr.dead) {
        if (pr.alone && pr.row.value == ?compute.ABS) {
            var site:          Site      = site_of(c, id, pr.at, pr.room);
            val err_tombstone: err[Fail] = engine.tombstone(pr.row, ?site);
            if (sel err_tombstone.err) { ret err_tombstone; }
        }
        ret left_dead(c, id, o, sec, pr.offset);
    }
    if (sel pr.row.pair.some) {
        val rule:        row.PairRule     = pr.row.pair.some;
        val res_partner: res[usize, Fail] = engine.partner(c.marks.data, vector.length[Mark](?c.marks), ?c.slots, i, Location{});
        if (sel res_partner.err)               { ret err[Fail].err{res_partner.err}; }
        if (c.preps.data[res_partner.ok].dead) { ret left_dead(c, id, o, sec, pr.offset); }
        if (!engine.writes(?rule))             { ret err[Fail].ok{}; }
        val pj:                *Prep          = ?c.preps.data[res_partner.ok];
        var sj:                Site           = site_of(c, id, pj.at, pj.room);
        val res_partner_value: res[i64, Fail] = engine.partner_value(pj.row, ?sj, ?pj.x);
        if (sel res_partner_value.err) { ret err[Fail].err{res_partner_value.err}; }
        engine.take_partner(?rule, ?x, res_partner_value.ok);
    }
    var site: Site = site_of(c, id, pr.at, pr.room);
    if (pr.first) { ret engine.apply_first(pr.row, ?site, ?x); }
    ret engine.apply(pr.row, ?site, ?x);
}

# record the relocation at `offset` of the debug section `sec` of `o`, the
# object of `id`, as dead
fun left_dead(c: *Context, id: Id[Input], o: *Object, sec: Id[Section], offset: u64) err[Fail] {
    val err_dead_pushed: err[Fail] = vectors.push[Dead](?c.out.dead, Dead{input: id, section: sec, offset: offset, kind: object.section_at(o, sec).kind});
    if (sel err_dead_pushed.err) { ret err[Fail].err{err_dead_pushed.err}; }
    ret err[Fail].ok{};
}
