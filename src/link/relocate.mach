# how a format resolves a reference to a weak symbol nothing defines
# ---
# zero:     the reference has the value zero
# fallback: the reference resolves to what its fallback binds to, as resolution
#           binds it, and one that reaches no definition is refused
# unruled:  the format states no rule
pub tag Weak: u8 {
    zero;
    fallback;
    unruled;
}

# dynamic:   what each relocation needs, which says whether the loader
#            applies it
# assigned:  the index every entry and symbol reaches, which a relocation
#            that computes an index reads
# pieces:    the pieces of the merged sections and the copies kept
# kind:      the output kind, whose relocatable outputs keep their relocations
# arch:      the architecture
# host:      what the system says for the architecture, which gives the image
#            base
# relocs:    the relocation rows of the output pair
# templates: the code templates of the output pair, which fill the code
#            entries, none for a pair with none
# traits:    the settled traits, which choose each template's form
# weak:      how the format resolves an undefined weak reference
# live:      what collection kept, whose kept FDEs name their CIEs
# sites:     the loader relocation sites, whose addresses this phase fills in
pub rec In {
    inputs:    *Inputs;
    resolved:  *Resolved;
    reserved:  *Reserved;
    dynamic:   *Dynamic;
    assigned:  *Assigned;
    pieces:    *Pieces;
    layout:    *Layout;
    adjusted:  *Adjusted;
    kind:      *Kind;
    arch:      *Arch;
    host:      *Host;
    relocs:    *Lookup;
    templates: opt[*template.Set];
    traits:    *Table[Trait];
    weak:      Weak;
    live:      *Live;
    sites:     *Sites;
}

# a debug relocation whose target lies in dropped code or has no address in
# the image, left as it was
# ---
# input:   the input holding it
# section: the section it patches
# offset:  its offset in that section
# kind:    the debug section's kind
pub rec Dead {
    input:   Id[Input];
    section: Id[Section];
    offset:  u64;
    kind:    *section.Kind;
}

# bytes: the contents of the output sections, relocated, each at its file
#        offset
# dead:  the relocations of debug information left unpatched, whose target
#        lies in dropped code or has no address in the image
pub rec Relocated {
    bytes: Table[u8];
    dead:  Table[Dead];
}

pub fun make(a: *A.Allocator) Relocated {
    ret Relocated{bytes: table.make[u8](a), dead: table.make[Dead](a)};
}

# a relocation of one section in the order they are applied
rec Item {
    section: u32;
    reloc:   u32;
}

# a relocation ready to apply
# ---
# row:    its row
# x:      the addresses its value is computed from
# at:     the file offset of its field
# room:   the bytes from its field to the end of its section's bytes
# offset: its offset in the input section
rec Prep {
    row:    *Row;
    x:      compute.Inputs;
    at:     u64;
    room:   u64;
    offset: u64;
}

# a symbol's definition
rec Found {
    value:  u64;
    input:  Id[Input];
    symbol: Id[Symbol];
}

# what a reference reaches
# ---
# found:    an address
# dead:     a definition the link dropped
# absent:   a name with no address in the image
# weak:     a weak name nothing defines
# absolute: the absolute address zero
tag Reach: u8 {
    found: Found;
    dead;
    absent;
    weak;
    absolute;
}

rec Context {
    in:    *In;
    out:   *Relocated;
    items: Table[Item];
    preps: Table[Prep];
    marks: Table[Mark];
    slots: Table[engine.Slot];
}

# copy the surviving bytes to their places and apply every relocation of the
# surviving sections. running again starts afresh
pub fun run(in: *In, out: *Relocated) err[Fail] {
    table.clear[u8](?out.bytes);
    table.clear[Dead](?out.dead);
    val a: *A.Allocator = in.inputs.a;
    var c: Context      = Context{
        in:    in,
        out:   out,
        items: table.make[Item](a),
        preps: table.make[Prep](a),
        marks: table.make[Mark](a),
        slots: table.make[engine.Slot](a),
    };
    var first: err[Fail] = work(?c);
    first = fail.kept(first, table.release[Item](?c.items));
    first = fail.kept(first, table.release[Prep](?c.preps));
    first = fail.kept(first, table.release[Mark](?c.marks));
    ret fail.kept(first, table.release[engine.Slot](?c.slots));
}

pub fun release(r: *Relocated) err[Fail] {
    val b: err[Fail] = table.release[u8](?r.bytes);
    ret fail.kept(b, table.release[Dead](?r.dead));
}

fun work(c: *Context) err[Fail] {
    val l:    *Layout          = c.in.layout;
    val size: res[usize, Fail] = checked.to_usize(Location{record: "image"}, l.end);
    if (sel size.err) { ret err[Fail].err{size.err}; }
    val g: res[Id[u8], Fail] = table.grow[u8](?c.out.bytes, size.ok);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < table.count[Landing](?l.landings)) {
        val land: *Landing = table.at[Landing](?l.landings, table.nth[Landing](i));
        i = i + 1;
        val member: opt[Id[pieces.Member]] = pieces.member_of(c.in.pieces, land.at);
        if (sel member.some) { cnt; }
        val e: err[Fail] = copy_landing(c, land);
        if (sel e.err) { ret e; }
    }
    val kept: err[Fail] = copy_pieces(c);
    if (sel kept.err) { ret kept; }
    val edited: err[Fail] = write_edits(c);
    if (sel edited.err)                      { ret edited; }
    if (output.has(c.in.kind, output.KEEPS)) { ret err[Fail].ok{}; }
    i = 0;
    for (i < input.count(c.in.inputs)) {
        val e: err[Fail] = patch_input(c, table.nth[Input](i));
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    val f: err[Fail] = restate_frames(c);
    if (sel f.err) { ret f; }
    val s: err[Fail] = fill_slots(c);
    if (sel s.err) { ret s; }
    ret sites.fill(c.in.sites, c.in.layout, c.in.pieces, c.in.reserved);
}

# restate the field of every kept FDE that names its CIE by the distance back
# to it, from where the two were laid out
fun restate_frames(c: *Context) err[Fail] {
    val frames: *Table[collect.Framing] = ?c.in.live.frames;
    var i:      usize                   = 0;
    for (i < table.count[collect.Framing](frames)) {
        val f: collect.Framing = table.items[collect.Framing](frames)[i];
        i = i + 1;
        val at: res[opt[layout.Position], Fail] = layout.locate(c.in.layout, c.in.pieces, f.at, f.field);
        if (sel at.err) { ret err[Fail].err{at.err}; }
        val to: res[opt[layout.Position], Fail] = layout.locate(c.in.layout, c.in.pieces, f.at, f.cie);
        if (sel to.err)     { ret err[Fail].err{to.err}; }
        if (sel at.ok.none) { ret err[Fail].err{placed(fail.internal("a kept FDE was not laid out"), c, f.at.input, f.at.section.index, f.field)}; }
        val p: layout.Position = at.ok.some;
        if (sel to.ok.none) { ret err[Fail].err{placed(fail.internal("the CIE a kept FDE names was not laid out"), c, f.at.input, f.at.section.index, f.field)}; }
        val q: layout.Position = to.ok.some;
        if (q.address > p.address || p.address - q.address > 0xffff_ffff) { ret err[Fail].err{placed(fail.overflow("an FDE lies past 4 GiB after the CIE it names"), c, f.at.input, f.at.section.index, f.field)}; }
        binary.put_uint(?table.items[u8](?c.out.bytes)[p.file::usize], p.address - q.address, 4, c.in.arch.order);
    }
    ret err[Fail].ok{};
}

# write every slot of each table the format states the contents of: the
# target's address or thread pointer offset in a slot that holds it, unless
# the loader binds the slot, and its role's template in an entry a template
# fills, the table's head first where it has one. a slot or a code entry the
# image writer writes is left to it, and a copy is the loader's to fill
fun fill_slots(c: *Context) err[Fail] {
    var i: usize = 0;
    for (i < slot.SLOT_ROLES) {
        val role: *SlotRole               = slot.at(i);
        val row:  opt[*reserve.SlotTable] = c.in.reserved.stated[i];
        val n:    usize                   = table.count[dynamic.Entry](dynamic.entries_of(c.in.dynamic, role));
        i = i + 1;
        if (sel row.none) { cnt; }
        if (n == 0)       { cnt; }
        val contents: reserve.Contents = row.some.contents;
        if (sel contents.written || sel contents.emitted || sel contents.copied) { cnt; }
        if (!sel contents.code) {
            var k: usize = 0;
            for (k < n) {
                val e: err[Fail] = fill_slot(c, role, k::u32, sel contents.offset);
                if (sel e.err) { ret err[Fail].err{fail.in_indexed(fail.in_record(e.err, row.some.name), "slot", k::u64)}; }
                k = k + 1;
            }
            cnt;
        }
        val e: err[Fail] = fill_table(c, role, row.some, n);
        if (sel e.err) { ret err[Fail].err{fail.in_record(e.err, row.some.name)}; }
    }
    ret err[Fail].ok{};
}

# write the head and each of the `n` entries of the table `row` of role `r`
# its role's template fills. a slot's template is bound through the code
# entry that goes to it, found by an index built once
fun fill_table(c: *Context, r: *SlotRole, row: *reserve.SlotTable, n: usize) err[Fail] {
    val filled: opt[*slot.Role] = r.template;
    if (sel filled.none) { ret err[Fail].err{fail.about(fail.internal("a table of code is of a role no template fills"), r.name)}; }
    val got: res[*template.Template, Fail] = template.chosen(c.in.templates, filled.some, c.in.kind, c.in.traits);
    if (sel got.err) { ret err[Fail].err{got.err}; }
    val head: opt[*slot.Role] = row.head;
    if (sel head.some) {
        val h: err[Fail] = fill_head(c, r, head.some);
        if (sel h.err) { ret h; }
    }
    var back: Table[u32] = table.make[u32](c.in.inputs.a);
    var e:    err[Fail]  = err[Fail].ok{};
    if (!sel r.reach.called) { e = goes_to(c, r, n, ?back); }
    var k: usize = 0;
    for (k < n && sel e.ok) {
        val f: err[Fail] = fill_code(c, r, k::u32, got.ok, ?back);
        if (sel f.err) { e = err[Fail].err{fail.in_indexed(f.err, "slot", k::u64)}; }
        k = k + 1;
    }
    ret fail.kept(e, table.release[u32](?back));
}

# in `back`, per slot of role `r`, the index plus one of the code entry that
# goes to it, zero for none
fun goes_to(c: *Context, r: *SlotRole, n: usize, back: *Table[u32]) err[Fail] {
    val g: res[Id[u32], Fail] = table.grow[u32](back, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    val first: *dynamic.Entry = table.at[dynamic.Entry](dynamic.entries_of(c.in.dynamic, r), table.nth[dynamic.Entry](0));
    val w:     *dynamic.Route = first.route;
    if (w == nil) { ret err[Fail].err{fail.internal("a slot was made by no route")}; }
    val by: opt[*SlotRole] = w.through;
    if (sel by.none) { ret err[Fail].ok{}; }
    if (w.role != r) { ret err[Fail].ok{}; }
    val code: *Table[dynamic.Entry] = dynamic.entries_of(c.in.dynamic, by.some);
    var j:    usize                 = 0;
    for (j < table.count[dynamic.Entry](code)) {
        val lands: u32 = table.at[dynamic.Entry](code, table.nth[dynamic.Entry](j)).lands;
        if (lands::usize >= n) { ret err[Fail].err{fail.internal("a code entry lands past the slots of its route's role")}; }
        table.items[u32](back)[lands::usize] = (j + 1)::u32;
        j                                    = j + 1;
    }
    ret err[Fail].ok{};
}

# where the table holding the slots of role `r` starts, none when no table
# holds one
fun table_start(c: *Context, r: *SlotRole) res[opt[layout.Position], Fail] {
    val s: opt[*reserve.Slot] = reserve.slot_of(c.in.reserved, r, 0);
    if (sel s.none) { ret res[opt[layout.Position], Fail].ok{opt[layout.Position].none{}}; }
    val p: res[layout.Position, Fail] = layout.slot_position(c.in.layout, c.in.reserved, r, 0);
    if (sel p.err) { ret res[opt[layout.Position], Fail].err{p.err}; }
    var at: layout.Position = p.ok;
    at.offset  = at.offset - s.some.offset;
    at.address = at.address - s.some.offset;
    at.file    = at.file - s.some.offset;
    ret res[opt[layout.Position], Fail].ok{opt[layout.Position].some{at}};
}

# the values every template of the link may reach whatever entry it fills:
# the start of the GOT of the PLT and the dynamic section, each bound only
# where the link holds it
fun shared_bounds(c: *Context, bound: *template.Bound, count: *usize) err[Fail] {
    val g: res[opt[layout.Position], Fail] = table_start(c, ?slot.GOT_PLT);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    if (sel g.ok.some) {
        bound[@count] = template.Bound{target: ?template.GOT_PLT, value: g.ok.some.address};
        @count        = @count + 1;
    }
    val d: opt[Id[reserve.Reservation]] = reserve.anchored(c.in.reserved, ?template.DYNAMIC_SECTION);
    if (sel d.some) {
        val sp: res[layout.Span, Fail] = layout.span_of(c.in.layout, c.in.reserved, d.some);
        if (sel sp.err) { ret err[Fail].err{sp.err}; }
        bound[@count] = template.Bound{target: ?template.DYNAMIC, value: sp.ok.address};
        @count        = @count + 1;
    }
    ret err[Fail].ok{};
}

# the address of the head of the table holding the entries of role `r`,
# none when its table has no head
fun head_of(c: *Context, r: *SlotRole) res[opt[u64], Fail] {
    val row: opt[*reserve.SlotTable] = c.in.reserved.stated[r.at::usize];
    if (sel row.none)           { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    if (sel row.some.head.none) { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    val at: res[opt[layout.Position], Fail] = table_start(c, r);
    if (sel at.err)     { ret res[opt[u64], Fail].err{at.err}; }
    if (sel at.ok.none) { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    ret res[opt[u64], Fail].ok{opt[u64].some{at.ok.some.address}};
}

# write the head of the template role `h` at the start of the table of the
# entries of role `r`
fun fill_head(c: *Context, r: *SlotRole, h: *slot.Role) err[Fail] {
    val t: res[*template.Template, Fail] = template.chosen(c.in.templates, h, c.in.kind, c.in.traits);
    if (sel t.err) { ret err[Fail].err{t.err}; }
    val at: res[opt[layout.Position], Fail] = table_start(c, r);
    if (sel at.err)     { ret err[Fail].err{at.err}; }
    if (sel at.ok.none) { ret err[Fail].err{fail.internal("a table with a head holds no slot")}; }
    val p: layout.Position = at.ok.some;
    val m: *Merged         = table.at[Merged](?c.in.layout.merged, p.merged);
    if (!section.has(m.kind, section.BITS))                     { ret err[Fail].err{fail.internal("a table's head lies in zero fill")}; }
    if (p.file + t.ok.len > table.count[u8](?c.out.bytes)::u64) { ret err[Fail].err{fail.internal("a table's head lies outside the image bytes")}; }
    var bound: [6]template.Bound;
    bound[0] = template.Bound{target: ?template.HEADER, value: p.address};
    var count: usize     = 1;
    val sh:    err[Fail] = shared_bounds(c, ?bound[0], ?count);
    if (sel sh.err) { ret sh; }
    ret template.emit(c.in.relocs, t.ok, ?table.items[u8](?c.out.bytes)[p.file::usize], p.address, ?bound[0], count);
}

# write the entry of role `r` the target `k` takes with the template `t`. a
# code entry is patched with its own address, the slot it lands in and that
# slot's index, and the head of its table. a slot is patched with its own
# address and index, and the address of the code entry that goes to it,
# which `back` holds, and the head of that entry's table
fun fill_code(c: *Context, r: *SlotRole, k: u32, t: *template.Template, back: *Table[u32]) err[Fail] {
    val e: *dynamic.Entry             = table.at[dynamic.Entry](dynamic.entries_of(c.in.dynamic, r), table.nth[dynamic.Entry](k::usize));
    val p: res[layout.Position, Fail] = layout.slot_position(c.in.layout, c.in.reserved, r, k);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    val m: *Merged = table.at[Merged](?c.in.layout.merged, p.ok.merged);
    if (!section.has(m.kind, section.BITS))                     { ret err[Fail].err{fail.internal("a code entry lies in zero fill")}; }
    if (p.ok.file + t.len > table.count[u8](?c.out.bytes)::u64) { ret err[Fail].err{fail.internal("a code entry lies outside the image bytes")}; }
    val w: *dynamic.Route = e.route;
    if (w == nil) { ret err[Fail].err{fail.internal("a code entry was made by no route")}; }
    var bound: [6]template.Bound;
    var count: usize          = 0;
    var code:  *SlotRole      = r;
    var at:    u64            = p.ok.address;
    val by:    opt[*SlotRole] = w.through;
    if (sel r.reach.called) {
        if (leads(w, r)) {
            val lands: res[u64, Fail] = layout.slot_address(c.in.layout, c.in.reserved, w.role, e.lands);
            if (sel lands.err) { ret err[Fail].err{lands.err}; }
            bound[0] = template.Bound{target: ?template.SLOT, value: lands.ok};
            bound[1] = template.Bound{target: ?template.INDEX, value: e.lands::u64};
            count    = 2;
        }
    }
    or {
        bound[0] = template.Bound{target: ?template.SLOT, value: p.ok.address};
        bound[1] = template.Bound{target: ?template.INDEX, value: k::u64};
        count    = 2;
        val j: u32 = table.items[u32](back)[k::usize];
        code = nil;
        if (sel by.some) {
            if (j != 0) {
                val from: res[u64, Fail] = layout.slot_address(c.in.layout, c.in.reserved, by.some, j - 1);
                if (sel from.err) { ret err[Fail].err{from.err}; }
                code = by.some;
                at   = from.ok;
            }
        }
    }
    if (code != nil) {
        bound[count] = template.Bound{target: ?template.ENTRY, value: at};
        count        = count + 1;
        val h: res[opt[u64], Fail] = head_of(c, code);
        if (sel h.err) { ret err[Fail].err{h.err}; }
        if (sel h.ok.some) {
            bound[count] = template.Bound{target: ?template.HEADER, value: h.ok.some};
            count        = count + 1;
        }
    }
    val sh: err[Fail] = shared_bounds(c, ?bound[0], ?count);
    if (sel sh.err) { ret sh; }
    ret template.emit(c.in.relocs, t, ?table.items[u8](?c.out.bytes)[p.ok.file::usize], p.ok.address, ?bound[0], count);
}

# write the slot of role `r` the target `k` takes with its target's address,
# or the address of the entry it leads to when a reference goes through it,
# or its thread pointer offset when `offset`, or for a slot the loader adds
# the image's thread pointer offset to, its offset in the thread-local block
fun fill_slot(c: *Context, r: *SlotRole, k: u32, offset: bool) err[Fail] {
    val e: *dynamic.Entry = table.at[dynamic.Entry](dynamic.entries_of(c.in.dynamic, r), table.nth[dynamic.Entry](k::usize));
    if (dynamic.has(e.outcome, dynamic.BIND_ENTRY)) { ret err[Fail].ok{}; }
    val width: opt[u8] = arch.pointer_bytes(c.in.arch);
    if (sel width.none) { ret err[Fail].err{fail.about(fail.unsupported("the architecture states no pointer width a slot holds"), c.in.arch.name)}; }
    val p: res[layout.Position, Fail] = layout.slot_position(c.in.layout, c.in.reserved, r, k);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    val m: *Merged = table.at[Merged](?c.in.layout.merged, p.ok.merged);
    if (!section.has(m.kind, section.BITS)) { ret err[Fail].err{fail.internal("a slot the link writes lies in zero fill")}; }
    val n: u64            = width.some::u64;
    var v: res[u64, Fail] = res[u64, Fail].err{fail.internal("a slot's value was never taken")};
    val w: *dynamic.Route = e.route;
    if (leads(w, r))                                        { v = layout.slot_address(c.in.layout, c.in.reserved, w.role, e.lands); }
    or                                                      { v = slot_value(c, e, n, offset); }
    if (sel v.err)                                          { ret err[Fail].err{v.err}; }
    if (n < 8 && (v.ok >> (n * 8)) != 0)                    { ret err[Fail].err{fail.valued(fail.overflow("a slot's target does not fit its pointer"), v.ok::i128)}; }
    if (p.ok.file + n > table.count[u8](?c.out.bytes)::u64) { ret err[Fail].err{fail.internal("a slot lies outside the image bytes")}; }
    binary.put_uint(?table.items[u8](?c.out.bytes)[p.ok.file::usize], v.ok, n::usize, c.in.arch.order);
    ret err[Fail].ok{};
}

# whether an entry of role `r` made by the route `w` is one a reference goes
# through on its way to the entry it leads to
fun leads(w: *dynamic.Route, r: *SlotRole) bool {
    if (w == nil) { ret false; }
    val by: opt[*SlotRole] = w.through;
    if (sel by.some) { ret by.some == r; }
    ret false;
}

# what a slot of `n` bytes for the entry `e` holds: its target's address, or
# when `offset` its thread pointer offset, or its offset in the thread-local
# block where the loader adds the image's thread pointer offset
fun slot_value(c: *Context, e: *dynamic.Entry, n: u64, offset: bool) res[u64, Fail] {
    val tpoff: bool = dynamic.has(e.outcome, dynamic.TPOFF_ENTRY);
    if (tpoff && !offset) { ret res[u64, Fail].err{fail.internal("the loader adds a thread pointer offset to a slot that holds an address")}; }
    if (tpoff)            { ret block_offset(c, e.aim); }
    if (offset)           { ret thread_offset(c, e.aim, n); }
    ret aimed(c, e.aim);
}

# the offset of what a slot aims at in the image's thread-local block
fun block_offset(c: *Context, aim: dynamic.Aim) res[u64, Fail] {
    if (sel aim.absent) { ret res[u64, Fail].err{fail.unsupported("a thread-local variable nothing defines has no offset in a thread-local block")}; }
    val s: res[u64, Fail] = aimed(c, aim);
    if (sel s.err) { ret s; }
    val b: res[layout.Tls, Fail] = layout.thread_block(c.in.layout);
    if (sel b.err)                                              { ret res[u64, Fail].err{b.err}; }
    if (s.ok < b.ok.address || s.ok - b.ok.address > b.ok.size) { ret res[u64, Fail].err{fail.valued(fail.internal("a thread-local variable lies outside the thread-local block"), s.ok::i128)}; }
    ret res[u64, Fail].ok{s.ok - b.ok.address};
}

# the offset from the thread pointer of what a slot aims at, as the `n` bytes
# of a pointer hold it
fun thread_offset(c: *Context, aim: dynamic.Aim, n: u64) res[u64, Fail] {
    if (sel aim.absent) { ret res[u64, Fail].err{fail.unsupported("a thread-local variable nothing defines has no thread pointer offset")}; }
    val s: res[u64, Fail] = aimed(c, aim);
    if (sel s.err) { ret s; }
    val t: res[layout.Anchors, Fail] = layout.thread_anchors(c.in.layout);
    if (sel t.err) { ret res[u64, Fail].err{t.err}; }
    var x: compute.Inputs  = compute.Inputs{s: s.ok, tp: t.ok.tp};
    val v: res[i128, Fail] = compute.TPOFF.value(?x);
    if (sel v.err) { ret res[u64, Fail].err{v.err}; }
    val bits: u64  = n * 8;
    val half: i128 = 1::i128 << (bits - 1)::i128;
    if (v.ok < -half || v.ok >= half) { ret res[u64, Fail].err{fail.valued(fail.overflow("a thread pointer offset does not fit its slot"), v.ok)}; }
    var w: i128 = v.ok;
    if (w < 0) { w = w + (1::i128 << bits::i128); }
    ret res[u64, Fail].ok{w::u64};
}

# the address of what a slot aims at: its definition's, the place a name
# the link defines puts it at, zero for the absolute address and, by the
# format's rule, for a weak name nothing defines
fun aimed(c: *Context, aim: dynamic.Aim) res[u64, Fail] {
    val in: *In      = c.in;
    var at: opt[u64] = opt[u64].none{};
    if (sel aim.bound || sel aim.local || sel aim.linked) { at = address_of(in.layout, in.resolved, aim); }
    or (sel aim.absolute)                                 { ret res[u64, Fail].ok{0}; }
    or (sel aim.absent) {
        if (sel in.weak.zero)     { ret res[u64, Fail].ok{0}; }
        if (sel in.weak.fallback) { ret res[u64, Fail].err{fail.malformed("a weak reference reaches no definition through a fallback")}; }
        ret res[u64, Fail].err{fail.unsupported("the format has no rule for an undefined weak reference")};
    }
    or (sel aim.imported) { ret res[u64, Fail].err{fail.internal("a slot the link writes aims at an import, which the loader binds")}; }
    or (sel aim.entry)    { ret res[u64, Fail].err{fail.internal("a slot aims at an index space entry")}; }
    if (sel at.none)      { ret res[u64, Fail].err{fail.malformed("a slot's target has no address in the image")}; }
    ret res[u64, Fail].ok{at.some};
}

# the address in the image of what `aim` names: its definition's, or the
# place a name the link defines puts it at. none for an aim that names no
# place of the image, as an import or a dropped definition
pub fun address_of(l: *Layout, r: *Resolved, aim: dynamic.Aim) opt[u64] {
    if (sel aim.bound) {
        val b: *resolve.Binding = table.at[resolve.Binding](?r.bindings, aim.bound);
        ret layout.value_of(l, b.input, b.symbol);
    }
    or (sel aim.local)  { ret layout.value_of(l, aim.local.input, aim.local.symbol); }
    or (sel aim.linked) { ret layout.linked_value(l, r, aim.linked); }
    ret opt[u64].none{};
}

fun by_reloc(a: *Item, b: *Item) i64 {
    if (a.section != b.section) {
        if (a.section < b.section) { ret -1; }
        ret 1;
    }
    if (a.reloc < b.reloc) { ret -1; }
    if (a.reloc > b.reloc) { ret 1; }
    ret 0;
}

# the bytes of a landed section, in the runs its cuts leave, which layout
# keeps in ascending order
fun copy_landing(c: *Context, g: *Landing) err[Fail] {
    val l: *Layout  = c.in.layout;
    val o: *Object  = input.object_of(c.in.inputs, g.at.input);
    val s: *Section = object.section_at(o, g.at.section);
    if (sel s.contents.zero) { ret err[Fail].ok{}; }
    val b:    Bytes          = object.bytes(o, ?s.contents);
    val m:    *Merged        = table.at[Merged](?l.merged, g.merged);
    val at:   Location       = Location{file: input.at(c.in.inputs, g.at.input).name, record: "output section"};
    val head: res[u64, Fail] = checked.add(at, m.offset, g.offset);
    if (sel head.err) { ret err[Fail].err{head.err}; }
    val n:     u32 = g.cut_count;
    var from:  u64 = 0;
    var shift: u64 = 0;
    var i:     u32 = 0;
    for (i <= n) {
        var stop: u64 = g.source;
        if (i < n)       { stop = table.at[Cut](?l.cuts, table.nth[Cut]((g.cut_first + i)::usize)).start; }
        if (stop < from) { ret err[Fail].err{fail.in_file(fail.internal("the cut ranges of a section overlap"), at.file)}; }
        if (stop > from) {
            val e: err[Fail] = copy_run(c, b, from, stop, head.ok + from - shift, at);
            if (sel e.err) { ret e; }
        }
        if (i < n) {
            val cut: *Cut = table.at[Cut](?l.cuts, table.nth[Cut]((g.cut_first + i)::usize));
            from  = cut.end;
            shift = shift + cut.removed;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bytes every edit of a participant writes, over the copied bytes of the
# section it edits, where layout put them
fun write_edits(c: *Context) err[Fail] {
    val a: *Adjusted = c.in.adjusted;
    var i: usize     = 0;
    for (i < table.count[adjust.Edit](?a.edits)) {
        val e: *adjust.Edit = table.at[adjust.Edit](?a.edits, table.nth[adjust.Edit](i));
        i = i + 1;
        if (!sel e.change.write) { cnt; }
        val w:   adjust.Written                  = e.change.write;
        val pos: res[opt[layout.Position], Fail] = layout.locate(c.in.layout, c.in.pieces, e.at, e.offset);
        if (sel pos.err)     { ret err[Fail].err{pos.err}; }
        if (sel pos.ok.none) { ret err[Fail].err{fail.in_indexed(fail.internal("an edit writes bytes that did not land"), "edit", (i - 1)::u64)}; }
        val o:    *Object          = input.object_of(c.in.inputs, e.at.input);
        val s:    *Section         = object.section_at(o, e.at.section);
        val end:  u64              = e.offset + w.len::u64;
        val l:    opt[Id[Landing]] = layout.landing_of(c.in.layout, e.at);
        val past: Fail             = fail.in_indexed(fail.internal("an edit writes past the bytes of its section"), "edit", (i - 1)::u64);
        if (sel l.none)                                                    { ret err[Fail].err{past}; }
        if (end > table.at[Landing](?c.in.layout.landings, l.some).source) { ret err[Fail].err{past}; }
        if (sel s.contents.zero)                                           { ret err[Fail].err{past}; }
        val at: u64 = pos.ok.some.file;
        if (at + w.len::u64 > table.count[u8](?c.out.bytes)::u64) { ret err[Fail].err{fail.in_indexed(fail.internal("an edit writes outside the image bytes"), "edit", (i - 1)::u64)}; }
        memory.copy[u8](?table.items[u8](?c.out.bytes)[at::usize], adjust.written(a, w), w.len);
    }
    ret err[Fail].ok{};
}

# the bytes of every kept piece, at its place in its group's block
fun copy_pieces(c: *Context) err[Fail] {
    val p: *Pieces = c.in.pieces;
    var i: usize   = 0;
    for (i < table.count[Piece](?p.pieces)) {
        val id: Id[Piece] = table.nth[Piece](i);
        val pc: *Piece    = table.at[Piece](?p.pieces, id);
        i = i + 1;
        if (!pc.live || pc.kept.index != id.index) { cnt; }
        val at:  Ref                             = table.at[pieces.Member](?p.members, pc.member).at;
        val pos: res[opt[layout.Position], Fail] = layout.locate(c.in.layout, p, at, pc.offset);
        if (sel pos.err)     { ret err[Fail].err{pos.err}; }
        if (sel pos.ok.none) { ret err[Fail].err{fail.internal("a kept piece of a merged section did not land")}; }
        val o:    *Object   = input.object_of(c.in.inputs, at.input);
        val b:    Bytes     = object.bytes(o, ?object.section_at(o, at.section).contents);
        val here: Location  = Location{file: input.at(c.in.inputs, at.input).name, record: "merged section"};
        val e:    err[Fail] = copy_run(c, b, pc.offset, pc.offset + pc.size, pos.ok.some.file, here);
        if (sel e.err) { ret e; }
    }
    ret err[Fail].ok{};
}

fun copy_run(c: *Context, b: Bytes, from: u64, stop: u64, dest: u64, at: Location) err[Fail] {
    val end: res[u64, Fail] = checked.add(at, dest, stop - from);
    if (sel end.err) { ret err[Fail].err{end.err}; }
    if (stop > b.len::u64 || end.ok > table.count[u8](?c.out.bytes)::u64) {
        ret err[Fail].err{fail.in_file(fail.internal("a section lands outside the image bytes"), at.file)};
    }
    memory.copy[u8](?table.items[u8](?c.out.bytes)[dest::usize], ?b.data[from::usize], (stop - from)::usize);
    ret err[Fail].ok{};
}

fun patch_input(c: *Context, id: Id[Input]) err[Fail] {
    val o: *Object = input.object_of(c.in.inputs, id);
    if (o == nil) { ret err[Fail].ok{}; }
    val n: usize = table.count[Reloc](?o.relocs);
    table.clear[Item](?c.items);
    var i: usize = 0;
    for (i < n) {
        val r: *Reloc              = table.at[Reloc](?o.relocs, table.nth[Reloc](i));
        val p: res[Id[Item], Fail] = table.push[Item](?c.items, Item{section: r.section.index, reloc: i::u32});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    sort.sort_by[Item](table.items[Item](?c.items), n, by_reloc);
    var first: usize = 0;
    for (first < n) {
        val sec:  u32   = table.items[Item](?c.items)[first].section;
        var last: usize = first;
        for (last < n && table.items[Item](?c.items)[last].section == sec) {
            last = last + 1;
        }
        val e: err[Fail] = patch_section(c, id, o, sec, first, last);
        if (sel e.err) { ret e; }
        first = last;
    }
    ret err[Fail].ok{};
}

# the relocations first up to last of the section `sec`, prepared and then
# applied, so a relocation can read its partner's
fun patch_section(c: *Context, id: Id[Input], o: *Object, sec: u32, first: usize, last: usize) err[Fail] {
    val ref: Ref              = Ref{input: id, section: Id[Section]{index: sec}};
    val lid: opt[Id[Landing]] = layout.landing_of(c.in.layout, ref);
    if (sel lid.none) { ret err[Fail].ok{}; }
    val g: *Landing = table.at[Landing](?c.in.layout.landings, lid.some);
    table.clear[Prep](?c.preps);
    table.clear[Mark](?c.marks);
    var k: usize = first;
    for (k < last) {
        val ri: u32       = table.items[Item](?c.items)[k].reloc;
        val e:  err[Fail] = prepare(c, id, o, ref, g, ri);
        if (sel e.err) { ret err[Fail].err{placed(e.err, c, id, sec, table.at[Reloc](?o.relocs, table.nth[Reloc](ri::usize)).offset)}; }
        k = k + 1;
    }
    val ordered: err[Fail] = engine.order(table.items[Mark](?c.marks), table.count[Mark](?c.marks), ?c.slots);
    if (sel ordered.err) { ret ordered; }
    var i: usize = 0;
    for (i < table.count[Prep](?c.preps)) {
        val e: err[Fail] = apply_one(c, id, i);
        if (sel e.err) { ret err[Fail].err{placed(e.err, c, id, sec, table.items[Prep](?c.preps)[i].offset)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the failure `f` in the section `sec` of the input `id`, at the field's offset
fun placed(f: Fail, c: *Context, id: Id[Input], sec: u32, offset: u64) Fail {
    if (fail.is_refused(f)) { ret f; }
    var out: Fail = f;
    out.at = Location{
        file:    input.at(c.in.inputs, id).name,
        record:  "section",
        index:   sec::u64,
        indexed: true,
        offset:  offset,
        placed:  true,
    };
    ret out;
}

# what the relocation `ri` of the input `id` needs
fun decision_of(c: *Context, id: Id[Input], ri: u32) res[*Decision, Fail] {
    ret dynamic.decision_of(c.in.dynamic, id, ri);
}

fun site_of(c: *Context, id: Id[Input], at: u64, room: u64) Site {
    ret Site{
        file:    input.at(c.in.inputs, id).name,
        section: "section",
        data:    ?table.items[u8](?c.out.bytes)[at::usize],
        size:    room,
        order:   c.in.arch.order,
    };
}

# prepare the relocation `ri`, leaving it out when it patches nothing here
fun prepare(c: *Context, id: Id[Input], o: *Object, ref: Ref, g: *Landing, ri: u32) err[Fail] {
    val in:  *In              = c.in;
    val rel: *Reloc           = table.at[Reloc](?o.relocs, table.nth[Reloc](ri::usize));
    val tk:  res[Taken, Fail] = taken(c, id, rel, ri);
    if (sel tk.err) { ret err[Fail].err{tk.err}; }
    val kind:   *reloc.Kind = tk.ok.kind;
    val offset: u64         = tk.ok.offset;
    if (reloc.has(kind, reloc.MARKER)) { ret aligned(c, ref, rel); }
    val own: res[bool, Fail] = pieces.own_copy(in.pieces, ref, offset);
    if (sel own.err) { ret err[Fail].err{own.err}; }
    if (!own.ok)     { ret err[Fail].ok{}; }
    val pos: res[opt[layout.Position], Fail] = layout.locate(in.layout, in.pieces, ref, offset);
    if (sel pos.err)     { ret err[Fail].err{pos.err}; }
    if (sel pos.ok.none) { ret err[Fail].ok{}; }
    val p:   layout.Position      = pos.ok.some;
    val dec: res[*Decision, Fail] = decision_of(c, id, ri);
    if (sel dec.err)       { ret err[Fail].err{dec.err}; }
    if (dec.ok.row == nil) { ret err[Fail].ok{}; }
    val need: *dynamic.Outcome = dec.ok.row.outcome;
    if (dynamic.has(need, dynamic.BIND_SITE)) { ret err[Fail].ok{}; }
    val s: *Section = object.section_at(o, rel.section);
    if (sel s.contents.zero) { ret err[Fail].err{fail.malformed("a relocation patches a zero-fill section")}; }
    var reach: Reach = Reach.absolute{};
    if (sel rel.target.none)   { ret err[Fail].err{fail.internal("a relocation that computes a value reached the link with no target")}; }
    or (sel rel.target.symbol) { reach = reach_of(c, id, rel.target.symbol); }
    val rw: res[*Row, Fail] = row.targeting(c.in.relocs, kind, sel rel.minus.some);
    if (sel rw.err) { ret err[Fail].err{rw.err}; }

    val m:    *Merged        = table.at[Merged](?in.layout.merged, g.merged);
    val room: u64            = m.offset + g.offset + g.size - p.file;
    var x:    compute.Inputs = compute.Inputs{p: p.address, page: arch.page_bytes(in.arch), width: arch.pointer_bytes(in.arch)};
    if (sel rel.target.entry) { ret entry_index(c, id, rel, rw.ok, x, p, room); }

    val value:  *compute.Computation = rw.ok.value;
    val direct: bool                 = dynamic.has(need, dynamic.AT_TARGET);
    val held:   opt[*SlotRole]       = dynamic.standing(dec.ok);
    val stood:  bool                 = sel held.some;
    val wants:  bool                 = (compute.needs(value, compute.NEEDS_S) && !stood) || (compute.needs(value, compute.NEEDS_L) && direct);
    var found:  Found;
    if (sel reach.found) {
        found = reach.found;
        x.s   = found.value;
    }
    or (sel reach.absolute) { x.s = 0; }
    or (sel reach.dead) {
        if (section.has(s.kind, section.DEBUG)) {
            val d: res[Id[Dead], Fail] = table.push[Dead](?c.out.dead, Dead{input: id, section: rel.section, offset: offset, kind: s.kind});
            if (sel d.err) { ret err[Fail].err{d.err}; }
            ret err[Fail].ok{};
        }
        ret err[Fail].err{fail.malformed("a relocation refers to code the link dropped")};
    }
    or (sel reach.absent) {
        if (wants && section.has(s.kind, section.DEBUG)) {
            val d: res[Id[Dead], Fail] = table.push[Dead](?c.out.dead, Dead{input: id, section: rel.section, offset: offset, kind: s.kind});
            if (sel d.err) { ret err[Fail].err{d.err}; }
            ret err[Fail].ok{};
        }
        if (wants) { ret err[Fail].err{fail.unsupported("a relocation refers to a name with no address in the image")}; }
    }
    or {
        if (wants) {
            if (sel in.weak.fallback) {
                ret err[Fail].err{fail.malformed("a weak reference reaches no definition through a fallback")};
            }
            if (sel in.weak.unruled) {
                ret err[Fail].err{fail.unsupported("the format has no rule for an undefined weak reference")};
            }
        }
    }

    var site: Site           = site_of(c, id, p.file, room);
    val add:  res[i64, Fail] = engine.addend(rw.ok, ?site, rel.addend);
    if (sel add.err) { ret err[Fail].err{add.err}; }
    x.a = add.ok;
    if (sel reach.found) {
        val kept: err[Fail] = into_piece(c, found, rw.ok, ?x);
        if (sel kept.err) { ret kept; }
    }
    val anchored: err[Fail] = anchor(c, dec.ok, value, ?x);
    if (sel anchored.err)                                { ret err[Fail].err{anchored.err}; }
    if (direct && compute.needs(value, compute.NEEDS_L)) { x.anchors[slot.PLT.at] = x.s; }
    if (reloc.has(kind, reloc.IMAGE))                    { x.base = in.host.image_base; }
    if (compute.needs(value, compute.NEEDS_INDEX)) {
        val n: res[u64, Fail] = assign.target_index(in.assigned, id, rel.target);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        x.index = n.ok;
    }
    if (compute.needs(value, compute.NEEDS_OUT_SECTION)) {
        if (!sel reach.found) { ret err[Fail].err{fail.malformed("a relocation asks for the section of a name with no definition")}; }
        val n: res[u64, Fail] = section_index(c, found);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        x.out_section = n.ok;
    }
    if (reloc.has(kind, reloc.SIZE) || reloc.has(kind, reloc.SECREL)) {
        if (!sel reach.found) { ret err[Fail].err{fail.malformed("a relocation asks for the size or section of a name with no definition")}; }
    }
    if (reloc.has(kind, reloc.SIZE)) {
        val sym: *Symbol = object.symbol_at(input.object_of(in.inputs, found.input), found.symbol);
        if (sel sym.size.none) { ret err[Fail].err{fail.malformed("the symbol states no size")}; }
        x.z = sym.size.some;
    }
    if (reloc.has(kind, reloc.SECREL)) {
        val b: res[u64, Fail] = section_base(c, found);
        if (sel b.err) { ret err[Fail].err{b.err}; }
        x.section = b.ok;
    }
    if (reloc.has(kind, reloc.PAIR)) {
        if (sel rel.minus.none) { ret err[Fail].err{fail.malformed("a difference relocation names no subtracted symbol")}; }
        val sub: Reach = reach_of(c, id, rel.minus.some);
        if (!sel sub.found) { ret err[Fail].err{fail.malformed("the subtracted symbol has no address")}; }
        x.b = sub.found.value;
    }

    if (sel rel.minus.none) { ret queued(c, rw.ok, x, p, room, offset); }
    # a difference is its set's two records, one adding the target and the
    # addend, one subtracting the second symbol
    val pair: res[*Pairing, Fail] = row.difference_of(c.in.relocs, kind);
    if (sel pair.err) { ret err[Fail].err{pair.err}; }
    var less: compute.Inputs = x;
    less.s = x.b;
    less.a = 0;
    if (pair.ok.difference.minus_first) {
        val m: err[Fail] = queued(c, pair.ok.minus, less, p, room, offset);
        if (sel m.err) { ret m; }
        ret queued(c, rw.ok, x, p, room, offset);
    }
    val plus: err[Fail] = queued(c, rw.ok, x, p, room, offset);
    if (sel plus.err) { ret plus; }
    ret queued(c, pair.ok.minus, less, p, room, offset);
}

# the kind a relocation is applied as and the offset of its place
rec Taken {
    kind:   *reloc.Kind;
    offset: u64;
}

# how the relocation `rel`, the `ri`th of the input `id`, is applied: as the
# kind of the form chosen for it at the place the form moves it to, or as
# itself
fun taken(c: *Context, id: Id[Input], rel: *Reloc, ri: u32) res[Taken, Fail] {
    val ch: opt[*adjust.Choice] = adjust.choice_of(c.in.adjusted, id, Id[Reloc]{index: ri});
    if (sel ch.none) { ret res[Taken, Fail].ok{Taken{kind: rel.kind, offset: rel.offset}}; }
    val chosen: *adjust.Choice = ch.some;
    if (chosen.nth != 0) { ret res[Taken, Fail].ok{Taken{kind: adjust.kind_of(chosen), offset: rel.offset}}; }
    val moves: i64 = chosen.rewrite.emit.moves::i64;
    if (moves < 0 && (-moves)::u64 > rel.offset) { ret res[Taken, Fail].err{fail.malformed("a rewritten relocation moves before its section")}; }
    var offset: u64 = rel.offset + moves::u64;
    if (moves < 0) { offset = rel.offset - (-moves)::u64; }
    ret res[Taken, Fail].ok{Taken{kind: adjust.kind_of(chosen), offset: offset}};
}

# check the marker `rel`, which patches nothing: a place its row aligns must
# already sit on its boundary at its final address, as no padding before it is
# deleted, and is refused otherwise
fun aligned(c: *Context, ref: Ref, rel: *Reloc) err[Fail] {
    val in: *In             = c.in;
    val rw: res[*Row, Fail] = row.writing(in.relocs, rel.kind);
    if (sel rw.err) { ret err[Fail].err{rw.err}; }
    val b: res[opt[u64], Fail] = row.boundary(rw.ok, rel.addend);
    if (sel b.err)     { ret err[Fail].err{b.err}; }
    if (sel b.ok.none) { ret err[Fail].ok{}; }
    val bound: u64             = b.ok.some;
    val own:   res[bool, Fail] = pieces.own_copy(in.pieces, ref, rel.offset);
    if (sel own.err) { ret err[Fail].err{own.err}; }
    if (!own.ok)     { ret err[Fail].ok{}; }
    val pos: res[opt[layout.Position], Fail] = layout.locate(in.layout, in.pieces, ref, rel.offset);
    if (sel pos.err)     { ret err[Fail].err{pos.err}; }
    if (sel pos.ok.none) { ret err[Fail].ok{}; }
    val at: res[u64, Fail] = checked.add(Location{record: "aligned place"}, pos.ok.some.address, rel.addend::u64);
    if (sel at.err)                 { ret err[Fail].err{at.err}; }
    if ((at.ok & (bound - 1)) == 0) { ret err[Fail].ok{}; }
    ret err[Fail].err{fail.valued(fail.about(fail.unsupported("the place the relocation aligns misses its boundary, and deleting alignment padding is not supported until #494"), rw.ok.name), bound::i128)};
}

# queue the relocation `rel` of the input `id` to an index space entry, whose
# value is the entry's index in the output, its dynamic decision having
# found that its row computes nothing else
fun entry_index(c: *Context, id: Id[Input], rel: *Reloc, rw: *Row, x: compute.Inputs, p: layout.Position, room: u64) err[Fail] {
    var y: compute.Inputs = x;
    val n: res[u64, Fail] = assign.target_index(c.in.assigned, id, rel.target);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    y.index = n.ok;
    var site: Site           = site_of(c, id, p.file, room);
    val add:  res[i64, Fail] = engine.addend(rw, ?site, rel.addend);
    if (sel add.err) { ret err[Fail].err{add.err}; }
    y.a = add.ok;
    ret queued(c, rw, y, p, room, rel.offset);
}

# queue the record of row `rw` with the inputs `x` at the position `p`
fun queued(c: *Context, rw: *Row, x: compute.Inputs, p: layout.Position, room: u64, offset: u64) err[Fail] {
    val pr: res[Id[Prep], Fail] = table.push[Prep](?c.preps, Prep{row: rw, x: x, at: p.file, room: room, offset: offset});
    if (sel pr.err) { ret err[Fail].err{pr.err}; }
    val mk: res[Id[Mark], Fail] = table.push[Mark](?c.marks, Mark{row: rw, place: p.address, label: x.s + (x.a:~u64)});
    if (sel mk.err) { ret err[Fail].err{mk.err}; }
    ret err[Fail].ok{};
}

# what the symbol `s` of the input `id` reaches: its winning definition's
# address when it has one
fun reach_of(c: *Context, id: Id[Input], s: Id[Symbol]) Reach {
    val in: *In              = c.in;
    var at: Id[Input]        = id;
    var sy: Id[Symbol]       = s;
    val w:  opt[resolve.Won] = resolve.winning(in.resolved, id, s);
    if (sel w.some) {
        at = w.some.binding.input;
        sy = w.some.binding.symbol;
    }
    val v: opt[u64] = layout.value_of(in.layout, at, sy);
    if (sel v.some) { ret Reach.found{Found{value: v.some, input: at, symbol: sy}}; }
    val o: *Object = input.object_of(in.inputs, at);
    if (o == nil) { ret Reach.absent{}; }
    val sym: *Symbol = object.symbol_at(o, sy);
    if (sel sym.def.placed || sel sym.def.common) { ret Reach.dead{}; }
    if (!sel sym.def.undefined)                   { ret Reach.absent{}; }
    val own: *Symbol = object.symbol_at(input.object_of(in.inputs, id), s);
    if (symbol.binds(own.binding, symbol.WEAK)) { ret Reach.weak{}; }
    ret Reach.absent{};
}

# a reference by the section symbol of a merged section, `f`, names the byte
# its addend counts to as the format holds it, which the copy kept for it
# holds, so its target is that byte's address less the held addend
fun into_piece(c: *Context, f: Found, rw: *Row, x: *compute.Inputs) err[Fail] {
    val sym: *Symbol = object.symbol_at(input.object_of(c.in.inputs, f.input), f.symbol);
    if (!symbol.names(sym.kind, symbol.SECTION)) { ret err[Fail].ok{}; }
    if (sel sym.def.placed)                      { ret into_place(c, Ref{input: f.input, section: sym.def.placed.section}, sym.def.placed.offset, rw, x); }
    ret err[Fail].ok{};
}

# the target of a reference by the section symbol at `offset` of the section
# `at`, when that section is merged
fun into_place(c: *Context, at: Ref, offset: u64, rw: *Row, x: *compute.Inputs) err[Fail] {
    val member: opt[Id[pieces.Member]] = pieces.member_of(c.in.pieces, at);
    if (sel member.none) { ret err[Fail].ok{}; }
    val held: i128           = engine.held_of(rw, x.a);
    val byte: res[u64, Fail] = pieces.named_byte(offset, held);
    if (sel byte.err) { ret err[Fail].err{byte.err}; }
    val pos: res[opt[layout.Position], Fail] = layout.locate(c.in.layout, c.in.pieces, at, byte.ok);
    if (sel pos.err)     { ret err[Fail].err{pos.err}; }
    if (sel pos.ok.none) { ret err[Fail].err{fail.malformed("a relocation refers to an entry the link dropped")}; }
    val s: i128 = pos.ok.some.address::i128 - held;
    if (s < 0 || s > 0xffff_ffff_ffff_ffff) { ret err[Fail].err{fail.overflow("a reference into a merged section does not fit 64 bits")}; }
    x.s = s::u64;
    ret err[Fail].ok{};
}

# the anchors the computation `v` reads, taken from the entries the decision
# `d` reaches and the records of the thread-local block. a reference loads
# from the entry its route lands in when it is one a reference loads from, and
# sees as its target's address that of the entry standing for its target
fun anchor(c: *Context, d: *Decision, v: *compute.Computation, x: *compute.Inputs) err[Fail] {
    val in: *In = c.in;
    if (d.route != nil) {
        val r: *SlotRole      = d.route.role;
        val a: res[u64, Fail] = layout.slot_address(in.layout, in.reserved, r, d.entry);
        if (sel a.err) { ret err[Fail].err{a.err}; }
        x.anchors[r.at::usize] = a.ok;
        if (sel r.reach.loaded) { x.g = a.ok; }
        val by: opt[*SlotRole] = d.route.through;
        if (sel by.some) {
            val t: res[u64, Fail] = layout.slot_address(in.layout, in.reserved, by.some, d.through);
            if (sel t.err) { ret err[Fail].err{t.err}; }
            x.anchors[by.some.at::usize] = t.ok;
        }
        val stands: opt[*SlotRole] = dynamic.standing(d);
        if (sel stands.some) {
            x.s = x.anchors[stands.some.at::usize];
            # a call reads the code entry standing for its target as its PLT entry
            if (sel stands.some.reach.called) { x.anchors[slot.PLT.at] = x.s; }
        }
    }
    if (compute.needs(v, compute.NEEDS_G) && (d.route == nil || !sel d.route.role.reach.loaded)) {
        ret err[Fail].err{fail.unsupported("a relocation that reads a GOT slot reaches none")};
    }
    if (compute.needs(v, compute.NEEDS_GOT)) {
        val a: res[u64, Fail] = layout.got_address(in.layout, in.reserved);
        if (sel a.err) { ret err[Fail].err{a.err}; }
        x.got = a.ok;
    }
    if (compute.needs(v, compute.NEEDS_TP) || compute.needs(v, compute.NEEDS_DTP)) {
        val t: res[layout.Anchors, Fail] = layout.thread_anchors(in.layout);
        if (sel t.err) { ret err[Fail].err{t.err}; }
        x.tp  = t.ok.tp;
        x.dtp = t.ok.dtp;
    }
    ret err[Fail].ok{};
}

# the index in the section table of the output section holding the definition `f`
fun section_index(c: *Context, f: Found) res[u64, Fail] {
    val m: res[Id[Merged], Fail] = section_of(c, f);
    if (sel m.err) { ret res[u64, Fail].err{m.err}; }
    val n: opt[u64] = layout.section_index(c.in.layout, m.ok);
    if (sel n.none) { ret res[u64, Fail].err{fail.unsupported("the format's relocations name no section index")}; }
    ret res[u64, Fail].ok{n.some};
}

# the output section holding the definition `f`
fun section_of(c: *Context, f: Found) res[Id[Merged], Fail] {
    val sym: *Symbol = object.symbol_at(input.object_of(c.in.inputs, f.input), f.symbol);
    if (sel sym.def.placed) {
        val pos: res[opt[layout.Position], Fail] = layout.locate(c.in.layout, c.in.pieces, Ref{input: f.input, section: sym.def.placed.section}, sym.def.placed.offset);
        if (sel pos.err)     { ret res[Id[Merged], Fail].err{pos.err}; }
        if (sel pos.ok.some) { ret res[Id[Merged], Fail].ok{pos.ok.some.merged}; }
    }
    ret res[Id[Merged], Fail].err{fail.unsupported("the definition does not lie in an output section")};
}

# the address of the output section holding the definition `f`
fun section_base(c: *Context, f: Found) res[u64, Fail] {
    val m: res[Id[Merged], Fail] = section_of(c, f);
    if (sel m.err) { ret res[u64, Fail].err{m.err}; }
    ret res[u64, Fail].ok{table.at[Merged](?c.in.layout.merged, m.ok).address};
}

# apply the prepared relocation `i`, with the value of its partner when its
# row takes one, or nothing when its partner writes the field for both
fun apply_one(c: *Context, id: Id[Input], i: usize) err[Fail] {
    val pr: *Prep          = ?table.items[Prep](?c.preps)[i];
    var x:  compute.Inputs = pr.x;
    if (sel pr.row.pair.some) {
        val rule: row.PairRule     = pr.row.pair.some;
        val j:    res[usize, Fail] = engine.partner(table.items[Mark](?c.marks), table.count[Mark](?c.marks), ?c.slots, i, Location{});
        if (sel j.err)             { ret err[Fail].err{j.err}; }
        if (!engine.writes(?rule)) { ret err[Fail].ok{}; }
        val pj: *Prep          = ?table.items[Prep](?c.preps)[j.ok];
        var sj: Site           = site_of(c, id, pj.at, pj.room);
        val v:  res[i64, Fail] = engine.partner_value(pj.row, ?sj, ?pj.x);
        if (sel v.err) { ret err[Fail].err{v.err}; }
        engine.take_partner(?rule, ?x, v.ok);
    }
    var site: Site = site_of(c, id, pr.at, pr.room);
    ret engine.apply(pr.row, ?site, ?x);
}

# a static linux link of objects a test builds, every section kept
rec Fixture {
    a:         *A.Allocator;
    names:     Interner;
    inputs:    Inputs;
    resolved:  Resolved;
    dynamic:   Dynamic;
    live:      Live;
    pieces:    Pieces;
    reserved:  Reserved;
    placing:   Constraints;
    layout:    Layout;
    adjusted:  Adjusted;
    relocated: Relocated;
    sites:     Sites;
    host:      *Host;
    target:    target.Target;
    arch:      *Arch;
    pair:      *Pair;
    readers:   Readers;
    rows:      row.Registry;
    relocs:    *Lookup;
}

#[testing]
fun open_fixture(f: *Fixture, a: *A.Allocator, ar: *Arch) bool {
    # the riscv hosts hold under the double float ABI, the others whatever
    # the traits state
    var ts:  Table[Trait] = table.make[Trait](a);
    val put: err[Fail]    = trait.add(?ts, Trait{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_DOUBLE}});
    if (sel put.err) { ret false; }
    val h:     res[*Host, Fail] = os.host(?linux.LINUX, opt[*Env].some{?linux.GNU}, ar, ?ts);
    val freed: err[Fail]        = table.release[Trait](?ts);
    if (sel h.err)     { ret false; }
    if (sel freed.err) { ret false; }
    val p: res[*Pair, Fail] = elf_pairs.of(ar);
    if (sel p.err) { ret false; }
    var rows: res[row.Registry, Fail] = elf_pairs.index(a);
    if (sel rows.err) { ret false; }
    val l: res[*Lookup, Fail] = row.find(?rows.ok, ?format.ELF, ar);
    if (sel l.err) { ret false; }
    val rd: res[Readers, Fail] = readers.make(a, nil, 0);
    if (sel rd.err) { ret false; }
    @f = Fixture{
        a:         a,
        names:     intern.make(a),
        inputs:    input.make(a),
        resolved:  resolve.make(a),
        dynamic:   dynamic.make(a),
        live:      collect.make(a),
        pieces:    pieces.make(a),
        reserved:  reserve.make(a),
        placing:   layout.constraints(a),
        layout:    layout.make(a),
        adjusted:  adjust.make(a),
        relocated: make(a),
        sites:     sites.make(a),
        host:      h.ok,
        target:    target.Target{arch: ar, system: opt[*System].some{?linux.LINUX}, env: opt[*Env].some{?linux.GNU}},
        arch:      ar,
        pair:      p.ok,
        readers:   rd.ok,
        rows:      rows.ok,
        relocs:    l.ok,
    };
    ret true;
}

fun close_fixture(f: *Fixture) bool {
    var first: err[Fail] = release(?f.relocated);
    first = fail.kept(first, sites.release(?f.sites));
    first = fail.kept(first, layout.release(?f.layout));
    first = fail.kept(first, adjust.release(?f.adjusted));
    first = fail.kept(first, layout.release_constraints(?f.placing));
    first = fail.kept(first, reserve.release(?f.reserved));
    first = fail.kept(first, pieces.release(?f.pieces));
    first = fail.kept(first, collect.release(?f.live));
    first = fail.kept(first, dynamic.release(?f.dynamic));
    first = fail.kept(first, resolve.release(?f.resolved));
    first = fail.kept(first, input.release(?f.inputs));
    first = fail.kept(first, intern.release(?f.names));
    first = fail.kept(first, readers.release(?f.readers));
    first = fail.kept(first, row.release(?f.rows));
    ret sel first.ok;
}

# decide what the relocations need and lay the fixture out
fun lay_out_fixture(f: *Fixture) err[Fail] {
    var notes: Sink       = sink.make(f.inputs.a, LITTLE);
    var rin:   resolve.In = resolve.In{
        inputs:  ?f.inputs,
        names:   ?f.names,
        readers: ?f.readers,
        relocs:  ?f.rows,
        arch:    f.arch,
        kind:    ?output.STATIC,
        search:  0,
        hooks:   ?resolve.PLAIN,
        notes:   ?notes,
    };
    val resolved: err[Fail] = fail.kept(resolve.run(?rin, ?f.resolved), sink.release(?notes));
    if (sel resolved.err) { ret resolved; }
    var din: dynamic.In = dynamic.In{
        inputs:   ?f.inputs,
        names:    ?f.names,
        resolved: ?f.resolved,
        live:     ?f.live,
        kind:     ?output.STATIC,
        arch:     f.arch,
        rules:    ?convention.DYNAMIC,
        relocs:   f.relocs,
    };
    val decided: err[Fail] = dynamic.run(?din, ?f.dynamic);
    if (sel decided.err) { ret decided; }
    ret layout_fixture(f, ?convention.LAYOUT, f.pair.thread);
}

# lay the decided fixture out under the layout rules `rl` and the thread row
# `th`
fun layout_fixture(f: *Fixture, rl: *layout.Rules, th: opt[*Thread]) err[Fail] {
    var lin: layout.In = layout.In{
        inputs:       ?f.inputs,
        names:        ?f.names,
        resolved:     ?f.resolved,
        live:         ?f.live,
        pieces:       ?f.pieces,
        reserved:     ?f.reserved,
        kind:         ?output.STATIC,
        target:       ?f.target,
        host:         f.host,
        rules:        rl,
        thread:       th,
        constraints:  ?f.placing,
        participants: layout.Participants{rows: nil, count: 0},
        adjusted:     ?f.adjusted,
        limit:        layout.PASSES,
    };
    ret layout.run(?lin, ?f.layout);
}

# relocate the laid out fixture under the weak rule `w`
fun relocate_fixture(f: *Fixture, w: Weak) err[Fail] {
    var in: In = In{
        inputs:   ?f.inputs,
        resolved: ?f.resolved,
        reserved: ?f.reserved,
        dynamic:  ?f.dynamic,
        pieces:   ?f.pieces,
        layout:   ?f.layout,
        adjusted: ?f.adjusted,
        kind:     ?output.STATIC,
        arch:     f.arch,
        host:     f.host,
        relocs:   f.relocs,
        weak:     w,
        live:     ?f.live,
        sites:    ?f.sites,
    };
    ret run(?in, ?f.relocated);
}

# the section `name` of `size` zero bytes in the object `o` of the input `id`,
# kept
fun test_section(f: *Fixture, id: Id[Input], o: *Object, name: str, k: *section.Kind, size: usize) bool {
    var zero: [16]u8;
    val n:    res[Id[Name], Fail] = object.name_str(o, name);
    if (sel n.err) { ret false; }
    val c: res[object.Contents, Fail] = object.own(o, ?zero[0], size);
    if (sel c.err) { ret false; }
    val s: res[Id[Section], Fail] = object.add_section(o, Section{name: opt[Id[Name]].some{n.ok}, kind: k, flags: k.flags, align: 8, contents: c.ok});
    if (sel s.err) { ret false; }
    val p: res[Id[Ref], Fail] = table.push[Ref](?f.live.kept, Ref{input: id, section: s.ok});
    ret sel p.ok;
}

# one object a.o of a text section of 16 zero bytes and a data section of 8,
# both kept
fun test_object(f: *Fixture) *Object {
    val r: res[Id[Input], Fail] = input.take(?f.inputs, "a.o", object.make(f.inputs.a, f.arch, ?kind.RELOCATABLE), opt[Id[contract.Model]].none{});
    if (sel r.err) { ret nil; }
    val o: *Object = input.object_of(?f.inputs, r.ok);
    if (!test_section(f, r.ok, o, ".text", ?section.TEXT, 16)) { ret nil; }
    if (!test_section(f, r.ok, o, ".data", ?section.DATA, 8))  { ret nil; }
    ret o;
}

fun test_symbol(o: *Object, name: str, b: *symbol.Binding, def: Definition) Id[Symbol] {
    val n: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel n.err) { ret Id[Symbol]{}; }
    val s: res[Id[Symbol], Fail] = object.add_symbol(o, Symbol{name: n.ok, binding: b, visibility: ?symbol.DEFAULT, kind: ?symbol.NOTYPE, def: def});
    if (sel s.err) { ret Id[Symbol]{}; }
    ret s.ok;
}

fun test_reloc(o: *Object, offset: u64, k: *reloc.Kind, target: Id[Symbol], addend: i64) bool {
    val r: res[Id[Reloc], Fail] = object.add_reloc(o, Reloc{
        section: Id[Section]{index: 0},
        offset:  offset,
        kind:    k,
        target:  Target.symbol{target},
        addend:  addend,
    });
    ret sel r.ok;
}

fun test_marker(o: *Object, offset: u64) bool {
    val r: res[Id[Reloc], Fail] = object.add_reloc(o, Reloc{section: Id[Section]{index: 0}, offset: offset, kind: ?reloc.NONE, target: Target.none{}});
    ret sel r.ok;
}

# the little endian value of the `n` bytes at `at` of the relocated bytes
fun word(f: *Fixture, at: u64, n: usize) u64 {
    var v: u64   = 0;
    var i: usize = 0;
    for (i < n) {
        v = v | (table.items[u8](?f.relocated.bytes)[at::usize + i]::u64 << (i * 8)::u64);
        i = i + 1;
    }
    ret v;
}

# where the byte `offset` of section `s` of a.o landed
fun landed(f: *Fixture, s: u32, offset: u64) layout.Position {
    val p: res[opt[layout.Position], Fail] = layout.locate(?f.layout, ?f.pieces, Ref{input: table.nth[Input](0), section: Id[Section]{index: s}}, offset);
    if (sel p.err)     { ret layout.Position{}; }
    if (sel p.ok.none) { ret layout.Position{}; }
    ret p.ok.some;
}

test relocate__a_relocation_is_applied_at_its_symbols_laid_out_value {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f: Fixture;
    if (!open_fixture(?f, T.allocator_of(?t), ?x86.X86_64)) { ret 1; }
    val o: *Object = test_object(?f);
    if (o == nil) { ret 1; }
    val target: Id[Symbol] = test_symbol(o, "target", ?symbol.GLOBAL, Definition.placed{Place{section: Id[Section]{index: 1}, offset: 4}});
    if (!test_reloc(o, 0, ?reloc.ABS64, target, 3)) { ret 1; }
    if (!test_reloc(o, 8, ?reloc.PC32, target, -4)) { ret 1; }
    if (!test_marker(o, 12))                        { ret 1; }
    val laid: err[Fail] = lay_out_fixture(?f);
    if (sel laid.err) { ret 1; }
    val r: err[Fail] = relocate_fixture(?f, Weak.zero{});
    if (sel r.err) { ret 1; }

    val s: u64             = landed(?f, 1, 4).address;
    val p: layout.Position = landed(?f, 0, 8);
    if (s == 0)                                                     { ret 1; }
    if (word(?f, landed(?f, 0, 0).file, 8) != s + 3)                { ret 1; }
    if (word(?f, p.file, 4) != ((s - 4 - p.address) & 0xffff_ffff)) { ret 1; }

    if (!close_fixture(?f))    { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test relocate__a_relocation_against_the_absolute_address_zero_computes_from_zero {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f: Fixture;
    if (!open_fixture(?f, T.allocator_of(?t), ?x86.X86_64)) { ret 1; }
    val o: *Object = test_object(?f);
    if (o == nil) { ret 1; }
    val abs: res[Id[Reloc], Fail] = object.add_reloc(o, Reloc{section: Id[Section]{index: 0}, offset: 0, kind: ?reloc.ABS64, target: Target.absolute{}, addend: 0x1000});
    val pc:  res[Id[Reloc], Fail] = object.add_reloc(o, Reloc{section: Id[Section]{index: 0}, offset: 8, kind: ?reloc.PC32, target: Target.absolute{}, addend: 0x1000});
    if (sel abs.err || sel pc.err) { ret 1; }
    val laid: err[Fail] = lay_out_fixture(?f);
    if (sel laid.err) { ret 1; }
    val r: err[Fail] = relocate_fixture(?f, Weak.zero{});
    if (sel r.err) { ret 1; }

    val p: layout.Position = landed(?f, 0, 8);
    if (word(?f, landed(?f, 0, 0).file, 8) != 0x1000)                { ret 1; }
    if (word(?f, p.file, 4) != ((0x1000 - p.address) & 0xffff_ffff)) { ret 1; }

    if (!close_fixture(?f))    { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test relocate__an_undefined_weak_reference_resolves_by_its_rule {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f: Fixture;
    if (!open_fixture(?f, T.allocator_of(?t), ?x86.X86_64)) { ret 1; }
    val o: *Object = test_object(?f);
    if (o == nil) { ret 1; }
    val weak: Id[Symbol] = test_symbol(o, "weak", ?symbol.WEAKLY, Definition.undefined{});
    if (!test_reloc(o, 0, ?reloc.ABS64, weak, 5)) { ret 1; }
    val laid: err[Fail] = lay_out_fixture(?f);
    if (sel laid.err) { ret 1; }
    val r: err[Fail] = relocate_fixture(?f, Weak.zero{});
    if (sel r.err)                               { ret 1; }
    if (word(?f, landed(?f, 0, 0).file, 8) != 5) { ret 1; }

    # under the fallback rule a weak reference resolution bound to nothing
    # reaches no definition
    val fallback: err[Fail] = relocate_fixture(?f, Weak.fallback{});
    if (sel fallback.ok)                   { ret 1; }
    if (!sel fallback.err.cause.malformed) { ret 1; }

    if (!close_fixture(?f))    { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test relocate__an_out_of_range_value_names_its_input_section_and_offset {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f: Fixture;
    if (!open_fixture(?f, T.allocator_of(?t), ?x86.X86_64)) { ret 1; }
    val o: *Object = test_object(?f);
    if (o == nil) { ret 1; }
    val far: Id[Symbol] = test_symbol(o, "far", ?symbol.GLOBAL, Definition.absolute{0x1_0000_0000});
    if (!test_reloc(o, 4, ?reloc.ABS32, far, 0)) { ret 1; }
    val laid: err[Fail] = lay_out_fixture(?f);
    if (sel laid.err) { ret 1; }
    val r: err[Fail] = relocate_fixture(?f, Weak.zero{});
    if (sel r.ok)                                  { ret 1; }
    if (!sel r.err.cause.overflow)                 { ret 1; }
    if (!str_equals(r.err.at.file, "a.o"))         { ret 1; }
    if (!str_equals(r.err.at.record, "section"))   { ret 1; }
    if (!r.err.at.indexed || r.err.at.index != 0)  { ret 1; }
    if (!r.err.at.placed || r.err.at.offset != 4)  { ret 1; }
    if (!str_equals(r.err.subject, "R_X86_64_32")) { ret 1; }
    if (sel r.err.value.none)                      { ret 1; }
    if (r.err.value.some != 0x1_0000_0000)         { ret 1; }

    if (!close_fixture(?f))    { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

# the merged strings section of the `n` bytes at `p` in the object `o` of
# the input `id`, kept
fun test_strings(f: *Fixture, id: Id[Input], o: *Object, p: *u8, n: usize) bool {
    val nm: res[Id[Name], Fail] = object.name_str(o, ".rodata.str1.1");
    if (sel nm.err) { ret false; }
    val c: res[object.Contents, Fail] = object.own(o, p, n);
    if (sel c.err) { ret false; }
    val s: res[Id[Section], Fail] = object.add_section(o, Section{name: opt[Id[Name]].some{nm.ok}, kind: ?section.MERGED_STRINGS, flags: section.MERGED_STRINGS.flags, align: 1, entsize: 1, contents: c.ok});
    if (sel s.err) { ret false; }
    val k: res[Id[Ref], Fail] = table.push[Ref](?f.live.kept, Ref{input: id, section: s.ok});
    ret sel k.ok;
}

val TEST_FIRST:  [10]u8 = [10]u8{'a', 'b', 'c', 0, 'h', 'e', 'l', 'l', 'o', 0};
val TEST_SECOND: [6]u8  = [6]u8{'h', 'e', 'l', 'l', 'o', 0};

test relocate__a_reference_into_a_piece_reaches_the_same_byte_of_the_kept_copy {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f: Fixture;
    if (!open_fixture(?f, T.allocator_of(?t), ?x86.X86_64)) { ret 1; }
    val o: *Object = test_object(?f);
    if (o == nil) { ret 1; }
    val id: Id[Input] = table.nth[Input](0);
    if (!test_strings(?f, id, o, ?TEST_FIRST[0], 10) || !test_strings(?f, id, o, ?TEST_SECOND[0], 6)) { ret 1; }
    # a symbol at the second section's string and that section's own symbol,
    # two bytes on
    val at:   Definition          = Definition.placed{Place{section: Id[Section]{index: 3}, offset: 0}};
    val str:  Id[Symbol]          = test_symbol(o, "str", ?symbol.LOCAL, at);
    val name: res[Id[Name], Fail] = object.name_str(o, "");
    if (sel name.err) { ret 1; }
    val sec: res[Id[Symbol], Fail] = object.add_symbol(o, Symbol{name: name.ok, binding: ?symbol.LOCAL, visibility: ?symbol.DEFAULT, kind: ?symbol.SECTIONS, def: at});
    if (sel sec.err)                                { ret 1; }
    if (!test_reloc(o, 0, ?reloc.ABS64, str, 0))    { ret 1; }
    if (!test_reloc(o, 8, ?reloc.ABS64, sec.ok, 2)) { ret 1; }
    var min: merge.In  = merge.In{inputs: ?f.inputs, names: ?f.names, live: ?f.live, resolved: ?f.resolved, relocs: f.relocs, rules: opt[*layout.Rules].some{?convention.LAYOUT}, tails: true};
    val mg:  err[Fail] = merge.run(?min, ?f.pieces);
    if (sel mg.err) { ret 1; }
    val laid: err[Fail] = lay_out_fixture(?f);
    if (sel laid.err) { ret 1; }
    val r: err[Fail] = relocate_fixture(?f, Weak.zero{});
    if (sel r.err) { ret 1; }

    # both reach the first section's copy, whose bytes the image holds once
    val kept: layout.Position = landed(?f, 2, 4);
    if (kept.address == 0)                                      { ret 2; }
    if (landed(?f, 3, 0).address != kept.address)               { ret 2; }
    if (word(?f, landed(?f, 0, 0).file, 8) != kept.address)     { ret 3; }
    if (word(?f, landed(?f, 0, 8).file, 8) != kept.address + 2) { ret 4; }
    if (word(?f, kept.file, 6) != 0x6f6c6c6568)                 { ret 5; }

    if (!close_fixture(?f))    { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

val VARIANT_ONE: Thread = Thread{side: Side.above{}, tcb: 16, source: "test"};

test relocate__a_thread_offset_computes_from_the_tls_anchor_of_each_variant {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f: Fixture;
    if (!open_fixture(?f, T.allocator_of(?t), ?x86.X86_64)) { ret 1; }
    val o: *Object = test_object(?f);
    if (o == nil)                                                                  { ret 1; }
    if (!test_section(?f, table.nth[Input](0), o, ".tdata", ?section.TLS_DATA, 8)) { ret 1; }
    val tv: Id[Symbol] = test_symbol(o, "tv", ?symbol.GLOBAL, Definition.placed{Place{section: Id[Section]{index: 2}, offset: 4}});
    object.symbol_at(o, tv).kind = ?symbol.TLS;
    if (!test_reloc(o, 0, ?x86_kinds.TPOFF32, tv, 0)) { ret 1; }
    val laid: err[Fail] = lay_out_fixture(?f);
    if (sel laid.err) { ret 1; }

    # the block ends at the thread pointer, so the variable lies below it
    val below: err[Fail] = relocate_fixture(?f, Weak.zero{});
    if (sel below.err)                                     { ret 1; }
    if (word(?f, landed(?f, 0, 0).file, 4) != 0xffff_fffc) { ret 1; }

    # the thread pointer leads the block by its control block, so it lies above it
    val moved: err[Fail] = layout_fixture(?f, ?convention.LAYOUT, opt[*Thread].some{?VARIANT_ONE});
    if (sel moved.err) { ret 1; }
    val above: err[Fail] = relocate_fixture(?f, Weak.zero{});
    if (sel above.err)                            { ret 1; }
    if (word(?f, landed(?f, 0, 0).file, 4) != 20) { ret 1; }

    if (!close_fixture(?f))    { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test relocate__an_add_and_a_sub_over_one_field_patch_the_difference_of_two_labels {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f: Fixture;
    if (!open_fixture(?f, T.allocator_of(?t), ?riscv.RISCV64)) { ret 1; }
    val o: *Object = test_object(?f);
    if (o == nil) { ret 1; }
    val hi: Id[Symbol] = test_symbol(o, "hi", ?symbol.GLOBAL, Definition.placed{Place{section: Id[Section]{index: 1}, offset: 6}});
    val lo: Id[Symbol] = test_symbol(o, "lo", ?symbol.GLOBAL, Definition.placed{Place{section: Id[Section]{index: 1}, offset: 1}});
    if (!test_reloc(o, 0, ?riscv_kinds.ADD32, hi, 0)) { ret 1; }
    if (!test_reloc(o, 0, ?riscv_kinds.SUB32, lo, 0)) { ret 1; }
    val laid: err[Fail] = lay_out_fixture(?f);
    if (sel laid.err) { ret 1; }
    val r: err[Fail] = relocate_fixture(?f, Weak.zero{});
    if (sel r.err)                               { ret 1; }
    if (word(?f, landed(?f, 0, 0).file, 4) != 5) { ret 1; }

    if (!close_fixture(?f))    { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test relocate__a_paired_value_past_64_bits_is_wrapped_to_the_address_width {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f: Fixture;
    if (!open_fixture(?f, T.allocator_of(?t), ?riscv.RISCV64)) { ret 1; }
    val o: *Object = test_object(?f);
    if (o == nil) { ret 1; }
    val text: Bytes = object.bytes(o, ?object.section_at(o, Id[Section]{index: 0}).contents);
    if (text.data == nil) { ret 1; }
    var i: usize = 0;
    for (i < 9) {
        text.data[i] = 0x80;
        i            = i + 1;
    }
    val top: Id[Symbol] = test_symbol(o, "top", ?symbol.GLOBAL, Definition.absolute{0xffff_ffff_ffff_f000});
    if (!test_reloc(o, 0, ?riscv_kinds.SET_ULEB128, top, 0)) { ret 1; }
    if (!test_reloc(o, 0, ?riscv_kinds.SUB_ULEB128, top, 0)) { ret 1; }
    val laid: err[Fail] = lay_out_fixture(?f);
    if (sel laid.err) { ret 1; }
    val r: err[Fail] = relocate_fixture(?f, Weak.zero{});
    if (sel r.err) { ret 1; }

    if (!close_fixture(?f))    { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
