# how a format links: the one row a registration names for its output side
#
# a link phase reads what the output format's row states and never asks which
# format it is. the row names how the format's linker searches archives, its
# resolution hooks, how it resolves an undefined weak reference, how it lays
# an image out and binds it, how settle combines the facts its objects carry,
# the image writer, the table declarers and the measures of the tables they
# measure, how it takes the sections that are not image content, the inputs
# the link makes for it and what reruns its layout.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail.Fail;
use mink.catalog.merge;
use mink.link.consume;
use mink.link.dynamic;
use mink.link.image.Image;
use mink.link.image.Writer;
use mink.link.layout;
use mink.link.layout.Participants;
use mink.link.relocate.Weak;
use mink.link.reserve.Declarers;
use mink.link.reserve.Measure;
use mink.link.resolve;
use mink.link.resolve.Hooks;
use mink.link.synthesizer;

# what a format's link does that a phase asks of it
pub def Caps: u64;

# the format lays an image out by index rather than by address, as a wasm
# module's function, table, memory and global spaces are, so the assign phase
# gives each definition its index
pub val INDEXED_LAYOUT: Caps = 0x1;

# the rows the link makes inputs with, each running at its stage
pub rec Synthesizers {
    rows:  **synthesizer.Row;
    count: usize;
}

# what one measure reads from the laid out image
# ---
# key:     the measure a measured table names
# measure: the table's size in the image `img`, whose relocated bytes are not
#          made yet
pub rec Measured {
    key:     *Measure;
    measure: fun(*Image) res[u64, Fail];
}

# the measures of a format, at most one per key
pub rec Measures {
    rows:  *Measured;
    count: usize;
}

# caps:         the link capabilities the format declares
# search:       how its linker searches archives, and whether a common
#               definition pulls an archive member that defines its name as
#               data
# hooks:        its resolution rules
# weak:         how it resolves an undefined weak reference
# layout:       how its images are laid out
# dynamic:      its dynamic linking rules
# facts:        how settle combines the facts its objects carry
# writer:       its image writer, none where no writer is built yet
# declarers:    the rows that declare the tables its images hold
# measures:     the measures its measured tables are sized by
# uses:         how it takes each section that is not image content
# synthesizers: the inputs the link makes for it
# participants: what reruns its layout until nothing moves
pub rec Linking {
    caps:         Caps;
    search:       resolve.Caps;
    hooks:        *Hooks;
    weak:         Weak;
    layout:       *layout.Rules;
    dynamic:      *dynamic.Rules;
    facts:        *merge.Rules;
    writer:       opt[*Writer];
    declarers:    Declarers;
    measures:     Measures;
    uses:         consume.Uses;
    synthesizers: Synthesizers;
    participants: Participants;
}
