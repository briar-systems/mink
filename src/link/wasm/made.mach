# the link's own object for a wasm image
#
# a wasm image holds what no input defines: the linear memory, the function
# table, the stack pointer, the globals position independent code reads the
# memory base and the thread-local block's start from, and the function that
# calls the init functions. the link makes them as one object before
# resolution, each an entry defined by a symbol of the name the conventions
# give it, so an input's import of that name resolves to it, and exports the
# memory. the stack pointer starts at the link's image base,
# where the stack ends and the data begins, and the memory base is the image
# base too, as a relative memory address counts from it. facts of the format
# name the entries whose value the image writer gives once the image is laid
# out: the table's size, the memory's pages, the start of the thread-local
# block and the calls of the init functions.

use std.encoding.leb128;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.catalog.format;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.format.wasm.fact;
use mink.format.wasm.neutral;
use mink.format.wasm.tables;
use mink.format.wasm.write;
use mink.link.synthesizer;
use mink.link.synthesizer.Context;
use mink.link.synthesizer.Row;
use mink.model.directive;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Definition;
use mink.model.object.Entry;
use mink.model.object.Fact;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.section;
use mink.model.space;
use mink.model.symbol;

# the names the conventions give what the link defines
pub val MEMORY_NAME: str = "__linear_memory";
pub val TABLE_NAME:  str = "__indirect_function_table";
pub val STACK_NAME:  str = "__stack_pointer";
pub val BASE_NAME:   str = "__memory_base";
pub val TLS_NAME:    str = "__tls_base";
pub val CTORS_NAME:  str = "__wasm_call_ctors";

# the name the memory is exported by
val MEMORY_EXPORT: str = "memory";

val KINDS: [2]*Kind = [2]*Kind{?output.STATIC, ?output.MODULE};

pub val ROW: Row = Row{name: "the link's own wasm entries", stage: ?synthesizer.BEFORE_RESOLVE, needs: arch.ADDRESSED | arch.INDEXED, kinds: ?KINDS[0], kind_count: 2, make: make};

fun make(c: *Context, o: *Object) res[bool, Fail] {
    val err_made: err[Fail] = made(c, o);
    if (sel err_made.err) { ret res[bool, Fail].err{err_made.err}; }
    ret res[bool, Fail].ok{true};
}

# add to `o` the entries the link defines: the void type, the init caller,
# the function table, the exported memory and the three globals
fun made(c: *Context, o: *Object) err[Fail] {
    val res_address_const: res[u8, Fail] = neutral.address_const(c.target.arch);
    if (sel res_address_const.err) { ret err[Fail].err{res_address_const.err}; }
    var valtype: u8   = tables.WASM_TYPE_I32.value::u8;
    var wide:    bool = false;
    if (res_address_const.ok == tables.WASM_OPCODE_I64_CONST.value::u8) {
        valtype = tables.WASM_TYPE_I64.value::u8;
        wide    = true;
    }

    val res_type: res[Id[Entry], Fail] = object.add_entry(o, Entry{space: ?space.TYPES});
    if (sel res_type.err) { ret err[Fail].err{res_type.err}; }
    val err_void: err[Fail] = fact.signature(o, res_type.ok, nil, 0, nil, 0);
    if (sel err_void.err) { ret err_void; }

    val body:     [2]u8               = [2]u8{0, tables.WASM_OPCODE_END.value::u8};
    val res_held: res[Contents, Fail] = object.own(o, ?body[0], 2);
    if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
    val res_code: res[Id[object.Section], Fail] = object.add_section(o, object.Section{kind: ?section.TEXT, flags: section.TEXT.flags, align: 1, contents: res_held.ok, disposition: ?section.WHOLE});
    if (sel res_code.err) { ret err[Fail].err{res_code.err}; }
    val res_ctors: res[Id[Entry], Fail] = object.add_entry(o, Entry{space: ?space.FUNCTIONS, body: opt[Place].some{Place{section: res_code.ok, offset: 0}}, signature: opt[Id[Entry]].some{res_type.ok}});
    if (sel res_ctors.err) { ret err[Fail].err{res_ctors.err}; }
    val err_defined: err[Fail] = defined(o, CTORS_NAME, ?symbol.FUNCTION, res_ctors.ok, fact.CALL_CTORS);
    if (sel err_defined.err) { ret err_defined; }

    val funcref:       fact.Reference       = fact.Reference{nullable: true, heap: fact.Heap.abstract{tables.WASM_TYPE_FUNCREF.value::u8}};
    val res_add_entry: res[Id[Entry], Fail] = object.add_entry(o, Entry{space: ?space.TABLES});
    if (sel res_add_entry.err) { ret err[Fail].err{res_add_entry.err}; }
    val err_table_type: err[Fail] = fact.table_type(o, res_add_entry.ok, funcref, fact.Limits{min: 0, max: opt[u64].none{}, shared: false, wide: false}, opt[View].none{});
    if (sel err_table_type.err) { ret err_table_type; }
    val err_defined_table_name: err[Fail] = defined(o, TABLE_NAME, ?symbol.INDEXED, res_add_entry.ok, fact.FUNCTION_TABLE);
    if (sel err_defined_table_name.err) { ret err_defined_table_name; }

    val res_mem: res[Id[Entry], Fail] = object.add_entry(o, Entry{space: ?space.MEMORIES});
    if (sel res_mem.err) { ret err[Fail].err{res_mem.err}; }
    val err_memory_type: err[Fail] = fact.memory_type(o, res_mem.ok, fact.Limits{min: 0, max: opt[u64].none{}, shared: false, wide: wide});
    if (sel err_memory_type.err) { ret err_memory_type; }
    val err_defined_memory_name: err[Fail] = defined(o, MEMORY_NAME, ?symbol.INDEXED, res_mem.ok, fact.MEMORY);
    if (sel err_defined_memory_name.err) { ret err_defined_memory_name; }
    val err_exported: err[Fail] = exported(o, MEMORY_EXPORT, MEMORY_NAME);
    if (sel err_exported.err) { ret err_exported; }

    val res_base: res[i64, Fail] = neutral.address_value(c.target.arch, c.base);
    if (sel res_base.err) { ret err[Fail].err{res_base.err}; }
    val err_global: err[Fail] = global(c.inputs.a, o, STACK_NAME, valtype, true, res_address_const.ok, res_base.ok, opt[u32].none{});
    if (sel err_global.err) { ret err_global; }
    val err_global_base_name: err[Fail] = global(c.inputs.a, o, BASE_NAME, valtype, false, res_address_const.ok, res_base.ok, opt[u32].none{});
    if (sel err_global_base_name.err) { ret err_global_base_name; }
    ret global(c.inputs.a, o, TLS_NAME, valtype, false, res_address_const.ok, 0, opt[u32].some{fact.TLS_BASE});
}

# add to `o` a hidden symbol named `name` of kind `kind` defined at the entry
# `e`, and the fact of `key` that names the entry to the image writer
fun defined(o: *Object, name: str, kind: *symbol.Kind, e: Id[Entry], key: u32) err[Fail] {
    val res_name_str: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel res_name_str.err) { ret err[Fail].err{res_name_str.err}; }
    val res_add_symbol: res[Id[object.Symbol], Fail] = object.add_symbol(o, object.Symbol{name: res_name_str.ok, binding: ?symbol.GLOBAL, visibility: ?symbol.HIDDEN, kind: kind, def: Definition.entry{e}});
    if (sel res_add_symbol.err) { ret err[Fail].err{res_add_symbol.err}; }
    val res_add_fact: res[Id[Fact], Fail] = object.add_fact(o, Fact{format: ?format.WASM, key: key, value: e.index::u64, data: Contents.zero{0}});
    if (sel res_add_fact.err) { ret err[Fail].err{res_add_fact.err}; }
    ret err[Fail].ok{};
}

# add to `o` a directive that exports the symbol `name` as `as`
fun exported(o: *Object, as: str, name: str) err[Fail] {
    val res_text: res[Id[Name], Fail] = object.name_str(o, as);
    if (sel res_text.err) { ret err[Fail].err{res_text.err}; }
    val res_sym: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel res_sym.err) { ret err[Fail].err{res_sym.err}; }
    val res_add_directive: res[Id[object.Directive], Fail] = object.add_directive(o, object.Directive{kind: ?directive.EXPORT, text: res_text.ok, symbol: opt[Id[Name]].some{res_sym.ok}});
    if (sel res_add_directive.err) { ret err[Fail].err{res_add_directive.err}; }
    ret err[Fail].ok{};
}

# add to `o` a global named `name` of type `valtype`, mutable when `mutable`,
# starting at the constant `value` written by the opcode `op`, and the fact of
# `key` that names it to the image writer where there is one
fun global(a: *A.Allocator, o: *Object, name: str, valtype: u8, mutable: bool, op: u8, value: i64, key: opt[u32]) err[Fail] {
    var out:    Sink      = sink.init(a, LITTLE);
    var err_u8: err[Fail] = sink.u8(?out, op);
    err_u8 = fail.kept(err_u8, write.sleb(?out, value, leb128.signed_size(value)::u8));
    err_u8 = fail.kept(err_u8, sink.u8(?out, tables.WASM_OPCODE_END.value::u8));
    var res_add_entry:   res[Id[Entry], Fail] = res[Id[Entry], Fail].err{fail.internal("the global was not written")};
    var err_global_type: err[Fail]            = err_u8;
    if (sel err_u8.ok) { res_add_entry = object.add_entry(o, Entry{space: ?space.GLOBALS}); }
    val res_made: res[Id[Entry], Fail] = res_add_entry;
    if (sel res_made.ok) { err_global_type = fact.global_type(o, res_made.ok, fact.Value.number{valtype}, mutable, opt[View].some{View{data: sink.data(?out), len: sink.len(?out)}}); }
    val err_gone: err[Fail] = sink.dnit(?out);
    if (sel err_global_type.err) { ret err_global_type; }
    if (sel res_add_entry.err)   { ret err[Fail].err{res_add_entry.err}; }
    if (sel err_gone.err)        { ret err_gone; }
    val res_name_str: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel res_name_str.err) { ret err[Fail].err{res_name_str.err}; }
    val res_add_symbol: res[Id[object.Symbol], Fail] = object.add_symbol(o, object.Symbol{name: res_name_str.ok, binding: ?symbol.GLOBAL, visibility: ?symbol.HIDDEN, kind: ?symbol.INDEXED, def: Definition.entry{res_add_entry.ok}});
    if (sel res_add_symbol.err) { ret err[Fail].err{res_add_symbol.err}; }
    if (sel key.none)           { ret err[Fail].ok{}; }
    val res_add_fact: res[Id[Fact], Fail] = object.add_fact(o, Fact{format: ?format.WASM, key: key.some, value: res_add_entry.ok.index::u64, data: Contents.zero{0}});
    if (sel res_add_fact.err) { ret err[Fail].err{res_add_fact.err}; }
    ret err[Fail].ok{};
}
