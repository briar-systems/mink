# the relocation rows a link reads each object's relocations through
#
# an object's relocations are of its own architecture's pair, so an image
# whose architecture joins another, as an ARM64EC image takes x64 objects,
# reads the joined architecture's objects through that architecture's rows.
# what the link makes itself, its tables and templates, is of the output
# pair and reads the output pair's rows.

use std.types.option.opt;
use std.types.result.res;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.catalog.arch.Arch;
use mink.catalog.format.Format;
use mink.model.object.Object;
use mink.reloc.row;
use mink.reloc.row.Lookup;

# own:    the rows of the output pair
# joined: the rows of the output format for the architecture the link's own
#         joins, none for an architecture that joins none
pub rec Rows {
    own:    *Lookup;
    joined: opt[*Lookup];
}

# the rows of the link of the format `f` for the architecture `a`, through
# the registry `g`
pub fun of(g: *row.Registry, f: *Format, a: *Arch) res[Rows, Fail] {
    val own: res[*Lookup, Fail] = row.find(g, f, a);
    if (sel own.err) { ret res[Rows, Fail].err{own.err}; }
    val j: opt[*Arch] = a.joins;
    if (sel j.none) { ret res[Rows, Fail].ok{Rows{own: own.ok, joined: opt[*Lookup].none{}}}; }
    val joined: res[*Lookup, Fail] = row.find(g, f, j.some);
    if (sel joined.err) { ret res[Rows, Fail].err{fail.about(joined.err, j.some.name)}; }
    ret res[Rows, Fail].ok{Rows{own: own.ok, joined: opt[*Lookup].some{joined.ok}}};
}

# the rows the relocations of `o` are read through, refused for an object of
# an architecture the link takes no objects of, which settle refuses first
pub fun for_object(r: *Rows, o: *Object) res[*Lookup, Fail] {
    ret for_arch(r, o.target.arch);
}

pub fun for_arch(r: *Rows, a: *Arch) res[*Lookup, Fail] {
    if (r.own.set.arch == a) { ret res[*Lookup, Fail].ok{r.own}; }
    val j: opt[*Lookup] = r.joined;
    if (sel j.some) {
        if (j.some.set.arch == a) { ret res[*Lookup, Fail].ok{j.some}; }
    }
    ret res[*Lookup, Fail].err{fail.about(fail.internal("an object is for an architecture the link reads no relocation rows of"), a.name)};
}
