# the fold phase: input sections that are identical folded into one
#
# a section whose bytes, relocations and properties match another's may be
# folded into it, so every reference to it reaches the one kept, as identical
# code folding and type deduplication do. the phase runs after collect, over
# the sections that survived. no format folds yet, so the phase folds nothing
# and the record stays empty.

use std.types.error.err;

use A: std.allocator;

use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.link.collect.Live;
use mink.link.collect.Ref;
use mink.link.input.Inputs;

# a section folded into another
# ---
# folded: the section no longer laid out
# kept:   the section every reference to it reaches instead
pub rec Fold {
    folded: Ref;
    kept:   Ref;
}

# folds: every section folded, in the order the phase folded them
pub rec Folded {
    folds: Table[Fold];
}

pub rec In {
    inputs: *Inputs;
    live:   *Live;
}

pub fun make(a: *A.Allocator) Folded {
    ret Folded{folds: table.make[Fold](a)};
}

# fold the sections that may be folded, of which there are none yet
pub fun run(in: *In, out: *Folded) err[Fail] {
    ret err[Fail].ok{};
}

pub fun release(f: *Folded) err[Fail] {
    ret table.release[Fold](?f.folds);
}
