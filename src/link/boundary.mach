# the symbols a link defines at a place of its own layout
#
# a bound symbol is a name the link itself defines, whose value is an address
# only layout knows: the start or end of the image's loaded data, of an output
# section class or of one output section where it runs or where its bytes
# load, or a cell of a reserved table. a format's linking row lists them
# as data, each a name and a place, with the alignment the format rounds the
# value up to. resolve takes a reference to a listed name as defined by the
# link, a definition with no section yet that any input's definition of the
# name displaces, so nothing refuses it as undefined. after layout each bound
# symbol takes its place's address, absolute for a place in the loaded data
# as a whole and relative to its output section for a place at a class or a
# section, and a writer writes it as it writes any other symbol, with the
# binding, visibility and kind its row states. a place
# inside a reserved table lies relative to the output section holding the
# table, at the table's offset there and the place's own. a row that
# names a section by the rest of the referenced name is a prefix row, as
# __start_ and __stop_ name an output section by what follows them, and only
# a prefix row lies at a section. a section whose bytes load where it runs
# has its load address at its run address. a name at an output section no
# kept section is laid into is not the link's to define: it stays undefined
# when only weak references reach it, as the gABI resolves an undefined weak
# reference, and a strong reference to it is refused.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.model.symbol;

# where a bound symbol lies
# ---
# loaded_start:  the start of the image's loaded data, the image base when
#                nothing is loaded
# loaded_end:    the end of the image's loaded data
# class_start:   the start of the first loaded output section of the class
#                of this name in the format's layout rules
# class_end:     the end of the last loaded output section of the class
# section_start: the start of the output section the row names
# section_end:   the end of that output section
# load_start:    where the bytes of the output section the row names load,
#                its run address unless it loads in a region of its own
# load_end:      where those bytes end
# cell:          a place inside the reserved table that names the cell's
#                anchor
# got_base:      where the link's GOT-relative computations count from, the
#                start of the output section its pair's GOT base names
# block_start:   the start of the image's thread-local block, the base a
#                descriptor access counts a module's offsets from
pub tag Place: u8 {
    loaded_start;
    loaded_end;
    class_start: str;
    class_end:   str;
    section_start;
    section_end;
    load_start;
    load_end;
    cell: Cell;
    got_base;
    block_start;
}

# a key a reserved table names so a bound symbol can lie inside it
pub rec Anchor {
    name: str;
}

# a place inside a reserved table
# ---
# anchor: the key the table names
# offset: where in the table the place lies
pub rec Cell {
    anchor: *Anchor;
    offset: u64;
}

# one bound symbol of a format
# ---
# name:   the symbol's name, or for a prefix row the start of every name it
#         defines
# prefix: the row defines every name that starts with its name and names an
#         output section by the rest
# place:  where the symbol lies
# align:  what the value rounds up to, one where the format rounds nothing
# binding, visibility, kind:
#         what the image's symbol table writes the symbol as
pub rec Bound {
    name:       str;
    prefix:     bool;
    place:      Place;
    align:      u64;
    binding:    *symbol.Binding;
    visibility: *symbol.Visibility;
    kind:       *symbol.Kind;
}

# the bound symbols of a format
pub rec Bounds {
    rows:  *Bound;
    count: usize;
}

pub val NONE: Bounds = Bounds{rows: nil, count: 0};

# whether the place `p` names an output section
pub fun by_section(p: Place) bool {
    ret sel p.section_start || sel p.section_end || sel p.load_start || sel p.load_end;
}

# whether the place `p` is the start of the image's thread-local block, the
# module base a target there stands for
pub fun bases_block(p: Place) bool {
    ret sel p.block_start;
}

# whether the place `p` lies relative to an output section, moving with the image where a loader relocates it, rather than in
# the loaded data as a whole
pub fun relative(p: Place) bool {
    ret !(sel p.loaded_start) && !(sel p.loaded_end);
}

# the row of `b` that defines the name `text`, none when no row does
pub fun find(b: *Bounds, text: View) opt[*Bound] {
    var i: usize = 0;
    for (i < b.count) {
        val r: *Bound = ?b.rows[i];
        i = i + 1;
        val n: usize = str_len(r.name);
        if (r.prefix) {
            if (text.len > n && starts(text, r.name, n)) { ret opt[*Bound].some{r}; }
        }
        or (text.len == n && starts(text, r.name, n)) { ret opt[*Bound].some{r}; }
    }
    ret opt[*Bound].none{};
}

# the output section the prefix row `r` names for the name `text`, the rest
# of the name
pub fun section_of(r: *Bound, text: View) View {
    val n: usize = str_len(r.name);
    ret View{data: ?text.data[n], len: text.len - n};
}

fun starts(text: View, s: str, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (text.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# refuse rows that cannot stand, a defect of mink: a row with no name, a
# place at a section in a row that is no prefix, a prefix row whose place is
# at none, a class place with no class, a cell with no anchor, an alignment
# that is not a power of two, and a row that states no binding, visibility
# or kind
pub fun check(b: *Bounds) err[Fail] {
    var i: usize = 0;
    for (i < b.count) {
        val r: *Bound = ?b.rows[i];
        i = i + 1;
        if (r.name == nil || str_len(r.name) == 0)                    { ret err[Fail].err{fail.internal("a bound symbol has no name")}; }
        if (r.prefix != by_section(r.place))                          { ret err[Fail].err{fail.about(fail.internal("a bound symbol lies at a section exactly when its row is a prefix"), r.name)}; }
        if (r.align == 0 || (r.align & (r.align - 1)) != 0)           { ret err[Fail].err{fail.about(fail.internal("a bound symbol's alignment is not a power of two"), r.name)}; }
        if (sel r.place.class_start && r.place.class_start == nil)    { ret err[Fail].err{fail.about(fail.internal("a bound symbol names no class"), r.name)}; }
        if (sel r.place.class_end && r.place.class_end == nil)        { ret err[Fail].err{fail.about(fail.internal("a bound symbol names no class"), r.name)}; }
        if (sel r.place.cell && r.place.cell.anchor == nil)           { ret err[Fail].err{fail.about(fail.internal("a bound symbol's cell names no anchor"), r.name)}; }
        if (r.binding == nil || r.visibility == nil || r.kind == nil) { ret err[Fail].err{fail.about(fail.internal("a bound symbol states no binding, visibility or kind"), r.name)}; }
    }
    ret err[Fail].ok{};
}

val TEST_ROWS: [3]Bound = [3]Bound{
    Bound{name: "__heap_base", place: Place.loaded_end{}, align: 16, binding: ?symbol.GLOBAL, visibility: ?symbol.HIDDEN, kind: ?symbol.DATA},
    Bound{name: "__start_", prefix: true, place: Place.section_start{}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.PROTECTED, kind: ?symbol.NOTYPE},
    Bound{name: "_etext", place: Place.class_end{"text"}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.NOTYPE},
};
val TEST: Bounds = Bounds{rows: ?TEST_ROWS[0], count: 3};

fun view(s: str) View {
    ret View{data: s::*u8, len: str_len(s)};
}

test bound__a_name_finds_its_exact_or_prefix_row {
    val c: err[Fail] = check(?TEST);
    if (sel c.err) { ret 1; }
    val heap: opt[*Bound] = find(?TEST, view("__heap_base"));
    if (!sel heap.some)             { ret 2; }
    if (heap.some != ?TEST_ROWS[0]) { ret 2; }
    val longer: opt[*Bound] = find(?TEST, view("__heap_base2"));
    if (sel longer.some) { ret 2; }

    # a prefix row takes a name longer than its prefix, and the rest names
    # the section
    val start: opt[*Bound] = find(?TEST, view("__start_mydata"));
    if (!sel start.some)             { ret 3; }
    if (start.some != ?TEST_ROWS[1]) { ret 3; }
    val sec: View = section_of(start.some, view("__start_mydata"));
    if (sec.len != 6 || sec.data[0] != 'm') { ret 3; }
    val bare: opt[*Bound] = find(?TEST, view("__start_"));
    if (sel bare.some) { ret 3; }

    if (relative(TEST_ROWS[0].place) || !relative(TEST_ROWS[1].place) || !relative(TEST_ROWS[2].place)) { ret 4; }

    # a prefix row whose place names no section is refused
    val wrong: [1]Bound  = [1]Bound{Bound{name: "__x", prefix: true, place: Place.loaded_end{}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.NOTYPE}};
    var w:     Bounds    = Bounds{rows: ?wrong[0], count: 1};
    val e:     err[Fail] = check(?w);
    if (!sel e.err) { ret 5; }
    ret 0;
}
