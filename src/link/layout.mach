# the layout phase: surviving sections merge into output sections and
# segments and take their addresses, relaxation and thunks iterating until
# nothing moves. it reads no address an earlier run left, so running it again
# after a later phase grows a table lays everything out afresh
#
# every input section joins the output section its name and kind merge into,
# by the format's rules row, in the order collection kept it, padded to its
# alignment, with the atoms collection dropped cut out. the block of a group
# of merged pieces takes the place of the group's first member, and every
# other member takes no bytes, its bytes reaching the copies kept in the
# block. common blocks and the
# reserved tables follow as ordinary sections. output sections take the one
# class of the format their flags and roles match, the classes' ranks give the
# image order, and consecutive sections of one segment row share a segment.
# the image is laid out from the base the link states, the host's when it
# states none, and the system row says whether a loader maps the headers, the
# system's page or else the architecture's the granule segments respect.
# placement constraints state an address or an offset, an order, an
# alignment, the region a section runs in and the region its bytes load in
# for an output section, and the sections a constraint ranks come first among
# those loaded alike, in the order it ranks them. a region admits only the
# sections its access allows, a section runs and loads within its regions,
# no two sections overlap where they run or where they load, and the loaded
# bytes stay within the image's stated size. a refusal names both parties in
# the conflicts. the output is the one
# source of every address after it: each output section's, each input
# section's landing and each symbol's final value, the image base, and each
# name the link defines itself the address of the place the format's bound
# symbols put it at. participants rerun the whole pass
# until none reports a change, within a bound on passes.

use std.collections.map;
use std.collections.map.MapBy;
use std.collections.sort;
use std.crypto.hash.fnv1a;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.rule;
use mink.base.rule.Axis;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.catalog.kind;
use mink.catalog.os.Host;
use mink.catalog.output.Kind;
use mink.catalog.slot.SlotRole;
use mink.catalog.trait.Trait;
use mink.link.adjust;
use mink.link.adjust.Adjusted;
use mink.link.assign.Assigned;
use mink.link.boundary;
use mink.link.collect.Live;
use mink.link.collect.Range;
use mink.link.collect.Ref;
use mink.link.dynamic.Dynamic;
use mink.link.input;
use mink.link.input.Input;
use mink.link.input.Inputs;
use mink.link.pieces;
use mink.link.pieces.Pieces;
use mink.link.reserve;
use mink.link.reserve.Reservation;
use mink.link.reserve.Reserved;
use mink.link.reserve.Slot;
use mink.link.resolve;
use mink.link.resolve.Binding;
use mink.link.resolve.Resolved;
use mink.link.resolve.Weak;
use mink.link.template;
use mink.link.thread.Thread;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.section;
use mink.model.target.Target;
use mink.reloc.row.Lookup;

# a load segment of a format: its name there and the flags it maps with
pub rec Load {
    name:  str;
    flags: section.Flags;
}

# a class of output sections: those whose flags and whose kind's roles its
# axes hold. a format's classes are disjoint, so at most one takes a section
# ---
# name:  how a refusal of the classes names the class
# rank:  where its sections lie in the image, a lower rank first
# flags: over the section's flags
# roles: over the roles of the section's kind
# load:  the segment its sections load in, none for sections no segment loads
pub rec Class {
    name:  str;
    rank:  u32;
    flags: Axis;
    roles: Axis;
    load:  opt[*Load];
}

# how a format lays an image out
# ---
# name:          how a refusal of the rules names them
# stems:         the names an input section merges into when its own name is
#                the stem, or the stem then joint and more, the longest stem
#                winning
# stem_count:    how many
# joint:         the byte that follows a stem in a longer name
# cut:           the byte that splits a name into its output section's name
#                and the key that orders it there, zero where none does
# classes:       the classes of output sections, disjoint
# class_count:   how many
# commons:       the output section common blocks are allocated in, which
#                the common storage synthesizer names its storage by
# opens:         how a segment opens in the file where a loader maps it
# section_align: the alignment of every loaded output section's address
# file_align:    the alignment of every output section's file offset where
#                a segment's offsets follow no page
# sections:      the index of the first output section in the format's
#                section table, absent where no relocation names one
# naming:        the name the format gives a section of a key that states
#                none
# joins:         the kinds the format lays into the output section of another
#                kind, beyond the joins the kinds state themselves
# join_count:    how many
pub rec Rules {
    name:          str;
    stems:         *str;
    stem_count:    usize;
    joint:         u8;
    cut:           u8;
    classes:       *Class;
    class_count:   usize;
    commons:       str;
    opens:         Opening;
    section_align: u64;
    file_align:    u64;
    sections:      opt[u64];
    naming:        fun(section.Key) res[str, Fail];
    joins:         *Join;
    join_count:    usize;
}

# a kind a format lays into the output section of another, after that kind's
# own sections of an equal order key, as PE lays zero-fill thread-local data
# into its one template behind the initialized data
# ---
# kind: the kind joining
# into: the kind whose output section it joins
pub rec Join {
    kind: *section.Kind;
    into: *section.Kind;
}

# the output section kind a section of kind `k` lays into under `r`, and
# whether it follows that kind's own sections of an equal order key
rec Joined {
    kind:  *section.Kind;
    after: bool;
}

fun joined(r: *Rules, k: *section.Kind) Joined {
    var i: usize = 0;
    for (i < r.join_count) {
        if (r.joins[i].kind == k) { ret Joined{kind: r.joins[i].into, after: true}; }
        i = i + 1;
    }
    ret Joined{kind: section.joined(k), after: false};
}

# how a segment opens in the file where a loader maps the image
# ---
# none:      at any offset, following no page
# congruent: at an offset that agrees with its address modulo the page, as an
#            ELF loader maps a segment
# paged:     on a page in the file and in memory, as the Mach-O kernel and
#            dyld map a segment
pub tag Opening: u8 {
    none;
    congruent;
    paged;
}

# the access a memory region allows, each a bit of a region's access
pub val READABLE:   u8 = 1;
pub val WRITABLE:   u8 = 2;
pub val EXECUTABLE: u8 = 4;

# a memory region output sections may be confined to
# ---
# access: what it allows, of READABLE, WRITABLE and EXECUTABLE
pub rec Region {
    name:   Id[Name];
    start:  u64;
    size:   u64;
    access: u8;
}

# what the link states of the output sections of one name, each fact absent
# unless stated
# ---
# section:  the output sections' name, in the link's names
# spelling: that name as the caller stated it, borrowed from the caller,
#           which a refusal names
# address:  the address the section starts at
# offset:   where the section starts from the start of its region, from the
#           image base where it lies in none
# order:    its rank, the ranked sections first in rank order
# align:    an alignment it takes beyond its inputs'
# region:   the memory region it runs in
# load:     the memory region its bytes load in, the one it runs in when
#           absent
pub rec Constraint {
    section:  Id[Name];
    spelling: str;
    address:  opt[u64];
    offset:   opt[u64];
    order:    opt[u32];
    align:    opt[u64];
    region:   opt[Id[Region]];
    load:     opt[Id[Region]];
}

# the placement constraints of a link
# ---
# size: the bytes the image takes from its base, which its loaded bytes stay
#       within, none where the link states none
pub rec Constraints {
    sections: Table[Constraint];
    regions:  Table[Region];
    size:     opt[u64];
}

# two parties a placement was refused over, an output section and another
# output section or a region, each by name. a refusal about one section alone
# names it as both
# ---
# why: the refusal, static
pub rec Conflict {
    first:  Id[Name];
    second: Id[Name];
    why:    str;
}

# what reruns layout until nothing moves, as relaxation, thunk insertion or a
# table that grows. a participant that edits the inputs' bytes or chooses the
# forms of relocations restates its own records of the adjusted record each
# step, under its name, and leaves every other participant's
# ---
# name: its spelling in a diagnostic, and the name its records carry
# step: reads the layout a pass made and changes what the next pass reads,
#       true when it changed anything
pub rec Participant {
    name: str;
    step: fun(*In, *Layout) res[bool, Fail];
}

pub rec Participants {
    rows:  **Participant;
    count: usize;
}

# the passes a layout may take before it is refused as not converging
pub val PASSES: u32 = 32;

# pieces:       the pieces of the merged sections and the copies kept
# target:       what the image is for
# host:         what the system says for the architecture, which says whether
#               a loader maps the image
# base:         the address the image is laid out from
# rules:        how the output format lays an image out
# thread:       how the thread pointer relates to the thread-local block for
#               the output pair, none where the pair states none
# constraints:  what the link states of where sections go
# participants: what reruns layout until nothing moves
# adjusted:     what the participants changed of the inputs' bytes, which
#               they write and each pass reads
# relocs:       the relocation rows of the output pair, whose forms a
#               participant chooses among
# dynamic:      what each relocation needs and the forms it may take
# traits:       the link's merged traits, which choose a veneer's template
# templates:    the code templates of the output pair, which shape the
#               veneers a participant lays, none for a pair with none
# assigned:     the index every entry and symbol reaches, which a form's
#               value may read
# weak:         how the format resolves an undefined weak reference, which a
#               form's value may read
# limit:        the passes layout may take
pub rec In {
    inputs:       *Inputs;
    names:        *Interner;
    resolved:     *Resolved;
    live:         *Live;
    pieces:       *Pieces;
    reserved:     *Reserved;
    kind:         *Kind;
    target:       *Target;
    host:         *Host;
    base:         u64;
    rules:        *Rules;
    thread:       opt[*Thread];
    constraints:  *Constraints;
    participants: Participants;
    adjusted:     *Adjusted;
    relocs:       *Lookup;
    dynamic:      *Dynamic;
    traits:       *Table[Trait];
    templates:    opt[*template.Set];
    assigned:     *Assigned;
    weak:         Weak;
    limit:        u32;
}

# an output section
# ---
# name:     its name, in the link's names
# kind:     the role it plays
# flags:    the flags it carries
# align:    its alignment
# entsize:  the size of one of its entries, zero where its inputs state none
#           or state different sizes
# size:     its size in memory
# address:  where it runs, zero for a section no segment loads
# loads:    where its bytes are loaded, its address unless it loads in
#           another region
# offset:   where its bytes sit in the file
# segment:  the load segment holding it
# position: its place in image order
pub rec Merged {
    name:     Id[Name];
    kind:     *section.Kind;
    flags:    section.Flags;
    align:    u64;
    entsize:  u64;
    size:     u64;
    address:  u64;
    loads:    u64;
    offset:   u64;
    segment:  opt[Id[Segment]];
    position: u32;
}

# where an input section landed
# ---
# merged:    the output section
# offset:    where in it the section starts
# size:      its size there, once the atoms collection dropped are cut out
# source:    its size in the input
# cut_first: its first cut
# cut_count: how many
pub rec Landing {
    at:        Ref;
    merged:    Id[Merged];
    offset:    u64;
    size:      u64;
    source:    u64;
    cut_first: u32;
    cut_count: u32;
}

# a range cut from an input section, start up to end, of which removed bytes
# are cut from the output. a range a dropped atom left drops its bytes, and
# removes the whole range where an edit restores the alignment of the bytes
# after it, and otherwise a multiple of the section's alignment so every byte
# after it keeps its alignment. a range an edit deletes removes the whole
# range, and a byte in it lands where the range was
# ---
# drops:  the bytes in the range have no place in the output
# before: the bytes the section's earlier cuts removed
pub rec Cut {
    start:   u64;
    end:     u64;
    removed: u64;
    drops:   bool;
    before:  u64;
}

# a load segment
# ---
# load:        the format's segment it is, none for a segment a table takes
#              for itself
# flags:       the flags it maps with
# address:     where it runs
# loads:       where its bytes are loaded, its address unless its sections
#              load in another region
# offset:      where its bytes sit in the file
# file_size:   how many of its bytes the file holds
# memory_size: its size in memory
# align:       the alignment its address and offset agree modulo, one where
#              they need not agree
pub rec Segment {
    load:        opt[*Load];
    flags:       section.Flags;
    address:     u64;
    loads:       u64;
    offset:      u64;
    file_size:   u64;
    memory_size: u64;
    align:       u64;
}

# where a reserved table or a common block landed: the output section holding
# it and its offset there
pub rec Placed {
    merged: Id[Merged];
    offset: u64;
}

# where layout put a reserved table
# ---
# section:  in an output section
# header:   at this offset into the headers at the start of the file
# file_end: after every other byte of the file, where the image writer
#           puts it
# islands:  in its islands, each where the layout's islands say
pub tag Spot: u8 {
    section: Placed;
    header:  u64;
    file_end;
    islands;
}

# the bytes a table spans in the image
pub rec Span {
    address: u64;
    size:    u64;
}

# the anchors thread-local offsets count from
# ---
# tp:  the address thread pointer offsets count from
# dtp: the address dynamic thread vector offsets count from
pub rec Anchors {
    tp:  u64;
    dtp: u64;
}

# the thread-local block: the output sections that carry thread-local data,
# which a loader copies for each thread
# ---
# address: where the block starts
# size:    its size in memory
# align:   its alignment
# anchors: where its offsets count from, absent where the format states no
#          thread pointer layout for the architecture
pub rec Tls {
    address: u64;
    size:    u64;
    align:   u64;
    anchors: opt[Anchors];
}

# where a byte of an input section landed
# ---
# merged:  the output section
# offset:  where in it
# address: its address
# file:    its offset in the file
pub rec Position {
    merged:  Id[Merged];
    offset:  u64;
    address: u64;
    file:    u64;
}

# the one source of every address after layout
# ---
# merged:    the output sections, in the order they were made
# index:     the output sections by name and kind
# named:     the last output section of each name, by name
# prior:     each output section's previous one of the same name plus one,
#            zero for the first
# order:     the output sections in image order
# landings:  where every input section landed, in the order collection kept
#            them
# cuts:      the ranges cut from the landed sections, landing by landing,
#            each landing's ascending
# segments:  the load segments, in address order
# tables:    where every reserved table landed, one row per reservation in
#            reservation order
# islands:   where every island landed, one row per island in the order the
#            link made them
# slots:     each section of each input's landing plus one, zero for a
#            section that did not survive
# firsts:    the index in slots of each input's first section
# values:    the final value of each symbol of each input, none for one that
#            has no address, as an import or a symbol of a dropped atom
# starts:    the index in values of each input's first symbol
# conflicts: the placements a run was refused over, naming both parties
# sections:  the index of the first output section in the format's section
#            table, absent where no relocation names one
# tls:       the thread-local block, none when no section carries
#            thread-local data
# header:    the bytes the format's headers take at the start of the file,
#            the tables placed after the header together
# end:       the end of the last output section's bytes in the file
# tail:      where the output sections no segment loads lie
# rounds:    how many passes layout took to reach its fixed point
# base:      the address the image was laid out from
# loaded:    the loaded data as a whole, from the lowest loaded address to
#            the end of the highest, empty at the image base when nothing is
#            loaded
# bounds:    the value of each name the link defines itself, in the order of
#            the resolve phase's linked names
pub rec Layout {
    merged:    Table[Merged];
    index:     MapBy[MergedKey, u32];
    named:     MapBy[u32, u32];
    prior:     Table[u32];
    order:     Table[Id[Merged]];
    landings:  Table[Landing];
    cuts:      Table[Cut];
    segments:  Table[Segment];
    tables:    Table[Spot];
    islands:   Table[Placed];
    slots:     Table[u32];
    firsts:    Table[u32];
    values:    Table[opt[u64]];
    starts:    Table[u32];
    conflicts: Table[Conflict];
    sections:  opt[u64];
    tls:       opt[Tls];
    header:    u64;
    end:       u64;
    tail:      Tail;
    rounds:    u32;
    base:      u64;
    loaded:    Span;
    bounds:    Table[Bounded];
}

# the output sections no segment loads, which follow every loaded byte in
# image order
# ---
# first: the place in image order of the first of them, the count of output
#        sections where there are none
# start: the file offset after the last loaded byte, where they start
# align: the least alignment of each one's file offset
pub rec Tail {
    first: u32;
    start: u64;
    align: u64;
}

# a section of the tail as the file holds it: its size there, zero for one
# with no bytes in the file, and the alignment of its offset
pub rec Tailed {
    size:  u64;
    align: u64;
}

# place the sections of the tail, the k-th in image order as `sizes` k says,
# writing each one's offset to `offsets`, and the end of the last
pub fun place_tail(l: *Layout, sizes: *Table[Tailed], offsets: *Table[u64]) res[u64, Fail] {
    val at: Location = Location{record: "output section"};
    val n:  usize    = table.count[Id[Merged]](?l.order) - l.tail.first::usize;
    if (table.count[Tailed](sizes) != n) { ret res[u64, Fail].err{fail.internal("the tail sizes do not match the tail sections")}; }
    table.clear[u64](offsets);
    val g: res[Id[u64], Fail] = table.grow[u64](offsets, n);
    if (sel g.err) { ret res[u64, Fail].err{g.err}; }
    var off: u64   = l.tail.start;
    var k:   usize = 0;
    for (k < n) {
        val t:     *Tailed = table.at[Tailed](sizes, table.nth[Tailed](k));
        var align: u64     = t.align;
        if (align < l.tail.align) { align = l.tail.align; }
        val so: res[u64, Fail] = checked.align_up(at, off, align);
        if (sel so.err) { ret res[u64, Fail].err{fail.in_indexed(so.err, "output section", (l.tail.first::usize + k)::u64)}; }
        table.items[u64](offsets)[k] = so.ok;
        val fe: res[u64, Fail] = checked.add(at, so.ok, t.size);
        if (sel fe.err) { ret res[u64, Fail].err{fe.err}; }
        off = fe.ok;
        k   = k + 1;
    }
    ret res[u64, Fail].ok{off};
}

# the value of a name the link defines itself
# ---
# value:  its address
# merged: the output section it lies relative to, none for an absolute one
pub rec Bounded {
    value:  u64;
    merged: opt[Id[Merged]];
}

pub fun make(a: *A.Allocator) Layout {
    ret Layout{
        merged:    table.make[Merged](a),
        index:     map.init_by[MergedKey, u32](a, merged_hash, merged_equal),
        named:     map.init_by[u32, u32](a, name_hash, name_equal),
        prior:     table.make[u32](a),
        order:     table.make[Id[Merged]](a),
        landings:  table.make[Landing](a),
        cuts:      table.make[Cut](a),
        segments:  table.make[Segment](a),
        tables:    table.make[Spot](a),
        islands:   table.make[Placed](a),
        slots:     table.make[u32](a),
        firsts:    table.make[u32](a),
        values:    table.make[opt[u64]](a),
        starts:    table.make[u32](a),
        conflicts: table.make[Conflict](a),
        sections:  opt[u64].none{},
        tls:       opt[Tls].none{},
        bounds:    table.make[Bounded](a),
    };
}

pub fun constraints(a: *A.Allocator) Constraints {
    ret Constraints{sections: table.make[Constraint](a), regions: table.make[Region](a), size: opt[u64].none{}};
}

pub fun release_constraints(c: *Constraints) err[Fail] {
    val rs: err[Fail] = table.release[Constraint](?c.sections);
    val rr: err[Fail] = table.release[Region](?c.regions);
    if (sel rs.err) { ret rs; }
    ret rr;
}

# lay the link out, pass after pass while a participant reports a change,
# refused once the passes reach the limit without settling. every pass starts
# afresh from the inputs and what the participants changed
pub fun run(in: *In, out: *Layout) err[Fail] {
    # the rules are static, so one index per process could serve every run
    val x: res[rule.Index, Fail] = check(in.rules, in.inputs.a);
    if (sel x.err) { ret err[Fail].err{x.err}; }
    var classes: rule.Index = x.ok;
    val e:       err[Fail]  = passes(in, ?classes, out);
    val r:       err[Fail]  = rule.release(?classes);
    if (sel e.err) { ret e; }
    ret r;
}

fun passes(in: *In, classes: *rule.Index, out: *Layout) err[Fail] {
    var passes: u32 = 0;
    for {
        clear(out);
        val e: err[Fail] = lay_out(in, classes, out);
        if (sel e.err) { ret e; }
        passes     = passes + 1;
        out.rounds = passes;
        var moved: bool  = false;
        var i:     usize = 0;
        for (i < in.participants.count) {
            val p: *Participant    = in.participants.rows[i];
            val r: res[bool, Fail] = p.step(in, out);
            if (sel r.err) { ret err[Fail].err{fail.in_record(r.err, p.name)}; }
            if (r.ok)      { moved = true; }
            i = i + 1;
        }
        if (!moved)             { ret err[Fail].ok{}; }
        if (passes >= in.limit) { ret err[Fail].err{fail.overflow("layout does not converge within its pass limit")}; }
    }
    ret err[Fail].ok{};
}

# where the byte `offset` of the input section `at` lands, none when the
# section did not survive or the byte lies in a dropped atom. a byte of a
# merged section lands on the same byte of the copy kept for it in its
# group's block, which `p` records. an offset past the section's end is
# refused
pub fun locate(l: *Layout, p: *Pieces, at: Ref, offset: u64) res[opt[Position], Fail] {
    val id: opt[Id[Landing]] = landing_of(l, at);
    if (sel id.none) { ret res[opt[Position], Fail].ok{opt[Position].none{}}; }
    val g: *Landing = table.at[Landing](?l.landings, id.some);
    if (offset > g.source) { ret res[opt[Position], Fail].err{fail.malformed("a place lies past the end of its section")}; }
    val member: opt[Id[pieces.Member]] = pieces.member_of(p, at);
    if (sel member.some) { ret kept_at(l, p, member.some, offset); }
    var low:  u32 = 0;
    var high: u32 = g.cut_count;
    for (low < high) {
        val mid: u32 = low + (high - low) / 2;
        if (table.at[Cut](?l.cuts, table.nth[Cut]((g.cut_first + mid)::usize)).start <= offset) { low = mid + 1; }
        or                                                                                      { high = mid; }
    }
    var in: u64 = g.offset + offset;
    if (low != 0) {
        val c: *Cut = table.at[Cut](?l.cuts, table.nth[Cut]((g.cut_first + low - 1)::usize));
        if (offset < c.end && c.drops) { ret res[opt[Position], Fail].ok{opt[Position].none{}}; }
        if (offset < c.end)            { in = g.offset + c.start - c.before; }
        or                             { in = g.offset + offset - c.before - c.removed; }
    }
    val m: *Merged = table.at[Merged](?l.merged, g.merged);
    ret res[opt[Position], Fail].ok{opt[Position].some{Position{
        merged:  g.merged,
        offset:  in,
        address: m.address + in,
        file:    m.offset + in,
    }}};
}

# where the byte `offset` of the member `m` lands: on the copy kept for it in
# its group's block, which lands where the group's holder does
fun kept_at(l: *Layout, p: *Pieces, m: Id[pieces.Member], offset: u64) res[opt[Position], Fail] {
    val place: res[opt[u64], Fail] = pieces.place_of(p, m, offset);
    if (sel place.err)     { ret res[opt[Position], Fail].err{place.err}; }
    if (sel place.ok.none) { ret res[opt[Position], Fail].ok{opt[Position].none{}}; }
    val hold: opt[Id[Landing]] = landing_of(l, pieces.group_of(p, m).holder);
    if (sel hold.none) { ret res[opt[Position], Fail].err{fail.internal("the holder of a merged block did not land")}; }
    val g:  *Landing = table.at[Landing](?l.landings, hold.some);
    val mg: *Merged  = table.at[Merged](?l.merged, g.merged);
    val in: u64      = g.offset + place.ok.some;
    ret res[opt[Position], Fail].ok{opt[Position].some{Position{
        merged:  g.merged,
        offset:  in,
        address: mg.address + in,
        file:    mg.offset + in,
    }}};
}

# where the input section `at` landed, none when it did not survive
pub fun landing_of(l: *Layout, at: Ref) opt[Id[Landing]] {
    if (at.input.index::usize >= table.count[u32](?l.firsts)) { ret opt[Id[Landing]].none{}; }
    val i: usize = table.items[u32](?l.firsts)[at.input.index]::usize + at.section.index::usize;
    if (i >= table.count[u32](?l.slots)) { ret opt[Id[Landing]].none{}; }
    val s: u32 = table.items[u32](?l.slots)[i];
    if (s == 0) { ret opt[Id[Landing]].none{}; }
    ret opt[Id[Landing]].some{Id[Landing]{index: s - 1}};
}

# the final value of the symbol `s` of the input `in`, none when it has no
# address
pub fun value_of(l: *Layout, in: Id[Input], s: Id[Symbol]) opt[u64] {
    val at: *opt[u64] = value_at(l, in, s);
    if (at == nil) { ret opt[u64].none{}; }
    ret @at;
}

val NONE: u32 = 0xFFFF_FFFF;

# where a section sits in image order
# ---
# class:      the class that takes it, by its index in the format's classes
# image:      0 for a section a format's segment loads, 1 for a table's own
#             segment, 2 for a section no segment loads
# constraint: the constraint naming it, NONE for none
# address:    the address it is stated at, by address or by offset
rec Info {
    class:      u32;
    image:      u8;
    constraint: u32;
    address:    opt[u64];
}

# an input section in the order its output section takes it, `after` when
# its kind joins the output section behind the sections of its own kind
rec Entry {
    landing: u32;
    merged:  u32;
    key:     *u8;
    key_len: usize;
    align:   u64;
    after:   bool;
}

# an output section in image order
# ---
# rank: its class's rank
rec Rank {
    image:  u8;
    rank:   u32;
    stated: u8;
    order:  u32;
    index:  u32;
}

# a loaded output section by address
rec Extent {
    address: u64;
    size:    u64;
    index:   u32;
}

# classes: the index of the format's classes
# isles:   per landing, the islands that lie beside it
rec Pass {
    in:      *In;
    l:       *Layout;
    classes: *rule.Index;
    infos:   Table[Info];
    entries: Table[Entry];
    ranks:   Table[Rank];
    spans:   Table[Extent];
    cursors: Table[u64];
    isles:   Table[Isles];
}

fun lay_out(in: *In, classes: *rule.Index, l: *Layout) err[Fail] {
    val a: *A.Allocator = in.inputs.a;
    adjust.seal(in.adjusted);
    var p: Pass = Pass{
        in:      in,
        l:       l,
        classes: classes,
        infos:   table.make[Info](a),
        entries: table.make[Entry](a),
        ranks:   table.make[Rank](a),
        spans:   table.make[Extent](a),
        cursors: table.make[u64](a),
        isles:   table.make[Isles](a),
    };
    val r:  err[Fail] = steps(?p);
    val ri: err[Fail] = table.release[Info](?p.infos);
    val re: err[Fail] = table.release[Entry](?p.entries);
    val rr: err[Fail] = table.release[Rank](?p.ranks);
    val rs: err[Fail] = table.release[Extent](?p.spans);
    val rc: err[Fail] = table.release[u64](?p.cursors);
    val rl: err[Fail] = table.release[Isles](?p.isles);
    if (sel r.err)  { ret r; }
    if (sel ri.err) { ret ri; }
    if (sel re.err) { ret re; }
    if (sel rr.err) { ret rr; }
    if (sel rs.err) { ret rs; }
    if (sel rc.err) { ret rc; }
    ret rl;
}

fun steps(p: *Pass) err[Fail] {
    p.l.sections = p.in.rules.sections;
    val m: err[Fail] = merge(p);
    if (sel m.err)                                                 { ret m; }
    if (table.count[resolve.Storage](?p.in.resolved.commons) != 0) { ret err[Fail].err{fail.internal("a common block reaches layout unallocated")}; }
    val t: err[Fail] = place(p.l, p.in.reserved);
    if (sel t.err) { ret t; }
    val k: err[Fail] = constrain(p);
    if (sel k.err) { ret k; }
    val s: err[Fail] = classify(p);
    if (sel s.err) { ret s; }
    val o: err[Fail] = arrange(p);
    if (sel o.err) { ret o; }
    val d: err[Fail] = address(p);
    if (sel d.err) { ret d; }
    val th: err[Fail] = thread(p);
    if (sel th.err) { ret th; }
    val v: err[Fail] = overlaps(p);
    if (sel v.err) { ret v; }
    val c: err[Fail] = ceiling(p);
    if (sel c.err) { ret c; }
    ret values(p);
}

# the length of the output section name `n` bytes at `name` merge into, and
# where the key ordering it there starts
rec Split {
    len:     usize;
    key:     *u8;
    key_len: usize;
}

fun split(r: *Rules, name: *u8, n: usize) Split {
    var best: usize = 0;
    var i:    usize = 0;
    for (i < r.stem_count) {
        val stem: str   = r.stems[i];
        val len:  usize = str_len(stem);
        if (len > best && len <= n && same(name, stem::*u8, len) && (len == n || name[len] == r.joint)) { best = len; }
        i = i + 1;
    }
    if (best != 0) { ret Split{len: best, key: nil, key_len: 0}; }
    if (r.cut != 0) {
        var j: usize = 0;
        for (j < n) {
            if (name[j] == r.cut) { ret Split{len: j, key: ?name[j + 1], key_len: n - j - 1}; }
            j = j + 1;
        }
    }
    ret Split{len: n, key: nil, key_len: 0};
}

# the output section a section is laid into, in the link's names, and the key
# that orders it there, nil where none does
pub rec Named {
    name:    Id[Name];
    key:     *u8;
    key_len: usize;
}

# the output section the section `s` of `o` is laid into under the rules `r`,
# its name interned in `names`
pub fun named(names: *Interner, r: *Rules, o: *Object, s: *Section) res[Named, Fail] {
    val v: res[View, Fail] = object.section_name(o, s, r.naming);
    if (sel v.err) { ret res[Named, Fail].err{v.err}; }
    val sp: Split               = split(r, v.ok.data::*u8, v.ok.len);
    val nm: res[Id[Name], Fail] = intern.intern(names, v.ok.data::*u8, sp.len);
    if (sel nm.err) { ret res[Named, Fail].err{nm.err}; }
    ret res[Named, Fail].ok{Named{name: nm.ok, key: sp.key, key_len: sp.key_len}};
}

# mark in `out`, by name id, each output section a section `live` keeps is
# laid into under the rules `r`
pub fun landed(names: *Interner, r: *Rules, inputs: *Inputs, live: *Live, out: *Table[bool]) err[Fail] {
    var k: usize = 0;
    for (k < table.count[Ref](?live.kept)) {
        val at: Ref     = @table.at[Ref](?live.kept, table.nth[Ref](k));
        val o:  *Object = input.object_of(inputs, at.input);
        k = k + 1;
        val nd: res[Named, Fail] = named(names, r, o, object.section_at(o, at.section));
        if (sel nd.err) { ret err[Fail].err{nd.err}; }
        val have: usize = table.count[bool](out);
        if (nd.ok.name.index::usize >= have) {
            val g: res[Id[bool], Fail] = table.grow[bool](out, nd.ok.name.index::usize + 1 - have);
            if (sel g.err) { ret err[Fail].err{g.err}; }
        }
        table.items[bool](out)[nd.ok.name.index] = true;
    }
    ret err[Fail].ok{};
}

fun same(a: *u8, b: *u8, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun size_of(o: *Object, s: *Section) u64 {
    if (sel s.contents.zero) { ret s.contents.zero; }
    ret object.bytes(o, ?s.contents).len::u64;
}

# an output section as the index finds it
rec MergedKey {
    name: u32;
    kind: *section.Kind;
}

fun merged_hash(k: *MergedKey) u64 {
    ret fnv1a.step_u32(fnv1a.FNV_INIT, k.name);
}

fun merged_equal(a: *MergedKey, b: *MergedKey) bool {
    ret a.name == b.name && a.kind == b.kind;
}

fun released(r: err[A.Error]) err[Fail] {
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}

fun find_merged(l: *Layout, name: Id[Name], k: *section.Kind) opt[Id[Merged]] {
    var probe: MergedKey = MergedKey{name: name.index, kind: k};
    val found: opt[*u32] = map.get_by[MergedKey, u32](?l.index, ?probe);
    if (sel found.some) { ret opt[Id[Merged]].some{Id[Merged]{index: @found.some}}; }
    ret opt[Id[Merged]].none{};
}

fun merged_of(l: *Layout, name: Id[Name], k: *section.Kind, flags: section.Flags, entsize: u64) res[Id[Merged], Fail] {
    val found: opt[Id[Merged]] = find_merged(l, name, k);
    if (sel found.some) {
        join(table.at[Merged](?l.merged, found.some), flags, entsize);
        ret res[Id[Merged], Fail].ok{found.some};
    }
    val made: res[Id[Merged], Fail] = add_merged(l, Merged{name: name, kind: k, flags: flags, align: 1, entsize: entsize});
    if (sel made.err) { ret made; }
    val put: res[bool, A.Error] = map.insert_by[MergedKey, u32](?l.index, MergedKey{name: name.index, kind: k}, made.ok.index);
    if (sel put.err) {
        table.truncate[Merged](?l.merged, made.ok.index::usize);
        ret res[Id[Merged], Fail].err{fail.refused(put.err)};
    }
    ret made;
}

# the flags that say what a section's entries are
val ENTRIES: section.Flags = section.MERGE | section.STRINGS;

# a section of `flags` and entries of `entsize` joins the output section `m`.
# its flags add to the output's, except that the output keeps an entry size,
# and the flags that say what its entries are, only while every input states
# the same: a mix of entries has no fixed size
fun join(m: *Merged, flags: section.Flags, entsize: u64) {
    val shared: section.Flags = m.flags & flags & ENTRIES;
    m.flags = ((m.flags | flags) & ~ENTRIES) | shared;
    if (m.entsize != entsize) {
        m.entsize = 0;
        m.flags   = m.flags & ~ENTRIES;
    }
}

# every surviving input section joins its output section by name and the kind
# its own kind joins or the format's rules join it to, padded to its
# alignment, in the order collection kept it unless the format orders it by a
# key in its name, a kind the rules join following the joined kind's own
# sections of an equal key. the holder of a group of merged pieces takes
# the size and alignment of the group's block, the other members land beside
# it taking nothing, and no dropped range cuts a member, whose pieces the
# merge phase already left out
fun merge(p: *Pass) err[Fail] {
    val in: *In     = p.in;
    val l:  *Layout = p.l;
    var i:  usize   = 0;
    for (i < input.count(in.inputs)) {
        val f: res[Id[u32], Fail] = table.push[u32](?l.firsts, table.count[u32](?l.slots)::u32);
        if (sel f.err) { ret err[Fail].err{f.err}; }
        val o: *Object = input.object_of(in.inputs, table.nth[Input](i));
        if (o != nil && table.count[Section](?o.sections) != 0) {
            val g: res[Id[u32], Fail] = table.grow[u32](?l.slots, table.count[Section](?o.sections));
            if (sel g.err) { ret err[Fail].err{g.err}; }
        }
        i = i + 1;
    }

    var k: usize = 0;
    for (k < table.count[Ref](?in.live.kept)) {
        val at: Ref      = @table.at[Ref](?in.live.kept, table.nth[Ref](k));
        val o:  *Object  = input.object_of(in.inputs, at.input);
        val s:  *Section = object.section_at(o, at.section);
        k = k + 1;
        val nd: res[Named, Fail] = named(in.names, in.rules, o, s);
        if (sel nd.err) { ret err[Fail].err{nd.err}; }
        val jk: Joined                = joined(in.rules, s.kind);
        val m:  res[Id[Merged], Fail] = merged_of(l, nd.ok.name, jk.kind, s.flags, s.entsize);
        if (sel m.err) { ret err[Fail].err{m.err}; }
        val source: u64                    = size_of(o, s);
        var size:   u64                    = source;
        var align:  u64                    = s.align;
        var placed: bool                   = true;
        val member: opt[Id[pieces.Member]] = pieces.member_of(in.pieces, at);
        if (sel member.some) {
            val gr: *pieces.Group = pieces.group_of(in.pieces, member.some);
            size   = 0;
            placed = gr.holder.input.index == at.input.index && gr.holder.section.index == at.section.index;
            if (placed) {
                size  = gr.size;
                align = gr.align;
            }
        }
        val g: res[Id[Landing], Fail] = table.push[Landing](?l.landings, Landing{at: at, merged: m.ok, size: size, source: source});
        if (sel g.err) { ret err[Fail].err{g.err}; }
        table.items[u32](?l.slots)[table.items[u32](?l.firsts)[at.input.index]::usize + at.section.index::usize] = g.ok.index + 1;
        if (!placed) { cnt; }
        val e: res[Id[Entry], Fail] = table.push[Entry](?p.entries, Entry{
            landing: g.ok.index,
            merged:  m.ok.index,
            key:     nd.ok.key,
            key_len: nd.ok.key_len,
            align:   align,
            after:   jk.after,
        });
        if (sel e.err) { ret err[Fail].err{e.err}; }
    }

    val cs: err[Fail] = cuts(p);
    if (sel cs.err) { ret cs; }

    val il: err[Fail] = isled(p);
    if (sel il.err) { ret il; }
    sort.sort_by[Entry](table.items[Entry](?p.entries), table.count[Entry](?p.entries), entry_order);
    val at:     Location = Location{record: "output section"};
    var placed: usize    = 0;
    var j:      usize    = 0;
    for (j < table.count[Entry](?p.entries)) {
        val e:    *Entry   = table.at[Entry](?p.entries, table.nth[Entry](j));
        val g:    *Landing = table.at[Landing](?l.landings, Id[Landing]{index: e.landing});
        val m:    *Merged  = table.at[Merged](?l.merged, g.merged);
        val side: Isles    = table.items[Isles](?p.isles)[e.landing::usize];
        if (side.before != 0) {
            val b: err[Fail] = island_at_end(p, g.merged, side.before - 1);
            if (sel b.err) { ret err[Fail].err{fail.in_indexed(b.err, "island", (side.before - 1)::u64)}; }
            placed = placed + 1;
        }
        val start: res[u64, Fail] = checked.align_up(at, m.size, e.align);
        if (sel start.err) { ret err[Fail].err{fail.in_file(start.err, input.at(in.inputs, g.at.input).name)}; }
        val stop: res[u64, Fail] = checked.add(at, start.ok, g.size);
        if (sel stop.err) { ret err[Fail].err{stop.err}; }
        g.offset = start.ok;
        m.size   = stop.ok;
        if (m.align < e.align) { m.align = e.align; }
        j = j + 1;
        if (side.after == 0) { cnt; }
        val i: err[Fail] = island_at_end(p, g.merged, side.after - 1);
        if (sel i.err) { ret err[Fail].err{fail.in_indexed(i.err, "island", (side.after - 1)::u64)}; }
        placed = placed + 1;
    }
    if (placed != table.count[reserve.Island](?in.reserved.islands)) { ret err[Fail].err{fail.internal("an island lies beside an input section that takes no place of its own")}; }
    ret beside(p);
}

# the islands that lie beside one landing, each plus one, zero for none
# ---
# before: the island right before its input section
# after:  the island right after it
pub rec Isles {
    before: u32;
    after:  u32;
}

# per landing of `l`, the islands of `r` that lie beside it into `out`, each
# island's input section having landed and no two islands lying on one side
# of one section
pub fun sides(l: *Layout, r: *Reserved, out: *Table[Isles]) err[Fail] {
    table.clear[Isles](out);
    val g: res[Id[Isles], Fail] = table.grow[Isles](out, table.count[Landing](?l.landings));
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < table.count[reserve.Island](?r.islands)) {
        val isle: *reserve.Island  = table.at[reserve.Island](?r.islands, table.nth[reserve.Island](i));
        val id:   opt[Id[Landing]] = landing_of(l, isle.beside);
        if (sel id.none) { ret err[Fail].err{fail.in_indexed(fail.internal("an island lies beside an input section that did not land"), "island", i::u64)}; }
        val side: *Isles = ?table.items[Isles](out)[id.some.index::usize];
        var at:   *u32   = ?side.after;
        if (isle.before) { at = ?side.before; }
        if (@at != 0)    { ret err[Fail].err{fail.in_indexed(fail.internal("two islands lie on one side of one input section"), "island", i::u64)}; }
        @at = (i + 1)::u32;
        i   = i + 1;
    }
    ret err[Fail].ok{};
}

# per landing, the islands that lie beside it, with a row for each island's
# place
fun isled(p: *Pass) err[Fail] {
    val e: err[Fail] = sides(p.l, p.in.reserved, ?p.isles);
    if (sel e.err) { ret e; }
    val n: usize = table.count[reserve.Island](?p.in.reserved.islands);
    if (n == 0) { ret err[Fail].ok{}; }
    val h: res[Id[Placed], Fail] = table.grow[Placed](?p.l.islands, n);
    if (sel h.err) { ret err[Fail].err{h.err}; }
    ret err[Fail].ok{};
}

# lay the island `i` at the end of the output section `into` as it stands,
# right before or right after the input section it lies beside, in the region
# its table is spread among
fun island_at_end(p: *Pass, into: Id[Merged], i: u32) err[Fail] {
    val r: *Reserved = p.in.reserved;
    if (sel r.islanded.none) { ret err[Fail].err{fail.internal("an island is laid where no table is spread into islands")}; }
    val rv: *Reservation = table.at[Reservation](?r.tables, r.islanded.some);
    if (!sel rv.placement.islands) { ret err[Fail].err{fail.internal("the table spread into islands is placed otherwise")}; }
    val region: *reserve.Region = rv.placement.islands;
    val m:      *Merged         = table.at[Merged](?p.l.merged, into);
    if (!reserve.in_region(region, m.flags, m.kind)) { ret err[Fail].err{fail.about(fail.unsupported("a branch that needs a veneer lies outside the sections islands lie among"), region.name)}; }
    val isle:  *reserve.Island = table.at[reserve.Island](?r.islands, table.nth[reserve.Island](i::usize));
    val at:    Location        = Location{record: "island"};
    val start: res[u64, Fail]  = checked.align_up(at, m.size, isle.align);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    val stop: res[u64, Fail] = checked.add(at, start.ok, isle.size);
    if (sel stop.err) { ret err[Fail].err{stop.err}; }
    m.size = stop.ok;
    if (m.align < isle.align) { m.align = isle.align; }
    table.items[Placed](?p.l.islands)[i::usize] = Placed{merged: into, offset: start.ok};
    ret err[Fail].ok{};
}

# every member that is not its group's holder lands where the holder does
fun beside(p: *Pass) err[Fail] {
    val l: *Layout = p.l;
    var i: usize   = 0;
    for (i < table.count[pieces.Member](?p.in.pieces.members)) {
        val m:  Id[pieces.Member] = table.nth[pieces.Member](i);
        val at: Ref               = table.at[pieces.Member](?p.in.pieces.members, m).at;
        i = i + 1;
        val own:  opt[Id[Landing]] = landing_of(l, at);
        val hold: opt[Id[Landing]] = landing_of(l, pieces.group_of(p.in.pieces, m).holder);
        if (sel own.none)  { ret err[Fail].err{fail.internal("a merged section did not land")}; }
        if (sel hold.none) { ret err[Fail].err{fail.internal("the holder of a merged block did not land")}; }
        table.at[Landing](?l.landings, own.some).offset = table.at[Landing](?l.landings, hold.some).offset;
    }
    ret err[Fail].ok{};
}

# a range to cut from a landed section, before it is ordered among the
# section's others
# ---
# landing: the landing of the section
# drops:   a dropped atom left it, rather than an edit deleting it
# whole:   it removes the whole range
# index:   the dropped range or edit it comes from, for a refusal
rec Pending {
    landing: u32;
    start:   u64;
    end:     u64;
    drops:   bool;
    whole:   bool;
    index:   u64;
}

fun order_pending(a: *Pending, b: *Pending) i64 {
    if (a.landing != b.landing) { ret ordered(a.landing < b.landing); }
    if (a.start != b.start)     { ret ordered(a.start < b.start); }
    ret 0;
}

# cut every range a dropped atom left and every range an edit deletes from
# the section it lies in, each section's in ascending order. a dropped range
# moves every byte after it back by the whole multiples of the section's
# alignment it spans, or by the whole range in a section cut into records,
# which frame themselves and leave no padding a reader would take for a
# record, or where an edit restores the alignment after it. a deleted range
# moves them back by its whole length. no member of a merged group is cut,
# whose pieces the merge phase already left out
fun cuts(p: *Pass) err[Fail] {
    var pending: Table[Pending] = table.make[Pending](p.in.inputs.a);
    val e:       err[Fail]      = gather_cuts(p, ?pending);
    val c:       err[Fail]      = fail.kept(e, made_cuts(p, ?pending));
    ret fail.kept(c, table.release[Pending](?pending));
}

fun gather_cuts(p: *Pass, out: *Table[Pending]) err[Fail] {
    val in: *In   = p.in;
    var d:  usize = 0;
    for (d < table.count[Range](?in.live.dropped)) {
        val r:      *Range                 = table.at[Range](?in.live.dropped, table.nth[Range](d));
        val id:     opt[Id[Landing]]       = landing_of(p.l, r.at);
        val member: opt[Id[pieces.Member]] = pieces.member_of(in.pieces, r.at);
        d = d + 1;
        if (sel member.some) { cnt; }
        if (sel id.none)     { cnt; }
        val s:     *Section               = object.section_at(input.object_of(in.inputs, r.at.input), r.at.section);
        val whole: bool                   = adjust.restores(in.adjusted, r.at) || section.treats(s.disposition, section.CUT);
        val q:     res[Id[Pending], Fail] = table.push[Pending](out, Pending{landing: id.some.index, start: r.start, end: r.end, drops: true, whole: whole, index: (d - 1)::u64});
        if (sel q.err) { ret err[Fail].err{q.err}; }
    }
    var k: usize = 0;
    for (k < table.count[adjust.Edit](?in.adjusted.edits)) {
        val ed: *adjust.Edit = table.at[adjust.Edit](?in.adjusted.edits, table.nth[adjust.Edit](k));
        k = k + 1;
        if (!sel ed.change.delete) { cnt; }
        val f:      Fail                   = fail.in_indexed(fail.internal("an edit deletes bytes of a section that did not land as itself"), "edit", (k - 1)::u64);
        val id:     opt[Id[Landing]]       = landing_of(p.l, ed.at);
        val member: opt[Id[pieces.Member]] = pieces.member_of(in.pieces, ed.at);
        if (sel id.none)     { ret err[Fail].err{f}; }
        if (sel member.some) { ret err[Fail].err{f}; }
        val end: res[u64, Fail] = checked.add(Location{record: "edit"}, ed.offset, ed.change.delete);
        if (sel end.err) { ret err[Fail].err{end.err}; }
        val q: res[Id[Pending], Fail] = table.push[Pending](out, Pending{landing: id.some.index, start: ed.offset, end: end.ok, whole: true, index: (k - 1)::u64});
        if (sel q.err) { ret err[Fail].err{q.err}; }
    }
    ret err[Fail].ok{};
}

fun made_cuts(p: *Pass, pending: *Table[Pending]) err[Fail] {
    val l: *Layout = p.l;
    val n: usize   = table.count[Pending](pending);
    sort.sort_by[Pending](table.items[Pending](pending), n, order_pending);
    var i: usize = 0;
    for (i < n) {
        val q:    *Pending = table.at[Pending](pending, table.nth[Pending](i));
        val g:    *Landing = table.at[Landing](?l.landings, Id[Landing]{index: q.landing});
        var name: str      = "edit";
        if (q.drops) { name = "dropped range"; }
        i = i + 1;
        if (q.end < q.start || q.end > g.source) { ret err[Fail].err{fail.in_indexed(fail.internal("a cut range lies outside its section"), name, q.index)}; }
        var before: u64 = 0;
        if (g.cut_count != 0) {
            val last: *Cut = table.at[Cut](?l.cuts, table.nth[Cut]((g.cut_first + g.cut_count - 1)::usize));
            if (q.start < last.end) { ret err[Fail].err{fail.in_indexed(fail.internal("the cut ranges of a section overlap"), name, q.index)}; }
            before = last.before + last.removed;
        }
        var removed: u64 = q.end - q.start;
        if (!q.whole) {
            val align: u64 = object.section_at(input.object_of(p.in.inputs, g.at.input), g.at.section).align;
            if (align == 0 || (align & (align - 1)) != 0) { ret err[Fail].err{fail.in_indexed(fail.malformed("alignment is not a power of two"), name, q.index)}; }
            removed = removed & ~(align - 1);
        }
        if (g.cut_count == 0) { g.cut_first = table.count[Cut](?l.cuts)::u32; }
        val c: res[Id[Cut], Fail] = table.push[Cut](?l.cuts, Cut{start: q.start, end: q.end, removed: removed, drops: q.drops, before: before});
        if (sel c.err) { ret err[Fail].err{c.err}; }
        g.cut_count = g.cut_count + 1;
        g.size      = g.size - removed;
    }
    ret err[Fail].ok{};
}

fun entry_order(a: *Entry, b: *Entry) i64 {
    if (a.merged != b.merged) { ret ordered(a.merged < b.merged); }
    var i: usize = 0;
    for (i < a.key_len && i < b.key_len) {
        if (a.key[i] != b.key[i]) { ret ordered(a.key[i] < b.key[i]); }
        i = i + 1;
    }
    if (a.key_len != b.key_len) { ret ordered(a.key_len < b.key_len); }
    if (a.after != b.after)     { ret ordered(!a.after); }
    if (a.landing != b.landing) { ret ordered(a.landing < b.landing); }
    ret 0;
}

fun ordered(less: bool) i64 {
    if (less) { ret -1; }
    ret 1;
}

# refuse the placement of the sections `first` and `second` names, holding
# both in the conflicts
fun conflict(l: *Layout, first: Id[Name], second: Id[Name], why: str) Fail {
    val f: Fail                    = fail.in_record(fail.malformed(why), "placement constraint");
    val c: res[Id[Conflict], Fail] = table.push[Conflict](?l.conflicts, Conflict{first: first, second: second, why: why});
    if (sel c.err) { ret c.err; }
    ret f;
}

fun stated_address(p: *Pass, j: usize) opt[u64] {
    ret table.at[Info](?p.infos, table.nth[Info](j)).address;
}

fun stated_region(p: *Pass, j: usize) opt[Id[Region]] {
    val k: u32 = table.at[Info](?p.infos, table.nth[Info](j)).constraint;
    if (k == NONE) { ret opt[Id[Region]].none{}; }
    ret table.at[Constraint](?p.in.constraints.sections, table.nth[Constraint](k::usize)).region;
}

fun stated_load(p: *Pass, j: usize) opt[Id[Region]] {
    val k: u32 = table.at[Info](?p.infos, table.nth[Info](j)).constraint;
    if (k == NONE) { ret opt[Id[Region]].none{}; }
    ret table.at[Constraint](?p.in.constraints.sections, table.nth[Constraint](k::usize)).load;
}

# bind every constraint to the output sections it names and check it: one
# constraint a section, a power of two alignment, regions whose access admits
# the section, an address or an offset but not both, an address the
# section's alignment allows and within its region, and no two stated
# addresses overlapping
fun constrain(p: *Pass) err[Fail] {
    val l:  *Layout             = p.l;
    val cs: *Constraints        = p.in.constraints;
    val n:  usize               = table.count[Merged](?l.merged);
    val g:  res[Id[Info], Fail] = table.grow[Info](?p.infos, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var j: usize = 0;
    for (j < n) {
        val info: *Info = table.at[Info](?p.infos, table.nth[Info](j));
        info.constraint = NONE;
        info.address    = opt[u64].none{};
        j               = j + 1;
    }
    val at: Location = Location{record: "placement constraint"};
    var k:  usize    = 0;
    for (k < table.count[Constraint](?cs.sections)) {
        val c: *Constraint = table.at[Constraint](?cs.sections, table.nth[Constraint](k));
        if (sel c.region.some && c.region.some.index::usize >= table.count[Region](?cs.regions)) {
            ret err[Fail].err{fail.in_indexed(fail.internal("a placement constraint names no region"), "placement constraint", k::u64)};
        }
        if (sel c.load.some && c.load.some.index::usize >= table.count[Region](?cs.regions)) {
            ret err[Fail].err{fail.in_indexed(fail.internal("a placement constraint names no region"), "placement constraint", k::u64)};
        }
        if (sel c.address.some && sel c.offset.some) {
            ret err[Fail].err{fail.about(fail.in_indexed(fail.malformed("a section is stated at both an address and an offset"), "placement constraint", k::u64), c.spelling)};
        }
        if (sel c.align.some && (c.align.some == 0 || (c.align.some & (c.align.some - 1)) != 0)) {
            ret err[Fail].err{fail.in_indexed(fail.malformed("alignment is not a power of two"), "placement constraint", k::u64)};
        }
        var found: bool = false;
        j = 0;
        for (j < n) {
            val m: *Merged = table.at[Merged](?l.merged, table.nth[Merged](j));
            if (m.name.index == c.section.index) {
                val info: *Info = table.at[Info](?p.infos, table.nth[Info](j));
                if (info.constraint != NONE) { ret err[Fail].err{conflict(l, c.section, c.section, "two placement constraints name one section")}; }
                info.constraint = k::u32;
                found           = true;
                if (sel c.align.some) {
                    if (m.align < c.align.some) { m.align = c.align.some; }
                }
                val ad: err[Fail] = admitted(l, cs, c, m);
                if (sel ad.err) { ret ad; }
                val sa: res[opt[u64], Fail] = stated_at(p, c);
                if (sel sa.err) { ret err[Fail].err{fail.about(fail.in_indexed(sa.err, "placement constraint", k::u64), c.spelling)}; }
                info.address = sa.ok;
                if (sel sa.ok.some) {
                    val e: err[Fail] = stated_fits(l, cs, c, m, sa.ok.some, k);
                    if (sel e.err) { ret e; }
                }
            }
            j = j + 1;
        }
        if (!found) { ret err[Fail].err{fail.about(fail.in_indexed(fail.malformed("a placement constraint names no output section"), "placement constraint", k::u64), c.spelling)}; }
        k = k + 1;
    }

    var a: usize = 0;
    for (a < n) {
        val sa: opt[u64] = stated_address(p, a);
        if (sel sa.some) {
            val ma:  *Merged        = table.at[Merged](?l.merged, table.nth[Merged](a));
            val end: res[u64, Fail] = checked.add(at, sa.some, ma.size);
            if (sel end.err) { ret err[Fail].err{end.err}; }
            var b: usize = a + 1;
            for (b < n) {
                val sb: opt[u64] = stated_address(p, b);
                if (sel sb.some) {
                    val mb:   *Merged        = table.at[Merged](?l.merged, table.nth[Merged](b));
                    val endb: res[u64, Fail] = checked.add(at, sb.some, mb.size);
                    if (sel endb.err) { ret err[Fail].err{endb.err}; }
                    if (sa.some < endb.ok && sb.some < end.ok && ma.size != 0 && mb.size != 0) {
                        ret err[Fail].err{conflict(l, ma.name, mb.name, "two sections are stated at overlapping addresses")};
                    }
                }
                b = b + 1;
            }
        }
        a = a + 1;
    }
    ret err[Fail].ok{};
}

# the address `c` states its section at: the address it states, or its
# offset from the start of its region, from the image base where it lies in
# none, absent where it states neither
fun stated_at(p: *Pass, c: *Constraint) res[opt[u64], Fail] {
    if (sel c.offset.none) { ret res[opt[u64], Fail].ok{c.address}; }
    var origin: u64 = p.in.base;
    if (sel c.region.some) { origin = table.at[Region](?p.in.constraints.regions, c.region.some).start; }
    val a: res[u64, Fail] = checked.add(Location{record: "placement constraint"}, origin, c.offset.some);
    if (sel a.err) { ret res[opt[u64], Fail].err{a.err}; }
    ret res[opt[u64], Fail].ok{opt[u64].some{a.ok}};
}

# the access a section of `flags` needs of the region it runs in: writable
# for one it writes, executable for one it runs, and readable for one that is
# neither
fun needs(flags: section.Flags) u8 {
    var n: u8 = 0;
    if ((flags & section.WRITE) != 0) { n = n | WRITABLE; }
    if ((flags & section.EXEC) != 0)  { n = n | EXECUTABLE; }
    if (n == 0)                       { n = READABLE; }
    ret n;
}

# the regions `c` places the section `m` in admit it: a region holds only a
# section a segment loads, the region it runs in allows the access its flags
# need, and the region its bytes load in is readable
fun admitted(l: *Layout, cs: *Constraints, c: *Constraint, m: *Merged) err[Fail] {
    if (sel c.region.some) {
        val r: *Region = table.at[Region](?cs.regions, c.region.some);
        if ((m.flags & section.ALLOC) == 0)                { ret err[Fail].err{conflict(l, m.name, r.name, "a section no segment loads is placed in a region")}; }
        if ((r.access & needs(m.flags)) != needs(m.flags)) { ret err[Fail].err{conflict(l, m.name, r.name, "the region's access does not admit the section's flags")}; }
    }
    if (sel c.load.some) {
        val r: *Region = table.at[Region](?cs.regions, c.load.some);
        if ((m.flags & section.ALLOC) == 0) { ret err[Fail].err{conflict(l, m.name, r.name, "a section no segment loads is loaded in a region")}; }
        if ((r.access & READABLE) == 0)     { ret err[Fail].err{conflict(l, m.name, r.name, "a region a section loads in must be readable")}; }
    }
    ret err[Fail].ok{};
}

# a stated address `a` the section's alignment allows, within its region
fun stated_fits(l: *Layout, cs: *Constraints, c: *Constraint, m: *Merged, a: u64, k: usize) err[Fail] {
    if ((a & (m.align - 1)) != 0) {
        ret err[Fail].err{fail.in_indexed(fail.malformed("a stated address breaks its section's alignment"), "placement constraint", k::u64)};
    }
    if (sel c.region.none) { ret err[Fail].ok{}; }
    val r: *Region = table.at[Region](?cs.regions, c.region.some);
    if (a < r.start)           { ret err[Fail].err{conflict(l, c.section, r.name, "a stated address lies below the start of its region")}; }
    if (a - r.start >= r.size) { ret err[Fail].err{conflict(l, c.section, r.name, "a stated address lies past the end of its region")}; }
    ret err[Fail].ok{};
}

# the axes of a class, in the order class_axis reads them
val CLASS_AXES: usize = 2;

fun class_axis(c: *Class, at: usize) *Axis {
    if (at == 0) { ret ?c.flags; }
    ret ?c.roles;
}

# refuse classes two of which can take one section, a defect of mink, and
# index the classes in `a` as they are checked
pub fun check(r: *Rules, a: *A.Allocator) res[rule.Index, Fail] {
    ret rule.index[Class](a, r.name, r.classes, r.class_count, CLASS_AXES, class_axis, class_name);
}

fun class_name(c: *Class) str {
    ret c.name;
}

# every output section takes the one class of the format that matches it, and
# a reserved table placed in a segment of its own takes that segment
fun classify(p: *Pass) err[Fail] {
    val l: *Layout = p.l;
    val r: *Rules  = p.in.rules;
    var j: usize   = 0;
    for (j < table.count[Merged](?l.merged)) {
        val m:    *Merged         = table.at[Merged](?l.merged, table.nth[Merged](j));
        val info: *Info           = table.at[Info](?p.infos, table.nth[Info](j));
        var caps: [CLASS_AXES]u64 = [CLASS_AXES]u64{m.flags, m.kind.roles};
        val c:    opt[usize]      = rule.find[Class](p.classes, r.classes, CLASS_AXES, class_axis, ?caps[0]);
        if (sel c.none) {
            ret err[Fail].err{fail.in_indexed(fail.unsupported("no class of the format takes a section of these flags"), "output section", j::u64)};
        }
        val k: *Class = ?r.classes[c.some];
        info.class = c.some::u32;
        info.image = 0;
        if (sel k.load.none) { info.image = 2; }
        j = j + 1;
    }
    var t: usize = 0;
    for (t < table.count[Spot](?l.tables)) {
        val sp: Spot         = table.items[Spot](?l.tables)[t];
        val rv: *Reservation = table.at[Reservation](?p.in.reserved.tables, table.nth[Reservation](t));
        if (sel sp.section) {
            if (sel rv.placement.own_segment) { table.at[Info](?p.infos, table.nth[Info](sp.section.merged.index::usize)).image = 1; }
        }
        t = t + 1;
    }
    ret err[Fail].ok{};
}

# image order: loaded sections, then tables in segments of their own, then
# what no segment loads, each the sections of a stated rank first in rank
# order, then the rest by class and the order they were made in
fun arrange(p: *Pass) err[Fail] {
    val l: *Layout = p.l;
    val n: usize   = table.count[Merged](?l.merged);
    var j: usize   = 0;
    for (j < n) {
        val info: *Info = table.at[Info](?p.infos, table.nth[Info](j));
        var rank: Rank  = Rank{image: info.image, rank: p.in.rules.classes[info.class].rank, stated: 1, index: j::u32};
        if (info.constraint != NONE) {
            val c: *Constraint = table.at[Constraint](?p.in.constraints.sections, table.nth[Constraint](info.constraint::usize));
            if (sel c.order.some) {
                rank.stated = 0;
                rank.order  = c.order.some;
            }
        }
        val pushed: res[Id[Rank], Fail] = table.push[Rank](?p.ranks, rank);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        j = j + 1;
    }
    sort.sort_by[Rank](table.items[Rank](?p.ranks), n, rank_order);
    j = 0;
    for (j < n) {
        val at:     Id[Merged]                = Id[Merged]{index: table.items[Rank](?p.ranks)[j].index};
        val pushed: res[Id[Id[Merged]], Fail] = table.push[Id[Merged]](?l.order, at);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        table.at[Merged](?l.merged, at).position = j::u32;
        j                                        = j + 1;
    }
    ret err[Fail].ok{};
}

fun rank_order(a: *Rank, b: *Rank) i64 {
    if (a.image != b.image)   { ret ordered(a.image < b.image); }
    if (a.stated != b.stated) { ret ordered(a.stated < b.stated); }
    if (a.order != b.order)   { ret ordered(a.order < b.order); }
    if (a.rank != b.rank)     { ret ordered(a.rank < b.rank); }
    if (a.index != b.index)   { ret ordered(a.index < b.index); }
    ret 0;
}

# the page granule loaded segments respect: the system's, else the
# architecture's, one where neither has pages
fun page_of(in: *In) u64 {
    if (in.host.page != 0)             { ret in.host.page; }
    if (sel in.target.arch.pages.some) { ret in.target.arch.pages.some.size; }
    ret 1;
}

# whether the loaded section `j` begins a segment after the section `prev`:
# it loads in another segment of the format, takes a segment of its own, runs
# or loads in another region or starts at a stated address
fun breaks(p: *Pass, prev: usize, j: usize) bool {
    val a: *Info = table.at[Info](?p.infos, table.nth[Info](prev));
    val b: *Info = table.at[Info](?p.infos, table.nth[Info](j));
    if (b.image == 1 || a.image != b.image)               { ret true; }
    if (load_of(p.in.rules, a) != load_of(p.in.rules, b)) { ret true; }
    val stated: opt[u64] = stated_address(p, j);
    if (sel stated.some)                                                       { ret true; }
    if (region_index(stated_load(p, prev)) != region_index(stated_load(p, j))) { ret true; }
    ret region_index(stated_region(p, prev)) != region_index(stated_region(p, j));
}

# the format's segment the sections of `info` load in, nil for none
fun load_of(r: *Rules, info: *Info) *Load {
    val l: opt[*Load] = r.classes[info.class].load;
    if (sel l.none) { ret nil; }
    ret l.some;
}

# a region's index plus one, zero for no region
fun region_index(r: opt[Id[Region]]) u64 {
    if (sel r.none) { ret 0; }
    ret r.some.index::u64 + 1;
}

fun bits(m: *Merged) bool {
    ret section.has(m.kind, section.BITS);
}

# give every output section its address, its load address and file offset,
# segment by segment. a loader that maps the image maps the headers with the
# first segment, and where the format asks it every loaded section's offset
# and address agree modulo the page, a paged format's segments each opening
# on a page. a segment whose sections load in a region loads at that
# region's cursor, and every other loads where it runs. a region's one
# cursor serves the sections that run in it and the bytes that load in it
fun address(p: *Pass) err[Fail] {
    val in:        *In      = p.in;
    val l:         *Layout  = p.l;
    val r:         *Rules   = in.rules;
    val at:        Location = Location{record: "output section"};
    val page:      u64      = page_of(in);
    val mapped:    bool     = in.host.system.mapped && page > 1;
    val paged:     bool     = mapped && sel r.opens.paged;
    val congruent: bool     = mapped && !(sel r.opens.none);
    val n:         usize    = table.count[Id[Merged]](?l.order);

    var prev: usize              = NONE::usize;
    var i:    usize              = 0;
    val rg:   res[Id[u64], Fail] = table.grow[u64](?p.cursors, table.count[Region](?in.constraints.regions));
    if (sel rg.err) { ret err[Fail].err{rg.err}; }
    var q: usize = 0;
    for (q < table.count[Region](?in.constraints.regions)) {
        table.items[u64](?p.cursors)[q] = table.at[Region](?in.constraints.regions, table.nth[Region](q)).start;
        q                               = q + 1;
    }

    val block:  ThreadStart = thread_start(l);
    var off:    u64         = l.header;
    var cursor: u64         = in.base;
    var held:   bool        = in.host.system.mapped;
    var seg:    Id[Segment];
    l.base = in.base;
    for (i < n) {
        val j:    usize   = table.items[Id[Merged]](?l.order)[i].index::usize;
        val m:    *Merged = table.at[Merged](?l.merged, table.nth[Merged](j));
        val info: *Info   = table.at[Info](?p.infos, table.nth[Info](j));
        if (info.image == 2) {
            i = i + 1;
            cnt;
        }
        var align: u64 = m.align;
        if (align < r.section_align)                 { align = r.section_align; }
        if (j == block.first && align < block.align) { align = block.align; }
        val stated: opt[u64]        = stated_address(p, j);
        val region: opt[Id[Region]] = stated_region(p, j);
        val loads:  opt[Id[Region]] = stated_load(p, j);
        var base:   u64             = cursor;
        if (sel region.some) { base = table.items[u64](?p.cursors)[region.some.index]; }
        var a: u64 = 0;
        var o: u64 = 0;
        if (prev == NONE::usize || breaks(p, prev, j)) {
            var start: u64 = 0;
            var first: u64 = 0;
            var agree: u64 = 1;
            if (held && prev == NONE::usize && sel stated.none && sel region.none && sel loads.none) {
                val after: res[u64, Fail] = checked.add(at, base, l.header);
                if (sel after.err) { ret err[Fail].err{after.err}; }
                val sa: res[u64, Fail] = checked.align_up(at, after.ok, align);
                if (sel sa.err) { ret err[Fail].err{sa.err}; }
                a     = sa.ok;
                start = base;
                if (congruent) {
                    o     = a - base;
                    agree = page;
                }
                or {
                    val so: res[u64, Fail] = checked.align_up(at, off, r.file_align);
                    if (sel so.err) { ret err[Fail].err{so.err}; }
                    o = so.ok;
                }
                first = 0;
            }
            or {
                if (congruent) {
                    var big: u64 = page;
                    if (align > big) { big = align; }
                    var opening: u64 = align;
                    if (paged) { opening = big; }
                    val so: res[u64, Fail] = checked.align_up(at, off, opening);
                    if (sel so.err) { ret err[Fail].err{so.err}; }
                    o = so.ok;
                    if (sel stated.some) {
                        if (paged && stated.some % page != 0) {
                            ret err[Fail].err{fail.valued(fail.in_indexed(fail.unsupported("a segment of a paged format starts at a stated address off its page"), "output section", j::u64), stated.some::i128)};
                        }
                    }
                    if (sel stated.some) {
                        a     = stated.some;
                        o     = off + ((a % page) + page - (off % page)) % page;
                        agree = page;
                    }
                    or {
                        agree = big;
                        val sa: res[u64, Fail] = checked.align_up(at, base, big);
                        if (sel sa.err) { ret err[Fail].err{sa.err}; }
                        val sb: res[u64, Fail] = checked.add(at, sa.ok, o % big);
                        if (sel sb.err) { ret err[Fail].err{sb.err}; }
                        a = sb.ok;
                    }
                }
                or {
                    if (sel stated.some) {
                        a = stated.some;
                    }
                    or {
                        val sa: res[u64, Fail] = checked.align_up(at, base, align);
                        if (sel sa.err) { ret err[Fail].err{sa.err}; }
                        a = sa.ok;
                    }
                    val so: res[u64, Fail] = checked.align_up(at, off, r.file_align);
                    if (sel so.err) { ret err[Fail].err{so.err}; }
                    o = so.ok;
                }
                start = a;
                first = o;
            }
            var flags: section.Flags = m.flags;
            var load:  opt[*Load]    = opt[*Load].none{};
            if (info.image == 0) {
                load  = r.classes[info.class].load;
                flags = load_of(r, info).flags;
            }
            var lma: u64 = start;
            if (sel loads.some) {
                val la: res[u64, Fail] = checked.align_up(at, table.items[u64](?p.cursors)[loads.some.index], align);
                if (sel la.err) { ret err[Fail].err{fail.in_indexed(la.err, "output section", j::u64)}; }
                lma = la.ok;
            }
            val s: res[Id[Segment], Fail] = table.push[Segment](?l.segments, Segment{load: load, flags: flags, address: start, loads: lma, offset: first, align: agree});
            if (sel s.err) { ret err[Fail].err{s.err}; }
            seg = s.ok;
        }
        or {
            val sa: res[u64, Fail] = checked.align_up(at, base, align);
            if (sel sa.err) { ret err[Fail].err{sa.err}; }
            a = sa.ok;
            if (congruent) {
                val g: *Segment = table.at[Segment](?l.segments, seg);
                o = g.offset + (a - g.address);
            }
            or {
                val so: res[u64, Fail] = checked.align_up(at, off, r.file_align);
                if (sel so.err) { ret err[Fail].err{so.err}; }
                o = so.ok;
            }
        }
        val end: res[u64, Fail] = checked.add(at, a, m.size);
        if (sel end.err) { ret err[Fail].err{fail.in_indexed(end.err, "output section", j::u64)}; }
        if (sel region.some) {
            val rr: *Region = table.at[Region](?in.constraints.regions, region.some);
            if (a < rr.start)                { ret err[Fail].err{conflict(l, m.name, rr.name, "the section starts below its region")}; }
            if (end.ok - rr.start > rr.size) { ret err[Fail].err{fail.valued(conflict(l, m.name, rr.name, "the section runs past the end of its region by the value in bytes"), (end.ok - rr.start - rr.size)::i128)}; }
            table.items[u64](?p.cursors)[region.some.index] = end.ok;
        }
        or {
            cursor = end.ok;
        }
        val g:  *Segment       = table.at[Segment](?l.segments, seg);
        val la: res[u64, Fail] = checked.add(at, g.loads, a - g.address);
        if (sel la.err) { ret err[Fail].err{fail.in_indexed(la.err, "output section", j::u64)}; }
        if (sel loads.some) {
            var copied: u64 = 0;
            if (bits(m)) { copied = m.size; }
            val le: res[u64, Fail] = checked.add(at, la.ok, copied);
            if (sel le.err) { ret err[Fail].err{fail.in_indexed(le.err, "output section", j::u64)}; }
            val lr: *Region = table.at[Region](?in.constraints.regions, loads.some);
            if (la.ok < lr.start)                                       { ret err[Fail].err{conflict(l, m.name, lr.name, "the section loads below its load region")}; }
            if (le.ok - lr.start > lr.size)                             { ret err[Fail].err{fail.valued(conflict(l, m.name, lr.name, "the section's bytes run past the end of its load region by the value in bytes"), (le.ok - lr.start - lr.size)::i128)}; }
            if (le.ok > table.items[u64](?p.cursors)[loads.some.index]) { table.items[u64](?p.cursors)[loads.some.index] = le.ok; }
        }
        m.address     = a;
        m.loads       = la.ok;
        m.offset      = o;
        m.segment     = opt[Id[Segment]].some{seg};
        g.memory_size = end.ok - g.address;
        if (bits(m)) {
            val fe: res[u64, Fail] = checked.add(at, o, m.size);
            if (sel fe.err) { ret err[Fail].err{fe.err}; }
            g.file_size = fe.ok - g.offset;
            off         = fe.ok;
        }
        prev = j;
        i    = i + 1;
    }

    ret tail_out(p, off);
}

# place the tail, the sections no segment loads, which image order keeps
# last, from the offset `off` after the loaded bytes
fun tail_out(p: *Pass, off: u64) err[Fail] {
    val l:     *Layout      = p.l;
    val a:     *A.Allocator = p.in.inputs.a;
    val n:     usize        = table.count[Id[Merged]](?l.order);
    var first: usize        = n;
    for (first > 0 && table.at[Info](?p.infos, table.nth[Info](table.items[Id[Merged]](?l.order)[first - 1].index::usize)).image == 2) {
        first = first - 1;
    }
    l.tail = Tail{first: first::u32, start: off, align: p.in.rules.file_align};
    var sizes:   Table[Tailed] = table.make[Tailed](a);
    var offsets: Table[u64]    = table.make[u64](a);
    val r:       err[Fail]     = tail_placed(l, first, ?sizes, ?offsets);
    val rs:      err[Fail]     = table.release[Tailed](?sizes);
    val ro:      err[Fail]     = table.release[u64](?offsets);
    ret fail.kept(fail.kept(r, rs), ro);
}

# the tail from `first` placed at its sections' sizes, in `sizes` and
# `offsets`
fun tail_placed(l: *Layout, first: usize, sizes: *Table[Tailed], offsets: *Table[u64]) err[Fail] {
    val s: err[Fail] = tail_sizes(l, first, sizes);
    if (sel s.err) { ret s; }
    val end: res[u64, Fail] = place_tail(l, sizes, offsets);
    if (sel end.err) { ret err[Fail].err{end.err}; }
    l.end = end.ok;
    var k: usize = first;
    for (k < table.count[Id[Merged]](?l.order)) {
        val m: *Merged = table.at[Merged](?l.merged, table.items[Id[Merged]](?l.order)[k]);
        m.offset = table.items[u64](offsets)[k - first];
        k        = k + 1;
    }
    ret err[Fail].ok{};
}

# the size in the file and the alignment of each tail section from `first`
fun tail_sizes(l: *Layout, first: usize, out: *Table[Tailed]) err[Fail] {
    var k: usize = first;
    for (k < table.count[Id[Merged]](?l.order)) {
        val m:    *Merged = table.at[Merged](?l.merged, table.items[Id[Merged]](?l.order)[k]);
        var size: u64     = 0;
        if (bits(m)) { size = m.size; }
        val p: res[Id[Tailed], Fail] = table.push[Tailed](out, Tailed{size: size, align: m.align});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# no two loaded sections share an address where they run, nor share a byte
# where their bytes load, whatever put them there
fun overlaps(p: *Pass) err[Fail] {
    val run: err[Fail] = overlapping(p, false, "two sections overlap in memory");
    if (sel run.err) { ret run; }
    ret overlapping(p, true, "the bytes of two sections overlap where they load");
}

# refuse two loaded sections that overlap where they run, or where their
# bytes load when `loads` says so
fun overlapping(p: *Pass, loads: bool, why: str) err[Fail] {
    val l: *Layout = p.l;
    var j: usize   = 0;
    table.clear[Extent](?p.spans);
    for (j < table.count[Merged](?l.merged)) {
        val m: *Merged = table.at[Merged](?l.merged, table.nth[Merged](j));
        j = j + 1;
        if (sel m.segment.none || m.size == 0) { cnt; }
        var e: Extent = Extent{address: m.address, size: m.size, index: (j - 1)::u32};
        if (loads) {
            if (!bits(m)) { cnt; }
            e.address = m.loads;
        }
        val pushed: res[Id[Extent], Fail] = table.push[Extent](?p.spans, e);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    }
    val n: usize = table.count[Extent](?p.spans);
    sort.sort_by[Extent](table.items[Extent](?p.spans), n, span_order);
    var i: usize = 1;
    for (i < n) {
        val a: *Extent = ?table.items[Extent](?p.spans)[i - 1];
        val b: *Extent = ?table.items[Extent](?p.spans)[i];
        if (b.address - a.address < a.size) {
            val ma: *Merged = table.at[Merged](?l.merged, table.nth[Merged](a.index::usize));
            val mb: *Merged = table.at[Merged](?l.merged, table.nth[Merged](b.index::usize));
            ret err[Fail].err{conflict(l, ma.name, mb.name, why)};
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the loaded bytes stay within the image's stated size from its base, the
# section whose bytes load furthest past it refused by how far
fun ceiling(p: *Pass) err[Fail] {
    val size: opt[u64] = p.in.constraints.size;
    if (sel size.none) { ret err[Fail].ok{}; }
    val l:     *Layout        = p.l;
    val at:    Location       = Location{record: "output section"};
    val limit: res[u64, Fail] = checked.add(at, p.in.base, size.some);
    if (sel limit.err) { ret err[Fail].err{limit.err}; }
    var top:  u64        = limit.ok;
    var over: opt[usize] = opt[usize].none{};
    var j:    usize      = 0;
    for (j < table.count[Merged](?l.merged)) {
        val m: *Merged = table.at[Merged](?l.merged, table.nth[Merged](j));
        j = j + 1;
        if (sel m.segment.none || m.size == 0 || !bits(m)) { cnt; }
        val end: res[u64, Fail] = checked.add(at, m.loads, m.size);
        if (sel end.err) { ret err[Fail].err{end.err}; }
        if (end.ok > top) {
            top  = end.ok;
            over = opt[usize].some{j - 1};
        }
    }
    if (sel over.none) { ret err[Fail].ok{}; }
    val m: *Merged = table.at[Merged](?l.merged, table.nth[Merged](over.some));
    ret err[Fail].err{fail.valued(conflict(l, m.name, m.name, "the image runs past its stated size by the value in bytes"), (top - limit.ok)::i128)};
}

fun span_order(a: *Extent, b: *Extent) i64 {
    if (a.address != b.address) { ret ordered(a.address < b.address); }
    if (a.index != b.index)     { ret ordered(a.index < b.index); }
    ret 0;
}

# the final value of every symbol: a placed one's address, an absolute one's
# value, a common one's storage, and a name bound to another symbol that
# symbol's
fun values(p: *Pass) err[Fail] {
    val in: *In     = p.in;
    val l:  *Layout = p.l;
    var i:  usize   = 0;
    for (i < input.count(in.inputs)) {
        val s: res[Id[u32], Fail] = table.push[u32](?l.starts, table.count[opt[u64]](?l.values)::u32);
        if (sel s.err) { ret err[Fail].err{s.err}; }
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(in.inputs, id);
        if (o != nil && table.count[Symbol](?o.symbols) != 0) {
            val g: res[Id[opt[u64]], Fail] = table.grow[opt[u64]](?l.values, table.count[Symbol](?o.symbols));
            if (sel g.err) { ret err[Fail].err{g.err}; }
            var k: usize = 0;
            for (k < table.count[Symbol](?o.symbols)) {
                val sym: *Symbol   = table.at[Symbol](?o.symbols, table.nth[Symbol](k));
                val at:  *opt[u64] = ?table.items[opt[u64]](?l.values)[g.ok.index::usize + k];
                if (sel sym.def.absolute) {
                    @at = opt[u64].some{sym.def.absolute};
                }
                or (sel sym.def.placed) {
                    val pos: res[opt[Position], Fail] = locate(l, in.pieces, Ref{input: id, section: sym.def.placed.section}, sym.def.placed.offset);
                    if (sel pos.err)     { ret err[Fail].err{fail.in_indexed(fail.in_file(pos.err, input.at(in.inputs, id).name), "symbol", k::u64)}; }
                    if (sel pos.ok.some) { @at = opt[u64].some{pos.ok.some.address}; }
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }

    val bd: err[Fail] = bounds(p);
    if (sel bd.err) { ret bd; }

    i = 0;
    for (i < input.count(in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(in.inputs, id);
        var k:  usize     = 0;
        for (o != nil && k < table.count[Symbol](?o.symbols)) {
            val sid: Id[Symbol]    = table.nth[Symbol](k);
            val ln:  opt[Id[Name]] = resolve.link_name(in.resolved, id, sid);
            if (sel ln.some) {
                val own: opt[*resolve.Linked] = resolve.linked_of(in.resolved, ln.some);
                if (sel own.some) {
                    val at: u32 = table.items[u32](?in.resolved.linking)[ln.some.index];
                    @value_at(l, id, sid) = opt[u64].some{table.at[Bounded](?l.bounds, table.nth[Bounded](at::usize - 1)).value};
                }
            }
            val w: opt[resolve.Won] = resolve.winning(in.resolved, id, sid);
            if (sel w.some) {
                val b: *Binding = w.some.binding;
                if (b.input.index != id.index || b.symbol.index != sid.index) {
                    val from: *opt[u64] = value_at(l, b.input, b.symbol);
                    if (from == nil) { ret err[Fail].err{fail.internal("a binding names no symbol")}; }
                    @value_at(l, id, sid) = @from;
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the value of each name the link defines itself, at the place its row of the
# format's bound symbols states, rounded up to the row's alignment
fun bounds(p: *Pass) err[Fail] {
    val in: *In             = p.in;
    val sp: res[Span, Fail] = loaded(p);
    if (sel sp.err) { ret err[Fail].err{sp.err}; }
    p.l.loaded = sp.ok;
    var i: usize = 0;
    for (i < table.count[resolve.Linked](?in.resolved.linked)) {
        val ln: *resolve.Linked    = table.at[resolve.Linked](?in.resolved.linked, table.nth[resolve.Linked](i));
        val v:  res[Bounded, Fail] = bound_value(p, ln);
        if (sel v.err) { ret err[Fail].err{fail.in_record(v.err, ln.bound.name)}; }
        var b: Bounded = v.ok;
        if (ln.bound.align > 1) {
            val up: res[u64, Fail] = checked.align_up(Location{record: "bound symbol"}, b.value, ln.bound.align);
            if (sel up.err) { ret err[Fail].err{up.err}; }
            b.value = up.ok;
        }
        val pushed: res[Id[Bounded], Fail] = table.push[Bounded](?p.l.bounds, b);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the loaded data as a whole: from the lowest address a segment loads to the
# end of the highest, empty at the image base when no segment loads any
fun loaded(p: *Pass) res[Span, Fail] {
    val l:   *Layout = p.l;
    var lo:  u64     = p.in.base;
    var hi:  u64     = p.in.base;
    var any: bool    = false;
    var j:   usize   = 0;
    for (j < table.count[Merged](?l.merged)) {
        val m: *Merged = table.at[Merged](?l.merged, table.nth[Merged](j));
        j = j + 1;
        if (sel m.segment.none) { cnt; }
        val end: res[u64, Fail] = checked.add(Location{record: "output section"}, m.address, m.size);
        if (sel end.err)            { ret res[Span, Fail].err{end.err}; }
        if (!any || m.address < lo) { lo = m.address; }
        if (!any || end.ok > hi)    { hi = end.ok; }
        any = true;
    }
    ret res[Span, Fail].ok{Span{address: lo, size: hi - lo}};
}

# the address of the place of the link's own definition `ln`, the place
# resolve settled it at
fun bound_value(p: *Pass, ln: *resolve.Linked) res[Bounded, Fail] {
    val l:     *Layout        = p.l;
    val place: boundary.Place = ln.bound.place;
    if (sel place.loaded_start) { ret res[Bounded, Fail].ok{Bounded{value: l.loaded.address}}; }
    if (sel place.loaded_end)   { ret res[Bounded, Fail].ok{Bounded{value: l.loaded.address + l.loaded.size}}; }
    if (sel place.cell)         { ret cell_value(l, p.in.reserved, place.cell); }
    if (sel place.got_base)     { ret got_base(l, p.in.reserved); }
    if (sel place.block_start)  { ret block_start(l); }
    if (sel place.image_start)  { ret image_start(l); }
    var want:  opt[usize]    = opt[usize].none{};
    var named: opt[Id[Name]] = opt[Id[Name]].none{};
    if (sel place.class_start || sel place.class_end) {
        var cname: str = nil;
        if (sel place.class_start) { cname = place.class_start; }
        or (sel place.class_end)   { cname = place.class_end; }
        var k: usize = 0;
        for (k < p.in.rules.class_count) {
            if (str_equals(p.in.rules.classes[k].name, cname)) { want = opt[usize].some{k}; }
            k = k + 1;
        }
        if (sel want.none) { ret res[Bounded, Fail].err{fail.about(fail.internal("a bound symbol names a class the format's layout does not hold"), cname)}; }
    }
    or {
        val text: View          = intern.bytes_of(p.in.names, ln.name);
        val sec:  View          = boundary.section_of(ln.bound, text);
        val nm:   opt[Id[Name]] = intern.find(p.in.names, sec.data, sec.len);
        if (sel nm.none) { ret res[Bounded, Fail].err{fail.internal("a bound symbol names an output section no kept section is laid into")}; }
        named = nm;
    }
    val first: bool  = sel place.class_start || sel place.section_start || sel place.load_start;
    val loads: bool  = sel place.load_start || sel place.load_end;
    var best:  usize = NONE::usize;
    var j:     usize = 0;
    for (j < table.count[Merged](?l.merged)) {
        val m: *Merged = table.at[Merged](?l.merged, table.nth[Merged](j));
        j = j + 1;
        var takes: bool = false;
        if (sel want.some)  { takes = sel m.segment.some && table.at[Info](?p.infos, table.nth[Info](j - 1)).class::usize == want.some; }
        if (sel named.some) { takes = m.name.index == named.some.index; }
        if (!takes)         { cnt; }
        if (best == NONE::usize) {
            best = j - 1;
            cnt;
        }
        val f: *Merged = table.at[Merged](?l.merged, table.nth[Merged](best));
        val e: u64     = begins(m, loads);
        val g: u64     = begins(f, loads);
        if (first && e < g)                    { best = j - 1; }
        if (!first && e + m.size > g + f.size) { best = j - 1; }
    }
    if (best == NONE::usize && sel named.some) { ret res[Bounded, Fail].err{fail.internal("a bound symbol names an output section no kept section is laid into")}; }
    if (best == NONE::usize)                   { ret res[Bounded, Fail].err{fail.malformed("a bound symbol's place holds no output section of the image")}; }
    val m:  *Merged         = table.at[Merged](?l.merged, table.nth[Merged](best));
    val at: opt[Id[Merged]] = opt[Id[Merged]].some{table.nth[Merged](best)};
    if (first) { ret res[Bounded, Fail].ok{Bounded{value: begins(m, loads), merged: at}}; }
    ret res[Bounded, Fail].ok{Bounded{value: begins(m, loads) + m.size, merged: at}};
}

# the start of the thread-local block, relative to the output section it
# starts, refused when no section carries thread-local data
fun block_start(l: *Layout) res[Bounded, Fail] {
    val t: opt[Tls] = l.tls;
    if (sel t.none) { ret res[Bounded, Fail].err{fail.malformed("a bound symbol names the start of a thread-local block the image does not hold")}; }
    var j: usize = 0;
    for (j < table.count[Merged](?l.merged)) {
        val m: *Merged = table.at[Merged](?l.merged, table.nth[Merged](j));
        if ((m.flags & section.TLS) != 0 && m.address == t.some.address) { ret res[Bounded, Fail].ok{Bounded{value: m.address, merged: opt[Id[Merged]].some{table.nth[Merged](j)}}}; }
        j = j + 1;
    }
    ret res[Bounded, Fail].err{fail.internal("the thread-local block starts at no output section")};
}

# the start of the image's first segment, relative to the first output
# section it loads, refused for an image that loads none
fun image_start(l: *Layout) res[Bounded, Fail] {
    if (table.count[Segment](?l.segments) == 0) { ret res[Bounded, Fail].err{fail.malformed("a bound symbol names the start of an image that loads no segment")}; }
    val start: u64   = table.at[Segment](?l.segments, table.nth[Segment](0)).address;
    var first: usize = NONE::usize;
    var j:     usize = 0;
    for (j < table.count[Merged](?l.merged)) {
        val m: *Merged = table.at[Merged](?l.merged, table.nth[Merged](j));
        j = j + 1;
        if (sel m.segment.none)                                                                                { cnt; }
        if (first == NONE::usize || m.address < table.at[Merged](?l.merged, table.nth[Merged](first)).address) { first = j - 1; }
    }
    if (first == NONE::usize) { ret res[Bounded, Fail].err{fail.malformed("a bound symbol names the start of an image that loads no output section")}; }
    ret res[Bounded, Fail].ok{Bounded{value: start, merged: opt[Id[Merged]].some{table.nth[Merged](first)}}};
}

# where `m` starts: where its bytes load when `loads`, where it runs otherwise
fun begins(m: *Merged, loads: bool) u64 {
    if (loads) { ret m.loads; }
    ret m.address;
}

# the address of the cell `c` inside the reserved table that names its anchor,
# relative to the output section holding the table
fun cell_value(l: *Layout, r: *Reserved, c: boundary.Cell) res[Bounded, Fail] {
    val t: opt[Id[Reservation]] = reserve.anchored(r, c.anchor);
    if (sel t.none)                                                { ret res[Bounded, Fail].err{fail.about(fail.unsupported("the link reserved no table the bound symbol lies in"), c.anchor.name)}; }
    if (c.offset >= table.at[Reservation](?r.tables, t.some).size) { ret res[Bounded, Fail].err{fail.internal("a bound symbol's cell lies past its table")}; }
    if (t.some.index::usize >= table.count[Spot](?l.tables))       { ret res[Bounded, Fail].err{fail.internal("reserved table was never placed")}; }
    val sp: Spot = table.items[Spot](?l.tables)[t.some.index::usize];
    if (!sel sp.section) { ret res[Bounded, Fail].err{fail.unsupported("a table outside the output sections has no address for a bound symbol")}; }
    val at:     Location       = Location{record: "bound symbol"};
    val offset: res[u64, Fail] = checked.add(at, sp.section.offset, c.offset);
    if (sel offset.err) { ret res[Bounded, Fail].err{offset.err}; }
    val v: res[u64, Fail] = checked.add(at, table.at[Merged](?l.merged, sp.section.merged).address, offset.ok);
    if (sel v.err) { ret res[Bounded, Fail].err{v.err}; }
    ret res[Bounded, Fail].ok{Bounded{value: v.ok, merged: opt[Id[Merged]].some{sp.section.merged}}};
}

fun value_at(l: *Layout, in: Id[Input], s: Id[Symbol]) *opt[u64] {
    if (in.index::usize >= table.count[u32](?l.starts)) { ret nil; }
    val i: usize = table.items[u32](?l.starts)[in.index]::usize + s.index::usize;
    if (i >= table.count[opt[u64]](?l.values)) { ret nil; }
    ret ?table.items[opt[u64]](?l.values)[i];
}

# place every reserved table where its placement puts it: at the end of the
# output section of its region that has the table's name, or in an output
# section of its own, or in the headers at the start of the file, or after
# every other byte of the file, left to the image writer, or in islands the
# merge of the input sections already laid. a table that takes
# its section past the format's limit is refused with the reason
pub fun place(l: *Layout, r: *Reserved) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Reservation](?r.tables)) {
        val e: err[Fail] = place_one(l, table.at[Reservation](?r.tables, table.nth[Reservation](i)));
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "reserved table", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun place_one(l: *Layout, t: *Reservation) err[Fail] {
    val at: Location = Location{record: "reserved table"};
    if (t.size > t.limit) { ret err[Fail].err{fail.overflow(t.reason)}; }
    if (sel t.placement.after_header) {
        val start: res[u64, Fail] = checked.align_up(at, l.header, t.align);
        if (sel start.err) { ret err[Fail].err{start.err}; }
        val stop: res[u64, Fail] = checked.add(at, start.ok, t.size);
        if (sel stop.err) { ret err[Fail].err{stop.err}; }
        l.header = stop.ok;
        val p: res[Id[Spot], Fail] = table.push[Spot](?l.tables, Spot.header{start.ok});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        ret err[Fail].ok{};
    }
    if (sel t.placement.file_end) {
        val p: res[Id[Spot], Fail] = table.push[Spot](?l.tables, Spot.file_end{});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        ret err[Fail].ok{};
    }
    if (sel t.placement.islands) {
        val p: res[Id[Spot], Fail] = table.push[Spot](?l.tables, Spot.islands{});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        ret err[Fail].ok{};
    }
    if (sel t.placement.region_end) {
        val into: opt[Id[Merged]] = extended(l, t, t.placement.region_end);
        if (sel into.some) { ret extend(l, t, into.some); }
    }
    val m: res[Id[Merged], Fail] = add_merged(l, Merged{
        name:    t.name,
        kind:    t.kind,
        flags:   t.flags,
        align:   t.align,
        entsize: t.entry_size,
        size:    t.size,
    });
    if (sel m.err) { ret err[Fail].err{m.err}; }
    val p: res[Id[Spot], Fail] = table.push[Spot](?l.tables, Spot.section{Placed{merged: m.ok}});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the last output section of the region `g` that has the name of `t`, down
# the sections of that name from the last
fun extended(l: *Layout, t: *Reservation, g: *reserve.Region) opt[Id[Merged]] {
    var key:  u32       = t.name.index;
    val last: opt[*u32] = map.get_by[u32, u32](?l.named, ?key);
    if (sel last.none) { ret opt[Id[Merged]].none{}; }
    var at: u32 = @last.some + 1;
    for (at != 0) {
        val id: Id[Merged] = Id[Merged]{index: at - 1};
        val m:  *Merged    = table.at[Merged](?l.merged, id);
        if (reserve.in_region(g, m.flags, m.kind)) { ret opt[Id[Merged]].some{id}; }
        at = table.items[u32](?l.prior)[id.index::usize];
    }
    ret opt[Id[Merged]].none{};
}

fun name_hash(k: *u32) u64 {
    ret fnv1a.step_u32(fnv1a.FNV_INIT, @k);
}

fun name_equal(a: *u32, b: *u32) bool {
    ret @a == @b;
}

# make the output section `m`, the last of its name
fun add_merged(l: *Layout, m: Merged) res[Id[Merged], Fail] {
    var key:   u32       = m.name.index;
    val last:  opt[*u32] = map.get_by[u32, u32](?l.named, ?key);
    var prior: u32       = 0;
    if (sel last.some) { prior = @last.some + 1; }
    val room: err[Fail] = table.reserve[u32](?l.prior, 1);
    if (sel room.err) { ret res[Id[Merged], Fail].err{room.err}; }
    val made: res[Id[Merged], Fail] = table.push[Merged](?l.merged, m);
    if (sel made.err) { ret made; }
    val put: res[bool, A.Error] = map.insert_by[u32, u32](?l.named, key, made.ok.index);
    if (sel put.err) {
        table.truncate[Merged](?l.merged, made.ok.index::usize);
        ret res[Id[Merged], Fail].err{fail.refused(put.err)};
    }
    val pr: res[Id[u32], Fail] = table.push[u32](?l.prior, prior);
    if (sel pr.err) { ret res[Id[Merged], Fail].err{pr.err}; }
    ret made;
}

# place the table `t` at the end of the output section `into`
fun extend(l: *Layout, t: *Reservation, into: Id[Merged]) err[Fail] {
    val at:    Location       = Location{record: "reserved table"};
    val m:     *Merged        = table.at[Merged](?l.merged, into);
    val start: res[u64, Fail] = checked.align_up(at, m.size, t.align);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    val stop: res[u64, Fail] = checked.add(at, start.ok, t.size);
    if (sel stop.err)      { ret err[Fail].err{stop.err}; }
    if (stop.ok > t.limit) { ret err[Fail].err{fail.overflow(t.reason)}; }
    m.size = stop.ok;
    if (m.align < t.align) { m.align = t.align; }
    join(m, t.flags, t.entry_size);
    val p: res[Id[Spot], Fail] = table.push[Spot](?l.tables, Spot.section{Placed{merged: into, offset: start.ok}});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the first thread-local output section in order and the greatest alignment of
# any, which the block's start keeps so each offset in it holds wherever a
# loader places the block, as PT_TLS states its alignment
rec ThreadStart {
    first: usize;
    align: u64;
}

fun thread_start(l: *Layout) ThreadStart {
    var o: ThreadStart = ThreadStart{first: NONE::usize, align: 1};
    var i: usize       = 0;
    for (i < table.count[Id[Merged]](?l.order)) {
        val j: usize   = table.items[Id[Merged]](?l.order)[i].index::usize;
        val m: *Merged = table.at[Merged](?l.merged, table.nth[Merged](j));
        i = i + 1;
        if ((m.flags & section.TLS) == 0) { cnt; }
        if (o.first == NONE::usize)       { o.first = j; }
        if (m.align > o.align)            { o.align = m.align; }
    }
    ret o;
}

# find the thread-local block among the output sections and the anchors the
# format's row for the architecture puts its offsets at
fun thread(p: *Pass) err[Fail] {
    val l:     *Layout  = p.l;
    val at:    Location = Location{record: "thread-local block"};
    var found: bool     = false;
    var start: u64      = 0;
    var stop:  u64      = 0;
    var align: u64      = 1;
    var i:     usize    = 0;
    for (i < table.count[Merged](?l.merged)) {
        val m: *Merged = table.at[Merged](?l.merged, table.nth[Merged](i));
        if ((m.flags & section.TLS) != 0) {
            val end: res[u64, Fail] = checked.add(at, m.address, m.size);
            if (sel end.err)                 { ret err[Fail].err{end.err}; }
            if (!found || m.address < start) { start = m.address; }
            if (!found || end.ok > stop)     { stop = end.ok; }
            if (m.align > align)             { align = m.align; }
            found = true;
        }
        i = i + 1;
    }
    if (!found) { ret err[Fail].ok{}; }
    var block: Tls = Tls{address: start, size: stop - start, align: align};
    if (sel p.in.thread.some) {
        val a: res[Anchors, Fail] = anchors(at, ?block, p.in.thread.some);
        if (sel a.err) { ret err[Fail].err{a.err}; }
        block.anchors = opt[Anchors].some{a.ok};
    }
    l.tls = opt[Tls].some{block};
    ret err[Fail].ok{};
}

fun anchors(at: Location, b: *Tls, row: *Thread) res[Anchors, Fail] {
    var base: u64 = b.address;
    if (sel row.side.above) {
        val past: res[u64, Fail] = checked.align_up(at, row.tcb, b.align);
        if (sel past.err)        { ret res[Anchors, Fail].err{past.err}; }
        if (past.ok > b.address) { ret res[Anchors, Fail].err{fail.overflow("the control block passes the start of the address space")}; }
        base = b.address - past.ok;
    }
    or {
        val whole: res[u64, Fail] = checked.align_up(at, b.size, b.align);
        if (sel whole.err) { ret res[Anchors, Fail].err{whole.err}; }
        val end: res[u64, Fail] = checked.add(at, b.address, whole.ok);
        if (sel end.err) { ret res[Anchors, Fail].err{end.err}; }
        base = end.ok;
    }
    val tp: res[u64, Fail] = biased(at, base, row.tp_bias);
    if (sel tp.err) { ret res[Anchors, Fail].err{tp.err}; }
    val dtp: res[u64, Fail] = biased(at, b.address, row.dtp_bias);
    if (sel dtp.err) { ret res[Anchors, Fail].err{dtp.err}; }
    ret res[Anchors, Fail].ok{Anchors{tp: tp.ok, dtp: dtp.ok}};
}

fun biased(at: Location, base: u64, bias: i64) res[u64, Fail] {
    val v: i128 = base::i128 + bias::i128;
    if (v < 0 || v > 0xffff_ffff_ffff_ffff) { ret res[u64, Fail].err{fail.in_record(fail.overflow("a thread anchor does not fit 64 bits"), at.record)}; }
    ret res[u64, Fail].ok{v::u64};
}

# the address of the slot of role `role` the target `index` takes, read back
# from where layout put its table
pub fun slot_address(l: *Layout, r: *Reserved, role: *SlotRole, index: u32) res[u64, Fail] {
    val p: res[Position, Fail] = slot_position(l, r, role, index);
    if (sel p.err) { ret res[u64, Fail].err{p.err}; }
    ret res[u64, Fail].ok{p.ok.address};
}

# where the slot of role `role` the target `index` takes lies: the output
# section holding its table, its offset there, its address and its file
# offset, read back from where layout put its table
pub fun slot_position(l: *Layout, r: *Reserved, role: *SlotRole, index: u32) res[Position, Fail] {
    val s: opt[*Slot] = reserve.slot_of(r, role, index);
    if (sel s.none) { ret res[Position, Fail].err{fail.about(fail.unsupported("no table holds the entry a reference reaches"), role.name)}; }
    ret at_offset(l, s.some.table, s.some.offset);
}

# where the reserved table `id` starts: the output section holding it, its
# offset there, its address and its file offset
pub fun table_position(l: *Layout, id: Id[Reservation]) res[Position, Fail] {
    ret at_offset(l, id, 0);
}

# where the place `within` bytes into the reserved table `id` lies
fun at_offset(l: *Layout, id: Id[Reservation], within: u64) res[Position, Fail] {
    if (id.index::usize >= table.count[Spot](?l.tables)) { ret res[Position, Fail].err{fail.internal("reserved table was never placed")}; }
    val sp: Spot = table.items[Spot](?l.tables)[id.index::usize];
    if (!sel sp.section) { ret res[Position, Fail].err{fail.unsupported("a table in the headers has no address of its own yet")}; }
    val at:     Location       = Location{record: "reserved table"};
    val m:      *Merged        = table.at[Merged](?l.merged, sp.section.merged);
    val offset: res[u64, Fail] = checked.add(at, sp.section.offset, within);
    if (sel offset.err) { ret res[Position, Fail].err{offset.err}; }
    val address: res[u64, Fail] = checked.add(at, m.address, offset.ok);
    if (sel address.err) { ret res[Position, Fail].err{address.err}; }
    val file: res[u64, Fail] = checked.add(at, m.offset, offset.ok);
    if (sel file.err) { ret res[Position, Fail].err{file.err}; }
    ret res[Position, Fail].ok{Position{merged: sp.section.merged, offset: offset.ok, address: address.ok, file: file.ok}};
}

# where the veneer `v` lies, read back from where layout put its island
pub fun veneer_position(l: *Layout, r: *Reserved, v: u32) res[Position, Fail] {
    if (v::usize >= table.count[reserve.Veneer](?r.veneers)) { ret res[Position, Fail].err{fail.internal("a relocation goes through no veneer")}; }
    val vn: *reserve.Veneer = table.at[reserve.Veneer](?r.veneers, table.nth[reserve.Veneer](v::usize));
    if (vn.island::usize >= table.count[Placed](?l.islands)) { ret res[Position, Fail].err{fail.internal("an island was never laid")}; }
    val p:      Placed         = table.items[Placed](?l.islands)[vn.island::usize];
    val at:     Location       = Location{record: "island"};
    val m:      *Merged        = table.at[Merged](?l.merged, p.merged);
    val offset: res[u64, Fail] = checked.add(at, p.offset, vn.offset);
    if (sel offset.err) { ret res[Position, Fail].err{offset.err}; }
    val address: res[u64, Fail] = checked.add(at, m.address, offset.ok);
    if (sel address.err) { ret res[Position, Fail].err{address.err}; }
    val file: res[u64, Fail] = checked.add(at, m.offset, offset.ok);
    if (sel file.err) { ret res[Position, Fail].err{file.err}; }
    ret res[Position, Fail].ok{Position{merged: p.merged, offset: offset.ok, address: address.ok, file: file.ok}};
}

# the address of the veneer `v`
pub fun veneer_address(l: *Layout, r: *Reserved, v: u32) res[u64, Fail] {
    val p: res[Position, Fail] = veneer_position(l, r, v);
    if (sel p.err) { ret res[u64, Fail].err{p.err}; }
    ret res[u64, Fail].ok{p.ok.address};
}

# the address the veneer `v` leads to: the landing pad it reaches its
# destination through, or its destination past its addend
pub fun lead(l: *Layout, r: *Reserved, v: u32) res[u64, Fail] {
    if (v::usize >= table.count[reserve.Veneer](?r.veneers)) { ret res[u64, Fail].err{fail.internal("no such veneer")}; }
    val vn:  *reserve.Veneer = table.at[reserve.Veneer](?r.veneers, table.nth[reserve.Veneer](v::usize));
    val via: opt[u32]        = vn.via;
    if (sel via.some) { ret veneer_address(l, r, via.some); }
    val d: res[u64, Fail] = destination(l, r, vn.toward);
    if (sel d.err) { ret d; }
    ret res[u64, Fail].ok{d.ok + (vn.addend:~u64)};
}

# the address of what a veneer leads to: a symbol's final value or an entry
# the link made
pub fun destination(l: *Layout, r: *Reserved, t: reserve.Toward) res[u64, Fail] {
    if (sel t.entry) { ret slot_address(l, r, t.entry.role, t.entry.index); }
    val v: opt[u64] = value_of(l, t.symbol.input, t.symbol.symbol);
    if (sel v.none) { ret res[u64, Fail].err{fail.internal("a veneer leads to a symbol with no address")}; }
    ret res[u64, Fail].ok{v.some};
}

# the value layout gave the name `name` the link defines itself, none for a
# name it does not define
pub fun linked_value(l: *Layout, r: *Resolved, name: Id[Name]) opt[u64] {
    if (name.index::usize >= table.count[u32](?r.linking)) { ret opt[u64].none{}; }
    val at: u32 = table.items[u32](?r.linking)[name.index::usize];
    if (at == 0 || at::usize > table.count[Bounded](?l.bounds)) { ret opt[u64].none{}; }
    ret opt[u64].some{table.at[Bounded](?l.bounds, table.nth[Bounded]((at - 1)::usize)).value};
}

# the address of the GOT base, the start of the output section holding the
# table that starts the GOT
pub fun got_address(l: *Layout, r: *Reserved) res[u64, Fail] {
    val b: res[Bounded, Fail] = got_base(l, r);
    if (sel b.err) { ret res[u64, Fail].err{b.err}; }
    ret res[u64, Fail].ok{b.ok.value};
}

# the GOT base, relative to the output section it starts
fun got_base(l: *Layout, r: *Reserved) res[Bounded, Fail] {
    val t: opt[Id[Reservation]] = r.got;
    if (sel t.none)                                          { ret res[Bounded, Fail].err{fail.unsupported("no GOT base is laid")}; }
    if (t.some.index::usize >= table.count[Spot](?l.tables)) { ret res[Bounded, Fail].err{fail.internal("reserved table was never placed")}; }
    val sp: Spot = table.items[Spot](?l.tables)[t.some.index::usize];
    if (!sel sp.section) { ret res[Bounded, Fail].err{fail.unsupported("a table outside the output sections has no address for the GOT base")}; }
    val m: Id[Merged] = sp.section.merged;
    ret res[Bounded, Fail].ok{Bounded{value: table.at[Merged](?l.merged, m).address, merged: opt[Id[Merged]].some{m}}};
}

# the index of the output section `m` in the format's section table, absent
# where the format's relocations name none
pub fun section_index(l: *Layout, m: Id[Merged]) opt[u64] {
    if (sel l.sections.none) { ret opt[u64].none{}; }
    ret opt[u64].some{l.sections.some + table.at[Merged](?l.merged, m).position::u64};
}

# the thread-local block, refused when no section carries thread-local data
pub fun thread_block(l: *Layout) res[Tls, Fail] {
    val t: opt[Tls] = l.tls;
    if (sel t.none) { ret res[Tls, Fail].err{fail.unsupported("no thread-local storage block is laid out")}; }
    ret res[Tls, Fail].ok{t.some};
}

# the offset of the address `at` in the thread-local block, refused when no
# section carries thread-local data or the address lies outside the block
pub fun block_offset(l: *Layout, at: u64) res[u64, Fail] {
    val b: res[Tls, Fail] = thread_block(l);
    if (sel b.err)                                          { ret res[u64, Fail].err{b.err}; }
    if (at < b.ok.address || at - b.ok.address > b.ok.size) { ret res[u64, Fail].err{fail.valued(fail.internal("a thread-local variable lies outside the thread-local block"), at::i128)}; }
    ret res[u64, Fail].ok{at - b.ok.address};
}

# where the thread-local block's offsets count from, refused when no section
# carries thread-local data or the format states no thread pointer layout for
# the architecture
pub fun thread_anchors(l: *Layout) res[Anchors, Fail] {
    val t: opt[Tls] = l.tls;
    if (sel t.none) { ret res[Anchors, Fail].err{fail.unsupported("no thread-local storage block is laid out")}; }
    or (sel t.some) {
        val a: opt[Anchors] = t.some.anchors;
        if (sel a.none) { ret res[Anchors, Fail].err{fail.unsupported("the format states no thread pointer layout for the architecture")}; }
        or (sel a.some) { ret res[Anchors, Fail].ok{a.some}; }
    }
}

# the bytes the reserved table `id` spans, read back from where layout put it
pub fun span_of(l: *Layout, r: *Reserved, id: Id[Reservation]) res[Span, Fail] {
    if (id.index::usize >= table.count[Spot](?l.tables)) {
        ret res[Span, Fail].err{fail.internal("reserved table was never placed")};
    }
    val sp: Spot = table.items[Spot](?l.tables)[id.index::usize];
    if (sel sp.header)   { ret res[Span, Fail].err{fail.unsupported("a table in the headers has no address of its own yet")}; }
    or (sel sp.file_end) { ret res[Span, Fail].err{fail.unsupported("a table at the end of the file has no address")}; }
    or (sel sp.islands)  { ret res[Span, Fail].err{fail.internal("a table spread into islands spans no one range")}; }
    val p: Placed         = sp.section;
    val m: *Merged        = table.at[Merged](?l.merged, p.merged);
    val a: res[u64, Fail] = checked.add(Location{record: "reserved table"}, m.address, p.offset);
    if (sel a.err) { ret res[Span, Fail].err{a.err}; }
    ret res[Span, Fail].ok{Span{address: a.ok, size: table.at[Reservation](?r.tables, id).size}};
}

# forget everything a run laid out, so layout can run again afresh
pub fun clear(l: *Layout) {
    table.clear[Merged](?l.merged);
    map.clear_by[MergedKey, u32](?l.index);
    map.clear_by[u32, u32](?l.named);
    table.clear[u32](?l.prior);
    table.clear[Id[Merged]](?l.order);
    table.clear[Landing](?l.landings);
    table.clear[Cut](?l.cuts);
    table.clear[Segment](?l.segments);
    table.clear[Spot](?l.tables);
    table.clear[Placed](?l.islands);
    table.clear[u32](?l.slots);
    table.clear[u32](?l.firsts);
    table.clear[opt[u64]](?l.values);
    table.clear[u32](?l.starts);
    table.clear[Conflict](?l.conflicts);
    table.clear[Bounded](?l.bounds);
    l.sections = opt[u64].none{};
    l.tls      = opt[Tls].none{};
    l.loaded   = Span{};
    l.base     = 0;
    l.header   = 0;
    l.end      = 0;
    l.tail     = Tail{};
    l.rounds   = 0;
}

pub fun release(l: *Layout) err[Fail] {
    var first: err[Fail] = table.release[Merged](?l.merged);
    first = fail.kept(first, released(map.dnit_by[MergedKey, u32](?l.index)));
    first = fail.kept(first, released(map.dnit_by[u32, u32](?l.named)));
    first = fail.kept(first, table.release[u32](?l.prior));
    first = fail.kept(first, table.release[Id[Merged]](?l.order));
    first = fail.kept(first, table.release[Landing](?l.landings));
    first = fail.kept(first, table.release[Cut](?l.cuts));
    first = fail.kept(first, table.release[Segment](?l.segments));
    first = fail.kept(first, table.release[Spot](?l.tables));
    first = fail.kept(first, table.release[Placed](?l.islands));
    first = fail.kept(first, table.release[u32](?l.slots));
    first = fail.kept(first, table.release[u32](?l.firsts));
    first = fail.kept(first, table.release[opt[u64]](?l.values));
    first = fail.kept(first, table.release[u32](?l.starts));
    first = fail.kept(first, table.release[Bounded](?l.bounds));
    ret fail.kept(first, table.release[Conflict](?l.conflicts));
}

fun merged(l: *Layout, names: *Interner, name: str, k: *section.Kind, size: u64) err[Fail] {
    val n: res[Id[intern.Name], Fail] = intern.intern_str(names, name);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val m: res[Id[Merged], Fail] = add_merged(l, Merged{name: n.ok, kind: k, flags: k.flags, align: 8, size: size});
    if (sel m.err) { ret err[Fail].err{m.err}; }
    ret err[Fail].ok{};
}
