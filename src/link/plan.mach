# the text of a link plan
#
# a plan is a text file of lines, each a flag of the link without its leading
# dashes: `key`, or `key = value`, with spaces or tabs around the `=` and at
# either end of the line. a blank line and a line whose first byte past its
# spaces is `#` state nothing. the plan reads only the shape of its lines, and
# which keys exist and what a value means is the flag table's. a line that
# names no key, a key with an empty value, a key followed by anything but `=`
# and a zero byte are refused, naming the line.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.format.file;
use mink.format.file.Loaded;

# one line of a plan that states a key
# ---
# line:  its number, the first line one
# key:   the key, a flag's long name without its dashes
# value: what follows its `=`, nil where nothing does
pub rec Line {
    line:  u64;
    key:   str;
    value: str;
}

# a plan read from a file
# ---
# path:  the file it was read from
# bytes: its text, a zero written after each key and value, which every
#        line's key and value point into
# lines: the lines that state a key, in the order the file states them
pub rec Plan {
    path:  str;
    bytes: Vector[u8];
    lines: Table[Line];
}

# an empty plan, whose tables live in `a`
pub fun make(a: *A.Allocator) Plan {
    ret Plan{path: nil, bytes: vector.init[u8](a), lines: table.make[Line](a)};
}

fun blank(b: u8) bool {
    ret b == ' ' || b == '\t' || b == '\r';
}

fun refused(text: str, line: u64) err[Fail] {
    ret err[Fail].err{fail.in_indexed(fail.malformed(text), "line", line)};
}

# read the line of `d` from `start` up to `end`, numbered `line`
fun line_of(p: *Plan, d: *u8, start: usize, end: usize, line: u64) err[Fail] {
    var s: usize = start;
    for (s < end && blank(d[s])) { s = s + 1; }
    var e: usize = end;
    for (e > s && blank(d[e - 1])) { e = e - 1; }
    if (s == e || d[s] == '#') { ret err[Fail].ok{}; }
    var k: usize = s;
    for (k < e && !blank(d[k]) && d[k] != '=') { k = k + 1; }
    if (k == s) { ret refused("a line names no key", line); }
    var j: usize = k;
    for (j < e && blank(d[j])) { j = j + 1; }
    var value: str = nil;
    if (j < e) {
        if (d[j] != '=') { ret refused("a key is followed by something other than `=`", line); }
        j = j + 1;
        for (j < e && blank(d[j])) { j = j + 1; }
        if (j == e) { ret refused("a key's value is empty", line); }
        value = (?d[j])::str;
    }
    d[k] = 0;
    d[e] = 0;
    val pushed: res[table.Id[Line], Fail] = table.push[Line](?p.lines, Line{line: line, key: (?d[s])::str, value: value});
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

# read the plan at `path` into `p`, made by make and read once. `p` is
# released by release whether or not reading succeeds
pub fun read(p: *Plan, a: *A.Allocator, path: str) err[Fail] {
    val l: res[Loaded, Fail] = file.load(a, path);
    if (sel l.err) { ret err[Fail].err{l.err}; }
    val dropped: err[A.Error] = vector.dnit[u8](?p.bytes);
    if (sel dropped.err) {
        var held: Loaded = l.ok;
        ret fail.kept(err[Fail].err{fail.refused(dropped.err)}, file.unload(?held));
    }
    p.path  = path;
    p.bytes = l.ok.bytes;
    val n:     usize               = p.bytes.len;
    val ended: res[usize, A.Error] = vector.push[u8](?p.bytes, 0);
    if (sel ended.err) { ret err[Fail].err{fail.in_file(fail.refused(ended.err), path)}; }
    val d:    *u8   = p.bytes.data;
    var at:   usize = 0;
    var line: u64   = 1;
    for (at < n) {
        var end: usize = at;
        for (end < n && d[end] != '\n') {
            if (d[end] == 0) { ret err[Fail].err{fail.in_file(fail.in_indexed(fail.malformed("a plan holds a zero byte"), "line", line), path)}; }
            end = end + 1;
        }
        val r: err[Fail] = line_of(p, d, at, end, line);
        if (sel r.err) { ret err[Fail].err{fail.in_file(r.err, path)}; }
        at   = end + 1;
        line = line + 1;
    }
    ret err[Fail].ok{};
}

# give back what the plan holds
pub fun release(p: *Plan) err[Fail] {
    val rb: err[A.Error] = vector.dnit[u8](?p.bytes);
    val rl: err[Fail]    = table.release[Line](?p.lines);
    if (sel rb.err) { ret err[Fail].err{fail.refused(rb.err)}; }
    ret rl;
}
