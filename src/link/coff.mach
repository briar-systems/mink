# how PE/COFF links: the linking row of the COFF format and the rows it names

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

use mink.base.rule.Axis;
use mink.catalog.output;
use mink.format.coff.layout;
use mink.format.layout.Rules;
use mink.link.coff.convention;
use mink.link.coff.image;
use mink.link.coff.templates;
use mink.link.collect.Leaving;
use mink.link.common;
use mink.link.consume;
use mink.link.fold;
use mink.link.image.Writer;
use mink.link.layout.Participant;
use mink.link.layout.Participants;
use mink.link.linking;
use mink.link.linking.Linking;
use mink.link.linking.Synthesizers;
use mink.link.needs;
use mink.link.reserve;
use mink.link.reserve.Declarer;
use mink.link.reserve.Declarers;
use mink.link.resolve;
use mink.link.resolve.Weak;
use mink.link.synthesizer;
use mink.link.thunk;
use mink.model.directive;

# the sections that are not image content a COFF link takes, the resource
# trees among them, which the image writer merges with the inputs' resources
val USE_COUNT: usize                   = 4;
val USES:      [USE_COUNT]*consume.Row = [USE_COUNT]*consume.Row{?consume.SIGNIFICANCE, ?consume.STRINGS, ?consume.STACK, ?consume.RESOURCE_TREES};

# the image writer exports what an export directive names
val DIRECTIVES: [1]*directive.Kind = [1]*directive.Kind{?directive.EXPORT};

val DECLARER_COUNT: usize                     = 3;
val DECLARERS:      [DECLARER_COUNT]*Declarer = [DECLARER_COUNT]*Declarer{?reserve.HEADER_TABLE, ?image.TABLES, ?convention.SLOTS};

val SYNTHESIZER_COUNT: usize                               = 3;
val SYNTHESIZERS:      [SYNTHESIZER_COUNT]*synthesizer.Row = [SYNTHESIZER_COUNT]*synthesizer.Row{?common.ROW, ?image.CALLBACK_BOUNDS, ?needs.ROW};

# thunks send a branch past its reach through a veneer in an island
val PARTICIPANT_COUNT: usize                           = 1;
val PARTICIPANTS:      [PARTICIPANT_COUNT]*Participant = [PARTICIPANT_COUNT]*Participant{?thunk.THUNKS};

# the PLAIN hooks, and the link asking the archives for the load configuration
val HOOKS: resolve.Hooks = resolve.Hooks{name: resolve.plain_name, library: resolve.shared, imported: resolve.no_record, asked: image.asked};

# every archive is searched again while a name is left undefined. whether a
# common definition pulls a member that defines its name as data is not
# verified, so the row leaves it off. an undefined weak reference takes its
# fallback. COFF inputs hold no merged strings, so no tails are shared.
# sections nothing reaches are left out. an image imports only from the DLLs a
# reference binds to. the link defines _tls_index where no input does, in the
# index cell of an image that supplies its own TLS directory. every image
# exports what its inputs' export directives name, an executable as a DLL
# does, as PE/COFF 6.3 lets any image carry an export table and COFF symbols
# carry no visibility that exports them. an image leaves the CodeView
# sections out
pub val LINKING: Linking = Linking{
    caps:         linking.DIRECTED_EXPORTS,
    search:       resolve.REVISIT,
    hooks:        ?HOOKS,
    weak:         Weak.fallback{},
    folds:        fold.NONE,
    layout:       opt[*Rules].some{?layout.LAYOUT},
    tails:        false,
    collects:     true,
    exports:      Axis{need: 0, deny: output.KEEPS},
    dynamic:      ?convention.DYNAMIC,
    loads_all:    false,
    facts:        ?convention.FACTS,
    writer:       opt[*Writer].some{?image.WRITER},
    declarers:    Declarers{rows: ?DECLARERS[0], count: DECLARER_COUNT},
    measures:     image.MEASURES,
    uses:         consume.Uses{rows: ?USES[0], count: USE_COUNT, directives: ?DIRECTIVES[0], directive_count: 1, resources: true, export_attributes: true},
    synthesizers: Synthesizers{rows: ?SYNTHESIZERS[0], count: SYNTHESIZER_COUNT},
    participants: Participants{rows: ?PARTICIPANTS[0], count: PARTICIPANT_COUNT},
    bounds:       image.BOUNDS,
    calls:        image.CALLS,
    leaving:      opt[*Leaving].some{?convention.LEAVING},
    templates:    templates.SETS,
};
