# a static library: the object files a link names, archived as they are
#
# no link resolves an archive's members. each input file is read as an
# object of the target's format, its definitions indexed through its neutral
# object, and archived whole, named by its file's last path component, in the
# variant the format's registration archives its objects in. a library named
# by a search, an object handed over in memory, a container and a file that
# is no object are refused, naming the input.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Table;
use mink.base.vectors;
use mink.bytes.sink.Sink;
use mink.catalog.format.Format;
use catalog_kind: mink.catalog.kind;
use mink.format.ar.write;
use mink.format.ar.write.Variant;
use mink.format.contract;
use mink.format.contract.Model;
use mink.format.file;
use mink.format.file.Loaded;
use mink.format.readers;
use mink.format.registration.Registration;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.link.options;
use mink.link.options.Options;
use mink.link.search.Request;
use mink.model.object;
use mink.model.object.Object;

# what an archive holds while it is built, each table one entry per member
# ---
# loaded:  the files read, whose bytes the members and models borrow
# models:  each file as its format reads it
# objects: each file's neutral object, which indexes its definitions
rec Held {
    loaded:  Vector[Loaded];
    models:  Table[Model];
    objects: Table[Object];
}

# the archive of the input files the `count` requests at `requests` name,
# read through the formats of `g` for the target and format `o` states
pub fun build(a: *A.Allocator, g: *Registry, o: *Options, requests: *Request, count: usize) res[Sink, Fail] {
    var h:   Held            = Held{loaded: vector.init[Loaded](a), models: table.make[Model](a), objects: table.make[Object](a)};
    val out: res[Sink, Fail] = archived(a, g, o, requests, count, ?h);
    val rel: err[Fail]       = release(?h);
    if (sel out.err) { ret out; }
    if (sel rel.err) { ret res[Sink, Fail].err{rel.err}; }
    ret out;
}

fun archived(a: *A.Allocator, g: *Registry, o: *Options, requests: *Request, count: usize, h: *Held) res[Sink, Fail] {
    val variant: res[*Variant, Fail] = registry.archive(g, o.target.format);
    if (sel variant.err) { ret res[Sink, Fail].err{variant.err}; }
    val owner: res[*Registration, Fail] = linker_of(g, o.target.format);
    if (sel owner.err) { ret res[Sink, Fail].err{owner.err}; }
    var i: usize = 0;
    for (i < count) {
        val r: *Request = ?requests[i];
        i = i + 1;
        if (sel r.file) {
            val m: err[Fail] = member(a, g, o, owner.ok, r.file.path, h);
            if (sel m.err) { ret res[Sink, Fail].err{m.err}; }
        }
        or { ret res[Sink, Fail].err{fail.unsupported("an archive holds the object files named, so it takes no library and no object handed over in memory")}; }
    }
    var sources: Vector[write.Source] = vector.init[write.Source](a);
    var e:       err[Fail]            = vectors.reserve[write.Source](?sources, vector.length[Loaded](?h.loaded));
    i = 0;
    for (i < vector.length[Loaded](?h.loaded) && sel e.ok) {
        val l:     *Loaded      = ?h.loaded.data[i];
        val obj:   *Object      = table.at[Object](?h.objects, table.nth[Object](i));
        val entry: write.Source = write.Source{name: last_component(l.input.file), data: Bytes{data: l.input.data, len: l.input.len}, object: obj, names: nil, count: 0};
        val p:     err[Fail]    = vectors.push[write.Source](?sources, entry);
        if (sel p.err) { e = err[Fail].err{p.err}; }
        i = i + 1;
    }
    var out: res[Sink, Fail];
    if (sel e.err) { out = res[Sink, Fail].err{e.err}; }
    or             { out = write.build(a, variant.ok, sources.data, vector.length[write.Source](?sources)); }
    val back: err[Fail] = vectors.release[write.Source](?sources);
    if (sel out.err)  { ret out; }
    if (sel back.err) { ret res[Sink, Fail].err{back.err}; }
    ret out;
}

# the registration whose link builds images of `f`
fun linker_of(g: *Registry, f: *Format) res[*Registration, Fail] {
    val r: res[*Registration, Fail] = registry.by_format(g, f);
    if (sel r.err) { ret r; }
    ret registry.links_of(g, r.ok);
}

# read the file at `path` into `h` as an archive member: an object whose
# format the target's link takes, converted to its neutral object
fun member(a: *A.Allocator, g: *Registry, o: *Options, owner: *Registration, path: str, h: *Held) err[Fail] {
    val l: res[Loaded, Fail] = file.load(a, path);
    if (sel l.err) { ret err[Fail].err{l.err}; }
    val kept: err[Fail] = vectors.push[Loaded](?h.loaded, l.ok);
    if (sel kept.err) {
        var dropped: Loaded    = l.ok;
        val freed:   err[Fail] = file.unload(?dropped);
        ret err[Fail].err{kept.err};
    }
    val input: *contract.Input  = ?h.loaded.data[vector.length[Loaded](?h.loaded) - 1].input;
    val read:  res[Model, Fail] = readers.read(?g.readers, a, input);
    if (sel read.err) { ret err[Fail].err{fail.in_file(read.err, path)}; }
    val m: res[table.Id[Model], Fail] = table.push[Model](?h.models, read.ok);
    if (sel m.err) {
        var dropped: Model     = read.ok;
        val freed:   err[Fail] = contract.release(?dropped);
        ret err[Fail].err{m.err};
    }
    val model: *Model                        = table.at[Model](?h.models, m.ok);
    val k:     res[*catalog_kind.Kind, Fail] = contract.kind(model);
    if (sel k.err)                                    { ret err[Fail].err{fail.in_file(k.err, path)}; }
    if (!catalog_kind.has(k.ok, catalog_kind.OBJECT)) { ret err[Fail].err{fail.in_file(fail.about(fail.unsupported("an archive member is an object file, and the file is of another kind"), k.ok.name), path)}; }
    val links: res[*Registration, Fail] = linker_of(g, model.reader.format);
    if (sel links.err)     { ret err[Fail].err{fail.in_file(links.err, path)}; }
    if (links.ok != owner) { ret err[Fail].err{fail.in_file(fail.about(fail.unsupported("the object's format is not one the target's link takes"), model.reader.format.name), path)}; }
    var obj: Object = object.make(a, o.target.arch, nil);
    obj.target = options.described(o);
    val conv: err[Fail] = contract.to_neutral(model, ?g.relocs, ?obj);
    if (sel conv.err) {
        val dropped: err[Fail] = object.release(?obj);
        ret err[Fail].err{fail.in_file(conv.err, path)};
    }
    val pushed: res[table.Id[Object], Fail] = table.push[Object](?h.objects, obj);
    if (sel pushed.err) {
        val dropped: err[Fail] = object.release(?obj);
        ret err[Fail].err{pushed.err};
    }
    ret err[Fail].ok{};
}

# the last path component of `path`, borrowed from it
fun last_component(path: str) Bytes {
    val len:   usize = str_len(path);
    var start: usize = len;
    for (start > 0 && path[start - 1] != '/') {
        start = start - 1;
    }
    ret Bytes{data: (?path[start])::*u8, len: len - start};
}

# give back what `h` holds: the objects, then the models, then the files
# they borrow
fun release(h: *Held) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[Object](?h.objects)) {
        first = fail.kept(first, object.release(table.at[Object](?h.objects, table.nth[Object](i))));
        i     = i + 1;
    }
    i = 0;
    for (i < table.count[Model](?h.models)) {
        first = fail.kept(first, contract.release(table.at[Model](?h.models, table.nth[Model](i))));
        i     = i + 1;
    }
    i = 0;
    for (i < vector.length[Loaded](?h.loaded)) {
        first = fail.kept(first, file.unload(?h.loaded.data[i]));
        i     = i + 1;
    }
    first = fail.kept(first, table.release[Object](?h.objects));
    first = fail.kept(first, table.release[Model](?h.models));
    ret fail.kept(first, vectors.release[Loaded](?h.loaded));
}
