# a static library: the object files a link names, archived as they are
#
# no link resolves an archive's members. each input file is read as an
# object of the target's format, its definitions indexed through its neutral
# object, and archived whole, named by its file's last path component, in the
# variant the format's registration archives its objects in. a library named
# by a search, an object handed over in memory, a container and a file that
# is no object are refused, naming the input.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Table;
use mink.base.vectors;
use mink.bytes.sink.Sink;
use catalog_kind: mink.catalog.kind;
use mink.format.ar.write;
use mink.format.ar.write.Variant;
use mink.format.contract;
use mink.format.contract.Model;
use mink.format.file;
use mink.format.file.Loaded;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.link.formats;
use mink.link.formats.Entry;
use mink.link.input.Request;
use mink.link.options;
use mink.link.options.Options;
use mink.model.object;
use mink.model.object.Object;

# what an archive holds while it is built, each table one entry per member
# ---
# loaded:  the files read, whose bytes the members and models borrow
# models:  each file as its format reads it
# objects: each file's neutral object, which indexes its definitions
rec Held {
    loaded:  Vector[Loaded];
    models:  Table[Model];
    objects: Table[Object];
}

# the archive of the input files the `count` requests at `requests` name,
# read through the formats of `g` for the target and format `o` states
pub fun build(a: *A.Allocator, g: *Registry, o: *Options, requests: *Request, count: usize) res[Sink, Fail] {
    var h:       Held            = Held{loaded: vector.init[Loaded](a), models: table.make[Model](a), objects: table.make[Object](a)};
    val res_out: res[Sink, Fail] = archived(a, g, o, requests, count, ?h);
    val err_rel: err[Fail]       = release(?h);
    if (sel res_out.err) { ret res_out; }
    if (sel err_rel.err) { ret res[Sink, Fail].err{err_rel.err}; }
    ret res_out;
}

fun archived(a: *A.Allocator, g: *Registry, o: *Options, requests: *Request, count: usize, h: *Held) res[Sink, Fail] {
    val res_variant: res[*Variant, Fail] = formats.archive(g, o.target.format);
    if (sel res_variant.err) { ret res[Sink, Fail].err{res_variant.err}; }
    val res_owner: res[*Entry, Fail] = formats.builder(o.target.format);
    if (sel res_owner.err) { ret res[Sink, Fail].err{res_owner.err}; }
    var i: usize = 0;
    for (i < count) {
        val r: *Request = ?requests[i];
        i = i + 1;
        if (sel r.file) {
            val err_member: err[Fail] = member(a, g, o, res_owner.ok, r.file.path, h);
            if (sel err_member.err) { ret res[Sink, Fail].err{err_member.err}; }
        }
        or { ret res[Sink, Fail].err{fail.unsupported("an archive holds the object files named, so it takes no library and no object handed over in memory")}; }
    }
    var sources:     Vector[write.Source] = vector.init[write.Source](a);
    var err_reserve: err[Fail]            = vectors.reserve[write.Source](?sources, vector.length[Loaded](?h.loaded));
    i = 0;
    for (i < vector.length[Loaded](?h.loaded) && sel err_reserve.ok) {
        val l:                  *Loaded      = ?h.loaded.data[i];
        val obj:                *Object      = table.at[Object](?h.objects, table.nth[Object](i));
        val entry:              write.Source = write.Source{name: last_component(l.input.file), data: Bytes{data: l.input.data, len: l.input.len}, object: obj, names: nil, count: 0};
        val err_sources_pushed: err[Fail]    = vectors.push[write.Source](?sources, entry);
        if (sel err_sources_pushed.err) { err_reserve = err[Fail].err{err_sources_pushed.err}; }
        i = i + 1;
    }
    var res_out: res[Sink, Fail];
    if (sel err_reserve.err) { res_out = res[Sink, Fail].err{err_reserve.err}; }
    or                       { res_out = write.build(a, res_variant.ok, sources.data, vector.length[write.Source](?sources)); }
    val err_back: err[Fail] = vectors.release[write.Source](?sources);
    if (sel res_out.err)  { ret res_out; }
    if (sel err_back.err) { ret res[Sink, Fail].err{err_back.err}; }
    ret res_out;
}

# read the file at `path` into `h` as an archive member: an object whose
# format the target's link takes, converted to its neutral object
fun member(a: *A.Allocator, g: *Registry, o: *Options, owner: *Entry, path: str, h: *Held) err[Fail] {
    val res_load: res[Loaded, Fail] = file.load(a, path);
    if (sel res_load.err) { ret err[Fail].err{res_load.err}; }
    val err_kept: err[Fail] = vectors.push[Loaded](?h.loaded, res_load.ok);
    if (sel err_kept.err) {
        var dropped:   Loaded    = res_load.ok;
        val err_freed: err[Fail] = file.unload(?dropped);
        ret err[Fail].err{err_kept.err};
    }
    val input:    *contract.Input  = ?h.loaded.data[vector.length[Loaded](?h.loaded) - 1].input;
    val res_read: res[Model, Fail] = registry.read(g, a, input);
    if (sel res_read.err) { ret err[Fail].err{fail.in_file(res_read.err, path)}; }
    val res_models_pushed: res[table.Id[Model], Fail] = table.push[Model](?h.models, res_read.ok);
    if (sel res_models_pushed.err) {
        var dropped:   Model     = res_read.ok;
        val err_freed: err[Fail] = contract.release(?dropped);
        ret err[Fail].err{res_models_pushed.err};
    }
    val model:    *Model                        = table.at[Model](?h.models, res_models_pushed.ok);
    val res_kind: res[*catalog_kind.Kind, Fail] = contract.kind(model);
    if (sel res_kind.err)                                    { ret err[Fail].err{fail.in_file(res_kind.err, path)}; }
    if (!catalog_kind.has(res_kind.ok, catalog_kind.OBJECT)) { ret err[Fail].err{fail.in_file(fail.about(fail.malformed("an archive member is an object file, and the file is of another kind"), res_kind.ok.name), path)}; }
    val res_links: res[*Entry, Fail] = formats.builder(model.reader.format);
    var takes:     bool              = false;
    if (sel res_links.ok) { takes = res_links.ok == owner; }
    if (!takes)           { ret err[Fail].err{fail.in_file(fail.about(fail.unsupported("the object's format is not one the target's link takes"), model.reader.format.name), path)}; }
    var obj: Object = object.make(a, o.target.arch, nil);
    obj.target = options.described(o);
    val err_conv: err[Fail] = registry.to_neutral(g, model, ?obj);
    if (sel err_conv.err) {
        val err_dropped: err[Fail] = object.release(?obj);
        ret err[Fail].err{fail.in_file(err_conv.err, path)};
    }
    val res_pushed: res[table.Id[Object], Fail] = table.push[Object](?h.objects, obj);
    if (sel res_pushed.err) {
        val err_dropped: err[Fail] = object.release(?obj);
        ret err[Fail].err{res_pushed.err};
    }
    ret err[Fail].ok{};
}

# the last path component of `path`, borrowed from it
fun last_component(path: str) Bytes {
    val len:   usize = str_len(path);
    var start: usize = len;
    for (start > 0 && path[start - 1] != '/') {
        start = start - 1;
    }
    ret Bytes{data: (?path[start])::*u8, len: len - start};
}

# give back what `h` holds: the objects, then the models, then the files
# they borrow
fun release(h: *Held) err[Fail] {
    var err_first: err[Fail] = err[Fail].ok{};
    var i:         usize     = 0;
    for (i < table.count[Object](?h.objects)) {
        err_first = fail.kept(err_first, object.release(table.at[Object](?h.objects, table.nth[Object](i))));
        i         = i + 1;
    }
    i = 0;
    for (i < table.count[Model](?h.models)) {
        err_first = fail.kept(err_first, contract.release(table.at[Model](?h.models, table.nth[Model](i))));
        i         = i + 1;
    }
    i = 0;
    for (i < vector.length[Loaded](?h.loaded)) {
        err_first = fail.kept(err_first, file.unload(?h.loaded.data[i]));
        i         = i + 1;
    }
    err_first = fail.kept(err_first, table.release[Object](?h.objects));
    err_first = fail.kept(err_first, table.release[Model](?h.models));
    ret fail.kept(err_first, vectors.release[Loaded](?h.loaded));
}
