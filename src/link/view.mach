# the location views of the line tables lowered into the inputs, counted once
# layout settles
#
# a lowering for a link hands the rows of each sequence with a view to the
# input set, and this phase counts them as lower.view says, on the places
# layout gave them after relaxation: a row after a difference the link
# recomputes moved where its address differs from the row before's, and one
# after a number where its offset does, as its line table advances, and a
# reset row is zero. a row
# asserting a zero view whose view is not zero is refused as malformed, and
# each view symbol is defined absolute at its view, in its input's object and
# in the layout's values, before relocate reads them. a row whose code the
# link dropped has no address and no view, and its view symbol stays
# undefined, so debugging data that refers to it refers to dropped code.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.link.collect.Ref;
use mink.link.input;
use mink.link.input.Inputs;
use mink.link.input.Viewed;
use mink.link.layout;
use mink.link.layout.Layout;
use mink.link.layout.Position;
use mink.link.pieces.Pieces;
use mink.lower.view;
use mink.lower.view.Counted;
use mink.model.object;
use mink.model.object.Definition;
use mink.model.object.Object;
use mink.model.object.Symbol;

# inputs: the input set and the rows whose views it counts
# layout: where every input section landed, its symbols' values the phase
#         completes
# pieces: the merged pieces, for a place in a merged section
pub rec In {
    inputs: *Inputs;
    layout: *Layout;
    pieces: *Pieces;
}

# the last row of a sequence that has an address
# ---
# view:    its view
# address: its address
# offset:  its offset in its section
# located: a row of the sequence has an address yet
rec Last {
    view:    u64;
    address: u64;
    offset:  u64;
    located: bool;
}

pub fun run(in: *In) err[Fail] {
    var last: Last  = Last{};
    var i:    usize = 0;
    for (i < table.count[Viewed](?in.inputs.views)) {
        val v: *Viewed   = table.at[Viewed](?in.inputs.views, table.nth[Viewed](i));
        val e: err[Fail] = counted(in, v, ?last);
        if (sel e.err) { ret err[Fail].err{fail.in_file(fail.at_offset(fail.in_record(e.err, "line row"), v.row.at.offset), input.at(in.inputs, v.input).name)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# count the view of the row `v` after the last row of its sequence that has
# an address, `last`, which it becomes when it has one
fun counted(in: *In, v: *Viewed, last: *Last) err[Fail] {
    val r: *Counted = ?v.row;
    if (r.start) { last.located = false; }
    val pos: res[opt[Position], Fail] = layout.locate(in.layout, in.pieces, Ref{input: v.input, section: r.at.section}, r.at.offset);
    if (sel pos.err)     { ret err[Fail].err{pos.err}; }
    if (sel pos.ok.none) { ret err[Fail].ok{}; }
    val at:    u64  = pos.ok.some.address;
    var moved: bool = false;
    if (last.located && r.moves) { moved = at != last.address; }
    or (last.located)            { moved = r.at.offset != last.offset; }
    val n: u64       = view.next(last.view, !last.located, moved, r.view);
    val h: err[Fail] = view.holds(r.view, n);
    if (sel h.err) { ret h; }
    @last = Last{view: n, address: at, offset: r.at.offset, located: true};
    if (!(sel r.view.symbol)) { ret err[Fail].ok{}; }
    val o:   *Object = input.object_of(in.inputs, v.input);
    val sym: *Symbol = object.symbol_at(o, r.view.symbol);
    sym.def = Definition.absolute{n};
    ret layout.revalue(in.layout, v.input, r.view.symbol, n);
}
