# the assign phase: definitions given their indexes in the output's index
# spaces
#
# an output laid out by index rather than by address, as a wasm module's
# functions, tables, memories and globals or a SPIR-V module's ids, gives each
# definition an index in its space before anything is laid out. the phase
# applies only to a format whose linking row declares an indexed layout. no
# format declares one yet, so the phase never runs and the record stays empty.

use std.types.error.err;
use std.types.string.str;

use A: std.allocator;

use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.link.input.Input;
use mink.link.input.Inputs;
use mink.link.resolve.Resolved;
use mink.model.object.Symbol;

# an index space of the output, as a wasm module's function or global space
pub rec Space {
    name: str;
}

# the index a definition takes
# ---
# input:  the input defining it
# symbol: the symbol it is, in that input
# space:  the space it takes an index in
# index:  its index there
pub rec Index {
    input:  Id[Input];
    symbol: Id[Symbol];
    space:  *Space;
    index:  u32;
}

# indexes: every index the phase assigned
pub rec Assigned {
    indexes: Table[Index];
}

pub rec In {
    inputs:   *Inputs;
    resolved: *Resolved;
}

pub fun make(a: *A.Allocator) Assigned {
    ret Assigned{indexes: table.make[Index](a)};
}

# assign every definition its index, of which no format asks any yet
pub fun run(in: *In, out: *Assigned) err[Fail] {
    ret err[Fail].ok{};
}

pub fun release(s: *Assigned) err[Fail] {
    ret table.release[Index](?s.indexes);
}
