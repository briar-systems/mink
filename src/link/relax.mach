# relaxation, the layout participant that rewrites relocations to the forms
# their rows allow
#
# after each layout pass the participant walks every relocation of every
# section that landed, in input and record order, and takes for it the form
# the dynamic phase decided it as, or a contender the dynamic phase found may
# displace it whose range holds and that is taken over it, or any whose
# range holds where it decided no form. which forms may
# be taken by the facts known before layout is the dynamic phase's to say,
# so the tables reserve lays hold what every form taken reaches. the form
# taken is recorded for the record and each partner, and its bytes as edits:
# the template it writes with the bits it carries in, and the run or the
# part of a padding it removes, which layout cuts on the next pass. a
# contender's range holds where the value its rewritten record computes from
# the addresses of the last pass lies in it. a form taken by its range stays
# taken in the passes after, as the deletes that follow only shrink the
# distances its value spans, so a form is never undone and the passes settle
# within layout's bound. the walk reads the inputs, the addresses of the last
# pass and the forms it took then alone, so a pass whose records match the
# last one's has settled. a relocatable output
# keeps its relocations, so nothing is rewritten for one.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.Order;
use mink.catalog.output;
use mink.link.adjust;
use mink.link.adjust.Adjusted;
use mink.link.collect.Ref;
use mink.link.dynamic;
use mink.link.dynamic.Decision;
use mink.link.form;
use mink.link.input;
use mink.link.input.Input;
use mink.link.layout;
use mink.link.layout.Layout;
use mink.link.layout.Participant;
use mink.link.layout.Position;
use mink.link.pieces;
use mink.link.resolve;
use mink.link.value;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Reloc;
use mink.model.object.Section;
use mink.reloc.compute;
use mink.reloc.engine;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.row;
use mink.reloc.row.Copy;
use mink.reloc.row.Delete;
use mink.reloc.row.Pad;
use mink.reloc.row.Rewrite;
use mink.reloc.row.Row;

# the participant's name, which its records carry
val NAME: str = "relaxation";

pub val RELAX: Participant = Participant{name: NAME, step: step};

# what one walk reads
# ---
# in:   the layout's inputs
# l:    the layout the last pass made
# next: the records this walk makes
# from: what a form's value inputs are gathered from, at the last pass's
#       addresses
rec Walk {
    in:   *layout.In;
    l:    *Layout;
    next: Adjusted;
    from: value.Sources;
}

# a relocation the walk weighs, with what its forms read
# ---
# id:       its input
# o:        the input's object
# k:        its index among the object's relocations
# rel:      the relocation
# ref:      the section it patches
# bytes:    that section's bytes in the input
# position: where its place landed
# decision: what it needs and the forms it may take
# row:      the row of its record
rec Site {
    id:       Id[Input];
    o:        *Object;
    k:        usize;
    rel:      *Reloc;
    ref:      Ref;
    bytes:    Bytes;
    position: Position;
    decision: *Decision;
    row:      *Row;
}

fun step(in: *layout.In, l: *Layout) res[bool, Fail] {
    if (output.has(in.kind, output.KEEPS)) { ret res[bool, Fail].ok{false}; }
    var w: Walk = Walk{
        in:   in,
        l:    l,
        next: adjust.make(in.inputs.a),
        from: value.Sources{
            inputs:   in.inputs,
            resolved: in.resolved,
            reserved: in.reserved,
            assigned: in.assigned,
            pieces:   in.pieces,
            layout:   l,
            arch:     in.target.arch,
            weak:     in.weak,
        },
    };
    var r: res[bool, Fail] = walked(?w);
    val n: err[Fail]       = adjust.release(?w.next);
    if (sel r.err) { ret r; }
    if (sel n.err) { ret res[bool, Fail].err{n.err}; }
    ret r;
}

fun walked(w: *Walk) res[bool, Fail] {
    var i: usize = 0;
    for (i < input.count(w.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        i = i + 1;
        val o: *Object = input.object_of(w.in.inputs, id);
        if (o == nil || resolve.library(w.in.resolved, id)) { cnt; }
        val e: err[Fail] = relaxed(w, id, o);
        if (sel e.err) { ret res[bool, Fail].err{fail.in_file(e.err, input.at(w.in.inputs, id).name)}; }
    }
    adjust.seal(?w.next);
    if (adjust.same(w.in.adjusted, NAME, ?w.next)) { ret res[bool, Fail].ok{false}; }
    val r: err[Fail] = adjust.restate(w.in.adjusted, NAME, ?w.next);
    if (sel r.err) { ret res[bool, Fail].err{r.err}; }
    ret res[bool, Fail].ok{true};
}

# take a form for each relocation of `o` whose row has forms
fun relaxed(w: *Walk, id: Id[Input], o: *Object) err[Fail] {
    var k: usize = 0;
    for (k < table.count[Reloc](?o.relocs)) {
        val st: res[opt[Site], Fail] = site(w, id, o, k);
        if (sel st.err) { ret err[Fail].err{fail.in_indexed(st.err, "relocation", k::u64)}; }
        if (sel st.ok.none) {
            k = k + 1;
            cnt;
        }
        var s:    Site                     = st.ok.some;
        val form: res[opt[*Rewrite], Fail] = taken(w, ?s);
        if (sel form.err) { ret err[Fail].err{fail.in_indexed(form.err, "relocation", k::u64)}; }
        if (sel form.ok.none) {
            k = k + 1;
            cnt;
        }
        val f: *Rewrite  = form.ok.some;
        val e: err[Fail] = recorded(w, ?s, f);
        if (sel e.err) { ret err[Fail].err{fail.about(fail.in_indexed(e.err, "relocation", k::u64), f.name)}; }
        k = k + f.span::usize + 1;
    }
    ret err[Fail].ok{};
}

# the relocation `k` of `o` with what its forms read, none when the dynamic
# phase found no form it may take: it heads no records or reaches what did
# not survive. a relocation decided as a form whose place did not land or
# lies in a merged section is refused, as the form is not applied there
fun site(w: *Walk, id: Id[Input], o: *Object, k: usize) res[opt[Site], Fail] {
    val rel: *Reloc               = table.at[Reloc](?o.relocs, table.nth[Reloc](k));
    val dec: res[*Decision, Fail] = dynamic.decision_of(w.in.dynamic, id, k::u32);
    if (sel dec.err) { ret res[opt[Site], Fail].err{dec.err}; }
    val d: *Decision = dec.ok;
    if (d.nth != 0 || (d.form == nil && d.count == 0)) { ret res[opt[Site], Fail].ok{opt[Site].none{}}; }
    val ref:    Ref                    = Ref{input: id, section: rel.section};
    val member: opt[Id[pieces.Member]] = pieces.member_of(w.in.pieces, ref);
    if (sel member.some) {
        if (d.form != nil) { ret res[opt[Site], Fail].err{fail.unsupported("a relocation in a merged section is rewritten")}; }
        ret res[opt[Site], Fail].ok{opt[Site].none{}};
    }
    val rw: res[*Row, Fail] = row.targeting(w.in.relocs, rel.kind, sel rel.minus.some);
    if (sel rw.err) { ret res[opt[Site], Fail].err{rw.err}; }
    val pos: res[opt[Position], Fail] = layout.locate(w.l, w.in.pieces, ref, rel.offset);
    if (sel pos.err) { ret res[opt[Site], Fail].err{pos.err}; }
    if (sel pos.ok.none) {
        if (d.form != nil) { ret res[opt[Site], Fail].err{fail.internal("a relocation decided as a rewritten form has no place in the layout")}; }
        ret res[opt[Site], Fail].ok{opt[Site].none{}};
    }
    val s: *Section = object.section_at(o, rel.section);
    if (sel s.contents.zero) { ret res[opt[Site], Fail].err{fail.internal("a relocation decided as a rewritten form patches a zero-fill section")}; }
    ret res[opt[Site], Fail].ok{opt[Site].some{Site{
        id:       id,
        o:        o,
        k:        k,
        rel:      rel,
        ref:      ref,
        bytes:    object.bytes(o, ?s.contents),
        position: pos.ok.some,
        decision: d,
        row:      rw.ok,
    }}};
}

# the form the relocation of `s` was decided as, or the contender whose
# range holds that is taken over the rest, none when neither is. a
# contender is taken over the form it displaces, or writes bytes in place
# of no form
fun taken(w: *Walk, s: *Site) res[opt[*Rewrite], Fail] {
    var best: *Rewrite = s.decision.form;
    var i:    u32      = 0;
    for (i < s.decision.count) {
        val x: *dynamic.Contender = dynamic.contender_of(w.in.dynamic, s.decision, i);
        val f: *Rewrite           = x.form;
        i = i + 1;
        val h: res[bool, Fail] = ranged(w, s, x);
        if (sel h.err)                         { ret res[opt[*Rewrite], Fail].err{fail.about(h.err, f.name)}; }
        if (!h.ok)                             { cnt; }
        if (best == nil || row.beats(f, best)) { best = f; }
    }
    if (best == nil) { ret res[opt[*Rewrite], Fail].ok{opt[*Rewrite].none{}}; }
    ret res[opt[*Rewrite], Fail].ok{opt[*Rewrite].some{best}};
}

# whether the value the record of `s` computes rewritten to the contender
# `x`, decided as the kind `x` makes it, at the place its form moves it to,
# lies in the form's range at the addresses of the last pass. a form taken
# for it then still holds. a record that names no target, a relocation the
# loader binds or one of debug information whose target did not survive
# computes no value here, so no form holds for it by its range. a form whose
# rewritten record reads its partner's value or the field it rewrites is
# refused
fun ranged(w: *Walk, s: *Site, x: *dynamic.Contender) res[bool, Fail] {
    val f:    *Rewrite            = x.form;
    val last: opt[*adjust.Choice] = adjust.choice_of(w.in.adjusted, s.id, table.nth[Reloc](s.k));
    if (sel last.some) {
        val c: *adjust.Choice = last.some;
        if (c.rewrite == f && c.nth == 0 && str_equals(c.by, NAME)) { ret res[bool, Fail].ok{true}; }
    }
    val range: opt[field.Range] = f.when.range;
    if (sel range.none) { ret res[bool, Fail].err{fail.internal("a contender states no range")}; }
    val d: *Decision = ?x.decision;
    if (d.row == nil)                                  { ret res[bool, Fail].ok{false}; }
    if (dynamic.has(d.row.outcome, dynamic.BIND_SITE)) { ret res[bool, Fail].ok{false}; }
    val rw: res[*Row, Fail] = row.targeting(w.in.relocs, f.kinds[0], sel s.rel.minus.some);
    if (sel rw.err) { ret res[bool, Fail].err{rw.err}; }
    if (sel rw.ok.pair.some || compute.needs(rw.ok.value, compute.NEEDS_CUR)) {
        ret res[bool, Fail].err{fail.unsupported("a form weighed by its value rewrites to a record that reads its partner or the field it rewrites")};
    }
    val at: res[u64, Fail] = row.moved(f, s.rel.offset);
    if (sel at.err) { ret res[bool, Fail].err{at.err}; }
    val pos: res[opt[Position], Fail] = layout.locate(w.l, w.in.pieces, s.ref, at.ok);
    if (sel pos.err)                     { ret res[bool, Fail].err{pos.err}; }
    if (sel pos.ok.none)                 { ret res[bool, Fail].err{fail.malformed("a rewritten relocation moves its place into code the link dropped")}; }
    if (s.rel.offset > s.bytes.len::u64) { ret res[bool, Fail].err{fail.malformed("a relocation's place lies past its section")}; }
    var site: engine.Site = engine.Site{
        file:    input.at(w.in.inputs, s.id).name,
        section: "section",
        data:    ?s.bytes.data[s.rel.offset::usize],
        size:    s.bytes.len::u64 - s.rel.offset,
        order:   w.in.target.arch.order,
    };
    var ask: value.Ask = value.Ask{
        input:    s.id,
        reloc:    s.rel,
        kind:     f.kinds[0],
        row:      rw.ok,
        holds:    s.row,
        site:     ?site,
        section:  object.section_at(s.o, s.rel.section),
        decision: d,
        place:    pos.ok.some.address,
    };
    val gathered: res[value.Gathered, Fail] = value.gather(?w.from, ?ask);
    if (sel gathered.err)     { ret res[bool, Fail].err{gathered.err}; }
    if (sel gathered.ok.dead) { ret res[bool, Fail].ok{false}; }
    var v: compute.Inputs  = gathered.ok.inputs;
    val n: res[i128, Fail] = engine.value(rw.ok, ?site, ?v);
    if (sel n.err) { ret res[bool, Fail].err{n.err}; }
    ret engine.within(rw.ok, range.some, n.ok, ?v);
}

# the offset in the section of `s` of the `len` bytes `at` past its place,
# none when they lie outside the section
fun within(s: *Site, at: i8, len: u64) res[opt[u64], Fail] {
    ret form.within(s.bytes, s.rel.offset, at, len);
}

# record the form `f` for the relocation of `s` and each partner it
# consumes, and its edits
fun recorded(w: *Walk, s: *Site, f: *Rewrite) err[Fail] {
    var j: u8 = 0;
    for (j <= f.span) {
        val c: err[Fail] = adjust.choose(?w.next, adjust.Choice{by: NAME, input: s.id, reloc: table.nth[Reloc](s.k + j::usize), rewrite: f, nth: j});
        if (sel c.err) { ret c; }
        j = j + 1;
    }
    val e: row.Emit = f.emit;
    if (e.bytes.len != 0) {
        val t: err[Fail] = templated(w, s, f);
        if (sel t.err) { ret t; }
    }
    if (sel e.removal.bytes) {
        val d:  Delete              = e.removal.bytes;
        val at: res[opt[u64], Fail] = within(s, d.at, d.len::u64);
        if (sel at.err)     { ret err[Fail].err{at.err}; }
        if (sel at.ok.none) { ret err[Fail].err{fail.malformed("a rewrite deletes bytes past its section")}; }
        ret adjust.edit(?w.next, adjust.Edit{by: NAME, at: s.ref, offset: at.ok.some, change: adjust.Change.delete{d.len::u64}});
    }
    if (sel e.removal.pad) { ret padded(w, s, e.removal.pad); }
    ret err[Fail].ok{};
}

# write the template of `f` over the bytes at the place of `s`, the bits it
# carries in copied from the input's bytes
fun templated(w: *Walk, s: *Site, f: *Rewrite) err[Fail] {
    val e:     row.Emit            = f.emit;
    val order: Order               = w.in.target.arch.order;
    val dest:  res[opt[u64], Fail] = within(s, e.bytes.at, e.bytes.len::u64);
    if (sel dest.err)     { ret err[Fail].err{dest.err}; }
    if (sel dest.ok.none) { ret err[Fail].err{fail.malformed("a rewrite writes bytes past its section")}; }
    var buf: Table[u8] = table.make[u8](w.in.inputs.a);
    val r:   err[Fail] = written(w, s, f, order, dest.ok.some, ?buf);
    ret fail.kept(r, table.release[u8](?buf));
}

# write the template of `f` at `at`, built in `buf`
fun written(w: *Walk, s: *Site, f: *Rewrite, order: Order, at: u64, buf: *Table[u8]) err[Fail] {
    val e: row.Emit          = f.emit;
    val x: res[Id[u8], Fail] = table.extend[u8](buf, e.bytes.data, e.bytes.len::usize);
    if (sel x.err) { ret err[Fail].err{x.err}; }
    val c: err[Fail] = carried(s, f, order, table.items[u8](buf));
    if (sel c.err) { ret c; }
    ret adjust.write(?w.next, NAME, s.ref, at, table.items[u8](buf), e.bytes.len::usize);
}

# carry the bits the copies of `f` take from the input's bytes at the place
# of `s` into the template at `buf`
fun carried(s: *Site, f: *Rewrite, order: Order, buf: *u8) err[Fail] {
    val e: row.Emit = f.emit;
    var c: usize    = 0;
    for (c < e.copy_count) {
        val y:    *Copy               = ?e.copies[c];
        val from: res[opt[u64], Fail] = within(s, y.from, y.len::u64);
        if (sel from.err)     { ret err[Fail].err{from.err}; }
        if (sel from.ok.none) { ret err[Fail].err{fail.malformed("a rewrite copies bits from past its section")}; }
        val sp:   Piece = Piece{at: y.shift, width: y.width};
        val src:  Field = Field{bytes: y.len, pieces: ?sp, count: 1};
        val dp:   Piece = Piece{at: y.to, width: y.width};
        val dst:  Field = Field{bytes: y.len, pieces: ?dp, count: 1};
        val bits: u64   = field.get(?src, ?s.bytes.data[from.ok.some::usize], order);
        field.put(?dst, ?buf[y.into::usize], order, bits, 0);
        c = c + 1;
    }
    ret err[Fail].ok{};
}

# keep the part of the padding at the place of `s` its address needs, written
# with the filler, and delete the rest, so the bytes after are aligned again
fun padded(w: *Walk, s: *Site, p: Pad) err[Fail] {
    val addend: i64 = s.rel.addend;
    if (addend < 0) { ret err[Fail].err{fail.malformed("a padding states a negative length")}; }
    val stated: u64 = addend::u64;
    var align:  u64 = 1;
    for (align < stated + p.unit::u64) {
        align = align << 1;
    }
    val keep: u64 = (align - s.position.address % align) % align;
    if (keep > stated) { ret err[Fail].err{fail.malformed("a padding is shorter than its alignment needs")}; }
    val room: res[opt[u64], Fail] = within(s, 0, stated);
    if (sel room.err)     { ret err[Fail].err{room.err}; }
    if (sel room.ok.none) { ret err[Fail].err{fail.malformed("a padding runs past its section")}; }
    if (keep != 0) {
        var fill: Table[u8] = table.make[u8](w.in.inputs.a);
        val e:    err[Fail] = filled(?fill, p, keep);
        var r:    err[Fail] = e;
        if (!sel e.err) { r = adjust.write(?w.next, NAME, s.ref, s.rel.offset, table.items[u8](?fill), table.count[u8](?fill)); }
        val k: err[Fail] = fail.kept(r, table.release[u8](?fill));
        if (sel k.err) { ret k; }
    }
    ret adjust.edit(?w.next, adjust.Edit{by: NAME, at: s.ref, offset: s.rel.offset + keep, change: adjust.Change.delete{stated - keep}, restores: true});
}

# `n` bytes of the filler of `p`, the widest that fits first
fun filled(out: *Table[u8], p: Pad, n: u64) err[Fail] {
    var left: u64   = n;
    var i:    usize = 0;
    for (i < p.fill_count && left != 0) {
        val f: row.Bytes = p.fills[i];
        if (f.len::u64 > left) {
            i = i + 1;
            cnt;
        }
        val x: res[Id[u8], Fail] = table.extend[u8](out, f.data, f.len::usize);
        if (sel x.err) { ret err[Fail].err{x.err}; }
        left = left - f.len::u64;
    }
    if (left != 0) { ret err[Fail].err{fail.malformed("the filler cannot fill the padding an alignment keeps")}; }
    ret err[Fail].ok{};
}
