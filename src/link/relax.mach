# relaxation, the layout participant that rewrites relocations to the forms
# their rows allow
#
# after each layout pass the participant walks every relocation of every
# section that landed, in input and record order, and takes for it the form
# the dynamic phase decided it as, or a contender the dynamic phase found may
# displace it whose range holds and that is taken over it, or any whose
# range holds where it decided no form. which forms may
# be taken by the facts known before layout is the dynamic phase's to say,
# so the tables reserve lays hold what every form taken reaches. the form
# taken is recorded for the record and each partner, and its bytes as edits:
# the template it writes with the bits it carries in, and the run or the
# part of a padding it removes, which layout cuts on the next pass. a
# contender's range holds where the value its rewritten record computes from
# the addresses of the last pass lies in it. a form taken by its range that
# removes bytes stays taken in the passes after, so a form that moves code is
# never undone and the passes settle within layout's bound. one that removes
# none is weighed again each pass, as an island a later pass lays may carry
# its target past its reach, and taking or dropping it moves no byte. the
# walk reads the inputs, the addresses of the last pass and the forms it took
# then alone, so a pass whose records match the last one's has settled. a
# relocatable output keeps its relocations, so nothing is rewritten for one.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.vectors;
use mink.bytes.reader.Order;
use mink.catalog.output;
use mink.link.adjust;
use mink.link.adjust.Adjusted;
use mink.link.collect.Ref;
use mink.link.dynamic;
use mink.link.dynamic.Decision;
use mink.link.form;
use mink.link.input;
use mink.link.input.Input;
use mink.link.layout;
use mink.link.layout.Layout;
use mink.link.layout.Participant;
use mink.link.layout.Position;
use mink.link.pieces;
use mink.link.resolve;
use link_rows: mink.link.rows;
use mink.link.value;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Reloc;
use mink.model.object.Section;
use mink.reloc.compute;
use mink.reloc.engine;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.row;
use mink.reloc.row.Copy;
use mink.reloc.row.Delete;
use mink.reloc.row.Lookup;
use mink.reloc.row.Pad;
use mink.reloc.row.Rewrite;
use mink.reloc.row.Row;

use std.collections.vector;
use std.collections.vector.Vector;

# the participant's name, which its records carry
val NAME: str = "relaxation";

pub val RELAX: Participant = Participant{name: NAME, step: step};

# what one walk reads
# ---
# in:   the layout's inputs
# l:    the layout the last pass made
# next: the records this walk makes
# from: what a form's value inputs are gathered from, at the last pass's
#       addresses
rec Walk {
    in:   *layout.In;
    l:    *Layout;
    next: Adjusted;
    from: value.Sources;
}

# a relocation the walk weighs, with what its forms read
# ---
# id:       its input
# o:        the input's object
# k:        its index among the object's relocations
# rel:      the relocation
# ref:      the section it patches
# bytes:    that section's bytes in the input
# position: where its place landed
# decision: what it needs and the forms it may take
# row:      the row of its record
rec Site {
    id:       Id[Input];
    o:        *Object;
    k:        usize;
    rel:      *Reloc;
    ref:      Ref;
    bytes:    Bytes;
    position: Position;
    decision: *Decision;
    row:      *Row;
}

fun step(in: *layout.In, l: *Layout) res[bool, Fail] {
    if (output.has(in.kind, output.KEEPS)) { ret res[bool, Fail].ok{false}; }
    var w: Walk = Walk{
        in:   in,
        l:    l,
        next: adjust.init(in.inputs.a),
        from: value.Sources{
            inputs:   in.inputs,
            resolved: in.resolved,
            reserved: in.reserved,
            assigned: in.assigned,
            pieces:   in.pieces,
            layout:   l,
            arch:     in.target.arch,
            weak:     in.weak,
        },
    };
    var res_walked:  res[bool, Fail] = walked(?w);
    val err_release: err[Fail]       = adjust.dnit(?w.next);
    if (sel res_walked.err)  { ret res_walked; }
    if (sel err_release.err) { ret res[bool, Fail].err{err_release.err}; }
    ret res_walked;
}

fun walked(w: *Walk) res[bool, Fail] {
    var i: usize = 0;
    for (i < input.count(w.in.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        i = i + 1;
        val o: *Object = input.object_of(w.in.inputs, id);
        if (o == nil || resolve.library(w.in.resolved, id)) { cnt; }
        val err_relaxed: err[Fail] = relaxed(w, id, o);
        if (sel err_relaxed.err) { ret res[bool, Fail].err{fail.in_file(err_relaxed.err, input.at(w.in.inputs, id).name)}; }
    }
    adjust.seal(?w.next);
    if (adjust.same(w.in.adjusted, NAME, ?w.next)) { ret res[bool, Fail].ok{false}; }
    val err_restate: err[Fail] = adjust.restate(w.in.adjusted, NAME, ?w.next);
    if (sel err_restate.err) { ret res[bool, Fail].err{err_restate.err}; }
    ret res[bool, Fail].ok{true};
}

# take a form for each relocation of `o` whose row has forms
fun relaxed(w: *Walk, id: Id[Input], o: *Object) err[Fail] {
    var k: usize = 0;
    for (k < table.count[Reloc](?o.relocs)) {
        val res_site: res[opt[Site], Fail] = site(w, id, o, k);
        if (sel res_site.err) { ret err[Fail].err{fail.in_indexed(res_site.err, "relocation", k::u64)}; }
        if (sel res_site.ok.none) {
            k = k + 1;
            cnt;
        }
        var s:        Site                     = res_site.ok.some;
        val res_form: res[opt[*Rewrite], Fail] = taken(w, ?s);
        if (sel res_form.err) { ret err[Fail].err{fail.in_indexed(res_form.err, "relocation", k::u64)}; }
        if (sel res_form.ok.none) {
            k = k + 1;
            cnt;
        }
        val f:            *Rewrite  = res_form.ok.some;
        val err_recorded: err[Fail] = recorded(w, ?s, f);
        if (sel err_recorded.err) { ret err[Fail].err{fail.about(fail.in_indexed(err_recorded.err, "relocation", k::u64), f.name)}; }
        k = k + f.span::usize + 1;
    }
    ret err[Fail].ok{};
}

# the relocation `k` of `o` with what its forms read, none when the dynamic
# phase found no form it may take: it heads no records or reaches what did
# not survive. a relocation decided as a form whose place did not land or
# lies in a merged section is refused, as the form is not applied there
fun site(w: *Walk, id: Id[Input], o: *Object, k: usize) res[opt[Site], Fail] {
    val rel:     *Reloc               = table.at[Reloc](?o.relocs, table.nth[Reloc](k));
    val res_dec: res[*Decision, Fail] = dynamic.decision_of(w.in.dynamic, id, k::u32);
    if (sel res_dec.err) { ret res[opt[Site], Fail].err{res_dec.err}; }
    val d: *Decision = res_dec.ok;
    if (d.nth != 0 || (d.form == nil && d.count == 0)) { ret res[opt[Site], Fail].ok{opt[Site].none{}}; }
    val ref:        Ref                    = Ref{input: id, section: rel.section};
    val opt_member: opt[Id[pieces.Member]] = pieces.member_of(w.in.pieces, ref);
    if (sel opt_member.some) {
        if (d.form != nil) { ret res[opt[Site], Fail].err{fail.unsupported("a relocation in a merged section is rewritten")}; }
        ret res[opt[Site], Fail].ok{opt[Site].none{}};
    }
    val res_rows: res[*Lookup, Fail] = link_rows.for_object(w.in.rows, o);
    if (sel res_rows.err) { ret res[opt[Site], Fail].err{res_rows.err}; }
    val res_targeting: res[*Row, Fail] = row.targeting(res_rows.ok, rel.kind, sel rel.minus.some);
    if (sel res_targeting.err) { ret res[opt[Site], Fail].err{res_targeting.err}; }
    val res_pos: res[opt[Position], Fail] = layout.locate(w.l, w.in.pieces, ref, rel.offset);
    if (sel res_pos.err) { ret res[opt[Site], Fail].err{res_pos.err}; }
    if (sel res_pos.ok.none) {
        if (d.form != nil) { ret res[opt[Site], Fail].err{fail.internal("a relocation decided as a rewritten form has no place in the layout")}; }
        ret res[opt[Site], Fail].ok{opt[Site].none{}};
    }
    val s: *Section = object.section_at(o, rel.section);
    if (sel s.contents.zero) { ret res[opt[Site], Fail].err{fail.internal("a relocation decided as a rewritten form patches a zero-fill section")}; }
    ret res[opt[Site], Fail].ok{opt[Site].some{Site{
        id:       id,
        o:        o,
        k:        k,
        rel:      rel,
        ref:      ref,
        bytes:    object.bytes(o, ?s.contents),
        position: res_pos.ok.some,
        decision: d,
        row:      res_targeting.ok,
    }}};
}

# the form the relocation of `s` was decided as, or the contender whose
# range holds that is taken over the rest, none when neither is. a
# contender is taken over the form it displaces, or writes bytes in place
# of no form
fun taken(w: *Walk, s: *Site) res[opt[*Rewrite], Fail] {
    var best: *Rewrite = s.decision.form;
    var i:    u32      = 0;
    for (i < s.decision.count) {
        val x: *dynamic.Contender = dynamic.contender_of(w.in.dynamic, s.decision, i);
        val f: *Rewrite           = x.form;
        i = i + 1;
        val res_ranged: res[bool, Fail] = ranged(w, s, x);
        if (sel res_ranged.err)                { ret res[opt[*Rewrite], Fail].err{fail.about(res_ranged.err, f.name)}; }
        if (!res_ranged.ok)                    { cnt; }
        if (best == nil || row.beats(f, best)) { best = f; }
    }
    if (best == nil) { ret res[opt[*Rewrite], Fail].ok{opt[*Rewrite].none{}}; }
    ret res[opt[*Rewrite], Fail].ok{opt[*Rewrite].some{best}};
}

# whether the value the record of `s` computes rewritten to the contender
# `x`, decided as the kind `x` makes it, at the place its form moves it to,
# lies in the form's range at the addresses of the last pass. a form that
# removes bytes taken for it then still holds. a record that names no target, a relocation the
# loader binds or one of debug information whose target did not survive
# computes no value here, so no form holds for it by its range. a form whose
# rewritten record reads its partner's value or the field it rewrites is
# refused
fun ranged(w: *Walk, s: *Site, x: *dynamic.Contender) res[bool, Fail] {
    val f:        *Rewrite            = x.form;
    val opt_last: opt[*adjust.Choice] = adjust.choice_of(w.in.adjusted, s.id, table.nth[Reloc](s.k));
    if (sel opt_last.some) {
        val c: *adjust.Choice = opt_last.some;
        if (c.rewrite == f && c.nth == 0 && str_equals(c.by, NAME) && moves_code(f)) { ret res[bool, Fail].ok{true}; }
    }
    val opt_range: opt[field.Range] = f.when.range;
    if (sel opt_range.none) { ret res[bool, Fail].err{fail.internal("a contender states no range")}; }
    val d: *Decision = ?x.decision;
    if (d.row == nil)                                  { ret res[bool, Fail].ok{false}; }
    if (dynamic.has(d.row.outcome, dynamic.BIND_SITE)) { ret res[bool, Fail].ok{false}; }
    val res_rows: res[*Lookup, Fail] = link_rows.for_object(w.in.rows, s.o);
    if (sel res_rows.err) { ret res[bool, Fail].err{res_rows.err}; }
    val res_targeting: res[*Row, Fail] = row.targeting(res_rows.ok, f.kinds[0], sel s.rel.minus.some);
    if (sel res_targeting.err) { ret res[bool, Fail].err{res_targeting.err}; }
    if (sel res_targeting.ok.pair.some || compute.needs(res_targeting.ok.value, compute.NEEDS_CUR)) {
        ret res[bool, Fail].err{fail.unsupported("a form weighed by its value rewrites to a record that reads its partner or the field it rewrites")};
    }
    val res_moved: res[u64, Fail] = row.moved(f, s.rel.offset);
    if (sel res_moved.err) { ret res[bool, Fail].err{res_moved.err}; }
    val res_pos: res[opt[Position], Fail] = layout.locate(w.l, w.in.pieces, s.ref, res_moved.ok);
    if (sel res_pos.err)                 { ret res[bool, Fail].err{res_pos.err}; }
    if (sel res_pos.ok.none)             { ret res[bool, Fail].err{fail.malformed("a rewritten relocation moves its place into code the link dropped")}; }
    if (s.rel.offset > s.bytes.len::u64) { ret res[bool, Fail].err{fail.malformed("a relocation's place lies past its section")}; }
    var site: engine.Site = engine.Site{
        file:    input.at(w.in.inputs, s.id).name,
        section: "section",
        data:    ?s.bytes.data[s.rel.offset::usize],
        size:    s.bytes.len::u64 - s.rel.offset,
        order:   w.in.target.arch.order,
    };
    var ask: value.Ask = value.Ask{
        input:    s.id,
        reloc:    s.rel,
        kind:     f.kinds[0],
        row:      res_targeting.ok,
        holds:    s.row,
        site:     ?site,
        section:  object.section_at(s.o, s.rel.section),
        decision: d,
        place:    res_pos.ok.some.address,
    };
    val res_gathered: res[value.Gathered, Fail] = value.gather(?w.from, ?ask);
    if (sel res_gathered.err)     { ret res[bool, Fail].err{res_gathered.err}; }
    if (sel res_gathered.ok.dead) { ret res[bool, Fail].ok{false}; }
    var v:         compute.Inputs  = res_gathered.ok.inputs;
    val res_value: res[i128, Fail] = engine.value(res_targeting.ok, ?site, ?v);
    if (sel res_value.err) { ret res[bool, Fail].err{res_value.err}; }
    ret engine.within(res_targeting.ok, opt_range.some, res_value.ok, ?v);
}

# whether the form `f` removes bytes, so taking it moves the code after it
fun moves_code(f: *Rewrite) bool {
    ret row.removed(f) != 0 || sel f.emit.removal.pad;
}

# the offset in the section of `s` of the `len` bytes `at` past its place,
# none when they lie outside the section
fun within(s: *Site, at: i8, len: u64) res[opt[u64], Fail] {
    ret form.within(s.bytes, s.rel.offset, at, len);
}

# record the form `f` for the relocation of `s` and each partner it
# consumes, and its edits
fun recorded(w: *Walk, s: *Site, f: *Rewrite) err[Fail] {
    var j: u8 = 0;
    for (j <= f.span) {
        val err_choose: err[Fail] = adjust.choose(?w.next, adjust.Choice{by: NAME, input: s.id, reloc: table.nth[Reloc](s.k + j::usize), rewrite: f, nth: j});
        if (sel err_choose.err) { ret err_choose; }
        j = j + 1;
    }
    val e: row.Emit = f.emit;
    if (e.bytes.len != 0) {
        val err_templated: err[Fail] = templated(w, s, f);
        if (sel err_templated.err) { ret err_templated; }
    }
    if (sel e.removal.bytes) {
        val d:          Delete              = e.removal.bytes;
        val res_within: res[opt[u64], Fail] = within(s, d.at, d.len::u64);
        if (sel res_within.err)     { ret err[Fail].err{res_within.err}; }
        if (sel res_within.ok.none) { ret err[Fail].err{fail.malformed("a rewrite deletes bytes past its section")}; }
        ret adjust.edit(?w.next, adjust.Edit{by: NAME, at: s.ref, offset: res_within.ok.some, change: adjust.Change.delete{d.len::u64}});
    }
    if (sel e.removal.pad) { ret padded(w, s, e.removal.pad); }
    ret err[Fail].ok{};
}

# write the template of `f` over the bytes at the place of `s`, the bits it
# carries in copied from the input's bytes
fun templated(w: *Walk, s: *Site, f: *Rewrite) err[Fail] {
    val e:        row.Emit            = f.emit;
    val order:    Order               = w.in.target.arch.order;
    val res_dest: res[opt[u64], Fail] = within(s, e.bytes.at, e.bytes.len::u64);
    if (sel res_dest.err)     { ret err[Fail].err{res_dest.err}; }
    if (sel res_dest.ok.none) { ret err[Fail].err{fail.malformed("a rewrite writes bytes past its section")}; }
    var buf:         Vector[u8] = vector.init[u8](w.in.inputs.a);
    val err_written: err[Fail]  = written(w, s, f, order, res_dest.ok.some, ?buf);
    ret fail.kept(err_written, vectors.dnit[u8](?buf));
}

# write the template of `f` at `at`, built in `buf`
fun written(w: *Walk, s: *Site, f: *Rewrite, order: Order, at: u64, buf: *Vector[u8]) err[Fail] {
    val e:          row.Emit  = f.emit;
    val err_extend: err[Fail] = vectors.extend[u8](buf, e.bytes.data, e.bytes.len::usize);
    if (sel err_extend.err) { ret err[Fail].err{err_extend.err}; }
    val err_carried: err[Fail] = carried(s, f, order, buf.data);
    if (sel err_carried.err) { ret err_carried; }
    ret adjust.write(?w.next, NAME, s.ref, at, buf.data, e.bytes.len::usize);
}

# carry the bits the copies of `f` take from the input's bytes at the place
# of `s` into the template at `buf`
fun carried(s: *Site, f: *Rewrite, order: Order, buf: *u8) err[Fail] {
    val e: row.Emit = f.emit;
    var c: usize    = 0;
    for (c < e.copy_count) {
        val y:        *Copy               = ?e.copies[c];
        val res_from: res[opt[u64], Fail] = within(s, y.from, y.len::u64);
        if (sel res_from.err)     { ret err[Fail].err{res_from.err}; }
        if (sel res_from.ok.none) { ret err[Fail].err{fail.malformed("a rewrite copies bits from past its section")}; }
        val sp:   Piece = Piece{at: y.shift, width: y.width};
        val src:  Field = Field{bytes: y.len, pieces: ?sp, count: 1};
        val dp:   Piece = Piece{at: y.to, width: y.width};
        val dst:  Field = Field{bytes: y.len, pieces: ?dp, count: 1};
        val bits: u64   = field.get(?src, ?s.bytes.data[res_from.ok.some::usize], order);
        field.put(?dst, ?buf[y.into::usize], order, bits, 0);
        c = c + 1;
    }
    ret err[Fail].ok{};
}

# keep the part of the padding at the place of `s` its address needs, written
# with the filler, and delete the rest, so the bytes after are aligned again
fun padded(w: *Walk, s: *Site, p: Pad) err[Fail] {
    val addend: i64 = s.rel.addend;
    if (addend < 0) { ret err[Fail].err{fail.malformed("a padding states a negative length")}; }
    val stated: u64 = addend::u64;
    var align:  u64 = 1;
    for (align < stated + p.unit::u64) {
        align = align << 1;
    }
    val keep: u64 = (align - s.position.address % align) % align;
    if (keep > stated) { ret err[Fail].err{fail.malformed("a padding is shorter than its alignment needs")}; }
    val res_room: res[opt[u64], Fail] = within(s, 0, stated);
    if (sel res_room.err)     { ret err[Fail].err{res_room.err}; }
    if (sel res_room.ok.none) { ret err[Fail].err{fail.malformed("a padding runs past its section")}; }
    if (keep != 0) {
        var fill:       Vector[u8] = vector.init[u8](w.in.inputs.a);
        val err_filled: err[Fail]  = filled(?fill, p, keep);
        var err_write:  err[Fail]  = err_filled;
        if (!sel err_filled.err) { err_write = adjust.write(?w.next, NAME, s.ref, s.rel.offset, fill.data, vector.length[u8](?fill)); }
        val err_kept: err[Fail] = fail.kept(err_write, vectors.dnit[u8](?fill));
        if (sel err_kept.err) { ret err_kept; }
    }
    ret adjust.edit(?w.next, adjust.Edit{by: NAME, at: s.ref, offset: s.rel.offset + keep, change: adjust.Change.delete{stated - keep}, restores: true});
}

# `n` bytes of the filler of `p`, the widest that fits first
fun filled(out: *Vector[u8], p: Pad, n: u64) err[Fail] {
    var left: u64   = n;
    var i:    usize = 0;
    for (i < p.fill_count && left != 0) {
        val f: row.Bytes = p.fills[i];
        if (f.len::u64 > left) {
            i = i + 1;
            cnt;
        }
        val err_extend: err[Fail] = vectors.extend[u8](out, f.data, f.len::usize);
        if (sel err_extend.err) { ret err[Fail].err{err_extend.err}; }
        left = left - f.len::u64;
    }
    if (left != 0) { ret err[Fail].err{fail.malformed("the filler cannot fill the padding an alignment keeps")}; }
    ret err[Fail].ok{};
}
