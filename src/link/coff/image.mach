# an optional header layout and what an image of it states by its address
# width
# ---
# shape:           the layout
# characteristics: the file characteristics an image of it states
# randomized:      the DLL characteristics beyond dynamic base an image of it
#                  the loader may place anywhere states
# based:           the base relocation type of an address of its width
rec Width {
    shape:           *ImageShape;
    characteristics: u64;
    randomized:      u64;
    based:           *Constant;
}

# a 64-bit image is large address aware
val WIDTH_COUNT: usize              = 2;
val WIDTHS:      [WIDTH_COUNT]Width = [WIDTH_COUNT]Width{
    Width{shape: ?model.PE32, characteristics: tables.IMAGE_FILE_32BIT_MACHINE.value, randomized: 0, based: ?tables.IMAGE_REL_BASED_HIGHLOW},
    Width{
        shape:           ?model.PE32PLUS,
        characteristics: tables.IMAGE_FILE_LARGE_ADDRESS_AWARE.value,
        randomized:      tables.IMAGE_DLLCHARACTERISTICS_HIGH_ENTROPY_VA.value,
        based:           ?tables.IMAGE_REL_BASED_DIR64,
    },
};

# the MS-DOS header, and the program after it that says the image needs
# windows, as every PE linker writes them
val DOS_HEADER:       u64                  = 64;
val DOS_PROGRAM_SIZE: usize                = 56;
val DOS_PROGRAM:      [DOS_PROGRAM_SIZE]u8 = [DOS_PROGRAM_SIZE]u8{
    0x0e, 0x1f, 0xba, 0x0e, 0x00, 0xb4, 0x09, 0xcd, 0x21, 0xb8, 0x01, 0x4c, 0xcd, 0x21,
    'T', 'h', 'i', 's', ' ', 'p', 'r', 'o', 'g', 'r', 'a', 'm', ' ', 'c', 'a', 'n', 'n', 'o', 't', ' ',
    'b', 'e', ' ', 'r', 'u', 'n', ' ', 'i', 'n', ' ', 'D', 'O', 'S', ' ', 'm', 'o', 'd', 'e', '.', '$',
    0, 0,
};
val DOS_SIZE:      u64 = DOS_HEADER + DOS_PROGRAM_SIZE::u64;
val DOS_PAGE:      u64 = 512;
val DOS_PARAGRAPH: u64 = 16;
# where the MS-DOS header states its relocations start
val DOS_RELOCATIONS: usize = 0x18;

# the PE signature, the file header and a section header
val SIGNATURE_SIZE: u64 = 4;
val FILE_HEADER:    u64 = 20;

# the data directories every PE linker writes, the last of them reserved
val DIRECTORIES: usize = 16;

# a base relocation block covers a page of 4 KiB, whatever the system's page
val BLOCK_PAGE: u64 = 0x1000;
val BLOCK_TYPE: u64 = 12;

# the image base is a multiple of 64 KiB
val BASE_ALIGN: u64 = 0x10000;

# what the image states where nothing else does: the linker version, the
# windows version an image runs on, and the stack and heap reserved and
# committed, the stack's where the link states none
val LINKER_MAJOR:  u8      = 14;
val LINKER_MINOR:  u8      = 0;
val SYSTEM:        Version = Version{major: 6, minor: 0};
val STACK_RESERVE: u64     = 0x10_0000;
val STACK_COMMIT:  u64     = 0x1000;
val HEAP_RESERVE:  u64     = 0x10_0000;
val HEAP_COMMIT:   u64     = 0x1000;

# the DLL characteristics every image states, and those an image that starts
# at an entry, an application, states besides
val EVERY_IMAGE: u64 = tables.IMAGE_DLLCHARACTERISTICS_NX_COMPAT.value;
val APPLICATION: u64 = tables.IMAGE_DLLCHARACTERISTICS_TERMINAL_SERVER_AWARE.value;

# the export table's section, and the alignment of its tables of words
val EDATA:        str = ".edata";
val EXPORT_ALIGN: u64 = 4;

# the base relocation section: its name, the alignment of its blocks, and its
# characteristics, discardable, as only the loader reads it while it maps
# the image
val RELOC_NAME:            str = ".reloc";
val BLOCK_ALIGN:           u64 = 4;
val RELOC_CHARACTERISTICS: u64 = tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_DISCARDABLE.value | tables.IMAGE_SCN_MEM_READ.value;

# the kinds the image writer builds: the executables, and the DLL. the link
# refuses a fixed kind on a host whose loader places every image where it
# chooses
val KIND_COUNT: usize             = 4;
val KINDS:      [KIND_COUNT]*Kind = [KIND_COUNT]*Kind{?output.STATIC, ?output.DYNAMIC, ?output.PIE, ?output.SHARED};

# the executables, which alone hold thread-local data yet
val EXECUTABLE_COUNT: usize                   = 3;
val EXECUTABLES:      [EXECUTABLE_COUNT]*Kind = [EXECUTABLE_COUNT]*Kind{?output.STATIC, ?output.DYNAMIC, ?output.PIE};

# the PE image writer, whose interface file is a DLL's import library
pub val WRITER: Writer = Writer{kinds: ?KINDS[0], kind_count: KIND_COUNT, compresses: false, offsets: false, sizing: Sizing.refused{}, stack: Stacking{records: Stack.both{}, needs: 0}, write: write, interface: opt[Interfacer].some{import_library}};

# the bytes the base relocations take, which follow the pages their sites lie
# on once the image is laid out
pub val BASE_RELOCATIONS: reserve.Measure = reserve.Measure{name: "base relocations"};

# the import tables an image lays in .idata ahead of its import address
# table: the descriptors, the import lookup table, the hint/name table and
# the DLL names, measured from the imports
pub val IMPORT_TABLES: reserve.Measure = reserve.Measure{name: "import tables"};

# the resource tree of an image whose inputs carry resources, measured from
# them
pub val RESOURCES: reserve.Measure = reserve.Measure{name: "resource tree"};

# the export table of a DLL whose inputs state exports, measured from them
pub val EXPORT_TABLE: reserve.Measure = reserve.Measure{name: "export table"};

# the TLS directory of an image that supplies its own: the template's start
# and end, the address of the index cell, the address of the callback array,
# the zero fill and the characteristics, each address as wide as the image's
pub val TLS_DIRECTORY: reserve.Measure = reserve.Measure{name: "TLS directory"};

# the index cell of an image that supplies its own TLS directory, where the
# loader writes the image's index among the thread-local blocks
pub val TLS_INDEX: Anchor = Anchor{name: "TLS index"};

# the names a CRT supplies the TLS directory, the index cell and the bounds
# of the callback array by, which the link defines when no input does
val TLS_USED:  str = "_tls_used";
val TLS_CELL:  str = "_tls_index";
val TLS_FIRST: str = "__xl_a";
val TLS_LAST:  str = "__xl_z";

# the start of the name of every section of the callback array, and the
# sections of its bounds
val TLS_CALLBACKS:     str = ".CRT$XL";
val TLS_FIRST_SECTION: str = ".CRT$XLA";
val TLS_LAST_SECTION:  str = ".CRT$XLZ";

# the index cell is a 32-bit word
val TLS_CELL_SIZE: u64 = 4;

# the null pointer each bound of the callback array holds
val NULL_POINTER_SIZE: usize                 = 8;
val NULL_POINTER:      [NULL_POINTER_SIZE]u8 = [NULL_POINTER_SIZE]u8{0, 0, 0, 0, 0, 0, 0, 0};

# the TLS directory's addresses, and the bytes of its fields after them: the
# zero fill and the characteristics
val TLS_ADDRESSES: u64 = 4;
val TLS_TAIL:      u64 = 8;

# the names the PE link defines at places of its layout: _tls_index in the
# index cell the image reserves, and for an ARM64EC image the metadata, the
# load configuration it lays where no input supplies one and the helper
# cells
val BOUND_COUNT: usize              = 20;
val BOUND_ROWS:  [BOUND_COUNT]Bound = [BOUND_COUNT]Bound{
    Bound{name: TLS_CELL, place: boundary.Place.cell{boundary.Cell{anchor: ?TLS_INDEX, offset: 0}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.CHPE_METADATA, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.METADATA, offset: 0}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.LOAD_CONFIG_USED, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.LOAD_CONFIG, offset: 0}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.CALL_NO_REDIRECT, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 0}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.DISPATCH_RET, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 8}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.CHECK_CALL, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 16}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.CHECK_ICALL, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 24}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.CHECK_ICALL_CFG, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 32}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.GET_X64_INFORMATION, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 40}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.SET_X64_INFORMATION, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 48}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.DISPATCH_FPTR, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 56}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER0, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 64}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER1, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 72}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER2, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 80}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER3, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 88}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER4, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 96}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER5, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 104}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER6, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 112}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER7, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 120}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER8, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 128}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
};
pub val BOUNDS: boundary.Bounds = boundary.Bounds{rows: ?BOUND_ROWS[0], count: BOUND_COUNT};

# the bounds of the callback array of an image that supplies its own TLS
# directory, made once collection has run
pub val CALLBACK_BOUNDS: synthesizer.Row = synthesizer.Row{
    name:       "thread-local callback bounds",
    stage:      ?synthesizer.AFTER_COLLECT,
    needs:      arch.ADDRESSED,
    kinds:      ?EXECUTABLES[0],
    kind_count: EXECUTABLE_COUNT,
    make:       callback_bounds,
};

# the PE tables the linker makes: the base relocations, the import tables,
# the TLS directory and index cell, the resource tree and the export table
pub val TABLES: Declarer = Declarer{declare: declare};

val MEASURE_COUNT: usize                   = 8;
val MEASURES_ROWS: [MEASURE_COUNT]Measured = [MEASURE_COUNT]Measured{
    Measured{key: ?reserve.HEADERS, measure: headers},
    Measured{key: ?BASE_RELOCATIONS, measure: base_relocations},
    Measured{key: ?IMPORT_TABLES, measure: import_tables},
    Measured{key: ?TLS_DIRECTORY, measure: tls_directory},
    Measured{key: ?RESOURCES, measure: resource_tree},
    Measured{key: ?EXPORT_TABLE, measure: export_table},
    Measured{key: ?coff_hybrid.TABLES, measure: coff_hybrid.measure_tables},
    Measured{key: ?coff_hybrid.FAST_FORWARDS, measure: coff_hybrid.measure_forwards},
};
pub val MEASURES: Measures = Measures{rows: ?MEASURES_ROWS[0], count: MEASURE_COUNT};

# the optional header layout of an image for `a`, the one as wide as its
# addresses
fun width_of(a: *Arch) res[*Width, Fail] {
    val opt_bytes: opt[u8] = arch.pointer_bytes(a);
    if (sel opt_bytes.none) { ret res[*Width, Fail].err{fail.about(fail.unsupported("the architecture states no address width"), a.name)}; }
    var i: usize = 0;
    for (i < WIDTH_COUNT) {
        if (WIDTHS[i].shape.addr == opt_bytes.some::usize) { ret res[*Width, Fail].ok{?WIDTHS[i]}; }
        i = i + 1;
    }
    ret res[*Width, Fail].err{fail.about(fail.unsupported("PE has no image layout as wide as the architecture's addresses"), a.name)};
}

# whether the loader may place an image of kind `k` anywhere, so it holds
# base relocations
fun relocatable(k: *Kind) bool {
    ret output.has(k, output.PIC);
}

# whether output section `m` is a section of the image: loaded, and holding a
# byte
fun kept(m: *Merged) bool {
    ret sel m.segment.some && m.size != 0;
}

# how many sections the laid out `l` holds: its kept output sections
fun section_count(l: *Layout) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < vector.length[Id[Merged]](?l.order)) {
        if (kept(table.at[Merged](?l.merged, l.order.data[i]))) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the bytes the headers of an image of layout `w` with `count` sections take:
# the MS-DOS header and program, the PE signature, the file header, the
# optional header with its data directories and the section table
fun header_size(w: *Width, count: usize) res[u64, Fail] {
    val at:        Location       = Location{record: "headers"};
    val res_table: res[u64, Fail] = checked.mul(at, count::u64, model.SECTION_SIZE);
    if (sel res_table.err) { ret res_table; }
    val fixed: u64 = DOS_SIZE + SIGNATURE_SIZE + FILE_HEADER + optional_size(w);
    ret checked.add(at, fixed, res_table.ok);
}

fun optional_size(w: *Width) u64 {
    ret w.shape.size::u64 + DIRECTORIES::u64 * model.DIRECTORY_SIZE;
}

# the headers of the laid out image `img`
fun headers(img: *Image) res[u64, Fail] {
    val res_width_of: res[*Width, Fail] = width_of(img.target.arch);
    if (sel res_width_of.err) { ret res[u64, Fail].err{res_width_of.err}; }
    ret header_size(res_width_of.ok, section_count(img.layout));
}

# the image being built
# ---
# img:        the image record
# width:      its optional header layout
# m:          the model
# base:       the image base
# file:       the file alignment
# align:      the section alignment
# size:       the bytes the headers take
# end:        the end of the last section in memory, an address
# tail:       the end of the last section's bytes in the file
# machine:    the architecture's COFF machine
# reloc:      the output section of .reloc, none in an image at a fixed address
# dir:        the base relocation directory
# exceptions: the exception directory, zero where the image holds no
#             function table
# imports:    the import directory, zero where the image imports nothing
# iat:        the import address table directory, zero where the image
#             imports nothing
# tls:        the TLS directory, zero where the image holds no thread-local
#             data
# resources:  the resource directory, zero where the image holds no
#             resources
# exports:    the export directory, zero where the image exports nothing
# load:       the load configuration directory, zero where the image states
#             none
# tiles:      where each piece the writer lays in place of an output
#             section's bytes lies, by output section and offset
# pieces:     those pieces, until a section takes them
# names:      the string table of the section names a header cannot hold
# long:       the sections whose names lie in it
rec Build {
    a:          *A.Allocator;
    img:        *Image;
    width:      *Width;
    machine:    u16;
    m:          Coff;
    base:       u64;
    file:       u64;
    align:      u64;
    size:       u64;
    end:        u64;
    tail:       u64;
    reloc:      opt[Id[Merged]];
    dir:        DataDirectory;
    exceptions: DataDirectory;
    imports:    DataDirectory;
    iat:        DataDirectory;
    tls:        DataDirectory;
    resources:  DataDirectory;
    exports:    DataDirectory;
    load:       DataDirectory;
    tiles:      Vector[Tile];
    pieces:     Table[Piece];
    names:      Strtab;
    long:       Vector[Long];
}

# a section whose name lies in the string table
# ---
# section: the section
# name:    its name there
rec Long {
    section: Id[model.Section];
    name:    Id[Name];
}

# a piece the writer lays in an output section in place of its bytes
# ---
# merged: the output section
# offset: where in it the piece starts
# size:   the bytes it takes
# piece:  its index among the pieces
rec Tile {
    merged: Id[Merged];
    offset: u64;
    size:   u64;
    piece:  u32;
}

# write the image `img` as a PE executable
fun write(a: *A.Allocator, img: *Image) res[Sink, Fail] {
    val res_width_of: res[*Width, Fail] = width_of(img.target.arch);
    if (sel res_width_of.err) { ret res[Sink, Fail].err{res_width_of.err}; }
    var b: Build = Build{
        a:      a,
        img:    img,
        width:  res_width_of.ok,
        m:      model.init(a, Shape{object: ?model.REGULAR, image: opt[*ImageShape].some{res_width_of.ok.shape}}),
        base:   img.layout.base,
        file:   coff_convention.LAYOUT.file_align,
        align:  coff_convention.LAYOUT.section_align,
        tiles:  vector.init[Tile](a),
        pieces: table.init[Piece](a),
        names:  strtab.init(a, coff_neutral.STRINGS),
        long:   vector.init[Long](a),
    };
    b.m.optional = Optional.image{model.image_init(a)};
    var res_out:   res[Sink, Fail] = res[Sink, Fail].err{fail.internal("the image was not written")};
    val err_build: err[Fail]       = build(?b);
    if (sel err_build.err) { res_out = res[Sink, Fail].err{err_build.err}; }
    or                     { res_out = coff_write.write(a, ?b.m); }
    var err_rel: err[Fail] = model.dnit(?b.m);
    err_rel = fail.kept(err_rel, model.pieces_dnit(?b.pieces));
    err_rel = fail.kept(err_rel, vectors.dnit[Tile](?b.tiles));
    err_rel = fail.kept(err_rel, strtab.dnit(?b.names));
    err_rel = fail.kept(err_rel, vectors.dnit[Long](?b.long));
    if (sel res_out.err) { ret res_out; }
    if (sel err_rel.err) {
        var got:         Sink      = res_out.ok;
        val err_release: err[Fail] = sink.dnit(?got);
        ret res[Sink, Fail].err{err_rel.err};
    }
    ret res_out;
}

fun build(b: *Build) err[Fail] {
    val err_needs: err[Fail] = needs(b.img);
    if (sel err_needs.err)        { ret err_needs; }
    if (b.base % BASE_ALIGN != 0) { ret err[Fail].err{fail.of_option(fail.valued(fail.about(fail.malformed("the image base is not a multiple of 64 KiB"), b.img.host.sys.name), b.base::i128), options.BASE)}; }
    val res_header_size: res[u64, Fail] = header_size(b.width, section_count(b.img.layout));
    if (sel res_header_size.err)                   { ret err[Fail].err{res_header_size.err}; }
    if (res_header_size.ok != b.img.layout.header) { ret err[Fail].err{fail.internal("the headers are not the size layout left for them")}; }
    b.size = res_header_size.ok;
    val res_reloc_of: res[opt[Id[Merged]], Fail] = reloc_of(b.img);
    if (sel res_reloc_of.err) { ret err[Fail].err{res_reloc_of.err}; }
    b.reloc = res_reloc_of.ok;
    val res_machine_of: res[u16, Fail] = machine_of(b.img.target.arch);
    if (sel res_machine_of.err) { ret err[Fail].err{res_machine_of.err}; }
    b.machine = res_machine_of.ok;
    val err_imports_out: err[Fail] = imports_out(b);
    if (sel err_imports_out.err) { ret err_imports_out; }
    val err_tls_out: err[Fail] = tls_out(b);
    if (sel err_tls_out.err) { ret err_tls_out; }
    val err_resources_out: err[Fail] = resources_out(b);
    if (sel err_resources_out.err) { ret err_resources_out; }
    val err_exports_out: err[Fail] = exports_out(b);
    if (sel err_exports_out.err) { ret err_exports_out; }
    val err_hybrid_out: err[Fail] = hybrid_out(b);
    if (sel err_hybrid_out.err) { ret err_hybrid_out; }
    val err_load_config_out: err[Fail] = load_config_out(b);
    if (sel err_load_config_out.err) { ret err_load_config_out; }
    sort.sort_by[Tile](b.tiles.data, vector.length[Tile](?b.tiles), order_tile);
    val err_sections_out: err[Fail] = sections_out(b);
    if (sel err_sections_out.err) { ret err_sections_out; }
    val err_names_out: err[Fail] = names_out(b);
    if (sel err_names_out.err) { ret err_names_out; }
    val err_header_out: err[Fail] = header_out(b);
    if (sel err_header_out.err) { ret err_header_out; }
    val err_optional_out: err[Fail] = optional_out(b);
    if (sel err_optional_out.err) { ret err_optional_out; }
    ret extents_out(b);
}

# refuse a link that needs what the image does not hold yet: a delay loaded
# import, a DLL it loads and imports nothing from or thread-local data in a
# DLL, and a DLL that refers to what nothing defines, which no loader binds
fun needs(img: *Image) err[Fail] {
    val d:       *Dynamic      = img.dynamic;
    val delayed: *Table[Entry] = dynamic.entries_of(d, ?slot.DELAY_IAT);
    if (table.count[Entry](delayed) != 0) {
        val aim: dynamic.Aim = table.at[Entry](delayed, table.nth[Entry](0)).aim;
        val no:  Fail        = fail.unsupported("a PE image does not delay load an import yet");
        if (sel aim.imported) { ret err[Fail].err{fail.in_indexed(no, "import", aim.imported.index::u64)}; }
        ret err[Fail].err{no};
    }
    var i: usize = 0;
    for (i < table.count[dynamic.Library](?d.libraries)) {
        val l: *dynamic.Library = table.at[dynamic.Library](?d.libraries, table.nth[dynamic.Library](i));
        if (l.loaded && sel l.rank.none) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a PE image loads no DLL it imports nothing from"), "library", i::u64)}; }
        i = i + 1;
    }
    val opt_tls: opt[layout.Tls] = img.layout.tls;
    if (sel opt_tls.some && output.has(img.kind, output.LOADED)) { ret err[Fail].err{fail.unsupported("a DLL does not hold thread-local data yet")}; }
    if (vector.length[resolve.Reference](?img.resolved.undefined) != 0) {
        val first: *resolve.Reference = ?img.resolved.undefined.data[0];
        ret err[Fail].err{fail.in_file(fail.malformed("a PE image refers to a symbol nothing defines, which no loader binds"), input.at(img.inputs, first.input).name)};
    }
    if (vector.length[Site](?img.sites.list) != 0 && !relocatable(img.kind)) {
        ret err[Fail].err{fail.internal("an image at a fixed address holds relocations for a loader")};
    }
    ret err[Fail].ok{};
}

# the offset of `address` from the image base, which a 32-bit field holds
fun rva_of(b: *Build, address: u64, record: str, index: u64) res[u32, Fail] {
    if (address < b.base || address - b.base > 0xffff_ffff) {
        ret res[u32, Fail].err{fail.valued(fail.in_indexed(fail.overflow("an address lies outside the 4 GiB above the image base"), record, index), address::i128)};
    }
    ret res[u32, Fail].ok{(address - b.base)::u32};
}

fun narrow(v: u64, record: str, index: u64) res[u32, Fail] {
    if (v > 0xffff_ffff) { ret res[u32, Fail].err{fail.valued(fail.in_indexed(fail.overflow("a section passes the 4 GiB its header counts"), record, index), v::i128)}; }
    ret res[u32, Fail].ok{v::u32};
}

# push section `s` into the model, releasing it when the model cannot hold it
fun push(b: *Build, s: model.Section) err[Fail] {
    var h:                   model.Section                = s;
    val res_sections_pushed: res[Id[model.Section], Fail] = table.push[model.Section](?b.m.sections, h);
    if (sel res_sections_pushed.err) {
        val err_relocs: err[Fail] = table.dnit[model.Reloc](?h.relocs);
        val err_lines:  err[Fail] = table.dnit[model.Line](?h.lines);
        if (sel h.body.tiled) {
            val err_tiles: err[Fail] = model.pieces_dnit(?h.body.tiled);
        }
        ret err[Fail].err{res_sections_pushed.err};
    }
    ret err[Fail].ok{};
}

# a section for every kept output section, in image order
fun sections_out(b: *Build) err[Fail] {
    val l:        *Layout        = b.img.layout;
    val at:       Location       = Location{record: "headers"};
    val res_tail: res[u64, Fail] = checked.align_up(at, b.size, b.file);
    if (sel res_tail.err) { ret err[Fail].err{res_tail.err}; }
    val res_end: res[u64, Fail] = checked.align_up(at, b.base + b.size, b.align);
    if (sel res_end.err) { ret err[Fail].err{res_end.err}; }
    b.tail = res_tail.ok;
    b.end  = res_end.ok;
    var i: usize = 0;
    for (i < vector.length[Id[Merged]](?l.order)) {
        val id: Id[Merged] = l.order.data[i];
        val m:  *Merged    = table.at[Merged](?l.merged, id);
        if (kept(m)) {
            val err_section_out: err[Fail] = section_out(b, id, m);
            if (sel err_section_out.err) { ret err[Fail].err{fail.in_indexed(err_section_out.err, "output section", i::u64)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun section_out(b: *Build, id: Id[Merged], m: *Merged) err[Fail] {
    val v:    View     = intern.bytes_of(b.img.names, m.name);
    val long: bool     = v.len > 8 || (v.len != 0 && v.data[0] == '/');
    var name: Id[Name] = Id[Name]{};
    if (long) {
        if (coff_neutral.holds_nul(v)) { ret err[Fail].err{fail.malformed("an image section's name holds a NUL byte")}; }
        val res_names_added: res[Id[Name], Fail] = strtab.add(?b.names, v.data, v.len);
        if (sel res_names_added.err) { ret err[Fail].err{res_names_added.err}; }
        name = res_names_added.ok;
    }
    val res_rva: res[u32, Fail] = rva_of(b, m.address, "output section", m.position::u64);
    if (sel res_rva.err) { ret err[Fail].err{res_rva.err}; }
    val res_size: res[u32, Fail] = narrow(m.size, "output section", m.position::u64);
    if (sel res_size.err) { ret err[Fail].err{res_size.err}; }
    var s: model.Section = model.section_init(b.a);
    var k: usize         = 0;
    for (!long && k < v.len) {
        s.name[k] = v.data[k];
        k         = k + 1;
    }
    s.virtual_size    = res_size.ok;
    s.virtual_address = res_rva.ok;
    s.flags           = coff_neutral.contents_of(section.key_of(m.kind, m.entsize), m.flags)::u32;
    val at: Location = Location{record: "output section", index: m.position::u64, indexed: true};
    if (section.has(m.kind, section.BITS)) {
        val res_raw: res[u64, Fail] = checked.align_up(at, m.size, b.file);
        if (sel res_raw.err) { ret err[Fail].err{res_raw.err}; }
        val res_narrow: res[u32, Fail] = narrow(res_raw.ok, "output section", m.position::u64);
        if (sel res_narrow.err) { ret err[Fail].err{res_narrow.err}; }
        val res_narrow_offset: res[u32, Fail] = narrow(m.offset, "output section", m.position::u64);
        if (sel res_narrow_offset.err) { ret err[Fail].err{res_narrow_offset.err}; }
        if (m.offset < b.tail)         { ret err[Fail].err{fail.internal("an output section's bytes overlap what lies before them")}; }
        var res_body: res[Body, Fail] = res[Body, Fail].err{fail.internal("the section's bytes were not made")};
        if (holds_reloc(b, id)) {
            res_body = reloc_body(b, m, res_raw.ok);
            s.flags  = RELOC_CHARACTERISTICS::u32;
            b.dir    = DataDirectory{rva: res_rva.ok, size: res_size.ok};
        }
        or (tiled(b, id)) {
            res_body = tiled_body(b, id, m, res_raw.ok);
        }
        or (m.kind == ?section.FUNCTION_TABLE && coff_hybrid.joined(b.img.target.arch) && !coff_hybrid.x64_functions(b.img, m)) {
            res_body = exceptions_body(b, m, res_raw.ok, b.machine);
        }
        or (m.kind == ?section.FUNCTION_TABLE) {
            if (b.exceptions.size != 0) { ret err[Fail].err{fail.unsupported("an image holds function tables in two output sections")}; }
            val res_header_machine: res[u16, Fail] = header_machine(b.img.target.arch);
            if (sel res_header_machine.err) { ret err[Fail].err{res_header_machine.err}; }
            res_body     = exceptions_body(b, m, res_raw.ok, res_header_machine.ok);
            b.exceptions = DataDirectory{rva: res_rva.ok, size: res_size.ok};
        }
        or {
            res_body = file_bytes(b, m.offset, res_raw.ok);
        }
        if (sel res_body.err) { ret err[Fail].err{res_body.err}; }
        s.raw_size = res_narrow.ok;
        s.raw_ptr  = res_narrow_offset.ok;
        s.body     = res_body.ok;
        b.tail     = m.offset + res_raw.ok;
    }
    val res_end: res[u64, Fail] = checked.add(at, m.address, m.size);
    if (sel res_end.err)    { ret err[Fail].err{res_end.err}; }
    if (res_end.ok > b.end) { b.end = res_end.ok; }
    val here:       Id[model.Section] = table.nth[model.Section](table.count[model.Section](?b.m.sections));
    val err_pushed: err[Fail]         = push(b, s);
    if (sel err_pushed.err || !long) { ret err_pushed; }
    val err_long_pushed: err[Fail] = vectors.push[Long](?b.long, Long{section: here, name: name});
    if (sel err_long_pushed.err) { ret err[Fail].err{err_long_pushed.err}; }
    ret err[Fail].ok{};
}

# finish the string table and name each section whose name lies in it
fun names_out(b: *Build) err[Fail] {
    if (vector.length[Long](?b.long) == 0) { ret err[Fail].ok{}; }
    val err_finish: err[Fail] = strtab.finish(?b.names);
    if (sel err_finish.err) { ret err_finish; }
    var i: usize = 0;
    for (i < vector.length[Long](?b.long)) {
        val l:             *Long     = ?b.long.data[i];
        val at:            u64       = strtab.offset(?b.names, l.name) + 4;
        val err_long_name: err[Fail] = coff_neutral.long_name(model.section_at(?b.m, l.section), at);
        if (sel err_long_name.err) { ret err_long_name; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the string table after every section's bytes, at `at`, behind a symbol
# table of no symbols, where a section's name lies in it
fun strings_out(b: *Build, at: u64) err[Fail] {
    if (vector.length[Long](?b.long) == 0) { ret err[Fail].ok{}; }
    val res_ptr: res[u32, Fail] = narrow(at, "string table", 0);
    if (sel res_ptr.err) { ret err[Fail].err{res_ptr.err}; }
    b.m.header.symtab_ptr = res_ptr.ok;
    b.m.header.nsymbols   = 0;
    var out:       Sink            = sink.init(b.a, LITTLE);
    val err_write: err[Fail]       = strtab.write(?b.names, ?out);
    var res_held:  res[Held, Fail] = res[Held, Fail].err{fail.internal("the string table was not made")};
    if (sel err_write.ok) { res_held = model.own(?b.m, sink.data(?out), sink.len(?out)); }
    val err_release: err[Fail] = sink.dnit(?out);
    if (sel err_write.err)   { ret err_write; }
    if (sel res_held.err)    { ret err[Fail].err{res_held.err}; }
    if (sel err_release.err) { ret err_release; }
    ret extent(b, Extent.strings{res_held.ok});
}

# whether output section `id` is .reloc
fun holds_reloc(b: *Build, id: Id[Merged]) bool {
    val opt_reloc: opt[Id[Merged]] = b.reloc;
    ret sel opt_reloc.some && opt_reloc.some.index == id.index;
}

# the `n` bytes of the file at `offset`: the relocated bytes, borrowed, or a
# copy of them padded with zeros past their end
fun file_bytes(b: *Build, offset: u64, n: u64) res[Body, Fail] {
    val rel:   *Vector[u8] = ?b.img.relocated.bytes;
    val count: u64         = vector.length[u8](rel)::u64;
    if (offset > count) { ret res[Body, Fail].err{fail.internal("an output section lies past the relocated bytes")}; }
    val base: *u8 = ?rel.data[offset::usize];
    if (offset + n <= count) {
        ret res[Body, Fail].ok{Body.raw{Raw{bytes: Held.borrowed{Bytes{data: base, len: n::usize}}, why: Why.opaque{}}}};
    }
    var copy:      Sink      = sink.init(b.a, LITTLE);
    var err_bytes: err[Fail] = sink.bytes(?copy, base, (count - offset)::usize);
    err_bytes = fail.kept(err_bytes, sink.zeros(?copy, (offset + n - count)::usize));
    var res_held: res[Held, Fail] = res[Held, Fail].err{fail.internal("the section was not copied")};
    if (sel err_bytes.ok) { res_held = model.own(?b.m, sink.data(?copy), sink.len(?copy)); }
    val err_release: err[Fail] = sink.dnit(?copy);
    if (sel err_bytes.err)   { ret res[Body, Fail].err{err_bytes.err}; }
    if (sel res_held.err)    { ret res[Body, Fail].err{res_held.err}; }
    if (sel err_release.err) { ret res[Body, Fail].err{err_release.err}; }
    ret res[Body, Fail].ok{Body.raw{Raw{bytes: res_held.ok, why: Why.opaque{}}}};
}

# `n` zero bytes the model holds
fun zeros(b: *Build, n: u64) res[Held, Fail] {
    var z:         Sink            = sink.init(b.a, LITTLE);
    val err_zeros: err[Fail]       = sink.zeros(?z, n::usize);
    var res_held:  res[Held, Fail] = res[Held, Fail].err{fail.internal("the zeros were not made")};
    if (sel err_zeros.ok) { res_held = model.own(?b.m, sink.data(?z), sink.len(?z)); }
    val err_release: err[Fail] = sink.dnit(?z);
    if (sel err_zeros.err)   { ret res[Held, Fail].err{err_zeros.err}; }
    if (sel res_held.err)    { ret res_held; }
    if (sel err_release.err) { ret res[Held, Fail].err{err_release.err}; }
    ret res_held;
}

fun order_rva(x: *u64, y: *u64) i64 {
    if (@x < @y) { ret -1; }
    if (@x > @y) { ret 1; }
    ret 0;
}

# the base relocation blocks of the `n` image offsets at `rvas`, ascending,
# each of `type`, into `out`: one block per page, each entry the type in its
# high four bits and the offset in the page below, an entry of type zero
# padding a block to a multiple of four bytes
fun blocks(a: *A.Allocator, rvas: *u64, n: usize, type: u64, out: *Vector[RelocBlock]) err[Fail] {
    var i: usize = 0;
    for (i < n) {
        val rva:  u64 = rvas[i];
        val page: u64 = rva & ~(BLOCK_PAGE - 1);
        if (rva > 0xffff_ffff) { ret err[Fail].err{fail.valued(fail.overflow("a base relocation lies past 4 GiB of the image base"), rva::i128)}; }
        var count: usize = vector.length[RelocBlock](out);
        if (count == 0 || out.data[count - 1].page_rva::u64 != page) {
            if (count != 0) {
                val err_padded: err[Fail] = padded(?out.data[count - 1]);
                if (sel err_padded.err) { ret err_padded; }
            }
            val err_out_pushed: err[Fail] = vectors.push[RelocBlock](out, RelocBlock{page_rva: page::u32, entries: vector.init[u16](a)});
            if (sel err_out_pushed.err) { ret err[Fail].err{err_out_pushed.err}; }
            count = count + 1;
        }
        val err_data_pushed: err[Fail] = vectors.push[u16](?out.data[count - 1].entries, ((type << BLOCK_TYPE) | (rva - page))::u16);
        if (sel err_data_pushed.err) { ret err[Fail].err{err_data_pushed.err}; }
        i = i + 1;
    }
    val count: usize = vector.length[RelocBlock](out);
    if (count != 0) { ret padded(?out.data[count - 1]); }
    ret err[Fail].ok{};
}

fun padded(k: *RelocBlock) err[Fail] {
    if (vector.length[u16](?k.entries) % 2 == 0) { ret err[Fail].ok{}; }
    val err_entries_pushed: err[Fail] = vectors.push[u16](?k.entries, (tables.IMAGE_REL_BASED_ABSOLUTE.value << BLOCK_TYPE)::u16);
    if (sel err_entries_pushed.err) { ret err[Fail].err{err_entries_pushed.err}; }
    ret err[Fail].ok{};
}

fun blocks_dnit(t: *Vector[RelocBlock]) err[Fail] {
    var err_first: err[Fail] = err[Fail].ok{};
    var i:         usize     = 0;
    for (i < vector.length[RelocBlock](t)) {
        err_first = fail.kept(err_first, vectors.dnit[u16](?t.data[i].entries));
        i         = i + 1;
    }
    ret fail.kept(err_first, vectors.dnit[RelocBlock](t));
}

# the base relocation blocks of the `n` image addresses at `addresses`, each
# of `type`, into `out`, in address order
fun based(a: *A.Allocator, base: u64, addresses: *u64, n: usize, type: u64, out: *Vector[RelocBlock]) err[Fail] {
    var rvas:        Vector[u64] = vector.init[u64](a);
    val err_offsets: err[Fail]   = offsets(base, addresses, n, ?rvas);
    var err_blocks:  err[Fail]   = err_offsets;
    if (sel err_offsets.ok) { err_blocks = blocks(a, rvas.data, n, type, out); }
    ret fail.kept(err_blocks, vectors.dnit[u64](?rvas));
}

# the offset of each of the `n` addresses at `addresses` from the image base
# `base`, ascending, into `out`
fun offsets(base: u64, addresses: *u64, n: usize, out: *Vector[u64]) err[Fail] {
    val err_grow: err[Fail] = vectors.grow[u64](out, n);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < n) {
        if (addresses[i] < base) { ret err[Fail].err{fail.valued(fail.internal("a base relocation lies below the image base"), addresses[i]::i128)}; }
        out.data[i] = addresses[i] - base;
        i           = i + 1;
    }
    sort.sort_by[u64](out.data, n, order_rva);
    ret err[Fail].ok{};
}

# the address of each loader relocation site of the laid out image `img`,
# into `out`, where layout put it
fun laid_sites(img: *Image, out: *Vector[u64]) err[Fail] {
    val list:     *Vector[Site] = ?img.sites.list;
    val err_grow: err[Fail]     = vectors.grow[u64](out, vector.length[Site](list));
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < vector.length[Site](list)) {
        val s:           *Site     = ?list.data[i];
        val err_rebased: err[Fail] = rebased(s);
        if (sel err_rebased.err) { ret err[Fail].err{fail.in_indexed(err_rebased.err, "loader relocation site", i::u64)}; }
        val res_position: res[layout.Position, Fail] = sites.position(img.layout, img.pieces, img.reserved, s);
        if (sel res_position.err) { ret err[Fail].err{fail.in_indexed(res_position.err, "loader relocation site", i::u64)}; }
        out.data[i] = res_position.ok.address;
        i           = i + 1;
    }
    ret err[Fail].ok{};
}

# the address of each loader relocation site of the relocated image `img`,
# into `out`, as relocate filled it in
fun filled_sites(img: *Image, out: *Vector[u64]) err[Fail] {
    val err_filled: err[Fail] = sites.addressed(img.sites);
    if (sel err_filled.err) { ret err_filled; }
    val list:     *Vector[Site] = ?img.sites.list;
    val err_grow: err[Fail]     = vectors.grow[u64](out, vector.length[Site](list));
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < vector.length[Site](list)) {
        val s:           *Site     = ?list.data[i];
        val err_rebased: err[Fail] = rebased(s);
        if (sel err_rebased.err) { ret err[Fail].err{fail.in_indexed(err_rebased.err, "loader relocation site", i::u64)}; }
        out.data[i] = s.address;
        i           = i + 1;
    }
    ret err[Fail].ok{};
}

# refused for a site the loader binds or one holding a thread pointer
# offset, which a base relocation cannot state
fun rebased(s: *Site) err[Fail] {
    if (sel s.kind.bind) { ret err[Fail].err{fail.internal("a PE image binds an address only in its import address table, never at a loader relocation site")}; }
    if (s.thread)        { ret err[Fail].err{fail.internal("a PE base relocation moves an address, never a thread pointer offset")}; }
    ret err[Fail].ok{};
}

# the bytes the base relocations of the laid out image `img` take, its sites
# grouped by page
fun base_relocations(img: *Image) res[u64, Fail] {
    val res_width_of: res[*Width, Fail] = width_of(img.target.arch);
    if (sel res_width_of.err) { ret res[u64, Fail].err{res_width_of.err}; }
    val a:                *A.Allocator       = img.inputs.a;
    var at:               Vector[u64]        = vector.init[u64](a);
    var made:             Vector[RelocBlock] = vector.init[RelocBlock](a);
    val err_laid_sites:   err[Fail]          = laid_sites(img, ?at);
    var err_hybrid_sites: err[Fail]          = err_laid_sites;
    if (sel err_laid_sites.ok) { err_hybrid_sites = hybrid_sites(img, ?at); }
    var err_based: err[Fail] = err_hybrid_sites;
    if (sel err_hybrid_sites.ok) { err_based = based(a, img.layout.base, at.data, vector.length[u64](?at), res_width_of.ok.based.value, ?made); }
    val size: u64 = model.blocks_len(?made);
    err_based = fail.kept(err_based, vectors.dnit[u64](?at));
    err_based = fail.kept(err_based, blocks_dnit(?made));
    if (sel err_based.err) { ret res[u64, Fail].err{err_based.err}; }
    ret res[u64, Fail].ok{size};
}

# reserve .reloc in an image the loader may place anywhere, measured once
# addresses are known and laid out last, in a segment of its own, the import
# tables of an image that imports, in .idata where the import address table
# lies, the TLS directory and index cell of an image that supplies its own,
# the resource tree of an image whose inputs carry resources and the export
# table of a DLL whose inputs state exports
fun declare(in: *reserve.In, out: *Reserved) err[Fail] {
    if (table.count[Entry](dynamic.entries_of(in.dynamic, ?slot.IAT)) != 0) {
        val opt_pointer_bytes: opt[u8] = arch.pointer_bytes(in.arch);
        if (sel opt_pointer_bytes.none) { ret err[Fail].err{fail.about(fail.unsupported("the architecture states no address width"), in.arch.name)}; }
        val res_declare: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
            name:      coff_convention.IDATA,
            kind:      ?section.RELRO_DATA,
            flags:     section.ALLOC | section.WRITE,
            align:     opt_pointer_bytes.some::u64,
            sizing:    reserve.Sizing.measured{?IMPORT_TABLES},
            placement: reserve.Placement.region_end{?reserve.RELRO_END},
            limit:     0xffff_ffff,
            reason:    "the import tables pass 4 GiB",
        });
        if (sel res_declare.err) { ret err[Fail].err{res_declare.err}; }
    }
    val err_declare_tls: err[Fail] = declare_tls(in, out);
    if (sel err_declare_tls.err) { ret err_declare_tls; }
    val err_declare_resources: err[Fail] = declare_resources(in, out);
    if (sel err_declare_resources.err) { ret err_declare_resources; }
    val err_declare_exports: err[Fail] = declare_exports(in, out);
    if (sel err_declare_exports.err) { ret err_declare_exports; }
    val err_declare: err[Fail] = coff_hybrid.declare(in, out);
    if (sel err_declare.err)   { ret err_declare; }
    if (!relocatable(in.kind)) { ret err[Fail].ok{}; }
    val res_declare: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
        name:      RELOC_NAME,
        kind:      ?section.RODATA,
        flags:     section.ALLOC,
        align:     BLOCK_ALIGN,
        sizing:    reserve.Sizing.measured{?BASE_RELOCATIONS},
        placement: reserve.Placement.own_segment{"base relocations"},
        limit:     0xffff_ffff,
        reason:    "the base relocations pass 4 GiB",
    });
    if (sel res_declare.err) { ret err[Fail].err{res_declare.err}; }
    ret err[Fail].ok{};
}

# the output section layout put .reloc in, none when the image reserved none
fun reloc_of(img: *Image) res[opt[Id[Merged]], Fail] {
    val opt_measured_of: opt[Id[Reservation]] = measured_of(img, ?BASE_RELOCATIONS);
    if (sel opt_measured_of.none) { ret res[opt[Id[Merged]], Fail].ok{opt[Id[Merged]].none{}}; }
    val res_placed_of: res[Placed, Fail] = placed_of(img, opt_measured_of.some);
    if (sel res_placed_of.err) { ret res[opt[Id[Merged]], Fail].err{res_placed_of.err}; }
    ret res[opt[Id[Merged]], Fail].ok{opt[Id[Merged]].some{res_placed_of.ok.merged}};
}

# the table the image reserved measured by `key`, none when it reserved none
fun measured_of(img: *Image, key: *reserve.Measure) opt[Id[Reservation]] {
    var i: usize = 0;
    for (i < table.count[Reservation](?img.reserved.tables)) {
        val opt_measure: opt[*reserve.Measure] = table.at[Reservation](?img.reserved.tables, table.nth[Reservation](i)).measure;
        if (sel opt_measure.some && opt_measure.some == key) { ret opt[Id[Reservation]].some{table.nth[Reservation](i)}; }
        i = i + 1;
    }
    ret opt[Id[Reservation]].none{};
}

# where layout put the reserved table `t`, which lies in an output section
fun placed_of(img: *Image, t: Id[Reservation]) res[Placed, Fail] {
    if (t.index::usize >= vector.length[Spot](?img.layout.tables)) { ret res[Placed, Fail].err{fail.internal("a reserved table was never placed")}; }
    val sp: Spot = img.layout.tables.data[t.index::usize];
    if (!sel sp.section) { ret res[Placed, Fail].err{fail.internal("a table the image fills lies in no output section")}; }
    ret res[Placed, Fail].ok{sp.section};
}

# the bytes of .reloc, `raw` in the file: the blocks of the link's loader
# relocation sites at the addresses relocate filled in, which are the size
# layout left for them, then zeros
fun reloc_body(b: *Build, m: *Merged, raw: u64) res[Body, Fail] {
    var at:               Vector[u64] = vector.init[u64](b.a);
    val err_filled_sites: err[Fail]   = filled_sites(b.img, ?at);
    if (sel err_filled_sites.err) {
        val err_dropped: err[Fail] = vectors.dnit[u64](?at);
        ret res[Body, Fail].err{err_filled_sites.err};
    }
    val n:                usize              = vector.length[u64](?at);
    var made:             Vector[RelocBlock] = vector.init[RelocBlock](b.a);
    val err_hybrid_sites: err[Fail]          = hybrid_sites(b.img, ?at);
    var err_based:        err[Fail]          = err_hybrid_sites;
    if (sel err_hybrid_sites.ok) { err_based = based(b.a, b.base, at.data, vector.length[u64](?at), b.width.based.value, ?made); }
    err_based = fail.kept(err_based, vectors.dnit[u64](?at));
    if (sel err_based.err) {
        val err_dropped: err[Fail] = blocks_dnit(?made);
        ret res[Body, Fail].err{err_based.err};
    }
    if (model.blocks_len(?made) != m.size) {
        val err_dropped: err[Fail] = blocks_dnit(?made);
        ret res[Body, Fail].err{fail.internal("the base relocations are not the size layout left for them")};
    }
    var tiles:            Table[Piece]         = table.init[Piece](b.a);
    val res_tiles_pushed: res[Id[Piece], Fail] = table.push[Piece](?tiles, Piece.relocations{made});
    if (sel res_tiles_pushed.err) {
        val err_dropped: err[Fail] = blocks_dnit(?made);
        ret res[Body, Fail].err{res_tiles_pushed.err};
    }
    val err_pad: err[Fail] = padding(b, ?tiles, raw - m.size);
    if (sel err_pad.err) {
        val err_dropped: err[Fail] = model.pieces_dnit(?tiles);
        ret res[Body, Fail].err{err_pad.err};
    }
    ret res[Body, Fail].ok{Body.tiled{tiles}};
}

# `n` zeros after the pieces `tiles`, none when `n` is zero
fun padding(b: *Build, tiles: *Table[Piece], n: u64) err[Fail] {
    if (n == 0) { ret err[Fail].ok{}; }
    val res_zeros: res[Held, Fail] = zeros(b, n);
    if (sel res_zeros.err) { ret err[Fail].err{res_zeros.err}; }
    val res_tiles_pushed: res[Id[Piece], Fail] = table.push[Piece](tiles, Piece.raw{Raw{bytes: res_zeros.ok, why: Why.opaque{}}});
    if (sel res_tiles_pushed.err) { ret err[Fail].err{res_tiles_pushed.err}; }
    ret err[Fail].ok{};
}

# the function table of output section `m`, `raw` in the file, in the layout
# of `machine`: its relocated entries sorted by where their functions start,
# then zeros. an ARM64EC image's native table is its x64 table's apart
fun exceptions_body(b: *Build, m: *Merged, raw: u64, machine: u16) res[Body, Fail] {
    val opt_function_table: opt[*FunctionTable] = model.function_table(machine::u64);
    if (sel opt_function_table.none) { ret res[Body, Fail].err{fail.about(fail.unsupported("the machine has no function table layout"), b.img.target.arch.name)}; }
    val size: u64 = model.entry_size(opt_function_table.some);
    if (m.size % size != 0) { ret res[Body, Fail].err{fail.valued(fail.malformed("a function table is not a whole number of entries"), m.size::i128)}; }
    val rel: *Vector[u8] = ?b.img.relocated.bytes;
    if (m.offset > vector.length[u8](rel)::u64 || m.size > vector.length[u8](rel)::u64 - m.offset) {
        ret res[Body, Fail].err{fail.internal("a function table lies past the relocated bytes")};
    }
    var r:               Reader                = reader.make("function table", ?rel.data[m.offset::usize], m.size::usize, LITTLE);
    val n:               usize                 = (m.size / size)::usize;
    var res_x64_entries: res[Exceptions, Fail] = res[Exceptions, Fail].err{fail.internal("the function table was not read")};
    if (opt_function_table.some.ended) { res_x64_entries = x64_entries(b.a, ?r, n); }
    or                                 { res_x64_entries = arm_entries(b.a, ?r, n); }
    if (sel res_x64_entries.err)       { ret res[Body, Fail].err{res_x64_entries.err}; }
    var tiles:            Table[Piece]         = table.init[Piece](b.a);
    val res_tiles_pushed: res[Id[Piece], Fail] = table.push[Piece](?tiles, Piece.exceptions{res_x64_entries.ok});
    if (sel res_tiles_pushed.err) {
        var lost:        Exceptions = res_x64_entries.ok;
        val err_dropped: err[Fail]  = exceptions_dnit(?lost);
        ret res[Body, Fail].err{res_tiles_pushed.err};
    }
    val err_pad: err[Fail] = padding(b, ?tiles, raw - m.size);
    if (sel err_pad.err) {
        val err_dropped: err[Fail] = model.pieces_dnit(?tiles);
        ret res[Body, Fail].err{err_pad.err};
    }
    ret res[Body, Fail].ok{Body.tiled{tiles}};
}

fun exceptions_dnit(e: *Exceptions) err[Fail] {
    if (sel e.x64) { ret vectors.dnit[RuntimeFunction](?e.x64); }
    ret vectors.dnit[RuntimeFunctionArm64](?e.arm64);
}

# the `n` entries that state where their functions end at `r`, sorted
fun x64_entries(a: *A.Allocator, r: *Reader, n: usize) res[Exceptions, Fail] {
    var tab:           Vector[RuntimeFunction] = vector.init[RuntimeFunction](a);
    val err_grow:      err[Fail]               = vectors.grow[RuntimeFunction](?tab, n);
    var err_x64_entry: err[Fail]               = err[Fail].ok{};
    if (sel err_grow.err) { err_x64_entry = err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (sel err_x64_entry.ok && i < n) {
        err_x64_entry = x64_entry(r, ?tab.data[i]);
        i             = i + 1;
    }
    if (sel err_x64_entry.err) {
        val err_dropped: err[Fail] = vectors.dnit[RuntimeFunction](?tab);
        ret res[Exceptions, Fail].err{err_x64_entry.err};
    }
    sort.sort_by[RuntimeFunction](tab.data, n, order_x64);
    ret res[Exceptions, Fail].ok{Exceptions.x64{tab}};
}

# the `n` entries of one unwind word at `r`, sorted, each word as written
fun arm_entries(a: *A.Allocator, r: *Reader, n: usize) res[Exceptions, Fail] {
    var tab:           Vector[RuntimeFunctionArm64] = vector.init[RuntimeFunctionArm64](a);
    val err_grow:      err[Fail]                    = vectors.grow[RuntimeFunctionArm64](?tab, n);
    var err_arm_entry: err[Fail]                    = err[Fail].ok{};
    if (sel err_grow.err) { err_arm_entry = err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (sel err_arm_entry.ok && i < n) {
        err_arm_entry = arm_entry(r, ?tab.data[i]);
        i             = i + 1;
    }
    if (sel err_arm_entry.err) {
        val err_dropped: err[Fail] = vectors.dnit[RuntimeFunctionArm64](?tab);
        ret res[Exceptions, Fail].err{err_arm_entry.err};
    }
    sort.sort_by[RuntimeFunctionArm64](tab.data, n, order_arm);
    ret res[Exceptions, Fail].ok{Exceptions.arm64{tab}};
}

fun x64_entry(r: *Reader, out: *RuntimeFunction) err[Fail] {
    val res_begin: res[u32, Fail] = reader.u32(r);
    if (sel res_begin.err) { ret err[Fail].err{res_begin.err}; }
    val res_end: res[u32, Fail] = reader.u32(r);
    if (sel res_end.err) { ret err[Fail].err{res_end.err}; }
    val res_unwind: res[u32, Fail] = reader.u32(r);
    if (sel res_unwind.err) { ret err[Fail].err{res_unwind.err}; }
    @out = RuntimeFunction{begin: res_begin.ok, end: res_end.ok, unwind: res_unwind.ok};
    ret err[Fail].ok{};
}

fun arm_entry(r: *Reader, out: *RuntimeFunctionArm64) err[Fail] {
    val res_begin: res[u32, Fail] = reader.u32(r);
    if (sel res_begin.err) { ret err[Fail].err{res_begin.err}; }
    val res_unwind: res[u32, Fail] = reader.u32(r);
    if (sel res_unwind.err) { ret err[Fail].err{res_unwind.err}; }
    @out = RuntimeFunctionArm64{begin: res_begin.ok, unwind: res_unwind.ok};
    ret err[Fail].ok{};
}

# entries by where their functions start, then by every other field, so equal
# starts sort the same in every link
fun order_x64(x: *RuntimeFunction, y: *RuntimeFunction) i64 {
    val k: i64 = order_u32(x.begin, y.begin);
    if (k != 0) { ret k; }
    val e: i64 = order_u32(x.end, y.end);
    if (e != 0) { ret e; }
    ret order_u32(x.unwind, y.unwind);
}

fun order_arm(x: *RuntimeFunctionArm64, y: *RuntimeFunctionArm64) i64 {
    val k: i64 = order_u32(x.begin, y.begin);
    if (k != 0) { ret k; }
    ret order_u32(x.unwind, y.unwind);
}

fun order_u32(x: u32, y: u32) i64 {
    if (x < y) { ret -1; }
    if (x > y) { ret 1; }
    ret 0;
}

# the COFF machine of architecture `a`
fun machine_of(a: *Arch) res[u16, Fail] {
    val opt_code: opt[*arch.Code] = arch.code(a, ?format.COFF);
    if (sel opt_code.none) { ret res[u16, Fail].err{fail.about(fail.unsupported("the architecture has no COFF machine"), a.name)}; }
    ret res[u16, Fail].ok{opt_code.some.fields[0].value::u16};
}

# the machine an image for `a` states in its file header: the machine of the
# architecture it joins where it joins one, as an ARM64EC image states
# AMD64 so a loader that knows no ARM64EC loads it as x64, else its own
# ("ARM64EC binaries", overview of ARM64EC ABI conventions)
fun header_machine(a: *Arch) res[u16, Fail] {
    val opt_joins: opt[*Arch] = a.joins;
    if (sel opt_joins.some) { ret machine_of(opt_joins.some); }
    ret machine_of(a);
}

# the file header: the architecture's machine, the sections, and the
# characteristics of an image of the layout and kind
fun header_out(b: *Build) err[Fail] {
    var ch: u64 = tables.IMAGE_FILE_EXECUTABLE_IMAGE.value | b.width.characteristics;
    if (!relocatable(b.img.kind))              { ch = ch | tables.IMAGE_FILE_RELOCS_STRIPPED.value; }
    if (output.has(b.img.kind, output.LOADED)) { ch = ch | tables.IMAGE_FILE_DLL.value; }
    b.m.signature = opt[u32].some{tables.PE_SIGNATURE.value::u32};
    val res_header_machine: res[u16, Fail] = header_machine(b.img.target.arch);
    if (sel res_header_machine.err) { ret err[Fail].err{res_header_machine.err}; }
    b.m.header.machine         = res_header_machine.ok;
    b.m.header.nsections       = table.count[model.Section](?b.m.sections)::u32;
    b.m.header.opt_size        = optional_size(b.width)::u16;
    b.m.header.characteristics = ch::u16;
    ret err[Fail].ok{};
}

# the system version the image states: the target's, else the host's, else
# SYSTEM
fun version_of(img: *Image) Version {
    val opt_version: opt[Version] = img.target.version;
    if (sel opt_version.some) { ret opt_version.some; }
    val opt_minos: opt[Version] = img.host.minos;
    if (sel opt_minos.some) { ret opt_minos.some; }
    ret SYSTEM;
}

# the optional header: where the image lies and starts, how its sections are
# aligned and sized, the system and subsystem it runs on, its
# characteristics, and its data directories
fun optional_out(b: *Build) err[Fail] {
    if (!sel b.m.optional.image) { ret err[Fail].err{fail.internal("the image has no optional header")}; }
    val img:       *Image         = b.img;
    val o:         *model.Image   = ?b.m.optional.image;
    val at:        Location       = Location{record: "optional header"};
    val res_start: res[u32, Fail] = entry_rva(b);
    if (sel res_start.err) { ret err[Fail].err{res_start.err}; }
    val opt_sub: opt[*Subsystem] = target.subsystem_on(img.target, img.host);
    if (sel opt_sub.none) { ret err[Fail].err{fail.of_option(fail.about(fail.malformed("the image states no subsystem and its system names none"), img.host.sys.name), options.SUBSYSTEM)}; }
    val res_image: res[u64, Fail] = checked.align_up(at, b.end, b.align);
    if (sel res_image.err) { ret err[Fail].err{res_image.err}; }
    val res_span: res[u32, Fail] = rva_of(b, res_image.ok, "image", 0);
    if (sel res_span.err) { ret err[Fail].err{res_span.err}; }
    val res_heads: res[u64, Fail] = checked.align_up(at, b.size, b.file);
    if (sel res_heads.err) { ret err[Fail].err{res_heads.err}; }
    var reserve: u64 = STACK_RESERVE;
    var commit:  u64 = STACK_COMMIT;
    if (sel img.reserve.some) { reserve = img.reserve.some; }
    if (sel img.commit.some)  { commit = img.commit.some; }
    if (commit > reserve) {
        var stated: fail.Option = options.STACK_COMMIT;
        if (sel img.commit.none) { stated = options.STACK_RESERVE; }
        ret err[Fail].err{fail.of_option(fail.valued(fail.in_record(fail.malformed("the stack the image commits passes the stack it reserves"), "optional header"), commit::i128), stated)};
    }
    var i: usize = 0;
    for (i < table.count[model.Section](?b.m.sections)) {
        val s: *model.Section = model.section_at(?b.m, table.nth[model.Section](i));
        val f: u64            = s.flags::u64;
        if ((f & tables.IMAGE_SCN_CNT_CODE.value) != 0) {
            if (o.code_size == 0) { o.code_base = s.virtual_address; }
            o.code_size = o.code_size + s.raw_size;
        }
        if ((f & tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value) != 0) {
            if (o.init_data_size == 0 && b.width.shape.data_base.width != 0) { o.data_base = s.virtual_address; }
            o.init_data_size = o.init_data_size + s.raw_size;
        }
        if ((f & tables.IMAGE_SCN_CNT_UNINITIALIZED_DATA.value) != 0) { o.uninit_data_size = o.uninit_data_size + s.virtual_size; }
        i = i + 1;
    }
    val v:   Version = version_of(img);
    var dll: u64     = EVERY_IMAGE;
    if (output.has(img.kind, output.ENTERED)) { dll = dll | APPLICATION; }
    if (relocatable(img.kind))                { dll = dll | tables.IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE.value | b.width.randomized; }
    o.magic             = b.width.shape.magic.value::u16;
    o.linker_major      = LINKER_MAJOR;
    o.linker_minor      = LINKER_MINOR;
    o.entry             = res_start.ok;
    o.image_base        = b.base;
    o.section_alignment = b.align::u32;
    o.file_alignment    = b.file::u32;
    o.os_major          = v.major;
    o.os_minor          = v.minor::u16;
    o.subsystem_major   = v.major;
    o.subsystem_minor   = v.minor::u16;
    o.image_size        = res_span.ok;
    o.headers_size      = res_heads.ok::u32;
    o.checksum          = Checksum.spec{0};
    o.subsystem         = opt_sub.some.number;
    o.dll_flags         = dll::u16;
    o.stack_reserve     = reserve;
    o.stack_commit      = commit;
    o.heap_reserve      = HEAP_RESERVE;
    o.heap_commit       = HEAP_COMMIT;
    o.trailing          = Raw{bytes: Held.borrowed{Bytes{data: nil, len: 0}}, why: Why.opaque{}};
    val err_grow: err[Fail] = vectors.grow[DataDirectory](?o.dirs, DIRECTORIES);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    o.dirs.data[tables.IMAGE_DIRECTORY_ENTRY_BASERELOC.value::usize]   = b.dir;
    o.dirs.data[tables.IMAGE_DIRECTORY_ENTRY_EXCEPTION.value::usize]   = b.exceptions;
    o.dirs.data[tables.IMAGE_DIRECTORY_ENTRY_IMPORT.value::usize]      = b.imports;
    o.dirs.data[tables.IMAGE_DIRECTORY_ENTRY_IAT.value::usize]         = b.iat;
    o.dirs.data[tables.IMAGE_DIRECTORY_ENTRY_TLS.value::usize]         = b.tls;
    o.dirs.data[tables.IMAGE_DIRECTORY_ENTRY_RESOURCE.value::usize]    = b.resources;
    o.dirs.data[tables.IMAGE_DIRECTORY_ENTRY_EXPORT.value::usize]      = b.exports;
    o.dirs.data[tables.IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG.value::usize] = b.load;
    ret err[Fail].ok{};
}

# the offset of the entry from the image base, zero for an image that starts
# at no entry, as a DLL may
fun entry_rva(b: *Build) res[u32, Fail] {
    val e: link_image.Entry = b.img.entry;
    if (sel e.none) { ret res[u32, Fail].ok{0}; }
    val res_entry: res[u64, Fail] = link_image.address_of(?b.img.entry);
    if (sel res_entry.err) { ret res[u32, Fail].err{res_entry.err}; }
    val res_forwarded: res[u64, Fail] = forwarded(b.img, res_entry.ok);
    if (sel res_forwarded.err) { ret res[u32, Fail].err{res_forwarded.err}; }
    ret rva_of(b, res_forwarded.ok, "entry", 0);
}

fun extent(b: *Build, e: Extent) err[Fail] {
    val err_extents_pushed: err[Fail] = vectors.push[Extent](?b.m.extents, e);
    if (sel err_extents_pushed.err) { ret err[Fail].err{err_extents_pushed.err}; }
    ret err[Fail].ok{};
}

# the MS-DOS header and program, the PE signature pointer naming the
# signature after them
fun dos(b: *Build) res[Held, Fail] {
    var d:             Sink            = sink.init(b.a, LITTLE);
    val err_dos_bytes: err[Fail]       = dos_bytes(?d);
    var res_held:      res[Held, Fail] = res[Held, Fail].err{fail.internal("the MS-DOS header was not made")};
    if (sel err_dos_bytes.ok) { res_held = model.own(?b.m, sink.data(?d), sink.len(?d)); }
    val err_release: err[Fail] = sink.dnit(?d);
    if (sel err_dos_bytes.err) { ret res[Held, Fail].err{err_dos_bytes.err}; }
    if (sel res_held.err)      { ret res_held; }
    if (sel err_release.err)   { ret res[Held, Fail].err{err_release.err}; }
    ret res_held;
}

# the header's magic, the bytes in its last page, its pages, the
# paragraphs of the header, where its relocations would start and the PE
# signature pointer, then the program
fun dos_bytes(d: *Sink) err[Fail] {
    val lfanew:  usize     = tables.LFANEW_OFFSET.value::usize;
    var err_u16: err[Fail] = sink.u16(d, tables.MZ_MAGIC.value::u16);
    err_u16 = fail.kept(err_u16, sink.u16(d, (DOS_SIZE % DOS_PAGE)::u16));
    err_u16 = fail.kept(err_u16, sink.u16(d, ((DOS_SIZE + DOS_PAGE - 1) / DOS_PAGE)::u16));
    err_u16 = fail.kept(err_u16, sink.u16(d, 0));
    err_u16 = fail.kept(err_u16, sink.u16(d, (DOS_HEADER / DOS_PARAGRAPH)::u16));
    err_u16 = fail.kept(err_u16, sink.zeros(d, DOS_RELOCATIONS - sink.len(d)));
    err_u16 = fail.kept(err_u16, sink.u16(d, DOS_HEADER::u16));
    err_u16 = fail.kept(err_u16, sink.zeros(d, lfanew - sink.len(d)));
    err_u16 = fail.kept(err_u16, sink.u32(d, DOS_SIZE::u32));
    ret fail.kept(err_u16, sink.bytes(d, ?DOS_PROGRAM[0], DOS_PROGRAM_SIZE));
}

# the file in order: the headers, then each section's bytes at the offset
# its header gives, zeros between
fun extents_out(b: *Build) err[Fail] {
    val res_dos: res[Held, Fail] = dos(b);
    if (sel res_dos.err) { ret err[Fail].err{res_dos.err}; }
    var err_extent: err[Fail] = extent(b, Extent.dos{res_dos.ok});
    err_extent = fail.kept(err_extent, extent(b, Extent.signature{}));
    err_extent = fail.kept(err_extent, extent(b, Extent.header{}));
    err_extent = fail.kept(err_extent, extent(b, Extent.optional{}));
    err_extent = fail.kept(err_extent, extent(b, Extent.sections{}));
    if (sel err_extent.err) { ret err_extent; }
    var cursor: u64   = b.size;
    var i:      usize = 0;
    for (i < table.count[model.Section](?b.m.sections)) {
        val s: *model.Section = model.section_at(?b.m, table.nth[model.Section](i));
        if (s.raw_size != 0) {
            val err_gap: err[Fail] = gap(b, cursor, s.raw_ptr::u64);
            if (sel err_gap.err) { ret err_gap; }
            val err_extent: err[Fail] = extent(b, Extent.section{table.nth[model.Section](i)});
            if (sel err_extent.err) { ret err_extent; }
            cursor = s.raw_ptr::u64 + s.raw_size::u64;
        }
        i = i + 1;
    }
    ret strings_out(b, cursor);
}

# zeros from `from` up to `to`, which no section covers
fun gap(b: *Build, from: u64, to: u64) err[Fail] {
    if (to < from)  { ret err[Fail].err{fail.internal("a section's bytes overlap what lies before them")}; }
    if (to == from) { ret err[Fail].ok{}; }
    val res_zeros: res[Held, Fail] = zeros(b, to - from);
    if (sel res_zeros.err) { ret err[Fail].err{res_zeros.err}; }
    ret extent(b, Extent.raw{Raw{bytes: res_zeros.ok, why: Why.opaque{}}});
}

# how the loader finds the import of one address slot
# ---
# named:   by the name of its hint/name entry
# ordinal: by this ordinal
tag Lookup: u8 {
    named:   Hinted;
    ordinal: u16;
}

# a hint/name entry
# ---
# at:   where it lies in the hint/name table
# hint: its hint
# name: the name the DLL exports the import by
rec Hinted {
    at:   u64;
    hint: u16;
    name: View;
}

# the run of one DLL in the import address table
# ---
# library: the DLL
# first:   where its run starts in the table
# name:    where its name lies among the DLL names
rec Run {
    library: Id[dynamic.Library];
    first:   u64;
    name:    u64;
}

# where in the import address table no run starts yet
val NO_RUN: u64 = 0xffff_ffff_ffff_ffff;

# where each import table lies in the table the image reserves for them and
# what each import address slot holds, one reading for the measure and the
# writer
# ---
# width:   the bytes of an address slot
# iat:     the import address table
# slots:   the bytes it takes
# runs:    the run of each DLL the image imports from, by rank
# lookups: how the loader finds the import of each slot, by target
# lookup:  where the import lookup table starts, laid as the import address
#          table is
# names:   where the hint/name table starts
# dlls:    where the DLL names start
# size:    the bytes the import tables take
rec Imports {
    width:   u64;
    iat:     Id[Reservation];
    slots:   u64;
    runs:    Vector[Run];
    lookups: Vector[Lookup];
    lookup:  u64;
    names:   u64;
    dlls:    u64;
    size:    u64;
}

fun imports_dnit(im: *Imports) err[Fail] {
    ret fail.kept(vectors.dnit[Run](?im.runs), vectors.dnit[Lookup](?im.lookups));
}

# the import tables of the image `img`, laid out or not, whose address slots
# take `width` bytes
fun imports_of(img: *Image, width: u64) res[Imports, Fail] {
    val a:                *A.Allocator = img.inputs.a;
    var im:               Imports      = Imports{width: width, runs: vector.init[Run](a), lookups: vector.init[Lookup](a)};
    val err_imports_laid: err[Fail]    = imports_laid(img, ?im);
    if (sel err_imports_laid.err) {
        val err_dropped: err[Fail] = imports_dnit(?im);
        ret res[Imports, Fail].err{fail.in_record(err_imports_laid.err, "import tables")};
    }
    ret res[Imports, Fail].ok{im};
}

fun imports_laid(img: *Image, im: *Imports) err[Fail] {
    val d:         *Dynamic           = img.dynamic;
    val entries:   *Table[Entry]      = dynamic.entries_of(d, ?slot.IAT);
    val n:         usize              = table.count[Entry](entries);
    val opt_first: opt[*reserve.Slot] = reserve.slot_of(img.reserved, ?slot.IAT, 0);
    if (sel opt_first.none) { ret err[Fail].err{fail.internal("the imports take no import address table")}; }
    im.iat   = opt_first.some.table;
    im.slots = table.at[Reservation](?img.reserved.tables, im.iat).size;
    if (im.slots % im.width != 0) { ret err[Fail].err{fail.internal("the import address table is not a whole number of slots")}; }
    val err_runs_of: err[Fail] = runs_of(d, ?im.runs);
    if (sel err_runs_of.err) { ret err_runs_of; }
    if (n != 0) {
        val err_grow: err[Fail] = vectors.grow[Lookup](?im.lookups, n);
        if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    }
    val at:    Location = Location{record: "hint/name table"};
    var names: u64      = 0;
    var i:     usize    = 0;
    for (i < n) {
        val opt_slot_of: opt[*reserve.Slot] = reserve.slot_of(img.reserved, ?slot.IAT, i::u32);
        if (sel opt_slot_of.none)                         { ret err[Fail].err{fail.in_indexed(fail.internal("an import takes no address slot"), "slot", i::u64)}; }
        if (opt_slot_of.some.table.index != im.iat.index) { ret err[Fail].err{fail.internal("the import address slots lie in two tables")}; }
        val aim: dynamic.Aim = table.at[Entry](entries, table.nth[Entry](i)).aim;
        if (!sel aim.imported) { ret err[Fail].err{fail.in_indexed(fail.internal("an import address slot aims at no import"), "slot", i::u64)}; }
        val imp:      *dynamic.Import = table.at[dynamic.Import](?d.imports, aim.imported);
        val opt_rank: opt[u32]        = table.at[dynamic.Library](?d.libraries, imp.library).rank;
        if (sel opt_rank.none)                                    { ret err[Fail].err{fail.internal("a DLL the image imports from has no rank")}; }
        if (opt_rank.some::usize >= vector.length[Run](?im.runs)) { ret err[Fail].err{fail.internal("a DLL the image imports from has no run")}; }
        val run: *Run = ?im.runs.data[opt_rank.some::usize];
        if (opt_slot_of.some.offset < run.first) { run.first = opt_slot_of.some.offset; }
        val res_found: res[Lookup, Fail] = lookup_of(img, imp, names);
        if (sel res_found.err) { ret err[Fail].err{fail.in_indexed(res_found.err, "import", aim.imported.index::u64)}; }
        im.lookups.data[i] = res_found.ok;
        if (sel res_found.ok.named) {
            val res_entry: res[u64, Fail] = checked.align_up(at, 2 + res_found.ok.named.name.len::u64 + 1, 2);
            if (sel res_entry.err) { ret err[Fail].err{res_entry.err}; }
            val res_next: res[u64, Fail] = checked.add(at, names, res_entry.ok);
            if (sel res_next.err) { ret err[Fail].err{res_next.err}; }
            names = res_next.ok;
        }
        i = i + 1;
    }
    val w:               Location       = Location{record: "import tables"};
    val res_descriptors: res[u64, Fail] = checked.mul(w, vector.length[Run](?im.runs)::u64 + 1, model.IMPORT_SIZE);
    if (sel res_descriptors.err) { ret err[Fail].err{res_descriptors.err}; }
    val res_lookup: res[u64, Fail] = checked.align_up(w, res_descriptors.ok, im.width);
    if (sel res_lookup.err) { ret err[Fail].err{res_lookup.err}; }
    im.lookup = res_lookup.ok;
    val res_hinted: res[u64, Fail] = checked.add(w, im.lookup, im.slots);
    if (sel res_hinted.err) { ret err[Fail].err{res_hinted.err}; }
    im.names = res_hinted.ok;
    val res_dlls: res[u64, Fail] = checked.add(w, im.names, names);
    if (sel res_dlls.err) { ret err[Fail].err{res_dlls.err}; }
    im.dlls = res_dlls.ok;
    var spelled: u64   = 0;
    var k:       usize = 0;
    for (k < vector.length[Run](?im.runs)) {
        val run: *Run = ?im.runs.data[k];
        if (run.first == NO_RUN) { ret err[Fail].err{fail.in_indexed(fail.internal("a DLL the image imports from has no import address slot"), "library", run.library.index::u64)}; }
        run.name = spelled;
        val loader:   View           = intern.bytes_of(img.names, table.at[dynamic.Library](?d.libraries, run.library).loader);
        val res_next: res[u64, Fail] = checked.add(w, spelled, loader.len::u64 + 1);
        if (sel res_next.err) { ret err[Fail].err{res_next.err}; }
        spelled = res_next.ok;
        k       = k + 1;
    }
    val res_size: res[u64, Fail] = checked.add(w, im.dlls, spelled);
    if (sel res_size.err) { ret err[Fail].err{res_size.err}; }
    im.size = res_size.ok;
    ret err[Fail].ok{};
}

# a run per library a reference binds to into `runs`, by rank, none started
fun runs_of(d: *Dynamic, runs: *Vector[Run]) err[Fail] {
    var ranks: usize = 0;
    var i:     usize = 0;
    for (i < table.count[dynamic.Library](?d.libraries)) {
        val opt_rank: opt[u32] = table.at[dynamic.Library](?d.libraries, table.nth[dynamic.Library](i)).rank;
        if (sel opt_rank.some) { ranks = ranks + 1; }
        i = i + 1;
    }
    if (ranks == 0) { ret err[Fail].ok{}; }
    val err_grow: err[Fail] = vectors.grow[Run](runs, ranks);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var k: usize = 0;
    for (k < ranks) {
        runs.data[k].first = NO_RUN;
        k                  = k + 1;
    }
    i = 0;
    for (i < table.count[dynamic.Library](?d.libraries)) {
        val opt_rank: opt[u32] = table.at[dynamic.Library](?d.libraries, table.nth[dynamic.Library](i)).rank;
        if (sel opt_rank.some) {
            if (opt_rank.some::usize >= ranks) { ret err[Fail].err{fail.internal("the libraries' ranks are not dense")}; }
            runs.data[opt_rank.some::usize].library = table.nth[dynamic.Library](i);
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# how the loader finds the import `imp`, whose hint/name entry, for one by
# name, lies `at` into the hint/name table
fun lookup_of(img: *Image, imp: *dynamic.Import, at: u64) res[Lookup, Fail] {
    val off: *dynamic.Offer = table.at[dynamic.Offer](?img.dynamic.offers, imp.offer);
    val o:   *Object        = input.object_of(img.inputs, off.input);
    val sym: *Symbol        = object.symbol_at(o, off.symbol);
    if (!sel sym.def.library) { ret res[Lookup, Fail].err{fail.internal("an import binds a symbol its DLL does not define")}; }
    val e: object.Export = sym.def.library;
    if (sel e.ordinal) { ret res[Lookup, Fail].ok{Lookup.ordinal{e.ordinal}}; }
    var hint:     u16      = 0;
    val opt_held: opt[u16] = e.named.hint;
    if (sel opt_held.some) { hint = opt_held.some; }
    ret res[Lookup, Fail].ok{Lookup.named{Hinted{at: at, hint: hint, name: object.name_of(o, e.named.name)}}};
}

# the bytes the import tables of the laid out image `img` take
fun import_tables(img: *Image) res[u64, Fail] {
    val res_width_of: res[*Width, Fail] = width_of(img.target.arch);
    if (sel res_width_of.err) { ret res[u64, Fail].err{res_width_of.err}; }
    val res_imports_of: res[Imports, Fail] = imports_of(img, res_width_of.ok.shape.addr::u64);
    if (sel res_imports_of.err) { ret res[u64, Fail].err{res_imports_of.err}; }
    var got:     Imports   = res_imports_of.ok;
    val size:    u64       = got.size;
    val err_rel: err[Fail] = imports_dnit(?got);
    if (sel err_rel.err) { ret res[u64, Fail].err{err_rel.err}; }
    ret res[u64, Fail].ok{size};
}

# the import tables and the import address table as pieces of the sections
# they lie in, and the directories naming them, nothing for an image that
# imports nothing
fun imports_out(b: *Build) err[Fail] {
    if (table.count[Entry](dynamic.entries_of(b.img.dynamic, ?slot.IAT)) == 0) { ret err[Fail].ok{}; }
    val res_imports_of: res[Imports, Fail] = imports_of(b.img, b.width.shape.addr::u64);
    if (sel res_imports_of.err) { ret err[Fail].err{res_imports_of.err}; }
    var got:               Imports   = res_imports_of.ok;
    val err_imports_tiled: err[Fail] = imports_tiled(b, ?got);
    val err_rel:           err[Fail] = imports_dnit(?got);
    if (sel err_imports_tiled.err) { ret err[Fail].err{fail.in_record(err_imports_tiled.err, "import tables")}; }
    if (sel err_rel.err)           { ret err_rel; }
    ret err[Fail].ok{};
}

fun imports_tiled(b: *Build, im: *Imports) err[Fail] {
    val opt_measured_of: opt[Id[Reservation]] = measured_of(b.img, ?IMPORT_TABLES);
    if (sel opt_measured_of.none)                                                            { ret err[Fail].err{fail.internal("the image reserved no import tables")}; }
    if (table.at[Reservation](?b.img.reserved.tables, opt_measured_of.some).size != im.size) { ret err[Fail].err{fail.internal("the import tables are not the size layout left for them")}; }
    val res_placed_of: res[Placed, Fail] = placed_of(b.img, opt_measured_of.some);
    if (sel res_placed_of.err) { ret err[Fail].err{res_placed_of.err}; }
    val res_iat: res[Placed, Fail] = placed_of(b.img, im.iat);
    if (sel res_iat.err) { ret err[Fail].err{res_iat.err}; }
    val res_home: res[u32, Fail] = spanned(b, res_placed_of.ok, im.size, "import tables");
    if (sel res_home.err) { ret err[Fail].err{res_home.err}; }
    val res_slots: res[u32, Fail] = spanned(b, res_iat.ok, im.slots, "import address table");
    if (sel res_slots.err) { ret err[Fail].err{res_slots.err}; }
    val base:                 u64       = res_home.ok::u64;
    val err_descriptors_tile: err[Fail] = descriptors_tile(b, im, res_placed_of.ok, base, res_slots.ok::u64);
    if (sel err_descriptors_tile.err) { ret err_descriptors_tile; }
    var lookup:          Vector[u64] = vector.init[u64](b.a);
    val err_slot_values: err[Fail]   = slot_values(b, im, base, ?lookup);
    if (sel err_slot_values.err) {
        val err_dropped: err[Fail] = vectors.dnit[u64](?lookup);
        ret err_slot_values;
    }
    var addresses:  Vector[u64] = vector.init[u64](b.a);
    val err_copied: err[Fail]   = vectors.extend[u64](?addresses, lookup.data, vector.length[u64](?lookup));
    if (sel err_copied.err) {
        val err_dropped: err[Fail] = fail.kept(vectors.dnit[u64](?lookup), vectors.dnit[u64](?addresses));
        ret err[Fail].err{err_copied.err};
    }
    val err_tile: err[Fail] = tile(b, res_placed_of.ok.merged, res_placed_of.ok.offset + im.lookup, im.slots, Piece.pointers{lookup});
    if (sel err_tile.err) {
        val err_dropped: err[Fail] = vectors.dnit[u64](?addresses);
        ret err_tile;
    }
    val err_tile_merged: err[Fail] = tile(b, res_iat.ok.merged, res_iat.ok.offset, im.slots, Piece.pointers{addresses});
    if (sel err_tile_merged.err) { ret err_tile_merged; }
    val err_names_tile: err[Fail] = names_tile(b, im, res_placed_of.ok);
    if (sel err_names_tile.err) { ret err_names_tile; }
    val err_dlls_tile: err[Fail] = dlls_tile(b, im, res_placed_of.ok);
    if (sel err_dlls_tile.err) { ret err_dlls_tile; }
    b.imports = DataDirectory{rva: res_home.ok, size: ((vector.length[Run](?im.runs) + 1)::u64 * model.IMPORT_SIZE)::u32};
    b.iat     = DataDirectory{rva: res_slots.ok, size: im.slots::u32};
    ret err[Fail].ok{};
}

# the offset from the image base of the `size` bytes at `at`, all of which
# lie in the 4 GiB above it
fun spanned(b: *Build, at: Placed, size: u64, record: str) res[u32, Fail] {
    val l:         Location       = Location{record: record};
    val res_start: res[u64, Fail] = checked.add(l, table.at[Merged](?b.img.layout.merged, at.merged).address, at.offset);
    if (sel res_start.err) { ret res[u32, Fail].err{res_start.err}; }
    val res_end: res[u64, Fail] = checked.add(l, res_start.ok, size);
    if (sel res_end.err) { ret res[u32, Fail].err{res_end.err}; }
    val res_last: res[u32, Fail] = rva_of(b, res_end.ok, record, 0);
    if (sel res_last.err) { ret res_last; }
    ret rva_of(b, res_start.ok, record, 0);
}

# a descriptor per DLL by rank, then the empty one closing them, at `at`. the
# import tables start at the image offset `base` and the import address table
# at `iat`
fun descriptors_tile(b: *Build, im: *Imports, at: Placed, base: u64, iat: u64) err[Fail] {
    val n:        usize                    = vector.length[Run](?im.runs);
    var t:        Vector[ImportDescriptor] = vector.init[ImportDescriptor](b.a);
    val err_grow: err[Fail]                = vectors.grow[ImportDescriptor](?t, n + 1);
    if (sel err_grow.err) {
        val err_dropped: err[Fail] = vectors.dnit[ImportDescriptor](?t);
        ret err[Fail].err{err_grow.err};
    }
    var i: usize = 0;
    for (i < n) {
        val run: *Run = ?im.runs.data[i];
        t.data[i] = ImportDescriptor{
            lookup_rva: (base + im.lookup + run.first)::u32,
            name_rva:   (base + im.dlls + run.name)::u32,
            thunk_rva:  (iat + run.first)::u32,
        };
        i = i + 1;
    }
    ret tile(b, at.merged, at.offset, (n + 1)::u64 * model.IMPORT_SIZE, Piece.imports{t});
}

# what each import address slot holds before the loader binds it into
# `out`, which the import lookup table holds too: the image offset of its
# hint/name entry, or the ordinal flag and its ordinal, every slot that
# closes a run zero
fun slot_values(b: *Build, im: *Imports, base: u64, out: *Vector[u64]) err[Fail] {
    val count: usize = (im.slots / im.width)::usize;
    if (count != 0) {
        val err_grow: err[Fail] = vectors.grow[u64](out, count);
        if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    }
    val flag: u64   = 1::u64 << (im.width * 8 - 1);
    var i:    usize = 0;
    for (i < vector.length[Lookup](?im.lookups)) {
        val opt_slot_of: opt[*reserve.Slot] = reserve.slot_of(b.img.reserved, ?slot.IAT, i::u32);
        if (sel opt_slot_of.none) { ret err[Fail].err{fail.internal("an import takes no address slot")}; }
        val l: *Lookup = ?im.lookups.data[i];
        var v: u64     = 0;
        if (sel l.ordinal) { v = flag | l.ordinal::u64; }
        or (sel l.named)   { v = base + im.names + l.named.at; }
        out.data[(opt_slot_of.some.offset / im.width)::usize] = v;
        i                                                     = i + 1;
    }
    ret err[Fail].ok{};
}

# the hint/name entry of each import by name, each a hint, the name and a
# NUL, padded to an even length
fun names_tile(b: *Build, im: *Imports, at: Placed) err[Fail] {
    var out:     Sink      = sink.init(b.a, LITTLE);
    var err_u16: err[Fail] = err[Fail].ok{};
    var i:       usize     = 0;
    for (sel err_u16.ok && i < vector.length[Lookup](?im.lookups)) {
        val l: *Lookup = ?im.lookups.data[i];
        i = i + 1;
        if (!sel l.named) { cnt; }
        if (sink.len(?out)::u64 != l.named.at) {
            err_u16 = err[Fail].err{fail.internal("a hint/name entry does not lie where the table was measured to put it")};
            brk;
        }
        err_u16 = sink.u16(?out, l.named.hint);
        err_u16 = fail.kept(err_u16, sink.bytes(?out, l.named.name.data, l.named.name.len));
        err_u16 = fail.kept(err_u16, sink.u8(?out, 0));
        if ((sink.len(?out) % 2) != 0) { err_u16 = fail.kept(err_u16, sink.u8(?out, 0)); }
    }
    ret raw_tile(b, ?out, err_u16, at.merged, at.offset + im.names, im.dlls - im.names);
}

# the name of each DLL by rank, each with its NUL
fun dlls_tile(b: *Build, im: *Imports, at: Placed) err[Fail] {
    val d:         *Dynamic  = b.img.dynamic;
    var out:       Sink      = sink.init(b.a, LITTLE);
    var err_bytes: err[Fail] = err[Fail].ok{};
    var i:         usize     = 0;
    for (sel err_bytes.ok && i < vector.length[Run](?im.runs)) {
        val run:    *Run = ?im.runs.data[i];
        val loader: View = intern.bytes_of(b.img.names, table.at[dynamic.Library](?d.libraries, run.library).loader);
        err_bytes = sink.bytes(?out, loader.data, loader.len);
        err_bytes = fail.kept(err_bytes, sink.u8(?out, 0));
        i         = i + 1;
    }
    ret raw_tile(b, ?out, err_bytes, at.merged, at.offset + im.dlls, im.size - im.dlls);
}

# the bytes `out` holds, which `w` wrote, as a piece at `offset` of the
# output section `merged` that takes `size` bytes, nothing when it is empty
fun raw_tile(b: *Build, out: *Sink, w: err[Fail], merged: Id[Merged], offset: u64, size: u64) err[Fail] {
    var res_held: res[Held, Fail] = res[Held, Fail].err{fail.internal("the table was not written")};
    if (sel w.ok) {
        if (sink.len(out)::u64 != size) { res_held = res[Held, Fail].err{fail.internal("a table is not the size it was measured to be")}; }
        or                              { res_held = model.own(?b.m, sink.data(out), sink.len(out)); }
    }
    val err_rel: err[Fail] = sink.dnit(out);
    if (sel w.err)        { ret w; }
    if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
    if (sel err_rel.err)  { ret err_rel; }
    if (size == 0)        { ret err[Fail].ok{}; }
    ret tile(b, merged, offset, size, Piece.raw{Raw{bytes: res_held.ok, why: Why.opaque{}}});
}

# lay the piece `p` of `size` bytes at `offset` of the output section
# `merged`, which the build releases when no section takes it
fun tile(b: *Build, merged: Id[Merged], offset: u64, size: u64, p: Piece) err[Fail] {
    var held:              Piece                = p;
    val res_pieces_pushed: res[Id[Piece], Fail] = table.push[Piece](?b.pieces, held);
    if (sel res_pieces_pushed.err) {
        val err_dropped: err[Fail] = model.piece_dnit(?held);
        ret err[Fail].err{res_pieces_pushed.err};
    }
    val err_tiles_pushed: err[Fail] = vectors.push[Tile](?b.tiles, Tile{merged: merged, offset: offset, size: size, piece: res_pieces_pushed.ok.index});
    if (sel err_tiles_pushed.err) { ret err[Fail].err{err_tiles_pushed.err}; }
    ret err[Fail].ok{};
}

fun order_tile(x: *Tile, y: *Tile) i64 {
    if (x.merged.index != y.merged.index) { ret order_u32(x.merged.index, y.merged.index); }
    if (x.offset < y.offset)              { ret -1; }
    if (x.offset > y.offset)              { ret 1; }
    ret 0;
}

# whether the writer lays a piece in output section `id`
fun tiled(b: *Build, id: Id[Merged]) bool {
    val opt_first_tile: opt[usize] = first_tile(b, id);
    ret sel opt_first_tile.some;
}

# the first tile of output section `id`, none when it has none
fun first_tile(b: *Build, id: Id[Merged]) opt[usize] {
    val n:  usize = vector.length[Tile](?b.tiles);
    var lo: usize = 0;
    var hi: usize = n;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (b.tiles.data[mid].merged.index < id.index) { lo = mid + 1; }
        or                                             { hi = mid; }
    }
    if (lo < n && b.tiles.data[lo].merged.index == id.index) { ret opt[usize].some{lo}; }
    ret opt[usize].none{};
}

# the bytes of output section `m`, `raw` in the file: the pieces the writer
# lays in it where they lie, the relocated bytes between them, then zeros
fun tiled_body(b: *Build, id: Id[Merged], m: *Merged, raw: u64) res[Body, Fail] {
    var tiles:        Table[Piece] = table.init[Piece](b.a);
    val err_tiles_of: err[Fail]    = tiles_of(b, id, m, ?tiles);
    var err_pad:      err[Fail]    = err_tiles_of;
    if (sel err_tiles_of.ok) { err_pad = padding(b, ?tiles, raw - m.size); }
    if (sel err_pad.err) {
        val err_dropped: err[Fail] = model.pieces_dnit(?tiles);
        ret res[Body, Fail].err{err_pad.err};
    }
    ret res[Body, Fail].ok{Body.tiled{tiles}};
}

fun tiles_of(b: *Build, id: Id[Merged], m: *Merged, out: *Table[Piece]) err[Fail] {
    val opt_start: opt[usize] = first_tile(b, id);
    if (sel opt_start.none) { ret err[Fail].err{fail.internal("an output section the writer lays pieces in holds none")}; }
    var cursor: u64   = 0;
    var i:      usize = opt_start.some;
    for (i < vector.length[Tile](?b.tiles) && b.tiles.data[i].merged.index == id.index) {
        val t: Tile = b.tiles.data[i];
        i = i + 1;
        if (t.offset < cursor || t.size > m.size || t.offset > m.size - t.size) { ret err[Fail].err{fail.internal("a table the writer lays overlaps what lies before it")}; }
        val err_between: err[Fail] = between(b, m, cursor, t.offset, out);
        if (sel err_between.err) { ret err_between; }
        val slot:           *Piece               = table.at[Piece](?b.pieces, table.nth[Piece](t.piece::usize));
        val res_out_pushed: res[Id[Piece], Fail] = table.push[Piece](out, @slot);
        if (sel res_out_pushed.err) { ret err[Fail].err{res_out_pushed.err}; }
        @slot  = Piece.raw{Raw{bytes: Held.borrowed{Bytes{data: nil, len: 0}}, why: Why.opaque{}}};
        cursor = t.offset + t.size;
    }
    ret between(b, m, cursor, m.size, out);
}

# the relocated bytes of output section `m` from `from` to `to` as a piece
# into `out`, nothing when they are empty
fun between(b: *Build, m: *Merged, from: u64, to: u64, out: *Table[Piece]) err[Fail] {
    if (to == from) { ret err[Fail].ok{}; }
    val rel:   *Vector[u8] = ?b.img.relocated.bytes;
    val start: u64         = m.offset + from;
    if (start > vector.length[u8](rel)::u64 || to - from > vector.length[u8](rel)::u64 - start) {
        ret err[Fail].err{fail.internal("an output section lies past the relocated bytes")};
    }
    val res_out_pushed: res[Id[Piece], Fail] = table.push[Piece](out, Piece.raw{Raw{bytes: Held.borrowed{Bytes{data: ?rel.data[start::usize], len: (to - from)::usize}}, why: Why.opaque{}}});
    if (sel res_out_pushed.err) { ret err[Fail].err{res_out_pushed.err}; }
    ret err[Fail].ok{};
}

# whether a section the link keeps holds thread-local data
fun threaded(inputs: *Inputs, live: *Live) bool {
    var i: usize = 0;
    for (i < vector.length[Ref](?live.kept)) {
        val at: Ref             = live.kept.data[i];
        val o:  *Object         = input.object_of(inputs, at.input);
        val s:  *object.Section = object.section_at(o, at.section);
        if ((s.flags & section.TLS) != 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the definition of the name `text` an object input of the link holds, none
# when only a library or the link itself defines it, or nothing does
fun defined(names: *Interner, resolved: *Resolved, text: str) opt[resolve.Won] {
    val opt_find: opt[Id[Name]] = intern.find(names, text, str_len(text));
    if (sel opt_find.none) { ret opt[resolve.Won].none{}; }
    ret defined_name(resolved, opt_find.some);
}

# the definition of the link name `nm` an object input holds, as defined says
fun defined_name(resolved: *Resolved, nm: Id[Name]) opt[resolve.Won] {
    val opt_bound: opt[resolve.Won] = resolve.bound(resolved, nm);
    if (sel opt_bound.none)                                      { ret opt_bound; }
    if (resolve.library(resolved, opt_bound.some.binding.input)) { ret opt[resolve.Won].none{}; }
    ret opt_bound;
}

# whether the image supplies its own TLS directory: it holds thread-local
# data and no input defines _tls_used. a machine whose C symbols carry
# `prefix` is refused, as the link spells the names a CRT gives without one
fun supplies(inputs: *Inputs, names: *Interner, resolved: *Resolved, live: *Live, prefix: str) res[bool, Fail] {
    if (!threaded(inputs, live)) { ret res[bool, Fail].ok{false}; }
    if (str_len(prefix) != 0)    { ret res[bool, Fail].err{fail.about(fail.unsupported("a PE image whose C symbols carry a prefix does not hold thread-local data yet"), prefix)}; }
    val opt_used: opt[resolve.Won] = defined(names, resolved, TLS_USED);
    ret res[bool, Fail].ok{sel opt_used.none};
}

# the bytes a TLS directory of an image of layout `w` takes
fun directory_size(w: *Width) u64 {
    ret TLS_ADDRESSES * w.shape.addr::u64 + TLS_TAIL;
}

# the bytes the TLS directory of the image `img` takes
fun tls_directory(img: *Image) res[u64, Fail] {
    val res_width_of: res[*Width, Fail] = width_of(img.target.arch);
    if (sel res_width_of.err) { ret res[u64, Fail].err{res_width_of.err}; }
    ret res[u64, Fail].ok{directory_size(res_width_of.ok)};
}

# reserve the TLS directory in read-only data and the index cell in written
# data of an image that supplies its own
fun declare_tls(in: *reserve.In, out: *Reserved) err[Fail] {
    val res_arch_of: res[*Pair, Fail] = coff_pairs.of(in.arch);
    if (sel res_arch_of.err) { ret err[Fail].err{res_arch_of.err}; }
    val res_supplies: res[bool, Fail] = supplies(in.inputs, in.names, in.resolved, in.live, res_arch_of.ok.prefix);
    if (sel res_supplies.err) { ret err[Fail].err{res_supplies.err}; }
    if (!res_supplies.ok)     { ret err[Fail].ok{}; }
    val opt_pointer_bytes: opt[u8] = arch.pointer_bytes(in.arch);
    if (sel opt_pointer_bytes.none) { ret err[Fail].err{fail.about(fail.unsupported("the architecture states no address width"), in.arch.name)}; }
    val res_rdata: res[str, Fail] = naming.name_of(section.Key{kind: ?section.RODATA});
    if (sel res_rdata.err) { ret err[Fail].err{res_rdata.err}; }
    val res_data: res[str, Fail] = naming.name_of(section.Key{kind: ?section.DATA});
    if (sel res_data.err) { ret err[Fail].err{res_data.err}; }
    val res_declare: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
        name:      res_rdata.ok,
        kind:      ?section.RODATA,
        flags:     section.ALLOC,
        align:     opt_pointer_bytes.some::u64,
        sizing:    reserve.Sizing.measured{?TLS_DIRECTORY},
        placement: reserve.Placement.region_end{?reserve.CONST_END},
        limit:     0xffff_ffff,
        reason:    "the TLS directory passes 4 GiB",
    });
    if (sel res_declare.err) { ret err[Fail].err{res_declare.err}; }
    if (relocatable(in.kind)) {
        var k: u64 = 0;
        for (k < TLS_ADDRESSES) {
            val err_fixed_word: err[Fail] = reserve.fixed_word(out, reserve.Word{table: res_declare.ok, offset: k * opt_pointer_bytes.some::u64, bound: opt[dynamic.Aim].none{}});
            if (sel err_fixed_word.err) { ret err_fixed_word; }
            k = k + 1;
        }
    }
    val res_declare_out: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
        name:      res_data.ok,
        kind:      ?section.DATA,
        flags:     section.ALLOC | section.WRITE,
        align:     TLS_CELL_SIZE,
        sizing:    reserve.Sizing.fixed{TLS_CELL_SIZE},
        placement: reserve.Placement.region_end{?reserve.DATA_END},
        limit:     0xffff_ffff,
        reason:    "the TLS index cell passes 4 GiB",
        anchor:    opt[*Anchor].some{?TLS_INDEX},
    });
    if (sel res_declare_out.err) { ret err[Fail].err{res_declare_out.err}; }
    ret err[Fail].ok{};
}

# the address of the name `text` in the image `img`: an object input's
# definition or the link's own
fun named_address(img: *Image, text: str) res[u64, Fail] {
    val missing:  Fail          = fail.about(fail.malformed("the image does not define a name its TLS directory names"), text);
    val opt_find: opt[Id[Name]] = intern.find(img.names, text, str_len(text));
    if (sel opt_find.none) { ret res[u64, Fail].err{missing}; }
    ret address_of(img, opt_find.some, missing);
}

# the address of the link name `nm`, `missing` when the image gives it none
fun address_of(img: *Image, nm: Id[Name], missing: Fail) res[u64, Fail] {
    val opt_bound: opt[resolve.Won] = resolve.bound(img.resolved, nm);
    if (sel opt_bound.some) {
        if (resolve.library(img.resolved, opt_bound.some.binding.input)) { ret res[u64, Fail].err{missing}; }
        val opt_value_of: opt[u64] = layout.value_of(img.layout, opt_bound.some.binding.input, opt_bound.some.binding.symbol);
        if (sel opt_value_of.none) { ret res[u64, Fail].err{missing}; }
        ret res[u64, Fail].ok{opt_value_of.some};
    }
    val opt_linked_value: opt[u64] = layout.linked_value(img.layout, img.resolved, nm);
    if (sel opt_linked_value.none) { ret res[u64, Fail].err{missing}; }
    ret res[u64, Fail].ok{opt_linked_value.some};
}

# the thread-local template of an image
# ---
# start: where it starts
# end:   where its bytes in the file end
# zero:  the bytes of zero fill past them
# align: its alignment
rec Template {
    start: u64;
    end:   u64;
    zero:  u32;
    align: u64;
}

# the template of the laid out image: its one output section of thread-local
# data, whose bytes up to the end of the last byte an input or table states
# are the template, and whose zeros past them are its zero fill
fun template_of(b: *Build) res[Template, Fail] {
    val l:     *Layout = b.img.layout;
    var count: usize   = 0;
    var found: usize   = 0;
    var i:     usize   = 0;
    for (i < table.count[Merged](?l.merged)) {
        if ((table.at[Merged](?l.merged, table.nth[Merged](i)).flags & section.TLS) != 0) {
            count = count + 1;
            found = i;
        }
        i = i + 1;
    }
    if (count > 1)  { ret res[Template, Fail].err{fail.unsupported("an image holds thread-local data in two output sections")}; }
    if (count == 0) { ret res[Template, Fail].err{fail.internal("an image with a thread-local block holds no output section of thread-local data")}; }
    val m:        *Merged        = table.at[Merged](?l.merged, table.nth[Merged](found));
    val res_init: res[u64, Fail] = initialized_end(b.img, found::u32, m);
    if (sel res_init.err) { ret res[Template, Fail].err{res_init.err}; }
    val res_zero: res[u32, Fail] = narrow(m.size - res_init.ok, "output section", m.position::u64);
    if (sel res_zero.err) { ret res[Template, Fail].err{res_zero.err}; }
    val res_end: res[u64, Fail] = checked.add(Location{record: "TLS directory"}, m.address, res_init.ok);
    if (sel res_end.err) { ret res[Template, Fail].err{res_end.err}; }
    ret res[Template, Fail].ok{Template{start: m.address, end: res_end.ok, zero: res_zero.ok, align: m.align}};
}

# the end, from its start, of the last byte of output section `m`, of index
# `merged`, that an input section or a reserved table states rather than
# leaves as zero fill
fun initialized_end(img: *Image, merged: u32, m: *Merged) res[u64, Fail] {
    val l:   *Layout = img.layout;
    var end: u64     = 0;
    var i:   usize   = 0;
    for (i < table.count[Landing](?l.landings)) {
        val g: *Landing = table.at[Landing](?l.landings, table.nth[Landing](i));
        i = i + 1;
        if (g.merged.index != merged) { cnt; }
        val s: *object.Section = object.section_at(input.object_of(img.inputs, g.at.input), g.at.section);
        if (sel s.contents.zero)     { cnt; }
        if (g.offset + g.size > end) { end = g.offset + g.size; }
    }
    var k: usize = 0;
    for (k < vector.length[Spot](?l.tables)) {
        val sp: Spot = l.tables.data[k];
        if (sel sp.section) {
            val stop: u64 = sp.section.offset + table.at[Reservation](?img.reserved.tables, table.nth[Reservation](k)).size;
            if (sp.section.merged.index == merged && stop > end) { end = stop; }
        }
        k = k + 1;
    }
    if (end > m.size) { ret res[u64, Fail].err{fail.internal("thread-local data lies past its output section")}; }
    ret res[u64, Fail].ok{end};
}

# the TLS directory of an image that holds thread-local data and the data
# directory naming it: the definition of _tls_used an input holds, its
# characteristics stating the template's alignment, or else the table the
# image reserved
fun tls_out(b: *Build) err[Fail] {
    val opt_held: opt[layout.Tls] = b.img.layout.tls;
    if (sel opt_held.none) { ret err[Fail].ok{}; }
    val res_template_of: res[Template, Fail] = template_of(b);
    if (sel res_template_of.err) { ret err[Fail].err{res_template_of.err}; }
    val opt_used:         opt[resolve.Won] = defined(b.img.names, b.img.resolved, TLS_USED);
    var err_supplied_out: err[Fail]        = err[Fail].ok{};
    if (sel opt_used.some)        { err_supplied_out = supplied_out(b, opt_used.some.binding, res_template_of.ok); }
    or                            { err_supplied_out = reserved_out(b, res_template_of.ok); }
    if (sel err_supplied_out.err) { ret err[Fail].err{fail.in_record(err_supplied_out.err, "TLS directory")}; }
    ret err[Fail].ok{};
}

# the TLS directory the image reserved, naming the template `t`, the index
# cell and the callbacks past the first bound of their array
fun reserved_out(b: *Build, t: Template) err[Fail] {
    val opt_measured_of: opt[Id[Reservation]] = measured_of(b.img, ?TLS_DIRECTORY);
    if (sel opt_measured_of.none) { ret err[Fail].err{fail.internal("the image reserved no TLS directory")}; }
    val size: u64 = directory_size(b.width);
    if (table.at[Reservation](?b.img.reserved.tables, opt_measured_of.some).size != size) { ret err[Fail].err{fail.internal("the TLS directory is not the size layout left for it")}; }
    val res_placed_of: res[Placed, Fail] = placed_of(b.img, opt_measured_of.some);
    if (sel res_placed_of.err) { ret err[Fail].err{res_placed_of.err}; }
    val res_rva: res[u32, Fail] = spanned(b, res_placed_of.ok, size, "TLS directory");
    if (sel res_rva.err) { ret err[Fail].err{res_rva.err}; }
    val res_index: res[u64, Fail] = named_address(b.img, TLS_CELL);
    if (sel res_index.err) { ret err[Fail].err{res_index.err}; }
    val res_first: res[u64, Fail] = named_address(b.img, TLS_FIRST);
    if (sel res_first.err) { ret err[Fail].err{res_first.err}; }
    val res_callbacks: res[u64, Fail] = checked.add(Location{record: "TLS directory"}, res_first.ok, b.width.shape.addr::u64);
    if (sel res_callbacks.err) { ret err[Fail].err{res_callbacks.err}; }
    val res_field: res[u64, Fail] = align_field(t.align);
    if (sel res_field.err) { ret err[Fail].err{res_field.err}; }
    val d:        Tls       = Tls{raw_start: t.start, raw_end: t.end, index_address: res_index.ok, callbacks: res_callbacks.ok, zero_fill: t.zero, characteristics: res_field.ok::u32};
    val err_tile: err[Fail] = tile(b, res_placed_of.ok.merged, res_placed_of.ok.offset, size, Piece.tls{d});
    if (sel err_tile.err) { ret err_tile; }
    b.tls = DataDirectory{rva: res_rva.ok, size: size::u32};
    ret err[Fail].ok{};
}

# the TLS directory the input definition `bn` of _tls_used holds, as it
# holds it but for its characteristics, which state the alignment of the
# template `t`
fun supplied_out(b: *Build, bn: *Binding, t: Template) err[Fail] {
    val img: *Image  = b.img;
    val o:   *Object = input.object_of(img.inputs, bn.input);
    val sym: *Symbol = object.symbol_at(o, bn.symbol);
    if (!sel sym.def.placed) { ret err[Fail].err{fail.about(fail.malformed("the TLS directory an input defines lies in no section"), TLS_USED)}; }
    val res_pos: res[opt[layout.Position], Fail] = layout.locate(img.layout, img.pieces, Ref{input: bn.input, section: sym.def.placed.section}, sym.def.placed.offset);
    if (sel res_pos.err)     { ret err[Fail].err{res_pos.err}; }
    if (sel res_pos.ok.none) { ret err[Fail].err{fail.about(fail.malformed("the TLS directory an input defines lies in no output section"), TLS_USED)}; }
    val p:    layout.Position = res_pos.ok.some;
    val size: u64             = directory_size(b.width);
    val m:    *Merged         = table.at[Merged](?img.layout.merged, p.merged);
    if (!section.has(m.kind, section.BITS) || p.offset > m.size || size > m.size - p.offset) {
        ret err[Fail].err{fail.about(fail.malformed("the TLS directory an input defines passes the bytes of its section"), TLS_USED)};
    }
    val rel: *Vector[u8] = ?img.relocated.bytes;
    if (p.file > vector.length[u8](rel)::u64 || size > vector.length[u8](rel)::u64 - p.file) { ret err[Fail].err{fail.internal("a TLS directory lies past the relocated bytes")}; }
    val res_rva: res[u32, Fail] = spanned(b, Placed{merged: p.merged, offset: p.offset}, size, "TLS directory");
    if (sel res_rva.err) { ret err[Fail].err{res_rva.err}; }
    var r:                  Reader    = reader.make("TLS directory", ?rel.data[p.file::usize], size::usize, LITTLE);
    var d:                  Tls       = Tls{};
    val err_directory_read: err[Fail] = directory_read(?r, b.width.shape.addr, ?d);
    if (sel err_directory_read.err) { ret err_directory_read; }
    val res_field: res[u64, Fail] = align_field(t.align);
    if (sel res_field.err) { ret err[Fail].err{res_field.err}; }
    d.characteristics = ((d.characteristics::u64 & ~tables.SCN_ALIGN_MASK.value) | res_field.ok)::u32;
    val err_tile: err[Fail] = tile(b, p.merged, p.offset, size, Piece.tls{d});
    if (sel err_tile.err) { ret err_tile; }
    b.tls = DataDirectory{rva: res_rva.ok, size: size::u32};
    ret err[Fail].ok{};
}

# the TLS directory at `r`, its addresses `width` bytes wide, into `out`
fun directory_read(r: *Reader, width: usize, out: *Tls) err[Fail] {
    val res_start: res[u64, Fail] = reader.uint(r, width);
    if (sel res_start.err) { ret err[Fail].err{res_start.err}; }
    val res_end: res[u64, Fail] = reader.uint(r, width);
    if (sel res_end.err) { ret err[Fail].err{res_end.err}; }
    val res_index: res[u64, Fail] = reader.uint(r, width);
    if (sel res_index.err) { ret err[Fail].err{res_index.err}; }
    val res_callbacks: res[u64, Fail] = reader.uint(r, width);
    if (sel res_callbacks.err) { ret err[Fail].err{res_callbacks.err}; }
    val res_zero: res[u32, Fail] = reader.u32(r);
    if (sel res_zero.err) { ret err[Fail].err{res_zero.err}; }
    val res_u32: res[u32, Fail] = reader.u32(r);
    if (sel res_u32.err) { ret err[Fail].err{res_u32.err}; }
    @out = Tls{raw_start: res_start.ok, raw_end: res_end.ok, index_address: res_index.ok, callbacks: res_callbacks.ok, zero_fill: res_zero.ok, characteristics: res_u32.ok};
    ret err[Fail].ok{};
}

# the .CRT$XLA and .CRT$XLZ bounds of the callback array of an image that
# supplies its own TLS directory, each a null pointer named as a CRT names it
fun callback_bounds(c: *Context, o: *Object) res[bool, Fail] {
    val res_supplies: res[bool, Fail] = supplies(c.inputs, c.names, c.resolved, c.live, c.pair.prefix);
    if (sel res_supplies.err) { ret res_supplies; }
    if (!res_supplies.ok)     { ret res[bool, Fail].ok{false}; }
    val opt_pointer_bytes: opt[u8] = arch.pointer_bytes(c.target.arch);
    if (sel opt_pointer_bytes.none)                        { ret res[bool, Fail].err{fail.about(fail.unsupported("the architecture states no address width"), c.target.arch.name)}; }
    if (opt_pointer_bytes.some::usize > NULL_POINTER_SIZE) { ret res[bool, Fail].err{fail.internal("an address is wider than the null pointer the link holds")}; }
    val err_kept: err[Fail] = callbacks_bounded(c.inputs, c.live);
    if (sel err_kept.err) { ret res[bool, Fail].err{err_kept.err}; }
    val err_first: err[Fail] = null_bound(o, TLS_FIRST_SECTION, TLS_FIRST, opt_pointer_bytes.some::u64);
    if (sel err_first.err) { ret res[bool, Fail].err{err_first.err}; }
    val err_last: err[Fail] = null_bound(o, TLS_LAST_SECTION, TLS_LAST, opt_pointer_bytes.some::u64);
    if (sel err_last.err) { ret res[bool, Fail].err{err_last.err}; }
    ret res[bool, Fail].ok{true};
}

# refuse a callback section the link keeps that is not read-only data, as
# the bounds are, since it would lie in another output section, outside the
# array they close
fun callbacks_bounded(inputs: *Inputs, live: *Live) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Ref](?live.kept)) {
        val at: Ref             = live.kept.data[i];
        val o:  *Object         = input.object_of(inputs, at.input);
        val s:  *object.Section = object.section_at(o, at.section);
        i = i + 1;
        val res_section_name: res[View, Fail] = object.section_name(o, s, coff_convention.LAYOUT.naming);
        if (sel res_section_name.err)                                                                      { ret err[Fail].err{res_section_name.err}; }
        if (!starts_with(res_section_name.ok, TLS_CALLBACKS) || section.joined(s.kind) == ?section.RODATA) { cnt; }
        ret err[Fail].err{fail.in_file(fail.unsupported("a thread-local callback section is not read-only data, so it lies outside the bounds of the callback array"), input.at(inputs, at.input).name)};
    }
    ret err[Fail].ok{};
}

fun starts_with(v: View, prefix: str) bool {
    val n: usize = str_len(prefix);
    if (v.len < n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a section of `o` named `section_name` holding a null pointer of `width`
# bytes, which the symbol `name` defines
fun null_bound(o: *Object, section_name: str, name: str, width: u64) err[Fail] {
    val res_name_str: res[Id[Name], Fail] = object.name_str(o, section_name);
    if (sel res_name_str.err) { ret err[Fail].err{res_name_str.err}; }
    val res_held: res[object.Contents, Fail] = object.own(o, ?NULL_POINTER[0], width::usize);
    if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
    val res_sec: res[Id[object.Section], Fail] = object.add_section(o, object.Section{
        name:        opt[Id[Name]].some{res_name_str.ok},
        kind:        ?section.RODATA,
        flags:       section.RODATA.flags,
        align:       width,
        contents:    res_held.ok,
        disposition: ?section.ROOT,
    });
    if (sel res_sec.err) { ret err[Fail].err{res_sec.err}; }
    val res_name: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    val res_sym: res[Id[Symbol], Fail] = object.add_symbol(o, Symbol{
        name:       res_name.ok,
        binding:    ?symbol.GLOBAL,
        visibility: ?symbol.DEFAULT,
        kind:       ?symbol.DATA,
        def:        Definition.placed{object.Place{section: res_sec.ok, offset: 0}},
        size:       object.sized(width),
    });
    if (sel res_sym.err) { ret err[Fail].err{res_sym.err}; }
    ret err[Fail].ok{};
}

# reserve .rsrc, the resource tree, at the end of the read-only data of an
# image whose inputs carry resources
fun declare_resources(in: *reserve.In, out: *Reserved) err[Fail] {
    if (!resource.holds(in.inputs, in.resolved)) { ret err[Fail].ok{}; }
    val res_name: res[str, Fail] = naming.name_of(section.Key{kind: ?section.RESOURCE_TREE});
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    val res_declare: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
        name:      res_name.ok,
        kind:      ?section.RODATA,
        flags:     section.ALLOC,
        align:     resource.DATA_ALIGN,
        sizing:    reserve.Sizing.measured{?RESOURCES},
        placement: reserve.Placement.region_end{?reserve.CONST_END},
        limit:     0xffff_ffff,
        reason:    "the resource tree passes 4 GiB",
    });
    if (sel res_declare.err) { ret err[Fail].err{res_declare.err}; }
    ret err[Fail].ok{};
}

# the bytes the resource tree of the image `img` takes
fun resource_tree(img: *Image) res[u64, Fail] {
    val res_build: res[resource.Tree, Fail] = resource.build(img.inputs.a, img.inputs, img.resolved);
    if (sel res_build.err) { ret res[u64, Fail].err{res_build.err}; }
    var got:     resource.Tree = res_build.ok;
    val size:    u64           = resource.size(?got);
    val err_rel: err[Fail]     = resource.dnit(?got);
    if (sel err_rel.err) { ret res[u64, Fail].err{err_rel.err}; }
    ret res[u64, Fail].ok{size};
}

# the resource tree the image reserved, as a piece of .rsrc, and the
# resource directory naming it, nothing for an image that reserved none
fun resources_out(b: *Build) err[Fail] {
    val opt_measured_of: opt[Id[Reservation]] = measured_of(b.img, ?RESOURCES);
    if (sel opt_measured_of.none) { ret err[Fail].ok{}; }
    val res_placed_of: res[Placed, Fail] = placed_of(b.img, opt_measured_of.some);
    if (sel res_placed_of.err) { ret err[Fail].err{res_placed_of.err}; }
    val size:    u64            = table.at[Reservation](?b.img.reserved.tables, opt_measured_of.some).size;
    val res_rva: res[u32, Fail] = spanned(b, res_placed_of.ok, size, "resource tree");
    if (sel res_rva.err) { ret err[Fail].err{res_rva.err}; }
    val res_build: res[resource.Tree, Fail] = resource.build(b.a, b.img.inputs, b.img.resolved);
    if (sel res_build.err) { ret err[Fail].err{res_build.err}; }
    var tree:         resource.Tree = res_build.ok;
    var out:          Sink          = sink.init(b.a, LITTLE);
    val err_write:    err[Fail]     = resource.write(?tree, res_rva.ok::u64, ?out);
    val err_rel:      err[Fail]     = resource.dnit(?tree);
    val err_raw_tile: err[Fail]     = raw_tile(b, ?out, err_write, res_placed_of.ok.merged, res_placed_of.ok.offset, size);
    if (sel err_raw_tile.err) { ret err[Fail].err{fail.in_record(err_raw_tile.err, "resource tree")}; }
    if (sel err_rel.err)      { ret err_rel; }
    b.resources = DataDirectory{rva: res_rva.ok, size: size::u32};
    ret err[Fail].ok{};
}

# reserve .edata, the export table, at the end of the read-only data of an
# image that exports and whose inputs state exports
fun declare_exports(in: *reserve.In, out: *Reserved) err[Fail] {
    if (!in.exports || !coff_export.declared(in.inputs, in.resolved)) { ret err[Fail].ok{}; }
    val res_declare: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
        name:      EDATA,
        kind:      ?section.RODATA,
        flags:     section.ALLOC,
        align:     EXPORT_ALIGN,
        sizing:    reserve.Sizing.measured{?EXPORT_TABLE},
        placement: reserve.Placement.region_end{?reserve.CONST_END},
        limit:     0xffff_ffff,
        reason:    "the export table passes 4 GiB",
    });
    if (sel res_declare.err) { ret err[Fail].err{res_declare.err}; }
    ret err[Fail].ok{};
}

# the exports of the image `img`, which is named by the file it is written to
fun exports_of(img: *Image) res[Exports, Fail] {
    val res_dll: res[View, Fail] = link_image.file_name(img);
    if (sel res_dll.err) { ret res[Exports, Fail].err{res_dll.err}; }
    val res_arch_of: res[*Pair, Fail] = coff_pairs.of(img.target.arch);
    if (sel res_arch_of.err) { ret res[Exports, Fail].err{res_arch_of.err}; }
    ret coff_export.of(img.inputs.a, img.inputs, img.names, img.resolved, res_arch_of.ok.prefix, res_dll.ok);
}

# the bytes the export table of the image `img` takes
fun export_table(img: *Image) res[u64, Fail] {
    val res_exports_of: res[Exports, Fail] = exports_of(img);
    if (sel res_exports_of.err) { ret res[u64, Fail].err{res_exports_of.err}; }
    var got:     Exports   = res_exports_of.ok;
    val size:    u64       = got.size;
    val err_rel: err[Fail] = coff_export.dnit(?got);
    if (sel err_rel.err) { ret res[u64, Fail].err{err_rel.err}; }
    ret res[u64, Fail].ok{size};
}

# the export table the image reserved, as pieces of .edata, and the export
# directory naming it, nothing for an image that reserved none
fun exports_out(b: *Build) err[Fail] {
    val opt_measured_of: opt[Id[Reservation]] = measured_of(b.img, ?EXPORT_TABLE);
    if (sel opt_measured_of.none) { ret err[Fail].ok{}; }
    val res_exports_of: res[Exports, Fail] = exports_of(b.img);
    if (sel res_exports_of.err) { ret err[Fail].err{res_exports_of.err}; }
    var got:               Exports   = res_exports_of.ok;
    val err_exports_tiled: err[Fail] = exports_tiled(b, opt_measured_of.some, ?got);
    val err_rel:           err[Fail] = coff_export.dnit(?got);
    if (sel err_exports_tiled.err) { ret err[Fail].err{fail.in_record(err_exports_tiled.err, "export table")}; }
    if (sel err_rel.err)           { ret err_rel; }
    ret err[Fail].ok{};
}

fun exports_tiled(b: *Build, r: Id[Reservation], e: *Exports) err[Fail] {
    if (table.at[Reservation](?b.img.reserved.tables, r).size != e.size) { ret err[Fail].err{fail.internal("the export table is not the size layout left for it")}; }
    if (e.size == 0)                                                     { ret err[Fail].ok{}; }
    val res_placed_of: res[Placed, Fail] = placed_of(b.img, r);
    if (sel res_placed_of.err) { ret err[Fail].err{res_placed_of.err}; }
    val res_home: res[u32, Fail] = spanned(b, res_placed_of.ok, e.size, "export table");
    if (sel res_home.err) { ret err[Fail].err{res_home.err}; }
    val base: u32 = res_home.ok;
    b.exports = DataDirectory{rva: res_home.ok, size: e.size::u32};
    val dir: ExportDirectory = ExportDirectory{
        name_rva:       base + e.dll_at::u32,
        ordinal_base:   e.base::u32,
        address_count:  e.slots,
        name_count:     e.named,
        address_rva:    base + e.addresses::u32,
        name_rva_table: base + e.pointers::u32,
        ordinal_rva:    base + e.ordinals::u32,
    };
    val err_tile: err[Fail] = tile(b, res_placed_of.ok.merged, res_placed_of.ok.offset, model.EXPORT_SIZE, Piece.exports{dir});
    if (sel err_tile.err) { ret err_tile; }
    val err_addresses_tile: err[Fail] = addresses_tile(b, e, res_placed_of.ok, base);
    if (sel err_addresses_tile.err) { ret err_addresses_tile; }
    val err_name_tables_tile: err[Fail] = name_tables_tile(b, e, res_placed_of.ok, base);
    if (sel err_name_tables_tile.err) { ret err_name_tables_tile; }
    ret strings_tile(b, e, res_placed_of.ok);
}

# the export address table: per ordinal from the lowest, the offset from the
# image base of what its export exports, or of its forwarder's text in the
# table at `base`, zero for an ordinal no export takes
fun addresses_tile(b: *Build, e: *Exports, at: Placed, base: u32) err[Fail] {
    var words:     Vector[u32] = vector.init[u32](b.a);
    val err_grow:  err[Fail]   = vectors.grow[u32](?words, e.slots::usize);
    var err_tiled: err[Fail]   = err[Fail].ok{};
    if (sel err_grow.err) { err_tiled = err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (sel err_tiled.ok && i < vector.length[Export](?e.list)) {
        val x:                *Export        = ?e.list.data[i];
        val res_exported_rva: res[u32, Fail] = exported_rva(b, x, base);
        i = i + 1;
        if (sel res_exported_rva.err) { err_tiled = err[Fail].err{fail.valued(res_exported_rva.err, x.ordinal::i128)}; }
        or                            { words.data[(x.ordinal - e.base)::usize] = res_exported_rva.ok; }
    }
    if (sel err_tiled.err) {
        val err_dropped: err[Fail] = vectors.dnit[u32](?words);
        ret err_tiled;
    }
    ret tile(b, at.merged, at.offset + e.addresses, e.slots::u64 * 4, Piece.export_words{words});
}

# the offset from the image base of what the export `x` exports, a
# forwarder's being that of its text in the table at `base`
fun exported_rva(b: *Build, x: *Export, base: u32) res[u32, Fail] {
    val t: coff_export.Target = x.target;
    if (sel t.forward) { ret res[u32, Fail].ok{base + x.forward_at::u32}; }
    val bn:           *Binding = table.at[Binding](?b.img.resolved.bindings, t.bound);
    val opt_value_of: opt[u64] = layout.value_of(b.img.layout, bn.input, bn.symbol);
    if (sel opt_value_of.none) { ret res[u32, Fail].err{fail.malformed("an exported definition lies nowhere in the image")}; }
    val res_forwarded: res[u64, Fail] = forwarded(b.img, opt_value_of.some);
    if (sel res_forwarded.err) { ret res[u32, Fail].err{res_forwarded.err}; }
    ret rva_of(b, res_forwarded.ok, "export", x.ordinal::u64);
}

# the name pointer table and the ordinal table: per export found by name, in
# name order, the offset of its name from the image base and its slot in the
# export address table
fun name_tables_tile(b: *Build, e: *Exports, at: Placed, base: u32) err[Fail] {
    if (e.named == 0) { ret err[Fail].ok{}; }
    var pointers:    Vector[u32] = vector.init[u32](b.a);
    var slots:       Vector[u16] = vector.init[u16](b.a);
    var err_reserve: err[Fail]   = vectors.reserve[u32](?pointers, e.named::usize);
    var i:           usize       = 0;
    for (sel err_reserve.ok && i < vector.length[Export](?e.list)) {
        val x: *Export = ?e.list.data[i];
        i = i + 1;
        if (x.noname) { cnt; }
        val err_pointers_pushed: err[Fail] = vectors.push[u32](?pointers, base + x.name_at::u32);
        if (sel err_pointers_pushed.err) { err_reserve = err[Fail].err{err_pointers_pushed.err}; }
        or {
            val err_slots_pushed: err[Fail] = vectors.push[u16](?slots, x.ordinal - e.base);
            if (sel err_slots_pushed.err) { err_reserve = err[Fail].err{err_slots_pushed.err}; }
        }
    }
    if (sel err_reserve.err) {
        val err_dropped: err[Fail] = fail.kept(vectors.dnit[u32](?pointers), vectors.dnit[u16](?slots));
        ret err_reserve;
    }
    val err_tile: err[Fail] = tile(b, at.merged, at.offset + e.pointers, e.named::u64 * 4, Piece.export_words{pointers});
    if (sel err_tile.err) {
        val err_dropped: err[Fail] = vectors.dnit[u16](?slots);
        ret err_tile;
    }
    ret tile(b, at.merged, at.offset + e.ordinals, e.named::u64 * 2, Piece.ordinals{slots});
}

# the names of the exports found by name, in name order, the DLL's name and
# the forwarders' texts, each with its NUL
fun strings_tile(b: *Build, e: *Exports, at: Placed) err[Fail] {
    var out:            Sink      = sink.init(b.a, LITTLE);
    val err_strings_of: err[Fail] = strings_of(e, ?out);
    ret raw_tile(b, ?out, err_strings_of, at.merged, at.offset + e.names, e.size - e.names);
}

fun strings_of(e: *Exports, out: *Sink) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Export](?e.list)) {
        val x: *Export = ?e.list.data[i];
        i = i + 1;
        if (x.noname) { cnt; }
        val err_text_at: err[Fail] = text_at(out, e.names, x.name_at, x.name);
        if (sel err_text_at.err) { ret err_text_at; }
    }
    val err_text_at: err[Fail] = text_at(out, e.names, e.dll_at, e.dll);
    if (sel err_text_at.err) { ret err_text_at; }
    i = 0;
    for (i < vector.length[Export](?e.list)) {
        val x: *Export            = ?e.list.data[i];
        val t: coff_export.Target = x.target;
        i = i + 1;
        if (sel t.forward) {
            val err_text_at: err[Fail] = text_at(out, e.names, x.forward_at, t.forward);
            if (sel err_text_at.err) { ret err_text_at; }
        }
    }
    ret err[Fail].ok{};
}

# the text `v` and its NUL into `out`, whose bytes start `start` into the
# table, at `offset` into it
fun text_at(out: *Sink, start: u64, offset: u64, v: View) err[Fail] {
    if (start + sink.len(out)::u64 != offset) { ret err[Fail].err{fail.internal("a text of the export table does not lie where the table was measured to put it")}; }
    val err_bytes: err[Fail] = sink.bytes(out, v.data, v.len);
    if (sel err_bytes.err) { ret err_bytes; }
    ret sink.u8(out, 0);
}

# the import library of the image `img`, none for an executable whose inputs
# state no export, as a later link has nothing in it to bind against. a DLL
# has one even with no export, as a later link names the DLL through it
fun import_library(a: *A.Allocator, img: *Image) res[opt[Sink], Fail] {
    if (!output.has(img.kind, output.LOADED) && !coff_export.declared(img.inputs, img.resolved)) { ret res[opt[Sink], Fail].ok{opt[Sink].none{}}; }
    val res_made: res[Sink, Fail] = library_of(a, img);
    if (sel res_made.err) { ret res[opt[Sink], Fail].err{res_made.err}; }
    ret res[opt[Sink], Fail].ok{opt[Sink].some{res_made.ok}};
}

# the import library of the image `img`: a short import object for each of its
# exports an import library does not leave out, one found by name naming its
# hint, its index in the name pointer table, and one found by ordinal alone
# naming its ordinal
fun library_of(a: *A.Allocator, img: *Image) res[Sink, Fail] {
    val res_machine_of: res[u16, Fail] = machine_of(img.target.arch);
    if (sel res_machine_of.err) { ret res[Sink, Fail].err{res_machine_of.err}; }
    val res_exports_of: res[Exports, Fail] = exports_of(img);
    if (sel res_exports_of.err) { ret res[Sink, Fail].err{res_exports_of.err}; }
    var got:      Exports                    = res_exports_of.ok;
    var items:    Vector[coff_import.Export] = vector.init[coff_import.Export](a);
    var res_out:  res[Sink, Fail]            = res[Sink, Fail].err{fail.internal("the import library was not written")};
    val err_made: err[Fail]                  = library_exports(?got, ?items);
    if (sel err_made.err) { res_out = res[Sink, Fail].err{err_made.err}; }
    or {
        val dll: Bytes = Bytes{data: got.dll.data, len: got.dll.len};
        res_out = implib.build(a, res_machine_of.ok, dll, items.data, vector.length[coff_import.Export](?items));
    }
    val err_rel: err[Fail] = fail.kept(vectors.dnit[coff_import.Export](?items), coff_export.dnit(?got));
    if (sel res_out.err) { ret res_out; }
    if (sel err_rel.err) {
        var lost:        Sink      = res_out.ok;
        val err_dropped: err[Fail] = sink.dnit(?lost);
        ret res[Sink, Fail].err{err_rel.err};
    }
    ret res_out;
}

# the export each export of `e` an import library does not leave out is to
# an import library, into `out`
fun library_exports(e: *Exports, out: *Vector[coff_import.Export]) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Export](?e.list)) {
        val x: *Export = ?e.list.data[i];
        i = i + 1;
        if (x.private) { cnt; }
        var kind: u64 = tables.IMPORT_OBJECT_CODE.value;
        if (x.data) { kind = tables.IMPORT_OBJECT_DATA.value; }
        var by:   u64 = tables.IMPORT_OBJECT_NAME.value;
        var hint: u16 = x.hint;
        if (x.noname) {
            by   = tables.IMPORT_OBJECT_ORDINAL.value;
            hint = x.ordinal;
        }
        val err_out_pushed: err[Fail] = vectors.push[coff_import.Export](out, coff_import.Export{
            name: Bytes{data: x.name.data, len: x.name.len}, ordinal: hint, kind: kind::u16, name_type: by::u16, export_as: opt[Bytes].none{},
        });
        if (sel err_out_pushed.err) { ret err[Fail].err{err_out_pushed.err}; }
    }
    ret err[Fail].ok{};
}

# the address of the reserved table `t`
fun table_address(img: *Image, t: Id[Reservation]) res[u64, Fail] {
    val res_placed_of: res[Placed, Fail] = placed_of(img, t);
    if (sel res_placed_of.err) { ret res[u64, Fail].err{res_placed_of.err}; }
    ret checked.add(Location{record: "reserved table"}, table.at[Merged](?img.layout.merged, res_placed_of.ok.merged).address, res_placed_of.ok.offset);
}

# the address of the table anchored by `key`, none where the image reserved
# none
fun anchored_address(img: *Image, key: *Anchor) res[opt[u64], Fail] {
    val opt_anchored: opt[Id[Reservation]] = reserve.anchored(img.reserved, key);
    if (sel opt_anchored.none) { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    val res_table_address: res[u64, Fail] = table_address(img, opt_anchored.some);
    if (sel res_table_address.err) { ret res[opt[u64], Fail].err{res_table_address.err}; }
    ret res[opt[u64], Fail].ok{opt[u64].some{res_table_address.ok}};
}

# the address of the auxiliary import address table, zero where the image
# imports nothing
fun aux_address(img: *Image) res[u64, Fail] {
    val opt_held: opt[Id[Reservation]] = img.reserved.held[slot.AUX_IAT.at::usize];
    if (sel opt_held.none) { ret res[u64, Fail].ok{0}; }
    ret table_address(img, opt_held.some);
}

# the native function table of an ARM64EC image, its address and bytes, zero
# where it holds none
rec Rfe {
    address: u64;
    size:    u64;
}

fun rfe_of(img: *Image) Rfe {
    val l: *Layout = img.layout;
    var i: usize   = 0;
    for (i < vector.length[Id[Merged]](?l.order)) {
        val m: *Merged = table.at[Merged](?l.merged, l.order.data[i]);
        i = i + 1;
        if (!kept(m) || m.kind != ?section.FUNCTION_TABLE) { cnt; }
        if (coff_hybrid.x64_functions(img, m))             { cnt; }
        ret Rfe{address: m.address, size: m.size};
    }
    ret Rfe{};
}

# the base relocation sites of the ARM64EC tables of `img`: each auxiliary
# import address and its copy that holds an import check's address, and the
# metadata pointer of the load configuration the link lays
fun hybrid_sites(img: *Image, out: *Vector[u64]) err[Fail] {
    val opt_anchored: opt[Id[Reservation]] = reserve.anchored(img.reserved, ?coff_hybrid.METADATA);
    if (sel opt_anchored.none) { ret err[Fail].ok{}; }
    val res_base: res[u64, Fail] = table_address(img, opt_anchored.some);
    if (sel res_base.err) { ret err[Fail].err{res_base.err}; }
    var p:             coff_hybrid.Plan = coff_hybrid.init(img);
    val err_plan:      err[Fail]        = coff_hybrid.plan(img, ?p);
    var err_aux_sites: err[Fail]        = err_plan;
    if (sel err_plan.ok) { err_aux_sites = aux_sites(img, ?p, res_base.ok, out); }
    err_aux_sites = fail.kept(err_aux_sites, coff_hybrid.dnit(?p));
    if (sel err_aux_sites.err) { ret err_aux_sites; }
    val res_anchored_address: res[opt[u64], Fail] = anchored_address(img, ?coff_hybrid.LOAD_CONFIG);
    if (sel res_anchored_address.err)     { ret err[Fail].err{res_anchored_address.err}; }
    if (sel res_anchored_address.ok.none) { ret err[Fail].ok{}; }
    val err_out_pushed: err[Fail] = vectors.push[u64](out, res_anchored_address.ok.some + coff_hybrid.CHPE_POINTER);
    if (sel err_out_pushed.err) { ret err[Fail].err{err_out_pushed.err}; }
    ret err[Fail].ok{};
}

fun aux_sites(img: *Image, p: *coff_hybrid.Plan, base: u64, out: *Vector[u64]) err[Fail] {
    val res_aux: res[u64, Fail] = aux_address(img);
    if (sel res_aux.err) { ret err[Fail].err{res_aux.err}; }
    var k: usize = 0;
    for (k < vector.length[u64](?p.exits)) {
        val exit: u64 = p.exits.data[k];
        k = k + 1;
        if (exit == 0) { cnt; }
        val opt_slot_of: opt[*reserve.Slot] = reserve.slot_of(img.reserved, ?slot.AUX_IAT, (k - 1)::u32);
        if (sel opt_slot_of.none) { ret err[Fail].err{fail.internal("an import takes no auxiliary address slot")}; }
        val err_out_pushed: err[Fail] = vectors.push[u64](out, res_aux.ok + opt_slot_of.some.offset);
        if (sel err_out_pushed.err) { ret err[Fail].err{err_out_pushed.err}; }
        val err_site_pushed: err[Fail] = vectors.push[u64](out, base + p.copy + opt_slot_of.some.offset);
        if (sel err_site_pushed.err) { ret err[Fail].err{err_site_pushed.err}; }
    }
    ret err[Fail].ok{};
}

# the ARM64EC tables of an image that holds them: the metadata block, the
# auxiliary import address table, the fast-forward sequences, the import
# checks and the link's load configuration, and the load configuration
# directory
fun hybrid_out(b: *Build) err[Fail] {
    val img:          *Image               = b.img;
    val opt_anchored: opt[Id[Reservation]] = reserve.anchored(img.reserved, ?coff_hybrid.METADATA);
    if (sel opt_anchored.none) { ret err[Fail].ok{}; }
    var p:                coff_hybrid.Plan = coff_hybrid.init(img);
    val err_plan:         err[Fail]        = coff_hybrid.plan(img, ?p);
    var err_hybrid_tiled: err[Fail]        = err_plan;
    if (sel err_plan.ok) { err_hybrid_tiled = hybrid_tiled(b, opt_anchored.some, ?p); }
    ret fail.kept(err_hybrid_tiled, coff_hybrid.dnit(?p));
}

fun hybrid_tiled(b: *Build, t: Id[Reservation], p: *coff_hybrid.Plan) err[Fail] {
    val img: *Image = b.img;
    if (table.at[Reservation](?img.reserved.tables, t).size != p.size) { ret err[Fail].err{fail.internal("the ARM64EC tables are not the size layout left for them")}; }
    val res_placed_of: res[Placed, Fail] = placed_of(img, t);
    if (sel res_placed_of.err) { ret err[Fail].err{res_placed_of.err}; }
    val res_base: res[u64, Fail] = table_address(img, t);
    if (sel res_base.err) { ret err[Fail].err{res_base.err}; }
    val res_cells: res[opt[u64], Fail] = anchored_address(img, ?coff_hybrid.CELLS);
    if (sel res_cells.err)     { ret err[Fail].err{res_cells.err}; }
    if (sel res_cells.ok.none) { ret err[Fail].err{fail.internal("the ARM64EC helper cells were never reserved")}; }
    val res_aux: res[u64, Fail] = aux_address(img);
    if (sel res_aux.err) { ret err[Fail].err{res_aux.err}; }
    val res_values: res[Vector[u64], Fail] = aux_values(b, p);
    if (sel res_values.err) { ret err[Fail].err{res_values.err}; }
    var vals:              Vector[u64] = res_values.ok;
    val err_metadata_tile: err[Fail]   = metadata_tile(b, p, res_placed_of.ok, res_base.ok, res_aux.ok, res_cells.ok.some, ?vals);
    var err_aux_tile:      err[Fail]   = err_metadata_tile;
    if (sel err_metadata_tile.ok) { err_aux_tile = aux_tile(b, ?vals); }
    err_aux_tile = fail.kept(err_aux_tile, vectors.dnit[u64](?vals));
    if (sel err_aux_tile.err) { ret err_aux_tile; }
    val err_forwards_tile: err[Fail] = forwards_tile(b, p);
    if (sel err_forwards_tile.err) { ret err_forwards_tile; }
    val err_checks_tile: err[Fail] = checks_tile(b, p, res_cells.ok.some + coff_hybrid.CHECK_CELL::u64 * coff_hybrid.CELL_SIZE);
    if (sel err_checks_tile.err) { ret err_checks_tile; }
    ret load_config_laid(b, res_base.ok);
}

# what each auxiliary import address holds before the loader binds it, by
# its slot: the address of its import's check where a native caller leaves
# for the import through an exit thunk, zero otherwise
fun aux_values(b: *Build, p: *coff_hybrid.Plan) res[Vector[u64], Fail] {
    val img:  *Image      = b.img;
    var out:  Vector[u64] = vector.init[u64](b.a);
    val size: u64         = coff_hybrid.aux_size(img);
    if (size == 0) { ret res[Vector[u64], Fail].ok{out}; }
    val err_grow: err[Fail] = vectors.grow[u64](?out, (size / coff_hybrid.CELL_SIZE)::usize);
    if (sel err_grow.err) {
        val err_dropped: err[Fail] = vectors.dnit[u64](?out);
        ret res[Vector[u64], Fail].err{err_grow.err};
    }
    var k: usize = 0;
    for (k < vector.length[u64](?p.exits)) {
        val exit: u64 = p.exits.data[k];
        k = k + 1;
        if (exit == 0) { cnt; }
        val opt_slot_of: opt[*reserve.Slot] = reserve.slot_of(img.reserved, ?slot.AUX_IAT, (k - 1)::u32);
        val res_chk:     res[u64, Fail]     = layout.slot_address(img.layout, img.reserved, ?slot.IMPORT_CHECK, (k - 1)::u32);
        if (sel opt_slot_of.none) {
            val err_dropped: err[Fail] = vectors.dnit[u64](?out);
            ret res[Vector[u64], Fail].err{fail.internal("an import takes no auxiliary address")};
        }
        if (sel res_chk.err) {
            val err_dropped: err[Fail] = vectors.dnit[u64](?out);
            ret res[Vector[u64], Fail].err{res_chk.err};
        }
        out.data[(opt_slot_of.some.offset / coff_hybrid.CELL_SIZE)::usize] = res_chk.ok;
    }
    ret res[Vector[u64], Fail].ok{out};
}

# the metadata, the code map, the entry ranges, the redirections and the
# copy of the auxiliary import address table, laid at `at`, which lies at
# `base`
fun metadata_tile(b: *Build, p: *coff_hybrid.Plan, at: Placed, base: u64, aux: u64, cells: u64, values: *Vector[u64]) err[Fail] {
    val img:          *Image         = b.img;
    val image:        u64            = b.base;
    val rfe:          Rfe            = rfe_of(img);
    val res_forwards: res[u64, Fail] = forwards_address(img);
    if (sel res_forwards.err) { ret err[Fail].err{res_forwards.err}; }
    var words: [model.ARM64EC_WORDS]u32;
    coff_hybrid.words(p, image, base, aux, rfe.address, rfe.size, cells, ?words);
    var out:     Sink      = sink.init(b.a, LITTLE);
    var err_u32: err[Fail] = err[Fail].ok{};
    var i:       usize     = 0;
    for (sel err_u32.ok && i < model.ARM64EC_WORDS) {
        err_u32 = sink.u32(?out, words[i]);
        i       = i + 1;
    }
    err_u32 = fail.kept(err_u32, sink.zeros(?out, (p.code_map - sink.len(?out)::u64)::usize));
    i       = 0;
    for (sel err_u32.ok && i < vector.length[coff_hybrid.Range](?p.ranges)) {
        val r: coff_hybrid.Range = p.ranges.data[i];
        err_u32 = sink.u32(?out, ((r.start - image) | r.kind)::u32);
        err_u32 = fail.kept(err_u32, sink.u32(?out, r.size::u32));
        i       = i + 1;
    }
    val first: u64 = res_forwards.ok;
    i = 0;
    for (sel err_u32.ok && i < vector.length[u64](?p.forwards)) {
        val thunk: u64 = first + i::u64 * coff_hybrid.FORWARD_SIZE - image;
        err_u32 = sink.u32(?out, thunk::u32);
        err_u32 = fail.kept(err_u32, sink.u32(?out, (thunk + coff_hybrid.FORWARD_SIZE)::u32));
        err_u32 = fail.kept(err_u32, sink.u32(?out, (p.forwards.data[i] - image)::u32));
        i       = i + 1;
    }
    i = 0;
    for (sel err_u32.ok && i < vector.length[u64](?p.forwards)) {
        val thunk: u64 = first + i::u64 * coff_hybrid.FORWARD_SIZE - image;
        err_u32 = sink.u32(?out, thunk::u32);
        err_u32 = fail.kept(err_u32, sink.u32(?out, (p.forwards.data[i] - image)::u32));
        i       = i + 1;
    }
    err_u32 = fail.kept(err_u32, sink.zeros(?out, (p.copy - sink.len(?out)::u64)::usize));
    i       = 0;
    for (sel err_u32.ok && i < vector.length[u64](values)) {
        err_u32 = sink.u64(?out, values.data[i]);
        i       = i + 1;
    }
    ret raw_tile(b, ?out, err_u32, at.merged, at.offset, p.size);
}

# the auxiliary import address table, its slots holding `values`
fun aux_tile(b: *Build, values: *Vector[u64]) err[Fail] {
    val img:      *Image               = b.img;
    val opt_held: opt[Id[Reservation]] = img.reserved.held[slot.AUX_IAT.at::usize];
    if (sel opt_held.none) { ret err[Fail].ok{}; }
    val res_placed_of: res[Placed, Fail] = placed_of(img, opt_held.some);
    if (sel res_placed_of.err) { ret err[Fail].err{res_placed_of.err}; }
    var out:     Sink      = sink.init(b.a, LITTLE);
    var err_u64: err[Fail] = err[Fail].ok{};
    var i:       usize     = 0;
    for (sel err_u64.ok && i < vector.length[u64](values)) {
        err_u64 = sink.u64(?out, values.data[i]);
        i       = i + 1;
    }
    ret raw_tile(b, ?out, err_u64, res_placed_of.ok.merged, res_placed_of.ok.offset, coff_hybrid.aux_size(img));
}

# the address of the fast-forward sequences
fun forwards_address(img: *Image) res[u64, Fail] {
    val opt_measured_of: opt[Id[Reservation]] = measured_of(img, ?coff_hybrid.FAST_FORWARDS);
    if (sel opt_measured_of.none) { ret res[u64, Fail].err{fail.internal("the fast-forward sequences were never reserved")}; }
    ret table_address(img, opt_measured_of.some);
}

# a fast-forward sequence per native function an emulated caller enters
# through one, each jumping to its function
fun forwards_tile(b: *Build, p: *coff_hybrid.Plan) err[Fail] {
    val img:             *Image               = b.img;
    val opt_measured_of: opt[Id[Reservation]] = measured_of(img, ?coff_hybrid.FAST_FORWARDS);
    if (sel opt_measured_of.none) { ret err[Fail].err{fail.internal("the fast-forward sequences were never reserved")}; }
    val n: usize = vector.length[u64](?p.forwards);
    if (table.at[Reservation](?img.reserved.tables, opt_measured_of.some).size != n::u64 * coff_hybrid.FORWARD_SIZE) { ret err[Fail].err{fail.internal("the fast-forward sequences are not the size layout left for them")}; }
    if (n == 0)                                                                                                      { ret err[Fail].ok{}; }
    val res_placed_of: res[Placed, Fail] = placed_of(img, opt_measured_of.some);
    if (sel res_placed_of.err) { ret err[Fail].err{res_placed_of.err}; }
    val res_start: res[u64, Fail] = table_address(img, opt_measured_of.some);
    if (sel res_start.err) { ret err[Fail].err{res_start.err}; }
    val res_chosen: res[*link_template.Template, Fail] = link_template.chosen(img.templates, ?slot.FAST_FORWARD, img.kind, ?img.settled.traits);
    if (sel res_chosen.err) { ret err[Fail].err{res_chosen.err}; }
    var out:       Sink      = sink.init(b.a, LITTLE);
    var err_zeros: err[Fail] = sink.zeros(?out, (n::u64 * coff_hybrid.FORWARD_SIZE)::usize);
    var i:         usize     = 0;
    for (sel err_zeros.ok && i < n) {
        val here:  u64                    = res_start.ok + i::u64 * coff_hybrid.FORWARD_SIZE;
        var bound: [1]link_template.Bound = [1]link_template.Bound{link_template.Bound{target: ?link_template.DESTINATION, value: p.forwards.data[i]}};
        err_zeros = link_template.emit(img.relocs, res_chosen.ok, ?sink.data(?out)[(i::u64 * coff_hybrid.FORWARD_SIZE)::usize], here, ?bound[0], 1);
        i         = i + 1;
    }
    ret raw_tile(b, ?out, err_zeros, res_placed_of.ok.merged, res_placed_of.ok.offset, n::u64 * coff_hybrid.FORWARD_SIZE);
}

# the import check of each import a native caller leaves for through an
# exit thunk, which loads the import's address, names the exit thunk and
# calls the emulator's check through the cell at `check`
fun checks_tile(b: *Build, p: *coff_hybrid.Plan, check: u64) err[Fail] {
    val img:      *Image               = b.img;
    val opt_held: opt[Id[Reservation]] = img.reserved.held[slot.IMPORT_CHECK.at::usize];
    if (sel opt_held.none) { ret err[Fail].ok{}; }
    val rv:            *Reservation      = table.at[Reservation](?img.reserved.tables, opt_held.some);
    val res_placed_of: res[Placed, Fail] = placed_of(img, opt_held.some);
    if (sel res_placed_of.err) { ret err[Fail].err{res_placed_of.err}; }
    val res_start: res[u64, Fail] = table_address(img, opt_held.some);
    if (sel res_start.err) { ret err[Fail].err{res_start.err}; }
    val res_chosen: res[*link_template.Template, Fail] = link_template.chosen(img.templates, ?slot.IMPORT_CHECK_CODE, img.kind, ?img.settled.traits);
    if (sel res_chosen.err) { ret err[Fail].err{res_chosen.err}; }
    var out:       Sink      = sink.init(b.a, LITTLE);
    var err_zeros: err[Fail] = sink.zeros(?out, rv.size::usize);
    var k:         usize     = 0;
    for (sel err_zeros.ok && k < vector.length[u64](?p.exits)) {
        val exit: u64 = p.exits.data[k];
        k = k + 1;
        if (exit == 0) { cnt; }
        val res_own:  res[u64, Fail] = layout.slot_address(img.layout, img.reserved, ?slot.IMPORT_CHECK, (k - 1)::u32);
        val res_cell: res[u64, Fail] = layout.slot_address(img.layout, img.reserved, ?slot.IAT, (k - 1)::u32);
        if (sel res_own.err) {
            err_zeros = err[Fail].err{res_own.err};
            brk;
        }
        if (sel res_cell.err) {
            err_zeros = err[Fail].err{res_cell.err};
            brk;
        }
        var bound: [3]link_template.Bound = [3]link_template.Bound{
            link_template.Bound{target: ?link_template.SLOT, value: res_cell.ok},
            link_template.Bound{target: ?link_template.DESTINATION, value: exit},
            link_template.Bound{target: ?link_template.BINDER, value: check},
        };
        err_zeros = link_template.emit(img.relocs, res_chosen.ok, ?sink.data(?out)[(res_own.ok - res_start.ok)::usize], res_own.ok, ?bound[0], 3);
    }
    ret raw_tile(b, ?out, err_zeros, res_placed_of.ok.merged, res_placed_of.ok.offset, rv.size);
}

# the load configuration the link lays, whose metadata pointer holds the
# metadata at `metadata`, and the directory naming it
fun load_config_laid(b: *Build, metadata: u64) err[Fail] {
    val img:          *Image               = b.img;
    val opt_anchored: opt[Id[Reservation]] = reserve.anchored(img.reserved, ?coff_hybrid.LOAD_CONFIG);
    if (sel opt_anchored.none) { ret err[Fail].ok{}; }
    val res_placed_of: res[Placed, Fail] = placed_of(img, opt_anchored.some);
    if (sel res_placed_of.err) { ret err[Fail].err{res_placed_of.err}; }
    val res_start: res[u64, Fail] = table_address(img, opt_anchored.some);
    if (sel res_start.err) { ret err[Fail].err{res_start.err}; }
    var out:     Sink      = sink.init(b.a, LITTLE);
    var err_u32: err[Fail] = sink.u32(?out, coff_hybrid.LOAD_CONFIG_SIZE::u32);
    err_u32 = fail.kept(err_u32, sink.zeros(?out, (coff_hybrid.CHPE_POINTER - 4)::usize));
    err_u32 = fail.kept(err_u32, sink.u64(?out, metadata));
    val err_raw_tile: err[Fail] = raw_tile(b, ?out, err_u32, res_placed_of.ok.merged, res_placed_of.ok.offset, coff_hybrid.LOAD_CONFIG_SIZE);
    if (sel err_raw_tile.err) { ret err_raw_tile; }
    val res_rva: res[u32, Fail] = rva_of(b, res_start.ok, "load configuration", 0);
    if (sel res_rva.err) { ret err[Fail].err{res_rva.err}; }
    b.load = DataDirectory{rva: res_rva.ok, size: coff_hybrid.LOAD_CONFIG_SIZE::u32};
    ret err[Fail].ok{};
}

# the link name of the load configuration structure, spelled with the C
# prefix of a machine that has one
fun load_config_name(a: *A.Allocator, names: *Interner, prefix: str) res[Id[Name], Fail] {
    var out:      Sink      = sink.init(a, LITTLE);
    var err_text: err[Fail] = sink.text(?out, prefix);
    err_text = fail.kept(err_text, sink.text(?out, coff_hybrid.LOAD_CONFIG_USED));
    if (sel err_text.err) {
        val err_dropped: err[Fail] = sink.dnit(?out);
        ret res[Id[Name], Fail].err{err_text.err};
    }
    val res_intern: res[Id[Name], Fail] = intern.intern(names, sink.data(?out), sink.len(?out));
    val err_rel:    err[Fail]           = sink.dnit(?out);
    if (sel res_intern.err) { ret res_intern; }
    if (sel err_rel.err)    { ret res[Id[Name], Fail].err{err_rel.err}; }
    ret res_intern;
}

# the link asks the archives for the member that defines the load
# configuration structure, as the loader reads it by name and no input refers
# to it. an image with no archive that defines it goes without
pub fun asked(c: *resolve.Context) err[Fail] {
    if (output.has(c.in.kind, output.KEEPS)) { ret err[Fail].ok{}; }
    val res_arch_of: res[*Pair, Fail] = coff_pairs.of(c.in.arch);
    if (sel res_arch_of.err) { ret err[Fail].err{res_arch_of.err}; }
    val res_load_config_name: res[Id[Name], Fail] = load_config_name(c.in.inputs.a, c.in.names, res_arch_of.ok.prefix);
    if (sel res_load_config_name.err) { ret err[Fail].err{res_load_config_name.err}; }
    ret resolve.ask(c, res_load_config_name.ok);
}

val LOAD_CONFIG_CALLED:          Called = Called{name: "_load_config_used", output: Axis{need: output.IMPORTS}};
val LOAD_CONFIG_PREFIXED_CALLED: Called = Called{name: "__load_config_used", output: Axis{need: output.IMPORTS}};

val CALLED_COUNT: usize                 = 2;
val CALLED:       [CALLED_COUNT]*Called = [CALLED_COUNT]*Called{?LOAD_CONFIG_CALLED, ?LOAD_CONFIG_PREFIXED_CALLED};

# the loader reads the load configuration by name, so the section holding it
# stays whatever reaches it, under the spelling of a machine with a C prefix
# or without
pub val CALLS: collect.Calls = collect.Calls{rows: ?CALLED[0], count: CALLED_COUNT};

# the load configuration directory of an image whose input defines
# _load_config_used, which names the structure and whose first word states
# its size, in the layout of the image's word size ("The Load Configuration
# Structure (Image Only)"). an image the link laid one for, or one that has
# none, leaves the directory as it stands
fun load_config_out(b: *Build) err[Fail] {
    val img:      *Image               = b.img;
    val opt_laid: opt[Id[Reservation]] = reserve.anchored(img.reserved, ?coff_hybrid.LOAD_CONFIG);
    if (sel opt_laid.some) { ret err[Fail].ok{}; }
    val res_arch_of: res[*Pair, Fail] = coff_pairs.of(img.target.arch);
    if (sel res_arch_of.err) { ret err[Fail].err{res_arch_of.err}; }
    val res_load_config_name: res[Id[Name], Fail] = load_config_name(b.a, img.names, res_arch_of.ok.prefix);
    if (sel res_load_config_name.err) { ret err[Fail].err{res_load_config_name.err}; }
    val opt_won: opt[resolve.Won] = defined_name(img.resolved, res_load_config_name.ok);
    if (sel opt_won.none) { ret err[Fail].ok{}; }
    val res_address_of: res[u64, Fail] = address_of(img, res_load_config_name.ok, fail.about(fail.malformed("the image does not place the load configuration"), coff_hybrid.LOAD_CONFIG_USED));
    if (sel res_address_of.err) { ret err[Fail].err{res_address_of.err}; }
    val res_size: res[u32, Fail] = word_at(img, res_address_of.ok);
    if (sel res_size.err) { ret err[Fail].err{res_size.err}; }
    val res_rva: res[u32, Fail] = rva_of(b, res_address_of.ok, "load configuration", 0);
    if (sel res_rva.err) { ret err[Fail].err{res_rva.err}; }
    b.load = DataDirectory{rva: res_rva.ok, size: res_size.ok};
    ret err[Fail].ok{};
}

# the relocated 32-bit word at `address`
fun word_at(img: *Image, address: u64) res[u32, Fail] {
    val l: *Layout = img.layout;
    var i: usize   = 0;
    for (i < vector.length[Id[Merged]](?l.order)) {
        val m: *Merged = table.at[Merged](?l.merged, l.order.data[i]);
        i = i + 1;
        if (!kept(m) || !section.has(m.kind, section.BITS))          { cnt; }
        if (address < m.address || address - m.address + 4 > m.size) { cnt; }
        val at:  u64         = m.offset + (address - m.address);
        val rel: *Vector[u8] = ?img.relocated.bytes;
        if (at + 4 > vector.length[u8](rel)::u64) { ret res[u32, Fail].err{fail.internal("a load configuration lies past the relocated bytes")}; }
        var r: Reader = reader.make("load configuration", ?rel.data[at::usize], 4, LITTLE);
        ret reader.u32(?r);
    }
    ret res[u32, Fail].err{fail.malformed("the load configuration lies in no section with bytes")};
}

# the fast-forward sequence an emulated caller enters the native function at
# `address` through, the address itself where none enters it
fun forwarded(img: *Image, address: u64) res[u64, Fail] {
    if (!coff_hybrid.joined(img.target.arch)) { ret res[u64, Fail].ok{address}; }
    var f:                 Vector[u64] = vector.init[u64](img.inputs.a);
    val err_forwards_of:   err[Fail]   = coff_hybrid.forwards_of(img, ?f);
    val opt_forward_index: opt[usize]  = coff_hybrid.forward_index(?f, address);
    val err_rel:           err[Fail]   = vectors.dnit[u64](?f);
    if (sel err_forwards_of.err)    { ret res[u64, Fail].err{err_forwards_of.err}; }
    if (sel err_rel.err)            { ret res[u64, Fail].err{err_rel.err}; }
    if (sel opt_forward_index.none) { ret res[u64, Fail].ok{address}; }
    val res_start: res[u64, Fail] = forwards_address(img);
    if (sel res_start.err) { ret res_start; }
    ret res[u64, Fail].ok{res_start.ok + opt_forward_index.some::u64 * coff_hybrid.FORWARD_SIZE};
}
