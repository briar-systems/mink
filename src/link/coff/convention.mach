# the linking rules of PE/COFF: how an image is laid out and bound
#
# an input section merges into the output section named by its name up to a
# $, ordered there by what follows it, as .CRT$XCA before .CRT$XCU. every
# loaded section starts on a section alignment boundary in memory and a file
# alignment boundary in the file, so offsets and addresses need not agree.
#
# an import binds through the import address table of the DLL that defines it,
# so no definition preempts another image's, nothing is copied and symbols
# carry no versions. a reference to an `__imp_` cell reads the import's
# address table slot, a call to an imported function goes through a thunk that
# jumps through that slot, and imported data is reached only through its cell.
# an address the image holds gets a base relocation, writable or not. an image
# is large address aware, so an absolute address narrower than its addresses
# is refused. the rows are disjoint.
#
# the DWARF debugging sections, which no loader needs, load last in a segment
# of their own, each discardable and named through the string table where
# the name is longer than eight bytes. the CodeView sections are left out, as a program
# database holds them, so none of their relocations is applied. relocatable
# output keeps them. any other section no segment loads is left out of the
# image.
#
# a call to an import goes through a thunk that jumps through the import's
# address slot: on x64 a jump through the slot relative to the instruction,
# padded with int3 to the sixteen bytes a branch target aligns to, and on
# ARM64 the slot's page, a load from it and a branch to what it held. the x86
# thunk jumps through the slot's absolute address, which the loader moves with
# the image, so x86 states no thunk.
#
# an ARM64EC image holds x64 and ARM64EC code. its import thunk is the x64
# one, which an emulated caller reaches through the import's address, and a
# native caller's goes through the import's auxiliary address the way the
# ARM64 thunk goes through its slot. the import check an auxiliary address
# leads to until the loader binds it asks the emulator's check routine for a
# callable form of what the import's address holds, passing the callee's
# exit thunk, and branches to it ("auxiliary IAT" and "exit thunks",
# understanding Arm64EC ABI and assembly code). the fast-forward sequence an
# emulated caller enters an exported native function through is the x64
# prologue the emulator recognizes, ending in a jump to the native code
# ("fast-forward sequences").

use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail.Fail;
use mink.base.rule.Axis;
use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.merge;
use mink.catalog.merge.Rule;
use mink.catalog.output;
use mink.catalog.slot;
use mink.catalog.slot.SlotRole;
use coff_fact: mink.format.coff.neutral.fact;
use mink.format.coff.neutral.naming;
use mink.format.layout.Apart;
use mink.format.layout.Class;
use mink.format.layout.Join;
use mink.format.layout.Load;
use mink.format.layout.Opening;
use mink.format.layout.Rules;
use mink.link.collect.Leaving;
use mink.link.dynamic;
use mink.link.dynamic.Route;
use mink.link.dynamic.Row;
use mink.link.reserve;
use mink.link.reserve.Contents;
use mink.link.reserve.Declarer;
use mink.link.reserve.Order;
use mink.link.reserve.Placement;
use mink.link.reserve.Reserved;
use mink.link.reserve.SlotTable;
use mink.link.reserve.SlotTables;
use mink.link.reserve.Stride;
use mink.link.template;
use mink.link.template.Arched;
use mink.link.template.Patch;
use mink.link.template.Sets;
use mink.link.template.Template;
use mink.model.binding;
use mink.model.reloc;
use mink.model.section;

val CODE:  Load = Load{name: "code", flags: section.ALLOC | section.EXEC};
val CONST: Load = Load{name: "rdata", flags: section.ALLOC};
val DATA:  Load = Load{name: "data", flags: section.ALLOC | section.WRITE};
val DEBUG: Load = Load{name: "debug", flags: 0};

val WRITTEN: section.Flags = section.ALLOC | section.WRITE;

val CLASS_COUNT: usize              = 7;
val CLASSES:     [CLASS_COUNT]Class = [CLASS_COUNT]Class{
    Class{name: "code", rank: 0, flags: Axis{need: section.ALLOC | section.EXEC, deny: section.WRITE}, load: opt[*Load].some{?CODE}},
    Class{name: "rdata", rank: 1, flags: Axis{need: section.ALLOC, deny: section.WRITE | section.EXEC}, load: opt[*Load].some{?CONST}},
    Class{name: "relro", rank: 2, flags: Axis{need: WRITTEN, deny: section.EXEC}, roles: Axis{need: section.RELRO}, load: opt[*Load].some{?DATA}},
    Class{name: "data", rank: 3, flags: Axis{need: WRITTEN, deny: section.EXEC}, roles: Axis{need: section.BITS, deny: section.RELRO}, load: opt[*Load].some{?DATA}},
    Class{name: "bss", rank: 4, flags: Axis{need: WRITTEN, deny: section.EXEC}, roles: Axis{deny: section.BITS | section.RELRO}, load: opt[*Load].some{?DATA}},
    Class{name: "debug", rank: 5, flags: Axis{deny: section.ALLOC}, roles: Axis{need: section.DEBUG}, load: opt[*Load].some{?DEBUG}},
    Class{name: "unloaded", rank: 6, flags: Axis{deny: section.ALLOC}, roles: Axis{deny: section.DEBUG}, load: opt[*Load].none{}},
};

# an image has one thread-local template, whose trailing zeros the TLS
# directory states as its zero fill, so zero-fill .tls$ sections lie in the
# one .tls behind the initialized ones of an equal group (PE Format, The .tls
# Section)
val JOIN_COUNT: usize            = 1;
val JOINS:      [JOIN_COUNT]Join = [JOIN_COUNT]Join{Join{kind: ?section.TLS_BSS, into: ?section.TLS_DATA}};

# the output sections the x64 code of an ARM64EC image and its function
# table lie in, apart from the ARM64EC code and its own, so the code map
# states each section one range of one kind ("code map", ARM64EC ABI) and
# the exception directory names the x64 table while the ARM64EC metadata
# names the native one as its extra table
pub val X64_CODE:      str = ".x64code";
pub val X64_FUNCTIONS: str = ".x64pdat";

val APART_COUNT: usize              = 2;
val APARTS:      [APART_COUNT]Apart = [APART_COUNT]Apart{
    Apart{kind: ?section.TEXT, name: X64_CODE},
    Apart{kind: ?section.FUNCTION_TABLE, name: X64_FUNCTIONS},
};

# the default SectionAlignment and FileAlignment of the PE specification
pub val LAYOUT: Rules = Rules{
    name:          "coff",
    stems:         nil,
    stem_count:    0,
    joint:         0,
    cut:           '$',
    classes:       ?CLASSES[0],
    class_count:   CLASS_COUNT,
    commons:       ".bss",
    opens:         Opening.none{},
    section_align: 0x1000,
    file_align:    0x200,
    sections:      opt[u64].some{1},
    naming:        naming.name_of,
    joins:         ?JOINS[0],
    join_count:    JOIN_COUNT,
    apart:         ?APARTS[0],
    apart_count:   APART_COUNT,
};

pub val LEAVING: Leaving = Leaving{flags: Axis{}, named: naming.CODEVIEW, output: Axis{deny: output.KEEPS}};

val UNPATCHED: u64 = reloc.MARKER | reloc.LOADER;
val FIXED:     u64 = binding.ABSOLUTE | binding.UNDEFINED;

val DYNAMIC_COUNT: usize              = 21;
val DYNAMIC_ROWS:  [DYNAMIC_COUNT]Row = [DYNAMIC_COUNT]Row{
    Row{name: "marker", kind: Axis{need: reloc.MARKER}, outcome: ?dynamic.STATIC},
    Row{
        name:    "loader",
        kind:    Axis{need: reloc.LOADER, deny: reloc.MARKER},
        outcome: ?dynamic.REFUSED,
        reason:  "an object holds a relocation only a loader applies",
    },
    Row{
        name:    "unloaded import",
        kind:    Axis{deny: UNPATCHED},
        target:  Axis{need: binding.IMPORTED | binding.BOUND},
        output:  Axis{deny: output.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "an output no loader binds cannot import from a shared library",
    },
    Row{
        name:    "bound thread",
        kind:    Axis{deny: UNPATCHED},
        target:  Axis{need: binding.BOUND | binding.DATA | binding.THREAD},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "thread-local data of another image cannot be referred to",
    },
    Row{
        name:    "bound got",
        kind:    Axis{need: reloc.GOT, deny: UNPATCHED},
        target:  Axis{need: binding.BOUND, deny: binding.THREAD},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "the format has no GOT",
    },
    Row{
        name:    "cell",
        kind:    Axis{deny: UNPATCHED | reloc.GOT},
        target:  Axis{need: binding.BOUND | binding.DATA | binding.CELL, deny: binding.THREAD},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.GOT_BIND,
    },
    Row{
        name:    "thunk word",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{need: dynamic.WORD},
        target:  Axis{need: binding.BOUND | binding.CODE, deny: binding.DATA},
        output:  Axis{need: output.IMPORTS | output.PIC},
        outcome: ?dynamic.PLT_BIND_REBASE,
    },
    Row{
        name:    "thunk narrow",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{deny: dynamic.WORD},
        target:  Axis{need: binding.BOUND | binding.CODE, deny: binding.DATA},
        output:  Axis{need: output.IMPORTS | output.PIC},
        outcome: ?dynamic.REFUSED,
        reason:  "an absolute reference narrower than an address cannot be made position independent",
    },
    Row{
        name:    "thunk",
        kind:    Axis{deny: UNPATCHED | reloc.GOT | reloc.ABS},
        target:  Axis{need: binding.BOUND | binding.CODE, deny: binding.DATA},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.PLT_BIND,
    },
    Row{
        name:    "thunk fixed",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        target:  Axis{need: binding.BOUND | binding.CODE, deny: binding.DATA},
        output:  Axis{need: output.IMPORTS, deny: output.PIC},
        outcome: ?dynamic.PLT_BIND,
    },
    Row{
        name:    "imported data",
        kind:    Axis{deny: UNPATCHED | reloc.GOT},
        target:  Axis{need: binding.BOUND | binding.DATA, deny: binding.CODE | binding.THREAD | binding.CELL},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "imported data is reached only through its import address cell",
    },
    Row{
        name:    "bound",
        kind:    Axis{deny: UNPATCHED | reloc.GOT},
        target:  Axis{need: binding.BOUND, deny: binding.CODE | binding.DATA},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "a reference of this kind cannot reach a symbol the loader binds",
    },
    Row{
        name:    "got",
        kind:    Axis{need: reloc.GOT, deny: UNPATCHED},
        target:  Axis{deny: binding.BOUND},
        outcome: ?dynamic.REFUSED,
        reason:  "the format has no GOT",
    },
    Row{
        name:    "static",
        kind:    Axis{deny: UNPATCHED | reloc.GOT | reloc.ABS},
        target:  Axis{deny: binding.BOUND},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "rebase",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{need: dynamic.WORD},
        target:  Axis{deny: FIXED | binding.BOUND},
        output:  Axis{need: output.PIC},
        outcome: ?dynamic.REBASE,
    },
    Row{
        name:    "narrow",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{deny: dynamic.WORD | dynamic.LOW},
        target:  Axis{deny: FIXED | binding.BOUND},
        output:  Axis{need: output.PIC},
        outcome: ?dynamic.REFUSED,
        reason:  "an absolute reference narrower than an address cannot be made position independent",
    },
    Row{
        name:    "low",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{need: dynamic.LOW, deny: dynamic.WORD},
        target:  Axis{deny: FIXED | binding.BOUND},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "absolute fixed",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        target:  Axis{need: binding.ABSOLUTE, deny: binding.BOUND},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "absolute undefined",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        target:  Axis{need: binding.UNDEFINED, deny: binding.BOUND | binding.ABSOLUTE},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "absolute",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{need: dynamic.WORD},
        target:  Axis{deny: FIXED | binding.BOUND},
        output:  Axis{deny: output.PIC},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "narrow fixed",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{deny: dynamic.WORD | dynamic.LOW},
        target:  Axis{deny: FIXED | binding.BOUND},
        output:  Axis{deny: output.PIC},
        outcome: ?dynamic.REFUSED,
        reason:  "a large address aware image holds no absolute address narrower than its addresses",
    },
};
# a reference to a cell lands in the import's address table slot, and a call
# to an import goes through a thunk that jumps through that slot. a native
# caller of an ARM64EC image reaches an import through its auxiliary cell
# and the `#` thunk that jumps through it instead
val ROUTE_COUNT: usize              = 4;
val ROUTES:      [ROUTE_COUNT]Route = [ROUTE_COUNT]Route{
    Route{name: "cell", reach: dynamic.AT_GOT, target: Axis{deny: binding.NATIVE}, role: ?slot.IAT, stands: true},
    Route{name: "thunk", reach: dynamic.AT_PLT, target: Axis{deny: binding.NATIVE}, role: ?slot.IAT, through: opt[*SlotRole].some{?slot.IMPORT_THUNK}},
    Route{name: "native cell", reach: dynamic.AT_GOT, target: Axis{need: binding.NATIVE}, role: ?slot.AUX_IAT, stands: true},
    Route{name: "native thunk", reach: dynamic.AT_PLT, target: Axis{need: binding.NATIVE}, role: ?slot.AUX_IAT, through: opt[*SlotRole].some{?slot.NATIVE_IMPORT_THUNK}},
};

# the section the import address table and the import tables lie in
pub val IDATA: str = ".idata";

# the import address table: a slot per import, which the loader fills with
# the import's address, in a run per DLL closed by an empty slot. it lies in
# .idata with the import tables the image writer lays there
val IAT_TABLE: SlotTable = SlotTable{
    role:      ?slot.IAT,
    name:      IDATA,
    kind:      ?section.RELRO_DATA,
    flags:     section.ALLOC | section.WRITE,
    contents:  Contents.written{},
    entry:     Stride.slot{},
    order:     Order.by_library{},
    placement: Placement.region_end{?reserve.RELRO_END},
    limit:     0xffff_ffff,
    reason:    "the import address table passes 4 GiB",
};

# the import thunks: per import a call reaches, its role's template, at the
# end of the code
val THUNK_TABLE: SlotTable = SlotTable{
    role:      ?slot.IMPORT_THUNK,
    name:      ".text",
    kind:      ?section.TEXT,
    flags:     section.ALLOC | section.EXEC,
    contents:  Contents.code{},
    entry:     Stride.slot{},
    order:     Order.reached{},
    placement: Placement.region_end{?reserve.CODE_END},
    limit:     0xffff_ffff,
    reason:    "the import thunks pass 4 GiB",
};

# the veneers a branch past its reach goes through, its role's template
# each, in islands among the code, each island right before or right after
# the input section whose branches first needed it
val ISLAND_TABLE: SlotTable = SlotTable{
    role:      ?slot.ISLAND,
    name:      ".text",
    kind:      ?section.TEXT,
    flags:     section.ALLOC | section.EXEC,
    contents:  Contents.code{},
    entry:     Stride.slot{},
    order:     Order.reached{},
    placement: Placement.islands{?reserve.CODE_END},
    limit:     0xffff_ffff,
    reason:    "an island passes 4 GiB",
};

val SLOT_COUNT: usize                  = 3;
val SLOT_ROWS:  [SLOT_COUNT]*SlotTable = [SLOT_COUNT]*SlotTable{?IAT_TABLE, ?THUNK_TABLE, ?ISLAND_TABLE};
val SLOTS_ROWS: SlotTables             = SlotTables{rows: ?SLOT_ROWS[0], count: SLOT_COUNT};

# the import thunks of an ARM64EC image, x64 code an emulated caller jumps
# through, with the image's other x64 code
val X64_THUNK_TABLE: SlotTable = SlotTable{
    role:      ?slot.IMPORT_THUNK,
    name:      X64_CODE,
    kind:      ?section.TEXT,
    flags:     section.ALLOC | section.EXEC,
    contents:  Contents.code{},
    entry:     Stride.slot{},
    order:     Order.reached{},
    placement: Placement.region_end{?reserve.CODE_END},
    limit:     0xffff_ffff,
    reason:    "the import thunks pass 4 GiB",
};

# the auxiliary import address table: slot for slot beside the import
# address table, each holding the address of its import's check until the
# loader binds it to native code. the image writer fills it
val AUX_IAT_TABLE: SlotTable = SlotTable{
    role:      ?slot.AUX_IAT,
    name:      IDATA,
    kind:      ?section.RELRO_DATA,
    flags:     section.ALLOC | section.WRITE,
    contents:  Contents.written{},
    entry:     Stride.slot{},
    order:     Order.along{?slot.IAT},
    placement: Placement.region_end{?reserve.RELRO_END},
    limit:     0xffff_ffff,
    reason:    "the auxiliary import address table passes 4 GiB",
};

# the thunks a native caller's call to an import goes through, each jumping
# through the import's auxiliary address
val NATIVE_THUNK_TABLE: SlotTable = SlotTable{
    role:      ?slot.NATIVE_IMPORT_THUNK,
    name:      ".text",
    kind:      ?section.TEXT,
    flags:     section.ALLOC | section.EXEC,
    contents:  Contents.code{},
    entry:     Stride.slot{},
    order:     Order.reached{},
    placement: Placement.region_end{?reserve.CODE_END},
    limit:     0xffff_ffff,
    reason:    "the native import thunks pass 4 GiB",
};

# the import checks, one beside each import address, which the image writer
# emits for each import a native caller leaves for through an exit thunk
val IMPORT_CHECK_TABLE: SlotTable = SlotTable{
    role:      ?slot.IMPORT_CHECK,
    name:      ".text",
    kind:      ?section.TEXT,
    flags:     section.ALLOC | section.EXEC,
    contents:  Contents.emitted{},
    entry:     Stride.slot{},
    order:     Order.along{?slot.IAT},
    placement: Placement.region_end{?reserve.CODE_END},
    limit:     0xffff_ffff,
    reason:    "the import checks pass 4 GiB",
};

val HYBRID_SLOT_COUNT: usize                         = 6;
val HYBRID_SLOT_ROWS:  [HYBRID_SLOT_COUNT]*SlotTable = [HYBRID_SLOT_COUNT]*SlotTable{
    ?IAT_TABLE, ?X64_THUNK_TABLE, ?ISLAND_TABLE, ?AUX_IAT_TABLE, ?NATIVE_THUNK_TABLE, ?IMPORT_CHECK_TABLE,
};
val HYBRID_SLOTS_ROWS: SlotTables = SlotTables{rows: ?HYBRID_SLOT_ROWS[0], count: HYBRID_SLOT_COUNT};

# the slot tables of the link: an image whose architecture joins another
# lays the tables of both conventions
fun declare_slots(in: *reserve.In, out: *Reserved) err[Fail] {
    if (sel in.arch.joins.some) { ret reserve.declare_slots(in, out, ?HYBRID_SLOTS_ROWS); }
    ret reserve.declare_slots(in, out, ?SLOTS_ROWS);
}

# the COFF slot tables the dynamic phase's entries reach
pub val SLOTS: Declarer = Declarer{declare: declare_slots};

pub val DYNAMIC: dynamic.Rules = dynamic.Rules{name: "coff", caps: 0, rows: ?DYNAMIC_ROWS[0], count: DYNAMIC_COUNT, routes: ?ROUTES[0], route_count: ROUTE_COUNT};

# how settle combines the COFF facts. each describes the object, one of its
# sections or one of its symbols, and travels with it
val FACT_COUNT: usize            = 7;
val FACT_ROWS:  [FACT_COUNT]Rule = [FACT_COUNT]Rule{
    Rule{key: coff_fact.TIMESTAMP, by: ?merge.BY_KEY, merge: ?merge.LOCAL},
    Rule{key: coff_fact.CHARACTERISTICS, by: ?merge.BY_KEY, merge: ?merge.LOCAL},
    Rule{key: coff_fact.SECTION, by: ?merge.BY_VALUE, merge: ?merge.LOCAL},
    Rule{key: coff_fact.CHECKSUM, by: ?merge.BY_VALUE, merge: ?merge.LOCAL},
    Rule{key: coff_fact.CLASS, by: ?merge.BY_VALUE, merge: ?merge.LOCAL},
    Rule{key: coff_fact.TYPE, by: ?merge.BY_VALUE, merge: ?merge.LOCAL},
    Rule{key: coff_fact.NUMBER, by: ?merge.BY_VALUE, merge: ?merge.LOCAL},
};
pub val FACTS: merge.Rules = merge.Rules{rows: ?FACT_ROWS[0], count: FACT_COUNT};

val X64_THUNK_BYTES:   [16]u8      = [16]u8{0xff, 0x25, 0, 0, 0, 0, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc};
val X64_THUNK_PATCHES: [1]Patch    = [1]Patch{Patch{offset: 2, kind: ?reloc.PC32, target: ?template.SLOT, addend: -4}};
val X64_THUNKS:        [1]Template = [1]Template{
    Template{role: ?slot.THUNK, variant: ?template.PLAIN, name: "x64 import thunk", bytes: ?X64_THUNK_BYTES[0], len: 16, align: 16, patches: ?X64_THUNK_PATCHES[0], patch_count: 1},
};
val X64_ROWS:      [1]*Template = [1]*Template{?X64_THUNKS[0]};
val X64_TEMPLATES: template.Set = template.Set{rows: ?X64_ROWS[0], roles: ?X64_ROWS[0], count: 1};

val ARM64_THUNK_BYTES:   [12]u8   = [12]u8{0x10, 0x00, 0x00, 0x90, 0x10, 0x02, 0x40, 0xf9, 0x00, 0x02, 0x1f, 0xd6};
val ARM64_THUNK_PATCHES: [2]Patch = [2]Patch{
    Patch{offset: 0, kind: ?reloc.PAGE21, target: ?template.SLOT},
    Patch{offset: 4, kind: ?reloc.LO12_LDST64, target: ?template.SLOT},
};
# adrp x16, the destination's page, add x16, x16, its offset in the page, and
# br x16, the veneer of a branch past its reach
val ARM64_VENEER_BYTES:   [12]u8   = [12]u8{0x10, 0x00, 0x00, 0x90, 0x10, 0x02, 0x00, 0x91, 0x00, 0x02, 0x1f, 0xd6};
val ARM64_VENEER_PATCHES: [2]Patch = [2]Patch{
    Patch{offset: 0, kind: ?reloc.PAGE21, target: ?template.DESTINATION},
    Patch{offset: 4, kind: ?reloc.LO12_ADD, target: ?template.DESTINATION},
};
val ARM64_THUNKS: [2]Template = [2]Template{
    Template{role: ?slot.THUNK, variant: ?template.PLAIN, name: "arm64 import thunk", bytes: ?ARM64_THUNK_BYTES[0], len: 12, align: 4, patches: ?ARM64_THUNK_PATCHES[0], patch_count: 2},
    Template{role: ?slot.VENEER, variant: ?template.PLAIN, name: "arm64 veneer", bytes: ?ARM64_VENEER_BYTES[0], len: 12, align: 4, patches: ?ARM64_VENEER_PATCHES[0], patch_count: 2},
};
val ARM64_ROWS:      [2]*Template = [2]*Template{?ARM64_THUNKS[0], ?ARM64_THUNKS[1]};
val ARM64_TEMPLATES: template.Set = template.Set{rows: ?ARM64_ROWS[0], roles: ?ARM64_ROWS[0], count: 2};

# the slot role's x64 thunk patched through the ARM64EC rows, whose REL32 is
# the x64 one's
val EC_THUNK_PATCHES: [1]Patch = [1]Patch{Patch{offset: 2, kind: ?reloc.PC32, target: ?template.SLOT, addend: -4}};
# adrp x11, the import address's page, ldr x11 from it, adrp x10 and add x10,
# the exit thunk, adrp x9 and ldr x9, the check routine's cell, stp x29, x30,
# mov x29, sp, blr x9, ldp x29, x30 and br x11
val EC_CHECK_BYTES: [44]u8 = [44]u8{
    0x0b, 0x00, 0x00, 0x90, 0x6b, 0x01, 0x40, 0xf9, 0x0a, 0x00, 0x00, 0x90, 0x4a, 0x01, 0x00, 0x91,
    0x09, 0x00, 0x00, 0x90, 0x29, 0x01, 0x40, 0xf9, 0xfd, 0x7b, 0xbf, 0xa9, 0xfd, 0x03, 0x00, 0x91,
    0x20, 0x01, 0x3f, 0xd6, 0xfd, 0x7b, 0xc1, 0xa8, 0x60, 0x01, 0x1f, 0xd6,
};
val EC_CHECK_PATCHES: [6]Patch = [6]Patch{
    Patch{offset: 0, kind: ?reloc.PAGE21, target: ?template.SLOT},
    Patch{offset: 4, kind: ?reloc.LO12_LDST64, target: ?template.SLOT},
    Patch{offset: 8, kind: ?reloc.PAGE21, target: ?template.DESTINATION},
    Patch{offset: 12, kind: ?reloc.LO12_ADD, target: ?template.DESTINATION},
    Patch{offset: 16, kind: ?reloc.PAGE21, target: ?template.BINDER},
    Patch{offset: 20, kind: ?reloc.LO12_LDST64, target: ?template.BINDER},
};
# mov rax, rsp, mov [rax+0x20], rbx, push rbp, pop rbp, jmp to the native
# code and int3 to sixteen bytes
val EC_FAST_FORWARD_BYTES:   [16]u8      = [16]u8{0x48, 0x8b, 0xc4, 0x48, 0x89, 0x58, 0x20, 0x55, 0x5d, 0xe9, 0, 0, 0, 0, 0xcc, 0xcc};
val EC_FAST_FORWARD_PATCHES: [1]Patch    = [1]Patch{Patch{offset: 10, kind: ?reloc.PC32, target: ?template.DESTINATION, addend: -4}};
val EC_THUNKS:               [5]Template = [5]Template{
    Template{role: ?slot.THUNK, variant: ?template.PLAIN, name: "arm64ec import thunk", bytes: ?X64_THUNK_BYTES[0], len: 16, align: 16, patches: ?EC_THUNK_PATCHES[0], patch_count: 1},
    Template{role: ?slot.NATIVE_THUNK_CODE, variant: ?template.PLAIN, name: "arm64ec native import thunk", bytes: ?ARM64_THUNK_BYTES[0], len: 12, align: 4, patches: ?ARM64_THUNK_PATCHES[0], patch_count: 2},
    Template{role: ?slot.IMPORT_CHECK_CODE, variant: ?template.PLAIN, name: "arm64ec import check", bytes: ?EC_CHECK_BYTES[0], len: 44, align: 4, patches: ?EC_CHECK_PATCHES[0], patch_count: 6},
    Template{role: ?slot.FAST_FORWARD, variant: ?template.PLAIN, name: "arm64ec fast-forward sequence", bytes: ?EC_FAST_FORWARD_BYTES[0], len: 16, align: 16, patches: ?EC_FAST_FORWARD_PATCHES[0], patch_count: 1},
    Template{role: ?slot.VENEER, variant: ?template.PLAIN, name: "arm64ec veneer", bytes: ?ARM64_VENEER_BYTES[0], len: 12, align: 4, patches: ?ARM64_VENEER_PATCHES[0], patch_count: 2},
};
val EC_ROWS:      [5]*Template = [5]*Template{?EC_THUNKS[0], ?EC_THUNKS[1], ?EC_THUNKS[2], ?EC_THUNKS[3], ?EC_THUNKS[4]};
val EC_ROLES:     [5]*Template = [5]*Template{?EC_THUNKS[3], ?EC_THUNKS[2], ?EC_THUNKS[1], ?EC_THUNKS[0], ?EC_THUNKS[4]};
val EC_TEMPLATES: template.Set = template.Set{rows: ?EC_ROWS[0], roles: ?EC_ROLES[0], count: 5};

val SET_COUNT: usize             = 3;
val SET_ROWS:  [SET_COUNT]Arched = [SET_COUNT]Arched{
    Arched{arch: ?x86.X86_64, set: ?X64_TEMPLATES},
    Arched{arch: ?aarch64.AARCH64, set: ?ARM64_TEMPLATES},
    Arched{arch: ?aarch64.ARM64EC, set: ?EC_TEMPLATES},
};

pub val TEMPLATES: Sets = Sets{rows: ?SET_ROWS[0], count: SET_COUNT};
