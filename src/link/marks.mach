# the mapping symbols that mark the islands a link lays
#
# a pair that marks code and data with mapping symbols reads the bytes from
# one up to the next as what it marks, so an island the link lays among the
# input sections is marked as code at its start, and the bytes after it are
# marked again with the mapping in effect where the island now lies: the
# last mapping symbol of the input sections laid before it in its output
# section. a section that marks its own start needs no mark after an island
# laid right before it, a code mapping in effect needs none either, and where
# no mapping is in effect the bytes after an island stay as the island
# leaves them.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.format.pair.Mapping;
use mink.link.collect.Ref;
use mink.link.input;
use mink.link.input.Input;
use mink.link.input.Inputs;
use mink.link.layout;
use mink.link.layout.Isles;
use mink.link.layout.Landing;
use mink.link.layout.Layout;
use mink.link.layout.Merged;
use mink.link.layout.Placed;
use mink.link.reserve;
use mink.link.reserve.Reserved;
use mink.link.resolve;
use mink.link.resolve.Resolved;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Symbol;

# a mapping symbol the link adds
# ---
# merged:  the output section it lies in
# address: where it lies
# name:    its name
pub rec Mark {
    merged:  Id[Merged];
    address: u64;
    name:    View;
}

# what marks one landing's input section
# ---
# last:   the name of its last mapping symbol, nil data for none
# offset: where that symbol lies in the section
# starts: a mapping symbol marks the section's own start
rec Marked {
    last:   View;
    offset: u64;
    starts: bool;
}

# a landing in output order
rec Laid {
    merged:  u32;
    offset:  u64;
    landing: u32;
}

fun order_laid(a: *Laid, b: *Laid) i64 {
    if (a.merged != b.merged)   { ret ordered(a.merged < b.merged); }
    if (a.offset != b.offset)   { ret ordered(a.offset < b.offset); }
    if (a.landing != b.landing) { ret ordered(a.landing < b.landing); }
    ret 0;
}

fun ordered(less: bool) i64 {
    if (less) { ret -1; }
    ret 1;
}

# the marks of every island `r` holds as `l` laid it out into `out`, in output
# order, the symbols of the object inputs of `inputs` that `resolved` does not
# take from a library naming the mapping in effect, none for a pair with no
# mapping symbols
pub fun islands(a: *A.Allocator, inputs: *Inputs, resolved: *Resolved, l: *Layout, r: *Reserved, mapping: opt[*Mapping], out: *Table[Mark]) err[Fail] {
    table.clear[Mark](out);
    if (sel mapping.none)                             { ret err[Fail].ok{}; }
    if (table.count[reserve.Island](?r.islands) == 0) { ret err[Fail].ok{}; }
    var w: Walk = Walk{
        inputs:   inputs,
        resolved: resolved,
        l:        l,
        r:        r,
        mapping:  mapping.some,
        out:      out,
        marked:   table.make[Marked](a),
        laid:     table.make[Laid](a),
        isles:    table.make[Isles](a),
    };
    var e: err[Fail] = walked(?w);
    e = fail.kept(e, table.release[Marked](?w.marked));
    e = fail.kept(e, table.release[Laid](?w.laid));
    ret fail.kept(e, table.release[Isles](?w.isles));
}

# what one marking reads and makes
# ---
# marked: per landing, what marks its input section
# laid:   the landings in output order
# isles:  per landing, the islands beside it
rec Walk {
    inputs:   *Inputs;
    resolved: *Resolved;
    l:        *Layout;
    r:        *Reserved;
    mapping:  *Mapping;
    out:      *Table[Mark];
    marked:   Table[Marked];
    laid:     Table[Laid];
    isles:    Table[Isles];
}

fun walked(w: *Walk) err[Fail] {
    val s: err[Fail] = layout.sides(w.l, w.r, ?w.isles);
    if (sel s.err) { ret s; }
    val n: usize                 = table.count[Landing](?w.l.landings);
    val g: res[Id[Marked], Fail] = table.grow[Marked](?w.marked, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < input.count(w.inputs)) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(w.inputs, id);
        i = i + 1;
        if (o == nil || resolve.library(w.resolved, id)) { cnt; }
        noted(w, id, o);
    }
    var k: usize = 0;
    for (k < n) {
        val at: *Landing            = table.at[Landing](?w.l.landings, table.nth[Landing](k));
        val p:  res[Id[Laid], Fail] = table.push[Laid](?w.laid, Laid{merged: at.merged.index, offset: at.offset, landing: k::u32});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        k = k + 1;
    }
    sort.sort_by[Laid](table.items[Laid](?w.laid), n, order_laid);
    var carry: View  = View{data: nil, len: 0};
    var j:     usize = 0;
    for (j < n) {
        val here: Laid = table.items[Laid](?w.laid)[j];
        if (j == 0 || table.items[Laid](?w.laid)[j - 1].merged != here.merged) { carry = View{data: nil, len: 0}; }
        j = j + 1;
        val side: Isles   = table.items[Isles](?w.isles)[here.landing::usize];
        val own:  *Marked = ?table.items[Marked](?w.marked)[here.landing::usize];
        if (side.before != 0) {
            var restore: View = carry;
            if (own.starts) { restore = View{data: nil, len: 0}; }
            val e: err[Fail] = marked_island(w, side.before - 1, restore);
            if (sel e.err) { ret e; }
        }
        if (own.last.data != nil) { carry = own.last; }
        if (side.after == 0)      { cnt; }
        var restore: View = carry;
        if (j < n) {
            val next: Laid = table.items[Laid](?w.laid)[j];
            if (next.merged == here.merged && table.items[Marked](?w.marked)[next.landing::usize].starts) { restore = View{data: nil, len: 0}; }
        }
        val e: err[Fail] = marked_island(w, side.after - 1, restore);
        if (sel e.err) { ret e; }
    }
    ret err[Fail].ok{};
}

# note each mapping symbol of `o` against the landing of the section it lies
# in: the last of each section and whether one marks its start
fun noted(w: *Walk, id: Id[Input], o: *Object) {
    var k: usize = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val s: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
        k = k + 1;
        val def: object.Definition = s.def;
        if (!sel def.placed) { cnt; }
        val name: View = object.name_of(o, s.name);
        if (!maps(w.mapping, name)) { cnt; }
        val lid: opt[Id[Landing]] = layout.landing_of(w.l, Ref{input: id, section: def.placed.section});
        if (sel lid.none) { cnt; }
        val g: *Landing = table.at[Landing](?w.l.landings, lid.some);
        if (def.placed.offset > g.source) { cnt; }
        val m: *Marked = ?table.items[Marked](?w.marked)[lid.some.index::usize];
        if (def.placed.offset == 0) { m.starts = true; }
        if (m.last.data == nil || def.placed.offset >= m.offset) {
            m.last   = name;
            m.offset = def.placed.offset;
        }
    }
}

# whether `name` is a mapping symbol of `m`: its data symbol, its code
# symbol, or where the pair allows one, its code symbol's stem followed by
# the instruction set it marks
fun maps(m: *Mapping, name: View) bool {
    if (same(name, m.data, str_len(m.data))) { ret true; }
    val stem: usize = str_len(m.code);
    if (same(name, m.code, stem)) { ret true; }
    ret m.per_view && name.len > stem && same(View{data: name.data, len: stem}, m.code, stem);
}

fun same(v: View, s: str, n: usize) bool {
    if (v.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# mark the island `i` as code at its start and, where `restore` names a
# mapping, the bytes after it with that mapping at its end
fun marked_island(w: *Walk, i: u32, restore: View) err[Fail] {
    if (i::usize >= table.count[Placed](?w.l.islands)) { ret err[Fail].err{fail.internal("an island was never laid")}; }
    val p:     Placed          = table.items[Placed](?w.l.islands)[i::usize];
    val m:     *Merged         = table.at[Merged](?w.l.merged, p.merged);
    val isle:  *reserve.Island = table.at[reserve.Island](?w.r.islands, table.nth[reserve.Island](i::usize));
    val at:    Location        = Location{record: "island"};
    val start: res[u64, Fail]  = checked.add(at, m.address, p.offset);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    val code: Mark                = Mark{merged: p.merged, address: start.ok, name: View{data: w.mapping.code, len: str_len(w.mapping.code)}};
    val c:    res[Id[Mark], Fail] = table.push[Mark](w.out, code);
    if (sel c.err)                                                           { ret err[Fail].err{c.err}; }
    if (restore.data == nil || same(restore, w.mapping.code, code.name.len)) { ret err[Fail].ok{}; }
    val end: res[u64, Fail] = checked.add(at, start.ok, isle.size);
    if (sel end.err) { ret err[Fail].err{end.err}; }
    val b: res[Id[Mark], Fail] = table.push[Mark](w.out, Mark{merged: p.merged, address: end.ok, name: restore});
    if (sel b.err) { ret err[Fail].err{b.err}; }
    ret err[Fail].ok{};
}
