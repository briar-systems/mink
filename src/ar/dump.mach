# the text form of an archive
#
# the archive, then each member in order with its header fields as written,
# and under a symbol table each of its entries.

use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use mink.ar.model;
use mink.ar.model.Archive;
use mink.ar.model.Entry;
use mink.ar.model.Member;
use mink.fail.Fail;
use mink.format.dump;
use mink.format.dump.Dumper;
use mink.store.Bytes;
use mink.table;

pub val ARCHIVE:       u32 = 0;
pub val MAGIC:         u32 = 1;
pub val MEMBER:        u32 = 2;
pub val NAME:          u32 = 3;
pub val ROLE:          u32 = 4;
pub val OFFSET:        u32 = 5;
pub val DATE:          u32 = 6;
pub val USER:          u32 = 7;
pub val GROUP:         u32 = 8;
pub val MODE:          u32 = 9;
pub val SIZE:          u32 = 10;
pub val SYMBOL:        u32 = 11;
pub val MEMBER_OFFSET: u32 = 12;
pub val HELD:          u32 = 13;

pub val FIELD_COUNT: usize   = 14;
pub val FIELDS:      [14]str = [14]str{
    "Archive", "Magic", "Member", "Name", "Role", "Offset", "Date",
    "UserID", "GroupID", "Mode", "Size", "Symbol", "MemberOffset", "Held",
};

pub fun describe(arch: *Archive, d: *Dumper) err[Fail] {
    val w1: err[Fail] = dump.open(d, ARCHIVE);
    if (sel w1.err) { ret w1; }
    var magic: *u8 = ?model.MAGIC_ARCH[0];
    if (arch.thin) { magic = ?model.MAGIC_THIN[0]; }
    val w2: err[Fail] = dump.name(d, MAGIC, magic, model.MAGIC_LEN);
    if (sel w2.err) { ret w2; }
    val count: usize = table.count[Member](?arch.members);
    var i:     usize = 0;
    for (i < count) {
        val w3: err[Fail] = member(arch, d, table.at[Member](?arch.members, table.nth[Member](i)));
        if (sel w3.err) { ret w3; }
        i = i + 1;
    }
    ret dump.close(d);
}

fun member(arch: *Archive, d: *Dumper, m: *Member) err[Fail] {
    val nm: Bytes     = model.bytes(arch, ?m.name);
    val w1: err[Fail] = dump.open(d, MEMBER);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = dump.name(d, NAME, nm.data, nm.len);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = dump.name(d, ROLE, m.role.name::*u8, str_len(m.role.name));
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = dump.hex(d, OFFSET, m.at);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = dump.name(d, DATE, ?m.header.date[0], 12);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = dump.name(d, USER, ?m.header.uid[0], 6);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = dump.name(d, GROUP, ?m.header.gid[0], 6);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = dump.name(d, MODE, ?m.header.mode[0], 8);
    if (sel w8.err) { ret w8; }
    val w9: err[Fail] = dump.name(d, SIZE, ?m.header.size[0], 10);
    if (sel w9.err) { ret w9; }
    var held: u64 = 0;
    if (m.held) { held = 1; }
    val w10: err[Fail] = dump.decimal(d, HELD, held);
    if (sel w10.err) { ret w10; }
    var i: usize = 0;
    for (i < m.entries) {
        val e:   *Entry    = table.at[Entry](?arch.entries, table.nth[Entry](m.first + i));
        val en:  Bytes     = model.bytes(arch, ?e.name);
        val w11: err[Fail] = dump.open(d, SYMBOL);
        if (sel w11.err) { ret w11; }
        val w12: err[Fail] = dump.name(d, NAME, en.data, en.len);
        if (sel w12.err) { ret w12; }
        val w13: err[Fail] = dump.hex(d, MEMBER_OFFSET, e.member);
        if (sel w13.err) { ret w13; }
        val w14: err[Fail] = dump.close(d);
        if (sel w14.err) { ret w14; }
        i = i + 1;
    }
    ret dump.close(d);
}
