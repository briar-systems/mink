# the compact unwind data of a Mach-O file
#
# `__compact_unwind` holds one fixed record per function in an object, and
# `__unwind_info` the table dyld and libunwind read at run time: the common
# encodings, the personalities, a first-level index of pages, the language
# specific data areas and the second-level pages, regular or compressed. both
# codecs are pure functions over bytes and entries, and the second reads and
# writes every part at the offset the entries state, zero between, so a table
# comes back byte for byte.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mink.checked;
use mink.fail;
use mink.fail.Fail;
use mink.macho.cover;
use mink.macho.cover.Cover;
use mink.macho.model;
use mink.macho.model.Unwind;
use mink.macho.model.UnwindCompressed;
use mink.macho.model.UnwindEntry;
use mink.macho.model.UnwindIndex;
use mink.macho.model.UnwindInfo;
use mink.macho.model.UnwindLsda;
use mink.macho.model.UnwindPage;
use mink.macho.model.UnwindRegular;
use mink.reader;
use mink.reader.LITTLE;
use mink.reader.Reader;
use mink.sink;
use mink.sink.Sink;
use mink.table;
use mink.table.Id;
use mink.table.Table;

# the width of the __unwind_info header, of a first-level index entry, of a
# language specific data entry and of a regular page entry
pub val HEADER_SIZE:       usize = 28;
pub val INDEX_SIZE:        usize = 12;
pub val LSDA_SIZE:         usize = 8;
pub val REGULAR_ENTRY:     usize = 8;
pub val REGULAR_HEADER:    usize = 8;
pub val COMPRESSED_HEADER: usize = 12;

# the kind of a second-level page
pub val PAGE_REGULAR:    u32 = 2;
pub val PAGE_COMPRESSED: u32 = 3;

# a compressed entry packs a function offset in its low bits and the index of
# its encoding in the rest
pub val COMPRESSED_OFFSET_BITS: u32 = 24;
pub val COMPRESSED_OFFSET_MASK: u32 = 0x00ff_ffff;

# the most pieces one table may decode to
val MAX_ENTRIES: u64 = 0x400_0000;

# the width of a __compact_unwind record for a pointer of `ptr` bytes
pub fun record_size(ptr: usize) usize {
    ret 3 * ptr + 8;
}

# the records of the __compact_unwind section the reader spans. `ptr` is the
# width of a pointer in bytes
pub fun decode_compact(a: *A.Allocator, r: *Reader, ptr: usize) res[Table[Unwind], Fail] {
    var out:  Table[Unwind] = table.make[Unwind](a);
    val size: usize         = record_size(ptr);
    if (reader.remaining(r) % size != 0) {
        ret res[Table[Unwind], Fail].err{fail.at_offset(fail.in_file(fail.unsupported("compact unwind is not a whole number of records"), r.file), reader.offset(r))};
    }
    val n: usize                 = reader.remaining(r) / size;
    val g: res[Id[Unwind], Fail] = table.grow[Unwind](?out, n);
    if (sel g.err) { ret res[Table[Unwind], Fail].err{g.err}; }
    var i: usize = 0;
    for (i < n) {
        val e:  *Unwind   = table.at[Unwind](?out, table.nth[Unwind](i));
        val ok: err[Fail] = read_record(r, ptr, e);
        if (sel ok.err) {
            val dropped: err[Fail] = table.release[Unwind](?out);
            ret res[Table[Unwind], Fail].err{ok.err};
        }
        i = i + 1;
    }
    ret res[Table[Unwind], Fail].ok{out};
}

fun read_record(r: *Reader, ptr: usize, e: *Unwind) err[Fail] {
    val start: res[u64, Fail] = reader.uint(r, ptr);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    val length: res[u32, Fail] = reader.u32(r);
    if (sel length.err) { ret err[Fail].err{length.err}; }
    val encoding: res[u32, Fail] = reader.u32(r);
    if (sel encoding.err) { ret err[Fail].err{encoding.err}; }
    val personality: res[u64, Fail] = reader.uint(r, ptr);
    if (sel personality.err) { ret err[Fail].err{personality.err}; }
    val lsda: res[u64, Fail] = reader.uint(r, ptr);
    if (sel lsda.err) { ret err[Fail].err{lsda.err}; }
    e.start       = start.ok;
    e.length      = length.ok;
    e.encoding    = encoding.ok;
    e.personality = personality.ok;
    e.lsda        = lsda.ok;
    ret err[Fail].ok{};
}

# the __compact_unwind records for `entries`, `ptr` bytes to a pointer
pub fun encode_compact(s: *Sink, entries: *Table[Unwind], ptr: usize) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Unwind](entries)) {
        val e: *Unwind = table.at[Unwind](entries, table.nth[Unwind](i));
        if (ptr < 8 && (e.start >> (ptr::u64 * 8) != 0 || e.personality >> (ptr::u64 * 8) != 0 || e.lsda >> (ptr::u64 * 8) != 0)) {
            ret err[Fail].err{fail.malformed("compact unwind address does not fit a pointer")};
        }
        val a: err[Fail] = sink.uint(s, e.start, ptr);
        if (sel a.err) { ret a; }
        val b: err[Fail] = sink.u32(s, e.length);
        if (sel b.err) { ret b; }
        val c: err[Fail] = sink.u32(s, e.encoding);
        if (sel c.err) { ret c; }
        val d: err[Fail] = sink.uint(s, e.personality, ptr);
        if (sel d.err) { ret d; }
        val x: err[Fail] = sink.uint(s, e.lsda, ptr);
        if (sel x.err) { ret x; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun at_here(f: Fail, r: *Reader) Fail {
    ret fail.at_offset(fail.in_file(f, r.file), reader.offset(r));
}

# the table of the section the reader spans. `r` starts at the header
pub fun decode(a: *A.Allocator, r: *Reader) res[UnwindInfo, Fail] {
    var info: UnwindInfo = UnwindInfo{
        common:        table.make[u32](a),
        personalities: table.make[u32](a),
        index:         table.make[UnwindIndex](a),
        lsdas:         table.make[UnwindLsda](a),
        pages:         table.make[UnwindPage](a),
    };
    var cv:  Cover     = cover.make(a);
    val ran: err[Fail] = cover.settle(?cv, run(?info, r, ?cv));
    if (sel ran.err) {
        val dropped: err[Fail] = model.release_unwind_info(?info);
        ret res[UnwindInfo, Fail].err{ran.err};
    }
    ret res[UnwindInfo, Fail].ok{info};
}

# `count` words at `pos` into `out`
fun words(r: *Reader, pos: u64, count: u32, out: *Table[u32]) err[Fail] {
    val sk: res[usize, Fail] = reader.seek(r, pos);
    if (sel sk.err)                             { ret err[Fail].err{sk.err}; }
    if (count::usize > reader.remaining(r) / 4) { ret err[Fail].err{at_here(fail.truncated("encodings lie outside the section"), r)}; }
    val g: res[Id[u32], Fail] = table.grow[u32](out, count::usize);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < count::usize) {
        val v: res[u32, Fail] = reader.u32(r);
        if (sel v.err) { ret err[Fail].err{v.err}; }
        val cell: *u32 = table.at[u32](out, table.nth[u32](i));
        @cell = v.ok;
        i     = i + 1;
    }
    ret err[Fail].ok{};
}

fun run(info: *UnwindInfo, r: *Reader, cv: *Cover) err[Fail] {
    val sk: res[usize, Fail] = reader.seek(r, 0);
    if (sel sk.err) { ret err[Fail].err{sk.err}; }
    var common_count:      u32     = 0;
    var personality_count: u32     = 0;
    var index_count:       u32     = 0;
    val vals:              [7]*u32 = [7]*u32{?info.version, ?info.common_offset, ?common_count, ?info.personality_offset, ?personality_count, ?info.index_offset, ?index_count};
    var i:                 usize   = 0;
    for (i < 7) {
        val v: res[u32, Fail] = reader.u32(r);
        if (sel v.err) { ret err[Fail].err{v.err}; }
        @vals[i] = v.ok;
        i        = i + 1;
    }
    info.size = r.len::u32;
    val h: err[Fail] = cover.add(cv, reader.here(r), 0, HEADER_SIZE::u64);
    if (sel h.err) { ret h; }
    val c1: err[Fail] = words(r, info.common_offset::u64, common_count, ?info.common);
    if (sel c1.err) { ret c1; }
    val c2: err[Fail] = cover.add(cv, reader.here(r), info.common_offset::u64, common_count::u64 * 4);
    if (sel c2.err) { ret c2; }
    val p1: err[Fail] = words(r, info.personality_offset::u64, personality_count, ?info.personalities);
    if (sel p1.err) { ret p1; }
    val p2: err[Fail] = cover.add(cv, reader.here(r), info.personality_offset::u64, personality_count::u64 * 4);
    if (sel p2.err) { ret p2; }
    val x: err[Fail] = run_index(info, r, index_count, cv);
    if (sel x.err) { ret x; }
    ret cover.check(cv, r);
}

fun run_index(info: *UnwindInfo, r: *Reader, count: u32, cv: *Cover) err[Fail] {
    val sk: res[usize, Fail] = reader.seek(r, info.index_offset::u64);
    if (sel sk.err) { ret err[Fail].err{sk.err}; }
    if (count::usize > reader.remaining(r) / INDEX_SIZE) {
        ret err[Fail].err{at_here(fail.truncated("first-level index lies outside the section"), r)};
    }
    val g: res[Id[UnwindIndex], Fail] = table.grow[UnwindIndex](?info.index, count::usize);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < count::usize) {
        val f: res[u32, Fail] = reader.u32(r);
        if (sel f.err) { ret err[Fail].err{f.err}; }
        val p: res[u32, Fail] = reader.u32(r);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        val l: res[u32, Fail] = reader.u32(r);
        if (sel l.err) { ret err[Fail].err{l.err}; }
        table.at[UnwindIndex](?info.index, table.nth[UnwindIndex](i)).function = f.ok;
        table.at[UnwindIndex](?info.index, table.nth[UnwindIndex](i)).page     = p.ok;
        table.at[UnwindIndex](?info.index, table.nth[UnwindIndex](i)).lsda     = l.ok;
        i                                                                      = i + 1;
    }
    val ci: err[Fail] = cover.add(cv, reader.here(r), info.index_offset::u64, count::u64 * INDEX_SIZE::u64);
    if (sel ci.err) { ret ci; }
    if (count == 0) { ret err[Fail].ok{}; }
    val first: u32 = table.at[UnwindIndex](?info.index, table.nth[UnwindIndex](0)).lsda;
    val last:  u32 = table.at[UnwindIndex](?info.index, table.nth[UnwindIndex](count::usize - 1)).lsda;
    if (last < first || (last - first)::usize % LSDA_SIZE != 0) {
        ret err[Fail].err{at_here(fail.unsupported("language specific data bounds do not hold whole entries"), r)};
    }
    val lsdas: err[Fail] = run_lsdas(info, r, first, (last - first) / LSDA_SIZE::u32, cv);
    if (sel lsdas.err) { ret lsdas; }
    i = 0;
    for (i + 1 < count::usize) {
        val pos: u32 = table.at[UnwindIndex](?info.index, table.nth[UnwindIndex](i)).page;
        if (pos != 0) {
            val pg: err[Fail] = run_page(info, r, pos::u64, cv);
            if (sel pg.err) { ret err[Fail].err{fail.in_indexed(pg.err, "second-level page", i::u64)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun run_lsdas(info: *UnwindInfo, r: *Reader, first: u32, count: u32, cv: *Cover) err[Fail] {
    val sk: res[usize, Fail] = reader.seek(r, first::u64);
    if (sel sk.err) { ret err[Fail].err{sk.err}; }
    if (count::usize > reader.remaining(r) / LSDA_SIZE) {
        ret err[Fail].err{at_here(fail.truncated("language specific data lies outside the section"), r)};
    }
    val g: res[Id[UnwindLsda], Fail] = table.grow[UnwindLsda](?info.lsdas, count::usize);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < count::usize) {
        val f: res[u32, Fail] = reader.u32(r);
        if (sel f.err) { ret err[Fail].err{f.err}; }
        val l: res[u32, Fail] = reader.u32(r);
        if (sel l.err) { ret err[Fail].err{l.err}; }
        table.at[UnwindLsda](?info.lsdas, table.nth[UnwindLsda](i)).function = f.ok;
        table.at[UnwindLsda](?info.lsdas, table.nth[UnwindLsda](i)).lsda     = l.ok;
        i                                                                    = i + 1;
    }
    ret cover.add(cv, reader.here(r), first::u64, count::u64 * LSDA_SIZE::u64);
}

fun run_page(info: *UnwindInfo, r: *Reader, pos: u64, cv: *Cover) err[Fail] {
    val sk: res[usize, Fail] = reader.seek(r, pos);
    if (sel sk.err) { ret err[Fail].err{sk.err}; }
    val kind: res[u32, Fail] = reader.u32(r);
    if (sel kind.err) { ret err[Fail].err{kind.err}; }
    val entry_offset: res[u16, Fail] = reader.u16(r);
    if (sel entry_offset.err) { ret err[Fail].err{entry_offset.err}; }
    val entry_count: res[u16, Fail] = reader.u16(r);
    if (sel entry_count.err) { ret err[Fail].err{entry_count.err}; }
    if (kind.ok == PAGE_REGULAR) {
        var pg:  UnwindRegular = UnwindRegular{entry_offset: entry_offset.ok, entries: table.make[UnwindEntry](info.pages.a)};
        val ran: err[Fail]     = regular_entries(r, pos, entry_count.ok, ?pg, cv);
        if (sel ran.err) {
            val dropped: err[Fail] = table.release[UnwindEntry](?pg.entries);
            ret ran;
        }
        val p: res[Id[UnwindPage], Fail] = table.push[UnwindPage](?info.pages, UnwindPage.regular{pg});
        if (sel p.err) {
            val dropped: err[Fail] = table.release[UnwindEntry](?pg.entries);
            ret err[Fail].err{p.err};
        }
        ret err[Fail].ok{};
    }
    if (kind.ok == PAGE_COMPRESSED) {
        val encodings_offset: res[u16, Fail] = reader.u16(r);
        if (sel encodings_offset.err) { ret err[Fail].err{encodings_offset.err}; }
        val encodings_count: res[u16, Fail] = reader.u16(r);
        if (sel encodings_count.err) { ret err[Fail].err{encodings_count.err}; }
        var pg: UnwindCompressed = UnwindCompressed{
            entry_offset:     entry_offset.ok,
            encodings_offset: encodings_offset.ok,
            entries:          table.make[u32](info.pages.a),
            encodings:        table.make[u32](info.pages.a),
        };
        val ran: err[Fail] = compressed_entries(r, pos, entry_count.ok, encodings_count.ok, ?pg, cv);
        if (sel ran.err) {
            val x: err[Fail] = table.release[u32](?pg.entries);
            val y: err[Fail] = table.release[u32](?pg.encodings);
            ret ran;
        }
        val p: res[Id[UnwindPage], Fail] = table.push[UnwindPage](?info.pages, UnwindPage.compressed{pg});
        if (sel p.err) {
            val x: err[Fail] = table.release[u32](?pg.entries);
            val y: err[Fail] = table.release[u32](?pg.encodings);
            ret err[Fail].err{p.err};
        }
        ret err[Fail].ok{};
    }
    ret err[Fail].err{at_here(fail.unsupported("second-level page kind is neither regular nor compressed"), r)};
}

fun regular_entries(r: *Reader, pos: u64, count: u16, pg: *UnwindRegular, cv: *Cover) err[Fail] {
    val head: err[Fail] = cover.add(cv, reader.here(r), pos, REGULAR_HEADER::u64);
    if (sel head.err) { ret head; }
    val at: res[u64, Fail] = checked.add(reader.here(r), pos, pg.entry_offset::u64);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val sk: res[usize, Fail] = reader.seek(r, at.ok);
    if (sel sk.err) { ret err[Fail].err{sk.err}; }
    if (count::usize > reader.remaining(r) / REGULAR_ENTRY) {
        ret err[Fail].err{at_here(fail.truncated("page entries lie outside the section"), r)};
    }
    val g: res[Id[UnwindEntry], Fail] = table.grow[UnwindEntry](?pg.entries, count::usize);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < count::usize) {
        val f: res[u32, Fail] = reader.u32(r);
        if (sel f.err) { ret err[Fail].err{f.err}; }
        val e: res[u32, Fail] = reader.u32(r);
        if (sel e.err) { ret err[Fail].err{e.err}; }
        table.at[UnwindEntry](?pg.entries, table.nth[UnwindEntry](i)).function = f.ok;
        table.at[UnwindEntry](?pg.entries, table.nth[UnwindEntry](i)).encoding = e.ok;
        i                                                                      = i + 1;
    }
    ret cover.add(cv, reader.here(r), at.ok, count::u64 * REGULAR_ENTRY::u64);
}

fun compressed_entries(r: *Reader, pos: u64, count: u16, encodings: u16, pg: *UnwindCompressed, cv: *Cover) err[Fail] {
    val head: err[Fail] = cover.add(cv, reader.here(r), pos, COMPRESSED_HEADER::u64);
    if (sel head.err) { ret head; }
    val at: res[u64, Fail] = checked.add(reader.here(r), pos, pg.entry_offset::u64);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val a: err[Fail] = words(r, at.ok, count::u32, ?pg.entries);
    if (sel a.err) { ret a; }
    val ca: err[Fail] = cover.add(cv, reader.here(r), at.ok, count::u64 * 4);
    if (sel ca.err) { ret ca; }
    val en: res[u64, Fail] = checked.add(reader.here(r), pos, pg.encodings_offset::u64);
    if (sel en.err) { ret err[Fail].err{en.err}; }
    val b: err[Fail] = words(r, en.ok, encodings::u32, ?pg.encodings);
    if (sel b.err) { ret b; }
    ret cover.add(cv, reader.here(r), en.ok, encodings::u64 * 4);
}

# a part of the section an encoder writes at an offset
# ---
# offset: where it lies
# kind:   which part it is, PART_*
# index:  which table entry it is
rec Part {
    offset: u64;
    kind:   u8;
    index:  u32;
}

val PART_HEADER:        u8 = 0;
val PART_COMMON:        u8 = 1;
val PART_PERSONALITIES: u8 = 2;
val PART_INDEX:         u8 = 3;
val PART_LSDAS:         u8 = 4;
val PART_PAGE:          u8 = 5;

fun by_offset(a: *Part, b: *Part) i64 {
    if (a.offset < b.offset) { ret -1; }
    if (a.offset > b.offset) { ret 1; }
    ret 0;
}

fun push_part(t: *Table[Part], offset: u64, kind: u8, index: u32) err[Fail] {
    val p: res[Id[Part], Fail] = table.push[Part](t, Part{offset: offset, kind: kind, index: index});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# zero bytes up to `offset` bytes after `start`
fun reach(s: *Sink, start: usize, offset: u64) err[Fail] {
    val have: u64 = (sink.len(s) - start)::u64;
    if (offset < have) { ret err[Fail].err{fail.malformed("parts of the unwind info overlap")}; }
    ret sink.zeros(s, (offset - have)::usize);
}

# the section for `info`, each part at the offset it states and zeros between
pub fun encode(s: *Sink, a: *A.Allocator, info: *UnwindInfo) err[Fail] {
    var parts:   Table[Part] = table.make[Part](a);
    val planned: err[Fail]   = plan(?parts, info);
    if (sel planned.err) {
        val dropped: err[Fail] = table.release[Part](?parts);
        ret planned;
    }
    sort.sort_by[Part](table.items[Part](?parts), table.count[Part](?parts), by_offset);
    val start:  usize     = sink.len(s);
    var failed: err[Fail] = err[Fail].ok{};
    var i:      usize     = 0;
    for (i < table.count[Part](?parts) && !sel failed.err) {
        failed = write_part(s, start, info, table.at[Part](?parts, table.nth[Part](i)));
        i      = i + 1;
    }
    val dropped: err[Fail] = table.release[Part](?parts);
    if (sel failed.err)  { ret failed; }
    if (sel dropped.err) { ret dropped; }
    val have: u64 = (sink.len(s) - start)::u64;
    if (have > info.size::u64) { ret err[Fail].err{fail.malformed("unwind info runs past its size")}; }
    ret sink.zeros(s, (info.size::u64 - have)::usize);
}

fun plan(parts: *Table[Part], info: *UnwindInfo) err[Fail] {
    val n:     usize = table.count[UnwindIndex](?info.index);
    var paged: usize = 0;
    var i:     usize = 0;
    for (i + 1 < n) {
        if (table.at[UnwindIndex](?info.index, table.nth[UnwindIndex](i)).page != 0) { paged = paged + 1; }
        i = i + 1;
    }
    if (paged != table.count[UnwindPage](?info.pages)) {
        ret err[Fail].err{fail.malformed("unwind info pages disagree with its index")};
    }
    if (n > 0) {
        val first: u32 = table.at[UnwindIndex](?info.index, table.nth[UnwindIndex](0)).lsda;
        val last:  u32 = table.at[UnwindIndex](?info.index, table.nth[UnwindIndex](n - 1)).lsda;
        if (last < first || (last - first)::usize != table.count[UnwindLsda](?info.lsdas) * LSDA_SIZE) {
            ret err[Fail].err{fail.malformed("unwind info language specific data disagrees with its index")};
        }
    }
    val h: err[Fail] = push_part(parts, 0, PART_HEADER, 0);
    if (sel h.err) { ret h; }
    if (table.count[u32](?info.common) > 0) {
        val x: err[Fail] = push_part(parts, info.common_offset::u64, PART_COMMON, 0);
        if (sel x.err) { ret x; }
    }
    if (table.count[u32](?info.personalities) > 0) {
        val x: err[Fail] = push_part(parts, info.personality_offset::u64, PART_PERSONALITIES, 0);
        if (sel x.err) { ret x; }
    }
    if (n > 0) {
        val x: err[Fail] = push_part(parts, info.index_offset::u64, PART_INDEX, 0);
        if (sel x.err) { ret x; }
    }
    if (table.count[UnwindLsda](?info.lsdas) > 0) {
        val x: err[Fail] = push_part(parts, table.at[UnwindIndex](?info.index, table.nth[UnwindIndex](0)).lsda::u64, PART_LSDAS, 0);
        if (sel x.err) { ret x; }
    }
    i = 0;
    var page: u32 = 0;
    for (i + 1 < n) {
        val pos: u32 = table.at[UnwindIndex](?info.index, table.nth[UnwindIndex](i)).page;
        if (pos != 0) {
            val x: err[Fail] = push_part(parts, pos::u64, PART_PAGE, page);
            if (sel x.err) { ret x; }
            page = page + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun write_words(s: *Sink, t: *Table[u32]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[u32](t)) {
        val w: err[Fail] = sink.u32(s, @table.at[u32](t, table.nth[u32](i)));
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun write_part(s: *Sink, start: usize, info: *UnwindInfo, p: *Part) err[Fail] {
    val r: err[Fail] = reach(s, start, p.offset);
    if (sel r.err) { ret r; }
    if (p.kind == PART_HEADER) {
        val vals: [7]u32 = [7]u32{
            info.version,
            info.common_offset,
            table.count[u32](?info.common)::u32,
            info.personality_offset,
            table.count[u32](?info.personalities)::u32,
            info.index_offset,
            table.count[UnwindIndex](?info.index)::u32,
        };
        var i: usize = 0;
        for (i < 7) {
            val w: err[Fail] = sink.u32(s, vals[i]);
            if (sel w.err) { ret w; }
            i = i + 1;
        }
        ret err[Fail].ok{};
    }
    if (p.kind == PART_COMMON)        { ret write_words(s, ?info.common); }
    if (p.kind == PART_PERSONALITIES) { ret write_words(s, ?info.personalities); }
    if (p.kind == PART_INDEX) {
        var i: usize = 0;
        for (i < table.count[UnwindIndex](?info.index)) {
            val e: *UnwindIndex = table.at[UnwindIndex](?info.index, table.nth[UnwindIndex](i));
            val a: err[Fail]    = sink.u32(s, e.function);
            if (sel a.err) { ret a; }
            val b: err[Fail] = sink.u32(s, e.page);
            if (sel b.err) { ret b; }
            val c: err[Fail] = sink.u32(s, e.lsda);
            if (sel c.err) { ret c; }
            i = i + 1;
        }
        ret err[Fail].ok{};
    }
    if (p.kind == PART_LSDAS) {
        var i: usize = 0;
        for (i < table.count[UnwindLsda](?info.lsdas)) {
            val e: *UnwindLsda = table.at[UnwindLsda](?info.lsdas, table.nth[UnwindLsda](i));
            val a: err[Fail]   = sink.u32(s, e.function);
            if (sel a.err) { ret a; }
            val b: err[Fail] = sink.u32(s, e.lsda);
            if (sel b.err) { ret b; }
            i = i + 1;
        }
        ret err[Fail].ok{};
    }
    ret write_page(s, table.at[UnwindPage](?info.pages, table.nth[UnwindPage](p.index::usize)));
}

fun write_page(s: *Sink, pg: *UnwindPage) err[Fail] {
    val start: usize = sink.len(s);
    if (sel pg.regular) {
        val n: usize = table.count[UnwindEntry](?pg.regular.entries);
        if (n > 0xffff) { ret err[Fail].err{fail.malformed("regular page holds more entries than its count")}; }
        val a: err[Fail] = sink.u32(s, PAGE_REGULAR);
        if (sel a.err) { ret a; }
        val b: err[Fail] = sink.u16(s, pg.regular.entry_offset);
        if (sel b.err) { ret b; }
        val c: err[Fail] = sink.u16(s, n::u16);
        if (sel c.err) { ret c; }
        val r: err[Fail] = reach(s, start, pg.regular.entry_offset::u64);
        if (sel r.err) { ret r; }
        var i: usize = 0;
        for (i < n) {
            val e: *UnwindEntry = table.at[UnwindEntry](?pg.regular.entries, table.nth[UnwindEntry](i));
            val x: err[Fail]    = sink.u32(s, e.function);
            if (sel x.err) { ret x; }
            val y: err[Fail] = sink.u32(s, e.encoding);
            if (sel y.err) { ret y; }
            i = i + 1;
        }
        ret err[Fail].ok{};
    }
    if (sel pg.compressed) {
        val n: usize = table.count[u32](?pg.compressed.entries);
        val m: usize = table.count[u32](?pg.compressed.encodings);
        if (n > 0xffff || m > 0xffff) { ret err[Fail].err{fail.malformed("compressed page holds more entries than its count")}; }
        val a: err[Fail] = sink.u32(s, PAGE_COMPRESSED);
        if (sel a.err) { ret a; }
        val b: err[Fail] = sink.u16(s, pg.compressed.entry_offset);
        if (sel b.err) { ret b; }
        val c: err[Fail] = sink.u16(s, n::u16);
        if (sel c.err) { ret c; }
        val d: err[Fail] = sink.u16(s, pg.compressed.encodings_offset);
        if (sel d.err) { ret d; }
        val e: err[Fail] = sink.u16(s, m::u16);
        if (sel e.err) { ret e; }
        if (pg.compressed.entry_offset <= pg.compressed.encodings_offset) {
            val r1: err[Fail] = reach(s, start, pg.compressed.entry_offset::u64);
            if (sel r1.err) { ret r1; }
            val w1: err[Fail] = write_words(s, ?pg.compressed.entries);
            if (sel w1.err) { ret w1; }
            val r2: err[Fail] = reach(s, start, pg.compressed.encodings_offset::u64);
            if (sel r2.err) { ret r2; }
            ret write_words(s, ?pg.compressed.encodings);
        }
        val r1: err[Fail] = reach(s, start, pg.compressed.encodings_offset::u64);
        if (sel r1.err) { ret r1; }
        val w1: err[Fail] = write_words(s, ?pg.compressed.encodings);
        if (sel w1.err) { ret w1; }
        val r2: err[Fail] = reach(s, start, pg.compressed.entry_offset::u64);
        if (sel r2.err) { ret r2; }
        ret write_words(s, ?pg.compressed.entries);
    }
    ret err[Fail].err{fail.internal("unwind info page holds no entries")};
}

fun push_word(t: *Table[u32], v: u32) bool {
    val p: res[Id[u32], Fail] = table.push[u32](t, v);
    ret sel p.ok;
}

fun same_sinks(a: *Sink, b: *Sink) bool {
    if (sink.len(a) != sink.len(b)) { ret false; }
    var i: usize = 0;
    for (i < sink.len(a)) {
        if (sink.data(a)[i] != sink.data(b)[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test unwind__compact_unwind_and_unwind_info_round_trip {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    var info: UnwindInfo = UnwindInfo{
        version:            1,
        common_offset:      28,
        personality_offset: 36,
        index_offset:       40,
        size:               256,
        common:             table.make[u32](a),
        personalities:      table.make[u32](a),
        index:              table.make[UnwindIndex](a),
        lsdas:              table.make[UnwindLsda](a),
        pages:              table.make[UnwindPage](a),
    };
    if (!push_word(?info.common, 0x0400_0000) || !push_word(?info.common, 0x0200_1000)) { ret 1; }
    if (!push_word(?info.personalities, 0x4000))                                        { ret 1; }
    val ix: [3]UnwindIndex = [3]UnwindIndex{
        UnwindIndex{function: 0x1000, page: 96, lsda: 76},
        UnwindIndex{function: 0x2000, page: 128, lsda: 84},
        UnwindIndex{function: 0x3000, page: 0, lsda: 92},
    };
    var i: usize = 0;
    for (i < 3) {
        val p: res[Id[UnwindIndex], Fail] = table.push[UnwindIndex](?info.index, ix[i]);
        if (sel p.err) { ret 1; }
        i = i + 1;
    }
    val l1: res[Id[UnwindLsda], Fail] = table.push[UnwindLsda](?info.lsdas, UnwindLsda{function: 0x1004, lsda: 0x8000});
    val l2: res[Id[UnwindLsda], Fail] = table.push[UnwindLsda](?info.lsdas, UnwindLsda{function: 0x2010, lsda: 0x8010});
    if (sel l1.err || sel l2.err) { ret 1; }

    var regular: UnwindRegular              = UnwindRegular{entry_offset: 8, entries: table.make[UnwindEntry](a)};
    val e1:      res[Id[UnwindEntry], Fail] = table.push[UnwindEntry](?regular.entries, UnwindEntry{function: 0x1000, encoding: 0x0400_0000});
    val e2:      res[Id[UnwindEntry], Fail] = table.push[UnwindEntry](?regular.entries, UnwindEntry{function: 0x1100, encoding: 0x0200_1000});
    if (sel e1.err || sel e2.err) { ret 1; }
    val pr: res[Id[UnwindPage], Fail] = table.push[UnwindPage](?info.pages, UnwindPage.regular{regular});
    if (sel pr.err) { ret 1; }

    var packed: UnwindCompressed = UnwindCompressed{entry_offset: 12, encodings_offset: 24, entries: table.make[u32](a), encodings: table.make[u32](a)};
    if (!push_word(?packed.entries, 0x0000_0000) || !push_word(?packed.entries, 0x0100_0010) || !push_word(?packed.entries, 0x0200_0020)) { ret 1; }
    if (!push_word(?packed.encodings, 0x0300_0001) || !push_word(?packed.encodings, 0x0400_0002))                                         { ret 1; }
    val pc: res[Id[UnwindPage], Fail] = table.push[UnwindPage](?info.pages, UnwindPage.compressed{packed});
    if (sel pc.err) { ret 1; }

    var first: Sink      = sink.make(a, LITTLE);
    val w1:    err[Fail] = encode(?first, a, ?info);
    if (sel w1.err)              { ret 1; }
    if (sink.len(?first) != 256) { ret 1; }
    var r: Reader                = reader.make("t", sink.data(?first), sink.len(?first), LITTLE);
    val d: res[UnwindInfo, Fail] = decode(a, ?r);
    if (sel d.err) { ret 1; }
    var back: UnwindInfo = d.ok;
    if (table.count[UnwindPage](?back.pages) != 2 || table.count[UnwindLsda](?back.lsdas) != 2 || table.count[UnwindIndex](?back.index) != 3) { ret 1; }
    var second: Sink      = sink.make(a, LITTLE);
    val w2:     err[Fail] = encode(?second, a, ?back);
    if (sel w2.err)                   { ret 1; }
    if (!same_sinks(?first, ?second)) { ret 1; }

    var records: Table[Unwind]         = table.make[Unwind](a);
    val u1:      res[Id[Unwind], Fail] = table.push[Unwind](?records, Unwind{start: 0x10, length: 0x20, encoding: 0x0400_0000, personality: 0, lsda: 0});
    val u2:      res[Id[Unwind], Fail] = table.push[Unwind](?records, Unwind{start: 0x30, length: 0x8, encoding: 0x0300_0000, personality: 0x100, lsda: 0x200});
    if (sel u1.err || sel u2.err) { ret 1; }
    var ptrs: usize = 4;
    for (ptrs <= 8) {
        var cs: Sink      = sink.make(a, LITTLE);
        val c1: err[Fail] = encode_compact(?cs, ?records, ptrs);
        if (sel c1.err)                             { ret 1; }
        if (sink.len(?cs) != 2 * record_size(ptrs)) { ret 1; }
        var q:  Reader                   = reader.make("t", sink.data(?cs), sink.len(?cs), LITTLE);
        val dc: res[Table[Unwind], Fail] = decode_compact(a, ?q, ptrs);
        if (sel dc.err) { ret 1; }
        var rec: Table[Unwind] = dc.ok;
        var cs2: Sink          = sink.make(a, LITTLE);
        val c2:  err[Fail]     = encode_compact(?cs2, ?rec, ptrs);
        if (sel c2.err)                                                                                                             { ret 1; }
        if (!same_sinks(?cs, ?cs2))                                                                                                 { ret 1; }
        if (table.at[Unwind](?rec, table.nth[Unwind](1)).lsda != 0x200 || table.at[Unwind](?rec, table.nth[Unwind](1)).length != 8) { ret 1; }
        val x1: err[Fail] = table.release[Unwind](?rec);
        val x2: err[Fail] = sink.release(?cs);
        val x3: err[Fail] = sink.release(?cs2);
        ptrs = ptrs + 4;
    }

    val z1: err[Fail] = model.release_unwind_info(?info);
    val z2: err[Fail] = model.release_unwind_info(?back);
    val z3: err[Fail] = table.release[Unwind](?records);
    val z4: err[Fail] = sink.release(?first);
    val z5: err[Fail] = sink.release(?second);
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
