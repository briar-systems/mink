# the kind of file a thin Mach-O model is
#
# filetype decides it, one row per filetype, and MH_PIE makes an executable
# one its loader may place at any address. MH_FVMLIB, a fixed virtual memory
# library no toolchain has built since the 1990s, has no row and is refused.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.fail;
use mink.fail.Fail;
use mink.macho.model.MachO;
use mink.macho.tables;
use mink.macho.tables.Constant;

# code: the filetype
# kind: the kind of a file of that filetype
# pie:  the kind when MH_PIE is set, none where the flag has no meaning
rec FileType {
    code: *Constant;
    kind: *Kind;
    pie:  opt[*Kind];
}

val ROW_COUNT: usize               = 13;
val ROWS:      [ROW_COUNT]FileType = [ROW_COUNT]FileType{
    FileType{code: ?tables.MH_OBJECT, kind: ?kind.RELOCATABLE},
    FileType{code: ?tables.MH_EXECUTE, kind: ?kind.EXECUTABLE, pie: opt[*Kind].some{?kind.PIE}},
    FileType{code: ?tables.MH_CORE, kind: ?kind.CORE},
    FileType{code: ?tables.MH_PRELOAD, kind: ?kind.EXECUTABLE},
    FileType{code: ?tables.MH_DYLIB, kind: ?kind.SHARED},
    FileType{code: ?tables.MH_DYLINKER, kind: ?kind.INTERPRETER},
    FileType{code: ?tables.MH_BUNDLE, kind: ?kind.BUNDLE},
    FileType{code: ?tables.MH_DYLIB_STUB, kind: ?kind.STUB},
    FileType{code: ?tables.MH_DSYM, kind: ?kind.DEBUG},
    FileType{code: ?tables.MH_KEXT_BUNDLE, kind: ?kind.BUNDLE},
    FileType{code: ?tables.MH_FILESET, kind: ?kind.FILESET},
    FileType{code: ?tables.MH_GPU_EXECUTE, kind: ?kind.EXECUTABLE},
    FileType{code: ?tables.MH_GPU_DYLIB, kind: ?kind.SHARED},
};

pub fun of(m: *MachO) res[*Kind, Fail] {
    val row: opt[*FileType] = row_of(m.header.filetype::u64);
    if (sel row.none) {
        ret res[*Kind, Fail].err{fail.valued(fail.in_record(fail.unsupported("no kind of file has this filetype"), "mach header"), m.header.filetype::i128)};
    }
    val pie: opt[*Kind] = row.some.pie;
    if (sel pie.some) {
        if ((m.header.flags::u64 & tables.MH_PIE.value) != 0) { ret res[*Kind, Fail].ok{pie.some}; }
    }
    ret res[*Kind, Fail].ok{row.some.kind};
}

fun row_of(filetype: u64) opt[*FileType] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].code.value == filetype) { ret opt[*FileType].some{?ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*FileType].none{};
}

test kind__every_filetype_but_fvmlib_has_one_row {
    var i: usize = 0;
    for (i < tables.MH_FILETYPE.count) {
        val code: *Constant = tables.MH_FILETYPE.rows[i];
        var seen: usize     = 0;
        var k:    usize     = 0;
        for (k < ROW_COUNT) {
            if (ROWS[k].code == code) { seen = seen + 1; }
            k = k + 1;
        }
        var want: usize = 1;
        if (code == ?tables.MH_FVMLIB) { want = 0; }
        if (seen != want)              { ret 1; }
        i = i + 1;
    }
    var m: MachO;
    m.header.filetype = tables.MH_EXECUTE.value::u32;
    m.header.flags    = tables.MH_PIE.value::u32;
    val pie: res[*Kind, Fail] = of(?m);
    if (!sel pie.ok)         { ret 2; }
    if (pie.ok != ?kind.PIE) { ret 2; }
    m.header.filetype = tables.MH_DYLIB.value::u32;
    val dylib: res[*Kind, Fail] = of(?m);
    if (!sel dylib.ok)            { ret 3; }
    if (dylib.ok != ?kind.SHARED) { ret 3; }
    m.header.filetype = tables.MH_FVMLIB.value::u32;
    val fvm: res[*Kind, Fail] = of(?m);
    if (!sel fvm.err)                   { ret 4; }
    if (!sel fvm.err.cause.unsupported) { ret 4; }
    ret 0;
}
