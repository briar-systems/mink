# the linking rules of Mach-O: how an image is laid out and bound
#
# a section keeps its segment and section name pair, and output sections load
# by class into __TEXT, which holds the header, the code and the constants,
# __DATA_CONST, which the loader writes once, and __DATA, with its zero fill
# last. the page zero below __TEXT is the system's image base.
#
# an import binds through the two-level namespace to the library that defines
# it, so no definition of one image preempts another's, nothing is copied and
# symbols carry no versions. a call to an import goes through a stub and its
# lazy or bound slot, any other reference to one through a GOT slot or a bound
# pointer, and an address the image holds is rebased. the rows follow ld64
# and are disjoint.

use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

use mink.catalog.arch.Arch;
use mink.link.dynamic;
use mink.link.dynamic.Row;
use mink.link.kind;
use mink.link.layout.Class;
use mink.link.layout.Load;
use mink.link.layout.Rules;
use mink.model.reloc;
use mink.model.section;
use mink.rule.Axis;

val TEXT:       Load = Load{name: "__TEXT", flags: section.ALLOC | section.EXEC};
val DATA_CONST: Load = Load{name: "__DATA_CONST", flags: section.ALLOC | section.WRITE};
val DATA:       Load = Load{name: "__DATA", flags: section.ALLOC | section.WRITE};

val TLS:       section.Flags = section.ALLOC | section.WRITE | section.TLS;
val WRITTEN:   section.Flags = section.ALLOC | section.WRITE;
val UNWRITTEN: section.Flags = section.EXEC | section.TLS;

val CLASS_COUNT: usize              = 8;
val CLASSES:     [CLASS_COUNT]Class = [CLASS_COUNT]Class{
    Class{name: "text", rank: 0, flags: Axis{need: section.ALLOC | section.EXEC, deny: section.WRITE}, load: opt[*Load].some{?TEXT}},
    Class{name: "const", rank: 1, flags: Axis{need: section.ALLOC, deny: section.WRITE | section.EXEC}, load: opt[*Load].some{?TEXT}},
    Class{name: "data const", rank: 2, flags: Axis{need: WRITTEN, deny: UNWRITTEN}, roles: Axis{need: section.RELRO}, load: opt[*Load].some{?DATA_CONST}},
    Class{name: "thread data", rank: 3, flags: Axis{need: TLS, deny: section.EXEC}, roles: Axis{need: section.BITS}, load: opt[*Load].some{?DATA}},
    Class{name: "data", rank: 4, flags: Axis{need: WRITTEN, deny: UNWRITTEN}, roles: Axis{need: section.BITS, deny: section.RELRO}, load: opt[*Load].some{?DATA}},
    Class{name: "thread bss", rank: 5, flags: Axis{need: TLS, deny: section.EXEC}, roles: Axis{deny: section.BITS}, load: opt[*Load].some{?DATA}},
    Class{name: "bss", rank: 6, flags: Axis{need: WRITTEN, deny: UNWRITTEN}, roles: Axis{deny: section.BITS | section.RELRO}, load: opt[*Load].some{?DATA}},
    Class{name: "unloaded", rank: 7, flags: Axis{deny: section.ALLOC}, load: opt[*Load].none{}},
};
# room for the load commands other than segments: the symbol tables, the
# dynamic loader and its fixups, the entry point, libSystem, the build and
# source versions, the uuid, function starts, data in code and the signature
val COMMANDS: u64 = 512;

# the mach header, a segment command for every load segment, __PAGEZERO and
# __LINKEDIT, a section header for every output section and the other load
# commands
fun header(a: *Arch, segments: u64, sections: u64) u64 {
    if (a.pointer_bytes == 8) { ret 32 + 72 * (segments + 2) + 80 * sections + COMMANDS; }
    ret 28 + 56 * (segments + 2) + 68 * sections + COMMANDS;
}

pub val LAYOUT: Rules = Rules{
    name:          "macho",
    stems:         nil,
    stem_count:    0,
    joint:         0,
    cut:           0,
    classes:       ?CLASSES[0],
    class_count:   CLASS_COUNT,
    commons:       "__DATA,__common",
    congruent:     true,
    section_align: 1,
    file_align:    1,
    header:        header,
};

val UNPATCHED: u64 = reloc.MARKER | reloc.LOADER;
val INDIRECT:  u64 = reloc.TLS | reloc.GOT | reloc.PLT;
val FIXED:     u64 = dynamic.ABSOLUTE | dynamic.UNDEFINED;
val SPELLED:   u64 = dynamic.WORD | dynamic.WRITABLE;

val DYNAMIC_COUNT: usize              = 27;
val DYNAMIC_ROWS:  [DYNAMIC_COUNT]Row = [DYNAMIC_COUNT]Row{
    Row{name: "marker", kind: Axis{need: reloc.MARKER}, outcome: ?dynamic.STATIC},
    Row{
        name:    "loader",
        kind:    Axis{need: reloc.LOADER, deny: reloc.MARKER},
        outcome: ?dynamic.REFUSED,
        reason:  "an object holds a relocation only a loader applies",
    },
    Row{
        name:    "unloaded import",
        kind:    Axis{deny: UNPATCHED},
        target:  Axis{need: dynamic.IMPORTED | dynamic.BOUND},
        output:  Axis{deny: kind.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "an output no loader binds cannot import from a shared library",
    },
    Row{
        name:    "bound resolver",
        kind:    Axis{deny: UNPATCHED},
        target:  Axis{need: dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{need: kind.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "the format has no indirect functions",
    },
    Row{
        name:    "bound thread",
        kind:    Axis{deny: UNPATCHED},
        target:  Axis{need: dynamic.BOUND | dynamic.THREAD, deny: dynamic.RESOLVER},
        output:  Axis{need: kind.IMPORTS},
        outcome: ?dynamic.UNSUPPORTED,
        reason:  "thread-local data another image binds is not supported yet",
    },
    Row{
        name:    "bound tls",
        kind:    Axis{need: reloc.TLS, deny: UNPATCHED},
        target:  Axis{need: dynamic.BOUND, deny: dynamic.RESOLVER | dynamic.THREAD},
        output:  Axis{need: kind.IMPORTS},
        outcome: ?dynamic.UNSUPPORTED,
        reason:  "thread-local variable references are not supported yet",
    },
    Row{
        name:    "got bind",
        kind:    Axis{need: reloc.GOT, deny: UNPATCHED | reloc.TLS},
        target:  Axis{need: dynamic.BOUND, deny: dynamic.RESOLVER | dynamic.THREAD},
        output:  Axis{need: kind.IMPORTS},
        outcome: ?dynamic.GOT_BIND,
    },
    Row{
        name:    "plt bind",
        kind:    Axis{need: reloc.PLT, deny: UNPATCHED | reloc.TLS | reloc.GOT},
        target:  Axis{need: dynamic.BOUND, deny: dynamic.RESOLVER | dynamic.THREAD},
        output:  Axis{need: kind.IMPORTS},
        outcome: ?dynamic.PLT_BIND,
    },
    Row{
        name:    "bind",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | INDIRECT},
        site:    Axis{need: SPELLED},
        target:  Axis{need: dynamic.BOUND, deny: dynamic.RESOLVER | dynamic.THREAD},
        output:  Axis{need: kind.IMPORTS},
        outcome: ?dynamic.BIND,
    },
    Row{
        name:    "bound",
        kind:    Axis{deny: UNPATCHED | INDIRECT | reloc.ABS},
        target:  Axis{need: dynamic.BOUND, deny: dynamic.RESOLVER | dynamic.THREAD},
        output:  Axis{need: kind.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "a reference of this kind cannot reach a symbol the loader binds",
    },
    Row{
        name:    "bound absolute",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | INDIRECT},
        site:    Axis{deny: dynamic.WORD},
        target:  Axis{need: dynamic.BOUND, deny: dynamic.RESOLVER | dynamic.THREAD},
        output:  Axis{need: kind.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "a reference of this kind cannot reach a symbol the loader binds",
    },
    Row{
        name:    "bound read-only",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | INDIRECT},
        site:    Axis{need: dynamic.WORD, deny: dynamic.WRITABLE},
        target:  Axis{need: dynamic.BOUND, deny: dynamic.RESOLVER | dynamic.THREAD},
        output:  Axis{need: kind.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "a reference of this kind cannot reach a symbol the loader binds",
    },
    Row{
        name:    "resolver",
        kind:    Axis{deny: UNPATCHED},
        target:  Axis{need: dynamic.RESOLVER, deny: dynamic.BOUND},
        outcome: ?dynamic.REFUSED,
        reason:  "the format has no indirect functions",
    },
    Row{
        name:    "tls",
        kind:    Axis{need: reloc.TLS, deny: UNPATCHED},
        target:  Axis{deny: dynamic.BOUND | dynamic.RESOLVER},
        outcome: ?dynamic.UNSUPPORTED,
        reason:  "thread-local variable references are not supported yet",
    },
    Row{
        name:    "got absolute",
        kind:    Axis{need: reloc.GOT, deny: UNPATCHED | reloc.TLS},
        target:  Axis{need: dynamic.ABSOLUTE, deny: dynamic.BOUND | dynamic.RESOLVER},
        outcome: ?dynamic.GOT_STATIC,
    },
    Row{
        name:    "got undefined",
        kind:    Axis{need: reloc.GOT, deny: UNPATCHED | reloc.TLS},
        target:  Axis{need: dynamic.UNDEFINED, deny: dynamic.BOUND | dynamic.ABSOLUTE | dynamic.RESOLVER},
        outcome: ?dynamic.GOT_STATIC,
    },
    Row{
        name:    "got rebase",
        kind:    Axis{need: reloc.GOT, deny: UNPATCHED | reloc.TLS},
        target:  Axis{deny: FIXED | dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{need: kind.PIC},
        outcome: ?dynamic.GOT_REBASE,
    },
    Row{
        name:    "got",
        kind:    Axis{need: reloc.GOT, deny: UNPATCHED | reloc.TLS},
        target:  Axis{deny: FIXED | dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{deny: kind.PIC},
        outcome: ?dynamic.GOT_STATIC,
    },
    Row{
        name:    "plt",
        kind:    Axis{need: reloc.PLT, deny: UNPATCHED | reloc.TLS | reloc.GOT},
        target:  Axis{deny: dynamic.BOUND | dynamic.RESOLVER},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "static",
        kind:    Axis{deny: UNPATCHED | INDIRECT | reloc.ABS},
        target:  Axis{deny: dynamic.BOUND | dynamic.RESOLVER},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "rebase",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | INDIRECT},
        site:    Axis{need: SPELLED},
        target:  Axis{deny: FIXED | dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{need: kind.PIC},
        outcome: ?dynamic.REBASE,
    },
    Row{
        name:    "text rebase",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | INDIRECT},
        site:    Axis{need: dynamic.WORD, deny: dynamic.WRITABLE},
        target:  Axis{deny: FIXED | dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{need: kind.PIC},
        outcome: ?dynamic.REFUSED,
        reason:  "an address in read-only data needs a text relocation",
    },
    Row{
        name:    "narrow",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | INDIRECT},
        site:    Axis{deny: dynamic.WORD | dynamic.LOW},
        target:  Axis{deny: FIXED | dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{need: kind.PIC},
        outcome: ?dynamic.REFUSED,
        reason:  "an absolute reference narrower than an address cannot be made position independent",
    },
    Row{
        name:    "low",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | INDIRECT},
        site:    Axis{need: dynamic.LOW, deny: dynamic.WORD},
        target:  Axis{deny: FIXED | dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{need: kind.PIC},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "absolute fixed",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | INDIRECT},
        target:  Axis{need: dynamic.ABSOLUTE, deny: dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{need: kind.PIC},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "absolute undefined",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | INDIRECT},
        target:  Axis{need: dynamic.UNDEFINED, deny: dynamic.BOUND | dynamic.ABSOLUTE | dynamic.RESOLVER},
        output:  Axis{need: kind.PIC},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "absolute",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | INDIRECT},
        target:  Axis{deny: dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{deny: kind.PIC},
        outcome: ?dynamic.STATIC,
    },
};
pub val DYNAMIC: dynamic.Rules = dynamic.Rules{name: "macho", caps: 0, rows: ?DYNAMIC_ROWS[0], count: DYNAMIC_COUNT};
