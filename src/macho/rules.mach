# the linking rules of Mach-O: how an image is laid out and bound
#
# a section keeps its segment and section name pair, and output sections load
# by class into __TEXT, which holds the header, the code and the constants,
# __DATA_CONST, which the loader writes once, and __DATA, with its zero fill
# last. the page zero below __TEXT is the system's image base.
#
# an import binds through the two-level namespace to the library that defines
# it, so no definition of one image preempts another's, nothing is copied and
# symbols carry no versions. a call to an import goes through a stub and its
# lazy or bound slot, any other reference to one through a GOT slot or a bound
# pointer, and an address the image holds is rebased. the rows follow ld64,
# first match deciding.

use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

use mink.catalog.arch.Arch;
use mink.link.dynamic;
use mink.link.dynamic.Axis;
use mink.link.dynamic.Row;
use mink.link.kind;
use mink.link.layout.Class;
use mink.link.layout.Load;
use mink.link.layout.Rules;
use mink.model.reloc;
use mink.model.section;

val TEXT:       Load = Load{name: "__TEXT", flags: section.ALLOC | section.EXEC};
val DATA_CONST: Load = Load{name: "__DATA_CONST", flags: section.ALLOC | section.WRITE};
val DATA:       Load = Load{name: "__DATA", flags: section.ALLOC | section.WRITE};

val LOADED: section.Flags = section.ALLOC | section.WRITE | section.EXEC;
val TLS:    section.Flags = section.ALLOC | section.WRITE | section.TLS;

val CLASS_COUNT: usize              = 8;
val CLASSES:     [CLASS_COUNT]Class = [CLASS_COUNT]Class{
    Class{flags: section.ALLOC | section.EXEC, flag_mask: LOADED, load: opt[*Load].some{?TEXT}},
    Class{flags: section.ALLOC, flag_mask: LOADED, load: opt[*Load].some{?TEXT}},
    Class{flags: section.ALLOC | section.WRITE, flag_mask: LOADED | section.TLS, roles: section.RELRO, role_mask: section.RELRO, load: opt[*Load].some{?DATA_CONST}},
    Class{flags: TLS, flag_mask: LOADED | section.TLS, roles: section.BITS, role_mask: section.BITS, load: opt[*Load].some{?DATA}},
    Class{flags: section.ALLOC | section.WRITE, flag_mask: LOADED | section.TLS, roles: section.BITS, role_mask: section.BITS, load: opt[*Load].some{?DATA}},
    Class{flags: TLS, flag_mask: LOADED | section.TLS, roles: 0, role_mask: section.BITS, load: opt[*Load].some{?DATA}},
    Class{flags: section.ALLOC | section.WRITE, flag_mask: LOADED | section.TLS, roles: 0, role_mask: section.BITS, load: opt[*Load].some{?DATA}},
    Class{flags: 0, flag_mask: section.ALLOC, load: opt[*Load].none{}},
};

# room for the load commands other than segments: the symbol tables, the
# dynamic loader and its fixups, the entry point, libSystem, the build and
# source versions, the uuid, function starts, data in code and the signature
val COMMANDS: u64 = 512;

# the mach header, a segment command for every load segment, __PAGEZERO and
# __LINKEDIT, a section header for every output section and the other load
# commands
fun header(a: *Arch, segments: u64, sections: u64) u64 {
    if (a.pointer_bytes == 8) { ret 32 + 72 * (segments + 2) + 80 * sections + COMMANDS; }
    ret 28 + 56 * (segments + 2) + 68 * sections + COMMANDS;
}

pub val LAYOUT: Rules = Rules{
    stems:         nil,
    stem_count:    0,
    joint:         0,
    cut:           0,
    classes:       ?CLASSES[0],
    class_count:   CLASS_COUNT,
    commons:       "__DATA,__common",
    congruent:     true,
    section_align: 1,
    file_align:    1,
    header:        header,
};

val LATE:    u64 = dynamic.BOUND;
val FIXED:   u64 = dynamic.ABSOLUTE | dynamic.UNDEFINED;
val SPELLED: u64 = dynamic.WORD | dynamic.WRITABLE;

val DYNAMIC_COUNT: usize              = 20;
val DYNAMIC_ROWS:  [DYNAMIC_COUNT]Row = [DYNAMIC_COUNT]Row{
    Row{kind: Axis{need: reloc.MARKER}, outcome: ?dynamic.STATIC},
    Row{kind: Axis{need: reloc.LOADER}, outcome: ?dynamic.REFUSED, reason: "an object holds a relocation only a loader applies"},
    Row{target: Axis{need: dynamic.IMPORTED}, output: Axis{deny: kind.IMPORTS}, outcome: ?dynamic.REFUSED, reason: "an output no loader binds cannot import from a shared library"},
    Row{target: Axis{need: dynamic.RESOLVER}, outcome: ?dynamic.REFUSED, reason: "the format has no indirect functions"},
    Row{target: Axis{need: dynamic.THREAD | LATE}, outcome: ?dynamic.UNSUPPORTED, reason: "thread-local data another image binds is not supported yet"},
    Row{kind: Axis{need: reloc.TLS}, outcome: ?dynamic.UNSUPPORTED, reason: "thread-local variable references are not supported yet"},
    Row{kind: Axis{need: reloc.GOT}, target: Axis{need: LATE}, outcome: ?dynamic.GOT_BIND},
    Row{kind: Axis{need: reloc.GOT}, target: Axis{need: dynamic.ABSOLUTE}, outcome: ?dynamic.GOT_STATIC},
    Row{kind: Axis{need: reloc.GOT}, target: Axis{need: dynamic.UNDEFINED}, outcome: ?dynamic.GOT_STATIC},
    Row{kind: Axis{need: reloc.GOT}, output: Axis{need: kind.PIC}, outcome: ?dynamic.GOT_REBASE},
    Row{kind: Axis{need: reloc.GOT}, outcome: ?dynamic.GOT_STATIC},
    Row{kind: Axis{need: reloc.PLT}, target: Axis{need: LATE}, outcome: ?dynamic.PLT_BIND},
    Row{kind: Axis{need: reloc.PLT}, outcome: ?dynamic.STATIC},
    Row{kind: Axis{need: reloc.ABS}, site: Axis{need: SPELLED}, target: Axis{need: LATE}, outcome: ?dynamic.BIND},
    Row{target: Axis{need: LATE}, outcome: ?dynamic.REFUSED, reason: "a reference of this kind cannot reach a symbol the loader binds"},
    Row{kind: Axis{need: reloc.ABS}, site: Axis{need: SPELLED}, target: Axis{deny: FIXED}, output: Axis{need: kind.PIC}, outcome: ?dynamic.REBASE},
    Row{kind: Axis{need: reloc.ABS}, site: Axis{need: dynamic.LOW}, outcome: ?dynamic.STATIC},
    Row{kind: Axis{need: reloc.ABS}, site: Axis{need: dynamic.WORD}, target: Axis{deny: FIXED}, output: Axis{need: kind.PIC}, outcome: ?dynamic.REFUSED, reason: "an address in read-only data needs a text relocation"},
    Row{kind: Axis{need: reloc.ABS}, target: Axis{deny: FIXED}, output: Axis{need: kind.PIC}, outcome: ?dynamic.REFUSED, reason: "an absolute reference narrower than an address cannot be made position independent"},
    Row{outcome: ?dynamic.STATIC},
};

pub val DYNAMIC: dynamic.Rules = dynamic.Rules{name: "macho", caps: 0, rows: ?DYNAMIC_ROWS[0], count: DYNAMIC_COUNT};
