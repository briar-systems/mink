# the string table builder every format's name table is made with
#
# names are collected and deduplicated, then finish lays them out with tail
# merging: a name that is a suffix of another shares its bytes, as `bar` inside
# `foobar`. whether the table starts with a NUL byte and what ends a name are
# the format's, stated by its Convention. finish fixes every offset and the
# size once, and write emits exactly that layout.

use std.collections.sort;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use T: std.allocator.testing;

use mink.lib.checked;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;
use mink.lib.intern;
use mink.lib.intern.Interner;
use mink.lib.intern.Name;
use mink.lib.reader.LITTLE;
use mink.lib.sink;
use mink.lib.sink.Sink;
use mink.lib.table;
use mink.lib.table.Id;
use mink.lib.table.Table;

pub val NUL:     u8 = 0;
pub val NEWLINE: u8 = 10;

# lead: whether the table starts with a NUL byte, which names the empty string
# term: the byte that ends every name
pub rec Convention {
    lead: bool;
    term: u8;
}

# a name in the order of its reversed bytes
rec Slot {
    id:   u32;
    data: *u8;
    len:  usize;
}

# conv:     the format's conventions
# names:    the distinct names, one id each
# order:    the names by reversed bytes, after finish
# offsets:  each name's offset in the table, by id, after finish
# size:     the size of the table, after finish
# finished: whether finish ran
pub rec Strtab {
    conv:     Convention;
    names:    Interner;
    order:    Table[Slot];
    offsets:  Table[u64];
    size:     u64;
    finished: bool;
}

pub fun make(a: *A.Allocator, conv: Convention) Strtab {
    ret Strtab{conv: conv, names: intern.make(a), order: table.make[Slot](a), offsets: table.make[u64](a)};
}

# the id of the `n` bytes at `p`, equal names sharing one. a name holding the
# terminator cannot be told from two names and is malformed
pub fun add(s: *Strtab, p: *u8, n: usize) res[Id[Name], Fail] {
    if (s.finished) { ret res[Id[Name], Fail].err{fail.malformed("string table is finished")}; }
    var i: usize = 0;
    for (i < n) {
        if (p[i] == s.conv.term) { ret res[Id[Name], Fail].err{fail.malformed("name holds the table's terminator")}; }
        i = i + 1;
    }
    ret intern.intern(?s.names, p, n);
}

pub fun add_str(s: *Strtab, t: str) res[Id[Name], Fail] {
    ret add(s, t::*u8, str_len(t));
}

# fix every offset and the size, merging each name that is a suffix of another
pub fun finish(s: *Strtab) err[Fail] {
    if (s.finished) { ret err[Fail].err{fail.malformed("string table is finished")}; }
    val n:  usize               = intern.count(?s.names);
    val go: res[Id[Slot], Fail] = table.grow[Slot](?s.order, n);
    if (sel go.err) { ret err[Fail].err{go.err}; }
    val gf: res[Id[u64], Fail] = table.grow[u64](?s.offsets, n);
    if (sel gf.err) { ret err[Fail].err{gf.err}; }
    val slots: *Slot = table.items[Slot](?s.order);
    var k:     usize = 0;
    for (k < n) {
        val v: View = intern.bytes_of(?s.names, table.nth[Name](k));
        slots[k] = Slot{id: k::u32, data: v.data, len: v.len};
        k        = k + 1;
    }
    sort.sort_by[Slot](slots, n, reversed);

    val offsets: *u64     = table.items[u64](?s.offsets);
    val at:      Location = Location{record: "string table"};
    var pos:     u64      = 0;
    if (s.conv.lead) { pos = 1; }
    k = n;
    for (k > 0) {
        k = k - 1;
        val cur: Slot = slots[k];
        if (cur.len == 0 && s.conv.lead && s.conv.term == NUL) {
            offsets[cur.id] = 0;
            cnt;
        }
        if (k + 1 < n && suffix_of(slots[k + 1], cur)) {
            offsets[cur.id] = offsets[slots[k + 1].id] + (slots[k + 1].len - cur.len)::u64;
            cnt;
        }
        offsets[cur.id] = pos;
        val next: res[u64, Fail] = checked.add(at, pos, cur.len::u64 + 1);
        if (sel next.err) { ret err[Fail].err{next.err}; }
        pos = next.ok;
    }
    s.size     = pos;
    s.finished = true;
    ret err[Fail].ok{};
}

# the size of the table
pub fun size(s: *Strtab) u64 {
    ret s.size;
}

# where `id` starts in the table. `id` was issued by this table, after finish
pub fun offset(s: *Strtab, id: Id[Name]) u64 {
    ret @table.at[u64](?s.offsets, Id[u64]{index: id.index});
}

# append the table to `k`
pub fun write(s: *Strtab, k: *Sink) err[Fail] {
    if (!s.finished) { ret err[Fail].err{fail.malformed("string table is not finished")}; }
    val base: usize = sink.len(k);
    if (s.conv.lead) {
        val z: err[Fail] = sink.u8(k, NUL);
        if (sel z.err) { ret z; }
    }
    val slots:   *Slot = table.items[Slot](?s.order);
    val offsets: *u64  = table.items[u64](?s.offsets);
    var i:       usize = table.count[Slot](?s.order);
    for (i > 0) {
        i = i - 1;
        val cur: Slot = slots[i];
        if (offsets[cur.id] == (sink.len(k) - base)::u64) {
            val w: err[Fail] = sink.bytes(k, cur.data, cur.len);
            if (sel w.err) { ret w; }
            val t: err[Fail] = sink.u8(k, s.conv.term);
            if (sel t.err) { ret t; }
        }
    }
    ret err[Fail].ok{};
}

# give every table back, reporting the first refusal
pub fun release(s: *Strtab) err[Fail] {
    val ri: err[Fail] = intern.release(?s.names);
    val ro: err[Fail] = table.release[Slot](?s.order);
    val rf: err[Fail] = table.release[u64](?s.offsets);
    if (sel ri.err) { ret ri; }
    if (sel ro.err) { ret ro; }
    ret rf;
}

# the order of the names read from their last byte
fun reversed(a: *Slot, b: *Slot) i64 {
    val n: usize = a.len;
    var m: usize = b.len;
    if (n < m) { m = n; }
    var i: usize = 0;
    for (i < m) {
        val x: u8 = a.data[a.len - 1 - i];
        val y: u8 = b.data[b.len - 1 - i];
        if (x != y) { ret x::i64 - y::i64; }
        i = i + 1;
    }
    if (a.len < b.len) { ret -1; }
    if (a.len > b.len) { ret 1; }
    ret 0;
}

# whether `short` ends `host`
fun suffix_of(host: Slot, short: Slot) bool {
    if (short.len > host.len) { ret false; }
    ret memory.raw_equal((?host.data[host.len - short.len])::ptr, short.data::ptr, short.len);
}

test strtab__deduplicates_and_tail_merges {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var s: Strtab = make(T.allocator_of(?t), Convention{lead: true, term: NUL});

    val foobar: res[Id[Name], Fail] = add_str(?s, "foobar");
    if (sel foobar.err) { ret 1; }
    val bar: res[Id[Name], Fail] = add_str(?s, "bar");
    if (sel bar.err) { ret 1; }
    val foo: res[Id[Name], Fail] = add_str(?s, "foo");
    if (sel foo.err) { ret 1; }
    val dup: res[Id[Name], Fail] = add_str(?s, "bar");
    if (sel dup.err) { ret 1; }
    val empty: res[Id[Name], Fail] = add_str(?s, "");
    if (sel empty.err)                { ret 1; }
    if (dup.ok.index != bar.ok.index) { ret 1; }
    val held: [3]u8               = [3]u8{'a', NUL, 'b'};
    val bad:  res[Id[Name], Fail] = add(?s, ?held[0], 3);
    if (sel bad.ok) { ret 1; }

    val fin: err[Fail] = finish(?s);
    if (sel fin.err)                { ret 1; }
    if (size(?s) != 12)             { ret 1; }
    if (offset(?s, empty.ok) != 0)  { ret 1; }
    if (offset(?s, foobar.ok) != 1) { ret 1; }
    if (offset(?s, bar.ok) != 4)    { ret 1; }
    if (offset(?s, foo.ok) != 8)    { ret 1; }

    var k: Sink      = sink.make(T.allocator_of(?t), LITTLE);
    val w: err[Fail] = write(?s, ?k);
    if (sel w.err)          { ret 1; }
    if (sink.len(?k) != 12) { ret 1; }
    val want: [12]u8 = [12]u8{0, 'f', 'o', 'o', 'b', 'a', 'r', 0, 'f', 'o', 'o', 0};
    var i:    usize  = 0;
    for (i < 12) {
        if (sink.data(?k)[i] != want[i]) { ret 1; }
        i = i + 1;
    }

    var n:  Strtab              = make(T.allocator_of(?t), Convention{lead: false, term: NEWLINE});
    val ab: res[Id[Name], Fail] = add_str(?n, "ab");
    if (sel ab.err) { ret 1; }
    val b: res[Id[Name], Fail] = add_str(?n, "b");
    if (sel b.err) { ret 1; }
    val fn: err[Fail] = finish(?n);
    if (sel fn.err)            { ret 1; }
    if (size(?n) != 3)         { ret 1; }
    if (offset(?n, b.ok) != 1) { ret 1; }

    val r1: err[Fail] = release(?s);
    if (sel r1.err) { ret 1; }
    val r2: err[Fail] = release(?n);
    if (sel r2.err) { ret 1; }
    val r3: err[Fail] = sink.release(?k);
    if (sel r3.err)            { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
