# the COFF format
#
# the exact revision of each specification the COFF modules implement, so a
# change to any of them is a visible version bump. one registration covers the
# regular object, the bigobj, the PE image and the short import object, which the
# reader returns as its own record and the registration models alongside the others.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.catalog.format;
use coff_dump: mink.coff.dump;
use mink.coff.import;
use mink.coff.model;
use mink.coff.place;
use mink.coff.read;
use mink.coff.read.Parsed;
use mink.coff.tables;
use mink.fail;
use mink.fail.Fail;
use mink.fail.Location;
use mink.format.contract.Container;
use mink.format.contract.Input;
use mink.format.contract.Ops;
use mink.format.contract.Reference;
use mink.format.contract.Registration;
use mink.format.contract.Revision;
use mink.format.dump.Dumper;
use mink.model.object.Object;
use mink.sink.Sink;

pub val REVISION_COUNT: usize = 2;

pub val REVISIONS: [REVISION_COUNT]Revision = [REVISION_COUNT]Revision{
    Revision{spec: "Microsoft PE Format, with the ARM64 and ARM64EC additions", revision: "page of 10 September 2026"},
    Revision{spec: "Windows SDK winnt.h layouts (IMAGE_LOAD_CONFIG_DIRECTORY32 and 64, IMAGE_ARM64EC_METADATA, IMAGE_CHPE_METADATA_X86), as mirrored by Wine include/winnt.h", revision: "Wine commit d38598c894f6 of 27 August 2026"},
};

# the llvm-readobj flags for the directories and tables the dump prints
val REFERENCE_FLAG_COUNT: usize                     = 7;
val REFERENCE_FLAGS:      [REFERENCE_FLAG_COUNT]str = [REFERENCE_FLAG_COUNT]str{
    "--coff-imports", "--coff-exports", "--coff-basereloc", "--coff-debug-directory",
    "--coff-tls-directory", "--coff-load-config", "--coff-resources",
};

pub val REGISTRATION: Registration = Registration{
    format: ?format.COFF,
    ops:    Ops{
        read:         read_ops,
        write:        write_ops,
        dump:         dump_ops,
        to_neutral:   to_neutral,
        from_neutral: from_neutral,
        locate:       locate,
        release:      release_ops,
    },
    magics:         ?tables.MAGICS[0],
    magic_count:    tables.MAGIC_COUNT,
    revisions:      ?REVISIONS[0],
    revision_count: REVISION_COUNT,
    fields:         ?coff_dump.FIELDS[0],
    field_count:    coff_dump.FIELD_COUNT,
    container:      opt[Container].none{},
    reference:      opt[Reference].some{Reference{flags: ?REFERENCE_FLAGS[0], count: REFERENCE_FLAG_COUNT}},
};

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val r: res[Parsed, Fail] = read.read(a, in);
    if (sel r.err) { ret res[ptr, Fail].err{r.err}; }
    val p: res[*Parsed, A.Error] = A.allocate[Parsed](a, 1);
    if (sel p.err) { ret res[ptr, Fail].err{fail.refused(p.err)}; }
    val mp: *Parsed = p.ok;
    @mp = r.ok;
    ret res[ptr, Fail].ok{mp::ptr};
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret res[Sink, Fail].err{fail.unsupported("the PE/COFF writer is not built")};
}

fun dump_ops(m: ptr, d: *Dumper) err[Fail] {
    ret coff_dump.describe_parsed(m::*Parsed, d);
}

fun to_neutral(m: ptr, o: *Object) err[Fail] {
    ret err[Fail].err{fail.unsupported("the PE/COFF neutral conversion is not built")};
}

fun from_neutral(a: *A.Allocator, o: *Object) res[ptr, Fail] {
    ret res[ptr, Fail].err{fail.unsupported("the PE/COFF neutral conversion is not built")};
}

# where the byte lies, from the layout of the extents
fun locate(m: ptr, offset: u64) Location {
    ret place.locate_parsed(m::*Parsed, offset);
}

fun release_ops(a: *A.Allocator, m: ptr) err[Fail] {
    val pp: *Parsed      = m::*Parsed;
    val r:  err[Fail]    = release_parsed(pp);
    val d:  err[A.Error] = A.deallocate[Parsed](a, pp, 1);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}

# give back what the model read as `p` owns
fun release_parsed(p: *Parsed) err[Fail] {
    if (sel p.object) { ret model.release(?p.object); }
    or (sel p.short)  { ret import.release(?p.short); }
}
