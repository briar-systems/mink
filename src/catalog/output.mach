# the kinds of output a link makes
#
# one row per kind, the one list of them. a row is named as a diagnostic
# spells it and keyed by how `--kind` spells it, which for an executable the
# linkage completes: the executables are the rows `--linkage` names, by their
# names. each row names the formats whose outputs can be of its kind, and a
# link asks the row's capabilities and never compares a kind against a
# constant. a kind joins this table with the writer that builds it, and each
# system names the file of every spelling in its row of mink.catalog.os.
#
# these are what a link makes. the kinds of file an input can be are the
# rows of mink.catalog.kind.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use mink.base.fail;
use mink.base.fail.Accepts;
use mink.base.fail.Fail;
use mink.base.fail.Refused;
use mink.base.index;
use mink.catalog.format;
use mink.catalog.format.Format;

pub def Caps: u64;

# the output may keep strong undefined references, for a later link or the
# loader to bind
pub val UNRESOLVED: Caps = 0x1;
# the output starts at one entry symbol, and is an executable `--linkage`
# names
pub val ENTERED: Caps = 0x2;
# every definition the output exports is reachable from outside it
pub val EXPORTS: Caps = 0x4;
# the output keeps every input section, for the link that takes it
pub val KEEPS: Caps = 0x8;
# a loader binds shared libraries into the output, so it may import
pub val IMPORTS: Caps = 0x10;
# the loader may place the output at any address, so an address it holds is
# one the loader relocates
pub val PIC: Caps = 0x20;
# a definition the output exports may be preempted by another image's
# definition of the same name, as a shared library's may
pub val INTERPOSED: Caps = 0x40;
# the output names its own entry points, as a SPIR-V module or a wasm reactor
# does, rather than starting at one entry symbol
pub val ENTRY_POINTS: Caps = 0x80;
# a loader maps the output into another image at run time
pub val LOADED: Caps = 0x100;
# the output is an archive of the input objects, which no link resolves
pub val ARCHIVED: Caps = 0x200;

# name:         the kind's spelling in a diagnostic, and an executable's on
#               `--linkage`
# spelled:      how `--kind` spells it
# formats:      the formats whose outputs can be of this kind
# format_count: how many
# caps:         the capabilities the kind declares
pub rec Kind {
    name:         str;
    spelled:      str;
    formats:      **Format;
    format_count: usize;
    caps:         Caps;
}

val RELOCATABLE_FORMATS: [1]*Format = [1]*Format{?format.SPIRV};
val STATIC_FORMATS:      [5]*Format = [5]*Format{?format.ELF, ?format.COFF, ?format.MACHO, ?format.WASM, ?format.FLAT};
val DYNAMIC_FORMATS:     [3]*Format = [3]*Format{?format.ELF, ?format.COFF, ?format.MACHO};
val SHARED_FORMATS:      [3]*Format = [3]*Format{?format.ELF, ?format.COFF, ?format.MACHO};
val MODULE_FORMATS:      [2]*Format = [2]*Format{?format.WASM, ?format.SPIRV};

# an object a later link takes as input
pub val RELOCATABLE: Kind = Kind{name: "relocatable", spelled: "object", formats: ?RELOCATABLE_FORMATS[0], format_count: 1, caps: UNRESOLVED | KEEPS};
# an executable at a fixed address that loads no library
pub val STATIC: Kind = Kind{name: "static", spelled: "bin", formats: ?STATIC_FORMATS[0], format_count: 5, caps: ENTERED};
# an executable at a fixed address whose loader binds libraries into it
pub val DYNAMIC: Kind = Kind{name: "dynamic", spelled: "bin", formats: ?DYNAMIC_FORMATS[0], format_count: 3, caps: ENTERED | IMPORTS};
# an executable its loader may place at any address
pub val PIE: Kind = Kind{name: "pie", spelled: "bin", formats: ?DYNAMIC_FORMATS[0], format_count: 3, caps: ENTERED | IMPORTS | PIC};
# a library loaded into another image at run time
pub val SHARED: Kind = Kind{name: "shared", spelled: "shared", formats: ?SHARED_FORMATS[0], format_count: 3, caps: UNRESOLVED | EXPORTS | IMPORTS | PIC | INTERPOSED | LOADED};
# a module a runtime instantiates rather than a loader maps, as a wasm or a
# SPIR-V module is, naming its own entry points
pub val MODULE: Kind = Kind{name: "module", spelled: "module", formats: ?MODULE_FORMATS[0], format_count: 2, caps: ENTRY_POINTS};
# a static library, an archive of the input objects in the variant the
# format's registration archives its objects in
pub val ARCHIVE: Kind = Kind{name: "archive", spelled: "static", formats: ?STATIC_FORMATS[0], format_count: 5, caps: ARCHIVED};

# the rows no linkage completes, ascending by how `--kind` spells them
val SPELLED_COUNT: usize                = 4;
val SPELLED:       [SPELLED_COUNT]*Kind = [SPELLED_COUNT]*Kind{?MODULE, ?RELOCATABLE, ?SHARED, ?ARCHIVE};

# the executables, ascending by name
val EXECUTABLE_COUNT: usize                   = 3;
val EXECUTABLES:      [EXECUTABLE_COUNT]*Kind = [EXECUTABLE_COUNT]*Kind{?DYNAMIC, ?PIE, ?STATIC};

pub fun has(k: *Kind, c: Caps) bool {
    ret (k.caps & c) == c;
}

# whether an output of kind `k` is an image fixed at its linked address: one
# no loader may place elsewhere and no later link takes
pub fun fixed(k: *Kind) bool {
    ret !has(k, PIC) && !has(k, KEEPS);
}

# whether an output of format `f` can be of kind `k`
pub fun builds(k: *Kind, f: *Format) bool {
    var i: usize = 0;
    for (i < k.format_count) {
        if (k.formats[i] == f) { ret true; }
        i = i + 1;
    }
    ret false;
}

# what `--kind` spells
# ---
# executable: the executables, whose row the target's linkage picks
# row:        this one row
pub tag Spelled: u8 {
    executable;
    row: *Kind;
}

fun order_spelled(a: **Kind, b: **Kind) i64 {
    ret str_compare(a[0].spelled, b[0].spelled);
}

fun order_names(a: **Kind, b: **Kind) i64 {
    ret str_compare(a[0].name, b[0].name);
}

# the refusal of `given` for `part`, for the static reason `why`, listing what
# `name` reads
fun refusal(part: str, given: str, why: str, name: fun(*Accepts, usize) str) Fail {
    var shown: View = View{data: nil, len: 0};
    if (given != nil) { shown = View{data: given::*u8, len: str_len(given)}; }
    val accepts: Accepts = Accepts{name: name, rows: nil, key: nil, within: nil};
    ret fail.refusing(fail.malformed(why), Refused{part: part, given: shown, accepts: opt[Accepts].some{accepts}});
}

# what `--kind` spells at `i`: the executables' one spelling, then the rows
# no linkage completes
fun spelling_at(a: *Accepts, i: usize) str {
    if (i == 0)             { ret EXECUTABLES[0].spelled; }
    if (i <= SPELLED_COUNT) { ret SPELLED[i - 1].spelled; }
    ret nil;
}

# the name of the `i`th executable
fun executable_at(a: *Accepts, i: usize) str {
    if (i < EXECUTABLE_COUNT) { ret EXECUTABLES[i].name; }
    ret nil;
}

# what `--kind` spells as `text`, refused where it spells no row
pub fun spelled(text: str) res[Spelled, Fail] {
    var probe: Kind       = Kind{spelled: text};
    val row:   opt[*Kind] = index.find[Kind](?SPELLED[0], SPELLED_COUNT, ?probe, order_spelled);
    if (sel row.some) { ret res[Spelled, Fail].ok{Spelled.row{row.some}}; }
    var i: usize = 0;
    for (i < EXECUTABLE_COUNT) {
        if (str_equals(EXECUTABLES[i].spelled, text)) { ret res[Spelled, Fail].ok{Spelled.executable{}}; }
        i = i + 1;
    }
    ret res[Spelled, Fail].err{refusal("kind", text, "no output kind has this name", spelling_at)};
}

# the executable `--linkage` names `name`, refused listing the executables
# where none has the name
pub fun executable(name: str) res[*Kind, Fail] {
    var probe: Kind       = Kind{name: name};
    val row:   opt[*Kind] = index.find[Kind](?EXECUTABLES[0], EXECUTABLE_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*Kind, Fail].err{refusal("linkage", name, "no executable has this name", executable_at)}; }
    ret res[*Kind, Fail].ok{row.some};
}
