# the output kinds a link builds
#
# one row per kind, each naming the formats whose images can be of that kind
# and the kind of file the image reads back as. a link asks the row whether
# its format builds the kind and never compares a kind against a constant.
# which kinds a format's image writer builds yet is the writer's own row, so a
# kind can be in this table before any writer builds it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.catalog.format;
use mink.catalog.format.Format;
use catalog_kind: mink.catalog.kind;

pub def Caps: u64;

# the output may keep strong undefined references, for a later link or the
# loader to bind
pub val UNRESOLVED: Caps = 0x1;
# the output starts at one entry symbol
pub val ENTERED: Caps = 0x2;
# every definition the output exports is reachable from outside it
pub val EXPORTS: Caps = 0x4;
# the output keeps every input section, for the link that takes it
pub val KEEPS: Caps = 0x8;
# a loader binds shared libraries into the output, so it may import
pub val IMPORTS: Caps = 0x10;
# the loader may place the output at any address, so an address it holds is
# one the loader relocates
pub val PIC: Caps = 0x20;
# a definition the output exports may be preempted by another image's
# definition of the same name, as a shared library's may
pub val INTERPOSED: Caps = 0x40;
# the output names its own entry points, as a SPIR-V module or a wasm reactor
# does, rather than starting at one entry symbol
pub val ENTRY_POINTS: Caps = 0x80;
# a loader maps the output into another image at run time
pub val LOADED: Caps = 0x100;

# name:         the kind's spelling on the command line and in a diagnostic
# formats:      the formats whose images can be of this kind
# format_count: how many
# caps:         the capabilities the kind declares
# reads_as:     the kind of file an image of this kind reads back as
pub rec Kind {
    name:         str;
    formats:      **Format;
    format_count: usize;
    caps:         Caps;
    reads_as:     *catalog_kind.Kind;
}

val RELOCATABLE_FORMATS: [5]*Format = [5]*Format{?format.ELF, ?format.COFF, ?format.MACHO, ?format.WASM, ?format.SPIRV};
val STATIC_FORMATS:      [5]*Format = [5]*Format{?format.ELF, ?format.COFF, ?format.MACHO, ?format.WASM, ?format.FLAT};
val DYNAMIC_FORMATS:     [3]*Format = [3]*Format{?format.ELF, ?format.COFF, ?format.MACHO};
val STATIC_PIE_FORMATS:  [2]*Format = [2]*Format{?format.ELF, ?format.COFF};
val SHARED_FORMATS:      [4]*Format = [4]*Format{?format.ELF, ?format.COFF, ?format.MACHO, ?format.WASM};
val BUNDLE_FORMATS:      [1]*Format = [1]*Format{?format.MACHO};
val MODULE_FORMATS:      [2]*Format = [2]*Format{?format.WASM, ?format.SPIRV};

# an object a later link takes as input
pub val RELOCATABLE: Kind = Kind{name: "relocatable", formats: ?RELOCATABLE_FORMATS[0], format_count: 5, caps: UNRESOLVED | KEEPS, reads_as: ?catalog_kind.RELOCATABLE};
# an executable at a fixed address that loads no library
pub val STATIC: Kind = Kind{name: "static", formats: ?STATIC_FORMATS[0], format_count: 5, caps: ENTERED, reads_as: ?catalog_kind.EXECUTABLE};
# an executable at a fixed address whose loader binds libraries into it
pub val DYNAMIC: Kind = Kind{name: "dynamic", formats: ?DYNAMIC_FORMATS[0], format_count: 3, caps: ENTERED | IMPORTS, reads_as: ?catalog_kind.EXECUTABLE};
# an executable its loader may place at any address
pub val PIE: Kind = Kind{name: "pie", formats: ?DYNAMIC_FORMATS[0], format_count: 3, caps: ENTERED | IMPORTS | PIC, reads_as: ?catalog_kind.PIE};
# an executable that loads no library and relocates itself, so it may be
# placed at any address
pub val STATIC_PIE: Kind = Kind{name: "static-pie", formats: ?STATIC_PIE_FORMATS[0], format_count: 2, caps: ENTERED | PIC, reads_as: ?catalog_kind.PIE};
# a library loaded into another image at run time
pub val SHARED: Kind = Kind{name: "shared", formats: ?SHARED_FORMATS[0], format_count: 4, caps: UNRESOLVED | EXPORTS | IMPORTS | PIC | INTERPOSED | LOADED, reads_as: ?catalog_kind.SHARED};
# code a loader maps into a running image that no link binds against, as a
# Mach-O bundle is
pub val BUNDLE: Kind = Kind{name: "bundle", formats: ?BUNDLE_FORMATS[0], format_count: 1, caps: LOADED | PIC, reads_as: ?catalog_kind.BUNDLE};
# a module a runtime instantiates rather than a loader maps, as a wasm or a
# SPIR-V module is, naming its own entry points
pub val MODULE: Kind = Kind{name: "module", formats: ?MODULE_FORMATS[0], format_count: 2, caps: ENTRY_POINTS, reads_as: ?catalog_kind.MODULE};

val ROW_COUNT: usize            = 8;
val ROWS:      [ROW_COUNT]*Kind = [ROW_COUNT]*Kind{?RELOCATABLE, ?STATIC, ?DYNAMIC, ?PIE, ?STATIC_PIE, ?SHARED, ?BUNDLE, ?MODULE};

# the rows ascending by name
val NAMES: [ROW_COUNT]*Kind = [ROW_COUNT]*Kind{?BUNDLE, ?DYNAMIC, ?MODULE, ?PIE, ?RELOCATABLE, ?SHARED, ?STATIC, ?STATIC_PIE};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Kind {
    ret ROWS[index];
}

fun order_names(a: **Kind, b: **Kind) i64 {
    ret str_compare(a[0].name, b[0].name);
}

pub fun by_name(name: str) res[*Kind, Fail] {
    var probe: Kind       = Kind{name: name};
    val row:   opt[*Kind] = index.find[Kind](?NAMES[0], ROW_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*Kind, Fail].err{fail.unsupported("no output kind has this name")}; }
    ret res[*Kind, Fail].ok{row.some};
}

pub fun has(k: *Kind, c: Caps) bool {
    ret (k.caps & c) == c;
}

# whether an image of format `f` can be of kind `k`
pub fun builds(k: *Kind, f: *Format) bool {
    var i: usize = 0;
    for (i < k.format_count) {
        if (k.formats[i] == f) { ret true; }
        i = i + 1;
    }
    ret false;
}

test output__rows_are_indexed_and_read_back_as_their_catalog_kind {
    val rows:  [ROW_COUNT]*Kind = ROWS;
    val built: err[Fail]        = index.verify[Kind](?NAMES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_names);
    if (sel built.err) { ret 1; }
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val k: *Kind            = ROWS[i];
        val r: res[*Kind, Fail] = by_name(k.name);
        if (sel r.err)                                                                                      { ret 2; }
        if (r.ok != k)                                                                                      { ret 2; }
        if (has(k, ENTERED) && has(k, ENTRY_POINTS))                                                        { ret 3; }
        if (has(k, ENTERED) != catalog_kind.has(k.reads_as, catalog_kind.ENTERED) && !has(k, ENTRY_POINTS)) { ret 4; }
        if (has(k, PIC) != catalog_kind.has(k.reads_as, catalog_kind.PIC) && !has(k, KEEPS))                { ret 5; }
        if (has(k, LOADED) != catalog_kind.has(k.reads_as, catalog_kind.LOADED))                            { ret 6; }
        i = i + 1;
    }
    if (!has(?STATIC_PIE, ENTERED | PIC) || has(?STATIC_PIE, IMPORTS))          { ret 7; }
    if (!has(?BUNDLE, LOADED | PIC) || has(?BUNDLE, ENTERED))                   { ret 7; }
    if (!has(?MODULE, ENTRY_POINTS) || has(?MODULE, ENTERED))                   { ret 8; }
    if (!builds(?RELOCATABLE, ?format.SPIRV) || !builds(?STATIC, ?format.WASM)) { ret 9; }
    val miss: res[*Kind, Fail] = by_name("a.out");
    if (sel miss.ok) { ret 10; }
    ret 0;
}
