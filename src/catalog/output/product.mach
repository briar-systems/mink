# the products a link makes, as `--kind` names them
#
# one row per product, each stating what the link makes of it: an executable,
# whose image kind its linkage picks, an image of one kind, or an archive of
# the input objects. the product is one axis and the linkage of an executable
# the other, each with one owner, and the image kind a link builds is what
# the two resolve to.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.catalog.output;
use mink.catalog.output.Kind;

# what a link makes of a product
# ---
# linked:  an executable, of the image kind its linkage names
# image:   an image of this kind
# archive: an archive of the input objects, which no link resolves
pub tag Makes: u8 {
    linked;
    image: *Kind;
    archive;
}

# name:  the product's spelling on the command line and in a manifest
# makes: what a link makes of it
pub rec Product {
    name:  str;
    makes: Makes;
}

# an executable
pub val BIN: Product = Product{name: "bin", makes: Makes.linked{}};
# a static library, an archive of the input objects
pub val STATIC: Product = Product{name: "static", makes: Makes.archive{}};
# a shared library
pub val SHARED: Product = Product{name: "shared", makes: Makes.image{?output.SHARED}};
# an object a later link takes as input
pub val OBJECT: Product = Product{name: "object", makes: Makes.image{?output.RELOCATABLE}};
# a module a runtime instantiates, naming its own entry points
pub val MODULE: Product = Product{name: "module", makes: Makes.image{?output.MODULE}};

val ROW_COUNT: usize               = 5;
val ROWS:      [ROW_COUNT]*Product = [ROW_COUNT]*Product{?BIN, ?STATIC, ?SHARED, ?OBJECT, ?MODULE};

# the rows ascending by name
val NAMES: [ROW_COUNT]*Product = [ROW_COUNT]*Product{?BIN, ?MODULE, ?OBJECT, ?SHARED, ?STATIC};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Product {
    ret ROWS[index];
}

fun order_names(a: **Product, b: **Product) i64 {
    ret str_compare(a[0].name, b[0].name);
}

pub fun by_name(name: str) res[*Product, Fail] {
    var probe: Product       = Product{name: name};
    val row:   opt[*Product] = index.find[Product](?NAMES[0], ROW_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*Product, Fail].err{fail.unsupported("no product has this name, it is bin, static, shared, object or module")}; }
    ret res[*Product, Fail].ok{row.some};
}
