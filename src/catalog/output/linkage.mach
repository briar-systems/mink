# the linkages of an executable, as `--linkage` names them
#
# one row per linkage, each naming the image kind an executable of it is.
# a linkage applies only to the bin product, and each host row of the system
# catalog states the linkages its loader runs and the one a link takes when
# it names none.

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.base.index;
use mink.catalog.output;
use mink.catalog.output.Kind;

# name: the linkage's spelling on the command line and in a manifest
# kind: the image kind an executable of this linkage is
pub rec Linkage {
    name: str;
    kind: *Kind;
}

# an executable its loader may place at any address
pub val PIE: Linkage = Linkage{name: "pie", kind: ?output.PIE};
# an executable at a fixed address whose loader binds libraries into it
pub val DYNAMIC: Linkage = Linkage{name: "dynamic", kind: ?output.DYNAMIC};
# an executable at a fixed address that loads no library
pub val STATIC: Linkage = Linkage{name: "static", kind: ?output.STATIC};

val ROW_COUNT: usize               = 3;
val ROWS:      [ROW_COUNT]*Linkage = [ROW_COUNT]*Linkage{?PIE, ?DYNAMIC, ?STATIC};

# the rows ascending by name
val NAMES: [ROW_COUNT]*Linkage = [ROW_COUNT]*Linkage{?DYNAMIC, ?PIE, ?STATIC};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Linkage {
    ret ROWS[index];
}

fun order_names(a: **Linkage, b: **Linkage) i64 {
    ret str_compare(a[0].name, b[0].name);
}

pub fun by_name(name: str) opt[*Linkage] {
    var probe: Linkage = Linkage{name: name};
    ret index.find[Linkage](?NAMES[0], ROW_COUNT, ?probe, order_names);
}
