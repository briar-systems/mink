# targets: one spelling, parsed and resolved against the catalog
#
# a target is spelled `<sys>-<arch>`, a system row's name, a dash and an
# architecture row's name, as `mach info targets` prints it. a narrowing
# states what those rows leave open: the environment, the calling
# convention, the instruction set, the extensions it adds, the code model,
# the linkage of an executable and the object format. a part it leaves out
# takes the rows' default.
# every tool resolves a target here and nowhere else, in this order:
#
#   parse(text)              the spec, or a refusal of the spelling
#   resolve(spec, narrowing) the whole target, or a refusal naming the bad part
#   masc's extension check   the stated extensions read against masc's
#                            catalog, which refuses an unknown or conflicting
#                            one
#
# the resolved `Target` is the one record of what a target is, and every
# default a tool needs of one is a field of it, never computed again.
# `accepted` lists the choices of a target's environment, calling convention,
# code model, executable linkage and object format under a narrowing, its
# default first, which a refusal of the part lists too. the calling
# convention lists those of the narrowing's environment, the code model and
# linkage those of the host its environment and calling convention select,
# and the format those the system writes.
# a refusal is a failure in the record `target` refusing the part, the text
# given for it, and what the part accepts, which every diagnostic writes the
# same way. resolve
# checks what the catalog states: the rows, an instruction set its family's
# grammar does not read or whose base names another architecture, an extension named twice, a code model the
# host does not offer and a format the system does not write. the names, implications and conflicts of extensions
# are masc's. a consumer that needs the instruction set reads it through
# `isa`, which refuses a target whose system bounds the machine not at all
# and that names none, and one that needs a calling convention row reads it
# through `abi`.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use mink.base.fail;
use mink.base.fail.Accepts;
use mink.base.fail.Fail;
use mink.base.fail.Refused;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.vectors;
use mink.catalog.arch;
use mink.catalog.arch.Abi;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Derivation;
use arch_list: mink.catalog.arch.list;
use mink.catalog.code;
use mink.catalog.code.CodeModel;
use mink.catalog.format.Format;
use catalog_isa: mink.catalog.isa;
use mink.catalog.isa.Base;
use mink.catalog.isa.Grammar;
use mink.catalog.os;
use mink.catalog.os.Default;
use mink.catalog.os.Env;
use mink.catalog.os.Environment;
use mink.catalog.os.Host;
use mink.catalog.os.Linking;
use mink.catalog.os.System;
use os_list: mink.catalog.os.list;
use mink.catalog.output;
use mink.catalog.output.Kind;

use std.collections.vector.Vector;

# the part of a target a refusal is about
# ---
# spelling:   the target as a whole, not spelled `<sys>-<arch>`
# sys:        the system the spelling names
# arch:       the architecture the spelling names
# env:        the environment
# abi:        the calling convention
# isa:        the instruction set
# extension:  an extension the target adds
# code_model: the code model
# linkage:    the linkage of an executable
# format:     the object format
pub tag Part: u8 {
    spelling;
    sys;
    arch;
    env;
    abi;
    isa;
    extension;
    code_model;
    linkage;
    format;
}

# a system and an architecture, the two rows a spelling names
pub rec Spec {
    sys:  *System;
    arch: *Arch;
}

# what a target states beside its spelling, each part nil where it is left
# out and takes the rows' default
# ---
# env:        the environment's name
# abi:        the calling convention's psABI name
# isa:        the instruction set, in masc's selection spelling
# ext:        the extensions it adds, in masc's names, borrowed for as long
#             as the resolved target is read
# ext_count:  how many
# code_model: the code model's name
# linkage:    the linkage of an executable, by its name
# format:     the object format, by its name
pub rec Narrowing {
    env:        str;
    abi:        str;
    isa:        str;
    ext:        *str;
    ext_count:  usize;
    code_model: str;
    linkage:    str;
    format:     str;
}

# a narrowing that states nothing
pub val UNNARROWED: Narrowing = Narrowing{env: nil, abi: nil, isa: nil, ext: nil, ext_count: 0, code_model: nil, linkage: nil, format: nil};

# one choice of a part of a target
# ---
# name:    its spelling, nil for the hosts that state no environment, which
#          no flag spells and a target takes only by default
# default: the target takes it when it names none
# derived: the default follows from the instruction set the hosts' floor
#          states, as linux-riscv64's lp64d does
pub rec Choice {
    name:    str;
    default: bool;
    derived: bool;
}

# where the instruction set of a resolved target comes from
# ---
# unbounded: nowhere: the system bounds the machine not at all and the
#            target names none
# floor:     the host's floor, in masc's selection spelling
# stated:    the narrowing, as written
pub tag Isa: u8 {
    unbounded;
    floor:  str;
    stated: str;
}

# a resolved target
# ---
# sys:        the system row
# arch:       the architecture row
# env:        the environment row, none for a host that states none
# host:       the host row of the system for the architecture under the
#             environment and the calling convention
# abi:        the calling convention: the row the narrowing names or the
#             host's default, a row derived from the instruction set where
#             the host derives it and the target states one, the derivation
#             where it states none, none where the family names none
# isa:        the instruction set and where it comes from
# ext:        the extensions the narrowing adds, in the order it names them,
#             borrowed from it
# ext_count:  how many
# code_model: the code model the narrowing names or the host's default, none
#             where the host offers none
# linkage:    the output kind of an executable, by its linkage: the one the
#             narrowing names or the host's default, none where the host runs
#             no executable, read through `executable`
# format:     the object format: the one the narrowing names or the system's
#             default
pub rec Target {
    sys:        *System;
    arch:       *Arch;
    env:        opt[*Env];
    host:       *Host;
    abi:        Default;
    isa:        Isa;
    ext:        *str;
    ext_count:  usize;
    code_model: opt[*CodeModel];
    linkage:    opt[*Kind];
    format:     *Format;
}

# the name a refusal calls `p` by
pub fun part_name(p: Part) str {
    if (sel p.spelling)   { ret "target"; }
    or (sel p.sys)        { ret "sys"; }
    or (sel p.arch)       { ret "arch"; }
    or (sel p.env)        { ret "env"; }
    or (sel p.abi)        { ret "abi"; }
    or (sel p.isa)        { ret "isa"; }
    or (sel p.extension)  { ret "ext"; }
    or (sel p.code_model) { ret "code model"; }
    or (sel p.linkage)    { ret "linkage"; }
    ret "format";
}

fun text_bytes(t: str) Bytes {
    if (t == nil) { ret Bytes{data: nil, len: 0}; }
    ret Bytes{data: t::*u8, len: str_len(t)};
}

# the refusal of `part`, given as the bytes `given`, for the static reason
# `why`, listing what `accepts` lists
fun refusal_of(part: Part, given: Bytes, why: str, accepts: opt[Accepts]) Fail {
    val r: Refused = Refused{part: part_name(part), given: View{data: given.data, len: given.len}, accepts: accepts};
    ret fail.refusing(fail.in_record(fail.malformed(why), "target"), r);
}

# the refusal of `part`, given as `given`, nil where it was left out, as
# refusal_of
fun refusal(part: Part, given: str, why: str, accepts: opt[Accepts]) Fail {
    ret refusal_of(part, text_bytes(given), why, accepts);
}

# a list read by `name` from `rows` for `key` under `within`
fun listing(name: fun(*Accepts, usize) str, rows: ptr, key: ptr, within: ptr) opt[Accepts] {
    ret opt[Accepts].some{Accepts{name: name, rows: rows, key: key, within: within}};
}

# the choices `name` lists of `s` under `n`
fun choices(s: Spec, n: *Narrowing, name: fun(*Accepts, usize) str) opt[Accepts] {
    ret listing(name, s.sys::ptr, s.arch::ptr, n::ptr);
}

# what a list of choices of `part` reads at `i`: the spelling of the choice
# of the system for the architecture under the narrowing
fun choice_at(a: *Accepts, part: Part, i: usize) str {
    val s: Spec = Spec{sys: a.rows::*System, arch: a.key::*Arch};
    ret spelled_choice(s, a.within::*Narrowing, part, i);
}

fun env_at(a: *Accepts, i: usize) str {
    ret choice_at(a, Part.env{}, i);
}

fun abi_at(a: *Accepts, i: usize) str {
    ret choice_at(a, Part.abi{}, i);
}

fun code_model_at(a: *Accepts, i: usize) str {
    ret choice_at(a, Part.code_model{}, i);
}

fun format_at(a: *Accepts, i: usize) str {
    ret choice_at(a, Part.format{}, i);
}

fun spelling_at(a: *Accepts, i: usize) str {
    if (i == 0) { ret "<sys>-<arch>"; }
    ret nil;
}

fun system_at(a: *Accepts, i: usize) str {
    if (i < os_list.count()) { ret os_list.at(i).name; }
    ret nil;
}

fun arch_at(a: *Accepts, i: usize) str {
    ret nth_arch(a.rows::*System, i);
}

fun base_at(a: *Accepts, i: usize) str {
    if (i == 0) { ret (a.rows::*Base).spelling; }
    ret nil;
}

fun linkage_listed_at(a: *Accepts, i: usize) str {
    ret linkage_at(a.rows::*Linking, i);
}

# the system named exactly `b`, none when no system has the name
fun system_named(b: Bytes) opt[*System] {
    var i: usize = 0;
    for (i < os_list.count()) {
        val s: *System = os_list.at(i);
        if (store.compare_text(s.name, b) == 0) { ret opt[*System].some{s}; }
        i = i + 1;
    }
    ret opt[*System].none{};
}

# whether `s` runs `a` under any environment
fun runs_any(s: *System, a: *Arch) bool {
    var i: usize = 0;
    for (i < s.host_count) {
        if (s.hosts[i].arch == a) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the system and the architecture `text` spells as `<sys>-<arch>`, split at
# its first dash. a spelling of another form, a system no row names and an
# architecture the system does not run are refused naming the part
pub fun parse(text: str) res[Spec, Fail] {
    if (text == nil) { ret res[Spec, Fail].err{refusal(Part.spelling{}, nil, "the target is left out", listing(spelling_at, nil, nil, nil))}; }
    var dash: usize = 0;
    for (text[dash] != 0 && text[dash] != '-') {
        dash = dash + 1;
    }
    if (text[dash] == 0 || dash == 0 || text[dash + 1] == 0) { ret res[Spec, Fail].err{refusal(Part.spelling{}, text, "a target is spelled as a system, a dash and an architecture", listing(spelling_at, nil, nil, nil))}; }
    val sys_given: Bytes        = Bytes{data: text::*u8, len: dash};
    val sys:       opt[*System] = system_named(sys_given);
    if (sel sys.none) { ret res[Spec, Fail].err{refusal_of(Part.sys{}, sys_given, "no system has this name", listing(system_at, nil, nil, nil))}; }
    val arch_text:  str              = (?text[dash + 1])::str;
    val arch_given: Bytes            = text_bytes(arch_text);
    val a:          res[*Arch, Fail] = arch_list.by_name(arch_text);
    if (sel a.err)                 { ret res[Spec, Fail].err{refusal_of(Part.arch{}, arch_given, "no architecture has this name", listing(arch_at, sys.some::ptr, nil, nil))}; }
    if (!runs_any(sys.some, a.ok)) { ret res[Spec, Fail].err{refusal_of(Part.arch{}, arch_given, "the system does not run this architecture", listing(arch_at, sys.some::ptr, nil, nil))}; }
    ret res[Spec, Fail].ok{Spec{sys: sys.some, arch: a.ok}};
}

# the environment `given` names, or the system's default
fun environment(s: Spec, n: *Narrowing) res[opt[*Env], Fail] {
    val given: str          = n.env;
    val envs:  opt[Accepts] = choices(s, n, env_at);
    if (given != nil) {
        val named: res[*Env, Fail] = os_list.env_by_name(s.sys, given);
        if (sel named.err) { ret res[opt[*Env], Fail].err{refusal(Part.env{}, given, "the system has no environment of this name", envs)}; }
        val e: opt[*Env] = opt[*Env].some{named.ok};
        if (!os.runs(s.sys, e, s.arch)) { ret res[opt[*Env], Fail].err{refusal(Part.env{}, given, "the environment does not run this architecture", envs)}; }
        ret res[opt[*Env], Fail].ok{e};
    }
    val d: Environment = s.sys.environment;
    if (sel d.unstated) { ret res[opt[*Env], Fail].err{refusal(Part.env{}, nil, "the system states no default environment, a defect of the catalog", envs)}; }
    or (sel d.required) { ret res[opt[*Env], Fail].err{refusal(Part.env{}, nil, d.required, envs)}; }
    or (sel d.named) {
        val e: opt[*Env] = opt[*Env].some{d.named};
        if (!os.runs(s.sys, e, s.arch)) { ret res[opt[*Env], Fail].err{refusal(Part.env{}, nil, "the system's default environment does not run this architecture, so the target names one", envs)}; }
        ret res[opt[*Env], Fail].ok{e};
    }
    val bare: opt[*Env] = opt[*Env].none{};
    if (!os.runs(s.sys, bare, s.arch)) { ret res[opt[*Env], Fail].err{refusal(Part.env{}, nil, "the system runs this architecture only under an environment, so the target names one", envs)}; }
    ret res[opt[*Env], Fail].ok{bare};
}

# how many hosts of `s` under `e` hold for the calling convention `b`, or
# with no convention named for those that state no condition, the first
# left in `found`
fun holding(s: Spec, e: opt[*Env], b: opt[*Abi], found: **Host) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < s.sys.host_count) {
        val h: *Host = ?s.sys.hosts[i];
        i = i + 1;
        if (!os.serves(h, e, s.arch)) { cnt; }
        if (sel b.some) {
            if (!os.conventional(h, b.some)) { cnt; }
        }
        or (sel h.when.some) { cnt; }
        if (n == 0)          { @found = h; }
        n = n + 1;
    }
    ret n;
}

# a host and the calling convention it is chosen under
# ---
# derived: the convention was derived from an instruction set
rec Chosen {
    host:    *Host;
    abi:     Default;
    derived: bool;
}

# the floor every host of `s` under `e` states alike, none where one states
# none or two differ
fun shared_floor(s: Spec, e: opt[*Env]) opt[str] {
    var found: opt[str] = opt[str].none{};
    var i:     usize    = 0;
    for (i < s.sys.host_count) {
        val h: *Host = ?s.sys.hosts[i];
        i = i + 1;
        if (!os.serves(h, e, s.arch)) { cnt; }
        val f: opt[str] = h.floor;
        if (sel f.none)                                        { ret opt[str].none{}; }
        if (sel found.some && !str_equals(found.some, f.some)) { ret opt[str].none{}; }
        found = f;
    }
    ret found;
}

# the psABI row `d` derives for `a` from the ISA string `text`, none where
# the text is nil or not one the family's grammar reads
fun derived(d: *Derivation, a: *Arch, text: str) opt[*Abi] {
    if (text == nil) { ret opt[*Abi].none{}; }
    val b: res[*Abi, Fail] = arch.derive(d, a, text_bytes(text));
    if (sel b.err) { ret opt[*Abi].none{}; }
    ret opt[*Abi].some{b.ok};
}

# the host for the calling convention `given` names. with none named: the
# one host that holds whatever convention, under its default, derived from
# the stated instruction set `isa` where the host derives it. where every
# host holds under a convention alone, the convention the instruction set
# derives, stated or the hosts' shared floor, picks the host
fun convention(s: Spec, e: opt[*Env], n: *Narrowing) res[Chosen, Fail] {
    val given: str          = n.abi;
    val isa:   str          = n.isa;
    val abis:  opt[Accepts] = choices(s, n, abi_at);
    var named: opt[*Abi]    = opt[*Abi].none{};
    if (given != nil) {
        named = arch.abi(s.arch, given);
        if (sel named.none) { ret res[Chosen, Fail].err{refusal(Part.abi{}, given, "the architecture has no calling convention of this name", abis)}; }
    }
    var h: *Host = nil;
    var n: usize = holding(s, e, named, ?h);
    if (n > 1) { ret res[Chosen, Fail].err{refusal(Part.abi{}, given, "two hosts of the system hold for one target, a defect of the catalog", abis)}; }
    if (sel named.some) {
        if (n == 0) { ret res[Chosen, Fail].err{refusal(Part.abi{}, given, "no host of the system runs the architecture under this calling convention", abis)}; }
        ret res[Chosen, Fail].ok{Chosen{host: h, abi: Default.row{named.some}}};
    }
    if (n == 1) {
        val d: Default = h.abi;
        if (sel d.derived) {
            val b: opt[*Abi] = derived(d.derived, s.arch, isa);
            if (sel b.some) { ret res[Chosen, Fail].ok{Chosen{host: h, abi: Default.row{b.some}, derived: true}}; }
        }
        ret res[Chosen, Fail].ok{Chosen{host: h, abi: d}};
    }
    val family: opt[*Derivation] = s.arch.family.derivation;
    if (sel family.none) { ret res[Chosen, Fail].err{refusal(Part.abi{}, nil, "the system's hosts for this architecture differ by calling convention, so the target names one", abis)}; }
    var text: str = isa;
    if (text == nil) {
        val floor: opt[str] = shared_floor(s, e);
        if (sel floor.some) { text = floor.some; }
    }
    if (text == nil) { ret res[Chosen, Fail].err{refusal(Part.abi{}, nil, "the system's hosts for this architecture differ by calling convention and the catalog cites no floor to derive one from, so the target names its convention", abis)}; }
    val b: opt[*Abi] = derived(family.some, s.arch, text);
    if (sel b.none) { ret res[Chosen, Fail].err{refusal(Part.abi{}, nil, "the calling convention follows from the instruction set, which is not an ISA string the family's grammar reads, so the target names its convention", abis)}; }
    n = holding(s, e, b, ?h);
    if (n > 1)  { ret res[Chosen, Fail].err{refusal(Part.abi{}, nil, "two hosts of the system hold for one target, a defect of the catalog", abis)}; }
    if (n == 0) { ret res[Chosen, Fail].err{refusal(Part.abi{}, nil, "no host of the system runs the calling convention the instruction set gives, so the target names one", abis)}; }
    ret res[Chosen, Fail].ok{Chosen{host: h, abi: Default.row{b.some}, derived: true}};
}

# what an instruction set of `a` accepts: one beginning with its base where
# its family spells one, else nothing a list names
fun base_accepted(a: *Arch) opt[Accepts] {
    val g: opt[*Grammar] = a.family.grammar;
    if (sel g.none) { ret opt[Accepts].none{}; }
    val own: opt[*Base] = catalog_isa.base_for(g.some, a.name);
    if (sel own.none) { ret opt[Accepts].none{}; }
    ret listing(base_at, own.some::ptr, nil, nil);
}

# whether the instruction set `given` is one `s` can read, nil being none
# stated. an empty one is refused. where the family has an ISA grammar, one
# the grammar does not spell whole and one whose base names another
# architecture are refused. where it has none, as x86, aarch64, wasm and
# spir-v have none, the catalog states no names to read the text against:
# masc's selection spelling and its check of it are masc's alone, so any
# text that is not empty is taken as stated
fun stated_isa(s: Spec, given: str) err[Fail] {
    if (given == nil)  { ret err[Fail].ok{}; }
    if (given[0] == 0) { ret err[Fail].err{refusal(Part.isa{}, given, "the instruction set is empty", base_accepted(s.arch))}; }
    val g: opt[*Grammar] = s.arch.family.grammar;
    if (sel g.none) { ret err[Fail].ok{}; }
    val base: res[*Base, Fail] = catalog_isa.spelled_base(g.some, text_bytes(given));
    if (sel base.err)                           { ret err[Fail].err{refusal(Part.isa{}, given, "the instruction set is not an ISA string the family's grammar reads", base_accepted(s.arch))}; }
    if (!str_equals(base.ok.arch, s.arch.name)) { ret err[Fail].err{refusal(Part.isa{}, given, "the instruction set begins with the base of another architecture", base_accepted(s.arch))}; }
    ret err[Fail].ok{};
}

# the instruction set `given` names, as stated_isa takes it, or the host's
# floor
fun instruction_set(h: *Host, given: str) Isa {
    if (given != nil)     { ret Isa.stated{given}; }
    if (sel h.floor.some) { ret Isa.floor{h.floor.some}; }
    ret Isa.unbounded{};
}

# the extensions the narrowing adds, each a name named once
fun extensions(n: *Narrowing) err[Fail] {
    if (n.ext_count > 0 && n.ext == nil) { ret err[Fail].err{refusal(Part.extension{}, nil, "the narrowing counts extensions it does not hold", opt[Accepts].none{})}; }
    var i: usize = 0;
    for (i < n.ext_count) {
        val x: str = n.ext[i];
        if (x == nil || x[0] == 0) { ret err[Fail].err{refusal(Part.extension{}, x, "an extension is named by a name", opt[Accepts].none{})}; }
        var j: usize = 0;
        for (j < i) {
            if (str_equals(n.ext[j], x)) { ret err[Fail].err{refusal(Part.extension{}, x, "the extension is named more than once", opt[Accepts].none{})}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the code model `given` names, or the host's default
fun code_model(s: Spec, h: *Host, n: *Narrowing) res[opt[*CodeModel], Fail] {
    val given:  str           = n.code_model;
    val o:      *code.Offered = ?h.code_models;
    val models: opt[Accepts]  = choices(s, n, code_model_at);
    if (given == nil) {
        val t: code.Taken = o.default;
        if (sel t.row)  { ret res[opt[*CodeModel], Fail].ok{opt[*CodeModel].some{t.row}}; }
        or (sel t.none) { ret res[opt[*CodeModel], Fail].ok{opt[*CodeModel].none{}}; }
        ret res[opt[*CodeModel], Fail].err{refusal(Part.code_model{}, nil, "the host states no default code model, a defect of the catalog, so the target names one", models)};
    }
    val m: opt[*CodeModel] = code.named(o, given);
    if (sel m.none) { ret res[opt[*CodeModel], Fail].err{refusal(Part.code_model{}, given, "the target offers no code model of this name", models)}; }
    ret res[opt[*CodeModel], Fail].ok{opt[*CodeModel].some{m.some}};
}

# the linkage of an executable `given` names, or the host's default, none
# where the host runs no executable and none is named. a name no linkage
# has, and a linkage the host's loader does not run, are refused listing what
# the host runs
fun executable_linkage(h: *Host, given: str) res[opt[*Kind], Fail] {
    val l:      *Linking     = h.linking;
    val listed: opt[Accepts] = listing(linkage_listed_at, l::ptr, nil, nil);
    if (given == nil) { ret res[opt[*Kind], Fail].ok{l.default}; }
    val named: res[*Kind, Fail] = output.executable(given);
    if (sel named.err)                 { ret res[opt[*Kind], Fail].err{refusal(Part.linkage{}, given, "no linkage has this name", listed)}; }
    if (!os.runs_linkage(l, named.ok)) { ret res[opt[*Kind], Fail].err{refusal(Part.linkage{}, given, "the target's loader runs no executable of this linkage", listed)}; }
    ret res[opt[*Kind], Fail].ok{opt[*Kind].some{named.ok}};
}

# the object format the narrowing names, or the system's default, the first
# its row lists. a name none of the system's formats has is refused listing
# those it writes
fun object_format(s: Spec, n: *Narrowing) res[*Format, Fail] {
    val given:   str          = n.format;
    val formats: opt[Accepts] = choices(s, n, format_at);
    if (s.sys.format_count == 0) { ret res[*Format, Fail].err{refusal(Part.format{}, given, "the system states no object format, a defect of the catalog", opt[Accepts].none{})}; }
    if (given == nil)            { ret res[*Format, Fail].ok{s.sys.formats[0]}; }
    val named: opt[*Format] = os.format_named(s.sys, given);
    if (sel named.none) { ret res[*Format, Fail].err{refusal(Part.format{}, given, "the system writes no object format of this name", formats)}; }
    ret res[*Format, Fail].ok{named.some};
}

# the target `s` narrowed by `n`, each part `n` leaves out taking the rows'
# default. the first part refused is named, in the order env, isa, abi, ext,
# code model, linkage, format, and a refusal borrows `n`. the instruction set
# is read before the calling convention, which may be derived from it. the
# extensions are only checked as named once, the rest of their check being
# masc's
pub fun resolve(s: Spec, n: *Narrowing) res[Target, Fail] {
    val e: res[opt[*Env], Fail] = environment(s, n);
    if (sel e.err) { ret res[Target, Fail].err{e.err}; }
    val i: err[Fail] = stated_isa(s, n.isa);
    if (sel i.err) { ret res[Target, Fail].err{i.err}; }
    val c: res[Chosen, Fail] = convention(s, e.ok, n);
    if (sel c.err) { ret res[Target, Fail].err{c.err}; }
    val x: err[Fail] = extensions(n);
    if (sel x.err) { ret res[Target, Fail].err{x.err}; }
    val m: res[opt[*CodeModel], Fail] = code_model(s, c.ok.host, n);
    if (sel m.err) { ret res[Target, Fail].err{m.err}; }
    val l: res[opt[*Kind], Fail] = executable_linkage(c.ok.host, n.linkage);
    if (sel l.err) { ret res[Target, Fail].err{l.err}; }
    val f: res[*Format, Fail] = object_format(s, n);
    if (sel f.err) { ret res[Target, Fail].err{f.err}; }
    ret res[Target, Fail].ok{Target{
        sys:        s.sys,
        arch:       s.arch,
        env:        e.ok,
        host:       c.ok.host,
        abi:        c.ok.abi,
        isa:        instruction_set(c.ok.host, n.isa),
        ext:        n.ext,
        ext_count:  n.ext_count,
        code_model: m.ok,
        linkage:    l.ok,
        format:     f.ok
    }};
}

# the instruction set of `t`, in masc's selection spelling. a target whose
# system bounds the machine not at all and that names none is refused, as
# no default is right for it
pub fun isa(t: *Target) res[str, Fail] {
    val i: Isa = t.isa;
    if (sel i.floor)  { ret res[str, Fail].ok{i.floor}; }
    or (sel i.stated) { ret res[str, Fail].ok{i.stated}; }
    ret res[str, Fail].err{refusal(Part.isa{}, nil, "the system bounds the machine not at all, so the target names the instruction set its machine implements", base_accepted(t.arch))};
}

# the calling convention row of `t`, none where its family names none. a
# host that derives it from an instruction set the target does not state is
# refused, so the target names one
pub fun abi(t: *Target) res[opt[*Abi], Fail] {
    val d: Default = t.abi;
    if (sel d.row)  { ret res[opt[*Abi], Fail].ok{opt[*Abi].some{d.row}}; }
    or (sel d.none) { ret res[opt[*Abi], Fail].ok{opt[*Abi].none{}}; }
    ret res[opt[*Abi], Fail].err{refusal(Part.abi{}, nil, "the system derives the calling convention from the instruction set, which the target does not state, so the target names one", choices(Spec{sys: t.sys, arch: t.arch}, ?UNNARROWED, abi_at))};
}

# whether every host of `s` for its architecture leaves the machine
# unbounded, so a target spelled `s` names its instruction set
pub fun needs_isa(s: Spec) bool {
    var any: bool  = false;
    var i:   usize = 0;
    for (i < s.sys.host_count) {
        val h: *Host = ?s.sys.hosts[i];
        i = i + 1;
        if (h.arch != s.arch) { cnt; }
        if (sel h.floor.some) { ret false; }
        any = true;
    }
    ret any;
}

# the output kind of an executable built for `t`, refused listing the
# linkages the host runs where it runs no executable
pub fun executable(t: *Target) res[*Kind, Fail] {
    val l: opt[*Kind] = t.linkage;
    if (sel l.some) { ret res[*Kind, Fail].ok{l.some}; }
    ret res[*Kind, Fail].err{refusal(Part.linkage{}, nil, "the target runs no executable", listing(linkage_listed_at, t.host.linking::ptr, nil, nil))};
}

# the name at `i` of what `l` runs, its default first, nil past the last
fun linkage_at(l: *Linking, i: usize) str {
    val d: opt[*Kind] = l.default;
    if (sel d.none) {
        if (i < l.count) { ret l.rows[i].name; }
        ret nil;
    }
    if (i == 0) { ret d.some.name; }
    var seen: usize = 0;
    var k:    usize = 0;
    for (k < l.count) {
        val row: *Kind = l.rows[k];
        k = k + 1;
        if (row == d.some) { cnt; }
        seen = seen + 1;
        if (seen == i) { ret row.name; }
    }
    ret nil;
}

# whether the host at `i` of `s` is the first for its architecture
fun first_for(s: *System, i: usize) bool {
    var k: usize = 0;
    for (k < i) {
        if (s.hosts[k].arch == s.hosts[i].arch) { ret false; }
        k = k + 1;
    }
    ret true;
}

# every target the catalog spells, appended to `out`: each system in its
# order, then each architecture it runs in the order of its hosts
pub fun list(out: *Vector[Spec]) err[Fail] {
    var k: usize = 0;
    for (k < os_list.count()) {
        val s: *System = os_list.at(k);
        k = k + 1;
        var i: usize = 0;
        for (i < s.host_count) {
            if (first_for(s, i)) {
                val p: err[Fail] = vectors.push[Spec](out, Spec{sys: s, arch: s.hosts[i].arch});
                if (sel p.err) { ret err[Fail].err{p.err}; }
            }
            i = i + 1;
        }
    }
    ret err[Fail].ok{};
}

fun nth_arch(s: *System, n: usize) str {
    var seen: usize = 0;
    var i:    usize = 0;
    for (i < s.host_count) {
        if (first_for(s, i)) {
            if (seen == n) { ret s.hosts[i].arch.name; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    ret nil;
}

# the code models a host of `s` offers, which every host of it states alike
fun offer_of(s: Spec) *code.Offered {
    var i: usize = 0;
    for (i < s.sys.host_count) {
        if (s.sys.hosts[i].arch == s.arch) { ret ?s.sys.hosts[i].code_models; }
        i = i + 1;
    }
    ret ?code.NONE;
}

# whether some host of `s` runs the calling convention `b`, under the
# environment `env` names where it names one
fun allowed(s: Spec, env: str, b: *Abi) bool {
    var i: usize = 0;
    for (i < s.sys.host_count) {
        val h: *Host = ?s.sys.hosts[i];
        i = i + 1;
        if (h.arch != s.arch || !os.conventional(h, b)) { cnt; }
        if (env == nil)                                 { ret true; }
        if (sel h.env.none)                             { cnt; }
        if (str_equals(h.env.some.name, env))           { ret true; }
    }
    ret false;
}

# the host and calling convention `n` selects for `s`, the calling convention
# it names too where `named`. a part of it that is refused selects none
fun selection(s: Spec, n: *Narrowing, named: bool) res[Chosen, Fail] {
    var m: Narrowing = Narrowing{env: n.env, abi: nil, isa: n.isa, ext: n.ext, ext_count: n.ext_count, code_model: n.code_model, linkage: n.linkage, format: n.format};
    if (named) { m.abi = n.abi; }
    val e: res[opt[*Env], Fail] = environment(s, ?m);
    if (sel e.err) { ret res[Chosen, Fail].err{e.err}; }
    ret convention(s, e.ok, ?m);
}

# the choice at `k` of `part` for `s` in the catalog's order, unmarked, none
# past the last: for the environment the hosts with none first, then each
# environment of the system that runs the architecture, for the convention
# each of the architecture's a host runs, and for the code model each the
# hosts offer, and for the format each the system writes
fun candidate(s: Spec, n: *Narrowing, part: Part, k: usize) opt[Choice] {
    var seen: usize = 0;
    if (sel part.env) {
        if (os.runs(s.sys, opt[*Env].none{}, s.arch)) {
            if (k == 0) { ret opt[Choice].some{Choice{name: nil}}; }
            seen = 1;
        }
        var i: usize = 0;
        for (i < os_list.env_count()) {
            val e: *Env = os_list.env_at(i);
            i = i + 1;
            if (e.sys != s.sys || !os.runs(s.sys, opt[*Env].some{e}, s.arch)) { cnt; }
            if (seen == k)                                                    { ret opt[Choice].some{Choice{name: e.name}}; }
            seen = seen + 1;
        }
        ret opt[Choice].none{};
    }
    or (sel part.abi) {
        var i: usize = 0;
        for (i < s.arch.family.abi_count) {
            val b: *Abi = s.arch.family.abis[i];
            i = i + 1;
            if (b.arch != s.arch || !allowed(s, n.env, b)) { cnt; }
            if (seen == k)                                 { ret opt[Choice].some{Choice{name: b.name}}; }
            seen = seen + 1;
        }
        ret opt[Choice].none{};
    }
    or (sel part.code_model) {
        var o: *code.Offered     = offer_of(s);
        val c: res[Chosen, Fail] = selection(s, n, true);
        if (sel c.ok)    { o = ?c.ok.host.code_models; }
        if (k < o.count) { ret opt[Choice].some{Choice{name: o.rows[k].name}}; }
        ret opt[Choice].none{};
    }
    or (sel part.linkage) {
        val c: res[Chosen, Fail] = selection(s, n, true);
        if (sel c.err)                   { ret opt[Choice].none{}; }
        if (k < c.ok.host.linking.count) { ret opt[Choice].some{Choice{name: c.ok.host.linking.rows[k].name}}; }
        ret opt[Choice].none{};
    }
    or (sel part.format) {
        if (k < s.sys.format_count) { ret opt[Choice].some{Choice{name: s.sys.formats[k].name}}; }
        ret opt[Choice].none{};
    }
    ret opt[Choice].none{};
}

# the default of `part` for `s`, as resolve takes it under `n`, none where
# there is none
fun default_of(s: Spec, n: *Narrowing, part: Part) opt[Choice] {
    if (sel part.env) {
        val d: Environment = s.sys.environment;
        if (sel d.named) {
            val e: *Env = d.named;
            if (os.runs(s.sys, opt[*Env].some{e}, s.arch)) { ret opt[Choice].some{Choice{name: e.name, default: true}}; }
        }
        or (sel d.bare) {
            if (os.runs(s.sys, opt[*Env].none{}, s.arch)) { ret opt[Choice].some{Choice{name: nil, default: true}}; }
        }
        ret opt[Choice].none{};
    }
    or (sel part.format) {
        if (s.sys.format_count > 0) { ret opt[Choice].some{Choice{name: s.sys.formats[0].name, default: true}}; }
        ret opt[Choice].none{};
    }
    var named: bool = false;
    if (sel part.code_model) { named = true; }
    or (sel part.linkage)    { named = true; }
    var host:  *Host             = nil;
    var taken: Default;
    var made:  bool              = false;
    val c:     res[Chosen, Fail] = selection(s, n, named);
    if (sel c.ok) {
        host  = c.ok.host;
        taken = c.ok.abi;
        made  = c.ok.derived;
    }
    if (sel part.abi) {
        if (host == nil)   { ret opt[Choice].none{}; }
        if (sel taken.row) { ret opt[Choice].some{Choice{name: taken.row.name, default: true, derived: made}}; }
        ret opt[Choice].none{};
    }
    or (sel part.code_model) {
        var o: *code.Offered = offer_of(s);
        if (host != nil) { o = ?host.code_models; }
        val t: code.Taken = o.default;
        if (sel t.row) { ret opt[Choice].some{Choice{name: t.row.name, default: true}}; }
    }
    or (sel part.linkage) {
        if (host == nil) { ret opt[Choice].none{}; }
        val d: opt[*Kind] = host.linking.default;
        if (sel d.some) { ret opt[Choice].some{Choice{name: d.some.name, default: true}}; }
    }
    ret opt[Choice].none{};
}

# the choice at `i` of the environment, calling convention, code model,
# linkage or format of `s`, its default first and marked, then the rest in the catalog's order,
# none past the last and for any other part. a refusal of the part lists the
# same choices, so the two never disagree
pub fun accepted(s: Spec, n: *Narrowing, part: Part, i: usize) opt[Choice] {
    val d: opt[Choice] = default_of(s, n, part);
    if (sel d.none) { ret candidate(s, n, part, i); }
    val mark: Choice = d.some;
    if (i == 0) { ret d; }
    var seen: usize = 0;
    var k:    usize = 0;
    for {
        val c: opt[Choice] = candidate(s, n, part, k);
        k = k + 1;
        if (sel c.none)               { ret c; }
        if (c.some.name == mark.name) { cnt; }
        seen = seen + 1;
        if (seen == i) { ret c; }
    }
    ret opt[Choice].none{};
}

# the spelling at `i` of what `part` of `s` under `n` accepts that a flag
# can spell
fun spelled_choice(s: Spec, n: *Narrowing, part: Part, i: usize) str {
    var seen: usize = 0;
    var k:    usize = 0;
    for {
        val c: opt[Choice] = accepted(s, n, part, k);
        k = k + 1;
        if (sel c.none)         { ret nil; }
        if (c.some.name == nil) { cnt; }
        if (seen == i)          { ret c.some.name; }
        seen = seen + 1;
    }
    ret nil;
}
