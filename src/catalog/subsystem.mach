# the PE image subsystems
#
# a subsystem is what a PE image's optional header says runs it. each is one
# row keyed by its name, spelled as the linkers' subsystem option spells it,
# with the number the header holds. a target states one by its row, and a host
# names its default by the same row.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;

# name:   its spelling
# number: the optional header's Subsystem value
pub rec Subsystem {
    name:   str;
    number: u16;
}

pub val NATIVE:                  Subsystem = Subsystem{name: "native", number: 1};
pub val WINDOWS:                 Subsystem = Subsystem{name: "windows", number: 2};
pub val CONSOLE:                 Subsystem = Subsystem{name: "console", number: 3};
pub val POSIX:                   Subsystem = Subsystem{name: "posix", number: 7};
pub val EFI_APPLICATION:         Subsystem = Subsystem{name: "efi_application", number: 10};
pub val EFI_BOOT_SERVICE_DRIVER: Subsystem = Subsystem{name: "efi_boot_service_driver", number: 11};
pub val EFI_RUNTIME_DRIVER:      Subsystem = Subsystem{name: "efi_runtime_driver", number: 12};
pub val EFI_ROM:                 Subsystem = Subsystem{name: "efi_rom", number: 13};
pub val XBOX:                    Subsystem = Subsystem{name: "xbox", number: 14};
pub val BOOT_APPLICATION:        Subsystem = Subsystem{name: "boot_application", number: 16};

val ROW_COUNT: usize = 10;

val ROWS: [ROW_COUNT]*Subsystem = [ROW_COUNT]*Subsystem{?NATIVE, ?WINDOWS, ?CONSOLE, ?POSIX, ?EFI_APPLICATION, ?EFI_BOOT_SERVICE_DRIVER, ?EFI_RUNTIME_DRIVER, ?EFI_ROM, ?XBOX, ?BOOT_APPLICATION};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Subsystem {
    ret ROWS[index];
}

# the rows ascending by name
val NAMES: [ROW_COUNT]*Subsystem = [ROW_COUNT]*Subsystem{?BOOT_APPLICATION, ?CONSOLE, ?EFI_APPLICATION, ?EFI_BOOT_SERVICE_DRIVER, ?EFI_ROM, ?EFI_RUNTIME_DRIVER, ?NATIVE, ?POSIX, ?WINDOWS, ?XBOX};

fun order_names(a: **Subsystem, b: **Subsystem) i64 {
    ret str_compare(a[0].name, b[0].name);
}

# the subsystem named `name`
pub fun by_name(name: str) res[*Subsystem, Fail] {
    var probe: Subsystem       = Subsystem{name: name};
    val row:   opt[*Subsystem] = index.find[Subsystem](?NAMES[0], ROW_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*Subsystem, Fail].err{fail.about(fail.unsupported("no PE subsystem has this name"), name)}; }
    ret res[*Subsystem, Fail].ok{row.some};
}
