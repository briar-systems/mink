# the code models
#
# a code model is how far code reaches the address of a symbol, as a psABI
# names it, such as x86-64's small or risc-v's medany. whether an image is
# position independent is its output kind's, never a code model. each is one
# row in its family's file, and a host lists the rows a target on it may pick
# and the one it takes when it names none. a consumer keys what it makes of a
# code model by its row, never by its name.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

# name:   its spelling, which a target names it by
# source: the document and section that state it
# reach:  where code under it reaches a symbol, which bounds where an image
#         linked at its address may lie
pub rec CodeModel {
    name:   str;
    source: str;
    reach:  Reach;
}

# where code under a code model reaches a symbol
# ---
# near:     within the model's distance of the code, wherever the image lies
# absolute: at an address the model's immediates form, within a window
pub tag Reach: u8 {
    near;
    absolute: Window;
}

# the addresses an absolute code model forms, read signed at the address
# width, from low to high inclusive. a window as wide as the address space
# reaches every address of it
pub rec Window {
    low:  i64;
    high: i64;
}

# the first address of a span of bytes at an address width that a model does
# not reach, none where it reaches all of it, as an image linked there needs:
# a model that reaches a symbol by its distance reaches any, an absolute one
# those its window holds
pub fun unreached(m: *CodeModel, width: u32, address: u64, size: u64) opt[u64] {
    if (sel m.reach.near) { ret opt[u64].none{}; }
    if (size == 0)        { ret opt[u64].none{}; }
    val w: Window = m.reach.absolute;
    if (width < 64) {
        val every: u64 = (1::u64 << width) - 1;
        if ((w.high - w.low)::u64 >= every) { ret opt[u64].none{}; }
    }
    if (!within(w, width, address))              { ret opt[u64].some{address}; }
    if (!within(w, width, address + (size - 1))) { ret opt[u64].some{address + (w.high:~u64 - signed(width, address):~u64) + 1}; }
    ret opt[u64].none{};
}

# an address read signed at an address width
fun signed(width: u32, address: u64) i64 {
    if (width >= 64) { ret address:~i64; }
    val shift: u64 = 64 - width::u64;
    ret (address << shift):~i64 >> shift;
}

# whether a window holds an address, read signed at an address width
fun within(w: Window, width: u32, address: u64) bool {
    val at: i64 = signed(width, address);
    ret at >= w.low && at <= w.high;
}

# the code model a target takes when it names none
# ---
# unstated: the row states nothing, a defect of the catalog
# none:     none, as the host has no code models
# row:      this row
pub tag Taken: u8 {
    unstated;
    none;
    row: *CodeModel;
}

# the code models a host offers a target
# ---
# rows:    the rows a target may name, borrowed static data
# count:   how many
# default: the code model a target takes when it names none
pub rec Offered {
    rows:    **CodeModel;
    count:   usize;
    default: Taken;
}

# what a host with no code models offers
pub val NONE: Offered = Offered{rows: nil, count: 0, default: Taken.none{}};

# the row of `o` named `name`, none when `o` lists none of that name
pub fun named(o: *Offered, name: str) opt[*CodeModel] {
    var i: usize = 0;
    for (i < o.count) {
        if (str_equals(o.rows[i].name, name)) { ret opt[*CodeModel].some{o.rows[i]}; }
        i = i + 1;
    }
    ret opt[*CodeModel].none{};
}
