# the code models
#
# a code model is how far code reaches the address of a symbol, as a psABI
# names it, such as x86-64's small or risc-v's medany. whether an image is
# position independent is its output kind's, never a code model. each is one
# row in its family's file, and a host lists the rows a target on it may pick
# and the one it takes when it names none. a consumer keys what it makes of a
# code model by its row, never by its name.

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

# name:   its spelling, which a target names it by
# source: the document and section that state it
pub rec CodeModel {
    name:   str;
    source: str;
}

# the code model a target takes when it names none
# ---
# unstated: the row states nothing, a defect of the catalog
# none:     none, as the host has no code models
# row:      this row
pub tag Taken: u8 {
    unstated;
    none;
    row: *CodeModel;
}

# the code models a host offers a target
# ---
# rows:    the rows a target may name, borrowed static data
# count:   how many
# default: the code model a target takes when it names none
pub rec Offered {
    rows:    **CodeModel;
    count:   usize;
    default: Taken;
}

# what a host with no code models offers
pub val NONE: Offered = Offered{rows: nil, count: 0, default: Taken.none{}};

# the row of `o` named `name`, none when `o` lists none of that name
pub fun named(o: *Offered, name: str) opt[*CodeModel] {
    var i: usize = 0;
    for (i < o.count) {
        if (str_equals(o.rows[i].name, name)) { ret opt[*CodeModel].some{o.rows[i]}; }
        i = i + 1;
    }
    ret opt[*CodeModel].none{};
}
