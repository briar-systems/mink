# the code models
#
# a code model is how code reaches the address of a symbol: within what
# distance, and whether another image may preempt it. each is one row, named
# as the psABI that states it names it, and a host lists the rows a target on
# it may pick and the one it takes when it names none. a consumer keys what it
# makes of a code model by its row, never by its name.

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

# name:   its spelling, which a target names it by
# source: the document and section that state it
pub rec CodeModel {
    name:   str;
    source: str;
}

# the code of a position independent executable, which its loader places
# where it chooses and whose symbols no other image preempts
pub val PIE: CodeModel = CodeModel{name: "pie", source: "System V gABI, dynamic linking, position independent executables"};

# position independent code: a shared object's, whose symbols of default
# visibility another image may preempt as its system's dynamic linking
# states, and every image's on a system whose loader rebases each image
pub val PIC: CodeModel = CodeModel{name: "pic", source: "System V gABI, dynamic linking, position independent code"};

# the code models a host offers a target
# ---
# rows:    the rows a target may name, borrowed static data
# count:   how many
# default: the row a target takes when it names none, none where the host
#          offers no code model at all
pub rec Offered {
    rows:    **CodeModel;
    count:   usize;
    default: opt[*CodeModel];
}

# the row of `o` named `name`, none when `o` lists none of that name
pub fun named(o: *Offered, name: str) opt[*CodeModel] {
    var i: usize = 0;
    for (i < o.count) {
        if (str_equals(o.rows[i].name, name)) { ret opt[*CodeModel].some{o.rows[i]}; }
        i = i + 1;
    }
    ret opt[*CodeModel].none{};
}
