# linux, the ELF system of the glibc psABIs

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.riscv;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os;
use mink.catalog.os.Code;
use mink.catalog.os.Default;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Files;
use mink.catalog.os.Host;
use mink.catalog.os.Kernel;
use mink.catalog.os.Major;
use mink.catalog.os.Naming;
use mink.catalog.os.Order;
use mink.catalog.os.Pattern;
use mink.catalog.os.Placement;
use mink.catalog.os.Step;
use mink.catalog.os.System;
use mink.catalog.os.When;
use mink.catalog.output;
use mink.catalog.trait.Setting;

# linux: elf osabi is ELFOSABI_NONE, which linkers write. loaders and library
# directories are the glibc paths from the psABIs and glibc's multiarch layout
val LINUX_CODE_COUNT:   usize                       = 1;
val LINUX_CODES:        [LINUX_CODE_COUNT]Code      = [LINUX_CODE_COUNT]Code{Code{format: ?format.ELF, value: 0}};
val LINUX_FORMAT_COUNT: usize                       = 1;
val LINUX_FORMATS:      [LINUX_FORMAT_COUNT]*Format = [LINUX_FORMAT_COUNT]*Format{?format.ELF};
val LINUX_ENTRIES:      [1]Entry                    = [1]Entry{Entry{caps: output.ENTERED, symbol: "_start"}};

# the floors: x86_64 the psABI baseline, aarch64 armv8.0-a with the floating
# point and advanced simd registers AAPCS64 passes values in, and riscv64
# rv64gc, the riscv64 distributions' baseline, under every float abi, since
# the abi chooses how values pass and not what the machine has. i386 and
# riscv32 have no floor a document states
val LINUX_RISCV64_FLOOR: str = "rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0_zicsr2p0_zifencei2p0";

# glibc, the gnu environment
pub val GNU: Env = Env{sys: ?LINUX, name: "gnu"};

val LINUX_X86_64_LIBDIR_COUNT: usize                          = 6;
val LINUX_X86_64_LIBDIRS:      [LINUX_X86_64_LIBDIR_COUNT]str = [LINUX_X86_64_LIBDIR_COUNT]str{"/lib64", "/usr/lib64", "/lib/x86_64-linux-gnu", "/usr/lib/x86_64-linux-gnu", "/usr/lib", "/lib"};
# i386 psABI interpreter path; library directories from glibc's i386 multiarch layout
val LINUX_X86_LIBDIR_COUNT:     usize                           = 6;
val LINUX_X86_LIBDIRS:          [LINUX_X86_LIBDIR_COUNT]str     = [LINUX_X86_LIBDIR_COUNT]str{"/lib32", "/usr/lib32", "/lib/i386-linux-gnu", "/usr/lib/i386-linux-gnu", "/usr/lib", "/lib"};
val LINUX_AARCH64_LIBDIR_COUNT: usize                           = 6;
val LINUX_AARCH64_LIBDIRS:      [LINUX_AARCH64_LIBDIR_COUNT]str = [LINUX_AARCH64_LIBDIR_COUNT]str{"/lib/aarch64-linux-gnu", "/usr/lib/aarch64-linux-gnu", "/lib64", "/usr/lib64", "/usr/lib", "/lib"};
val LINUX_RISCV64_LIBDIR_COUNT: usize                           = 6;
val LINUX_RISCV64_LIBDIRS:      [LINUX_RISCV64_LIBDIR_COUNT]str = [LINUX_RISCV64_LIBDIR_COUNT]str{"/lib/riscv64-linux-gnu", "/usr/lib/riscv64-linux-gnu", "/lib64", "/usr/lib64", "/usr/lib", "/lib"};
# glibc's riscv32 loader names, in glibc since 2.33; linux has no mainline riscv32 port
val LINUX_RISCV32_LIBDIR_COUNT: usize                           = 6;
val LINUX_RISCV32_LIBDIRS:      [LINUX_RISCV32_LIBDIR_COUNT]str = [LINUX_RISCV32_LIBDIR_COUNT]str{"/lib/riscv32-linux-gnu", "/usr/lib/riscv32-linux-gnu", "/lib32", "/usr/lib32", "/usr/lib", "/lib"};

# a name is looked for in each directory as the shared object before the
# archive, and glibc installs libc.so and libm.so as GNU linker scripts naming
# the libraries and the loader. static first looks in every directory for an
# object, then an archive, each with the prefix and then without, before any
# for the shared object, as mach's search does. where every directory misses,
# the highest single-number major present is taken, as a host with only
# `libGL.so.1` holds
val LINUX_SO:           Pattern     = Pattern{prefix: "lib", suffix: ".so", loaded: true};
val LINUX_O:            Pattern     = Pattern{prefix: "lib", suffix: ".o", loaded: false};
val LINUX_BARE_O:       Pattern     = Pattern{prefix: "", suffix: ".o", loaded: false};
val LINUX_A:            Pattern     = Pattern{prefix: "lib", suffix: ".a", loaded: false};
val LINUX_BARE_A:       Pattern     = Pattern{prefix: "", suffix: ".a", loaded: false};
val LINUX_MAJOR:        Major       = Major{prefix: "lib", infix: ".so.", suffix: ""};
val LINUX_GNU:          [2]*Pattern = [2]*Pattern{?LINUX_SO, ?LINUX_A};
val LINUX_STATIC:       [4]*Pattern = [4]*Pattern{?LINUX_O, ?LINUX_BARE_O, ?LINUX_A, ?LINUX_BARE_A};
val LINUX_SHARED:       [1]*Pattern = [1]*Pattern{?LINUX_SO};
val LINUX_SHARED_FIRST: [2]Step     = [2]Step{Step.files{Files{rows: ?LINUX_GNU[0], count: 2}}, Step.majors{?LINUX_MAJOR}};
val LINUX_STATIC_FIRST: [3]Step     = [3]Step{Step.files{Files{rows: ?LINUX_STATIC[0], count: 4}}, Step.files{Files{rows: ?LINUX_SHARED[0], count: 1}}, Step.majors{?LINUX_MAJOR}};
val LINUX_NAMING:       Naming      = Naming{shared_first: Order{steps: ?LINUX_SHARED_FIRST[0], count: 2}, static_first: Order{steps: ?LINUX_STATIC_FIRST[0], count: 3}, scripts: true};

# glibc names a RISC-V loader by the float ABI, so the soft and the double
# float ABI are two rows. glibc builds no single float loader, so a riscv64
# or riscv32 single float image runs only as a static one, and its row has no
# interpreter
# the kernel maps an executable at the addresses its program headers state
val LINUX_PLACEMENT: Placement = Placement.linked{"the kernel maps an ET_EXEC image at its p_vaddr, System V gABI program loading and linux fs/binfmt_elf.c"};

# the kernel exposes the processor's FEAT_DIT as HWCAP_DIT in AT_HWCAP since
# v4.17 (Documentation/arch/arm64/elf_hwcaps.rst) and saves PSTATE in
# SPSR_EL1 across every exception, so an aarch64 process keeps the mode
# whatever runtime it links. the kernel reports the Zkt extension of a riscv
# processor through riscv_hwprobe's RISCV_HWPROBE_EXT_ZKT bit
# (Documentation/arch/riscv/hwprobe.rst) and has nothing a process enables
val LINUX_KERNEL_COUNT: usize                      = 3;
val LINUX_KERNEL:       [LINUX_KERNEL_COUNT]Kernel = [LINUX_KERNEL_COUNT]Kernel{
    Kernel{arch: ?aarch64.AARCH64, caps: os.TIMING_MODE_PROVABLE},
    Kernel{arch: ?riscv.RISCV64, caps: os.TIMING_PROBED},
    Kernel{arch: ?riscv.RISCV32, caps: os.TIMING_PROBED},
};

val LINUX_HOST_COUNT: usize = 18;
# the rows that state env none are for a program that talks to the kernel
# directly and links no C library: static images with no loader and no
# library directories, each beside the glibc row of its architecture
val LINUX_HOSTS: [LINUX_HOST_COUNT]Host = [LINUX_HOST_COUNT]Host{
    Host{sys: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?x86.X86_64, interpreter: "/lib64/ld-linux-x86-64.so.2", libdirs: ?LINUX_X86_64_LIBDIRS[0], libdir_count: LINUX_X86_64_LIBDIR_COUNT, naming: opt[*Naming].some{?LINUX_NAMING}, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?x86.X86_64_SYSV64}, placement: LINUX_PLACEMENT, floor: opt[str].some{x86.X86_64_BASELINE}},
    Host{sys: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?x86.X86, interpreter: "/lib/ld-linux.so.2", libdirs: ?LINUX_X86_LIBDIRS[0], libdir_count: LINUX_X86_LIBDIR_COUNT, naming: opt[*Naming].some{?LINUX_NAMING}, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?x86.X86_SYSV32}, placement: LINUX_PLACEMENT},
    Host{sys: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?aarch64.AARCH64, interpreter: "/lib/ld-linux-aarch64.so.1", libdirs: ?LINUX_AARCH64_LIBDIRS[0], libdir_count: LINUX_AARCH64_LIBDIR_COUNT, naming: opt[*Naming].some{?LINUX_NAMING}, image_base: 0x400000, page: 0x1_0000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?aarch64.AARCH64_AAPCS64}, placement: LINUX_PLACEMENT, floor: opt[str].some{"armv8-a+fp+simd"}},
    Host{sys: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?riscv.RISCV64, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_DOUBLE}}}, interpreter: "/lib/ld-linux-riscv64-lp64d.so.1", libdirs: ?LINUX_RISCV64_LIBDIRS[0], libdir_count: LINUX_RISCV64_LIBDIR_COUNT, naming: opt[*Naming].some{?LINUX_NAMING}, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?riscv.RISCV_LP64D}, placement: LINUX_PLACEMENT, floor: opt[str].some{LINUX_RISCV64_FLOOR}},
    Host{sys: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?riscv.RISCV64, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_SOFT}}}, interpreter: "/lib/ld-linux-riscv64-lp64.so.1", libdirs: ?LINUX_RISCV64_LIBDIRS[0], libdir_count: LINUX_RISCV64_LIBDIR_COUNT, naming: opt[*Naming].some{?LINUX_NAMING}, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?riscv.RISCV_LP64}, placement: LINUX_PLACEMENT, floor: opt[str].some{LINUX_RISCV64_FLOOR}},
    Host{sys: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?riscv.RISCV64, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_SINGLE}}}, interpreter: nil, libdirs: ?LINUX_RISCV64_LIBDIRS[0], libdir_count: LINUX_RISCV64_LIBDIR_COUNT, naming: opt[*Naming].some{?LINUX_NAMING}, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?riscv.RISCV_LP64F}, placement: LINUX_PLACEMENT, floor: opt[str].some{LINUX_RISCV64_FLOOR}},
    Host{sys: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?riscv.RISCV32, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_DOUBLE}}}, interpreter: "/lib/ld-linux-riscv32-ilp32d.so.1", libdirs: ?LINUX_RISCV32_LIBDIRS[0], libdir_count: LINUX_RISCV32_LIBDIR_COUNT, naming: opt[*Naming].some{?LINUX_NAMING}, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?riscv.RISCV_ILP32D}, placement: LINUX_PLACEMENT},
    Host{sys: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?riscv.RISCV32, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_SOFT}}}, interpreter: "/lib/ld-linux-riscv32-ilp32.so.1", libdirs: ?LINUX_RISCV32_LIBDIRS[0], libdir_count: LINUX_RISCV32_LIBDIR_COUNT, naming: opt[*Naming].some{?LINUX_NAMING}, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?riscv.RISCV_ILP32}, placement: LINUX_PLACEMENT},
    Host{sys: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?riscv.RISCV32, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_SINGLE}}}, interpreter: nil, libdirs: ?LINUX_RISCV32_LIBDIRS[0], libdir_count: LINUX_RISCV32_LIBDIR_COUNT, naming: opt[*Naming].some{?LINUX_NAMING}, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?riscv.RISCV_ILP32F}, placement: LINUX_PLACEMENT},
    Host{sys: ?LINUX, env: opt[*Env].none{}, arch: ?x86.X86_64, interpreter: nil, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?x86.X86_64_SYSV64}, placement: LINUX_PLACEMENT, floor: opt[str].some{x86.X86_64_BASELINE}},
    Host{sys: ?LINUX, env: opt[*Env].none{}, arch: ?x86.X86, interpreter: nil, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?x86.X86_SYSV32}, placement: LINUX_PLACEMENT},
    Host{sys: ?LINUX, env: opt[*Env].none{}, arch: ?aarch64.AARCH64, interpreter: nil, image_base: 0x400000, page: 0x1_0000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?aarch64.AARCH64_AAPCS64}, placement: LINUX_PLACEMENT, floor: opt[str].some{"armv8-a+fp+simd"}},
    Host{sys: ?LINUX, env: opt[*Env].none{}, arch: ?riscv.RISCV64, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_DOUBLE}}}, interpreter: nil, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?riscv.RISCV_LP64D}, placement: LINUX_PLACEMENT, floor: opt[str].some{LINUX_RISCV64_FLOOR}},
    Host{sys: ?LINUX, env: opt[*Env].none{}, arch: ?riscv.RISCV64, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_SOFT}}}, interpreter: nil, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?riscv.RISCV_LP64}, placement: LINUX_PLACEMENT, floor: opt[str].some{LINUX_RISCV64_FLOOR}},
    Host{sys: ?LINUX, env: opt[*Env].none{}, arch: ?riscv.RISCV64, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_SINGLE}}}, interpreter: nil, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?riscv.RISCV_LP64F}, placement: LINUX_PLACEMENT, floor: opt[str].some{LINUX_RISCV64_FLOOR}},
    Host{sys: ?LINUX, env: opt[*Env].none{}, arch: ?riscv.RISCV32, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_DOUBLE}}}, interpreter: nil, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?riscv.RISCV_ILP32D}, placement: LINUX_PLACEMENT},
    Host{sys: ?LINUX, env: opt[*Env].none{}, arch: ?riscv.RISCV32, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_SOFT}}}, interpreter: nil, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?riscv.RISCV_ILP32}, placement: LINUX_PLACEMENT},
    Host{sys: ?LINUX, env: opt[*Env].none{}, arch: ?riscv.RISCV32, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_SINGLE}}}, interpreter: nil, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1, abi: Default.row{?riscv.RISCV_ILP32F}, placement: LINUX_PLACEMENT},
};

pub val LINUX: System = System{
    name:         "linux",
    mapped:       true,
    formats:      ?LINUX_FORMATS[0],
    format_count: LINUX_FORMAT_COUNT,
    codes:        ?LINUX_CODES[0],
    code_count:   LINUX_CODE_COUNT,
    hosts:        ?LINUX_HOSTS[0],
    host_count:   LINUX_HOST_COUNT,
    kernel:       ?LINUX_KERNEL[0],
    kernel_count: LINUX_KERNEL_COUNT,
};
