# linux, the ELF system of the glibc psABIs

use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.riscv;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os;
use mink.catalog.os.Code;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Host;
use mink.catalog.os.System;
use mink.catalog.os.When;
use mink.catalog.output;
use mink.catalog.trait.Setting;

# linux: elf osabi is ELFOSABI_NONE, which linkers write. loaders and library
# directories are the glibc paths from the psABIs and glibc's multiarch layout
val LINUX_CODE_COUNT:   usize                       = 1;
val LINUX_CODES:        [LINUX_CODE_COUNT]Code      = [LINUX_CODE_COUNT]Code{Code{format: ?format.ELF, value: 0}};
val LINUX_FORMAT_COUNT: usize                       = 1;
val LINUX_FORMATS:      [LINUX_FORMAT_COUNT]*Format = [LINUX_FORMAT_COUNT]*Format{?format.ELF};
val LINUX_ENTRIES:      [1]Entry                    = [1]Entry{Entry{caps: output.ENTERED, symbol: "_start"}};

# glibc, the gnu environment
pub val GNU: Env = Env{system: ?LINUX, name: "gnu"};

val LINUX_X86_64_LIBDIR_COUNT: usize                          = 6;
val LINUX_X86_64_LIBDIRS:      [LINUX_X86_64_LIBDIR_COUNT]str = [LINUX_X86_64_LIBDIR_COUNT]str{"/lib64", "/usr/lib64", "/lib/x86_64-linux-gnu", "/usr/lib/x86_64-linux-gnu", "/usr/lib", "/lib"};
# i386 psABI interpreter path; library directories from glibc's i386 multiarch layout
val LINUX_X86_LIBDIR_COUNT:     usize                           = 6;
val LINUX_X86_LIBDIRS:          [LINUX_X86_LIBDIR_COUNT]str     = [LINUX_X86_LIBDIR_COUNT]str{"/lib32", "/usr/lib32", "/lib/i386-linux-gnu", "/usr/lib/i386-linux-gnu", "/usr/lib", "/lib"};
val LINUX_AARCH64_LIBDIR_COUNT: usize                           = 6;
val LINUX_AARCH64_LIBDIRS:      [LINUX_AARCH64_LIBDIR_COUNT]str = [LINUX_AARCH64_LIBDIR_COUNT]str{"/lib/aarch64-linux-gnu", "/usr/lib/aarch64-linux-gnu", "/lib64", "/usr/lib64", "/usr/lib", "/lib"};
val LINUX_RISCV64_LIBDIR_COUNT: usize                           = 6;
val LINUX_RISCV64_LIBDIRS:      [LINUX_RISCV64_LIBDIR_COUNT]str = [LINUX_RISCV64_LIBDIR_COUNT]str{"/lib/riscv64-linux-gnu", "/usr/lib/riscv64-linux-gnu", "/lib64", "/usr/lib64", "/usr/lib", "/lib"};
# glibc's riscv32 loader names, in glibc since 2.33; linux has no mainline riscv32 port
val LINUX_RISCV32_LIBDIR_COUNT: usize                           = 6;
val LINUX_RISCV32_LIBDIRS:      [LINUX_RISCV32_LIBDIR_COUNT]str = [LINUX_RISCV32_LIBDIR_COUNT]str{"/lib/riscv32-linux-gnu", "/usr/lib/riscv32-linux-gnu", "/lib32", "/usr/lib32", "/usr/lib", "/lib"};

# glibc names a RISC-V loader by the float ABI, so the soft and the double
# float ABI are two rows. glibc builds no single float loader
val LINUX_HOST_COUNT: usize                  = 7;
val LINUX_HOSTS:      [LINUX_HOST_COUNT]Host = [LINUX_HOST_COUNT]Host{
    Host{system: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?x86.X86_64, interpreter: "/lib64/ld-linux-x86-64.so.2", libdirs: ?LINUX_X86_64_LIBDIRS[0], libdir_count: LINUX_X86_64_LIBDIR_COUNT, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1},
    Host{system: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?x86.X86, interpreter: "/lib/ld-linux.so.2", libdirs: ?LINUX_X86_LIBDIRS[0], libdir_count: LINUX_X86_LIBDIR_COUNT, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1},
    Host{system: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?aarch64.AARCH64, interpreter: "/lib/ld-linux-aarch64.so.1", libdirs: ?LINUX_AARCH64_LIBDIRS[0], libdir_count: LINUX_AARCH64_LIBDIR_COUNT, image_base: 0x400000, page: 0x1_0000, caps: os.DIT_GUARANTEED, entries: ?LINUX_ENTRIES[0], entry_count: 1},
    Host{system: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?riscv.RISCV64, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_DOUBLE}}}, interpreter: "/lib/ld-linux-riscv64-lp64d.so.1", libdirs: ?LINUX_RISCV64_LIBDIRS[0], libdir_count: LINUX_RISCV64_LIBDIR_COUNT, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1},
    Host{system: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?riscv.RISCV64, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_SOFT}}}, interpreter: "/lib/ld-linux-riscv64-lp64.so.1", libdirs: ?LINUX_RISCV64_LIBDIRS[0], libdir_count: LINUX_RISCV64_LIBDIR_COUNT, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1},
    Host{system: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?riscv.RISCV32, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_DOUBLE}}}, interpreter: "/lib/ld-linux-riscv32-ilp32d.so.1", libdirs: ?LINUX_RISCV32_LIBDIRS[0], libdir_count: LINUX_RISCV32_LIBDIR_COUNT, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1},
    Host{system: ?LINUX, env: opt[*Env].some{?GNU}, arch: ?riscv.RISCV32, when: opt[When].some{When{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{?riscv.RISCV_SOFT}}}, interpreter: "/lib/ld-linux-riscv32-ilp32.so.1", libdirs: ?LINUX_RISCV32_LIBDIRS[0], libdir_count: LINUX_RISCV32_LIBDIR_COUNT, image_base: 0x400000, page: 0x1000, caps: 0, entries: ?LINUX_ENTRIES[0], entry_count: 1},
};

pub val LINUX: System = System{
    name:         "linux",
    mapped:       true,
    formats:      ?LINUX_FORMATS[0],
    format_count: LINUX_FORMAT_COUNT,
    codes:        ?LINUX_CODES[0],
    code_count:   LINUX_CODE_COUNT,
    hosts:        ?LINUX_HOSTS[0],
    host_count:   LINUX_HOST_COUNT,
};
