# windows, the PE/COFF system

use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Code;
use mink.catalog.format.Format;
use mink.catalog.os;
use mink.catalog.os.Host;
use mink.catalog.os.Os;
use mink.catalog.os.Version;

# windows: IMAGE_SUBSYSTEM_WINDOWS_CUI in the PE optional header
val WINDOWS_CODE_COUNT:    usize                         = 1;
val WINDOWS_CODES:         [WINDOWS_CODE_COUNT]Code      = [WINDOWS_CODE_COUNT]Code{Code{format: ?format.COFF, value: 3}};
val WINDOWS_FORMAT_COUNT:  usize                         = 1;
val WINDOWS_FORMATS:       [WINDOWS_FORMAT_COUNT]*Format = [WINDOWS_FORMAT_COUNT]*Format{?format.COFF};
val WINDOWS_LIBDIR_COUNT:  usize                         = 1;
val WINDOWS_LIBDIRS:       [WINDOWS_LIBDIR_COUNT]str     = [WINDOWS_LIBDIR_COUNT]str{"C:\\Windows\\System32"};
val WINDOWS_LIBRARY_COUNT: usize                         = 1;
val WINDOWS_LIBRARIES:     [WINDOWS_LIBRARY_COUNT]str    = [WINDOWS_LIBRARY_COUNT]str{"kernel32.dll"};

val WINDOWS_HOST_COUNT: usize                    = 2;
val WINDOWS_HOSTS:      [WINDOWS_HOST_COUNT]Host = [WINDOWS_HOST_COUNT]Host{
    Host{arch: ?x86.X86_64, interpreter: nil, libdirs: ?WINDOWS_LIBDIRS[0], libdir_count: WINDOWS_LIBDIR_COUNT, image_base: 0x140000000, page_size: 0x1000, caps: os.PIE_DEFAULT},
    Host{arch: ?aarch64.AARCH64, interpreter: nil, libdirs: ?WINDOWS_LIBDIRS[0], libdir_count: WINDOWS_LIBDIR_COUNT, image_base: 0x140000000, page_size: 0x1000, caps: 0},
};

pub val WINDOWS: Os = Os{
    name:                "windows",
    codes:               ?WINDOWS_CODES[0],
    code_count:          WINDOWS_CODE_COUNT,
    hosts:               ?WINDOWS_HOSTS[0],
    host_count:          WINDOWS_HOST_COUNT,
    entry:               "mainCRTStartup",
    mapped:              true,
    formats:             ?WINDOWS_FORMATS[0],
    format_count:        WINDOWS_FORMAT_COUNT,
    libraries:           ?WINDOWS_LIBRARIES[0],
    library_count:       WINDOWS_LIBRARY_COUNT,
    framework_dirs:      nil,
    framework_dir_count: 0,
    min_version:         Version{major: 0, minor: 0, patch: 0},
};
