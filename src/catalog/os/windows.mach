# windows, the PE/COFF system

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.kind;
use mink.catalog.os;
use mink.catalog.os.Built;
use mink.catalog.os.Default;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Filename;
use mink.catalog.os.Files;
use mink.catalog.os.Host;
use mink.catalog.os.Naming;
use mink.catalog.os.Order;
use mink.catalog.os.Pattern;
use mink.catalog.os.Placement;
use mink.catalog.os.Product;
use mink.catalog.os.Step;
use mink.catalog.os.System;
use mink.catalog.output;
use mink.catalog.subsystem;
use mink.catalog.subsystem.Subsystem;

val WINDOWS_FORMAT_COUNT:  usize                         = 1;
val WINDOWS_FORMATS:       [WINDOWS_FORMAT_COUNT]*Format = [WINDOWS_FORMAT_COUNT]*Format{?format.COFF};
val WINDOWS_LIBRARY_COUNT: usize                         = 1;
val WINDOWS_LIBRARIES:     [WINDOWS_LIBRARY_COUNT]str    = [WINDOWS_LIBRARY_COUNT]str{"kernel32.dll"};
val WINDOWS_ENTRIES:       [1]Entry                      = [1]Entry{Entry{caps: output.ENTERED, symbol: "mainCRTStartup"}};

# a name binds a DLL through its import library: the Windows SDK's
# `<name>.lib`, then the MinGW `lib<name>.dll.a` and `lib<name>.a`. a name
# ending in .dll names the DLL itself, so the suffix is dropped first. the
# system states no directory of import libraries, so a link names its own.
# static first looks in every directory for `.o`, `.obj`, `.a` then `.lib`,
# each with the prefix and then without, before any for the MinGW import
# library, as mach's search does. a DLL has no versioned file name
val WINDOWS_LIB:          Pattern     = Pattern{prefix: "", suffix: ".lib", loaded: false};
val WINDOWS_PREFIXED_LIB: Pattern     = Pattern{prefix: "lib", suffix: ".lib", loaded: false};
val WINDOWS_DLL_A:        Pattern     = Pattern{prefix: "lib", suffix: ".dll.a", loaded: true};
val WINDOWS_O:            Pattern     = Pattern{prefix: "lib", suffix: ".o", loaded: false};
val WINDOWS_BARE_O:       Pattern     = Pattern{prefix: "", suffix: ".o", loaded: false};
val WINDOWS_OBJ:          Pattern     = Pattern{prefix: "lib", suffix: ".obj", loaded: false};
val WINDOWS_BARE_OBJ:     Pattern     = Pattern{prefix: "", suffix: ".obj", loaded: false};
val WINDOWS_A:            Pattern     = Pattern{prefix: "lib", suffix: ".a", loaded: false};
val WINDOWS_BARE_A:       Pattern     = Pattern{prefix: "", suffix: ".a", loaded: false};
val WINDOWS_MINGW:        [3]*Pattern = [3]*Pattern{?WINDOWS_LIB, ?WINDOWS_DLL_A, ?WINDOWS_A};
val WINDOWS_STATIC:       [8]*Pattern = [8]*Pattern{?WINDOWS_O, ?WINDOWS_BARE_O, ?WINDOWS_OBJ, ?WINDOWS_BARE_OBJ, ?WINDOWS_A, ?WINDOWS_BARE_A, ?WINDOWS_PREFIXED_LIB, ?WINDOWS_LIB};
val WINDOWS_SHARED:       [1]*Pattern = [1]*Pattern{?WINDOWS_DLL_A};
val WINDOWS_SHARED_FIRST: [1]Step     = [1]Step{Step.files{Files{rows: ?WINDOWS_MINGW[0], count: 3}}};
val WINDOWS_STATIC_FIRST: [2]Step     = [2]Step{Step.files{Files{rows: ?WINDOWS_STATIC[0], count: 8}}, Step.files{Files{rows: ?WINDOWS_SHARED[0], count: 1}}};
val WINDOWS_NAMING:       Naming      = Naming{shared_first: Order{steps: ?WINDOWS_SHARED_FIRST[0], count: 1}, static_first: Order{steps: ?WINDOWS_STATIC_FIRST[0], count: 2}, stem: ".dll"};

# the microsoft C runtime
pub val MSVC: Env = Env{sys: ?WINDOWS, name: "msvc"};

# the loader honours an x86_64 image's fixed base, while ARM64 and ARM64EC
# images always have a dynamic base
val WINDOWS_X86_64_PLACEMENT:  Placement = Placement.linked{"the loader maps an image without IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE at its ImageBase"};
val WINDOWS_AARCH64_PLACEMENT: Placement = Placement.relocated{"the loader always relocates an ARM64 image"};
val WINDOWS_ARM64EC_PLACEMENT: Placement = Placement.relocated{"the loader always relocates an ARM64EC image, as it does an ARM64 one"};

# both write console images by default. the floor is windows 11's processor
# requirement (minimum hardware requirements for windows 11, 3.5): x64 with
# sse4.1, cmpxchg16b, lahf/sahf and prefetchw, which is short of x86-64-v2's
# popcnt and sse4.2, and arm64 with fp and neon (the arm64 abi conventions'
# base requirements) and the armv8.1 atomics. ARM64EC runs the arm64
# instruction set on the same processors, so its floor is arm64's
val WINDOWS_HOST_COUNT: usize                    = 3;
val WINDOWS_HOSTS:      [WINDOWS_HOST_COUNT]Host = [WINDOWS_HOST_COUNT]Host{
    Host{sys: ?WINDOWS, env: opt[*Env].some{?MSVC}, arch: ?x86.X86_64, interpreter: nil, naming: opt[*Naming].some{?WINDOWS_NAMING}, image_base: 0x140000000, page: 0x1000, caps: os.PIE_DEFAULT, entries: ?WINDOWS_ENTRIES[0], entry_count: 1, libraries: ?WINDOWS_LIBRARIES[0], library_count: WINDOWS_LIBRARY_COUNT, subsystem: opt[*Subsystem].some{?subsystem.CONSOLE}, abi: Default.row{?x86.X86_64_WIN64}, placement: WINDOWS_X86_64_PLACEMENT, floor: opt[str].some{"cmov,cx8,x87,fxsr,osfxsr,mmx,sce,sse,sse2,cx16,lahf,prefetchw,sse41"}},
    Host{sys: ?WINDOWS, env: opt[*Env].some{?MSVC}, arch: ?aarch64.AARCH64, interpreter: nil, naming: opt[*Naming].some{?WINDOWS_NAMING}, image_base: 0x140000000, page: 0x1000, caps: 0, entries: ?WINDOWS_ENTRIES[0], entry_count: 1, libraries: ?WINDOWS_LIBRARIES[0], library_count: WINDOWS_LIBRARY_COUNT, subsystem: opt[*Subsystem].some{?subsystem.CONSOLE}, abi: Default.row{?aarch64.AARCH64_AAPCS64WIN}, placement: WINDOWS_AARCH64_PLACEMENT, floor: opt[str].some{"armv8-a+fp+simd+lse"}},
    Host{sys: ?WINDOWS, env: opt[*Env].some{?MSVC}, arch: ?aarch64.ARM64EC, interpreter: nil, naming: opt[*Naming].some{?WINDOWS_NAMING}, image_base: 0x140000000, page: 0x1000, caps: 0, entries: ?WINDOWS_ENTRIES[0], entry_count: 1, libraries: ?WINDOWS_LIBRARIES[0], library_count: WINDOWS_LIBRARY_COUNT, subsystem: opt[*Subsystem].some{?subsystem.CONSOLE}, abi: Default.row{?aarch64.ARM64EC_ARM64EC}, placement: WINDOWS_ARM64EC_PLACEMENT, floor: opt[str].some{"armv8-a+fp+simd+lse"}},
};

# a link names an object `<stem>.obj`, an executable `<stem>.exe`, a static
# library `<stem>.lib` and a DLL `<stem>.dll`. PE has no module a runtime
# instantiates
val WINDOWS_OBJECT_FILE:     Filename                       = Filename{prefix: "", extension: ".obj"};
val WINDOWS_EXECUTABLE_FILE: Filename                       = Filename{prefix: "", extension: ".exe"};
val WINDOWS_ARCHIVE_FILE:    Filename                       = Filename{prefix: "", extension: ".lib"};
val WINDOWS_SHARED_FILE:     Filename                       = Filename{prefix: "", extension: ".dll"};
val WINDOWS_PRODUCT_COUNT:   usize                          = 6;
val WINDOWS_PRODUCTS:        [WINDOWS_PRODUCT_COUNT]Product = [WINDOWS_PRODUCT_COUNT]Product{
    Product{kind: ?kind.RELOCATABLE, built: Built.named{?WINDOWS_OBJECT_FILE}},
    Product{kind: ?kind.EXECUTABLE, built: Built.named{?WINDOWS_EXECUTABLE_FILE}},
    Product{kind: ?kind.PIE, built: Built.named{?WINDOWS_EXECUTABLE_FILE}},
    Product{kind: ?kind.SHARED, built: Built.named{?WINDOWS_SHARED_FILE}},
    Product{kind: ?kind.ARCHIVE, built: Built.named{?WINDOWS_ARCHIVE_FILE}},
    Product{kind: ?kind.MODULE, built: Built.unbuilt{"PE has no module a runtime instantiates, PE format image only and object only fields"}},
};

pub val WINDOWS: System = System{
    name:          "windows",
    mapped:        true,
    formats:       ?WINDOWS_FORMATS[0],
    format_count:  WINDOWS_FORMAT_COUNT,
    hosts:         ?WINDOWS_HOSTS[0],
    host_count:    WINDOWS_HOST_COUNT,
    products:      ?WINDOWS_PRODUCTS[0],
    product_count: WINDOWS_PRODUCT_COUNT,
};
