# windows, the PE/COFF system

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os;
use mink.catalog.os.Default;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Host;
use mink.catalog.os.Naming;
use mink.catalog.os.Pattern;
use mink.catalog.os.Placement;
use mink.catalog.os.System;
use mink.catalog.output;
use mink.catalog.subsystem;
use mink.catalog.subsystem.Subsystem;

val WINDOWS_FORMAT_COUNT:  usize                         = 1;
val WINDOWS_FORMATS:       [WINDOWS_FORMAT_COUNT]*Format = [WINDOWS_FORMAT_COUNT]*Format{?format.COFF};
val WINDOWS_LIBRARY_COUNT: usize                         = 1;
val WINDOWS_LIBRARIES:     [WINDOWS_LIBRARY_COUNT]str    = [WINDOWS_LIBRARY_COUNT]str{"kernel32.dll"};
val WINDOWS_ENTRIES:       [1]Entry                      = [1]Entry{Entry{caps: output.ENTERED, symbol: "mainCRTStartup"}};

# a name binds a DLL through its import library: link.exe's `<name>.lib`,
# then the MinGW `lib<name>.dll.a` and `lib<name>.a`, as lld's MinGW driver
# looks for them. a name ending in .dll names the DLL itself, so the suffix
# is dropped first. the system states no directory of import libraries, so a
# link names its own
val WINDOWS_FILES:  [3]Pattern = [3]Pattern{Pattern{prefix: "", suffix: ".lib", loaded: false}, Pattern{prefix: "lib", suffix: ".dll.a", loaded: true}, Pattern{prefix: "lib", suffix: ".a", loaded: false}};
val WINDOWS_NAMING: Naming     = Naming{files: ?WINDOWS_FILES[0], file_count: 3, stem: ".dll"};

# the microsoft C runtime
pub val MSVC: Env = Env{system: ?WINDOWS, name: "msvc"};

# the loader honours an x86_64 image's fixed base, while ARM64 images always
# have a dynamic base
val WINDOWS_X86_64_PLACEMENT:  Placement = Placement.linked{"the loader maps an image without IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE at its ImageBase, link.exe /DYNAMICBASE:NO"};
val WINDOWS_AARCH64_PLACEMENT: Placement = Placement.relocated{"link.exe refuses /DYNAMICBASE:NO for ARM64, whose images the loader always relocates"};

# both write console images by default. the floor is windows 11's processor
# requirement (minimum hardware requirements for windows 11, 3.5): x64 with
# sse4.1, cmpxchg16b, lahf/sahf and prefetchw, which is short of x86-64-v2's
# popcnt and sse4.2, and arm64 with fp and neon (the arm64 abi conventions'
# base requirements) and the armv8.1 atomics
val WINDOWS_HOST_COUNT: usize                    = 2;
val WINDOWS_HOSTS:      [WINDOWS_HOST_COUNT]Host = [WINDOWS_HOST_COUNT]Host{
    Host{system: ?WINDOWS, env: opt[*Env].some{?MSVC}, arch: ?x86.X86_64, interpreter: nil, naming: opt[*Naming].some{?WINDOWS_NAMING}, image_base: 0x140000000, page: 0x1000, caps: os.PIE_DEFAULT, entries: ?WINDOWS_ENTRIES[0], entry_count: 1, libraries: ?WINDOWS_LIBRARIES[0], library_count: WINDOWS_LIBRARY_COUNT, subsystem: opt[*Subsystem].some{?subsystem.CONSOLE}, abi: Default.row{?x86.X86_64_WIN64}, placement: WINDOWS_X86_64_PLACEMENT, floor: opt[str].some{"cmov,cx8,x87,fxsr,osfxsr,mmx,sce,sse,sse2,cx16,lahf,prefetchw,sse41"}},
    Host{system: ?WINDOWS, env: opt[*Env].some{?MSVC}, arch: ?aarch64.AARCH64, interpreter: nil, naming: opt[*Naming].some{?WINDOWS_NAMING}, image_base: 0x140000000, page: 0x1000, caps: 0, entries: ?WINDOWS_ENTRIES[0], entry_count: 1, libraries: ?WINDOWS_LIBRARIES[0], library_count: WINDOWS_LIBRARY_COUNT, subsystem: opt[*Subsystem].some{?subsystem.CONSOLE}, abi: Default.row{?aarch64.AARCH64_AAPCS64WIN}, placement: WINDOWS_AARCH64_PLACEMENT, floor: opt[str].some{"armv8-a+fp+simd+lse"}},
};

pub val WINDOWS: System = System{
    name:         "windows",
    mapped:       true,
    formats:      ?WINDOWS_FORMATS[0],
    format_count: WINDOWS_FORMAT_COUNT,
    hosts:        ?WINDOWS_HOSTS[0],
    host_count:   WINDOWS_HOST_COUNT,
};
