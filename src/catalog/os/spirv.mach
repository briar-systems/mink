# vulkan and opencl, the systems of SPIR-V modules

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;

use mink.catalog.arch.spirv;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os.Env;
use mink.catalog.os.Host;
use mink.catalog.os.System;

# vulkan and opencl: spir-v modules only, whose entry points the module names
# itself, so no entry is fixed. no loader maps them
val SPIRV_FORMAT_COUNT: usize                       = 1;
val SPIRV_FORMATS:      [SPIRV_FORMAT_COUNT]*Format = [SPIRV_FORMAT_COUNT]*Format{?format.SPIRV};

val VULKAN_HOSTS: [1]Host = [1]Host{Host{system: ?VULKAN, env: opt[*Env].none{}, arch: ?spirv.SPIRV, interpreter: nil}};
val OPENCL_HOSTS: [1]Host = [1]Host{Host{system: ?OPENCL, env: opt[*Env].none{}, arch: ?spirv.SPIRV, interpreter: nil}};

pub val VULKAN: System = System{
    name:         "vulkan",
    mapped:       false,
    formats:      ?SPIRV_FORMATS[0],
    format_count: SPIRV_FORMAT_COUNT,
    hosts:        ?VULKAN_HOSTS[0],
    host_count:   1,
};

pub val OPENCL: System = System{
    name:         "opencl",
    mapped:       false,
    formats:      ?SPIRV_FORMATS[0],
    format_count: SPIRV_FORMAT_COUNT,
    hosts:        ?OPENCL_HOSTS[0],
    host_count:   1,
};
