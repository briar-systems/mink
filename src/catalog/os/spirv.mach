# vulkan and opencl, the systems of SPIR-V modules

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.spirv;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os.Ceiling;
use mink.catalog.os.Env;
use mink.catalog.os.Host;
use mink.catalog.os.Placement;
use mink.catalog.os.System;

# vulkan and opencl: spir-v modules only, whose entry points the module names
# itself, so no entry is fixed. no loader maps them
val SPIRV_FORMAT_COUNT: usize                       = 1;
val SPIRV_FORMATS:      [SPIRV_FORMAT_COUNT]*Format = [SPIRV_FORMAT_COUNT]*Format{?format.SPIRV};

val SPIRV_PLACEMENT: Placement = Placement.linked{"a SPIR-V module states no address for a runtime to move"};

# the vulkan versions, named as the compiler spells them. each takes the
# SPIR-V versions up to the one its "SPIR-V environment" appendix names
pub val VULKAN_1_0: Env = Env{system: ?VULKAN, name: "vulkan1.0"};
pub val VULKAN_1_1: Env = Env{system: ?VULKAN, name: "vulkan1.1"};
pub val VULKAN_1_2: Env = Env{system: ?VULKAN, name: "vulkan1.2"};
pub val VULKAN_1_3: Env = Env{system: ?VULKAN, name: "vulkan1.3"};

val VULKAN_1_0_CEILINGS: [1]Ceiling = [1]Ceiling{Ceiling{axis: ?spirv.SPIRV_VERSION, highest: ?spirv.SPIRV_1_0}};
val VULKAN_1_1_CEILINGS: [1]Ceiling = [1]Ceiling{Ceiling{axis: ?spirv.SPIRV_VERSION, highest: ?spirv.SPIRV_1_3}};
val VULKAN_1_2_CEILINGS: [1]Ceiling = [1]Ceiling{Ceiling{axis: ?spirv.SPIRV_VERSION, highest: ?spirv.SPIRV_1_5}};
val VULKAN_1_3_CEILINGS: [1]Ceiling = [1]Ceiling{Ceiling{axis: ?spirv.SPIRV_VERSION, highest: ?spirv.SPIRV_1_6}};

# the capabilities every vulkan implementation supports, which the vulkan
# specification's spir-v environment appendix lists with no feature or
# extension, as masc's spir-v selection spells them. the version is the
# ceiling's to bound
val VULKAN_FLOOR: str = "Matrix,Shader,InputAttachment,Sampled1D,Image1D,SampledBuffer,ImageBuffer,ImageQuery,DerivativeControl";
# the capabilities the opencl spir-v environment specification (3.1, spir-v
# 1.0) requires of every opencl environment that takes spir-v, Int64 left
# out as it binds full profile devices only
val OPENCL_FLOOR: str = "Addresses,Float16Buffer,Int16,Int8,Kernel,Linkage,Vector16";

# the host with no environment states no version, so it bounds none
val VULKAN_HOST_COUNT: usize                   = 5;
val VULKAN_HOSTS:      [VULKAN_HOST_COUNT]Host = [VULKAN_HOST_COUNT]Host{
    Host{system: ?VULKAN, env: opt[*Env].none{}, arch: ?spirv.SPIRV, interpreter: nil, placement: SPIRV_PLACEMENT, floor: opt[str].some{VULKAN_FLOOR}},
    Host{system: ?VULKAN, env: opt[*Env].some{?VULKAN_1_0}, arch: ?spirv.SPIRV, interpreter: nil, placement: SPIRV_PLACEMENT, ceilings: ?VULKAN_1_0_CEILINGS[0], ceiling_count: 1, floor: opt[str].some{VULKAN_FLOOR}},
    Host{system: ?VULKAN, env: opt[*Env].some{?VULKAN_1_1}, arch: ?spirv.SPIRV, interpreter: nil, placement: SPIRV_PLACEMENT, ceilings: ?VULKAN_1_1_CEILINGS[0], ceiling_count: 1, floor: opt[str].some{VULKAN_FLOOR}},
    Host{system: ?VULKAN, env: opt[*Env].some{?VULKAN_1_2}, arch: ?spirv.SPIRV, interpreter: nil, placement: SPIRV_PLACEMENT, ceilings: ?VULKAN_1_2_CEILINGS[0], ceiling_count: 1, floor: opt[str].some{VULKAN_FLOOR}},
    Host{system: ?VULKAN, env: opt[*Env].some{?VULKAN_1_3}, arch: ?spirv.SPIRV, interpreter: nil, placement: SPIRV_PLACEMENT, ceilings: ?VULKAN_1_3_CEILINGS[0], ceiling_count: 1, floor: opt[str].some{VULKAN_FLOOR}},
};
val OPENCL_HOSTS: [1]Host = [1]Host{Host{system: ?OPENCL, env: opt[*Env].none{}, arch: ?spirv.SPIRV, interpreter: nil, placement: SPIRV_PLACEMENT, floor: opt[str].some{OPENCL_FLOOR}}};

pub val VULKAN: System = System{
    name:         "vulkan",
    mapped:       false,
    formats:      ?SPIRV_FORMATS[0],
    format_count: SPIRV_FORMAT_COUNT,
    hosts:        ?VULKAN_HOSTS[0],
    host_count:   VULKAN_HOST_COUNT,
};

pub val OPENCL: System = System{
    name:         "opencl",
    mapped:       false,
    formats:      ?SPIRV_FORMATS[0],
    format_count: SPIRV_FORMAT_COUNT,
    hosts:        ?OPENCL_HOSTS[0],
    host_count:   1,
};
