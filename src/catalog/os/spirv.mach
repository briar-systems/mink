# vulkan and opencl, the systems of SPIR-V modules

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.spirv;
use mink.catalog.code;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os.Built;
use mink.catalog.os.Ceiling;
use mink.catalog.os.Default;
use mink.catalog.os.Env;
use mink.catalog.os.Environment;
use mink.catalog.os.Filename;
use mink.catalog.os.Host;
use mink.catalog.os.Linking;
use mink.catalog.os.Output;
use mink.catalog.os.Placement;
use mink.catalog.os.System;
use mink.catalog.output.Kind;

# vulkan and opencl: spir-v modules only, whose entry points the module names
# itself, so no entry is fixed. no loader maps them
val SPIRV_FORMAT_COUNT: usize                       = 1;
val SPIRV_FORMATS:      [SPIRV_FORMAT_COUNT]*Format = [SPIRV_FORMAT_COUNT]*Format{?format.SPIRV};

val SPIRV_LINKING: Linking = Linking{rows: nil, count: 0, default: opt[*Kind].none{}, source: "a SPIR-V module names its own entry points with OpEntryPoint and no executable starts at one, SPIR-V specification"};

val SPIRV_PLACEMENT: Placement = Placement.linked{"a SPIR-V module states no address for a runtime to move"};

# the vulkan versions, named as the compiler spells them. each takes the
# SPIR-V versions up to the one its "SPIR-V environment" appendix names
pub val VULKAN_1_0: Env = Env{sys: ?VULKAN, name: "vulkan1.0"};
pub val VULKAN_1_1: Env = Env{sys: ?VULKAN, name: "vulkan1.1"};
pub val VULKAN_1_2: Env = Env{sys: ?VULKAN, name: "vulkan1.2"};
pub val VULKAN_1_3: Env = Env{sys: ?VULKAN, name: "vulkan1.3"};

val VULKAN_1_0_CEILINGS: [1]Ceiling = [1]Ceiling{Ceiling{axis: ?spirv.SPIRV_VERSION, highest: ?spirv.SPIRV_1_0}};
val VULKAN_1_1_CEILINGS: [1]Ceiling = [1]Ceiling{Ceiling{axis: ?spirv.SPIRV_VERSION, highest: ?spirv.SPIRV_1_3}};
val VULKAN_1_2_CEILINGS: [1]Ceiling = [1]Ceiling{Ceiling{axis: ?spirv.SPIRV_VERSION, highest: ?spirv.SPIRV_1_5}};
val VULKAN_1_3_CEILINGS: [1]Ceiling = [1]Ceiling{Ceiling{axis: ?spirv.SPIRV_VERSION, highest: ?spirv.SPIRV_1_6}};

# each environment's floor is the spir-v version its implementations must
# accept, then the capabilities the vulkan specification's spir-v environment
# appendix enables by that core version alone, with no feature, as masc's
# spir-v selection spells them. a vulkan 1.0 implementation accepts spir-v
# 1.0, 1.1 takes 1.3 and adds DeviceGroup and GroupNonUniform, 1.2 takes 1.5
# and adds ShaderNonUniform, and 1.3 takes 1.6. the host with no environment
# holds what every vulkan implementation does
val VULKAN_1_0_FLOOR: str = "spv1.0,Matrix,Shader,InputAttachment,Sampled1D,Image1D,SampledBuffer,ImageBuffer,ImageQuery,DerivativeControl";
val VULKAN_1_1_FLOOR: str = "spv1.3,Matrix,Shader,InputAttachment,Sampled1D,Image1D,SampledBuffer,ImageBuffer,ImageQuery,DerivativeControl,DeviceGroup,GroupNonUniform";
val VULKAN_1_2_FLOOR: str = "spv1.5,Matrix,Shader,InputAttachment,Sampled1D,Image1D,SampledBuffer,ImageBuffer,ImageQuery,DerivativeControl,DeviceGroup,GroupNonUniform,ShaderNonUniform";
val VULKAN_1_3_FLOOR: str = "spv1.6,Matrix,Shader,InputAttachment,Sampled1D,Image1D,SampledBuffer,ImageBuffer,ImageQuery,DerivativeControl,DeviceGroup,GroupNonUniform,ShaderNonUniform";
# the capabilities the opencl spir-v environment specification (3.1, spir-v
# 1.0) requires of every opencl environment that takes spir-v, Int64 left
# out as it binds full profile devices only
val OPENCL_FLOOR: str = "Addresses,Float16Buffer,Int16,Int8,Kernel,Linkage,Vector16";

# the host with no environment states no version, so it bounds none. vulkan
# runs shader stages and opencl kernels
val VULKAN_HOST_COUNT: usize                   = 5;
val VULKAN_HOSTS:      [VULKAN_HOST_COUNT]Host = [VULKAN_HOST_COUNT]Host{
    Host{sys: ?VULKAN, env: opt[*Env].none{}, arch: ?spirv.SPIRV, interpreter: nil, abi: Default.row{?spirv.SPIRV_SHADER}, linking: ?SPIRV_LINKING, placement: SPIRV_PLACEMENT, floor: opt[str].some{VULKAN_1_0_FLOOR}, code_models: code.NONE},
    Host{sys: ?VULKAN, env: opt[*Env].some{?VULKAN_1_0}, arch: ?spirv.SPIRV, interpreter: nil, abi: Default.row{?spirv.SPIRV_SHADER}, linking: ?SPIRV_LINKING, placement: SPIRV_PLACEMENT, ceilings: ?VULKAN_1_0_CEILINGS[0], ceiling_count: 1, floor: opt[str].some{VULKAN_1_0_FLOOR}, code_models: code.NONE},
    Host{sys: ?VULKAN, env: opt[*Env].some{?VULKAN_1_1}, arch: ?spirv.SPIRV, interpreter: nil, abi: Default.row{?spirv.SPIRV_SHADER}, linking: ?SPIRV_LINKING, placement: SPIRV_PLACEMENT, ceilings: ?VULKAN_1_1_CEILINGS[0], ceiling_count: 1, floor: opt[str].some{VULKAN_1_1_FLOOR}, code_models: code.NONE},
    Host{sys: ?VULKAN, env: opt[*Env].some{?VULKAN_1_2}, arch: ?spirv.SPIRV, interpreter: nil, abi: Default.row{?spirv.SPIRV_SHADER}, linking: ?SPIRV_LINKING, placement: SPIRV_PLACEMENT, ceilings: ?VULKAN_1_2_CEILINGS[0], ceiling_count: 1, floor: opt[str].some{VULKAN_1_2_FLOOR}, code_models: code.NONE},
    Host{sys: ?VULKAN, env: opt[*Env].some{?VULKAN_1_3}, arch: ?spirv.SPIRV, interpreter: nil, abi: Default.row{?spirv.SPIRV_SHADER}, linking: ?SPIRV_LINKING, placement: SPIRV_PLACEMENT, ceilings: ?VULKAN_1_3_CEILINGS[0], ceiling_count: 1, floor: opt[str].some{VULKAN_1_3_FLOOR}, code_models: code.NONE},
};
val OPENCL_HOSTS: [1]Host = [1]Host{Host{sys: ?OPENCL, env: opt[*Env].none{}, arch: ?spirv.SPIRV, interpreter: nil, abi: Default.row{?spirv.SPIRV_KERNEL}, linking: ?SPIRV_LINKING, placement: SPIRV_PLACEMENT, floor: opt[str].some{OPENCL_FLOOR}, code_models: code.NONE}};

# a link names a module `<stem>.spv`, the file a SPIR-V consumer takes,
# whether it declares the Linkage capability for a later link or not. a
# runtime instantiates a module, so none is an executable or a shared
# library, and a SPIR-V link takes modules, none of them in an archive
val SPIRV_UNRUN:        str                        = "a runtime instantiates a SPIR-V module at its entry points, and no loader runs one";
val SPIRV_MODULE_FILE:  Filename                   = Filename{prefix: "", extension: ".spv"};
val SPIRV_OUTPUT_COUNT: usize                      = 5;
val SPIRV_OUTPUTS:      [SPIRV_OUTPUT_COUNT]Output = [SPIRV_OUTPUT_COUNT]Output{
    Output{spelled: "object", built: Built.named{?SPIRV_MODULE_FILE}},
    Output{spelled: "bin", built: Built.unbuilt{SPIRV_UNRUN}},
    Output{spelled: "shared", built: Built.unbuilt{"no loader maps a SPIR-V module into another"}},
    Output{spelled: "static", built: Built.unbuilt{"a SPIR-V link takes modules, and the system states no archive of them"}},
    Output{spelled: "module", built: Built.named{?SPIRV_MODULE_FILE}},
};

pub val VULKAN: System = System{
    name:         "vulkan",
    environment:  Environment.bare{},
    mapped:       false,
    formats:      ?SPIRV_FORMATS[0],
    format_count: SPIRV_FORMAT_COUNT,
    hosts:        ?VULKAN_HOSTS[0],
    host_count:   VULKAN_HOST_COUNT,
    outputs:      ?SPIRV_OUTPUTS[0],
    output_count: SPIRV_OUTPUT_COUNT,
};

pub val OPENCL: System = System{
    name:         "opencl",
    environment:  Environment.bare{},
    mapped:       false,
    formats:      ?SPIRV_FORMATS[0],
    format_count: SPIRV_FORMAT_COUNT,
    hosts:        ?OPENCL_HOSTS[0],
    host_count:   1,
    outputs:      ?SPIRV_OUTPUTS[0],
    output_count: SPIRV_OUTPUT_COUNT,
};
