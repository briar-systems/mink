# vulkan and opencl, the systems of SPIR-V modules

use std.types.bool.false;
use std.types.size.usize;

use mink.catalog.arch.spirv;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os.Host;
use mink.catalog.os.Os;
use mink.catalog.os.Version;

# vulkan and opencl: spir-v modules only, whose entry points the module names
# itself, so no entry is fixed. no loader maps them
val SPIRV_FORMAT_COUNT: usize                       = 1;
val SPIRV_FORMATS:      [SPIRV_FORMAT_COUNT]*Format = [SPIRV_FORMAT_COUNT]*Format{?format.SPIRV};

val SPIRV_HOST_COUNT: usize                  = 1;
val SPIRV_HOSTS:      [SPIRV_HOST_COUNT]Host = [SPIRV_HOST_COUNT]Host{
    Host{arch: ?spirv.SPIRV, interpreter: nil, libdirs: nil, libdir_count: 0, image_base: 0, page_size: 0, caps: 0},
};

pub val VULKAN: Os = Os{
    name:                "vulkan",
    codes:               nil,
    code_count:          0,
    hosts:               ?SPIRV_HOSTS[0],
    host_count:          SPIRV_HOST_COUNT,
    entry:               nil,
    mapped:              false,
    formats:             ?SPIRV_FORMATS[0],
    format_count:        SPIRV_FORMAT_COUNT,
    libraries:           nil,
    library_count:       0,
    framework_dirs:      nil,
    framework_dir_count: 0,
    min_version:         Version{major: 0, minor: 0, patch: 0},
};

pub val OPENCL: Os = Os{
    name:                "opencl",
    codes:               nil,
    code_count:          0,
    hosts:               ?SPIRV_HOSTS[0],
    host_count:          SPIRV_HOST_COUNT,
    entry:               nil,
    mapped:              false,
    formats:             ?SPIRV_FORMATS[0],
    format_count:        SPIRV_FORMAT_COUNT,
    libraries:           nil,
    library_count:       0,
    framework_dirs:      nil,
    framework_dir_count: 0,
    min_version:         Version{major: 0, minor: 0, patch: 0},
};
