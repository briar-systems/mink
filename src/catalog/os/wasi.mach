# wasi, the WebAssembly system interface

use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.wasm;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os.Host;
use mink.catalog.os.Os;
use mink.catalog.os.Version;

# wasi preview1: a wasm32 module importing from wasi_snapshot_preview1, the
# import module its runtime resolves, entry _start. no loader maps the module
val WASI_FORMAT_COUNT:  usize                      = 1;
val WASI_FORMATS:       [WASI_FORMAT_COUNT]*Format = [WASI_FORMAT_COUNT]*Format{?format.WASM};
val WASI_LIBRARY_COUNT: usize                      = 1;
val WASI_LIBRARIES:     [WASI_LIBRARY_COUNT]str    = [WASI_LIBRARY_COUNT]str{"wasi_snapshot_preview1"};

val WASI_HOST_COUNT: usize                 = 1;
val WASI_HOSTS:      [WASI_HOST_COUNT]Host = [WASI_HOST_COUNT]Host{
    Host{arch: ?wasm.WASM32, interpreter: nil, libdirs: nil, libdir_count: 0, image_base: 0, page_size: 0x1_0000, caps: 0},
};

pub val WASI: Os = Os{
    name:                "wasi",
    codes:               nil,
    code_count:          0,
    hosts:               ?WASI_HOSTS[0],
    host_count:          WASI_HOST_COUNT,
    entry:               "_start",
    mapped:              false,
    formats:             ?WASI_FORMATS[0],
    format_count:        WASI_FORMAT_COUNT,
    libraries:           ?WASI_LIBRARIES[0],
    library_count:       WASI_LIBRARY_COUNT,
    framework_dirs:      nil,
    framework_dir_count: 0,
    min_version:         Version{major: 0, minor: 0, patch: 0},
};
