# wasi, the WebAssembly system interface

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;

use mink.catalog.arch.wasm;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Host;
use mink.catalog.os.Named;
use mink.catalog.os.System;
use mink.catalog.output;

# wasi preview1: a wasm32 module whose runtime resolves its interface from the
# import module wasi_snapshot_preview1, entry _start. no loader maps the module
val WASI_FORMAT_COUNT: usize                      = 1;
val WASI_FORMATS:      [WASI_FORMAT_COUNT]*Format = [WASI_FORMAT_COUNT]*Format{?format.WASM};
val WASI_ENTRIES:      [1]Entry                   = [1]Entry{Entry{caps: output.ENTERED, symbol: "_start"}};
val PREVIEW1_FACTS:    [1]Named                   = [1]Named{Named{role: ?os.IMPORT_MODULE, name: "wasi_snapshot_preview1"}};

pub val PREVIEW1: Env = Env{system: ?WASI, name: "preview1", facts: ?PREVIEW1_FACTS[0], fact_count: 1};

val WASI_HOST_COUNT: usize                 = 1;
val WASI_HOSTS:      [WASI_HOST_COUNT]Host = [WASI_HOST_COUNT]Host{
    Host{system: ?WASI, env: opt[*Env].some{?PREVIEW1}, arch: ?wasm.WASM32, interpreter: nil, page: 0x1_0000, entries: ?WASI_ENTRIES[0], entry_count: 1},
};

pub val WASI: System = System{
    name:         "wasi",
    mapped:       false,
    formats:      ?WASI_FORMATS[0],
    format_count: WASI_FORMAT_COUNT,
    hosts:        ?WASI_HOSTS[0],
    host_count:   WASI_HOST_COUNT,
};
