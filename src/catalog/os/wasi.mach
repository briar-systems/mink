# wasi, the WebAssembly system interface

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.wasm;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.kind;
use mink.catalog.os;
use mink.catalog.os.Built;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Filename;
use mink.catalog.os.Host;
use mink.catalog.os.Named;
use mink.catalog.os.Placement;
use mink.catalog.os.Product;
use mink.catalog.os.System;
use mink.catalog.output;

# wasi preview1: a wasm32 module whose runtime resolves its interface from the
# import module wasi_snapshot_preview1, entry _start. no loader maps the
# module. its data starts at the first page of linear memory past the stack,
# which grows down from there, so a stack overflow traps below the data rather
# than corrupting it. wasi states no wasm feature its runtimes must take past
# the core 1.0 specification, masc's wasm1
val WASI_FORMAT_COUNT: usize                      = 1;
val WASI_FORMATS:      [WASI_FORMAT_COUNT]*Format = [WASI_FORMAT_COUNT]*Format{?format.WASM};
val WASI_ENTRIES:      [1]Entry                   = [1]Entry{Entry{caps: output.ENTERED, symbol: "_start"}};
val PREVIEW1_FACTS:    [1]Named                   = [1]Named{Named{role: ?os.IMPORT_MODULE, name: "wasi_snapshot_preview1"}};

pub val PREVIEW1: Env = Env{sys: ?WASI, name: "preview1", facts: ?PREVIEW1_FACTS[0], fact_count: 1};

# instantiation writes data where the module states, never elsewhere
val WASI_PLACEMENT: Placement = Placement.linked{"instantiation writes each active data segment at the offset the module states, WebAssembly core specification"};

val WASI_HOST_COUNT: usize                 = 1;
val WASI_HOSTS:      [WASI_HOST_COUNT]Host = [WASI_HOST_COUNT]Host{
    Host{sys: ?WASI, env: opt[*Env].some{?PREVIEW1}, arch: ?wasm.WASM32, interpreter: nil, image_base: 0x1_0000, page: 0x1_0000, entries: ?WASI_ENTRIES[0], entry_count: 1, placement: WASI_PLACEMENT, floor: opt[str].some{"wasm1"}},
};

# a link names an object `<stem>.o`, as the WebAssembly tool conventions'
# linking document names one, a module `<stem>.wasm`, whether it starts at
# _start or names its own entry points, and an archive `lib<stem>.a`.
# preview1 runtimes instantiate one module and link no other into it, so no
# module is position independent or shared
val WASI_OBJECT_FILE:   Filename                    = Filename{prefix: "", extension: ".o"};
val WASI_MODULE_FILE:   Filename                    = Filename{prefix: "", extension: ".wasm"};
val WASI_ARCHIVE_FILE:  Filename                    = Filename{prefix: "lib", extension: ".a"};
val WASI_PRODUCT_COUNT: usize                       = 6;
val WASI_PRODUCTS:      [WASI_PRODUCT_COUNT]Product = [WASI_PRODUCT_COUNT]Product{
    Product{kind: ?kind.RELOCATABLE, built: Built.named{?WASI_OBJECT_FILE}},
    Product{kind: ?kind.EXECUTABLE, built: Built.named{?WASI_MODULE_FILE}},
    Product{kind: ?kind.PIE, built: Built.unbuilt{"a wasi preview1 runtime instantiates a module at the addresses it states and moves none"}},
    Product{kind: ?kind.SHARED, built: Built.unbuilt{"a wasi preview1 runtime links no module into another at run time"}},
    Product{kind: ?kind.ARCHIVE, built: Built.named{?WASI_ARCHIVE_FILE}},
    Product{kind: ?kind.MODULE, built: Built.named{?WASI_MODULE_FILE}},
};

pub val WASI: System = System{
    name:          "wasi",
    mapped:        false,
    formats:       ?WASI_FORMATS[0],
    format_count:  WASI_FORMAT_COUNT,
    hosts:         ?WASI_HOSTS[0],
    host_count:    WASI_HOST_COUNT,
    products:      ?WASI_PRODUCTS[0],
    product_count: WASI_PRODUCT_COUNT,
};
