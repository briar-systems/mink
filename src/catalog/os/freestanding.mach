# freestanding, an image no loader maps

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.riscv;
use mink.catalog.arch.x86;
use mink.catalog.code;
use mink.catalog.code.CodeModel;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os.Built;
use mink.catalog.os.Code;
use mink.catalog.os.Default;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Environment;
use mink.catalog.os.Filename;
use mink.catalog.os.Host;
use mink.catalog.os.Linking;
use mink.catalog.os.Output;
use mink.catalog.os.Placement;
use mink.catalog.os.System;
use mink.catalog.output;
use mink.catalog.output.Kind;

# freestanding: no loader maps the image, so the format and the isa pick the page.
# a risc-v host derives its default calling convention from the isa string the
# link states, since a bare-metal float abi follows it. no host states an
# instruction set floor, as no system bounds the machine. elf osabi is
# ELFOSABI_NONE, the System V value bare-metal toolchains write
val FREESTANDING_CODE_COUNT:   usize                              = 1;
val FREESTANDING_CODES:        [FREESTANDING_CODE_COUNT]Code      = [FREESTANDING_CODE_COUNT]Code{Code{format: ?format.ELF, value: 0}};
val FREESTANDING_FORMAT_COUNT: usize                              = 2;
val FREESTANDING_FORMATS:      [FREESTANDING_FORMAT_COUNT]*Format = [FREESTANDING_FORMAT_COUNT]*Format{?format.ELF, ?format.FLAT};
val FREESTANDING_ENTRIES:      [1]Entry                           = [1]Entry{Entry{caps: output.ENTERED, symbol: "_start"}};

val FREESTANDING_LINKING_ROWS: [1]*Kind = [1]*Kind{?output.STATIC};
val FREESTANDING_LINKING:      Linking  = Linking{rows: ?FREESTANDING_LINKING_ROWS[0], count: 1, default: opt[*Kind].some{?output.STATIC}, source: "no loader maps a freestanding image, so it is fixed at its linked address"};

val FREESTANDING_PLACEMENT: Placement = Placement.linked{"no loader moves the image, so it runs where the link placed it"};

# a freestanding image is linked at its address, and each host offers
# exactly the code models mirl carries. x86-64 and aarch64 take small alone.
# riscv64 and riscv64e take medlow by default and medany, and riscv32 and
# riscv32e medlow alone. i386 has no code models
val FREESTANDING_RV64_MODEL_ROWS: [2]*CodeModel = [2]*CodeModel{?riscv.RISCV_MEDLOW, ?riscv.RISCV_MEDANY};
val FREESTANDING_RV64_MODELS:     code.Offered  = code.Offered{rows: ?FREESTANDING_RV64_MODEL_ROWS[0], count: 2, default: code.Taken.row{?riscv.RISCV_MEDLOW}};
val FREESTANDING_RV32_MODEL_ROWS: [1]*CodeModel = [1]*CodeModel{?riscv.RISCV_MEDLOW};
val FREESTANDING_RV32_MODELS:     code.Offered  = code.Offered{rows: ?FREESTANDING_RV32_MODEL_ROWS[0], count: 1, default: code.Taken.row{?riscv.RISCV_MEDLOW}};

val FREESTANDING_HOST_COUNT: usize                         = 7;
val FREESTANDING_HOSTS:      [FREESTANDING_HOST_COUNT]Host = [FREESTANDING_HOST_COUNT]Host{
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?x86.X86_64, interpreter: nil, image_base: 0x10_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.row{?x86.X86_64_SYSV64}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: x86.X86_64_SMALL_MODELS},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?x86.X86, interpreter: nil, image_base: 0x10_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.row{?x86.X86_SYSV32}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: code.NONE},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?aarch64.AARCH64, interpreter: nil, image_base: 0x4000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.row{?aarch64.AARCH64_AAPCS64}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: aarch64.AARCH64_SMALL_MODELS},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV64, interpreter: nil, image_base: 0x8000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.derived{?riscv.RISCV_DEFAULT_ABI}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: FREESTANDING_RV64_MODELS},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV32, interpreter: nil, image_base: 0x8000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.derived{?riscv.RISCV_DEFAULT_ABI}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: FREESTANDING_RV32_MODELS},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV64E, interpreter: nil, image_base: 0x8000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.derived{?riscv.RISCV_DEFAULT_ABI}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: FREESTANDING_RV64_MODELS},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV32E, interpreter: nil, image_base: 0x8000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.derived{?riscv.RISCV_DEFAULT_ABI}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: FREESTANDING_RV32_MODELS},
};

# a link names an object `<stem>.o`, an image `<stem>` with no extension and
# an archive `lib<stem>.a`. no loader maps a freestanding image, so none
# binds a shared library, and neither ELF nor a flat image has a module a
# runtime instantiates
val FREESTANDING_OBJECT_FILE:  Filename                          = Filename{prefix: "", extension: ".o"};
val FREESTANDING_IMAGE_FILE:   Filename                          = Filename{prefix: "", extension: ""};
val FREESTANDING_ARCHIVE_FILE: Filename                          = Filename{prefix: "lib", extension: ".a"};
val FREESTANDING_OUTPUT_COUNT: usize                             = 5;
val FREESTANDING_OUTPUTS:      [FREESTANDING_OUTPUT_COUNT]Output = [FREESTANDING_OUTPUT_COUNT]Output{
    Output{spelled: "object", built: Built.named{?FREESTANDING_OBJECT_FILE}},
    Output{spelled: "bin", built: Built.named{?FREESTANDING_IMAGE_FILE}},
    Output{spelled: "shared", built: Built.unbuilt{"no loader maps a freestanding image, so none binds a shared library at run time"}},
    Output{spelled: "static", built: Built.named{?FREESTANDING_ARCHIVE_FILE}},
    Output{spelled: "module", built: Built.unbuilt{"neither ELF nor a flat image has a module a runtime instantiates"}},
};

pub val FREESTANDING: System = System{
    name:         "freestanding",
    environment:  Environment.bare{},
    mapped:       false,
    formats:      ?FREESTANDING_FORMATS[0],
    format_count: FREESTANDING_FORMAT_COUNT,
    codes:        ?FREESTANDING_CODES[0],
    code_count:   FREESTANDING_CODE_COUNT,
    hosts:        ?FREESTANDING_HOSTS[0],
    host_count:   FREESTANDING_HOST_COUNT,
    outputs:      ?FREESTANDING_OUTPUTS[0],
    output_count: FREESTANDING_OUTPUT_COUNT,
};
