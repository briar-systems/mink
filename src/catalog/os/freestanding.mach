# freestanding, an image no loader maps

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.riscv;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Host;
use mink.catalog.os.System;
use mink.catalog.output;

# freestanding: no loader maps the image, so the format and the isa pick the page
val FREESTANDING_FORMAT_COUNT: usize                              = 2;
val FREESTANDING_FORMATS:      [FREESTANDING_FORMAT_COUNT]*Format = [FREESTANDING_FORMAT_COUNT]*Format{?format.ELF, ?format.FLAT};
val FREESTANDING_ENTRIES:      [1]Entry                           = [1]Entry{Entry{caps: output.ENTERED, symbol: "_start"}};

val FREESTANDING_HOST_COUNT: usize                         = 6;
val FREESTANDING_HOSTS:      [FREESTANDING_HOST_COUNT]Host = [FREESTANDING_HOST_COUNT]Host{
    Host{system: ?FREESTANDING, env: opt[*Env].none{}, arch: ?x86.X86_64, interpreter: nil, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1},
    Host{system: ?FREESTANDING, env: opt[*Env].none{}, arch: ?aarch64.AARCH64, interpreter: nil, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1},
    Host{system: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV64, interpreter: nil, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1},
    Host{system: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV32, interpreter: nil, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1},
    Host{system: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV64E, interpreter: nil, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1},
    Host{system: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV32E, interpreter: nil, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1},
};

pub val FREESTANDING: System = System{
    name:         "freestanding",
    mapped:       false,
    formats:      ?FREESTANDING_FORMATS[0],
    format_count: FREESTANDING_FORMAT_COUNT,
    hosts:        ?FREESTANDING_HOSTS[0],
    host_count:   FREESTANDING_HOST_COUNT,
};
