# freestanding, an image no loader maps

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.riscv;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.kind;
use mink.catalog.os.Built;
use mink.catalog.os.Code;
use mink.catalog.os.Default;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Filename;
use mink.catalog.os.Host;
use mink.catalog.os.Placement;
use mink.catalog.os.Product;
use mink.catalog.os.System;
use mink.catalog.output;

# freestanding: no loader maps the image, so the format and the isa pick the page.
# a risc-v host derives its default calling convention from the isa string the
# link states, since a bare-metal float abi follows it. no host states an
# instruction set floor, as no system bounds the machine. elf osabi is
# ELFOSABI_NONE, the System V value bare-metal toolchains write
val FREESTANDING_CODE_COUNT:   usize                              = 1;
val FREESTANDING_CODES:        [FREESTANDING_CODE_COUNT]Code      = [FREESTANDING_CODE_COUNT]Code{Code{format: ?format.ELF, value: 0}};
val FREESTANDING_FORMAT_COUNT: usize                              = 2;
val FREESTANDING_FORMATS:      [FREESTANDING_FORMAT_COUNT]*Format = [FREESTANDING_FORMAT_COUNT]*Format{?format.ELF, ?format.FLAT};
val FREESTANDING_ENTRIES:      [1]Entry                           = [1]Entry{Entry{caps: output.ENTERED, symbol: "_start"}};

val FREESTANDING_PLACEMENT: Placement = Placement.linked{"no loader moves the image, so it runs where the link placed it"};

# an image is linked at the start of the machine's RAM: 0x8000_0000 on the
# risc-v qemu virt machine (hw/riscv/virt.c, VIRT_DRAM), 0x4000_0000 on the
# arm qemu virt machine (hw/arm/virt.c, VIRT_MEM), and on x86 0x10_0000, the
# first megabyte above the legacy BIOS area, where a multiboot loader places
# a kernel
val FREESTANDING_HOST_COUNT: usize                         = 7;
val FREESTANDING_HOSTS:      [FREESTANDING_HOST_COUNT]Host = [FREESTANDING_HOST_COUNT]Host{
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?x86.X86_64, interpreter: nil, image_base: 0x10_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.row{?x86.X86_64_SYSV64}, placement: FREESTANDING_PLACEMENT},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?x86.X86, interpreter: nil, image_base: 0x10_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.row{?x86.X86_SYSV32}, placement: FREESTANDING_PLACEMENT},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?aarch64.AARCH64, interpreter: nil, image_base: 0x4000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.row{?aarch64.AARCH64_AAPCS64}, placement: FREESTANDING_PLACEMENT},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV64, interpreter: nil, image_base: 0x8000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.derived{?riscv.RISCV_DEFAULT_ABI}, placement: FREESTANDING_PLACEMENT},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV32, interpreter: nil, image_base: 0x8000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.derived{?riscv.RISCV_DEFAULT_ABI}, placement: FREESTANDING_PLACEMENT},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV64E, interpreter: nil, image_base: 0x8000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.derived{?riscv.RISCV_DEFAULT_ABI}, placement: FREESTANDING_PLACEMENT},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV32E, interpreter: nil, image_base: 0x8000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.derived{?riscv.RISCV_DEFAULT_ABI}, placement: FREESTANDING_PLACEMENT},
};

# a link names an object `<stem>.o`, an image `<stem>` with no extension and
# an archive `lib<stem>.a`. no loader maps a freestanding image, so none
# binds a shared library, and neither ELF nor a flat image has a module a
# runtime instantiates
val FREESTANDING_OBJECT_FILE:   Filename                            = Filename{prefix: "", extension: ".o"};
val FREESTANDING_IMAGE_FILE:    Filename                            = Filename{prefix: "", extension: ""};
val FREESTANDING_ARCHIVE_FILE:  Filename                            = Filename{prefix: "lib", extension: ".a"};
val FREESTANDING_PRODUCT_COUNT: usize                               = 6;
val FREESTANDING_PRODUCTS:      [FREESTANDING_PRODUCT_COUNT]Product = [FREESTANDING_PRODUCT_COUNT]Product{
    Product{kind: ?kind.RELOCATABLE, built: Built.named{?FREESTANDING_OBJECT_FILE}},
    Product{kind: ?kind.EXECUTABLE, built: Built.named{?FREESTANDING_IMAGE_FILE}},
    Product{kind: ?kind.PIE, built: Built.named{?FREESTANDING_IMAGE_FILE}},
    Product{kind: ?kind.SHARED, built: Built.unbuilt{"no loader maps a freestanding image, so none binds a shared library at run time"}},
    Product{kind: ?kind.ARCHIVE, built: Built.named{?FREESTANDING_ARCHIVE_FILE}},
    Product{kind: ?kind.MODULE, built: Built.unbuilt{"neither ELF nor a flat image has a module a runtime instantiates"}},
};

pub val FREESTANDING: System = System{
    name:          "freestanding",
    mapped:        false,
    formats:       ?FREESTANDING_FORMATS[0],
    format_count:  FREESTANDING_FORMAT_COUNT,
    codes:         ?FREESTANDING_CODES[0],
    code_count:    FREESTANDING_CODE_COUNT,
    hosts:         ?FREESTANDING_HOSTS[0],
    host_count:    FREESTANDING_HOST_COUNT,
    products:      ?FREESTANDING_PRODUCTS[0],
    product_count: FREESTANDING_PRODUCT_COUNT,
};
