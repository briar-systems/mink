# freestanding, an image no loader maps

use std.types.bool.false;
use std.types.size.usize;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.riscv;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os.Host;
use mink.catalog.os.Os;
use mink.catalog.os.Version;

# freestanding: no loader maps the image, so the format and the isa pick the page
val FREESTANDING_FORMAT_COUNT: usize                              = 2;
val FREESTANDING_FORMATS:      [FREESTANDING_FORMAT_COUNT]*Format = [FREESTANDING_FORMAT_COUNT]*Format{?format.ELF, ?format.FLAT};

val FREESTANDING_HOST_COUNT: usize                         = 4;
val FREESTANDING_HOSTS:      [FREESTANDING_HOST_COUNT]Host = [FREESTANDING_HOST_COUNT]Host{
    Host{arch: ?x86.X86_64, interpreter: nil, libdirs: nil, libdir_count: 0, image_base: 0, page_size: 0, caps: 0},
    Host{arch: ?aarch64.AARCH64, interpreter: nil, libdirs: nil, libdir_count: 0, image_base: 0, page_size: 0, caps: 0},
    Host{arch: ?riscv.RISCV64, interpreter: nil, libdirs: nil, libdir_count: 0, image_base: 0, page_size: 0, caps: 0},
    Host{arch: ?riscv.RISCV32, interpreter: nil, libdirs: nil, libdir_count: 0, image_base: 0, page_size: 0, caps: 0},
};

pub val FREESTANDING: Os = Os{
    name:                "freestanding",
    codes:               nil,
    code_count:          0,
    hosts:               ?FREESTANDING_HOSTS[0],
    host_count:          FREESTANDING_HOST_COUNT,
    entry:               "_start",
    mapped:              false,
    formats:             ?FREESTANDING_FORMATS[0],
    format_count:        FREESTANDING_FORMAT_COUNT,
    libraries:           nil,
    library_count:       0,
    framework_dirs:      nil,
    framework_dir_count: 0,
    min_version:         Version{major: 0, minor: 0, patch: 0},
};
