# freestanding, an image no loader maps

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.riscv;
use mink.catalog.arch.wasm;
use mink.catalog.arch.x86;
use mink.catalog.code;
use mink.catalog.code.CodeModel;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os.Built;
use mink.catalog.os.Code;
use mink.catalog.os.Conventions;
use mink.catalog.os.Default;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Environment;
use mink.catalog.os.Filename;
use mink.catalog.os.Host;
use mink.catalog.os.Linking;
use mink.catalog.os.Output;
use mink.catalog.os.Placement;
use mink.catalog.os.System;
use mink.catalog.output;
use mink.catalog.output.Kind;

# freestanding: no loader maps the image, so the format and the isa pick the page.
# a risc-v host derives its default calling convention from the isa string the
# link states, since a bare-metal float abi follows it. riscv64e has no host,
# as the psabi names no convention for it. no host of an ELF or flat image
# states an instruction set floor, as no system bounds the machine. elf osabi is
# ELFOSABI_NONE, the System V value bare-metal toolchains write
val FREESTANDING_CODE_COUNT:   usize                              = 1;
val FREESTANDING_CODES:        [FREESTANDING_CODE_COUNT]Code      = [FREESTANDING_CODE_COUNT]Code{Code{format: ?format.ELF, value: 0}};
val FREESTANDING_FORMAT_COUNT: usize                              = 2;
val FREESTANDING_FORMATS:      [FREESTANDING_FORMAT_COUNT]*Format = [FREESTANDING_FORMAT_COUNT]*Format{?format.ELF, ?format.FLAT};
val FREESTANDING_ENTRIES:      [1]Entry                           = [1]Entry{Entry{caps: output.ENTERED, symbol: "_start"}};

# a wasm module nothing but its host runs: the host instantiates it and calls
# what it exports, so a module that defines no `_start` is a module of its
# exports, and one that does exports it. its imports are the program's own,
# each from the module a claim names, as no system names one. its stack and
# data lie in linear memory as on wasi: the data from the first page past the
# 64 KiB stack, which grows down from there, so an overflow traps below the
# data. a module is valid where the core 1.0 specification is, masc's wasm1,
# which every host takes
val FREESTANDING_WASM_FORMATS: [1]*Format = [1]*Format{?format.WASM};
val FREESTANDING_WASM_ENTRIES: [1]Entry   = [1]Entry{Entry{caps: output.ENTERED, symbol: "_start", optional: true}};

val FREESTANDING_LINKING_ROWS: [1]*Kind = [1]*Kind{?output.STATIC};
val FREESTANDING_LINKING:      Linking  = Linking{rows: ?FREESTANDING_LINKING_ROWS[0], count: 1, default: opt[*Kind].some{?output.STATIC}, source: "no loader maps a freestanding image, so it is fixed at its linked address"};

val FREESTANDING_PLACEMENT: Placement = Placement.linked{"no loader moves the image, so it runs where the link placed it"};

# a freestanding image is linked at its address, runs under any calling
# convention of its architecture, and each host offers exactly the code
# models mirl carries. x86-64 and aarch64 take small alone.
# riscv64 takes medany by default and medlow, since medlow
# reaches only the 2 GiB about address zero and the image base, where the
# common boards put ram, lies above it. riscv32 and riscv32e take medlow
# alone, which reaches every address at xlen 32. i386 has no code models
val FREESTANDING_RV64_MODEL_ROWS: [2]*CodeModel = [2]*CodeModel{?riscv.RISCV_MEDANY, ?riscv.RISCV_MEDLOW};
val FREESTANDING_RV64_MODELS:     code.Offered  = code.Offered{rows: ?FREESTANDING_RV64_MODEL_ROWS[0], count: 2, default: code.Taken.row{?riscv.RISCV_MEDANY}};
val FREESTANDING_RV32_MODEL_ROWS: [1]*CodeModel = [1]*CodeModel{?riscv.RISCV_MEDLOW};
val FREESTANDING_RV32_MODELS:     code.Offered  = code.Offered{rows: ?FREESTANDING_RV32_MODEL_ROWS[0], count: 1, default: code.Taken.row{?riscv.RISCV_MEDLOW}};

val FREESTANDING_HOST_COUNT: usize                         = 7;
val FREESTANDING_HOSTS:      [FREESTANDING_HOST_COUNT]Host = [FREESTANDING_HOST_COUNT]Host{
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?x86.X86_64, formats: ?FREESTANDING_FORMATS[0], format_count: FREESTANDING_FORMAT_COUNT, outputs: ?FREESTANDING_OUTPUTS[0], output_count: FREESTANDING_OUTPUT_COUNT, interpreter: nil, image_base: 0x10_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.row{?x86.X86_64_SYSV64}, conventions: Conventions.every{}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: x86.X86_64_SMALL_MODELS},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?x86.X86, formats: ?FREESTANDING_FORMATS[0], format_count: FREESTANDING_FORMAT_COUNT, outputs: ?FREESTANDING_OUTPUTS[0], output_count: FREESTANDING_OUTPUT_COUNT, interpreter: nil, image_base: 0x10_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.row{?x86.X86_SYSV32}, conventions: Conventions.every{}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: code.NONE},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?aarch64.AARCH64, formats: ?FREESTANDING_FORMATS[0], format_count: FREESTANDING_FORMAT_COUNT, outputs: ?FREESTANDING_OUTPUTS[0], output_count: FREESTANDING_OUTPUT_COUNT, interpreter: nil, image_base: 0x4000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.row{?aarch64.AARCH64_AAPCS64}, conventions: Conventions.every{}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: aarch64.AARCH64_SMALL_MODELS},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV64, formats: ?FREESTANDING_FORMATS[0], format_count: FREESTANDING_FORMAT_COUNT, outputs: ?FREESTANDING_OUTPUTS[0], output_count: FREESTANDING_OUTPUT_COUNT, interpreter: nil, image_base: 0x8000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.derived{?riscv.RISCV_DEFAULT_ABI}, conventions: Conventions.every{}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: FREESTANDING_RV64_MODELS},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV32, formats: ?FREESTANDING_FORMATS[0], format_count: FREESTANDING_FORMAT_COUNT, outputs: ?FREESTANDING_OUTPUTS[0], output_count: FREESTANDING_OUTPUT_COUNT, interpreter: nil, image_base: 0x8000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.derived{?riscv.RISCV_DEFAULT_ABI}, conventions: Conventions.every{}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: FREESTANDING_RV32_MODELS},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?riscv.RISCV32E, formats: ?FREESTANDING_FORMATS[0], format_count: FREESTANDING_FORMAT_COUNT, outputs: ?FREESTANDING_OUTPUTS[0], output_count: FREESTANDING_OUTPUT_COUNT, interpreter: nil, image_base: 0x8000_0000, entries: ?FREESTANDING_ENTRIES[0], entry_count: 1, abi: Default.derived{?riscv.RISCV_DEFAULT_ABI}, conventions: Conventions.every{}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, code_models: FREESTANDING_RV32_MODELS},
    Host{sys: ?FREESTANDING, env: opt[*Env].none{}, arch: ?wasm.WASM32, formats: ?FREESTANDING_WASM_FORMATS[0], format_count: 1, outputs: ?FREESTANDING_WASM_OUTPUTS[0], output_count: FREESTANDING_WASM_OUTPUT_COUNT, interpreter: nil, image_base: 0x1_0000, page: 0x1_0000, entries: ?FREESTANDING_WASM_ENTRIES[0], entry_count: 1, abi: Default.row{?wasm.WASM32_BASIC}, linking: ?FREESTANDING_LINKING, placement: FREESTANDING_PLACEMENT, floor: opt[str].some{"wasm1"}, code_models: code.NONE},
};

# a link names an object `<stem>.o`, an image `<stem>` with no extension and
# an archive `lib<stem>.a`. no loader maps a freestanding image, so none
# binds a shared library, and neither ELF nor a flat image has a module a
# runtime instantiates
val FREESTANDING_OBJECT_FILE:  Filename                          = Filename{prefix: "", extension: ".o"};
val FREESTANDING_IMAGE_FILE:   Filename                          = Filename{prefix: "", extension: ""};
val FREESTANDING_ARCHIVE_FILE: Filename                          = Filename{prefix: "lib", extension: ".a"};
val FREESTANDING_OUTPUT_COUNT: usize                             = 7;
val FREESTANDING_OUTPUTS:      [FREESTANDING_OUTPUT_COUNT]Output = [FREESTANDING_OUTPUT_COUNT]Output{
    Output{kind: ?output.RELOCATABLE, built: Built.named{?FREESTANDING_OBJECT_FILE}},
    Output{kind: ?output.STATIC, built: Built.named{?FREESTANDING_IMAGE_FILE}},
    Output{kind: ?output.DYNAMIC, built: Built.named{?FREESTANDING_IMAGE_FILE}},
    Output{kind: ?output.PIE, built: Built.named{?FREESTANDING_IMAGE_FILE}},
    Output{kind: ?output.SHARED, built: Built.unbuilt{"no loader maps a freestanding image, so none binds a shared library at run time"}},
    Output{kind: ?output.ARCHIVE, built: Built.named{?FREESTANDING_ARCHIVE_FILE}},
    Output{kind: ?output.MODULE, built: Built.unbuilt{"neither ELF nor a flat image has a module a runtime instantiates"}},
};

# a link names a wasm object `<stem>.o`, a module `<stem>.wasm`, whether or
# not it has an entry, and an archive `lib<stem>.a`. no host links a module
# into another at run time
val FREESTANDING_WASM_OBJECT_FILE:  Filename                               = Filename{prefix: "", extension: ".o"};
val FREESTANDING_WASM_MODULE_FILE:  Filename                               = Filename{prefix: "", extension: ".wasm"};
val FREESTANDING_WASM_OUTPUT_COUNT: usize                                  = 7;
val FREESTANDING_WASM_OUTPUTS:      [FREESTANDING_WASM_OUTPUT_COUNT]Output = [FREESTANDING_WASM_OUTPUT_COUNT]Output{
    Output{kind: ?output.RELOCATABLE, built: Built.named{?FREESTANDING_WASM_OBJECT_FILE}},
    Output{kind: ?output.STATIC, built: Built.named{?FREESTANDING_WASM_MODULE_FILE}},
    Output{kind: ?output.DYNAMIC, built: Built.named{?FREESTANDING_WASM_MODULE_FILE}},
    Output{kind: ?output.PIE, built: Built.named{?FREESTANDING_WASM_MODULE_FILE}},
    Output{kind: ?output.SHARED, built: Built.unbuilt{"no host of a freestanding wasm module links one module into another at run time"}},
    Output{kind: ?output.ARCHIVE, built: Built.named{?FREESTANDING_ARCHIVE_FILE}},
    Output{kind: ?output.MODULE, built: Built.named{?FREESTANDING_WASM_MODULE_FILE}},
};

pub val FREESTANDING: System = System{
    name:        "freestanding",
    environment: Environment.bare{},
    mapped:      false,
    codes:       ?FREESTANDING_CODES[0],
    code_count:  FREESTANDING_CODE_COUNT,
    hosts:       ?FREESTANDING_HOSTS[0],
    host_count:  FREESTANDING_HOST_COUNT,
};
