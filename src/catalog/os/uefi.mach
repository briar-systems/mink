# uefi, the PE/COFF applications a UEFI firmware loads

use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os;
use mink.catalog.os.Default;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Host;
use mink.catalog.os.System;
use mink.catalog.output;
use mink.catalog.subsystem;
use mink.catalog.subsystem.Subsystem;

val UEFI_FORMAT_COUNT: usize                      = 1;
val UEFI_FORMATS:      [UEFI_FORMAT_COUNT]*Format = [UEFI_FORMAT_COUNT]*Format{?format.COFF};
val UEFI_ENTRIES:      [1]Entry                   = [1]Entry{Entry{caps: output.ENTERED, symbol: "efi_main"}};

# an image is an efi application by default, starts at efi_main
# and links no library by default. the firmware places an image where it
# chooses, so every image is relocatable. an x86_64 image runs on any x86_64
# processor, the psABI baseline, and an aarch64 one with floating point and
# advanced simd enabled (uefi 2.10, 2.3.6)
val UEFI_HOST_COUNT: usize                 = 2;
val UEFI_HOSTS:      [UEFI_HOST_COUNT]Host = [UEFI_HOST_COUNT]Host{
    Host{system: ?UEFI, env: opt[*Env].none{}, arch: ?x86.X86_64, interpreter: nil, image_base: 0x140000000, page: 0x1000, caps: os.PIE_DEFAULT, entries: ?UEFI_ENTRIES[0], entry_count: 1, subsystem: opt[*Subsystem].some{?subsystem.EFI_APPLICATION}, abi: Default.row{?x86.X86_64_WIN64}, floor: opt[str].some{x86.X86_64_BASELINE}},
    Host{system: ?UEFI, env: opt[*Env].none{}, arch: ?aarch64.AARCH64, interpreter: nil, image_base: 0x140000000, page: 0x1000, caps: os.PIE_DEFAULT, entries: ?UEFI_ENTRIES[0], entry_count: 1, subsystem: opt[*Subsystem].some{?subsystem.EFI_APPLICATION}, abi: Default.row{?aarch64.AARCH64_AAPCS64}, floor: opt[str].some{"armv8-a+fp+simd"}},
};

pub val UEFI: System = System{
    name:         "uefi",
    mapped:       true,
    formats:      ?UEFI_FORMATS[0],
    format_count: UEFI_FORMAT_COUNT,
    hosts:        ?UEFI_HOSTS[0],
    host_count:   UEFI_HOST_COUNT,
};
