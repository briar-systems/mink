# uefi, the PE/COFF applications a UEFI firmware loads

use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os;
use mink.catalog.os.Built;
use mink.catalog.os.Default;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Environment;
use mink.catalog.os.Filename;
use mink.catalog.os.Host;
use mink.catalog.os.Linking;
use mink.catalog.os.Output;
use mink.catalog.os.Placement;
use mink.catalog.os.System;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.catalog.subsystem;
use mink.catalog.subsystem.Subsystem;

val UEFI_FORMAT_COUNT: usize                      = 1;
val UEFI_FORMATS:      [UEFI_FORMAT_COUNT]*Format = [UEFI_FORMAT_COUNT]*Format{?format.COFF};
val UEFI_ENTRIES:      [1]Entry                   = [1]Entry{Entry{caps: output.ENTERED, symbol: "efi_main"}};

val UEFI_LINKING_ROWS: [1]*Kind = [1]*Kind{?output.PIE};
val UEFI_LINKING:      Linking  = Linking{rows: ?UEFI_LINKING_ROWS[0], count: 1, default: opt[*Kind].some{?output.PIE}, source: "a UEFI image carries relocations LoadImage applies, UEFI specification, Image Services"};

val UEFI_PLACEMENT: Placement = Placement.relocated{"EFI_BOOT_SERVICES.LoadImage relocates an image into memory the firmware allocates, UEFI specification image services"};

# an image is an efi application by default, starts at efi_main
# and links no library by default. the firmware places an image where it
# chooses, so every image is relocatable. an x86_64 image runs on any x86_64
# processor, the psABI baseline, and an aarch64 one with floating point and
# advanced simd enabled (uefi 2.10, 2.3.6)
val UEFI_HOST_COUNT: usize                 = 2;
val UEFI_HOSTS:      [UEFI_HOST_COUNT]Host = [UEFI_HOST_COUNT]Host{
    Host{sys: ?UEFI, env: opt[*Env].none{}, arch: ?x86.X86_64, interpreter: nil, image_base: 0x140000000, page: 0x1000, entries: ?UEFI_ENTRIES[0], entry_count: 1, subsystem: opt[*Subsystem].some{?subsystem.EFI_APPLICATION}, abi: Default.row{?x86.X86_64_WIN64}, linking: ?UEFI_LINKING, placement: UEFI_PLACEMENT, floor: opt[str].some{x86.X86_64_BASELINE}, code_models: x86.X86_64_SMALL_MODELS},
    Host{sys: ?UEFI, env: opt[*Env].none{}, arch: ?aarch64.AARCH64, interpreter: nil, image_base: 0x140000000, page: 0x1000, entries: ?UEFI_ENTRIES[0], entry_count: 1, subsystem: opt[*Subsystem].some{?subsystem.EFI_APPLICATION}, abi: Default.row{?aarch64.AARCH64_AAPCS64}, linking: ?UEFI_LINKING, placement: UEFI_PLACEMENT, floor: opt[str].some{"armv8-a+fp+simd"}, code_models: aarch64.AARCH64_SMALL_MODELS},
};

# a link names an image `<stem>.efi`, the extension the UEFI specification
# gives an image file, and an object `<stem>.obj` and a static library
# `<stem>.lib` as windows does. no image binds another's exports, and PE has
# no module a runtime instantiates
val UEFI_OBJECT_FILE:  Filename                  = Filename{prefix: "", extension: ".obj"};
val UEFI_IMAGE_FILE:   Filename                  = Filename{prefix: "", extension: ".efi"};
val UEFI_ARCHIVE_FILE: Filename                  = Filename{prefix: "", extension: ".lib"};
val UEFI_OUTPUT_COUNT: usize                     = 7;
val UEFI_OUTPUTS:      [UEFI_OUTPUT_COUNT]Output = [UEFI_OUTPUT_COUNT]Output{
    Output{kind: ?output.RELOCATABLE, built: Built.named{?UEFI_OBJECT_FILE}},
    Output{kind: ?output.STATIC, built: Built.named{?UEFI_IMAGE_FILE}},
    Output{kind: ?output.DYNAMIC, built: Built.named{?UEFI_IMAGE_FILE}},
    Output{kind: ?output.PIE, built: Built.named{?UEFI_IMAGE_FILE}},
    Output{kind: ?output.SHARED, built: Built.unbuilt{"the firmware binds no image against another's exports, an image reaches services through the tables it is passed, UEFI specification image services"}},
    Output{kind: ?output.ARCHIVE, built: Built.named{?UEFI_ARCHIVE_FILE}},
    Output{kind: ?output.MODULE, built: Built.unbuilt{"PE has no module a runtime instantiates, PE format image only and object only fields"}},
};

pub val UEFI: System = System{
    name:         "uefi",
    environment:  Environment.bare{},
    mapped:       true,
    formats:      ?UEFI_FORMATS[0],
    format_count: UEFI_FORMAT_COUNT,
    hosts:        ?UEFI_HOSTS[0],
    host_count:   UEFI_HOST_COUNT,
    outputs:      ?UEFI_OUTPUTS[0],
    output_count: UEFI_OUTPUT_COUNT,
};
