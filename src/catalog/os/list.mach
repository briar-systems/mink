# every operating system of the catalog, and the lookups that read them
#
# the one place the rows are enumerated. a new system is a system file's row
# and its lines here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.table;
use mink.base.table.Table;
use mink.catalog.arch;
use mink.catalog.arch.aarch64;
use arch_list: mink.catalog.arch.list;
use mink.catalog.arch.riscv;
use mink.catalog.arch.x86;
use mink.catalog.os;
use mink.catalog.os.Env;
use mink.catalog.os.Host;
use mink.catalog.os.System;
use mink.catalog.os.darwin;
use mink.catalog.os.freestanding;
use mink.catalog.os.linux;
use mink.catalog.os.spirv;
use mink.catalog.os.uefi;
use mink.catalog.os.wasi;
use mink.catalog.os.windows;
use mink.catalog.output;
use mink.catalog.trait;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;

val ROW_COUNT: usize = 8;

val ROWS: [ROW_COUNT]*System = [ROW_COUNT]*System{?linux.LINUX, ?darwin.DARWIN, ?windows.WINDOWS, ?uefi.UEFI, ?freestanding.FREESTANDING, ?wasi.WASI, ?spirv.VULKAN, ?spirv.OPENCL};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *System {
    ret ROWS[index];
}

# the rows ascending by name
val NAMES: [ROW_COUNT]*System = [ROW_COUNT]*System{?darwin.DARWIN, ?freestanding.FREESTANDING, ?linux.LINUX, ?spirv.OPENCL, ?uefi.UEFI, ?spirv.VULKAN, ?wasi.WASI, ?windows.WINDOWS};

# every environment of every system
val ENV_COUNT: usize           = 4;
val ENVS:      [ENV_COUNT]*Env = [ENV_COUNT]*Env{?linux.GNU, ?darwin.MACOS, ?windows.MSVC, ?wasi.PREVIEW1};

fun order_names(a: **System, b: **System) i64 {
    ret str_compare(a[0].name, b[0].name);
}

pub fun by_name(name: str) res[*System, Fail] {
    var probe: System       = System{name: name};
    val row:   opt[*System] = index.find[System](?NAMES[0], ROW_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*System, Fail].err{fail.unsupported("no system has this name")}; }
    ret res[*System, Fail].ok{row.some};
}

# the environment of `s` named `name`
pub fun env_by_name(s: *System, name: str) res[*Env, Fail] {
    var i: usize = 0;
    for (i < ENV_COUNT) {
        if (ENVS[i].system == s && str_equals(ENVS[i].name, name)) { ret res[*Env, Fail].ok{ENVS[i]}; }
        i = i + 1;
    }
    ret res[*Env, Fail].err{fail.about(fail.unsupported("the system has no environment of this name"), s.name)};
}

# whether two hosts can both hold for one link: one environment and one
# architecture, and conditions that do not tell them apart
fun clash(a: *Host, b: *Host) bool {
    if (a.arch != b.arch)                     { ret false; }
    if ((sel a.env.none) != (sel b.env.none)) { ret false; }
    if (sel a.env.some) {
        if (sel b.env.some) {
            if (a.env.some != b.env.some) { ret false; }
        }
    }
    if (sel a.when.none) { ret true; }
    if (sel b.when.none) { ret true; }
    ret a.when.some.axis == b.when.some.axis && trait.same(a.when.some.setting, b.when.some.setting);
}

# whether two entries of a host both name an entry for one output kind
fun entries_clash(h: *Host) bool {
    var k: usize = 0;
    for (k < output.count()) {
        var held: usize = 0;
        var i:    usize = 0;
        for (i < h.entry_count) {
            if (output.has(output.at(k), h.entries[i].caps)) { held = held + 1; }
            i = i + 1;
        }
        if (held > 1) { ret true; }
        k = k + 1;
    }
    ret false;
}

# whether a system is consistent: each host is its own, for a catalog
# architecture, under one of its environments, with entries that do not
# clash, and no two of its hosts can hold for one link
fun consistent(s: *System) bool {
    var i: usize = 0;
    for (i < s.host_count) {
        val h: *Host = ?s.hosts[i];
        if (h.system != s || !arch_list.member(h.arch)) { ret false; }
        if (sel h.env.some && h.env.some.system != s)   { ret false; }
        if (entries_clash(h))                           { ret false; }
        var j: usize = 0;
        for (j < i) {
            if (clash(?s.hosts[j], h)) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret s.format_count != 0;
}

val DUPLICATE_NAMES: [2]*System = [2]*System{?linux.LINUX, ?linux.LINUX};

test os__rows_are_consistent_and_the_name_index_holds {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        val r: res[*System, Fail] = by_name(ROWS[i].name);
        if (sel r.err)       { ret 2; }
        if (r.ok != ROWS[i]) { ret 2; }
        i = i + 1;
    }
    val rows:  [ROW_COUNT]*System = ROWS;
    val built: err[Fail]          = index.verify[System](?NAMES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_names);
    if (sel built.err) { ret 3; }
    val miss: res[*System, Fail] = by_name("plan9");
    if (sel miss.ok) { ret 3; }
    val bad: err[Fail] = index.verify[System](?DUPLICATE_NAMES[0], 2, ?rows[0], 2, order_names);
    if (sel bad.ok) { ret 3; }
    i = 0;
    for (i < ENV_COUNT) {
        val e: res[*Env, Fail] = env_by_name(ENVS[i].system, ENVS[i].name);
        if (sel e.err)       { ret 4; }
        if (e.ok != ENVS[i]) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

# the one host of `s` under `e` for `a` that holds of the float ABI `abi`,
# stated as a riscv trait, or of no traits when `abi` is nil
fun held(t: *T.Testing, s: *System, e: opt[*Env], a: *arch.Arch, abi: *trait.Choice) res[*Host, Fail] {
    var ts: Table[Trait] = table.make[Trait](T.allocator_of(t));
    if (abi != nil) {
        val put: err[Fail] = trait.add(?ts, Trait{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{abi}});
        if (sel put.err) { ret res[*Host, Fail].err{put.err}; }
    }
    val h: res[*Host, Fail] = os.host(s, e, a, ?ts);
    val r: err[Fail]        = table.release[Trait](?ts);
    if (sel r.err) { ret res[*Host, Fail].err{r.err}; }
    ret h;
}

test os__the_loader_follows_the_float_abi_and_the_rows_carry_the_host_facts {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val gnu: opt[*Env]        = opt[*Env].some{?linux.GNU};
    val d:   res[*Host, Fail] = held(?t, ?linux.LINUX, gnu, ?riscv.RISCV64, ?riscv.RISCV_DOUBLE);
    if (sel d.err)                                                         { ret 1; }
    if (!str_equals(d.ok.interpreter, "/lib/ld-linux-riscv64-lp64d.so.1")) { ret 1; }
    val s: res[*Host, Fail] = held(?t, ?linux.LINUX, gnu, ?riscv.RISCV64, ?riscv.RISCV_SOFT);
    if (sel s.err)                                                        { ret 1; }
    if (!str_equals(s.ok.interpreter, "/lib/ld-linux-riscv64-lp64.so.1")) { ret 1; }
    val f: res[*Host, Fail] = held(?t, ?linux.LINUX, gnu, ?riscv.RISCV64, ?riscv.RISCV_SINGLE);
    if (!sel f.err)                   { ret 2; }
    if (!sel f.err.cause.unsupported) { ret 2; }
    val none: res[*Host, Fail] = held(?t, ?linux.LINUX, gnu, ?riscv.RISCV64, nil);
    if (!sel none.err) { ret 2; }
    val bare: res[*Host, Fail] = held(?t, ?linux.LINUX, opt[*Env].none{}, ?x86.X86_64, nil);
    if (!sel bare.err) { ret 3; }
    val x: res[*Host, Fail] = held(?t, ?linux.LINUX, gnu, ?x86.X86_64, nil);
    if (sel x.err)                                                                                      { ret 3; }
    if (!str_equals(x.ok.interpreter, "/lib64/ld-linux-x86-64.so.2") || x.ok.page != 0x1000)            { ret 3; }
    if (!str_equals(os.entry(x.ok, ?output.STATIC), "_start") || os.entry(x.ok, ?output.SHARED) != nil) { ret 3; }

    val mac: res[*Host, Fail] = held(?t, ?darwin.DARWIN, opt[*Env].some{?darwin.MACOS}, ?aarch64.AARCH64, nil);
    if (sel mac.err)                                                                                { ret 4; }
    if (!str_equals(mac.ok.interpreter, "/usr/lib/dyld") || mac.ok.page != 0x4000)                  { ret 4; }
    if (!sel mac.ok.minos.some)                                                                     { ret 4; }
    if (mac.ok.minos.some.major != 11)                                                              { ret 4; }
    if (mac.ok.sdk_dir_count != 1 || !str_equals(mac.ok.sdk_dirs[0], "/System/Library/Frameworks")) { ret 4; }
    if (mac.ok.since_count != 1 || mac.ok.since[0].cap != os.CHAINED_FIXUPS)                        { ret 4; }
    if (mac.ok.symbol_count != 1 || mac.ok.symbols[0].role != ?os.TLV_BOOTSTRAP)                    { ret 4; }

    val efi: res[*Host, Fail] = held(?t, ?uefi.UEFI, opt[*Env].none{}, ?x86.X86_64, nil);
    if (sel efi.err)                                               { ret 5; }
    if (!sel efi.ok.subsystem.some)                                { ret 5; }
    if (efi.ok.subsystem.some != 10)                               { ret 5; }
    if (!str_equals(os.entry(efi.ok, ?output.STATIC), "efi_main")) { ret 5; }
    if (efi.ok.library_count != 0 || !uefi.UEFI.mapped)            { ret 5; }
    val win: res[*Host, Fail] = held(?t, ?windows.WINDOWS, opt[*Env].some{?windows.MSVC}, ?x86.X86_64, nil);
    if (sel win.err)                      { ret 6; }
    if (!sel win.ok.subsystem.some)       { ret 6; }
    if (win.ok.subsystem.some != 3)       { ret 6; }
    if (freestanding.FREESTANDING.mapped) { ret 7; }
    if (T.live_count(?t) != 0)            { ret 8; }
    T.dnit(?t);
    ret 0;
}
