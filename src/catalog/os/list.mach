# every operating system of the catalog, and the lookups that read them
#
# the one place the rows are enumerated. a new system is a system file's row
# and its lines here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.table;
use mink.base.table.Table;
use mink.catalog.arch;
use mink.catalog.arch.Abi;
use mink.catalog.arch.aarch64;
use arch_list: mink.catalog.arch.list;
use mink.catalog.arch.riscv;
use arch_spirv: mink.catalog.arch.spirv;
use mink.catalog.arch.x86;
use mink.catalog.isa;
use mink.catalog.os;
use mink.catalog.os.Env;
use mink.catalog.os.Host;
use mink.catalog.os.System;
use mink.catalog.os.darwin;
use mink.catalog.os.freestanding;
use mink.catalog.os.linux;
use mink.catalog.os.spirv;
use mink.catalog.os.uefi;
use mink.catalog.os.wasi;
use mink.catalog.os.windows;
use mink.catalog.output;
use mink.catalog.subsystem;
use mink.catalog.trait;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;

val ROW_COUNT: usize = 8;

val ROWS: [ROW_COUNT]*System = [ROW_COUNT]*System{?linux.LINUX, ?darwin.DARWIN, ?windows.WINDOWS, ?uefi.UEFI, ?freestanding.FREESTANDING, ?wasi.WASI, ?spirv.VULKAN, ?spirv.OPENCL};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *System {
    ret ROWS[index];
}

# the rows ascending by name
val NAMES: [ROW_COUNT]*System = [ROW_COUNT]*System{?darwin.DARWIN, ?freestanding.FREESTANDING, ?linux.LINUX, ?spirv.OPENCL, ?uefi.UEFI, ?spirv.VULKAN, ?wasi.WASI, ?windows.WINDOWS};

# every environment of every system
val ENV_COUNT: usize           = 8;
val ENVS:      [ENV_COUNT]*Env = [ENV_COUNT]*Env{?linux.GNU, ?darwin.MACOS, ?windows.MSVC, ?wasi.PREVIEW1, ?spirv.VULKAN_1_0, ?spirv.VULKAN_1_1, ?spirv.VULKAN_1_2, ?spirv.VULKAN_1_3};

fun order_names(a: **System, b: **System) i64 {
    ret str_compare(a[0].name, b[0].name);
}

pub fun by_name(name: str) res[*System, Fail] {
    var probe: System       = System{name: name};
    val row:   opt[*System] = index.find[System](?NAMES[0], ROW_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*System, Fail].err{fail.unsupported("no system has this name")}; }
    ret res[*System, Fail].ok{row.some};
}

# the environment of `s` named `name`
pub fun env_by_name(s: *System, name: str) res[*Env, Fail] {
    var i: usize = 0;
    for (i < ENV_COUNT) {
        if (ENVS[i].system == s && str_equals(ENVS[i].name, name)) { ret res[*Env, Fail].ok{ENVS[i]}; }
        i = i + 1;
    }
    ret res[*Env, Fail].err{fail.about(fail.unsupported("the system has no environment of this name"), s.name)};
}

# whether two hosts can both hold for one link: one environment and one
# architecture, and conditions that do not tell them apart
fun clash(a: *Host, b: *Host) bool {
    if (a.arch != b.arch)                     { ret false; }
    if ((sel a.env.none) != (sel b.env.none)) { ret false; }
    if (sel a.env.some) {
        if (sel b.env.some) {
            if (a.env.some != b.env.some) { ret false; }
        }
    }
    if (sel a.when.none) { ret true; }
    if (sel b.when.none) { ret true; }
    ret a.when.some.axis == b.when.some.axis && trait.same(a.when.some.setting, b.when.some.setting);
}

# whether two entries of a host both name an entry for one output kind
fun entries_clash(h: *Host) bool {
    var k: usize = 0;
    for (k < output.count()) {
        var held: usize = 0;
        var i:    usize = 0;
        for (i < h.entry_count) {
            if (output.has(output.at(k), h.entries[i].caps)) { held = held + 1; }
            i = i + 1;
        }
        if (held > 1) { ret true; }
        k = k + 1;
    }
    ret false;
}

# whether a derivation gives a host only rows of its family, at least one of
# them for its architecture, reads an axis and a grammar of the architecture,
# and holds at most one row for any link
fun derivation_consistent(h: *Host, d: *arch.Derivation) bool {
    val disjoint: err[Fail] = arch.derivation_disjoint(d);
    if (sel disjoint.err)               { ret false; }
    if (!arch.has_axis(h.arch, d.axis)) { ret false; }
    val g: opt[*isa.Grammar] = h.arch.family.grammar;
    if (sel g.none)          { ret false; }
    if (g.some != d.grammar) { ret false; }
    var mine: bool  = false;
    var i:    usize = 0;
    for (i < d.row_count) {
        val b: *Abi = d.rows[i].abi;
        i = i + 1;
        if (b.arch.family != h.arch.family) { ret false; }
        val named: opt[*Abi] = arch.abi(b.arch, b.name);
        if (sel named.none)   { ret false; }
        if (named.some != b)  { ret false; }
        if (b.arch == h.arch) { mine = true; }
    }
    ret mine;
}

# whether a host's default calling convention is stated wherever its family
# names rows: a row of its architecture that implies the setting the host's
# condition names, or a consistent derivation
fun abi_consistent(h: *Host) bool {
    if (sel h.abi.none)    { ret h.arch.family.abi_count == 0; }
    or (sel h.abi.derived) { ret derivation_consistent(h, h.abi.derived); }
    val b: *Abi = h.abi.row;
    if (b.arch != h.arch) { ret false; }
    if (sel h.when.none)  { ret true; }
    val w: os.When = h.when.some;
    var i: usize   = 0;
    for (i < b.count) {
        if (b.settings[i].axis == w.axis && trait.same(b.settings[i].setting, w.setting)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a host states whether its loader runs an image at its linked
# address, with the behaviour it rests on
fun placement_stated(h: *Host) bool {
    if (sel h.placement.unstated) { ret false; }
    or (sel h.placement.linked)   { ret str_len(h.placement.linked) != 0; }
    ret str_len(h.placement.relocated) != 0;
}

# whether a host's ceilings each bound an ordered axis of its architecture
# once, at a choice the axis lists
fun ceilings_consistent(h: *Host) bool {
    var i: usize = 0;
    for (i < h.ceiling_count) {
        val c: os.Ceiling = h.ceilings[i];
        if (!arch.has_axis(h.arch, c.axis) || !(sel c.axis.merge.ordered)) { ret false; }
        if (!trait.fits(c.axis, Setting.choice{c.highest}))                { ret false; }
        var j: usize = 0;
        for (j < i) {
            if (h.ceilings[j].axis == c.axis) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# whether a system is consistent: each host is its own, for a catalog
# architecture, under one of its environments, with entries that do not
# clash, a consistent default calling convention and a placement stated with
# the loader behaviour it rests on, and no two of its hosts can hold for one
# link
fun consistent(s: *System) bool {
    var i: usize = 0;
    for (i < s.host_count) {
        val h: *Host = ?s.hosts[i];
        if (h.system != s || !arch_list.member(h.arch)) { ret false; }
        if (sel h.env.some && h.env.some.system != s)   { ret false; }
        if (entries_clash(h) || !abi_consistent(h))     { ret false; }
        if (!placement_stated(h))                       { ret false; }
        if (!ceilings_consistent(h))                    { ret false; }
        var j: usize = 0;
        for (j < i) {
            if (clash(?s.hosts[j], h)) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret s.format_count != 0;
}

val DUPLICATE_NAMES: [2]*System = [2]*System{?linux.LINUX, ?linux.LINUX};

test os__rows_are_consistent_and_the_name_index_holds {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        val r: res[*System, Fail] = by_name(ROWS[i].name);
        if (sel r.err)       { ret 2; }
        if (r.ok != ROWS[i]) { ret 2; }
        i = i + 1;
    }
    val rows:  [ROW_COUNT]*System = ROWS;
    val built: err[Fail]          = index.verify[System](?NAMES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_names);
    if (sel built.err) { ret 3; }
    val miss: res[*System, Fail] = by_name("plan9");
    if (sel miss.ok) { ret 3; }
    val bad: err[Fail] = index.verify[System](?DUPLICATE_NAMES[0], 2, ?rows[0], 2, order_names);
    if (sel bad.ok) { ret 3; }
    i = 0;
    for (i < ENV_COUNT) {
        val e: res[*Env, Fail] = env_by_name(ENVS[i].system, ENVS[i].name);
        if (sel e.err)       { ret 4; }
        if (e.ok != ENVS[i]) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

# the one host of `s` under `e` for `a` that holds of the float ABI `abi`,
# stated as a riscv trait, or of no traits when `abi` is nil
fun held(t: *T.Testing, s: *System, e: opt[*Env], a: *arch.Arch, abi: *trait.Choice) res[*Host, Fail] {
    var ts: Table[Trait] = table.make[Trait](T.allocator_of(t));
    if (abi != nil) {
        val put: err[Fail] = trait.add(?ts, Trait{axis: ?riscv.RISCV_FLOAT_ABI, setting: Setting.choice{abi}});
        if (sel put.err) { ret res[*Host, Fail].err{put.err}; }
    }
    val h: res[*Host, Fail] = os.host(s, e, a, ?ts);
    val r: err[Fail]        = table.release[Trait](?ts);
    if (sel r.err) { ret res[*Host, Fail].err{r.err}; }
    ret h;
}

test os__the_loader_follows_the_float_abi_and_the_rows_carry_the_host_facts {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val gnu: opt[*Env]        = opt[*Env].some{?linux.GNU};
    val d:   res[*Host, Fail] = held(?t, ?linux.LINUX, gnu, ?riscv.RISCV64, ?riscv.RISCV_DOUBLE);
    if (sel d.err)                                                         { ret 1; }
    if (!str_equals(d.ok.interpreter, "/lib/ld-linux-riscv64-lp64d.so.1")) { ret 1; }
    val s: res[*Host, Fail] = held(?t, ?linux.LINUX, gnu, ?riscv.RISCV64, ?riscv.RISCV_SOFT);
    if (sel s.err)                                                        { ret 1; }
    if (!str_equals(s.ok.interpreter, "/lib/ld-linux-riscv64-lp64.so.1")) { ret 1; }
    val f: res[*Host, Fail] = held(?t, ?linux.LINUX, gnu, ?riscv.RISCV64, ?riscv.RISCV_SINGLE);
    if (sel f.err)               { ret 2; }
    if (f.ok.interpreter != nil) { ret 2; }
    val q: res[*Host, Fail] = held(?t, ?linux.LINUX, gnu, ?riscv.RISCV64, ?riscv.RISCV_QUAD);
    if (!sel q.err)                   { ret 2; }
    if (!sel q.err.cause.unsupported) { ret 2; }
    val none: res[*Host, Fail] = held(?t, ?linux.LINUX, gnu, ?riscv.RISCV64, nil);
    if (!sel none.err) { ret 2; }
    val bare: res[*Host, Fail] = held(?t, ?linux.LINUX, opt[*Env].none{}, ?x86.X86_64, nil);
    if (!sel bare.err) { ret 3; }
    val x: res[*Host, Fail] = held(?t, ?linux.LINUX, gnu, ?x86.X86_64, nil);
    if (sel x.err)                                                                                      { ret 3; }
    if (!str_equals(x.ok.interpreter, "/lib64/ld-linux-x86-64.so.2") || x.ok.page != 0x1000)            { ret 3; }
    if (!str_equals(os.entry(x.ok, ?output.STATIC), "_start") || os.entry(x.ok, ?output.SHARED) != nil) { ret 3; }

    val mac: res[*Host, Fail] = held(?t, ?darwin.DARWIN, opt[*Env].some{?darwin.MACOS}, ?aarch64.AARCH64, nil);
    if (sel mac.err)                                                                                { ret 4; }
    if (!str_equals(mac.ok.interpreter, "/usr/lib/dyld") || mac.ok.page != 0x4000)                  { ret 4; }
    if (!sel mac.ok.minos.some)                                                                     { ret 4; }
    if (mac.ok.minos.some.major != 11)                                                              { ret 4; }
    if (mac.ok.sdk_dir_count != 1 || !str_equals(mac.ok.sdk_dirs[0], "/System/Library/Frameworks")) { ret 4; }
    if (mac.ok.since_count != 1 || mac.ok.since[0].cap != os.CHAINED_FIXUPS)                        { ret 4; }
    if (mac.ok.symbol_count != 1 || mac.ok.symbols[0].role != ?os.TLV_BOOTSTRAP)                    { ret 4; }

    val efi: res[*Host, Fail] = held(?t, ?uefi.UEFI, opt[*Env].none{}, ?x86.X86_64, nil);
    if (sel efi.err)                                               { ret 5; }
    if (!sel efi.ok.subsystem.some)                                { ret 5; }
    if (efi.ok.subsystem.some != ?subsystem.EFI_APPLICATION)       { ret 5; }
    if (!str_equals(os.entry(efi.ok, ?output.STATIC), "efi_main")) { ret 5; }
    if (efi.ok.library_count != 0 || !uefi.UEFI.mapped)            { ret 5; }
    val win: res[*Host, Fail] = held(?t, ?windows.WINDOWS, opt[*Env].some{?windows.MSVC}, ?x86.X86_64, nil);
    if (sel win.err)                                 { ret 6; }
    if (!sel win.ok.subsystem.some)                  { ret 6; }
    if (win.ok.subsystem.some != ?subsystem.CONSOLE) { ret 6; }
    if (freestanding.FREESTANDING.mapped)            { ret 7; }
    if (T.live_count(?t) != 0)                       { ret 8; }
    T.dnit(?t);
    ret 0;
}

# how many SPIR-V versions host `h` admits
fun admitted(h: *Host) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < arch_spirv.SPIRV_VERSION.count) {
        if (os.admits(h, ?arch_spirv.SPIRV_VERSION, arch_spirv.SPIRV_VERSION.choices[i])) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

val VULKAN_NAMES:    [4]str   = [4]str{"vulkan1.0", "vulkan1.1", "vulkan1.2", "vulkan1.3"};
val VULKAN_ADMITTED: [4]usize = [4]usize{1, 4, 6, 7};

test os__a_vulkan_version_admits_the_spirv_versions_up_to_its_ceiling {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var k: usize = 0;
    for (k < 4) {
        val e: res[*Env, Fail] = env_by_name(?spirv.VULKAN, VULKAN_NAMES[k]);
        if (sel e.err) { ret 2; }
        val h: res[*Host, Fail] = held(?t, ?spirv.VULKAN, opt[*Env].some{e.ok}, ?arch_spirv.SPIRV, nil);
        if (sel h.err)                            { ret 3; }
        if (admitted(h.ok) != VULKAN_ADMITTED[k]) { ret 4; }
        k = k + 1;
    }
    val bare: res[*Host, Fail] = held(?t, ?spirv.VULKAN, opt[*Env].none{}, ?arch_spirv.SPIRV, nil);
    if (sel bare.err)                                        { ret 5; }
    if (admitted(bare.ok) != arch_spirv.SPIRV_VERSION.count) { ret 5; }
    if (T.live_count(?t) != 0)                               { ret 6; }
    T.dnit(?t);
    ret 0;
}

# the default calling convention of the freestanding host for `a` under the
# ISA string `isa`, or under no traits when `isa` is nil
fun derived(t: *T.Testing, a: *arch.Arch, isa: str) res[opt[*Abi], Fail] {
    var ts: Table[Trait] = table.make[Trait](T.allocator_of(t));
    if (isa != nil) {
        val put: err[Fail] = trait.add(?ts, Trait{axis: ?riscv.RISCV_ARCH, setting: Setting.text{Held.borrowed{Bytes{data: isa::*u8, len: str_len(isa)}}}});
        if (sel put.err) { ret res[opt[*Abi], Fail].err{put.err}; }
    }
    val h: res[*Host, Fail] = os.host(?freestanding.FREESTANDING, opt[*Env].none{}, a, ?ts);
    if (sel h.err) {
        val dropped: err[Fail] = table.release[Trait](?ts);
        ret res[opt[*Abi], Fail].err{h.err};
    }
    val b: res[opt[*Abi], Fail] = os.default_abi(h.ok, ?ts, nil);
    val r: err[Fail]            = table.release[Trait](?ts);
    if (sel r.err) { ret res[opt[*Abi], Fail].err{r.err}; }
    ret b;
}

# whether `r` is the row `b`
fun gives(r: res[opt[*Abi], Fail], b: *Abi) bool {
    if (sel r.err)     { ret false; }
    if (sel r.ok.none) { ret false; }
    ret r.ok.some == b;
}

test os__a_host_reads_its_default_calling_convention_through_its_row {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val mac: res[*Host, Fail] = held(?t, ?darwin.DARWIN, opt[*Env].some{?darwin.MACOS}, ?aarch64.AARCH64, nil);
    if (sel mac.err) { ret 1; }
    var none: Table[Trait] = table.make[Trait](T.allocator_of(?t));
    if (!gives(os.default_abi(mac.ok, ?none, nil), ?aarch64.AARCH64_DARWINPCS))                       { ret 1; }
    if (!gives(derived(?t, ?riscv.RISCV64, "rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0"), ?riscv.RISCV_LP64D)) { ret 2; }
    if (!gives(derived(?t, ?riscv.RISCV32, "rv32i2p1_m2p0_f2p2"), ?riscv.RISCV_ILP32F))               { ret 2; }
    if (!gives(derived(?t, ?riscv.RISCV64, "rv64i2p1_m2p0_a2p1_c2p0"), ?riscv.RISCV_LP64))            { ret 2; }
    if (!gives(derived(?t, ?riscv.RISCV32E, "rv32e2p0_m2p0_c2p0"), ?riscv.RISCV_ILP32E))              { ret 2; }
    val unstated: res[opt[*Abi], Fail] = derived(?t, ?riscv.RISCV64, nil);
    if (!sel unstated.err)                               { ret 3; }
    if (!sel unstated.err.cause.unsupported)             { ret 3; }
    if (!str_equals(unstated.err.subject, "riscv-arch")) { ret 3; }
    var k: usize = 0;
    for (k < wasi.WASI.host_count) {
        val wasm: res[opt[*Abi], Fail] = os.default_abi(?wasi.WASI.hosts[k], ?none, nil);
        if (sel wasm.err)     { ret 4; }
        if (sel wasm.ok.some) { ret 4; }
        k = k + 1;
    }
    val released: err[Fail] = table.release[Trait](?none);
    if (sel released.err)      { ret 5; }
    if (T.live_count(?t) != 0) { ret 5; }
    T.dnit(?t);
    ret 0;
}
