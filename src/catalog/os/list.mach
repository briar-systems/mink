# every operating system of the catalog, and the lookups that read them
#
# the one place the rows are enumerated. a new system is a system file's row
# and its lines here.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.catalog.os.Env;
use mink.catalog.os.System;
use mink.catalog.os.darwin;
use mink.catalog.os.freestanding;
use mink.catalog.os.linux;
use mink.catalog.os.spirv;
use mink.catalog.os.uefi;
use mink.catalog.os.wasi;
use mink.catalog.os.windows;

val ROW_COUNT: usize = 8;

val ROWS: [ROW_COUNT]*System = [ROW_COUNT]*System{?linux.LINUX, ?darwin.DARWIN, ?windows.WINDOWS, ?uefi.UEFI, ?freestanding.FREESTANDING, ?wasi.WASI, ?spirv.VULKAN, ?spirv.OPENCL};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *System {
    ret ROWS[index];
}

# the rows ascending by name
val NAMES: [ROW_COUNT]*System = [ROW_COUNT]*System{?darwin.DARWIN, ?freestanding.FREESTANDING, ?linux.LINUX, ?spirv.OPENCL, ?uefi.UEFI, ?spirv.VULKAN, ?wasi.WASI, ?windows.WINDOWS};

# every environment of every system
val ENV_COUNT: usize           = 8;
val ENVS:      [ENV_COUNT]*Env = [ENV_COUNT]*Env{?linux.GNU, ?darwin.MACOS, ?windows.MSVC, ?wasi.PREVIEW1, ?spirv.VULKAN_1_0, ?spirv.VULKAN_1_1, ?spirv.VULKAN_1_2, ?spirv.VULKAN_1_3};

fun order_names(a: **System, b: **System) i64 {
    ret str_compare(a[0].name, b[0].name);
}

pub fun by_name(name: str) res[*System, Fail] {
    var probe: System       = System{name: name};
    val row:   opt[*System] = index.find[System](?NAMES[0], ROW_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*System, Fail].err{fail.unsupported("no system has this name")}; }
    ret res[*System, Fail].ok{row.some};
}

# the environment of `s` named `name`
pub fun env_by_name(s: *System, name: str) res[*Env, Fail] {
    var i: usize = 0;
    for (i < ENV_COUNT) {
        if (ENVS[i].system == s && str_equals(ENVS[i].name, name)) { ret res[*Env, Fail].ok{ENVS[i]}; }
        i = i + 1;
    }
    ret res[*Env, Fail].err{fail.about(fail.unsupported("the system has no environment of this name"), s.name)};
}
