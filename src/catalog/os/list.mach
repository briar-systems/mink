# every operating system of the catalog, and the lookups that read them
#
# the one place the rows are enumerated. a new system is a system file's row
# and its lines here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.catalog.arch.Arch;
use mink.catalog.arch.aarch64;
use mink.catalog.arch.riscv;
use arch_spirv: mink.catalog.arch.spirv;
use mink.catalog.arch.wasm;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.os;
use mink.catalog.os.Host;
use mink.catalog.os.Os;
use mink.catalog.os.darwin;
use mink.catalog.os.freestanding;
use mink.catalog.os.linux;
use mink.catalog.os.spirv;
use mink.catalog.os.wasi;
use mink.catalog.os.windows;

val ROW_COUNT: usize = 7;

val ROWS: [ROW_COUNT]*Os = [ROW_COUNT]*Os{?linux.LINUX, ?darwin.DARWIN, ?windows.WINDOWS, ?freestanding.FREESTANDING, ?wasi.WASI, ?spirv.VULKAN, ?spirv.OPENCL};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Os {
    ret ROWS[index];
}

# the rows ascending by name
val NAMES: [ROW_COUNT]*Os = [ROW_COUNT]*Os{?darwin.DARWIN, ?freestanding.FREESTANDING, ?linux.LINUX, ?spirv.OPENCL, ?spirv.VULKAN, ?wasi.WASI, ?windows.WINDOWS};

fun order_names(a: **Os, b: **Os) i64 {
    ret str_compare(a[0].name, b[0].name);
}

pub fun by_name(name: str) res[*Os, Fail] {
    var probe: Os       = Os{name: name};
    val row:   opt[*Os] = index.find[Os](?NAMES[0], ROW_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*Os, Fail].err{fail.unsupported("no operating system has this name")}; }
    ret res[*Os, Fail].ok{row.some};
}

# whether `got` holds the `want_n` directories `want` names, in order
fun dirs_are(got: *str, n: usize, want: *str, want_n: usize) bool {
    if (n != want_n) { ret false; }
    var k: usize = 0;
    for (k < n) {
        if (!str_equals(got[k], want[k])) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether `h` runs `a` with this interpreter, image base, page and caps
fun host_is(h: *Host, a: *Arch, interp: str, base: u64, page: u64, caps: os.Caps) bool {
    if ((interp == nil) != (h.interpreter == nil)) { ret false; }
    ret h.arch == a && str_equals(h.interpreter, interp) && h.image_base == base && h.page_size == page && h.caps == caps;
}

test os__system_rows_match_the_compiler {
    if (ROW_COUNT != 7) { ret 1; }

    val lin:     *Os    = ?linux.LINUX;
    val lin_x64: [6]str = [6]str{"/lib64", "/usr/lib64", "/lib/x86_64-linux-gnu", "/usr/lib/x86_64-linux-gnu", "/usr/lib", "/lib"};
    val lin_x86: [6]str = [6]str{"/lib32", "/usr/lib32", "/lib/i386-linux-gnu", "/usr/lib/i386-linux-gnu", "/usr/lib", "/lib"};
    val lin_a64: [6]str = [6]str{"/lib/aarch64-linux-gnu", "/usr/lib/aarch64-linux-gnu", "/lib64", "/usr/lib64", "/usr/lib", "/lib"};
    val lin_r64: [6]str = [6]str{"/lib/riscv64-linux-gnu", "/usr/lib/riscv64-linux-gnu", "/lib64", "/usr/lib64", "/usr/lib", "/lib"};
    val lin_r32: [6]str = [6]str{"/lib/riscv32-linux-gnu", "/usr/lib/riscv32-linux-gnu", "/lib32", "/usr/lib32", "/usr/lib", "/lib"};
    if (!str_equals(lin.name, "linux") || !str_equals(lin.entry, "_start") || !lin.mapped)                              { ret 1; }
    if (lin.code_count != 1 || lin.codes[0].format != ?format.ELF || lin.codes[0].value != 0)                           { ret 1; }
    if (lin.format_count != 1 || lin.formats[0] != ?format.ELF)                                                         { ret 1; }
    if (lin.library_count != 0 || lin.framework_dir_count != 0)                                                         { ret 1; }
    if (lin.min_version.major != 0)                                                                                     { ret 1; }
    if (lin.host_count != 5)                                                                                            { ret 1; }
    if (!host_is(?lin.hosts[0], ?x86.X86_64, "/lib64/ld-linux-x86-64.so.2", 0x400000, 0x1000, 0))                       { ret 1; }
    if (!dirs_are(lin.hosts[0].libdirs, lin.hosts[0].libdir_count, ?lin_x64[0], 6))                                     { ret 1; }
    if (!host_is(?lin.hosts[1], ?x86.X86, "/lib/ld-linux.so.2", 0x400000, 0x1000, 0))                                   { ret 1; }
    if (!dirs_are(lin.hosts[1].libdirs, lin.hosts[1].libdir_count, ?lin_x86[0], 6))                                     { ret 1; }
    if (!host_is(?lin.hosts[2], ?aarch64.AARCH64, "/lib/ld-linux-aarch64.so.1", 0x400000, 0x1_0000, os.DIT_GUARANTEED)) { ret 1; }
    if (!dirs_are(lin.hosts[2].libdirs, lin.hosts[2].libdir_count, ?lin_a64[0], 6))                                     { ret 1; }
    if (!host_is(?lin.hosts[3], ?riscv.RISCV64, "/lib/ld-linux-riscv64-lp64d.so.1", 0x400000, 0x1000, 0))               { ret 1; }
    if (!dirs_are(lin.hosts[3].libdirs, lin.hosts[3].libdir_count, ?lin_r64[0], 6))                                     { ret 1; }
    if (!host_is(?lin.hosts[4], ?riscv.RISCV32, "/lib/ld-linux-riscv32-ilp32d.so.1", 0x400000, 0x1000, 0))              { ret 1; }
    if (!dirs_are(lin.hosts[4].libdirs, lin.hosts[4].libdir_count, ?lin_r32[0], 6))                                     { ret 1; }

    val dar:      *Os    = ?darwin.DARWIN;
    val dar_dirs: [2]str = [2]str{"/usr/lib", "/usr/local/lib"};
    if (!str_equals(dar.name, "darwin") || !str_equals(dar.entry, "start") || !dar.mapped)                       { ret 1; }
    if (dar.code_count != 1 || dar.codes[0].format != ?format.MACHO || dar.codes[0].value != 1)                  { ret 1; }
    if (dar.format_count != 1 || dar.formats[0] != ?format.MACHO)                                                { ret 1; }
    if (dar.library_count != 1 || !str_equals(dar.libraries[0], "/usr/lib/libSystem.B.dylib"))                   { ret 1; }
    if (dar.framework_dir_count != 1 || !str_equals(dar.framework_dirs[0], "/System/Library/Frameworks"))        { ret 1; }
    if (dar.min_version.major != 11 || dar.min_version.minor != 0 || dar.min_version.patch != 0)                 { ret 1; }
    if (dar.host_count != 2)                                                                                     { ret 1; }
    if (!host_is(?dar.hosts[0], ?x86.X86_64, nil, 0x100000000, 0x1000, 0))                                       { ret 1; }
    if (!dirs_are(dar.hosts[0].libdirs, dar.hosts[0].libdir_count, ?dar_dirs[0], 2))                             { ret 1; }
    if (!host_is(?dar.hosts[1], ?aarch64.AARCH64, nil, 0x100000000, 0x4000, os.PIE_DEFAULT | os.DIT_GUARANTEED)) { ret 1; }
    if (!dirs_are(dar.hosts[1].libdirs, dar.hosts[1].libdir_count, ?dar_dirs[0], 2))                             { ret 1; }

    val win:      *Os    = ?windows.WINDOWS;
    val win_dirs: [1]str = [1]str{"C:\\Windows\\System32"};
    if (!str_equals(win.name, "windows") || !str_equals(win.entry, "mainCRTStartup") || !win.mapped) { ret 1; }
    if (win.code_count != 1 || win.codes[0].format != ?format.COFF || win.codes[0].value != 3)       { ret 1; }
    if (win.format_count != 1 || win.formats[0] != ?format.COFF)                                     { ret 1; }
    if (win.library_count != 1 || !str_equals(win.libraries[0], "kernel32.dll"))                     { ret 1; }
    if (win.framework_dir_count != 0 || win.min_version.major != 0)                                  { ret 1; }
    if (win.host_count != 2)                                                                         { ret 1; }
    if (!host_is(?win.hosts[0], ?x86.X86_64, nil, 0x140000000, 0x1000, os.PIE_DEFAULT))              { ret 1; }
    if (!dirs_are(win.hosts[0].libdirs, win.hosts[0].libdir_count, ?win_dirs[0], 1))                 { ret 1; }
    if (!host_is(?win.hosts[1], ?aarch64.AARCH64, nil, 0x140000000, 0x1000, 0))                      { ret 1; }
    if (!dirs_are(win.hosts[1].libdirs, win.hosts[1].libdir_count, ?win_dirs[0], 1))                 { ret 1; }

    val fs: *Os = ?freestanding.FREESTANDING;
    if (!str_equals(fs.name, "freestanding") || !str_equals(fs.entry, "_start") || fs.mapped)                        { ret 1; }
    if (fs.code_count != 0 || fs.format_count != 2 || fs.formats[0] != ?format.ELF || fs.formats[1] != ?format.FLAT) { ret 1; }
    if (fs.library_count != 0 || fs.framework_dir_count != 0)                                                        { ret 1; }
    if (fs.host_count != 4)                                                                                          { ret 1; }
    if (!host_is(?fs.hosts[0], ?x86.X86_64, nil, 0, 0, 0))                                                           { ret 1; }
    if (!host_is(?fs.hosts[1], ?aarch64.AARCH64, nil, 0, 0, 0))                                                      { ret 1; }
    if (!host_is(?fs.hosts[2], ?riscv.RISCV64, nil, 0, 0, 0))                                                        { ret 1; }
    if (!host_is(?fs.hosts[3], ?riscv.RISCV32, nil, 0, 0, 0))                                                        { ret 1; }

    val wasi: *Os = ?wasi.WASI;
    if (!str_equals(wasi.name, "wasi") || !str_equals(wasi.entry, "_start") || wasi.mapped)  { ret 1; }
    if (wasi.code_count != 0 || wasi.format_count != 1 || wasi.formats[0] != ?format.WASM)   { ret 1; }
    if (wasi.library_count != 1 || !str_equals(wasi.libraries[0], "wasi_snapshot_preview1")) { ret 1; }
    if (wasi.host_count != 1 || !host_is(?wasi.hosts[0], ?wasm.WASM32, nil, 0, 0x1_0000, 0)) { ret 1; }

    val vk: *Os = ?spirv.VULKAN;
    if (!str_equals(vk.name, "vulkan") || vk.entry != nil || vk.mapped)                                         { ret 1; }
    if (vk.code_count != 0 || vk.format_count != 1 || vk.formats[0] != ?format.SPIRV)                           { ret 1; }
    if (vk.library_count != 0 || vk.host_count != 1 || !host_is(?vk.hosts[0], ?arch_spirv.SPIRV, nil, 0, 0, 0)) { ret 1; }

    val cl: *Os = ?spirv.OPENCL;
    if (!str_equals(cl.name, "opencl") || cl.entry != nil || cl.mapped)                                         { ret 1; }
    if (cl.code_count != 0 || cl.format_count != 1 || cl.formats[0] != ?format.SPIRV)                           { ret 1; }
    if (cl.library_count != 0 || cl.host_count != 1 || !host_is(?cl.hosts[0], ?arch_spirv.SPIRV, nil, 0, 0, 0)) { ret 1; }
    ret 0;
}

val DUPLICATE_NAMES: [2]*Os = [2]*Os{?linux.LINUX, ?linux.LINUX};

test os__name_index_finds_rows_and_refuses_a_duplicate {
    val rows:  [ROW_COUNT]*Os = ROWS;
    val built: err[Fail]      = index.verify[Os](?NAMES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_names);
    if (sel built.err) { ret 1; }
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val r: res[*Os, Fail] = by_name(ROWS[i].name);
        if (sel r.err)       { ret 1; }
        if (r.ok != ROWS[i]) { ret 1; }
        i = i + 1;
    }
    val miss: res[*Os, Fail] = by_name("plan9");
    if (sel miss.ok) { ret 1; }
    val bad: err[Fail] = index.verify[Os](?DUPLICATE_NAMES[0], 2, ?rows[0], 2, order_names);
    if (sel bad.ok) { ret 1; }
    ret 0;
}
