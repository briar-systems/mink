# darwin, the Mach-O system of macOS

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os;
use mink.catalog.os.Code;
use mink.catalog.os.Default;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Host;
use mink.catalog.os.Named;
use mink.catalog.os.Naming;
use mink.catalog.os.Pattern;
use mink.catalog.os.Placement;
use mink.catalog.os.Signed;
use mink.catalog.os.Signing;
use mink.catalog.os.Since;
use mink.catalog.os.System;
use mink.catalog.os.Version;
use mink.catalog.output;

val DARWIN_FORMAT_COUNT: usize                        = 1;
val DARWIN_FORMATS:      [DARWIN_FORMAT_COUNT]*Format = [DARWIN_FORMAT_COUNT]*Format{?format.MACHO};

# macos: PLATFORM_MACOS in LC_BUILD_VERSION
val MACOS_CODES: [1]Code = [1]Code{Code{format: ?format.MACHO, value: 1}};

pub val MACOS: Env = Env{system: ?DARWIN, name: "macos", codes: ?MACOS_CODES[0], code_count: 1};

val DARWIN_LIBDIR_COUNT:  usize                     = 2;
val DARWIN_LIBDIRS:       [DARWIN_LIBDIR_COUNT]str  = [DARWIN_LIBDIR_COUNT]str{"/usr/lib", "/usr/local/lib"};
val DARWIN_LIBRARY_COUNT: usize                     = 1;
val DARWIN_LIBRARIES:     [DARWIN_LIBRARY_COUNT]str = [DARWIN_LIBRARY_COUNT]str{"/usr/lib/libSystem.B.dylib"};
val DARWIN_SDK_DIR_COUNT: usize                     = 1;
val DARWIN_SDK_DIRS:      [DARWIN_SDK_DIR_COUNT]str = [DARWIN_SDK_DIR_COUNT]str{"/System/Library/Frameworks"};
# ld64 looks in each directory for the text stub, the dylib, then the
# archive, and in a framework's bundle for its text stub before its dylib
val DARWIN_FILES:   [3]Pattern = [3]Pattern{Pattern{prefix: "lib", suffix: ".tbd", loaded: true}, Pattern{prefix: "lib", suffix: ".dylib", loaded: true}, Pattern{prefix: "lib", suffix: ".a", loaded: false}};
val DARWIN_BUNDLES: [2]Pattern = [2]Pattern{Pattern{prefix: "", suffix: ".tbd", loaded: true}, Pattern{prefix: "", suffix: "", loaded: true}};
val DARWIN_NAMING:  Naming     = Naming{files: ?DARWIN_FILES[0], file_count: 3, bundle: ".framework", bundles: ?DARWIN_BUNDLES[0], bundle_count: 2};
val DARWIN_ENTRIES: [1]Entry   = [1]Entry{Entry{caps: output.ENTERED, symbol: "start"}};
# ld64 binds through chained fixups by default from macOS 12
val DARWIN_SINCE: [1]Since = [1]Since{Since{cap: os.CHAINED_FIXUPS, from: Version{major: 12, minor: 0, patch: 0}}};
# dyld's accessor of thread-local variables
val DARWIN_SYMBOLS: [1]Named = [1]Named{Named{role: ?os.TLV_BOOTSTRAP, name: "__tlv_bootstrap"}};

# dyld runs an x86_64 executable without MH_PIE unslid, while an arm64
# executable is always position independent
val DARWIN_X86_64_PLACEMENT:  Placement = Placement.linked{"dyld runs an x86_64 MH_EXECUTE without MH_PIE unslid, at its segments' vmaddr"};
val DARWIN_AARCH64_PLACEMENT: Placement = Placement.relocated{"dyld slides every arm64 MH_EXECUTE, and ld64 ignores -no_pie for arm64"};

# the kernel kills an arm64 process whose code carries no signature, so ld64
# signs every arm64 image ad hoc, and an x86_64 one only when asked. both hash
# 4 KiB pages
val DARWIN_SIGNED_PAGE:     u64     = 0x1000;
val DARWIN_X86_64_SIGNING:  Signing = Signing.optional{Signed{page: DARWIN_SIGNED_PAGE}};
val DARWIN_AARCH64_SIGNING: Signing = Signing.required{Signed{page: DARWIN_SIGNED_PAGE}};

# both hosts are loaded by dyld and declare macOS 11.0 the oldest they run on.
# the aarch64 host declares position independent executables and PSTATE.DIT;
# x86_64 declares neither. macOS 11 runs on Macs from the Ivy Bridge Mac Pro
# (late 2013) on and under Rosetta, which translates up to avx2, so x86_64
# holds x86-64-v2. aarch64 runs on the M1 and later, whose set llvm's
# apple-a14 states: armv8.4-a with the armv8.5-a features but bti
val DARWIN_HOST_COUNT: usize                   = 2;
val DARWIN_HOSTS:      [DARWIN_HOST_COUNT]Host = [DARWIN_HOST_COUNT]Host{
    Host{system: ?DARWIN, env: opt[*Env].some{?MACOS}, arch: ?x86.X86_64, interpreter: "/usr/lib/dyld", libdirs: ?DARWIN_LIBDIRS[0], libdir_count: DARWIN_LIBDIR_COUNT, sdk_dirs: ?DARWIN_SDK_DIRS[0], sdk_dir_count: DARWIN_SDK_DIR_COUNT, naming: opt[*Naming].some{?DARWIN_NAMING}, image_base: 0x100000000, page: 0x1000, caps: 0, entries: ?DARWIN_ENTRIES[0], entry_count: 1, libraries: ?DARWIN_LIBRARIES[0], library_count: DARWIN_LIBRARY_COUNT, minos: opt[Version].some{Version{major: 11, minor: 0, patch: 0}}, since: ?DARWIN_SINCE[0], since_count: 1, symbols: ?DARWIN_SYMBOLS[0], symbol_count: 1, abi: Default.row{?x86.X86_64_SYSV64}, placement: DARWIN_X86_64_PLACEMENT, signing: DARWIN_X86_64_SIGNING, floor: opt[str].some{"x86-64-v2"}},
    Host{system: ?DARWIN, env: opt[*Env].some{?MACOS}, arch: ?aarch64.AARCH64, interpreter: "/usr/lib/dyld", libdirs: ?DARWIN_LIBDIRS[0], libdir_count: DARWIN_LIBDIR_COUNT, sdk_dirs: ?DARWIN_SDK_DIRS[0], sdk_dir_count: DARWIN_SDK_DIR_COUNT, naming: opt[*Naming].some{?DARWIN_NAMING}, image_base: 0x100000000, page: 0x4000, caps: os.PIE_DEFAULT | os.DIT_GUARANTEED, entries: ?DARWIN_ENTRIES[0], entry_count: 1, libraries: ?DARWIN_LIBRARIES[0], library_count: DARWIN_LIBRARY_COUNT, minos: opt[Version].some{Version{major: 11, minor: 0, patch: 0}}, since: ?DARWIN_SINCE[0], since_count: 1, symbols: ?DARWIN_SYMBOLS[0], symbol_count: 1, abi: Default.row{?aarch64.AARCH64_DARWINPCS}, placement: DARWIN_AARCH64_PLACEMENT, signing: DARWIN_AARCH64_SIGNING, floor: opt[str].some{"armv8.4-a+fp+simd+aes+sha2+sha3+fp16+fp16fml+altnzcv+fptoint+specrestrict+ssbs+sb+predres+ccdp"}},
};

pub val DARWIN: System = System{
    name:         "darwin",
    mapped:       true,
    formats:      ?DARWIN_FORMATS[0],
    format_count: DARWIN_FORMAT_COUNT,
    hosts:        ?DARWIN_HOSTS[0],
    host_count:   DARWIN_HOST_COUNT,
};
