# darwin, the Mach-O system of macOS

use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Code;
use mink.catalog.format.Format;
use mink.catalog.os;
use mink.catalog.os.Host;
use mink.catalog.os.Os;
use mink.catalog.os.Version;

# darwin: PLATFORM_MACOS in LC_BUILD_VERSION, and the minimum macOS 11.0
val DARWIN_CODE_COUNT:          usize                           = 1;
val DARWIN_CODES:               [DARWIN_CODE_COUNT]Code         = [DARWIN_CODE_COUNT]Code{Code{format: ?format.MACHO, value: 1}};
val DARWIN_FORMAT_COUNT:        usize                           = 1;
val DARWIN_FORMATS:             [DARWIN_FORMAT_COUNT]*Format    = [DARWIN_FORMAT_COUNT]*Format{?format.MACHO};
val DARWIN_LIBDIR_COUNT:        usize                           = 2;
val DARWIN_LIBDIRS:             [DARWIN_LIBDIR_COUNT]str        = [DARWIN_LIBDIR_COUNT]str{"/usr/lib", "/usr/local/lib"};
val DARWIN_LIBRARY_COUNT:       usize                           = 1;
val DARWIN_LIBRARIES:           [DARWIN_LIBRARY_COUNT]str       = [DARWIN_LIBRARY_COUNT]str{"/usr/lib/libSystem.B.dylib"};
val DARWIN_FRAMEWORK_DIR_COUNT: usize                           = 1;
val DARWIN_FRAMEWORK_DIRS:      [DARWIN_FRAMEWORK_DIR_COUNT]str = [DARWIN_FRAMEWORK_DIR_COUNT]str{"/System/Library/Frameworks"};

# the aarch64 host declares position independent executables and PSTATE.DIT; x86_64 declares neither
val DARWIN_HOST_COUNT: usize                   = 2;
val DARWIN_HOSTS:      [DARWIN_HOST_COUNT]Host = [DARWIN_HOST_COUNT]Host{
    Host{arch: ?x86.X86_64, interpreter: nil, libdirs: ?DARWIN_LIBDIRS[0], libdir_count: DARWIN_LIBDIR_COUNT, image_base: 0x100000000, page_size: 0x1000, caps: 0},
    Host{arch: ?aarch64.AARCH64, interpreter: nil, libdirs: ?DARWIN_LIBDIRS[0], libdir_count: DARWIN_LIBDIR_COUNT, image_base: 0x100000000, page_size: 0x4000, caps: os.PIE_DEFAULT | os.DIT_GUARANTEED},
};

pub val DARWIN: Os = Os{
    name:                "darwin",
    codes:               ?DARWIN_CODES[0],
    code_count:          DARWIN_CODE_COUNT,
    hosts:               ?DARWIN_HOSTS[0],
    host_count:          DARWIN_HOST_COUNT,
    entry:               "start",
    mapped:              true,
    formats:             ?DARWIN_FORMATS[0],
    format_count:        DARWIN_FORMAT_COUNT,
    libraries:           ?DARWIN_LIBRARIES[0],
    library_count:       DARWIN_LIBRARY_COUNT,
    framework_dirs:      ?DARWIN_FRAMEWORK_DIRS[0],
    framework_dir_count: DARWIN_FRAMEWORK_DIR_COUNT,
    min_version:         Version{major: 11, minor: 0, patch: 0},
};
