# darwin, the Mach-O system of macOS

use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os;
use mink.catalog.os.Code;
use mink.catalog.os.Entry;
use mink.catalog.os.Env;
use mink.catalog.os.Host;
use mink.catalog.os.Named;
use mink.catalog.os.Since;
use mink.catalog.os.System;
use mink.catalog.os.Version;
use mink.catalog.output;

val DARWIN_FORMAT_COUNT: usize                        = 1;
val DARWIN_FORMATS:      [DARWIN_FORMAT_COUNT]*Format = [DARWIN_FORMAT_COUNT]*Format{?format.MACHO};

# macos: PLATFORM_MACOS in LC_BUILD_VERSION
val MACOS_CODES: [1]Code = [1]Code{Code{format: ?format.MACHO, value: 1}};

pub val MACOS: Env = Env{system: ?DARWIN, name: "macos", codes: ?MACOS_CODES[0], code_count: 1};

val DARWIN_LIBDIR_COUNT:  usize                     = 2;
val DARWIN_LIBDIRS:       [DARWIN_LIBDIR_COUNT]str  = [DARWIN_LIBDIR_COUNT]str{"/usr/lib", "/usr/local/lib"};
val DARWIN_LIBRARY_COUNT: usize                     = 1;
val DARWIN_LIBRARIES:     [DARWIN_LIBRARY_COUNT]str = [DARWIN_LIBRARY_COUNT]str{"/usr/lib/libSystem.B.dylib"};
val DARWIN_SDK_DIR_COUNT: usize                     = 1;
val DARWIN_SDK_DIRS:      [DARWIN_SDK_DIR_COUNT]str = [DARWIN_SDK_DIR_COUNT]str{"/System/Library/Frameworks"};
val DARWIN_ENTRIES:       [1]Entry                  = [1]Entry{Entry{caps: output.ENTERED, symbol: "start"}};
# ld64 binds through chained fixups by default from macOS 12
val DARWIN_SINCE: [1]Since = [1]Since{Since{cap: os.CHAINED_FIXUPS, from: Version{major: 12, minor: 0, patch: 0}}};
# dyld's accessor of thread-local variables
val DARWIN_SYMBOLS: [1]Named = [1]Named{Named{role: ?os.TLV_BOOTSTRAP, name: "__tlv_bootstrap"}};

# both hosts are loaded by dyld and declare macOS 11.0 the oldest they run on.
# the aarch64 host declares position independent executables and PSTATE.DIT;
# x86_64 declares neither
val DARWIN_HOST_COUNT: usize                   = 2;
val DARWIN_HOSTS:      [DARWIN_HOST_COUNT]Host = [DARWIN_HOST_COUNT]Host{
    Host{system: ?DARWIN, env: opt[*Env].some{?MACOS}, arch: ?x86.X86_64, interpreter: "/usr/lib/dyld", libdirs: ?DARWIN_LIBDIRS[0], libdir_count: DARWIN_LIBDIR_COUNT, sdk_dirs: ?DARWIN_SDK_DIRS[0], sdk_dir_count: DARWIN_SDK_DIR_COUNT, image_base: 0x100000000, page: 0x1000, caps: 0, entries: ?DARWIN_ENTRIES[0], entry_count: 1, libraries: ?DARWIN_LIBRARIES[0], library_count: DARWIN_LIBRARY_COUNT, minos: opt[Version].some{Version{major: 11, minor: 0, patch: 0}}, since: ?DARWIN_SINCE[0], since_count: 1, symbols: ?DARWIN_SYMBOLS[0], symbol_count: 1},
    Host{system: ?DARWIN, env: opt[*Env].some{?MACOS}, arch: ?aarch64.AARCH64, interpreter: "/usr/lib/dyld", libdirs: ?DARWIN_LIBDIRS[0], libdir_count: DARWIN_LIBDIR_COUNT, sdk_dirs: ?DARWIN_SDK_DIRS[0], sdk_dir_count: DARWIN_SDK_DIR_COUNT, image_base: 0x100000000, page: 0x4000, caps: os.PIE_DEFAULT | os.DIT_GUARANTEED, entries: ?DARWIN_ENTRIES[0], entry_count: 1, libraries: ?DARWIN_LIBRARIES[0], library_count: DARWIN_LIBRARY_COUNT, minos: opt[Version].some{Version{major: 11, minor: 0, patch: 0}}, since: ?DARWIN_SINCE[0], since_count: 1, symbols: ?DARWIN_SYMBOLS[0], symbol_count: 1},
};

pub val DARWIN: System = System{
    name:         "darwin",
    mapped:       true,
    formats:      ?DARWIN_FORMATS[0],
    format_count: DARWIN_FORMAT_COUNT,
    hosts:        ?DARWIN_HOSTS[0],
    host_count:   DARWIN_HOST_COUNT,
};
