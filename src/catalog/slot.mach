# the entries the linker makes per target, and the templates that fill them
#
# a slot role is what one linker-made entry is to the target it serves: a GOT
# slot, a PLT entry, a pair of thread-local slots, an import address, a stub,
# a table element or a branch island. a relocation kind names the role it
# reaches, a table declares the roles of its entries, and a relocation reads
# the address of its target's entry of a role from the anchors its link
# publishes, indexed by the role's stated index. a role joins by adding a row
# with the next index. a template role is what a code template is to the
# linker, the key its rows are found by.

use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;

# what a code template is to the linker, the key it is found by
pub rec Role {
    name: str;
}

# the first entry of a PLT, which the other entries jump to while unbound
pub val PLT_HEADER: Role = Role{name: "plt header"};
# one PLT entry, a jump through its GOT slot
pub val PLT_ENTRY: Role = Role{name: "plt entry"};
# one PLT entry of an IFUNC, a jump through a slot its resolver fills
pub val IPLT_ENTRY: Role = Role{name: "iplt entry"};
# the slots that head the GOT of the PLT, reserved for the loader
pub val GOT_PLT_HEADER: Role = Role{name: "got.plt header"};
# one GOT slot of a PLT entry, as written before the loader binds it
pub val GOT_PLT_SLOT: Role = Role{name: "got.plt slot"};
# a stub that reaches an imported function
pub val STUB_CODE: Role = Role{name: "stub"};
# a veneer that extends a branch past its range
pub val VENEER: Role = Role{name: "veneer"};
# a thunk that adjusts a call on its way to its destination
pub val THUNK: Role = Role{name: "thunk"};

# how a reference reaches an entry of the role
# ---
# loaded: it loads the target's address or value from the entry, as through
#         a GOT slot
# called: it branches to the entry, as to a PLT entry or a stub
# held:   the entry holds the target itself or what stands for it, as a copy
#         or a table element does
pub tag Reach: u8 {
    loaded;
    called;
    held;
}

# name:       the role's spelling in a diagnostic
# at:         its index among the roles, where a relocation's anchors hold the
#             address of its target's entry of the role
# per_target: how many consecutive entries one target takes
# reach:      how a reference reaches an entry
# template:   the template that fills an entry, none for an entry the link
#             writes as data
pub rec SlotRole {
    name:       str;
    at:         u8;
    per_target: u8;
    reach:      Reach;
    template:   opt[*Role];
}

pub val GOT:     SlotRole = SlotRole{name: "got", at: 0, per_target: 1, reach: Reach.loaded{}};
pub val GOT_PLT: SlotRole = SlotRole{name: "got.plt", at: 1, per_target: 1, reach: Reach.loaded{}, template: opt[*Role].some{?GOT_PLT_SLOT}};
pub val PLT:     SlotRole = SlotRole{name: "plt", at: 2, per_target: 1, reach: Reach.called{}, template: opt[*Role].some{?PLT_ENTRY}};
pub val IPLT:    SlotRole = SlotRole{name: "iplt", at: 3, per_target: 1, reach: Reach.called{}, template: opt[*Role].some{?IPLT_ENTRY}};
# the module and offset slots of a general dynamic access
pub val TLS_GD: SlotRole = SlotRole{name: "tls gd", at: 4, per_target: 2, reach: Reach.loaded{}};
# the module slot and its unused offset of a local dynamic access
pub val TLS_LD: SlotRole = SlotRole{name: "tls ld", at: 5, per_target: 2, reach: Reach.loaded{}};
# the thread pointer offset of an initial exec access
pub val TLS_IE: SlotRole = SlotRole{name: "tls ie", at: 6, per_target: 1, reach: Reach.loaded{}};
# the resolver and argument of a thread-local descriptor
pub val TLSDESC: SlotRole = SlotRole{name: "tlsdesc", at: 7, per_target: 2, reach: Reach.loaded{}};
# a GOT slot holding a signed pointer
pub val AUTH_GOT: SlotRole = SlotRole{name: "auth got", at: 8, per_target: 1, reach: Reach.loaded{}};
# an import address the loader fills
pub val IAT: SlotRole = SlotRole{name: "iat", at: 9, per_target: 1, reach: Reach.loaded{}};
# an import address filled on first call
pub val DELAY_IAT: SlotRole = SlotRole{name: "delay iat", at: 10, per_target: 1, reach: Reach.loaded{}};
pub val STUB:      SlotRole = SlotRole{name: "stub", at: 11, per_target: 1, reach: Reach.called{}, template: opt[*Role].some{?STUB_CODE}};
# the pointer a lazy stub loads, bound on first call
pub val LAZY_PTR: SlotRole = SlotRole{name: "lazy pointer", at: 12, per_target: 1, reach: Reach.loaded{}};
# a thread-local variable descriptor
pub val TLV: SlotRole = SlotRole{name: "tlv", at: 13, per_target: 1, reach: Reach.held{}};
# an element of a wasm function table
pub val WASM_TABLE: SlotRole = SlotRole{name: "wasm table", at: 14, per_target: 1, reach: Reach.held{}};
# a branch island a far call goes through
pub val ISLAND: SlotRole = SlotRole{name: "island", at: 15, per_target: 1, reach: Reach.called{}, template: opt[*Role].some{?VENEER}};
# the image's copy of a library's data
pub val COPY: SlotRole = SlotRole{name: "copy", at: 16, per_target: 1, reach: Reach.held{}};

pub val SLOT_ROLES: usize = 17;

# the roles by their stated index
val ROLES: [SLOT_ROLES]*SlotRole = [SLOT_ROLES]*SlotRole{
    ?GOT, ?GOT_PLT, ?PLT, ?IPLT, ?TLS_GD, ?TLS_LD, ?TLS_IE, ?TLSDESC, ?AUTH_GOT, ?IAT, ?DELAY_IAT, ?STUB,
    ?LAZY_PTR, ?TLV, ?WASM_TABLE, ?ISLAND, ?COPY,
};

pub fun at(index: usize) *SlotRole {
    ret ROLES[index];
}

# refuse a role whose stated index is not where the table holds it or that
# takes no entry, a defect of mink
pub fun check() err[Fail] {
    var i: usize = 0;
    for (i < SLOT_ROLES) {
        val r: *SlotRole = ROLES[i];
        if (r.at::usize != i)  { ret err[Fail].err{fail.about(fail.internal("a slot role's index is not where the roles hold it"), r.name)}; }
        if (r.per_target == 0) { ret err[Fail].err{fail.about(fail.internal("a slot role takes no entry"), r.name)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

test slot__every_role_sits_at_its_stated_index {
    val e: err[Fail] = check();
    if (sel e.err)                                                { ret 1; }
    if (at(PLT.at::usize) != ?PLT || at(COPY.at::usize) != ?COPY) { ret 2; }
    ret 0;
}
