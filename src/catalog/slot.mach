# the entries the linker makes per target, and the templates that fill them
#
# a slot role is what one linker-made entry is to the target it serves: a GOT
# slot, a PLT entry, a pair of thread-local slots, an import address, a stub,
# a table element or a branch island. a relocation kind names the role it
# reaches, a table declares the roles of its entries, and a relocation reads
# the address of its target's entry of a role from the anchors its link
# publishes, indexed by the role's stated index. a role joins by adding a row
# with the next index. a template role is what a code template is to the
# linker, the key its rows are found by.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

# what a code template is to the linker, the key it is found by
pub rec Role {
    name: str;
}

# the first entry of a PLT, which the other entries jump to while unbound
pub val PLT_HEADER: Role = Role{name: "plt header"};
# one PLT entry, a jump through its GOT slot
pub val PLT_ENTRY: Role = Role{name: "plt entry"};
# the lazy path of one PLT entry laid apart from its jump, where its GOT slot
# leads until the loader binds it, which names its relocation and jumps to
# the PLT header
pub val PLT_LAZY_ENTRY: Role = Role{name: "plt lazy entry"};
# the slots that head the GOT of the PLT, reserved for the loader
pub val GOT_PLT_HEADER: Role = Role{name: "got.plt header"};
# one GOT slot of a PLT entry, as written before the loader binds it
pub val GOT_PLT_SLOT: Role = Role{name: "got.plt slot"};
# a stub that reaches an imported function
pub val STUB_CODE: Role = Role{name: "stub"};
# a veneer that extends a branch past its range
pub val VENEER: Role = Role{name: "veneer"};
# a landing pad a veneer's indirect branch reaches its destination through,
# which marks itself a target of that branch and branches on directly, as a
# destination that marks itself none needs under AArch64 BTI
pub val LANDING_PAD: Role = Role{name: "landing pad"};
# a thunk a call goes through on its way to its destination, as a call to an
# import jumps through the import's address
pub val THUNK: Role = Role{name: "thunk"};
# the code that heads a stub helper, which passes the loader's cache cell to
# the routine that binds a lazy pointer and jumps to it
pub val STUB_HELPER_HEAD: Role = Role{name: "stub helper head"};
# one entry of a stub helper, where a lazy pointer leads until it is bound,
# which names where its binding lies and jumps to the head
pub val STUB_HELPER_ENTRY: Role = Role{name: "stub helper entry"};
# a thunk a native caller reaches an import through, which jumps through the
# import's auxiliary address, as an ARM64EC `#` import symbol names
pub val NATIVE_THUNK_CODE: Role = Role{name: "native import thunk"};
# the code an import's auxiliary address leads to until the loader binds it
# to native code, which asks the emulator for a callable form of what the
# import's address holds and goes there, leaving through the callee's exit
# thunk where it is emulated ("auxiliary IAT", ARM64EC ABI)
pub val IMPORT_CHECK_CODE: Role = Role{name: "import check"};
# the x64 code an emulated caller enters a native function an image exports
# or starts at through, which the emulator steps over to the native code
# its jump reaches ("fast-forward sequences", understanding Arm64EC ABI and
# assembly code)
pub val FAST_FORWARD: Role = Role{name: "fast-forward sequence"};

# how a reference reaches an entry of the role
# ---
# loaded: it loads the target's address or value from the entry, as through
#         a GOT slot
# called: it branches to the entry, as to a PLT entry or a stub
# held:   the entry holds the target itself or what stands for it, as a copy
#         or a table element does
pub tag Reach: u8 {
    loaded;
    called;
    held;
}

# name:       the role's spelling in a diagnostic
# at:         its index among the roles, where a relocation's anchors hold the
#             address of its target's entry of the role
# per_target: how many consecutive entries one target takes
# reach:      how a reference reaches an entry
# template:   the template that fills an entry, none for an entry the link
#             writes as data
# whole:      one entry serves every reference of the image whatever its
#             target, as the module slot of a local dynamic access stands for
#             the image's whole thread-local block
# mirrors:    the role whose entries a reference that lands in this role
#             takes, this role's table lying slot for slot beside that
#             role's, as an ARM64EC auxiliary import address mirrors the
#             import address of the same import. none for a role with
#             entries of its own
pub rec SlotRole {
    name:       str;
    at:         u8;
    per_target: u8;
    reach:      Reach;
    template:   opt[*Role];
    whole:      bool;
    mirrors:    opt[*SlotRole];
}

pub val GOT:     SlotRole = SlotRole{name: "got", at: 0, per_target: 1, reach: Reach.loaded{}};
pub val GOT_PLT: SlotRole = SlotRole{name: "got.plt", at: 1, per_target: 1, reach: Reach.loaded{}, template: opt[*Role].some{?GOT_PLT_SLOT}};
pub val PLT:     SlotRole = SlotRole{name: "plt", at: 2, per_target: 1, reach: Reach.called{}, template: opt[*Role].some{?PLT_ENTRY}};
# the module and offset slots of a general dynamic access
pub val TLS_GD: SlotRole = SlotRole{name: "tls gd", at: 3, per_target: 2, reach: Reach.loaded{}};
# the module slot of the image and its zero offset, which every local
# dynamic access of the image shares
pub val TLS_LD: SlotRole = SlotRole{name: "tls ld", at: 4, per_target: 2, reach: Reach.loaded{}, whole: true};
# the thread pointer offset of an initial exec access
pub val TLS_IE: SlotRole = SlotRole{name: "tls ie", at: 5, per_target: 1, reach: Reach.loaded{}};
# the resolver and argument of a thread-local descriptor
pub val TLSDESC: SlotRole = SlotRole{name: "tlsdesc", at: 6, per_target: 2, reach: Reach.loaded{}};
# a GOT slot holding a signed pointer
pub val AUTH_GOT: SlotRole = SlotRole{name: "auth got", at: 7, per_target: 1, reach: Reach.loaded{}};
# an import address the loader fills
pub val IAT: SlotRole = SlotRole{name: "iat", at: 8, per_target: 1, reach: Reach.loaded{}};
# an import address filled on first call
pub val DELAY_IAT: SlotRole = SlotRole{name: "delay iat", at: 9, per_target: 1, reach: Reach.loaded{}};
pub val STUB:      SlotRole = SlotRole{name: "stub", at: 10, per_target: 1, reach: Reach.called{}, template: opt[*Role].some{?STUB_CODE}};
# the pointer a lazy stub loads, bound on first call
pub val LAZY_PTR: SlotRole = SlotRole{name: "lazy pointer", at: 11, per_target: 1, reach: Reach.loaded{}};
# a thread-local variable descriptor, the accessor, key and offset words that
# stand for the variable
pub val TLV: SlotRole = SlotRole{name: "tlv", at: 12, per_target: 3, reach: Reach.held{}};
# a slot of a function table, the index an indirect call reaches its target by
pub val FUNCTION_TABLE: SlotRole = SlotRole{name: "function table", at: 13, per_target: 1, reach: Reach.held{}};
# a branch island a far call goes through
pub val ISLAND: SlotRole = SlotRole{name: "island", at: 14, per_target: 1, reach: Reach.called{}, template: opt[*Role].some{?VENEER}};
# the image's copy of a library's data
pub val COPY: SlotRole = SlotRole{name: "copy", at: 15, per_target: 1, reach: Reach.held{}};
# a thunk that jumps through an import's address
pub val IMPORT_THUNK: SlotRole = SlotRole{name: "import thunk", at: 16, per_target: 1, reach: Reach.called{}, template: opt[*Role].some{?THUNK}};
# the stub helper entry a lazy pointer holds until the loader binds it, one
# per lazy pointer
pub val STUB_HELPER: SlotRole = SlotRole{name: "stub helper", at: 17, per_target: 1, reach: Reach.called{}, template: opt[*Role].some{?STUB_HELPER_ENTRY}};
# the pointer a thread-local variable access loads its descriptor's address
# from
pub val TLV_PTR: SlotRole = SlotRole{name: "tlv pointer", at: 18, per_target: 1, reach: Reach.loaded{}};
# the lazy path of a PLT entry laid apart from the jump a call goes through,
# one per slot of the GOT of the PLT, where the slot leads until the loader
# binds it
pub val LAZY_PLT: SlotRole = SlotRole{name: "lazy plt", at: 19, per_target: 1, reach: Reach.called{}, template: opt[*Role].some{?PLT_LAZY_ENTRY}};

# an import's auxiliary address, which a native caller of an image holding
# code of two conventions loads its import from, slot for slot beside the
# import address table ("auxiliary IAT", ARM64EC ABI)
pub val AUX_IAT: SlotRole = SlotRole{name: "auxiliary iat", at: 20, per_target: 1, reach: Reach.loaded{}, mirrors: opt[*SlotRole].some{?IAT}};
# a thunk a native caller's call to an import goes through, which jumps
# through the import's auxiliary address
pub val NATIVE_IMPORT_THUNK: SlotRole = SlotRole{name: "native import thunk", at: 21, per_target: 1, reach: Reach.called{}, template: opt[*Role].some{?NATIVE_THUNK_CODE}};
# the import check an import's auxiliary address leads to until the loader
# binds it, one per import address
pub val IMPORT_CHECK: SlotRole = SlotRole{name: "import check", at: 22, per_target: 1, reach: Reach.called{}, template: opt[*Role].some{?IMPORT_CHECK_CODE}};

pub val SLOT_ROLES: usize = 23;

# the roles by their stated index
val ROLES: [SLOT_ROLES]*SlotRole = [SLOT_ROLES]*SlotRole{
    ?GOT, ?GOT_PLT, ?PLT, ?TLS_GD, ?TLS_LD, ?TLS_IE, ?TLSDESC, ?AUTH_GOT, ?IAT, ?DELAY_IAT, ?STUB,
    ?LAZY_PTR, ?TLV, ?FUNCTION_TABLE, ?ISLAND, ?COPY, ?IMPORT_THUNK, ?STUB_HELPER, ?TLV_PTR, ?LAZY_PLT,
    ?AUX_IAT, ?NATIVE_IMPORT_THUNK, ?IMPORT_CHECK,
};

pub fun at(index: usize) *SlotRole {
    ret ROLES[index];
}

# where a GOT-relative computation counts from, which the symbol naming the
# GOT takes: the start of the output section holding the table of `role`'s
# slots, laid even with no slot of the role once the base is read
# ---
# role:   the slot role whose table's output section starts the GOT
# source: the linker whose choice the row follows
pub rec GotBase {
    role:   *SlotRole;
    source: str;
}
