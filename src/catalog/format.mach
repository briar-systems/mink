# the identity of every format mink knows
#
# a format is named here once and everything that crosses formats, the codes
# an architecture or a system carries in each, refers to its row.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.fail;
use mink.fail.Fail;
use mink.index;

# name:      how the format is spelled on the command line and in a dump
# qualified: whether a code's qualifier takes part in telling rows apart, as
#            ELF's file class tells RV32 from RV64 under one machine number
# nameless:  the symbol reference the format writes for a relocation that
#            names no target, absent where the format has no such relocation
pub rec Format {
    name:      str;
    qualified: bool;
    nameless:  opt[u64];
}

pub val ELF:   Format = Format{name: "elf", qualified: true, nameless: opt[u64].some{0}};
pub val COFF:  Format = Format{name: "coff", qualified: false};
pub val MACHO: Format = Format{name: "macho", qualified: false};
pub val AR:    Format = Format{name: "ar", qualified: false};
pub val WASM:  Format = Format{name: "wasm", qualified: false};
pub val SPIRV: Format = Format{name: "spirv", qualified: false};
pub val FLAT:  Format = Format{name: "flat", qualified: false};

val ROW_COUNT: usize              = 7;
val ROWS:      [ROW_COUNT]*Format = [ROW_COUNT]*Format{?ELF, ?COFF, ?MACHO, ?AR, ?WASM, ?SPIRV, ?FLAT};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Format {
    ret ROWS[index];
}

# the rows ascending by name
val NAMES: [ROW_COUNT]*Format = [ROW_COUNT]*Format{?AR, ?COFF, ?ELF, ?FLAT, ?MACHO, ?SPIRV, ?WASM};

fun order_names(a: **Format, b: **Format) i64 {
    ret str_compare(a[0].name, b[0].name);
}

pub fun by_name(name: str) res[*Format, Fail] {
    var probe: Format       = Format{name: name};
    val row:   opt[*Format] = index.find[Format](?NAMES[0], ROW_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*Format, Fail].err{fail.unsupported("no format has this name")}; }
    ret res[*Format, Fail].ok{row.some};
}

# how a row names itself in one format: the format's own code for it, and a
# qualifier the format reads beside the code, such as ELF's EI_CLASS or a
# Mach-O cpu subtype. a row a format does not name has no code for it
pub rec Code {
    format:    *Format;
    value:     u32;
    qualifier: u32;
}

# whether `c` names what a format's (value, qualifier) pair names
pub fun matches(c: *Code, f: *Format, value: u32, qualifier: u32) bool {
    if (c.format != f || c.value != value) { ret false; }
    ret !f.qualified || c.qualifier == qualifier;
}

# the symbol reference `f` writes for a relocation that names no target
pub fun write_nameless(f: *Format) res[u64, Fail] {
    if (sel f.nameless.none) { ret res[u64, Fail].err{fail.unsupported("the format has no relocation without a target")}; }
    ret res[u64, Fail].ok{f.nameless.some};
}

# whether the symbol reference `ref` of a relocation read in `f` names no target
pub fun reads_nameless(f: *Format, ref: u64) bool {
    ret sel f.nameless.some && f.nameless.some == ref;
}

test format__only_elf_writes_a_relocation_without_a_target {
    val e: res[u64, Fail] = write_nameless(?ELF);
    if (sel e.err)                { ret 1; }
    if (e.ok != 0)                { ret 1; }
    if (!reads_nameless(?ELF, 0)) { ret 2; }
    if (reads_nameless(?ELF, 1))  { ret 3; }
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val f: *Format = ROWS[i];
        if (f != ?ELF) {
            val w: res[u64, Fail] = write_nameless(f);
            if (!sel w.err)           { ret 4; }
            if (reads_nameless(f, 0)) { ret 5; }
        }
        i = i + 1;
    }
    ret 0;
}

val DUPLICATE_NAMES: [2]*Format = [2]*Format{?ELF, ?ELF};

test format__name_index_finds_rows_and_refuses_a_duplicate {
    val rows:  [ROW_COUNT]*Format = ROWS;
    val built: err[Fail]          = index.verify[Format](?NAMES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_names);
    if (sel built.err) { ret 1; }
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val r: res[*Format, Fail] = by_name(ROWS[i].name);
        if (sel r.err)       { ret 1; }
        if (r.ok != ROWS[i]) { ret 1; }
        i = i + 1;
    }
    val miss: res[*Format, Fail] = by_name("a.out");
    if (sel miss.ok) { ret 1; }
    val bad: err[Fail] = index.verify[Format](?DUPLICATE_NAMES[0], 2, ?rows[0], 2, order_names);
    if (sel bad.ok) { ret 1; }
    ret 0;
}
