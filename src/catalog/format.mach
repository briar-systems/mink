# the identity of every format mink knows
#
# a format's identity is a leaf row, so the architecture and system catalogs
# can name the codes a format gives them without depending on the format's
# modules. a row holds the name and nothing else: what a format does is its
# registration, and the registry is the one list of the formats mink is built
# with.

use std.types.string.str;

# name: how the format is spelled on the command line and in a dump
pub rec Format {
    name: str;
}

pub val ELF:   Format = Format{name: "elf"};
pub val COFF:  Format = Format{name: "coff"};
pub val MACHO: Format = Format{name: "macho"};
pub val AR:    Format = Format{name: "ar"};
pub val WASM:  Format = Format{name: "wasm"};
pub val SPIRV: Format = Format{name: "spirv"};
pub val FLAT:  Format = Format{name: "flat"};
