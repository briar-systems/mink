# the identity of every format mink knows
#
# a format is named here once and everything that crosses formats, the codes
# an architecture or a system carries in each, refers to its row.

use std.types.error.err;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.fail;
use mink.fail.Fail;
use mink.index;
use mink.index.Entry;
use mink.index.Index;

# name:      how the format is spelled on the command line and in a dump
# qualified: whether a code's qualifier takes part in telling rows apart, as
#            ELF's file class tells RV32 from RV64 under one machine number
pub rec Format {
    name:      str;
    qualified: bool;
}

pub val ELF:   Format = Format{name: "elf", qualified: true};
pub val COFF:  Format = Format{name: "coff", qualified: false};
pub val MACHO: Format = Format{name: "macho", qualified: false};
pub val AR:    Format = Format{name: "ar", qualified: false};
pub val WASM:  Format = Format{name: "wasm", qualified: false};
pub val SPIRV: Format = Format{name: "spirv", qualified: false};
pub val FLAT:  Format = Format{name: "flat", qualified: false};

val ROW_COUNT: usize              = 7;
val ROWS:      [ROW_COUNT]*Format = [ROW_COUNT]*Format{?ELF, ?COFF, ?MACHO, ?AR, ?WASM, ?SPIRV, ?FLAT};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Format {
    ret ROWS[index];
}

# the rows by name, ascending, each entry naming a row by its position in ROWS
val NAME_ENTRIES: [ROW_COUNT]Entry = [ROW_COUNT]Entry{
    Entry{key: "ar", row: 3},
    Entry{key: "coff", row: 1},
    Entry{key: "elf", row: 0},
    Entry{key: "flat", row: 6},
    Entry{key: "macho", row: 2},
    Entry{key: "spirv", row: 5},
    Entry{key: "wasm", row: 4},
};
val NAMES: Index = Index{at: ?NAME_ENTRIES[0], len: ROW_COUNT::u32};

pub fun by_name(name: str) res[*Format, Fail] {
    val row: opt[u32] = index.find(?NAMES, name);
    if (sel row.none) { ret res[*Format, Fail].err{fail.unsupported("no format has this name")}; }
    ret res[*Format, Fail].ok{ROWS[row.some]};
}

# how a row names itself in one format: the format's own code for it, and a
# qualifier the format reads beside the code, such as ELF's EI_CLASS or a
# Mach-O cpu subtype. a row a format does not name has no code for it
pub rec Code {
    format:    *Format;
    value:     u32;
    qualifier: u32;
}

# whether `c` names what a format's (value, qualifier) pair names
pub fun matches(c: *Code, f: *Format, value: u32, qualifier: u32) bool {
    if (c.format != f || c.value != value) { ret false; }
    ret !f.qualified || c.qualifier == qualifier;
}

fun row_name(row: usize) str {
    ret ROWS[row].name;
}

val DUPLICATE_NAMES: [2]Entry = [2]Entry{Entry{key: "elf", row: 0}, Entry{key: "elf", row: 0}};

test format__name_index_finds_rows_and_refuses_a_duplicate {
    val built: err[Fail] = index.verify(?NAMES, ROW_COUNT, row_name);
    if (sel built.err) { ret 1; }
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val r: res[*Format, Fail] = by_name(ROWS[i].name);
        if (sel r.err) { ret 1; }
        if (r.ok != ROWS[i]) { ret 1; }
        i = i + 1;
    }
    val miss: res[*Format, Fail] = by_name("a.out");
    if (sel miss.ok) { ret 1; }
    val dup: Index     = Index{at: ?DUPLICATE_NAMES[0], len: 2};
    val bad: err[Fail] = index.verify(?dup, 2, row_name);
    if (sel bad.ok) { ret 1; }
    ret 0;
}
