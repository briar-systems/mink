# the trait catalog
#
# a trait is an ABI fact of an architecture that the producer of an object
# states and a link merges, such as a float ABI, compressed code or a branch
# protection feature. each axis is a row with the kind of value it takes and
# the rule its merge follows, and an axis of one of N values lists a row for
# each value. an architecture row lists the axes it has, and each format
# encodes them through its own table keyed by these rows. an axis's name is
# its key, unique across the catalog, and a set of traits is kept in the order
# of its axes' names. an axis an object does not state is absent, never a
# default.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;

use A: std.allocator;

use mink.catalog.isa;
use mink.catalog.isa.Grammar;
use mink.fail;
use mink.fail.Fail;
use mink.store.Bytes;
use mink.store.Held;
use mink.store.Span;
use mink.table;
use mink.table.Table;

# the kind of value an axis takes
# ---
# choice: one of the axis's choices
# flag:   set or clear
# number: an unsigned number
# text:   a string of bytes
pub tag Value: u8 {
    choice;
    flag;
    number;
    text;
}

# how a link combines what its inputs state on an axis
# ---
# equal:        every input states the same value, or the link is refused
# union:        a flag is set when any input sets it
# intersection: a flag is set only when every input that states it sets it
# first:        the first input's value is kept and later ones are not compared
# extensions:   ISA strings of the grammar merge into every extension either
#               names at the higher version, and strings of different
#               register widths are refused
pub tag Merge: u8 {
    equal;
    union;
    intersection;
    first;
    extensions: *Grammar;
}

# a value of an axis of one of N
pub rec Choice {
    name: str;
}

# name:    the axis's spelling
# value:   the kind of value it takes
# merge:   how a link combines its inputs' values
# choices: the values of an axis of one of N, none for the rest
# count:   how many
pub rec Axis {
    name:    str;
    value:   Value;
    merge:   Merge;
    choices: **Choice;
    count:   usize;
}

# what is stated on an axis
# ---
# choice: one of the axis's choices
# flag:   whether a flag axis is set
# number: the number a number axis holds
# text:   the bytes a text axis holds, owned in the store of whoever holds
#         the trait or borrowed from an input that outlives it
pub tag Setting: u8 {
    choice: *Choice;
    flag:   bool;
    number: u64;
    text:   Held;
}

# one axis and what is stated on it
pub rec Trait {
    axis:    *Axis;
    setting: Setting;
}

# what merging the texts of an axis gives
# ---
# refused: the two cannot be linked together
# held:    the value already held stands
# written: a new value, at this place of the store the merge wrote to
pub tag Merged: u8 {
    refused;
    held;
    written: Span;
}

# whether `s` is a value of `x`: a choice it lists, or a setting of its kind
pub fun fits(x: *Axis, s: Setting) bool {
    if (sel s.flag)   { ret sel x.value.flag; }
    or (sel s.number) { ret sel x.value.number; }
    or (sel s.text)   { ret sel x.value.text; }
    var i: usize = 0;
    for (i < x.count) {
        if (x.choices[i] == s.choice) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether two settings are the same value. texts are the same only at the
# same place, as their bytes live with whoever holds them
pub fun same(a: Setting, b: Setting) bool {
    if (sel a.flag) {
        if (sel b.flag) { ret a.flag == b.flag; }
        ret false;
    }
    or (sel a.number) {
        if (sel b.number) { ret a.number == b.number; }
        ret false;
    }
    or (sel a.text) {
        if (sel b.text) { ret same_place(a.text, b.text); }
        ret false;
    }
    if (sel b.choice) { ret a.choice == b.choice; }
    ret false;
}

fun same_place(a: Held, b: Held) bool {
    if (sel a.owned) {
        if (sel b.owned) { ret a.owned.start == b.owned.start && a.owned.len == b.owned.len; }
        ret false;
    }
    if (sel b.borrowed) { ret a.borrowed.data == b.borrowed.data && a.borrowed.len == b.borrowed.len; }
    ret false;
}

# whether the bytes `a` and `b` are the same
pub fun same_bytes(a: Bytes, b: Bytes) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the order of two axes by name, the key every index of axes is sorted by
pub fun order(a: **Axis, b: **Axis) i64 {
    ret str_compare(a[0].name, b[0].name);
}

fun order_traits(a: *Trait, b: *Trait) i64 {
    ret str_compare(a.axis.name, b.axis.name);
}

# where `x` sits in `ts`, which is kept in the order of its axes' names
fun position(ts: *Table[Trait], x: *Axis) SearchPosition {
    var probe: Trait = Trait{axis: x};
    ret sort.binary_search_by[Trait](table.items[Trait](ts), table.count[Trait](ts), ?probe, order_traits);
}

# the trait `ts` states on `x`, none when it states none
pub fun find(ts: *Table[Trait], x: *Axis) opt[*Trait] {
    val at: SearchPosition = position(ts, x);
    if (sel at.found) {
        val t: *Trait = table.at[Trait](ts, table.nth[Trait](at.found));
        if (t.axis == x) { ret opt[*Trait].some{t}; }
    }
    ret opt[*Trait].none{};
}

# add `t` to `ts` in key order, refusing a setting its axis does not have and
# a second value for an axis already stated
pub fun add(ts: *Table[Trait], t: Trait) err[Fail] {
    if (!fits(t.axis, t.setting)) {
        ret err[Fail].err{fail.about(fail.malformed("the setting is not a value of its trait axis"), t.axis.name)};
    }
    val at: SearchPosition = position(ts, t.axis);
    if (sel at.found) {
        ret err[Fail].err{fail.about(fail.malformed("a trait axis is stated twice"), t.axis.name)};
    }
    ret table.insert[Trait](ts, at.insertion, t);
}

# the choice of `x` named `name`, none when it has none
pub fun choice_named(x: *Axis, name: str) opt[*Choice] {
    var i: usize = 0;
    for (i < x.count) {
        if (str_equals(x.choices[i].name, name)) { ret opt[*Choice].some{x.choices[i]}; }
        i = i + 1;
    }
    ret opt[*Choice].none{};
}

# the value a link carries for `x`, an axis whose values are not text, when
# it holds `held` and an input states `next`, none when the two cannot be
# linked together. a text axis merges through merge_text
pub fun merge(x: *Axis, held: Setting, next: Setting) opt[Setting] {
    if (sel x.merge.first) { ret opt[Setting].some{held}; }
    if (sel x.merge.equal) {
        if (same(held, next)) { ret opt[Setting].some{held}; }
        ret opt[Setting].none{};
    }
    if (!(sel x.value.flag)) { ret opt[Setting].none{}; }
    if (sel held.flag) {
        if (sel next.flag) {
            if (sel x.merge.union)        { ret opt[Setting].some{Setting.flag{held.flag || next.flag}}; }
            if (sel x.merge.intersection) { ret opt[Setting].some{Setting.flag{held.flag && next.flag}}; }
        }
    }
    ret opt[Setting].none{};
}

fun unmergeable(x: *Axis) Fail {
    ret fail.about(fail.internal("a text axis merges by equal, first or extensions"), x.name);
}

# what a link carries for the text axis `x` when it holds the bytes `held`
# and an input states the bytes `next`. a new value is appended to `out`,
# which `held` may lie in, and nothing is appended when the held value stands
# or the two are refused
pub fun merge_text(a: *A.Allocator, x: *Axis, held: Bytes, next: Bytes, out: *Table[u8]) res[Merged, Fail] {
    if (sel x.merge.first) { ret res[Merged, Fail].ok{Merged.held{}}; }
    or (sel x.merge.equal) {
        if (same_bytes(held, next)) { ret res[Merged, Fail].ok{Merged.held{}}; }
        ret res[Merged, Fail].ok{Merged.refused{}};
    }
    or (sel x.merge.union)        { ret res[Merged, Fail].err{unmergeable(x)}; }
    or (sel x.merge.intersection) { ret res[Merged, Fail].err{unmergeable(x)}; }
    var scratch: Table[u8]         = table.make[u8](a);
    val r:       res[bool, Fail]   = isa.merge(a, x.merge.extensions, held, next, ?scratch);
    var m:       res[Merged, Fail] = res[Merged, Fail].ok{Merged.refused{}};
    if (sel r.err) { m = res[Merged, Fail].err{r.err}; }
    or (sel r.ok && r.ok) {
        val made: Bytes = Bytes{data: table.items[u8](?scratch), len: table.count[u8](?scratch)};
        if (same_bytes(made, held)) { m = res[Merged, Fail].ok{Merged.held{}}; }
        or {
            val start: usize                   = table.count[u8](out);
            val at:    res[table.Id[u8], Fail] = table.extend[u8](out, made.data, made.len);
            if (sel at.err) { m = res[Merged, Fail].err{at.err}; }
            or              { m = res[Merged, Fail].ok{Merged.written{Span{start: start, len: made.len}}}; }
        }
    }
    val rel: err[Fail] = table.release[u8](?scratch);
    if (sel m.err)   { ret m; }
    if (sel rel.err) { ret res[Merged, Fail].err{rel.err}; }
    ret m;
}

# whether an axis row is consistent: an axis of one of N lists at least two
# choices, each once, and the rest list none. only a flag merges by union or
# intersection, only a text by extensions, and an axis of one of N or a
# number merges by equal or first
pub fun consistent(x: *Axis) bool {
    if (sel x.merge.union || sel x.merge.intersection) { ret (sel x.value.flag) && x.count == 0; }
    if (sel x.merge.extensions)                        { ret (sel x.value.text) && x.count == 0 && x.merge.extensions != nil; }
    if (!(sel x.value.choice))                         { ret x.count == 0; }
    if (x.count < 2)                                   { ret false; }
    var i: usize = 0;
    for (i < x.count) {
        var j: usize = 0;
        for (j < i) {
            if (x.choices[j] == x.choices[i]) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}
