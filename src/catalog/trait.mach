# the trait catalog
#
# a trait is an ABI fact of an architecture that the producer of an object
# states and a link merges, such as a float ABI, compressed code or a branch
# protection feature. each axis is a row with the rule its merge follows, and
# an axis of one of N values lists a row for each value. an architecture row
# lists the axes it has, and each format encodes them through its own table
# keyed by these rows. an axis an object does not state is absent, never a
# default.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.fail;
use mink.fail.Fail;
use mink.table;
use mink.table.Table;

# how a link combines what its inputs state on an axis
# ---
# equal:        every input states the same value, or the link is refused
# union:        a flag is set when any input sets it
# intersection: a flag is set only when every input that states it sets it
pub tag Merge: u8 {
    equal;
    union;
    intersection;
}

# a value of an axis of one of N
pub rec Choice {
    name: str;
}

# name:    the axis's spelling
# flag:    the axis is a flag, set or clear, rather than one of its choices
# merge:   how a link combines its inputs' values
# choices: the values of an axis of one of N, none for a flag
# count:   how many
pub rec Axis {
    name:    str;
    flag:    bool;
    merge:   Merge;
    choices: **Choice;
    count:   usize;
}

# what is stated on an axis
# ---
# choice: one of the axis's choices
# flag:   whether a flag axis is set
pub tag Setting: u8 {
    choice: *Choice;
    flag:   bool;
}

# one axis and what is stated on it
pub rec Trait {
    axis:    *Axis;
    setting: Setting;
}

# whether `s` is a value of `x`: a choice it lists, or a setting of a flag
pub fun fits(x: *Axis, s: Setting) bool {
    if (sel s.flag) { ret x.flag; }
    var i: usize = 0;
    for (i < x.count) {
        if (x.choices[i] == s.choice) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun same(a: Setting, b: Setting) bool {
    if (sel a.flag) {
        if (sel b.flag) { ret a.flag == b.flag; }
        ret false;
    }
    if (sel b.choice) { ret a.choice == b.choice; }
    ret false;
}

# the trait `ts` states on `x`, none when it states none. a set holds at most
# one trait per axis of one architecture, so it never grows past its catalog
pub fun find(ts: *Table[Trait], x: *Axis) opt[*Trait] {
    var i: usize = 0;
    for (i < table.count[Trait](ts)) {
        val t: *Trait = table.at[Trait](ts, table.nth[Trait](i));
        if (t.axis == x) { ret opt[*Trait].some{t}; }
        i = i + 1;
    }
    ret opt[*Trait].none{};
}

# add `t` to `ts`, refusing a setting its axis does not have and a second
# value for an axis already stated
pub fun add(ts: *Table[Trait], t: Trait) err[Fail] {
    if (!fits(t.axis, t.setting)) {
        ret err[Fail].err{fail.about(fail.malformed("the setting is not a value of its trait axis"), t.axis.name)};
    }
    val known: opt[*Trait] = find(ts, t.axis);
    if (sel known.some) {
        ret err[Fail].err{fail.about(fail.malformed("a trait axis is stated twice"), t.axis.name)};
    }
    val p: res[table.Id[Trait], Fail] = table.push[Trait](ts, t);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the value a link carries for `x` when it holds `held` and an input states
# `next`, none when the two cannot be linked together
pub fun merge(x: *Axis, held: Setting, next: Setting) opt[Setting] {
    if (sel x.merge.equal) {
        if (same(held, next)) { ret opt[Setting].some{held}; }
        ret opt[Setting].none{};
    }
    if (sel held.choice)   { ret opt[Setting].none{}; }
    if (sel next.choice)   { ret opt[Setting].none{}; }
    if (sel x.merge.union) { ret opt[Setting].some{Setting.flag{held.flag || next.flag}}; }
    ret opt[Setting].some{Setting.flag{held.flag && next.flag}};
}

# whether an axis row is consistent: a flag lists no choices and an axis of one
# of N lists at least two, each once, and only a flag merges by union or
# intersection
pub fun consistent(x: *Axis) bool {
    if (x.flag)                              { ret x.count == 0; }
    if (!(sel x.merge.equal) || x.count < 2) { ret false; }
    var i: usize = 0;
    for (i < x.count) {
        var j: usize = 0;
        for (j < i) {
            if (x.choices[j] == x.choices[i]) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}
