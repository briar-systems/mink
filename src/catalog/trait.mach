# the trait catalog
#
# a trait is an ABI fact of an architecture that the producer of an object
# states and a link merges, such as a float ABI, compressed code or a branch
# protection feature. each axis is a row with the kind of value it takes,
# what an object that leaves it unstated means, the rule its merge follows
# and who states its value, and an axis of one of N values lists a row for
# each value. an architecture row lists the axes it has, and each format
# encodes them through its own rows keyed by these rows, never deciding
# itself what an unstated axis means. an axis's name is its key, unique across
# the catalog, and a set of traits is kept in the order of its axes' names.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Held;
use mink.base.table;
use mink.base.table.Table;
use catalog_merge: mink.catalog.merge;
use mink.catalog.merge.Joined;
use mink.catalog.merge.Merge;

# the kind of value an axis takes
# ---
# choice: one of the axis's choices
# flag:   set or clear
# number: an unsigned number
# text:   a string of bytes
# pair:   a number and a string of bytes, as some build attributes hold
# set:    named members each in a state, written as the axis's set rule
#         writes a set
pub tag Value: u8 {
    choice;
    flag;
    number;
    text;
    pair;
    set;
}

# what an object that leaves an axis unstated means
# ---
# unconstrained: nothing, so a link takes no constraint from it and a format
#                that cannot leave the axis unstated needs it stated
# clear:         a flag axis is clear
# value:         the axis holds this value
pub tag Absent: u8 {
    unconstrained;
    clear;
    value: Setting;
}

# who states an axis's value
# ---
# selection:  the producer derives it from the object's selection of the
#             instruction set
# convention: the producer states it from the ABI row it was given
# source:     the assembly source states it, or a default of the axis applies
# derived:    it is computed from the code written, as the union of what the
#             code uses
# fixed:      the architecture row states it, one value per row, so an object
#             states none
pub tag Owner: u8 {
    selection;
    convention;
    source;
    derived;
    fixed;
}

# a value of an axis of one of N
# ---
# name:        its spelling
# wider:       the choices of an ordered axis that directly contain it, none
#              for the rest
# wider_count: how many
pub rec Choice {
    name:        str;
    wider:       **Choice;
    wider_count: usize;
}

# name:    the axis's spelling
# value:   the kind of value it takes
# absent:  what an object that leaves it unstated means
# merge:   how a link combines its inputs' values
# owner:   who states its value
# choices: the values of an axis of one of N, none for the rest
# count:   how many
pub rec Axis {
    name:    str;
    value:   Value;
    absent:  Absent;
    merge:   *Merge;
    owner:   Owner;
    choices: **Choice;
    count:   usize;
}

# a number and a string of bytes, owned in the store of whoever holds the
# trait or borrowed from an input that outlives it
pub rec Paired {
    number: u64;
    text:   Held;
}

# what is stated on an axis
# ---
# choice: one of the axis's choices
# flag:   whether a flag axis is set
# number: the number a number axis holds
# text:   the bytes a text axis holds, owned in the store of whoever holds
#         the trait or borrowed from an input that outlives it
# pair:   the number and bytes a pair axis holds
# set:    the members a set axis holds, written as its rule writes a set and
#         held as a text is
pub tag Setting: u8 {
    choice: *Choice;
    flag:   bool;
    number: u64;
    text:   Held;
    pair:   Paired;
    set:    Held;
}

# one axis and what is stated on it
pub rec Trait {
    axis:    *Axis;
    setting: Setting;
}

# whether `s` is a value of `x`: a choice it lists, or a setting of its kind
pub fun fits(x: *Axis, s: Setting) bool {
    if (sel s.flag)   { ret sel x.value.flag; }
    or (sel s.number) { ret sel x.value.number; }
    or (sel s.text)   { ret sel x.value.text; }
    or (sel s.pair)   { ret sel x.value.pair; }
    or (sel s.set)    { ret sel x.value.set; }
    var i: usize = 0;
    for (i < x.count) {
        if (x.choices[i] == s.choice) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a setting's value lies in bytes held beside it, a text, a pair or
# a set
pub fun bytes_held(s: Setting) bool {
    ret sel s.text || sel s.pair || sel s.set;
}

# whether two settings are the same value. bytes are the same only at the
# same place, as they live with whoever holds them
pub fun same(a: Setting, b: Setting) bool {
    if (sel a.flag) {
        if (sel b.flag) { ret a.flag == b.flag; }
        ret false;
    }
    or (sel a.number) {
        if (sel b.number) { ret a.number == b.number; }
        ret false;
    }
    or (sel a.text) {
        if (sel b.text) { ret same_place(a.text, b.text); }
        ret false;
    }
    or (sel a.pair) {
        if (sel b.pair) { ret a.pair.number == b.pair.number && same_place(a.pair.text, b.pair.text); }
        ret false;
    }
    or (sel a.set) {
        if (sel b.set) { ret same_place(a.set, b.set); }
        ret false;
    }
    if (sel b.choice) { ret a.choice == b.choice; }
    ret false;
}

fun same_place(a: Held, b: Held) bool {
    if (sel a.owned) {
        if (sel b.owned) { ret a.owned.start == b.owned.start && a.owned.len == b.owned.len; }
        ret false;
    }
    if (sel b.borrowed) { ret a.borrowed.data == b.borrowed.data && a.borrowed.len == b.borrowed.len; }
    ret false;
}

# what an object that leaves `x` unstated holds on it, none when that places
# no constraint
pub fun absent_value(x: *Axis) opt[Setting] {
    if (sel x.absent.clear) { ret opt[Setting].some{Setting.flag{false}}; }
    or (sel x.absent.value) { ret opt[Setting].some{x.absent.value}; }
    ret opt[Setting].none{};
}

# whether stating `s` on `x` means what leaving `x` unstated means, so an
# object that states it holds nothing for it
pub fun unstated(x: *Axis, s: Setting) bool {
    val v: opt[Setting] = absent_value(x);
    ret sel v.some && same(v.some, s);
}

# the order of two axes by name, the key every index of axes is sorted by
pub fun order(a: **Axis, b: **Axis) i64 {
    ret str_compare(a[0].name, b[0].name);
}

fun order_traits(a: *Trait, b: *Trait) i64 {
    ret str_compare(a.axis.name, b.axis.name);
}

# where `x` sits in `ts`, which is kept in the order of its axes' names
fun position(ts: *Table[Trait], x: *Axis) SearchPosition {
    var probe: Trait = Trait{axis: x};
    ret sort.binary_search_by[Trait](table.items[Trait](ts), table.count[Trait](ts), ?probe, order_traits);
}

# the trait `ts` states on `x`, none when it states none
pub fun find(ts: *Table[Trait], x: *Axis) opt[*Trait] {
    val at: SearchPosition = position(ts, x);
    if (sel at.found) {
        val t: *Trait = table.at[Trait](ts, table.nth[Trait](at.found));
        if (t.axis == x) { ret opt[*Trait].some{t}; }
    }
    ret opt[*Trait].none{};
}

# add `t` to `ts` in key order, refusing a setting its axis does not have and
# a second value for an axis already stated
pub fun add(ts: *Table[Trait], t: Trait) err[Fail] {
    if (!fits(t.axis, t.setting)) {
        ret err[Fail].err{fail.about(fail.malformed("the setting is not a value of its trait axis"), t.axis.name)};
    }
    val at: SearchPosition = position(ts, t.axis);
    if (sel at.found) {
        ret err[Fail].err{fail.about(fail.malformed("a trait axis is stated twice"), t.axis.name)};
    }
    ret table.insert[Trait](ts, at.insertion, t);
}

# add `t` to `ts` as `add` does, holding nothing when its setting means what
# leaving its axis unstated means
pub fun state(ts: *Table[Trait], t: Trait) err[Fail] {
    if (!fits(t.axis, t.setting)) {
        ret err[Fail].err{fail.about(fail.malformed("the setting is not a value of its trait axis"), t.axis.name)};
    }
    if (unstated(t.axis, t.setting)) {
        val held: opt[*Trait] = find(ts, t.axis);
        if (sel held.some) { ret err[Fail].err{fail.about(fail.malformed("a trait axis is stated twice"), t.axis.name)}; }
        ret err[Fail].ok{};
    }
    ret add(ts, t);
}

# take the trait `ts` states on `x` out of it, refusing an axis it does not state
pub fun remove(ts: *Table[Trait], x: *Axis) err[Fail] {
    val at: SearchPosition = position(ts, x);
    if (sel at.found) { ret table.remove[Trait](ts, at.found); }
    ret err[Fail].err{fail.about(fail.internal("a trait axis to remove is not stated"), x.name)};
}

# the choice of `x` named `name`, none when it has none
pub fun choice_named(x: *Axis, name: str) opt[*Choice] {
    var i: usize = 0;
    for (i < x.count) {
        if (str_equals(x.choices[i].name, name)) { ret opt[*Choice].some{x.choices[i]}; }
        i = i + 1;
    }
    ret opt[*Choice].none{};
}

# what a link carries for `x` when it holds `held` and an input states
# `next`, for an axis whose values do not lie in bytes. an axis whose values
# lie in bytes merges through catalog_merge.merge_bytes over its rule
pub fun merge(x: *Axis, held: Setting, next: Setting) Joined[Setting] {
    val m: *Merge = x.merge;
    if (sel m.ordered) {
        if (sel held.choice) {
            if (sel next.choice) {
                val j: opt[*Choice] = join(x, held.choice, next.choice);
                if (sel j.some) { ret Joined[Setting].kept{Setting.choice{j.some}}; }
            }
        }
        ret Joined[Setting].refused{};
    }
    or (sel m.highest) {
        if (sel held.number) {
            if (sel next.number) {
                val h: opt[u64] = catalog_merge.highest(m.highest, held.number, next.number);
                if (sel h.some) { ret Joined[Setting].kept{Setting.number{h.some}}; }
            }
        }
        ret Joined[Setting].refused{};
    }
    if (sel m.equal) {
        if (same(held, next)) { ret Joined[Setting].kept{held}; }
        ret Joined[Setting].refused{};
    }
    or (sel m.agreed) {
        if (same(held, next)) { ret Joined[Setting].kept{held}; }
        ret Joined[Setting].dropped{};
    }
    if (!(sel x.value.flag)) { ret Joined[Setting].refused{}; }
    if (sel held.flag) {
        if (sel next.flag) {
            if (sel m.union)        { ret Joined[Setting].kept{Setting.flag{held.flag || next.flag}}; }
            if (sel m.intersection) { ret Joined[Setting].kept{Setting.flag{held.flag && next.flag}}; }
        }
    }
    ret Joined[Setting].refused{};
}

# whether choice `a` lies within choice `b`, following at most
# `depth` steps of the rows' relation
fun within(a: *Choice, b: *Choice, depth: usize) bool {
    if (a == b)     { ret true; }
    if (depth == 0) { ret false; }
    var i: usize = 0;
    for (i < a.wider_count) {
        if (within(a.wider[i], b, depth - 1)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the least choice of the ordered axis `x` that contains both `a` and `b`,
# none when no choice contains both or none of those is least
fun join(x: *Axis, a: *Choice, b: *Choice) opt[*Choice] {
    var least: *Choice = nil;
    var i:     usize   = 0;
    for (i < x.count) {
        val c: *Choice = x.choices[i];
        i = i + 1;
        if (!within(a, c, x.count) || !within(b, c, x.count)) { cnt; }
        if (least == nil || within(c, least, x.count))        { least = c; }
    }
    if (least == nil) { ret opt[*Choice].none{}; }
    i = 0;
    for (i < x.count) {
        val c: *Choice = x.choices[i];
        i = i + 1;
        if (within(a, c, x.count) && within(b, c, x.count) && !within(least, c, x.count)) { ret opt[*Choice].none{}; }
    }
    ret opt[*Choice].some{least};
}

# whether the relation of the ordered axis `x` is a partial order over its
# choices in which any two choices some choice contains have a least such
# one, so its merge gives the same choice in any input order
fun order_free(x: *Axis) bool {
    var i: usize = 0;
    for (i < x.count) {
        val c: *Choice = x.choices[i];
        var k: usize   = 0;
        for (k < c.wider_count) {
            val w: *Choice = c.wider[k];
            if (w == c || !fits(x, Setting.choice{w})) { ret false; }
            if (within(w, c, x.count))                 { ret false; }
            k = k + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < x.count) {
        var j: usize = 0;
        for (j < i) {
            var bounded: bool  = false;
            var k:       usize = 0;
            for (k < x.count) {
                if (within(x.choices[i], x.choices[k], x.count) && within(x.choices[j], x.choices[k], x.count)) { bounded = true; }
                k = k + 1;
            }
            val j2: opt[*Choice] = join(x, x.choices[i], x.choices[j]);
            if (bounded && sel j2.none) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# whether an axis row is consistent. only a flag merges by union or
# intersection, only a text by extensions, only a set by its set rule, only a
# number by highest over a usable order, and any value by equal or agreed.
# only an axis of one of N merges by ordered, its choices' relation a partial
# order whose merge is order-free, and only its choices state a relation. an
# axis of one of N lists at least two choices, each once, and the rest list
# none. only a flag is clear when unstated, an unstated value is one of the
# axis's that lies in no bytes, and an axis its architecture row fixes leaves
# nothing to an unstated object
pub fun consistent(x: *Axis) bool {
    val m: *Merge = x.merge;
    if (m == nil)                          { ret false; }
    if (!absence_holds(x))                 { ret false; }
    if (sel m.union || sel m.intersection) { ret (sel x.value.flag) && x.count == 0; }
    if (sel m.extensions)                  { ret (sel x.value.text) && x.count == 0 && m.extensions != nil; }
    if (sel m.set)                         { ret (sel x.value.set) && x.count == 0 && m.set != nil && catalog_merge.consistent_policy(m.set); }
    if (sel m.highest)                     { ret (sel x.value.number) && x.count == 0 && catalog_merge.ranked(m.highest); }
    if (sel m.local || sel m.drained)      { ret false; }
    if (sel m.refused || sel m.dropped)    { ret false; }
    if (!(sel x.value.choice))             { ret x.count == 0 && !(sel m.ordered); }
    if (x.count < 2)                       { ret false; }
    var i: usize = 0;
    for (i < x.count) {
        var j: usize = 0;
        for (j < i) {
            if (x.choices[j] == x.choices[i]) { ret false; }
            j = j + 1;
        }
        if (!(sel m.ordered) && x.choices[i].wider_count != 0) { ret false; }
        i = i + 1;
    }
    if (sel m.ordered) { ret order_free(x); }
    ret true;
}

# whether the axis's absence fits it
fun absence_holds(x: *Axis) bool {
    if (sel x.owner.fixed)  { ret sel x.absent.unconstrained; }
    if (sel x.absent.clear) { ret sel x.value.flag; }
    or (sel x.absent.value) { ret fits(x, x.absent.value) && !bytes_held(x.absent.value); }
    ret true;
}

# the setting merging the choices `a` and `b` of `x` gives, nil when refused
fun merged_choice(x: *Axis, a: *Choice, b: *Choice) *Choice {
    val m: Joined[Setting] = merge(x, Setting.choice{a}, Setting.choice{b});
    if (sel m.kept) {
        if (sel m.kept.choice) { ret m.kept.choice; }
    }
    ret nil;
}

test trait__an_ordered_axis_merges_into_the_least_choice_containing_both {
    # an ISA level shaped like MIPS: a chain of levels each containing the one
    # before, a 32-bit branch beside the third level that the top level also
    # contains, and a release that contains no earlier level
    val top:    Choice     = Choice{name: "64"};
    val top_w:  [1]*Choice = [1]*Choice{?top};
    val four:   Choice     = Choice{name: "4", wider: ?top_w[0], wider_count: 1};
    val narrow: Choice     = Choice{name: "32", wider: ?top_w[0], wider_count: 1};
    val four_w: [1]*Choice = [1]*Choice{?four};
    val three:  Choice     = Choice{name: "3", wider: ?four_w[0], wider_count: 1};
    val two_w:  [2]*Choice = [2]*Choice{?three, ?narrow};
    val two:    Choice     = Choice{name: "2", wider: ?two_w[0], wider_count: 2};
    val r6:     Choice     = Choice{name: "r6"};
    val levels: [6]*Choice = [6]*Choice{?two, ?three, ?four, ?narrow, ?top, ?r6};
    val x:      Axis       = Axis{name: "isa", value: Value.choice{}, merge: ?catalog_merge.ORDERED, choices: ?levels[0], count: 6};
    if (!consistent(?x)) { ret 1; }

    # contain, in either order, and through more than one step
    if (merged_choice(?x, ?two, ?four) != ?four) { ret 2; }
    if (merged_choice(?x, ?four, ?two) != ?four) { ret 2; }
    # equal
    if (merged_choice(?x, ?three, ?three) != ?three) { ret 3; }
    # two branches merge into the least choice containing both
    if (merged_choice(?x, ?narrow, ?four) != ?top) { ret 4; }
    # refuse: no choice contains both
    if (merged_choice(?x, ?r6, ?two) != nil) { ret 5; }
    if (merged_choice(?x, ?top, ?r6) != nil) { ret 5; }

    # two choices bounded by two containers neither of which is least would
    # merge by input order, so the relation is refused
    val left:    Choice     = Choice{name: "left"};
    val right:   Choice     = Choice{name: "right"};
    val both:    [2]*Choice = [2]*Choice{?left, ?right};
    val low_a:   Choice     = Choice{name: "a", wider: ?both[0], wider_count: 2};
    val low_b:   Choice     = Choice{name: "b", wider: ?both[0], wider_count: 2};
    val diamond: [4]*Choice = [4]*Choice{?low_a, ?low_b, ?left, ?right};
    val y:       Axis       = Axis{name: "split", value: Value.choice{}, merge: ?catalog_merge.ORDERED, choices: ?diamond[0], count: 4};
    if (consistent(?y)) { ret 6; }
    ret 0;
}
