# the system catalog
#
# a system is a row of loader facts, an environment one of its ABIs or
# runtimes, such as linux's gnu or darwin's macos, and a host what a system,
# under an environment, says for one architecture it runs. code reads what a
# row declares, never which system it is. calling conventions and data layout
# are mirl's and have no field here. each system's rows are in their own file
# under os, and os/list enumerates them.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table.Table;
use mink.catalog.arch.Arch;
use mink.catalog.format.Format;
use mink.catalog.output;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;

pub def Caps: u64;

# executables are position independent unless asked otherwise
pub val PIE_DEFAULT: Caps = 1;
# the system runs AArch64 code with data independent timing enabled
pub val DIT_GUARANTEED: Caps = 2;
# the loader binds an image through chained fixups
pub val CHAINED_FIXUPS: Caps = 4;

# a version as a format writes it, such as LC_BUILD_VERSION's minos
pub rec Version {
    major: u16;
    minor: u8;
    patch: u8;
}

# how a format names a system or an environment, such as ELF's EI_OSABI or a
# Mach-O platform
pub rec Code {
    format: *Format;
    value:  u64;
}

# what a named fact of a host or an environment is to the link
pub rec Role {
    name: str;
}

# the symbol the loader's thread-local variable accessor is bound to
pub val TLV_BOOTSTRAP: Role = Role{name: "tlv bootstrap"};
# the import module a runtime resolves the system's interface from
pub val IMPORT_MODULE: Role = Role{name: "import module"};

# a fact of a host or an environment known by its role
pub rec Named {
    role: *Role;
    name: str;
}

# a host row holds only when the link's merged traits state `setting` on
# `axis`, as a loader path depends on the float ABI
pub rec When {
    axis:    *Axis;
    setting: Setting;
}

# the entry symbol of the output kinds that declare every capability of
# `caps`
pub rec Entry {
    caps:   output.Caps;
    symbol: str;
}

# a capability the system offers from version `from` on
pub rec Since {
    cap:  Caps;
    from: Version;
}

# name:         the system's spelling
# mapped:       whether a loader maps the image at all
# formats:      the output formats the system accepts, the default first
# format_count: how many
# codes:        how each format names the system
# code_count:   how many
# hosts:        what the system says for each architecture and environment
# host_count:   how many
pub rec System {
    name:         str;
    mapped:       bool;
    formats:      **Format;
    format_count: usize;
    codes:        *Code;
    code_count:   usize;
    hosts:        *Host;
    host_count:   usize;
}

# an ABI or a runtime of a system
# ---
# system:     the system it is of
# name:       its spelling
# codes:      how each format names it, such as a Mach-O platform
# code_count: how many
# facts:      the named facts it states
# fact_count: how many
pub rec Env {
    system:     *System;
    name:       str;
    codes:      *Code;
    code_count: usize;
    facts:      *Named;
    fact_count: usize;
}

# what a system says for one architecture it runs
# ---
# system:        the system
# env:           the environment, none for a system that has none
# arch:          the architecture
# when:          the merged trait setting the row holds under, none for a row
#                that holds whatever the traits state
# interpreter:   the program loader's path, nil where there is none
# libdirs:       the directories searched for libraries, in order
# libdir_count:  how many
# sdk_dirs:      the directories searched for frameworks of the system's SDK
# sdk_dir_count: how many
# image_base:    the address an image is linked at by default
# page:          the page size images are aligned to
# caps:          the capabilities the system declares for this architecture
# entries:       the entry symbols of the output kinds that have one
# entry_count:   how many
# libraries:     the libraries a program links by default
# library_count: how many
# subsystem:     the image subsystem written by default, none where the
#                format has none
# minos:         the oldest system version an image declares it runs on,
#                none where the system states none
# since:         the capabilities the system offers from a version on
# since_count:   how many
# symbols:       the named symbols the loader provides
# symbol_count:  how many
pub rec Host {
    system:        *System;
    env:           opt[*Env];
    arch:          *Arch;
    when:          opt[When];
    interpreter:   str;
    libdirs:       *str;
    libdir_count:  usize;
    sdk_dirs:      *str;
    sdk_dir_count: usize;
    image_base:    u64;
    page:          u64;
    caps:          Caps;
    entries:       *Entry;
    entry_count:   usize;
    libraries:     *str;
    library_count: usize;
    subsystem:     opt[u16];
    minos:         opt[Version];
    since:         *Since;
    since_count:   usize;
    symbols:       *Named;
    symbol_count:  usize;
}

# how `f` names `s`, none when it does not
pub fun code(s: *System, f: *Format) opt[*Code] {
    var k: usize = 0;
    for (k < s.code_count) {
        if (s.codes[k].format == f) { ret opt[*Code].some{?s.codes[k]}; }
        k = k + 1;
    }
    ret opt[*Code].none{};
}

# whether `s` accepts `f` as an output format
pub fun accepts(s: *System, f: *Format) bool {
    var k: usize = 0;
    for (k < s.format_count) {
        if (s.formats[k] == f) { ret true; }
        k = k + 1;
    }
    ret false;
}

# whether host `h` is for `a` under the environment `e`
fun serves(h: *Host, e: opt[*Env], a: *Arch) bool {
    if (h.arch != a) { ret false; }
    if (sel e.none)  { ret sel h.env.none; }
    ret sel h.env.some && h.env.some == e.some;
}

# whether `s` runs `a` under the environment `e`, whatever traits a link
# states
pub fun runs(s: *System, e: opt[*Env], a: *Arch) bool {
    var i: usize = 0;
    for (i < s.host_count) {
        if (serves(?s.hosts[i], e, a)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the row's condition holds of the traits `ts`
fun holds(h: *Host, ts: *Table[Trait]) bool {
    if (sel h.when.none) { ret true; }
    val w: When        = h.when.some;
    val t: opt[*Trait] = trait.find(ts, w.axis);
    ret sel t.some && trait.same(t.some.setting, w.setting);
}

# the one host of `s` for `a` under `e` that holds of the merged traits `ts`.
# none holding is refused naming the system, and two holding is a defect of
# the catalog
pub fun host(s: *System, e: opt[*Env], a: *Arch, ts: *Table[Trait]) res[*Host, Fail] {
    var found: *Host = nil;
    var any:   bool  = false;
    var i:     usize = 0;
    for (i < s.host_count) {
        val h: *Host = ?s.hosts[i];
        i = i + 1;
        if (!serves(h, e, a)) { cnt; }
        any = true;
        if (!holds(h, ts)) { cnt; }
        if (found != nil)  { ret res[*Host, Fail].err{fail.about(fail.internal("two hosts of the system hold for one link"), s.name)}; }
        found = h;
    }
    if (!any)         { ret res[*Host, Fail].err{fail.about(fail.unsupported("the system does not run this architecture"), s.name)}; }
    if (found == nil) { ret res[*Host, Fail].err{fail.about(fail.unsupported("no host of the system holds for the traits the inputs state"), s.name)}; }
    ret res[*Host, Fail].ok{found};
}

# whether host `h` declares every bit of `c`
pub fun host_has(h: *Host, c: Caps) bool {
    ret (h.caps & c) == c;
}

# the entry symbol of an output of kind `k` on `h`, nil where the host names
# none for the kind
pub fun entry(h: *Host, k: *output.Kind) str {
    var i: usize = 0;
    for (i < h.entry_count) {
        if (output.has(k, h.entries[i].caps)) { ret h.entries[i].symbol; }
        i = i + 1;
    }
    ret nil;
}
