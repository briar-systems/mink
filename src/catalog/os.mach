# the system catalog
#
# a system is a row of loader facts, an environment one of its ABIs or
# runtimes, such as linux's gnu or darwin's macos, and a host what a system,
# under an environment, says for one architecture it runs. code reads what a
# row declares, never which system it is. a host names its default calling
# convention by its psABI row of the architecture catalog, and how a
# convention passes values and lays out data is mirl's. each system's rows are
# in their own file under os, and os/list enumerates them.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.table.Table;
use mink.catalog.arch;
use mink.catalog.arch.Abi;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Derivation;
use mink.catalog.format.Format;
use mink.catalog.output;
use mink.catalog.subsystem.Subsystem;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Choice;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;

pub def Caps: u64;

# executables are position independent unless asked otherwise
pub val PIE_DEFAULT: Caps = 1;
# the system runs AArch64 code with data independent timing enabled
pub val DIT_GUARANTEED: Caps = 2;
# the loader binds an image through chained fixups
pub val CHAINED_FIXUPS: Caps = 4;

# a version as a format writes it, such as LC_BUILD_VERSION's minos
pub rec Version {
    major: u16;
    minor: u8;
    patch: u8;
}

# how a format names a system or an environment, such as ELF's EI_OSABI or a
# Mach-O platform
pub rec Code {
    format: *Format;
    value:  u64;
}

# what a named fact of a host or an environment is to the link
pub rec Role {
    name: str;
}

# the symbol the loader's thread-local variable accessor is bound to
pub val TLV_BOOTSTRAP: Role = Role{name: "tlv bootstrap"};
# the import module a runtime resolves the system's interface from
pub val IMPORT_MODULE: Role = Role{name: "import module"};

# a fact of a host or an environment known by its role
pub rec Named {
    role: *Role;
    name: str;
}

# a host row holds only when the link's merged traits state `setting` on
# `axis`, as a loader path depends on the float ABI
pub rec When {
    axis:    *Axis;
    setting: Setting;
}

# the entry symbol of the output kinds that declare every capability of
# `caps`
pub rec Entry {
    caps:   output.Caps;
    symbol: str;
}

# the widest choice of an ordered trait axis a host accepts, as the highest
# SPIR-V version an environment takes
pub rec Ceiling {
    axis:    *Axis;
    highest: *Choice;
}

# a capability the system offers from version `from` on
pub rec Since {
    cap:  Caps;
    from: Version;
}

# name:         the system's spelling
# mapped:       whether a loader maps the image at all
# formats:      the output formats the system accepts, the default first
# format_count: how many
# codes:        how each format names the system
# code_count:   how many
# hosts:        what the system says for each architecture and environment
# host_count:   how many
pub rec System {
    name:         str;
    mapped:       bool;
    formats:      **Format;
    format_count: usize;
    codes:        *Code;
    code_count:   usize;
    hosts:        *Host;
    host_count:   usize;
}

# an ABI or a runtime of a system
# ---
# system:     the system it is of
# name:       its spelling
# codes:      how each format names it, such as a Mach-O platform
# code_count: how many
# facts:      the named facts it states
# fact_count: how many
pub rec Env {
    system:     *System;
    name:       str;
    codes:      *Code;
    code_count: usize;
    facts:      *Named;
    fact_count: usize;
}

# the psABI row a host calls by default
# ---
# none:    the architecture's family names no rows
# row:     the row, whatever the link states
# derived: the row follows from the ISA string the link states
pub tag Default: u8 {
    none;
    row:     *Abi;
    derived: *Derivation;
}

# whether a host's loader runs an image at the address it was linked at,
# each stated with the loader behaviour it rests on
# ---
# unstated:  the row states nothing, a defect of the catalog
# linked:    the loader runs an image at its linked address
# relocated: the loader places every image where it chooses
pub tag Placement: u8 {
    unstated;
    linked:    str;
    relocated: str;
}

# the code signature a host's loader checks an image's pages against
# ---
# page: the bytes each code hash covers
pub rec Signed {
    page: u64;
}

# a file a library's name is looked for as: the prefix, the name, then the
# suffix
# ---
# loaded: the file is a library the loader loads, tried only for an output
#         kind that imports
pub rec Pattern {
    prefix: str;
    suffix: str;
    loaded: bool;
}

# the files of a library's name that carry a single-number major version:
# the prefix, the name, the infix, the major in decimal, then the suffix, as
# `lib<name>.so.N` or `lib<name>.N.dylib`. each names a library the loader
# loads
pub rec Major {
    prefix: str;
    infix:  str;
    suffix: str;
}

# the files a library's name is looked for as in one step of a search, in
# the order tried
pub rec Files {
    rows:  **Pattern;
    count: usize;
}

# one step of a search, which tries every directory in order before the next
# step begins
# ---
# files:  each directory for each of the files in order
# majors: each directory for the files of the major versions present, the
#         highest first, a major written in decimal with no leading zero
pub tag Step: u8 {
    files:  Files;
    majors: *Major;
}

# the steps a library's name is searched by, in order
pub rec Order {
    steps: *Step;
    count: usize;
}

# how the system's linker finds a library or a framework a link names
# ---
# shared_first: the steps for a name searched shared first, as the system's
#               linker searches one
# static_first: the steps for a name searched static first, falling back to
#               shared
# bundle:       the suffix of a framework's bundle directory, nil where the
#               system has no frameworks
# bundles:      the files a framework's name is looked for as inside its
#               bundle, in the order tried
# bundle_count: how many
# stem:         a suffix a library's name may end in naming the file the
#               loader loads, removed before the files are tried, nil for
#               none
# scripts:      a library file no format reads is read as a GNU linker
#               script
pub rec Naming {
    shared_first: Order;
    static_first: Order;
    bundle:       str;
    bundles:      *Pattern;
    bundle_count: usize;
    stem:         str;
    scripts:      bool;
}

# where and how a link finds a library or a framework by name, for one
# system, environment and architecture
# ---
# libdirs:         the directories searched for libraries, in order
# libdir_count:    how many
# frameworks:      the directories searched for frameworks, in order
# framework_count: how many
# naming:          the files a name is looked for as, none where the
#                  system's linker finds no library by name
pub rec Search {
    libdirs:         *str;
    libdir_count:    usize;
    frameworks:      *str;
    framework_count: usize;
    naming:          opt[*Naming];
}

# whether a host's loader takes an image with a code signature
# ---
# none:     it takes none
# optional: it runs an image with or without one
# required: it runs no image without one
pub tag Signing: u8 {
    none;
    optional: Signed;
    required: Signed;
}

# what a system says for one architecture it runs
# ---
# system:        the system
# env:           the environment, none for a system that has none
# arch:          the architecture
# when:          the merged trait setting the row holds under, none for a row
#                that holds whatever the traits state
# interpreter:   the program loader's path, nil where there is none
# libdirs:       the directories searched for libraries, in order
# libdir_count:  how many
# sdk_dirs:      the directories searched for frameworks of the system's SDK
# sdk_dir_count: how many
# naming:        the files the system's linker looks for a library or a
#                framework as, none where it finds none by name
# image_base:    the address an image is linked at by default
# page:          the page size images are aligned to
# caps:          the capabilities the system declares for this architecture
# entries:       the entry symbols of the output kinds that have one
# entry_count:   how many
# libraries:     the libraries a program links by default
# library_count: how many
# subsystem:     the PE subsystem an image states when its target states
#                none, none where the system writes no PE image
# minos:         the oldest system version an image declares it runs on,
#                none where the system states none
# since:         the capabilities the system offers from a version on
# since_count:   how many
# symbols:       the named symbols the loader provides
# symbol_count:  how many
# abi:           the psABI row of the architecture's family the system calls
#                by default
# placement:     whether the loader runs an image at its linked address
# ceilings:      the widest choice the host accepts of an ordered axis, none
#                for an axis it bounds not at all
# ceiling_count: how many
# signing:       whether the loader takes an image with a code signature, and
#                of what form
# floor:         the instruction set every machine the system runs this
#                architecture on has, from the oldest version it declares,
#                in masc's selection spelling of the architecture. none where
#                the system bounds the machine not at all
pub rec Host {
    system:        *System;
    env:           opt[*Env];
    arch:          *Arch;
    when:          opt[When];
    interpreter:   str;
    libdirs:       *str;
    libdir_count:  usize;
    sdk_dirs:      *str;
    sdk_dir_count: usize;
    naming:        opt[*Naming];
    image_base:    u64;
    page:          u64;
    caps:          Caps;
    entries:       *Entry;
    entry_count:   usize;
    libraries:     *str;
    library_count: usize;
    subsystem:     opt[*Subsystem];
    minos:         opt[Version];
    since:         *Since;
    since_count:   usize;
    symbols:       *Named;
    symbol_count:  usize;
    abi:           Default;
    placement:     Placement;
    ceilings:      *Ceiling;
    ceiling_count: usize;
    signing:       Signing;
    floor:         opt[str];
}

# how `f` names `s`, none when it does not
pub fun code(s: *System, f: *Format) opt[*Code] {
    var k: usize = 0;
    for (k < s.code_count) {
        if (s.codes[k].format == f) { ret opt[*Code].some{?s.codes[k]}; }
        k = k + 1;
    }
    ret opt[*Code].none{};
}

# whether `s` accepts `f` as an output format
pub fun accepts(s: *System, f: *Format) bool {
    var k: usize = 0;
    for (k < s.format_count) {
        if (s.formats[k] == f) { ret true; }
        k = k + 1;
    }
    ret false;
}

# whether host `h` accepts choice `c` of the ordered axis `x`: it states no
# ceiling for `x`, or `c` lies within it
pub fun admits(h: *Host, x: *Axis, c: *Choice) bool {
    var i: usize = 0;
    for (i < h.ceiling_count) {
        if (h.ceilings[i].axis == x) { ret trait.at_most(x, c, h.ceilings[i].highest); }
        i = i + 1;
    }
    ret true;
}

# whether host `h` is for `a` under the environment `e`
fun serves(h: *Host, e: opt[*Env], a: *Arch) bool {
    if (h.arch != a) { ret false; }
    if (sel e.none)  { ret sel h.env.none; }
    ret sel h.env.some && h.env.some == e.some;
}

# where a link for `a` on `s` under `e` finds a library or a framework by
# name, which every host serving them states alike whatever traits the link
# states. hosts stating it differently are a defect of the catalog
pub fun search(s: *System, e: opt[*Env], a: *Arch) res[Search, Fail] {
    var found: *Host = nil;
    var i:     usize = 0;
    for (i < s.host_count) {
        val h: *Host = ?s.hosts[i];
        i = i + 1;
        if (!serves(h, e, a)) { cnt; }
        if (found == nil) {
            found = h;
            cnt;
        }
        if (!searches_alike(found, h)) { ret res[Search, Fail].err{fail.about(fail.internal("two hosts of the system search for libraries differently"), s.name)}; }
    }
    if (found == nil) { ret res[Search, Fail].err{fail.about(fail.unsupported("the system does not run this architecture"), s.name)}; }
    ret res[Search, Fail].ok{Search{libdirs: found.libdirs, libdir_count: found.libdir_count, frameworks: found.sdk_dirs, framework_count: found.sdk_dir_count, naming: found.naming}};
}

# whether hosts `x` and `y` search the same directories by the same naming
fun searches_alike(x: *Host, y: *Host) bool {
    if (x.libdirs != y.libdirs || x.libdir_count != y.libdir_count)     { ret false; }
    if (x.sdk_dirs != y.sdk_dirs || x.sdk_dir_count != y.sdk_dir_count) { ret false; }
    val m: opt[*Naming] = x.naming;
    val n: opt[*Naming] = y.naming;
    if (sel m.none) { ret sel n.none; }
    ret sel n.some && n.some == m.some;
}

# whether `s` runs `a` under the environment `e`, whatever traits a link
# states
pub fun runs(s: *System, e: opt[*Env], a: *Arch) bool {
    var i: usize = 0;
    for (i < s.host_count) {
        if (serves(?s.hosts[i], e, a)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the row's condition holds of the traits `ts`
fun holds(h: *Host, ts: *Table[Trait]) bool {
    if (sel h.when.none) { ret true; }
    val w: When        = h.when.some;
    val t: opt[*Trait] = trait.find(ts, w.axis);
    ret sel t.some && trait.same(t.some.setting, w.setting);
}

# the one host of `s` for `a` under `e` that holds of the merged traits `ts`.
# none holding is refused naming the system, and two holding is a defect of
# the catalog
pub fun host(s: *System, e: opt[*Env], a: *Arch, ts: *Table[Trait]) res[*Host, Fail] {
    var found: *Host = nil;
    var any:   bool  = false;
    var i:     usize = 0;
    for (i < s.host_count) {
        val h: *Host = ?s.hosts[i];
        i = i + 1;
        if (!serves(h, e, a)) { cnt; }
        any = true;
        if (!holds(h, ts)) { cnt; }
        if (found != nil)  { ret res[*Host, Fail].err{fail.about(fail.internal("two hosts of the system hold for one link"), s.name)}; }
        found = h;
    }
    if (!any)         { ret res[*Host, Fail].err{fail.about(fail.unsupported("the system does not run this architecture"), s.name)}; }
    if (found == nil) { ret res[*Host, Fail].err{fail.about(fail.unsupported("no host of the system holds for the traits the inputs state"), s.name)}; }
    ret res[*Host, Fail].ok{found};
}

# whether host `h` declares every bit of `c`
pub fun host_has(h: *Host, c: Caps) bool {
    ret (h.caps & c) == c;
}

# the oldest system version an image for `h` runs on: the one the target
# states, else the system's, refused where neither states one
pub fun oldest(h: *Host, stated: opt[Version]) res[Version, Fail] {
    if (sel stated.some)  { ret res[Version, Fail].ok{stated.some}; }
    if (sel h.minos.some) { ret res[Version, Fail].ok{h.minos.some}; }
    ret res[Version, Fail].err{fail.about(fail.unsupported("neither the target nor the system states the oldest version the image runs on"), h.system.name)};
}

# whether `a` is no older than `b`
fun at_least(a: Version, b: Version) bool {
    if (a.major != b.major) { ret a.major > b.major; }
    if (a.minor != b.minor) { ret a.minor > b.minor; }
    ret a.patch >= b.patch;
}

# the capabilities `h` offers an image whose oldest version the target
# states as `stated`: those it declares, and each it offers from a version
# no newer than the image's oldest. a host that offers a capability from a
# version needs the image's oldest, refused as `oldest` refuses it
pub fun caps_of(h: *Host, stated: opt[Version]) res[Caps, Fail] {
    if (h.since_count == 0) { ret res[Caps, Fail].ok{h.caps}; }
    val v: res[Version, Fail] = oldest(h, stated);
    if (sel v.err) { ret res[Caps, Fail].err{v.err}; }
    var caps: Caps  = h.caps;
    var i:    usize = 0;
    for (i < h.since_count) {
        if (at_least(v.ok, h.since[i].from)) { caps = caps | h.since[i].cap; }
        i = i + 1;
    }
    ret res[Caps, Fail].ok{caps};
}

# whether host `h` runs an output of kind `k`. an image fixed at its linked
# address is refused on a host whose loader places every image where it
# chooses, naming the system, the kind and the loader behaviour, with the
# architecture in that citation
pub fun places(h: *Host, k: *output.Kind) err[Fail] {
    if (sel h.placement.unstated) { ret err[Fail].err{fail.about(fail.internal("the host states no placement of an image"), h.system.name)}; }
    or (sel h.placement.linked)   { ret err[Fail].ok{}; }
    if (!output.fixed(k))         { ret err[Fail].ok{}; }
    ret err[Fail].err{fail.cited(fail.about(fail.in_record(fail.unsupported("the host's loader places every image where it chooses, so it cannot run this output kind at its linked address"), h.system.name), k.name), h.placement.relocated)};
}

# the entry symbol of an output of kind `k` on `h`, nil where the host names
# none for the kind
pub fun entry(h: *Host, k: *output.Kind) str {
    var i: usize = 0;
    for (i < h.entry_count) {
        if (output.has(k, h.entries[i].caps)) { ret h.entries[i].symbol; }
        i = i + 1;
    }
    ret nil;
}

# the calling convention `h` calls by default under the merged traits `ts`,
# whose owned bytes begin at `base`, none where its architecture's family
# names no psABI rows. a host that derives it from an ISA string the traits
# do not state is refused naming the axis
pub fun default_abi(h: *Host, ts: *Table[Trait], base: *u8) res[opt[*Abi], Fail] {
    if (sel h.abi.row) { ret res[opt[*Abi], Fail].ok{opt[*Abi].some{h.abi.row}}; }
    or (sel h.abi.none) {
        if (h.arch.family.abi_count > 0) { ret res[opt[*Abi], Fail].err{fail.about(fail.internal("the host states no default calling convention for a family that names them"), h.system.name)}; }
        ret res[opt[*Abi], Fail].ok{opt[*Abi].none{}};
    }
    val d: *Derivation = h.abi.derived;
    val t: opt[*Trait] = trait.find(ts, d.axis);
    if (sel t.none) { ret res[opt[*Abi], Fail].err{fail.about(fail.unsupported("the traits state no ISA string, which the default calling convention follows from"), d.axis.name)}; }
    val s: Setting = t.some.setting;
    if (!sel s.text) { ret res[opt[*Abi], Fail].err{fail.about(fail.malformed("the ISA string is not a text"), d.axis.name)}; }
    val b: res[*Abi, Fail] = arch.derive(d, h.arch, store.at(base, ?s.text));
    if (sel b.err) { ret res[opt[*Abi], Fail].err{b.err}; }
    ret res[opt[*Abi], Fail].ok{opt[*Abi].some{b.ok}};
}

# the form of code signature the loader of `h` checks, none where it takes
# none
pub fun signature_form(h: *Host) opt[Signed] {
    if (sel h.signing.optional) { ret opt[Signed].some{h.signing.optional}; }
    or (sel h.signing.required) { ret opt[Signed].some{h.signing.required}; }
    ret opt[Signed].none{};
}

# the code signature an image for `h` carries, as `asked` states or else
# as the host requires, none for an image that carries none. asking for one
# the host takes none of, or for none where it requires one, is refused
pub fun signs(h: *Host, asked: opt[bool]) res[opt[Signed], Fail] {
    var yes: bool = false;
    var no:  bool = false;
    if (sel asked.some) {
        yes = asked.some;
        no  = !asked.some;
    }
    if (sel h.signing.none) {
        if (yes) { ret res[opt[Signed], Fail].err{fail.about(fail.unsupported("the system's loader takes no code signature"), h.system.name)}; }
        ret res[opt[Signed], Fail].ok{opt[Signed].none{}};
    }
    or (sel h.signing.required) {
        if (no) { ret res[opt[Signed], Fail].err{fail.about(fail.unsupported("the system's loader runs no image without a code signature"), h.system.name)}; }
        ret res[opt[Signed], Fail].ok{opt[Signed].some{h.signing.required}};
    }
    val form: Signed = h.signing.optional;
    if (yes) { ret res[opt[Signed], Fail].ok{opt[Signed].some{form}}; }
    ret res[opt[Signed], Fail].ok{opt[Signed].none{}};
}

# the instruction set floor of `h`, in masc's selection spelling. a host
# that states none, as every freestanding one, is refused naming the system,
# and the target must state one itself
pub fun floor(h: *Host) res[str, Fail] {
    if (sel h.floor.none) { ret res[str, Fail].err{fail.about(fail.unsupported("the system states no instruction set floor, so the target must state one"), h.system.name)}; }
    ret res[str, Fail].ok{h.floor.some};
}

# the symbol the loader of `h` provides in the role `r`, refused naming the
# role and the system when it states none
pub fun symbol_of(h: *Host, r: *Role) res[str, Fail] {
    var i: usize = 0;
    for (i < h.symbol_count) {
        if (h.symbols[i].role == r) { ret res[str, Fail].ok{h.symbols[i].name}; }
        i = i + 1;
    }
    ret res[str, Fail].err{fail.about(fail.in_record(fail.unsupported("the system's loader provides no symbol in the role"), r.name), h.system.name)};
}

# the symbol the loaders of `s` provide in the role `r`, as an object names
# it before a host is chosen. refused when no host of the system states one
# or two state it differently
pub fun system_symbol(s: *System, r: *Role) res[str, Fail] {
    var found: opt[str] = opt[str].none{};
    var h:     usize    = 0;
    for (h < s.host_count) {
        val n: res[str, Fail] = symbol_of(?s.hosts[h], r);
        h = h + 1;
        if (sel n.err)                                       { cnt; }
        if (sel found.some && !str_equals(found.some, n.ok)) { ret res[str, Fail].err{fail.about(fail.in_record(fail.internal("two hosts of the system name the role's symbol differently"), r.name), s.name)}; }
        found = opt[str].some{n.ok};
    }
    if (sel found.some) { ret res[str, Fail].ok{found.some}; }
    ret res[str, Fail].err{fail.about(fail.in_record(fail.unsupported("the system's loader provides no symbol in the role"), r.name), s.name)};
}
