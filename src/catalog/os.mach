# the operating system catalog
#
# a system is a row of loader facts, read through the same accessors whatever
# the system. code branches on what a row declares, never on which system it
# is. calling conventions and data layout are mirl's and have no field here.
# each system's row is in its own file under os, and os/list enumerates them.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.catalog.arch.Arch;
use mink.catalog.format.Code;
use mink.catalog.format.Format;

pub def Caps: u64;

# executables are position independent unless asked otherwise
pub val PIE_DEFAULT: Caps = 1;
# the system runs AArch64 code with data independent timing enabled
pub val DIT_GUARANTEED: Caps = 2;

# a version as a format writes it, such as LC_BUILD_VERSION's minos
pub rec Version {
    major: u16;
    minor: u8;
    patch: u8;
}

# what a system says for one architecture it runs
# ---
# arch:         the architecture
# interpreter:  the program loader's path, nil where there is none
# libdirs:      the directories searched for libraries, in order
# libdir_count: how many
# image_base:   the address an image is linked at by default
# page_size:    the page size images are aligned to
# caps:         the capabilities the system declares for this architecture
pub rec Host {
    arch:         *Arch;
    interpreter:  str;
    libdirs:      *str;
    libdir_count: usize;
    image_base:   u64;
    page_size:    u64;
    caps:         Caps;
}

# name:                the system's spelling
# codes:               how each format names the system, such as ELF's
#                      EI_OSABI, a Mach-O platform or a PE subsystem
# code_count:          how many codes
# hosts:               the architectures the system runs
# host_count:          how many
# entry:               the entry symbol, nil where the system fixes none
# mapped:              whether a loader maps the image at all
# formats:             the output formats the system accepts, the default first
# format_count:        how many
# libraries:           the libraries a program links by default
# library_count:       how many
# framework_dirs:      the directories searched for frameworks
# framework_dir_count: how many
# min_version:         the oldest system version an image declares it runs on
pub rec Os {
    name:                str;
    codes:               *Code;
    code_count:          usize;
    hosts:               *Host;
    host_count:          usize;
    entry:               str;
    mapped:              bool;
    formats:             **Format;
    format_count:        usize;
    libraries:           *str;
    library_count:       usize;
    framework_dirs:      *str;
    framework_dir_count: usize;
    min_version:         Version;
}

# what `o` says for `a`, refused when the system does not run it
pub fun host(o: *Os, a: *Arch) res[*Host, Fail] {
    var i: usize = 0;
    for (i < o.host_count) {
        if (o.hosts[i].arch == a) { ret res[*Host, Fail].ok{?o.hosts[i]}; }
        i = i + 1;
    }
    ret res[*Host, Fail].err{fail.unsupported("the operating system does not run this architecture")};
}

# how `f` names `o`, none when it does not
pub fun code(o: *Os, f: *Format) opt[Code] {
    var k: usize = 0;
    for (k < o.code_count) {
        if (o.codes[k].format == f) { ret opt[Code].some{o.codes[k]}; }
        k = k + 1;
    }
    ret opt[Code].none{};
}

# whether `o` accepts `f` as an output format
pub fun accepts(o: *Os, f: *Format) bool {
    var k: usize = 0;
    for (k < o.format_count) {
        if (o.formats[k] == f) { ret true; }
        k = k + 1;
    }
    ret false;
}

# whether host `h` declares every bit of `c`
pub fun host_has(h: *Host, c: Caps) bool {
    ret (h.caps & c) == c;
}
