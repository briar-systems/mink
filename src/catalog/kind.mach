# the kinds of file an input can be
#
# a format's registration answers the kind of every model it reads with one of
# these rows, and whoever takes the input asks the row's capabilities, never
# compares it against a constant. a kind joins by adding a row. a container
# answers its own kind, and each file it holds answers its own through the
# member's format.
#
# these are what a file is. the kinds a link builds are the link's own rows,
# in mink.link.kind.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.fail;
use mink.fail.Fail;
use mink.index;

pub def Caps: u64;

# a link takes its sections, symbols and relocations as an object, through
# the neutral object
pub val OBJECT: Caps = 0x1;
# it holds other files, each of which answers its own kind
pub val CONTAINER: Caps = 0x2;
# a link binds references to what it exports, as a library linked against
pub val BINDS: Caps = 0x4;
# a loader maps it into another image at run time
pub val LOADED: Caps = 0x8;
# it runs from an entry point
pub val ENTERED: Caps = 0x10;
# its loader may place it at any address
pub val PIC: Caps = 0x20;

# name: the kind's spelling in a diagnostic and on the command line
# caps: the capabilities the kind declares
pub rec Kind {
    name: str;
    caps: Caps;
}

# an object a link takes as input: an ELF ET_REL, a COFF object, a Mach-O
# MH_OBJECT, a wasm object with a linking section
pub val RELOCATABLE: Kind = Kind{name: "relocatable", caps: OBJECT};
# an executable at a fixed address
pub val EXECUTABLE: Kind = Kind{name: "executable", caps: ENTERED};
# an executable its loader may place at any address
pub val PIE: Kind = Kind{name: "pie", caps: ENTERED | PIC};
# a library a loader maps into another image and a link binds against: an ELF
# shared object, a Mach-O dylib, a PE DLL
pub val SHARED: Kind = Kind{name: "shared", caps: BINDS | LOADED | PIC};
# an image that is both a position independent executable and a shared
# library, as an ELF ET_DYN with an entry point and no DF_1_PIE is
pub val PIE_SHARED: Kind = Kind{name: "pie-shared", caps: ENTERED | BINDS | LOADED | PIC};
# code a loader maps into a running image that no link binds against, as a
# Mach-O bundle or kernel extension is
pub val BUNDLE: Kind = Kind{name: "bundle", caps: LOADED | PIC};
# a library's interface a link binds against and no loader maps, as a Mach-O
# dylib stub or a COFF short import object is
pub val STUB: Kind = Kind{name: "stub", caps: BINDS};
# the program that loads the others, as Mach-O's MH_DYLINKER is
pub val INTERPRETER: Kind = Kind{name: "interpreter", caps: ENTERED | PIC};
# a module a runtime instantiates rather than a loader maps, as a wasm or a
# SPIR-V module is
pub val MODULE: Kind = Kind{name: "module", caps: ENTERED};
# the memory of a process, as an ELF ET_CORE or a Mach-O MH_CORE is
pub val CORE: Kind = Kind{name: "core", caps: 0};
# the debug information of another image, as a Mach-O MH_DSYM is
pub val DEBUG: Kind = Kind{name: "debug", caps: 0};
# a static library: an archive of members
pub val ARCHIVE: Kind = Kind{name: "archive", caps: CONTAINER};
# a universal file holding one thin file per architecture, as a fat Mach-O is
pub val UNIVERSAL: Kind = Kind{name: "universal", caps: CONTAINER};
# a set of images in one file, as a Mach-O MH_FILESET is
pub val FILESET: Kind = Kind{name: "fileset", caps: CONTAINER};

val ROW_COUNT: usize            = 14;
val ROWS:      [ROW_COUNT]*Kind = [ROW_COUNT]*Kind{
    ?RELOCATABLE, ?EXECUTABLE, ?PIE, ?SHARED, ?PIE_SHARED, ?BUNDLE, ?STUB,
    ?INTERPRETER, ?MODULE, ?CORE, ?DEBUG, ?ARCHIVE, ?UNIVERSAL, ?FILESET,
};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Kind {
    ret ROWS[index];
}

# the rows ascending by name
val NAMES: [ROW_COUNT]*Kind = [ROW_COUNT]*Kind{
    ?ARCHIVE, ?BUNDLE, ?CORE, ?DEBUG, ?EXECUTABLE, ?FILESET, ?INTERPRETER,
    ?MODULE, ?PIE, ?PIE_SHARED, ?RELOCATABLE, ?SHARED, ?STUB, ?UNIVERSAL,
};

fun order_names(a: **Kind, b: **Kind) i64 {
    ret str_compare(a[0].name, b[0].name);
}

pub fun by_name(name: str) res[*Kind, Fail] {
    var probe: Kind       = Kind{name: name};
    val row:   opt[*Kind] = index.find[Kind](?NAMES[0], ROW_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*Kind, Fail].err{fail.unsupported("no kind of file has this name")}; }
    ret res[*Kind, Fail].ok{row.some};
}

pub fun has(k: *Kind, c: Caps) bool {
    ret (k.caps & c) == c;
}

test kind__name_index_finds_every_row {
    val rows:  [ROW_COUNT]*Kind = ROWS;
    val built: err[Fail]        = index.verify[Kind](?NAMES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_names);
    if (sel built.err) { ret 1; }
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val r: res[*Kind, Fail] = by_name(ROWS[i].name);
        if (sel r.err)                                       { ret 2; }
        if (r.ok != ROWS[i])                                 { ret 2; }
        if (has(ROWS[i], OBJECT) && has(ROWS[i], CONTAINER)) { ret 3; }
        i = i + 1;
    }
    val miss: res[*Kind, Fail] = by_name("a.out");
    if (sel miss.ok) { ret 4; }
    ret 0;
}
