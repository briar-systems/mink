# how the settle phase combines the format facts of its inputs
#
# a format fact is keyed by its format and the format's own key. each format
# states, one row per key, how the facts of that key from every input combine
# into the facts the output carries, so settle reads a row and never asks
# which format or key it is. a key no row names is refused, never guessed.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;

# how the facts of one key combine
# ---
# local:   the fact is scoped to its object, as one describing a section
#          or symbol of it is, and travels with the input, so settle passes
#          it by and the output's settled facts carry none of it. every other
#          rule is scoped to the image the output is
# equal:   every input that states the fact states the same, or the link is
#          refused
# highest: the fact's values rank in the order, and the highest any input
#          states is kept. the lowest value of the order is its bottom, which
#          places no constraint whether an input states it or not. a value
#          outside the order is refused only against another value that is
#          not the bottom and differs
# drained: the fact holds what the trait rows left of a field, so one whose
#          data is all zero bytes carries nothing more and any other is
#          refused as unsupported
pub tag Combine: u8 {
    local;
    equal;
    highest: *Order;
    drained;
}

# the values of a fact, lowest first
pub rec Order {
    values: *u64;
    count:  usize;
}

# key:     the format's key
# keyed:   the fact's value names what it is, as a property type does, so
#          facts of one key and different values are different facts.
#          otherwise the value is what the fact states
# combine: how the inputs' facts combine
pub rec Rule {
    key:     u32;
    keyed:   bool;
    combine: Combine;
}

# the rows of one format, ascending by key
pub rec Rules {
    rows:  *Rule;
    count: usize;
}

# the rules of a format whose objects carry no facts settle combines
pub val NONE: Rules = Rules{rows: nil, count: 0};

fun order(a: *Rule, b: *Rule) i64 {
    if (a.key < b.key) { ret -1; }
    if (a.key > b.key) { ret 1; }
    ret 0;
}

# the row of `key`, none when the format states none
pub fun rule_of(r: *Rules, key: u32) opt[*Rule] {
    if (r.count == 0) { ret opt[*Rule].none{}; }
    var probe: Rule           = Rule{key: key};
    val at:    SearchPosition = sort.binary_search_by[Rule](r.rows, r.count, ?probe, order);
    if (sel at.found) { ret opt[*Rule].some{?r.rows[at.found]}; }
    ret opt[*Rule].none{};
}

# where `value` ranks in `o`, none when the order does not hold it
fun rank(o: *Order, value: u64) opt[usize] {
    var i: usize = 0;
    for (i < o.count) {
        if (o.values[i] == value) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# whether `value` is the bottom of `o`, its lowest value
pub fun bottom(o: *Order, value: u64) bool {
    ret o.values[0] == value;
}

# the value a highest row over `o` keeps when the link holds `held` and an
# input states `next`, none when the two are refused
pub fun highest(o: *Order, held: u64, next: u64) opt[u64] {
    if (held == next || bottom(o, next)) { ret opt[u64].some{held}; }
    if (bottom(o, held))                 { ret opt[u64].some{next}; }
    val was: opt[usize] = rank(o, held);
    val now: opt[usize] = rank(o, next);
    if (sel was.some) {
        if (sel now.some) {
            if (now.some < was.some) { ret opt[u64].some{held}; }
            ret opt[u64].some{next};
        }
    }
    ret opt[u64].none{};
}

# whether a highest row ranks an unkeyed fact's values in an order of at
# least two values, each once
fun ordered(r: *Rule) bool {
    if (!(sel r.combine.highest)) { ret true; }
    val o: *Order = r.combine.highest;
    if (r.keyed || o == nil || o.count < 2) { ret false; }
    var i: usize = 0;
    for (i < o.count) {
        val at: opt[usize] = rank(o, o.values[i]);
        if (sel at.none)  { ret false; }
        if (at.some != i) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the rows ascend strictly by key, so each key has one row, and each
# highest row states a usable order
pub fun check(r: *Rules) err[Fail] {
    var i: usize = 0;
    for (i < r.count) {
        if (i > 0 && r.rows[i - 1].key >= r.rows[i].key) {
            ret err[Fail].err{fail.valued(fail.internal("format fact rows do not ascend by key"), r.rows[i].key::i128)};
        }
        if (!ordered(?r.rows[i])) {
            ret err[Fail].err{fail.valued(fail.internal("a format fact row ranks its values in no usable order"), r.rows[i].key::i128)};
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}
