# the one merge vocabulary of trait axes and format facts
#
# a rule says how the values a link's inputs state of one trait axis or one
# format fact combine into the value the output carries. an axis names its
# rule on its row, and a format names one per fact key, so settle reads a rule
# and never asks which axis, format or key it is. every rule is order-free:
# the same inputs in any order give the same value, or are refused alike.
# which rules fit which values is checked where the rows are, by
# trait.consistent for an axis and by `check` for a format's fact rows. a key
# no row names is refused, never guessed.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Span;
use mink.base.table;
use mink.base.table.Table;
use mink.catalog.isa;
use mink.catalog.isa.Grammar;

# how the values of one axis or fact combine
# ---
# equal:        every input that states one states the same, or the link is
#               refused
# union:        a flag is set when any input sets it
# intersection: a flag is set only when every input that states it sets it
# ordered:      choices merge into the least choice that contains both, by
#               the relation their rows state, and are refused when none does
# extensions:   ISA strings of the grammar merge into every extension either
#               names at the higher version, and strings of different
#               register widths are refused
# agreed:       the value every input states is kept, and when inputs state
#               different values the link drops it, as an ABI that resolves
#               the disagreement so has it
# highest:      the values rank in the order, and the highest any input
#               states is kept. the lowest value of the order is its bottom,
#               which places no constraint whether an input states it or not.
#               a value outside the order is refused only against another
#               value that is not the bottom and differs
# set:          sets of named members merge member by member by the policy,
#               a member one input leaves out taking the other's state
# local:        a fact scoped to its object, as one describing a section or
#               symbol of it is, travels with the input, so the output's
#               settled facts carry none of it
# drained:      a fact holding what the trait rows left of a field carries
#               nothing more when its data is all zero bytes, and any other
#               is refused as unsupported
# refused:      a fact the link cannot carry, as an attribute no row knows
#               that a tool must not ignore, so an input stating one is
#               refused as unsupported
# dropped:      a fact the output never carries, as an attribute no row
#               knows that a tool may ignore, which the link drops and
#               reports
pub tag Merge: u8 {
    equal;
    union;
    intersection;
    ordered;
    extensions: *Grammar;
    agreed;
    highest: *Order;
    set:     *Policy;
    local;
    drained;
    refused;
    dropped;
}

pub val EQUAL:        Merge = Merge.equal{};
pub val UNION:        Merge = Merge.union{};
pub val INTERSECTION: Merge = Merge.intersection{};
pub val ORDERED:      Merge = Merge.ordered{};
pub val AGREED:       Merge = Merge.agreed{};
pub val LOCAL:        Merge = Merge.local{};
pub val DRAINED:      Merge = Merge.drained{};
pub val REFUSED:      Merge = Merge.refused{};
pub val DROPPED:      Merge = Merge.dropped{};

# what merging two values gives
# ---
# refused: the two cannot be linked together
# dropped: the link carries no value
# kept:    the value the link carries
pub tag Joined[V]: u8 {
    refused;
    dropped;
    kept: V;
}

# what merging two values held as bytes gives
# ---
# refused: the two cannot be linked together
# dropped: the link carries no value
# held:    the value already held stands
# written: a new value, at this place of the bytes the merge wrote to
pub tag Merged: u8 {
    refused;
    dropped;
    held;
    written: Span;
}

# the values of a highest rule, lowest first
pub rec Order {
    values: *u64;
    count:  usize;
}

# a state a member of a set takes, and the byte that marks it
pub rec Mark {
    mark: u8;
    name: str;
}

# what a member held in state `held` and stated in state `next` merges into,
# a `kept` of zero for refused
pub rec Meet {
    held: u8;
    next: u8;
    kept: u8;
}

# how the members of a set merge. a set is written as its members ascending
# by name, each its mark and its name, separated by `separator`
# ---
# marks:      the states a member takes
# mark_count: how many
# meets:      what each two states merge into, both orders listed
# meet_count: how many
# separator:  the byte between members, which no name holds
pub rec Policy {
    marks:      *Mark;
    mark_count: usize;
    meets:      *Meet;
    meet_count: usize;
    separator:  u8;
}

# key:   the format's key
# keyed: the fact's value names what it is, as a property type does, so
#        facts of one key and different values are different facts.
#        otherwise the value is what the fact states
# merge: how the inputs' facts combine
pub rec Rule {
    key:   u32;
    keyed: bool;
    merge: *Merge;
}

# the fact rows of one format, ascending by key
pub rec Rules {
    rows:  *Rule;
    count: usize;
}

# the rules of a format whose objects carry no facts settle combines
pub val NONE: Rules = Rules{rows: nil, count: 0};

fun order(a: *Rule, b: *Rule) i64 {
    if (a.key < b.key) { ret -1; }
    if (a.key > b.key) { ret 1; }
    ret 0;
}

# the row of `key`, none when the format states none
pub fun rule_of(r: *Rules, key: u32) opt[*Rule] {
    if (r.count == 0) { ret opt[*Rule].none{}; }
    var probe: Rule           = Rule{key: key};
    val at:    SearchPosition = sort.binary_search_by[Rule](r.rows, r.count, ?probe, order);
    if (sel at.found) { ret opt[*Rule].some{?r.rows[at.found]}; }
    ret opt[*Rule].none{};
}

# where `value` ranks in `o`, none when the order does not hold it
fun rank(o: *Order, value: u64) opt[usize] {
    var i: usize = 0;
    for (i < o.count) {
        if (o.values[i] == value) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# whether `value` is the bottom of `o`, its lowest value
pub fun bottom(o: *Order, value: u64) bool {
    ret o.values[0] == value;
}

# the value a highest rule over `o` keeps when the link holds `held` and an
# input states `next`, none when the two are refused
pub fun highest(o: *Order, held: u64, next: u64) opt[u64] {
    if (held == next || bottom(o, next)) { ret opt[u64].some{held}; }
    if (bottom(o, held))                 { ret opt[u64].some{next}; }
    val was: opt[usize] = rank(o, held);
    val now: opt[usize] = rank(o, next);
    if (sel was.some) {
        if (sel now.some) {
            if (now.some < was.some) { ret opt[u64].some{held}; }
            ret opt[u64].some{next};
        }
    }
    ret opt[u64].none{};
}

# whether `o` ranks at least two values, each once
pub fun ranked(o: *Order) bool {
    if (o == nil || o.count < 2) { ret false; }
    var i: usize = 0;
    for (i < o.count) {
        val at: opt[usize] = rank(o, o.values[i]);
        if (sel at.none)  { ret false; }
        if (at.some != i) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether a rule fits a format fact: a fact merges by local, equal, drained,
# refused or dropped, or by highest over a usable order when it is unkeyed
fun fits_fact(r: *Rule) bool {
    val m: *Merge = r.merge;
    if (m == nil)                       { ret false; }
    if (sel m.local || sel m.equal)     { ret true; }
    if (sel m.drained)                  { ret true; }
    if (sel m.refused || sel m.dropped) { ret true; }
    if (sel m.highest)                  { ret !r.keyed && ranked(m.highest); }
    ret false;
}

# whether the rows ascend strictly by key, so each key has one row, and each
# row's rule fits a fact
pub fun check(r: *Rules) err[Fail] {
    var i: usize = 0;
    for (i < r.count) {
        if (i > 0 && r.rows[i - 1].key >= r.rows[i].key) {
            ret err[Fail].err{fail.valued(fail.internal("format fact rows do not ascend by key"), r.rows[i].key::i128)};
        }
        if (!fits_fact(?r.rows[i])) {
            ret err[Fail].err{fail.valued(fail.internal("a format fact row names a rule no fact merges by"), r.rows[i].key::i128)};
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the state `mark` names in `p`, none when it names none
fun mark_of(p: *Policy, mark: u8) opt[*Mark] {
    var i: usize = 0;
    for (i < p.mark_count) {
        if (p.marks[i].mark == mark) { ret opt[*Mark].some{?p.marks[i]}; }
        i = i + 1;
    }
    ret opt[*Mark].none{};
}

# what a member held in `held` and stated in `next` merges into, zero when
# refused or when the policy states no meet of the two
fun meet(p: *Policy, held: u8, next: u8) u8 {
    var i: usize = 0;
    for (i < p.meet_count) {
        if (p.meets[i].held == held && p.meets[i].next == next) { ret p.meets[i].kept; }
        i = i + 1;
    }
    ret 0;
}

# a member of a written set: its mark and where its name lies
rec Member {
    mark: u8;
    name: Bytes;
}

# the member of `s` that begins at `at`, and where the next begins
fun member_at(p: *Policy, s: Bytes, at: usize, out: *Member) usize {
    var end: usize = at;
    for (end < s.len && s.data[end] != p.separator) {
        end = end + 1;
    }
    out.mark = s.data[at];
    out.name = Bytes{data: ?s.data[at + 1], len: end - at - 1};
    if (end < s.len) { ret end + 1; }
    ret end;
}

# the order of two names, by their bytes
fun compare_names(a: Bytes, b: Bytes) i64 {
    var i: usize = 0;
    for (i < a.len && i < b.len) {
        if (a.data[i] < b.data[i]) { ret -1; }
        if (a.data[i] > b.data[i]) { ret 1; }
        i = i + 1;
    }
    if (a.len < b.len) { ret -1; }
    if (a.len > b.len) { ret 1; }
    ret 0;
}

# whether `s` is a set written as `p` writes one: members ascending by name,
# each once, each a mark of the policy and a name of at least one byte
pub fun written_set(p: *Policy, s: Bytes) bool {
    if (s.len == 0)                       { ret true; }
    if (s.data[s.len - 1] == p.separator) { ret false; }
    var at:   usize = 0;
    var last: Bytes = Bytes{data: nil, len: 0};
    var any:  bool  = false;
    for (at < s.len) {
        if (s.data[at] == p.separator) { ret false; }
        var m: Member;
        at = member_at(p, s, at, ?m);
        val known: opt[*Mark] = mark_of(p, m.mark);
        if (sel known.none)                          { ret false; }
        if (m.name.len == 0)                         { ret false; }
        if (any && compare_names(last, m.name) >= 0) { ret false; }
        last = m.name;
        any  = true;
    }
    ret true;
}

# whether a policy is consistent: its marks are distinct, none is zero or the
# separator, and each two marks meet once in each order, alike both ways
pub fun consistent_policy(p: *Policy) bool {
    var i: usize = 0;
    for (i < p.mark_count) {
        val m: u8 = p.marks[i].mark;
        if (m == 0 || m == p.separator) { ret false; }
        var j: usize = 0;
        for (j < i) {
            if (p.marks[j].mark == m) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < p.meet_count) {
        val e: *Meet      = ?p.meets[i];
        val h: opt[*Mark] = mark_of(p, e.held);
        val n: opt[*Mark] = mark_of(p, e.next);
        if (sel h.none || sel n.none) { ret false; }
        if (e.kept != 0) {
            val k: opt[*Mark] = mark_of(p, e.kept);
            if (sel k.none) { ret false; }
        }
        if (meet(p, e.next, e.held) != e.kept) { ret false; }
        var j: usize = 0;
        for (j < i) {
            if (p.meets[j].held == e.held && p.meets[j].next == e.next) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret p.meet_count == p.mark_count * p.mark_count;
}

fun put_member(out: *Table[u8], p: *Policy, first: bool, mark: u8, name: Bytes) err[Fail] {
    if (!first) {
        val s: res[table.Id[u8], Fail] = table.push[u8](out, p.separator);
        if (sel s.err) { ret err[Fail].err{s.err}; }
    }
    val m: res[table.Id[u8], Fail] = table.push[u8](out, mark);
    if (sel m.err) { ret err[Fail].err{m.err}; }
    val n: res[table.Id[u8], Fail] = table.extend[u8](out, name.data, name.len);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    ret err[Fail].ok{};
}

# merge the sets `x` and `y` by `p` into `out`, false when a member's states
# are refused
fun merge_set(p: *Policy, x: Bytes, y: Bytes, out: *Table[u8]) res[bool, Fail] {
    var i:     usize = 0;
    var j:     usize = 0;
    var first: bool  = true;
    var a:     Member;
    var b:     Member;
    var ni:    usize = 0;
    var nj:    usize = 0;
    if (i < x.len) { ni = member_at(p, x, i, ?a); }
    if (j < y.len) { nj = member_at(p, y, j, ?b); }
    for (i < x.len || j < y.len) {
        var c: i64 = 0;
        if (i >= x.len) { c = 1; }
        or (j >= y.len) { c = -1; }
        or              { c = compare_names(a.name, b.name); }
        var w: err[Fail] = err[Fail].ok{};
        if (c < 0) {
            w = put_member(out, p, first, a.mark, a.name);
            i = ni;
            if (i < x.len) { ni = member_at(p, x, i, ?a); }
        }
        or (c > 0) {
            w = put_member(out, p, first, b.mark, b.name);
            j = nj;
            if (j < y.len) { nj = member_at(p, y, j, ?b); }
        }
        or {
            val k: u8 = meet(p, a.mark, b.mark);
            if (k == 0) { ret res[bool, Fail].ok{false}; }
            w = put_member(out, p, first, k, a.name);
            i = ni;
            j = nj;
            if (i < x.len) { ni = member_at(p, x, i, ?a); }
            if (j < y.len) { nj = member_at(p, y, j, ?b); }
        }
        if (sel w.err) { ret res[bool, Fail].err{w.err}; }
        first = false;
    }
    ret res[bool, Fail].ok{true};
}

fun unmergeable() Fail {
    ret fail.internal("bytes merge by equal, agreed, extensions or set");
}

# what the link carries by the rule `m` when it holds the bytes `held` and an
# input states the bytes `next`. a new value is appended to `out`, which
# `held` may lie in, and nothing is appended when the held value stands or
# the two are refused
pub fun merge_bytes(a: *A.Allocator, m: *Merge, held: Bytes, next: Bytes, out: *Table[u8]) res[Merged, Fail] {
    if (sel m.equal) {
        if (store.same_bytes(held, next)) { ret res[Merged, Fail].ok{Merged.held{}}; }
        ret res[Merged, Fail].ok{Merged.refused{}};
    }
    or (sel m.agreed) {
        if (store.same_bytes(held, next)) { ret res[Merged, Fail].ok{Merged.held{}}; }
        ret res[Merged, Fail].ok{Merged.dropped{}};
    }
    var scratch: Table[u8]       = table.make[u8](a);
    var r:       res[bool, Fail] = res[bool, Fail].err{unmergeable()};
    if (sel m.extensions) { r = isa.merge(a, m.extensions, held, next, ?scratch); }
    or (sel m.set)        { r = merge_set(m.set, held, next, ?scratch); }
    var out_m: res[Merged, Fail] = res[Merged, Fail].ok{Merged.refused{}};
    if (sel r.err) { out_m = res[Merged, Fail].err{r.err}; }
    or (sel r.ok && r.ok) {
        val made: Bytes = Bytes{data: table.items[u8](?scratch), len: table.count[u8](?scratch)};
        if (store.same_bytes(made, held)) { out_m = res[Merged, Fail].ok{Merged.held{}}; }
        or {
            val start: usize                   = table.count[u8](out);
            val at:    res[table.Id[u8], Fail] = table.extend[u8](out, made.data, made.len);
            if (sel at.err) { out_m = res[Merged, Fail].err{at.err}; }
            or              { out_m = res[Merged, Fail].ok{Merged.written{Span{start: start, len: made.len}}}; }
        }
    }
    val rel: err[Fail] = table.release[u8](?scratch);
    if (sel out_m.err) { ret out_m; }
    if (sel rel.err)   { ret res[Merged, Fail].err{rel.err}; }
    ret out_m;
}

test merge__sets_merge_member_by_member_by_their_policy {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # wasm target features: a feature used and one disallowed are refused
    # together, and a feature one input leaves out takes the other's state
    val marks:  [2]Mark = [2]Mark{Mark{mark: '+', name: "used"}, Mark{mark: '-', name: "disallowed"}};
    val meets:  [4]Meet = [4]Meet{Meet{held: '+', next: '+', kept: '+'}, Meet{held: '+', next: '-', kept: 0}, Meet{held: '-', next: '+', kept: 0}, Meet{held: '-', next: '-', kept: '-'}};
    val policy: Policy  = Policy{marks: ?marks[0], mark_count: 2, meets: ?meets[0], meet_count: 4, separator: ','};
    val rule:   Merge   = Merge.set{?policy};
    if (!consistent_policy(?policy)) { ret 1; }

    val x:  str   = "+atomics,-simd128";
    val y:  str   = "+atomics,+bulk-memory";
    val z:  str   = "+simd128";
    val bx: Bytes = Bytes{data: x::*u8, len: 17};
    val by: Bytes = Bytes{data: y::*u8, len: 21};
    val bz: Bytes = Bytes{data: z::*u8, len: 8};
    if (!written_set(?policy, bx) || !written_set(?policy, by)) { ret 2; }
    val unsorted: str = "+simd128,+atomics";
    if (written_set(?policy, Bytes{data: unsorted::*u8, len: 17})) { ret 2; }

    var out: Table[u8]         = table.make[u8](a);
    val m:   res[Merged, Fail] = merge_bytes(a, ?rule, bx, by, ?out);
    if (sel m.err)         { ret 3; }
    if (!sel m.ok.written) { ret 3; }
    val want: str = "+atomics,+bulk-memory,-simd128";
    if (!store.same_bytes(Bytes{data: table.items[u8](?out), len: table.count[u8](?out)}, Bytes{data: want::*u8, len: 30})) { ret 4; }
    val clash: res[Merged, Fail] = merge_bytes(a, ?rule, bx, bz, ?out);
    if (sel clash.err)         { ret 5; }
    if (!sel clash.ok.refused) { ret 5; }
    val same: res[Merged, Fail] = merge_bytes(a, ?rule, bx, bx, ?out);
    if (sel same.err)      { ret 6; }
    if (!sel same.ok.held) { ret 6; }

    val r: err[Fail] = table.release[u8](?out);
    if (sel r.err)             { ret 7; }
    if (T.live_count(?t) != 0) { ret 7; }
    T.dnit(?t);
    ret 0;
}
