# every architecture of the catalog, and the lookups that read them
#
# the one place the rows are enumerated. a new architecture is a family
# file's row and its lines here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.store.Bytes;
use mink.bytes.reader;
use mink.catalog.arch;
use mink.catalog.arch.Abi;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Code;
use mink.catalog.arch.Family;
use mink.catalog.arch.Ident;
use mink.catalog.arch.Pointer;
use mink.catalog.arch.Stated;
use mink.catalog.arch.Unwind;
use mink.catalog.arch.aarch64;
use mink.catalog.arch.riscv;
use mink.catalog.arch.spirv;
use mink.catalog.arch.wasm;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.isa;
use mink.catalog.isa.Base;
use mink.catalog.isa.Grammar;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Trait;

# every trait axis, and its index by name, the key trait sets and format
# tables are kept in
val AXIS_COUNT: usize             = 56;
val AXES:       [AXIS_COUNT]*Axis = [AXIS_COUNT]*Axis{?riscv.RISCV_FLOAT_ABI, ?riscv.RISCV_RVC, ?riscv.RISCV_RVE, ?riscv.RISCV_TSO, ?riscv.RISCV_ARCH, ?riscv.RISCV_STACK_ALIGN, ?riscv.RISCV_UNALIGNED_ACCESS, ?riscv.RISCV_PRIV_SPEC, ?riscv.RISCV_PRIV_SPEC_MINOR, ?riscv.RISCV_PRIV_SPEC_REVISION, ?riscv.RISCV_ATOMIC_ABI, ?riscv.RISCV_X3_REG_USAGE, ?riscv.RISCV_CFI_LP_UNLABELED, ?riscv.RISCV_CFI_SS, ?riscv.RISCV_CFI_LP_FUNC_SIG, ?aarch64.AARCH64_BTI, ?aarch64.AARCH64_PAC, ?aarch64.AARCH64_GCS, ?aarch64.AARCH64_PAUTH_PLATFORM, ?aarch64.AARCH64_PAUTH_VERSION, ?x86.X86_IBT, ?x86.X86_SHSTK, ?x86.X86_LAM_U48, ?x86.X86_LAM_U57, ?x86.X86_ISA_NEEDED_BASELINE, ?x86.X86_ISA_NEEDED_V2, ?x86.X86_ISA_NEEDED_V3, ?x86.X86_ISA_NEEDED_V4, ?x86.X86_ISA_USED_BASELINE, ?x86.X86_ISA_USED_V2, ?x86.X86_ISA_USED_V3, ?x86.X86_ISA_USED_V4, ?x86.X86_FEATURE_NEEDED_X86, ?x86.X86_FEATURE_NEEDED_X87, ?x86.X86_FEATURE_NEEDED_MMX, ?x86.X86_FEATURE_NEEDED_XMM, ?x86.X86_FEATURE_NEEDED_YMM, ?x86.X86_FEATURE_NEEDED_ZMM, ?x86.X86_FEATURE_NEEDED_FXSR, ?x86.X86_FEATURE_NEEDED_XSAVE, ?x86.X86_FEATURE_NEEDED_XSAVEOPT, ?x86.X86_FEATURE_NEEDED_XSAVEC, ?x86.X86_FEATURE_NEEDED_TMM, ?x86.X86_FEATURE_NEEDED_MASK, ?x86.X86_FEATURE_USED_X86, ?x86.X86_FEATURE_USED_X87, ?x86.X86_FEATURE_USED_MMX, ?x86.X86_FEATURE_USED_XMM, ?x86.X86_FEATURE_USED_YMM, ?x86.X86_FEATURE_USED_ZMM, ?x86.X86_FEATURE_USED_FXSR, ?x86.X86_FEATURE_USED_XSAVE, ?x86.X86_FEATURE_USED_XSAVEOPT, ?x86.X86_FEATURE_USED_XSAVEC, ?x86.X86_FEATURE_USED_TMM, ?x86.X86_FEATURE_USED_MASK};
val AXIS_NAMES: [AXIS_COUNT]*Axis = [AXIS_COUNT]*Axis{?aarch64.AARCH64_BTI, ?aarch64.AARCH64_GCS, ?aarch64.AARCH64_PAC, ?aarch64.AARCH64_PAUTH_PLATFORM, ?aarch64.AARCH64_PAUTH_VERSION, ?riscv.RISCV_ARCH, ?riscv.RISCV_ATOMIC_ABI, ?riscv.RISCV_CFI_LP_FUNC_SIG, ?riscv.RISCV_CFI_LP_UNLABELED, ?riscv.RISCV_CFI_SS, ?riscv.RISCV_FLOAT_ABI, ?riscv.RISCV_PRIV_SPEC, ?riscv.RISCV_PRIV_SPEC_MINOR, ?riscv.RISCV_PRIV_SPEC_REVISION, ?riscv.RISCV_RVC, ?riscv.RISCV_RVE, ?riscv.RISCV_STACK_ALIGN, ?riscv.RISCV_TSO, ?riscv.RISCV_UNALIGNED_ACCESS, ?riscv.RISCV_X3_REG_USAGE, ?x86.X86_FEATURE_NEEDED_FXSR, ?x86.X86_FEATURE_NEEDED_MASK, ?x86.X86_FEATURE_NEEDED_MMX, ?x86.X86_FEATURE_NEEDED_TMM, ?x86.X86_FEATURE_NEEDED_X86, ?x86.X86_FEATURE_NEEDED_X87, ?x86.X86_FEATURE_NEEDED_XMM, ?x86.X86_FEATURE_NEEDED_XSAVE, ?x86.X86_FEATURE_NEEDED_XSAVEC, ?x86.X86_FEATURE_NEEDED_XSAVEOPT, ?x86.X86_FEATURE_NEEDED_YMM, ?x86.X86_FEATURE_NEEDED_ZMM, ?x86.X86_FEATURE_USED_FXSR, ?x86.X86_FEATURE_USED_MASK, ?x86.X86_FEATURE_USED_MMX, ?x86.X86_FEATURE_USED_TMM, ?x86.X86_FEATURE_USED_X86, ?x86.X86_FEATURE_USED_X87, ?x86.X86_FEATURE_USED_XMM, ?x86.X86_FEATURE_USED_XSAVE, ?x86.X86_FEATURE_USED_XSAVEC, ?x86.X86_FEATURE_USED_XSAVEOPT, ?x86.X86_FEATURE_USED_YMM, ?x86.X86_FEATURE_USED_ZMM, ?x86.X86_IBT, ?x86.X86_ISA_NEEDED_BASELINE, ?x86.X86_ISA_NEEDED_V2, ?x86.X86_ISA_NEEDED_V3, ?x86.X86_ISA_NEEDED_V4, ?x86.X86_ISA_USED_BASELINE, ?x86.X86_ISA_USED_V2, ?x86.X86_ISA_USED_V3, ?x86.X86_ISA_USED_V4, ?x86.X86_LAM_U48, ?x86.X86_LAM_U57, ?x86.X86_SHSTK};

val ROW_COUNT: usize            = 10;
val ROWS:      [ROW_COUNT]*Arch = [ROW_COUNT]*Arch{?x86.X86_64, ?x86.X86, ?aarch64.AARCH64, ?riscv.RISCV64, ?riscv.RISCV32, ?riscv.RISCV64E, ?riscv.RISCV32E, ?wasm.WASM32, ?wasm.WASM64, ?spirv.SPIRV};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Arch {
    ret ROWS[index];
}

# the rows ascending by name
val NAMES: [ROW_COUNT]*Arch = [ROW_COUNT]*Arch{?aarch64.AARCH64, ?riscv.RISCV32, ?riscv.RISCV32E, ?riscv.RISCV64, ?riscv.RISCV64E, ?spirv.SPIRV, ?wasm.WASM32, ?wasm.WASM64, ?x86.X86, ?x86.X86_64};

# a code of a row and the row that holds it
# ---
# arch: the architecture that names itself by the code
# code: the code, a row of that architecture's codes
rec Coding {
    arch: *Arch;
    code: *Code;
}

val CODE_COUNT: usize = 18;

# every code of every row, ascending by format name, then by the value of the
# primary field
val CODINGS: [CODE_COUNT]Coding = [CODE_COUNT]Coding{
    Coding{arch: ?x86.X86, code: ?x86.X86_CODES[1]},
    Coding{arch: ?riscv.RISCV32, code: ?riscv.RV32_CODES[1]},
    Coding{arch: ?riscv.RISCV64, code: ?riscv.RV64_CODES[1]},
    Coding{arch: ?x86.X86_64, code: ?x86.X86_64_CODES[1]},
    Coding{arch: ?aarch64.AARCH64, code: ?aarch64.AARCH64_CODES[1]},
    Coding{arch: ?x86.X86, code: ?x86.X86_CODES[0]},
    Coding{arch: ?x86.X86_64, code: ?x86.X86_64_CODES[0]},
    Coding{arch: ?aarch64.AARCH64, code: ?aarch64.AARCH64_CODES[0]},
    Coding{arch: ?riscv.RISCV32, code: ?riscv.RV32_CODES[0]},
    Coding{arch: ?riscv.RISCV64, code: ?riscv.RV64_CODES[0]},
    Coding{arch: ?riscv.RISCV32E, code: ?riscv.RV32E_CODES[0]},
    Coding{arch: ?riscv.RISCV64E, code: ?riscv.RV64E_CODES[0]},
    Coding{arch: ?x86.X86, code: ?x86.X86_CODES[2]},
    Coding{arch: ?x86.X86_64, code: ?x86.X86_64_CODES[2]},
    Coding{arch: ?aarch64.AARCH64, code: ?aarch64.AARCH64_CODES[2]},
    Coding{arch: ?spirv.SPIRV, code: ?spirv.SPIRV_CODES[0]},
    Coding{arch: ?wasm.WASM32, code: ?wasm.WASM32_CODES[0]},
    Coding{arch: ?wasm.WASM64, code: ?wasm.WASM64_CODES[0]},
};

fun order_names(a: **Arch, b: **Arch) i64 {
    ret str_compare(a[0].name, b[0].name);
}

# the order of the codings: by format name, then by the primary field's value
fun order_key(f: *Format, primary: u64, c: *Coding) i64 {
    val n: i64 = str_compare(f.name, c.code.format.name);
    if (n != 0)                           { ret n; }
    if (primary < c.code.fields[0].value) { ret -1; }
    if (primary > c.code.fields[0].value) { ret 1; }
    ret 0;
}

fun order_coding(a: *Coding, b: *Coding) i64 {
    ret order_key(a.code.format, a.code.fields[0].value, b);
}

pub fun by_name(name: str) res[*Arch, Fail] {
    var probe: Arch       = Arch{name: name};
    val row:   opt[*Arch] = index.find[Arch](?NAMES[0], ROW_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*Arch, Fail].err{fail.unsupported("no architecture has this name")}; }
    ret res[*Arch, Fail].ok{row.some};
}

# whether `a` is a row of this catalog
pub fun member(a: *Arch) bool {
    if (a == nil) { ret false; }
    val row: res[*Arch, Fail] = by_name(a.name);
    if (sel row.err) { ret false; }
    ret row.ok == a;
}

# the one row whose code in the format of `s` names what `s` states. no row is
# refused as unsupported, and two rows naming it as a defect of the catalog,
# so a match never depends on row order
pub fun by_code(s: *Stated) res[*Arch, Fail] {
    ret coded(?CODINGS[0], CODE_COUNT, s);
}

fun coded(codings: *Coding, n: usize, s: *Stated) res[*Arch, Fail] {
    if (s.count == 0) { ret res[*Arch, Fail].err{fail.unsupported("no architecture has this machine code")}; }
    var lo: usize = 0;
    var hi: usize = n;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (order_key(s.format, s.values[0], ?codings[mid]) > 0) { lo = mid + 1; }
        or                                                       { hi = mid; }
    }
    var found: *Arch = nil;
    var i:     usize = lo;
    for (i < n && order_key(s.format, s.values[0], ?codings[i]) == 0) {
        if (arch.matches(codings[i].code, s)) {
            if (found != nil) { ret res[*Arch, Fail].err{fail.about(fail.internal("two architecture rows name one machine code"), found.name)}; }
            found = codings[i].arch;
        }
        i = i + 1;
    }
    if (found == nil) { ret res[*Arch, Fail].err{fail.unsupported("no architecture has this machine code")}; }
    ret res[*Arch, Fail].ok{found};
}

# the trait axis named `name`
pub fun axis_by_name(name: str) res[*Axis, Fail] {
    var probe: Axis       = Axis{name: name};
    val row:   opt[*Axis] = index.find[Axis](?AXIS_NAMES[0], AXIS_COUNT, ?probe, trait.order);
    if (sel row.none) { ret res[*Axis, Fail].err{fail.unsupported("no trait axis has this name")}; }
    ret res[*Axis, Fail].ok{row.some};
}

# whether a code is sound: it states at least one field, its first is the
# primary field stated exactly, no field twice, and no value bit outside its
# mask
fun code_sound(c: *Code) bool {
    if (c.count == 0 || c.count > arch.FIELD_COUNT)             { ret false; }
    if (c.fields[0].key != 0 || c.fields[0].mask != arch.EXACT) { ret false; }
    var i: usize = 0;
    for (i < c.count) {
        val f: *Ident = ?c.fields[i];
        if (f.key::usize >= arch.FIELD_COUNT || (f.value & ~f.mask) != 0) { ret false; }
        var j: usize = 0;
        for (j < i) {
            if (c.fields[j].key == f.key) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# whether two codes of one format can name one input: every field both state
# overlaps under both masks
fun overlap(a: *Code, b: *Code) bool {
    if (a.format != b.format) { ret false; }
    var i: usize = 0;
    for (i < a.count) {
        val f: *Ident = ?a.fields[i];
        var j: usize  = 0;
        for (j < b.count) {
            val g: *Ident = ?b.fields[j];
            if (g.key == f.key) {
                val both: u64 = f.mask & g.mask;
                if ((f.value & both) != (g.value & both)) { ret false; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# whether a family is consistent: its axes are catalog axes each listed once,
# and each ABI names a row of the family, states settings that fit the
# family's axes and is the one of its name for its row
fun family_consistent(f: *Family) bool {
    var i: usize = 0;
    for (i < f.axis_count) {
        if (!trait.consistent(f.axes[i])) { ret false; }
        val named: res[*Axis, Fail] = axis_by_name(f.axes[i].name);
        if (sel named.err)         { ret false; }
        if (named.ok != f.axes[i]) { ret false; }
        var j: usize = 0;
        for (j < i) {
            if (f.axes[j] == f.axes[i]) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    var k: usize = 0;
    for (k < f.abi_count) {
        val b: *Abi = ?f.abis[k];
        if (b.arch == nil || b.arch.family != f || !member(b.arch)) { ret false; }
        var s: usize = 0;
        for (s < b.count) {
            val t: *Trait = ?b.settings[s];
            if (!arch.has_axis(b.arch, t.axis) || !trait.fits(t.axis, t.setting)) { ret false; }
            s = s + 1;
        }
        var j: usize = 0;
        for (j < k) {
            if (f.abis[j].arch == b.arch && str_equals(f.abis[j].name, b.name)) { ret false; }
            j = j + 1;
        }
        k = k + 1;
    }
    ret true;
}

# whether a row is consistent: an address width of one to eight bytes where it
# has one, a nonzero address unit and space count, page granules that are
# powers of two with the base page within the largest, axes its family has,
# frame registers that differ, sound codes, a consistent family, and where the
# family has an ISA grammar, exactly one base of it naming the row
fun consistent(a: *Arch) bool {
    if (a.family == nil || !family_consistent(a.family)) { ret false; }
    var i: usize = 0;
    for (i < a.axis_count) {
        var held: bool  = false;
        var j:    usize = 0;
        for (j < a.family.axis_count) {
            if (a.family.axes[j] == a.axes[i]) { held = true; }
            j = j + 1;
        }
        if (!held) { ret false; }
        i = i + 1;
    }
    if (sel a.pointer.some) {
        val w: u8 = a.pointer.some.bytes;
        if (w == 0 || w > 8) { ret false; }
    }
    if (a.address_unit == 0 || a.spaces == 0) { ret false; }
    if (sel a.pages.some) {
        val p: arch.Pages = a.pages.some;
        if (p.size == 0 || (p.size & (p.size - 1)) != 0)  { ret false; }
        if (p.max < p.size || (p.max & (p.max - 1)) != 0) { ret false; }
    }
    if (sel a.unwind.some) {
        if (a.unwind.some.sp == a.unwind.some.ra) { ret false; }
    }
    if (a.code_count == 0) { ret false; }
    var k: usize = 0;
    for (k < a.code_count) {
        if (!code_sound(?a.code[k])) { ret false; }
        k = k + 1;
    }
    val g: opt[*Grammar] = a.family.grammar;
    if (sel g.some) {
        var bases: usize = 0;
        var b:     usize = 0;
        for (b < g.some.base_count) {
            if (str_equals(g.some.bases[b].arch, a.name)) { bases = bases + 1; }
            b = b + 1;
        }
        if (bases != 1) { ret false; }
    }
    ret true;
}

# whether `n` codings ascend, each is a code of its architecture, and no two
# codes of one format overlap
fun codes_hold(entries: *Coding, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (i != 0 && order_coding(?entries[i - 1], ?entries[i]) > 0) { ret false; }
        val a:     *Arch = entries[i].arch;
        var found: bool  = false;
        var k:     usize = 0;
        for (k < a.code_count) {
            if (?a.code[k] == entries[i].code) { found = true; }
            k = k + 1;
        }
        if (!found) { ret false; }
        var j: usize = 0;
        for (j < i) {
            if (overlap(entries[j].code, entries[i].code)) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

val DUPLICATE_CODINGS: [2]Coding = [2]Coding{
    Coding{arch: ?x86.X86, code: ?x86.X86_CODES[1]},
    Coding{arch: ?x86.X86, code: ?x86.X86_CODES[1]},
};
val DUPLICATE_NAMES: [2]*Arch = [2]*Arch{?x86.X86_64, ?x86.X86_64};

# an 8-bit machine with a word-addressed program space beside its data space,
# a row no architecture file holds, which the catalog checks take as they take
# every row
val EIGHT_ELF:    [3]Ident = [3]Ident{Ident{key: arch.ELF_MACHINE, value: 83, mask: arch.EXACT}, Ident{key: arch.ELF_CLASS, value: arch.CLASS32, mask: arch.EXACT}, Ident{key: arch.ELF_DATA, value: arch.LSB, mask: arch.EXACT}};
val EIGHT_CODES:  [1]Code  = [1]Code{Code{format: ?format.ELF, fields: ?EIGHT_ELF[0], count: 3}};
val EIGHT_FAMILY: Family   = Family{name: "eight", grammar: opt[*Grammar].none{}};
val EIGHT:        Arch     = Arch{
    name:         "eight",
    family:       ?EIGHT_FAMILY,
    code:         ?EIGHT_CODES[0],
    code_count:   1,
    pointer:      opt[Pointer].some{Pointer{bytes: 2}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[arch.Pages].none{},
    spaces:       2,
    unwind:       opt[Unwind].none{},
    caps:         arch.ADDRESSED,
};

# a riscv row whose base the grammar does not spell
val UNSPELLED: Arch = Arch{
    name:         "riscv128",
    family:       ?riscv.RISCV_FAMILY,
    code:         ?riscv.RV64_CODES[0],
    code_count:   1,
    pointer:      opt[Pointer].some{Pointer{bytes: 8}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[arch.Pages].none{},
    spaces:       1,
    unwind:       opt[Unwind].none{},
    caps:         arch.ADDRESSED,
};

# a 64-bit RISC-V code that leaves the E base undeclared, which the census
# finds overlapping the RV64E code
val LOOSE_ELF:   [3]Ident = [3]Ident{Ident{key: arch.ELF_MACHINE, value: 243, mask: arch.EXACT}, Ident{key: arch.ELF_CLASS, value: arch.CLASS64, mask: arch.EXACT}, Ident{key: arch.ELF_DATA, value: arch.LSB, mask: arch.EXACT}};
val LOOSE_CODES: [1]Code  = [1]Code{Code{format: ?format.ELF, fields: ?LOOSE_ELF[0], count: 3}};

# two codings of one ELF machine, which only an exact lookup tells apart from
# a catalog defect
val TWICE_CODINGS: [2]Coding = [2]Coding{
    Coding{arch: ?x86.X86_64, code: ?x86.X86_64_CODES[0]},
    Coding{arch: ?x86.X86, code: ?x86.X86_64_CODES[0]},
};

test arch__rows_are_consistent_and_indexes_hold {
    val rows: [ROW_COUNT]*Arch = ROWS;
    var i:    usize            = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        i = i + 1;
    }
    if (!consistent(?EIGHT))    { ret 2; }
    if (consistent(?UNSPELLED)) { ret 3; }
    val names: err[Fail] = index.verify[Arch](?NAMES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_names);
    if (sel names.err) { ret 4; }
    val dup: err[Fail] = index.verify[Arch](?DUPLICATE_NAMES[0], 2, ?rows[0], 2, order_names);
    if (sel dup.ok) { ret 4; }
    val axes:  [AXIS_COUNT]*Axis = AXES;
    val named: err[Fail]         = index.verify[Axis](?AXIS_NAMES[0], AXIS_COUNT, ?axes[0], AXIS_COUNT, trait.order);
    if (sel named.err) { ret 5; }
    var coded: usize = 0;
    i = 0;
    for (i < ROW_COUNT) {
        coded = coded + ROWS[i].code_count;
        i     = i + 1;
    }
    if (coded != CODE_COUNT)                                  { ret 6; }
    if (!codes_hold(?CODINGS[0], CODE_COUNT))                 { ret 6; }
    if (codes_hold(?DUPLICATE_CODINGS[0], 2))                 { ret 6; }
    if (!overlap(?LOOSE_CODES[0], ?riscv.RV64E_CODES[0]))     { ret 7; }
    if (overlap(?riscv.RV64_CODES[0], ?riscv.RV64E_CODES[0])) { ret 7; }
    ret 0;
}

test arch__every_axis_is_reached_through_a_row {
    var i: usize = 0;
    for (i < AXIS_COUNT) {
        var held: bool  = false;
        var k:    usize = 0;
        for (k < ROW_COUNT) {
            if (arch.has_axis(ROWS[k], AXES[i])) { held = true; }
            k = k + 1;
        }
        if (!held) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test arch__membership_is_by_row_identity {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!member(ROWS[i])) { ret 1; }
        i = i + 1;
    }
    var copy: Arch = x86.X86_64;
    if (member(?copy) || member(nil)) { ret 1; }
    ret 0;
}

# what an input coded by `c` states, every field it does not code zero
fun stated_by(c: *Code) Stated {
    var s: Stated = Stated{format: c.format, count: arch.FIELD_COUNT};
    var k: usize  = 0;
    for (k < c.count) {
        s.values[c.fields[k].key::usize] = c.fields[k].value;
        k                                = k + 1;
    }
    ret s;
}

test arch__lookup_by_code_is_exact_and_refuses_ambiguity {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        var k: usize = 0;
        for (k < ROWS[i].code_count) {
            var s: Stated           = stated_by(?ROWS[i].code[k]);
            val r: res[*Arch, Fail] = by_code(?s);
            if (sel r.err)       { ret 1; }
            if (r.ok != ROWS[i]) { ret 1; }
            k = k + 1;
        }
        val n: res[*Arch, Fail] = by_name(ROWS[i].name);
        if (sel n.err)       { ret 1; }
        if (n.ok != ROWS[i]) { ret 1; }
        i = i + 1;
    }
    val absent: res[*Arch, Fail] = by_name("z80");
    if (sel absent.ok) { ret 2; }

    # EF_RISCV_RVE alone tells the embedded base from the full one, and other
    # e_flags bits take no part
    var e: Stated = Stated{format: ?format.ELF, count: arch.FIELD_COUNT};
    e.values[arch.ELF_MACHINE] = 243;
    e.values[arch.ELF_CLASS]   = arch.CLASS32;
    e.values[arch.ELF_DATA]    = arch.LSB;
    e.values[arch.ELF_FLAGS]   = 0x8 | 0x5;
    val rve: res[*Arch, Fail] = by_code(?e);
    if (sel rve.err)               { ret 3; }
    if (rve.ok != ?riscv.RISCV32E) { ret 3; }
    e.values[arch.ELF_FLAGS] = 0x5;
    val full: res[*Arch, Fail] = by_code(?e);
    if (sel full.err)              { ret 3; }
    if (full.ok != ?riscv.RISCV32) { ret 3; }

    e.values[arch.ELF_MACHINE] = 0xffff;
    val unknown: res[*Arch, Fail] = by_code(?e);
    if (!sel unknown.err)                   { ret 4; }
    if (!sel unknown.err.cause.unsupported) { ret 4; }
    var x: Stated = stated_by(?x86.X86_64_CODES[0]);
    x.values[arch.ELF_CLASS] = arch.CLASS32;
    val class: res[*Arch, Fail] = by_code(?x);
    if (sel class.ok) { ret 4; }
    x.values[arch.ELF_CLASS] = arch.CLASS64;
    x.values[arch.ELF_DATA]  = arch.MSB;
    val order: res[*Arch, Fail] = by_code(?x);
    if (sel order.ok) { ret 4; }

    var two: Stated           = stated_by(?x86.X86_64_CODES[0]);
    val amb: res[*Arch, Fail] = coded(?TWICE_CODINGS[0], 2, ?two);
    if (!sel amb.err)                { ret 5; }
    if (!sel amb.err.cause.internal) { ret 5; }
    ret 0;
}

test arch__capability_query_answers_from_the_row {
    val x: res[*Arch, Fail] = by_name("x86_64");
    if (sel x.err) { ret 1; }
    val s: res[*Arch, Fail] = by_name("spirv");
    if (sel s.err)                                                       { ret 1; }
    if (!arch.has(x.ok, arch.ADDRESSED) || arch.has(x.ok, arch.INDEXED)) { ret 1; }
    if (arch.has(s.ok, arch.ADDRESSED) || !arch.has(s.ok, arch.INDEXED)) { ret 1; }
    val macho: opt[*Code] = arch.code(s.ok, ?format.MACHO);
    if (sel macho.some) { ret 1; }
    ret 0;
}

test arch__riscv_bases_and_abis_name_their_rows {
    val g: *Grammar   = ?riscv.RISCV_GRAMMAR;
    val e: str        = "rv32e2p0_m2p0";
    val b: opt[*Base] = isa.base_of(g, Bytes{data: e::*u8, len: str_len(e)});
    if (!sel b.some)                          { ret 1; }
    if (!str_equals(b.some.arch, "riscv32e")) { ret 1; }
    val w: str        = "rv64e2p0";
    val c: opt[*Base] = isa.base_of(g, Bytes{data: w::*u8, len: str_len(w)});
    if (!sel c.some)                          { ret 1; }
    if (!str_equals(c.some.arch, "riscv64e")) { ret 1; }
    val ilp32e: opt[*Abi] = arch.abi(?riscv.RISCV32E, "ilp32e");
    if (!sel ilp32e.some) { ret 2; }
    val wrong: opt[*Abi] = arch.abi(?riscv.RISCV32, "ilp32e");
    if (sel wrong.some) { ret 2; }
    val lp64e: opt[*Abi] = arch.abi(?riscv.RISCV64E, "lp64e");
    if (!sel lp64e.some) { ret 2; }
    ret 0;
}
