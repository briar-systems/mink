# every architecture of the catalog, and the lookups that read them
#
# the one place the rows are enumerated. a new architecture is a family
# file's row and its lines here.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Unwind;
use mink.catalog.arch.aarch64;
use mink.catalog.arch.riscv;
use mink.catalog.arch.spirv;
use mink.catalog.arch.wasm;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Code;
use mink.catalog.format.Format;
use mink.catalog.trait;
use mink.catalog.trait.Axis;

# every trait axis, and its index by name, the key trait sets and format
# tables are kept in
val AXIS_COUNT: usize             = 54;
val AXES:       [AXIS_COUNT]*Axis = [AXIS_COUNT]*Axis{?riscv.RISCV_FLOAT_ABI, ?riscv.RISCV_RVC, ?riscv.RISCV_RVE, ?riscv.RISCV_TSO, ?riscv.RISCV_ARCH, ?riscv.RISCV_STACK_ALIGN, ?riscv.RISCV_UNALIGNED_ACCESS, ?riscv.RISCV_PRIV_SPEC, ?riscv.RISCV_PRIV_SPEC_MINOR, ?riscv.RISCV_PRIV_SPEC_REVISION, ?riscv.RISCV_ATOMIC_ABI, ?riscv.RISCV_X3_REG_USAGE, ?riscv.RISCV_CFI_LP_UNLABELED, ?riscv.RISCV_CFI_SS, ?riscv.RISCV_CFI_LP_FUNC_SIG, ?aarch64.AARCH64_BTI, ?aarch64.AARCH64_PAC, ?aarch64.AARCH64_GCS, ?x86.X86_IBT, ?x86.X86_SHSTK, ?x86.X86_LAM_U48, ?x86.X86_LAM_U57, ?x86.X86_ISA_NEEDED_BASELINE, ?x86.X86_ISA_NEEDED_V2, ?x86.X86_ISA_NEEDED_V3, ?x86.X86_ISA_NEEDED_V4, ?x86.X86_ISA_USED_BASELINE, ?x86.X86_ISA_USED_V2, ?x86.X86_ISA_USED_V3, ?x86.X86_ISA_USED_V4, ?x86.X86_FEATURE_NEEDED_X86, ?x86.X86_FEATURE_NEEDED_X87, ?x86.X86_FEATURE_NEEDED_MMX, ?x86.X86_FEATURE_NEEDED_XMM, ?x86.X86_FEATURE_NEEDED_YMM, ?x86.X86_FEATURE_NEEDED_ZMM, ?x86.X86_FEATURE_NEEDED_FXSR, ?x86.X86_FEATURE_NEEDED_XSAVE, ?x86.X86_FEATURE_NEEDED_XSAVEOPT, ?x86.X86_FEATURE_NEEDED_XSAVEC, ?x86.X86_FEATURE_NEEDED_TMM, ?x86.X86_FEATURE_NEEDED_MASK, ?x86.X86_FEATURE_USED_X86, ?x86.X86_FEATURE_USED_X87, ?x86.X86_FEATURE_USED_MMX, ?x86.X86_FEATURE_USED_XMM, ?x86.X86_FEATURE_USED_YMM, ?x86.X86_FEATURE_USED_ZMM, ?x86.X86_FEATURE_USED_FXSR, ?x86.X86_FEATURE_USED_XSAVE, ?x86.X86_FEATURE_USED_XSAVEOPT, ?x86.X86_FEATURE_USED_XSAVEC, ?x86.X86_FEATURE_USED_TMM, ?x86.X86_FEATURE_USED_MASK};
val AXIS_NAMES: [AXIS_COUNT]*Axis = [AXIS_COUNT]*Axis{?aarch64.AARCH64_BTI, ?aarch64.AARCH64_GCS, ?aarch64.AARCH64_PAC, ?riscv.RISCV_ARCH, ?riscv.RISCV_ATOMIC_ABI, ?riscv.RISCV_CFI_LP_FUNC_SIG, ?riscv.RISCV_CFI_LP_UNLABELED, ?riscv.RISCV_CFI_SS, ?riscv.RISCV_FLOAT_ABI, ?riscv.RISCV_PRIV_SPEC, ?riscv.RISCV_PRIV_SPEC_MINOR, ?riscv.RISCV_PRIV_SPEC_REVISION, ?riscv.RISCV_RVC, ?riscv.RISCV_RVE, ?riscv.RISCV_STACK_ALIGN, ?riscv.RISCV_TSO, ?riscv.RISCV_UNALIGNED_ACCESS, ?riscv.RISCV_X3_REG_USAGE, ?x86.X86_FEATURE_NEEDED_FXSR, ?x86.X86_FEATURE_NEEDED_MASK, ?x86.X86_FEATURE_NEEDED_MMX, ?x86.X86_FEATURE_NEEDED_TMM, ?x86.X86_FEATURE_NEEDED_X86, ?x86.X86_FEATURE_NEEDED_X87, ?x86.X86_FEATURE_NEEDED_XMM, ?x86.X86_FEATURE_NEEDED_XSAVE, ?x86.X86_FEATURE_NEEDED_XSAVEC, ?x86.X86_FEATURE_NEEDED_XSAVEOPT, ?x86.X86_FEATURE_NEEDED_YMM, ?x86.X86_FEATURE_NEEDED_ZMM, ?x86.X86_FEATURE_USED_FXSR, ?x86.X86_FEATURE_USED_MASK, ?x86.X86_FEATURE_USED_MMX, ?x86.X86_FEATURE_USED_TMM, ?x86.X86_FEATURE_USED_X86, ?x86.X86_FEATURE_USED_X87, ?x86.X86_FEATURE_USED_XMM, ?x86.X86_FEATURE_USED_XSAVE, ?x86.X86_FEATURE_USED_XSAVEC, ?x86.X86_FEATURE_USED_XSAVEOPT, ?x86.X86_FEATURE_USED_YMM, ?x86.X86_FEATURE_USED_ZMM, ?x86.X86_IBT, ?x86.X86_ISA_NEEDED_BASELINE, ?x86.X86_ISA_NEEDED_V2, ?x86.X86_ISA_NEEDED_V3, ?x86.X86_ISA_NEEDED_V4, ?x86.X86_ISA_USED_BASELINE, ?x86.X86_ISA_USED_V2, ?x86.X86_ISA_USED_V3, ?x86.X86_ISA_USED_V4, ?x86.X86_LAM_U48, ?x86.X86_LAM_U57, ?x86.X86_SHSTK};

val ROW_COUNT: usize            = 8;
val ROWS:      [ROW_COUNT]*Arch = [ROW_COUNT]*Arch{?x86.X86_64, ?x86.X86, ?aarch64.AARCH64, ?riscv.RISCV64, ?riscv.RISCV32, ?wasm.WASM32, ?wasm.WASM64, ?spirv.SPIRV};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Arch {
    ret ROWS[index];
}

# the rows ascending by name
val NAMES: [ROW_COUNT]*Arch = [ROW_COUNT]*Arch{?aarch64.AARCH64, ?riscv.RISCV32, ?riscv.RISCV64, ?spirv.SPIRV, ?wasm.WASM32, ?wasm.WASM64, ?x86.X86, ?x86.X86_64};

# a code of a row and the row that holds it
# ---
# arch: the architecture that names itself by the code
# code: the code, a row of that architecture's codes
rec Coding {
    arch: *Arch;
    code: *Code;
}

val CODE_COUNT: usize = 16;

# every code of every row, ascending by format name, then value, then qualifier
val CODINGS: [CODE_COUNT]Coding = [CODE_COUNT]Coding{
    Coding{arch: ?x86.X86, code: ?x86.X86_CODES[1]},
    Coding{arch: ?riscv.RISCV32, code: ?riscv.RV32_CODES[1]},
    Coding{arch: ?riscv.RISCV64, code: ?riscv.RV64_CODES[1]},
    Coding{arch: ?x86.X86_64, code: ?x86.X86_64_CODES[1]},
    Coding{arch: ?aarch64.AARCH64, code: ?aarch64.AARCH64_CODES[1]},
    Coding{arch: ?x86.X86, code: ?x86.X86_CODES[0]},
    Coding{arch: ?x86.X86_64, code: ?x86.X86_64_CODES[0]},
    Coding{arch: ?aarch64.AARCH64, code: ?aarch64.AARCH64_CODES[0]},
    Coding{arch: ?riscv.RISCV32, code: ?riscv.RV32_CODES[0]},
    Coding{arch: ?riscv.RISCV64, code: ?riscv.RV64_CODES[0]},
    Coding{arch: ?x86.X86, code: ?x86.X86_CODES[2]},
    Coding{arch: ?x86.X86_64, code: ?x86.X86_64_CODES[2]},
    Coding{arch: ?aarch64.AARCH64, code: ?aarch64.AARCH64_CODES[2]},
    Coding{arch: ?spirv.SPIRV, code: ?spirv.SPIRV_CODES[0]},
    Coding{arch: ?wasm.WASM32, code: ?wasm.WASM32_CODES[0]},
    Coding{arch: ?wasm.WASM64, code: ?wasm.WASM64_CODES[0]},
};

fun order_names(a: **Arch, b: **Arch) i64 {
    ret str_compare(a[0].name, b[0].name);
}

# the qualifier that tells codes apart in the format of `c`
fun told_by(c: *Code) u32 {
    if (c.format.qualified) { ret c.qualifier; }
    ret 0;
}

fun order_coding(a: *Coding, b: *Coding) i64 {
    val f: i64 = str_compare(a.code.format.name, b.code.format.name);
    if (f != 0)                            { ret f; }
    if (a.code.value < b.code.value)       { ret -1; }
    if (a.code.value > b.code.value)       { ret 1; }
    if (told_by(a.code) < told_by(b.code)) { ret -1; }
    if (told_by(a.code) > told_by(b.code)) { ret 1; }
    ret 0;
}

pub fun by_name(name: str) res[*Arch, Fail] {
    var probe: Arch       = Arch{name: name};
    val row:   opt[*Arch] = index.find[Arch](?NAMES[0], ROW_COUNT, ?probe, order_names);
    if (sel row.none) { ret res[*Arch, Fail].err{fail.unsupported("no architecture has this name")}; }
    ret res[*Arch, Fail].ok{row.some};
}

# whether `a` is a row of this catalog
pub fun member(a: *Arch) bool {
    if (a == nil) { ret false; }
    val row: res[*Arch, Fail] = by_name(a.name);
    if (sel row.err) { ret false; }
    ret row.ok == a;
}

# the row `f` names with `value` and `qualifier`
pub fun by_code(f: *Format, value: u32, qualifier: u32) res[*Arch, Fail] {
    var code: Code           = Code{format: f, value: value, qualifier: qualifier};
    val key:  Coding         = Coding{code: ?code};
    val at:   SearchPosition = sort.binary_search_by[Coding](?CODINGS[0], CODE_COUNT, ?key, order_coding);
    if (sel at.insertion) { ret res[*Arch, Fail].err{fail.unsupported("no architecture has this machine code")}; }
    ret res[*Arch, Fail].ok{CODINGS[at.found].arch};
}

# the trait axis named `name`
pub fun axis_by_name(name: str) res[*Axis, Fail] {
    var probe: Axis       = Axis{name: name};
    val row:   opt[*Axis] = index.find[Axis](?AXIS_NAMES[0], AXIS_COUNT, ?probe, trait.order);
    if (sel row.none) { ret res[*Axis, Fail].err{fail.unsupported("no trait axis has this name")}; }
    ret res[*Axis, Fail].ok{row.some};
}

# whether a row is consistent: a power of two address width of at most eight
# bytes, pages exactly where there are addresses, consistent catalog trait
# axes each listed once, and frame facts with distinct registers and factors that divide
# the address width
fun consistent(a: *Arch) bool {
    var i: usize = 0;
    for (i < a.axis_count) {
        if (!trait.consistent(a.axes[i])) { ret false; }
        val named: res[*Axis, Fail] = axis_by_name(a.axes[i].name);
        if (sel named.err)         { ret false; }
        if (named.ok != a.axes[i]) { ret false; }
        var j: usize = 0;
        for (j < i) {
            if (a.axes[j] == a.axes[i]) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    val w: u8 = a.pointer_bytes;
    if (w == 0 || w > 8 || (w & (w - 1)) != 0)             { ret false; }
    if (arch.has(a, arch.ADDRESSED) != (a.page_size != 0)) { ret false; }
    if ((a.page_size & (a.page_size - 1)) != 0)            { ret false; }
    if (sel a.unwind.none)                                 { ret true; }
    val u: Unwind = a.unwind.some;
    if (u.sp == u.ra || u.code_align == 0 || u.data_align == 0) { ret false; }
    ret w::i64 % u.data_align::i64 == 0;
}

# whether `n` codings ascend strictly and each is a code of its architecture
fun codes_hold(entries: *Coding, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (i != 0 && order_coding(?entries[i - 1], ?entries[i]) >= 0) { ret false; }
        val a:     *Arch = entries[i].arch;
        var found: bool  = false;
        var k:     usize = 0;
        for (k < a.code_count) {
            if (?a.codes[k] == entries[i].code) { found = true; }
            k = k + 1;
        }
        if (!found) { ret false; }
        i = i + 1;
    }
    ret true;
}

val DUPLICATE_CODINGS: [2]Coding = [2]Coding{
    Coding{arch: ?x86.X86, code: ?x86.X86_CODES[1]},
    Coding{arch: ?x86.X86, code: ?x86.X86_CODES[1]},
};
val DUPLICATE_NAMES: [2]*Arch = [2]*Arch{?x86.X86_64, ?x86.X86_64};

test arch__rows_are_consistent_and_indexes_hold {
    val rows: [ROW_COUNT]*Arch = ROWS;
    var i:    usize            = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        i = i + 1;
    }
    val names: err[Fail] = index.verify[Arch](?NAMES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_names);
    if (sel names.err) { ret 1; }
    val dup: err[Fail] = index.verify[Arch](?DUPLICATE_NAMES[0], 2, ?rows[0], 2, order_names);
    if (sel dup.ok) { ret 1; }
    val axes:  [AXIS_COUNT]*Axis = AXES;
    val named: err[Fail]         = index.verify[Axis](?AXIS_NAMES[0], AXIS_COUNT, ?axes[0], AXIS_COUNT, trait.order);
    if (sel named.err) { ret 1; }
    var coded: usize = 0;
    i = 0;
    for (i < ROW_COUNT) {
        coded = coded + ROWS[i].code_count;
        i     = i + 1;
    }
    if (coded != CODE_COUNT)                  { ret 1; }
    if (!codes_hold(?CODINGS[0], CODE_COUNT)) { ret 1; }
    if (codes_hold(?DUPLICATE_CODINGS[0], 2)) { ret 1; }
    ret 0;
}

test arch__every_axis_is_reached_through_a_row {
    var i: usize = 0;
    for (i < AXIS_COUNT) {
        var held: bool  = false;
        var k:    usize = 0;
        for (k < ROW_COUNT) {
            if (arch.has_axis(ROWS[k], AXES[i])) { held = true; }
            k = k + 1;
        }
        if (!held) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test arch__membership_is_by_row_identity {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!member(ROWS[i])) { ret 1; }
        i = i + 1;
    }
    var copy: Arch = x86.X86_64;
    if (member(?copy) || member(nil)) { ret 1; }
    ret 0;
}

test arch__lookup_by_any_code_and_refuse_unknown {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        var k: usize = 0;
        for (k < ROWS[i].code_count) {
            val c: *Code            = ?ROWS[i].codes[k];
            val r: res[*Arch, Fail] = by_code(c.format, c.value, c.qualifier);
            if (sel r.err)       { ret 1; }
            if (r.ok != ROWS[i]) { ret 1; }
            k = k + 1;
        }
        val n: res[*Arch, Fail] = by_name(ROWS[i].name);
        if (sel n.err)       { ret 1; }
        if (n.ok != ROWS[i]) { ret 1; }
        i = i + 1;
    }
    val absent: res[*Arch, Fail] = by_name("z80");
    if (sel absent.ok) { ret 1; }
    val unknown: res[*Arch, Fail] = by_code(?format.ELF, 0xffff, arch.CLASS64);
    if (sel unknown.ok)                     { ret 1; }
    if (!sel unknown.err.cause.unsupported) { ret 1; }
    val class: res[*Arch, Fail] = by_code(?format.ELF, 62, arch.CLASS32);
    if (sel class.ok) { ret 1; }
    ret 0;
}

test arch__capability_query_answers_from_the_row {
    val x: res[*Arch, Fail] = by_name("x86_64");
    if (sel x.err) { ret 1; }
    val s: res[*Arch, Fail] = by_name("spirv");
    if (sel s.err)                                                       { ret 1; }
    if (!arch.has(x.ok, arch.ADDRESSED) || arch.has(x.ok, arch.INDEXED)) { ret 1; }
    if (arch.has(s.ok, arch.ADDRESSED) || !arch.has(s.ok, arch.INDEXED)) { ret 1; }
    val macho: opt[Code] = arch.code(s.ok, ?format.MACHO);
    if (sel macho.some) { ret 1; }
    ret 0;
}
