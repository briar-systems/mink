# the x86 architectures, x86_64 and its 32-bit ancestor, and the trait axes
# their ELF property notes state

use std.types.option.opt;
use std.types.size.usize;

use mink.bytes.reader;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Code;
use mink.catalog.arch.Family;
use mink.catalog.arch.Ident;
use mink.catalog.arch.Pages;
use mink.catalog.arch.Pointer;
use mink.catalog.arch.Unwind;
use mink.catalog.format;
use mink.catalog.isa.Grammar;
use mink.catalog.merge;
use mink.catalog.trait;
use mink.catalog.trait.Axis;

# EM_X86_64 and EM_386 with their class and byte order, the COFF machines,
# and the Mach-O cpu types with CPU_SUBTYPE_X86_64_ALL and CPU_SUBTYPE_I386_ALL
# under the subtype bits CPU_SUBTYPE_MASK leaves
val X86_64_ELF:   [3]Ident = [3]Ident{Ident{key: arch.ELF_MACHINE, value: 62, mask: arch.EXACT}, Ident{key: arch.ELF_CLASS, value: arch.CLASS64, mask: arch.EXACT}, Ident{key: arch.ELF_DATA, value: arch.LSB, mask: arch.EXACT}};
val X86_64_COFF:  [1]Ident = [1]Ident{Ident{key: arch.COFF_MACHINE, value: 0x8664, mask: arch.EXACT}};
val X86_64_MACHO: [2]Ident = [2]Ident{Ident{key: arch.MACHO_CPU, value: 0x0100_0007, mask: arch.EXACT}, Ident{key: arch.MACHO_SUBTYPE, value: 3, mask: 0x00ff_ffff}};
val X86_ELF:      [3]Ident = [3]Ident{Ident{key: arch.ELF_MACHINE, value: 3, mask: arch.EXACT}, Ident{key: arch.ELF_CLASS, value: arch.CLASS32, mask: arch.EXACT}, Ident{key: arch.ELF_DATA, value: arch.LSB, mask: arch.EXACT}};
val X86_COFF:     [1]Ident = [1]Ident{Ident{key: arch.COFF_MACHINE, value: 0x14c, mask: arch.EXACT}};
val X86_MACHO:    [2]Ident = [2]Ident{Ident{key: arch.MACHO_CPU, value: 7, mask: arch.EXACT}, Ident{key: arch.MACHO_SUBTYPE, value: 3, mask: 0x00ff_ffff}};

val     X86_64_CODE_COUNT: usize                   = 3;
pub val X86_64_CODES:      [X86_64_CODE_COUNT]Code = [X86_64_CODE_COUNT]Code{
    Code{format: ?format.ELF, fields: ?X86_64_ELF[0], count: 3},
    Code{format: ?format.COFF, fields: ?X86_64_COFF[0], count: 1},
    Code{format: ?format.MACHO, fields: ?X86_64_MACHO[0], count: 2},
};
val     X86_CODE_COUNT: usize                = 3;
pub val X86_CODES:      [X86_CODE_COUNT]Code = [X86_CODE_COUNT]Code{
    Code{format: ?format.ELF, fields: ?X86_ELF[0], count: 3},
    Code{format: ?format.COFF, fields: ?X86_COFF[0], count: 1},
    Code{format: ?format.MACHO, fields: ?X86_MACHO[0], count: 2},
};

# every indirect branch target is marked, so indirect branch tracking can be enforced
pub val X86_IBT: Axis = Axis{name: "x86-ibt", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.INTERSECTION, owner: trait.Owner.source{}};
# the code keeps a shadow stack of return addresses
pub val X86_SHSTK: Axis = Axis{name: "x86-shstk", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.INTERSECTION, owner: trait.Owner.source{}};
# the code runs with linear address masking of 48 or 57 bit user addresses
pub val X86_LAM_U48: Axis = Axis{name: "x86-lam-u48", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.INTERSECTION, owner: trait.Owner.source{}};
pub val X86_LAM_U57: Axis = Axis{name: "x86-lam-u57", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.INTERSECTION, owner: trait.Owner.source{}};
# the micro-architecture levels the code needs to run and the ones it uses
pub val X86_ISA_NEEDED_BASELINE: Axis = Axis{name: "x86-isa-needed-baseline", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_ISA_NEEDED_V2:       Axis = Axis{name: "x86-isa-needed-v2", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_ISA_NEEDED_V3:       Axis = Axis{name: "x86-isa-needed-v3", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_ISA_NEEDED_V4:       Axis = Axis{name: "x86-isa-needed-v4", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_ISA_USED_BASELINE:   Axis = Axis{name: "x86-isa-used-baseline", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_ISA_USED_V2:         Axis = Axis{name: "x86-isa-used-v2", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_ISA_USED_V3:         Axis = Axis{name: "x86-isa-used-v3", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_ISA_USED_V4:         Axis = Axis{name: "x86-isa-used-v4", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
# the processor features the code needs to run and the ones it uses
pub val X86_FEATURE_NEEDED_X86:      Axis = Axis{name: "x86-feature-needed-x86", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_FEATURE_NEEDED_X87:      Axis = Axis{name: "x86-feature-needed-x87", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_FEATURE_NEEDED_MMX:      Axis = Axis{name: "x86-feature-needed-mmx", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_FEATURE_NEEDED_XMM:      Axis = Axis{name: "x86-feature-needed-xmm", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_FEATURE_NEEDED_YMM:      Axis = Axis{name: "x86-feature-needed-ymm", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_FEATURE_NEEDED_ZMM:      Axis = Axis{name: "x86-feature-needed-zmm", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_FEATURE_NEEDED_FXSR:     Axis = Axis{name: "x86-feature-needed-fxsr", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_FEATURE_NEEDED_XSAVE:    Axis = Axis{name: "x86-feature-needed-xsave", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_FEATURE_NEEDED_XSAVEOPT: Axis = Axis{name: "x86-feature-needed-xsaveopt", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_FEATURE_NEEDED_XSAVEC:   Axis = Axis{name: "x86-feature-needed-xsavec", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_FEATURE_NEEDED_TMM:      Axis = Axis{name: "x86-feature-needed-tmm", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_FEATURE_NEEDED_MASK:     Axis = Axis{name: "x86-feature-needed-mask", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};
pub val X86_FEATURE_USED_X86:        Axis = Axis{name: "x86-feature-used-x86", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_FEATURE_USED_X87:        Axis = Axis{name: "x86-feature-used-x87", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_FEATURE_USED_MMX:        Axis = Axis{name: "x86-feature-used-mmx", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_FEATURE_USED_XMM:        Axis = Axis{name: "x86-feature-used-xmm", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_FEATURE_USED_YMM:        Axis = Axis{name: "x86-feature-used-ymm", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_FEATURE_USED_ZMM:        Axis = Axis{name: "x86-feature-used-zmm", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_FEATURE_USED_FXSR:       Axis = Axis{name: "x86-feature-used-fxsr", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_FEATURE_USED_XSAVE:      Axis = Axis{name: "x86-feature-used-xsave", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_FEATURE_USED_XSAVEOPT:   Axis = Axis{name: "x86-feature-used-xsaveopt", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_FEATURE_USED_XSAVEC:     Axis = Axis{name: "x86-feature-used-xsavec", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_FEATURE_USED_TMM:        Axis = Axis{name: "x86-feature-used-tmm", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
pub val X86_FEATURE_USED_MASK:       Axis = Axis{name: "x86-feature-used-mask", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};

val X86_AXIS_COUNT: usize                 = 36;
val X86_AXES:       [X86_AXIS_COUNT]*Axis = [X86_AXIS_COUNT]*Axis{?X86_IBT, ?X86_SHSTK, ?X86_LAM_U48, ?X86_LAM_U57, ?X86_ISA_NEEDED_BASELINE, ?X86_ISA_NEEDED_V2, ?X86_ISA_NEEDED_V3, ?X86_ISA_NEEDED_V4, ?X86_ISA_USED_BASELINE, ?X86_ISA_USED_V2, ?X86_ISA_USED_V3, ?X86_ISA_USED_V4, ?X86_FEATURE_NEEDED_X86, ?X86_FEATURE_NEEDED_X87, ?X86_FEATURE_NEEDED_MMX, ?X86_FEATURE_NEEDED_XMM, ?X86_FEATURE_NEEDED_YMM, ?X86_FEATURE_NEEDED_ZMM, ?X86_FEATURE_NEEDED_FXSR, ?X86_FEATURE_NEEDED_XSAVE, ?X86_FEATURE_NEEDED_XSAVEOPT, ?X86_FEATURE_NEEDED_XSAVEC, ?X86_FEATURE_NEEDED_TMM, ?X86_FEATURE_NEEDED_MASK, ?X86_FEATURE_USED_X86, ?X86_FEATURE_USED_X87, ?X86_FEATURE_USED_MMX, ?X86_FEATURE_USED_XMM, ?X86_FEATURE_USED_YMM, ?X86_FEATURE_USED_ZMM, ?X86_FEATURE_USED_FXSR, ?X86_FEATURE_USED_XSAVE, ?X86_FEATURE_USED_XSAVEOPT, ?X86_FEATURE_USED_XSAVEC, ?X86_FEATURE_USED_TMM, ?X86_FEATURE_USED_MASK};

pub val X86_FAMILY: Family = Family{name: "x86", axes: ?X86_AXES[0], axis_count: X86_AXIS_COUNT, grammar: opt[*Grammar].none{}};

pub val X86_64: Arch = Arch{
    name:         "x86_64",
    family:       ?X86_FAMILY,
    code:         ?X86_64_CODES[0],
    code_count:   X86_64_CODE_COUNT,
    pointer:      opt[Pointer].some{Pointer{bytes: 8}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[Pages].some{Pages{size: 0x1000, max: 0x1000}},
    spaces:       1,
    unwind:       opt[Unwind].some{Unwind{sp: 7, ra: 16}},
    caps:         arch.ADDRESSED,
    axes:         ?X86_AXES[0],
    axis_count:   X86_AXIS_COUNT,
};
pub val X86: Arch = Arch{
    name:         "x86",
    family:       ?X86_FAMILY,
    code:         ?X86_CODES[0],
    code_count:   X86_CODE_COUNT,
    pointer:      opt[Pointer].some{Pointer{bytes: 4}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[Pages].some{Pages{size: 0x1000, max: 0x1000}},
    spaces:       1,
    unwind:       opt[Unwind].some{Unwind{sp: 4, ra: 8}},
    caps:         arch.ADDRESSED,
    axes:         ?X86_AXES[0],
    axis_count:   X86_AXIS_COUNT,
};
