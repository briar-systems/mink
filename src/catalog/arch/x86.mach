# the x86 architectures, x86_64 and its 32-bit ancestor, and the trait axes
# their ELF property notes state

use std.types.option.opt;
use std.types.size.usize;

use mink.bytes.reader;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Unwind;
use mink.catalog.format;
use mink.catalog.format.Code;
use mink.catalog.trait;
use mink.catalog.trait.Axis;

val     X86_64_CODE_COUNT: usize                   = 3;
pub val X86_64_CODES:      [X86_64_CODE_COUNT]Code = [X86_64_CODE_COUNT]Code{
    Code{format: ?format.ELF, value: 62, qualifier: arch.CLASS64},
    Code{format: ?format.COFF, value: 0x8664},
    Code{format: ?format.MACHO, value: 0x0100_0007, qualifier: 3},
};
val     X86_CODE_COUNT: usize                = 3;
pub val X86_CODES:      [X86_CODE_COUNT]Code = [X86_CODE_COUNT]Code{
    Code{format: ?format.ELF, value: 3, qualifier: arch.CLASS32},
    Code{format: ?format.COFF, value: 0x14c},
    Code{format: ?format.MACHO, value: 7, qualifier: 3},
};

# every indirect branch target is marked, so indirect branch tracking can be enforced
pub val X86_IBT: Axis = Axis{name: "x86-ibt", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};
# the code keeps a shadow stack of return addresses
pub val X86_SHSTK: Axis = Axis{name: "x86-shstk", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};
# the code runs with linear address masking of 48 or 57 bit user addresses
pub val X86_LAM_U48: Axis = Axis{name: "x86-lam-u48", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};
pub val X86_LAM_U57: Axis = Axis{name: "x86-lam-u57", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};
# the micro-architecture levels the code needs to run and the ones it uses
pub val X86_ISA_NEEDED_BASELINE: Axis = Axis{name: "x86-isa-needed-baseline", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_NEEDED_V2:       Axis = Axis{name: "x86-isa-needed-v2", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_NEEDED_V3:       Axis = Axis{name: "x86-isa-needed-v3", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_NEEDED_V4:       Axis = Axis{name: "x86-isa-needed-v4", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_USED_BASELINE:   Axis = Axis{name: "x86-isa-used-baseline", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_USED_V2:         Axis = Axis{name: "x86-isa-used-v2", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_USED_V3:         Axis = Axis{name: "x86-isa-used-v3", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_USED_V4:         Axis = Axis{name: "x86-isa-used-v4", value: trait.Value.flag{}, merge: trait.Merge.union{}};
# the processor features the code needs to run and the ones it uses
pub val X86_FEATURE_NEEDED_X86:      Axis = Axis{name: "x86-feature-needed-x86", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_NEEDED_X87:      Axis = Axis{name: "x86-feature-needed-x87", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_NEEDED_MMX:      Axis = Axis{name: "x86-feature-needed-mmx", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_NEEDED_XMM:      Axis = Axis{name: "x86-feature-needed-xmm", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_NEEDED_YMM:      Axis = Axis{name: "x86-feature-needed-ymm", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_NEEDED_ZMM:      Axis = Axis{name: "x86-feature-needed-zmm", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_NEEDED_FXSR:     Axis = Axis{name: "x86-feature-needed-fxsr", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_NEEDED_XSAVE:    Axis = Axis{name: "x86-feature-needed-xsave", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_NEEDED_XSAVEOPT: Axis = Axis{name: "x86-feature-needed-xsaveopt", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_NEEDED_XSAVEC:   Axis = Axis{name: "x86-feature-needed-xsavec", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_NEEDED_TMM:      Axis = Axis{name: "x86-feature-needed-tmm", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_NEEDED_MASK:     Axis = Axis{name: "x86-feature-needed-mask", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_USED_X86:        Axis = Axis{name: "x86-feature-used-x86", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_USED_X87:        Axis = Axis{name: "x86-feature-used-x87", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_USED_MMX:        Axis = Axis{name: "x86-feature-used-mmx", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_USED_XMM:        Axis = Axis{name: "x86-feature-used-xmm", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_USED_YMM:        Axis = Axis{name: "x86-feature-used-ymm", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_USED_ZMM:        Axis = Axis{name: "x86-feature-used-zmm", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_USED_FXSR:       Axis = Axis{name: "x86-feature-used-fxsr", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_USED_XSAVE:      Axis = Axis{name: "x86-feature-used-xsave", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_USED_XSAVEOPT:   Axis = Axis{name: "x86-feature-used-xsaveopt", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_USED_XSAVEC:     Axis = Axis{name: "x86-feature-used-xsavec", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_USED_TMM:        Axis = Axis{name: "x86-feature-used-tmm", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_FEATURE_USED_MASK:       Axis = Axis{name: "x86-feature-used-mask", value: trait.Value.flag{}, merge: trait.Merge.union{}};

val X86_AXIS_COUNT: usize                 = 36;
val X86_AXES:       [X86_AXIS_COUNT]*Axis = [X86_AXIS_COUNT]*Axis{?X86_IBT, ?X86_SHSTK, ?X86_LAM_U48, ?X86_LAM_U57, ?X86_ISA_NEEDED_BASELINE, ?X86_ISA_NEEDED_V2, ?X86_ISA_NEEDED_V3, ?X86_ISA_NEEDED_V4, ?X86_ISA_USED_BASELINE, ?X86_ISA_USED_V2, ?X86_ISA_USED_V3, ?X86_ISA_USED_V4, ?X86_FEATURE_NEEDED_X86, ?X86_FEATURE_NEEDED_X87, ?X86_FEATURE_NEEDED_MMX, ?X86_FEATURE_NEEDED_XMM, ?X86_FEATURE_NEEDED_YMM, ?X86_FEATURE_NEEDED_ZMM, ?X86_FEATURE_NEEDED_FXSR, ?X86_FEATURE_NEEDED_XSAVE, ?X86_FEATURE_NEEDED_XSAVEOPT, ?X86_FEATURE_NEEDED_XSAVEC, ?X86_FEATURE_NEEDED_TMM, ?X86_FEATURE_NEEDED_MASK, ?X86_FEATURE_USED_X86, ?X86_FEATURE_USED_X87, ?X86_FEATURE_USED_MMX, ?X86_FEATURE_USED_XMM, ?X86_FEATURE_USED_YMM, ?X86_FEATURE_USED_ZMM, ?X86_FEATURE_USED_FXSR, ?X86_FEATURE_USED_XSAVE, ?X86_FEATURE_USED_XSAVEOPT, ?X86_FEATURE_USED_XSAVEC, ?X86_FEATURE_USED_TMM, ?X86_FEATURE_USED_MASK};

pub val X86_64: Arch = Arch{
    name:          "x86_64",
    codes:         ?X86_64_CODES[0],
    code_count:    X86_64_CODE_COUNT,
    pointer_bytes: 8,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 7, ra: 16, code_align: 1, data_align: -8}},
    caps:          arch.ADDRESSED,
    axes:          ?X86_AXES[0],
    axis_count:    X86_AXIS_COUNT,
};
pub val X86: Arch = Arch{
    name:          "x86",
    codes:         ?X86_CODES[0],
    code_count:    X86_CODE_COUNT,
    pointer_bytes: 4,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 4, ra: 8, code_align: 1, data_align: -4}},
    caps:          arch.ADDRESSED,
    axes:          ?X86_AXES[0],
    axis_count:    X86_AXIS_COUNT,
};
