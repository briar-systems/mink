# the WebAssembly architectures, told apart by the index type of their
# memories

use std.types.option.opt;
use std.types.size.usize;

use mink.bytes.reader;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Unwind;
use mink.catalog.format;
use mink.catalog.format.Code;

# wasm names its address width by the index type of its memories
val     WASM32_CODE_COUNT: usize                   = 1;
pub val WASM32_CODES:      [WASM32_CODE_COUNT]Code = [WASM32_CODE_COUNT]Code{Code{format: ?format.WASM, value: 32}};
val     WASM64_CODE_COUNT: usize                   = 1;
pub val WASM64_CODES:      [WASM64_CODE_COUNT]Code = [WASM64_CODE_COUNT]Code{Code{format: ?format.WASM, value: 64}};

pub val WASM32: Arch = Arch{
    name:          "wasm32",
    codes:         ?WASM32_CODES[0],
    code_count:    WASM32_CODE_COUNT,
    pointer_bytes: 4,
    order:         reader.LITTLE,
    page_size:     0x1_0000,
    unwind:        opt[Unwind].none{},
    caps:          arch.ADDRESSED | arch.INDEXED,
};
pub val WASM64: Arch = Arch{
    name:          "wasm64",
    codes:         ?WASM64_CODES[0],
    code_count:    WASM64_CODE_COUNT,
    pointer_bytes: 8,
    order:         reader.LITTLE,
    page_size:     0x1_0000,
    unwind:        opt[Unwind].none{},
    caps:          arch.ADDRESSED | arch.INDEXED,
};
