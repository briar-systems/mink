# the WebAssembly architectures, told apart by the index type of their
# memories

use std.types.option.opt;
use std.types.size.usize;

use mink.bytes.reader;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Code;
use mink.catalog.arch.Family;
use mink.catalog.arch.Ident;
use mink.catalog.arch.Pages;
use mink.catalog.arch.Pointer;
use mink.catalog.arch.Unwind;
use mink.catalog.format;
use mink.catalog.isa.Grammar;
use mink.catalog.merge.Mark;
use mink.catalog.merge.Meet;
use mink.catalog.merge.Merge;
use mink.catalog.merge.Policy;
use mink.catalog.trait;
use mink.catalog.trait.Axis;

# wasm names its address width by the index type of its memories
val WASM32_WASM: [1]Ident = [1]Ident{Ident{key: arch.WASM_INDEX, value: 32, mask: arch.EXACT}};
val WASM64_WASM: [1]Ident = [1]Ident{Ident{key: arch.WASM_INDEX, value: 64, mask: arch.EXACT}};

val     WASM32_CODE_COUNT: usize                   = 1;
pub val WASM32_CODES:      [WASM32_CODE_COUNT]Code = [WASM32_CODE_COUNT]Code{Code{format: ?format.WASM, fields: ?WASM32_WASM[0], count: 1}};
val     WASM64_CODE_COUNT: usize                   = 1;
pub val WASM64_CODES:      [WASM64_CODE_COUNT]Code = [WASM64_CODE_COUNT]Code{Code{format: ?format.WASM, fields: ?WASM64_WASM[0], count: 1}};

# a target feature is used or disallowed. a link refuses a feature one input
# uses and another disallows, and a feature an input leaves out takes the
# state the others give it, as wasm-ld merges the target features sections
val FEATURE_MARKS: [2]Mark = [2]Mark{Mark{mark: '+', name: "used"}, Mark{mark: '-', name: "disallowed"}};
val FEATURE_MEETS: [4]Meet = [4]Meet{
    Meet{held: '+', next: '+', kept: '+'},
    Meet{held: '+', next: '-', kept: 0},
    Meet{held: '-', next: '+', kept: 0},
    Meet{held: '-', next: '-', kept: '-'},
};
val FEATURE_POLICY: Policy = Policy{marks: ?FEATURE_MARKS[0], mark_count: 2, meets: ?FEATURE_MEETS[0], meet_count: 4, separator: ','};
val FEATURE_MERGE:  Merge  = Merge.set{?FEATURE_POLICY};

# the target features the code uses or disallows, each its mark and name
pub val WASM_FEATURES: Axis = Axis{name: "wasm-features", value: trait.Value.set{}, absent: trait.Absent.unconstrained{}, merge: ?FEATURE_MERGE, owner: trait.Owner.derived{}};

val WASM_AXIS_COUNT: usize                  = 1;
val WASM_AXES:       [WASM_AXIS_COUNT]*Axis = [WASM_AXIS_COUNT]*Axis{?WASM_FEATURES};

pub val WASM_FAMILY: Family = Family{name: "wasm", axes: ?WASM_AXES[0], axis_count: WASM_AXIS_COUNT, grammar: opt[*Grammar].none{}};

# a linear memory has no pages an image is aligned to, and its index type is
# a fact of each memory of the module
pub val WASM32: Arch = Arch{
    name:         "wasm32",
    family:       ?WASM_FAMILY,
    code:         ?WASM32_CODES[0],
    code_count:   WASM32_CODE_COUNT,
    pointer:      opt[Pointer].some{Pointer{bytes: 4}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[Pages].none{},
    spaces:       1,
    unwind:       opt[Unwind].none{},
    caps:         arch.ADDRESSED | arch.INDEXED,
    axes:         ?WASM_AXES[0],
    axis_count:   WASM_AXIS_COUNT,
};
pub val WASM64: Arch = Arch{
    name:         "wasm64",
    family:       ?WASM_FAMILY,
    code:         ?WASM64_CODES[0],
    code_count:   WASM64_CODE_COUNT,
    pointer:      opt[Pointer].some{Pointer{bytes: 8}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[Pages].none{},
    spaces:       1,
    unwind:       opt[Unwind].none{},
    caps:         arch.ADDRESSED | arch.INDEXED,
    axes:         ?WASM_AXES[0],
    axis_count:   WASM_AXIS_COUNT,
};
