# the SPIR-V architecture, whose modules hold no addresses

use std.types.option.opt;
use std.types.size.usize;

use mink.bytes.reader;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Unwind;
use mink.catalog.format;
use mink.catalog.format.Code;

# the SPIR-V magic number
val     SPIRV_CODE_COUNT: usize                  = 1;
pub val SPIRV_CODES:      [SPIRV_CODE_COUNT]Code = [SPIRV_CODE_COUNT]Code{Code{format: ?format.SPIRV, value: 0x0723_0203}};

pub val SPIRV: Arch = Arch{
    name:          "spirv",
    codes:         ?SPIRV_CODES[0],
    code_count:    SPIRV_CODE_COUNT,
    pointer_bytes: 8,
    order:         reader.LITTLE,
    page_size:     0,
    unwind:        opt[Unwind].none{},
    caps:          arch.INDEXED,
};
