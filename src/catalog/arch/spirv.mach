# the SPIR-V architecture, whose modules hold no addresses, and the trait
# axes a module states: the version of the specification it is written to,
# its addressing model, its memory model and the byte order of its words

use std.types.option.opt;
use std.types.size.usize;

use mink.bytes.reader;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Code;
use mink.catalog.arch.Family;
use mink.catalog.arch.Ident;
use mink.catalog.arch.Pages;
use mink.catalog.arch.Pointer;
use mink.catalog.arch.Unwind;
use mink.catalog.format;
use mink.catalog.isa.Grammar;
use mink.catalog.merge;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Choice;
use mink.catalog.trait.Setting;

# the SPIR-V magic number
val SPIRV_SPIRV: [1]Ident = [1]Ident{Ident{key: arch.SPIRV_MAGIC, value: 0x0723_0203, mask: arch.EXACT}};

val     SPIRV_CODE_COUNT: usize                  = 1;
pub val SPIRV_CODES:      [SPIRV_CODE_COUNT]Code = [SPIRV_CODE_COUNT]Code{Code{format: ?format.SPIRV, fields: ?SPIRV_SPIRV[0], count: 1}};

# the versions of the specification, each within the next, so a link takes
# the highest any module states
pub val SPIRV_1_6: Choice = Choice{name: "1.6"};

val SPIRV_1_5_WIDER: [1]*Choice = [1]*Choice{?SPIRV_1_6};

pub val SPIRV_1_5: Choice = Choice{name: "1.5", wider: ?SPIRV_1_5_WIDER[0], wider_count: 1};

val SPIRV_1_4_WIDER: [1]*Choice = [1]*Choice{?SPIRV_1_5};

pub val SPIRV_1_4: Choice = Choice{name: "1.4", wider: ?SPIRV_1_4_WIDER[0], wider_count: 1};

val SPIRV_1_3_WIDER: [1]*Choice = [1]*Choice{?SPIRV_1_4};

pub val SPIRV_1_3: Choice = Choice{name: "1.3", wider: ?SPIRV_1_3_WIDER[0], wider_count: 1};

val SPIRV_1_2_WIDER: [1]*Choice = [1]*Choice{?SPIRV_1_3};

pub val SPIRV_1_2: Choice = Choice{name: "1.2", wider: ?SPIRV_1_2_WIDER[0], wider_count: 1};

val SPIRV_1_1_WIDER: [1]*Choice = [1]*Choice{?SPIRV_1_2};

pub val SPIRV_1_1: Choice = Choice{name: "1.1", wider: ?SPIRV_1_1_WIDER[0], wider_count: 1};

val SPIRV_1_0_WIDER: [1]*Choice = [1]*Choice{?SPIRV_1_1};

pub val SPIRV_1_0: Choice = Choice{name: "1.0", wider: ?SPIRV_1_0_WIDER[0], wider_count: 1};

val SPIRV_VERSION_COUNT: usize                        = 7;
val SPIRV_VERSIONS:      [SPIRV_VERSION_COUNT]*Choice = [SPIRV_VERSION_COUNT]*Choice{?SPIRV_1_0, ?SPIRV_1_1, ?SPIRV_1_2, ?SPIRV_1_3, ?SPIRV_1_4, ?SPIRV_1_5, ?SPIRV_1_6};

pub val SPIRV_VERSION: Axis = Axis{name: "spirv-version", value: trait.Value.choice{}, absent: trait.Absent.unconstrained{}, merge: ?merge.ORDERED, owner: trait.Owner.source{}, choices: ?SPIRV_VERSIONS[0], count: SPIRV_VERSION_COUNT};

# the addressing models, which modules linked together state alike
pub val SPIRV_LOGICAL:                   Choice = Choice{name: "logical"};
pub val SPIRV_PHYSICAL32:                Choice = Choice{name: "physical32"};
pub val SPIRV_PHYSICAL64:                Choice = Choice{name: "physical64"};
pub val SPIRV_PHYSICAL_STORAGE_BUFFER64: Choice = Choice{name: "physical-storage-buffer64"};

val SPIRV_ADDRESSING_COUNT: usize                           = 4;
val SPIRV_ADDRESSINGS:      [SPIRV_ADDRESSING_COUNT]*Choice = [SPIRV_ADDRESSING_COUNT]*Choice{?SPIRV_LOGICAL, ?SPIRV_PHYSICAL32, ?SPIRV_PHYSICAL64, ?SPIRV_PHYSICAL_STORAGE_BUFFER64};

pub val SPIRV_ADDRESSING_MODEL: Axis = Axis{name: "spirv-addressing-model", value: trait.Value.choice{}, absent: trait.Absent.unconstrained{}, merge: ?merge.EQUAL, owner: trait.Owner.source{}, choices: ?SPIRV_ADDRESSINGS[0], count: SPIRV_ADDRESSING_COUNT};

# the memory models, which modules linked together state alike
pub val SPIRV_SIMPLE:  Choice = Choice{name: "simple"};
pub val SPIRV_GLSL450: Choice = Choice{name: "glsl450"};
pub val SPIRV_OPENCL:  Choice = Choice{name: "opencl"};
pub val SPIRV_VULKAN:  Choice = Choice{name: "vulkan"};

val SPIRV_MEMORY_MODEL_COUNT: usize                             = 4;
val SPIRV_MEMORY_MODELS:      [SPIRV_MEMORY_MODEL_COUNT]*Choice = [SPIRV_MEMORY_MODEL_COUNT]*Choice{?SPIRV_SIMPLE, ?SPIRV_GLSL450, ?SPIRV_OPENCL, ?SPIRV_VULKAN};

pub val SPIRV_MEMORY_MODEL: Axis = Axis{name: "spirv-memory-model", value: trait.Value.choice{}, absent: trait.Absent.unconstrained{}, merge: ?merge.EQUAL, owner: trait.Owner.source{}, choices: ?SPIRV_MEMORY_MODELS[0], count: SPIRV_MEMORY_MODEL_COUNT};

# the byte orders a module's words are written in, little endian when a
# module states none. modules of different orders link into one of the
# order an unstated module takes
pub val SPIRV_LITTLE_ENDIAN: Choice = Choice{name: "little"};
pub val SPIRV_BIG_ENDIAN:    Choice = Choice{name: "big"};

val SPIRV_BYTE_ORDER_COUNT: usize                           = 2;
val SPIRV_BYTE_ORDERS:      [SPIRV_BYTE_ORDER_COUNT]*Choice = [SPIRV_BYTE_ORDER_COUNT]*Choice{?SPIRV_LITTLE_ENDIAN, ?SPIRV_BIG_ENDIAN};

pub val SPIRV_BYTE_ORDER: Axis = Axis{name: "spirv-byte-order", value: trait.Value.choice{}, absent: trait.Absent.value{Setting.choice{?SPIRV_LITTLE_ENDIAN}}, merge: ?merge.AGREED, owner: trait.Owner.source{}, choices: ?SPIRV_BYTE_ORDERS[0], count: SPIRV_BYTE_ORDER_COUNT};

val SPIRV_AXIS_COUNT: usize                   = 4;
val SPIRV_AXES:       [SPIRV_AXIS_COUNT]*Axis = [SPIRV_AXIS_COUNT]*Axis{?SPIRV_VERSION, ?SPIRV_ADDRESSING_MODEL, ?SPIRV_MEMORY_MODEL, ?SPIRV_BYTE_ORDER};

pub val SPIRV_FAMILY: Family = Family{name: "spirv", axes: ?SPIRV_AXES[0], axis_count: SPIRV_AXIS_COUNT, grammar: opt[*Grammar].none{}};

# the addressing model is the host's, logical or physical, so the row states
# no pointer
pub val SPIRV: Arch = Arch{
    name:         "spirv",
    family:       ?SPIRV_FAMILY,
    code:         ?SPIRV_CODES[0],
    code_count:   SPIRV_CODE_COUNT,
    pointer:      opt[Pointer].none{},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[Pages].none{},
    spaces:       1,
    unwind:       opt[Unwind].none{},
    caps:         arch.INDEXED,
    axes:         ?SPIRV_AXES[0],
    axis_count:   SPIRV_AXIS_COUNT,
};
