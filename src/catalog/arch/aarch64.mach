# the 64-bit Arm architecture, its arm64e row and the trait axes its ELF
# property notes and its Mach-O cpusubtype state

use std.types.option.opt;
use std.types.size.usize;

use mink.bytes.reader;
use mink.catalog.arch;
use mink.catalog.arch.Abi;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Code;
use mink.catalog.arch.Family;
use mink.catalog.arch.Ident;
use mink.catalog.arch.Pages;
use mink.catalog.arch.Pointer;
use mink.catalog.arch.Unwind;
use mink.catalog.format;
use mink.catalog.isa.Grammar;
use mink.catalog.merge;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Setting;

# EM_AARCH64 little endian in a 64-bit file, IMAGE_FILE_MACHINE_ARM64, and
# CPU_TYPE_ARM64 with CPU_SUBTYPE_ARM64_ALL under the subtype bits
# CPU_SUBTYPE_MASK leaves
val AARCH64_ELF:   [3]Ident = [3]Ident{Ident{key: arch.ELF_MACHINE, value: 183, mask: arch.EXACT}, Ident{key: arch.ELF_CLASS, value: arch.CLASS64, mask: arch.EXACT}, Ident{key: arch.ELF_DATA, value: arch.LSB, mask: arch.EXACT}};
val AARCH64_COFF:  [1]Ident = [1]Ident{Ident{key: arch.COFF_MACHINE, value: 0xaa64, mask: arch.EXACT}};
val AARCH64_MACHO: [2]Ident = [2]Ident{Ident{key: arch.MACHO_CPU, value: 0x0100_000c, mask: arch.EXACT}, Ident{key: arch.MACHO_SUBTYPE, value: 0, mask: 0x00ff_ffff}};
# CPU_TYPE_ARM64 with CPU_SUBTYPE_ARM64E under the subtype bits CPU_SUBTYPE_MASK
# leaves, which hold the pointer authentication ABI an object states
val ARM64E_MACHO: [2]Ident = [2]Ident{Ident{key: arch.MACHO_CPU, value: 0x0100_000c, mask: arch.EXACT}, Ident{key: arch.MACHO_SUBTYPE, value: 2, mask: 0x00ff_ffff}};

val     AARCH64_CODE_COUNT: usize                    = 3;
pub val AARCH64_CODES:      [AARCH64_CODE_COUNT]Code = [AARCH64_CODE_COUNT]Code{
    Code{format: ?format.ELF, fields: ?AARCH64_ELF[0], count: 3},
    Code{format: ?format.COFF, fields: ?AARCH64_COFF[0], count: 1},
    Code{format: ?format.MACHO, fields: ?AARCH64_MACHO[0], count: 2},
};
val     ARM64E_CODE_COUNT: usize                   = 1;
pub val ARM64E_CODES:      [ARM64E_CODE_COUNT]Code = [ARM64E_CODE_COUNT]Code{
    Code{format: ?format.MACHO, fields: ?ARM64E_MACHO[0], count: 2},
};

# IMAGE_FILE_MACHINE_ARM64EC, the Windows ABI whose arm64 code shares its
# image with x64 code, named by COFF alone
val ARM64EC_COFF: [1]Ident = [1]Ident{Ident{key: arch.COFF_MACHINE, value: 0xa641, mask: arch.EXACT}};

val     ARM64EC_CODE_COUNT: usize                    = 1;
pub val ARM64EC_CODES:      [ARM64EC_CODE_COUNT]Code = [ARM64EC_CODE_COUNT]Code{
    Code{format: ?format.COFF, fields: ?ARM64EC_COFF[0], count: 1},
};

# every indirect branch target is marked, so branch target identification can
# be enforced
pub val AARCH64_BTI: Axis = Axis{name: "aarch64-bti", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.INTERSECTION, owner: trait.Owner.source{}};
# return addresses are signed with pointer authentication
pub val AARCH64_PAC: Axis = Axis{name: "aarch64-pac", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.INTERSECTION, owner: trait.Owner.source{}};
# the code keeps a guarded control stack of return addresses
pub val AARCH64_GCS: Axis = Axis{name: "aarch64-gcs", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.INTERSECTION, owner: trait.Owner.source{}};
# the platform whose pointer authentication ABI the code follows, and the
# version of that ABI, which the platform defines
pub val AARCH64_PAUTH_PLATFORM: Axis = Axis{name: "aarch64-pauth-platform", value: trait.Value.number{}, absent: trait.Absent.unconstrained{}, merge: ?merge.EQUAL, owner: trait.Owner.convention{}};
pub val AARCH64_PAUTH_VERSION:  Axis = Axis{name: "aarch64-pauth-version", value: trait.Value.number{}, absent: trait.Absent.unconstrained{}, merge: ?merge.EQUAL, owner: trait.Owner.convention{}};
# the arm64e pointer authentication ABI an object follows, which Mach-O
# carries in the cpusubtype: the ABI version, 0 to 15, whether the code
# follows the kernel ABI rather than the user one, and whether the version
# is meant at all. objects of different versions or ABIs do not link
pub val AARCH64_PTRAUTH_ABI_VERSION: Axis = Axis{name: "aarch64-ptrauth-abi-version", value: trait.Value.number{}, absent: trait.Absent.value{Setting.number{0}}, merge: ?merge.EQUAL, owner: trait.Owner.convention{}};
pub val AARCH64_PTRAUTH_KERNEL_ABI:  Axis = Axis{name: "aarch64-ptrauth-kernel-abi", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.EQUAL, owner: trait.Owner.convention{}};
pub val AARCH64_PTRAUTH_VERSIONED:   Axis = Axis{name: "aarch64-ptrauth-versioned", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.EQUAL, owner: trait.Owner.convention{}};

val AARCH64_AXIS_COUNT: usize                     = 5;
val AARCH64_AXES:       [AARCH64_AXIS_COUNT]*Axis = [AARCH64_AXIS_COUNT]*Axis{?AARCH64_BTI, ?AARCH64_PAC, ?AARCH64_GCS, ?AARCH64_PAUTH_PLATFORM, ?AARCH64_PAUTH_VERSION};
val ARM64E_AXIS_COUNT:  usize                     = 8;
val ARM64E_AXES:        [ARM64E_AXIS_COUNT]*Axis  = [ARM64E_AXIS_COUNT]*Axis{?AARCH64_BTI, ?AARCH64_PAC, ?AARCH64_GCS, ?AARCH64_PAUTH_PLATFORM, ?AARCH64_PAUTH_VERSION, ?AARCH64_PTRAUTH_ABI_VERSION, ?AARCH64_PTRAUTH_KERNEL_ABI, ?AARCH64_PTRAUTH_VERSIONED};

# the calling conventions, each spelled as mach's target abi names it. the
# base AAPCS64; Apple's DarwinPCS, which differs in variadic arguments, char
# signedness and stack slot packing, on arm64 and arm64e alike; the Windows
# ARM64 convention, which differs in variadic arguments; and ARM64EC, which
# follows the x64 convention at its boundaries
pub val AARCH64_AAPCS64:    Abi = Abi{name: "aapcs64", arch: ?AARCH64};
pub val AARCH64_DARWINPCS:  Abi = Abi{name: "darwinpcs", arch: ?AARCH64};
pub val AARCH64_AAPCS64WIN: Abi = Abi{name: "aapcs64win", arch: ?AARCH64};
pub val ARM64E_DARWINPCS:   Abi = Abi{name: "darwinpcs", arch: ?ARM64E};
pub val ARM64EC_ARM64EC:    Abi = Abi{name: "arm64ec", arch: ?ARM64EC};

val AARCH64_ABI_COUNT: usize                   = 5;
val AARCH64_ABIS:      [AARCH64_ABI_COUNT]*Abi = [AARCH64_ABI_COUNT]*Abi{?AARCH64_AAPCS64, ?AARCH64_DARWINPCS, ?AARCH64_AAPCS64WIN, ?ARM64E_DARWINPCS, ?ARM64EC_ARM64EC};

pub val AARCH64_FAMILY: Family = Family{
    name:       "aarch64",
    axes:       ?ARM64E_AXES[0],
    axis_count: ARM64E_AXIS_COUNT,
    grammar:    opt[*Grammar].none{},
    abis:       ?AARCH64_ABIS[0],
    abi_count:  AARCH64_ABI_COUNT,
};

# a 4 KiB base page, and 64 KiB, the largest translation granule, as the
# largest page an image is aligned to
pub val AARCH64: Arch = Arch{
    name:         "aarch64",
    family:       ?AARCH64_FAMILY,
    code:         ?AARCH64_CODES[0],
    code_count:   AARCH64_CODE_COUNT,
    pointer:      opt[Pointer].some{Pointer{bytes: 8}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[Pages].some{Pages{size: 0x1000, max: 0x1_0000}},
    spaces:       1,
    unwind:       opt[Unwind].some{Unwind{sp: 31, ra: 30}},
    caps:         arch.ADDRESSED,
    axes:         ?AARCH64_AXES[0],
    axis_count:   AARCH64_AXIS_COUNT,
};

# the arm64e row: AArch64 with pointer authentication, which Mach-O alone names.
# Apple silicon runs 16 KiB pages
pub val ARM64E: Arch = Arch{
    name:         "arm64e",
    family:       ?AARCH64_FAMILY,
    code:         ?ARM64E_CODES[0],
    code_count:   ARM64E_CODE_COUNT,
    pointer:      opt[Pointer].some{Pointer{bytes: 8}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[Pages].some{Pages{size: 0x4000, max: 0x4000}},
    spaces:       1,
    unwind:       opt[Unwind].some{Unwind{sp: 31, ra: 30}},
    caps:         arch.ADDRESSED | arch.SIGNED,
    axes:         ?ARM64E_AXES[0],
    axis_count:   ARM64E_AXIS_COUNT,
};

# the arm64 instruction set under the ARM64EC ABI, its pages and registers the
# arm64 row's
pub val ARM64EC: Arch = Arch{
    name:         "arm64ec",
    family:       ?AARCH64_FAMILY,
    code:         ?ARM64EC_CODES[0],
    code_count:   ARM64EC_CODE_COUNT,
    pointer:      opt[Pointer].some{Pointer{bytes: 8}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[Pages].some{Pages{size: 0x1000, max: 0x1_0000}},
    spaces:       1,
    unwind:       opt[Unwind].some{Unwind{sp: 31, ra: 30}},
    caps:         arch.ADDRESSED,
    axes:         ?AARCH64_AXES[0],
    axis_count:   AARCH64_AXIS_COUNT,
};
