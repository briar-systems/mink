# the 64-bit Arm architecture and the trait axes its ELF property notes state

use std.types.option.opt;
use std.types.size.usize;

use mink.bytes.reader;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Unwind;
use mink.catalog.format;
use mink.catalog.format.Code;
use mink.catalog.trait;
use mink.catalog.trait.Axis;

val     AARCH64_CODE_COUNT: usize                    = 3;
pub val AARCH64_CODES:      [AARCH64_CODE_COUNT]Code = [AARCH64_CODE_COUNT]Code{
    Code{format: ?format.ELF, value: 183, qualifier: arch.CLASS64},
    Code{format: ?format.COFF, value: 0xaa64},
    Code{format: ?format.MACHO, value: 0x0100_000c, qualifier: 0},
};

# every indirect branch target is marked, so branch target identification can
# be enforced
pub val AARCH64_BTI: Axis = Axis{name: "aarch64-bti", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};
# return addresses are signed with pointer authentication
pub val AARCH64_PAC: Axis = Axis{name: "aarch64-pac", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};
# the code keeps a guarded control stack of return addresses
pub val AARCH64_GCS: Axis = Axis{name: "aarch64-gcs", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};

val AARCH64_AXIS_COUNT: usize                     = 3;
val AARCH64_AXES:       [AARCH64_AXIS_COUNT]*Axis = [AARCH64_AXIS_COUNT]*Axis{?AARCH64_BTI, ?AARCH64_PAC, ?AARCH64_GCS};

pub val AARCH64: Arch = Arch{
    name:          "aarch64",
    codes:         ?AARCH64_CODES[0],
    code_count:    AARCH64_CODE_COUNT,
    pointer_bytes: 8,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 31, ra: 30, code_align: 1, data_align: -8}},
    caps:          arch.ADDRESSED,
    axes:          ?AARCH64_AXES[0],
    axis_count:    AARCH64_AXIS_COUNT,
};
