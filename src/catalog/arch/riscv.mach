# the RISC-V architectures and the trait axes their attributes state

use std.types.option.opt;
use std.types.size.usize;

use mink.bytes.reader;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Unwind;
use mink.catalog.format;
use mink.catalog.format.Code;
use mink.catalog.isa.Grammar;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Choice;

val     RV64_CODE_COUNT: usize                 = 2;
pub val RV64_CODES:      [RV64_CODE_COUNT]Code = [RV64_CODE_COUNT]Code{
    Code{format: ?format.ELF, value: 243, qualifier: arch.CLASS64},
    Code{format: ?format.COFF, value: 0x5064},
};
val     RV32_CODE_COUNT: usize                 = 2;
pub val RV32_CODES:      [RV32_CODE_COUNT]Code = [RV32_CODE_COUNT]Code{
    Code{format: ?format.ELF, value: 243, qualifier: arch.CLASS32},
    Code{format: ?format.COFF, value: 0x5032},
};

# the RISC-V psABI calling convention for floating point arguments
pub val RISCV_SOFT:   Choice = Choice{name: "soft"};
pub val RISCV_SINGLE: Choice = Choice{name: "single"};
pub val RISCV_DOUBLE: Choice = Choice{name: "double"};
pub val RISCV_QUAD:   Choice = Choice{name: "quad"};

val RISCV_FLOAT_ABI_COUNT: usize                          = 4;
val RISCV_FLOAT_ABIS:      [RISCV_FLOAT_ABI_COUNT]*Choice = [RISCV_FLOAT_ABI_COUNT]*Choice{?RISCV_SOFT, ?RISCV_SINGLE, ?RISCV_DOUBLE, ?RISCV_QUAD};

pub val RISCV_FLOAT_ABI: Axis = Axis{name: "riscv-float-abi", value: trait.Value.choice{}, merge: trait.Merge.equal{}, choices: ?RISCV_FLOAT_ABIS[0], count: RISCV_FLOAT_ABI_COUNT};
# the code holds compressed instructions
pub val RISCV_RVC: Axis = Axis{name: "riscv-rvc", value: trait.Value.flag{}, merge: trait.Merge.union{}};
# the code is for the embedded base, sixteen integer registers
pub val RISCV_RVE: Axis = Axis{name: "riscv-rve", value: trait.Value.flag{}, merge: trait.Merge.equal{}};
# the code assumes total store ordering
pub val RISCV_TSO: Axis = Axis{name: "riscv-tso", value: trait.Value.flag{}, merge: trait.Merge.union{}};

# the RISC-V ISA string grammar: a base of `rv` and the register width, the
# base integer set first, then the canonical order of the RISC-V ISA manual
pub val RISCV_EXTENSIONS: Grammar = Grammar{base: "rv", bases: "ie", single: "iemafdqlcbkjtpvnh", multi: "zsx", ranked: "z"};
# the ISA string the code is for, as Tag_RISCV_arch states it
pub val RISCV_ARCH: Axis = Axis{name: "riscv-arch", value: trait.Value.text{}, merge: trait.Merge.extensions{?RISCV_EXTENSIONS}};
# the alignment the code keeps the stack at, in bytes
pub val RISCV_STACK_ALIGN: Axis = Axis{name: "riscv-stack-align", value: trait.Value.number{}, merge: trait.Merge.equal{}};
# the code makes unaligned memory accesses
pub val RISCV_UNALIGNED_ACCESS: Axis = Axis{name: "riscv-unaligned-access", value: trait.Value.flag{}, merge: trait.Merge.union{}};
# the privileged specification version the code was built for, kept when
# every input states the same and dropped otherwise, as lld drops a
# disagreeing Tag_RISCV_priv_spec
pub val RISCV_PRIV_SPEC:          Axis = Axis{name: "riscv-priv-spec", value: trait.Value.number{}, merge: trait.Merge.agreed{}};
pub val RISCV_PRIV_SPEC_MINOR:    Axis = Axis{name: "riscv-priv-spec-minor", value: trait.Value.number{}, merge: trait.Merge.agreed{}};
pub val RISCV_PRIV_SPEC_REVISION: Axis = Axis{name: "riscv-priv-spec-revision", value: trait.Value.number{}, merge: trait.Merge.agreed{}};

# the atomics ABI the code uses, as Tag_RISCV_atomic_abi states it. the
# psABI's merge table makes unknown lie within every ABI and the strengthened
# A6 lie within the classic A6 and A7, which do not merge
pub val RISCV_ATOMIC_A6C: Choice = Choice{name: "a6c"};
pub val RISCV_ATOMIC_A7:  Choice = Choice{name: "a7"};

val RISCV_ATOMIC_A6S_WIDER: [2]*Choice = [2]*Choice{?RISCV_ATOMIC_A6C, ?RISCV_ATOMIC_A7};

pub val RISCV_ATOMIC_A6S: Choice = Choice{name: "a6s", wider: ?RISCV_ATOMIC_A6S_WIDER[0], wider_count: 2};

val RISCV_ATOMIC_UNKNOWN_WIDER: [1]*Choice = [1]*Choice{?RISCV_ATOMIC_A6S};

pub val RISCV_ATOMIC_UNKNOWN: Choice = Choice{name: "unknown", wider: ?RISCV_ATOMIC_UNKNOWN_WIDER[0], wider_count: 1};

val RISCV_ATOMIC_ABI_COUNT: usize                           = 4;
val RISCV_ATOMIC_ABIS:      [RISCV_ATOMIC_ABI_COUNT]*Choice = [RISCV_ATOMIC_ABI_COUNT]*Choice{?RISCV_ATOMIC_UNKNOWN, ?RISCV_ATOMIC_A6C, ?RISCV_ATOMIC_A6S, ?RISCV_ATOMIC_A7};

pub val RISCV_ATOMIC_ABI: Axis = Axis{name: "riscv-atomic-abi", value: trait.Value.choice{}, merge: trait.Merge.ordered{}, choices: ?RISCV_ATOMIC_ABIS[0], count: RISCV_ATOMIC_ABI_COUNT};

# what the code uses x3 for, as Tag_RISCV_x3_reg_usage states it: a fixed
# register of unknown purpose, the global pointer, the shadow stack pointer or
# a temporary. the psABI merges only differing values of which one is the
# fixed register, into the other, so the fixed register lies within the global
# pointer and the shadow stack pointer
pub val RISCV_X3_GP:           Choice = Choice{name: "gp"};
pub val RISCV_X3_SHADOW_STACK: Choice = Choice{name: "shadow-stack"};
pub val RISCV_X3_TEMPORARY:    Choice = Choice{name: "temporary"};

val RISCV_X3_FIXED_WIDER: [2]*Choice = [2]*Choice{?RISCV_X3_GP, ?RISCV_X3_SHADOW_STACK};

pub val RISCV_X3_FIXED: Choice = Choice{name: "fixed", wider: ?RISCV_X3_FIXED_WIDER[0], wider_count: 2};

val RISCV_X3_USAGE_COUNT: usize                         = 4;
val RISCV_X3_USAGES:      [RISCV_X3_USAGE_COUNT]*Choice = [RISCV_X3_USAGE_COUNT]*Choice{?RISCV_X3_FIXED, ?RISCV_X3_GP, ?RISCV_X3_SHADOW_STACK, ?RISCV_X3_TEMPORARY};

pub val RISCV_X3_REG_USAGE: Axis = Axis{name: "riscv-x3-reg-usage", value: trait.Value.choice{}, merge: trait.Merge.ordered{}, choices: ?RISCV_X3_USAGES[0], count: RISCV_X3_USAGE_COUNT};

# the code marks indirect branch targets with unlabeled landing pads, keeps a
# shadow stack, and marks them with function signature labels
pub val RISCV_CFI_LP_UNLABELED: Axis = Axis{name: "riscv-cfi-lp-unlabeled", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};
pub val RISCV_CFI_SS:           Axis = Axis{name: "riscv-cfi-ss", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};
pub val RISCV_CFI_LP_FUNC_SIG:  Axis = Axis{name: "riscv-cfi-lp-func-sig", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};

val RISCV_AXIS_COUNT: usize                   = 15;
val RISCV_AXES:       [RISCV_AXIS_COUNT]*Axis = [RISCV_AXIS_COUNT]*Axis{?RISCV_FLOAT_ABI, ?RISCV_RVC, ?RISCV_RVE, ?RISCV_TSO, ?RISCV_ARCH, ?RISCV_STACK_ALIGN, ?RISCV_UNALIGNED_ACCESS, ?RISCV_PRIV_SPEC, ?RISCV_PRIV_SPEC_MINOR, ?RISCV_PRIV_SPEC_REVISION, ?RISCV_ATOMIC_ABI, ?RISCV_X3_REG_USAGE, ?RISCV_CFI_LP_UNLABELED, ?RISCV_CFI_SS, ?RISCV_CFI_LP_FUNC_SIG};

pub val RISCV64: Arch = Arch{
    name:          "riscv64",
    codes:         ?RV64_CODES[0],
    code_count:    RV64_CODE_COUNT,
    pointer_bytes: 8,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 2, ra: 1, code_align: 1, data_align: -4}},
    caps:          arch.ADDRESSED,
    axes:          ?RISCV_AXES[0],
    axis_count:    RISCV_AXIS_COUNT,
};
pub val RISCV32: Arch = Arch{
    name:          "riscv32",
    codes:         ?RV32_CODES[0],
    code_count:    RV32_CODE_COUNT,
    pointer_bytes: 4,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 2, ra: 1, code_align: 1, data_align: -4}},
    caps:          arch.ADDRESSED,
    axes:          ?RISCV_AXES[0],
    axis_count:    RISCV_AXIS_COUNT,
};
