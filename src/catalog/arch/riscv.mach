# the RISC-V architectures and the trait axes their attributes state

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

use mink.bytes.reader;
use mink.catalog.arch;
use mink.catalog.arch.Abi;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Code;
use mink.catalog.arch.Family;
use mink.catalog.arch.Ident;
use mink.catalog.arch.Pages;
use mink.catalog.arch.Pointer;
use mink.catalog.arch.Unwind;
use mink.catalog.format;
use mink.catalog.isa.Base;
use mink.catalog.isa.Grammar;
use mink.catalog.merge;
use mink.catalog.merge.Merge;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Choice;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;

# EM_RISCV little endian in each class, told apart from the embedded base by
# EF_RISCV_RVE, which the E rows set and the others leave clear, and the COFF
# machines of the full bases
val RV64_ELF:  [4]Ident = [4]Ident{Ident{key: arch.ELF_MACHINE, value: 243, mask: arch.EXACT}, Ident{key: arch.ELF_CLASS, value: arch.CLASS64, mask: arch.EXACT}, Ident{key: arch.ELF_DATA, value: arch.LSB, mask: arch.EXACT}, Ident{key: arch.ELF_FLAGS, value: 0, mask: RVE}};
val RV64_COFF: [1]Ident = [1]Ident{Ident{key: arch.COFF_MACHINE, value: 0x5064, mask: arch.EXACT}};
val RV32_ELF:  [4]Ident = [4]Ident{Ident{key: arch.ELF_MACHINE, value: 243, mask: arch.EXACT}, Ident{key: arch.ELF_CLASS, value: arch.CLASS32, mask: arch.EXACT}, Ident{key: arch.ELF_DATA, value: arch.LSB, mask: arch.EXACT}, Ident{key: arch.ELF_FLAGS, value: 0, mask: RVE}};
val RV32_COFF: [1]Ident = [1]Ident{Ident{key: arch.COFF_MACHINE, value: 0x5032, mask: arch.EXACT}};
val RV64E_ELF: [4]Ident = [4]Ident{Ident{key: arch.ELF_MACHINE, value: 243, mask: arch.EXACT}, Ident{key: arch.ELF_CLASS, value: arch.CLASS64, mask: arch.EXACT}, Ident{key: arch.ELF_DATA, value: arch.LSB, mask: arch.EXACT}, Ident{key: arch.ELF_FLAGS, value: RVE, mask: RVE}};
val RV32E_ELF: [4]Ident = [4]Ident{Ident{key: arch.ELF_MACHINE, value: 243, mask: arch.EXACT}, Ident{key: arch.ELF_CLASS, value: arch.CLASS32, mask: arch.EXACT}, Ident{key: arch.ELF_DATA, value: arch.LSB, mask: arch.EXACT}, Ident{key: arch.ELF_FLAGS, value: RVE, mask: RVE}};

# EF_RISCV_RVE
val RVE: u64 = 0x8;

val     RV64_CODE_COUNT: usize                 = 2;
pub val RV64_CODES:      [RV64_CODE_COUNT]Code = [RV64_CODE_COUNT]Code{
    Code{format: ?format.ELF, fields: ?RV64_ELF[0], count: 4},
    Code{format: ?format.COFF, fields: ?RV64_COFF[0], count: 1},
};
val     RV32_CODE_COUNT: usize                 = 2;
pub val RV32_CODES:      [RV32_CODE_COUNT]Code = [RV32_CODE_COUNT]Code{
    Code{format: ?format.ELF, fields: ?RV32_ELF[0], count: 4},
    Code{format: ?format.COFF, fields: ?RV32_COFF[0], count: 1},
};
val     RV64E_CODE_COUNT: usize                  = 1;
pub val RV64E_CODES:      [RV64E_CODE_COUNT]Code = [RV64E_CODE_COUNT]Code{Code{format: ?format.ELF, fields: ?RV64E_ELF[0], count: 4}};
val     RV32E_CODE_COUNT: usize                  = 1;
pub val RV32E_CODES:      [RV32E_CODE_COUNT]Code = [RV32E_CODE_COUNT]Code{Code{format: ?format.ELF, fields: ?RV32E_ELF[0], count: 4}};

# the RISC-V psABI calling convention for floating point arguments
pub val RISCV_SOFT:   Choice = Choice{name: "soft"};
pub val RISCV_SINGLE: Choice = Choice{name: "single"};
pub val RISCV_DOUBLE: Choice = Choice{name: "double"};
pub val RISCV_QUAD:   Choice = Choice{name: "quad"};

val RISCV_FLOAT_ABI_COUNT: usize                          = 4;
val RISCV_FLOAT_ABIS:      [RISCV_FLOAT_ABI_COUNT]*Choice = [RISCV_FLOAT_ABI_COUNT]*Choice{?RISCV_SOFT, ?RISCV_SINGLE, ?RISCV_DOUBLE, ?RISCV_QUAD};

pub val RISCV_FLOAT_ABI: Axis = Axis{name: "riscv-float-abi", value: trait.Value.choice{}, absent: trait.Absent.unconstrained{}, merge: ?merge.EQUAL, owner: trait.Owner.convention{}, choices: ?RISCV_FLOAT_ABIS[0], count: RISCV_FLOAT_ABI_COUNT};
# the code holds compressed instructions, as any stretch of it may, so it is
# the union of every view the code was written under
pub val RISCV_RVC: Axis = Axis{name: "riscv-rvc", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.derived{}};
# the code is for the embedded base, sixteen integer registers
pub val RISCV_RVE: Axis = Axis{name: "riscv-rve", value: trait.Value.flag{}, absent: trait.Absent.unconstrained{}, merge: ?merge.EQUAL, owner: trait.Owner.fixed{}};
# the code assumes total store ordering
pub val RISCV_TSO: Axis = Axis{name: "riscv-tso", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.UNION, owner: trait.Owner.selection{}};

# the RISC-V ISA string grammar: `rv`, the register width and the base
# integer set, I or the embedded E, each base naming its row, then the
# canonical order of the RISC-V ISA manual
val RISCV_BASE_COUNT: usize                  = 4;
val RISCV_BASES:      [RISCV_BASE_COUNT]Base = [RISCV_BASE_COUNT]Base{
    Base{spelling: "rv32i", arch: "riscv32"},
    Base{spelling: "rv64i", arch: "riscv64"},
    Base{spelling: "rv32e", arch: "riscv32e"},
    Base{spelling: "rv64e", arch: "riscv64e"},
};

pub val RISCV_GRAMMAR: Grammar = Grammar{prefix: "rv", bases: ?RISCV_BASES[0], base_count: RISCV_BASE_COUNT, single: "iemafdqlcbkjtpvnh", multi: "zsx", ranked: "z"};
# ISA strings merge over the grammar
pub val RISCV_EXTENSIONS: Merge = Merge.extensions{?RISCV_GRAMMAR};
# the ISA string the code is for, as Tag_RISCV_arch states it
pub val RISCV_ARCH: Axis = Axis{name: "riscv-arch", value: trait.Value.text{}, absent: trait.Absent.unconstrained{}, merge: ?RISCV_EXTENSIONS, owner: trait.Owner.selection{}};
# the alignment the code keeps the stack at, in bytes
pub val RISCV_STACK_ALIGN: Axis = Axis{name: "riscv-stack-align", value: trait.Value.number{}, absent: trait.Absent.unconstrained{}, merge: ?merge.EQUAL, owner: trait.Owner.convention{}};
# the code makes unaligned memory accesses
pub val RISCV_UNALIGNED_ACCESS: Axis = Axis{name: "riscv-unaligned-access", value: trait.Value.flag{}, absent: trait.Absent.unconstrained{}, merge: ?merge.UNION, owner: trait.Owner.source{}};
# the privileged specification version the code was built for, kept when
# every input states the same and dropped otherwise, as lld drops a
# disagreeing Tag_RISCV_priv_spec
pub val RISCV_PRIV_SPEC:          Axis = Axis{name: "riscv-priv-spec", value: trait.Value.number{}, absent: trait.Absent.unconstrained{}, merge: ?merge.AGREED, owner: trait.Owner.source{}};
pub val RISCV_PRIV_SPEC_MINOR:    Axis = Axis{name: "riscv-priv-spec-minor", value: trait.Value.number{}, absent: trait.Absent.unconstrained{}, merge: ?merge.AGREED, owner: trait.Owner.source{}};
pub val RISCV_PRIV_SPEC_REVISION: Axis = Axis{name: "riscv-priv-spec-revision", value: trait.Value.number{}, absent: trait.Absent.unconstrained{}, merge: ?merge.AGREED, owner: trait.Owner.source{}};

# the atomics ABI the code uses, as Tag_RISCV_atomic_abi states it. the
# psABI's merge table makes unknown lie within every ABI and the strengthened
# A6 lie within the classic A6 and A7, which do not merge
pub val RISCV_ATOMIC_A6C: Choice = Choice{name: "a6c"};
pub val RISCV_ATOMIC_A7:  Choice = Choice{name: "a7"};

val RISCV_ATOMIC_A6S_WIDER: [2]*Choice = [2]*Choice{?RISCV_ATOMIC_A6C, ?RISCV_ATOMIC_A7};

pub val RISCV_ATOMIC_A6S: Choice = Choice{name: "a6s", wider: ?RISCV_ATOMIC_A6S_WIDER[0], wider_count: 2};

val RISCV_ATOMIC_UNKNOWN_WIDER: [1]*Choice = [1]*Choice{?RISCV_ATOMIC_A6S};

pub val RISCV_ATOMIC_UNKNOWN: Choice = Choice{name: "unknown", wider: ?RISCV_ATOMIC_UNKNOWN_WIDER[0], wider_count: 1};

val RISCV_ATOMIC_ABI_COUNT: usize                           = 4;
val RISCV_ATOMIC_ABIS:      [RISCV_ATOMIC_ABI_COUNT]*Choice = [RISCV_ATOMIC_ABI_COUNT]*Choice{?RISCV_ATOMIC_UNKNOWN, ?RISCV_ATOMIC_A6C, ?RISCV_ATOMIC_A6S, ?RISCV_ATOMIC_A7};

pub val RISCV_ATOMIC_ABI: Axis = Axis{name: "riscv-atomic-abi", value: trait.Value.choice{}, absent: trait.Absent.unconstrained{}, merge: ?merge.ORDERED, owner: trait.Owner.convention{}, choices: ?RISCV_ATOMIC_ABIS[0], count: RISCV_ATOMIC_ABI_COUNT};

# what the code uses x3 for, as Tag_RISCV_x3_reg_usage states it: a fixed
# register of unknown purpose, the global pointer, the shadow stack pointer or
# a temporary. the psABI merges only differing values of which one is the
# fixed register, into the other, so the fixed register lies within the global
# pointer and the shadow stack pointer
pub val RISCV_X3_GP:           Choice = Choice{name: "gp"};
pub val RISCV_X3_SHADOW_STACK: Choice = Choice{name: "shadow-stack"};
pub val RISCV_X3_TEMPORARY:    Choice = Choice{name: "temporary"};

val RISCV_X3_FIXED_WIDER: [2]*Choice = [2]*Choice{?RISCV_X3_GP, ?RISCV_X3_SHADOW_STACK};

pub val RISCV_X3_FIXED: Choice = Choice{name: "fixed", wider: ?RISCV_X3_FIXED_WIDER[0], wider_count: 2};

val RISCV_X3_USAGE_COUNT: usize                         = 4;
val RISCV_X3_USAGES:      [RISCV_X3_USAGE_COUNT]*Choice = [RISCV_X3_USAGE_COUNT]*Choice{?RISCV_X3_FIXED, ?RISCV_X3_GP, ?RISCV_X3_SHADOW_STACK, ?RISCV_X3_TEMPORARY};

pub val RISCV_X3_REG_USAGE: Axis = Axis{name: "riscv-x3-reg-usage", value: trait.Value.choice{}, absent: trait.Absent.unconstrained{}, merge: ?merge.ORDERED, owner: trait.Owner.convention{}, choices: ?RISCV_X3_USAGES[0], count: RISCV_X3_USAGE_COUNT};

# the code marks indirect branch targets with unlabeled landing pads, keeps a
# shadow stack, and marks them with function signature labels
pub val RISCV_CFI_LP_UNLABELED: Axis = Axis{name: "riscv-cfi-lp-unlabeled", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.INTERSECTION, owner: trait.Owner.source{}};
pub val RISCV_CFI_SS:           Axis = Axis{name: "riscv-cfi-ss", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.INTERSECTION, owner: trait.Owner.source{}};
pub val RISCV_CFI_LP_FUNC_SIG:  Axis = Axis{name: "riscv-cfi-lp-func-sig", value: trait.Value.flag{}, absent: trait.Absent.clear{}, merge: ?merge.INTERSECTION, owner: trait.Owner.source{}};

val RISCV_AXIS_COUNT: usize                   = 15;
val RISCV_AXES:       [RISCV_AXIS_COUNT]*Axis = [RISCV_AXIS_COUNT]*Axis{?RISCV_FLOAT_ABI, ?RISCV_RVC, ?RISCV_RVE, ?RISCV_TSO, ?RISCV_ARCH, ?RISCV_STACK_ALIGN, ?RISCV_UNALIGNED_ACCESS, ?RISCV_PRIV_SPEC, ?RISCV_PRIV_SPEC_MINOR, ?RISCV_PRIV_SPEC_REVISION, ?RISCV_ATOMIC_ABI, ?RISCV_X3_REG_USAGE, ?RISCV_CFI_LP_UNLABELED, ?RISCV_CFI_SS, ?RISCV_CFI_LP_FUNC_SIG};

# the base each row is for, which EF_RISCV_RVE also codes
val FULL_BASE:     [1]Trait = [1]Trait{Trait{axis: ?RISCV_RVE, setting: Setting.flag{false}}};
val EMBEDDED_BASE: [1]Trait = [1]Trait{Trait{axis: ?RISCV_RVE, setting: Setting.flag{true}}};

# the psABI ABI names, each with the float ABI it implies, ilp32e and lp64e
# on the embedded rows alone
val SOFT:   [1]Trait = [1]Trait{Trait{axis: ?RISCV_FLOAT_ABI, setting: Setting.choice{?RISCV_SOFT}}};
val SINGLE: [1]Trait = [1]Trait{Trait{axis: ?RISCV_FLOAT_ABI, setting: Setting.choice{?RISCV_SINGLE}}};
val DOUBLE: [1]Trait = [1]Trait{Trait{axis: ?RISCV_FLOAT_ABI, setting: Setting.choice{?RISCV_DOUBLE}}};

val RISCV_ABI_COUNT: usize                = 8;
val RISCV_ABIS:      [RISCV_ABI_COUNT]Abi = [RISCV_ABI_COUNT]Abi{
    Abi{name: "ilp32", arch: ?RISCV32, settings: ?SOFT[0], count: 1},
    Abi{name: "ilp32f", arch: ?RISCV32, settings: ?SINGLE[0], count: 1},
    Abi{name: "ilp32d", arch: ?RISCV32, settings: ?DOUBLE[0], count: 1},
    Abi{name: "ilp32e", arch: ?RISCV32E, settings: ?SOFT[0], count: 1},
    Abi{name: "lp64", arch: ?RISCV64, settings: ?SOFT[0], count: 1},
    Abi{name: "lp64f", arch: ?RISCV64, settings: ?SINGLE[0], count: 1},
    Abi{name: "lp64d", arch: ?RISCV64, settings: ?DOUBLE[0], count: 1},
    Abi{name: "lp64e", arch: ?RISCV64E, settings: ?SOFT[0], count: 1},
};

pub val RISCV_FAMILY: Family = Family{
    name:       "riscv",
    axes:       ?RISCV_AXES[0],
    axis_count: RISCV_AXIS_COUNT,
    grammar:    opt[*Grammar].some{?RISCV_GRAMMAR},
    abis:       ?RISCV_ABIS[0],
    abi_count:  RISCV_ABI_COUNT,
};

pub val RISCV64: Arch = Arch{
    name:         "riscv64",
    family:       ?RISCV_FAMILY,
    code:         ?RV64_CODES[0],
    code_count:   RV64_CODE_COUNT,
    pointer:      opt[Pointer].some{Pointer{bytes: 8}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[Pages].some{Pages{size: 0x1000, max: 0x1000}},
    spaces:       1,
    unwind:       opt[Unwind].some{Unwind{sp: 2, ra: 1}},
    caps:         arch.ADDRESSED,
    axes:         ?RISCV_AXES[0],
    axis_count:   RISCV_AXIS_COUNT,
    fixed:        ?FULL_BASE[0],
    fixed_count:  1,
};
pub val RISCV32: Arch = Arch{
    name:         "riscv32",
    family:       ?RISCV_FAMILY,
    code:         ?RV32_CODES[0],
    code_count:   RV32_CODE_COUNT,
    pointer:      opt[Pointer].some{Pointer{bytes: 4}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[Pages].some{Pages{size: 0x1000, max: 0x1000}},
    spaces:       1,
    unwind:       opt[Unwind].some{Unwind{sp: 2, ra: 1}},
    caps:         arch.ADDRESSED,
    axes:         ?RISCV_AXES[0],
    axis_count:   RISCV_AXIS_COUNT,
    fixed:        ?FULL_BASE[0],
    fixed_count:  1,
};
# the embedded bases, sixteen integer registers, machines of their own
pub val RISCV64E: Arch = Arch{
    name:         "riscv64e",
    family:       ?RISCV_FAMILY,
    code:         ?RV64E_CODES[0],
    code_count:   RV64E_CODE_COUNT,
    pointer:      opt[Pointer].some{Pointer{bytes: 8}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[Pages].some{Pages{size: 0x1000, max: 0x1000}},
    spaces:       1,
    unwind:       opt[Unwind].some{Unwind{sp: 2, ra: 1}},
    caps:         arch.ADDRESSED,
    axes:         ?RISCV_AXES[0],
    axis_count:   RISCV_AXIS_COUNT,
    fixed:        ?EMBEDDED_BASE[0],
    fixed_count:  1,
};
pub val RISCV32E: Arch = Arch{
    name:         "riscv32e",
    family:       ?RISCV_FAMILY,
    code:         ?RV32E_CODES[0],
    code_count:   RV32E_CODE_COUNT,
    pointer:      opt[Pointer].some{Pointer{bytes: 4}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[Pages].some{Pages{size: 0x1000, max: 0x1000}},
    spaces:       1,
    unwind:       opt[Unwind].some{Unwind{sp: 2, ra: 1}},
    caps:         arch.ADDRESSED,
    axes:         ?RISCV_AXES[0],
    axis_count:   RISCV_AXIS_COUNT,
    fixed:        ?EMBEDDED_BASE[0],
    fixed_count:  1,
};
