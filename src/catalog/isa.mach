# ISA strings of named extensions at versions
#
# an ISA string names an architecture as its base and register width, then
# its extensions joined by `_`, each a name followed by its major version, a
# `p` and its minor version, as RISC-V names one: `rv64i2p1_m2p0_zicsr2p0`.
# the first extension is the base integer set. a grammar row states the
# spelling and the canonical order of the extensions, so an architecture that
# names its extensions this way adds a row rather than code. two strings
# merge into every extension either names, at the higher of the versions both
# name, in canonical order, as lld merges Tag_RISCV_arch.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Table;

# a base a string may begin with: the prefix, the register width and the
# base integer set, and the architecture row it names, by the row's name
# ---
# spelling: the base as a string spells it, such as `rv32e`
# arch:     the name of the architecture row the base names
pub rec Base {
    spelling: str;
    arch:     str;
}

# prefix:     the text the string begins with, its register width following
# bases:      the bases a string may begin with, the first extension being the
#             base integer set
# base_count: how many
# single:     the single-letter extensions in canonical order. a letter it
#             does not list sorts after every listed one, alphabetically
# multi:      the letters a multi-letter extension begins with, in canonical
#             order
# ranked:     the leading letters whose extensions sort by the canonical rank
#             of their second letter before their name
pub rec Grammar {
    prefix:     str;
    bases:      *Base;
    base_count: usize;
    single:     str;
    multi:      str;
    ranked:     str;
}

# one extension of a string: its name, borrowed from the string, its version
# and its rank in canonical order, which orders before the name does
rec Ext {
    name:  Bytes;
    major: u64;
    minor: u64;
    rank:  u64;
}

# the place of `c` in `s`, none when `s` does not hold it
fun place(s: str, c: u8) opt[u64] {
    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] == c) { ret opt[u64].some{i::u64}; }
        i = i + 1;
    }
    ret opt[u64].none{};
}

fun lower(c: u8) bool {
    ret c >= 'a' && c <= 'z';
}

fun digit(c: u8) bool {
    ret c >= '0' && c <= '9';
}

# the canonical rank of the single-letter extension `c`
fun single_rank(g: *Grammar, c: u8) u64 {
    val p: opt[u64] = place(g.single, c);
    if (sel p.some) { ret p.some; }
    ret str_len(g.single)::u64 + (c - 'a')::u64;
}

# the rank of the extension named `n`, none for a name the grammar cannot spell
fun rank_of(g: *Grammar, n: Bytes) opt[u64] {
    var i: usize = 0;
    for (i < n.len) {
        if (!lower(n.data[i]) && !digit(n.data[i])) { ret opt[u64].none{}; }
        i = i + 1;
    }
    if (n.len == 1) {
        if (!lower(n.data[0])) { ret opt[u64].none{}; }
        ret opt[u64].some{single_rank(g, n.data[0])};
    }
    val p: opt[u64] = place(g.multi, n.data[0]);
    if (sel p.none)        { ret opt[u64].none{}; }
    if (!lower(n.data[1])) { ret opt[u64].none{}; }
    var rank: u64      = (p.some + 1) << 8;
    val r:    opt[u64] = place(g.ranked, n.data[0]);
    if (sel r.some) { rank = rank + single_rank(g, n.data[1]); }
    ret opt[u64].some{rank};
}

# the decimal number of the `n` digits at `p`, none when there are none or it
# is wider than a u64
fun number(p: *u8, n: usize) opt[u64] {
    if (n == 0) { ret opt[u64].none{}; }
    var v: u64   = 0;
    var i: usize = 0;
    for (i < n) {
        if (!digit(p[i])) { ret opt[u64].none{}; }
        val d: u64 = (p[i] - '0')::u64;
        if (v > (0xffff_ffff_ffff_ffff - d) / 10) { ret opt[u64].none{}; }
        v = v * 10 + d;
        i = i + 1;
    }
    ret opt[u64].some{v};
}

fun order_ext(a: *Ext, b: *Ext) i64 {
    if (a.rank < b.rank) { ret -1; }
    if (a.rank > b.rank) { ret 1; }
    var i: usize = 0;
    for (i < a.name.len && i < b.name.len) {
        if (a.name.data[i] < b.name.data[i]) { ret -1; }
        if (a.name.data[i] > b.name.data[i]) { ret 1; }
        i = i + 1;
    }
    if (a.name.len < b.name.len) { ret -1; }
    if (a.name.len > b.name.len) { ret 1; }
    ret 0;
}

fun malformed() Fail {
    ret fail.malformed("the ISA string is not one the grammar spells");
}

# the extension `c`, a name and its version
fun component(g: *Grammar, c: Bytes) res[Ext, Fail] {
    var p: usize = c.len;
    for (p > 0 && c.data[p - 1] != 'p') {
        p = p - 1;
    }
    if (p == 0) { ret res[Ext, Fail].err{malformed()}; }
    val minor: opt[u64] = number(?c.data[p], c.len - p);
    var m:     usize    = p - 1;
    for (m > 0 && digit(c.data[m - 1])) {
        m = m - 1;
    }
    val major: opt[u64] = number(?c.data[m], p - 1 - m);
    if (sel minor.none) { ret res[Ext, Fail].err{malformed()}; }
    if (sel major.none) { ret res[Ext, Fail].err{malformed()}; }
    if (m == 0)         { ret res[Ext, Fail].err{malformed()}; }
    val name: Bytes    = Bytes{data: c.data, len: m};
    val rank: opt[u64] = rank_of(g, name);
    if (sel rank.none) { ret res[Ext, Fail].err{malformed()}; }
    ret res[Ext, Fail].ok{Ext{name: name, major: major.some, minor: minor.some, rank: rank.some}};
}

# the register width of the string `s`, its extensions added to `out` in
# canonical order. a name the grammar cannot spell, a version that is missing,
# a first extension that is not a base and an extension named twice are refused
fun parse(g: *Grammar, s: Bytes, out: *Table[Ext]) res[Bytes, Fail] {
    val b: usize = str_len(g.prefix);
    if (s.len < b) { ret res[Bytes, Fail].err{malformed()}; }
    var i: usize = 0;
    for (i < b) {
        if (s.data[i] != g.prefix[i]) { ret res[Bytes, Fail].err{malformed()}; }
        i = i + 1;
    }
    for (i < s.len && digit(s.data[i])) {
        i = i + 1;
    }
    if (i == b) { ret res[Bytes, Fail].err{malformed()}; }
    val width: Bytes = Bytes{data: ?s.data[b], len: i - b};
    var start: usize = i;
    for (start <= s.len) {
        var end: usize = start;
        for (end < s.len && s.data[end] != '_') {
            end = end + 1;
        }
        val e: res[Ext, Fail] = component(g, Bytes{data: ?s.data[start], len: end - start});
        if (sel e.err) { ret res[Bytes, Fail].err{e.err}; }
        if (table.count[Ext](out) == 0) {
            val base: opt[*Base] = spelled(g, Bytes{data: s.data, len: start + 1});
            if (e.ok.name.len != 1 || sel base.none) { ret res[Bytes, Fail].err{malformed()}; }
        }
        val pushed: res[table.Id[Ext], Fail] = table.push[Ext](out, e.ok);
        if (sel pushed.err) { ret res[Bytes, Fail].err{pushed.err}; }
        start = end + 1;
    }
    val n: usize = table.count[Ext](out);
    sort.sort_by[Ext](table.items[Ext](out), n, order_ext);
    i = 1;
    for (i < n) {
        if (order_ext(?table.items[Ext](out)[i - 1], ?table.items[Ext](out)[i]) == 0) { ret res[Bytes, Fail].err{malformed()}; }
        i = i + 1;
    }
    ret res[Bytes, Fail].ok{width};
}

# the base spelled exactly `b`, none when the grammar spells no such base
fun spelled(g: *Grammar, b: Bytes) opt[*Base] {
    var i: usize = 0;
    for (i < g.base_count) {
        val k: *Base = ?g.bases[i];
        if (store.same_bytes(Bytes{data: k.spelling::*u8, len: str_len(k.spelling)}, b)) { ret opt[*Base].some{k}; }
        i = i + 1;
    }
    ret opt[*Base].none{};
}

# the base the string `s` begins with: the prefix, the register width and the
# single letter of the base integer set. none when it begins with no base the
# grammar spells
pub fun base_of(g: *Grammar, s: Bytes) opt[*Base] {
    val b: usize = str_len(g.prefix);
    var i: usize = 0;
    for (i < b) {
        if (i >= s.len || s.data[i] != g.prefix[i]) { ret opt[*Base].none{}; }
        i = i + 1;
    }
    for (i < s.len && digit(s.data[i])) {
        i = i + 1;
    }
    if (i == b || i >= s.len) { ret opt[*Base].none{}; }
    ret spelled(g, Bytes{data: s.data, len: i + 1});
}

# the base of `g` that names the architecture row named `arch`, none when no
# base does
pub fun base_for(g: *Grammar, arch: str) opt[*Base] {
    var i: usize = 0;
    for (i < g.base_count) {
        if (str_equals(g.bases[i].arch, arch)) { ret opt[*Base].some{?g.bases[i]}; }
        i = i + 1;
    }
    ret opt[*Base].none{};
}

fun put(out: *Table[u8], p: *u8, n: usize) err[Fail] {
    val r: res[table.Id[u8], Fail] = table.extend[u8](out, p, n);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

fun put_number(out: *Table[u8], v: u64) err[Fail] {
    var digits: [20]u8;
    var n:      usize = 0;
    var rest:   u64   = v;
    for {
        digits[19 - n] = '0' + (rest % 10)::u8;
        n              = n + 1;
        rest           = rest / 10;
        if (rest == 0) { brk; }
    }
    ret put(out, ?digits[20 - n], n);
}

fun put_ext(out: *Table[u8], e: *Ext, first: bool) err[Fail] {
    val sep: [1]u8 = [1]u8{'_'};
    val p:   [1]u8 = [1]u8{'p'};
    if (!first) {
        val s: err[Fail] = put(out, ?sep[0], 1);
        if (sel s.err) { ret s; }
    }
    val n: err[Fail] = put(out, e.name.data, e.name.len);
    if (sel n.err) { ret n; }
    val ma: err[Fail] = put_number(out, e.major);
    if (sel ma.err) { ret ma; }
    val q: err[Fail] = put(out, ?p[0], 1);
    if (sel q.err) { ret q; }
    ret put_number(out, e.minor);
}

fun later(a: *Ext, b: *Ext) bool {
    if (a.major != b.major) { ret a.major > b.major; }
    ret a.minor > b.minor;
}

# the strings `x` and `y` merged under `g` and appended to `out`: every
# extension either names, at the higher of the versions both name, in
# canonical order. false, with nothing appended, when their register widths
# differ. a string the grammar does not spell is refused as malformed
pub fun merge(a: *A.Allocator, g: *Grammar, x: Bytes, y: Bytes, out: *Table[u8]) res[bool, Fail] {
    var xs: Table[Ext]      = table.make[Ext](a);
    var ys: Table[Ext]      = table.make[Ext](a);
    val r:  res[bool, Fail] = merged(g, x, y, ?xs, ?ys, out);
    val rx: err[Fail]       = table.release[Ext](?xs);
    val ry: err[Fail]       = table.release[Ext](?ys);
    if (sel r.err)  { ret r; }
    if (sel rx.err) { ret res[bool, Fail].err{rx.err}; }
    if (sel ry.err) { ret res[bool, Fail].err{ry.err}; }
    ret r;
}

fun merged(g: *Grammar, x: Bytes, y: Bytes, xs: *Table[Ext], ys: *Table[Ext], out: *Table[u8]) res[bool, Fail] {
    val wx: res[Bytes, Fail] = parse(g, x, xs);
    if (sel wx.err) { ret res[bool, Fail].err{wx.err}; }
    val wy: res[Bytes, Fail] = parse(g, y, ys);
    if (sel wy.err)                      { ret res[bool, Fail].err{wy.err}; }
    if (!store.same_bytes(wx.ok, wy.ok)) { ret res[bool, Fail].ok{false}; }
    val mark: usize     = table.count[u8](out);
    val r:    err[Fail] = written(g, wx.ok, xs, ys, out);
    if (sel r.err) {
        table.truncate[u8](out, mark);
        ret res[bool, Fail].err{r.err};
    }
    ret res[bool, Fail].ok{true};
}

fun written(g: *Grammar, width: Bytes, xs: *Table[Ext], ys: *Table[Ext], out: *Table[u8]) err[Fail] {
    val b: err[Fail] = put(out, g.prefix, str_len(g.prefix));
    if (sel b.err) { ret b; }
    val w: err[Fail] = put(out, width.data, width.len);
    if (sel w.err) { ret w; }
    val nx:    usize = table.count[Ext](xs);
    val ny:    usize = table.count[Ext](ys);
    var i:     usize = 0;
    var j:     usize = 0;
    var first: bool  = true;
    for (i < nx || j < ny) {
        var e: *Ext = nil;
        if (j == ny) {
            e = table.at[Ext](xs, table.nth[Ext](i));
            i = i + 1;
        }
        or (i == nx) {
            e = table.at[Ext](ys, table.nth[Ext](j));
            j = j + 1;
        }
        or {
            val ex: *Ext = table.at[Ext](xs, table.nth[Ext](i));
            val ey: *Ext = table.at[Ext](ys, table.nth[Ext](j));
            val c:  i64  = order_ext(ex, ey);
            if (c < 0) {
                e = ex;
                i = i + 1;
            }
            or (c > 0) {
                e = ey;
                j = j + 1;
            }
            or {
                e = ex;
                if (later(ey, ex)) { e = ey; }
                i = i + 1;
                j = j + 1;
            }
        }
        val r: err[Fail] = put_ext(out, e, first);
        if (sel r.err) { ret r; }
        first = false;
    }
    ret err[Fail].ok{};
}
