# ISA strings of named extensions, at versions where they are written
#
# an ISA string names an architecture as its base and register width, then its
# extensions, as RISC-V names one: `rv64i2p1_m2p0_zicsr2p0`, or `rv64imac`
# with no versions. the first extension is the base integer set, or a
# shorthand standing for it with others, as `g` does. single-letter
# extensions run together or are joined by `_`, a multi-letter one is
# preceded by `_`, and each may carry its major version, a `p` and its minor
# version. a grammar row states the spelling
# and the canonical order of the extensions, so an architecture that names its
# extensions this way adds a row rather than code. two strings merge into
# every extension either names, at the higher of the versions both name, in
# canonical order, so the image's string names every extension any of its code
# needs.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

# a base a string may begin with: the prefix, the register width and the
# base integer set, and the architecture row it names, by the row's name
# ---
# spelling: the base as a string spells it, such as `rv32e`
# arch:     the name of the architecture row the base names
pub rec Base {
    spelling: str;
    arch:     str;
}

# prefix:          the text the string begins with, its register width following
# bases:           the bases a string may begin with, the first extension being the
#                  base integer set
# base_count:      how many
# single:          the single-letter extensions in canonical order. a letter it
#                  does not list sorts after every listed one, alphabetically
# multi:           the letters a multi-letter extension begins with, in canonical
#                  order
# ranked:          the leading letters whose extensions sort by the canonical rank
#                  of their second letter before their name
# shorthands:      the letters that stand for several extensions
# shorthand_count: how many
pub rec Grammar {
    prefix:          str;
    bases:           *Base;
    base_count:      usize;
    single:          str;
    multi:           str;
    ranked:          str;
    shorthands:      *Shorthand;
    shorthand_count: usize;
}

# a letter a string may name in place of the extensions it stands for, as
# RISC-V's g stands for imafd, zicsr and zifencei
# ---
# name:  the letter
# names: the extensions it stands for, the base integer set first
# count: how many
pub rec Shorthand {
    name:  u8;
    names: *str;
    count: usize;
}

# one extension of a string: its name, borrowed from the string, its version
# where the string writes one, and its rank in canonical order, which orders
# before the name does
rec Ext {
    name:      Bytes;
    major:     u64;
    minor:     u64;
    versioned: bool;
    rank:      u64;
}

# the place of `c` in `s`, none when `s` does not hold it
fun place(s: str, c: u8) opt[u64] {
    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] == c) { ret opt[u64].some{i::u64}; }
        i = i + 1;
    }
    ret opt[u64].none{};
}

fun lower(c: u8) bool {
    ret c >= 'a' && c <= 'z';
}

fun digit(c: u8) bool {
    ret c >= '0' && c <= '9';
}

# the canonical rank of the single-letter extension `c`
fun single_rank(g: *Grammar, c: u8) u64 {
    val p: opt[u64] = place(g.single, c);
    if (sel p.some) { ret p.some; }
    ret str_len(g.single)::u64 + (c - 'a')::u64;
}

# the rank of the extension named `n`, none for a name the grammar cannot spell
fun rank_of(g: *Grammar, n: Bytes) opt[u64] {
    var i: usize = 0;
    for (i < n.len) {
        if (!lower(n.data[i]) && !digit(n.data[i])) { ret opt[u64].none{}; }
        i = i + 1;
    }
    if (n.len == 1) {
        if (!lower(n.data[0])) { ret opt[u64].none{}; }
        ret opt[u64].some{single_rank(g, n.data[0])};
    }
    val p: opt[u64] = place(g.multi, n.data[0]);
    if (sel p.none)        { ret opt[u64].none{}; }
    if (!lower(n.data[1])) { ret opt[u64].none{}; }
    var rank: u64      = (p.some + 1) << 8;
    val r:    opt[u64] = place(g.ranked, n.data[0]);
    if (sel r.some) { rank = rank + single_rank(g, n.data[1]); }
    ret opt[u64].some{rank};
}

# the decimal number of the `n` digits at `p`, none when there are none or it
# is wider than a u64
fun number(p: *u8, n: usize) opt[u64] {
    if (n == 0) { ret opt[u64].none{}; }
    var v: u64   = 0;
    var i: usize = 0;
    for (i < n) {
        if (!digit(p[i])) { ret opt[u64].none{}; }
        val d: u64 = (p[i] - '0')::u64;
        if (v > (0xffff_ffff_ffff_ffff - d) / 10) { ret opt[u64].none{}; }
        v = v * 10 + d;
        i = i + 1;
    }
    ret opt[u64].some{v};
}

fun order_ext(a: *Ext, b: *Ext) i64 {
    if (a.rank < b.rank) { ret -1; }
    if (a.rank > b.rank) { ret 1; }
    var i: usize = 0;
    for (i < a.name.len && i < b.name.len) {
        if (a.name.data[i] < b.name.data[i]) { ret -1; }
        if (a.name.data[i] > b.name.data[i]) { ret 1; }
        i = i + 1;
    }
    if (a.name.len < b.name.len) { ret -1; }
    if (a.name.len > b.name.len) { ret 1; }
    ret 0;
}

fun malformed() Fail {
    ret fail.malformed("the ISA string is not one the grammar spells");
}

# the version written at `at` of `s` into `e`, `at` left past it: a major,
# a `p` and a minor. none is written where no digit stands, and a major with
# no minor is refused
fun version(s: Bytes, at: *usize, e: *Ext) err[Fail] {
    if (@at >= s.len || !digit(s.data[@at])) { ret err[Fail].ok{}; }
    val first: usize = @at;
    for (@at < s.len && digit(s.data[@at])) {
        @at = @at + 1;
    }
    val major: opt[u64] = number(?s.data[first], @at - first);
    if (@at >= s.len || s.data[@at] != 'p') { ret err[Fail].err{malformed()}; }
    @at = @at + 1;
    val second: usize = @at;
    for (@at < s.len && digit(s.data[@at])) {
        @at = @at + 1;
    }
    val minor: opt[u64] = number(?s.data[second], @at - second);
    if (sel major.none) { ret err[Fail].err{malformed()}; }
    if (sel minor.none) { ret err[Fail].err{malformed()}; }
    e.major     = major.some;
    e.minor     = minor.some;
    e.versioned = true;
    ret err[Fail].ok{};
}

# the multi-letter extension `c`, a name and the version it ends in where it
# writes one
fun multi_ext(g: *Grammar, c: Bytes) res[Ext, Fail] {
    var e:    Ext;
    var name: usize = c.len;
    if (c.len > 0 && digit(c.data[c.len - 1])) {
        var p: usize = c.len;
        for (p > 0 && c.data[p - 1] != 'p') {
            p = p - 1;
        }
        if (p == 0) { ret res[Ext, Fail].err{malformed()}; }
        var m: usize = p - 1;
        for (m > 0 && digit(c.data[m - 1])) {
            m = m - 1;
        }
        var at: usize     = m;
        val v:  err[Fail] = version(c, ?at, ?e);
        if (sel v.err)   { ret res[Ext, Fail].err{v.err}; }
        if (at != c.len) { ret res[Ext, Fail].err{malformed()}; }
        name = m;
    }
    if (name < 2) { ret res[Ext, Fail].err{malformed()}; }
    e.name = Bytes{data: c.data, len: name};
    val rank: opt[u64] = rank_of(g, e.name);
    if (sel rank.none) { ret res[Ext, Fail].err{malformed()}; }
    e.rank = rank.some;
    ret res[Ext, Fail].ok{e};
}

# where the first extension of `s` begins, past the prefix and the register
# width, refused when `s` does not begin with them
fun width_end(g: *Grammar, s: Bytes) res[usize, Fail] {
    val b: usize = str_len(g.prefix);
    if (s.len < b) { ret res[usize, Fail].err{malformed()}; }
    var i: usize = 0;
    for (i < b) {
        if (s.data[i] != g.prefix[i]) { ret res[usize, Fail].err{malformed()}; }
        i = i + 1;
    }
    for (i < s.len && digit(s.data[i])) {
        i = i + 1;
    }
    if (i == b) { ret res[usize, Fail].err{malformed()}; }
    ret res[usize, Fail].ok{i};
}

# the shorthand `c` names, none when it names none
fun shorthand(g: *Grammar, c: u8) opt[*Shorthand] {
    var i: usize = 0;
    for (i < g.shorthand_count) {
        if (g.shorthands[i].name == c) { ret opt[*Shorthand].some{?g.shorthands[i]}; }
        i = i + 1;
    }
    ret opt[*Shorthand].none{};
}

# whether shorthand `h` stands for the extension `n`
fun stands_for(h: *Shorthand, n: Bytes) bool {
    var i: usize = 0;
    for (i < h.count) {
        if (store.same_bytes(Bytes{data: h.names[i]::*u8, len: str_len(h.names[i])}, n)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the base spelled exactly `head` followed by `tail`, none when the grammar
# spells no such base
fun spelled_with(g: *Grammar, head: Bytes, tail: str) opt[*Base] {
    val n: usize = str_len(tail);
    var i: usize = 0;
    for (i < g.base_count) {
        val k: *Base = ?g.bases[i];
        i = i + 1;
        if (str_len(k.spelling) != head.len + n) { cnt; }
        var same: bool  = true;
        var j:    usize = 0;
        for (j < head.len + n && same) {
            var c: u8 = 0;
            if (j < head.len) { c = head.data[j]; }
            or                { c = tail[j - head.len]; }
            same = k.spelling[j] == c;
            j    = j + 1;
        }
        if (same) { ret opt[*Base].some{k}; }
    }
    ret opt[*Base].none{};
}

# the base the letter at `end` of `s` names after its prefix and register
# width: the base spelled with the letter, or with the first extension of
# the shorthand it is
fun base_at(g: *Grammar, s: Bytes, end: usize) opt[*Base] {
    val head: Bytes      = Bytes{data: s.data, len: end};
    val c:    [2]u8      = [2]u8{s.data[end], 0};
    val own:  opt[*Base] = spelled_with(g, head, (?c[0])::str);
    if (sel own.some) { ret own; }
    val h: opt[*Shorthand] = shorthand(g, s.data[end]);
    if (sel h.none) { ret opt[*Base].none{}; }
    val stands: *Shorthand = h.some;
    if (stands.count == 0) { ret opt[*Base].none{}; }
    ret spelled_with(g, head, stands.names[0]);
}

# a walk over the extensions of a string, the base integer set first
# ---
# s:      the string
# width:  its register width, borrowed from it
# at:     where the next extension begins
# single: the walk is within a run of single-letter extensions
rec Scan {
    s:      Bytes;
    width:  Bytes;
    at:     usize;
    single: bool;
}

# a walk over `s`, refused when it does not begin with the prefix, a register
# width and a base the grammar spells or a shorthand standing for one
fun scan(g: *Grammar, s: Bytes) res[Scan, Fail] {
    val w: res[usize, Fail] = width_end(g, s);
    if (sel w.err)     { ret res[Scan, Fail].err{w.err}; }
    if (w.ok >= s.len) { ret res[Scan, Fail].err{malformed()}; }
    val base: opt[*Base] = base_at(g, s, w.ok);
    if (sel base.none) { ret res[Scan, Fail].err{malformed()}; }
    val b: usize = str_len(g.prefix);
    ret res[Scan, Fail].ok{Scan{s: s, width: Bytes{data: ?s.data[b], len: w.ok - b}, at: w.ok, single: true}};
}

# the next extension of the walk, none past the last. a name the grammar
# cannot spell, a multi-letter one not preceded by `_`, an empty one and a
# version with no minor are refused
fun next(g: *Grammar, sc: *Scan) res[opt[Ext], Fail] {
    val s: Bytes = sc.s;
    if (sc.at >= s.len) { ret res[opt[Ext], Fail].ok{opt[Ext].none{}}; }
    val c:     u8       = s.data[sc.at];
    val multi: opt[u64] = place(g.multi, c);
    var e:     Ext;
    if (!sc.single && sel multi.some) {
        var end: usize = sc.at;
        for (end < s.len && s.data[end] != '_') {
            end = end + 1;
        }
        val made: res[Ext, Fail] = multi_ext(g, Bytes{data: ?s.data[sc.at], len: end - sc.at});
        if (sel made.err) { ret res[opt[Ext], Fail].err{made.err}; }
        e     = made.ok;
        sc.at = end;
    }
    or {
        if (!lower(c) || sel multi.some) { ret res[opt[Ext], Fail].err{malformed()}; }
        e.name = Bytes{data: ?s.data[sc.at], len: 1};
        sc.at  = sc.at + 1;
        val v: err[Fail] = version(s, ?sc.at, ?e);
        if (sel v.err) { ret res[opt[Ext], Fail].err{v.err}; }
        val rank: opt[u64] = rank_of(g, e.name);
        if (sel rank.none) { ret res[opt[Ext], Fail].err{malformed()}; }
        e.rank    = rank.some;
        sc.single = true;
    }
    if (sc.at < s.len && s.data[sc.at] == '_') {
        sc.at     = sc.at + 1;
        sc.single = false;
        if (sc.at == s.len) { ret res[opt[Ext], Fail].err{malformed()}; }
    }
    ret res[opt[Ext], Fail].ok{opt[Ext].some{e}};
}

# the register width of the string `s`, its extensions added to `out` in
# canonical order. a string the walk refuses and an extension named twice
# are refused
fun parse(g: *Grammar, s: Bytes, out: *Table[Ext]) res[Bytes, Fail] {
    val opened: res[Scan, Fail] = scan(g, s);
    if (sel opened.err) { ret res[Bytes, Fail].err{opened.err}; }
    var sc: Scan = opened.ok;
    for {
        val n: res[opt[Ext], Fail] = next(g, ?sc);
        if (sel n.err)     { ret res[Bytes, Fail].err{n.err}; }
        if (sel n.ok.none) { brk; }
        val pushed: res[table.Id[Ext], Fail] = table.push[Ext](out, n.ok.some);
        if (sel pushed.err) { ret res[Bytes, Fail].err{pushed.err}; }
    }
    val count: usize = table.count[Ext](out);
    sort.sort_by[Ext](table.items[Ext](out), count, order_ext);
    var i: usize = 1;
    for (i < count) {
        if (order_ext(?table.items[Ext](out)[i - 1], ?table.items[Ext](out)[i]) == 0) { ret res[Bytes, Fail].err{malformed()}; }
        i = i + 1;
    }
    ret res[Bytes, Fail].ok{sc.width};
}

# whether the string `s` names the extension `name`, the base integer set
# among them, itself or through a shorthand that stands for it. a string the
# walk refuses is refused as malformed
pub fun names(g: *Grammar, s: Bytes, name: str) res[bool, Fail] {
    val opened: res[Scan, Fail] = scan(g, s);
    if (sel opened.err) { ret res[bool, Fail].err{opened.err}; }
    var sc:    Scan  = opened.ok;
    val n:     Bytes = Bytes{data: name::*u8, len: str_len(name)};
    var found: bool  = false;
    for {
        val x: res[opt[Ext], Fail] = next(g, ?sc);
        if (sel x.err)     { ret res[bool, Fail].err{x.err}; }
        if (sel x.ok.none) { brk; }
        val e: Ext = x.ok.some;
        if (store.same_bytes(e.name, n)) { found = true; }
        if (e.name.len == 1) {
            val h: opt[*Shorthand] = shorthand(g, e.name.data[0]);
            if (sel h.some && stands_for(h.some, n)) { found = true; }
        }
    }
    ret res[bool, Fail].ok{found};
}

# the base the string `s` begins with: the prefix, the register width and the
# single letter of the base integer set or of a shorthand standing for it.
# none when it begins with no base the grammar spells
pub fun base_of(g: *Grammar, s: Bytes) opt[*Base] {
    val w: res[usize, Fail] = width_end(g, s);
    if (sel w.err)     { ret opt[*Base].none{}; }
    if (w.ok >= s.len) { ret opt[*Base].none{}; }
    ret base_at(g, s, w.ok);
}

# the base of `g` that names the architecture row named `arch`, none when no
# base does
pub fun base_for(g: *Grammar, arch: str) opt[*Base] {
    var i: usize = 0;
    for (i < g.base_count) {
        if (str_equals(g.bases[i].arch, arch)) { ret opt[*Base].some{?g.bases[i]}; }
        i = i + 1;
    }
    ret opt[*Base].none{};
}

fun put(out: *Sink, p: *u8, n: usize) err[Fail] {
    ret sink.bytes(out, p, n);
}

fun put_number(out: *Sink, v: u64) err[Fail] {
    ret sink.number(out, v, 10);
}

fun put_ext(out: *Sink, e: *Ext, first: bool) err[Fail] {
    val sep: [1]u8 = [1]u8{'_'};
    val p:   [1]u8 = [1]u8{'p'};
    if (!first) {
        val s: err[Fail] = put(out, ?sep[0], 1);
        if (sel s.err) { ret s; }
    }
    val n: err[Fail] = put(out, e.name.data, e.name.len);
    if (sel n.err)    { ret n; }
    if (!e.versioned) { ret err[Fail].ok{}; }
    val ma: err[Fail] = put_number(out, e.major);
    if (sel ma.err) { ret ma; }
    val q: err[Fail] = put(out, ?p[0], 1);
    if (sel q.err) { ret q; }
    ret put_number(out, e.minor);
}

fun later(a: *Ext, b: *Ext) bool {
    if (a.versioned != b.versioned) { ret a.versioned; }
    if (a.major != b.major)         { ret a.major > b.major; }
    ret a.minor > b.minor;
}

# the strings `x` and `y` merged under `g` and appended to `out`: every
# extension either names, at the higher of the versions both name, in
# canonical order. false, with nothing appended, when their register widths
# differ. a string the grammar does not spell is refused as malformed
pub fun merge(a: *A.Allocator, g: *Grammar, x: Bytes, y: Bytes, out: *Sink) res[bool, Fail] {
    var xs: Table[Ext]      = table.make[Ext](a);
    var ys: Table[Ext]      = table.make[Ext](a);
    val r:  res[bool, Fail] = merged(g, x, y, ?xs, ?ys, out);
    val rx: err[Fail]       = table.release[Ext](?xs);
    val ry: err[Fail]       = table.release[Ext](?ys);
    if (sel r.err)  { ret r; }
    if (sel rx.err) { ret res[bool, Fail].err{rx.err}; }
    if (sel ry.err) { ret res[bool, Fail].err{ry.err}; }
    ret r;
}

fun merged(g: *Grammar, x: Bytes, y: Bytes, xs: *Table[Ext], ys: *Table[Ext], out: *Sink) res[bool, Fail] {
    val wx: res[Bytes, Fail] = parse(g, x, xs);
    if (sel wx.err) { ret res[bool, Fail].err{wx.err}; }
    val wy: res[Bytes, Fail] = parse(g, y, ys);
    if (sel wy.err)                      { ret res[bool, Fail].err{wy.err}; }
    if (!store.same_bytes(wx.ok, wy.ok)) { ret res[bool, Fail].ok{false}; }
    val mark: usize     = sink.len(out);
    val r:    err[Fail] = written(g, wx.ok, xs, ys, out);
    if (sel r.err) {
        sink.truncate(out, mark);
        ret res[bool, Fail].err{r.err};
    }
    ret res[bool, Fail].ok{true};
}

fun written(g: *Grammar, width: Bytes, xs: *Table[Ext], ys: *Table[Ext], out: *Sink) err[Fail] {
    val b: err[Fail] = put(out, g.prefix, str_len(g.prefix));
    if (sel b.err) { ret b; }
    val w: err[Fail] = put(out, width.data, width.len);
    if (sel w.err) { ret w; }
    val nx:    usize = table.count[Ext](xs);
    val ny:    usize = table.count[Ext](ys);
    var i:     usize = 0;
    var j:     usize = 0;
    var first: bool  = true;
    for (i < nx || j < ny) {
        var e: *Ext = nil;
        if (j == ny) {
            e = table.at[Ext](xs, table.nth[Ext](i));
            i = i + 1;
        }
        or (i == nx) {
            e = table.at[Ext](ys, table.nth[Ext](j));
            j = j + 1;
        }
        or {
            val ex: *Ext = table.at[Ext](xs, table.nth[Ext](i));
            val ey: *Ext = table.at[Ext](ys, table.nth[Ext](j));
            val c:  i64  = order_ext(ex, ey);
            if (c < 0) {
                e = ex;
                i = i + 1;
            }
            or (c > 0) {
                e = ey;
                j = j + 1;
            }
            or {
                e = ex;
                if (later(ey, ex)) { e = ey; }
                i = i + 1;
                j = j + 1;
            }
        }
        val r: err[Fail] = put_ext(out, e, first);
        if (sel r.err) { ret r; }
        first = false;
    }
    ret err[Fail].ok{};
}
