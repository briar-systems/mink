# the architecture catalog
#
# one row per architecture, and the only place mink names one. formats and
# the linker read a row through its codes and capabilities and never compare
# an architecture against a constant. a new architecture is a new row in its
# family's file under arch, its ABI traits are trait rows of its family, and
# arch/list enumerates the rows.
#
# two machines are separate rows when a format codes them differently and a
# default link refuses to mix them, as riscv32 and riscv32e are.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mink.bytes.reader.Order;
use mink.catalog.format.Format;
use mink.catalog.isa.Grammar;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Trait;

pub def Caps: u64;

# sections are placed at addresses in an image or a linear memory
pub val ADDRESSED: Caps = 1;
# symbols resolve to entries of typed index spaces, as wasm functions and
# SPIR-V ids do
pub val INDEXED: Caps = 2;

# the fields each format codes an architecture by, the keys of an ident. the
# first field of a format is its primary one, which every code of the format
# states exactly
pub val ELF_MACHINE: u8 = 0;
pub val ELF_CLASS:   u8 = 1;
pub val ELF_DATA:    u8 = 2;
pub val ELF_FLAGS:   u8 = 3;

pub val COFF_MACHINE: u8 = 0;

pub val MACHO_CPU:     u8 = 0;
pub val MACHO_SUBTYPE: u8 = 1;

pub val WASM_INDEX: u8 = 0;

pub val SPIRV_MAGIC: u8 = 0;

# the most fields a format codes an architecture by
pub val FIELD_COUNT: usize = 4;

# ELF EI_CLASS and EI_DATA
pub val CLASS32: u64 = 1;
pub val CLASS64: u64 = 2;
pub val LSB:     u64 = 1;
pub val MSB:     u64 = 2;

# the mask of a field compared whole
pub val EXACT: u64 = 0xffff_ffff_ffff_ffff;

# one field of a code: the field `key` holds `value` under `mask`
pub rec Ident {
    key:   u8;
    value: u64;
    mask:  u64;
}

# how a row names itself in one format: the fields of the format that tell it
# from every other row, the primary field first
# ---
# format: the format
# fields: the fields, static
# count:  how many
pub rec Code {
    format: *Format;
    fields: *Ident;
    count:  usize;
}

# what an input states in the fields a format codes an architecture by,
# indexed by the field keys
# ---
# format: the format whose fields they are
# values: each field's value, by key
# count:  how many fields the format codes by
pub rec Stated {
    format: *Format;
    values: [FIELD_COUNT]u64;
    count:  usize;
}

# the width of an address of the default address space
pub rec Pointer {
    bytes: u8;
}

# the page granules of an architecture: the base page and the largest page an
# image may be aligned to
pub rec Pages {
    size: u64;
    max:  u64;
}

# the DWARF register numbers a frame names. the alignment factors are the
# frame's own
# ---
# sp: the register number of the stack pointer
# ra: the return address column
pub rec Unwind {
    sp: u16;
    ra: u16;
}

# a psABI ABI name and the trait settings it implies, on the one row it
# applies to
# ---
# name:     the ABI's spelling, such as `lp64d`
# arch:     the architecture row it applies to
# settings: the traits it implies, static
# count:    how many
pub rec Abi {
    name:     str;
    arch:     *Arch;
    settings: *Trait;
    count:    usize;
}

# the architectures that share an instruction set, its trait axes and its ABI
# names
# ---
# name:       the family's spelling
# axes:       the trait axes an object for a row of the family may state
# axis_count: how many
# grammar:    the ISA string grammar of the family, none where it has none
# abis:       the psABI ABI names of the family's rows
# abi_count:  how many
pub rec Family {
    name:       str;
    axes:       **Axis;
    axis_count: usize;
    grammar:    opt[*Grammar];
    abis:       *Abi;
    abi_count:  usize;
}

# name:         the architecture's spelling
# family:       the family it belongs to
# code:         how each format that names it does so
# code_count:   how many codes
# pointer:      the width of an address, none where addressing is not the
#               architecture's but its host's
# address_unit: the bytes one address step covers
# order:        byte order of multi-byte data
# pages:        the page granules, none where there are no pages
# spaces:       how many address spaces it has
# unwind:       the frame registers, none where DWARF frames do not apply
# caps:         the capabilities the architecture declares
# axes:         the trait axes an object for it may state
# axis_count:   how many
pub rec Arch {
    name:         str;
    family:       *Family;
    code:         *Code;
    code_count:   usize;
    pointer:      opt[Pointer];
    address_unit: u8;
    order:        Order;
    pages:        opt[Pages];
    spaces:       u8;
    unwind:       opt[Unwind];
    caps:         Caps;
    axes:         **Axis;
    axis_count:   usize;
}

# how `f` names `a`, none when it does not
pub fun code(a: *Arch, f: *Format) opt[*Code] {
    var k: usize = 0;
    for (k < a.code_count) {
        if (a.code[k].format == f) { ret opt[*Code].some{?a.code[k]}; }
        k = k + 1;
    }
    ret opt[*Code].none{};
}

# the field `key` of `c`, none when the code does not state it
pub fun field(c: *Code, key: u8) opt[*Ident] {
    var k: usize = 0;
    for (k < c.count) {
        if (c.fields[k].key == key) { ret opt[*Ident].some{?c.fields[k]}; }
        k = k + 1;
    }
    ret opt[*Ident].none{};
}

# whether what `s` states is what `c` names: the same format, and every field
# of the code holding its value under its mask
pub fun matches(c: *Code, s: *Stated) bool {
    if (c.format != s.format) { ret false; }
    var k: usize = 0;
    for (k < c.count) {
        val i: *Ident = ?c.fields[k];
        if (i.key::usize >= s.count)                      { ret false; }
        if ((s.values[i.key::usize] & i.mask) != i.value) { ret false; }
        k = k + 1;
    }
    ret true;
}

pub fun has(a: *Arch, c: Caps) bool {
    ret (a.caps & c) == c;
}

# whether an object for `a` may state the trait axis `x`
pub fun has_axis(a: *Arch, x: *Axis) bool {
    var i: usize = 0;
    for (i < a.axis_count) {
        if (a.axes[i] == x) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the width of an address of `a`, none where the architecture has none
pub fun pointer_bytes(a: *Arch) opt[u8] {
    if (sel a.pointer.some) { ret opt[u8].some{a.pointer.some.bytes}; }
    ret opt[u8].none{};
}

# the ABI of `a`'s family named `name`, none when the family has no such ABI
# for `a`
pub fun abi(a: *Arch, name: str) opt[*Abi] {
    val f: *Family = a.family;
    var i: usize   = 0;
    for (i < f.abi_count) {
        val b: *Abi = ?f.abis[i];
        if (b.arch == a && str_equals(b.name, name)) { ret opt[*Abi].some{b}; }
        i = i + 1;
    }
    ret opt[*Abi].none{};
}
