# the architecture catalog
#
# one row per architecture, and the only place mink names one. formats and
# the linker read a row through its codes and capabilities and never compare
# an architecture against a constant. a new architecture is a new row in its
# family's file under arch, its ABI traits are trait rows beside it that the
# row lists, and arch/list enumerates the rows.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.bytes.reader.Order;
use mink.catalog.format.Code;
use mink.catalog.format.Format;
use mink.catalog.trait.Axis;

pub def Caps: u64;

# sections are placed at addresses in an image or a linear memory
pub val ADDRESSED: Caps = 1;
# symbols resolve to entries of typed index spaces, as wasm functions and
# SPIR-V ids do
pub val INDEXED: Caps = 2;

# the DWARF call frame facts a linker reads
# ---
# sp:         the register number of the stack pointer
# ra:         the return address column
# code_align: the code alignment factor
# data_align: the data alignment factor
pub rec Unwind {
    sp:         u16;
    ra:         u16;
    code_align: u8;
    data_align: i8;
}

# name:          the architecture's spelling
# codes:         how each format that names it does so
# code_count:    how many codes
# pointer_bytes: the width of an address
# order:         byte order of multi-byte data
# page_size:     the base page granule, zero where there are no pages
# unwind:        the call frame facts, none where DWARF frames do not apply
# caps:          the capabilities the architecture declares
# axes:          the trait axes an object for it may state
# axis_count:    how many
pub rec Arch {
    name:          str;
    codes:         *Code;
    code_count:    usize;
    pointer_bytes: u8;
    order:         Order;
    page_size:     u64;
    unwind:        opt[Unwind];
    caps:          Caps;
    axes:          **Axis;
    axis_count:    usize;
}

# ELF EI_CLASS
pub val CLASS32: u32 = 1;
pub val CLASS64: u32 = 2;

# how `f` names `a`, none when it does not
pub fun code(a: *Arch, f: *Format) opt[Code] {
    var k: usize = 0;
    for (k < a.code_count) {
        if (a.codes[k].format == f) { ret opt[Code].some{a.codes[k]}; }
        k = k + 1;
    }
    ret opt[Code].none{};
}

pub fun has(a: *Arch, c: Caps) bool {
    ret (a.caps & c) == c;
}

# whether an object for `a` may state the trait axis `x`
pub fun has_axis(a: *Arch, x: *Axis) bool {
    var i: usize = 0;
    for (i < a.axis_count) {
        if (a.axes[i] == x) { ret true; }
        i = i + 1;
    }
    ret false;
}
