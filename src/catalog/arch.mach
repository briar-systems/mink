val X86_AXES: [34]*Axis = [34]*Axis{?X86_IBT, ?X86_SHSTK, ?X86_ISA_NEEDED_BASELINE, ?X86_ISA_NEEDED_V2, ?X86_ISA_NEEDED_V3, ?X86_ISA_NEEDED_V4, ?X86_ISA_USED_BASELINE, ?X86_ISA_USED_V2, ?X86_ISA_USED_V3, ?X86_ISA_USED_V4, ?X86_FEATURE_NEEDED_X86, ?X86_FEATURE_NEEDED_X87, ?X86_FEATURE_NEEDED_MMX, ?X86_FEATURE_NEEDED_XMM, ?X86_FEATURE_NEEDED_YMM, ?X86_FEATURE_NEEDED_ZMM, ?X86_FEATURE_NEEDED_FXSR, ?X86_FEATURE_NEEDED_XSAVE, ?X86_FEATURE_NEEDED_XSAVEOPT, ?X86_FEATURE_NEEDED_XSAVEC, ?X86_FEATURE_NEEDED_TMM, ?X86_FEATURE_NEEDED_MASK, ?X86_FEATURE_USED_X86, ?X86_FEATURE_USED_X87, ?X86_FEATURE_USED_MMX, ?X86_FEATURE_USED_XMM, ?X86_FEATURE_USED_YMM, ?X86_FEATURE_USED_ZMM, ?X86_FEATURE_USED_FXSR, ?X86_FEATURE_USED_XSAVE, ?X86_FEATURE_USED_XSAVEOPT, ?X86_FEATURE_USED_XSAVEC, ?X86_FEATURE_USED_TMM, ?X86_FEATURE_USED_MASK};

# every trait axis, and its index by name, the key trait sets and format
# tables are kept in
val AXIS_COUNT: usize             = 47;
val AXES:       [AXIS_COUNT]*Axis = [AXIS_COUNT]*Axis{?RISCV_FLOAT_ABI, ?RISCV_RVC, ?RISCV_RVE, ?RISCV_TSO, ?RISCV_ARCH, ?RISCV_STACK_ALIGN, ?RISCV_UNALIGNED_ACCESS, ?RISCV_PRIV_SPEC, ?RISCV_PRIV_SPEC_MINOR, ?RISCV_PRIV_SPEC_REVISION, ?AARCH64_BTI, ?AARCH64_PAC, ?AARCH64_GCS, ?X86_IBT, ?X86_SHSTK, ?X86_ISA_NEEDED_BASELINE, ?X86_ISA_NEEDED_V2, ?X86_ISA_NEEDED_V3, ?X86_ISA_NEEDED_V4, ?X86_ISA_USED_BASELINE, ?X86_ISA_USED_V2, ?X86_ISA_USED_V3, ?X86_ISA_USED_V4, ?X86_FEATURE_NEEDED_X86, ?X86_FEATURE_NEEDED_X87, ?X86_FEATURE_NEEDED_MMX, ?X86_FEATURE_NEEDED_XMM, ?X86_FEATURE_NEEDED_YMM, ?X86_FEATURE_NEEDED_ZMM, ?X86_FEATURE_NEEDED_FXSR, ?X86_FEATURE_NEEDED_XSAVE, ?X86_FEATURE_NEEDED_XSAVEOPT, ?X86_FEATURE_NEEDED_XSAVEC, ?X86_FEATURE_NEEDED_TMM, ?X86_FEATURE_NEEDED_MASK, ?X86_FEATURE_USED_X86, ?X86_FEATURE_USED_X87, ?X86_FEATURE_USED_MMX, ?X86_FEATURE_USED_XMM, ?X86_FEATURE_USED_YMM, ?X86_FEATURE_USED_ZMM, ?X86_FEATURE_USED_FXSR, ?X86_FEATURE_USED_XSAVE, ?X86_FEATURE_USED_XSAVEOPT, ?X86_FEATURE_USED_XSAVEC, ?X86_FEATURE_USED_TMM, ?X86_FEATURE_USED_MASK};
val AXIS_NAMES: [AXIS_COUNT]*Axis = [AXIS_COUNT]*Axis{?AARCH64_BTI, ?AARCH64_GCS, ?AARCH64_PAC, ?RISCV_ARCH, ?RISCV_FLOAT_ABI, ?RISCV_PRIV_SPEC, ?RISCV_PRIV_SPEC_MINOR, ?RISCV_PRIV_SPEC_REVISION, ?RISCV_RVC, ?RISCV_RVE, ?RISCV_STACK_ALIGN, ?RISCV_TSO, ?RISCV_UNALIGNED_ACCESS, ?X86_FEATURE_NEEDED_FXSR, ?X86_FEATURE_NEEDED_MASK, ?X86_FEATURE_NEEDED_MMX, ?X86_FEATURE_NEEDED_TMM, ?X86_FEATURE_NEEDED_X86, ?X86_FEATURE_NEEDED_X87, ?X86_FEATURE_NEEDED_XMM, ?X86_FEATURE_NEEDED_XSAVE, ?X86_FEATURE_NEEDED_XSAVEC, ?X86_FEATURE_NEEDED_XSAVEOPT, ?X86_FEATURE_NEEDED_YMM, ?X86_FEATURE_NEEDED_ZMM, ?X86_FEATURE_USED_FXSR, ?X86_FEATURE_USED_MASK, ?X86_FEATURE_USED_MMX, ?X86_FEATURE_USED_TMM, ?X86_FEATURE_USED_X86, ?X86_FEATURE_USED_X87, ?X86_FEATURE_USED_XMM, ?X86_FEATURE_USED_XSAVE, ?X86_FEATURE_USED_XSAVEC, ?X86_FEATURE_USED_XSAVEOPT, ?X86_FEATURE_USED_YMM, ?X86_FEATURE_USED_ZMM, ?X86_IBT, ?X86_ISA_NEEDED_BASELINE, ?X86_ISA_NEEDED_V2, ?X86_ISA_NEEDED_V3, ?X86_ISA_NEEDED_V4, ?X86_ISA_USED_BASELINE, ?X86_ISA_USED_V2, ?X86_ISA_USED_V3, ?X86_ISA_USED_V4, ?X86_SHSTK};

pub val X86_64: Arch = Arch{
    name:          "x86_64",
    codes:         ?X86_64_CODES[0],
    code_count:    3,
    pointer_bytes: 8,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 7, ra: 16, code_align: 1, data_align: -8}},
    caps:          ADDRESSED,
    axes:          ?X86_AXES[0],
    axis_count:    34,
};
pub val X86: Arch = Arch{
    name:          "x86",
    codes:         ?X86_CODES[0],
    code_count:    3,
    pointer_bytes: 4,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 4, ra: 8, code_align: 1, data_align: -4}},
    caps:          ADDRESSED,
    axes:          ?X86_AXES[0],
    axis_count:    34,
};
pub val AARCH64: Arch = Arch{
    name:          "aarch64",
    codes:         ?AARCH64_CODES[0],
    code_count:    3,
    pointer_bytes: 8,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 31, ra: 30, code_align: 1, data_align: -8}},
    caps:          ADDRESSED,
    axes:          ?AARCH64_AXES[0],
    axis_count:    3,
};
