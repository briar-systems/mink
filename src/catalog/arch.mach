    unwind:        opt[Unwind].some{Unwind{sp: 2, ra: 1, code_align: 1, data_align: -4}},
    caps:          ADDRESSED,
    axes:          ?RISCV_AXES[0],
    axis_count:    10,
};
pub val RISCV32: Arch = Arch{
    name:          "riscv32",
    codes:         ?RV32_CODES[0],
    code_count:    2,
    pointer_bytes: 4,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 2, ra: 1, code_align: 1, data_align: -4}},
    caps:          ADDRESSED,
