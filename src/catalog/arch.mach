# the architecture catalog
#
# one row per architecture, and the only place mink names one. formats and
# the linker read a row through its codes and capabilities and never compare
# an architecture against a constant. a new architecture is a new row.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.catalog.format;
use mink.catalog.format.Code;
use mink.catalog.format.Format;
use mink.fail;
use mink.fail.Fail;
use mink.index;
use mink.index.Entry;
use mink.index.Index;
use mink.reader;
use mink.reader.Order;

pub def Caps: u64;

# sections are placed at addresses in an image or a linear memory
pub val ADDRESSED: Caps = 1;
# symbols resolve to entries of typed index spaces, as wasm functions and
# SPIR-V ids do
pub val INDEXED: Caps = 2;

# the DWARF call frame facts a linker reads
# ---
# sp:         the register number of the stack pointer
# ra:         the return address column
# code_align: the code alignment factor
# data_align: the data alignment factor
pub rec Unwind {
    sp:         u16;
    ra:         u16;
    code_align: u8;
    data_align: i8;
}

# name:          the architecture's spelling
# codes:         how each format that names it does so
# code_count:    how many codes
# pointer_bytes: the width of an address
# order:         byte order of multi-byte data
# page_size:     the base page granule, zero where there are no pages
# unwind:        the call frame facts, none where DWARF frames do not apply
# caps:          the capabilities the architecture declares
pub rec Arch {
    name:          str;
    codes:         *Code;
    code_count:    usize;
    pointer_bytes: u8;
    order:         Order;
    page_size:     u64;
    unwind:        opt[Unwind];
    caps:          Caps;
}

# ELF EI_CLASS
val CLASS32: u32 = 1;
val CLASS64: u32 = 2;

val X86_64_CODES: [3]Code = [3]Code{
    Code{format: ?format.ELF, value: 62, qualifier: CLASS64},
    Code{format: ?format.COFF, value: 0x8664},
    Code{format: ?format.MACHO, value: 0x0100_0007, qualifier: 3},
};
val X86_CODES: [3]Code = [3]Code{
    Code{format: ?format.ELF, value: 3, qualifier: CLASS32},
    Code{format: ?format.COFF, value: 0x14c},
    Code{format: ?format.MACHO, value: 7, qualifier: 3},
};
val AARCH64_CODES: [3]Code = [3]Code{
    Code{format: ?format.ELF, value: 183, qualifier: CLASS64},
    Code{format: ?format.COFF, value: 0xaa64},
    Code{format: ?format.MACHO, value: 0x0100_000c, qualifier: 0},
};
val RV64_CODES: [2]Code = [2]Code{
    Code{format: ?format.ELF, value: 243, qualifier: CLASS64},
    Code{format: ?format.COFF, value: 0x5064},
};
val RV32_CODES: [2]Code = [2]Code{
    Code{format: ?format.ELF, value: 243, qualifier: CLASS32},
    Code{format: ?format.COFF, value: 0x5032},
};
# wasm names its address width by the index type of its memories
val WASM32_CODES: [1]Code = [1]Code{Code{format: ?format.WASM, value: 32}};
val WASM64_CODES: [1]Code = [1]Code{Code{format: ?format.WASM, value: 64}};
# the SPIR-V magic number
val SPIRV_CODES: [1]Code = [1]Code{Code{format: ?format.SPIRV, value: 0x0723_0203}};

pub val X86_64: Arch = Arch{
    name:          "x86_64",
    codes:         ?X86_64_CODES[0],
    code_count:    3,
    pointer_bytes: 8,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 7, ra: 16, code_align: 1, data_align: -8}},
    caps:          ADDRESSED,
};
pub val X86: Arch = Arch{
    name:          "x86",
    codes:         ?X86_CODES[0],
    code_count:    3,
    pointer_bytes: 4,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 4, ra: 8, code_align: 1, data_align: -4}},
    caps:          ADDRESSED,
};
pub val AARCH64: Arch = Arch{
    name:          "aarch64",
    codes:         ?AARCH64_CODES[0],
    code_count:    3,
    pointer_bytes: 8,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 31, ra: 30, code_align: 1, data_align: -8}},
    caps:          ADDRESSED,
};
pub val RISCV64: Arch = Arch{
    name:          "riscv64",
    codes:         ?RV64_CODES[0],
    code_count:    2,
    pointer_bytes: 8,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 2, ra: 1, code_align: 1, data_align: -4}},
    caps:          ADDRESSED,
};
pub val RISCV32: Arch = Arch{
    name:          "riscv32",
    codes:         ?RV32_CODES[0],
    code_count:    2,
    pointer_bytes: 4,
    order:         reader.LITTLE,
    page_size:     0x1000,
    unwind:        opt[Unwind].some{Unwind{sp: 2, ra: 1, code_align: 1, data_align: -4}},
    caps:          ADDRESSED,
};
pub val WASM32: Arch = Arch{
    name:          "wasm32",
    codes:         ?WASM32_CODES[0],
    code_count:    1,
    pointer_bytes: 4,
    order:         reader.LITTLE,
    page_size:     0x1_0000,
    unwind:        opt[Unwind].none{},
    caps:          ADDRESSED | INDEXED,
};
pub val WASM64: Arch = Arch{
    name:          "wasm64",
    codes:         ?WASM64_CODES[0],
    code_count:    1,
    pointer_bytes: 8,
    order:         reader.LITTLE,
    page_size:     0x1_0000,
    unwind:        opt[Unwind].none{},
    caps:          ADDRESSED | INDEXED,
};
pub val SPIRV: Arch = Arch{
    name:          "spirv",
    codes:         ?SPIRV_CODES[0],
    code_count:    1,
    pointer_bytes: 8,
    order:         reader.LITTLE,
    page_size:     0,
    unwind:        opt[Unwind].none{},
    caps:          INDEXED,
};

val ROW_COUNT: usize            = 8;
val ROWS:      [ROW_COUNT]*Arch = [ROW_COUNT]*Arch{?X86_64, ?X86, ?AARCH64, ?RISCV64, ?RISCV32, ?WASM32, ?WASM64, ?SPIRV};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Arch {
    ret ROWS[index];
}

# the rows by name, ascending, each entry naming a row by its position in ROWS
val NAME_ENTRIES: [ROW_COUNT]Entry = [ROW_COUNT]Entry{
    Entry{key: "aarch64", row: 2},
    Entry{key: "riscv32", row: 4},
    Entry{key: "riscv64", row: 3},
    Entry{key: "spirv", row: 7},
    Entry{key: "wasm32", row: 5},
    Entry{key: "wasm64", row: 6},
    Entry{key: "x86", row: 1},
    Entry{key: "x86_64", row: 0},
};
val NAMES: Index = Index{at: ?NAME_ENTRIES[0], len: ROW_COUNT::u32};

# a code of a row as the format spells it. the qualifier is zero where the
# format does not qualify its codes
# ---
# format:    the format that names the row
# value:     the format's code
# qualifier: the qualifier, zero for an unqualified format
# row:       the row's position in ROWS
rec Coded {
    format:    *Format;
    value:     u32;
    qualifier: u32;
    row:       u32;
}

val CODE_COUNT: usize = 16;

# the codes ascending by format name, then value, then qualifier
val CODE_ENTRIES: [CODE_COUNT]Coded = [CODE_COUNT]Coded{
    Coded{format: ?format.COFF, value: 0x14c, row: 1},
    Coded{format: ?format.COFF, value: 0x5032, row: 4},
    Coded{format: ?format.COFF, value: 0x5064, row: 3},
    Coded{format: ?format.COFF, value: 0x8664, row: 0},
    Coded{format: ?format.COFF, value: 0xaa64, row: 2},
    Coded{format: ?format.ELF, value: 3, qualifier: CLASS32, row: 1},
    Coded{format: ?format.ELF, value: 62, qualifier: CLASS64, row: 0},
    Coded{format: ?format.ELF, value: 183, qualifier: CLASS64, row: 2},
    Coded{format: ?format.ELF, value: 243, qualifier: CLASS32, row: 4},
    Coded{format: ?format.ELF, value: 243, qualifier: CLASS64, row: 3},
    Coded{format: ?format.MACHO, value: 7, row: 1},
    Coded{format: ?format.MACHO, value: 0x0100_0007, row: 0},
    Coded{format: ?format.MACHO, value: 0x0100_000c, row: 2},
    Coded{format: ?format.SPIRV, value: 0x0723_0203, row: 7},
    Coded{format: ?format.WASM, value: 32, row: 5},
    Coded{format: ?format.WASM, value: 64, row: 6},
};

fun order_coded(a: *Coded, b: *Coded) i64 {
    val f: i64 = str_compare(a.format.name, b.format.name);
    if (f != 0)                    { ret f; }
    if (a.value < b.value)         { ret -1; }
    if (a.value > b.value)         { ret 1; }
    if (a.qualifier < b.qualifier) { ret -1; }
    if (a.qualifier > b.qualifier) { ret 1; }
    ret 0;
}

pub fun by_name(name: str) res[*Arch, Fail] {
    val row: opt[u32] = index.find(?NAMES, name);
    if (sel row.none) { ret res[*Arch, Fail].err{fail.unsupported("no architecture has this name")}; }
    ret res[*Arch, Fail].ok{ROWS[row.some]};
}

# whether `a` is a row of this catalog
pub fun member(a: *Arch) bool {
    if (a == nil) { ret false; }
    val row: opt[u32] = index.find(?NAMES, a.name);
    ret sel row.some && ROWS[row.some] == a;
}

# the row `f` names with `value` and `qualifier`
pub fun by_code(f: *Format, value: u32, qualifier: u32) res[*Arch, Fail] {
    var key: Coded = Coded{format: f, value: value};
    if (f.qualified) { key.qualifier = qualifier; }
    val at: SearchPosition = sort.binary_search_by[Coded](?CODE_ENTRIES[0], CODE_COUNT, ?key, order_coded);
    if (sel at.insertion) { ret res[*Arch, Fail].err{fail.unsupported("no architecture has this machine code")}; }
    ret res[*Arch, Fail].ok{ROWS[CODE_ENTRIES[at.found].row]};
}

# how `f` names `a`, none when it does not
pub fun code(a: *Arch, f: *Format) opt[Code] {
    var k: usize = 0;
    for (k < a.code_count) {
        if (a.codes[k].format == f) { ret opt[Code].some{a.codes[k]}; }
        k = k + 1;
    }
    ret opt[Code].none{};
}

pub fun has(a: *Arch, c: Caps) bool {
    ret (a.caps & c) == c;
}

# whether a row is consistent: a power of two address width of at most eight
# bytes, pages exactly where there are addresses, and frame facts with
# distinct registers and factors that divide the address width
fun consistent(a: *Arch) bool {
    val w: u8 = a.pointer_bytes;
    if (w == 0 || w > 8 || (w & (w - 1)) != 0)   { ret false; }
    if (has(a, ADDRESSED) != (a.page_size != 0)) { ret false; }
    if ((a.page_size & (a.page_size - 1)) != 0)  { ret false; }
    if (sel a.unwind.none)                       { ret true; }
    val u: Unwind = a.unwind.some;
    if (u.sp == u.ra || u.code_align == 0 || u.data_align == 0) { ret false; }
    ret w::i64 % u.data_align::i64 == 0;
}

fun row_name(row: usize) str {
    ret ROWS[row].name;
}

# whether `n` coded entries ascend strictly and each names a code of its row
fun codes_hold(entries: *Coded, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (i != 0 && order_coded(?entries[i - 1], ?entries[i]) >= 0) { ret false; }
        val a:     *Arch = ROWS[entries[i].row];
        var found: bool  = false;
        var k:     usize = 0;
        for (k < a.code_count) {
            if (format.matches(?a.codes[k], entries[i].format, entries[i].value, entries[i].qualifier)) { found = true; }
            k = k + 1;
        }
        if (!found) { ret false; }
        i = i + 1;
    }
    ret true;
}

val DUPLICATE_CODES: [2]Coded = [2]Coded{
    Coded{format: ?format.COFF, value: 0x14c, row: 1},
    Coded{format: ?format.COFF, value: 0x14c, row: 1},
};

val DUPLICATE_NAMES: [2]Entry = [2]Entry{Entry{key: "x86_64", row: 0}, Entry{key: "x86_64", row: 0}};

test arch__rows_are_consistent_and_indexes_hold {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        i = i + 1;
    }
    val names: err[Fail] = index.verify(?NAMES, ROW_COUNT, row_name);
    if (sel names.err) { ret 1; }
    var coded: usize = 0;
    i = 0;
    for (i < ROW_COUNT) {
        coded = coded + ROWS[i].code_count;
        i     = i + 1;
    }
    if (coded != CODE_COUNT)                       { ret 1; }
    if (!codes_hold(?CODE_ENTRIES[0], CODE_COUNT)) { ret 1; }
    if (codes_hold(?DUPLICATE_CODES[0], 2))        { ret 1; }
    val dup: Index     = Index{at: ?DUPLICATE_NAMES[0], len: 2};
    val bad: err[Fail] = index.verify(?dup, 2, row_name);
    if (sel bad.ok) { ret 1; }
    ret 0;
}

test arch__membership_is_by_row_identity {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!member(ROWS[i])) { ret 1; }
        i = i + 1;
    }
    var copy: Arch = X86_64;
    if (member(?copy) || member(nil)) { ret 1; }
    ret 0;
}

test arch__lookup_by_any_code_and_refuse_unknown {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        var k: usize = 0;
        for (k < ROWS[i].code_count) {
            val c: *Code            = ?ROWS[i].codes[k];
            val r: res[*Arch, Fail] = by_code(c.format, c.value, c.qualifier);
            if (sel r.err)       { ret 1; }
            if (r.ok != ROWS[i]) { ret 1; }
            k = k + 1;
        }
        val n: res[*Arch, Fail] = by_name(ROWS[i].name);
        if (sel n.err)       { ret 1; }
        if (n.ok != ROWS[i]) { ret 1; }
        i = i + 1;
    }
    val absent: res[*Arch, Fail] = by_name("z80");
    if (sel absent.ok) { ret 1; }
    val unknown: res[*Arch, Fail] = by_code(?format.ELF, 0xffff, CLASS64);
    if (sel unknown.ok)                     { ret 1; }
    if (!sel unknown.err.cause.unsupported) { ret 1; }
    val class: res[*Arch, Fail] = by_code(?format.ELF, 62, CLASS32);
    if (sel class.ok) { ret 1; }
    ret 0;
}

test arch__capability_query_answers_from_the_row {
    val x: res[*Arch, Fail] = by_name("x86_64");
    if (sel x.err) { ret 1; }
    val s: res[*Arch, Fail] = by_name("spirv");
    if (sel s.err)                                   { ret 1; }
    if (!has(x.ok, ADDRESSED) || has(x.ok, INDEXED)) { ret 1; }
    if (has(s.ok, ADDRESSED) || !has(s.ok, INDEXED)) { ret 1; }
    val macho: opt[Code] = code(s.ok, ?format.MACHO);
    if (sel macho.some) { ret 1; }
    ret 0;
}
