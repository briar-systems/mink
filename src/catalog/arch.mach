# the architecture catalog
#
# one row per architecture, and the only place mink names one. formats and
# the linker read a row through its codes and capabilities and never compare
# an architecture against a constant. a new architecture is a new row, and
# its ABI traits are trait rows beside it that the row lists.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.catalog.format;
use mink.catalog.format.Code;
use mink.catalog.format.Format;
use mink.catalog.isa.Grammar;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Choice;
use mink.fail;
use mink.fail.Fail;
use mink.index;
use mink.reader;
use mink.reader.Order;

pub def Caps: u64;

# sections are placed at addresses in an image or a linear memory
pub val ADDRESSED: Caps = 1;
# symbols resolve to entries of typed index spaces, as wasm functions and
# SPIR-V ids do
pub val INDEXED: Caps = 2;

# the DWARF call frame facts a linker reads
# ---
# sp:         the register number of the stack pointer
# ra:         the return address column
# code_align: the code alignment factor
# data_align: the data alignment factor
pub rec Unwind {
    sp:         u16;
    ra:         u16;
    code_align: u8;
    data_align: i8;
}

# name:          the architecture's spelling
# codes:         how each format that names it does so
# code_count:    how many codes
# pointer_bytes: the width of an address
# order:         byte order of multi-byte data
# page_size:     the base page granule, zero where there are no pages
# unwind:        the call frame facts, none where DWARF frames do not apply
# caps:          the capabilities the architecture declares
# axes:          the trait axes an object for it may state
# axis_count:    how many
pub rec Arch {
    name:          str;
    codes:         *Code;
    code_count:    usize;
    pointer_bytes: u8;
    order:         Order;
    page_size:     u64;
    unwind:        opt[Unwind];
    caps:          Caps;
    axes:          **Axis;
    axis_count:    usize;
}

# ELF EI_CLASS
val CLASS32: u32 = 1;
val CLASS64: u32 = 2;

val X86_64_CODES: [3]Code = [3]Code{
    Code{format: ?format.ELF, value: 62, qualifier: CLASS64},
    Code{format: ?format.COFF, value: 0x8664},
    Code{format: ?format.MACHO, value: 0x0100_0007, qualifier: 3},
};
val X86_CODES: [3]Code = [3]Code{
    Code{format: ?format.ELF, value: 3, qualifier: CLASS32},
    Code{format: ?format.COFF, value: 0x14c},
    Code{format: ?format.MACHO, value: 7, qualifier: 3},
};
val AARCH64_CODES: [3]Code = [3]Code{
    Code{format: ?format.ELF, value: 183, qualifier: CLASS64},
    Code{format: ?format.COFF, value: 0xaa64},
    Code{format: ?format.MACHO, value: 0x0100_000c, qualifier: 0},
};
val RV64_CODES: [2]Code = [2]Code{
    Code{format: ?format.ELF, value: 243, qualifier: CLASS64},
    Code{format: ?format.COFF, value: 0x5064},
};
val RV32_CODES: [2]Code = [2]Code{
    Code{format: ?format.ELF, value: 243, qualifier: CLASS32},
    Code{format: ?format.COFF, value: 0x5032},
};
# wasm names its address width by the index type of its memories
val WASM32_CODES: [1]Code = [1]Code{Code{format: ?format.WASM, value: 32}};
val WASM64_CODES: [1]Code = [1]Code{Code{format: ?format.WASM, value: 64}};
# the SPIR-V magic number
val SPIRV_CODES: [1]Code = [1]Code{Code{format: ?format.SPIRV, value: 0x0723_0203}};

# the RISC-V psABI calling convention for floating point arguments
pub val RISCV_SOFT:   Choice = Choice{name: "soft"};
pub val RISCV_SINGLE: Choice = Choice{name: "single"};
pub val RISCV_DOUBLE: Choice = Choice{name: "double"};
pub val RISCV_QUAD:   Choice = Choice{name: "quad"};

val RISCV_FLOAT_ABIS: [4]*Choice = [4]*Choice{?RISCV_SOFT, ?RISCV_SINGLE, ?RISCV_DOUBLE, ?RISCV_QUAD};

pub val RISCV_FLOAT_ABI: Axis = Axis{name: "riscv-float-abi", value: trait.Value.choice{}, merge: trait.Merge.equal{}, choices: ?RISCV_FLOAT_ABIS[0], count: 4};
# the code holds compressed instructions
pub val RISCV_RVC: Axis = Axis{name: "riscv-rvc", value: trait.Value.flag{}, merge: trait.Merge.union{}};
# the code is for the embedded base, sixteen integer registers
pub val RISCV_RVE: Axis = Axis{name: "riscv-rve", value: trait.Value.flag{}, merge: trait.Merge.equal{}};
# the code assumes total store ordering
pub val RISCV_TSO: Axis = Axis{name: "riscv-tso", value: trait.Value.flag{}, merge: trait.Merge.union{}};

# the RISC-V ISA string grammar: a base of `rv` and the register width, the
# base integer set first, then the canonical order of the RISC-V ISA manual
pub val RISCV_EXTENSIONS: Grammar = Grammar{base: "rv", bases: "ie", single: "iemafdqlcbkjtpvnh", multi: "zsx", ranked: "z"};
# the ISA string the code is for, as Tag_RISCV_arch states it
pub val RISCV_ARCH: Axis = Axis{name: "riscv-arch", value: trait.Value.text{}, merge: trait.Merge.extensions{?RISCV_EXTENSIONS}};
# the alignment the code keeps the stack at, in bytes
pub val RISCV_STACK_ALIGN: Axis = Axis{name: "riscv-stack-align", value: trait.Value.number{}, merge: trait.Merge.equal{}};
# the code makes unaligned memory accesses
pub val RISCV_UNALIGNED_ACCESS: Axis = Axis{name: "riscv-unaligned-access", value: trait.Value.flag{}, merge: trait.Merge.union{}};
# the privileged specification version the code was built for, which a link
# does not compare
pub val RISCV_PRIV_SPEC:          Axis = Axis{name: "riscv-priv-spec", value: trait.Value.number{}, merge: trait.Merge.first{}};
pub val RISCV_PRIV_SPEC_MINOR:    Axis = Axis{name: "riscv-priv-spec-minor", value: trait.Value.number{}, merge: trait.Merge.first{}};
pub val RISCV_PRIV_SPEC_REVISION: Axis = Axis{name: "riscv-priv-spec-revision", value: trait.Value.number{}, merge: trait.Merge.first{}};

val RISCV_AXES: [10]*Axis = [10]*Axis{?RISCV_FLOAT_ABI, ?RISCV_RVC, ?RISCV_RVE, ?RISCV_TSO, ?RISCV_ARCH, ?RISCV_STACK_ALIGN, ?RISCV_UNALIGNED_ACCESS, ?RISCV_PRIV_SPEC, ?RISCV_PRIV_SPEC_MINOR, ?RISCV_PRIV_SPEC_REVISION};

# every indirect branch target is marked, so branch target identification can
# be enforced
pub val AARCH64_BTI: Axis = Axis{name: "aarch64-bti", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};
# return addresses are signed with pointer authentication
pub val AARCH64_PAC: Axis = Axis{name: "aarch64-pac", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};
# the code keeps a guarded control stack of return addresses
pub val AARCH64_GCS: Axis = Axis{name: "aarch64-gcs", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};

val AARCH64_AXES: [3]*Axis = [3]*Axis{?AARCH64_BTI, ?AARCH64_PAC, ?AARCH64_GCS};

# every indirect branch target is marked, so indirect branch tracking can be enforced
pub val X86_IBT: Axis = Axis{name: "x86-ibt", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};
# the code keeps a shadow stack of return addresses
pub val X86_SHSTK: Axis = Axis{name: "x86-shstk", value: trait.Value.flag{}, merge: trait.Merge.intersection{}};
# the micro-architecture levels the code needs to run and the ones it uses
pub val X86_ISA_NEEDED_BASELINE: Axis = Axis{name: "x86-isa-needed-baseline", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_NEEDED_V2:       Axis = Axis{name: "x86-isa-needed-v2", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_NEEDED_V3:       Axis = Axis{name: "x86-isa-needed-v3", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_NEEDED_V4:       Axis = Axis{name: "x86-isa-needed-v4", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_USED_BASELINE:   Axis = Axis{name: "x86-isa-used-baseline", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_USED_V2:         Axis = Axis{name: "x86-isa-used-v2", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_USED_V3:         Axis = Axis{name: "x86-isa-used-v3", value: trait.Value.flag{}, merge: trait.Merge.union{}};
pub val X86_ISA_USED_V4:         Axis = Axis{name: "x86-isa-used-v4", value: trait.Value.flag{}, merge: trait.Merge.union{}};
