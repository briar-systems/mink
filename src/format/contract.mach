# the low contract every format module fills
#
# a format module declares the rows below and its registration names them:
# the codec that reads, writes and dumps its files, the conversion to and from
# a neutral object, the member operations of a container, and the lowering of
# the records a neutral object states. the rows sit below the link, so the
# link phases read them without reaching the registrations above it.
#
# a model holds the codec, conversion and container rows it was read with,
# never the registration. every model answers its kind, a row of the kind
# catalog, and whoever takes the input asks that row's capabilities. a member
# answers its own kind and converts through its own format, so a container has
# no neutral form of its own.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Stated;
use mink.catalog.format.Format;
use catalog_kind: mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.format.dump;
use mink.format.dump.Dumper;
use mink.lower.Lowering;
use mink.model.object;
use mink.model.object.Object;
use mink.model.section;
use mink.model.target.Target;

# an input: its name, for every failure, and its bytes, borrowed for as long
# as any model read from it lives
pub rec Input {
    file: str;
    data: *u8;
    len:  usize;
}

# the bytes at `offset` that identify a format's files, compared under `mask`,
# where a nil mask compares every bit
pub rec Magic {
    offset: usize;
    bytes:  *u8;
    mask:   *u8;
    len:    usize;
}

# rows:  the magics, static
# count: how many
pub rec Magics {
    rows:  *Magic;
    count: usize;
}

# whether an input is a file of the format, for a format no fixed bytes tell
# apart, such as a linker script
pub def Probe: fun(*Input) bool;

# how a format's files are told apart from every other format's
# ---
# magics: fixed bytes, which every registered format's magics tell apart
# probe:  a test of the input, run only when no magic matches
pub tag Identify: u8 {
    magics: Magics;
    probe:  Probe;
}

# the exact revision of one specification a format implements
pub rec Revision {
    spec:     str;
    revision: str;
}

# the reference tool's flags a format's dump is compared with, beyond the ones
# every format is compared with
# ---
# flags: each flag, one string each, valid while the registration lives
# count: how many
pub rec Reference {
    flags: *str;
    count: usize;
}

pub def ToNeutral:   fun(ptr, *Object) err[Fail];
pub def FromNeutral: fun(*A.Allocator, *Object, *Target, opt[*Lowering]) res[ptr, Fail];

# what a format module does with its own files, over its own model behind an
# opaque pointer
# ---
# identify: how its files are told apart
# read:     parse an input into a model, refusing what the specification
#           forbids with a located failure
# write:    lay a model out through the layout plan and return its bytes, in
#           a sink the format builds in its own byte order
# dump:     describe a model, field by field in model order
# kind:     the kind of file a model is, refusing a file whose kind the format
#           cannot tell without guessing
# locate:   the model record holding byte `offset` of the bytes the model
#           reads and writes, its offset placed, and a nil record for an
#           offset no record covers
# release:  give back everything a model owns
pub rec Codec {
    identify: Identify;
    read:     fun(*A.Allocator, *Input) res[ptr, Fail];
    write:    fun(*A.Allocator, ptr) res[Sink, Fail];
    dump:     fun(ptr, *Dumper) err[Fail];
    kind:     fun(ptr) res[*Kind, Fail];
    locate:   fun(ptr, u64) Location;
    release:  fun(*A.Allocator, ptr) err[Fail];
}

# how a format converts its objects to neutral objects and back
# ---
# to:   add what a model of a kind a link takes as an object holds to an empty
#       neutral object, which a refusal leaves empty
# from: build a model from a neutral object for the target `t`, its records
#       lowered into the model in the encodings the lowering names, leaving
#       the object as it was
pub rec Neutral {
    to:   ToNeutral;
    from: FromNeutral;
}

# how a format names sections, for an assembler's conventions
# ---
# kind_of: the kind a section of the name takes by the format's convention,
#          none when no convention names it
# name_of: the name a section of the kind that states none takes, refused
#          for a kind the format has no name for
pub rec Naming {
    kind_of: fun(Bytes) opt[*section.Kind];
    name_of: fun(*section.Kind) res[str, Fail];
}

# how the string `s` orders against the bytes `b`, byte by byte and then the
# shorter first
fun compare_spelling(s: str, b: Bytes) i64 {
    var i: usize = 0;
    for (i < b.len) {
        if (s[i] == 0)        { ret -1; }
        if (s[i] < b.data[i]) { ret -1; }
        if (s[i] > b.data[i]) { ret 1; }
        i = i + 1;
    }
    if (s[i] != 0) { ret 1; }
    ret 0;
}

# the row spelled `name`, or failing that, spelled as the longest start of
# `name` that ends before a `separator` byte, or at it, as a convention names
# a section and its suffixed relatives alike. `rows` ascend by spelling, and
# a separator of zero takes the whole name alone. none when no row is
# spelled so
pub fun spelled[R](rows: **R, count: usize, name: Bytes, separator: u8, spelling: fun(*R) str) opt[*R] {
    var n: usize = name.len;
    for {
        val whole: opt[*R] = spelled_as[R](rows, count, Bytes{data: name.data, len: n}, spelling);
        if (sel whole.some)           { ret whole; }
        if (separator == 0 || n == 0) { ret opt[*R].none{}; }
        if (n < name.len) {
            val kept: opt[*R] = spelled_as[R](rows, count, Bytes{data: name.data, len: n + 1}, spelling);
            if (sel kept.some) { ret kept; }
        }
        n = n - 1;
        for (n > 0 && name.data[n] != separator) {
            n = n - 1;
        }
        if (n == 0) { ret opt[*R].none{}; }
    }
    ret opt[*R].none{};
}

# the row of `rows`, which ascend by spelling, spelled `b`, none for none
fun spelled_as[R](rows: **R, count: usize, b: Bytes, spelling: fun(*R) str) opt[*R] {
    var lo: usize = 0;
    var hi: usize = count;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val c:   i64   = compare_spelling(spelling(rows[mid]), b);
        if (c == 0) { ret opt[*R].some{rows[mid]}; }
        if (c < 0)  { lo = mid + 1; }
        or          { hi = mid; }
    }
    ret opt[*R].none{};
}

# one encoding a format has of a trait axis. an axis may have several, as
# AArch64 states branch protection both in a GNU property and in a build
# attribute, and the format writes each. the format's own row of where the
# value lives holds this one
# ---
# axis:     the axis
# required: whether an object the format writes must state the axis, as the
#           encoding always holds a value of it and an object that leaves the
#           axis unstated means another
pub rec Encoding {
    axis:     *Axis;
    required: bool;
}

# an axis a format encodes for an architecture, the answer `encodes` gives
# ---
# axis:     the axis
# required: whether an object the format writes for the architecture must
#           state it, as one of its encodings requires it
pub rec Encoded {
    axis:     *Axis;
    required: bool;
}

# how an assembler names an attribute: by its name or by its number
pub tag Tag: u8 {
    name:   str;
    number: u64;
}

# the axis an attribute of the format names for an architecture, none when
# no encoding of the architecture's axes is that attribute
pub def Attribute: fun(*Arch, Tag) opt[*Axis];

# whether the format writes the traits of an object for the architecture in
# the section of the name, so what that section holds is the format's and
# never a producer's
pub def Holds: fun(*Arch, Bytes) bool;

# how a format encodes the trait axes an object states. a producer learns
# which axes a format needs only through these rows
# ---
# encodings: every encoding, ascending by axis name, static
# count:     how many
# attribute: the axis an attribute names, for an assembler's attribute
#            directive
# holds:     whether a section of a name holds an object's traits
pub rec TraitCodec {
    encodings: **Encoding;
    count:     usize;
    attribute: Attribute;
    holds:     Holds;
}

# what one encoding of an axis states in a file
# ---
# encoding: the encoding
# setting:  what it states
# place:    what holds it in the file, for a refusal to name
pub rec Reading {
    encoding: *Encoding;
    setting:  Setting;
    place:    str;
}

fun no_attribute(a: *Arch, t: Tag) opt[*Axis] {
    ret opt[*Axis].none{};
}

fun holds_none(a: *Arch, name: Bytes) bool {
    ret false;
}

# the codec of a format that encodes no trait axis, whose view of every
# architecture is empty
pub val NO_TRAITS: TraitCodec = TraitCodec{encodings: nil, count: 0, attribute: no_attribute, holds: holds_none};

fun order_encodings(a: **Encoding, b: **Encoding) i64 {
    ret str_compare(a[0].axis.name, b[0].axis.name);
}

# the encodings of `x` in `c`: where the first lies among them, and how many
pub rec Rows {
    at:    usize;
    count: usize;
}

# the encodings `c` has of `x`
pub fun encodings_of(c: *TraitCodec, x: *Axis) Rows {
    var lo: usize = 0;
    var hi: usize = c.count;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (str_compare(c.encodings[mid].axis.name, x.name) < 0) { lo = mid + 1; }
        or                                                       { hi = mid; }
    }
    var n: usize = 0;
    for (lo + n < c.count && c.encodings[lo + n].axis == x) {
        n = n + 1;
    }
    ret Rows{at: lo, count: n};
}

# whether a codec is consistent: its encodings ascend by axis name and each
# names an axis
pub fun consistent_codec(c: *TraitCodec) bool {
    var i: usize = 0;
    for (i < c.count) {
        if (c.encodings[i] == nil || c.encodings[i].axis == nil)                { ret false; }
        if (i > 0 && order_encodings(?c.encodings[i - 1], ?c.encodings[i]) > 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# append to `out` each axis of `a` that `c` encodes, in the order of the
# architecture's axes, each once, required when any of its encodings is. an
# axis the architecture's row fixes has no encoding, as no object states it
pub fun encodes(c: *TraitCodec, a: *Arch, out: *Table[Encoded]) err[Fail] {
    val mark: usize = table.count[Encoded](out);
    var i:    usize = 0;
    for (i < a.axis_count) {
        val x:    *Axis = a.axes[i];
        val rows: Rows  = encodings_of(c, x);
        i = i + 1;
        if (rows.count == 0) { cnt; }
        var required: bool  = false;
        var k:        usize = 0;
        for (k < rows.count) {
            if (c.encodings[rows.at + k].required) { required = true; }
            k = k + 1;
        }
        val p: res[Id[Encoded], Fail] = table.push[Encoded](out, Encoded{axis: x, required: required});
        if (sel p.err) {
            table.truncate[Encoded](out, mark);
            ret err[Fail].err{p.err};
        }
    }
    ret err[Fail].ok{};
}

fun order_readings(a: *Reading, b: *Reading) i64 {
    ret str_compare(a.encoding.axis.name, b.encoding.axis.name);
}

# whether two readings state the same value, what lies in bytes by its bytes,
# owned ones lying at `base`
fun agree(base: *u8, a: *Reading, b: *Reading) bool {
    if (sel a.setting.text) {
        if (sel b.setting.text) { ret store.same_bytes(store.at(base, ?a.setting.text), store.at(base, ?b.setting.text)); }
        ret false;
    }
    or (sel a.setting.set) {
        if (sel b.setting.set) { ret store.same_bytes(store.at(base, ?a.setting.set), store.at(base, ?b.setting.set)); }
        ret false;
    }
    or (sel a.setting.pair) {
        if (sel b.setting.pair) { ret a.setting.pair.number == b.setting.pair.number && store.same_bytes(store.at(base, ?a.setting.pair.text), store.at(base, ?b.setting.pair.text)); }
        ret false;
    }
    ret trait.same(a.setting, b.setting);
}

# state on `out` each axis the readings `rs` state, which this orders by axis,
# keeping the order the format read them in among one axis's. what lies in
# bytes and is owned lies at `base`. readings of one axis that state
# different values are refused naming the places of both, as are a setting
# its axis does not have and an axis `out` already states. a value that means
# what leaving its axis unstated means is held as nothing. a refusal leaves
# `out` as it was
pub fun reconcile(rs: *Table[Reading], base: *u8, out: *Table[Trait]) err[Fail] {
    val n:       usize                  = table.count[Reading](rs);
    var scratch: Table[Reading]         = table.make[Reading](rs.a);
    val grown:   res[Id[Reading], Fail] = table.grow[Reading](?scratch, n);
    if (sel grown.err) { ret err[Fail].err{grown.err}; }
    sort.sort_stable_by[Reading](table.items[Reading](rs), n, table.items[Reading](?scratch), order_readings);
    val freed: err[Fail] = table.release[Reading](?scratch);
    if (sel freed.err) { ret freed; }
    val at:   *Reading = table.items[Reading](rs);
    var axes: usize    = 0;
    var i:    usize    = 0;
    var head: usize    = 0;
    for (i < n) {
        val r: *Reading = ?at[i];
        if (i > 0 && at[head].encoding.axis == r.encoding.axis) {
            if (!agree(base, ?at[head], r)) {
                ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("two encodings of a trait axis state different values"), at[head].place), r.place)};
            }
            i = i + 1;
            cnt;
        }
        head = i;
        i    = i + 1;
        val x: *Axis = r.encoding.axis;
        if (!trait.fits(x, r.setting)) {
            ret err[Fail].err{fail.about(fail.malformed("the setting is not a value of its trait axis"), x.name)};
        }
        val known: opt[*Trait] = trait.find(out, x);
        if (sel known.some) { ret err[Fail].err{fail.about(fail.malformed("a trait axis is stated twice"), x.name)}; }
        axes = axes + 1;
    }
    val room: err[Fail] = table.reserve[Trait](out, axes);
    if (sel room.err) { ret room; }
    i = 0;
    for (i < n) {
        val r: *Reading = ?at[i];
        i = i + 1;
        if (i > 1 && at[i - 2].encoding.axis == r.encoding.axis) { cnt; }
        val added: err[Fail] = trait.state(out, Trait{axis: r.encoding.axis, setting: r.setting});
        if (sel added.err) { ret added; }
    }
    ret err[Fail].ok{};
}

# one file a container holds
# ---
# name:  its name in the container, valid while the container's model lives
# input: its bytes, named by the container's file
# arch:  the architecture it is for, as the container's fields code it, for a
#        member chosen by architecture rather than by the symbols it defines
pub rec Member {
    name:  Bytes;
    input: Input;
    arch:  opt[Stated];
}

# append to `out` the ids, as members issues them, of the members that define
# the symbol `name`, answering false when the container carries no index
pub def Index: fun(ptr, Bytes, *Table[Id[Member]]) res[bool, Fail];

# what a container format does besides its codec
# ---
# members: append every member to `out` in container order, each input named
#          by the container's file
# index:   the members defining a symbol, none for a format that never
#          carries an index. a container without one is scanned instead
pub rec Container {
    members: fun(ptr, str, *Table[Member]) err[Fail];
    index:   opt[Index];
}

# what reading a format's files takes, as its registration names it
# ---
# format:      the format's identity
# codec:       its codec
# neutral:     its conversion, none for a format that has none
# lowering:    the encodings its conversion lowers records in, none for a
#              format with none
# container:   its member operations, none for a format whose files hold no
#              other files
# fields:      the names its dump prints, indexed by the module's field keys
# field_count: how many
pub rec Reader {
    format:      *Format;
    codec:       *Codec;
    neutral:     opt[*Neutral];
    lowering:    opt[*Lowering];
    container:   opt[*Container];
    fields:      *str;
    field_count: usize;
}

# a model read or built by a registered format
# ---
# reader: what its format reads with
# a:      the allocator it lives in
# data:   the format's own model
pub rec Model {
    reader: *Reader;
    a:      *A.Allocator;
    data:   ptr;
}

pub fun write(m: *Model) res[Sink, Fail] {
    ret m.reader.codec.write(m.a, m.data);
}

# the dump of `m`, appended to `out`
pub fun describe(m: *Model, out: *Sink) err[Fail] {
    var d: Dumper = dump.make(out, m.reader.fields, m.reader.field_count);
    ret m.reader.codec.dump(m.data, ?d);
}

# where in `m` byte `offset` falls
pub fun locate(m: *Model, offset: u64) Location {
    ret m.reader.codec.locate(m.data, offset);
}

# the kind of file `m` is
pub fun kind(m: *Model) res[*Kind, Fail] {
    ret m.reader.codec.kind(m.data);
}

# whether the format `r` reads with converts its objects to neutral objects
# and back
pub fun converts(r: *Reader) bool {
    ret sel r.neutral.some;
}

# add what `m` holds to the empty neutral object `o`, refusing a model of a
# kind a link does not take as an object
pub fun to_neutral(m: *Model, o: *Object) err[Fail] {
    val k: res[*Kind, Fail] = kind(m);
    if (sel k.err) { ret err[Fail].err{k.err}; }
    if (!catalog_kind.has(k.ok, catalog_kind.OBJECT)) {
        ret err[Fail].err{fail.about(fail.unsupported("a kind a link does not take as an object has no neutral form"), k.ok.name)};
    }
    val n: opt[*Neutral] = m.reader.neutral;
    if (sel n.none) { ret err[Fail].err{not_converted(m.reader.format)}; }
    ret n.some.to(m.data, o);
}

# the model of the format `r` reads with that holds the neutral object `o`,
# built for the target `o` states
pub fun from_neutral(r: *Reader, a: *A.Allocator, o: *Object) res[Model, Fail] {
    val n: opt[*Neutral] = r.neutral;
    if (sel n.none) { ret res[Model, Fail].err{not_converted(r.format)}; }
    val data: res[ptr, Fail] = n.some.from(a, o, ?o.target, r.lowering);
    if (sel data.err) { ret res[Model, Fail].err{data.err}; }
    ret res[Model, Fail].ok{Model{reader: r, a: a, data: data.ok}};
}

pub fun release(m: *Model) err[Fail] {
    val data: ptr = m.data;
    m.data = nil;
    if (data == nil) { ret err[Fail].ok{}; }
    ret m.reader.codec.release(m.a, data);
}

# whether the format of `m` holds other files
pub fun is_container(m: *Model) bool {
    val c: opt[*Container] = m.reader.container;
    ret sel c.some;
}

# append the members of `m`, the container named `file`, to `out`. a model of
# a format that is not a container has none to give and is refused
pub fun members(m: *Model, file: str, out: *Table[Member]) err[Fail] {
    val c: opt[*Container] = m.reader.container;
    if (sel c.none) { ret err[Fail].err{not_container(m, file)}; }
    val r: err[Fail] = c.some.members(m.data, file, out);
    if (sel r.err) { ret err[Fail].err{fail.in_file(r.err, file)}; }
    ret r;
}

# append to `out` the members of `m`, the container named `file`, that define
# the symbol `name`, answering false when `m` carries no index, so its members
# are scanned instead
pub fun defining(m: *Model, file: str, name: Bytes, out: *Table[Id[Member]]) res[bool, Fail] {
    val c: opt[*Container] = m.reader.container;
    if (sel c.none) { ret res[bool, Fail].err{not_container(m, file)}; }
    val index: opt[Index] = c.some.index;
    if (sel index.none) { ret res[bool, Fail].ok{false}; }
    val r: res[bool, Fail] = index.some(m.data, name, out);
    if (sel r.err) { ret res[bool, Fail].err{fail.in_file(r.err, file)}; }
    ret r;
}

fun not_container(m: *Model, file: str) Fail {
    ret fail.in_file(fail.in_record(fail.unsupported("the format does not hold other files"), m.reader.format.name), file);
}

fun not_converted(f: *Format) Fail {
    ret fail.in_record(fail.unsupported("the format has no neutral conversion"), f.name);
}
