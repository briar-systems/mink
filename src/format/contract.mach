# the low contract every format module fills
#
# a format module declares the rows below and its registration names them:
# the codec that reads, writes and dumps its files, the conversion to and from
# a neutral object, the member operations of a container, and the lowering of
# the records a neutral object states. the rows sit below the link, so the
# link phases read them without reaching the registrations above it.
#
# a model holds the codec, conversion and container rows it was read with,
# never the registration. every model answers its kind, a row of the kind
# catalog, and whoever takes the input asks that row's capabilities. a member
# answers its own kind and converts through its own format, so a container has
# no neutral form of its own.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store.Bytes;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Stated;
use mink.catalog.format.Format;
use catalog_kind: mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.format.dump;
use mink.format.dump.Dumper;
use mink.model.object;
use mink.model.object.Object;
use mink.model.target.Target;

# an input: its name, for every failure, and its bytes, borrowed for as long
# as any model read from it lives
pub rec Input {
    file: str;
    data: *u8;
    len:  usize;
}

# the bytes at `offset` that identify a format's files, compared under `mask`,
# where a nil mask compares every bit
pub rec Magic {
    offset: usize;
    bytes:  *u8;
    mask:   *u8;
    len:    usize;
}

# rows:  the magics, static
# count: how many
pub rec Magics {
    rows:  *Magic;
    count: usize;
}

# whether an input is a file of the format, for a format no fixed bytes tell
# apart, such as a linker script
pub def Probe: fun(*Input) bool;

# how a format's files are told apart from every other format's
# ---
# magics: fixed bytes, which every registered format's magics tell apart
# probe:  a test of the input, run only when no magic matches
pub tag Identify: u8 {
    magics: Magics;
    probe:  Probe;
}

# the exact revision of one specification a format implements
pub rec Revision {
    spec:     str;
    revision: str;
}

# the reference tool's flags a format's dump is compared with, beyond the ones
# every format is compared with
# ---
# flags: each flag, one string each, valid while the registration lives
# count: how many
pub rec Reference {
    flags: *str;
    count: usize;
}

pub def ToNeutral:   fun(ptr, *Object) err[Fail];
pub def FromNeutral: fun(*A.Allocator, *Object, *Target) res[ptr, Fail];
pub def Lower:       fun(*Object) err[Fail];

# what a format module does with its own files, over its own model behind an
# opaque pointer
# ---
# identify: how its files are told apart
# read:     parse an input into a model, refusing what the specification
#           forbids with a located failure
# write:    lay a model out through the layout plan and return its bytes, in
#           a sink the format builds in its own byte order
# dump:     describe a model, field by field in model order
# kind:     the kind of file a model is, refusing a file whose kind the format
#           cannot tell without guessing
# locate:   the model record holding byte `offset` of the bytes the model
#           reads and writes, its offset placed, and a nil record for an
#           offset no record covers
# release:  give back everything a model owns
pub rec Codec {
    identify: Identify;
    read:     fun(*A.Allocator, *Input) res[ptr, Fail];
    write:    fun(*A.Allocator, ptr) res[Sink, Fail];
    dump:     fun(ptr, *Dumper) err[Fail];
    kind:     fun(ptr) res[*Kind, Fail];
    locate:   fun(ptr, u64) Location;
    release:  fun(*A.Allocator, ptr) err[Fail];
}

# how a format converts its objects to neutral objects and back
# ---
# to:   add what a model of a kind a link takes as an object holds to an empty
#       neutral object, which a refusal leaves empty
# from: build a model from a neutral object for the target `t`
pub rec Neutral {
    to:   ToNeutral;
    from: FromNeutral;
}

# how a format encodes the records a neutral object states, such as line
# sequences
# ---
# lower: turn the records into the object's sections and relocations in place,
#        which a refusal leaves as it was
pub rec Lowering {
    lower: Lower;
}

# how a format encodes the trait axes an object states. the rows that fill it
# come later, so no registration names one yet
pub rec TraitCodec {}

# one file a container holds
# ---
# name:  its name in the container, valid while the container's model lives
# input: its bytes, named by the container's file
# arch:  the architecture it is for, as the container's fields code it, for a
#        member chosen by architecture rather than by the symbols it defines
pub rec Member {
    name:  Bytes;
    input: Input;
    arch:  opt[Stated];
}

# append to `out` the ids, as members issues them, of the members that define
# the symbol `name`, answering false when the container carries no index
pub def Index: fun(ptr, Bytes, *Table[Id[Member]]) res[bool, Fail];

# what a container format does besides its codec
# ---
# members: append every member to `out` in container order, each input named
#          by the container's file
# index:   the members defining a symbol, none for a format that never
#          carries an index. a container without one is scanned instead
pub rec Container {
    members: fun(ptr, str, *Table[Member]) err[Fail];
    index:   opt[Index];
}

# what reading a format's files takes, as its registration names it
# ---
# format:      the format's identity
# codec:       its codec
# neutral:     its conversion, none for a format that has none
# container:   its member operations, none for a format whose files hold no
#              other files
# fields:      the names its dump prints, indexed by the module's field keys
# field_count: how many
pub rec Reader {
    format:      *Format;
    codec:       *Codec;
    neutral:     opt[*Neutral];
    container:   opt[*Container];
    fields:      *str;
    field_count: usize;
}

# a model read or built by a registered format
# ---
# reader: what its format reads with
# a:      the allocator it lives in
# data:   the format's own model
pub rec Model {
    reader: *Reader;
    a:      *A.Allocator;
    data:   ptr;
}

pub fun write(m: *Model) res[Sink, Fail] {
    ret m.reader.codec.write(m.a, m.data);
}

# the dump of `m`, appended to `out`
pub fun describe(m: *Model, out: *Sink) err[Fail] {
    var d: Dumper = dump.make(out, m.reader.fields, m.reader.field_count);
    ret m.reader.codec.dump(m.data, ?d);
}

# where in `m` byte `offset` falls
pub fun locate(m: *Model, offset: u64) Location {
    ret m.reader.codec.locate(m.data, offset);
}

# the kind of file `m` is
pub fun kind(m: *Model) res[*Kind, Fail] {
    ret m.reader.codec.kind(m.data);
}

# whether the format `r` reads with converts its objects to neutral objects
# and back
pub fun converts(r: *Reader) bool {
    ret sel r.neutral.some;
}

# add what `m` holds to the empty neutral object `o`, refusing a model of a
# kind a link does not take as an object
pub fun to_neutral(m: *Model, o: *Object) err[Fail] {
    val k: res[*Kind, Fail] = kind(m);
    if (sel k.err) { ret err[Fail].err{k.err}; }
    if (!catalog_kind.has(k.ok, catalog_kind.OBJECT)) {
        ret err[Fail].err{fail.about(fail.unsupported("a kind a link does not take as an object has no neutral form"), k.ok.name)};
    }
    val n: opt[*Neutral] = m.reader.neutral;
    if (sel n.none) { ret err[Fail].err{not_converted(m.reader.format)}; }
    ret n.some.to(m.data, o);
}

# the model of the format `r` reads with that holds the neutral object `o`,
# built for the target `o` states
pub fun from_neutral(r: *Reader, a: *A.Allocator, o: *Object) res[Model, Fail] {
    val n: opt[*Neutral] = r.neutral;
    if (sel n.none) { ret res[Model, Fail].err{not_converted(r.format)}; }
    val data: res[ptr, Fail] = n.some.from(a, o, ?o.target);
    if (sel data.err) { ret res[Model, Fail].err{data.err}; }
    ret res[Model, Fail].ok{Model{reader: r, a: a, data: data.ok}};
}

# lower the records `o` states in place through `l`, the lowering of the
# format `f`. an object with no records passes as it is, and one with records
# a format has no encoding of is refused
pub fun lower(f: *Format, l: opt[*Lowering], o: *Object) err[Fail] {
    if (!object.has_records(o)) { ret err[Fail].ok{}; }
    if (sel l.none)             { ret err[Fail].err{fail.in_record(fail.unsupported("the format has no encoding of the records the object states"), f.name)}; }
    ret l.some.lower(o);
}

pub fun release(m: *Model) err[Fail] {
    val data: ptr = m.data;
    m.data = nil;
    if (data == nil) { ret err[Fail].ok{}; }
    ret m.reader.codec.release(m.a, data);
}

# whether the format of `m` holds other files
pub fun is_container(m: *Model) bool {
    val c: opt[*Container] = m.reader.container;
    ret sel c.some;
}

# append the members of `m`, the container named `file`, to `out`. a model of
# a format that is not a container has none to give and is refused
pub fun members(m: *Model, file: str, out: *Table[Member]) err[Fail] {
    val c: opt[*Container] = m.reader.container;
    if (sel c.none) { ret err[Fail].err{not_container(m, file)}; }
    val r: err[Fail] = c.some.members(m.data, file, out);
    if (sel r.err) { ret err[Fail].err{fail.in_file(r.err, file)}; }
    ret r;
}

# append to `out` the members of `m`, the container named `file`, that define
# the symbol `name`, answering false when `m` carries no index, so its members
# are scanned instead
pub fun defining(m: *Model, file: str, name: Bytes, out: *Table[Id[Member]]) res[bool, Fail] {
    val c: opt[*Container] = m.reader.container;
    if (sel c.none) { ret res[bool, Fail].err{not_container(m, file)}; }
    val index: opt[Index] = c.some.index;
    if (sel index.none) { ret res[bool, Fail].ok{false}; }
    val r: res[bool, Fail] = index.some(m.data, name, out);
    if (sel r.err) { ret res[bool, Fail].err{fail.in_file(r.err, file)}; }
    ret r;
}

fun not_container(m: *Model, file: str) Fail {
    ret fail.in_file(fail.in_record(fail.unsupported("the format does not hold other files"), m.reader.format.name), file);
}

fun not_converted(f: *Format) Fail {
    ret fail.in_record(fail.unsupported("the format has no neutral conversion"), f.name);
}
