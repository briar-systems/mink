# the contract every format module fills
#
# a format is one module and one registration. the module owns its complete
# model, which holds every byte of an input so a read and a write give back
# the same bytes, and reaches the rest of mink only through its registration:
# the operations below, the magic that identifies its files, the revision of
# each specification it implements and the names its dump prints.
#
# every model answers its kind, a row of the kind catalog, and whoever takes
# the input asks that row's capabilities. a container, a file that holds other
# files, declares its member operations beside the rest. a member answers its
# own kind and converts through its own format, so a container has no neutral
# form of its own.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.catalog.arch.Arch;
use mink.catalog.format.Code;
use mink.catalog.format.Format;
use catalog_kind: mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.catalog.trait.Axis;
use mink.fail;
use mink.fail.Fail;
use mink.fail.Location;
use mink.format.dump;
use mink.format.dump.Dumper;
use mink.model.object.Object;
use mink.sink.Sink;
use mink.store.Bytes;
use mink.table;
use mink.table.Id;
use mink.table.Table;

# an input: its name, for every failure, and its bytes, borrowed for as long
# as any model read from it lives
pub rec Input {
    file: str;
    data: *u8;
    len:  usize;
}

# the bytes at `offset` that identify a format's files, compared under `mask`,
# where a nil mask compares every bit
pub rec Magic {
    offset: usize;
    bytes:  *u8;
    mask:   *u8;
    len:    usize;
}

# the exact revision of one specification a format implements
pub rec Revision {
    spec:     str;
    revision: str;
}

pub def ToNeutral:   fun(ptr, *Object) err[Fail];
pub def FromNeutral: fun(*A.Allocator, *Object) res[ptr, Fail];

# a trait axis a format writes for an architecture
# ---
# axis:     the axis
# required: whether every file must state it, as the format reads a file that
#           leaves it out as stating a value
pub rec Encoded {
    axis:     *Axis;
    required: bool;
}

# append to `out` every trait axis the format writes for an architecture,
# answered from the rows its writer encodes with, refusing an architecture
# the format cannot hold
pub def Encodes: fun(*Arch, *Table[Encoded]) err[Fail];

# what a format module does, over its own model behind an opaque pointer
# ---
# read:         parse an input into a model, refusing what the specification
#               forbids with a located failure
# write:        lay a model out through the layout plan and return its bytes,
#               in a sink the format builds in its own byte order
# dump:         describe a model, field by field in model order
# kind:         the kind of file a model is, refusing a file whose kind the
#               format cannot tell without guessing
# to_neutral:   add what a model of a kind a link takes as an object holds to
#               an empty neutral object, which a refusal leaves empty. none for
#               a format whose conversion is not built or that has no objects
# from_neutral: build a model from a neutral object, none as for to_neutral
# encodes:      the trait axes the format writes for an architecture, none
#               for a format that writes no objects. a format whose writer
#               encodes no traits yet refuses rather than answering none
# locate:       the model record holding byte `offset` of the bytes the model
#               reads and writes, its offset placed, and a nil record for an
#               offset no record covers
# release:      give back everything a model owns
pub rec Ops {
    read:         fun(*A.Allocator, *Input) res[ptr, Fail];
    write:        fun(*A.Allocator, ptr) res[Sink, Fail];
    dump:         fun(ptr, *Dumper) err[Fail];
    kind:         fun(ptr) res[*Kind, Fail];
    to_neutral:   opt[ToNeutral];
    from_neutral: opt[FromNeutral];
    encodes:      opt[Encodes];
    locate:       fun(ptr, u64) Location;
    release:      fun(*A.Allocator, ptr) err[Fail];
}

# one file a container holds
# ---
# name:  its name in the container, valid while the container's model lives
# input: its bytes, named by the container's file
# arch:  the architecture it is for, as the container codes it, for a member
#        chosen by architecture rather than by the symbols it defines
pub rec Member {
    name:  Bytes;
    input: Input;
    arch:  opt[Code];
}

# append to `out` the ids, as members issues them, of the members that define
# the symbol `name`, answering false when the container carries no index
pub def Index: fun(ptr, Bytes, *Table[Id[Member]]) res[bool, Fail];

# what a container format does besides its operations
# ---
# members: append every member to `out` in container order, each input named
#          by the container's file
# index:   the members defining a symbol, none for a format that never
#          carries an index. a container without one is scanned instead
pub rec Container {
    members: fun(ptr, str, *Table[Member]) err[Fail];
    index:   opt[Index];
}

# the reference tool's flags a format's dump is compared with, beyond the ones
# every format is compared with
# ---
# flags: each flag, one string each, valid while the registration lives
# count: how many
pub rec Reference {
    flags: *str;
    count: usize;
}

# format:         the format's identity row
# ops:            what the module does
# magics:         every magic that identifies its files
# magic_count:    how many
# revisions:      the specifications it implements, at their exact revision
# revision_count: how many
# fields:         the names its dump prints, indexed by the module's own field keys
# field_count:    how many
# container:      the member operations of a format whose files hold other
#                 files, none for the rest
# reference:      the reference flags the format's dump is compared with, none for
#                 a format compared with the common flags alone
pub rec Registration {
    format:         *Format;
    ops:            Ops;
    magics:         *Magic;
    magic_count:    usize;
    revisions:      *Revision;
    revision_count: usize;
    fields:         *str;
    field_count:    usize;
    container:      opt[Container];
    reference:      opt[Reference];
}

# a model read or built by a registered format
# ---
# reg:  the format it belongs to
# a:    the allocator it lives in
# data: the format's own model
pub rec Model {
    reg:  *Registration;
    a:    *A.Allocator;
    data: ptr;
}

pub fun write(m: *Model) res[Sink, Fail] {
    ret m.reg.ops.write(m.a, m.data);
}

# the dump of `m`, appended to `out`
pub fun describe(m: *Model, out: *Sink) err[Fail] {
    var d: Dumper = dump.make(out, m.reg.fields, m.reg.field_count);
    ret m.reg.ops.dump(m.data, ?d);
}

# where in `m` byte `offset` falls
pub fun locate(m: *Model, offset: u64) Location {
    ret m.reg.ops.locate(m.data, offset);
}

# the kind of file `m` is
pub fun kind(m: *Model) res[*Kind, Fail] {
    ret m.reg.ops.kind(m.data);
}

# whether the format `reg` converts its objects to neutral objects and back
pub fun converts(reg: *Registration) bool {
    val to:   opt[ToNeutral]   = reg.ops.to_neutral;
    val from: opt[FromNeutral] = reg.ops.from_neutral;
    ret sel to.some && sel from.some;
}

# add what `m` holds to the empty neutral object `o`, refusing a model of a
# kind a link does not take as an object
pub fun to_neutral(m: *Model, o: *Object) err[Fail] {
    val k: res[*Kind, Fail] = kind(m);
    if (sel k.err) { ret err[Fail].err{k.err}; }
    if (!catalog_kind.has(k.ok, catalog_kind.OBJECT)) {
        ret err[Fail].err{fail.about(fail.unsupported("a kind a link does not take as an object has no neutral form"), k.ok.name)};
    }
    val to: opt[ToNeutral] = m.reg.ops.to_neutral;
    if (sel to.none) { ret err[Fail].err{not_converted(m.reg)}; }
    ret to.some(m.data, o);
}

# the model of format `reg` that holds the neutral object `o`
pub fun from_neutral(reg: *Registration, a: *A.Allocator, o: *Object) res[Model, Fail] {
    val from: opt[FromNeutral] = reg.ops.from_neutral;
    if (sel from.none) { ret res[Model, Fail].err{not_converted(reg)}; }
    val data: res[ptr, Fail] = from.some(a, o);
    if (sel data.err) { ret res[Model, Fail].err{data.err}; }
    ret res[Model, Fail].ok{Model{reg: reg, a: a, data: data.ok}};
}

# append to `out` every trait axis the format `reg` writes for `a`, each with
# whether a file must state it. a refusal names the format and leaves `out` as
# it was
pub fun encodes(reg: *Registration, a: *Arch, out: *Table[Encoded]) err[Fail] {
    val q: opt[Encodes] = reg.ops.encodes;
    if (sel q.none) { ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the format writes no objects"), reg.format.name), a.name)}; }
    val mark: usize     = table.count[Encoded](out);
    val r:    err[Fail] = q.some(a, out);
    if (sel r.err) {
        table.truncate[Encoded](out, mark);
        ret err[Fail].err{fail.in_record(r.err, reg.format.name)};
    }
    ret r;
}

pub fun release(m: *Model) err[Fail] {
    val data: ptr = m.data;
    m.data = nil;
    if (data == nil) { ret err[Fail].ok{}; }
    ret m.reg.ops.release(m.a, data);
}

# whether the format of `m` holds other files
pub fun is_container(m: *Model) bool {
    val c: opt[Container] = m.reg.container;
    ret sel c.some;
}

# append the members of `m`, the container named `file`, to `out`. a model of
# a format that is not a container has none to give and is refused
pub fun members(m: *Model, file: str, out: *Table[Member]) err[Fail] {
    val c: opt[Container] = m.reg.container;
    if (sel c.none) { ret err[Fail].err{not_container(m, file)}; }
    val r: err[Fail] = c.some.members(m.data, file, out);
    if (sel r.err) { ret err[Fail].err{fail.in_file(r.err, file)}; }
    ret r;
}

# append to `out` the members of `m`, the container named `file`, that define
# the symbol `name`, answering false when `m` carries no index, so its members
# are scanned instead
pub fun defining(m: *Model, file: str, name: Bytes, out: *Table[Id[Member]]) res[bool, Fail] {
    val c: opt[Container] = m.reg.container;
    if (sel c.none) { ret res[bool, Fail].err{not_container(m, file)}; }
    val index: opt[Index] = c.some.index;
    if (sel index.none) { ret res[bool, Fail].ok{false}; }
    val r: res[bool, Fail] = index.some(m.data, name, out);
    if (sel r.err) { ret res[bool, Fail].err{fail.in_file(r.err, file)}; }
    ret r;
}

fun not_container(m: *Model, file: str) Fail {
    ret fail.in_file(fail.in_record(fail.unsupported("the format does not hold other files"), m.reg.format.name), file);
}

fun not_converted(reg: *Registration) Fail {
    ret fail.in_record(fail.unsupported("the format has no neutral conversion"), reg.format.name);
}
