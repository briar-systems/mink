# the COFF section each neutral section kind is written as
#
# one row per kind COFF can name, looked up by the kind's name, stating the
# name a section that states only its kind takes and its characteristics.
# relro data has no section of its own and is read-only data, as the loader
# applies relocations before it protects the section. thread-local data, with
# or without bytes, is the .tls$ template. COFF has no table of functions run
# at exit or before every initializer, its unwind tables and debugging
# sections say by name which they are, and it has no notes, metadata or
# sections a link takes rather than lays out, so those kinds have no row and a
# nameless section of one is refused.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.format.coff.model.tables;
use mink.model.section;

# kind:            the neutral kind
# name:            the name a section of the kind that states none takes
# characteristics: the section characteristics it is written with, its
#                  alignment aside
pub rec Row {
    kind:            *section.Kind;
    name:            str;
    characteristics: u64;
}

val CODE:  u64 = tables.IMAGE_SCN_CNT_CODE.value | tables.IMAGE_SCN_MEM_EXECUTE.value | tables.IMAGE_SCN_MEM_READ.value;
val CONST: u64 = tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value;
val DATA:  u64 = tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value | tables.IMAGE_SCN_MEM_WRITE.value;
val ZERO:  u64 = tables.IMAGE_SCN_CNT_UNINITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value | tables.IMAGE_SCN_MEM_WRITE.value;

val TEXT_ROW:       Row = Row{kind: ?section.TEXT, name: ".text", characteristics: CODE};
val RODATA_ROW:     Row = Row{kind: ?section.RODATA, name: ".rdata", characteristics: CONST};
val DATA_ROW:       Row = Row{kind: ?section.DATA, name: ".data", characteristics: DATA};
val RELRO_ROW:      Row = Row{kind: ?section.RELRO_DATA, name: ".rdata", characteristics: CONST};
val BSS_ROW:        Row = Row{kind: ?section.BSS, name: ".bss", characteristics: ZERO};
val TLS_DATA_ROW:   Row = Row{kind: ?section.TLS_DATA, name: ".tls$", characteristics: DATA};
val TLS_BSS_ROW:    Row = Row{kind: ?section.TLS_BSS, name: ".tls$", characteristics: DATA};
val INIT_ARRAY_ROW: Row = Row{kind: ?section.INIT_ARRAY, name: ".CRT$XCU", characteristics: CONST};

val ROW_COUNT: usize           = 8;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{
    ?TEXT_ROW, ?RODATA_ROW, ?DATA_ROW, ?RELRO_ROW, ?BSS_ROW, ?TLS_DATA_ROW, ?TLS_BSS_ROW, ?INIT_ARRAY_ROW,
};

# the rows ascending by kind name
val KINDS: [ROW_COUNT]*Row = [ROW_COUNT]*Row{
    ?BSS_ROW, ?DATA_ROW, ?INIT_ARRAY_ROW, ?RELRO_ROW, ?RODATA_ROW, ?TLS_BSS_ROW, ?TLS_DATA_ROW, ?TEXT_ROW,
};

# the kinds COFF has no row for
val REFUSED_COUNT: usize                        = 11;
val REFUSED:       [REFUSED_COUNT]*section.Kind = [REFUSED_COUNT]*section.Kind{
    ?section.FINI_ARRAY, ?section.PREINIT_ARRAY, ?section.UNWIND_INFO, ?section.NOTE_INFO, ?section.DEBUG_INFO, ?section.METADATA,
    ?section.ADDRSIG_TABLE, ?section.COMMENT_STRINGS, ?section.STACK_NOTE, ?section.UNWIND_RECORDS, ?section.LINK_WARNING,
};

fun order(a: **Row, b: **Row) i64 {
    ret str_compare(a[0].kind.name, b[0].kind.name);
}

# the row of kind `k`
pub fun row_of(k: *section.Kind) res[*Row, Fail] {
    var probe: Row       = Row{kind: k};
    val row:   opt[*Row] = index.find[Row](?KINDS[0], ROW_COUNT, ?probe, order);
    if (sel row.none) { ret res[*Row, Fail].err{fail.about(fail.unsupported("COFF has no section for this kind"), k.name)}; }
    ret res[*Row, Fail].ok{row.some};
}

# the name a section of kind `k` that states none is written with
pub fun name_of(k: *section.Kind) res[str, Fail] {
    val row: res[*Row, Fail] = row_of(k);
    if (sel row.err) { ret res[str, Fail].err{row.err}; }
    ret res[str, Fail].ok{row.ok.name};
}

test naming__every_kind_has_one_row_or_is_refused {
    val rows:  [ROW_COUNT]*Row = ROWS;
    val built: err[Fail]       = index.verify[Row](?KINDS[0], ROW_COUNT, ?rows[0], ROW_COUNT, order);
    if (sel built.err) { ret 1; }
    var kinds: [ROW_COUNT + REFUSED_COUNT]*section.Kind;
    var i:     usize = 0;
    for (i < ROW_COUNT) {
        kinds[i] = ROWS[i].kind;
        i        = i + 1;
    }
    var j: usize = 0;
    for (j < REFUSED_COUNT) {
        kinds[ROW_COUNT + j] = REFUSED[j];
        val refused: res[str, Fail] = name_of(REFUSED[j]);
        if (!sel refused.err)                   { ret 3; }
        if (!sel refused.err.cause.unsupported) { ret 3; }
        j = j + 1;
    }
    if (!section.once_each(?kinds[0], ROW_COUNT + REFUSED_COUNT)) { ret 2; }
    ret 0;
}
