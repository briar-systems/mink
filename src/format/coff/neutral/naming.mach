# the COFF section each neutral section kind is written as
#
# one row per kind COFF can name, looked up by the kind's name, stating the
# name a section that states only its kind takes and its characteristics.
# relro data has no section of its own and is read-only data, as the loader
# applies relocations before it protects the section. thread-local data, with
# or without bytes, is the .tls$ template. COFF has no table of functions run
# at exit or before every initializer, its unwind tables and debugging
# sections say by name which they are, and it has no notes, metadata or
# sections a link takes rather than lays out, so those kinds have no row and a
# nameless section of one is refused. COFF has no merge section: MSVC merges a
# string or constant by giving each its own select-any COMDAT .rdata section
# named for its contents, a section and a symbol per entry that no name of one
# section states. so the borrowed rows give merged strings and constants of
# every size as plain read-only data, as clang does for windows-gnu, which a
# link lays out unmerged.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_len;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.store.Bytes;
use mink.format.coff.model.tables;
use mink.format.contract;
use mink.format.contract.Borrowed;
use mink.format.contract.Naming;
use mink.model.section;

# kind:            the neutral kind
# name:            the name a section of the kind that states none takes
# characteristics: the section characteristics it is written with, its
#                  alignment aside
pub rec Row {
    kind:            *section.Kind;
    name:            str;
    characteristics: u64;
}

val CODE:  u64 = tables.IMAGE_SCN_CNT_CODE.value | tables.IMAGE_SCN_MEM_EXECUTE.value | tables.IMAGE_SCN_MEM_READ.value;
val CONST: u64 = tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value;
val DATA:  u64 = tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value | tables.IMAGE_SCN_MEM_WRITE.value;
val ZERO:  u64 = tables.IMAGE_SCN_CNT_UNINITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value | tables.IMAGE_SCN_MEM_WRITE.value;

val TEXT_ROW:       Row = Row{kind: ?section.TEXT, name: ".text", characteristics: CODE};
val RODATA_ROW:     Row = Row{kind: ?section.RODATA, name: ".rdata", characteristics: CONST};
val DATA_ROW:       Row = Row{kind: ?section.DATA, name: ".data", characteristics: DATA};
val RELRO_ROW:      Row = Row{kind: ?section.RELRO_DATA, name: ".rdata", characteristics: CONST};
val BSS_ROW:        Row = Row{kind: ?section.BSS, name: ".bss", characteristics: ZERO};
val TLS_DATA_ROW:   Row = Row{kind: ?section.TLS_DATA, name: ".tls$", characteristics: DATA};
val TLS_BSS_ROW:    Row = Row{kind: ?section.TLS_BSS, name: ".tls$", characteristics: DATA};
val INIT_ARRAY_ROW: Row = Row{kind: ?section.INIT_ARRAY, name: ".CRT$XCU", characteristics: CONST};

val ROW_COUNT: usize           = 8;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{
    ?TEXT_ROW, ?RODATA_ROW, ?DATA_ROW, ?RELRO_ROW, ?BSS_ROW, ?TLS_DATA_ROW, ?TLS_BSS_ROW, ?INIT_ARRAY_ROW,
};

# the rows ascending by kind name
val KINDS: [ROW_COUNT]*Row = [ROW_COUNT]*Row{
    ?BSS_ROW, ?DATA_ROW, ?INIT_ARRAY_ROW, ?RELRO_ROW, ?RODATA_ROW, ?TLS_BSS_ROW, ?TLS_DATA_ROW, ?TEXT_ROW,
};

# the rows a name spells, ascending by it, for the convention that a section
# named so, or so and then a dollar sign and a group, takes the row's kind.
# relro data is written as read-only data and zero-filled thread-local data
# as its template, so a name reads back as those rows' kinds
val NAME_COUNT: usize            = 6;
val NAMES:      [NAME_COUNT]*Row = [NAME_COUNT]*Row{?INIT_ARRAY_ROW, ?BSS_ROW, ?DATA_ROW, ?RODATA_ROW, ?TEXT_ROW, ?TLS_DATA_ROW};

val PLAIN: str = "clang 23 for windows-gnu, which writes mergeable strings and constants of every size to plain .rdata";

# the keys COFF merges in no section, each written as plain read-only data,
# ascending by kind name, then by element size
val BORROWED_COUNT: usize                         = 7;
val BORROWED:       [BORROWED_COUNT]Borrowed[Row] = [BORROWED_COUNT]Borrowed[Row]{
    Borrowed[Row]{kind: ?section.MERGED_CONSTANTS, entsize: 4, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_CONSTANTS, entsize: 8, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_CONSTANTS, entsize: 16, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_CONSTANTS, entsize: 32, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_STRINGS, entsize: 1, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_STRINGS, entsize: 2, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_STRINGS, entsize: 4, as: ?RODATA_ROW, source: PLAIN},
};

# the keys COFF has no row for
val REFUSED_COUNT: usize                      = 11;
val REFUSED:       [REFUSED_COUNT]section.Key = [REFUSED_COUNT]section.Key{
    section.Key{kind: ?section.FINI_ARRAY}, section.Key{kind: ?section.PREINIT_ARRAY}, section.Key{kind: ?section.UNWIND_INFO},
    section.Key{kind: ?section.NOTE_INFO}, section.Key{kind: ?section.DEBUG_INFO}, section.Key{kind: ?section.METADATA},
    section.Key{kind: ?section.ADDRSIG_TABLE}, section.Key{kind: ?section.COMMENT_STRINGS}, section.Key{kind: ?section.STACK_NOTE},
    section.Key{kind: ?section.UNWIND_RECORDS}, section.Key{kind: ?section.LINK_WARNING},
};

fun order(a: **Row, b: **Row) i64 {
    ret str_compare(a[0].kind.name, b[0].kind.name);
}

# the row a section of key `k` is written by: its kind's, or for a key COFF
# does not merge, the row its borrowed row names
pub fun row_of(k: section.Key) res[*Row, Fail] {
    if (section.keyed(k.kind)) {
        val plain: opt[*Borrowed[Row]] = contract.borrowed_of[Row](?BORROWED[0], BORROWED_COUNT, k);
        if (sel plain.none) { ret res[*Row, Fail].err{fail.valued(fail.about(fail.unsupported("COFF has no section for this kind and element size"), k.kind.name), k.entsize::i128)}; }
        ret res[*Row, Fail].ok{plain.some.as};
    }
    var probe: Row       = Row{kind: k.kind};
    val row:   opt[*Row] = index.find[Row](?KINDS[0], ROW_COUNT, ?probe, order);
    if (sel row.none) { ret res[*Row, Fail].err{fail.about(fail.unsupported("COFF has no section for this kind"), k.kind.name)}; }
    ret res[*Row, Fail].ok{row.some};
}

# the name a section of key `k` that states none is written with
pub fun name_of(k: section.Key) res[str, Fail] {
    val row: res[*Row, Fail] = row_of(k);
    if (sel row.err) { ret res[str, Fail].err{row.err}; }
    ret res[str, Fail].ok{row.ok.name};
}

fun spelling(r: *Row) str {
    ret r.name;
}

# the key a section named `name` takes by the convention
pub fun kind_of(name: Bytes) opt[section.Key] {
    val r: opt[*Row] = contract.spelled[Row](?NAMES[0], NAME_COUNT, name, '$', spelling);
    if (sel r.none) { ret opt[section.Key].none{}; }
    ret opt[section.Key].some{section.Key{kind: r.some.kind}};
}

# the key of a section named `name`, as a naming row spells the name. COFF
# has no section type and no reader that classifies a section by its header,
# so `type`, `flags` and `entsize` are not read and a name no row spells is
# refused
pub fun kind_for(name: Bytes, type: str, flags: section.Flags, entsize: u64) res[section.Key, Fail] {
    val k: opt[section.Key] = kind_of(name);
    if (sel k.none) { ret res[section.Key, Fail].err{fail.unsupported("COFF classifies no section by its header, and no naming row spells the name")}; }
    ret res[section.Key, Fail].ok{k.some};
}

# how COFF names sections, for the registration
pub val NAMING: Naming = Naming{kind_of: kind_of, kind_for: kind_for, name_of: name_of};

test naming__every_key_has_one_row_or_is_refused {
    val rows:  [ROW_COUNT]*Row = ROWS;
    val built: err[Fail]       = index.verify[Row](?KINDS[0], ROW_COUNT, ?rows[0], ROW_COUNT, order);
    if (sel built.err) { ret 1; }
    var keys: [ROW_COUNT + BORROWED_COUNT + REFUSED_COUNT]section.Key;
    var i:    usize = 0;
    for (i < ROW_COUNT) {
        keys[i] = section.Key{kind: ROWS[i].kind};
        i       = i + 1;
    }
    # a merged key is written as plain read-only data, and reads back as it
    if (!contract.borrowed_sound[Row](?BORROWED[0], BORROWED_COUNT)) { ret 5; }
    var u: usize = 0;
    for (u < BORROWED_COUNT) {
        keys[ROW_COUNT + u] = contract.borrowed_key[Row](?BORROWED[u]);
        val named: res[str, Fail] = name_of(keys[ROW_COUNT + u]);
        if (sel named.err) { ret 5; }
        val back: opt[section.Key] = kind_of(Bytes{data: named.ok::*u8, len: str_len(named.ok)});
        if (sel back.none)                     { ret 5; }
        if (back.some.kind != ?section.RODATA) { ret 5; }
        u = u + 1;
    }
    var j: usize = 0;
    for (j < REFUSED_COUNT) {
        keys[ROW_COUNT + BORROWED_COUNT + j] = REFUSED[j];
        val refused: res[str, Fail] = name_of(REFUSED[j]);
        if (!sel refused.err)                   { ret 3; }
        if (!sel refused.err.cause.unsupported) { ret 3; }
        j = j + 1;
    }
    if (!section.once_each(?keys[0], ROW_COUNT + BORROWED_COUNT + REFUSED_COUNT)) { ret 2; }
    # the spelled rows ascend strictly, so each spelling has one kind
    var n: usize = 0;
    for (n < NAME_COUNT) {
        if (spelling(NAMES[n]) == nil)                                             { ret 4; }
        if (n > 0 && str_compare(spelling(NAMES[n - 1]), spelling(NAMES[n])) >= 0) { ret 4; }
        n = n + 1;
    }
    ret 0;
}
