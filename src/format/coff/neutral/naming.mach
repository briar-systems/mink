# the COFF section each neutral section kind is written as, and the kind the
# reader gives each section it reads
#
# one row per kind COFF can name, looked up by the kind's name, stating the
# name a section that states only its kind takes and its characteristics.
# relro data has no section of its own and is read-only data, as the loader
# applies relocations before it protects the section. thread-local data, with
# or without bytes, is the .tls$ template. the function table is .pdata, the
# unwind data it points at .xdata, the address significance table
# .llvm_addrsig, and a resource directory tree and the data its leaves name
# .rsrc, as .rsrc$01 and .rsrc$02 hold them. COFF has no table of functions
# run at exit or before every initializer, its debugging sections say by name
# which they are, CodeView's .debug$ and DWARF's .debug_, and it has
# no notes, metadata, comment strings or stack and warning sections, so those
# kinds have no row and a nameless section of one is refused. COFF has no merge
# section: MSVC merges a string or constant by giving each its own select-any
# COMDAT .rdata section named for its contents, a section and a symbol per
# entry that no name of one section states. so the borrowed rows give merged
# strings and constants of every size as plain read-only data, as clang does
# for windows-gnu, which a link lays out unmerged. no section is merged by
# its relocations, so merged pointers have no row.
#
# the reader classifies a section by its content characteristic, then by its
# name, then by its other characteristics as neutral flags. uninitialized data
# is zero fill. a name row gives the kinds COFF tells by name, the resource
# sections and the C++ initializers the CRT runs from .CRT$XC among them, the
# directive section,
# the mink note section, and the tables of symbol indices the neutral object
# cannot carry. any other section is text when executable, data when writable,
# read-only data when the image keeps it, and metadata when the link removes
# or discards it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.store.Bytes;
use mink.format.coff.model.tables;
use coff_mark: mink.format.coff.neutral.mark;
use mink.format.contract;
use mink.format.contract.Borrowed;
use mink.format.contract.Naming;
use mink.model.section;

# kind:            the neutral kind
# name:            the name a section of the kind that states none takes
# characteristics: the section characteristics it is written with, its
#                  alignment aside
pub rec Row {
    kind:            *section.Kind;
    name:            str;
    characteristics: u64;
}

val CODE:  u64 = tables.IMAGE_SCN_CNT_CODE.value | tables.IMAGE_SCN_MEM_EXECUTE.value | tables.IMAGE_SCN_MEM_READ.value;
val CONST: u64 = tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value;
val DATA:  u64 = tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value | tables.IMAGE_SCN_MEM_WRITE.value;
val ZERO:  u64 = tables.IMAGE_SCN_CNT_UNINITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value | tables.IMAGE_SCN_MEM_WRITE.value;

val TEXT_ROW:       Row = Row{kind: ?section.TEXT, name: ".text", characteristics: CODE};
val RODATA_ROW:     Row = Row{kind: ?section.RODATA, name: ".rdata", characteristics: CONST};
val DATA_ROW:       Row = Row{kind: ?section.DATA, name: ".data", characteristics: DATA};
val RELRO_ROW:      Row = Row{kind: ?section.RELRO_DATA, name: ".rdata", characteristics: CONST};
val BSS_ROW:        Row = Row{kind: ?section.BSS, name: ".bss", characteristics: ZERO};
val TLS_DATA_ROW:   Row = Row{kind: ?section.TLS_DATA, name: ".tls$", characteristics: DATA};
val TLS_BSS_ROW:    Row = Row{kind: ?section.TLS_BSS, name: ".tls$", characteristics: DATA};
val INIT_ARRAY_ROW: Row = Row{kind: ?section.INIT_ARRAY, name: ".CRT$XCU", characteristics: CONST};
val PDATA_ROW:      Row = Row{kind: ?section.FUNCTION_TABLE, name: ".pdata", characteristics: CONST};
val XDATA_ROW:      Row = Row{kind: ?section.UNWIND_INFO, name: ".xdata", characteristics: CONST};
val ADDRSIG_ROW:    Row = Row{kind: ?section.ADDRSIG_TABLE, name: ".llvm_addrsig", characteristics: tables.IMAGE_SCN_LNK_REMOVE.value};
val RESOURCES_ROW:  Row = Row{kind: ?section.RESOURCE_TREE, name: ".rsrc", characteristics: CONST};

val ROW_COUNT: usize = 12;

# the rows ascending by kind name
val KINDS: [ROW_COUNT]*Row = [ROW_COUNT]*Row{
    ?ADDRSIG_ROW, ?BSS_ROW, ?DATA_ROW, ?PDATA_ROW, ?INIT_ARRAY_ROW, ?RELRO_ROW, ?RESOURCES_ROW, ?RODATA_ROW, ?TLS_BSS_ROW, ?TLS_DATA_ROW, ?TEXT_ROW,
    ?XDATA_ROW,
};

# the rows a name spells, ascending by it, for the convention that a section
# named so, or so and then a dollar sign and a group, takes the row's kind.
# relro data is written as read-only data and zero-filled thread-local data
# as its template, so a name reads back as those rows' kinds
val NAME_COUNT: usize            = 10;
val NAMES:      [NAME_COUNT]*Row = [NAME_COUNT]*Row{?INIT_ARRAY_ROW, ?BSS_ROW, ?DATA_ROW, ?ADDRSIG_ROW, ?PDATA_ROW, ?RODATA_ROW, ?RESOURCES_ROW, ?TEXT_ROW, ?TLS_DATA_ROW, ?XDATA_ROW};

val PLAIN: str = "clang 23 for windows-gnu, which writes mergeable strings and constants of every size to plain .rdata";

# the keys COFF merges in no section, each written as plain read-only data,
# ascending by kind name, then by element size
val BORROWED_COUNT: usize                         = 7;
val BORROWED:       [BORROWED_COUNT]Borrowed[Row] = [BORROWED_COUNT]Borrowed[Row]{
    Borrowed[Row]{kind: ?section.MERGED_CONSTANTS, entsize: 4, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_CONSTANTS, entsize: 8, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_CONSTANTS, entsize: 16, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_CONSTANTS, entsize: 32, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_STRINGS, entsize: 1, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_STRINGS, entsize: 2, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_STRINGS, entsize: 4, as: ?RODATA_ROW, source: PLAIN},
};

fun order(a: **Row, b: **Row) i64 {
    ret str_compare(a[0].kind.name, b[0].kind.name);
}

# the row a section of key `k` is written by: its kind's, or for a key COFF
# does not merge, the row its borrowed row names
pub fun row_of(k: section.Key) res[*Row, Fail] {
    if (section.keyed(k.kind)) {
        val plain: opt[*Borrowed[Row]] = contract.borrowed_of[Row](?BORROWED[0], BORROWED_COUNT, k);
        if (sel plain.none) { ret res[*Row, Fail].err{fail.valued(fail.about(fail.unsupported("COFF has no section for this kind and element size"), k.kind.name), k.entsize::i128)}; }
        ret res[*Row, Fail].ok{plain.some.as};
    }
    var probe: Row       = Row{kind: k.kind};
    val row:   opt[*Row] = index.find[Row](?KINDS[0], ROW_COUNT, ?probe, order);
    if (sel row.none) { ret res[*Row, Fail].err{fail.about(fail.unsupported("COFF has no section for this kind"), k.kind.name)}; }
    ret res[*Row, Fail].ok{row.some};
}

# the name a section of key `k` that states none is written with
pub fun name_of(k: section.Key) res[str, Fail] {
    val row: res[*Row, Fail] = row_of(k);
    if (sel row.err) { ret res[str, Fail].err{row.err}; }
    ret res[str, Fail].ok{row.ok.name};
}

fun spelling(r: *Row) str {
    ret r.name;
}

# the key a section named `name` takes by the convention
pub fun kind_of(name: Bytes) opt[section.Key] {
    val r: opt[*Row] = contract.spelled[Row](?NAMES[0], NAME_COUNT, name, '$', spelling);
    if (sel r.none) { ret opt[section.Key].none{}; }
    ret opt[section.Key].some{section.Key{kind: r.some.kind}};
}

# what a section is to a neutral object, by its content characteristic or
# its name
# ---
# named:     a neutral section whose name and flags set its kind
# kind:      a neutral section of this kind, or of thread-local zero fill for
#            zero fill a thread-local name row marks
# directive: no neutral section, as what it holds are the object's directives
# mark:      no neutral section, as it holds the mink note, whose ranges are
#            the object's
# refused:   no place in a neutral object, as the text states
pub tag Reads: u8 {
    named;
    kind: *section.Kind;
    directive;
    mark;
    refused: str;
}

# a content characteristic a section header may state and what it is
# ---
# word:  its name as a producer spells it, the characteristic's without the
#        IMAGE_SCN_ prefix
# bit:   the characteristic, zero for the row of a header that states none
# reads: what a section of it is
pub rec Type {
    word:  str;
    bit:   u64;
    reads: Reads;
}

# the types in the order a header stating several takes the first
val TYPE_COUNT: usize            = 5;
val TYPES:      [TYPE_COUNT]Type = [TYPE_COUNT]Type{
    Type{word: "lnk_info", bit: tables.IMAGE_SCN_LNK_INFO.value, reads: Reads.named{}},
    Type{word: "cnt_uninitialized_data", bit: tables.IMAGE_SCN_CNT_UNINITIALIZED_DATA.value, reads: Reads.kind{?section.BSS}},
    Type{word: "cnt_code", bit: tables.IMAGE_SCN_CNT_CODE.value, reads: Reads.named{}},
    Type{word: "cnt_initialized_data", bit: tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value, reads: Reads.named{}},
    Type{word: "none", bit: 0, reads: Reads.named{}},
};

# the type row of a header of the characteristics `ch`
pub fun type_of(ch: u64) *Type {
    var i: usize = 0;
    for (i + 1 < TYPE_COUNT) {
        if ((ch & TYPES[i].bit) != 0) { ret ?TYPES[i]; }
        i = i + 1;
    }
    ret ?TYPES[TYPE_COUNT - 1];
}

# the row of the type a producer spells `word`, none for none
fun spelled_type(word: str) opt[*Type] {
    var i: usize = 0;
    for (i < TYPE_COUNT) {
        if (str_equals(TYPES[i].word, word)) { ret opt[*Type].some{?TYPES[i]}; }
        i = i + 1;
    }
    ret opt[*Type].none{};
}

# the characteristics a section the link drops from the image states
val DROPPED: u64 = tables.IMAGE_SCN_LNK_INFO.value | tables.IMAGE_SCN_LNK_REMOVE.value | tables.IMAGE_SCN_MEM_DISCARDABLE.value;

# the neutral flags of a header of the characteristics `ch`: allocated unless
# the link drops it, excluded when the link removes it, writable and
# executable as its memory characteristics say. COFF states thread-local data
# by name, not by a flag
pub fun flags_of(ch: u64) section.Flags {
    var f: section.Flags = 0;
    if ((ch & DROPPED) == 0)                            { f = f | section.ALLOC; }
    if ((ch & tables.IMAGE_SCN_LNK_REMOVE.value) != 0)  { f = f | section.EXCLUDE; }
    if ((ch & tables.IMAGE_SCN_MEM_WRITE.value) != 0)   { f = f | section.WRITE; }
    if ((ch & tables.IMAGE_SCN_MEM_EXECUTE.value) != 0) { f = f | section.EXEC; }
    ret f;
}

# a section name that says what a section is, read after its type. no two
# rows take one name
# ---
# prefix: what the name starts with, or all of it when exact
# exact:  whether the name is the prefix alone
# reads:  what a section of the name is
# tls:    whether the name marks thread-local data
rec Named {
    prefix: str;
    exact:  bool;
    reads:  Reads;
    tls:    bool;
}

# a table whose entries are symbol table indices, which the neutral object
# renumbers
val INDICES: str = "the section holds symbol table indices, which a neutral object does not keep";

val NAMED_COUNT: usize              = 21;
val NAMED:       [NAMED_COUNT]Named = [NAMED_COUNT]Named{
    Named{prefix: ".drectve", exact: true, reads: Reads.directive{}},
    Named{prefix: coff_mark.SECTION, exact: true, reads: Reads.mark{}},
    Named{prefix: ".llvm_addrsig", exact: true, reads: Reads.kind{?section.ADDRSIG_TABLE}},
    Named{prefix: ".pdata", exact: true, reads: Reads.kind{?section.FUNCTION_TABLE}},
    Named{prefix: ".pdata$", exact: false, reads: Reads.kind{?section.FUNCTION_TABLE}},
    Named{prefix: ".xdata", exact: true, reads: Reads.kind{?section.UNWIND_INFO}},
    Named{prefix: ".xdata$", exact: false, reads: Reads.kind{?section.UNWIND_INFO}},
    Named{prefix: ".rsrc", exact: true, reads: Reads.kind{?section.RESOURCE_TREE}},
    Named{prefix: ".rsrc$", exact: false, reads: Reads.kind{?section.RESOURCE_TREE}},
    Named{prefix: ".tls", exact: true, reads: Reads.kind{?section.TLS_DATA}, tls: true},
    Named{prefix: ".tls$", exact: false, reads: Reads.kind{?section.TLS_DATA}, tls: true},
    Named{prefix: ".CRT$XC", exact: false, reads: Reads.kind{?section.INIT_ARRAY}},
    Named{prefix: ".debug$", exact: false, reads: Reads.kind{?section.DEBUG_INFO}},
    Named{prefix: ".debug_", exact: false, reads: Reads.kind{?section.DEBUG_INFO}},
    Named{prefix: ".sxdata", exact: true, reads: Reads.refused{INDICES}},
    Named{prefix: ".gfids$", exact: false, reads: Reads.refused{INDICES}},
    Named{prefix: ".giats$", exact: false, reads: Reads.refused{INDICES}},
    Named{prefix: ".gljmp$", exact: false, reads: Reads.refused{INDICES}},
    Named{prefix: ".gehcont$", exact: false, reads: Reads.refused{INDICES}},
    Named{prefix: ".llvm.call-graph-profile", exact: true, reads: Reads.refused{INDICES}},
    Named{prefix: ".llvm_sympart", exact: true, reads: Reads.refused{"symbol partitions are not carried by a neutral object"}},
};

fun starts(name: Bytes, prefix: str) bool {
    val n: usize = str_len(prefix);
    if (name.len < n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (name.data[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the name row of `name`, none for a name no row takes
fun named(name: Bytes) opt[*Named] {
    var i: usize = 0;
    for (i < NAMED_COUNT) {
        val r: *Named = ?NAMED[i];
        if (starts(name, r.prefix) && (!r.exact || name.len == str_len(r.prefix))) { ret opt[*Named].some{r}; }
        i = i + 1;
    }
    ret opt[*Named].none{};
}

# the key of a section named `name` of the content characteristic a producer
# spells `type`, the neutral flags `flags` and the element size `entsize`, as
# the reader gives a section of that header. a word no type row spells is
# refused naming it, valid while `type` lives, and so are a thread-local flag,
# which COFF states by name alone, and an element size, which a COFF header
# never states
pub fun kind_for(name: Bytes, type: str, flags: section.Flags, entsize: u64) res[section.Key, Fail] {
    val t: opt[*Type] = spelled_type(type);
    if (sel t.none)                 { ret res[section.Key, Fail].err{fail.about(fail.unsupported("COFF has no content characteristic of this name"), type)}; }
    if ((flags & section.TLS) != 0) { ret res[section.Key, Fail].err{fail.unsupported("COFF states thread-local data by the .tls$ name, not by a flag")}; }
    if (entsize != 0)               { ret res[section.Key, Fail].err{fail.valued(fail.unsupported("a COFF section header states no element size"), entsize::i128)}; }
    val k: res[*section.Kind, Fail] = classify(name, t.some, flags);
    if (sel k.err) { ret res[section.Key, Fail].err{k.err}; }
    ret res[section.Key, Fail].ok{section.Key{kind: k.ok}};
}

# the kind the reader gives a section named `name` of the type row `t` and
# the neutral flags `flags`: zero fill by its type, then by its name, then by
# its flags. a section that is no neutral section is refused
pub fun classify(name: Bytes, t: *Type, flags: section.Flags) res[*section.Kind, Fail] {
    val n: opt[*Named] = named(name);
    if (sel n.some) {
        val r: *Named = n.some;
        if (sel r.reads.directive) { ret res[*section.Kind, Fail].err{fail.unsupported("the directive section is no neutral section, as what it holds are the object's directives")}; }
        if (sel r.reads.mark)      { ret res[*section.Kind, Fail].err{fail.unsupported("the mink note section is no neutral section, as its ranges are the object's")}; }
        if (sel r.reads.refused)   { ret res[*section.Kind, Fail].err{fail.about(fail.unsupported(r.reads.refused), r.prefix)}; }
    }
    if (sel t.reads.kind) {
        if (sel n.some && n.some.tls && t.reads.kind == ?section.BSS) { ret res[*section.Kind, Fail].ok{?section.TLS_BSS}; }
        ret res[*section.Kind, Fail].ok{t.reads.kind};
    }
    if (sel n.some) {
        val r: *Named = n.some;
        if (sel r.reads.kind) { ret res[*section.Kind, Fail].ok{r.reads.kind}; }
    }
    if ((flags & section.ALLOC) == 0) { ret res[*section.Kind, Fail].ok{?section.METADATA}; }
    if ((flags & section.EXEC) != 0)  { ret res[*section.Kind, Fail].ok{?section.TEXT}; }
    if ((flags & section.WRITE) != 0) { ret res[*section.Kind, Fail].ok{?section.DATA}; }
    ret res[*section.Kind, Fail].ok{?section.RODATA};
}

# whether the section named `name` holds the object's directives
pub fun directive(name: Bytes) bool {
    val n: opt[*Named] = named(name);
    ret sel n.some && sel n.some.reads.directive;
}

# whether the section named `name` holds the mink note
pub fun mark(name: Bytes) bool {
    val n: opt[*Named] = named(name);
    ret sel n.some && sel n.some.reads.mark;
}

# how COFF names sections, for the registration
pub val NAMING: Naming = Naming{kind_of: kind_of, kind_for: kind_for, name_of: name_of};

# the kind a row is read back as: relro data is written as read-only data and
# zero-filled thread-local data as its template
pub fun read_back(k: *section.Kind) *section.Kind {
    if (k == ?section.RELRO_DATA) { ret ?section.RODATA; }
    if (k == ?section.TLS_BSS)    { ret ?section.TLS_DATA; }
    ret k;
}
