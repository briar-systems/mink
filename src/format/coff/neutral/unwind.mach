# a COFF object's frames as its .pdata function table and .xdata unwind data
#
# each frame is written in the form its machine's function table row names,
# its unwind data to .xdata and an entry per region of its function to .pdata,
# as the row's entry layout has it, every address in them image relative, one
# in a function's code named as the row's anchor names it and one in .xdata by
# .xdata's section symbol. the frames of functions in no group share one
# .pdata and one .xdata, .pdata kept as a root and .xdata kept while an entry
# reaches it. the frames of functions in a section of a group get a .pdata and
# an .xdata of their own, associative to that section, as clang and MSVC write
# them.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.coff.model.model.FunctionTable;
use mink.format.coff.neutral.naming;
use coff_kinds: mink.format.coff.reloc.kinds;
use mink.lower.FrameForm;
use mink.lower.lowered;
use mink.lower.lowered.Added;
use mink.lower.lowered.Lowered;
use mink.lower.unwind.anchor.Aimed;
use mink.lower.unwind.arm64;
use mink.lower.unwind.emit;
use mink.lower.unwind.emit.Out;
use mink.lower.unwind.emit.Region;
use mink.lower.unwind.win64;
use mink.model.object;
use mink.model.object.Definition;
use mink.model.object.Frame;
use mink.model.object.Object;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.section;
use mink.reloc.row;
use mink.reloc.row.Lookup;

# the .xdata and .pdata a set of frames is written to, the .pdata right
# after the .xdata
rec Bucket {
    xdata: Id[Added];
    pdata: Id[Added];
}

# o:       the object
# t:       the machine's function table row
# form:    the form its frames are written in
# low:     the record the sections are added to
# plain:   the bucket of functions in no group, plus one, zero before it is
#          made
# grouped: per section of the object, its bucket plus one
# buckets: the buckets made
# regions: the regions of the frame being written
rec Ctx {
    o:       *Object;
    t:       *FunctionTable;
    form:    FrameForm;
    low:     *Lowered;
    plain:   usize;
    grouped: Table[u32];
    buckets: Table[Bucket];
    regions: Table[Region];
}

# add to `low` the .pdata and .xdata of the frames of `o`, for the machine
# whose function table row is `t` and whose relocations `set` writes. an
# object with no frames adds nothing. a refusal leaves `low` as it was, and
# is unsupported for a machine whose form is not built and for a target with
# no image relative relocation
pub fun lower(o: *Object, t: *FunctionTable, set: *Lookup, low: *Lowered) err[Fail] {
    if (table.count[Frame](?o.frames) == 0) { ret err[Fail].ok{}; }
    if (sel t.frame.none)                   { ret err[Fail].err{fail.about(fail.unsupported("the machine's frame records have no unwind form built"), t.machine.name)}; }
    val rv: res[*row.Row, Fail] = row.by_kind(set, ?coff_kinds.IMAGE32);
    if (sel rv.err) { ret err[Fail].err{fail.about(fail.unsupported("the target writes no image relative relocation a function table needs"), coff_kinds.IMAGE32.name)}; }
    val a: *A.Allocator = o.sections.a;
    var c: Ctx          = Ctx{o: o, t: t, form: t.frame.some, low: low, grouped: table.make[u32](a), buckets: table.make[Bucket](a), regions: table.make[Region](a)};
    val m: lowered.Mark = lowered.mark(low);
    var r: err[Fail]    = frames_out(?c);
    r = fail.kept(r, table.release[u32](?c.grouped));
    r = fail.kept(r, table.release[Bucket](?c.buckets));
    r = fail.kept(r, table.release[Region](?c.regions));
    if (sel r.err) { val back: err[Fail] = lowered.rollback(low, m); }
    ret r;
}

fun frames_out(c: *Ctx) err[Fail] {
    val g: res[Id[u32], Fail] = table.grow[u32](?c.grouped, table.count[Section](?c.o.sections));
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < table.count[Frame](?c.o.frames)) {
        val f: *Frame    = table.at[Frame](?c.o.frames, table.nth[Frame](i));
        val r: err[Fail] = frame_out(c, f);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "frame", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun frame_out(c: *Ctx, f: *Frame) err[Fail] {
    val y: *Symbol    = object.symbol_at(c.o, f.function);
    val d: Definition = y.def;
    if (!(sel d.placed)) { ret err[Fail].err{fail.malformed("the frame's function is placed in no section")}; }
    val code: Id[Section] = d.placed.section;
    if (code.index::usize >= table.count[Section](?c.o.sections)) { ret err[Fail].err{fail.malformed("the frame's function is placed in a section the object does not have")}; }
    val b: res[Bucket, Fail] = bucket_of(c, code);
    if (sel b.err) { ret err[Fail].err{b.err}; }
    table.clear[Region](?c.regions);
    var out: Out = Out{
        o:        c.o,
        out:      c.low,
        xdata:    ?lowered.section_at(c.low, b.ok.xdata).bytes,
        section:  b.ok.xdata,
        rva:      ?coff_kinds.IMAGE32,
        code:     code,
        start:    f.start,
        function: f.function,
        anchor:   c.t.anchor,
        regions:  ?c.regions,
    };
    var e: err[Fail] = err[Fail].ok{};
    if (sel c.form.win64)       { e = win64.encode(?out, f, f.function.index::u64); }
    or (sel c.form.arm64_xdata) { e = arm64.encode(?out, f, f.function.index::u64); }
    or                          { ret err[Fail].err{fail.about(fail.unsupported("the machine's function table names a form no COFF object writes"), c.t.machine.name)}; }
    if (sel e.err)              { ret e; }
    var i: usize = 0;
    for (i < table.count[Region](?c.regions)) {
        val r: err[Fail] = entry_out(c, ?out, b.ok.pdata, table.at[Region](?c.regions, table.nth[Region](i)));
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the function table entry of region `g`, written to the .pdata `pdata`
fun entry_out(c: *Ctx, x: *Out, pdata: Id[Added], g: *Region) err[Fail] {
    val s:     *Sink            = ?lowered.section_at(c.low, pdata).bytes;
    val begin: res[Aimed, Fail] = emit.code(x, g.begin);
    if (sel begin.err) { ret err[Fail].err{begin.err}; }
    val b: err[Fail] = emit.rva(c.low, pdata, s, x.rva, begin.ok.target, begin.ok.addend);
    if (sel b.err) { ret b; }
    if (c.t.ended) {
        val end: res[Aimed, Fail] = emit.code(x, g.end);
        if (sel end.err) { ret err[Fail].err{end.err}; }
        val e: err[Fail] = emit.rva(c.low, pdata, s, x.rva, end.ok.target, end.ok.addend);
        if (sel e.err) { ret e; }
    }
    if (sel g.unwind.packed) {
        if (c.t.ended) { ret err[Fail].err{fail.about(fail.unsupported("the machine's function table has no packed entry"), c.t.machine.name)}; }
        ret sink.u32(s, g.unwind.packed);
    }
    if (g.unwind.xdata > 0x7fff_ffff) { ret err[Fail].err{fail.overflow("the unwind data is past what an image relative address reaches")}; }
    ret emit.rva(c.low, pdata, s, x.rva, lowered.Aim.added{x.section}, g.unwind.xdata::i64);
}

# the bucket of the functions of section `code`, made the first time a frame
# needs it
fun bucket_of(c: *Ctx, code: Id[Section]) res[Bucket, Fail] {
    val sec: *Section = object.section_at(c.o, code);
    var hit: usize    = c.plain;
    if (sel sec.group.some) { hit = table.items[u32](?c.grouped)[code.index::usize]::usize; }
    if (hit != 0)           { ret res[Bucket, Fail].ok{@table.at[Bucket](?c.buckets, table.nth[Bucket](hit - 1))}; }
    var leader: opt[Id[Section]]     = opt[Id[Section]].none{};
    var xd:     *section.Disposition = ?section.WHOLE;
    var pd:     *section.Disposition = ?section.ROOT;
    if (sel sec.group.some) {
        leader = opt[Id[Section]].some{code};
        xd     = ?section.DEPENDENT;
        pd     = ?section.DEPENDENT;
    }
    val x: res[Id[Added], Fail] = added(c, ?section.UNWIND_INFO, xd, leader);
    if (sel x.err) { ret res[Bucket, Fail].err{x.err}; }
    val p: res[Id[Added], Fail] = added(c, ?section.FUNCTION_TABLE, pd, leader);
    if (sel p.err) { ret res[Bucket, Fail].err{p.err}; }
    val b:  Bucket                = Bucket{xdata: x.ok, pdata: p.ok};
    val id: res[Id[Bucket], Fail] = table.push[Bucket](?c.buckets, b);
    if (sel id.err) { ret res[Bucket, Fail].err{id.err}; }
    val n: u32 = table.count[Bucket](?c.buckets)::u32;
    if (sel sec.group.some) { table.items[u32](?c.grouped)[code.index::usize] = n; }
    or                      { c.plain = n::usize; }
    ret res[Bucket, Fail].ok{b};
}

# an empty section of kind `k`, named as COFF names the kind
fun added(c: *Ctx, k: *section.Kind, d: *section.Disposition, leader: opt[Id[Section]]) res[Id[Added], Fail] {
    val name: res[str, Fail] = naming.name_of(section.key_of(k, 0));
    if (sel name.err) { ret res[Id[Added], Fail].err{name.err}; }
    ret lowered.add_section(c.low, Added{name: name.ok, kind: k, flags: k.flags, align: 4, disposition: d, bytes: sink.make(c.o.sections.a, LITTLE), leader: leader});
}
