# the section a DWARF line table is written to
val DEBUG_LINE: str = ".debug_line";

# .debug_frame as the DWARF 5 standard states it for a debugger: version 4
# CIEs of id 0xffffffff with no augmentation, FDEs naming their CIE by its
# offset in the table, relocated section-relative from the table's section
# as an image places the table among other objects', their start by the
# section symbol of their function's section, absolute addresses and entries
# padded to an address
val DEBUG_FRAME: DwarfFrame = DwarfFrame{
    section:     ".debug_frame",
    kind:        ?section.DEBUG_INFO,
    disposition: ?section.ROOT,
    mapped:      false,
    cie_id:      0xffff_ffff,
    version:     4,
    augmented:   false,
    link:        CieLink.relocated{?coff_kinds.SECREL32},
    pad:         Width.address{},
    encodings:   ?pointer.DEBUG,
    address:     Field{encoding: Encoding{format: ?pointer.ABSPTR, base: ?pointer.ABSOLUTE}, relocated: Relocated.kind{}},
    anchor:      Anchor.section{},
};

# the destinations COFF offers frames: a runtime unwinder's as its function
# table and unwind data, and a debugger's as .debug_frame
val FRAME_OFFERS: [2]FrameOffer = [2]FrameOffer{
    FrameOffer{destination: ?frame.UNWIND, form: FrameForm.windows{}},
    FrameOffer{destination: ?frame.DEBUG, form: FrameForm.dwarf_debug{DEBUG_FRAME}},
};

# the encodings COFF writes a neutral object's records in, which its
# registration names: line records as a DWARF 5 line table, and frames to
# the function table and unwind data unless the object states otherwise
pub val LOWERING: Lowering = Lowering{
    line:  opt[LineForm].some{LineForm.dwarf{DwarfLine{version: 5, section: DEBUG_LINE}}},
    frame: opt[FrameTables].some{FrameTables{offers: ?FRAME_OFFERS[0], count: 2, default: Destinations{bits: 1::u64 << frame.UNWIND.bit::u64}}},
};

# the selection of a COMDAT section and the group rule it maps to
rec Selection {
    code: *tables.Constant;
    rule: *group.Rule;
}

val SELECTION_COUNT: usize                      = 6;
val SELECTIONS:      [SELECTION_COUNT]Selection = [SELECTION_COUNT]Selection{
    Selection{code: ?tables.IMAGE_COMDAT_SELECT_NODUPLICATES, rule: ?group.NODUPLICATE},
    Selection{code: ?tables.IMAGE_COMDAT_SELECT_ANY, rule: ?group.ANY},
    Selection{code: ?tables.IMAGE_COMDAT_SELECT_SAME_SIZE, rule: ?group.SAMESIZE},
    Selection{code: ?tables.IMAGE_COMDAT_SELECT_EXACT_MATCH, rule: ?group.EXACT},
    Selection{code: ?tables.IMAGE_COMDAT_SELECT_ASSOCIATIVE, rule: ?group.ASSOCIATE},
    Selection{code: ?tables.IMAGE_COMDAT_SELECT_LARGEST, rule: ?group.LARGEST_ONE},
};

# the search characteristic of a weak external and the row it maps to
rec Searching {
    code: *tables.Constant;
    row:  *symbol.Search;
}

val SEARCH_COUNT: usize                   = 4;
val SEARCHES:     [SEARCH_COUNT]Searching = [SEARCH_COUNT]Searching{
    Searching{code: ?tables.IMAGE_WEAK_EXTERN_SEARCH_NOLIBRARY, row: ?symbol.NO_LIBRARY},
    Searching{code: ?tables.IMAGE_WEAK_EXTERN_SEARCH_LIBRARY, row: ?symbol.LIBRARY},
    Searching{code: ?tables.IMAGE_WEAK_EXTERN_SEARCH_ALIAS, row: ?symbol.ALIAS},
    Searching{code: ?tables.IMAGE_WEAK_EXTERN_ANTI_DEPENDENCY, row: ?symbol.ANTI_DEPENDENCY},
};

fun rule_of(selection: u8) opt[*group.Rule] {
    var i: usize = 0;
    for (i < SELECTION_COUNT) {
        if (SELECTIONS[i].code.value == selection::u64) { ret opt[*group.Rule].some{SELECTIONS[i].rule}; }
        i = i + 1;
    }
    ret opt[*group.Rule].none{};
}

fun selection_of(r: *group.Rule) opt[u8] {
    var i: usize = 0;
    for (i < SELECTION_COUNT) {
        if (SELECTIONS[i].rule == r) { ret opt[u8].some{SELECTIONS[i].code.value::u8}; }
        i = i + 1;
    }
    ret opt[u8].none{};
}

fun search_of(code: u32) opt[*symbol.Search] {
    var i: usize = 0;
    for (i < SEARCH_COUNT) {
        if (SEARCHES[i].code.value == code::u64) { ret opt[*symbol.Search].some{SEARCHES[i].row}; }
        i = i + 1;
    }
    ret opt[*symbol.Search].none{};
}

fun search_code(s: *symbol.Search) opt[u32] {
    var i: usize = 0;
    for (i < SEARCH_COUNT) {
        if (SEARCHES[i].row == s) { ret opt[u32].some{SEARCHES[i].code.value::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the section characteristics the conversion back derives from the content
# type and memory bits, the alignment, COMDAT and the extended relocation
# count aside, which the structure states
val ALIGN_MASK:  u64 = tables.SCN_ALIGN_MASK.value;
val ALIGN_SHIFT: u64 = 20;
val STRUCTURE:   u64 = tables.IMAGE_SCN_LNK_COMDAT.value | tables.IMAGE_SCN_LNK_NRELOC_OVFL.value;
val DROPPED:     u64 = tables.IMAGE_SCN_LNK_INFO.value | tables.IMAGE_SCN_LNK_REMOVE.value | tables.IMAGE_SCN_MEM_DISCARDABLE.value;

# the largest alignment the ALIGN field states, 8192 bytes
val ALIGN_MAX: u64 = 0xe;

# the PE Format default alignment of an object section that states none
val ALIGN_DEFAULT: u64 = 16;

# the largest section number a regular object's symbols hold, past which a
# bigobj is written, IMAGE_SYM_SECTION_MAX
val SECTION_MAX: usize = 0xfeff;

# the alignment of a section of the characteristics `ch`: one for a section
# that is not padded, the ALIGN field's, or the default when it states none
fun alignment_of(ch: u64) res[u64, Fail] {
    if ((ch & tables.IMAGE_SCN_TYPE_NO_PAD.value) != 0) { ret res[u64, Fail].ok{1}; }
    val field: u64 = (ch & ALIGN_MASK) >> ALIGN_SHIFT;
    if (field == 0)        { ret res[u64, Fail].ok{ALIGN_DEFAULT}; }
    if (field > ALIGN_MAX) { ret res[u64, Fail].err{fail.valued(fail.malformed("the section alignment field holds no alignment"), field::i128)}; }
    ret res[u64, Fail].ok{(1::u64) << (field - 1)};
}

# the characteristics a section of key `k` and flags `f` states apart from
# its alignment: its key's row, or a row of its content for a key with none,
# its memory bits as its flags say, and a section the image drops removed
# when it is excluded and otherwise discardable unless its row drops it
# already
pub fun contents_of(k: section.Key, f: section.Flags) u64 {
    var ch:  u64                    = 0;
    val row: res[*naming.Row, Fail] = naming.row_of(k);
    if (sel row.ok)                        { ch = row.ok.characteristics; }
    or ((f & section.EXEC) != 0)           { ch = tables.IMAGE_SCN_CNT_CODE.value | tables.IMAGE_SCN_MEM_READ.value; }
    or (section.has(k.kind, section.BITS)) { ch = tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value; }
    or                                     { ch = tables.IMAGE_SCN_CNT_UNINITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value; }
    ch = ch & ~(tables.IMAGE_SCN_MEM_WRITE.value | tables.IMAGE_SCN_MEM_EXECUTE.value);
    if ((f & section.WRITE) != 0)   { ch = ch | tables.IMAGE_SCN_MEM_WRITE.value; }
    if ((f & section.EXEC) != 0)    { ch = ch | tables.IMAGE_SCN_MEM_EXECUTE.value; }
    if ((f & section.ALLOC) != 0)   { ch = ch & ~DROPPED; }
    or ((f & section.EXCLUDE) != 0) { ch = ch | tables.IMAGE_SCN_LNK_REMOVE.value; }
    or ((ch & DROPPED) == 0)        { ch = ch | tables.IMAGE_SCN_MEM_DISCARDABLE.value; }
    ret ch;
}

# the characteristics a section of key `k`, flags `f` and alignment `align`
# is written with: what its contents state and the alignment field
fun characteristics(k: section.Key, f: section.Flags, align: u64) res[u64, Fail] {
    val field: res[u64, Fail] = align_field(align);
    if (sel field.err) { ret field; }
    ret res[u64, Fail].ok{contents_of(k, f) | field.ok};
}

# the ALIGN field of characteristics that state the alignment `align`
pub fun align_field(align: u64) res[u64, Fail] {
    if (align == 0 || (align & (align - 1)) != 0) { ret res[u64, Fail].err{fail.valued(fail.malformed("section alignment is not a power of two"), align::i128)}; }
    var field: u64 = 1;
    for (((1::u64) << (field - 1)) < align) {
        field = field + 1;
    }
    if (field > ALIGN_MAX) { ret res[u64, Fail].err{fail.valued(fail.unsupported("COFF aligns a section to at most 8192 bytes"), align::i128)}; }
    ret res[u64, Fail].ok{field << ALIGN_SHIFT};
}

# the alignment of a common block of `size` bytes, its size rounded up to a
# power of two, at most 32
fun common_align(size: u64) u64 {
    var a: u64 = 1;
    for (a < size && a < 32) {
        a = a << 1;
    }
    ret a;
}

# the checksum a section definition states of a section's bytes, as llvm
# writes it: a CRC-32 of the reflected IEEE polynomial from zero and with no
# final complement
fun checksum_of(b: Bytes) u32 {
    ret crc32.update(0, b.data, b.len);
}

# the type a symbol of kind `k` is written with
fun type_of(k: *symbol.Kind) u16 {
    if (symbol.names(k, symbol.CODE)) { ret (tables.IMAGE_SYM_DTYPE_FUNCTION.value << tables.SYM_DTYPE_SHIFT.value)::u16; }
    ret 0;
}

# whether the type `t` is a function's
fun is_function(t: u16) bool {
    ret ((t::u64 >> tables.SYM_DTYPE_SHIFT.value) & 3) == tables.IMAGE_SYM_DTYPE_FUNCTION.value;
}

# the object being read
# ---
# m:       the model
# o:       the object it is added to
# reg:     the relocation rows of every pair, borrowed
# set:     the relocation rows of the file's machine
# strings: the string table, none when the file has none
# secmap:  per section, the neutral section index plus one, zero for a
#          section that is no neutral section
# role:    per section, what it is to the neutral object
# marked:  the relocations of the mink note sections, each naming by its
#          section field the section header it patches
# symmap:  per symbol table record, the neutral symbol index plus one, zero
#          for an auxiliary record
# defs:    per section, the record of its section definition plus one, or zero
# keys:    per section, the record of the first symbol defined in it after its
#          section definition plus one, or zero
rec Conv {
    m:       *Coff;
    o:       *Object;
    reg:     *Registry;
    set:     *Lookup;
    strings: opt[Bytes];
    secmap:  Table[u32];
    role:    Table[u8];
    marked:  Table[object.Reloc];
    symmap:  Table[u32];
    defs:    Table[u32];
    keys:    Table[u32];
}

val ROLE_DIRECTIVE: u8 = 1;
val ROLE_MARK:      u8 = 2;

fun add_fact(o: *Object, key: u32, value: u64) err[Fail] {
    val r: res[Id[Fact], Fail] = object.add_fact(o, Fact{format: ?format.COFF, key: key, value: value, data: Contents.zero{0}});
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

# refuse a bigobj header field that holds other than the value every bigobj
# is written with, as the conversion back writes a bigobj only for the
# sections it numbers and then writes those values
fun bigobj_header(h: *model.Header) err[Fail] {
    val names: [5]str = [5]str{"Version", "SizeOfData", "Flags", "MetaDataSize", "MetaDataOffset"};
    val vals:  [5]u64 = [5]u64{h.version::u64, h.size_of_data::u64, h.flags::u64, h.meta_size::u64, h.meta_offset::u64};
    val dflts: [5]u64 = [5]u64{tables.BIGOBJ_MIN_VERSION.value, 0, 0, 0, 0};
    var i:     usize  = 0;
    for (i < 5) {
        if (vals[i] != dflts[i]) { ret err[Fail].err{fail.valued(fail.about(fail.unsupported("a bigobj header field holds a value the conversion back does not write"), names[i]), vals[i]::i128)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the architecture a COFF machine code names
pub fun arch_of(machine: u16) res[*Arch, Fail] {
    var s: Stated = model.stated(machine);
    ret arch_list.by_code(?s);
}

fun begin(c: *Conv) err[Fail] {
    val m: *Coff = c.m;
    if (sel m.signature.some || !sel m.optional.absent) {
        ret err[Fail].err{fail.in_record(fail.unsupported("an image has no neutral form"), "file header")};
    }
    if (m.shape.object == ?model.BIGOBJ) {
        val big: err[Fail] = bigobj_header(?m.header);
        if (sel big.err) { ret err[Fail].err{fail.in_record(big.err, "file header")}; }
    }
    val a: res[*Arch, Fail] = arch_of(m.header.machine);
    if (sel a.err) { ret err[Fail].err{fail.valued(fail.in_record(a.err, "file header"), m.header.machine::i128)}; }
    c.o.target.arch = a.ok;
    val set: res[*Lookup, Fail] = row.find(c.reg, ?format.COFF, a.ok);
    if (sel set.err) { ret err[Fail].err{set.err}; }
    c.set     = set.ok;
    c.strings = read.string_table(m);
    val n:  usize              = table.count[model.Section](?m.sections);
    val g1: res[Id[u32], Fail] = table.grow[u32](?c.secmap, n);
    if (sel g1.err) { ret err[Fail].err{g1.err}; }
    val g0: res[Id[u8], Fail] = table.grow[u8](?c.role, n);
    if (sel g0.err) { ret err[Fail].err{g0.err}; }
    val g2: res[Id[u32], Fail] = table.grow[u32](?c.defs, n);
    if (sel g2.err) { ret err[Fail].err{g2.err}; }
    val g3: res[Id[u32], Fail] = table.grow[u32](?c.keys, n);
    if (sel g3.err) { ret err[Fail].err{g3.err}; }
    val g4: res[Id[u32], Fail] = table.grow[u32](?c.symmap, table.count[Entry](?m.symbols));
    if (sel g4.err) { ret err[Fail].err{g4.err}; }
    if (m.header.timestamp != 0) {
        val t: err[Fail] = add_fact(c.o, coff_fact.TIMESTAMP, m.header.timestamp::u64);
        if (sel t.err) { ret t; }
    }
    if (m.header.characteristics != 0) { ret add_fact(c.o, coff_fact.CHARACTERISTICS, m.header.characteristics::u64); }
    ret err[Fail].ok{};
}

fun section_name(c: *Conv, s: *model.Section) res[Bytes, Fail] {
    ret read.section_name(c.strings, s);
}

fun sections_in(c: *Conv) err[Fail] {
    var i: usize = 0;
    for (i < table.count[model.Section](?c.m.sections)) {
        val r: err[Fail] = section_in(c, i);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section header", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bytes section `s` holds, nil for none
fun body_of(c: *Conv, s: *model.Section) res[Bytes, Fail] {
    if (sel s.body.raw)   { ret res[Bytes, Fail].ok{model.bytes(c.m, ?s.body.raw.bytes)}; }
    if (sel s.body.empty) { ret res[Bytes, Fail].ok{Bytes{data: nil, len: 0}}; }
    ret res[Bytes, Fail].err{fail.unsupported("a section whose bytes are typed records or overlap another's has no neutral form")};
}

fun section_in(c: *Conv, i: usize) err[Fail] {
    val s: *model.Section   = model.section_at(c.m, table.nth[model.Section](i));
    val n: res[Bytes, Fail] = section_name(c, s);
    if (sel n.err)                                     { ret err[Fail].err{n.err}; }
    if (s.virtual_size != 0 || s.virtual_address != 0) { ret err[Fail].err{fail.unsupported("an object section with a virtual size or address has no neutral form")}; }
    if (s.nlines != 0 || s.line_ptr != 0)              { ret err[Fail].err{fail.unsupported("COFF line numbers have no neutral form")}; }
    val ch: u64 = s.flags::u64;
    if (naming.directive(n.ok)) {
        if (table.count[model.Reloc](?s.relocs) != 0) { ret err[Fail].err{fail.unsupported("a directive section with relocations has no neutral form")}; }
        table.items[u8](?c.role)[i] = ROLE_DIRECTIVE;
        ret err[Fail].ok{};
    }
    if (naming.mark(n.ok)) {
        table.items[u8](?c.role)[i] = ROLE_MARK;
        ret err[Fail].ok{};
    }
    val align: res[u64, Fail] = alignment_of(ch);
    if (sel align.err) { ret err[Fail].err{align.err}; }
    val t:     *naming.Type             = naming.type_of(ch);
    var flags: section.Flags            = naming.flags_of(ch);
    val k:     res[*section.Kind, Fail] = naming.classify(n.ok, t, flags);
    if (sel k.err) { ret err[Fail].err{k.err}; }
    flags = flags | (k.ok.flags & section.TLS);
    val b: res[Bytes, Fail] = body_of(c, s);
    if (sel b.err) { ret err[Fail].err{b.err}; }
    var contents: Contents = Contents.zero{s.raw_size::u64};
    if (sel s.body.raw || (ch & tables.IMAGE_SCN_CNT_UNINITIALIZED_DATA.value) == 0) {
        val held: res[Contents, Fail] = object.own(c.o, b.ok.data, b.ok.len);
        if (sel held.err) { ret err[Fail].err{held.err}; }
        contents = held.ok;
    }
    val id: res[Id[Name], Fail] = object.name(c.o, n.ok.data, n.ok.len);
    if (sel id.err) { ret err[Fail].err{id.err}; }
    val added: res[Id[object.Section], Fail] = object.add_section(c.o, object.Section{
        name:        opt[Id[Name]].some{id.ok},
        kind:        k.ok,
        flags:       flags,
        align:       align.ok,
        contents:    contents,
        disposition: disposition_of(k.ok),
    });
    if (sel added.err) { ret err[Fail].err{added.err}; }
    table.items[u32](?c.secmap)[i] = added.ok.index + 1;
    val derived: res[u64, Fail] = characteristics(section.Key{kind: k.ok}, flags, align.ok);
    if (sel derived.err) { ret err[Fail].err{derived.err}; }
    val differ: u64 = (ch ^ derived.ok) & ~STRUCTURE;
    if (differ != 0) { ret add_fact(c.o, coff_fact.SECTION, (added.ok.index::u64 << 32) | differ); }
    ret err[Fail].ok{};
}

# the kinds whose sections outside a group live only while something reaches
# them: unwind data, which only the function tables naming it reach
val REACHED_COUNT: usize                        = 1;
val REACHED:       [REACHED_COUNT]*section.Kind = [REACHED_COUNT]*section.Kind{?section.UNWIND_INFO};

# how garbage collection treats a section of kind `k` outside a group: kept
# when reached for a kind of REACHED, and a root otherwise
fun disposition_of(k: *section.Kind) *section.Disposition {
    var i: usize = 0;
    for (i < REACHED_COUNT) {
        if (REACHED[i] == k) { ret ?section.WHOLE; }
        i = i + 1;
    }
    ret ?section.ROOT;
}

# the neutral section a section number names, refused for a section that is
# no neutral section
fun placed_in(c: *Conv, sec: Id[model.Section]) res[Id[object.Section], Fail] {
    val mapped: u32 = table.items[u32](?c.secmap)[sec.index::usize];
    if (mapped == 0) { ret res[Id[object.Section], Fail].err{fail.unsupported("a symbol is defined in a section that is no neutral section")}; }
    ret res[Id[object.Section], Fail].ok{Id[object.Section]{index: mapped - 1}};
}

# the auxiliary record `k` of the symbol table, nil for a symbol record
fun aux_at(c: *Conv, k: usize) *Aux {
    val e: *Entry = table.at[Entry](?c.m.symbols, table.nth[Entry](k));
    if (sel e.aux) { ret ?e.aux; }
    ret nil;
}

# the symbol record `k` of the symbol table, nil for an auxiliary record
fun symbol_at(c: *Conv, k: usize) *model.Symbol {
    val e: *Entry = table.at[Entry](?c.m.symbols, table.nth[Entry](k));
    if (sel e.symbol) { ret ?e.symbol; }
    ret nil;
}

# the size of the contents of `s`
fun size_of(o: *Object, s: *object.Section) u64 {
    if (sel s.contents.zero) { ret s.contents.zero; }
    ret object.bytes(o, ?s.contents).len::u64;
}

# the name a file symbol's records spell, the bytes before the first NUL of
# their `naux` records, past which every byte must be zero
fun file_name(c: *Conv, k: usize, naux: usize, out: *Sink) err[Fail] {
    val size:  usize = c.m.shape.object.symbol.size;
    var ended: bool  = false;
    var r:     usize = 0;
    for (r < naux) {
        val a: *Aux = aux_at(c, k + 1 + r);
        if (a == nil) { ret err[Fail].err{fail.malformed("a file symbol's auxiliary record holds no file name")}; }
        var bytes: [20]u8;
        if (sel a.file) { bytes = a.file; }
        or              { ret err[Fail].err{fail.malformed("a file symbol's auxiliary record holds no file name")}; }
        var i: usize = 0;
        for (i < size) {
            val b: u8 = bytes[i];
            i = i + 1;
            if (b == 0) {
                ended = true;
                cnt;
            }
            if (ended) { ret err[Fail].err{fail.unsupported("a file name record holds bytes past its name")}; }
            val w: err[Fail] = sink.u8(out, b);
            if (sel w.err) { ret w; }
        }
        r = r + 1;
    }
    ret err[Fail].ok{};
}

fun symbols_in(c: *Conv) err[Fail] {
    val n:       usize               = table.count[Entry](?c.m.symbols);
    var k:       usize               = 0;
    var waiting: Table[bool]         = table.make[bool](c.m.a);
    val g:       res[Id[bool], Fail] = table.grow[bool](?waiting, table.count[model.Section](?c.m.sections));
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var r: err[Fail] = err[Fail].ok{};
    for (k < n) {
        val y: *model.Symbol = symbol_at(c, k);
        if (y == nil) {
            r = err[Fail].err{fail.in_indexed(fail.malformed("an auxiliary record follows no symbol"), "symbol", k::u64)};
            brk;
        }
        val naux: usize     = y.naux::usize;
        val got:  err[Fail] = symbol_in(c, k, y, ?waiting);
        if (sel got.err) {
            r = err[Fail].err{fail.in_indexed(got.err, "symbol", k::u64)};
            brk;
        }
        k = k + 1 + naux;
    }
    ret fail.kept(r, table.release[bool](?waiting));
}

fun symbol_in(c: *Conv, k: usize, s: *model.Symbol, waiting: *Table[bool]) err[Fail] {
    val at:   Id[Entry]             = table.nth[Entry](k);
    val naux: usize                 = s.naux::usize;
    val ref:  res[SectionRef, Fail] = model.symbol_section(c.m, at, s);
    if (sel ref.err) { ret err[Fail].err{ref.err}; }
    if (sel ref.ok.section) {
        if (table.items[u32](?c.secmap)[ref.ok.section.index::usize] == 0) { ret plain_definition(c, k, s, ref.ok.section); }
    }
    val class: u64       = s.class::u64;
    var name:  Sink      = sink.make(c.m.a, LITTLE);
    val r:     err[Fail] = symbol_named(c, k, s, ref.ok, class, naux, ?name, waiting);
    val rel:   err[Fail] = sink.release(?name);
    if (sel r.err) { ret r; }
    ret rel;
}

# the definition of a section that is no neutral section, which states
# nothing the conversion back does not derive, as llvm writes one for
# .drectve, and so has no neutral symbol. any other symbol in such a section
# is refused
fun plain_definition(c: *Conv, k: usize, s: *model.Symbol, sec: Id[model.Section]) err[Fail] {
    val no: err[Fail] = err[Fail].err{fail.unsupported("a symbol in a section that is no neutral section other than its plain definition has no neutral form")};
    if (s.class::u64 != tables.IMAGE_SYM_CLASS_STATIC.value || s.value != 0 || s.naux != 1 || s.type != 0) { ret no; }
    val got: *Aux = aux_at(c, k + 1);
    if (got == nil || !sel got.section) { ret no; }
    var held: SectionAux = SectionAux{};
    if (sel got.section) { held = got.section; }
    val h: *model.Section   = model.section_at(c.m, sec);
    val b: res[Bytes, Fail] = body_of(c, h);
    if (sel b.err) { ret err[Fail].err{b.err}; }
    val high: bool = c.m.shape.object.symbol.section.width <= 2 && held.number_high != 0;
    if (held.length != h.raw_size || held.nreloc != h.nreloc || held.nlines != 0 || held.checksum != checksum_of(b.ok) || held.selection != 0 || held.unused != 0 || high || !zeros(?held.unused_tail[0], 2)) { ret no; }
    if (model.aux_number(c.m, ?held) != sec.index + 1)                                                                                                                                                        { ret no; }
    ret err[Fail].ok{};
}

fun symbol_named(c: *Conv, k: usize, s: *model.Symbol, ref: SectionRef, class: u64, naux: usize, name: *Sink, waiting: *Table[bool]) err[Fail] {
    val spelled: res[Bytes, Fail] = read.symbol_name(c.strings, s);
    if (sel spelled.err) { ret err[Fail].err{spelled.err}; }
    var binding:  *symbol.Binding = ?symbol.LOCAL;
    var kind:     *symbol.Kind    = ?symbol.NOTYPE;
    var def:      Definition      = Definition.undefined{};
    var size:     opt[u64]        = opt[u64].none{};
    var text:     Bytes           = spelled.ok;
    var defines:  bool            = false;
    var stated:   u64             = tables.IMAGE_SYM_CLASS_STATIC.value;
    var aux_kind: u8              = 0;
    if (naux != 0) {
        val a: *Aux = aux_at(c, k + 1);
        if (a == nil)      { ret err[Fail].err{fail.malformed("a symbol's auxiliary records run past the symbol table")}; }
        if (sel a.section) { aux_kind = 1; }
        or (sel a.weak)    { aux_kind = 2; }
        or (sel a.file)    { aux_kind = 3; }
        or                 { ret err[Fail].err{fail.unsupported("an auxiliary record of a function, block or CLR token has no neutral form")}; }
    }
    if (class == tables.IMAGE_SYM_CLASS_FILE.value) {
        if (aux_kind != 3 && naux != 0) { ret err[Fail].err{fail.malformed("a file symbol's auxiliary record holds no file name")}; }
        if (!sel ref.debug)             { ret err[Fail].err{fail.unsupported("a file symbol outside the debug section number has no neutral form")}; }
        if (spelled.ok.len != 5 || spelled.ok.data[0] != '.' || spelled.ok.data[1] != 'f' || spelled.ok.data[2] != 'i' || spelled.ok.data[3] != 'l' || spelled.ok.data[4] != 'e') {
            ret err[Fail].err{fail.unsupported("a file symbol not named .file has no neutral form")};
        }
        val f: err[Fail] = file_name(c, k, naux, name);
        if (sel f.err) { ret f; }
        text   = Bytes{data: sink.data(name), len: sink.len(name)};
        kind   = ?symbol.SOURCE;
        def    = Definition.absolute{s.value::u64};
        stated = class;
    }
    or (class == tables.IMAGE_SYM_CLASS_WEAK_EXTERNAL.value) {
        if (aux_kind != 2 || naux != 1)         { ret err[Fail].err{fail.malformed("a weak external has no weak external record")}; }
        if (!sel ref.undefined || s.value != 0) { ret err[Fail].err{fail.unsupported("a weak external that is defined has no neutral form")}; }
        val w: *Aux = aux_at(c, k + 1);
        if (sel w.weak) {
            if (!zeros(?w.weak.unused[0], c.m.shape.object.symbol.size - 8)) { ret err[Fail].err{fail.unsupported("a weak external record holds bytes past its fields")}; }
        }
        binding = ?symbol.WEAKLY;
        stated  = class;
    }
    or {
        if (naux != 0 && aux_kind != 1)                                                   { ret err[Fail].err{fail.unsupported("an auxiliary record of this kind has no neutral form for its symbol")}; }
        if (aux_kind == 1 && (naux != 1 || class != tables.IMAGE_SYM_CLASS_STATIC.value)) { ret err[Fail].err{fail.unsupported("a section definition of a symbol that is not static has no neutral form")}; }
        if (class == tables.IMAGE_SYM_CLASS_EXTERNAL.value) {
            binding = ?symbol.GLOBAL;
            stated  = class;
        }
        if (sel ref.undefined) {
            # an undefined symbol of any storage class is a reference by name,
            # as an import descriptor states its .idata$ sections with
            # IMAGE_SYM_CLASS_SECTION
            if (class != tables.IMAGE_SYM_CLASS_EXTERNAL.value) {
                if (s.value != 0) { ret err[Fail].err{fail.unsupported("a common symbol that is not external has no neutral form")}; }
                binding = ?symbol.GLOBAL;
            }
            if (s.value != 0) {
                kind = ?symbol.COMMONS;
                def  = Definition.common{object.Common{size: s.value::u64, align: common_align(s.value::u64)}};
                size = object.sized(s.value::u64);
            }
        }
        or (sel ref.absolute) { def = Definition.absolute{s.value::u64}; }
        or (sel ref.debug)    { ret err[Fail].err{fail.unsupported("a symbol of the debug section number has no neutral form")}; }
        or (sel ref.section) {
            val p: res[Id[object.Section], Fail] = placed_in(c, ref.section);
            if (sel p.err) { ret err[Fail].err{p.err}; }
            def = Definition.placed{Place{section: p.ok, offset: s.value::u64}};
            val sec:  *object.Section = object.section_at(c.o, p.ok);
            val wait: *bool           = ?table.items[bool](waiting)[ref.section.index::usize];
            if (aux_kind == 1) {
                if (s.value != 0)                                             { ret err[Fail].err{fail.unsupported("a section definition not at its section's start has no neutral form")}; }
                if (table.items[u32](?c.defs)[ref.section.index::usize] != 0) { ret err[Fail].err{fail.unsupported("a section has two section definitions")}; }
                table.items[u32](?c.defs)[ref.section.index::usize] = (k + 1)::u32;
                kind                                                = ?symbol.SECTIONS;
                @wait                                               = true;
            }
            or {
                if (@wait) {
                    table.items[u32](?c.keys)[ref.section.index::usize] = (k + 1)::u32;
                    @wait                                               = false;
                }
                if ((sec.flags & section.TLS) != 0) { kind = ?symbol.TLS; }
            }
        }
        if (class != tables.IMAGE_SYM_CLASS_EXTERNAL.value && class != tables.IMAGE_SYM_CLASS_STATIC.value) { stated = class; }
    }
    if (is_function(s.type) && kind != ?symbol.SECTIONS && kind != ?symbol.SOURCE && kind != ?symbol.COMMONS) { kind = ?symbol.FUNCTION; }
    val id: res[Id[Name], Fail] = object.name(c.o, text.data, text.len);
    if (sel id.err) { ret err[Fail].err{id.err}; }
    val added: res[Id[object.Symbol], Fail] = object.add_symbol(c.o, object.Symbol{
        name:       id.ok,
        binding:    binding,
        visibility: ?symbol.DEFAULT,
        kind:       kind,
        def:        def,
        size:       size,
    });
    if (sel added.err) { ret err[Fail].err{added.err}; }
    table.items[u32](?c.symmap)[k] = added.ok.index + 1;
    val index: u64 = added.ok.index::u64;
    if (stated != derived_class(binding, kind)) {
        val f: err[Fail] = add_fact(c.o, coff_fact.CLASS, (index << 8) | stated);
        if (sel f.err) { ret f; }
    }
    if (s.type != type_of(kind)) { ret add_fact(c.o, coff_fact.TYPE, (index << 16) | s.type::u64); }
    ret err[Fail].ok{};
}

# the storage class a symbol of binding `b` and kind `k` is written with
fun derived_class(b: *symbol.Binding, k: *symbol.Kind) u64 {
    if (k == ?symbol.SOURCE)              { ret tables.IMAGE_SYM_CLASS_FILE.value; }
    if (symbol.binds(b, symbol.WEAK))     { ret tables.IMAGE_SYM_CLASS_WEAK_EXTERNAL.value; }
    if (symbol.binds(b, symbol.EXTERNAL)) { ret tables.IMAGE_SYM_CLASS_EXTERNAL.value; }
    ret tables.IMAGE_SYM_CLASS_STATIC.value;
}

fun zeros(p: *u8, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (p[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the neutral symbol the record `k` is, refused for an auxiliary record
fun symbol_of(c: *Conv, k: Id[Entry]) res[Id[object.Symbol], Fail] {
    val mapped: u32 = table.items[u32](?c.symmap)[k.index::usize];
    if (mapped == 0) { ret res[Id[object.Symbol], Fail].err{fail.unsupported("a symbol index names an auxiliary record or the definition of a section that is no neutral section")}; }
    ret res[Id[object.Symbol], Fail].ok{Id[object.Symbol]{index: mapped - 1}};
}

# each weak external's fallback and the row of its search
fun fallbacks_in(c: *Conv) err[Fail] {
    var k: usize = 0;
    for (k < table.count[Entry](?c.m.symbols)) {
        val y: *model.Symbol = symbol_at(c, k);
        if (y == nil) { ret err[Fail].err{fail.in_indexed(fail.malformed("an auxiliary record follows no symbol"), "symbol", k::u64)}; }
        val n: usize = y.naux::usize;
        if (y.class::u64 == tables.IMAGE_SYM_CLASS_WEAK_EXTERNAL.value) {
            val r: err[Fail] = fallback_in(c, k);
            if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "symbol", k::u64)}; }
        }
        k = k + 1 + n;
    }
    ret err[Fail].ok{};
}

fun fallback_in(c: *Conv, k: usize) err[Fail] {
    val at: Id[Entry] = table.nth[Entry](k + 1);
    val a:  *Aux      = aux_at(c, k + 1);
    if (a == nil || !sel a.weak) { ret err[Fail].err{fail.malformed("a weak external has no weak external record")}; }
    var weak: model.WeakAux = model.WeakAux{};
    if (sel a.weak) { weak = a.weak; }
    val to: res[Id[Entry], Fail] = model.weak_fallback(c.m, at, ?weak);
    if (sel to.err) { ret err[Fail].err{to.err}; }
    val fb: res[Id[object.Symbol], Fail] = symbol_of(c, to.ok);
    if (sel fb.err) { ret err[Fail].err{fb.err}; }
    val search: opt[*symbol.Search] = search_of(weak.characteristics);
    if (sel search.none) { ret err[Fail].err{fail.valued(fail.unsupported("a weak external's search characteristic has no row"), weak.characteristics::i128)}; }
    val own: res[Id[object.Symbol], Fail] = symbol_of(c, table.nth[Entry](k));
    if (sel own.err) { ret err[Fail].err{own.err}; }
    val s: *object.Symbol = object.symbol_at(c.o, own.ok);
    s.fallback = opt[object.Fallback].some{object.Fallback{symbol: fb.ok, search: search.some}};
    ret err[Fail].ok{};
}

# each COMDAT section's group, and how garbage collection treats each section
fun groups_in(c: *Conv) err[Fail] {
    var i: usize = 0;
    for (i < table.count[model.Section](?c.m.sections)) {
        val mapped: u32 = table.items[u32](?c.secmap)[i];
        if (mapped != 0) {
            val r: err[Fail] = group_in(c, i, Id[object.Section]{index: mapped - 1});
            if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section header", i::u64)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun group_in(c: *Conv, i: usize, n: Id[object.Section]) err[Fail] {
    val s:      *model.Section = model.section_at(c.m, table.nth[model.Section](i));
    val comdat: bool           = (s.flags::u64 & tables.IMAGE_SCN_LNK_COMDAT.value) != 0;
    val def:    u32            = table.items[u32](?c.defs)[i];
    if (def == 0) {
        if (comdat) { ret err[Fail].err{fail.malformed("a COMDAT section has no section definition")}; }
        ret err[Fail].ok{};
    }
    val at:  Id[Entry] = table.nth[Entry](def::usize);
    val got: *Aux      = aux_at(c, def::usize);
    if (got == nil || !sel got.section) { ret err[Fail].err{fail.internal("a section definition lost its record")}; }
    var held: SectionAux = SectionAux{};
    if (sel got.section) { held = got.section; }
    val a:    *SectionAux     = ?held;
    val sec:  *object.Section = object.section_at(c.o, n);
    val b:    Bytes           = object.bytes(c.o, ?sec.contents);
    val high: bool            = c.m.shape.object.symbol.section.width <= 2 && a.number_high != 0;
    if (a.length::u64 != s.raw_size::u64 || a.nreloc != s.nreloc || a.nlines != s.nlines || a.unused != 0 || high || !zeros(?a.unused_tail[0], 2)) {
        ret err[Fail].err{fail.unsupported("a section definition that does not state its section's size and counts has no neutral form")};
    }
    if (a.checksum != checksum_of(b)) {
        val f: err[Fail] = add_fact(c.o, coff_fact.CHECKSUM, (n.index::u64 << 32) | a.checksum::u64);
        if (sel f.err) { ret f; }
    }
    if (!comdat && a.selection != 0) { ret err[Fail].err{fail.malformed("a section that is not COMDAT states a selection")}; }
    if (a.selection::u64 != tables.IMAGE_COMDAT_SELECT_ASSOCIATIVE.value) {
        val number: u32 = model.aux_number(c.m, a);
        if (number != (i + 1)::u32) {
            val f: err[Fail] = add_fact(c.o, coff_fact.NUMBER, (n.index::u64 << 32) | number::u64);
            if (sel f.err) { ret f; }
        }
    }
    if (!comdat) { ret err[Fail].ok{}; }
    val rule: opt[*group.Rule] = rule_of(a.selection);
    if (sel rule.none) { ret err[Fail].err{fail.valued(fail.unsupported("a COMDAT selection has no group rule"), a.selection::i128)}; }
    if (rule.some == ?group.ASSOCIATE) {
        val lead: res[opt[Id[model.Section]], Fail] = model.associative_section(c.m, at, a);
        if (sel lead.err)     { ret err[Fail].err{lead.err}; }
        if (sel lead.ok.none) { ret err[Fail].err{fail.malformed("an associative section names no section")}; }
        val to: u32 = table.items[u32](?c.secmap)[lead.ok.some.index::usize];
        if (to == 0) { ret err[Fail].err{fail.unsupported("a section associated with a section that is no neutral section has no neutral form")}; }
        val leader:    Id[object.Section] = Id[object.Section]{index: to - 1};
        var signature: Id[Name]           = Id[Name]{};
        if (sel sec.name.some) { signature = sec.name.some; }
        val g: res[Id[object.Group], Fail] = object.add_group(c.o, object.Group{signature: signature, rule: rule.some, leader: opt[Id[object.Section]].some{leader}});
        if (sel g.err) { ret err[Fail].err{g.err}; }
        val joined: *object.Section = object.section_at(c.o, n);
        joined.group       = opt[Id[object.Group]].some{g.ok};
        joined.owner       = opt[Id[object.Section]].some{leader};
        joined.disposition = ?section.DEPENDENT;
        ret err[Fail].ok{};
    }
    val key: u32 = table.items[u32](?c.keys)[i];
    if (key == 0) { ret err[Fail].err{fail.unsupported("a COMDAT section has no symbol after its definition to name it")}; }
    val leader: res[Id[object.Symbol], Fail] = symbol_of(c, table.nth[Entry]((key - 1)::usize));
    if (sel leader.err) { ret err[Fail].err{leader.err}; }
    val y: *object.Symbol = object.symbol_at(c.o, leader.ok);
    y.size = object.sized(size_of(c.o, sec));
    val g: res[Id[object.Group], Fail] = object.add_group(c.o, object.Group{signature: y.name, rule: rule.some});
    if (sel g.err) { ret err[Fail].err{g.err}; }
    val joined: *object.Section = object.section_at(c.o, n);
    joined.group       = opt[Id[object.Group]].some{g.ok};
    joined.disposition = ?section.WHOLE;
    ret err[Fail].ok{};
}

# the directives every directive section holds, then the data kind of each
# definition an export states DATA of
fun directives_in(c: *Conv) err[Fail] {
    var data: Table[Id[Name]] = table.make[Id[Name]](c.m.a);
    val r:    err[Fail]       = sections_directives(c, ?data);
    if (sel r.err) { ret fail.kept(r, table.release[Id[Name]](?data)); }
    ret fail.kept(coff_directive.data_in(c.o, ?data), table.release[Id[Name]](?data));
}

fun sections_directives(c: *Conv, data: *Table[Id[Name]]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[model.Section](?c.m.sections)) {
        val s: *model.Section = model.section_at(c.m, table.nth[model.Section](i));
        if (table.items[u8](?c.role)[i] == ROLE_DIRECTIVE) {
            val b: res[Bytes, Fail] = body_of(c, s);
            if (sel b.err) { ret err[Fail].err{fail.in_indexed(b.err, "section header", i::u64)}; }
            val r: err[Fail] = coff_directive.directives_in(c.m.a, c.o, b.ok.data, b.ok.len, data);
            if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section header", i::u64)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun relocs_in(c: *Conv) err[Fail] {
    var i: usize = 0;
    for (i < table.count[model.Section](?c.m.sections)) {
        val k:      usize = i;
        val mapped: u32   = table.items[u32](?c.secmap)[k];
        i = i + 1;
        var r: err[Fail] = err[Fail].ok{};
        if (mapped != 0) {
            val n:   Id[object.Section] = Id[object.Section]{index: mapped - 1};
            val sec: *object.Section    = object.section_at(c.o, n);
            r = section_relocs(c, k, object.bytes(c.o, ?sec.contents), Keep.section{n});
        }
        or (table.items[u8](?c.role)[k] == ROLE_MARK) {
            val b: res[Bytes, Fail] = body_of(c, model.section_at(c.m, table.nth[model.Section](k)));
            if (sel b.err) { r = err[Fail].err{b.err}; }
            if (sel b.ok)  { r = section_relocs(c, k, b.ok, Keep.marked{}); }
        }
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section header", k::u64)}; }
    }
    ret err[Fail].ok{};
}

# where the relocations of a section go
# ---
# section: the relocations of this neutral section
# marked:  among the mink note relocations
tag Keep: u8 {
    section: Id[object.Section];
    marked;
}

# the relocations of section header `i`, whose bytes are `data`, kept as
# `keep` says
fun section_relocs(c: *Conv, i: usize, data: Bytes, keep: Keep) err[Fail] {
    val s:     *model.Section = model.section_at(c.m, table.nth[model.Section](i));
    val count: usize          = table.count[model.Reloc](?s.relocs);
    var k:     usize          = 0;
    if ((s.flags::u64 & tables.IMAGE_SCN_LNK_NRELOC_OVFL.value) != 0 && count != 0) {
        val counted: err[Fail] = count_record(table.at[model.Reloc](?s.relocs, table.nth[model.Reloc](0)));
        if (sel counted.err) { ret err[Fail].err{fail.in_indexed(counted.err, "relocation", 0)}; }
        k = 1;
    }
    for (k < count) {
        val at:   Id[model.Reloc]         = table.nth[model.Reloc](k);
        val made: res[object.Reloc, Fail] = reloc_of(c, data, sel keep.section, at, table.at[model.Reloc](?s.relocs, at));
        var r:    err[Fail]               = err[Fail].ok{};
        if (sel made.err) { r = err[Fail].err{made.err}; }
        if (sel made.ok)  { r = reloc_kept(c, made.ok, i, keep); }
        if (sel r.err)    { ret err[Fail].err{fail.in_indexed(r.err, "relocation", k::u64)}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# refuse the record `r` that counts a section's relocations when it holds a
# symbol or type, which the conversion back writes as zero
fun count_record(r: *model.Reloc) err[Fail] {
    if (r.symbol != 0) { ret err[Fail].err{fail.valued(fail.about(fail.unsupported("the record counting a section's relocations names a symbol"), "SymbolTableIndex"), r.symbol::i128)}; }
    if (r.type != 0)   { ret err[Fail].err{fail.valued(fail.about(fail.unsupported("the record counting a section's relocations has a type"), "Type"), r.type::i128)}; }
    ret err[Fail].ok{};
}

# keep the relocation `e` of section header `i` as `keep` says
fun reloc_kept(c: *Conv, e: object.Reloc, i: usize, keep: Keep) err[Fail] {
    var kept: object.Reloc = e;
    if (sel keep.section) {
        kept.section = keep.section;
        val added: res[Id[object.Reloc], Fail] = object.add_reloc(c.o, kept);
        if (sel added.err) { ret err[Fail].err{added.err}; }
        ret err[Fail].ok{};
    }
    kept.section = Id[object.Section]{index: i::u32};
    val p: res[Id[object.Reloc], Fail] = table.push[object.Reloc](?c.marked, kept);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the relocation the record `r` states, its section left for the caller to
# name, its addend read from `data`, the bytes it patches, as its row says.
# when `data` is the neutral section's own, a field of a code the writer does
# not take for its kind is rewritten to hold the addend as the code it takes
# holds it, so the bytes read back the same
fun reloc_of(c: *Conv, data: Bytes, neutral: bool, at: Id[model.Reloc], r: *model.Reloc) res[object.Reloc, Fail] {
    var site:  Site            = Site{data: data.data, size: data.len::u64, offset: r.vaddr::u64, order: LITTLE};
    val found: res[*Row, Fail] = engine.reading(c.set, r.type::u32, ?site);
    if (sel found.err) { ret res[object.Reloc, Fail].err{fail.valued(found.err, r.type::i128)}; }
    val rw:     *Row          = found.ok;
    var target: object.Target = object.Target.none{};
    var addend: i64           = 0;
    if (sel rw.addend.record) { addend = r.symbol::i64; }
    or {
        val e: res[Id[Entry], Fail] = model.reloc_symbol(c.m, at, r);
        if (sel e.err) { ret res[object.Reloc, Fail].err{e.err}; }
        val y: res[Id[object.Symbol], Fail] = symbol_of(c, e.ok);
        if (sel y.err) { ret res[object.Reloc, Fail].err{y.err}; }
        target = object.Target.symbol{y.ok};
        if (!sel rw.addend.partner) {
            val got: res[i64, Fail] = engine.addend(rw, ?site, 0);
            if (sel got.err) { ret res[object.Reloc, Fail].err{got.err}; }
            addend = got.ok;
            if (neutral && !sel rw.write.always) {
                val w: res[*Row, Fail] = row.writing(c.set, rw.kind);
                if (sel w.err) { ret res[object.Reloc, Fail].err{w.err}; }
                val put: err[Fail] = engine.put_addend(w.ok, ?site, addend);
                if (sel put.err) { ret res[object.Reloc, Fail].err{put.err}; }
            }
        }
    }
    ret res[object.Reloc, Fail].ok{object.Reloc{offset: r.vaddr::u64, kind: rw.kind, target: target, addend: addend}};
}

# the constant-time ranges every mink note section states, marked on the
# object
fun marks_in(c: *Conv) err[Fail] {
    val n:     usize = table.count[object.Reloc](?c.marked);
    var width: u8    = 0;
    var first: usize = 0;
    var i:     usize = 0;
    for (i < table.count[u8](?c.role)) {
        val k: usize = i;
        i = i + 1;
        if (table.items[u8](?c.role)[k] != ROLE_MARK) { cnt; }
        if (width == 0) {
            val w: res[u8, Fail] = coff_mark.width_of(c.o);
            if (sel w.err) { ret err[Fail].err{fail.in_indexed(w.err, "section header", k::u64)}; }
            width = w.ok;
        }
        var count: usize = 0;
        for (first + count < n && table.items[object.Reloc](?c.marked)[first + count].section.index::usize == k) {
            count = count + 1;
        }
        val relocs: *object.Reloc = ?table.items[object.Reloc](?c.marked)[first];
        sort.sort_by[object.Reloc](relocs, count, mark.order);
        val s: *model.Section   = model.section_at(c.m, table.nth[model.Section](k));
        val b: res[Bytes, Fail] = body_of(c, s);
        if (sel b.err) { ret err[Fail].err{fail.in_indexed(b.err, "section header", k::u64)}; }
        val run: res[mark.Run, Fail] = mark.decode(c.o, b.ok, 0, s.raw_ptr::u64, width, LITTLE, relocs, count);
        if (sel run.err)           { ret err[Fail].err{fail.in_indexed(run.err, "section header", k::u64)}; }
        if (run.ok.count != count) { ret err[Fail].err{fail.in_indexed(fail.malformed("a relocation of the mink note section patches no payload"), "section header", k::u64)}; }
        first = first + count;
    }
    ret err[Fail].ok{};
}

fun convert(c: *Conv) err[Fail] {
    val b: err[Fail] = begin(c);
    if (sel b.err) { ret b; }
    val s: err[Fail] = sections_in(c);
    if (sel s.err) { ret s; }
    val y: err[Fail] = symbols_in(c);
    if (sel y.err) { ret y; }
    val f: err[Fail] = fallbacks_in(c);
    if (sel f.err) { ret f; }
    val g: err[Fail] = groups_in(c);
    if (sel g.err) { ret g; }
    val d: err[Fail] = directives_in(c);
    if (sel d.err) { ret d; }
    val r: err[Fail] = relocs_in(c);
    if (sel r.err) { ret r; }
    ret marks_in(c);
}

# add what the object model holds to `o`, which holds nothing yet, its
# relocations read through the rows of `reg`. the conversion builds a blank
# object and commits it to `o` once it succeeds, so a refusal leaves `o` as
# it was
pub fun to_neutral(m: *Coff, reg: *Registry, o: *Object) err[Fail] {
    if (!object.empty(o)) { ret err[Fail].err{fail.internal("a model converts into an empty neutral object")}; }
    var built: Object    = object.blank(o);
    var c:     Conv      = Conv{m: m, o: ?built, reg: reg, secmap: table.make[u32](m.a), role: table.make[u8](m.a), marked: table.make[object.Reloc](m.a), symmap: table.make[u32](m.a), defs: table.make[u32](m.a), keys: table.make[u32](m.a)};
    var r:     err[Fail] = convert(?c);
    r = fail.kept(r, table.release[u32](?c.secmap));
    r = fail.kept(r, table.release[u8](?c.role));
    r = fail.kept(r, table.release[object.Reloc](?c.marked));
    r = fail.kept(r, table.release[u32](?c.symmap));
    r = fail.kept(r, table.release[u32](?c.defs));
    r = fail.kept(r, table.release[u32](?c.keys));
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?built);
        ret r;
    }
    ret object.commit(o, ?built);
}

# a record of the symbol table the build writes, in order
# ---
# neutral: the neutral symbol of this index
# section: the section definition the build adds for the section of this index
# key:     the signature symbol the build adds for the COMDAT section of this index
tag Emit: u8 {
    neutral: u32;
    section: u32;
    key:     u32;
}

# what a section's definition states of its group
# ---
# selection: the COMDAT selection, zero for a section that is not COMDAT
# number:    the one based number of the section an associative section follows
# leader:    whether the section carries its group's signature symbol
rec Comdat {
    selection: u8;
    number:    u32;
    leader:    bool;
}

# the model being built
# ---
# a:          the allocator of the model and the working tables
# o:          the neutral object, or its lowered copy
# lowering:   the encodings its records are lowered in
# copy:       the lowered copy, none when the object has no records or ranges
# mark:       the section of the copy that holds its constant-time ranges,
#             none when it has none
# reg:        the relocation rows of every pair, borrowed
# target:     what the model is built for
# pair:       what COFF states for the target's architecture
# set:        the relocation rows of the target's architecture
# m:          the model
# nsec:       how many neutral sections there are
# nsym:       how many neutral symbols there are
# total:      how many sections the model has, the directive section among them
# directives: the text of the directive section, empty for none
# comdat:     per neutral section, what its definition states of its group
# firsts:     per group, its first member plus one
# differ:     per neutral section, the characteristics a fact flips from the
#             derived ones, with bit 32 set when a fact states them
# sums:       per neutral section, the checksum a fact states, with bit 32 set
#             when a fact states it
# numbers:    per neutral section, the section number a fact states its
#             definition names, with bit 32 set when a fact states it
# classes:    per neutral symbol, the storage class a fact states, with bit 8
#             set when a fact states it
# types:      per neutral symbol, the type a fact states, with bit 16 set when
#             a fact states it
# defs:       per neutral section, the symbol that defines it plus one
# keys:       per neutral section, its signature symbol plus one
# after:      per neutral section, the first symbol placed in it after its
#             definition plus one
# moved:      per neutral symbol, whether it is written right after its
#             section's definition rather than in order
# emits:      the records of the symbol table, auxiliary records aside, in order
# perm:       per neutral symbol, the index of its record
# snames:     per symbol table record, its name in the string table plus one,
#             zero for a name held in the record
# secnames:   per section, its name in the string table plus one, zero for a
#             name held in the header
# names:      the string table
rec Build {
    a:          *A.Allocator;
    o:          *Object;
    lowering:   opt[*Lowering];
    copy:       opt[Object];
    mark:       opt[usize];
    reg:        *Registry;
    target:     *Target;
    pair:       *Pair;
    set:        *Lookup;
    m:          Coff;
    nsec:       usize;
    nsym:       usize;
    total:      usize;
    directives: Sink;
    comdat:     Table[Comdat];
    firsts:     Table[u32];
    differ:     Table[u64];
    sums:       Table[u64];
    numbers:    Table[u64];
    classes:    Table[u16];
    types:      Table[u32];
    defs:       Table[u32];
    keys:       Table[u32];
    after:      Table[u32];
    moved:      Table[bool];
    emits:      Table[Emit];
    perm:       Table[u32];
    snames:     Table[u32];
    secnames:   Table[u32];
    names:      Strtab;
}

val FACT_BIT: u64 = 0x1_0000_0000;

fun unsupported(text: str) err[Fail] {
    ret err[Fail].err{fail.unsupported(text)};
}

fun grow_u32(t: *Table[u32], n: usize) err[Fail] {
    val g: res[Id[u32], Fail] = table.grow[u32](t, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    ret err[Fail].ok{};
}

fun grow_u64(t: *Table[u64], n: usize) err[Fail] {
    val g: res[Id[u64], Fail] = table.grow[u64](t, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    ret err[Fail].ok{};
}

fun begin_build(b: *Build) err[Fail] {
    val o: *Object = b.o;
    if (table.count[object.Entry](?o.entries) != 0)                              { ret unsupported("COFF has no index spaces"); }
    if (table.count[object.Note](?o.notes) != 0)                                 { ret unsupported("COFF has no notes"); }
    if (sel o.library.some || table.count[object.Dependency](?o.libraries) != 0) { ret unsupported("a COFF object names a library only by a directive"); }
    if (table.count[Trait](?o.traits) != 0)                                      { ret unsupported("COFF encodes no trait"); }
    if (o.target.arch != b.target.arch) {
        ret err[Fail].err{fail.about(fail.unsupported("the object is for another architecture than the target"), o.target.arch.name)};
    }
    val code: opt[*Code] = arch.code(b.target.arch, ?format.COFF);
    if (sel code.none) { ret err[Fail].err{fail.about(fail.unsupported("the architecture has no COFF machine"), b.target.arch.name)}; }
    b.m.header.machine = code.some.fields[0].value::u16;
    val p: res[*Pair, Fail] = coff_pairs.of(b.target.arch);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    b.pair = p.ok;
    val set: res[*Lookup, Fail] = row.find(b.reg, ?format.COFF, b.target.arch);
    if (sel set.err) { ret err[Fail].err{set.err}; }
    b.set = set.ok;
    val l: err[Fail] = lowered(b);
    if (sel l.err) { ret l; }
    b.nsec = table.count[object.Section](?b.o.sections);
    b.nsym = table.count[object.Symbol](?b.o.symbols);
    val d: res[usize, Fail] = coff_directive.directives_of(b.o, b.target, ?b.directives);
    if (sel d.err) { ret err[Fail].err{d.err}; }
    b.total = b.nsec;
    if (sink.len(?b.directives) != 0) { b.total = b.total + 1; }
    if (b.total > SECTION_MAX) {
        b.m.shape.object   = ?model.BIGOBJ;
        b.m.header.version = tables.BIGOBJ_MIN_VERSION.value::u16;
    }
    if (b.total > 0x7fff_ffff) { ret err[Fail].err{fail.overflow("COFF numbers at most 2147483647 sections")}; }
    val gc: res[Id[Comdat], Fail] = table.grow[Comdat](?b.comdat, b.nsec);
    if (sel gc.err) { ret err[Fail].err{gc.err}; }
    val g1: err[Fail] = grow_u32(?b.firsts, table.count[object.Group](?b.o.groups));
    if (sel g1.err) { ret g1; }
    val g2: err[Fail] = grow_u64(?b.differ, b.nsec);
    if (sel g2.err) { ret g2; }
    val g3: err[Fail] = grow_u64(?b.sums, b.nsec);
    if (sel g3.err) { ret g3; }
    val gn: err[Fail] = grow_u64(?b.numbers, b.nsec);
    if (sel gn.err) { ret gn; }
    val g4: res[Id[u16], Fail] = table.grow[u16](?b.classes, b.nsym);
    if (sel g4.err) { ret err[Fail].err{g4.err}; }
    val g5: err[Fail] = grow_u32(?b.types, b.nsym);
    if (sel g5.err) { ret g5; }
    val g6: err[Fail] = grow_u32(?b.defs, b.nsec);
    if (sel g6.err) { ret g6; }
    val g7: err[Fail] = grow_u32(?b.keys, b.nsec);
    if (sel g7.err) { ret g7; }
    val g8: err[Fail] = grow_u32(?b.after, b.nsec);
    if (sel g8.err) { ret g8; }
    val g9: res[Id[bool], Fail] = table.grow[bool](?b.moved, b.nsym);
    if (sel g9.err) { ret err[Fail].err{g9.err}; }
    val g10: err[Fail] = grow_u32(?b.perm, b.nsym);
    if (sel g10.err) { ret g10; }
    ret grow_u32(?b.secnames, b.total);
}

# build from a copy of the object with its records lowered in the encodings
# the lowering names and its constant-time ranges lowered into the mink note
# section, last, so the object the caller handed over stays as it was. an
# object with neither is built from as it is
fun lowered(b: *Build) err[Fail] {
    val records: bool                          = object.has_records(b.o);
    val marked:  bool                          = table.count[object.CtRange](?b.o.ct) != 0;
    val to:      res[frame.Destinations, Fail] = lower.destinations(b.lowering, b.o);
    if (sel to.err) { ret err[Fail].err{to.err}; }
    val frames: bool = table.count[object.Frame](?b.o.frames) != 0;
    val framed: bool = frames && frame.has(to.ok, ?frame.UNWIND);
    if (frames && !framed && sel b.o.frame_to.none) { ret unsupported("the lowering gives the object's frames no destination"); }
    if (!records && !marked && !framed)             { ret err[Fail].ok{}; }
    val c: res[Object, Fail] = object.copy(b.a, b.o);
    if (sel c.err) { ret err[Fail].err{c.err}; }
    b.copy = opt[Object].some{c.ok};
    if (sel b.copy.some) { b.o = ?b.copy.some; }
    val e: err[Fail] = encode.apply(b.lowering, b.o, b.set, b.pair.mapping);
    if (sel e.err) { ret e; }
    if (framed) {
        val u: err[Fail] = unwound(b);
        if (sel u.err) { ret u; }
    }
    if (!marked) { ret err[Fail].ok{}; }
    val at:  usize     = table.count[object.Section](?b.o.sections);
    var low: Lowered   = lower_lowered.make(b.a);
    var r:   err[Fail] = coff_mark.lower(b.o, ?low);
    if (!(sel r.err)) { r = lower_lowered.apply(b.o, ?low); }
    r = fail.kept(r, lower_lowered.release(?low));
    if (sel r.err) { ret r; }
    b.mark = opt[usize].some{at};
    ret err[Fail].ok{};
}

# the frames of the object as its machine's function table and unwind data,
# in the form COFF offers its unwind destination
fun unwound(b: *Build) err[Fail] {
    var o: opt[*FrameOffer] = opt[*FrameOffer].none{};
    if (sel b.lowering.some) {
        if (sel b.lowering.some.frame.some) { o = lower.offer(?b.lowering.some.frame.some, ?frame.UNWIND); }
    }
    if (sel o.none)                 { ret err[Fail].err{fail.unsupported("the lowering offers frames no unwind destination")}; }
    if (!(sel o.some.form.windows)) { ret err[Fail].err{fail.unsupported("a COFF object writes unwind data only as a function table")}; }
    val t: opt[*model.FunctionTable] = model.function_table(b.m.header.machine::u64);
    if (sel t.none) { ret err[Fail].err{fail.valued(fail.unsupported("the machine has no function table to unwind its frames by"), b.m.header.machine::i128)}; }
    var low: Lowered   = lower_lowered.make(b.a);
    var r:   err[Fail] = coff_unwind.lower(b.o, t.some, b.set, ?low);
    if (!(sel r.err)) { r = lower_lowered.apply(b.o, ?low); }
    ret fail.kept(r, lower_lowered.release(?low));
}

fun facts_out(b: *Build) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Fact](?b.o.facts)) {
        val f: *Fact = table.at[Fact](?b.o.facts, table.nth[Fact](i));
        i = i + 1;
        if (f.format != ?format.COFF) { cnt; }
        val r: err[Fail] = fact_out(b, f);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "fact", (i - 1)::u64)}; }
    }
    ret err[Fail].ok{};
}

fun twice() err[Fail] {
    ret err[Fail].err{fail.malformed("two facts state one value")};
}

fun fact_out(b: *Build, f: *Fact) err[Fail] {
    val v: u64 = f.value;
    if (f.key == coff_fact.TIMESTAMP) {
        if (v > 0xffff_ffff) { ret err[Fail].err{fail.valued(fail.overflow("the timestamp does not fit its field"), v::i128)}; }
        b.m.header.timestamp = v::u32;
        ret err[Fail].ok{};
    }
    if (f.key == coff_fact.CHARACTERISTICS) {
        if (v > 0xffff)                         { ret err[Fail].err{fail.valued(fail.overflow("the file characteristics do not fit their field"), v::i128)}; }
        if (b.m.shape.object != ?model.REGULAR) { ret unsupported("a bigobj states no file characteristics"); }
        b.m.header.characteristics = v::u16;
        ret err[Fail].ok{};
    }
    if (f.key == coff_fact.SECTION || f.key == coff_fact.CHECKSUM || f.key == coff_fact.NUMBER) {
        val n: u64 = v >> 32;
        if (n >= b.nsec::u64) { ret err[Fail].err{fail.malformed("fact names a section the object does not have")}; }
        var slot: *u64 = ?table.items[u64](?b.differ)[n::usize];
        if (f.key == coff_fact.CHECKSUM) { slot = ?table.items[u64](?b.sums)[n::usize]; }
        if (f.key == coff_fact.NUMBER)   { slot = ?table.items[u64](?b.numbers)[n::usize]; }
        if (@slot != 0)                  { ret twice(); }
        @slot = FACT_BIT | (v & 0xffff_ffff);
        ret err[Fail].ok{};
    }
    if (f.key == coff_fact.CLASS) {
        val n: u64 = v >> 8;
        if (n >= b.nsym::u64) { ret err[Fail].err{fail.malformed("fact names a symbol the object does not have")}; }
        val slot: *u16 = ?table.items[u16](?b.classes)[n::usize];
        if (@slot != 0) { ret twice(); }
        @slot = (0x100 | (v & 0xff))::u16;
        ret err[Fail].ok{};
    }
    if (f.key == coff_fact.TYPE) {
        val n: u64 = v >> 16;
        if (n >= b.nsym::u64) { ret err[Fail].err{fail.malformed("fact names a symbol the object does not have")}; }
        val slot: *u32 = ?table.items[u32](?b.types)[n::usize];
        if (@slot != 0) { ret twice(); }
        @slot = (0x1_0000 | (v & 0xffff))::u32;
        ret err[Fail].ok{};
    }
    ret err[Fail].err{fail.valued(fail.unsupported("COFF fact has no meaning"), f.key::i128)};
}

# what each section's definition states of its group. the first member of a
# group that is not associative is its COMDAT section, of the group's
# selection, and every other member is associative to it. a member of an
# associative group follows its leader
fun groups_prep(b: *Build) err[Fail] {
    var i: usize = 0;
    for (i < b.nsec) {
        val r: err[Fail] = group_prep(b, i);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun group_prep(b: *Build, i: usize) err[Fail] {
    val sec: *object.Section = object.section_at(b.o, Id[object.Section]{index: i::u32});
    val c:   *Comdat         = ?table.items[Comdat](?b.comdat)[i];
    if (sel sec.group.none) {
        if (sel sec.owner.some) { ret unsupported("COFF ties a section to another only by an associative COMDAT selection"); }
        ret err[Fail].ok{};
    }
    val g: Id[object.Group] = sec.group.some;
    if (g.index::usize >= table.count[object.Group](?b.o.groups)) { ret err[Fail].err{fail.malformed("section is in a group the object does not have")}; }
    val grp: *object.Group = object.group_at(b.o, g);
    if (group.has(grp.rule, group.ASSOCIATIVE)) {
        if (sel grp.leader.none) { ret err[Fail].err{fail.malformed("associative group has no leader section")}; }
        val lead: Id[object.Section] = grp.leader.some;
        if (lead.index::usize >= b.nsec || lead.index::usize == i) { ret err[Fail].err{fail.malformed("associative group follows a section the object does not have")}; }
        if (sel sec.owner.some) {
            if (sec.owner.some.index != lead.index) { ret unsupported("COFF ties a section only to the leader its associative selection names"); }
        }
        c.selection = tables.IMAGE_COMDAT_SELECT_ASSOCIATIVE.value::u8;
        c.number    = lead.index + 1;
        ret err[Fail].ok{};
    }
    if (sel sec.owner.some) { ret unsupported("COFF ties a section to another only by an associative COMDAT selection"); }
    val first: *u32 = ?table.items[u32](?b.firsts)[g.index::usize];
    if (@first != 0) {
        c.selection = tables.IMAGE_COMDAT_SELECT_ASSOCIATIVE.value::u8;
        c.number    = @first;
        ret err[Fail].ok{};
    }
    val sel_code: opt[u8] = selection_of(grp.rule);
    if (sel sel_code.none) { ret err[Fail].err{fail.about(fail.unsupported("COFF has no COMDAT selection for this group rule"), grp.rule.name)}; }
    c.selection = sel_code.some;
    c.leader    = true;
    @first      = (i + 1)::u32;
    ret err[Fail].ok{};
}

# the neutral section a symbol is placed in, none for a symbol placed in none
fun placed_section(b: *Build, s: *object.Symbol) opt[usize] {
    val d: Definition = s.def;
    if (sel d.placed) {
        if (d.placed.section.index::usize < b.nsec) { ret opt[usize].some{d.placed.section.index::usize}; }
    }
    ret opt[usize].none{};
}

# the signature of the group of COMDAT section `n`
fun signature_of(b: *Build, n: usize) opt[Id[Name]] {
    val sec: *object.Section = object.section_at(b.o, Id[object.Section]{index: n::u32});
    if (sel sec.group.some) { ret opt[Id[Name]].some{object.group_at(b.o, sec.group.some).signature}; }
    ret opt[Id[Name]].none{};
}

# each section's definition, the symbol after it and each COMDAT section's
# signature symbol, the one named for its group, after its definition when
# one is
fun symbols_scan(b: *Build) err[Fail] {
    var k: usize = 0;
    for (k < b.nsym) {
        val s:  *object.Symbol = object.symbol_at(b.o, Id[object.Symbol]{index: k::u32});
        val at: opt[usize]     = placed_section(b, s);
        k = k + 1;
        if (sel at.none) { cnt; }
        val n:   usize = at.some;
        val def: *u32  = ?table.items[u32](?b.defs)[n];
        if (s.kind == ?symbol.SECTIONS) {
            if (@def != 0) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a section has two section symbols"), "symbol", (k - 1)::u64)}; }
            @def = k::u32;
            cnt;
        }
        val after: *u32 = ?table.items[u32](?b.after)[n];
        if (@def != 0 && @after == 0)                  { @after = k::u32; }
        if (!table.items[Comdat](?b.comdat)[n].leader) { cnt; }
        val sig: opt[Id[Name]] = signature_of(b, n);
        if (sel sig.none)                   { cnt; }
        if (s.name.index != sig.some.index) { cnt; }
        val key: *u32 = ?table.items[u32](?b.keys)[n];
        if (@key == 0 || (@def != 0 && @key < @def)) { @key = k::u32; }
    }
    ret err[Fail].ok{};
}

# whether the signature symbol of COMDAT section `n` is, in order, the first
# symbol placed in it after its definition, as the reader takes it
fun natural(b: *Build, n: usize) bool {
    val def: u32 = table.items[u32](?b.defs)[n];
    val key: u32 = table.items[u32](?b.keys)[n];
    ret def != 0 && key != 0 && table.items[u32](?b.after)[n] == key;
}

fun emit(b: *Build, e: Emit) err[Fail] {
    val p: res[Id[Emit], Fail] = table.push[Emit](?b.emits, e);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the order of the symbol table: every neutral symbol in order, a definition
# added for a COMDAT section that has none, and a COMDAT section's signature
# symbol, added when it has none, moved right after its definition when it
# would not be the first symbol in it after the definition
fun order_out(b: *Build) err[Fail] {
    var n: usize = 0;
    for (n < b.nsec) {
        val c: Comdat = table.items[Comdat](?b.comdat)[n];
        if (c.selection != 0 && table.items[u32](?b.defs)[n] == 0) {
            if (!c.leader) {
                val e: err[Fail] = emit(b, Emit.section{n::u32});
                if (sel e.err) { ret e; }
            }
            or (table.items[u32](?b.keys)[n] == 0) {
                val e: err[Fail] = emit(b, Emit.section{n::u32});
                if (sel e.err) { ret e; }
                val y: err[Fail] = emit(b, Emit.key{n::u32});
                if (sel y.err) { ret y; }
            }
        }
        if (c.leader && table.items[u32](?b.defs)[n] != 0 && table.items[u32](?b.keys)[n] != 0 && !natural(b, n)) {
            table.items[bool](?b.moved)[(table.items[u32](?b.keys)[n] - 1)::usize] = true;
        }
        n = n + 1;
    }
    var k: usize = 0;
    for (k < b.nsym) {
        val r: err[Fail] = order_symbol(b, k);
        if (sel r.err) { ret r; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

fun order_symbol(b: *Build, k: usize) err[Fail] {
    if (table.items[bool](?b.moved)[k]) { ret err[Fail].ok{}; }
    val s:  *object.Symbol = object.symbol_at(b.o, Id[object.Symbol]{index: k::u32});
    val at: opt[usize]     = placed_section(b, s);
    if (sel at.some) {
        val n: usize  = at.some;
        val c: Comdat = table.items[Comdat](?b.comdat)[n];
        if (s.kind == ?symbol.SECTIONS && c.leader && !natural(b, n)) {
            val e: err[Fail] = emit(b, Emit.neutral{k::u32});
            if (sel e.err) { ret e; }
            val key: u32 = table.items[u32](?b.keys)[n];
            if (key != 0) { ret emit(b, Emit.neutral{key - 1}); }
            ret emit(b, Emit.key{n::u32});
        }
        if (c.leader && table.items[u32](?b.keys)[n] == (k + 1)::u32 && table.items[u32](?b.defs)[n] == 0) {
            val e: err[Fail] = emit(b, Emit.section{n::u32});
            if (sel e.err) { ret e; }
        }
    }
    ret emit(b, Emit.neutral{k::u32});
}

# the auxiliary records the record of `e` takes
fun naux_of(b: *Build, e: Emit) res[usize, Fail] {
    if (sel e.section) { ret res[usize, Fail].ok{1}; }
    if (sel e.key)     { ret res[usize, Fail].ok{0}; }
    var k: u32 = 0;
    if (sel e.neutral) { k = e.neutral; }
    val s: *object.Symbol = object.symbol_at(b.o, Id[object.Symbol]{index: k});
    if (s.kind == ?symbol.SECTIONS || sel s.fallback.some) { ret res[usize, Fail].ok{1}; }
    if (s.kind != ?symbol.SOURCE)                          { ret res[usize, Fail].ok{0}; }
    val size: usize = b.m.shape.object.symbol.size;
    val len:  usize = object.name_of(b.o, s.name).len;
    val n:    usize = (len + size - 1) / size;
    if (n > 0xff) { ret res[usize, Fail].err{fail.unsupported("a file name runs past the auxiliary records a symbol takes")}; }
    ret res[usize, Fail].ok{n};
}

# the record index of every neutral symbol
fun perm_out(b: *Build) err[Fail] {
    var at: usize = 0;
    var i:  usize = 0;
    for (i < table.count[Emit](?b.emits)) {
        val e: Emit = table.items[Emit](?b.emits)[i];
        if (sel e.neutral) { table.items[u32](?b.perm)[e.neutral::usize] = at::u32; }
        val n: res[usize, Fail] = naux_of(b, e);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        at = at + 1 + n.ok;
        i  = i + 1;
    }
    if (at > 0xffff_ffff) { ret err[Fail].err{fail.overflow("the symbol table holds more records than COFF counts")}; }
    ret err[Fail].ok{};
}

# whether `v` holds a NUL byte
fun holds_nul(v: View) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the name of a section header, held in its eight bytes, or else the string
# table's, whose offset the header states once the table is finished
fun section_name_out(b: *Build, at: usize, v: View, h: *model.Section) err[Fail] {
    if (holds_nul(v)) { ret err[Fail].err{fail.malformed("a section name holds a NUL byte")}; }
    if (v.len <= 8 && (v.len == 0 || v.data[0] != '/')) {
        var i: usize = 0;
        for (i < v.len) {
            h.name[i] = v.data[i];
            i         = i + 1;
        }
        ret err[Fail].ok{};
    }
    val id: res[Id[Name], Fail] = strtab.add(?b.names, v.data, v.len);
    if (sel id.err) { ret err[Fail].err{id.err}; }
    table.items[u32](?b.secnames)[at] = id.ok.index + 1;
    ret err[Fail].ok{};
}

fun sections_out(b: *Build) err[Fail] {
    var i: usize = 0;
    for (i < b.nsec) {
        val r: err[Fail] = section_out(b, i);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section", i::u64)}; }
        i = i + 1;
    }
    if (sink.len(?b.directives) == 0) { ret err[Fail].ok{}; }
    var h: model.Section = model.make_section(b.a);
    h.flags = (tables.IMAGE_SCN_LNK_INFO.value | tables.IMAGE_SCN_LNK_REMOVE.value | ((1::u64) << ALIGN_SHIFT))::u32;
    val pushed: res[Id[model.Section], Fail] = table.push[model.Section](?b.m.sections, h);
    if (sel pushed.err) {
        val dropped: err[Fail] = release_section(?h);
        ret err[Fail].err{pushed.err};
    }
    val name: str       = ".drectve";
    val w:    err[Fail] = section_name_out(b, b.nsec, View{data: name::*u8, len: 8}, model.section_at(?b.m, pushed.ok));
    if (sel w.err) { ret w; }
    ret bytes_out(b, b.nsec, sink.data(?b.directives), sink.len(?b.directives));
}

fun release_section(s: *model.Section) err[Fail] {
    val r1: err[Fail] = table.release[model.Reloc](?s.relocs);
    ret fail.kept(r1, table.release[model.Line](?s.lines));
}

# the bytes of section `at`, which the model owns
fun bytes_out(b: *Build, at: usize, p: *u8, n: usize) err[Fail] {
    if (n > 0xffff_ffff) { ret err[Fail].err{fail.overflow("a section holds more bytes than its header counts")}; }
    val h: *model.Section = model.section_at(?b.m, table.nth[model.Section](at));
    h.raw_size = n::u32;
    if (n == 0) { ret err[Fail].ok{}; }
    val held: res[Held, Fail] = model.own(?b.m, p, n);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    model.section_at(?b.m, table.nth[model.Section](at)).body = Body.raw{Raw{bytes: held.ok, why: Why.opaque{}}};
    ret err[Fail].ok{};
}

# the kind and flags a section is written with
rec Written {
    kind:  *section.Kind;
    flags: section.Flags;
}

# what `sec` is written as: a section of a kind COFF merges in no section as
# the kind of its borrowed naming row, its element size and the flags that set
# its kind dropped, as the row states, and any other as itself, refusing an
# element size. a section whose row removes it from the image is written
# excluded
fun written_as(sec: *object.Section) res[Written, Fail] {
    if (section.keyed(sec.kind)) {
        val row: res[*naming.Row, Fail] = naming.row_of(section.key_of(sec.kind, sec.entsize));
        if (sel row.err) { ret res[Written, Fail].err{row.err}; }
        val k: *section.Kind = row.ok.kind;
        ret res[Written, Fail].ok{Written{kind: k, flags: (sec.flags & ~(sec.kind.flags & ~k.flags)) | removed(row.ok)}};
    }
    if (sec.entsize != 0) { ret res[Written, Fail].err{fail.unsupported("COFF states no entry size")}; }
    val row: res[*naming.Row, Fail] = naming.row_of(section.key_of(sec.kind, 0));
    if (sel row.ok) { ret res[Written, Fail].ok{Written{kind: sec.kind, flags: sec.flags | removed(row.ok)}}; }
    ret res[Written, Fail].ok{Written{kind: sec.kind, flags: sec.flags}};
}

# the exclusion a section written by row `r` reads back with
fun removed(r: *naming.Row) section.Flags {
    ret naming.flags_of(r.characteristics) & section.EXCLUDE;
}

fun section_out(b: *Build, i: usize) err[Fail] {
    val sec: *object.Section = object.section_at(b.o, Id[object.Section]{index: i::u32});
    if (sel sec.priority.some) { ret unsupported("COFF states no section priority"); }
    val as: res[Written, Fail] = written_as(sec);
    if (sel as.err) { ret err[Fail].err{as.err}; }
    val named: res[View, Fail] = object.section_name(b.o, sec, naming.name_of);
    if (sel named.err) { ret err[Fail].err{named.err}; }
    val name: Bytes = Bytes{data: named.ok.data, len: named.ok.len};
    if (sel b.mark.some && b.mark.some == i) { ret mark_out(b, i, named.ok); }
    if (naming.directive(name))              { ret unsupported("a section of the directive section's name would read back as directives"); }
    if (naming.mark(name))                   { ret unsupported("a section of the mink note section's name would read back as constant-time ranges"); }
    val derived: res[u64, Fail] = characteristics(section.Key{kind: as.ok.kind}, as.ok.flags, sec.align);
    if (sel derived.err) { ret err[Fail].err{derived.err}; }
    var ch: u64 = derived.ok ^ (table.items[u64](?b.differ)[i] & 0xffff_ffff);
    if ((ch & STRUCTURE) != 0)                            { ret err[Fail].err{fail.malformed("a section fact states what the structure states")}; }
    if (table.items[Comdat](?b.comdat)[i].selection != 0) { ch = ch | tables.IMAGE_SCN_LNK_COMDAT.value; }
    val back: res[*section.Kind, Fail] = naming.classify(name, naming.type_of(ch), naming.flags_of(ch));
    if (sel back.err)                                                         { ret err[Fail].err{back.err}; }
    if (back.ok != naming.read_back(as.ok.kind))                              { ret err[Fail].err{fail.about(fail.unsupported("COFF names no section of this kind by this name"), sec.kind.name)}; }
    if ((naming.flags_of(ch) | (back.ok.flags & section.TLS)) != as.ok.flags) { ret unsupported("COFF has no characteristics for the section's flags"); }
    val align: res[u64, Fail] = alignment_of(ch);
    if (sel align.err)         { ret err[Fail].err{align.err}; }
    if (align.ok != sec.align) { ret unsupported("COFF has no characteristics for the section's alignment"); }
    var h: model.Section = model.make_section(b.a);
    h.flags = ch::u32;
    val pushed: res[Id[model.Section], Fail] = table.push[model.Section](?b.m.sections, h);
    if (sel pushed.err) {
        val dropped: err[Fail] = release_section(?h);
        ret err[Fail].err{pushed.err};
    }
    val w: err[Fail] = section_name_out(b, i, named.ok, model.section_at(?b.m, pushed.ok));
    if (sel w.err) { ret w; }
    val c: Contents = sec.contents;
    if (sel c.zero) {
        if ((ch & tables.IMAGE_SCN_CNT_UNINITIALIZED_DATA.value) != 0) {
            if (c.zero > 0xffff_ffff) { ret err[Fail].err{fail.overflow("a section holds more bytes than its header counts")}; }
            model.section_at(?b.m, pushed.ok).raw_size = c.zero::u32;
            ret err[Fail].ok{};
        }
        if (c.zero > 0xffff_ffff) { ret err[Fail].err{fail.overflow("a section holds more bytes than its header counts")}; }
        var zeros: Sink      = sink.make(b.a, LITTLE);
        val z:     err[Fail] = sink.zeros(?zeros, c.zero::usize);
        var r:     err[Fail] = z;
        if (sel z.ok) { r = bytes_out(b, i, sink.data(?zeros), sink.len(?zeros)); }
        ret fail.kept(r, sink.release(?zeros));
    }
    val bytes: Bytes = object.bytes(b.o, ?sec.contents);
    ret bytes_out(b, i, bytes.data, bytes.len);
}

# the mink note section `i`, which the lowering made and no fact or group
# names
fun mark_out(b: *Build, i: usize, name: View) err[Fail] {
    val sec: *object.Section = object.section_at(b.o, Id[object.Section]{index: i::u32});
    var h:   model.Section   = model.make_section(b.a);
    h.flags = coff_mark.CHARACTERISTICS::u32;
    val pushed: res[Id[model.Section], Fail] = table.push[model.Section](?b.m.sections, h);
    if (sel pushed.err) {
        val dropped: err[Fail] = release_section(?h);
        ret err[Fail].err{pushed.err};
    }
    val w: err[Fail] = section_name_out(b, i, name, model.section_at(?b.m, pushed.ok));
    if (sel w.err) { ret w; }
    val bytes: Bytes = object.bytes(b.o, ?sec.contents);
    ret bytes_out(b, i, bytes.data, bytes.len);
}

# the relocation records of each section, in order, an extended count first
# where a section has more than its header counts
fun relocs_out(b: *Build) err[Fail] {
    var counts: Table[u32] = table.make[u32](b.a);
    val r:      err[Fail]  = relocs_counted(b, ?counts);
    ret fail.kept(r, table.release[u32](?counts));
}

fun relocs_counted(b: *Build, counts: *Table[u32]) err[Fail] {
    val g: err[Fail] = grow_u32(counts, b.nsec);
    if (sel g.err) { ret g; }
    val n: usize = table.count[object.Reloc](?b.o.relocs);
    var i: usize = 0;
    for (i < n) {
        val r: *object.Reloc = table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](i));
        if (r.section.index::usize >= b.nsec) { ret err[Fail].err{fail.in_indexed(fail.malformed("relocation names a section the object does not have"), "relocation", i::u64)}; }
        val c: *u32 = ?table.items[u32](counts)[r.section.index::usize];
        @c = @c + 1;
        i  = i + 1;
    }
    var s: usize = 0;
    for (s < b.nsec) {
        val count: u32            = table.items[u32](counts)[s];
        val h:     *model.Section = model.section_at(?b.m, table.nth[model.Section](s));
        if (count >= 0xffff) {
            h.flags  = h.flags | tables.IMAGE_SCN_LNK_NRELOC_OVFL.value::u32;
            h.nreloc = 0xffff;
            val p: res[Id[model.Reloc], Fail] = table.push[model.Reloc](?h.relocs, model.Reloc{vaddr: count + 1});
            if (sel p.err) { ret err[Fail].err{p.err}; }
        }
        or { h.nreloc = count::u16; }
        s = s + 1;
    }
    i = 0;
    for (i < n) {
        val r: err[Fail] = reloc_out(b, table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](i)));
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "relocation", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun reloc_out(b: *Build, r: *object.Reloc) err[Fail] {
    if (sel r.minus.some)       { ret unsupported("COFF has no relocation of a difference"); }
    if (r.offset > 0xffff_ffff) { ret err[Fail].err{fail.overflow("a relocation's offset does not fit its record")}; }
    val found: res[*Row, Fail] = row.targeting(b.set, r.kind, false);
    if (sel found.err) { ret err[Fail].err{found.err}; }
    val rw: *Row = found.ok;
    if (rw.key > 0xffff) { ret err[Fail].err{fail.overflow("relocation code is wider than the record holds")}; }
    val tg: object.Target = r.target;
    if (sel tg.entry)    { ret unsupported("COFF has no index spaces to relocate against"); }
    if (sel tg.absolute) { ret unsupported("COFF has no relocation against the absolute address zero"); }
    var sym: u64 = 0;
    if (sel rw.addend.record) {
        if (!sel tg.none)                           { ret unsupported("a relocation whose record holds its addend refers to nothing"); }
        if (r.addend < 0 || r.addend > 0xffff_ffff) { ret err[Fail].err{fail.valued(fail.overflow("the addend does not fit the record's symbol field"), r.addend::i128)}; }
        sym = r.addend::u64;
    }
    or {
        if (sel tg.none) {
            val none: res[u64, Fail] = pair.write_nameless(b.pair);
            if (sel none.err) { ret err[Fail].err{none.err}; }
            sym = none.ok;
        }
        or (sel tg.symbol) {
            if (tg.symbol.index::usize >= b.nsym) { ret err[Fail].err{fail.malformed("relocation names a symbol the object does not have")}; }
            sym = table.items[u32](?b.perm)[tg.symbol.index::usize]::u64;
        }
        if (sym > 0xffff_ffff) { ret err[Fail].err{fail.overflow("a relocation's symbol index does not fit its record")}; }
        if (sel rw.addend.partner) {
            if (r.addend != 0) { ret unsupported("a relocation whose partner holds its addend has none of its own"); }
        }
        or {
            val h:    *model.Section = model.section_at(?b.m, table.nth[model.Section](r.section.index::usize));
            var data: Bytes          = Bytes{data: nil, len: 0};
            if (sel h.body.raw) { data = model.bytes(?b.m, ?h.body.raw.bytes); }
            var site: Site      = Site{data: data.data, size: data.len::u64, offset: r.offset, order: LITTLE};
            val put:  err[Fail] = engine.put_addend(rw, ?site, r.addend);
            if (sel put.err) { ret put; }
        }
    }
    val h: *model.Section             = model.section_at(?b.m, table.nth[model.Section](r.section.index::usize));
    val p: res[Id[model.Reloc], Fail] = table.push[model.Reloc](?h.relocs, model.Reloc{vaddr: r.offset::u32, symbol: sym::u32, type: rw.key::u16});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the record of a symbol named `v`, its name held in the record when it fits
# and else in the string table
fun named_record(b: *Build, v: View, y: model.Symbol) err[Fail] {
    if (holds_nul(v)) { ret err[Fail].err{fail.malformed("a symbol name holds a NUL byte")}; }
    var s:  model.Symbol = y;
    var id: u32          = 0;
    if (v.len != 0 && v.len <= 8) {
        var i: usize = 0;
        for (i < v.len) {
            s.name[i] = v.data[i];
            i         = i + 1;
        }
    }
    or {
        val got: res[Id[Name], Fail] = strtab.add(?b.names, v.data, v.len);
        if (sel got.err) { ret err[Fail].err{got.err}; }
        id = got.ok.index + 1;
    }
    val p: res[Id[Entry], Fail] = table.push[Entry](?b.m.symbols, Entry.symbol{s});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    val q: res[Id[u32], Fail] = table.push[u32](?b.snames, id);
    if (sel q.err) { ret err[Fail].err{q.err}; }
    ret err[Fail].ok{};
}

fun aux_record(b: *Build, a: Aux) err[Fail] {
    val p: res[Id[Entry], Fail] = table.push[Entry](?b.m.symbols, Entry.aux{a});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    val q: res[Id[u32], Fail] = table.push[u32](?b.snames, 0);
    if (sel q.err) { ret err[Fail].err{q.err}; }
    ret err[Fail].ok{};
}

# the section definition of section `n`: its size and counts, its checksum
# and what it states of its group
fun section_aux(b: *Build, n: usize) res[Aux, Fail] {
    val h:    *model.Section = model.section_at(?b.m, table.nth[model.Section](n));
    val c:    Comdat         = table.items[Comdat](?b.comdat)[n];
    var sum:  u32            = 0;
    val fact: u64            = table.items[u64](?b.sums)[n];
    if (fact != 0)      { sum = (fact & 0xffff_ffff)::u32; }
    or (sel h.body.raw) { sum = checksum_of(model.bytes(?b.m, ?h.body.raw.bytes)); }
    var number: u32 = c.number;
    if (c.selection::u64 != tables.IMAGE_COMDAT_SELECT_ASSOCIATIVE.value) {
        number = (n + 1)::u32;
        val stated: u64 = table.items[u64](?b.numbers)[n];
        if (stated != 0) { number = (stated & 0xffff_ffff)::u32; }
    }
    var a: SectionAux = SectionAux{length: h.raw_size, nreloc: h.nreloc, checksum: sum, number: (number & 0xffff)::u16, selection: c.selection};
    if (b.m.shape.object.symbol.section.width > 2) { a.number_high = (number >> 16)::u16; }
    or (number > 0xffff)                           { ret res[Aux, Fail].err{fail.valued(fail.overflow("a section number does not fit a regular object's section definition"), number::i128)}; }
    ret res[Aux, Fail].ok{Aux.section{a}};
}

fun section_number(n: usize) i32 {
    ret (n + 1)::i32;
}

fun def_out(b: *Build, n: usize) err[Fail] {
    val sec: *object.Section = object.section_at(b.o, Id[object.Section]{index: n::u32});
    val v:   res[View, Fail] = object.section_name(b.o, sec, naming.name_of);
    if (sel v.err) { ret err[Fail].err{v.err}; }
    val r: err[Fail] = named_record(b, v.ok, model.Symbol{section: section_number(n), class: tables.IMAGE_SYM_CLASS_STATIC.value::u8, naux: 1});
    if (sel r.err) { ret r; }
    val a: res[Aux, Fail] = section_aux(b, n);
    if (sel a.err) { ret err[Fail].err{a.err}; }
    ret aux_record(b, a.ok);
}

fun key_out(b: *Build, n: usize) err[Fail] {
    val sig: opt[Id[Name]] = signature_of(b, n);
    if (sel sig.none) { ret err[Fail].err{fail.internal("a COMDAT section lost its group")}; }
    ret named_record(b, object.name_of(b.o, sig.some), model.Symbol{section: section_number(n), class: tables.IMAGE_SYM_CLASS_STATIC.value::u8});
}

fun symbols_out(b: *Build) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Emit](?b.emits)) {
        val e: Emit = table.items[Emit](?b.emits)[i];
        if (sel e.section) {
            val r: err[Fail] = def_out(b, e.section::usize);
            if (sel r.err) { ret r; }
        }
        or (sel e.key) {
            val r: err[Fail] = key_out(b, e.key::usize);
            if (sel r.err) { ret r; }
        }
        or (sel e.neutral) {
            val r: err[Fail] = symbol_out(b, e.neutral::usize);
            if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "symbol", e.neutral::u64)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun symbol_out(b: *Build, k: usize) err[Fail] {
    val s: *object.Symbol = object.symbol_at(b.o, Id[object.Symbol]{index: k::u32});
    if (s.retain)                                                                                 { ret unsupported("COFF retains a section, not a symbol"); }
    if (s.alt_entry)                                                                              { ret unsupported("COFF has no alternate entry symbol"); }
    if (sel s.version.some)                                                                       { ret unsupported("COFF has no symbol versions"); }
    if (s.visibility != ?symbol.DEFAULT)                                                          { ret err[Fail].err{fail.about(fail.unsupported("COFF has no symbol visibility"), s.visibility.name)}; }
    if (s.binding != ?symbol.LOCAL && s.binding != ?symbol.GLOBAL && s.binding != ?symbol.WEAKLY) { ret err[Fail].err{fail.about(fail.unsupported("COFF has no symbol binding of this name"), s.binding.name)}; }
    val k_ok: bool = s.kind == ?symbol.NOTYPE || s.kind == ?symbol.FUNCTION || s.kind == ?symbol.DATA || s.kind == ?symbol.SECTIONS || s.kind == ?symbol.SOURCE || s.kind == ?symbol.TLS || s.kind == ?symbol.COMMONS;
    if (!k_ok)                                                { ret err[Fail].err{fail.about(fail.unsupported("COFF has no symbol kind of this name"), s.kind.name)}; }
    if ((s.binding == ?symbol.WEAKLY) != sel s.fallback.some) { ret unsupported("a COFF weak external is exactly a weak symbol with a fallback"); }
    val stated_class: u16          = table.items[u16](?b.classes)[k];
    val stated_type:  u32          = table.items[u32](?b.types)[k];
    var y:            model.Symbol = model.Symbol{
        class: derived_class(s.binding, s.kind)::u8,
        type:  type_of(s.kind),
    };
    if (stated_class != 0) { y.class = (stated_class & 0xff)::u8; }
    if (stated_type != 0)  { y.type = (stated_type & 0xffff)::u16; }
    val d:  Definition = s.def;
    var at: usize      = 0;
    if (sel d.entry)                                 { ret unsupported("COFF has no index spaces"); }
    if ((s.kind == ?symbol.COMMONS) != sel d.common) { ret unsupported("a COFF common symbol is exactly one of a common block"); }
    if (sel d.undefined) {
        if (s.binding == ?symbol.LOCAL) { ret unsupported("a COFF symbol that is undefined is external"); }
    }
    or (sel d.common) {
        if (s.binding != ?symbol.GLOBAL)                       { ret unsupported("a COFF common symbol is global"); }
        if (d.common.size == 0 || d.common.size > 0xffff_ffff) { ret err[Fail].err{fail.valued(fail.unsupported("COFF states a common block of 1 to 4294967295 bytes"), d.common.size::i128)}; }
        if (d.common.align > common_align(d.common.size))      { ret err[Fail].err{fail.valued(fail.unsupported("COFF aligns a common block by its size, below the alignment it states"), d.common.align::i128)}; }
        y.value = d.common.size::u32;
    }
    or (sel d.absolute) {
        if (d.absolute > 0xffff_ffff) { ret err[Fail].err{fail.valued(fail.overflow("an absolute value does not fit a COFF symbol"), d.absolute::i128)}; }
        y.value   = d.absolute::u32;
        y.section = (tables.IMAGE_SYM_ABSOLUTE.value:~i64)::i32;
        if (s.kind == ?symbol.SOURCE) { y.section = (tables.IMAGE_SYM_DEBUG.value:~i64)::i32; }
    }
    or (sel d.placed) {
        if (d.placed.section.index::usize >= b.nsec) { ret err[Fail].err{fail.malformed("symbol is placed in a section the object does not have")}; }
        if (d.placed.offset > 0xffff_ffff)           { ret err[Fail].err{fail.overflow("a symbol's offset does not fit a COFF symbol")}; }
        y.value   = d.placed.offset::u32;
        y.section = section_number(d.placed.section.index::usize);
        at        = d.placed.section.index::usize;
    }
    if (s.kind == ?symbol.SOURCE) {
        if (s.binding != ?symbol.LOCAL || !sel d.absolute) { ret unsupported("a COFF file symbol is local and absolute"); }
        ret file_out(b, object.name_of(b.o, s.name), y);
    }
    if (s.kind == ?symbol.SECTIONS) {
        if (s.binding != ?symbol.LOCAL || !sel d.placed || y.value != 0) { ret unsupported("a COFF section symbol is local and at its section's start"); }
        y.naux = 1;
        val name: res[View, Fail] = section_symbol_name(b, s, at);
        if (sel name.err) { ret err[Fail].err{name.err}; }
        val r: err[Fail] = named_record(b, name.ok, y);
        if (sel r.err) { ret r; }
        val a: res[Aux, Fail] = section_aux(b, at);
        if (sel a.err) { ret err[Fail].err{a.err}; }
        ret aux_record(b, a.ok);
    }
    if (sel s.fallback.some) {
        if (!sel d.undefined) { ret unsupported("a COFF weak external is undefined"); }
        val fb: object.Fallback = s.fallback.some;
        if (fb.symbol.index::usize >= b.nsym) { ret err[Fail].err{fail.malformed("a fallback names a symbol the object does not have")}; }
        val code: opt[u32] = search_code(fb.search);
        if (sel code.none) { ret err[Fail].err{fail.about(fail.unsupported("COFF has no weak external search of this name"), fb.search.name)}; }
        y.naux = 1;
        val r: err[Fail] = named_record(b, object.name_of(b.o, s.name), y);
        if (sel r.err) { ret r; }
        ret aux_record(b, Aux.weak{model.WeakAux{tag_index: table.items[u32](?b.perm)[fb.symbol.index::usize], characteristics: code.some}});
    }
    ret named_record(b, object.name_of(b.o, s.name), y);
}

# the name of the section symbol `s` of section `n`: its own, or for one with
# none, its section's, as COFF names a section's definition
fun section_symbol_name(b: *Build, s: *object.Symbol, n: usize) res[View, Fail] {
    val own: View = object.name_of(b.o, s.name);
    if (own.len != 0) { ret res[View, Fail].ok{own}; }
    ret object.section_name(b.o, object.section_at(b.o, Id[object.Section]{index: n::u32}), naming.name_of);
}

# a file symbol, named .file, and the records that spell its file name
fun file_out(b: *Build, name: View, y: model.Symbol) err[Fail] {
    if (holds_nul(name)) { ret err[Fail].err{fail.malformed("a file name holds a NUL byte")}; }
    val size: usize        = b.m.shape.object.symbol.size;
    val n:    usize        = (name.len + size - 1) / size;
    var s:    model.Symbol = y;
    s.naux = n::u8;
    val dot: str       = ".file";
    val r:   err[Fail] = named_record(b, View{data: dot::*u8, len: 5}, s);
    if (sel r.err) { ret r; }
    var at: usize = 0;
    var k:  usize = 0;
    for (k < n) {
        var bytes: [20]u8;
        var i:     usize = 0;
        for (i < size && at < name.len) {
            bytes[i] = name.data[at];
            i        = i + 1;
            at       = at + 1;
        }
        val w: err[Fail] = aux_record(b, Aux.file{bytes});
        if (sel w.err) { ret w; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the decimal digits of `v` from `at` in a header name
fun decimal_name(h: *model.Section, v: u64) {
    var digits: [8]u8;
    var n:      usize = 0;
    var x:      u64   = v;
    for {
        digits[n] = '0' + (x % 10)::u8;
        n         = n + 1;
        x         = x / 10;
        if (x == 0) { brk; }
    }
    h.name[0] = '/';
    var i: usize = 0;
    for (i < n) {
        h.name[1 + i] = digits[n - 1 - i];
        i             = i + 1;
    }
}

val BASE64: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

# the six base 64 digits of `v` after `//` in a header name
fun base64_name(h: *model.Section, v: u64) {
    h.name[0] = '/';
    h.name[1] = '/';
    var i: usize = 0;
    for (i < 6) {
        h.name[2 + i] = BASE64[((v >> ((5 - i)::u64 * 6)) & 63)::usize];
        i             = i + 1;
    }
}

# fix the string table and every name that lies in it
fun names_out(b: *Build) err[Fail] {
    val f: err[Fail] = strtab.finish(?b.names);
    if (sel f.err) { ret f; }
    var i: usize = 0;
    for (i < b.total) {
        val id: u32 = table.items[u32](?b.secnames)[i];
        if (id != 0) {
            val at: u64            = strtab.offset(?b.names, Id[Name]{index: id - 1}) + 4;
            val h:  *model.Section = model.section_at(?b.m, table.nth[model.Section](i));
            if (at <= 9_999_999)       { decimal_name(h, at); }
            or (at < ((1::u64) << 36)) { base64_name(h, at); }
            or                         { ret err[Fail].err{fail.overflow("a section name lies past the offsets a header states")}; }
        }
        i = i + 1;
    }
    var k: usize = 0;
    for (k < table.count[Entry](?b.m.symbols)) {
        val id: u32 = table.items[u32](?b.snames)[k];
        if (id != 0) {
            val at: u64 = strtab.offset(?b.names, Id[Name]{index: id - 1}) + 4;
            if (at > 0xffff_ffff) { ret err[Fail].err{fail.overflow("a symbol name lies past the offsets a symbol states")}; }
            val e: *Entry = table.at[Entry](?b.m.symbols, table.nth[Entry](k));
            if (sel e.symbol) {
                var j: usize = 0;
                for (j < 4) {
                    e.symbol.name[j]     = 0;
                    e.symbol.name[4 + j] = ((at >> (j::u64 * 8)) & 0xff)::u8;
                    j                    = j + 1;
                }
            }
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

fun extent(b: *Build, e: Extent) err[Fail] {
    val p: res[Id[Extent], Fail] = table.push[Extent](?b.m.extents, e);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# lay the file out: the header, the section table, each section's bytes and
# relocations, the symbol table and the string table
fun layout_out(b: *Build) err[Fail] {
    var out: Sink      = sink.make(b.a, LITTLE);
    val w:   err[Fail] = strtab.write(?b.names, ?out);
    var r:   err[Fail] = w;
    if (sel w.ok) { r = laid_out(b, ?out); }
    ret fail.kept(r, sink.release(?out));
}

fun laid_out(b: *Build, strings: *Sink) err[Fail] {
    val held: res[Held, Fail] = model.own(?b.m, sink.data(strings), sink.len(strings));
    if (sel held.err) { ret err[Fail].err{held.err}; }
    var at: u64       = b.m.shape.object.header.size::u64 + model.SECTION_SIZE * b.total::u64;
    val e1: err[Fail] = extent(b, Extent.header{});
    if (sel e1.err) { ret e1; }
    val e2: err[Fail] = extent(b, Extent.sections{});
    if (sel e2.err) { ret e2; }
    var i: usize = 0;
    for (i < b.total) {
        val id: Id[model.Section] = table.nth[model.Section](i);
        val h:  *model.Section    = model.section_at(?b.m, id);
        if (sel h.body.raw) {
            h.raw_ptr = at::u32;
            at        = at + h.raw_size::u64;
            val e: err[Fail] = extent(b, Extent.section{id});
            if (sel e.err) { ret e; }
        }
        val n: usize = table.count[model.Reloc](?h.relocs);
        if (n != 0) {
            h.reloc_ptr = at::u32;
            at          = at + n::u64 * model.RELOC_SIZE;
            val e: err[Fail] = extent(b, Extent.relocs{id});
            if (sel e.err) { ret e; }
        }
        if (at > 0xffff_ffff) { ret err[Fail].err{fail.overflow("the file is larger than COFF offsets reach")}; }
        i = i + 1;
    }
    val count: usize = table.count[Entry](?b.m.symbols);
    b.m.header.nsections  = b.total::u32;
    b.m.header.symtab_ptr = at::u32;
    b.m.header.nsymbols   = count::u32;
    at                    = at + count::u64 * b.m.shape.object.symbol.size::u64 + 4 + sink.len(strings)::u64;
    if (at > 0xffff_ffff) { ret err[Fail].err{fail.overflow("the file is larger than COFF offsets reach")}; }
    val e3: err[Fail] = extent(b, Extent.symbols{});
    if (sel e3.err) { ret e3; }
    ret extent(b, Extent.strings{held.ok});
}

fun build(b: *Build) err[Fail] {
    val s: err[Fail] = begin_build(b);
    if (sel s.err) { ret s; }
    val f: err[Fail] = facts_out(b);
    if (sel f.err) { ret f; }
    val g: err[Fail] = groups_prep(b);
    if (sel g.err) { ret g; }
    val sc: err[Fail] = symbols_scan(b);
    if (sel sc.err) { ret sc; }
    val o: err[Fail] = order_out(b);
    if (sel o.err) { ret o; }
    val p: err[Fail] = perm_out(b);
    if (sel p.err) { ret p; }
    val se: err[Fail] = sections_out(b);
    if (sel se.err) { ret se; }
    val r: err[Fail] = relocs_out(b);
    if (sel r.err) { ret r; }
    val y: err[Fail] = symbols_out(b);
    if (sel y.err) { ret y; }
    val n: err[Fail] = names_out(b);
    if (sel n.err) { ret n; }
    ret layout_out(b);
}

fun release_build(b: *Build) err[Fail] {
    var first: err[Fail] = sink.release(?b.directives);
    first = fail.kept(first, table.release[Comdat](?b.comdat));
    first = fail.kept(first, table.release[u32](?b.firsts));
    first = fail.kept(first, table.release[u64](?b.differ));
    first = fail.kept(first, table.release[u64](?b.sums));
    first = fail.kept(first, table.release[u64](?b.numbers));
    first = fail.kept(first, table.release[u16](?b.classes));
    first = fail.kept(first, table.release[u32](?b.types));
    first = fail.kept(first, table.release[u32](?b.defs));
    first = fail.kept(first, table.release[u32](?b.keys));
    first = fail.kept(first, table.release[u32](?b.after));
    first = fail.kept(first, table.release[bool](?b.moved));
    first = fail.kept(first, table.release[Emit](?b.emits));
    first = fail.kept(first, table.release[u32](?b.perm));
    first = fail.kept(first, table.release[u32](?b.snames));
    first = fail.kept(first, table.release[u32](?b.secnames));
    first = fail.kept(first, strtab.release(?b.names));
    if (sel b.copy.some) { first = fail.kept(first, object.release(?b.copy.some)); }
    ret first;
}

# the object model of `o` for the target `t`, laid out for the writer, the
# records `o` states lowered into it in the encodings `lowering` names and its
# relocations written through the rows of `reg`. `o` stays as it was
pub fun from_neutral(a: *A.Allocator, reg: *Registry, o: *Object, t: *Target, lowering: opt[*Lowering]) res[Coff, Fail] {
    var b: Build = Build{
        a:          a,
        o:          o,
        lowering:   lowering,
        reg:        reg,
        target:     t,
        m:          model.make(a, Shape{object: ?model.REGULAR, image: opt[*model.ImageShape].none{}}),
        mark:       opt[usize].none{},
        directives: sink.make(a, LITTLE),
        comdat:     table.make[Comdat](a),
        firsts:     table.make[u32](a),
        differ:     table.make[u64](a),
        sums:       table.make[u64](a),
        numbers:    table.make[u64](a),
        classes:    table.make[u16](a),
        types:      table.make[u32](a),
        defs:       table.make[u32](a),
        keys:       table.make[u32](a),
        after:      table.make[u32](a),
        moved:      table.make[bool](a),
        emits:      table.make[Emit](a),
        perm:       table.make[u32](a),
        snames:     table.make[u32](a),
        secnames:   table.make[u32](a),
        names:      strtab.make(a, strtab.Convention{lead: false, term: strtab.NUL}),
    };
    val r:   err[Fail] = build(?b);
    val rel: err[Fail] = release_build(?b);
    if (sel r.err) {
        val dropped: err[Fail] = model.release(?b.m);
        ret res[Coff, Fail].err{r.err};
    }
    if (sel rel.err) {
        val dropped: err[Fail] = model.release(?b.m);
        ret res[Coff, Fail].err{rel.err};
    }
    ret res[Coff, Fail].ok{b.m};
}

# push rbp, call rel32, pop rbp, ret, and padding
val CODE_BYTES: [16]u8 = [16]u8{0x55, 0xe8, 0, 0, 0, 0, 0x5d, 0xc3, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc};

fun add_section(o: *Object, name: str, k: *section.Kind, flags: section.Flags, bytes: *u8, size: u64, d: *section.Disposition) res[Id[object.Section], Fail] {
    var named: opt[Id[Name]] = opt[Id[Name]].none{};
    if (name != nil) {
        val nm: res[Id[Name], Fail] = object.name_str(o, name);
        if (sel nm.err) { ret res[Id[object.Section], Fail].err{nm.err}; }
        named = opt[Id[Name]].some{nm.ok};
    }
    var contents: Contents = Contents.zero{size};
    if (bytes != nil) {
        val held: res[Contents, Fail] = object.own(o, bytes, size::usize);
        if (sel held.err) { ret res[Id[object.Section], Fail].err{held.err}; }
        contents = held.ok;
    }
    ret object.add_section(o, object.Section{name: named, kind: k, flags: flags, align: 8, contents: contents, disposition: d});
}

fun add_symbol(o: *Object, name: str, b: *symbol.Binding, k: *symbol.Kind, def: Definition, size: opt[u64]) res[Id[object.Symbol], Fail] {
    val nm: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel nm.err) { ret res[Id[object.Symbol], Fail].err{nm.err}; }
    ret object.add_symbol(o, object.Symbol{name: nm.ok, binding: b, visibility: ?symbol.DEFAULT, kind: k, def: def, size: size});
}

fun at_start(s: Id[object.Section]) Definition {
    ret Definition.placed{Place{section: s, offset: 0}};
}

fun add_reloc(o: *Object, sec: Id[object.Section], at: u64, k: *reloc.Kind, sym: Id[object.Symbol], addend: i64) res[Id[object.Reloc], Fail] {
    ret object.add_reloc(o, object.Reloc{section: sec, offset: at, kind: k, target: object.Target.symbol{sym}, addend: addend});
}

# the neutral object of the COFF file `bytes`
fun read_back(a: *A.Allocator, reg: *Registry, bytes: *Sink, arch: *Arch) res[Object, Fail] {
    var in: Input             = Input{file: "t.obj", data: sink.data(bytes), len: sink.len(bytes)};
    val rd: res[Parsed, Fail] = read.read(a, ?in);
    if (sel rd.err) { ret res[Object, Fail].err{rd.err}; }
    var p: Parsed = rd.ok;
    if (!sel p.object) { ret res[Object, Fail].err{fail.internal("a COFF object read back as another kind")}; }
    var back: Object    = object.make(a, arch, ?catalog_kind.RELOCATABLE);
    val conv: err[Fail] = to_neutral(?p.object, reg, ?back);
    val rel:  err[Fail] = model.release(?p.object);
    if (sel conv.err) {
        val dropped: err[Fail] = object.release(?back);
        ret res[Object, Fail].err{conv.err};
    }
    if (sel rel.err) {
        val dropped: err[Fail] = object.release(?back);
        ret res[Object, Fail].err{rel.err};
    }
    ret res[Object, Fail].ok{back};
}

# a COMDAT section of `rule` named `name`, its section symbol and its
# signature symbol `key`, which takes the section's size
fun comdat(o: *Object, name: str, key: str, rule: *group.Rule) res[Id[object.Section], Fail] {
    val sec: res[Id[object.Section], Fail] = add_section(o, name, ?section.TEXT, section.ALLOC | section.EXEC, ?CODE_BYTES[0], 16, ?section.WHOLE);
    if (sel sec.err) { ret sec; }
    val def: res[Id[object.Symbol], Fail] = add_symbol(o, name, ?symbol.LOCAL, ?symbol.SECTIONS, at_start(sec.ok), opt[u64].none{});
    if (sel def.err) { ret res[Id[object.Section], Fail].err{def.err}; }
    val k: res[Id[object.Symbol], Fail] = add_symbol(o, key, ?symbol.GLOBAL, ?symbol.FUNCTION, at_start(sec.ok), opt[u64].some{16});
    if (sel k.err) { ret res[Id[object.Section], Fail].err{k.err}; }
    val g: res[Id[object.Group], Fail] = object.add_group(o, object.Group{signature: object.symbol_at(o, k.ok).name, rule: rule});
    if (sel g.err) { ret res[Id[object.Section], Fail].err{g.err}; }
    object.section_at(o, sec.ok).group = opt[Id[object.Group]].some{g.ok};
    ret sec;
}
