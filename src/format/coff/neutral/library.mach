# a short import object to and from the neutral object
#
# a short import object is the interface of one export of a DLL, so its
# neutral form is an object describing a library: the DLL by its name, and the
# symbols the import type defines, as import.TYPES rows them. the pointer, the
# symbol name under the pointer prefix, names the import address table slot,
# and a type that defines the symbol name too names by it code jumping through
# the slot or the slot again. every symbol states how the loader finds the
# export: by its ordinal for an import by ordinal, and otherwise by the name
# its name type derives and its hint. an ARM64EC import defines its pointer
# and name without the ARM64EC mark, which x64 code reaches it through, and
# for code also the auxiliary pointer and the name in its ARM64EC form, which
# native code reaches it through. an ARM64X import, of a hybrid of two
# architectures, is refused, as is writing an ARM64EC import back.
#
# describe makes the same object of a claim that names a DLL, with no file:
# the DLL by the claim's name as written, and for each symbol the claim
# provides the symbols an import of it by name with a hint of zero defines,
# which sends the loader to the DLL's export name table. a function, and a
# symbol of no stated sort, take the code import type, which defines the
# symbol name and its pointer, so a call and a load through the pointer reach
# it alike, and a variable the data type, which defines the pointer alone, as
# imported data is reached only through it. a DLL import states no version,
# so the versions a claim may state are not read.
#
# from_neutral writes such an object back: the import type the symbols state,
# the plain name type when the export name is the symbol name and the export
# as name type when it is any other, and the ordinal or the hint in the one
# field the header has for them.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;
use std.memory;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.catalog.arch.Code;
use mink.catalog.format;
use mink.catalog.kind;
use mink.catalog.os.Host;
use mink.catalog.trait.Trait;
use mink.format.coff.import.import;
use mink.format.coff.import.import.Import;
use mink.format.coff.import.import.NameRule;
use mink.format.coff.import.import.TypeRule;
use mink.format.coff.model.tables;
use mink.format.coff.neutral.neutral;
use mink.model.claim;
use mink.model.claim.Claim;
use mink.model.object;
use mink.model.object.Definition;
use mink.model.object.Export;
use mink.model.object.Library;
use mink.model.object.Named;
use mink.model.object.Object;
use mink.model.object.Symbol;
use mink.model.symbol;
use mink.model.target.Target;

# add the library the short import object `i` describes to `o`, which holds
# nothing yet. a refusal leaves `o` as it was
pub fun to_neutral(i: *Import, o: *Object) err[Fail] {
    if (!object.is_empty(o)) { ret err[Fail].err{fail.internal("a model converts into an empty neutral object")}; }
    var built:       Object    = object.blank_init(o);
    val err_convert: err[Fail] = convert(i, ?built);
    if (sel err_convert.err) {
        val err_dropped: err[Fail] = object.dnit(?built);
        ret err[Fail].err{fail.in_record(err_convert.err, "import object")};
    }
    ret object.commit(o, ?built);
}

# fill `o`, an empty object of the stub kind, with the DLL the claim `cl`
# names and each symbol it provides, as describe states. a refusal leaves `o`
# to its caller to release
pub fun describe(o: *Object, cl: *Claim, h: *Host) err[Fail] {
    val opt_code: opt[*Code] = arch.code(o.target.arch, ?format.COFF);
    if (sel opt_code.none) { ret err[Fail].err{fail.about(fail.unsupported("the architecture has no COFF machine"), o.target.arch.name)}; }
    val machine: u16   = opt_code.some.fields[0].value::u16;
    val dll:     Bytes = Bytes{data: cl.name.data, len: cl.name.len};
    var k:       usize = 0;
    for (k < cl.symbol_count) {
        val p: *claim.Provided = ?cl.symbols[k];
        k = k + 1;
        var e: import.Export = import.Export{name: Bytes{data: p.name.data, len: p.name.len}, ordinal: 0, kind: tables.IMPORT_OBJECT_CODE.value::u16, name_type: tables.IMPORT_OBJECT_NAME.value::u16};
        if (sel p.sort.data) { e.kind = tables.IMPORT_OBJECT_DATA.value::u16; }
        val res_made: res[Import, Fail] = import.init(o.a, machine, dll, ?e);
        if (sel res_made.err) { ret err[Fail].err{fail.in_indexed(res_made.err, "claimed symbol", (k - 1)::u64)}; }
        var i:           Import    = res_made.ok;
        val err_convert: err[Fail] = convert(?i, o);
        val err_release: err[Fail] = import.dnit(?i);
        if (sel err_convert.err) { ret err[Fail].err{fail.in_indexed(err_convert.err, "claimed symbol", (k - 1)::u64)}; }
        if (sel err_release.err) { ret err_release; }
    }
    if (cl.symbol_count != 0) { ret err[Fail].ok{}; }
    val res_loader: res[Id[Name], Fail] = object.name(o, dll.data, dll.len);
    if (sel res_loader.err) { ret err[Fail].err{res_loader.err}; }
    o.library = opt[Library].some{Library{loader: opt[Id[Name]].some{res_loader.ok}}};
    ret err[Fail].ok{};
}

fun convert(i: *Import, o: *Object) err[Fail] {
    val res_arch_of: res[*arch.Arch, Fail] = neutral.arch_of(i.machine);
    if (sel res_arch_of.err) { ret err[Fail].err{fail.valued(fail.about(res_arch_of.err, "machine"), i.machine::i128)}; }
    o.target.arch = res_arch_of.ok;
    val opt_typed: opt[*TypeRule] = import.type_of(import.kind(i));
    if (sel opt_typed.none) {
        ret err[Fail].err{fail.valued(fail.about(fail.unsupported("import type is not one the specification names"), "import type"), import.kind(i)::i128)};
    }
    val opt_rule: opt[*NameRule] = import.rule_of(import.name_type(i));
    if (sel opt_rule.none) {
        ret err[Fail].err{fail.valued(fail.about(fail.unsupported("import name type is not one the specification names"), "name type"), import.name_type(i)::i128)};
    }
    val dll:        Bytes               = import.bytes(i, ?i.dll);
    val res_loader: res[Id[Name], Fail] = object.name(o, dll.data, dll.len);
    if (sel res_loader.err) { ret err[Fail].err{res_loader.err}; }
    o.library = opt[Library].some{Library{loader: opt[Id[Name]].some{res_loader.ok}}};
    val res_found: res[Export, Fail] = export_of(i, o);
    if (sel res_found.err) { ret err[Fail].err{res_found.err}; }
    val name: Bytes = import.bytes(i, ?i.symbol);
    if (import.mangles(i.machine::u64)) { ret native(i, o, name, opt_typed.some, res_found.ok); }
    var err_under: err[Fail] = under(o, ?tables.IMPORT_POINTER_PREFIX, name, ?symbol.ADDRESS, res_found.ok);
    if (sel err_under.err)     { ret err_under; }
    if (!opt_typed.some.named) { ret err_under; }
    var k: *symbol.Kind = ?symbol.ADDRESS;
    if (opt_typed.some.thunk) { k = ?symbol.FUNCTION; }
    ret define(o, name, k, res_found.ok);
}

# the symbols of an ARM64EC import of the symbol name `name`, which may be
# spelled in its ARM64EC form: its pointer and, for a type that defines the
# name, the name, each under the name without its ARM64EC mark, which an x64
# caller reaches the import through, and for code also the auxiliary pointer
# and the name in its ARM64EC form, which a native caller reaches it through
# ("ARM64EC function name decoration", overview of ARM64EC ABI conventions)
fun native(i: *Import, o: *Object, name: Bytes, typed: *TypeRule, e: Export) err[Fail] {
    val parts:     import.Spelled = import.ec_demangled(name);
    var plain:     Sink           = sink.init(o.a, LITTLE);
    var err_bytes: err[Fail]      = sink.bytes(?plain, parts.first.data, parts.first.len);
    err_bytes = fail.kept(err_bytes, sink.bytes(?plain, parts.second.data, parts.second.len));
    if (sel err_bytes.err) { ret fail.kept(err_bytes, sink.dnit(?plain)); }
    val err_native_symbols: err[Fail] = native_symbols(o, name, Bytes{data: sink.data(?plain), len: sink.len(?plain)}, typed, e);
    ret fail.kept(err_native_symbols, sink.dnit(?plain));
}

fun native_symbols(o: *Object, name: Bytes, plain: Bytes, typed: *TypeRule, e: Export) err[Fail] {
    val err_under: err[Fail] = under(o, ?tables.IMPORT_POINTER_PREFIX, plain, ?symbol.ADDRESS, e);
    if (sel err_under.err) { ret err_under; }
    if (!typed.named)      { ret err_under; }
    if (!typed.thunk)      { ret define(o, plain, ?symbol.ADDRESS, e); }
    val err_define: err[Fail] = define(o, plain, ?symbol.FUNCTION, e);
    if (sel err_define.err) { ret err_define; }
    val err_under_import_aux_prefix: err[Fail] = under(o, ?tables.IMPORT_AUX_PREFIX, plain, ?symbol.NATIVE_ADDRESS, e);
    if (sel err_under_import_aux_prefix.err) { ret err_under_import_aux_prefix; }
    if (name.len != plain.len)               { ret define(o, name, ?symbol.NATIVE_FUNCTION, e); }
    if (name.len != 0 && name.data[0] == tables.ARM64EC_CPP_MARK.data[0]) {
        ret err[Fail].err{fail.unsupported("an ARM64EC import of a C++ name needs its ARM64EC spelling")};
    }
    var marked:    Sink      = sink.init(o.a, LITTLE);
    var err_bytes: err[Fail] = sink.bytes(?marked, tables.ARM64EC_CODE_MARK.data, tables.ARM64EC_CODE_MARK.len);
    err_bytes = fail.kept(err_bytes, sink.bytes(?marked, plain.data, plain.len));
    if (sel err_bytes.err) { ret fail.kept(err_bytes, sink.dnit(?marked)); }
    val err_define_bytes: err[Fail] = define(o, Bytes{data: sink.data(?marked), len: sink.len(?marked)}, ?symbol.NATIVE_FUNCTION, e);
    ret fail.kept(err_define_bytes, sink.dnit(?marked));
}

# a symbol named `name` under the prefix `prefix`, of the kind `k`, that the
# library defines and the loader finds as `e` says
fun under(o: *Object, prefix: *tables.Blob, name: Bytes, k: *symbol.Kind, e: Export) err[Fail] {
    var spelled:   Sink      = sink.init(o.a, LITTLE);
    var err_bytes: err[Fail] = sink.bytes(?spelled, prefix.data, prefix.len);
    err_bytes = fail.kept(err_bytes, sink.bytes(?spelled, name.data, name.len));
    if (sel err_bytes.err) { ret fail.kept(err_bytes, sink.dnit(?spelled)); }
    val err_define: err[Fail] = define(o, Bytes{data: sink.data(?spelled), len: sink.len(?spelled)}, k, e);
    ret fail.kept(err_define, sink.dnit(?spelled));
}

# how the loader finds the export of `i`: by its ordinal where its name type
# derives no name, and by the name and the hint otherwise
fun export_of(i: *Import, o: *Object) res[Export, Fail] {
    val res_name: res[opt[Bytes], Fail] = import.imported_name(i);
    if (sel res_name.err) { ret res[Export, Fail].err{res_name.err}; }
    val opt_name: opt[Bytes] = res_name.ok;
    if (sel opt_name.none) { ret res[Export, Fail].ok{Export.ordinal{i.hint}}; }
    val res_name_data: res[Id[Name], Fail] = object.name(o, opt_name.some.data, opt_name.some.len);
    if (sel res_name_data.err) { ret res[Export, Fail].err{res_name_data.err}; }
    ret res[Export, Fail].ok{Export.named{Named{name: res_name_data.ok, hint: opt[u16].some{i.hint}}}};
}

# a global symbol of `o` named `name`, of the kind `k`, that the library
# defines and the loader finds as `e` says
fun define(o: *Object, name: Bytes, k: *symbol.Kind, e: Export) err[Fail] {
    val res_name: res[Id[Name], Fail] = object.name(o, name.data, name.len);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    val res_add_symbol: res[Id[Symbol], Fail] = object.add_symbol(o, Symbol{name: res_name.ok, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: k, def: Definition.library{e}});
    if (sel res_add_symbol.err) { ret err[Fail].err{res_add_symbol.err}; }
    ret err[Fail].ok{};
}

# the short import object of the library object `o` for the target `t`. its
# names are its own, and `o` stays as it was
pub fun from_neutral(a: *A.Allocator, o: *Object, lib: Library, t: *Target) res[Import, Fail] {
    val res_made: res[Import, Fail] = built(a, o, lib, t);
    if (sel res_made.err) { ret res[Import, Fail].err{fail.in_record(res_made.err, "import object")}; }
    var i:       Import    = res_made.ok;
    val err_own: err[Fail] = owned(?i);
    if (sel err_own.err) {
        val err_dropped: err[Fail] = import.dnit(?i);
        ret res[Import, Fail].err{err_own.err};
    }
    ret res[Import, Fail].ok{i};
}

# what the symbols of a library object state of one import
# ---
# pointer: the symbol naming the slot
# other:   the symbol of the symbol name, nil when the type defines none
# export:  how the loader finds the export both state
rec Symbols {
    pointer: *Symbol;
    other:   *Symbol;
    export:  Export;
}

fun built(a: *A.Allocator, o: *Object, lib: Library, t: *Target) res[Import, Fail] {
    if (sel lib.versions.some)                             { ret res[Import, Fail].err{fail.unsupported("an import object states no versions of its DLL")}; }
    if (table.count[object.Dependency](?o.libraries) != 0) { ret res[Import, Fail].err{fail.unsupported("an import object re-exports no library")}; }
    val opt_loader: opt[Id[Name]] = lib.loader;
    if (sel opt_loader.none) { ret res[Import, Fail].err{fail.unsupported("an import object names its DLL")}; }
    if (!only_symbols(o))    { ret res[Import, Fail].err{fail.unsupported("an import object holds only the symbols of its import")}; }
    if (o.target.arch != t.arch) {
        ret res[Import, Fail].err{fail.about(fail.unsupported("the object is for another architecture than the target"), o.target.arch.name)};
    }
    val opt_code: opt[*Code] = arch.code(t.arch, ?format.COFF);
    if (sel opt_code.none) { ret res[Import, Fail].err{fail.about(fail.unsupported("the architecture has no COFF machine"), t.arch.name)}; }
    val machine: u64 = opt_code.some.fields[0].value;
    if (import.mangles(machine)) { ret res[Import, Fail].err{fail.about(fail.unsupported("an ARM64EC import defines mangled names, which have no neutral form"), "machine")}; }
    val res_syms: res[Symbols, Fail] = symbols_of(o);
    if (sel res_syms.err) { ret res[Import, Fail].err{res_syms.err}; }
    val p:         *Symbol              = res_syms.ok.pointer;
    val full:      View                 = object.name_of(o, p.name);
    val base:      Bytes                = Bytes{data: ?full.data[tables.IMPORT_POINTER_PREFIX.len], len: full.len - tables.IMPORT_POINTER_PREFIX.len};
    val res_typed: res[*TypeRule, Fail] = type_from(res_syms.ok.other);
    if (sel res_typed.err) { ret res[Import, Fail].err{res_typed.err}; }
    var e:  import.Export = import.Export{name: base, kind: res_typed.ok.code.value::u16};
    val by: Export        = res_syms.ok.export;
    if (sel by.ordinal) {
        e.ordinal   = by.ordinal;
        e.name_type = tables.IMPORT_OBJECT_ORDINAL.value::u16;
    }
    or (sel by.named) {
        val opt_hint: opt[u16] = by.named.hint;
        if (sel opt_hint.none) { ret res[Import, Fail].err{fail.unsupported("an import by name states its hint")}; }
        e.ordinal = opt_hint.some;
        val name: View = object.name_of(o, by.named.name);
        if (name.len == base.len && memory.raw_equal(name.data::ptr, base.data::ptr, base.len)) {
            e.name_type = tables.IMPORT_OBJECT_NAME.value::u16;
        }
        or {
            e.name_type = tables.IMPORT_OBJECT_NAME_EXPORTAS.value::u16;
            e.export_as = opt[Bytes].some{Bytes{data: name.data, len: name.len}};
        }
    }
    val dll: View = object.name_of(o, opt_loader.some);
    ret import.init(a, machine::u16, Bytes{data: dll.data, len: dll.len}, ?e);
}

# whether `o` holds nothing but names and symbols, and the library it describes
fun only_symbols(o: *Object) bool {
    if (table.count[object.Section](?o.sections) != 0 || table.count[object.Reloc](?o.relocs) != 0)     { ret false; }
    if (table.count[object.Group](?o.groups) != 0 || vector.length[object.Note](?o.notes) != 0)         { ret false; }
    if (table.count[object.Fact](?o.facts) != 0 || table.count[object.Entry](?o.entries) != 0)          { ret false; }
    if (table.count[object.Directive](?o.directives) != 0 || table.count[object.Frame](?o.frames) != 0) { ret false; }
    ret vector.length[object.CtRange](?o.ct) == 0 && table.count[object.Sequence](?o.sequences) == 0 && vector.length[Trait](?o.traits) == 0;
}

# the pointer and the other symbol of `o`: one or two global symbols the
# library defines, found the same way, the pointer naming a slot under the
# pointer prefix and the other its name without it
fun symbols_of(o: *Object) res[Symbols, Fail] {
    val n:   usize = table.count[Symbol](?o.symbols);
    val one: str   = "an import object's symbols are its pointer and the symbol name, defined by the DLL the same way";
    if (n == 0 || n > 2) { ret res[Symbols, Fail].err{fail.unsupported(one)}; }
    var out:   Symbols = Symbols{};
    var other: Export;
    var k:     usize   = 0;
    for (k < n) {
        val s: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
        k = k + 1;
        if (s.binding != ?symbol.GLOBAL || !symbol.shows(s.visibility, symbol.EXPORTED)) { ret res[Symbols, Fail].err{fail.unsupported(one)}; }
        if (sel s.version.some || sel s.fallback.some || sel s.size.some)                { ret res[Symbols, Fail].err{fail.unsupported(one)}; }
        if (!(sel s.def.library))                                                        { ret res[Symbols, Fail].err{fail.unsupported(one)}; }
        val e: Export = s.def.library;
        if (out.pointer == nil && symbol.names(s.kind, symbol.CELL) && pointer(object.name_of(o, s.name))) {
            out.pointer = s;
            out.export  = e;
            cnt;
        }
        if (out.other != nil) { ret res[Symbols, Fail].err{fail.unsupported(one)}; }
        out.other = s;
        other     = e;
    }
    if (out.pointer == nil) { ret res[Symbols, Fail].err{fail.unsupported(one)}; }
    if (out.other == nil)   { ret res[Symbols, Fail].ok{out}; }
    val p:   View  = object.name_of(o, out.pointer.name);
    val q:   View  = object.name_of(o, out.other.name);
    val cut: usize = tables.IMPORT_POINTER_PREFIX.len;
    if (q.len + cut != p.len || !memory.raw_equal(q.data::ptr, (?p.data[cut])::ptr, q.len)) { ret res[Symbols, Fail].err{fail.unsupported(one)}; }
    if (!same_export(out.export, other))                                                    { ret res[Symbols, Fail].err{fail.unsupported(one)}; }
    ret res[Symbols, Fail].ok{out};
}

# whether `v` spells a name under the pointer prefix
fun pointer(v: View) bool {
    val n: usize = tables.IMPORT_POINTER_PREFIX.len;
    ret v.len > n && memory.raw_equal(v.data::ptr, tables.IMPORT_POINTER_PREFIX.data::ptr, n);
}

fun same_export(x: Export, y: Export) bool {
    if (sel x.ordinal) {
        if (sel y.ordinal) { ret x.ordinal == y.ordinal; }
        ret false;
    }
    or (sel x.named) {
        if (sel y.named) { ret x.named.name.index == y.named.name.index && same_hint(x.named.hint, y.named.hint); }
        ret false;
    }
}

fun same_hint(h: opt[u16], g: opt[u16]) bool {
    if (sel h.some) {
        if (sel g.some) { ret h.some == g.some; }
        ret false;
    }
    ret sel g.none;
}

# the import type whose definitions are the pointer and `other`
fun type_from(other: *Symbol) res[*TypeRule, Fail] {
    var named: bool = false;
    var thunk: bool = false;
    if (other != nil) {
        named = true;
        thunk = !symbol.names(other.kind, symbol.CELL);
        if (thunk && !symbol.names(other.kind, symbol.CODE)) {
            ret res[*TypeRule, Fail].err{fail.unsupported("an import object's symbol name names code or the slot")};
        }
    }
    var k: usize = 0;
    for (k < import.TYPE_COUNT) {
        val r: *TypeRule = ?import.TYPES[k];
        if (r.named == named && r.thunk == thunk) { ret res[*TypeRule, Fail].ok{r}; }
        k = k + 1;
    }
    ret res[*TypeRule, Fail].err{fail.internal("no import type defines what the symbols state")};
}

# make each name of `i` one its store holds
fun owned(i: *Import) err[Fail] {
    val err_own: err[Fail] = own(i, ?i.symbol);
    if (sel err_own.err) { ret err_own; }
    val err_own_dll: err[Fail] = own(i, ?i.dll);
    if (sel err_own_dll.err) { ret err_own_dll; }
    val opt_extra: opt[Held] = i.export_as;
    if (sel opt_extra.some) {
        var held:    Held      = opt_extra.some;
        val err_own: err[Fail] = own(i, ?held);
        if (sel err_own.err) { ret err_own; }
        i.export_as = opt[Held].some{held};
    }
    ret err[Fail].ok{};
}

fun own(i: *Import, h: *Held) err[Fail] {
    val b:       Bytes           = import.bytes(i, h);
    val res_own: res[Held, Fail] = store.own(?i.store, b.data, b.len);
    if (sel res_own.err) { ret err[Fail].err{res_own.err}; }
    @h = res_own.ok;
    ret err[Fail].ok{};
}
