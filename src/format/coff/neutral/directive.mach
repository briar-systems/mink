# the directives a COFF object carries
#
# a .drectve section holds linker options in the link.exe syntax, tokenized
# by the Windows command line rules as lld-link tokenizes them: blanks and
# NULs separate tokens, a double quote toggles quoting, a run of backslashes
# before a double quote is halved, an odd run's last escaping the quote, and
# two double quotes inside quotes are one. an option starts with / or -, its
# name is matched ignoring case, and each becomes a neutral directive:
# - DEFAULTLIB:name, a library directive of that name
# - EXPORT:spec, an export directive whose text is the spec, about the
#   symbol the spec names: the internal name after =, the name otherwise,
#   and no symbol for a spec that forwards to another DLL with ==
# - INCLUDE:symbol, an include directive about the symbol
# - ALTERNATENAME:a=b, an alternate directive about a whose text is b
# - any other option, an option directive whose text is the token as written
# from_neutral writes each back in that form, one token after a blank each,
# quoted where a blank or a double quote needs it. COFF has no form for a
# framework or a warning directive.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.x86;
use mink.model.directive;
use mink.model.object;
use mink.model.object.Directive;
use mink.model.object.Object;

# the options that are directives of their own kind, spelled without the
# leading / or - and the colon
val DEFAULTLIB:    str = "defaultlib";
val EXPORT:        str = "export";
val INCLUDE:       str = "include";
val ALTERNATENAME: str = "alternatename";

fun blank(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == 0;
}

fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + ('a' - 'A'); }
    ret c;
}

# whether the token `t` of `n` bytes is the option `name` with its value,
# and where the value starts
fun option(t: *u8, n: usize, name: str) opt[usize] {
    val k: usize = str_len(name);
    if (n < k + 2 || (t[0] != '/' && t[0] != '-')) { ret opt[usize].none{}; }
    var i: usize = 0;
    for (i < k) {
        if (lower(t[1 + i]) != name[i]) { ret opt[usize].none{}; }
        i = i + 1;
    }
    if (t[1 + k] != ':') { ret opt[usize].none{}; }
    ret opt[usize].some{k + 2};
}

fun named(o: *Object, p: *u8, n: usize) res[Id[Name], Fail] {
    ret object.name(o, p, n);
}

fun add(o: *Object, k: *directive.Kind, text: Id[Name], symbol: opt[Id[Name]]) err[Fail] {
    val d: res[Id[Directive], Fail] = object.add_directive(o, Directive{kind: k, text: text, symbol: symbol});
    if (sel d.err) { ret err[Fail].err{d.err}; }
    ret err[Fail].ok{};
}

# the first byte of the `n` bytes at `p` that is `c`, or `n`
fun find(p: *u8, n: usize, c: u8) usize {
    var i: usize = 0;
    for (i < n && p[i] != c) {
        i = i + 1;
    }
    ret i;
}

# the symbol an export spec of `n` bytes at `p` is about: the internal name
# after = in the part before the first comma, the name otherwise, none for a
# forwarder
fun exported(p: *u8, n: usize) opt[View] {
    val head: usize = find(p, n, ',');
    val eq:   usize = find(p, head, '=');
    if (eq == head)                        { ret opt[View].some{View{data: p, len: head}}; }
    if (eq + 1 < head && p[eq + 1] == '=') { ret opt[View].none{}; }
    ret opt[View].some{View{data: ?p[eq + 1], len: head - eq - 1}};
}

# the directive one token of `n` bytes at `t` states
fun token_in(o: *Object, t: *u8, n: usize) err[Fail] {
    val lib: opt[usize] = option(t, n, DEFAULTLIB);
    if (sel lib.some) {
        val name: res[Id[Name], Fail] = named(o, ?t[lib.some], n - lib.some);
        if (sel name.err) { ret err[Fail].err{name.err}; }
        ret add(o, ?directive.LIBRARY, name.ok, opt[Id[Name]].none{});
    }
    val exp: opt[usize] = option(t, n, EXPORT);
    if (sel exp.some) {
        val spec: res[Id[Name], Fail] = named(o, ?t[exp.some], n - exp.some);
        if (sel spec.err) { ret err[Fail].err{spec.err}; }
        var about: opt[Id[Name]] = opt[Id[Name]].none{};
        val sym:   opt[View]     = exported(?t[exp.some], n - exp.some);
        if (sel sym.some) {
            val s: res[Id[Name], Fail] = named(o, sym.some.data, sym.some.len);
            if (sel s.err) { ret err[Fail].err{s.err}; }
            about = opt[Id[Name]].some{s.ok};
        }
        ret add(o, ?directive.EXPORT, spec.ok, about);
    }
    val inc: opt[usize] = option(t, n, INCLUDE);
    if (sel inc.some) {
        val sym: res[Id[Name], Fail] = named(o, ?t[inc.some], n - inc.some);
        if (sel sym.err) { ret err[Fail].err{sym.err}; }
        ret add(o, ?directive.INCLUDE, sym.ok, opt[Id[Name]].some{sym.ok});
    }
    val alt: opt[usize] = option(t, n, ALTERNATENAME);
    if (sel alt.some) {
        val v:  *u8   = ?t[alt.some];
        val m:  usize = n - alt.some;
        val eq: usize = find(v, m, '=');
        if (eq == 0 || eq + 1 >= m) { ret err[Fail].err{fail.malformed("an alternate name directive is not of the form a=b")}; }
        val from: res[Id[Name], Fail] = named(o, v, eq);
        if (sel from.err) { ret err[Fail].err{from.err}; }
        val to: res[Id[Name], Fail] = named(o, ?v[eq + 1], m - eq - 1);
        if (sel to.err) { ret err[Fail].err{to.err}; }
        ret add(o, ?directive.ALTERNATE, to.ok, opt[Id[Name]].some{from.ok});
    }
    val text: res[Id[Name], Fail] = named(o, t, n);
    if (sel text.err) { ret err[Fail].err{text.err}; }
    ret add(o, ?directive.OPTION, text.ok, opt[Id[Name]].none{});
}

# add to `o` the directive of each token the `len` bytes at `data` hold,
# refusing a token unterminated by its quote and a malformed alternate name.
# a refusal leaves the directives added before it
pub fun directives_in(a: *A.Allocator, o: *Object, data: *u8, len: usize) err[Fail] {
    var tok: Sink      = sink.make(a, LITTLE);
    val r:   err[Fail] = tokens_in(o, data, len, ?tok);
    val rel: err[Fail] = sink.release(?tok);
    if (sel r.err) { ret r; }
    ret rel;
}

fun tokens_in(o: *Object, data: *u8, len: usize, tok: *Sink) err[Fail] {
    var i: usize = 0;
    for (i < len) {
        if (blank(data[i])) {
            i = i + 1;
            cnt;
        }
        val start:  usize = sink.len(tok);
        var quoted: bool  = false;
        for (i < len && (quoted || !blank(data[i]))) {
            var slashes: usize = 0;
            for (i < len && data[i] == '\\') {
                slashes = slashes + 1;
                i       = i + 1;
            }
            if (i < len && data[i] == '"') {
                val kept: err[Fail] = repeat(tok, '\\', slashes / 2);
                if (sel kept.err) { ret kept; }
                if (slashes % 2 == 1) {
                    val q: err[Fail] = sink.u8(tok, '"');
                    if (sel q.err) { ret q; }
                    i = i + 1;
                    cnt;
                }
                if (quoted && i + 1 < len && data[i + 1] == '"') {
                    val q: err[Fail] = sink.u8(tok, '"');
                    if (sel q.err) { ret q; }
                    i = i + 2;
                    cnt;
                }
                quoted = !quoted;
                i      = i + 1;
                cnt;
            }
            val kept: err[Fail] = repeat(tok, '\\', slashes);
            if (sel kept.err) { ret kept; }
            if (i < len && (quoted || !blank(data[i]))) {
                val c: err[Fail] = sink.u8(tok, data[i]);
                if (sel c.err) { ret c; }
                i = i + 1;
            }
        }
        if (quoted) { ret err[Fail].err{fail.at_offset(fail.malformed("a directive's quote is not closed"), i::u64)}; }
        val r: err[Fail] = token_in(o, ?sink.data(tok)[start], sink.len(tok) - start);
        if (sel r.err) { ret err[Fail].err{fail.at_offset(r.err, i::u64)}; }
    }
    ret err[Fail].ok{};
}

fun repeat(out: *Sink, c: u8, n: usize) err[Fail] {
    var k: usize = 0;
    for (k < n) {
        val w: err[Fail] = sink.u8(out, c);
        if (sel w.err) { ret w; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# whether a token of the `n` bytes at `p` must be quoted to read back whole
fun needs_quotes(p: *u8, n: usize) bool {
    if (n == 0) { ret true; }
    var i: usize = 0;
    for (i < n) {
        if (blank(p[i]) || p[i] == '"') { ret true; }
        i = i + 1;
    }
    ret false;
}

# write an option of the spelling `head`, then the parts `v` and, when `w`
# has bytes, = and `w`, the whole token quoted when any part needs it
fun token_out(out: *Sink, head: str, v: View, sep: bool, w: View) err[Fail] {
    val quote: bool      = needs_quotes(v.data, v.len) || (sep && needs_quotes(w.data, w.len));
    val lead:  err[Fail] = sink.u8(out, ' ');
    if (sel lead.err) { ret lead; }
    if (quote) {
        val q: err[Fail] = sink.u8(out, '"');
        if (sel q.err) { ret q; }
    }
    val h: err[Fail] = sink.bytes(out, head::*u8, str_len(head));
    if (sel h.err) { ret h; }
    val a: err[Fail] = escaped(out, v, quote, !sep);
    if (sel a.err) { ret a; }
    if (sep) {
        val e: err[Fail] = sink.u8(out, '=');
        if (sel e.err) { ret e; }
        val b: err[Fail] = escaped(out, w, quote, true);
        if (sel b.err) { ret b; }
    }
    if (!quote) { ret err[Fail].ok{}; }
    ret sink.u8(out, '"');
}

# the bytes of `v` inside a token, a double quote escaped when the token is
# quoted, with the backslashes before it doubled, as are the backslashes that
# end the token when `closes`, before its closing quote
fun escaped(out: *Sink, v: View, quote: bool, closes: bool) err[Fail] {
    if (!quote) { ret sink.bytes(out, v.data, v.len); }
    var i:       usize = 0;
    var slashes: usize = 0;
    for (i < v.len) {
        val c: u8 = v.data[i];
        i = i + 1;
        if (c == '\\') {
            slashes = slashes + 1;
            val w: err[Fail] = sink.u8(out, c);
            if (sel w.err) { ret w; }
            cnt;
        }
        if (c == '"') {
            val doubled: err[Fail] = repeat(out, '\\', slashes + 1);
            if (sel doubled.err) { ret doubled; }
        }
        slashes = 0;
        val w: err[Fail] = sink.u8(out, c);
        if (sel w.err) { ret w; }
    }
    if (closes) { ret repeat(out, '\\', slashes); }
    ret err[Fail].ok{};
}

# whether `d` is about the symbol of the name `n`
fun about(d: *Directive, n: Id[Name]) bool {
    if (sel d.symbol.some) { ret d.symbol.some.index == n.index; }
    ret false;
}

# whether `d` is about the symbol named `s`
fun about_named(o: *Object, d: *Directive, s: str) bool {
    if (sel d.symbol.some) { ret is(o, d.symbol.some, s); }
    ret false;
}

fun refused(text: str, i: usize) res[usize, Fail] {
    ret res[usize, Fail].err{fail.in_indexed(fail.unsupported(text), "directive", i::u64)};
}

# write each directive of `o` into `out` as the text of a .drectve section
# and say how many there are. a directive COFF has no form for is refused
# naming it
pub fun directives_of(o: *Object, out: *Sink) res[usize, Fail] {
    val n:     usize = table.count[Directive](?o.directives);
    var i:     usize = 0;
    var empty: View  = View{data: nil, len: 0};
    for (i < n) {
        val d:    *Directive = table.at[Directive](?o.directives, table.nth[Directive](i));
        val text: View       = object.name_of(o, d.text);
        var w:    err[Fail]  = err[Fail].ok{};
        if (d.kind == ?directive.LIBRARY) {
            if (sel d.symbol.some) { ret refused("COFF has no form for a library directive about a symbol", i); }
            w = token_out(out, "/DEFAULTLIB:", text, false, empty);
        }
        or (d.kind == ?directive.EXPORT) {
            w = token_out(out, "/EXPORT:", text, false, empty);
        }
        or (d.kind == ?directive.INCLUDE) {
            if (!about(d, d.text)) { ret refused("COFF has no form for an include directive whose text is not its symbol", i); }
            w = token_out(out, "/INCLUDE:", text, false, empty);
        }
        or (d.kind == ?directive.ALTERNATE) {
            if (sel d.symbol.none) { ret refused("COFF has no form for an alternate directive about no symbol", i); }
            val from: View = object.name_of(o, d.symbol.some);
            w = token_out(out, "/ALTERNATENAME:", from, true, object.name_of(o, d.text));
        }
        or (d.kind == ?directive.OPTION) {
            if (sel d.symbol.some) { ret refused("COFF has no form for an option directive about a symbol", i); }
            w = token_out(out, "", text, false, empty);
        }
        or {
            ret res[usize, Fail].err{fail.in_indexed(fail.about(fail.unsupported("COFF has no form for this directive"), d.kind.name), "directive", i::u64)};
        }
        if (sel w.err) { ret res[usize, Fail].err{w.err}; }
        i = i + 1;
    }
    ret res[usize, Fail].ok{n};
}

val SAMPLE: str = "  /DEFAULTLIB:libcmt -defaultlib:\"old names\" /EXPORT:f,DATA /export:g=impl /EXPORT:h==other.h /INCLUDE:keep /ALTERNATENAME:a=b \"/MANIFESTDEPENDENCY:type='win32' name='x'\" /merge:.a=.b";

fun is(o: *Object, id: Id[Name], s: str) bool {
    val v: View = object.name_of(o, id);
    if (v.len != str_len(s)) { ret false; }
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun at(o: *Object, i: usize) *Directive {
    ret table.at[Directive](?o.directives, table.nth[Directive](i));
}

# the directives of the sample, in order
fun sample_holds(o: *Object) bool {
    if (table.count[Directive](?o.directives) != 9) { ret false; }
    val l0: *Directive = at(o, 0);
    val l1: *Directive = at(o, 1);
    val e0: *Directive = at(o, 2);
    val e1: *Directive = at(o, 3);
    val e2: *Directive = at(o, 4);
    val n0: *Directive = at(o, 5);
    val a0: *Directive = at(o, 6);
    val o0: *Directive = at(o, 7);
    val o1: *Directive = at(o, 8);
    if (l0.kind != ?directive.LIBRARY || !is(o, l0.text, "libcmt") || sel l0.symbol.some)             { ret false; }
    if (l1.kind != ?directive.LIBRARY || !is(o, l1.text, "old names"))                                { ret false; }
    if (e0.kind != ?directive.EXPORT || !is(o, e0.text, "f,DATA"))                                    { ret false; }
    if (!about_named(o, e0, "f") || !about_named(o, e1, "impl"))                                      { ret false; }
    if (e2.kind != ?directive.EXPORT || sel e2.symbol.some)                                           { ret false; }
    if (n0.kind != ?directive.INCLUDE || !is(o, n0.text, "keep"))                                     { ret false; }
    if (a0.kind != ?directive.ALTERNATE || !is(o, a0.text, "b"))                                      { ret false; }
    if (!about_named(o, a0, "a"))                                                                     { ret false; }
    if (o0.kind != ?directive.OPTION || !is(o, o0.text, "/MANIFESTDEPENDENCY:type='win32' name='x'")) { ret false; }
    if (o1.kind != ?directive.OPTION || !is(o, o1.text, "/merge:.a=.b"))                              { ret false; }
    ret true;
}

test directive__drectve_options_are_directives_and_written_back {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);
    var o: Object       = object.make(a, ?x86.X86_64);
    val r: err[Fail]    = directives_in(a, ?o, SAMPLE::*u8, str_len(SAMPLE));
    if (sel r.err)         { ret 1; }
    if (!sample_holds(?o)) { ret 2; }

    # written back and read again, the directives are the same
    var out:   Sink             = sink.make(a, LITTLE);
    val wrote: res[usize, Fail] = directives_of(?o, ?out);
    if (!sel wrote.ok) { ret 3; }
    if (wrote.ok != 9) { ret 3; }
    var back:  Object    = object.make(a, ?x86.X86_64);
    val again: err[Fail] = directives_in(a, ?back, sink.data(?out), sink.len(?out));
    if (sel again.err)        { ret 4; }
    if (!sample_holds(?back)) { ret 4; }

    # an open quote and an alternate name of no = are refused
    var bad:  Object    = object.make(a, ?x86.X86_64);
    val open: err[Fail] = directives_in(a, ?bad, "/EXPORT:\"f"::*u8, 10);
    if (!sel open.err) { ret 5; }
    val alt: err[Fail] = directives_in(a, ?bad, "/ALTERNATENAME:ab"::*u8, 17);
    if (!sel alt.err) { ret 5; }

    # a warning has no COFF form
    val n: res[Id[Name], Fail] = object.name_str(?bad, "w");
    if (sel n.err) { ret 6; }
    val d: err[Fail] = add(?bad, ?directive.WARNING, n.ok, opt[Id[Name]].none{});
    if (sel d.err) { ret 6; }
    var none:    Sink             = sink.make(a, LITTLE);
    val warning: res[usize, Fail] = directives_of(?bad, ?none);
    if (!sel warning.err)                   { ret 7; }
    if (!sel warning.err.cause.unsupported) { ret 7; }

    var rel: err[Fail] = sink.release(?out);
    rel = fail.kept(rel, sink.release(?none));
    rel = fail.kept(rel, object.release(?o));
    rel = fail.kept(rel, object.release(?back));
    rel = fail.kept(rel, object.release(?bad));
    if (sel rel.err)           { ret 8; }
    if (T.live_count(?t) != 0) { ret 8; }
    T.dnit(?t);
    ret 0;
}
