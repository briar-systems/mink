# the directives a COFF object carries
#
# a .drectve section holds linker options in the Windows linker syntax,
# tokenized by the Windows command line rules: blanks and
# NULs separate tokens, a double quote toggles quoting, a run of backslashes
# before a double quote is halved, an odd run's last escaping the quote, and
# two double quotes inside quotes are one. an option starts with / or -, its
# name is matched ignoring case, and each becomes a neutral directive:
# - DEFAULTLIB:name, a library directive of that name
# - EXPORT:spec, an export directive whose text is the name the spec
#   exports by, about the symbol it names: the internal name after =, the
#   name otherwise, and none for a forwarder after ==, which the directive
#   states with the ordinal, NONAME and PRIVATE. DATA makes the kind of the
#   object's definition of the symbol data, refused where the object
#   defines no such symbol or defines it as no data. a forwarder, which has
#   no definition, states DATA in its directive
# - INCLUDE:symbol, an include directive about the symbol
# - ALTERNATENAME:a=b, an alternate directive about a whose text is b
# - SUBSYSTEM:name[,major[.minor]], no directive but the object's target: its
#   subsystem by the catalog row of that name, matched ignoring case, and its
#   system version, the version standing for both. a name no row has,
#   a version that is no number or does not fit the target, and a second
#   subsystem unlike the first are refused
# - any other option, an option directive whose text is the token as written
# from_neutral writes the target's subsystem first, then each directive back in
# its form, one token after a blank each, quoted where a blank or a double quote
# needs it. an export is written as `name`, `name=symbol` for one exported
# by another name or `name==forward` for a forwarder, then its ordinal,
# NONAME, DATA where the definition is data and PRIVATE. an export about a
# symbol is written in the object that defines it. COFF has no form for a framework or a warning directive, nor for a
# system version without a subsystem or with a patch level.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.kind;
use mink.catalog.os.Version;
use mink.catalog.subsystem;
use mink.catalog.subsystem.Subsystem;
use mink.model.directive;
use mink.model.object;
use mink.model.object.Directive;
use mink.model.object.Object;
use mink.model.object.Symbol;
use mink.model.symbol;
use mink.model.target.Target;

# the options that are directives of their own kind, spelled without the
# leading / or - and the colon
val DEFAULTLIB:    str = "defaultlib";
val EXPORT:        str = "export";
val INCLUDE:       str = "include";
val ALTERNATENAME: str = "alternatename";
val SUBSYSTEM:     str = "subsystem";

# the longest subsystem name a token is matched against, the catalog's longest
# being shorter
val NAME_MAX: usize = 32;

fun blank(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == 0;
}

fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + ('a' - 'A'); }
    ret c;
}

# whether the token `t` of `n` bytes is the option `name` with its value,
# and where the value starts
fun option(t: *u8, n: usize, name: str) opt[usize] {
    val k: usize = str_len(name);
    if (n < k + 2 || (t[0] != '/' && t[0] != '-')) { ret opt[usize].none{}; }
    var i: usize = 0;
    for (i < k) {
        if (lower(t[1 + i]) != name[i]) { ret opt[usize].none{}; }
        i = i + 1;
    }
    if (t[1 + k] != ':') { ret opt[usize].none{}; }
    ret opt[usize].some{k + 2};
}

fun named(o: *Object, p: *u8, n: usize) res[Id[Name], Fail] {
    ret object.name(o, p, n);
}

fun add(o: *Object, k: *directive.Kind, text: Id[Name], symbol: opt[Id[Name]]) err[Fail] {
    ret added(o, Directive{kind: k, text: text, symbol: symbol});
}

# the first byte of the `n` bytes at `p` that is `c`, or `n`
fun find(p: *u8, n: usize, c: u8) usize {
    var i: usize = 0;
    for (i < n && p[i] != c) {
        i = i + 1;
    }
    ret i;
}

# an export, as the spec of an export directive states it:
# `name[=internal|==dll.export][,@ordinal[,NONAME]][,DATA][,PRIVATE]`
# ---
# name:    the name the DLL exports it by
# about:   the symbol it exports, the internal name where one is given and
#          the name otherwise, none for a forwarder
# forward: the export of another DLL it forwards to, `dll.name` or
#          `dll.#ordinal` as written, none for an export of a symbol
# ordinal: the ordinal it states, none where it states none
# noname:  the DLL exports it by its ordinal alone, naming it nowhere
# data:    it is data, which an importer reaches only through its import
#          address cell
# private: an import library leaves it out
# options: where its options start, after the part naming it
pub rec ExportSpec {
    name:    View;
    about:   opt[View];
    forward: opt[View];
    ordinal: opt[u16];
    noname:  bool;
    data:    bool;
    private: bool;
    options: usize;
}

# the options an export spec may state after its name, matched ignoring case
val NONAME:  str = "noname";
val DATA:    str = "data";
val PRIVATE: str = "private";

# the part of an export spec of `n` bytes at `p` before its first comma: the
# name, and the internal name after = or the export forwarded to after ==
fun head_of(p: *u8, n: usize) ExportSpec {
    val head: usize = find(p, n, ',');
    val eq:   usize = find(p, head, '=');
    if (eq == head) {
        val name: View = View{data: p, len: head};
        ret ExportSpec{name: name, about: opt[View].some{name}, options: head};
    }
    if (eq + 1 < head && p[eq + 1] == '=') {
        ret ExportSpec{name: View{data: p, len: eq}, forward: opt[View].some{View{data: ?p[eq + 2], len: head - eq - 2}}, options: head};
    }
    ret ExportSpec{name: View{data: p, len: eq}, about: opt[View].some{View{data: ?p[eq + 1], len: head - eq - 1}}, options: head};
}

# whether the `n` bytes at `p` are `word`, ignoring case
fun is_word(p: *u8, n: usize, word: str) bool {
    if (n != str_len(word)) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (lower(p[i]) != word[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the export the spec `text` of an export directive states, refused where
# a name is empty, an option is one the syntax does not name or is stated
# twice, an ordinal is no number from 1 to 65535, or NONAME comes before an
# ordinal
pub fun export_spec(text: View) res[ExportSpec, Fail] {
    val empty: Fail       = fail.malformed("an export spec names nothing where it names an export");
    val p:     *u8        = text.data;
    val n:     usize      = text.len;
    var spec:  ExportSpec = head_of(p, n);
    val about: opt[View]  = spec.about;
    val fwd:   opt[View]  = spec.forward;
    if (spec.name.len == 0)                    { ret res[ExportSpec, Fail].err{empty}; }
    if (sel about.some && about.some.len == 0) { ret res[ExportSpec, Fail].err{empty}; }
    if (sel fwd.some && fwd.some.len == 0)     { ret res[ExportSpec, Fail].err{empty}; }
    var at:       usize = spec.options;
    var numbered: bool  = false;
    for (at < n) {
        val start: usize = at + 1;
        val len:   usize = find(?p[start], n - start, ',');
        val t:     *u8   = ?p[start];
        at = start + len;
        if (len > 1 && t[0] == '@') {
            val bad: Fail     = fail.malformed("an export spec's ordinal is no number from 1 to 65535");
            val o:   opt[u64] = decimal(?t[1], len - 1, 0xffff);
            if (sel o.none)  { ret res[ExportSpec, Fail].err{bad}; }
            if (o.some == 0) { ret res[ExportSpec, Fail].err{bad}; }
            if (numbered)    { ret res[ExportSpec, Fail].err{fail.malformed("an export spec states two ordinals")}; }
            numbered     = true;
            spec.ordinal = opt[u16].some{o.some::u16};
        }
        or (is_word(t, len, NONAME)) {
            if (!numbered || spec.noname) { ret res[ExportSpec, Fail].err{fail.malformed("an export spec states NONAME other than once after its ordinal")}; }
            spec.noname = true;
        }
        or (is_word(t, len, DATA)) {
            if (spec.data) { ret res[ExportSpec, Fail].err{fail.malformed("an export spec states DATA twice")}; }
            spec.data = true;
        }
        or (is_word(t, len, PRIVATE)) {
            if (spec.private) { ret res[ExportSpec, Fail].err{fail.malformed("an export spec states PRIVATE twice")}; }
            spec.private = true;
        }
        or {
            ret res[ExportSpec, Fail].err{fail.malformed("an export spec states an option the export syntax does not name")};
        }
    }
    ret res[ExportSpec, Fail].ok{spec};
}

# the export directive the spec `text` states with every option it states,
# the symbol of an export stating DATA noted in `data`. a forwarder states
# DATA itself, having no definition whose kind says so
fun export_in(o: *Object, text: View, data: *Table[Id[Name]]) err[Fail] {
    val spec: res[ExportSpec, Fail] = export_spec(text);
    if (sel spec.err) { ret err[Fail].err{spec.err}; }
    val s:    ExportSpec          = spec.ok;
    val name: res[Id[Name], Fail] = named(o, s.name.data, s.name.len);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    var x:   directive.Export = directive.Export{ordinal: s.ordinal, noname: s.noname, private: s.private};
    val fwd: opt[View]        = s.forward;
    if (sel fwd.some) {
        val f: res[Id[Name], Fail] = named(o, fwd.some.data, fwd.some.len);
        if (sel f.err) { ret err[Fail].err{f.err}; }
        x.forward = opt[Id[Name]].some{f.ok};
        x.data    = s.data;
        ret added(o, Directive{kind: ?directive.EXPORT, text: name.ok, export: x});
    }
    val about: opt[View] = s.about;
    if (sel about.none) { ret err[Fail].err{fail.malformed("an export spec names neither a symbol nor a forwarder")}; }
    val sym: res[Id[Name], Fail] = named(o, about.some.data, about.some.len);
    if (sel sym.err) { ret err[Fail].err{sym.err}; }
    if (s.data) {
        val p: res[Id[Id[Name]], Fail] = table.push[Id[Name]](data, sym.ok);
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    ret added(o, Directive{kind: ?directive.EXPORT, text: name.ok, symbol: opt[Id[Name]].some{sym.ok}, export: x});
}

fun added(o: *Object, d: Directive) err[Fail] {
    val r: res[Id[Directive], Fail] = object.add_directive(o, d);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

# the directive one token of `n` bytes at `t` states, the symbol of an export
# stating DATA noted in `data`
fun token_in(o: *Object, t: *u8, n: usize, data: *Table[Id[Name]]) err[Fail] {
    val lib: opt[usize] = option(t, n, DEFAULTLIB);
    if (sel lib.some) {
        val name: res[Id[Name], Fail] = named(o, ?t[lib.some], n - lib.some);
        if (sel name.err) { ret err[Fail].err{name.err}; }
        ret add(o, ?directive.LIBRARY, name.ok, opt[Id[Name]].none{});
    }
    val exp: opt[usize] = option(t, n, EXPORT);
    if (sel exp.some) { ret export_in(o, View{data: ?t[exp.some], len: n - exp.some}, data); }
    val inc: opt[usize] = option(t, n, INCLUDE);
    if (sel inc.some) {
        val sym: res[Id[Name], Fail] = named(o, ?t[inc.some], n - inc.some);
        if (sel sym.err) { ret err[Fail].err{sym.err}; }
        ret add(o, ?directive.INCLUDE, sym.ok, opt[Id[Name]].some{sym.ok});
    }
    val alt: opt[usize] = option(t, n, ALTERNATENAME);
    if (sel alt.some) {
        val v:  *u8   = ?t[alt.some];
        val m:  usize = n - alt.some;
        val eq: usize = find(v, m, '=');
        if (eq == 0 || eq + 1 >= m) { ret err[Fail].err{fail.malformed("an alternate name directive is not of the form a=b")}; }
        val from: res[Id[Name], Fail] = named(o, v, eq);
        if (sel from.err) { ret err[Fail].err{from.err}; }
        val to: res[Id[Name], Fail] = named(o, ?v[eq + 1], m - eq - 1);
        if (sel to.err) { ret err[Fail].err{to.err}; }
        ret add(o, ?directive.ALTERNATE, to.ok, opt[Id[Name]].some{from.ok});
    }
    val sub: opt[usize] = option(t, n, SUBSYSTEM);
    if (sel sub.some) { ret subsystem_in(o, ?t[sub.some], n - sub.some); }
    val text: res[Id[Name], Fail] = named(o, t, n);
    if (sel text.err) { ret err[Fail].err{text.err}; }
    ret add(o, ?directive.OPTION, text.ok, opt[Id[Name]].none{});
}

# the decimal number the `n` bytes at `p` spell, none for no digits, a byte
# that is no digit, or a number past `max`
fun decimal(p: *u8, n: usize, max: u64) opt[u64] {
    if (n == 0) { ret opt[u64].none{}; }
    var v: u64   = 0;
    var i: usize = 0;
    for (i < n) {
        if (p[i] < '0' || p[i] > '9') { ret opt[u64].none{}; }
        v = v * 10 + (p[i] - '0')::u64;
        if (v > max) { ret opt[u64].none{}; }
        i = i + 1;
    }
    ret opt[u64].some{v};
}

# the system version `major[.minor]` of the `n` bytes at `p`
fun version_in(p: *u8, n: usize) res[Version, Fail] {
    val dot:   usize    = find(p, n, '.');
    val major: opt[u64] = decimal(p, dot, 0xffff);
    if (sel major.none) { ret res[Version, Fail].err{fail.malformed("a subsystem directive's major version is no number the target holds")}; }
    var minor: u64 = 0;
    if (dot < n) {
        val m: opt[u64] = decimal(?p[dot + 1], n - dot - 1, 0xff);
        if (sel m.none) { ret res[Version, Fail].err{fail.malformed("a subsystem directive's minor version is no number the target holds")}; }
        minor = m.some;
    }
    ret res[Version, Fail].ok{Version{major: major.some::u16, minor: minor::u8, patch: 0}};
}

# the catalog row named by the `n` bytes at `p`, matched ignoring case
fun subsystem_named(p: *u8, n: usize) res[*Subsystem, Fail] {
    if (n >= NAME_MAX) { ret res[*Subsystem, Fail].err{fail.malformed("a subsystem directive names no PE subsystem")}; }
    var name: [NAME_MAX]u8;
    var i:    usize = 0;
    for (i < n) {
        name[i] = lower(p[i]);
        i       = i + 1;
    }
    name[n] = 0;
    val text: *u8                   = ?name[0];
    val row:  res[*Subsystem, Fail] = subsystem.by_name(text::str);
    if (sel row.err) { ret res[*Subsystem, Fail].err{fail.malformed("a subsystem directive names no PE subsystem")}; }
    ret row;
}

fun same_version(x: opt[Version], y: opt[Version]) bool {
    if (sel x.none) { ret sel y.none; }
    if (sel y.none) { ret false; }
    ret x.some.major == y.some.major && x.some.minor == y.some.minor && x.some.patch == y.some.patch;
}

# set the target of `o` from the value `name[,major[.minor]]` of a subsystem
# option, `n` bytes at `p`, refusing one unlike a subsystem the object already
# states
fun subsystem_in(o: *Object, p: *u8, n: usize) err[Fail] {
    val comma: usize                 = find(p, n, ',');
    val row:   res[*Subsystem, Fail] = subsystem_named(p, comma);
    if (sel row.err) { ret err[Fail].err{row.err}; }
    var version: opt[Version] = opt[Version].none{};
    if (comma < n) {
        val v: res[Version, Fail] = version_in(?p[comma + 1], n - comma - 1);
        if (sel v.err) { ret err[Fail].err{v.err}; }
        version = opt[Version].some{v.ok};
    }
    val prior: opt[*Subsystem] = o.target.subsystem;
    if (sel prior.some) {
        if (prior.some != row.ok || !same_version(o.target.version, version)) { ret err[Fail].err{fail.malformed("the object states two subsystems")}; }
        ret err[Fail].ok{};
    }
    val stated: opt[Version] = o.target.version;
    if (sel stated.some) { ret err[Fail].err{fail.malformed("the object states a system version before its subsystem")}; }
    o.target.subsystem = opt[*Subsystem].some{row.ok};
    o.target.version   = version;
    ret err[Fail].ok{};
}

# add to `o` the directive of each token the `len` bytes at `data` hold,
# refusing a token unterminated by its quote and a malformed alternate name,
# and note in `exports` the symbol of each export stating DATA, for
# `data_in`. a refusal leaves the directives added before it
pub fun directives_in(a: *A.Allocator, o: *Object, data: *u8, len: usize, exports: *Table[Id[Name]]) err[Fail] {
    var tok: Sink      = sink.make(a, LITTLE);
    val r:   err[Fail] = tokens_in(o, data, len, ?tok, exports);
    val rel: err[Fail] = sink.release(?tok);
    if (sel r.err) { ret r; }
    ret rel;
}

# per name of `o`, its first definition plus one, zero for a name `o`
# defines no symbol of, into `out`, which holds nothing before
fun definitions(o: *Object, out: *Table[u32]) err[Fail] {
    val names: usize = intern.count(?o.names);
    if (names != 0) {
        val g: res[Id[u32], Fail] = table.grow[u32](out, names);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    var k: usize = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val y: *Symbol = object.symbol_at(o, table.nth[Symbol](k));
        k = k + 1;
        if (sel y.def.undefined)                      { cnt; }
        if (table.items[u32](out)[y.name.index] != 0) { cnt; }
        table.items[u32](out)[y.name.index] = k::u32;
    }
    ret err[Fail].ok{};
}

# make data the kind of `o`'s definition of each symbol in `exports`, the
# symbols of exports stating DATA, refusing one `o` does not define, or
# defines as code or as no data. the kind is the one place the neutral
# object states that an export is data
pub fun data_in(o: *Object, exports: *Table[Id[Name]]) err[Fail] {
    if (table.count[Id[Name]](exports) == 0) { ret err[Fail].ok{}; }
    var defs: Table[u32] = table.make[u32](o.a);
    val r:    err[Fail]  = data_by(o, exports, ?defs);
    ret fail.kept(r, table.release[u32](?defs));
}

fun data_by(o: *Object, exports: *Table[Id[Name]], defs: *Table[u32]) err[Fail] {
    val d: err[Fail] = definitions(o, defs);
    if (sel d.err) { ret d; }
    var i: usize = 0;
    for (i < table.count[Id[Name]](exports)) {
        val n:     Id[Name] = table.items[Id[Name]](exports)[i];
        val first: u32      = table.items[u32](defs)[n.index];
        i = i + 1;
        if (first == 0) { ret err[Fail].err{fail.unsupported("the neutral object states an export is data only by the kind of a definition the object holds")}; }
        val y: *Symbol = object.symbol_at(o, table.nth[Symbol]((first - 1)::usize));
        if (y.kind == ?symbol.NOTYPE)             { y.kind = ?symbol.DATA; }
        or (!symbol.names(y.kind, symbol.OBJECT)) { ret err[Fail].err{fail.about(fail.malformed("an export states DATA of a symbol that names no data"), y.kind.name)}; }
    }
    ret err[Fail].ok{};
}

fun tokens_in(o: *Object, data: *u8, len: usize, tok: *Sink, exports: *Table[Id[Name]]) err[Fail] {
    var i: usize = 0;
    for (i < len) {
        if (blank(data[i])) {
            i = i + 1;
            cnt;
        }
        val start:  usize = sink.len(tok);
        var quoted: bool  = false;
        for (i < len && (quoted || !blank(data[i]))) {
            var slashes: usize = 0;
            for (i < len && data[i] == '\\') {
                slashes = slashes + 1;
                i       = i + 1;
            }
            if (i < len && data[i] == '"') {
                val kept: err[Fail] = repeat(tok, '\\', slashes / 2);
                if (sel kept.err) { ret kept; }
                if (slashes % 2 == 1) {
                    val q: err[Fail] = sink.u8(tok, '"');
                    if (sel q.err) { ret q; }
                    i = i + 1;
                    cnt;
                }
                if (quoted && i + 1 < len && data[i + 1] == '"') {
                    val q: err[Fail] = sink.u8(tok, '"');
                    if (sel q.err) { ret q; }
                    i = i + 2;
                    cnt;
                }
                quoted = !quoted;
                i      = i + 1;
                cnt;
            }
            val kept: err[Fail] = repeat(tok, '\\', slashes);
            if (sel kept.err) { ret kept; }
            if (i < len && (quoted || !blank(data[i]))) {
                val c: err[Fail] = sink.u8(tok, data[i]);
                if (sel c.err) { ret c; }
                i = i + 1;
            }
        }
        if (quoted) { ret err[Fail].err{fail.at_offset(fail.malformed("a directive's quote is not closed"), i::u64)}; }
        val r: err[Fail] = token_in(o, ?sink.data(tok)[start], sink.len(tok) - start, exports);
        if (sel r.err) { ret err[Fail].err{fail.at_offset(r.err, i::u64)}; }
    }
    ret err[Fail].ok{};
}

fun repeat(out: *Sink, c: u8, n: usize) err[Fail] {
    var k: usize = 0;
    for (k < n) {
        val w: err[Fail] = sink.u8(out, c);
        if (sel w.err) { ret w; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# whether a token of the `n` bytes at `p` must be quoted to read back whole
fun needs_quotes(p: *u8, n: usize) bool {
    if (n == 0) { ret true; }
    var i: usize = 0;
    for (i < n) {
        if (blank(p[i]) || p[i] == '"') { ret true; }
        i = i + 1;
    }
    ret false;
}

# write an option of the spelling `head`, then the part `v`, `sep` and `w`
# when `sep` has bytes, and `tail`, the whole token quoted when a part needs
# it
fun token_out(out: *Sink, head: str, v: View, sep: str, w: View, tail: View) err[Fail] {
    val ends:   bool      = tail.len == 0;
    val joined: bool      = str_len(sep) != 0;
    val quote:  bool      = needs_quotes(v.data, v.len) || (joined && needs_quotes(w.data, w.len));
    val lead:   err[Fail] = sink.u8(out, ' ');
    if (sel lead.err) { ret lead; }
    if (quote) {
        val q: err[Fail] = sink.u8(out, '"');
        if (sel q.err) { ret q; }
    }
    val h: err[Fail] = sink.bytes(out, head::*u8, str_len(head));
    if (sel h.err) { ret h; }
    val a: err[Fail] = escaped(out, v, quote, !joined && ends);
    if (sel a.err) { ret a; }
    if (joined) {
        val e: err[Fail] = sink.text(out, sep);
        if (sel e.err) { ret e; }
        val b: err[Fail] = escaped(out, w, quote, ends);
        if (sel b.err) { ret b; }
    }
    val t: err[Fail] = sink.bytes(out, tail.data, tail.len);
    if (sel t.err) { ret t; }
    if (!quote)    { ret err[Fail].ok{}; }
    ret sink.u8(out, '"');
}

# the bytes of `v` inside a token, a double quote escaped when the token is
# quoted, with the backslashes before it doubled, as are the backslashes that
# end the token when `closes`, before its closing quote
fun escaped(out: *Sink, v: View, quote: bool, closes: bool) err[Fail] {
    if (!quote) { ret sink.bytes(out, v.data, v.len); }
    var i:       usize = 0;
    var slashes: usize = 0;
    for (i < v.len) {
        val c: u8 = v.data[i];
        i = i + 1;
        if (c == '\\') {
            slashes = slashes + 1;
            val w: err[Fail] = sink.u8(out, c);
            if (sel w.err) { ret w; }
            cnt;
        }
        if (c == '"') {
            val doubled: err[Fail] = repeat(out, '\\', slashes + 1);
            if (sel doubled.err) { ret doubled; }
        }
        slashes = 0;
        val w: err[Fail] = sink.u8(out, c);
        if (sel w.err) { ret w; }
    }
    if (closes) { ret repeat(out, '\\', slashes); }
    ret err[Fail].ok{};
}

# whether `d` is about the symbol of the name `n`
fun about(d: *Directive, n: Id[Name]) bool {
    if (sel d.symbol.some) { ret d.symbol.some.index == n.index; }
    ret false;
}

fun refused(text: str, i: usize) res[usize, Fail] {
    ret res[usize, Fail].err{fail.in_indexed(fail.unsupported(text), "directive", i::u64)};
}

# write the subsystem option of `t`, when it states a subsystem, refusing a
# system version COFF has no form for
fun subsystem_of(t: *Target, out: *Sink) err[Fail] {
    if (sel t.subsystem.none) {
        if (sel t.version.some) { ret err[Fail].err{fail.unsupported("COFF states a system version only with a subsystem")}; }
        ret err[Fail].ok{};
    }
    val name: str       = t.subsystem.some.name;
    val head: err[Fail] = sink.text(out, " /SUBSYSTEM:");
    if (sel head.err) { ret head; }
    val w: err[Fail] = sink.text(out, name);
    if (sel w.err)          { ret w; }
    if (sel t.version.none) { ret err[Fail].ok{}; }
    val v: Version = t.version.some;
    if (v.patch != 0) { ret err[Fail].err{fail.unsupported("COFF states no patch level of a system version")}; }
    val c: err[Fail] = sink.u8(out, ',');
    if (sel c.err) { ret c; }
    val major: err[Fail] = sink.number(out, v.major::u64, 10);
    if (sel major.err) { ret major; }
    val d: err[Fail] = sink.u8(out, '.');
    if (sel d.err) { ret d; }
    ret sink.number(out, v.minor::u64, 10);
}

# whether `o` states an export directive
fun exports(o: *Object) bool {
    var i: usize = 0;
    for (i < table.count[Directive](?o.directives)) {
        if (at(o, i).kind == ?directive.EXPORT) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the longest options an export spec states after its name:
# `,@65535,NONAME,DATA,PRIVATE`
val TAIL_MAX: usize = 32;

# append the `n` bytes at `p` to the `len` bytes of `buf`
fun append(buf: *u8, len: usize, p: *u8, n: usize) usize {
    var i: usize = 0;
    for (i < n) {
        buf[len + i] = p[i];
        i            = i + 1;
    }
    ret len + n;
}

# the options of an export spec into `buf`, in the order the syntax names
# them, and how many bytes they take
fun options_of(x: *directive.Export, data: bool, buf: *u8) usize {
    var len: usize    = 0;
    val ord: opt[u16] = x.ordinal;
    if (sel ord.some) {
        len = append(buf, len, ",@"::*u8, 2);
        var digits: [5]u8;
        var count:  usize = 0;
        var v:      u16   = ord.some;
        for (count == 0 || v != 0) {
            digits[count] = '0' + (v % 10)::u8;
            v             = v / 10;
            count         = count + 1;
        }
        for (count > 0) {
            count    = count - 1;
            buf[len] = digits[count];
            len      = len + 1;
        }
        if (x.noname) { len = append(buf, len, ",NONAME"::*u8, 7); }
    }
    if (data)      { len = append(buf, len, ",DATA"::*u8, 5); }
    if (x.private) { len = append(buf, len, ",PRIVATE"::*u8, 8); }
    ret len;
}

# write the export `d` of `o`, whose first definition of each name `defs`
# holds: a forwarder as `name==forward`, an export by another name as
# `name=symbol`, then its options. one about a symbol `o` does not define is
# refused, as only the definition's kind says whether it is data
fun export_out(o: *Object, d: *Directive, defs: *Table[u32], out: *Sink) err[Fail] {
    var buf:   [TAIL_MAX]u8;
    val text:  View          = object.name_of(o, d.text);
    val fwd:   opt[Id[Name]] = d.export.forward;
    val about: opt[Id[Name]] = d.symbol;
    if (sel fwd.some) {
        val n: usize = options_of(?d.export, d.export.data, ?buf[0]);
        ret token_out(out, "/EXPORT:", text, "==", object.name_of(o, fwd.some), View{data: ?buf[0], len: n});
    }
    if (sel about.none) { ret err[Fail].err{fail.malformed("an export directive is about no symbol and forwards nowhere")}; }
    val first: u32 = table.items[u32](defs)[about.some.index];
    if (first == 0) { ret err[Fail].err{fail.unsupported("COFF states an export in the object that defines its symbol, as only the definition says whether it is data")}; }
    val y:    *Symbol = object.symbol_at(o, table.nth[Symbol]((first - 1)::usize));
    val n:    usize   = options_of(?d.export, symbol.names(y.kind, symbol.OBJECT), ?buf[0]);
    val tail: View    = View{data: ?buf[0], len: n};
    if (about.some.index == d.text.index) { ret token_out(out, "/EXPORT:", text, "", View{data: nil, len: 0}, tail); }
    ret token_out(out, "/EXPORT:", text, "=", object.name_of(o, about.some), tail);
}

# write the subsystem `t` states and each directive of `o` into `out` as the
# text of a .drectve section and say how many directives there are. a
# directive COFF has no form for is refused naming it
pub fun directives_of(o: *Object, t: *Target, out: *Sink) res[usize, Fail] {
    var defs: Table[u32] = table.make[u32](o.a);
    var d:    err[Fail]  = err[Fail].ok{};
    if (exports(o)) { d = definitions(o, ?defs); }
    if (sel d.err) {
        val dropped: err[Fail] = table.release[u32](?defs);
        ret res[usize, Fail].err{d.err};
    }
    val r:   res[usize, Fail] = directives_by(o, t, ?defs, out);
    val rel: err[Fail]        = table.release[u32](?defs);
    if (sel r.err)   { ret r; }
    if (sel rel.err) { ret res[usize, Fail].err{rel.err}; }
    ret r;
}

fun directives_by(o: *Object, t: *Target, defs: *Table[u32], out: *Sink) res[usize, Fail] {
    val s: err[Fail] = subsystem_of(t, out);
    if (sel s.err) { ret res[usize, Fail].err{s.err}; }
    val n:     usize = table.count[Directive](?o.directives);
    var i:     usize = 0;
    var empty: View  = View{data: nil, len: 0};
    for (i < n) {
        val d:    *Directive = table.at[Directive](?o.directives, table.nth[Directive](i));
        val text: View       = object.name_of(o, d.text);
        var w:    err[Fail]  = err[Fail].ok{};
        if (d.kind == ?directive.LIBRARY) {
            if (sel d.symbol.some) { ret refused("COFF has no form for a library directive about a symbol", i); }
            w = token_out(out, "/DEFAULTLIB:", text, "", empty, empty);
        }
        or (d.kind == ?directive.EXPORT) {
            w = export_out(o, d, defs, out);
            if (sel w.err) { ret res[usize, Fail].err{fail.in_indexed(w.err, "directive", i::u64)}; }
        }
        or (d.kind == ?directive.INCLUDE) {
            if (!about(d, d.text)) { ret refused("COFF has no form for an include directive whose text is not its symbol", i); }
            w = token_out(out, "/INCLUDE:", text, "", empty, empty);
        }
        or (d.kind == ?directive.ALTERNATE) {
            if (sel d.symbol.none) { ret refused("COFF has no form for an alternate directive about no symbol", i); }
            val from: View = object.name_of(o, d.symbol.some);
            w = token_out(out, "/ALTERNATENAME:", from, "=", object.name_of(o, d.text), empty);
        }
        or (d.kind == ?directive.OPTION) {
            if (sel d.symbol.some) { ret refused("COFF has no form for an option directive about a symbol", i); }
            w = token_out(out, "", text, "", empty, empty);
        }
        or {
            ret res[usize, Fail].err{fail.in_indexed(fail.about(fail.unsupported("COFF has no form for this directive"), d.kind.name), "directive", i::u64)};
        }
        if (sel w.err) { ret res[usize, Fail].err{w.err}; }
        i = i + 1;
    }
    ret res[usize, Fail].ok{n};
}

fun at(o: *Object, i: usize) *Directive {
    ret table.at[Directive](?o.directives, table.nth[Directive](i));
}
