# where a COFF object holds the mink note
#
# COFF has no note records, so the payload lower.mark encodes is the whole of
# a section named `.mink.ct`, its fields the architecture's address width,
# little-endian, relocated by the section's own relocations. the section is
# IMAGE_SCN_LNK_INFO and IMAGE_SCN_LNK_REMOVE, as .drectve is, so a linker
# drops it and applies none of its relocations. it is no neutral section:
# from_neutral lowers the object's constant-time ranges into it and
# to_neutral decodes them from it. a file that holds several such sections
# states the ranges of each, and a file without one carries no constant-time
# code.

use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.format.coff.model.tables;
use mink.lower.lowered;
use mink.lower.lowered.Added;
use mink.lower.lowered.Lowered;
use mink.lower.mark;
use mink.model.object.CtRange;
use mink.model.object.Object;
use mink.model.section;

# the name of the section that holds the payload
pub val SECTION: str = ".mink.ct";

# the alignment of the section
val ALIGN: u64 = 4;

# the characteristics the section is written with
pub val CHARACTERISTICS: u64 = tables.IMAGE_SCN_LNK_INFO.value | tables.IMAGE_SCN_LNK_REMOVE.value | tables.IMAGE_SCN_ALIGN_4BYTES.value;

# the width of the payload's fields in a file for the object's architecture,
# refused for one with no address width
pub fun width_of(o: *Object) res[u8, Fail] {
    val w: opt[u8] = arch.pointer_bytes(o.target.arch);
    if (sel w.none) { ret res[u8, Fail].err{fail.about(fail.unsupported("the architecture has no address width for the mink note's fields"), o.target.arch.name)}; }
    ret res[u8, Fail].ok{w.some};
}

# add to `low` the section of `o`'s constant-time ranges, adding nothing for
# an object with none. a refusal leaves `low` as it was
pub fun lower(o: *Object, low: *Lowered) err[Fail] {
    if (table.count[CtRange](?o.ct) == 0) { ret err[Fail].ok{}; }
    val width: res[u8, Fail] = width_of(o);
    if (sel width.err) { ret err[Fail].err{width.err}; }
    val m:   lowered.Mark = lowered.mark(low);
    var out: Sink         = sink.make(o.a, LITTLE);
    val r:   err[Fail]    = mark.write(o, width.ok, ?out, low, lowered.next_section(low), false);
    if (sel r.err) {
        val dropped: err[Fail] = sink.release(?out);
        val back:    err[Fail] = lowered.rollback(low, m);
        ret r;
    }
    val added: res[Id[Added], Fail] = lowered.add_section(low, Added{name: SECTION, kind: ?section.METADATA, flags: 0, align: ALIGN, disposition: ?section.ROOT, bytes: out});
    if (sel added.err) {
        val back: err[Fail] = lowered.rollback(low, m);
        ret err[Fail].err{added.err};
    }
    ret err[Fail].ok{};
}
