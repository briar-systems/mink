# the writer of a Windows import library
#
# an import library for a DLL is an archive of the three members that make the
# DLL's import descriptor and one short import object for every export, in the
# Windows archive variant with its two linker members. the descriptor, the
# null descriptor and the null thunk are COFF objects, built here from the
# machine's row of the targets. a symbol table names `__imp_<name>` for every
# export and `<name>` for the exports whose import type defines the name too,
# code and constants.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store.Bytes;
use mink.base.store.Span;
use mink.base.vectors;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.ar.write;
use mink.format.ar.write.Source;
use mink.format.coff.import.import;
use mink.format.coff.import.import.Export;
use mink.format.coff.import.import.Import;
use coff_model: mink.format.coff.model.model;
use mink.format.coff.model.tables;
use mink.format.coff.model.tables.Blob;
use mink.format.coff.model.tables.Constant;
use mink.format.coff.model.tables.MachineRow;

# what an import descriptor needs of a machine
# ---
# machines: the machine types the row serves
# count:    how many there are
# rebase:   the relocation of an address without the image base
# pointer:  the bytes of a thunk
# align:    the section alignment of a thunk table
# flags:    the header characteristic its objects carry, nil for none
pub rec Target {
    machines: **MachineRow;
    count:    usize;
    rebase:   *Constant;
    pointer:  usize;
    align:    *Constant;
    flags:    *Constant;
}

val X64_MACHINES:   [1]*MachineRow = [1]*MachineRow{?tables.MACHINE_ROW_AMD64};
val ARM64_MACHINES: [2]*MachineRow = [2]*MachineRow{?tables.MACHINE_ROW_ARM64, ?tables.MACHINE_ROW_ARM64EC};
val X86_MACHINES:   [1]*MachineRow = [1]*MachineRow{?tables.MACHINE_ROW_I386};
val ARM_MACHINES:   [1]*MachineRow = [1]*MachineRow{?tables.MACHINE_ROW_ARMNT};

pub val TARGET_COUNT: usize = 4;

pub val TARGETS: [TARGET_COUNT]Target = [TARGET_COUNT]Target{
    Target{machines: ?X64_MACHINES[0], count: 1, rebase: ?tables.IMAGE_REL_AMD64_ADDR32NB, pointer: 8, align: ?tables.IMAGE_SCN_ALIGN_8BYTES},
    Target{machines: ?ARM64_MACHINES[0], count: 2, rebase: ?tables.IMAGE_REL_ARM64_ADDR32NB, pointer: 8, align: ?tables.IMAGE_SCN_ALIGN_8BYTES},
    Target{machines: ?X86_MACHINES[0], count: 1, rebase: ?tables.IMAGE_REL_I386_DIR32NB, pointer: 4, align: ?tables.IMAGE_SCN_ALIGN_4BYTES, flags: ?tables.IMAGE_FILE_32BIT_MACHINE},
    Target{machines: ?ARM_MACHINES[0], count: 1, rebase: ?tables.IMAGE_REL_ARM_ADDR32NB, pointer: 4, align: ?tables.IMAGE_SCN_ALIGN_4BYTES, flags: ?tables.IMAGE_FILE_32BIT_MACHINE},
};

# the row that serves `machine`, none for a machine without one
pub fun target_of(machine: u64) opt[*Target] {
    var t: usize = 0;
    for (t < TARGET_COUNT) {
        var m: usize = 0;
        for (m < TARGETS[t].count) {
            if (TARGETS[t].machines[m].code.value == machine) { ret opt[*Target].some{?TARGETS[t]}; }
            m = m + 1;
        }
        t = t + 1;
    }
    ret opt[*Target].none{};
}

# a relocation of a section
rec Rel {
    offset: u32;
    symbol: u32;
}

# a section to write: the digit of its `.idata$` name and what it holds
rec Part {
    digit:  u8;
    flags:  u64;
    data:   Bytes;
    nul:    bool;
    relocs: *Rel;
    count:  usize;
}

# the bytes a part takes
fun part_len(p: *Part) usize {
    if (p.nul) { ret p.data.len + 1; }
    ret p.data.len;
}

# the name of the `.idata$` section `digit` in the eight bytes at `name`
fun section_name(digit: u8, name: *u8) {
    var i: usize = 0;
    for (i < tables.IDATA_STEM.len) {
        name[i] = tables.IDATA_STEM.data[i];
        i       = i + 1;
    }
    name[i] = '0' + digit;
}

# a symbol to write
rec Sym {
    name:    Bytes;
    section: u16;
    class:   *Constant;
}

# a COFF object of `parts` and `syms`, relocations of the type `rebase`
fun object(a: *A.Allocator, t: *Target, machine: u16, parts: *Part, np: usize, syms: *Sym, ns: usize, out: *Sink) err[Fail] {
    val at:     Location = Location{record: "import member"};
    val header: u64      = coff_model.REGULAR.header.size::u64;
    var pos:    u64      = header + coff_model.SECTION_SIZE * np::u64;
    var heads:  Sink     = sink.init(a, LITTLE);
    var k:      usize    = 0;
    for (k < np) {
        val p:       *Part = ?parts[k];
        var raw_ptr: u64   = 0;
        if (part_len(p) != 0) { raw_ptr = pos; }
        val res_after: res[u64, Fail] = checked.add(at, pos, part_len(p)::u64);
        if (sel res_after.err) {
            val err_dropped: err[Fail] = sink.dnit(?heads);
            ret err[Fail].err{res_after.err};
        }
        var reloc_ptr: u64 = 0;
        if (p.count != 0) { reloc_ptr = res_after.ok; }
        val res_next: res[u64, Fail] = checked.add(at, res_after.ok, p.count::u64 * coff_model.RELOC_SIZE);
        if (sel res_next.err) {
            val err_dropped: err[Fail] = sink.dnit(?heads);
            ret err[Fail].err{res_next.err};
        }
        pos = res_next.ok;
        val err_section_header: err[Fail] = section_header(?heads, p, raw_ptr, reloc_ptr);
        if (sel err_section_header.err) {
            val err_dropped: err[Fail] = sink.dnit(?heads);
            ret err_section_header;
        }
        k = k + 1;
    }
    var names:     Sink      = sink.init(a, LITTLE);
    var table_:    Sink      = sink.init(a, LITTLE);
    val err_sym:   err[Fail] = symbols(syms, ns, ?table_, ?names);
    var err_first: err[Fail] = err_sym;
    if (sel err_sym.ok) { err_first = lay(out, t, machine, parts, np, syms, ns, pos, ?heads, ?table_, ?names); }
    val err_heads_released: err[Fail] = sink.dnit(?heads);
    val err_names_released: err[Fail] = sink.dnit(?names);
    val err_table_released: err[Fail] = sink.dnit(?table_);
    if (sel err_first.err)          { ret err_first; }
    if (sel err_heads_released.err) { ret err_heads_released; }
    if (sel err_names_released.err) { ret err_names_released; }
    ret err_table_released;
}

# the 40 byte section header of `p` to `heads`, its data at `raw_ptr` and its
# relocations at `reloc_ptr`, each zero when it has none
fun section_header(heads: *Sink, p: *Part, raw_ptr: u64, reloc_ptr: u64) err[Fail] {
    var name: [8]u8;
    section_name(p.digit, ?name[0]);
    val err_section_name_written: err[Fail] = sink.bytes(heads, ?name[0], 8);
    if (sel err_section_name_written.err) { ret err_section_name_written; }
    val err_virtual_size_written: err[Fail] = sink.u32(heads, 0);
    if (sel err_virtual_size_written.err) { ret err_virtual_size_written; }
    val err_virtual_address_written: err[Fail] = sink.u32(heads, 0);
    if (sel err_virtual_address_written.err) { ret err_virtual_address_written; }
    val err_raw_size_written: err[Fail] = sink.u32(heads, part_len(p)::u32);
    if (sel err_raw_size_written.err) { ret err_raw_size_written; }
    val err_raw_pointer_written: err[Fail] = sink.u32(heads, raw_ptr::u32);
    if (sel err_raw_pointer_written.err) { ret err_raw_pointer_written; }
    val err_reloc_pointer_written: err[Fail] = sink.u32(heads, reloc_ptr::u32);
    if (sel err_reloc_pointer_written.err) { ret err_reloc_pointer_written; }
    val err_line_pointer_written: err[Fail] = sink.u32(heads, 0);
    if (sel err_line_pointer_written.err) { ret err_line_pointer_written; }
    val err_reloc_count_written: err[Fail] = sink.u16(heads, p.count::u16);
    if (sel err_reloc_count_written.err) { ret err_reloc_count_written; }
    val err_line_count_written: err[Fail] = sink.u16(heads, 0);
    if (sel err_line_count_written.err) { ret err_line_count_written; }
    ret sink.u32(heads, p.flags::u32);
}

# the symbol records and the string table that holds the names too long for one
fun symbols(syms: *Sym, ns: usize, records: *Sink, names: *Sink) err[Fail] {
    val err_strings_size_written: err[Fail] = sink.u32(names, 0);
    if (sel err_strings_size_written.err) { ret err_strings_size_written; }
    var k: usize = 0;
    for (k < ns) {
        val s: *Sym = ?syms[k];
        if (s.name.len <= 8) {
            val err_short_name_written: err[Fail] = sink.bytes(records, s.name.data, s.name.len);
            if (sel err_short_name_written.err) { ret err_short_name_written; }
            val err_short_name_pad_written: err[Fail] = sink.zeros(records, 8 - s.name.len);
            if (sel err_short_name_pad_written.err) { ret err_short_name_pad_written; }
        }
        or {
            val err_long_name_zero_written: err[Fail] = sink.u32(records, 0);
            if (sel err_long_name_zero_written.err) { ret err_long_name_zero_written; }
            val err_long_name_offset_written: err[Fail] = sink.u32(records, sink.len(names)::u32);
            if (sel err_long_name_offset_written.err) { ret err_long_name_offset_written; }
            val err_long_name_written: err[Fail] = sink.bytes(names, s.name.data, s.name.len);
            if (sel err_long_name_written.err) { ret err_long_name_written; }
            val err_long_name_terminator_written: err[Fail] = sink.u8(names, 0);
            if (sel err_long_name_terminator_written.err) { ret err_long_name_terminator_written; }
        }
        val err_value_written: err[Fail] = sink.u32(records, 0);
        if (sel err_value_written.err) { ret err_value_written; }
        val err_section_number_written: err[Fail] = sink.u16(records, s.section);
        if (sel err_section_number_written.err) { ret err_section_number_written; }
        val err_type_written: err[Fail] = sink.u16(records, 0);
        if (sel err_type_written.err) { ret err_type_written; }
        val err_storage_class_written: err[Fail] = sink.u8(records, s.class.value::u8);
        if (sel err_storage_class_written.err) { ret err_storage_class_written; }
        val err_aux_count_written: err[Fail] = sink.u8(records, 0);
        if (sel err_aux_count_written.err) { ret err_aux_count_written; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the file header, then the section headers, each part's data and
# relocations, the symbol records and the string table, to `out`. an object
# whose offsets pass 32 bits is refused
fun lay(out: *Sink, t: *Target, machine: u16, parts: *Part, np: usize, syms: *Sym, ns: usize, symtab: u64, heads: *Sink, records: *Sink, names: *Sink) err[Fail] {
    val limit: u64 = 0xffff_ffffu64;
    val strs:  u64 = sink.len(names)::u64;
    if (symtab > limit || strs > limit || symtab + sink.len(records)::u64 + strs > limit) {
        ret err[Fail].err{fail.in_record(fail.overflow("import member does not fit 32 bit offsets"), "import member")};
    }
    val err_machine_written: err[Fail] = sink.u16(out, machine);
    if (sel err_machine_written.err) { ret err_machine_written; }
    val err_section_count_written: err[Fail] = sink.u16(out, np::u16);
    if (sel err_section_count_written.err) { ret err_section_count_written; }
    val err_timestamp_written: err[Fail] = sink.u32(out, 0);
    if (sel err_timestamp_written.err) { ret err_timestamp_written; }
    val err_symtab_pointer_written: err[Fail] = sink.u32(out, symtab::u32);
    if (sel err_symtab_pointer_written.err) { ret err_symtab_pointer_written; }
    val err_symbol_count_written: err[Fail] = sink.u32(out, ns::u32);
    if (sel err_symbol_count_written.err) { ret err_symbol_count_written; }
    val err_optional_size_written: err[Fail] = sink.u16(out, 0);
    if (sel err_optional_size_written.err) { ret err_optional_size_written; }
    var characteristics: u16 = 0;
    if (t.flags != nil) { characteristics = t.flags.value::u16; }
    val err_characteristics_written: err[Fail] = sink.u16(out, characteristics);
    if (sel err_characteristics_written.err) { ret err_characteristics_written; }
    val err_section_headers_written: err[Fail] = sink.bytes(out, sink.data(heads), sink.len(heads));
    if (sel err_section_headers_written.err) { ret err_section_headers_written; }
    var k: usize = 0;
    for (k < np) {
        val p:                     *Part     = ?parts[k];
        val err_part_data_written: err[Fail] = sink.bytes(out, p.data.data, p.data.len);
        if (sel err_part_data_written.err) { ret err_part_data_written; }
        if (p.nul) {
            val err_w9b: err[Fail] = sink.u8(out, 0);
            if (sel err_w9b.err) { ret err_w9b; }
        }
        var j: usize = 0;
        for (j < p.count) {
            val err_reloc_offset_written: err[Fail] = sink.u32(out, p.relocs[j].offset);
            if (sel err_reloc_offset_written.err) { ret err_reloc_offset_written; }
            val err_reloc_symbol_written: err[Fail] = sink.u32(out, p.relocs[j].symbol);
            if (sel err_reloc_symbol_written.err) { ret err_reloc_symbol_written; }
            val err_reloc_type_written: err[Fail] = sink.u16(out, t.rebase.value::u16);
            if (sel err_reloc_type_written.err) { ret err_reloc_type_written; }
            j = j + 1;
        }
        k = k + 1;
    }
    val err_symbol_records_written: err[Fail] = sink.bytes(out, sink.data(records), sink.len(records));
    if (sel err_symbol_records_written.err) { ret err_symbol_records_written; }
    val err_strings_size_written: err[Fail] = sink.u32(out, strs::u32);
    if (sel err_strings_size_written.err) { ret err_strings_size_written; }
    ret sink.bytes(out, ?sink.data(names)[4], sink.len(names) - 4);
}

# everything an archive is built from: the bytes of every member and of every
# symbol name, and where each member's names lie
# ---
# bodies: the member bytes, one after the other
# labels: the symbol name bytes, one after the other
# pieces: the member bytes and symbol names of every member
# names:  where each symbol name lies in the labels
rec Pool {
    bodies: Sink;
    labels: Sink;
    pieces: Vector[Piece];
    names:  Vector[Span];
}

# one member: its bytes in the bodies and its first name and how many follow
rec Piece {
    body:  Span;
    first: usize;
    count: usize;
}

# an empty pool whose sinks and vectors allocate from `a`
fun pool(a: *A.Allocator) Pool {
    ret Pool{bodies: sink.init(a, LITTLE), labels: sink.init(a, LITTLE), pieces: vector.init[Piece](a), names: vector.init[Span](a)};
}

# give everything the pool holds back, reporting the first refusal
fun dnit(p: *Pool) err[Fail] {
    var err_first:           err[Fail] = sink.dnit(?p.bodies);
    val err_labels_released: err[Fail] = sink.dnit(?p.labels);
    if (sel err_first.ok && sel err_labels_released.err) { err_first = err_labels_released; }
    val err_pieces_released: err[Fail] = vectors.dnit[Piece](?p.pieces);
    if (sel err_first.ok && sel err_pieces_released.err) { err_first = err_pieces_released; }
    val err_names_released: err[Fail] = vectors.dnit[Span](?p.names);
    if (sel err_first.ok && sel err_names_released.err) { err_first = err_names_released; }
    ret err_first;
}

# a symbol name of `head`, `body` and `tail` that the member being built defines
fun define(p: *Pool, head: Bytes, body: Bytes, tail: Bytes) err[Fail] {
    val start:            usize     = sink.len(?p.labels);
    val err_head_written: err[Fail] = sink.bytes(?p.labels, head.data, head.len);
    if (sel err_head_written.err) { ret err_head_written; }
    val err_body_written: err[Fail] = sink.bytes(?p.labels, body.data, body.len);
    if (sel err_body_written.err) { ret err_body_written; }
    val err_tail_written: err[Fail] = sink.bytes(?p.labels, tail.data, tail.len);
    if (sel err_tail_written.err) { ret err_tail_written; }
    val err_pushed: err[Fail] = vectors.push[Span](?p.names, Span{start: start, len: sink.len(?p.labels) - start});
    if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
    ret err[Fail].ok{};
}

# the member that starts at `body` in the bodies and defines every name from
# `first` on
fun seal(p: *Pool, body: usize, first: usize) err[Fail] {
    val err_pushed: err[Fail] = vectors.push[Piece](?p.pieces, Piece{
        body: Span{start: body, len: sink.len(?p.bodies) - body}, first: first, count: vector.length[Span](?p.names) - first,
    });
    if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
    ret err[Fail].ok{};
}

# the characteristics of an initialized, readable and writable data section
# of alignment `align`
fun flags(align: u64) u64 {
    ret tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value | tables.IMAGE_SCN_MEM_WRITE.value | align;
}

# the part of the name of the DLL before its last dot
fun stem(dll: Bytes) Bytes {
    var n: usize = dll.len;
    for (n > 1 && dll.data[n - 1] != '.') { n = n - 1; }
    if (n <= 1) { ret dll; }
    ret Bytes{data: dll.data, len: n - 1};
}

# the bytes of `b`
fun view(b: Blob) Bytes {
    ret Bytes{data: b.data, len: b.len};
}

# the import descriptor of the DLL: its table addresses and its name
fun descriptor(a: *A.Allocator, t: *Target, machine: u16, dll: Bytes, thunk: Bytes, id: Bytes, out: *Sink) err[Fail] {
    var zero: [20]u8;
    var n2:   [8]u8;
    var n4:   [8]u8;
    var n5:   [8]u8;
    var n6:   [8]u8;
    section_name(tables.IDATA_DESCRIPTOR.value::u8, ?n2[0]);
    section_name(tables.IDATA_LOOKUP.value::u8, ?n4[0]);
    section_name(tables.IDATA_ADDRESS.value::u8, ?n5[0]);
    section_name(tables.IDATA_NAME.value::u8, ?n6[0]);
    val rels:  [3]Rel  = [3]Rel{Rel{offset: 12, symbol: 2}, Rel{offset: 0, symbol: 3}, Rel{offset: 16, symbol: 4}};
    val parts: [2]Part = [2]Part{
        Part{digit: tables.IDATA_DESCRIPTOR.value::u8, flags: flags(tables.IMAGE_SCN_ALIGN_4BYTES.value), data: Bytes{data: ?zero[0], len: 20}, relocs: ?rels[0], count: 3},
        Part{digit: tables.IDATA_NAME.value::u8, flags: flags(tables.IMAGE_SCN_ALIGN_2BYTES.value), data: dll, nul: true},
    };
    val syms: [7]Sym = [7]Sym{
        Sym{name: id, section: 1, class: ?tables.IMAGE_SYM_CLASS_EXTERNAL},
        Sym{name: Bytes{data: ?n2[0], len: 8}, section: 1, class: ?tables.IMAGE_SYM_CLASS_SECTION},
        Sym{name: Bytes{data: ?n6[0], len: 8}, section: 2, class: ?tables.IMAGE_SYM_CLASS_STATIC},
        Sym{name: Bytes{data: ?n4[0], len: 8}, section: 0, class: ?tables.IMAGE_SYM_CLASS_SECTION},
        Sym{name: Bytes{data: ?n5[0], len: 8}, section: 0, class: ?tables.IMAGE_SYM_CLASS_SECTION},
        Sym{name: view(tables.NULL_IMPORT_DESCRIPTOR), section: 0, class: ?tables.IMAGE_SYM_CLASS_EXTERNAL},
        Sym{name: thunk, section: 0, class: ?tables.IMAGE_SYM_CLASS_EXTERNAL},
    };
    ret object(a, t, machine, ?parts[0], 2, ?syms[0], 7, out);
}

# the null import descriptor that ends the descriptors of an image
fun terminator(a: *A.Allocator, t: *Target, machine: u16, out: *Sink) err[Fail] {
    var zero:  [20]u8;
    val parts: [1]Part = [1]Part{
        Part{digit: tables.IDATA_TERMINATOR.value::u8, flags: flags(tables.IMAGE_SCN_ALIGN_4BYTES.value), data: Bytes{data: ?zero[0], len: 20}},
    };
    val syms: [1]Sym = [1]Sym{Sym{name: view(tables.NULL_IMPORT_DESCRIPTOR), section: 1, class: ?tables.IMAGE_SYM_CLASS_EXTERNAL}};
    ret object(a, t, machine, ?parts[0], 1, ?syms[0], 1, out);
}

# the null thunk that ends the tables of the DLL
fun null_thunk(a: *A.Allocator, t: *Target, machine: u16, thunk: Bytes, out: *Sink) err[Fail] {
    var zero:  [8]u8;
    val parts: [2]Part = [2]Part{
        Part{digit: tables.IDATA_ADDRESS.value::u8, flags: flags(t.align.value), data: Bytes{data: ?zero[0], len: t.pointer}},
        Part{digit: tables.IDATA_LOOKUP.value::u8, flags: flags(t.align.value), data: Bytes{data: ?zero[0], len: t.pointer}},
    };
    val syms: [1]Sym = [1]Sym{Sym{name: thunk, section: 1, class: ?tables.IMAGE_SYM_CLASS_EXTERNAL}};
    ret object(a, t, machine, ?parts[0], 2, ?syms[0], 1, out);
}

# an import library of `count` exports of the DLL `dll`, for `machine`. the
# exports and the name of the DLL are borrowed for the call
pub fun build(a: *A.Allocator, machine: u16, dll: Bytes, exports: *Export, count: usize) res[Sink, Fail] {
    val opt_target: opt[*Target] = target_of(machine::u64);
    if (sel opt_target.none) {
        ret res[Sink, Fail].err{fail.in_record(fail.unsupported("no import descriptor layout for this machine"), "import library")};
    }
    if (dll.len == 0 || import.hollow(dll)) {
        ret res[Sink, Fail].err{fail.in_record(fail.malformed("DLL name is empty or holds a NUL byte"), "import library")};
    }
    var p:        Pool      = pool(a);
    val err_made: err[Fail] = members(a, opt_target.some, machine, dll, exports, count, ?p);
    var res_out:  res[Sink, Fail];
    if (sel err_made.err) { res_out = res[Sink, Fail].err{err_made.err}; }
    or                    { res_out = archive(a, dll, ?p); }
    val err_freed: err[Fail] = dnit(?p);
    if (sel res_out.err) { ret res_out; }
    if (sel err_freed.err) {
        val err_dropped: err[Fail] = sink.dnit(?res_out.ok);
        ret res[Sink, Fail].err{err_freed.err};
    }
    ret res_out;
}

val NOTHING: [1]u8 = [1]u8{0};

# no bytes, at a valid address
fun empty() Bytes {
    ret Bytes{data: ?NOTHING[0], len: 0};
}

# every member of the library pooled into `p`, with scratch for the descriptor
# and null thunk names released before return
fun members(a: *A.Allocator, t: *Target, machine: u16, dll: Bytes, exports: *Export, count: usize, p: *Pool) err[Fail] {
    val st:        Bytes     = stem(dll);
    var fixed:     Sink      = sink.init(a, LITTLE);
    val err_made:  err[Fail] = members_in(a, t, machine, dll, st, exports, count, p, ?fixed);
    val err_freed: err[Fail] = sink.dnit(?fixed);
    if (sel err_made.err) { ret err_made; }
    ret err_freed;
}

# the descriptor, the null descriptor, the null thunk and a short import
# object for each export pooled into `p`, each with the names it defines.
# `fixed` takes the descriptor and null thunk names built from `st`
fun members_in(a: *A.Allocator, t: *Target, machine: u16, dll: Bytes, st: Bytes, exports: *Export, count: usize, p: *Pool, fixed: *Sink) err[Fail] {
    val err_descriptor_prefix_written: err[Fail] = sink.bytes(fixed, tables.IMPORT_DESCRIPTOR_PREFIX.data, tables.IMPORT_DESCRIPTOR_PREFIX.len);
    if (sel err_descriptor_prefix_written.err) { ret err_descriptor_prefix_written; }
    val err_descriptor_stem_written: err[Fail] = sink.bytes(fixed, st.data, st.len);
    if (sel err_descriptor_stem_written.err) { ret err_descriptor_stem_written; }
    val cut:                      usize     = sink.len(fixed);
    val err_thunk_prefix_written: err[Fail] = sink.bytes(fixed, tables.NULL_THUNK_PREFIX.data, tables.NULL_THUNK_PREFIX.len);
    if (sel err_thunk_prefix_written.err) { ret err_thunk_prefix_written; }
    val err_thunk_stem_written: err[Fail] = sink.bytes(fixed, st.data, st.len);
    if (sel err_thunk_stem_written.err) { ret err_thunk_stem_written; }
    val err_thunk_suffix_written: err[Fail] = sink.bytes(fixed, tables.NULL_THUNK_SUFFIX.data, tables.NULL_THUNK_SUFFIX.len);
    if (sel err_thunk_suffix_written.err) { ret err_thunk_suffix_written; }
    val id:    Bytes = Bytes{data: sink.data(fixed), len: cut};
    val thunk: Bytes = Bytes{data: ?sink.data(fixed)[cut], len: sink.len(fixed) - cut};

    var body:                   usize     = sink.len(?p.bodies);
    var first:                  usize     = vector.length[Span](?p.names);
    val err_descriptor_defined: err[Fail] = define(p, id, empty(), empty());
    if (sel err_descriptor_defined.err) { ret err_descriptor_defined; }
    val err_descriptor_built: err[Fail] = descriptor(a, t, machine, dll, thunk, id, ?p.bodies);
    if (sel err_descriptor_built.err) { ret err_descriptor_built; }
    val err_descriptor_sealed: err[Fail] = seal(p, body, first);
    if (sel err_descriptor_sealed.err) { ret err_descriptor_sealed; }

    body  = sink.len(?p.bodies);
    first = vector.length[Span](?p.names);
    val err_terminator_defined: err[Fail] = define(p, view(tables.NULL_IMPORT_DESCRIPTOR), empty(), empty());
    if (sel err_terminator_defined.err) { ret err_terminator_defined; }
    val err_terminator_built: err[Fail] = terminator(a, t, machine, ?p.bodies);
    if (sel err_terminator_built.err) { ret err_terminator_built; }
    val err_terminator_sealed: err[Fail] = seal(p, body, first);
    if (sel err_terminator_sealed.err) { ret err_terminator_sealed; }

    body  = sink.len(?p.bodies);
    first = vector.length[Span](?p.names);
    val err_null_thunk_defined: err[Fail] = define(p, thunk, empty(), empty());
    if (sel err_null_thunk_defined.err) { ret err_null_thunk_defined; }
    val err_null_thunk_built: err[Fail] = null_thunk(a, t, machine, thunk, ?p.bodies);
    if (sel err_null_thunk_built.err) { ret err_null_thunk_built; }
    val err_null_thunk_sealed: err[Fail] = seal(p, body, first);
    if (sel err_null_thunk_sealed.err) { ret err_null_thunk_sealed; }

    var k: usize = 0;
    for (k < count) {
        val e: *Export = ?exports[k];
        body  = sink.len(?p.bodies);
        first = vector.length[Span](?p.names);
        val res_imp: res[Import, Fail] = import.init(a, machine, dll, e);
        if (sel res_imp.err) { ret err[Fail].err{fail.in_indexed(res_imp.err, "export", k::u64)}; }
        var i:       Import          = res_imp.ok;
        val res_out: res[Sink, Fail] = import.write(a, ?i);
        if (sel res_out.err) {
            val err_dropped: err[Fail] = import.dnit(?i);
            ret err[Fail].err{res_out.err};
        }
        var o:                        Sink      = res_out.ok;
        val err_import_written:       err[Fail] = sink.bytes(?p.bodies, sink.data(?o), sink.len(?o));
        val err_import_sink_released: err[Fail] = sink.dnit(?o);
        val err_import_released:      err[Fail] = import.dnit(?i);
        if (sel err_import_written.err)       { ret err_import_written; }
        if (sel err_import_sink_released.err) { ret err_import_sink_released; }
        if (sel err_import_released.err)      { ret err_import_released; }
        val err_import_pointer_defined: err[Fail] = define(p, view(tables.IMPORT_POINTER_PREFIX), e.name, empty());
        if (sel err_import_pointer_defined.err) { ret err_import_pointer_defined; }
        # make refused a type the specification does not name
        val opt_typed: opt[*import.TypeRule] = import.type_of(e.kind::u64);
        if (sel opt_typed.some) {
            if (opt_typed.some.named) {
                val err_import_name_defined: err[Fail] = define(p, empty(), e.name, empty());
                if (sel err_import_name_defined.err) { ret err_import_name_defined; }
            }
        }
        val err_import_sealed: err[Fail] = seal(p, body, first);
        if (sel err_import_sealed.err) { ret err_import_sealed; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the archive of the pooled members, all named for the DLL
fun archive(a: *A.Allocator, dll: Bytes, p: *Pool) res[Sink, Fail] {
    var names:                Vector[Bytes]   = vector.init[Bytes](a);
    var sources:              Vector[Source]  = vector.init[Source](a);
    val res_built:            res[Sink, Fail] = archive_of(dll, p, ?names, ?sources);
    val err_names_released:   err[Fail]       = vectors.dnit[Bytes](?names);
    val err_sources_released: err[Fail]       = vectors.dnit[Source](?sources);
    if (sel res_built.err) { ret res_built; }
    if (sel err_names_released.err) {
        val err_dropped: err[Fail] = sink.dnit(?res_built.ok);
        ret res[Sink, Fail].err{err_names_released.err};
    }
    if (sel err_sources_released.err) {
        val err_dropped: err[Fail] = sink.dnit(?res_built.ok);
        ret res[Sink, Fail].err{err_sources_released.err};
    }
    ret res_built;
}

# the Windows archive of the pooled members, `names` and `sources` filled as
# the views it is built from
fun archive_of(dll: Bytes, p: *Pool, names: *Vector[Bytes], sources: *Vector[Source]) res[Sink, Fail] {
    val spans: *Span = p.names.data;
    var k:     usize = 0;
    for (k < vector.length[Span](?p.names)) {
        val err_pushed: err[Fail] = vectors.push[Bytes](names, Bytes{data: ?sink.data(?p.labels)[spans[k].start], len: spans[k].len});
        if (sel err_pushed.err) { ret res[Sink, Fail].err{err_pushed.err}; }
        k = k + 1;
    }
    val pieces: *Piece = p.pieces.data;
    k = 0;
    for (k < vector.length[Piece](?p.pieces)) {
        val err_pushed: err[Fail] = vectors.push[Source](sources, Source{
            name: dll, data: Bytes{data: ?sink.data(?p.bodies)[pieces[k].body.start], len: pieces[k].body.len}, names: ?names.data[pieces[k].first], count: pieces[k].count,
        });
        if (sel err_pushed.err) { ret res[Sink, Fail].err{err_pushed.err}; }
        k = k + 1;
    }
    ret write.build(names.a, ?write.WINDOWS_AR, sources.data, vector.length[Source](sources));
}
