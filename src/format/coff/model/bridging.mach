# the pairing of an ARM64EC thunk map type word with the bridge role it
# states. the word is a COFF fact, so the neutral role rows do not carry it
# and every COFF reader and writer of .hybmp$x pairs through this table

use std.types.option.opt;
use std.types.size.usize;

use mink.format.coff.model.tables;
use mink.model.bridge;

pub rec Bridging {
    code: *tables.Constant;
    role: *bridge.Role;
}

pub val BRIDGING_COUNT: usize                    = 3;
pub val BRIDGINGS:      [BRIDGING_COUNT]Bridging = [BRIDGING_COUNT]Bridging{
    Bridging{code: ?tables.ARM64EC_THUNK_GUEST_EXIT, role: ?bridge.GUEST_EXIT},
    Bridging{code: ?tables.ARM64EC_THUNK_ENTRY, role: ?bridge.ENTRY},
    Bridging{code: ?tables.ARM64EC_THUNK_EXIT, role: ?bridge.EXIT},
};

pub fun role_of(code: u32) opt[*bridge.Role] {
    var i: usize = 0;
    for (i < BRIDGING_COUNT) {
        if (BRIDGINGS[i].code.value == code::u64) { ret opt[*bridge.Role].some{BRIDGINGS[i].role}; }
        i = i + 1;
    }
    ret opt[*bridge.Role].none{};
}

pub fun code_of(r: *bridge.Role) opt[u32] {
    var i: usize = 0;
    for (i < BRIDGING_COUNT) {
        if (BRIDGINGS[i].role == r) { ret opt[u32].some{BRIDGINGS[i].code.value::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}
