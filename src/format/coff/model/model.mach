    if (sel r.ok.none) { ret res[opt[*Table[ImportDescriptor]], Fail].ok{opt[*Table[ImportDescriptor]].none{}}; }
    val p: *Piece = r.ok.some;
    if (!sel p.imports) { ret res[opt[*Table[ImportDescriptor]], Fail].err{mismatch(?tables.IMAGE_DIRECTORY_ENTRY_IMPORT)}; }
    ret res[opt[*Table[ImportDescriptor]], Fail].ok{opt[*Table[ImportDescriptor]].some{?p.imports}};
}

