# the CLR header
pub fun clr(m: *Coff) res[opt[*ClrHeader], Fail] {
    val r: res[opt[*Piece], Fail] = directory_piece(m, ?tables.IMAGE_DIRECTORY_ENTRY_COM_DESCRIPTOR);
    if (sel r.err)     { ret res[opt[*ClrHeader], Fail].err{r.err}; }
    if (sel r.ok.none) { ret res[opt[*ClrHeader], Fail].ok{opt[*ClrHeader].none{}}; }
