# the PE/COFF model, every byte of a COFF object or a PE image
#
# one model serves a regular COFF object, a bigobj and a PE32 or PE32+ image.
# a Shape names the object layout, whose rows give the file header and the
# symbol records, and for an image the optional header layout, whose rows give
# the place of each field and the address width. every field is held as its raw
# number, so a value in a reserved or unnamed range is kept as it was. what the
# numbers mean is the tables', never the model's.
#
# the file is an ordered list of extents tiling it from its first byte to its
# last: the MS-DOS stub, the PE signature, the file header, the optional
# header, the section header table, a section's bytes, a section's relocations
# or line numbers, the symbol table, the string table, records outside every
# section such as the certificate table, or raw bytes no record covers, such as
# padding and gaps. a section's bytes are either raw or a tiling of typed
# pieces, record after record, one piece for every structure a data directory
# names and raw pieces between them. a writer gives back every input byte for
# byte.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Raw;
use mink.base.store.Store;
use mink.base.store.Why;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.slot.Slot;
use mink.catalog.arch;
use mink.catalog.arch.Stated;
use mink.catalog.format;
use mink.format.coff.model.tables;
use mink.format.coff.model.tables.Constant;
use mink.lower.FrameForm;
use mink.lower.unwind.anchor.Anchor;

# the file header, regular or bigobj. a bigobj opens with the two signature
# words of an anonymous object and states the class id of the bigobj, which
# a writer writes from the table row the reader checks
pub rec HeaderShape {
    size:            usize;
    sig1:            Slot;
    sig2:            Slot;
    version:         Slot;
    machine:         Slot;
    nsections:       Slot;
    timestamp:       Slot;
    symtab_ptr:      Slot;
    nsymbols:        Slot;
    opt_size:        Slot;
    characteristics: Slot;
    class_id:        Slot;
    size_of_data:    Slot;
    flags:           Slot;
    meta_size:       Slot;
    meta_offset:     Slot;
}

# a symbol record, whose size is also the size of an auxiliary record
pub rec SymbolShape {
    size:    usize;
    name:    Slot;
    value:   Slot;
    section: Slot;
    type:    Slot;
    class:   Slot;
    naux:    Slot;
}

# the layout of an object file: regular or bigobj
pub rec ObjectShape {
    header: HeaderShape;
    symbol: SymbolShape;
}

# the optional header of an image, up to and including NumberOfRvaAndSizes
# ---
# size:  the bytes before the data directories
# magic: the value of the magic field that selects this layout
# addr:  the width of an address, which is also the width of a thunk
pub rec ImageShape {
    size:              usize;
    magic:             *Constant;
    addr:              usize;
    linker_major:      Slot;
    linker_minor:      Slot;
    code_size:         Slot;
    init_data_size:    Slot;
    uninit_data_size:  Slot;
    entry:             Slot;
    code_base:         Slot;
    data_base:         Slot;
    image_base:        Slot;
    section_alignment: Slot;
    file_alignment:    Slot;
    os_major:          Slot;
    os_minor:          Slot;
    image_major:       Slot;
    image_minor:       Slot;
    subsystem_major:   Slot;
    subsystem_minor:   Slot;
    win32_version:     Slot;
    image_size:        Slot;
    headers_size:      Slot;
    checksum:          Slot;
    subsystem:         Slot;
    dll_flags:         Slot;
    stack_reserve:     Slot;
    stack_commit:      Slot;
    heap_reserve:      Slot;
    heap_commit:       Slot;
    loader_flags:      Slot;
    dir_count:         Slot;
}

# a file's layouts. an object file has no image layout until its optional
# header is read
pub rec Shape {
    object: *ObjectShape;
    image:  opt[*ImageShape];
}

pub val REGULAR: ObjectShape = ObjectShape{
    header: HeaderShape{
        size:            20,
        machine:         Slot{offset: 0, width: 2},
        nsections:       Slot{offset: 2, width: 2},
        timestamp:       Slot{offset: 4, width: 4},
        symtab_ptr:      Slot{offset: 8, width: 4},
        nsymbols:        Slot{offset: 12, width: 4},
        opt_size:        Slot{offset: 16, width: 2},
        characteristics: Slot{offset: 18, width: 2},
    },
    symbol: SymbolShape{
        size:    18,
        name:    Slot{offset: 0, width: 8},
        value:   Slot{offset: 8, width: 4},
        section: Slot{offset: 12, width: 2},
        type:    Slot{offset: 14, width: 2},
        class:   Slot{offset: 16, width: 1},
        naux:    Slot{offset: 17, width: 1},
    },
};

pub val BIGOBJ: ObjectShape = ObjectShape{
    header: HeaderShape{
        size:         56,
        sig1:         Slot{offset: 0, width: 2},
        sig2:         Slot{offset: 2, width: 2},
        version:      Slot{offset: 4, width: 2},
        machine:      Slot{offset: 6, width: 2},
