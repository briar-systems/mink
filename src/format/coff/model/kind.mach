# the kind of file a COFF model is
#
# an object, regular or bigobj, is relocatable and a short import object is a
# stub naming one export of a DLL. a PE image is a DLL when its
# characteristics say so. any other image is an executable, which its loader
# may place at any address when its optional header has DYNAMIC_BASE and its
# relocations are not stripped. an executable with no optional header to read
# that from is refused, as which it is cannot be told.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.format.coff.model.model.Coff;
use mink.format.coff.model.tables;
use mink.format.coff.read.Parsed;

pub fun of(p: *Parsed) res[*Kind, Fail] {
    if (sel p.short) { ret res[*Kind, Fail].ok{?kind.STUB}; }
    ret image(?p.object);
}

fun image(m: *Coff) res[*Kind, Fail] {
    val sig: opt[u32] = m.signature;
    if (sel sig.none) { ret res[*Kind, Fail].ok{?kind.RELOCATABLE}; }
    val ch: u64 = m.header.characteristics::u64;
    if ((ch & tables.IMAGE_FILE_DLL.value) != 0) { ret res[*Kind, Fail].ok{?kind.SHARED}; }
    if (!sel m.optional.image) {
        ret res[*Kind, Fail].err{fail.in_record(fail.unsupported("an image with no optional header to read DYNAMIC_BASE from has no kind"), "optional header")};
    }
    val moves: bool = (m.optional.image.dll_flags::u64 & tables.IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE.value) != 0;
    if (moves && (ch & tables.IMAGE_FILE_RELOCS_STRIPPED.value) == 0) { ret res[*Kind, Fail].ok{?kind.PIE}; }
    ret res[*Kind, Fail].ok{?kind.EXECUTABLE};
}
