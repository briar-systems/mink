pub val IMPORT_AUX_PREFIX:       Blob   = Blob{name: "IMPORT_AUX_PREFIX", data: ?IMPORT_AUX_PREFIX_BYTES[0], len: 10, source: "llvm Object/COFFImportFile.cpp, __imp_aux_"};

# the type word of an entry of the ARM64EC thunk map, .hybmp$x: the entry
# maps a function to its entry thunk, a callee to its exit thunk, or a callee
# to the native stand-in that leaves for it. the map is undocumented, and
# the codes are llvm's
pub val ARM64EC_THUNK_GUEST_EXIT: Constant = Constant{name: "Arm64ECThunkType::GuestExit", value: 0x0, display: opt[str].some{"GuestExit"}, source: "llvm IR/CallingConv.h and lld COFF/Chunks.h, Arm64ECThunkType"};
pub val ARM64EC_THUNK_ENTRY:      Constant = Constant{name: "Arm64ECThunkType::Entry", value: 0x1, display: opt[str].some{"Entry"}, source: "llvm IR/CallingConv.h and lld COFF/Chunks.h, Arm64ECThunkType"};
pub val ARM64EC_THUNK_EXIT:       Constant = Constant{name: "Arm64ECThunkType::Exit", value: 0x4, display: opt[str].some{"Exit"}, source: "llvm IR/CallingConv.h and lld COFF/Chunks.h, Arm64ECThunkType"};

# an entry of the ARM64EC thunk map: the symbol table index of the symbol
# served, that of its thunk, and the type word, each four bytes
pub val ARM64EC_THUNK_ENTRY_SIZE: u64 = 12;

# the kind a range of the ARM64EC code map states in the low two bits of its
