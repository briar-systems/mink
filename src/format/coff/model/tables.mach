# the machine a row names: its code constant, the relocation set the machine uses (none
# when mink has no table for it) and the spelling llvm-readobj gives its import objects
# (none for a machine llvm names no spelling for, which it prints as an unknown arch)
pub rec MachineRow {
    code:   *Constant;
    rel:    opt[*Set];
    format: opt[str];
}

pub val MACHINE_ROW_I386:    MachineRow = MachineRow{code: ?IMAGE_FILE_MACHINE_I386, rel: opt[*Set].some{?REL_I386}, format: opt[str].some{"i386"}};
pub val MACHINE_ROW_ARM:     MachineRow = MachineRow{code: ?IMAGE_FILE_MACHINE_ARM, rel: opt[*Set].some{?REL_ARM}, format: opt[str].none{}};
pub val MACHINE_ROW_ARMNT:   MachineRow = MachineRow{code: ?IMAGE_FILE_MACHINE_ARMNT, rel: opt[*Set].some{?REL_ARM}, format: opt[str].some{"ARM"}};
pub val MACHINE_ROW_AMD64:   MachineRow = MachineRow{code: ?IMAGE_FILE_MACHINE_AMD64, rel: opt[*Set].some{?REL_AMD64}, format: opt[str].some{"x86-64"}};
pub val MACHINE_ROW_ARM64EC: MachineRow = MachineRow{code: ?IMAGE_FILE_MACHINE_ARM64EC, rel: opt[*Set].some{?REL_ARM64}, format: opt[str].some{"ARM64EC"}};
pub val MACHINE_ROW_ARM64X:  MachineRow = MachineRow{code: ?IMAGE_FILE_MACHINE_ARM64X, rel: opt[*Set].some{?REL_ARM64}, format: opt[str].some{"ARM64X"}};
pub val MACHINE_ROW_ARM64:   MachineRow = MachineRow{code: ?IMAGE_FILE_MACHINE_ARM64, rel: opt[*Set].some{?REL_ARM64}, format: opt[str].some{"ARM64"}};

val MACHINES_BY_CODE_COUNT: usize          = 7;
val MACHINES_BY_CODE:       [7]*MachineRow = [7]*MachineRow{
    ?MACHINE_ROW_I386,
    ?MACHINE_ROW_ARM,
    ?MACHINE_ROW_ARMNT,
    ?MACHINE_ROW_AMD64,
    ?MACHINE_ROW_ARM64EC,
    ?MACHINE_ROW_ARM64X,
    ?MACHINE_ROW_ARM64,
};

# the machine row of `code`, found by binary search over the rows sorted by code
pub fun machine(code: u64) opt[*MachineRow] {
    var lo: usize = 0;
    var hi: usize = MACHINES_BY_CODE_COUNT;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val v:   u64   = MACHINES_BY_CODE[mid].code.value::u64;
        if (v == code) { ret opt[*MachineRow].some{MACHINES_BY_CODE[mid]}; }
        if (v < code)  { lo = mid + 1; }
        if (v > code)  { hi = mid; }
    }
    ret opt[*MachineRow].none{};
}

# llvm BinaryFormat/COFF.h, BigObjMagic
pub val BIGOBJ_CLASS_ID_BYTES: [16]u8 = [16]u8{0xc7, 0xa1, 0xba, 0xd1, 0xee, 0xba, 0xa9, 0x4b, 0xaf, 0x20, 0xfa, 0xf6, 0x6a, 0xa4, 0xdc, 0xb8};
