# the relocation kinds of COFF
#
# a kind every machine's set shares, as the image-relative, section-relative
# and section index forms, and a kind only one machine's set holds. a code that
# counts its distance from past its field, as REL32 counts from the byte after
# its four, is a kind of its own whose row adds that bias, so the kind and the
# field's addend read back as the code. the codes no linker gives a value, the
# span-dependent forms and the i386 segment selector, are kinds whose rows
# refuse a link.

use mink.model.reloc;
use mink.model.reloc.Kind;

pub val IMAGE32:   Kind = Kind{name: "addr32nb", caps: reloc.IMAGE, takes: ?reloc.NAMED};
pub val SECREL32:  Kind = Kind{name: "secrel", caps: reloc.SECREL, takes: ?reloc.NAMED};
pub val SECREL7:   Kind = Kind{name: "secrel7", caps: reloc.SECREL, takes: ?reloc.NAMED};
pub val SECTION16: Kind = Kind{name: "section", caps: reloc.SECIDX, takes: ?reloc.NAMED};
pub val TOKEN:     Kind = Kind{name: "token", caps: reloc.INDEX, takes: ?reloc.NAMED};
pub val REL32:     Kind = Kind{name: "rel32", caps: reloc.PC, takes: ?reloc.NAMED};

pub val REL32_1: Kind = Kind{name: "rel32_1", caps: reloc.PC, takes: ?reloc.NAMED};
pub val REL32_2: Kind = Kind{name: "rel32_2", caps: reloc.PC, takes: ?reloc.NAMED};
pub val REL32_3: Kind = Kind{name: "rel32_3", caps: reloc.PC, takes: ?reloc.NAMED};
pub val REL32_4: Kind = Kind{name: "rel32_4", caps: reloc.PC, takes: ?reloc.NAMED};
pub val REL32_5: Kind = Kind{name: "rel32_5", caps: reloc.PC, takes: ?reloc.NAMED};
pub val SREL32:  Kind = Kind{name: "srel32", caps: reloc.PC, takes: ?reloc.NAMED};
pub val SSPAN32: Kind = Kind{name: "sspan32", caps: reloc.PC, takes: ?reloc.NAMED};
# the record after a span-dependent one, whose symbol field holds a number
pub val PAIR: Kind = Kind{name: "pair", caps: reloc.MARKER | reloc.PARTNER, takes: ?reloc.NAMELESS};

pub val REL16: Kind = Kind{name: "rel16", caps: reloc.PC, takes: ?reloc.NAMED};
pub val SEG12: Kind = Kind{name: "seg12", caps: reloc.SECIDX, takes: ?reloc.NAMED};

pub val BRANCH26:       Kind = Kind{name: "branch26", caps: reloc.PC, takes: ?reloc.NAMED};
pub val BRANCH19:       Kind = Kind{name: "branch19", caps: reloc.PC, takes: ?reloc.NAMED};
pub val BRANCH14:       Kind = Kind{name: "branch14", caps: reloc.PC, takes: ?reloc.NAMED};
pub val PAGEBASE_REL21: Kind = Kind{name: "pagebase_rel21", caps: reloc.PC | reloc.PAGE, takes: ?reloc.NAMED};
pub val REL21:          Kind = Kind{name: "rel21", caps: reloc.PC, takes: ?reloc.NAMED};
pub val PAGEOFFSET_12A: Kind = Kind{name: "pageoffset_12a", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val PAGEOFFSET_12L: Kind = Kind{name: "pageoffset_12l", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SECREL_LOW12A:  Kind = Kind{name: "secrel_low12a", caps: reloc.SECREL, takes: ?reloc.NAMED};
pub val SECREL_HIGH12A: Kind = Kind{name: "secrel_high12a", caps: reloc.SECREL, takes: ?reloc.NAMED};
pub val SECREL_LOW12L:  Kind = Kind{name: "secrel_low12l", caps: reloc.SECREL, takes: ?reloc.NAMED};
