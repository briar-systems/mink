# the relocation kinds of COFF
#
# a kind every machine's set shares, as the image-relative, section-relative
# and section index forms, and a kind only one machine's set holds. the ARM64
# kinds are the neutral model's, which every AArch64 pair shares. the codes
# no linker gives a value, the span-dependent forms and the i386 segment
# selector, are kinds whose rows refuse a link.

use mink.model.reloc;
use mink.model.reloc.Kind;

pub val IMAGE32:   Kind = Kind{name: "addr32nb", caps: reloc.IMAGE, takes: ?reloc.NAMED};
pub val SECREL32:  Kind = Kind{name: "secrel", caps: reloc.SECREL, takes: ?reloc.NAMED};
pub val SECREL7:   Kind = Kind{name: "secrel7", caps: reloc.SECREL, takes: ?reloc.NAMED};
pub val SECTION16: Kind = Kind{name: "section", caps: reloc.SECIDX, takes: ?reloc.NAMED};
pub val TOKEN:     Kind = Kind{name: "token", caps: reloc.INDEX, takes: ?reloc.NAMED};

pub val SREL32:  Kind = Kind{name: "srel32", caps: reloc.PC, takes: ?reloc.NAMED};
pub val SSPAN32: Kind = Kind{name: "sspan32", caps: reloc.PC, takes: ?reloc.NAMED};
# the record after a span-dependent one, whose symbol field holds a number
pub val PAIR: Kind = Kind{name: "pair", caps: reloc.MARKER | reloc.PARTNER, takes: ?reloc.NAMELESS};

pub val SEG12: Kind = Kind{name: "seg12", caps: reloc.SECIDX, takes: ?reloc.NAMED};
