# the COFF relocation rows of the AMD64, I386, ARM64 and ARM64EC pairs
#
# every relocation type the vendored LLVM list names for the three machines
# has a row, keyed by its type and named as the PE Format names it. COFF
# records hold no addend, so a row reads its addend from the field it patches,
# little endian, except where a row says otherwise: the ARM64 page base holds
# its byte addend unscaled in the field that takes the page delta, a code with
# no addend states none, and the AMD64 PAIR record holds a number in its symbol
# field, which is the addend of the span-dependent record it follows. a code
# that counts from past its field, as REL32 counts from the byte after its
# four, states that bias, so REL32 is the neutral PC32 and REL16 the neutral
# PC16 while REL32_1 to REL32_5, which count from further past, keep kinds of
# their own. the section index takes the field's addend, as
# lld-link adds the index to it. a scaled ARM64 load or store offset is written
# through the field its instruction's size and register class choose, each
# with the alignment its scale asks. the codes no linker gives a value, AMD64
# SREL32, SSPAN32 and SECREL7 and I386 SEG12 and SECREL7, refuse a link. ARM64EC
# shares the ARM64 rows by reference under its own machine.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail.Fail;
use mink.catalog.arch;
use mink.catalog.arch.Code;
use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.format.coff.model.tables;
use coff_kinds: mink.format.coff.reloc.kinds;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.compute;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row;
use mink.reloc.row.Addend;
use mink.reloc.row.FieldChoice;
use mink.reloc.row.Keys;
use mink.reloc.row.Link;
use mink.reloc.row.PairRule;
use mink.reloc.row.Role;
use mink.reloc.row.Row;
use mink.reloc.row.Set;

val P16: [1]Piece = [1]Piece{Piece{at: 0, width: 16}};
val P32: [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val P64: [1]Piece = [1]Piece{Piece{at: 0, width: 64}};

val N0:  Field = Field{bytes: 0};
val B16: Field = Field{bytes: 2, pieces: ?P16[0], count: 1};
val B32: Field = Field{bytes: 4, pieces: ?P32[0], count: 1};
val B64: Field = Field{bytes: 8, pieces: ?P64[0], count: 1};

val N0_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?N0}};
val B16_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B16}};
val B32_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B32}};
val B64_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B64}};

val WRAP: Range = Range{check: field.Check.wrap{}, bits: 0, align: 1};
val W64:  Range = Range{check: field.Check.wrap{}, bits: 64, align: 1};
val U16:  Range = Range{check: field.Check.unsigned{}, bits: 16, align: 1};
val S16:  Range = Range{check: field.Check.signed{}, bits: 16, align: 1};
val E16:  Range = Range{check: field.Check.either{}, bits: 16, align: 1};
val U32:  Range = Range{check: field.Check.unsigned{}, bits: 32, align: 1};
val S32:  Range = Range{check: field.Check.signed{}, bits: 32, align: 1};

# the record a span-dependent one names as the holder of its number
val AMD64_PAIR_KEYS: [1]u32   = [1]u32{0x0f};
val SPAN_PAIR:       PairRule = PairRule{link: Link.next{}, keys: ?AMD64_PAIR_KEYS[0], count: 1, role: Role.addend{}};
val SPAN_ADDEND:     Addend   = Addend.partner{Keys{keys: ?AMD64_PAIR_KEYS[0], count: 1}};

val AMD64_COUNT: usize            = 17;
val AMD64_ROWS:  [AMD64_COUNT]Row = [AMD64_COUNT]Row{
    Row{key: 0x00, name: "IMAGE_REL_AMD64_ABSOLUTE", kind: ?reloc.NONE, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.none{}},
    Row{key: 0x01, name: "IMAGE_REL_AMD64_ADDR64", kind: ?reloc.ABS64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.ABS, range: W64, addend: Addend.field{}},
    Row{key: 0x02, name: "IMAGE_REL_AMD64_ADDR32", kind: ?reloc.ABS32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.ABS, range: U32, addend: Addend.field{}},
    Row{key: 0x03, name: "IMAGE_REL_AMD64_ADDR32NB", kind: ?coff_kinds.IMAGE32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.IMAGE, range: U32, addend: Addend.field{}},
    Row{key: 0x04, name: "IMAGE_REL_AMD64_REL32", kind: ?reloc.PC32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: -4},
    Row{key: 0x05, name: "IMAGE_REL_AMD64_REL32_1", kind: ?coff_kinds.REL32_1, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: -5},
    Row{key: 0x06, name: "IMAGE_REL_AMD64_REL32_2", kind: ?coff_kinds.REL32_2, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: -6},
    Row{key: 0x07, name: "IMAGE_REL_AMD64_REL32_3", kind: ?coff_kinds.REL32_3, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: -7},
    Row{key: 0x08, name: "IMAGE_REL_AMD64_REL32_4", kind: ?coff_kinds.REL32_4, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: -8},
    Row{key: 0x09, name: "IMAGE_REL_AMD64_REL32_5", kind: ?coff_kinds.REL32_5, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: -9},
    Row{key: 0x0a, name: "IMAGE_REL_AMD64_SECTION", kind: ?coff_kinds.SECTION16, fields: ?B16_FIELD[0], field_count: 1, value: ?compute.OUT_SECTION, range: U16, addend: Addend.field{}},
    Row{key: 0x0b, name: "IMAGE_REL_AMD64_SECREL", kind: ?coff_kinds.SECREL32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.SECREL, range: U32, addend: Addend.field{}},
    Row{key: 0x0c, name: "IMAGE_REL_AMD64_SECREL7", kind: ?coff_kinds.SECREL7, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.UNDEFINED, range: WRAP, addend: Addend.none{}},
    Row{key: 0x0d, name: "IMAGE_REL_AMD64_TOKEN", kind: ?coff_kinds.TOKEN, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U32, addend: Addend.none{}},
    Row{key: 0x0e, name: "IMAGE_REL_AMD64_SREL32", kind: ?coff_kinds.SREL32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.UNDEFINED, range: S32, addend: SPAN_ADDEND, pair: opt[PairRule].some{SPAN_PAIR}},
    Row{key: 0x0f, name: "IMAGE_REL_AMD64_PAIR", kind: ?coff_kinds.PAIR, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.record{}},
    Row{key: 0x10, name: "IMAGE_REL_AMD64_SSPAN32", kind: ?coff_kinds.SSPAN32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.UNDEFINED, range: S32, addend: SPAN_ADDEND, pair: opt[PairRule].some{SPAN_PAIR}},
};

val AMD64_KINDS: [AMD64_COUNT]*Kind = [AMD64_COUNT]*Kind{
    ?reloc.NONE, ?reloc.ABS64, ?reloc.ABS32, ?coff_kinds.IMAGE32, ?reloc.PC32, ?coff_kinds.REL32_1, ?coff_kinds.REL32_2, ?coff_kinds.REL32_3, ?coff_kinds.REL32_4,
    ?coff_kinds.REL32_5, ?coff_kinds.SECTION16, ?coff_kinds.SECREL32, ?coff_kinds.SECREL7, ?coff_kinds.TOKEN, ?coff_kinds.SREL32, ?coff_kinds.PAIR, ?coff_kinds.SSPAN32,
};

# the rows of the COFF and x86-64 pair
pub val AMD64: Set = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?AMD64_ROWS[0], count: AMD64_COUNT, kinds: ?AMD64_KINDS[0], kind_count: AMD64_COUNT};

val I386_COUNT: usize           = 11;
val I386_ROWS:  [I386_COUNT]Row = [I386_COUNT]Row{
    Row{key: 0x00, name: "IMAGE_REL_I386_ABSOLUTE", kind: ?reloc.NONE, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.none{}},
    Row{key: 0x01, name: "IMAGE_REL_I386_DIR16", kind: ?reloc.ABS16, fields: ?B16_FIELD[0], field_count: 1, value: ?compute.ABS, range: E16, addend: Addend.field{}},
    Row{key: 0x02, name: "IMAGE_REL_I386_REL16", kind: ?reloc.PC16, fields: ?B16_FIELD[0], field_count: 1, value: ?compute.PC, range: S16, addend: Addend.field{}, bias: -2},
    Row{key: 0x06, name: "IMAGE_REL_I386_DIR32", kind: ?reloc.ABS32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.ABS, range: U32, addend: Addend.field{}},
    Row{key: 0x07, name: "IMAGE_REL_I386_DIR32NB", kind: ?coff_kinds.IMAGE32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.IMAGE, range: U32, addend: Addend.field{}},
    Row{key: 0x09, name: "IMAGE_REL_I386_SEG12", kind: ?coff_kinds.SEG12, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.UNDEFINED, range: WRAP, addend: Addend.none{}},
    Row{key: 0x0a, name: "IMAGE_REL_I386_SECTION", kind: ?coff_kinds.SECTION16, fields: ?B16_FIELD[0], field_count: 1, value: ?compute.OUT_SECTION, range: U16, addend: Addend.field{}},
    Row{key: 0x0b, name: "IMAGE_REL_I386_SECREL", kind: ?coff_kinds.SECREL32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.SECREL, range: U32, addend: Addend.field{}},
    Row{key: 0x0c, name: "IMAGE_REL_I386_TOKEN", kind: ?coff_kinds.TOKEN, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U32, addend: Addend.none{}},
    Row{key: 0x0d, name: "IMAGE_REL_I386_SECREL7", kind: ?coff_kinds.SECREL7, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.UNDEFINED, range: WRAP, addend: Addend.none{}},
    Row{key: 0x14, name: "IMAGE_REL_I386_REL32", kind: ?reloc.PC32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: -4},
};

val I386_KINDS: [I386_COUNT]*Kind = [I386_COUNT]*Kind{
    ?reloc.NONE, ?reloc.ABS16, ?reloc.PC16, ?reloc.ABS32, ?coff_kinds.IMAGE32, ?coff_kinds.SEG12, ?coff_kinds.SECTION16, ?coff_kinds.SECREL32, ?coff_kinds.TOKEN,
    ?coff_kinds.SECREL7, ?reloc.PC32,
};

# the rows of the COFF and x86 pair
pub val I386: Set = Set{format: ?format.COFF, arch: ?x86.X86, rows: ?I386_ROWS[0], count: I386_COUNT, kinds: ?I386_KINDS[0], kind_count: I386_COUNT};

# the instruction fields of the ARM64 rows, bit ranges of a 32-bit little
# endian word
val P_BRANCH26: [1]Piece = [1]Piece{Piece{at: 0, width: 26}};
val P_BRANCH19: [1]Piece = [1]Piece{Piece{at: 5, width: 19}};
val P_BRANCH14: [1]Piece = [1]Piece{Piece{at: 5, width: 14}};
val P_ADR:      [2]Piece = [2]Piece{Piece{at: 29, width: 2}, Piece{at: 5, width: 19}};
val P_IMM12:    [1]Piece = [1]Piece{Piece{at: 10, width: 12}};

val F_BRANCH26: Field = Field{bytes: 4, pieces: ?P_BRANCH26[0], count: 1, shift: 2, insn: true};
val F_BRANCH19: Field = Field{bytes: 4, pieces: ?P_BRANCH19[0], count: 1, shift: 2, insn: true};
val F_BRANCH14: Field = Field{bytes: 4, pieces: ?P_BRANCH14[0], count: 1, shift: 2, insn: true};
val F_ADR:      Field = Field{bytes: 4, pieces: ?P_ADR[0], count: 2, insn: true};
val F_ADRP:     Field = Field{bytes: 4, pieces: ?P_ADR[0], count: 2, shift: 12, insn: true};
val F_IMM12:    Field = Field{bytes: 4, pieces: ?P_IMM12[0], count: 1, insn: true};
val F_IMM12_HI: Field = Field{bytes: 4, pieces: ?P_IMM12[0], count: 1, shift: 12, insn: true};
val F_LDST1:    Field = Field{bytes: 4, pieces: ?P_IMM12[0], count: 1, insn: true};
val F_LDST2:    Field = Field{bytes: 4, pieces: ?P_IMM12[0], count: 1, shift: 1, insn: true};
val F_LDST4:    Field = Field{bytes: 4, pieces: ?P_IMM12[0], count: 1, shift: 2, insn: true};
val F_LDST8:    Field = Field{bytes: 4, pieces: ?P_IMM12[0], count: 1, shift: 3, insn: true};
val F_LDST16:   Field = Field{bytes: 4, pieces: ?P_IMM12[0], count: 1, shift: 4, insn: true};

val C_BRANCH26: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_BRANCH26}};
val C_BRANCH19: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_BRANCH19}};
val C_BRANCH14: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_BRANCH14}};
val C_ADR:      [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_ADR}};
val C_ADRP:     [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_ADRP}};
val C_IMM12:    [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_IMM12}};
val C_IMM12_HI: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_IMM12_HI}};

# a load or store of an unsigned offset scales it by its access size: the size
# bits 31:30 for a general register, and for a SIMD register (bit 26) the same
# unless opc bit 23 marks a 128-bit access of size zero. any other SIMD form
# of opc bit 23 is unallocated, so no choice holds for it
val SIZE_V:     u64                     = 0xc400_0000;
val SIZE_V_OPC: u64                     = 0xc480_0000;
val LDST_COUNT: usize                   = 9;
val LDST:       [LDST_COUNT]FieldChoice = [LDST_COUNT]FieldChoice{
    FieldChoice{insn_mask: SIZE_V, insn_value: 0x0000_0000, field: ?F_LDST1, align: 1},
    FieldChoice{insn_mask: SIZE_V, insn_value: 0x4000_0000, field: ?F_LDST2, align: 2},
    FieldChoice{insn_mask: SIZE_V, insn_value: 0x8000_0000, field: ?F_LDST4, align: 4},
    FieldChoice{insn_mask: SIZE_V, insn_value: 0xc000_0000, field: ?F_LDST8, align: 8},
    FieldChoice{insn_mask: SIZE_V_OPC, insn_value: 0x0400_0000, field: ?F_LDST1, align: 1},
    FieldChoice{insn_mask: SIZE_V_OPC, insn_value: 0x4400_0000, field: ?F_LDST2, align: 2},
    FieldChoice{insn_mask: SIZE_V_OPC, insn_value: 0x8400_0000, field: ?F_LDST4, align: 4},
    FieldChoice{insn_mask: SIZE_V_OPC, insn_value: 0xc400_0000, field: ?F_LDST8, align: 8},
    FieldChoice{insn_mask: SIZE_V_OPC, insn_value: 0x0480_0000, field: ?F_LDST16, align: 16},
};

val LOW12:  Range = Range{check: field.Check.wrap{}, bits: 12, align: 1};
val HIGH12: Range = Range{check: field.Check.wrap{}, bits: 24, align: 1};
val S28:    Range = Range{check: field.Check.signed{}, bits: 28, align: 4};
val S21_4:  Range = Range{check: field.Check.signed{}, bits: 21, align: 4};
val S16_4:  Range = Range{check: field.Check.signed{}, bits: 16, align: 4};
val S21:    Range = Range{check: field.Check.signed{}, bits: 21, align: 1};
val S33:    Range = Range{check: field.Check.signed{}, bits: 33, align: 0x1000};

val ARM64_COUNT: usize            = 18;
val ARM64_ROWS:  [ARM64_COUNT]Row = [ARM64_COUNT]Row{
    Row{key: 0x00, name: "IMAGE_REL_ARM64_ABSOLUTE", kind: ?reloc.NONE, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.none{}},
    Row{key: 0x01, name: "IMAGE_REL_ARM64_ADDR32", kind: ?reloc.ABS32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.ABS, range: U32, addend: Addend.field{}},
    Row{key: 0x02, name: "IMAGE_REL_ARM64_ADDR32NB", kind: ?coff_kinds.IMAGE32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.IMAGE, range: U32, addend: Addend.field{}},
    Row{key: 0x03, name: "IMAGE_REL_ARM64_BRANCH26", kind: ?coff_kinds.BRANCH26, fields: ?C_BRANCH26[0], field_count: 1, value: ?compute.PC, range: S28, addend: Addend.field{}},
    Row{key: 0x04, name: "IMAGE_REL_ARM64_PAGEBASE_REL21", kind: ?coff_kinds.PAGEBASE_REL21, fields: ?C_ADRP[0], field_count: 1, value: ?compute.PAGE, range: S33, addend: Addend.held{?F_ADR}},
    Row{key: 0x05, name: "IMAGE_REL_ARM64_REL21", kind: ?coff_kinds.REL21, fields: ?C_ADR[0], field_count: 1, value: ?compute.PC, range: S21, addend: Addend.field{}},
    Row{key: 0x06, name: "IMAGE_REL_ARM64_PAGEOFFSET_12A", kind: ?coff_kinds.PAGEOFFSET_12A, fields: ?C_IMM12[0], field_count: 1, value: ?compute.ABS, range: LOW12, addend: Addend.field{}},
    Row{key: 0x07, name: "IMAGE_REL_ARM64_PAGEOFFSET_12L", kind: ?coff_kinds.PAGEOFFSET_12L, fields: ?LDST[0], field_count: LDST_COUNT, value: ?compute.ABS, range: LOW12, addend: Addend.field{}},
    Row{key: 0x08, name: "IMAGE_REL_ARM64_SECREL", kind: ?coff_kinds.SECREL32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.SECREL, range: U32, addend: Addend.field{}},
    Row{key: 0x09, name: "IMAGE_REL_ARM64_SECREL_LOW12A", kind: ?coff_kinds.SECREL_LOW12A, fields: ?C_IMM12[0], field_count: 1, value: ?compute.SECREL, range: LOW12, addend: Addend.field{}},
    Row{key: 0x0a, name: "IMAGE_REL_ARM64_SECREL_HIGH12A", kind: ?coff_kinds.SECREL_HIGH12A, fields: ?C_IMM12_HI[0], field_count: 1, value: ?compute.SECREL, range: HIGH12, addend: Addend.field{}},
    Row{key: 0x0b, name: "IMAGE_REL_ARM64_SECREL_LOW12L", kind: ?coff_kinds.SECREL_LOW12L, fields: ?LDST[0], field_count: LDST_COUNT, value: ?compute.SECREL, range: LOW12, addend: Addend.field{}},
    Row{key: 0x0c, name: "IMAGE_REL_ARM64_TOKEN", kind: ?coff_kinds.TOKEN, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U32, addend: Addend.none{}},
    Row{key: 0x0d, name: "IMAGE_REL_ARM64_SECTION", kind: ?coff_kinds.SECTION16, fields: ?B16_FIELD[0], field_count: 1, value: ?compute.OUT_SECTION, range: U16, addend: Addend.field{}},
    Row{key: 0x0e, name: "IMAGE_REL_ARM64_ADDR64", kind: ?reloc.ABS64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.ABS, range: W64, addend: Addend.field{}},
    Row{key: 0x0f, name: "IMAGE_REL_ARM64_BRANCH19", kind: ?coff_kinds.BRANCH19, fields: ?C_BRANCH19[0], field_count: 1, value: ?compute.PC, range: S21_4, addend: Addend.field{}},
    Row{key: 0x10, name: "IMAGE_REL_ARM64_BRANCH14", kind: ?coff_kinds.BRANCH14, fields: ?C_BRANCH14[0], field_count: 1, value: ?compute.PC, range: S16_4, addend: Addend.field{}},
    Row{key: 0x11, name: "IMAGE_REL_ARM64_REL32", kind: ?reloc.PC32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: -4},
};

val ARM64_KINDS: [ARM64_COUNT]*Kind = [ARM64_COUNT]*Kind{
    ?reloc.NONE, ?reloc.ABS32, ?coff_kinds.IMAGE32, ?coff_kinds.BRANCH26, ?coff_kinds.PAGEBASE_REL21, ?coff_kinds.REL21, ?coff_kinds.PAGEOFFSET_12A, ?coff_kinds.PAGEOFFSET_12L,
    ?coff_kinds.SECREL32, ?coff_kinds.SECREL_LOW12A, ?coff_kinds.SECREL_HIGH12A, ?coff_kinds.SECREL_LOW12L, ?coff_kinds.TOKEN, ?coff_kinds.SECTION16, ?reloc.ABS64, ?coff_kinds.BRANCH19,
    ?coff_kinds.BRANCH14, ?reloc.PC32,
};

# the rows of the COFF and arm64 pair
pub val ARM64: Set = Set{format: ?format.COFF, arch: ?aarch64.AARCH64, rows: ?ARM64_ROWS[0], count: ARM64_COUNT, kinds: ?ARM64_KINDS[0], kind_count: ARM64_COUNT};

# the rows of the COFF and ARM64EC pair, the arm64 rows by reference
pub val ARM64EC: Set = Set{format: ?format.COFF, arch: ?aarch64.ARM64EC, rows: ?ARM64_ROWS[0], count: ARM64_COUNT, kinds: ?ARM64_KINDS[0], kind_count: ARM64_COUNT};

# whether `s` holds a row for every type the vendored list names for its
# machine, of that type's name and number in the list's order
fun walks(s: *Set) bool {
    val code: opt[*Code] = arch.code(s.arch, ?format.COFF);
    if (sel code.none) { ret false; }
    val machine: opt[*tables.MachineRow] = tables.machine(code.some.fields[0].value);
    if (sel machine.none) { ret false; }
    val listed: opt[*tables.Set] = machine.some.rel;
    if (sel listed.none)              { ret false; }
    if (listed.some.count != s.count) { ret false; }
    var i: usize = 0;
    for (i < s.count) {
        val c: *tables.Constant = listed.some.rows[i];
        if (!str_equals(c.name, s.rows[i].name) || c.value != s.rows[i].key::u64) { ret false; }
        i = i + 1;
    }
    ret true;
}

test rows__every_type_of_the_vendored_list_has_its_row_and_every_field_fits {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 5; }
    val sets: [4]*Set = [4]*Set{?AMD64, ?I386, ?ARM64, ?ARM64EC};
    var i:    usize   = 0;
    for (i < 4) {
        if (!walks(sets[i])) { ret 1; }
        i = i + 1;
    }
    if (ARM64EC.rows != ARM64.rows || ARM64EC.kinds != ARM64.kinds) { ret 2; }
    # indexing walks every row, so a field wider than its container or a
    # range it cannot hold is refused here
    val built: res[row.Registry, Fail] = row.make(T.allocator_of(?t), ?sets[0], 4);
    if (sel built.err) { ret 3; }
    var g: row.Registry = built.ok;
    val r: err[Fail]    = row.release(?g);
    if (sel r.err)             { ret 4; }
    if (T.live_count(?t) != 0) { ret 4; }
    T.dnit(?t);
    ret 0;
}
