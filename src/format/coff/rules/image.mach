# an optional header layout and what an image of it states by its address
# width
# ---
# shape:           the layout
# characteristics: the file characteristics an image of it states
# randomized:      the DLL characteristics beyond dynamic base an image of it
#                  the loader may place anywhere states
# based:           the base relocation type of an address of its width
rec Width {
    shape:           *ImageShape;
    characteristics: u64;
    randomized:      u64;
    based:           *Constant;
}

# a 64-bit image is large address aware
val WIDTH_COUNT: usize              = 2;
val WIDTHS:      [WIDTH_COUNT]Width = [WIDTH_COUNT]Width{
    Width{shape: ?model.PE32, characteristics: tables.IMAGE_FILE_32BIT_MACHINE.value, randomized: 0, based: ?tables.IMAGE_REL_BASED_HIGHLOW},
    Width{
        shape:           ?model.PE32PLUS,
        characteristics: tables.IMAGE_FILE_LARGE_ADDRESS_AWARE.value,
        randomized:      tables.IMAGE_DLLCHARACTERISTICS_HIGH_ENTROPY_VA.value,
        based:           ?tables.IMAGE_REL_BASED_DIR64,
    },
};

# the MS-DOS header, and the program after it that says the image needs
# windows, as every PE linker writes them
val DOS_HEADER:       u64                  = 64;
val DOS_PROGRAM_SIZE: usize                = 56;
val DOS_PROGRAM:      [DOS_PROGRAM_SIZE]u8 = [DOS_PROGRAM_SIZE]u8{
    0x0e, 0x1f, 0xba, 0x0e, 0x00, 0xb4, 0x09, 0xcd, 0x21, 0xb8, 0x01, 0x4c, 0xcd, 0x21,
    'T', 'h', 'i', 's', ' ', 'p', 'r', 'o', 'g', 'r', 'a', 'm', ' ', 'c', 'a', 'n', 'n', 'o', 't', ' ',
    'b', 'e', ' ', 'r', 'u', 'n', ' ', 'i', 'n', ' ', 'D', 'O', 'S', ' ', 'm', 'o', 'd', 'e', '.', '$',
    0, 0,
};
val DOS_SIZE:      u64 = DOS_HEADER + DOS_PROGRAM_SIZE::u64;
val DOS_PAGE:      u64 = 512;
val DOS_PARAGRAPH: u64 = 16;
# where the MS-DOS header states its relocations start
val DOS_RELOCATIONS: usize = 0x18;

# the PE signature, the file header and a section header
val SIGNATURE_SIZE: u64 = 4;
val FILE_HEADER:    u64 = 20;

# the data directories every PE linker writes, the last of them reserved
val DIRECTORIES: usize = 16;

# a base relocation block covers a page of 4 KiB, whatever the system's page
val BLOCK_PAGE: u64 = 0x1000;
val BLOCK_TYPE: u64 = 12;

# the image base is a multiple of 64 KiB
val BASE_ALIGN: u64 = 0x10000;

# what the image states where nothing else does: the linker version, the
# windows version an image runs on, and the stack and heap reserved and
# committed
val LINKER_MAJOR:  u8      = 14;
val LINKER_MINOR:  u8      = 0;
val SYSTEM:        Version = Version{major: 6, minor: 0};
val STACK_RESERVE: u64     = 0x10_0000;
val STACK_COMMIT:  u64     = 0x1000;
val HEAP_RESERVE:  u64     = 0x10_0000;
val HEAP_COMMIT:   u64     = 0x1000;

# the DLL characteristics every image states, and those an image that starts
# at an entry, an application, states besides
val EVERY_IMAGE: u64 = tables.IMAGE_DLLCHARACTERISTICS_NX_COMPAT.value;
val APPLICATION: u64 = tables.IMAGE_DLLCHARACTERISTICS_TERMINAL_SERVER_AWARE.value;

# the export table's section, and the alignment of its tables of words
val EDATA:        str = ".edata";
val EXPORT_ALIGN: u64 = 4;

# the base relocation section: its name, the alignment of its blocks, and its
# characteristics, discardable, as only the loader reads it while it maps
# the image
val RELOC_NAME:            str = ".reloc";
val BLOCK_ALIGN:           u64 = 4;
val RELOC_CHARACTERISTICS: u64 = tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_DISCARDABLE.value | tables.IMAGE_SCN_MEM_READ.value;

# the kinds the image writer builds: the executables, and the DLL. the link
# refuses a fixed kind on a host whose loader places every image where it
# chooses
val KIND_COUNT: usize             = 4;
val KINDS:      [KIND_COUNT]*Kind = [KIND_COUNT]*Kind{?output.STATIC, ?output.DYNAMIC, ?output.PIE, ?output.SHARED};

# the executables, which alone hold thread-local data yet
val EXECUTABLE_COUNT: usize                   = 3;
val EXECUTABLES:      [EXECUTABLE_COUNT]*Kind = [EXECUTABLE_COUNT]*Kind{?output.STATIC, ?output.DYNAMIC, ?output.PIE};

# the PE image writer, whose interface file is a DLL's import library
pub val WRITER: Writer = Writer{kinds: ?KINDS[0], kind_count: KIND_COUNT, compresses: false, offsets: false, sizing: Sizing.refused{}, write: write, interface: opt[Interfacer].some{import_library}};

# the bytes the base relocations take, which follow the pages their sites lie
# on once the image is laid out
pub val BASE_RELOCATIONS: reserve.Measure = reserve.Measure{name: "base relocations"};

# the import tables an image lays in .idata ahead of its import address
# table: the descriptors, the import lookup table, the hint/name table and
# the DLL names, measured from the imports
pub val IMPORT_TABLES: reserve.Measure = reserve.Measure{name: "import tables"};

# the resource tree of an image whose inputs carry resources, measured from
# them
pub val RESOURCES: reserve.Measure = reserve.Measure{name: "resource tree"};

# the export table of a DLL whose inputs state exports, measured from them
pub val EXPORT_TABLE: reserve.Measure = reserve.Measure{name: "export table"};

# the TLS directory of an image that supplies its own: the template's start
# and end, the address of the index cell, the address of the callback array,
# the zero fill and the characteristics, each address as wide as the image's
pub val TLS_DIRECTORY: reserve.Measure = reserve.Measure{name: "TLS directory"};

# the index cell of an image that supplies its own TLS directory, where the
# loader writes the image's index among the thread-local blocks
pub val TLS_INDEX: Anchor = Anchor{name: "TLS index"};

# the names a CRT supplies the TLS directory, the index cell and the bounds
# of the callback array by, which the link defines when no input does
val TLS_USED:  str = "_tls_used";
val TLS_CELL:  str = "_tls_index";
val TLS_FIRST: str = "__xl_a";
val TLS_LAST:  str = "__xl_z";

# the start of the name of every section of the callback array, and the
# sections of its bounds
val TLS_CALLBACKS:     str = ".CRT$XL";
val TLS_FIRST_SECTION: str = ".CRT$XLA";
val TLS_LAST_SECTION:  str = ".CRT$XLZ";

# the index cell is a 32-bit word
val TLS_CELL_SIZE: u64 = 4;

# the null pointer each bound of the callback array holds
val NULL_POINTER_SIZE: usize                 = 8;
val NULL_POINTER:      [NULL_POINTER_SIZE]u8 = [NULL_POINTER_SIZE]u8{0, 0, 0, 0, 0, 0, 0, 0};

# the TLS directory's addresses, and the bytes of its fields after them: the
# zero fill and the characteristics
val TLS_ADDRESSES: u64 = 4;
val TLS_TAIL:      u64 = 8;

# the names the PE link defines at places of its layout: _tls_index in the
# index cell the image reserves, and for an ARM64EC image the metadata, the
# load configuration it lays where no input supplies one and the helper
# cells
val BOUND_COUNT: usize              = 20;
val BOUND_ROWS:  [BOUND_COUNT]Bound = [BOUND_COUNT]Bound{
    Bound{name: TLS_CELL, place: boundary.Place.cell{boundary.Cell{anchor: ?TLS_INDEX, offset: 0}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.CHPE_METADATA, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.METADATA, offset: 0}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.LOAD_CONFIG_USED, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.LOAD_CONFIG, offset: 0}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.CALL_NO_REDIRECT, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 0}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.DISPATCH_RET, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 8}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.CHECK_CALL, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 16}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.CHECK_ICALL, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 24}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.CHECK_ICALL_CFG, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 32}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.GET_X64_INFORMATION, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 40}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.SET_X64_INFORMATION, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 48}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.DISPATCH_FPTR, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 56}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER0, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 64}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER1, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 72}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER2, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 80}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER3, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 88}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER4, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 96}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER5, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 104}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER6, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 112}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER7, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 120}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
    Bound{name: coff_hybrid.HELPER8, place: boundary.Place.cell{boundary.Cell{anchor: ?coff_hybrid.CELLS, offset: 128}}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.DATA},
};
pub val BOUNDS: boundary.Bounds = boundary.Bounds{rows: ?BOUND_ROWS[0], count: BOUND_COUNT};

# the bounds of the callback array of an image that supplies its own TLS
# directory, made once collection has run
pub val CALLBACK_BOUNDS: synthesizer.Row = synthesizer.Row{
    name:       "thread-local callback bounds",
    stage:      ?synthesizer.AFTER_COLLECT,
    needs:      arch.ADDRESSED,
    kinds:      ?EXECUTABLES[0],
    kind_count: EXECUTABLE_COUNT,
    make:       callback_bounds,
};

# the PE tables the linker makes: the base relocations, the import tables,
# the TLS directory and index cell, the resource tree and the export table
pub val TABLES: Declarer = Declarer{declare: declare};

val MEASURE_COUNT: usize                   = 8;
val MEASURES_ROWS: [MEASURE_COUNT]Measured = [MEASURE_COUNT]Measured{
    Measured{key: ?reserve.HEADERS, measure: headers},
    Measured{key: ?BASE_RELOCATIONS, measure: base_relocations},
    Measured{key: ?IMPORT_TABLES, measure: import_tables},
    Measured{key: ?TLS_DIRECTORY, measure: tls_directory},
    Measured{key: ?RESOURCES, measure: resource_tree},
    Measured{key: ?EXPORT_TABLE, measure: export_table},
    Measured{key: ?coff_hybrid.TABLES, measure: coff_hybrid.measure_tables},
    Measured{key: ?coff_hybrid.FAST_FORWARDS, measure: coff_hybrid.measure_forwards},
};
pub val MEASURES: Measures = Measures{rows: ?MEASURES_ROWS[0], count: MEASURE_COUNT};

# the optional header layout of an image for `a`, the one as wide as its
# addresses
fun width_of(a: *Arch) res[*Width, Fail] {
    val bytes: opt[u8] = arch.pointer_bytes(a);
    if (sel bytes.none) { ret res[*Width, Fail].err{fail.about(fail.unsupported("the architecture states no address width"), a.name)}; }
    var i: usize = 0;
    for (i < WIDTH_COUNT) {
        if (WIDTHS[i].shape.addr == bytes.some::usize) { ret res[*Width, Fail].ok{?WIDTHS[i]}; }
        i = i + 1;
    }
    ret res[*Width, Fail].err{fail.about(fail.unsupported("PE has no image layout as wide as the architecture's addresses"), a.name)};
}

# whether the loader may place an image of kind `k` anywhere, so it holds
# base relocations
fun relocatable(k: *Kind) bool {
    ret output.has(k, output.PIC);
}

# whether output section `m` is a section of the image: loaded, and holding a
# byte
fun kept(m: *Merged) bool {
    ret sel m.segment.some && m.size != 0;
}

# how many sections the laid out `l` holds: its kept output sections
fun section_count(l: *Layout) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < table.count[Id[Merged]](?l.order)) {
        if (kept(table.at[Merged](?l.merged, table.items[Id[Merged]](?l.order)[i]))) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the bytes the headers of an image of layout `w` with `count` sections take:
# the MS-DOS header and program, the PE signature, the file header, the
# optional header with its data directories and the section table
fun header_size(w: *Width, count: usize) res[u64, Fail] {
    val at:    Location       = Location{record: "headers"};
    val table: res[u64, Fail] = checked.mul(at, count::u64, model.SECTION_SIZE);
    if (sel table.err) { ret table; }
    val fixed: u64 = DOS_SIZE + SIGNATURE_SIZE + FILE_HEADER + optional_size(w);
    ret checked.add(at, fixed, table.ok);
}

fun optional_size(w: *Width) u64 {
    ret w.shape.size::u64 + DIRECTORIES::u64 * model.DIRECTORY_SIZE;
}

# the headers of the laid out image `img`
fun headers(img: *Image) res[u64, Fail] {
    val w: res[*Width, Fail] = width_of(img.target.arch);
    if (sel w.err) { ret res[u64, Fail].err{w.err}; }
    ret header_size(w.ok, section_count(img.layout));
}

# the image being built
# ---
# img:        the image record
# width:      its optional header layout
# m:          the model
# base:       the image base
# file:       the file alignment
# align:      the section alignment
# size:       the bytes the headers take
# end:        the end of the last section in memory, an address
# tail:       the end of the last section's bytes in the file
# machine:    the architecture's COFF machine
# reloc:      the output section of .reloc, none in an image at a fixed address
# dir:        the base relocation directory
# exceptions: the exception directory, zero where the image holds no
#             function table
# imports:    the import directory, zero where the image imports nothing
# iat:        the import address table directory, zero where the image
#             imports nothing
# tls:        the TLS directory, zero where the image holds no thread-local
#             data
# resources:  the resource directory, zero where the image holds no
#             resources
# exports:    the export directory, zero where the image exports nothing
# load:       the load configuration directory, zero where the image states
#             none
# tiles:      where each piece the writer lays in place of an output
#             section's bytes lies, by output section and offset
# pieces:     those pieces, until a section takes them
rec Build {
    a:          *A.Allocator;
    img:        *Image;
    width:      *Width;
    machine:    u16;
    m:          Coff;
    base:       u64;
    file:       u64;
    align:      u64;
    size:       u64;
    end:        u64;
    tail:       u64;
    reloc:      opt[Id[Merged]];
    dir:        DataDirectory;
    exceptions: DataDirectory;
    imports:    DataDirectory;
    iat:        DataDirectory;
    tls:        DataDirectory;
    resources:  DataDirectory;
    exports:    DataDirectory;
    load:       DataDirectory;
    tiles:      Table[Tile];
    pieces:     Table[Piece];
}

# a piece the writer lays in an output section in place of its bytes
# ---
# merged: the output section
# offset: where in it the piece starts
# size:   the bytes it takes
# piece:  its index among the pieces
rec Tile {
    merged: Id[Merged];
    offset: u64;
    size:   u64;
    piece:  u32;
}

# write the image `img` as a PE executable
fun write(a: *A.Allocator, img: *Image) res[Sink, Fail] {
    val w: res[*Width, Fail] = width_of(img.target.arch);
    if (sel w.err) { ret res[Sink, Fail].err{w.err}; }
    var b: Build = Build{
        a:      a,
        img:    img,
        width:  w.ok,
        m:      model.make(a, Shape{object: ?model.REGULAR, image: opt[*ImageShape].some{w.ok.shape}}),
        base:   img.layout.base,
        file:   coff_convention.LAYOUT.file_align,
        align:  coff_convention.LAYOUT.section_align,
        tiles:  table.make[Tile](a),
        pieces: table.make[Piece](a),
    };
    b.m.optional = Optional.image{model.make_image(a)};
    var out: res[Sink, Fail] = res[Sink, Fail].err{fail.internal("the image was not written")};
    val r:   err[Fail]       = build(?b);
    if (sel r.err) { out = res[Sink, Fail].err{r.err}; }
    or             { out = coff_write.write(a, ?b.m); }
    var rel: err[Fail] = model.release(?b.m);
    rel = fail.kept(rel, model.release_pieces(?b.pieces));
    rel = fail.kept(rel, table.release[Tile](?b.tiles));
    if (sel out.err) { ret out; }
    if (sel rel.err) {
        var got: Sink      = out.ok;
        val d:   err[Fail] = sink.release(?got);
        ret res[Sink, Fail].err{rel.err};
    }
    ret out;
}

fun build(b: *Build) err[Fail] {
    val n: err[Fail] = needs(b.img);
    if (sel n.err)                { ret n; }
    if (b.base % BASE_ALIGN != 0) { ret err[Fail].err{fail.valued(fail.about(fail.malformed("the image base is not a multiple of 64 KiB"), b.img.host.sys.name), b.base::i128)}; }
    val hs: res[u64, Fail] = header_size(b.width, section_count(b.img.layout));
    if (sel hs.err)                   { ret err[Fail].err{hs.err}; }
    if (hs.ok != b.img.layout.header) { ret err[Fail].err{fail.internal("the headers are not the size layout left for them")}; }
    b.size = hs.ok;
    val rl: res[opt[Id[Merged]], Fail] = reloc_of(b.img);
    if (sel rl.err) { ret err[Fail].err{rl.err}; }
    b.reloc = rl.ok;
    val mc: res[u16, Fail] = machine_of(b.img.target.arch);
    if (sel mc.err) { ret err[Fail].err{mc.err}; }
    b.machine = mc.ok;
    val im: err[Fail] = imports_out(b);
    if (sel im.err) { ret im; }
    val th: err[Fail] = tls_out(b);
    if (sel th.err) { ret th; }
    val rs: err[Fail] = resources_out(b);
    if (sel rs.err) { ret rs; }
    val ex: err[Fail] = exports_out(b);
    if (sel ex.err) { ret ex; }
    val hy: err[Fail] = hybrid_out(b);
    if (sel hy.err) { ret hy; }
    val lc: err[Fail] = load_config_out(b);
    if (sel lc.err) { ret lc; }
    sort.sort_by[Tile](table.items[Tile](?b.tiles), table.count[Tile](?b.tiles), order_tile);
    val s: err[Fail] = sections_out(b);
    if (sel s.err) { ret s; }
    val h: err[Fail] = header_out(b);
    if (sel h.err) { ret h; }
    val o: err[Fail] = optional_out(b);
    if (sel o.err) { ret o; }
    ret extents_out(b);
}

# refuse a link that needs what the image does not hold yet: a delay loaded
# import, a DLL it loads and imports nothing from or thread-local data in a
# DLL, and a DLL that refers to what nothing defines, which no loader binds
fun needs(img: *Image) err[Fail] {
    val d:       *Dynamic      = img.dynamic;
    val delayed: *Table[Entry] = dynamic.entries_of(d, ?slot.DELAY_IAT);
    if (table.count[Entry](delayed) != 0) {
        val aim: dynamic.Aim = table.at[Entry](delayed, table.nth[Entry](0)).aim;
        val no:  Fail        = fail.unsupported("a PE image does not delay load an import yet");
        if (sel aim.imported) { ret err[Fail].err{fail.in_indexed(no, "import", aim.imported.index::u64)}; }
        ret err[Fail].err{no};
    }
    var i: usize = 0;
    for (i < table.count[dynamic.Library](?d.libraries)) {
        val l: *dynamic.Library = table.at[dynamic.Library](?d.libraries, table.nth[dynamic.Library](i));
        if (l.loaded && sel l.rank.none) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a PE image loads no DLL it imports nothing from"), "library", i::u64)}; }
        i = i + 1;
    }
    val tls: opt[layout.Tls] = img.layout.tls;
    if (sel tls.some && output.has(img.kind, output.LOADED)) { ret err[Fail].err{fail.unsupported("a DLL does not hold thread-local data yet")}; }
    if (table.count[resolve.Reference](?img.resolved.undefined) != 0) {
        val first: *resolve.Reference = table.at[resolve.Reference](?img.resolved.undefined, table.nth[resolve.Reference](0));
        ret err[Fail].err{fail.in_file(fail.malformed("a PE image refers to a symbol nothing defines, which no loader binds"), input.at(img.inputs, first.input).name)};
    }
    if (table.count[Site](?img.sites.list) != 0 && !relocatable(img.kind)) {
        ret err[Fail].err{fail.internal("an image at a fixed address holds relocations for a loader")};
    }
    ret err[Fail].ok{};
}

# the offset of `address` from the image base, which a 32-bit field holds
fun rva_of(b: *Build, address: u64, record: str, index: u64) res[u32, Fail] {
    if (address < b.base || address - b.base > 0xffff_ffff) {
        ret res[u32, Fail].err{fail.valued(fail.in_indexed(fail.overflow("an address lies outside the 4 GiB above the image base"), record, index), address::i128)};
    }
    ret res[u32, Fail].ok{(address - b.base)::u32};
}

fun narrow(v: u64, record: str, index: u64) res[u32, Fail] {
    if (v > 0xffff_ffff) { ret res[u32, Fail].err{fail.valued(fail.in_indexed(fail.overflow("a section passes the 4 GiB its header counts"), record, index), v::i128)}; }
    ret res[u32, Fail].ok{v::u32};
}

# push section `s` into the model, releasing it when the model cannot hold it
fun push(b: *Build, s: model.Section) err[Fail] {
    var h: model.Section                = s;
    val r: res[Id[model.Section], Fail] = table.push[model.Section](?b.m.sections, h);
    if (sel r.err) {
        val relocs: err[Fail] = table.release[model.Reloc](?h.relocs);
        val lines:  err[Fail] = table.release[model.Line](?h.lines);
        if (sel h.body.tiled) {
            val tiles: err[Fail] = model.release_pieces(?h.body.tiled);
        }
        ret err[Fail].err{r.err};
    }
    ret err[Fail].ok{};
}

# a section for every kept output section, in image order
fun sections_out(b: *Build) err[Fail] {
    val l:    *Layout        = b.img.layout;
    val at:   Location       = Location{record: "headers"};
    val tail: res[u64, Fail] = checked.align_up(at, b.size, b.file);
    if (sel tail.err) { ret err[Fail].err{tail.err}; }
    val end: res[u64, Fail] = checked.align_up(at, b.base + b.size, b.align);
    if (sel end.err) { ret err[Fail].err{end.err}; }
    b.tail = tail.ok;
    b.end  = end.ok;
    var i: usize = 0;
    for (i < table.count[Id[Merged]](?l.order)) {
        val id: Id[Merged] = table.items[Id[Merged]](?l.order)[i];
        val m:  *Merged    = table.at[Merged](?l.merged, id);
        if (kept(m)) {
            val r: err[Fail] = section_out(b, id, m);
            if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "output section", i::u64)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun section_out(b: *Build, id: Id[Merged], m: *Merged) err[Fail] {
    val v: View = intern.bytes_of(b.img.names, m.name);
    if (v.len > 8) { ret err[Fail].err{fail.unsupported("an image section's name is longer than eight bytes")}; }
    val rva: res[u32, Fail] = rva_of(b, m.address, "output section", m.position::u64);
    if (sel rva.err) { ret err[Fail].err{rva.err}; }
    val size: res[u32, Fail] = narrow(m.size, "output section", m.position::u64);
    if (sel size.err) { ret err[Fail].err{size.err}; }
    var s: model.Section = model.make_section(b.a);
    var k: usize         = 0;
    for (k < v.len) {
        s.name[k] = v.data[k];
        k         = k + 1;
    }
    s.virtual_size    = size.ok;
    s.virtual_address = rva.ok;
    s.flags           = coff_neutral.contents_of(section.key_of(m.kind, m.entsize), m.flags)::u32;
    val at: Location = Location{record: "output section", index: m.position::u64, indexed: true};
    if (section.has(m.kind, section.BITS)) {
        val raw: res[u64, Fail] = checked.align_up(at, m.size, b.file);
        if (sel raw.err) { ret err[Fail].err{raw.err}; }
        val rs: res[u32, Fail] = narrow(raw.ok, "output section", m.position::u64);
        if (sel rs.err) { ret err[Fail].err{rs.err}; }
        val rp: res[u32, Fail] = narrow(m.offset, "output section", m.position::u64);
        if (sel rp.err)        { ret err[Fail].err{rp.err}; }
        if (m.offset < b.tail) { ret err[Fail].err{fail.internal("an output section's bytes overlap what lies before them")}; }
        var body: res[Body, Fail] = res[Body, Fail].err{fail.internal("the section's bytes were not made")};
        if (holds_reloc(b, id)) {
            body    = reloc_body(b, m, raw.ok);
            s.flags = RELOC_CHARACTERISTICS::u32;
            b.dir   = DataDirectory{rva: rva.ok, size: size.ok};
        }
        or (tiled(b, id)) {
            body = tiled_body(b, id, m, raw.ok);
        }
        or (m.kind == ?section.FUNCTION_TABLE && coff_hybrid.joined(b.img.target.arch) && !coff_hybrid.x64_functions(b.img, m)) {
            body = exceptions_body(b, m, raw.ok, b.machine);
        }
        or (m.kind == ?section.FUNCTION_TABLE) {
            if (b.exceptions.size != 0) { ret err[Fail].err{fail.unsupported("an image holds function tables in two output sections")}; }
            val mc: res[u16, Fail] = header_machine(b.img.target.arch);
            if (sel mc.err) { ret err[Fail].err{mc.err}; }
            body         = exceptions_body(b, m, raw.ok, mc.ok);
            b.exceptions = DataDirectory{rva: rva.ok, size: size.ok};
        }
        or {
            body = file_bytes(b, m.offset, raw.ok);
        }
        if (sel body.err) { ret err[Fail].err{body.err}; }
        s.raw_size = rs.ok;
        s.raw_ptr  = rp.ok;
        s.body     = body.ok;
        b.tail     = m.offset + raw.ok;
    }
    val end: res[u64, Fail] = checked.add(at, m.address, m.size);
    if (sel end.err)    { ret err[Fail].err{end.err}; }
    if (end.ok > b.end) { b.end = end.ok; }
    ret push(b, s);
}

# whether output section `id` is .reloc
fun holds_reloc(b: *Build, id: Id[Merged]) bool {
    val r: opt[Id[Merged]] = b.reloc;
    ret sel r.some && r.some.index == id.index;
}

# the `n` bytes of the file at `offset`: the relocated bytes, borrowed, or a
# copy of them padded with zeros past their end
fun file_bytes(b: *Build, offset: u64, n: u64) res[Body, Fail] {
    val rel:   *Table[u8] = ?b.img.relocated.bytes;
    val count: u64        = table.count[u8](rel)::u64;
    if (offset > count) { ret res[Body, Fail].err{fail.internal("an output section lies past the relocated bytes")}; }
    val base: *u8 = ?table.items[u8](rel)[offset::usize];
    if (offset + n <= count) {
        ret res[Body, Fail].ok{Body.raw{Raw{bytes: Held.borrowed{Bytes{data: base, len: n::usize}}, why: Why.opaque{}}}};
    }
    var copy: Sink      = sink.make(b.a, LITTLE);
    var w:    err[Fail] = sink.bytes(?copy, base, (count - offset)::usize);
    w = fail.kept(w, sink.zeros(?copy, (offset + n - count)::usize));
    var held: res[Held, Fail] = res[Held, Fail].err{fail.internal("the section was not copied")};
    if (sel w.ok) { held = model.own(?b.m, sink.data(?copy), sink.len(?copy)); }
    val rc: err[Fail] = sink.release(?copy);
    if (sel w.err)    { ret res[Body, Fail].err{w.err}; }
    if (sel held.err) { ret res[Body, Fail].err{held.err}; }
    if (sel rc.err)   { ret res[Body, Fail].err{rc.err}; }
    ret res[Body, Fail].ok{Body.raw{Raw{bytes: held.ok, why: Why.opaque{}}}};
}

# `n` zero bytes the model holds
fun zeros(b: *Build, n: u64) res[Held, Fail] {
    var z:    Sink            = sink.make(b.a, LITTLE);
    val w:    err[Fail]       = sink.zeros(?z, n::usize);
    var held: res[Held, Fail] = res[Held, Fail].err{fail.internal("the zeros were not made")};
    if (sel w.ok) { held = model.own(?b.m, sink.data(?z), sink.len(?z)); }
    val rz: err[Fail] = sink.release(?z);
    if (sel w.err)    { ret res[Held, Fail].err{w.err}; }
    if (sel held.err) { ret held; }
    if (sel rz.err)   { ret res[Held, Fail].err{rz.err}; }
    ret held;
}

fun order_rva(x: *u64, y: *u64) i64 {
    if (@x < @y) { ret -1; }
    if (@x > @y) { ret 1; }
    ret 0;
}

# the base relocation blocks of the `n` image offsets at `rvas`, ascending,
# each of `type`, into `out`: one block per page, each entry the type in its
# high four bits and the offset in the page below, an entry of type zero
# padding a block to a multiple of four bytes
fun blocks(a: *A.Allocator, rvas: *u64, n: usize, type: u64, out: *Table[RelocBlock]) err[Fail] {
    var i: usize = 0;
    for (i < n) {
        val rva:  u64 = rvas[i];
        val page: u64 = rva & ~(BLOCK_PAGE - 1);
        if (rva > 0xffff_ffff) { ret err[Fail].err{fail.valued(fail.overflow("a base relocation lies past 4 GiB of the image base"), rva::i128)}; }
        var count: usize = table.count[RelocBlock](out);
        if (count == 0 || table.at[RelocBlock](out, table.nth[RelocBlock](count - 1)).page_rva::u64 != page) {
            if (count != 0) {
                val p: err[Fail] = padded(table.at[RelocBlock](out, table.nth[RelocBlock](count - 1)));
                if (sel p.err) { ret p; }
            }
            val r: res[Id[RelocBlock], Fail] = table.push[RelocBlock](out, RelocBlock{page_rva: page::u32, entries: table.make[u16](a)});
            if (sel r.err) { ret err[Fail].err{r.err}; }
            count = count + 1;
        }
        val e: res[Id[u16], Fail] = table.push[u16](?table.at[RelocBlock](out, table.nth[RelocBlock](count - 1)).entries, ((type << BLOCK_TYPE) | (rva - page))::u16);
        if (sel e.err) { ret err[Fail].err{e.err}; }
        i = i + 1;
    }
    val count: usize = table.count[RelocBlock](out);
    if (count != 0) { ret padded(table.at[RelocBlock](out, table.nth[RelocBlock](count - 1))); }
    ret err[Fail].ok{};
}

fun padded(k: *RelocBlock) err[Fail] {
    if (table.count[u16](?k.entries) % 2 == 0) { ret err[Fail].ok{}; }
    val e: res[Id[u16], Fail] = table.push[u16](?k.entries, (tables.IMAGE_REL_BASED_ABSOLUTE.value << BLOCK_TYPE)::u16);
    if (sel e.err) { ret err[Fail].err{e.err}; }
    ret err[Fail].ok{};
}

fun release_blocks(t: *Table[RelocBlock]) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[RelocBlock](t)) {
        first = fail.kept(first, table.release[u16](?table.at[RelocBlock](t, table.nth[RelocBlock](i)).entries));
        i     = i + 1;
    }
    ret fail.kept(first, table.release[RelocBlock](t));
}

# the base relocation blocks of the `n` image addresses at `addresses`, each
# of `type`, into `out`, in address order
fun based(a: *A.Allocator, base: u64, addresses: *u64, n: usize, type: u64, out: *Table[RelocBlock]) err[Fail] {
    var rvas: Table[u64] = table.make[u64](a);
    val o:    err[Fail]  = offsets(base, addresses, n, ?rvas);
    var e:    err[Fail]  = o;
    if (sel o.ok) { e = blocks(a, table.items[u64](?rvas), n, type, out); }
    ret fail.kept(e, table.release[u64](?rvas));
}

# the offset of each of the `n` addresses at `addresses` from the image base
# `base`, ascending, into `out`
fun offsets(base: u64, addresses: *u64, n: usize, out: *Table[u64]) err[Fail] {
    val g: res[Id[u64], Fail] = table.grow[u64](out, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < n) {
        if (addresses[i] < base) { ret err[Fail].err{fail.valued(fail.internal("a base relocation lies below the image base"), addresses[i]::i128)}; }
        table.items[u64](out)[i] = addresses[i] - base;
        i                        = i + 1;
    }
    sort.sort_by[u64](table.items[u64](out), n, order_rva);
    ret err[Fail].ok{};
}

# the address of each loader relocation site of the laid out image `img`,
# into `out`, where layout put it
fun laid_sites(img: *Image, out: *Table[u64]) err[Fail] {
    val list: *Table[Site]       = ?img.sites.list;
    val g:    res[Id[u64], Fail] = table.grow[u64](out, table.count[Site](list));
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < table.count[Site](list)) {
        val s: *Site     = table.at[Site](list, table.nth[Site](i));
        val r: err[Fail] = rebased(s);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "loader relocation site", i::u64)}; }
        val at: res[layout.Position, Fail] = sites.position(img.layout, img.pieces, img.reserved, s);
        if (sel at.err) { ret err[Fail].err{fail.in_indexed(at.err, "loader relocation site", i::u64)}; }
        table.items[u64](out)[i] = at.ok.address;
        i                        = i + 1;
    }
    ret err[Fail].ok{};
}

# the address of each loader relocation site of the relocated image `img`,
# into `out`, as relocate filled it in
fun filled_sites(img: *Image, out: *Table[u64]) err[Fail] {
    val filled: err[Fail] = sites.addressed(img.sites);
    if (sel filled.err) { ret filled; }
    val list: *Table[Site]       = ?img.sites.list;
    val g:    res[Id[u64], Fail] = table.grow[u64](out, table.count[Site](list));
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < table.count[Site](list)) {
        val s: *Site     = table.at[Site](list, table.nth[Site](i));
        val r: err[Fail] = rebased(s);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "loader relocation site", i::u64)}; }
        table.items[u64](out)[i] = s.address;
        i                        = i + 1;
    }
    ret err[Fail].ok{};
}

# refused for a site the loader binds or one holding a thread pointer
# offset, which a base relocation cannot state
fun rebased(s: *Site) err[Fail] {
    if (sel s.kind.bind) { ret err[Fail].err{fail.internal("a PE image binds an address only in its import address table, never at a loader relocation site")}; }
    if (s.thread)        { ret err[Fail].err{fail.internal("a PE base relocation moves an address, never a thread pointer offset")}; }
    ret err[Fail].ok{};
}

# the bytes the base relocations of the laid out image `img` take, its sites
# grouped by page
fun base_relocations(img: *Image) res[u64, Fail] {
    val w: res[*Width, Fail] = width_of(img.target.arch);
    if (sel w.err) { ret res[u64, Fail].err{w.err}; }
    val a:    *A.Allocator      = img.inputs.a;
    var at:   Table[u64]        = table.make[u64](a);
    var made: Table[RelocBlock] = table.make[RelocBlock](a);
    val s:    err[Fail]         = laid_sites(img, ?at);
    var t:    err[Fail]         = s;
    if (sel s.ok) { t = tls_sites(img, w.ok, ?at); }
    var h: err[Fail] = t;
    if (sel t.ok) { h = hybrid_sites(img, ?at); }
    var e: err[Fail] = h;
    if (sel h.ok) { e = based(a, img.layout.base, table.items[u64](?at), table.count[u64](?at), w.ok.based.value, ?made); }
    val size: u64 = model.blocks_len(?made);
    e = fail.kept(e, table.release[u64](?at));
    e = fail.kept(e, release_blocks(?made));
    if (sel e.err) { ret res[u64, Fail].err{e.err}; }
    ret res[u64, Fail].ok{size};
}

# reserve .reloc in an image the loader may place anywhere, measured once
# addresses are known and laid out last, in a segment of its own, the import
# tables of an image that imports, in .idata where the import address table
# lies, the TLS directory and index cell of an image that supplies its own,
# the resource tree of an image whose inputs carry resources and the export
# table of a DLL whose inputs state exports
fun declare(in: *reserve.In, out: *Reserved) err[Fail] {
    if (table.count[Entry](dynamic.entries_of(in.dynamic, ?slot.IAT)) != 0) {
        val p: opt[u8] = arch.pointer_bytes(in.arch);
        if (sel p.none) { ret err[Fail].err{fail.about(fail.unsupported("the architecture states no address width"), in.arch.name)}; }
        val t: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
            name:      coff_convention.IDATA,
            kind:      ?section.RELRO_DATA,
            flags:     section.ALLOC | section.WRITE,
            align:     p.some::u64,
            sizing:    reserve.Sizing.measured{?IMPORT_TABLES},
            placement: reserve.Placement.region_end{?reserve.RELRO_END},
            limit:     0xffff_ffff,
            reason:    "the import tables pass 4 GiB",
        });
        if (sel t.err) { ret err[Fail].err{t.err}; }
    }
    val th: err[Fail] = declare_tls(in, out);
    if (sel th.err) { ret th; }
    val rs: err[Fail] = declare_resources(in, out);
    if (sel rs.err) { ret rs; }
    val ex: err[Fail] = declare_exports(in, out);
    if (sel ex.err) { ret ex; }
    val hy: err[Fail] = coff_hybrid.declare(in, out);
    if (sel hy.err)            { ret hy; }
    if (!relocatable(in.kind)) { ret err[Fail].ok{}; }
    val d: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
        name:      RELOC_NAME,
        kind:      ?section.RODATA,
        flags:     section.ALLOC,
        align:     BLOCK_ALIGN,
        sizing:    reserve.Sizing.measured{?BASE_RELOCATIONS},
        placement: reserve.Placement.own_segment{"base relocations"},
        limit:     0xffff_ffff,
        reason:    "the base relocations pass 4 GiB",
    });
    if (sel d.err) { ret err[Fail].err{d.err}; }
    ret err[Fail].ok{};
}

# the output section layout put .reloc in, none when the image reserved none
fun reloc_of(img: *Image) res[opt[Id[Merged]], Fail] {
    val t: opt[Id[Reservation]] = measured_of(img, ?BASE_RELOCATIONS);
    if (sel t.none) { ret res[opt[Id[Merged]], Fail].ok{opt[Id[Merged]].none{}}; }
    val p: res[Placed, Fail] = placed_of(img, t.some);
    if (sel p.err) { ret res[opt[Id[Merged]], Fail].err{p.err}; }
    ret res[opt[Id[Merged]], Fail].ok{opt[Id[Merged]].some{p.ok.merged}};
}

# the table the image reserved measured by `key`, none when it reserved none
fun measured_of(img: *Image, key: *reserve.Measure) opt[Id[Reservation]] {
    var i: usize = 0;
    for (i < table.count[Reservation](?img.reserved.tables)) {
        val m: opt[*reserve.Measure] = table.at[Reservation](?img.reserved.tables, table.nth[Reservation](i)).measure;
        if (sel m.some && m.some == key) { ret opt[Id[Reservation]].some{table.nth[Reservation](i)}; }
        i = i + 1;
    }
    ret opt[Id[Reservation]].none{};
}

# where layout put the reserved table `t`, which lies in an output section
fun placed_of(img: *Image, t: Id[Reservation]) res[Placed, Fail] {
    if (t.index::usize >= table.count[Spot](?img.layout.tables)) { ret res[Placed, Fail].err{fail.internal("a reserved table was never placed")}; }
    val sp: Spot = table.items[Spot](?img.layout.tables)[t.index::usize];
    if (!sel sp.section) { ret res[Placed, Fail].err{fail.internal("a table the image fills lies in no output section")}; }
    ret res[Placed, Fail].ok{sp.section};
}

# the bytes of .reloc, `raw` in the file: the blocks of the link's loader
# relocation sites at the addresses relocate filled in, which are the size
# layout left for them, then zeros
fun reloc_body(b: *Build, m: *Merged, raw: u64) res[Body, Fail] {
    var at: Table[u64] = table.make[u64](b.a);
    val f:  err[Fail]  = filled_sites(b.img, ?at);
    if (sel f.err) {
        val dropped: err[Fail] = table.release[u64](?at);
        ret res[Body, Fail].err{f.err};
    }
    val n:    usize             = table.count[u64](?at);
    var made: Table[RelocBlock] = table.make[RelocBlock](b.a);
    val ts:   err[Fail]         = tls_sites(b.img, b.width, ?at);
    var hs:   err[Fail]         = ts;
    if (sel ts.ok) { hs = hybrid_sites(b.img, ?at); }
    var e: err[Fail] = hs;
    if (sel hs.ok) { e = based(b.a, b.base, table.items[u64](?at), table.count[u64](?at), b.width.based.value, ?made); }
    e = fail.kept(e, table.release[u64](?at));
    if (sel e.err) {
        val dropped: err[Fail] = release_blocks(?made);
        ret res[Body, Fail].err{e.err};
    }
    if (model.blocks_len(?made) != m.size) {
        val dropped: err[Fail] = release_blocks(?made);
        ret res[Body, Fail].err{fail.internal("the base relocations are not the size layout left for them")};
    }
    var tiles: Table[Piece]         = table.make[Piece](b.a);
    val p:     res[Id[Piece], Fail] = table.push[Piece](?tiles, Piece.relocations{made});
    if (sel p.err) {
        val dropped: err[Fail] = release_blocks(?made);
        ret res[Body, Fail].err{p.err};
    }
    val pad: err[Fail] = padding(b, ?tiles, raw - m.size);
    if (sel pad.err) {
        val dropped: err[Fail] = model.release_pieces(?tiles);
        ret res[Body, Fail].err{pad.err};
    }
    ret res[Body, Fail].ok{Body.tiled{tiles}};
}

# `n` zeros after the pieces `tiles`, none when `n` is zero
fun padding(b: *Build, tiles: *Table[Piece], n: u64) err[Fail] {
    if (n == 0) { ret err[Fail].ok{}; }
    val z: res[Held, Fail] = zeros(b, n);
    if (sel z.err) { ret err[Fail].err{z.err}; }
    val p: res[Id[Piece], Fail] = table.push[Piece](tiles, Piece.raw{Raw{bytes: z.ok, why: Why.opaque{}}});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the function table of output section `m`, `raw` in the file, in the layout
# of `machine`: its relocated entries sorted by where their functions start,
# then zeros. an ARM64EC image's native table is its x64 table's apart
fun exceptions_body(b: *Build, m: *Merged, raw: u64, machine: u16) res[Body, Fail] {
    val ft: opt[*FunctionTable] = model.function_table(machine::u64);
    if (sel ft.none) { ret res[Body, Fail].err{fail.about(fail.unsupported("the machine has no function table layout"), b.img.target.arch.name)}; }
    val size: u64 = model.entry_size(ft.some);
    if (m.size % size != 0) { ret res[Body, Fail].err{fail.valued(fail.malformed("a function table is not a whole number of entries"), m.size::i128)}; }
    val rel: *Table[u8] = ?b.img.relocated.bytes;
    if (m.offset > table.count[u8](rel)::u64 || m.size > table.count[u8](rel)::u64 - m.offset) {
        ret res[Body, Fail].err{fail.internal("a function table lies past the relocated bytes")};
    }
    var r: Reader                = reader.make("function table", ?table.items[u8](rel)[m.offset::usize], m.size::usize, LITTLE);
    val n: usize                 = (m.size / size)::usize;
    var e: res[Exceptions, Fail] = res[Exceptions, Fail].err{fail.internal("the function table was not read")};
    if (ft.some.ended) { e = x64_entries(b.a, ?r, n); }
    or                 { e = arm_entries(b.a, ?r, n); }
    if (sel e.err)     { ret res[Body, Fail].err{e.err}; }
    var tiles: Table[Piece]         = table.make[Piece](b.a);
    val p:     res[Id[Piece], Fail] = table.push[Piece](?tiles, Piece.exceptions{e.ok});
    if (sel p.err) {
        var lost:    Exceptions = e.ok;
        val dropped: err[Fail]  = release_exceptions(?lost);
        ret res[Body, Fail].err{p.err};
    }
    val pad: err[Fail] = padding(b, ?tiles, raw - m.size);
    if (sel pad.err) {
        val dropped: err[Fail] = model.release_pieces(?tiles);
        ret res[Body, Fail].err{pad.err};
    }
    ret res[Body, Fail].ok{Body.tiled{tiles}};
}

fun release_exceptions(e: *Exceptions) err[Fail] {
    if (sel e.x64) { ret table.release[RuntimeFunction](?e.x64); }
    ret table.release[RuntimeFunctionArm64](?e.arm64);
}

# the `n` entries that state where their functions end at `r`, sorted
fun x64_entries(a: *A.Allocator, r: *Reader, n: usize) res[Exceptions, Fail] {
    var tab: Table[RuntimeFunction]         = table.make[RuntimeFunction](a);
    val g:   res[Id[RuntimeFunction], Fail] = table.grow[RuntimeFunction](?tab, n);
    var w:   err[Fail]                      = err[Fail].ok{};
    if (sel g.err) { w = err[Fail].err{g.err}; }
    var i: usize = 0;
    for (sel w.ok && i < n) {
        w = x64_entry(r, ?table.items[RuntimeFunction](?tab)[i]);
        i = i + 1;
    }
    if (sel w.err) {
        val dropped: err[Fail] = table.release[RuntimeFunction](?tab);
        ret res[Exceptions, Fail].err{w.err};
    }
    sort.sort_by[RuntimeFunction](table.items[RuntimeFunction](?tab), n, order_x64);
    ret res[Exceptions, Fail].ok{Exceptions.x64{tab}};
}

# the `n` entries of one unwind word at `r`, sorted, each word as written
fun arm_entries(a: *A.Allocator, r: *Reader, n: usize) res[Exceptions, Fail] {
    var tab: Table[RuntimeFunctionArm64]         = table.make[RuntimeFunctionArm64](a);
    val g:   res[Id[RuntimeFunctionArm64], Fail] = table.grow[RuntimeFunctionArm64](?tab, n);
    var w:   err[Fail]                           = err[Fail].ok{};
    if (sel g.err) { w = err[Fail].err{g.err}; }
    var i: usize = 0;
    for (sel w.ok && i < n) {
        w = arm_entry(r, ?table.items[RuntimeFunctionArm64](?tab)[i]);
        i = i + 1;
    }
    if (sel w.err) {
        val dropped: err[Fail] = table.release[RuntimeFunctionArm64](?tab);
        ret res[Exceptions, Fail].err{w.err};
    }
    sort.sort_by[RuntimeFunctionArm64](table.items[RuntimeFunctionArm64](?tab), n, order_arm);
    ret res[Exceptions, Fail].ok{Exceptions.arm64{tab}};
}

fun x64_entry(r: *Reader, out: *RuntimeFunction) err[Fail] {
    val begin: res[u32, Fail] = reader.u32(r);
    if (sel begin.err) { ret err[Fail].err{begin.err}; }
    val end: res[u32, Fail] = reader.u32(r);
    if (sel end.err) { ret err[Fail].err{end.err}; }
    val unwind: res[u32, Fail] = reader.u32(r);
    if (sel unwind.err) { ret err[Fail].err{unwind.err}; }
    @out = RuntimeFunction{begin: begin.ok, end: end.ok, unwind: unwind.ok};
    ret err[Fail].ok{};
}

fun arm_entry(r: *Reader, out: *RuntimeFunctionArm64) err[Fail] {
    val begin: res[u32, Fail] = reader.u32(r);
    if (sel begin.err) { ret err[Fail].err{begin.err}; }
    val unwind: res[u32, Fail] = reader.u32(r);
    if (sel unwind.err) { ret err[Fail].err{unwind.err}; }
    @out = RuntimeFunctionArm64{begin: begin.ok, unwind: unwind.ok};
    ret err[Fail].ok{};
}

# entries by where their functions start, then by every other field, so equal
# starts sort the same in every link
fun order_x64(x: *RuntimeFunction, y: *RuntimeFunction) i64 {
    val k: i64 = order_u32(x.begin, y.begin);
    if (k != 0) { ret k; }
    val e: i64 = order_u32(x.end, y.end);
    if (e != 0) { ret e; }
    ret order_u32(x.unwind, y.unwind);
}

fun order_arm(x: *RuntimeFunctionArm64, y: *RuntimeFunctionArm64) i64 {
    val k: i64 = order_u32(x.begin, y.begin);
    if (k != 0) { ret k; }
    ret order_u32(x.unwind, y.unwind);
}

fun order_u32(x: u32, y: u32) i64 {
    if (x < y) { ret -1; }
    if (x > y) { ret 1; }
    ret 0;
}

# the COFF machine of architecture `a`
fun machine_of(a: *Arch) res[u16, Fail] {
    val code: opt[*arch.Code] = arch.code(a, ?format.COFF);
    if (sel code.none) { ret res[u16, Fail].err{fail.about(fail.unsupported("the architecture has no COFF machine"), a.name)}; }
    ret res[u16, Fail].ok{code.some.fields[0].value::u16};
}

# the machine an image for `a` states in its file header: the machine of the
# architecture it joins where it joins one, as an ARM64EC image states
# AMD64 so a loader that knows no ARM64EC loads it as x64, else its own
# ("ARM64EC binaries", overview of ARM64EC ABI conventions)
fun header_machine(a: *Arch) res[u16, Fail] {
    val j: opt[*Arch] = a.joins;
    if (sel j.some) { ret machine_of(j.some); }
    ret machine_of(a);
}

# the file header: the architecture's machine, the sections, and the
# characteristics of an image of the layout and kind
fun header_out(b: *Build) err[Fail] {
    var ch: u64 = tables.IMAGE_FILE_EXECUTABLE_IMAGE.value | b.width.characteristics;
    if (!relocatable(b.img.kind))              { ch = ch | tables.IMAGE_FILE_RELOCS_STRIPPED.value; }
    if (output.has(b.img.kind, output.LOADED)) { ch = ch | tables.IMAGE_FILE_DLL.value; }
    b.m.signature = opt[u32].some{tables.PE_SIGNATURE.value::u32};
    val mc: res[u16, Fail] = header_machine(b.img.target.arch);
    if (sel mc.err) { ret err[Fail].err{mc.err}; }
    b.m.header.machine         = mc.ok;
    b.m.header.nsections       = table.count[model.Section](?b.m.sections)::u32;
    b.m.header.opt_size        = optional_size(b.width)::u16;
    b.m.header.characteristics = ch::u16;
    ret err[Fail].ok{};
}

# the system version the image states: the target's, else the host's, else
# SYSTEM
fun version_of(img: *Image) Version {
    val t: opt[Version] = img.target.version;
    if (sel t.some) { ret t.some; }
    val h: opt[Version] = img.host.minos;
    if (sel h.some) { ret h.some; }
    ret SYSTEM;
}

# the optional header: where the image lies and starts, how its sections are
# aligned and sized, the system and subsystem it runs on, its
# characteristics, and its data directories
fun optional_out(b: *Build) err[Fail] {
    if (!sel b.m.optional.image) { ret err[Fail].err{fail.internal("the image has no optional header")}; }
    val img:   *Image         = b.img;
    val o:     *model.Image   = ?b.m.optional.image;
    val at:    Location       = Location{record: "optional header"};
    val start: res[u32, Fail] = entry_rva(b);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    val sub: opt[*Subsystem] = target.subsystem_on(img.target, img.host);
    if (sel sub.none) { ret err[Fail].err{fail.about(fail.malformed("the image states no subsystem and its system names none"), img.host.sys.name)}; }
    val image: res[u64, Fail] = checked.align_up(at, b.end, b.align);
    if (sel image.err) { ret err[Fail].err{image.err}; }
    val span: res[u32, Fail] = rva_of(b, image.ok, "image", 0);
    if (sel span.err) { ret err[Fail].err{span.err}; }
    val heads: res[u64, Fail] = checked.align_up(at, b.size, b.file);
    if (sel heads.err) { ret err[Fail].err{heads.err}; }
    var i: usize = 0;
    for (i < table.count[model.Section](?b.m.sections)) {
        val s: *model.Section = model.section_at(?b.m, table.nth[model.Section](i));
        val f: u64            = s.flags::u64;
        if ((f & tables.IMAGE_SCN_CNT_CODE.value) != 0) {
            if (o.code_size == 0) { o.code_base = s.virtual_address; }
            o.code_size = o.code_size + s.raw_size;
        }
        if ((f & tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value) != 0) {
            if (o.init_data_size == 0 && b.width.shape.data_base.width != 0) { o.data_base = s.virtual_address; }
            o.init_data_size = o.init_data_size + s.raw_size;
        }
        if ((f & tables.IMAGE_SCN_CNT_UNINITIALIZED_DATA.value) != 0) { o.uninit_data_size = o.uninit_data_size + s.virtual_size; }
        i = i + 1;
    }
    val v:   Version = version_of(img);
    var dll: u64     = EVERY_IMAGE;
    if (output.has(img.kind, output.ENTERED)) { dll = dll | APPLICATION; }
    if (relocatable(img.kind))                { dll = dll | tables.IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE.value | b.width.randomized; }
    o.magic             = b.width.shape.magic.value::u16;
    o.linker_major      = LINKER_MAJOR;
    o.linker_minor      = LINKER_MINOR;
    o.entry             = start.ok;
    o.image_base        = b.base;
    o.section_alignment = b.align::u32;
    o.file_alignment    = b.file::u32;
    o.os_major          = v.major;
    o.os_minor          = v.minor::u16;
    o.subsystem_major   = v.major;
    o.subsystem_minor   = v.minor::u16;
    o.image_size        = span.ok;
    o.headers_size      = heads.ok::u32;
    o.checksum          = Checksum.spec{0};
    o.subsystem         = sub.some.number;
    o.dll_flags         = dll::u16;
    o.stack_reserve     = STACK_RESERVE;
    o.stack_commit      = STACK_COMMIT;
    o.heap_reserve      = HEAP_RESERVE;
    o.heap_commit       = HEAP_COMMIT;
    o.trailing          = Raw{bytes: Held.borrowed{Bytes{data: nil, len: 0}}, why: Why.opaque{}};
    val g: res[Id[DataDirectory], Fail] = table.grow[DataDirectory](?o.dirs, DIRECTORIES);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    table.items[DataDirectory](?o.dirs)[tables.IMAGE_DIRECTORY_ENTRY_BASERELOC.value::usize]   = b.dir;
    table.items[DataDirectory](?o.dirs)[tables.IMAGE_DIRECTORY_ENTRY_EXCEPTION.value::usize]   = b.exceptions;
    table.items[DataDirectory](?o.dirs)[tables.IMAGE_DIRECTORY_ENTRY_IMPORT.value::usize]      = b.imports;
    table.items[DataDirectory](?o.dirs)[tables.IMAGE_DIRECTORY_ENTRY_IAT.value::usize]         = b.iat;
    table.items[DataDirectory](?o.dirs)[tables.IMAGE_DIRECTORY_ENTRY_TLS.value::usize]         = b.tls;
    table.items[DataDirectory](?o.dirs)[tables.IMAGE_DIRECTORY_ENTRY_RESOURCE.value::usize]    = b.resources;
    table.items[DataDirectory](?o.dirs)[tables.IMAGE_DIRECTORY_ENTRY_EXPORT.value::usize]      = b.exports;
    table.items[DataDirectory](?o.dirs)[tables.IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG.value::usize] = b.load;
    ret err[Fail].ok{};
}

# the offset of the entry from the image base, zero for an image that starts
# at no entry, as a DLL may
fun entry_rva(b: *Build) res[u32, Fail] {
    val e: link_image.Entry = b.img.entry;
    if (sel e.none) { ret res[u32, Fail].ok{0}; }
    val entry: res[u64, Fail] = link_image.address_of(?b.img.entry);
    if (sel entry.err) { ret res[u32, Fail].err{entry.err}; }
    val at: res[u64, Fail] = forwarded(b.img, entry.ok);
    if (sel at.err) { ret res[u32, Fail].err{at.err}; }
    ret rva_of(b, at.ok, "entry", 0);
}

fun extent(b: *Build, e: Extent) err[Fail] {
    val r: res[Id[Extent], Fail] = table.push[Extent](?b.m.extents, e);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

# the MS-DOS header and program, the PE signature pointer naming the
# signature after them
fun dos(b: *Build) res[Held, Fail] {
    var d:    Sink            = sink.make(b.a, LITTLE);
    val w:    err[Fail]       = dos_bytes(?d);
    var held: res[Held, Fail] = res[Held, Fail].err{fail.internal("the MS-DOS header was not made")};
    if (sel w.ok) { held = model.own(?b.m, sink.data(?d), sink.len(?d)); }
    val rd: err[Fail] = sink.release(?d);
    if (sel w.err)    { ret res[Held, Fail].err{w.err}; }
    if (sel held.err) { ret held; }
    if (sel rd.err)   { ret res[Held, Fail].err{rd.err}; }
    ret held;
}

# the header's magic, the bytes in its last page, its pages, the
# paragraphs of the header, where its relocations would start and the PE
# signature pointer, then the program
fun dos_bytes(d: *Sink) err[Fail] {
    val lfanew: usize     = tables.LFANEW_OFFSET.value::usize;
    var w:      err[Fail] = sink.u16(d, tables.MZ_MAGIC.value::u16);
    w = fail.kept(w, sink.u16(d, (DOS_SIZE % DOS_PAGE)::u16));
    w = fail.kept(w, sink.u16(d, ((DOS_SIZE + DOS_PAGE - 1) / DOS_PAGE)::u16));
    w = fail.kept(w, sink.u16(d, 0));
    w = fail.kept(w, sink.u16(d, (DOS_HEADER / DOS_PARAGRAPH)::u16));
    w = fail.kept(w, sink.zeros(d, DOS_RELOCATIONS - sink.len(d)));
    w = fail.kept(w, sink.u16(d, DOS_HEADER::u16));
    w = fail.kept(w, sink.zeros(d, lfanew - sink.len(d)));
    w = fail.kept(w, sink.u32(d, DOS_SIZE::u32));
    ret fail.kept(w, sink.bytes(d, ?DOS_PROGRAM[0], DOS_PROGRAM_SIZE));
}

# the file in order: the headers, then each section's bytes at the offset
# its header gives, zeros between
fun extents_out(b: *Build) err[Fail] {
    val d: res[Held, Fail] = dos(b);
    if (sel d.err) { ret err[Fail].err{d.err}; }
    var w: err[Fail] = extent(b, Extent.dos{d.ok});
    w = fail.kept(w, extent(b, Extent.signature{}));
    w = fail.kept(w, extent(b, Extent.header{}));
    w = fail.kept(w, extent(b, Extent.optional{}));
    w = fail.kept(w, extent(b, Extent.sections{}));
    if (sel w.err) { ret w; }
    var cursor: u64   = b.size;
    var i:      usize = 0;
    for (i < table.count[model.Section](?b.m.sections)) {
        val s: *model.Section = model.section_at(?b.m, table.nth[model.Section](i));
        if (s.raw_size != 0) {
            val g: err[Fail] = gap(b, cursor, s.raw_ptr::u64);
            if (sel g.err) { ret g; }
            val e: err[Fail] = extent(b, Extent.section{table.nth[model.Section](i)});
            if (sel e.err) { ret e; }
            cursor = s.raw_ptr::u64 + s.raw_size::u64;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# zeros from `from` up to `to`, which no section covers
fun gap(b: *Build, from: u64, to: u64) err[Fail] {
    if (to < from)  { ret err[Fail].err{fail.internal("a section's bytes overlap what lies before them")}; }
    if (to == from) { ret err[Fail].ok{}; }
    val z: res[Held, Fail] = zeros(b, to - from);
    if (sel z.err) { ret err[Fail].err{z.err}; }
    ret extent(b, Extent.raw{Raw{bytes: z.ok, why: Why.opaque{}}});
}

# how the loader finds the import of one address slot
# ---
# named:   by the name of its hint/name entry
# ordinal: by this ordinal
tag Lookup: u8 {
    named:   Hinted;
    ordinal: u16;
}

# a hint/name entry
# ---
# at:   where it lies in the hint/name table
# hint: its hint
# name: the name the DLL exports the import by
rec Hinted {
    at:   u64;
    hint: u16;
    name: View;
}

# the run of one DLL in the import address table
# ---
# library: the DLL
# first:   where its run starts in the table
# name:    where its name lies among the DLL names
rec Run {
    library: Id[dynamic.Library];
    first:   u64;
    name:    u64;
}

# where in the import address table no run starts yet
val NO_RUN: u64 = 0xffff_ffff_ffff_ffff;

# where each import table lies in the table the image reserves for them and
# what each import address slot holds, one reading for the measure and the
# writer
# ---
# width:   the bytes of an address slot
# iat:     the import address table
# slots:   the bytes it takes
# runs:    the run of each DLL the image imports from, by rank
# lookups: how the loader finds the import of each slot, by target
# lookup:  where the import lookup table starts, laid as the import address
#          table is
# names:   where the hint/name table starts
# dlls:    where the DLL names start
# size:    the bytes the import tables take
rec Imports {
    width:   u64;
    iat:     Id[Reservation];
    slots:   u64;
    runs:    Table[Run];
    lookups: Table[Lookup];
    lookup:  u64;
    names:   u64;
    dlls:    u64;
    size:    u64;
}

fun release_imports(im: *Imports) err[Fail] {
    ret fail.kept(table.release[Run](?im.runs), table.release[Lookup](?im.lookups));
}

# the import tables of the image `img`, laid out or not, whose address slots
# take `width` bytes
fun imports_of(img: *Image, width: u64) res[Imports, Fail] {
    val a:  *A.Allocator = img.inputs.a;
    var im: Imports      = Imports{width: width, runs: table.make[Run](a), lookups: table.make[Lookup](a)};
    val e:  err[Fail]    = imports_laid(img, ?im);
    if (sel e.err) {
        val dropped: err[Fail] = release_imports(?im);
        ret res[Imports, Fail].err{fail.in_record(e.err, "import tables")};
    }
    ret res[Imports, Fail].ok{im};
}

fun imports_laid(img: *Image, im: *Imports) err[Fail] {
    val d:       *Dynamic           = img.dynamic;
    val entries: *Table[Entry]      = dynamic.entries_of(d, ?slot.IAT);
    val n:       usize              = table.count[Entry](entries);
    val first:   opt[*reserve.Slot] = reserve.slot_of(img.reserved, ?slot.IAT, 0);
    if (sel first.none) { ret err[Fail].err{fail.internal("the imports take no import address table")}; }
    im.iat   = first.some.table;
    im.slots = table.at[Reservation](?img.reserved.tables, im.iat).size;
    if (im.slots % im.width != 0) { ret err[Fail].err{fail.internal("the import address table is not a whole number of slots")}; }
    val r: err[Fail] = runs_of(d, ?im.runs);
    if (sel r.err) { ret r; }
    if (n != 0) {
        val g: res[Id[Lookup], Fail] = table.grow[Lookup](?im.lookups, n);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    val at:    Location = Location{record: "hint/name table"};
    var names: u64      = 0;
    var i:     usize    = 0;
    for (i < n) {
        val s: opt[*reserve.Slot] = reserve.slot_of(img.reserved, ?slot.IAT, i::u32);
        if (sel s.none)                         { ret err[Fail].err{fail.in_indexed(fail.internal("an import takes no address slot"), "slot", i::u64)}; }
        if (s.some.table.index != im.iat.index) { ret err[Fail].err{fail.internal("the import address slots lie in two tables")}; }
        val aim: dynamic.Aim = table.at[Entry](entries, table.nth[Entry](i)).aim;
        if (!sel aim.imported) { ret err[Fail].err{fail.in_indexed(fail.internal("an import address slot aims at no import"), "slot", i::u64)}; }
        val imp:  *dynamic.Import = table.at[dynamic.Import](?d.imports, aim.imported);
        val rank: opt[u32]        = table.at[dynamic.Library](?d.libraries, imp.library).rank;
        if (sel rank.none)                                  { ret err[Fail].err{fail.internal("a DLL the image imports from has no rank")}; }
        if (rank.some::usize >= table.count[Run](?im.runs)) { ret err[Fail].err{fail.internal("a DLL the image imports from has no run")}; }
        val run: *Run = table.at[Run](?im.runs, table.nth[Run](rank.some::usize));
        if (s.some.offset < run.first) { run.first = s.some.offset; }
        val found: res[Lookup, Fail] = lookup_of(img, imp, names);
        if (sel found.err) { ret err[Fail].err{fail.in_indexed(found.err, "import", aim.imported.index::u64)}; }
        table.items[Lookup](?im.lookups)[i] = found.ok;
        if (sel found.ok.named) {
            val entry: res[u64, Fail] = checked.align_up(at, 2 + found.ok.named.name.len::u64 + 1, 2);
            if (sel entry.err) { ret err[Fail].err{entry.err}; }
            val next: res[u64, Fail] = checked.add(at, names, entry.ok);
            if (sel next.err) { ret err[Fail].err{next.err}; }
            names = next.ok;
        }
        i = i + 1;
    }
    val w:           Location       = Location{record: "import tables"};
    val descriptors: res[u64, Fail] = checked.mul(w, table.count[Run](?im.runs)::u64 + 1, model.IMPORT_SIZE);
    if (sel descriptors.err) { ret err[Fail].err{descriptors.err}; }
    val lookup: res[u64, Fail] = checked.align_up(w, descriptors.ok, im.width);
    if (sel lookup.err) { ret err[Fail].err{lookup.err}; }
    im.lookup = lookup.ok;
    val hinted: res[u64, Fail] = checked.add(w, im.lookup, im.slots);
    if (sel hinted.err) { ret err[Fail].err{hinted.err}; }
    im.names = hinted.ok;
    val dlls: res[u64, Fail] = checked.add(w, im.names, names);
    if (sel dlls.err) { ret err[Fail].err{dlls.err}; }
    im.dlls = dlls.ok;
    var spelled: u64   = 0;
    var k:       usize = 0;
    for (k < table.count[Run](?im.runs)) {
        val run: *Run = table.at[Run](?im.runs, table.nth[Run](k));
        if (run.first == NO_RUN) { ret err[Fail].err{fail.in_indexed(fail.internal("a DLL the image imports from has no import address slot"), "library", run.library.index::u64)}; }
        run.name = spelled;
        val loader: View           = intern.bytes_of(img.names, table.at[dynamic.Library](?d.libraries, run.library).loader);
        val next:   res[u64, Fail] = checked.add(w, spelled, loader.len::u64 + 1);
        if (sel next.err) { ret err[Fail].err{next.err}; }
        spelled = next.ok;
        k       = k + 1;
    }
    val size: res[u64, Fail] = checked.add(w, im.dlls, spelled);
    if (sel size.err) { ret err[Fail].err{size.err}; }
    im.size = size.ok;
    ret err[Fail].ok{};
}

# a run per library a reference binds to into `runs`, by rank, none started
fun runs_of(d: *Dynamic, runs: *Table[Run]) err[Fail] {
    var ranks: usize = 0;
    var i:     usize = 0;
    for (i < table.count[dynamic.Library](?d.libraries)) {
        val rank: opt[u32] = table.at[dynamic.Library](?d.libraries, table.nth[dynamic.Library](i)).rank;
        if (sel rank.some) { ranks = ranks + 1; }
        i = i + 1;
    }
    if (ranks == 0) { ret err[Fail].ok{}; }
    val g: res[Id[Run], Fail] = table.grow[Run](runs, ranks);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var k: usize = 0;
    for (k < ranks) {
        table.items[Run](runs)[k].first = NO_RUN;
        k                               = k + 1;
    }
    i = 0;
    for (i < table.count[dynamic.Library](?d.libraries)) {
        val rank: opt[u32] = table.at[dynamic.Library](?d.libraries, table.nth[dynamic.Library](i)).rank;
        if (sel rank.some) {
            if (rank.some::usize >= ranks) { ret err[Fail].err{fail.internal("the libraries' ranks are not dense")}; }
            table.items[Run](runs)[rank.some::usize].library = table.nth[dynamic.Library](i);
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# how the loader finds the import `imp`, whose hint/name entry, for one by
# name, lies `at` into the hint/name table
fun lookup_of(img: *Image, imp: *dynamic.Import, at: u64) res[Lookup, Fail] {
    val off: *dynamic.Offer = table.at[dynamic.Offer](?img.dynamic.offers, imp.offer);
    val o:   *Object        = input.object_of(img.inputs, off.input);
    val sym: *Symbol        = object.symbol_at(o, off.symbol);
    if (!sel sym.def.library) { ret res[Lookup, Fail].err{fail.internal("an import binds a symbol its DLL does not define")}; }
    val e: object.Export = sym.def.library;
    if (sel e.ordinal) { ret res[Lookup, Fail].ok{Lookup.ordinal{e.ordinal}}; }
    var hint: u16      = 0;
    val held: opt[u16] = e.named.hint;
    if (sel held.some) { hint = held.some; }
    ret res[Lookup, Fail].ok{Lookup.named{Hinted{at: at, hint: hint, name: object.name_of(o, e.named.name)}}};
}

# the bytes the import tables of the laid out image `img` take
fun import_tables(img: *Image) res[u64, Fail] {
    val w: res[*Width, Fail] = width_of(img.target.arch);
    if (sel w.err) { ret res[u64, Fail].err{w.err}; }
    val im: res[Imports, Fail] = imports_of(img, w.ok.shape.addr::u64);
    if (sel im.err) { ret res[u64, Fail].err{im.err}; }
    var got:  Imports   = im.ok;
    val size: u64       = got.size;
    val rel:  err[Fail] = release_imports(?got);
    if (sel rel.err) { ret res[u64, Fail].err{rel.err}; }
    ret res[u64, Fail].ok{size};
}

# the import tables and the import address table as pieces of the sections
# they lie in, and the directories naming them, nothing for an image that
# imports nothing
fun imports_out(b: *Build) err[Fail] {
    if (table.count[Entry](dynamic.entries_of(b.img.dynamic, ?slot.IAT)) == 0) { ret err[Fail].ok{}; }
    val im: res[Imports, Fail] = imports_of(b.img, b.width.shape.addr::u64);
    if (sel im.err) { ret err[Fail].err{im.err}; }
    var got: Imports   = im.ok;
    val e:   err[Fail] = imports_tiled(b, ?got);
    val rel: err[Fail] = release_imports(?got);
    if (sel e.err)   { ret err[Fail].err{fail.in_record(e.err, "import tables")}; }
    if (sel rel.err) { ret rel; }
    ret err[Fail].ok{};
}

fun imports_tiled(b: *Build, im: *Imports) err[Fail] {
    val t: opt[Id[Reservation]] = measured_of(b.img, ?IMPORT_TABLES);
    if (sel t.none)                                                            { ret err[Fail].err{fail.internal("the image reserved no import tables")}; }
    if (table.at[Reservation](?b.img.reserved.tables, t.some).size != im.size) { ret err[Fail].err{fail.internal("the import tables are not the size layout left for them")}; }
    val at: res[Placed, Fail] = placed_of(b.img, t.some);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val iat: res[Placed, Fail] = placed_of(b.img, im.iat);
    if (sel iat.err) { ret err[Fail].err{iat.err}; }
    val home: res[u32, Fail] = spanned(b, at.ok, im.size, "import tables");
    if (sel home.err) { ret err[Fail].err{home.err}; }
    val slots: res[u32, Fail] = spanned(b, iat.ok, im.slots, "import address table");
    if (sel slots.err) { ret err[Fail].err{slots.err}; }
    val base: u64       = home.ok::u64;
    val d:    err[Fail] = descriptors_tile(b, im, at.ok, base, slots.ok::u64);
    if (sel d.err) { ret d; }
    var lookup: Table[u64] = table.make[u64](b.a);
    val v:      err[Fail]  = slot_values(b, im, base, ?lookup);
    if (sel v.err) {
        val dropped: err[Fail] = table.release[u64](?lookup);
        ret v;
    }
    var addresses: Table[u64]         = table.make[u64](b.a);
    val copied:    res[Id[u64], Fail] = table.extend[u64](?addresses, table.items[u64](?lookup), table.count[u64](?lookup));
    if (sel copied.err) {
        val dropped: err[Fail] = fail.kept(table.release[u64](?lookup), table.release[u64](?addresses));
        ret err[Fail].err{copied.err};
    }
    val l: err[Fail] = tile(b, at.ok.merged, at.ok.offset + im.lookup, im.slots, Piece.pointers{lookup});
    if (sel l.err) {
        val dropped: err[Fail] = table.release[u64](?addresses);
        ret l;
    }
    val s: err[Fail] = tile(b, iat.ok.merged, iat.ok.offset, im.slots, Piece.pointers{addresses});
    if (sel s.err) { ret s; }
    val n: err[Fail] = names_tile(b, im, at.ok);
    if (sel n.err) { ret n; }
    val dl: err[Fail] = dlls_tile(b, im, at.ok);
    if (sel dl.err) { ret dl; }
    b.imports = DataDirectory{rva: home.ok, size: ((table.count[Run](?im.runs) + 1)::u64 * model.IMPORT_SIZE)::u32};
    b.iat     = DataDirectory{rva: slots.ok, size: im.slots::u32};
    ret err[Fail].ok{};
}

# the offset from the image base of the `size` bytes at `at`, all of which
# lie in the 4 GiB above it
fun spanned(b: *Build, at: Placed, size: u64, record: str) res[u32, Fail] {
    val l:     Location       = Location{record: record};
    val start: res[u64, Fail] = checked.add(l, table.at[Merged](?b.img.layout.merged, at.merged).address, at.offset);
    if (sel start.err) { ret res[u32, Fail].err{start.err}; }
    val end: res[u64, Fail] = checked.add(l, start.ok, size);
    if (sel end.err) { ret res[u32, Fail].err{end.err}; }
    val last: res[u32, Fail] = rva_of(b, end.ok, record, 0);
    if (sel last.err) { ret last; }
    ret rva_of(b, start.ok, record, 0);
}

# a descriptor per DLL by rank, then the empty one closing them, at `at`. the
# import tables start at the image offset `base` and the import address table
# at `iat`
fun descriptors_tile(b: *Build, im: *Imports, at: Placed, base: u64, iat: u64) err[Fail] {
    val n: usize                           = table.count[Run](?im.runs);
    var t: Table[ImportDescriptor]         = table.make[ImportDescriptor](b.a);
    val g: res[Id[ImportDescriptor], Fail] = table.grow[ImportDescriptor](?t, n + 1);
    if (sel g.err) {
        val dropped: err[Fail] = table.release[ImportDescriptor](?t);
        ret err[Fail].err{g.err};
    }
    var i: usize = 0;
    for (i < n) {
        val run: *Run = table.at[Run](?im.runs, table.nth[Run](i));
        table.items[ImportDescriptor](?t)[i] = ImportDescriptor{
            lookup_rva: (base + im.lookup + run.first)::u32,
            name_rva:   (base + im.dlls + run.name)::u32,
            thunk_rva:  (iat + run.first)::u32,
        };
        i = i + 1;
    }
    ret tile(b, at.merged, at.offset, (n + 1)::u64 * model.IMPORT_SIZE, Piece.imports{t});
}

# what each import address slot holds before the loader binds it into
# `out`, which the import lookup table holds too: the image offset of its
# hint/name entry, or the ordinal flag and its ordinal, every slot that
# closes a run zero
fun slot_values(b: *Build, im: *Imports, base: u64, out: *Table[u64]) err[Fail] {
    val count: usize = (im.slots / im.width)::usize;
    if (count != 0) {
        val g: res[Id[u64], Fail] = table.grow[u64](out, count);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    val flag: u64   = 1::u64 << (im.width * 8 - 1);
    var i:    usize = 0;
    for (i < table.count[Lookup](?im.lookups)) {
        val s: opt[*reserve.Slot] = reserve.slot_of(b.img.reserved, ?slot.IAT, i::u32);
        if (sel s.none) { ret err[Fail].err{fail.internal("an import takes no address slot")}; }
        val l: *Lookup = table.at[Lookup](?im.lookups, table.nth[Lookup](i));
        var v: u64     = 0;
        if (sel l.ordinal) { v = flag | l.ordinal::u64; }
        or (sel l.named)   { v = base + im.names + l.named.at; }
        table.items[u64](out)[(s.some.offset / im.width)::usize] = v;
        i                                                        = i + 1;
    }
    ret err[Fail].ok{};
}

# the hint/name entry of each import by name, each a hint, the name and a
# NUL, padded to an even length
fun names_tile(b: *Build, im: *Imports, at: Placed) err[Fail] {
    var out: Sink      = sink.make(b.a, LITTLE);
    var w:   err[Fail] = err[Fail].ok{};
    var i:   usize     = 0;
    for (sel w.ok && i < table.count[Lookup](?im.lookups)) {
        val l: *Lookup = table.at[Lookup](?im.lookups, table.nth[Lookup](i));
        i = i + 1;
        if (!sel l.named) { cnt; }
        if (sink.len(?out)::u64 != l.named.at) {
            w = err[Fail].err{fail.internal("a hint/name entry does not lie where the table was measured to put it")};
            brk;
        }
        w = sink.u16(?out, l.named.hint);
        w = fail.kept(w, sink.bytes(?out, l.named.name.data, l.named.name.len));
        w = fail.kept(w, sink.u8(?out, 0));
        if ((sink.len(?out) % 2) != 0) { w = fail.kept(w, sink.u8(?out, 0)); }
    }
    ret raw_tile(b, ?out, w, at.merged, at.offset + im.names, im.dlls - im.names);
}

# the name of each DLL by rank, each with its NUL
fun dlls_tile(b: *Build, im: *Imports, at: Placed) err[Fail] {
    val d:   *Dynamic  = b.img.dynamic;
    var out: Sink      = sink.make(b.a, LITTLE);
    var w:   err[Fail] = err[Fail].ok{};
    var i:   usize     = 0;
    for (sel w.ok && i < table.count[Run](?im.runs)) {
        val run:    *Run = table.at[Run](?im.runs, table.nth[Run](i));
        val loader: View = intern.bytes_of(b.img.names, table.at[dynamic.Library](?d.libraries, run.library).loader);
        w = sink.bytes(?out, loader.data, loader.len);
        w = fail.kept(w, sink.u8(?out, 0));
        i = i + 1;
    }
    ret raw_tile(b, ?out, w, at.merged, at.offset + im.dlls, im.size - im.dlls);
}

# the bytes `out` holds, which `w` wrote, as a piece at `offset` of the
# output section `merged` that takes `size` bytes, nothing when it is empty
fun raw_tile(b: *Build, out: *Sink, w: err[Fail], merged: Id[Merged], offset: u64, size: u64) err[Fail] {
    var held: res[Held, Fail] = res[Held, Fail].err{fail.internal("the table was not written")};
    if (sel w.ok) {
        if (sink.len(out)::u64 != size) { held = res[Held, Fail].err{fail.internal("a table is not the size it was measured to be")}; }
        or                              { held = model.own(?b.m, sink.data(out), sink.len(out)); }
    }
    val rel: err[Fail] = sink.release(out);
    if (sel w.err)    { ret w; }
    if (sel held.err) { ret err[Fail].err{held.err}; }
    if (sel rel.err)  { ret rel; }
    if (size == 0)    { ret err[Fail].ok{}; }
    ret tile(b, merged, offset, size, Piece.raw{Raw{bytes: held.ok, why: Why.opaque{}}});
}

# lay the piece `p` of `size` bytes at `offset` of the output section
# `merged`, which the build releases when no section takes it
fun tile(b: *Build, merged: Id[Merged], offset: u64, size: u64, p: Piece) err[Fail] {
    var held: Piece                = p;
    val at:   res[Id[Piece], Fail] = table.push[Piece](?b.pieces, held);
    if (sel at.err) {
        val dropped: err[Fail] = model.release_piece(?held);
        ret err[Fail].err{at.err};
    }
    val t: res[Id[Tile], Fail] = table.push[Tile](?b.tiles, Tile{merged: merged, offset: offset, size: size, piece: at.ok.index});
    if (sel t.err) { ret err[Fail].err{t.err}; }
    ret err[Fail].ok{};
}

fun order_tile(x: *Tile, y: *Tile) i64 {
    if (x.merged.index != y.merged.index) { ret order_u32(x.merged.index, y.merged.index); }
    if (x.offset < y.offset)              { ret -1; }
    if (x.offset > y.offset)              { ret 1; }
    ret 0;
}

# whether the writer lays a piece in output section `id`
fun tiled(b: *Build, id: Id[Merged]) bool {
    val at: opt[usize] = first_tile(b, id);
    ret sel at.some;
}

# the first tile of output section `id`, none when it has none
fun first_tile(b: *Build, id: Id[Merged]) opt[usize] {
    val n:  usize = table.count[Tile](?b.tiles);
    var lo: usize = 0;
    var hi: usize = n;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (table.items[Tile](?b.tiles)[mid].merged.index < id.index) { lo = mid + 1; }
        or                                                            { hi = mid; }
    }
    if (lo < n && table.items[Tile](?b.tiles)[lo].merged.index == id.index) { ret opt[usize].some{lo}; }
    ret opt[usize].none{};
}

# the bytes of output section `m`, `raw` in the file: the pieces the writer
# lays in it where they lie, the relocated bytes between them, then zeros
fun tiled_body(b: *Build, id: Id[Merged], m: *Merged, raw: u64) res[Body, Fail] {
    var tiles: Table[Piece] = table.make[Piece](b.a);
    val e:     err[Fail]    = tiles_of(b, id, m, ?tiles);
    var pad:   err[Fail]    = e;
    if (sel e.ok) { pad = padding(b, ?tiles, raw - m.size); }
    if (sel pad.err) {
        val dropped: err[Fail] = model.release_pieces(?tiles);
        ret res[Body, Fail].err{pad.err};
    }
    ret res[Body, Fail].ok{Body.tiled{tiles}};
}

fun tiles_of(b: *Build, id: Id[Merged], m: *Merged, out: *Table[Piece]) err[Fail] {
    val start: opt[usize] = first_tile(b, id);
    if (sel start.none) { ret err[Fail].err{fail.internal("an output section the writer lays pieces in holds none")}; }
    var cursor: u64   = 0;
    var i:      usize = start.some;
    for (i < table.count[Tile](?b.tiles) && table.items[Tile](?b.tiles)[i].merged.index == id.index) {
        val t: Tile = table.items[Tile](?b.tiles)[i];
        i = i + 1;
        if (t.offset < cursor || t.size > m.size || t.offset > m.size - t.size) { ret err[Fail].err{fail.internal("a table the writer lays overlaps what lies before it")}; }
        val g: err[Fail] = between(b, m, cursor, t.offset, out);
        if (sel g.err) { ret g; }
        val slot: *Piece               = table.at[Piece](?b.pieces, table.nth[Piece](t.piece::usize));
        val p:    res[Id[Piece], Fail] = table.push[Piece](out, @slot);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        @slot  = Piece.raw{Raw{bytes: Held.borrowed{Bytes{data: nil, len: 0}}, why: Why.opaque{}}};
        cursor = t.offset + t.size;
    }
    ret between(b, m, cursor, m.size, out);
}

# the relocated bytes of output section `m` from `from` to `to` as a piece
# into `out`, nothing when they are empty
fun between(b: *Build, m: *Merged, from: u64, to: u64, out: *Table[Piece]) err[Fail] {
    if (to == from) { ret err[Fail].ok{}; }
    val rel:   *Table[u8] = ?b.img.relocated.bytes;
    val start: u64        = m.offset + from;
    if (start > table.count[u8](rel)::u64 || to - from > table.count[u8](rel)::u64 - start) {
        ret err[Fail].err{fail.internal("an output section lies past the relocated bytes")};
    }
    val p: res[Id[Piece], Fail] = table.push[Piece](out, Piece.raw{Raw{bytes: Held.borrowed{Bytes{data: ?table.items[u8](rel)[start::usize], len: (to - from)::usize}}, why: Why.opaque{}}});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# whether a section the link keeps holds thread-local data
fun threaded(inputs: *Inputs, live: *Live) bool {
    var i: usize = 0;
    for (i < table.count[Ref](?live.kept)) {
        val at: Ref             = @table.at[Ref](?live.kept, table.nth[Ref](i));
        val o:  *Object         = input.object_of(inputs, at.input);
        val s:  *object.Section = object.section_at(o, at.section);
        if ((s.flags & section.TLS) != 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the definition of the name `text` an object input of the link holds, none
# when only a library or the link itself defines it, or nothing does
fun defined(names: *Interner, resolved: *Resolved, text: str) opt[resolve.Won] {
    val nm: opt[Id[Name]] = intern.find(names, text, str_len(text));
    if (sel nm.none) { ret opt[resolve.Won].none{}; }
    ret defined_name(resolved, nm.some);
}

# the definition of the link name `nm` an object input holds, as defined says
fun defined_name(resolved: *Resolved, nm: Id[Name]) opt[resolve.Won] {
    val w: opt[resolve.Won] = resolve.bound(resolved, nm);
    if (sel w.none)                                      { ret w; }
    if (resolve.library(resolved, w.some.binding.input)) { ret opt[resolve.Won].none{}; }
    ret w;
}

# whether the image supplies its own TLS directory: it holds thread-local
# data and no input defines _tls_used. a machine whose C symbols carry
# `prefix` is refused, as the link spells the names a CRT gives without one
fun supplies(inputs: *Inputs, names: *Interner, resolved: *Resolved, live: *Live, prefix: str) res[bool, Fail] {
    if (!threaded(inputs, live)) { ret res[bool, Fail].ok{false}; }
    if (str_len(prefix) != 0)    { ret res[bool, Fail].err{fail.about(fail.unsupported("a PE image whose C symbols carry a prefix does not hold thread-local data yet"), prefix)}; }
    val used: opt[resolve.Won] = defined(names, resolved, TLS_USED);
    ret res[bool, Fail].ok{sel used.none};
}

# the bytes a TLS directory of an image of layout `w` takes
fun directory_size(w: *Width) u64 {
    ret TLS_ADDRESSES * w.shape.addr::u64 + TLS_TAIL;
}

# the bytes the TLS directory of the image `img` takes
fun tls_directory(img: *Image) res[u64, Fail] {
    val w: res[*Width, Fail] = width_of(img.target.arch);
    if (sel w.err) { ret res[u64, Fail].err{w.err}; }
    ret res[u64, Fail].ok{directory_size(w.ok)};
}

# reserve the TLS directory in read-only data and the index cell in written
# data of an image that supplies its own
fun declare_tls(in: *reserve.In, out: *Reserved) err[Fail] {
    val pr: res[*Pair, Fail] = coff_pairs.of(in.arch);
    if (sel pr.err) { ret err[Fail].err{pr.err}; }
    val s: res[bool, Fail] = supplies(in.inputs, in.names, in.resolved, in.live, pr.ok.prefix);
    if (sel s.err) { ret err[Fail].err{s.err}; }
    if (!s.ok)     { ret err[Fail].ok{}; }
    val p: opt[u8] = arch.pointer_bytes(in.arch);
    if (sel p.none) { ret err[Fail].err{fail.about(fail.unsupported("the architecture states no address width"), in.arch.name)}; }
    val rdata: res[str, Fail] = naming.name_of(section.Key{kind: ?section.RODATA});
    if (sel rdata.err) { ret err[Fail].err{rdata.err}; }
    val data: res[str, Fail] = naming.name_of(section.Key{kind: ?section.DATA});
    if (sel data.err) { ret err[Fail].err{data.err}; }
    val d: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
        name:      rdata.ok,
        kind:      ?section.RODATA,
        flags:     section.ALLOC,
        align:     p.some::u64,
        sizing:    reserve.Sizing.measured{?TLS_DIRECTORY},
        placement: reserve.Placement.region_end{?reserve.CONST_END},
        limit:     0xffff_ffff,
        reason:    "the TLS directory passes 4 GiB",
    });
    if (sel d.err) { ret err[Fail].err{d.err}; }
    val c: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
        name:      data.ok,
        kind:      ?section.DATA,
        flags:     section.ALLOC | section.WRITE,
        align:     TLS_CELL_SIZE,
        sizing:    reserve.Sizing.fixed{TLS_CELL_SIZE},
        placement: reserve.Placement.region_end{?reserve.DATA_END},
        limit:     0xffff_ffff,
        reason:    "the TLS index cell passes 4 GiB",
        anchor:    opt[*Anchor].some{?TLS_INDEX},
    });
    if (sel c.err) { ret err[Fail].err{c.err}; }
    ret err[Fail].ok{};
}

# the addresses of the TLS directory the image `img` of layout `w` reserved
# into `out`, each a base relocation site, nothing when it reserved none
fun tls_sites(img: *Image, w: *Width, out: *Table[u64]) err[Fail] {
    val t: opt[Id[Reservation]] = measured_of(img, ?TLS_DIRECTORY);
    if (sel t.none) { ret err[Fail].ok{}; }
    val p: res[Placed, Fail] = placed_of(img, t.some);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    val at:    Location       = Location{record: "TLS directory"};
    val start: res[u64, Fail] = checked.add(at, table.at[Merged](?img.layout.merged, p.ok.merged).address, p.ok.offset);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    var k: u64 = 0;
    for (k < TLS_ADDRESSES) {
        val r: res[Id[u64], Fail] = table.push[u64](out, start.ok + k * w.shape.addr::u64);
        if (sel r.err) { ret err[Fail].err{r.err}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the address of the name `text` in the image `img`: an object input's
# definition or the link's own
fun named_address(img: *Image, text: str) res[u64, Fail] {
    val missing: Fail          = fail.about(fail.malformed("the image does not define a name its TLS directory names"), text);
    val nm:      opt[Id[Name]] = intern.find(img.names, text, str_len(text));
    if (sel nm.none) { ret res[u64, Fail].err{missing}; }
    ret address_of(img, nm.some, missing);
}

# the address of the link name `nm`, `missing` when the image gives it none
fun address_of(img: *Image, nm: Id[Name], missing: Fail) res[u64, Fail] {
    val w: opt[resolve.Won] = resolve.bound(img.resolved, nm);
    if (sel w.some) {
        if (resolve.library(img.resolved, w.some.binding.input)) { ret res[u64, Fail].err{missing}; }
        val v: opt[u64] = layout.value_of(img.layout, w.some.binding.input, w.some.binding.symbol);
        if (sel v.none) { ret res[u64, Fail].err{missing}; }
        ret res[u64, Fail].ok{v.some};
    }
    val l: opt[u64] = layout.linked_value(img.layout, img.resolved, nm);
    if (sel l.none) { ret res[u64, Fail].err{missing}; }
    ret res[u64, Fail].ok{l.some};
}

# the thread-local template of an image
# ---
# start: where it starts
# end:   where its bytes in the file end
# zero:  the bytes of zero fill past them
# align: its alignment
rec Template {
    start: u64;
    end:   u64;
    zero:  u32;
    align: u64;
}

# the template of the laid out image: its one output section of thread-local
# data, whose bytes up to the end of the last byte an input or table states
# are the template, and whose zeros past them are its zero fill
fun template_of(b: *Build) res[Template, Fail] {
    val l:     *Layout = b.img.layout;
    var count: usize   = 0;
    var found: usize   = 0;
    var i:     usize   = 0;
    for (i < table.count[Merged](?l.merged)) {
        if ((table.at[Merged](?l.merged, table.nth[Merged](i)).flags & section.TLS) != 0) {
            count = count + 1;
            found = i;
        }
        i = i + 1;
    }
    if (count > 1)  { ret res[Template, Fail].err{fail.unsupported("an image holds thread-local data in two output sections")}; }
    if (count == 0) { ret res[Template, Fail].err{fail.internal("an image with a thread-local block holds no output section of thread-local data")}; }
    val m:    *Merged        = table.at[Merged](?l.merged, table.nth[Merged](found));
    val init: res[u64, Fail] = initialized_end(b.img, found::u32, m);
    if (sel init.err) { ret res[Template, Fail].err{init.err}; }
    val zero: res[u32, Fail] = narrow(m.size - init.ok, "output section", m.position::u64);
    if (sel zero.err) { ret res[Template, Fail].err{zero.err}; }
    val end: res[u64, Fail] = checked.add(Location{record: "TLS directory"}, m.address, init.ok);
    if (sel end.err) { ret res[Template, Fail].err{end.err}; }
    ret res[Template, Fail].ok{Template{start: m.address, end: end.ok, zero: zero.ok, align: m.align}};
}

# the end, from its start, of the last byte of output section `m`, of index
# `merged`, that an input section or a reserved table states rather than
# leaves as zero fill
fun initialized_end(img: *Image, merged: u32, m: *Merged) res[u64, Fail] {
    val l:   *Layout = img.layout;
    var end: u64     = 0;
    var i:   usize   = 0;
    for (i < table.count[Landing](?l.landings)) {
        val g: *Landing = table.at[Landing](?l.landings, table.nth[Landing](i));
        i = i + 1;
        if (g.merged.index != merged) { cnt; }
        val s: *object.Section = object.section_at(input.object_of(img.inputs, g.at.input), g.at.section);
        if (sel s.contents.zero)     { cnt; }
        if (g.offset + g.size > end) { end = g.offset + g.size; }
    }
    var k: usize = 0;
    for (k < table.count[Spot](?l.tables)) {
        val sp: Spot = table.items[Spot](?l.tables)[k];
        if (sel sp.section) {
            val stop: u64 = sp.section.offset + table.at[Reservation](?img.reserved.tables, table.nth[Reservation](k)).size;
            if (sp.section.merged.index == merged && stop > end) { end = stop; }
        }
        k = k + 1;
    }
    if (end > m.size) { ret res[u64, Fail].err{fail.internal("thread-local data lies past its output section")}; }
    ret res[u64, Fail].ok{end};
}

# the TLS directory of an image that holds thread-local data and the data
# directory naming it: the definition of _tls_used an input holds, its
# characteristics stating the template's alignment, or else the table the
# image reserved
fun tls_out(b: *Build) err[Fail] {
    val held: opt[layout.Tls] = b.img.layout.tls;
    if (sel held.none) { ret err[Fail].ok{}; }
    val t: res[Template, Fail] = template_of(b);
    if (sel t.err) { ret err[Fail].err{t.err}; }
    val used: opt[resolve.Won] = defined(b.img.names, b.img.resolved, TLS_USED);
    var e:    err[Fail]        = err[Fail].ok{};
    if (sel used.some) { e = supplied_out(b, used.some.binding, t.ok); }
    or                 { e = reserved_out(b, t.ok); }
    if (sel e.err)     { ret err[Fail].err{fail.in_record(e.err, "TLS directory")}; }
    ret err[Fail].ok{};
}

# the TLS directory the image reserved, naming the template `t`, the index
# cell and the callbacks past the first bound of their array
fun reserved_out(b: *Build, t: Template) err[Fail] {
    val r: opt[Id[Reservation]] = measured_of(b.img, ?TLS_DIRECTORY);
    if (sel r.none) { ret err[Fail].err{fail.internal("the image reserved no TLS directory")}; }
    val size: u64 = directory_size(b.width);
    if (table.at[Reservation](?b.img.reserved.tables, r.some).size != size) { ret err[Fail].err{fail.internal("the TLS directory is not the size layout left for it")}; }
    val at: res[Placed, Fail] = placed_of(b.img, r.some);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val rva: res[u32, Fail] = spanned(b, at.ok, size, "TLS directory");
    if (sel rva.err) { ret err[Fail].err{rva.err}; }
    val index: res[u64, Fail] = named_address(b.img, TLS_CELL);
    if (sel index.err) { ret err[Fail].err{index.err}; }
    val first: res[u64, Fail] = named_address(b.img, TLS_FIRST);
    if (sel first.err) { ret err[Fail].err{first.err}; }
    val callbacks: res[u64, Fail] = checked.add(Location{record: "TLS directory"}, first.ok, b.width.shape.addr::u64);
    if (sel callbacks.err) { ret err[Fail].err{callbacks.err}; }
    val field: res[u64, Fail] = align_field(t.align);
    if (sel field.err) { ret err[Fail].err{field.err}; }
    val d: Tls       = Tls{raw_start: t.start, raw_end: t.end, index_address: index.ok, callbacks: callbacks.ok, zero_fill: t.zero, characteristics: field.ok::u32};
    val w: err[Fail] = tile(b, at.ok.merged, at.ok.offset, size, Piece.tls{d});
    if (sel w.err) { ret w; }
    b.tls = DataDirectory{rva: rva.ok, size: size::u32};
    ret err[Fail].ok{};
}

# the TLS directory the input definition `bn` of _tls_used holds, as it
# holds it but for its characteristics, which state the alignment of the
# template `t`
fun supplied_out(b: *Build, bn: *Binding, t: Template) err[Fail] {
    val img: *Image  = b.img;
    val o:   *Object = input.object_of(img.inputs, bn.input);
    val sym: *Symbol = object.symbol_at(o, bn.symbol);
    if (!sel sym.def.placed) { ret err[Fail].err{fail.about(fail.malformed("the TLS directory an input defines lies in no section"), TLS_USED)}; }
    val pos: res[opt[layout.Position], Fail] = layout.locate(img.layout, img.pieces, Ref{input: bn.input, section: sym.def.placed.section}, sym.def.placed.offset);
    if (sel pos.err)     { ret err[Fail].err{pos.err}; }
    if (sel pos.ok.none) { ret err[Fail].err{fail.about(fail.malformed("the TLS directory an input defines lies in no output section"), TLS_USED)}; }
    val p:    layout.Position = pos.ok.some;
    val size: u64             = directory_size(b.width);
    val m:    *Merged         = table.at[Merged](?img.layout.merged, p.merged);
    if (!section.has(m.kind, section.BITS) || p.offset > m.size || size > m.size - p.offset) {
        ret err[Fail].err{fail.about(fail.malformed("the TLS directory an input defines passes the bytes of its section"), TLS_USED)};
    }
    val rel: *Table[u8] = ?img.relocated.bytes;
    if (p.file > table.count[u8](rel)::u64 || size > table.count[u8](rel)::u64 - p.file) { ret err[Fail].err{fail.internal("a TLS directory lies past the relocated bytes")}; }
    val rva: res[u32, Fail] = spanned(b, Placed{merged: p.merged, offset: p.offset}, size, "TLS directory");
    if (sel rva.err) { ret err[Fail].err{rva.err}; }
    var r: Reader    = reader.make("TLS directory", ?table.items[u8](rel)[p.file::usize], size::usize, LITTLE);
    var d: Tls       = Tls{};
    val e: err[Fail] = directory_read(?r, b.width.shape.addr, ?d);
    if (sel e.err) { ret e; }
    val field: res[u64, Fail] = align_field(t.align);
    if (sel field.err) { ret err[Fail].err{field.err}; }
    d.characteristics = ((d.characteristics::u64 & ~tables.SCN_ALIGN_MASK.value) | field.ok)::u32;
    val w: err[Fail] = tile(b, p.merged, p.offset, size, Piece.tls{d});
    if (sel w.err) { ret w; }
    b.tls = DataDirectory{rva: rva.ok, size: size::u32};
    ret err[Fail].ok{};
}

# the TLS directory at `r`, its addresses `width` bytes wide, into `out`
fun directory_read(r: *Reader, width: usize, out: *Tls) err[Fail] {
    val start: res[u64, Fail] = reader.uint(r, width);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    val end: res[u64, Fail] = reader.uint(r, width);
    if (sel end.err) { ret err[Fail].err{end.err}; }
    val index: res[u64, Fail] = reader.uint(r, width);
    if (sel index.err) { ret err[Fail].err{index.err}; }
    val callbacks: res[u64, Fail] = reader.uint(r, width);
    if (sel callbacks.err) { ret err[Fail].err{callbacks.err}; }
    val zero: res[u32, Fail] = reader.u32(r);
    if (sel zero.err) { ret err[Fail].err{zero.err}; }
    val ch: res[u32, Fail] = reader.u32(r);
    if (sel ch.err) { ret err[Fail].err{ch.err}; }
    @out = Tls{raw_start: start.ok, raw_end: end.ok, index_address: index.ok, callbacks: callbacks.ok, zero_fill: zero.ok, characteristics: ch.ok};
    ret err[Fail].ok{};
}

# the .CRT$XLA and .CRT$XLZ bounds of the callback array of an image that
# supplies its own TLS directory, each a null pointer named as a CRT names it
fun callback_bounds(c: *Context, o: *Object) res[bool, Fail] {
    val s: res[bool, Fail] = supplies(c.inputs, c.names, c.resolved, c.live, c.pair.prefix);
    if (sel s.err) { ret s; }
    if (!s.ok)     { ret res[bool, Fail].ok{false}; }
    val p: opt[u8] = arch.pointer_bytes(c.target.arch);
    if (sel p.none)                        { ret res[bool, Fail].err{fail.about(fail.unsupported("the architecture states no address width"), c.target.arch.name)}; }
    if (p.some::usize > NULL_POINTER_SIZE) { ret res[bool, Fail].err{fail.internal("an address is wider than the null pointer the link holds")}; }
    val kept: err[Fail] = callbacks_bounded(c.inputs, c.live);
    if (sel kept.err) { ret res[bool, Fail].err{kept.err}; }
    val first: err[Fail] = null_bound(o, TLS_FIRST_SECTION, TLS_FIRST, p.some::u64);
    if (sel first.err) { ret res[bool, Fail].err{first.err}; }
    val last: err[Fail] = null_bound(o, TLS_LAST_SECTION, TLS_LAST, p.some::u64);
    if (sel last.err) { ret res[bool, Fail].err{last.err}; }
    ret res[bool, Fail].ok{true};
}

# refuse a callback section the link keeps that is not read-only data, as
# the bounds are, since it would lie in another output section, outside the
# array they close
fun callbacks_bounded(inputs: *Inputs, live: *Live) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Ref](?live.kept)) {
        val at: Ref             = @table.at[Ref](?live.kept, table.nth[Ref](i));
        val o:  *Object         = input.object_of(inputs, at.input);
        val s:  *object.Section = object.section_at(o, at.section);
        i = i + 1;
        val v: res[View, Fail] = object.section_name(o, s, coff_convention.LAYOUT.naming);
        if (sel v.err)                                                                      { ret err[Fail].err{v.err}; }
        if (!starts_with(v.ok, TLS_CALLBACKS) || section.joined(s.kind) == ?section.RODATA) { cnt; }
        ret err[Fail].err{fail.in_file(fail.unsupported("a thread-local callback section is not read-only data, so it lies outside the bounds of the callback array"), input.at(inputs, at.input).name)};
    }
    ret err[Fail].ok{};
}

fun starts_with(v: View, prefix: str) bool {
    val n: usize = str_len(prefix);
    if (v.len < n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a section of `o` named `section_name` holding a null pointer of `width`
# bytes, which the symbol `name` defines
fun null_bound(o: *Object, section_name: str, name: str, width: u64) err[Fail] {
    val sn: res[Id[Name], Fail] = object.name_str(o, section_name);
    if (sel sn.err) { ret err[Fail].err{sn.err}; }
    val held: res[object.Contents, Fail] = object.own(o, ?NULL_POINTER[0], width::usize);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    val sec: res[Id[object.Section], Fail] = object.add_section(o, object.Section{
        name:        opt[Id[Name]].some{sn.ok},
        kind:        ?section.RODATA,
        flags:       section.RODATA.flags,
        align:       width,
        contents:    held.ok,
        disposition: ?section.ROOT,
    });
    if (sel sec.err) { ret err[Fail].err{sec.err}; }
    val nm: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel nm.err) { ret err[Fail].err{nm.err}; }
    val sym: res[Id[Symbol], Fail] = object.add_symbol(o, Symbol{
        name:       nm.ok,
        binding:    ?symbol.GLOBAL,
        visibility: ?symbol.DEFAULT,
        kind:       ?symbol.DATA,
        def:        Definition.placed{object.Place{section: sec.ok, offset: 0}},
        size:       object.sized(width),
    });
    if (sel sym.err) { ret err[Fail].err{sym.err}; }
    ret err[Fail].ok{};
}

# reserve .rsrc, the resource tree, at the end of the read-only data of an
# image whose inputs carry resources
fun declare_resources(in: *reserve.In, out: *Reserved) err[Fail] {
    if (!resource.holds(in.inputs, in.resolved)) { ret err[Fail].ok{}; }
    val name: res[str, Fail] = naming.name_of(section.Key{kind: ?section.RESOURCE_TREE});
    if (sel name.err) { ret err[Fail].err{name.err}; }
    val d: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
        name:      name.ok,
        kind:      ?section.RODATA,
        flags:     section.ALLOC,
        align:     resource.DATA_ALIGN,
        sizing:    reserve.Sizing.measured{?RESOURCES},
        placement: reserve.Placement.region_end{?reserve.CONST_END},
        limit:     0xffff_ffff,
        reason:    "the resource tree passes 4 GiB",
    });
    if (sel d.err) { ret err[Fail].err{d.err}; }
    ret err[Fail].ok{};
}

# the bytes the resource tree of the image `img` takes
fun resource_tree(img: *Image) res[u64, Fail] {
    val t: res[resource.Tree, Fail] = resource.build(img.inputs.a, img.inputs, img.resolved);
    if (sel t.err) { ret res[u64, Fail].err{t.err}; }
    var got:  resource.Tree = t.ok;
    val size: u64           = resource.size(?got);
    val rel:  err[Fail]     = resource.release(?got);
    if (sel rel.err) { ret res[u64, Fail].err{rel.err}; }
    ret res[u64, Fail].ok{size};
}

# the resource tree the image reserved, as a piece of .rsrc, and the
# resource directory naming it, nothing for an image that reserved none
fun resources_out(b: *Build) err[Fail] {
    val r: opt[Id[Reservation]] = measured_of(b.img, ?RESOURCES);
    if (sel r.none) { ret err[Fail].ok{}; }
    val at: res[Placed, Fail] = placed_of(b.img, r.some);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val size: u64            = table.at[Reservation](?b.img.reserved.tables, r.some).size;
    val rva:  res[u32, Fail] = spanned(b, at.ok, size, "resource tree");
    if (sel rva.err) { ret err[Fail].err{rva.err}; }
    val t: res[resource.Tree, Fail] = resource.build(b.a, b.img.inputs, b.img.resolved);
    if (sel t.err) { ret err[Fail].err{t.err}; }
    var tree: resource.Tree = t.ok;
    var out:  Sink          = sink.make(b.a, LITTLE);
    val w:    err[Fail]     = resource.write(?tree, rva.ok::u64, ?out);
    val rel:  err[Fail]     = resource.release(?tree);
    val e:    err[Fail]     = raw_tile(b, ?out, w, at.ok.merged, at.ok.offset, size);
    if (sel e.err)   { ret err[Fail].err{fail.in_record(e.err, "resource tree")}; }
    if (sel rel.err) { ret rel; }
    b.resources = DataDirectory{rva: rva.ok, size: size::u32};
    ret err[Fail].ok{};
}

# reserve .edata, the export table, at the end of the read-only data of a DLL
# whose inputs state exports
fun declare_exports(in: *reserve.In, out: *Reserved) err[Fail] {
    if (!output.has(in.kind, output.EXPORTS) || !coff_export.declared(in.inputs, in.resolved)) { ret err[Fail].ok{}; }
    val d: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
        name:      EDATA,
        kind:      ?section.RODATA,
        flags:     section.ALLOC,
        align:     EXPORT_ALIGN,
        sizing:    reserve.Sizing.measured{?EXPORT_TABLE},
        placement: reserve.Placement.region_end{?reserve.CONST_END},
        limit:     0xffff_ffff,
        reason:    "the export table passes 4 GiB",
    });
    if (sel d.err) { ret err[Fail].err{d.err}; }
    ret err[Fail].ok{};
}

# the exports of the DLL `img`, which is named by the file it is written to
fun exports_of(img: *Image) res[Exports, Fail] {
    val dll: res[View, Fail] = link_image.file_name(img);
    if (sel dll.err) { ret res[Exports, Fail].err{dll.err}; }
    val pr: res[*Pair, Fail] = coff_pairs.of(img.target.arch);
    if (sel pr.err) { ret res[Exports, Fail].err{pr.err}; }
    ret coff_export.of(img.inputs.a, img.inputs, img.names, img.resolved, pr.ok.prefix, dll.ok);
}

# the bytes the export table of the image `img` takes
fun export_table(img: *Image) res[u64, Fail] {
    val e: res[Exports, Fail] = exports_of(img);
    if (sel e.err) { ret res[u64, Fail].err{e.err}; }
    var got:  Exports   = e.ok;
    val size: u64       = got.size;
    val rel:  err[Fail] = coff_export.release(?got);
    if (sel rel.err) { ret res[u64, Fail].err{rel.err}; }
    ret res[u64, Fail].ok{size};
}

# the export table the image reserved, as pieces of .edata, and the export
# directory naming it, nothing for an image that reserved none
fun exports_out(b: *Build) err[Fail] {
    val r: opt[Id[Reservation]] = measured_of(b.img, ?EXPORT_TABLE);
    if (sel r.none) { ret err[Fail].ok{}; }
    val e: res[Exports, Fail] = exports_of(b.img);
    if (sel e.err) { ret err[Fail].err{e.err}; }
    var got: Exports   = e.ok;
    val w:   err[Fail] = exports_tiled(b, r.some, ?got);
    val rel: err[Fail] = coff_export.release(?got);
    if (sel w.err)   { ret err[Fail].err{fail.in_record(w.err, "export table")}; }
    if (sel rel.err) { ret rel; }
    ret err[Fail].ok{};
}

fun exports_tiled(b: *Build, r: Id[Reservation], e: *Exports) err[Fail] {
    if (table.at[Reservation](?b.img.reserved.tables, r).size != e.size) { ret err[Fail].err{fail.internal("the export table is not the size layout left for it")}; }
    if (e.size == 0)                                                     { ret err[Fail].ok{}; }
    val at: res[Placed, Fail] = placed_of(b.img, r);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val home: res[u32, Fail] = spanned(b, at.ok, e.size, "export table");
    if (sel home.err) { ret err[Fail].err{home.err}; }
    val base: u32             = home.ok;
    val dir:  ExportDirectory = ExportDirectory{
        name_rva:       base + e.dll_at::u32,
        ordinal_base:   e.base::u32,
        address_count:  e.slots,
        name_count:     e.named,
        address_rva:    base + e.addresses::u32,
        name_rva_table: base + e.pointers::u32,
        ordinal_rva:    base + e.ordinals::u32,
    };
    val d: err[Fail] = tile(b, at.ok.merged, at.ok.offset, model.EXPORT_SIZE, Piece.exports{dir});
    if (sel d.err) { ret d; }
    val a: err[Fail] = addresses_tile(b, e, at.ok, base);
    if (sel a.err) { ret a; }
    val n: err[Fail] = name_tables_tile(b, e, at.ok, base);
    if (sel n.err) { ret n; }
    ret strings_tile(b, e, at.ok);
}

# the export address table: per ordinal from the lowest, the offset from the
# image base of what its export exports, or of its forwarder's text in the
# table at `base`, zero for an ordinal no export takes
fun addresses_tile(b: *Build, e: *Exports, at: Placed, base: u32) err[Fail] {
    var words: Table[u32]         = table.make[u32](b.a);
    val g:     res[Id[u32], Fail] = table.grow[u32](?words, e.slots::usize);
    var w:     err[Fail]          = err[Fail].ok{};
    if (sel g.err) { w = err[Fail].err{g.err}; }
    var i: usize = 0;
    for (sel w.ok && i < table.count[Export](?e.list)) {
        val x: *Export        = table.at[Export](?e.list, table.nth[Export](i));
        val v: res[u32, Fail] = exported_rva(b, x, base);
        i = i + 1;
        if (sel v.err) { w = err[Fail].err{fail.valued(v.err, x.ordinal::i128)}; }
        or             { table.items[u32](?words)[(x.ordinal - e.base)::usize] = v.ok; }
    }
    if (sel w.err) {
        val dropped: err[Fail] = table.release[u32](?words);
        ret w;
    }
    ret tile(b, at.merged, at.offset + e.addresses, e.slots::u64 * 4, Piece.export_words{words});
}

# the offset from the image base of what the export `x` exports, a
# forwarder's being that of its text in the table at `base`
fun exported_rva(b: *Build, x: *Export, base: u32) res[u32, Fail] {
    val t: coff_export.Target = x.target;
    if (sel t.forward) { ret res[u32, Fail].ok{base + x.forward_at::u32}; }
    val bn: *Binding = table.at[Binding](?b.img.resolved.bindings, t.bound);
    val v:  opt[u64] = layout.value_of(b.img.layout, bn.input, bn.symbol);
    if (sel v.none) { ret res[u32, Fail].err{fail.malformed("an exported definition lies nowhere in the image")}; }
    val at: res[u64, Fail] = forwarded(b.img, v.some);
    if (sel at.err) { ret res[u32, Fail].err{at.err}; }
    ret rva_of(b, at.ok, "export", x.ordinal::u64);
}

# the name pointer table and the ordinal table: per export found by name, in
# name order, the offset of its name from the image base and its slot in the
# export address table
fun name_tables_tile(b: *Build, e: *Exports, at: Placed, base: u32) err[Fail] {
    if (e.named == 0) { ret err[Fail].ok{}; }
    var pointers: Table[u32] = table.make[u32](b.a);
    var slots:    Table[u16] = table.make[u16](b.a);
    var w:        err[Fail]  = table.reserve[u32](?pointers, e.named::usize);
    var i:        usize      = 0;
    for (sel w.ok && i < table.count[Export](?e.list)) {
        val x: *Export = table.at[Export](?e.list, table.nth[Export](i));
        i = i + 1;
        if (x.noname) { cnt; }
        val p: res[Id[u32], Fail] = table.push[u32](?pointers, base + x.name_at::u32);
        if (sel p.err) { w = err[Fail].err{p.err}; }
        or {
            val s: res[Id[u16], Fail] = table.push[u16](?slots, x.ordinal - e.base);
            if (sel s.err) { w = err[Fail].err{s.err}; }
        }
    }
    if (sel w.err) {
        val dropped: err[Fail] = fail.kept(table.release[u32](?pointers), table.release[u16](?slots));
        ret w;
    }
    val tp: err[Fail] = tile(b, at.merged, at.offset + e.pointers, e.named::u64 * 4, Piece.export_words{pointers});
    if (sel tp.err) {
        val dropped: err[Fail] = table.release[u16](?slots);
        ret tp;
    }
    ret tile(b, at.merged, at.offset + e.ordinals, e.named::u64 * 2, Piece.ordinals{slots});
}

# the names of the exports found by name, in name order, the DLL's name and
# the forwarders' texts, each with its NUL
fun strings_tile(b: *Build, e: *Exports, at: Placed) err[Fail] {
    var out: Sink      = sink.make(b.a, LITTLE);
    val w:   err[Fail] = strings_of(e, ?out);
    ret raw_tile(b, ?out, w, at.merged, at.offset + e.names, e.size - e.names);
}

fun strings_of(e: *Exports, out: *Sink) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Export](?e.list)) {
        val x: *Export = table.at[Export](?e.list, table.nth[Export](i));
        i = i + 1;
        if (x.noname) { cnt; }
        val w: err[Fail] = text_at(out, e.names, x.name_at, x.name);
        if (sel w.err) { ret w; }
    }
    val d: err[Fail] = text_at(out, e.names, e.dll_at, e.dll);
    if (sel d.err) { ret d; }
    i = 0;
    for (i < table.count[Export](?e.list)) {
        val x: *Export            = table.at[Export](?e.list, table.nth[Export](i));
        val t: coff_export.Target = x.target;
        i = i + 1;
        if (sel t.forward) {
            val w: err[Fail] = text_at(out, e.names, x.forward_at, t.forward);
            if (sel w.err) { ret w; }
        }
    }
    ret err[Fail].ok{};
}

# the text `v` and its NUL into `out`, whose bytes start `start` into the
# table, at `offset` into it
fun text_at(out: *Sink, start: u64, offset: u64, v: View) err[Fail] {
    if (start + sink.len(out)::u64 != offset) { ret err[Fail].err{fail.internal("a text of the export table does not lie where the table was measured to put it")}; }
    val w: err[Fail] = sink.bytes(out, v.data, v.len);
    if (sel w.err) { ret w; }
    ret sink.u8(out, 0);
}

# the import library of the DLL `img`: a short import object for each of its
# exports an import library does not leave out, one found by name naming its
# hint, its index in the name pointer table, and one found by ordinal alone
# naming its ordinal
fun import_library(a: *A.Allocator, img: *Image) res[Sink, Fail] {
    val mc: res[u16, Fail] = machine_of(img.target.arch);
    if (sel mc.err) { ret res[Sink, Fail].err{mc.err}; }
    val e: res[Exports, Fail] = exports_of(img);
    if (sel e.err) { ret res[Sink, Fail].err{e.err}; }
    var got:   Exports                   = e.ok;
    var items: Table[coff_import.Export] = table.make[coff_import.Export](a);
    var out:   res[Sink, Fail]           = res[Sink, Fail].err{fail.internal("the import library was not written")};
    val made:  err[Fail]                 = library_exports(?got, ?items);
    if (sel made.err) { out = res[Sink, Fail].err{made.err}; }
    or {
        val dll: Bytes = Bytes{data: got.dll.data, len: got.dll.len};
        out = implib.build(a, mc.ok, dll, table.items[coff_import.Export](?items), table.count[coff_import.Export](?items));
    }
    val rel: err[Fail] = fail.kept(table.release[coff_import.Export](?items), coff_export.release(?got));
    if (sel out.err) { ret out; }
    if (sel rel.err) {
        var lost:    Sink      = out.ok;
        val dropped: err[Fail] = sink.release(?lost);
        ret res[Sink, Fail].err{rel.err};
    }
    ret out;
}

# the export each export of `e` an import library does not leave out is to
# an import library, into `out`
fun library_exports(e: *Exports, out: *Table[coff_import.Export]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Export](?e.list)) {
        val x: *Export = table.at[Export](?e.list, table.nth[Export](i));
        i = i + 1;
        if (x.private) { cnt; }
        var kind: u64 = tables.IMPORT_OBJECT_CODE.value;
        if (x.data) { kind = tables.IMPORT_OBJECT_DATA.value; }
        var by:   u64 = tables.IMPORT_OBJECT_NAME.value;
        var hint: u16 = x.hint;
        if (x.noname) {
            by   = tables.IMPORT_OBJECT_ORDINAL.value;
            hint = x.ordinal;
        }
        val p: res[Id[coff_import.Export], Fail] = table.push[coff_import.Export](out, coff_import.Export{
            name:      Bytes{data: x.name.data, len: x.name.len},
            ordinal:   hint,
            kind:      kind::u16,
            name_type: by::u16,
            export_as: opt[Bytes].none{},
        });
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    ret err[Fail].ok{};
}

# the address of the reserved table `t`
fun table_address(img: *Image, t: Id[Reservation]) res[u64, Fail] {
    val p: res[Placed, Fail] = placed_of(img, t);
    if (sel p.err) { ret res[u64, Fail].err{p.err}; }
    ret checked.add(Location{record: "reserved table"}, table.at[Merged](?img.layout.merged, p.ok.merged).address, p.ok.offset);
}

# the address of the table anchored by `key`, none where the image reserved
# none
fun anchored_address(img: *Image, key: *Anchor) res[opt[u64], Fail] {
    val t: opt[Id[Reservation]] = reserve.anchored(img.reserved, key);
    if (sel t.none) { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    val a: res[u64, Fail] = table_address(img, t.some);
    if (sel a.err) { ret res[opt[u64], Fail].err{a.err}; }
    ret res[opt[u64], Fail].ok{opt[u64].some{a.ok}};
}

# the address of the auxiliary import address table, zero where the image
# imports nothing
fun aux_address(img: *Image) res[u64, Fail] {
    val t: opt[Id[Reservation]] = img.reserved.held[slot.AUX_IAT.at::usize];
    if (sel t.none) { ret res[u64, Fail].ok{0}; }
    ret table_address(img, t.some);
}

# the native function table of an ARM64EC image, its address and bytes, zero
# where it holds none
rec Rfe {
    address: u64;
    size:    u64;
}

fun rfe_of(img: *Image) Rfe {
    val l: *Layout = img.layout;
    var i: usize   = 0;
    for (i < table.count[Id[Merged]](?l.order)) {
        val m: *Merged = table.at[Merged](?l.merged, table.items[Id[Merged]](?l.order)[i]);
        i = i + 1;
        if (!kept(m) || m.kind != ?section.FUNCTION_TABLE) { cnt; }
        if (coff_hybrid.x64_functions(img, m))             { cnt; }
        ret Rfe{address: m.address, size: m.size};
    }
    ret Rfe{};
}

# the base relocation sites of the ARM64EC tables of `img`: each auxiliary
# import address and its copy that holds an import check's address, and the
# metadata pointer of the load configuration the link lays
fun hybrid_sites(img: *Image, out: *Table[u64]) err[Fail] {
    val t: opt[Id[Reservation]] = reserve.anchored(img.reserved, ?coff_hybrid.METADATA);
    if (sel t.none) { ret err[Fail].ok{}; }
    val base: res[u64, Fail] = table_address(img, t.some);
    if (sel base.err) { ret err[Fail].err{base.err}; }
    var p: coff_hybrid.Plan = coff_hybrid.make_plan(img);
    val e: err[Fail]        = coff_hybrid.plan(img, ?p);
    var w: err[Fail]        = e;
    if (sel e.ok) { w = aux_sites(img, ?p, base.ok, out); }
    w = fail.kept(w, coff_hybrid.release(?p));
    if (sel w.err) { ret w; }
    val lc: res[opt[u64], Fail] = anchored_address(img, ?coff_hybrid.LOAD_CONFIG);
    if (sel lc.err)     { ret err[Fail].err{lc.err}; }
    if (sel lc.ok.none) { ret err[Fail].ok{}; }
    val r: res[Id[u64], Fail] = table.push[u64](out, lc.ok.some + coff_hybrid.CHPE_POINTER);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

fun aux_sites(img: *Image, p: *coff_hybrid.Plan, base: u64, out: *Table[u64]) err[Fail] {
    val aux: res[u64, Fail] = aux_address(img);
    if (sel aux.err) { ret err[Fail].err{aux.err}; }
    var k: usize = 0;
    for (k < table.count[u64](?p.exits)) {
        val exit: u64 = table.items[u64](?p.exits)[k];
        k = k + 1;
        if (exit == 0) { cnt; }
        val s: opt[*reserve.Slot] = reserve.slot_of(img.reserved, ?slot.AUX_IAT, (k - 1)::u32);
        if (sel s.none) { ret err[Fail].err{fail.internal("an import takes no auxiliary address slot")}; }
        val a: res[Id[u64], Fail] = table.push[u64](out, aux.ok + s.some.offset);
        if (sel a.err) { ret err[Fail].err{a.err}; }
        val c: res[Id[u64], Fail] = table.push[u64](out, base + p.copy + s.some.offset);
        if (sel c.err) { ret err[Fail].err{c.err}; }
    }
    ret err[Fail].ok{};
}

# the ARM64EC tables of an image that holds them: the metadata block, the
# auxiliary import address table, the fast-forward sequences, the import
# checks and the link's load configuration, and the load configuration
# directory
fun hybrid_out(b: *Build) err[Fail] {
    val img: *Image               = b.img;
    val t:   opt[Id[Reservation]] = reserve.anchored(img.reserved, ?coff_hybrid.METADATA);
    if (sel t.none) { ret err[Fail].ok{}; }
    var p: coff_hybrid.Plan = coff_hybrid.make_plan(img);
    val e: err[Fail]        = coff_hybrid.plan(img, ?p);
    var w: err[Fail]        = e;
    if (sel e.ok) { w = hybrid_tiled(b, t.some, ?p); }
    ret fail.kept(w, coff_hybrid.release(?p));
}

fun hybrid_tiled(b: *Build, t: Id[Reservation], p: *coff_hybrid.Plan) err[Fail] {
    val img: *Image = b.img;
    if (table.at[Reservation](?img.reserved.tables, t).size != p.size) { ret err[Fail].err{fail.internal("the ARM64EC tables are not the size layout left for them")}; }
    val at: res[Placed, Fail] = placed_of(img, t);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val base: res[u64, Fail] = table_address(img, t);
    if (sel base.err) { ret err[Fail].err{base.err}; }
    val cells: res[opt[u64], Fail] = anchored_address(img, ?coff_hybrid.CELLS);
    if (sel cells.err)     { ret err[Fail].err{cells.err}; }
    if (sel cells.ok.none) { ret err[Fail].err{fail.internal("the ARM64EC helper cells were never reserved")}; }
    val aux: res[u64, Fail] = aux_address(img);
    if (sel aux.err) { ret err[Fail].err{aux.err}; }
    val values: res[Table[u64], Fail] = aux_values(b, p);
    if (sel values.err) { ret err[Fail].err{values.err}; }
    var vals: Table[u64] = values.ok;
    val m:    err[Fail]  = metadata_tile(b, p, at.ok, base.ok, aux.ok, cells.ok.some, ?vals);
    var x:    err[Fail]  = m;
    if (sel m.ok) { x = aux_tile(b, ?vals); }
    x = fail.kept(x, table.release[u64](?vals));
    if (sel x.err) { ret x; }
    val f: err[Fail] = forwards_tile(b, p);
    if (sel f.err) { ret f; }
    val c: err[Fail] = checks_tile(b, p, cells.ok.some + coff_hybrid.CHECK_CELL::u64 * coff_hybrid.CELL_SIZE);
    if (sel c.err) { ret c; }
    ret load_config_laid(b, base.ok);
}

# what each auxiliary import address holds before the loader binds it, by
# its slot: the address of its import's check where a native caller leaves
# for the import through an exit thunk, zero otherwise
fun aux_values(b: *Build, p: *coff_hybrid.Plan) res[Table[u64], Fail] {
    val img:  *Image     = b.img;
    var out:  Table[u64] = table.make[u64](b.a);
    val size: u64        = coff_hybrid.aux_size(img);
    if (size == 0) { ret res[Table[u64], Fail].ok{out}; }
    val g: res[Id[u64], Fail] = table.grow[u64](?out, (size / coff_hybrid.CELL_SIZE)::usize);
    if (sel g.err) {
        val dropped: err[Fail] = table.release[u64](?out);
        ret res[Table[u64], Fail].err{g.err};
    }
    var k: usize = 0;
    for (k < table.count[u64](?p.exits)) {
        val exit: u64 = table.items[u64](?p.exits)[k];
        k = k + 1;
        if (exit == 0) { cnt; }
        val s:   opt[*reserve.Slot] = reserve.slot_of(img.reserved, ?slot.AUX_IAT, (k - 1)::u32);
        val chk: res[u64, Fail]     = layout.slot_address(img.layout, img.reserved, ?slot.IMPORT_CHECK, (k - 1)::u32);
        if (sel s.none) {
            val dropped: err[Fail] = table.release[u64](?out);
            ret res[Table[u64], Fail].err{fail.internal("an import takes no auxiliary address")};
        }
        if (sel chk.err) {
            val dropped: err[Fail] = table.release[u64](?out);
            ret res[Table[u64], Fail].err{chk.err};
        }
        table.items[u64](?out)[(s.some.offset / coff_hybrid.CELL_SIZE)::usize] = chk.ok;
    }
    ret res[Table[u64], Fail].ok{out};
}

# the metadata, the code map, the entry ranges, the redirections and the
# copy of the auxiliary import address table, laid at `at`, which lies at
# `base`
fun metadata_tile(b: *Build, p: *coff_hybrid.Plan, at: Placed, base: u64, aux: u64, cells: u64, values: *Table[u64]) err[Fail] {
    val img:      *Image         = b.img;
    val image:    u64            = b.base;
    val rfe:      Rfe            = rfe_of(img);
    val forwards: res[u64, Fail] = forwards_address(img);
    if (sel forwards.err) { ret err[Fail].err{forwards.err}; }
    var words: [model.ARM64EC_WORDS]u32;
    coff_hybrid.words(p, image, base, aux, rfe.address, rfe.size, cells, ?words);
    var out: Sink      = sink.make(b.a, LITTLE);
    var w:   err[Fail] = err[Fail].ok{};
    var i:   usize     = 0;
    for (sel w.ok && i < model.ARM64EC_WORDS) {
        w = sink.u32(?out, words[i]);
        i = i + 1;
    }
    w = fail.kept(w, sink.zeros(?out, (p.code_map - sink.len(?out)::u64)::usize));
    i = 0;
    for (sel w.ok && i < table.count[coff_hybrid.Range](?p.ranges)) {
        val r: coff_hybrid.Range = table.items[coff_hybrid.Range](?p.ranges)[i];
        w = sink.u32(?out, ((r.start - image) | r.kind)::u32);
        w = fail.kept(w, sink.u32(?out, r.size::u32));
        i = i + 1;
    }
    val first: u64 = forwards.ok;
    i = 0;
    for (sel w.ok && i < table.count[u64](?p.forwards)) {
        val thunk: u64 = first + i::u64 * coff_hybrid.FORWARD_SIZE - image;
        w = sink.u32(?out, thunk::u32);
        w = fail.kept(w, sink.u32(?out, (thunk + coff_hybrid.FORWARD_SIZE)::u32));
        w = fail.kept(w, sink.u32(?out, (table.items[u64](?p.forwards)[i] - image)::u32));
        i = i + 1;
    }
    i = 0;
    for (sel w.ok && i < table.count[u64](?p.forwards)) {
        val thunk: u64 = first + i::u64 * coff_hybrid.FORWARD_SIZE - image;
        w = sink.u32(?out, thunk::u32);
        w = fail.kept(w, sink.u32(?out, (table.items[u64](?p.forwards)[i] - image)::u32));
        i = i + 1;
    }
    w = fail.kept(w, sink.zeros(?out, (p.copy - sink.len(?out)::u64)::usize));
    i = 0;
    for (sel w.ok && i < table.count[u64](values)) {
        w = sink.u64(?out, table.items[u64](values)[i]);
        i = i + 1;
    }
    ret raw_tile(b, ?out, w, at.merged, at.offset, p.size);
}

# the auxiliary import address table, its slots holding `values`
fun aux_tile(b: *Build, values: *Table[u64]) err[Fail] {
    val img: *Image               = b.img;
    val t:   opt[Id[Reservation]] = img.reserved.held[slot.AUX_IAT.at::usize];
    if (sel t.none) { ret err[Fail].ok{}; }
    val at: res[Placed, Fail] = placed_of(img, t.some);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    var out: Sink      = sink.make(b.a, LITTLE);
    var w:   err[Fail] = err[Fail].ok{};
    var i:   usize     = 0;
    for (sel w.ok && i < table.count[u64](values)) {
        w = sink.u64(?out, table.items[u64](values)[i]);
        i = i + 1;
    }
    ret raw_tile(b, ?out, w, at.ok.merged, at.ok.offset, coff_hybrid.aux_size(img));
}

# the address of the fast-forward sequences
fun forwards_address(img: *Image) res[u64, Fail] {
    val t: opt[Id[Reservation]] = measured_of(img, ?coff_hybrid.FAST_FORWARDS);
    if (sel t.none) { ret res[u64, Fail].err{fail.internal("the fast-forward sequences were never reserved")}; }
    ret table_address(img, t.some);
}

# a fast-forward sequence per native function an emulated caller enters
# through one, each jumping to its function
fun forwards_tile(b: *Build, p: *coff_hybrid.Plan) err[Fail] {
    val img: *Image               = b.img;
    val t:   opt[Id[Reservation]] = measured_of(img, ?coff_hybrid.FAST_FORWARDS);
    if (sel t.none) { ret err[Fail].err{fail.internal("the fast-forward sequences were never reserved")}; }
    val n: usize = table.count[u64](?p.forwards);
    if (table.at[Reservation](?img.reserved.tables, t.some).size != n::u64 * coff_hybrid.FORWARD_SIZE) { ret err[Fail].err{fail.internal("the fast-forward sequences are not the size layout left for them")}; }
    if (n == 0)                                                                                        { ret err[Fail].ok{}; }
    val at: res[Placed, Fail] = placed_of(img, t.some);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val start: res[u64, Fail] = table_address(img, t.some);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    val tp: res[*link_template.Template, Fail] = link_template.chosen(img.templates, ?slot.FAST_FORWARD, img.kind, ?img.settled.traits);
    if (sel tp.err) { ret err[Fail].err{tp.err}; }
    var out: Sink      = sink.make(b.a, LITTLE);
    var w:   err[Fail] = sink.zeros(?out, (n::u64 * coff_hybrid.FORWARD_SIZE)::usize);
    var i:   usize     = 0;
    for (sel w.ok && i < n) {
        val here:  u64                    = start.ok + i::u64 * coff_hybrid.FORWARD_SIZE;
        var bound: [1]link_template.Bound = [1]link_template.Bound{link_template.Bound{target: ?link_template.DESTINATION, value: table.items[u64](?p.forwards)[i]}};
        w = link_template.emit(img.relocs, tp.ok, ?sink.data(?out)[(i::u64 * coff_hybrid.FORWARD_SIZE)::usize], here, ?bound[0], 1);
        i = i + 1;
    }
    ret raw_tile(b, ?out, w, at.ok.merged, at.ok.offset, n::u64 * coff_hybrid.FORWARD_SIZE);
}

# the import check of each import a native caller leaves for through an
# exit thunk, which loads the import's address, names the exit thunk and
# calls the emulator's check through the cell at `check`
fun checks_tile(b: *Build, p: *coff_hybrid.Plan, check: u64) err[Fail] {
    val img: *Image               = b.img;
    val t:   opt[Id[Reservation]] = img.reserved.held[slot.IMPORT_CHECK.at::usize];
    if (sel t.none) { ret err[Fail].ok{}; }
    val rv: *Reservation      = table.at[Reservation](?img.reserved.tables, t.some);
    val at: res[Placed, Fail] = placed_of(img, t.some);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val start: res[u64, Fail] = table_address(img, t.some);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    val tp: res[*link_template.Template, Fail] = link_template.chosen(img.templates, ?slot.IMPORT_CHECK_CODE, img.kind, ?img.settled.traits);
    if (sel tp.err) { ret err[Fail].err{tp.err}; }
    var out: Sink      = sink.make(b.a, LITTLE);
    var w:   err[Fail] = sink.zeros(?out, rv.size::usize);
    var k:   usize     = 0;
    for (sel w.ok && k < table.count[u64](?p.exits)) {
        val exit: u64 = table.items[u64](?p.exits)[k];
        k = k + 1;
        if (exit == 0) { cnt; }
        val own:  res[u64, Fail] = layout.slot_address(img.layout, img.reserved, ?slot.IMPORT_CHECK, (k - 1)::u32);
        val cell: res[u64, Fail] = layout.slot_address(img.layout, img.reserved, ?slot.IAT, (k - 1)::u32);
        if (sel own.err) {
            w = err[Fail].err{own.err};
            brk;
        }
        if (sel cell.err) {
            w = err[Fail].err{cell.err};
            brk;
        }
        var bound: [3]link_template.Bound = [3]link_template.Bound{
            link_template.Bound{target: ?link_template.SLOT, value: cell.ok},
            link_template.Bound{target: ?link_template.DESTINATION, value: exit},
            link_template.Bound{target: ?link_template.BINDER, value: check},
        };
        w = link_template.emit(img.relocs, tp.ok, ?sink.data(?out)[(own.ok - start.ok)::usize], own.ok, ?bound[0], 3);
    }
    ret raw_tile(b, ?out, w, at.ok.merged, at.ok.offset, rv.size);
}

# the load configuration the link lays, whose metadata pointer holds the
# metadata at `metadata`, and the directory naming it
fun load_config_laid(b: *Build, metadata: u64) err[Fail] {
    val img: *Image               = b.img;
    val t:   opt[Id[Reservation]] = reserve.anchored(img.reserved, ?coff_hybrid.LOAD_CONFIG);
    if (sel t.none) { ret err[Fail].ok{}; }
    val at: res[Placed, Fail] = placed_of(img, t.some);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val start: res[u64, Fail] = table_address(img, t.some);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    var out: Sink      = sink.make(b.a, LITTLE);
    var w:   err[Fail] = sink.u32(?out, coff_hybrid.LOAD_CONFIG_SIZE::u32);
    w = fail.kept(w, sink.zeros(?out, (coff_hybrid.CHPE_POINTER - 4)::usize));
    w = fail.kept(w, sink.u64(?out, metadata));
    val r: err[Fail] = raw_tile(b, ?out, w, at.ok.merged, at.ok.offset, coff_hybrid.LOAD_CONFIG_SIZE);
    if (sel r.err) { ret r; }
    val rva: res[u32, Fail] = rva_of(b, start.ok, "load configuration", 0);
    if (sel rva.err) { ret err[Fail].err{rva.err}; }
    b.load = DataDirectory{rva: rva.ok, size: coff_hybrid.LOAD_CONFIG_SIZE::u32};
    ret err[Fail].ok{};
}

# the link name of the load configuration structure, spelled with the C
# prefix of a machine that has one
fun load_config_name(a: *A.Allocator, names: *Interner, prefix: str) res[Id[Name], Fail] {
    var out: Sink      = sink.make(a, LITTLE);
    var w:   err[Fail] = sink.text(?out, prefix);
    w = fail.kept(w, sink.text(?out, coff_hybrid.LOAD_CONFIG_USED));
    if (sel w.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret res[Id[Name], Fail].err{w.err};
    }
    val n:   res[Id[Name], Fail] = intern.intern(names, sink.data(?out), sink.len(?out));
    val rel: err[Fail]           = sink.release(?out);
    if (sel n.err)   { ret n; }
    if (sel rel.err) { ret res[Id[Name], Fail].err{rel.err}; }
    ret n;
}

# the link asks the archives for the member that defines the load
# configuration structure, as the loader reads it by name and no input refers
# to it. an image with no archive that defines it goes without
pub fun asked(c: *resolve.Context) err[Fail] {
    if (output.has(c.in.kind, output.KEEPS)) { ret err[Fail].ok{}; }
    val pr: res[*Pair, Fail] = coff_pairs.of(c.in.arch);
    if (sel pr.err) { ret err[Fail].err{pr.err}; }
    val n: res[Id[Name], Fail] = load_config_name(c.in.inputs.a, c.in.names, pr.ok.prefix);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    ret resolve.ask(c, n.ok);
}

val LOAD_CONFIG_CALLED:          Called = Called{name: "_load_config_used", output: Axis{need: output.IMPORTS}};
val LOAD_CONFIG_PREFIXED_CALLED: Called = Called{name: "__load_config_used", output: Axis{need: output.IMPORTS}};

val CALLED_COUNT: usize                 = 2;
val CALLED:       [CALLED_COUNT]*Called = [CALLED_COUNT]*Called{?LOAD_CONFIG_CALLED, ?LOAD_CONFIG_PREFIXED_CALLED};

# the loader reads the load configuration by name, so the section holding it
# stays whatever reaches it, under the spelling of a machine with a C prefix
# or without
pub val CALLS: collect.Calls = collect.Calls{rows: ?CALLED[0], count: CALLED_COUNT};

# the load configuration directory of an image whose input defines
# _load_config_used, which names the structure and whose first word states
# its size, in the layout of the image's word size ("The Load Configuration
# Structure (Image Only)"). an image the link laid one for, or one that has
# none, leaves the directory as it stands
fun load_config_out(b: *Build) err[Fail] {
    val img:  *Image               = b.img;
    val laid: opt[Id[Reservation]] = reserve.anchored(img.reserved, ?coff_hybrid.LOAD_CONFIG);
    if (sel laid.some) { ret err[Fail].ok{}; }
    val pr: res[*Pair, Fail] = coff_pairs.of(img.target.arch);
    if (sel pr.err) { ret err[Fail].err{pr.err}; }
    val nm: res[Id[Name], Fail] = load_config_name(b.a, img.names, pr.ok.prefix);
    if (sel nm.err) { ret err[Fail].err{nm.err}; }
    val won: opt[resolve.Won] = defined_name(img.resolved, nm.ok);
    if (sel won.none) { ret err[Fail].ok{}; }
    val a: res[u64, Fail] = address_of(img, nm.ok, fail.about(fail.malformed("the image does not place the load configuration"), coff_hybrid.LOAD_CONFIG_USED));
    if (sel a.err) { ret err[Fail].err{a.err}; }
    val size: res[u32, Fail] = word_at(img, a.ok);
    if (sel size.err) { ret err[Fail].err{size.err}; }
    val rva: res[u32, Fail] = rva_of(b, a.ok, "load configuration", 0);
    if (sel rva.err) { ret err[Fail].err{rva.err}; }
    b.load = DataDirectory{rva: rva.ok, size: size.ok};
    ret err[Fail].ok{};
}

# the relocated 32-bit word at `address`
fun word_at(img: *Image, address: u64) res[u32, Fail] {
    val l: *Layout = img.layout;
    var i: usize   = 0;
    for (i < table.count[Id[Merged]](?l.order)) {
        val m: *Merged = table.at[Merged](?l.merged, table.items[Id[Merged]](?l.order)[i]);
        i = i + 1;
        if (!kept(m) || !section.has(m.kind, section.BITS))          { cnt; }
        if (address < m.address || address - m.address + 4 > m.size) { cnt; }
        val at:  u64        = m.offset + (address - m.address);
        val rel: *Table[u8] = ?img.relocated.bytes;
        if (at + 4 > table.count[u8](rel)::u64) { ret res[u32, Fail].err{fail.internal("a load configuration lies past the relocated bytes")}; }
        var r: Reader = reader.make("load configuration", ?table.items[u8](rel)[at::usize], 4, LITTLE);
        ret reader.u32(?r);
    }
    ret res[u32, Fail].err{fail.malformed("the load configuration lies in no section with bytes")};
}

# the fast-forward sequence an emulated caller enters the native function at
# `address` through, the address itself where none enters it
fun forwarded(img: *Image, address: u64) res[u64, Fail] {
    if (!coff_hybrid.joined(img.target.arch)) { ret res[u64, Fail].ok{address}; }
    var f:   Table[u64] = table.make[u64](img.inputs.a);
    val e:   err[Fail]  = coff_hybrid.forwards_of(img, ?f);
    val at:  opt[usize] = coff_hybrid.forward_index(?f, address);
    val rel: err[Fail]  = table.release[u64](?f);
    if (sel e.err)   { ret res[u64, Fail].err{e.err}; }
    if (sel rel.err) { ret res[u64, Fail].err{rel.err}; }
    if (sel at.none) { ret res[u64, Fail].ok{address}; }
    val start: res[u64, Fail] = forwards_address(img);
    if (sel start.err) { ret start; }
    ret res[u64, Fail].ok{start.ok + at.some::u64 * coff_hybrid.FORWARD_SIZE};
}
