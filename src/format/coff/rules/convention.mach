# the linking rules of PE/COFF: how an image is laid out and bound
#
# an input section merges into the output section named by its name up to a
# $, ordered there by what follows it, as .CRT$XCA before .CRT$XCU. every
# loaded section starts on a section alignment boundary in memory and a file
# alignment boundary in the file, so offsets and addresses need not agree.
#
# an import binds through the import address table of the DLL that defines
# it, so no definition preempts another image's, nothing is copied and
# symbols carry no versions. a reference to an `__imp_` cell reads the
# import's address table slot, a call to an imported function goes through a
# thunk that jumps through that slot, and imported data is reached only
# through its cell. an address the image holds gets a base relocation,
# writable or not. an image is large address aware, so an absolute address
# narrower than its addresses is refused, as link.exe refuses one. the rows
# follow link.exe and are disjoint.

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;

use mink.base.rule.Axis;
use mink.catalog.merge;
use mink.catalog.merge.Rule;
use mink.catalog.output;
use coff_fact: mink.format.coff.neutral.fact;
use mink.format.coff.neutral.naming;
use mink.link.dynamic;
use mink.link.dynamic.Row;
use mink.link.layout.Class;
use mink.link.layout.Load;
use mink.link.layout.Rules;
use mink.model.reloc;
use mink.model.section;

val CODE:  Load = Load{name: "code", flags: section.ALLOC | section.EXEC};
val CONST: Load = Load{name: "rdata", flags: section.ALLOC};
val DATA:  Load = Load{name: "data", flags: section.ALLOC | section.WRITE};

val WRITTEN: section.Flags = section.ALLOC | section.WRITE;

val CLASS_COUNT: usize              = 6;
val CLASSES:     [CLASS_COUNT]Class = [CLASS_COUNT]Class{
    Class{name: "code", rank: 0, flags: Axis{need: section.ALLOC | section.EXEC, deny: section.WRITE}, load: opt[*Load].some{?CODE}},
    Class{name: "rdata", rank: 1, flags: Axis{need: section.ALLOC, deny: section.WRITE | section.EXEC}, load: opt[*Load].some{?CONST}},
    Class{name: "relro", rank: 2, flags: Axis{need: WRITTEN, deny: section.EXEC}, roles: Axis{need: section.RELRO}, load: opt[*Load].some{?DATA}},
    Class{name: "data", rank: 3, flags: Axis{need: WRITTEN, deny: section.EXEC}, roles: Axis{need: section.BITS, deny: section.RELRO}, load: opt[*Load].some{?DATA}},
    Class{name: "bss", rank: 4, flags: Axis{need: WRITTEN, deny: section.EXEC}, roles: Axis{deny: section.BITS | section.RELRO}, load: opt[*Load].some{?DATA}},
    Class{name: "unloaded", rank: 5, flags: Axis{deny: section.ALLOC}, load: opt[*Load].none{}},
};

# the default SectionAlignment and FileAlignment of the PE specification
pub val LAYOUT: Rules = Rules{
    name:          "coff",
    stems:         nil,
    stem_count:    0,
    joint:         0,
    cut:           '$',
    classes:       ?CLASSES[0],
    class_count:   CLASS_COUNT,
    commons:       ".bss",
    congruent:     false,
    section_align: 0x1000,
    file_align:    0x200,
    sections:      opt[u64].some{1},
    naming:        naming.name_of,
};

val UNPATCHED: u64 = reloc.MARKER | reloc.LOADER;
val FIXED:     u64 = dynamic.ABSOLUTE | dynamic.UNDEFINED;

val DYNAMIC_COUNT: usize              = 23;
val DYNAMIC_ROWS:  [DYNAMIC_COUNT]Row = [DYNAMIC_COUNT]Row{
    Row{name: "marker", kind: Axis{need: reloc.MARKER}, outcome: ?dynamic.STATIC},
    Row{
        name:    "loader",
        kind:    Axis{need: reloc.LOADER, deny: reloc.MARKER},
        outcome: ?dynamic.REFUSED,
        reason:  "an object holds a relocation only a loader applies",
    },
    Row{
        name:    "unloaded import",
        kind:    Axis{deny: UNPATCHED},
        target:  Axis{need: dynamic.IMPORTED | dynamic.BOUND},
        output:  Axis{deny: output.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "an output no loader binds cannot import from a shared library",
    },
    Row{
        name:    "bound resolver",
        kind:    Axis{deny: UNPATCHED},
        target:  Axis{need: dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "the format has no indirect functions",
    },
    Row{
        name:    "bound thread",
        kind:    Axis{deny: UNPATCHED},
        target:  Axis{need: dynamic.BOUND | dynamic.DATA | dynamic.THREAD, deny: dynamic.RESOLVER},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "thread-local data of another image cannot be referred to",
    },
    Row{
        name:    "bound got",
        kind:    Axis{need: reloc.GOT, deny: UNPATCHED},
        target:  Axis{need: dynamic.BOUND, deny: dynamic.RESOLVER | dynamic.THREAD},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "the format has no GOT",
    },
    Row{
        name:    "cell",
        kind:    Axis{deny: UNPATCHED | reloc.GOT},
        target:  Axis{need: dynamic.BOUND | dynamic.DATA | dynamic.CELL, deny: dynamic.RESOLVER | dynamic.THREAD},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.GOT_BIND,
    },
    Row{
        name:    "thunk word",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{need: dynamic.WORD},
        target:  Axis{need: dynamic.BOUND | dynamic.CODE, deny: dynamic.DATA | dynamic.RESOLVER},
        output:  Axis{need: output.IMPORTS | output.PIC},
        outcome: ?dynamic.PLT_BIND_REBASE,
    },
    Row{
        name:    "thunk narrow",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{deny: dynamic.WORD},
        target:  Axis{need: dynamic.BOUND | dynamic.CODE, deny: dynamic.DATA | dynamic.RESOLVER},
        output:  Axis{need: output.IMPORTS | output.PIC},
        outcome: ?dynamic.REFUSED,
        reason:  "an absolute reference narrower than an address cannot be made position independent",
    },
    Row{
        name:    "thunk",
        kind:    Axis{deny: UNPATCHED | reloc.GOT | reloc.ABS},
        target:  Axis{need: dynamic.BOUND | dynamic.CODE, deny: dynamic.DATA | dynamic.RESOLVER},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.PLT_BIND,
    },
    Row{
        name:    "thunk fixed",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        target:  Axis{need: dynamic.BOUND | dynamic.CODE, deny: dynamic.DATA | dynamic.RESOLVER},
        output:  Axis{need: output.IMPORTS, deny: output.PIC},
        outcome: ?dynamic.PLT_BIND,
    },
    Row{
        name:    "imported data",
        kind:    Axis{deny: UNPATCHED | reloc.GOT},
        target:  Axis{need: dynamic.BOUND | dynamic.DATA, deny: dynamic.CODE | dynamic.RESOLVER | dynamic.THREAD | dynamic.CELL},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "imported data is reached only through its import address cell",
    },
    Row{
        name:    "bound",
        kind:    Axis{deny: UNPATCHED | reloc.GOT},
        target:  Axis{need: dynamic.BOUND, deny: dynamic.CODE | dynamic.DATA | dynamic.RESOLVER},
        output:  Axis{need: output.IMPORTS},
        outcome: ?dynamic.REFUSED,
        reason:  "a reference of this kind cannot reach a symbol the loader binds",
    },
    Row{
        name:    "resolver",
        kind:    Axis{deny: UNPATCHED},
        target:  Axis{need: dynamic.RESOLVER, deny: dynamic.BOUND},
        outcome: ?dynamic.REFUSED,
        reason:  "the format has no indirect functions",
    },
    Row{
        name:    "got",
        kind:    Axis{need: reloc.GOT, deny: UNPATCHED},
        target:  Axis{deny: dynamic.BOUND | dynamic.RESOLVER},
        outcome: ?dynamic.REFUSED,
        reason:  "the format has no GOT",
    },
    Row{
        name:    "static",
        kind:    Axis{deny: UNPATCHED | reloc.GOT | reloc.ABS},
        target:  Axis{deny: dynamic.BOUND | dynamic.RESOLVER},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "rebase",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{need: dynamic.WORD},
        target:  Axis{deny: FIXED | dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{need: output.PIC},
        outcome: ?dynamic.REBASE,
    },
    Row{
        name:    "narrow",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{deny: dynamic.WORD | dynamic.LOW},
        target:  Axis{deny: FIXED | dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{need: output.PIC},
        outcome: ?dynamic.REFUSED,
        reason:  "an absolute reference narrower than an address cannot be made position independent",
    },
    Row{
        name:    "low",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{need: dynamic.LOW, deny: dynamic.WORD},
        target:  Axis{deny: FIXED | dynamic.BOUND | dynamic.RESOLVER},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "absolute fixed",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        target:  Axis{need: dynamic.ABSOLUTE, deny: dynamic.BOUND | dynamic.RESOLVER},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "absolute undefined",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        target:  Axis{need: dynamic.UNDEFINED, deny: dynamic.BOUND | dynamic.ABSOLUTE | dynamic.RESOLVER},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "absolute",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{need: dynamic.WORD},
        target:  Axis{deny: FIXED | dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{deny: output.PIC},
        outcome: ?dynamic.STATIC,
    },
    Row{
        name:    "narrow fixed",
        kind:    Axis{need: reloc.ABS, deny: UNPATCHED | reloc.GOT},
        site:    Axis{deny: dynamic.WORD | dynamic.LOW},
        target:  Axis{deny: FIXED | dynamic.BOUND | dynamic.RESOLVER},
        output:  Axis{deny: output.PIC},
        outcome: ?dynamic.REFUSED,
        reason:  "a large address aware image holds no absolute address narrower than its addresses",
    },
};
pub val DYNAMIC: dynamic.Rules = dynamic.Rules{name: "coff", caps: 0, rows: ?DYNAMIC_ROWS[0], count: DYNAMIC_COUNT};

# how settle combines the COFF facts. each describes the object, one of its
# sections or one of its symbols, and travels with it
val FACT_COUNT: usize            = 7;
val FACT_ROWS:  [FACT_COUNT]Rule = [FACT_COUNT]Rule{
    Rule{key: coff_fact.TIMESTAMP, by: ?merge.BY_KEY, merge: ?merge.LOCAL},
    Rule{key: coff_fact.CHARACTERISTICS, by: ?merge.BY_KEY, merge: ?merge.LOCAL},
    Rule{key: coff_fact.SECTION, by: ?merge.BY_VALUE, merge: ?merge.LOCAL},
    Rule{key: coff_fact.CHECKSUM, by: ?merge.BY_VALUE, merge: ?merge.LOCAL},
    Rule{key: coff_fact.CLASS, by: ?merge.BY_VALUE, merge: ?merge.LOCAL},
    Rule{key: coff_fact.TYPE, by: ?merge.BY_VALUE, merge: ?merge.LOCAL},
    Rule{key: coff_fact.NUMBER, by: ?merge.BY_VALUE, merge: ?merge.LOCAL},
};
pub val FACTS: merge.Rules = merge.Rules{rows: ?FACT_ROWS[0], count: FACT_COUNT};
