# the (COFF, architecture) pairs: what COFF states for each machine it names,
# which the COFF registration lists
#
# a record's row key is its type, written back as it is. a COFF record always
# holds a symbol table index, so no pair has a symbol reference for a record
# that names no target: a row whose record holds its addend in the symbol
# field, as the AMD64 PAIR does, is the one form a nameless record takes. an
# x86 C symbol carries a leading underscore, which the other machines leave
# off. no pair states a thread-local layout, as an image reaches its
# thread-local block through the TLS directory and an index.
#
# a call to an import goes through a thunk that jumps through the import's
# address slot, as lld-link writes one: on x64 a jump through the slot
# relative to the instruction, padded with int3 to the sixteen bytes a branch
# target aligns to, and on ARM64 the slot's page, a load from it and a branch
# to what it held. the x86 thunk jumps through the slot's absolute address,
# which the loader moves with the image, so x86 states no thunk.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail.Fail;
use mink.catalog.arch.Arch;
use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.slot;
use mink.format.coff.reloc.rows;
use mink.format.pair;
use mink.format.pair.Pair;
use mink.link.template;
use mink.link.template.Patch;
use mink.link.template.Template;
use mink.model.reloc;
use mink.reloc.row;

val X64_THUNK_BYTES:   [16]u8      = [16]u8{0xff, 0x25, 0, 0, 0, 0, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc};
val X64_THUNK_PATCHES: [1]Patch    = [1]Patch{Patch{offset: 2, kind: ?reloc.PC32, target: ?template.SLOT, addend: -4}};
val X64_THUNKS:        [1]Template = [1]Template{
    Template{role: ?slot.THUNK, variant: ?template.PLAIN, name: "x64 import thunk", bytes: ?X64_THUNK_BYTES[0], len: 16, align: 16, patches: ?X64_THUNK_PATCHES[0], patch_count: 1},
};
val X64_ROWS:      [1]*Template = [1]*Template{?X64_THUNKS[0]};
val X64_TEMPLATES: template.Set = template.Set{rows: ?X64_ROWS[0], roles: ?X64_ROWS[0], count: 1};

val ARM64_THUNK_BYTES:   [12]u8   = [12]u8{0x10, 0x00, 0x00, 0x90, 0x10, 0x02, 0x40, 0xf9, 0x00, 0x02, 0x1f, 0xd6};
val ARM64_THUNK_PATCHES: [2]Patch = [2]Patch{
    Patch{offset: 0, kind: ?reloc.PAGE21, target: ?template.SLOT},
    Patch{offset: 4, kind: ?reloc.LO12_LDST64, target: ?template.SLOT},
};
# adrp x16, the destination's page, add x16, x16, its offset in the page,
# and br x16, the veneer of a branch past its reach as lld-link writes it
val ARM64_VENEER_BYTES:   [12]u8   = [12]u8{0x10, 0x00, 0x00, 0x90, 0x10, 0x02, 0x00, 0x91, 0x00, 0x02, 0x1f, 0xd6};
val ARM64_VENEER_PATCHES: [2]Patch = [2]Patch{
    Patch{offset: 0, kind: ?reloc.PAGE21, target: ?template.DESTINATION},
    Patch{offset: 4, kind: ?reloc.LO12_ADD, target: ?template.DESTINATION},
};
val ARM64_THUNKS: [2]Template = [2]Template{
    Template{role: ?slot.THUNK, variant: ?template.PLAIN, name: "arm64 import thunk", bytes: ?ARM64_THUNK_BYTES[0], len: 12, align: 4, patches: ?ARM64_THUNK_PATCHES[0], patch_count: 2},
    Template{role: ?slot.VENEER, variant: ?template.PLAIN, name: "arm64 veneer", bytes: ?ARM64_VENEER_BYTES[0], len: 12, align: 4, patches: ?ARM64_VENEER_PATCHES[0], patch_count: 2},
};
val ARM64_ROWS:      [2]*Template = [2]*Template{?ARM64_THUNKS[0], ?ARM64_THUNKS[1]};
val ARM64_TEMPLATES: template.Set = template.Set{rows: ?ARM64_ROWS[0], roles: ?ARM64_ROWS[0], count: 2};

pub val COUNT: usize = 4;

pub val PAIRS: [COUNT]Pair = [COUNT]Pair{
    Pair{arch: ?x86.X86_64, code: ?x86.X86_64_CODES[1], key_of: pair.code_key, relocs: ?rows.AMD64, templates: opt[*template.Set].some{?X64_TEMPLATES}, prefix: ""},
    Pair{arch: ?x86.X86, code: ?x86.X86_CODES[1], key_of: pair.code_key, relocs: ?rows.I386, prefix: "_"},
    Pair{arch: ?aarch64.AARCH64, code: ?aarch64.AARCH64_CODES[1], key_of: pair.code_key, relocs: ?rows.ARM64, templates: opt[*template.Set].some{?ARM64_TEMPLATES}, prefix: ""},
    Pair{arch: ?aarch64.ARM64EC, code: ?aarch64.ARM64EC_CODES[0], key_of: pair.code_key, relocs: ?rows.ARM64EC, prefix: ""},
};

# the pair of `a`
pub fun of(a: *Arch) res[*Pair, Fail] {
    ret pair.of(?format.COFF, ?PAIRS[0], COUNT, a);
}

# an index of the relocation rows of every pair, for a test below the format
# registry. the index is released with `row.release`
#[testing]
pub fun index(a: *A.Allocator) res[row.Registry, Fail] {
    var sets: [COUNT]*row.Set;
    var i:    usize = 0;
    for (i < COUNT) {
        sets[i] = PAIRS[i].relocs;
        i       = i + 1;
    }
    ret row.make(a, ?sets[0], COUNT);
}

test pairs__every_pair_is_sound_and_found_by_its_row {
    var i: usize = 0;
    for (i < COUNT) {
        val p: *Pair = ?PAIRS[i];
        if (!pair.sound(p, ?format.COFF)) { ret 1; }
        val got: res[*Pair, Fail] = of(p.arch);
        if (sel got.err) { ret 2; }
        if (got.ok != p) { ret 2; }
        val w: res[u64, Fail] = pair.write_nameless(p);
        if (!sel w.err) { ret 3; }
        i = i + 1;
    }
    # ARM64EC shares the arm64 rows by reference
    if (rows.ARM64EC.rows != rows.ARM64.rows) { ret 4; }
    ret 0;
}
