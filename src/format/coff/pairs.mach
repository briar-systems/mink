# the (COFF, architecture) pairs: what COFF states for each machine it names,
# which the COFF registration lists
#
# a record's row key is its type, written back as it is. a COFF record always
# holds a symbol table index, so no pair has a symbol reference for a record
# that names no target: a row whose record holds its addend in the symbol
# field, as the AMD64 PAIR does, is the one form a nameless record takes. an
# x86 C symbol carries a leading underscore, which the other machines leave
# off. no pair states a thread-local layout, as an image reaches its
# thread-local block through the TLS directory and an index.
#
# a call to an import goes through a thunk that jumps through the import's
# address slot: on x64 a jump through the slot relative to the instruction,
# padded with int3 to the sixteen bytes a branch target aligns to, and on
# ARM64 the slot's page, a load from it and a branch to what it held. the x86
# thunk jumps through the slot's absolute address, which the loader moves with
# the image, so x86 states no thunk.
#
# an ARM64EC image holds x64 and ARM64EC code. its import thunk is the x64
# one, which an emulated caller reaches through the import's address, and a
# native caller's goes through the import's auxiliary address the way the
# ARM64 thunk goes through its slot. the import check an auxiliary address
# leads to until the loader binds it asks the emulator's check routine for a
# callable form of what the import's address holds, passing the callee's
# exit thunk, and branches to it ("auxiliary IAT" and "exit thunks",
# understanding Arm64EC ABI and assembly code). the fast-forward sequence an
# emulated caller enters an exported native function through is the x64
# prologue the emulator recognizes, ending in a jump to the native code
# ("fast-forward sequences").

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail.Fail;
use mink.catalog.arch.Arch;
use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.slot;
use mink.format.coff.reloc.rows;
use mink.format.pair;
use mink.format.pair.Pair;
use mink.link.template;
use mink.link.template.Patch;
use mink.link.template.Template;
use mink.model.reloc;

val X64_THUNK_BYTES:   [16]u8      = [16]u8{0xff, 0x25, 0, 0, 0, 0, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc};
val X64_THUNK_PATCHES: [1]Patch    = [1]Patch{Patch{offset: 2, kind: ?reloc.PC32, target: ?template.SLOT, addend: -4}};
val X64_THUNKS:        [1]Template = [1]Template{
    Template{role: ?slot.THUNK, variant: ?template.PLAIN, name: "x64 import thunk", bytes: ?X64_THUNK_BYTES[0], len: 16, align: 16, patches: ?X64_THUNK_PATCHES[0], patch_count: 1},
};
val X64_ROWS:      [1]*Template = [1]*Template{?X64_THUNKS[0]};
val X64_TEMPLATES: template.Set = template.Set{rows: ?X64_ROWS[0], roles: ?X64_ROWS[0], count: 1};

val ARM64_THUNK_BYTES:   [12]u8   = [12]u8{0x10, 0x00, 0x00, 0x90, 0x10, 0x02, 0x40, 0xf9, 0x00, 0x02, 0x1f, 0xd6};
val ARM64_THUNK_PATCHES: [2]Patch = [2]Patch{
    Patch{offset: 0, kind: ?reloc.PAGE21, target: ?template.SLOT},
    Patch{offset: 4, kind: ?reloc.LO12_LDST64, target: ?template.SLOT},
};
# adrp x16, the destination's page, add x16, x16, its offset in the page, and
# br x16, the veneer of a branch past its reach
val ARM64_VENEER_BYTES:   [12]u8   = [12]u8{0x10, 0x00, 0x00, 0x90, 0x10, 0x02, 0x00, 0x91, 0x00, 0x02, 0x1f, 0xd6};
val ARM64_VENEER_PATCHES: [2]Patch = [2]Patch{
    Patch{offset: 0, kind: ?reloc.PAGE21, target: ?template.DESTINATION},
    Patch{offset: 4, kind: ?reloc.LO12_ADD, target: ?template.DESTINATION},
};
val ARM64_THUNKS: [2]Template = [2]Template{
    Template{role: ?slot.THUNK, variant: ?template.PLAIN, name: "arm64 import thunk", bytes: ?ARM64_THUNK_BYTES[0], len: 12, align: 4, patches: ?ARM64_THUNK_PATCHES[0], patch_count: 2},
    Template{role: ?slot.VENEER, variant: ?template.PLAIN, name: "arm64 veneer", bytes: ?ARM64_VENEER_BYTES[0], len: 12, align: 4, patches: ?ARM64_VENEER_PATCHES[0], patch_count: 2},
};
val ARM64_ROWS:      [2]*Template = [2]*Template{?ARM64_THUNKS[0], ?ARM64_THUNKS[1]};
val ARM64_TEMPLATES: template.Set = template.Set{rows: ?ARM64_ROWS[0], roles: ?ARM64_ROWS[0], count: 2};

# the slot role's x64 thunk patched through the ARM64EC rows, whose REL32 is
# the x64 one's
val EC_THUNK_PATCHES: [1]Patch = [1]Patch{Patch{offset: 2, kind: ?reloc.PC32, target: ?template.SLOT, addend: -4}};
# adrp x11, the import address's page, ldr x11 from it, adrp x10 and add x10,
# the exit thunk, adrp x9 and ldr x9, the check routine's cell, stp x29, x30,
# mov x29, sp, blr x9, ldp x29, x30 and br x11
val EC_CHECK_BYTES: [44]u8 = [44]u8{
    0x0b, 0x00, 0x00, 0x90, 0x6b, 0x01, 0x40, 0xf9, 0x0a, 0x00, 0x00, 0x90, 0x4a, 0x01, 0x00, 0x91,
    0x09, 0x00, 0x00, 0x90, 0x29, 0x01, 0x40, 0xf9, 0xfd, 0x7b, 0xbf, 0xa9, 0xfd, 0x03, 0x00, 0x91,
    0x20, 0x01, 0x3f, 0xd6, 0xfd, 0x7b, 0xc1, 0xa8, 0x60, 0x01, 0x1f, 0xd6,
};
val EC_CHECK_PATCHES: [6]Patch = [6]Patch{
    Patch{offset: 0, kind: ?reloc.PAGE21, target: ?template.SLOT},
    Patch{offset: 4, kind: ?reloc.LO12_LDST64, target: ?template.SLOT},
    Patch{offset: 8, kind: ?reloc.PAGE21, target: ?template.DESTINATION},
    Patch{offset: 12, kind: ?reloc.LO12_ADD, target: ?template.DESTINATION},
    Patch{offset: 16, kind: ?reloc.PAGE21, target: ?template.BINDER},
    Patch{offset: 20, kind: ?reloc.LO12_LDST64, target: ?template.BINDER},
};
# mov rax, rsp, mov [rax+0x20], rbx, push rbp, pop rbp, jmp to the native
# code and int3 to sixteen bytes
val EC_FAST_FORWARD_BYTES:   [16]u8      = [16]u8{0x48, 0x8b, 0xc4, 0x48, 0x89, 0x58, 0x20, 0x55, 0x5d, 0xe9, 0, 0, 0, 0, 0xcc, 0xcc};
val EC_FAST_FORWARD_PATCHES: [1]Patch    = [1]Patch{Patch{offset: 10, kind: ?reloc.PC32, target: ?template.DESTINATION, addend: -4}};
val EC_THUNKS:               [5]Template = [5]Template{
    Template{role: ?slot.THUNK, variant: ?template.PLAIN, name: "arm64ec import thunk", bytes: ?X64_THUNK_BYTES[0], len: 16, align: 16, patches: ?EC_THUNK_PATCHES[0], patch_count: 1},
    Template{role: ?slot.NATIVE_THUNK_CODE, variant: ?template.PLAIN, name: "arm64ec native import thunk", bytes: ?ARM64_THUNK_BYTES[0], len: 12, align: 4, patches: ?ARM64_THUNK_PATCHES[0], patch_count: 2},
    Template{role: ?slot.IMPORT_CHECK_CODE, variant: ?template.PLAIN, name: "arm64ec import check", bytes: ?EC_CHECK_BYTES[0], len: 44, align: 4, patches: ?EC_CHECK_PATCHES[0], patch_count: 6},
    Template{role: ?slot.FAST_FORWARD, variant: ?template.PLAIN, name: "arm64ec fast-forward sequence", bytes: ?EC_FAST_FORWARD_BYTES[0], len: 16, align: 16, patches: ?EC_FAST_FORWARD_PATCHES[0], patch_count: 1},
    Template{role: ?slot.VENEER, variant: ?template.PLAIN, name: "arm64ec veneer", bytes: ?ARM64_VENEER_BYTES[0], len: 12, align: 4, patches: ?ARM64_VENEER_PATCHES[0], patch_count: 2},
};
val EC_ROWS:      [5]*Template = [5]*Template{?EC_THUNKS[0], ?EC_THUNKS[1], ?EC_THUNKS[2], ?EC_THUNKS[3], ?EC_THUNKS[4]};
val EC_ROLES:     [5]*Template = [5]*Template{?EC_THUNKS[3], ?EC_THUNKS[2], ?EC_THUNKS[1], ?EC_THUNKS[0], ?EC_THUNKS[4]};
val EC_TEMPLATES: template.Set = template.Set{rows: ?EC_ROWS[0], roles: ?EC_ROLES[0], count: 5};

pub val COUNT: usize = 4;

pub val PAIRS: [COUNT]Pair = [COUNT]Pair{
    Pair{arch: ?x86.X86_64, code: ?x86.X86_64_CODES[1], key_of: pair.code_key, relocs: ?rows.AMD64, templates: opt[*template.Set].some{?X64_TEMPLATES}, prefix: ""},
    Pair{arch: ?x86.X86, code: ?x86.X86_CODES[1], key_of: pair.code_key, relocs: ?rows.I386, prefix: "_"},
    Pair{arch: ?aarch64.AARCH64, code: ?aarch64.AARCH64_CODES[1], key_of: pair.code_key, relocs: ?rows.ARM64, templates: opt[*template.Set].some{?ARM64_TEMPLATES}, prefix: ""},
    Pair{arch: ?aarch64.ARM64EC, code: ?aarch64.ARM64EC_CODES[0], key_of: pair.code_key, relocs: ?rows.ARM64EC, templates: opt[*template.Set].some{?EC_TEMPLATES}, prefix: ""},
};

# the pair of `a`
pub fun of(a: *Arch) res[*Pair, Fail] {
    ret pair.of(?format.COFF, ?PAIRS[0], COUNT, a);
}
