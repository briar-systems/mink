# the model of a text-based dylib stub, as its documents state it
#
# a text stub describes one library in its first document and, in the
# documents after it, the libraries that one re-exports, each a document of
# its own. a document states the library's install name, its versions and the
# targets it is built for, and its lists, each list a set of targets and the
# names it states for them: the libraries it re-exports, the symbols it
# exports, the symbols it re-exports from other libraries and the symbols it
# leaves undefined. a name is held as the file writes it, and which symbols
# it stands for is the list's row. every name lives in the model's names.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;

# the versions of the format the reader takes, as a bit each
pub def Versions: u8;
pub val V3:   Versions = 1;
pub val V4:   Versions = 2;
pub val BOTH: Versions = V3 | V4;

# what the names of a list are
# ---
# libraries: install names of libraries the document re-exports
# symbols:   symbol names
pub tag Names: u8 {
    libraries;
    symbols;
}

# a key of a list section, and what the names under it stand for
# ---
# key:      the key, as the file writes it
# versions: the versions of the format that name it
# names:    what its names are
# prefixes: for symbols, the prefixes each name is spelled under, one symbol
#           a prefix, as an Objective-C class names its class and its
#           metaclass
# count:    how many prefixes
# weak:     the symbols are weak definitions
# thread:   the symbols are thread-local variables
pub rec List {
    key:      str;
    versions: Versions;
    names:    Names;
    prefixes: *str;
    count:    usize;
    weak:     bool;
    thread:   bool;
}

val PLAIN:    [1]str = [1]str{""};
val CLASSES:  [2]str = [2]str{"_OBJC_CLASS_$_", "_OBJC_METACLASS_$_"};
val EH_TYPES: [1]str = [1]str{"_OBJC_EHTYPE_$_"};
val IVARS:    [1]str = [1]str{"_OBJC_IVAR_$_"};

# every list key of either version, as llvm's TextAPI reads them. both
# versions name a class or an instance variable bare, the symbol its prefix
# and the name
pub val SYMBOLS:          List = List{key: "symbols", versions: BOTH, names: Names.symbols{}, prefixes: ?PLAIN[0], count: 1};
pub val WEAK_SYMBOLS:     List = List{key: "weak-symbols", versions: V4, names: Names.symbols{}, prefixes: ?PLAIN[0], count: 1, weak: true};
pub val WEAK_DEF_SYMBOLS: List = List{key: "weak-def-symbols", versions: V3, names: Names.symbols{}, prefixes: ?PLAIN[0], count: 1, weak: true};
pub val WEAK_REF_SYMBOLS: List = List{key: "weak-ref-symbols", versions: V3, names: Names.symbols{}, prefixes: ?PLAIN[0], count: 1, weak: true};
pub val THREAD_SYMBOLS:   List = List{key: "thread-local-symbols", versions: BOTH, names: Names.symbols{}, prefixes: ?PLAIN[0], count: 1, thread: true};
pub val OBJC_CLASSES:     List = List{key: "objc-classes", versions: BOTH, names: Names.symbols{}, prefixes: ?CLASSES[0], count: 2};
pub val OBJC_EH_TYPES:    List = List{key: "objc-eh-types", versions: BOTH, names: Names.symbols{}, prefixes: ?EH_TYPES[0], count: 1};
pub val OBJC_IVARS:       List = List{key: "objc-ivars", versions: BOTH, names: Names.symbols{}, prefixes: ?IVARS[0], count: 1};
pub val RE_EXPORTS:       List = List{key: "re-exports", versions: V3, names: Names.libraries{}, prefixes: ?PLAIN[0], count: 0};
pub val LIBRARIES:        List = List{key: "libraries", versions: V4, names: Names.libraries{}, prefixes: ?PLAIN[0], count: 0};

pub val LIST_COUNT: usize             = 10;
pub val LISTS:      [LIST_COUNT]*List = [LIST_COUNT]*List{
    ?SYMBOLS, ?WEAK_SYMBOLS, ?WEAK_DEF_SYMBOLS, ?WEAK_REF_SYMBOLS, ?THREAD_SYMBOLS,
    ?OBJC_CLASSES, ?OBJC_EH_TYPES, ?OBJC_IVARS, ?RE_EXPORTS, ?LIBRARIES,
};

# what a section of lists is to the library its document describes
# ---
# key:      the document's key that holds sections of the role
# versions: the versions of the format that name it
# offers:   the section's lists state names the library offers other images,
#           as its exports and re-exports do, rather than what it needs
pub rec Role {
    key:      str;
    versions: Versions;
    offers:   bool;
}

pub val EXPORTS:              Role = Role{key: "exports", versions: BOTH, offers: true};
pub val REEXPORTS:            Role = Role{key: "reexports", versions: V4, offers: true};
pub val REEXPORTED_LIBRARIES: Role = Role{key: "reexported-libraries", versions: V4, offers: true};
pub val UNDEFINEDS:           Role = Role{key: "undefineds", versions: BOTH, offers: false};

pub val ROLE_COUNT: usize             = 4;
pub val ROLES:      [ROLE_COUNT]*Role = [ROLE_COUNT]*Role{?EXPORTS, ?REEXPORTS, ?REEXPORTED_LIBRARIES, ?UNDEFINEDS};

# a run of a table's rows: the first and how many
pub rec Run {
    first: u32;
    count: u32;
}

# a target a document or a section names: its architecture and its platform,
# as the file spells them
pub rec Target {
    arch:     Id[Name];
    platform: Id[Name];
}

# a section of lists: what it is to the library, its targets among the
# model's targets and its names among the model's entries
pub rec Section {
    role:    *Role;
    targets: Run;
    entries: Run;
}

# one name a list states
pub rec Entry {
    name: Id[Name];
    list: *List;
}

# one document, the description of one library
# ---
# version:  the version of the format it is written in, 3 or 4
# install:  the library's install name
# current:  its current version, packed as Mach-O packs a dylib version
# compat:   its compatibility version, packed the same way
# targets:  the targets it is built for, among the model's targets
# sections: its sections, among the model's sections
pub rec Document {
    version:  u32;
    install:  Id[Name];
    current:  u32;
    compat:   u32;
    targets:  Run;
    sections: Run;
}

# a whole text stub
# ---
# a:         the allocator every table lives in
# names:     every name the documents state
# documents: the documents in file order, the library the stub describes first
# targets:   every target the documents and sections name, run by run
# sections:  every section, run by document
# entries:   every name of every list, run by section
pub rec Tbd {
    a:         *A.Allocator;
    names:     Interner;
    documents: Table[Document];
    targets:   Table[Target];
    sections:  Table[Section];
    entries:   Table[Entry];
}

pub fun make(a: *A.Allocator) Tbd {
    ret Tbd{
        a:         a,
        names:     intern.make(a),
        documents: table.make[Document](a),
        targets:   table.make[Target](a),
        sections:  table.make[Section](a),
        entries:   table.make[Entry](a),
    };
}

pub fun release(t: *Tbd) err[Fail] {
    var first: err[Fail] = intern.release(?t.names);
    first = fail.kept(first, table.release[Document](?t.documents));
    first = fail.kept(first, table.release[Target](?t.targets));
    first = fail.kept(first, table.release[Section](?t.sections));
    ret fail.kept(first, table.release[Entry](?t.entries));
}

# the `k`th row of the run `r` of a table
pub fun nth(r: Run, k: usize) usize {
    ret r.first::usize + k;
}

pub fun document(t: *Tbd, i: usize) *Document {
    ret table.at[Document](?t.documents, table.nth[Document](i));
}

pub fun target(t: *Tbd, r: Run, k: usize) *Target {
    ret table.at[Target](?t.targets, table.nth[Target](nth(r, k)));
}

pub fun section(t: *Tbd, d: *Document, k: usize) *Section {
    ret table.at[Section](?t.sections, table.nth[Section](nth(d.sections, k)));
}

pub fun entry(t: *Tbd, s: *Section, k: usize) *Entry {
    ret table.at[Entry](?t.entries, table.nth[Entry](nth(s.entries, k)));
}

# whether the version `v` of the format names what `of` is named in
pub fun names(of: Versions, v: u32) bool {
    if (v == 3) { ret (of & V3) != 0; }
    if (v == 4) { ret (of & V4) != 0; }
    ret false;
}

# the list row named `key` in version `v`, none for a key no row names
pub fun list_of(key: *u8, n: usize, v: u32) opt[*List] {
    var i: usize = 0;
    for (i < LIST_COUNT) {
        val l: *List = LISTS[i];
        i = i + 1;
        if (names(l.versions, v) && spelled(key, n, l.key)) { ret opt[*List].some{l}; }
    }
    ret opt[*List].none{};
}

# the role row named `key` in version `v`, none for a key no row names
pub fun role_of(key: *u8, n: usize, v: u32) opt[*Role] {
    var i: usize = 0;
    for (i < ROLE_COUNT) {
        val r: *Role = ROLES[i];
        i = i + 1;
        if (names(r.versions, v) && spelled(key, n, r.key)) { ret opt[*Role].some{r}; }
    }
    ret opt[*Role].none{};
}

# whether the `n` bytes at `p` spell `s`
pub fun spelled(p: *u8, n: usize, s: str) bool {
    val q: *u8   = s::*u8;
    var i: usize = 0;
    for (i < n) {
        if (q[i] == 0 || q[i] != p[i]) { ret false; }
        i = i + 1;
    }
    ret q[n] == 0;
}
