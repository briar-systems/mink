# the text form of a text stub
#
# each document in file order, its install name, versions and targets, then
# each of its sections by its role, with its targets and each name of each
# list under the list's key.

use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.format.dump;
use mink.format.dump.Dumper;
use tbd_model: mink.format.tbd.model;
use mink.format.tbd.model.Document;
use mink.format.tbd.model.Entry;
use mink.format.tbd.model.Run;
use mink.format.tbd.model.Section;
use mink.format.tbd.model.Target;
use mink.format.tbd.model.Tbd;

pub val STUB:          u32 = 0;
pub val DOCUMENT:      u32 = 1;
pub val VERSION:       u32 = 2;
pub val INSTALL:       u32 = 3;
pub val CURRENT:       u32 = 4;
pub val COMPATIBILITY: u32 = 5;
pub val TARGETS:       u32 = 6;
pub val SECTION:       u32 = 7;
pub val ROLE:          u32 = 8;
pub val NAME:          u32 = 9;

pub val FIELD_COUNT: usize            = 10;
pub val FIELDS:      [FIELD_COUNT]str = [FIELD_COUNT]str{
    "TextStub", "Document", "Version", "InstallName", "CurrentVersion", "CompatibilityVersion", "Targets", "Section", "Role", "Name",
};

pub fun describe(t: *Tbd, d: *Dumper) err[Fail] {
    val w: err[Fail] = dump.open(d, STUB);
    if (sel w.err) { ret w; }
    var i: usize = 0;
    for (i < table.count[Document](?t.documents)) {
        val r: err[Fail] = document(t, tbd_model.document(t, i), d);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret dump.close(d);
}

fun document(t: *Tbd, doc: *Document, d: *Dumper) err[Fail] {
    val w1: err[Fail] = dump.open(d, DOCUMENT);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = dump.decimal(d, VERSION, doc.version::u64);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = text(t, d, INSTALL, doc.install);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = dump.hex(d, CURRENT, doc.current::u64);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = dump.hex(d, COMPATIBILITY, doc.compat::u64);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = targets(t, d, doc.targets);
    if (sel w6.err) { ret w6; }
    var k: usize = 0;
    for (k < doc.sections.count::usize) {
        val r: err[Fail] = section(t, tbd_model.section(t, doc, k), d);
        if (sel r.err) { ret r; }
        k = k + 1;
    }
    ret dump.close(d);
}

fun text(t: *Tbd, d: *Dumper, key: u32, n: Id[Name]) err[Fail] {
    val v: View = intern.bytes_of(?t.names, n);
    ret dump.name(d, key, v.data, v.len);
}

# the targets of `r`, one `arch-platform` an item
fun targets(t: *Tbd, d: *Dumper, r: Run) err[Fail] {
    val w: err[Fail] = dump.open_list(d, TARGETS);
    if (sel w.err) { ret w; }
    var k: usize = 0;
    for (k < r.count::usize) {
        val g:  *Target   = tbd_model.target(t, r, k);
        val a:  View      = intern.bytes_of(?t.names, g.arch);
        val p:  View      = intern.bytes_of(?t.names, g.platform);
        val w1: err[Fail] = dump.row(d);
        if (sel w1.err) { ret w1; }
        val w2: err[Fail] = dump.raw(d, a.data, a.len);
        if (sel w2.err) { ret w2; }
        val w3: err[Fail] = dump.char(d, '-');
        if (sel w3.err) { ret w3; }
        val w4: err[Fail] = dump.raw(d, p.data, p.len);
        if (sel w4.err) { ret w4; }
        val w5: err[Fail] = dump.char(d, '\n');
        if (sel w5.err) { ret w5; }
        k = k + 1;
    }
    ret dump.close_list(d);
}

fun section(t: *Tbd, s: *Section, d: *Dumper) err[Fail] {
    val w1: err[Fail] = dump.open(d, SECTION);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = dump.string(d, ROLE, s.role.key::*u8, str_len(s.role.key));
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = targets(t, d, s.targets);
    if (sel w3.err) { ret w3; }
    var k: usize = 0;
    for (k < s.entries.count::usize) {
        val e:  *Entry    = tbd_model.entry(t, s, k);
        val v:  View      = intern.bytes_of(?t.names, e.name);
        val w4: err[Fail] = dump.open_labelled(d, e.list.key, nil, 0);
        if (sel w4.err) { ret w4; }
        val w5: err[Fail] = dump.name(d, NAME, v.data, v.len);
        if (sel w5.err) { ret w5; }
        val w6: err[Fail] = dump.close(d);
        if (sel w6.err) { ret w6; }
        k = k + 1;
    }
    ret dump.close(d);
}
