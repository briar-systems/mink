# a text stub to the neutral object of the library it describes
#
# the stub's first document is the library, and the conversion takes the
# lists of its sections whose targets name the architecture: the link's,
# where the object states one, else the one the document's targets name. a
# target names an architecture by its Mach-O name, which the rows below code
# as Mach-O codes it, so the architecture catalog finds the row. the symbols
# of the exports and re-exports are the library's, each once, and each
# library it re-exports is a dependency that re-exports. a re-exported
# library another document of the stub describes is followed, its symbols
# offered as the first library's own, as an image binds them through the
# library it loads, and a re-export that leads back to a document on its way
# is refused. a re-exported library no document describes is recorded and
# not followed. a library's undefined symbols are what it needs, not what it
# offers, and are passed over.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Stated;
use macho_model: mink.format.macho.model.model;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;
use mink.format.macho.neutral.library;
use tbd_model: mink.format.tbd.model;
use mink.format.tbd.model.Document;
use mink.format.tbd.model.Entry;
use mink.format.tbd.model.List;
use mink.format.tbd.model.Section;
use mink.format.tbd.model.Target;
use mink.format.tbd.model.Tbd;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Versions;

# an architecture a target names, as Mach-O codes it
# ---
# name:    the Mach-O name a target spells it by
# cpu:     its cputype
# subtype: its cpusubtype
rec Named {
    name:    str;
    cpu:     *Constant;
    subtype: *Constant;
}

val NAMED_COUNT: usize              = 9;
val NAMED:       [NAMED_COUNT]Named = [NAMED_COUNT]Named{
    Named{name: "i386", cpu: ?tables.CPU_TYPE_I386, subtype: ?tables.CPU_SUBTYPE_I386_ALL},
    Named{name: "x86_64", cpu: ?tables.CPU_TYPE_X86_64, subtype: ?tables.CPU_SUBTYPE_X86_64_ALL},
    Named{name: "x86_64h", cpu: ?tables.CPU_TYPE_X86_64, subtype: ?tables.CPU_SUBTYPE_X86_64_H},
    Named{name: "armv7", cpu: ?tables.CPU_TYPE_ARM, subtype: ?tables.CPU_SUBTYPE_ARM_V7},
    Named{name: "armv7s", cpu: ?tables.CPU_TYPE_ARM, subtype: ?tables.CPU_SUBTYPE_ARM_V7S},
    Named{name: "armv7k", cpu: ?tables.CPU_TYPE_ARM, subtype: ?tables.CPU_SUBTYPE_ARM_V7K},
    Named{name: "arm64", cpu: ?tables.CPU_TYPE_ARM64, subtype: ?tables.CPU_SUBTYPE_ARM64_ALL},
    Named{name: "arm64e", cpu: ?tables.CPU_TYPE_ARM64, subtype: ?tables.CPU_SUBTYPE_ARM64E},
    Named{name: "arm64_32", cpu: ?tables.CPU_TYPE_ARM64_32, subtype: ?tables.CPU_SUBTYPE_ARM64_32_V8},
};

# the conversion's state
# ---
# t:       the stub
# o:       the object being built
# arch:    the architecture the conversion takes
# archs:   per target of the stub, the architecture it names, nil for one
#          mink has no row for
# install: per name of the stub, the index plus one of the document whose
#          install name it is, zero for none
# state:   per document, zero before it is followed, one while it is on the
#          way being followed and two once it is
# offered: per name of the object, whether a symbol of it is offered
# linked:  per name of the object, whether a dependency of it is recorded
rec Conv {
    t:       *Tbd;
    o:       *Object;
    arch:    *Arch;
    archs:   Table[*Arch];
    install: Table[u32];
    state:   Table[u8];
    offered: Table[bool];
    linked:  Table[bool];
}

# add the library the stub `t` describes to `o`, which holds nothing yet. a
# refusal leaves `o` as it was
pub fun to_neutral(t: *Tbd, o: *Object) err[Fail] {
    if (!object.empty(o)) { ret err[Fail].err{fail.internal("a model converts into an empty neutral object")}; }
    var built: Object = object.blank(o);
    var c:     Conv   = Conv{
        t:       t,
        o:       ?built,
        archs:   table.make[*Arch](t.a),
        install: table.make[u32](t.a),
        state:   table.make[u8](t.a),
        offered: table.make[bool](t.a),
        linked:  table.make[bool](t.a),
    };
    var r: err[Fail] = convert(?c);
    r = fail.kept(r, table.release[*Arch](?c.archs));
    r = fail.kept(r, table.release[u32](?c.install));
    r = fail.kept(r, table.release[u8](?c.state));
    r = fail.kept(r, table.release[bool](?c.offered));
    r = fail.kept(r, table.release[bool](?c.linked));
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?built);
        ret r;
    }
    ret object.commit(o, ?built);
}

fun convert(c: *Conv) err[Fail] {
    val t: *Tbd      = c.t;
    val i: err[Fail] = indexed(c);
    if (sel i.err) { ret i; }
    val root: *Document        = tbd_model.document(t, 0);
    val a:    res[*Arch, Fail] = arch_of(c, root, c.o.target.arch);
    if (sel a.err) { ret err[Fail].err{fail.in_indexed(a.err, "document", 0)}; }
    c.arch          = a.ok;
    c.o.target.arch = a.ok;
    val name: View      = intern.bytes_of(?t.names, root.install);
    val d:    err[Fail] = library.describe(c.o, Bytes{data: name.data, len: name.len}, Versions{current: root.current, compat: root.compat});
    if (sel d.err) { ret d; }
    ret follow(c, 0);
}

# the architecture each target names, and the document each install name is
fun indexed(c: *Conv) err[Fail] {
    val t: *Tbd  = c.t;
    var i: usize = 0;
    for (i < table.count[Target](?t.targets)) {
        val g: *Target              = table.at[Target](?t.targets, table.nth[Target](i));
        val p: res[Id[*Arch], Fail] = table.push[*Arch](?c.archs, named_arch(t, g.arch));
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    val n: usize = intern.count(?t.names);
    if (n != 0) {
        val g: res[Id[u32], Fail] = table.grow[u32](?c.install, n);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    val docs: usize             = table.count[Document](?t.documents);
    val s:    res[Id[u8], Fail] = table.grow[u8](?c.state, docs);
    if (sel s.err) { ret err[Fail].err{s.err}; }
    i = 0;
    for (i < docs) {
        val d:  *Document = tbd_model.document(t, i);
        val at: *u32      = ?table.items[u32](?c.install)[d.install.index];
        i = i + 1;
        if (@at != 0) { ret err[Fail].err{fail.in_indexed(fail.malformed("two documents of the stub describe one install name"), "document", (i - 1)::u64)}; }
        @at = i::u32;
    }
    ret err[Fail].ok{};
}

# the architecture the name `n` names, nil for one mink has no row for
fun named_arch(t: *Tbd, n: Id[Name]) *Arch {
    val row: opt[*Named] = named_row(t, n);
    if (sel row.none) { ret nil; }
    val a: res[*Arch, Fail] = library.arch_of(row.some.cpu.value::u32, row.some.subtype.value::u32);
    if (sel a.ok) { ret a.ok; }
    ret nil;
}

# the architecture the conversion takes: `want` where the document names a
# target of it, else the one architecture the document's targets name
fun arch_of(c: *Conv, d: *Document, want: *Arch) res[*Arch, Fail] {
    var one:  *Arch = nil;
    var many: bool  = false;
    var k:    usize = 0;
    for (k < d.targets.count::usize) {
        val a: *Arch = table.items[*Arch](?c.archs)[tbd_model.nth(d.targets, k)];
        k = k + 1;
        if (a == nil)                 { cnt; }
        if (want != nil && a == want) { ret res[*Arch, Fail].ok{a}; }
        if (one != nil && one != a)   { many = true; }
        one = a;
    }
    if (want != nil) { ret res[*Arch, Fail].err{fail.about(fail.unsupported("the text stub states no target of the architecture"), want.name)}; }
    if (one == nil)  { ret res[*Arch, Fail].err{fail.unsupported("the text stub states no target of an architecture mink has a row for")}; }
    if (many)        { ret res[*Arch, Fail].err{fail.unsupported("the text stub states targets of several architectures, and the conversion names none")}; }
    ret res[*Arch, Fail].ok{one};
}

# whether the section `s` names a target of the conversion's architecture
fun applies(c: *Conv, s: *Section) bool {
    var k: usize = 0;
    for (k < s.targets.count::usize) {
        if (table.items[*Arch](?c.archs)[tbd_model.nth(s.targets, k)] == c.arch) { ret true; }
        k = k + 1;
    }
    ret false;
}

# offer the symbols of the document `at` and follow the libraries it
# re-exports, refusing one already on the way
fun follow(c: *Conv, at: usize) err[Fail] {
    val t: *Tbd      = c.t;
    val d: *Document = tbd_model.document(t, at);
    table.items[u8](?c.state)[at] = 1;
    var k: usize = 0;
    for (k < d.sections.count::usize) {
        val s: *Section = tbd_model.section(t, d, k);
        k = k + 1;
        if (!s.role.offers || !applies(c, s)) { cnt; }
        var e: usize = 0;
        for (e < s.entries.count::usize) {
            val en: *Entry    = tbd_model.entry(t, s, e);
            var r:  err[Fail] = err[Fail].ok{};
            if (sel en.list.names.libraries) { r = reexported(c, en.name); }
            or                               { r = symbols(c, en); }
            if (sel r.err)                   { ret err[Fail].err{fail.in_indexed(fail.in_indexed(r.err, "name", e::u64), "section", (k - 1)::u64)}; }
            e = e + 1;
        }
    }
    table.items[u8](?c.state)[at] = 2;
    ret err[Fail].ok{};
}

# the library of install name `n` the document re-exports: a dependency, and
# followed when a document of the stub describes it
fun reexported(c: *Conv, n: Id[Name]) err[Fail] {
    val t:    *Tbd          = c.t;
    val v:    View          = intern.bytes_of(?t.names, n);
    val doc:  u32           = table.items[u32](?c.install)[n.index];
    var with: opt[Versions] = opt[Versions].none{};
    if (doc != 0) {
        val d: *Document = tbd_model.document(t, (doc - 1)::usize);
        with = opt[Versions].some{Versions{current: d.current, compat: d.compat}};
    }
    val nm: res[Id[Name], Fail] = object.name(c.o, v.data, v.len);
    if (sel nm.err) { ret err[Fail].err{nm.err}; }
    val seen: res[*bool, Fail] = mark(?c.linked, nm.ok);
    if (sel seen.err) { ret err[Fail].err{seen.err}; }
    if (!@seen.ok) {
        @seen.ok = true;
        val r: err[Fail] = library.depends(c.o, Bytes{data: v.data, len: v.len}, with, true, false);
        if (sel r.err) { ret r; }
    }
    if (doc == 0) { ret err[Fail].ok{}; }
    val state: u8 = table.items[u8](?c.state)[(doc - 1)::usize];
    if (state == 1) { ret err[Fail].err{fail.malformed("the stub's re-exported libraries form a cycle")}; }
    if (state == 2) { ret err[Fail].ok{}; }
    val f: err[Fail] = follow(c, (doc - 1)::usize);
    if (sel f.err) { ret err[Fail].err{fail.in_indexed(f.err, "document", (doc - 1)::u64)}; }
    ret err[Fail].ok{};
}

# the flag of `t` for the name `n`, the table growing to hold it
fun mark(t: *Table[bool], n: Id[Name]) res[*bool, Fail] {
    val have: usize = table.count[bool](t);
    if (n.index::usize >= have) {
        val g: res[Id[bool], Fail] = table.grow[bool](t, n.index::usize + 1 - have);
        if (sel g.err) { ret res[*bool, Fail].err{g.err}; }
    }
    ret res[*bool, Fail].ok{?table.items[bool](t)[n.index]};
}

# the symbols the entry `en` stands for, each under one of its list's
# prefixes, offered once
fun symbols(c: *Conv, en: *Entry) err[Fail] {
    val l: *List = en.list;
    val v: View  = intern.bytes_of(?c.t.names, en.name);
    var k: usize = 0;
    for (k < l.count) {
        val r: err[Fail] = prefixed(c, l, l.prefixes[k], v.data, v.len);
        if (sel r.err) { ret r; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the symbol `prefix` and the `n` bytes at `p` spell, offered once
fun prefixed(c: *Conv, l: *List, prefix: str, p: *u8, n: usize) err[Fail] {
    if (str_len(prefix) == 0) { ret offered(c, p, n, l); }
    var spelled: Sink = sink.make(c.t.a, LITTLE);
    ret fail.kept(spell(c, l, ?spelled, prefix, p, n), sink.release(?spelled));
}

fun spell(c: *Conv, l: *List, spelled: *Sink, prefix: str, p: *u8, n: usize) err[Fail] {
    val wp: err[Fail] = sink.text(spelled, prefix);
    if (sel wp.err) { ret wp; }
    val wn: err[Fail] = sink.bytes(spelled, p, n);
    if (sel wn.err) { ret wn; }
    ret offered(c, sink.data(spelled), sink.len(spelled), l);
}

fun offered(c: *Conv, p: *u8, n: usize, l: *List) err[Fail] {
    val nm: res[Id[Name], Fail] = object.name(c.o, p, n);
    if (sel nm.err) { ret err[Fail].err{nm.err}; }
    val seen: res[*bool, Fail] = mark(?c.offered, nm.ok);
    if (sel seen.err) { ret err[Fail].err{seen.err}; }
    if (@seen.ok)     { ret err[Fail].ok{}; }
    @seen.ok = true;
    ret library.offer(c.o, nm.ok, l.weak, l.thread);
}

# the row of the architecture name `n`, none for a name no row spells
fun named_row(t: *Tbd, n: Id[Name]) opt[*Named] {
    val v: View  = intern.bytes_of(?t.names, n);
    var i: usize = 0;
    for (i < NAMED_COUNT) {
        if (tbd_model.spelled(v.data, v.len, NAMED[i].name)) { ret opt[*Named].some{?NAMED[i]}; }
        i = i + 1;
    }
    ret opt[*Named].none{};
}

# what the stub states in the fields Mach-O codes an architecture by: the
# one architecture the first document's targets name, none for a stub of
# several or of none a row spells
pub fun stated(t: *Tbd) opt[Stated] {
    if (table.count[Document](?t.documents) == 0) { ret opt[Stated].none{}; }
    val d:   *Document   = tbd_model.document(t, 0);
    var one: opt[*Named] = opt[*Named].none{};
    var k:   usize       = 0;
    for (k < d.targets.count::usize) {
        val row: opt[*Named] = named_row(t, tbd_model.target(t, d.targets, k).arch);
        k = k + 1;
        if (sel row.none)                         { ret opt[Stated].none{}; }
        if (sel one.some && one.some != row.some) { ret opt[Stated].none{}; }
        one = row;
    }
    if (sel one.none) { ret opt[Stated].none{}; }
    ret opt[Stated].some{macho_model.stated(one.some.cpu.value::u32, one.some.subtype.value::u32)};
}
