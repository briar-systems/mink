# a text stub to the neutral object of the library it describes
#
# the stub's first document is the library, and the conversion takes the
# lists of its sections whose targets name the architecture: the link's,
# where the object states one, else the one the document's targets name, and
# the platform of the link's environment, where the object states one. a
# stub whose targets of the architecture name no such platform is refused,
# naming the ones they do. a target names an architecture by its Mach-O name,
# which the rows below code as Mach-O codes it, so the architecture catalog
# finds the row, and a platform by its spelling, which the rows below code as
# LC_BUILD_VERSION does. the symbols
# of the exports and re-exports are the library's, each once, and each
# library it re-exports is a dependency that re-exports. a re-exported
# library another document of the stub describes is followed, its symbols
# offered as the first library's own, as an image binds them through the
# library it loads, and a re-export that leads back to a document on its way
# is refused. a re-exported library no document describes is recorded for
# the link to follow to the input that describes it. a library's undefined
# symbols are what it needs, not what it offers, and are passed over.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Name;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.table.Id;
use mink.base.vectors;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Stated;
use mink.catalog.os.Env;
use macho_model: mink.format.macho.model.model;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;
use mink.format.macho.neutral.library;
use macho_neutral: mink.format.macho.neutral.neutral;
use tbd_model:     mink.format.tbd.model;
use mink.format.tbd.model.Document;
use mink.format.tbd.model.Entry;
use mink.format.tbd.model.List;
use mink.format.tbd.model.Section;
use mink.format.tbd.model.Target;
use mink.format.tbd.model.Tbd;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Versions;

use std.collections.vector;
use std.collections.vector.Vector;

# an architecture a target names, as Mach-O codes it
# ---
# name:    the Mach-O name a target spells it by
# cpu:     its cputype
# subtype: its cpusubtype
rec Named {
    name:    str;
    cpu:     *Constant;
    subtype: *Constant;
}

val NAMED_COUNT: usize              = 9;
val NAMED:       [NAMED_COUNT]Named = [NAMED_COUNT]Named{
    Named{name: "i386", cpu: ?tables.CPU_TYPE_I386, subtype: ?tables.CPU_SUBTYPE_I386_ALL},
    Named{name: "x86_64", cpu: ?tables.CPU_TYPE_X86_64, subtype: ?tables.CPU_SUBTYPE_X86_64_ALL},
    Named{name: "x86_64h", cpu: ?tables.CPU_TYPE_X86_64, subtype: ?tables.CPU_SUBTYPE_X86_64_H},
    Named{name: "armv7", cpu: ?tables.CPU_TYPE_ARM, subtype: ?tables.CPU_SUBTYPE_ARM_V7},
    Named{name: "armv7s", cpu: ?tables.CPU_TYPE_ARM, subtype: ?tables.CPU_SUBTYPE_ARM_V7S},
    Named{name: "armv7k", cpu: ?tables.CPU_TYPE_ARM, subtype: ?tables.CPU_SUBTYPE_ARM_V7K},
    Named{name: "arm64", cpu: ?tables.CPU_TYPE_ARM64, subtype: ?tables.CPU_SUBTYPE_ARM64_ALL},
    Named{name: "arm64e", cpu: ?tables.CPU_TYPE_ARM64, subtype: ?tables.CPU_SUBTYPE_ARM64E},
    Named{name: "arm64_32", cpu: ?tables.CPU_TYPE_ARM64_32, subtype: ?tables.CPU_SUBTYPE_ARM64_32_V8},
};

# a platform a target names: the spelling it takes and the platforms of
# LC_BUILD_VERSION it covers, a zippered library covering two
# ---
# name:   its spelling
# first:  the platform
# second: the other platform it covers, nil for none
rec Platform {
    name:   str;
    first:  *Constant;
    second: *Constant;
}

val PLATFORM_COUNT: usize                    = 18;
val PLATFORMS:      [PLATFORM_COUNT]Platform = [PLATFORM_COUNT]Platform{
    Platform{name: "macos", first: ?tables.PLATFORM_MACOS},
    Platform{name: "macosx", first: ?tables.PLATFORM_MACOS},
    Platform{name: "ios", first: ?tables.PLATFORM_IOS},
    Platform{name: "tvos", first: ?tables.PLATFORM_TVOS},
    Platform{name: "watchos", first: ?tables.PLATFORM_WATCHOS},
    Platform{name: "bridgeos", first: ?tables.PLATFORM_BRIDGEOS},
    Platform{name: "maccatalyst", first: ?tables.PLATFORM_MACCATALYST},
    Platform{name: "iosmac", first: ?tables.PLATFORM_MACCATALYST},
    Platform{name: "zippered", first: ?tables.PLATFORM_MACOS, second: ?tables.PLATFORM_MACCATALYST},
    Platform{name: "ios-simulator", first: ?tables.PLATFORM_IOSSIMULATOR},
    Platform{name: "tvos-simulator", first: ?tables.PLATFORM_TVOSSIMULATOR},
    Platform{name: "watchos-simulator", first: ?tables.PLATFORM_WATCHOSSIMULATOR},
    Platform{name: "driverkit", first: ?tables.PLATFORM_DRIVERKIT},
    Platform{name: "xros", first: ?tables.PLATFORM_VISIONOS},
    Platform{name: "visionos", first: ?tables.PLATFORM_VISIONOS},
    Platform{name: "xros-simulator", first: ?tables.PLATFORM_VISIONOSSIMULATOR},
    Platform{name: "visionos-simulator", first: ?tables.PLATFORM_VISIONOSSIMULATOR},
    Platform{name: "firmware", first: ?tables.PLATFORM_FIRMWARE},
};

# the conversion's state
# ---
# t:       the stub
# o:       the object being built
# env:     the environment the link runs under, none for none stated
# arch:    the architecture the conversion takes
# archs:   per target of the stub, the architecture it names, nil for one
#          mink has no row for
# install: per name of the stub, the index plus one of the document whose
#          install name it is, zero for none
# state:   per document, zero before it is followed, one while it is on the
#          way being followed and two once it is
# offered: per name of the object, whether a symbol of it is offered
# linked:  per name of the object, whether a dependency of it is recorded
rec Conv {
    t:       *Tbd;
    o:       *Object;
    env:     opt[*Env];
    arch:    *Arch;
    archs:   Vector[*Arch];
    install: Vector[u32];
    state:   Vector[u8];
    offered: Vector[bool];
    linked:  Vector[bool];
}

# add the library the stub `t` describes to `o`, which holds nothing yet. a
# refusal leaves `o` as it was
pub fun to_neutral(t: *Tbd, o: *Object) err[Fail] {
    if (!object.is_empty(o)) { ret err[Fail].err{fail.internal("a model converts into an empty neutral object")}; }
    var built: Object = object.blank_init(o);
    var c:     Conv   = Conv{
        t:       t,
        o:       ?built,
        env:     o.target.env,
        archs:   vector.init[*Arch](t.a),
        install: vector.init[u32](t.a),
        state:   vector.init[u8](t.a),
        offered: vector.init[bool](t.a),
        linked:  vector.init[bool](t.a),
    };
    var err_convert: err[Fail] = convert(?c);
    err_convert = fail.kept(err_convert, vectors.dnit[*Arch](?c.archs));
    err_convert = fail.kept(err_convert, vectors.dnit[u32](?c.install));
    err_convert = fail.kept(err_convert, vectors.dnit[u8](?c.state));
    err_convert = fail.kept(err_convert, vectors.dnit[bool](?c.offered));
    err_convert = fail.kept(err_convert, vectors.dnit[bool](?c.linked));
    if (sel err_convert.err) {
        val err_dropped: err[Fail] = object.dnit(?built);
        ret err_convert;
    }
    ret object.commit(o, ?built);
}

fun convert(c: *Conv) err[Fail] {
    val t:           *Tbd      = c.t;
    val err_indexed: err[Fail] = indexed(c);
    if (sel err_indexed.err) { ret err_indexed; }
    val root:        *Document        = tbd_model.document(t, 0);
    val res_arch_of: res[*Arch, Fail] = arch_of(c, root, c.o.target.arch);
    if (sel res_arch_of.err) { ret err[Fail].err{fail.in_indexed(res_arch_of.err, "document", 0)}; }
    val err_platformed: err[Fail] = platformed(c, root, res_arch_of.ok);
    if (sel err_platformed.err) { ret err[Fail].err{fail.in_indexed(err_platformed.err, "document", 0)}; }
    c.arch          = res_arch_of.ok;
    c.o.target.arch = res_arch_of.ok;
    val name:         View      = intern.bytes_of(?t.names, root.install);
    val err_describe: err[Fail] = library.describe(c.o, Bytes{data: name.data, len: name.len}, Versions{current: root.current, compat: root.compat});
    if (sel err_describe.err) { ret err_describe; }
    ret follow(c, 0);
}

# the architecture each target names, and the document each install name is
fun indexed(c: *Conv) err[Fail] {
    val t: *Tbd  = c.t;
    var i: usize = 0;
    for (i < vector.length[Target](?t.targets)) {
        val g:                *Target   = ?t.targets.data[i];
        val err_archs_pushed: err[Fail] = vectors.push[*Arch](?c.archs, named_arch(t, g.arch));
        if (sel err_archs_pushed.err) { ret err[Fail].err{err_archs_pushed.err}; }
        i = i + 1;
    }
    val n: usize = intern.count(?t.names);
    if (n != 0) {
        val err_grow: err[Fail] = vectors.grow[u32](?c.install, n);
        if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    }
    val docs:     usize     = vector.length[Document](?t.documents);
    val err_grow: err[Fail] = vectors.grow[u8](?c.state, docs);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    i = 0;
    for (i < docs) {
        val d:  *Document = tbd_model.document(t, i);
        val at: *u32      = ?c.install.data[d.install.index];
        i = i + 1;
        if (@at != 0) { ret err[Fail].err{fail.in_indexed(fail.malformed("two documents of the stub describe one install name"), "document", (i - 1)::u64)}; }
        @at = i::u32;
    }
    ret err[Fail].ok{};
}

# the architecture the name `n` names, nil for one mink has no row for
fun named_arch(t: *Tbd, n: Id[Name]) *Arch {
    val opt_row: opt[*Named] = named_row(t, n);
    if (sel opt_row.none) { ret nil; }
    val res_arch_of: res[*Arch, Fail] = library.arch_of(opt_row.some.cpu.value::u32, opt_row.some.subtype.value::u32);
    if (sel res_arch_of.ok) { ret res_arch_of.ok; }
    ret nil;
}

# the architecture the conversion takes: `want` where the document names a
# target of it, else the one architecture the document's targets name
fun arch_of(c: *Conv, d: *Document, want: *Arch) res[*Arch, Fail] {
    var one:  *Arch = nil;
    var many: bool  = false;
    var k:    usize = 0;
    for (k < d.targets.count::usize) {
        val a: *Arch = c.archs.data[tbd_model.nth(d.targets, k)];
        k = k + 1;
        if (a == nil)                 { cnt; }
        if (want != nil && a == want) { ret res[*Arch, Fail].ok{a}; }
        if (one != nil && one != a)   { many = true; }
        one = a;
    }
    if (want != nil) { ret res[*Arch, Fail].err{fail.about(fail.unsupported("the text stub states no target of the architecture"), want.name)}; }
    if (one == nil)  { ret res[*Arch, Fail].err{fail.unsupported("the text stub states no target of an architecture mink has a row for")}; }
    if (many)        { ret res[*Arch, Fail].err{fail.unsupported("the text stub states targets of several architectures, and the conversion names none")}; }
    ret res[*Arch, Fail].ok{one};
}

# the row of the platform `n`, none for a spelling no row knows
fun platform_row(c: *Conv, n: Id[Name]) opt[*Platform] {
    val v: View  = intern.bytes_of(?c.t.names, n);
    var i: usize = 0;
    for (i < PLATFORM_COUNT) {
        val p: *Platform = ?PLATFORMS[i];
        i = i + 1;
        if (store.compare_text(p.name, Bytes{data: v.data, len: v.len}) == 0) { ret opt[*Platform].some{p}; }
    }
    ret opt[*Platform].none{};
}

# whether the platform `n` is the link's: none stated takes every platform,
# and a spelling no row knows is no platform of the environment
fun on_platform(c: *Conv, n: Id[Name]) bool {
    if (sel c.env.none) { ret true; }
    val opt_code: opt[u32] = macho_neutral.platform_of(c.env.some);
    if (sel opt_code.none) { ret true; }
    val opt_row: opt[*Platform] = platform_row(c, n);
    if (sel opt_row.none) { ret false; }
    val p: *Platform = opt_row.some;
    if (p.first.value == opt_code.some::u64) { ret true; }
    ret p.second != nil && p.second.value == opt_code.some::u64;
}

# refuse a document whose targets of the architecture `a` name no platform of
# the link's environment, naming the first platform they state by its row, as
# the model's names go with the model and the failure outlives it
fun platformed(c: *Conv, d: *Document, a: *Arch) err[Fail] {
    var known: str   = nil;
    var k:     usize = 0;
    for (k < d.targets.count::usize) {
        val at: usize   = tbd_model.nth(d.targets, k);
        val g:  *Target = ?c.t.targets.data[at];
        k = k + 1;
        if (c.archs.data[at] != a)      { cnt; }
        if (on_platform(c, g.platform)) { ret err[Fail].ok{}; }
        val opt_row: opt[*Platform] = platform_row(c, g.platform);
        if (known == nil) {
            if (sel opt_row.some) { known = opt_row.some.name; }
        }
    }
    ret err[Fail].err{fail.about(fail.unsupported("the text stub states no target of the link's platform, this being the first it states"), known)};
}

# whether the section `s` names a target of the conversion's architecture on
# the link's platform
fun applies(c: *Conv, s: *Section) bool {
    var k: usize = 0;
    for (k < s.targets.count::usize) {
        val at: usize   = tbd_model.nth(s.targets, k);
        val g:  *Target = ?c.t.targets.data[at];
        if (c.archs.data[at] == c.arch && on_platform(c, g.platform)) { ret true; }
        k = k + 1;
    }
    ret false;
}

# offer the symbols of the document `at` and follow the libraries it
# re-exports, refusing one already on the way
fun follow(c: *Conv, at: usize) err[Fail] {
    val t: *Tbd      = c.t;
    val d: *Document = tbd_model.document(t, at);
    c.state.data[at] = 1;
    var k: usize = 0;
    for (k < d.sections.count::usize) {
        val s: *Section = tbd_model.section(t, d, k);
        k = k + 1;
        if (!s.role.offers || !applies(c, s)) { cnt; }
        var e: usize = 0;
        for (e < s.entries.count::usize) {
            val en:             *Entry    = tbd_model.entry(t, s, e);
            var err_reexported: err[Fail] = err[Fail].ok{};
            if (sel en.list.names.libraries) { err_reexported = reexported(c, en.name); }
            or                               { err_reexported = symbols(c, en); }
            if (sel err_reexported.err)      { ret err[Fail].err{fail.in_indexed(fail.in_indexed(err_reexported.err, "name", e::u64), "section", (k - 1)::u64)}; }
            e = e + 1;
        }
    }
    c.state.data[at] = 2;
    ret err[Fail].ok{};
}

# the library of install name `n` the document re-exports: a dependency, and
# followed when a document of the stub describes it
fun reexported(c: *Conv, n: Id[Name]) err[Fail] {
    val t:        *Tbd          = c.t;
    val v:        View          = intern.bytes_of(?t.names, n);
    val doc:      u32           = c.install.data[n.index];
    var opt_with: opt[Versions] = opt[Versions].none{};
    if (doc != 0) {
        val d: *Document = tbd_model.document(t, (doc - 1)::usize);
        opt_with = opt[Versions].some{Versions{current: d.current, compat: d.compat}};
    }
    val res_name: res[Id[Name], Fail] = object.name(c.o, v.data, v.len);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    val res_seen: res[*bool, Fail] = mark(?c.linked, res_name.ok);
    if (sel res_seen.err) { ret err[Fail].err{res_seen.err}; }
    if (!@res_seen.ok) {
        @res_seen.ok = true;
        val err_depends: err[Fail] = library.depends(c.o, Bytes{data: v.data, len: v.len}, opt_with, library.Linked{reexports: true});
        if (sel err_depends.err) { ret err_depends; }
    }
    if (doc == 0) { ret err[Fail].ok{}; }
    val state: u8 = c.state.data[(doc - 1)::usize];
    if (state == 1) { ret err[Fail].err{fail.malformed("the stub's re-exported libraries form a cycle")}; }
    if (state == 2) { ret err[Fail].ok{}; }
    val err_follow: err[Fail] = follow(c, (doc - 1)::usize);
    if (sel err_follow.err) { ret err[Fail].err{fail.in_indexed(err_follow.err, "document", (doc - 1)::u64)}; }
    ret err[Fail].ok{};
}

# the flag of `t` for the name `n`, the table growing to hold it
fun mark(t: *Vector[bool], n: Id[Name]) res[*bool, Fail] {
    val have: usize = vector.length[bool](t);
    if (n.index::usize >= have) {
        val err_grow: err[Fail] = vectors.grow[bool](t, n.index::usize + 1 - have);
        if (sel err_grow.err) { ret res[*bool, Fail].err{err_grow.err}; }
    }
    ret res[*bool, Fail].ok{?t.data[n.index]};
}

# the symbols the entry `en` stands for, each under one of its list's
# prefixes, offered once
fun symbols(c: *Conv, en: *Entry) err[Fail] {
    val l: *List = en.list;
    val v: View  = intern.bytes_of(?c.t.names, en.name);
    var k: usize = 0;
    for (k < l.count) {
        val err_prefixed: err[Fail] = prefixed(c, l, l.prefixes[k], v.data, v.len);
        if (sel err_prefixed.err) { ret err_prefixed; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the symbol `prefix` and the `n` bytes at `p` spell, offered once
fun prefixed(c: *Conv, l: *List, prefix: str, p: *u8, n: usize) err[Fail] {
    if (str_len(prefix) == 0) { ret offered(c, p, n, l); }
    var spelled: Sink = sink.init(c.t.a, LITTLE);
    ret fail.kept(spell(c, l, ?spelled, prefix, p, n), sink.dnit(?spelled));
}

fun spell(c: *Conv, l: *List, spelled: *Sink, prefix: str, p: *u8, n: usize) err[Fail] {
    val err_text: err[Fail] = sink.text(spelled, prefix);
    if (sel err_text.err) { ret err_text; }
    val err_bytes: err[Fail] = sink.bytes(spelled, p, n);
    if (sel err_bytes.err) { ret err_bytes; }
    ret offered(c, sink.data(spelled), sink.len(spelled), l);
}

fun offered(c: *Conv, p: *u8, n: usize, l: *List) err[Fail] {
    val res_name: res[Id[Name], Fail] = object.name(c.o, p, n);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    val res_seen: res[*bool, Fail] = mark(?c.offered, res_name.ok);
    if (sel res_seen.err) { ret err[Fail].err{res_seen.err}; }
    if (@res_seen.ok)     { ret err[Fail].ok{}; }
    @res_seen.ok = true;
    ret library.offer(c.o, res_name.ok, l.weak, l.thread);
}

# the row of the architecture name `n`, none for a name no row spells
fun named_row(t: *Tbd, n: Id[Name]) opt[*Named] {
    val v: View  = intern.bytes_of(?t.names, n);
    var i: usize = 0;
    for (i < NAMED_COUNT) {
        if (store.compare_text(NAMED[i].name, Bytes{data: v.data, len: v.len}) == 0) { ret opt[*Named].some{?NAMED[i]}; }
        i = i + 1;
    }
    ret opt[*Named].none{};
}

# what the stub states in the fields Mach-O codes an architecture by: the
# one architecture the first document's targets name, none for a stub of
# several or of none a row spells
pub fun stated(t: *Tbd) opt[Stated] {
    if (vector.length[Document](?t.documents) == 0) { ret opt[Stated].none{}; }
    val d:       *Document   = tbd_model.document(t, 0);
    var opt_one: opt[*Named] = opt[*Named].none{};
    var k:       usize       = 0;
    for (k < d.targets.count::usize) {
        val opt_row: opt[*Named] = named_row(t, tbd_model.target(t, d.targets, k).arch);
        k = k + 1;
        if (sel opt_row.none)                                 { ret opt[Stated].none{}; }
        if (sel opt_one.some && opt_one.some != opt_row.some) { ret opt[Stated].none{}; }
        opt_one = opt_row;
    }
    if (sel opt_one.none) { ret opt[Stated].none{}; }
    ret opt[Stated].some{macho_model.stated(opt_one.some.cpu.value::u32, opt_one.some.subtype.value::u32)};
}
