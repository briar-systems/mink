# the resource file format and its registration
#
# a 32-bit resource file, as a resource compiler writes one, holds the
# resources a program carries, which a PE link builds into the image's
# resource tree. it is read, dumped and converted to the neutral object of
# its resources, a relocatable object that names no architecture. mink writes
# no resource file.

use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Stated;
use mink.catalog.format;
use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.format.contract.Carry;
use mink.format.contract.Codec;
use mink.format.contract.Identify;
use mink.format.contract.Input;
use mink.format.contract.Kinds;
use mink.format.contract.Magic;
use mink.format.contract.Magics;
use mink.format.contract.Neutral;
use mink.format.contract.Normalize;
use mink.format.contract.Revision;
use mink.format.dump.Dumper;
use mink.format.registration.Registration;
use res_dump:  mink.format.res.dump;
use res_model: mink.format.res.model;
use mink.format.res.model.Res;
use res_neutral: mink.format.res.neutral;
use res_read:    mink.format.res.read;
use mink.lower.Lowering;
use mink.model.object.Object;
use mink.model.target.Target;
use mink.reloc.row;

pub val REVISION_COUNT: usize = 1;

pub val REVISIONS: [REVISION_COUNT]Revision = [REVISION_COUNT]Revision{
    Revision{spec: "Microsoft Win32 RESOURCEHEADER structure and resource file format", revision: "Microsoft Learn pages as read on 24 October 2026"},
};

# the empty resource every 32-bit resource file starts with: no data, a
# header of 32 bytes, and the number zero as its type and as its name
val MAGIC_BYTES: [16]u8   = [16]u8{0, 0, 0, 0, 0x20, 0, 0, 0, 0xff, 0xff, 0, 0, 0xff, 0xff, 0, 0};
val MAGICS:      [1]Magic = [1]Magic{Magic{offset: 0, bytes: ?MAGIC_BYTES[0], len: 16}};

val CODEC: Codec = Codec{
    identify: Identify.magics{Magics{rows: ?MAGICS[0], count: 1}},
    read:     read_ops,
    write:    write_ops,
    dump:     dump_ops,
    kind:     kind_ops,
    stated:   stated_ops,
    locate:   locate_ops,
    release:  release_ops,
};

# a resource file converts as a relocatable object of resources alone
val KINDS:   [1]*Kind = [1]*Kind{?kind.RELOCATABLE};
val NEUTRAL: Neutral  = Neutral{to: to_neutral_ops, from: from_neutral_ops, ct: Carry.none{}, kinds: Kinds{rows: ?KINDS[0], count: 1}, normalize: opt[Normalize].none{}, bridges: false};

pub val REGISTRATION: Registration = Registration{
    format:         ?format.RES,
    codec:          opt[*Codec].some{?CODEC},
    neutral:        opt[*Neutral].some{?NEUTRAL},
    revisions:      ?REVISIONS[0],
    revision_count: REVISION_COUNT,
    fields:         ?res_dump.FIELDS[0],
    field_count:    res_dump.FIELD_COUNT,
};

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val r: res[Res, Fail] = res_read.read(a, in);
    if (sel r.err) { ret res[ptr, Fail].err{r.err}; }
    val p: res[*Res, A.Error] = A.allocate[Res](a, 1);
    if (sel p.err) {
        var dead:    Res       = r.ok;
        val dropped: err[Fail] = res_model.release(?dead);
        ret res[ptr, Fail].err{fail.refused(p.err)};
    }
    @p.ok = r.ok;
    ret res[ptr, Fail].ok{p.ok::ptr};
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret res[Sink, Fail].err{fail.in_record(fail.unsupported("mink writes no resource file"), format.RES.name)};
}

fun dump_ops(m: ptr, rows: *row.Registry, d: *Dumper) err[Fail] {
    ret res_dump.describe(m::*Res, d);
}

fun kind_ops(m: ptr) res[*Kind, Fail] {
    ret res[*Kind, Fail].ok{?kind.RELOCATABLE};
}

# a resource file names no architecture
fun stated_ops(m: ptr) opt[Stated] {
    ret opt[Stated].none{};
}

# the resource whose header or data holds the byte, the last whose header
# starts at or before it
fun locate_ops(m: ptr, offset: u64) Location {
    val r:  *Res  = m::*Res;
    var lo: usize = 0;
    var hi: usize = res_model.count(r);
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (res_model.at(r, mid).offset <= offset) { lo = mid + 1; }
        or                                         { hi = mid; }
    }
    if (lo == 0) { ret Location{offset: offset, placed: true}; }
    ret Location{record: "resource", index: (lo - 1)::u64, indexed: true, offset: offset, placed: true};
}

fun release_ops(a: *A.Allocator, m: ptr) err[Fail] {
    val r: *Res         = m::*Res;
    val e: err[Fail]    = res_model.release(r);
    val d: err[A.Error] = A.deallocate[Res](a, r, 1);
    if (sel e.err) { ret e; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}

fun to_neutral_ops(m: ptr, rows: *row.Registry, o: *Object) err[Fail] {
    ret res_neutral.to_neutral(m::*Res, o);
}

fun from_neutral_ops(a: *A.Allocator, rows: *row.Registry, o: *Object, t: *Target, l: opt[*Lowering]) res[ptr, Fail] {
    ret res[ptr, Fail].err{fail.in_record(fail.unsupported("mink writes no resource file"), format.RES.name)};
}
