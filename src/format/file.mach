# files as inputs and outputs
#
# a file is read whole into memory a model can borrow from, and a sink is
# written whole to a path or to an open file. every refusal is a located
# failure naming the path.

use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.io.writer;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.contract.Input;

# input: the file as an input, borrowing bytes
# bytes: the file's contents, owned
pub rec Loaded {
    input: Input;
    bytes: Vector[u8];
}

pub val MODE: i32 = 0o644;

# the mode of an image a loader maps or enters
pub val RUNNABLE: i32 = 0o755;

# the whole of the file at `path`
pub fun load(a: *A.Allocator, path: str) res[Loaded, Fail] {
    val r: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel r.err) { ret res[Loaded, Fail].err{refusal(r.err, "cannot read the file", path)}; }
    ret res[Loaded, Fail].ok{Loaded{input: Input{file: path, data: r.ok.data, len: r.ok.len}, bytes: r.ok}};
}

# give back what `l` owns
pub fun unload(l: *Loaded) err[Fail] {
    val r: err[A.Error] = vector.dnit[u8](?l.bytes);
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}

# write the bytes of `s` to the file at `path`, replacing it
pub fun save(path: str, s: *Sink) err[Fail] {
    ret save_mode(path, s, MODE);
}

# write the bytes of `s` to the file at `path` with the permission bits `mode`,
# replacing it whole or leaving what was there, never a partial file
pub fun save_mode(path: str, s: *Sink, mode: i32) err[Fail] {
    val r: err[fs.FsError] = fs.replace_bytes_atomic(s.bytes.a, path, sink.data(s), sink.len(s), mode, RUNNABLE);
    if (sel r.err) { ret err[Fail].err{refusal(r.err, "cannot write the file", path)}; }
    ret err[Fail].ok{};
}

# write the bytes of `s` to the open file `f`
pub fun emit(f: fs.File, s: *Sink) err[Fail] {
    var w: writer.Writer          = fs.writer(f);
    val r: err[writer.WriteError] = writer.write_all(?w, sink.data(s), sink.len(s));
    if (sel r.err) { ret err[Fail].err{written(r.err, "cannot write the output")}; }
    ret err[Fail].ok{};
}

# the failure of `text` for the writer's refusal `e`, with the host's reason
# when the writer names one
pub fun written(e: writer.WriteError, text: str) Fail {
    if (sel e.native) { ret fail.because(fail.io(text), io_error.kind_name(e.native.error.kind)); }
    ret fail.io(text);
}

# the failure of `text` about `path` for the filesystem's refusal `e`, with
# the host's reason
pub fun refusal(e: fs.FsError, text: str, path: str) Fail {
    if (sel e.alloc)     { ret fail.refused(e.alloc); }
    if (sel e.io)        { ret io_refusal(e.io, text, path); }
    if (sel e.published) { ret io_refusal(e.published, text, path); }
    ret fail.in_file(fail.io(text), path);
}

# the failure of `text` about `path` for the host's refusal `e`
pub fun io_refusal(e: io_error.Error, text: str, path: str) Fail {
    ret fail.because(fail.in_file(fail.io(text), path), io_error.kind_name(e.kind));
}
