# the ELF format and its registration
#
# the exact revision of each specification the ELF modules implement, so a
# change to any of them is a visible version bump, and the rows the ELF
# modules declare, named once.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.bytes.sink.Sink;
use mink.catalog.format;
use mink.catalog.kind.Kind;
use mink.format.contract.Codec;
use mink.format.contract.Identify;
use mink.format.contract.Input;
use mink.format.contract.Magic;
use mink.format.contract.Magics;
use mink.format.contract.Naming;
use mink.format.contract.Neutral;
use mink.format.contract.Revision;
use mink.format.contract.TraitCodec;
use mink.format.elf.dump;
use mink.format.elf.model.kind;
use mink.format.elf.model.model;
use mink.format.elf.model.model.Elf;
use mink.format.elf.neutral.naming;
use mink.format.elf.neutral.neutral;
use mink.format.elf.pairs;
use mink.format.elf.read;
use elf_convention: mink.format.elf.rules.convention;
use elf_image:      mink.format.elf.rules.image;
use mink.format.elf.rules.traits;
use mink.format.elf.write;
use mink.format.registration.Registration;
use mink.link.common;
use mink.link.consume;
use mink.link.image.Writer;
use mink.link.layout.Participants;
use mink.link.linking.Linking;
use mink.link.linking.Synthesizers;
use mink.link.relocate.Weak;
use mink.link.reserve;
use mink.link.reserve.Declarer;
use mink.link.reserve.Declarers;
use mink.link.resolve;
use mink.link.synthesizer;
use mink.lower.Lowering;
use mink.model.object.Object;
use mink.model.target.Target;

pub val REVISION_COUNT: usize = 5;

pub val REVISIONS: [REVISION_COUNT]Revision = [REVISION_COUNT]Revision{
    Revision{spec: "System V ABI, generic (gABI)", revision: "draft of 10 June 2013"},
    Revision{spec: "System V ABI, AMD64 architecture processor supplement (x86-64 psABI)", revision: "commit e178c71028bb of 2024-11-16, object-files"},
    Revision{spec: "System V ABI, Intel386 architecture processor supplement (i386 psABI)", revision: "commit 0f7f362e3f9b of 2021-07-01, object-files"},
    Revision{spec: "ELF for the Arm 64-bit Architecture (aaelf64)", revision: "2025Q4"},
    Revision{spec: "RISC-V ELF psABI", revision: "draft-20260924-ba299f24a504627f79bceabf84bb0a6997a5e13d"},
};

val MAGIC_BYTES: [4]u8    = [4]u8{0x7f, 'E', 'L', 'F'};
val MAGICS:      [1]Magic = [1]Magic{Magic{offset: 0, bytes: ?MAGIC_BYTES[0], len: 4}};

val CODEC: Codec = Codec{
    identify: Identify.magics{Magics{rows: ?MAGICS[0], count: 1}},
    read:     read_ops,
    write:    write_ops,
    dump:     dump.dump,
    kind:     kind_ops,
    locate:   locate_ops,
    release:  release_ops,
};

val NEUTRAL: Neutral = Neutral{to: to_neutral_ops, from: from_neutral_ops};

# the sections that are not image content an ELF link takes
val USE_COUNT: usize                   = 3;
val USES:      [USE_COUNT]*consume.Row = [USE_COUNT]*consume.Row{?consume.SIGNIFICANCE, ?consume.STRINGS, ?consume.STACK};

val SYNTHESIZER_COUNT: usize                               = 1;
val SYNTHESIZERS:      [SYNTHESIZER_COUNT]*synthesizer.Row = [SYNTHESIZER_COUNT]*synthesizer.Row{?common.ROW};

val DECLARER_COUNT: usize                     = 2;
val DECLARERS:      [DECLARER_COUNT]*Declarer = [DECLARER_COUNT]*Declarer{?reserve.HEADER_TABLE, ?elf_image.TABLES};

# GNU ld searches an archive once where it stands, and a common definition
# pulls a member that defines its name as data, as its archive search includes
# the member when it defines a symbol held as common
# (elf_link_add_archive_symbols in bfd/elflink.c). lld does so only with
# --fortran-common, which the row does not follow, since a mink link takes GNU
# ld as the reference. an undefined weak reference resolves to zero
val LINKING: Linking = Linking{
    caps:         0,
    search:       resolve.COMMON_PULL,
    hooks:        ?resolve.PLAIN,
    weak:         Weak.zero{},
    layout:       ?elf_convention.LAYOUT,
    dynamic:      ?elf_convention.DYNAMIC,
    facts:        ?elf_convention.FACTS,
    writer:       opt[*Writer].some{?elf_image.WRITER},
    declarers:    Declarers{rows: ?DECLARERS[0], count: DECLARER_COUNT},
    measures:     elf_image.MEASURES,
    uses:         consume.Uses{rows: ?USES[0], count: USE_COUNT},
    synthesizers: Synthesizers{rows: ?SYNTHESIZERS[0], count: SYNTHESIZER_COUNT},
    participants: Participants{rows: nil, count: 0},
};

pub val REGISTRATION: Registration = Registration{
    format:         ?format.ELF,
    codec:          opt[*Codec].some{?CODEC},
    traits:         opt[*TraitCodec].some{?traits.CODEC},
    naming:         opt[*Naming].some{?naming.NAMING},
    neutral:        opt[*Neutral].some{?NEUTRAL},
    lowering:       opt[*Lowering].some{?neutral.LOWERING},
    pairs:          ?pairs.PAIRS[0],
    pair_count:     pairs.COUNT,
    link:           opt[*Linking].some{?LINKING},
    revisions:      ?REVISIONS[0],
    revision_count: REVISION_COUNT,
    fields:         ?dump.FIELDS[0],
    field_count:    dump.FIELD_COUNT,
};

# a model moved to the heap, which the registration hands around as a pointer
fun boxed(a: *A.Allocator, m: Elf) res[ptr, Fail] {
    val p: res[*Elf, A.Error] = A.allocate[Elf](a, 1);
    if (sel p.err) {
        var dead:    Elf       = m;
        val dropped: err[Fail] = model.release(?dead);
        ret res[ptr, Fail].err{fail.refused(p.err)};
    }
    val slot: *Elf = p.ok;
    @slot = m;
    ret res[ptr, Fail].ok{slot::ptr};
}

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val m: res[Elf, Fail] = read.read(a, in);
    if (sel m.err) { ret res[ptr, Fail].err{m.err}; }
    ret boxed(a, m.ok);
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret write.write(a, m::*Elf);
}

fun kind_ops(m: ptr) res[*Kind, Fail] {
    ret kind.of(m::*Elf);
}

fun to_neutral_ops(m: ptr, o: *Object) err[Fail] {
    ret neutral.to_neutral(m::*Elf, o);
}

fun from_neutral_ops(a: *A.Allocator, o: *Object, t: *Target, l: opt[*Lowering]) res[ptr, Fail] {
    val m: res[Elf, Fail] = neutral.from_neutral(a, o, t, l);
    if (sel m.err) { ret res[ptr, Fail].err{m.err}; }
    ret boxed(a, m.ok);
}

fun locate_ops(m: ptr, offset: u64) Location {
    ret model.locate(m::*Elf, offset);
}

fun release_ops(a: *A.Allocator, m: ptr) err[Fail] {
    val e: *Elf         = m::*Elf;
    val r: err[Fail]    = model.release(e);
    val d: err[A.Error] = A.deallocate[Elf](a, e, 1);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}
