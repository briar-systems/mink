use mink.model.target.Target;
use mink.reloc.row;

pub val REVISION_COUNT: usize = 5;

pub val REVISIONS: [REVISION_COUNT]Revision = [REVISION_COUNT]Revision{
    Revision{spec: "System V ABI, generic (gABI)", revision: "draft of 10 June 2013"},
    Revision{spec: "System V ABI, AMD64 architecture processor supplement (x86-64 psABI)", revision: "commit e178c71028bb of 2024-11-16, object-files"},
    Revision{spec: "System V ABI, Intel386 architecture processor supplement (i386 psABI)", revision: "commit 0f7f362e3f9b of 2021-07-01, object-files"},
    Revision{spec: "ELF for the Arm 64-bit Architecture (aaelf64)", revision: "2025Q4"},
    Revision{spec: "RISC-V ELF psABI", revision: "draft-20260924-ba299f24a504627f79bceabf84bb0a6997a5e13d"},
};

val MAGIC_BYTES: [4]u8    = [4]u8{0x7f, 'E', 'L', 'F'};
val MAGICS:      [1]Magic = [1]Magic{Magic{offset: 0, bytes: ?MAGIC_BYTES[0], len: 4}};

val CODEC: Codec = Codec{
    identify: Identify.magics{Magics{rows: ?MAGICS[0], count: 1}},
    read:     read_ops,
    write:    write_ops,
    dump:     dump.dump,
    kind:     kind_ops,
    stated:   stated_ops,
    locate:   locate_ops,
    release:  release_ops,
};

# a relocatable object, and a shared object, which converts to the library
# it describes, are the kinds of file its conversion takes
val KINDS:   [3]*Kind = [3]*Kind{?catalog_kind.RELOCATABLE, ?catalog_kind.SHARED, ?catalog_kind.PIE_SHARED};
val NEUTRAL: Neutral  = Neutral{to: to_neutral_ops, from: from_neutral_ops, ct: Carry.note{}, kinds: Kinds{rows: ?KINDS[0], count: 3}, normalize: opt[Normalize].none{}};

# how ELF encodes the trait axes
val TRAITS: TraitCodec = TraitCodec{
    encodings: ?traits.ENCODINGS[0],
    count:     traits.ROW_COUNT,
    attribute: traits.attribute_axis,
    setting:   traits.setting,
    holds:     traits.holds_traits,
    raise:     raise.raise,
};

# the sections that are not image content an ELF link takes
val USE_COUNT: usize                   = 3;
val USES:      [USE_COUNT]*consume.Row = [USE_COUNT]*consume.Row{?consume.SIGNIFICANCE, ?consume.STRINGS, ?consume.STACK};

val SYNTHESIZER_COUNT: usize                               = 1;
val SYNTHESIZERS:      [SYNTHESIZER_COUNT]*synthesizer.Row = [SYNTHESIZER_COUNT]*synthesizer.Row{?common.ROW};

# relaxation rewrites the relocations whose rows state forms, as a RISC-V
# ALIGN deletes the padding its alignment does not need, and thunks send a
# branch past its reach through a veneer in an island
val PARTICIPANT_COUNT: usize                           = 2;
val PARTICIPANTS:      [PARTICIPANT_COUNT]*Participant = [PARTICIPANT_COUNT]*Participant{?relax.RELAX, ?thunk.THUNKS};

val DECLARER_COUNT: usize                     = 4;
val DECLARERS:      [DECLARER_COUNT]*Declarer = [DECLARER_COUNT]*Declarer{?reserve.HEADER_TABLE, ?elf_image.TABLES, ?elf_dynamic.TABLES, ?elf_convention.SLOTS};

# GNU ld searches an archive once where it stands, and a common definition
# pulls a member that defines its name as data, as its archive search includes
# the member when it defines a symbol held as common
# (elf_link_add_archive_symbols in bfd/elflink.c). lld does so only with
# --fortran-common, which the row does not follow, since a mink link takes GNU
# ld as the reference. an undefined weak reference resolves to zero. merged
# strings share the tails of longer ones, as GNU ld always does and lld does
# only at -O2. sections nothing reaches are kept unless --gc-sections is
# given, the default of GNU ld (ld's manual, --gc-sections) and of lld
# (OPT_gc_sections defaults to false in lld/ELF/Driver.cpp). an image needs
# every shared library named, as GNU ld writes DT_NEEDED for each without
# --as-needed
val LINKING: Linking = Linking{
    caps:         0,
    search:       resolve.COMMON_PULL,
    hooks:        ?resolve.PLAIN,
    weak:         Weak.zero{},
    folds:        fold.NONE,
    layout:       opt[*layout.Rules].some{?elf_convention.LAYOUT},
    tails:        true,
    collects:     false,
    dynamic:      ?elf_convention.DYNAMIC,
    loads_all:    true,
    facts:        ?elf_convention.FACTS,
    writer:       opt[*Writer].some{?elf_image.WRITER},
    declarers:    Declarers{rows: ?DECLARERS[0], count: DECLARER_COUNT},
    measures:     elf_image.MEASURES,
    uses:         consume.Uses{rows: ?USES[0], count: USE_COUNT},
    synthesizers: Synthesizers{rows: ?SYNTHESIZERS[0], count: SYNTHESIZER_COUNT},
    participants: Participants{rows: ?PARTICIPANTS[0], count: PARTICIPANT_COUNT},
    bounds:       elf_dynamic.BOUNDS,
};

pub val REGISTRATION: Registration = Registration{
    format:         ?format.ELF,
    codec:          opt[*Codec].some{?CODEC},
    traits:         opt[*TraitCodec].some{?TRAITS},
    naming:         opt[*Naming].some{?naming.NAMING},
    neutral:        opt[*Neutral].some{?NEUTRAL},
    lowering:       opt[*Lowering].some{?neutral.LOWERING},
    pairs:          ?pairs.PAIRS[0],
    pair_count:     pairs.COUNT,
    link:           opt[*Linking].some{?LINKING},
    revisions:      ?REVISIONS[0],
    revision_count: REVISION_COUNT,
    fields:         ?dump.FIELDS[0],
    field_count:    dump.FIELD_COUNT,
};

# a model moved to the heap, which the registration hands around as a pointer
fun boxed(a: *A.Allocator, m: Elf) res[ptr, Fail] {
    val p: res[*Elf, A.Error] = A.allocate[Elf](a, 1);
    if (sel p.err) {
        var dead:    Elf       = m;
        val dropped: err[Fail] = model.release(?dead);
        ret res[ptr, Fail].err{fail.refused(p.err)};
    }
    val slot: *Elf = p.ok;
    @slot = m;
    ret res[ptr, Fail].ok{slot::ptr};
}

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val m: res[Elf, Fail] = read.read(a, in);
    if (sel m.err) { ret res[ptr, Fail].err{m.err}; }
    ret boxed(a, m.ok);
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret write.write(a, m::*Elf);
}

fun kind_ops(m: ptr) res[*Kind, Fail] {
    ret kind.of(m::*Elf);
}

fun stated_ops(m: ptr) opt[Stated] {
    ret opt[Stated].some{traits.stated(m::*Elf)};
}

# a file a link binds against converts to the library it describes, and
# any other to an object to link
fun to_neutral_ops(m: ptr, rows: *row.Registry, o: *Object) err[Fail] {
    val k: res[*Kind, Fail] = kind.of(m::*Elf);
    if (sel k.err)                                  { ret err[Fail].err{k.err}; }
    if (catalog_kind.has(k.ok, catalog_kind.BINDS)) { ret library.to_neutral(m::*Elf, k.ok, o); }
    ret neutral.to_neutral(m::*Elf, rows, o);
}

# a shared object is written by a link, never from the library a neutral
# object describes
fun from_neutral_ops(a: *A.Allocator, rows: *row.Registry, o: *Object, t: *Target, l: opt[*Lowering]) res[ptr, Fail] {
    if (catalog_kind.has(o.kind, catalog_kind.BINDS)) {
        ret res[ptr, Fail].err{fail.about(fail.unsupported("a shared object is written by a link, not from the library a neutral object describes"), o.kind.name)};
    }
    val m: res[Elf, Fail] = neutral.from_neutral(a, rows, o, t, l);
    if (sel m.err) { ret res[ptr, Fail].err{m.err}; }
    ret boxed(a, m.ok);
}

fun locate_ops(m: ptr, offset: u64) Location {
    ret model.locate(m::*Elf, offset);
}

fun release_ops(a: *A.Allocator, m: ptr) err[Fail] {
    val e: *Elf         = m::*Elf;
    val r: err[Fail]    = model.release(e);
    val d: err[A.Error] = A.deallocate[Elf](a, e, 1);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}
