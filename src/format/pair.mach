# a (format, architecture) pair: what one format states for one architecture
#
# a pair names its architecture row and the code the format names it by, the
# relocation rows of the pair, its code templates, the prefix its symbol names
# carry, the symbol reference a relocation that names no target is written
# with, and how the thread pointer lies. a registration lists its pairs, and
# whoever needs one asks the registration for the pair of an architecture, so
# no table outside a format's module names a pair.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Code;
use mink.catalog.format.Format;
use mink.link.template;
use mink.link.thread.Thread;
use mink.reloc.row;

# arch:      the architecture
# code:      the code the format names the architecture by, one of the row's
# relocs:    the relocation rows
# templates: the code templates, none for a pair with none
# prefix:    the prefix the format gives a C symbol's name on the
#            architecture, empty for none
# nameless:  the symbol reference written for a relocation that names no
#            target, none where the format has no such relocation
# thread:    how the thread pointer relates to the thread-local block, none
#            where the pair states no thread-local layout
pub rec Pair {
    arch:      *Arch;
    code:      *Code;
    relocs:    *row.Set;
    templates: opt[*template.Set];
    prefix:    str;
    nameless:  opt[u64];
    thread:    opt[*Thread];
}

# the pair of `a` among the `count` pairs at `pairs`, refused naming the
# format `f` when it states none
pub fun of(f: *Format, pairs: *Pair, count: usize, a: *Arch) res[*Pair, Fail] {
    var i: usize = 0;
    for (i < count) {
        if (pairs[i].arch == a) { ret res[*Pair, Fail].ok{?pairs[i]}; }
        i = i + 1;
    }
    ret res[*Pair, Fail].err{fail.about(fail.in_record(fail.unsupported("the format states nothing for this architecture"), f.name), a.name)};
}

# the symbol reference `p` writes for a relocation that names no target
pub fun write_nameless(p: *Pair) res[u64, Fail] {
    if (sel p.nameless.none) { ret res[u64, Fail].err{fail.unsupported("the format has no relocation without a target")}; }
    ret res[u64, Fail].ok{p.nameless.some};
}

# whether the symbol reference `ref` of a relocation read for `p` names no
# target
pub fun reads_nameless(p: *Pair, ref: u64) bool {
    ret sel p.nameless.some && p.nameless.some == ref;
}

# whether `p` is sound: its code is one of its row's and its relocation rows
# are for its format and row
pub fun sound(p: *Pair, f: *Format) bool {
    if (p.code.format != f || p.relocs.format != f || p.relocs.arch != p.arch) { ret false; }
    val c: opt[*Code] = arch.code(p.arch, f);
    ret sel c.some && c.some == p.code;
}
