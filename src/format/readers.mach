# the readers index: what sniffing and reading an input take of every
# registered format
#
# the registry builds the index once from its registrations, and the link
# phases that read inputs take it without reaching the registrations. an
# index refuses two formats whose magics could both match one input, so a
# magic selects at most one format. an input no magic claims is offered to
# every probe, and one that two probes claim is refused, as is an input no
# format claims.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.catalog.format.Format;
use mink.format.contract.Identify;
use mink.format.contract.Input;
use mink.format.contract.Magic;
use mink.format.contract.Magics;
use mink.format.contract.Model;
use mink.format.contract.Probe;
use Row: mink.format.contract.Reader;
use mink.format.shell;
use mink.reloc.row;

# rows: what each format reads with, in registration order
pub rec Readers {
    rows: Table[Row];
}

# add the row `row`, refused when it identifies its files by no magic or one
# of its magics could match an input another row's magic matches
pub fun add(r: *Readers, row: Row) err[Fail] {
    val id: Identify = row.codec.identify;
    if (sel id.magics) {
        if (id.magics.count == 0) { ret err[Fail].err{fail.in_record(fail.internal("format registers no magic"), row.format.name)}; }
        var j: usize = 0;
        for (j < table.count[Row](?r.rows)) {
            val other: *Row = table.at[Row](?r.rows, table.nth[Row](j));
            if (other.format == row.format || claims_shared(?other.codec.identify, ?id)) {
                ret err[Fail].err{fail.in_record(fail.internal("two formats claim one magic"), row.format.name)};
            }
            j = j + 1;
        }
    }
    val p: res[Id[Row], Fail] = table.push[Row](?r.rows, row);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

pub fun release(r: *Readers) err[Fail] {
    ret table.release[Row](?r.rows);
}

pub fun count(r: *Readers) usize {
    ret table.count[Row](?r.rows);
}

pub fun at(r: *Readers, index: usize) *Row {
    ret table.at[Row](?r.rows, table.nth[Row](index));
}

# what the format `f` reads with
pub fun by_format(r: *Readers, f: *Format) res[*Row, Fail] {
    var i: usize = 0;
    for (i < count(r)) {
        if (at(r, i).format == f) { ret res[*Row, Fail].ok{at(r, i)}; }
        i = i + 1;
    }
    ret res[*Row, Fail].err{fail.in_record(fail.unsupported("the format reads no files"), f.name)};
}

# the one format `in` is a file of: the format whose magic it carries, or else
# the one format whose probe claims it
pub fun sniff(r: *Readers, in: *Input) res[*Row, Fail] {
    var i: usize = 0;
    for (i < count(r)) {
        val row: *Row = at(r, i);
        if (sel row.codec.identify.magics && carries(?row.codec.identify.magics, in)) { ret res[*Row, Fail].ok{row}; }
        i = i + 1;
    }
    var found: *Row = nil;
    i = 0;
    for (i < count(r)) {
        val row: *Row = at(r, i);
        i = i + 1;
        if (!sel row.codec.identify.probe) { cnt; }
        val probe: Probe = row.codec.identify.probe;
        if (!probe(in))   { cnt; }
        if (found != nil) { ret res[*Row, Fail].err{fail.in_file(fail.about(fail.unsupported("two formats claim the input"), row.format.name), in.file)}; }
        found = row;
    }
    if (found != nil) { ret res[*Row, Fail].ok{found}; }
    ret res[*Row, Fail].err{fail.in_file(fail.unsupported("no known format has this magic"), in.file)};
}

# read `in` as the format it is sniffed as
pub fun read(r: *Readers, a: *A.Allocator, in: *Input) res[Model, Fail] {
    val row: res[*Row, Fail] = sniff(r, in);
    if (sel row.err) { ret res[Model, Fail].err{row.err}; }
    ret shell.run(row.ok, a, in);
}

fun carries(ms: *Magics, in: *Input) bool {
    var k: usize = 0;
    for (k < ms.count) {
        if (matches(?ms.rows[k], in)) { ret true; }
        k = k + 1;
    }
    ret false;
}

fun matches(m: *Magic, in: *Input) bool {
    if (m.offset > in.len || m.len > in.len - m.offset) { ret false; }
    var i: usize = 0;
    for (i < m.len) {
        val mask: u8 = mask_at(m, i);
        if ((in.data[m.offset + i] & mask) != (m.bytes[i] & mask)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun mask_at(m: *Magic, i: usize) u8 {
    if (m.mask == nil) { ret 0xff; }
    ret m.mask[i];
}

# whether some magic of `a` and some magic of `b` could both match one input
fun claims_shared(a: *Identify, b: *Identify) bool {
    if (!sel a.magics) { ret false; }
    if (!sel b.magics) { ret false; }
    var i: usize = 0;
    for (i < a.magics.count) {
        var k: usize = 0;
        for (k < b.magics.count) {
            if (overlap(?a.magics.rows[i], ?b.magics.rows[k])) { ret true; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret false;
}

# two magics can both match unless some byte they both compare tells them apart
fun overlap(a: *Magic, b: *Magic) bool {
    var p: usize = a.offset;
    if (b.offset > p) { p = b.offset; }
    var end: usize = a.offset + a.len;
    if (b.offset + b.len < end) { end = b.offset + b.len; }
    for (p < end) {
        val ia:   usize = p - a.offset;
        val ib:   usize = p - b.offset;
        val both: u8    = mask_at(a, ia) & mask_at(b, ib);
        if ((a.bytes[ia] & both) != (b.bytes[ib] & both)) { ret false; }
        p = p + 1;
    }
    ret true;
}

# a stub format a test registers: "STB!", a u32 count, then that many bytes
