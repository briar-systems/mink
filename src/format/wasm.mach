# the wasm format and its registration
#
# the exact revision of each specification the wasm modules implement, so a
# change to any of them is a visible version bump, and the rows the wasm
# modules declare, named once: the codec, the neutral conversion, the
# lowering of records, the wasm32 and wasm64 pairs, and the linking row.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Stated;
use mink.catalog.format;
use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.format.contract.Carry;
use mink.format.contract.Codec;
use mink.format.contract.Identify;
use mink.format.contract.Input;
use mink.format.contract.Kinds;
use mink.format.contract.Magic;
use mink.format.contract.Magics;
use mink.format.contract.Neutral;
use mink.format.contract.Normalize;
use mink.format.contract.Revision;
use mink.format.registration.Registration;
use wasm_dump: mink.format.wasm.dump;
use wasm_link: mink.format.wasm.link;
use mink.format.wasm.model;
use mink.format.wasm.model.Module;
use mink.format.wasm.neutral;
use mink.format.wasm.read;
use wasm_reloc: mink.format.wasm.reloc;
use mink.format.wasm.write;
use mink.link.linking.Linking;
use mink.lower.Lowering;

pub val REVISION_COUNT: usize = 6;

pub val REVISIONS: [REVISION_COUNT]Revision = [REVISION_COUNT]Revision{
    Revision{spec: "WebAssembly Specification, binary format", revision: "release 3.0, tag wg-3.0"},
    Revision{spec: "WebAssembly tool conventions, Linking", revision: "commit 25aceba5adba of 2026-09-26"},
    Revision{spec: "WebAssembly tool conventions, DynamicLinking", revision: "commit 25aceba5adba of 2026-09-26"},
    Revision{spec: "WebAssembly tool conventions, ProducersSection", revision: "commit 25aceba5adba of 2026-09-26"},
    Revision{spec: "WebAssembly tool conventions, DWARF", revision: "commit 25aceba5adba of 2026-09-26"},
    Revision{spec: "LLVM BinaryFormat/Wasm.h and WasmRelocs.def", revision: "llvmorg-23.1.2"},
};

val MAGICS: [1]Magic = [1]Magic{Magic{offset: 0, bytes: ?model.MAGIC[0], len: model.MAGIC_LEN}};

val CODEC: Codec = Codec{
    identify: Identify.magics{Magics{rows: ?MAGICS[0], count: 1}},
    read:     read_ops,
    write:    write_ops,
    dump:     wasm_dump.dump,
    kind:     kind_ops,
    stated:   stated_ops,
    locate:   locate_ops,
    release:  release_ops,
};

# an object's constant-time ranges cross a wasm file as the mink note, in
# its own custom section
# an object with a linking section and a module without one are the kinds of
# file its conversion takes
val KINDS:   [2]*Kind = [2]*Kind{?kind.RELOCATABLE, ?kind.MODULE};
val NEUTRAL: Neutral  = Neutral{to: neutral.to, from: neutral.from, ct: Carry.note{}, kinds: Kinds{rows: ?KINDS[0], count: 2}, normalize: opt[Normalize].none{}};

pub val REGISTRATION: Registration = Registration{
    format:         ?format.WASM,
    codec:          opt[*Codec].some{?CODEC},
    neutral:        opt[*Neutral].some{?NEUTRAL},
    lowering:       opt[*Lowering].some{?neutral.LOWERING},
    pairs:          ?wasm_reloc.PAIRS[0],
    pair_count:     wasm_reloc.PAIR_COUNT,
    link:           opt[*Linking].some{?wasm_link.LINKING},
    revisions:      ?REVISIONS[0],
    revision_count: REVISION_COUNT,
    fields:         ?wasm_dump.FIELDS[0],
    field_count:    wasm_dump.FIELD_COUNT,
};

# a model moved to the heap, which the registration hands around as a pointer
fun boxed(a: *A.Allocator, m: Module) res[ptr, Fail] {
    val p: res[*Module, A.Error] = A.allocate[Module](a, 1);
    if (sel p.err) {
        var dead:    Module    = m;
        val dropped: err[Fail] = model.release(?dead);
        ret res[ptr, Fail].err{fail.refused(p.err)};
    }
    val slot: *Module = p.ok;
    @slot = m;
    ret res[ptr, Fail].ok{slot::ptr};
}

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val m: res[Module, Fail] = read.read(a, in);
    if (sel m.err) { ret res[ptr, Fail].err{m.err}; }
    ret boxed(a, m.ok);
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret write.write(a, m::*Module);
}

fun kind_ops(m: ptr) res[*Kind, Fail] {
    ret model.kind_of(m::*Module);
}

fun stated_ops(m: ptr) opt[Stated] {
    ret opt[Stated].some{model.stated(m::*Module)};
}

fun locate_ops(m: ptr, offset: u64) Location {
    ret model.locate(m::*Module, offset);
}

fun release_ops(a: *A.Allocator, m: ptr) err[Fail] {
    val w: *Module      = m::*Module;
    val r: err[Fail]    = model.release(w);
    val d: err[A.Error] = A.deallocate[Module](a, w, 1);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}
