# the SPIR-V format and its registration
#
# a SPIR-V module, read, written and dumped in either byte order, converted
# to a neutral object and back. a module encodes its version,
# addressing model and memory model as traits, and its instruction stream is
# the one section it names.

use std.types.bool.false;
use std.types.option.opt;

use mink.catalog.format;
use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.format.contract.Carry;
use mink.format.contract.Cut;
use mink.format.contract.Kinds;
use mink.format.contract.Naming;
use mink.format.contract.Neutral;
use mink.format.contract.Normalize;
use mink.format.contract.Reader;
use mink.format.contract.Revision;
use mink.format.contract.TraitCodec;
use mink.format.registration.Registration;
use mink.format.spirv.codec;
use mink.format.spirv.dump;
use mink.format.spirv.naming;
use mink.format.spirv.neutral;
use mink.format.spirv.reloc;
use mink.format.spirv.traits;
use mink.model.symbol.Visibilities;

val REVISIONS: [1]Revision = [1]Revision{
    Revision{spec: "SPIR-V Specification, version 1.6, as the SPIRV-Headers grammar states it", revision: "revision 7, SPIRV-Headers v1.202609.0"},
};

# a module declaring the Linkage capability and one declaring none are the
# kinds of file its conversion takes, and a module a producer holds whole in
# one section is cut as a file of it is
val KINDS:   [2]*Kind = [2]*Kind{?kind.RELOCATABLE, ?kind.MODULE};
val NEUTRAL: Neutral  = Neutral{to: neutral.to, from: neutral.from, ct: Carry.none{}, cut: Cut.sections{}, kinds: Kinds{rows: ?KINDS[0], count: 2}, normalize: opt[Normalize].some{neutral.normalize}, bridges: false, visibility: opt[*Visibilities].some{?neutral.WRITTEN_VISIBILITY}};

# how mink reads the format's files
pub val READER: Reader = Reader{
    format:      ?format.SPIRV,
    codec:       ?codec.CODEC,
    neutral:     opt[*Neutral].some{?NEUTRAL},
    fields:      ?dump.FIELDS[0],
    field_count: dump.FIELD_COUNT,
};

pub val REGISTRATION: Registration = Registration{
    format:         ?format.SPIRV,
    reader:         opt[*Reader].some{?READER},
    traits:         opt[*TraitCodec].some{?traits.TRAITS},
    naming:         opt[*Naming].some{?naming.NAMING},
    pairs:          ?reloc.PAIRS[0],
    pair_count:     reloc.PAIR_COUNT,
    revisions:      ?REVISIONS[0],
    revision_count: 1,
};
