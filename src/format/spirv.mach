# the SPIR-V format and its registration
#
# a SPIR-V module, read, written and dumped in either byte order, converted
# to a neutral object and back, and linked. a module encodes its version,
# addressing model and memory model as traits, and its instruction stream is
# the one section it names.

use std.types.option.opt;
use std.types.size.usize;

use mink.catalog.format;
use mink.format.contract.Carry;
use mink.format.contract.Codec;
use mink.format.contract.Naming;
use mink.format.contract.Neutral;
use mink.format.contract.Revision;
use mink.format.contract.TraitCodec;
use mink.format.registration.Registration;
use mink.format.spirv.codec;
use mink.format.spirv.dump;
use mink.format.spirv.image;
use mink.format.spirv.naming;
use mink.format.spirv.neutral;
use mink.format.spirv.reloc;
use mink.format.spirv.rules;
use mink.format.spirv.traits;
use mink.link.dynamic;
use mink.link.fold;
use mink.link.image.Writer;
use mink.link.layout;
use mink.link.linking;
use mink.link.linking.Linking;
use mink.link.relocate.Weak;
use mink.link.resolve;
use mink.model.section;

val REVISIONS: [1]Revision = [1]Revision{
    Revision{spec: "SPIR-V Specification, version 1.6, as the SPIRV-Headers grammar states it", revision: "revision 7, SPIRV-Headers v1.202609.0"},
};

val NEUTRAL: Neutral = Neutral{to: neutral.to, from: neutral.from, ct: Carry.none{}};

# types, constants and globals that are no variable fold as their contents
# and references decide, and so do extended instruction set imports and
# decorations, so a link holds each once
val FOLD_COUNT: usize                 = 2;
val FOLDS:      [FOLD_COUNT]fold.Rule = [FOLD_COUNT]fold.Rule{
    fold.Rule{kind: ?section.RODATA, equal: ?fold.CONTENTS},
    fold.Rule{kind: ?section.METADATA, equal: ?fold.CONTENTS},
};

# a module has no addresses, so a link gives each id its index and lays no
# image out. it searches archives once, binds nothing dynamically and leaves
# an undefined weak reference unruled, as a module has none
val LINKING: Linking = Linking{
    caps:    linking.INDEXED_LAYOUT,
    search:  0,
    hooks:   ?resolve.PLAIN,
    weak:    Weak.unruled{},
    folds:   fold.Rules{rows: ?FOLDS[0], count: FOLD_COUNT},
    layout:  opt[*layout.Rules].none{},
    dynamic: ?dynamic.UNBOUND,
    facts:   ?rules.FACTS,
    writer:  opt[*Writer].some{?image.WRITER},
};

pub val REGISTRATION: Registration = Registration{
    format:         ?format.SPIRV,
    codec:          opt[*Codec].some{?codec.CODEC},
    neutral:        opt[*Neutral].some{?NEUTRAL},
    traits:         opt[*TraitCodec].some{?traits.TRAITS},
    naming:         opt[*Naming].some{?naming.NAMING},
    pairs:          ?reloc.PAIRS[0],
    pair_count:     reloc.PAIR_COUNT,
    link:           opt[*Linking].some{?LINKING},
    revisions:      ?REVISIONS[0],
    revision_count: 1,
    fields:         ?dump.FIELDS[0],
    field_count:    dump.FIELD_COUNT,
};
