# the archive codec and container, the rows the ar registration names
#
# an archive is a container whose members convert through their own formats,
# so it has no neutral form. its members are the files it holds, and its
# symbol table, when it has one, is the index of the members defining each
# symbol.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.BIG;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Stated;
use mink.catalog.format;
use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.format.ar.dump;
use mink.format.ar.fixture;
use mink.format.ar.model;
use mink.format.ar.model.Archive;
use mink.format.ar.model.Entry;
use mink.format.ar.read;
use mink.format.ar.write;
use mink.format.contract;
use mink.format.contract.Codec;
use mink.format.contract.Container;
use mink.format.contract.Identify;
use mink.format.contract.Index;
use mink.format.contract.Input;
use mink.format.contract.Magic;
use mink.format.contract.Magics;
use mink.format.contract.Member;
use mink.format.contract.Model;
use mink.format.contract.Reader;
use mink.format.dump.Dumper;
use mink.format.shell;

val MAGICS: [2]Magic = [2]Magic{
    Magic{offset: 0, bytes: ?model.MAGIC_ARCH[0], len: 8},
    Magic{offset: 0, bytes: ?model.MAGIC_THIN[0], len: 8},
};

pub val CODEC: Codec = Codec{
    identify: Identify.magics{Magics{rows: ?MAGICS[0], count: 2}},
    read:     read_ops,
    write:    write_ops,
    dump:     dump_ops,
    kind:     kind_ops,
    locate:   locate,
    release:  release_ops,
};

pub val CONTAINER: Container = Container{members: members_ops, index: opt[Index].some{index_ops}};

# what the registry reads an archive with, which tests below the registry read
# archives through
#[testing]
pub val READER: Reader = Reader{format: ?format.AR, codec: ?CODEC, container: opt[*Container].some{?CONTAINER}, fields: ?dump.FIELDS[0], field_count: dump.FIELD_COUNT};

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val m: res[*Archive, Fail] = read.read(a, in);
    if (sel m.err) { ret res[ptr, Fail].err{m.err}; }
    ret res[ptr, Fail].ok{m.ok::ptr};
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret write.write(a, m::*Archive);
}

fun dump_ops(m: ptr, d: *Dumper) err[Fail] {
    ret dump.describe(m::*Archive, d);
}

# every variant is a static library, its members answering their own kinds
fun kind_ops(m: ptr) res[*Kind, Fail] {
    ret res[*Kind, Fail].ok{?kind.ARCHIVE};
}

# every file the archive holds, its tables left out, in archive order
fun members_ops(m: ptr, file: str, out: *Table[Member]) err[Fail] {
    val arch:  *Archive = m::*Archive;
    val count: usize    = table.count[model.Member](?arch.members);
    var i:     usize    = 0;
    for (i < count) {
        val am: *model.Member = table.at[model.Member](?arch.members, table.nth[model.Member](i));
        if (am.role == ?model.OBJECT) {
            if (!am.held) {
                ret err[Fail].err{fail.at_offset(fail.in_indexed(fail.unsupported("a thin archive's members are files of their own"), "member", i::u64), am.at)};
            }
            val body:   Bytes                 = model.payload(arch, am);
            val member: Member                = Member{name: model.bytes(arch, ?am.name), input: Input{file: file, data: body.data, len: body.len}, arch: opt[Stated].none{}};
            val pushed: res[Id[Member], Fail] = table.push[Member](out, member);
            if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the members the symbol table names for `name`, false for an archive with no
# symbol table. a symbol table is always the first member
fun index_ops(m: ptr, name: Bytes, out: *Table[Id[Member]]) res[bool, Fail] {
    val arch: *Archive = m::*Archive;
    if (table.count[model.Member](?arch.members) == 0) { ret res[bool, Fail].ok{false}; }
    val symtab: *model.Member = table.at[model.Member](?arch.members, table.nth[model.Member](0));
    if (symtab.role.family == model.NONE) { ret res[bool, Fail].ok{false}; }
    var k: usize = 0;
    for (k < symtab.entries) {
        val e: *Entry = table.at[Entry](?arch.entries, table.nth[Entry](symtab.first + k));
        val n: Bytes  = model.bytes(arch, ?e.name);
        if (n.len == name.len && model.same(n.data, name.data, n.len)) {
            val id: res[Id[Member], Fail] = member_at(arch, e.member, k);
            if (sel id.err) { ret res[bool, Fail].err{id.err}; }
            val pushed: res[Id[Id[Member]], Fail] = table.push[Id[Member]](out, id.ok);
            if (sel pushed.err) { ret res[bool, Fail].err{pushed.err}; }
        }
        k = k + 1;
    }
    ret res[bool, Fail].ok{true};
}

# the id members gives the file whose header is at `offset`, which entry `k`
# of the symbol table names
fun member_at(arch: *Archive, offset: u64, k: usize) res[Id[Member], Fail] {
    val count: usize = table.count[model.Member](?arch.members);
    var files: u32   = 0;
    var i:     usize = 0;
    for (i < count) {
        val am: *model.Member = table.at[model.Member](?arch.members, table.nth[model.Member](i));
        if (am.at == offset && am.role == ?model.OBJECT) { ret res[Id[Member], Fail].ok{Id[Member]{index: files}}; }
        if (am.at >= offset)                             { brk; }
        if (am.role == ?model.OBJECT)                    { files = files + 1; }
        i = i + 1;
    }
    ret res[Id[Member], Fail].err{fail.in_indexed(fail.malformed("symbol table entry does not name a member file"), "symbol table", k::u64)};
}

fun locate(m: ptr, offset: u64) Location {
    ret model.locate(m::*Archive, offset);
}

fun release_ops(a: *A.Allocator, m: ptr) err[Fail] {
    val arch: *Archive     = m::*Archive;
    val r:    err[Fail]    = model.release(arch);
    val d:    err[A.Error] = A.deallocate[Archive](a, arch, 1);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}

# the archive `build` writes into `out`, read through the registration into `m`
#[testing]
fun read_fixture(t: *T.Testing, build: fun(*Sink) err[Fail], out: *Sink, m: *Model) err[Fail] {
    @out = sink.make(T.allocator_of(t), BIG);
    val b: err[Fail] = build(out);
    if (sel b.err) { ret b; }
    var in:  Input            = Input{file: "lib.a", data: sink.data(out), len: sink.len(out)};
    val got: res[Model, Fail] = shell.run(?READER, T.allocator_of(t), ?in);
    if (sel got.err) { ret err[Fail].err{got.err}; }
    @m = got.ok;
    ret err[Fail].ok{};
}

fun named(b: Bytes, want: str) bool {
    ret b.len == str_len(want) && model.same(b.data, want::*u8, b.len);
}

test ar__yields_its_members_in_order {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val c: opt[*Container] = READER.container;
    if (!sel c.some)            { ret 1; }
    if (!sel c.some.index.some) { ret 1; }
    var out: Sink;
    var m:   Model;
    val rd:  err[Fail] = read_fixture(?t, fixture.CASES[0].build, ?out, ?m);
    if (sel rd.err) { ret 1; }
    var got: Table[Member] = table.make[Member](T.allocator_of(?t));
    val ls:  err[Fail]     = contract.members(?m, "lib.a", ?got);
    if (sel ls.err)                     { ret 1; }
    if (table.count[Member](?got) != 2) { ret 1; }
    val first: *Member = table.at[Member](?got, table.nth[Member](0));
    val last:  *Member = table.at[Member](?got, table.nth[Member](1));
    if (!named(first.name, "long_member_name.o") || !named(last.name, "b.o"))             { ret 1; }
    if (first.input.len != 5 || first.input.data[0] != 'B' || first.input.data[4] != '!') { ret 1; }
    if (last.input.len != 2 || last.input.data[0] != 'x')                                 { ret 1; }
    if (!str_equals(first.input.file, "lib.a") || !sel first.arch.none)                   { ret 1; }
    val r1: err[Fail] = table.release[Member](?got);
    if (sel r1.err) { ret 1; }
    val r2: err[Fail] = contract.release(?m);
    if (sel r2.err) { ret 1; }
    val r3: err[Fail] = sink.release(?out);
    if (sel r3.err)            { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

fun one_file(t: *Sink) err[Fail] {
    val xy: [2]u8     = [2]u8{'x', 'y'};
    val wa: err[Fail] = fixture.begin(t, false);
    if (sel wa.err) { ret wa; }
    ret fixture.member(t, "a.o/", 2, ?xy[0], 2);
}

test ar__finds_defining_members_through_its_symbol_table {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var out: Sink;
    var m:   Model;
    val rd:  err[Fail] = read_fixture(?t, fixture.CASES[0].build, ?out, ?m);
    if (sel rd.err) { ret 1; }
    var got: Table[Id[Member]] = table.make[Id[Member]](T.allocator_of(?t));
    val foo: res[bool, Fail]   = contract.defining(?m, "lib.a", Bytes{data: "foo"::*u8, len: 3}, ?got);
    if (sel foo.err)                                                     { ret 1; }
    if (!foo.ok)                                                         { ret 1; }
    if (table.count[Id[Member]](?got) != 1)                              { ret 1; }
    if (table.at[Id[Member]](?got, table.nth[Id[Member]](0)).index != 0) { ret 1; }
    val bar: res[bool, Fail] = contract.defining(?m, "lib.a", Bytes{data: "bar"::*u8, len: 3}, ?got);
    if (sel bar.err)                        { ret 1; }
    if (!bar.ok)                            { ret 1; }
    if (table.count[Id[Member]](?got) != 1) { ret 1; }
    val r1: err[Fail] = contract.release(?m);
    if (sel r1.err) { ret 1; }
    val r2: err[Fail] = sink.release(?out);
    if (sel r2.err) { ret 1; }

    # an archive without a symbol table has no index, so its members are scanned
    var bare: Sink;
    var n:    Model;
    val rb:   err[Fail] = read_fixture(?t, one_file, ?bare, ?n);
    if (sel rb.err) { ret 1; }
    val none: res[bool, Fail] = contract.defining(?n, "lib.a", Bytes{data: "foo"::*u8, len: 3}, ?got);
    if (sel none.err)                       { ret 1; }
    if (none.ok)                            { ret 1; }
    if (table.count[Id[Member]](?got) != 1) { ret 1; }
    val r3: err[Fail] = contract.release(?n);
    if (sel r3.err) { ret 1; }
    val r4: err[Fail] = sink.release(?bare);
    if (sel r4.err) { ret 1; }
    val r5: err[Fail] = table.release[Id[Member]](?got);
    if (sel r5.err)            { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
