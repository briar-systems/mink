# the archive codec and container, the rows the ar registration names
#
# an archive is a container whose members convert through their own formats,
# so it has no neutral form. its members are the files it holds, and its
# symbol table, when it has one, is the index of the members defining each
# symbol.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.base.vectors;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Stated;
use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.format.ar.dump;
use mink.format.ar.model;
use mink.format.ar.model.Archive;
use mink.format.ar.model.Entry;
use mink.format.ar.read;
use mink.format.ar.write;
use mink.format.contract;
use mink.format.contract.Codec;
use mink.format.contract.Container;
use mink.format.contract.Identify;
use mink.format.contract.Index;
use mink.format.contract.Input;
use mink.format.contract.Magic;
use mink.format.contract.Magics;
use mink.format.contract.Member;
use mink.format.dump.Dumper;
use mink.reloc.row;

val MAGICS: [2]Magic = [2]Magic{
    Magic{offset: 0, bytes: ?model.MAGIC_ARCH[0], len: 8},
    Magic{offset: 0, bytes: ?model.MAGIC_THIN[0], len: 8},
};

pub val CODEC: Codec = Codec{
    identify: Identify.magics{Magics{rows: ?MAGICS[0], count: 2}},
    read:     read_ops,
    write:    write_ops,
    dump:     dump_ops,
    kind:     kind_ops,
    stated:   stated_ops,
    binds:    contract.binds_nothing,
    locate:   locate,
    release:  dnit_ops,
};

pub val CONTAINER: Container = Container{members: members_ops, index: opt[Index].some{index_ops}};

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val res_read: res[*Archive, Fail] = read.read(a, in);
    if (sel res_read.err) { ret res[ptr, Fail].err{res_read.err}; }
    ret res[ptr, Fail].ok{res_read.ok::ptr};
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret write.write(a, m::*Archive);
}

fun dump_ops(m: ptr, rows: *row.Registry, d: *Dumper) {
    dump.describe(m::*Archive, d);
}

# every variant is a static library, its members answering their own kinds
fun kind_ops(m: ptr) res[*Kind, Fail] {
    ret res[*Kind, Fail].ok{?kind.ARCHIVE};
}

# an archive states no one architecture, its members stating their own
fun stated_ops(m: ptr) opt[Stated] {
    ret opt[Stated].none{};
}

# every file the archive holds, its tables left out, in archive order
fun members_ops(m: ptr, file: str, out: *Table[Member]) err[Fail] {
    val arch:  *Archive = m::*Archive;
    val count: usize    = vector.length[model.Member](?arch.members);
    var i:     usize    = 0;
    for (i < count) {
        val am: *model.Member = ?arch.members.data[i];
        if (am.role == ?model.OBJECT) {
            if (!am.held) {
                ret err[Fail].err{fail.at_offset(fail.in_indexed(fail.unsupported("a thin archive's members are files of their own"), "member", i::u64), am.at)};
            }
            val body:       Bytes                 = model.payload(arch, am);
            val member:     Member                = Member{name: model.bytes(arch, ?am.name), input: Input{file: file, data: body.data, len: body.len}, arch: opt[Stated].none{}};
            val res_pushed: res[Id[Member], Fail] = table.push[Member](out, member);
            if (sel res_pushed.err) { ret err[Fail].err{res_pushed.err}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# every entry of the symbol table, false for an archive with none. a symbol
# table is always the first member. a refusal leaves `out` as it was
fun index_ops(m: ptr, out: *Vector[contract.Entry]) res[bool, Fail] {
    val arch: *Archive = m::*Archive;
    if (vector.length[model.Member](?arch.members) == 0) { ret res[bool, Fail].ok{false}; }
    val symtab: *model.Member = ?arch.members.data[0];
    if (symtab.role.family == model.NONE) { ret res[bool, Fail].ok{false}; }
    val had:        usize       = vector.length[contract.Entry](out);
    var files:      Vector[u64] = vector.init[u64](out.a);
    val err_listed: err[Fail]   = listed(arch, symtab, ?files, out);
    val err_rel:    err[Fail]   = vectors.dnit[u64](?files);
    val err_kept:   err[Fail]   = fail.kept(err_listed, err_rel);
    if (sel err_kept.err) {
        vectors.truncate[contract.Entry](out, had);
        ret res[bool, Fail].err{err_kept.err};
    }
    ret res[bool, Fail].ok{true};
}

# append the entries of `symtab` to `out`, `files` taking the header offset of
# each member file in archive order, so a file's id is its place there
fun listed(arch: *Archive, symtab: *model.Member, files: *Vector[u64], out: *Vector[contract.Entry]) err[Fail] {
    val count: usize = vector.length[model.Member](?arch.members);
    var i:     usize = 0;
    for (i < count) {
        val am: *model.Member = ?arch.members.data[i];
        if (am.role == ?model.OBJECT) {
            val err_pushed: err[Fail] = vectors.push[u64](files, am.at);
            if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
        }
        i = i + 1;
    }
    val err_reserved: err[Fail] = vectors.reserve[contract.Entry](out, symtab.entries);
    if (sel err_reserved.err) { ret err_reserved; }
    var k: usize = 0;
    for (k < symtab.entries) {
        val e:             *Entry                = ?arch.entries.data[symtab.first + k];
        val res_member_at: res[Id[Member], Fail] = member_at(files, e.member, k);
        if (sel res_member_at.err) { ret err[Fail].err{res_member_at.err}; }
        val err_pushed: err[Fail] = vectors.push[contract.Entry](out, contract.Entry{name: model.bytes(arch, ?e.name), member: res_member_at.ok});
        if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the id members gives the file whose header is at `offset`, which entry `k`
# of the symbol table names, found among the ascending offsets of `files`
fun member_at(files: *Vector[u64], offset: u64, k: usize) res[Id[Member], Fail] {
    val at: *u64  = files.data;
    var lo: usize = 0;
    var hi: usize = vector.length[u64](files);
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (at[mid] < offset) { lo = mid + 1; }
        or                    { hi = mid; }
    }
    if (lo < vector.length[u64](files) && at[lo] == offset) { ret res[Id[Member], Fail].ok{Id[Member]{index: lo::u32}}; }
    ret res[Id[Member], Fail].err{fail.in_indexed(fail.malformed("symbol table entry does not name a member file"), "symbol table", k::u64)};
}

fun locate(m: ptr, offset: u64) Location {
    ret model.locate(m::*Archive, offset);
}

fun dnit_ops(a: *A.Allocator, m: ptr) err[Fail] {
    val arch:           *Archive     = m::*Archive;
    val err_release:    err[Fail]    = model.dnit(arch);
    val err_deallocate: err[A.Error] = A.deallocate[Archive](a, arch, 1);
    if (sel err_release.err)    { ret err_release; }
    if (sel err_deallocate.err) { ret err[Fail].err{fail.refused(err_deallocate.err)}; }
    ret err[Fail].ok{};
}
