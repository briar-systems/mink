# the archive writer
#
# a model is written by replaying its members as they were read. a new
# archive is built from members and their neutral objects in one of the
# variants below, with a symbol table of the defined global symbols and a long
# name table where the variant needs one. a symbol table holds 64 bit offsets
# when a member header lies past 4 GiB.

use std.collections.sort;
use std.collections.vector;
use std.collections.vector.Vector;
use std.encoding.binary;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.memory;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.vectors;
use mink.bytes.reader.BIG;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Order;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.bytes.strtab;
use mink.bytes.strtab.Convention;
use mink.bytes.strtab.Strtab;
use mink.catalog.arch;
use mink.catalog.kind;
use mink.format.ar.model;
use mink.format.ar.model.Archive;
use mink.format.ar.model.Member;
use mink.format.ar.model.Role;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Symbol;
use mink.model.symbol;

# an archive variant a new archive is written in
# ---
# name:    how it is spelled
# thin:    whether members are references to files rather than copies
# bsd:     whether names too long for the header travel inline and the symbol
#          table is a ranlib one
# narrow:  the role of its symbol table with 32 bit offsets
# wide:    the role of its symbol table with 64 bit offsets
# order:   the byte order of its symbol tables
# linker2: whether a second linker member follows the symbol table, which then
#          is the first linker member: symbols sorted by name, each with the
#          index of its member, little endian and with 32 bit offsets only
pub rec Variant {
    name:    str;
    thin:    bool;
    bsd:     bool;
    narrow:  *Role;
    wide:    *Role;
    order:   Order;
    linker2: bool;
}

pub val GNU_AR:     Variant = Variant{name: "gnu", thin: false, bsd: false, narrow: ?model.SYMTAB, wide: ?model.SYMTAB64, order: BIG};
pub val GNU_THIN:   Variant = Variant{name: "gnu-thin", thin: true, bsd: false, narrow: ?model.SYMTAB, wide: ?model.SYMTAB64, order: BIG};
pub val BSD_AR:     Variant = Variant{name: "bsd", thin: false, bsd: true, narrow: ?model.SYMDEF, wide: ?model.SYMDEF64, order: LITTLE};
pub val WINDOWS_AR: Variant = Variant{name: "windows", thin: false, bsd: false, narrow: ?model.SYMTAB, wide: ?model.SYMTAB64, order: BIG, linker2: true};

# a member to write
# ---
# name:   the member's name
# data:   its bytes, whose length a thin archive records and nothing more
# object: the neutral object read from the bytes, nil when the member defines
#         no symbols or names them itself
# names:  the symbols the member defines, for a member with no neutral object
# count:  how many names there are
pub rec Source {
    name:   Bytes;
    data:   Bytes;
    object: *Object;
    names:  *Bytes;
    count:  usize;
}

# a defined global symbol and the member that defines it. a versioned symbol
# is spelled name, `ats` at signs, then version, as GNU ar spells it
rec Sym {
    name:    Bytes;
    version: Bytes;
    ats:     usize;
    member:  usize;
}

# the length of the index name of `sy`
fun spelled_len(sy: *Sym) usize {
    ret sy.name.len + sy.ats + sy.version.len;
}

# byte `i` of the index name of `sy`
fun spelled_at(sy: *Sym, i: usize) u8 {
    if (i < sy.name.len)          { ret sy.name.data[i]; }
    if (i < sy.name.len + sy.ats) { ret '@'; }
    ret sy.version.data[i - sy.name.len - sy.ats];
}

# the index name of `sy`, without its terminator
fun spell(out: *Sink, sy: *Sym) err[Fail] {
    val err_name_written: err[Fail] = sink.bytes(out, sy.name.data, sy.name.len);
    if (sel err_name_written.err) { ret err_name_written; }
    var k: usize = 0;
    for (k < sy.ats) {
        val err_at_written: err[Fail] = sink.u8(out, '@');
        if (sel err_at_written.err) { ret err_at_written; }
        k = k + 1;
    }
    ret sink.bytes(out, sy.version.data, sy.version.len);
}

# whether `name` holds no NUL byte
fun clean(name: Bytes) bool {
    var n: usize = 0;
    for (n < name.len) {
        if (name.data[n] == 0) { ret false; }
        n = n + 1;
    }
    ret true;
}

# the placement of an archive
# ---
# wide:        whether the symbol table holds 64 bit offsets
# body:        the size of the symbol table, without its inline name
# symtab:      the size of the symbol table member, its header and pad included
# second:      the size of the second linker member, header and pad included, zero
#              when the variant has none
# second_body: the size of its body
# longs:       the size of the long name member, zero when there is none
pub rec Layout {
    wide:        bool;
    body:        u64;
    symtab:      u64;
    second:      u64;
    second_body: u64;
    longs:       u64;
}

# the model written as it was read
pub fun write(a: *A.Allocator, arch: *Archive) res[Sink, Fail] {
    var out:        Sink      = sink.make(a, BIG);
    val err_replay: err[Fail] = replay(arch, ?out);
    if (sel err_replay.err) {
        val err_released: err[Fail] = sink.release(?out);
        ret res[Sink, Fail].err{err_replay.err};
    }
    ret res[Sink, Fail].ok{out};
}

fun replay(arch: *Archive, out: *Sink) err[Fail] {
    var magic: *u8 = ?model.MAGIC_ARCH[0];
    if (arch.thin) { magic = ?model.MAGIC_THIN[0]; }
    val err_magic_written: err[Fail] = sink.bytes(out, magic, model.MAGIC_LEN);
    if (sel err_magic_written.err) { ret err_magic_written; }
    val count: usize = vector.length[Member](?arch.members);
    var i:     usize = 0;
    for (i < count) {
        val m:                       *Member   = ?arch.members.data[i];
        val err_header_name_written: err[Fail] = sink.bytes(out, ?m.header.name[0], 16);
        if (sel err_header_name_written.err) { ret err_header_name_written; }
        val err_header_date_written: err[Fail] = sink.bytes(out, ?m.header.date[0], 12);
        if (sel err_header_date_written.err) { ret err_header_date_written; }
        val err_header_uid_written: err[Fail] = sink.bytes(out, ?m.header.uid[0], 6);
        if (sel err_header_uid_written.err) { ret err_header_uid_written; }
        val err_header_gid_written: err[Fail] = sink.bytes(out, ?m.header.gid[0], 6);
        if (sel err_header_gid_written.err) { ret err_header_gid_written; }
        val err_header_mode_written: err[Fail] = sink.bytes(out, ?m.header.mode[0], 8);
        if (sel err_header_mode_written.err) { ret err_header_mode_written; }
        val err_header_size_written: err[Fail] = sink.bytes(out, ?m.header.size[0], 10);
        if (sel err_header_size_written.err) { ret err_header_size_written; }
        val err_header_fmag_written: err[Fail] = sink.bytes(out, ?m.header.fmag[0], 2);
        if (sel err_header_fmag_written.err) { ret err_header_fmag_written; }
        if (m.held) {
            val body:             Bytes     = model.bytes(arch, ?m.body);
            val err_body_written: err[Fail] = sink.bytes(out, body.data, body.len);
            if (sel err_body_written.err) { ret err_body_written; }
        }
        if (m.padded) {
            val err_pad_written: err[Fail] = sink.u8(out, m.pad);
            if (sel err_pad_written.err) { ret err_pad_written; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# what building holds until the archive is written
rec Scratch {
    syms:    Vector[Sym];
    sorted:  Vector[Sym];
    ids:     Vector[u32];
    sizes:   Vector[u64];
    offsets: Vector[u64];
    longs:   Strtab;
}

fun scratch(a: *A.Allocator) Scratch {
    ret Scratch{
        syms:    vector.init[Sym](a),
        sorted:  vector.init[Sym](a),
        ids:     vector.init[u32](a),
        sizes:   vector.init[u64](a),
        offsets: vector.init[u64](a),
        longs:   strtab.make(a, Convention{lead: false, term: strtab.NEWLINE}),
    };
}

fun free(s: *Scratch) err[Fail] {
    var err_first:           err[Fail] = vectors.release[Sym](?s.syms);
    val err_sorted_released: err[Fail] = vectors.release[Sym](?s.sorted);
    if (sel err_first.ok && sel err_sorted_released.err) { err_first = err_sorted_released; }
    val err_ids_released: err[Fail] = vectors.release[u32](?s.ids);
    if (sel err_first.ok && sel err_ids_released.err) { err_first = err_ids_released; }
    val err_sizes_released: err[Fail] = vectors.release[u64](?s.sizes);
    if (sel err_first.ok && sel err_sizes_released.err) { err_first = err_sizes_released; }
    val err_offsets_released: err[Fail] = vectors.release[u64](?s.offsets);
    if (sel err_first.ok && sel err_offsets_released.err) { err_first = err_offsets_released; }
    val err_longs_released: err[Fail] = strtab.release(?s.longs);
    if (sel err_first.ok && sel err_longs_released.err) { err_first = err_longs_released; }
    ret err_first;
}

# an archive of the `count` sources in the variant `v`
pub fun build(a: *A.Allocator, v: *Variant, sources: *Source, count: usize) res[Sink, Fail] {
    var s:       Scratch         = scratch(a);
    val res_out: res[Sink, Fail] = assemble(a, v, sources, count, ?s);
    val err_rel: err[Fail]       = free(?s);
    if (sel res_out.err) { ret res_out; }
    if (sel err_rel.err) {
        val err_dropped: err[Fail] = sink.release(?res_out.ok);
        ret res[Sink, Fail].err{err_rel.err};
    }
    ret res_out;
}

fun assemble(a: *A.Allocator, v: *Variant, sources: *Source, count: usize, s: *Scratch) res[Sink, Fail] {
    val at:     Location = Location{record: "archive layout"};
    var nsyms:  u64      = 0;
    var nbytes: u64      = 0;
    var i:      usize    = 0;
    for (i < count) {
        val src: *Source = ?sources[i];
        if (src.name.len == 0) {
            ret res[Sink, Fail].err{fail.in_indexed(fail.malformed("member name is empty"), "member", i::u64)};
        }
        if (src.object != nil && src.count != 0) {
            ret res[Sink, Fail].err{fail.in_indexed(fail.malformed("member names its symbols twice"), "member", i::u64)};
        }
        if (src.object != nil) {
            val err_gather: err[Fail] = gather(s, src.object, i);
            if (sel err_gather.err) { ret res[Sink, Fail].err{err_gather.err}; }
        }
        val err_gather_names: err[Fail] = gather_names(s, src, i);
        if (sel err_gather_names.err) { ret res[Sink, Fail].err{err_gather_names.err}; }
        i = i + 1;
    }
    val syms: *Sym = s.syms.data;
    i = 0;
    for (i < vector.length[Sym](?s.syms)) {
        nsyms = nsyms + 1;
        val res_sum: res[u64, Fail] = checked.add(at, nbytes, spelled_len(?syms[i])::u64 + 1);
        if (sel res_sum.err) { ret res[Sink, Fail].err{res_sum.err}; }
        nbytes = res_sum.ok;
        i      = i + 1;
    }

    i = 0;
    for (i < count) {
        val src:        *Source = ?sources[i];
        var inline_len: usize   = 0;
        if (v.bsd && !fits(v, src.name)) { inline_len = src.name.len; }
        or (!v.bsd && !fits(v, src.name)) {
            val res_long_name: res[Id[Name], Fail] = long_name(a, s, src.name);
            if (sel res_long_name.err) { ret res[Sink, Fail].err{fail.in_indexed(res_long_name.err, "member", i::u64)}; }
            val err_pushed: err[Fail] = vectors.push[u32](?s.ids, res_long_name.ok.index);
            if (sel err_pushed.err) { ret res[Sink, Fail].err{err_pushed.err}; }
        }
        var disk: u64 = model.HEADER_LEN::u64;
        if (!v.thin) {
            val res_body: res[u64, Fail] = checked.add(at, inline_len::u64, src.data.len::u64);
            if (sel res_body.err) { ret res[Sink, Fail].err{res_body.err}; }
            val res_tot: res[u64, Fail] = checked.add(at, disk, res_body.ok + (res_body.ok & 1));
            if (sel res_tot.err) { ret res[Sink, Fail].err{res_tot.err}; }
            disk = res_tot.ok;
        }
        val err_sizes_pushed: err[Fail] = vectors.push[u64](?s.sizes, disk);
        if (sel err_sizes_pushed.err) { ret res[Sink, Fail].err{err_sizes_pushed.err}; }
        i = i + 1;
    }
    var longs: u64 = 0;
    if (vector.length[u32](?s.ids) > 0) {
        val err_fin: err[Fail] = strtab.finish(?s.longs);
        if (sel err_fin.err) { ret res[Sink, Fail].err{err_fin.err}; }
        longs = strtab.size(?s.longs);
    }

    val res_lay: res[Layout, Fail] = lay_out(v, s.sizes.data, count, nsyms, nbytes, longs, ?s.offsets);
    if (sel res_lay.err) { ret res[Sink, Fail].err{res_lay.err}; }
    if (v.linker2 && (res_lay.ok.wide || count > 0xffff)) {
        ret res[Sink, Fail].err{fail.in_record(fail.overflow("member offset or number does not fit the linker member"), "archive layout")};
    }
    ret emit(a, v, sources, count, s, res_lay.ok, nsyms);
}

# the long name table entry of `name`, which ends with a slash
fun long_name(a: *A.Allocator, s: *Scratch, name: Bytes) res[Id[Name], Fail] {
    var joined:           Sink      = sink.make(a, BIG);
    val err_name_written: err[Fail] = sink.bytes(?joined, name.data, name.len);
    if (sel err_name_written.err) {
        val err_dropped: err[Fail] = sink.release(?joined);
        ret res[Id[Name], Fail].err{err_name_written.err};
    }
    val err_slash_written: err[Fail] = sink.u8(?joined, '/');
    if (sel err_slash_written.err) {
        val err_dropped: err[Fail] = sink.release(?joined);
        ret res[Id[Name], Fail].err{err_slash_written.err};
    }
    val res_longs_added: res[Id[Name], Fail] = strtab.add(?s.longs, sink.data(?joined), sink.len(?joined));
    val err_rel:         err[Fail]           = sink.release(?joined);
    if (sel res_longs_added.err) { ret res_longs_added; }
    if (sel err_rel.err)         { ret res[Id[Name], Fail].err{err_rel.err}; }
    ret res_longs_added;
}

# the defined global symbols of `o`, which member `index` holds
fun gather(s: *Scratch, o: *Object, index: usize) err[Fail] {
    val items: *Symbol = table.items[Symbol](?o.symbols);
    var k:     usize   = 0;
    for (k < table.count[Symbol](?o.symbols)) {
        val sy: Symbol = items[k];
        if (symbol.binds(sy.binding, symbol.EXTERNAL) && !(sel sy.def.undefined)) {
            val given: View  = object.name_of(o, sy.name);
            val name:  Bytes = Bytes{data: given.data, len: given.len};
            var entry: Sym   = Sym{name: name, member: index};
            if (sel sy.version.some) {
                val vname: View = object.name_of(o, sy.version.some.name);
                entry.version = Bytes{data: vname.data, len: vname.len};
                entry.ats     = 1;
                if (sy.version.some.default) { entry.ats = 2; }
            }
            if (!clean(entry.name) || !clean(entry.version)) {
                ret err[Fail].err{fail.in_indexed(fail.malformed("symbol name holds a NUL byte"), "member", index::u64)};
            }
            val err_pushed: err[Fail] = vectors.push[Sym](?s.syms, entry);
            if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the symbols a source names itself
fun gather_names(s: *Scratch, src: *Source, index: usize) err[Fail] {
    var k: usize = 0;
    for (k < src.count) {
        val name: Bytes = src.names[k];
        var n:    usize = 0;
        for (n < name.len) {
            if (name.data[n] == 0) {
                ret err[Fail].err{fail.in_indexed(fail.malformed("symbol name holds a NUL byte"), "member", index::u64)};
            }
            n = n + 1;
        }
        val err_pushed: err[Fail] = vectors.push[Sym](?s.syms, Sym{name: name, member: index});
        if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# whether a member name fits the header of the variant
fun fits(v: *Variant, name: Bytes) bool {
    if (!v.bsd)                                          { ret name.len + 1 <= 16; }
    if (name.len > 16 || name.data[name.len - 1] == '/') { ret false; }
    var i: usize = 0;
    for (i < name.len) {
        if (name.data[i] == ' ') { ret false; }
        i = i + 1;
    }
    ret true;
}

# the size of the name of the symbol table so its body starts 8 aligned
fun table_name(v: *Variant, role: *Role) usize {
    if (!v.bsd) { ret 0; }
    var n: usize = str_len(model.special_name(role));
    for (((model.MAGIC_LEN + model.HEADER_LEN + n) & 7) != 0) { n = n + 1; }
    ret n;
}

# the size of the symbol table of the variant, without its inline name
fun table_size(v: *Variant, wide: bool, nsyms: u64, nbytes: u64) res[u64, Fail] {
    val at: Location = Location{record: "symbol table"};
    var w:  u64      = 4;
    if (wide) { w = 8; }
    var per:   u64 = w;
    var fixed: u64 = w;
    if (v.bsd) {
        per   = 2 * w;
        fixed = 2 * w;
    }
    val res_cells: res[u64, Fail] = checked.mul(at, per, nsyms);
    if (sel res_cells.err) { ret res_cells; }
    val res_fixed_added: res[u64, Fail] = checked.add(at, fixed, res_cells.ok);
    if (sel res_fixed_added.err) { ret res_fixed_added; }
    ret checked.add(at, res_fixed_added.ok, nbytes);
}

# the size of the second linker member: the member offsets, then the symbols
# with their member numbers and names
fun second_size(count: usize, nsyms: u64, nbytes: u64) res[u64, Fail] {
    val at:          Location       = Location{record: "second linker member"};
    val res_offsets: res[u64, Fail] = checked.mul(at, 4, count::u64);
    if (sel res_offsets.err) { ret res_offsets; }
    val res_indexes: res[u64, Fail] = checked.mul(at, 2, nsyms);
    if (sel res_indexes.err) { ret res_indexes; }
    val res_checked_added: res[u64, Fail] = checked.add(at, 8, res_offsets.ok);
    if (sel res_checked_added.err) { ret res_checked_added; }
    val res_indexes_added: res[u64, Fail] = checked.add(at, res_checked_added.ok, res_indexes.ok);
    if (sel res_indexes_added.err) { ret res_indexes_added; }
    ret checked.add(at, res_indexes_added.ok, nbytes);
}

# the placement of members of `sizes` bytes each, on disk with their headers
pub fun lay_out(v: *Variant, sizes: *u64, count: usize, nsyms: u64, nbytes: u64, longs: u64, offsets: *Vector[u64]) res[Layout, Fail] {
    val at:    Location = Location{record: "archive layout"};
    var wide:  bool     = false;
    var tries: usize    = 0;
    for (tries < 2) {
        vector.clear[u64](offsets);
        val res_table_size: res[u64, Fail] = table_size(v, wide, nsyms, nbytes);
        if (sel res_table_size.err) { ret res[Layout, Fail].err{res_table_size.err}; }
        var role: *Role = v.narrow;
        if (wide) { role = v.wide; }
        val named:     u64            = table_name(v, role)::u64;
        val res_whole: res[u64, Fail] = checked.add(at, res_table_size.ok, named);
        if (sel res_whole.err) { ret res[Layout, Fail].err{res_whole.err}; }
        val res_mem: res[u64, Fail] = checked.add(at, res_whole.ok + (res_whole.ok & 1), model.HEADER_LEN::u64);
        if (sel res_mem.err) { ret res[Layout, Fail].err{res_mem.err}; }
        var sec:  u64 = 0;
        var body: u64 = 0;
        if (v.linker2) {
            val res_second_size: res[u64, Fail] = second_size(count, nsyms, nbytes);
            if (sel res_second_size.err) { ret res[Layout, Fail].err{res_second_size.err}; }
            val res_u64_added: res[u64, Fail] = checked.add(at, res_second_size.ok + (res_second_size.ok & 1), model.HEADER_LEN::u64);
            if (sel res_u64_added.err) { ret res[Layout, Fail].err{res_u64_added.err}; }
            sec  = res_u64_added.ok;
            body = res_second_size.ok;
        }
        var lt: u64 = 0;
        if (longs != 0) {
            val res_u64_added: res[u64, Fail] = checked.add(at, longs + (longs & 1), model.HEADER_LEN::u64);
            if (sel res_u64_added.err) { ret res[Layout, Fail].err{res_u64_added.err}; }
            lt = res_u64_added.ok;
        }
        val res_tables: res[u64, Fail] = checked.add(at, res_mem.ok, sec);
        if (sel res_tables.err) { ret res[Layout, Fail].err{res_tables.err}; }
        val res_head: res[u64, Fail] = checked.add(at, res_tables.ok, lt);
        if (sel res_head.err) { ret res[Layout, Fail].err{res_head.err}; }
        val res_start: res[u64, Fail] = checked.add(at, res_head.ok, model.MAGIC_LEN::u64);
        if (sel res_start.err) { ret res[Layout, Fail].err{res_start.err}; }
        var pos: u64   = res_start.ok;
        var i:   usize = 0;
        for (i < count) {
            val err_pushed: err[Fail] = vectors.push[u64](offsets, pos);
            if (sel err_pushed.err) { ret res[Layout, Fail].err{err_pushed.err}; }
            val res_next: res[u64, Fail] = checked.add(at, pos, sizes[i]);
            if (sel res_next.err) { ret res[Layout, Fail].err{res_next.err}; }
            pos = res_next.ok;
            i   = i + 1;
        }
        if (wide || count == 0 || offsets.data[count - 1] <= 0xffff_ffffu64) {
            ret res[Layout, Fail].ok{Layout{wide: wide, body: res_table_size.ok, symtab: res_mem.ok, second: sec, second_body: body, longs: lt}};
        }
        wide  = true;
        tries = tries + 1;
    }
    ret res[Layout, Fail].err{fail.internal("archive layout did not settle")};
}

fun emit(a: *A.Allocator, v: *Variant, sources: *Source, count: usize, s: *Scratch, lay: Layout, nsyms: u64) res[Sink, Fail] {
    var out:           Sink      = sink.make(a, v.order);
    val err_emit_into: err[Fail] = emit_into(v, sources, count, s, lay, nsyms, ?out);
    if (sel err_emit_into.err) {
        val err_released: err[Fail] = sink.release(?out);
        ret res[Sink, Fail].err{err_emit_into.err};
    }
    ret res[Sink, Fail].ok{out};
}

fun emit_into(v: *Variant, sources: *Source, count: usize, s: *Scratch, lay: Layout, nsyms: u64, out: *Sink) err[Fail] {
    var magic: *u8 = ?model.MAGIC_ARCH[0];
    if (v.thin) { magic = ?model.MAGIC_THIN[0]; }
    val err_magic_written: err[Fail] = sink.bytes(out, magic, model.MAGIC_LEN);
    if (sel err_magic_written.err) { ret err_magic_written; }

    var role: *Role = v.narrow;
    if (lay.wide) { role = v.wide; }
    val label:      str   = model.special_name(role);
    val inline_len: usize = table_name(v, role);
    var field:      [16]u8;
    var size:       u64   = lay.body;
    if (v.bsd) {
        numbered_field(?field[0], "#1/", inline_len::u64);
        size = size + inline_len::u64;
    }
    or          { text_field(?field[0], label); }
    if (!v.bsd) { size = size + (size & 1); }
    val err_table_header_written: err[Fail] = header(out, ?field[0], "0", size, true);
    if (sel err_table_header_written.err) { ret err_table_header_written; }
    if (v.bsd) {
        val err_label_written: err[Fail] = sink.bytes(out, label::*u8, str_len(label));
        if (sel err_label_written.err) { ret err_label_written; }
        val err_label_pad_written: err[Fail] = sink.zeros(out, inline_len - str_len(label));
        if (sel err_label_pad_written.err) { ret err_label_pad_written; }
    }
    val err_table_body_written: err[Fail] = table_body(v, s, lay, nsyms, out);
    if (sel err_table_body_written.err) { ret err_table_body_written; }
    if (!v.bsd && (lay.body & 1) == 1) {
        val err_table_pad_written: err[Fail] = sink.u8(out, 0);
        if (sel err_table_pad_written.err) { ret err_table_pad_written; }
    }
    or ((size & 1) == 1) {
        val err_table_pad_written: err[Fail] = sink.u8(out, 10);
        if (sel err_table_pad_written.err) { ret err_table_pad_written; }
    }

    if (v.linker2) {
        val err_second_member_written: err[Fail] = second_member(s, count, nsyms, lay, out);
        if (sel err_second_member_written.err) { ret err_second_member_written; }
    }

    if (lay.longs != 0) {
        text_field(?field[0], "//");
        val named:                        u64       = strtab.size(?s.longs);
        val err_longnames_header_written: err[Fail] = header(out, ?field[0], "", named + (named & 1), false);
        if (sel err_longnames_header_written.err) { ret err_longnames_header_written; }
        val err_longnames_written: err[Fail] = strtab.write(?s.longs, out);
        if (sel err_longnames_written.err) { ret err_longnames_written; }
        if ((named & 1) == 1) {
            val err_longnames_pad_written: err[Fail] = sink.u8(out, 10);
            if (sel err_longnames_pad_written.err) { ret err_longnames_pad_written; }
        }
    }

    var long_at: usize = 0;
    var i:       usize = 0;
    for (i < count) {
        val src:   *Source = ?sources[i];
        var size:  u64     = src.data.len::u64;
        var named: usize   = 0;
        if (fits(v, src.name)) {
            name_field(?field[0], src.name, v.bsd);
        }
        or (v.bsd) {
            numbered_field(?field[0], "#1/", src.name.len::u64);
            named = src.name.len;
            size  = size + named::u64;
        }
        or {
            val id: u32 = s.ids.data[long_at];
            long_at = long_at + 1;
            numbered_field(?field[0], "/", strtab.offset(?s.longs, Id[Name]{index: id}));
        }
        val err_member_header_written: err[Fail] = header(out, ?field[0], "644", size, true);
        if (sel err_member_header_written.err) { ret err_member_header_written; }
        if (!v.thin) {
            val err_member_name_written: err[Fail] = sink.bytes(out, src.name.data, named);
            if (sel err_member_name_written.err) { ret err_member_name_written; }
            val err_member_data_written: err[Fail] = sink.bytes(out, src.data.data, src.data.len);
            if (sel err_member_data_written.err) { ret err_member_data_written; }
            if ((size & 1) == 1) {
                val err_member_pad_written: err[Fail] = sink.u8(out, 10);
                if (sel err_member_pad_written.err) { ret err_member_pad_written; }
            }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the symbol table: where each symbol's member starts, then the names
fun table_body(v: *Variant, s: *Scratch, lay: Layout, nsyms: u64, out: *Sink) err[Fail] {
    var w: usize = 4;
    if (lay.wide) { w = 8; }
    val syms:    *Sym = s.syms.data;
    val offsets: *u64 = s.offsets.data;
    var count:   u64  = nsyms;
    if (v.bsd) { count = nsyms * 2 * w::u64; }
    val err_count_written: err[Fail] = sink.uint(out, count, w);
    if (sel err_count_written.err) { ret err_count_written; }
    var strx: u64   = 0;
    var i:    usize = 0;
    for (i < nsyms::usize) {
        if (v.bsd) {
            val err_string_offset_written: err[Fail] = sink.uint(out, strx, w);
            if (sel err_string_offset_written.err) { ret err_string_offset_written; }
            strx = strx + spelled_len(?syms[i])::u64 + 1;
        }
        val err_member_offset_written: err[Fail] = sink.uint(out, offsets[syms[i].member], w);
        if (sel err_member_offset_written.err) { ret err_member_offset_written; }
        i = i + 1;
    }
    if (v.bsd) {
        val err_strings_size_written: err[Fail] = sink.uint(out, strx, w);
        if (sel err_strings_size_written.err) { ret err_strings_size_written; }
    }
    i = 0;
    for (i < nsyms::usize) {
        val err_symbol_spelled: err[Fail] = spell(out, ?syms[i]);
        if (sel err_symbol_spelled.err) { ret err_symbol_spelled; }
        val err_terminator_written: err[Fail] = sink.u8(out, 0);
        if (sel err_terminator_written.err) { ret err_terminator_written; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the second linker member: the offset of every member, then the symbols
# sorted by name, each with the 1 based number of its member
fun second_member(s: *Scratch, count: usize, nsyms: u64, lay: Layout, out: *Sink) err[Fail] {
    val syms:    *Sym  = s.syms.data;
    val offsets: *u64  = s.offsets.data;
    var i:       usize = 0;
    for (i < nsyms::usize) {
        val err_pushed: err[Fail] = vectors.push[Sym](?s.sorted, syms[i]);
        if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
        i = i + 1;
    }
    val sorted: *Sym = s.sorted.data;
    sort.sort_by[Sym](sorted, nsyms::usize, by_name);
    var field: [16]u8;
    text_field(?field[0], "/");
    val size:               u64       = lay.second - model.HEADER_LEN::u64;
    val err_header_written: err[Fail] = header(out, ?field[0], "0", size, true);
    if (sel err_header_written.err) { ret err_header_written; }
    val err_member_count_written: err[Fail] = little(out, count::u64, 4);
    if (sel err_member_count_written.err) { ret err_member_count_written; }
    i = 0;
    for (i < count) {
        val err_member_offset_written: err[Fail] = little(out, offsets[i], 4);
        if (sel err_member_offset_written.err) { ret err_member_offset_written; }
        i = i + 1;
    }
    val err_symbol_count_written: err[Fail] = little(out, nsyms, 4);
    if (sel err_symbol_count_written.err) { ret err_symbol_count_written; }
    i = 0;
    for (i < nsyms::usize) {
        val err_member_index_written: err[Fail] = little(out, sorted[i].member::u64 + 1, 2);
        if (sel err_member_index_written.err) { ret err_member_index_written; }
        i = i + 1;
    }
    i = 0;
    for (i < nsyms::usize) {
        val err_symbol_spelled: err[Fail] = spell(out, ?sorted[i]);
        if (sel err_symbol_spelled.err) { ret err_symbol_spelled; }
        val err_terminator_written: err[Fail] = sink.u8(out, 0);
        if (sel err_terminator_written.err) { ret err_terminator_written; }
        i = i + 1;
    }
    if ((lay.second_body & 1) == 1) { ret sink.u8(out, 0); }
    ret err[Fail].ok{};
}

# a little endian integer of `size` bytes
fun little(out: *Sink, v: u64, size: usize) err[Fail] {
    var buf: [8]u8;
    binary.put_uint(?buf[0], v, size, LITTLE);
    ret sink.bytes(out, ?buf[0], size);
}

fun by_name(a: *Sym, b: *Sym) i64 {
    val la: usize = spelled_len(a);
    val lb: usize = spelled_len(b);
    var n:  usize = la;
    if (lb < n) { n = lb; }
    var i: usize = 0;
    for (i < n) {
        val x: u8 = spelled_at(a, i);
        val y: u8 = spelled_at(b, i);
        if (x != y) { ret x::i64 - y::i64; }
        i = i + 1;
    }
    ret la::i64 - lb::i64;
}

# a header with the fixed fields of a written member. an unstamped header
# leaves date, owner and mode blank
fun header(out: *Sink, name: *u8, mode: str, size: u64, stamped: bool) err[Fail] {
    var h: [60]u8;
    memory.fill[u8](?h[0], ' ', 60);
    memory.copy[u8](?h[0], name, 16);
    if (stamped) {
        h[16] = '0';
        h[28] = '0';
        h[34] = '0';
        memory.copy[u8](?h[40], mode::*u8, str_len(mode));
    }
    decimal(?h[48], size);
    h[58] = '`';
    h[59] = 10;
    ret sink.bytes(out, ?h[0], 60);
}

fun text_field(field: *u8, text: str) {
    memory.fill[u8](field, ' ', 16);
    memory.copy[u8](field, text::*u8, str_len(text));
}

# `prefix` and the decimal `n`
fun numbered_field(field: *u8, prefix: str, n: u64) {
    text_field(field, prefix);
    decimal(?field[str_len(prefix)], n);
}

# the name and, in a gnu header, the slash that ends it
fun name_field(field: *u8, name: Bytes, bsd: bool) {
    memory.fill[u8](field, ' ', 16);
    memory.copy[u8](field, name.data, name.len);
    if (!bsd) { field[name.len] = '/'; }
}

# `n` in decimal at `p`
fun decimal(p: *u8, n: u64) {
    var digits: [20]u8;
    var i:      usize = 20;
    var x:      u64   = n;
    for {
        i         = i - 1;
        digits[i] = '0' + (x % 10)::u8;
        x         = x / 10;
        if (x == 0) { brk; }
    }
    memory.copy[u8](p, ?digits[i], 20 - i);
}

fun add_symbol(o: *Object, name: str, binding: *symbol.Binding, def: object.Definition) bool {
    val res_name_str: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel res_name_str.err) { ret false; }
    val res_add_symbol: res[Id[Symbol], Fail] = object.add_symbol(o, Symbol{
        name:       res_name_str.ok,
        binding:    binding,
        visibility: ?symbol.DEFAULT,
        kind:       ?symbol.NOTYPE,
        def:        def,
        size:       opt[u64].none{},
    });
    ret !(sel res_add_symbol.err);
}
