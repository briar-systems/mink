# the text form of an archive
#
# the archive, then each member in order with its header fields as written,
# and under a symbol table each of its entries.

use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use mink.base.store.Bytes;
use mink.format.ar.model;
use mink.format.ar.model.Archive;
use mink.format.ar.model.Entry;
use mink.format.ar.model.Member;
use mink.format.dump;
use mink.format.dump.Dumper;

use std.collections.vector;

pub val ARCHIVE:       u32 = 0;
pub val MAGIC:         u32 = 1;
pub val MEMBER:        u32 = 2;
pub val NAME:          u32 = 3;
pub val ROLE:          u32 = 4;
pub val OFFSET:        u32 = 5;
pub val DATE:          u32 = 6;
pub val USER:          u32 = 7;
pub val GROUP:         u32 = 8;
pub val MODE:          u32 = 9;
pub val SIZE:          u32 = 10;
pub val SYMBOL:        u32 = 11;
pub val MEMBER_OFFSET: u32 = 12;
pub val HELD:          u32 = 13;

pub val FIELD_COUNT: usize   = 14;
pub val FIELDS:      [14]str = [14]str{
    "Archive", "Magic", "Member", "Name", "Role", "Offset", "Date",
    "UserID", "GroupID", "Mode", "Size", "Symbol", "MemberOffset", "Held",
};

pub fun describe(arch: *Archive, d: *Dumper) {
    dump.open(d, ARCHIVE);
    var magic: *u8 = ?model.MAGIC_ARCH[0];
    if (arch.thin) { magic = ?model.MAGIC_THIN[0]; }
    dump.name(d, MAGIC, magic, model.MAGIC_LEN);
    val count: usize = vector.length[Member](?arch.members);
    var i:     usize = 0;
    for (i < count) {
        member(arch, d, ?arch.members.data[i]);
        i = i + 1;
    }
    dump.close(d);
}

fun member(arch: *Archive, d: *Dumper, m: *Member) {
    val nm: Bytes = model.bytes(arch, ?m.name);
    dump.open(d, MEMBER);
    dump.name(d, NAME, nm.data, nm.len);
    dump.name(d, ROLE, m.role.name::*u8, str_len(m.role.name));
    dump.hex(d, OFFSET, m.at);
    dump.name(d, DATE, ?m.header.date[0], 12);
    dump.name(d, USER, ?m.header.uid[0], 6);
    dump.name(d, GROUP, ?m.header.gid[0], 6);
    dump.name(d, MODE, ?m.header.mode[0], 8);
    dump.name(d, SIZE, ?m.header.size[0], 10);
    var held: u64 = 0;
    if (m.held) { held = 1; }
    dump.decimal(d, HELD, held);
    var i: usize = 0;
    for (i < m.entries) {
        val e:  *Entry = ?arch.entries.data[m.first + i];
        val en: Bytes  = model.bytes(arch, ?e.name);
        dump.open(d, SYMBOL);
        dump.name(d, NAME, en.data, en.len);
        dump.hex(d, MEMBER_OFFSET, e.member);
        dump.close(d);
        i = i + 1;
    }
    dump.close(d);
}
