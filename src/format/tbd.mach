# the text stub format and its registration
#
# a text-based dylib stub, a YAML file of the tbd versions 3 and 4, is the
# interface of a Mach-O dylib an SDK ships in its place, the stub kind of
# file a link binds against and no loader maps. it is read, dumped and
# converted to the library it describes. mink writes no text stub.

use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Stated;
use mink.catalog.format;
use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.format.contract.Carry;
use mink.format.contract.Codec;
use mink.format.contract.Identify;
use mink.format.contract.Input;
use mink.format.contract.Kinds;
use mink.format.contract.Magic;
use mink.format.contract.Magics;
use mink.format.contract.Neutral;
use mink.format.contract.Normalize;
use mink.format.contract.Revision;
use mink.format.dump.Dumper;
use mink.format.registration.Registration;
use tbd_dump:  mink.format.tbd.dump;
use tbd_model: mink.format.tbd.model;
use mink.format.tbd.model.Tbd;
use tbd_neutral: mink.format.tbd.neutral;
use tbd_read:    mink.format.tbd.read;
use mink.lower.Lowering;
use mink.model.object.Object;
use mink.model.target.Target;
use mink.reloc.row;

pub val REVISION_COUNT: usize = 1;

pub val REVISIONS: [REVISION_COUNT]Revision = [REVISION_COUNT]Revision{
    Revision{spec: "text-based dylib stubs, tbd versions 3 and 4, as llvm's TextAPI reads them", revision: "LLVM 23.1.1"},
};

# the document start and the tag every version the reader takes begins with
val MAGIC_BYTES: [13]u8   = [13]u8{'-', '-', '-', ' ', '!', 't', 'a', 'p', 'i', '-', 't', 'b', 'd'};
val MAGICS:      [1]Magic = [1]Magic{Magic{offset: 0, bytes: ?MAGIC_BYTES[0], len: 13}};

val CODEC: Codec = Codec{
    identify: Identify.magics{Magics{rows: ?MAGICS[0], count: 1}},
    read:     read_ops,
    write:    write_ops,
    dump:     dump_ops,
    kind:     kind_ops,
    stated:   stated_ops,
    locate:   locate_ops,
    release:  release_ops,
};

# a stub is the one kind of file its conversion takes
val KINDS:   [1]*Kind = [1]*Kind{?kind.STUB};
val NEUTRAL: Neutral  = Neutral{to: to_neutral_ops, from: from_neutral_ops, ct: Carry.none{}, kinds: Kinds{rows: ?KINDS[0], count: 1}, normalize: opt[Normalize].none{}, bridges: false};

pub val REGISTRATION: Registration = Registration{
    format:         ?format.TBD,
    codec:          opt[*Codec].some{?CODEC},
    neutral:        opt[*Neutral].some{?NEUTRAL},
    revisions:      ?REVISIONS[0],
    revision_count: REVISION_COUNT,
    fields:         ?tbd_dump.FIELDS[0],
    field_count:    tbd_dump.FIELD_COUNT,
};

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val t: res[Tbd, Fail] = tbd_read.read(a, in);
    if (sel t.err) { ret res[ptr, Fail].err{t.err}; }
    val p: res[*Tbd, A.Error] = A.allocate[Tbd](a, 1);
    if (sel p.err) {
        var dead:    Tbd       = t.ok;
        val dropped: err[Fail] = tbd_model.release(?dead);
        ret res[ptr, Fail].err{fail.refused(p.err)};
    }
    @p.ok = t.ok;
    ret res[ptr, Fail].ok{p.ok::ptr};
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret res[Sink, Fail].err{fail.in_record(fail.unsupported("mink writes no text stub"), format.TBD.name)};
}

fun dump_ops(m: ptr, rows: *row.Registry, d: *Dumper) err[Fail] {
    ret tbd_dump.describe(m::*Tbd, d);
}

fun kind_ops(m: ptr) res[*Kind, Fail] {
    ret res[*Kind, Fail].ok{?kind.STUB};
}

# the one architecture the library's targets name, none for a stub of
# several
fun stated_ops(m: ptr) opt[Stated] {
    ret tbd_neutral.stated(m::*Tbd);
}

# a stub's model keeps no offsets, so a byte is placed in no record
fun locate_ops(m: ptr, offset: u64) Location {
    ret Location{offset: offset, placed: true};
}

fun release_ops(a: *A.Allocator, m: ptr) err[Fail] {
    val t: *Tbd         = m::*Tbd;
    val r: err[Fail]    = tbd_model.release(t);
    val d: err[A.Error] = A.deallocate[Tbd](a, t, 1);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}

fun to_neutral_ops(m: ptr, rows: *row.Registry, o: *Object) err[Fail] {
    ret tbd_neutral.to_neutral(m::*Tbd, o);
}

fun from_neutral_ops(a: *A.Allocator, rows: *row.Registry, o: *Object, t: *Target, l: opt[*Lowering]) res[ptr, Fail] {
    ret res[ptr, Fail].err{fail.in_record(fail.unsupported("mink writes no text stub"), format.TBD.name)};
}
