# the registry of formats, and sniffing
#
# every format mink reads is one registration in this registry, its only
# footprint outside its own module. a registry refuses two registrations whose
# magics could both match one input, so sniffing selects at most one, and an
# input no registration claims is refused.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;
use std.memory;

use mink.lib.ar;
use mink.lib.catalog.format.Format;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;
use mink.lib.format.contract;
use mink.lib.format.contract.Input;
use mink.lib.format.contract.Magic;
use mink.lib.format.contract.Model;
use mink.lib.format.contract.Ops;
use mink.lib.format.contract.Registration;
use mink.lib.format.contract.Revision;
use mink.lib.format.dump;
use mink.lib.format.dump.Dumper;
use mink.lib.format.shell;
use mink.lib.macho;
use mink.lib.model.object.Object;
use mink.lib.reader;
use mink.lib.reader.LITTLE;
use mink.lib.reader.Reader;
use mink.lib.sink;
use mink.lib.sink.Sink;

pub rec Registry {
    entries: **Registration;
    count:   usize;
}

# the formats mink is built with, one line each
val BUILTIN_COUNT: usize                        = 2;
val BUILTIN:       [BUILTIN_COUNT]*Registration = [BUILTIN_COUNT]*Registration{?ar.REGISTRATION, ?macho.REGISTRATION};

pub fun builtin() res[Registry, Fail] {
    ret make(?BUILTIN[0], BUILTIN_COUNT);
}

# a registry of the `count` registrations at `entries`, refused when one is
# incomplete or two claim one magic
pub fun make(entries: **Registration, count: usize) res[Registry, Fail] {
    var i: usize = 0;
    for (i < count) {
        val r: *Registration = entries[i];
        if (r.magic_count == 0 || r.revision_count == 0) {
            ret res[Registry, Fail].err{fail.in_record(fail.internal("format registers no magic or no revision"), r.format.name)};
        }
        var j: usize = 0;
        for (j < i) {
            if (claims_shared(entries[j], r)) {
                ret res[Registry, Fail].err{fail.in_record(fail.internal("two formats claim one magic"), r.format.name)};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret res[Registry, Fail].ok{Registry{entries: entries, count: count}};
}

# the one registered format whose magic `in` carries
pub fun sniff(r: *Registry, in: *Input) res[*Registration, Fail] {
    var i: usize = 0;
    for (i < r.count) {
        val reg: *Registration = r.entries[i];
        var k:   usize         = 0;
        for (k < reg.magic_count) {
            if (matches(?reg.magics[k], in)) { ret res[*Registration, Fail].ok{reg}; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret res[*Registration, Fail].err{fail.in_file(fail.unsupported("no known format has this magic"), in.file)};
}

# read `in` as the format it is sniffed as
pub fun read(r: *Registry, a: *A.Allocator, in: *Input) res[Model, Fail] {
    val reg: res[*Registration, Fail] = sniff(r, in);
    if (sel reg.err) { ret res[Model, Fail].err{reg.err}; }
    ret shell.run(reg.ok, a, in);
}

pub fun count(r: *Registry) usize {
    ret r.count;
}

pub fun at(r: *Registry, index: usize) *Registration {
    ret r.entries[index];
}

pub fun by_format(r: *Registry, f: *Format) res[*Registration, Fail] {
    var i: usize = 0;
    for (i < r.count) {
        if (r.entries[i].format == f) { ret res[*Registration, Fail].ok{r.entries[i]}; }
        i = i + 1;
    }
    ret res[*Registration, Fail].err{fail.unsupported("no format with this name is registered")};
}

fun matches(m: *Magic, in: *Input) bool {
    if (m.offset > in.len || m.len > in.len - m.offset) { ret false; }
    var i: usize = 0;
    for (i < m.len) {
        val mask: u8 = mask_at(m, i);
        if ((in.data[m.offset + i] & mask) != (m.bytes[i] & mask)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun mask_at(m: *Magic, i: usize) u8 {
    if (m.mask == nil) { ret 0xff; }
    ret m.mask[i];
}

# whether some magic of `a` and some magic of `b` could both match one input
fun claims_shared(a: *Registration, b: *Registration) bool {
    var i: usize = 0;
    for (i < a.magic_count) {
        var k: usize = 0;
        for (k < b.magic_count) {
            if (overlap(?a.magics[i], ?b.magics[k])) { ret true; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret false;
}

# two magics can both match unless some byte they both compare tells them apart
fun overlap(a: *Magic, b: *Magic) bool {
    var p: usize = a.offset;
    if (b.offset > p) { p = b.offset; }
    var end: usize = a.offset + a.len;
    if (b.offset + b.len < end) { end = b.offset + b.len; }
    for (p < end) {
        val ia:   usize = p - a.offset;
        val ib:   usize = p - b.offset;
        val both: u8    = mask_at(a, ia) & mask_at(b, ib);
        if ((a.bytes[ia] & both) != (b.bytes[ib] & both)) { ret false; }
        p = p + 1;
    }
    ret true;
}

# a stub format a test registers: "STB!", a u32 count, then that many bytes

rec Stub {
    count: u32;
    items: *u8;
}

val STUB_FORMAT:    Format       = Format{name: "stub"};
val STUB_BYTES:     [4]u8        = [4]u8{'S', 'T', 'B', '!'};
val STUB_MAGICS:    [1]Magic     = [1]Magic{Magic{offset: 0, bytes: ?STUB_BYTES[0], len: 4}};
val STUB_REVISIONS: [1]Revision  = [1]Revision{Revision{spec: "stub", revision: "1"}};
val STUB_FIELDS:    [3]str       = [3]str{"Stub", "Count", "Items"};
val STUB:           Registration = Registration{
    format: ?STUB_FORMAT,
    ops:    Ops{
        read:         stub_read,
        write:        stub_write,
        dump:         stub_dump,
        to_neutral:   stub_to_neutral,
        from_neutral: stub_from_neutral,
        locate:       stub_locate,
        release:      stub_release,
    },
    magics:         ?STUB_MAGICS[0],
    magic_count:    1,
    revisions:      ?STUB_REVISIONS[0],
    revision_count: 1,
    fields:         ?STUB_FIELDS[0],
    field_count:    3,
};

fun stub_read(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    var r:    Reader           = shell.open(in, LITTLE);
    val skip: res[usize, Fail] = reader.seek(?r, 4);
    if (sel skip.err) { ret res[ptr, Fail].err{skip.err}; }
    val count: res[u32, Fail] = reader.u32(?r);
    if (sel count.err) { ret res[ptr, Fail].err{fail.in_record(count.err, "header")}; }
    val items: res[Reader, Fail] = shell.table(?r, "item", 8, count.ok::u64, 1);
    if (sel items.err) { ret res[ptr, Fail].err{items.err}; }
    val m: res[*Stub, A.Error] = A.allocate[Stub](a, 1);
    if (sel m.err) { ret res[ptr, Fail].err{fail.refused(m.err)}; }
    m.ok.count = count.ok;
    m.ok.items = items.ok.data;
    ret res[ptr, Fail].ok{m.ok::ptr};
}

fun stub_write(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    val s:   *Stub     = m::*Stub;
    var out: Sink      = sink.make(a, LITTLE);
    val wm:  err[Fail] = sink.bytes(?out, ?STUB_BYTES[0], 4);
    if (sel wm.err) { ret res[Sink, Fail].err{wm.err}; }
    val wc: err[Fail] = sink.u32(?out, s.count);
    if (sel wc.err) { ret res[Sink, Fail].err{wc.err}; }
    val wi: err[Fail] = sink.bytes(?out, s.items, s.count::usize);
    if (sel wi.err) { ret res[Sink, Fail].err{wi.err}; }
    ret res[Sink, Fail].ok{out};
}

fun stub_dump(m: ptr, d: *Dumper) err[Fail] {
    val s:  *Stub     = m::*Stub;
    val wo: err[Fail] = dump.open(d, 0);
    if (sel wo.err) { ret wo; }
    val wc: err[Fail] = dump.decimal(d, 1, s.count::u64);
    if (sel wc.err) { ret wc; }
    val wi: err[Fail] = dump.bytes(d, 2, s.items, s.count::usize);
    if (sel wi.err) { ret wi; }
    ret dump.close(d);
}

fun stub_to_neutral(m: ptr, o: *Object) err[Fail] {
    ret err[Fail].ok{};
}

fun stub_from_neutral(a: *A.Allocator, o: *Object) res[ptr, Fail] {
    ret res[ptr, Fail].err{fail.unsupported("the stub format is read only")};
}

fun stub_locate(m: ptr, offset: u64) Location {
    val s: *Stub = m::*Stub;
    if (offset < 8)                { ret Location{record: "header", offset: offset, placed: true}; }
    if (offset - 8 < s.count::u64) { ret Location{record: "item", index: offset - 8, indexed: true, offset: offset, placed: true}; }
    ret Location{offset: offset, placed: true};
}

fun stub_release(a: *A.Allocator, m: ptr) err[Fail] {
    val r: err[A.Error] = A.deallocate[Stub](a, m::*Stub, 1);
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}

# a second format whose magic only one input byte tells apart from the stub's
val NEAR_FORMAT: Format       = Format{name: "near"};
val NEAR_BYTES:  [2]u8        = [2]u8{'T', 'A'};
val NEAR_MASK:   [2]u8        = [2]u8{0xff, 0x00};
val NEAR_MAGICS: [1]Magic     = [1]Magic{Magic{offset: 1, bytes: ?NEAR_BYTES[0], mask: ?NEAR_MASK[0], len: 2}};
val NEAR:        Registration = Registration{
    format:         ?NEAR_FORMAT,
    ops:            STUB.ops,
    magics:         ?NEAR_MAGICS[0],
    magic_count:    1,
    revisions:      ?STUB_REVISIONS[0],
    revision_count: 1,
    fields:         ?STUB_FIELDS[0],
    field_count:    3,
};

test registry__sniffs_reads_and_dumps_a_registered_format {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val entries: [1]*Registration    = [1]*Registration{?STUB};
    var r:       res[Registry, Fail] = make(?entries[0], 1);
    if (sel r.err) { ret 1; }
    val bytes: [10]u8 = [10]u8{'S', 'T', 'B', '!', 2, 0, 0, 0, 'h', 'i'};
    var in:    Input  = Input{file: "a.stb", data: ?bytes[0], len: 10};

    val reg: res[*Registration, Fail] = sniff(?r.ok, ?in);
    if (sel reg.err)     { ret 1; }
    if (reg.ok != ?STUB) { ret 1; }
    var m: res[Model, Fail] = read(?r.ok, T.allocator_of(?t), ?in);
    if (sel m.err) { ret 1; }

    var out: Sink      = sink.make(T.allocator_of(?t), LITTLE);
    val wd:  err[Fail] = contract.describe(?m.ok, ?out);
    if (sel wd.err) { ret 1; }
    val want: str = "Stub {\n  Count: 2\n  Items: ( 68 69 )\n}\n";
    if (sink.len(?out) != 39)                                   { ret 1; }
    if (!memory.raw_equal(sink.data(?out)::ptr, want::ptr, 39)) { ret 1; }

    val inside: Location = contract.locate(?m.ok, 9);
    if (inside.record == nil || !str_equals(inside.record, "item") || !inside.indexed || inside.index != 1) { ret 1; }
    val outside: Location = contract.locate(?m.ok, 10);
    if (outside.record != nil) { ret 1; }

    var back: res[Sink, Fail] = contract.write(?m.ok);
    if (sel back.err)                                                      { ret 1; }
    if (sink.len(?back.ok) != 10)                                          { ret 1; }
    if (!memory.raw_equal(sink.data(?back.ok)::ptr, (?bytes[0])::ptr, 10)) { ret 1; }

    val short: [6]u8            = [6]u8{'S', 'T', 'B', '!', 9, 0};
    var cut:   Input            = Input{file: "b.stb", data: ?short[0], len: 6};
    val bad:   res[Model, Fail] = read(?r.ok, T.allocator_of(?t), ?cut);
    if (sel bad.ok)                   { ret 1; }
    if (!sel bad.err.cause.truncated) { ret 1; }

    val r1: err[Fail] = contract.release(?m.ok);
    if (sel r1.err) { ret 1; }
    val r2: err[Fail] = sink.release(?out);
    if (sel r2.err) { ret 1; }
    val r3: err[Fail] = sink.release(?back.ok);
    if (sel r3.err)            { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test registry__refuses_an_unknown_magic {
    val entries: [1]*Registration    = [1]*Registration{?STUB};
    var r:       res[Registry, Fail] = make(?entries[0], 1);
    if (sel r.err) { ret 1; }
    val bytes: [8]u8                    = [8]u8{'S', 'T', 'B', '?', 0, 0, 0, 0};
    var in:    Input                    = Input{file: "c.bin", data: ?bytes[0], len: 8};
    val got:   res[*Registration, Fail] = sniff(?r.ok, ?in);
    if (sel got.ok)                     { ret 1; }
    if (!sel got.err.cause.unsupported) { ret 1; }
    var tiny: Input                    = Input{file: "d.bin", data: ?bytes[0], len: 2};
    val none: res[*Registration, Fail] = sniff(?r.ok, ?tiny);
    if (sel none.ok) { ret 1; }
    ret 0;
}

test registry__refuses_two_formats_claiming_one_magic {
    val clash: [2]*Registration    = [2]*Registration{?STUB, ?NEAR};
    val r:     res[Registry, Fail] = make(?clash[0], 2);
    if (sel r.ok)                  { ret 1; }
    if (!sel r.err.cause.internal) { ret 1; }
    val twice: [2]*Registration    = [2]*Registration{?STUB, ?STUB};
    val again: res[Registry, Fail] = make(?twice[0], 2);
    if (sel again.ok) { ret 1; }
    ret 0;
}
