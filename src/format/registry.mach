use mink.model.section;
use mink.reloc.row;

# entries: the registrations, static
# count:   how many
# readers: what reading each format's files takes, built once
pub rec Registry {
    entries: **Registration;
    count:   usize;
    readers: Readers;
}

# the formats mink is built with, one line each
val BUILTIN_COUNT: usize                        = 4;
val BUILTIN:       [BUILTIN_COUNT]*Registration = [BUILTIN_COUNT]*Registration{?ar.REGISTRATION, ?coff.REGISTRATION, ?elf.REGISTRATION, ?macho.REGISTRATION};

# the formats mink is built with, released with `release`
pub fun builtin(a: *A.Allocator) res[Registry, Fail] {
    ret make(a, ?BUILTIN[0], BUILTIN_COUNT);
}

# a registry of the `count` registrations at `entries`, refused when one is
# incomplete, its pairs do not hold or two claim one magic. the registry is
# released with `release`
pub fun make(a: *A.Allocator, entries: **Registration, count: usize) res[Registry, Fail] {
    var g: Registry  = Registry{entries: entries, count: count, readers: Readers{rows: table.make[Reader](a)}};
    val e: err[Fail] = admit(a, ?g);
    if (sel e.err) {
        val dropped: err[Fail] = release(?g);
        ret res[Registry, Fail].err{e.err};
    }
    ret res[Registry, Fail].ok{g};
}

fun admit(a: *A.Allocator, g: *Registry) err[Fail] {
    var i: usize = 0;
    for (i < g.count) {
        val r: *Registration = g.entries[i];
        if (r.revision_count == 0) { ret err[Fail].err{fail.in_record(fail.internal("format registers no revision"), r.format.name)}; }
        var j: usize = 0;
        for (j < i) {
            if (g.entries[j].format == r.format || str_equals(g.entries[j].format.name, r.format.name)) {
                ret err[Fail].err{fail.in_record(fail.internal("two registrations name one format"), r.format.name)};
            }
            j = j + 1;
        }
        val p: err[Fail] = pairs_hold(a, r);
        if (sel p.err) { ret p; }
        if (sel r.traits.some && !contract.consistent_codec(r.traits.some)) {
            ret err[Fail].err{fail.in_record(fail.internal("a trait codec's encodings do not ascend by axis"), r.format.name)};
        }
        val reader: opt[Reader] = registration.reader_of(r);
        if (sel reader.some) {
            val added: err[Fail] = readers.add(?g.readers, reader.some);
            if (sel added.err) { ret added; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# refuse a registration whose pairs do not hold
fun pairs_hold(a: *A.Allocator, r: *Registration) err[Fail] {
    var i: usize = 0;
    for (i < r.pair_count) {
        val p: *Pair = ?r.pairs[i];
        if (!pair.sound(p, r.format)) {
            ret err[Fail].err{fail.about(fail.in_record(fail.internal("a pair's code or relocation rows are not its own"), r.format.name), p.arch.name)};
        }
        var j: usize = 0;
        for (j < i) {
            if (r.pairs[j].arch == p.arch) { ret err[Fail].err{fail.about(fail.in_record(fail.internal("two pairs name one architecture"), r.format.name), p.arch.name)}; }
            j = j + 1;
        }
        if (sel p.templates.some) {
            val built: res[row.Lookup, Fail] = row.build(a, p.relocs);
            if (sel built.err) { ret err[Fail].err{built.err}; }
            var lookup: row.Lookup = built.ok;
            val c:      err[Fail]  = template.check(p.templates.some, ?lookup);
            val freed:  err[Fail]  = row.release_lookup(?lookup);
            if (sel c.err)     { ret err[Fail].err{fail.about(fail.in_record(c.err, r.format.name), p.arch.name)}; }
            if (sel freed.err) { ret freed; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

pub fun release(g: *Registry) err[Fail] {
    ret readers.release(?g.readers);
}

pub fun count(g: *Registry) usize {
    ret g.count;
}

pub fun at(g: *Registry, index: usize) *Registration {
    ret g.entries[index];
}

pub fun by_format(g: *Registry, f: *Format) res[*Registration, Fail] {
    var i: usize = 0;
    for (i < g.count) {
        if (g.entries[i].format == f) { ret res[*Registration, Fail].ok{g.entries[i]}; }
        i = i + 1;
    }
    ret res[*Registration, Fail].err{fail.in_record(fail.unsupported("the format is not registered"), f.name)};
}

pub fun by_name(g: *Registry, name: str) res[*Registration, Fail] {
    var i: usize = 0;
    for (i < g.count) {
        if (str_equals(g.entries[i].format.name, name)) { ret res[*Registration, Fail].ok{g.entries[i]}; }
        i = i + 1;
    }
    ret res[*Registration, Fail].err{fail.about(fail.unsupported("no format has this name"), name)};
}

# how the format `f` encodes trait axes, refused for a format with no
# objects. contract.encodes answers which axes it needs of an architecture
pub fun traits(g: *Registry, f: *Format) res[*TraitCodec, Fail] {
    val r: res[*Registration, Fail] = by_format(g, f);
    if (sel r.err) { ret res[*TraitCodec, Fail].err{r.err}; }
    val c: opt[*TraitCodec] = r.ok.traits;
    if (sel c.none) { ret res[*TraitCodec, Fail].err{fail.in_record(fail.unsupported("the format encodes no trait axes"), f.name)}; }
    ret res[*TraitCodec, Fail].ok{c.some};
}

# the axis of `a` whose encoding in `f` is the attribute `t` names, none when
# none is, refused for a format with no objects
pub fun attribute(g: *Registry, f: *Format, a: *Arch, t: Tag) res[opt[*Axis], Fail] {
    val c: res[*TraitCodec, Fail] = traits(g, f);
    if (sel c.err) { ret res[opt[*Axis], Fail].err{c.err}; }
    ret res[opt[*Axis], Fail].ok{c.ok.attribute(a, t)};
}

# how the format `f` names sections, refused for a format with none
pub fun naming(g: *Registry, f: *Format) res[*Naming, Fail] {
    val r: res[*Registration, Fail] = by_format(g, f);
    if (sel r.err) { ret res[*Naming, Fail].err{r.err}; }
    val n: opt[*Naming] = r.ok.naming;
    if (sel n.none) { ret res[*Naming, Fail].err{fail.in_record(fail.unsupported("the format names no sections"), f.name)}; }
    ret res[*Naming, Fail].ok{n.some};
}

# the one registered format `in` is a file of
pub fun sniff(g: *Registry, in: *Input) res[*Registration, Fail] {
    val row: res[*Reader, Fail] = readers.sniff(?g.readers, in);
    if (sel row.err) { ret res[*Registration, Fail].err{row.err}; }
    ret by_format(g, row.ok.format);
}

# read `in` as the format it is sniffed as
pub fun read(g: *Registry, a: *A.Allocator, in: *Input) res[Model, Fail] {
    ret readers.read(?g.readers, a, in);
}

test registry__builds_the_formats_and_finds_each_by_name {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var g: res[Registry, Fail] = builtin(T.allocator_of(?t));
    if (sel g.err) { ret 1; }
    var i: usize = 0;
    for (i < count(?g.ok)) {
        val r:    *Registration            = at(?g.ok, i);
        val back: res[*Registration, Fail] = by_name(?g.ok, r.format.name);
        if (sel back.err) { ret 2; }
        if (back.ok != r) { ret 2; }
        i = i + 1;
    }
    val miss: res[*Registration, Fail] = by_name(?g.ok, "a.out");
    if (!sel miss.err) { ret 3; }
    val twice: [2]*Registration    = [2]*Registration{?elf.REGISTRATION, ?elf.REGISTRATION};
    val again: res[Registry, Fail] = make(T.allocator_of(?t), ?twice[0], 2);
    if (!sel again.err)                { ret 4; }
    if (!sel again.err.cause.internal) { ret 4; }
    val freed: err[Fail] = release(?g.ok);
    if (sel freed.err)         { ret 5; }
    if (T.live_count(?t) != 0) { ret 5; }
    T.dnit(?t);
    ret 0;
}

test registry__every_linking_row_is_sound {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);
    var i: usize        = 0;
    for (i < BUILTIN_COUNT) {
        val l: opt[*Linking] = BUILTIN[i].link;
        i = i + 1;
        if (sel l.none) { cnt; }
        var e: res[dynamic.Checked, Fail] = dynamic.check(l.some.dynamic, a);
        if (sel e.err) { ret 2; }
        val de: err[Fail] = dynamic.release_checked(?e.ok);
        if (sel de.err) { ret 2; }
        val d: err[Fail] = dynamic.disjoint(l.some.dynamic);
        if (sel d.err) { ret 3; }
        var c: res[rule.Index, Fail] = layout.check(l.some.layout, a);
        if (sel c.err) { ret 4; }
        val ce: err[Fail] = rule.release(?c.ok);
        if (sel ce.err) { ret 4; }
        val lc: err[Fail] = layout.disjoint(l.some.layout);
        if (sel lc.err) { ret 5; }
        val facts: err[Fail] = merge.check(l.some.facts);
        if (sel facts.err) { ret 6; }
        val uses: err[Fail] = consume.check(?l.some.uses);
        if (sel uses.err) { ret 7; }
    }
    val f: err[Fail] = import.check_forms();
    if (sel f.err)             { ret 8; }
    if (T.live_count(?t) != 0) { ret 9; }
    T.dnit(?t);
    ret 0;
}

test registry__a_format_s_trait_codec_answers_the_axes_it_encodes {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator        = T.allocator_of(?t);
    var g: res[Registry, Fail] = builtin(a);
    if (sel g.err) { ret 1; }

    # ELF must state the float ABI, as its e_flags field holds one, may leave
    # compressed code unstated, and states no base, which the row fixes
    val elf_codec: res[*TraitCodec, Fail] = traits(?g.ok, ?format.ELF);
    if (sel elf_codec.err) { ret 2; }
    var seen: Table[Encoded] = table.make[Encoded](a);
    val e:    err[Fail]      = contract.encodes(elf_codec.ok, ?riscv.RISCV64E, ?seen);
    if (sel e.err) { ret 2; }
    var float: bool  = false;
    var rvc:   bool  = false;
    var i:     usize = 0;
    for (i < table.count[Encoded](?seen)) {
        val x: *Encoded = table.at[Encoded](?seen, table.nth[Encoded](i));
        if (x.axis == ?riscv.RISCV_RVE)       { ret 3; }
        if (x.axis == ?riscv.RISCV_FLOAT_ABI) { float = x.required; }
        if (x.axis == ?riscv.RISCV_RVC)       { rvc = !x.required; }
        i = i + 1;
    }
    if (!float || !rvc) { ret 3; }

    # COFF encodes none, and an archive holds no objects of its own
    val coff_codec: res[*TraitCodec, Fail] = traits(?g.ok, ?format.COFF);
    if (sel coff_codec.err) { ret 4; }
    var none: Table[Encoded] = table.make[Encoded](a);
    val n:    err[Fail]      = contract.encodes(coff_codec.ok, ?x86.X86_64, ?none);
    if (sel n.err || table.count[Encoded](?none) != 0) { ret 4; }
    val archive: res[*TraitCodec, Fail] = traits(?g.ok, ?format.AR);
    if (!sel archive.err)                   { ret 5; }
    if (!sel archive.err.cause.unsupported) { ret 5; }

    val r1: err[Fail] = table.release[Encoded](?seen);
    val r2: err[Fail] = table.release[Encoded](?none);
    val r3: err[Fail] = release(?g.ok);
    if (sel r1.err || sel r2.err || sel r3.err) { ret 1; }
    if (T.live_count(?t) != 0)                  { ret 1; }
    T.dnit(?t);
    ret 0;
}

test registry__an_attribute_names_its_axis_by_tag_name_or_number {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var g: res[Registry, Fail] = builtin(T.allocator_of(?t));
    if (sel g.err) { ret 1; }

    # a RISC-V tag by its full name, its short name or its number
    val tags: [3]Tag = [3]Tag{Tag.name{"Tag_RISCV_stack_align"}, Tag.name{"stack_align"}, Tag.number{4}};
    var i:    usize  = 0;
    for (i < 3) {
        val x: res[opt[*Axis], Fail] = attribute(?g.ok, ?format.ELF, ?riscv.RISCV64, tags[i]);
        if (sel x.err) { ret 2; }
        val named: opt[*Axis] = x.ok;
        if (sel named.none)                         { ret 2; }
        if (named.some != ?riscv.RISCV_STACK_ALIGN) { ret 2; }
        i = i + 1;
    }
    # an unknown tag names none, and an AArch64 number two subsections share
    # names none, as the subsection decides
    val unknown: res[opt[*Axis], Fail] = attribute(?g.ok, ?format.ELF, ?riscv.RISCV64, Tag.number{70});
    if (sel unknown.err) { ret 3; }
    val none: opt[*Axis] = unknown.ok;
    if (sel none.some) { ret 3; }
    val shared: res[opt[*Axis], Fail] = attribute(?g.ok, ?format.ELF, ?aarch64.AARCH64, Tag.number{1});
    if (sel shared.err) { ret 4; }
    val either: opt[*Axis] = shared.ok;
    if (sel either.some) { ret 4; }
    val pac: res[opt[*Axis], Fail] = attribute(?g.ok, ?format.ELF, ?aarch64.AARCH64, Tag.name{"Tag_Feature_PAC"});
    if (sel pac.err) { ret 5; }
    val feature: opt[*Axis] = pac.ok;
    if (sel feature.none)                     { ret 5; }
    if (feature.some != ?aarch64.AARCH64_PAC) { ret 5; }

    val rel: err[Fail] = release(?g.ok);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

# whether `n` takes the name `name` to the kind `k`, nil for none
fun names_kind(n: *Naming, name: str, k: *section.Kind) bool {
    val got: opt[*section.Kind] = n.kind_of(Bytes{data: name::*u8, len: str_len(name)});
    if (k == nil) { ret sel got.none; }
    ret sel got.some && got.some == k;
}

test registry__a_section_name_takes_its_kind_by_the_format_s_convention {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var g: res[Registry, Fail] = builtin(T.allocator_of(?t));
    if (sel g.err) { ret 1; }

    # ELF takes the longest name or start of a name before a dot
    val elf_naming: res[*Naming, Fail] = naming(?g.ok, ?format.ELF);
    if (sel elf_naming.err) { ret 2; }
    val e: *Naming = elf_naming.ok;
    if (!names_kind(e, ".text", ?section.TEXT) || !names_kind(e, ".text.hot.f", ?section.TEXT))                  { ret 2; }
    if (!names_kind(e, ".data.rel.ro.x", ?section.RELRO_DATA) || !names_kind(e, ".data.x", ?section.DATA))       { ret 2; }
    if (!names_kind(e, ".note.GNU-stack", ?section.STACK_NOTE) || !names_kind(e, ".note.x", ?section.NOTE_INFO)) { ret 2; }
    if (!names_kind(e, ".debug_line", nil) || !names_kind(e, ".debug.x", ?section.DEBUG_INFO))                   { ret 2; }
    if (!names_kind(e, ".textual", nil) || !names_kind(e, "text", nil))                                          { ret 2; }
    val named: res[str, Fail] = e.name_of(?section.TEXT);
    if (sel named.err)                  { ret 3; }
    if (!str_equals(named.ok, ".text")) { ret 3; }
    val nameless: res[str, Fail] = e.name_of(?section.NOTE_INFO);
    if (!sel nameless.err) { ret 3; }

    # COFF groups by a dollar sign, and Mach-O takes whole names alone
    val coff_naming: res[*Naming, Fail] = naming(?g.ok, ?format.COFF);
    if (sel coff_naming.err) { ret 4; }
    val c: *Naming = coff_naming.ok;
    if (!names_kind(c, ".text$mn", ?section.TEXT) || !names_kind(c, ".rdata", ?section.RODATA))    { ret 4; }
    if (!names_kind(c, ".tls$", ?section.TLS_DATA) || !names_kind(c, ".tls$x", ?section.TLS_DATA)) { ret 4; }
    val macho_naming: res[*Naming, Fail] = naming(?g.ok, ?format.MACHO);
    if (sel macho_naming.err) { ret 5; }
    val m: *Naming = macho_naming.ok;
    if (!names_kind(m, "__DATA,__const", ?section.RELRO_DATA) || !names_kind(m, "__TEXT,__text.x", nil)) { ret 5; }

    val rel: err[Fail] = release(?g.ok);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
