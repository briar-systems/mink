# the registry of formats
#
# every format mink knows is one registration, listed here on one line, the
# only list of formats. the registry builds the readers index the link phases
# sniff inputs through once, and refuses a registration whose pairs do not
# hold: a pair whose code or relocation rows are not its own, two pairs of one
# architecture, or a code template no relocation row of its pair patches.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.rule;
use mink.base.table;
use mink.catalog.format.Format;
use mink.catalog.merge;
use mink.format.ar;
use mink.format.coff;
use mink.format.coff.import.import;
use mink.format.contract.Input;
use mink.format.contract.Model;
use mink.format.contract.Reader;
use mink.format.elf;
use mink.format.macho;
use mink.format.pair;
use mink.format.pair.Pair;
use mink.format.readers;
use mink.format.readers.Readers;
use mink.format.registration;
use mink.format.registration.Registration;
use mink.link.consume;
use mink.link.dynamic;
use mink.link.layout;
use mink.link.linking.Linking;
use mink.link.template;
use mink.reloc.row;

# entries: the registrations, static
# count:   how many
# readers: what reading each format's files takes, built once
pub rec Registry {
    entries: **Registration;
    count:   usize;
    readers: Readers;
}

# the formats mink is built with, one line each
val BUILTIN_COUNT: usize                        = 4;
val BUILTIN:       [BUILTIN_COUNT]*Registration = [BUILTIN_COUNT]*Registration{?ar.REGISTRATION, ?coff.REGISTRATION, ?elf.REGISTRATION, ?macho.REGISTRATION};

# the formats mink is built with, released with `release`
pub fun builtin(a: *A.Allocator) res[Registry, Fail] {
    ret make(a, ?BUILTIN[0], BUILTIN_COUNT);
}

# a registry of the `count` registrations at `entries`, refused when one is
# incomplete, its pairs do not hold or two claim one magic. the registry is
# released with `release`
pub fun make(a: *A.Allocator, entries: **Registration, count: usize) res[Registry, Fail] {
    var g: Registry  = Registry{entries: entries, count: count, readers: Readers{rows: table.make[Reader](a)}};
    val e: err[Fail] = admit(a, ?g);
    if (sel e.err) {
        val dropped: err[Fail] = release(?g);
        ret res[Registry, Fail].err{e.err};
    }
    ret res[Registry, Fail].ok{g};
}

fun admit(a: *A.Allocator, g: *Registry) err[Fail] {
    var i: usize = 0;
    for (i < g.count) {
        val r: *Registration = g.entries[i];
        if (r.revision_count == 0) { ret err[Fail].err{fail.in_record(fail.internal("format registers no revision"), r.format.name)}; }
        var j: usize = 0;
        for (j < i) {
            if (g.entries[j].format == r.format || str_equals(g.entries[j].format.name, r.format.name)) {
                ret err[Fail].err{fail.in_record(fail.internal("two registrations name one format"), r.format.name)};
            }
            j = j + 1;
        }
        val p: err[Fail] = pairs_hold(a, r);
        if (sel p.err) { ret p; }
        val reader: opt[Reader] = registration.reader_of(r);
        if (sel reader.some) {
            val added: err[Fail] = readers.add(?g.readers, reader.some);
            if (sel added.err) { ret added; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# refuse a registration whose pairs do not hold
fun pairs_hold(a: *A.Allocator, r: *Registration) err[Fail] {
    var i: usize = 0;
    for (i < r.pair_count) {
        val p: *Pair = ?r.pairs[i];
        if (!pair.sound(p, r.format)) {
            ret err[Fail].err{fail.about(fail.in_record(fail.internal("a pair's code or relocation rows are not its own"), r.format.name), p.arch.name)};
        }
        var j: usize = 0;
        for (j < i) {
            if (r.pairs[j].arch == p.arch) { ret err[Fail].err{fail.about(fail.in_record(fail.internal("two pairs name one architecture"), r.format.name), p.arch.name)}; }
            j = j + 1;
        }
        if (sel p.templates.some) {
            val built: res[row.Lookup, Fail] = row.build(a, p.relocs);
            if (sel built.err) { ret err[Fail].err{built.err}; }
            var lookup: row.Lookup = built.ok;
            val c:      err[Fail]  = template.check(p.templates.some, ?lookup);
            val freed:  err[Fail]  = row.release_lookup(?lookup);
            if (sel c.err)     { ret err[Fail].err{fail.about(fail.in_record(c.err, r.format.name), p.arch.name)}; }
            if (sel freed.err) { ret freed; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

pub fun release(g: *Registry) err[Fail] {
    ret readers.release(?g.readers);
}

pub fun count(g: *Registry) usize {
    ret g.count;
}

pub fun at(g: *Registry, index: usize) *Registration {
    ret g.entries[index];
}

pub fun by_format(g: *Registry, f: *Format) res[*Registration, Fail] {
    var i: usize = 0;
    for (i < g.count) {
        if (g.entries[i].format == f) { ret res[*Registration, Fail].ok{g.entries[i]}; }
        i = i + 1;
    }
    ret res[*Registration, Fail].err{fail.in_record(fail.unsupported("the format is not registered"), f.name)};
}

pub fun by_name(g: *Registry, name: str) res[*Registration, Fail] {
    var i: usize = 0;
    for (i < g.count) {
        if (str_equals(g.entries[i].format.name, name)) { ret res[*Registration, Fail].ok{g.entries[i]}; }
        i = i + 1;
    }
    ret res[*Registration, Fail].err{fail.about(fail.unsupported("no format has this name"), name)};
}

# the one registered format `in` is a file of
pub fun sniff(g: *Registry, in: *Input) res[*Registration, Fail] {
    val row: res[*Reader, Fail] = readers.sniff(?g.readers, in);
    if (sel row.err) { ret res[*Registration, Fail].err{row.err}; }
    ret by_format(g, row.ok.format);
}

# read `in` as the format it is sniffed as
pub fun read(g: *Registry, a: *A.Allocator, in: *Input) res[Model, Fail] {
    ret readers.read(?g.readers, a, in);
}

test registry__builds_the_formats_and_finds_each_by_name {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var g: res[Registry, Fail] = builtin(T.allocator_of(?t));
    if (sel g.err) { ret 1; }
    var i: usize = 0;
    for (i < count(?g.ok)) {
        val r:    *Registration            = at(?g.ok, i);
        val back: res[*Registration, Fail] = by_name(?g.ok, r.format.name);
        if (sel back.err) { ret 2; }
        if (back.ok != r) { ret 2; }
        i = i + 1;
    }
    val miss: res[*Registration, Fail] = by_name(?g.ok, "a.out");
    if (!sel miss.err) { ret 3; }
    val twice: [2]*Registration    = [2]*Registration{?elf.REGISTRATION, ?elf.REGISTRATION};
    val again: res[Registry, Fail] = make(T.allocator_of(?t), ?twice[0], 2);
    if (!sel again.err)                { ret 4; }
    if (!sel again.err.cause.internal) { ret 4; }
    val freed: err[Fail] = release(?g.ok);
    if (sel freed.err)         { ret 5; }
    if (T.live_count(?t) != 0) { ret 5; }
    T.dnit(?t);
    ret 0;
}

test registry__every_linking_row_is_sound {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);
    var i: usize        = 0;
    for (i < BUILTIN_COUNT) {
        val l: opt[*Linking] = BUILTIN[i].link;
        i = i + 1;
        if (sel l.none) { cnt; }
        var e: res[dynamic.Checked, Fail] = dynamic.check(l.some.dynamic, a);
        if (sel e.err) { ret 2; }
        val de: err[Fail] = dynamic.release_checked(?e.ok);
        if (sel de.err) { ret 2; }
        val d: err[Fail] = dynamic.disjoint(l.some.dynamic);
        if (sel d.err) { ret 3; }
        var c: res[rule.Index, Fail] = layout.check(l.some.layout, a);
        if (sel c.err) { ret 4; }
        val ce: err[Fail] = rule.release(?c.ok);
        if (sel ce.err) { ret 4; }
        val lc: err[Fail] = layout.disjoint(l.some.layout);
        if (sel lc.err) { ret 5; }
        val facts: err[Fail] = merge.check(l.some.facts);
        if (sel facts.err) { ret 6; }
        val uses: err[Fail] = consume.check(?l.some.uses);
        if (sel uses.err) { ret 7; }
    }
    val f: err[Fail] = import.check_forms();
    if (sel f.err)             { ret 8; }
    if (T.live_count(?t) != 0) { ret 9; }
    T.dnit(?t);
    ret 0;
}
