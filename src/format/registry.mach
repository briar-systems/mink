# the record the registry lists, which its callers read
fwd mink.format.registration.Registration;
# the relocation row a relocation lookup answers
fwd mink.reloc.row.Row;
# the fields of a relocation record a lookup by code takes
fwd mink.format.pair.Coded;

# entries: the registrations, static
# count:   how many
# readers: what reading each format's files takes, built once
# relocs:  the relocation rows of every pair, indexed once
pub rec Registry {
    entries: **Registration;
    count:   usize;
    readers: Readers;
    relocs:  row.Registry;
}

# the formats mink is built with, one line each
val BUILTIN_COUNT: usize                        = 10;
val BUILTIN:       [BUILTIN_COUNT]*Registration = [BUILTIN_COUNT]*Registration{?ar.REGISTRATION, ?coff.REGISTRATION, ?elf.REGISTRATION, ?flat.REGISTRATION, ?macho.REGISTRATION, ?format_res.REGISTRATION, ?spirv.REGISTRATION, ?tbd.REGISTRATION, ?universal.REGISTRATION, ?format_wasm.REGISTRATION};

# the formats mink is built with, released with `release`
pub fun builtin(a: *A.Allocator) res[Registry, Fail] {
    ret make(a, ?BUILTIN[0], BUILTIN_COUNT);
}

# a registry of the `count` registrations at `entries`, refused when one is
# incomplete, its pairs do not hold or two claim one magic. the registry is
# released with `release`
pub fun make(a: *A.Allocator, entries: **Registration, count: usize) res[Registry, Fail] {
    val relocs: res[row.Registry, Fail] = index_relocs(a, entries, count);
    if (sel relocs.err) { ret res[Registry, Fail].err{relocs.err}; }
    var g: Registry  = Registry{entries: entries, count: count, readers: Readers{rows: table.make[Reader](a)}, relocs: relocs.ok};
    val e: err[Fail] = admit(?g);
    if (sel e.err) {
        val dropped: err[Fail] = release(?g);
        ret res[Registry, Fail].err{e.err};
    }
    ret res[Registry, Fail].ok{g};
}

# the relocation rows of every pair of the `count` registrations at
# `entries`, refused when a set is malformed or two sets bind one pair
fun index_relocs(a: *A.Allocator, entries: **Registration, count: usize) res[row.Registry, Fail] {
    var sets: Table[*row.Set] = table.make[*row.Set](a);
    var i:    usize           = 0;
    for (i < count) {
        val r: *Registration = entries[i];
        var j: usize         = 0;
        for (j < r.pair_count) {
            val p: res[Id[*row.Set], Fail] = table.push[*row.Set](?sets, r.pairs[j].relocs);
            if (sel p.err) {
                val dropped: err[Fail] = table.release[*row.Set](?sets);
                ret res[row.Registry, Fail].err{p.err};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    val made:  res[row.Registry, Fail] = row.make(a, table.items[*row.Set](?sets), table.count[*row.Set](?sets));
    val freed: err[Fail]               = table.release[*row.Set](?sets);
    if (sel made.err) { ret made; }
    if (sel freed.err) {
        var built:   row.Registry = made.ok;
        val dropped: err[Fail]    = row.release(?built);
        ret res[row.Registry, Fail].err{freed.err};
    }
    ret made;
}

fun admit(g: *Registry) err[Fail] {
    var i: usize = 0;
    for (i < g.count) {
        val r: *Registration = g.entries[i];
        if (r.revision_count == 0) { ret err[Fail].err{fail.in_record(fail.internal("format registers no revision"), r.format.name)}; }
        var j: usize = 0;
        for (j < i) {
            if (g.entries[j].format == r.format || str_equals(g.entries[j].format.name, r.format.name)) {
                ret err[Fail].err{fail.in_record(fail.internal("two registrations name one format"), r.format.name)};
            }
            j = j + 1;
        }
        val p: err[Fail] = pairs_hold(g, r);
        if (sel p.err) { ret p; }
        val l: err[Fail] = links_hold(g, r);
        if (sel l.err) { ret l; }
        val v: err[Fail] = archive_holds(r);
        if (sel v.err) { ret v; }
        if (sel r.traits.some && !contract.consistent_codec(r.traits.some)) {
            ret err[Fail].err{fail.in_record(fail.internal("a trait codec's encodings do not ascend by axis"), r.format.name)};
        }
        val reader: opt[Reader] = registration.reader_of(r);
        if (sel reader.some) {
            val added: err[Fail] = readers.add(?g.readers, reader.some);
            if (sel added.err) { ret added; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# refuse a registration whose pairs do not hold
fun pairs_hold(g: *Registry, r: *Registration) err[Fail] {
    var i: usize = 0;
    for (i < r.pair_count) {
        val p: *Pair = ?r.pairs[i];
        if (!pair.sound(p, r.format)) {
            ret err[Fail].err{fail.about(fail.in_record(fail.internal("a pair's code or relocation rows are not its own"), r.format.name), p.arch.name)};
        }
        var j: usize = 0;
        for (j < i) {
            if (r.pairs[j].arch == p.arch) { ret err[Fail].err{fail.about(fail.in_record(fail.internal("two pairs name one architecture"), r.format.name), p.arch.name)}; }
            j = j + 1;
        }
        if (sel p.templates.some) {
            val lookup: res[*row.Lookup, Fail] = row.find(?g.relocs, r.format, p.arch);
            if (sel lookup.err) { ret err[Fail].err{fail.about(fail.in_record(lookup.err, r.format.name), p.arch.name)}; }
            val c: err[Fail] = template.check(p.templates.some, lookup.ok);
            if (sel c.err) { ret err[Fail].err{fail.about(fail.in_record(c.err, r.format.name), p.arch.name)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# refuse a registration whose archive variant is a thin one, which holds
# references to files and so is never a static library's variant, or that
# states one while linking as another format, whose objects it archives
fun archive_holds(r: *Registration) err[Fail] {
    val v: opt[*Variant] = r.archive;
    if (sel v.none)          { ret err[Fail].ok{}; }
    if (v.some.thin)         { ret err[Fail].err{fail.in_record(fail.internal("a format's archive variant is a thin one"), r.format.name)}; }
    if (sel r.links_as.some) { ret err[Fail].err{fail.in_record(fail.internal("a format that links as another states an archive variant"), r.format.name)}; }
    ret err[Fail].ok{};
}

# refuse a registration that links as another format unless that format is
# registered, links by its own row and links as no other, and the
# registration names the writer of its image
fun links_hold(g: *Registry, r: *Registration) err[Fail] {
    val via: opt[*Format] = r.links_as;
    if (sel via.none) { ret err[Fail].ok{}; }
    val own:  opt[*Linking] = r.link;
    val bare: Fail          = fail.in_record(fail.internal("a format that links as another names no image writer"), r.format.name);
    if (sel own.none)             { ret err[Fail].err{bare}; }
    if (sel own.some.writer.none) { ret err[Fail].err{bare}; }
    val base: res[*Registration, Fail] = by_format(g, via.some);
    if (sel base.err)              { ret err[Fail].err{fail.about(fail.in_record(fail.internal("a format links as one that is not registered"), r.format.name), via.some.name)}; }
    if (sel base.ok.link.none)     { ret err[Fail].err{fail.about(fail.in_record(fail.internal("a format links as one that has no link of its own"), r.format.name), via.some.name)}; }
    if (sel base.ok.links_as.some) { ret err[Fail].err{fail.about(fail.in_record(fail.internal("a format links as one that links as another"), r.format.name), via.some.name)}; }
    ret err[Fail].ok{};
}

# the registration whose link builds the image `r` writes: the one it links
# as, else its own
pub fun links_of(g: *Registry, r: *Registration) res[*Registration, Fail] {
    val via: opt[*Format] = r.links_as;
    if (sel via.none) { ret res[*Registration, Fail].ok{r}; }
    ret by_format(g, via.some);
}

# the variant a static library of `f`'s objects is written in, the variant of
# the format it links as for one that links as another, refused for a format
# whose objects mink archives in no variant
pub fun archive(g: *Registry, f: *Format) res[*Variant, Fail] {
    val r: res[*Registration, Fail] = by_format(g, f);
    if (sel r.err) { ret res[*Variant, Fail].err{r.err}; }
    val owner: res[*Registration, Fail] = links_of(g, r.ok);
    if (sel owner.err) { ret res[*Variant, Fail].err{owner.err}; }
    val v: opt[*Variant] = owner.ok.archive;
    if (sel v.none) { ret res[*Variant, Fail].err{fail.in_record(fail.unsupported("the format's objects are archived in no variant"), f.name)}; }
    ret res[*Variant, Fail].ok{v.some};
}

# the prefix a C symbol's name carries in an object for the architecture `a`
# that the link of the format `f` takes, empty for none: the pair's of the
# registration whose link builds `f`'s images. refused when the format is not
# registered or states nothing for the architecture
pub fun c_prefix(g: *Registry, f: *Format, a: *Arch) res[str, Fail] {
    val r: res[*Registration, Fail] = by_format(g, f);
    if (sel r.err) { ret res[str, Fail].err{fail.about(r.err, a.name)}; }
    val l: res[*Registration, Fail] = links_of(g, r.ok);
    if (sel l.err) { ret res[str, Fail].err{l.err}; }
    val p: res[*Pair, Fail] = registration.pair_of(l.ok, a);
    if (sel p.err) { ret res[str, Fail].err{p.err}; }
    ret res[str, Fail].ok{p.ok.prefix};
}

pub fun release(g: *Registry) err[Fail] {
    val r: err[Fail] = readers.release(?g.readers);
    val l: err[Fail] = row.release(?g.relocs);
    if (sel r.err) { ret r; }
    ret l;
}

pub fun count(g: *Registry) usize {
    ret g.count;
}

pub fun at(g: *Registry, index: usize) *Registration {
    ret g.entries[index];
}

pub fun by_format(g: *Registry, f: *Format) res[*Registration, Fail] {
    var i: usize = 0;
    for (i < g.count) {
        if (g.entries[i].format == f) { ret res[*Registration, Fail].ok{g.entries[i]}; }
        i = i + 1;
    }
    ret res[*Registration, Fail].err{fail.in_record(fail.unsupported("the format is not registered"), f.name)};
}

pub fun by_name(g: *Registry, name: str) res[*Registration, Fail] {
    var i: usize = 0;
    for (i < g.count) {
        if (str_equals(g.entries[i].format.name, name)) { ret res[*Registration, Fail].ok{g.entries[i]}; }
        i = i + 1;
    }
    ret res[*Registration, Fail].err{fail.about(fail.unsupported("no format has this name"), name)};
}

# how the format `f` encodes trait axes, refused for a format with no
# objects. contract.encodes answers which axes it needs of an architecture
pub fun traits(g: *Registry, f: *Format) res[*TraitCodec, Fail] {
    val r: res[*Registration, Fail] = by_format(g, f);
    if (sel r.err) { ret res[*TraitCodec, Fail].err{r.err}; }
    val c: opt[*TraitCodec] = r.ok.traits;
    if (sel c.none) { ret res[*TraitCodec, Fail].err{fail.in_record(fail.unsupported("the format encodes no trait axes"), f.name)}; }
    ret res[*TraitCodec, Fail].ok{c.some};
}

# append to `out` each trait axis of `a` the format `f` encodes, each with
# whether a file must state it, answered from the codec's own rows. refused,
# naming the format and the architecture and leaving `out` as it was, for a
# format with no objects and an architecture it has no code for. the only
# way a producer learns which axes a format needs
pub fun encodes(g: *Registry, f: *Format, a: *Arch, out: *Table[Encoded]) err[Fail] {
    val c: res[*TraitCodec, Fail] = traits(g, f);
    if (sel c.err) { ret err[Fail].err{fail.about(c.err, a.name)}; }
    val code: opt[*arch.Code] = arch.code(a, f);
    if (sel code.none) { ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the format has no code for the architecture"), f.name), a.name)}; }
    ret contract.encodes(c.ok, a, out);
}

# whether the format `f` writes the traits of an object for `a` in the
# section named `name`, so what that section holds is the format's and never
# a producer's, refused for a format with no objects
pub fun holds_traits(g: *Registry, f: *Format, a: *Arch, name: Bytes) res[bool, Fail] {
    val c: res[*TraitCodec, Fail] = traits(g, f);
    if (sel c.err) { ret res[bool, Fail].err{c.err}; }
    ret res[bool, Fail].ok{c.ok.holds(a, name)};
}

# the axis of `a` whose encoding in `f` is the attribute `t` names, none when
# none is, refused for a format with no objects
pub fun attribute(g: *Registry, f: *Format, a: *Arch, t: Tag) res[opt[*Axis], Fail] {
    val c: res[*TraitCodec, Fail] = traits(g, f);
    if (sel c.err) { ret res[opt[*Axis], Fail].err{c.err}; }
    ret res[opt[*Axis], Fail].ok{c.ok.attribute(a, t)};
}

# what the value `v` written for the attribute that encodes `x` in the
# format `f` states on it, mapped through the axis's encoding row. refused
# for a format with no objects, an axis no attribute of `f` encodes and,
# naming the axis and the value, a value no row maps
pub fun setting(g: *Registry, f: *Format, x: *Axis, v: Written) res[Setting, Fail] {
    val c: res[*TraitCodec, Fail] = traits(g, f);
    if (sel c.err) { ret res[Setting, Fail].err{c.err}; }
    ret c.ok.setting(x, v);
}

# state on `out` the traits of an object for `a` that the section named
# `name` holds in `data`, as the format `f` decodes them, refused for a
# format with no objects, a section of `f` that holds no traits of `a` and,
# naming it, what no row maps. a text is borrowed from `data`, and a refusal
# leaves `out` as it was
pub fun raise(g: *Registry, f: *Format, a: *Arch, name: Bytes, data: Bytes, out: *Table[Trait]) err[Fail] {
    val c: res[*TraitCodec, Fail] = traits(g, f);
    if (sel c.err) { ret err[Fail].err{fail.about(c.err, a.name)}; }
    ret c.ok.raise(a, name, data, out);
}

# how the format `f` names sections, refused for a format with none
pub fun naming(g: *Registry, f: *Format) res[*Naming, Fail] {
    val r: res[*Registration, Fail] = by_format(g, f);
    if (sel r.err) { ret res[*Naming, Fail].err{r.err}; }
    val n: opt[*Naming] = r.ok.naming;
    if (sel n.none) { ret res[*Naming, Fail].err{fail.in_record(fail.unsupported("the format names no sections"), f.name)}; }
    ret res[*Naming, Fail].ok{n.some};
}

# the one registered format `in` is a file of
pub fun sniff(g: *Registry, in: *Input) res[*Registration, Fail] {
    val row: res[*Reader, Fail] = readers.sniff(?g.readers, in);
    if (sel row.err) { ret res[*Registration, Fail].err{row.err}; }
    ret by_format(g, row.ok.format);
}

# read `in` as the format it is sniffed as
pub fun read(g: *Registry, a: *A.Allocator, in: *Input) res[Model, Fail] {
    ret readers.read(?g.readers, a, in);
}

# a file read whole and read as the format it is sniffed as, given back with
# `unload`. a container's model answers its members through contract.members
# ---
# file:  the file's bytes, which the model and what is converted from it
#        borrow
# model: the file as its format reads it, whose reader names the format
pub rec Loaded {
    file:  file.Loaded;
    model: Model;
}

# the file at `path`, read as the format it is sniffed as, refused naming the
# path when it cannot be read or no one format claims it
pub fun load(g: *Registry, a: *A.Allocator, path: str) res[Loaded, Fail] {
    val f: res[file.Loaded, Fail] = file.load(a, path);
    if (sel f.err) { ret res[Loaded, Fail].err{f.err}; }
    var l: Loaded           = Loaded{file: f.ok};
    val m: res[Model, Fail] = read(g, a, ?l.file.input);
    if (sel m.err) {
        val dropped: err[Fail] = file.unload(?l.file);
        ret res[Loaded, Fail].err{m.err};
    }
    l.model = m.ok;
    ret res[Loaded, Fail].ok{l};
}

# give back what `l` holds, its model first, which may already be released
pub fun unload(l: *Loaded) err[Fail] {
    val released: err[Fail] = contract.release(?l.model);
    val unloaded: err[Fail] = file.unload(?l.file);
    if (sel released.err) { ret released; }
    ret unloaded;
}

# `m` written through its format's codec to the file at `path`, replacing it,
# refused naming the path
pub fun save(m: *Model, path: str) err[Fail] {
    val w: res[Sink, Fail] = contract.write(m);
    if (sel w.err) { ret err[Fail].err{fail.in_file(w.err, path)}; }
    var s:     Sink      = w.ok;
    val saved: err[Fail] = file.save(path, ?s);
    val freed: err[Fail] = sink.release(?s);
    if (sel saved.err) { ret saved; }
    ret freed;
}

# the model of the format `f` that holds the neutral object `o`, built for
# the target `o` states, refused for a format that reads no files or has no
# neutral conversion
pub fun from_neutral(g: *Registry, f: *Format, a: *A.Allocator, o: *Object) res[Model, Fail] {
    val r: res[*Reader, Fail] = readers.by_format(?g.readers, f);
    if (sel r.err) { ret res[Model, Fail].err{r.err}; }
    ret contract.from_neutral(r.ok, a, ?g.relocs, o);
}

# the relocation rows of one (format, architecture) pair, valid while the
# registry lives
# ---
# pair: the pair
# rows: its rows, indexed by key and by kind when the registry was built
pub rec Relocations {
    pair: *Pair;
    rows: *row.Lookup;
}

# the relocation rows of the pair (`f`, `a`), refused naming both when the
# format is not registered or states nothing for the architecture
pub fun relocations(g: *Registry, f: *Format, a: *Arch) res[Relocations, Fail] {
    val r: res[*Registration, Fail] = by_format(g, f);
    if (sel r.err) { ret res[Relocations, Fail].err{fail.about(r.err, a.name)}; }
    val p: res[*Pair, Fail] = registration.pair_of(r.ok, a);
    if (sel p.err) { ret res[Relocations, Fail].err{p.err}; }
    val l: res[*row.Lookup, Fail] = row.find(?g.relocs, f, a);
    if (sel l.err) { ret res[Relocations, Fail].err{fail.about(fail.in_record(l.err, f.name), a.name)}; }
    ret res[Relocations, Fail].ok{Relocations{pair: p.ok, rows: l.ok}};
}

# the row of `rs` the neutral kind `k` maps to, refused naming the kind when
# none does
pub fun relocation_by_kind(rs: *Relocations, k: *Kind) res[*Row, Fail] {
    val r: res[*Row, Fail] = row.by_kind(rs.rows, k);
    if (sel r.err) { ret res[*Row, Fail].err{fail.about(fail.in_record(r.err, rs.pair.arch.name), k.name)}; }
    ret r;
}

# the row of `rs` a relocation record of the fields `c` maps to, keyed as the
# pair composes its key, refused when none does
pub fun relocation_by_code(rs: *Relocations, c: *Coded) res[*Row, Fail] {
    val r: res[*Row, Fail] = row.by_key(rs.rows, rs.pair.key_of(c));
    if (sel r.err) { ret res[*Row, Fail].err{fail.valued(fail.in_record(r.err, rs.pair.arch.name), c.code::i128)}; }
    ret r;
}

# whether `f` holds the traits of an object for `a` in the section `name`
fun holds(g: *Registry, f: *Format, a: *Arch, name: str) bool {
    val h: res[bool, Fail] = holds_traits(g, f, a, Bytes{data: name::*u8, len: str_len(name)});
    ret sel h.ok && h.ok;
}
