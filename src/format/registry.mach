# the registry of formats
#
# every format mink knows is one registration, listed on one line in the
# registry's generator, the only list of formats. the generator checks every
# registration and writes the tables the registry is, in format/builtin: the
# registrations, the readers index the link phases sniff inputs through and
# the relocation lookups of every pair. it refuses a registration whose pairs
# do not hold, so nothing is built or checked when mink runs.
#
# the registry sits below the link phases, which read and convert through
# it. it answers what takes the registrations: the format of an input, a
# file loaded or saved whole, relocation lookups and trait encodings, so no
# dependent names a format's own modules.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector.Vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.format.Format;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use format_builtin: mink.format.builtin;
use mink.format.contract;
use mink.format.contract.Encoded;
use mink.format.contract.Input;
use mink.format.contract.Model;
use mink.format.contract.Naming;
use mink.format.contract.Reader;
use mink.format.contract.Tag;
use mink.format.contract.TraitCodec;
use mink.format.contract.Written;
use mink.format.file;
use mink.format.pair;
use mink.format.pair.Coded;
use mink.format.pair.Pair;
use mink.format.readers;
use mink.format.readers.Readers;
use mink.format.registration;
use mink.format.registration.Registration;
use mink.model.reloc.Kind;
use mink.reloc.row;
use mink.reloc.row.Row;

# entries: the registrations, static
# count:   how many
# readers: what reading each format's files takes, static
# relocs:  the relocation lookups of every pair, static
pub rec Registry {
    entries: **Registration;
    count:   usize;
    readers: Readers;
    relocs:  row.Registry;
}

val BUILTIN: Registry = Registry{
    entries: ?format_builtin.ENTRIES[0],
    count:   format_builtin.ENTRY_COUNT,
    readers: Readers{rows: ?format_builtin.READERS[0], count: format_builtin.READER_COUNT},
    relocs:  row.Registry{lookups: ?format_builtin.LOOKUPS[0], count: format_builtin.LOOKUP_COUNT},
};

# the formats mink is built with
pub fun builtin() *Registry {
    ret ?BUILTIN;
}

pub fun count(g: *Registry) usize {
    ret g.count;
}

pub fun at(g: *Registry, index: usize) *Registration {
    ret g.entries[index];
}

pub fun by_format(g: *Registry, f: *Format) res[*Registration, Fail] {
    var i: usize = 0;
    for (i < g.count) {
        if (g.entries[i].format == f) { ret res[*Registration, Fail].ok{g.entries[i]}; }
        i = i + 1;
    }
    ret res[*Registration, Fail].err{fail.in_record(fail.unsupported("the format is not registered"), f.name)};
}

pub fun by_name(g: *Registry, name: str) res[*Registration, Fail] {
    var i: usize = 0;
    for (i < g.count) {
        if (str_equals(g.entries[i].format.name, name)) { ret res[*Registration, Fail].ok{g.entries[i]}; }
        i = i + 1;
    }
    ret res[*Registration, Fail].err{fail.about(fail.unsupported("no format has this name"), name)};
}

# how the format `f` encodes trait axes, refused for a format with no
# objects. contract.encodes answers which axes it needs of an architecture
pub fun traits(g: *Registry, f: *Format) res[*TraitCodec, Fail] {
    val r: res[*Registration, Fail] = by_format(g, f);
    if (sel r.err) { ret res[*TraitCodec, Fail].err{r.err}; }
    val c: opt[*TraitCodec] = r.ok.traits;
    if (sel c.none) { ret res[*TraitCodec, Fail].err{fail.in_record(fail.unsupported("the format encodes no trait axes"), f.name)}; }
    ret res[*TraitCodec, Fail].ok{c.some};
}

# append to `out` each trait axis of `a` the format `f` encodes, each with
# whether a file must state it, answered from the codec's own rows. refused,
# naming the format and the architecture and leaving `out` as it was, for a
# format with no objects and an architecture it has no code for. the only
# way a producer learns which axes a format needs
pub fun encodes(g: *Registry, f: *Format, a: *Arch, out: *Vector[Encoded]) err[Fail] {
    val c: res[*TraitCodec, Fail] = traits(g, f);
    if (sel c.err) { ret err[Fail].err{fail.about(c.err, a.name)}; }
    val code: opt[*arch.Code] = arch.code(a, f);
    if (sel code.none) { ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("the format has no code for the architecture"), f.name), a.name)}; }
    ret contract.encodes(c.ok, a, out);
}

# whether the format `f` writes the traits of an object for `a` in the
# section named `name`, so what that section holds is the format's and never
# a producer's, refused for a format with no objects
pub fun holds_traits(g: *Registry, f: *Format, a: *Arch, name: Bytes) res[bool, Fail] {
    val c: res[*TraitCodec, Fail] = traits(g, f);
    if (sel c.err) { ret res[bool, Fail].err{c.err}; }
    ret res[bool, Fail].ok{c.ok.holds(a, name)};
}

# the axis of `a` whose encoding in `f` is the attribute `t` names, none when
# none is, refused for a format with no objects
pub fun attribute(g: *Registry, f: *Format, a: *Arch, t: Tag) res[opt[*Axis], Fail] {
    val c: res[*TraitCodec, Fail] = traits(g, f);
    if (sel c.err) { ret res[opt[*Axis], Fail].err{c.err}; }
    ret res[opt[*Axis], Fail].ok{c.ok.attribute(a, t)};
}

# what the value `v` written for the attribute that encodes `x` in the
# format `f` states on it, mapped through the axis's encoding row. refused
# for a format with no objects, an axis no attribute of `f` encodes and,
# naming the axis and the value, a value no row maps
pub fun setting(g: *Registry, f: *Format, x: *Axis, v: Written) res[Setting, Fail] {
    val c: res[*TraitCodec, Fail] = traits(g, f);
    if (sel c.err) { ret res[Setting, Fail].err{c.err}; }
    ret c.ok.setting(x, v);
}

# state on `out` the traits of an object for `a` that the section named
# `name` holds in `data`, as the format `f` decodes them, refused for a
# format with no objects, a section of `f` that holds no traits of `a` and,
# naming it, what no row maps. a text is borrowed from `data`, and a refusal
# leaves `out` as it was
pub fun raise(g: *Registry, f: *Format, a: *Arch, name: Bytes, data: Bytes, out: *Vector[Trait]) err[Fail] {
    val c: res[*TraitCodec, Fail] = traits(g, f);
    if (sel c.err) { ret err[Fail].err{fail.about(c.err, a.name)}; }
    ret c.ok.raise(a, name, data, out);
}

# how the format `f` names sections, refused for a format with none
pub fun naming(g: *Registry, f: *Format) res[*Naming, Fail] {
    val r: res[*Registration, Fail] = by_format(g, f);
    if (sel r.err) { ret res[*Naming, Fail].err{r.err}; }
    val n: opt[*Naming] = r.ok.naming;
    if (sel n.none) { ret res[*Naming, Fail].err{fail.in_record(fail.unsupported("the format names no sections"), f.name)}; }
    ret res[*Naming, Fail].ok{n.some};
}

# the one registered format `in` is a file of
pub fun sniff(g: *Registry, in: *Input) res[*Registration, Fail] {
    val row: res[*Reader, Fail] = readers.sniff(?g.readers, in);
    if (sel row.err) { ret res[*Registration, Fail].err{row.err}; }
    ret by_format(g, row.ok.format);
}

# a file read whole and read as the format it is sniffed as, given back with
# `unload`. a container's model answers its members through contract.members
# ---
# file:  the file's bytes, which the model and what is converted from it
#        borrow
# model: the file as its format reads it, whose reader names the format
pub rec Loaded {
    file:  file.Loaded;
    model: Model;
}

# the file at `path`, read as the format it is sniffed as, refused naming the
# path when it cannot be read or no one format claims it
pub fun load(g: *Registry, a: *A.Allocator, path: str) res[Loaded, Fail] {
    val f: res[file.Loaded, Fail] = file.load(a, path);
    if (sel f.err) { ret res[Loaded, Fail].err{f.err}; }
    var l: Loaded           = Loaded{file: f.ok};
    val m: res[Model, Fail] = readers.read(?g.readers, a, ?l.file.input);
    if (sel m.err) {
        val dropped: err[Fail] = file.unload(?l.file);
        ret res[Loaded, Fail].err{m.err};
    }
    l.model = m.ok;
    ret res[Loaded, Fail].ok{l};
}

# give back what `l` holds, its model first, which may already be released
pub fun unload(l: *Loaded) err[Fail] {
    val released: err[Fail] = contract.release(?l.model);
    val unloaded: err[Fail] = file.unload(?l.file);
    if (sel released.err) { ret released; }
    ret unloaded;
}

# `m` written through its format's codec to the file at `path`, replacing it,
# refused naming the path
pub fun save(m: *Model, path: str) err[Fail] {
    val w: res[Sink, Fail] = contract.write(m);
    if (sel w.err) { ret err[Fail].err{fail.in_file(w.err, path)}; }
    var s:     Sink      = w.ok;
    val saved: err[Fail] = file.save(path, ?s);
    val freed: err[Fail] = sink.release(?s);
    if (sel saved.err) { ret saved; }
    ret freed;
}

# the relocation rows of one (format, architecture) pair, valid while the
# registry lives
# ---
# pair: the pair
# rows: its rows, indexed by key and by kind when the registry was built
pub rec Relocations {
    pair: *Pair;
    rows: *row.Lookup;
}

# the relocation rows of the pair (`f`, `a`), refused naming both when the
# format is not registered or states nothing for the architecture
pub fun relocations(g: *Registry, f: *Format, a: *Arch) res[Relocations, Fail] {
    val r: res[*Registration, Fail] = by_format(g, f);
    if (sel r.err) { ret res[Relocations, Fail].err{fail.about(r.err, a.name)}; }
    val p: res[*Pair, Fail] = registration.pair_of(r.ok, a);
    if (sel p.err) { ret res[Relocations, Fail].err{p.err}; }
    val l: res[*row.Lookup, Fail] = row.find(?g.relocs, f, a);
    if (sel l.err) { ret res[Relocations, Fail].err{fail.about(fail.in_record(l.err, f.name), a.name)}; }
    ret res[Relocations, Fail].ok{Relocations{pair: p.ok, rows: l.ok}};
}

# the row of `rs` the neutral kind `k` maps to, refused naming the kind when
# none does
pub fun relocation_by_kind(rs: *Relocations, k: *Kind) res[*Row, Fail] {
    val r: res[*Row, Fail] = row.by_kind(rs.rows, k);
    if (sel r.err) { ret res[*Row, Fail].err{fail.about(fail.in_record(r.err, rs.pair.arch.name), k.name)}; }
    ret r;
}

# the row of `rs` a relocation record of the fields `c` maps to, keyed as the
# pair composes its key, refused when none does
pub fun relocation_by_code(rs: *Relocations, c: *Coded) res[*Row, Fail] {
    val r: res[*Row, Fail] = row.by_key(rs.rows, rs.pair.key_of(c));
    if (sel r.err) { ret res[*Row, Fail].err{fail.valued(fail.in_record(r.err, rs.pair.arch.name), c.code::i128)}; }
    ret r;
}

# whether `f` holds the traits of an object for `a` in the section `name`
fun holds(g: *Registry, f: *Format, a: *Arch, name: str) bool {
    val h: res[bool, Fail] = holds_traits(g, f, a, Bytes{data: name::*u8, len: str_len(name)});
    ret sel h.ok && h.ok;
}
