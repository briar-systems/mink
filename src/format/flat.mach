# the flat format and its registration
#
# a flat image is the loaded bytes of an image from its base and nothing
# else, so mink writes it and never reads one: it has no codec, no objects,
# no sections and no pairs. it links as ELF, as mink.link.flat states.

use mink.catalog.format;
use mink.format.contract.Revision;
use mink.format.registration.Registration;

val REVISIONS: [1]Revision = [1]Revision{
    Revision{spec: "the loaded bytes of an image from its base, as GNU objcopy -O binary writes them", revision: "GNU Binutils 2.47"},
};

pub val REGISTRATION: Registration = Registration{
    format:         ?format.FLAT,
    revisions:      ?REVISIONS[0],
    revision_count: 1,
};
