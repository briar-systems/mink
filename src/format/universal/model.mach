# the fat Mach-O model, every byte of a universal file
#
# a fat file is a container: a big-endian header, a table of architecture
# entries and the thin files they point at, each a slice of the file. fat32
# and fat64 differ only in the width of an entry's offset and size and in
# fat64's reserved field. the extents tile the file from its first byte to
# its last, so a writer gives back every input byte for byte. a slice is held
# as its bytes, which are a thin Mach-O file of their own.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Store;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.slot.Slot;

pub rec HeaderShape {
    size:      usize;
    magic:     Slot;
    nfat_arch: Slot;
}

# fat_arch and fat_arch_64. a fat_arch has no reserved field
pub rec ArchShape {
    size:       usize;
    cputype:    Slot;
    cpusubtype: Slot;
    offset:     Slot;
    length:     Slot;
    align:      Slot;
    reserved:   Slot;
}

pub val HEADER: HeaderShape = HeaderShape{
    size:      8,
    magic:     Slot{offset: 0, width: 4},
    nfat_arch: Slot{offset: 4, width: 4},
};

pub val FAT32: ArchShape = ArchShape{
    size:       20,
    cputype:    Slot{offset: 0, width: 4},
    cpusubtype: Slot{offset: 4, width: 4},
    offset:     Slot{offset: 8, width: 4},
    length:     Slot{offset: 12, width: 4},
    align:      Slot{offset: 16, width: 4},
};

pub val FAT64: ArchShape = ArchShape{
    size:       32,
    cputype:    Slot{offset: 0, width: 4},
    cpusubtype: Slot{offset: 4, width: 4},
    offset:     Slot{offset: 8, width: 8},
    length:     Slot{offset: 16, width: 8},
    align:      Slot{offset: 24, width: 4},
    reserved:   Slot{offset: 28, width: 4},
};

# an architecture entry and the thin file it points at. `length` is size and
# `align` a power of two
pub rec Slice {
    cputype:    u32;
    cpusubtype: u32;
    offset:     u64;
    length:     u64;
    align:      u32;
    reserved:   u32;
    bytes:      Held;
}

# one extent of the file, in file order
# ---
# header: the fat header
# arches: the architecture table
# slice:  a slice's thin file
# raw:    bytes no record covers, such as the padding before a slice
pub tag Extent: u8 {
    header;
    arches;
    slice: Id[Slice];
    raw:   Held;
}

# a whole fat file
# ---
# a:         the allocator every table lives in
# arch:      the shape of an entry, FAT32 or FAT64 by the magic
# magic:     FAT_MAGIC or FAT_MAGIC_64
# nfat_arch: the entry count as written
# slices:    the entries, in table order
# extents:   the file, in file order
# store:     the bytes the model owns
pub rec Fat {
    a:         *A.Allocator;
    arch:      *ArchShape;
    magic:     u32;
    nfat_arch: u32;
    slices:    Table[Slice];
    extents:   Table[Extent];
    store:     Store;
}

pub fun make(a: *A.Allocator, arch: *ArchShape) Fat {
    ret Fat{
        a:       a,
        arch:    arch,
        slices:  table.make[Slice](a),
        extents: table.make[Extent](a),
        store:   store.make(a),
    };
}

# give everything the model owns back, reporting the first refusal
pub fun release(m: *Fat) err[Fail] {
    var first: err[Fail] = table.release[Slice](?m.slices);
    first = fail.kept(first, table.release[Extent](?m.extents));
    ret fail.kept(first, store.release(?m.store));
}

# a copy of the `n` bytes at `p` the model owns
pub fun own(m: *Fat, p: *u8, n: usize) res[Held, Fail] {
    ret store.own(?m.store, p, n);
}

# the bytes of `h`. owned bytes stay valid until the model next owns bytes
pub fun bytes(m: *Fat, h: *Held) Bytes {
    ret store.bytes(?m.store, h);
}

pub fun slice_at(m: *Fat, id: Id[Slice]) *Slice {
    ret table.at[Slice](?m.slices, id);
}
