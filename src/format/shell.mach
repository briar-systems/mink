# the parse shell every format's reader is built on
#
# a reader walks its input through a bounded reader, sizes every table it
# reads through checked arithmetic over the counts the input declares, and
# reports every failure at the file, record and offset it met. formats differ
# only in the records they parse.
#
# a reader refuses or holds raw, and the cause of a failure tells which:
# - refused (malformed, truncated, overflow): anything that stops the reader
#   from bounding the file's bytes. a wrong magic, class or encoding, a header,
#   table or record running past the end of the file or of a container the
#   reader walks to bound the file, a declared count times size or offset sum
#   that overflows, an index or offset outside a table the reader must follow
#   to bound the file, a cycle, and two records claiming the same bytes
# - held raw (unsupported): a structure whose extent is known and in bounds
#   but whose contents do not parse or break a semantic rule, an inner record
#   running past its structure's own extent, and unknown codes in reserved or
#   vendor ranges. its bytes are kept as a raw piece or body, so the file still
#   reads and round trips. the reader raises such a failure as unsupported,
#   carries no side flag, and the boundary of the structure keeps the bytes
#   instead of failing
#
# a refusal of an allocation or of mink itself is never held raw

use std.types.bool.true;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;

use mink.lib.checked;
use mink.lib.fail;
use mink.lib.fail.Cause;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;
use mink.lib.format.contract.Input;
use mink.lib.format.contract.Model;
use mink.lib.format.contract.Registration;
use mink.lib.reader;
use mink.lib.reader.Order;
use mink.lib.reader.Reader;

# a reader over the whole input in `order`
pub fun open(in: *Input, order: Order) Reader {
    ret reader.make(in.file, in.data, in.len, order);
}

# the table of `count` records of `size` bytes at `offset` in `r`, as a reader
# of its own. a table that overflows or runs past the input is refused naming
# `record`
pub fun table(r: *Reader, record: str, offset: u64, count: u64, size: u64) res[Reader, Fail] {
    val at:    Location       = Location{file: r.file, record: record, offset: r.base + offset, placed: true};
    val total: res[u64, Fail] = checked.mul(at, count, size);
    if (sel total.err) { ret res[Reader, Fail].err{total.err}; }
    val sub: res[Reader, Fail] = reader.sub(r, offset, total.ok);
    if (sel sub.err) { ret res[Reader, Fail].err{fail.in_record(sub.err, record)}; }
    ret sub;
}

# the `index`th record of `size` bytes of a table, as a reader of its own
pub fun element(t: *Reader, record: str, index: u64, size: u64) res[Reader, Fail] {
    val at:  Location       = Location{file: t.file, record: record, index: index, indexed: true, offset: t.base, placed: true};
    val pos: res[u64, Fail] = checked.mul(at, index, size);
    if (sel pos.err) { ret res[Reader, Fail].err{pos.err}; }
    val sub: res[Reader, Fail] = reader.sub(t, pos.ok, size);
    if (sel sub.err) { ret res[Reader, Fail].err{fail.in_indexed(sub.err, record, index)}; }
    ret sub;
}

# the failure of a structure inside an extent the reader has already bounded,
# as the reader holds it raw: unsupported, at the same place. an allocator
# refusal and a failure of mink itself keep their cause
pub fun unparsed(f: Fail) Fail {
    if (sel f.cause.refused)  { ret f; }
    or (sel f.cause.internal) { ret f; }
    or (sel f.cause.io)       { ret f; }
    var out: Fail = f;
    out.cause = Cause.unsupported{};
    ret out;
}

# read `in` with the format `reg` registers, every failure naming the file
pub fun run(reg: *Registration, a: *A.Allocator, in: *Input) res[Model, Fail] {
    val data: res[ptr, Fail] = reg.ops.read(a, in);
    if (sel data.err) { ret res[Model, Fail].err{fail.in_file(data.err, in.file)}; }
    ret res[Model, Fail].ok{Model{reg: reg, a: a, data: data.ok}};
}
