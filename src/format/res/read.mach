# the reader of a 32-bit resource file
#
# the reader walks the resources from the start of the file, each header on a
# four byte boundary after the data before it. it refuses a header whose two
# sizes, or whose data, run past the end of the file, and a header too small
# to hold its two sizes, as they stop it from bounding the file. it holds raw
# a header whose fields after its two sizes do not parse within the size it
# states, or do not fill it exactly. the file may end right after the last
# resource's data, before the padding to the next boundary (Win32
# RESOURCEHEADER).

use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Raw;
use mink.base.store.Why;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Reader;
use mink.format.contract.Input;
use res_model: mink.format.res.model;
use mink.format.res.model.Body;
use mink.format.res.model.Header;
use mink.format.res.model.Key;
use mink.format.res.model.Res;
use mink.format.res.model.Resource;
use mink.format.shell;

# the two sizes every header starts with
val SIZES: u64 = 8;

# every header and the padding after every data end on this boundary
val BOUNDARY: u64 = 4;

# the code unit that marks a key as a number rather than a string
val NUMBERED: u16 = 0xffff;

pub fun read(a: *A.Allocator, in: *Input) res[Res, Fail] {
    var r:   Reader    = shell.open(in, LITTLE);
    var m:   Res       = res_model.make(a);
    val got: err[Fail] = resources(?r, ?m);
    if (sel got.err) {
        val dropped: err[Fail] = res_model.release(?m);
        ret res[Res, Fail].err{fail.in_file(got.err, in.file)};
    }
    ret res[Res, Fail].ok{m};
}

fun resources(r: *Reader, m: *Res) err[Fail] {
    val len: u64 = r.len::u64;
    var at:  u64 = 0;
    for (at < len) {
        val index: u64                 = res_model.count(m)::u64;
        val one:   res[Resource, Fail] = resource(r, at);
        if (sel one.err) { ret err[Fail].err{fail.in_indexed(one.err, "resource", index)}; }
        val p: res[Id[Resource], Fail] = table.push[Resource](?m.resources, one.ok);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        val end: u64 = at + one.ok.header_size::u64 + one.ok.data.len::u64;
        if (end == len) { brk; }
        val next: res[u64, Fail] = checked.align_up(Location{file: r.file, record: "resource", index: index, indexed: true}, end, BOUNDARY);
        if (sel next.err) { ret err[Fail].err{next.err}; }
        at = next.ok;
    }
    ret err[Fail].ok{};
}

# the resource whose header starts at `at`
fun resource(r: *Reader, at: u64) res[Resource, Fail] {
    val s: res[usize, Fail] = reader.seek(r, at);
    if (sel s.err) { ret res[Resource, Fail].err{s.err}; }
    val data_size: res[u32, Fail] = reader.u32(r);
    if (sel data_size.err) { ret res[Resource, Fail].err{data_size.err}; }
    val header_size: res[u32, Fail] = reader.u32(r);
    if (sel header_size.err) { ret res[Resource, Fail].err{header_size.err}; }
    if (header_size.ok::u64 < SIZES) {
        ret res[Resource, Fail].err{fail.at_offset(fail.valued(fail.malformed("a resource header is smaller than its two sizes"), header_size.ok::i128), at)};
    }
    val hdr: res[Reader, Fail] = reader.sub(r, at + SIZES, header_size.ok::u64 - SIZES);
    if (sel hdr.err) { ret res[Resource, Fail].err{hdr.err}; }
    val data: res[Reader, Fail] = reader.sub(r, at + header_size.ok::u64, data_size.ok::u64);
    if (sel data.err) { ret res[Resource, Fail].err{data.err}; }
    var fields: Reader            = hdr.ok;
    val parsed: res[Header, Fail] = header(?fields);
    var body:   Body              = Body.raw{Raw{bytes: Held.borrowed{Bytes{data: hdr.ok.data, len: hdr.ok.len}}, why: Why.unsupported{}}};
    if (sel parsed.err) {
        val held: Fail = shell.unparsed(parsed.err);
        if (!sel held.cause.unsupported) { ret res[Resource, Fail].err{held}; }
    }
    if (sel parsed.ok) { body = Body.header{parsed.ok}; }
    ret res[Resource, Fail].ok{Resource{offset: at, header_size: header_size.ok, body: body, data: Bytes{data: data.ok.data, len: data.ok.len}}};
}

# the fields of a header after its two sizes, which must fill `r` exactly
fun header(r: *Reader) res[Header, Fail] {
    val type: res[Key, Fail] = key(r);
    if (sel type.err) { ret res[Header, Fail].err{type.err}; }
    val name: res[Key, Fail] = key(r);
    if (sel name.err) { ret res[Header, Fail].err{name.err}; }
    val pad:  u64            = (BOUNDARY - (SIZES + r.pos::u64) % BOUNDARY) % BOUNDARY;
    val skip: res[*u8, Fail] = reader.bytes(r, pad);
    if (sel skip.err) { ret res[Header, Fail].err{skip.err}; }
    val data_version: res[u32, Fail] = reader.u32(r);
    if (sel data_version.err) { ret res[Header, Fail].err{data_version.err}; }
    val memory_flags: res[u16, Fail] = reader.u16(r);
    if (sel memory_flags.err) { ret res[Header, Fail].err{memory_flags.err}; }
    val language: res[u16, Fail] = reader.u16(r);
    if (sel language.err) { ret res[Header, Fail].err{language.err}; }
    val version: res[u32, Fail] = reader.u32(r);
    if (sel version.err) { ret res[Header, Fail].err{version.err}; }
    val characteristics: res[u32, Fail] = reader.u32(r);
    if (sel characteristics.err) { ret res[Header, Fail].err{characteristics.err}; }
    if (reader.remaining(r) != 0) {
        ret res[Header, Fail].err{fail.at_offset(fail.valued(fail.unsupported("a resource header's fields end before the size it states"), reader.remaining(r)::i128), reader.offset(r))};
    }
    ret res[Header, Fail].ok{Header{
        type:            type.ok,
        name:            name.ok,
        data_version:    data_version.ok,
        memory_flags:    memory_flags.ok,
        language:        language.ok,
        version:         version.ok,
        characteristics: characteristics.ok,
    }};
}

# a type or a name: 0xffff and a number, or the code units of a string up to
# its NUL
fun key(r: *Reader) res[Key, Fail] {
    val start: usize          = r.pos;
    val first: res[u16, Fail] = reader.u16(r);
    if (sel first.err) { ret res[Key, Fail].err{first.err}; }
    if (first.ok == NUMBERED) {
        val n: res[u16, Fail] = reader.u16(r);
        if (sel n.err) { ret res[Key, Fail].err{n.err}; }
        ret res[Key, Fail].ok{Key.number{n.ok}};
    }
    var unit: u16 = first.ok;
    for (unit != 0) {
        val next: res[u16, Fail] = reader.u16(r);
        if (sel next.err) { ret res[Key, Fail].err{next.err}; }
        unit = next.ok;
    }
    ret res[Key, Fail].ok{Key.text{Bytes{data: ?r.data[start], len: r.pos - start - 2}}};
}
