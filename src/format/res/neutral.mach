# a resource file to the neutral object of the resources it carries
#
# every resource after the first, which only marks the file, becomes a
# resource of the object: its type, name, language and data, its strings and
# data borrowed from the file. a resource file states no code page, and its
# data version, memory flags, version and characteristics have no place in
# an image's resource tree, so they are not carried (PE Format, The .rsrc
# Section). a resource held raw is refused. a resource file names no
# architecture, so the object keeps the one it was made for.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Held;
use mink.base.table.Id;
use mink.format.res.model;
use mink.format.res.model.Key;
use mink.format.res.model.Res;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Resource;
use mink.model.object.ResourceKey;

pub fun to_neutral(m: *Res, o: *Object) err[Fail] {
    if (!object.empty(o)) { ret err[Fail].err{fail.internal("a model converts into an empty neutral object")}; }
    var built: Object    = object.blank(o);
    val r:     err[Fail] = convert(m, ?built);
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?built);
        ret r;
    }
    ret object.commit(o, ?built);
}

fun convert(m: *Res, o: *Object) err[Fail] {
    var i: usize = 1;
    for (i < model.count(m)) {
        val e: *model.Resource = model.at(m, i);
        if (sel e.body.raw) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a resource header's fields do not fill the size it states"), "resource", i::u64)}; }
        val h: model.Header            = e.body.header;
        val p: res[Id[Resource], Fail] = object.add_resource(o, Resource{
            type:      key_of(h.type),
            name:      key_of(h.name),
            language:  h.language,
            data:      Held.borrowed{e.data},
            code_page: opt[u32].none{},
        });
        if (sel p.err) { ret err[Fail].err{fail.in_indexed(p.err, "resource", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun key_of(k: Key) ResourceKey {
    if (sel k.number) { ret ResourceKey.number{k.number::u32}; }
    ret ResourceKey.text{Held.borrowed{k.text}};
}
