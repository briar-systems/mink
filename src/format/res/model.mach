# the model of a 32-bit resource file, as a resource compiler writes one
#
# a resource file is a run of resources, each a header and then its data,
# every header starting on a four byte boundary. a header states the size of
# the data and its own size, the resource's type and name, each a number or
# a NUL-terminated string of UTF-16 code units, and, from the next four byte
# boundary, the data version, the memory flags, the language, the version and
# the characteristics. the first resource is an empty one whose type and name
# are the number zero, which marks the file as a 32-bit one (Win32
# RESOURCEHEADER). a header whose fields do not fill exactly the size it
# states is held raw, as written. every string and every resource's data is
# borrowed from the file.

use std.types.error.err;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.store.Raw;
use mink.base.table;
use mink.base.table.Table;

# a resource's type or name
# ---
# number: a number, as the header states it after the 0xffff that marks one
# text:   the code units of a string, little endian, without its NUL
pub tag Key: u8 {
    number: u16;
    text:   Bytes;
}

# the fields of a header after its two sizes
pub rec Header {
    type:            Key;
    name:            Key;
    data_version:    u32;
    memory_flags:    u16;
    language:        u16;
    version:         u32;
    characteristics: u32;
}

# what a header holds
# ---
# header: its fields
# raw:    its bytes after its two sizes, whose fields do not fill exactly the
#         size it states
pub tag Body: u8 {
    header: Header;
    raw:    Raw;
}

# one resource
# ---
# offset:      where its header starts in the file
# header_size: the size its header states, its two sizes included
# body:        what its header holds
# data:        its data
pub rec Resource {
    offset:      u64;
    header_size: u32;
    body:        Body;
    data:        Bytes;
}

# a resource file: its resources in file order
pub rec Res {
    resources: Table[Resource];
}

pub fun make(a: *A.Allocator) Res {
    ret Res{resources: table.make[Resource](a)};
}

pub fun release(r: *Res) err[Fail] {
    ret table.release[Resource](?r.resources);
}

# how many resources the file holds, the mark among them
pub fun count(r: *Res) usize {
    ret table.count[Resource](?r.resources);
}

# the `i`th resource in file order
pub fun at(r: *Res, i: usize) *Resource {
    ret table.at[Resource](?r.resources, table.nth[Resource](i));
}
