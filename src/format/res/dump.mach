# the text form of a resource file
#
# each resource in file order: where its header starts, its two sizes, and
# its header's fields, a string key quoted with every code unit outside
# printable ascii written as \u and four hex digits, or why its header is
# held raw.

use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.format.dump;
use mink.format.dump.Dumper;
use res_model: mink.format.res.model;
use mink.format.res.model.Header;
use mink.format.res.model.Key;
use mink.format.res.model.Res;
use mink.format.res.model.Resource;

pub val FILE:            u32 = 0;
pub val RESOURCE:        u32 = 1;
pub val OFFSET:          u32 = 2;
pub val DATA_SIZE:       u32 = 3;
pub val HEADER_SIZE:     u32 = 4;
pub val TYPE:            u32 = 5;
pub val NAME:            u32 = 6;
pub val DATA_VERSION:    u32 = 7;
pub val MEMORY_FLAGS:    u32 = 8;
pub val LANGUAGE:        u32 = 9;
pub val VERSION:         u32 = 10;
pub val CHARACTERISTICS: u32 = 11;
pub val REASON:          u32 = 12;

pub val FIELD_COUNT: usize            = 13;
pub val FIELDS:      [FIELD_COUNT]str = [FIELD_COUNT]str{
    "ResourceFile", "Resource", "Offset", "DataSize", "HeaderSize", "Type", "Name", "DataVersion", "MemoryFlags", "Language", "Version", "Characteristics", "Reason",
};

pub fun describe(m: *Res, d: *Dumper) err[Fail] {
    val w: err[Fail] = dump.open(d, FILE);
    if (sel w.err) { ret w; }
    var i: usize = 0;
    for (i < res_model.count(m)) {
        val r: err[Fail] = resource(res_model.at(m, i), d);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret dump.close(d);
}

fun resource(e: *Resource, d: *Dumper) err[Fail] {
    var w: err[Fail] = dump.open(d, RESOURCE);
    w = fail.kept(w, dump.hex(d, OFFSET, e.offset));
    w = fail.kept(w, dump.hex(d, DATA_SIZE, e.data.len::u64));
    w = fail.kept(w, dump.hex(d, HEADER_SIZE, e.header_size::u64));
    if (sel w.err) { ret w; }
    if (sel e.body.raw) {
        val r: err[Fail] = dump.reason(d, REASON, ?e.body.raw.why);
        if (sel r.err) { ret r; }
        ret dump.close(d);
    }
    val h: *Header   = ?e.body.header;
    var v: err[Fail] = key(d, TYPE, h.type);
    v = fail.kept(v, key(d, NAME, h.name));
    v = fail.kept(v, dump.hex(d, DATA_VERSION, h.data_version::u64));
    v = fail.kept(v, dump.hex(d, MEMORY_FLAGS, h.memory_flags::u64));
    v = fail.kept(v, dump.hex(d, LANGUAGE, h.language::u64));
    v = fail.kept(v, dump.hex(d, VERSION, h.version::u64));
    v = fail.kept(v, dump.hex(d, CHARACTERISTICS, h.characteristics::u64));
    if (sel v.err) { ret v; }
    ret dump.close(d);
}

fun key(d: *Dumper, field: u32, k: Key) err[Fail] {
    if (sel k.number) { ret dump.decimal(d, field, k.number::u64); }
    ret text(d, field, k.text);
}

# the code units of `b` quoted
fun text(d: *Dumper, field: u32, b: Bytes) err[Fail] {
    var w: err[Fail] = dump.field(d, field);
    w = fail.kept(w, dump.char(d, '"'));
    var i: usize = 0;
    for (i + 1 < b.len) {
        w = fail.kept(w, unit(d, b.data[i]::u16 | (b.data[i + 1]::u16 << 8)));
        i = i + 2;
    }
    if (sel w.err) { ret w; }
    ret dump.text(d, "\"\n");
}

fun unit(d: *Dumper, u: u16) err[Fail] {
    if (u == '"' || u == '\\') {
        val e: err[Fail] = dump.char(d, '\\');
        if (sel e.err) { ret e; }
        ret dump.char(d, u::u8);
    }
    if (u >= 0x20 && u < 0x7f) { ret dump.char(d, u::u8); }
    var w: err[Fail] = dump.text(d, "\\u");
    w = fail.kept(w, dump.char(d, nibble(((u >> 12) & 0xf)::u8)));
    w = fail.kept(w, dump.char(d, nibble(((u >> 8) & 0xf)::u8)));
    w = fail.kept(w, dump.char(d, nibble(((u >> 4) & 0xf)::u8)));
    w = fail.kept(w, dump.char(d, nibble((u & 0xf)::u8)));
    ret w;
}

fun nibble(v: u8) u8 {
    if (v < 10) { ret '0' + v; }
    ret 'a' + v - 10;
}
