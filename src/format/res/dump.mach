# the text form of a resource file
#
# each resource in file order: where its header starts, its two sizes, and
# its header's fields, a string key quoted with every code unit outside
# printable ascii written as \u and four hex digits, or why its header is
# held raw.

use std.types.size.usize;
use std.types.string.str;

use mink.base.store.Bytes;
use mink.format.dump;
use mink.format.dump.Dumper;
use res_model: mink.format.res.model;
use mink.format.res.model.Header;
use mink.format.res.model.Key;
use mink.format.res.model.Res;
use mink.format.res.model.Resource;

pub val FILE:            u32 = 0;
pub val RESOURCE:        u32 = 1;
pub val OFFSET:          u32 = 2;
pub val DATA_SIZE:       u32 = 3;
pub val HEADER_SIZE:     u32 = 4;
pub val TYPE:            u32 = 5;
pub val NAME:            u32 = 6;
pub val DATA_VERSION:    u32 = 7;
pub val MEMORY_FLAGS:    u32 = 8;
pub val LANGUAGE:        u32 = 9;
pub val VERSION:         u32 = 10;
pub val CHARACTERISTICS: u32 = 11;
pub val REASON:          u32 = 12;

pub val FIELD_COUNT: usize            = 13;
pub val FIELDS:      [FIELD_COUNT]str = [FIELD_COUNT]str{
    "ResourceFile", "Resource", "Offset", "DataSize", "HeaderSize", "Type", "Name", "DataVersion", "MemoryFlags", "Language", "Version", "Characteristics", "Reason",
};

pub fun describe(m: *Res, d: *Dumper) {
    dump.open(d, FILE);
    var i: usize = 0;
    for (i < res_model.count(m)) {
        resource(res_model.at(m, i), d);
        i = i + 1;
    }
    dump.close(d);
}

fun resource(e: *Resource, d: *Dumper) {
    dump.open(d, RESOURCE);
    dump.hex(d, OFFSET, e.offset);
    dump.hex(d, DATA_SIZE, e.data.len::u64);
    dump.hex(d, HEADER_SIZE, e.header_size::u64);
    if (sel e.body.raw) {
        dump.reason(d, REASON, ?e.body.raw.why);
        dump.close(d);
        ret;
    }
    val h: *Header = ?e.body.header;
    key(d, TYPE, h.type);
    key(d, NAME, h.name);
    dump.hex(d, DATA_VERSION, h.data_version::u64);
    dump.hex(d, MEMORY_FLAGS, h.memory_flags::u64);
    dump.hex(d, LANGUAGE, h.language::u64);
    dump.hex(d, VERSION, h.version::u64);
    dump.hex(d, CHARACTERISTICS, h.characteristics::u64);
    dump.close(d);
}

fun key(d: *Dumper, field: u32, k: Key) {
    if (sel k.number) {
        dump.decimal(d, field, k.number::u64);
        ret;
    }
    text(d, field, k.text);
}

# the code units of `b` quoted
fun text(d: *Dumper, field: u32, b: Bytes) {
    dump.field(d, field);
    dump.char(d, '"');
    var i: usize = 0;
    for (i + 1 < b.len) {
        unit(d, b.data[i]::u16 | (b.data[i + 1]::u16 << 8));
        i = i + 2;
    }
    dump.text(d, "\"\n");
}

fun unit(d: *Dumper, u: u16) {
    if (u == '"' || u == '\\') {
        dump.char(d, '\\');
        dump.char(d, u::u8);
        ret;
    }
    if (u >= 0x20 && u < 0x7f) {
        dump.char(d, u::u8);
        ret;
    }
    dump.text(d, "\\u");
    dump.char(d, nibble(((u >> 12) & 0xf)::u8));
    dump.char(d, nibble(((u >> 8) & 0xf)::u8));
    dump.char(d, nibble(((u >> 4) & 0xf)::u8));
    dump.char(d, nibble((u & 0xf)::u8));
}

fun nibble(v: u8) u8 {
    if (v < 10) { ret '0' + v; }
    ret 'a' + v - 10;
}
