    ?R_WASM_TABLE_INDEX_I32,
    ?R_WASM_MEMORY_ADDR_LEB,
    ?R_WASM_MEMORY_ADDR_SLEB,
    ?R_WASM_MEMORY_ADDR_I32,
    ?R_WASM_TYPE_INDEX_LEB,
