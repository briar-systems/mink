# the wasm constant tables, generated by vendor/llvm/gen-wasm-tables.py
# from the LLVM Wasm.h and WasmRelocs.def pinned in vendor/llvm/REVISION.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

# one named constant: its name as the specification spells it, its value and
# the specification that defines it
pub rec Constant {
    name:   str;
    value:  u64;
    source: str;
}

# a table: the number of rows and where the first one lives
pub rec Set {
    count: usize;
    rows:  **Constant;
}

# a relocation type, and whether its record carries an addend
pub rec Relocation {
    name:   str;
    value:  u64;
    source: str;
    addend: bool;
}

pub rec RelocationSet {
    count: usize;
    rows:  **Relocation;
}

# the version of the binary format the reader decodes
pub val VERSION: u64 = 0x1;
# the version of the linking section the reader decodes
pub val METADATA_VERSION: u64 = 0x2;
# the bytes of a memory page, absent the custom page sizes proposal
pub val DEFAULT_PAGE_SIZE: u64 = 0x10000;

