# the wasm relocation kinds, rows and pairs
#
# every relocation the linking convention defines has a row, keyed by its
# type code, and one kind of its own, so a code maps back to itself. the
# rows are the same for wasm32 and wasm64, as the convention gives each
# width its own codes, and each pair lists them under its architecture.
# a LEB field is a run of padded LEB128 bytes, five for a 32-bit value and
# ten for a 64-bit one, whose length is that of the encoding already there,
# and a word field is a plain little endian word. an index kind writes the
# target's index in its space, a table index kind the index of the target's
# table slot, a memory address kind the target's address in linear memory,
# a relative kind the distance from the memory or table base, and an offset
# kind the target's offset in its section or in the code section.

use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail.Fail;
use mink.catalog.arch.Arch;
use mink.catalog.arch.wasm;
use mink.catalog.format;
use mink.catalog.slot;
use mink.catalog.slot.SlotRole;
use mink.format.pair;
use mink.format.pair.Pair;
use mink.format.wasm.tables;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.model.reloc.Tls;
use mink.reloc.compute;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row;
use mink.reloc.row.Addend;
use mink.reloc.row.FieldChoice;
use mink.reloc.row.Lookup;
use mink.reloc.row.Row;
use mink.reloc.row.Set;

pub val FUNCTION_INDEX_LEB:     Kind = Kind{name: "function_index_leb", caps: reloc.INDEX, takes: ?reloc.NAMED};
pub val TABLE_INDEX_SLEB:       Kind = Kind{name: "table_index_sleb", caps: reloc.INDEX, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.WASM_TABLE}};
pub val TABLE_INDEX_I32:        Kind = Kind{name: "table_index_i32", caps: reloc.INDEX, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.WASM_TABLE}};
pub val MEMORY_ADDR_LEB:        Kind = Kind{name: "memory_addr_leb", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val MEMORY_ADDR_SLEB:       Kind = Kind{name: "memory_addr_sleb", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val MEMORY_ADDR_I32:        Kind = Kind{name: "memory_addr_i32", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val TYPE_INDEX_LEB:         Kind = Kind{name: "type_index_leb", caps: reloc.INDEX, takes: ?reloc.NAMED};
pub val GLOBAL_INDEX_LEB:       Kind = Kind{name: "global_index_leb", caps: reloc.INDEX, takes: ?reloc.NAMED};
pub val FUNCTION_OFFSET_I32:    Kind = Kind{name: "function_offset_i32", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SECTION_OFFSET_I32:     Kind = Kind{name: "section_offset_i32", caps: reloc.SECREL, takes: ?reloc.NAMED};
pub val TAG_INDEX_LEB:          Kind = Kind{name: "tag_index_leb", caps: reloc.INDEX, takes: ?reloc.NAMED};
pub val MEMORY_ADDR_REL_SLEB:   Kind = Kind{name: "memory_addr_rel_sleb", caps: reloc.IMAGE, takes: ?reloc.NAMED};
pub val TABLE_INDEX_REL_SLEB:   Kind = Kind{name: "table_index_rel_sleb", caps: reloc.IMAGE, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.WASM_TABLE}};
pub val GLOBAL_INDEX_I32:       Kind = Kind{name: "global_index_i32", caps: reloc.INDEX, takes: ?reloc.NAMED};
pub val MEMORY_ADDR_LEB64:      Kind = Kind{name: "memory_addr_leb64", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val MEMORY_ADDR_SLEB64:     Kind = Kind{name: "memory_addr_sleb64", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val MEMORY_ADDR_I64:        Kind = Kind{name: "memory_addr_i64", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val MEMORY_ADDR_REL_SLEB64: Kind = Kind{name: "memory_addr_rel_sleb64", caps: reloc.IMAGE, takes: ?reloc.NAMED};
pub val TABLE_INDEX_SLEB64:     Kind = Kind{name: "table_index_sleb64", caps: reloc.INDEX, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.WASM_TABLE}};
pub val TABLE_INDEX_I64:        Kind = Kind{name: "table_index_i64", caps: reloc.INDEX, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.WASM_TABLE}};
pub val TABLE_NUMBER_LEB:       Kind = Kind{name: "table_number_leb", caps: reloc.INDEX, takes: ?reloc.NAMED};
pub val MEMORY_ADDR_TLS_SLEB:   Kind = Kind{name: "memory_addr_tls_sleb", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.le{}};
pub val FUNCTION_OFFSET_I64:    Kind = Kind{name: "function_offset_i64", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val MEMORY_ADDR_LOCREL_I32: Kind = Kind{name: "memory_addr_locrel_i32", caps: reloc.PC, takes: ?reloc.NAMED};
pub val TABLE_INDEX_REL_SLEB64: Kind = Kind{name: "table_index_rel_sleb64", caps: reloc.IMAGE, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.WASM_TABLE}};
pub val MEMORY_ADDR_TLS_SLEB64: Kind = Kind{name: "memory_addr_tls_sleb64", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.le{}};
pub val FUNCTION_INDEX_I32:     Kind = Kind{name: "function_index_i32", caps: reloc.INDEX, takes: ?reloc.NAMED};
pub val MEMORY_ADDR_LOCREL_I64: Kind = Kind{name: "memory_addr_locrel_i64", caps: reloc.PC, takes: ?reloc.NAMED};

# a padded LEB128 run: a piece per byte, the low seven bits of each
val LEB32_PIECES: [5]Piece  = [5]Piece{Piece{at: 0, width: 7}, Piece{at: 8, width: 7}, Piece{at: 16, width: 7}, Piece{at: 24, width: 7}, Piece{at: 32, width: 7}};
val LEB64_PIECES: [10]Piece = [10]Piece{
    Piece{at: 0, width: 7}, Piece{at: 8, width: 7}, Piece{at: 16, width: 7}, Piece{at: 24, width: 7}, Piece{at: 32, width: 7},
    Piece{at: 40, width: 7}, Piece{at: 48, width: 7}, Piece{at: 56, width: 7}, Piece{at: 64, width: 7}, Piece{at: 72, width: 7},
};
val P32: [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val P64: [1]Piece = [1]Piece{Piece{at: 0, width: 64}};

val LEB32: Field = Field{bytes: 5, pieces: ?LEB32_PIECES[0], count: 5, run: true};
val LEB64: Field = Field{bytes: 10, pieces: ?LEB64_PIECES[0], count: 10, run: true};
val I32:   Field = Field{bytes: 4, pieces: ?P32[0], count: 1};
val I64:   Field = Field{bytes: 8, pieces: ?P64[0], count: 1};

val LEB32_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?LEB32}};
val LEB64_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?LEB64}};
val I32_FIELD:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?I32}};
val I64_FIELD:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?I64}};

val U32: Range = Range{check: field.Check.unsigned{}, bits: 32, align: 1};
val S32: Range = Range{check: field.Check.signed{}, bits: 32, align: 1};
val E32: Range = Range{check: field.Check.either{}, bits: 32, align: 1};
val U64: Range = Range{check: field.Check.unsigned{}, bits: 64, align: 1};
val S64: Range = Range{check: field.Check.signed{}, bits: 64, align: 1};
val E64: Range = Range{check: field.Check.either{}, bits: 64, align: 1};

pub val ROW_COUNT: usize = 28;

# the rows, keyed by the relocation type, in the order of the type codes
pub val ROWS: [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{key: 0, name: "R_WASM_FUNCTION_INDEX_LEB", kind: ?FUNCTION_INDEX_LEB, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U32, addend: Addend.none{}},
    Row{key: 1, name: "R_WASM_TABLE_INDEX_SLEB", kind: ?TABLE_INDEX_SLEB, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.INDEX, range: S32, addend: Addend.none{}},
    Row{key: 2, name: "R_WASM_TABLE_INDEX_I32", kind: ?TABLE_INDEX_I32, fields: ?I32_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U32, addend: Addend.none{}},
    Row{key: 3, name: "R_WASM_MEMORY_ADDR_LEB", kind: ?MEMORY_ADDR_LEB, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.ABS, range: U32, addend: Addend.record{}},
    Row{key: 4, name: "R_WASM_MEMORY_ADDR_SLEB", kind: ?MEMORY_ADDR_SLEB, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.ABS, range: S32, addend: Addend.record{}},
    Row{key: 5, name: "R_WASM_MEMORY_ADDR_I32", kind: ?MEMORY_ADDR_I32, fields: ?I32_FIELD[0], field_count: 1, value: ?compute.ABS, range: E32, addend: Addend.record{}},
    Row{key: 6, name: "R_WASM_TYPE_INDEX_LEB", kind: ?TYPE_INDEX_LEB, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U32, addend: Addend.none{}},
    Row{key: 7, name: "R_WASM_GLOBAL_INDEX_LEB", kind: ?GLOBAL_INDEX_LEB, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U32, addend: Addend.none{}},
    Row{key: 8, name: "R_WASM_FUNCTION_OFFSET_I32", kind: ?FUNCTION_OFFSET_I32, fields: ?I32_FIELD[0], field_count: 1, value: ?compute.ABS, range: E32, addend: Addend.record{}},
    Row{key: 9, name: "R_WASM_SECTION_OFFSET_I32", kind: ?SECTION_OFFSET_I32, fields: ?I32_FIELD[0], field_count: 1, value: ?compute.SECREL, range: E32, addend: Addend.record{}},
    Row{key: 10, name: "R_WASM_TAG_INDEX_LEB", kind: ?TAG_INDEX_LEB, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U32, addend: Addend.none{}},
    Row{key: 11, name: "R_WASM_MEMORY_ADDR_REL_SLEB", kind: ?MEMORY_ADDR_REL_SLEB, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.IMAGE, range: S32, addend: Addend.record{}},
    Row{key: 12, name: "R_WASM_TABLE_INDEX_REL_SLEB", kind: ?TABLE_INDEX_REL_SLEB, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.IMAGE, range: S32, addend: Addend.none{}},
    Row{key: 13, name: "R_WASM_GLOBAL_INDEX_I32", kind: ?GLOBAL_INDEX_I32, fields: ?I32_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U32, addend: Addend.none{}},
    Row{key: 14, name: "R_WASM_MEMORY_ADDR_LEB64", kind: ?MEMORY_ADDR_LEB64, fields: ?LEB64_FIELD[0], field_count: 1, value: ?compute.ABS, range: U64, addend: Addend.record{}},
    Row{key: 15, name: "R_WASM_MEMORY_ADDR_SLEB64", kind: ?MEMORY_ADDR_SLEB64, fields: ?LEB64_FIELD[0], field_count: 1, value: ?compute.ABS, range: S64, addend: Addend.record{}},
    Row{key: 16, name: "R_WASM_MEMORY_ADDR_I64", kind: ?MEMORY_ADDR_I64, fields: ?I64_FIELD[0], field_count: 1, value: ?compute.ABS, range: E64, addend: Addend.record{}},
    Row{key: 17, name: "R_WASM_MEMORY_ADDR_REL_SLEB64", kind: ?MEMORY_ADDR_REL_SLEB64, fields: ?LEB64_FIELD[0], field_count: 1, value: ?compute.IMAGE, range: S64, addend: Addend.record{}},
    Row{key: 18, name: "R_WASM_TABLE_INDEX_SLEB64", kind: ?TABLE_INDEX_SLEB64, fields: ?LEB64_FIELD[0], field_count: 1, value: ?compute.INDEX, range: S64, addend: Addend.none{}},
    Row{key: 19, name: "R_WASM_TABLE_INDEX_I64", kind: ?TABLE_INDEX_I64, fields: ?I64_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U64, addend: Addend.none{}},
    Row{key: 20, name: "R_WASM_TABLE_NUMBER_LEB", kind: ?TABLE_NUMBER_LEB, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U32, addend: Addend.none{}},
    Row{key: 21, name: "R_WASM_MEMORY_ADDR_TLS_SLEB", kind: ?MEMORY_ADDR_TLS_SLEB, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.ABS, range: S32, addend: Addend.record{}},
    Row{key: 22, name: "R_WASM_FUNCTION_OFFSET_I64", kind: ?FUNCTION_OFFSET_I64, fields: ?I64_FIELD[0], field_count: 1, value: ?compute.ABS, range: E64, addend: Addend.record{}},
    Row{key: 23, name: "R_WASM_MEMORY_ADDR_LOCREL_I32", kind: ?MEMORY_ADDR_LOCREL_I32, fields: ?I32_FIELD[0], field_count: 1, value: ?compute.PC, range: E32, addend: Addend.record{}},
    Row{key: 24, name: "R_WASM_TABLE_INDEX_REL_SLEB64", kind: ?TABLE_INDEX_REL_SLEB64, fields: ?LEB64_FIELD[0], field_count: 1, value: ?compute.IMAGE, range: S64, addend: Addend.none{}},
    Row{key: 25, name: "R_WASM_MEMORY_ADDR_TLS_SLEB64", kind: ?MEMORY_ADDR_TLS_SLEB64, fields: ?LEB64_FIELD[0], field_count: 1, value: ?compute.ABS, range: S64, addend: Addend.record{}},
    Row{key: 26, name: "R_WASM_FUNCTION_INDEX_I32", kind: ?FUNCTION_INDEX_I32, fields: ?I32_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U32, addend: Addend.none{}},
    Row{key: 27, name: "R_WASM_MEMORY_ADDR_LOCREL_I64", kind: ?MEMORY_ADDR_LOCREL_I64, fields: ?I64_FIELD[0], field_count: 1, value: ?compute.PC, range: E64, addend: Addend.record{}},
};

val KINDS: [ROW_COUNT]*Kind = [ROW_COUNT]*Kind{
    ?FUNCTION_INDEX_LEB, ?TABLE_INDEX_SLEB, ?TABLE_INDEX_I32, ?MEMORY_ADDR_LEB, ?MEMORY_ADDR_SLEB, ?MEMORY_ADDR_I32,
    ?TYPE_INDEX_LEB, ?GLOBAL_INDEX_LEB, ?FUNCTION_OFFSET_I32, ?SECTION_OFFSET_I32, ?TAG_INDEX_LEB, ?MEMORY_ADDR_REL_SLEB,
    ?TABLE_INDEX_REL_SLEB, ?GLOBAL_INDEX_I32, ?MEMORY_ADDR_LEB64, ?MEMORY_ADDR_SLEB64, ?MEMORY_ADDR_I64,
    ?MEMORY_ADDR_REL_SLEB64, ?TABLE_INDEX_SLEB64, ?TABLE_INDEX_I64, ?TABLE_NUMBER_LEB, ?MEMORY_ADDR_TLS_SLEB,
    ?FUNCTION_OFFSET_I64, ?MEMORY_ADDR_LOCREL_I32, ?TABLE_INDEX_REL_SLEB64, ?MEMORY_ADDR_TLS_SLEB64,
    ?FUNCTION_INDEX_I32, ?MEMORY_ADDR_LOCREL_I64,
};

# the rows under each architecture, as a set names the architecture whose
# bytes it patches
pub val WASM32_SET: Set = Set{format: ?format.WASM, arch: ?wasm.WASM32, rows: ?ROWS[0], count: ROW_COUNT, kinds: ?KINDS[0], kind_count: ROW_COUNT};
pub val WASM64_SET: Set = Set{format: ?format.WASM, arch: ?wasm.WASM64, rows: ?ROWS[0], count: ROW_COUNT, kinds: ?KINDS[0], kind_count: ROW_COUNT};

# every relocation names a target, so no symbol reference stands for none,
# and a C symbol's name carries no prefix
pub val PAIR_COUNT: usize            = 2;
pub val PAIRS:      [PAIR_COUNT]Pair = [PAIR_COUNT]Pair{
    Pair{arch: ?wasm.WASM32, code: ?wasm.WASM32_CODES[0], key_of: pair.code_key, relocs: ?WASM32_SET},
    Pair{arch: ?wasm.WASM64, code: ?wasm.WASM64_CODES[0], key_of: pair.code_key, relocs: ?WASM64_SET},
};

# the pair of `a`
pub fun of(a: *Arch) res[*Pair, Fail] {
    ret pair.of(?format.WASM, ?PAIRS[0], PAIR_COUNT, a);
}

# an index of the relocation rows of every pair, for a test below the format
# registry, which owns the one index a process converts and links with. the
# index is released with `row.release`
#[testing]
pub fun index(a: *A.Allocator) res[row.Registry, Fail] {
    var sets: [PAIR_COUNT]*row.Set;
    var i:    usize = 0;
    for (i < PAIR_COUNT) {
        sets[i] = PAIRS[i].relocs;
        i       = i + 1;
    }
    ret row.make(a, ?sets[0], PAIR_COUNT);
}

test reloc__every_convention_relocation_has_a_row_and_both_pairs_are_sound {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);
    var i: usize        = 0;
    for (i < PAIR_COUNT) {
        if (!pair.sound(?PAIRS[i], ?format.WASM)) { ret 2; }
        val got: res[*Pair, Fail] = of(PAIRS[i].arch);
        if (sel got.err)         { ret 2; }
        if (got.ok != ?PAIRS[i]) { ret 2; }
        i = i + 1;
    }
    var reg: res[row.Registry, Fail] = index(a);
    if (sel reg.err) { ret 3; }
    val l: res[*Lookup, Fail] = row.find(?reg.ok, ?format.WASM, ?wasm.WASM64);
    if (sel l.err)                       { ret 3; }
    if (tables.RELOC.count != ROW_COUNT) { ret 4; }
    i = 0;
    for (i < tables.RELOC.count) {
        val c: *tables.Relocation = tables.RELOC.rows[i];
        val r: res[*Row, Fail]    = row.by_key(l.ok, c.value::u32);
        if (sel r.err)                            { ret 5; }
        if (!str_equals(r.ok.name, c.name))       { ret 5; }
        if ((sel r.ok.addend.record) != c.addend) { ret 6; }
        val back: res[*Row, Fail] = row.by_kind(l.ok, r.ok.kind);
        if (sel back.err)    { ret 7; }
        if (back.ok != r.ok) { ret 7; }
        i = i + 1;
    }
    val freed: err[Fail] = row.release(?reg.ok);
    if (sel freed.err)         { ret 8; }
    if (T.live_count(?t) != 0) { ret 8; }
    T.dnit(?t);
    ret 0;
}
