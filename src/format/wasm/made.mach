# the link's own object for a wasm image
#
# a wasm image holds what no input defines: the linear memory, the function
# table, the stack pointer, the globals position independent code reads the
# memory base and the thread-local block's start from, and the function that
# calls the init functions. the link makes them as one object before
# resolution, each an entry defined by a symbol of the name the conventions
# give it, so an input's import of that name resolves to it, and exports the
# memory as wasm-ld does. the stack pointer starts at the link's image base,
# where the stack ends and the data begins, and the memory base is the image
# base too, as a relative memory address counts from it. facts of the format
# name the entries whose value the image writer gives once the image is laid
# out: the table's size, the memory's pages, the start of the thread-local
# block and the calls of the init functions.

use std.encoding.leb128;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.table.Id;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.catalog.format;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.format.wasm.neutral;
use mink.format.wasm.tables;
use mink.format.wasm.write;
use mink.link.synthesizer;
use mink.link.synthesizer.Context;
use mink.link.synthesizer.Row;
use mink.model.directive;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Definition;
use mink.model.object.Entry;
use mink.model.object.Fact;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.section;
use mink.model.space;
use mink.model.symbol;

# the names the conventions give what the link defines
pub val MEMORY_NAME: str = "__linear_memory";
pub val TABLE_NAME:  str = "__indirect_function_table";
pub val STACK_NAME:  str = "__stack_pointer";
pub val BASE_NAME:   str = "__memory_base";
pub val TLS_NAME:    str = "__tls_base";
pub val CTORS_NAME:  str = "__wasm_call_ctors";

# the name the memory is exported by
val MEMORY_EXPORT: str = "memory";

val KINDS: [2]*Kind = [2]*Kind{?output.STATIC, ?output.MODULE};

pub val ROW: Row = Row{name: "the link's own wasm entries", stage: ?synthesizer.BEFORE_RESOLVE, needs: arch.ADDRESSED | arch.INDEXED, kinds: ?KINDS[0], kind_count: 2, make: make};

fun make(c: *Context, o: *Object) res[bool, Fail] {
    val e: err[Fail] = made(c, o);
    if (sel e.err) { ret res[bool, Fail].err{e.err}; }
    ret res[bool, Fail].ok{true};
}

fun made(c: *Context, o: *Object) err[Fail] {
    val op: res[u8, Fail] = neutral.address_const(c.target.arch);
    if (sel op.err) { ret err[Fail].err{op.err}; }
    var valtype: u8 = tables.WASM_TYPE_I32.value::u8;
    var memory:  u8 = tables.WASM_LIMITS_FLAG_NONE.value::u8;
    if (op.ok == tables.WASM_OPCODE_I64_CONST.value::u8) {
        valtype = tables.WASM_TYPE_I64.value::u8;
        memory  = tables.WASM_LIMITS_FLAG_IS_64.value::u8;
    }

    val void: [3]u8                = [3]u8{tables.WASM_TYPE_FUNC.value::u8, 0, 0};
    val type: res[Id[Entry], Fail] = entry(o, Entry{space: ?space.TYPES}, neutral.TYPE, ?void[0], 3);
    if (sel type.err) { ret err[Fail].err{type.err}; }

    val body: [2]u8               = [2]u8{0, tables.WASM_OPCODE_END.value::u8};
    val held: res[Contents, Fail] = object.own(o, ?body[0], 2);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    val code: res[Id[object.Section], Fail] = object.add_section(o, object.Section{kind: ?section.TEXT, flags: section.TEXT.flags, align: 1, contents: held.ok, disposition: ?section.WHOLE});
    if (sel code.err) { ret err[Fail].err{code.err}; }
    val ctors: res[Id[Entry], Fail] = object.add_entry(o, Entry{space: ?space.FUNCTIONS, body: opt[Place].some{Place{section: code.ok, offset: 0}}, signature: opt[Id[Entry]].some{type.ok}});
    if (sel ctors.err) { ret err[Fail].err{ctors.err}; }
    val cs: err[Fail] = defined(o, CTORS_NAME, ?symbol.FUNCTION, ctors.ok, neutral.CALL_CTORS);
    if (sel cs.err) { ret cs; }

    val table_type: [3]u8                = [3]u8{tables.WASM_TYPE_FUNCREF.value::u8, tables.WASM_LIMITS_FLAG_NONE.value::u8, 0};
    val tb:         res[Id[Entry], Fail] = entry(o, Entry{space: ?space.TABLES}, neutral.ENTRY_TYPE, ?table_type[0], 3);
    if (sel tb.err) { ret err[Fail].err{tb.err}; }
    val ts: err[Fail] = defined(o, TABLE_NAME, ?symbol.INDEXED, tb.ok, neutral.FUNCTION_TABLE);
    if (sel ts.err) { ret ts; }

    val limits: [2]u8                = [2]u8{memory, 0};
    val mem:    res[Id[Entry], Fail] = entry(o, Entry{space: ?space.MEMORIES}, neutral.ENTRY_TYPE, ?limits[0], 2);
    if (sel mem.err) { ret err[Fail].err{mem.err}; }
    val ms: err[Fail] = defined(o, MEMORY_NAME, ?symbol.INDEXED, mem.ok, neutral.MEMORY);
    if (sel ms.err) { ret ms; }
    val ex: err[Fail] = exported(o, MEMORY_EXPORT, MEMORY_NAME);
    if (sel ex.err) { ret ex; }

    val base: i64       = c.base::i64;
    val sp:   err[Fail] = global(c.inputs.a, o, STACK_NAME, valtype, 1, op.ok, base, opt[u32].none{});
    if (sel sp.err) { ret sp; }
    val mb: err[Fail] = global(c.inputs.a, o, BASE_NAME, valtype, 0, op.ok, base, opt[u32].none{});
    if (sel mb.err) { ret mb; }
    ret global(c.inputs.a, o, TLS_NAME, valtype, 0, op.ok, 0, opt[u32].some{neutral.TLS_BASE});
}

# add to `o` the entry `e` and a fact of `key` about it holding the `n` bytes
# at `bytes`
fun entry(o: *Object, e: Entry, key: u32, bytes: *u8, n: usize) res[Id[Entry], Fail] {
    val id: res[Id[Entry], Fail] = object.add_entry(o, e);
    if (sel id.err) { ret id; }
    val held: res[Contents, Fail] = object.own(o, bytes, n);
    if (sel held.err) { ret res[Id[Entry], Fail].err{held.err}; }
    val f: res[Id[Fact], Fail] = object.add_fact(o, Fact{format: ?format.WASM, key: key, value: id.ok.index::u64, data: held.ok});
    if (sel f.err) { ret res[Id[Entry], Fail].err{f.err}; }
    ret id;
}

# add to `o` a hidden symbol named `name` of kind `kind` defined at the entry
# `e`, and the fact of `key` that names the entry to the image writer
fun defined(o: *Object, name: str, kind: *symbol.Kind, e: Id[Entry], key: u32) err[Fail] {
    val nm: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel nm.err) { ret err[Fail].err{nm.err}; }
    val s: res[Id[object.Symbol], Fail] = object.add_symbol(o, object.Symbol{name: nm.ok, binding: ?symbol.GLOBAL, visibility: ?symbol.HIDDEN, kind: kind, def: Definition.entry{e}});
    if (sel s.err) { ret err[Fail].err{s.err}; }
    val f: res[Id[Fact], Fail] = object.add_fact(o, Fact{format: ?format.WASM, key: key, value: e.index::u64, data: Contents.zero{0}});
    if (sel f.err) { ret err[Fail].err{f.err}; }
    ret err[Fail].ok{};
}

# add to `o` a directive that exports the symbol `name` as `as`
fun exported(o: *Object, as: str, name: str) err[Fail] {
    val text: res[Id[Name], Fail] = object.name_str(o, as);
    if (sel text.err) { ret err[Fail].err{text.err}; }
    val sym: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel sym.err) { ret err[Fail].err{sym.err}; }
    val d: res[Id[object.Directive], Fail] = object.add_directive(o, object.Directive{kind: ?directive.EXPORT, text: text.ok, symbol: opt[Id[Name]].some{sym.ok}});
    if (sel d.err) { ret err[Fail].err{d.err}; }
    ret err[Fail].ok{};
}

# add to `o` a global named `name` of type `valtype`, mutable when `mutable`
# is one, starting at the constant `value` written by the opcode `op`, and
# the fact of `key` that names it to the image writer where there is one
fun global(a: *A.Allocator, o: *Object, name: str, valtype: u8, mutable: u8, op: u8, value: i64, key: opt[u32]) err[Fail] {
    var out: Sink      = sink.make(a, LITTLE);
    var e:   err[Fail] = sink.u8(?out, valtype);
    e = fail.kept(e, sink.u8(?out, mutable));
    e = fail.kept(e, sink.u8(?out, op));
    e = fail.kept(e, write.sleb(?out, value, leb128.signed_size(value)::u8));
    e = fail.kept(e, sink.u8(?out, tables.WASM_OPCODE_END.value::u8));
    var id: res[Id[Entry], Fail] = res[Id[Entry], Fail].err{fail.internal("the global was not written")};
    if (sel e.ok) { id = entry(o, Entry{space: ?space.GLOBALS}, neutral.ENTRY_TYPE, sink.data(?out), sink.len(?out)); }
    val gone: err[Fail] = sink.release(?out);
    if (sel e.err)    { ret e; }
    if (sel id.err)   { ret err[Fail].err{id.err}; }
    if (sel gone.err) { ret gone; }
    val nm: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel nm.err) { ret err[Fail].err{nm.err}; }
    val s: res[Id[object.Symbol], Fail] = object.add_symbol(o, object.Symbol{name: nm.ok, binding: ?symbol.GLOBAL, visibility: ?symbol.HIDDEN, kind: ?symbol.INDEXED, def: Definition.entry{id.ok}});
    if (sel s.err)    { ret err[Fail].err{s.err}; }
    if (sel key.none) { ret err[Fail].ok{}; }
    val f: res[Id[Fact], Fail] = object.add_fact(o, Fact{format: ?format.WASM, key: key.some, value: id.ok.index::u64, data: Contents.zero{0}});
    if (sel f.err) { ret err[Fail].err{f.err}; }
    ret err[Fail].ok{};
}
