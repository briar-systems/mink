# the wasm model, every byte of a WebAssembly module
#
# a module is a magic, a version and a run of sections, each an id byte, a
# LEB128 size and a payload. every LEB128 number the model decodes keeps the
# width it was written in, as producers pad the sizes and immediates a linker
# patches to five bytes, so a writer gives back every input byte for byte. a
# vector's items lie in one flat table of the module, named by a run: where
# the first lies, how many, and the width of the count as written.
#
# the core sections decode into typed records. the custom sections the tool
# conventions define, linking, reloc.*, name, producers, target_features and
# dylink.0, decode too. a function body, a constant expression and a data
# segment's bytes are instruction streams, held as the bytes they are. a
# section or a subsection whose contents do not parse is held raw, and a
# custom section no convention names is held raw as opaque.
#
# the index spaces follow the specification: the imports of a kind come
# first, then the module's own definitions of that kind.
#
# the model is mink's own. a producer hands mink a neutral object, stating
# what it holds of a wasm module through mink.format.wasm.fact, and the
# registry reads, writes and dumps a file through the model.

use std.collections.vector;
use std.collections.vector.Vector;
use std.encoding.leb128;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Raw;
use mink.base.store.Store;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.base.vectors;
use mink.catalog.arch;
use mink.catalog.arch.Stated;
use mink.catalog.format;
use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.format.wasm.tables;

pub val MAGIC_LEN:  usize = 4;
pub val HEADER_LEN: usize = 8;

pub val MAGIC: [4]u8 = [4]u8{0, 'a', 's', 'm'};

# the kinds of import, which number the index spaces
pub val KIND_COUNT: usize = 5;

# the element segment flags that say a kind byte, an element kind or a
# reference type, follows
pub val ELEM_DESC_MASK: u64 = tables.WASM_ELEM_SEGMENT_IS_PASSIVE.value | tables.WASM_ELEM_SEGMENT_HAS_TABLE_NUMBER.value;

# the width a producer gives a number, a count or a size it has no written
# form of, which the writer writes in its shortest form. a read never gives
# it, as a read keeps the width it saw, and a zeroed width is no width
pub val SHORTEST: u8 = 0xff;

# an unsigned LEB128 number as written: its value and the bytes it took
pub rec Leb {
    value: u64;
    width: u8;
}

# a signed LEB128 number as written
pub rec Sleb {
    value: i64;
    width: u8;
}

# a vector's items: where the first lies in its flat table, how many there
# are and the width of the count as written
pub rec Run {
    first: usize;
    count: usize;
    width: u8;
}

# a name: its bytes and the width of its length as written
pub rec Name {
    bytes: Held;
    width: u8;
}

# a constant expression as written, its end opcode included
pub rec Expr {
    bytes: Held;
}

# a heap type, what a reference type refers to
# ---
# abstract: an abstract heap type, as func, extern, any or none, by its byte
#           of the HEAP table
# index:    a type of the type section by its index, written as a signed
#           LEB128 of 33 bits that is not negative
pub tag Heap: u8 {
    abstract: u8;
    index:    Sleb;
}

# a reference type: whether it holds null and the heap type it refers to.
# `short` when it is written as the one byte of an abstract heap type, which
# names the nullable reference to it, and the prefix of its nullability then
# its heap type otherwise
pub rec RefType {
    nullable: bool;
    short:    bool;
    heap:     Heap;
}

# a value type: a number or vector type by its byte of the NUMBER table, or
# a reference type
pub tag ValType: u8 {
    number:    u8;
    reference: RefType;
}

# whether a reference type names a type of the type section by its index
pub fun names_type(r: *RefType) bool {
    ret sel r.heap.index;
}

# whether a value type names a type of the type section by its index
pub fun value_names_type(v: *ValType) bool {
    if (sel v.reference) { ret names_type(?v.reference); }
    ret false;
}

# a function type: its form byte, its parameters and its results, value
# types of the module's valtypes table
pub rec FuncType {
    form:    u8;
    params:  Run;
    results: Run;
}

# how a field of a struct or an array stores its value
# ---
# value:  a value type
# packed: the byte of a packed storage type
pub tag Storage: u8 {
    value:  ValType;
    packed: u8;
}

# a field of a struct or an array, and its mutability byte
pub rec Field {
    storage: Storage;
    mutable: u8;
}

# what a type of the type section describes
# ---
# function:  a function
# structure: a struct, its fields those of the module's fields table
# array:     an array of the field
pub tag Composite: u8 {
    function:  FuncType;
    structure: Run;
    array:     Field;
}

# a type of the type section. `prefix` is the byte that opens a declared
# subtype, its supertypes then entries of the indices table, and zero for a
# type written as its bare composite type
pub rec SubType {
    prefix:    u8;
    supers:    Run;
    composite: Composite;
}

# one item of the type section: a type, or a recursion group of the types of
# `members`, which each take an index of the type space. a group is opened by
# its prefix, a single type by none
pub rec RecType {
    grouped: bool;
    members: Run;
}

# the limits of a table or a memory. `max` is written when the flags say so,
# and `page` when they say the page size is
pub rec Limits {
    flags: u8;
    min:   Leb;
    max:   Leb;
    page:  Leb;
}

pub rec TableType {
    elem:   RefType;
    limits: Limits;
}

# a table the module defines: its type, and the expression every element
# starts as when it is written with one
pub rec TableDef {
    type: TableType;
    init: opt[Expr];
}

pub rec GlobalType {
    valtype: ValType;
    mutable: u8;
}

pub rec TagType {
    attribute: u8;
    type:      Leb;
}

# what an import brings in, by its kind
pub tag Desc: u8 {
    function: Leb;
    table:    TableType;
    memory:   Limits;
    global:   GlobalType;
    tag_type: TagType;
}

pub rec Import {
    module: Name;
    field:  Name;
    kind:   u8;
    desc:   Desc;
}

pub rec Global {
    type: GlobalType;
    init: Expr;
}

pub rec Export {
    name:  Name;
    kind:  u8;
    index: Leb;
}

# the items of an element segment: function indices of the indices table, or
# expressions of the exprs table
pub tag Items: u8 {
    indices: Run;
    exprs:   Run;
}

# an element segment. the table index is written when the flags name one,
# the offset when the segment is active, and when the flags are not zero the
# element kind byte of a segment of indices or the reference type of a
# segment of expressions
pub rec Element {
    flags:  Leb;
    table:  Leb;
    offset: Expr;
    kind:   u8;
    type:   RefType;
    items:  Items;
}

# a function body as written, locals and code, and the width of its size
pub rec Function {
    width: u8;
    body:  Held;
}

# a data segment. the memory index is written when the flags name one, the
# offset when the segment is active. `width` is the width of the data length
pub rec Segment {
    flags:  Leb;
    memory: Leb;
    offset: Expr;
    width:  u8;
    data:   Held;
}

pub rec Tag {
    attribute: u8;
    type:      Leb;
}

# linking section, WASM_SEGMENT_INFO
pub rec SegmentInfo {
    name:  Name;
    align: Leb;
    flags: Leb;
}

# linking section, WASM_INIT_FUNCS
pub rec InitFunc {
    priority: Leb;
    symbol:   Leb;
}

pub rec ComdatItem {
    kind:  u8;
    index: Leb;
}

# linking section, WASM_COMDAT_INFO. the items lie in the comdat_items table
pub rec Comdat {
    name:  Name;
    flags: Leb;
    items: Run;
}

# linking section, WASM_SYMBOL_TABLE. `index` is the element index of a
# function, global, tag or table symbol and the section index of a section
# symbol. a name is written for a data symbol, a defined symbol and a symbol
# with an explicit name. the segment, offset and size are written for a
# defined data symbol
pub rec Symbol {
    kind:    u8;
    flags:   Leb;
    index:   Leb;
    named:   bool;
    name:    Name;
    segment: Leb;
    offset:  Leb;
    size:    Leb;
}

# what a linking subsection holds
pub tag Subbody: u8 {
    raw:      Raw;
    segments: Run;
    inits:    Run;
    comdats:  Run;
    symbols:  Run;
}

# a linking subsection: its id and the width of its size
pub rec Subsection {
    id:    u8;
    width: u8;
    body:  Subbody;
}

pub rec Linking {
    version:     Leb;
    subsections: Run;
}

# a relocation record. the addend is written when the type's row says so
pub rec Reloc {
    type:   u8;
    offset: Leb;
    index:  Leb;
    addend: Sleb;
}

# a reloc.* section: the section it patches and its records
pub rec Relocs {
    section: Leb;
    entries: Run;
}

# name section, one entry of a name map
pub rec NameEntry {
    index: Leb;
    name:  Name;
}

# name section, one entry of an indirect name map, whose names lie in the
# name_entries table
pub rec IndirectEntry {
    index: Leb;
    names: Run;
}

# what a name subsection holds: the module name, a name map or an indirect
# name map
pub tag NameBody: u8 {
    raw:      Raw;
    module:   Name;
    map:      Run;
    indirect: Run;
}

pub rec NameSub {
    id:    u8;
    width: u8;
    body:  NameBody;
}

# producers section, one field and its values of the versioned table
pub rec Producer {
    name:   Name;
    values: Run;
}

pub rec Versioned {
    name:    Name;
    version: Name;
}

# target_features section, one feature
pub rec Feature {
    prefix: u8;
    name:   Name;
}

# dylink.0 section, WASM_DYLINK_MEM_INFO
pub rec MemInfo {
    memory_size:  Leb;
    memory_align: Leb;
    table_size:   Leb;
    table_align:  Leb;
}

pub rec ExportInfo {
    name:  Name;
    flags: Leb;
}

pub rec ImportInfo {
    module: Name;
    field:  Name;
    flags:  Leb;
}

# what a dylink.0 subsection holds. needed and paths are names of the names
# table
pub tag DylinkBody: u8 {
    raw:     Raw;
    mem:     MemInfo;
    needed:  Run;
    exports: Run;
    imports: Run;
    paths:   Run;
}

pub rec DylinkSub {
    id:    u8;
    width: u8;
    body:  DylinkBody;
}

# what a section's payload holds, after a custom section's name
# ---
# raw:       bytes no codec decodes, and why
# types:     the items of the type section
# imports:   imports
# functions: the type index of each defined function
# tables:    the tables the module defines
# memories:  memory limits
# globals:   globals
# exports:   exports
# start:     the start function index
# elements:  element segments
# code:      function bodies
# data:      data segments
# datacount: the declared data segment count
# tags:      tags
# linking:   the linking section
# relocs:    a reloc.* section
# names:     the name section's subsections
# producers: the producers section's fields
# features:  the target_features section's features
# dylink:    the dylink.0 section's subsections
pub tag Body: u8 {
    raw:       Raw;
    types:     Run;
    imports:   Run;
    functions: Run;
    tables:    Run;
    memories:  Run;
    globals:   Run;
    exports:   Run;
    start:     Leb;
    elements:  Run;
    code:      Run;
    data:      Run;
    datacount: Leb;
    tags:      Run;
    linking:   Linking;
    relocs:    Relocs;
    names:     Run;
    producers: Run;
    features:  Run;
    dylink:    Run;
}

# one section
# ---
# id:      the section id
# at:      the file offset of the id byte
# payload: the file offset of the payload
# size:    the payload size as written, which the writer recomputes at the
#          same width
# name:    the name, of a custom section
# body:    what the payload holds
pub rec Section {
    id:      u8;
    at:      u64;
    payload: u64;
    size:    Leb;
    name:    Name;
    body:    Body;
}

# a whole module
# ---
# a:        the allocator every table lives in
# version:  the version field
# sections: the sections in file order
# store:    the bytes the model owns
# by_kind:  the imports grouped by kind, each group a run of ids
# kinds:    the group of each kind
# linking:  the linking section, when there is one
# dylink:   the dylink.0 section, when there is one
# symtab:   the symbol table of the linking section, when there is one
# seginfo:  the segment info of the linking section, when there is one
# the rest are the flat tables the runs name
pub rec Module {
    a:             *A.Allocator;
    version:       u32;
    sections:      Table[Section];
    store:         Store;
    valtypes:      Vector[ValType];
    types:         Vector[SubType];
    recs:          Vector[RecType];
    fields:        Vector[Field];
    imports:       Table[Import];
    functions:     Vector[Leb];
    tables:        Vector[TableDef];
    memories:      Vector[Limits];
    globals:       Vector[Global];
    exports:       Vector[Export];
    elements:      Vector[Element];
    indices:       Vector[Leb];
    exprs:         Vector[Expr];
    code:          Vector[Function];
    data:          Vector[Segment];
    tags:          Vector[Tag];
    subsections:   Vector[Subsection];
    segment_infos: Vector[SegmentInfo];
    inits:         Vector[InitFunc];
    comdats:       Vector[Comdat];
    comdat_items:  Vector[ComdatItem];
    symbols:       Table[Symbol];
    relocs:        Vector[Reloc];
    name_subs:     Vector[NameSub];
    name_entries:  Vector[NameEntry];
    indirects:     Vector[IndirectEntry];
    producers:     Vector[Producer];
    versioned:     Vector[Versioned];
    features:      Vector[Feature];
    dylink_subs:   Vector[DylinkSub];
    names:         Vector[Name];
    export_infos:  Vector[ExportInfo];
    import_infos:  Vector[ImportInfo];
    by_kind:       Vector[Id[Import]];
    kinds:         [KIND_COUNT]Run;
    linking:       opt[Id[Section]];
    dylink:        opt[Id[Section]];
    symtab:        opt[Run];
    seginfo:       opt[Run];
}

pub fun make(a: *A.Allocator) Module {
    ret Module{
        a:             a,
        sections:      table.make[Section](a),
        store:         store.make(a),
        valtypes:      vector.init[ValType](a),
        types:         vector.init[SubType](a),
        recs:          vector.init[RecType](a),
        fields:        vector.init[Field](a),
        imports:       table.make[Import](a),
        functions:     vector.init[Leb](a),
        tables:        vector.init[TableDef](a),
        memories:      vector.init[Limits](a),
        globals:       vector.init[Global](a),
        exports:       vector.init[Export](a),
        elements:      vector.init[Element](a),
        indices:       vector.init[Leb](a),
        exprs:         vector.init[Expr](a),
        code:          vector.init[Function](a),
        data:          vector.init[Segment](a),
        tags:          vector.init[Tag](a),
        subsections:   vector.init[Subsection](a),
        segment_infos: vector.init[SegmentInfo](a),
        inits:         vector.init[InitFunc](a),
        comdats:       vector.init[Comdat](a),
        comdat_items:  vector.init[ComdatItem](a),
        symbols:       table.make[Symbol](a),
        relocs:        vector.init[Reloc](a),
        name_subs:     vector.init[NameSub](a),
        name_entries:  vector.init[NameEntry](a),
        indirects:     vector.init[IndirectEntry](a),
        producers:     vector.init[Producer](a),
        versioned:     vector.init[Versioned](a),
        features:      vector.init[Feature](a),
        dylink_subs:   vector.init[DylinkSub](a),
        names:         vector.init[Name](a),
        export_infos:  vector.init[ExportInfo](a),
        import_infos:  vector.init[ImportInfo](a),
        by_kind:       vector.init[Id[Import]](a),
    };
}

# give everything the module owns back, reporting the first refusal
pub fun release(m: *Module) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    first = fail.kept(first, table.release[Section](?m.sections));
    first = fail.kept(first, vectors.release[ValType](?m.valtypes));
    first = fail.kept(first, vectors.release[SubType](?m.types));
    first = fail.kept(first, vectors.release[RecType](?m.recs));
    first = fail.kept(first, vectors.release[Field](?m.fields));
    first = fail.kept(first, table.release[Import](?m.imports));
    first = fail.kept(first, vectors.release[Leb](?m.functions));
    first = fail.kept(first, vectors.release[TableDef](?m.tables));
    first = fail.kept(first, vectors.release[Limits](?m.memories));
    first = fail.kept(first, vectors.release[Global](?m.globals));
    first = fail.kept(first, vectors.release[Export](?m.exports));
    first = fail.kept(first, vectors.release[Element](?m.elements));
    first = fail.kept(first, vectors.release[Leb](?m.indices));
    first = fail.kept(first, vectors.release[Expr](?m.exprs));
    first = fail.kept(first, vectors.release[Function](?m.code));
    first = fail.kept(first, vectors.release[Segment](?m.data));
    first = fail.kept(first, vectors.release[Tag](?m.tags));
    first = fail.kept(first, vectors.release[Subsection](?m.subsections));
    first = fail.kept(first, vectors.release[SegmentInfo](?m.segment_infos));
    first = fail.kept(first, vectors.release[InitFunc](?m.inits));
    first = fail.kept(first, vectors.release[Comdat](?m.comdats));
    first = fail.kept(first, vectors.release[ComdatItem](?m.comdat_items));
    first = fail.kept(first, table.release[Symbol](?m.symbols));
    first = fail.kept(first, vectors.release[Reloc](?m.relocs));
    first = fail.kept(first, vectors.release[NameSub](?m.name_subs));
    first = fail.kept(first, vectors.release[NameEntry](?m.name_entries));
    first = fail.kept(first, vectors.release[IndirectEntry](?m.indirects));
    first = fail.kept(first, vectors.release[Producer](?m.producers));
    first = fail.kept(first, vectors.release[Versioned](?m.versioned));
    first = fail.kept(first, vectors.release[Feature](?m.features));
    first = fail.kept(first, vectors.release[DylinkSub](?m.dylink_subs));
    first = fail.kept(first, vectors.release[Name](?m.names));
    first = fail.kept(first, vectors.release[ExportInfo](?m.export_infos));
    first = fail.kept(first, vectors.release[ImportInfo](?m.import_infos));
    first = fail.kept(first, vectors.release[Id[Import]](?m.by_kind));
    first = fail.kept(first, store.release(?m.store));
    ret first;
}

# the bytes `h` holds
pub fun bytes(m: *Module, h: *Held) Bytes {
    ret store.bytes(?m.store, h);
}

# the bytes of a name
pub fun name_bytes(m: *Module, n: *Name) Bytes {
    ret bytes(m, ?n.bytes);
}

pub fun section_at(m: *Module, id: Id[Section]) *Section {
    ret table.at[Section](?m.sections, id);
}

# whether a section is a custom section, so its payload starts with a name
pub fun is_custom(s: *Section) bool {
    ret s.id == tables.WASM_SEC_CUSTOM.value::u8;
}

# the rank of a section id in the order the specification fixes, which the
# custom section stands outside of, none for an id the specification has not
# assigned
pub fun rank(id: u8) opt[u8] {
    var i: usize = 0;
    for (i < ORDER_COUNT) {
        if (ORDER[i] == id) { ret opt[u8].some{i::u8}; }
        i = i + 1;
    }
    ret opt[u8].none{};
}

# the section ids in the order a module lays them out
val ORDER_COUNT: usize           = 13;
val ORDER:       [ORDER_COUNT]u8 = [ORDER_COUNT]u8{1, 2, 3, 4, 5, 13, 6, 7, 8, 9, 12, 10, 11};

# index the imports by kind, so each kind's imports answer by position. a
# module whose imports changed calls this again. an import of a kind the
# specification does not define is refused
pub fun index_imports(m: *Module) err[Fail] {
    vector.clear[Id[Import]](?m.by_kind);
    val n: usize = table.count[Import](?m.imports);
    var k: usize = 0;
    for (k < KIND_COUNT) {
        m.kinds[k] = Run{first: 0, count: 0, width: 0};
        k          = k + 1;
    }
    var i: usize = 0;
    for (i < n) {
        val imp: *Import = table.at[Import](?m.imports, table.nth[Import](i));
        if (imp.kind::usize >= KIND_COUNT) {
            ret err[Fail].err{fail.malformed_at("an import has a kind the specification does not define", "import", i::u64, imp.kind::i128)};
        }
        m.kinds[imp.kind::usize].count = m.kinds[imp.kind::usize].count + 1;
        i                              = i + 1;
    }
    var at: usize = 0;
    k = 0;
    for (k < KIND_COUNT) {
        m.kinds[k].first = at;
        at               = at + m.kinds[k].count;
        k                = k + 1;
    }
    val grown: err[Fail] = vectors.grow[Id[Import]](?m.by_kind, n);
    if (sel grown.err) { ret err[Fail].err{grown.err}; }
    var filled: [KIND_COUNT]usize;
    i = 0;
    for (i < n) {
        val imp:  *Import = table.at[Import](?m.imports, table.nth[Import](i));
        val kind: usize   = imp.kind::usize;
        val slot: usize   = m.kinds[kind].first + filled[kind];
        m.by_kind.data[slot] = table.nth[Import](i);
        filled[kind]         = filled[kind] + 1;
        i                    = i + 1;
    }
    ret err[Fail].ok{};
}

# the bytes a LEB128 number `v` takes written at `width`, its shortest form
# for SHORTEST
pub fun width_of(width: u8, v: u64) u64 {
    if (width == SHORTEST) { ret leb128.unsigned_size(v)::u64; }
    ret width::u64;
}

# where each function body of the code section run `r` starts in the
# section's payload, past the function count and the body's own size, pushed
# to `out` in order: the one statement of where a body lies in the code
# section, which the writer lays out the same way
pub fun body_starts(m: *Module, r: *Run, out: *Vector[u64]) err[Fail] {
    var at: u64   = width_of(r.width, r.count::u64);
    var i:  usize = 0;
    for (i < r.count) {
        val f:   *Function = ?m.code.data[r.first + i];
        val len: u64       = bytes(m, ?f.body).len::u64;
        at = at + width_of(f.width, len);
        val p: err[Fail] = vectors.push[u64](out, at);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        at = at + len;
        i  = i + 1;
    }
    ret err[Fail].ok{};
}

# note what the section `id` is to the module: the linking section with its
# symbol table and segment info, or the dylink.0 section. whoever adds such
# a section calls this, so the module answers its kind and its tables
pub fun note_section(m: *Module, id: Id[Section]) {
    val s: *Section = section_at(m, id);
    if (sel s.body.linking) {
        m.linking = opt[Id[Section]].some{id};
        var i: usize = 0;
        for (i < s.body.linking.subsections.count) {
            val sub: *Subsection = ?m.subsections.data[s.body.linking.subsections.first + i];
            if (sel sub.body.symbols)  { m.symtab = opt[Run].some{sub.body.symbols}; }
            if (sel sub.body.segments) { m.seginfo = opt[Run].some{sub.body.segments}; }
            i = i + 1;
        }
    }
    if (sel s.body.dylink) { m.dylink = opt[Id[Section]].some{id}; }
}

# how many imports of `kind` the module has, zero for a kind it does not define
pub fun imported(m: *Module, kind: u8) usize {
    if (kind::usize >= KIND_COUNT) { ret 0; }
    ret m.kinds[kind::usize].count;
}

# the `index`th import of `kind`, none past the imports of that kind
pub fun import_of(m: *Module, kind: u8, index: u64) opt[*Import] {
    if (index >= imported(m, kind)::u64) { ret opt[*Import].none{}; }
    val id: Id[Import] = m.by_kind.data[m.kinds[kind::usize].first + index::usize];
    ret opt[*Import].some{table.at[Import](?m.imports, id)};
}

# how many entries of `kind` the module defines itself
pub fun defined(m: *Module, kind: u8) usize {
    if (kind == tables.WASM_EXTERNAL_FUNCTION.value::u8) { ret vector.length[Leb](?m.functions); }
    if (kind == tables.WASM_EXTERNAL_TABLE.value::u8)    { ret vector.length[TableDef](?m.tables); }
    if (kind == tables.WASM_EXTERNAL_MEMORY.value::u8)   { ret vector.length[Limits](?m.memories); }
    if (kind == tables.WASM_EXTERNAL_GLOBAL.value::u8)   { ret vector.length[Global](?m.globals); }
    if (kind == tables.WASM_EXTERNAL_TAG.value::u8)      { ret vector.length[Tag](?m.tags); }
    ret 0;
}

# whether the module addresses a 64-bit memory: any memory, imported or
# defined, whose limits carry the 64-bit flag
pub fun wide(m: *Module) bool {
    val flag: u8    = tables.WASM_LIMITS_FLAG_IS_64.value::u8;
    var i:    usize = 0;
    for (i < table.count[Import](?m.imports)) {
        val imp: *Import = table.at[Import](?m.imports, table.nth[Import](i));
        if (sel imp.desc.memory && (imp.desc.memory.flags & flag) != 0) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < vector.length[Limits](?m.memories)) {
        if ((m.memories.data[i].flags & flag) != 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# what the module states in the field wasm codes an architecture by, the
# width of the addresses of its memories
pub fun stated(m: *Module) Stated {
    var s: Stated = Stated{format: ?format.WASM, count: 1};
    s.values[arch.WASM_INDEX::usize] = 32;
    if (wide(m)) { s.values[arch.WASM_INDEX::usize] = 64; }
    ret s;
}

# the kind of file the module is: an object when it carries a linking
# section, a shared module when it carries a dylink.0 section, a module
# otherwise
pub fun kind_of(m: *Module) res[*Kind, Fail] {
    if (sel m.linking.some) { ret res[*Kind, Fail].ok{?kind.RELOCATABLE}; }
    if (sel m.dylink.some)  { ret res[*Kind, Fail].ok{?kind.SHARED}; }
    ret res[*Kind, Fail].ok{?kind.MODULE};
}

# the section holding byte `offset` of the file, by the sections' offsets,
# none before the first
fun section_holding(m: *Module, offset: u64) opt[usize] {
    var lo: usize = 0;
    var hi: usize = table.count[Section](?m.sections);
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (table.at[Section](?m.sections, table.nth[Section](mid)).at <= offset) { lo = mid + 1; }
        or                                                                        { hi = mid; }
    }
    if (lo == 0) { ret opt[usize].none{}; }
    ret opt[usize].some{lo - 1};
}

# the record that holds byte `offset` of the module, a nil record when none
# does. the sections are in file order, so the one at or before the offset
# holds it when its payload reaches it
pub fun locate(m: *Module, offset: u64) Location {
    val at: Location = Location{offset: offset, placed: true};
    if (offset < HEADER_LEN::u64) {
        var out: Location = at;
        out.record = "module header";
        ret out;
    }
    val which: opt[usize] = section_holding(m, offset);
    if (sel which.none) { ret at; }
    val s:   *Section = table.at[Section](?m.sections, table.nth[Section](which.some));
    var out: Location = at;
    out.index   = which.some::u64;
    out.indexed = true;
    if (offset < s.payload) {
        out.record = "section header";
        ret out;
    }
    if (offset - s.payload >= s.size.value) { ret at; }
    if (is_custom(s) && offset - s.payload < s.name.width::u64 + name_bytes(m, ?s.name).len::u64) {
        out.record = "section name";
        ret out;
    }
    out.record = "section contents";
    ret out;
}

# whether a symbol of `kind` and `flags` carries a name: a data symbol
# always, a section symbol never, the rest when defined or named explicitly
pub fun symbol_named(kind: u8, flags: u64) bool {
    if (kind == tables.WASM_SYMBOL_TYPE_DATA.value::u8)        { ret true; }
    if (kind == tables.WASM_SYMBOL_TYPE_SECTION.value::u8)     { ret false; }
    if ((flags & tables.WASM_SYMBOL_UNDEFINED.value) == 0)     { ret true; }
    if ((flags & tables.WASM_SYMBOL_EXPLICIT_NAME.value) != 0) { ret true; }
    ret false;
}

# whether a symbol of `kind` and `flags` carries a segment, an offset and a
# size: a defined data symbol
pub fun symbol_placed(kind: u8, flags: u64) bool {
    ret kind == tables.WASM_SYMBOL_TYPE_DATA.value::u8 && (flags & tables.WASM_SYMBOL_UNDEFINED.value) == 0;
}

# whether a symbol of `kind` carries an element or section index: every kind
# but data
pub fun symbol_indexed(kind: u8) bool {
    ret kind != tables.WASM_SYMBOL_TYPE_DATA.value::u8;
}

# the kind of import a symbol of `kind` refers to, none for a data or section
# symbol
pub fun import_kind(kind: u8) opt[u8] {
    if (kind == tables.WASM_SYMBOL_TYPE_FUNCTION.value::u8) { ret opt[u8].some{tables.WASM_EXTERNAL_FUNCTION.value::u8}; }
    if (kind == tables.WASM_SYMBOL_TYPE_GLOBAL.value::u8)   { ret opt[u8].some{tables.WASM_EXTERNAL_GLOBAL.value::u8}; }
    if (kind == tables.WASM_SYMBOL_TYPE_TAG.value::u8)      { ret opt[u8].some{tables.WASM_EXTERNAL_TAG.value::u8}; }
    if (kind == tables.WASM_SYMBOL_TYPE_TABLE.value::u8)    { ret opt[u8].some{tables.WASM_EXTERNAL_TABLE.value::u8}; }
    ret opt[u8].none{};
}

# the name of a symbol: the one it carries, the import field of an undefined
# function, global, tag or table that carries none, or the name of the
# section a section symbol names, which is empty for a section without one.
# none when the index the symbol holds lies outside its space
pub fun symbol_name(m: *Module, s: *Symbol) opt[Bytes] {
    if (s.named) { ret opt[Bytes].some{name_bytes(m, ?s.name)}; }
    if (s.kind == tables.WASM_SYMBOL_TYPE_SECTION.value::u8) {
        if (s.index.value >= table.count[Section](?m.sections)::u64) { ret opt[Bytes].none{}; }
        val sec: *Section = table.at[Section](?m.sections, table.nth[Section](s.index.value::usize));
        ret opt[Bytes].some{name_bytes(m, ?sec.name)};
    }
    val kind: opt[u8] = import_kind(s.kind);
    if (sel kind.none) { ret opt[Bytes].none{}; }
    val imp: opt[*Import] = import_of(m, kind.some, s.index.value);
    if (sel imp.none) { ret opt[Bytes].none{}; }
    ret opt[Bytes].some{name_bytes(m, ?imp.some.field)};
}

# the counts of every flat table and the store, which `rewind` gives the
# module back to, so a decode that fails leaves no trace
pub rec Marks {
    counts: [TABLE_COUNT]usize;
    store:  usize;
}

val TABLE_COUNT: usize = 35;

pub fun marks(m: *Module) Marks {
    var k: Marks;
    k.store      = store.size(?m.store);
    k.counts[0]  = table.count[Section](?m.sections);
    k.counts[1]  = vector.length[ValType](?m.valtypes);
    k.counts[2]  = vector.length[SubType](?m.types);
    k.counts[33] = vector.length[RecType](?m.recs);
    k.counts[34] = vector.length[Field](?m.fields);
    k.counts[3]  = table.count[Import](?m.imports);
    k.counts[4]  = vector.length[Leb](?m.functions);
    k.counts[5]  = vector.length[TableDef](?m.tables);
    k.counts[6]  = vector.length[Limits](?m.memories);
    k.counts[7]  = vector.length[Global](?m.globals);
    k.counts[8]  = vector.length[Export](?m.exports);
    k.counts[9]  = vector.length[Element](?m.elements);
    k.counts[10] = vector.length[Leb](?m.indices);
    k.counts[11] = vector.length[Expr](?m.exprs);
    k.counts[12] = vector.length[Function](?m.code);
    k.counts[13] = vector.length[Segment](?m.data);
    k.counts[14] = vector.length[Tag](?m.tags);
    k.counts[15] = vector.length[Subsection](?m.subsections);
    k.counts[16] = vector.length[SegmentInfo](?m.segment_infos);
    k.counts[17] = vector.length[InitFunc](?m.inits);
    k.counts[18] = vector.length[Comdat](?m.comdats);
    k.counts[19] = vector.length[ComdatItem](?m.comdat_items);
    k.counts[20] = table.count[Symbol](?m.symbols);
    k.counts[21] = vector.length[Reloc](?m.relocs);
    k.counts[22] = vector.length[NameSub](?m.name_subs);
    k.counts[23] = vector.length[NameEntry](?m.name_entries);
    k.counts[24] = vector.length[IndirectEntry](?m.indirects);
    k.counts[25] = vector.length[Producer](?m.producers);
    k.counts[26] = vector.length[Versioned](?m.versioned);
    k.counts[27] = vector.length[Feature](?m.features);
    k.counts[28] = vector.length[DylinkSub](?m.dylink_subs);
    k.counts[29] = vector.length[Name](?m.names);
    k.counts[30] = vector.length[ExportInfo](?m.export_infos);
    k.counts[31] = vector.length[ImportInfo](?m.import_infos);
    k.counts[32] = vector.length[Id[Import]](?m.by_kind);
    ret k;
}

pub fun rewind(m: *Module, k: *Marks) {
    store.truncate(?m.store, k.store);
    table.truncate[Section](?m.sections, k.counts[0]);
    vectors.truncate[ValType](?m.valtypes, k.counts[1]);
    vectors.truncate[SubType](?m.types, k.counts[2]);
    vectors.truncate[RecType](?m.recs, k.counts[33]);
    vectors.truncate[Field](?m.fields, k.counts[34]);
    table.truncate[Import](?m.imports, k.counts[3]);
    vectors.truncate[Leb](?m.functions, k.counts[4]);
    vectors.truncate[TableDef](?m.tables, k.counts[5]);
    vectors.truncate[Limits](?m.memories, k.counts[6]);
    vectors.truncate[Global](?m.globals, k.counts[7]);
    vectors.truncate[Export](?m.exports, k.counts[8]);
    vectors.truncate[Element](?m.elements, k.counts[9]);
    vectors.truncate[Leb](?m.indices, k.counts[10]);
    vectors.truncate[Expr](?m.exprs, k.counts[11]);
    vectors.truncate[Function](?m.code, k.counts[12]);
    vectors.truncate[Segment](?m.data, k.counts[13]);
    vectors.truncate[Tag](?m.tags, k.counts[14]);
    vectors.truncate[Subsection](?m.subsections, k.counts[15]);
    vectors.truncate[SegmentInfo](?m.segment_infos, k.counts[16]);
    vectors.truncate[InitFunc](?m.inits, k.counts[17]);
    vectors.truncate[Comdat](?m.comdats, k.counts[18]);
    vectors.truncate[ComdatItem](?m.comdat_items, k.counts[19]);
    table.truncate[Symbol](?m.symbols, k.counts[20]);
    vectors.truncate[Reloc](?m.relocs, k.counts[21]);
    vectors.truncate[NameSub](?m.name_subs, k.counts[22]);
    vectors.truncate[NameEntry](?m.name_entries, k.counts[23]);
    vectors.truncate[IndirectEntry](?m.indirects, k.counts[24]);
    vectors.truncate[Producer](?m.producers, k.counts[25]);
    vectors.truncate[Versioned](?m.versioned, k.counts[26]);
    vectors.truncate[Feature](?m.features, k.counts[27]);
    vectors.truncate[DylinkSub](?m.dylink_subs, k.counts[28]);
    vectors.truncate[Name](?m.names, k.counts[29]);
    vectors.truncate[ExportInfo](?m.export_infos, k.counts[30]);
    vectors.truncate[ImportInfo](?m.import_infos, k.counts[31]);
    vectors.truncate[Id[Import]](?m.by_kind, k.counts[32]);
}
