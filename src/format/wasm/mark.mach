# where a wasm object holds the mink note
#
# the note is a custom section `mink.ct` whose bytes are the payload
# lower.mark encodes, nothing ahead of them, its fields four bytes little
# endian. each field is anchored by a record of the section's `reloc.mink.ct`
# section from a local symbol only the note names, of the kind the tool
# conventions' Linking document gives what the field lies in: a function
# offset record from a function symbol for a place in a function body, its
# addend the offset in the body, and a memory address record from a data
# symbol at the start of a segment for a place in a segment, its addend the
# offset in the segment. the fields are four bytes on wasm32 and wasm64
# alike: the section offset and function offset records the convention
# defines at 32 bits bound them, and a memory address record of 32 bits names
# the segment and offset its field lies at whatever the address. the section
# is no neutral section: from lowers the object's constant-time ranges into
# it and to decodes them from it. it carries the sections the link drops too,
# which wasm has no flag for, each by a field at its start: a function body
# or segment anchored as a range is, a custom section by a section offset
# record from a section symbol of its own, as the document gives section
# symbols to custom sections alone. a linker that merges custom sections of
# one name concatenates their payloads, and each is read by the length its
# head states. a file without one carries no constant-time code and no
# section the link drops.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;

use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.lower.lowered;
use mink.lower.lowered.Added;
use mink.lower.lowered.Lowered;
use mink.lower.mark;
use mink.model.object.CtRange;
use mink.model.object.Object;
use mink.model.section;

# the name of the custom section that holds the note
pub val SECTION: str = "mink.ct";

# the width of the note's fields
pub val WIDTH: u8 = 4;

# whether a custom section named `name` holds the note
pub fun holds(name: Bytes) bool {
    ret store.same_bytes(name, Bytes{data: SECTION::*u8, len: str_len(SECTION)});
}

# add to `low` the note section of `o`'s constant-time ranges and of the
# sections the link drops, which wasm has no flag for, adding nothing for an
# object with neither. a refusal leaves `low` as it was
pub fun lower(o: *Object, low: *Lowered) err[Fail] {
    if (table.count[CtRange](?o.ct) == 0 && mark.dropped(o, true) == 0) { ret err[Fail].ok{}; }
    val m:   lowered.Mark = lowered.mark(low);
    var out: Sink         = sink.make(o.a, LITTLE);
    val w:   err[Fail]    = mark.write(o, WIDTH, ?out, low, lowered.next_section(low), true);
    if (sel w.err) {
        val dropped: err[Fail] = sink.release(?out);
        val back:    err[Fail] = lowered.rollback(low, m);
        ret w;
    }
    val added: res[Id[Added], Fail] = lowered.add_section(low, Added{name: SECTION, kind: ?section.METADATA, flags: 0, align: 1, disposition: ?section.ROOT, bytes: out});
    if (sel added.err) {
        val back: err[Fail] = lowered.rollback(low, m);
        ret err[Fail].err{added.err};
    }
    ret err[Fail].ok{};
}
