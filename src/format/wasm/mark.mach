# where a wasm object holds the mink note
#
# the note is a custom section `mink.ct` whose bytes are the payload
# lower.mark encodes, nothing ahead of them, its fields four bytes little
# endian. each field is anchored by a section offset record of the
# section's `reloc.mink.ct` section, made from a section symbol of the code
# or the data section with the field's offset in that section's payload as
# its addend, so the function or segment a range names comes from where the
# offset falls. the fields are four bytes on wasm32 and wasm64 alike: a
# section's payload is bounded by its 32-bit size, and the convention
# defines the section offset relocation at 32 bits only. the section is no
# neutral section: from lowers the object's constant-time ranges into it and
# to decodes them from it. a linker that merges custom sections of one name
# concatenates their payloads, and each is read by the length its head
# states. a file without one carries no constant-time code.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.lower.lowered;
use mink.lower.lowered.Added;
use mink.lower.lowered.Lowered;
use mink.lower.mark;
use mink.model.object.CtRange;
use mink.model.object.Object;
use mink.model.section;

# the name of the custom section that holds the note
pub val SECTION: str = "mink.ct";

# the width of the note's fields
pub val WIDTH: u8 = 4;

# whether a custom section named `name` holds the note
pub fun holds(name: Bytes) bool {
    ret store.same_bytes(name, Bytes{data: SECTION::*u8, len: str_len(SECTION)});
}

# add to `low` the note section of `o`'s constant-time ranges, adding
# nothing for an object with none. a refusal leaves `low` as it was
pub fun lower(o: *Object, low: *Lowered) err[Fail] {
    if (table.count[CtRange](?o.ct) == 0) { ret err[Fail].ok{}; }
    val m:   lowered.Mark = lowered.mark(low);
    var out: Sink         = sink.make(o.ct.a, LITTLE);
    val w:   err[Fail]    = mark.write(o, WIDTH, ?out, low, lowered.next_section(low));
    if (sel w.err) {
        val dropped: err[Fail] = sink.release(?out);
        val back:    err[Fail] = lowered.rollback(low, m);
        ret w;
    }
    val added: res[Id[Added], Fail] = lowered.add_section(low, Added{name: SECTION, kind: ?section.METADATA, flags: 0, align: 1, disposition: ?section.ROOT, bytes: out});
    if (sel added.err) {
        val back: err[Fail] = lowered.rollback(low, m);
        ret err[Fail].err{added.err};
    }
    ret err[Fail].ok{};
}
