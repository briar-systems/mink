# a small wasm object the tests read, written byte by byte
#
# the object is what clang writes for one function calling an import and
# reading a data symbol, cut down: a type, two imports, a function, a data
# count, a function body, a data segment, a linking section with a symbol
# table and segment info, a reloc.CODE section, a producers section, a
# target_features section and a custom section no convention names. the
# section sizes and the symbol table's size are padded to five bytes, as
# clang pads them, so a round trip shows the widths are kept.
#
# the module is what a link writes for one exported function and a memory
# holding one segment, cut down: a type, a function, a memory, two exports, a
# function body, a data segment and a name section naming the function, with
# no linking section.

use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.wasm.model;
use mink.format.wasm.tables;
use mink.format.wasm.write;

# the width clang pads a section size to
pub val PADDED: u8 = 5;

# the position of the code section among the fixture's sections
pub val CODE_SECTION: u64 = 4;

# the fixture object into `out`
pub fun object(out: *Sink) err[Fail] {
    val a: *A.Allocator = out.bytes.a;
    var e: err[Fail]    = sink.bytes(out, ?model.MAGIC[0], model.MAGIC_LEN);
    e = fail.kept(e, sink.u32(out, tables.VERSION::u32));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_TYPE.value::u8, nil, types));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_IMPORT.value::u8, nil, imports));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_FUNCTION.value::u8, nil, functions));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_DATACOUNT.value::u8, nil, datacount));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_CODE.value::u8, nil, code));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_DATA.value::u8, nil, data));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_CUSTOM.value::u8, "linking", linking));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_CUSTOM.value::u8, "reloc.CODE", relocs));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_CUSTOM.value::u8, "producers", producers));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_CUSTOM.value::u8, "target_features", features));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_CUSTOM.value::u8, "foo", opaque));
    ret e;
}

# the fixture module into `out`
pub fun module(out: *Sink) err[Fail] {
    val a: *A.Allocator = out.bytes.a;
    var e: err[Fail]    = sink.bytes(out, ?model.MAGIC[0], model.MAGIC_LEN);
    e = fail.kept(e, sink.u32(out, tables.VERSION::u32));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_TYPE.value::u8, nil, types));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_FUNCTION.value::u8, nil, functions));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_MEMORY.value::u8, nil, memories));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_EXPORT.value::u8, nil, exports));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_CODE.value::u8, nil, module_code));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_DATA.value::u8, nil, data));
    e = fail.kept(e, section(a, out, tables.WASM_SEC_CUSTOM.value::u8, "name", names));
    ret e;
}

# one section: its id, its payload size padded, its name when custom, then
# the payload `fill` writes
pub fun section(a: *A.Allocator, out: *Sink, id: u8, custom: str, fill: fun(*Sink) err[Fail]) err[Fail] {
    var scratch: Sink      = sink.make(a, LITTLE);
    var e:       err[Fail] = err[Fail].ok{};
    if (custom != nil) { e = name(?scratch, custom); }
    e = fail.kept(e, fill(?scratch));
    e = fail.kept(e, sink.u8(out, id));
    e = fail.kept(e, write.leb(out, sink.len(?scratch)::u64, PADDED));
    e = fail.kept(e, sink.bytes(out, sink.data(?scratch), sink.len(?scratch)));
    ret fail.kept(e, sink.release(?scratch));
}

pub fun name(out: *Sink, s: str) err[Fail] {
    val e: err[Fail] = sink.uleb(out, str_len(s)::u64);
    ret fail.kept(e, sink.text(out, s));
}

fun bytes(out: *Sink, p: *u8, n: usize) err[Fail] {
    ret sink.bytes(out, p, n);
}

# one function type, i32 to i32
fun types(out: *Sink) err[Fail] {
    val body: [6]u8 = [6]u8{1, 0x60, 1, 0x7f, 1, 0x7f};
    ret bytes(out, ?body[0], 6);
}

# env.__linear_memory, a memory of one page, and env.ext_call, a function
# of type 0
fun imports(out: *Sink) err[Fail] {
    var e: err[Fail] = sink.uleb(out, 2);
    e = fail.kept(e, name(out, "env"));
    e = fail.kept(e, name(out, "__linear_memory"));
    e = fail.kept(e, sink.u8(out, tables.WASM_EXTERNAL_MEMORY.value::u8));
    e = fail.kept(e, sink.u8(out, 0));
    e = fail.kept(e, sink.uleb(out, 1));
    e = fail.kept(e, name(out, "env"));
    e = fail.kept(e, name(out, "ext_call"));
    e = fail.kept(e, sink.u8(out, tables.WASM_EXTERNAL_FUNCTION.value::u8));
    ret fail.kept(e, sink.uleb(out, 0));
}

fun functions(out: *Sink) err[Fail] {
    val body: [2]u8 = [2]u8{1, 0};
    ret bytes(out, ?body[0], 2);
}

# one memory of one page and no maximum
fun memories(out: *Sink) err[Fail] {
    val body: [3]u8 = [3]u8{1, 0, 1};
    ret bytes(out, ?body[0], 3);
}

# the function as f and the memory as memory
fun exports(out: *Sink) err[Fail] {
    var e: err[Fail] = sink.uleb(out, 2);
    e = fail.kept(e, name(out, "f"));
    e = fail.kept(e, sink.u8(out, tables.WASM_EXTERNAL_FUNCTION.value::u8));
    e = fail.kept(e, sink.uleb(out, 0));
    e = fail.kept(e, name(out, "memory"));
    e = fail.kept(e, sink.u8(out, tables.WASM_EXTERNAL_MEMORY.value::u8));
    ret fail.kept(e, sink.uleb(out, 0));
}

# one body: no locals, local.get 0, end
fun module_code(out: *Sink) err[Fail] {
    val body: [4]u8     = [4]u8{0, 0x20, 0, 0x0b};
    var e:    err[Fail] = sink.uleb(out, 1);
    e = fail.kept(e, sink.uleb(out, 4));
    ret fail.kept(e, bytes(out, ?body[0], 4));
}

# the function names subsection, naming function 0 f
fun names(out: *Sink) err[Fail] {
    ret subsection(out.bytes.a, out, 1, 1, function_names);
}

fun function_names(out: *Sink) err[Fail] {
    var e: err[Fail] = sink.uleb(out, 1);
    e = fail.kept(e, sink.uleb(out, 0));
    ret fail.kept(e, name(out, "f"));
}

fun datacount(out: *Sink) err[Fail] {
    ret sink.uleb(out, 1);
}

# one body: no locals, local.get 0, i32.const 0 padded to five bytes for a
# memory address relocation, i32.add, end
fun code(out: *Sink) err[Fail] {
    val body: [11]u8    = [11]u8{0, 0x20, 0, 0x41, 0x80, 0x80, 0x80, 0x80, 0x00, 0x6a, 0x0b};
    var e:    err[Fail] = sink.uleb(out, 1);
    e = fail.kept(e, sink.uleb(out, 11));
    ret fail.kept(e, bytes(out, ?body[0], 11));
}

# one active segment at i32.const 0 holding four bytes
fun data(out: *Sink) err[Fail] {
    val body: [9]u8     = [9]u8{1, 0, 0x41, 0, 0x0b, 4, 'a', 'b', 'c'};
    var e:    err[Fail] = bytes(out, ?body[0], 9);
    ret fail.kept(e, sink.u8(out, 'd'));
}

# the priority of the one init function, f
pub val PRIORITY: u32 = 42;

# version 2, a symbol table of three symbols padded to five bytes, the
# segment info of the one segment, f as an init function and a COMDAT of f
# and the segment
fun linking(out: *Sink) err[Fail] {
    val a: *A.Allocator = out.bytes.a;
    var e: err[Fail]    = sink.uleb(out, tables.METADATA_VERSION);
    e = fail.kept(e, subsection(a, out, tables.WASM_SYMBOL_TABLE.value::u8, PADDED, symtab));
    e = fail.kept(e, subsection(a, out, tables.WASM_SEGMENT_INFO.value::u8, 1, seginfo));
    e = fail.kept(e, subsection(a, out, tables.WASM_INIT_FUNCS.value::u8, 1, inits));
    ret fail.kept(e, subsection(a, out, tables.WASM_COMDAT_INFO.value::u8, 1, comdats));
}

fun inits(out: *Sink) err[Fail] {
    var e: err[Fail] = sink.uleb(out, 1);
    e = fail.kept(e, sink.uleb(out, PRIORITY::u64));
    ret fail.kept(e, sink.uleb(out, 0));
}

# one COMDAT, grp, of the defined function and the segment
fun comdats(out: *Sink) err[Fail] {
    var e: err[Fail] = sink.uleb(out, 1);
    e = fail.kept(e, name(out, "grp"));
    e = fail.kept(e, sink.uleb(out, 0));
    e = fail.kept(e, sink.uleb(out, 2));
    e = fail.kept(e, sink.u8(out, tables.WASM_COMDAT_FUNCTION.value::u8));
    e = fail.kept(e, sink.uleb(out, 1));
    e = fail.kept(e, sink.u8(out, tables.WASM_COMDAT_DATA.value::u8));
    ret fail.kept(e, sink.uleb(out, 0));
}

pub fun subsection(a: *A.Allocator, out: *Sink, id: u8, width: u8, fill: fun(*Sink) err[Fail]) err[Fail] {
    var scratch: Sink      = sink.make(a, LITTLE);
    var e:       err[Fail] = fill(?scratch);
    e = fail.kept(e, sink.u8(out, id));
    e = fail.kept(e, write.leb(out, sink.len(?scratch)::u64, width));
    e = fail.kept(e, sink.bytes(out, sink.data(?scratch), sink.len(?scratch)));
    ret fail.kept(e, sink.release(?scratch));
}

# f, the defined function, the undefined import, and d, the data symbol
fun symtab(out: *Sink) err[Fail] {
    var e: err[Fail] = sink.uleb(out, 3);
    e = fail.kept(e, sink.u8(out, tables.WASM_SYMBOL_TYPE_FUNCTION.value::u8));
    e = fail.kept(e, sink.uleb(out, 0));
    e = fail.kept(e, sink.uleb(out, 1));
    e = fail.kept(e, name(out, "f"));
    e = fail.kept(e, sink.u8(out, tables.WASM_SYMBOL_TYPE_FUNCTION.value::u8));
    e = fail.kept(e, sink.uleb(out, tables.WASM_SYMBOL_UNDEFINED.value));
    e = fail.kept(e, sink.uleb(out, 0));
    e = fail.kept(e, sink.u8(out, tables.WASM_SYMBOL_TYPE_DATA.value::u8));
    e = fail.kept(e, sink.uleb(out, 0));
    e = fail.kept(e, name(out, "d"));
    e = fail.kept(e, sink.uleb(out, 0));
    e = fail.kept(e, sink.uleb(out, 0));
    ret fail.kept(e, sink.uleb(out, 4));
}

# the segment .data.d, aligned to four bytes and holding strings
fun seginfo(out: *Sink) err[Fail] {
    var e: err[Fail] = sink.uleb(out, 1);
    e = fail.kept(e, name(out, ".data.d"));
    e = fail.kept(e, sink.uleb(out, 2));
    ret fail.kept(e, sink.uleb(out, tables.WASM_SEG_FLAG_STRINGS.value));
}

# the offset of the padded i32.const immediate in the code payload: the
# count, the body size, the locals count, local.get 0 and the opcode
pub val RELOC_OFFSET: u64 = 6;

# one memory address relocation in the code section against d
fun relocs(out: *Sink) err[Fail] {
    var e: err[Fail] = sink.uleb(out, CODE_SECTION);
    e = fail.kept(e, sink.uleb(out, 1));
    e = fail.kept(e, sink.u8(out, tables.R_WASM_MEMORY_ADDR_LEB.value::u8));
    e = fail.kept(e, sink.uleb(out, RELOC_OFFSET));
    e = fail.kept(e, sink.uleb(out, 2));
    ret fail.kept(e, sink.sleb(out, 0));
}

fun producers(out: *Sink) err[Fail] {
    var e: err[Fail] = sink.uleb(out, 1);
    e = fail.kept(e, name(out, "language"));
    e = fail.kept(e, sink.uleb(out, 1));
    e = fail.kept(e, name(out, "C11"));
    ret fail.kept(e, name(out, ""));
}

fun features(out: *Sink) err[Fail] {
    var e: err[Fail] = sink.uleb(out, 1);
    e = fail.kept(e, sink.u8(out, tables.WASM_FEATURE_PREFIX_USED.value::u8));
    ret fail.kept(e, name(out, "mutable-globals"));
}

fun opaque(out: *Sink) err[Fail] {
    val body: [3]u8 = [3]u8{1, 2, 3};
    ret bytes(out, ?body[0], 3);
}
