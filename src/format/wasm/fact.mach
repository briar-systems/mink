# the facts only wasm states, keyed by wasm's own keys, and how a producer
# states them
#
# a wasm object's index spaces are entries of the neutral object, and what an
# entry is, a function type, a table type, memory limits, a global type or a
# tag type, is a fact about it holding that type in the encoding of the
# WebAssembly core specification (5.3, Types). a producer of a neutral object
# states each through the functions here and never encodes one itself, so the
# wasm model stays mink's own: a function's type entry by `signature`, and a
# table, memory, global or tag entry, imported or defined, by `table_type`,
# `memory_type`, `global_type` and `tag_type`. a module's own facts are
# stated the same way: a data segment's head by `segment_head`, where a
# segment that states none takes the convention's, an active segment at
# offset zero of the first memory, an element segment by `element`, the
# exports by `exports`, the start function by `start`, the data count by
# `data_count` and the producers by `producers`. each has a reader that gives
# it back as typed values, so a consumer never decodes one either. a fact
# names an entry where the encoding writes an index, and `indexed` builds the
# one map between them, which a producer or a reader of those facts takes. what
# only a link or the conversion states, FUNCTION_TABLE, TLS_BASE,
# CALL_CTORS, MEMORY and FIELD_SYMBOL, has neither.
# ---
# TYPE:           a type: its entry's index, and the type as written, opened
#                 by its recursion group's head for a group's first type
# ENTRY_TYPE:     the type of a table, memory, global or tag entry: the
#                 entry's index, and the table type opened by the
#                 initializer's bytes when it has one and followed by the
#                 initializer, limits, global type with its initializer when
#                 defined, or tag type as written
# SEGMENT:        a data segment's head: its entry's index, and its flags,
#                 memory index and offset expression as written
# ELEMENT:        an element segment as written
# DATACOUNT:      the data count the section states
# START:          the start function's index
# PRODUCERS:      the producers section's payload as written
# FUNCTION_TABLE: the link's own object states it: the entry of the
#                 function table, whose limits the link's slots give
# TLS_BASE:       the link's own object states it: the entry of the global
#                 the link starts at the thread-local block
# CALL_CTORS:     the link's own object states it: the entry of the function
#                 whose body the link writes to call the init functions
# MEMORY:         the link's own object states it: the entry of the linear
#                 memory, whose limits the layout gives
# EXPORTS:        the export section's payload as written
# FIELD_SYMBOL:   a symbol the conversion made for an import the symbol
#                 table names none for, named by its field, which the module
#                 built back writes none for: the symbol's index

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.format;
use mink.format.wasm.model;
use mink.format.wasm.read;
use mink.format.wasm.tables;
use mink.format.wasm.write;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Entry;
use mink.model.object.Fact;
use mink.model.object.Object;
use mink.model.space;
use mink.model.space.Space;

pub val TYPE:           u32 = 1;
pub val ENTRY_TYPE:     u32 = 2;
pub val SEGMENT:        u32 = 3;
pub val ELEMENT:        u32 = 4;
pub val DATACOUNT:      u32 = 5;
pub val START:          u32 = 6;
pub val PRODUCERS:      u32 = 7;
pub val FUNCTION_TABLE: u32 = 9;
pub val TLS_BASE:       u32 = 10;
pub val CALL_CTORS:     u32 = 11;
pub val MEMORY:         u32 = 12;
pub val EXPORTS:        u32 = 13;
pub val FIELD_SYMBOL:   u32 = 14;

# what a reference type refers to
# ---
# abstract: an abstract heap type, as func or extern, by its byte
#           (tables.WASM_TYPE_FUNCREF, ...)
# entry:    the type of a type entry of the object
pub tag Heap: u8 {
    abstract: u8;
    entry:    Id[Entry];
}

# a reference type: whether it holds null, and what it refers to
pub rec Reference {
    nullable: bool;
    heap:     Heap;
}

# a value type
# ---
# number:    a number or vector type by its byte (tables.WASM_TYPE_I32, ...)
# reference: a reference type
pub tag Value: u8 {
    number:    u8;
    reference: Reference;
}

# the limits of a table or a memory
# ---
# min:    the initial size
# max:    the largest size, none for a table or memory that may grow without one
# shared: a memory shared between threads
# wide:   a memory or table of 64-bit indices
pub rec Limits {
    min:    u64;
    max:    opt[u64];
    shared: bool;
    wide:   bool;
}

# where every entry falls in the index space a module writes it in, and the
# fact about each entry, built once by `index` over an object whose entries
# are all added. a producer or a reader that names an entry by its index
# takes it, and refuses one built before the object's entries changed
# ---
# count:  how many entries the object held when it was built
# within: each entry's index in its space, by the entry's index
# about:  each entry's fact of TYPE, ENTRY_TYPE or SEGMENT, one past the
#         fact's index, 0 for none
# types:  the entries of each index space, in index order
pub rec Index {
    count:     usize;
    within:    Table[u64];
    about:     Table[u32];
    types:     Table[Id[Entry]];
    functions: Table[Id[Entry]];
    tables:    Table[Id[Entry]];
    memories:  Table[Id[Entry]];
    globals:   Table[Id[Entry]];
    tags:      Table[Id[Entry]];
}

# a function type, its parameters and its results
pub rec Signature {
    params:  Table[Value];
    results: Table[Value];
}

# a table type: the references it holds, its limits, and the constant
# expression a table the object defines starts its slots as, none for an
# imported one or one whose slots start null
pub rec TableType {
    elem:   Reference;
    limits: Limits;
    init:   opt[View];
}

# a global type: its value, whether it is mutable, and the constant
# expression a global the object defines starts as, none for an imported one
pub rec GlobalType {
    value:   Value;
    mutable: bool;
    init:    opt[View];
}

# where an active segment's bytes go
# ---
# memory: the memory entry, none for the first memory where the head leaves
#         its index unwritten
# offset: the constant expression of the offset, its end opcode included
pub rec InMemory {
    memory: opt[Id[Entry]];
    offset: View;
}

# a data segment's head
# ---
# passive: the segment is copied only by memory.init
# active:  the segment is copied into a memory when the module starts
pub tag SegmentHead: u8 {
    passive;
    active: InMemory;
}

# where an active element segment's references go
# ---
# table:  the table entry, none for the first table where the segment leaves
#         its index unwritten
# offset: the constant expression of the offset, its end opcode included
pub rec InTable {
    table:  opt[Id[Entry]];
    offset: View;
}

# an element segment's mode
# ---
# passive:     copied only by table.init
# active:      copied into a table when the module starts
# declarative: declares its functions referenced and is never copied
pub tag ElementMode: u8 {
    passive;
    active: InTable;
    declarative;
}

# an element segment's items
# ---
# functions:   references to function entries
# expressions: constant expressions, each with its end opcode
pub tag Items: u8 {
    functions:   Table[Id[Entry]];
    expressions: Table[View];
}

# an element segment: its mode, the type of its references, and its items.
# a segment of functions holds funcref, as does one of expressions that
# leaves the first table's index unwritten
pub rec Element {
    mode:  ElementMode;
    type:  Reference;
    items: Items;
}

# an export: its name and the entry it exports, whose space is its kind
pub rec Export {
    name:  View;
    entry: Id[Entry];
}

# one value of a field of the producers section: the field's name, and the
# value's name and version. a field's values are consecutive
pub rec Produced {
    field:   View;
    name:    View;
    version: View;
}

# state that the type entry `e` of `o` is a function type taking `params` and
# returning `results`
pub fun signature(o: *Object, e: Id[Entry], params: *Value, param_count: usize, results: *Value, result_count: usize) err[Fail] {
    var out: Sink      = sink.make(o.a, LITTLE);
    var w:   err[Fail] = sink.u8(?out, tables.WASM_TYPE_FUNC.value::u8);
    w = fail.kept(w, values(o, ?out, params, param_count));
    w = fail.kept(w, values(o, ?out, results, result_count));
    ret stated(o, e, ?space.TYPES, TYPE, ?out, w);
}

# state that the table entry `e` of `o` holds references of `elem`, sized by
# `limits`. a table the object defines may start its slots as its constant
# expression `init`, the instructions' bytes and the closing end opcode, and
# an imported one states none
pub fun table_type(o: *Object, e: Id[Entry], elem: Reference, limits: Limits, init: opt[View]) err[Fail] {
    val entry: *Entry = table.at[Entry](?o.entries, e);
    if (sel entry.import.some && sel init.some) { ret err[Fail].err{fail.in_indexed(fail.malformed("an imported table states an initializer"), "entry", e.index::u64)}; }
    var out: Sink      = sink.make(o.a, LITTLE);
    var w:   err[Fail] = err[Fail].ok{};
    if (sel init.some) {
        w = sink.u8(?out, tables.WASM_TABLE_HAS_INIT.value::u8);
        w = fail.kept(w, sink.u8(?out, tables.WASM_TABLE_RESERVED.value::u8));
    }
    w = fail.kept(w, reference(o, ?out, ?elem));
    w = fail.kept(w, sized(?out, ?limits));
    if (sel init.some) { w = fail.kept(w, sink.bytes(?out, init.some.data, init.some.len)); }
    ret stated(o, e, ?space.TABLES, ENTRY_TYPE, ?out, w);
}

# state that the memory entry `e` of `o` is sized by `limits`, in pages
pub fun memory_type(o: *Object, e: Id[Entry], limits: Limits) err[Fail] {
    var out: Sink      = sink.make(o.a, LITTLE);
    val w:   err[Fail] = sized(?out, ?limits);
    ret stated(o, e, ?space.MEMORIES, ENTRY_TYPE, ?out, w);
}

# state that the global entry `e` of `o` holds a `value`, mutable when
# `mutable`. a global the object defines starts as its constant expression
# `init`, the instructions' bytes and the closing end opcode, and an imported
# one states none
pub fun global_type(o: *Object, e: Id[Entry], value: Value, mutable: bool, init: opt[View]) err[Fail] {
    val entry: *Entry = table.at[Entry](?o.entries, e);
    if (sel entry.import.some && sel init.some) { ret err[Fail].err{fail.in_indexed(fail.malformed("an imported global states an initializer"), "entry", e.index::u64)}; }
    if (sel entry.import.none && sel init.none) { ret err[Fail].err{fail.in_indexed(fail.malformed("a global the object defines states no initializer"), "entry", e.index::u64)}; }
    var flag: u8 = 0;
    if (mutable) { flag = 1; }
    var out: Sink      = sink.make(o.a, LITTLE);
    var w:   err[Fail] = valued(o, ?out, ?value);
    w = fail.kept(w, sink.u8(?out, flag));
    if (sel init.some) { w = fail.kept(w, sink.bytes(?out, init.some.data, init.some.len)); }
    ret stated(o, e, ?space.GLOBALS, ENTRY_TYPE, ?out, w);
}

# state that the tag entry `e` of `o` is an exception tag of the function type
# of the type entry `type`
pub fun tag_type(o: *Object, e: Id[Entry], type: Id[Entry]) err[Fail] {
    var out:   Sink           = sink.make(o.a, LITTLE);
    val index: res[u64, Fail] = type_index(o, type);
    var w:     err[Fail]      = err[Fail].ok{};
    if (sel index.err) { w = err[Fail].err{index.err}; }
    or {
        w = sink.u8(?out, 0);
        w = fail.kept(w, write.leb(?out, index.ok, model.SHORTEST));
    }
    ret stated(o, e, ?space.TAGS, ENTRY_TYPE, ?out, w);
}

# the type index the type entry `e` takes, as an object's types are its first
# entries, which a link refuses an object's types are not
fun type_index(o: *Object, e: Id[Entry]) res[u64, Fail] {
    if (e.index::usize >= table.count[Entry](?o.entries) || table.at[Entry](?o.entries, e).space != ?space.TYPES) {
        ret res[u64, Fail].err{fail.in_indexed(fail.malformed("a reference names an entry that is no type"), "entry", e.index::u64)};
    }
    ret res[u64, Fail].ok{e.index::u64};
}

# a vector of `count` value types
fun values(o: *Object, out: *Sink, at: *Value, count: usize) err[Fail] {
    var w: err[Fail] = write.leb(out, count::u64, model.SHORTEST);
    var i: usize     = 0;
    for (i < count) {
        w = fail.kept(w, valued(o, out, ?at[i]));
        i = i + 1;
    }
    ret w;
}

fun valued(o: *Object, out: *Sink, v: *Value) err[Fail] {
    if (sel v.number) { ret sink.u8(out, v.number); }
    ret reference(o, out, ?v.reference);
}

# a reference type: the one byte of its abstract heap type for a nullable
# reference to one, as the specification abbreviates it, and its
# nullability's prefix then its heap type otherwise
fun reference(o: *Object, out: *Sink, r: *Reference) err[Fail] {
    if (sel r.heap.abstract) {
        if (r.nullable) { ret sink.u8(out, r.heap.abstract); }
    }
    var prefix: u8 = tables.WASM_TYPE_NONNULLABLE.value::u8;
    if (r.nullable) { prefix = tables.WASM_TYPE_NULLABLE.value::u8; }
    val w: err[Fail] = sink.u8(out, prefix);
    if (sel w.err)           { ret w; }
    if (sel r.heap.abstract) { ret sink.u8(out, r.heap.abstract); }
    val index: res[u64, Fail] = type_index(o, r.heap.entry);
    if (sel index.err) { ret err[Fail].err{index.err}; }
    ret write.sleb(out, index.ok::i64, model.SHORTEST);
}

fun sized(out: *Sink, l: *Limits) err[Fail] {
    var flags: u64 = tables.WASM_LIMITS_FLAG_NONE.value;
    if (sel l.max.some) { flags = flags | tables.WASM_LIMITS_FLAG_HAS_MAX.value; }
    if (l.shared)       { flags = flags | tables.WASM_LIMITS_FLAG_IS_SHARED.value; }
    if (l.wide)         { flags = flags | tables.WASM_LIMITS_FLAG_IS_64.value; }
    var w: err[Fail] = sink.u8(out, flags::u8);
    w = fail.kept(w, write.leb(out, l.min, model.SHORTEST));
    if (sel l.max.some) { w = fail.kept(w, write.leb(out, l.max.some, model.SHORTEST)); }
    ret w;
}

# add the fact of `key` about the entry `e` of the space `sp`, holding what
# `out` holds once `w`, its writing, held, and release `out`. a refusal
# leaves the object as it was
fun stated(o: *Object, e: Id[Entry], sp: *Space, key: u32, out: *Sink, w: err[Fail]) err[Fail] {
    var r: err[Fail] = w;
    if (sel w.ok) { r = add(o, e, sp, key, sink.data(out), sink.len(out)); }
    val gone: err[Fail] = sink.release(out);
    if (sel r.err) { ret r; }
    ret gone;
}

fun add(o: *Object, e: Id[Entry], sp: *Space, key: u32, bytes: *u8, n: usize) err[Fail] {
    if (e.index::usize >= table.count[Entry](?o.entries)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a fact is about an entry the object does not hold"), "entry", e.index::u64)}; }
    val entry: *Entry = table.at[Entry](?o.entries, e);
    if (entry.space != sp)     { ret err[Fail].err{fail.in_indexed(fail.malformed("a fact states a type of another space than its entry's"), "entry", e.index::u64)}; }
    if (sel entry.stated.some) { ret err[Fail].err{fail.in_indexed(fail.malformed("an entry's type is stated twice"), "entry", e.index::u64)}; }
    ret stating(o, e, key, bytes, n);
}

fun stating(o: *Object, e: Id[Entry], key: u32, bytes: *u8, n: usize) err[Fail] {
    val room: err[Fail] = table.reserve[Fact](?o.facts, 1);
    if (sel room.err) { ret room; }
    val held: res[Contents, Fail] = object.own(o, bytes, n);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    val f: res[Id[Fact], Fail] = object.add_fact(o, Fact{format: ?format.WASM, key: key, value: e.index::u64, data: held.ok});
    if (sel f.err) { ret err[Fail].err{f.err}; }
    table.at[Entry](?o.entries, e).stated = opt[Id[Fact]].some{f.ok};
    ret err[Fail].ok{};
}

# the import kind of the index space `sp`, none for a space no import kind
# names
pub fun kind_of_space(sp: *Space) opt[u8] {
    if (sp == ?space.FUNCTIONS) { ret opt[u8].some{tables.WASM_EXTERNAL_FUNCTION.value::u8}; }
    if (sp == ?space.TABLES)    { ret opt[u8].some{tables.WASM_EXTERNAL_TABLE.value::u8}; }
    if (sp == ?space.MEMORIES)  { ret opt[u8].some{tables.WASM_EXTERNAL_MEMORY.value::u8}; }
    if (sp == ?space.GLOBALS)   { ret opt[u8].some{tables.WASM_EXTERNAL_GLOBAL.value::u8}; }
    if (sp == ?space.TAGS)      { ret opt[u8].some{tables.WASM_EXTERNAL_TAG.value::u8}; }
    ret opt[u8].none{};
}

# the index space of the import kind `kind`, none for a kind the
# specification does not define
pub fun space_of_kind(kind: u8) opt[*Space] {
    if (kind == tables.WASM_EXTERNAL_FUNCTION.value::u8) { ret opt[*Space].some{?space.FUNCTIONS}; }
    if (kind == tables.WASM_EXTERNAL_TABLE.value::u8)    { ret opt[*Space].some{?space.TABLES}; }
    if (kind == tables.WASM_EXTERNAL_MEMORY.value::u8)   { ret opt[*Space].some{?space.MEMORIES}; }
    if (kind == tables.WASM_EXTERNAL_GLOBAL.value::u8)   { ret opt[*Space].some{?space.GLOBALS}; }
    if (kind == tables.WASM_EXTERNAL_TAG.value::u8)      { ret opt[*Space].some{?space.TAGS}; }
    ret opt[*Space].none{};
}

# the entries of the index space `sp` in `ix`, nil for a space a module
# writes no index of
fun listed(ix: *Index, sp: *Space) *Table[Id[Entry]] {
    if (sp == ?space.TYPES)     { ret ?ix.types; }
    if (sp == ?space.FUNCTIONS) { ret ?ix.functions; }
    if (sp == ?space.TABLES)    { ret ?ix.tables; }
    if (sp == ?space.MEMORIES)  { ret ?ix.memories; }
    if (sp == ?space.GLOBALS)   { ret ?ix.globals; }
    if (sp == ?space.TAGS)      { ret ?ix.tags; }
    ret nil;
}

# whether a fact of `key` is about one entry
fun about_entry(key: u32) bool {
    ret key == TYPE || key == ENTRY_TYPE || key == SEGMENT;
}

# the index of the entries of `o`, which must all be added
pub fun indexed(o: *Object) res[Index, Fail] {
    val a:  *A.Allocator = o.a;
    var ix: Index        = Index{
        count:     table.count[Entry](?o.entries),
        within:    table.make[u64](a),
        about:     table.make[u32](a),
        types:     table.make[Id[Entry]](a),
        functions: table.make[Id[Entry]](a),
        tables:    table.make[Id[Entry]](a),
        memories:  table.make[Id[Entry]](a),
        globals:   table.make[Id[Entry]](a),
        tags:      table.make[Id[Entry]](a),
    };
    val built: err[Fail] = indexing(o, ?ix);
    if (sel built.err) {
        val gone: err[Fail] = release_index(?ix);
        ret res[Index, Fail].err{built.err};
    }
    ret res[Index, Fail].ok{ix};
}

fun indexing(o: *Object, ix: *Index) err[Fail] {
    val n:  usize              = ix.count;
    val gw: res[Id[u64], Fail] = table.grow[u64](?ix.within, n);
    if (sel gw.err) { ret err[Fail].err{gw.err}; }
    val ga: res[Id[u32], Fail] = table.grow[u32](?ix.about, n);
    if (sel ga.err) { ret err[Fail].err{ga.err}; }
    var i: usize = 0;
    for (i < n) {
        val id:   Id[Entry]         = table.nth[Entry](i);
        val list: *Table[Id[Entry]] = listed(ix, table.at[Entry](?o.entries, id).space);
        i = i + 1;
        if (list == nil) { cnt; }
        @table.at[u64](?ix.within, table.nth[u64](i - 1)) = table.count[Id[Entry]](list)::u64;
        val p: res[Id[Id[Entry]], Fail] = table.push[Id[Entry]](list, id);
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    i = 0;
    for (i < table.count[Fact](?o.facts)) {
        val f: *Fact = table.at[Fact](?o.facts, table.nth[Fact](i));
        i = i + 1;
        if (f.format != ?format.WASM || !about_entry(f.key)) { cnt; }
        if (f.value >= n::u64)                               { ret err[Fail].err{fail.in_indexed(fail.malformed("a fact is about an entry the object does not hold"), "fact", (i - 1)::u64)}; }
        val at: *u32 = table.at[u32](?ix.about, table.nth[u32](f.value::usize));
        if (@at != 0) { ret err[Fail].err{fail.in_indexed(fail.malformed("an entry's type is stated twice"), "entry", f.value)}; }
        @at = i::u32;
    }
    ret err[Fail].ok{};
}

# release what `ix` holds
pub fun release_index(ix: *Index) err[Fail] {
    var e: err[Fail] = table.release[u64](?ix.within);
    e = fail.kept(e, table.release[u32](?ix.about));
    e = fail.kept(e, table.release[Id[Entry]](?ix.types));
    e = fail.kept(e, table.release[Id[Entry]](?ix.functions));
    e = fail.kept(e, table.release[Id[Entry]](?ix.tables));
    e = fail.kept(e, table.release[Id[Entry]](?ix.memories));
    e = fail.kept(e, table.release[Id[Entry]](?ix.globals));
    ret fail.kept(e, table.release[Id[Entry]](?ix.tags));
}

# refuse `ix` when the entries of `o` changed since it was built
fun current(o: *Object, ix: *Index) err[Fail] {
    if (table.count[Entry](?o.entries) != ix.count) { ret err[Fail].err{fail.malformed("the entry index was built before the object's entries changed")}; }
    ret err[Fail].ok{};
}

# the index the entry `e` of the space `sp` is written by
fun index_of(o: *Object, ix: *Index, e: Id[Entry], sp: *Space) res[u64, Fail] {
    val c: err[Fail] = current(o, ix);
    if (sel c.err)                  { ret res[u64, Fail].err{c.err}; }
    if (e.index::usize >= ix.count) { ret res[u64, Fail].err{fail.in_indexed(fail.malformed("a fact names an entry the object does not hold"), "entry", e.index::u64)}; }
    if (table.at[Entry](?o.entries, e).space != sp) {
        ret res[u64, Fail].err{fail.in_indexed(fail.about(fail.malformed("a fact names an entry of another space than the one it takes"), sp.name), "entry", e.index::u64)};
    }
    ret res[u64, Fail].ok{@table.at[u64](?ix.within, table.nth[u64](e.index::usize))};
}

# the entry the index `index` of the space `sp` names
fun entry_at(o: *Object, ix: *Index, sp: *Space, index: u64) res[Id[Entry], Fail] {
    val c: err[Fail] = current(o, ix);
    if (sel c.err) { ret res[Id[Entry], Fail].err{c.err}; }
    val list: *Table[Id[Entry]] = listed(ix, sp);
    if (list == nil)                                { ret res[Id[Entry], Fail].err{fail.about(fail.internal("a module writes no index of this space"), sp.name)}; }
    if (index >= table.count[Id[Entry]](list)::u64) { ret res[Id[Entry], Fail].err{fail.valued(fail.about(fail.malformed("an index lies past its space"), sp.name), index::i128)}; }
    ret res[Id[Entry], Fail].ok{@table.at[Id[Entry]](list, table.nth[Id[Entry]](index::usize))};
}

# the fact of `key` about the entry `e`, none when the entry has none
fun entry_fact(o: *Object, ix: *Index, e: Id[Entry], key: u32) res[opt[*Fact], Fail] {
    val c: err[Fail] = current(o, ix);
    if (sel c.err)                  { ret res[opt[*Fact], Fail].err{c.err}; }
    if (e.index::usize >= ix.count) { ret res[opt[*Fact], Fail].err{fail.in_indexed(fail.malformed("a reader names an entry the object does not hold"), "entry", e.index::u64)}; }
    val at: u32 = @table.at[u32](?ix.about, table.nth[u32](e.index::usize));
    if (at == 0) { ret res[opt[*Fact], Fail].ok{opt[*Fact].none{}}; }
    val f: *Fact = table.at[Fact](?o.facts, table.nth[Fact](at::usize - 1));
    if (f.key != key) { ret res[opt[*Fact], Fail].err{fail.in_indexed(fail.malformed("the fact about an entry is of another key than the reader's"), "entry", e.index::u64)}; }
    ret res[opt[*Fact], Fail].ok{opt[*Fact].some{f}};
}

# the fact of `key` about `e`, refused when it has none
fun needed_fact(o: *Object, ix: *Index, e: Id[Entry], key: u32) res[*Fact, Fail] {
    val f: res[opt[*Fact], Fail] = entry_fact(o, ix, e, key);
    if (sel f.err) { ret res[*Fact, Fail].err{f.err}; }
    val got: opt[*Fact] = f.ok;
    if (sel got.none) { ret res[*Fact, Fail].err{fail.in_indexed(fail.malformed("an entry states no type"), "entry", e.index::u64)}; }
    ret res[*Fact, Fail].ok{got.some};
}

fun reading(o: *Object, f: *Fact) Reader {
    val b: Bytes = object.bytes(o, ?f.data);
    ret reader.make(nil, b.data, b.len, LITTLE);
}

# a constant expression read from `rd`, its end opcode included
fun expression(rd: *Reader) res[View, Fail] {
    val start: usize                 = rd.pos;
    val x:     res[model.Expr, Fail] = read.expr(rd);
    if (sel x.err) { ret res[View, Fail].err{x.err}; }
    ret res[View, Fail].ok{View{data: ?rd.data[start], len: rd.pos - start}};
}

# refuse `v` unless it is one constant expression closed by its end opcode
fun constant(v: View) err[Fail] {
    var rd: Reader                = reader.make(nil, v.data, v.len, LITTLE);
    val x:  res[model.Expr, Fail] = read.expr(?rd);
    if (sel x.err) { ret err[Fail].err{x.err}; }
    ret read.drained(?rd);
}

fun funcref() Reference {
    ret Reference{nullable: true, heap: Heap.abstract{tables.WASM_TYPE_FUNCREF.value::u8}};
}

fun is_funcref(r: *Reference) bool {
    if (!r.nullable)         { ret false; }
    if (sel r.heap.abstract) { ret r.heap.abstract == tables.WASM_TYPE_FUNCREF.value::u8; }
    ret false;
}

fun reference_of(o: *Object, ix: *Index, r: *model.RefType) res[Reference, Fail] {
    if (sel r.heap.abstract) { ret res[Reference, Fail].ok{Reference{nullable: r.nullable, heap: Heap.abstract{r.heap.abstract}}}; }
    val t: res[Id[Entry], Fail] = entry_at(o, ix, ?space.TYPES, r.heap.index.value::u64);
    if (sel t.err) { ret res[Reference, Fail].err{t.err}; }
    ret res[Reference, Fail].ok{Reference{nullable: r.nullable, heap: Heap.entry{t.ok}}};
}

fun value_of(o: *Object, ix: *Index, v: *model.ValType) res[Value, Fail] {
    if (sel v.number) { ret res[Value, Fail].ok{Value.number{v.number}}; }
    val r: res[Reference, Fail] = reference_of(o, ix, ?v.reference);
    if (sel r.err) { ret res[Value, Fail].err{r.err}; }
    ret res[Value, Fail].ok{Value.reference{r.ok}};
}

fun limits_of(l: *model.Limits) res[Limits, Fail] {
    if ((l.flags & tables.WASM_LIMITS_FLAG_HAS_PAGE_SIZE.value::u8) != 0) { ret res[Limits, Fail].err{fail.unsupported("limits that state a page size have no typed form")}; }
    var max: opt[u64] = opt[u64].none{};
    if ((l.flags & tables.WASM_LIMITS_FLAG_HAS_MAX.value::u8) != 0) { max = opt[u64].some{l.max.value}; }
    val shared: bool = (l.flags & tables.WASM_LIMITS_FLAG_IS_SHARED.value::u8) != 0;
    val wide:   bool = (l.flags & tables.WASM_LIMITS_FLAG_IS_64.value::u8) != 0;
    ret res[Limits, Fail].ok{Limits{min: l.min.value, max: max, shared: shared, wide: wide}};
}

# a vector of value types read from `rd` into `into`
fun read_values(o: *Object, ix: *Index, rd: *Reader, into: *Table[Value]) err[Fail] {
    val n: res[model.Run, Fail] = read.count(rd);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    var i: usize = 0;
    for (i < n.ok.count) {
        val v: res[model.ValType, Fail] = read.valtype(rd);
        if (sel v.err) { ret err[Fail].err{v.err}; }
        val got: model.ValType    = v.ok;
        val x:   res[Value, Fail] = value_of(o, ix, ?got);
        if (sel x.err) { ret err[Fail].err{x.err}; }
        val p: res[Id[Value], Fail] = table.push[Value](into, x.ok);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the function type the type entry `e` states. a type in a recursion group,
# one that declares supertypes and a struct or array type have no typed form
pub fun signature_of(o: *Object, ix: *Index, e: Id[Entry]) res[Signature, Fail] {
    val f: res[*Fact, Fail] = needed_fact(o, ix, e, TYPE);
    if (sel f.err) { ret res[Signature, Fail].err{f.err}; }
    var rd:   Reader        = reading(o, f.ok);
    val form: res[u8, Fail] = read.peek_byte(?rd);
    if (sel form.err)                                { ret res[Signature, Fail].err{form.err}; }
    if (form.ok::u64 != tables.WASM_TYPE_FUNC.value) { ret res[Signature, Fail].err{fail.in_indexed(fail.unsupported("a type other than a lone function type has no typed signature"), "entry", e.index::u64)}; }
    rd.pos = rd.pos + 1;
    var s: Signature = Signature{params: table.make[Value](o.a), results: table.make[Value](o.a)};
    val w: err[Fail] = signature_body(o, ix, ?rd, ?s);
    if (sel w.err) {
        val gone: err[Fail] = release_signature(?s);
        ret res[Signature, Fail].err{w.err};
    }
    ret res[Signature, Fail].ok{s};
}

fun signature_body(o: *Object, ix: *Index, rd: *Reader, s: *Signature) err[Fail] {
    val p: err[Fail] = read_values(o, ix, rd, ?s.params);
    if (sel p.err) { ret p; }
    val r: err[Fail] = read_values(o, ix, rd, ?s.results);
    if (sel r.err) { ret r; }
    ret read.drained(rd);
}

# release what `s` holds
pub fun release_signature(s: *Signature) err[Fail] {
    val e: err[Fail] = table.release[Value](?s.params);
    ret fail.kept(e, table.release[Value](?s.results));
}

# the table type the table entry `e` states, with the initializer of a table
# the object defines that has one
pub fun table_type_of(o: *Object, ix: *Index, e: Id[Entry]) res[TableType, Fail] {
    val f: res[*Fact, Fail] = needed_fact(o, ix, e, ENTRY_TYPE);
    if (sel f.err) { ret res[TableType, Fail].err{f.err}; }
    val entry: *Entry = table.at[Entry](?o.entries, e);
    if (entry.space != ?space.TABLES) { ret res[TableType, Fail].err{fail.in_indexed(fail.malformed("a table type is read of an entry that is no table"), "entry", e.index::u64)}; }
    var rd: Reader                    = reading(o, f.ok);
    val t:  res[model.TableDef, Fail] = read.table_def(?rd);
    if (sel t.err) { ret res[TableType, Fail].err{t.err}; }
    val def:  model.TableDef = t.ok;
    var init: opt[View]      = opt[View].none{};
    if (sel def.init.some) {
        if (sel entry.import.some) { ret res[TableType, Fail].err{fail.in_indexed(fail.malformed("an imported table states an initializer"), "entry", e.index::u64)}; }
        val x: Bytes = store.bytes(?o.store, ?def.init.some.bytes);
        init = opt[View].some{View{data: x.data, len: x.len}};
    }
    val d: err[Fail] = read.drained(?rd);
    if (sel d.err) { ret res[TableType, Fail].err{d.err}; }
    val elem: res[Reference, Fail] = reference_of(o, ix, ?def.type.elem);
    if (sel elem.err) { ret res[TableType, Fail].err{elem.err}; }
    val l: res[Limits, Fail] = limits_of(?def.type.limits);
    if (sel l.err) { ret res[TableType, Fail].err{l.err}; }
    ret res[TableType, Fail].ok{TableType{elem: elem.ok, limits: l.ok, init: init}};
}

# the limits the memory entry `e` states, in pages
pub fun memory_type_of(o: *Object, ix: *Index, e: Id[Entry]) res[Limits, Fail] {
    val f: res[*Fact, Fail] = needed_fact(o, ix, e, ENTRY_TYPE);
    if (sel f.err)                                               { ret res[Limits, Fail].err{f.err}; }
    if (table.at[Entry](?o.entries, e).space != ?space.MEMORIES) { ret res[Limits, Fail].err{fail.in_indexed(fail.malformed("a memory type is read of an entry that is no memory"), "entry", e.index::u64)}; }
    var rd: Reader                  = reading(o, f.ok);
    val l:  res[model.Limits, Fail] = read.limits(?rd);
    if (sel l.err) { ret res[Limits, Fail].err{l.err}; }
    val d: err[Fail] = read.drained(?rd);
    if (sel d.err) { ret res[Limits, Fail].err{d.err}; }
    val got: model.Limits = l.ok;
    ret limits_of(?got);
}

# the global type the global entry `e` states, with the initializer of a
# global the object defines
pub fun global_type_of(o: *Object, ix: *Index, e: Id[Entry]) res[GlobalType, Fail] {
    val f: res[*Fact, Fail] = needed_fact(o, ix, e, ENTRY_TYPE);
    if (sel f.err) { ret res[GlobalType, Fail].err{f.err}; }
    val entry: *Entry = table.at[Entry](?o.entries, e);
    if (entry.space != ?space.GLOBALS) { ret res[GlobalType, Fail].err{fail.in_indexed(fail.malformed("a global type is read of an entry that is no global"), "entry", e.index::u64)}; }
    var rd: Reader                      = reading(o, f.ok);
    val g:  res[model.GlobalType, Fail] = read.global_type(?rd);
    if (sel g.err) { ret res[GlobalType, Fail].err{g.err}; }
    val got: model.GlobalType = g.ok;
    val v:   res[Value, Fail] = value_of(o, ix, ?got.valtype);
    if (sel v.err) { ret res[GlobalType, Fail].err{v.err}; }
    var init: opt[View] = opt[View].none{};
    if (sel entry.import.none) {
        val x: res[View, Fail] = expression(?rd);
        if (sel x.err) { ret res[GlobalType, Fail].err{x.err}; }
        init = opt[View].some{x.ok};
    }
    val d: err[Fail] = read.drained(?rd);
    if (sel d.err) { ret res[GlobalType, Fail].err{d.err}; }
    ret res[GlobalType, Fail].ok{GlobalType{value: v.ok, mutable: got.mutable == 1, init: init}};
}

# the type entry of the exception tag the tag entry `e` states
pub fun tag_type_of(o: *Object, ix: *Index, e: Id[Entry]) res[Id[Entry], Fail] {
    val f: res[*Fact, Fail] = needed_fact(o, ix, e, ENTRY_TYPE);
    if (sel f.err)                                           { ret res[Id[Entry], Fail].err{f.err}; }
    if (table.at[Entry](?o.entries, e).space != ?space.TAGS) { ret res[Id[Entry], Fail].err{fail.in_indexed(fail.malformed("a tag type is read of an entry that is no tag"), "entry", e.index::u64)}; }
    var rd: Reader                   = reading(o, f.ok);
    val t:  res[model.TagType, Fail] = read.tag_type(?rd);
    if (sel t.err)           { ret res[Id[Entry], Fail].err{t.err}; }
    if (t.ok.attribute != 0) { ret res[Id[Entry], Fail].err{fail.valued(fail.in_indexed(fail.unsupported("a tag of an attribute other than exception has no typed form"), "entry", e.index::u64), t.ok.attribute::i128)}; }
    val d: err[Fail] = read.drained(?rd);
    if (sel d.err) { ret res[Id[Entry], Fail].err{d.err}; }
    ret entry_at(o, ix, ?space.TYPES, t.ok.type.value);
}

# state the head of the data segment entry `e` of `o`. the head of an active
# segment whose memory is none leaves the first memory's index unwritten
pub fun segment_head(o: *Object, ix: *Index, e: Id[Entry], head: SegmentHead) err[Fail] {
    var out: Sink      = sink.make(o.a, LITTLE);
    var w:   err[Fail] = err[Fail].ok{};
    if (sel head.passive) { w = write.leb(?out, tables.WASM_DATA_SEGMENT_IS_PASSIVE.value, model.SHORTEST); }
    or (sel head.active) {
        val at: InMemory = head.active;
        w = constant(at.offset);
        if (sel at.memory.some) {
            val index: res[u64, Fail] = index_of(o, ix, at.memory.some, ?space.MEMORIES);
            if (sel index.err) { w = fail.kept(w, err[Fail].err{index.err}); }
            or {
                w = fail.kept(w, write.leb(?out, tables.WASM_DATA_SEGMENT_HAS_MEMINDEX.value, model.SHORTEST));
                w = fail.kept(w, write.leb(?out, index.ok, model.SHORTEST));
            }
        }
        or { w = fail.kept(w, write.leb(?out, 0, model.SHORTEST)); }
        w = fail.kept(w, sink.bytes(?out, at.offset.data, at.offset.len));
    }
    ret stated(o, e, ?space.SEGMENTS, SEGMENT, ?out, w);
}

# the head the data segment entry `e` states, none for a segment that states
# none and takes the convention's
pub fun segment_head_of(o: *Object, ix: *Index, e: Id[Entry]) res[opt[SegmentHead], Fail] {
    val found: res[opt[*Fact], Fail] = entry_fact(o, ix, e, SEGMENT);
    if (sel found.err) { ret res[opt[SegmentHead], Fail].err{found.err}; }
    val f: opt[*Fact] = found.ok;
    if (sel f.none) { ret res[opt[SegmentHead], Fail].ok{opt[SegmentHead].none{}}; }
    var rd:    Reader               = reading(o, f.some);
    val flags: res[model.Leb, Fail] = read.uleb(?rd);
    if (sel flags.err) { ret res[opt[SegmentHead], Fail].err{flags.err}; }
    val v: u64 = flags.ok.value;
    if (v == tables.WASM_DATA_SEGMENT_IS_PASSIVE.value) {
        val d: err[Fail] = read.drained(?rd);
        if (sel d.err) { ret res[opt[SegmentHead], Fail].err{d.err}; }
        ret res[opt[SegmentHead], Fail].ok{opt[SegmentHead].some{SegmentHead.passive{}}};
    }
    if (v != 0 && v != tables.WASM_DATA_SEGMENT_HAS_MEMINDEX.value) { ret res[opt[SegmentHead], Fail].err{fail.valued(fail.in_indexed(fail.malformed("a data segment's flags are none the specification defines"), "entry", e.index::u64), v::i128)}; }
    var memory: opt[Id[Entry]] = opt[Id[Entry]].none{};
    if (v != 0) {
        val index: res[model.Leb, Fail] = read.uleb(?rd);
        if (sel index.err) { ret res[opt[SegmentHead], Fail].err{index.err}; }
        val m: res[Id[Entry], Fail] = entry_at(o, ix, ?space.MEMORIES, index.ok.value);
        if (sel m.err) { ret res[opt[SegmentHead], Fail].err{m.err}; }
        memory = opt[Id[Entry]].some{m.ok};
    }
    val offset: res[View, Fail] = expression(?rd);
    if (sel offset.err) { ret res[opt[SegmentHead], Fail].err{offset.err}; }
    val d: err[Fail] = read.drained(?rd);
    if (sel d.err) { ret res[opt[SegmentHead], Fail].err{d.err}; }
    ret res[opt[SegmentHead], Fail].ok{opt[SegmentHead].some{SegmentHead.active{InMemory{memory: memory, offset: offset.ok}}}};
}

# state the element segment `el` of `o`, the segment `position` of the
# element section, which lists the segments in the order they are stated
pub fun element(o: *Object, ix: *Index, position: u64, el: *Element) err[Fail] {
    val exprs:  bool           = sel el.items.expressions;
    var flags:  u64            = 0;
    var target: opt[Id[Entry]] = opt[Id[Entry]].none{};
    var offset: View;
    if (sel el.mode.passive)     { flags = tables.WASM_ELEM_SEGMENT_IS_PASSIVE.value; }
    or (sel el.mode.declarative) { flags = tables.WASM_ELEM_SEGMENT_IS_PASSIVE.value | tables.WASM_ELEM_SEGMENT_IS_DECLARATIVE.value; }
    or (sel el.mode.active) {
        target = el.mode.active.table;
        offset = el.mode.active.offset;
        if (sel target.some) { flags = tables.WASM_ELEM_SEGMENT_HAS_TABLE_NUMBER.value; }
    }
    if (exprs) { flags = flags | tables.WASM_ELEM_SEGMENT_HAS_INIT_EXPRS.value; }
    val described: bool = (flags & model.ELEM_DESC_MASK) != 0;
    if ((!exprs || !described) && !is_funcref(?el.type)) { ret err[Fail].err{fail.in_indexed(fail.malformed("an element segment that writes no reference type holds funcref"), "element segment", position)}; }
    var out: Sink      = sink.make(o.a, LITTLE);
    val w:   err[Fail] = element_bytes(o, ix, ?out, el, flags, target, offset);
    ret alone(o, ELEMENT, position, ?out, positioned(w, position), false);
}

fun positioned(w: err[Fail], position: u64) err[Fail] {
    if (sel w.err) { ret err[Fail].err{fail.in_indexed(w.err, "element segment", position)}; }
    ret w;
}

fun element_bytes(o: *Object, ix: *Index, out: *Sink, el: *Element, flags: u64, target: opt[Id[Entry]], offset: View) err[Fail] {
    val head: err[Fail] = write.leb(out, flags, model.SHORTEST);
    if (sel head.err) { ret head; }
    if (sel el.mode.active) {
        val c: err[Fail] = constant(offset);
        if (sel c.err) { ret c; }
        if (sel target.some) {
            val index: res[u64, Fail] = index_of(o, ix, target.some, ?space.TABLES);
            if (sel index.err) { ret err[Fail].err{index.err}; }
            val t: err[Fail] = write.leb(out, index.ok, model.SHORTEST);
            if (sel t.err) { ret t; }
        }
        val x: err[Fail] = sink.bytes(out, offset.data, offset.len);
        if (sel x.err) { ret x; }
    }
    val described: bool      = (flags & model.ELEM_DESC_MASK) != 0;
    var typed:     err[Fail] = err[Fail].ok{};
    if (described && sel el.items.expressions) { typed = reference(o, out, ?el.type); }
    or (described)                             { typed = sink.u8(out, 0); }
    if (sel typed.err)                         { ret typed; }
    if (sel el.items.functions) {
        val n: usize     = table.count[Id[Entry]](?el.items.functions);
        val c: err[Fail] = write.leb(out, n::u64, model.SHORTEST);
        if (sel c.err) { ret c; }
        var i: usize = 0;
        for (i < n) {
            val index: res[u64, Fail] = index_of(o, ix, @table.at[Id[Entry]](?el.items.functions, table.nth[Id[Entry]](i)), ?space.FUNCTIONS);
            if (sel index.err) { ret err[Fail].err{index.err}; }
            val w: err[Fail] = write.leb(out, index.ok, model.SHORTEST);
            if (sel w.err) { ret w; }
            i = i + 1;
        }
    }
    or (sel el.items.expressions) {
        val n: usize     = table.count[View](?el.items.expressions);
        val c: err[Fail] = write.leb(out, n::u64, model.SHORTEST);
        if (sel c.err) { ret c; }
        var i: usize = 0;
        for (i < n) {
            val x: View      = @table.at[View](?el.items.expressions, table.nth[View](i));
            val k: err[Fail] = constant(x);
            if (sel k.err) { ret k; }
            val w: err[Fail] = sink.bytes(out, x.data, x.len);
            if (sel w.err) { ret w; }
            i = i + 1;
        }
    }
    ret err[Fail].ok{};
}

# the element segment the fact `f` of `o` states, which must be of ELEMENT.
# its items live in tables of their own, which `release_element` releases
pub fun element_of(o: *Object, ix: *Index, f: *Fact) res[Element, Fail] {
    if (f.format != ?format.WASM || f.key != ELEMENT) { ret res[Element, Fail].err{fail.malformed("an element segment is read of a fact of another key")}; }
    val c: err[Fail] = current(o, ix);
    if (sel c.err) { ret res[Element, Fail].err{c.err}; }
    var rd:    Reader               = reading(o, f);
    val flags: res[model.Leb, Fail] = read.uleb(?rd);
    if (sel flags.err) { ret res[Element, Fail].err{flags.err}; }
    val v: u64 = flags.ok.value;
    if ((v & ~0x7) != 0) { ret res[Element, Fail].err{fail.valued(fail.malformed("an element segment's flags are none the specification defines"), v::i128)}; }
    val exprs: bool = (v & tables.WASM_ELEM_SEGMENT_HAS_INIT_EXPRS.value) != 0;
    var el:    Element;
    if (exprs) { el.items = Items.expressions{table.make[View](o.a)}; }
    or         { el.items = Items.functions{table.make[Id[Entry]](o.a)}; }
    val w: err[Fail] = element_body(o, ix, ?rd, v, ?el);
    if (sel w.err) {
        val gone: err[Fail] = release_element(?el);
        ret res[Element, Fail].err{fail.in_indexed(w.err, "element segment", f.value)};
    }
    ret res[Element, Fail].ok{el};
}

fun element_body(o: *Object, ix: *Index, rd: *Reader, v: u64, el: *Element) err[Fail] {
    if ((v & tables.WASM_ELEM_SEGMENT_IS_PASSIVE.value) != 0) {
        if ((v & tables.WASM_ELEM_SEGMENT_IS_DECLARATIVE.value) != 0) { el.mode = ElementMode.declarative{}; }
        or                                                            { el.mode = ElementMode.passive{}; }
    }
    or {
        var at: InTable = InTable{table: opt[Id[Entry]].none{}};
        if ((v & tables.WASM_ELEM_SEGMENT_HAS_TABLE_NUMBER.value) != 0) {
            val index: res[model.Leb, Fail] = read.uleb(rd);
            if (sel index.err) { ret err[Fail].err{index.err}; }
            val t: res[Id[Entry], Fail] = entry_at(o, ix, ?space.TABLES, index.ok.value);
            if (sel t.err) { ret err[Fail].err{t.err}; }
            at.table = opt[Id[Entry]].some{t.ok};
        }
        val offset: res[View, Fail] = expression(rd);
        if (sel offset.err) { ret err[Fail].err{offset.err}; }
        at.offset = offset.ok;
        el.mode   = ElementMode.active{at};
    }
    val described: bool = (v & model.ELEM_DESC_MASK) != 0;
    el.type = funcref();
    if (described && sel el.items.expressions) {
        val r: res[model.RefType, Fail] = read.ref_type(rd);
        if (sel r.err) { ret err[Fail].err{r.err}; }
        val got: model.RefType        = r.ok;
        val ref: res[Reference, Fail] = reference_of(o, ix, ?got);
        if (sel ref.err) { ret err[Fail].err{ref.err}; }
        el.type = ref.ok;
    }
    or (described) {
        val kind: res[u8, Fail] = reader.u8(rd);
        if (sel kind.err) { ret err[Fail].err{kind.err}; }
        if (kind.ok != 0) { ret err[Fail].err{fail.valued(fail.unsupported("an element kind other than funcref has no typed form"), kind.ok::i128)}; }
    }
    val n: res[model.Run, Fail] = read.count(rd);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    var i: usize = 0;
    for (i < n.ok.count) {
        if (sel el.items.expressions) {
            val x: res[View, Fail] = expression(rd);
            if (sel x.err) { ret err[Fail].err{x.err}; }
            val p: res[Id[View], Fail] = table.push[View](?el.items.expressions, x.ok);
            if (sel p.err) { ret err[Fail].err{p.err}; }
        }
        or (sel el.items.functions) {
            val index: res[model.Leb, Fail] = read.uleb(rd);
            if (sel index.err) { ret err[Fail].err{index.err}; }
            val fn: res[Id[Entry], Fail] = entry_at(o, ix, ?space.FUNCTIONS, index.ok.value);
            if (sel fn.err) { ret err[Fail].err{fn.err}; }
            val p: res[Id[Id[Entry]], Fail] = table.push[Id[Entry]](?el.items.functions, fn.ok);
            if (sel p.err) { ret err[Fail].err{p.err}; }
        }
        i = i + 1;
    }
    ret read.drained(rd);
}

# release the items `el` holds
pub fun release_element(el: *Element) err[Fail] {
    if (sel el.items.functions)   { ret table.release[Id[Entry]](?el.items.functions); }
    or (sel el.items.expressions) { ret table.release[View](?el.items.expressions); }
    ret err[Fail].ok{};
}

# state the `count` exports at `at` of `o`, in the order the export section
# lists them
pub fun exports(o: *Object, ix: *Index, at: *Export, count: usize) err[Fail] {
    var out: Sink      = sink.make(o.a, LITTLE);
    val w:   err[Fail] = exports_bytes(o, ix, ?out, at, count);
    ret alone(o, EXPORTS, 0, ?out, w, true);
}

fun exports_bytes(o: *Object, ix: *Index, out: *Sink, at: *Export, count: usize) err[Fail] {
    val c: err[Fail] = write.leb(out, count::u64, model.SHORTEST);
    if (sel c.err) { ret c; }
    var i: usize = 0;
    for (i < count) {
        val x: *Export   = ?at[i];
        val e: Id[Entry] = x.entry;
        if (e.index::usize >= table.count[Entry](?o.entries)) { ret err[Fail].err{fail.in_indexed(fail.malformed("an export names an entry the object does not hold"), "export", i::u64)}; }
        val sp:   *Space  = table.at[Entry](?o.entries, e).space;
        val kind: opt[u8] = kind_of_space(sp);
        if (sel kind.none) { ret err[Fail].err{fail.in_indexed(fail.about(fail.malformed("an export names an entry of a space a module exports nothing of"), sp.name), "export", i::u64)}; }
        val index: res[u64, Fail] = index_of(o, ix, e, sp);
        if (sel index.err) { ret err[Fail].err{fail.in_indexed(index.err, "export", i::u64)}; }
        val n: err[Fail] = named(out, x.name);
        if (sel n.err) { ret n; }
        val k: err[Fail] = sink.u8(out, kind.some);
        if (sel k.err) { ret k; }
        val w: err[Fail] = write.leb(out, index.ok, model.SHORTEST);
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the exports `o` states, in the order the export section lists them, their
# names in the fact's bytes, none for an object that states no export
# section
pub fun exports_of(o: *Object, ix: *Index) res[opt[Table[Export]], Fail] {
    val f: opt[*Fact] = object.fact(o, ?format.WASM, EXPORTS);
    if (sel f.none) { ret res[opt[Table[Export]], Fail].ok{opt[Table[Export]].none{}}; }
    var rd:  Reader        = reading(o, f.some);
    var got: Table[Export] = table.make[Export](o.a);
    val w:   err[Fail]     = exports_body(o, ix, ?rd, ?got);
    if (sel w.err) {
        val gone: err[Fail] = table.release[Export](?got);
        ret res[opt[Table[Export]], Fail].err{w.err};
    }
    ret res[opt[Table[Export]], Fail].ok{opt[Table[Export]].some{got}};
}

fun exports_body(o: *Object, ix: *Index, rd: *Reader, into: *Table[Export]) err[Fail] {
    val n: res[model.Run, Fail] = read.count(rd);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    var i: usize = 0;
    for (i < n.ok.count) {
        val name: res[View, Fail] = text(rd);
        if (sel name.err) { ret err[Fail].err{fail.in_indexed(name.err, "export", i::u64)}; }
        val kind: res[u8, Fail] = reader.u8(rd);
        if (sel kind.err) { ret err[Fail].err{kind.err}; }
        val sp: opt[*Space] = space_of_kind(kind.ok);
        if (sel sp.none) { ret err[Fail].err{fail.valued(fail.in_indexed(fail.malformed("an export has a kind the specification does not define"), "export", i::u64), kind.ok::i128)}; }
        val index: res[model.Leb, Fail] = read.uleb(rd);
        if (sel index.err) { ret err[Fail].err{index.err}; }
        val e: res[Id[Entry], Fail] = entry_at(o, ix, sp.some, index.ok.value);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "export", i::u64)}; }
        val p: res[Id[Export], Fail] = table.push[Export](into, Export{name: name.ok, entry: e.ok});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret read.drained(rd);
}

# a name: its length and that many bytes, borrowed
fun text(rd: *Reader) res[View, Fail] {
    val len: res[model.Leb, Fail] = read.uleb(rd);
    if (sel len.err) { ret res[View, Fail].err{len.err}; }
    val p: res[*u8, Fail] = reader.bytes(rd, len.ok.value);
    if (sel p.err) { ret res[View, Fail].err{p.err}; }
    ret res[View, Fail].ok{View{data: p.ok, len: len.ok.value::usize}};
}

# state that the function entry `function` of `o` is its start function
pub fun start(o: *Object, ix: *Index, function: Id[Entry]) err[Fail] {
    val index: res[u64, Fail] = index_of(o, ix, function, ?space.FUNCTIONS);
    if (sel index.err) { ret err[Fail].err{index.err}; }
    var out: Sink = sink.make(o.a, LITTLE);
    ret alone(o, START, index.ok, ?out, err[Fail].ok{}, true);
}

# the start function `o` states, none for an object that states none
pub fun start_of(o: *Object, ix: *Index) res[opt[Id[Entry]], Fail] {
    val f: opt[*Fact] = object.fact(o, ?format.WASM, START);
    if (sel f.none) { ret res[opt[Id[Entry]], Fail].ok{opt[Id[Entry]].none{}}; }
    val e: res[Id[Entry], Fail] = entry_at(o, ix, ?space.FUNCTIONS, f.some.value);
    if (sel e.err) { ret res[opt[Id[Entry]], Fail].err{e.err}; }
    ret res[opt[Id[Entry]], Fail].ok{opt[Id[Entry]].some{e.ok}};
}

# state that `o` writes a data count section, of `count` data segments
pub fun data_count(o: *Object, count: u64) err[Fail] {
    var out: Sink = sink.make(o.a, LITTLE);
    ret alone(o, DATACOUNT, count, ?out, err[Fail].ok{}, true);
}

# the data count `o` states, none for an object that writes no data count
# section
pub fun data_count_of(o: *Object) opt[u64] {
    val f: opt[*Fact] = object.fact(o, ?format.WASM, DATACOUNT);
    if (sel f.none) { ret opt[u64].none{}; }
    ret opt[u64].some{f.some.value};
}

# whether the views `a` and `b` hold the same bytes
fun same(a: View, b: View) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun named(out: *Sink, v: View) err[Fail] {
    val w: err[Fail] = write.leb(out, v.len::u64, model.SHORTEST);
    ret fail.kept(w, sink.bytes(out, v.data, v.len));
}

# state the producers section of `o`: the `count` values at `at`, each
# field's values consecutive
pub fun producers(o: *Object, at: *Produced, count: usize) err[Fail] {
    var fields: u64   = 0;
    var i:      usize = 0;
    for (i < count) {
        if (i == 0 || !same(at[i - 1].field, at[i].field)) { fields = fields + 1; }
        i = i + 1;
    }
    var out: Sink      = sink.make(o.a, LITTLE);
    var w:   err[Fail] = write.leb(?out, fields, model.SHORTEST);
    i = 0;
    for (i < count) {
        var k: usize = i + 1;
        for (k < count && same(at[i].field, at[k].field)) { k = k + 1; }
        w = fail.kept(w, named(?out, at[i].field));
        w = fail.kept(w, write.leb(?out, (k - i)::u64, model.SHORTEST));
        var v: usize = i;
        for (v < k) {
            w = fail.kept(w, named(?out, at[v].name));
            w = fail.kept(w, named(?out, at[v].version));
            v = v + 1;
        }
        i = k;
    }
    ret alone(o, PRODUCERS, 0, ?out, w, true);
}

# the values of the producers section `o` states, each field's consecutive,
# their names in the fact's bytes, none for an object that states none
pub fun producers_of(o: *Object) res[opt[Table[Produced]], Fail] {
    val f: opt[*Fact] = object.fact(o, ?format.WASM, PRODUCERS);
    if (sel f.none) { ret res[opt[Table[Produced]], Fail].ok{opt[Table[Produced]].none{}}; }
    var rd:  Reader          = reading(o, f.some);
    var got: Table[Produced] = table.make[Produced](o.a);
    val w:   err[Fail]       = producers_body(?rd, ?got);
    if (sel w.err) {
        val gone: err[Fail] = table.release[Produced](?got);
        ret res[opt[Table[Produced]], Fail].err{w.err};
    }
    ret res[opt[Table[Produced]], Fail].ok{opt[Table[Produced]].some{got}};
}

fun producers_body(rd: *Reader, into: *Table[Produced]) err[Fail] {
    val n: res[model.Run, Fail] = read.count(rd);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    var i: usize = 0;
    for (i < n.ok.count) {
        val field: res[View, Fail] = text(rd);
        if (sel field.err) { ret err[Fail].err{field.err}; }
        val m: res[model.Run, Fail] = read.count(rd);
        if (sel m.err) { ret err[Fail].err{m.err}; }
        var k: usize = 0;
        for (k < m.ok.count) {
            val name: res[View, Fail] = text(rd);
            if (sel name.err) { ret err[Fail].err{name.err}; }
            val version: res[View, Fail] = text(rd);
            if (sel version.err) { ret err[Fail].err{version.err}; }
            val p: res[Id[Produced], Fail] = table.push[Produced](into, Produced{field: field.ok, name: name.ok, version: version.ok});
            if (sel p.err) { ret err[Fail].err{p.err}; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret read.drained(rd);
}

# add the fact of `key` about no entry, of `value` and holding what `out`
# holds once `w`, its writing, held, then release `out`. a fact `lone` is
# one an object states once. a refusal leaves the object as it was
fun alone(o: *Object, key: u32, value: u64, out: *Sink, w: err[Fail], lone: bool) err[Fail] {
    val r:    err[Fail] = adding(o, key, value, out, w, lone);
    val gone: err[Fail] = sink.release(out);
    if (sel r.err) { ret r; }
    ret gone;
}

fun adding(o: *Object, key: u32, value: u64, out: *Sink, w: err[Fail], lone: bool) err[Fail] {
    if (sel w.err) { ret w; }
    if (lone) {
        val there: opt[*Fact] = object.fact(o, ?format.WASM, key);
        if (sel there.some) { ret err[Fail].err{fail.valued(fail.malformed("a fact an object states once is stated twice"), key::i128)}; }
    }
    ret loose(o, key, value, sink.data(out), sink.len(out));
}

fun loose(o: *Object, key: u32, value: u64, bytes: *u8, n: usize) err[Fail] {
    val room: err[Fail] = table.reserve[Fact](?o.facts, 1);
    if (sel room.err) { ret room; }
    var data: Contents = Contents.zero{0};
    if (n != 0) {
        val held: res[Contents, Fail] = object.own(o, bytes, n);
        if (sel held.err) { ret err[Fail].err{held.err}; }
        data = held.ok;
    }
    val f: res[Id[Fact], Fail] = object.add_fact(o, Fact{format: ?format.WASM, key: key, value: value, data: data});
    if (sel f.err) { ret err[Fail].err{f.err}; }
    ret err[Fail].ok{};
}
