pub val FORMAT:         u32 = 0;
pub val ARCH:           u32 = 1;
pub val ADDRESS_SIZE:   u32 = 2;
pub val VERSION:        u32 = 3;
pub val SECTIONS:       u32 = 4;
pub val SECTION:        u32 = 5;
pub val TYPE:           u32 = 6;
pub val SIZE:           u32 = 7;
pub val OFFSET:         u32 = 8;
pub val NAME:           u32 = 9;
pub val SEGMENTS:       u32 = 10;
pub val SEGMENT:        u32 = 11;
pub val MEMORIES:       u32 = 12;
pub val MEMORY:         u32 = 13;
pub val MIN_PAGES:      u32 = 14;
pub val MAX_PAGES:      u32 = 15;
pub val INIT_FUNCTIONS: u32 = 16;
pub val RELOCATIONS:    u32 = 17;
pub val RELOCATION:     u32 = 18;
pub val SYMBOL:         u32 = 19;
pub val INDEX:          u32 = 20;
pub val ADDEND:         u32 = 21;
pub val SYMBOLS:        u32 = 22;
pub val FLAGS:          u32 = 23;
pub val IMPORT_NAME:    u32 = 24;
pub val IMPORT_MODULE:  u32 = 25;
pub val ELEMENT_INDEX:  u32 = 26;
pub val GLOBAL:         u32 = 27;
pub val REASON:         u32 = 28;
pub val IMPORTS:        u32 = 29;
pub val IMPORT:         u32 = 30;
pub val MODULE:         u32 = 31;
pub val FIELD:          u32 = 32;
pub val KIND:           u32 = 33;
pub val SIG_INDEX:      u32 = 34;
pub val MINIMUM:        u32 = 35;
pub val MAXIMUM:        u32 = 36;
pub val MUTABLE:        u32 = 37;
pub val EXPORTS:        u32 = 38;
pub val EXPORT:         u32 = 39;
pub val START_FUNCTION: u32 = 40;
pub val TYPES:          u32 = 41;
pub val PARAM_TYPES:    u32 = 42;
pub val RETURN_TYPES:   u32 = 43;
pub val FUNCTIONS:      u32 = 44;
pub val FUNCTION:       u32 = 45;
pub val TABLES:         u32 = 46;
pub val TABLE:          u32 = 47;
pub val ELEM_TYPE:      u32 = 48;
pub val GLOBALS:        u32 = 49;
pub val GLOBAL_TYPE:    u32 = 50;
pub val INIT_EXPR:      u32 = 51;
pub val ELEM_SEGMENTS:  u32 = 52;
pub val MODE:           u32 = 53;
pub val TABLE_NUMBER:   u32 = 54;
pub val ELEM_KIND:      u32 = 55;
pub val INIT_EXPRS:     u32 = 56;
pub val LOCALS:         u32 = 57;
pub val LOCAL:          u32 = 58;
pub val COUNT:          u32 = 59;
pub val MEMORY_INDEX:   u32 = 60;
pub val NAMES:          u32 = 61;
pub val SUBSECTION:     u32 = 62;
pub val FIELDS_LIST:    u32 = 63;
pub val VALUES:         u32 = 64;
pub val VALUE:          u32 = 65;
pub val FEATURES:       u32 = 66;
pub val FEATURE:        u32 = 67;
pub val PREFIX:         u32 = 68;
pub val TAGS:           u32 = 69;
pub val TAG:            u32 = 70;
pub val ATTRIBUTE:      u32 = 71;
pub val SUPERTYPES:     u32 = 72;
pub val FORM:           u32 = 73;
pub val REC_GROUP:      u32 = 74;
pub val VALUE_TYPE:     u32 = 75;
pub val SEGMENT_INFO:   u32 = 76;
pub val ALIGNMENT:      u32 = 77;
pub val COMDATS:        u32 = 78;
pub val COMDAT:         u32 = 79;
pub val ENTRIES:        u32 = 80;
pub val ENTRY:          u32 = 81;
pub val PAGE_SIZE:      u32 = 82;
pub val FUNCTION_INDEX: u32 = 83;

pub val FIELD_COUNT: usize   = 84;
pub val FIELDS:      [84]str = [84]str{
    "Format", "Arch", "AddressSize", "Version", "Sections", "Section", "Type", "Size", "Offset", "Name",
    "Segments", "Segment", "Memories", "Memory", "MinPages", "MaxPages", "InitFunctions", "Relocations",
    "Relocation", "Symbol", "Index", "Addend", "Symbols", "Flags", "ImportName", "ImportModule",
    "ElementIndex", "Global", "Reason", "Imports", "Import", "Module", "Field", "Kind", "SigIndex",
    "Minimum", "Maximum", "Mutable", "Exports", "Export", "StartFunction",
    "Types", "ParamTypes", "ReturnTypes", "Functions", "Function", "Tables", "Table", "ElemType", "Globals",
    "GlobalType", "InitExpr", "ElemSegments", "Mode", "TableNumber", "ElemKind", "InitExprs", "Locals",
    "Local", "Count", "MemoryIndex", "Names", "Subsection", "Fields", "Values", "Value", "Features",
    "Feature", "Prefix", "Tags", "Tag", "Attribute", "Supertypes", "Form", "RecGroup", "ValueType",
    "SegmentInfo", "Alignment", "Comdats", "Comdat", "Entries", "Entry", "PageSize", "FunctionIndex",
};

# the format name llvm-readobj prints
val FORMAT_NAME: str = "WASM";

# the prefixes the tables' names carry and llvm-readobj leaves off
val SEC_PREFIX:     usize = 9;
val SYMBOL_PREFIX:  usize = 12;
val TYPE_PREFIX:    usize = 17;
val KIND_PREFIX:    usize = 14;
val VALUE_PREFIX:   usize = 10;
val LIMITS_PREFIX:  usize = 17;
val NAMES_PREFIX:   usize = 11;
val FEATURE_PREFIX: usize = 20;
val COMDAT_PREFIX:  usize = 12;
val TAG_PREFIX:     usize = 19;

# the name of a constant without its table's prefix
fun short(c: *Constant, prefix: usize) str {
    ret ?c.name[prefix];
}

# the name of a row of `s` holding `v`, without `prefix`, none for a value
# no row holds
fun short_of(s: *tables.Set, v: u64, prefix: usize) opt[str] {
    val opt_row: opt[*Constant] = tables.name_of(s, v);
    if (sel opt_row.none) { ret opt[str].none{}; }
    ret opt[str].some{short(opt_row.some, prefix)};
}

pub fun describe(m: *Module, d: *Dumper) {
    format_dump.string(d, FORMAT, FORMAT_NAME::*u8, str_len(FORMAT_NAME));
    var s:         Stated           = model.stated(m);
    val res_found: res[*Arch, Fail] = arch_list.by_code(?s);
    if (sel res_found.err) {
        format_dump.keep(d, res_found.err);
        ret;
    }
    val a: *Arch = res_found.ok;
    format_dump.string(d, ARCH, a.name::*u8, str_len(a.name));
    if (!sel a.pointer.some) {
        format_dump.keep(d, fail.internal("a wasm architecture row states no pointer"));
        ret;
    }
    format_dump.field(d, ADDRESS_SIZE);
    format_dump.decimal_value(d, a.pointer.some.bytes::u64 * 8);
    format_dump.text(d, "bit\n");
    format_dump.hex(d, VERSION, m.version::u64);
    sections(m, d);
    relocations(m, d);
    symbols(m, d);
}

# the dump of a model of this format, for the format's registration
pub fun dump(m: ptr, rows: *row.Registry, d: *Dumper) {
    describe(m::*Module, d);
}

fun sections(m: *Module, d: *Dumper) {
    format_dump.list_begin(d, SECTIONS);
    var i: usize = 0;
    for (i < table.count[Section](?m.sections)) {
        section(m, d, table.at[Section](?m.sections, table.nth[Section](i)));
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the bytes of a custom section's name field, which llvm-readobj leaves out
# of the section's size
fun name_field(m: *Module, s: *Section) u64 {
    if (!model.is_custom(s)) { ret 0; }
    ret s.name.width::u64 + model.name_bytes(m, ?s.name).len::u64;
}

fun section(m: *Module, d: *Dumper, s: *Section) {
    format_dump.begin(d, SECTION);
    format_dump.named(d, TYPE, s.id::u64, short_of(?tables.SEC, s.id::u64, SEC_PREFIX));
    format_dump.decimal(d, SIZE, s.size.value - name_field(m, s));
    format_dump.decimal(d, OFFSET, s.payload);
    if (model.is_custom(s)) {
        val n: Bytes = model.name_bytes(m, ?s.name);
        format_dump.string(d, NAME, n.data, n.len);
    }
    if (sel s.body.types) {
        types(m, d, ?s.body.types);
    }
    or (sel s.body.functions) {
        functions(m, d, ?s.body.functions);
    }
    or (sel s.body.tables) {
        tables_of(m, d, ?s.body.tables);
    }
    or (sel s.body.globals) {
        globals(m, d, ?s.body.globals);
    }
    or (sel s.body.elements) {
        elements(m, d, ?s.body.elements);
    }
    or (sel s.body.code) {
        code(m, d, ?s.body.code);
    }
    or (sel s.body.datacount) {
        format_dump.decimal(d, COUNT, s.body.datacount.value);
    }
    or (sel s.body.tags) {
        tags(m, d, ?s.body.tags);
    }
    or (sel s.body.names) {
        names(m, d, ?s.body.names);
    }
    or (sel s.body.producers) {
        producers(m, d, ?s.body.producers);
    }
    or (sel s.body.features) {
        features(m, d, ?s.body.features);
    }
    or (sel s.body.data) {
        segments(m, d, ?s.body.data);
    }
    or (sel s.body.memories) {
        memories(m, d, ?s.body.memories);
    }
    or (sel s.body.imports) {
        imports(m, d, ?s.body.imports);
    }
    or (sel s.body.exports) {
        exports(m, d, ?s.body.exports);
    }
    or (sel s.body.start) {
        format_dump.decimal(d, START_FUNCTION, s.body.start.value);
    }
    or (sel s.body.linking) {
        format_dump.decimal(d, VERSION, s.body.linking.version.value);
        segment_infos(m, d, ?s.body.linking.subsections);
        init_functions(m, d, ?s.body.linking.subsections);
        comdats(m, d, ?s.body.linking.subsections);
    }
    or (sel s.body.raw) {
        format_dump.reason(d, REASON, ?s.body.raw.why);
    }
    format_dump.end(d);
}

# the data segments: the name the segment info gives each, its size and its
# offset expression
fun segments(m: *Module, d: *Dumper, r: *Run) {
    format_dump.list_begin(d, SEGMENTS);
    var i: usize = 0;
    for (i < r.count) {
        val s: *Segment = ?m.data.data[r.first + i];
        format_dump.begin(d, SEGMENT);
        if (sel m.seginfo.some) {
            val infos: Run = m.seginfo.some;
            if (i < infos.count) {
                val info: *SegmentInfo = ?m.segment_infos.data[infos.first + i];
                val n:    Bytes        = model.name_bytes(m, ?info.name);
                format_dump.string(d, NAME, n.data, n.len);
            }
        }
        format_dump.decimal(d, SIZE, model.bytes(m, ?s.data).len::u64);
        if ((s.flags.value & tables.WASM_DATA_SEGMENT_IS_PASSIVE.value) != 0) {
            format_dump.string(d, MODE, "PASSIVE"::*u8, 7);
        }
        or {
            format_dump.string(d, MODE, "ACTIVE"::*u8, 6);
            format_dump.decimal(d, MEMORY_INDEX, s.memory.value);
            expression(m, d, OFFSET, ?s.offset);
        }
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# a constant expression under `key`: the constant it holds, the global it
# reads, the function it refers to, or `Extended` for any other
fun expression(m: *Module, d: *Dumper, key: u32, e: *Expr) {
    val b: Bytes = model.bytes(m, ?e.bytes);
    if (b.len >= 2) {
        val op:   u64   = b.data[0]::u64;
        val rest: usize = b.len - 1;
        if (op == tables.WASM_OPCODE_I32_CONST.value || op == tables.WASM_OPCODE_I64_CONST.value) {
            val res_signed: res[leb128.Signed, leb128.Error] = leb128.get_signed(?b.data[1], rest);
            if (sel res_signed.ok) {
                val got: leb128.Signed = res_signed.ok;
                if (got.size + 2 == b.len) {
                    format_dump.signed(d, key, got.value);
                    ret;
                }
            }
        }
        if (op == tables.WASM_OPCODE_GLOBAL_GET.value || op == tables.WASM_OPCODE_REF_FUNC.value) {
            val res_unsigned: res[leb128.Unsigned, leb128.Error] = leb128.get_unsigned(?b.data[1], rest);
            if (sel res_unsigned.ok) {
                val got: leb128.Unsigned = res_unsigned.ok;
                if (got.size + 2 == b.len) {
                    var what: u32 = GLOBAL;
                    if (op == tables.WASM_OPCODE_REF_FUNC.value) { what = FUNCTION; }
                    format_dump.list_begin(d, key);
                    format_dump.decimal(d, what, got.value);
                    format_dump.list_end(d);
                    ret;
                }
            }
        }
    }
    format_dump.string(d, key, "Extended"::*u8, 8);
}

fun memories(m: *Module, d: *Dumper, r: *Run) {
    format_dump.list_begin(d, MEMORIES);
    var i: usize = 0;
    for (i < r.count) {
        format_dump.begin(d, MEMORY);
        limits(d, ?m.memories.data[r.first + i], MIN_PAGES, MAX_PAGES);
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the least and, when the flags state one, the most a limit allows, under
# `low` and `high`
fun limits(d: *Dumper, l: *Limits, low: u32, high: u32) {
    if ((l.flags & ~tables.WASM_LIMITS_FLAG_HAS_MAX.value::u8) != 0) {
        set_flags(d, ?tables.LIMITS, l.flags::u64, LIMITS_PREFIX);
    }
    format_dump.decimal(d, low, l.min.value);
    if ((l.flags & tables.WASM_LIMITS_FLAG_HAS_MAX.value::u8) != 0) {
        format_dump.decimal(d, high, l.max.value);
    }
    if ((l.flags & tables.WASM_LIMITS_FLAG_HAS_PAGE_SIZE.value::u8) != 0) {
        format_dump.decimal(d, PAGE_SIZE, l.page.value);
    }
}

# the flags `v` of a row set, each single-bit flag set named without
# `prefix` on its own line
fun set_flags(d: *Dumper, set: *tables.Set, v: u64, prefix: usize) {
    format_dump.valued_list_begin(d, FLAGS, v);
    var i: usize = 0;
    for (i < set.count) {
        val c:   *Constant = set.rows[i];
        val bit: u64       = c.value;
        i = i + 1;
        if (bit == 0 || (bit & (bit - 1)) != 0 || (v & bit) == 0) { cnt; }
        format_dump.item(d, short(c, prefix), bit);
    }
    format_dump.list_end(d);
}

# the imports: the module and the name each is imported by, its kind, and
# what it brings in, a function's type index, a memory's or a table's limits
# or a global's mutability
fun imports(m: *Module, d: *Dumper, r: *Run) {
    format_dump.list_begin(d, IMPORTS);
    var i: usize = 0;
    for (i < r.count) {
        val imp:    *Import = table.at[Import](?m.imports, table.nth[Import](r.first + i));
        val module: Bytes   = model.name_bytes(m, ?imp.module);
        val field:  Bytes   = model.name_bytes(m, ?imp.field);
        format_dump.begin(d, IMPORT);
        format_dump.string(d, MODULE, module.data, module.len);
        format_dump.string(d, FIELD, field.data, field.len);
        format_dump.named(d, KIND, imp.kind::u64, short_of(?tables.EXTERNAL, imp.kind::u64, KIND_PREFIX));
        if (sel imp.desc.function) {
            format_dump.decimal(d, SIG_INDEX, imp.desc.function.value);
        }
        or (sel imp.desc.memory) {
            limits(d, ?imp.desc.memory, MIN_PAGES, MAX_PAGES);
        }
        or (sel imp.desc.table) {
            format_dump.field(d, ELEM_TYPE);
            ref_type(d, ?imp.desc.table.elem);
            format_dump.text(d, "\n");
            limits(d, ?imp.desc.table.limits, MINIMUM, MAXIMUM);
        }
        or (sel imp.desc.global) {
            format_dump.field(d, GLOBAL_TYPE);
            valtype(d, ?imp.desc.global.valtype);
            format_dump.text(d, "\n");
            format_dump.decimal(d, MUTABLE, imp.desc.global.mutable::u64);
        }
        or (sel imp.desc.tag_type) {
            format_dump.decimal(d, ATTRIBUTE, imp.desc.tag_type.attribute::u64);
            format_dump.decimal(d, SIG_INDEX, imp.desc.tag_type.type.value);
        }
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the exports: the name each is exported by, its kind and its index in the
# index space of its kind
fun exports(m: *Module, d: *Dumper, r: *Run) {
    format_dump.list_begin(d, EXPORTS);
    var i: usize = 0;
    for (i < r.count) {
        val x: *Export = ?m.exports.data[r.first + i];
        val n: Bytes   = model.name_bytes(m, ?x.name);
        format_dump.begin(d, EXPORT);
        format_dump.string(d, NAME, n.data, n.len);
        format_dump.named(d, KIND, x.kind::u64, short_of(?tables.EXTERNAL, x.kind::u64, KIND_PREFIX));
        format_dump.decimal(d, INDEX, x.index.value);
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# a value type as one word: a number or vector type by its name, or a
# reference type
fun valtype(d: *Dumper, v: *ValType) {
    if (sel v.number) {
        word(d, ?tables.TYPE, v.number::u64);
        ret;
    }
    ref_type(d, ?v.reference);
}

# a reference type as one word: the name of its abstract heap type where it
# is written as that byte, or its nullability and its heap type
fun ref_type(d: *Dumper, r: *RefType) {
    if (r.short) {
        heap(d, ?r.heap);
        ret;
    }
    if (r.nullable) { format_dump.text(d, "NULLABLE("); }
    or              { format_dump.text(d, "NONNULLABLE("); }
    heap(d, ?r.heap);
    format_dump.text(d, ")");
}

# a heap type: an abstract heap type by its name, or a type by its index
fun heap(d: *Dumper, h: *Heap) {
    if (sel h.abstract) {
        word(d, ?tables.HEAP, h.abstract::u64);
        ret;
    }
    format_dump.decimal_value(d, h.index.value::u64);
}

# the name of the type code `v`, its number where no row names it
fun word(d: *Dumper, s: *tables.Set, v: u64) {
    val opt_name: opt[str] = short_of(s, v, VALUE_PREFIX);
    if (sel opt_name.some) {
        format_dump.text(d, opt_name.some);
        ret;
    }
    format_dump.hex_value(d, v);
}

# the value types of a run of the valtypes table, one line under `key`,
# nothing for none
fun valtype_list(m: *Module, d: *Dumper, key: u32, r: *Run) {
    if (r.count == 0) { ret; }
    format_dump.field(d, key);
    var i: usize = 0;
    for (i < r.count) {
        if (i > 0) { format_dump.text(d, " "); }
        valtype(d, ?m.valtypes.data[r.first + i]);
        i = i + 1;
    }
    format_dump.text(d, "\n");
}

# the type section: each type with its index in the type space, the types of
# a recursion group inside it
fun types(m: *Module, d: *Dumper, r: *Run) {
    format_dump.list_begin(d, TYPES);
    var index: u64   = 0;
    var i:     usize = 0;
    for (i < r.count) {
        val g: *RecType = ?m.recs.data[r.first + i];
        if (g.grouped) { format_dump.list_begin(d, REC_GROUP); }
        var k: usize = 0;
        for (k < g.members.count) {
            sub_type(m, d, index, ?m.types.data[g.members.first + k]);
            index = index + 1;
            k     = k + 1;
        }
        if (g.grouped) { format_dump.list_end(d); }
        i = i + 1;
    }
    format_dump.list_end(d);
}

# one type: its index, the supertypes it declares, its form, and a function's
# parameter and result types or a struct's or an array's fields
fun sub_type(m: *Module, d: *Dumper, index: u64, t: *SubType) {
    format_dump.begin(d, TYPE);
    format_dump.decimal(d, INDEX, index);
    if (t.prefix != 0) {
        format_dump.named(d, PREFIX, t.prefix::u64, short_of(?tables.TYPE, t.prefix::u64, VALUE_PREFIX));
        format_dump.list_begin(d, SUPERTYPES);
        var k: usize = 0;
        for (k < t.supers.count) {
            format_dump.row(d);
            format_dump.decimal_value(d, m.indices.data[t.supers.first + k].value);
            format_dump.text(d, "\n");
            k = k + 1;
        }
        format_dump.list_end(d);
    }
    if (sel t.composite.function) {
        val f: *FuncType = ?t.composite.function;
        format_dump.named(d, FORM, f.form::u64, short_of(?tables.TYPE, f.form::u64, VALUE_PREFIX));
        valtype_list(m, d, PARAM_TYPES, ?f.params);
        valtype_list(m, d, RETURN_TYPES, ?f.results);
    }
    or (sel t.composite.structure) {
        format_dump.named(d, FORM, tables.WASM_TYPE_STRUCT.value, short_of(?tables.TYPE, tables.WASM_TYPE_STRUCT.value, VALUE_PREFIX));
        format_dump.list_begin(d, FIELDS_LIST);
        var k: usize = 0;
        for (k < t.composite.structure.count) {
            field(d, ?m.fields.data[t.composite.structure.first + k]);
            k = k + 1;
        }
        format_dump.list_end(d);
    }
    or (sel t.composite.array) {
        format_dump.named(d, FORM, tables.WASM_TYPE_ARRAY.value, short_of(?tables.TYPE, tables.WASM_TYPE_ARRAY.value, VALUE_PREFIX));
        field(d, ?t.composite.array);
    }
    format_dump.end(d);
}

# a field of a struct or an array: its storage type and its mutability
fun field(d: *Dumper, f: *Field) {
    format_dump.begin(d, FIELD);
    format_dump.field(d, VALUE_TYPE);
    if (sel f.storage.packed) { word(d, ?tables.TYPE, f.storage.packed::u64); }
    or (sel f.storage.value)  { valtype(d, ?f.storage.value); }
    format_dump.text(d, "\n");
    format_dump.decimal(d, MUTABLE, f.mutable::u64);
    format_dump.end(d);
}

# the function section: each function the module defines, its index in the
# function space and the index of its type
fun functions(m: *Module, d: *Dumper, r: *Run) {
    val base: usize = model.imported(m, tables.WASM_EXTERNAL_FUNCTION.value::u8);
    format_dump.list_begin(d, FUNCTIONS);
    var i: usize = 0;
    for (i < r.count) {
        format_dump.begin(d, FUNCTION);
        format_dump.decimal(d, INDEX, (base + i)::u64);
        format_dump.decimal(d, SIG_INDEX, m.functions.data[r.first + i].value);
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the table section: each table the module defines, its index in the table
# space, its element type, its limits and the expression its elements start
# as where it states one
fun tables_of(m: *Module, d: *Dumper, r: *Run) {
    val base: usize = model.imported(m, tables.WASM_EXTERNAL_TABLE.value::u8);
    format_dump.list_begin(d, TABLES);
    var i: usize = 0;
    for (i < r.count) {
        val t: *TableDef = ?m.tables.data[r.first + i];
        format_dump.begin(d, TABLE);
        format_dump.decimal(d, INDEX, (base + i)::u64);
        format_dump.field(d, ELEM_TYPE);
        ref_type(d, ?t.type.elem);
        format_dump.text(d, "\n");
        limits(d, ?t.type.limits, MINIMUM, MAXIMUM);
        if (sel t.init.some) { expression(m, d, INIT_EXPR, ?t.init.some); }
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the global section: each global the module defines, its index in the
# global space, its type, its mutability and its initializer
fun globals(m: *Module, d: *Dumper, r: *Run) {
    val base: usize = model.imported(m, tables.WASM_EXTERNAL_GLOBAL.value::u8);
    format_dump.list_begin(d, GLOBALS);
    var i: usize = 0;
    for (i < r.count) {
        val g: *Global = ?m.globals.data[r.first + i];
        format_dump.begin(d, GLOBAL);
        format_dump.decimal(d, INDEX, (base + i)::u64);
        format_dump.field(d, GLOBAL_TYPE);
        valtype(d, ?g.type.valtype);
        format_dump.text(d, "\n");
        format_dump.decimal(d, MUTABLE, g.type.mutable::u64);
        expression(m, d, INIT_EXPR, ?g.init);
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the element section: each segment's flags and mode, an active segment's
# table and offset, its element kind or type where its flags state one, and
# its items, function indices or expressions
fun elements(m: *Module, d: *Dumper, r: *Run) {
    format_dump.list_begin(d, ELEM_SEGMENTS);
    var i: usize = 0;
    for (i < r.count) {
        val e:     *Element = ?m.elements.data[r.first + i];
        val flags: u64      = e.flags.value;
        format_dump.begin(d, SEGMENT);
        format_dump.hex(d, FLAGS, flags);
        if ((flags & tables.WASM_ELEM_SEGMENT_IS_PASSIVE.value) == 0) {
            format_dump.string(d, MODE, "ACTIVE"::*u8, 6);
            format_dump.decimal(d, TABLE_NUMBER, e.table.value);
            expression(m, d, OFFSET, ?e.offset);
        }
        or ((flags & tables.WASM_ELEM_SEGMENT_IS_DECLARATIVE.value) != 0) {
            format_dump.string(d, MODE, "DECLARATIVE"::*u8, 11);
        }
        or {
            format_dump.string(d, MODE, "PASSIVE"::*u8, 7);
        }
        if (sel e.items.indices) {
            if ((flags & model.ELEM_DESC_MASK) != 0) { format_dump.hex(d, ELEM_KIND, e.kind::u64); }
            format_dump.list_begin(d, FUNCTIONS);
            var k: usize = 0;
            for (k < e.items.indices.count) {
                format_dump.row(d);
                format_dump.decimal_value(d, m.indices.data[e.items.indices.first + k].value);
                format_dump.text(d, "\n");
                k = k + 1;
            }
            format_dump.list_end(d);
        }
        or (sel e.items.exprs) {
            if ((flags & model.ELEM_DESC_MASK) != 0) {
                format_dump.field(d, ELEM_TYPE);
                ref_type(d, ?e.type);
                format_dump.text(d, "\n");
            }
            format_dump.list_begin(d, INIT_EXPRS);
            var k: usize = 0;
            for (k < e.items.exprs.count) {
                expression(m, d, INIT_EXPR, ?m.exprs.data[e.items.exprs.first + k]);
                k = k + 1;
            }
            format_dump.list_end(d);
        }
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the code section: each body's function index, its size and its local
# declarations, without its instructions
fun code(m: *Module, d: *Dumper, r: *Run) {
    val base: usize = model.imported(m, tables.WASM_EXTERNAL_FUNCTION.value::u8);
    format_dump.list_begin(d, FUNCTIONS);
    var i: usize = 0;
    for (i < r.count) {
        val f: *Function = ?m.code.data[r.first + i];
        val b: Bytes     = model.bytes(m, ?f.body);
        format_dump.begin(d, FUNCTION);
        format_dump.decimal(d, INDEX, (base + i)::u64);
        format_dump.decimal(d, SIZE, b.len::u64);
        locals(d, b);
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the local declarations a body opens with, each a count of locals of one
# value type, read as the reader reads a value type. a body whose
# declarations do not read prints why
fun locals(d: *Dumper, b: Bytes) {
    var rd:        Reader         = reader.make("", b.data, b.len, LITTLE);
    val res_count: res[Run, Fail] = read.count(?rd);
    if (sel res_count.err) {
        format_dump.string(d, REASON, res_count.err.text, str_len(res_count.err.text));
        ret;
    }
    if (res_count.ok.count == 0) { ret; }
    format_dump.list_begin(d, LOCALS);
    var i: usize = 0;
    for (i < res_count.ok.count) {
        val res_n: res[Leb, Fail] = read.uleb(?rd);
        if (sel res_n.err) {
            format_dump.string(d, REASON, res_n.err.text, str_len(res_n.err.text));
            brk;
        }
        val res_valtype: res[ValType, Fail] = read.valtype(?rd);
        if (sel res_valtype.err) {
            format_dump.string(d, REASON, res_valtype.err.text, str_len(res_valtype.err.text));
            brk;
        }
        var v: ValType = res_valtype.ok;
        format_dump.begin(d, LOCAL);
        format_dump.decimal(d, COUNT, res_n.ok.value);
        format_dump.field(d, VALUE_TYPE);
        valtype(d, ?v);
        format_dump.text(d, "\n");
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the tag section: each tag's index in the tag space, its attribute and the
# index of its type
fun tags(m: *Module, d: *Dumper, r: *Run) {
    val base: usize = model.imported(m, tables.WASM_EXTERNAL_TAG.value::u8);
    format_dump.list_begin(d, TAGS);
    var i: usize = 0;
    for (i < r.count) {
        val t: *Tag = ?m.tags.data[r.first + i];
        format_dump.begin(d, TAG);
        format_dump.decimal(d, INDEX, (base + i)::u64);
        format_dump.named(d, ATTRIBUTE, t.attribute::u64, short_of(?tables.TAG_ATTRIBUTE, t.attribute::u64, TAG_PREFIX));
        format_dump.decimal(d, SIG_INDEX, t.type.value);
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the name section: each subsection by its type, the module's name, a name
# map of indices and names, or an indirect map of name maps by index
fun names(m: *Module, d: *Dumper, r: *Run) {
    format_dump.list_begin(d, NAMES);
    var i: usize = 0;
    for (i < r.count) {
        val n: *NameSub = ?m.name_subs.data[r.first + i];
        format_dump.begin(d, SUBSECTION);
        format_dump.named(d, TYPE, n.id::u64, short_of(?tables.NAMES, n.id::u64, NAMES_PREFIX));
        if (sel n.body.module) {
            val b: Bytes = model.name_bytes(m, ?n.body.module);
            format_dump.string(d, NAME, b.data, b.len);
        }
        or (sel n.body.map) {
            name_map(m, d, ?n.body.map);
        }
        or (sel n.body.indirect) {
            format_dump.list_begin(d, ENTRIES);
            var k: usize = 0;
            for (k < n.body.indirect.count) {
                val e: *IndirectEntry = ?m.indirects.data[n.body.indirect.first + k];
                format_dump.begin(d, ENTRY);
                format_dump.decimal(d, INDEX, e.index.value);
                name_map(m, d, ?e.names);
                format_dump.end(d);
                k = k + 1;
            }
            format_dump.list_end(d);
        }
        or (sel n.body.raw) {
            format_dump.reason(d, REASON, ?n.body.raw.why);
        }
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# a name map: each index and the name it is given
fun name_map(m: *Module, d: *Dumper, r: *Run) {
    format_dump.list_begin(d, NAMES);
    var i: usize = 0;
    for (i < r.count) {
        val e: *NameEntry = ?m.name_entries.data[r.first + i];
        val b: Bytes      = model.name_bytes(m, ?e.name);
        format_dump.begin(d, NAME);
        format_dump.decimal(d, INDEX, e.index.value);
        format_dump.string(d, NAME, b.data, b.len);
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the producers section: each field and its values, a name and a version
fun producers(m: *Module, d: *Dumper, r: *Run) {
    format_dump.list_begin(d, FIELDS_LIST);
    var i: usize = 0;
    for (i < r.count) {
        val p: *Producer = ?m.producers.data[r.first + i];
        val n: Bytes     = model.name_bytes(m, ?p.name);
        format_dump.begin(d, FIELD);
        format_dump.string(d, NAME, n.data, n.len);
        format_dump.list_begin(d, VALUES);
        var k: usize = 0;
        for (k < p.values.count) {
            val v:       *Versioned = ?m.versioned.data[p.values.first + k];
            val name:    Bytes      = model.name_bytes(m, ?v.name);
            val version: Bytes      = model.name_bytes(m, ?v.version);
            format_dump.begin(d, VALUE);
            format_dump.string(d, NAME, name.data, name.len);
            format_dump.string(d, VERSION, version.data, version.len);
            format_dump.end(d);
            k = k + 1;
        }
        format_dump.list_end(d);
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the target_features section: each feature's prefix and name
fun features(m: *Module, d: *Dumper, r: *Run) {
    format_dump.list_begin(d, FEATURES);
    var i: usize = 0;
    for (i < r.count) {
        val f: *Feature = ?m.features.data[r.first + i];
        val n: Bytes    = model.name_bytes(m, ?f.name);
        format_dump.begin(d, FEATURE);
        format_dump.named(d, PREFIX, f.prefix::u64, short_of(?tables.FEATURE_PREFIX, f.prefix::u64, FEATURE_PREFIX));
        format_dump.string(d, NAME, n.data, n.len);
        format_dump.end(d);
        i = i + 1;
    }
    format_dump.list_end(d);
}

# the segment info of the linking section: each data segment's name, the
# log2 of its alignment and its flags
fun segment_infos(m: *Module, d: *Dumper, subs: *Run) {
    var i: usize = 0;
    for (i < subs.count) {
        val sub: *model.Subsection = ?m.subsections.data[subs.first + i];
        i = i + 1;
        if (!sel sub.body.segments) { cnt; }
        format_dump.list_begin(d, SEGMENT_INFO);
        var k: usize = 0;
        for (k < sub.body.segments.count) {
            val info: *SegmentInfo = ?m.segment_infos.data[sub.body.segments.first + k];
            val n:    Bytes        = model.name_bytes(m, ?info.name);
            format_dump.begin(d, SEGMENT);
            format_dump.string(d, NAME, n.data, n.len);
            format_dump.decimal(d, ALIGNMENT, info.align.value);
            format_dump.hex(d, FLAGS, info.flags.value);
            format_dump.end(d);
            k = k + 1;
        }
        format_dump.list_end(d);
    }
}

# the COMDATs of the linking section: each one's name, flags and members,
# a member's kind and index
fun comdats(m: *Module, d: *Dumper, subs: *Run) {
    var i: usize = 0;
    for (i < subs.count) {
        val sub: *model.Subsection = ?m.subsections.data[subs.first + i];
        i = i + 1;
        if (!sel sub.body.comdats) { cnt; }
        format_dump.list_begin(d, COMDATS);
        var k: usize = 0;
        for (k < sub.body.comdats.count) {
            val c: *Comdat = ?m.comdats.data[sub.body.comdats.first + k];
            val n: Bytes   = model.name_bytes(m, ?c.name);
            format_dump.begin(d, COMDAT);
            format_dump.string(d, NAME, n.data, n.len);
            format_dump.hex(d, FLAGS, c.flags.value);
            format_dump.list_begin(d, ENTRIES);
            var j: usize = 0;
            for (j < c.items.count) {
                val item: *ComdatItem = ?m.comdat_items.data[c.items.first + j];
                format_dump.begin(d, ENTRY);
                format_dump.named(d, KIND, item.kind::u64, short_of(?tables.COMDAT, item.kind::u64, COMDAT_PREFIX));
                format_dump.decimal(d, INDEX, item.index.value);
                format_dump.end(d);
                j = j + 1;
            }
            format_dump.list_end(d);
            format_dump.end(d);
            k = k + 1;
        }
        format_dump.list_end(d);
    }
}

# the init functions of the linking section, each `symbol (priority=N)`
fun init_functions(m: *Module, d: *Dumper, subs: *Run) {
    var i: usize = 0;
    for (i < subs.count) {
        val sub: *model.Subsection = ?m.subsections.data[subs.first + i];
        i = i + 1;
        if (!sel sub.body.inits) { cnt; }
        format_dump.list_begin(d, INIT_FUNCTIONS);
        var k: usize = 0;
        for (k < sub.body.inits.count) {
            val f: *InitFunc = ?m.inits.data[sub.body.inits.first + k];
            format_dump.row(d);
            format_dump.decimal_value(d, f.symbol.value);
            format_dump.text(d, " (priority=");
            format_dump.decimal_value(d, f.priority.value);
            format_dump.text(d, ")\n");
            k = k + 1;
        }
        format_dump.list_end(d);
    }
}

# the name of the section at `index`: a custom section's name, the type
# name of any other, none past the sections
fun section_name(m: *Module, index: u64) opt[Bytes] {
    if (index >= table.count[Section](?m.sections)::u64) { ret opt[Bytes].none{}; }
    val s: *Section = table.at[Section](?m.sections, table.nth[Section](index::usize));
    if (model.is_custom(s)) { ret opt[Bytes].some{model.name_bytes(m, ?s.name)}; }
    val opt_short_of: opt[str] = short_of(?tables.SEC, s.id::u64, SEC_PREFIX);
    if (sel opt_short_of.none) { ret opt[Bytes].none{}; }
    ret opt[Bytes].some{Bytes{data: opt_short_of.some::*u8, len: str_len(opt_short_of.some)}};
}

# every reloc.* section, its records under the section they patch, numbered
# from one as llvm-readobj numbers them
fun relocations(m: *Module, d: *Dumper) {
    var any: bool  = false;
    var i:   usize = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = table.at[Section](?m.sections, table.nth[Section](i));
        if (sel s.body.relocs) { any = true; }
        i = i + 1;
    }
    if (!any) { ret; }
    format_dump.list_begin(d, RELOCATIONS);
    i = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = table.at[Section](?m.sections, table.nth[Section](i));
        i = i + 1;
        if (!sel s.body.relocs) { cnt; }
        format_dump.row(d);
        format_dump.text(d, "Section (");
        format_dump.decimal_value(d, s.body.relocs.section.value + 1);
        format_dump.text(d, ") ");
        val opt_target: opt[Bytes] = section_name(m, s.body.relocs.section.value);
        if (sel opt_target.some) {
            format_dump.raw(d, opt_target.some.data, opt_target.some.len);
        }
        format_dump.text(d, " {\n");
        format_dump.nest(d);
        var k: usize = 0;
        for (k < s.body.relocs.entries.count) {
            relocation(m, d, ?m.relocs.data[s.body.relocs.entries.first + k]);
            k = k + 1;
        }
        format_dump.end(d);
    }
    format_dump.list_end(d);
}

# the symbol a relocation names, none for a type index relocation and for an
# index outside the symbol table
fun reloc_symbol(m: *Module, r: *Reloc) opt[*Symbol] {
    if (r.type::u64 == tables.R_WASM_TYPE_INDEX_LEB.value) { ret opt[*Symbol].none{}; }
    if (!sel m.symtab.some)                                { ret opt[*Symbol].none{}; }
    if (r.index.value >= m.symtab.some.count::u64)         { ret opt[*Symbol].none{}; }
    ret opt[*Symbol].some{table.at[Symbol](?m.symbols, table.nth[Symbol](m.symtab.some.first + r.index.value::usize))};
}

fun relocation(m: *Module, d: *Dumper, r: *Reloc) {
    val opt_row: opt[*tables.Relocation] = tables.reloc_of(?tables.RELOC, r.type::u64);
    if (sel opt_row.none) {
        format_dump.keep(d, fail.valued(fail.internal("a relocation record has a type no row names"), r.type::i128));
        ret;
    }
    format_dump.begin(d, RELOCATION);
    format_dump.named(d, TYPE, r.type::u64, opt[str].some{opt_row.some.name});
    format_dump.hex(d, OFFSET, r.offset.value);
    val opt_sym:  opt[*Symbol] = reloc_symbol(m, r);
    var opt_name: opt[Bytes]   = opt[Bytes].none{};
    if (sel opt_sym.some) { opt_name = model.symbol_name(m, opt_sym.some); }
    if (sel opt_name.some) {
        format_dump.string(d, SYMBOL, opt_name.some.data, opt_name.some.len);
    }
    or {
        format_dump.hex(d, INDEX, r.index.value);
    }
    if (opt_row.some.addend) {
        format_dump.signed(d, ADDEND, r.addend.value);
    }
    format_dump.end(d);
}

fun symbols(m: *Module, d: *Dumper) {
    if (!sel m.symtab.some) { ret; }
    val r: Run = m.symtab.some;
    format_dump.list_begin(d, SYMBOLS);
    var i: usize = 0;
    for (i < r.count) {
        symbol(m, d, table.at[Symbol](?m.symbols, table.nth[Symbol](r.first + i)));
        i = i + 1;
    }
    format_dump.list_end(d);
}

fun symbol(m: *Module, d: *Dumper, s: *Symbol) {
    format_dump.begin(d, SYMBOL);
    val opt_name: opt[Bytes] = model.symbol_name(m, s);
    if (sel opt_name.some) {
        format_dump.string(d, NAME, opt_name.some.data, opt_name.some.len);
    }
    format_dump.named(d, TYPE, s.kind::u64, short_of(?tables.SYMBOL_TYPE, s.kind::u64, TYPE_PREFIX));
    flags(d, s.flags.value);
    val undefined: bool = (s.flags.value & tables.WASM_SYMBOL_UNDEFINED.value) != 0;
    if (undefined) {
        val opt_kind: opt[u8] = model.import_kind(s.kind);
        if (sel opt_kind.some) {
            val opt_imp: opt[*Import] = model.import_of(m, opt_kind.some, s.index.value);
            if (sel opt_imp.some) {
                if (s.named) {
                    val field: Bytes = model.name_bytes(m, ?opt_imp.some.field);
                    format_dump.string(d, IMPORT_NAME, field.data, field.len);
                }
                val module: Bytes = model.name_bytes(m, ?opt_imp.some.module);
                format_dump.string(d, IMPORT_MODULE, module.data, module.len);
            }
        }
    }
    if (model.symbol_indexed(s.kind)) {
        format_dump.hex(d, ELEMENT_INDEX, s.index.value);
    }
    or (!undefined) {
        format_dump.hex(d, OFFSET, s.offset.value);
        format_dump.hex(d, SEGMENT, s.segment.value);
        format_dump.hex(d, SIZE, s.size.value);
    }
    format_dump.end(d);
}

# the flags of a symbol, each single-bit flag set named on its own line
fun flags(d: *Dumper, v: u64) {
    format_dump.valued_list_begin(d, FLAGS, v);
    var i: usize = 0;
    for (i < tables.SYMBOL.count) {
        val c:   *Constant = tables.SYMBOL.rows[i];
        val bit: u64       = c.value;
        i = i + 1;
        if (bit == 0 || (bit & (bit - 1)) != 0 || (v & bit) == 0) { cnt; }
        format_dump.item(d, short(c, SYMBOL_PREFIX), bit);
    }
    format_dump.list_end(d);
}
