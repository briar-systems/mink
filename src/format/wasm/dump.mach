# the text form of a wasm module
#
# the file header, then the sections in file order, then the relocation
# records of every reloc.* section and the symbols of the linking section.
# every record and field takes the name llvm-readobj gives it, so the output
# lines up field by field with what llvm-readobj prints for the same file. a
# value with a name prints its name and its number, from the tables. the dump
# prints what the model holds and decodes nothing the reader did not, so a
# body held raw prints why.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.encoding.leb128;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Stated;
use arch_list:   mink.catalog.arch.list;
use format_dump: mink.format.dump;
use mink.format.dump.Dumper;
use mink.format.wasm.model;
use mink.format.wasm.model.Expr;
use mink.format.wasm.model.Import;
use mink.format.wasm.model.InitFunc;
use mink.format.wasm.model.Limits;
use mink.format.wasm.model.Module;
use mink.format.wasm.model.Reloc;
use mink.format.wasm.model.Run;
use mink.format.wasm.model.Section;
use mink.format.wasm.model.Segment;
use mink.format.wasm.model.SegmentInfo;
use mink.format.wasm.model.Symbol;
use mink.format.wasm.tables;
use mink.format.wasm.tables.Constant;
use mink.reloc.row;

pub val FORMAT:         u32 = 0;
pub val ARCH:           u32 = 1;
pub val ADDRESS_SIZE:   u32 = 2;
pub val VERSION:        u32 = 3;
pub val SECTIONS:       u32 = 4;
pub val SECTION:        u32 = 5;
pub val TYPE:           u32 = 6;
pub val SIZE:           u32 = 7;
pub val OFFSET:         u32 = 8;
pub val NAME:           u32 = 9;
pub val SEGMENTS:       u32 = 10;
pub val SEGMENT:        u32 = 11;
pub val MEMORIES:       u32 = 12;
pub val MEMORY:         u32 = 13;
pub val MIN_PAGES:      u32 = 14;
pub val MAX_PAGES:      u32 = 15;
pub val INIT_FUNCTIONS: u32 = 16;
pub val RELOCATIONS:    u32 = 17;
pub val RELOCATION:     u32 = 18;
pub val SYMBOL:         u32 = 19;
pub val INDEX:          u32 = 20;
pub val ADDEND:         u32 = 21;
pub val SYMBOLS:        u32 = 22;
pub val FLAGS:          u32 = 23;
pub val IMPORT_NAME:    u32 = 24;
pub val IMPORT_MODULE:  u32 = 25;
pub val ELEMENT_INDEX:  u32 = 26;
pub val GLOBAL:         u32 = 27;
pub val REASON:         u32 = 28;

pub val FIELD_COUNT: usize   = 29;
pub val FIELDS:      [29]str = [29]str{
    "Format", "Arch", "AddressSize", "Version", "Sections", "Section", "Type", "Size", "Offset", "Name",
    "Segments", "Segment", "Memories", "Memory", "MinPages", "MaxPages", "InitFunctions", "Relocations",
    "Relocation", "Symbol", "Index", "Addend", "Symbols", "Flags", "ImportName", "ImportModule",
    "ElementIndex", "Global", "Reason",
};

# the format name llvm-readobj prints
val FORMAT_NAME: str = "WASM";

# the prefixes the tables' names carry and llvm-readobj leaves off
val SEC_PREFIX:    usize = 9;
val SYMBOL_PREFIX: usize = 12;
val TYPE_PREFIX:   usize = 17;

# the name of a constant without its table's prefix
fun short(c: *Constant, prefix: usize) str {
    ret ?c.name[prefix];
}

# the name of a row of `s` holding `v`, without `prefix`, none for a value
# no row holds
fun short_of(s: *tables.Set, v: u64, prefix: usize) opt[str] {
    val row: opt[*Constant] = tables.name_of(s, v);
    if (sel row.none) { ret opt[str].none{}; }
    ret opt[str].some{short(row.some, prefix)};
}

pub fun describe(m: *Module, d: *Dumper) {
    format_dump.string(d, FORMAT, FORMAT_NAME::*u8, str_len(FORMAT_NAME));
    var s:     Stated           = model.stated(m);
    val found: res[*Arch, Fail] = arch_list.by_code(?s);
    if (sel found.err) {
        format_dump.keep(d, found.err);
        ret;
    }
    val a: *Arch = found.ok;
    format_dump.string(d, ARCH, a.name::*u8, str_len(a.name));
    if (!sel a.pointer.some) {
        format_dump.keep(d, fail.internal("a wasm architecture row states no pointer"));
        ret;
    }
    format_dump.field(d, ADDRESS_SIZE);
    format_dump.decimal_value(d, a.pointer.some.bytes::u64 * 8);
    format_dump.text(d, "bit\n");
    format_dump.hex(d, VERSION, m.version::u64);
    sections(m, d);
    relocations(m, d);
    symbols(m, d);
}

# the dump of a model of this format, for the format's registration
pub fun dump(m: ptr, rows: *row.Registry, d: *Dumper) {
    describe(m::*Module, d);
}

fun sections(m: *Module, d: *Dumper) {
    format_dump.open_list(d, SECTIONS);
    var i: usize = 0;
    for (i < table.count[Section](?m.sections)) {
        section(m, d, table.at[Section](?m.sections, table.nth[Section](i)));
        i = i + 1;
    }
    format_dump.close_list(d);
}

# the bytes of a custom section's name field, which llvm-readobj leaves out
# of the section's size
fun name_field(m: *Module, s: *Section) u64 {
    if (!model.is_custom(s)) { ret 0; }
    ret s.name.width::u64 + model.name_bytes(m, ?s.name).len::u64;
}

fun section(m: *Module, d: *Dumper, s: *Section) {
    format_dump.open(d, SECTION);
    format_dump.named(d, TYPE, s.id::u64, short_of(?tables.SEC, s.id::u64, SEC_PREFIX));
    format_dump.decimal(d, SIZE, s.size.value - name_field(m, s));
    format_dump.decimal(d, OFFSET, s.payload);
    if (model.is_custom(s)) {
        val n: Bytes = model.name_bytes(m, ?s.name);
        format_dump.string(d, NAME, n.data, n.len);
    }
    if (sel s.body.data) {
        segments(m, d, ?s.body.data);
    }
    or (sel s.body.memories) {
        memories(m, d, ?s.body.memories);
    }
    or (sel s.body.linking) {
        init_functions(m, d, ?s.body.linking.subsections);
    }
    or (sel s.body.raw) {
        format_dump.reason(d, REASON, ?s.body.raw.why);
    }
    format_dump.close(d);
}

# the data segments: the name the segment info gives each, its size and its
# offset expression
fun segments(m: *Module, d: *Dumper, r: *Run) {
    format_dump.open_list(d, SEGMENTS);
    var i: usize = 0;
    for (i < r.count) {
        val s: *Segment = ?m.data.data[r.first + i];
        format_dump.open(d, SEGMENT);
        if (sel m.seginfo.some) {
            val infos: Run = m.seginfo.some;
            if (i < infos.count) {
                val info: *SegmentInfo = ?m.segment_infos.data[infos.first + i];
                val n:    Bytes        = model.name_bytes(m, ?info.name);
                format_dump.string(d, NAME, n.data, n.len);
            }
        }
        format_dump.decimal(d, SIZE, model.bytes(m, ?s.data).len::u64);
        if ((s.flags.value & tables.WASM_DATA_SEGMENT_IS_PASSIVE.value) == 0) {
            offset(m, d, ?s.offset);
        }
        format_dump.close(d);
        i = i + 1;
    }
    format_dump.close_list(d);
}

# an offset expression: the constant it holds, the global it reads, or
# `Extended` for any other
fun offset(m: *Module, d: *Dumper, e: *Expr) {
    val b: Bytes = model.bytes(m, ?e.bytes);
    if (b.len >= 2) {
        val op:   u64   = b.data[0]::u64;
        val rest: usize = b.len - 1;
        if (op == tables.WASM_OPCODE_I32_CONST.value || op == tables.WASM_OPCODE_I64_CONST.value) {
            val v: res[leb128.Signed, leb128.Error] = leb128.get_signed(?b.data[1], rest);
            if (sel v.ok) {
                val got: leb128.Signed = v.ok;
                if (got.size + 2 == b.len) {
                    format_dump.signed(d, OFFSET, got.value);
                    ret;
                }
            }
        }
        if (op == tables.WASM_OPCODE_GLOBAL_GET.value) {
            val v: res[leb128.Unsigned, leb128.Error] = leb128.get_unsigned(?b.data[1], rest);
            if (sel v.ok) {
                val got: leb128.Unsigned = v.ok;
                if (got.size + 2 == b.len) {
                    format_dump.open_list(d, OFFSET);
                    format_dump.decimal(d, GLOBAL, got.value);
                    format_dump.close_list(d);
                    ret;
                }
            }
        }
    }
    format_dump.string(d, OFFSET, "Extended"::*u8, 8);
}

fun memories(m: *Module, d: *Dumper, r: *Run) {
    format_dump.open_list(d, MEMORIES);
    var i: usize = 0;
    for (i < r.count) {
        val l: *Limits = ?m.memories.data[r.first + i];
        format_dump.open(d, MEMORY);
        format_dump.decimal(d, MIN_PAGES, l.min.value);
        if ((l.flags & tables.WASM_LIMITS_FLAG_HAS_MAX.value::u8) != 0) {
            format_dump.decimal(d, MAX_PAGES, l.max.value);
        }
        format_dump.close(d);
        i = i + 1;
    }
    format_dump.close_list(d);
}

# the init functions of the linking section, each `symbol (priority=N)`
fun init_functions(m: *Module, d: *Dumper, subs: *Run) {
    var i: usize = 0;
    for (i < subs.count) {
        val sub: *model.Subsection = ?m.subsections.data[subs.first + i];
        i = i + 1;
        if (!sel sub.body.inits) { cnt; }
        format_dump.open_list(d, INIT_FUNCTIONS);
        var k: usize = 0;
        for (k < sub.body.inits.count) {
            val f: *InitFunc = ?m.inits.data[sub.body.inits.first + k];
            format_dump.row(d);
            format_dump.decimal_value(d, f.symbol.value);
            format_dump.text(d, " (priority=");
            format_dump.decimal_value(d, f.priority.value);
            format_dump.text(d, ")\n");
            k = k + 1;
        }
        format_dump.close_list(d);
    }
}

# the name of the section at `index`: a custom section's name, the type
# name of any other, none past the sections
fun section_name(m: *Module, index: u64) opt[Bytes] {
    if (index >= table.count[Section](?m.sections)::u64) { ret opt[Bytes].none{}; }
    val s: *Section = table.at[Section](?m.sections, table.nth[Section](index::usize));
    if (model.is_custom(s)) { ret opt[Bytes].some{model.name_bytes(m, ?s.name)}; }
    val n: opt[str] = short_of(?tables.SEC, s.id::u64, SEC_PREFIX);
    if (sel n.none) { ret opt[Bytes].none{}; }
    ret opt[Bytes].some{Bytes{data: n.some::*u8, len: str_len(n.some)}};
}

# every reloc.* section, its records under the section they patch, numbered
# from one as llvm-readobj numbers them
fun relocations(m: *Module, d: *Dumper) {
    var any: bool  = false;
    var i:   usize = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = table.at[Section](?m.sections, table.nth[Section](i));
        if (sel s.body.relocs) { any = true; }
        i = i + 1;
    }
    if (!any) { ret; }
    format_dump.open_list(d, RELOCATIONS);
    i = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = table.at[Section](?m.sections, table.nth[Section](i));
        i = i + 1;
        if (!sel s.body.relocs) { cnt; }
        format_dump.row(d);
        format_dump.text(d, "Section (");
        format_dump.decimal_value(d, s.body.relocs.section.value + 1);
        format_dump.text(d, ") ");
        val target: opt[Bytes] = section_name(m, s.body.relocs.section.value);
        if (sel target.some) {
            format_dump.raw(d, target.some.data, target.some.len);
        }
        format_dump.text(d, " {\n");
        format_dump.nest(d);
        var k: usize = 0;
        for (k < s.body.relocs.entries.count) {
            relocation(m, d, ?m.relocs.data[s.body.relocs.entries.first + k]);
            k = k + 1;
        }
        format_dump.close(d);
    }
    format_dump.close_list(d);
}

# the symbol a relocation names, none for a type index relocation and for an
# index outside the symbol table
fun reloc_symbol(m: *Module, r: *Reloc) opt[*Symbol] {
    if (r.type::u64 == tables.R_WASM_TYPE_INDEX_LEB.value) { ret opt[*Symbol].none{}; }
    if (!sel m.symtab.some)                                { ret opt[*Symbol].none{}; }
    if (r.index.value >= m.symtab.some.count::u64)         { ret opt[*Symbol].none{}; }
    ret opt[*Symbol].some{table.at[Symbol](?m.symbols, table.nth[Symbol](m.symtab.some.first + r.index.value::usize))};
}

fun relocation(m: *Module, d: *Dumper, r: *Reloc) {
    val row: opt[*tables.Relocation] = tables.reloc_of(?tables.RELOC, r.type::u64);
    if (sel row.none) {
        format_dump.keep(d, fail.valued(fail.internal("a relocation record has a type no row names"), r.type::i128));
        ret;
    }
    format_dump.open(d, RELOCATION);
    format_dump.named(d, TYPE, r.type::u64, opt[str].some{row.some.name});
    format_dump.hex(d, OFFSET, r.offset.value);
    val sym:  opt[*Symbol] = reloc_symbol(m, r);
    var name: opt[Bytes]   = opt[Bytes].none{};
    if (sel sym.some) { name = model.symbol_name(m, sym.some); }
    if (sel name.some) {
        format_dump.string(d, SYMBOL, name.some.data, name.some.len);
    }
    or {
        format_dump.hex(d, INDEX, r.index.value);
    }
    if (row.some.addend) {
        format_dump.signed(d, ADDEND, r.addend.value);
    }
    format_dump.close(d);
}

fun symbols(m: *Module, d: *Dumper) {
    if (!sel m.symtab.some) { ret; }
    val r: Run = m.symtab.some;
    format_dump.open_list(d, SYMBOLS);
    var i: usize = 0;
    for (i < r.count) {
        symbol(m, d, table.at[Symbol](?m.symbols, table.nth[Symbol](r.first + i)));
        i = i + 1;
    }
    format_dump.close_list(d);
}

fun symbol(m: *Module, d: *Dumper, s: *Symbol) {
    format_dump.open(d, SYMBOL);
    val name: opt[Bytes] = model.symbol_name(m, s);
    if (sel name.some) {
        format_dump.string(d, NAME, name.some.data, name.some.len);
    }
    format_dump.named(d, TYPE, s.kind::u64, short_of(?tables.SYMBOL_TYPE, s.kind::u64, TYPE_PREFIX));
    flags(d, s.flags.value);
    val undefined: bool = (s.flags.value & tables.WASM_SYMBOL_UNDEFINED.value) != 0;
    if (undefined) {
        val kind: opt[u8] = model.import_kind(s.kind);
        if (sel kind.some) {
            val imp: opt[*Import] = model.import_of(m, kind.some, s.index.value);
            if (sel imp.some) {
                if (s.named) {
                    val field: Bytes = model.name_bytes(m, ?imp.some.field);
                    format_dump.string(d, IMPORT_NAME, field.data, field.len);
                }
                val module: Bytes = model.name_bytes(m, ?imp.some.module);
                format_dump.string(d, IMPORT_MODULE, module.data, module.len);
            }
        }
    }
    if (model.symbol_indexed(s.kind)) {
        format_dump.hex(d, ELEMENT_INDEX, s.index.value);
    }
    or (!undefined) {
        format_dump.hex(d, OFFSET, s.offset.value);
        format_dump.hex(d, SEGMENT, s.segment.value);
        format_dump.hex(d, SIZE, s.size.value);
    }
    format_dump.close(d);
}

# the flags of a symbol, each single-bit flag set named on its own line
fun flags(d: *Dumper, v: u64) {
    format_dump.open_valued_list(d, FLAGS, v);
    var i: usize = 0;
    for (i < tables.SYMBOL.count) {
        val c:   *Constant = tables.SYMBOL.rows[i];
        val bit: u64       = c.value;
        i = i + 1;
        if (bit == 0 || (bit & (bit - 1)) != 0 || (v & bit) == 0) { cnt; }
        format_dump.item(d, short(c, SYMBOL_PREFIX), bit);
    }
    format_dump.close_list(d);
}
