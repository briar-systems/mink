# the text form of a wasm module
#
# the file header, then the sections in file order, then the relocation
# records of every reloc.* section and the symbols of the linking section.
# every record and field takes the name llvm-readobj gives it, so the output
# lines up field by field with what llvm-readobj prints for the same file. a
# value with a name prints its name and its number, from the tables. the dump
# prints what the model holds and decodes nothing the reader did not, so a
# body held raw prints why.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;
use std.encoding.leb128;
use std.memory;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use mink.catalog.arch.wasm;
use mink.format.contract.Input;
use format_dump: mink.format.dump;
use mink.format.dump.Dumper;
use mink.format.wasm.fixture;
use mink.format.wasm.model;
use mink.format.wasm.model.Expr;
use mink.format.wasm.model.Import;
use mink.format.wasm.model.InitFunc;
use mink.format.wasm.model.Limits;
use mink.format.wasm.model.Module;
use mink.format.wasm.model.Reloc;
use mink.format.wasm.model.Run;
use mink.format.wasm.model.Section;
use mink.format.wasm.model.Segment;
use mink.format.wasm.model.SegmentInfo;
use mink.format.wasm.model.Symbol;
use mink.format.wasm.read;
use mink.format.wasm.tables;
use mink.format.wasm.tables.Constant;

pub val FORMAT:         u32 = 0;
pub val ARCH:           u32 = 1;
pub val ADDRESS_SIZE:   u32 = 2;
pub val VERSION:        u32 = 3;
pub val SECTIONS:       u32 = 4;
pub val SECTION:        u32 = 5;
pub val TYPE:           u32 = 6;
pub val SIZE:           u32 = 7;
pub val OFFSET:         u32 = 8;
pub val NAME:           u32 = 9;
pub val SEGMENTS:       u32 = 10;
pub val SEGMENT:        u32 = 11;
pub val MEMORIES:       u32 = 12;
pub val MEMORY:         u32 = 13;
pub val MIN_PAGES:      u32 = 14;
pub val MAX_PAGES:      u32 = 15;
pub val INIT_FUNCTIONS: u32 = 16;
pub val RELOCATIONS:    u32 = 17;
pub val RELOCATION:     u32 = 18;
pub val SYMBOL:         u32 = 19;
pub val INDEX:          u32 = 20;
pub val ADDEND:         u32 = 21;
pub val SYMBOLS:        u32 = 22;
pub val FLAGS:          u32 = 23;
pub val IMPORT_NAME:    u32 = 24;
pub val IMPORT_MODULE:  u32 = 25;
pub val ELEMENT_INDEX:  u32 = 26;
pub val GLOBAL:         u32 = 27;
pub val REASON:         u32 = 28;

pub val FIELD_COUNT: usize   = 29;
pub val FIELDS:      [29]str = [29]str{
    "Format", "Arch", "AddressSize", "Version", "Sections", "Section", "Type", "Size", "Offset", "Name",
    "Segments", "Segment", "Memories", "Memory", "MinPages", "MaxPages", "InitFunctions", "Relocations",
    "Relocation", "Symbol", "Index", "Addend", "Symbols", "Flags", "ImportName", "ImportModule",
    "ElementIndex", "Global", "Reason",
};

# the format name llvm-readobj prints
val FORMAT_NAME: str = "WASM";

# the prefixes the tables' names carry and llvm-readobj leaves off
val SEC_PREFIX:    usize = 9;
val SYMBOL_PREFIX: usize = 12;
val TYPE_PREFIX:   usize = 17;

# the name of a constant without its table's prefix
fun short(c: *Constant, prefix: usize) str {
    ret ?c.name[prefix];
}

# the name of a row of `s` holding `v`, without `prefix`, none for a value
# no row holds
fun short_of(s: *tables.Set, v: u64, prefix: usize) opt[str] {
    val row: opt[*Constant] = tables.name_of(s, v);
    if (sel row.none) { ret opt[str].none{}; }
    ret opt[str].some{short(row.some, prefix)};
}

pub fun describe(m: *Module, d: *Dumper) err[Fail] {
    val w1: err[Fail] = format_dump.string(d, FORMAT, FORMAT_NAME::*u8, str_len(FORMAT_NAME));
    if (sel w1.err) { ret w1; }
    var a: *Arch = ?wasm.WASM32;
    if (model.wide(m)) { a = ?wasm.WASM64; }
    val w2: err[Fail] = format_dump.string(d, ARCH, a.name::*u8, str_len(a.name));
    if (sel w2.err)          { ret w2; }
    if (!sel a.pointer.some) { ret err[Fail].err{fail.internal("a wasm architecture row states no pointer")}; }
    val w3: err[Fail] = format_dump.field(d, ADDRESS_SIZE);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.decimal_value(d, a.pointer.some.bytes::u64 * 8);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.text(d, "bit\n");
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.hex(d, VERSION, m.version::u64);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = sections(m, d);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = relocations(m, d);
    if (sel w8.err) { ret w8; }
    ret symbols(m, d);
}

# the dump of a model of this format, for the format's registration
pub fun dump(m: ptr, d: *Dumper) err[Fail] {
    ret describe(m::*Module, d);
}

fun sections(m: *Module, d: *Dumper) err[Fail] {
    val w1: err[Fail] = format_dump.open_list(d, SECTIONS);
    if (sel w1.err) { ret w1; }
    var i: usize = 0;
    for (i < table.count[Section](?m.sections)) {
        val w: err[Fail] = section(m, d, table.at[Section](?m.sections, table.nth[Section](i)));
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret format_dump.close_list(d);
}

# the bytes of a custom section's name field, which llvm-readobj leaves out
# of the section's size
fun name_field(m: *Module, s: *Section) u64 {
    if (!model.is_custom(s)) { ret 0; }
    ret s.name.width::u64 + model.name_bytes(m, ?s.name).len::u64;
}

fun section(m: *Module, d: *Dumper, s: *Section) err[Fail] {
    val w1: err[Fail] = format_dump.open(d, SECTION);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = format_dump.named(d, TYPE, s.id::u64, short_of(?tables.SEC, s.id::u64, SEC_PREFIX));
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.decimal(d, SIZE, s.size.value - name_field(m, s));
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.decimal(d, OFFSET, s.payload);
    if (sel w4.err) { ret w4; }
    if (model.is_custom(s)) {
        val n:  Bytes     = model.name_bytes(m, ?s.name);
        val w5: err[Fail] = format_dump.string(d, NAME, n.data, n.len);
        if (sel w5.err) { ret w5; }
    }
    if (sel s.body.data) {
        val w6: err[Fail] = segments(m, d, ?s.body.data);
        if (sel w6.err) { ret w6; }
    }
    or (sel s.body.memories) {
        val w7: err[Fail] = memories(m, d, ?s.body.memories);
        if (sel w7.err) { ret w7; }
    }
    or (sel s.body.linking) {
        val w8: err[Fail] = init_functions(m, d, ?s.body.linking.subsections);
        if (sel w8.err) { ret w8; }
    }
    or (sel s.body.raw) {
        val w9: err[Fail] = format_dump.reason(d, REASON, ?s.body.raw.why);
        if (sel w9.err) { ret w9; }
    }
    ret format_dump.close(d);
}

# the data segments: the name the segment info gives each, its size and its
# offset expression
fun segments(m: *Module, d: *Dumper, r: *Run) err[Fail] {
    val w1: err[Fail] = format_dump.open_list(d, SEGMENTS);
    if (sel w1.err) { ret w1; }
    var i: usize = 0;
    for (i < r.count) {
        val s:  *Segment  = table.at[Segment](?m.data, table.nth[Segment](r.first + i));
        val w2: err[Fail] = format_dump.open(d, SEGMENT);
        if (sel w2.err) { ret w2; }
        if (sel m.seginfo.some) {
            val infos: Run = m.seginfo.some;
            if (i < infos.count) {
                val info: *SegmentInfo = table.at[SegmentInfo](?m.segment_infos, table.nth[SegmentInfo](infos.first + i));
                val n:    Bytes        = model.name_bytes(m, ?info.name);
                val w3:   err[Fail]    = format_dump.string(d, NAME, n.data, n.len);
                if (sel w3.err) { ret w3; }
            }
        }
        val w4: err[Fail] = format_dump.decimal(d, SIZE, model.bytes(m, ?s.data).len::u64);
        if (sel w4.err) { ret w4; }
        if ((s.flags.value & tables.WASM_DATA_SEGMENT_IS_PASSIVE.value) == 0) {
            val w5: err[Fail] = offset(m, d, ?s.offset);
            if (sel w5.err) { ret w5; }
        }
        val w6: err[Fail] = format_dump.close(d);
        if (sel w6.err) { ret w6; }
        i = i + 1;
    }
    ret format_dump.close_list(d);
}

# an offset expression: the constant it holds, the global it reads, or
# `Extended` for any other
fun offset(m: *Module, d: *Dumper, e: *Expr) err[Fail] {
    val b: Bytes = model.bytes(m, ?e.bytes);
    if (b.len >= 2) {
        val op:   u64   = b.data[0]::u64;
        val rest: usize = b.len - 1;
        if (op == tables.WASM_OPCODE_I32_CONST.value || op == tables.WASM_OPCODE_I64_CONST.value) {
            val v: res[leb128.Signed, leb128.Error] = leb128.get_signed(?b.data[1], rest);
            if (sel v.ok) {
                val got: leb128.Signed = v.ok;
                if (got.size + 2 == b.len) { ret format_dump.signed(d, OFFSET, got.value); }
            }
        }
        if (op == tables.WASM_OPCODE_GLOBAL_GET.value) {
            val v: res[leb128.Unsigned, leb128.Error] = leb128.get_unsigned(?b.data[1], rest);
            if (sel v.ok) {
                val got: leb128.Unsigned = v.ok;
                if (got.size + 2 == b.len) {
                    val w1: err[Fail] = format_dump.open_list(d, OFFSET);
                    if (sel w1.err) { ret w1; }
                    val w2: err[Fail] = format_dump.decimal(d, GLOBAL, got.value);
                    if (sel w2.err) { ret w2; }
                    ret format_dump.close_list(d);
                }
            }
        }
    }
    ret format_dump.string(d, OFFSET, "Extended"::*u8, 8);
}

fun memories(m: *Module, d: *Dumper, r: *Run) err[Fail] {
    val w1: err[Fail] = format_dump.open_list(d, MEMORIES);
    if (sel w1.err) { ret w1; }
    var i: usize = 0;
    for (i < r.count) {
        val l:  *Limits   = table.at[Limits](?m.memories, table.nth[Limits](r.first + i));
        val w2: err[Fail] = format_dump.open(d, MEMORY);
        if (sel w2.err) { ret w2; }
        val w3: err[Fail] = format_dump.decimal(d, MIN_PAGES, l.min.value);
        if (sel w3.err) { ret w3; }
        if ((l.flags & tables.WASM_LIMITS_FLAG_HAS_MAX.value::u8) != 0) {
            val w4: err[Fail] = format_dump.decimal(d, MAX_PAGES, l.max.value);
            if (sel w4.err) { ret w4; }
        }
        val w5: err[Fail] = format_dump.close(d);
        if (sel w5.err) { ret w5; }
        i = i + 1;
    }
    ret format_dump.close_list(d);
}

# the init functions of the linking section, each `symbol (priority=N)`
fun init_functions(m: *Module, d: *Dumper, subs: *Run) err[Fail] {
    var i: usize = 0;
    for (i < subs.count) {
        val sub: *model.Subsection = table.at[model.Subsection](?m.subsections, table.nth[model.Subsection](subs.first + i));
        i = i + 1;
        if (!sel sub.body.inits) { cnt; }
        val w1: err[Fail] = format_dump.open_list(d, INIT_FUNCTIONS);
        if (sel w1.err) { ret w1; }
        var k: usize = 0;
        for (k < sub.body.inits.count) {
            val f:  *InitFunc = table.at[InitFunc](?m.inits, table.nth[InitFunc](sub.body.inits.first + k));
            val w2: err[Fail] = format_dump.row(d);
            if (sel w2.err) { ret w2; }
            val w3: err[Fail] = format_dump.decimal_value(d, f.symbol.value);
            if (sel w3.err) { ret w3; }
            val w4: err[Fail] = format_dump.text(d, " (priority=");
            if (sel w4.err) { ret w4; }
            val w5: err[Fail] = format_dump.decimal_value(d, f.priority.value);
            if (sel w5.err) { ret w5; }
            val w6: err[Fail] = format_dump.text(d, ")\n");
            if (sel w6.err) { ret w6; }
            k = k + 1;
        }
        val w7: err[Fail] = format_dump.close_list(d);
        if (sel w7.err) { ret w7; }
    }
    ret err[Fail].ok{};
}

# the name of the section at `index`: a custom section's name, the type
# name of any other, none past the sections
fun section_name(m: *Module, index: u64) opt[Bytes] {
    if (index >= table.count[Section](?m.sections)::u64) { ret opt[Bytes].none{}; }
    val s: *Section = table.at[Section](?m.sections, table.nth[Section](index::usize));
    if (model.is_custom(s)) { ret opt[Bytes].some{model.name_bytes(m, ?s.name)}; }
    val n: opt[str] = short_of(?tables.SEC, s.id::u64, SEC_PREFIX);
    if (sel n.none) { ret opt[Bytes].none{}; }
    ret opt[Bytes].some{Bytes{data: n.some::*u8, len: str_len(n.some)}};
}

# every reloc.* section, its records under the section they patch, numbered
# from one as llvm-readobj numbers them
fun relocations(m: *Module, d: *Dumper) err[Fail] {
    var any: bool  = false;
    var i:   usize = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = table.at[Section](?m.sections, table.nth[Section](i));
        if (sel s.body.relocs) { any = true; }
        i = i + 1;
    }
    if (!any) { ret err[Fail].ok{}; }
    val w1: err[Fail] = format_dump.open_list(d, RELOCATIONS);
    if (sel w1.err) { ret w1; }
    i = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = table.at[Section](?m.sections, table.nth[Section](i));
        i = i + 1;
        if (!sel s.body.relocs) { cnt; }
        val w2: err[Fail] = format_dump.row(d);
        if (sel w2.err) { ret w2; }
        val w3: err[Fail] = format_dump.text(d, "Section (");
        if (sel w3.err) { ret w3; }
        val w4: err[Fail] = format_dump.decimal_value(d, s.body.relocs.section.value + 1);
        if (sel w4.err) { ret w4; }
        val w5: err[Fail] = format_dump.text(d, ") ");
        if (sel w5.err) { ret w5; }
        val target: opt[Bytes] = section_name(m, s.body.relocs.section.value);
        if (sel target.some) {
            val w6: err[Fail] = format_dump.raw(d, target.some.data, target.some.len);
            if (sel w6.err) { ret w6; }
        }
        val w7: err[Fail] = format_dump.text(d, " {\n");
        if (sel w7.err) { ret w7; }
        format_dump.nest(d);
        var k: usize = 0;
        for (k < s.body.relocs.entries.count) {
            val w8: err[Fail] = relocation(m, d, table.at[Reloc](?m.relocs, table.nth[Reloc](s.body.relocs.entries.first + k)));
            if (sel w8.err) { ret w8; }
            k = k + 1;
        }
        val w9: err[Fail] = format_dump.close(d);
        if (sel w9.err) { ret w9; }
    }
    ret format_dump.close_list(d);
}

# the symbol a relocation names, none for a type index relocation and for an
# index outside the symbol table
fun reloc_symbol(m: *Module, r: *Reloc) opt[*Symbol] {
    if (r.type::u64 == tables.R_WASM_TYPE_INDEX_LEB.value) { ret opt[*Symbol].none{}; }
    if (!sel m.symtab.some)                                { ret opt[*Symbol].none{}; }
    if (r.index.value >= m.symtab.some.count::u64)         { ret opt[*Symbol].none{}; }
    ret opt[*Symbol].some{table.at[Symbol](?m.symbols, table.nth[Symbol](m.symtab.some.first + r.index.value::usize))};
}

fun relocation(m: *Module, d: *Dumper, r: *Reloc) err[Fail] {
    val row: opt[*tables.Relocation] = tables.reloc_of(?tables.RELOC, r.type::u64);
    if (sel row.none) { ret err[Fail].err{fail.valued(fail.internal("a relocation record has a type no row names"), r.type::i128)}; }
    val w1: err[Fail] = format_dump.open(d, RELOCATION);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = format_dump.named(d, TYPE, r.type::u64, opt[str].some{row.some.name});
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.hex(d, OFFSET, r.offset.value);
    if (sel w3.err) { ret w3; }
    val sym:  opt[*Symbol] = reloc_symbol(m, r);
    var name: opt[Bytes]   = opt[Bytes].none{};
    if (sel sym.some) { name = model.symbol_name(m, sym.some); }
    if (sel name.some) {
        val w4: err[Fail] = format_dump.string(d, SYMBOL, name.some.data, name.some.len);
        if (sel w4.err) { ret w4; }
    }
    or {
        val w5: err[Fail] = format_dump.hex(d, INDEX, r.index.value);
        if (sel w5.err) { ret w5; }
    }
    if (row.some.addend) {
        val w6: err[Fail] = format_dump.signed(d, ADDEND, r.addend.value);
        if (sel w6.err) { ret w6; }
    }
    ret format_dump.close(d);
}

fun symbols(m: *Module, d: *Dumper) err[Fail] {
    if (!sel m.symtab.some) { ret err[Fail].ok{}; }
    val r:  Run       = m.symtab.some;
    val w1: err[Fail] = format_dump.open_list(d, SYMBOLS);
    if (sel w1.err) { ret w1; }
    var i: usize = 0;
    for (i < r.count) {
        val w: err[Fail] = symbol(m, d, table.at[Symbol](?m.symbols, table.nth[Symbol](r.first + i)));
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret format_dump.close_list(d);
}

fun symbol(m: *Module, d: *Dumper, s: *Symbol) err[Fail] {
    val w1: err[Fail] = format_dump.open(d, SYMBOL);
    if (sel w1.err) { ret w1; }
    val name: opt[Bytes] = model.symbol_name(m, s);
    if (sel name.some) {
        val w2: err[Fail] = format_dump.string(d, NAME, name.some.data, name.some.len);
        if (sel w2.err) { ret w2; }
    }
    val w3: err[Fail] = format_dump.named(d, TYPE, s.kind::u64, short_of(?tables.SYMBOL_TYPE, s.kind::u64, TYPE_PREFIX));
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = flags(d, s.flags.value);
    if (sel w4.err) { ret w4; }
    val undefined: bool = (s.flags.value & tables.WASM_SYMBOL_UNDEFINED.value) != 0;
    if (undefined) {
        val kind: opt[u8] = model.import_kind(s.kind);
        if (sel kind.some) {
            val imp: opt[*Import] = model.import_of(m, kind.some, s.index.value);
            if (sel imp.some) {
                if (s.named) {
                    val field: Bytes     = model.name_bytes(m, ?imp.some.field);
                    val w5:    err[Fail] = format_dump.string(d, IMPORT_NAME, field.data, field.len);
                    if (sel w5.err) { ret w5; }
                }
                val module: Bytes     = model.name_bytes(m, ?imp.some.module);
                val w6:     err[Fail] = format_dump.string(d, IMPORT_MODULE, module.data, module.len);
                if (sel w6.err) { ret w6; }
            }
        }
    }
    if (model.symbol_indexed(s.kind)) {
        val w7: err[Fail] = format_dump.hex(d, ELEMENT_INDEX, s.index.value);
        if (sel w7.err) { ret w7; }
    }
    or (!undefined) {
        val w8: err[Fail] = format_dump.hex(d, OFFSET, s.offset.value);
        if (sel w8.err) { ret w8; }
        val w9: err[Fail] = format_dump.hex(d, SEGMENT, s.segment.value);
        if (sel w9.err) { ret w9; }
        val w10: err[Fail] = format_dump.hex(d, SIZE, s.size.value);
        if (sel w10.err) { ret w10; }
    }
    ret format_dump.close(d);
}

# the flags of a symbol, each single-bit flag set named on its own line
fun flags(d: *Dumper, v: u64) err[Fail] {
    val w1: err[Fail] = format_dump.open_valued_list(d, FLAGS, v);
    if (sel w1.err) { ret w1; }
    var i: usize = 0;
    for (i < tables.SYMBOL.count) {
        val c:   *Constant = tables.SYMBOL.rows[i];
        val bit: u64       = c.value;
        i = i + 1;
        if (bit == 0 || (bit & (bit - 1)) != 0 || (v & bit) == 0) { cnt; }
        val w2: err[Fail] = format_dump.item(d, short(c, SYMBOL_PREFIX), bit);
        if (sel w2.err) { ret w2; }
    }
    ret format_dump.close_list(d);
}

test dump__prints_the_header_and_sections_in_readobj_names {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:   *A.Allocator = T.allocator_of(?t);
    var out: Sink         = sink.make(a, LITTLE);
    val b:   err[Fail]    = fixture.object(?out);
    if (sel b.err) { ret 1; }
    var in: Input             = Input{file: "a.o", data: sink.data(?out), len: sink.len(?out)};
    var m:  res[Module, Fail] = read.read(a, ?in);
    if (sel m.err) { ret 2; }
    var text: Sink      = sink.make(a, LITTLE);
    var d:    Dumper    = format_dump.make(?text, ?FIELDS[0], FIELD_COUNT);
    val w:    err[Fail] = describe(?m.ok, ?d);
    if (sel w.err) { ret 3; }
    val head: str   = "Format: WASM\nArch: wasm32\nAddressSize: 32bit\nVersion: 0x1\nSections [\n  Section {\n    Type: TYPE (0x1)\n    Size: 6\n    Offset: 14\n  }\n";
    val n:    usize = str_len(head);
    if (sink.len(?text) < n)                                    { ret 4; }
    if (!memory.raw_equal(sink.data(?text)::ptr, head::ptr, n)) { ret 4; }
    val reloc: str = "  Section (5) CODE {\n    Relocation {\n      Type: R_WASM_MEMORY_ADDR_LEB (0x3)\n      Offset: 0x3\n      Symbol: d\n      Addend: 0\n    }\n  }\n";
    if (!contains(?text, reloc)) { ret 5; }
    val sym: str = "  Symbol {\n    Name: ext_call\n    Type: FUNCTION (0x0)\n    Flags [ (0x10)\n      UNDEFINED (0x10)\n    ]\n    ImportModule: env\n    ElementIndex: 0x0\n  }\n";
    if (!contains(?text, sym)) { ret 6; }
    val r1: err[Fail] = model.release(?m.ok);
    val r2: err[Fail] = sink.release(?text);
    val r3: err[Fail] = sink.release(?out);
    if (sel r1.err || sel r2.err || sel r3.err) { ret 7; }
    if (T.live_count(?t) != 0)                  { ret 7; }
    T.dnit(?t);
    ret 0;
}

# whether the text of `s` holds `want`
fun contains(s: *Sink, want: str) bool {
    val n:    usize = str_len(want);
    val len:  usize = sink.len(s);
    val data: *u8   = sink.data(s);
    if (n > len) { ret false; }
    var i: usize = 0;
    for (i + n <= len) {
        if (memory.raw_equal((?data[i])::ptr, want::ptr, n)) { ret true; }
        i = i + 1;
    }
    ret false;
}
