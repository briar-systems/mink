# the text form of a wasm module
#
# the file header, then the sections in file order, each with the entries the
# reader decoded: types, imports, functions, tables, memories, globals,
# exports, the start function, element segments, each function body's size
# and local declarations, data segments, tags, and the name, producers,
# target_features and linking sections' entries. then the relocation records
# of every reloc.* section and the symbols of the linking section. every
# record and field takes the name llvm-readobj gives it, so the output lines
# up field by field with what llvm-readobj prints for the same file, and the
# entries llvm-readobj leaves out take the names LLVM's object model gives
# them: an import its Module, Field and Kind, an export its Name, Kind and
# Index, a type its ParamTypes and ReturnTypes. a value type prints as the
# one word of its name, and a value with a name prints its name and its
# number, from the tables. the dump prints what the model holds: a body's
# instructions are not disassembled, its local declarations read as the
# reader reads a value type, and a constant expression prints the one value
# or index it holds or `Extended`. a body held raw prints why.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.encoding.leb128;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.bytes.reader;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Reader;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Stated;
use arch_list:   mink.catalog.arch.list;
use format_dump: mink.format.dump;
use mink.format.dump.Dumper;
use mink.format.wasm.model;
use mink.format.wasm.model.Comdat;
use mink.format.wasm.model.ComdatItem;
use mink.format.wasm.model.Element;
use mink.format.wasm.model.Export;
use mink.format.wasm.model.Expr;
use mink.format.wasm.model.Feature;
use mink.format.wasm.model.Field;
use mink.format.wasm.model.FuncType;
use mink.format.wasm.model.Function;
use mink.format.wasm.model.Global;
use mink.format.wasm.model.Heap;
use mink.format.wasm.model.Import;
use mink.format.wasm.model.IndirectEntry;
use mink.format.wasm.model.InitFunc;
use mink.format.wasm.model.Leb;
