# how wasm lays an image out
#
# the data segments take their addresses in linear memory, which holds every
# loaded section. function bodies and custom sections are laid out too, but
# no segment loads them, so only their bytes matter.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail.Fail;
use mink.base.rule.Axis;
use mink.format.layout.Class;
use mink.format.layout.Load;
use mink.format.layout.Opening;
use mink.format.layout.Rules;
use mink.format.wasm.neutral;
use mink.model.section;

# the names an input section merges into
val STEM_COUNT: usize           = 6;
val STEMS:      [STEM_COUNT]str = [STEM_COUNT]str{".text", ".rodata", ".data", ".bss", ".tdata", ".tbss"};

# linear memory, which holds every loaded section
val MEMORY: Load = Load{name: "memory", flags: section.ALLOC | section.WRITE};

val THREAD:  section.Flags = section.ALLOC | section.TLS;
val WRITTEN: section.Flags = section.ALLOC | section.WRITE;

val CLASS_COUNT: usize              = 7;
val CLASSES:     [CLASS_COUNT]Class = [CLASS_COUNT]Class{
    Class{name: "code", rank: 0, flags: Axis{need: section.ALLOC | section.EXEC}, load: opt[*Load].none{}},
    Class{name: "rodata", rank: 1, flags: Axis{need: section.ALLOC, deny: section.WRITE | section.EXEC | section.TLS}, load: opt[*Load].some{?MEMORY}},
    Class{name: "tdata", rank: 2, flags: Axis{need: THREAD, deny: section.EXEC}, roles: Axis{need: section.BITS}, load: opt[*Load].some{?MEMORY}},
    Class{name: "tbss", rank: 3, flags: Axis{need: THREAD, deny: section.EXEC}, roles: Axis{deny: section.BITS}, load: opt[*Load].some{?MEMORY}},
    Class{name: "data", rank: 4, flags: Axis{need: WRITTEN, deny: section.EXEC | section.TLS}, roles: Axis{need: section.BITS}, load: opt[*Load].some{?MEMORY}},
    Class{name: "bss", rank: 5, flags: Axis{need: WRITTEN, deny: section.EXEC | section.TLS}, roles: Axis{deny: section.BITS}, load: opt[*Load].some{?MEMORY}},
    Class{name: "unloaded", rank: 6, flags: Axis{deny: section.ALLOC}, load: opt[*Load].none{}},
};

# the name a section of key `k` that states none merges into: the code for a
# function body, and a data segment's name otherwise
fun section_name(k: section.Key) res[str, Fail] {
    if (k.kind == ?section.TEXT) { ret res[str, Fail].ok{".text"}; }
    ret neutral.segment_name(k);
}

# no loader maps a wasm module, so a file offset means nothing and nothing
# aligns one
pub val LAYOUT: Rules = Rules{
    name:          "wasm",
    stems:         ?STEMS[0],
    stem_count:    STEM_COUNT,
    joint:         '.',
    cut:           0,
    classes:       ?CLASSES[0],
    class_count:   CLASS_COUNT,
    commons:       ".bss",
    opens:         Opening.none{},
    section_align: 1,
    file_align:    1,
    sections:      opt[u64].none{},
    naming:        section_name,
};
