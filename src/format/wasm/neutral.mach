# the width a section size and a linking subsection size are written in
val PADDED: u8 = 5;

# the separator of the target features set
val COMMA: u8 = ',';

# the custom sections the conventions consume, which are no neutral section
val LINKING_NAME:  str = "linking";
val RELOC_PREFIX:  str = "reloc.";
val PRODUCER_NAME: str = "producers";
val FEATURES_NAME: str = "target_features";
val DEBUG_FAMILY:  str = ".debug";

# the custom section a line table is written to
val DEBUG_LINE: str = ".debug_line";

# what wasm makes of a symbol's visibility, which its registration names: a
# hidden symbol is not exported from a shared module, a default one is and
# may be preempted there, and the convention states no other. an exported
# symbol is exported to the host apart from its visibility (WebAssembly tool
# conventions, Linking, symbol flags)
val CARRIED_COUNT: usize                             = 2;
val CARRIED:       [CARRIED_COUNT]*symbol.Visibility = [CARRIED_COUNT]*symbol.Visibility{?symbol.DEFAULT, ?symbol.HIDDEN};

pub val WRITTEN_VISIBILITY: symbol.Visibilities = symbol.Visibilities{carried: ?CARRIED[0], count: CARRIED_COUNT, withheld: 0, apart: true};

# the encodings wasm writes a neutral object's records in, which its
# registration names: line records as a DWARF 5 line table in a custom
# section, as the tool conventions' DWARF document places each DWARF section,
# its addresses offsets in the code section. wasm states no frame table, as
# no unwinder walks a machine stack of wasm code
pub val LOWERING: Lowering = Lowering{
    line:  opt[LineForm].some{LineForm.dwarf{DwarfLine{version: 5, section: DEBUG_LINE}}},
    frame: opt[FrameTables].none{},
};

# the kind a data segment of a name takes, by the assembler convention that a
# segment named so, or so and then a dot and more, takes the row's kind
rec Named {
    name: str;
    kind: *section.Kind;
}

val BSS:        Named = Named{name: ".bss", kind: ?section.BSS};
val DATA:       Named = Named{name: ".data", kind: ?section.DATA};
val RELRO:      Named = Named{name: ".data.rel.ro", kind: ?section.RELRO_DATA};
val FINI_ARRAY: Named = Named{name: ".fini_array", kind: ?section.FINI_ARRAY};
val INIT_ARRAY: Named = Named{name: ".init_array", kind: ?section.INIT_ARRAY};
val RODATA:     Named = Named{name: ".rodata", kind: ?section.RODATA};
val TBSS:       Named = Named{name: ".tbss", kind: ?section.TLS_BSS};
val TDATA:      Named = Named{name: ".tdata", kind: ?section.TLS_DATA};

# the rows ascending by name
val NAMED_COUNT: usize               = 8;
val NAMED:       [NAMED_COUNT]*Named = [NAMED_COUNT]*Named{?BSS, ?DATA, ?RELRO, ?FINI_ARRAY, ?INIT_ARRAY, ?RODATA, ?TBSS, ?TDATA};

fun spelling(r: *Named) str {
    ret r.name;
}

# the kind a data segment named `name` takes: the row's where one spells it,
# and data otherwise, as every data segment is writable linear memory and
# the names only refine where the convention lays it out
pub fun segment_kind(name: Bytes) *section.Kind {
    val r: opt[*Named] = contract.spelled[Named](?NAMED[0], NAMED_COUNT, name, '.', spelling);
    if (sel r.none) { ret ?section.DATA; }
    ret r.some.kind;
}

val STRINGS_SOURCE:   str = "clang 23 for wasm32, which writes strings of every width to .rodata segments flagged WASM_SEG_FLAG_STRINGS";
val CONSTANTS_SOURCE: str = "clang 23 for wasm32, whose lowering flags only strings, so a mergeable constant is a plain .rodata segment";

# the keys of merged strings and constants, each a read-only data segment
# that the section's flags mark as strings or not, ascending by key. a
# segment states no element size, so one reads back as read-only data.
# merged pointers have no segment, as no data segment is merged by its
# relocations
val BORROWED_COUNT: usize                           = 7;
val BORROWED:       [BORROWED_COUNT]Borrowed[Named] = [BORROWED_COUNT]Borrowed[Named]{
    Borrowed[Named]{kind: ?section.MERGED_CONSTANTS, entsize: 4, as: ?RODATA, source: CONSTANTS_SOURCE},
    Borrowed[Named]{kind: ?section.MERGED_CONSTANTS, entsize: 8, as: ?RODATA, source: CONSTANTS_SOURCE},
    Borrowed[Named]{kind: ?section.MERGED_CONSTANTS, entsize: 16, as: ?RODATA, source: CONSTANTS_SOURCE},
    Borrowed[Named]{kind: ?section.MERGED_CONSTANTS, entsize: 32, as: ?RODATA, source: CONSTANTS_SOURCE},
    Borrowed[Named]{kind: ?section.MERGED_STRINGS, entsize: 1, as: ?RODATA, source: STRINGS_SOURCE},
    Borrowed[Named]{kind: ?section.MERGED_STRINGS, entsize: 2, as: ?RODATA, source: STRINGS_SOURCE},
    Borrowed[Named]{kind: ?section.MERGED_STRINGS, entsize: 4, as: ?RODATA, source: STRINGS_SOURCE},
};

# the name a data segment of key `k` that states none takes: its kind's row,
# or for a keyed kind the row its borrowed row names
pub fun segment_name(k: section.Key) res[str, Fail] {
    if (section.keyed(k.kind)) {
        val w: opt[*Borrowed[Named]] = contract.borrowed_of[Named](?BORROWED[0], BORROWED_COUNT, k);
        if (sel w.none) { ret res[str, Fail].err{fail.valued(fail.about(fail.unsupported("no data segment holds a section of this kind and element size"), k.kind.name), k.entsize::i128)}; }
        ret res[str, Fail].ok{w.some.as.name};
    }
    var i: usize = 0;
    for (i < NAMED_COUNT) {
        if (NAMED[i].kind == k.kind) { ret res[str, Fail].ok{NAMED[i].name}; }
        i = i + 1;
    }
    ret res[str, Fail].err{fail.about(fail.unsupported("no data segment holds a section of this kind"), k.kind.name)};
}

fun is(n: Bytes, want: str) bool {
    val len: usize = str_len(want);
    ret n.len == len && memory.raw_equal(n.data::ptr, want::ptr, len);
}

fun starts_with(n: Bytes, want: str) bool {
    val len: usize = str_len(want);
    ret n.len >= len && memory.raw_equal(n.data::ptr, want::ptr, len);
}

# the convention that consumes a custom section named `n`, none for one no
# convention consumes
fun consumed(n: Bytes) opt[str] {
    if (is(n, LINKING_NAME))          { ret opt[str].some{LINKING_NAME}; }
    if (starts_with(n, RELOC_PREFIX)) { ret opt[str].some{RELOC_PREFIX}; }
    if (is(n, PRODUCER_NAME))         { ret opt[str].some{PRODUCER_NAME}; }
    if (is(n, FEATURES_NAME))         { ret opt[str].some{FEATURES_NAME}; }
    ret opt[str].none{};
}

# the kind a custom section of a name takes: debugging information for the
# .debug family, metadata otherwise
fun custom_kind(n: Bytes) *section.Kind {
    if (starts_with(n, DEBUG_FAMILY)) { ret ?section.DEBUG_INFO; }
    ret ?section.METADATA;
}

# the file being converted
# ---
# m:         the model
# o:         the object it is added to
# set:       the relocation rows of the module's architecture
# map:       per module section, the neutral section index plus one, or zero
# types:     per type, its entry
# functions: per function of the function space, its entry
# tables, memories, globals, tags: the same per space
# segments: per data segment, its entry
# bodies:   per defined function, its section
# datas:    per data segment, its section
# starts:   per defined function, where its body starts in the code payload
# dstarts:  per data segment, where its bytes start in the data payload
# code:     the module section index of the code section, when it has one
# data:     the module section index of the data section, when it has one
# symbols:  the symbol table's entries among the module's symbols
# syms:     per symbol of the symbol table, its neutral symbol index plus
#           one, or zero for a symbol that anchors the mink note
# holder:   per module section, its index among the holders plus one, or
#           zero for one that holds no mink note
# holders:  the sections that hold the mink note, in module order
# noted:    the records of the reloc sections of the holders
# named:    per symbol of the symbol table, whether a holder's record names
#           it, as one anchoring a field of the note
rec Conv {
    m:         *Module;
    o:         *Object;
    set:       *Lookup;
    map:       Vector[u32];
    types:     Vector[Id[Entry]];
    functions: Vector[Id[Entry]];
    tables:    Vector[Id[Entry]];
    memories:  Vector[Id[Entry]];
    globals:   Vector[Id[Entry]];
    tags:      Vector[Id[Entry]];
    segments:  Vector[Id[Entry]];
    bodies:    Vector[Id[object.Section]];
    datas:     Vector[Id[object.Section]];
    starts:    Vector[u64];
    dstarts:   Vector[u64];
    code:      opt[usize];
    data:      opt[usize];
    symbols:   Run;
    syms:      Vector[u32];
    holder:    Vector[u32];
    holders:   Table[Holder];
    noted:     Vector[Noted];
    named:     Vector[bool];
}

# a section that holds the mink note: its payload, where that starts in the
# file, and its index in the module
rec Holder {
    section: u32;
    data:    Bytes;
    base:    u64;
}

# a record of a reloc section of a holder, and the holder's index among them
rec Noted {
    holder: u32;
    rec:    Reloc;
}

fun make_conv(m: *Module, o: *Object) Conv {
    val a: *A.Allocator = m.a;
    ret Conv{
        m:         m,
        o:         o,
        map:       vector.init[u32](a),
        types:     vector.init[Id[Entry]](a),
        functions: vector.init[Id[Entry]](a),
        tables:    vector.init[Id[Entry]](a),
        memories:  vector.init[Id[Entry]](a),
        globals:   vector.init[Id[Entry]](a),
        tags:      vector.init[Id[Entry]](a),
        segments:  vector.init[Id[Entry]](a),
        bodies:    vector.init[Id[object.Section]](a),
        datas:     vector.init[Id[object.Section]](a),
        starts:    vector.init[u64](a),
        dstarts:   vector.init[u64](a),
        syms:      vector.init[u32](a),
        holder:    vector.init[u32](a),
        holders:   table.make[Holder](a),
        noted:     vector.init[Noted](a),
        named:     vector.init[bool](a),
    };
}

fun release_conv(c: *Conv) err[Fail] {
    var first: err[Fail] = vectors.release[u32](?c.map);
    first = fail.kept(first, vectors.release[Id[Entry]](?c.types));
    first = fail.kept(first, vectors.release[Id[Entry]](?c.functions));
    first = fail.kept(first, vectors.release[Id[Entry]](?c.tables));
    first = fail.kept(first, vectors.release[Id[Entry]](?c.memories));
    first = fail.kept(first, vectors.release[Id[Entry]](?c.globals));
    first = fail.kept(first, vectors.release[Id[Entry]](?c.tags));
    first = fail.kept(first, vectors.release[Id[Entry]](?c.segments));
    first = fail.kept(first, vectors.release[Id[object.Section]](?c.bodies));
    first = fail.kept(first, vectors.release[Id[object.Section]](?c.datas));
    first = fail.kept(first, vectors.release[u64](?c.starts));
    first = fail.kept(first, vectors.release[u64](?c.dstarts));
    first = fail.kept(first, vectors.release[u32](?c.syms));
    first = fail.kept(first, vectors.release[u32](?c.holder));
    first = fail.kept(first, table.release[Holder](?c.holders));
    first = fail.kept(first, vectors.release[Noted](?c.noted));
    ret fail.kept(first, vectors.release[bool](?c.named));
}

# the bytes `h` of the model as the object holds them: borrowed as the model
# borrows them from its input, owned by the object when the model owns them
fun contents(c: *Conv, h: *Held) res[Contents, Fail] {
    if (sel h.borrowed) { ret res[Contents, Fail].ok{Contents.held{@h}}; }
    val b: Bytes = model.bytes(c.m, h);
    ret object.own(c.o, b.data, b.len);
}

# a copy of the bytes of `s`, owned by the object, the sink released
fun owned(c: *Conv, s: *Sink) res[Contents, Fail] {
    val held:  res[Contents, Fail] = object.own(c.o, sink.data(s), sink.len(s));
    val freed: err[Fail]           = sink.release(s);
    if (sel held.err)  { ret held; }
    if (sel freed.err) { ret res[Contents, Fail].err{freed.err}; }
    ret held;
}

fun add_fact(c: *Conv, key: u32, value: u64, data: Contents) err[Fail] {
    val f: res[Id[Fact], Fail] = object.add_fact(c.o, Fact{format: ?format.WASM, key: key, value: value, data: data});
    if (sel f.err) { ret err[Fail].err{f.err}; }
    ret err[Fail].ok{};
}

# a fact whose data is the bytes of `s`
fun add_bytes_fact(c: *Conv, key: u32, value: u64, s: res[Sink, Fail]) err[Fail] {
    if (sel s.err) { ret err[Fail].err{s.err}; }
    var out:  Sink                = s.ok;
    val held: res[Contents, Fail] = owned(c, ?out);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    ret add_fact(c, key, value, held.ok);
}

fun add_entry(c: *Conv, into: *Vector[Id[Entry]], e: Entry) res[Id[Entry], Fail] {
    val id: res[Id[Entry], Fail] = object.add_entry(c.o, e);
    if (sel id.err) { ret id; }
    val p: err[Fail] = vectors.push[Id[Entry]](into, id.ok);
    if (sel p.err) { ret res[Id[Entry], Fail].err{p.err}; }
    ret id;
}

fun name_of(c: *Conv, b: Bytes) res[Id[Name], Fail] {
    ret object.name(c.o, b.data, b.len);
}

# the entries of the type space, each with its fact
fun types_in(c: *Conv) err[Fail] {
    val m: *Module = c.m;
    var i: usize   = 0;
    var n: u64     = 0;
    for (i < vector.length[RecType](?m.recs)) {
        val t: *RecType = ?m.recs.data[i];
        i = i + 1;
        var k: usize = 0;
        for (k < t.members.count) {
            val e: res[Id[Entry], Fail] = add_entry(c, ?c.types, Entry{space: ?space.TYPES});
            if (sel e.err) { ret err[Fail].err{e.err}; }
            val at: Id[Fact]  = table.nth[Fact](table.count[Fact](?c.o.facts));
            val f:  err[Fail] = add_bytes_fact(c, fact.TYPE, e.ok.index::u64, write.stated_type_bytes(m.a, m, t, k));
            if (sel f.err) { ret err[Fail].err{fail.in_indexed(f.err, "type", n)}; }
            table.at[Entry](?c.o.entries, e.ok).stated = opt[Id[Fact]].some{at};
            k                                          = k + 1;
            n                                          = n + 1;
        }
    }
    ret err[Fail].ok{};
}

# the table of entries of the space of import kind `kind`
fun space_of(c: *Conv, kind: u8) res[*Vector[Id[Entry]], Fail] {
    if (kind == tables.WASM_EXTERNAL_FUNCTION.value::u8) { ret res[*Vector[Id[Entry]], Fail].ok{?c.functions}; }
    if (kind == tables.WASM_EXTERNAL_TABLE.value::u8)    { ret res[*Vector[Id[Entry]], Fail].ok{?c.tables}; }
    if (kind == tables.WASM_EXTERNAL_MEMORY.value::u8)   { ret res[*Vector[Id[Entry]], Fail].ok{?c.memories}; }
    if (kind == tables.WASM_EXTERNAL_GLOBAL.value::u8)   { ret res[*Vector[Id[Entry]], Fail].ok{?c.globals}; }
    if (kind == tables.WASM_EXTERNAL_TAG.value::u8)      { ret res[*Vector[Id[Entry]], Fail].ok{?c.tags}; }
    ret res[*Vector[Id[Entry]], Fail].err{fail.valued(fail.malformed("an import has a kind the specification does not define"), kind::i128)};
}

# the neutral space of import kind `kind`
fun neutral_space(kind: u8) *Space {
    if (kind == tables.WASM_EXTERNAL_FUNCTION.value::u8) { ret ?space.FUNCTIONS; }
    if (kind == tables.WASM_EXTERNAL_TABLE.value::u8)    { ret ?space.TABLES; }
    if (kind == tables.WASM_EXTERNAL_MEMORY.value::u8)   { ret ?space.MEMORIES; }
    if (kind == tables.WASM_EXTERNAL_GLOBAL.value::u8)   { ret ?space.GLOBALS; }
    ret ?space.TAGS;
}

# the type entry of type index `index`
fun type_entry(c: *Conv, index: u64) res[Id[Entry], Fail] {
    if (index >= vector.length[Id[Entry]](?c.types)::u64) {
        ret res[Id[Entry], Fail].err{fail.valued(fail.malformed("a type index lies past the type section"), index::i128)};
    }
    ret res[Id[Entry], Fail].ok{c.types.data[index::usize]};
}

# the entries of the imports, in the order the import section lists them
# across the index spaces, each in its kind's space with its type fact. an
# import's place among its kind's imports is its index in that space, so the
# object's entry order states the import order and each space's indices both
fun imports_in(c: *Conv) err[Fail] {
    val m: *Module = c.m;
    var i: usize   = 0;
    for (i < table.count[Import](?m.imports)) {
        val imp:  *Import                       = table.at[Import](?m.imports, table.nth[Import](i));
        val into: res[*Vector[Id[Entry]], Fail] = space_of(c, imp.kind);
        if (sel into.err) { ret err[Fail].err{fail.in_indexed(into.err, "import", i::u64)}; }
        val module: res[Id[Name], Fail] = name_of(c, model.name_bytes(m, ?imp.module));
        if (sel module.err) { ret err[Fail].err{module.err}; }
        val field: res[Id[Name], Fail] = name_of(c, model.name_bytes(m, ?imp.field));
        if (sel field.err) { ret err[Fail].err{field.err}; }
        var e: Entry = Entry{space: neutral_space(imp.kind), import: opt[object.Import].some{object.Import{module: module.ok, field: field.ok}}};
        if (sel imp.desc.function) {
            val t: res[Id[Entry], Fail] = type_entry(c, imp.desc.function.value);
            if (sel t.err) { ret err[Fail].err{fail.in_indexed(t.err, "import", i::u64)}; }
            e.signature = opt[Id[Entry]].some{t.ok};
        }
        val id: res[Id[Entry], Fail] = add_entry(c, into.ok, e);
        if (sel id.err) { ret err[Fail].err{id.err}; }
        if (!sel imp.desc.function) {
            val f: err[Fail] = add_bytes_fact(c, fact.ENTRY_TYPE, id.ok.index::u64, write.desc_bytes(m.a, m, imp));
            if (sel f.err) { ret err[Fail].err{fail.in_indexed(f.err, "import", i::u64)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the definitions of the import kind `kind`, after its imports
fun defined_in(c: *Conv, kind: u8) err[Fail] {
    val m:    *Module                       = c.m;
    val into: res[*Vector[Id[Entry]], Fail] = space_of(c, kind);
    if (sel into.err) { ret err[Fail].err{into.err}; }
    val sp: *Space = neutral_space(kind);
    var i:  usize  = 0;
    for (i < model.defined(m, kind)) {
        var e: Entry = Entry{space: sp};
        if (kind == tables.WASM_EXTERNAL_FUNCTION.value::u8) {
            val t: res[Id[Entry], Fail] = type_entry(c, m.functions.data[i].value);
            if (sel t.err) { ret err[Fail].err{fail.in_indexed(t.err, "function", i::u64)}; }
            e.signature = opt[Id[Entry]].some{t.ok};
        }
        val id: res[Id[Entry], Fail] = add_entry(c, into.ok, e);
        if (sel id.err) { ret err[Fail].err{id.err}; }
        var f: err[Fail] = err[Fail].ok{};
        if (kind == tables.WASM_EXTERNAL_TABLE.value::u8)  { f = add_bytes_fact(c, fact.ENTRY_TYPE, id.ok.index::u64, write.table_bytes(m.a, m, ?m.tables.data[i])); }
        if (kind == tables.WASM_EXTERNAL_MEMORY.value::u8) { f = add_bytes_fact(c, fact.ENTRY_TYPE, id.ok.index::u64, write.limits_bytes(m.a, m, ?m.memories.data[i])); }
        if (kind == tables.WASM_EXTERNAL_GLOBAL.value::u8) { f = add_bytes_fact(c, fact.ENTRY_TYPE, id.ok.index::u64, write.global_bytes(m.a, m, ?m.globals.data[i])); }
        if (kind == tables.WASM_EXTERNAL_TAG.value::u8)    { f = add_bytes_fact(c, fact.ENTRY_TYPE, id.ok.index::u64, write.tag_bytes(m.a, m, ?m.tags.data[i])); }
        if (sel f.err)                                     { ret err[Fail].err{fail.in_indexed(f.err, "definition", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the entries of the data segments, each with its head as a fact
fun segments_in(c: *Conv) err[Fail] {
    val m: *Module = c.m;
    var i: usize   = 0;
    for (i < vector.length[Segment](?m.data)) {
        val id: res[Id[Entry], Fail] = add_entry(c, ?c.segments, Entry{space: ?space.SEGMENTS});
        if (sel id.err) { ret err[Fail].err{id.err}; }
        val f: err[Fail] = add_bytes_fact(c, fact.SEGMENT, id.ok.index::u64, write.segment_head_bytes(m.a, m, ?m.data.data[i]));
        if (sel f.err) { ret err[Fail].err{fail.in_indexed(f.err, "data segment", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun entries_in(c: *Conv) err[Fail] {
    val t: err[Fail] = types_in(c);
    if (sel t.err) { ret t; }
    val im: err[Fail] = imports_in(c);
    if (sel im.err) { ret im; }
    var k: u8 = 0;
    for (k::usize < model.KIND_COUNT) {
        val s: err[Fail] = defined_in(c, k);
        if (sel s.err) { ret s; }
        k = k + 1;
    }
    ret segments_in(c);
}

# the segment info of segment `i`, refused when the linking section states
# none for it
fun info_of(c: *Conv, i: usize) res[*SegmentInfo, Fail] {
    if (sel c.m.seginfo.some) {
        val r: Run = c.m.seginfo.some;
        if (i < r.count) { ret res[*SegmentInfo, Fail].ok{?c.m.segment_infos.data[r.first + i]}; }
    }
    ret res[*SegmentInfo, Fail].err{fail.in_indexed(fail.unsupported("a data segment the linking section states no segment info for has no neutral form"), "data segment", i::u64)};
}

# the neutral flags a segment info states on top of its kind's
fun segment_flags(info: *SegmentInfo) section.Flags {
    var f: section.Flags = 0;
    if ((info.flags.value & tables.WASM_SEG_FLAG_STRINGS.value) != 0) { f = f | section.MERGE | section.STRINGS; }
    if ((info.flags.value & tables.WASM_SEG_FLAG_TLS.value) != 0)     { f = f | section.TLS; }
    if ((info.flags.value & tables.WASM_SEG_FLAG_RETAIN.value) != 0)  { f = f | section.RETAIN; }
    ret f;
}

# how garbage collection treats a section: a retained one is kept, the rest
# kept or dropped as one
fun disposition_of(flags: section.Flags) *section.Disposition {
    if ((flags & section.RETAIN) != 0) { ret ?section.ROOT; }
    ret ?section.WHOLE;
}

# one text section per defined function, its entry's body
fun functions_in(c: *Conv) err[Fail] {
    val m:        *Module = c.m;
    val imported: usize   = model.imported(m, tables.WASM_EXTERNAL_FUNCTION.value::u8);
    val count:    usize   = vector.length[Function](?m.code);
    if (count != vector.length[Leb](?m.functions)) {
        ret err[Fail].err{fail.unsupported("the function and code sections differ in count")};
    }
    var i: usize = 0;
    for (i < count) {
        val f:    *Function           = ?m.code.data[i];
        val held: res[Contents, Fail] = contents(c, ?f.body);
        if (sel held.err) { ret err[Fail].err{held.err}; }
        val s: res[Id[object.Section], Fail] = object.add_section(c.o, object.Section{kind: ?section.TEXT, flags: section.TEXT.flags, align: 1, contents: held.ok, disposition: ?section.WHOLE});
        if (sel s.err) { ret err[Fail].err{s.err}; }
        val p: err[Fail] = vectors.push[Id[object.Section]](?c.bodies, s.ok);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        val entry: Id[Entry] = c.functions.data[imported + i];
        table.at[Entry](?c.o.entries, entry).body = opt[Place].some{Place{section: s.ok, offset: 0}};
        i                                         = i + 1;
    }
    ret err[Fail].ok{};
}

# one section per data segment, its entry's body
fun data_in(c: *Conv) err[Fail] {
    val m: *Module = c.m;
    var i: usize   = 0;
    for (i < vector.length[Segment](?m.data)) {
        val seg: *Segment = ?m.data.data[i];
        if (sel m.linking.none) {
            val plain: err[Fail] = unnamed_segment(c, seg, i);
            if (sel plain.err) { ret plain; }
            i = i + 1;
            cnt;
        }
        val info: res[*SegmentInfo, Fail] = info_of(c, i);
        if (sel info.err) { ret err[Fail].err{info.err}; }
        val n:    Bytes         = model.name_bytes(m, ?info.ok.name);
        val kind: *section.Kind = segment_kind(n);
        if (info.ok.align.value > 63) { ret err[Fail].err{fail.in_indexed(fail.malformed("a data segment's alignment exceeds 2^63"), "data segment", i::u64)}; }
        val id: res[Id[Name], Fail] = name_of(c, n);
        if (sel id.err) { ret err[Fail].err{id.err}; }
        val held: res[Contents, Fail] = segment_contents(c, kind, ?seg.data);
        if (sel held.err) { ret err[Fail].err{fail.in_indexed(held.err, "data segment", i::u64)}; }
        val flags: section.Flags                 = kind.flags | segment_flags(info.ok);
        val s:     res[Id[object.Section], Fail] = object.add_section(c.o, object.Section{
            name:        opt[Id[Name]].some{id.ok},
            kind:        kind,
            flags:       flags,
            align:       1::u64 << info.ok.align.value,
            contents:    held.ok,
            disposition: disposition_of(flags),
        });
        if (sel s.err) { ret err[Fail].err{s.err}; }
        val p: err[Fail] = vectors.push[Id[object.Section]](?c.datas, s.ok);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        val entry: Id[Entry] = c.segments.data[i];
        table.at[Entry](?c.o.entries, entry).body = opt[Place].some{Place{section: s.ok, offset: 0}};
        i                                         = i + 1;
    }
    ret err[Fail].ok{};
}

# the contents of a segment of `kind` holding `h`: its bytes, or for a
# zero-fill kind the zero fill, as a segment states its bytes even where they
# are all zero, refused for one that holds any other
fun segment_contents(c: *Conv, kind: *section.Kind, h: *Held) res[Contents, Fail] {
    if (section.has(kind, section.BITS)) { ret contents(c, h); }
    val b: Bytes = model.bytes(c.m, h);
    var i: usize = 0;
    for (i < b.len) {
        if (b.data[i] != 0) { ret res[Contents, Fail].err{fail.malformed("a data segment of a zero-fill name holds bytes that are not zero")}; }
        i = i + 1;
    }
    ret res[Contents, Fail].ok{Contents.zero{b.len::u64}};
}

# the data segment `seg`, the `i`th, of a module without a linking section,
# which names, aligns and flags no segment: an unnamed data section of no
# alignment, its entry's body
fun unnamed_segment(c: *Conv, seg: *Segment, i: usize) err[Fail] {
    val held: res[Contents, Fail] = contents(c, ?seg.data);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    val s: res[Id[object.Section], Fail] = object.add_section(c.o, object.Section{kind: ?section.DATA, flags: section.DATA.flags, align: 1, contents: held.ok, disposition: ?section.WHOLE});
    if (sel s.err) { ret err[Fail].err{s.err}; }
    val p: err[Fail] = vectors.push[Id[object.Section]](?c.datas, s.ok);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    val entry: Id[Entry] = c.segments.data[i];
    table.at[Entry](?c.o.entries, entry).body = opt[Place].some{Place{section: s.ok, offset: 0}};
    ret err[Fail].ok{};
}

# the payload of the custom section `s`, the name section's as the writer
# lays it out, refusing another the conventions decode
fun custom_payload(c: *Conv, s: *Section, index: usize) res[Contents, Fail] {
    if (sel s.body.raw) { ret contents(c, ?s.body.raw.bytes); }
    if (sel s.body.names) {
        val laid: res[Sink, Fail] = write.body_bytes(c.m.a, c.m, ?s.body);
        if (sel laid.err) { ret res[Contents, Fail].err{laid.err}; }
        var out: Sink = laid.ok;
        ret owned(c, ?out);
    }
    ret res[Contents, Fail].err{fail.in_indexed(fail.unsupported("a custom section the conventions decode has no neutral form in an object"), "section", index::u64)};
}

# the custom sections the conventions do not consume, each a neutral section,
# and the module section indices of the code and data sections
fun customs_in(c: *Conv) err[Fail] {
    val m:     *Module   = c.m;
    val count: usize     = table.count[Section](?m.sections);
    val grown: err[Fail] = vectors.grow[u32](?c.map, count);
    if (sel grown.err) { ret err[Fail].err{grown.err}; }
    val held_by: err[Fail] = vectors.grow[u32](?c.holder, count);
    if (sel held_by.err) { ret err[Fail].err{held_by.err}; }
    var i: usize = 0;
    for (i < count) {
        val s: *Section = model.section_at(m, table.nth[Section](i));
        if (s.id == tables.WASM_SEC_CODE.value::u8) { c.code = opt[usize].some{i}; }
        if (s.id == tables.WASM_SEC_DATA.value::u8) { c.data = opt[usize].some{i}; }
        i = i + 1;
        if (!model.is_custom(s)) { cnt; }
        val n:  Bytes    = model.name_bytes(m, ?s.name);
        val by: opt[str] = consumed(n);
        if (sel by.some) { cnt; }
        if (wasm_mark.holds(n)) {
            if (!sel s.body.raw) { ret err[Fail].err{fail.in_indexed(fail.malformed("the mink note section holds no bytes"), "section", (i - 1)::u64)}; }
            val h: Holder                = Holder{section: (i - 1)::u32, data: model.bytes(m, ?s.body.raw.bytes), base: s.payload + s.name.width::u64 + n.len::u64};
            val p: res[Id[Holder], Fail] = table.push[Holder](?c.holders, h);
            if (sel p.err) { ret err[Fail].err{p.err}; }
            c.holder.data[i - 1] = p.ok.index + 1;
            cnt;
        }
        val held: res[Contents, Fail] = custom_payload(c, s, i - 1);
        if (sel held.err) { ret err[Fail].err{held.err}; }
        val id: res[Id[Name], Fail] = name_of(c, n);
        if (sel id.err) { ret err[Fail].err{id.err}; }
        val kind:  *section.Kind                 = custom_kind(n);
        val added: res[Id[object.Section], Fail] = object.add_section(c.o, object.Section{
            name:        opt[Id[Name]].some{id.ok},
            kind:        kind,
            flags:       kind.flags,
            align:       1,
            contents:    held.ok,
            disposition: ?section.WHOLE,
        });
        if (sel added.err) { ret err[Fail].err{added.err}; }
        c.map.data[i - 1] = added.ok.index + 1;
    }
    ret err[Fail].ok{};
}

# where each function body and each segment's bytes start in its section's
# payload, so a relocation offset finds its record
fun starts_in(c: *Conv) err[Fail] {
    val m:  *Module = c.m;
    var at: u64     = 0;
    if (sel c.code.some) {
        val s: *Section = model.section_at(m, table.nth[Section](c.code.some));
        if (sel s.body.code) {
            val st: err[Fail] = model.body_starts(m, ?s.body.code, ?c.starts);
            if (sel st.err) { ret st; }
        }
    }
    if (sel c.data.some) {
        val s: *Section = model.section_at(m, table.nth[Section](c.data.some));
        if (sel s.body.data) {
            at = s.body.data.width::u64;
            var i: usize = 0;
            for (i < s.body.data.count) {
                val seg:  *Segment        = ?m.data.data[s.body.data.first + i];
                val head: res[Sink, Fail] = write.segment_head_bytes(m.a, m, seg);
                if (sel head.err) { ret err[Fail].err{head.err}; }
                var hs: Sink = head.ok;
                at = at + sink.len(?hs)::u64 + seg.width::u64;
                val freed: err[Fail] = sink.release(?hs);
                if (sel freed.err) { ret freed; }
                val p: err[Fail] = vectors.push[u64](?c.dstarts, at);
                if (sel p.err) { ret err[Fail].err{p.err}; }
                at = at + model.bytes(m, ?seg.data).len::u64;
                i  = i + 1;
            }
        }
    }
    ret err[Fail].ok{};
}

# the binding the symbol flags state
fun binding_of(flags: u64) res[*symbol.Binding, Fail] {
    val b: u64 = flags & tables.WASM_SYMBOL_BINDING_MASK.value;
    if (b == tables.WASM_SYMBOL_BINDING_GLOBAL.value) { ret res[*symbol.Binding, Fail].ok{?symbol.GLOBAL}; }
    if (b == tables.WASM_SYMBOL_BINDING_WEAK.value)   { ret res[*symbol.Binding, Fail].ok{?symbol.WEAKLY}; }
    if (b == tables.WASM_SYMBOL_BINDING_LOCAL.value)  { ret res[*symbol.Binding, Fail].ok{?symbol.LOCAL}; }
    ret res[*symbol.Binding, Fail].err{fail.valued(fail.malformed("a symbol states a binding the convention does not define"), b::i128)};
}

fun visibility_of(flags: u64) res[*symbol.Visibility, Fail] {
    val v: u64 = flags & tables.WASM_SYMBOL_VISIBILITY_MASK.value;
    if (v == tables.WASM_SYMBOL_VISIBILITY_DEFAULT.value) { ret res[*symbol.Visibility, Fail].ok{?symbol.DEFAULT}; }
    if (v == tables.WASM_SYMBOL_VISIBILITY_HIDDEN.value)  { ret res[*symbol.Visibility, Fail].ok{?symbol.HIDDEN}; }
    ret res[*symbol.Visibility, Fail].err{fail.valued(fail.malformed("a symbol states a visibility the convention does not define"), v::i128)};
}

# the entry a function, global, table or tag symbol names, which must be an
# import exactly when the symbol is undefined
fun entry_of(c: *Conv, kind: u8, index: u64, undefined: bool) res[Id[Entry], Fail] {
    val into: res[*Vector[Id[Entry]], Fail] = space_of(c, kind);
    if (sel into.err) { ret res[Id[Entry], Fail].err{into.err}; }
    if (index >= vector.length[Id[Entry]](into.ok)::u64) {
        ret res[Id[Entry], Fail].err{fail.valued(fail.malformed("a symbol names an index past its space"), index::i128)};
    }
    val imported: bool = index < model.imported(c.m, kind)::u64;
    if (imported != undefined) {
        ret res[Id[Entry], Fail].err{fail.valued(fail.malformed("a symbol is undefined exactly when its entry is an import"), index::i128)};
    }
    ret res[Id[Entry], Fail].ok{into.ok.data[index::usize]};
}

fun symbol_in(c: *Conv, k: usize, s: *Symbol) err[Fail] {
    val m:     *Module = c.m;
    val flags: u64     = s.flags.value;
    if (c.named.data[k]) {
        if ((flags & tables.WASM_SYMBOL_BINDING_LOCAL.value) == 0) { ret err[Fail].err{fail.malformed("a symbol the mink note's records name is not local, as only the note names it")}; }
        ret err[Fail].ok{};
    }
    val named: opt[Bytes] = model.symbol_name(m, s);
    if (sel named.none) { ret err[Fail].err{fail.malformed("a symbol names nothing the module holds")}; }
    val id: res[Id[Name], Fail] = name_of(c, named.some);
    if (sel id.err) { ret err[Fail].err{id.err}; }
    val binding: res[*symbol.Binding, Fail] = binding_of(flags);
    if (sel binding.err) { ret err[Fail].err{binding.err}; }
    val vis: res[*symbol.Visibility, Fail] = visibility_of(flags);
    if (sel vis.err) { ret err[Fail].err{vis.err}; }
    val undefined: bool           = (flags & tables.WASM_SYMBOL_UNDEFINED.value) != 0;
    var def:       Definition     = Definition.undefined{};
    var kind:      *symbol.Kind   = ?symbol.INDEXED;
    var size:      opt[u64]       = opt[u64].none{};
    var import:    opt[Id[Entry]] = opt[Id[Entry]].none{};
    if (s.kind == tables.WASM_SYMBOL_TYPE_DATA.value::u8) {
        kind = ?symbol.DATA;
        if ((flags & tables.WASM_SYMBOL_TLS.value) != 0) { kind = ?symbol.TLS; }
        if (!undefined) {
            size = object.sized(s.size.value);
            if ((flags & tables.WASM_SYMBOL_ABSOLUTE.value) != 0) { def = Definition.absolute{s.offset.value}; }
            or {
                if (s.segment.value >= vector.length[Id[object.Section]](?c.datas)::u64) {
                    ret err[Fail].err{fail.valued(fail.malformed("a data symbol names a segment past the data section"), s.segment.value::i128)};
                }
                def = Definition.placed{Place{section: c.datas.data[s.segment.value::usize], offset: s.offset.value}};
            }
        }
    }
    or (s.kind == tables.WASM_SYMBOL_TYPE_SECTION.value::u8) {
        kind = ?symbol.SECTIONS;
        if (s.index.value >= vector.length[u32](?c.map)::u64) { ret err[Fail].err{fail.valued(fail.malformed("a section symbol names a section past the module"), s.index.value::i128)}; }
        val mapped: u32 = c.map.data[s.index.value::usize];
        if (mapped == 0) { ret err[Fail].err{fail.valued(fail.unsupported("a section symbol names a section with no neutral form"), s.index.value::i128)}; }
        def = Definition.placed{Place{section: Id[object.Section]{index: mapped - 1}, offset: 0}};
    }
    or {
        val ik: opt[u8] = model.import_kind(s.kind);
        if (sel ik.none) { ret err[Fail].err{fail.valued(fail.malformed("a symbol has a kind the convention does not define"), s.kind::i128)}; }
        val e: res[Id[Entry], Fail] = entry_of(c, ik.some, s.index.value, undefined);
        if (sel e.err)                                            { ret err[Fail].err{e.err}; }
        if (undefined)                                            { import = opt[Id[Entry]].some{e.ok}; }
        or                                                        { def = Definition.entry{e.ok}; }
        if (s.kind == tables.WASM_SYMBOL_TYPE_FUNCTION.value::u8) { kind = ?symbol.FUNCTION; }
    }
    val added: res[Id[object.Symbol], Fail] = object.add_symbol(c.o, object.Symbol{
        name:       id.ok,
        binding:    binding.ok,
        visibility: vis.ok,
        kind:       kind,
        def:        def,
        size:       size,
        retain:     (flags & tables.WASM_SYMBOL_NO_STRIP.value) != 0,
    });
    if (sel added.err) { ret err[Fail].err{added.err}; }
    c.syms.data[k] = added.ok.index + 1;
    if (sel import.some) {
        val n: err[Fail] = names_import(c, import.some, added.ok, (flags & tables.WASM_SYMBOL_EXPLICIT_NAME.value) != 0);
        if (sel n.err) { ret n; }
    }
    if ((flags & tables.WASM_SYMBOL_EXPORTED.value) != 0) {
        val d: res[Id[object.Directive], Fail] = object.add_directive(c.o, object.Directive{kind: ?directive.EXPORT, text: id.ok, symbol: opt[Id[Name]].some{id.ok}});
        if (sel d.err) { ret err[Fail].err{d.err}; }
    }
    ret err[Fail].ok{};
}

# the import entry `e` resolves by the symbol `sym`, and stands when nothing
# defines it where its producer named it explicitly, as an import a source
# attribute names does
fun names_import(c: *Conv, e: Id[Entry], sym: Id[object.Symbol], explicit: bool) err[Fail] {
    val en: *Entry = table.at[Entry](?c.o.entries, e);
    if (!sel en.import.some) { ret err[Fail].err{fail.internal("an undefined symbol names an entry that is no import")}; }
    val imp: object.Import = en.import.some;
    if (sel imp.symbol.some) { ret err[Fail].err{fail.unsupported("two symbols name one import")}; }
    ret import_of_entry(en, imp, sym, explicit);
}

fun import_of_entry(en: *Entry, was: object.Import, sym: Id[object.Symbol], explicit: bool) err[Fail] {
    var imp: object.Import = was;
    imp.symbol = opt[Id[object.Symbol]].some{sym};
    imp.stays  = explicit;
    en.import  = opt[object.Import].some{imp};
    ret err[Fail].ok{};
}

# a symbol for each import of an object the symbol table names none for,
# named by the import's field, so the link resolves the import by that name,
# as a memory has no symbol in wasm and an object of an older convention
# imports its function table without one. a fact records each, so the module
# built back writes none. none for a module with no symbol table
fun fielded_in(c: *Conv) err[Fail] {
    if (!sel c.m.symtab.some) { ret err[Fail].ok{}; }
    var i: usize = 0;
    for (i < table.count[Entry](?c.o.entries)) {
        val e:  Id[Entry] = table.nth[Entry](i);
        val en: *Entry    = table.at[Entry](?c.o.entries, e);
        i = i + 1;
        if (!sel en.import.some)            { cnt; }
        if (sel en.import.some.symbol.some) { cnt; }
        var kind: *symbol.Kind = ?symbol.INDEXED;
        if (en.space == ?space.FUNCTIONS) { kind = ?symbol.FUNCTION; }
        val added: res[Id[object.Symbol], Fail] = object.add_symbol(c.o, object.Symbol{
            name:       en.import.some.field,
            binding:    ?symbol.GLOBAL,
            visibility: ?symbol.DEFAULT,
            kind:       kind,
            def:        Definition.undefined{},
        });
        if (sel added.err) { ret err[Fail].err{added.err}; }
        val n: err[Fail] = names_import(c, e, added.ok, false);
        if (sel n.err) { ret err[Fail].err{fail.in_indexed(n.err, "entry", (i - 1)::u64)}; }
        val f: err[Fail] = add_fact(c, fact.FIELD_SYMBOL, added.ok.index::u64, Contents.zero{0});
        if (sel f.err) { ret f; }
    }
    ret err[Fail].ok{};
}

# the neutral symbol the symbol table entry `index` became, refused for one
# past the table and for a symbol that anchors the mink note, which only the
# note's records name
fun symbol_of(c: *Conv, index: u64) res[Id[object.Symbol], Fail] {
    if (index >= vector.length[u32](?c.syms)::u64) { ret res[Id[object.Symbol], Fail].err{fail.valued(fail.malformed("a symbol index lies past the symbol table"), index::i128)}; }
    val mapped: u32 = c.syms.data[index::usize];
    if (mapped == 0) { ret res[Id[object.Symbol], Fail].err{fail.valued(fail.unsupported("a symbol the mink note's records name anchors only the note"), index::i128)}; }
    ret res[Id[object.Symbol], Fail].ok{Id[object.Symbol]{index: mapped - 1}};
}

# mark each symbol a record of a holder's reloc section names
fun named_in(c: *Conv) {
    val m: *Module = c.m;
    var i: usize   = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = model.section_at(m, table.nth[Section](i));
        i = i + 1;
        if (!sel s.body.relocs) { cnt; }
        val rs: *Relocs = ?s.body.relocs;
        if (rs.section.value >= vector.length[u32](?c.holder)::u64 || c.holder.data[rs.section.value::usize] == 0) { cnt; }
        var k: usize = 0;
        for (k < rs.entries.count) {
            val index: u64 = m.relocs.data[rs.entries.first + k].index.value;
            if (index < vector.length[bool](?c.named)::u64) { c.named.data[index::usize] = true; }
            k = k + 1;
        }
    }
}

# the symbols, none for an object whose linking section states no symbol
# table, as one with no symbols leaves it out
fun symbols_in(c: *Conv) err[Fail] {
    if (!sel c.m.symtab.some) { ret err[Fail].ok{}; }
    val r: Run       = c.m.symtab.some;
    val g: err[Fail] = vectors.grow[u32](?c.syms, r.count);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    val gn: err[Fail] = vectors.grow[bool](?c.named, r.count);
    if (sel gn.err) { ret err[Fail].err{gn.err}; }
    named_in(c);
    c.symbols = r;
    var k: usize = 0;
    for (k < r.count) {
        val e: err[Fail] = symbol_in(c, k, table.at[Symbol](?c.m.symbols, table.nth[Symbol](r.first + k)));
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "symbol", k::u64)}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the position of the last start at or before `offset` among the `n` starts,
# none before the first
fun holding(starts: *Vector[u64], offset: u64) opt[usize] {
    var lo: usize = 0;
    var hi: usize = vector.length[u64](starts);
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (starts.data[mid] <= offset) { lo = mid + 1; }
        or                              { hi = mid; }
    }
    if (lo == 0) { ret opt[usize].none{}; }
    ret opt[usize].some{lo - 1};
}

# whether `at` lies past a body of `len` bytes, its end in it when `edge`
# holds
fun past(at: u64, len: u64, edge: bool) bool {
    if (edge) { ret at > len; }
    ret at >= len;
}

# the neutral section a relocation of module section `target` at `offset`
# patches, and the offset within it. a place at the very end of a function
# body or segment is in it when `edge` holds, as the end of a range is
fun place_of(c: *Conv, target: u64, offset: u64, edge: bool) res[Place, Fail] {
    if (target >= vector.length[u32](?c.map)::u64) { ret res[Place, Fail].err{fail.valued(fail.malformed("a reloc section names a section past the module"), target::i128)}; }
    if (sel c.code.some && c.code.some::u64 == target) {
        val at: opt[usize] = holding(?c.starts, offset);
        if (sel at.none) { ret res[Place, Fail].err{fail.malformed("a code relocation lies before the first function body")}; }
        val start: u64       = c.starts.data[at.some];
        val f:     *Function = ?c.m.code.data[at.some];
        if (past(offset - start, model.bytes(c.m, ?f.body).len::u64, edge)) { ret res[Place, Fail].err{fail.malformed("a code relocation lies between two function bodies")}; }
        ret res[Place, Fail].ok{Place{section: c.bodies.data[at.some], offset: offset - start}};
    }
    if (sel c.data.some && c.data.some::u64 == target) {
        val at: opt[usize] = holding(?c.dstarts, offset);
        if (sel at.none) { ret res[Place, Fail].err{fail.malformed("a data relocation lies before the first segment")}; }
        val start: u64      = c.dstarts.data[at.some];
        val seg:   *Segment = ?c.m.data.data[at.some];
        if (past(offset - start, model.bytes(c.m, ?seg.data).len::u64, edge)) { ret res[Place, Fail].err{fail.malformed("a data relocation lies between two segments")}; }
        ret res[Place, Fail].ok{Place{section: c.datas.data[at.some], offset: offset - start}};
    }
    val mapped: u32 = c.map.data[target::usize];
    if (mapped == 0) { ret res[Place, Fail].err{fail.valued(fail.unsupported("a reloc section applies to a section with no neutral form"), target::i128)}; }
    ret res[Place, Fail].ok{Place{section: Id[object.Section]{index: mapped - 1}, offset: offset}};
}

fun reloc_in(c: *Conv, rs: *Relocs, r: *Reloc) err[Fail] {
    val found: res[*Row, Fail] = row.by_key(c.set, r.type::u32);
    if (sel found.err) { ret err[Fail].err{fail.valued(fail.unsupported("no relocation row has this type"), r.type::i128)}; }
    val at: res[Place, Fail] = place_of(c, rs.section.value, r.offset.value, false);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    var refers: object.Target = object.Target.none{};
    if (found.ok.kind == ?wasm_reloc.TYPE_INDEX_LEB) {
        val t: res[Id[Entry], Fail] = type_entry(c, r.index.value);
        if (sel t.err) { ret err[Fail].err{t.err}; }
        refers = object.Target.entry{t.ok};
    }
    or {
        val sym: res[Id[object.Symbol], Fail] = symbol_of(c, r.index.value);
        if (sel sym.err) { ret err[Fail].err{sym.err}; }
        refers = object.Target.symbol{sym.ok};
    }
    var addend: i64 = 0;
    if (sel found.ok.addend.record) { addend = r.addend.value; }
    val added: res[Id[object.Reloc], Fail] = object.add_reloc(c.o, object.Reloc{section: at.ok.section, offset: at.ok.offset, kind: found.ok.kind, target: refers, addend: addend});
    if (sel added.err) { ret err[Fail].err{added.err}; }
    ret err[Fail].ok{};
}

fun relocs_in(c: *Conv) err[Fail] {
    val m: *Module = c.m;
    var i: usize   = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = model.section_at(m, table.nth[Section](i));
        i = i + 1;
        if (!sel s.body.relocs) { cnt; }
        val rs: *Relocs = ?s.body.relocs;
        if (rs.section.value < vector.length[u32](?c.holder)::u64 && c.holder.data[rs.section.value::usize] != 0) {
            val e: err[Fail] = noted_in(c, rs, c.holder.data[rs.section.value::usize] - 1);
            if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "section", (i - 1)::u64)}; }
            cnt;
        }
        var k: usize = 0;
        for (k < rs.entries.count) {
            val e: err[Fail] = reloc_in(c, rs, ?m.relocs.data[rs.entries.first + k]);
            if (sel e.err) { ret err[Fail].err{fail.in_indexed(fail.in_indexed(e.err, "relocation", k::u64), "section", (i - 1)::u64)}; }
            k = k + 1;
        }
    }
    ret err[Fail].ok{};
}

# keep the records of the reloc section `rs`, which patches a mink note
# holder, for notes_in to decode
fun noted_in(c: *Conv, rs: *Relocs, holder: u32) err[Fail] {
    var k: usize = 0;
    for (k < rs.entries.count) {
        val r: *Reloc    = ?c.m.relocs.data[rs.entries.first + k];
        val p: err[Fail] = vectors.push[Noted](?c.noted, Noted{holder: holder, rec: @r});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# how the mink note records order: by the holder they patch, then by offset
fun order_noted(a: *Noted, b: *Noted) i64 {
    if (a.holder < b.holder)                     { ret -1; }
    if (a.holder > b.holder)                     { ret 1; }
    if (a.rec.offset.value < b.rec.offset.value) { ret -1; }
    if (a.rec.offset.value > b.rec.offset.value) { ret 1; }
    ret 0;
}

# the records of one holder, as the mink note decoder reads them
rec Holding {
    c:    *Conv;
    recs: *Noted;
}

fun noted_offset(ctx: ptr, i: usize) u64 {
    val h: *Holding = ctx::*Holding;
    ret h.recs[i].rec.offset.value;
}

# the place record `i` computes, from a local symbol only the note names, as
# the tool conventions' Linking document anchors each: a function offset
# record from a function symbol, its addend the offset in the function's
# body, a memory address record from a data symbol, its addend added to the
# symbol's offset in its segment, or a section offset record from a section
# symbol of a custom section, its addend the offset in that section
fun noted_place(ctx: ptr, i: usize, at: u64) res[Place, Fail] {
    val h:     *Holding        = ctx::*Holding;
    val c:     *Conv           = h.c;
    val r:     *Reloc          = ?h.recs[i].rec;
    val found: res[*Row, Fail] = row.by_key(c.set, r.type::u32);
    if (sel found.err) { ret res[Place, Fail].err{fail.valued(fail.at_offset(fail.unsupported("no relocation row has this type"), at), r.type::i128)}; }
    val index: u64 = r.index.value;
    if (index >= vector.length[u32](?c.syms)::u64 || c.syms.data[index::usize] != 0) {
        ret res[Place, Fail].err{fail.valued(fail.at_offset(fail.malformed("a field of the mink note payload is relocated from no symbol only the note names"), at), index::i128)};
    }
    if (r.addend.value < 0) { ret res[Place, Fail].err{fail.valued(fail.at_offset(fail.malformed("a field of the mink note payload computes an offset before its anchor"), at), r.addend.value::i128)}; }
    val sym:    *Symbol          = table.at[Symbol](?c.m.symbols, table.nth[Symbol](c.symbols.first + index::usize));
    val addend: u64              = r.addend.value::u64;
    val kind:   *reloc.Kind      = found.ok.kind;
    var p:      res[Place, Fail] = res[Place, Fail].err{fail.about(fail.malformed("a field of the mink note payload is relocated by a type that anchors it by no symbol of its kind"), kind.name)};
    if (kind == ?wasm_reloc.FUNCTION_OFFSET_I32 && sym.kind == tables.WASM_SYMBOL_TYPE_FUNCTION.value::u8) { p = function_anchor(c, sym, addend); }
    or (kind == ?reloc.ABS32 && sym.kind == tables.WASM_SYMBOL_TYPE_DATA.value::u8)                        { p = data_anchor(c, sym, addend); }
    or (kind == ?reloc.SECREL32 && sym.kind == tables.WASM_SYMBOL_TYPE_SECTION.value::u8)                  { p = custom_anchor(c, sym, addend); }
    if (sel p.err)                                                                                         { ret res[Place, Fail].err{fail.at_offset(p.err, at)}; }
    ret p;
}

# the place `offset` into the body of the function the defined function
# symbol `sym` names
fun function_anchor(c: *Conv, sym: *Symbol, offset: u64) res[Place, Fail] {
    val imported: u64 = model.imported(c.m, tables.WASM_EXTERNAL_FUNCTION.value::u8)::u64;
    val index:    u64 = sym.index.value;
    if ((sym.flags.value & tables.WASM_SYMBOL_UNDEFINED.value) != 0 || index < imported || index - imported >= vector.length[Id[object.Section]](?c.bodies)::u64) {
        ret res[Place, Fail].err{fail.valued(fail.malformed("a function symbol anchoring the mink note names a function the module does not define"), index::i128)};
    }
    val body: usize     = (index - imported)::usize;
    val f:    *Function = ?c.m.code.data[body];
    if (past(offset, model.bytes(c.m, ?f.body).len::u64, true)) { ret res[Place, Fail].err{fail.valued(fail.malformed("a field of the mink note payload computes an offset past its function's body"), offset::i128)}; }
    ret res[Place, Fail].ok{Place{section: c.bodies.data[body], offset: offset}};
}

# the place `offset` past the defined data symbol `sym` in its segment
fun data_anchor(c: *Conv, sym: *Symbol, offset: u64) res[Place, Fail] {
    val flags: u64 = sym.flags.value;
    if ((flags & tables.WASM_SYMBOL_UNDEFINED.value) != 0 || (flags & tables.WASM_SYMBOL_ABSOLUTE.value) != 0 || sym.segment.value >= vector.length[Id[object.Section]](?c.datas)::u64) {
        ret res[Place, Fail].err{fail.valued(fail.malformed("a data symbol anchoring the mink note names a segment the module does not hold"), sym.segment.value::i128)};
    }
    val segment: usize    = sym.segment.value::usize;
    val seg:     *Segment = ?c.m.data.data[segment];
    val place:   u128     = sym.offset.value::u128 + offset::u128;
    if (place > model.bytes(c.m, ?seg.data).len::u128) { ret res[Place, Fail].err{fail.valued(fail.malformed("a field of the mink note payload computes an offset past its segment"), place::i128)}; }
    ret res[Place, Fail].ok{Place{section: c.datas.data[segment], offset: place::u64}};
}

# the place `offset` into the custom section the section symbol `sym` names
fun custom_anchor(c: *Conv, sym: *Symbol, offset: u64) res[Place, Fail] {
    val target: u64 = sym.index.value;
    if (target >= vector.length[u32](?c.map)::u64 || c.map.data[target::usize] == 0) {
        ret res[Place, Fail].err{fail.valued(fail.malformed("a section symbol anchoring the mink note names no custom section"), target::i128)};
    }
    ret res[Place, Fail].ok{Place{section: Id[object.Section]{index: c.map.data[target::usize] - 1}, offset: offset}};
}

# the constant-time ranges every mink note holder states, marked on the
# object, each holder's records decoding its payloads
fun notes_in(c: *Conv) err[Fail] {
    val n: usize = vector.length[Noted](?c.noted);
    sort.sort_by[Noted](c.noted.data, n, order_noted);
    var first: usize = 0;
    var i:     usize = 0;
    for (i < table.count[Holder](?c.holders)) {
        val h:     *Holder = table.at[Holder](?c.holders, table.nth[Holder](i));
        var count: usize   = 0;
        for (first + count < n && c.noted.data[first + count].holder::usize == i) {
            count = count + 1;
        }
        var held: Holding   = Holding{c: c, recs: ?c.noted.data[first]};
        var an:   Anchors   = Anchors{ctx: (?held)::ptr, count: count, offset: noted_offset, place: noted_place};
        val r:    err[Fail] = mark.decode_all(c.o, h.data, h.base, wasm_mark.WIDTH, LITTLE, ?an);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section", h.section::u64)}; }
        first = first + count;
        i     = i + 1;
    }
    ret err[Fail].ok{};
}

# the neutral section a COMDAT item names
fun member_of(c: *Conv, it: *ComdatItem) res[Id[object.Section], Fail] {
    val index: u64 = it.index.value;
    if (it.kind == tables.WASM_COMDAT_DATA.value::u8) {
        if (index >= vector.length[Id[object.Section]](?c.datas)::u64) { ret res[Id[object.Section], Fail].err{fail.valued(fail.malformed("a COMDAT names a segment past the data section"), index::i128)}; }
        ret res[Id[object.Section], Fail].ok{c.datas.data[index::usize]};
    }
    if (it.kind == tables.WASM_COMDAT_FUNCTION.value::u8) {
        val imported: usize = model.imported(c.m, tables.WASM_EXTERNAL_FUNCTION.value::u8);
        if (index < imported::u64 || index - imported::u64 >= vector.length[Id[object.Section]](?c.bodies)::u64) {
            ret res[Id[object.Section], Fail].err{fail.valued(fail.malformed("a COMDAT names a function the module does not define"), index::i128)};
        }
        ret res[Id[object.Section], Fail].ok{c.bodies.data[(index - imported::u64)::usize]};
    }
    if (it.kind == tables.WASM_COMDAT_SECTION.value::u8) {
        if (index >= vector.length[u32](?c.map)::u64) { ret res[Id[object.Section], Fail].err{fail.valued(fail.malformed("a COMDAT names a section past the module"), index::i128)}; }
        val mapped: u32 = c.map.data[index::usize];
        if (mapped == 0) { ret res[Id[object.Section], Fail].err{fail.valued(fail.unsupported("a COMDAT names a section with no neutral form"), index::i128)}; }
        ret res[Id[object.Section], Fail].ok{Id[object.Section]{index: mapped - 1}};
    }
    ret res[Id[object.Section], Fail].err{fail.valued(fail.unsupported("a COMDAT member kind the convention does not define"), it.kind::i128)};
}

# the groups the COMDAT info states, and the priorities the init functions
# give their function sections
fun linking_in(c: *Conv) err[Fail] {
    val m: *Module = c.m;
    if (!sel m.linking.some) { ret err[Fail].ok{}; }
    val s: *Section = model.section_at(m, m.linking.some);
    if (!sel s.body.linking) { ret err[Fail].err{fail.internal("the linking section holds no linking body")}; }
    val subs: Run   = s.body.linking.subsections;
    var i:    usize = 0;
    for (i < subs.count) {
        val sub: *Subsection = ?m.subsections.data[subs.first + i];
        i = i + 1;
        if (sel sub.body.comdats) {
            val e: err[Fail] = comdats_in(c, ?sub.body.comdats);
            if (sel e.err) { ret e; }
        }
        or (sel sub.body.inits) {
            val e: err[Fail] = inits_in(c, ?sub.body.inits);
            if (sel e.err) { ret e; }
        }
        or (sel sub.body.raw) {
            ret err[Fail].err{fail.valued(fail.in_indexed(fail.unsupported("a linking subsection held raw has no neutral form"), "linking subsection", (i - 1)::u64), sub.id::i128)};
        }
    }
    ret err[Fail].ok{};
}

fun comdats_in(c: *Conv, r: *Run) err[Fail] {
    val m: *Module = c.m;
    var i: usize   = 0;
    for (i < r.count) {
        val g: *Comdat = ?m.comdats.data[r.first + i];
        if (g.flags.value != 0) { ret err[Fail].err{fail.in_indexed(fail.valued(fail.unsupported("a COMDAT states flags the convention does not define"), g.flags.value::i128), "COMDAT", i::u64)}; }
        val id: res[Id[Name], Fail] = name_of(c, model.name_bytes(m, ?g.name));
        if (sel id.err) { ret err[Fail].err{id.err}; }
        val added: res[Id[object.Group], Fail] = object.add_group(c.o, object.Group{signature: id.ok, rule: ?group.ANY});
        if (sel added.err) { ret err[Fail].err{added.err}; }
        var k: usize = 0;
        for (k < g.items.count) {
            val member: res[Id[object.Section], Fail] = member_of(c, ?m.comdat_items.data[g.items.first + k]);
            if (sel member.err) { ret err[Fail].err{fail.in_indexed(member.err, "COMDAT", i::u64)}; }
            val sec:   *object.Section = object.section_at(c.o, member.ok);
            val taken: bool            = sel sec.group.some;
            if (taken) { ret err[Fail].err{fail.in_indexed(fail.malformed("a section is a member of two COMDATs"), "COMDAT", i::u64)}; }
            sec.group = opt[Id[object.Group]].some{added.ok};
            k         = k + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun inits_in(c: *Conv, r: *Run) err[Fail] {
    val m: *Module = c.m;
    var i: usize   = 0;
    for (i < r.count) {
        val f: *InitFunc = ?m.inits.data[r.first + i];
        if (f.priority.value > 0xffff_ffff) { ret err[Fail].err{fail.in_indexed(fail.malformed("an init function's priority exceeds 32 bits"), "init function", i::u64)}; }
        val id: res[Id[object.Symbol], Fail] = symbol_of(c, f.symbol.value);
        if (sel id.err) { ret err[Fail].err{fail.in_indexed(id.err, "init function", i::u64)}; }
        val sym: *object.Symbol = object.symbol_at(c.o, id.ok);
        if (!sel sym.def.entry) { ret err[Fail].err{fail.in_indexed(fail.unsupported("an init function names a symbol that is no function"), "init function", i::u64)}; }
        val e: *Entry = table.at[Entry](?c.o.entries, sym.def.entry);
        if (e.space != ?space.FUNCTIONS) { ret err[Fail].err{fail.in_indexed(fail.unsupported("an init function names a symbol that is no defined function"), "init function", i::u64)}; }
        if (!sel e.body.some)            { ret err[Fail].err{fail.in_indexed(fail.unsupported("an init function names a symbol that is no defined function"), "init function", i::u64)}; }
        val sec:   *object.Section = object.section_at(c.o, e.body.some.section);
        val twice: bool            = sel sec.priority.some;
        if (twice) { ret err[Fail].err{fail.in_indexed(fail.malformed("a function is an init function twice"), "init function", i::u64)}; }
        sec.priority = opt[u32].some{f.priority.value::u32};
        sec.flags    = sec.flags | section.RETAIN;
        i            = i + 1;
    }
    ret err[Fail].ok{};
}

# a target feature as the set orders it
rec Marked {
    prefix: u8;
    name:   Bytes;
}

fun by_feature_name(a: *Marked, b: *Marked) i64 {
    var i: usize = 0;
    for (i < a.name.len && i < b.name.len) {
        if (a.name.data[i] < b.name.data[i]) { ret -1; }
        if (a.name.data[i] > b.name.data[i]) { ret 1; }
        i = i + 1;
    }
    if (a.name.len < b.name.len) { ret -1; }
    if (a.name.len > b.name.len) { ret 1; }
    ret 0;
}

# the target features as the object's trait: each its mark and name, in name
# order, a feature the module states twice or as required refused
fun features_in(c: *Conv, r: *Run) err[Fail] {
    val m:     *Module         = c.m;
    var named: Vector[Marked]  = vector.init[Marked](m.a);
    var out:   Sink            = sink.make(m.a, LITTLE);
    val e:     err[Fail]       = features_into(c, r, ?named, ?out);
    var held:  res[Held, Fail] = res[Held, Fail].err{fail.internal("the target features were not written")};
    if (sel e.ok) { held = store.own(?c.o.store, sink.data(?out), sink.len(?out)); }
    val f1: err[Fail] = vectors.release[Marked](?named);
    val f2: err[Fail] = sink.release(?out);
    if (sel e.err)    { ret e; }
    if (sel held.err) { ret err[Fail].err{held.err}; }
    if (sel f1.err)   { ret f1; }
    if (sel f2.err)   { ret f2; }
    ret object.state(c.o, ?wasm.WASM_FEATURES, Setting.set{held.ok});
}

fun features_into(c: *Conv, r: *Run, named: *Vector[Marked], out: *Sink) err[Fail] {
    val m: *Module = c.m;
    var i: usize   = 0;
    for (i < r.count) {
        val f: *Feature = ?m.features.data[r.first + i];
        i = i + 1;
        if (f.prefix != tables.WASM_FEATURE_PREFIX_USED.value::u8 && f.prefix != tables.WASM_FEATURE_PREFIX_DISALLOWED.value::u8) {
            ret err[Fail].err{fail.in_indexed(fail.valued(fail.unsupported("a target feature of this prefix has no neutral form"), f.prefix::i128), "target feature", (i - 1)::u64)};
        }
        val p: err[Fail] = vectors.push[Marked](named, Marked{prefix: f.prefix, name: model.name_bytes(m, ?f.name)});
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    val n: usize = vector.length[Marked](named);
    sort.sort_by[Marked](named.data, n, by_feature_name);
    var e: err[Fail] = err[Fail].ok{};
    i = 0;
    for (i < n) {
        val f: *Marked = ?named.data[i];
        if (i != 0 && by_feature_name(?named.data[i - 1], f) == 0) {
            ret err[Fail].err{fail.in_record(fail.malformed("a target feature is stated twice"), FEATURES_NAME)};
        }
        if (i != 0) { e = fail.kept(e, sink.u8(out, COMMA)); }
        e = fail.kept(e, sink.u8(out, f.prefix));
        e = fail.kept(e, sink.bytes(out, f.name.data, f.name.len));
        i = i + 1;
    }
    ret e;
}

# the facts the rest of the module states: its element segments, data count,
# start function and producers, and the target features as its trait
fun facts_in(c: *Conv) err[Fail] {
    val m: *Module = c.m;
    var i: usize   = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = model.section_at(m, table.nth[Section](i));
        i = i + 1;
        if (sel s.body.elements) {
            var k: usize = 0;
            for (k < s.body.elements.count) {
                val f: err[Fail] = add_bytes_fact(c, fact.ELEMENT, k::u64, write.element_bytes(m.a, m, ?m.elements.data[s.body.elements.first + k]));
                if (sel f.err) { ret err[Fail].err{fail.in_indexed(f.err, "element segment", k::u64)}; }
                k = k + 1;
            }
        }
        or (sel s.body.datacount) {
            val f: err[Fail] = add_fact(c, fact.DATACOUNT, s.body.datacount.value, Contents.zero{0});
            if (sel f.err) { ret f; }
        }
        or (sel s.body.start) {
            val f: err[Fail] = add_fact(c, fact.START, s.body.start.value, Contents.zero{0});
            if (sel f.err) { ret f; }
        }
        or (sel s.body.exports) {
            val f: err[Fail] = add_bytes_fact(c, fact.EXPORTS, 0, write.body_bytes(m.a, m, ?s.body));
            if (sel f.err) { ret f; }
        }
        or (sel s.body.producers) {
            val f: err[Fail] = add_bytes_fact(c, fact.PRODUCERS, 0, write.body_bytes(m.a, m, ?s.body));
            if (sel f.err) { ret f; }
        }
        or (sel s.body.features) {
            val f: err[Fail] = features_in(c, ?s.body.features);
            if (sel f.err) { ret f; }
        }
    }
    ret err[Fail].ok{};
}

# refuse a module that holds raw a section the conversion reads, a core
# section or a custom section a convention consumes, as its facts would be
# lost. a custom section no convention consumes travels as its bytes
fun held_in(m: *Module) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = model.section_at(m, table.nth[Section](i));
        i = i + 1;
        if (!sel s.body.raw) { cnt; }
        val by:    opt[str]              = consumed(model.name_bytes(m, ?s.name));
        val named: opt[*tables.Constant] = tables.name_of(?tables.SEC, s.id::u64);
        if (model.is_custom(s) && sel by.none) { cnt; }
        val raw: Fail = fail.at_offset(fail.in_indexed(fail.unsupported("a section held raw has no neutral form"), "section", (i - 1)::u64), s.at);
        if (sel by.some)    { ret err[Fail].err{fail.about(raw, by.some)}; }
        or (sel named.some) { ret err[Fail].err{fail.about(raw, named.some.name)}; }
        ret err[Fail].err{fail.valued(raw, s.id::i128)};
    }
    ret err[Fail].ok{};
}

fun convert(c: *Conv, rows: *row.Registry) err[Fail] {
    val held: err[Fail] = held_in(c.m);
    if (sel held.err) { ret held; }
    var s: Stated           = model.stated(c.m);
    val a: res[*Arch, Fail] = arch_list.by_code(?s);
    if (sel a.err) { ret err[Fail].err{a.err}; }
    c.o.target = target.of(a.ok);
    val set: res[*Lookup, Fail] = row.find(rows, ?format.WASM, a.ok);
    if (sel set.err) { ret err[Fail].err{set.err}; }
    c.set = set.ok;
    val e: err[Fail] = entries_in(c);
    if (sel e.err) { ret e; }
    val f: err[Fail] = functions_in(c);
    if (sel f.err) { ret f; }
    val d: err[Fail] = data_in(c);
    if (sel d.err) { ret d; }
    val u: err[Fail] = customs_in(c);
    if (sel u.err) { ret u; }
    val st: err[Fail] = starts_in(c);
    if (sel st.err) { ret st; }
    val sy: err[Fail] = symbols_in(c);
    if (sel sy.err) { ret sy; }
    val me: err[Fail] = fielded_in(c);
    if (sel me.err) { ret me; }
    val r: err[Fail] = relocs_in(c);
    if (sel r.err) { ret r; }
    val n: err[Fail] = notes_in(c);
    if (sel n.err) { ret n; }
    val l: err[Fail] = linking_in(c);
    if (sel l.err) { ret l; }
    ret facts_in(c);
}

# add what the object `m` holds to the empty object `o`, its relocations
# read through the rows of `rows`, which a refusal leaves empty
pub fun to(m: ptr, rows: *row.Registry, o: *Object) err[Fail] {
    val mod: *Module = m::*Module;
    if (!object.empty(o)) { ret err[Fail].err{fail.internal("a model converts into an empty neutral object")}; }
    var built: Object    = object.blank(o);
    var c:     Conv      = make_conv(mod, ?built);
    val r:     err[Fail] = fail.kept(convert(?c, rows), release_conv(?c));
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?built);
        ret r;
    }
    ret object.commit(o, ?built);
}

# what a neutral section is to the module built from its object
# ---
# function: a function body, the one its entry names
# segment:  a data segment, the one its entry names
# custom:   a custom section
tag Role: u8 {
    function: Id[Entry];
    segment:  Id[Entry];
    custom;
}

# the module being built
# ---
# a:        the allocator of the module and the working tables
# o:        the object, the copy its records were lowered into when it
#           states any
# m:        the module
# pair:     what the format states for the target's architecture
# lowering: the encodings the object's records are lowered in
# copy:     the copy of the object its records were lowered into, none for
#           an object that states none
# set:      the relocation rows of the target's architecture
# index:    per entry, its index in its space
# role:     per neutral section, what it is
# place:    per neutral section, the module section index it lands in, plus
#           one, or zero
# fstart:   per neutral section that is a function body, where the body
#           starts in the code payload
# dstart:   per neutral section that is a segment, where its bytes start in
#           the data payload
# exported: per symbol, whether an export directive names it
# facts:    per entry, the index plus one of the fact about it, or zero
# definer:  per entry, the index plus one of the symbol defined at it, or
#           zero
# importer: per symbol, the index plus one of the import entry it names, or
#           zero
# written:  per symbol, its index in the module's symbol table plus one, or
#           zero for one the module writes no symbol for
# functions, tables, memories, globals, tags: the entries of each space, in
#           entry order, imports first
# segments: the segment entries, in entry order
# types:    the type entries, in entry order
# order:    the neutral sections that are custom, in object order
# note:     the mink note the object's constant-time ranges lower into
# holders:  per section of the note, the module section it lands in
# anchors:  per neutral section, the index plus one of the local symbol the
#           note's records name it by, or zero
# code:     per neutral section, the index plus one of the local function
#           symbol a relocation from a label in its body is written from, or
#           zero
# sizes:    the width a section size is written at
rec Build {
    a:         *A.Allocator;
    o:         *Object;
    m:         *Module;
    pair:      *Pair;
    lowering:  opt[*Lowering];
    copy:      opt[Object];
    set:       *Lookup;
    index:     Vector[u32];
    role:      Vector[Role];
    place:     Vector[u32];
    fstart:    Vector[u64];
    dstart:    Vector[u64];
    exported:  Vector[bool];
    facts:     Vector[u32];
    definer:   Vector[u32];
    importer:  Vector[u32];
    fielded:   Vector[bool];
    written:   Vector[u32];
    functions: Vector[Id[Entry]];
    tables:    Vector[Id[Entry]];
    memories:  Vector[Id[Entry]];
    globals:   Vector[Id[Entry]];
    tags:      Vector[Id[Entry]];
    segments:  Vector[Id[Entry]];
    types:     Vector[Id[Entry]];
    order:     Vector[u32];
    note:      Lowered;
    holders:   Vector[u32];
    anchors:   Vector[u32];
    code:      Vector[u32];
    sizes:     u8;
}

fun make_build(a: *A.Allocator, o: *Object, m: *Module, p: *Pair, l: opt[*Lowering]) Build {
    ret Build{
        a:         a,
        o:         o,
        m:         m,
        pair:      p,
        lowering:  l,
        index:     vector.init[u32](a),
        role:      vector.init[Role](a),
        place:     vector.init[u32](a),
        fstart:    vector.init[u64](a),
        dstart:    vector.init[u64](a),
        exported:  vector.init[bool](a),
        facts:     vector.init[u32](a),
        definer:   vector.init[u32](a),
        importer:  vector.init[u32](a),
        fielded:   vector.init[bool](a),
        written:   vector.init[u32](a),
        functions: vector.init[Id[Entry]](a),
        tables:    vector.init[Id[Entry]](a),
        memories:  vector.init[Id[Entry]](a),
        globals:   vector.init[Id[Entry]](a),
        tags:      vector.init[Id[Entry]](a),
        segments:  vector.init[Id[Entry]](a),
        types:     vector.init[Id[Entry]](a),
        order:     vector.init[u32](a),
        note:      lowered.make(a),
        holders:   vector.init[u32](a),
        anchors:   vector.init[u32](a),
        code:      vector.init[u32](a),
    };
}

fun release_build(b: *Build) err[Fail] {
    var first: err[Fail] = vectors.release[u32](?b.index);
    first = fail.kept(first, vectors.release[Role](?b.role));
    first = fail.kept(first, vectors.release[u32](?b.place));
    first = fail.kept(first, vectors.release[u64](?b.fstart));
    first = fail.kept(first, vectors.release[u64](?b.dstart));
    first = fail.kept(first, vectors.release[bool](?b.exported));
    first = fail.kept(first, vectors.release[u32](?b.facts));
    first = fail.kept(first, vectors.release[u32](?b.definer));
    first = fail.kept(first, vectors.release[u32](?b.importer));
    first = fail.kept(first, vectors.release[u32](?b.written));
    first = fail.kept(first, vectors.release[bool](?b.fielded));
    first = fail.kept(first, vectors.release[Id[Entry]](?b.functions));
    first = fail.kept(first, vectors.release[Id[Entry]](?b.tables));
    first = fail.kept(first, vectors.release[Id[Entry]](?b.memories));
    first = fail.kept(first, vectors.release[Id[Entry]](?b.globals));
    first = fail.kept(first, vectors.release[Id[Entry]](?b.tags));
    first = fail.kept(first, vectors.release[Id[Entry]](?b.segments));
    first = fail.kept(first, vectors.release[Id[Entry]](?b.types));
    first = fail.kept(first, vectors.release[u32](?b.order));
    first = fail.kept(first, lowered.release(?b.note));
    first = fail.kept(first, vectors.release[u32](?b.holders));
    first = fail.kept(first, vectors.release[u32](?b.anchors));
    first = fail.kept(first, vectors.release[u32](?b.code));
    if (sel b.copy.some) { first = fail.kept(first, object.release(?b.copy.some)); }
    ret first;
}

# the shortest LEB128 form of `v`
fun fit(v: u64) Leb {
    ret Leb{value: v, width: leb128.unsigned_size(v)::u8};
}

fun fit_signed(v: i64) Sleb {
    ret Sleb{value: v, width: leb128.signed_size(v)::u8};
}

# a run of `count` items starting at `first`, its count in its shortest form
fun run_of(first: usize, count: usize) Run {
    ret Run{first: first, count: count, width: leb128.unsigned_size(count::u64)::u8};
}

# the bytes `b`, owned by the module
fun own(b: *Build, bytes: Bytes) res[Held, Fail] {
    ret store.own(?b.m.store, bytes.data, bytes.len);
}

# `h`, a record's bytes borrowed from the object as a parser read them,
# owned by the module instead, so the module outlives the object
fun reown(b: *Build, h: *Held) err[Fail] {
    if (!sel h.borrowed) { ret err[Fail].ok{}; }
    val held: res[Held, Fail] = own(b, h.borrowed);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    @h = held.ok;
    ret err[Fail].ok{};
}

# a name of the object, owned by the module
fun name_out(b: *Build, id: Id[Name]) res[model.Name, Fail] {
    val v: View            = object.name_of(b.o, id);
    val h: res[Held, Fail] = store.own(?b.m.store, v.data::*u8, v.len);
    if (sel h.err) { ret res[model.Name, Fail].err{h.err}; }
    ret res[model.Name, Fail].ok{model.Name{bytes: h.ok, width: leb128.unsigned_size(v.len::u64)::u8}};
}

# the bytes of `c`, zero fill as that many zero bytes, owned by the module
fun contents_out(b: *Build, c: *Contents) res[Held, Fail] {
    if (sel c.held) {
        val bytes: Bytes = object.bytes(b.o, c);
        ret own(b, bytes);
    }
    val n:     u64        = c.zero;
    var zeros: Vector[u8] = vector.init[u8](b.a);
    val g:     err[Fail]  = vectors.grow[u8](?zeros, n::usize);
    if (sel g.err) { ret res[Held, Fail].err{g.err}; }
    val h:     res[Held, Fail] = store.own(?b.m.store, zeros.data, n::usize);
    val freed: err[Fail]       = vectors.release[u8](?zeros);
    if (sel h.err)     { ret h; }
    if (sel freed.err) { ret res[Held, Fail].err{freed.err}; }
    ret h;
}

# the table of entries of the space `sp`, none for a space wasm has no index
# space for
fun entries_of(b: *Build, sp: *Space) opt[*Vector[Id[Entry]]] {
    if (sp == ?space.FUNCTIONS) { ret opt[*Vector[Id[Entry]]].some{?b.functions}; }
    if (sp == ?space.TABLES)    { ret opt[*Vector[Id[Entry]]].some{?b.tables}; }
    if (sp == ?space.MEMORIES)  { ret opt[*Vector[Id[Entry]]].some{?b.memories}; }
    if (sp == ?space.GLOBALS)   { ret opt[*Vector[Id[Entry]]].some{?b.globals}; }
    if (sp == ?space.TAGS)      { ret opt[*Vector[Id[Entry]]].some{?b.tags}; }
    if (sp == ?space.SEGMENTS)  { ret opt[*Vector[Id[Entry]]].some{?b.segments}; }
    if (sp == ?space.TYPES)     { ret opt[*Vector[Id[Entry]]].some{?b.types}; }
    ret opt[*Vector[Id[Entry]]].none{};
}

# the import kind of the space `sp`, none for a space that is no import kind
fun kind_of_space(sp: *Space) opt[u8] {
    if (sp == ?space.FUNCTIONS) { ret opt[u8].some{tables.WASM_EXTERNAL_FUNCTION.value::u8}; }
    if (sp == ?space.TABLES)    { ret opt[u8].some{tables.WASM_EXTERNAL_TABLE.value::u8}; }
    if (sp == ?space.MEMORIES)  { ret opt[u8].some{tables.WASM_EXTERNAL_MEMORY.value::u8}; }
    if (sp == ?space.GLOBALS)   { ret opt[u8].some{tables.WASM_EXTERNAL_GLOBAL.value::u8}; }
    if (sp == ?space.TAGS)      { ret opt[u8].some{tables.WASM_EXTERNAL_TAG.value::u8}; }
    ret opt[u8].none{};
}

# every entry sorted into its space, its index in the space recorded, the
# imports of a space before its definitions
fun entries_out(b: *Build) err[Fail] {
    val n: usize     = table.count[Entry](?b.o.entries);
    val g: err[Fail] = vectors.grow[u32](?b.index, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < n) {
        val e:    *Entry                  = table.at[Entry](?b.o.entries, table.nth[Entry](i));
        val into: opt[*Vector[Id[Entry]]] = entries_of(b, e.space);
        if (sel into.none) { ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("a wasm module has no index space of this name"), e.space.name), "entry", i::u64)}; }
        val count: usize = vector.length[Id[Entry]](into.some);
        if (count != 0 && sel e.import.some) {
            val last: *Entry = table.at[Entry](?b.o.entries, into.some.data[count - 1]);
            if (sel last.import.none) { ret err[Fail].err{fail.in_indexed(fail.unsupported("an import follows a definition in its index space"), "entry", i::u64)}; }
        }
        b.index.data[i] = count::u32;
        val p: err[Fail] = vectors.push[Id[Entry]](into.some, table.nth[Entry](i));
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# whether a fact of `key` is about one entry
fun about_entry(key: u32) bool {
    ret key == fact.TYPE || key == fact.ENTRY_TYPE || key == fact.SEGMENT;
}

# index the facts about entries, the symbol defined at each entry and the
# symbols the export directives name, each once
fun index_out(b: *Build) err[Fail] {
    val n:  usize     = table.count[Entry](?b.o.entries);
    val gf: err[Fail] = vectors.grow[u32](?b.facts, n);
    if (sel gf.err) { ret err[Fail].err{gf.err}; }
    val gd: err[Fail] = vectors.grow[u32](?b.definer, n);
    if (sel gd.err) { ret err[Fail].err{gd.err}; }
    var i: usize = 0;
    for (i < table.count[Fact](?b.o.facts)) {
        val f: *Fact = table.at[Fact](?b.o.facts, table.nth[Fact](i));
        i = i + 1;
        if (f.format != ?format.WASM || !about_entry(f.key)) { cnt; }
        if (f.value >= n::u64)                               { ret err[Fail].err{fail.in_indexed(fail.malformed("a fact is about an entry the object does not hold"), "fact", (i - 1)::u64)}; }
        val at: *u32 = ?b.facts.data[f.value::usize];
        if (@at != 0) { ret err[Fail].err{fail.in_indexed(fail.malformed("two facts are about one entry"), "fact", (i - 1)::u64)}; }
        @at = i::u32;
    }
    val symbols: usize = table.count[object.Symbol](?b.o.symbols);
    var k:       usize = 0;
    for (k < symbols) {
        val s: *object.Symbol = object.symbol_at(b.o, table.nth[object.Symbol](k));
        k = k + 1;
        if (!sel s.def.entry)              { cnt; }
        if (s.def.entry.index::usize >= n) { ret err[Fail].err{fail.in_indexed(fail.malformed("a symbol names an entry the object does not hold"), "symbol", (k - 1)::u64)}; }
        val at: *u32 = ?b.definer.data[s.def.entry.index];
        if (@at == 0) { @at = k::u32; }
    }
    val gi: err[Fail] = vectors.grow[u32](?b.importer, symbols);
    if (sel gi.err) { ret err[Fail].err{gi.err}; }
    val gfs: err[Fail] = vectors.grow[bool](?b.fielded, symbols);
    if (sel gfs.err) { ret err[Fail].err{gfs.err}; }
    i = 0;
    for (i < table.count[Fact](?b.o.facts)) {
        val f: *Fact = table.at[Fact](?b.o.facts, table.nth[Fact](i));
        i = i + 1;
        if (f.format != ?format.WASM || f.key != fact.FIELD_SYMBOL) { cnt; }
        if (f.value >= symbols::u64)                           { ret err[Fail].err{fail.in_indexed(fail.malformed("a fact is about a symbol the object does not hold"), "fact", (i - 1)::u64)}; }
        b.fielded.data[f.value::usize] = true;
    }
    val gw: err[Fail] = vectors.grow[u32](?b.written, symbols);
    if (sel gw.err) { ret err[Fail].err{gw.err}; }
    i = 0;
    for (i < n) {
        val e: *Entry = table.at[Entry](?b.o.entries, table.nth[Entry](i));
        i = i + 1;
        if (sel e.import.none)             { cnt; }
        if (sel e.import.some.symbol.none) { cnt; }
        val sym: Id[object.Symbol] = e.import.some.symbol.some;
        if (sym.index::usize >= symbols) { ret err[Fail].err{fail.in_indexed(fail.malformed("an import names a symbol the object does not hold"), "entry", (i - 1)::u64)}; }
        val at: *u32 = ?b.importer.data[sym.index];
        if (@at != 0) { ret err[Fail].err{fail.in_indexed(fail.unsupported("two imports name one symbol"), "entry", (i - 1)::u64)}; }
        @at = i::u32;
    }
    ret object.exported(b.o, true, ?b.exported);
}

# the fact of `key` about entry `e`, refused when the object states none
fun entry_fact(b: *Build, key: u32, e: Id[Entry]) res[Bytes, Fail] {
    val at: u32 = b.facts.data[e.index];
    if (at != 0) {
        val f: *Fact = table.at[Fact](?b.o.facts, table.nth[Fact](at::usize - 1));
        if (f.key == key) { ret res[Bytes, Fail].ok{object.bytes(b.o, ?f.data)}; }
    }
    ret res[Bytes, Fail].err{fail.in_indexed(fail.unsupported("an entry states no type the module can write"), "entry", e.index::u64)};
}

fun reader_over(bytes: Bytes) Reader {
    ret reader.make(nil, bytes.data, bytes.len, LITTLE);
}

# what a neutral section is: a function body or a segment by the entry that
# names it, a custom section otherwise, with the sections the module cannot
# hold refused
fun roles_out(b: *Build) err[Fail] {
    val n: usize     = table.count[object.Section](?b.o.sections);
    val g: err[Fail] = vectors.grow[Role](?b.role, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    val p: err[Fail] = vectors.grow[u32](?b.place, n);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    var i: usize = 0;
    for (i < n) {
        b.role.data[i] = Role.custom{};
        i              = i + 1;
    }
    i = 0;
    for (i < table.count[Entry](?b.o.entries)) {
        val e: *Entry = table.at[Entry](?b.o.entries, table.nth[Entry](i));
        i = i + 1;
        if (!sel e.body.some) { cnt; }
        val at: Place = e.body.some;
        if (at.offset != 0)               { ret err[Fail].err{fail.in_indexed(fail.unsupported("an entry's body starts inside its section"), "entry", (i - 1)::u64)}; }
        if (at.section.index::usize >= n) { ret err[Fail].err{fail.in_indexed(fail.malformed("an entry's body lies in a section the object does not hold"), "entry", (i - 1)::u64)}; }
        val role: *Role = ?b.role.data[at.section.index];
        if (!sel role.custom)            { ret err[Fail].err{fail.in_indexed(fail.unsupported("two entries name one section as their body"), "entry", (i - 1)::u64)}; }
        if (e.space == ?space.FUNCTIONS) { @role = Role.function{table.nth[Entry](i - 1)}; }
        or (e.space == ?space.SEGMENTS)  { @role = Role.segment{table.nth[Entry](i - 1)}; }
        or                               { ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("an entry of this space has no body"), e.space.name), "entry", (i - 1)::u64)}; }
    }
    i = 0;
    for (i < n) {
        val s:    *object.Section = object.section_at(b.o, table.nth[object.Section](i));
        val role: *Role           = ?b.role.data[i];
        if (sel role.custom) {
            if (s.kind != ?section.DEBUG_INFO && s.kind != ?section.METADATA) {
                ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("a section of this kind that no entry names has no place in a wasm module"), s.kind.name), "section", i::u64)};
            }
            if (sel s.name.none) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a custom section states no name"), "section", i::u64)}; }
            val q: err[Fail] = vectors.push[u32](?b.order, i::u32);
            if (sel q.err) { ret err[Fail].err{q.err}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun push_section(b: *Build, id: u8, body: Body) err[Fail] {
    val p: res[Id[Section], Fail] = table.push[Section](?b.m.sections, Section{id: id, size: Leb{value: 0, width: b.sizes}, body: body});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun push_custom(b: *Build, name: model.Name, body: Body) err[Fail] {
    val p: res[Id[Section], Fail] = table.push[Section](?b.m.sections, Section{id: tables.WASM_SEC_CUSTOM.value::u8, size: Leb{value: 0, width: b.sizes}, name: name, body: body});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    model.note_section(b.m, p.ok);
    ret err[Fail].ok{};
}

fun named_custom(b: *Build, s: str, body: Body) err[Fail] {
    val h: res[Held, Fail] = store.own(?b.m.store, s::*u8, str_len(s));
    if (sel h.err) { ret err[Fail].err{h.err}; }
    ret push_custom(b, model.Name{bytes: h.ok, width: leb128.unsigned_size(str_len(s)::u64)::u8}, body);
}

# the type section: every type entry's fact as a function type
fun types_out(b: *Build) err[Fail] {
    val m:     *Module = b.m;
    val count: usize   = vector.length[Id[Entry]](?b.types);
    if (count == 0) { ret err[Fail].ok{}; }
    val first: usize = vector.length[RecType](?m.recs);
    var i:     usize = 0;
    for (i < count) {
        val start: usize   = vector.length[SubType](?m.types);
        var rec:   RecType = RecType{grouped: false, members: run_of(start, 1)};
        var k:     usize   = 0;
        for (k < rec.members.count) {
            if (i >= count) { ret err[Fail].err{fail.in_indexed(fail.malformed("a recursion group passes the type section"), "type", i::u64)}; }
            val e:     Id[Entry]        = b.types.data[i];
            val bytes: res[Bytes, Fail] = entry_fact(b, fact.TYPE, e);
            if (sel bytes.err) { ret err[Fail].err{bytes.err}; }
            var rd: Reader = reader_over(bytes.ok);
            if (k == 0) {
                val h: res[read.Head, Fail] = read.group_head(?rd);
                if (sel h.err) { ret err[Fail].err{fail.in_indexed(h.err, "type", i::u64)}; }
                rec.grouped       = h.ok.grouped;
                rec.members.count = h.ok.count::usize;
            }
            val t: res[SubType, Fail] = read.sub_type(m, ?rd);
            if (sel t.err) { ret err[Fail].err{fail.in_indexed(t.err, "type", i::u64)}; }
            val d: err[Fail] = read.drained(?rd);
            if (sel d.err) { ret err[Fail].err{fail.in_indexed(d.err, "type", i::u64)}; }
            val p: err[Fail] = vectors.push[SubType](?m.types, t.ok);
            if (sel p.err) { ret err[Fail].err{p.err}; }
            k = k + 1;
            i = i + 1;
        }
        val q: err[Fail] = vectors.push[RecType](?m.recs, rec);
        if (sel q.err) { ret err[Fail].err{q.err}; }
    }
    ret push_section(b, tables.WASM_SEC_TYPE.value::u8, Body.types{run_of(first, vector.length[RecType](?m.recs) - first)});
}

# the type index of the signature of `e`, refused for an entry with none or
# one in another space
fun signature_of(b: *Build, e: *Entry) res[Leb, Fail] {
    if (sel e.signature.none) { ret res[Leb, Fail].err{fail.unsupported("a function states no signature")}; }
    val t: Id[Entry] = e.signature.some;
    if (t.index::usize >= table.count[Entry](?b.o.entries) || table.at[Entry](?b.o.entries, t).space != ?space.TYPES) {
        ret res[Leb, Fail].err{fail.unsupported("a function's signature is no entry of the type space")};
    }
    ret res[Leb, Fail].ok{fit(b.index.data[t.index]::u64)};
}

# the description of an import of `e`, in the space of kind `kind`
fun desc_out(b: *Build, kind: u8, e: Id[Entry]) res[model.Desc, Fail] {
    val m: *Module = b.m;
    if (kind == tables.WASM_EXTERNAL_FUNCTION.value::u8) {
        val t: res[Leb, Fail] = signature_of(b, table.at[Entry](?b.o.entries, e));
        if (sel t.err) { ret res[model.Desc, Fail].err{t.err}; }
        ret res[model.Desc, Fail].ok{model.Desc.function{t.ok}};
    }
    val bytes: res[Bytes, Fail] = entry_fact(b, fact.ENTRY_TYPE, e);
    if (sel bytes.err) { ret res[model.Desc, Fail].err{bytes.err}; }
    var rd:   Reader                = reader_over(bytes.ok);
    var desc: res[model.Desc, Fail] = res[model.Desc, Fail].err{fail.internal("an import kind describes nothing")};
    if (kind == tables.WASM_EXTERNAL_TABLE.value::u8) {
        val t: res[TableType, Fail] = read.table_type(?rd);
        if (sel t.err) { ret res[model.Desc, Fail].err{t.err}; }
        desc = res[model.Desc, Fail].ok{model.Desc.table{t.ok}};
    }
    or (kind == tables.WASM_EXTERNAL_MEMORY.value::u8) {
        val l: res[Limits, Fail] = read.limits(?rd);
        if (sel l.err) { ret res[model.Desc, Fail].err{l.err}; }
        desc = res[model.Desc, Fail].ok{model.Desc.memory{l.ok}};
    }
    or (kind == tables.WASM_EXTERNAL_GLOBAL.value::u8) {
        val g: res[GlobalType, Fail] = read.global_type(?rd);
        if (sel g.err) { ret res[model.Desc, Fail].err{g.err}; }
        desc = res[model.Desc, Fail].ok{model.Desc.global{g.ok}};
    }
    or (kind == tables.WASM_EXTERNAL_TAG.value::u8) {
        val t: res[model.TagType, Fail] = read.tag_type(?rd);
        if (sel t.err) { ret res[model.Desc, Fail].err{t.err}; }
        desc = res[model.Desc, Fail].ok{model.Desc.tag_type{t.ok}};
    }
    val d: err[Fail] = read.drained(?rd);
    if (sel d.err) { ret res[model.Desc, Fail].err{d.err}; }
    ret desc;
}

# the import section: every import entry, in entry order across the spaces,
# which keeps each space's import order and the order among the spaces
fun imports_out(b: *Build) err[Fail] {
    val m:     *Module = b.m;
    val first: usize   = table.count[Import](?m.imports);
    var i:     usize   = 0;
    for (i < table.count[Entry](?b.o.entries)) {
        val id: Id[Entry] = table.nth[Entry](i);
        val e:  *Entry    = table.at[Entry](?b.o.entries, id);
        i = i + 1;
        if (!sel e.import.some) { cnt; }
        val imp:  object.Import = e.import.some;
        val kind: opt[u8]       = kind_of_space(e.space);
        if (sel kind.none)                                { ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("a wasm module imports nothing of this index space"), e.space.name), "entry", id.index::u64)}; }
        if (sel imp.ordinal.some || sel imp.library.some) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a wasm import names no library or ordinal"), "entry", id.index::u64)}; }
        val module: res[model.Name, Fail] = name_out(b, imp.module);
        if (sel module.err) { ret err[Fail].err{module.err}; }
        val field: res[model.Name, Fail] = name_out(b, imp.field);
        if (sel field.err) { ret err[Fail].err{field.err}; }
        val desc: res[model.Desc, Fail] = desc_out(b, kind.some, id);
        if (sel desc.err) { ret err[Fail].err{fail.in_indexed(desc.err, "entry", id.index::u64)}; }
        val p: res[Id[Import], Fail] = table.push[Import](?m.imports, Import{module: module.ok, field: field.ok, kind: kind.some, desc: desc.ok});
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    val count: usize = table.count[Import](?m.imports) - first;
    if (count == 0) { ret err[Fail].ok{}; }
    ret push_section(b, tables.WASM_SEC_IMPORT.value::u8, Body.imports{run_of(first, count)});
}

# the defined entries of the space of `kind`, in entry order
fun defined_out(b: *Build, kind: u8) err[Fail] {
    val m:    *Module                 = b.m;
    val into: opt[*Vector[Id[Entry]]] = entries_of(b, neutral_space(kind));
    if (sel into.none) { ret err[Fail].err{fail.internal("an import kind has no space")}; }
    var first: usize = 0;
    if (kind == tables.WASM_EXTERNAL_FUNCTION.value::u8) { first = vector.length[Leb](?m.functions); }
    if (kind == tables.WASM_EXTERNAL_TABLE.value::u8)    { first = vector.length[TableDef](?m.tables); }
    if (kind == tables.WASM_EXTERNAL_MEMORY.value::u8)   { first = vector.length[Limits](?m.memories); }
    if (kind == tables.WASM_EXTERNAL_GLOBAL.value::u8)   { first = vector.length[Global](?m.globals); }
    if (kind == tables.WASM_EXTERNAL_TAG.value::u8)      { first = vector.length[Tag](?m.tags); }
    var count: usize = 0;
    var i:     usize = 0;
    for (i < vector.length[Id[Entry]](into.some)) {
        val id: Id[Entry] = into.some.data[i];
        val e:  *Entry    = table.at[Entry](?b.o.entries, id);
        i = i + 1;
        if (sel e.import.some) { cnt; }
        count = count + 1;
        if (kind == tables.WASM_EXTERNAL_FUNCTION.value::u8) {
            val t: res[Leb, Fail] = signature_of(b, e);
            if (sel t.err) { ret err[Fail].err{fail.in_indexed(t.err, "entry", id.index::u64)}; }
            val p: err[Fail] = vectors.push[Leb](?m.functions, t.ok);
            if (sel p.err) { ret err[Fail].err{p.err}; }
            cnt;
        }
        val bytes: res[Bytes, Fail] = entry_fact(b, fact.ENTRY_TYPE, id);
        if (sel bytes.err) { ret err[Fail].err{bytes.err}; }
        var rd: Reader    = reader_over(bytes.ok);
        var e2: err[Fail] = err[Fail].ok{};
        if (kind == tables.WASM_EXTERNAL_TABLE.value::u8) {
            val t: res[TableDef, Fail] = read.table_def(?rd);
            if (sel t.err) { ret err[Fail].err{t.err}; }
            var def: TableDef = t.ok;
            if (sel def.init.some) {
                val held: res[Held, Fail] = own(b, model.bytes(m, ?def.init.some.bytes));
                if (sel held.err) { ret err[Fail].err{held.err}; }
                def.init.some.bytes = held.ok;
            }
            val p: err[Fail] = vectors.push[TableDef](?m.tables, def);
            if (sel p.err) { ret err[Fail].err{p.err}; }
        }
        or (kind == tables.WASM_EXTERNAL_MEMORY.value::u8) {
            val l: res[Limits, Fail] = read.limits(?rd);
            if (sel l.err) { ret err[Fail].err{l.err}; }
            val p: err[Fail] = vectors.push[Limits](?m.memories, l.ok);
            if (sel p.err) { ret err[Fail].err{p.err}; }
        }
        or (kind == tables.WASM_EXTERNAL_GLOBAL.value::u8) {
            val g: res[GlobalType, Fail] = read.global_type(?rd);
            if (sel g.err) { ret err[Fail].err{g.err}; }
            val x: res[Expr, Fail] = read.expr(?rd);
            if (sel x.err) { ret err[Fail].err{x.err}; }
            val held: res[Held, Fail] = own(b, model.bytes(m, ?x.ok.bytes));
            if (sel held.err) { ret err[Fail].err{held.err}; }
            val p: err[Fail] = vectors.push[Global](?m.globals, Global{type: g.ok, init: Expr{bytes: held.ok}});
            if (sel p.err) { ret err[Fail].err{p.err}; }
        }
        or {
            val t: res[model.TagType, Fail] = read.tag_type(?rd);
            if (sel t.err) { ret err[Fail].err{t.err}; }
            val p: err[Fail] = vectors.push[Tag](?m.tags, Tag{attribute: t.ok.attribute, type: t.ok.type});
            if (sel p.err) { ret err[Fail].err{p.err}; }
        }
        e2 = read.drained(?rd);
        if (sel e2.err) { ret err[Fail].err{fail.in_indexed(e2.err, "entry", id.index::u64)}; }
    }
    if (count == 0) { ret err[Fail].ok{}; }
    val r: Run = run_of(first, count);
    if (kind == tables.WASM_EXTERNAL_FUNCTION.value::u8) { ret push_section(b, tables.WASM_SEC_FUNCTION.value::u8, Body.functions{r}); }
    if (kind == tables.WASM_EXTERNAL_TABLE.value::u8)    { ret push_section(b, tables.WASM_SEC_TABLE.value::u8, Body.tables{r}); }
    if (kind == tables.WASM_EXTERNAL_MEMORY.value::u8)   { ret push_section(b, tables.WASM_SEC_MEMORY.value::u8, Body.memories{r}); }
    if (kind == tables.WASM_EXTERNAL_GLOBAL.value::u8)   { ret push_section(b, tables.WASM_SEC_GLOBAL.value::u8, Body.globals{r}); }
    ret push_section(b, tables.WASM_SEC_TAG.value::u8, Body.tags{r});
}

# the fact of `key` about nothing in particular, none when the object states
# none
fun lone_fact(b: *Build, key: u32) opt[*Fact] {
    ret object.fact(b.o, ?format.WASM, key);
}

# the export section, from the fact's payload
fun exports_out(b: *Build) err[Fail] {
    val f: opt[*Fact] = lone_fact(b, fact.EXPORTS);
    if (sel f.none) { ret err[Fail].ok{}; }
    val m:    *Module         = b.m;
    var rd:   Reader          = reader_over(object.bytes(b.o, ?f.some.data));
    val body: res[Body, Fail] = read.exports(m, ?rd);
    if (sel body.err) { ret err[Fail].err{body.err}; }
    val d: err[Fail] = read.drained(?rd);
    if (sel d.err)            { ret d; }
    if (!sel body.ok.exports) { ret err[Fail].err{fail.internal("the export parser gave another body")}; }
    val r: Run   = body.ok.exports;
    var i: usize = 0;
    for (i < r.count) {
        val rn: err[Fail] = reown(b, ?m.exports.data[r.first + i].name.bytes);
        if (sel rn.err) { ret rn; }
        i = i + 1;
    }
    ret push_section(b, tables.WASM_SEC_EXPORT.value::u8, body.ok);
}

# refuse an object of a kind a link does not take as an object that holds
# what only a linking or reloc section carries: a symbol, a relocation, a
# group, an init priority, a constant-time range or a record, whose lowering
# relocates its code offsets
fun unlinked(b: *Build) err[Fail] {
    val o: *Object = b.o;
    if (object.has_records(o))                       { ret err[Fail].err{fail.about(fail.unsupported("a wasm file of this kind has no relocations to give its line records their code offsets"), o.kind.name)}; }
    if (table.count[object.Symbol](?o.symbols) != 0) { ret err[Fail].err{fail.about(fail.unsupported("a wasm file of this kind has no symbol table"), o.kind.name)}; }
    if (table.count[object.Reloc](?o.relocs) != 0)   { ret err[Fail].err{fail.about(fail.unsupported("a wasm file of this kind has no relocations"), o.kind.name)}; }
    if (table.count[object.Group](?o.groups) != 0)   { ret err[Fail].err{fail.about(fail.unsupported("a wasm file of this kind has no COMDATs"), o.kind.name)}; }
    if (vector.length[object.CtRange](?o.ct) != 0)   { ret err[Fail].err{fail.about(fail.unsupported("a wasm file of this kind carries no constant-time ranges"), o.kind.name)}; }
    var i: usize = 0;
    for (i < table.count[object.Section](?o.sections)) {
        val s: *object.Section = object.section_at(o, table.nth[object.Section](i));
        if (sel s.priority.some) { ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("a wasm file of this kind has no init functions"), o.kind.name), "section", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun start_out(b: *Build) err[Fail] {
    val f: opt[*Fact] = lone_fact(b, fact.START);
    if (sel f.none) { ret err[Fail].ok{}; }
    ret push_section(b, tables.WASM_SEC_START.value::u8, Body.start{fit(f.some.value)});
}

# the element section: every element fact as a segment
fun elements_out(b: *Build) err[Fail] {
    val m:     *Module = b.m;
    val first: usize   = vector.length[Element](?m.elements);
    var count: usize   = 0;
    var i:     usize   = 0;
    for (i < table.count[Fact](?b.o.facts)) {
        val f: *Fact = table.at[Fact](?b.o.facts, table.nth[Fact](i));
        i = i + 1;
        if (f.format != ?format.WASM || f.key != fact.ELEMENT) { cnt; }
        var rd: Reader             = reader_over(object.bytes(b.o, ?f.data));
        val e:  res[Element, Fail] = read.element(m, ?rd);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "element segment", count::u64)}; }
        val d: err[Fail] = read.drained(?rd);
        if (sel d.err) { ret err[Fail].err{fail.in_indexed(d.err, "element segment", count::u64)}; }
        var el: Element   = e.ok;
        val ro: err[Fail] = reown(b, ?el.offset.bytes);
        if (sel ro.err) { ret ro; }
        if (sel el.items.exprs) {
            var k: usize = 0;
            for (k < el.items.exprs.count) {
                val rx: err[Fail] = reown(b, ?m.exprs.data[el.items.exprs.first + k].bytes);
                if (sel rx.err) { ret rx; }
                k = k + 1;
            }
        }
        val p: err[Fail] = vectors.push[Element](?m.elements, el);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        count = count + 1;
    }
    if (count == 0) { ret err[Fail].ok{}; }
    ret push_section(b, tables.WASM_SEC_ELEM.value::u8, Body.elements{run_of(first, count)});
}

fun datacount_out(b: *Build) err[Fail] {
    val f: opt[*Fact] = lone_fact(b, fact.DATACOUNT);
    if (sel f.none) { ret err[Fail].ok{}; }
    ret push_section(b, tables.WASM_SEC_DATACOUNT.value::u8, Body.datacount{fit(vector.length[Id[Entry]](?b.segments)::u64)});
}

# the code section: the body of every defined function entry, in entry
# order, and where each starts in the payload
fun code_out(b: *Build) err[Fail] {
    val m: *Module   = b.m;
    val n: usize     = table.count[object.Section](?b.o.sections);
    val g: err[Fail] = vectors.grow[u64](?b.fstart, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var count: usize = 0;
    var i:     usize = 0;
    for (i < vector.length[Id[Entry]](?b.functions)) {
        val e: *Entry = table.at[Entry](?b.o.entries, b.functions.data[i]);
        i = i + 1;
        if (sel e.import.some) { cnt; }
        if (!sel e.body.some)  { ret err[Fail].err{fail.in_indexed(fail.unsupported("a defined function states no body"), "entry", (i - 1)::u64)}; }
        count = count + 1;
    }
    if (count == 0) { ret err[Fail].ok{}; }
    val first: usize = vector.length[Function](?m.code);
    i = 0;
    for (i < vector.length[Id[Entry]](?b.functions)) {
        val e: *Entry = table.at[Entry](?b.o.entries, b.functions.data[i]);
        i = i + 1;
        if (sel e.import.some) { cnt; }
        if (!sel e.body.some)  { cnt; }
        val body: Place           = e.body.some;
        val s:    *object.Section = object.section_at(b.o, body.section);
        if (sel s.contents.zero) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a function body is zero fill"), "section", body.section.index::u64)}; }
        val held: res[Held, Fail] = contents_out(b, ?s.contents);
        if (sel held.err) { ret err[Fail].err{held.err}; }
        val len: u64       = model.bytes(m, ?held.ok).len::u64;
        val p:   err[Fail] = vectors.push[Function](?m.code, Function{width: leb128.unsigned_size(len)::u8, body: held.ok});
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    val run: Run       = run_of(first, count);
    val st:  err[Fail] = starts_out(b, ?run);
    if (sel st.err) { ret st; }
    ret push_section(b, tables.WASM_SEC_CODE.value::u8, Body.code{run});
}

# where each body of the code section run `r` starts in the payload, by the
# section of its function, in the order code_out laid them
fun starts_out(b: *Build, r: *Run) err[Fail] {
    var starts: Vector[u64] = vector.init[u64](b.a);
    val st:     err[Fail]   = model.body_starts(b.m, r, ?starts);
    if (sel st.err) { ret fail.kept(st, vectors.release[u64](?starts)); }
    var k: usize = 0;
    var i: usize = 0;
    for (i < vector.length[Id[Entry]](?b.functions)) {
        val e: *Entry = table.at[Entry](?b.o.entries, b.functions.data[i]);
        i = i + 1;
        if (sel e.import.some) { cnt; }
        if (!sel e.body.some)  { cnt; }
        b.fstart.data[e.body.some.section.index] = starts.data[k];
        k                                        = k + 1;
    }
    ret vectors.release[u64](?starts);
}

# the opcode of the constant an address of `a` is written with, i64.const
# for an eight byte address and i32.const for a four byte one
pub fun address_const(a: *Arch) res[u8, Fail] {
    val w: res[u8, Fail] = address_bytes(a);
    if (sel w.err) { ret w; }
    if (w.ok == 8) { ret res[u8, Fail].ok{tables.WASM_OPCODE_I64_CONST.value::u8}; }
    ret res[u8, Fail].ok{tables.WASM_OPCODE_I32_CONST.value::u8};
}

# the value type of a memory address of `a`, i32 or i64 as its memory
# addresses
pub fun address_type(a: *Arch) res[u8, Fail] {
    val w: res[u8, Fail] = address_bytes(a);
    if (sel w.err) { ret w; }
    if (w.ok == 8) { ret res[u8, Fail].ok{tables.WASM_TYPE_I64.value::u8}; }
    ret res[u8, Fail].ok{tables.WASM_TYPE_I32.value::u8};
}

# the width in bytes of a memory address of `a`, four or eight
fun address_bytes(a: *Arch) res[u8, Fail] {
    val w: opt[u8] = arch.pointer_bytes(a);
    if (sel w.none) { ret res[u8, Fail].err{fail.about(fail.unsupported("a wasm module addresses memory through an architecture with no address width"), a.name)}; }
    val bytes: u8 = w.some;
    if (bytes == 8 || bytes == 4) { ret res[u8, Fail].ok{bytes}; }
    ret res[u8, Fail].err{fail.valued(fail.about(fail.unsupported("a wasm memory address is four or eight bytes wide"), a.name), bytes::i128)};
}

# the head of a segment: the one its fact states, or the convention's active
# segment at offset zero of the first memory
fun segment_head(b: *Build, e: Id[Entry], s: *Segment) err[Fail] {
    val at: u32 = b.facts.data[e.index];
    if (at == 0) { ret zero_head(b, s); }
    val f: *Fact = table.at[Fact](?b.o.facts, table.nth[Fact](at::usize - 1));
    if (f.key != fact.SEGMENT) { ret err[Fail].err{fail.in_indexed(fail.malformed("a fact about a data segment is not its head"), "fact", (at - 1)::u64)}; }
    var rd:    Reader         = reader_over(object.bytes(b.o, ?f.data));
    val flags: res[Leb, Fail] = read.uleb(?rd);
    if (sel flags.err) { ret err[Fail].err{flags.err}; }
    s.flags = flags.ok;
    if ((flags.ok.value & tables.WASM_DATA_SEGMENT_HAS_MEMINDEX.value) != 0) {
        val mem: res[Leb, Fail] = read.uleb(?rd);
        if (sel mem.err) { ret err[Fail].err{mem.err}; }
        s.memory = mem.ok;
    }
    if ((flags.ok.value & tables.WASM_DATA_SEGMENT_IS_PASSIVE.value) == 0) {
        val x: res[Expr, Fail] = read.expr(?rd);
        if (sel x.err) { ret err[Fail].err{x.err}; }
        val held: res[Held, Fail] = own(b, model.bytes(b.m, ?x.ok.bytes));
        if (sel held.err) { ret err[Fail].err{held.err}; }
        s.offset = Expr{bytes: held.ok};
    }
    ret read.drained(?rd);
}

# the convention's head: an active segment at offset zero of the first
# memory, the zero in the target's address width
fun zero_head(b: *Build, s: *Segment) err[Fail] {
    val op: res[u8, Fail] = address_const(b.o.target.arch);
    if (sel op.err) { ret err[Fail].err{op.err}; }
    s.flags = fit(0);
    var zero: [3]u8           = [3]u8{op.ok, 0, tables.WASM_OPCODE_END.value::u8};
    val held: res[Held, Fail] = store.own(?b.m.store, ?zero[0], 3);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    s.offset = Expr{bytes: held.ok};
    ret err[Fail].ok{};
}

# the data section: every segment entry's section, in entry order, and where
# each segment's bytes start in the payload
fun data_out(b: *Build) err[Fail] {
    val m: *Module   = b.m;
    val n: usize     = table.count[object.Section](?b.o.sections);
    val g: err[Fail] = vectors.grow[u64](?b.dstart, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    val count: usize = vector.length[Id[Entry]](?b.segments);
    if (count == 0) { ret err[Fail].ok{}; }
    val first: usize = vector.length[Segment](?m.data);
    var at:    u64   = leb128.unsigned_size(count::u64)::u64;
    var i:     usize = 0;
    for (i < count) {
        val id: Id[Entry] = b.segments.data[i];
        val e:  *Entry    = table.at[Entry](?b.o.entries, id);
        if (sel e.import.some) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a data segment is imported"), "entry", id.index::u64)}; }
        if (!sel e.body.some)  { ret err[Fail].err{fail.in_indexed(fail.unsupported("a data segment states no section"), "entry", id.index::u64)}; }
        val body: Place           = e.body.some;
        val s:    *object.Section = object.section_at(b.o, body.section);
        var seg:  Segment;
        val head: err[Fail]       = segment_head(b, id, ?seg);
        if (sel head.err) { ret err[Fail].err{fail.in_indexed(head.err, "entry", id.index::u64)}; }
        val held: res[Held, Fail] = contents_out(b, ?s.contents);
        if (sel held.err) { ret err[Fail].err{held.err}; }
        seg.data = held.ok;
        val len: u64 = model.bytes(m, ?held.ok).len::u64;
        seg.width = leb128.unsigned_size(len)::u8;
        val hs: res[Sink, Fail] = write.segment_head_bytes(b.a, m, ?seg);
        if (sel hs.err) { ret err[Fail].err{hs.err}; }
        var head_sink: Sink = hs.ok;
        at = at + sink.len(?head_sink)::u64 + seg.width::u64;
        val freed: err[Fail] = sink.release(?head_sink);
        if (sel freed.err) { ret freed; }
        b.dstart.data[body.section.index] = at;
        at                                = at + len;
        val p: err[Fail] = vectors.push[Segment](?m.data, seg);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret push_section(b, tables.WASM_SEC_DATA.value::u8, Body.data{run_of(first, count)});
}

# the custom sections, in object order, each raw
fun customs_out(b: *Build) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[u32](?b.order)) {
        val index: u32             = b.order.data[i];
        val s:     *object.Section = object.section_at(b.o, table.nth[object.Section](index::usize));
        if (!sel s.name.some) { ret err[Fail].err{fail.internal("a custom section without a name passed the roles")}; }
        val name: res[model.Name, Fail] = name_out(b, s.name.some);
        if (sel name.err) { ret err[Fail].err{name.err}; }
        val held: res[Held, Fail] = contents_out(b, ?s.contents);
        if (sel held.err) { ret err[Fail].err{held.err}; }
        b.place.data[index] = table.count[Section](?b.m.sections)::u32 + 1;
        val p: err[Fail] = push_custom(b, name.ok, Body.raw{Raw{bytes: held.ok, why: Why.opaque{}}});
        if (sel p.err) { ret p; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the module section index each function body and segment section lands in
fun places_out(b: *Build) {
    val m: *Module = b.m;
    var i: usize   = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = model.section_at(m, table.nth[Section](i));
        var k: usize    = 0;
        if (sel s.body.code) {
            for (k < vector.length[Role](?b.role)) {
                val role: *Role = ?b.role.data[k];
                if (sel role.function) { b.place.data[k] = i::u32 + 1; }
                k = k + 1;
            }
        }
        if (sel s.body.data) {
            for (k < vector.length[Role](?b.role)) {
                val role: *Role = ?b.role.data[k];
                if (sel role.segment) { b.place.data[k] = i::u32 + 1; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
}

# the flags of a symbol: its binding, visibility, retention, export and
# thread locality, and undefined when its entry is an import
fun flags_out(b: *Build, k: usize, s: *object.Symbol, undefined: bool) res[u64, Fail] {
    var f: u64 = 0;
    if (s.binding == ?symbol.WEAKLY) { f = f | tables.WASM_SYMBOL_BINDING_WEAK.value; }
    or (s.binding == ?symbol.LOCAL)  { f = f | tables.WASM_SYMBOL_BINDING_LOCAL.value; }
    or (s.binding != ?symbol.GLOBAL) { ret res[u64, Fail].err{fail.about(fail.unsupported("a wasm symbol has no binding of this name"), s.binding.name)}; }
    val exported: bool                          = b.exported.data[k];
    val vis:      res[*symbol.Visibility, Fail] = symbol.written(?WRITTEN_VISIBILITY, s.visibility, exported);
    if (sel vis.err)                            { ret res[u64, Fail].err{vis.err}; }
    if (!symbol.shows(vis.ok, symbol.EXPORTED)) { f = f | tables.WASM_SYMBOL_VISIBILITY_HIDDEN.value; }
    if (undefined)                              { f = f | tables.WASM_SYMBOL_UNDEFINED.value; }
    if (s.retain)                               { f = f | tables.WASM_SYMBOL_NO_STRIP.value; }
    if (exported)                               { f = f | tables.WASM_SYMBOL_EXPORTED.value; }
    if (symbol.names(s.kind, symbol.THREAD))    { f = f | tables.WASM_SYMBOL_TLS.value; }
    ret res[u64, Fail].ok{f};
}

# the symbol type of an entry of the space `sp`
fun symbol_kind_of(sp: *Space) res[u8, Fail] {
    val kind: opt[u8] = kind_of_space(sp);
    if (sel kind.none)                                        { ret res[u8, Fail].err{fail.about(fail.unsupported("a symbol names an entry of a space no symbol kind names"), sp.name)}; }
    if (kind.some == tables.WASM_EXTERNAL_FUNCTION.value::u8) { ret res[u8, Fail].ok{tables.WASM_SYMBOL_TYPE_FUNCTION.value::u8}; }
    if (kind.some == tables.WASM_EXTERNAL_TABLE.value::u8)    { ret res[u8, Fail].ok{tables.WASM_SYMBOL_TYPE_TABLE.value::u8}; }
    if (kind.some == tables.WASM_EXTERNAL_GLOBAL.value::u8)   { ret res[u8, Fail].ok{tables.WASM_SYMBOL_TYPE_GLOBAL.value::u8}; }
    if (kind.some == tables.WASM_EXTERNAL_TAG.value::u8)      { ret res[u8, Fail].ok{tables.WASM_SYMBOL_TYPE_TAG.value::u8}; }
    ret res[u8, Fail].err{fail.about(fail.unsupported("a symbol names an entry of a space no symbol kind names"), sp.name)};
}

# whether the module writes no symbol for the symbol `k`: one the conversion
# made for an import the symbol table named none for, or a label in a
# function body
fun unwritten(b: *Build, k: usize) bool {
    val label: opt[Place] = code_label(b, k);
    ret b.fielded.data[k] || sel label.some;
}

# the place of the symbol `k` when it is a label in a function body, a local
# symbol of no type at a place in the body, which no wasm symbol names, as a
# function symbol names its function whole. a relocation from a label is
# written from its body's code anchor, its addend moved by the label's offset
fun code_label(b: *Build, k: usize) opt[Place] {
    if (k >= table.count[object.Symbol](?b.o.symbols)) { ret opt[Place].none{}; }
    val s: *object.Symbol = object.symbol_at(b.o, table.nth[object.Symbol](k));
    if (s.binding != ?symbol.LOCAL || s.kind != ?symbol.NOTYPE) { ret opt[Place].none{}; }
    if (!sel s.def.placed)                                      { ret opt[Place].none{}; }
    val at: Place = s.def.placed;
    if (at.section.index::usize >= vector.length[Role](?b.role)) { ret opt[Place].none{}; }
    val role: *Role = ?b.role.data[at.section.index];
    if (!sel role.function) { ret opt[Place].none{}; }
    ret opt[Place].some{at};
}

# the index in the module's symbol table of the neutral symbol `k`, refused
# for one the module writes no symbol for
fun written_index(b: *Build, k: usize) res[u64, Fail] {
    if (k >= vector.length[u32](?b.written)) { ret res[u64, Fail].err{fail.malformed("a symbol index lies past the object's symbols")}; }
    val at: u32 = b.written.data[k];
    if (at == 0) { ret res[u64, Fail].err{fail.unsupported("a relocation names a symbol a wasm module writes none for")}; }
    ret res[u64, Fail].ok{(at - 1)::u64};
}

# the symbol table entry of the neutral symbol `s`
fun symbol_out(b: *Build, k: usize, s: *object.Symbol) res[Symbol, Fail] {
    var out:       Symbol;
    var undefined: bool = false;
    var explicit:  bool = false;
    if (sel s.def.entry) {
        val id: Id[Entry] = s.def.entry;
        if (id.index::usize >= table.count[Entry](?b.o.entries)) { ret res[Symbol, Fail].err{fail.malformed("a symbol names an entry the object does not hold")}; }
        val e:    *Entry  = table.at[Entry](?b.o.entries, id);
        val kind: opt[u8] = kind_of_space(e.space);
        if (sel kind.none)                                        { ret res[Symbol, Fail].err{fail.about(fail.unsupported("a symbol names an entry of a space no symbol kind names"), e.space.name)}; }
        if (kind.some == tables.WASM_EXTERNAL_FUNCTION.value::u8) { out.kind = tables.WASM_SYMBOL_TYPE_FUNCTION.value::u8; }
        or (kind.some == tables.WASM_EXTERNAL_TABLE.value::u8)    { out.kind = tables.WASM_SYMBOL_TYPE_TABLE.value::u8; }
        or (kind.some == tables.WASM_EXTERNAL_GLOBAL.value::u8)   { out.kind = tables.WASM_SYMBOL_TYPE_GLOBAL.value::u8; }
        or (kind.some == tables.WASM_EXTERNAL_TAG.value::u8)      { out.kind = tables.WASM_SYMBOL_TYPE_TAG.value::u8; }
        or                                                        { ret res[Symbol, Fail].err{fail.about(fail.unsupported("a symbol names an entry of a space no symbol kind names"), e.space.name)}; }
        out.index = fit(b.index.data[id.index]::u64);
        if (sel e.import.some) {
            undefined = true;
            val field: View = object.name_of(b.o, e.import.some.field);
            val own:   View = object.name_of(b.o, s.name);
            explicit = field.len != own.len || !memory.raw_equal(field.data::ptr, own.data::ptr, own.len);
        }
    }
    or (sel s.def.placed) {
        val at: Place = s.def.placed;
        if (at.section.index::usize >= vector.length[Role](?b.role)) { ret res[Symbol, Fail].err{fail.malformed("a symbol is placed in a section the object does not hold")}; }
        val role: *Role = ?b.role.data[at.section.index];
        if (sel role.segment) {
            out.kind    = tables.WASM_SYMBOL_TYPE_DATA.value::u8;
            out.segment = fit(b.index.data[role.segment.index]::u64);
            out.offset  = fit(at.offset);
            var size: u64 = 0;
            if (sel s.size.some) { size = s.size.some; }
            out.size = fit(size);
        }
        or (sel role.custom) {
            if (at.offset != 0) { ret res[Symbol, Fail].err{fail.unsupported("a section symbol lies inside its section")}; }
            val place: u32 = b.place.data[at.section.index];
            if (place == 0) { ret res[Symbol, Fail].err{fail.internal("a custom section has no place in the module")}; }
            out.kind  = tables.WASM_SYMBOL_TYPE_SECTION.value::u8;
            out.index = fit((place - 1)::u64);
        }
        or { ret res[Symbol, Fail].err{fail.unsupported("a symbol placed inside a function body has no wasm form")}; }
    }
    or (sel s.def.absolute) {
        out.kind   = tables.WASM_SYMBOL_TYPE_DATA.value::u8;
        out.offset = fit(s.def.absolute);
        var size: u64 = 0;
        if (sel s.size.some) { size = s.size.some; }
        out.size = fit(size);
    }
    or (sel s.def.undefined) {
        undefined = true;
        val imp: u32 = b.importer.data[k];
        if (imp != 0) {
            val e:    *Entry        = table.at[Entry](?b.o.entries, table.nth[Entry]((imp - 1)::usize));
            val kind: res[u8, Fail] = symbol_kind_of(e.space);
            if (sel kind.err) { ret res[Symbol, Fail].err{kind.err}; }
            out.kind  = kind.ok;
            out.index = fit(b.index.data[imp - 1]::u64);
            if (sel e.import.some) { explicit = e.import.some.stays; }
        }
        or {
            if (!symbol.names(s.kind, symbol.OBJECT)) { ret res[Symbol, Fail].err{fail.about(fail.unsupported("an undefined symbol of this kind names no import entry"), s.kind.name)}; }
            out.kind = tables.WASM_SYMBOL_TYPE_DATA.value::u8;
        }
    }
    or { ret res[Symbol, Fail].err{fail.unsupported("a common symbol has no wasm form")}; }
    val flags: res[u64, Fail] = flags_out(b, k, s, undefined);
    if (sel flags.err) { ret res[Symbol, Fail].err{flags.err}; }
    var f: u64 = flags.ok;
    if (sel s.def.absolute) { f = f | tables.WASM_SYMBOL_ABSOLUTE.value; }
    if (explicit)           { f = f | tables.WASM_SYMBOL_EXPLICIT_NAME.value; }
    out.flags = fit(f);
    out.named = model.symbol_named(out.kind, f);
    if (out.named) {
        val n: res[model.Name, Fail] = name_out(b, s.name);
        if (sel n.err) { ret res[Symbol, Fail].err{n.err}; }
        out.name = n.ok;
    }
    ret res[Symbol, Fail].ok{out};
}

# the symbol table subsection
fun symbols_out(b: *Build) res[Subsection, Fail] {
    val m:     *Module = b.m;
    val first: usize   = table.count[Symbol](?m.symbols);
    val count: usize   = table.count[object.Symbol](?b.o.symbols);
    var k:     usize   = 0;
    for (k < count) {
        if (unwritten(b, k)) {
            k = k + 1;
            cnt;
        }
        val s: res[Symbol, Fail] = symbol_out(b, k, object.symbol_at(b.o, table.nth[object.Symbol](k)));
        if (sel s.err) { ret res[Subsection, Fail].err{fail.in_indexed(s.err, "symbol", k::u64)}; }
        val p: res[Id[Symbol], Fail] = table.push[Symbol](?m.symbols, s.ok);
        if (sel p.err) { ret res[Subsection, Fail].err{p.err}; }
        b.written.data[k] = (p.ok.index::usize - first + 1)::u32;
        k                 = k + 1;
    }
    val an: err[Fail] = anchors_out(b, first);
    if (sel an.err) { ret res[Subsection, Fail].err{an.err}; }
    val ca: err[Fail] = code_anchors_out(b, first);
    if (sel ca.err) { ret res[Subsection, Fail].err{ca.err}; }
    ret res[Subsection, Fail].ok{Subsection{id: tables.WASM_SYMBOL_TABLE.value::u8, width: PADDED, body: Subbody.symbols{run_of(first, table.count[Symbol](?m.symbols) - first)}}};
}

# the local symbol each section the mink note's records name is anchored
# by, after the object's own symbols in the symbol table that starts at
# `first` among the module's symbols: a function symbol of a function body,
# a data symbol at the start of a segment and a section symbol of a custom
# section, as the tool conventions' Linking document gives section symbols
# to custom sections alone
fun anchors_out(b: *Build, first: usize) err[Fail] {
    val g: err[Fail] = vectors.grow[u32](?b.anchors, vector.length[Role](?b.role));
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < table.count[Fixup](?b.note.fixups)) {
        val f: *Fixup = lowered.fixup_at(?b.note, table.nth[Fixup](i));
        i = i + 1;
        if (!(sel f.target.label)) { ret err[Fail].err{fail.malformed("a mink note field is relocated from no label")}; }
        val n: usize = lowered.label_at(?b.note, f.target.label).section.index::usize;
        if (b.anchors.data[n] != 0) { cnt; }
        val role: *Role = ?b.role.data[n];
        var out:  Symbol;
        out.flags = fit(tables.WASM_SYMBOL_BINDING_LOCAL.value);
        if (sel role.function) {
            out.kind  = tables.WASM_SYMBOL_TYPE_FUNCTION.value::u8;
            out.index = fit(b.index.data[role.function.index]::u64);
        }
        or (sel role.segment) {
            out.kind    = tables.WASM_SYMBOL_TYPE_DATA.value::u8;
            out.segment = fit(b.index.data[role.segment.index]::u64);
            out.offset  = fit(0);
            out.size    = fit(0);
        }
        or {
            out.kind  = tables.WASM_SYMBOL_TYPE_SECTION.value::u8;
            out.index = fit((b.place.data[n] - 1)::u64);
        }
        val p: res[u32, Fail] = anchor_out(b, out, first);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        b.anchors.data[n] = p.ok;
    }
    ret err[Fail].ok{};
}

# the anchor `out`, named as the note's section where its kind takes a
# name, answering its index in the symbol table, which starts at `first`
# among the module's symbols, plus one
fun anchor_out(b: *Build, anchor: Symbol, first: usize) res[u32, Fail] {
    var out: Symbol = anchor;
    out.named = model.symbol_named(out.kind, out.flags.value);
    if (out.named) {
        val len:  usize           = str_len(wasm_mark.SECTION);
        val held: res[Held, Fail] = store.own(?b.m.store, wasm_mark.SECTION::*u8, len);
        if (sel held.err) { ret res[u32, Fail].err{held.err}; }
        out.name = model.Name{bytes: held.ok, width: leb128.unsigned_size(len::u64)::u8};
    }
    val p: res[Id[Symbol], Fail] = table.push[Symbol](?b.m.symbols, out);
    if (sel p.err) { ret res[u32, Fail].err{p.err}; }
    ret res[u32, Fail].ok{(p.ok.index::usize - first + 1)::u32};
}

# the code anchor of each function body a relocation from a label in it is
# written from, after the note's anchors in the symbol table that starts at
# `first` among the module's symbols: a local function symbol of the body's
# function, named as the label is. the note's anchors are not shared, as a
# reader drops a symbol only the note names
fun code_anchors_out(b: *Build, first: usize) err[Fail] {
    val g: err[Fail] = vectors.grow[u32](?b.code, vector.length[Role](?b.role));
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < table.count[object.Reloc](?b.o.relocs)) {
        val r: *object.Reloc = table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](i));
        i = i + 1;
        if (!sel r.target.symbol) { cnt; }
        val k:  usize      = r.target.symbol.index::usize;
        val at: opt[Place] = code_label(b, k);
        if (sel at.none) { cnt; }
        val n: usize = at.some.section.index::usize;
        if (b.code.data[n] != 0) { cnt; }
        val role: *Role = ?b.role.data[n];
        if (!sel role.function) { ret err[Fail].err{fail.internal("a label lies in a section that is no function body")}; }
        val name: res[model.Name, Fail] = name_out(b, object.symbol_at(b.o, table.nth[object.Symbol](k)).name);
        if (sel name.err) { ret err[Fail].err{name.err}; }
        var out: Symbol;
        out.kind  = tables.WASM_SYMBOL_TYPE_FUNCTION.value::u8;
        out.flags = fit(tables.WASM_SYMBOL_BINDING_LOCAL.value);
        out.index = fit(b.index.data[role.function.index]::u64);
        out.named = model.symbol_named(out.kind, out.flags.value);
        out.name  = name.ok;
        val p: res[Id[Symbol], Fail] = table.push[Symbol](?b.m.symbols, out);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        b.code.data[n] = (p.ok.index::usize - first + 1)::u32;
    }
    ret err[Fail].ok{};
}

# the record of the relocation `r` from a label at `at` in a function body,
# at `offset` of its module section: the function offset of its width from
# the body's code anchor, its addend the label's offset in the body moved by
# its own
fun code_reloc(b: *Build, r: *object.Reloc, offset: Leb, at: Place) res[Reloc, Fail] {
    val k: res[*reloc.Kind, Fail] = wasm_reloc.code_offset(r.kind);
    if (sel k.err) { ret res[Reloc, Fail].err{k.err}; }
    val found: res[*Row, Fail] = row.writing(b.set, k.ok);
    if (sel found.err) { ret res[Reloc, Fail].err{found.err}; }
    val anchor: u32 = b.code.data[at.section.index];
    if (anchor == 0) { ret res[Reloc, Fail].err{fail.internal("a function body a label lies in has no code anchor")}; }
    val sum: i128 = at.offset::i128 + r.addend::i128;
    if (sum < -0x8000_0000 || sum > 0x7fff_ffff) { ret res[Reloc, Fail].err{fail.valued(fail.overflow("a label's place lies past what a function offset's addend holds"), sum)}; }
    var out: Reloc;
    out.type   = found.ok.key::u8;
    out.offset = offset;
    out.index  = fit((anchor - 1)::u64);
    out.addend = fit_signed(sum::i64);
    ret res[Reloc, Fail].ok{out};
}

# the log2 of a power of two alignment
fun log2_of(align: u64) res[u64, Fail] {
    if (align == 0 || (align & (align - 1)) != 0) { ret res[u64, Fail].err{fail.valued(fail.malformed("a section alignment is not a power of two"), align::i128)}; }
    var n: u64 = 0;
    for ((1::u64 << n) != align) {
        n = n + 1;
    }
    ret res[u64, Fail].ok{n};
}

# the segment info subsection: the name, alignment and flags of every segment
fun seginfo_out(b: *Build) res[Subsection, Fail] {
    val m:     *Module = b.m;
    val first: usize   = vector.length[SegmentInfo](?m.segment_infos);
    val count: usize   = vector.length[Id[Entry]](?b.segments);
    var i:     usize   = 0;
    for (i < count) {
        val e: *Entry = table.at[Entry](?b.o.entries, b.segments.data[i]);
        if (!sel e.body.some) { ret res[Subsection, Fail].err{fail.internal("a segment without a section passed the data section")}; }
        val s:    *object.Section       = object.section_at(b.o, e.body.some.section);
        var name: res[model.Name, Fail] = res[model.Name, Fail].err{fail.internal("a segment is unnamed")};
        if (sel s.name.some) { name = name_out(b, s.name.some); }
        or {
            val n: res[str, Fail] = segment_name(section.key_of(s.kind, s.entsize));
            if (sel n.err) { ret res[Subsection, Fail].err{fail.in_indexed(n.err, "section", e.body.some.section.index::u64)}; }
            val h: res[Held, Fail] = store.own(?m.store, n.ok::*u8, str_len(n.ok));
            if (sel h.err) { ret res[Subsection, Fail].err{h.err}; }
            name = res[model.Name, Fail].ok{model.Name{bytes: h.ok, width: leb128.unsigned_size(str_len(n.ok)::u64)::u8}};
        }
        if (sel name.err) { ret res[Subsection, Fail].err{name.err}; }
        val align: res[u64, Fail] = log2_of(s.align);
        if (sel align.err) { ret res[Subsection, Fail].err{fail.in_indexed(align.err, "section", e.body.some.section.index::u64)}; }
        var flags: u64 = 0;
        if ((s.flags & section.STRINGS) != 0) { flags = flags | tables.WASM_SEG_FLAG_STRINGS.value; }
        if ((s.flags & section.TLS) != 0)     { flags = flags | tables.WASM_SEG_FLAG_TLS.value; }
        if ((s.flags & section.RETAIN) != 0)  { flags = flags | tables.WASM_SEG_FLAG_RETAIN.value; }
        val p: err[Fail] = vectors.push[SegmentInfo](?m.segment_infos, SegmentInfo{name: name.ok, align: fit(align.ok), flags: fit(flags)});
        if (sel p.err) { ret res[Subsection, Fail].err{p.err}; }
        i = i + 1;
    }
    ret res[Subsection, Fail].ok{Subsection{id: tables.WASM_SEGMENT_INFO.value::u8, width: PADDED, body: Subbody.segments{run_of(first, count)}}};
}

# the symbol defining the function entry `e`, for an init function
fun defining_symbol(b: *Build, e: Id[Entry]) res[u64, Fail] {
    val at: u32 = b.definer.data[e.index];
    if (at == 0) { ret res[u64, Fail].err{fail.unsupported("an init function has no symbol to name it by")}; }
    ret written_index(b, (at - 1)::usize);
}

# the init functions subsection: every function section with a priority,
# none when there is none
fun inits_out(b: *Build) res[opt[Subsection], Fail] {
    val m:     *Module = b.m;
    val first: usize   = vector.length[InitFunc](?m.inits);
    var count: usize   = 0;
    var i:     usize   = 0;
    for (i < vector.length[Role](?b.role)) {
        val role: *Role           = ?b.role.data[i];
        val s:    *object.Section = object.section_at(b.o, table.nth[object.Section](i));
        i = i + 1;
        if (!sel s.priority.some) { cnt; }
        if (!sel role.function)   { ret res[opt[Subsection], Fail].err{fail.in_indexed(fail.unsupported("a section that is no function body states a priority"), "section", (i - 1)::u64)}; }
        val sym: res[u64, Fail] = defining_symbol(b, role.function);
        if (sel sym.err) { ret res[opt[Subsection], Fail].err{fail.in_indexed(sym.err, "section", (i - 1)::u64)}; }
        val p: err[Fail] = vectors.push[InitFunc](?m.inits, InitFunc{priority: fit(s.priority.some::u64), symbol: fit(sym.ok)});
        if (sel p.err) { ret res[opt[Subsection], Fail].err{p.err}; }
        count = count + 1;
    }
    if (count == 0) { ret res[opt[Subsection], Fail].ok{opt[Subsection].none{}}; }
    ret res[opt[Subsection], Fail].ok{opt[Subsection].some{Subsection{id: tables.WASM_INIT_FUNCS.value::u8, width: PADDED, body: Subbody.inits{run_of(first, count)}}}};
}

# the COMDAT item a section is as a member: its kind and index
fun member_out(b: *Build, i: usize) res[ComdatItem, Fail] {
    val role: *Role = ?b.role.data[i];
    if (sel role.function) {
        ret res[ComdatItem, Fail].ok{ComdatItem{kind: tables.WASM_COMDAT_FUNCTION.value::u8, index: fit(b.index.data[role.function.index]::u64)}};
    }
    if (sel role.segment) {
        ret res[ComdatItem, Fail].ok{ComdatItem{kind: tables.WASM_COMDAT_DATA.value::u8, index: fit(b.index.data[role.segment.index]::u64)}};
    }
    val place: u32 = b.place.data[i];
    if (place == 0) { ret res[ComdatItem, Fail].err{fail.internal("a custom section has no place in the module")}; }
    ret res[ComdatItem, Fail].ok{ComdatItem{kind: tables.WASM_COMDAT_SECTION.value::u8, index: fit((place - 1)::u64)}};
}

# the COMDAT info subsection: every group with its members, none when the
# object has no group
fun comdats_out(b: *Build) res[opt[Subsection], Fail] {
    val m:     *Module = b.m;
    val count: usize   = table.count[object.Group](?b.o.groups);
    if (count == 0) { ret res[opt[Subsection], Fail].ok{opt[Subsection].none{}}; }
    val first:   usize                      = vector.length[Comdat](?m.comdats);
    var buckets: Vector[u32]                = vector.init[u32](b.a);
    val r:       res[opt[Subsection], Fail] = comdats_bucketed(b, ?buckets, first, count);
    val freed:   err[Fail]                  = vectors.release[u32](?buckets);
    if (sel r.err)     { ret r; }
    if (sel freed.err) { ret res[opt[Subsection], Fail].err{freed.err}; }
    ret r;
}

# the members of every group, bucketed by group in one pass over the
# sections, then each group's COMDAT with its members in section order
fun comdats_bucketed(b: *Build, buckets: *Vector[u32], first: usize, count: usize) res[opt[Subsection], Fail] {
    val m:        *Module   = b.m;
    val sections: usize     = table.count[object.Section](?b.o.sections);
    val g:        err[Fail] = vectors.grow[u32](buckets, count + 1 + sections);
    if (sel g.err) { ret res[opt[Subsection], Fail].err{g.err}; }
    val starts:  *u32  = buckets.data;
    val members: *u32  = ?starts[count + 1];
    var i:       usize = 0;
    for (i < sections) {
        val s: *object.Section = object.section_at(b.o, table.nth[object.Section](i));
        i = i + 1;
        if (!sel s.group.some)                  { cnt; }
        if (s.group.some.index::usize >= count) { ret res[opt[Subsection], Fail].err{fail.in_indexed(fail.malformed("a section is a member of a group the object does not hold"), "section", (i - 1)::u64)}; }
        starts[s.group.some.index + 1] = starts[s.group.some.index + 1] + 1;
    }
    i = 0;
    for (i < count) {
        starts[i + 1] = starts[i + 1] + starts[i];
        i             = i + 1;
    }
    var fill: Vector[u32] = vector.init[u32](b.a);
    val gf:   err[Fail]   = vectors.grow[u32](?fill, count);
    if (sel gf.err) { ret res[opt[Subsection], Fail].err{gf.err}; }
    i = 0;
    for (i < sections) {
        val s: *object.Section = object.section_at(b.o, table.nth[object.Section](i));
        i = i + 1;
        if (!sel s.group.some) { cnt; }
        val at: *u32 = ?fill.data[s.group.some.index];
        members[starts[s.group.some.index] + @at] = (i - 1)::u32;
        @at                                       = @at + 1;
    }
    val freed: err[Fail] = vectors.release[u32](?fill);
    if (sel freed.err) { ret res[opt[Subsection], Fail].err{freed.err}; }
    var gi: usize = 0;
    for (gi < count) {
        val grp: *object.Group = object.group_at(b.o, table.nth[object.Group](gi));
        if (grp.rule != ?group.ANY) { ret res[opt[Subsection], Fail].err{fail.in_indexed(fail.about(fail.unsupported("a wasm COMDAT keeps any copy, so a group of this rule has no wasm form"), grp.rule.name), "group", gi::u64)}; }
        val name: res[model.Name, Fail] = name_out(b, grp.signature);
        if (sel name.err) { ret res[opt[Subsection], Fail].err{name.err}; }
        val items: usize = vector.length[ComdatItem](?m.comdat_items);
        var k:     usize = starts[gi]::usize;
        for (k < starts[gi + 1]::usize) {
            val it: res[ComdatItem, Fail] = member_out(b, members[k]::usize);
            if (sel it.err) { ret res[opt[Subsection], Fail].err{it.err}; }
            val p: err[Fail] = vectors.push[ComdatItem](?m.comdat_items, it.ok);
            if (sel p.err) { ret res[opt[Subsection], Fail].err{p.err}; }
            k = k + 1;
        }
        val p: err[Fail] = vectors.push[Comdat](?m.comdats, Comdat{name: name.ok, flags: fit(0), items: run_of(items, (starts[gi + 1] - starts[gi])::usize)});
        if (sel p.err) { ret res[opt[Subsection], Fail].err{p.err}; }
        gi = gi + 1;
    }
    ret res[opt[Subsection], Fail].ok{opt[Subsection].some{Subsection{id: tables.WASM_COMDAT_INFO.value::u8, width: PADDED, body: Subbody.comdats{run_of(first, count)}}}};
}

fun push_subsection(b: *Build, s: Subsection) err[Fail] {
    val p: err[Fail] = vectors.push[Subsection](?b.m.subsections, s);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the linking section: the symbol table, when the object states a symbol or
# the mink note anchors one, the segment info, the init functions and the
# COMDAT info
fun linking_out(b: *Build) err[Fail] {
    val m:     *Module               = b.m;
    val first: usize                 = vector.length[Subsection](?m.subsections);
    val syms:  res[Subsection, Fail] = symbols_out(b);
    if (sel syms.err) { ret err[Fail].err{syms.err}; }
    if (table.count[object.Symbol](?b.o.symbols) != 0 || table.count[Symbol](?m.symbols) != 0) {
        val p1: err[Fail] = push_subsection(b, syms.ok);
        if (sel p1.err) { ret p1; }
    }
    if (vector.length[Id[Entry]](?b.segments) != 0) {
        val segs: res[Subsection, Fail] = seginfo_out(b);
        if (sel segs.err) { ret err[Fail].err{segs.err}; }
        val p2: err[Fail] = push_subsection(b, segs.ok);
        if (sel p2.err) { ret p2; }
    }
    val inits: res[opt[Subsection], Fail] = inits_out(b);
    if (sel inits.err) { ret err[Fail].err{inits.err}; }
    if (sel inits.ok.some) {
        val p3: err[Fail] = push_subsection(b, inits.ok.some);
        if (sel p3.err) { ret p3; }
    }
    val comdats: res[opt[Subsection], Fail] = comdats_out(b);
    if (sel comdats.err) { ret err[Fail].err{comdats.err}; }
    if (sel comdats.ok.some) {
        val p4: err[Fail] = push_subsection(b, comdats.ok.some);
        if (sel p4.err) { ret p4; }
    }
    val count: usize = vector.length[Subsection](?m.subsections) - first;
    ret named_custom(b, LINKING_NAME, Body.linking{Linking{version: fit(tables.METADATA_VERSION), subsections: Run{first: first, count: count, width: 0}}});
}

# the record of the relocation `r`, in the module section the section it
# patches lands in
fun reloc_out(b: *Build, r: *object.Reloc) res[Reloc, Fail] {
    val found: res[*Row, Fail] = row.writing(b.set, r.kind);
    if (sel found.err)    { ret res[Reloc, Fail].err{found.err}; }
    if (sel r.minus.some) { ret res[Reloc, Fail].err{fail.unsupported("a wasm relocation subtracts no symbol")}; }
    var out: Reloc;
    out.type = found.ok.key::u8;
    val role: *Role = ?b.role.data[r.section.index];
    var base: u64   = 0;
    if (sel role.function) { base = b.fstart.data[r.section.index]; }
    or (sel role.segment)  { base = b.dstart.data[r.section.index]; }
    out.offset = fit(base + r.offset);
    if (sel r.target.entry) {
        val e: *Entry = table.at[Entry](?b.o.entries, r.target.entry);
        if (e.space != ?space.TYPES || found.ok.kind != ?wasm_reloc.TYPE_INDEX_LEB) { ret res[Reloc, Fail].err{fail.unsupported("only a type index relocation names an entry, of the type space")}; }
        out.index = fit(b.index.data[r.target.entry.index]::u64);
    }
    or (sel r.target.symbol) {
        if (found.ok.kind == ?wasm_reloc.TYPE_INDEX_LEB) { ret res[Reloc, Fail].err{fail.unsupported("a type index relocation names a type entry, not a symbol")}; }
        val label: opt[Place] = code_label(b, r.target.symbol.index::usize);
        if (sel label.some) { ret code_reloc(b, r, out.offset, label.some); }
        val w: res[u64, Fail] = written_index(b, r.target.symbol.index::usize);
        if (sel w.err) { ret res[Reloc, Fail].err{w.err}; }
        out.index = fit(w.ok);
    }
    or (sel r.target.absolute)      { ret res[Reloc, Fail].err{fail.unsupported("wasm has no relocation against the absolute address zero")}; }
    or                              { ret res[Reloc, Fail].err{fail.unsupported("a wasm relocation names a target")}; }
    if (sel found.ok.addend.record) { out.addend = fit_signed(r.addend); }
    or (r.addend != 0)              { ret res[Reloc, Fail].err{fail.valued(fail.unsupported("a relocation of this type carries no addend"), r.addend::i128)}; }
    ret res[Reloc, Fail].ok{out};
}

# the name of the reloc section of module section `index`: `reloc.` and the
# type name of a core section or the name of a custom one
fun reloc_name(b: *Build, index: usize) res[model.Name, Fail] {
    val s:   *Section  = model.section_at(b.m, table.nth[Section](index));
    var out: Sink      = sink.make(b.a, LITTLE);
    var e:   err[Fail] = sink.text(?out, RELOC_PREFIX);
    if (model.is_custom(s)) {
        val n: Bytes = model.name_bytes(b.m, ?s.name);
        e = fail.kept(e, sink.bytes(?out, n.data, n.len));
    }
    or {
        val row: opt[*tables.Constant] = tables.name_of(?tables.SEC, s.id::u64);
        if (sel row.some) { e = fail.kept(e, sink.text(?out, ?row.some.name[9])); }
        or                { e = fail.kept(e, err[Fail].err{fail.internal("a module section has an id no row names")}); }
    }
    if (sel e.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret res[model.Name, Fail].err{e.err};
    }
    val len:   usize           = sink.len(?out);
    val held:  res[Held, Fail] = store.own(?b.m.store, sink.data(?out), len);
    val freed: err[Fail]       = sink.release(?out);
    if (sel held.err)  { ret res[model.Name, Fail].err{held.err}; }
    if (sel freed.err) { ret res[model.Name, Fail].err{freed.err}; }
    ret res[model.Name, Fail].ok{model.Name{bytes: held.ok, width: leb128.unsigned_size(len::u64)::u8}};
}

# a reloc section per module section that holds a relocated section, in
# module section order, its records in object order
fun relocs_out(b: *Build) err[Fail] {
    var buckets: Vector[u32] = vector.init[u32](b.a);
    val r:       err[Fail]   = relocs_bucketed(b, ?buckets);
    ret fail.kept(r, vectors.release[u32](?buckets));
}

# the relocations bucketed by the module section they land in, in one pass,
# then a reloc section per module section with any, its records in object
# order
fun relocs_bucketed(b: *Build, buckets: *Vector[u32]) err[Fail] {
    val m:        *Module   = b.m;
    val sections: usize     = table.count[Section](?m.sections);
    val count:    usize     = table.count[object.Reloc](?b.o.relocs);
    val g:        err[Fail] = vectors.grow[u32](buckets, sections + 1 + count);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    val starts: *u32  = buckets.data;
    val order:  *u32  = ?starts[sections + 1];
    var i:      usize = 0;
    for (i < count) {
        val r: *object.Reloc = table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](i));
        i = i + 1;
        if (r.section.index::usize >= vector.length[u32](?b.place)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a relocation patches a section the object does not hold"), "relocation", (i - 1)::u64)}; }
        val place: u32 = b.place.data[r.section.index];
        if (place == 0) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a relocation patches a section with no place in the module"), "relocation", (i - 1)::u64)}; }
        starts[place] = starts[place] + 1;
    }
    i = 0;
    for (i < sections) {
        starts[i + 1] = starts[i + 1] + starts[i];
        i             = i + 1;
    }
    var fill: Vector[u32] = vector.init[u32](b.a);
    val gf:   err[Fail]   = vectors.grow[u32](?fill, sections);
    if (sel gf.err) { ret err[Fail].err{gf.err}; }
    i = 0;
    for (i < count) {
        val r:     *object.Reloc = table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](i));
        val place: usize         = b.place.data[r.section.index]::usize - 1;
        val at:    *u32          = ?fill.data[place];
        order[starts[place] + @at] = i::u32;
        @at                        = @at + 1;
        i                          = i + 1;
    }
    val freed: err[Fail] = vectors.release[u32](?fill);
    if (sel freed.err) { ret freed; }
    var t: usize = 0;
    for (t < sections) {
        val n: usize = (starts[t + 1] - starts[t])::usize;
        t = t + 1;
        if (n == 0) { cnt; }
        val first: usize = vector.length[Reloc](?m.relocs);
        var k:     usize = starts[t - 1]::usize;
        for (k < starts[t]::usize) {
            val index: usize            = order[k]::usize;
            val rec:   res[Reloc, Fail] = reloc_out(b, table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](index)));
            if (sel rec.err) { ret err[Fail].err{fail.in_indexed(rec.err, "relocation", index::u64)}; }
            val p: err[Fail] = vectors.push[Reloc](?m.relocs, rec.ok);
            if (sel p.err) { ret err[Fail].err{p.err}; }
            k = k + 1;
        }
        val name: res[model.Name, Fail] = reloc_name(b, t - 1);
        if (sel name.err) { ret err[Fail].err{name.err}; }
        val e: err[Fail] = push_custom(b, name.ok, Body.relocs{Relocs{section: fit((t - 1)::u64), entries: run_of(first, n)}});
        if (sel e.err) { ret e; }
    }
    ret err[Fail].ok{};
}

# the sections of the mink note, after the custom sections, each its
# payload
fun note_out(b: *Build) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Added](?b.note.sections)) {
        val s:    *Added          = lowered.section_at(?b.note, table.nth[Added](i));
        val held: res[Held, Fail] = store.own(?b.m.store, sink.data(?s.bytes), sink.len(?s.bytes));
        if (sel held.err) { ret err[Fail].err{held.err}; }
        val at: err[Fail] = vectors.push[u32](?b.holders, table.count[Section](?b.m.sections)::u32);
        if (sel at.err) { ret err[Fail].err{at.err}; }
        val p: err[Fail] = named_custom(b, s.name, Body.raw{Raw{bytes: held.ok, why: Why.opaque{}}});
        if (sel p.err) { ret p; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the record types the mink note's fields are relocated by: a function
# offset, a memory address and a section offset
rec NoteKeys {
    function: u8;
    data:     u8;
    custom:   u8;
}

# the record of the mink note's relocation `f`, from the anchor of the
# section its label lies in, its addend the label's offset in that section
# moved by the fixup's: a function offset from a function body's anchor, a
# memory address from a segment's and a section offset from a custom
# section's
fun noted_out(b: *Build, f: *Fixup, keys: *NoteKeys) res[Reloc, Fail] {
    if (!(sel f.target.label)) { ret res[Reloc, Fail].err{fail.malformed("a mink note field is relocated from no label")}; }
    val label: *Place = lowered.label_at(?b.note, f.target.label);
    val role:  *Role  = ?b.role.data[label.section.index];
    val sym:   u32    = b.anchors.data[label.section.index];
    if (sym == 0) { ret res[Reloc, Fail].err{fail.internal("a section the mink note names has no anchor")}; }
    var key: u8 = keys.custom;
    if (sel role.function) { key = keys.function; }
    or (sel role.segment)  { key = keys.data; }
    val sum: i128 = label.offset::i128 + f.addend::i128;
    if (sum < 0 || sum > 0x7fff_ffff) { ret res[Reloc, Fail].err{fail.valued(fail.overflow("a constant-time range lies past what an anchor's addend holds"), sum)}; }
    var out: Reloc;
    out.type   = key;
    out.offset = fit(f.offset);
    out.index  = fit((sym - 1)::u64);
    out.addend = fit_signed(sum::i64);
    ret res[Reloc, Fail].ok{out};
}

# a reloc section per section of the mink note, after the object's own
fun note_relocs_out(b: *Build) err[Fail] {
    val n: usize = table.count[Fixup](?b.note.fixups);
    if (n == 0) { ret err[Fail].ok{}; }
    val function: res[*Row, Fail] = row.by_kind(b.set, ?wasm_reloc.FUNCTION_OFFSET_I32);
    if (sel function.err) { ret err[Fail].err{function.err}; }
    val data: res[*Row, Fail] = row.by_kind(b.set, ?reloc.ABS32);
    if (sel data.err) { ret err[Fail].err{data.err}; }
    val custom: res[*Row, Fail] = row.by_kind(b.set, ?reloc.SECREL32);
    if (sel custom.err) { ret err[Fail].err{custom.err}; }
    var keys: NoteKeys = NoteKeys{function: function.ok.key::u8, data: data.ok.key::u8, custom: custom.ok.key::u8};
    var h:    usize    = 0;
    for (h < vector.length[u32](?b.holders)) {
        val first: usize = vector.length[Reloc](?b.m.relocs);
        var i:     usize = 0;
        for (i < n) {
            val f: *Fixup = lowered.fixup_at(?b.note, table.nth[Fixup](i));
            i = i + 1;
            if (f.section.index::usize != h) { cnt; }
            val rec: res[Reloc, Fail] = noted_out(b, f, ?keys);
            if (sel rec.err) { ret err[Fail].err{fail.in_indexed(rec.err, "constant-time relocation", (i - 1)::u64)}; }
            val p: err[Fail] = vectors.push[Reloc](?b.m.relocs, rec.ok);
            if (sel p.err) { ret err[Fail].err{p.err}; }
        }
        val at:   usize                 = b.holders.data[h]::usize;
        val name: res[model.Name, Fail] = reloc_name(b, at);
        if (sel name.err) { ret err[Fail].err{name.err}; }
        val e: err[Fail] = push_custom(b, name.ok, Body.relocs{Relocs{section: fit(at::u64), entries: run_of(first, vector.length[Reloc](?b.m.relocs) - first)}});
        if (sel e.err) { ret e; }
        h = h + 1;
    }
    ret err[Fail].ok{};
}

# the producers section, from its fact
fun producers_out(b: *Build) err[Fail] {
    val f: opt[*Fact] = lone_fact(b, fact.PRODUCERS);
    if (sel f.none) { ret err[Fail].ok{}; }
    val m:    *Module         = b.m;
    var rd:   Reader          = reader_over(object.bytes(b.o, ?f.some.data));
    val body: res[Body, Fail] = read.producers(m, ?rd);
    if (sel body.err) { ret err[Fail].err{fail.in_record(body.err, PRODUCER_NAME)}; }
    val d: err[Fail] = read.drained(?rd);
    if (sel d.err)              { ret err[Fail].err{fail.in_record(d.err, PRODUCER_NAME)}; }
    if (!sel body.ok.producers) { ret err[Fail].err{fail.internal("the producers parser gave another body")}; }
    val r: Run   = body.ok.producers;
    var i: usize = 0;
    for (i < r.count) {
        val pr: *model.Producer = ?m.producers.data[r.first + i];
        val rn: err[Fail]       = reown(b, ?pr.name.bytes);
        if (sel rn.err) { ret rn; }
        var k: usize = 0;
        for (k < pr.values.count) {
            val v:  *model.Versioned = ?m.versioned.data[pr.values.first + k];
            val rv: err[Fail]        = fail.kept(reown(b, ?v.name.bytes), reown(b, ?v.version.bytes));
            if (sel rv.err) { ret rv; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret named_custom(b, PRODUCER_NAME, body.ok);
}

# the target features section, from the object's trait
fun features_out(b: *Build) err[Fail] {
    val stated: opt[Setting] = object.stated(b.o, ?wasm.WASM_FEATURES);
    if (sel stated.none)      { ret err[Fail].ok{}; }
    if (!sel stated.some.set) { ret err[Fail].err{fail.internal("the target features trait holds no set")}; }
    var held: Held           = stated.some.set;
    val run:  res[Run, Fail] = features_of(b.m, store.bytes(?b.o.store, ?held));
    if (sel run.err) { ret err[Fail].err{run.err}; }
    ret named_custom(b, FEATURES_NAME, Body.features{run.ok});
}

# the features of the set `text`, written as the target features trait
# writes one, added to the module `m`
pub fun features_of(m: *Module, text: Bytes) res[Run, Fail] {
    val first: usize = vector.length[Feature](?m.features);
    var count: usize = 0;
    var at:    usize = 0;
    for (at < text.len) {
        var end: usize = at;
        for (end < text.len && text.data[end] != COMMA) {
            end = end + 1;
        }
        if (end - at < 2) { ret res[Run, Fail].err{fail.in_record(fail.malformed("a target feature states no prefix and name"), FEATURES_NAME)}; }
        val held: res[Held, Fail] = store.own(?m.store, ?text.data[at + 1], end - at - 1);
        if (sel held.err) { ret res[Run, Fail].err{held.err}; }
        val p: err[Fail] = vectors.push[Feature](?m.features, Feature{prefix: text.data[at], name: model.Name{bytes: held.ok, width: leb128.unsigned_size((end - at - 1)::u64)::u8}});
        if (sel p.err) { ret res[Run, Fail].err{p.err}; }
        count = count + 1;
        at    = end + 1;
    }
    ret res[Run, Fail].ok{run_of(first, count)};
}

# build from a copy of the object with its records lowered in the encodings
# the lowering names, so the object the caller handed over stays as it was.
# an object with none is built from as it is
fun lowered_in(b: *Build) err[Fail] {
    if (!object.has_records(b.o)) { ret err[Fail].ok{}; }
    val c: res[Object, Fail] = object.copy(b.a, b.o);
    if (sel c.err) { ret err[Fail].err{c.err}; }
    b.copy = opt[Object].some{c.ok};
    if (sel b.copy.some) { b.o = ?b.copy.some; }
    ret encode.apply(b.lowering, b.o, b.set, b.pair.mapping);
}

fun build(b: *Build, rows: *row.Registry) err[Fail] {
    val set: res[*Lookup, Fail] = row.find(rows, ?format.WASM, b.o.target.arch);
    if (sel set.err) { ret err[Fail].err{set.err}; }
    b.set = set.ok;
    val linked: bool = catalog_kind.has(b.o.kind, catalog_kind.OBJECT);
    b.sizes = PADDED;
    if (!linked) {
        b.sizes = model.SHORTEST;
        val u: err[Fail] = unlinked(b);
        if (sel u.err) { ret u; }
    }
    val l0: err[Fail] = lowered_in(b);
    if (sel l0.err) { ret l0; }
    val e0: err[Fail] = wasm_mark.lower(b.o, ?b.note);
    if (sel e0.err) { ret e0; }
    val e1: err[Fail] = entries_out(b);
    if (sel e1.err) { ret e1; }
    val e2: err[Fail] = index_out(b);
    if (sel e2.err) { ret e2; }
    val e3: err[Fail] = roles_out(b);
    if (sel e3.err) { ret e3; }
    val e4: err[Fail] = types_out(b);
    if (sel e4.err) { ret e4; }
    val e5: err[Fail] = imports_out(b);
    if (sel e5.err) { ret e5; }
    val e6: err[Fail] = defined_out(b, tables.WASM_EXTERNAL_FUNCTION.value::u8);
    if (sel e6.err) { ret e6; }
    val e7: err[Fail] = defined_out(b, tables.WASM_EXTERNAL_TABLE.value::u8);
    if (sel e7.err) { ret e7; }
    val e8: err[Fail] = defined_out(b, tables.WASM_EXTERNAL_MEMORY.value::u8);
    if (sel e8.err) { ret e8; }
    val e9: err[Fail] = defined_out(b, tables.WASM_EXTERNAL_TAG.value::u8);
    if (sel e9.err) { ret e9; }
    val e10: err[Fail] = defined_out(b, tables.WASM_EXTERNAL_GLOBAL.value::u8);
    if (sel e10.err) { ret e10; }
    val x10: err[Fail] = exports_out(b);
    if (sel x10.err) { ret x10; }
    val e11: err[Fail] = start_out(b);
    if (sel e11.err) { ret e11; }
    val e12: err[Fail] = elements_out(b);
    if (sel e12.err) { ret e12; }
    val e13: err[Fail] = datacount_out(b);
    if (sel e13.err) { ret e13; }
    val e14: err[Fail] = code_out(b);
    if (sel e14.err) { ret e14; }
    val e15: err[Fail] = data_out(b);
    if (sel e15.err) { ret e15; }
    val e16: err[Fail] = customs_out(b);
    if (sel e16.err) { ret e16; }
    val n16: err[Fail] = note_out(b);
    if (sel n16.err) { ret n16; }
    places_out(b);
    if (linked) {
        val e17: err[Fail] = linking_out(b);
        if (sel e17.err) { ret e17; }
        val e18: err[Fail] = relocs_out(b);
        if (sel e18.err) { ret e18; }
        val n18: err[Fail] = note_relocs_out(b);
        if (sel n18.err) { ret n18; }
    }
    val e19: err[Fail] = producers_out(b);
    if (sel e19.err) { ret e19; }
    val e20: err[Fail] = features_out(b);
    if (sel e20.err) { ret e20; }
    ret model.index_imports(b.m);
}

# the module the neutral object `o` holds, for the target `t`, which must be
# a wasm architecture, its relocations written through the rows of `rows`
# and the records it states lowered in the encodings `l` names. `o` stays as
# it was
pub fun from(a: *A.Allocator, rows: *row.Registry, o: *Object, t: *Target, l: opt[*Lowering]) res[ptr, Fail] {
    val p: res[*Pair, Fail] = wasm_reloc.of(t.arch);
    if (sel p.err) { ret res[ptr, Fail].err{p.err}; }
    val versioned: opt[usize] = object.first_versioned(o);
    if (sel versioned.some) { ret res[ptr, Fail].err{fail.in_indexed(fail.unsupported("wasm has no symbol versions"), "symbol", versioned.some::u64)}; }
    val slot: res[*Module, A.Error] = A.allocate[Module](a, 1);
    if (sel slot.err) { ret res[ptr, Fail].err{fail.refused(slot.err)}; }
    val m: *Module = slot.ok;
    @m        = model.make(a);
    m.version = tables.VERSION::u32;
    var b: Build     = make_build(a, o, m, p.ok, l);
    val r: err[Fail] = fail.kept(build(?b, rows), release_build(?b));
    if (sel r.err) {
        val dropped: err[Fail]    = model.release(m);
        val freed:   err[A.Error] = A.deallocate[Module](a, m, 1);
        ret res[ptr, Fail].err{r.err};
    }
    ret res[ptr, Fail].ok{m::ptr};
}
