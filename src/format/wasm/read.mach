# the custom sections the tool conventions name
val LINKING:  str = "linking";
val RELOC:    str = "reloc.";
val NAMES:    str = "name";
val PRODUCER: str = "producers";
val FEATURES: str = "target_features";
val DYLINK:   str = "dylink.0";

# the name subsections that are name maps and indirect name maps
val MAP_COUNT:      usize              = 8;
val MAPS:           [MAP_COUNT]u8      = [MAP_COUNT]u8{1, 4, 5, 6, 7, 8, 9, 11};
val INDIRECT_COUNT: usize              = 2;
val INDIRECTS:      [INDIRECT_COUNT]u8 = [INDIRECT_COUNT]u8{2, 10};

# read `in` as a wasm module. the model borrows the bytes of `in` and every
# table of it lives in `a`, so give it back with model.dnit
pub fun read(a: *A.Allocator, in: *Input) res[Module, Fail] {
    var m:        Module    = model.init(a);
    val err_fill: err[Fail] = fill(?m, in);
    if (sel err_fill.err) {
        val err_dropped: err[Fail] = model.dnit(?m);
        ret res[Module, Fail].err{fail.in_file(err_fill.err, in.file)};
    }
    ret res[Module, Fail].ok{m};
}

# the header and every section of `in` into `m`, then the imports indexed
# by kind
fun fill(m: *Module, in: *Input) err[Fail] {
    var file:       Reader    = shell.reader_make(in, LITTLE);
    val err_header: err[Fail] = header(m, ?file);
    if (sel err_header.err) { ret err_header; }
    var opt_last: opt[u8] = opt[u8].none{};
    var index:    u64     = 0;
    for (reader.remaining(?file) > 0) {
        val err_section: err[Fail] = section(m, ?file, index, ?opt_last);
        if (sel err_section.err) { ret err[Fail].err{fail.in_indexed(err_section.err, "section", index)}; }
        index = index + 1;
    }
    ret model.index_imports(m);
}

fun header(m: *Module, file: *Reader) err[Fail] {
    val res_magic: res[*u8, Fail] = reader.bytes(file, model.MAGIC_LEN::u64);
    if (sel res_magic.err) { ret err[Fail].err{fail.in_record(res_magic.err, "module header")}; }
    if (!memory.raw_equal(res_magic.ok::ptr, (?model.MAGIC[0])::ptr, model.MAGIC_LEN)) {
        ret err[Fail].err{fail.at_offset(fail.in_record(fail.malformed("not a wasm module"), "module header"), 0)};
    }
    val res_version: res[u32, Fail] = reader.u32(file);
    if (sel res_version.err) { ret err[Fail].err{fail.in_record(res_version.err, "module header")}; }
    if (res_version.ok::u64 != tables.VERSION) {
        ret err[Fail].err{fail.valued(fail.at_offset(fail.in_record(fail.malformed("unknown version"), "module header"), model.MAGIC_LEN::u64), res_version.ok::i128)};
    }
    m.version = res_version.ok;
    ret err[Fail].ok{};
}

# one section: its header, then its payload decoded or held raw
fun section(m: *Module, file: *Reader, index: u64, last: *opt[u8]) err[Fail] {
    var s: Section;
    s.at = reader.offset(file);
    val res_u8: res[u8, Fail] = reader.u8(file);
    if (sel res_u8.err) { ret err[Fail].err{res_u8.err}; }
    s.id = res_u8.ok;
    val res_size: res[Leb, Fail] = uleb(file);
    if (sel res_size.err) { ret err[Fail].err{res_size.err}; }
    s.size    = res_size.ok;
    s.payload = reader.offset(file);
    val res_sub: res[Reader, Fail] = reader.sub(file, file.pos::u64, res_size.ok.value);
    if (sel res_sub.err) { ret err[Fail].err{fail.valued(fail.at_offset(fail.truncated("section runs past the end of the file"), s.payload), res_size.ok.value::i128)}; }
    val res_skipped: res[usize, Fail] = reader.seek(file, file.pos::u64 + res_size.ok.value);
    if (sel res_skipped.err) { ret err[Fail].err{res_skipped.err}; }
    var rd: Reader = res_sub.ok;
    if (!model.is_custom(?s)) {
        val opt_rank: opt[u8] = model.rank(s.id);
        if (sel opt_rank.none) { ret err[Fail].err{fail.valued(fail.at_offset(fail.malformed("unknown section id"), s.at), s.id::i128)}; }
        if (sel last.some && opt_rank.some <= last.some) {
            ret err[Fail].err{fail.valued(fail.at_offset(fail.malformed("section out of order"), s.at), s.id::i128)};
        }
        @last = opt[u8].some{opt_rank.some};
    }
    or {
        val res_name: res[Name, Fail] = name(m, ?rd);
        if (sel res_name.err) { ret err[Fail].err{fail.in_record(res_name.err, "section name")}; }
        s.name = res_name.ok;
    }
    val k:        Mark            = model.mark(m);
    val start:    usize           = rd.pos;
    val res_body: res[Body, Fail] = decode(m, ?s, ?rd);
    if (sel res_body.ok) { s.body = res_body.ok; }
    or (sel res_body.err) {
        if (!holdable(res_body.err)) { ret err[Fail].err{res_body.err}; }
        model.truncate(m, k);
        val res_back: res[usize, Fail] = reader.seek(?rd, start::u64);
        if (sel res_back.err) { ret err[Fail].err{res_back.err}; }
        val res_rest: res[Held, Fail] = rest(?rd);
        if (sel res_rest.err) { ret err[Fail].err{res_rest.err}; }
        s.body = Body.raw{Raw{bytes: res_rest.ok, why: Why.unsupported{}}};
    }
    val res_pushed: res[Id[Section], Fail] = table.push[Section](?m.sections, s);
    if (sel res_pushed.err) { ret err[Fail].err{res_pushed.err}; }
    model.note_section(m, res_pushed.ok);
    ret err[Fail].ok{};
}

# whether a failure inside a bounded extent holds the extent raw: a record
# that does not parse or runs past the extent. an oversized count, a refused
# allocation and a failure of mink itself are never held raw
fun holdable(f: Fail) bool {
    if (sel f.cause.malformed) { ret true; }
    if (sel f.cause.truncated) { ret true; }
    ret false;
}

# the payload of a section as its id, or its name, says to decode it. a
# payload with bytes left after its last record does not parse
fun decode(m: *Module, s: *Section, rd: *Reader) res[Body, Fail] {
    if (model.is_custom(s)) { ret custom(m, s, rd); }
    val res_core: res[Body, Fail] = core(m, s.id, rd);
    if (sel res_core.err) { ret res_core; }
    val err_drained: err[Fail] = drained(rd);
    if (sel err_drained.err) { ret res[Body, Fail].err{err_drained.err}; }
    ret res_core;
}

fun core(m: *Module, id: u8, rd: *Reader) res[Body, Fail] {
    if (id == tables.WASM_SEC_TYPE.value::u8)      { ret types(m, rd); }
    if (id == tables.WASM_SEC_IMPORT.value::u8)    { ret imports(m, rd); }
    if (id == tables.WASM_SEC_FUNCTION.value::u8)  { ret functions(m, rd); }
    if (id == tables.WASM_SEC_TABLE.value::u8)     { ret table_types(m, rd); }
    if (id == tables.WASM_SEC_MEMORY.value::u8)    { ret memories(m, rd); }
    if (id == tables.WASM_SEC_GLOBAL.value::u8)    { ret globals(m, rd); }
    if (id == tables.WASM_SEC_EXPORT.value::u8)    { ret exports(m, rd); }
    if (id == tables.WASM_SEC_START.value::u8)     { ret start(rd); }
    if (id == tables.WASM_SEC_ELEM.value::u8)      { ret elements(m, rd); }
    if (id == tables.WASM_SEC_CODE.value::u8)      { ret code(m, rd); }
    if (id == tables.WASM_SEC_DATA.value::u8)      { ret data(m, rd); }
    if (id == tables.WASM_SEC_DATACOUNT.value::u8) { ret datacount(rd); }
    if (id == tables.WASM_SEC_TAG.value::u8)       { ret tags(m, rd); }
    ret res[Body, Fail].err{fail.internal("a section id with a rank has no decoder")};
}

# a custom section by its name. one no convention names is held raw as opaque
fun custom(m: *Module, s: *Section, rd: *Reader) res[Body, Fail] {
    val n:           Bytes = model.name_bytes(m, ?s.name);
    var res_linking: res[Body, Fail];
    if (is(n, LINKING))        { res_linking = linking(m, rd); }
    or (starts_with(n, RELOC)) { res_linking = relocs(m, rd); }
    or (is(n, NAMES))          { res_linking = names(m, rd); }
    or (is(n, PRODUCER))       { res_linking = producers(m, rd); }
    or (is(n, FEATURES))       { res_linking = features(m, rd); }
    or (is(n, DYLINK))         { res_linking = dylink(m, rd); }
    or {
        val res_rest: res[Held, Fail] = rest(rd);
        if (sel res_rest.err) { ret res[Body, Fail].err{res_rest.err}; }
        ret res[Body, Fail].ok{Body.raw{Raw{bytes: res_rest.ok, why: Why.opaque{}}}};
    }
    if (sel res_linking.err) { ret res_linking; }
    val err_drained: err[Fail] = drained(rd);
    if (sel err_drained.err) { ret res[Body, Fail].err{err_drained.err}; }
    ret res_linking;
}

fun is(n: Bytes, want: str) bool {
    val len: usize = str_len(want);
    ret n.len == len && memory.raw_equal(n.data::ptr, want::ptr, len);
}

fun starts_with(n: Bytes, want: str) bool {
    val len: usize = str_len(want);
    ret n.len >= len && memory.raw_equal(n.data::ptr, want::ptr, len);
}

# the bytes left in `rd` after its last record, which must be none
pub fun drained(rd: *Reader) err[Fail] {
    if (reader.remaining(rd) != 0) {
        ret err[Fail].err{fail.at_offset(fail.malformed("bytes follow the last record"), reader.offset(rd))};
    }
    ret err[Fail].ok{};
}

# the rest of `rd`, borrowed
fun rest(rd: *Reader) res[Held, Fail] {
    val n:         usize          = reader.remaining(rd);
    val res_bytes: res[*u8, Fail] = reader.bytes(rd, n::u64);
    if (sel res_bytes.err) { ret res[Held, Fail].err{res_bytes.err}; }
    ret res[Held, Fail].ok{Held.borrowed{Bytes{data: res_bytes.ok, len: n}}};
}

# an unsigned LEB128 number with the width it took
pub fun uleb(rd: *Reader) res[Leb, Fail] {
    val before:   usize          = rd.pos;
    val res_uleb: res[u64, Fail] = reader.uleb(rd);
    if (sel res_uleb.err) { ret res[Leb, Fail].err{res_uleb.err}; }
    ret res[Leb, Fail].ok{Leb{value: res_uleb.ok, width: (rd.pos - before)::u8}};
}

# a signed LEB128 number with the width it took
pub fun sleb(rd: *Reader) res[Sleb, Fail] {
    val before:   usize          = rd.pos;
    val res_sleb: res[i64, Fail] = reader.sleb(rd);
    if (sel res_sleb.err) { ret res[Sleb, Fail].err{res_sleb.err}; }
    ret res[Sleb, Fail].ok{Sleb{value: res_sleb.ok, width: (rd.pos - before)::u8}};
}

# a vector count. every item takes a byte at least, so a count larger than
# the bytes left cannot be met and is refused before any table grows
pub fun count(rd: *Reader) res[Run, Fail] {
    val at:       u64            = reader.offset(rd);
    val res_uleb: res[Leb, Fail] = uleb(rd);
    if (sel res_uleb.err) { ret res[Run, Fail].err{res_uleb.err}; }
    if (res_uleb.ok.value > reader.remaining(rd)::u64) {
        ret res[Run, Fail].err{fail.valued(fail.at_offset(fail.overflow("vector count exceeds the bytes of its section"), at), res_uleb.ok.value::i128)};
    }
    ret res[Run, Fail].ok{Run{first: 0, count: res_uleb.ok.value::usize, width: res_uleb.ok.width}};
}

# a name: a length and that many bytes, borrowed
pub fun name(m: *Module, rd: *Reader) res[Name, Fail] {
    val res_len: res[Leb, Fail] = uleb(rd);
    if (sel res_len.err) { ret res[Name, Fail].err{res_len.err}; }
    val res_bytes: res[*u8, Fail] = reader.bytes(rd, res_len.ok.value);
    if (sel res_bytes.err) { ret res[Name, Fail].err{res_bytes.err}; }
    ret res[Name, Fail].ok{Name{bytes: Held.borrowed{Bytes{data: res_bytes.ok, len: res_len.ok.value::usize}}, width: res_len.ok.width}};
}

fun byte(rd: *Reader) res[u8, Fail] {
    ret reader.u8(rd);
}

# the index an opcode of a constant expression names, as written
# ---
# nothing:    the opcode names no index
# function:   a function, by an unsigned index
# global:     a global, by an unsigned index
# type_index: a type, by an unsigned index
# heap:       a type, by the index of a heap type, which is signed
pub tag Names: u8 {
    nothing;
    function:   Leb;
    global:     Leb;
    type_index: Leb;
    heap:       Sleb;
}

# one opcode of a constant expression with the index it names
# ---
# code:  the opcode, the prefix of a prefixed one
# sub:   the opcode after the prefix, of a prefixed one
# names: the index its immediates name
# at:    where in the reader's bytes that index starts
# end:   where it ends
pub rec Step {
    code:  u64;
    sub:   u64;
    names: Names;
    at:    usize;
    end:   usize;
}

# the next opcode of a constant expression with its immediates. the opcodes
# are the ones a constant expression may hold, and any other does not parse
pub fun step(rd: *Reader) res[Step, Fail] {
    val res_byte: res[u8, Fail] = byte(rd);
    if (sel res_byte.err) { ret res[Step, Fail].err{res_byte.err}; }
    val code: u64 = res_byte.ok::u64;
    if (code == tables.WASM_OPCODE_END.value) {}
    or (code == tables.WASM_OPCODE_I32_CONST.value || code == tables.WASM_OPCODE_I64_CONST.value) {
        val res_sleb: res[Sleb, Fail] = sleb(rd);
        if (sel res_sleb.err) { ret res[Step, Fail].err{res_sleb.err}; }
    }
    or (code == tables.WASM_OPCODE_GLOBAL_GET.value) {
        val at:       usize          = rd.pos;
        val res_uleb: res[Leb, Fail] = uleb(rd);
        if (sel res_uleb.err) { ret res[Step, Fail].err{res_uleb.err}; }
        ret res[Step, Fail].ok{Step{code: code, names: Names.global{res_uleb.ok}, at: at, end: rd.pos}};
    }
    or (code == tables.WASM_OPCODE_REF_FUNC.value) {
        val at:       usize          = rd.pos;
        val res_uleb: res[Leb, Fail] = uleb(rd);
        if (sel res_uleb.err) { ret res[Step, Fail].err{res_uleb.err}; }
        ret res[Step, Fail].ok{Step{code: code, names: Names.function{res_uleb.ok}, at: at, end: rd.pos}};
    }
    or (code == tables.WASM_OPCODE_F32_CONST.value) {
        val res_bytes: res[*u8, Fail] = reader.bytes(rd, 4);
        if (sel res_bytes.err) { ret res[Step, Fail].err{res_bytes.err}; }
    }
    or (code == tables.WASM_OPCODE_F64_CONST.value) {
        val res_bytes: res[*u8, Fail] = reader.bytes(rd, 8);
        if (sel res_bytes.err) { ret res[Step, Fail].err{res_bytes.err}; }
    }
    or (code == tables.WASM_OPCODE_REF_NULL.value) {
        val at:            usize           = rd.pos;
        val res_heap_type: res[Heap, Fail] = heap_type(rd);
        if (sel res_heap_type.err)      { ret res[Step, Fail].err{res_heap_type.err}; }
        if (sel res_heap_type.ok.index) { ret res[Step, Fail].ok{Step{code: code, names: Names.heap{res_heap_type.ok.index}, at: at, end: rd.pos}}; }
    }
    or (code == tables.WASM_OPCODE_SIMD_PREFIX.value) { ret simd(rd); }
    or (code == tables.WASM_OPCODE_GC_PREFIX.value)   { ret gc(rd); }
    or (arithmetic(code))                             {}
    or {
        ret res[Step, Fail].err{fail.valued(fail.at_offset(fail.malformed("an opcode a constant expression does not hold"), reader.offset(rd) - 1), code::i128)};
    }
    ret res[Step, Fail].ok{Step{code: code}};
}

# a constant expression, its end opcode included, borrowed
pub fun expr(rd: *Reader) res[Expr, Fail] {
    val start: usize = rd.pos;
    for {
        val res_stepped: res[Step, Fail] = step(rd);
        if (sel res_stepped.err)                                 { ret res[Expr, Fail].err{res_stepped.err}; }
        if (res_stepped.ok.code == tables.WASM_OPCODE_END.value) { brk; }
    }
    ret res[Expr, Fail].ok{Expr{bytes: Held.borrowed{Bytes{data: ?rd.data[start], len: rd.pos - start}}}};
}

# the instruction after a SIMD prefix a constant expression holds, v128.const
# and its sixteen bytes
fun simd(rd: *Reader) res[Step, Fail] {
    val at:       u64            = reader.offset(rd);
    val res_uleb: res[Leb, Fail] = uleb(rd);
    if (sel res_uleb.err) { ret res[Step, Fail].err{res_uleb.err}; }
    if (res_uleb.ok.value != tables.WASM_OPCODE_V128_CONST.value) {
        ret res[Step, Fail].err{fail.valued(fail.at_offset(fail.malformed("a SIMD opcode a constant expression does not hold"), at), res_uleb.ok.value::i128)};
    }
    val res_bytes: res[*u8, Fail] = reader.bytes(rd, 16);
    if (sel res_bytes.err) { ret res[Step, Fail].err{res_bytes.err}; }
    ret res[Step, Fail].ok{Step{code: tables.WASM_OPCODE_SIMD_PREFIX.value, sub: res_uleb.ok.value}};
}

# the instruction after a GC prefix a constant expression holds: an
# allocation of a struct or an array, which names its type and, for
# array.new_fixed, its length, or a conversion with no immediate
fun gc(rd: *Reader) res[Step, Fail] {
    val at:       u64            = reader.offset(rd);
    val res_uleb: res[Leb, Fail] = uleb(rd);
    if (sel res_uleb.err) { ret res[Step, Fail].err{res_uleb.err}; }
    val sub: u64  = res_uleb.ok.value;
    var s:   Step = Step{code: tables.WASM_OPCODE_GC_PREFIX.value, sub: sub};
    if (sub == tables.WASM_OPCODE_STRUCT_NEW.value || sub == tables.WASM_OPCODE_STRUCT_NEW_DEFAULT.value || sub == tables.WASM_OPCODE_ARRAY_NEW.value
        || sub == tables.WASM_OPCODE_ARRAY_NEW_DEFAULT.value || sub == tables.WASM_OPCODE_ARRAY_NEW_FIXED.value) {
        s.at = rd.pos;
        val res_uleb: res[Leb, Fail] = uleb(rd);
        if (sel res_uleb.err) { ret res[Step, Fail].err{res_uleb.err}; }
        s.names = Names.type_index{res_uleb.ok};
        s.end   = rd.pos;
        if (sub == tables.WASM_OPCODE_ARRAY_NEW_FIXED.value) {
            val res_uleb: res[Leb, Fail] = uleb(rd);
            if (sel res_uleb.err) { ret res[Step, Fail].err{res_uleb.err}; }
        }
    }
    or (sub == tables.WASM_OPCODE_REF_I31.value || sub == tables.WASM_OPCODE_ANY_CONVERT_EXTERN.value || sub == tables.WASM_OPCODE_EXTERN_CONVERT_ANY.value) {}
    or {
        ret res[Step, Fail].err{fail.valued(fail.at_offset(fail.malformed("a GC opcode a constant expression does not hold"), at), sub::i128)};
    }
    ret res[Step, Fail].ok{s};
}

fun arithmetic(code: u64) bool {
    ret code == tables.WASM_OPCODE_I32_ADD.value || code == tables.WASM_OPCODE_I32_SUB.value || code == tables.WASM_OPCODE_I32_MUL.value || code == tables.WASM_OPCODE_I64_ADD.value || code == tables.WASM_OPCODE_I64_SUB.value || code == tables.WASM_OPCODE_I64_MUL.value;
}

# the bits a limits flags byte may carry
val LIMITS_MASK: u8 = 0xf;

# limits: the flags byte, the minimum, then the maximum and the page size
# when the flags say they are written. flags outside LIMITS_MASK do not parse
pub fun limits(rd: *Reader) res[Limits, Fail] {
    var l:         Limits;
    val res_flags: res[u8, Fail] = byte(rd);
    if (sel res_flags.err) { ret res[Limits, Fail].err{res_flags.err}; }
    if ((res_flags.ok & ~LIMITS_MASK) != 0) {
        ret res[Limits, Fail].err{fail.valued(fail.at_offset(fail.malformed("unknown limits flags"), reader.offset(rd) - 1), res_flags.ok::i128)};
    }
    l.flags = res_flags.ok;
    val res_min: res[Leb, Fail] = uleb(rd);
    if (sel res_min.err) { ret res[Limits, Fail].err{res_min.err}; }
    l.min = res_min.ok;
    if ((l.flags & tables.WASM_LIMITS_FLAG_HAS_MAX.value::u8) != 0) {
        val res_max: res[Leb, Fail] = uleb(rd);
        if (sel res_max.err) { ret res[Limits, Fail].err{res_max.err}; }
        l.max = res_max.ok;
    }
    if ((l.flags & tables.WASM_LIMITS_FLAG_HAS_PAGE_SIZE.value::u8) != 0) {
        val res_page: res[Leb, Fail] = uleb(rd);
        if (sel res_page.err) { ret res[Limits, Fail].err{res_page.err}; }
        l.page = res_page.ok;
    }
    ret res[Limits, Fail].ok{l};
}

# the next byte, left unread
fun peek(rd: *Reader) res[u8, Fail] {
    val res_byte: res[u8, Fail] = byte(rd);
    if (sel res_byte.err) { ret res_byte; }
    rd.pos = rd.pos - 1;
    ret res_byte;
}

# the widest a signed LEB128 of 33 bits is written
val S33_WIDTH: u8 = 5;

# a heap type: the byte of an abstract heap type, or a type index written as
# a signed LEB128 of 33 bits that is not negative. any other does not parse
pub fun heap_type(rd: *Reader) res[Heap, Fail] {
    val at:       u64             = reader.offset(rd);
    val res_sleb: res[Sleb, Fail] = sleb(rd);
    if (sel res_sleb.err)                                                                            { ret res[Heap, Fail].err{res_sleb.err}; }
    if (res_sleb.ok.value >= 0 && res_sleb.ok.value <= 0xffffffff && res_sleb.ok.width <= S33_WIDTH) { ret res[Heap, Fail].ok{Heap.index{res_sleb.ok}}; }
    val code: u8 = (res_sleb.ok.value::u64 & 0x7f)::u8;
    if (res_sleb.ok.width == 1 && res_sleb.ok.value < 0 && known(?tables.HEAP, code)) { ret res[Heap, Fail].ok{Heap.abstract{code}}; }
    ret res[Heap, Fail].err{fail.valued(fail.at_offset(fail.malformed("a heap type that is no abstract heap type and no type index"), at), res_sleb.ok.value::i128)};
}

fun known(s: *tables.Set, code: u8) bool {
    val opt_row: opt[*tables.Constant] = tables.name_of(s, code::u64);
    ret sel opt_row.some;
}

# a reference type: the byte of an abstract heap type, the nullable
# reference to it, or the prefix of a nullable or a non-nullable reference
# and its heap type. any other does not parse
pub fun ref_type(rd: *Reader) res[RefType, Fail] {
    val at:       u64           = reader.offset(rd);
    val res_byte: res[u8, Fail] = byte(rd);
    if (sel res_byte.err) { ret res[RefType, Fail].err{res_byte.err}; }
    if (res_byte.ok::u64 == tables.WASM_TYPE_NULLABLE.value || res_byte.ok::u64 == tables.WASM_TYPE_NONNULLABLE.value) {
        val res_heap_type: res[Heap, Fail] = heap_type(rd);
        if (sel res_heap_type.err) { ret res[RefType, Fail].err{res_heap_type.err}; }
        ret res[RefType, Fail].ok{RefType{nullable: res_byte.ok::u64 == tables.WASM_TYPE_NULLABLE.value, short: false, heap: res_heap_type.ok}};
    }
    if (known(?tables.HEAP, res_byte.ok)) { ret res[RefType, Fail].ok{RefType{nullable: true, short: true, heap: Heap.abstract{res_byte.ok}}}; }
    ret res[RefType, Fail].err{fail.valued(fail.at_offset(fail.malformed("a type that is no reference type"), at), res_byte.ok::i128)};
}

# a value type: the byte of a number or vector type, or a reference type
pub fun valtype(rd: *Reader) res[ValType, Fail] {
    val res_peek: res[u8, Fail] = peek(rd);
    if (sel res_peek.err) { ret res[ValType, Fail].err{res_peek.err}; }
    if (known(?tables.NUMBER, res_peek.ok)) {
        rd.pos = rd.pos + 1;
        ret res[ValType, Fail].ok{ValType.number{res_peek.ok}};
    }
    val res_ref_type: res[RefType, Fail] = ref_type(rd);
    if (sel res_ref_type.err) { ret res[ValType, Fail].err{res_ref_type.err}; }
    ret res[ValType, Fail].ok{ValType.reference{res_ref_type.ok}};
}

# a table type: the reference type of its elements, then its limits
pub fun table_type(rd: *Reader) res[TableType, Fail] {
    val res_elem: res[RefType, Fail] = ref_type(rd);
    if (sel res_elem.err) { ret res[TableType, Fail].err{res_elem.err}; }
    val res_limits: res[Limits, Fail] = limits(rd);
    if (sel res_limits.err) { ret res[TableType, Fail].err{res_limits.err}; }
    ret res[TableType, Fail].ok{TableType{elem: res_elem.ok, limits: res_limits.ok}};
}

# a table the module defines: its type, or the bytes that open a table with
# an initializer, its type and the initializer
pub fun table_def(rd: *Reader) res[TableDef, Fail] {
    val res_peek: res[u8, Fail] = peek(rd);
    if (sel res_peek.err) { ret res[TableDef, Fail].err{res_peek.err}; }
    if (res_peek.ok::u64 != tables.WASM_TABLE_HAS_INIT.value) {
        val res_table_type: res[TableType, Fail] = table_type(rd);
        if (sel res_table_type.err) { ret res[TableDef, Fail].err{res_table_type.err}; }
        ret res[TableDef, Fail].ok{TableDef{type: res_table_type.ok, init: opt[Expr].none{}}};
    }
    rd.pos = rd.pos + 1;
    val res_reserved: res[u8, Fail] = byte(rd);
    if (sel res_reserved.err) { ret res[TableDef, Fail].err{res_reserved.err}; }
    if (res_reserved.ok::u64 != tables.WASM_TABLE_RESERVED.value) {
        ret res[TableDef, Fail].err{fail.valued(fail.at_offset(fail.malformed("a table initializer's reserved byte is not zero"), reader.offset(rd) - 1), res_reserved.ok::i128)};
    }
    val res_table_type: res[TableType, Fail] = table_type(rd);
    if (sel res_table_type.err) { ret res[TableDef, Fail].err{res_table_type.err}; }
    val res_init: res[Expr, Fail] = expr(rd);
    if (sel res_init.err) { ret res[TableDef, Fail].err{res_init.err}; }
    ret res[TableDef, Fail].ok{TableDef{type: res_table_type.ok, init: opt[Expr].some{res_init.ok}}};
}

# a global type: a value type, then a mutability byte, and a mutability
# other than 0 or 1 does not parse
pub fun global_type(rd: *Reader) res[GlobalType, Fail] {
    val res_valtype: res[ValType, Fail] = valtype(rd);
    if (sel res_valtype.err) { ret res[GlobalType, Fail].err{res_valtype.err}; }
    val res_byte: res[u8, Fail] = byte(rd);
    if (sel res_byte.err) { ret res[GlobalType, Fail].err{res_byte.err}; }
    if (res_byte.ok > 1)  { ret res[GlobalType, Fail].err{fail.valued(fail.at_offset(fail.malformed("a mutability that is not 0 or 1"), reader.offset(rd) - 1), res_byte.ok::i128)}; }
    ret res[GlobalType, Fail].ok{GlobalType{valtype: res_valtype.ok, mutable: res_byte.ok}};
}

# a tag type: its attribute byte, then its type index
pub fun tag_type(rd: *Reader) res[TagType, Fail] {
    val res_byte: res[u8, Fail] = byte(rd);
    if (sel res_byte.err) { ret res[TagType, Fail].err{res_byte.err}; }
    val res_uleb: res[Leb, Fail] = uleb(rd);
    if (sel res_uleb.err) { ret res[TagType, Fail].err{res_uleb.err}; }
    ret res[TagType, Fail].ok{TagType{attribute: res_byte.ok, type: res_uleb.ok}};
}

# a vector of value types, appended to the valtypes table
fun valtypes(m: *Module, rd: *Reader) res[Run, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res_count; }
    var r: Run = res_count.ok;
    r.first = vector.length[ValType](?m.valtypes);
    var i: usize = 0;
    for (i < r.count) {
        val res_valtype: res[ValType, Fail] = valtype(rd);
        if (sel res_valtype.err) { ret res[Run, Fail].err{res_valtype.err}; }
        val err_valtypes_pushed: err[Fail] = vectors.push[ValType](?m.valtypes, res_valtype.ok);
        if (sel err_valtypes_pushed.err) { ret res[Run, Fail].err{err_valtypes_pushed.err}; }
        i = i + 1;
    }
    ret res[Run, Fail].ok{r};
}

# the type section's payload: a vector of its items, appended to the recs
# table with their types appended to the types table
pub fun types(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[RecType](?m.recs);
    var i: usize = 0;
    for (i < r.count) {
        val res_rec_type: res[RecType, Fail] = rec_type(m, rd);
        if (sel res_rec_type.err) { ret res[Body, Fail].err{res_rec_type.err}; }
        val err_recs_pushed: err[Fail] = vectors.push[RecType](?m.recs, res_rec_type.ok);
        if (sel err_recs_pushed.err) { ret res[Body, Fail].err{err_recs_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.types{r}};
}

# one item of the type section, its types appended to the types table
fun rec_type(m: *Module, rd: *Reader) res[RecType, Fail] {
    val res_peek: res[u8, Fail] = peek(rd);
    if (sel res_peek.err) { ret res[RecType, Fail].err{res_peek.err}; }
    var members: Run  = Run{first: vector.length[SubType](?m.types), count: 1, width: model.SHORTEST};
    var grouped: bool = false;
    if (res_peek.ok::u64 == tables.WASM_TYPE_REC.value) {
        rd.pos = rd.pos + 1;
        val res_count: res[Run, Fail] = count(rd);
        if (sel res_count.err) { ret res[RecType, Fail].err{res_count.err}; }
        members.count = res_count.ok.count;
        members.width = res_count.ok.width;
        grouped       = true;
    }
    var i: usize = 0;
    for (i < members.count) {
        val res_sub_type: res[SubType, Fail] = sub_type(m, rd);
        if (sel res_sub_type.err) { ret res[RecType, Fail].err{res_sub_type.err}; }
        val err_types_pushed: err[Fail] = vectors.push[SubType](?m.types, res_sub_type.ok);
        if (sel err_types_pushed.err) { ret res[RecType, Fail].err{err_types_pushed.err}; }
        i = i + 1;
    }
    ret res[RecType, Fail].ok{RecType{grouped: grouped, members: members}};
}

# a recursion group's head as a type fact states it
# ---
# grouped: the fact opens with a group's head
# count:   how many types the group holds, one for a single type
pub rec Head {
    grouped: bool;
    count:   u64;
}

# the head a type fact's bytes open with, consumed, one lone type for none
pub fun group_head(rd: *Reader) res[Head, Fail] {
    val res_peek: res[u8, Fail] = peek(rd);
    if (sel res_peek.err)                               { ret res[Head, Fail].err{res_peek.err}; }
    if (res_peek.ok::u64 != tables.WASM_TYPE_REC.value) { ret res[Head, Fail].ok{Head{grouped: false, count: 1}}; }
    rd.pos = rd.pos + 1;
    val res_uleb: res[u64, Fail] = reader.uleb(rd);
    if (sel res_uleb.err) { ret res[Head, Fail].err{res_uleb.err}; }
    ret res[Head, Fail].ok{Head{grouped: true, count: res_uleb.ok}};
}

# the next byte, not consumed
pub fun peek_byte(rd: *Reader) res[u8, Fail] {
    ret peek(rd);
}

# whether the byte `b` opens a declared subtype
pub fun is_sub(b: u8) bool {
    ret b::u64 == tables.WASM_TYPE_SUB.value || b::u64 == tables.WASM_TYPE_SUB_FINAL.value;
}

# whether the byte `b` is a packed storage type
pub fun is_packed(b: u8) bool {
    ret b::u64 == tables.WASM_TYPE_I8.value || b::u64 == tables.WASM_TYPE_I16.value;
}

# step past a declared subtype's prefix and supertypes, nothing for a type
# written bare
pub fun past_supers(rd: *Reader) err[Fail] {
    val res_peek: res[u8, Fail] = peek(rd);
    if (sel res_peek.err)     { ret err[Fail].err{res_peek.err}; }
    if (!is_sub(res_peek.ok)) { ret err[Fail].ok{}; }
    rd.pos = rd.pos + 1;
    val res_uleb: res[u64, Fail] = reader.uleb(rd);
    if (sel res_uleb.err) { ret err[Fail].err{res_uleb.err}; }
    var i: u64 = 0;
    for (i < res_uleb.ok) {
        val res_uleb: res[u64, Fail] = reader.uleb(rd);
        if (sel res_uleb.err) { ret err[Fail].err{res_uleb.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# one type: its prefix and supertypes where it declares them, then its
# composite type
pub fun sub_type(m: *Module, rd: *Reader) res[SubType, Fail] {
    val res_peek: res[u8, Fail] = peek(rd);
    if (sel res_peek.err) { ret res[SubType, Fail].err{res_peek.err}; }
    var s: SubType;
    if (is_sub(res_peek.ok)) {
        rd.pos = rd.pos + 1;
        val res_numbers: res[Run, Fail] = numbers(rd, ?m.indices);
        if (sel res_numbers.err) { ret res[SubType, Fail].err{res_numbers.err}; }
        s.prefix = res_peek.ok;
        s.supers = res_numbers.ok;
    }
    val res_composite_type: res[Composite, Fail] = composite_type(m, rd);
    if (sel res_composite_type.err) { ret res[SubType, Fail].err{res_composite_type.err}; }
    s.composite = res_composite_type.ok;
    ret res[SubType, Fail].ok{s};
}

fun composite_type(m: *Module, rd: *Reader) res[Composite, Fail] {
    val res_peek: res[u8, Fail] = peek(rd);
    if (sel res_peek.err) { ret res[Composite, Fail].err{res_peek.err}; }
    if (res_peek.ok::u64 == tables.WASM_TYPE_STRUCT.value) {
        rd.pos = rd.pos + 1;
        val res_count: res[Run, Fail] = count(rd);
        if (sel res_count.err) { ret res[Composite, Fail].err{res_count.err}; }
        var r: Run = res_count.ok;
        r.first = vector.length[Field](?m.fields);
        var i: usize = 0;
        for (i < r.count) {
            val res_field_type: res[Field, Fail] = field_type(rd);
            if (sel res_field_type.err) { ret res[Composite, Fail].err{res_field_type.err}; }
            val err_fields_pushed: err[Fail] = vectors.push[Field](?m.fields, res_field_type.ok);
            if (sel err_fields_pushed.err) { ret res[Composite, Fail].err{err_fields_pushed.err}; }
            i = i + 1;
        }
        ret res[Composite, Fail].ok{Composite.structure{r}};
    }
    if (res_peek.ok::u64 == tables.WASM_TYPE_ARRAY.value) {
        rd.pos = rd.pos + 1;
        val res_field_type: res[Field, Fail] = field_type(rd);
        if (sel res_field_type.err) { ret res[Composite, Fail].err{res_field_type.err}; }
        ret res[Composite, Fail].ok{Composite.array{res_field_type.ok}};
    }
    val res_func_type: res[FuncType, Fail] = func_type(m, rd);
    if (sel res_func_type.err) { ret res[Composite, Fail].err{res_func_type.err}; }
    ret res[Composite, Fail].ok{Composite.function{res_func_type.ok}};
}

# a field: a packed storage byte or a value type, then its mutability
fun field_type(rd: *Reader) res[Field, Fail] {
    val res_peek: res[u8, Fail] = peek(rd);
    if (sel res_peek.err) { ret res[Field, Fail].err{res_peek.err}; }
    var f: Field;
    if (is_packed(res_peek.ok)) {
        rd.pos    = rd.pos + 1;
        f.storage = Storage.packed{res_peek.ok};
    }
    or {
        val res_valtype: res[ValType, Fail] = valtype(rd);
        if (sel res_valtype.err) { ret res[Field, Fail].err{res_valtype.err}; }
        f.storage = Storage.value{res_valtype.ok};
    }
    val res_byte: res[u8, Fail] = byte(rd);
    if (sel res_byte.err) { ret res[Field, Fail].err{res_byte.err}; }
    if (res_byte.ok > 1)  { ret res[Field, Fail].err{fail.valued(fail.at_offset(fail.malformed("a mutability that is not 0 or 1"), reader.offset(rd) - 1), res_byte.ok::i128)}; }
    f.mutable = res_byte.ok;
    ret res[Field, Fail].ok{f};
}

# one function type, its parameters and results appended to the valtypes
# table. a type of any other form does not parse
fun func_type(m: *Module, rd: *Reader) res[FuncType, Fail] {
    val res_form: res[u8, Fail] = byte(rd);
    if (sel res_form.err) { ret res[FuncType, Fail].err{res_form.err}; }
    if (res_form.ok::u64 != tables.WASM_TYPE_FUNC.value) {
        ret res[FuncType, Fail].err{fail.valued(fail.at_offset(fail.malformed("a type that is not a function type"), reader.offset(rd) - 1), res_form.ok::i128)};
    }
    val res_params: res[Run, Fail] = valtypes(m, rd);
    if (sel res_params.err) { ret res[FuncType, Fail].err{res_params.err}; }
    val res_valtypes: res[Run, Fail] = valtypes(m, rd);
    if (sel res_valtypes.err) { ret res[FuncType, Fail].err{res_valtypes.err}; }
    ret res[FuncType, Fail].ok{FuncType{form: res_form.ok, params: res_params.ok, results: res_valtypes.ok}};
}

fun imports(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = table.count[Import](?m.imports);
    var i: usize = 0;
    for (i < r.count) {
        var imp:        Import;
        val res_module: res[Name, Fail] = name(m, rd);
        if (sel res_module.err) { ret res[Body, Fail].err{res_module.err}; }
        imp.module = res_module.ok;
        val res_field: res[Name, Fail] = name(m, rd);
        if (sel res_field.err) { ret res[Body, Fail].err{res_field.err}; }
        imp.field = res_field.ok;
        val res_kind: res[u8, Fail] = byte(rd);
        if (sel res_kind.err) { ret res[Body, Fail].err{res_kind.err}; }
        imp.kind = res_kind.ok;
        if (res_kind.ok::u64 == tables.WASM_EXTERNAL_FUNCTION.value) {
            val res_uleb: res[Leb, Fail] = uleb(rd);
            if (sel res_uleb.err) { ret res[Body, Fail].err{res_uleb.err}; }
            imp.desc = model.Desc.function{res_uleb.ok};
        }
        or (res_kind.ok::u64 == tables.WASM_EXTERNAL_TABLE.value) {
            val res_table_type: res[TableType, Fail] = table_type(rd);
            if (sel res_table_type.err) { ret res[Body, Fail].err{res_table_type.err}; }
            imp.desc = model.Desc.table{res_table_type.ok};
        }
        or (res_kind.ok::u64 == tables.WASM_EXTERNAL_MEMORY.value) {
            val res_limits: res[Limits, Fail] = limits(rd);
            if (sel res_limits.err) { ret res[Body, Fail].err{res_limits.err}; }
            imp.desc = model.Desc.memory{res_limits.ok};
        }
        or (res_kind.ok::u64 == tables.WASM_EXTERNAL_GLOBAL.value) {
            val res_global_type: res[GlobalType, Fail] = global_type(rd);
            if (sel res_global_type.err) { ret res[Body, Fail].err{res_global_type.err}; }
            imp.desc = model.Desc.global{res_global_type.ok};
        }
        or (res_kind.ok::u64 == tables.WASM_EXTERNAL_TAG.value) {
            val res_tag_type: res[TagType, Fail] = tag_type(rd);
            if (sel res_tag_type.err) { ret res[Body, Fail].err{res_tag_type.err}; }
            imp.desc = model.Desc.tag_type{res_tag_type.ok};
        }
        or {
            ret res[Body, Fail].err{fail.valued(fail.at_offset(fail.malformed("unknown import kind"), reader.offset(rd) - 1), res_kind.ok::i128)};
        }
        val res_imports_pushed: res[Id[Import], Fail] = table.push[Import](?m.imports, imp);
        if (sel res_imports_pushed.err) { ret res[Body, Fail].err{res_imports_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.imports{r}};
}

# a vector of unsigned numbers appended to `into`
fun numbers(rd: *Reader, into: *Vector[Leb]) res[Run, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res_count; }
    var r: Run = res_count.ok;
    r.first = vector.length[Leb](into);
    var i: usize = 0;
    for (i < r.count) {
        val res_uleb: res[Leb, Fail] = uleb(rd);
        if (sel res_uleb.err) { ret res[Run, Fail].err{res_uleb.err}; }
        val err_into_pushed: err[Fail] = vectors.push[Leb](into, res_uleb.ok);
        if (sel err_into_pushed.err) { ret res[Run, Fail].err{err_into_pushed.err}; }
        i = i + 1;
    }
    ret res[Run, Fail].ok{r};
}

fun functions(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_numbers: res[Run, Fail] = numbers(rd, ?m.functions);
    if (sel res_numbers.err) { ret res[Body, Fail].err{res_numbers.err}; }
    ret res[Body, Fail].ok{Body.functions{res_numbers.ok}};
}

fun table_types(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[TableDef](?m.tables);
    var i: usize = 0;
    for (i < r.count) {
        val res_table_def: res[TableDef, Fail] = table_def(rd);
        if (sel res_table_def.err) { ret res[Body, Fail].err{res_table_def.err}; }
        val err_tables_pushed: err[Fail] = vectors.push[TableDef](?m.tables, res_table_def.ok);
        if (sel err_tables_pushed.err) { ret res[Body, Fail].err{err_tables_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.tables{r}};
}

fun memories(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[Limits](?m.memories);
    var i: usize = 0;
    for (i < r.count) {
        val res_limits: res[Limits, Fail] = limits(rd);
        if (sel res_limits.err) { ret res[Body, Fail].err{res_limits.err}; }
        val err_memories_pushed: err[Fail] = vectors.push[Limits](?m.memories, res_limits.ok);
        if (sel err_memories_pushed.err) { ret res[Body, Fail].err{err_memories_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.memories{r}};
}

fun globals(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[Global](?m.globals);
    var i: usize = 0;
    for (i < r.count) {
        val res_global_type: res[GlobalType, Fail] = global_type(rd);
        if (sel res_global_type.err) { ret res[Body, Fail].err{res_global_type.err}; }
        val res_expr: res[Expr, Fail] = expr(rd);
        if (sel res_expr.err) { ret res[Body, Fail].err{res_expr.err}; }
        val err_globals_pushed: err[Fail] = vectors.push[Global](?m.globals, Global{type: res_global_type.ok, init: res_expr.ok});
        if (sel err_globals_pushed.err) { ret res[Body, Fail].err{err_globals_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.globals{r}};
}

# the export section's payload, appended to the exports table. an export
# of a kind the tables do not name does not parse
pub fun exports(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[Export](?m.exports);
    var i: usize = 0;
    for (i < r.count) {
        val res_name: res[Name, Fail] = name(m, rd);
        if (sel res_name.err) { ret res[Body, Fail].err{res_name.err}; }
        val res_kind: res[u8, Fail] = byte(rd);
        if (sel res_kind.err) { ret res[Body, Fail].err{res_kind.err}; }
        val opt_row: opt[*tables.Constant] = tables.name_of(?tables.EXTERNAL, res_kind.ok::u64);
        if (sel opt_row.none) {
            ret res[Body, Fail].err{fail.valued(fail.at_offset(fail.malformed("unknown export kind"), reader.offset(rd) - 1), res_kind.ok::i128)};
        }
        val res_index: res[Leb, Fail] = uleb(rd);
        if (sel res_index.err) { ret res[Body, Fail].err{res_index.err}; }
        val err_exports_pushed: err[Fail] = vectors.push[Export](?m.exports, Export{name: res_name.ok, kind: res_kind.ok, index: res_index.ok});
        if (sel err_exports_pushed.err) { ret res[Body, Fail].err{err_exports_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.exports{r}};
}

fun start(rd: *Reader) res[Body, Fail] {
    val res_uleb: res[Leb, Fail] = uleb(rd);
    if (sel res_uleb.err) { ret res[Body, Fail].err{res_uleb.err}; }
    ret res[Body, Fail].ok{Body.start{res_uleb.ok}};
}

fun datacount(rd: *Reader) res[Body, Fail] {
    val res_uleb: res[Leb, Fail] = uleb(rd);
    if (sel res_uleb.err) { ret res[Body, Fail].err{res_uleb.err}; }
    ret res[Body, Fail].ok{Body.datacount{res_uleb.ok}};
}

# the bits an element segment's flags may carry
val ELEM_MASK: u64 = 0x7;

fun elements(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[Element](?m.elements);
    var i: usize = 0;
    for (i < r.count) {
        val res_element: res[Element, Fail] = element(m, rd);
        if (sel res_element.err) { ret res[Body, Fail].err{res_element.err}; }
        val err_elements_pushed: err[Fail] = vectors.push[Element](?m.elements, res_element.ok);
        if (sel err_elements_pushed.err) { ret res[Body, Fail].err{err_elements_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.elements{r}};
}

# one element segment, its items appended to the indices or the exprs
# table. flags outside ELEM_MASK do not parse
pub fun element(m: *Module, rd: *Reader) res[Element, Fail] {
    var e:         Element;
    val res_flags: res[Leb, Fail] = uleb(rd);
    if (sel res_flags.err) { ret res[Element, Fail].err{res_flags.err}; }
    e.flags = res_flags.ok;
    val f: u64 = res_flags.ok.value;
    if ((f & ~ELEM_MASK) != 0) {
        ret res[Element, Fail].err{fail.valued(fail.at_offset(fail.malformed("unknown element segment flags"), reader.offset(rd) - res_flags.ok.width::u64), f::i128)};
    }
    val passive: bool = (f & tables.WASM_ELEM_SEGMENT_IS_PASSIVE.value) != 0;
    if (!passive) {
        if ((f & tables.WASM_ELEM_SEGMENT_HAS_TABLE_NUMBER.value) != 0) {
            val res_uleb: res[Leb, Fail] = uleb(rd);
            if (sel res_uleb.err) { ret res[Element, Fail].err{res_uleb.err}; }
            e.table = res_uleb.ok;
        }
        val res_off: res[Expr, Fail] = expr(rd);
        if (sel res_off.err) { ret res[Element, Fail].err{res_off.err}; }
        e.offset = res_off.ok;
    }
    val described: bool = (f & model.ELEM_DESC_MASK) != 0;
    if (described && (f & tables.WASM_ELEM_SEGMENT_HAS_INIT_EXPRS.value) != 0) {
        val res_type: res[RefType, Fail] = ref_type(rd);
        if (sel res_type.err) { ret res[Element, Fail].err{res_type.err}; }
        e.type = res_type.ok;
    }
    or (described) {
        val res_kind: res[u8, Fail] = byte(rd);
        if (sel res_kind.err) { ret res[Element, Fail].err{res_kind.err}; }
        e.kind = res_kind.ok;
    }
    if ((f & tables.WASM_ELEM_SEGMENT_HAS_INIT_EXPRS.value) != 0) {
        val res_items: res[Run, Fail] = exprs(m, rd);
        if (sel res_items.err) { ret res[Element, Fail].err{res_items.err}; }
        e.items = Items.exprs{res_items.ok};
    }
    or {
        val res_items: res[Run, Fail] = numbers(rd, ?m.indices);
        if (sel res_items.err) { ret res[Element, Fail].err{res_items.err}; }
        e.items = Items.indices{res_items.ok};
    }
    ret res[Element, Fail].ok{e};
}

fun exprs(m: *Module, rd: *Reader) res[Run, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res_count; }
    var r: Run = res_count.ok;
    r.first = vector.length[Expr](?m.exprs);
    var i: usize = 0;
    for (i < r.count) {
        val res_expr: res[Expr, Fail] = expr(rd);
        if (sel res_expr.err) { ret res[Run, Fail].err{res_expr.err}; }
        val err_exprs_pushed: err[Fail] = vectors.push[Expr](?m.exprs, res_expr.ok);
        if (sel err_exprs_pushed.err) { ret res[Run, Fail].err{err_exprs_pushed.err}; }
        i = i + 1;
    }
    ret res[Run, Fail].ok{r};
}

fun code(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[Function](?m.code);
    var i: usize = 0;
    for (i < r.count) {
        val res_size: res[Leb, Fail] = uleb(rd);
        if (sel res_size.err) { ret res[Body, Fail].err{res_size.err}; }
        val res_body: res[*u8, Fail] = reader.bytes(rd, res_size.ok.value);
        if (sel res_body.err) { ret res[Body, Fail].err{res_body.err}; }
        val f:               Function  = Function{width: res_size.ok.width, body: Held.borrowed{Bytes{data: res_body.ok, len: res_size.ok.value::usize}}};
        val err_code_pushed: err[Fail] = vectors.push[Function](?m.code, f);
        if (sel err_code_pushed.err) { ret res[Body, Fail].err{err_code_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.code{r}};
}

# the bits a data segment's flags may carry
val DATA_MASK: u64 = 0x3;

fun data(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[Segment](?m.data);
    var i: usize = 0;
    for (i < r.count) {
        var s:         Segment;
        val res_flags: res[Leb, Fail] = uleb(rd);
        if (sel res_flags.err) { ret res[Body, Fail].err{res_flags.err}; }
        s.flags = res_flags.ok;
        val f: u64 = res_flags.ok.value;
        if ((f & ~DATA_MASK) != 0) {
            ret res[Body, Fail].err{fail.valued(fail.at_offset(fail.malformed("unknown data segment flags"), reader.offset(rd) - res_flags.ok.width::u64), f::i128)};
        }
        if ((f & tables.WASM_DATA_SEGMENT_HAS_MEMINDEX.value) != 0) {
            val res_mem: res[Leb, Fail] = uleb(rd);
            if (sel res_mem.err) { ret res[Body, Fail].err{res_mem.err}; }
            s.memory = res_mem.ok;
        }
        if ((f & tables.WASM_DATA_SEGMENT_IS_PASSIVE.value) == 0) {
            val res_off: res[Expr, Fail] = expr(rd);
            if (sel res_off.err) { ret res[Body, Fail].err{res_off.err}; }
            s.offset = res_off.ok;
        }
        val res_len: res[Leb, Fail] = uleb(rd);
        if (sel res_len.err) { ret res[Body, Fail].err{res_len.err}; }
        val res_bytes: res[*u8, Fail] = reader.bytes(rd, res_len.ok.value);
        if (sel res_bytes.err) { ret res[Body, Fail].err{res_bytes.err}; }
        s.width = res_len.ok.width;
        s.data  = Held.borrowed{Bytes{data: res_bytes.ok, len: res_len.ok.value::usize}};
        val err_data_pushed: err[Fail] = vectors.push[Segment](?m.data, s);
        if (sel err_data_pushed.err) { ret res[Body, Fail].err{err_data_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.data{r}};
}

fun tags(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[Tag](?m.tags);
    var i: usize = 0;
    for (i < r.count) {
        val res_tag_type: res[TagType, Fail] = tag_type(rd);
        if (sel res_tag_type.err) { ret res[Body, Fail].err{res_tag_type.err}; }
        val err_tags_pushed: err[Fail] = vectors.push[Tag](?m.tags, Tag{attribute: res_tag_type.ok.attribute, type: res_tag_type.ok.type});
        if (sel err_tags_pushed.err) { ret res[Body, Fail].err{err_tags_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.tags{r}};
}

# a subsection header: its id and its size, and a reader over its payload,
# which is consumed from `rd`
rec Sub {
    id:    u8;
    width: u8;
    rd:    Reader;
}

fun subsection(rd: *Reader) res[Sub, Fail] {
    val res_byte: res[u8, Fail] = byte(rd);
    if (sel res_byte.err) { ret res[Sub, Fail].err{res_byte.err}; }
    val res_size: res[Leb, Fail] = uleb(rd);
    if (sel res_size.err) { ret res[Sub, Fail].err{res_size.err}; }
    val res_inner: res[Reader, Fail] = reader.sub(rd, rd.pos::u64, res_size.ok.value);
    if (sel res_inner.err) { ret res[Sub, Fail].err{res_inner.err}; }
    val res_skipped: res[usize, Fail] = reader.seek(rd, rd.pos::u64 + res_size.ok.value);
    if (sel res_skipped.err) { ret res[Sub, Fail].err{res_skipped.err}; }
    ret res[Sub, Fail].ok{Sub{id: res_byte.ok, width: res_size.ok.width, rd: res_inner.ok}};
}

# the linking section: its version, then its subsections, each decoded by
# its id or held raw
fun linking(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_version: res[Leb, Fail] = uleb(rd);
    if (sel res_version.err) { ret res[Body, Fail].err{res_version.err}; }
    if (res_version.ok.value != tables.METADATA_VERSION) {
        ret res[Body, Fail].err{fail.valued(fail.at_offset(fail.malformed("unknown linking section version"), reader.offset(rd) - res_version.ok.width::u64), res_version.ok.value::i128)};
    }
    var r: Run = Run{first: vector.length[Subsection](?m.subsections), count: 0, width: 0};
    for (reader.remaining(rd) > 0) {
        val res_sub: res[Sub, Fail] = subsection(rd);
        if (sel res_sub.err) { ret res[Body, Fail].err{res_sub.err}; }
        var s:        Sub                = res_sub.ok;
        val k:        Mark               = model.mark(m);
        val res_body: res[Subbody, Fail] = linking_sub(m, ?s);
        var held:     Subbody;
        if (sel res_body.ok) { held = res_body.ok; }
        or (sel res_body.err) {
            if (!holdable(res_body.err)) { ret res[Body, Fail].err{res_body.err}; }
            model.truncate(m, k);
            val res_whole: res[Held, Fail] = whole_of(?s.rd);
            if (sel res_whole.err) { ret res[Body, Fail].err{res_whole.err}; }
            held = Subbody.raw{Raw{bytes: res_whole.ok, why: Why.unsupported{}}};
        }
        val err_subsections_pushed: err[Fail] = vectors.push[Subsection](?m.subsections, Subsection{id: s.id, width: s.width, body: held});
        if (sel err_subsections_pushed.err) { ret res[Body, Fail].err{err_subsections_pushed.err}; }
        r.count = r.count + 1;
    }
    ret res[Body, Fail].ok{Body.linking{Linking{version: res_version.ok, subsections: r}}};
}

# one linking subsection by its id, drained to its end, or held raw as
# opaque when no id names it
fun linking_sub(m: *Module, s: *Sub) res[Subbody, Fail] {
    var res_body: res[Subbody, Fail];
    if (s.id::u64 == tables.WASM_SEGMENT_INFO.value) { res_body = segment_infos(m, ?s.rd); }
    or (s.id::u64 == tables.WASM_INIT_FUNCS.value)   { res_body = init_funcs(m, ?s.rd); }
    or (s.id::u64 == tables.WASM_COMDAT_INFO.value)  { res_body = comdats(m, ?s.rd); }
    or (s.id::u64 == tables.WASM_SYMBOL_TABLE.value) { res_body = symbols(m, ?s.rd); }
    or {
        val res_rest: res[Held, Fail] = rest(?s.rd);
        if (sel res_rest.err) { ret res[Subbody, Fail].err{res_rest.err}; }
        ret res[Subbody, Fail].ok{Subbody.raw{Raw{bytes: res_rest.ok, why: Why.opaque{}}}};
    }
    if (sel res_body.err) { ret res_body; }
    val err_drained: err[Fail] = drained(?s.rd);
    if (sel err_drained.err) { ret res[Subbody, Fail].err{err_drained.err}; }
    ret res_body;
}

# every byte of a bounded reader, wherever its cursor stands
fun whole_of(rd: *Reader) res[Held, Fail] {
    ret res[Held, Fail].ok{Held.borrowed{Bytes{data: rd.data, len: rd.len}}};
}

fun segment_infos(m: *Module, rd: *Reader) res[Subbody, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Subbody, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[SegmentInfo](?m.segment_infos);
    var i: usize = 0;
    for (i < r.count) {
        val res_name: res[Name, Fail] = name(m, rd);
        if (sel res_name.err) { ret res[Subbody, Fail].err{res_name.err}; }
        val res_align: res[Leb, Fail] = uleb(rd);
        if (sel res_align.err) { ret res[Subbody, Fail].err{res_align.err}; }
        val res_flags: res[Leb, Fail] = uleb(rd);
        if (sel res_flags.err) { ret res[Subbody, Fail].err{res_flags.err}; }
        val err_segment_infos_pushed: err[Fail] = vectors.push[SegmentInfo](?m.segment_infos, SegmentInfo{name: res_name.ok, align: res_align.ok, flags: res_flags.ok});
        if (sel err_segment_infos_pushed.err) { ret res[Subbody, Fail].err{err_segment_infos_pushed.err}; }
        i = i + 1;
    }
    ret res[Subbody, Fail].ok{Subbody.segments{r}};
}

fun init_funcs(m: *Module, rd: *Reader) res[Subbody, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Subbody, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[InitFunc](?m.inits);
    var i: usize = 0;
    for (i < r.count) {
        val res_priority: res[Leb, Fail] = uleb(rd);
        if (sel res_priority.err) { ret res[Subbody, Fail].err{res_priority.err}; }
        val res_symbol: res[Leb, Fail] = uleb(rd);
        if (sel res_symbol.err) { ret res[Subbody, Fail].err{res_symbol.err}; }
        val err_inits_pushed: err[Fail] = vectors.push[InitFunc](?m.inits, InitFunc{priority: res_priority.ok, symbol: res_symbol.ok});
        if (sel err_inits_pushed.err) { ret res[Subbody, Fail].err{err_inits_pushed.err}; }
        i = i + 1;
    }
    ret res[Subbody, Fail].ok{Subbody.inits{r}};
}

fun comdats(m: *Module, rd: *Reader) res[Subbody, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Subbody, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[Comdat](?m.comdats);
    var i: usize = 0;
    for (i < r.count) {
        val res_name: res[Name, Fail] = name(m, rd);
        if (sel res_name.err) { ret res[Subbody, Fail].err{res_name.err}; }
        val res_flags: res[Leb, Fail] = uleb(rd);
        if (sel res_flags.err) { ret res[Subbody, Fail].err{res_flags.err}; }
        val res_items: res[Run, Fail] = count(rd);
        if (sel res_items.err) { ret res[Subbody, Fail].err{res_items.err}; }
        var run: Run = res_items.ok;
        run.first = vector.length[ComdatItem](?m.comdat_items);
        var k: usize = 0;
        for (k < run.count) {
            val res_kind: res[u8, Fail] = byte(rd);
            if (sel res_kind.err) { ret res[Subbody, Fail].err{res_kind.err}; }
            val res_index: res[Leb, Fail] = uleb(rd);
            if (sel res_index.err) { ret res[Subbody, Fail].err{res_index.err}; }
            val err_comdat_items_pushed: err[Fail] = vectors.push[ComdatItem](?m.comdat_items, ComdatItem{kind: res_kind.ok, index: res_index.ok});
            if (sel err_comdat_items_pushed.err) { ret res[Subbody, Fail].err{err_comdat_items_pushed.err}; }
            k = k + 1;
        }
        val err_comdats_pushed: err[Fail] = vectors.push[Comdat](?m.comdats, Comdat{name: res_name.ok, flags: res_flags.ok, items: run});
        if (sel err_comdats_pushed.err) { ret res[Subbody, Fail].err{err_comdats_pushed.err}; }
        i = i + 1;
    }
    ret res[Subbody, Fail].ok{Subbody.comdats{r}};
}

fun symbols(m: *Module, rd: *Reader) res[Subbody, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Subbody, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = table.count[Symbol](?m.symbols);
    var i: usize = 0;
    for (i < r.count) {
        var s:        Symbol;
        val res_kind: res[u8, Fail] = byte(rd);
        if (sel res_kind.err) { ret res[Subbody, Fail].err{res_kind.err}; }
        val opt_row: opt[*tables.Constant] = tables.name_of(?tables.SYMBOL_TYPE, res_kind.ok::u64);
        if (sel opt_row.none) {
            ret res[Subbody, Fail].err{fail.valued(fail.at_offset(fail.malformed("unknown symbol kind"), reader.offset(rd) - 1), res_kind.ok::i128)};
        }
        s.kind = res_kind.ok;
        val res_flags: res[Leb, Fail] = uleb(rd);
        if (sel res_flags.err) { ret res[Subbody, Fail].err{res_flags.err}; }
        s.flags = res_flags.ok;
        if (model.symbol_indexed(s.kind)) {
            val res_index: res[Leb, Fail] = uleb(rd);
            if (sel res_index.err) { ret res[Subbody, Fail].err{res_index.err}; }
            s.index = res_index.ok;
        }
        s.named = model.symbol_named(s.kind, s.flags.value);
        if (s.named) {
            val res_name: res[Name, Fail] = name(m, rd);
            if (sel res_name.err) { ret res[Subbody, Fail].err{res_name.err}; }
            s.name = res_name.ok;
        }
        if (model.symbol_placed(s.kind, s.flags.value)) {
            val res_segment: res[Leb, Fail] = uleb(rd);
            if (sel res_segment.err) { ret res[Subbody, Fail].err{res_segment.err}; }
            s.segment = res_segment.ok;
            val res_offset: res[Leb, Fail] = uleb(rd);
            if (sel res_offset.err) { ret res[Subbody, Fail].err{res_offset.err}; }
            s.offset = res_offset.ok;
            val res_size: res[Leb, Fail] = uleb(rd);
            if (sel res_size.err) { ret res[Subbody, Fail].err{res_size.err}; }
            s.size = res_size.ok;
        }
        val res_symbols_pushed: res[Id[Symbol], Fail] = table.push[Symbol](?m.symbols, s);
        if (sel res_symbols_pushed.err) { ret res[Subbody, Fail].err{res_symbols_pushed.err}; }
        i = i + 1;
    }
    ret res[Subbody, Fail].ok{Subbody.symbols{r}};
}

# a reloc.* section: the section it patches, then its records, each with an
# addend when its type's row carries one
fun relocs(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_section: res[Leb, Fail] = uleb(rd);
    if (sel res_section.err) { ret res[Body, Fail].err{res_section.err}; }
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[Reloc](?m.relocs);
    var i: usize = 0;
    for (i < r.count) {
        var rel:      Reloc;
        val res_type: res[u8, Fail] = byte(rd);
        if (sel res_type.err) { ret res[Body, Fail].err{res_type.err}; }
        val opt_row: opt[*tables.Relocation] = tables.reloc_of(?tables.RELOC, res_type.ok::u64);
        if (sel opt_row.none) {
            ret res[Body, Fail].err{fail.valued(fail.at_offset(fail.malformed("unknown relocation type"), reader.offset(rd) - 1), res_type.ok::i128)};
        }
        rel.type = res_type.ok;
        val res_offset: res[Leb, Fail] = uleb(rd);
        if (sel res_offset.err) { ret res[Body, Fail].err{res_offset.err}; }
        rel.offset = res_offset.ok;
        val res_index: res[Leb, Fail] = uleb(rd);
        if (sel res_index.err) { ret res[Body, Fail].err{res_index.err}; }
        rel.index = res_index.ok;
        if (opt_row.some.addend) {
            val res_addend: res[Sleb, Fail] = sleb(rd);
            if (sel res_addend.err) { ret res[Body, Fail].err{res_addend.err}; }
            rel.addend = res_addend.ok;
        }
        val err_relocs_pushed: err[Fail] = vectors.push[Reloc](?m.relocs, rel);
        if (sel err_relocs_pushed.err) { ret res[Body, Fail].err{err_relocs_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.relocs{Relocs{section: res_section.ok, entries: r}}};
}

fun among(id: u8, set: *u8, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (set[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the name section: subsections by id, the module name, name maps and
# indirect name maps, the rest held raw
fun names(m: *Module, rd: *Reader) res[Body, Fail] {
    var r: Run = Run{first: vector.length[NameSub](?m.name_subs), count: 0, width: 0};
    for (reader.remaining(rd) > 0) {
        val res_sub: res[Sub, Fail] = subsection(rd);
        if (sel res_sub.err) { ret res[Body, Fail].err{res_sub.err}; }
        var s:        Sub                 = res_sub.ok;
        val k:        Mark                = model.mark(m);
        val res_body: res[NameBody, Fail] = name_sub(m, ?s);
        var held:     NameBody;
        if (sel res_body.ok) { held = res_body.ok; }
        or (sel res_body.err) {
            if (!holdable(res_body.err)) { ret res[Body, Fail].err{res_body.err}; }
            model.truncate(m, k);
            val res_whole: res[Held, Fail] = whole_of(?s.rd);
            if (sel res_whole.err) { ret res[Body, Fail].err{res_whole.err}; }
            held = NameBody.raw{Raw{bytes: res_whole.ok, why: Why.unsupported{}}};
        }
        val err_name_subs_pushed: err[Fail] = vectors.push[NameSub](?m.name_subs, NameSub{id: s.id, width: s.width, body: held});
        if (sel err_name_subs_pushed.err) { ret res[Body, Fail].err{err_name_subs_pushed.err}; }
        r.count = r.count + 1;
    }
    ret res[Body, Fail].ok{Body.names{r}};
}

# one name subsection by its id, drained to its end, or held raw as opaque
# when no id names it
fun name_sub(m: *Module, s: *Sub) res[NameBody, Fail] {
    var res_body: res[NameBody, Fail];
    if (s.id::u64 == tables.WASM_NAMES_MODULE.value) {
        val res_name: res[Name, Fail] = name(m, ?s.rd);
        if (sel res_name.err) { ret res[NameBody, Fail].err{res_name.err}; }
        res_body = res[NameBody, Fail].ok{NameBody.module{res_name.ok}};
    }
    or (among(s.id, ?MAPS[0], MAP_COUNT)) {
        val res_map: res[Run, Fail] = name_map(m, ?s.rd);
        if (sel res_map.err) { ret res[NameBody, Fail].err{res_map.err}; }
        res_body = res[NameBody, Fail].ok{NameBody.map{res_map.ok}};
    }
    or (among(s.id, ?INDIRECTS[0], INDIRECT_COUNT)) {
        val res_map: res[Run, Fail] = indirect_map(m, ?s.rd);
        if (sel res_map.err) { ret res[NameBody, Fail].err{res_map.err}; }
        res_body = res[NameBody, Fail].ok{NameBody.indirect{res_map.ok}};
    }
    or {
        val res_rest: res[Held, Fail] = rest(?s.rd);
        if (sel res_rest.err) { ret res[NameBody, Fail].err{res_rest.err}; }
        ret res[NameBody, Fail].ok{NameBody.raw{Raw{bytes: res_rest.ok, why: Why.opaque{}}}};
    }
    val err_drained: err[Fail] = drained(?s.rd);
    if (sel err_drained.err) { ret res[NameBody, Fail].err{err_drained.err}; }
    ret res_body;
}

fun name_map(m: *Module, rd: *Reader) res[Run, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res_count; }
    var r: Run = res_count.ok;
    r.first = vector.length[NameEntry](?m.name_entries);
    var i: usize = 0;
    for (i < r.count) {
        val res_index: res[Leb, Fail] = uleb(rd);
        if (sel res_index.err) { ret res[Run, Fail].err{res_index.err}; }
        val res_name: res[Name, Fail] = name(m, rd);
        if (sel res_name.err) { ret res[Run, Fail].err{res_name.err}; }
        val err_name_entries_pushed: err[Fail] = vectors.push[NameEntry](?m.name_entries, NameEntry{index: res_index.ok, name: res_name.ok});
        if (sel err_name_entries_pushed.err) { ret res[Run, Fail].err{err_name_entries_pushed.err}; }
        i = i + 1;
    }
    ret res[Run, Fail].ok{r};
}

fun indirect_map(m: *Module, rd: *Reader) res[Run, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res_count; }
    var r: Run = res_count.ok;
    r.first = vector.length[IndirectEntry](?m.indirects);
    var i: usize = 0;
    for (i < r.count) {
        val res_index: res[Leb, Fail] = uleb(rd);
        if (sel res_index.err) { ret res[Run, Fail].err{res_index.err}; }
        val res_map: res[Run, Fail] = name_map(m, rd);
        if (sel res_map.err) { ret res_map; }
        val err_indirects_pushed: err[Fail] = vectors.push[IndirectEntry](?m.indirects, IndirectEntry{index: res_index.ok, names: res_map.ok});
        if (sel err_indirects_pushed.err) { ret res[Run, Fail].err{err_indirects_pushed.err}; }
        i = i + 1;
    }
    ret res[Run, Fail].ok{r};
}

# the producers section's payload: its fields appended to the producers
# table and their values to the versioned table
pub fun producers(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[Producer](?m.producers);
    var i: usize = 0;
    for (i < r.count) {
        val res_name: res[Name, Fail] = name(m, rd);
        if (sel res_name.err) { ret res[Body, Fail].err{res_name.err}; }
        val res_values: res[Run, Fail] = count(rd);
        if (sel res_values.err) { ret res[Body, Fail].err{res_values.err}; }
        var run: Run = res_values.ok;
        run.first = vector.length[Versioned](?m.versioned);
        var k: usize = 0;
        for (k < run.count) {
            val res_name: res[Name, Fail] = name(m, rd);
            if (sel res_name.err) { ret res[Body, Fail].err{res_name.err}; }
            val res_version: res[Name, Fail] = name(m, rd);
            if (sel res_version.err) { ret res[Body, Fail].err{res_version.err}; }
            val err_versioned_pushed: err[Fail] = vectors.push[Versioned](?m.versioned, Versioned{name: res_name.ok, version: res_version.ok});
            if (sel err_versioned_pushed.err) { ret res[Body, Fail].err{err_versioned_pushed.err}; }
            k = k + 1;
        }
        val err_producers_pushed: err[Fail] = vectors.push[Producer](?m.producers, Producer{name: res_name.ok, values: run});
        if (sel err_producers_pushed.err) { ret res[Body, Fail].err{err_producers_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.producers{r}};
}

# the target_features section's payload: each feature's prefix byte and
# name, appended to the features table
pub fun features(m: *Module, rd: *Reader) res[Body, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[Body, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[Feature](?m.features);
    var i: usize = 0;
    for (i < r.count) {
        val res_prefix: res[u8, Fail] = byte(rd);
        if (sel res_prefix.err) { ret res[Body, Fail].err{res_prefix.err}; }
        val res_name: res[Name, Fail] = name(m, rd);
        if (sel res_name.err) { ret res[Body, Fail].err{res_name.err}; }
        val err_features_pushed: err[Fail] = vectors.push[Feature](?m.features, Feature{prefix: res_prefix.ok, name: res_name.ok});
        if (sel err_features_pushed.err) { ret res[Body, Fail].err{err_features_pushed.err}; }
        i = i + 1;
    }
    ret res[Body, Fail].ok{Body.features{r}};
}

# the dylink.0 section: subsections by id, the rest held raw
fun dylink(m: *Module, rd: *Reader) res[Body, Fail] {
    var r: Run = Run{first: vector.length[DylinkSub](?m.dylink_subs), count: 0, width: 0};
    for (reader.remaining(rd) > 0) {
        val res_sub: res[Sub, Fail] = subsection(rd);
        if (sel res_sub.err) { ret res[Body, Fail].err{res_sub.err}; }
        var s:        Sub                   = res_sub.ok;
        val k:        Mark                  = model.mark(m);
        val res_body: res[DylinkBody, Fail] = dylink_sub(m, ?s);
        var held:     DylinkBody;
        if (sel res_body.ok) { held = res_body.ok; }
        or (sel res_body.err) {
            if (!holdable(res_body.err)) { ret res[Body, Fail].err{res_body.err}; }
            model.truncate(m, k);
            val res_whole: res[Held, Fail] = whole_of(?s.rd);
            if (sel res_whole.err) { ret res[Body, Fail].err{res_whole.err}; }
            held = DylinkBody.raw{Raw{bytes: res_whole.ok, why: Why.unsupported{}}};
        }
        val err_dylink_subs_pushed: err[Fail] = vectors.push[DylinkSub](?m.dylink_subs, DylinkSub{id: s.id, width: s.width, body: held});
        if (sel err_dylink_subs_pushed.err) { ret res[Body, Fail].err{err_dylink_subs_pushed.err}; }
        r.count = r.count + 1;
    }
    ret res[Body, Fail].ok{Body.dylink{r}};
}

# one dylink.0 subsection by its id, drained to its end, or held raw as
# opaque when no id names it
fun dylink_sub(m: *Module, s: *Sub) res[DylinkBody, Fail] {
    var res_body: res[DylinkBody, Fail];
    if (s.id::u64 == tables.WASM_DYLINK_MEM_INFO.value)     { res_body = mem_info(?s.rd); }
    or (s.id::u64 == tables.WASM_DYLINK_NEEDED.value)       { res_body = name_list(m, ?s.rd, true); }
    or (s.id::u64 == tables.WASM_DYLINK_RUNTIME_PATH.value) { res_body = name_list(m, ?s.rd, false); }
    or (s.id::u64 == tables.WASM_DYLINK_EXPORT_INFO.value)  { res_body = export_infos(m, ?s.rd); }
    or (s.id::u64 == tables.WASM_DYLINK_IMPORT_INFO.value)  { res_body = import_infos(m, ?s.rd); }
    or {
        val res_rest: res[Held, Fail] = rest(?s.rd);
        if (sel res_rest.err) { ret res[DylinkBody, Fail].err{res_rest.err}; }
        ret res[DylinkBody, Fail].ok{DylinkBody.raw{Raw{bytes: res_rest.ok, why: Why.opaque{}}}};
    }
    if (sel res_body.err) { ret res_body; }
    val err_drained: err[Fail] = drained(?s.rd);
    if (sel err_drained.err) { ret res[DylinkBody, Fail].err{err_drained.err}; }
    ret res_body;
}

fun mem_info(rd: *Reader) res[DylinkBody, Fail] {
    val res_uleb: res[Leb, Fail] = uleb(rd);
    if (sel res_uleb.err) { ret res[DylinkBody, Fail].err{res_uleb.err}; }
    val res_memory_align: res[Leb, Fail] = uleb(rd);
    if (sel res_memory_align.err) { ret res[DylinkBody, Fail].err{res_memory_align.err}; }
    val res_table_size: res[Leb, Fail] = uleb(rd);
    if (sel res_table_size.err) { ret res[DylinkBody, Fail].err{res_table_size.err}; }
    val res_table_align: res[Leb, Fail] = uleb(rd);
    if (sel res_table_align.err) { ret res[DylinkBody, Fail].err{res_table_align.err}; }
    ret res[DylinkBody, Fail].ok{DylinkBody.mem{MemInfo{memory_size: res_uleb.ok, memory_align: res_memory_align.ok, table_size: res_table_size.ok, table_align: res_table_align.ok}}};
}

# a vector of names appended to the names table, as the needed libraries
# when `needed`, the runtime paths otherwise
fun name_list(m: *Module, rd: *Reader, needed: bool) res[DylinkBody, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[DylinkBody, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[Name](?m.names);
    var i: usize = 0;
    for (i < r.count) {
        val res_name: res[Name, Fail] = name(m, rd);
        if (sel res_name.err) { ret res[DylinkBody, Fail].err{res_name.err}; }
        val err_names_pushed: err[Fail] = vectors.push[Name](?m.names, res_name.ok);
        if (sel err_names_pushed.err) { ret res[DylinkBody, Fail].err{err_names_pushed.err}; }
        i = i + 1;
    }
    if (needed) { ret res[DylinkBody, Fail].ok{DylinkBody.needed{r}}; }
    ret res[DylinkBody, Fail].ok{DylinkBody.paths{r}};
}

fun export_infos(m: *Module, rd: *Reader) res[DylinkBody, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[DylinkBody, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[ExportInfo](?m.export_infos);
    var i: usize = 0;
    for (i < r.count) {
        val res_name: res[Name, Fail] = name(m, rd);
        if (sel res_name.err) { ret res[DylinkBody, Fail].err{res_name.err}; }
        val res_flags: res[Leb, Fail] = uleb(rd);
        if (sel res_flags.err) { ret res[DylinkBody, Fail].err{res_flags.err}; }
        val err_export_infos_pushed: err[Fail] = vectors.push[ExportInfo](?m.export_infos, ExportInfo{name: res_name.ok, flags: res_flags.ok});
        if (sel err_export_infos_pushed.err) { ret res[DylinkBody, Fail].err{err_export_infos_pushed.err}; }
        i = i + 1;
    }
    ret res[DylinkBody, Fail].ok{DylinkBody.exports{r}};
}

fun import_infos(m: *Module, rd: *Reader) res[DylinkBody, Fail] {
    val res_count: res[Run, Fail] = count(rd);
    if (sel res_count.err) { ret res[DylinkBody, Fail].err{res_count.err}; }
    var r: Run = res_count.ok;
    r.first = vector.length[ImportInfo](?m.import_infos);
    var i: usize = 0;
    for (i < r.count) {
        val res_module: res[Name, Fail] = name(m, rd);
        if (sel res_module.err) { ret res[DylinkBody, Fail].err{res_module.err}; }
        val res_field: res[Name, Fail] = name(m, rd);
        if (sel res_field.err) { ret res[DylinkBody, Fail].err{res_field.err}; }
        val res_flags: res[Leb, Fail] = uleb(rd);
        if (sel res_flags.err) { ret res[DylinkBody, Fail].err{res_flags.err}; }
        val err_import_infos_pushed: err[Fail] = vectors.push[ImportInfo](?m.import_infos, ImportInfo{module: res_module.ok, field: res_field.ok, flags: res_flags.ok});
        if (sel err_import_infos_pushed.err) { ret res[DylinkBody, Fail].err{err_import_infos_pushed.err}; }
        i = i + 1;
    }
    ret res[DylinkBody, Fail].ok{DylinkBody.imports{r}};
}
