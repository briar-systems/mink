# the type index space of a wasm link
#
# a type's fact holds it as its input wrote it, in that input's type indices,
# and a recursion group's first type opens with the group's head, so a group
# stays whole. the link shares a group that states what an earlier one states,
# compared with every index outside the group given the image's and every
# index inside it as its place in the group, so two inputs that number the
# same types differently share them. a single type is a group of one without a
# head, as the specification's canonicalization reads it. a type names only
# the types before it and its own group, which is what lets the link number
# them in order.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.wasm.model;
use mink.format.wasm.model.Module;
use mink.format.wasm.model.RecType;
use mink.format.wasm.model.Run;
use mink.format.wasm.model.SubType;
use mink.format.wasm.model.ValType;
use mink.format.wasm.read;
use mink.format.wasm.tables;
use mink.format.wasm.write;
use mink.link.assign;
use mink.link.assign.Assigned;
use mink.link.assign.Sharing;
use mink.link.input.Input;
use mink.model.object;
use mink.model.object.Entry;
use mink.model.object.Fact;
use mink.model.object.Object;
use mink.model.space;

# how the indices of one group's types are written
# ---
# ob:       the object holding the group
# id:       its input
# assigned: the indices the image gave
# first:    the type index of the group's first type in `ob`
# count:    how many types it holds
# base:     the image's index of the group's first type, none while it is
#           being compared and has no index of its own
rec Mapping {
    ob:       *Object;
    id:       Id[Input];
    assigned: *Assigned;
    first:    u64;
    count:    u64;
    base:     opt[u64];
}

# the entry of `ob` the type index `index` names, as its types are its first
# entries
pub fun entry_of(ob: *Object, index: u64) res[Id[Entry], Fail] {
    if (index >= table.count[Entry](?ob.entries)::u64) { ret res[Id[Entry], Fail].err{fail.malformed("a type index passes the type section")}; }
    val e: Id[Entry] = table.nth[Entry](index::usize);
    if (table.at[Entry](?ob.entries, e).space != ?space.TYPES) { ret res[Id[Entry], Fail].err{fail.malformed("a type index passes the type section")}; }
    ret res[Id[Entry], Fail].ok{e};
}

# the bytes of the type fact of the type entry `e` of `ob`
pub fun stated(ob: *Object, e: Id[Entry]) res[Bytes, Fail] {
    val f: opt[Id[Fact]] = table.at[Entry](?ob.entries, e).stated;
    if (sel f.none) { ret res[Bytes, Fail].err{fail.in_indexed(fail.unsupported("an entry states no type the module can write"), "entry", e.index::u64)}; }
    ret res[Bytes, Fail].ok{object.bytes(ob, ?table.at[Fact](?ob.facts, f.some).data)};
}

# write the index `local` a type of the group names. what lies inside the group
# is its place there when the group has no index yet, each index then marked
# as inside or outside, and an index past the group is refused
fun mapped(x: *Mapping, local: u64, signed: bool, out: *Sink) err[Fail] {
    val compared: bool = sel x.base.none;
    var value:    u64  = 0;
    var inside:   bool = false;
    if (local >= x.first + x.count) { ret err[Fail].err{fail.valued(fail.malformed("a type names a type past its own recursion group"), local::i128)}; }
    if (local >= x.first) {
        inside = true;
        value  = local - x.first;
    }
    or {
        val e: res[Id[Entry], Fail] = entry_of(x.ob, local);
        if (sel e.err) { ret err[Fail].err{e.err}; }
        val at: opt[*assign.Index] = assign.index_of(x.assigned, x.id, e.ok);
        if (sel at.none) { ret err[Fail].err{fail.valued(fail.unsupported("a type names a type the image does not keep"), local::i128)}; }
        value = at.some.index;
    }
    if (compared) {
        var mark: u8 = 0;
        if (inside) { mark = 1; }
        val w: err[Fail] = sink.u8(out, mark);
        if (sel w.err) { ret w; }
    }
    if (sel x.base.some) {
        if (inside) { value = x.base.some + value; }
    }
    if (signed) { ret write.sleb(out, value::i64, model.SHORTEST); }
    ret write.leb(out, value, model.SHORTEST);
}

# copy the value type at `rd` to `out`, its type index, if any, given the
# group's mapping
fun value(x: *Mapping, rd: *Reader, out: *Sink) err[Fail] {
    val start: usize              = rd.pos;
    val v:     res[ValType, Fail] = read.valtype(rd);
    if (sel v.err) { ret err[Fail].err{v.err}; }
    var vt: ValType = v.ok;
    if (!model.value_names_type(?vt)) { ret sink.bytes(out, ?rd.data[start], rd.pos - start); }
    # a reference naming a type by index is its one prefix byte, then the index
    val p: err[Fail] = sink.u8(out, rd.data[start]);
    if (sel p.err)         { ret p; }
    if (!sel vt.reference) { ret err[Fail].err{fail.internal("a value type names a type and is no reference")}; }
    val heap: model.Heap = vt.reference.heap;
    if (!sel heap.index) { ret err[Fail].err{fail.internal("a reference names a type and has no index")}; }
    ret mapped(x, heap.index.value::u64, true, out);
}

# copy the `n` value types of a vector at `rd` to `out`, count first
fun values(x: *Mapping, rd: *Reader, out: *Sink) err[Fail] {
    val n: res[u64, Fail] = reader.uleb(rd);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val w: err[Fail] = write.leb(out, n.ok, model.SHORTEST);
    if (sel w.err) { ret w; }
    var i: u64 = 0;
    for (i < n.ok) {
        val e: err[Fail] = value(x, rd, out);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# copy a field at `rd` to `out`: a packed storage byte or a value type, then
# its mutability
fun field(x: *Mapping, rd: *Reader, out: *Sink) err[Fail] {
    val b: res[u8, Fail] = reader.u8(rd);
    if (sel b.err) { ret err[Fail].err{b.err}; }
    if (read.is_packed(b.ok)) {
        val w: err[Fail] = sink.u8(out, b.ok);
        if (sel w.err) { ret w; }
    }
    or {
        rd.pos = rd.pos - 1;
        val e: err[Fail] = value(x, rd, out);
        if (sel e.err) { ret e; }
    }
    val mu: res[u8, Fail] = reader.u8(rd);
    if (sel mu.err) { ret err[Fail].err{mu.err}; }
    ret sink.u8(out, mu.ok);
}

# copy the composite type at `rd` to `out`
fun composite(x: *Mapping, rd: *Reader, out: *Sink) err[Fail] {
    val form: res[u8, Fail] = reader.u8(rd);
    if (sel form.err) { ret err[Fail].err{form.err}; }
    val w: err[Fail] = sink.u8(out, form.ok);
    if (sel w.err) { ret w; }
    if (form.ok::u64 == tables.WASM_TYPE_FUNC.value) {
        val p: err[Fail] = values(x, rd, out);
        if (sel p.err) { ret p; }
        ret values(x, rd, out);
    }
    if (form.ok::u64 == tables.WASM_TYPE_ARRAY.value)  { ret field(x, rd, out); }
    if (form.ok::u64 != tables.WASM_TYPE_STRUCT.value) { ret err[Fail].err{fail.valued(fail.malformed("a type of no composite form"), form.ok::i128)}; }
    val n: res[u64, Fail] = reader.uleb(rd);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val c: err[Fail] = write.leb(out, n.ok, model.SHORTEST);
    if (sel c.err) { ret c; }
    var i: u64 = 0;
    for (i < n.ok) {
        val e: err[Fail] = field(x, rd, out);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# copy the type at `rd` to `out`: its prefix and supertypes, then its composite
# type
fun member(x: *Mapping, rd: *Reader, out: *Sink) err[Fail] {
    val b: res[u8, Fail] = read.peek_byte(rd);
    if (sel b.err)          { ret err[Fail].err{b.err}; }
    if (!read.is_sub(b.ok)) { ret composite(x, rd, out); }
    rd.pos = rd.pos + 1;
    val w: err[Fail] = sink.u8(out, b.ok);
    if (sel w.err) { ret w; }
    val n: res[u64, Fail] = reader.uleb(rd);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val c: err[Fail] = write.leb(out, n.ok, model.SHORTEST);
    if (sel c.err) { ret c; }
    var i: u64 = 0;
    for (i < n.ok) {
        val s: res[u64, Fail] = reader.uleb(rd);
        if (sel s.err) { ret err[Fail].err{s.err}; }
        val e: err[Fail] = mapped(x, s.ok, false, out);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    ret composite(x, rd, out);
}

# how many types the group the type entry `k` of `ob` heads holds, and whether
# it was written as a group
fun head(ob: *Object, k: usize) res[read.Head, Fail] {
    val b: res[Bytes, Fail] = stated(ob, table.nth[Entry](k));
    if (sel b.err) { ret res[read.Head, Fail].err{b.err}; }
    var rd: Reader = reader.make(nil, b.ok.data, b.ok.len, LITTLE);
    ret read.group_head(?rd);
}

# write the `j`th type of the group `h` to `out`
fun member_at(x: *Mapping, j: u64, out: *Sink) err[Fail] {
    val e: res[Id[Entry], Fail] = entry_of(x.ob, x.first + j);
    if (sel e.err) { ret err[Fail].err{e.err}; }
    val b: res[Bytes, Fail] = stated(x.ob, e.ok);
    if (sel b.err) { ret err[Fail].err{b.err}; }
    var rd: Reader = reader.make(nil, b.ok.data, b.ok.len, LITTLE);
    if (j == 0) {
        val h: res[read.Head, Fail] = read.group_head(?rd);
        if (sel h.err) { ret err[Fail].err{h.err}; }
    }
    val m: err[Fail] = member(x, ?rd, out);
    if (sel m.err) { ret m; }
    ret read.drained(?rd);
}

# what identifies the group the entry `k` of `ob` heads, into `key`, and how
# many entries it holds
fun group(ob: *Object, id: Id[Input], k: usize, s: *Assigned, key: *Sink) res[usize, Fail] {
    val h: res[read.Head, Fail] = head(ob, k);
    if (sel h.err)       { ret res[usize, Fail].err{fail.in_indexed(h.err, "recursion group", k::u64)}; }
    if (h.ok.count == 0) { ret res[usize, Fail].err{fail.in_indexed(fail.malformed("a type fact opens a recursion group of no types"), "recursion group", k::u64)}; }
    var x: Mapping   = Mapping{ob: ob, id: id, assigned: s, first: k::u64, count: h.ok.count, base: opt[u64].none{}};
    var e: err[Fail] = sink.u8(key, h.ok.grouped::u8);
    e = fail.kept(e, write.leb(key, h.ok.count, model.SHORTEST));
    var j: u64 = 0;
    for (sel e.ok && j < h.ok.count) {
        e = member_at(?x, j, key);
        j = j + 1;
    }
    if (sel e.err) { ret res[usize, Fail].err{fail.in_indexed(e.err, "recursion group", k::u64)}; }
    ret res[usize, Fail].ok{h.ok.count::usize};
}

# how the link shares the wasm type space
pub val SHARING: Sharing = Sharing{space: ?space.TYPES, group: group};

# the type `out` holds, into the module's tables
fun pushed(m: *Module, out: *Sink) err[Fail] {
    var rd: Reader             = reader.make(nil, sink.data(out), sink.len(out), LITTLE);
    val t:  res[SubType, Fail] = read.sub_type(m, ?rd);
    if (sel t.err) { ret err[Fail].err{t.err}; }
    val p: res[Id[SubType], Fail] = table.push[SubType](?m.types, t.ok);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the group the entry `k` of `ob` heads, into the module's tables with the
# image's indices, its first type at the image's index `base`
pub fun written(m: *Module, ob: *Object, id: Id[Input], k: usize, base: u64, s: *Assigned) res[RecType, Fail] {
    val h: res[read.Head, Fail] = head(ob, k);
    if (sel h.err) { ret res[RecType, Fail].err{fail.in_indexed(h.err, "recursion group", k::u64)}; }
    var x:     Mapping = Mapping{ob: ob, id: id, assigned: s, first: k::u64, count: h.ok.count, base: opt[u64].some{base}};
    val first: usize   = table.count[SubType](?m.types);
    var j:     u64     = 0;
    for (j < h.ok.count) {
        var out: Sink      = sink.make(m.a, LITTLE);
        val w:   err[Fail] = member_at(?x, j, ?out);
        var e:   err[Fail] = w;
        if (sel w.ok) { e = pushed(m, ?out); }
        e = fail.kept(e, sink.release(?out));
        if (sel e.err) { ret res[RecType, Fail].err{fail.in_indexed(e.err, "recursion group", k::u64)}; }
        j = j + 1;
    }
    ret res[RecType, Fail].ok{RecType{grouped: h.ok.grouped, members: Run{first: first, count: h.ok.count::usize, width: model.SHORTEST}}};
}

# whether the function type stated by the fact bytes `b` takes and returns no
# value, refused for a type of another form
pub fun takes_nothing(b: Bytes) res[bool, Fail] {
    var rd: Reader               = reader.make(nil, b.data, b.len, LITTLE);
    val h:  res[read.Head, Fail] = read.group_head(?rd);
    if (sel h.err) { ret res[bool, Fail].err{h.err}; }
    val p: err[Fail] = read.past_supers(?rd);
    if (sel p.err) { ret res[bool, Fail].err{p.err}; }
    val form: res[u8, Fail] = reader.u8(?rd);
    if (sel form.err)                                { ret res[bool, Fail].err{form.err}; }
    if (form.ok::u64 != tables.WASM_TYPE_FUNC.value) { ret res[bool, Fail].err{fail.malformed("a function's type is no function type")}; }
    val params: res[u64, Fail] = reader.uleb(?rd);
    if (sel params.err) { ret res[bool, Fail].err{params.err}; }
    if (params.ok != 0) { ret res[bool, Fail].ok{false}; }
    val results: res[u64, Fail] = reader.uleb(?rd);
    if (sel results.err) { ret res[bool, Fail].err{results.err}; }
    ret res[bool, Fail].ok{results.ok == 0};
}

# refuse a function body one of whose locals names a type by its index, which
# no relocation of the tool conventions renumbers
pub fun plain_locals(body: Bytes) err[Fail] {
    var rd: Reader         = reader.make(nil, body.data, body.len, LITTLE);
    val n:  res[u64, Fail] = reader.uleb(?rd);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    var i: u64 = 0;
    for (i < n.ok) {
        val c: res[u64, Fail] = reader.uleb(?rd);
        if (sel c.err) { ret err[Fail].err{c.err}; }
        val v: res[ValType, Fail] = read.valtype(?rd);
        if (sel v.err) { ret err[Fail].err{v.err}; }
        var vt: ValType = v.ok;
        if (model.value_names_type(?vt)) { ret err[Fail].err{fail.unsupported("a function's local names a type by its index, which no relocation renumbers")}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}
