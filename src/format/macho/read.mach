    val n: Name = wname(k);
    ret loaded(k, Load.target_triple{n});
}

# lay the file after the load commands out as extents
fun layout(x: *Ctx) err[Fail] {
    var all:         Vector[Range] = vector.init[Range](x.m.a);
    val err_collect: err[Fail]     = collect(x, ?all);
    if (sel err_collect.err) {
        val err_dropped: err[Fail] = vectors.dnit[Range](?all);
        ret err_collect;
    }
    sort.sort_by[Range](all.data, vector.length[Range](?all), by_start);
    val err_emit: err[Fail] = emit(x, ?all);
    val err_rel:  err[Fail] = vectors.dnit[Range](?all);
    if (sel err_emit.err) { ret err_emit; }
    ret err_rel;
}

# gather every range the commands name
fun collect(x: *Ctx, all: *Vector[Range]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Command](?x.m.commands)) {
        val c:                 *Command  = model.command_at(x.m, table.nth[Command](i));
        val err_place_command: err[Fail] = place_command(x, all, i, c);
        if (sel err_place_command.err) { ret err[Fail].err{fail.in_indexed(err_place_command.err, "load command", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# gather the ranges load command `i` names: its sections' bytes and
# relocations, or the tables its field pairs name
fun place_command(x: *Ctx, all: *Vector[Range], i: usize, c: *Command) err[Fail] {
    val cls:    *Class = x.c;
    val at_cmd: u64    = x.offsets.data[i];
    val base:   Range  = Range{cmd: i::u32, part: Part.symbols{}};
    if (sel c.body.segment) {
        var j: usize = 0;
        for (j < vector.length[Section](?c.body.segment.sections)) {
            val s:      *Section = ?c.body.segment.sections.data[j];
            val header: u64      = at_cmd + cls.segment.size::u64 + j::u64 * cls.section.size::u64;
            var one:    Range    = base;
            one.sect = j::u32;
            if (!zerofill(s)) {
                one.kind = KIND_SECTION;
                val err_put_counted: err[Fail] = put_counted(x, all, one, s.offset::u64, s.length, 1, header + cls.section.offset.offset::u64);
                if (sel err_put_counted.err) { ret err[Fail].err{fail.in_indexed(err_put_counted.err, "section", j::u64)}; }
            }
            one.kind = KIND_RELOCS;
            val err_put_counted: err[Fail] = put_counted(x, all, one, s.reloff::u64, s.nreloc::u64, RELOC_SIZE, header + cls.section.reloff.offset::u64);
            if (sel err_put_counted.err) { ret err[Fail].err{fail.in_indexed(err_put_counted.err, "section", j::u64)}; }
            j = j + 1;
        }
        ret err[Fail].ok{};
    }
    if (sel c.body.symtab) {
        val err_part: err[Fail] = part(x, all, base, Part.symbols{}, c, at_cmd);
        if (sel err_part.err) { ret err_part; }
        ret part(x, all, base, Part.strings{}, c, at_cmd);
    }
    if (sel c.body.dysymtab)  { ret place_dysymtab(x, all, base, c, ?c.body.dysymtab, at_cmd); }
    if (sel c.body.hints)     { ret part(x, all, base, Part.hints{}, c, at_cmd); }
    if (sel c.body.dyld_info) { ret place_dyld_info(x, all, base, c, ?c.body.dyld_info, at_cmd); }
    if (sel c.body.linkedit)  { ret part(x, all, base, Part.data{}, c, at_cmd); }
    if (sel c.body.note)      { ret part(x, all, base, Part.note{}, c, at_cmd); }
    if (sel c.body.symseg)    { ret part(x, all, base, Part.symseg{}, c, at_cmd); }
    ret err[Fail].ok{};
}

# gather the ranges of the tables the dynamic symbol table names
fun place_dysymtab(x: *Ctx, all: *Vector[Range], base: Range, c: *Command, d: *Dysymtab, at_cmd: u64) err[Fail] {
    val err_toc_placed: err[Fail] = part(x, all, base, Part.toc{}, c, at_cmd);
    if (sel err_toc_placed.err) { ret err_toc_placed; }
    val err_modules_placed: err[Fail] = part(x, all, base, Part.modules{}, c, at_cmd);
    if (sel err_modules_placed.err) { ret err_modules_placed; }
    val err_refs_placed: err[Fail] = part(x, all, base, Part.refs{}, c, at_cmd);
    if (sel err_refs_placed.err) { ret err_refs_placed; }
    val err_indirect_placed: err[Fail] = part(x, all, base, Part.indirect{}, c, at_cmd);
    if (sel err_indirect_placed.err) { ret err_indirect_placed; }
    val err_extrel_placed: err[Fail] = part(x, all, base, Part.extrel{}, c, at_cmd);
    if (sel err_extrel_placed.err) { ret err_extrel_placed; }
    ret part(x, all, base, Part.locrel{}, c, at_cmd);
}

# gather the ranges of the rebase, bind, weak bind, lazy bind and export
# streams the dyld info command names
fun place_dyld_info(x: *Ctx, all: *Vector[Range], base: Range, c: *Command, d: *DyldInfo, at_cmd: u64) err[Fail] {
    val err_rebase_placed: err[Fail] = part(x, all, base, Part.rebase{}, c, at_cmd);
    if (sel err_rebase_placed.err) { ret err_rebase_placed; }
    val err_bind_placed: err[Fail] = part(x, all, base, Part.bind{}, c, at_cmd);
    if (sel err_bind_placed.err) { ret err_bind_placed; }
    val err_weak_bind_placed: err[Fail] = part(x, all, base, Part.weak_bind{}, c, at_cmd);
    if (sel err_weak_bind_placed.err) { ret err_weak_bind_placed; }
    val err_lazy_bind_placed: err[Fail] = part(x, all, base, Part.lazy_bind{}, c, at_cmd);
    if (sel err_lazy_bind_placed.err) { ret err_lazy_bind_placed; }
    ret part(x, all, base, Part.exports{}, c, at_cmd);
}

# gather the range of the field pair `p` of command `c`
fun part(x: *Ctx, all: *Vector[Range], base: Range, p: Part, c: *Command, at_cmd: u64) err[Fail] {
    val res_part_span: res[Span, Fail] = model.part_span(x.c, c, p, loc(x, at_cmd));
    if (sel res_part_span.err) { ret err[Fail].err{res_part_span.err}; }
    var r: Range = base;
    r.kind = KIND_BLOB;
    r.part = p;
    ret put(x, all, r, res_part_span.ok, at_cmd);
}

# add the range `sp` as `what`, which must lie in the file, `at_field` the
# offset of the field that names it for a refusal. an empty range names no
# bytes and is not added
fun put(x: *Ctx, all: *Vector[Range], what: Range, sp: Span, at_field: u64) err[Fail] {
    if (sp.size == 0) { ret err[Fail].ok{}; }
    val res_end: res[u64, Fail] = checked.add(loc(x, at_field), sp.offset, sp.size);
    if (sel res_end.err) { ret err[Fail].err{res_end.err}; }
    if (res_end.ok > x.in.len::u64) {
        ret err[Fail].err{at(fail.truncated("bytes run past the end of the file"), at_field)};
    }
    var r: Range = what;
    r.start = sp.offset;
    r.end   = res_end.ok;
    val err_pushed: err[Fail] = vectors.push[Range](all, r);
    if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
    ret err[Fail].ok{};
}

# `put` for `count` records of `size` bytes at `offset`
fun put_counted(x: *Ctx, all: *Vector[Range], what: Range, offset: u64, count: u64, size: u64, at_field: u64) err[Fail] {
    val res_counted: res[Span, Fail] = model.counted(loc(x, at_field), offset, count, size);
    if (sel res_counted.err) { ret err[Fail].err{res_counted.err}; }
    ret put(x, all, what, res_counted.ok, at_field);
}

fun by_start(a: *Range, b: *Range) i64 {
    if (a.start != b.start) {
        if (a.start < b.start) { ret -1; }
        ret 1;
    }
    if (a.kind != b.kind) { ret a.kind::i64 - b.kind::i64; }
    if (a.cmd != b.cmd)   { ret a.cmd::i64 - b.cmd::i64; }
    ret a.sect::i64 - b.sect::i64;
}

# tile the file after the commands with extents, in file order
fun emit(x: *Ctx, all: *Vector[Range]) err[Fail] {
    var cursor: u64   = x.end;
    var k:      usize = 0;
    for (k < vector.length[Range](all)) {
        val r: Range = all.data[k];
        if (r.start < cursor) {
            ret err[Fail].err{at(fail.in_record(fail.malformed("bytes belong to two records"), "file layout"), r.start)};
        }
        if (r.start > cursor) {
            val err_push_raw: err[Fail] = push_raw(x, cursor, r.start);
            if (sel err_push_raw.err) { ret err_push_raw; }
        }
        val err_emit_range: err[Fail] = emit_range(x, r);
        if (sel err_emit_range.err) { ret err[Fail].err{fail.in_indexed(err_emit_range.err, "load command", r.cmd::u64)}; }
        cursor = r.end;
        k      = k + 1;
    }
    if (cursor < x.in.len::u64) { ret push_raw(x, cursor, x.in.len::u64); }
    ret err[Fail].ok{};
}

# hold the bytes from `start` to `end` as a raw extent
fun push_raw(x: *Ctx, start: u64, end: u64) err[Fail] {
    val res_held: res[Held, Fail] = held(?x.file, start, end - start);
    if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
    ret push_extent(x, Extent.raw{res_held.ok});
}

fun push_extent(x: *Ctx, e: Extent) err[Fail] {
    val err_extents_pushed: err[Fail] = vectors.push[Extent](?x.m.extents, e);
    if (sel err_extents_pushed.err) { ret err[Fail].err{err_extents_pushed.err}; }
    ret err[Fail].ok{};
}

# read the range `r` into the model and add its extent: a blob, a section's
# body or a section's relocations
fun emit_range(x: *Ctx, r: Range) err[Fail] {
    val res_sub: res[Reader, Fail] = reader.sub(?x.file, r.start, r.end - r.start);
    if (sel res_sub.err) { ret err[Fail].err{res_sub.err}; }
    var rd: Reader = res_sub.ok;
    if (r.kind == KIND_BLOB) { ret emit_blob(x, r, ?rd); }
    val ref:     SectionRef          = SectionRef{command: table.nth[Command](r.cmd::usize), index: r.sect};
    val res_sec: res[*Section, Fail] = model.section(x.m, ref);
    if (sel res_sec.err) { ret err[Fail].err{res_sec.err}; }
    if (r.kind == KIND_SECTION) {
        val res_read_body: res[Body, Fail] = read_body(x, res_sec.ok, ?rd);
        if (sel res_read_body.err) { ret err[Fail].err{fail.in_indexed(res_read_body.err, "section", r.sect::u64)}; }
        res_sec.ok.body = res_read_body.ok;
        ret push_extent(x, Extent.section{ref});
    }
    val res_relocs: res[Table[Reloc], Fail] = relocs(x, ?rd, rd.len::u64 / RELOC_SIZE);
    if (sel res_relocs.err) { ret err[Fail].err{fail.in_indexed(res_relocs.err, "section", r.sect::u64)}; }
    res_sec.ok.relocs = res_relocs.ok;
    ret push_extent(x, Extent.relocs{ref});
}

# the body of a section that owns bytes: typed when its type says so and the
# records tile it, raw otherwise
fun read_body(x: *Ctx, s: *Section, rd: *Reader) res[Body, Fail] {
    val size: u64 = x.c.tlv.size::u64;
    if (model.section_type(s) == tables.S_THREAD_LOCAL_VARIABLES.value::u32) {
        if (rd.len::u64 % size != 0) { ret body_raw(rd, res[Why, Fail].ok{Why.unsupported{}}); }
        ret tlvs(x, rd, rd.len::u64 / size);
    }
    if (model.section_named(s, tables.SEG_TEXT.text, tables.SECT_UNWIND_INFO.text))  { ret unwind_info(x, rd); }
    if (model.section_named(s, tables.SEG_LD.text, tables.SECT_COMPACT_UNWIND.text)) { ret compact_unwind(x, rd); }
    ret body_raw(rd, res[Why, Fail].ok{Why.opaque{}});
}

# the bytes of `rd` held raw for `why`, or the failure that is no reason
fun body_raw(rd: *Reader, why: res[Why, Fail]) res[Body, Fail] {
    val res_raw_of: res[Raw, Fail] = raw_of(rd, why);
    if (sel res_raw_of.err) { ret res[Body, Fail].err{res_raw_of.err}; }
    ret res[Body, Fail].ok{Body.raw{res_raw_of.ok}};
}

# the bytes of `rd` held raw for `why`, or the failure that is no reason
fun data_raw(rd: *Reader, why: res[Why, Fail]) res[Data, Fail] {
    val res_raw_of: res[Raw, Fail] = raw_of(rd, why);
    if (sel res_raw_of.err) { ret res[Data, Fail].err{res_raw_of.err}; }
    ret res[Data, Fail].ok{Data.raw{res_raw_of.ok}};
}

# the bytes of `rd` held for `why`, or the failure that is no reason
fun raw_of(rd: *Reader, why: res[Why, Fail]) res[Raw, Fail] {
    if (sel why.err) { ret res[Raw, Fail].err{why.err}; }
    val res_held: res[Held, Fail] = held(rd, 0, rd.len::u64);
    if (sel res_held.err) { ret res[Raw, Fail].err{res_held.err}; }
    ret res[Raw, Fail].ok{Raw{bytes: res_held.ok, why: why.ok}};
}

# why a codec held bytes back: it declined them, or it failed and the file is refused
fun reason(f: Fail) res[Why, Fail] {
    if (sel f.cause.unsupported) { ret res[Why, Fail].ok{Why.unsupported{}}; }
    ret res[Why, Fail].err{f};
}

# whether the sink holds the first `n` bytes of `rd`, given back by the sink. an
# encoder that declined its entries reproduces nothing, and any other failure
# of it is the file's
fun verdict(rd: *Reader, s: *Sink, e: err[Fail], n: usize) res[bool, Fail] {
    var same: bool  = !(sel e.err) && sink.len(s) == n && n <= rd.len;
    var i:    usize = 0;
    for (same && i < n) {
        same = sink.data(s)[i] == rd.data[i];
        i    = i + 1;
    }
    val err_dropped: err[Fail] = sink.dnit(s);
    if (sel e.err) {
        if (fail.is_refused(e.err)) { ret res[bool, Fail].err{e.err}; }
    }
    if (sel err_dropped.err) { ret res[bool, Fail].err{err_dropped.err}; }
    ret res[bool, Fail].ok{same};
}

# the unwind info when it encodes back to its bytes, the bytes raw otherwise
fun unwind_info(x: *Ctx, rd: *Reader) res[Body, Fail] {
    val res_decode: res[UnwindInfo, Fail] = unwind.decode(x.m.a, rd);
    if (sel res_decode.err) { ret body_raw(rd, reason(res_decode.err)); }
    var info:       UnwindInfo      = res_decode.ok;
    var s:          Sink            = sink.init(x.m.a, x.order);
    val err_encode: err[Fail]       = unwind.encode(?s, x.m.a, ?info);
    val res_same:   res[bool, Fail] = verdict(rd, ?s, err_encode, rd.len);
    if (sel res_same.err) {
        val err_release_unwind_info: err[Fail] = model.unwind_info_dnit(?info);
        ret res[Body, Fail].err{res_same.err};
    }
    if (!res_same.ok) {
        val err_release_unwind_info: err[Fail] = model.unwind_info_dnit(?info);
        if (sel err_release_unwind_info.err) { ret res[Body, Fail].err{err_release_unwind_info.err}; }
        ret body_raw(rd, res[Why, Fail].ok{Why.irreproducible{}});
    }
    ret res[Body, Fail].ok{Body.info{info}};
}

# the compact unwind entries when they encode back to their bytes, the bytes
# raw otherwise
fun compact_unwind(x: *Ctx, rd: *Reader) res[Body, Fail] {
    val ptr:                usize                     = x.c.addr;
    val res_decode_compact: res[Vector[Unwind], Fail] = unwind.decode_compact(x.m.a, rd, ptr);
    if (sel res_decode_compact.err) { ret body_raw(rd, reason(res_decode_compact.err)); }
    var t:                  Vector[Unwind]  = res_decode_compact.ok;
    var s:                  Sink            = sink.init(x.m.a, x.order);
    val err_encode_compact: err[Fail]       = unwind.encode_compact(?s, ?t, ptr);
    val res_same:           res[bool, Fail] = verdict(rd, ?s, err_encode_compact, rd.len);
    if (sel res_same.err) {
        val err_release: err[Fail] = vectors.dnit[Unwind](?t);
        ret res[Body, Fail].err{res_same.err};
    }
    if (!res_same.ok) {
        val err_release: err[Fail] = vectors.dnit[Unwind](?t);
        if (sel err_release.err) { ret res[Body, Fail].err{err_release.err}; }
        ret body_raw(rd, res[Why, Fail].ok{Why.irreproducible{}});
    }
    ret res[Body, Fail].ok{Body.unwind{t}};
}

# the `n` thread-local variable descriptors of `rd`
fun tlvs(x: *Ctx, rd: *Reader, n: u64) res[Body, Fail] {
    val c:       *Class           = x.c;
    var tab:     Vector[Tlv]      = vector.init[Tlv](x.m.a);
    val res_cnt: res[usize, Fail] = checked.to_usize(reader.here(rd), n);
    if (sel res_cnt.err) { ret res[Body, Fail].err{res_cnt.err}; }
    val err_grow: err[Fail] = vectors.grow[Tlv](?tab, res_cnt.ok);
    if (sel err_grow.err) {
        val err_release: err[Fail] = vectors.dnit[Tlv](?tab);
        ret res[Body, Fail].err{err_grow.err};
    }
    val items: *Tlv = tab.data;
    var k:     u64  = 0;
    for (k < n) {
        val res_rec: res[*u8, Fail] = record(rd, "thread local variable", k, c.tlv.size);
        if (sel res_rec.err) {
            val err_release: err[Fail] = vectors.dnit[Tlv](?tab);
            ret res[Body, Fail].err{res_rec.err};
        }
        val e: *Tlv = ?items[k::usize];
        e.thunk  = slot.field(res_rec.ok, c.tlv.thunk, x.order);
        e.key    = slot.field(res_rec.ok, c.tlv.key, x.order);
        e.offset = slot.field(res_rec.ok, c.tlv.offset, x.order);
        k        = k + 1;
    }
    ret res[Body, Fail].ok{Body.tlv{tab}};
}

# decode the blob of the range `r` into the model and add its extent, a code
# signature's trailing bytes kept as a gap
fun emit_blob(x: *Ctx, r: Range, rd: *Reader) err[Fail] {
    val c:                *Command            = model.command_at(x.m, table.nth[Command](r.cmd::usize));
    val empty:            Raw                 = Raw{bytes: Held.borrowed{Bytes{data: nil, len: 0}}, why: Why.opaque{}};
    val res_blobs_pushed: res[Id[Blob], Fail] = table.push[Blob](?x.m.blobs, Blob{command: table.nth[Command](r.cmd::usize), part: r.part, data: Data.raw{empty}, gaps: vector.init[Gap](x.m.a)});
    if (sel res_blobs_pushed.err) { ret err[Fail].err{res_blobs_pushed.err}; }
    val res_decode: res[Data, Fail] = decode(x, r.part, rd, c);
    if (sel res_decode.err) { ret err[Fail].err{res_decode.err}; }
    val b: *Blob = model.blob_at(x.m, res_blobs_pushed.ok);
    b.data = res_decode.ok;
    if (sel b.data.signature) {
        val err_tail: err[Fail] = signature_tail(b, rd, b.data.signature.length::u64);
        if (sel err_tail.err) { ret err_tail; }
    }
    ret push_extent(x, Extent.blob{res_blobs_pushed.ok});
}

# what the bytes of one field pair of a command hold
fun decode(x: *Ctx, p: Part, rd: *Reader, c: *Command) res[Data, Fail] {
    val n: u64 = rd.len::u64;
    if (sel p.symbols) { ret symbols(x, rd, c); }
    if (sel p.toc)     { ret tocs(x, rd, n / TOC_SIZE); }
    if (sel p.modules) { ret modules(x, rd, n / x.c.module.size::u64); }
    if (sel p.refs) {
        val res_words: res[Vector[u32], Fail] = words(x, rd, n / WORD_SIZE, "reference");
        if (sel res_words.err) { ret res[Data, Fail].err{res_words.err}; }
        ret res[Data, Fail].ok{Data.refs{res_words.ok}};
    }
    if (sel p.indirect) {
        val res_words: res[Vector[u32], Fail] = words(x, rd, n / WORD_SIZE, "indirect symbol");
        if (sel res_words.err) { ret res[Data, Fail].err{res_words.err}; }
        ret res[Data, Fail].ok{Data.indirect{res_words.ok}};
    }
    if (sel p.hints) {
        val res_words: res[Vector[u32], Fail] = words(x, rd, n / WORD_SIZE, "hint");
        if (sel res_words.err) { ret res[Data, Fail].err{res_words.err}; }
        ret res[Data, Fail].ok{Data.hints{res_words.ok}};
    }
    if (sel p.extrel || sel p.locrel) {
        val res_relocs: res[Table[Reloc], Fail] = relocs(x, rd, n / RELOC_SIZE);
        if (sel res_relocs.err) { ret res[Data, Fail].err{res_relocs.err}; }
        ret res[Data, Fail].ok{Data.relocs{res_relocs.ok}};
    }
    if (sel p.rebase)    { ret rebases(x, rd); }
    if (sel p.bind)      { ret binds(x, rd, Flavor.regular{}); }
    if (sel p.weak_bind) { ret binds(x, rd, Flavor.weak{}); }
    if (sel p.lazy_bind) { ret binds(x, rd, Flavor.lazy{}); }
    if (sel p.exports)   { ret export_trie(x, rd); }
    if (sel p.data)      { ret linkedit(x, rd, c); }
    val res_held: res[Held, Fail] = held(rd, 0, n);
    if (sel res_held.err) { ret res[Data, Fail].err{res_held.err}; }
    if (sel p.strings)    { ret res[Data, Fail].ok{Data.strings{res_held.ok}}; }
    ret data_raw(rd, res[Why, Fail].ok{Why.opaque{}});
}

# what the bytes of a linkedit_data_command hold
fun linkedit(x: *Ctx, rd: *Reader, c: *Command) res[Data, Fail] {
    val cmd: u64 = c.cmd::u64;
    if (cmd == tables.LC_FUNCTION_STARTS.value)     { ret function_starts(x, rd); }
    if (cmd == tables.LC_DATA_IN_CODE.value)        { ret data_in_code(x, rd); }
    if (cmd == tables.LC_DYLD_EXPORTS_TRIE.value)   { ret export_trie(x, rd); }
    if (cmd == tables.LC_DYLD_CHAINED_FIXUPS.value) { ret chained(x, rd); }
    if (cmd == tables.LC_CODE_SIGNATURE.value)      { ret code_signature(x, rd); }
    ret data_raw(rd, res[Why, Fail].ok{Why.opaque{}});
}

# the entries when encoding them gives the bytes back, the bytes raw otherwise.
# `t` is released on every path but the first
fun table_or_raw[T](rd: *Reader, t: *Vector[T], same: res[bool, Fail], kept: Data) res[Data, Fail] {
    if (sel same.err) { ret lost[T](t, same.err); }
    if (!same.ok)     { ret dropped[T](t, irreproducible(rd)); }
    ret res[Data, Fail].ok{kept};
}

# the bytes of `rd` held raw because their entries do not encode back to them
fun irreproducible(rd: *Reader) res[Data, Fail] {
    ret data_raw(rd, res[Why, Fail].ok{Why.irreproducible{}});
}

# `then`, once the table is given back
fun dropped[T](t: *Vector[T], then: res[Data, Fail]) res[Data, Fail] {
    val err_release: err[Fail] = vectors.dnit[T](t);
    if (sel err_release.err) { ret res[Data, Fail].err{err_release.err}; }
    ret then;
}

# the rebase entries when they encode back to the stream, the bytes raw
# otherwise
fun rebases(x: *Ctx, rd: *Reader) res[Data, Fail] {
    val ptr:                usize                     = x.c.addr;
    val res_decode_rebases: res[Vector[Rebase], Fail] = opcode.decode_rebases(x.m.a, rd, ptr::u64);
    if (sel res_decode_rebases.err) { ret data_raw(rd, reason(res_decode_rebases.err)); }
    var t:                  Vector[Rebase] = res_decode_rebases.ok;
    var s:                  Sink           = sink.init(x.m.a, x.order);
    val err_encode_rebases: err[Fail]      = opcode.encode_rebases(?s, x.m.a, ?t, ptr::u64, ptr);
    ret table_or_raw[Rebase](rd, ?t, verdict(rd, ?s, err_encode_rebases, rd.len), Data.rebases{t});
}

# the bind entries of `flavor` when they encode back to the stream, the bytes
# raw otherwise, their names owned by the model
fun binds(x: *Ctx, rd: *Reader, flavor: Flavor) res[Data, Fail] {
    val ptr:              usize                   = x.c.addr;
    val stream:           Bytes                   = Bytes{data: rd.data, len: rd.len};
    val res_decode_binds: res[Vector[Bind], Fail] = opcode.decode_binds(x.m.a, rd, flavor, ptr::u64);
    if (sel res_decode_binds.err) { ret data_raw(rd, reason(res_decode_binds.err)); }
    var t:                Vector[Bind]    = res_decode_binds.ok;
    var s:                Sink            = sink.init(x.m.a, x.order);
    val err_encode_binds: err[Fail]       = opcode.encode_binds(?s, x.m.a, ?t, stream, flavor, ptr::u64, ptr);
    val res_same:         res[bool, Fail] = verdict(rd, ?s, err_encode_binds, rd.len);
    if (sel res_same.err) { ret lost[Bind](?t, res_same.err); }
    if (!res_same.ok)     { ret dropped[Bind](?t, irreproducible(rd)); }
    val res_names: res[Held, Fail] = own_names(x, ?t, stream);
    if (sel res_names.err) { ret lost[Bind](?t, res_names.err); }
    ret res[Data, Fail].ok{Data.binds{Binds{entries: t, names: res_names.ok}}};
}

# the names the entries index, owned by the model, and the entries pointed at them
fun own_names(x: *Ctx, entries: *Vector[Bind], stream: Bytes) res[Held, Fail] {
    var pool:           Sink      = sink.init(x.m.a, x.order);
    val err_pool_names: err[Fail] = opcode.pool_names(?pool, entries, stream);
    if (sel err_pool_names.err) {
        val err_dropped: err[Fail] = sink.dnit(?pool);
        ret res[Held, Fail].err{err_pool_names.err};
    }
    val res_own:     res[Held, Fail] = model.own(x.m, sink.data(?pool), sink.len(?pool));
    val err_dropped: err[Fail]       = sink.dnit(?pool);
    if (sel res_own.err)     { ret res_own; }
    if (sel err_dropped.err) { ret res[Held, Fail].err{err_dropped.err}; }
    ret res_own;
}

# the exports when their trie encodes back to the bytes. the names are decoded
# into a store of their own, and the model owns them only on a match
fun export_trie(x: *Ctx, rd: *Reader) res[Data, Fail] {
    val ptr:        usize                     = x.c.addr;
    var st:         Store                     = store.init(x.m.a);
    val res_decode: res[Vector[Export], Fail] = trie.decode(x.m.a, ?st, rd);
    if (sel res_decode.err) { ret scratch_gone(?st, data_raw(rd, reason(res_decode.err))); }
    var t:         Vector[Export]        = res_decode.ok;
    val res_style: res[opt[Style], Fail] = trie.matching_style(x.m.a, ?st, ?t, Bytes{data: rd.data, len: rd.len}, ptr);
    if (sel res_style.err)     { ret scratch_gone(?st, lost[Export](?t, res_style.err)); }
    if (sel res_style.ok.none) { ret scratch_gone(?st, dropped[Export](?t, irreproducible(rd))); }
    val err_adopted: err[Fail] = adopt_names(x, ?st, ?t);
    if (sel err_adopted.err) { ret scratch_gone(?st, lost[Export](?t, err_adopted.err)); }
    ret scratch_gone(?st, res[Data, Fail].ok{Data.exports{Trie{style: res_style.ok.some, exports: t}}});
}

# `then`, once the scratch store is given back
fun scratch_gone(st: *Store, then: res[Data, Fail]) res[Data, Fail] {
    val err_release: err[Fail] = store.dnit(st);
    if (sel err_release.err) { ret res[Data, Fail].err{err_release.err}; }
    ret then;
}

# the names of the exports, moved from the store they were decoded into to the model
fun adopt_names(x: *Ctx, from: *Store, exports: *Vector[Export]) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Export](exports)) {
        val e: *Export = ?exports.data[i];
        i = i + 1;
        val name:    Bytes           = store.bytes(from, ?e.name);
        val res_own: res[Held, Fail] = model.own(x.m, name.data, name.len);
        if (sel res_own.err) { ret err[Fail].err{res_own.err}; }
        val imp:          Bytes           = store.bytes(from, ?e.import);
        val res_own_data: res[Held, Fail] = model.own(x.m, imp.data, imp.len);
        if (sel res_own_data.err) { ret err[Fail].err{res_own_data.err}; }
        e.name   = res_own.ok;
        e.import = res_own_data.ok;
    }
    ret err[Fail].ok{};
}

# the function starts when they encode back to their bytes, the bytes raw
# otherwise
fun function_starts(x: *Ctx, rd: *Reader) res[Data, Fail] {
    val ptr:               usize                  = x.c.addr;
    val res_decode_starts: res[Vector[u64], Fail] = starts.decode_starts(x.m.a, rd);
    if (sel res_decode_starts.err) { ret data_raw(rd, reason(res_decode_starts.err)); }
    var t:                 Vector[u64] = res_decode_starts.ok;
    var s:                 Sink        = sink.init(x.m.a, x.order);
    val err_encode_starts: err[Fail]   = starts.encode_starts(?s, ?t, ptr);
    ret table_or_raw[u64](rd, ?t, verdict(rd, ?s, err_encode_starts, rd.len), Data.starts{t});
}

# the data in code entries when they encode back to their bytes, the bytes
# raw otherwise
fun data_in_code(x: *Ctx, rd: *Reader) res[Data, Fail] {
    val res_decode_data_in_code: res[Vector[DataInCode], Fail] = starts.decode_data_in_code(x.m.a, rd);
    if (sel res_decode_data_in_code.err) { ret data_raw(rd, reason(res_decode_data_in_code.err)); }
    var t:                       Vector[DataInCode] = res_decode_data_in_code.ok;
    var s:                       Sink               = sink.init(x.m.a, x.order);
    val err_encode_data_in_code: err[Fail]          = starts.encode_data_in_code(?s, ?t);
    ret table_or_raw[DataInCode](rd, ?t, verdict(rd, ?s, err_encode_data_in_code, rd.len), Data.data_in_code{t});
}

# the chained fixups when they encode back to their bytes, the bytes raw
# otherwise
fun chained(x: *Ctx, rd: *Reader) res[Data, Fail] {
    val res_decode: res[Chained, Fail] = fixups.decode(x.m.a, rd);
    if (sel res_decode.err) { ret data_raw(rd, reason(res_decode.err)); }
    var c:          Chained         = res_decode.ok;
    var s:          Sink            = sink.init(x.m.a, x.order);
    val err_encode: err[Fail]       = fixups.encode(?s, x.m.a, ?c, model.bytes(x.m, ?c.symbols));
    val res_same:   res[bool, Fail] = verdict(rd, ?s, err_encode, rd.len);
    if (sel res_same.err) {
        val err_release_chained: err[Fail] = model.chained_dnit(?c);
        ret res[Data, Fail].err{res_same.err};
    }
    if (!res_same.ok) {
        val err_release_chained: err[Fail] = model.chained_dnit(?c);
        if (sel err_release_chained.err) { ret res[Data, Fail].err{err_release_chained.err}; }
        ret irreproducible(rd);
    }
    ret res[Data, Fail].ok{Data.fixups{c}};
}

# the signature when encoding it gives its bytes back. its length may be
# short of the blob, the rest being a gap of the blob
fun code_signature(x: *Ctx, rd: *Reader) res[Data, Fail] {
    val res_decode: res[Signature, Fail] = signature.decode(x.m.a, rd);
    if (sel res_decode.err) { ret data_raw(rd, reason(res_decode.err)); }
    var sig:        Signature       = res_decode.ok;
    var s:          Sink            = sink.init(x.m.a, x.order);
    val err_encode: err[Fail]       = signature.encode(?s, x.m.a, ?x.m.store, ?sig);
    val res_same:   res[bool, Fail] = verdict(rd, ?s, err_encode, sig.length::usize);
    if (sel res_same.err) {
        val err_release_signature: err[Fail] = model.signature_dnit(?sig);
        ret res[Data, Fail].err{res_same.err};
    }
    if (!res_same.ok) {
        val err_release_signature: err[Fail] = model.signature_dnit(?sig);
        if (sel err_release_signature.err) { ret res[Data, Fail].err{err_release_signature.err}; }
        ret irreproducible(rd);
    }
    ret res[Data, Fail].ok{Data.signature{sig}};
}

# the bytes of the blob past the end of its signature
fun signature_tail(b: *Blob, rd: *Reader, used: u64) err[Fail] {
    if (used >= rd.len::u64) { ret err[Fail].ok{}; }
    val res_held: res[Held, Fail] = held(rd, used, rd.len::u64 - used);
    if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
    val err_gaps_pushed: err[Fail] = vectors.push[Gap](?b.gaps, Gap{at: used, bytes: res_held.ok});
    if (sel err_gaps_pushed.err) { ret err[Fail].err{err_gaps_pushed.err}; }
    ret err[Fail].ok{};
}

# the symbols as the bytes they are, for a table whose strings or sections
# do not resolve
fun raw_symbols(rd: *Reader, t: *Table[Nlist]) res[Data, Fail] {
    val err_release: err[Fail] = table.dnit[Nlist](t);
    if (sel err_release.err) { ret res[Data, Fail].err{err_release.err}; }
    ret data_raw(rd, res[Why, Fail].ok{Why.unsupported{}});
}

# release `t` and return the refusal `f`
fun lost[T](t: *Vector[T], f: Fail) res[Data, Fail] {
    val err_release: err[Fail] = vectors.dnit[T](t);
    ret res[Data, Fail].err{f};
}

# the symbol table of the symtab command `c`, held raw when a name lies past
# the string table's last NUL or a section symbol names no section
fun symbols(x: *Ctx, rd: *Reader, c: *Command) res[Data, Fail] {
    if (!sel c.body.symtab) { ret res[Data, Fail].err{fail.internal("symbols of a command that is no symbol table")}; }
    val cls:     *Class         = x.c;
    val o:       Order          = x.order;
    val res_nul: res[u64, Fail] = after_last_nul(x, ?c.body.symtab);
    if (sel res_nul.err) { ret res[Data, Fail].err{res_nul.err}; }
    val n:       u64              = rd.len::u64 / cls.symbol.size::u64;
    var tab:     Table[Nlist]     = table.init[Nlist](x.m.a);
    val res_cnt: res[usize, Fail] = checked.to_usize(reader.here(rd), n);
    if (sel res_cnt.err) { ret res[Data, Fail].err{res_cnt.err}; }
    val res_grow: res[Id[Nlist], Fail] = table.grow[Nlist](?tab, res_cnt.ok);
    if (sel res_grow.err) { ret lost[Nlist](?tab.vec, res_grow.err); }
    val items: *Nlist = table.items[Nlist](?tab);
    var k:     u64    = 0;
    for (k < n) {
        val res_rec: res[*u8, Fail] = record(rd, "symbol", k, cls.symbol.size);
        if (sel res_rec.err) { ret lost[Nlist](?tab.vec, res_rec.err); }
        val p: *u8    = res_rec.ok;
        val e: *Nlist = ?items[k::usize];
        e.strx  = slot.field(p, cls.symbol.strx, o)::u32;
        e.type  = slot.field(p, cls.symbol.type, o)::u8;
        e.sect  = slot.field(p, cls.symbol.sect, o)::u8;
        e.desc  = slot.field(p, cls.symbol.desc, o)::u16;
        e.value = slot.field(p, cls.symbol.value, o);
        if (e.strx != 0 && e.strx::u64 >= res_nul.ok) {
            ret raw_symbols(rd, ?tab);
        }
        if (model.stab(e) == 0 && model.symbol_type(e) == tables.N_SECT.value::u8 && (e.sect == tables.NO_SECT.value::u8 || e.sect::u64 > x.nsects)) {
            ret raw_symbols(rd, ?tab);
        }
        k = k + 1;
    }
    ret res[Data, Fail].ok{Data.symbols{tab}};
}

# the position after the last NUL byte of the string table `st` names, zero
# when it has none
fun after_last_nul(x: *Ctx, st: *Symtab) res[u64, Fail] {
    val res_sub: res[Reader, Fail] = reader.sub(?x.file, st.stroff::u64, st.strsize::u64);
    if (sel res_sub.err) { ret res[u64, Fail].err{fail.in_record(res_sub.err, "string table")}; }
    var sr:        Reader         = res_sub.ok;
    val res_bytes: res[*u8, Fail] = reader.bytes(?sr, st.strsize::u64);
    if (sel res_bytes.err) { ret res[u64, Fail].err{res_bytes.err}; }
    var k: u64 = st.strsize::u64;
    for (k > 0) {
        if (res_bytes.ok[(k - 1)::usize] == 0) { brk; }
        k = k - 1;
    }
    ret res[u64, Fail].ok{k};
}

# the `n` table of contents entries of `rd`
fun tocs(x: *Ctx, rd: *Reader, n: u64) res[Data, Fail] {
    var tab:     Vector[Toc]      = vector.init[Toc](x.m.a);
    val res_cnt: res[usize, Fail] = checked.to_usize(reader.here(rd), n);
    if (sel res_cnt.err) { ret res[Data, Fail].err{res_cnt.err}; }
    val err_grow: err[Fail] = vectors.grow[Toc](?tab, res_cnt.ok);
    if (sel err_grow.err) { ret lost[Toc](?tab, err_grow.err); }
    val items: *Toc = tab.data;
    var k:     u64  = 0;
    for (k < n) {
        val res_u32: res[u32, Fail] = reader.u32(rd);
        if (sel res_u32.err) { ret lost[Toc](?tab, fail.in_indexed(res_u32.err, "table of contents entry", k)); }
        val res_module_index: res[u32, Fail] = reader.u32(rd);
        if (sel res_module_index.err) { ret lost[Toc](?tab, fail.in_indexed(res_module_index.err, "table of contents entry", k)); }
        items[k::usize] = Toc{symbol_index: res_u32.ok, module_index: res_module_index.ok};
        k               = k + 1;
    }
    ret res[Data, Fail].ok{Data.toc{tab}};
}

# the `n` module table entries of `rd`
fun modules(x: *Ctx, rd: *Reader, n: u64) res[Data, Fail] {
    val c:       *Class           = x.c;
    val o:       Order            = x.order;
    var tab:     Vector[Module]   = vector.init[Module](x.m.a);
    val res_cnt: res[usize, Fail] = checked.to_usize(reader.here(rd), n);
    if (sel res_cnt.err) { ret res[Data, Fail].err{res_cnt.err}; }
    val err_grow: err[Fail] = vectors.grow[Module](?tab, res_cnt.ok);
    if (sel err_grow.err) { ret lost[Module](?tab, err_grow.err); }
    val items: *Module = tab.data;
    var k:     u64     = 0;
    for (k < n) {
        val res_rec: res[*u8, Fail] = record(rd, "module", k, c.module.size);
        if (sel res_rec.err) { ret lost[Module](?tab, res_rec.err); }
        val p: *u8     = res_rec.ok;
        val e: *Module = ?items[k::usize];
        e.module_name = slot.field(p, c.module.module_name, o)::u32;
        e.iextdefsym  = slot.field(p, c.module.iextdefsym, o)::u32;
        e.nextdefsym  = slot.field(p, c.module.nextdefsym, o)::u32;
        e.irefsym     = slot.field(p, c.module.irefsym, o)::u32;
        e.nrefsym     = slot.field(p, c.module.nrefsym, o)::u32;
        e.ilocalsym   = slot.field(p, c.module.ilocalsym, o)::u32;
        e.nlocalsym   = slot.field(p, c.module.nlocalsym, o)::u32;
        e.iextrel     = slot.field(p, c.module.iextrel, o)::u32;
        e.nextrel     = slot.field(p, c.module.nextrel, o)::u32;
        e.iinit_iterm = slot.field(p, c.module.iinit_iterm, o)::u32;
        e.ninit_nterm = slot.field(p, c.module.ninit_nterm, o)::u32;
        e.objc_addr   = slot.field(p, c.module.objc_addr, o);
        e.objc_size   = slot.field(p, c.module.objc_size, o)::u32;
        k             = k + 1;
    }
    ret res[Data, Fail].ok{Data.modules{tab}};
}

# the `n` words of `rd`, a failure named by the entry `name`
fun words(x: *Ctx, rd: *Reader, n: u64, name: str) res[Vector[u32], Fail] {
    var tab:     Vector[u32]      = vector.init[u32](x.m.a);
    val res_cnt: res[usize, Fail] = checked.to_usize(reader.here(rd), n);
    if (sel res_cnt.err) { ret res[Vector[u32], Fail].err{res_cnt.err}; }
    val err_grow: err[Fail] = vectors.grow[u32](?tab, res_cnt.ok);
    if (sel err_grow.err) { ret res[Vector[u32], Fail].err{err_grow.err}; }
    val items: *u32 = tab.data;
    var k:     u64  = 0;
    for (k < n) {
        val res_u32: res[u32, Fail] = reader.u32(rd);
        if (sel res_u32.err) {
            val err_release: err[Fail] = vectors.dnit[u32](?tab);
            ret res[Vector[u32], Fail].err{fail.in_indexed(res_u32.err, name, k)};
        }
        items[k::usize] = res_u32.ok;
        k               = k + 1;
    }
    ret res[Vector[u32], Fail].ok{tab};
}

# `n` relocation entries, a scattered one told by the top bit of its first word
fun relocs(x: *Ctx, rd: *Reader, n: u64) res[Table[Reloc], Fail] {
    val packed:  *model.Packed    = model.packed(x.order);
    var tab:     Table[Reloc]     = table.init[Reloc](x.m.a);
    val res_cnt: res[usize, Fail] = checked.to_usize(reader.here(rd), n);
    if (sel res_cnt.err) { ret res[Table[Reloc], Fail].err{res_cnt.err}; }
    val res_grow: res[Id[Reloc], Fail] = table.grow[Reloc](?tab, res_cnt.ok);
    if (sel res_grow.err) { ret res[Table[Reloc], Fail].err{res_grow.err}; }
    val items: *Reloc = table.items[Reloc](?tab);
    var k:     u64    = 0;
    for (k < n) {
        val res_address_word_read: res[u32, Fail] = reader.u32(rd);
        if (sel res_address_word_read.err) {
            val err_release: err[Fail] = table.dnit[Reloc](?tab);
            ret res[Table[Reloc], Fail].err{fail.in_indexed(res_address_word_read.err, "relocation", k)};
        }
        val res_info_word_read: res[u32, Fail] = reader.u32(rd);
        if (sel res_info_word_read.err) {
            val err_release: err[Fail] = table.dnit[Reloc](?tab);
            ret res[Table[Reloc], Fail].err{fail.in_indexed(res_info_word_read.err, "relocation", k)};
        }
        val a: u64 = res_address_word_read.ok::u64;
        val b: u64 = res_info_word_read.ok::u64;
        if ((res_address_word_read.ok & tables.R_SCATTERED.value::u32) != 0) {
            items[k::usize] = Reloc.scattered{Scattered{
                address: model.bits(a, model.SCATTER_ADDRESS)::u32,
                type:    model.bits(a, model.SCATTER_TYPE)::u8,
                length:  model.bits(a, model.SCATTER_LENGTH)::u8,
                pcrel:   model.bits(a, model.SCATTER_PCREL)::u8,
                value:   res_info_word_read.ok,
            }};
        }
        or {
            items[k::usize] = Reloc.plain{Plain{
                address:   res_address_word_read.ok,
                symbolnum: model.bits(b, packed.symbolnum)::u32,
                pcrel:     model.bits(b, packed.pcrel)::u8,
                length:    model.bits(b, packed.length)::u8,
                external:  model.bits(b, packed.external)::u8,
                type:      model.bits(b, packed.type)::u8,
            }};
        }
        k = k + 1;
    }
    ret res[Table[Reloc], Fail].ok{tab};
}

# the `size` bytes at `pos` of `rd`
fun view(rd: *Reader, pos: u64, size: u64) res[*u8, Fail] {
    val res_sub: res[Reader, Fail] = reader.sub(rd, pos, size);
    if (sel res_sub.err) { ret res[*u8, Fail].err{res_sub.err}; }
    var sr: Reader = res_sub.ok;
    ret reader.bytes(?sr, size);
}

# the `size` bytes at `pos` of `rd`, borrowed from the input
fun held(rd: *Reader, pos: u64, size: u64) res[Held, Fail] {
    val res_view: res[*u8, Fail] = view(rd, pos, size);
    if (sel res_view.err) { ret res[Held, Fail].err{res_view.err}; }
    ret res[Held, Fail].ok{Held.borrowed{Bytes{data: res_view.ok, len: size::usize}}};
}

# the `index`th record of `size` bytes of the table `t`
fun record(t: *Reader, name: str, index: u64, size: usize) res[*u8, Fail] {
    val res_element: res[Reader, Fail] = shell.element(t, name, index, size::u64);
    if (sel res_element.err) { ret res[*u8, Fail].err{res_element.err}; }
    var er:        Reader         = res_element.ok;
    val res_bytes: res[*u8, Fail] = reader.bytes(?er, size::u64);
    if (sel res_bytes.err) { ret res[*u8, Fail].err{fail.in_indexed(res_bytes.err, name, index)}; }
    ret res_bytes;
}

# the location of `offset` in the file being read
fun loc(x: *Ctx, offset: u64) Location {
    ret Location{file: x.in.file, offset: offset, placed: true};
}

# `f` placed at `offset`
fun at(f: Fail, offset: u64) Fail {
    ret fail.at_offset(f, offset);
}

# a range of a fat file
rec Cut {
    start: u64;
    end:   u64;
    slice: u32;
}

# read the fat header, the architecture table and the slices, and tile the
# file with extents
fun fill_fat(in: *Input, m: *Fat) err[Fail] {
    var file:     Reader         = shell.reader_make(in, BIG);
    val res_view: res[*u8, Fail] = view(?file, 0, universal_model.HEADER.size::u64);
    if (sel res_view.err) { ret err[Fail].err{fail.in_record(res_view.err, "fat header")}; }
    m.magic     = slot.field(res_view.ok, universal_model.HEADER.magic, BIG)::u32;
    m.nfat_arch = slot.field(res_view.ok, universal_model.HEADER.nfat_arch, BIG)::u32;
    val a:         *universal_model.ArchShape = m.arch;
    val res_table: res[Reader, Fail]          = shell.table(?file, "fat architecture", universal_model.HEADER.size::u64, m.nfat_arch::u64, a.size::u64);
    if (sel res_table.err) { ret err[Fail].err{res_table.err}; }
    var tr:       Reader               = res_table.ok;
    val res_grow: res[Id[Slice], Fail] = table.grow[Slice](?m.slices, m.nfat_arch::usize);
    if (sel res_grow.err) { ret err[Fail].err{res_grow.err}; }
    var cuts:            Vector[Cut] = vector.init[Cut](m.a);
    val err_read_slices: err[Fail]   = read_slices(in, m, ?file, ?tr, ?cuts);
    if (sel err_read_slices.err) {
        val err_dropped: err[Fail] = vectors.dnit[Cut](?cuts);
        ret err_read_slices;
    }
    val err_emit_fat: err[Fail] = emit_fat(in, m, ?file, ?cuts, universal_model.HEADER.size::u64 + tr.len::u64);
    val err_rel:      err[Fail] = vectors.dnit[Cut](?cuts);
    if (sel err_emit_fat.err) { ret err_emit_fat; }
    ret err_rel;
}

# read each architecture of the table `tr` into its slice, its bytes borrowed
# from the file, and note the range each covers in `cuts`
fun read_slices(in: *Input, m: *Fat, file: *Reader, tr: *Reader, cuts: *Vector[Cut]) err[Fail] {
    val a:     *universal_model.ArchShape = m.arch;
    val items: *Slice                     = table.items[Slice](?m.slices);
    var i:     u64                        = 0;
    for (i < m.nfat_arch::u64) {
        val res_rec: res[*u8, Fail] = record(tr, "fat architecture", i, a.size);
        if (sel res_rec.err) { ret err[Fail].err{res_rec.err}; }
        val p:    *u8    = res_rec.ok;
        val s:    *Slice = ?items[i::usize];
        val base: u64    = tr.base + i * a.size::u64;
        s.cputype    = slot.field(p, a.cputype, BIG)::u32;
        s.cpusubtype = slot.field(p, a.cpusubtype, BIG)::u32;
        s.offset     = slot.field(p, a.offset, BIG);
        s.length     = slot.field(p, a.length, BIG);
        s.align      = slot.field(p, a.align, BIG)::u32;
        s.reserved   = slot.field(p, a.reserved, BIG)::u32;
        val at_off:  u64            = base + a.offset.offset::u64;
        val res_end: res[u64, Fail] = checked.add(Location{file: in.file, offset: at_off, placed: true}, s.offset, s.length);
        if (sel res_end.err) { ret err[Fail].err{fail.in_indexed(res_end.err, "fat architecture", i)}; }
        if (res_end.ok > in.len::u64) {
            ret err[Fail].err{at(fail.in_indexed(fail.truncated("slice runs past the end of the file"), "fat architecture", i), at_off)};
        }
        val res_held: res[Held, Fail] = held(file, s.offset, s.length);
        if (sel res_held.err) { ret err[Fail].err{fail.in_indexed(res_held.err, "fat architecture", i)}; }
        s.bytes = res_held.ok;
        val err_pushed: err[Fail] = vectors.push[Cut](cuts, Cut{start: s.offset, end: res_end.ok, slice: i::u32});
        if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun cut_order(a: *Cut, b: *Cut) i64 {
    if (a.start != b.start) {
        if (a.start < b.start) { ret -1; }
        ret 1;
    }
    if (a.end != b.end) {
        if (a.end < b.end) { ret -1; }
        ret 1;
    }
    ret a.slice::i64 - b.slice::i64;
}

# tile the file with the header, the architecture table, the slices in file
# order and the bytes between them
fun emit_fat(in: *Input, m: *Fat, file: *Reader, cuts: *Vector[Cut], head: u64) err[Fail] {
    sort.sort_by[Cut](cuts.data, vector.length[Cut](cuts), cut_order);
    val err_push_fat: err[Fail] = push_fat(m, universal_model.Extent.header{});
    if (sel err_push_fat.err) { ret err_push_fat; }
    val err_push_fat_arches: err[Fail] = push_fat(m, universal_model.Extent.arches{});
    if (sel err_push_fat_arches.err) { ret err_push_fat_arches; }
    var cursor: u64   = head;
    var k:      usize = 0;
    for (k < vector.length[Cut](cuts)) {
        val c: Cut = cuts.data[k];
        if (c.start < cursor) {
            ret err[Fail].err{at(fail.in_indexed(fail.malformed("slice overlaps the bytes before it"), "fat architecture", c.slice::u64), c.start)};
        }
        if (c.start > cursor) {
            val res_held: res[Held, Fail] = held(file, cursor, c.start - cursor);
            if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
            val err_push_fat: err[Fail] = push_fat(m, universal_model.Extent.raw{res_held.ok});
            if (sel err_push_fat.err) { ret err_push_fat; }
        }
        val err_push_fat: err[Fail] = push_fat(m, universal_model.Extent.slice{table.nth[Slice](c.slice::usize)});
        if (sel err_push_fat.err) { ret err_push_fat; }
        cursor = c.end;
        k      = k + 1;
    }
    if (cursor < in.len::u64) {
        val res_held: res[Held, Fail] = held(file, cursor, in.len::u64 - cursor);
        if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
        ret push_fat(m, universal_model.Extent.raw{res_held.ok});
    }
    ret err[Fail].ok{};
}

fun push_fat(m: *Fat, e: universal_model.Extent) err[Fail] {
    val err_extents_pushed: err[Fail] = vectors.push[universal_model.Extent](?m.extents, e);
    if (sel err_extents_pushed.err) { ret err[Fail].err{err_extents_pushed.err}; }
    ret err[Fail].ok{};
}
