# a range of the file after the load commands
# ---
# start: the first byte
# end:   the byte after the last
# kind:  what the range holds
# cmd:   the load command it belongs to
# sect:  the section of that command, for a section or its relocations
# part:  the field pair of that command, for a blob
rec Range {
    start: u64;
    end:   u64;
    kind:  u8;
    cmd:   u32;
    sect:  u32;
    part:  Part;
}

# read `in` as a thin Mach-O file. the model borrows the bytes of `in` and
# every table of it lives in `a`, so give it back with model.dnit
pub fun read(a: *A.Allocator, in: *Input) res[MachO, Fail] {
    val res_shape: res[Shape, Fail] = shape_of(in);
    if (sel res_shape.err) { ret res[MachO, Fail].err{fail.in_file(res_shape.err, in.file)}; }
    var m:        MachO     = model.init(a, res_shape.ok);
    var x:        Ctx       = Ctx{in: in, file: shell.reader_make(in, res_shape.ok.order), m: ?m, c: res_shape.ok.class, order: res_shape.ok.order, offsets: vector.init[u64](a)};
    val err_fill: err[Fail] = fill(?x);
    val err_offs: err[Fail] = vectors.dnit[u64](?x.offsets);
    if (sel err_fill.err) {
        val err_dropped: err[Fail] = model.dnit(?m);
        ret res[MachO, Fail].err{fail.in_file(err_fill.err, in.file)};
    }
    if (sel err_offs.err) {
        val err_dropped: err[Fail] = model.dnit(?m);
        ret res[MachO, Fail].err{fail.in_file(err_offs.err, in.file)};
    }
    ret res[MachO, Fail].ok{m};
}

# the filetype the header of `in`, a thin file, states
pub fun filetype(in: *Input) res[u32, Fail] {
    val res_shape: res[Shape, Fail] = shape_of(in);
    if (sel res_shape.err) { ret res[u32, Fail].err{fail.in_file(res_shape.err, in.file)}; }
    var r:       Reader            = shell.reader_make(in, res_shape.ok.order);
    val res_sub: res[Reader, Fail] = reader.sub(?r, 0, res_shape.ok.class.header.size::u64);
    if (sel res_sub.err) { ret res[u32, Fail].err{fail.in_record(res_sub.err, "file header")}; }
    var hr:        Reader         = res_sub.ok;
    val res_bytes: res[*u8, Fail] = reader.bytes(?hr, res_shape.ok.class.header.size::u64);
    if (sel res_bytes.err) { ret res[u32, Fail].err{fail.in_record(res_bytes.err, "file header")}; }
    ret res[u32, Fail].ok{slot.field(res_bytes.ok, res_shape.ok.class.header.filetype, res_shape.ok.order)::u32};
}

# read `in` as a fat Mach-O file. the model borrows the bytes of `in`. each
# slice is held as its bytes, and read_slice reads one as a thin file
pub fun read_fat(a: *A.Allocator, in: *Input) res[Fat, Fail] {
    var r:       Reader         = shell.reader_make(in, BIG);
    val res_u32: res[u32, Fail] = reader.u32(?r);
    if (sel res_u32.err) { ret res[Fat, Fail].err{fail.in_file(fail.in_record(res_u32.err, "fat header"), in.file)}; }
    var arch: *universal_model.ArchShape;
    if (res_u32.ok == tables.FAT_MAGIC.value)    { arch = ?universal_model.FAT32; }
    or (res_u32.ok == tables.FAT_MAGIC_64.value) { arch = ?universal_model.FAT64; }
    or {
        ret res[Fat, Fail].err{fail.in_file(fail.at_offset(fail.in_record(fail.malformed("not a fat Mach-O file"), "fat header"), 0), in.file)};
    }
    var m:            Fat       = universal_model.init(a, arch);
    val err_fill_fat: err[Fail] = fill_fat(in, ?m);
    if (sel err_fill_fat.err) {
        val err_dropped: err[Fail] = universal_model.dnit(?m);
        ret res[Fat, Fail].err{fail.in_file(err_fill_fat.err, in.file)};
    }
    ret res[Fat, Fail].ok{m};
}

# read the slice `id` of `f` as a thin file named `file`. the model borrows
# the bytes of the fat file, and a failure is placed at its offset in that
# file, the slice's offset plus the offset in the slice
pub fun read_slice(a: *A.Allocator, f: *Fat, id: Id[Slice], file: str) res[MachO, Fail] {
    val s:        *Slice           = universal_model.slice_at(f, id);
    val b:        Bytes            = universal_model.bytes(f, ?s.bytes);
    val in:       Input            = Input{file: file, data: b.data, len: b.len};
    val res_read: res[MachO, Fail] = read(a, ?in);
    if (sel res_read.err) { ret res[MachO, Fail].err{rebased(res_read.err, s.offset)}; }
    ret res_read;
}

# `f` placed `base` bytes further on, for a failure in a slice
pub fun rebased(f: Fail, base: u64) Fail {
    if (!f.at.placed) { ret f; }
    var out: Fail = f;
    out.at.offset = f.at.offset + base;
    ret out;
}

# the width and byte order the magic names
fun shape_of(in: *Input) res[Shape, Fail] {
    var r:       Reader         = shell.reader_make(in, LITTLE);
    val res_u32: res[u32, Fail] = reader.u32(?r);
    if (sel res_u32.err) { ret res[Shape, Fail].err{fail.in_record(res_u32.err, "file header")}; }
    var shape: Shape;
    if (res_u32.ok == tables.MH_MAGIC.value) {
        shape.class = ?model.CLASS32;
        shape.order = LITTLE;
    }
    or (res_u32.ok == tables.MH_CIGAM.value) {
        shape.class = ?model.CLASS32;
        shape.order = BIG;
    }
    or (res_u32.ok == tables.MH_MAGIC_64.value) {
        shape.class = ?model.CLASS64;
        shape.order = LITTLE;
    }
    or (res_u32.ok == tables.MH_CIGAM_64.value) {
        shape.class = ?model.CLASS64;
        shape.order = BIG;
    }
    or (res_u32.ok == tables.FAT_MAGIC.value || res_u32.ok == tables.FAT_CIGAM.value || res_u32.ok == tables.FAT_MAGIC_64.value || res_u32.ok == tables.FAT_CIGAM_64.value) {
        ret res[Shape, Fail].err{at(fail.in_record(fail.malformed("fat file where a thin Mach-O file is expected"), "file header"), 0)};
    }
    or {
        ret res[Shape, Fail].err{at(fail.in_record(fail.malformed("not a Mach-O file"), "file header"), 0)};
    }
    ret res[Shape, Fail].ok{shape};
}

# read the header, the load commands and the layout after them
fun fill(x: *Ctx) err[Fail] {
    val err_read_header: err[Fail] = read_header(x);
    if (sel err_read_header.err) { ret err_read_header; }
    val err_read_commands: err[Fail] = read_commands(x);
    if (sel err_read_commands.err) { ret err_read_commands; }
    ret layout(x);
}

# read the mach header's fields into the model
fun read_header(x: *Ctx) err[Fail] {
    val c:       *Class            = x.c;
    val res_sub: res[Reader, Fail] = reader.sub(?x.file, 0, c.header.size::u64);
    if (sel res_sub.err) { ret err[Fail].err{fail.in_record(res_sub.err, "file header")}; }
    var hr:        Reader         = res_sub.ok;
    val res_bytes: res[*u8, Fail] = reader.bytes(?hr, c.header.size::u64);
    if (sel res_bytes.err) { ret err[Fail].err{fail.in_record(res_bytes.err, "file header")}; }
    val p: *u8           = res_bytes.ok;
    val o: Order         = x.order;
    val h: *model.Header = ?x.m.header;
    h.magic      = slot.field(p, c.header.magic, o)::u32;
    h.cputype    = slot.field(p, c.header.cputype, o)::u32;
    h.cpusubtype = slot.field(p, c.header.cpusubtype, o)::u32;
    h.filetype   = slot.field(p, c.header.filetype, o)::u32;
    h.ncmds      = slot.field(p, c.header.ncmds, o)::u32;
    h.sizeofcmds = slot.field(p, c.header.sizeofcmds, o)::u32;
    h.flags      = slot.field(p, c.header.flags, o)::u32;
    h.reserved   = slot.field(p, c.header.reserved, o)::u32;
    ret err[Fail].ok{};
}

# read exactly ncmds load commands inside sizeofcmds, refused when the count
# cannot fit, and note where the commands end
fun read_commands(x: *Ctx) err[Fail] {
    val c:         *Class            = x.c;
    val h:         *model.Header     = ?x.m.header;
    val hsize:     u64               = c.header.size::u64;
    val res_table: res[Reader, Fail] = shell.table(?x.file, "load commands", hsize, 1, h.sizeofcmds::u64);
    if (sel res_table.err) { ret err[Fail].err{res_table.err}; }
    val res_room: res[u64, Fail] = checked.mul(loc(x, c.header.ncmds.offset::u64), h.ncmds::u64, COMMAND_HEAD::u64);
    if (sel res_room.err) { ret err[Fail].err{res_room.err}; }
    if (res_room.ok > h.sizeofcmds::u64) {
        ret err[Fail].err{at(fail.in_record(fail.malformed("load command count exceeds the room for load commands"), "file header"), c.header.ncmds.offset::u64)};
    }
    var lr:  Reader = res_table.ok;
    var pos: u64    = 0;
    var i:   u64    = 0;
    for (i < h.ncmds::u64) {
        val res_one: res[u64, Fail] = read_command(x, ?lr, pos);
        if (sel res_one.err) { ret err[Fail].err{fail.in_indexed(res_one.err, "load command", i)}; }
        pos = pos + res_one.ok;
        i   = i + 1;
    }
    x.end = hsize + pos;
    ret err[Fail].ok{};
}

# the load command at `pos` of the commands `lr`, returning its size
fun read_command(x: *Ctx, lr: *Reader, pos: u64) res[u64, Fail] {
    val off:  u64 = lr.base + pos;
    val left: u64 = lr.len::u64 - pos;
    if (left < COMMAND_HEAD::u64) {
        ret res[u64, Fail].err{at(fail.malformed("load command runs past sizeofcmds"), off)};
    }
    val res_head: res[Reader, Fail] = reader.sub(lr, pos, COMMAND_HEAD::u64);
    if (sel res_head.err) { ret res[u64, Fail].err{res_head.err}; }
    var hr:      Reader         = res_head.ok;
    val res_cmd: res[u32, Fail] = reader.u32(?hr);
    if (sel res_cmd.err) { ret res[u64, Fail].err{res_cmd.err}; }
    val res_size: res[u32, Fail] = reader.u32(?hr);
    if (sel res_size.err) { ret res[u64, Fail].err{res_size.err}; }
    val size_at: u64 = off + WORD_SIZE;
    if (res_size.ok::usize < COMMAND_HEAD) {
        ret res[u64, Fail].err{at(fail.malformed("command size is smaller than a load command header"), size_at)};
    }
    if (res_size.ok::u64 > left) {
        ret res[u64, Fail].err{at(fail.malformed("load command runs past sizeofcmds"), size_at)};
    }
    val res_body: res[Reader, Fail] = reader.sub(lr, pos, res_size.ok::u64);
    if (sel res_body.err) { ret res[u64, Fail].err{res_body.err}; }
    val res_commands_pushed: res[Id[Command], Fail] = table.push[Command](?x.m.commands, Command{cmd: res_cmd.ok, cmdsize: res_size.ok, body: Load.raw{}});
    if (sel res_commands_pushed.err) { ret res[u64, Fail].err{res_commands_pushed.err}; }
    val err_recorded: err[Fail] = vectors.push[u64](?x.offsets, off);
    if (sel err_recorded.err) { ret res[u64, Fail].err{err_recorded.err}; }
    var k: Cursor = Cursor{r: res_body.ok};
    k.r.pos = COMMAND_HEAD;
    var res_load: res[Load, Fail] = res[Load, Fail].ok{Load.raw{}};
    var i:        usize           = 0;
    for (i < ROW_COUNT && res_size.ok::u64 % x.c.addr::u64 == 0) {
        if (ROWS[i].code.value == res_cmd.ok::u64) {
            res_load = ROWS[i].parse(x, ?k, res_cmd.ok);
            brk;
        }
        i = i + 1;
    }
    val c: *Command = model.command_at(x.m, res_commands_pushed.ok);
    if (sel res_load.err) {
        if (!sel res_load.err.cause.unsupported) { ret res[u64, Fail].err{at(res_load.err, off)}; }
        k.r.pos = COMMAND_HEAD;
    }
    or (sel res_load.ok) { c.body = res_load.ok; }
    val segment_cmd: bool = res_cmd.ok::u64 == tables.LC_SEGMENT.value || res_cmd.ok::u64 == tables.LC_SEGMENT_64.value;
    if (segment_cmd && sel c.body.raw) { x.cut = true; }
    c.rest = Held.borrowed{Bytes{data: ?k.r.data[k.r.pos], len: k.r.len - k.r.pos}};
    ret res[u64, Fail].ok{res_size.ok::u64};
}

# `l`, or the cursor's first failure when a read failed
fun loaded(k: *Cursor, l: Load) res[Load, Fail] {
    if (k.failed) { ret res[Load, Fail].err{k.why}; }
    ret res[Load, Fail].ok{l};
}

# keep `f` as the cursor's first failure, a truncated read refused as a
# command too short for its fields
fun stuck(k: *Cursor, f: Fail) {
    if (k.failed) { ret; }
    k.failed = true;
    k.why    = f;
    if (sel f.cause.truncated) {
        k.why    = fail.unsupported(SHORT);
        k.why.at = f.at;
    }
}

# the next word of the command, zero once a read has failed
fun w32(k: *Cursor) u32 {
    if (k.failed) { ret 0; }
    val res_u32: res[u32, Fail] = reader.u32(?k.r);
    if (sel res_u32.err) {
        stuck(k, res_u32.err);
        ret 0;
    }
    ret res_u32.ok;
}

# the next 64-bit field of the command, zero once a read has failed
fun w64(k: *Cursor) u64 {
    if (k.failed) { ret 0; }
    val res_u64: res[u64, Fail] = reader.u64(?k.r);
    if (sel res_u64.err) {
        stuck(k, res_u64.err);
        ret 0;
    }
    ret res_u64.ok;
}

# an lc_str, whose offset must lie inside the command
fun wname(k: *Cursor) Name {
    val v: u32 = w32(k);
    if (!k.failed && v::usize >= k.r.len) {
        stuck(k, at(fail.unsupported("string offset lies outside its load command"), k.r.base + k.r.pos::u64 - WORD_SIZE));
    }
    ret Name{offset: v};
}

# the next `n` bytes of the command copied into `out`
fun wbytes(k: *Cursor, out: *u8, n: usize) {
    if (k.failed) { ret; }
    val res_bytes: res[*u8, Fail] = reader.bytes(?k.r, n::u64);
    if (sel res_bytes.err) {
        stuck(k, res_bytes.err);
        ret;
    }
    var i: usize = 0;
    for (i < n) {
        out[i] = res_bytes.ok[i];
        i      = i + 1;
    }
}

# the command's first `size` bytes, a record whose shape follows the width
fun fixed(k: *Cursor, size: usize) res[*u8, Fail] {
    if (size > k.r.len) { ret res[*u8, Fail].err{at(fail.unsupported(SHORT), k.r.base)}; }
    k.r.pos = size;
    ret res[*u8, Fail].ok{k.r.data};
}

# a segment command of the file's width and its section headers, each checked
# to lie inside the segment
fun parse_segment(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val c:    *Class = x.c;
    var want: u32    = tables.LC_SEGMENT.value::u32;
    if (c.addr == 8) { want = tables.LC_SEGMENT_64.value::u32; }
    if (cmd != want) { ret res[Load, Fail].err{fail.unsupported("segment command does not match the width of the file")}; }
    val res_fixed: res[*u8, Fail] = fixed(k, c.segment.size);
    if (sel res_fixed.err) { ret res[Load, Fail].err{res_fixed.err}; }
    val p:      *u8   = res_fixed.ok;
    val o:      Order = x.order;
    val cmd_at: u64   = k.r.base;
    var seg:    Segment;
    copy16(?seg.segname[0], p, c.segment.segname);
    seg.vmaddr   = slot.field(p, c.segment.vmaddr, o);
    seg.vmsize   = slot.field(p, c.segment.vmsize, o);
    seg.fileoff  = slot.field(p, c.segment.fileoff, o);
    seg.filesize = slot.field(p, c.segment.filesize, o);
    seg.maxprot  = slot.field(p, c.segment.maxprot, o)::u32;
    seg.initprot = slot.field(p, c.segment.initprot, o)::u32;
    seg.nsects   = slot.field(p, c.segment.nsects, o)::u32;
    seg.flags    = slot.field(p, c.segment.flags, o)::u32;
    val res_fend: res[u64, Fail] = checked.add(loc(x, cmd_at + c.segment.fileoff.offset::u64), seg.fileoff, seg.filesize);
    if (sel res_fend.err) { ret res[Load, Fail].err{res_fend.err}; }
    if (res_fend.ok > x.in.len::u64) {
        ret res[Load, Fail].err{at(fail.truncated("segment runs past the end of the file"), cmd_at + c.segment.fileoff.offset::u64)};
    }
    val res_vend: res[u64, Fail] = checked.add(loc(x, cmd_at + c.segment.vmaddr.offset::u64), seg.vmaddr, seg.vmsize);
    if (sel res_vend.err) { ret res[Load, Fail].err{res_vend.err}; }
    val res_room: res[u64, Fail] = checked.mul(loc(x, cmd_at + c.segment.nsects.offset::u64), seg.nsects::u64, c.section.size::u64);
    if (sel res_room.err) { ret res[Load, Fail].err{res_room.err}; }
    if (res_room.ok > reader.remaining(?k.r)::u64) {
        ret res[Load, Fail].err{at(fail.unsupported("section headers run past their load command"), cmd_at + c.segment.nsects.offset::u64)};
    }
    seg.sections = vector.init[Section](x.m.a);
    var i: u32 = 0;
    for (i < seg.nsects) {
        val at_sect:   u64            = k.r.base + k.r.pos::u64;
        val res_bytes: res[*u8, Fail] = reader.bytes(?k.r, c.section.size::u64);
        if (sel res_bytes.err) { ret lost_sections(?seg, fail.in_indexed(res_bytes.err, "section", i::u64)); }
        val s:                 Section   = read_section(x, res_bytes.ok);
        val err_check_section: err[Fail] = check_section(x, ?seg, res_vend.ok, ?s, at_sect);
        if (sel err_check_section.err) { ret lost_sections(?seg, fail.in_indexed(err_check_section.err, "section", i::u64)); }
        val err_pushed: err[Fail] = vectors.push[Section](?seg.sections, s);
        if (sel err_pushed.err) { ret lost_sections(?seg, err_pushed.err); }
        i = i + 1;
    }
    if (!x.cut) { x.nsects = x.nsects + seg.nsects::u64; }
    ret res[Load, Fail].ok{Load.segment{seg}};
}

# release the sections read so far and return the refusal `f`
fun lost_sections(seg: *Segment, f: Fail) res[Load, Fail] {
    val err_release: err[Fail] = vectors.dnit[Section](?seg.sections);
    ret res[Load, Fail].err{f};
}

# the section header whose bytes lie at `p`, its relocations and body empty
fun read_section(x: *Ctx, p: *u8) Section {
    val c: *Class = x.c;
    val o: Order  = x.order;
    var s: Section;
    copy16(?s.sectname[0], p, c.section.sectname);
    copy16(?s.segname[0], p, c.section.segname);
    s.addr      = slot.field(p, c.section.addr, o);
    s.length    = slot.field(p, c.section.length, o);
    s.offset    = slot.field(p, c.section.offset, o)::u32;
    s.align     = slot.field(p, c.section.align, o)::u32;
    s.reloff    = slot.field(p, c.section.reloff, o)::u32;
    s.nreloc    = slot.field(p, c.section.nreloc, o)::u32;
    s.flags     = slot.field(p, c.section.flags, o)::u32;
    s.reserved1 = slot.field(p, c.section.reserved1, o)::u32;
    s.reserved2 = slot.field(p, c.section.reserved2, o)::u32;
    s.reserved3 = slot.field(p, c.section.reserved3, o)::u32;
    s.relocs    = table.init[Reloc](x.m.a);
    s.body      = Body.empty{};
    ret s;
}

# copy the sixteen byte name at slot `s` of `p` into `out`
fun copy16(out: *u8, p: *u8, s: Slot) {
    var i: usize = 0;
    for (i < NAME_SIZE) {
        out[i] = p[s.offset::usize + i];
        i      = i + 1;
    }
}

# a section must lie inside its segment's address range and, unless it has no
# file bytes, inside its file range
fun check_section(x: *Ctx, seg: *Segment, vend: u64, s: *Section, header: u64) err[Fail] {
    val c:        *Class         = x.c;
    val res_aend: res[u64, Fail] = checked.add(loc(x, header + c.section.addr.offset::u64), s.addr, s.length);
    if (sel res_aend.err) { ret err[Fail].err{res_aend.err}; }
    if (s.addr < seg.vmaddr || res_aend.ok > vend) {
        ret err[Fail].err{at(fail.unsupported("section lies outside the address range of its segment"), header + c.section.addr.offset::u64)};
    }
    if (zerofill(s) || s.length == 0) { ret err[Fail].ok{}; }
    val at_off:   u64            = header + c.section.offset.offset::u64;
    val res_fend: res[u64, Fail] = checked.add(loc(x, at_off), s.offset::u64, s.length);
    if (sel res_fend.err) { ret err[Fail].err{res_fend.err}; }
    val res_send: res[u64, Fail] = checked.add(loc(x, at_off), seg.fileoff, seg.filesize);
    if (sel res_send.err) { ret err[Fail].err{res_send.err}; }
    if (s.offset::u64 < seg.fileoff || res_fend.ok > res_send.ok) {
        ret err[Fail].err{at(fail.unsupported("section lies outside the file range of its segment"), at_off)};
    }
    ret err[Fail].ok{};
}

# whether `s` has no bytes in the file
fun zerofill(s: *Section) bool {
    val t: u32 = model.section_type(s);
    ret t == tables.S_ZEROFILL.value::u32 || t == tables.S_GB_ZEROFILL.value::u32 || t == tables.S_THREAD_LOCAL_ZEROFILL.value::u32;
}

fun parse_symtab(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var s: Symtab;
    s.symoff  = w32(k);
    s.nsyms   = w32(k);
    s.stroff  = w32(k);
    s.strsize = w32(k);
    ret loaded(k, Load.symtab{s});
}

fun parse_symseg(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var s: Symseg;
    s.offset = w32(k);
    s.size   = w32(k);
    ret loaded(k, Load.symseg{s});
}

fun parse_thread(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var states: Thread = Thread{states: vector.init[ThreadState](x.m.a)};
    for (reader.remaining(?k.r)::u64 >= STATE_HEAD) {
        val at_state: u64 = k.r.base + k.r.pos::u64;
        var st:       ThreadState;
        st.flavor = w32(k);
        st.count  = w32(k);
        val size: u64 = st.count::u64 * WORD_SIZE;
        if (k.failed || size > reader.remaining(?k.r)::u64) {
            val err_release: err[Fail] = vectors.dnit[ThreadState](?states.states);
            if (k.failed) { ret res[Load, Fail].err{k.why}; }
            ret res[Load, Fail].err{at(fail.unsupported("thread state runs past its load command"), at_state)};
        }
        val res_bytes: res[*u8, Fail] = reader.bytes(?k.r, size);
        if (sel res_bytes.err) {
            val err_release: err[Fail] = vectors.dnit[ThreadState](?states.states);
            ret res[Load, Fail].err{res_bytes.err};
        }
        st.state = Held.borrowed{Bytes{data: res_bytes.ok, len: size::usize}};
        val err_pushed: err[Fail] = vectors.push[ThreadState](?states.states, st);
        if (sel err_pushed.err) {
            val err_release: err[Fail] = vectors.dnit[ThreadState](?states.states);
            ret res[Load, Fail].err{err_pushed.err};
        }
    }
    ret res[Load, Fail].ok{Load.thread{states}};
}

fun parse_fvmlib(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var f: Fvmlib;
    f.name          = wname(k);
    f.minor_version = w32(k);
    f.header_addr   = w32(k);
    ret loaded(k, Load.fvmlib{f});
}

fun parse_ident(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    ret res[Load, Fail].ok{Load.ident{}};
}

fun parse_fvmfile(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var f: Fvmfile;
    f.name        = wname(k);
    f.header_addr = w32(k);
    ret loaded(k, Load.fvmfile{f});
}

fun parse_dysymtab(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var d: Dysymtab;
    d.ilocalsym      = w32(k);
    d.nlocalsym      = w32(k);
    d.iextdefsym     = w32(k);
    d.nextdefsym     = w32(k);
    d.iundefsym      = w32(k);
    d.nundefsym      = w32(k);
    d.tocoff         = w32(k);
    d.ntoc           = w32(k);
    d.modtaboff      = w32(k);
    d.nmodtab        = w32(k);
    d.extrefsymoff   = w32(k);
    d.nextrefsyms    = w32(k);
    d.indirectsymoff = w32(k);
    d.nindirectsyms  = w32(k);
    d.extreloff      = w32(k);
    d.nextrel        = w32(k);
    d.locreloff      = w32(k);
    d.nlocrel        = w32(k);
    ret loaded(k, Load.dysymtab{d});
}

fun parse_dylib(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val name:   Name = wname(k);
    val stamp:  u32  = w32(k);
    val cur:    u32  = w32(k);
    val compat: u32  = w32(k);
    if (stamp == tables.DYLIB_USE_MARKER.value::u32) {
        val flags: u32 = w32(k);
        ret loaded(k, Load.dylib_use{DylibUse{name: name, marker: stamp, current_version: cur, compat_version: compat, flags: flags}});
    }
    ret loaded(k, Load.dylib{Dylib{name: name, timestamp: stamp, current_version: cur, compatibility_version: compat}});
}

fun parse_dylinker(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val n: Name = wname(k);
    ret loaded(k, Load.dylinker{n});
}

fun parse_prebound(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var p: Prebound;
    p.name           = wname(k);
    p.nmodules       = w32(k);
    p.linked_modules = wname(k);
    ret loaded(k, Load.prebound{p});
}

fun parse_routines(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val c:    *Class = x.c;
    var want: u32    = tables.LC_ROUTINES.value::u32;
    if (c.addr == 8) { want = tables.LC_ROUTINES_64.value::u32; }
    if (cmd != want) { ret res[Load, Fail].err{fail.unsupported("routines command does not match the width of the file")}; }
    val res_fixed: res[*u8, Fail] = fixed(k, c.routines.size);
    if (sel res_fixed.err) { ret res[Load, Fail].err{res_fixed.err}; }
    var r: Routines;
    r.init_address = slot.field(res_fixed.ok, c.routines.init_address, x.order);
    r.init_module  = slot.field(res_fixed.ok, c.routines.init_module, x.order);
    var i: usize = 0;
    for (i < 6) {
        r.reserved[i] = slot.field(res_fixed.ok, Slot{offset: c.routines.reserved.offset + (i * c.addr)::u8, width: c.addr::u8}, x.order);
        i             = i + 1;
    }
    ret res[Load, Fail].ok{Load.routines{r}};
}

fun parse_sub(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val n: Name = wname(k);
    ret loaded(k, Load.sub{n});
}

