    d.rebase_off     = w32(k);
    d.rebase_size    = w32(k);
    d.bind_off       = w32(k);
    d.bind_size      = w32(k);
    d.weak_bind_off  = w32(k);
    d.weak_bind_size = w32(k);
    d.lazy_bind_off  = w32(k);
    d.lazy_bind_size = w32(k);
    d.export_off     = w32(k);
    d.export_size    = w32(k);
    ret loaded(k, Load.dyld_info{d});
}

fun parse_version_min(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var v: VersionMin;
    v.version = w32(k);
    v.sdk     = w32(k);
    ret loaded(k, Load.version_min{v});
}

fun parse_entry(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var e: Entry;
    e.entryoff  = w64(k);
    e.stacksize = w64(k);
    ret loaded(k, Load.entry{e});
}

fun parse_source_version(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val v: u64 = w64(k);
    ret loaded(k, Load.source_version{v});
}

fun parse_linker_option(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val n: u32 = w32(k);
    ret loaded(k, Load.linker_option{n});
}

fun parse_note(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var n: Note;
    wbytes(k, ?n.owner[0], 16);
    n.offset = w64(k);
    n.size   = w64(k);
    ret loaded(k, Load.note{n});
}

fun parse_build_version(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var b: BuildVersion;
    b.platform = w32(k);
    b.minos    = w32(k);
    b.sdk      = w32(k);
    b.ntools   = w32(k);
    if (k.failed) { ret res[Load, Fail].err{k.why}; }
    val room: u64 = b.ntools::u64 * TOOL_SIZE;
    if (room > reader.remaining(?k.r)::u64) {
        ret res[Load, Fail].err{at(fail.unsupported("tool versions run past their load command"), k.r.base + k.r.pos::u64)};
    }
    b.tools = vector.init[Tool](x.m.a);
    var i: u32 = 0;
    for (i < b.ntools) {
        var t: Tool;
        t.tool    = w32(k);
        t.version = w32(k);
        val err_pushed: err[Fail] = vectors.push[Tool](?b.tools, t);
        if (sel err_pushed.err) {
            val err_release: err[Fail] = vectors.dnit[Tool](?b.tools);
            ret res[Load, Fail].err{err_pushed.err};
        }
        i = i + 1;
    }
    ret res[Load, Fail].ok{Load.build_version{b}};
}

fun parse_fileset_entry(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var f: FilesetEntry;
    f.vmaddr   = w64(k);
    f.fileoff  = w64(k);
    f.entry_id = wname(k);
    f.reserved = w32(k);
    ret loaded(k, Load.fileset_entry{f});
}

