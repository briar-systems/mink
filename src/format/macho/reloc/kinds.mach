# the relocation kinds only the Mach-O pairs state
#
# the handles a producer names a Mach-O relocation by. the x86_64 and arm64
# rows that apply them are the pair modules', and the kinds every pair shares,
# the absolute, place-relative and difference forms of each width, are the
# neutral model's own. a call reaches its target through the format's stub,
# which the linker's plt role makes, and a GOT load through its got role.

use std.types.option.opt;

use mink.catalog.slot;
use mink.catalog.slot.SlotRole;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.model.reloc.Tls;

# a place-relative word whose instruction ends one, two or four bytes after
# the field, as X86_64_RELOC_SIGNED_1, _2 and _4 name it
pub val SIGNED_1: Kind = Kind{name: "signed_1", caps: reloc.PC, takes: ?reloc.NAMED};
pub val SIGNED_2: Kind = Kind{name: "signed_2", caps: reloc.PC, takes: ?reloc.NAMED};
pub val SIGNED_4: Kind = Kind{name: "signed_4", caps: reloc.PC, takes: ?reloc.NAMED};
# a call or jump displacement that may reach its target through a stub
pub val BRANCH32:      Kind = Kind{name: "branch32", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.PLT}};
pub val GOT_LOAD_PC32: Kind = Kind{name: "got_load_pc32", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val GOT_PC32:      Kind = Kind{name: "got_pc32", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val TLV_PC32:      Kind = Kind{name: "tlv_pc32", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.tlv{}};
# the subtracting record of a difference, which takes the field written by
# the adding record and subtracts its target
pub val SUBTRACTOR64: Kind = Kind{name: "subtractor64", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SUBTRACTOR32: Kind = Kind{name: "subtractor32", caps: reloc.ABS, takes: ?reloc.NAMED};

pub val BRANCH26:            Kind = Kind{name: "branch26", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.PLT}};
pub val PAGE21:              Kind = Kind{name: "page21", caps: reloc.PC | reloc.PAGE, takes: ?reloc.NAMED};
pub val PAGEOFF12:           Kind = Kind{name: "pageoff12", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val GOT_LOAD_PAGE21:     Kind = Kind{name: "got_load_page21", caps: reloc.PC | reloc.PAGE, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val GOT_LOAD_PAGEOFF12:  Kind = Kind{name: "got_load_pageoff12", caps: reloc.ABS, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val POINTER_TO_GOT_PC32: Kind = Kind{name: "pointer_to_got_pc32", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val POINTER_TO_GOT64:    Kind = Kind{name: "pointer_to_got64", caps: reloc.ABS, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val TLVP_LOAD_PAGE21:    Kind = Kind{name: "tlvp_load_page21", caps: reloc.PC | reloc.PAGE, takes: ?reloc.NAMED, tls: Tls.tlv{}};
pub val TLVP_LOAD_PAGEOFF12: Kind = Kind{name: "tlvp_load_pageoff12", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.tlv{}};
# the record that carries the addend of the record after it
pub val ADDEND: Kind = Kind{name: "addend", caps: reloc.MARKER, takes: ?reloc.NAMELESS};
# a pointer signed with a pointer authentication code, its key and diversity
# in the field beside the addend
pub val AUTH_POINTER64: Kind = Kind{name: "auth_pointer64", caps: reloc.ABS | reloc.AUTH, takes: ?reloc.NAMED};
