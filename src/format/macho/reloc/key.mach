# the key of a Mach-O relocation row
#
# a relocation_info entry states its type, the log2 of the bytes it patches
# and whether it is place-relative, and one type takes different meanings
# under different lengths and pcrel bits, as UNSIGNED patches a word or a
# quad and POINTER_TO_GOT holds an address or a distance. a row's key
# composes the three, so one key names one meaning, and a record is written
# back from its key. whether the record names a symbol or a section is not
# in the key, as both forms carry one meaning.

use std.types.bool.bool;

use mink.format.pair.Coded;

val TYPE_BITS:   u32 = 0xf;
val LENGTH_AT:   u32 = 4;
val LENGTH_BITS: u32 = 0x3;
val PCREL_AT:    u32 = 6;

# the key of a record of type `type`, length `length` and pcrel `pcrel`
pub fun make(type: u32, length: u32, pcrel: bool) u32 {
    var k: u32 = (type & TYPE_BITS) | ((length & LENGTH_BITS) << LENGTH_AT);
    if (pcrel) { k = k | (1 << PCREL_AT); }
    ret k;
}

# the key the record's fields `c` compose, for a pair
pub fun of(c: *Coded) u32 {
    ret make(c.code, c.length::u32, c.pcrel);
}

pub fun type_of(key: u32) u32 {
    ret key & TYPE_BITS;
}

pub fun length_of(key: u32) u32 {
    ret (key >> LENGTH_AT) & LENGTH_BITS;
}

pub fun pcrel_of(key: u32) bool {
    ret ((key >> PCREL_AT) & 1) != 0;
}
