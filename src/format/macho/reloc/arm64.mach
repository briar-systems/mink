# the Mach-O relocation table of the arm64 and arm64e pairs
#
# every relocation type mach-o/arm64/reloc.h defines has a row for each
# length and pcrel form it takes, keyed as key.mach composes them. a data
# field holds its addend, and an instruction field holds none: the addend of a
# BRANCH26, PAGE21 or PAGEOFF12 record is the ADDEND record before it, its
# partner, and the GOT and TLVP forms take none. a PAGEOFF12 field is the
# immediate of the instruction at its place, an add or a load or store of any
# width, told apart by the instruction's own bits. a difference is a
# SUBTRACTOR record then an UNSIGNED record at one place, the adding record
# applied first and the subtracting one taking its target from the field.
# arm64e adds the authenticated pointer, whose field holds the addend in its
# low word beside the key and diversity the loader signs with.

use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.testing;

use mink.base.fail.Fail;
use mink.catalog.arch.aarch64;
use mink.catalog.format;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;
use mink.format.macho.reloc.key;
use mink.format.macho.reloc.kinds;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.compute;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row;
use mink.reloc.row.Addend;
use mink.reloc.row.Difference;
use mink.reloc.row.FieldChoice;
use mink.reloc.row.Keys;
use mink.reloc.row.Row;
use mink.reloc.row.Set;

val P_DATA64:   [1]Piece = [1]Piece{Piece{at: 0, width: 64}};
val P_DATA32:   [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val P_ADRP:     [2]Piece = [2]Piece{Piece{at: 29, width: 2}, Piece{at: 5, width: 19}};
val P_BRANCH26: [1]Piece = [1]Piece{Piece{at: 0, width: 26}};
val P_IMM12:    [1]Piece = [1]Piece{Piece{at: 10, width: 12}};
val P_IMM11:    [1]Piece = [1]Piece{Piece{at: 10, width: 11}};
val P_IMM10:    [1]Piece = [1]Piece{Piece{at: 10, width: 10}};
val P_IMM9:     [1]Piece = [1]Piece{Piece{at: 10, width: 9}};
val P_IMM8:     [1]Piece = [1]Piece{Piece{at: 10, width: 8}};

val F_NONE:   Field = Field{bytes: 0};
val F_DATA64: Field = Field{bytes: 8, pieces: ?P_DATA64[0], count: 1};
val F_DATA32: Field = Field{bytes: 4, pieces: ?P_DATA32[0], count: 1};
# the signed addend of an authenticated pointer in the low word of its field
val F_AUTH64:   Field = Field{bytes: 8, pieces: ?P_DATA32[0], count: 1};
val F_ADRP:     Field = Field{bytes: 4, pieces: ?P_ADRP[0], count: 2, shift: 12, insn: true};
val F_BRANCH26: Field = Field{bytes: 4, pieces: ?P_BRANCH26[0], count: 1, shift: 2, insn: true};
val F_LO12_1:   Field = Field{bytes: 4, pieces: ?P_IMM12[0], count: 1, insn: true};
val F_LO12_2:   Field = Field{bytes: 4, pieces: ?P_IMM11[0], count: 1, shift: 1, insn: true};
val F_LO12_4:   Field = Field{bytes: 4, pieces: ?P_IMM10[0], count: 1, shift: 2, insn: true};
val F_LO12_8:   Field = Field{bytes: 4, pieces: ?P_IMM9[0], count: 1, shift: 3, insn: true};
val F_LO12_16:  Field = Field{bytes: 4, pieces: ?P_IMM8[0], count: 1, shift: 4, insn: true};

val C_NONE:     [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_NONE}};
val C_DATA64:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_DATA64}};
val C_DATA32:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_DATA32}};
val C_AUTH64:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_AUTH64}};
val C_ADRP:     [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_ADRP}};
val C_BRANCH26: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_BRANCH26}};

# the instruction forms a page offset lands in, each told by the bits that
# name its width: an add immediate, then loads and stores of one byte, a
# byte of a SIMD register, a signed byte, a quad word of a SIMD register,
# and of two, four and eight bytes, whose size bits scale the immediate
val ADD_MASK:  u64 = 0x7f80_0000;
val ADD_FORM:  u64 = 0x1100_0000;
val LDST_MASK: u64 = 0xfb00_0000;
val BYTE_MASK: u64 = 0xff80_0000;

val C_PAGEOFF: [8]FieldChoice = [8]FieldChoice{
    FieldChoice{insn_mask: ADD_MASK, insn_value: ADD_FORM, field: ?F_LO12_1},
    FieldChoice{insn_mask: BYTE_MASK, insn_value: 0x3900_0000, field: ?F_LO12_1},
    FieldChoice{insn_mask: BYTE_MASK, insn_value: 0x3d00_0000, field: ?F_LO12_1},
    FieldChoice{insn_mask: BYTE_MASK, insn_value: 0x3980_0000, field: ?F_LO12_1},
    FieldChoice{insn_mask: BYTE_MASK, insn_value: 0x3d80_0000, field: ?F_LO12_16},
    FieldChoice{insn_mask: LDST_MASK, insn_value: 0x7900_0000, field: ?F_LO12_2},
    FieldChoice{insn_mask: LDST_MASK, insn_value: 0xb900_0000, field: ?F_LO12_4},
    FieldChoice{insn_mask: LDST_MASK, insn_value: 0xf900_0000, field: ?F_LO12_8},
};

# a GOT or TLV descriptor address is loaded as a quad, or added for its address
val C_LOAD64: [2]FieldChoice = [2]FieldChoice{
    FieldChoice{insn_mask: ADD_MASK, insn_value: ADD_FORM, field: ?F_LO12_1},
    FieldChoice{insn_mask: LDST_MASK, insn_value: 0xf900_0000, field: ?F_LO12_8},
};

val WRAP:   Range = Range{check: field.Check.wrap{}, bits: 0, align: 1};
val E32:    Range = Range{check: field.Check.either{}, bits: 32, align: 1};
val S32:    Range = Range{check: field.Check.signed{}, bits: 32, align: 1};
val PAGE:   Range = Range{check: field.Check.signed{}, bits: 33, align: 0x1000};
val BRANCH: Range = Range{check: field.Check.signed{}, bits: 28, align: 4};
val LOW12:  Range = Range{check: field.Check.wrap{}, bits: 12, align: 1};

# the keys, as key.mach composes them from the type, the length and the pcrel
# bit, which the walk below holds every row to
pub val UNSIGNED64:          u32 = 0x30;
pub val UNSIGNED32:          u32 = 0x20;
pub val SUBTRACTOR64:        u32 = 0x31;
pub val SUBTRACTOR32:        u32 = 0x21;
pub val ADDEND:              u32 = 0x2a;
pub val POINTER_TO_GOT_PC32: u32 = 0x67;

val ADDEND_KEYS: [1]u32 = [1]u32{ADDEND};
val BY_ADDEND:   Addend = Addend.partner{Keys{keys: ?ADDEND_KEYS[0], count: 1}};

val ROW_COUNT: usize          = 15;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{key: UNSIGNED64, name: "ARM64_RELOC_UNSIGNED", kind: ?reloc.ABS64, fields: ?C_DATA64[0], field_count: 1, value: ?compute.ABS, range: WRAP, addend: Addend.field{}},
    Row{key: UNSIGNED32, name: "ARM64_RELOC_UNSIGNED", kind: ?reloc.ABS32, fields: ?C_DATA32[0], field_count: 1, value: ?compute.ABS, range: E32, addend: Addend.field{}},
    Row{key: SUBTRACTOR64, name: "ARM64_RELOC_SUBTRACTOR", kind: ?kinds.SUBTRACTOR64, fields: ?C_DATA64[0], field_count: 1, value: ?compute.SUB, range: WRAP, addend: Addend.none{}},
    Row{key: SUBTRACTOR32, name: "ARM64_RELOC_SUBTRACTOR", kind: ?kinds.SUBTRACTOR32, fields: ?C_DATA32[0], field_count: 1, value: ?compute.SUB, range: WRAP, addend: Addend.none{}},
    Row{key: 0x62, name: "ARM64_RELOC_BRANCH26", kind: ?kinds.BRANCH26, fields: ?C_BRANCH26[0], field_count: 1, value: ?compute.PLT, range: BRANCH, addend: BY_ADDEND},
    Row{key: 0x63, name: "ARM64_RELOC_PAGE21", kind: ?kinds.PAGE21, fields: ?C_ADRP[0], field_count: 1, value: ?compute.PAGE, range: PAGE, addend: BY_ADDEND},
    Row{key: 0x24, name: "ARM64_RELOC_PAGEOFF12", kind: ?kinds.PAGEOFF12, fields: ?C_PAGEOFF[0], field_count: 8, value: ?compute.ABS, range: LOW12, addend: BY_ADDEND},
    Row{key: 0x65, name: "ARM64_RELOC_GOT_LOAD_PAGE21", kind: ?kinds.GOT_LOAD_PAGE21, fields: ?C_ADRP[0], field_count: 1, value: ?compute.GOT_PAGE, range: PAGE, addend: Addend.none{}},
    Row{key: 0x26, name: "ARM64_RELOC_GOT_LOAD_PAGEOFF12", kind: ?kinds.GOT_LOAD_PAGEOFF12, fields: ?C_LOAD64[0], field_count: 2, value: ?compute.GOT, range: LOW12, addend: Addend.none{}},
    Row{key: POINTER_TO_GOT_PC32, name: "ARM64_RELOC_POINTER_TO_GOT", kind: ?kinds.POINTER_TO_GOT_PC32, fields: ?C_DATA32[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.field{}},
    Row{key: 0x37, name: "ARM64_RELOC_POINTER_TO_GOT", kind: ?kinds.POINTER_TO_GOT64, fields: ?C_DATA64[0], field_count: 1, value: ?compute.GOT, range: WRAP, addend: Addend.field{}},
    Row{key: 0x68, name: "ARM64_RELOC_TLVP_LOAD_PAGE21", kind: ?kinds.TLVP_LOAD_PAGE21, fields: ?C_ADRP[0], field_count: 1, value: ?compute.PAGE, range: PAGE, addend: Addend.none{}},
    Row{key: 0x29, name: "ARM64_RELOC_TLVP_LOAD_PAGEOFF12", kind: ?kinds.TLVP_LOAD_PAGEOFF12, fields: ?C_LOAD64[0], field_count: 2, value: ?compute.ABS, range: LOW12, addend: Addend.none{}},
    Row{key: ADDEND, name: "ARM64_RELOC_ADDEND", kind: ?kinds.ADDEND, fields: ?C_NONE[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.none{}},
    Row{key: 0x3b, name: "ARM64_RELOC_AUTHENTICATED_POINTER", kind: ?kinds.AUTH_POINTER64, fields: ?C_AUTH64[0], field_count: 1, value: ?compute.ABS, range: S32, addend: Addend.field{}},
};

val KIND_COUNT: usize             = 15;
val KINDS:      [KIND_COUNT]*Kind = [KIND_COUNT]*Kind{
    ?reloc.ABS64, ?reloc.ABS32, ?kinds.SUBTRACTOR64, ?kinds.SUBTRACTOR32, ?kinds.BRANCH26, ?kinds.PAGE21, ?kinds.PAGEOFF12,
    ?kinds.GOT_LOAD_PAGE21, ?kinds.GOT_LOAD_PAGEOFF12, ?kinds.POINTER_TO_GOT_PC32, ?kinds.POINTER_TO_GOT64,
    ?kinds.TLVP_LOAD_PAGE21, ?kinds.TLVP_LOAD_PAGEOFF12, ?kinds.ADDEND, ?kinds.AUTH_POINTER64,
};

# the adding record is applied first, so the subtracting one takes the field
# it wrote. the file holds the subtracting record first, which the
# conversion orders by the format's own rule
val DIFFERENCE_COUNT: usize                        = 2;
val DIFFERENCES:      [DIFFERENCE_COUNT]Difference = [DIFFERENCE_COUNT]Difference{
    Difference{kind: ?reloc.DIFF64, plus: UNSIGNED64, minus: SUBTRACTOR64},
    Difference{kind: ?reloc.DIFF32, plus: UNSIGNED32, minus: SUBTRACTOR32},
};

# the rows of the Mach-O and arm64 pair, and of the arm64e pair, which share
# every row
pub val SET:   Set = Set{format: ?format.MACHO, arch: ?aarch64.AARCH64, rows: ?ROWS[0], count: ROW_COUNT, kinds: ?KINDS[0], kind_count: KIND_COUNT, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT};
pub val SET_E: Set = Set{format: ?format.MACHO, arch: ?aarch64.ARM64E, rows: ?ROWS[0], count: ROW_COUNT, kinds: ?KINDS[0], kind_count: KIND_COUNT, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT};

# every type reloc.h defines has a row under its name, and a page offset
# field is chosen by the instruction at its place
test arm64__every_relocation_type_has_a_row {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    val sets: [1]*row.Set             = [1]*row.Set{?SET};
    var g:    res[row.Registry, Fail] = row.make(testing.allocator_of(?t), ?sets[0], 1);
    if (sel g.err) { ret 1; }
    val lk: res[*row.Lookup, Fail] = row.find(?g.ok, SET.format, SET.arch);
    if (sel lk.err) { ret 1; }
    val l: *row.Lookup = lk.ok;
    var i: usize       = 0;
    for (i < tables.RELOC_ARM64.count) {
        val c:     *Constant = tables.RELOC_ARM64.rows[i];
        var found: usize     = 0;
        var k:     usize     = 0;
        for (k < ROW_COUNT) {
            val r: *Row = ?ROWS[k];
            if (key.type_of(r.key) == c.value::u32) {
                if (!str_equals(r.name, c.name)) { ret 2; }
                found = found + 1;
            }
            if (r.key != key.make(key.type_of(r.key), key.length_of(r.key), key.pcrel_of(r.key))) { ret 2; }
            k = k + 1;
        }
        if (found == 0) { ret 3; }
        i = i + 1;
    }
    val off: res[*Row, Fail] = row.by_kind(l, ?kinds.PAGEOFF12);
    if (sel off.err) { ret 4; }
    # add x0, x0, #0 takes the unscaled immediate, ldr x8, [x8] the one scaled by eight
    var add: usize = 0;
    var ldr: usize = 0;
    var k:   usize = 0;
    for (k < off.ok.field_count) {
        if (row.chosen(?off.ok.fields[k], 0x9100_0000)) { add = k + 1; }
        if (row.chosen(?off.ok.fields[k], 0xf940_0108)) { ldr = k + 1; }
        k = k + 1;
    }
    if (add == 0 || ldr == 0)                                                               { ret 5; }
    if (off.ok.fields[add - 1].field.shift != 0 || off.ok.fields[ldr - 1].field.shift != 3) { ret 5; }
    val add_row: res[*Row, Fail] = row.by_key(l, ADDEND);
    if (sel add_row.err)                 { ret 6; }
    if (!add_row.ok.kind.takes.nameless) { ret 6; }
    val freed: err[Fail] = row.release(?g.ok);
    if (sel freed.err) { ret 1; }
    testing.dnit(?t);
    ret 0;
}
