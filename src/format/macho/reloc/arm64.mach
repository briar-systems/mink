# the Mach-O relocation table of the arm64 and arm64e pairs
#
# every relocation type mach-o/arm64/reloc.h defines has a row for each
# length and pcrel form it takes, keyed as key.mach composes them. a data
# field holds its addend, and an instruction field holds none: the addend of a
# BRANCH26, PAGE21 or PAGEOFF12 record is the ADDEND record before it, its
# partner, and the GOT and TLVP forms take none. a type that serves several
# instructions has a row per instruction form, told apart by the
# instruction's own bits: BRANCH26 reads a branch as a jump and a branch with
# link as a call, and PAGEOFF12 reads an add as the unscaled page offset and
# a load or store as the page offset of its access size, so each reads back
# as the neutral kind a format naming the size states. the GOT and TLV page
# offsets are eight-byte loads, or an add of the slot's address, a form of
# this pair's own. a difference is a
# SUBTRACTOR record then an UNSIGNED record at one place, the adding record
# applied first and the subtracting one taking its target from the field.
# arm64e adds the authenticated pointer, whose field holds the addend in its
# low word beside the key and diversity the loader signs with.

use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.testing;

use mink.base.fail.Fail;
use mink.catalog.arch.aarch64;
use mink.catalog.format;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;
use mink.format.macho.reloc.key;
use mink.format.macho.reloc.kinds;
use mink.model.reloc;
use mink.model.reloc.Kind;
use reloc_aarch64: mink.reloc.aarch64;
use mink.reloc.compute;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row;
use mink.reloc.row.Addend;
use mink.reloc.row.Difference;
use mink.reloc.row.FieldChoice;
use mink.reloc.row.Keys;
use mink.reloc.row.Refusal;
use mink.reloc.row.Row;
use mink.reloc.row.Set;

val P_DATA64: [1]Piece = [1]Piece{Piece{at: 0, width: 64}};
val P_DATA32: [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val P_ADRP:   [2]Piece = [2]Piece{Piece{at: 29, width: 2}, Piece{at: 5, width: 19}};

val F_NONE:   Field = Field{bytes: 0};
val F_DATA64: Field = Field{bytes: 8, pieces: ?P_DATA64[0], count: 1};
val F_DATA32: Field = Field{bytes: 4, pieces: ?P_DATA32[0], count: 1};
# the signed addend of an authenticated pointer in the low word of its field
val F_AUTH64: Field = Field{bytes: 8, pieces: ?P_DATA32[0], count: 1};
val F_ADRP:   Field = Field{bytes: 4, pieces: ?P_ADRP[0], count: 2, shift: 12, insn: true};

val C_NONE:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_NONE}};
val C_DATA64: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_DATA64}};
val C_DATA32: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_DATA32}};
val C_AUTH64: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_AUTH64}};
val C_ADRP:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_ADRP}};

val WRAP:    Range = Range{check: field.Check.wrap{}, bits: 0, align: 1};
val E32:     Range = Range{check: field.Check.either{}, bits: 32, align: 1};
val S32:     Range = Range{check: field.Check.signed{}, bits: 32, align: 1};
val PAGE:    Range = Range{check: field.Check.signed{}, bits: 33, align: 0x1000};
val BRANCH:  Range = Range{check: field.Check.signed{}, bits: 28, align: 4};
val LOW12:   Range = Range{check: field.Check.wrap{}, bits: 12, align: 1};
val LOW12_2: Range = Range{check: field.Check.wrap{}, bits: 12, align: 2};
val LOW12_4: Range = Range{check: field.Check.wrap{}, bits: 12, align: 4};
val LOW12_8: Range = Range{check: field.Check.wrap{}, bits: 12, align: 8};
val LOW12_F: Range = Range{check: field.Check.wrap{}, bits: 12, align: 16};

# the keys, as key.mach composes them from the type, the length and the pcrel
# bit, which the walk below holds every row to
pub val UNSIGNED64:          u32 = 0x30;
pub val UNSIGNED32:          u32 = 0x20;
pub val SUBTRACTOR64:        u32 = 0x31;
pub val SUBTRACTOR32:        u32 = 0x21;
pub val ADDEND:              u32 = 0x2a;
pub val POINTER_TO_GOT_PC32: u32 = 0x67;
pub val BRANCH26:            u32 = 0x62;
pub val PAGEOFF12:           u32 = 0x24;

val ADDEND_KEYS: [1]u32 = [1]u32{ADDEND};
val BY_ADDEND:   Addend = Addend.partner{Keys{keys: ?ADDEND_KEYS[0], count: 1}};

val F2: usize = reloc_aarch64.LDST_FORMS;
val F1: usize = reloc_aarch64.LDST128_FORMS;

val ROW_COUNT: usize          = 23;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{key: UNSIGNED64, name: "ARM64_RELOC_UNSIGNED", kind: ?reloc.ABS64, fields: ?C_DATA64[0], field_count: 1, value: ?compute.ABS, range: WRAP, addend: Addend.field{}},
    Row{key: UNSIGNED32, name: "ARM64_RELOC_UNSIGNED", kind: ?reloc.ABS32, fields: ?C_DATA32[0], field_count: 1, value: ?compute.ABS, range: E32, addend: Addend.field{}},
    Row{key: SUBTRACTOR64, name: "ARM64_RELOC_SUBTRACTOR", kind: ?kinds.SUBTRACTOR64, fields: ?C_DATA64[0], field_count: 1, value: ?compute.SUB, range: WRAP, addend: Addend.none{}},
    Row{key: SUBTRACTOR32, name: "ARM64_RELOC_SUBTRACTOR", kind: ?kinds.SUBTRACTOR32, fields: ?C_DATA32[0], field_count: 1, value: ?compute.SUB, range: WRAP, addend: Addend.none{}},
    Row{key: BRANCH26, name: "ARM64_RELOC_BRANCH26", kind: ?reloc.JUMP26, fields: ?reloc_aarch64.JUMP[0], field_count: 1, value: ?compute.PLT, range: BRANCH, addend: BY_ADDEND},
    Row{key: BRANCH26, name: "ARM64_RELOC_BRANCH26", kind: ?reloc.CALL26, fields: ?reloc_aarch64.CALL[0], field_count: 1, value: ?compute.PLT, range: BRANCH, addend: BY_ADDEND},
    Row{key: 0x63, name: "ARM64_RELOC_PAGE21", kind: ?reloc.PAGE21, fields: ?C_ADRP[0], field_count: 1, value: ?compute.PAGE, range: PAGE, addend: BY_ADDEND},
    Row{key: PAGEOFF12, name: "ARM64_RELOC_PAGEOFF12", kind: ?reloc.LO12_ADD, fields: ?reloc_aarch64.ADD[0], field_count: 1, value: ?compute.ABS, range: LOW12, addend: BY_ADDEND},
    Row{key: PAGEOFF12, name: "ARM64_RELOC_PAGEOFF12", kind: ?reloc.LO12_LDST8, fields: ?reloc_aarch64.LDST8[0], field_count: F2, value: ?compute.ABS, range: LOW12, addend: BY_ADDEND},
    Row{key: PAGEOFF12, name: "ARM64_RELOC_PAGEOFF12", kind: ?reloc.LO12_LDST16, fields: ?reloc_aarch64.LDST16[0], field_count: F2, value: ?compute.ABS, range: LOW12_2, addend: BY_ADDEND},
    Row{key: PAGEOFF12, name: "ARM64_RELOC_PAGEOFF12", kind: ?reloc.LO12_LDST32, fields: ?reloc_aarch64.LDST32[0], field_count: F2, value: ?compute.ABS, range: LOW12_4, addend: BY_ADDEND},
    Row{key: PAGEOFF12, name: "ARM64_RELOC_PAGEOFF12", kind: ?reloc.LO12_LDST64, fields: ?reloc_aarch64.LDST64[0], field_count: F2, value: ?compute.ABS, range: LOW12_8, addend: BY_ADDEND},
    Row{key: PAGEOFF12, name: "ARM64_RELOC_PAGEOFF12", kind: ?reloc.LO12_LDST128, fields: ?reloc_aarch64.LDST128[0], field_count: F1, value: ?compute.ABS, range: LOW12_F, addend: BY_ADDEND},
    Row{key: 0x65, name: "ARM64_RELOC_GOT_LOAD_PAGE21", kind: ?reloc.GOT_PAGE21, fields: ?C_ADRP[0], field_count: 1, value: ?compute.GOT_PAGE, range: PAGE, addend: Addend.none{}},
    Row{key: 0x26, name: "ARM64_RELOC_GOT_LOAD_PAGEOFF12", kind: ?reloc.GOT_LO12, fields: ?reloc_aarch64.LDST64[0], field_count: F2, value: ?compute.GOT, range: LOW12_8, addend: Addend.none{}},
    Row{key: 0x26, name: "ARM64_RELOC_GOT_LOAD_PAGEOFF12", kind: ?kinds.GOT_LOAD_PAGEOFF12_ADD, fields: ?reloc_aarch64.ADD[0], field_count: 1, value: ?compute.GOT, range: LOW12, addend: Addend.none{}},
    Row{key: POINTER_TO_GOT_PC32, name: "ARM64_RELOC_POINTER_TO_GOT", kind: ?kinds.POINTER_TO_GOT_PC32, fields: ?C_DATA32[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.field{}},
    Row{key: 0x37, name: "ARM64_RELOC_POINTER_TO_GOT", kind: ?kinds.POINTER_TO_GOT64, fields: ?C_DATA64[0], field_count: 1, value: ?compute.GOT, range: WRAP, addend: Addend.field{}},
    Row{key: 0x68, name: "ARM64_RELOC_TLVP_LOAD_PAGE21", kind: ?reloc.TLV_PAGE21, fields: ?C_ADRP[0], field_count: 1, value: ?compute.PAGE, range: PAGE, addend: Addend.none{}},
    Row{key: 0x29, name: "ARM64_RELOC_TLVP_LOAD_PAGEOFF12", kind: ?reloc.TLV_LO12, fields: ?reloc_aarch64.LDST64[0], field_count: F2, value: ?compute.ABS, range: LOW12_8, addend: Addend.none{}},
    Row{key: 0x29, name: "ARM64_RELOC_TLVP_LOAD_PAGEOFF12", kind: ?kinds.TLVP_LOAD_PAGEOFF12_ADD, fields: ?reloc_aarch64.ADD[0], field_count: 1, value: ?compute.ABS, range: LOW12, addend: Addend.none{}},
    Row{key: ADDEND, name: "ARM64_RELOC_ADDEND", kind: ?kinds.ADDEND, fields: ?C_NONE[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.none{}},
    Row{key: 0x3b, name: "ARM64_RELOC_AUTHENTICATED_POINTER", kind: ?kinds.AUTH_POINTER64, fields: ?C_AUTH64[0], field_count: 1, value: ?compute.ABS, range: S32, addend: Addend.field{}},
};

val KIND_COUNT: usize             = 24;
val KINDS:      [KIND_COUNT]*Kind = [KIND_COUNT]*Kind{
    ?reloc.BRANCH32, ?reloc.ABS64, ?reloc.ABS32, ?kinds.SUBTRACTOR64, ?kinds.SUBTRACTOR32, ?reloc.JUMP26, ?reloc.CALL26, ?reloc.PAGE21,
    ?reloc.LO12_ADD, ?reloc.LO12_LDST8, ?reloc.LO12_LDST16, ?reloc.LO12_LDST32, ?reloc.LO12_LDST64, ?reloc.LO12_LDST128,
    ?reloc.GOT_PAGE21, ?reloc.GOT_LO12, ?kinds.GOT_LOAD_PAGEOFF12_ADD, ?kinds.POINTER_TO_GOT_PC32, ?kinds.POINTER_TO_GOT64,
    ?reloc.TLV_PAGE21, ?reloc.TLV_LO12, ?kinds.TLVP_LOAD_PAGEOFF12_ADD, ?kinds.ADDEND, ?kinds.AUTH_POINTER64,
};

# the adding record is applied first, so the subtracting one takes the field
# it wrote. the file holds the subtracting record first, which the
# conversion orders by the format's own rule
val DIFFERENCE_COUNT: usize                        = 2;
val DIFFERENCES:      [DIFFERENCE_COUNT]Difference = [DIFFERENCE_COUNT]Difference{
    Difference{kind: ?reloc.DIFF64, plus: UNSIGNED64, minus: SUBTRACTOR64},
    Difference{kind: ?reloc.DIFF32, plus: UNSIGNED32, minus: SUBTRACTOR32},
};

# a branch that may reach a stub is written as BRANCH26, which reads back as
# a jump or a call as its instruction is
val WRITES: [1]Row = [1]Row{
    Row{key: BRANCH26, name: "ARM64_RELOC_BRANCH26", kind: ?reloc.BRANCH32, fields: ?reloc_aarch64.BRANCH26[0], field_count: 1, value: ?compute.PLT, range: BRANCH, addend: BY_ADDEND},
};

# the rows of the Mach-O and arm64 pair, and of the arm64e pair, which share
# every row
val REFUSALS_COUNT: usize                   = 35;
val REFUSALS:       [REFUSALS_COUNT]Refusal = [REFUSALS_COUNT]Refusal{
    Refusal{kind: ?reloc.ABS32S, why: "a 4-byte UNSIGNED record is never sign-extended, and no instruction takes a 32-bit absolute", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.NONE, why: "no relocation type marks a place without a value", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.ABS8, why: "a record's length states only four or eight bytes", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.ABS16, why: "a record's length states only four or eight bytes", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.DIFF8, why: "a record's length states only four or eight bytes", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.DIFF16, why: "a record's length states only four or eight bytes", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.PC8, why: "ARM64_RELOC_UNSIGNED takes no place-relative form, so a distance from the place is written as a difference", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.PC16, why: "ARM64_RELOC_UNSIGNED takes no place-relative form, so a distance from the place is written as a difference", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.PC32, why: "ARM64_RELOC_UNSIGNED takes no place-relative form, so a distance from the place is written as a difference", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.PC64, why: "ARM64_RELOC_UNSIGNED takes no place-relative form, so a distance from the place is written as a difference", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.BRANCH19, why: "no relocation type patches a conditional branch", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.BRANCH14, why: "no relocation type patches a test and branch", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.LD_PREL_LO19, why: "no relocation type patches a literal load", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.ADR_PREL_LO21, why: "no relocation type patches an adr", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSDESC_LD_PREL19, why: "thread-local data is reached through its variable descriptor, never a TLS descriptor", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSDESC_ADR_PREL21, why: "thread-local data is reached through its variable descriptor, never a TLS descriptor", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSDESC_ADR_PAGE21, why: "thread-local data is reached through its variable descriptor, never a TLS descriptor", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSDESC_LD64_LO12, why: "thread-local data is reached through its variable descriptor, never a TLS descriptor", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSDESC_ADD_LO12, why: "thread-local data is reached through its variable descriptor, never a TLS descriptor", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSDESC_OFF_G1, why: "thread-local data is reached through its variable descriptor, never a TLS descriptor", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSDESC_OFF_G0_NC, why: "thread-local data is reached through its variable descriptor, never a TLS descriptor", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSDESC_LDR, why: "thread-local data is reached through its variable descriptor, never a TLS descriptor", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSDESC_ADD, why: "thread-local data is reached through its variable descriptor, never a TLS descriptor", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSIE_MOVW_GOTTPREL_G1, why: "thread-local data is reached through its variable descriptor, never an initial exec slot", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSIE_MOVW_GOTTPREL_G0_NC, why: "thread-local data is reached through its variable descriptor, never an initial exec slot", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSIE_ADR_GOTTPREL_PAGE21, why: "thread-local data is reached through its variable descriptor, never an initial exec slot", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSIE_LD64_GOTTPREL_LO12_NC, why: "thread-local data is reached through its variable descriptor, never an initial exec slot", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.TLSIE_LD_GOTTPREL_PREL19, why: "thread-local data is reached through its variable descriptor, never an initial exec slot", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.SECREL_HI12, why: "no relocation type counts from the target's section", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.SECREL_LO12_ADD, why: "no relocation type counts from the target's section", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.SECREL_LO12_LDST8, why: "no relocation type counts from the target's section", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.SECREL_LO12_LDST16, why: "no relocation type counts from the target's section", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.SECREL_LO12_LDST32, why: "no relocation type counts from the target's section", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.SECREL_LO12_LDST64, why: "no relocation type counts from the target's section", source: "mach-o/arm64/reloc.h"},
    Refusal{kind: ?reloc.SECREL_LO12_LDST128, why: "no relocation type counts from the target's section", source: "mach-o/arm64/reloc.h"},
};

pub val SET:   Set = Set{format: ?format.MACHO, arch: ?aarch64.AARCH64, rows: ?ROWS[0], count: ROW_COUNT, kinds: ?KINDS[0], kind_count: KIND_COUNT, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT, refusals: ?REFUSALS[0], refusal_count: REFUSALS_COUNT, writes: ?WRITES[0], write_count: 1};
pub val SET_E: Set = Set{format: ?format.MACHO, arch: ?aarch64.ARM64E, rows: ?ROWS[0], count: ROW_COUNT, kinds: ?KINDS[0], kind_count: KIND_COUNT, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT, refusals: ?REFUSALS[0], refusal_count: REFUSALS_COUNT, writes: ?WRITES[0], write_count: 1};

# every type reloc.h defines has a row under its name, and a page offset
# field is chosen by the instruction at its place
test arm64__every_relocation_type_has_a_row {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    val sets: [1]*row.Set             = [1]*row.Set{?SET};
    var g:    res[row.Registry, Fail] = row.make(testing.allocator_of(?t), ?sets[0], 1);
    if (sel g.err) { ret 1; }
    val lk: res[*row.Lookup, Fail] = row.find(?g.ok, SET.format, SET.arch);
    if (sel lk.err) { ret 1; }
    val l: *row.Lookup = lk.ok;
    var i: usize       = 0;
    for (i < tables.RELOC_ARM64.count) {
        val c:     *Constant = tables.RELOC_ARM64.rows[i];
        var found: usize     = 0;
        var k:     usize     = 0;
        for (k < ROW_COUNT) {
            val r: *Row = ?ROWS[k];
            if (key.type_of(r.key) == c.value::u32) {
                if (!str_equals(r.name, c.name)) { ret 2; }
                found = found + 1;
            }
            if (r.key != key.make(key.type_of(r.key), key.length_of(r.key), key.pcrel_of(r.key))) { ret 2; }
            k = k + 1;
        }
        if (found == 0) { ret 3; }
        i = i + 1;
    }
    # add x0, x0, #0 reads as the unscaled page offset, ldr x8, [x8] as the
    # one scaled by eight, and the code alone names no row
    val add: res[*Row, Fail] = row.reading(l, PAGEOFF12, 0x9100_0000);
    val ldr: res[*Row, Fail] = row.reading(l, PAGEOFF12, 0xf940_0108);
    if (sel add.err)                                                            { ret 4; }
    if (sel ldr.err)                                                            { ret 4; }
    if (add.ok.kind != ?reloc.LO12_ADD || ldr.ok.kind != ?reloc.LO12_LDST64)    { ret 5; }
    if (add.ok.fields[0].field.shift != 0 || ldr.ok.fields[0].field.shift != 3) { ret 5; }
    val bare: res[*Row, Fail] = row.by_key(l, PAGEOFF12);
    if (sel bare.ok) { ret 5; }
    val add_row: res[*Row, Fail] = row.by_key(l, ADDEND);
    if (sel add_row.err)                 { ret 6; }
    if (!add_row.ok.kind.takes.nameless) { ret 6; }
    val freed: err[Fail] = row.release(?g.ok);
    if (sel freed.err) { ret 1; }
    testing.dnit(?t);
    ret 0;
}
