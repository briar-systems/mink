# the forms the arm64 Mach-O GOT and TLV page references take before layout
#
# mach-o/arm64/reloc.h states GOT_LOAD_PAGE21 and TLVP_LOAD_PAGE21 as the
# page of the GOT entry or the TLV pointer an adrp reaches, and the
# PAGEOFF12 of each as its offset in that page. the page offset an add takes
# in place of the load is the add form, which takes the address the load
# would read: the target's for a GOT reference and the descriptor's for a TLV
# one. an adrp and the instruction after it compute one address, the page
# from one and the low bits from the other, so the page reference of a
# target whose offsets take the add form takes the page of that same address.
# the two are coupled through their uniform forms: a target's records in a
# section take the add form and the add's page all or none, and a page
# offset that is an add where another of its target's in the section is a
# load is refused, as one adrp may serve both. no form changes a byte, so
# each keeps the constant-time class of its code.

use std.types.bool.true;
use std.types.size.usize;

use mink.format.macho.reloc.kinds;
use mink.model.reloc.Kind;
use mink.reloc.row.Condition;
use mink.reloc.row.InsnPattern;
use mink.reloc.row.Rewrite;

# an add of an immediate at the place
val ADD: [1]InsnPattern = [1]InsnPattern{InsnPattern{at: 0, mask: 0x7f80_0000, value: 0x1100_0000, len: 4}};

val GOT_OFFSET_KINDS: [1]*Kind = [1]*Kind{?kinds.GOT_LOAD_PAGEOFF12_ADD};
val GOT_PAGE_KINDS:   [1]*Kind = [1]*Kind{?kinds.GOT_LOAD_PAGE21_ADD};
val TLV_OFFSET_KINDS: [1]*Kind = [1]*Kind{?kinds.TLVP_LOAD_PAGEOFF12_ADD};
val TLV_PAGE_KINDS:   [1]*Kind = [1]*Kind{?kinds.TLVP_LOAD_PAGE21_ADD};

val GOT_ADD: Rewrite = Rewrite{
    name:       "the add form",
    when:       Condition{shape: ?ADD[0], shape_count: 1, uniform: true},
    kinds:      ?GOT_OFFSET_KINDS[0],
    kind_count: 1,
    keeps_ct:   true,
    must:       true,
};
val GOT_ADD_PAGE: Rewrite = Rewrite{
    name:       "the add's page",
    when:       Condition{uniform: true},
    kinds:      ?GOT_PAGE_KINDS[0],
    kind_count: 1,
    keeps_ct:   true,
};
val TLV_ADD: Rewrite = Rewrite{
    name:       "the add form",
    when:       Condition{shape: ?ADD[0], shape_count: 1, uniform: true},
    kinds:      ?TLV_OFFSET_KINDS[0],
    kind_count: 1,
    keeps_ct:   true,
    must:       true,
};
val TLV_ADD_PAGE: Rewrite = Rewrite{
    name:       "the add's page",
    when:       Condition{uniform: true},
    kinds:      ?TLV_PAGE_KINDS[0],
    kind_count: 1,
    keeps_ct:   true,
};

# the forms of ARM64_RELOC_GOT_LOAD_PAGE21 and ARM64_RELOC_GOT_LOAD_PAGEOFF12
pub val GOT_PAGE_COUNT:   usize                      = 1;
pub val GOT_PAGE_FORMS:   [GOT_PAGE_COUNT]*Rewrite   = [GOT_PAGE_COUNT]*Rewrite{?GOT_ADD_PAGE};
pub val GOT_OFFSET_COUNT: usize                      = 1;
pub val GOT_OFFSET_FORMS: [GOT_OFFSET_COUNT]*Rewrite = [GOT_OFFSET_COUNT]*Rewrite{?GOT_ADD};

# the forms of ARM64_RELOC_TLVP_LOAD_PAGE21 and ARM64_RELOC_TLVP_LOAD_PAGEOFF12
pub val TLV_PAGE_COUNT:   usize                      = 1;
pub val TLV_PAGE_FORMS:   [TLV_PAGE_COUNT]*Rewrite   = [TLV_PAGE_COUNT]*Rewrite{?TLV_ADD_PAGE};
pub val TLV_OFFSET_COUNT: usize                      = 1;
pub val TLV_OFFSET_FORMS: [TLV_OFFSET_COUNT]*Rewrite = [TLV_OFFSET_COUNT]*Rewrite{?TLV_ADD};
