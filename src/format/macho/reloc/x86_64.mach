# the Mach-O relocation table of the x86_64 pair
#
# every relocation type mach-o/x86_64/reloc.h defines has a row for each
# length and pcrel form it takes, keyed as key.mach composes them. an addend
# lives in the field: a place-relative field counts from the byte after it,
# so every place-relative row carries a bias of minus four, and a SIGNED_n
# field counts from the end of an instruction with n more bytes after the
# field, which the record's addend already holds. a difference is a
# SUBTRACTOR record then an UNSIGNED record at one place, the adding record
# applied first and the subtracting one taking its target from the field.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.testing;

use mink.base.fail.Fail;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;
use mink.format.macho.reloc.key;
use mink.format.macho.reloc.kinds;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.compute;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row;
use mink.reloc.row.Addend;
use mink.reloc.row.Difference;
use mink.reloc.row.FieldChoice;
use mink.reloc.row.Row;
use mink.reloc.row.Set;

val P32: [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val P64: [1]Piece = [1]Piece{Piece{at: 0, width: 64}};

val B32: Field = Field{bytes: 4, pieces: ?P32[0], count: 1};
val B64: Field = Field{bytes: 8, pieces: ?P64[0], count: 1};

val B32_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B32}};
val B64_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B64}};

val WRAP: Range = Range{check: field.Check.wrap{}, bits: 0, align: 1};
val S32:  Range = Range{check: field.Check.signed{}, bits: 32, align: 1};
val E32:  Range = Range{check: field.Check.either{}, bits: 32, align: 1};

# a place-relative field counts from the byte after it
val AFTER: i64 = -4;

# the keys, as key.mach composes them from the type, the length and the pcrel
# bit, which the walk below holds every row to
pub val UNSIGNED64:   u32 = 0x30;
pub val UNSIGNED32:   u32 = 0x20;
pub val SUBTRACTOR64: u32 = 0x35;
pub val SUBTRACTOR32: u32 = 0x25;

val ROW_COUNT: usize          = 12;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{key: UNSIGNED64, name: "X86_64_RELOC_UNSIGNED", kind: ?reloc.ABS64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.ABS, range: WRAP, addend: Addend.field{}},
    Row{key: UNSIGNED32, name: "X86_64_RELOC_UNSIGNED", kind: ?reloc.ABS32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.ABS, range: E32, addend: Addend.field{}},
    Row{key: 0x61, name: "X86_64_RELOC_SIGNED", kind: ?reloc.PC32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: AFTER},
    Row{key: 0x62, name: "X86_64_RELOC_BRANCH", kind: ?kinds.BRANCH32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PLT, range: S32, addend: Addend.field{}, bias: AFTER},
    Row{key: 0x63, name: "X86_64_RELOC_GOT_LOAD", kind: ?kinds.GOT_LOAD_PC32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.field{}, bias: AFTER},
    Row{key: 0x64, name: "X86_64_RELOC_GOT", kind: ?kinds.GOT_PC32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.field{}, bias: AFTER},
    Row{key: SUBTRACTOR64, name: "X86_64_RELOC_SUBTRACTOR", kind: ?kinds.SUBTRACTOR64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.SUB, range: WRAP, addend: Addend.none{}},
    Row{key: SUBTRACTOR32, name: "X86_64_RELOC_SUBTRACTOR", kind: ?kinds.SUBTRACTOR32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.SUB, range: WRAP, addend: Addend.none{}},
    Row{key: 0x66, name: "X86_64_RELOC_SIGNED_1", kind: ?kinds.SIGNED_1, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: AFTER},
    Row{key: 0x67, name: "X86_64_RELOC_SIGNED_2", kind: ?kinds.SIGNED_2, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: AFTER},
    Row{key: 0x68, name: "X86_64_RELOC_SIGNED_4", kind: ?kinds.SIGNED_4, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: AFTER},
    Row{key: 0x69, name: "X86_64_RELOC_TLV", kind: ?kinds.TLV_PC32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.field{}, bias: AFTER},
};

val KIND_COUNT: usize             = 12;
val KINDS:      [KIND_COUNT]*Kind = [KIND_COUNT]*Kind{
    ?reloc.ABS64, ?reloc.ABS32, ?reloc.PC32, ?kinds.BRANCH32, ?kinds.GOT_LOAD_PC32, ?kinds.GOT_PC32,
    ?kinds.SUBTRACTOR64, ?kinds.SUBTRACTOR32, ?kinds.SIGNED_1, ?kinds.SIGNED_2, ?kinds.SIGNED_4, ?kinds.TLV_PC32,
};

# the adding record is applied first, so the subtracting one takes the field
# it wrote. the file holds the subtracting record first, which the
# conversion orders by the format's own rule
val DIFFERENCE_COUNT: usize                        = 2;
val DIFFERENCES:      [DIFFERENCE_COUNT]Difference = [DIFFERENCE_COUNT]Difference{
    Difference{kind: ?reloc.DIFF64, plus: UNSIGNED64, minus: SUBTRACTOR64},
    Difference{kind: ?reloc.DIFF32, plus: UNSIGNED32, minus: SUBTRACTOR32},
};

# the rows of the Mach-O and x86_64 pair
pub val SET: Set = Set{format: ?format.MACHO, arch: ?x86.X86_64, rows: ?ROWS[0], count: ROW_COUNT, kinds: ?KINDS[0], kind_count: KIND_COUNT, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT};

# every type reloc.h defines has a row under its name, and the two forms of
# UNSIGNED and SUBTRACTOR are told apart by their keys
test x86_64__every_relocation_type_has_a_row {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    val sets: [1]*row.Set             = [1]*row.Set{?SET};
    var g:    res[row.Registry, Fail] = row.make(testing.allocator_of(?t), ?sets[0], 1);
    if (sel g.err) { ret 1; }
    val lk: res[*row.Lookup, Fail] = row.find(?g.ok, SET.format, SET.arch);
    if (sel lk.err) { ret 1; }
    val l: *row.Lookup = lk.ok;
    var i: usize       = 0;
    for (i < tables.RELOC_X86_64.count) {
        val c:     *Constant = tables.RELOC_X86_64.rows[i];
        var found: usize     = 0;
        var k:     usize     = 0;
        for (k < ROW_COUNT) {
            val r: *Row = ?ROWS[k];
            if (key.type_of(r.key) == c.value::u32) {
                if (!str_equals(r.name, c.name)) { ret 2; }
                found = found + 1;
            }
            if (r.key != key.make(key.type_of(r.key), key.length_of(r.key), key.pcrel_of(r.key))) { ret 2; }
            k = k + 1;
        }
        if (found == 0) { ret 3; }
        i = i + 1;
    }
    val wide: res[*Row, Fail] = row.by_key(l, UNSIGNED64);
    if (sel wide.err)                 { ret 4; }
    if (wide.ok.kind != ?reloc.ABS64) { ret 4; }
    val word: res[*Row, Fail] = row.by_key(l, UNSIGNED32);
    if (sel word.err)                 { ret 4; }
    if (word.ok.kind != ?reloc.ABS32) { ret 4; }
    val d: res[*row.Pairing, Fail] = row.difference_of(l, ?reloc.DIFF64);
    if (sel d.err)                                              { ret 5; }
    if (d.ok.plus != wide.ok || d.ok.minus.key != SUBTRACTOR64) { ret 5; }
    val freed: err[Fail] = row.release(?g.ok);
    if (sel freed.err) { ret 1; }
    testing.dnit(?t);
    ret 0;
}
