# how Mach-O lays an image out
#
# a section keeps its segment and section name pair, and output sections load
# by class into __TEXT, which holds the header, the code and the constants,
# __DATA_CONST, which the loader writes once, and __DATA, with its zero fill
# last. the thread-local data and zero fill lie together after the data, so
# the thread-local template is one run. the debugging sections S_ATTR_DEBUG
# marks load into __DWARF, after the data, mapped with no access, and any
# other section no segment loads is metadata, which its own no-access segment
# carries the same way.

use std.types.option.opt;
use std.types.size.usize;

use mink.base.rule.Axis;
use mink.format.layout.Class;
use mink.format.layout.Load;
use mink.format.layout.Opening;
use mink.format.layout.Rules;
use mink.format.macho.neutral.naming;
use mink.model.section;

val TEXT:       Load = Load{name: "__TEXT", flags: section.ALLOC | section.EXEC};
val DATA_CONST: Load = Load{name: "__DATA_CONST", flags: section.ALLOC | section.WRITE};
val DATA:       Load = Load{name: "__DATA", flags: section.ALLOC | section.WRITE};
val DWARF:      Load = Load{name: "__DWARF", flags: 0};
val METADATA:   Load = Load{name: naming.METADATA_SEGMENT, flags: 0};

val TLS:       section.Flags = section.ALLOC | section.WRITE | section.TLS;
val WRITTEN:   section.Flags = section.ALLOC | section.WRITE;
val UNWRITTEN: section.Flags = section.EXEC | section.TLS;

val CLASS_COUNT: usize              = 9;
val CLASSES:     [CLASS_COUNT]Class = [CLASS_COUNT]Class{
    Class{name: "text", rank: 0, flags: Axis{need: section.ALLOC | section.EXEC, deny: section.WRITE}, load: opt[*Load].some{?TEXT}},
    Class{name: "const", rank: 1, flags: Axis{need: section.ALLOC, deny: section.WRITE | section.EXEC}, load: opt[*Load].some{?TEXT}},
    Class{name: "data const", rank: 2, flags: Axis{need: WRITTEN, deny: UNWRITTEN}, roles: Axis{need: section.RELRO}, load: opt[*Load].some{?DATA_CONST}},
    Class{name: "data", rank: 3, flags: Axis{need: WRITTEN, deny: UNWRITTEN}, roles: Axis{need: section.BITS, deny: section.RELRO}, load: opt[*Load].some{?DATA}},
    Class{name: "thread data", rank: 4, flags: Axis{need: TLS, deny: section.EXEC}, roles: Axis{need: section.BITS}, load: opt[*Load].some{?DATA}},
    Class{name: "thread bss", rank: 5, flags: Axis{need: TLS, deny: section.EXEC}, roles: Axis{deny: section.BITS}, load: opt[*Load].some{?DATA}},
    Class{name: "bss", rank: 6, flags: Axis{need: WRITTEN, deny: UNWRITTEN}, roles: Axis{deny: section.BITS | section.RELRO}, load: opt[*Load].some{?DATA}},
    Class{name: "debug", rank: 7, flags: Axis{deny: section.ALLOC}, roles: Axis{need: section.DEBUG}, load: opt[*Load].some{?DWARF}},
    Class{name: "unloaded", rank: 8, flags: Axis{deny: section.ALLOC}, roles: Axis{deny: section.DEBUG}, load: opt[*Load].some{?METADATA}},
};

pub val LAYOUT: Rules = Rules{
    name:          "macho",
    stems:         nil,
    stem_count:    0,
    joint:         0,
    cut:           0,
    segment_join:  naming.SEGMENT_JOIN,
    classes:       ?CLASSES[0],
    class_count:   CLASS_COUNT,
    commons:       "__DATA,__common",
    opens:         Opening.paged{},
    section_align: 1,
    file_align:    1,
    naming:        naming.name_of,
};
