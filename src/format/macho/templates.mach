# the code templates of the (Mach-O, architecture) pairs
#
# a stub jumps through its target's slot, and the stub helper's head pushes
# the lazy binder's cache cell and jumps to the binder through its GOT slot,
# each entry naming where its lazy pointer's binding starts in the lazy bind
# stream and jumping to the head, as ld64.lld writes them. each patch point
# is applied through the pair's relocation rows.

use mink.catalog.slot;
use mink.link.template;
use mink.link.template.Patch;
use mink.link.template.Set;
use mink.link.template.Template;
use mink.model.reloc;

# jmpq *slot(%rip)
val X86_64_STUB:         [6]u8    = [6]u8{0xff, 0x25, 0, 0, 0, 0};
val X86_64_STUB_PATCHES: [1]Patch = [1]Patch{Patch{offset: 2, kind: ?reloc.PC32, target: ?template.SLOT, addend: -4}};

# leaq cache(%rip), %r11, pushq %r11, jmpq *binder(%rip) and a nop pad
val X86_64_HEAD: [16]u8 = [16]u8{
    0x4c, 0x8d, 0x1d, 0, 0, 0, 0, 0x41, 0x53, 0xff, 0x25, 0, 0, 0, 0, 0x90,
};
val X86_64_HEAD_PATCHES: [2]Patch = [2]Patch{
    Patch{offset: 3, kind: ?reloc.PC32, target: ?template.CACHE, addend: -4},
    Patch{offset: 11, kind: ?reloc.PC32, target: ?template.BINDER, addend: -4},
};

# pushq $index and jmp to the head
val X86_64_ENTRY:         [10]u8   = [10]u8{0x68, 0, 0, 0, 0, 0xe9, 0, 0, 0, 0};
val X86_64_ENTRY_PATCHES: [2]Patch = [2]Patch{
    Patch{offset: 1, kind: ?reloc.ABS32, target: ?template.INDEX},
    Patch{offset: 6, kind: ?reloc.PC32, target: ?template.HEADER, addend: -4},
};

val X86_64_ROWS: [3]Template = [3]Template{
    Template{role: ?slot.STUB_CODE, variant: ?template.PLAIN, name: "x86_64 stub", bytes: ?X86_64_STUB[0], len: 6, align: 2, patches: ?X86_64_STUB_PATCHES[0], patch_count: 1},
    Template{role: ?slot.STUB_HELPER_ENTRY, variant: ?template.PLAIN, name: "x86_64 stub helper entry", bytes: ?X86_64_ENTRY[0], len: 10, align: 1, patches: ?X86_64_ENTRY_PATCHES[0], patch_count: 2},
    Template{role: ?slot.STUB_HELPER_HEAD, variant: ?template.PLAIN, name: "x86_64 stub helper head", bytes: ?X86_64_HEAD[0], len: 16, align: 4, patches: ?X86_64_HEAD_PATCHES[0], patch_count: 2},
};
val X86_64_POINTERS: [3]*Template = [3]*Template{?X86_64_ROWS[0], ?X86_64_ROWS[1], ?X86_64_ROWS[2]};

pub val X86_64: Set = Set{rows: ?X86_64_POINTERS[0], roles: ?X86_64_POINTERS[0], count: 3};

# adrp x16, slot@page, ldr x16, [x16, slot@pageoff] and br x16
val ARM64_STUB: [12]u8 = [12]u8{
    0x10, 0, 0, 0x90, 0x10, 0x02, 0x40, 0xf9, 0x00, 0x02, 0x1f, 0xd6,
};
val ARM64_STUB_PATCHES: [2]Patch = [2]Patch{
    Patch{offset: 0, kind: ?reloc.PAGE21, target: ?template.SLOT},
    Patch{offset: 4, kind: ?reloc.LO12_LDST64, target: ?template.SLOT},
};

# adrp x17, cache@page, add x17, x17, cache@pageoff, stp x16, x17, [sp, #-16]!,
# then the binder's slot loaded and branched to as a stub does
val ARM64_HEAD: [24]u8 = [24]u8{
    0x11, 0, 0, 0x90, 0x31, 0x02, 0, 0x91, 0xf0, 0x47, 0xbf, 0xa9,
    0x10, 0, 0, 0x90, 0x10, 0x02, 0x40, 0xf9, 0x00, 0x02, 0x1f, 0xd6,
};
val ARM64_HEAD_PATCHES: [4]Patch = [4]Patch{
    Patch{offset: 0, kind: ?reloc.PAGE21, target: ?template.CACHE},
    Patch{offset: 4, kind: ?reloc.LO12_ADD, target: ?template.CACHE},
    Patch{offset: 12, kind: ?reloc.PAGE21, target: ?template.BINDER},
    Patch{offset: 16, kind: ?reloc.LO12_LDST64, target: ?template.BINDER},
};

# ldr w16 of the index two words on, b to the head, and the index
val ARM64_ENTRY: [12]u8 = [12]u8{
    0x50, 0, 0, 0x18, 0, 0, 0, 0x14, 0, 0, 0, 0,
};
val ARM64_ENTRY_PATCHES: [2]Patch = [2]Patch{
    Patch{offset: 4, kind: ?reloc.JUMP26, target: ?template.HEADER},
    Patch{offset: 8, kind: ?reloc.ABS32, target: ?template.INDEX},
};

val ARM64_ROWS: [3]Template = [3]Template{
    Template{role: ?slot.STUB_CODE, variant: ?template.PLAIN, name: "arm64 stub", bytes: ?ARM64_STUB[0], len: 12, align: 4, patches: ?ARM64_STUB_PATCHES[0], patch_count: 2},
    Template{role: ?slot.STUB_HELPER_ENTRY, variant: ?template.PLAIN, name: "arm64 stub helper entry", bytes: ?ARM64_ENTRY[0], len: 12, align: 4, patches: ?ARM64_ENTRY_PATCHES[0], patch_count: 2},
    Template{role: ?slot.STUB_HELPER_HEAD, variant: ?template.PLAIN, name: "arm64 stub helper head", bytes: ?ARM64_HEAD[0], len: 24, align: 4, patches: ?ARM64_HEAD_PATCHES[0], patch_count: 4},
};
val ARM64_POINTERS: [3]*Template = [3]*Template{?ARM64_ROWS[0], ?ARM64_ROWS[1], ?ARM64_ROWS[2]};

pub val ARM64: Set = Set{rows: ?ARM64_POINTERS[0], roles: ?ARM64_POINTERS[0], count: 3};
