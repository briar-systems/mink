# the stretches of a blob its fields cover
#
# a codec holds a blob as fields, and gives back every byte only when the
# fields cover every byte that is not zero. a blob that holds anything else is
# refused rather than silently reshaped.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.vectors;
use mink.bytes.reader.Reader;

# a stretch of a blob a field covers
# ---
# start: the first byte
# end:   the byte after the last
pub rec Range {
    start: u64;
    end:   u64;
}

# the stretches covered, in order of their start
pub rec Cover {
    ranges: Vector[Range];
}

# an empty cover
# ---
# a:   the allocator the ranges grow in
# ret: a cover of no stretches, which the caller gives back with dnit
pub fun init(a: *A.Allocator) Cover {
    ret Cover{ranges: vector.init[Range](a)};
}

# give back the ranges of a cover
# ---
# c:   the cover
# ret: ok, or the failure of releasing the ranges
pub fun dnit(c: *Cover) err[Fail] {
    ret vectors.dnit[Range](?c.ranges);
}

# the cover given back after the work that used it, whose failure comes first
pub fun settle(c: *Cover, work: err[Fail]) err[Fail] {
    val err_dropped: err[Fail] = dnit(c);
    if (sel work.err) { ret work; }
    ret err_dropped;
}

# `len` bytes at `start` are covered. a stretch of no bytes covers nothing
pub fun add(c: *Cover, at: Location, start: u64, len: u64) err[Fail] {
    if (len == 0) { ret err[Fail].ok{}; }
    val res_end: res[u64, Fail] = checked.add(at, start, len);
    if (sel res_end.err) { ret err[Fail].err{res_end.err}; }
    val err_ranges_pushed: err[Fail] = vectors.push[Range](?c.ranges, Range{start: start, end: res_end.ok});
    if (sel err_ranges_pushed.err) { ret err[Fail].err{err_ranges_pushed.err}; }
    val items: *Range = c.ranges.data;
    var i:     usize  = vector.length[Range](?c.ranges) - 1;
    for (i > 0 && items[i - 1].start > start) {
        items[i] = items[i - 1];
        i        = i - 1;
    }
    items[i] = Range{start: start, end: res_end.ok};
    ret err[Fail].ok{};
}

# the blob the reader spans is its covered stretches and zeros, and no two
# stretches overlap
pub fun check(c: *Cover, r: *Reader) err[Fail] {
    val items: *Range = c.ranges.data;
    val count: usize  = vector.length[Range](?c.ranges);
    var at:    u64    = 0;
    var i:     usize  = 0;
    for (i <= count) {
        var stop: u64 = r.len::u64;
        if (i < count) { stop = items[i].start; }
        if (stop < at) {
            ret err[Fail].err{fail.at_offset(fail.in_file(fail.unsupported("parts of the blob overlap"), r.file), r.base + stop)};
        }
        var k: u64 = at;
        for (k < stop) {
            if (r.data[k::usize] != 0) {
                ret err[Fail].err{fail.at_offset(fail.in_file(fail.unsupported("blob holds bytes no field covers"), r.file), r.base + k)};
            }
            k = k + 1;
        }
        if (i < count) { at = items[i].end; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}
