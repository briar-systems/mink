# the kind of file a thin Mach-O model is
#
# one row per filetype, looked up by code. a row states its kind, or the flag
# that chooses between two, as MH_PIE makes an executable one its loader may
# place at any address. MH_FVMLIB, a fixed virtual memory library no
# toolchain has built since the 1990s, has no row and is refused.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.format.macho.model.model.MachO;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;

# a header flag that chooses the kind
# ---
# flag:  the flag
# set:   the kind when it is set
# clear: the kind when it is clear
rec Flagged {
    flag:  *Constant;
    set:   *Kind;
    clear: *Kind;
}

# how a row decides the kind
# ---
# fixed:   the filetype alone
# flagged: a header flag
tag Decides: u8 {
    fixed:   *Kind;
    flagged: Flagged;
}

# code:    the filetype
# decides: how the kind of a file of that filetype is decided
rec FileType {
    code:    *Constant;
    decides: Decides;
}

val OBJECT:      FileType = FileType{code: ?tables.MH_OBJECT, decides: Decides.fixed{?kind.RELOCATABLE}};
val EXECUTE:     FileType = FileType{code: ?tables.MH_EXECUTE, decides: Decides.flagged{Flagged{flag: ?tables.MH_PIE, set: ?kind.PIE, clear: ?kind.EXECUTABLE}}};
val CORE:        FileType = FileType{code: ?tables.MH_CORE, decides: Decides.fixed{?kind.CORE}};
val PRELOAD:     FileType = FileType{code: ?tables.MH_PRELOAD, decides: Decides.fixed{?kind.EXECUTABLE}};
val DYLIB:       FileType = FileType{code: ?tables.MH_DYLIB, decides: Decides.fixed{?kind.SHARED}};
val DYLINKER:    FileType = FileType{code: ?tables.MH_DYLINKER, decides: Decides.fixed{?kind.INTERPRETER}};
val BUNDLE:      FileType = FileType{code: ?tables.MH_BUNDLE, decides: Decides.fixed{?kind.BUNDLE}};
val DYLIB_STUB:  FileType = FileType{code: ?tables.MH_DYLIB_STUB, decides: Decides.fixed{?kind.STUB}};
val DSYM:        FileType = FileType{code: ?tables.MH_DSYM, decides: Decides.fixed{?kind.DEBUG}};
val KEXT_BUNDLE: FileType = FileType{code: ?tables.MH_KEXT_BUNDLE, decides: Decides.fixed{?kind.BUNDLE}};
val FILESET:     FileType = FileType{code: ?tables.MH_FILESET, decides: Decides.fixed{?kind.FILESET}};
val GPU_EXECUTE: FileType = FileType{code: ?tables.MH_GPU_EXECUTE, decides: Decides.fixed{?kind.EXECUTABLE}};
val GPU_DYLIB:   FileType = FileType{code: ?tables.MH_GPU_DYLIB, decides: Decides.fixed{?kind.SHARED}};

val ROW_COUNT: usize                = 13;
val ROWS:      [ROW_COUNT]*FileType = [ROW_COUNT]*FileType{
    ?OBJECT, ?EXECUTE, ?CORE, ?PRELOAD, ?DYLIB, ?DYLINKER, ?BUNDLE,
    ?DYLIB_STUB, ?DSYM, ?KEXT_BUNDLE, ?FILESET, ?GPU_EXECUTE, ?GPU_DYLIB,
};

# the rows ascending by code
val CODES: [ROW_COUNT]*FileType = [ROW_COUNT]*FileType{
    ?OBJECT, ?EXECUTE, ?CORE, ?PRELOAD, ?DYLIB, ?DYLINKER, ?BUNDLE,
    ?DYLIB_STUB, ?DSYM, ?KEXT_BUNDLE, ?FILESET, ?GPU_EXECUTE, ?GPU_DYLIB,
};

# the filetypes refused as having no kind
val REFUSED_COUNT: usize                    = 1;
val REFUSED:       [REFUSED_COUNT]*Constant = [REFUSED_COUNT]*Constant{?tables.MH_FVMLIB};

fun order_codes(a: **FileType, b: **FileType) i64 {
    val x: u64 = a[0].code.value;
    val y: u64 = b[0].code.value;
    if (x < y) { ret -1; }
    if (x > y) { ret 1; }
    ret 0;
}

fun row_of(code: u64) opt[*FileType] {
    var c:     Constant = Constant{value: code};
    var probe: FileType = FileType{code: ?c};
    ret index.find[FileType](?CODES[0], ROW_COUNT, ?probe, order_codes);
}

pub fun of(m: *MachO) res[*Kind, Fail] {
    val row: opt[*FileType] = row_of(m.header.filetype::u64);
    if (sel row.none) {
        ret res[*Kind, Fail].err{fail.valued(fail.in_record(fail.unsupported("no kind of file has this filetype"), "mach header"), m.header.filetype::i128)};
    }
    val d: Decides = row.some.decides;
    if (sel d.fixed) { ret res[*Kind, Fail].ok{d.fixed}; }
    or (sel d.flagged) {
        if ((m.header.flags::u64 & d.flagged.flag.value) != 0) { ret res[*Kind, Fail].ok{d.flagged.set}; }
        ret res[*Kind, Fail].ok{d.flagged.clear};
    }
}

test kind__every_filetype_has_one_row_or_is_refused {
    val rows:  [ROW_COUNT]*FileType = ROWS;
    val built: err[Fail]            = index.verify[FileType](?CODES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_codes);
    if (sel built.err) { ret 1; }
    var i: usize = 0;
    for (i < tables.MH_FILETYPE.count) {
        val code:    *Constant      = tables.MH_FILETYPE.rows[i];
        val row:     opt[*FileType] = row_of(code.value);
        var refused: usize          = 0;
        var k:       usize          = 0;
        for (k < REFUSED_COUNT) {
            if (REFUSED[k] == code) { refused = refused + 1; }
            k = k + 1;
        }
        if (sel row.some) {
            if (row.some.code != code || refused != 0) { ret 2; }
        }
        or (refused != 1) {
            ret 3;
        }
        i = i + 1;
    }
    var m: MachO;
    m.header.filetype = tables.MH_EXECUTE.value::u32;
    m.header.flags    = tables.MH_PIE.value::u32;
    val pie: res[*Kind, Fail] = of(?m);
    if (!sel pie.ok)         { ret 4; }
    if (pie.ok != ?kind.PIE) { ret 4; }
    m.header.flags = 0;
    val exe: res[*Kind, Fail] = of(?m);
    if (!sel exe.ok)                { ret 5; }
    if (exe.ok != ?kind.EXECUTABLE) { ret 5; }
    m.header.filetype = tables.MH_FVMLIB.value::u32;
    val fvm: res[*Kind, Fail] = of(?m);
    if (!sel fvm.err)                   { ret 6; }
    if (!sel fvm.err.cause.unsupported) { ret 6; }
    ret 0;
}
