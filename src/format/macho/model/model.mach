# the Mach-O model, every byte of a thin Mach-O file
#
# one model serves both widths and both byte orders. a Shape names the class,
# whose rows give the size of every record whose shape follows the width and
# the place of each field, and the byte order. every field is held as its raw
# number, so a value the tables do not name is kept as it was. what the
# numbers mean is the tables', never the model's.
#
# the file is a header, its load commands and an ordered list of extents
# tiling the rest: a section's bytes, a section's relocations, a link-edit
# blob or raw bytes no record covers, such as the padding after the load
# commands and the gaps in __LINKEDIT. a load command is a typed record over
# its fixed fields, and the bytes after them up to cmdsize, its strings,
# trailing data and padding, are held as they were. a segment owns its
# sections. a link-edit blob is the data one field pair of a load command
# names, decoded into typed records, with the bytes inside it no record
# covers held as gaps, so a writer gives back every input byte for byte.
#
# fixups are held as their bytes in the segment they patch. the chained
# pointer formats and the chained import formats are data, a row per format,
# and every chained pointer decodes through its format's row.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Raw;
use mink.base.store.Store;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.BIG;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Order;
use mink.bytes.slot.Slot;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;

# mach_header and mach_header_64. a 32-bit header has no reserved field
pub rec HeaderShape {
    size:       usize;
    magic:      Slot;
    cputype:    Slot;
    cpusubtype: Slot;
    filetype:   Slot;
    ncmds:      Slot;
    sizeofcmds: Slot;
    flags:      Slot;
    reserved:   Slot;
}

# segment_command and segment_command_64
pub rec SegmentShape {
    size:     usize;
    cmd:      Slot;
    cmdsize:  Slot;
    segname:  Slot;
    vmaddr:   Slot;
    vmsize:   Slot;
    fileoff:  Slot;
    filesize: Slot;
    maxprot:  Slot;
    initprot: Slot;
    nsects:   Slot;
    flags:    Slot;
}

# section and section_64. a 32-bit section has no reserved3 field
pub rec SectionShape {
    size:      usize;
    sectname:  Slot;
    segname:   Slot;
    addr:      Slot;
    length:    Slot;
    offset:    Slot;
    align:     Slot;
    reloff:    Slot;
    nreloc:    Slot;
    flags:     Slot;
    reserved1: Slot;
    reserved2: Slot;
    reserved3: Slot;
}

# nlist and nlist_64
pub rec SymbolShape {
    size:  usize;
    strx:  Slot;
    type:  Slot;
    sect:  Slot;
    desc:  Slot;
    value: Slot;
}

# routines_command and routines_command_64, the first reserved field and the
# stride to the next
pub rec RoutinesShape {
    size:         usize;
    init_address: Slot;
    init_module:  Slot;
    reserved:     Slot;
}

# dylib_module and dylib_module_64, whose Objective-C fields trade places
pub rec ModuleShape {
    size:        usize;
    module_name: Slot;
    iextdefsym:  Slot;
    nextdefsym:  Slot;
    irefsym:     Slot;
    nrefsym:     Slot;
    ilocalsym:   Slot;
    nlocalsym:   Slot;
    iextrel:     Slot;
    nextrel:     Slot;
    iinit_iterm: Slot;
    ninit_nterm: Slot;
    objc_addr:   Slot;
    objc_size:   Slot;
}

# an entry of __LD,__compact_unwind
pub rec UnwindShape {
    size:        usize;
    start:       Slot;
    length:      Slot;
    encoding:    Slot;
    personality: Slot;
    lsda:        Slot;
}

# a thread local variable descriptor of an S_THREAD_LOCAL_VARIABLES section
pub rec TlvShape {
    size:   usize;
    thunk:  Slot;
    key:    Slot;
    offset: Slot;
}

# one file width: the width of an address and the shape of every record
# whose shape follows the width
pub rec Class {
    addr:     usize;
    header:   HeaderShape;
    segment:  SegmentShape;
    section:  SectionShape;
    symbol:   SymbolShape;
    routines: RoutinesShape;
    module:   ModuleShape;
    unwind:   UnwindShape;
    tlv:      TlvShape;
}

# a file's width and byte order
pub rec Shape {
    class: *Class;
    order: Order;
}

