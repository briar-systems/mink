    starts_count:   u32;
    starts:         Table[u32];
}

# what a section's bytes hold
# ---
# empty:        no bytes in the file, as for a zerofill section
# raw:          bytes no typed body decodes, and why
# tlv:          thread local variable descriptors
# unwind:       compact unwind entries
# info:         the unwind info table
# chain_starts: the chain starts of a firmware image
pub tag Body: u8 {
    empty;
    raw:          Raw;
    tlv:          Table[Tlv];
    unwind:       Table[Unwind];
    info:         UnwindInfo;
    chain_starts: ChainStarts;
}

# an entry of the first-level index: the first function a page covers, where
# the page lies, and where its language specific data entries start
pub rec UnwindIndex {
    function: u32;
    page:     u32;
    lsda:     u32;
}

# a function and the language specific data area its unwinding uses
pub rec UnwindLsda {
    function: u32;
    lsda:     u32;
}

# a function and its encoding
pub rec UnwindEntry {
    function: u32;
    encoding: u32;
}

# a regular second-level page
# ---
# entry_offset: where the entries lie in the page
# entries:      a function and its encoding each
pub rec UnwindRegular {
    entry_offset: u16;
    entries:      Table[UnwindEntry];
}

# a compressed second-level page. an entry holds the function's offset from
# the first function of the page, and the index of its encoding, which counts
# the common encodings first and the page's own after them
# ---
# entry_offset:     where the entries lie in the page
# encodings_offset: where the page's own encodings lie in the page
# entries:          the packed entries
# encodings:        the page's own encodings
pub rec UnwindCompressed {
    entry_offset:     u16;
    encodings_offset: u16;
    entries:          Table[u32];
    encodings:        Table[u32];
}

pub tag UnwindPage: u8 {
    regular:    UnwindRegular;
    compressed: UnwindCompressed;
}

# the __unwind_info section
# ---
# version:            the table's version
# common_offset:      where the common encodings lie
# personality_offset: where the personalities lie
# index_offset:       where the first-level index lies
# size:               the section's size, the last page's padding included
# common:             the encodings most functions share
# personalities:      the personality routines, as offsets of their pointers
# index:              the first-level index, ended by an entry for the end of the code
# lsdas:              the language specific data entries
# pages:              the second-level pages, one for each index entry that names one
pub rec UnwindInfo {
    version:            u32;
    common_offset:      u32;
    personality_offset: u32;
    index_offset:       u32;
    size:               u32;
    common:             Table[u32];
    personalities:      Table[u32];
    index:              Table[UnwindIndex];
    lsdas:              Table[UnwindLsda];
    pages:              Table[UnwindPage];
}

# a section and section_64 record, its relocations and what its bytes hold.
