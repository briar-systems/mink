# symseg:    LC_SYMSEG offset and size
pub tag Part: u8 {
    symbols;
    strings;
    toc;
    modules;
    refs;
    indirect;
    extrel;
    locrel;
    hints;
    rebase;
    bind;
    weak_bind;
    lazy_bind;
    exports;
    data;
    note;
    symseg;
}

# what a blob holds
# ---
# raw:          bytes no typed body decodes, such as split info, and why
# strings:      the string table
# refs:         dylib_reference words, the symbol index below and flags above
# indirect:     symbol indexes, or the LOCAL and ABS markers
# relocs:       external or local relocations
# hints:        twolevel_hint words, the subimage below and the toc index above
# rebases:      the locations a rebase opcode stream rebases
# binds:        the locations a bind, weak bind or lazy bind opcode stream binds
# exports:      the export trie
# fixups:       chained fixups
# starts:       the function starts, as offsets from the start of __TEXT
# data_in_code: data in code entries
# signature:    the code signature
pub tag Data: u8 {
    raw:          Raw;
    symbols:      Table[Nlist];
    strings:      Held;
    toc:          Table[Toc];
    modules:      Table[Module];
    refs:         Table[u32];
    indirect:     Table[u32];
    relocs:       Table[Reloc];
    hints:        Table[u32];
    rebases:      Table[Rebase];
    binds:        Binds;
    exports:      Trie;
    fixups:       Chained;
    starts:       Table[u64];
    data_in_code: Table[DataInCode];
    signature:    Signature;
}

# bytes inside a blob no record covers, at `at` bytes into the blob
pub rec Gap {
    at:    u64;
    bytes: Held;
}

# the data one field pair of a load command names
pub rec Blob {
    command: Id[Command];
    part:    Part;
    data:    Data;
    gaps:    Table[Gap];
}

# one extent of the file after its load commands, in file order
# ---
# section: a section's bytes
# relocs:  a section's relocations
# blob:    a link-edit blob
# raw:     bytes no record covers
pub tag Extent: u8 {
    section: SectionRef;
    relocs:  SectionRef;
    blob:    Id[Blob];
    raw:     Held;
}

# the library an ordinal names in a two-level namespace
# ---
# own:   the image itself
# main:  the main executable
# flat:  a flat namespace lookup
# weak:  a weak definition lookup
# dylib: the dylib load command
pub tag Library: u8 {
    own;
    main;
    flat;
    weak;
    dylib: Id[Command];
}

# a whole thin Mach-O file
# ---
# a:        the allocator every table lives in
# shape:    its width and byte order
# header:   the file header
# commands: the load commands, in command order
# blobs:    the link-edit blobs
# extents:  the file after its load commands, in file order
# store:    the bytes the model owns
pub rec MachO {
    a:        *A.Allocator;
    shape:    Shape;
    header:   Header;
    commands: Table[Command];
    blobs:    Table[Blob];
    extents:  Table[Extent];
    store:    Store;
}

# the record sizes of the tables a link-edit part names
pub val WORD_SIZE:  u64 = 4;
pub val TOC_SIZE:   u64 = 8;
pub val RELOC_SIZE: u64 = 8;

# a span of the file: where it starts and how many bytes it holds
pub rec Span {
    offset: u64;
    size:   u64;
}

# the bytes of `count` records of `size` bytes, from `offset`, refused when the
# product overflows, at `at`
pub fun counted(at: Location, offset: u64, count: u64, size: u64) res[Span, Fail] {
    val total: res[u64, Fail] = checked.mul(at, count, size);
    if (sel total.err) { ret res[Span, Fail].err{total.err}; }
    ret res[Span, Fail].ok{Span{offset: offset, size: total.ok}};
}

# the span of the table link-edit part `p` of load command `c` names, the one
# owner of how a part's span is computed from its command
pub fun part_span(cls: *Class, c: *Command, p: Part, at: Location) res[Span, Fail] {
    if (sel p.symbols) {
        if (sel c.body.symtab) { ret counted(at, c.body.symtab.symoff::u64, c.body.symtab.nsyms::u64, cls.symbol.size::u64); }
    }
    if (sel p.strings) {
        if (sel c.body.symtab) { ret counted(at, c.body.symtab.stroff::u64, c.body.symtab.strsize::u64, 1); }
    }
    if (sel p.toc) {
        if (sel c.body.dysymtab) { ret counted(at, c.body.dysymtab.tocoff::u64, c.body.dysymtab.ntoc::u64, TOC_SIZE); }
    }
    if (sel p.modules) {
        if (sel c.body.dysymtab) { ret counted(at, c.body.dysymtab.modtaboff::u64, c.body.dysymtab.nmodtab::u64, cls.module.size::u64); }
    }
    if (sel p.refs) {
        if (sel c.body.dysymtab) { ret counted(at, c.body.dysymtab.extrefsymoff::u64, c.body.dysymtab.nextrefsyms::u64, WORD_SIZE); }
    }
    if (sel p.indirect) {
        if (sel c.body.dysymtab) { ret counted(at, c.body.dysymtab.indirectsymoff::u64, c.body.dysymtab.nindirectsyms::u64, WORD_SIZE); }
    }
    if (sel p.extrel) {
        if (sel c.body.dysymtab) { ret counted(at, c.body.dysymtab.extreloff::u64, c.body.dysymtab.nextrel::u64, RELOC_SIZE); }
    }
    if (sel p.locrel) {
        if (sel c.body.dysymtab) { ret counted(at, c.body.dysymtab.locreloff::u64, c.body.dysymtab.nlocrel::u64, RELOC_SIZE); }
    }
    if (sel p.hints) {
        if (sel c.body.hints) { ret counted(at, c.body.hints.offset::u64, c.body.hints.nhints::u64, WORD_SIZE); }
    }
    if (sel p.rebase) {
        if (sel c.body.dyld_info) { ret counted(at, c.body.dyld_info.rebase_off::u64, c.body.dyld_info.rebase_size::u64, 1); }
    }
    if (sel p.bind) {
        if (sel c.body.dyld_info) { ret counted(at, c.body.dyld_info.bind_off::u64, c.body.dyld_info.bind_size::u64, 1); }
    }
    if (sel p.weak_bind) {
        if (sel c.body.dyld_info) { ret counted(at, c.body.dyld_info.weak_bind_off::u64, c.body.dyld_info.weak_bind_size::u64, 1); }
    }
    if (sel p.lazy_bind) {
        if (sel c.body.dyld_info) { ret counted(at, c.body.dyld_info.lazy_bind_off::u64, c.body.dyld_info.lazy_bind_size::u64, 1); }
    }
    if (sel p.exports) {
        if (sel c.body.dyld_info) { ret counted(at, c.body.dyld_info.export_off::u64, c.body.dyld_info.export_size::u64, 1); }
    }
    if (sel p.data) {
        if (sel c.body.linkedit) { ret counted(at, c.body.linkedit.dataoff::u64, c.body.linkedit.datasize::u64, 1); }
    }
    if (sel p.note) {
        if (sel c.body.note) { ret counted(at, c.body.note.offset, c.body.note.size, 1); }
    }
    if (sel p.symseg) {
        if (sel c.body.symseg) { ret counted(at, c.body.symseg.offset::u64, c.body.symseg.size::u64, 1); }
    }
    ret res[Span, Fail].err{fail.in_record(fail.malformed("load command holds no table of this part"), "load command")};
}

pub fun make(a: *A.Allocator, shape: Shape) MachO {
    ret MachO{
        a:        a,
        shape:    shape,
        commands: table.make[Command](a),
        blobs:    table.make[Blob](a),
        extents:  table.make[Extent](a),
        store:    store.make(a),
    };
}

# give everything the model owns back, reporting the first refusal
pub fun release(m: *MachO) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[Command](?m.commands)) {
        first = kept(first, release_load(?command_at(m, table.nth[Command](i)).body));
        i     = i + 1;
    }
    i = 0;
    for (i < table.count[Blob](?m.blobs)) {
        val b: *Blob = blob_at(m, table.nth[Blob](i));
        first = kept(first, release_data(?b.data));
        first = kept(first, table.release[Gap](?b.gaps));
        i     = i + 1;
    }
    first = kept(first, table.release[Command](?m.commands));
    first = kept(first, table.release[Blob](?m.blobs));
    first = kept(first, table.release[Extent](?m.extents));
    ret kept(first, store.release(?m.store));
}

# a copy of the `n` bytes at `p` the model owns
pub fun own(m: *MachO, p: *u8, n: usize) res[Held, Fail] {
    ret store.own(?m.store, p, n);
}

# the bytes of `h`. owned bytes stay valid until the model next owns bytes
pub fun bytes(m: *MachO, h: *Held) Bytes {
    ret store.bytes(?m.store, h);
}

pub fun command_at(m: *MachO, id: Id[Command]) *Command {
    ret table.at[Command](?m.commands, id);
}

pub fun blob_at(m: *MachO, id: Id[Blob]) *Blob {
    ret table.at[Blob](?m.blobs, id);
}

# the segment that owns the section `ref` names
pub fun segment_of(m: *MachO, ref: SectionRef) res[*Segment, Fail] {
    if (ref.command.index::usize >= table.count[Command](?m.commands)) {
        ret res[*Segment, Fail].err{fail.internal("section of a load command past its table")};
    }
    ret segment(m, ref.command);
}

# the section `ref` names, through the segment that owns it
pub fun section(m: *MachO, ref: SectionRef) res[*Section, Fail] {
    val seg: res[*Segment, Fail] = segment_of(m, ref);
    if (sel seg.err) { ret res[*Section, Fail].err{seg.err}; }
    if (ref.index::usize >= table.count[Section](?seg.ok.sections)) {
        ret res[*Section, Fail].err{fail.internal("section past its segment")};
    }
    ret res[*Section, Fail].ok{table.at[Section](?seg.ok.sections, table.nth[Section](ref.index::usize))};
}

# the section a symbol's n_sect or a relocation's section ordinal names,
# counting from one over every segment in command order
pub fun section_by_ordinal(m: *MachO, ordinal: u32) res[SectionRef, Fail] {
    if (ordinal == tables.NO_SECT.value::u32) {
        ret res[SectionRef, Fail].err{fail.malformed("section ordinal names no section")};
    }
    var left: u32   = ordinal - 1;
    var i:    usize = 0;
    for (i < table.count[Command](?m.commands)) {
        val c: *Command = command_at(m, table.nth[Command](i));
        if (sel c.body.segment) {
            val n: usize = table.count[Section](?c.body.segment.sections);
            if (left::usize < n) {
                ret res[SectionRef, Fail].ok{SectionRef{command: table.nth[Command](i), index: left}};
            }
            left = left - n::u32;
        }
        i = i + 1;
    }
    ret res[SectionRef, Fail].err{fail.malformed("section ordinal past the last section")};
}

# the bytes of the lc_str at `name` in command `id`, up to its terminator.
# the string lies in the command's rest
pub fun string(m: *MachO, id: Id[Command], name: Name) res[Bytes, Fail] {
    val c:    *Command = command_at(m, id);
    val rest: Bytes    = bytes(m, ?c.rest);
    if (rest.len::u64 > c.cmdsize::u64) {
        ret res[Bytes, Fail].err{fail.internal("load command holds more than its size")};
    }
    val start: u64 = c.cmdsize::u64 - rest.len::u64;
    if (name.offset::u64 < start || name.offset::u64 >= c.cmdsize::u64) {
        ret res[Bytes, Fail].err{fail.in_record(fail.malformed("string lies outside its command"), "load command")};
    }
    val from: usize = (name.offset::u64 - start)::usize;
    var end:  usize = from;
    for (end < rest.len && rest.data[end] != 0) { end = end + 1; }
    ret res[Bytes, Fail].ok{Bytes{data: ?rest.data[from], len: end - from}};
}

# the library `ordinal` names, signed as a bind or chained import holds it
pub fun library(m: *MachO, ordinal: i64) res[Library, Fail] {
    if (ordinal == tables.BIND_SPECIAL_DYLIB_SELF.value:~i64)            { ret res[Library, Fail].ok{Library.own{}}; }
    if (ordinal == tables.BIND_SPECIAL_DYLIB_MAIN_EXECUTABLE.value:~i64) { ret res[Library, Fail].ok{Library.main{}}; }
    if (ordinal == tables.BIND_SPECIAL_DYLIB_FLAT_LOOKUP.value:~i64)     { ret res[Library, Fail].ok{Library.flat{}}; }
    if (ordinal == tables.BIND_SPECIAL_DYLIB_WEAK_LOOKUP.value:~i64)     { ret res[Library, Fail].ok{Library.weak{}}; }
    if (ordinal < 0)                                                     { ret res[Library, Fail].err{fail.malformed("library ordinal below the special ordinals")}; }
    var left: i64   = ordinal - 1;
    var i:    usize = 0;
    for (i < table.count[Command](?m.commands)) {
        val c: *Command = command_at(m, table.nth[Command](i));
        if ((sel c.body.dylib || sel c.body.dylib_use) && c.cmd != tables.LC_ID_DYLIB.value::u32) {
            if (left == 0) { ret res[Library, Fail].ok{Library.dylib{table.nth[Command](i)}}; }
            left = left - 1;
        }
        i = i + 1;
    }
    ret res[Library, Fail].err{fail.malformed("library ordinal past the loaded dylibs")};
}

# the library ordinal of an undefined symbol in a two-level namespace image,
# signed as `library` takes it
pub fun symbol_ordinal(n: *Nlist) i64 {
    val raw: u16 = (n.desc >> 8) & 0xff;
    if (raw == tables.EXECUTABLE_ORDINAL.value::u16)     { ret tables.BIND_SPECIAL_DYLIB_MAIN_EXECUTABLE.value:~i64; }
    if (raw == tables.DYNAMIC_LOOKUP_ORDINAL.value::u16) { ret tables.BIND_SPECIAL_DYLIB_FLAT_LOOKUP.value:~i64; }
    ret raw::i64;
}

# the library ordinal of chained import `imp` in format `f`, signed as
# `library` takes it
pub fun import_ordinal(f: *ImportFormat, imp: *Import) i64 {
    ret signed(imp.ordinal::u64, f.ordinal.width);
}

# the addend of chained import `imp` in format `f`
pub fun import_addend(f: *ImportFormat, imp: *Import) i64 {
    if (f.signed_addend) { ret signed(imp.addend, f.addend.width * 8); }
    ret imp.addend:~i64;
}

pub fun section_type(s: *Section) u32 {
    ret s.flags & tables.SECTION_TYPE.value::u32;
}

pub fun section_attributes(s: *Section) u32 {
    ret s.flags & tables.SECTION_ATTRIBUTES.value::u32;
}

# the cpu subtype without its capability bits
pub fun cpu_subtype(cpusubtype: u32) u32 {
    ret cpusubtype & ~(tables.CPU_SUBTYPE_MASK.value::u32);
}

# the capability bits of a cpu subtype
pub fun cpu_capabilities(cpusubtype: u32) u32 {
    ret cpusubtype & tables.CPU_SUBTYPE_MASK.value::u32;
}

# the stab bits of a symbol's type, nonzero for a debugging entry
pub fun stab(n: *Nlist) u8 {
    ret n.type & tables.N_STAB.value::u8;
}

pub fun private_external(n: *Nlist) bool {
    ret (n.type & tables.N_PEXT.value::u8) != 0;
}

# the type bits of a symbol's type, such as undefined or in a section
pub fun symbol_type(n: *Nlist) u8 {
    ret n.type & tables.N_TYPE.value::u8;
}

pub fun external(n: *Nlist) bool {
    ret (n.type & tables.N_EXT.value::u8) != 0;
}

pub fun weak_reference(n: *Nlist) bool {
    ret (n.desc & tables.N_WEAK_REF.value::u16) != 0;
}

pub fun weak_definition(n: *Nlist) bool {
    ret (n.desc & tables.N_WEAK_DEF.value::u16) != 0;
}

pub fun no_dead_strip(n: *Nlist) bool {
    ret (n.desc & tables.N_NO_DEAD_STRIP.value::u16) != 0;
}

pub fun alt_entry(n: *Nlist) bool {
    ret (n.desc & tables.N_ALT_ENTRY.value::u16) != 0;
}

# whether an indirect symbol entry is the LOCAL marker, alone or with ABS
pub fun indirect_local(v: u32) bool {
    ret (v & tables.INDIRECT_SYMBOL_LOCAL.value::u32) != 0;
}

# whether an indirect symbol entry is the ABS marker, alone or with LOCAL
pub fun indirect_absolute(v: u32) bool {
    ret (v & tables.INDIRECT_SYMBOL_ABS.value::u32) != 0;
}

pub fun segment(m: *MachO, id: Id[Command]) res[*Segment, Fail] {
    val c: *Command = command_at(m, id);
    if (sel c.body.segment) { ret res[*Segment, Fail].ok{?c.body.segment}; }
    ret res[*Segment, Fail].err{not_a("load command is no segment")};
}

