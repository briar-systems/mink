# which field pair of its load command a blob is the data of
# ---
# symbols:   LC_SYMTAB symoff and nsyms
# strings:   LC_SYMTAB stroff and strsize
# toc:       LC_DYSYMTAB tocoff and ntoc
# modules:   LC_DYSYMTAB modtaboff and nmodtab
# refs:      LC_DYSYMTAB extrefsymoff and nextrefsyms
# indirect:  LC_DYSYMTAB indirectsymoff and nindirectsyms
# extrel:    LC_DYSYMTAB extreloff and nextrel
# locrel:    LC_DYSYMTAB locreloff and nlocrel
# hints:     LC_TWOLEVEL_HINTS offset and nhints
# rebase:    LC_DYLD_INFO rebase_off and rebase_size
# bind:      LC_DYLD_INFO bind_off and bind_size
# weak_bind: LC_DYLD_INFO weak_bind_off and weak_bind_size
# lazy_bind: LC_DYLD_INFO lazy_bind_off and lazy_bind_size
