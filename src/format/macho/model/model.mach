# a bitfield of a packed word, counted from its least significant bit. a
# width of zero is a field the word does not have
pub rec Bits {
    shift: u8;
    width: u8;
}

# the bitfields of one form of a chained pointer
pub rec Layout {
    target:      Bits;
    high8:       Bits;
    ordinal:     Bits;
    addend:      Bits;
    diversity:   Bits;
    addr_div:    Bits;
    key:         Bits;
    cache_level: Bits;
    seg_index:   Bits;
    next:        Bits;
}

# what a chained rebase target counts from
# ---
# vmaddr:    an address
# offset:    an offset from the image's base
# segmented: an offset into the segment seg_index names
pub tag Target: u8 {
    vmaddr;
    offset;
    segmented;
}

# a chained pointer format: the width of its pointers, the stride its next
# field counts in, the bits that select its form and the layout of each form.
# a format with no bind bit binds nothing, and one with no auth bit
# authenticates nothing
# ---
# code:          the row of the format's DYLD_CHAINED_PTR_* value
# size:          the width of a pointer in bytes
# stride:        the bytes one step of next covers
# target:        what an unauthenticated rebase target counts from
# signed_addend: whether a bind's addend is signed
pub rec PointerFormat {
    code:          *Constant;
    size:          u8;
    stride:        u8;
    target:        Target;
    signed_addend: bool;
    bind:          Bits;
    auth:          Bits;
    rebase:        Layout;
    bound:         Layout;
    auth_rebase:   Layout;
    auth_bound:    Layout;
}

pub tag Form: u8 {
    rebase;
    bind;
    auth_rebase;
    auth_bind;
}

# a chained pointer decoded through its format. a field its form does not
# have is zero
pub rec Pointer {
    form:        Form;
    target:      u64;
    high8:       u64;
    ordinal:     u64;
    addend:      i64;
    diversity:   u64;
    addr_div:    u64;
    key:         u64;
    cache_level: u64;
    seg_index:   u64;
    next:        u64;
}

val NO_LAYOUT:             Layout = Layout{};
val ARM64E_REBASE:         Layout = Layout{target: Bits{shift: 0, width: 43}, high8: Bits{shift: 43, width: 8}, next: Bits{shift: 51, width: 11}};
val ARM64E_BIND:           Layout = Layout{ordinal: Bits{shift: 0, width: 16}, addend: Bits{shift: 32, width: 19}, next: Bits{shift: 51, width: 11}};
val ARM64E_BIND24:         Layout = Layout{ordinal: Bits{shift: 0, width: 24}, addend: Bits{shift: 32, width: 19}, next: Bits{shift: 51, width: 11}};
val ARM64E_AUTH_REBASE:    Layout = Layout{target: Bits{shift: 0, width: 32}, diversity: Bits{shift: 32, width: 16}, addr_div: Bits{shift: 48, width: 1}, key: Bits{shift: 49, width: 2}, next: Bits{shift: 51, width: 11}};
val ARM64E_AUTH_BIND:      Layout = Layout{ordinal: Bits{shift: 0, width: 16}, diversity: Bits{shift: 32, width: 16}, addr_div: Bits{shift: 48, width: 1}, key: Bits{shift: 49, width: 2}, next: Bits{shift: 51, width: 11}};
val ARM64E_AUTH_BIND24:    Layout = Layout{ordinal: Bits{shift: 0, width: 24}, diversity: Bits{shift: 32, width: 16}, addr_div: Bits{shift: 48, width: 1}, key: Bits{shift: 49, width: 2}, next: Bits{shift: 51, width: 11}};
val PTR64_REBASE:          Layout = Layout{target: Bits{shift: 0, width: 36}, high8: Bits{shift: 36, width: 8}, next: Bits{shift: 51, width: 12}};
val PTR64_BIND:            Layout = Layout{ordinal: Bits{shift: 0, width: 24}, addend: Bits{shift: 24, width: 8}, next: Bits{shift: 51, width: 12}};
val KERNEL_CACHE_REBASE:   Layout = Layout{target: Bits{shift: 0, width: 30}, cache_level: Bits{shift: 30, width: 2}, diversity: Bits{shift: 32, width: 16}, addr_div: Bits{shift: 48, width: 1}, key: Bits{shift: 49, width: 2}, next: Bits{shift: 51, width: 12}};
val PTR32_REBASE:          Layout = Layout{target: Bits{shift: 0, width: 26}, next: Bits{shift: 26, width: 5}};
val PTR32_BIND:            Layout = Layout{ordinal: Bits{shift: 0, width: 20}, addend: Bits{shift: 20, width: 6}, next: Bits{shift: 26, width: 5}};
val PTR32_CACHE_REBASE:    Layout = Layout{target: Bits{shift: 0, width: 30}, next: Bits{shift: 30, width: 2}};
val PTR32_FIRMWARE_REBASE: Layout = Layout{target: Bits{shift: 0, width: 26}, next: Bits{shift: 26, width: 6}};
val SHARED_CACHE_REBASE:   Layout = Layout{target: Bits{shift: 0, width: 34}, high8: Bits{shift: 34, width: 8}, next: Bits{shift: 52, width: 11}};
val SHARED_CACHE_AUTH:     Layout = Layout{target: Bits{shift: 0, width: 34}, diversity: Bits{shift: 34, width: 16}, addr_div: Bits{shift: 50, width: 1}, key: Bits{shift: 51, width: 1}, next: Bits{shift: 52, width: 11}};
val SEGMENTED_REBASE:      Layout = Layout{target: Bits{shift: 0, width: 28}, seg_index: Bits{shift: 28, width: 4}, next: Bits{shift: 51, width: 12}};
val SEGMENTED_AUTH:        Layout = Layout{target: Bits{shift: 0, width: 28}, seg_index: Bits{shift: 28, width: 4}, diversity: Bits{shift: 32, width: 16}, addr_div: Bits{shift: 48, width: 1}, key: Bits{shift: 49, width: 2}, next: Bits{shift: 51, width: 12}};

val NO_BIT: Bits = Bits{};
val BIT_31: Bits = Bits{shift: 31, width: 1};
val BIT_62: Bits = Bits{shift: 62, width: 1};
val BIT_63: Bits = Bits{shift: 63, width: 1};

pub val POINTER_FORMAT_COUNT: usize = 14;

# every chained pointer format fixup-chains.h defines. ARM64E_OFFSET is the
# old name of ARM64E_KERNEL
pub val POINTER_FORMATS: [POINTER_FORMAT_COUNT]PointerFormat = [POINTER_FORMAT_COUNT]PointerFormat{
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_ARM64E, size: 8, stride: 8, target: Target.vmaddr{}, signed_addend: true, bind: BIT_62, auth: BIT_63, rebase: ARM64E_REBASE, bound: ARM64E_BIND, auth_rebase: ARM64E_AUTH_REBASE, auth_bound: ARM64E_AUTH_BIND},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_64, size: 8, stride: 4, target: Target.vmaddr{}, signed_addend: false, bind: BIT_63, auth: NO_BIT, rebase: PTR64_REBASE, bound: PTR64_BIND, auth_rebase: NO_LAYOUT, auth_bound: NO_LAYOUT},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_32, size: 4, stride: 4, target: Target.vmaddr{}, signed_addend: false, bind: BIT_31, auth: NO_BIT, rebase: PTR32_REBASE, bound: PTR32_BIND, auth_rebase: NO_LAYOUT, auth_bound: NO_LAYOUT},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_32_CACHE, size: 4, stride: 4, target: Target.offset{}, signed_addend: false, bind: NO_BIT, auth: NO_BIT, rebase: PTR32_CACHE_REBASE, bound: NO_LAYOUT, auth_rebase: NO_LAYOUT, auth_bound: NO_LAYOUT},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_32_FIRMWARE, size: 4, stride: 4, target: Target.vmaddr{}, signed_addend: false, bind: NO_BIT, auth: NO_BIT, rebase: PTR32_FIRMWARE_REBASE, bound: NO_LAYOUT, auth_rebase: NO_LAYOUT, auth_bound: NO_LAYOUT},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_64_OFFSET, size: 8, stride: 4, target: Target.offset{}, signed_addend: false, bind: BIT_63, auth: NO_BIT, rebase: PTR64_REBASE, bound: PTR64_BIND, auth_rebase: NO_LAYOUT, auth_bound: NO_LAYOUT},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_ARM64E_KERNEL, size: 8, stride: 4, target: Target.offset{}, signed_addend: true, bind: BIT_62, auth: BIT_63, rebase: ARM64E_REBASE, bound: ARM64E_BIND, auth_rebase: ARM64E_AUTH_REBASE, auth_bound: ARM64E_AUTH_BIND},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_64_KERNEL_CACHE, size: 8, stride: 4, target: Target.offset{}, signed_addend: false, bind: NO_BIT, auth: BIT_63, rebase: KERNEL_CACHE_REBASE, bound: NO_LAYOUT, auth_rebase: KERNEL_CACHE_REBASE, auth_bound: NO_LAYOUT},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_ARM64E_USERLAND, size: 8, stride: 8, target: Target.offset{}, signed_addend: true, bind: BIT_62, auth: BIT_63, rebase: ARM64E_REBASE, bound: ARM64E_BIND, auth_rebase: ARM64E_AUTH_REBASE, auth_bound: ARM64E_AUTH_BIND},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_ARM64E_FIRMWARE, size: 8, stride: 4, target: Target.vmaddr{}, signed_addend: true, bind: BIT_62, auth: BIT_63, rebase: ARM64E_REBASE, bound: ARM64E_BIND, auth_rebase: ARM64E_AUTH_REBASE, auth_bound: ARM64E_AUTH_BIND},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_X86_64_KERNEL_CACHE, size: 8, stride: 1, target: Target.offset{}, signed_addend: false, bind: NO_BIT, auth: BIT_63, rebase: KERNEL_CACHE_REBASE, bound: NO_LAYOUT, auth_rebase: KERNEL_CACHE_REBASE, auth_bound: NO_LAYOUT},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_ARM64E_USERLAND24, size: 8, stride: 8, target: Target.offset{}, signed_addend: true, bind: BIT_62, auth: BIT_63, rebase: ARM64E_REBASE, bound: ARM64E_BIND24, auth_rebase: ARM64E_AUTH_REBASE, auth_bound: ARM64E_AUTH_BIND24},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_ARM64E_SHARED_CACHE, size: 8, stride: 8, target: Target.offset{}, signed_addend: false, bind: NO_BIT, auth: BIT_63, rebase: SHARED_CACHE_REBASE, bound: NO_LAYOUT, auth_rebase: SHARED_CACHE_AUTH, auth_bound: NO_LAYOUT},
    PointerFormat{code: ?tables.DYLD_CHAINED_PTR_ARM64E_SEGMENTED, size: 8, stride: 4, target: Target.segmented{}, signed_addend: false, bind: NO_BIT, auth: BIT_63, rebase: SEGMENTED_REBASE, bound: NO_LAYOUT, auth_rebase: SEGMENTED_AUTH, auth_bound: NO_LAYOUT},
};

# a chained import format: the width of a record, the bitfields of its first
# word and where its addend lies
# ---
# code:          the row of the format's DYLD_CHAINED_IMPORT* value
# size:          the width of a record in bytes
# word:          the width of the packed word the bitfields lie in
# signed_addend: whether the addend is signed
pub rec ImportFormat {
    code:          *Constant;
    size:          u8;
    word:          u8;
    ordinal:       Bits;
    weak:          Bits;
    name:          Bits;
    addend:        Slot;
    signed_addend: bool;
}

pub val IMPORT_FORMAT_COUNT: usize = 3;

pub val IMPORT_FORMATS: [IMPORT_FORMAT_COUNT]ImportFormat = [IMPORT_FORMAT_COUNT]ImportFormat{
    ImportFormat{code: ?tables.DYLD_CHAINED_IMPORT, size: 4, word: 4, ordinal: Bits{shift: 0, width: 8}, weak: Bits{shift: 8, width: 1}, name: Bits{shift: 9, width: 23}, addend: Slot{}, signed_addend: false},
    ImportFormat{code: ?tables.DYLD_CHAINED_IMPORT_ADDEND, size: 8, word: 4, ordinal: Bits{shift: 0, width: 8}, weak: Bits{shift: 8, width: 1}, name: Bits{shift: 9, width: 23}, addend: Slot{offset: 4, width: 4}, signed_addend: true},
    ImportFormat{code: ?tables.DYLD_CHAINED_IMPORT_ADDEND64, size: 16, word: 8, ordinal: Bits{shift: 0, width: 16}, weak: Bits{shift: 16, width: 1}, name: Bits{shift: 32, width: 32}, addend: Slot{offset: 8, width: 8}, signed_addend: false},
};

# the row of chained pointer format `code`
pub fun pointer_format(code: u16) res[*PointerFormat, Fail] {
    var i: usize = 0;
    for (i < POINTER_FORMAT_COUNT) {
        if (POINTER_FORMATS[i].code.value == code::u64) { ret res[*PointerFormat, Fail].ok{?POINTER_FORMATS[i]}; }
        i = i + 1;
    }
    ret res[*PointerFormat, Fail].err{fail.unsupported("chained pointer format fixup-chains.h does not define")};
}

# the row of chained import format `code`
pub fun import_format(code: u32) res[*ImportFormat, Fail] {
    var i: usize = 0;
    for (i < IMPORT_FORMAT_COUNT) {
        if (IMPORT_FORMATS[i].code.value == code::u64) { ret res[*ImportFormat, Fail].ok{?IMPORT_FORMATS[i]}; }
        i = i + 1;
    }
    ret res[*ImportFormat, Fail].err{fail.unsupported("chained import format fixup-chains.h does not define")};
}

# the bitfield `b` of `word`
pub fun bits(word: u64, b: Bits) u64 {
    if (b.width == 0)  { ret 0; }
    if (b.width >= 64) { ret word >> b.shift::u64; }
    ret (word >> b.shift::u64) & ((1::u64 << b.width::u64) - 1);
}

# whether `v` fits the bitfield `b`
pub fun fits(v: u64, b: Bits) bool {
    if (b.width == 0)  { ret v == 0; }
    if (b.width >= 64) { ret true; }
    ret v < (1::u64 << b.width::u64);
}

# `word` with the bitfield `b` set to `v`, which must fit
pub fun deposit(word: u64, b: Bits, v: u64) u64 {
    if (b.width == 0) { ret word; }
    ret word | (v << b.shift::u64);
}

# the bitfields of a relocation_info word after r_address, which a producer
# lays out from the other end of the word when the file is big-endian
pub rec Packed {
    symbolnum: Bits;
    pcrel:     Bits;
    length:    Bits;
    external:  Bits;
    type:      Bits;
}

val PACKED_LITTLE: Packed = Packed{
    symbolnum: Bits{shift: 0, width: 24},
    pcrel:     Bits{shift: 24, width: 1},
    length:    Bits{shift: 25, width: 2},
    external:  Bits{shift: 27, width: 1},
    type:      Bits{shift: 28, width: 4},
};

val PACKED_BIG: Packed = Packed{
    symbolnum: Bits{shift: 8, width: 24},
    pcrel:     Bits{shift: 7, width: 1},
    length:    Bits{shift: 5, width: 2},
    external:  Bits{shift: 4, width: 1},
    type:      Bits{shift: 0, width: 4},
};

# the bitfields of the first word of a scattered_relocation_info
pub val SCATTER_ADDRESS: Bits = Bits{shift: 0, width: 24};
pub val SCATTER_TYPE:    Bits = Bits{shift: 24, width: 4};
pub val SCATTER_LENGTH:  Bits = Bits{shift: 28, width: 2};
pub val SCATTER_PCREL:   Bits = Bits{shift: 30, width: 1};

# the bitfields of a relocation_info word in `order`
pub fun packed(order: Order) *Packed {
    if (order == BIG) { ret ?PACKED_BIG; }
    ret ?PACKED_LITTLE;
}

# `v`, `width` bits wide, sign extended
pub fun signed(v: u64, width: u8) i64 {
    if (width == 0 || width >= 64) { ret v:~i64; }
    val sign: u64 = 1::u64 << (width - 1)::u64;
    ret ((v ^ sign) - sign):~i64;
}

# the chained pointer `raw` decoded through format `f`
pub fun decode(f: *PointerFormat, raw: u64) Pointer {
    val bound: bool    = bits(raw, f.bind) != 0;
    val auth:  bool    = bits(raw, f.auth) != 0;
    var l:     *Layout = ?f.rebase;
    var form:  Form    = Form.rebase{};
    if (auth && bound) {
        l    = ?f.auth_bound;
        form = Form.auth_bind{};
    }
    or (auth) {
        l    = ?f.auth_rebase;
        form = Form.auth_rebase{};
    }
    or (bound) {
        l    = ?f.bound;
        form = Form.bind{};
    }
    var addend: i64 = bits(raw, l.addend):~i64;
    if (f.signed_addend) { addend = signed(bits(raw, l.addend), l.addend.width); }
    ret Pointer{
        form:        form,
        target:      bits(raw, l.target),
        high8:       bits(raw, l.high8),
        ordinal:     bits(raw, l.ordinal),
        addend:      addend,
        diversity:   bits(raw, l.diversity),
        addr_div:    bits(raw, l.addr_div),
        key:         bits(raw, l.key),
        cache_level: bits(raw, l.cache_level),
        seg_index:   bits(raw, l.seg_index),
        next:        bits(raw, l.next),
    };
}

# the file header. a 32-bit header holds no reserved field
pub rec Header {
    magic:      u32;
    cputype:    u32;
    cpusubtype: u32;
    filetype:   u32;
    ncmds:      u32;
    sizeofcmds: u32;
    flags:      u32;
    reserved:   u32;
}

# a relocation_info entry. `address` is r_address, an offset into the
