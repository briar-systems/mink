    length:  u8;
    pcrel:   u8;
    value:   u32;
}

# a relocation entry, in table order. a pair, such as SUBTRACTOR followed by
# UNSIGNED or an ADDEND preceding the entry it modifies, is two entries in
# order, and the relocation tables say which types pair
pub tag Reloc: u8 {
    plain:     Plain;
    scattered: Scattered;
}

# a thread local variable descriptor
pub rec Tlv {
    thunk:  u64;
    key:    u64;
    offset: u64;
}

# an entry of __LD,__compact_unwind
