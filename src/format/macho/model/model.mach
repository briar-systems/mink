    ret res[*u32, Fail].err{not_a("load command is no linker option")};
}

pub fun note(m: *MachO, id: Id[Command]) res[*Note, Fail] {
    val c: *Command = command_at(m, id);
    if (sel c.body.note) { ret res[*Note, Fail].ok{?c.body.note}; }
    ret res[*Note, Fail].err{not_a("load command is no note")};
}

pub fun build_version(m: *MachO, id: Id[Command]) res[*BuildVersion, Fail] {
    val c: *Command = command_at(m, id);
    if (sel c.body.build_version) { ret res[*BuildVersion, Fail].ok{?c.body.build_version}; }
    ret res[*BuildVersion, Fail].err{not_a("load command is no build version")};
}

pub fun fileset_entry(m: *MachO, id: Id[Command]) res[*FilesetEntry, Fail] {
    val c: *Command = command_at(m, id);
    if (sel c.body.fileset_entry) { ret res[*FilesetEntry, Fail].ok{?c.body.fileset_entry}; }
    ret res[*FilesetEntry, Fail].err{not_a("load command is no fileset entry")};
}

pub fun target_triple(m: *MachO, id: Id[Command]) res[*Name, Fail] {
    val c: *Command = command_at(m, id);
    if (sel c.body.target_triple) { ret res[*Name, Fail].ok{?c.body.target_triple}; }
    ret res[*Name, Fail].err{not_a("load command is no target triple")};
}

fun not_a(text: *u8) Fail {
    ret fail.in_record(fail.internal(text), "load command");
}

fun release_section(s: *Section) err[Fail] {
    var first: err[Fail] = table.release[Reloc](?s.relocs);
    if (sel s.body.tlv)          { first = kept(first, table.release[Tlv](?s.body.tlv)); }
    if (sel s.body.unwind)       { first = kept(first, table.release[Unwind](?s.body.unwind)); }
    if (sel s.body.info)         { first = kept(first, release_unwind_info(?s.body.info)); }
    if (sel s.body.chain_starts) { first = kept(first, table.release[u32](?s.body.chain_starts.starts)); }
    ret first;
}

fun release_load(l: *Load) err[Fail] {
    if (sel l.segment) {
        var first: err[Fail] = err[Fail].ok{};
        var i:     usize     = 0;
        for (i < table.count[Section](?l.segment.sections)) {
            first = kept(first, release_section(table.at[Section](?l.segment.sections, table.nth[Section](i))));
            i     = i + 1;
        }
        ret kept(first, table.release[Section](?l.segment.sections));
    }
    if (sel l.thread)        { ret table.release[ThreadState](?l.thread.states); }
    if (sel l.build_version) { ret table.release[Tool](?l.build_version.tools); }
    ret err[Fail].ok{};
}

pub fun release_unwind_info(info: *UnwindInfo) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[UnwindPage](?info.pages)) {
        val p: *UnwindPage = table.at[UnwindPage](?info.pages, table.nth[UnwindPage](i));
        if (sel p.regular) {
            val x: err[Fail] = table.release[UnwindEntry](?p.regular.entries);
            if (sel x.err) { first = x; }
        }
        or (sel p.compressed) {
            val x: err[Fail] = table.release[u32](?p.compressed.entries);
            if (sel x.err) { first = x; }
            val y: err[Fail] = table.release[u32](?p.compressed.encodings);
            if (sel y.err) { first = y; }
        }
        i = i + 1;
    }
    val a: err[Fail] = table.release[UnwindPage](?info.pages);
    val b: err[Fail] = table.release[UnwindLsda](?info.lsdas);
    val c: err[Fail] = table.release[UnwindIndex](?info.index);
    val d: err[Fail] = table.release[u32](?info.personalities);
    val e: err[Fail] = table.release[u32](?info.common);
    if (sel first.err) { ret first; }
    if (sel a.err)     { ret a; }
    if (sel b.err)     { ret b; }
    if (sel c.err)     { ret c; }
    if (sel d.err)     { ret d; }
    ret e;
}

pub fun release_chained(c: *Chained) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[SegmentInfo](?c.segments)) {
        val s: *SegmentInfo = table.at[SegmentInfo](?c.segments, table.nth[SegmentInfo](i));
        if (sel s.starts.some) { first = kept(first, table.release[u16](?s.starts.some.page_starts)); }
        i = i + 1;
    }
    first = kept(first, table.release[SegmentInfo](?c.segments));
    ret kept(first, table.release[Import](?c.imports));
}

pub fun release_signature(s: *Signature) err[Fail] {
    var first: err[Fail] = table.release[BlobIndex](?s.index);
    var i:     usize     = 0;
    for (i < table.count[CsBlob](?s.blobs)) {
        val b: *CsBlob = table.at[CsBlob](?s.blobs, table.nth[CsBlob](i));
        if (sel b.body.directory) { first = kept(first, table.release[Scatter](?b.body.directory.scatter)); }
        if (sel b.body.requirements) {
            first = kept(first, table.release[BlobIndex](?b.body.requirements.index));
            first = kept(first, table.release[Held](?b.body.requirements.items));
        }
        i = i + 1;
    }
    first = kept(first, table.release[Gap](?s.gaps));
    ret kept(first, table.release[CsBlob](?s.blobs));
}

fun release_data(d: *Data) err[Fail] {
    if (sel d.symbols)      { ret table.release[Nlist](?d.symbols); }
    if (sel d.toc)          { ret table.release[Toc](?d.toc); }
    if (sel d.modules)      { ret table.release[Module](?d.modules); }
    if (sel d.refs)         { ret table.release[u32](?d.refs); }
    if (sel d.indirect)     { ret table.release[u32](?d.indirect); }
    if (sel d.relocs)       { ret table.release[Reloc](?d.relocs); }
    if (sel d.hints)        { ret table.release[u32](?d.hints); }
    if (sel d.rebases)      { ret table.release[Rebase](?d.rebases); }
    if (sel d.binds)        { ret table.release[Bind](?d.binds.entries); }
    if (sel d.exports)      { ret table.release[Export](?d.exports.exports); }
    if (sel d.fixups)       { ret release_chained(?d.fixups); }
    if (sel d.starts)       { ret table.release[u64](?d.starts); }
    if (sel d.data_in_code) { ret table.release[DataInCode](?d.data_in_code); }
    if (sel d.signature)    { ret release_signature(?d.signature); }
    ret err[Fail].ok{};
}

fun kept(first: err[Fail], next: err[Fail]) err[Fail] {
    if (sel first.err) { ret first; }
    ret next;
}

# a 16 byte segment or section name
fun name16(s: *u8) [16]u8 {
    var out: [16]u8;
    var i:   usize = 0;
    for (i < 16 && s[i] != 0) {
        out[i] = s[i];
        i      = i + 1;
    }
    ret out;
}

# a segment named `name` holding sections named by `sections`
fun segment_with(a: *A.Allocator, name: *u8, sections: **u8, n: usize) res[Command, Fail] {
    var seg: Segment = Segment{segname: name16(name), nsects: n::u32, sections: table.make[Section](a)};
    var i:   usize   = 0;
    for (i < n) {
        val s: res[Id[Section], Fail] = table.push[Section](?seg.sections, Section{sectname: name16(sections[i]), segname: name16(name), relocs: table.make[Reloc](a), body: Body.empty{}});
        if (sel s.err) { ret res[Command, Fail].err{s.err}; }
        i = i + 1;
    }
    ret res[Command, Fail].ok{Command{cmd: tables.LC_SEGMENT_64.value::u32, body: Load.segment{seg}}};
}

# whether the section is named `want` and lies in the segment `seg`
pub fun section_named(s: *Section, seg: *u8, want: *u8) bool {
    ret named(s.sectname, want) && named(s.segname, seg);
}

fun named(n: [16]u8, want: *u8) bool {
    val w: [16]u8 = name16(want);
    var i: usize  = 0;
    for (i < 16) {
        if (n[i] != w[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `ordinal` resolves to section `want` of segment `seg`
fun resolves(m: *MachO, ordinal: u32, seg: *u8, want: *u8) bool {
    val ref: res[SectionRef, Fail] = section_by_ordinal(m, ordinal);
    if (sel ref.err) { ret false; }
    val s:     res[*Section, Fail] = section(m, ref.ok);
    val owner: res[*Segment, Fail] = segment_of(m, ref.ok);
    if (sel s.err)     { ret false; }
    if (sel owner.err) { ret false; }
    ret named(s.ok.sectname, want) && named(owner.ok.segname, seg) && named(s.ok.segname, seg);
}

test model__section_resolves_through_its_segment {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var m:    MachO              = make(T.allocator_of(?t), Shape{class: ?CLASS64, order: LITTLE});
    val text: [3]*u8             = [3]*u8{"__text", "__stubs", "__cstring"};
    val data: [3]*u8             = [3]*u8{"__data", "__bss", nil};
    val a:    res[Command, Fail] = segment_with(m.a, "__TEXT", ?text[0], 3);
    val b:    res[Command, Fail] = segment_with(m.a, "__DATA", ?data[0], 2);
    if (sel a.err) { ret 1; }
    if (sel b.err) { ret 1; }
    val first: res[Id[Command], Fail] = table.push[Command](?m.commands, a.ok);
    val mid:   res[Id[Command], Fail] = table.push[Command](?m.commands, Command{cmd: tables.LC_SYMTAB.value::u32, body: Load.symtab{Symtab{nsyms: 4}}});
    val last:  res[Id[Command], Fail] = table.push[Command](?m.commands, b.ok);
    if (sel first.err)                           { ret 1; }
    if (sel mid.err)                             { ret 1; }
    if (sel last.err)                            { ret 1; }
    if (!resolves(?m, 1, "__TEXT", "__text"))    { ret 1; }
    if (!resolves(?m, 3, "__TEXT", "__cstring")) { ret 1; }
    if (!resolves(?m, 4, "__DATA", "__data"))    { ret 1; }
    if (!resolves(?m, 5, "__DATA", "__bss"))     { ret 1; }
    val none: res[SectionRef, Fail] = section_by_ordinal(?m, 0);
    val past: res[SectionRef, Fail] = section_by_ordinal(?m, 6);
    if (!sel none.err || !sel past.err) { ret 1; }
    val stray:  res[*Section, Fail] = section(?m, SectionRef{command: mid.ok, index: 0});
    val beyond: res[*Section, Fail] = section(?m, SectionRef{command: last.ok, index: 2});
    if (!sel stray.err || !sel beyond.err) { ret 1; }
    val r: err[Fail] = release(?m);
    if (sel r.err)             { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

val LOAD_KINDS: usize = 28;

# a bit for every accessor that returns the record of command `id` with its
# first field `mark`
fun accepted(m: *MachO, id: Id[Command], mark: u32) u64 {
    var got: u64                      = 0;
    val a0:  res[*Segment, Fail]      = segment(m, id);
    val a1:  res[*Symtab, Fail]       = symtab(m, id);
    val a2:  res[*Symseg, Fail]       = symseg(m, id);
    val a3:  res[*Thread, Fail]       = thread(m, id);
    val a4:  res[*Fvmlib, Fail]       = fvmlib(m, id);
    val a5:  res[*Fvmfile, Fail]      = fvmfile(m, id);
    val a6:  res[*Dysymtab, Fail]     = dysymtab(m, id);
    val a7:  res[*Dylib, Fail]        = dylib(m, id);
    val a8:  res[*DylibUse, Fail]     = dylib_use(m, id);
    val a9:  res[*Name, Fail]         = dylinker(m, id);
    val a10: res[*Prebound, Fail]     = prebound(m, id);
    val a11: res[*Routines, Fail]     = routines(m, id);
    val a12: res[*Name, Fail]         = sub(m, id);
    val a13: res[*Hints, Fail]        = hints(m, id);
    val a14: res[*u32, Fail]          = cksum(m, id);
    val a15: res[*[16]u8, Fail]       = uuid(m, id);
    val a16: res[*Name, Fail]         = rpath(m, id);
    val a17: res[*Linkedit, Fail]     = linkedit(m, id);
    val a18: res[*Encryption, Fail]   = encryption(m, id);
    val a19: res[*DyldInfo, Fail]     = dyld_info(m, id);
    val a20: res[*VersionMin, Fail]   = version_min(m, id);
    val a21: res[*Entry, Fail]        = entry(m, id);
    val a22: res[*u64, Fail]          = source_version(m, id);
    val a23: res[*u32, Fail]          = linker_option(m, id);
    val a24: res[*Note, Fail]         = note(m, id);
    val a25: res[*BuildVersion, Fail] = build_version(m, id);
    val a26: res[*FilesetEntry, Fail] = fileset_entry(m, id);
    val a27: res[*Name, Fail]         = target_triple(m, id);
    if (sel a0.ok && a0.ok.nsects == mark)                                   { got = got | (1::u64 << 0); }
    if (sel a1.ok && a1.ok.symoff == mark)                                   { got = got | (1::u64 << 1); }
    if (sel a2.ok && a2.ok.offset == mark)                                   { got = got | (1::u64 << 2); }
    if (sel a3.ok && table.count[ThreadState](?a3.ok.states) == mark::usize) { got = got | (1::u64 << 3); }
    if (sel a4.ok && a4.ok.name.offset == mark)                              { got = got | (1::u64 << 4); }
    if (sel a5.ok && a5.ok.name.offset == mark)                              { got = got | (1::u64 << 5); }
    if (sel a6.ok && a6.ok.ilocalsym == mark)                                { got = got | (1::u64 << 6); }
    if (sel a7.ok && a7.ok.name.offset == mark)                              { got = got | (1::u64 << 7); }
    if (sel a8.ok && a8.ok.name.offset == mark)                              { got = got | (1::u64 << 8); }
    if (sel a9.ok && a9.ok.offset == mark)                                   { got = got | (1::u64 << 9); }
    if (sel a10.ok && a10.ok.name.offset == mark)                            { got = got | (1::u64 << 10); }
    if (sel a11.ok && a11.ok.init_address == mark::u64)                      { got = got | (1::u64 << 11); }
    if (sel a12.ok && a12.ok.offset == mark)                                 { got = got | (1::u64 << 12); }
    if (sel a13.ok && a13.ok.offset == mark)                                 { got = got | (1::u64 << 13); }
    if (sel a14.ok && @a14.ok == mark)                                       { got = got | (1::u64 << 14); }
    if (sel a15.ok && (@a15.ok)[0]::u32 == mark)                             { got = got | (1::u64 << 15); }
    if (sel a16.ok && a16.ok.offset == mark)                                 { got = got | (1::u64 << 16); }
    if (sel a17.ok && a17.ok.dataoff == mark)                                { got = got | (1::u64 << 17); }
    if (sel a18.ok && a18.ok.cryptoff == mark)                               { got = got | (1::u64 << 18); }
    if (sel a19.ok && a19.ok.rebase_off == mark)                             { got = got | (1::u64 << 19); }
    if (sel a20.ok && a20.ok.version == mark)                                { got = got | (1::u64 << 20); }
    if (sel a21.ok && a21.ok.entryoff == mark::u64)                          { got = got | (1::u64 << 21); }
    if (sel a22.ok && @a22.ok == mark::u64)                                  { got = got | (1::u64 << 22); }
    if (sel a23.ok && @a23.ok == mark)                                       { got = got | (1::u64 << 23); }
    if (sel a24.ok && a24.ok.offset == mark::u64)                            { got = got | (1::u64 << 24); }
    if (sel a25.ok && a25.ok.platform == mark)                               { got = got | (1::u64 << 25); }
    if (sel a26.ok && a26.ok.vmaddr == mark::u64)                            { got = got | (1::u64 << 26); }
    if (sel a27.ok && a27.ok.offset == mark)                                 { got = got | (1::u64 << 27); }
    ret got;
}

test model__each_load_command_accessor_returns_its_typed_record {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var m:          MachO = make(T.allocator_of(?t), Shape{class: ?CLASS32, order: BIG});
    var uuid_bytes: [16]u8;
    uuid_bytes[0] = 15;
    var states: Table[ThreadState] = table.make[ThreadState](m.a);
    var k:      usize              = 0;
    for (k < 3) {
        val s: res[Id[ThreadState], Fail] = table.push[ThreadState](?states, ThreadState{flavor: 4});
        if (sel s.err) { ret 1; }
        k = k + 1;
    }
    val loads: [LOAD_KINDS]Load = [LOAD_KINDS]Load{
        Load.segment{Segment{nsects: 0, sections: table.make[Section](m.a)}},
        Load.symtab{Symtab{symoff: 1}},
        Load.symseg{Symseg{offset: 2}},
        Load.thread{Thread{states: states}},
        Load.fvmlib{Fvmlib{name: Name{offset: 4}}},
        Load.fvmfile{Fvmfile{name: Name{offset: 5}}},
        Load.dysymtab{Dysymtab{ilocalsym: 6}},
        Load.dylib{Dylib{name: Name{offset: 7}}},
        Load.dylib_use{DylibUse{name: Name{offset: 8}}},
        Load.dylinker{Name{offset: 9}},
        Load.prebound{Prebound{name: Name{offset: 10}}},
        Load.routines{Routines{init_address: 11}},
        Load.sub{Name{offset: 12}},
        Load.hints{Hints{offset: 13}},
        Load.cksum{14},
        Load.uuid{uuid_bytes},
        Load.rpath{Name{offset: 16}},
        Load.linkedit{Linkedit{dataoff: 17}},
        Load.encryption{Encryption{cryptoff: 18}},
        Load.dyld_info{DyldInfo{rebase_off: 19}},
        Load.version_min{VersionMin{version: 20}},
        Load.entry{Entry{entryoff: 21}},
        Load.source_version{22},
        Load.linker_option{23},
        Load.note{Note{offset: 24}},
        Load.build_version{BuildVersion{platform: 25, tools: table.make[Tool](m.a)}},
        Load.fileset_entry{FilesetEntry{vmaddr: 26}},
        Load.target_triple{Name{offset: 27}},
    };
    var i: usize = 0;
    for (i < LOAD_KINDS) {
        val id: res[Id[Command], Fail] = table.push[Command](?m.commands, Command{body: loads[i]});
        if (sel id.err)                                        { ret 1; }
        if (accepted(?m, id.ok, i::u32) != (1::u64 << i::u64)) { ret 1; }
        i = i + 1;
    }
    val raw: res[Id[Command], Fail] = table.push[Command](?m.commands, Command{body: Load.raw{}});
    if (sel raw.err)                  { ret 1; }
    if (accepted(?m, raw.ok, 0) != 0) { ret 1; }
    val r: err[Fail] = release(?m);
    if (sel r.err)             { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
