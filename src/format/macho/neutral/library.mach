use std.collections.vector;
use std.collections.vector.Vector;

# state that `o` describes the library of install name `install` at the
# versions `v`, before any symbol it defines
pub fun describe(o: *Object, install: Bytes, v: Versions) err[Fail] {
    if (install.len == 0) { ret err[Fail].err{fail.malformed("a library states an empty install name")}; }
    val res_name: res[Id[Name], Fail] = object.name(o, install.data, install.len);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    o.library = opt[Library].some{Library{loader: opt[Id[Name]].some{res_name.ok}, versions: opt[Versions].some{v}}};
    ret err[Fail].ok{};
}

# fill `o`, an empty object, with the library the claim `cl` names, for an
# image the host `h` runs, as describing a claim states. a name that is no
# install name is refused
pub fun claimed(o: *Object, cl: *Claim, h: *Host) err[Fail] {
    val name: View = cl.name;
    if (name.len == 0 || (name.data[0] != '/' && name.data[0] != '@')) {
        ret err[Fail].err{fail.unsupported("a library a claim describes is named by its install name, an absolute path or one under a loader prefix")};
    }
    var v: Versions = Versions{current: 0, compat: 0};
    if (sel cl.versions.some) { v = cl.versions.some; }
    val err_describe: err[Fail] = describe(o, Bytes{data: name.data, len: name.len}, v);
    if (sel err_describe.err) { ret err_describe; }
    var k: usize = 0;
    for (k < cl.symbol_count) {
        val s:                View      = cl.symbols[k].name;
        val err_offered_once: err[Fail] = offered_once(o, s.data, s.len);
        if (sel err_offered_once.err) { ret err[Fail].err{fail.in_indexed(err_offered_once.err, "claimed symbol", k::u64)}; }
        k = k + 1;
    }
    if (!system_library(h, name)) { ret err[Fail].ok{}; }
    k = 0;
    for (k < h.symbol_count) {
        val text:             str       = h.symbols[k].name;
        val err_offered_once: err[Fail] = offered_once(o, text::*u8, str_len(text));
        if (sel err_offered_once.err) { ret err_offered_once; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# whether `name` is the install name of a library the host links every
# program against
fun system_library(h: *Host, name: View) bool {
    var k: usize = 0;
    for (k < h.library_count) {
        val l: str = h.libraries[k];
        k = k + 1;
        if (str_len(l) == name.len && memory.raw_equal(l::ptr, name.data::ptr, name.len)) { ret true; }
    }
    ret false;
}

# offer the `n` bytes at `p` as a symbol `o` defines, once
fun offered_once(o: *Object, p: *u8, n: usize) err[Fail] {
    val before:   usize               = intern.count(?o.names);
    val res_name: res[Id[Name], Fail] = object.name(o, p, n);
    if (sel res_name.err)                                                 { ret err[Fail].err{res_name.err}; }
    if (intern.count(?o.names) == before && named_symbol(o, res_name.ok)) { ret err[Fail].ok{}; }
    ret offer(o, res_name.ok, false, false);
}

# whether a symbol of `o` has the name `n`
fun named_symbol(o: *Object, n: Id[Name]) bool {
    var i: usize = 0;
    for (i < table.count[Symbol](?o.symbols)) {
        if (object.symbol_at(o, table.nth[Symbol](i)).name.index == n.index) { ret true; }
        i = i + 1;
    }
    ret false;
}

# how a library is linked against
# ---
# reexports: it is re-exported
# weak:      it may be missing at load
# upward:    it depends on the object in turn
# delayed:   its initializers run at the first call into it
pub rec Linked {
    reexports: bool;
    weak:      bool;
    upward:    bool;
    delayed:   bool;
}

# a library `o` links against, by its install name and its versions, none
# where the input states none
pub fun depends(o: *Object, install: Bytes, v: opt[Versions], how: Linked) err[Fail] {
    if (install.len == 0) { ret err[Fail].err{fail.malformed("a library links one of an empty install name")}; }
    val res_name: res[Id[Name], Fail] = object.name(o, install.data, install.len);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    val d:               Dependency                = Dependency{library: Library{loader: opt[Id[Name]].some{res_name.ok}, versions: v}, reexports: how.reexports, weak: how.weak, upward: how.upward, delayed: how.delayed};
    val res_add_library: res[Id[Dependency], Fail] = object.add_library(o, d);
    if (sel res_add_library.err) { ret err[Fail].err{res_add_library.err}; }
    ret err[Fail].ok{};
}

# a symbol the library `o` describes offers by the name `name`, weak where
# it is a weak definition and thread-local data where `thread` says
pub fun offer(o: *Object, name: Id[Name], weak: bool, thread: bool) err[Fail] {
    var binding: *symbol.Binding = ?symbol.GLOBAL;
    if (weak) { binding = ?symbol.WEAKLY; }
    var kind: *symbol.Kind = ?symbol.NOTYPE;
    if (thread) { kind = ?symbol.TLS; }
    val res_add_symbol: res[Id[Symbol], Fail] = object.add_symbol(o, Symbol{
        name:       name,
        binding:    binding,
        visibility: ?symbol.DEFAULT,
        kind:       kind,
        def:        Definition.library{object.Export.named{Named{name: name}}},
    });
    if (sel res_add_symbol.err) { ret err[Fail].err{res_add_symbol.err}; }
    ret err[Fail].ok{};
}

# the architecture a mach header of `cputype` and `cpusubtype` names
pub fun arch_of(cputype: u32, cpusubtype: u32) res[*Arch, Fail] {
    var s: Stated = model.stated(cputype, cpusubtype);
    ret arch_list.by_code(?s);
}

# add the library the dylib `m` describes to `o`, which holds nothing yet. a
# refusal leaves `o` as it was
pub fun to_neutral(m: *MachO, o: *Object) err[Fail] {
    if (!object.is_empty(o)) { ret err[Fail].err{fail.internal("a model converts into an empty neutral object")}; }
    var built:       Object    = object.blank_init(o);
    val err_convert: err[Fail] = convert(m, ?built);
    if (sel err_convert.err) {
        val err_dropped: err[Fail] = object.dnit(?built);
        ret err_convert;
    }
    ret object.commit(o, ?built);
}

fun convert(m: *MachO, o: *Object) err[Fail] {
    val res_arch_of: res[*Arch, Fail] = arch_of(m.header.cputype, m.header.cpusubtype);
    if (sel res_arch_of.err) { ret err[Fail].err{fail.in_record(res_arch_of.err, "mach header")}; }
    o.target.arch = res_arch_of.ok;
    val err_identity: err[Fail] = identity(m, o);
    if (sel err_identity.err) { ret err_identity; }
    var i: usize = 0;
    for (i < table.count[Command](?m.commands)) {
        val err_linked: err[Fail] = linked(m, o, table.nth[Command](i));
        if (sel err_linked.err) { ret err[Fail].err{fail.in_indexed(err_linked.err, "load command", i::u64)}; }
        i = i + 1;
    }
    ret exports(m, o);
}

# the dylib's own install name and versions, from its one LC_ID_DYLIB
fun identity(m: *MachO, o: *Object) err[Fail] {
    var found: bool        = false;
    var at:    Id[Command] = table.nth[Command](0);
    var i:     usize       = 0;
    for (i < table.count[Command](?m.commands)) {
        val c: *Command = model.command_at(m, table.nth[Command](i));
        i = i + 1;
        if (c.cmd != tables.LC_ID_DYLIB.value::u32) { cnt; }
        if (found)                                  { ret err[Fail].err{fail.in_indexed(fail.malformed("a dylib states two LC_ID_DYLIB commands"), "load command", (i - 1)::u64)}; }
        found = true;
        at    = table.nth[Command](i - 1);
    }
    if (!found) { ret err[Fail].err{fail.malformed("a dylib states no LC_ID_DYLIB")}; }
    val res_dylib: res[*model.Dylib, Fail] = model.dylib(m, at);
    if (sel res_dylib.err) { ret err[Fail].err{res_dylib.err}; }
    val res_string: res[Bytes, Fail] = model.string(m, at, res_dylib.ok.name);
    if (sel res_string.err) { ret err[Fail].err{fail.in_record(res_string.err, "LC_ID_DYLIB")}; }
    ret describe(o, res_string.ok, Versions{current: res_dylib.ok.current_version, compat: res_dylib.ok.compatibility_version});
}

# the library a dylib load command of `m` names, a dependency of `o`
fun linked(m: *MachO, o: *Object, id: Id[Command]) err[Fail] {
    val c:   *Command = model.command_at(m, id);
    val cmd: u64      = c.cmd::u64;
    if (cmd == tables.LC_ID_DYLIB.value) { ret err[Fail].ok{}; }
    val res_use: res[*model.DylibUse, Fail] = model.dylib_use(m, id);
    if (sel res_use.ok) { ret used(m, o, id, res_use.ok); }
    val res_dylib: res[*model.Dylib, Fail] = model.dylib(m, id);
    if (sel res_dylib.err) { ret err[Fail].ok{}; }
    val res_string: res[Bytes, Fail] = model.string(m, id, res_dylib.ok.name);
    if (sel res_string.err) { ret err[Fail].err{res_string.err}; }
    val v: Versions = Versions{current: res_dylib.ok.current_version, compat: res_dylib.ok.compatibility_version};
    ret depends(o, res_string.ok, opt[Versions].some{v}, Linked{reexports: cmd == tables.LC_REEXPORT_DYLIB.value, weak: cmd == tables.LC_LOAD_WEAK_DYLIB.value, upward: cmd == tables.LC_LOAD_UPWARD_DYLIB.value});
}

# the library the dylib_use_command `u` of `m` names, its flags kept
fun used(m: *MachO, o: *Object, id: Id[Command], u: *model.DylibUse) err[Fail] {
    val res_string: res[Bytes, Fail] = model.string(m, id, u.name);
    if (sel res_string.err) { ret err[Fail].err{res_string.err}; }
    val flags: u64    = u.flags::u64;
    val how:   Linked = Linked{
        reexports: (flags & tables.DYLIB_USE_REEXPORT.value) != 0,
        weak:      (flags & tables.DYLIB_USE_WEAK_LINK.value) != 0,
        upward:    (flags & tables.DYLIB_USE_UPWARD.value) != 0,
        delayed:   (flags & tables.DYLIB_USE_DELAYED_INIT.value) != 0,
    };
    ret depends(o, res_string.ok, opt[Versions].some{Versions{current: u.current_version, compat: u.compat_version}}, how);
}

# every symbol the export trie names, each once, or with no trie the external
# definitions of the symbol table
fun exports(m: *MachO, o: *Object) err[Fail] {
    var found: bool  = false;
    var i:     usize = 0;
    for (i < table.count[Blob](?m.blobs)) {
        val b: *Blob = model.blob_at(m, table.nth[Blob](i));
        i = i + 1;
        if (sel b.data.exports) {
            if (found) { ret err[Fail].err{fail.malformed("a dylib states two export tries")}; }
            found = true;
            val err_offered: err[Fail] = offered(m, o, ?b.data.exports.exports, nil);
            if (sel err_offered.err) { ret err[Fail].err{fail.in_record(err_offered.err, "export trie")}; }
            cnt;
        }
        if (!trie_part(m, b)) { cnt; }
        if (!sel b.data.raw)  { cnt; }
        if (found)            { ret err[Fail].err{fail.malformed("a dylib states two export tries")}; }
        found = true;
        val err_raw_trie: err[Fail] = raw_trie(m, o, model.bytes(m, ?b.data.raw.bytes));
        if (sel err_raw_trie.err) { ret err[Fail].err{fail.in_record(err_raw_trie.err, "export trie")}; }
    }
    if (found) { ret err[Fail].ok{}; }
    i = 0;
    for (i < table.count[Command](?m.commands)) {
        val c: *Command = model.command_at(m, table.nth[Command](i));
        i = i + 1;
        if (!sel c.body.dysymtab) { cnt; }
        val err_defined: err[Fail] = defined(m, o, ?c.body.dysymtab);
        if (sel err_defined.err) { ret err[Fail].err{fail.in_record(err_defined.err, "LC_DYSYMTAB")}; }
    }
    ret err[Fail].ok{};
}

# offer each external definition `d` names in the symbol table: a weak
# definition is weak and a symbol of a section of thread-local variable
# descriptors names thread-local data. a range past the table is refused, as
# is a symbol of the range that is no external definition. a private external
# is the dylib's own, which no image binds
fun defined(m: *MachO, o: *Object, d: *model.Dysymtab) err[Fail] {
    if (d.nextdefsym == 0) { ret err[Fail].ok{}; }
    val opt_symbol_table: opt[model.Symbols] = model.symbol_table(m);
    if (sel opt_symbol_table.none) { ret err[Fail].err{fail.malformed("a dylib states external definitions and no symbol table")}; }
    var syms: model.Symbols = opt_symbol_table.some;
    val n:    u64           = table.count[Nlist](syms.symbols)::u64;
    if (d.iextdefsym::u64 + d.nextdefsym::u64 > n) { ret err[Fail].err{fail.valued(fail.malformed("the external definitions run past the symbol table"), d.iextdefsym::i128)}; }
    val res_ords: res[model.Ordinals, Fail] = model.ordinals(m);
    if (sel res_ords.err) { ret err[Fail].err{res_ords.err}; }
    var ordinals:    model.Ordinals = res_ords.ok;
    var err_defined: err[Fail]      = err[Fail].ok{};
    var i:           usize          = 0;
    for (i < d.nextdefsym::usize && sel err_defined.ok) {
        val at:             Id[Nlist] = table.nth[Nlist](d.iextdefsym::usize + i);
        val err_definition: err[Fail] = definition(m, o, ?ordinals, ?syms, at);
        if (sel err_definition.err) { err_defined = err[Fail].err{fail.in_indexed(err_definition.err, "symbol", at.index::u64)}; }
        i = i + 1;
    }
    ret fail.kept(err_defined, model.ordinals_dnit(?ordinals));
}

fun definition(m: *MachO, o: *Object, ords: *model.Ordinals, t: *model.Symbols, at: Id[Nlist]) err[Fail] {
    val e: *Nlist = table.at[Nlist](t.symbols, at);
    if (!model.external(e) || model.stab(e) != 0 || model.symbol_type(e) == tables.N_UNDF.value::u8) {
        ret err[Fail].err{fail.malformed("a symbol of the external definitions is no external definition")};
    }
    if (model.private_external(e)) { ret err[Fail].ok{}; }
    val res_text: res[Bytes, Fail] = model.symbol_name(m, t, at);
    if (sel res_text.err) { ret err[Fail].err{res_text.err}; }
    val res_sec: res[opt[model.SectionRef], Fail] = model.symbol_section(ords, t, at);
    if (sel res_sec.err) { ret err[Fail].err{res_sec.err}; }
    var thread: bool = false;
    if (sel res_sec.ok.some) {
        val res_section: res[*model.Section, Fail] = model.section(m, res_sec.ok.some);
        if (sel res_section.err) { ret err[Fail].err{res_section.err}; }
        thread = model.section_type(res_section.ok)::u64 == tables.S_THREAD_LOCAL_VARIABLES.value;
    }
    val res_name: res[Id[Name], Fail] = object.name(o, res_text.ok.data, res_text.ok.len);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    ret offer(o, res_name.ok, (e.desc & tables.N_WEAK_DEF.value::u16) != 0, thread);
}

# whether the blob `b` is the export trie of LC_DYLD_INFO or of
# LC_DYLD_EXPORTS_TRIE
fun trie_part(m: *MachO, b: *Blob) bool {
    if (sel b.part.exports) { ret true; }
    val c: *Command = model.command_at(m, b.command);
    ret sel b.part.data && c.cmd::u64 == tables.LC_DYLD_EXPORTS_TRIE.value;
}

# the exports of a trie held raw, decoded into a store of their own
fun raw_trie(m: *MachO, o: *Object, bytes: Bytes) err[Fail] {
    var st:         Store                     = store.init(m.a);
    var rd:         Reader                    = reader.make("export trie", bytes.data, bytes.len, m.shape.order);
    val res_decode: res[Vector[Export], Fail] = trie.decode(m.a, ?st, ?rd);
    if (sel res_decode.err) { ret fail.kept(err[Fail].err{res_decode.err}, store.dnit(?st)); }
    var t:           Vector[Export] = res_decode.ok;
    val err_offered: err[Fail]      = offered(m, o, ?t, ?st);
    ret fail.kept(fail.kept(err_offered, vectors.dnit[Export](?t)), store.dnit(?st));
}

# offer each export of `t`, its names in `st`, or in the model's store for
# nil
fun offered(m: *MachO, o: *Object, t: *Vector[Export], st: *Store) err[Fail] {
    val mask:   u64   = tables.EXPORT_SYMBOL_FLAGS_KIND_MASK.value;
    val thread: u64   = tables.EXPORT_SYMBOL_FLAGS_KIND_THREAD_LOCAL.value;
    val weak:   u64   = tables.EXPORT_SYMBOL_FLAGS_WEAK_DEFINITION.value;
    var i:      usize = 0;
    for (i < vector.length[Export](t)) {
        val e: *Export = ?t.data[i];
        i = i + 1;
        var name: Bytes = Bytes{};
        if (st == nil) { name = model.bytes(m, ?e.name); }
        or             { name = store.bytes(st, ?e.name); }
        val res_name: res[Id[Name], Fail] = object.name(o, name.data, name.len);
        if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
        val err_offer: err[Fail] = offer(o, res_name.ok, (e.flags & weak) != 0, (e.flags & mask) == thread);
        if (sel err_offer.err) { ret err[Fail].err{fail.in_indexed(err_offer.err, "export", (i - 1)::u64)}; }
    }
    ret err[Fail].ok{};
}
