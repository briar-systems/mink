# a Mach-O library to the neutral object that describes it
#
# a dylib, and a text stub of one, is to a link the library its install name
# names, at its current and compatibility versions, and the symbols it
# exports, each found by its name: a weak definition is weak and a
# thread-local variable names thread-local data. a symbol the library
# re-exports from another is its own to an image that binds to it, as the
# two-level namespace binds through the library the image loads. the
# libraries it links against are its dependencies, those it re-exports
# marked so. a dylib binary states its install name in LC_ID_DYLIB and its
# symbols in its export trie, which is read even where it does not encode
# back to its bytes, or with no trie, in the external definitions LC_DYSYMTAB
# names in its symbol table. a dylib_use_command states a dependency's kind
# in its flags where a load command's cmd does otherwise.
#
# a claim that names a shared library describes the same object with no
# file: the library its name names as the install name, which is an absolute
# path or one under a loader prefix, at the versions the claim states, or at
# zero for both where it states none, which every version of the library
# satisfies as the loader compares them, and each symbol the claim provides,
# found by its name. the library the system links every program against, as
# the host names it, provides the names the system's loader binds through as
# well, as dyld's lazy binder and its accessor of thread-local variables.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.memory;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Name;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Store;
use mink.base.table;
use mink.base.table.Id;
use mink.base.vectors;
use mink.bytes.reader;
use mink.bytes.reader.Reader;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Stated;
use arch_list: mink.catalog.arch.list;
use mink.catalog.os.Host;
use mink.format.macho.linkedit.trie;
use mink.format.macho.model.model;
use mink.format.macho.model.model.Blob;
use mink.format.macho.model.model.Command;
