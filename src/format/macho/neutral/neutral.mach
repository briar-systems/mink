# the section a DWARF line table is written to
val DEBUG_LINE: str = "__DWARF,__debug_line";

# the kinds a personality reaches its GOT slot by, place-relative from the
# field
val GOT_SLOT_COUNT: usize                            = 3;
val GOT_SLOT_ROWS:  [GOT_SLOT_COUNT]pointer.SlotKind = [GOT_SLOT_COUNT]pointer.SlotKind{
    pointer.SlotKind{arch: ?x86.X86_64, kind: ?kinds.GOT_PC32},
    pointer.SlotKind{arch: ?aarch64.AARCH64, kind: ?kinds.POINTER_TO_GOT_PC32},
    pointer.SlotKind{arch: ?aarch64.ARM64E, kind: ?kinds.POINTER_TO_GOT_PC32},
};
val GOT_SLOTS: pointer.SlotKinds = pointer.SlotKinds{rows: ?GOT_SLOT_ROWS[0], count: GOT_SLOT_COUNT};

# the DWARF table a function compact unwind cannot describe falls back to,
# as clang writes it: version 1 CIEs of id 0 with a `z` augmentation, FDEs
# naming their CIE by the distance back to it, an FDE's start and its
# language data an address relative to the field, resolved in place with no
# record, an FDE's start named by its function's own symbol, as llvm-mc names
# it where it writes the start as a difference, and a personality routine
# reached through a GOT slot the link makes, 4 bytes relative to the field
val EH_FRAME: FrameForm = FrameForm.dwarf_eh{DwarfFrame{
    section:     "__TEXT,__eh_frame",
    kind:        ?section.UNWIND_INFO,
    disposition: ?section.RECORDS,
    mapped:      false,
    cie_id:      0,
    version:     1,
    augmented:   true,
    link:        CieLink.back{},
    pad:         Width.fixed{4},
    encodings:   ?pointer.EH,
    address:     Field{encoding: Encoding{format: ?pointer.ABSPTR, base: ?pointer.PCREL}, relocated: Relocated.kind{}},
    personality: opt[Field].some{Field{encoding: Encoding{format: ?pointer.SDATA4, base: ?pointer.PCREL, indirect: true}, relocated: Relocated.got{?GOT_SLOTS}}},
    lsda:        opt[Field].some{Field{encoding: Encoding{format: ?pointer.ABSPTR, base: ?pointer.PCREL}, relocated: Relocated.kind{}}},
    anchor:      Anchor.function{},
}};

# __debug_frame as llvm-mc writes it for DWARF 5: version 4 CIEs of id
# 0xffffffff with no augmentation, FDEs naming their CIE by its offset as a
# number and their start by their function's section, absolute addresses and
# entries padded to an address
val DEBUG_FRAME: DwarfFrame = DwarfFrame{
    section:     "__DWARF,__debug_frame",
    kind:        ?section.DEBUG_INFO,
    disposition: ?section.ROOT,
    mapped:      false,
    cie_id:      0xffff_ffff,
    version:     4,
    augmented:   false,
    link:        CieLink.offset{},
    pad:         Width.address{},
    encodings:   ?pointer.DEBUG,
    address:     Field{encoding: Encoding{format: ?pointer.ABSPTR, base: ?pointer.ABSOLUTE}, relocated: Relocated.kind{}},
    anchor:      Anchor.section{},
};

# the destinations Mach-O offers frames, as the Apple toolchain writes each:
# a runtime unwinder's as one compact unwind entry per function in
# __LD,__compact_unwind, its start named by its function's section
val FRAME_OFFERS: [2]FrameOffer = [2]FrameOffer{
    FrameOffer{destination: ?frame.UNWIND, form: FrameForm.compact{CompactTable{section: "__LD,__compact_unwind", kind: ?section.UNWIND_RECORDS, disposition: ?section.RECORDS, fallback: ?EH_FRAME, anchor: Anchor.section{}}}},
    FrameOffer{destination: ?frame.DEBUG, form: FrameForm.dwarf_debug{DEBUG_FRAME}},
};

# what Mach-O makes of a symbol's visibility, which its registration names:
# an external symbol is exported unless N_PEXT marks it a private external,
# as a hidden one is, and dyld coalesces a weak definition across images, so
# nothing withholds preemption and Mach-O carries no protected visibility
# (Mach-O nlist, n_type)
val CARRIED_COUNT: usize                             = 2;
val CARRIED:       [CARRIED_COUNT]*symbol.Visibility = [CARRIED_COUNT]*symbol.Visibility{?symbol.DEFAULT, ?symbol.HIDDEN};

pub val WRITTEN_VISIBILITY: symbol.Visibilities = symbol.Visibilities{carried: ?CARRIED[0], count: CARRIED_COUNT, withheld: 0, apart: false};

# the sections Mach-O holds DWARF debugging information in, each in the
# __DWARF segment
val INFO_NAMES: InfoNames = InfoNames{
    info:      "__DWARF,__debug_info",
    abbrev:    "__DWARF,__debug_abbrev",
    addresses: "__DWARF,__debug_addr",
    locations: "__DWARF,__debug_loclists",
    ranges:    "__DWARF,__debug_rnglists",
};

# the encodings Mach-O writes a neutral object's records in, which its
# registration names. frames lower to compact unwind unless the object states
# otherwise
pub val LOWERING: Lowering = Lowering{
    line:  opt[LineForm].some{LineForm.dwarf{DwarfLine{version: 5, section: DEBUG_LINE}}},
    frame: opt[FrameTables].some{FrameTables{offers: ?FRAME_OFFERS[0], count: 2, default: Destinations{bits: 1::u64 << frame.UNWIND.bit::u64}}},
    info:  opt[DwarfInfo].some{DwarfInfo{names: ?INFO_NAMES, tls: TlsOffset.address{}}},
};

# the widest a segment or section name is
val NAME_SIZE: usize = 16;

# the bits of n_desc that hold a common symbol's alignment, a power of two
val COMM_ALIGN_AT:   u16 = 8;
val COMM_ALIGN_BITS: u16 = 0x0f00;

# the bits of an ADDEND record's addend
val ADDEND_BITS: u8 = 24;

# the protections an object's segment states
val OBJECT_PROT: u32 = 7;

# a defined symbol's place in a section, in the order atoms are searched
# ---
# section: the neutral section
# offset:  the offset within it
# sym:     the neutral symbol
# alt:     whether the symbol is an alternate entry, which starts no atom
rec Atom {
    section: u32;
    offset:  u64;
    sym:     u32;
    alt:     bool;
}

fun order_atoms(a: *Atom, b: *Atom) i64 {
    if (a.section != b.section) {
        if (a.section < b.section) { ret -1; }
        ret 1;
    }
    if (a.offset != b.offset) {
        if (a.offset < b.offset) { ret -1; }
        ret 1;
    }
    if (a.sym < b.sym) { ret -1; }
    if (a.sym > b.sym) { ret 1; }
    ret 0;
}

# the file being converted
# ---
# m:           the model
# o:           the object it is added to
# reg:         the relocation rows of every pair, borrowed
# pair:        what Mach-O states for the file's architecture
# set:         the relocation rows of the file's architecture
# subsections: whether every symbol starts an atom
# ords:        the model's sections in ordinal order, the neutral order
# addend_key:  the key of the ADDEND marker, absent for a set with none
# symbols:     the symbol table, none when the file has none
# saw_symtab:  whether a symbol table command was read
# atoms:       every placed symbol, by section and offset
# stand_ins:   per section, the symbol standing for the section plus one,
#              or zero
# dic:         the data in code command, when the file has one
# map:         per ordinal, the neutral section plus one, or zero for the
#              mink note section
# marked:      the relocations of the mink note section, read apart
# to_marked:   whether the section being read is the mink note section
# descriptors: per ordinal, whether the section holds thread-local variable
#              descriptors, which fold into their variables
# firsts:      per ordinal, the index in places of its first descriptor
# places:      the place of each descriptor's variable, section by section
rec Conv {
    m:           *MachO;
    o:           *Object;
    reg:         *Registry;
    pair:        *Pair;
    set:         *Lookup;
    subsections: bool;
    ords:        model.Ordinals;
    addend_key:  opt[u32];
    symbols:     opt[model.Symbols];
    saw_symtab:  bool;
    atoms:       Vector[Atom];
    stand_ins:   Vector[u32];
    dic:         opt[Id[Command]];
    map:         Vector[u32];
    marked:      Table[object.Reloc];
    to_marked:   bool;
    descriptors: Vector[bool];
    firsts:      Vector[u32];
    places:      Table[Place];
}

# the neutral section of the file's section at ordinal position `n`, refused
# for the mink note section, which is no neutral section
fun neutral_section(c: *Conv, n: usize) res[u32, Fail] {
    if (n >= vector.length[u32](?c.map)) { ret res[u32, Fail].err{fail.malformed("names a section the file does not have")}; }
    if (descriptor(c, n))                { ret res[u32, Fail].err{fail.unsupported("names a thread-local variable descriptor by its section, which reads as no section of the object")}; }
    val v: u32 = c.map.data[n];
    if (v == 0) { ret res[u32, Fail].err{fail.unsupported("names the mink note section, which is no section of the object")}; }
    ret res[u32, Fail].ok{v - 1};
}

# whether the file's section at ordinal position `n` holds thread-local
# variable descriptors
fun descriptor(c: *Conv, n: usize) bool {
    ret n < vector.length[bool](?c.descriptors) && c.descriptors.data[n];
}

# whether the file's section at ordinal position `n` holds the mink note
fun is_mark(c: *Conv, n: usize) bool {
    val s: *model.Section = section_at(c, n);
    if (s == nil) { ret false; }
    ret macho_mark.holds(?s.segname[0], ?s.sectname[0]);
}

fun add_fact(o: *Object, k: u32, value: u64, data: Contents) err[Fail] {
    val res_add_fact: res[Id[Fact], Fail] = object.add_fact(o, Fact{format: ?format.MACHO, key: k, value: value, data: data});
    if (sel res_add_fact.err) { ret err[Fail].err{res_add_fact.err}; }
    ret err[Fail].ok{};
}

fun own_bytes(o: *Object, p: *u8, n: usize) res[Contents, Fail] {
    ret object.own(o, p, n);
}

# the length of a 16 byte name up to its terminator
fun name_len(n: *u8) usize {
    var i: usize = 0;
    for (i < NAME_SIZE && n[i] != 0) { i = i + 1; }
    ret i;
}

# the `segment,section` spelling of a section's names, in `out`
fun spell(out: *u8, seg: *u8, sect: *u8) usize {
    val a: usize = name_len(seg);
    val b: usize = name_len(sect);
    var i: usize = 0;
    for (i < a) {
        out[i] = seg[i];
        i      = i + 1;
    }
    out[a] = ',';
    i      = 0;
    for (i < b) {
        out[a + 1 + i] = sect[i];
        i              = i + 1;
    }
    ret a + 1 + b;
}

# a version as LC_BUILD_VERSION packs it: major in the high half, minor and
# patch a byte each
fun unpack_version(v: u32) Version {
    ret Version{major: (v >> 16)::u16, minor: ((v >> 8) & 0xff)::u8, patch: (v & 0xff)::u8};
}

# the version `v` as LC_BUILD_VERSION packs it, xxxx.yy.zz in nibbles
pub fun pack_version(v: Version) u32 {
    ret (v.major::u32 << 16) | (v.minor::u32 << 8) | v.patch::u32;
}

# the environment a Mach-O platform code names, none when the catalog has none
fun env_of(platform: u32) opt[*Env] {
    var i: usize = 0;
    for (i < os_list.count()) {
        val s: *System = os_list.at(i);
        var h: usize   = 0;
        for (h < s.host_count) {
            val opt_host_env: opt[*Env] = s.hosts[h].env;
            h = h + 1;
            if (sel opt_host_env.none) { cnt; }
            var k: usize = 0;
            for (k < opt_host_env.some.code_count) {
                if (opt_host_env.some.codes[k].format == ?format.MACHO && opt_host_env.some.codes[k].value == platform::u64) { ret opt_host_env; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret opt[*Env].none{};
}

# the Mach-O platform code of `e`, none when it has none
pub fun platform_of(e: *Env) opt[u32] {
    var k: usize = 0;
    for (k < e.code_count) {
        if (e.codes[k].format == ?format.MACHO) { ret opt[u32].some{e.codes[k].value::u32}; }
        k = k + 1;
    }
    ret opt[u32].none{};
}

# how garbage collection treats a section: unwind records live with the code
# they describe, bytes nothing loads are kept whole, and a loaded section is
# split into its atoms when every symbol starts one
fun disposition_of(k: *section.Kind, flags: section.Flags, subsections: bool) *section.Disposition {
    if (section.has(k, section.UNWIND)) { ret ?section.RECORDS; }
    if (section.describes(k))           { ret ?section.ROOT; }
    if (subsections)                    { ret ?section.SPLIT; }
    ret ?section.WHOLE;
}

fun begin(c: *Conv) err[Fail] {
    val h:           *model.Header    = ?c.m.header;
    var s:           Stated           = model.stated(h.cputype, h.cpusubtype);
    val res_by_code: res[*Arch, Fail] = arch_list.by_code(?s);
    if (sel res_by_code.err) { ret err[Fail].err{fail.in_record(res_by_code.err, "mach header")}; }
    c.o.target.arch = res_by_code.ok;
    val res_macho_pairs_of: res[*Pair, Fail] = macho_pairs.of(res_by_code.ok);
    if (sel res_macho_pairs_of.err) { ret err[Fail].err{fail.in_record(res_macho_pairs_of.err, "mach header")}; }
    c.pair = res_macho_pairs_of.ok;
    val res_set: res[*Lookup, Fail] = row.find(c.reg, ?format.MACHO, res_by_code.ok);
    if (sel res_set.err) { ret err[Fail].err{res_set.err}; }
    c.set         = res_set.ok;
    c.addend_key  = addend_key(res_set.ok);
    c.subsections = (h.flags::u64 & tables.MH_SUBSECTIONS_VIA_SYMBOLS.value) != 0;
    val flags: u64 = h.flags::u64 & ~tables.MH_SUBSECTIONS_VIA_SYMBOLS.value;
    if (flags != 0) {
        val err_add_fact: err[Fail] = add_fact(c.o, fact.HEADER_FLAGS, flags, Contents.zero{0});
        if (sel err_add_fact.err) { ret err_add_fact; }
    }
    val res_caps: res[u32, Fail] = traits.decode(c.o, model.cpu_capabilities(h.cpusubtype));
    if (sel res_caps.err) { ret err[Fail].err{fail.in_record(res_caps.err, "mach header")}; }
    if (res_caps.ok != 0) {
        val err_add_fact: err[Fail] = add_fact(c.o, fact.SUBTYPE_CAPS, res_caps.ok::u64, Contents.zero{0});
        if (sel err_add_fact.err) { ret err_add_fact; }
    }
    ret err[Fail].ok{};
}

# walk the load commands: the segment's sections, the symbol table, the
# target, the directives and the hints. a command with no neutral form is
# refused, as is one holding bytes past what its fields and strings hold that
# are not zero, which the conversion back does not write
fun commands_in(c: *Conv) err[Fail] {
    var segments: usize = 0;
    var i:        usize = 0;
    for (i < table.count[Command](?c.m.commands)) {
        val id:             Id[Command] = table.nth[Command](i);
        val cm:             *Command    = model.command_at(c.m, id);
        var err_command_in: err[Fail]   = command_in(c, id, cm, ?segments);
        if (sel err_command_in.ok && !(sel cm.body.linker_option)) { err_command_in = bare(model.bytes(c.m, ?cm.rest), 0); }
        if (sel err_command_in.err)                                { ret err[Fail].err{fail.in_indexed(err_command_in.err, "load command", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# refuse the bytes of a load command from `from` in `rest` when any is not
# zero padding
fun bare(rest: Bytes, from: usize) err[Fail] {
    var i: usize = from;
    for (i < rest.len) {
        if (rest.data[i] != 0) { ret err[Fail].err{fail.valued(fail.about(fail.unsupported("a load command holds bytes past its fields that the conversion back does not write"), "trailing bytes"), rest.data[i]::i128)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun command_in(c: *Conv, id: Id[Command], cm: *Command, segments: *usize) err[Fail] {
    if (sel cm.body.segment) {
        if (@segments != 0) { ret err[Fail].err{fail.unsupported("an object with more than one segment has no neutral form")}; }
        @segments = @segments + 1;
        ret segment_in(c, id, ?cm.body.segment);
    }
    if (sel cm.body.symtab)   { ret symtab_in(c, id); }
    if (sel cm.body.dysymtab) { ret dysymtab_in(c, id); }
    if (sel cm.body.build_version) {
        val b:             *model.BuildVersion = ?cm.body.build_version;
        val err_target_in: err[Fail]           = target_in(c, b.platform, b.minos, b.sdk);
        if (sel err_target_in.err) { ret err_target_in; }
        var k: usize = 0;
        for (k < vector.length[model.Tool](?b.tools)) {
            val tool:         *model.Tool = ?b.tools.data[k];
            val err_add_fact: err[Fail]   = add_fact(c.o, fact.BUILD_TOOL, (tool.tool::u64 << 32) | tool.version::u64, Contents.zero{0});
            if (sel err_add_fact.err) { ret err_add_fact; }
            k = k + 1;
        }
        ret err[Fail].ok{};
    }
    if (sel cm.body.version_min) {
        if (cm.cmd::u64 != tables.LC_VERSION_MIN_MACOSX.value) { ret err[Fail].err{fail.unsupported("the catalog has no system for this minimum version command")}; }
        val err_target_in: err[Fail] = target_in(c, tables.PLATFORM_MACOS.value::u32, cm.body.version_min.version, cm.body.version_min.sdk);
        if (sel err_target_in.err) { ret err_target_in; }
        ret add_fact(c.o, fact.VERSION_MIN, cm.cmd::u64, Contents.zero{0});
    }
    if (sel cm.body.linker_option) { ret options_in(c, cm, cm.body.linker_option); }
    if (sel cm.body.linkedit) {
        if (cm.cmd::u64 == tables.LC_DATA_IN_CODE.value) {
            val seen: bool = sel c.dic.some;
            if (seen) { ret err[Fail].err{fail.unsupported("more than one data in code command")}; }
            c.dic = opt[Id[Command]].some{id};
            ret err[Fail].ok{};
        }
        if (cm.cmd::u64 != tables.LC_LINKER_OPTIMIZATION_HINT.value) { ret err[Fail].err{fail.unsupported("this link-edit data command has no neutral form")}; }
        ret hints_in(c, id);
    }
    ret err[Fail].err{fail.unsupported("this load command has no neutral form")};
}

fun segment_in(c: *Conv, id: Id[Command], seg: *model.Segment) err[Fail] {
    if (name_len(?seg.segname[0]) != 0 || seg.maxprot != OBJECT_PROT || seg.initprot != OBJECT_PROT || seg.flags != 0) {
        val res_name: res[Contents, Fail] = own_bytes(c.o, ?seg.segname[0], NAME_SIZE);
        if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
        val err_add_fact: err[Fail] = add_fact(c.o, fact.SEGMENT, (seg.maxprot::u64 << 32) | seg.initprot::u64, res_name.ok);
        if (sel err_add_fact.err) { ret err_add_fact; }
    }
    ret err[Fail].ok{};
}

# the symbol table command: the symbols themselves come from the model's
# symbol table, read through its accessors, so this checks only that the
# file has one such command and that its blob was decoded
fun symtab_in(c: *Conv, id: Id[Command]) err[Fail] {
    if (c.saw_symtab) { ret err[Fail].err{fail.unsupported("more than one symbol table")}; }
    c.saw_symtab = true;
    var i: usize = 0;
    for (i < table.count[model.Blob](?c.m.blobs)) {
        val b: *model.Blob = model.blob_at(c.m, table.nth[model.Blob](i));
        i = i + 1;
        if (b.command.index != id.index)          { cnt; }
        if (sel b.part.symbols && sel b.data.raw) { ret err[Fail].err{fail.unsupported("the symbol table is held raw and has no neutral form")}; }
    }
    ret err[Fail].ok{};
}

# refuse a dynamic symbol table that names any table of its own, indirect
# symbols, relocations, a table of contents, modules or references, decoded or
# held raw, as the neutral object has no form for them. its symbol ranges are
# the symbol table's, which the conversion back restates
fun dysymtab_in(c: *Conv, id: Id[Command]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[model.Blob](?c.m.blobs)) {
        val b: *model.Blob = model.blob_at(c.m, table.nth[model.Blob](i));
        i = i + 1;
        if (b.command.index != id.index) { cnt; }
        ret err[Fail].err{fail.in_indexed(fail.unsupported("a table the dynamic symbol table names has no neutral form"), "blob", (i - 1)::u64)};
    }
    ret err[Fail].ok{};
}

# the ordinal position of the section `ref` among the file's sections
fun ordinal_of(c: *Conv, ref: SectionRef) res[usize, Fail] {
    var i: usize = 0;
    for (i < vector.length[SectionRef](?c.ords.refs)) {
        val r: *SectionRef = ?c.ords.refs.data[i];
        if (r.command.index == ref.command.index && r.index == ref.index) { ret res[usize, Fail].ok{i}; }
        i = i + 1;
    }
    ret res[usize, Fail].err{fail.internal("a section reference is not among the file's sections")};
}

# the target the platform and versions state. a version of zero is none
fun target_in(c: *Conv, platform: u32, minos: u32, sdk: u32) err[Fail] {
    val stated: bool = sel c.o.target.sys.some;
    if (stated) { ret err[Fail].err{fail.unsupported("more than one command states the target")}; }
    val opt_env_of: opt[*Env] = env_of(platform);
    if (sel opt_env_of.none) { ret err[Fail].err{fail.valued(fail.unsupported("the catalog has no system for this platform"), platform::i128)}; }
    c.o.target.sys = opt[*System].some{opt_env_of.some.sys};
    c.o.target.env = opt_env_of;
    if (minos != 0) { c.o.target.version = opt[Version].some{unpack_version(minos)}; }
    if (sdk != 0)   { c.o.target.sdk = opt[Version].some{unpack_version(sdk)}; }
    ret err[Fail].ok{};
}

# whether the `n` bytes at `p` start with `lead`
fun starts_with(p: *u8, n: usize, lead: str) bool {
    val l: usize = str_len(lead);
    if (n < l) { ret false; }
    var i: usize = 0;
    for (i < l) {
        if (p[i] != lead[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# one NUL-terminated string from `at` in `rest`: its length, refused when it
# is not terminated
fun string_at(rest: Bytes, at: usize) res[usize, Fail] {
    var n: usize = 0;
    for (at + n < rest.len && rest.data[at + n] != 0) { n = n + 1; }
    if (at + n >= rest.len) { ret res[usize, Fail].err{fail.malformed("a linker option is not terminated")}; }
    ret res[usize, Fail].ok{n};
}

# the directives a linker option command states: `-l<name>` a library,
# `-framework <name>` a framework, and any other string an option. the bytes
# past the strings are its padding
fun options_in(c: *Conv, cm: *Command, count: u32) err[Fail] {
    val rest: Bytes = model.bytes(c.m, ?cm.rest);
    var at:   usize = 0;
    var i:    u32   = 0;
    if (count == 2) {
        val res_first: res[usize, Fail] = string_at(rest, 0);
        if (sel res_first.err) { ret err[Fail].err{res_first.err}; }
        if (res_first.ok == 10 && starts_with(rest.data, res_first.ok, "-framework")) {
            val res_second: res[usize, Fail] = string_at(rest, res_first.ok + 1);
            if (sel res_second.err) { ret err[Fail].err{res_second.err}; }
            val err_directive_in: err[Fail] = directive_in(c, ?directive.FRAMEWORK, ?rest.data[res_first.ok + 1], res_second.ok);
            if (sel err_directive_in.err) { ret err_directive_in; }
            ret bare(rest, res_first.ok + res_second.ok + 2);
        }
    }
    for (i < count) {
        val res_string_at: res[usize, Fail] = string_at(rest, at);
        if (sel res_string_at.err) { ret err[Fail].err{res_string_at.err}; }
        if (count == 1 && starts_with(?rest.data[at], res_string_at.ok, "-l") && res_string_at.ok > 2) {
            val err_directive_in: err[Fail] = directive_in(c, ?directive.LIBRARY, ?rest.data[at + 2], res_string_at.ok - 2);
            if (sel err_directive_in.err) { ret err_directive_in; }
            ret bare(rest, at + res_string_at.ok + 1);
        }
        val err_directive_in: err[Fail] = directive_in(c, ?directive.OPTION, ?rest.data[at], res_string_at.ok);
        if (sel err_directive_in.err) { ret err_directive_in; }
        at = at + res_string_at.ok + 1;
        i  = i + 1;
    }
    ret bare(rest, at);
}

fun directive_in(c: *Conv, k: *directive.Kind, p: *u8, n: usize) err[Fail] {
    val res_name: res[Id[Name], Fail] = object.name(c.o, p, n);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    val res_add_directive: res[Id[Directive], Fail] = object.add_directive(c.o, Directive{kind: k, text: res_name.ok, symbol: opt[Id[Name]].none{}});
    if (sel res_add_directive.err) { ret err[Fail].err{res_add_directive.err}; }
    ret err[Fail].ok{};
}

# the linker optimization hints, kept as their bytes
fun hints_in(c: *Conv, id: Id[Command]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[model.Blob](?c.m.blobs)) {
        val b: *model.Blob = model.blob_at(c.m, table.nth[model.Blob](i));
        i = i + 1;
        if (b.command.index != id.index || !sel b.part.data) { cnt; }
        if (!sel b.data.raw)                                 { ret err[Fail].err{fail.internal("the hints blob holds decoded data")}; }
        val bytes:    Bytes               = model.bytes(c.m, ?b.data.raw.bytes);
        val res_held: res[Contents, Fail] = own_bytes(c.o, bytes.data, bytes.len);
        if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
        ret add_fact(c.o, fact.LINKER_HINTS, 0, res_held.ok);
    }
    ret err[Fail].ok{};
}

# the data in code entries, each a fact on the section its address falls in,
# stated at its offset within that section: an object states them from the
# start of its one segment, whose address is zero. they are read once the
# sections are, which tells each entry its section's index
fun data_in_code_in(c: *Conv) err[Fail] {
    if (!sel c.dic.some) { ret err[Fail].ok{}; }
    var i: usize = 0;
    for (i < table.count[model.Blob](?c.m.blobs)) {
        val b: *model.Blob = model.blob_at(c.m, table.nth[model.Blob](i));
        i = i + 1;
        if (b.command.index != c.dic.some.index || !sel b.part.data) { cnt; }
        if (sel b.data.raw)                                          { ret err[Fail].err{fail.unsupported("the data in code table is held raw and has no neutral form")}; }
        if (!sel b.data.data_in_code)                                { ret err[Fail].err{fail.internal("the data in code blob holds no entries")}; }
        val t: *Vector[DataInCode] = ?b.data.data_in_code;
        var k: usize               = 0;
        for (k < vector.length[DataInCode](t)) {
            val e:                      *DataInCode = ?t.data[k];
            val err_data_in_code_entry: err[Fail]   = data_in_code_entry(c, e);
            if (sel err_data_in_code_entry.err) { ret err[Fail].err{fail.in_indexed(err_data_in_code_entry.err, "data in code entry", k::u64)}; }
            k = k + 1;
        }
    }
    ret err[Fail].ok{};
}

fun data_in_code_entry(c: *Conv, e: *DataInCode) err[Fail] {
    var n: usize = 0;
    for (n < vector.length[SectionRef](?c.ords.refs)) {
        val s: *model.Section = section_at(c, n);
        n = n + 1;
        if (s == nil || write.zerofill(s))                                { cnt; }
        if (e.offset::u64 < s.addr || e.offset::u64 >= s.addr + s.length) { cnt; }
        var halves: [4]u8;
        halves[0] = (e.length & 0xff)::u8;
        halves[1] = (e.length >> 8)::u8;
        halves[2] = (e.kind & 0xff)::u8;
        halves[3] = (e.kind >> 8)::u8;
        val res_data: res[Contents, Fail] = own_bytes(c.o, ?halves[0], 4);
        if (sel res_data.err) { ret err[Fail].err{res_data.err}; }
        val res_sec: res[u32, Fail] = neutral_section(c, n - 1);
        if (sel res_sec.err) { ret err[Fail].err{res_sec.err}; }
        ret add_fact(c.o, fact.DATA_IN_CODE, (res_sec.ok::u64 << 32) | (e.offset::u64 - s.addr), res_data.ok);
    }
    ret err[Fail].err{fail.unsupported("a data in code entry lies in no section of the file")};
}

fun section_at(c: *Conv, n: usize) *model.Section {
    val res_section: res[*model.Section, Fail] = model.section(c.m, c.ords.refs.data[n]);
    if (sel res_section.err) { ret nil; }
    ret res_section.ok;
}

fun sections_in(c: *Conv) err[Fail] {
    val n:           usize     = vector.length[SectionRef](?c.ords.refs);
    val err_reserve: err[Fail] = vectors.reserve[u32](?c.stand_ins, n);
    if (sel err_reserve.err) { ret err_reserve; }
    val err_reserve_map: err[Fail] = vectors.reserve[u32](?c.map, n);
    if (sel err_reserve_map.err) { ret err_reserve_map; }
    var i: usize = 0;
    for (i < n) {
        val err_stand_ins_pushed: err[Fail] = vectors.push[u32](?c.stand_ins, 0);
        if (sel err_stand_ins_pushed.err) { ret err[Fail].err{err_stand_ins_pushed.err}; }
        # a section of the object takes the next neutral index, the note and
        # a section of descriptors none
        val s:                      *model.Section = section_at(c, i);
        val held:                   bool           = s != nil && model.section_type(s) == tables.S_THREAD_LOCAL_VARIABLES.value::u32;
        val err_descriptors_pushed: err[Fail]      = vectors.push[bool](?c.descriptors, held);
        if (sel err_descriptors_pushed.err) { ret err[Fail].err{err_descriptors_pushed.err}; }
        var slot: u32 = 0;
        if (!is_mark(c, i) && !held) {
            slot = table.count[object.Section](?c.o.sections)::u32 + 1;
            val err_section_in: err[Fail] = section_in(c, i);
            if (sel err_section_in.err) { ret err[Fail].err{fail.in_indexed(err_section_in.err, "section", i::u64)}; }
        }
        val err_map_pushed: err[Fail] = vectors.push[u32](?c.map, slot);
        if (sel err_map_pushed.err) { ret err[Fail].err{err_map_pushed.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bytes a section's body holds, in `out`, as the file holds them
fun body_bytes(c: *Conv, s: *model.Section, out: *Sink) err[Fail] {
    val b: *Body = ?s.body;
    if (sel b.empty)  { ret err[Fail].ok{}; }
    or (sel b.raw)    { ret sink.bytes(out, model.bytes(c.m, ?b.raw.bytes).data, model.bytes(c.m, ?b.raw.bytes).len); }
    or (sel b.tlv)    { ret write.tlv_bytes(c.m.shape.class, ?b.tlv, out); }
    or (sel b.unwind) { ret unwind.encode_compact(out, ?b.unwind, c.m.shape.class.addr); }
    or (sel b.info)   { ret unwind.encode(out, c.m.a, ?b.info); }
    ret err[Fail].err{fail.unsupported("the section's body has no neutral form")};
}

fun section_in(c: *Conv, i: usize) err[Fail] {
    val s: *model.Section = section_at(c, i);
    if (s == nil) { ret err[Fail].err{fail.internal("a section of the ordinal list is not in its segment")}; }
    var spelled:     [33]u8;
    val len:         usize             = spell(?spelled[0], ?s.segname[0], ?s.sectname[0]);
    val name:        Bytes             = Bytes{data: ?spelled[0], len: len};
    val type:        u32               = model.section_type(s);
    val attrs:       u32               = model.section_attributes(s);
    val opt_type_of: opt[*naming.Type] = naming.type_of(type);
    if (sel opt_type_of.none) { ret err[Fail].err{fail.valued(fail.unsupported("the section type has no neutral form"), type::i128)}; }
    var derived: section.Flags = 0;
    if ((attrs::u64 & tables.S_ATTR_DEBUG.value) == 0) {
        val opt_seg: opt[section.Flags] = naming.segment_flags(Bytes{data: ?s.segname[0], len: name_len(?s.segname[0])});
        if (sel opt_seg.none) { ret err[Fail].err{fail.unsupported("the section lies in a segment the layout does not place")}; }
        derived = opt_seg.some;
        if ((attrs::u64 & naming.CODE) != 0) { derived = derived | section.EXEC; }
    }
    if ((attrs::u64 & tables.S_ATTR_NO_DEAD_STRIP.value) != 0) { derived = derived | section.RETAIN; }
    val res_classify: res[section.Key, Fail] = naming.classify(name, opt_type_of.some, derived, c.m.shape.class.addr::u64);
    if (sel res_classify.err) { ret err[Fail].err{res_classify.err}; }
    val kind:    *section.Kind          = res_classify.ok.kind;
    val flags:   section.Flags          = kind.flags | (derived & section.RETAIN);
    var entsize: u64                    = res_classify.ok.entsize;
    val res_row: res[*naming.Row, Fail] = naming.row_of(res_classify.ok);
    if (sel res_row.err) { ret err[Fail].err{res_row.err}; }
    var given: Bytes = name;
    if (res_row.ok.bare) { given = naming.split(name).section; }
    val res_name: res[Id[Name], Fail] = object.name(c.o, given.data, given.len);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    # compact unwind entries are records of a fixed size, one per function
    if (kind.use == ?section.CONSUMED_UNWIND) { entsize = c.m.shape.class.unwind.size::u64; }
    if (s.align > 63)                         { ret err[Fail].err{fail.malformed("section alignment is wider than an address")}; }
    var contents: Contents = Contents.zero{s.length};
    if (!write.zerofill(s)) {
        var out:            Sink                = sink.init(c.m.a, c.m.shape.order);
        val err_body_bytes: err[Fail]           = body_bytes(c, s, ?out);
        var res_own_bytes:  res[Contents, Fail] = res[Contents, Fail].err{fail.internal("no bytes were gathered")};
        if (sel err_body_bytes.err) { res_own_bytes = res[Contents, Fail].err{err_body_bytes.err}; }
        or                          { res_own_bytes = own_bytes(c.o, sink.data(?out), sink.len(?out)); }
        val err_rel: err[Fail] = sink.dnit(?out);
        if (sel res_own_bytes.err) { ret err[Fail].err{res_own_bytes.err}; }
        if (sel err_rel.err)       { ret err_rel; }
        contents = res_own_bytes.ok;
    }
    val res_added: res[Id[object.Section], Fail] = object.add_section(c.o, object.Section{
        name:        opt[Id[Name]].some{res_name.ok},
        kind:        kind,
        flags:       flags,
        align:       1::u64 << s.align::u64,
        entsize:     entsize,
        contents:    contents,
        disposition: disposition_of(kind, flags, c.subsections),
    });
    if (sel res_added.err) { ret err[Fail].err{res_added.err}; }
    ret section_facts(c, s, kind, flags, entsize, res_added.ok.index::u64, type, attrs);
}

# the facts a section's header states past what its kind writes
fun section_facts(c: *Conv, s: *model.Section, kind: *section.Kind, flags: section.Flags, entsize: u64, n: u64, type: u32, attrs: u32) err[Fail] {
    val res_row_of: res[*naming.Row, Fail] = naming.row_of(section.key_of(kind, entsize));
    if (sel res_row_of.err) { ret err[Fail].err{res_row_of.err}; }
    val written: *Constant = res_row_of.ok.type;
    if (written.value != type::u64) {
        val err_add_fact: err[Fail] = add_fact(c.o, fact.SECTION_TYPE, (n << 32) | type::u64, Contents.zero{0});
        if (sel err_add_fact.err) { ret err_add_fact; }
    }
    val derived: u64 = res_row_of.ok.attributes | tables.S_ATTR_EXT_RELOC.value | tables.S_ATTR_LOC_RELOC.value | retain_attr(flags);
    val extra:   u64 = attrs::u64 & ~derived;
    if (extra != 0) {
        val err_add_fact: err[Fail] = add_fact(c.o, fact.SECTION_ATTRIBUTES, (n << 32) | extra, Contents.zero{0});
        if (sel err_add_fact.err) { ret err_add_fact; }
    }
    if (s.reserved1 != 0 || s.reserved2 != 0 || s.reserved3 != 0) {
        var words: [12]u8;
        put_word(?words[0], s.reserved1);
        put_word(?words[4], s.reserved2);
        put_word(?words[8], s.reserved3);
        val res_data: res[Contents, Fail] = own_bytes(c.o, ?words[0], 12);
        if (sel res_data.err) { ret err[Fail].err{res_data.err}; }
        ret add_fact(c.o, fact.SECTION_RESERVED, n, res_data.ok);
    }
    ret err[Fail].ok{};
}

fun retain_attr(flags: section.Flags) u64 {
    if ((flags & section.RETAIN) != 0) { ret tables.S_ATTR_NO_DEAD_STRIP.value; }
    ret 0;
}

# a section the link drops is written debug-attributed, which a Mach-O link
# leaves out of an image. a kind no link places is written as its row writes
# it, as the link already takes it by its own row
fun excluded_attr(s: *object.Section) u64 {
    if ((s.flags & section.EXCLUDE) == 0 || !s.kind.use.placed) { ret 0; }
    ret tables.S_ATTR_DEBUG.value;
}

fun put_word(p: *u8, v: u32) {
    p[0] = (v & 0xff)::u8;
    p[1] = ((v >> 8) & 0xff)::u8;
    p[2] = ((v >> 16) & 0xff)::u8;
    p[3] = ((v >> 24) & 0xff)::u8;
}

fun get_word(p: *u8) u32 {
    ret p[0]::u32 | (p[1]::u32 << 8) | (p[2]::u32 << 16) | (p[3]::u32 << 24);
}

# the NUL-terminated name at `strx` in the string table
fun symbols_in(c: *Conv) err[Fail] {
    if (sel c.symbols.none) { ret err[Fail].ok{}; }
    val t: *model.Symbols = ?c.symbols.some;
    var k: usize          = 0;
    for (k < table.count[Nlist](t.symbols)) {
        val err_symbol_in: err[Fail] = symbol_in(c, t, k, table.at[Nlist](t.symbols, table.nth[Nlist](k)));
        if (sel err_symbol_in.err) { ret err[Fail].err{fail.in_indexed(err_symbol_in.err, "symbol", k::u64)}; }
        k = k + 1;
    }
    sort.sort_by[Atom](c.atoms.data, vector.length[Atom](?c.atoms), order_atoms);
    if (!c.subsections) { ret err[Fail].ok{}; }
    ret sizes_in(c);
}

fun symbol_in(c: *Conv, t: *model.Symbols, k: usize, e: *Nlist) err[Fail] {
    if (model.stab(e) != 0) { ret err[Fail].err{fail.unsupported("a debugging symbol has no neutral form")}; }
    val res_name: res[Bytes, Fail] = model.symbol_name(c.m, t, table.nth[Nlist](k));
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    val res_name_data: res[Id[Name], Fail] = object.name(c.o, res_name.ok.data, res_name.ok.len);
    if (sel res_name_data.err) { ret err[Fail].err{res_name_data.err}; }
    val ext:  bool         = model.external(e);
    val type: u8           = model.symbol_type(e);
    var desc: u16          = e.desc;
    var kind: *symbol.Kind = ?symbol.NOTYPE;
    var def:  Definition;
    if (type == tables.N_UNDF.value::u8) {
        if (e.value != 0) {
            if (!ext) { ret err[Fail].err{fail.malformed("a local undefined symbol states a value")}; }
            val shift: u64 = ((desc & COMM_ALIGN_BITS) >> COMM_ALIGN_AT)::u64;
            def  = Definition.common{object.Common{size: e.value, align: 1::u64 << shift}};
            desc = desc & ~COMM_ALIGN_BITS;
        }
    }
    or (type == tables.N_ABS.value::u8) { def = Definition.absolute{e.value}; }
    or (type == tables.N_SECT.value::u8) {
        val res_ref: res[opt[SectionRef], Fail] = model.symbol_section(?c.ords, t, table.nth[Nlist](k));
        if (sel res_ref.err)     { ret err[Fail].err{res_ref.err}; }
        if (sel res_ref.ok.none) { ret err[Fail].err{fail.malformed("a section symbol names no section")}; }
        val res_pos: res[usize, Fail] = ordinal_of(c, res_ref.ok.some);
        if (sel res_pos.err) { ret err[Fail].err{res_pos.err}; }
        val s: *model.Section = section_at(c, res_pos.ok);
        if (e.value < s.addr || e.value - s.addr > s.length) { ret err[Fail].err{fail.malformed("symbol lies outside its section")}; }
        if (descriptor(c, res_pos.ok)) {
            val res_variable_of: res[Place, Fail] = variable_of(c, res_pos.ok, e.value - s.addr);
            if (sel res_variable_of.err) { ret err[Fail].err{res_variable_of.err}; }
            def  = Definition.placed{res_variable_of.ok};
            kind = ?symbol.TLS;
        }
        or {
            val res_sec: res[u32, Fail] = neutral_section(c, res_pos.ok);
            if (sel res_sec.err) { ret err[Fail].err{fail.in_record(res_sec.err, "symbol")}; }
            def = Definition.placed{Place{section: Id[object.Section]{index: res_sec.ok}, offset: e.value - s.addr}};
        }
    }
    or { ret err[Fail].err{fail.unsupported("symbol type has no neutral form")}; }
    var binding: *symbol.Binding = ?symbol.LOCAL;
    if (ext) {
        binding = ?symbol.GLOBAL;
        if ((desc & tables.N_WEAK_DEF.value::u16) != 0 && !sel def.undefined) {
            binding = ?symbol.WEAKLY;
            desc    = desc & ~(tables.N_WEAK_DEF.value::u16);
        }
        or ((desc & tables.N_WEAK_REF.value::u16) != 0 && sel def.undefined) {
            binding = ?symbol.WEAKLY;
            desc    = desc & ~(tables.N_WEAK_REF.value::u16);
        }
    }
    var vis: *symbol.Visibility = ?symbol.DEFAULT;
    if (ext && model.private_external(e)) { vis = ?symbol.HIDDEN; }
    val retain: bool = model.no_dead_strip(e);
    val alt:    bool = model.alt_entry(e);
    desc = desc & ~(tables.N_NO_DEAD_STRIP.value::u16) & ~(tables.N_ALT_ENTRY.value::u16);
    val res_added: res[Id[object.Symbol], Fail] = object.add_symbol(c.o, object.Symbol{
        name:       res_name_data.ok,
        binding:    binding,
        visibility: vis,
        kind:       kind,
        def:        def,
        retain:     retain,
        alt_entry:  alt,
    });
    if (sel res_added.err) { ret err[Fail].err{res_added.err}; }
    if (desc != 0) {
        val err_add_fact: err[Fail] = add_fact(c.o, fact.SYMBOL_DESC, (k::u64 << 16) | desc::u64, Contents.zero{0});
        if (sel err_add_fact.err) { ret err_add_fact; }
    }
    if (sel def.placed) {
        val err_atoms_pushed: err[Fail] = vectors.push[Atom](?c.atoms, Atom{section: def.placed.section.index, offset: def.placed.offset, sym: k::u32, alt: alt});
        if (sel err_atoms_pushed.err) { ret err[Fail].err{err_atoms_pushed.err}; }
    }
    ret err[Fail].ok{};
}

# a placed symbol's size runs to the next symbol of its section that starts
# an atom, or to the section's end
fun sizes_in(c: *Conv) err[Fail] {
    val atoms: *Atom = c.atoms.data;
    val n:     usize = vector.length[Atom](?c.atoms);
    var i:     usize = 0;
    for (i < n) {
        val a: *Atom = ?atoms[i];
        var j: usize = i + 1;
        for (j < n && atoms[j].section == a.section && (atoms[j].alt || atoms[j].offset == a.offset)) { j = j + 1; }
        var end: u64 = object.size_of(c.o, object.section_at(c.o, Id[object.Section]{index: a.section}));
        if (j < n && atoms[j].section == a.section) { end = atoms[j].offset; }
        if (end < a.offset)                         { ret err[Fail].err{fail.in_indexed(fail.malformed("symbol lies past the end of its section"), "symbol", a.sym::u64)}; }
        object.symbol_at(c.o, Id[object.Symbol]{index: a.sym}).size = object.sized(end - a.offset);
        i                                                           = i + 1;
    }
    ret err[Fail].ok{};
}

# the atom of section `sec` holding offset `at` among `places`, sorted by
# order_atoms: the symbol of the greatest offset at or below it that starts an
# atom, none when no symbol lies at or before it
fun atom_at(places: *Vector[Atom], sec: u32, at: u64) opt[*Atom] {
    val atoms: *Atom = places.data;
    val n:     usize = vector.length[Atom](places);
    var probe: Atom  = Atom{section: sec, offset: at, sym: 0xffff_ffff};
    var lo:    usize = 0;
    var hi:    usize = n;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (order_atoms(?atoms[mid], ?probe) <= 0) { lo = mid + 1; }
        or                                         { hi = mid; }
    }
    for (lo > 0) {
        val a: *Atom = ?atoms[lo - 1];
        if (a.section != sec) { ret opt[*Atom].none{}; }
        if (!a.alt)           { ret opt[*Atom].some{a}; }
        lo = lo - 1;
    }
    ret opt[*Atom].none{};
}

# a symbol among `places`, sorted by order_atoms, at exactly offset `at` of
# section `sec`, the first by symbol, none when no symbol lies there
fun symbol_at_exactly(places: *Vector[Atom], sec: u32, at: u64) opt[*Atom] {
    val atoms: *Atom = places.data;
    val n:     usize = vector.length[Atom](places);
    var probe: Atom  = Atom{section: sec, offset: at, sym: 0};
    var lo:    usize = 0;
    var hi:    usize = n;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (order_atoms(?atoms[mid], ?probe) < 0) { lo = mid + 1; }
        or                                        { hi = mid; }
    }
    if (lo < n && atoms[lo].section == sec && atoms[lo].offset == at) { ret opt[*Atom].some{?atoms[lo]}; }
    ret opt[*Atom].none{};
}

# the symbol standing for section `sec`, made the first time it is asked for
fun stand_in(c: *Conv, sec: u32) res[Id[object.Symbol], Fail] {
    val slot: *u32 = ?c.stand_ins.data[sec::usize];
    if (@slot != 0) { ret res[Id[object.Symbol], Fail].ok{Id[object.Symbol]{index: @slot - 1}}; }
    val res_none: res[Id[Name], Fail] = object.name_str(c.o, "");
    if (sel res_none.err) { ret res[Id[object.Symbol], Fail].err{res_none.err}; }
    val res_added: res[Id[object.Symbol], Fail] = object.add_symbol(c.o, object.Symbol{
        name:       res_none.ok,
        binding:    ?symbol.LOCAL,
        visibility: ?symbol.DEFAULT,
        kind:       ?symbol.SECTIONS,
        def:        Definition.placed{Place{section: Id[object.Section]{index: sec}, offset: 0}},
    });
    if (sel res_added.err) { ret res_added; }
    @slot = res_added.ok.index + 1;
    ret res_added;
}

# the target a relocation that names section `sec` at offset `at` resolves
# to: the atom holding the offset when every symbol starts one, the section's
# stand-in otherwise, each with the offset left past the target
fun resolve(c: *Conv, sec: u32, at: i64) res[object.Reloc, Fail] {
    if (c.subsections && at >= 0) {
        val opt_atom_at: opt[*Atom] = atom_at(?c.atoms, sec, at:~u64);
        if (sel opt_atom_at.some) {
            ret res[object.Reloc, Fail].ok{object.Reloc{target: Target.symbol{Id[object.Symbol]{index: opt_atom_at.some.sym}}, addend: at - (opt_atom_at.some.offset:~i64)}};
        }
    }
    val res_stand_in: res[Id[object.Symbol], Fail] = stand_in(c, sec);
    if (sel res_stand_in.err) { ret res[object.Reloc, Fail].err{res_stand_in.err}; }
    ret res[object.Reloc, Fail].ok{object.Reloc{target: Target.symbol{res_stand_in.ok}, addend: at}};
}

# whether `t` is a symbol standing for a section, which the writer puts back
# as the section whatever the record
fun stands_in(c: *Conv, t: Target) bool {
    if (!sel t.symbol) { ret false; }
    ret object.symbol_at(c.o, t.symbol).kind == ?symbol.SECTIONS;
}

fun relocs_in(c: *Conv) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[SectionRef](?c.ords.refs)) {
        val err_section_relocs: err[Fail] = section_relocs(c, i, section_at(c, i));
        if (sel err_section_relocs.err) { ret err[Fail].err{fail.in_indexed(err_section_relocs.err, "section", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the relocation records of section `n`, in order: an ADDEND feeds the
# record after it, a SUBTRACTOR pairs with the UNSIGNED after it, and every
# other record is one relocation
fun section_relocs(c: *Conv, n: usize, s: *model.Section) err[Fail] {
    val count: usize = table.count[Reloc](?s.relocs);
    if (count == 0 || descriptor(c, n)) { ret err[Fail].ok{}; }
    if (write.zerofill(s))              { ret err[Fail].err{fail.malformed("a section with no bytes holds relocations")}; }
    # the note's relocations are kept apart, on its ordinal position, for
    # marks_in to decode; a section of the object takes its own
    c.to_marked = is_mark(c, n);
    var into:  u32   = n::u32;
    var bytes: Bytes = Bytes{};
    if (c.to_marked) {
        if (!sel s.body.raw) { ret err[Fail].err{fail.malformed("the mink note section holds no bytes")}; }
        bytes = model.bytes(c.m, ?s.body.raw.bytes);
    }
    or {
        val res_sec: res[u32, Fail] = neutral_section(c, n);
        if (sel res_sec.err) { ret err[Fail].err{res_sec.err}; }
        into = res_sec.ok;
        val own: *object.Section = object.section_at(c.o, Id[object.Section]{index: into});
        bytes = object.bytes(c.o, ?own.contents);
    }
    var k: usize = 0;
    for (k < count) {
        val r: *Reloc = table.at[Reloc](?s.relocs, table.nth[Reloc](k));
        if (sel r.scattered) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a scattered relocation has no neutral form"), "relocation", k::u64)}; }
        val p:          *Plain   = ?r.plain;
        var opt_addend: opt[i64] = opt[i64].none{};
        var at:         usize    = k;
        val marker:     bool     = sel c.addend_key.some && key.make(p.type::u32, p.length::u32, p.pcrel != 0) == c.addend_key.some;
        if (marker && p.external == 0) {
            opt_addend = opt[i64].some{model.signed(p.symbolnum::u64, ADDEND_BITS)};
            k          = k + 1;
            if (k >= count) { ret err[Fail].err{fail.in_indexed(fail.malformed("an ADDEND record ends the relocations"), "relocation", at::u64)}; }
        }
        val res_reloc_in: res[usize, Fail] = reloc_in(c, into::usize, s, bytes, k, opt_addend);
        if (sel res_reloc_in.err) { ret err[Fail].err{fail.in_indexed(res_reloc_in.err, "relocation", at::u64)}; }
        k = res_reloc_in.ok;
    }
    ret err[Fail].ok{};
}

# add a converted relocation: to the object, or to the note's relocations
# while the note section is being read
fun add_converted(c: *Conv, r: object.Reloc) err[Fail] {
    if (c.to_marked) {
        val res_marked_pushed: res[Id[object.Reloc], Fail] = table.push[object.Reloc](?c.marked, r);
        if (sel res_marked_pushed.err) { ret err[Fail].err{res_marked_pushed.err}; }
        ret err[Fail].ok{};
    }
    val res_added: res[Id[object.Reloc], Fail] = object.add_reloc(c.o, r);
    if (sel res_added.err) { ret err[Fail].err{res_added.err}; }
    ret err[Fail].ok{};
}

# the key of the set's record that carries the addend of the record after
# it, the one marker that takes no target, absent for a set with none
fun addend_key(l: *Lookup) opt[u32] {
    val s: *row.Set = l.set;
    var i: usize    = 0;
    for (i < s.count) {
        if (reloc.has(s.rows[i].kind, reloc.MARKER) && s.rows[i].kind.takes.nameless && !s.rows[i].kind.takes.named) { ret opt[u32].some{s.rows[i].key}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# one relocation from record `k`, which takes the record after it as well
# when it subtracts, returning the index of the next record
fun reloc_in(c: *Conv, n: usize, s: *model.Section, bytes: Bytes, k: usize, carried: opt[i64]) res[usize, Fail] {
    val count: usize  = table.count[Reloc](?s.relocs);
    val rl:    *Reloc = table.at[Reloc](?s.relocs, table.nth[Reloc](k));
    if (sel rl.scattered) { ret res[usize, Fail].err{fail.unsupported("a scattered relocation has no neutral form")}; }
    val p:     *Plain = ?rl.plain;
    val place: u64    = p.address::u64;
    if (place >= bytes.len::u64) { ret res[usize, Fail].err{fail.at_offset(fail.malformed("relocation lies past its section"), place)}; }
    var site:        Site            = Site{file: "section", section: "section", data: bytes.data, size: bytes.len::u64, offset: place, order: c.m.shape.order};
    val res_reading: res[*Row, Fail] = engine.reading(c.set, key.make(p.type::u32, p.length::u32, p.pcrel != 0), ?site);
    if (sel res_reading.err && sel res_reading.err.cause.unsupported) { ret res[usize, Fail].err{fail.valued(fail.unsupported("no relocation row has this type, length and pcrel"), p.type::i128)}; }
    if (sel res_reading.err)                                          { ret res[usize, Fail].err{res_reading.err}; }
    val r: *Row = res_reading.ok;
    if (sel carried.some && !sel r.addend.partner) { ret res[usize, Fail].err{fail.about(fail.malformed("an ADDEND record precedes a record that takes no partner"), r.name)}; }
    # a subtracting record is the first half of a difference
    val res_reloc_target: res[model.RelocTarget, Fail] = model.reloc_target(?c.ords, ?c.symbols, table.nth[Reloc](k), p);
    if (sel res_reloc_target.err) { ret res[usize, Fail].err{res_reloc_target.err}; }
    if (r.value == ?compute.SUB) {
        if (!sel res_reloc_target.ok.symbol) { ret res[usize, Fail].err{fail.unsupported("a subtracting record names a section")}; }
        if (k + 1 >= count)                  { ret res[usize, Fail].err{fail.malformed("a subtracting record ends the relocations")}; }
        val q: *Reloc = table.at[Reloc](?s.relocs, table.nth[Reloc](k + 1));
        if (sel q.scattered) { ret res[usize, Fail].err{fail.unsupported("a scattered relocation has no neutral form")}; }
        val u: *Plain = ?q.plain;
        if (u.address != p.address || u.length != p.length || u.pcrel != 0) { ret res[usize, Fail].err{fail.malformed("a subtracting record is not followed by the adding record at its place")}; }
        val res_reloc_target_ords: res[model.RelocTarget, Fail] = model.reloc_target(?c.ords, ?c.symbols, table.nth[Reloc](k + 1), u);
        if (sel res_reloc_target_ords.err)        { ret res[usize, Fail].err{res_reloc_target_ords.err}; }
        if (!sel res_reloc_target_ords.ok.symbol) { ret res[usize, Fail].err{fail.unsupported("a difference whose adding record names a section has no neutral form")}; }
        val res_pairing_of: res[Pairing, Fail] = pairing_of(c, r, key.make(u.type::u32, u.length::u32, false));
        if (sel res_pairing_of.err) { ret res[usize, Fail].err{res_pairing_of.err}; }
        val res_addend: res[i64, Fail] = engine.addend(res_pairing_of.ok.plus, ?site, 0);
        if (sel res_addend.err) { ret res[usize, Fail].err{res_addend.err}; }
        val err_added: err[Fail] = add_converted(c, object.Reloc{
            section: Id[object.Section]{index: n::u32},
            offset:  place,
            kind:    res_pairing_of.ok.difference.kind,
            target:  Target.symbol{Id[object.Symbol]{index: res_reloc_target_ords.ok.symbol.index}},
            addend:  res_addend.ok,
            minus:   opt[Id[object.Symbol]].some{Id[object.Symbol]{index: res_reloc_target.ok.symbol.index}},
        });
        if (sel err_added.err) { ret res[usize, Fail].err{err_added.err}; }
        ret res[usize, Fail].ok{k + 2};
    }
    var out: object.Reloc = object.Reloc{section: Id[object.Section]{index: n::u32}, offset: place, kind: r.kind};
    if (sel res_reloc_target.ok.symbol) {
        out.target = Target.symbol{Id[object.Symbol]{index: res_reloc_target.ok.symbol.index}};
        if (sel r.addend.field) {
            val res_addend: res[i64, Fail] = engine.addend(r, ?site, 0);
            if (sel res_addend.err) { ret res[usize, Fail].err{res_addend.err}; }
            out.addend = res_addend.ok;
            if (macho_pairs.counts_from_section(c.pair, r.key)) {
                out.addend = out.addend + (place:~i64);
                val err_put_addend: err[Fail] = engine.put_addend(r, ?site, out.addend);
                if (sel err_put_addend.err) { ret res[usize, Fail].err{err_put_addend.err}; }
            }
        }
        or (sel r.addend.partner) {
            if (sel carried.some) { out.addend = carried.some; }
        }
    }
    or (sel res_reloc_target.ok.absolute) {
        val res_absolute_in: res[i64, Fail] = absolute_in(r, ?site, s.addr + place);
        if (sel res_absolute_in.err) { ret res[usize, Fail].err{res_absolute_in.err}; }
        out.target = Target.absolute{};
        out.addend = res_absolute_in.ok;
    }
    or {
        if (!sel r.addend.field)                     { ret res[usize, Fail].err{fail.about(fail.unsupported("a relocation that names a section holds no addend in its field"), r.name)}; }
        if (sel r.names.symbol || sel r.names.exact) { ret res[usize, Fail].err{fail.about(fail.unsupported("a relocation of this kind names its target by a symbol, never a section"), r.name)}; }
        if (!sel res_reloc_target.ok.section)        { ret res[usize, Fail].err{fail.internal("a relocation target is neither a symbol nor a section")}; }
        val res_pos: res[usize, Fail] = ordinal_of(c, res_reloc_target.ok.section);
        if (sel res_pos.err) { ret res[usize, Fail].err{res_pos.err}; }
        val ordinal: usize          = res_pos.ok;
        val res_sec: res[u32, Fail] = neutral_section(c, ordinal);
        if (sel res_sec.err) { ret res[usize, Fail].err{fail.in_record(res_sec.err, "relocation")}; }
        val res_extract: res[i64, Fail] = engine.extract(r, ?site);
        if (sel res_extract.err) { ret res[usize, Fail].err{res_extract.err}; }
        var x:         compute.Inputs  = compute.Inputs{s: section_at(c, ordinal).addr, p: s.addr + place};
        val res_value: res[i128, Fail] = engine.value(r, ?site, ?x);
        if (sel res_value.err) { ret res[usize, Fail].err{res_value.err}; }
        # the field less the value to the section's start is the neutral
        # addend from the section, and the target lies where the field counts
        val res_rel: res[object.Reloc, Fail] = resolve(c, res_sec.ok, engine.target_offset(r, res_extract.ok - res_value.ok::i64)::i64);
        if (sel res_rel.err) { ret res[usize, Fail].err{res_rel.err}; }
        val res_placed_addend: res[i64, Fail] = engine.placed_addend(r, res_rel.ok.addend);
        if (sel res_placed_addend.err) { ret res[usize, Fail].err{res_placed_addend.err}; }
        out.target = res_rel.ok.target;
        out.addend = res_placed_addend.ok;
        # the field holds an address of the file's own layout, so the
        # neutral bytes take the addend as a record naming the symbol holds it
        val err_put_addend: err[Fail] = engine.put_addend(r, ?site, out.addend);
        if (sel err_put_addend.err) { ret res[usize, Fail].err{err_put_addend.err}; }
        if (!c.to_marked && !stands_in(c, res_rel.ok.target)) {
            val err_add_fact: err[Fail] = add_fact(c.o, fact.LOCAL_RECORD, table.count[object.Reloc](?c.o.relocs)::u64, Contents.zero{0});
            if (sel err_add_fact.err) { ret res[usize, Fail].err{err_add_fact.err}; }
        }
    }
    val err_added: err[Fail] = add_converted(c, out);
    if (sel err_added.err) { ret res[usize, Fail].err{err_added.err}; }
    ret res[usize, Fail].ok{k + 1};
}

# the neutral addend of a record of row `r` at `site`, whose place lies at
# `p`, against the absolute address zero: the field less what the row
# computes for a target of zero. the neutral bytes take it as a record naming
# a symbol holds it
fun absolute_in(r: *Row, site: *Site, p: u64) res[i64, Fail] {
    if (!sel r.addend.field) { ret res[i64, Fail].err{fail.about(fail.unsupported("a relocation against the absolute address zero holds no addend in its field"), r.name)}; }
    if (!sel r.names.either) { ret res[i64, Fail].err{fail.about(fail.unsupported("a relocation of this kind names its target by a symbol, never the absolute address zero"), r.name)}; }
    val res_extract: res[i64, Fail] = engine.extract(r, site);
    if (sel res_extract.err) { ret res[i64, Fail].err{res_extract.err}; }
    var x:         compute.Inputs  = compute.Inputs{s: 0, p: p};
    val res_value: res[i128, Fail] = engine.value(r, site, ?x);
    if (sel res_value.err) { ret res[i64, Fail].err{res_value.err}; }
    val a:   i128 = res_extract.ok::i128 - res_value.ok;
    val top: i128 = (1::i128) << 63;
    if (a < -top || a >= top) { ret res[i64, Fail].err{fail.valued(fail.about(fail.overflow("the addend against the absolute address zero does not fit 64 bits"), r.name), a)}; }
    val err_put_addend: err[Fail] = engine.put_addend(r, site, a::i64);
    if (sel err_put_addend.err) { ret res[i64, Fail].err{err_put_addend.err}; }
    ret res[i64, Fail].ok{a::i64};
}

# how the note's relocations order: by the section they patch, then by offset
fun order_marked(a: *object.Reloc, b: *object.Reloc) i64 {
    if (a.section.index < b.section.index) { ret -1; }
    if (a.section.index > b.section.index) { ret 1; }
    ret mark.order(a, b);
}

# the constant-time ranges every mink note section states, marked on the
# object: each section's bytes are one payload, its relocations the fields'
fun marks_in(c: *Conv) err[Fail] {
    val n: usize = table.count[object.Reloc](?c.marked);
    sort.sort_by[object.Reloc](table.items[object.Reloc](?c.marked), n, order_marked);
    var width: u8    = 0;
    var first: usize = 0;
    var i:     usize = 0;
    for (i < vector.length[SectionRef](?c.ords.refs)) {
        val k: usize = i;
        i = i + 1;
        if (!is_mark(c, k)) { cnt; }
        if (width == 0) {
            val res_width_of: res[u8, Fail] = macho_mark.width_of(c.o);
            if (sel res_width_of.err) { ret err[Fail].err{fail.in_indexed(res_width_of.err, "section", k::u64)}; }
            width = res_width_of.ok;
        }
        var count: usize = 0;
        for (first + count < n && table.items[object.Reloc](?c.marked)[first + count].section.index::usize == k) {
            count = count + 1;
        }
        val s:    *model.Section = section_at(c, k);
        var data: Bytes          = Bytes{};
        if (sel s.body.raw)    { data = model.bytes(c.m, ?s.body.raw.bytes); }
        or (!sel s.body.empty) { ret err[Fail].err{fail.in_indexed(fail.malformed("the mink note section holds no bytes"), "section", k::u64)}; }
        val res_run: res[mark.Run, Fail] = mark.decode(c.o, data, 0, s.offset::u64, width, c.m.shape.order, ?table.items[object.Reloc](?c.marked)[first], count);
        if (sel res_run.err)           { ret err[Fail].err{fail.in_indexed(res_run.err, "section", k::u64)}; }
        if (res_run.ok.count != count) { ret err[Fail].err{fail.in_indexed(fail.malformed("a relocation of the mink note section patches no payload"), "section", k::u64)}; }
        first = first + count;
    }
    ret err[Fail].ok{};
}

# the pairing whose subtracting row is `minus` and whose adding row has the
# key `plus`
fun pairing_of(c: *Conv, minus: *Row, plus: u32) res[Pairing, Fail] {
    val s: *row.Set = c.set.set;
    var i: usize    = 0;
    for (i < s.difference_count) {
        val d: *row.Difference = ?s.differences[i];
        if (d.minus == minus.key && d.plus == plus) { ret row.difference_of(c.set, d.kind); }
        i = i + 1;
    }
    ret res[Pairing, Fail].err{fail.about(fail.malformed("the adding record is not the one the subtracting record pairs with"), minus.name)};
}

# a section of the file at its address in the object's one segment
rec Span {
    addr:    u64;
    length:  u64;
    ordinal: usize;
}

fun by_addr(a: *Span, b: *Span) i64 {
    if (a.addr < b.addr)       { ret -1; }
    if (a.addr > b.addr)       { ret 1; }
    if (a.ordinal < b.ordinal) { ret -1; }
    if (a.ordinal > b.ordinal) { ret 1; }
    ret 0;
}

fun by_value(a: *u64, b: *u64) i64 {
    if (@a < @b) { ret -1; }
    if (@a > @b) { ret 1; }
    ret 0;
}

# the call frame tables a runtime unwinder reads, whose place-relative
# pointers clang writes with no relocation record, as the linker finds them
# by reading the table: each FDE's function start and language data and
# each CIE's personality routine that no record patches is stated as a
# relocation to the atom it lands in, of the place-relative kind of its
# width, which the set resolves in place, its addend in its field. a pointer
# of another base is left as read
fun frames_in(c: *Conv) err[Fail] {
    c.to_marked = false;
    var spans:        Vector[Span]      = vector.init[Span](c.m.a);
    var patched:      Vector[u64]       = vector.init[u64](c.m.a);
    var cies:         Vector[parse.Cie] = vector.init[parse.Cie](c.m.a);
    var err_spans_in: err[Fail]         = err[Fail].ok{};
    var laid:         bool              = false;
    var i:            usize             = 0;
    for (i < vector.length[SectionRef](?c.ords.refs) && sel err_spans_in.ok) {
        val k: usize = i;
        i = i + 1;
        if (is_mark(c, k) || descriptor(c, k)) { cnt; }
        val res_sec: res[u32, Fail] = neutral_section(c, k);
        if (sel res_sec.err) {
            err_spans_in = err[Fail].err{fail.in_indexed(res_sec.err, "section", k::u64)};
            cnt;
        }
        val own: *object.Section = object.section_at(c.o, Id[object.Section]{index: res_sec.ok});
        if (!own.kind.use.placed || !section.has(own.kind, section.UNWIND) || sel own.contents.zero) { cnt; }
        if (!laid) {
            laid         = true;
            err_spans_in = spans_in(c, ?spans);
            if (sel err_spans_in.err) { cnt; }
        }
        val err_frame_table: err[Fail] = frame_table(c, k, res_sec.ok, ?spans, ?patched, ?cies);
        if (sel err_frame_table.err) { err_spans_in = err[Fail].err{fail.in_indexed(err_frame_table.err, "section", k::u64)}; }
    }
    err_spans_in = fail.kept(err_spans_in, vectors.dnit[Span](?spans));
    err_spans_in = fail.kept(err_spans_in, vectors.dnit[u64](?patched));
    ret fail.kept(err_spans_in, vectors.dnit[parse.Cie](?cies));
}

# the sections of the object by address
fun spans_in(c: *Conv, spans: *Vector[Span]) err[Fail] {
    var j: usize = 0;
    for (j < vector.length[SectionRef](?c.ords.refs)) {
        val k: usize = j;
        j = j + 1;
        if (is_mark(c, k)) { cnt; }
        val s: *model.Section = section_at(c, k);
        if (s == nil) { ret err[Fail].err{fail.internal("a section of the ordinal list is not in its segment")}; }
        val err_spans_pushed: err[Fail] = vectors.push[Span](spans, Span{addr: s.addr, length: s.length, ordinal: k});
        if (sel err_spans_pushed.err) { ret err[Fail].err{err_spans_pushed.err}; }
    }
    sort.sort_by[Span](spans.data, vector.length[Span](spans), by_addr);
    ret err[Fail].ok{};
}

# the section holding the address `at`, none for none
fun span_at(spans: *Vector[Span], at: u64) opt[Span] {
    var lo: usize = 0;
    var hi: usize = vector.length[Span](spans);
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (spans.data[mid].addr <= at) { lo = mid + 1; }
        or                              { hi = mid; }
    }
    for (lo > 0) {
        val s: Span = spans.data[lo - 1];
        lo = lo - 1;
        if (at - s.addr < s.length) { ret opt[Span].some{s}; }
        if (s.length != 0)          { brk; }
    }
    ret opt[Span].none{};
}

# whether `values`, ordered, holds `v`
fun holds_value(values: *Vector[u64], v: u64) bool {
    var lo: usize = 0;
    var hi: usize = vector.length[u64](values);
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (values.data[mid] < v) { lo = mid + 1; }
        or                        { hi = mid; }
    }
    ret lo < vector.length[u64](values) && values.data[lo] == v;
}

# the implicit pointers of the call frame table at ordinal position `k`,
# the neutral section `sec`
fun frame_table(c: *Conv, k: usize, sec: u32, spans: *Vector[Span], patched: *Vector[u64], cies: *Vector[parse.Cie]) err[Fail] {
    vector.clear[u64](patched);
    vector.clear[parse.Cie](cies);
    var ri: usize = 0;
    for (ri < table.count[object.Reloc](?c.o.relocs)) {
        val rel: *object.Reloc = table.at[object.Reloc](?c.o.relocs, table.nth[object.Reloc](ri));
        ri = ri + 1;
        if (rel.section.index != sec) { cnt; }
        val err_patched_pushed: err[Fail] = vectors.push[u64](patched, rel.offset);
        if (sel err_patched_pushed.err) { ret err[Fail].err{err_patched_pushed.err}; }
    }
    sort.sort_by[u64](patched.data, vector.length[u64](patched), by_value);
    val own:     *object.Section = object.section_at(c.o, Id[object.Section]{index: sec});
    val bytes:   Bytes           = object.bytes(c.o, ?own.contents);
    val s:       *model.Section  = section_at(c, k);
    val address: u8              = c.m.shape.class.addr::u8;
    var r:       Reader          = reader.make("section", bytes.data, bytes.len, c.m.shape.order);
    var off:     u64             = 0;
    for (off < bytes.len::u64) {
        val res_framed: res[Framed, Fail] = parse.framed(?r, off, bytes.len::u64);
        if (sel res_framed.err)       { ret err[Fail].err{res_framed.err}; }
        if (sel res_framed.ok.broken) { ret err[Fail].err{fail.at_offset(fail.malformed("a call frame record does not frame within its table"), off)}; }
        or (sel res_framed.ok.ended)  { brk; }
        val rec: parse.Record = res_framed.ok.record;
        off = rec.end;
        if (sel rec.cie.none) {
            val res_cie: res[parse.Cie, Fail] = parse.cie(?r, rec, address);
            if (sel res_cie.err) { ret err[Fail].err{fail.at_offset(res_cie.err, rec.start)}; }
            val err_cies_pushed: err[Fail] = vectors.push[parse.Cie](cies, res_cie.ok);
            if (sel err_cies_pushed.err) { ret err[Fail].err{err_cies_pushed.err}; }
            if (sel res_cie.ok.personality.some) {
                val err_implicit: err[Fail] = implicit(c, sec, bytes, s, spans, patched, res_cie.ok.personality.some);
                if (sel err_implicit.err) { ret err_implicit; }
            }
            cnt;
        }
        val named: *parse.Cie = parse.cie_at(cies, rec.cie.some);
        if (named == nil) { ret err[Fail].err{fail.at_offset(fail.malformed("an FDE names no CIE of its table"), rec.start)}; }
        val res_fde: res[parse.Fde, Fail] = parse.fde(?r, rec, named, address);
        if (sel res_fde.err) { ret err[Fail].err{fail.at_offset(res_fde.err, rec.start)}; }
        val err_implicit: err[Fail] = implicit(c, sec, bytes, s, spans, patched, res_fde.ok.begin);
        if (sel err_implicit.err) { ret err_implicit; }
        if (sel res_fde.ok.lsda.some) {
            val err_implicit: err[Fail] = implicit(c, sec, bytes, s, spans, patched, res_fde.ok.lsda.some);
            if (sel err_implicit.err) { ret err_implicit; }
        }
    }
    ret err[Fail].ok{};
}

# the pointer `p` of the neutral section `sec`, whose bytes are `bytes` and
# whose file section is `s`, as a relocation when it is place-relative and
# no record patches it
fun implicit(c: *Conv, sec: u32, bytes: Bytes, s: *model.Section, spans: *Vector[Span], patched: *Vector[u64], p: parse.Pointer) err[Fail] {
    if (p.encoding.base != ?pointer.PCREL || holds_value(patched, p.at)) { ret err[Fail].ok{}; }
    val res_kind: res[*reloc.Kind, Fail] = reloc.relative_of(p.size);
    if (sel res_kind.err) { ret err[Fail].err{fail.at_offset(res_kind.err, p.at)}; }
    val res_targeting: res[*Row, Fail] = row.targeting(c.set, res_kind.ok, false);
    if (sel res_targeting.err)                { ret err[Fail].err{fail.at_offset(res_targeting.err, p.at)}; }
    if (!sel res_targeting.ok.write.resolved) { ret err[Fail].err{fail.at_offset(fail.about(fail.unsupported("a place-relative pointer of the call frame table that no record patches is resolved in place by no row of its width"), res_kind.ok.name), p.at)}; }
    val aimed:       u64       = parse.aimed(p, s.addr);
    val opt_span_at: opt[Span] = span_at(spans, aimed);
    if (sel opt_span_at.none) { ret err[Fail].err{fail.at_offset(fail.malformed("a pointer of the call frame table names no section"), p.at)}; }
    val res_neutral_section: res[u32, Fail] = neutral_section(c, opt_span_at.some.ordinal);
    if (sel res_neutral_section.err) { ret err[Fail].err{fail.at_offset(res_neutral_section.err, p.at)}; }
    val res_rel: res[object.Reloc, Fail] = resolve(c, res_neutral_section.ok, (aimed - opt_span_at.some.addr):~i64);
    if (sel res_rel.err) { ret err[Fail].err{res_rel.err}; }
    var site:    Site      = Site{file: "section", section: "section", data: bytes.data, size: bytes.len::u64, offset: p.at, order: c.m.shape.order};
    val err_put: err[Fail] = engine.put_addend(res_targeting.ok, ?site, res_rel.ok.addend);
    if (sel err_put.err) { ret err_put; }
    ret add_converted(c, object.Reloc{section: Id[object.Section]{index: sec}, offset: p.at, kind: res_targeting.ok.kind, target: res_rel.ok.target, addend: res_rel.ok.addend});
}

# the place of each thread-local variable a section of descriptors names,
# section by section, each descriptor read whole: its accessor word binding
# the loader's accessor, its key zero, and its offset word naming the place
# of the variable's initial value in a thread-local section
fun descriptors_in(c: *Conv) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[SectionRef](?c.ords.refs)) {
        val err_firsts_pushed: err[Fail] = vectors.push[u32](?c.firsts, table.count[Place](?c.places)::u32);
        if (sel err_firsts_pushed.err) { ret err[Fail].err{err_firsts_pushed.err}; }
        i = i + 1;
        if (!descriptor(c, i - 1)) { cnt; }
        val err_descriptors_of: err[Fail] = descriptors_of(c, i - 1);
        if (sel err_descriptors_of.err) { ret err[Fail].err{fail.in_indexed(err_descriptors_of.err, "section", (i - 1)::u64)}; }
    }
    ret err[Fail].ok{};
}

# the words of each descriptor of section `n` its relocations patch, a bit
# per word
val THUNK_WORD:  u8 = 1;
val OFFSET_WORD: u8 = 2;

fun descriptors_of(c: *Conv, n: usize) err[Fail] {
    val s: *model.Section = section_at(c, n);
    if (!sel s.body.tlv) { ret err[Fail].err{fail.unsupported("a section of thread-local variable descriptors does not hold whole descriptors")}; }
    val opt_sys: opt[*System] = c.o.target.sys;
    if (sel opt_sys.none) { ret err[Fail].err{fail.unsupported("the object names no system in a version command, and its thread-local variable descriptors need an accessor that only the system's loader provides")}; }
    val res_accessor: res[str, Fail] = os.system_symbol(opt_sys.some, ?os.TLV_BOOTSTRAP);
    if (sel res_accessor.err) { ret err[Fail].err{res_accessor.err}; }
    val count: usize = vector.length[model.Tlv](?s.body.tlv);
    if (count != 0) {
        val res_grow: res[Id[Place], Fail] = table.grow[Place](?c.places, count);
        if (sel res_grow.err) { ret err[Fail].err{res_grow.err}; }
    }
    var seen: Vector[u8] = vector.init[u8](c.m.a);
    if (count != 0) {
        val err_grow: err[Fail] = vectors.grow[u8](?seen, count);
        if (sel err_grow.err) { ret fail.kept(err[Fail].err{err_grow.err}, vectors.dnit[u8](?seen)); }
    }
    val err_descriptor_words: err[Fail] = descriptor_words(c, n, s, ?s.body.tlv, res_accessor.ok, ?seen);
    ret fail.kept(err_descriptor_words, vectors.dnit[u8](?seen));
}

fun descriptor_words(c: *Conv, n: usize, s: *model.Section, tlvs: *Vector[model.Tlv], accessor: str, seen: *Vector[u8]) err[Fail] {
    val shape:   *model.TlvShape        = ?c.m.shape.class.tlv;
    val size:    u64                    = shape.size::u64;
    val first:   usize                  = c.firsts.data[n]::usize;
    val res_abs: res[*reloc.Kind, Fail] = reloc.absolute_of(c.m.shape.class.addr::u8);
    if (sel res_abs.err) { ret err[Fail].err{res_abs.err}; }
    val res_word: res[*Row, Fail] = row.targeting(c.set, res_abs.ok, false);
    if (sel res_word.err) { ret err[Fail].err{res_word.err}; }
    var k: usize = 0;
    for (k < table.count[Reloc](?s.relocs)) {
        val rl: *Reloc = table.at[Reloc](?s.relocs, table.nth[Reloc](k));
        k = k + 1;
        if (sel rl.scattered) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a scattered relocation has no neutral form"), "relocation", (k - 1)::u64)}; }
        val p: *Plain = ?rl.plain;
        if (key.make(p.type::u32, p.length::u32, p.pcrel != 0) != res_word.ok.key) {
            ret err[Fail].err{fail.in_indexed(fail.unsupported("a relocation of a thread-local variable descriptor is not a pointer of its word"), "relocation", (k - 1)::u64)};
        }
        val i: u64 = p.address::u64 / size;
        val f: u64 = p.address::u64 - i * size;
        if (i >= vector.length[model.Tlv](tlvs)::u64) { ret err[Fail].err{fail.in_indexed(fail.at_offset(fail.malformed("relocation lies past its section"), p.address::u64), "relocation", (k - 1)::u64)}; }
        val d:                *model.Tlv                   = ?tlvs.data[i::usize];
        val bit:              *u8                          = ?seen.data[i::usize];
        val res_reloc_target: res[model.RelocTarget, Fail] = model.reloc_target(?c.ords, ?c.symbols, table.nth[Reloc](k - 1), p);
        if (sel res_reloc_target.err) { ret err[Fail].err{fail.in_indexed(res_reloc_target.err, "relocation", (k - 1)::u64)}; }
        var err_binds_accessor: err[Fail] = err[Fail].ok{};
        if (f == shape.thunk.offset::u64) {
            if ((@bit & THUNK_WORD) != 0) { ret err[Fail].err{fail.in_indexed(fail.malformed("two relocations patch one word of a thread-local variable descriptor"), "relocation", (k - 1)::u64)}; }
            @bit               = @bit | THUNK_WORD;
            err_binds_accessor = binds_accessor(c, res_reloc_target.ok, d.thunk, accessor);
        }
        or (f == shape.offset.offset::u64) {
            if ((@bit & OFFSET_WORD) != 0) { ret err[Fail].err{fail.in_indexed(fail.malformed("two relocations patch one word of a thread-local variable descriptor"), "relocation", (k - 1)::u64)}; }
            @bit = @bit | OFFSET_WORD;
            val res_variable_place: res[Place, Fail] = variable_place(c, res_reloc_target.ok, d.offset);
            if (sel res_variable_place.err) { err_binds_accessor = err[Fail].err{res_variable_place.err}; }
            or (sel res_variable_place.ok)  { table.items[Place](?c.places)[first + i::usize] = res_variable_place.ok; }
        }
        or                              { err_binds_accessor = err[Fail].err{fail.unsupported("a relocation patches a thread-local variable descriptor's key")}; }
        if (sel err_binds_accessor.err) { ret err[Fail].err{fail.in_indexed(err_binds_accessor.err, "relocation", (k - 1)::u64)}; }
    }
    var i: usize = 0;
    for (i < vector.length[model.Tlv](tlvs)) {
        val d: *model.Tlv = ?tlvs.data[i];
        if (d.key != 0)                                 { ret err[Fail].err{fail.in_indexed(fail.unsupported("a thread-local variable descriptor's key holds a value the loader does not set"), "descriptor", i::u64)}; }
        if (seen.data[i] != (THUNK_WORD | OFFSET_WORD)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a thread-local variable descriptor binds no accessor or names no variable"), "descriptor", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# refuse an accessor word that does not bind the loader's accessor `accessor`
# with no addend
fun binds_accessor(c: *Conv, tg: model.RelocTarget, field: u64, accessor: str) err[Fail] {
    if (!sel tg.symbol)     { ret err[Fail].err{fail.unsupported("a thread-local variable descriptor's accessor word names no symbol")}; }
    if (sel c.symbols.none) { ret err[Fail].err{fail.internal("a relocation names a symbol of a file with no symbol table")}; }
    val t: *model.Symbols = ?c.symbols.some;
    val e: *Nlist         = table.at[Nlist](t.symbols, tg.symbol);
    if (model.symbol_type(e) != tables.N_UNDF.value::u8 || e.value != 0 || !model.external(e)) {
        ret err[Fail].err{fail.unsupported("a thread-local variable descriptor's accessor word names a symbol the object defines")};
    }
    val res_name: res[Bytes, Fail] = model.symbol_name(c.m, t, tg.symbol);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    if (res_name.ok.len != str_len(accessor) || !memory.raw_equal(res_name.ok.data::ptr, accessor::ptr, res_name.ok.len)) {
        ret err[Fail].err{fail.unsupported("a thread-local variable descriptor binds what is not the loader's accessor")};
    }
    if (field != 0) { ret err[Fail].err{fail.unsupported("a thread-local variable descriptor's accessor word holds an addend")}; }
    ret err[Fail].ok{};
}

# the place in a thread-local section the offset word naming `tg` with the
# field `field` names: past a symbol by the field, or the field's address in
# a section
fun variable_place(c: *Conv, tg: model.RelocTarget, field: u64) res[Place, Fail] {
    val at:  Location = Location{record: "thread-local variable descriptor"};
    var pos: usize    = 0;
    var adr: u64      = 0;
    if (sel tg.symbol) {
        if (sel c.symbols.none) { ret res[Place, Fail].err{fail.internal("a relocation names a symbol of a file with no symbol table")}; }
        val t: *model.Symbols = ?c.symbols.some;
        val e: *Nlist         = table.at[Nlist](t.symbols, tg.symbol);
        if (model.symbol_type(e) != tables.N_SECT.value::u8) { ret res[Place, Fail].err{fail.unsupported("a thread-local variable descriptor's offset word names a symbol no section holds")}; }
        val res_ref: res[opt[SectionRef], Fail] = model.symbol_section(?c.ords, t, tg.symbol);
        if (sel res_ref.err)     { ret res[Place, Fail].err{res_ref.err}; }
        if (sel res_ref.ok.none) { ret res[Place, Fail].err{fail.malformed("a section symbol names no section")}; }
        val res_ordinal_of: res[usize, Fail] = ordinal_of(c, res_ref.ok.some);
        if (sel res_ordinal_of.err) { ret res[Place, Fail].err{res_ordinal_of.err}; }
        val res_sum: res[u64, Fail] = checked.add(at, e.value, field);
        if (sel res_sum.err) { ret res[Place, Fail].err{res_sum.err}; }
        pos = res_ordinal_of.ok;
        adr = res_sum.ok;
    }
    or (sel tg.section) {
        val res_ordinal_of: res[usize, Fail] = ordinal_of(c, tg.section);
        if (sel res_ordinal_of.err) { ret res[Place, Fail].err{res_ordinal_of.err}; }
        pos = res_ordinal_of.ok;
        adr = field;
    }
    or { ret res[Place, Fail].err{fail.unsupported("a thread-local variable descriptor's offset word names the absolute address zero")}; }
    val res_sec: res[u32, Fail] = neutral_section(c, pos);
    if (sel res_sec.err) { ret res[Place, Fail].err{res_sec.err}; }
    val own: *object.Section = object.section_at(c.o, Id[object.Section]{index: res_sec.ok});
    if ((own.flags & section.TLS) == 0) { ret res[Place, Fail].err{fail.malformed("a thread-local variable descriptor's variable lies in no thread-local section")}; }
    val s: *model.Section = section_at(c, pos);
    if (adr < s.addr || adr - s.addr > s.length) { ret res[Place, Fail].err{fail.malformed("a thread-local variable descriptor's variable lies outside its section")}; }
    ret res[Place, Fail].ok{Place{section: Id[object.Section]{index: res_sec.ok}, offset: adr - s.addr}};
}

# the place of the variable a symbol at `offset` of the section of
# descriptors at ordinal position `n` names, which must start a descriptor
fun variable_of(c: *Conv, n: usize, offset: u64) res[Place, Fail] {
    val size: u64            = c.m.shape.class.tlv.size::u64;
    val s:    *model.Section = section_at(c, n);
    val i:    u64            = offset / size;
    if (!sel s.body.tlv) { ret res[Place, Fail].err{fail.internal("a section of descriptors holds no descriptors")}; }
    if (offset - i * size != 0 || i >= vector.length[model.Tlv](?s.body.tlv)::u64) {
        ret res[Place, Fail].err{fail.malformed("a symbol lies inside a thread-local variable descriptor rather than at its start")};
    }
    ret res[Place, Fail].ok{table.items[Place](?c.places)[c.firsts.data[n]::usize + i::usize]};
}

fun convert(c: *Conv) err[Fail] {
    val err_begin: err[Fail] = begin(c);
    if (sel err_begin.err) { ret err_begin; }
    val err_commands_in: err[Fail] = commands_in(c);
    if (sel err_commands_in.err) { ret err_commands_in; }
    val err_sections_in: err[Fail] = sections_in(c);
    if (sel err_sections_in.err) { ret err_sections_in; }
    val err_descriptors_in: err[Fail] = descriptors_in(c);
    if (sel err_descriptors_in.err) { ret err_descriptors_in; }
    val err_data_in_code_in: err[Fail] = data_in_code_in(c);
    if (sel err_data_in_code_in.err) { ret err_data_in_code_in; }
    val err_symbols_in: err[Fail] = symbols_in(c);
    if (sel err_symbols_in.err) { ret err_symbols_in; }
    val err_relocs_in: err[Fail] = relocs_in(c);
    if (sel err_relocs_in.err) { ret err_relocs_in; }
    val err_frames_in: err[Fail] = frames_in(c);
    if (sel err_frames_in.err) { ret err_frames_in; }
    ret marks_in(c);
}

# add what the model holds to `o`, which holds nothing yet, its relocations
# read through the rows of `rows`. the conversion builds a blank object and
# commits it to `o` once it succeeds, so a refusal leaves `o` as it was
pub fun to_neutral(m: *MachO, rows: *Registry, o: *Object) err[Fail] {
    if (!object.is_empty(o)) { ret err[Fail].err{fail.internal("a model converts into an empty neutral object")}; }
    var built:    Object                    = object.blank_init(o);
    val res_ords: res[model.Ordinals, Fail] = model.ordinals(m);
    if (sel res_ords.err) {
        val err_gone: err[Fail] = object.dnit(?built);
        ret err[Fail].err{res_ords.err};
    }
    var c:           Conv      = Conv{m: m, o: ?built, reg: rows, ords: res_ords.ok, symbols: model.symbol_table(m), atoms: vector.init[Atom](m.a), stand_ins: vector.init[u32](m.a), map: vector.init[u32](m.a), marked: table.init[object.Reloc](m.a), descriptors: vector.init[bool](m.a), firsts: vector.init[u32](m.a), places: table.init[Place](m.a)};
    var err_convert: err[Fail] = convert(?c);
    err_convert = fail.kept(err_convert, vectors.dnit[bool](?c.descriptors));
    err_convert = fail.kept(err_convert, vectors.dnit[u32](?c.firsts));
    err_convert = fail.kept(err_convert, table.dnit[Place](?c.places));
    err_convert = fail.kept(err_convert, model.ordinals_dnit(?c.ords));
    err_convert = fail.kept(err_convert, vectors.dnit[u32](?c.map));
    err_convert = fail.kept(err_convert, table.dnit[object.Reloc](?c.marked));
    err_convert = fail.kept(err_convert, vectors.dnit[Atom](?c.atoms));
    err_convert = fail.kept(err_convert, vectors.dnit[u32](?c.stand_ins));
    if (sel err_convert.err) {
        val err_dropped: err[Fail] = object.dnit(?built);
        ret err_convert;
    }
    ret object.commit(o, ?built);
}

# one section of the model being built
# ---
# segname, sectname: its names
# addr:     its address in the object
# size:     its size
# zerofill: whether it has no bytes in the file
# type, attrs:       its type and attributes
# bytes:  its bytes, patched with its relocations' fields
# relocs: its relocation records, in order
rec Out {
    segname:  [16]u8;
    sectname: [16]u8;
    addr:     u64;
    size:     u64;
    zerofill: bool;
    type:     u32;
    attrs:    u32;
    bytes:    Sink;
    relocs:   Table[Reloc];
}

# the model being built
# ---
# o:        the object, or the lowered copy of it
# outs:     per neutral section, what is built of it
# perm:     per neutral symbol, its symbol table index plus one, or zero
#           for a symbol written as its section
# nlist:    the symbol table
# names:    the string table
# sym_ids:  per symbol table entry, its name in the string table
# desc:     per neutral symbol, the n_desc bits its facts state
# exported: per neutral symbol, whether an export directive is about it,
#           which it states as an external symbol that is not private
# types:    per neutral section, the type a fact states, plus one
# attrs:    per neutral section, the attributes a fact states
# reserved: per neutral section, the reserved words a fact states
# local:    per relocation, whether a fact states it was a local record
# flags:    the header flags a fact states
# caps:     the cpusubtype capability bits a fact states
# segment:  the segment fact, when one is stated
# min_cmd:  the LC_VERSION_MIN command the target is written as, zero for
#           LC_BUILD_VERSION
# tools:    the build tools the facts state
# hints:    the linker optimization hints the facts state
# dices:    the data in code entries the facts state, each on its section
# starts:   per neutral section, the symbol table index plus one of the start
#           of the output section it lands in, which a section offset into it
#           subtracts, or zero for a section no section offset names
# locals, externs, undefs: how many symbols each range of the table holds
rec Build {
    a:        *A.Allocator;
    o:        *Object;
    lowering: opt[*Lowering];
    copy:     opt[Object];
    m:        MachO;
    reg:      *Registry;
    target:   *target_model.Target;
    pair:     *Pair;
    set:      *Lookup;
    cls:      *Class;
    order:    Order;
    nsec:     usize;
    nsym:     usize;
    outs:     Vector[Out];
    perm:     Vector[u32];
    nlist:    Table[Nlist];
    names:    Strtab;
    sym_ids:  Vector[Id[Name]];
    desc:     Vector[u16];
    exported: Vector[bool];
    types:    Vector[u32];
    attrs:    Vector[u32];
    reserved: Vector[u32];
    local:    Vector[bool];
    flags:    u32;
    caps:     u32;
    segment:  opt[*Fact];
    min_cmd:  u32;
    tools:    Vector[model.Tool];
    hints:    opt[*Fact];
    dices:    Vector[Dice];
    starts:   Vector[u32];
    locals:   u32;
    externs:  u32;
    undefs:   u32;
    content:  u64;
    vmsize:   u64;
    base:     u64;
    seg_cmd:  Id[Command];
    sym_cmd:  Id[Command];
    hint_cmd: Id[Command];
    dic_cmd:  Id[Command];
    strings:  Held;
}

# one data in code entry before its section has a file offset
rec Dice {
    section: u32;
    offset:  u32;
    length:  u16;
    kind:    u16;
}

# whether a section of `o` is in a group, as Mach-O states a copy only as a
# weak definition starting an atom of a coalesced section
fun sectioned(o: *Object) bool {
    var i: usize = 0;
    for (i < table.count[object.Section](?o.sections)) {
        val opt_group: opt[Id[object.Group]] = object.section_at(o, table.nth[object.Section](i)).group;
        if (sel opt_group.some) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether every symbol starting a copy lies in a section cut into one atom
# per symbol
fun atoms_split(o: *Object) bool {
    var k: usize = 0;
    for (k < table.count[object.Symbol](?o.symbols)) {
        val sym: *object.Symbol = object.symbol_at(o, table.nth[object.Symbol](k));
        k = k + 1;
        if (!sel sym.group.some) { cnt; }
        val d: Definition = sym.def;
        if (!sel d.placed)                                                        { ret false; }
        if (object.section_at(o, d.placed.section).disposition != ?section.SPLIT) { ret false; }
    }
    ret true;
}

# whether section `n` of `o` holds weak definitions or atoms of copies and no
# other external definition, which Mach-O supports only in a coalesced
# section (mach-o/nlist.h, N_WEAK_DEF). a copy's atoms count as weak
fun coalesced(o: *Object, n: usize) bool {
    var weak: bool  = false;
    var k:    usize = 0;
    for (k < table.count[object.Symbol](?o.symbols)) {
        val sym: *object.Symbol = object.symbol_at(o, table.nth[object.Symbol](k));
        k = k + 1;
        val d: Definition = sym.def;
        if (!sel d.placed)                    { cnt; }
        if (d.placed.section.index != n::u32) { cnt; }
        if (sel sym.group.some) {
            weak = true;
            cnt;
        }
        if (!symbol.binds(sym.binding, symbol.EXTERNAL)) { cnt; }
        if (!symbol.binds(sym.binding, symbol.WEAK))     { ret false; }
        weak = true;
    }
    ret weak;
}

fun begin_build(b: *Build) err[Fail] {
    val o: *Object = b.o;
    if (table.count[object.Entry](?o.entries) != 0)        { ret err[Fail].err{fail.unsupported("Mach-O has no index spaces")}; }
    if (vector.length[object.Note](?o.notes) != 0)         { ret err[Fail].err{fail.unsupported("a Mach-O object holds no notes")}; }
    if (table.count[object.Dependency](?o.libraries) != 0) { ret err[Fail].err{fail.unsupported("a Mach-O object links no library")}; }
    if (sectioned(o))                                      { ret err[Fail].err{fail.unsupported("Mach-O has no section groups, only weak definitions coalesced by symbol")}; }
    if (!atoms_split(o))                                   { ret err[Fail].err{fail.unsupported("a copy starts no atom of its own, because Mach-O cuts a section by symbol only where it is split")}; }
    if (sel o.library.some)                                { ret err[Fail].err{fail.unsupported("a Mach-O object describes no library")}; }
    if (o.target.arch != b.target.arch) {
        ret err[Fail].err{fail.about(fail.unsupported("the object is for another architecture than the target"), o.target.arch.name)};
    }
    val res_shape: res[Shape, Fail] = shape_of(b.target.arch);
    if (sel res_shape.err) { ret err[Fail].err{res_shape.err}; }
    b.cls   = res_shape.ok.class;
    b.order = res_shape.ok.order;
    b.m     = model.init(b.a, res_shape.ok);
    val res_arch_of: res[*Pair, Fail] = macho_pairs.of(b.target.arch);
    if (sel res_arch_of.err) { ret err[Fail].err{res_arch_of.err}; }
    b.pair = res_arch_of.ok;
    val res_set: res[*Lookup, Fail] = row.find(b.reg, ?format.MACHO, b.target.arch);
    if (sel res_set.err) { ret err[Fail].err{res_set.err}; }
    b.set = res_set.ok;
    val err_lowered: err[Fail] = lowered(b);
    if (sel err_lowered.err) { ret err_lowered; }
    val err_threaded: err[Fail] = threaded(b);
    if (sel err_threaded.err) { ret err_threaded; }
    val err_anchored: err[Fail] = anchored(b);
    if (sel err_anchored.err) { ret err_anchored; }
    val err_nameless: err[Fail] = naming.nameless(b.o);
    if (sel err_nameless.err) { ret err_nameless; }
    b.nsec = table.count[object.Section](?b.o.sections);
    b.nsym = table.count[object.Symbol](?b.o.symbols);
    ret object.exported(b.o, true, ?b.exported);
}

# build from a copy of the object with its records lowered in the encodings
# the lowering names, and its constant-time ranges and copies in the mink
# note, so the object the caller handed over stays as it was
fun lowered(b: *Build) err[Fail] {
    val records: bool = object.has_records(b.o);
    val marked:  bool = vector.length[object.CtRange](?b.o.ct) != 0 || mark.copying(b.o, true) != 0;
    if (!records && !marked) { ret err[Fail].ok{}; }
    val res_copy: res[Object, Fail] = object.copy(b.a, b.o);
    if (sel res_copy.err) { ret err[Fail].err{res_copy.err}; }
    b.copy = opt[Object].some{res_copy.ok};
    if (sel b.copy.some) { b.o = ?b.copy.some; }
    val err_lowering_applied: err[Fail] = encode.apply(b.lowering, b.o, b.set, b.pair.mapping);
    if (sel err_lowering_applied.err || !marked) { ret err_lowering_applied; }
    var low:       Lowered   = lower_lowered.init(b.a);
    var err_lower: err[Fail] = macho_mark.lower(b.o, b.order, ?low);
    if (!(sel err_lower.err)) { err_lower = lower_lowered.apply(b.o, ?low); }
    ret fail.kept(err_lower, lower_lowered.dnit(?low));
}

# build from a copy of the object holding a descriptor for each thread-local
# symbol it places, so the object the caller handed over stays as it was
fun threaded(b: *Build) err[Fail] {
    val n:    usize = table.count[object.Symbol](?b.o.symbols);
    var vars: usize = 0;
    var k:    usize = 0;
    for (k < n) {
        val y: *object.Symbol = object.symbol_at(b.o, Id[object.Symbol]{index: k::u32});
        if (symbol.names(y.kind, symbol.THREAD) && sel y.def.placed) { vars = vars + 1; }
        k = k + 1;
    }
    if (vars == 0) { ret err[Fail].ok{}; }
    val opt_sys: opt[*System] = b.target.sys;
    if (sel opt_sys.none) { ret err[Fail].err{fail.unsupported("a thread-local variable's descriptor binds an accessor only the system's loader provides, so the object's target must name the system")}; }
    val res_accessor: res[str, Fail] = os.system_symbol(opt_sys.some, ?os.TLV_BOOTSTRAP);
    if (sel res_accessor.err) { ret err[Fail].err{res_accessor.err}; }
    val fresh: bool = sel b.copy.none;
    if (fresh) {
        val res_copy: res[Object, Fail] = object.copy(b.a, b.o);
        if (sel res_copy.err) { ret err[Fail].err{res_copy.err}; }
        b.copy = opt[Object].some{res_copy.ok};
    }
    if (sel b.copy.some) { b.o = ?b.copy.some; }
    var stands:              Vector[u32] = vector.init[u32](b.a);
    var zeros:               Vector[u8]  = vector.init[u8](b.a);
    val err_descriptors_out: err[Fail]   = descriptors_out(b, res_accessor.ok, vars, ?stands, ?zeros);
    ret fail.kept(fail.kept(err_descriptors_out, vectors.dnit[u32](?stands)), vectors.dnit[u8](?zeros));
}

# the section of `vars` descriptors, each thread-local symbol of the object
# moved to its descriptor, whose accessor word binds `accessor` and whose
# offset word names the variable's place by its section's stand-in, kept per
# section plus one in `stands`
fun descriptors_out(b: *Build, accessor: str, vars: usize, stands: *Vector[u32], zeros: *Vector[u8]) err[Fail] {
    val o:         *Object         = b.o;
    val shape:     *model.TlvShape = ?b.cls.tlv;
    val size:      u64             = shape.size::u64;
    val n:         usize           = table.count[object.Symbol](?o.symbols);
    val at:        Location        = Location{record: "thread-local variable descriptors"};
    val res_bytes: res[u64, Fail]  = checked.mul(at, size, vars::u64);
    if (sel res_bytes.err) { ret err[Fail].err{res_bytes.err}; }
    val err_grow: err[Fail] = vectors.grow[u8](zeros, res_bytes.ok::usize);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    val err_grow_stands: err[Fail] = vectors.grow[u32](stands, table.count[object.Section](?o.sections));
    if (sel err_grow_stands.err) { ret err[Fail].err{err_grow_stands.err}; }
    val res_word: res[*reloc.Kind, Fail] = reloc.absolute_of(b.cls.addr::u8);
    if (sel res_word.err) { ret err[Fail].err{res_word.err}; }
    val res_held: res[Contents, Fail] = object.own(o, zeros.data, res_bytes.ok::usize);
    if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
    val res_name: res[Id[Name], Fail] = object.name_str(o, naming.THREAD_VARS);
    if (sel res_name.err) { ret err[Fail].err{res_name.err}; }
    val res_add_section: res[Id[object.Section], Fail] = object.add_section(o, object.Section{
        name:        opt[Id[Name]].some{res_name.ok},
        kind:        ?section.DATA,
        flags:       section.DATA.flags,
        align:       b.cls.addr::u64,
        contents:    res_held.ok,
        disposition: ?section.WHOLE,
    });
    if (sel res_add_section.err) { ret err[Fail].err{res_add_section.err}; }
    val err_typed: err[Fail] = add_fact(o, fact.SECTION_TYPE, (res_add_section.ok.index::u64 << 32) | tables.S_THREAD_LOCAL_VARIABLES.value, Contents.zero{0});
    if (sel err_typed.err) { ret err_typed; }
    val res_acc: res[Id[object.Symbol], Fail] = accessor_symbol(o, accessor);
    if (sel res_acc.err) { ret err[Fail].err{res_acc.err}; }
    var i: u64   = 0;
    var k: usize = 0;
    for (k < n) {
        val y: *object.Symbol = object.symbol_at(o, Id[object.Symbol]{index: k::u32});
        k = k + 1;
        if (!symbol.names(y.kind, symbol.THREAD)) { cnt; }
        var p:   Place;
        val def: Definition = y.def;
        if (sel def.placed)                                             { p = def.placed; }
        or                                                              { cnt; }
        if ((object.section_at(o, p.section).flags & section.TLS) == 0) { ret err[Fail].err{fail.in_indexed(fail.malformed("a thread-local symbol lies in no thread-local section"), "symbol", (k - 1)::u64)}; }
        val res_stand: res[Id[object.Symbol], Fail] = stand_out(o, stands, p.section);
        if (sel res_stand.err) { ret err[Fail].err{res_stand.err}; }
        val d:         u64                         = i * size;
        val res_thunk: res[Id[object.Reloc], Fail] = object.add_reloc(o, object.Reloc{section: res_add_section.ok, offset: d + shape.thunk.offset::u64, kind: res_word.ok, target: Target.symbol{res_acc.ok}});
        if (sel res_thunk.err) { ret err[Fail].err{res_thunk.err}; }
        val res_off: res[Id[object.Reloc], Fail] = object.add_reloc(o, object.Reloc{section: res_add_section.ok, offset: d + shape.offset.offset::u64, kind: res_word.ok, target: Target.symbol{res_stand.ok}, addend: p.offset:~i64});
        if (sel res_off.err) { ret err[Fail].err{res_off.err}; }
        val moved: *object.Symbol = object.symbol_at(o, Id[object.Symbol]{index: (k - 1)::u32});
        moved.def  = Definition.placed{Place{section: res_add_section.ok, offset: d}};
        moved.kind = ?symbol.NOTYPE;
        moved.size = object.sized(size);
        i          = i + 1;
    }
    ret err[Fail].ok{};
}

# the undefined symbol of the loader's accessor `accessor`, the object's own
# when it names one
fun accessor_symbol(o: *Object, accessor: str) res[Id[object.Symbol], Fail] {
    var k: usize = 0;
    for (k < table.count[object.Symbol](?o.symbols)) {
        val y: *object.Symbol = object.symbol_at(o, Id[object.Symbol]{index: k::u32});
        k = k + 1;
        if (!sel y.def.undefined || !symbol.binds(y.binding, symbol.EXTERNAL)) { cnt; }
        val v: View = object.name_of(o, y.name);
        if (v.len == str_len(accessor) && memory.raw_equal(v.data::ptr, accessor::ptr, v.len)) { ret res[Id[object.Symbol], Fail].ok{Id[object.Symbol]{index: (k - 1)::u32}}; }
    }
    val res_name: res[Id[Name], Fail] = object.name_str(o, accessor);
    if (sel res_name.err) { ret res[Id[object.Symbol], Fail].err{res_name.err}; }
    ret object.add_symbol(o, object.Symbol{name: res_name.ok, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.NOTYPE, def: Definition.undefined{}});
}

# the symbol standing for the section `sec`, written as the section, made the
# first time it is asked for
fun stand_out(o: *Object, stands: *Vector[u32], sec: Id[object.Section]) res[Id[object.Symbol], Fail] {
    val slot: *u32 = ?stands.data[sec.index::usize];
    if (@slot != 0) { ret res[Id[object.Symbol], Fail].ok{Id[object.Symbol]{index: @slot - 1}}; }
    val res_none: res[Id[Name], Fail] = object.name_str(o, "");
    if (sel res_none.err) { ret res[Id[object.Symbol], Fail].err{res_none.err}; }
    val res_added: res[Id[object.Symbol], Fail] = object.add_symbol(o, object.Symbol{name: res_none.ok, binding: ?symbol.LOCAL, visibility: ?symbol.DEFAULT, kind: ?symbol.SECTIONS, def: Definition.placed{Place{section: sec, offset: 0}}});
    if (sel res_added.err) { ret res_added; }
    @slot = res_added.ok.index + 1;
    ret res_added;
}

# where the target of a record that names it by a symbol lies, in the
# section its symbol is written as
# ---
# section: the section
# at:      the target's offset in it, before it when negative
# exact:   whether the record names a symbol at exactly the target
# atom:    whether the record names its section when no atom holds the target
rec Want {
    section: u32;
    at:      i64;
    exact:   bool;
    atom:    bool;
}

# a record to name by another symbol: its row, and the symbol it names
rec Anchoring {
    row:    *Row;
    symbol: Id[object.Symbol];
}

# record `r` when its row names the target by a symbol and `r` names a symbol
# the format writes as its section, none otherwise. a record whose row is
# refused is left to the writing of records, which refuses it
fun anchoring(b: *Build, r: *object.Reloc) opt[Anchoring] {
    if (!sel r.target.symbol)                                                     { ret opt[Anchoring].none{}; }
    if (sel r.minus.some)                                                         { ret opt[Anchoring].none{}; }
    if (r.target.symbol.index::usize >= table.count[object.Symbol](?b.o.symbols)) { ret opt[Anchoring].none{}; }
    if (!as_section(b, r.target.symbol.index::usize))                             { ret opt[Anchoring].none{}; }
    val res_targeting: res[*Row, Fail] = row.targeting(b.set, r.kind, false);
    if (sel res_targeting.err)             { ret opt[Anchoring].none{}; }
    if (sel res_targeting.ok.names.either) { ret opt[Anchoring].none{}; }
    ret opt[Anchoring].some{Anchoring{row: res_targeting.ok, symbol: r.target.symbol}};
}

# where the target of record `r`, to name as `an` states, lies: its symbol's
# place plus the neutral addend, less the row's bias, which counts from past
# the field
fun wanted(b: *Build, r: *object.Reloc, an: Anchoring) res[Want, Fail] {
    val rw:            *Row             = an.row;
    val res_placed_in: res[Place, Fail] = placed_in(b, an.symbol);
    if (sel res_placed_in.err)                                                               { ret res[Want, Fail].err{res_placed_in.err}; }
    if (res_placed_in.ok.section.index::usize >= table.count[object.Section](?b.o.sections)) { ret res[Want, Fail].err{fail.malformed("symbol is placed in a section the object does not have")}; }
    val top: i128 = (1::i128) << 63;
    val t:   i128 = res_placed_in.ok.offset::i128 + r.addend::i128 - rw.bias::i128;
    if (t < -top || t >= top) { ret res[Want, Fail].err{fail.valued(fail.overflow("the target's offset in its section does not fit 64 bits"), t)}; }
    val exact: bool = sel rw.names.exact;
    if (exact && (t < 0 || t::u64 > object.size_of(b.o, object.section_at(b.o, res_placed_in.ok.section)))) {
        ret res[Want, Fail].err{fail.about(fail.unsupported("a record of this kind names a symbol at exactly its target, and its target lies outside its section"), rw.name)};
    }
    ret res[Want, Fail].ok{Want{section: res_placed_in.ok.section.index, at: t::i64, exact: exact, atom: sel rw.names.atom}};
}

# the symbol among `places` a record that wants `w` names: one at exactly the
# target, or the atom holding the target, the section's first for a target
# before it
fun anchor_of(places: *Vector[Atom], w: Want) opt[*Atom] {
    if (w.exact)  { ret symbol_at_exactly(places, w.section, w.at::u64); }
    if (w.at < 0) { ret atom_at(places, w.section, 0); }
    ret atom_at(places, w.section, w.at::u64);
}

# where a symbol must be added for a record that wants `w` and finds none:
# at the section's start, which heads the bytes before its first atom, or at
# the target as an alternate entry, which starts no atom, so no atom is split
fun anchor_place(w: Want) Atom {
    if (w.exact && w.at != 0) { ret Atom{section: w.section, offset: w.at::u64, alt: true}; }
    ret Atom{section: w.section, offset: 0};
}

# name each record whose row names its target by a symbol, and whose target
# the format writes as its section, by a symbol instead, as LLVM's Mach-O
# writer does: the symbol of the atom that holds the target with the distance
# from it as the addend, or a symbol at exactly the target for a row that
# carries no distance. where none serves, a row that names an atom where one
# holds the target keeps the section, and for the rest a local linker-private
# symbol is added, named `l`, the section's index, `_` and its offset in the
# section, whose `l` prefix keeps it out of every image. one past the start is an alternate entry of the
# atom before it, the section's start taking a symbol when no atom precedes
# it, so no atom is split. the object is a copy, so the
# one the caller handed over stays as it was
fun anchored(b: *Build) err[Fail] {
    val n:    usize = table.count[object.Reloc](?b.o.relocs);
    var some: bool  = false;
    var i:    usize = 0;
    for (i < n && !some) {
        val opt_anchoring: opt[Anchoring] = anchoring(b, table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](i)));
        some = sel opt_anchoring.some;
        i    = i + 1;
    }
    if (!some) { ret err[Fail].ok{}; }
    val fresh: bool = sel b.copy.none;
    if (fresh) {
        val res_copy: res[Object, Fail] = object.copy(b.a, b.o);
        if (sel res_copy.err) { ret err[Fail].err{res_copy.err}; }
        b.copy = opt[Object].some{res_copy.ok};
    }
    if (sel b.copy.some) { b.o = ?b.copy.some; }
    var places:          Vector[Atom] = vector.init[Atom](b.a);
    var adds:            Vector[Atom] = vector.init[Atom](b.a);
    val err_anchors_out: err[Fail]    = anchors_out(b, ?places, ?adds);
    ret fail.kept(fail.kept(err_anchors_out, vectors.dnit[Atom](?places)), vectors.dnit[Atom](?adds));
}

# the placed symbols the format writes an entry for, sorted into `places`,
# the symbols every record lacks added in `adds`, and each record retargeted
fun anchors_out(b: *Build, places: *Vector[Atom], adds: *Vector[Atom]) err[Fail] {
    val m: usize = table.count[object.Symbol](?b.o.symbols);
    var k: usize = 0;
    for (k < m) {
        val s: *object.Symbol = object.symbol_at(b.o, Id[object.Symbol]{index: k::u32});
        k = k + 1;
        if (!sel s.def.placed)    { cnt; }
        if (as_section(b, k - 1)) { cnt; }
        val err_places_pushed: err[Fail] = vectors.push[Atom](places, Atom{section: s.def.placed.section.index, offset: s.def.placed.offset, sym: (k - 1)::u32, alt: s.alt_entry});
        if (sel err_places_pushed.err) { ret err[Fail].err{err_places_pushed.err}; }
    }
    sort.sort_by[Atom](places.data, vector.length[Atom](places), order_atoms);
    val n: usize = table.count[object.Reloc](?b.o.relocs);
    var i: usize = 0;
    for (i < n) {
        val r:             *object.Reloc  = table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](i));
        val opt_anchoring: opt[Anchoring] = anchoring(b, r);
        i = i + 1;
        if (sel opt_anchoring.none) { cnt; }
        val res_wanted: res[Want, Fail] = wanted(b, r, opt_anchoring.some);
        if (sel res_wanted.err) { ret err[Fail].err{fail.in_indexed(res_wanted.err, "relocation", (i - 1)::u64)}; }
        val opt_found: opt[*Atom] = anchor_of(places, res_wanted.ok);
        if (sel opt_found.some) { cnt; }
        if (res_wanted.ok.atom) { cnt; }
        val want:            Atom      = anchor_place(res_wanted.ok);
        val err_adds_pushed: err[Fail] = vectors.push[Atom](adds, want);
        if (sel err_adds_pushed.err) { ret err[Fail].err{err_adds_pushed.err}; }
        # an alternate entry belongs to the atom before it, so one in the
        # bytes before the section's first atom takes the section's start
        if (!want.alt) { cnt; }
        val opt_head: opt[*Atom] = atom_at(places, want.section, want.offset);
        if (sel opt_head.some) { cnt; }
        val err_adds_pushed_atom: err[Fail] = vectors.push[Atom](adds, Atom{section: want.section, offset: 0});
        if (sel err_adds_pushed_atom.err) { ret err[Fail].err{err_adds_pushed_atom.err}; }
    }
    sort.sort_by[Atom](adds.data, vector.length[Atom](adds), order_atoms);
    var j: usize = 0;
    for (j < vector.length[Atom](adds)) {
        val a: *Atom = ?adds.data[j];
        j = j + 1;
        if (j > 1) {
            val q: *Atom = ?adds.data[j - 2];
            if (q.section == a.section && q.offset == a.offset) { cnt; }
        }
        val res_private_out: res[Id[object.Symbol], Fail] = private_out(b, a.section, a.offset, a.alt);
        if (sel res_private_out.err) { ret err[Fail].err{res_private_out.err}; }
        val err_places_pushed: err[Fail] = vectors.push[Atom](places, Atom{section: a.section, offset: a.offset, sym: res_private_out.ok.index, alt: a.alt});
        if (sel err_places_pushed.err) { ret err[Fail].err{err_places_pushed.err}; }
    }
    sort.sort_by[Atom](places.data, vector.length[Atom](places), order_atoms);
    i = 0;
    for (i < n) {
        val r:             *object.Reloc  = table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](i));
        val opt_anchoring: opt[Anchoring] = anchoring(b, r);
        i = i + 1;
        if (sel opt_anchoring.none) { cnt; }
        val res_wanted: res[Want, Fail] = wanted(b, r, opt_anchoring.some);
        if (sel res_wanted.err) { ret err[Fail].err{fail.in_indexed(res_wanted.err, "relocation", (i - 1)::u64)}; }
        val opt_anchor_of: opt[*Atom] = anchor_of(places, res_wanted.ok);
        if (sel opt_anchor_of.none && res_wanted.ok.atom) { cnt; }
        if (sel opt_anchor_of.none)                       { ret err[Fail].err{fail.in_indexed(fail.internal("a record names no symbol after one was added for it"), "relocation", (i - 1)::u64)}; }
        val top: i128 = (1::i128) << 63;
        val d:   i128 = res_wanted.ok.at::i128 - opt_anchor_of.some.offset::i128 + opt_anchoring.some.row.bias::i128;
        if (d < -top || d >= top) { ret err[Fail].err{fail.in_indexed(fail.valued(fail.overflow("the addend from the symbol that names the target does not fit 64 bits"), d), "relocation", (i - 1)::u64)}; }
        r.target = Target.symbol{Id[object.Symbol]{index: opt_anchor_of.some.sym}};
        r.addend = d::i64;
    }
    ret err[Fail].ok{};
}

# a local linker-private symbol at offset `offset` of section `sec`, an
# alternate entry when `alt`, named `l<sec>_<offset>`
fun private_out(b: *Build, sec: u32, offset: u64, alt: bool) res[Id[object.Symbol], Fail] {
    var spelled:  Sink      = sink.init(b.a, b.order);
    var err_text: err[Fail] = sink.text(?spelled, "l");
    if (!sel err_text.err) { err_text = sink.number(?spelled, sec::u64, 10); }
    if (!sel err_text.err) { err_text = sink.text(?spelled, "_"); }
    if (!sel err_text.err) { err_text = sink.number(?spelled, offset, 10); }
    if (sel err_text.err) {
        val err_dropped: err[Fail] = sink.dnit(?spelled);
        ret res[Id[object.Symbol], Fail].err{err_text.err};
    }
    val res_name: res[Id[Name], Fail] = object.name(b.o, sink.data(?spelled), sink.len(?spelled));
    val err_rel:  err[Fail]           = sink.dnit(?spelled);
    if (sel res_name.err) { ret res[Id[object.Symbol], Fail].err{res_name.err}; }
    if (sel err_rel.err)  { ret res[Id[object.Symbol], Fail].err{err_rel.err}; }
    ret object.add_symbol(b.o, object.Symbol{name: res_name.ok, binding: ?symbol.LOCAL, visibility: ?symbol.DEFAULT, kind: ?symbol.NOTYPE, def: Definition.placed{Place{section: Id[object.Section]{index: sec}, offset: offset}}, alt_entry: alt});
}

fun facts_out(b: *Build) err[Fail] {
    val err_grow: err[Fail] = vectors.grow[u32](?b.types, b.nsec);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    val err_grow_attrs: err[Fail] = vectors.grow[u32](?b.attrs, b.nsec);
    if (sel err_grow_attrs.err) { ret err[Fail].err{err_grow_attrs.err}; }
    val err_grow_reserved: err[Fail] = vectors.grow[u32](?b.reserved, b.nsec * 3);
    if (sel err_grow_reserved.err) { ret err[Fail].err{err_grow_reserved.err}; }
    val err_grow_desc: err[Fail] = vectors.grow[u16](?b.desc, b.nsym);
    if (sel err_grow_desc.err) { ret err[Fail].err{err_grow_desc.err}; }
    val err_grow_local: err[Fail] = vectors.grow[bool](?b.local, table.count[object.Reloc](?b.o.relocs));
    if (sel err_grow_local.err) { ret err[Fail].err{err_grow_local.err}; }
    var i: usize = 0;
    for (i < table.count[Fact](?b.o.facts)) {
        val f: *Fact = table.at[Fact](?b.o.facts, table.nth[Fact](i));
        i = i + 1;
        if (f.format != ?format.MACHO) { cnt; }
        val err_fact_out: err[Fail] = fact_out(b, f);
        if (sel err_fact_out.err) { ret err[Fail].err{fail.in_indexed(err_fact_out.err, "fact", (i - 1)::u64)}; }
    }
    ret err[Fail].ok{};
}

fun fact_out(b: *Build, f: *Fact) err[Fail] {
    val v: u64 = f.value;
    if (f.key == fact.HEADER_FLAGS) {
        if (v > 0xffff_ffff) { ret err[Fail].err{fail.overflow("header flags are wider than their field")}; }
        b.flags = v::u32;
        ret err[Fail].ok{};
    }
    if (f.key == fact.SUBTYPE_CAPS) {
        if (v > 0xffff_ffff) { ret err[Fail].err{fail.overflow("cpusubtype capabilities are wider than their field")}; }
        b.caps = v::u32;
        ret err[Fail].ok{};
    }
    if (f.key == fact.SECTION_TYPE || f.key == fact.SECTION_ATTRIBUTES) {
        val n: u64 = v >> 32;
        if (n >= b.nsec::u64)           { ret err[Fail].err{fail.malformed("fact names a section the object does not have")}; }
        if (f.key == fact.SECTION_TYPE) { b.types.data[n::usize] = (v & 0xffff_ffff)::u32 + 1; }
        or                              { b.attrs.data[n::usize] = (v & 0xffff_ffff)::u32; }
        ret err[Fail].ok{};
    }
    if (f.key == fact.SECTION_RESERVED) {
        if (v >= b.nsec::u64) { ret err[Fail].err{fail.malformed("fact names a section the object does not have")}; }
        val d: Bytes = object.bytes(b.o, ?f.data);
        if (d.len != 12) { ret err[Fail].err{fail.malformed("section reserved fact does not hold twelve bytes")}; }
        b.reserved.data[v::usize * 3]     = get_word(?d.data[0]);
        b.reserved.data[v::usize * 3 + 1] = get_word(?d.data[4]);
        b.reserved.data[v::usize * 3 + 2] = get_word(?d.data[8]);
        ret err[Fail].ok{};
    }
    if (f.key == fact.SYMBOL_DESC) {
        val k: u64 = v >> 16;
        if (k >= b.nsym::u64) { ret err[Fail].err{fail.malformed("fact names a symbol the object does not have")}; }
        b.desc.data[k::usize] = (v & 0xffff)::u16;
        ret err[Fail].ok{};
    }
    if (f.key == fact.BUILD_TOOL) {
        val err_tools_pushed: err[Fail] = vectors.push[model.Tool](?b.tools, model.Tool{tool: (v >> 32)::u32, version: (v & 0xffff_ffff)::u32});
        if (sel err_tools_pushed.err) { ret err[Fail].err{err_tools_pushed.err}; }
        ret err[Fail].ok{};
    }
    if (f.key == fact.VERSION_MIN) {
        if (v > 0xffff_ffff) { ret err[Fail].err{fail.overflow("a command code is wider than its field")}; }
        b.min_cmd = v::u32;
        ret err[Fail].ok{};
    }
    if (f.key == fact.LINKER_HINTS) {
        b.hints = opt[*Fact].some{f};
        ret err[Fail].ok{};
    }
    if (f.key == fact.LOCAL_RECORD) {
        if (v >= vector.length[bool](?b.local)::u64) { ret err[Fail].err{fail.malformed("a local record fact names a relocation the object does not have")}; }
        b.local.data[v::usize] = true;
        ret err[Fail].ok{};
    }
    if (f.key == fact.DATA_IN_CODE) {
        if ((v >> 32) >= b.nsec::u64) { ret err[Fail].err{fail.malformed("fact names a section the object does not have")}; }
        val d: Bytes = object.bytes(b.o, ?f.data);
        if (d.len != 4) { ret err[Fail].err{fail.malformed("data in code fact does not hold four bytes")}; }
        val err_dices_pushed: err[Fail] = vectors.push[Dice](?b.dices, Dice{
            section: (v >> 32)::u32, offset: (v & 0xffff_ffff)::u32, length: d.data[0]::u16 | (d.data[1]::u16 << 8), kind: d.data[2]::u16 | (d.data[3]::u16 << 8),
        });
        if (sel err_dices_pushed.err) { ret err[Fail].err{err_dices_pushed.err}; }
        ret err[Fail].ok{};
    }
    if (f.key == fact.SEGMENT) {
        if (object.bytes(b.o, ?f.data).len != NAME_SIZE) { ret err[Fail].err{fail.malformed("segment fact does not hold a sixteen byte name")}; }
        b.segment = opt[*Fact].some{f};
        ret err[Fail].ok{};
    }
    ret err[Fail].err{fail.unsupported("Mach-O fact has no meaning")};
}

# the segment a nameless section of `s` loads in: the layout class its flags
# and roles place it in
fun segment_for(s: *object.Section) res[str, Fail] {
    val opt_class_taking: opt[*layout.Class] = layout.class_taking(?naming.LAYOUT, s.flags, s.kind);
    if (sel opt_class_taking.none) { ret res[str, Fail].err{fail.about(fail.unsupported("the layout has no class for a section of these flags"), s.kind.name)}; }
    val k: *layout.Class = opt_class_taking.some;
    if (sel k.load.none) { ret res[str, Fail].err{fail.about(fail.unsupported("the layout places a section of this kind in no segment"), s.kind.name)}; }
    ret res[str, Fail].ok{k.load.some.name};
}

# copy a name of `n` bytes into a sixteen byte field, refusing a longer one
pub fun name16(out: *u8, p: *u8, n: usize) err[Fail] {
    if (n > NAME_SIZE) { ret err[Fail].err{fail.malformed("a segment or section name is longer than sixteen bytes")}; }
    var i: usize = 0;
    for (i < NAME_SIZE) {
        out[i] = 0;
        if (i < n) { out[i] = p[i]; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun sections_out(b: *Build) err[Fail] {
    val err_reserve: err[Fail] = vectors.reserve[Out](?b.outs, b.nsec);
    if (sel err_reserve.err) { ret err_reserve; }
    var n: usize = 0;
    for (n < b.nsec) {
        val err_section_out: err[Fail] = section_out(b, n);
        if (sel err_section_out.err) { ret err[Fail].err{fail.in_indexed(err_section_out.err, "section", n::u64)}; }
        n = n + 1;
    }
    ret addresses_out(b);
}

fun section_out(b: *Build, n: usize) err[Fail] {
    val sec: *object.Section = object.section_at(b.o, Id[object.Section]{index: n::u32});
    if (sel sec.priority.some) { ret err[Fail].err{fail.unsupported("Mach-O states no section priority")}; }
    val key:     section.Key            = section.key_of(sec.kind, sec.entsize);
    val res_row: res[*naming.Row, Fail] = naming.row_of(key);
    if (sel res_row.err) { ret err[Fail].err{res_row.err}; }
    var out: Out = Out{bytes: sink.init(b.a, b.order), relocs: table.init[Reloc](b.a)};
    var s:   naming.Split;
    if (sel sec.name.some) {
        val v: View = object.name_of(b.o, sec.name.some);
        s = naming.split(Bytes{data: v.data, len: v.len});
    }
    or {
        val res_name: res[str, Fail] = naming.name_of(key);
        if (sel res_name.err) { ret out_dnit(?out, res_name.err); }
        s = naming.split(Bytes{data: res_name.ok::*u8, len: str_len(res_name.ok)});
    }
    if (!s.comma) {
        val res_seg: res[str, Fail] = segment_for(sec);
        if (sel res_seg.err) { ret out_dnit(?out, res_seg.err); }
        s.segment = Bytes{data: res_seg.ok::*u8, len: str_len(res_seg.ok)};
    }
    val err_segname_written: err[Fail] = name16(?out.segname[0], s.segment.data, s.segment.len);
    if (sel err_segname_written.err) { ret out_dnit(?out, err_segname_written.err); }
    val err_sectname_written: err[Fail] = name16(?out.sectname[0], s.section.data, s.section.len);
    if (sel err_sectname_written.err)                         { ret out_dnit(?out, err_sectname_written.err); }
    if (sec.align == 0 || (sec.align & (sec.align - 1)) != 0) { ret out_dnit(?out, fail.malformed("section alignment is not a power of two")); }
    val stated: u32 = b.types.data[n];
    out.type = res_row.ok.type.value::u32;
    if (out.type == tables.S_REGULAR.value::u32 && coalesced(b.o, n)) { out.type = tables.S_COALESCED.value::u32; }
    if (stated != 0)                                                  { out.type = stated - 1; }
    out.attrs = (res_row.ok.attributes | retain_attr(sec.flags) | excluded_attr(sec))::u32 | b.attrs.data[n];
    if (sel sec.contents.zero) {
        out.zerofill = true;
        out.size     = sec.contents.zero;
    }
    or {
        val bytes:     Bytes     = object.bytes(b.o, ?sec.contents);
        val err_bytes: err[Fail] = sink.bytes(?out.bytes, bytes.data, bytes.len);
        if (sel err_bytes.err) { ret out_dnit(?out, err_bytes.err); }
        out.size = bytes.len::u64;
    }
    val err_outs_pushed: err[Fail] = vectors.push[Out](?b.outs, out);
    if (sel err_outs_pushed.err) { ret out_dnit(?out, err_outs_pushed.err); }
    ret err[Fail].ok{};
}

fun out_dnit(o: *Out, f: Fail) err[Fail] {
    val err_bytes_released:  err[Fail] = sink.dnit(?o.bytes);
    val err_relocs_released: err[Fail] = table.dnit[Reloc](?o.relocs);
    ret err[Fail].err{f};
}

# lay the sections out in the object's address space: the sections with
# bytes in order, then the zero fill, each at its alignment
fun addresses_out(b: *Build) err[Fail] {
    var cursor: u64   = 0;
    var pass:   usize = 0;
    for (pass < 2) {
        var n: usize = 0;
        for (n < b.nsec) {
            val sec: *object.Section = object.section_at(b.o, Id[object.Section]{index: n::u32});
            val out: *Out            = ?b.outs.data[n];
            n = n + 1;
            if (out.zerofill != (pass == 1)) { cnt; }
            val res_align_up: res[u64, Fail] = checked.align_up(Location{record: "section"}, cursor, sec.align);
            if (sel res_align_up.err) { ret err[Fail].err{res_align_up.err}; }
            out.addr = res_align_up.ok;
            val res_end: res[u64, Fail] = checked.add(Location{record: "section"}, res_align_up.ok, out.size);
            if (sel res_end.err) { ret err[Fail].err{res_end.err}; }
            cursor = res_end.ok;
        }
        if (pass == 0) { b.content = cursor; }
        pass = pass + 1;
    }
    b.vmsize = cursor;
    ret err[Fail].ok{};
}

fun is_local(b: *Build, k: usize) bool {
    ret !symbol.binds(object.symbol_at(b.o, Id[object.Symbol]{index: k::u32}).binding, symbol.EXTERNAL);
}

# whether symbol `k` is written as the section it lies in rather than as an
# entry: a section's stand-in, or a local label with no name
fun as_section(b: *Build, k: usize) bool {
    val s: *object.Symbol = object.symbol_at(b.o, Id[object.Symbol]{index: k::u32});
    if (!is_local(b, k))            { ret false; }
    if (s.kind == ?symbol.SECTIONS) { ret true; }
    ret object.name_of(b.o, s.name).len == 0;
}

# the symbol table: local entries, then the defined external ones, then the
# undefined, each range in the object's order
fun symbols_out(b: *Build) err[Fail] {
    val err_grow: err[Fail] = vectors.grow[u32](?b.perm, b.nsym);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var pass: usize = 0;
    for (pass < 3) {
        var k: usize = 0;
        for (k < b.nsym) {
            val s: *object.Symbol = object.symbol_at(b.o, Id[object.Symbol]{index: k::u32});
            k = k + 1;
            if (pass == 0 && sel s.fallback.some) { ret err[Fail].err{fail.in_indexed(fail.unsupported("Mach-O has no weak external fallback"), "symbol", (k - 1)::u64)}; }
            if (pass == 0 && sel s.version.some)  { ret err[Fail].err{fail.in_indexed(fail.unsupported("Mach-O has no symbol versions"), "symbol", (k - 1)::u64)}; }
            if (as_section(b, k - 1))             { cnt; }
            var group: usize = 2;
            if (is_local(b, k - 1))                        { group = 0; }
            or (!sel s.def.undefined && !sel s.def.common) { group = 1; }
            if (group != pass)                             { cnt; }
            val err_symbol_out: err[Fail] = symbol_out(b, k - 1);
            if (sel err_symbol_out.err) { ret err[Fail].err{fail.in_indexed(err_symbol_out.err, "symbol", (k - 1)::u64)}; }
            val n: u32 = table.count[Nlist](?b.nlist)::u32;
            b.perm.data[k - 1] = n;
            if (pass == 0) { b.locals = n; }
            or (pass == 1) { b.externs = n - b.locals; }
            or             { b.undefs = n - b.locals - b.externs; }
        }
        pass = pass + 1;
    }
    val err_starts_out: err[Fail] = starts_out(b);
    if (sel err_starts_out.err) { ret err_starts_out; }
    b.undefs = table.count[Nlist](?b.nlist)::u32 - b.locals - b.externs;
    ret err[Fail].ok{};
}

# an undefined entry for the start of the output section each section that
# holds the target of a section offset lands in, after the object's own
# undefined entries, which the link binds by the name SECTION_START gives it
fun starts_out(b: *Build) err[Fail] {
    val err_grow: err[Fail] = vectors.grow[u32](?b.starts, b.nsec);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < table.count[object.Reloc](?b.o.relocs)) {
        val r: *object.Reloc = table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](i));
        i = i + 1;
        val opt_offset_into: opt[usize] = offset_into(b, r);
        if (sel opt_offset_into.none)                 { cnt; }
        if (b.starts.data[opt_offset_into.some] != 0) { cnt; }
        val err_start_out: err[Fail] = start_out(b, opt_offset_into.some);
        if (sel err_start_out.err) { ret err[Fail].err{fail.in_indexed(err_start_out.err, "relocation", (i - 1)::u64)}; }
    }
    ret err[Fail].ok{};
}

# the section that holds the target of `r` when it is a section offset the
# set writes from its section's start, none otherwise. a record this finds
# nothing for that is such an offset is refused as it is written
fun offset_into(b: *Build, r: *object.Reloc) opt[usize] {
    if (sel r.minus.some) { ret opt[usize].none{}; }
    val res_targeting: res[*Row, Fail] = row.targeting(b.set, r.kind, false);
    if (sel res_targeting.err)               { ret opt[usize].none{}; }
    if (!sel res_targeting.ok.write.started) { ret opt[usize].none{}; }
    if (sel r.target.symbol) {
        if (r.target.symbol.index::usize >= b.nsym) { ret opt[usize].none{}; }
        val y: *object.Symbol = object.symbol_at(b.o, r.target.symbol);
        if (sel y.def.placed) {
            val n: usize = y.def.placed.section.index::usize;
            if (n < b.nsec) { ret opt[usize].some{n}; }
        }
    }
    ret opt[usize].none{};
}

# the undefined entry for the start of the output section the section `n`
# lands in: SECTION_START, its segment name, the join and its section name
fun start_out(b: *Build, n: usize) err[Fail] {
    val out:             *Out                = ?b.outs.data[n];
    var name:            Vector[u8]          = vector.init[u8](b.a);
    val err_start_name:  err[Fail]           = start_name(out, ?name);
    var res_names_added: res[Id[Name], Fail] = res[Id[Name], Fail].err{fail.internal("a section start was named by nothing")};
    if (sel err_start_name.ok) { res_names_added = strtab.add(?b.names, name.data, vector.length[u8](?name)); }
    val err_dropped: err[Fail] = vectors.dnit[u8](?name);
    if (sel err_start_name.err)  { ret err_start_name; }
    if (sel res_names_added.err) { ret err[Fail].err{res_names_added.err}; }
    if (sel err_dropped.err)     { ret err_dropped; }
    val e:                Nlist                = Nlist{type: tables.N_UNDF.value::u8 | tables.N_EXT.value::u8};
    val res_nlist_pushed: res[Id[Nlist], Fail] = table.push[Nlist](?b.nlist, e);
    if (sel res_nlist_pushed.err) { ret err[Fail].err{res_nlist_pushed.err}; }
    val err_sym_ids_pushed: err[Fail] = vectors.push[Id[Name]](?b.sym_ids, res_names_added.ok);
    if (sel err_sym_ids_pushed.err) { ret err[Fail].err{err_sym_ids_pushed.err}; }
    b.starts.data[n] = table.count[Nlist](?b.nlist)::u32;
    ret err[Fail].ok{};
}

# the name of the start of the output section `out` lands in, in `name`
fun start_name(out: *Out, name: *Vector[u8]) err[Fail] {
    val err_pre: err[Fail] = vectors.extend[u8](name, naming.SECTION_START::*u8, str_len(naming.SECTION_START));
    if (sel err_pre.err) { ret err[Fail].err{err_pre.err}; }
    val err_seg: err[Fail] = vectors.extend[u8](name, ?out.segname[0], name_len(?out.segname[0]));
    if (sel err_seg.err) { ret err[Fail].err{err_seg.err}; }
    val err_join: err[Fail] = vectors.push[u8](name, naming.START_JOIN);
    if (sel err_join.err) { ret err[Fail].err{err_join.err}; }
    val err_sec: err[Fail] = vectors.extend[u8](name, ?out.sectname[0], name_len(?out.sectname[0]));
    if (sel err_sec.err) { ret err[Fail].err{err_sec.err}; }
    ret err[Fail].ok{};
}

fun symbol_out(b: *Build, k: usize) err[Fail] {
    val s: *object.Symbol = object.symbol_at(b.o, Id[object.Symbol]{index: k::u32});
    if (symbol.names(s.kind, symbol.CELL) || symbol.names(s.kind, symbol.ENTRY) || symbol.names(s.kind, symbol.FILE)) {
        ret err[Fail].err{fail.about(fail.unsupported("symbol kind has no Mach-O form"), s.kind.name)};
    }
    val v:               View                = object.name_of(b.o, s.name);
    val res_names_added: res[Id[Name], Fail] = strtab.add(?b.names, v.data, v.len);
    if (sel res_names_added.err) { ret err[Fail].err{res_names_added.err}; }
    val ext:      bool = symbol.binds(s.binding, symbol.EXTERNAL);
    val exported: bool = b.exported.data[k];
    if (exported) {
        if (sel s.def.undefined) { ret err[Fail].err{fail.unsupported("Mach-O exports a symbol only from the object that defines it")}; }
        if (!ext)                { ret err[Fail].err{fail.malformed("an export directive is about a local symbol")}; }
    }
    val res_vis: res[*symbol.Visibility, Fail] = symbol.written(?WRITTEN_VISIBILITY, s.visibility, exported);
    if (sel res_vis.err) { ret err[Fail].err{res_vis.err}; }
    var e: Nlist;
    e.desc = b.desc.data[k];
    if (ext)                                               { e.type = e.type | tables.N_EXT.value::u8; }
    if (ext && !symbol.shows(res_vis.ok, symbol.EXPORTED)) { e.type = e.type | tables.N_PEXT.value::u8; }
    if (s.retain)                                          { e.desc = e.desc | tables.N_NO_DEAD_STRIP.value::u16; }
    if (s.alt_entry)                                       { e.desc = e.desc | tables.N_ALT_ENTRY.value::u16; }
    val d: Definition = s.def;
    if (sel d.undefined) {
        e.type = e.type | tables.N_UNDF.value::u8;
        if (symbol.binds(s.binding, symbol.WEAK)) { e.desc = e.desc | tables.N_WEAK_REF.value::u16; }
    }
    or (sel d.common) {
        if (!ext)                                                                { ret err[Fail].err{fail.unsupported("Mach-O has no local common symbol")}; }
        if (d.common.align == 0 || (d.common.align & (d.common.align - 1)) != 0) { ret err[Fail].err{fail.malformed("common alignment is not a power of two")}; }
        var shift: u16 = 0;
        for ((1::u64 << shift::u64) < d.common.align) { shift = shift + 1; }
        if (shift > 15) { ret err[Fail].err{fail.overflow("common alignment is wider than its field")}; }
        e.type  = e.type | tables.N_UNDF.value::u8;
        e.value = d.common.size;
        e.desc  = e.desc | (shift << COMM_ALIGN_AT);
    }
    or (sel d.absolute) {
        e.type  = e.type | tables.N_ABS.value::u8;
        e.value = d.absolute;
        if (symbol.binds(s.binding, symbol.WEAK)) { e.desc = e.desc | tables.N_WEAK_DEF.value::u16; }
    }
    or (sel d.placed) {
        if (d.placed.section.index::usize >= b.nsec) { ret err[Fail].err{fail.malformed("symbol is placed in a section the object does not have")}; }
        if (d.placed.section.index::usize >= 255)    { ret err[Fail].err{fail.overflow("more sections than a symbol's section field holds")}; }
        val out: *Out = ?b.outs.data[d.placed.section.index::usize];
        e.type  = e.type | tables.N_SECT.value::u8;
        e.sect  = d.placed.section.index::u8 + 1;
        e.value = out.addr + d.placed.offset;
        # a copy is a weak definition coalesced with the others of its name
        if (symbol.binds(s.binding, symbol.WEAK) || sel s.group.some) { e.desc = e.desc | tables.N_WEAK_DEF.value::u16; }
    }
    or { ret err[Fail].err{fail.unsupported("Mach-O has no index spaces")}; }
    val res_nlist_pushed: res[Id[Nlist], Fail] = table.push[Nlist](?b.nlist, e);
    if (sel res_nlist_pushed.err) { ret err[Fail].err{res_nlist_pushed.err}; }
    val err_sym_ids_pushed: err[Fail] = vectors.push[Id[Name]](?b.sym_ids, res_names_added.ok);
    if (sel err_sym_ids_pushed.err) { ret err[Fail].err{err_sym_ids_pushed.err}; }
    ret err[Fail].ok{};
}

# the relocation records of every section, each section's in the object's
# order, and the fields they patch
fun relocs_out(b: *Build) err[Fail] {
    var i: usize = 0;
    for (i < table.count[object.Reloc](?b.o.relocs)) {
        val err_reloc_out: err[Fail] = reloc_out(b, i);
        if (sel err_reloc_out.err) { ret err[Fail].err{fail.in_indexed(err_reloc_out.err, "relocation", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the section a symbol lies in and its address there, for a record that
# names a section
fun placed_in(b: *Build, k: Id[object.Symbol]) res[Place, Fail] {
    val s: *object.Symbol = object.symbol_at(b.o, k);
    if (!sel s.def.placed) { ret res[Place, Fail].err{fail.unsupported("a relocation written as its section names a symbol that lies in none")}; }
    ret res[Place, Fail].ok{s.def.placed};
}

fun record(b: *Build, out: *Out, address: u64, symbolnum: u32, external: bool, k: u32) err[Fail] {
    if (address > 0xffff_ffff || (address & tables.R_SCATTERED.value) != 0) { ret err[Fail].err{fail.overflow("relocation offset is wider than its field")}; }
    var ext: u8 = 0;
    var pc:  u8 = 0;
    if (external)        { ext = 1; }
    if (key.pcrel_of(k)) { pc = 1; }
    val res_relocs_pushed: res[Id[Reloc], Fail] = table.push[Reloc](?out.relocs, Reloc.plain{Plain{address: address::u32, symbolnum: symbolnum, pcrel: pc, length: key.length_of(k)::u8, external: ext, type: key.type_of(k)::u8}});
    if (sel res_relocs_pushed.err) { ret err[Fail].err{res_relocs_pushed.err}; }
    if (external)                  { out.attrs = out.attrs | tables.S_ATTR_EXT_RELOC.value::u32; }
    or                             { out.attrs = out.attrs | tables.S_ATTR_LOC_RELOC.value::u32; }
    ret err[Fail].ok{};
}

# the section record `r` patches, checked to hold the field
fun patched(b: *Build, r: *object.Reloc) res[*Out, Fail] {
    if (r.section.index::usize >= b.nsec) { ret res[*Out, Fail].err{fail.malformed("relocation names a section the object does not have")}; }
    val out: *Out = ?b.outs.data[r.section.index::usize];
    if (out.zerofill)         { ret res[*Out, Fail].err{fail.malformed("a relocation patches a zero-fill section")}; }
    if (r.offset >= out.size) { ret res[*Out, Fail].err{fail.at_offset(fail.malformed("relocation lies past its section"), r.offset)}; }
    ret res[*Out, Fail].ok{out};
}

# a relocation against the absolute address zero, written as a local record
# naming R_ABS, the field holding what the row computes for a target of zero
fun absolute_out(b: *Build, r: *object.Reloc) err[Fail] {
    if (sel r.minus.some) { ret err[Fail].err{fail.unsupported("Mach-O has no difference from the absolute address zero")}; }
    val res_out: res[*Out, Fail] = patched(b, r);
    if (sel res_out.err) { ret err[Fail].err{res_out.err}; }
    val res_targeting: res[*Row, Fail] = row.targeting(b.set, r.kind, false);
    if (sel res_targeting.err)              { ret err[Fail].err{res_targeting.err}; }
    if (!sel res_targeting.ok.addend.field) { ret err[Fail].err{fail.about(fail.unsupported("a relocation against the absolute address zero holds no addend in its field"), res_targeting.ok.name)}; }
    if (!sel res_targeting.ok.names.either) { ret err[Fail].err{fail.about(fail.unsupported("a relocation of this kind names its target by a symbol, never the absolute address zero"), res_targeting.ok.name)}; }
    val o:         *Out            = res_out.ok;
    var site:      Site            = Site{file: "section", section: "section", data: sink.data(?o.bytes), size: o.size, offset: r.offset, order: b.order};
    var x:         compute.Inputs  = compute.Inputs{s: 0, a: r.addend, p: o.addr + r.offset};
    val res_value: res[i128, Fail] = engine.value(res_targeting.ok, ?site, ?x);
    if (sel res_value.err) { ret err[Fail].err{res_value.err}; }
    val err_site_inserted: err[Fail] = engine.insert(res_targeting.ok, ?site, res_value.ok);
    if (sel err_site_inserted.err) { ret err_site_inserted; }
    ret record(b, o, r.offset, tables.R_ABS.value::u32, false, res_targeting.ok.key);
}

fun reloc_out(b: *Build, i: usize) err[Fail] {
    val r: *object.Reloc = table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](i));
    if (sel r.target.entry)    { ret err[Fail].err{fail.unsupported("Mach-O has no index spaces to relocate against")}; }
    or (sel r.target.absolute) { ret absolute_out(b, r); }
    or (sel r.target.lines)    { ret err[Fail].err{fail.internal(object.UNLOWERED_LINES)}; }
    or (sel r.target.none) {
        val res_none: res[u64, Fail] = pair.write_nameless(b.pair);
        if (sel res_none.err) { ret err[Fail].err{res_none.err}; }
        ret err[Fail].err{fail.internal("the pair writes a relocation without a target, which no row takes")};
    }
    if (r.target.symbol.index::usize >= b.nsym || (sel r.minus.some && r.minus.some.index::usize >= b.nsym)) {
        ret err[Fail].err{fail.malformed("relocation names a symbol the object does not have")};
    }
    val res_patch: res[*Out, Fail] = patched(b, r);
    if (sel res_patch.err) { ret err[Fail].err{res_patch.err}; }
    val out:           *Out            = res_patch.ok;
    val res_targeting: res[*Row, Fail] = row.targeting(b.set, r.kind, sel r.minus.some);
    if (sel res_targeting.err)              { ret err[Fail].err{res_targeting.err}; }
    if (sel res_targeting.ok.write.started) { ret started_out(b, r, r.target.symbol, out, res_targeting.ok); }
    var site: Site = Site{file: "section", section: "section", data: sink.data(?out.bytes), size: out.size, offset: r.offset, order: b.order};
    if (sel r.minus.some) {
        val res_difference_of: res[Pairing, Fail] = row.difference_of(b.set, r.kind);
        if (sel res_difference_of.err) { ret err[Fail].err{res_difference_of.err}; }
        val sub: u32 = b.perm.data[r.minus.some.index::usize];
        val tgt: u32 = b.perm.data[r.target.symbol.index::usize];
        if (sub == 0 || tgt == 0) { ret err[Fail].err{fail.unsupported("a difference names a symbol the format writes as its section")}; }
        val err_put_addend: err[Fail] = engine.put_addend(res_targeting.ok, ?site, r.addend);
        if (sel err_put_addend.err) { ret err_put_addend; }
        val err_record: err[Fail] = record(b, out, r.offset, sub - 1, true, res_difference_of.ok.minus.key);
        if (sel err_record.err) { ret err_record; }
        ret record(b, out, r.offset, tgt - 1, true, res_targeting.ok.key);
    }
    if (sel res_targeting.ok.write.resolved) { ret resolved_out(b, r, r.target.symbol, out, res_targeting.ok); }
    val k:     u32  = b.perm.data[r.target.symbol.index::usize];
    val local: bool = b.local.data[i] && sel res_targeting.ok.addend.field;
    if (k != 0 && !local) {
        if (sel res_targeting.ok.addend.field) {
            var a: i64 = r.addend;
            if (macho_pairs.counts_from_section(b.pair, res_targeting.ok.key)) { a = a - r.offset:~i64; }
            val err_put_addend: err[Fail] = engine.put_addend(res_targeting.ok, ?site, a);
            if (sel err_put_addend.err) { ret err_put_addend; }
        }
        or (sel res_targeting.ok.addend.partner) {
            if (r.addend != 0) {
                val lo: i64 = -(1::i64 << (ADDEND_BITS - 1)::i64);
                val hi: i64 = (1::i64 << (ADDEND_BITS - 1)::i64) - 1;
                if (r.addend < lo || r.addend > hi) { ret err[Fail].err{fail.valued(fail.overflow("addend is wider than an ADDEND record holds"), r.addend::i128)}; }
                val err_record: err[Fail] = record(b, out, r.offset, (r.addend:~u64 & ((1::u64 << ADDEND_BITS::u64) - 1))::u32, false, res_targeting.ok.addend.partner.keys[0]);
                if (sel err_record.err) { ret err_record; }
            }
        }
        or {
            if (r.addend != 0) { ret err[Fail].err{fail.about(fail.unsupported("the record carries no addend"), res_targeting.ok.name)}; }
        }
        ret record(b, out, r.offset, k - 1, true, res_targeting.ok.key);
    }
    # a symbol the format has no entry for is written as its section, the
    # field holding what the row computes for its address, through the row
    # that counts the target from nearest the symbol
    if (!sel res_targeting.ok.addend.field) { ret err[Fail].err{fail.about(fail.unsupported("a relocation written as its section holds no addend in its field"), res_targeting.ok.name)}; }
    val pr:            *Row             = row.placing(b.set, res_targeting.ok, r.addend);
    val res_placed_in: res[Place, Fail] = placed_in(b, r.target.symbol);
    if (sel res_placed_in.err) { ret err[Fail].err{res_placed_in.err}; }
    val tgt:       *Out            = ?b.outs.data[res_placed_in.ok.section.index::usize];
    var x:         compute.Inputs  = compute.Inputs{s: tgt.addr + res_placed_in.ok.offset, a: r.addend, p: out.addr + r.offset};
    val res_value: res[i128, Fail] = engine.value(pr, ?site, ?x);
    if (sel res_value.err) { ret err[Fail].err{res_value.err}; }
    val err_site_inserted: err[Fail] = engine.insert(pr, ?site, res_value.ok);
    if (sel err_site_inserted.err) { ret err_site_inserted; }
    ret record(b, out, r.offset, res_placed_in.ok.section.index + 1, false, pr.key);
}

# a section offset its row writes from its section's start: the set's
# difference of the row's width, the target added and the start of the
# output section its section lands in subtracted, the addend in the field
fun started_out(b: *Build, r: *object.Reloc, target: Id[object.Symbol], out: *Out, rw: *Row) err[Fail] {
    val opt_difference_in: opt[Pairing] = row.difference_in(b.set, reloc_field.width(rw.fields[0].field));
    if (sel opt_difference_in.none) { ret err[Fail].err{fail.about(fail.internal("a section offset has no difference of its width"), rw.kind.name)}; }
    val opt_offset_into: opt[usize] = offset_into(b, r);
    if (sel opt_offset_into.none) { ret err[Fail].err{fail.about(fail.unsupported("a section offset names a target the object does not place, so no section start is known to subtract"), rw.kind.name)}; }
    val n:     usize = opt_offset_into.some;
    val tgt:   u32   = b.perm.data[target.index::usize];
    val start: u32   = b.starts.data[n];
    if (tgt == 0)   { ret err[Fail].err{fail.about(fail.internal("a section offset names a symbol with no entry after its target was named by one"), rw.kind.name)}; }
    if (start == 0) { ret err[Fail].err{fail.internal("a section offset names a section with no start entry")}; }
    var site:           Site      = Site{file: "section", section: "section", data: sink.data(?out.bytes), size: out.size, offset: r.offset, order: b.order};
    val err_put_addend: err[Fail] = engine.put_addend(opt_difference_in.some.plus, ?site, r.addend);
    if (sel err_put_addend.err) { ret err_put_addend; }
    val err_record: err[Fail] = record(b, out, r.offset, start - 1, true, opt_difference_in.some.minus.key);
    if (sel err_record.err) { ret err_record; }
    ret record(b, out, r.offset, tgt - 1, true, opt_difference_in.some.plus.key);
}

# a relocation its row resolves in place: the value the row computes from the
# object's own layout, written into the field with no record, its target a
# symbol placed in a section of the object
fun resolved_out(b: *Build, r: *object.Reloc, target: Id[object.Symbol], out: *Out, rw: *Row) err[Fail] {
    val y: *object.Symbol = object.symbol_at(b.o, target);
    if (!sel y.def.placed)                           { ret err[Fail].err{fail.about(fail.unsupported("a relocation resolved in place names a symbol the object does not place"), rw.name)}; }
    if (y.def.placed.section.index::usize >= b.nsec) { ret err[Fail].err{fail.malformed("symbol is placed in a section the object does not have")}; }
    val at:        Place           = y.def.placed;
    val tgt:       *Out            = ?b.outs.data[at.section.index::usize];
    var site:      Site            = Site{file: "section", section: "section", data: sink.data(?out.bytes), size: out.size, offset: r.offset, order: b.order};
    var x:         compute.Inputs  = compute.Inputs{s: tgt.addr + at.offset, a: r.addend, p: out.addr + r.offset};
    val res_value: res[i128, Fail] = engine.value(rw, ?site, ?x);
    if (sel res_value.err) { ret err[Fail].err{res_value.err}; }
    ret engine.insert(rw, ?site, res_value.ok);
}

# the size the load commands take, as the writer measures them
fun commands_size(b: *Build) u64 {
    var n: u64 = b.cls.segment.size::u64 + b.nsec::u64 * b.cls.section.size::u64;
    n = n + 24 + 80;
    if (sel b.target.sys.some) {
        if (b.min_cmd != 0) { n = n + 16; }
        or                  { n = n + 24 + 8 * vector.length[model.Tool](?b.tools)::u64; }
    }
    if (sel b.hints.some)                   { n = n + 16; }
    if (vector.length[Dice](?b.dices) != 0) { n = n + 16; }
    var i: usize = 0;
    for (i < table.count[Directive](?b.o.directives)) {
        val d: *Directive = table.at[Directive](?b.o.directives, table.nth[Directive](i));
        i = i + 1;
        if (d.kind != ?directive.EXPORT) { n = n + option_size(b, d); }
    }
    ret n;
}

# the bytes a linker option command for `d` takes: cmd, cmdsize and the
# count, then its strings, padded to the pointer
fun option_size(b: *Build, d: *Directive) u64 {
    var text: u64 = object.name_of(b.o, d.text).len::u64 + 1;
    if (d.kind == ?directive.LIBRARY)   { text = text + 2; }
    if (d.kind == ?directive.FRAMEWORK) { text = text + 11; }
    val raw: u64 = 12 + text;
    val a:   u64 = b.cls.addr::u64;
    ret (raw + a - 1) / a * a;
}

fun push_command(b: *Build, cmd: *Constant, size: u64, body: Load, rest: Held) res[Id[Command], Fail] {
    ret table.push[Command](?b.m.commands, Command{cmd: cmd.value::u32, cmdsize: size::u32, body: body, rest: rest});
}

fun no_rest() Held {
    ret Held.borrowed{Bytes{data: nil, len: 0}};
}

fun commands_out(b: *Build) err[Fail] {
    val cls: *Class = b.cls;
    b.base = cls.header.size::u64 + commands_size(b);
    var seg: model.Segment = model.Segment{vmsize: b.vmsize, fileoff: b.base, filesize: b.content, maxprot: OBJECT_PROT, initprot: OBJECT_PROT, nsects: b.nsec::u32, sections: vector.init[model.Section](b.a)};
    if (sel b.segment.some) {
        val f: *Fact = b.segment.some;
        val d: Bytes = object.bytes(b.o, ?f.data);
        var i: usize = 0;
        for (i < NAME_SIZE) {
            seg.segname[i] = d.data[i];
            i              = i + 1;
        }
        seg.maxprot  = (f.value >> 32)::u32;
        seg.initprot = (f.value & 0xffff_ffff)::u32;
    }
    var n: usize = 0;
    for (n < b.nsec) {
        val err_model_section: err[Fail] = model_section(b, n, ?seg);
        if (sel err_model_section.err) {
            val err_dropped: err[Fail] = vectors.dnit[model.Section](?seg.sections);
            ret err[Fail].err{fail.in_indexed(err_model_section.err, "section", n::u64)};
        }
        n = n + 1;
    }
    var seg_cmd: *Constant = ?tables.LC_SEGMENT;
    if (cls.addr == 8) { seg_cmd = ?tables.LC_SEGMENT_64; }
    val res_push_command: res[Id[Command], Fail] = push_command(b, seg_cmd, cls.segment.size::u64 + b.nsec::u64 * cls.section.size::u64, Load.segment{seg}, no_rest());
    if (sel res_push_command.err) {
        val err_dropped: err[Fail] = vectors.dnit[model.Section](?seg.sections);
        ret err[Fail].err{res_push_command.err};
    }
    b.seg_cmd = res_push_command.ok;
    val err_target_out: err[Fail] = target_out(b);
    if (sel err_target_out.err) { ret err_target_out; }
    if (sel b.hints.some) {
        val res_push_command: res[Id[Command], Fail] = push_command(b, ?tables.LC_LINKER_OPTIMIZATION_HINT, 16, Load.linkedit{model.Linkedit{}}, no_rest());
        if (sel res_push_command.err) { ret err[Fail].err{res_push_command.err}; }
        b.hint_cmd = res_push_command.ok;
    }
    if (vector.length[Dice](?b.dices) != 0) {
        val res_push_command: res[Id[Command], Fail] = push_command(b, ?tables.LC_DATA_IN_CODE, 16, Load.linkedit{model.Linkedit{}}, no_rest());
        if (sel res_push_command.err) { ret err[Fail].err{res_push_command.err}; }
        b.dic_cmd = res_push_command.ok;
    }
    val res_push_command_lc_symtab: res[Id[Command], Fail] = push_command(b, ?tables.LC_SYMTAB, 24, Load.symtab{model.Symtab{}}, no_rest());
    if (sel res_push_command_lc_symtab.err) { ret err[Fail].err{res_push_command_lc_symtab.err}; }
    b.sym_cmd = res_push_command_lc_symtab.ok;
    val res_push_command_lc_dysymtab: res[Id[Command], Fail] = push_command(b, ?tables.LC_DYSYMTAB, 80, Load.dysymtab{model.Dysymtab{
        ilocalsym: 0, nlocalsym: b.locals, iextdefsym: b.locals, nextdefsym: b.externs, iundefsym: b.locals + b.externs, nundefsym: b.undefs,
    }}, no_rest());
    if (sel res_push_command_lc_dysymtab.err) { ret err[Fail].err{res_push_command_lc_dysymtab.err}; }
    ret options_out(b);
}

# the target as LC_BUILD_VERSION, or as the LC_VERSION_MIN command the facts
# name. an object that states no system states no target
fun target_out(b: *Build) err[Fail] {
    val t: *target_model.Target = b.target;
    if (sel t.sys.none) {
        if (b.min_cmd != 0 || vector.length[model.Tool](?b.tools) != 0) { ret err[Fail].err{fail.unsupported("the facts state a version command and the target no system")}; }
        ret err[Fail].ok{};
    }
    if (sel t.env.none) { ret err[Fail].err{fail.about(fail.unsupported("Mach-O names a system through an environment, which the target states none of"), t.sys.some.name)}; }
    val opt_platform: opt[u32] = platform_of(t.env.some);
    if (sel opt_platform.none) { ret err[Fail].err{fail.about(fail.unsupported("the environment has no Mach-O platform"), t.env.some.name)}; }
    var minos: u32 = 0;
    var sdk:   u32 = 0;
    if (sel t.version.some) { minos = pack_version(t.version.some); }
    if (sel t.sdk.some)     { sdk = pack_version(t.sdk.some); }
    if (b.min_cmd != 0) {
        if (opt_platform.some::u64 != tables.PLATFORM_MACOS.value || b.min_cmd::u64 != tables.LC_VERSION_MIN_MACOSX.value) {
            ret err[Fail].err{fail.unsupported("the minimum version command the facts name does not name the target's platform")};
        }
        val res_push_command: res[Id[Command], Fail] = push_command(b, ?tables.LC_VERSION_MIN_MACOSX, 16, Load.version_min{model.VersionMin{version: minos, sdk: sdk}}, no_rest());
        if (sel res_push_command.err) { ret err[Fail].err{res_push_command.err}; }
        ret err[Fail].ok{};
    }
    var tools: Vector[model.Tool] = vector.init[model.Tool](b.a);
    if (vector.length[model.Tool](?b.tools) != 0) {
        val err_moved: err[Fail] = vectors.extend[model.Tool](?tools, b.tools.data, vector.length[model.Tool](?b.tools));
        if (sel err_moved.err) {
            val err_dropped: err[Fail] = vectors.dnit[model.Tool](?tools);
            ret err[Fail].err{err_moved.err};
        }
    }
    val n:                u64                    = vector.length[model.Tool](?tools)::u64;
    val res_push_command: res[Id[Command], Fail] = push_command(b, ?tables.LC_BUILD_VERSION, 24 + 8 * n, Load.build_version{model.BuildVersion{platform: opt_platform.some, minos: minos, sdk: sdk, ntools: n::u32, tools: tools}}, no_rest());
    if (sel res_push_command.err) {
        val err_dropped: err[Fail] = vectors.dnit[model.Tool](?tools);
        ret err[Fail].err{res_push_command.err};
    }
    ret err[Fail].ok{};
}

# one linker option command per directive: a library as `-l<name>`, a
# framework as `-framework` and its name, an option as its text. an export
# directive is no command but the symbol table's external symbol that is
# not private
fun options_out(b: *Build) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Directive](?b.o.directives)) {
        val d: *Directive = table.at[Directive](?b.o.directives, table.nth[Directive](i));
        i = i + 1;
        if (d.kind == ?directive.EXPORT) { cnt; }
        if (sel d.symbol.some)           { ret err[Fail].err{fail.in_indexed(fail.unsupported("Mach-O has no form for a directive about a symbol"), "directive", (i - 1)::u64)}; }
        var count: u32 = 1;
        if (d.kind == ?directive.FRAMEWORK) { count = 2; }
        var out:              Sink            = sink.init(b.a, b.order);
        val err_option_bytes: err[Fail]       = option_bytes(b, d, ?out);
        var res_held:         res[Held, Fail] = res[Held, Fail].err{fail.internal("no option was written")};
        if (sel err_option_bytes.err) { res_held = res[Held, Fail].err{err_option_bytes.err}; }
        or                            { res_held = model.own(?b.m, sink.data(?out), sink.len(?out)); }
        val err_rel: err[Fail] = sink.dnit(?out);
        if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
        if (sel err_rel.err)  { ret err_rel; }
        val res_push_command: res[Id[Command], Fail] = push_command(b, ?tables.LC_LINKER_OPTION, option_size(b, d), Load.linker_option{count}, res_held.ok);
        if (sel res_push_command.err) { ret err[Fail].err{res_push_command.err}; }
    }
    ret err[Fail].ok{};
}

# the strings of the linker option command for `d`, each terminated
fun option_bytes(b: *Build, d: *Directive, out: *Sink) err[Fail] {
    if (d.kind == ?directive.LIBRARY) {
        val err_lead: err[Fail] = sink.text(out, "-l");
        if (sel err_lead.err) { ret err_lead; }
    }
    or (d.kind == ?directive.FRAMEWORK) {
        val err_lead: err[Fail] = sink.text(out, "-framework");
        if (sel err_lead.err) { ret err_lead; }
        val err_end: err[Fail] = sink.u8(out, 0);
        if (sel err_end.err) { ret err_end; }
    }
    or (d.kind != ?directive.OPTION) {
        ret err[Fail].err{fail.about(fail.unsupported("Mach-O has no form for this directive"), d.kind.name)};
    }
    val v:         View      = object.name_of(b.o, d.text);
    val err_bytes: err[Fail] = sink.bytes(out, v.data, v.len);
    if (sel err_bytes.err) { ret err_bytes; }
    ret sink.u8(out, 0);
}

# the model section of neutral section `n`, holding its bytes and records
fun model_section(b: *Build, n: usize, seg: *model.Segment) err[Fail] {
    val out:   *Out            = ?b.outs.data[n];
    val sec:   *object.Section = object.section_at(b.o, Id[object.Section]{index: n::u32});
    var shift: u32             = 0;
    for ((1::u64 << shift::u64) < sec.align) { shift = shift + 1; }
    var s: model.Section = model.Section{
        sectname:  out.sectname,
        segname:   out.segname,
        addr:      out.addr,
        length:    out.size,
        align:     shift,
        nreloc:    table.count[Reloc](?out.relocs)::u32,
        flags:     out.type | out.attrs,
        reserved1: b.reserved.data[n * 3],
        reserved2: b.reserved.data[n * 3 + 1],
        reserved3: b.reserved.data[n * 3 + 2],
        relocs:    table.init[Reloc](b.a),
        body:      Body.empty{},
    };
    if (!out.zerofill) {
        s.offset = (b.base + out.addr)::u32;
        val res_held: res[Held, Fail] = model.own(?b.m, sink.data(?out.bytes), sink.len(?out.bytes));
        if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
        s.body = Body.raw{Raw{bytes: res_held.ok, why: Why.opaque{}}};
    }
    if (table.count[Reloc](?out.relocs) != 0) {
        val res_moved: res[Id[Reloc], Fail] = table.extend[Reloc](?s.relocs, table.items[Reloc](?out.relocs), table.count[Reloc](?out.relocs));
        if (sel res_moved.err) {
            val err_dropped: err[Fail] = table.dnit[Reloc](?s.relocs);
            ret err[Fail].err{res_moved.err};
        }
    }
    val err_sections_pushed: err[Fail] = vectors.push[model.Section](?seg.sections, s);
    if (sel err_sections_pushed.err) {
        val err_dropped: err[Fail] = table.dnit[Reloc](?s.relocs);
        ret err[Fail].err{err_sections_pushed.err};
    }
    ret err[Fail].ok{};
}

fun push_extent(b: *Build, e: Extent) err[Fail] {
    val err_extents_pushed: err[Fail] = vectors.push[Extent](?b.m.extents, e);
    if (sel err_extents_pushed.err) { ret err[Fail].err{err_extents_pushed.err}; }
    ret err[Fail].ok{};
}

fun push_blob(b: *Build, cmd: Id[Command], part: model.Part, data: model.Data) err[Fail] {
    val res_blobs_pushed: res[Id[model.Blob], Fail] = table.push[model.Blob](?b.m.blobs, model.Blob{command: cmd, part: part, data: data, gaps: vector.init[model.Gap](b.a)});
    if (sel res_blobs_pushed.err) { ret err[Fail].err{res_blobs_pushed.err}; }
    ret push_extent(b, Extent.blob{res_blobs_pushed.ok});
}

# the data in code entries at their addresses in the object, in ascending
# order as the loader and the tools expect them
fun data_in_code_out(b: *Build) err[Fail] {
    var t: Vector[DataInCode] = vector.init[DataInCode](b.a);
    var i: usize              = 0;
    for (i < vector.length[Dice](?b.dices)) {
        val d:   *Dice = ?b.dices.data[i];
        val out: *Out  = ?b.outs.data[d.section::usize];
        i = i + 1;
        if (out.zerofill || d.offset::u64 >= out.size) {
            val err_dropped: err[Fail] = vectors.dnit[DataInCode](?t);
            ret err[Fail].err{fail.malformed("a data in code entry lies outside its section's bytes")};
        }
        val at: u64 = out.addr + d.offset::u64;
        if (at > 0xffff_ffff) {
            val err_dropped: err[Fail] = vectors.dnit[DataInCode](?t);
            ret err[Fail].err{fail.overflow("a data in code offset is wider than its field")};
        }
        val err_dataincode_pushed: err[Fail] = vectors.push[DataInCode](?t, DataInCode{offset: at::u32, length: d.length, kind: d.kind});
        if (sel err_dataincode_pushed.err) {
            val err_dropped: err[Fail] = vectors.dnit[DataInCode](?t);
            ret err[Fail].err{err_dataincode_pushed.err};
        }
        var k: usize = vector.length[DataInCode](?t) - 1;
        for (k > 0) {
            val prev: *DataInCode = ?t.data[k - 1];
            val cur:  *DataInCode = ?t.data[k];
            if (prev.offset <= cur.offset) { brk; }
            val swap: DataInCode = @prev;
            @prev = @cur;
            @cur  = swap;
            k     = k - 1;
        }
    }
    val err_pushed: err[Fail] = push_blob(b, b.dic_cmd, model.Part.data{}, model.Data.data_in_code{t});
    if (sel err_pushed.err) {
        val err_dropped: err[Fail] = vectors.dnit[DataInCode](?t);
        ret err_pushed;
    }
    ret err[Fail].ok{};
}

# the file after the load commands: each section's bytes at its address,
# zeros between them, the relocation records, the hints, the symbols and
# the strings
fun extents_out(b: *Build) err[Fail] {
    var cursor: u64   = 0;
    var n:      usize = 0;
    for (n < b.nsec) {
        val out: *Out = ?b.outs.data[n];
        n = n + 1;
        if (out.zerofill) { cnt; }
        if (out.addr > cursor) {
            val err_pad: err[Fail] = zeros_out(b, out.addr - cursor);
            if (sel err_pad.err) { ret err_pad; }
        }
        val err_push_extent: err[Fail] = push_extent(b, Extent.section{SectionRef{command: b.seg_cmd, index: (n - 1)::u32}});
        if (sel err_push_extent.err) { ret err_push_extent; }
        cursor = out.addr + out.size;
    }
    n = 0;
    for (n < b.nsec) {
        val out: *Out = ?b.outs.data[n];
        n = n + 1;
        if (table.count[Reloc](?out.relocs) == 0) { cnt; }
        val err_push_extent: err[Fail] = push_extent(b, Extent.relocs{SectionRef{command: b.seg_cmd, index: (n - 1)::u32}});
        if (sel err_push_extent.err) { ret err_push_extent; }
    }
    if (sel b.hints.some) {
        val d:        Bytes           = object.bytes(b.o, ?b.hints.some.data);
        val res_held: res[Held, Fail] = model.own(?b.m, d.data, d.len);
        if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
        val err_push_blob: err[Fail] = push_blob(b, b.hint_cmd, model.Part.data{}, model.Data.raw{Raw{bytes: res_held.ok, why: Why.opaque{}}});
        if (sel err_push_blob.err) { ret err_push_blob; }
    }
    if (vector.length[Dice](?b.dices) != 0) {
        val err_data_in_code_out: err[Fail] = data_in_code_out(b);
        if (sel err_data_in_code_out.err) { ret err_data_in_code_out; }
    }
    val err_named: err[Fail] = strings_out(b);
    if (sel err_named.err) { ret err_named; }
    var syms: Table[Nlist] = table.init[Nlist](b.a);
    if (table.count[Nlist](?b.nlist) != 0) {
        val res_moved: res[Id[Nlist], Fail] = table.extend[Nlist](?syms, table.items[Nlist](?b.nlist), table.count[Nlist](?b.nlist));
        if (sel res_moved.err) {
            val err_dropped: err[Fail] = table.dnit[Nlist](?syms);
            ret err[Fail].err{res_moved.err};
        }
    }
    val err_push_blob: err[Fail] = push_blob(b, b.sym_cmd, model.Part.symbols{}, model.Data.symbols{syms});
    if (sel err_push_blob.err) {
        val err_dropped: err[Fail] = table.dnit[Nlist](?syms);
        ret err_push_blob;
    }
    ret push_blob(b, b.sym_cmd, model.Part.strings{}, model.Data.strings{b.strings});
}

# `n` zero bytes as a raw extent
fun zeros_out(b: *Build, n: u64) err[Fail] {
    var out:       Sink            = sink.init(b.a, b.order);
    val err_zeros: err[Fail]       = sink.zeros(?out, n::usize);
    var res_held:  res[Held, Fail] = res[Held, Fail].err{fail.internal("no padding was made")};
    if (sel err_zeros.err) { res_held = res[Held, Fail].err{err_zeros.err}; }
    or                     { res_held = model.own(?b.m, sink.data(?out), sink.len(?out)); }
    val err_rel: err[Fail] = sink.dnit(?out);
    if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
    if (sel err_rel.err)  { ret err_rel; }
    ret push_extent(b, Extent.raw{res_held.ok});
}

# fix the names, each symbol's n_strx with them, and hold the string table
fun strings_out(b: *Build) err[Fail] {
    val err_finish: err[Fail] = strtab.finish(?b.names);
    if (sel err_finish.err) { ret err_finish; }
    var k: usize = 0;
    for (k < table.count[Nlist](?b.nlist)) {
        val at: u64 = strtab.offset(?b.names, b.sym_ids.data[k]);
        if (at > 0xffff_ffff) { ret err[Fail].err{fail.overflow("string table is too large for its offsets")}; }
        table.at[Nlist](?b.nlist, table.nth[Nlist](k)).strx = at::u32;
        k                                                   = k + 1;
    }
    var out:       Sink            = sink.init(b.a, b.order);
    val err_write: err[Fail]       = strtab.write(?b.names, ?out);
    var res_held:  res[Held, Fail] = res[Held, Fail].err{fail.internal("no strings were written")};
    if (sel err_write.err) { res_held = res[Held, Fail].err{err_write.err}; }
    or                     { res_held = model.own(?b.m, sink.data(?out), sink.len(?out)); }
    val err_rel: err[Fail] = sink.dnit(?out);
    if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
    if (sel err_rel.err)  { ret err_rel; }
    b.strings = res_held.ok;
    ret err[Fail].ok{};
}

# the width and byte order of a file for `ar`, refused for an architecture
# with no address width
pub fun shape_of(ar: *Arch) res[Shape, Fail] {
    val opt_width: opt[u8] = arch.pointer_bytes(ar);
    if (sel opt_width.none) { ret res[Shape, Fail].err{fail.about(fail.unsupported("the architecture has no address width"), ar.name)}; }
    var cls: *Class = ?model.CLASS32;
    if (opt_width.some == 8) { cls = ?model.CLASS64; }
    ret res[Shape, Fail].ok{Shape{class: cls, order: ar.order}};
}

# the cputype and cpusubtype a mach header states
pub rec Cpu {
    cputype:    u32;
    cpusubtype: u32;
}

# the cputype and cpusubtype of a file for `ar`: the architecture's Mach-O
# code, with the capability bits `caps` no trait row maps and those the
# traits `ts` map
pub fun cpu_of(ar: *Arch, ts: *Vector[Trait], caps: u32) res[Cpu, Fail] {
    val opt_code: opt[*arch.Code] = arch.code(ar, ?format.MACHO);
    if (sel opt_code.none) { ret res[Cpu, Fail].err{fail.about(fail.unsupported("Mach-O has no code for the architecture"), ar.name)}; }
    val opt_cpu: opt[*arch.Ident] = arch.field(opt_code.some, arch.MACHO_CPU);
    val opt_sub: opt[*arch.Ident] = arch.field(opt_code.some, arch.MACHO_SUBTYPE);
    if (sel opt_cpu.none)                { ret res[Cpu, Fail].err{fail.about(fail.internal("the architecture's Mach-O code states no cpu type"), ar.name)}; }
    if (sel opt_sub.none)                { ret res[Cpu, Fail].err{fail.about(fail.internal("the architecture's Mach-O code states no cpu subtype"), ar.name)}; }
    if ((caps & traits.mapped(ar)) != 0) { ret res[Cpu, Fail].err{fail.malformed("raw cpusubtype capabilities hold bits a trait row maps")}; }
    val res_stated: res[u32, Fail] = traits.encode(ts);
    if (sel res_stated.err) { ret res[Cpu, Fail].err{res_stated.err}; }
    ret res[Cpu, Fail].ok{Cpu{cputype: opt_cpu.some.value::u32, cpusubtype: opt_sub.some.value::u32 | caps | res_stated.ok}};
}

fun header_out(b: *Build) err[Fail] {
    val res_cpu: res[Cpu, Fail] = cpu_of(b.target.arch, ?b.o.traits, b.caps);
    if (sel res_cpu.err) { ret err[Fail].err{res_cpu.err}; }
    var flags: u32   = b.flags;
    var n:     usize = 0;
    for (n < b.nsec) {
        if (object.section_at(b.o, Id[object.Section]{index: n::u32}).disposition == ?section.SPLIT) { flags = flags | tables.MH_SUBSECTIONS_VIA_SYMBOLS.value::u32; }
        n = n + 1;
    }
    var magic: u32 = tables.MH_MAGIC.value::u32;
    if (b.cls.addr == 8) { magic = tables.MH_MAGIC_64.value::u32; }
    b.m.header = model.Header{
        magic:      magic,
        cputype:    res_cpu.ok.cputype,
        cpusubtype: res_cpu.ok.cpusubtype,
        filetype:   tables.MH_OBJECT.value::u32,
        ncmds:      table.count[Command](?b.m.commands)::u32,
        sizeofcmds: (b.base - b.cls.header.size::u64)::u32,
        flags:      flags,
    };
    ret err[Fail].ok{};
}

fun build(b: *Build) err[Fail] {
    val err_begin_build: err[Fail] = begin_build(b);
    if (sel err_begin_build.err) { ret err_begin_build; }
    val err_facts_out: err[Fail] = facts_out(b);
    if (sel err_facts_out.err) { ret err_facts_out; }
    val err_sections_out: err[Fail] = sections_out(b);
    if (sel err_sections_out.err) { ret err_sections_out; }
    val err_symbols_out: err[Fail] = symbols_out(b);
    if (sel err_symbols_out.err) { ret err_symbols_out; }
    val err_relocs_out: err[Fail] = relocs_out(b);
    if (sel err_relocs_out.err) { ret err_relocs_out; }
    val err_commands_out: err[Fail] = commands_out(b);
    if (sel err_commands_out.err) { ret err_commands_out; }
    val err_extents_out: err[Fail] = extents_out(b);
    if (sel err_extents_out.err) { ret err_extents_out; }
    ret header_out(b);
}

fun build_dnit(b: *Build) err[Fail] {
    var err_first: err[Fail] = err[Fail].ok{};
    var i:         usize     = 0;
    for (i < vector.length[Out](?b.outs)) {
        val o: *Out = ?b.outs.data[i];
        err_first = fail.kept(err_first, sink.dnit(?o.bytes));
        err_first = fail.kept(err_first, table.dnit[Reloc](?o.relocs));
        i         = i + 1;
    }
    err_first = fail.kept(err_first, vectors.dnit[Out](?b.outs));
    err_first = fail.kept(err_first, vectors.dnit[u32](?b.perm));
    err_first = fail.kept(err_first, table.dnit[Nlist](?b.nlist));
    err_first = fail.kept(err_first, strtab.dnit(?b.names));
    err_first = fail.kept(err_first, vectors.dnit[Id[Name]](?b.sym_ids));
    err_first = fail.kept(err_first, vectors.dnit[u16](?b.desc));
    err_first = fail.kept(err_first, vectors.dnit[bool](?b.exported));
    err_first = fail.kept(err_first, vectors.dnit[u32](?b.types));
    err_first = fail.kept(err_first, vectors.dnit[u32](?b.attrs));
    err_first = fail.kept(err_first, vectors.dnit[Dice](?b.dices));
    err_first = fail.kept(err_first, vectors.dnit[u32](?b.starts));
    err_first = fail.kept(err_first, vectors.dnit[u32](?b.reserved));
    err_first = fail.kept(err_first, vectors.dnit[bool](?b.local));
    err_first = fail.kept(err_first, vectors.dnit[model.Tool](?b.tools));
    if (sel b.copy.some) { err_first = fail.kept(err_first, object.dnit(?b.copy.some)); }
    ret err_first;
}

# the model of `o` for the target `t`, laid out by the writer, its
# relocations written through the rows of `rows` and the records `o` states
# lowered into it in the encodings `lowering` names. `o` stays as it was
pub fun from_neutral(a: *A.Allocator, rows: *Registry, o: *Object, t: *target_model.Target, lowering: opt[*Lowering]) res[MachO, Fail] {
    var b: Build = Build{
        a:        a,
        o:        o,
        lowering: lowering,
        reg:      rows,
        target:   t,
        m:        model.init(a, Shape{class: ?model.CLASS64, order: t.arch.order}),
        outs:     vector.init[Out](a),
        perm:     vector.init[u32](a),
        nlist:    table.init[Nlist](a),
        names:    strtab.init(a, strtab.Convention{lead: true, term: strtab.NUL}),
        sym_ids:  vector.init[Id[Name]](a),
        desc:     vector.init[u16](a),
        exported: vector.init[bool](a),
        types:    vector.init[u32](a),
        attrs:    vector.init[u32](a),
        reserved: vector.init[u32](a),
        local:    vector.init[bool](a),
        tools:    vector.init[model.Tool](a),
        dices:    vector.init[Dice](a),
        starts:   vector.init[u32](a),
    };
    val err_build: err[Fail] = build(?b);
    val err_rel:   err[Fail] = build_dnit(?b);
    if (sel err_build.err) {
        val err_dropped: err[Fail] = model.dnit(?b.m);
        ret res[MachO, Fail].err{err_build.err};
    }
    if (sel err_rel.err) {
        val err_dropped: err[Fail] = model.dnit(?b.m);
        ret res[MachO, Fail].err{err_rel.err};
    }
    ret res[MachO, Fail].ok{b.m};
}

# four arm64 instructions: bl, adrp x0, ldr x0 [x0], ret
val CODE: [16]u8 = [16]u8{0x00, 0x00, 0x00, 0x94, 0x00, 0x00, 0x00, 0x90, 0x00, 0x00, 0x40, 0xf9, 0xc0, 0x03, 0x5f, 0xd6};

fun at(sec: Id[object.Section], offset: u64) Definition {
    ret Definition.placed{Place{section: sec, offset: offset}};
}
