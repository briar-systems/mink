# the facts only Mach-O states
#
# a fact is keyed by one of Mach-O's own keys below, and holds what the
# neutral model has no field for, so an object read from a file converts back
# to a file that states the same. a fact about one section or symbol names it
# by its neutral index in the high bits of its value. the settle rows of the
# Mach-O linking rules name every key here, so a link of two objects of the
# format settles each.

use std.types.size.usize;

# HEADER_FLAGS:       the mach header flags the conversion does not derive,
#                     MH_SUBSECTIONS_VIA_SYMBOLS coming from the dispositions
# SUBTYPE_CAPS:       the cpusubtype capability bits past the ptrauth version
#                     the architecture row fixes
# SECTION_TYPE:       a section whose type is not the one its kind is written
#                     with: the section's index in the high word and the type
#                     in the low
# SECTION_ATTRIBUTES: a section's attributes past the ones its kind and flags
#                     write: the index in the high word, the bits in the low
# SECTION_RESERVED:   a section's reserved words: the index the value, the
#                     twelve bytes of the three words the data, little endian
# SYMBOL_DESC:        a symbol's n_desc bits past the ones its binding,
#                     retention and alternate entry write: the index in the
#                     high bits and the bits in the low sixteen
# BUILD_TOOL:         one tool of LC_BUILD_VERSION: the tool in the high word
#                     and its version in the low
# VERSION_MIN:        the target's version was stated by an LC_VERSION_MIN
#                     command: its cmd
# LINKER_HINTS:       the linker optimization hints: their bytes the data
# SEGMENT:            the object's segment states a name or protections of
#                     its own: maxprot in the high word and initprot in the
#                     low, the sixteen bytes of the name the data
pub val HEADER_FLAGS:       u32 = 0;
pub val SUBTYPE_CAPS:       u32 = 1;
pub val SECTION_TYPE:       u32 = 2;
pub val SECTION_ATTRIBUTES: u32 = 3;
pub val SECTION_RESERVED:   u32 = 4;
pub val SYMBOL_DESC:        u32 = 5;
pub val BUILD_TOOL:         u32 = 6;
pub val VERSION_MIN:        u32 = 7;
pub val LINKER_HINTS:       u32 = 8;
pub val SEGMENT:            u32 = 9;

pub val COUNT: usize = 10;
