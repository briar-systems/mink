# the Mach-O section each neutral section kind is written as
#
# one row per kind Mach-O can name, looked up by the kind's name, stating the
# segment and section a section that states only its kind takes, spelled
# segment,section as the neutral model names a Mach-O section, with its type
# and attributes. Mach-O has no table of functions run before every
# initializer, its debugging sections say by name which table they hold, and
# it has no notes or metadata, so those kinds have no row and a nameless
# section of one is refused. a thin object holds one section of a name, so two
# nameless sections of one kind are refused too.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.table;
use mink.base.table.Id;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;
use mink.model.object;
use mink.model.object.Object;
use mink.model.section;

# kind:       the neutral kind
# name:       the segment and section a section of the kind that states none
#             takes
# type:       its section type
# attributes: its section attributes
pub rec Row {
    kind:       *section.Kind;
    name:       str;
    type:       *Constant;
    attributes: u64;
}

val CODE:   u64 = tables.S_ATTR_PURE_INSTRUCTIONS.value | tables.S_ATTR_SOME_INSTRUCTIONS.value;
val FRAMES: u64 = tables.S_ATTR_NO_TOC.value | tables.S_ATTR_STRIP_STATIC_SYMS.value | tables.S_ATTR_LIVE_SUPPORT.value;

val TEXT_ROW:       Row = Row{kind: ?section.TEXT, name: "__TEXT,__text", type: ?tables.S_REGULAR, attributes: CODE};
val RODATA_ROW:     Row = Row{kind: ?section.RODATA, name: "__TEXT,__const", type: ?tables.S_REGULAR, attributes: 0};
val DATA_ROW:       Row = Row{kind: ?section.DATA, name: "__DATA,__data", type: ?tables.S_REGULAR, attributes: 0};
val RELRO_ROW:      Row = Row{kind: ?section.RELRO_DATA, name: "__DATA,__const", type: ?tables.S_REGULAR, attributes: 0};
val BSS_ROW:        Row = Row{kind: ?section.BSS, name: "__DATA,__bss", type: ?tables.S_ZEROFILL, attributes: 0};
val TLS_DATA_ROW:   Row = Row{kind: ?section.TLS_DATA, name: "__DATA,__thread_data", type: ?tables.S_THREAD_LOCAL_REGULAR, attributes: 0};
val TLS_BSS_ROW:    Row = Row{kind: ?section.TLS_BSS, name: "__DATA,__thread_bss", type: ?tables.S_THREAD_LOCAL_ZEROFILL, attributes: 0};
val INIT_ARRAY_ROW: Row = Row{kind: ?section.INIT_ARRAY, name: "__DATA,__mod_init_func", type: ?tables.S_MOD_INIT_FUNC_POINTERS, attributes: 0};
val FINI_ARRAY_ROW: Row = Row{kind: ?section.FINI_ARRAY, name: "__DATA,__mod_term_func", type: ?tables.S_MOD_TERM_FUNC_POINTERS, attributes: 0};
val UNWIND_ROW:     Row = Row{kind: ?section.UNWIND_INFO, name: "__TEXT,__eh_frame", type: ?tables.S_COALESCED, attributes: FRAMES};

val ROW_COUNT: usize           = 10;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{
    ?TEXT_ROW, ?RODATA_ROW, ?DATA_ROW, ?RELRO_ROW, ?BSS_ROW, ?TLS_DATA_ROW, ?TLS_BSS_ROW,
    ?INIT_ARRAY_ROW, ?FINI_ARRAY_ROW, ?UNWIND_ROW,
};

# the rows ascending by kind name
val KINDS: [ROW_COUNT]*Row = [ROW_COUNT]*Row{
    ?BSS_ROW, ?DATA_ROW, ?FINI_ARRAY_ROW, ?INIT_ARRAY_ROW, ?RELRO_ROW, ?RODATA_ROW,
    ?TLS_BSS_ROW, ?TLS_DATA_ROW, ?TEXT_ROW, ?UNWIND_ROW,
};

# the kinds Mach-O has no row for
val REFUSED_COUNT: usize                        = 9;
val REFUSED:       [REFUSED_COUNT]*section.Kind = [REFUSED_COUNT]*section.Kind{
    ?section.PREINIT_ARRAY, ?section.NOTE_INFO, ?section.DEBUG_INFO, ?section.METADATA,
    ?section.ADDRSIG_TABLE, ?section.COMMENT_STRINGS, ?section.STACK_NOTE, ?section.DEPENDENT_LIBRARIES, ?section.LINK_WARNING,
};

fun order(a: **Row, b: **Row) i64 {
    ret str_compare(a[0].kind.name, b[0].kind.name);
}

# the row of kind `k`
pub fun row_of(k: *section.Kind) res[*Row, Fail] {
    var probe: Row       = Row{kind: k};
    val row:   opt[*Row] = index.find[Row](?KINDS[0], ROW_COUNT, ?probe, order);
    if (sel row.none) { ret res[*Row, Fail].err{fail.about(fail.unsupported("Mach-O has no section for this kind"), k.name)}; }
    ret res[*Row, Fail].ok{row.some};
}

# the name a section of kind `k` that states none is written with
pub fun name_of(k: *section.Kind) res[str, Fail] {
    val row: res[*Row, Fail] = row_of(k);
    if (sel row.err) { ret res[str, Fail].err{row.err}; }
    ret res[str, Fail].ok{row.ok.name};
}

# refuse an object whose nameless sections Mach-O cannot write: one of a kind
# with no row, or two of one kind, which would take one name. every nameless
# section kept has a distinct row, so at most a row's worth are compared
pub fun nameless(o: *Object) err[Fail] {
    var seen: [ROW_COUNT]*section.Kind;
    var held: usize = 0;
    var i:    usize = 0;
    for (i < table.count[object.Section](?o.sections)) {
        val s: *object.Section = object.section_at(o, table.nth[object.Section](i));
        i = i + 1;
        if (sel s.name.some) { cnt; }
        val row: res[*Row, Fail] = row_of(s.kind);
        if (sel row.err) { ret err[Fail].err{fail.in_indexed(row.err, "section", (i - 1)::u64)}; }
        var j: usize = 0;
        for (j < held) {
            if (seen[j] == s.kind) {
                ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("Mach-O holds one section of a name, so it cannot write two nameless sections of one kind"), s.kind.name), "section", (i - 1)::u64)};
            }
            j = j + 1;
        }
        seen[held] = s.kind;
        held       = held + 1;
    }
    ret err[Fail].ok{};
}

test naming__every_kind_has_one_row_or_is_refused {
    val rows:  [ROW_COUNT]*Row = ROWS;
    val built: err[Fail]       = index.verify[Row](?KINDS[0], ROW_COUNT, ?rows[0], ROW_COUNT, order);
    if (sel built.err) { ret 1; }
    var kinds: [ROW_COUNT + REFUSED_COUNT]*section.Kind;
    var i:     usize = 0;
    for (i < ROW_COUNT) {
        kinds[i] = ROWS[i].kind;
        i        = i + 1;
    }
    var j: usize = 0;
    for (j < REFUSED_COUNT) {
        kinds[ROW_COUNT + j] = REFUSED[j];
        val refused: res[str, Fail] = name_of(REFUSED[j]);
        if (!sel refused.err)                   { ret 3; }
        if (!sel refused.err.cause.unsupported) { ret 3; }
        j = j + 1;
    }
    if (!section.once_each(?kinds[0], ROW_COUNT + REFUSED_COUNT)) { ret 2; }
    ret 0;
}

test naming__two_nameless_sections_of_one_kind_are_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val x: res[*Arch, Fail] = arch.by_name("x86_64");
    if (sel x.err) { ret 1; }
    var o: Object = object.make(T.allocator_of(?t), x.ok);

    val data: res[Id[object.Section], Fail] = object.add_section(?o, object.Section{kind: ?section.DATA, flags: section.DATA.flags, align: 8, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel data.err) { ret 1; }
    val bss: res[Id[object.Section], Fail] = object.add_section(?o, object.Section{kind: ?section.BSS, flags: section.BSS.flags, align: 8, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel bss.err) { ret 1; }
    val one: err[Fail] = nameless(?o);
    if (sel one.err) { ret 2; }
    val again: res[Id[object.Section], Fail] = object.add_section(?o, object.Section{kind: ?section.DATA, flags: section.DATA.flags, align: 8, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel again.err) { ret 1; }
    val two: err[Fail] = nameless(?o);
    if (!sel two.err)                   { ret 3; }
    if (!sel two.err.cause.unsupported) { ret 3; }

    val rel: err[Fail] = object.release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    ret 0;
}
