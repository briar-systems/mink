# the Mach-O section each neutral section kind is written as, and the kind a
# Mach-O section header takes
#
# one row per kind Mach-O can name, stating the section name a section of
# the kind that states none takes, with its type and attributes. a row never
# states the segment: the segment a section loads in is the layout's, the
# class its flags and roles place it in, so `__mod_init_func` and `__const`
# of read-only data come out under `__DATA_CONST` as ld64 lays them. a
# neutral name spells a Mach-O section `segment,section`, and a name is
# classified by its section part, the segment telling two kinds of one
# section name apart, as `__TEXT,__const` and `__DATA,__const` are. the
# reader classifies a header by its type word first, then by its name and
# then by its flags, so a type that names its kind, as zero fill and the
# literal types do, needs no name row. Mach-O has no table of functions run
# before every initializer, no notes, no metadata and no debugging section
# that states its kind by anything but its own name, so those kinds have no
# nameless form and a nameless section of one is refused. a thin object
# holds one section of a name, so two nameless sections of one kind are
# refused too.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.catalog.arch.Arch;
use mink.catalog.arch.list;
use mink.format.contract;
use mink.format.contract.Naming;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;
use mink.model.object;
use mink.model.object.Object;
use mink.model.section;

# kind:       the neutral kind
# name:       the section name a section of the kind takes, nil for a kind
#             named only by its producer
# type:       its section type
# attributes: its section attributes
# nameless:   whether a section of the kind that states no name is written
#             with this name, which only a kind the layout places in a
#             segment is
# alias:      a second name a section of the kind takes, which no nameless
#             section is written as
pub rec Row {
    kind:       *section.Kind;
    name:       str;
    type:       *Constant;
    attributes: u64;
    nameless:   bool;
    alias:      bool;
}

pub val CODE:   u64 = tables.S_ATTR_PURE_INSTRUCTIONS.value | tables.S_ATTR_SOME_INSTRUCTIONS.value;
val     FRAMES: u64 = tables.S_ATTR_NO_TOC.value | tables.S_ATTR_STRIP_STATIC_SYMS.value | tables.S_ATTR_LIVE_SUPPORT.value;
val     DEBUG:  u64 = tables.S_ATTR_DEBUG.value;

val TEXT_ROW:       Row = Row{kind: ?section.TEXT, name: "__text", type: ?tables.S_REGULAR, attributes: CODE, nameless: true};
val RODATA_ROW:     Row = Row{kind: ?section.RODATA, name: "__const", type: ?tables.S_REGULAR, nameless: true};
val DATA_ROW:       Row = Row{kind: ?section.DATA, name: "__data", type: ?tables.S_REGULAR, nameless: true};
val RELRO_ROW:      Row = Row{kind: ?section.RELRO_DATA, name: "__const", type: ?tables.S_REGULAR, nameless: true};
val BSS_ROW:        Row = Row{kind: ?section.BSS, name: "__bss", type: ?tables.S_ZEROFILL, nameless: true};
val COMMON_ROW:     Row = Row{kind: ?section.BSS, name: "__common", type: ?tables.S_ZEROFILL, alias: true};
val TLS_DATA_ROW:   Row = Row{kind: ?section.TLS_DATA, name: "__thread_data", type: ?tables.S_THREAD_LOCAL_REGULAR, nameless: true};
val TLS_BSS_ROW:    Row = Row{kind: ?section.TLS_BSS, name: "__thread_bss", type: ?tables.S_THREAD_LOCAL_ZEROFILL, nameless: true};
val INIT_ARRAY_ROW: Row = Row{kind: ?section.INIT_ARRAY, name: "__mod_init_func", type: ?tables.S_MOD_INIT_FUNC_POINTERS, nameless: true};
val FINI_ARRAY_ROW: Row = Row{kind: ?section.FINI_ARRAY, name: "__mod_term_func", type: ?tables.S_MOD_TERM_FUNC_POINTERS, nameless: true};
val UNWIND_ROW:     Row = Row{kind: ?section.UNWIND_INFO, name: "__eh_frame", type: ?tables.S_COALESCED, attributes: FRAMES, nameless: true};
val RECORDS_ROW:    Row = Row{kind: ?section.UNWIND_RECORDS, name: "__compact_unwind", type: ?tables.S_REGULAR, attributes: DEBUG};
val ADDRSIG_ROW:    Row = Row{kind: ?section.ADDRSIG_TABLE, name: "__llvm_addrsig", type: ?tables.S_REGULAR};
val DEBUG_ROW:      Row = Row{kind: ?section.DEBUG_INFO, name: nil, type: ?tables.S_REGULAR, attributes: DEBUG};

val ROW_COUNT: usize           = 14;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{
    ?TEXT_ROW, ?RODATA_ROW, ?DATA_ROW, ?RELRO_ROW, ?BSS_ROW, ?COMMON_ROW, ?TLS_DATA_ROW, ?TLS_BSS_ROW,
    ?INIT_ARRAY_ROW, ?FINI_ARRAY_ROW, ?UNWIND_ROW, ?RECORDS_ROW, ?ADDRSIG_ROW, ?DEBUG_ROW,
};

# one row per kind, ascending by kind name, the aliases left out
val KIND_COUNT: usize            = 13;
val KINDS:      [KIND_COUNT]*Row = [KIND_COUNT]*Row{
    ?ADDRSIG_ROW, ?BSS_ROW, ?DATA_ROW, ?DEBUG_ROW, ?FINI_ARRAY_ROW, ?INIT_ARRAY_ROW, ?RELRO_ROW,
    ?RODATA_ROW, ?TLS_BSS_ROW, ?TLS_DATA_ROW, ?TEXT_ROW, ?UNWIND_ROW, ?RECORDS_ROW,
};

# the named rows ascending by section name, two of one name adjacent
val NAME_COUNT: usize            = 13;
val NAMES:      [NAME_COUNT]*Row = [NAME_COUNT]*Row{
    ?BSS_ROW, ?COMMON_ROW, ?RECORDS_ROW, ?RELRO_ROW, ?RODATA_ROW, ?DATA_ROW, ?UNWIND_ROW,
    ?ADDRSIG_ROW, ?INIT_ARRAY_ROW, ?FINI_ARRAY_ROW, ?TEXT_ROW, ?TLS_BSS_ROW, ?TLS_DATA_ROW,
};

# the kinds Mach-O has no row for
val REFUSED_COUNT: usize                        = 6;
val REFUSED:       [REFUSED_COUNT]*section.Kind = [REFUSED_COUNT]*section.Kind{
    ?section.PREINIT_ARRAY, ?section.NOTE_INFO, ?section.METADATA, ?section.COMMENT_STRINGS, ?section.STACK_NOTE, ?section.LINK_WARNING,
};

# what a section type is to a neutral object
# ---
# named: a neutral section whose name and flags set its kind
# kind:  a neutral section of this kind, zero fill taking the thread-local
#        kind under the TLS flag
pub tag Reads: u8 {
    named;
    kind: *section.Kind;
}

# a section type and what it is to a neutral object
# ---
# word:  its name as an assembler spells it after the segment and section
# type:  its section type
# reads: what it is
pub rec Type {
    word:  str;
    type:  *Constant;
    reads: Reads;
}

val TYPE_COUNT: usize            = 23;
val TYPES:      [TYPE_COUNT]Type = [TYPE_COUNT]Type{
    Type{word: "regular", type: ?tables.S_REGULAR, reads: Reads.named{}},
    Type{word: "zerofill", type: ?tables.S_ZEROFILL, reads: Reads.kind{?section.BSS}},
    Type{word: "cstring_literals", type: ?tables.S_CSTRING_LITERALS, reads: Reads.kind{?section.RODATA}},
    Type{word: "4byte_literals", type: ?tables.S_4BYTE_LITERALS, reads: Reads.kind{?section.RODATA}},
    Type{word: "8byte_literals", type: ?tables.S_8BYTE_LITERALS, reads: Reads.kind{?section.RODATA}},
    Type{word: "literal_pointers", type: ?tables.S_LITERAL_POINTERS, reads: Reads.kind{?section.DATA}},
    Type{word: "non_lazy_symbol_pointers", type: ?tables.S_NON_LAZY_SYMBOL_POINTERS, reads: Reads.kind{?section.DATA}},
    Type{word: "lazy_symbol_pointers", type: ?tables.S_LAZY_SYMBOL_POINTERS, reads: Reads.kind{?section.DATA}},
    Type{word: "symbol_stubs", type: ?tables.S_SYMBOL_STUBS, reads: Reads.kind{?section.TEXT}},
    Type{word: "mod_init_funcs", type: ?tables.S_MOD_INIT_FUNC_POINTERS, reads: Reads.kind{?section.INIT_ARRAY}},
    Type{word: "mod_term_funcs", type: ?tables.S_MOD_TERM_FUNC_POINTERS, reads: Reads.kind{?section.FINI_ARRAY}},
    Type{word: "coalesced", type: ?tables.S_COALESCED, reads: Reads.named{}},
    Type{word: "gb_zerofill", type: ?tables.S_GB_ZEROFILL, reads: Reads.kind{?section.BSS}},
    Type{word: "interposing", type: ?tables.S_INTERPOSING, reads: Reads.kind{?section.DATA}},
    Type{word: "16byte_literals", type: ?tables.S_16BYTE_LITERALS, reads: Reads.kind{?section.RODATA}},
    Type{word: "dtrace_dof", type: ?tables.S_DTRACE_DOF, reads: Reads.kind{?section.DATA}},
    Type{word: "lazy_dylib_symbol_pointers", type: ?tables.S_LAZY_DYLIB_SYMBOL_POINTERS, reads: Reads.kind{?section.DATA}},
    Type{word: "thread_local_regular", type: ?tables.S_THREAD_LOCAL_REGULAR, reads: Reads.kind{?section.TLS_DATA}},
    Type{word: "thread_local_zerofill", type: ?tables.S_THREAD_LOCAL_ZEROFILL, reads: Reads.kind{?section.TLS_BSS}},
    Type{word: "thread_local_variables", type: ?tables.S_THREAD_LOCAL_VARIABLES, reads: Reads.kind{?section.DATA}},
    Type{word: "thread_local_variable_pointers", type: ?tables.S_THREAD_LOCAL_VARIABLE_POINTERS, reads: Reads.kind{?section.DATA}},
    Type{word: "thread_local_init_function_pointers", type: ?tables.S_THREAD_LOCAL_INIT_FUNCTION_POINTERS, reads: Reads.kind{?section.DATA}},
    Type{word: "init_func_offsets", type: ?tables.S_INIT_FUNC_OFFSETS, reads: Reads.kind{?section.DATA}},
};

# the entry size a literal type states, zero for none
fun literal_entsize(t: *Constant) u64 {
    if (t == ?tables.S_4BYTE_LITERALS)  { ret 4; }
    if (t == ?tables.S_8BYTE_LITERALS)  { ret 8; }
    if (t == ?tables.S_16BYTE_LITERALS) { ret 16; }
    ret 0;
}

# the type a section of kind `k` with the neutral flags `flags` and entry
# size `entsize` is written with: the literal types for merged read-only
# data, and the kind's row otherwise
pub fun type_for(r: *Row, flags: section.Flags, entsize: u64) *Constant {
    if ((flags & section.STRINGS) != 0 && (flags & section.MERGE) != 0 && r.kind == ?section.RODATA) { ret ?tables.S_CSTRING_LITERALS; }
    if ((flags & section.MERGE) != 0 && r.kind == ?section.RODATA) {
        var i: usize = 0;
        for (i < TYPE_COUNT) {
            if (literal_entsize(TYPES[i].type) == entsize && entsize != 0) { ret TYPES[i].type; }
            i = i + 1;
        }
    }
    ret r.type;
}

# the neutral flags a section type adds beyond its kind's: strings and
# merging for the literal types, and the entry size the type states
pub fun type_flags(t: *Constant) section.Flags {
    if (t == ?tables.S_CSTRING_LITERALS) { ret section.MERGE | section.STRINGS; }
    if (literal_entsize(t) != 0)         { ret section.MERGE; }
    ret 0;
}

pub fun type_entsize(t: *Constant) u64 {
    ret literal_entsize(t);
}

# the type row of the word `word`, none when no type is spelled so
pub fun type_by_word(word: str) opt[*Type] {
    var i: usize = 0;
    for (i < TYPE_COUNT) {
        if (str_equals(TYPES[i].word, word)) { ret opt[*Type].some{?TYPES[i]}; }
        i = i + 1;
    }
    ret opt[*Type].none{};
}

# the type row of the section type `type`, none for a type no row names
pub fun type_of(type: u32) opt[*Type] {
    var i: usize = 0;
    for (i < TYPE_COUNT) {
        if (TYPES[i].type.value == type::u64) { ret opt[*Type].some{?TYPES[i]}; }
        i = i + 1;
    }
    ret opt[*Type].none{};
}

fun order(a: **Row, b: **Row) i64 {
    ret str_compare(a[0].kind.name, b[0].kind.name);
}

# the row of kind `k`, refused for a kind Mach-O has no row for
pub fun row_of(k: *section.Kind) res[*Row, Fail] {
    var probe: Row       = Row{kind: k};
    val row:   opt[*Row] = index.find[Row](?KINDS[0], KIND_COUNT, ?probe, order);
    if (sel row.none) { ret res[*Row, Fail].err{fail.about(fail.unsupported("Mach-O has no section for this kind"), k.name)}; }
    ret res[*Row, Fail].ok{row.some};
}

# the section name a section of kind `k` that states none is written with.
# its segment is the layout's
pub fun name_of(k: *section.Kind) res[str, Fail] {
    val row: res[*Row, Fail] = row_of(k);
    if (sel row.err)      { ret res[str, Fail].err{row.err}; }
    if (!row.ok.nameless) { ret res[str, Fail].err{fail.about(fail.unsupported("Mach-O writes a nameless section of this kind under no name"), k.name)}; }
    ret res[str, Fail].ok{row.ok.name};
}

fun spelling(r: *Row) str {
    ret r.name;
}

# the segment and section parts of a name spelled `segment,section`, the
# section part empty when the name holds no comma
pub rec Split {
    segment: Bytes;
    section: Bytes;
    comma:   bool;
}

pub fun split(name: Bytes) Split {
    var i: usize = 0;
    for (i < name.len) {
        if (name.data[i] == ',') {
            ret Split{segment: Bytes{data: name.data, len: i}, section: Bytes{data: ?name.data[i + 1], len: name.len - i - 1}, comma: true};
        }
        i = i + 1;
    }
    ret Split{segment: name, section: Bytes{data: name.data, len: 0}, comma: false};
}

# whether `name` spells `want`
fun named(name: Bytes, want: str) bool {
    if (name.len != str_len(want)) { ret false; }
    var i: usize = 0;
    for (i < name.len) {
        if (name.data[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the segments a section loads in and the flags each maps with, as the
# layout's loads state them, named here so a name is classified by its
# segment without reaching the link rules that name the segments
rec Segment {
    name:  str;
    flags: section.Flags;
}

val SEGMENT_COUNT: usize                  = 3;
val SEGMENTS:      [SEGMENT_COUNT]Segment = [SEGMENT_COUNT]Segment{
    Segment{name: "__TEXT", flags: section.ALLOC | section.EXEC},
    Segment{name: "__DATA_CONST", flags: section.ALLOC | section.WRITE},
    Segment{name: "__DATA", flags: section.ALLOC | section.WRITE},
};

# the flags the segment named `segment` maps with, none for a segment the
# layout does not place sections in
pub fun segment_flags(segment: Bytes) opt[section.Flags] {
    var i: usize = 0;
    for (i < SEGMENT_COUNT) {
        if (named(segment, SEGMENTS[i].name)) { ret opt[section.Flags].some{SEGMENTS[i].flags}; }
        i = i + 1;
    }
    ret opt[section.Flags].none{};
}

# the rows spelled `section`: where the first lies in NAMES and how many
fun rows_named(section: Bytes) contract.Rows {
    val first: opt[*Row] = contract.spelled[Row](?NAMES[0], NAME_COUNT, section, 0, spelling);
    if (sel first.none) { ret contract.Rows{at: 0, count: 0}; }
    var at: usize = 0;
    for (at < NAME_COUNT && NAMES[at] != first.some) { at = at + 1; }
    for (at > 0 && named(section, NAMES[at - 1].name)) { at = at - 1; }
    var n: usize = 0;
    for (at + n < NAME_COUNT && named(section, NAMES[at + n].name)) { n = n + 1; }
    ret contract.Rows{at: at, count: n};
}

# the kind a section named `name`, spelled `segment,section`, takes by the
# convention: the row of its section name, two rows of one name told apart by
# the segment's flags. none for a name with no segment, a section name no
# row spells, or a segment the layout does not place
pub fun kind_of(name: Bytes) opt[*section.Kind] {
    val s: Split = split(name);
    if (!s.comma) { ret opt[*section.Kind].none{}; }
    val rows: contract.Rows = rows_named(s.section);
    if (rows.count == 0) { ret opt[*section.Kind].none{}; }
    if (rows.count == 1) { ret opt[*section.Kind].some{NAMES[rows.at].kind}; }
    val seg: opt[section.Flags] = segment_flags(s.segment);
    if (sel seg.none) { ret opt[*section.Kind].none{}; }
    var i: usize = 0;
    for (i < rows.count) {
        val r: *Row = NAMES[rows.at + i];
        if ((r.kind.flags & section.WRITE) == (seg.some & section.WRITE)) { ret opt[*section.Kind].some{r.kind}; }
        i = i + 1;
    }
    ret opt[*section.Kind].none{};
}

# the kind of a section named `name` whose type word is `type` and whose
# neutral flags are `flags`, as the reader classifies a header: the type's
# own kind when it names one, zero fill thread-local under the TLS flag,
# then the name's row, then the flags, a section no image loads being
# debugging information. a word no type is spelled by is refused naming it
pub fun kind_for(name: Bytes, type: str, flags: section.Flags) res[*section.Kind, Fail] {
    val t: opt[*Type] = type_by_word(type);
    if (sel t.none) { ret res[*section.Kind, Fail].err{fail.about(fail.unsupported("Mach-O has no section type of this word"), type)}; }
    ret classify(name, t.some, flags);
}

# `kind_for` over the type row the reader found
pub fun classify(name: Bytes, t: *Type, flags: section.Flags) res[*section.Kind, Fail] {
    if (sel t.reads.kind) {
        if (t.reads.kind == ?section.BSS && (flags & section.TLS) != 0) { ret res[*section.Kind, Fail].ok{?section.TLS_BSS}; }
        ret res[*section.Kind, Fail].ok{t.reads.kind};
    }
    val by_name: opt[*section.Kind] = kind_of(name);
    if (sel by_name.some)             { ret res[*section.Kind, Fail].ok{by_name.some}; }
    if ((flags & section.ALLOC) == 0) { ret res[*section.Kind, Fail].ok{?section.DEBUG_INFO}; }
    if ((flags & section.EXEC) != 0)  { ret res[*section.Kind, Fail].ok{?section.TEXT}; }
    if ((flags & section.WRITE) != 0) { ret res[*section.Kind, Fail].ok{?section.DATA}; }
    ret res[*section.Kind, Fail].ok{?section.RODATA};
}

# how Mach-O names sections, for the registration
pub val NAMING: Naming = Naming{kind_of: kind_of, kind_for: kind_for, name_of: name_of};

# refuse an object whose nameless sections Mach-O cannot write: one of a kind
# with no nameless name, or two of one kind, which would take one name. every
# nameless section kept has a distinct row, so at most a row's worth are
# compared
pub fun nameless(o: *Object) err[Fail] {
    var seen: [KIND_COUNT]*section.Kind;
    var held: usize = 0;
    var i:    usize = 0;
    for (i < table.count[object.Section](?o.sections)) {
        val s: *object.Section = object.section_at(o, table.nth[object.Section](i));
        i = i + 1;
        if (sel s.name.some) { cnt; }
        val name: res[str, Fail] = name_of(s.kind);
        if (sel name.err) { ret err[Fail].err{fail.in_indexed(name.err, "section", (i - 1)::u64)}; }
        var j: usize = 0;
        for (j < held) {
            if (seen[j] == s.kind) {
                ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("Mach-O holds one section of a name, so it cannot write two nameless sections of one kind"), s.kind.name), "section", (i - 1)::u64)};
            }
            j = j + 1;
        }
        seen[held] = s.kind;
        held       = held + 1;
    }
    ret err[Fail].ok{};
}

test naming__every_kind_has_one_row_or_is_refused {
    var rows: [KIND_COUNT]*Row;
    var n:    usize = 0;
    var i:    usize = 0;
    for (i < ROW_COUNT) {
        if (!ROWS[i].alias) {
            rows[n] = ROWS[i];
            n       = n + 1;
        }
        i = i + 1;
    }
    if (n != KIND_COUNT) { ret 1; }
    val built: err[Fail] = index.verify[Row](?KINDS[0], KIND_COUNT, ?rows[0], KIND_COUNT, order);
    if (sel built.err) { ret 1; }
    var kinds: [KIND_COUNT + REFUSED_COUNT]*section.Kind;
    i = 0;
    for (i < KIND_COUNT) {
        kinds[i] = KINDS[i].kind;
        i        = i + 1;
    }
    var j: usize = 0;
    for (j < REFUSED_COUNT) {
        kinds[KIND_COUNT + j] = REFUSED[j];
        val refused: res[str, Fail] = name_of(REFUSED[j]);
        if (!sel refused.err)                   { ret 3; }
        if (!sel refused.err.cause.unsupported) { ret 3; }
        j = j + 1;
    }
    if (!section.once_each(?kinds[0], KIND_COUNT + REFUSED_COUNT)) { ret 2; }
    # the named rows ascend by section name, and a row no nameless section is
    # written as refuses one
    var k: usize = 0;
    for (k < NAME_COUNT) {
        if (spelling(NAMES[k]) == nil)                                            { ret 4; }
        if (k > 0 && str_compare(spelling(NAMES[k - 1]), spelling(NAMES[k])) > 0) { ret 4; }
        k = k + 1;
    }
    val records: res[str, Fail] = name_of(?section.UNWIND_RECORDS);
    val debug:   res[str, Fail] = name_of(?section.DEBUG_INFO);
    if (!sel records.err || !sel debug.err) { ret 5; }
    # every type word spells one type, and a header is classified by its type
    # word, then its name, then its flags
    var w: usize = 0;
    for (w < TYPE_COUNT) {
        val back: opt[*Type] = type_by_word(TYPES[w].word);
        if (sel back.none)          { ret 6; }
        if (back.some != ?TYPES[w]) { ret 6; }
        val code: opt[*Type] = type_of(TYPES[w].type.value::u32);
        if (sel code.none)          { ret 6; }
        if (code.some != ?TYPES[w]) { ret 6; }
        w = w + 1;
    }
    ret 0;
}

fun kind_is(name: str, type: str, flags: section.Flags, k: *section.Kind) bool {
    val got: res[*section.Kind, Fail] = kind_for(Bytes{data: name::*u8, len: str_len(name)}, type, flags);
    if (k == nil) { ret sel got.err; }
    ret sel got.ok && got.ok == k;
}

fun names_kind(name: str, k: *section.Kind) bool {
    val got: opt[*section.Kind] = kind_of(Bytes{data: name::*u8, len: str_len(name)});
    if (k == nil) { ret sel got.none; }
    ret sel got.some && got.some == k;
}

test naming__a_header_takes_its_kind_from_its_type_name_and_flags {
    val aw: section.Flags = section.ALLOC | section.WRITE;
    if (!names_kind("__TEXT,__const", ?section.RODATA) || !names_kind("__DATA,__const", ?section.RELRO_DATA))                                          { ret 1; }
    if (!names_kind("__DATA_CONST,__const", ?section.RELRO_DATA) || !names_kind("__DATA,__common", ?section.BSS))                                      { ret 1; }
    if (!names_kind("__LD,__compact_unwind", ?section.UNWIND_RECORDS) || !names_kind("__FOO,__const", nil))                                            { ret 1; }
    if (!names_kind("__text", nil) || !names_kind("__TEXT,__text.x", nil))                                                                             { ret 1; }
    if (!kind_is("__DATA,__common", "zerofill", aw, ?section.BSS) || !kind_is("__DATA,__x", "zerofill", aw | section.TLS, ?section.TLS_BSS))           { ret 2; }
    if (!kind_is("__TEXT,__cstring", "cstring_literals", section.ALLOC, ?section.RODATA))                                                              { ret 2; }
    if (!kind_is("__DATA,__thread_vars", "thread_local_variables", aw, ?section.DATA))                                                                 { ret 2; }
    if (!kind_is("__DATA,__const", "regular", 0, ?section.RELRO_DATA) || !kind_is("__DATA,__llvm_addrsig", "regular", aw, ?section.ADDRSIG_TABLE))     { ret 3; }
    if (!kind_is("__DWARF,__debug_info", "regular", 0, ?section.DEBUG_INFO) || !kind_is("__TEXT,__misc", "regular", section.ALLOC, ?section.RODATA))   { ret 3; }
    if (!kind_is("__TEXT,__stubs", "regular", section.ALLOC | section.EXEC, ?section.TEXT) || !kind_is("__DATA,__misc", "regular", aw, ?section.DATA)) { ret 3; }
    if (!kind_is("__TEXT,__eh_frame", "coalesced", section.ALLOC, ?section.UNWIND_INFO) || !kind_is("__TEXT,__misc", "bogus", 0, nil))                 { ret 4; }
    val merged: *Constant = type_for(?RODATA_ROW, section.ALLOC | section.MERGE, 8);
    val plain:  *Constant = type_for(?RODATA_ROW, section.ALLOC, 8);
    if (merged != ?tables.S_8BYTE_LITERALS || plain != ?tables.S_REGULAR) { ret 5; }
    ret 0;
}

test naming__two_nameless_sections_of_one_kind_are_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val x: res[*Arch, Fail] = list.by_name("x86_64");
    if (sel x.err) { ret 1; }
    var o: Object = object.make(T.allocator_of(?t), x.ok);

    val data: res[Id[object.Section], Fail] = object.add_section(?o, object.Section{kind: ?section.DATA, flags: section.DATA.flags, align: 8, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel data.err) { ret 1; }
    val bss: res[Id[object.Section], Fail] = object.add_section(?o, object.Section{kind: ?section.BSS, flags: section.BSS.flags, align: 8, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel bss.err) { ret 1; }
    val one: err[Fail] = nameless(?o);
    if (sel one.err) { ret 2; }
    val again: res[Id[object.Section], Fail] = object.add_section(?o, object.Section{kind: ?section.DATA, flags: section.DATA.flags, align: 8, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel again.err) { ret 1; }
    val two: err[Fail] = nameless(?o);
    if (!sel two.err)                   { ret 3; }
    if (!sel two.err.cause.unsupported) { ret 3; }

    val rel: err[Fail] = object.release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    ret 0;
}
