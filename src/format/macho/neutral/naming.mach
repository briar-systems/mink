# the Mach-O section each neutral section kind is written as
#
# one row per kind Mach-O can name, and per element size of a kind keyed by
# one, looked up by the kind's name and that size, stating the segment and
# section a section that states only its key takes, spelled segment,section as
# the neutral model names a Mach-O section, with its type and attributes.
# Mach-O has no table of functions run before every initializer, its
# debugging sections say by name which table they hold, and it has no notes or
# metadata, so those kinds have no row and a nameless section of one is
# refused. merged strings of 1 byte and constants of 4, 8 and 16 bytes take
# the literal section types, and strings of 2 bytes __ustring, which ld64
# merges by its name. Mach-O has no merging form for the other sizes, so the
# borrowed rows give them plain read-only data. a thin object holds one
# section of a name, so two nameless sections that take one name are refused
# too.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.catalog.arch.Arch;
use mink.catalog.arch.list;
use mink.format.contract;
use mink.format.contract.Naming;
use mink.format.contract.Borrowed;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;
use mink.model.object;
use mink.model.object.Object;
use mink.model.section;

# kind:       the neutral kind
# entsize:    the element size of a keyed kind's row, zero for another kind
# name:       the segment and section a section of the key that states none
#             takes
# type:       its section type
# attributes: its section attributes
pub rec Row {
    kind:       *section.Kind;
    entsize:    u64;
    name:       str;
    type:       *Constant;
    attributes: u64;
}


val CODE:   u64 = tables.S_ATTR_PURE_INSTRUCTIONS.value | tables.S_ATTR_SOME_INSTRUCTIONS.value;
val FRAMES: u64 = tables.S_ATTR_NO_TOC.value | tables.S_ATTR_STRIP_STATIC_SYMS.value | tables.S_ATTR_LIVE_SUPPORT.value;

val TEXT_ROW:       Row = Row{kind: ?section.TEXT, name: "__TEXT,__text", type: ?tables.S_REGULAR, attributes: CODE};
val RODATA_ROW:     Row = Row{kind: ?section.RODATA, name: "__TEXT,__const", type: ?tables.S_REGULAR, attributes: 0};
val DATA_ROW:       Row = Row{kind: ?section.DATA, name: "__DATA,__data", type: ?tables.S_REGULAR, attributes: 0};
val RELRO_ROW:      Row = Row{kind: ?section.RELRO_DATA, name: "__DATA,__const", type: ?tables.S_REGULAR, attributes: 0};
val BSS_ROW:        Row = Row{kind: ?section.BSS, name: "__DATA,__bss", type: ?tables.S_ZEROFILL, attributes: 0};
val TLS_DATA_ROW:   Row = Row{kind: ?section.TLS_DATA, name: "__DATA,__thread_data", type: ?tables.S_THREAD_LOCAL_REGULAR, attributes: 0};
val TLS_BSS_ROW:    Row = Row{kind: ?section.TLS_BSS, name: "__DATA,__thread_bss", type: ?tables.S_THREAD_LOCAL_ZEROFILL, attributes: 0};
val INIT_ARRAY_ROW: Row = Row{kind: ?section.INIT_ARRAY, name: "__DATA,__mod_init_func", type: ?tables.S_MOD_INIT_FUNC_POINTERS, attributes: 0};
val FINI_ARRAY_ROW: Row = Row{kind: ?section.FINI_ARRAY, name: "__DATA,__mod_term_func", type: ?tables.S_MOD_TERM_FUNC_POINTERS, attributes: 0};
val UNWIND_ROW:     Row = Row{kind: ?section.UNWIND_INFO, name: "__TEXT,__eh_frame", type: ?tables.S_COALESCED, attributes: FRAMES};
val CSTRING_ROW:    Row = Row{kind: ?section.MERGED_STRINGS, entsize: 1, name: "__TEXT,__cstring", type: ?tables.S_CSTRING_LITERALS, attributes: 0};
val USTRING_ROW:    Row = Row{kind: ?section.MERGED_STRINGS, entsize: 2, name: "__TEXT,__ustring", type: ?tables.S_REGULAR, attributes: 0};
val LITERAL4_ROW:   Row = Row{kind: ?section.MERGED_CONSTANTS, entsize: 4, name: "__TEXT,__literal4", type: ?tables.S_4BYTE_LITERALS, attributes: 0};
val LITERAL8_ROW:   Row = Row{kind: ?section.MERGED_CONSTANTS, entsize: 8, name: "__TEXT,__literal8", type: ?tables.S_8BYTE_LITERALS, attributes: 0};
val LITERAL16_ROW:  Row = Row{kind: ?section.MERGED_CONSTANTS, entsize: 16, name: "__TEXT,__literal16", type: ?tables.S_16BYTE_LITERALS, attributes: 0};

val ROW_COUNT: usize           = 15;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{
    ?TEXT_ROW, ?RODATA_ROW, ?DATA_ROW, ?RELRO_ROW, ?BSS_ROW, ?TLS_DATA_ROW, ?TLS_BSS_ROW,
    ?INIT_ARRAY_ROW, ?FINI_ARRAY_ROW, ?UNWIND_ROW, ?CSTRING_ROW, ?USTRING_ROW, ?LITERAL4_ROW,
    ?LITERAL8_ROW, ?LITERAL16_ROW,
};

# the rows ascending by kind name, then by element size
val KINDS: [ROW_COUNT]*Row = [ROW_COUNT]*Row{
    ?BSS_ROW, ?DATA_ROW, ?FINI_ARRAY_ROW, ?INIT_ARRAY_ROW, ?LITERAL4_ROW, ?LITERAL8_ROW,
    ?LITERAL16_ROW, ?CSTRING_ROW, ?USTRING_ROW, ?RELRO_ROW, ?RODATA_ROW, ?TLS_BSS_ROW,
    ?TLS_DATA_ROW, ?TEXT_ROW, ?UNWIND_ROW,
};

# the rows ascending by name, for the convention that a section named so
# takes the row's key, as the LLVM assembler gives __cstring and the literal
# sections their types by name alone
val NAME_COUNT: usize            = 15;
val NAMES:      [NAME_COUNT]*Row = [NAME_COUNT]*Row{
    ?BSS_ROW, ?RELRO_ROW, ?DATA_ROW, ?INIT_ARRAY_ROW, ?FINI_ARRAY_ROW, ?TLS_BSS_ROW, ?TLS_DATA_ROW,
    ?RODATA_ROW, ?CSTRING_ROW, ?UNWIND_ROW, ?LITERAL16_ROW, ?LITERAL4_ROW, ?LITERAL8_ROW, ?TEXT_ROW,
    ?USTRING_ROW,
};

# clang writes a read-only global Mach-O has no literal section for to
# __TEXT,__const, which no link merges
val PLAIN: str = "clang 23, whose Mach-O lowering writes 4-byte strings and 32-byte constants to __TEXT,__const";

# the keys Mach-O merges in no section, each written as plain read-only data,
# ascending by kind name, then by element size
val BORROWED_COUNT: usize                     = 2;
val BORROWED:       [BORROWED_COUNT]Borrowed[Row] = [BORROWED_COUNT]Borrowed[Row]{
    Borrowed[Row]{kind: ?section.MERGED_CONSTANTS, entsize: 32, as: ?RODATA_ROW, source: PLAIN},
    Borrowed[Row]{kind: ?section.MERGED_STRINGS, entsize: 4, as: ?RODATA_ROW, source: PLAIN},
};

# the keys Mach-O has no row for
val REFUSED_COUNT: usize                       = 9;
val REFUSED:       [REFUSED_COUNT]section.Key = [REFUSED_COUNT]section.Key{
    section.Key{kind: ?section.PREINIT_ARRAY}, section.Key{kind: ?section.NOTE_INFO}, section.Key{kind: ?section.DEBUG_INFO},
    section.Key{kind: ?section.METADATA}, section.Key{kind: ?section.ADDRSIG_TABLE}, section.Key{kind: ?section.COMMENT_STRINGS},
    section.Key{kind: ?section.STACK_NOTE}, section.Key{kind: ?section.UNWIND_RECORDS}, section.Key{kind: ?section.LINK_WARNING},
};

fun order(a: **Row, b: **Row) i64 {
    ret section.order(section.Key{kind: a[0].kind, entsize: a[0].entsize}, section.Key{kind: b[0].kind, entsize: b[0].entsize});
}

# the row a section of key `k` is written by: its own, or for a key Mach-O
# does not merge, the row its borrowed row names
pub fun row_of(k: section.Key) res[*Row, Fail] {
    var probe: Row       = Row{kind: k.kind, entsize: k.entsize};
    val row:   opt[*Row] = index.find[Row](?KINDS[0], ROW_COUNT, ?probe, order);
    if (sel row.some) { ret res[*Row, Fail].ok{row.some}; }
    val plain: opt[*Borrowed[Row]] = contract.borrowed_of[Row](?BORROWED[0], BORROWED_COUNT, k);
    if (sel plain.none) { ret res[*Row, Fail].err{fail.valued(fail.about(fail.unsupported("Mach-O has no section for this kind and element size"), k.kind.name), k.entsize::i128)}; }
    ret res[*Row, Fail].ok{plain.some.as};
}

# the name a section of key `k` that states none is written with
pub fun name_of(k: section.Key) res[str, Fail] {
    val row: res[*Row, Fail] = row_of(k);
    if (sel row.err) { ret res[str, Fail].err{row.err}; }
    ret res[str, Fail].ok{row.ok.name};
}

fun spelling(r: *Row) str {
    ret r.name;
}

# the key a section named `name` takes by the convention
pub fun kind_of(name: Bytes) opt[section.Key] {
    val r: opt[*Row] = contract.spelled[Row](?NAMES[0], NAME_COUNT, name, 0, spelling);
    if (sel r.none) { ret opt[section.Key].none{}; }
    ret opt[section.Key].some{section.Key{kind: r.some.kind, entsize: r.some.entsize}};
}

# the key of a section named `name`, as a naming row spells the name. Mach-O
# has no reader that classifies a section by its header, so `type`, its
# section type word, `flags` and `entsize` are not read, the name giving the
# element size, and a name no row spells is refused
pub fun kind_for(name: Bytes, type: str, flags: section.Flags, entsize: u64) res[section.Key, Fail] {
    val k: opt[section.Key] = kind_of(name);
    if (sel k.none) { ret res[section.Key, Fail].err{fail.unsupported("Mach-O classifies no section by its header, and no naming row spells the name")}; }
    ret res[section.Key, Fail].ok{k.some};
}

# how Mach-O names sections, for the registration
pub val NAMING: Naming = Naming{kind_of: kind_of, kind_for: kind_for, name_of: name_of};

# refuse an object whose nameless sections Mach-O cannot write: one of a key
# with no row, or two whose keys take one row, which would take one name.
# every nameless section kept has a distinct row, so at most a row's worth are
# compared
pub fun nameless(o: *Object) err[Fail] {
    var seen: [ROW_COUNT]*Row;
    var held: usize = 0;
    var i:    usize = 0;
    for (i < table.count[object.Section](?o.sections)) {
        val s: *object.Section = object.section_at(o, table.nth[object.Section](i));
        i = i + 1;
        if (sel s.name.some) { cnt; }
        val row: res[*Row, Fail] = row_of(section.key_of(s.kind, s.entsize));
        if (sel row.err) { ret err[Fail].err{fail.in_indexed(row.err, "section", (i - 1)::u64)}; }
        var j: usize = 0;
        for (j < held) {
            if (seen[j] == row.ok) {
                ret err[Fail].err{fail.in_indexed(fail.about(fail.unsupported("Mach-O holds one section of a name, so it cannot write two nameless sections that take one name"), s.kind.name), "section", (i - 1)::u64)};
            }
            j = j + 1;
        }
        seen[held] = row.ok;
        held       = held + 1;
    }
    ret err[Fail].ok{};
}

test naming__every_key_has_one_row_or_is_refused {
    val rows:  [ROW_COUNT]*Row = ROWS;
    val built: err[Fail]       = index.verify[Row](?KINDS[0], ROW_COUNT, ?rows[0], ROW_COUNT, order);
    if (sel built.err) { ret 1; }
    var keys: [ROW_COUNT + BORROWED_COUNT + REFUSED_COUNT]section.Key;
    var i:    usize = 0;
    for (i < ROW_COUNT) {
        keys[i] = section.Key{kind: ROWS[i].kind, entsize: ROWS[i].entsize};
        i       = i + 1;
    }
    # a borrowed key is plain read-only data, and reads back as it
    if (!contract.borrowed_sound[Row](?BORROWED[0], BORROWED_COUNT)) { ret 5; }
    var u: usize = 0;
    for (u < BORROWED_COUNT) {
        keys[ROW_COUNT + u] = contract.borrowed_key[Row](?BORROWED[u]);
        val named: res[str, Fail] = name_of(keys[ROW_COUNT + u]);
        if (sel named.err) { ret 5; }
        val back: opt[section.Key] = kind_of(Bytes{data: named.ok::*u8, len: str_len(named.ok)});
        if (sel back.none)                     { ret 5; }
        if (back.some.kind != ?section.RODATA) { ret 5; }
        u = u + 1;
    }
    var j: usize = 0;
    for (j < REFUSED_COUNT) {
        keys[ROW_COUNT + BORROWED_COUNT + j] = REFUSED[j];
        val refused: res[str, Fail] = name_of(REFUSED[j]);
        if (!sel refused.err)                   { ret 3; }
        if (!sel refused.err.cause.unsupported) { ret 3; }
        j = j + 1;
    }
    if (!section.once_each(?keys[0], ROW_COUNT + BORROWED_COUNT + REFUSED_COUNT)) { ret 2; }
    # the spelled rows ascend strictly, so each spelling has one kind
    var n: usize = 0;
    for (n < NAME_COUNT) {
        if (spelling(NAMES[n]) == nil)                                             { ret 4; }
        if (n > 0 && str_compare(spelling(NAMES[n - 1]), spelling(NAMES[n])) >= 0) { ret 4; }
        n = n + 1;
    }
    ret 0;
}

test naming__two_nameless_sections_of_one_kind_are_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val x: res[*Arch, Fail] = list.by_name("x86_64");
    if (sel x.err) { ret 1; }
    var o: Object = object.make(T.allocator_of(?t), x.ok);

    val data: res[Id[object.Section], Fail] = object.add_section(?o, object.Section{kind: ?section.DATA, flags: section.DATA.flags, align: 8, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel data.err) { ret 1; }
    val k:     *section.Kind                 = ?section.MERGED_STRINGS;
    val wide:  res[Id[object.Section], Fail] = object.add_section(?o, object.Section{kind: k, flags: k.flags, align: 4, entsize: 4, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel wide.err) { ret 1; }
    val bss: res[Id[object.Section], Fail] = object.add_section(?o, object.Section{kind: ?section.BSS, flags: section.BSS.flags, align: 8, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel bss.err) { ret 1; }
    val one: err[Fail] = nameless(?o);
    if (sel one.err) { ret 2; }
    val again: res[Id[object.Section], Fail] = object.add_section(?o, object.Section{kind: ?section.DATA, flags: section.DATA.flags, align: 8, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel again.err) { ret 1; }
    val two: err[Fail] = nameless(?o);
    if (!sel two.err)                   { ret 3; }
    if (!sel two.err.cause.unsupported) { ret 3; }
    # plain read-only data and the strings Mach-O writes as it take one name
    var plain: Object = object.make(T.allocator_of(?t), x.ok);
    val ro:    res[Id[object.Section], Fail] = object.add_section(?plain, object.Section{kind: ?section.RODATA, flags: section.RODATA.flags, align: 8, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel ro.err) { ret 1; }
    val alone: err[Fail] = nameless(?plain);
    if (sel alone.err) { ret 4; }
    val also: res[Id[object.Section], Fail] = object.add_section(?plain, object.Section{kind: k, flags: k.flags, align: 4, entsize: 4, contents: object.Contents.zero{8}, disposition: ?section.WHOLE});
    if (sel also.err) { ret 1; }
    val shared: err[Fail] = nameless(?plain);
    if (!sel shared.err) { ret 4; }
    val rel_plain: err[Fail] = object.release(?plain);
    if (sel rel_plain.err) { ret 1; }

    val rel: err[Fail] = object.release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    ret 0;
}
