# where a Mach-O object holds the mink note
#
# the note is a section `__MINK,__ct` of type regular with S_ATTR_DEBUG, so
# no image loads it and a linker that knows nothing of it drops it as it
# drops debugging sections. its bytes are the payload lower.mark encodes,
# nothing ahead of them, its fields the architecture's address width in the
# file's byte order and relocated through the section's relocation records.
# the section is no neutral section: from_neutral lowers the object's
# constant-time ranges into it and to_neutral decodes them from it. a file
# without one carries no constant-time code

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader.Order;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.lower.lowered;
use mink.lower.lowered.Added;
use mink.lower.lowered.Lowered;
use mink.lower.mark;
use mink.model.object.CtRange;
use mink.model.object.Object;
use mink.model.section;

# the segment and section that hold the note, and the name a neutral section
# spells them as
pub val SEGMENT: str = "__MINK";
pub val SECTION: str = "__ct";
pub val NAME:    str = "__MINK,__ct";

# whether a section header's sixteen byte segment and section names are the
# note's
pub fun holds(segname: *u8, sectname: *u8) bool {
    ret same16(segname, SEGMENT) && same16(sectname, SECTION);
}

# whether the sixteen byte field `p` spells `want`, padded with NULs
fun same16(p: *u8, want: str) bool {
    val n: usize = str_len(want);
    if (n > 16) { ret false; }
    var i: usize = 0;
    for (i < 16) {
        var w: u8 = 0;
        if (i < n)     { w = want[i]; }
        if (p[i] != w) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the width of the note's fields in a file for the object's architecture,
# refused for one with no address width
pub fun width_of(o: *Object) res[u8, Fail] {
    val w: opt[u8] = arch.pointer_bytes(o.target.arch);
    if (sel w.none) { ret res[u8, Fail].err{fail.about(fail.unsupported("the architecture has no address width for the mink note's fields"), o.target.arch.name)}; }
    ret res[u8, Fail].ok{w.some};
}

# add to `low` the note section of `o`'s constant-time ranges, its bytes in
# the byte order `order`, adding nothing for an object with none. a refusal
# leaves `low` as it was
pub fun lower(o: *Object, order: Order, low: *Lowered) err[Fail] {
    if (table.count[CtRange](?o.ct) == 0) { ret err[Fail].ok{}; }
    val width: res[u8, Fail] = width_of(o);
    if (sel width.err) { ret err[Fail].err{width.err}; }
    val m:   lowered.Mark = lowered.mark(low);
    var out: Sink         = sink.make(o.a, order);
    val w:   err[Fail]    = mark.write(o, width.ok, ?out, low, lowered.next_section(low), false);
    if (sel w.err) {
        val dropped: err[Fail] = sink.release(?out);
        val back:    err[Fail] = lowered.rollback(low, m);
        ret w;
    }
    val added: res[Id[Added], Fail] = lowered.add_section(low, Added{name: NAME, kind: ?section.DEBUG_INFO, flags: 0, align: width.ok::u64, disposition: ?section.ROOT, bytes: out});
    if (sel added.err) {
        val back: err[Fail] = lowered.rollback(low, m);
        ret err[Fail].err{added.err};
    }
    ret err[Fail].ok{};
}
