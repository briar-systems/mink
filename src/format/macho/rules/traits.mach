# the Mach-O encoding of trait axes
#
# one row per encoding Mach-O has of a trait axis, keyed by the axis row of the
# trait catalog, giving the cpusubtype capability bits that hold its value. a
# flag is set when its bits are, and a number is its bits shifted down to the
# lowest bit of the mask. the reader states every row of its architecture's
# axes and clears their bits, so a bit a row maps is never also kept raw, and
# the writer encodes an object's traits through the same rows. Mach-O holds
# traits in its header alone, never in a section, and an assembler names none.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Table;
use mink.catalog.arch.Arch;
use mink.catalog.arch.aarch64;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.format.contract;
use mink.format.contract.Encoding;
use mink.format.contract.Rows;
use mink.format.contract.Tag;
use mink.format.contract.TraitCodec;
use mink.format.contract.Written;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;
use mink.model.object;
use mink.model.object.Object;

# encoding: the trait axis and whether an object must state it
# mask:     the capability bits that hold its value
pub rec Row {
    encoding: Encoding;
    mask:     *Constant;
}

# CPU_SUBTYPE_ARM64E_PTRAUTH_MASK in llvm/BinaryFormat/MachO.h at LLVM 23.1.1
val PTRAUTH_ABI_VERSION_ROW: Row = Row{encoding: Encoding{axis: ?aarch64.AARCH64_PTRAUTH_ABI_VERSION, required: false}, mask: ?tables.CPU_SUBTYPE_ARM64_PTR_AUTH_MASK};
# CPU_SUBTYPE_ARM64E_KERNEL_PTRAUTH_ABI_MASK in llvm/BinaryFormat/MachO.h at LLVM 23.1.1
val PTRAUTH_KERNEL_ABI_ROW: Row = Row{encoding: Encoding{axis: ?aarch64.AARCH64_PTRAUTH_KERNEL_ABI, required: false}, mask: ?tables.CPU_SUBTYPE_ARM64E_KERNEL_PTRAUTH_ABI_MASK};
# CPU_SUBTYPE_ARM64E_VERSIONED_PTRAUTH_ABI_MASK in llvm/BinaryFormat/MachO.h at LLVM 23.1.1
val PTRAUTH_VERSIONED_ROW: Row = Row{encoding: Encoding{axis: ?aarch64.AARCH64_PTRAUTH_VERSIONED, required: false}, mask: ?tables.CPU_SUBTYPE_PTRAUTH_ABI};

# the rows and their encodings, both ascending by axis name, so the
# encodings' index is the row's
pub val ROW_COUNT: usize                = 3;
val     ROWS:      [ROW_COUNT]*Row      = [ROW_COUNT]*Row{?PTRAUTH_ABI_VERSION_ROW, ?PTRAUTH_KERNEL_ABI_ROW, ?PTRAUTH_VERSIONED_ROW};
pub val ENCODINGS: [ROW_COUNT]*Encoding = [ROW_COUNT]*Encoding{?PTRAUTH_ABI_VERSION_ROW.encoding, ?PTRAUTH_KERNEL_ABI_ROW.encoding, ?PTRAUTH_VERSIONED_ROW.encoding};

pub val CODEC: TraitCodec = TraitCodec{encodings: ?ENCODINGS[0], count: ROW_COUNT, attribute: attribute_axis, setting: setting, holds: holds_traits, raise: raise};

fun attribute_axis(a: *Arch, t: Tag) opt[*Axis] {
    ret opt[*Axis].none{};
}

fun setting(x: *Axis, v: Written) res[Setting, Fail] {
    ret res[Setting, Fail].err{fail.about(fail.unsupported("no assembler attribute states a Mach-O trait axis"), x.name)};
}

fun holds_traits(a: *Arch, name: Bytes) bool {
    ret false;
}

fun raise(a: *Arch, name: Bytes, data: Bytes, out: *Table[Trait]) err[Fail] {
    ret err[Fail].err{fail.about(fail.unsupported("Mach-O holds the traits of an object in its header, never in a section"), a.name)};
}

# the row of `x`, none for an axis Mach-O does not encode
fun row_of(x: *Axis) opt[*Row] {
    val rows: Rows = contract.encodings_of(?CODEC, x);
    if (rows.count == 0) { ret opt[*Row].none{}; }
    ret opt[*Row].some{ROWS[rows.at]};
}

# the lowest bit of the row's mask
fun shift(e: *Row) u64 {
    var n: u64 = 0;
    for (n < 31 && ((e.mask.value >> n) & 1) == 0) {
        n = n + 1;
    }
    ret n;
}

# the capability bits the rows of the axes of `a` map
pub fun mapped(a: *Arch) u32 {
    var bits: u32   = 0;
    var i:    usize = 0;
    for (i < a.axis_count) {
        val e: opt[*Row] = row_of(a.axes[i]);
        i = i + 1;
        if (sel e.some) { bits = bits | e.some.mask.value::u32; }
    }
    ret bits;
}

# state on `o` what the capability bits `caps` hold on each axis of its
# architecture a row encodes, returning the bits no row maps
pub fun decode(o: *Object, caps: u32) res[u32, Fail] {
    val a: *Arch = o.target.arch;
    var i: usize = 0;
    for (i < a.axis_count) {
        val e: opt[*Row] = row_of(a.axes[i]);
        i = i + 1;
        if (sel e.none) { cnt; }
        val r:    *Row    = e.some;
        val bits: u64     = caps::u64 & r.mask.value;
        var s:    Setting = Setting.number{bits >> shift(r)};
        if (sel r.encoding.axis.value.flag) { s = Setting.flag{bits != 0}; }
        val st: err[Fail] = object.state(o, r.encoding.axis, s);
        if (sel st.err) { ret res[u32, Fail].err{st.err}; }
    }
    ret res[u32, Fail].ok{caps & ~mapped(a)};
}

# the capability bits that encode the traits `ts`, refused for a trait of an
# axis Mach-O does not encode and a value its bits cannot hold
pub fun encode(ts: *Table[Trait]) res[u32, Fail] {
    var bits: u64   = 0;
    var i:    usize = 0;
    for (i < table.count[Trait](ts)) {
        val t: *Trait    = table.at[Trait](ts, table.nth[Trait](i));
        val e: opt[*Row] = row_of(t.axis);
        i = i + 1;
        if (sel e.none) { ret res[u32, Fail].err{fail.about(fail.unsupported("Mach-O has no encoding for this trait axis"), t.axis.name)}; }
        val r: *Row = e.some;
        if (sel t.setting.flag) {
            if (t.setting.flag) { bits = bits | r.mask.value; }
        }
        or (sel t.setting.number) {
            val v: u64 = t.setting.number << shift(r);
            if ((v & ~r.mask.value) != 0 || (v >> shift(r)) != t.setting.number) {
                ret res[u32, Fail].err{fail.valued(fail.about(fail.overflow("the trait value is wider than its cpusubtype bits"), t.axis.name), t.setting.number::i128)};
            }
            bits = bits | v;
        }
    }
    ret res[u32, Fail].ok{bits::u32};
}
