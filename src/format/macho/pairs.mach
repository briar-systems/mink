# the (Mach-O, architecture) pairs: what Mach-O states for each architecture
# it names, which the Mach-O registration lists
#
# a record's row key composes its type, length and pcrel bit, as key.mach
# has it, and a record is written back from the key. a C symbol's name
# carries an underscore. no relocation names no target, so no pair writes
# one, and the thread pointer lies as no pair states, since a thread-local
# variable is reached through its descriptor rather than an offset.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail.Fail;
use mink.catalog.arch.Arch;
use mink.catalog.arch.aarch64;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.format.macho.reloc.arm64;
use mink.format.macho.reloc.key;
use mink.format.macho.reloc.x86_64;
use macho_templates: mink.format.macho.templates;
use mink.format.pair;
use mink.format.pair.Pair;
use mink.format.pair.Temporaries;
use mink.link.template;
use mink.link.thread.Thread;
use mink.reloc.row;

# the labels clang names for its own use, as ltmp0 marks the start of a
# section, which ld64 leaves out of an image
val DISCARDED: Temporaries = Temporaries{prefix: "l", discarded: true, source: "ld64, which leaves an input's assembler-local labels out of the image"};

pub val COUNT: usize = 3;

pub val PAIRS: [COUNT]Pair = [COUNT]Pair{
    Pair{arch: ?x86.X86_64, code: ?x86.X86_64_CODES[2], key_of: key.of, relocs: ?x86_64.SET, templates: opt[*template.Set].some{?macho_templates.X86_64}, prefix: "_", temporaries: opt[*Temporaries].some{?DISCARDED}, nameless: opt[u64].none{}, thread: opt[*Thread].none{}},
    Pair{arch: ?aarch64.AARCH64, code: ?aarch64.AARCH64_CODES[2], key_of: key.of, relocs: ?arm64.SET, templates: opt[*template.Set].some{?macho_templates.ARM64}, prefix: "_", temporaries: opt[*Temporaries].some{?DISCARDED}, nameless: opt[u64].none{}, thread: opt[*Thread].none{}},
    Pair{arch: ?aarch64.ARM64E, code: ?aarch64.ARM64E_CODES[0], key_of: key.of, relocs: ?arm64.SET_E, prefix: "_", temporaries: opt[*Temporaries].some{?DISCARDED}, nameless: opt[u64].none{}, thread: opt[*Thread].none{}},
};

# the records whose place-relative field counts from the start of its
# section rather than from its own place, as the assembler leaves a
# POINTER_TO_GOT distance: the field holds the addend less the field's
# offset in its section
rec Relative {
    arch:  *Arch;
    keys:  *u32;
    count: usize;
}

val ARM64_RELATIVE: [1]u32      = [1]u32{arm64.POINTER_TO_GOT_PC32};
val RELATIVE_COUNT: usize       = 2;
val RELATIVE:       [2]Relative = [2]Relative{
    Relative{arch: ?aarch64.AARCH64, keys: ?ARM64_RELATIVE[0], count: 1},
    Relative{arch: ?aarch64.ARM64E, keys: ?ARM64_RELATIVE[0], count: 1},
};

# whether the field of a record of `p` with the key `key` counts from the
# start of its section
pub fun counts_from_section(p: *Pair, key: u32) bool {
    var i: usize = 0;
    for (i < RELATIVE_COUNT) {
        if (RELATIVE[i].arch == p.arch) {
            var k: usize = 0;
            for (k < RELATIVE[i].count) {
                if (RELATIVE[i].keys[k] == key) { ret true; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret false;
}

# the pair of `a`
pub fun of(a: *Arch) res[*Pair, Fail] {
    ret pair.of(?format.MACHO, ?PAIRS[0], COUNT, a);
}

# an index of the relocation rows of every pair, for a test below the format
# registry, which owns the one index a process converts and links with. the
# index is released with `row.release`
#[testing]
pub fun index(a: *A.Allocator) res[row.Registry, Fail] {
    var sets: [COUNT]*row.Set;
    var i:    usize = 0;
    for (i < COUNT) {
        sets[i] = PAIRS[i].relocs;
        i       = i + 1;
    }
    ret row.make(a, ?sets[0], COUNT);
}

test pairs__every_pair_is_sound_and_found_by_its_row {
    var i: usize = 0;
    for (i < COUNT) {
        val p: *Pair = ?PAIRS[i];
        if (!pair.sound(p, ?format.MACHO)) { ret 1; }
        val got: res[*Pair, Fail] = of(p.arch);
        if (sel got.err) { ret 2; }
        if (got.ok != p) { ret 2; }
        val w: res[u64, Fail] = pair.write_nameless(p);
        if (!sel w.err)                   { ret 3; }
        if (!sel w.err.cause.unsupported) { ret 3; }
        i = i + 1;
    }
    val none: res[*Pair, Fail] = of(?x86.X86);
    if (!sel none.err)                   { ret 4; }
    if (!sel none.err.cause.unsupported) { ret 4; }
    ret 0;
}
