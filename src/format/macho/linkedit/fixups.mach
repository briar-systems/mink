# the chained fixups of LC_DYLD_CHAINED_FIXUPS
#
# the decoder reads the header, the starts in image, the starts in each
# segment, the imports and the symbol pool of the payload. the encoder writes
# them back at the offsets the entries state, zero between, so a payload dyld
# laid out comes back byte for byte. the pool is held as the bytes from its
# offset to the end of the payload, padding included, compressed or not.
#
# the chain walk reads the pointers a segment's page starts name through one
# table of pointer formats: a format says how wide a pointer is, how far a step
# of `next` reaches and where every field lies. both are pure functions over
# bytes and entries.

use std.collections.sort;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.encoding.binary;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader;
use mink.bytes.reader.Order;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.bytes.slot;
use mink.format.macho.model.model;
use mink.format.macho.model.model.Chained;
use mink.format.macho.model.model.Form;
use mink.format.macho.model.model.Import;
use mink.format.macho.model.model.ImportFormat;
use mink.format.macho.model.model.Layout;
use mink.format.macho.model.model.Pointer;
use mink.format.macho.model.model.PointerFormat;
use mink.format.macho.model.model.SegmentInfo;
use mink.format.macho.model.model.SegmentStarts;

# the width of the dyld_chained_fixups_header
pub val HEADER_SIZE: usize = 28;

# the width of a dyld_chained_starts_in_segment before its page starts
pub val SEGMENT_STARTS_SIZE: usize = 22;

fun at_here(f: Fail, r: *Reader) Fail {
    ret fail.at_offset(fail.in_file(f, r.file), reader.offset(r));
}

fun drop(c: *Chained, f: Fail) Fail {
    val dropped: err[Fail] = model.release_chained(c);
    ret f;
}

# the chained fixups the reader spans. `r` starts at the header
pub fun decode(a: *A.Allocator, r: *Reader) res[Chained, Fail] {
    var c:   Chained   = Chained{segments: table.make[SegmentInfo](a), imports: table.make[Import](a)};
    val ran: err[Fail] = run(?c, r);
    if (sel ran.err) { ret res[Chained, Fail].err{drop(?c, ran.err)}; }
    ret res[Chained, Fail].ok{c};
}

fun read_u32(r: *Reader, out: *u32) err[Fail] {
    val v: res[u32, Fail] = reader.u32(r);
    if (sel v.err) { ret err[Fail].err{v.err}; }
    @out = v.ok;
    ret err[Fail].ok{};
}

fun run(c: *Chained, r: *Reader) err[Fail] {
    val sk: res[usize, Fail] = reader.seek(r, 0);
    if (sel sk.err) { ret err[Fail].err{sk.err}; }
    val fields: [7]*u32 = [7]*u32{?c.fixups_version, ?c.starts_offset, ?c.imports_offset, ?c.symbols_offset, ?c.imports_count, ?c.imports_format, ?c.symbols_format};
    var i:      usize   = 0;
    for (i < 7) {
        val x: err[Fail] = read_u32(r, fields[i]);
        if (sel x.err) { ret x; }
        i = i + 1;
    }
    val starts: err[Fail] = run_starts(c, r);
    if (sel starts.err) { ret starts; }
    val imports: err[Fail] = run_imports(c, r);
    if (sel imports.err) { ret imports; }
    if (c.symbols_offset::usize > r.len) {
        ret err[Fail].err{fail.at_offset(fail.in_file(fail.truncated("symbol pool lies outside the payload"), r.file), c.symbols_offset::u64)};
    }
    c.symbols = Held.borrowed{Bytes{data: ?r.data[c.symbols_offset::usize], len: r.len - c.symbols_offset::usize}};
    ret err[Fail].ok{};
}

fun run_starts(c: *Chained, r: *Reader) err[Fail] {
    val sk: res[usize, Fail] = reader.seek(r, c.starts_offset::u64);
    if (sel sk.err) { ret err[Fail].err{sk.err}; }
    val count: res[u32, Fail] = reader.u32(r);
    if (sel count.err) { ret err[Fail].err{count.err}; }
    if (count.ok::usize > reader.remaining(r) / 4) {
        ret err[Fail].err{at_here(fail.truncated("segment starts offsets lie outside the payload"), r)};
    }
    c.seg_count = count.ok;
    val g: res[Id[SegmentInfo], Fail] = table.grow[SegmentInfo](?c.segments, count.ok::usize);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < count.ok::usize) {
        val off: res[u32, Fail] = reader.u32(r);
        if (sel off.err) { ret err[Fail].err{off.err}; }
        table.at[SegmentInfo](?c.segments, table.nth[SegmentInfo](i)).offset = off.ok;
        i                                                                    = i + 1;
    }
    i = 0;
    for (i < count.ok::usize) {
        val info: *SegmentInfo = table.at[SegmentInfo](?c.segments, table.nth[SegmentInfo](i));
        if (info.offset != 0) {
            val pos: res[u64, Fail] = checked.add(reader.here(r), c.starts_offset::u64, info.offset::u64);
            if (sel pos.err) { ret err[Fail].err{pos.err}; }
            val s: res[SegmentStarts, Fail] = decode_segment_starts(c.segments.a, r, pos.ok);
            if (sel s.err) { ret err[Fail].err{fail.in_indexed(s.err, "segment starts", i::u64)}; }
            info.starts = opt[SegmentStarts].some{s.ok};
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun decode_segment_starts(a: *A.Allocator, r: *Reader, pos: u64) res[SegmentStarts, Fail] {
    val sk: res[usize, Fail] = reader.seek(r, pos);
    if (sel sk.err) { ret res[SegmentStarts, Fail].err{sk.err}; }
    var s:    SegmentStarts;
    val size: res[u32, Fail] = reader.u32(r);
    if (sel size.err) { ret res[SegmentStarts, Fail].err{size.err}; }
    val page_size: res[u16, Fail] = reader.u16(r);
    if (sel page_size.err) { ret res[SegmentStarts, Fail].err{page_size.err}; }
    val format: res[u16, Fail] = reader.u16(r);
    if (sel format.err) { ret res[SegmentStarts, Fail].err{format.err}; }
    val offset: res[u64, Fail] = reader.u64(r);
    if (sel offset.err) { ret res[SegmentStarts, Fail].err{offset.err}; }
    val max: res[u32, Fail] = reader.u32(r);
    if (sel max.err) { ret res[SegmentStarts, Fail].err{max.err}; }
    val count: res[u16, Fail] = reader.u16(r);
    if (sel count.err) { ret res[SegmentStarts, Fail].err{count.err}; }
    s.size              = size.ok;
    s.page_size         = page_size.ok;
    s.pointer_format    = format.ok;
    s.segment_offset    = offset.ok;
    s.max_valid_pointer = max.ok;
    s.page_count        = count.ok;
    if (size.ok::usize < SEGMENT_STARTS_SIZE || ((size.ok::usize - SEGMENT_STARTS_SIZE) & 1) != 0) {
        ret res[SegmentStarts, Fail].err{at_here(fail.unsupported("segment starts size does not hold its page starts"), r)};
    }
    val n: usize = (size.ok::usize - SEGMENT_STARTS_SIZE) / 2;
    if (count.ok::usize > n) {
        ret res[SegmentStarts, Fail].err{at_here(fail.unsupported("segment starts size does not cover its page count"), r)};
    }
    if (n > reader.remaining(r) / 2) {
        ret res[SegmentStarts, Fail].err{at_here(fail.truncated("page starts lie outside the payload"), r)};
    }
    s.page_starts = table.make[u16](a);
    val g: res[Id[u16], Fail] = table.grow[u16](?s.page_starts, n);
    if (sel g.err) { ret res[SegmentStarts, Fail].err{g.err}; }
    var i: usize = 0;
    for (i < n) {
        val v: res[u16, Fail] = reader.u16(r);
        if (sel v.err) {
            val dropped: err[Fail] = table.release[u16](?s.page_starts);
            ret res[SegmentStarts, Fail].err{v.err};
        }
        val cell: *u16 = table.at[u16](?s.page_starts, table.nth[u16](i));
        @cell = v.ok;
        i     = i + 1;
    }
    ret res[SegmentStarts, Fail].ok{s};
}

fun run_imports(c: *Chained, r: *Reader) err[Fail] {
    val f: res[*ImportFormat, Fail] = model.import_format(c.imports_format);
    if (sel f.err) { ret err[Fail].err{f.err}; }
    val sk: res[usize, Fail] = reader.seek(r, c.imports_offset::u64);
    if (sel sk.err) { ret err[Fail].err{sk.err}; }
    val size: res[u64, Fail] = checked.mul(reader.here(r), c.imports_count::u64, f.ok.size::u64);
    if (sel size.err) { ret err[Fail].err{size.err}; }
    if (size.ok > reader.remaining(r)::u64) {
        ret err[Fail].err{at_here(fail.truncated("imports lie outside the payload"), r)};
    }
    val g: res[Id[Import], Fail] = table.grow[Import](?c.imports, c.imports_count::usize);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < c.imports_count::usize) {
        val rec: res[*u8, Fail] = reader.bytes(r, f.ok.size::u64);
        if (sel rec.err) { ret err[Fail].err{rec.err}; }
        val cell: *Import = table.at[Import](?c.imports, table.nth[Import](i));
        @cell = unpack_import(f.ok, rec.ok, r.order);
        i     = i + 1;
    }
    ret err[Fail].ok{};
}

# the import record at `p` unpacked through its format
fun unpack_import(f: *ImportFormat, p: *u8, order: Order) Import {
    val word: u64 = binary.get_uint(p, f.word::usize, order);
    ret Import{
        ordinal: model.bits(word, f.ordinal)::u32,
        weak:    model.bits(word, f.weak)::u8,
        name:    model.bits(word, f.name)::u32,
        addend:  slot.field(p, f.addend, order),
    };
}

# the record of an import packed through its format, or the field that does not fit
fun pack_import(f: *ImportFormat, i: *Import, p: *u8, order: Order) err[Fail] {
    if (!model.fits(i.ordinal::u64, f.ordinal) || !model.fits(i.weak::u64, f.weak) || !model.fits(i.name::u64, f.name)) {
        ret err[Fail].err{fail.malformed("import field does not fit its format")};
    }
    if (f.addend.width < 8 && i.addend >= (1::u64 << (f.addend.width::u64 * 8))) {
        ret err[Fail].err{fail.malformed("import addend does not fit its format")};
    }
    if (f.addend.width == 0 && i.addend != 0) {
        ret err[Fail].err{fail.malformed("import format has no addend")};
    }
    val word: u64 = (i.ordinal::u64 << f.ordinal.shift::u64) | (i.weak::u64 << f.weak.shift::u64) | (i.name::u64 << f.name.shift::u64);
    binary.put_uint(p, word, f.word::usize, order);
    slot.set_field(p, f.addend, order, i.addend);
    ret err[Fail].ok{};
}

# a region of the payload an encoder writes
# ---
# offset: where it lies
# kind:   which part it is, REGION_*
# index:  which segment or import it is
rec Region {
    offset: u64;
    kind:   u8;
    index:  u32;
}

val REGION_HEADER:  u8 = 0;
val REGION_STARTS:  u8 = 1;
val REGION_SEGMENT: u8 = 2;
val REGION_IMPORTS: u8 = 3;
val REGION_SYMBOLS: u8 = 4;

fun by_offset(a: *Region, b: *Region) i64 {
    if (a.offset < b.offset) { ret -1; }
    if (a.offset > b.offset) { ret 1; }
    ret 0;
}

fun push_region(t: *Table[Region], offset: u64, kind: u8, index: u32) err[Fail] {
    val p: res[Id[Region], Fail] = table.push[Region](t, Region{offset: offset, kind: kind, index: index});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the payload for `c` in `order`, each part at the offset it states and zeros
# between. `symbols` is the pool, read through `bytes`
pub fun encode(s: *Sink, a: *A.Allocator, c: *Chained, bytes: Bytes) err[Fail] {
    val f: res[*ImportFormat, Fail] = model.import_format(c.imports_format);
    if (sel f.err) { ret err[Fail].err{f.err}; }
    if (table.count[SegmentInfo](?c.segments) != c.seg_count::usize || table.count[Import](?c.imports) != c.imports_count::usize) {
        ret err[Fail].err{fail.malformed("chained fixups counts disagree with their tables")};
    }
    var regions: Table[Region] = table.make[Region](a);
    val planned: err[Fail]     = plan(?regions, c);
    if (sel planned.err) {
        val dropped: err[Fail] = table.release[Region](?regions);
        ret planned;
    }
    sort.sort_by[Region](table.items[Region](?regions), table.count[Region](?regions), by_offset);
    val start:  usize     = sink.len(s);
    var failed: err[Fail] = err[Fail].ok{};
    var i:      usize     = 0;
    for (i < table.count[Region](?regions) && !sel failed.err) {
        failed = write_at(s, start, c, f.ok, table.at[Region](?regions, table.nth[Region](i)), bytes);
        i      = i + 1;
    }
    val dropped: err[Fail] = table.release[Region](?regions);
    if (sel failed.err) { ret failed; }
    ret dropped;
}

fun write_at(s: *Sink, start: usize, c: *Chained, f: *ImportFormat, g: *Region, bytes: Bytes) err[Fail] {
    val have: u64 = (sink.len(s) - start)::u64;
    if (g.offset < have) { ret err[Fail].err{fail.malformed("chained fixups parts overlap")}; }
    val gap: err[Fail] = sink.zeros(s, (g.offset - have)::usize);
    if (sel gap.err) { ret gap; }
    ret write_region(s, c, f, g, bytes);
}

fun plan(regions: *Table[Region], c: *Chained) err[Fail] {
    val w1: err[Fail] = push_region(regions, 0, REGION_HEADER, 0);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = push_region(regions, c.starts_offset::u64, REGION_STARTS, 0);
    if (sel w2.err) { ret w2; }
    var i: usize = 0;
    for (i < table.count[SegmentInfo](?c.segments)) {
        val info: *SegmentInfo = table.at[SegmentInfo](?c.segments, table.nth[SegmentInfo](i));
        if (sel info.starts.some) {
            val w: err[Fail] = push_region(regions, c.starts_offset::u64 + info.offset::u64, REGION_SEGMENT, i::u32);
            if (sel w.err) { ret w; }
        }
        i = i + 1;
    }
    val w3: err[Fail] = push_region(regions, c.imports_offset::u64, REGION_IMPORTS, 0);
    if (sel w3.err) { ret w3; }
    ret push_region(regions, c.symbols_offset::u64, REGION_SYMBOLS, 0);
}

fun write_region(s: *Sink, c: *Chained, f: *ImportFormat, g: *Region, bytes: Bytes) err[Fail] {
    if (g.kind == REGION_HEADER) {
        val fields: [7]u32 = [7]u32{c.fixups_version, c.starts_offset, c.imports_offset, c.symbols_offset, c.imports_count, c.imports_format, c.symbols_format};
        var i:      usize  = 0;
        for (i < 7) {
            val w: err[Fail] = sink.u32(s, fields[i]);
            if (sel w.err) { ret w; }
            i = i + 1;
        }
        ret err[Fail].ok{};
    }
    if (g.kind == REGION_STARTS) {
        val head: err[Fail] = sink.u32(s, c.seg_count);
        if (sel head.err) { ret head; }
        var i: usize = 0;
        for (i < table.count[SegmentInfo](?c.segments)) {
            val w: err[Fail] = sink.u32(s, table.at[SegmentInfo](?c.segments, table.nth[SegmentInfo](i)).offset);
            if (sel w.err) { ret w; }
            i = i + 1;
        }
        ret err[Fail].ok{};
    }
    if (g.kind == REGION_SEGMENT) {
        val info: *SegmentInfo = table.at[SegmentInfo](?c.segments, table.nth[SegmentInfo](g.index::usize));
        if (sel info.starts.some) { ret write_segment_starts(s, ?info.starts.some); }
        ret err[Fail].err{fail.internal("segment starts vanished while encoding")};
    }
    if (g.kind == REGION_IMPORTS) {
        var rec: [16]u8;
        var i:   usize = 0;
        for (i < table.count[Import](?c.imports)) {
            var j: usize = 0;
            for (j < 16) {
                rec[j] = 0;
                j      = j + 1;
            }
            val p: err[Fail] = pack_import(f, table.at[Import](?c.imports, table.nth[Import](i)), ?rec[0], s.order);
            if (sel p.err) { ret p; }
            val w: err[Fail] = sink.bytes(s, ?rec[0], f.size::usize);
            if (sel w.err) { ret w; }
            i = i + 1;
        }
        ret err[Fail].ok{};
    }
    ret sink.bytes(s, bytes.data, bytes.len);
}

fun write_segment_starts(s: *Sink, st: *SegmentStarts) err[Fail] {
    if (table.count[u16](?st.page_starts) != ((st.size::usize - SEGMENT_STARTS_SIZE) / 2)) {
        ret err[Fail].err{fail.malformed("segment starts size disagrees with its page starts")};
    }
    val head: [3]err[Fail] = [3]err[Fail]{sink.u32(s, st.size), sink.u16(s, st.page_size), sink.u16(s, st.pointer_format)};
    val tail: [3]err[Fail] = [3]err[Fail]{sink.u64(s, st.segment_offset), sink.u32(s, st.max_valid_pointer), sink.u16(s, st.page_count)};
    var k:    usize        = 0;
    for (k < 3) {
        if (sel head[k].err) { ret head[k]; }
        if (sel tail[k].err) { ret tail[k]; }
        k = k + 1;
    }
    var i: usize = 0;
    for (i < table.count[u16](?st.page_starts)) {
        val w: err[Fail] = sink.u16(s, @table.at[u16](?st.page_starts, table.nth[u16](i)));
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun layout_of(f: *PointerFormat, form: *Form) *Layout {
    if (sel form.auth_bind)   { ret ?f.auth_bound; }
    if (sel form.auth_rebase) { ret ?f.auth_rebase; }
    if (sel form.bind)        { ret ?f.bound; }
    ret ?f.rebase;
}

# the bits the pointer form `form` of format `f` holds `addend` in, none
# where its addend field cannot hold it
pub fun pointer_addend(f: *PointerFormat, form: *Form, addend: i64) opt[u64] {
    val l: *Layout = layout_of(f, form);
    if (l.addend.width == 0) {
        if (addend != 0) { ret opt[u64].none{}; }
        ret opt[u64].some{0};
    }
    val raw: u64 = addend:~u64;
    if (l.addend.width >= 64) { ret opt[u64].some{raw}; }
    val room: u64 = 1::u64 << l.addend.width::u64;
    if (f.signed_addend) {
        val half: i64 = (1::i64) << (l.addend.width::i64 - 1);
        if (addend < -half || addend >= half) { ret opt[u64].none{}; }
        ret opt[u64].some{raw & (room - 1)};
    }
    if (addend < 0 || raw >= room) { ret opt[u64].none{}; }
    ret opt[u64].some{raw};
}

# the field the import format `f` holds `addend` in, none where it holds no
# such addend. a format of a signed addend holds it in two's complement, and
# a 64-bit addend field holds any addend modulo 2^64, as the loader adds it
pub fun import_addend(f: *ImportFormat, addend: i64) opt[u64] {
    val width: u64 = f.addend.width::u64 * 8;
    if (width == 0) {
        if (addend != 0) { ret opt[u64].none{}; }
        ret opt[u64].some{0};
    }
    val raw: u64 = addend:~u64;
    if (width >= 64) { ret opt[u64].some{raw}; }
    val room: u64 = 1::u64 << width;
    if (f.signed_addend) {
        val half: i64 = (1::i64) << (width::i64 - 1);
        if (addend < -half || addend >= half) { ret opt[u64].none{}; }
        ret opt[u64].some{raw & (room - 1)};
    }
    if (addend < 0 || raw >= room) { ret opt[u64].none{}; }
    ret opt[u64].some{raw};
}

# the pointer `p` packed through format `f`, or the field its format has no
# room for
pub fun encode_pointer(f: *PointerFormat, p: *Pointer) res[u64, Fail] {
    val bound: bool = sel p.form.bind || sel p.form.auth_bind;
    val auth:  bool = sel p.form.auth_rebase || sel p.form.auth_bind;
    if (bound && f.bind.width == 0) { ret res[u64, Fail].err{fail.unsupported("format has no binds")}; }
    if (auth && f.auth.width == 0)  { ret res[u64, Fail].err{fail.unsupported("format has no authenticated pointers")}; }
    val l:    *Layout  = layout_of(f, ?p.form);
    val held: opt[u64] = pointer_addend(f, ?p.form, p.addend);
    if (sel held.none) { ret res[u64, Fail].err{fail.malformed("pointer addend does not fit its format")}; }
    val addend: u64 = held.some;
    if (!model.fits(p.target, l.target) || !model.fits(p.high8, l.high8) || !model.fits(p.ordinal, l.ordinal)
        || !model.fits(p.diversity, l.diversity) || !model.fits(p.addr_div, l.addr_div) || !model.fits(p.key, l.key)
        || !model.fits(p.cache_level, l.cache_level) || !model.fits(p.seg_index, l.seg_index) || !model.fits(p.next, l.next)) {
        ret res[u64, Fail].err{fail.malformed("pointer field does not fit its format")};
    }
    var word: u64 = 0;
    word = model.deposit(word, l.target, p.target);
    word = model.deposit(word, l.high8, p.high8);
    word = model.deposit(word, l.ordinal, p.ordinal);
    word = model.deposit(word, l.addend, addend);
    word = model.deposit(word, l.diversity, p.diversity);
    word = model.deposit(word, l.addr_div, p.addr_div);
    word = model.deposit(word, l.key, p.key);
    word = model.deposit(word, l.cache_level, p.cache_level);
    word = model.deposit(word, l.seg_index, p.seg_index);
    word = model.deposit(word, l.next, p.next);
    if (bound) { word = model.deposit(word, f.bind, 1); }
    if (auth)  { word = model.deposit(word, f.auth, 1); }
    ret res[u64, Fail].ok{word};
}
