# the function starts and the data in code of the link-edit data
#
# function starts are a ULEB delta list from the start of __TEXT, ended by a
# zero delta and zero padded. data in code is a table of fixed records. both
# are pure functions over bytes and entries.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.vectors;
use mink.bytes.reader;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.macho.model.model.DataInCode;

# the width of a data in code record
pub val DATA_IN_CODE_SIZE: usize = 8;

# the most function starts one list may decode to
val MAX_STARTS: usize = 0x400_0000;

# the offsets from the start of __TEXT the reader's list of deltas names
pub fun decode_starts(a: *A.Allocator, r: *Reader) res[Vector[u64], Fail] {
    var out:     Vector[u64] = vector.init[u64](a);
    val err_ran: err[Fail]   = run_starts(?out, r);
    if (sel err_ran.err) {
        val err_dropped: err[Fail] = vectors.dnit[u64](?out);
        ret res[Vector[u64], Fail].err{err_ran.err};
    }
    ret res[Vector[u64], Fail].ok{out};
}

fun run_starts(out: *Vector[u64], r: *Reader) err[Fail] {
    var at: u64 = 0;
    for (reader.remaining(r) > 0) {
        val here:      u64            = reader.offset(r);
        val res_delta: res[u64, Fail] = reader.uleb(r);
        if (sel res_delta.err) { ret err[Fail].err{res_delta.err}; }
        if (res_delta.ok == 0) {
            for (reader.remaining(r) > 0) {
                val res_u8: res[u8, Fail] = reader.u8(r);
                if (sel res_u8.err) { ret err[Fail].err{res_u8.err}; }
                if (res_u8.ok != 0) { ret err[Fail].err{fail.at_offset(fail.in_file(fail.unsupported("bytes follow the end of the function starts"), r.file), reader.offset(r) - 1)}; }
            }
            ret err[Fail].ok{};
        }
        val res_sum: res[u64, Fail] = checked.add(reader.here(r), at, res_delta.ok);
        if (sel res_sum.err) { ret err[Fail].err{res_sum.err}; }
        if (vector.length[u64](out) >= MAX_STARTS) {
            ret err[Fail].err{fail.at_offset(fail.in_file(fail.unsupported("function starts list is longer than mink holds"), r.file), here)};
        }
        at = res_sum.ok;
        val err_out_pushed: err[Fail] = vectors.push[u64](out, at);
        if (sel err_out_pushed.err) { ret err[Fail].err{err_out_pushed.err}; }
    }
    ret err[Fail].ok{};
}

# the list of deltas for `offsets`, which ascend, ended by a zero delta and
# zero padded to `align`
pub fun encode_starts(s: *Sink, offsets: *Vector[u64], align: usize) err[Fail] {
    if (vector.length[u64](offsets) == 0) { ret err[Fail].ok{}; }
    var prev: u64   = 0;
    var i:    usize = 0;
    for (i < vector.length[u64](offsets)) {
        val at: u64 = offsets.data[i];
        if (at <= prev) { ret err[Fail].err{fail.malformed("function starts do not ascend")}; }
        val err_uleb: err[Fail] = sink.uleb(s, at - prev);
        if (sel err_uleb.err) { ret err_uleb; }
        prev = at;
        i    = i + 1;
    }
    val err_end: err[Fail] = sink.u8(s, 0);
    if (sel err_end.err) { ret err_end; }
    ret sink.pad_to(s, align);
}

# the data in code entries the reader spans
pub fun decode_data_in_code(a: *A.Allocator, r: *Reader) res[Vector[DataInCode], Fail] {
    var out: Vector[DataInCode] = vector.init[DataInCode](a);
    if (reader.remaining(r) % DATA_IN_CODE_SIZE != 0) {
        ret res[Vector[DataInCode], Fail].err{fail.at_offset(fail.in_file(fail.unsupported("data in code is not a whole number of records"), r.file), reader.offset(r))};
    }
    val err_grow: err[Fail] = vectors.grow[DataInCode](?out, reader.remaining(r) / DATA_IN_CODE_SIZE);
    if (sel err_grow.err) { ret res[Vector[DataInCode], Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < vector.length[DataInCode](?out)) {
        val res_offset: res[u32, Fail] = reader.u32(r);
        val res_length: res[u16, Fail] = reader.u16(r);
        val res_kind:   res[u16, Fail] = reader.u16(r);
        if (sel res_offset.err) { ret res[Vector[DataInCode], Fail].err{dic_dnit(?out, res_offset.err)}; }
        if (sel res_length.err) { ret res[Vector[DataInCode], Fail].err{dic_dnit(?out, res_length.err)}; }
        if (sel res_kind.err)   { ret res[Vector[DataInCode], Fail].err{dic_dnit(?out, res_kind.err)}; }
        out.data[i].offset = res_offset.ok;
        out.data[i].length = res_length.ok;
        out.data[i].kind   = res_kind.ok;
        i                  = i + 1;
    }
    ret res[Vector[DataInCode], Fail].ok{out};
}

fun dic_dnit(t: *Vector[DataInCode], f: Fail) Fail {
    val err_dropped: err[Fail] = vectors.dnit[DataInCode](t);
    ret f;
}

# write the data in code records for `entries`, in their order
# ---
# s:       the sink the records are written to
# entries: the entries
# ret:     ok, or the failure of the sink
pub fun encode_data_in_code(s: *Sink, entries: *Vector[DataInCode]) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[DataInCode](entries)) {
        val e:       *DataInCode = ?entries.data[i];
        val err_u32: err[Fail]   = sink.u32(s, e.offset);
        if (sel err_u32.err) { ret err_u32; }
        val err_u16: err[Fail] = sink.u16(s, e.length);
        if (sel err_u16.err) { ret err_u16; }
        val err_u16_kind: err[Fail] = sink.u16(s, e.kind);
        if (sel err_u16_kind.err) { ret err_u16_kind; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}
