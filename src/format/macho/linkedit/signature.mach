# the code signature superblob of LC_CODE_SIGNATURE
#
# a superblob is a blob index and the blobs it names. the decoder reads the
# code directory, the requirements and the plain blobs into entries, and holds
# every byte string they point at borrowed from the payload. the encoder writes
# each part at the offset the entries state, zero between, so a signature comes
# back byte for byte. a signature holding bytes no field covers is refused,
# since the entries could not give them back. everything in a signature is big
# endian whatever the image is, so both codecs take the byte order from here.
#
# code slot hashes are digests of each page of the image up to the code limit,
# the page size read from the directory and the last page only as long as the
# image is. special slot hashes are digests of the blobs the superblob holds,
# by slot. each directory hashes in its own type, a row of the hash types.

use std.compat.sha1;
use std.crypto.hash.sha256;
use std.crypto.hash.sha512;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;
use std.collections.sort;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Raw;
use mink.base.store.Store;
use mink.base.store.Why;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader;
use mink.bytes.reader.BIG;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Order;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.macho.model.cover;
use mink.format.macho.model.cover.Cover;
use mink.format.macho.model.model;
use mink.format.macho.model.model.BlobIndex;
use mink.format.macho.model.model.CsBlob;
use mink.format.macho.model.model.CsBody;
use mink.format.macho.model.model.Directory;
use mink.format.macho.model.model.Gap;
use mink.format.macho.model.model.Requirements;
use mink.format.macho.model.model.Scatter;
use mink.format.macho.model.model.Signature;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;

# the width of a blob's magic and length
pub val BLOB_HEADER_SIZE: usize = 8;

# the width of a superblob's magic, length and count
pub val SUPER_HEADER_SIZE: usize = 12;

# the width of a blob index entry and of a scatter entry
val INDEX_SIZE:   usize = 8;
val SCATTER_SIZE: usize = 24;

# the bytes a code directory takes from its magic, by version
# ---
# since: the version that added the fields, nil for the first
# end:   where the fields end
rec Step {
    since: *Constant;
    end:   u64;
}

val STEP_COUNT: usize = 7;

val STEPS: [STEP_COUNT]Step = [STEP_COUNT]Step{
    Step{since: nil, end: 44},
    Step{since: ?tables.CS_SUPPORTSSCATTER, end: 48},
    Step{since: ?tables.CS_SUPPORTSTEAMID, end: 52},
    Step{since: ?tables.CS_SUPPORTSCODELIMIT64, end: 64},
    Step{since: ?tables.CS_SUPPORTSEXECSEG, end: 88},
    Step{since: ?tables.CS_SUPPORTSRUNTIME, end: 96},
    Step{since: ?tables.CS_SUPPORTSLINKAGE, end: 108},
};

# where the fields of a directory of `version` end
fun header_end(version: u32) u64 {
    var end: u64   = STEPS[0].end;
    var i:   usize = 1;
    for (i < STEP_COUNT) {
        if (version::u64 >= STEPS[i].since.value) { end = STEPS[i].end; }
        i = i + 1;
    }
    ret end;
}

fun at_here(f: Fail, r: *Reader) Fail {
    ret fail.at_offset(fail.in_file(f, r.file), reader.offset(r));
}

fun is(magic: u32, c: *Constant) bool {
    ret magic::u64 == c.value;
}

fun held(r: *Reader, start: usize, n: usize) Held {
    if (n == 0) { ret Held.borrowed{Bytes{data: nil, len: 0}}; }
    ret Held.borrowed{Bytes{data: ?r.data[start], len: n}};
}

fun release_sig(s: *Signature, f: Fail) Fail {
    val dropped: err[Fail] = model.release_signature(s);
    ret f;
}

# the signature the reader spans, which starts at the superblob's magic. `a`
# holds its tables
pub fun decode(a: *A.Allocator, r: *Reader) res[Signature, Fail] {
    var sig: Signature = Signature{index: table.make[BlobIndex](a), blobs: table.make[CsBlob](a), gaps: table.make[Gap](a)};
    var be:  Reader    = @r;
    be.order = BIG;
    var cv:  Cover     = cover.make(a);
    val ran: err[Fail] = cover.settle(?cv, run(a, ?sig, ?be, ?cv));
    if (sel ran.err) { ret res[Signature, Fail].err{release_sig(?sig, ran.err)}; }
    ret res[Signature, Fail].ok{sig};
}

fun run(a: *A.Allocator, sig: *Signature, r: *Reader, cv: *Cover) err[Fail] {
    val sk: res[usize, Fail] = reader.seek(r, 0);
    if (sel sk.err) { ret err[Fail].err{sk.err}; }
    val magic: res[u32, Fail] = reader.u32(r);
    if (sel magic.err) { ret err[Fail].err{magic.err}; }
    if (!is(magic.ok, ?tables.CSMAGIC_EMBEDDED_SIGNATURE)) {
        ret err[Fail].err{at_here(fail.unsupported("superblob is not an embedded signature"), r)};
    }
    val length: res[u32, Fail] = reader.u32(r);
    if (sel length.err) { ret err[Fail].err{length.err}; }
    val count: res[u32, Fail] = reader.u32(r);
    if (sel count.err) { ret err[Fail].err{count.err}; }
    sig.magic  = magic.ok;
    sig.length = length.ok;
    sig.count  = count.ok;
    if (length.ok::usize > r.len || length.ok::usize < SUPER_HEADER_SIZE) {
        ret err[Fail].err{at_here(fail.malformed("superblob length lies outside the payload"), r)};
    }
    if (count.ok::usize > (length.ok::usize - SUPER_HEADER_SIZE) / INDEX_SIZE) {
        ret err[Fail].err{at_here(fail.truncated("blob index lies outside the superblob"), r)};
    }
    var i: usize = 0;
    for (i < count.ok::usize) {
        val kind: res[u32, Fail] = reader.u32(r);
        if (sel kind.err) { ret err[Fail].err{kind.err}; }
        val off: res[u32, Fail] = reader.u32(r);
        if (sel off.err) { ret err[Fail].err{off.err}; }
        val p: res[Id[BlobIndex], Fail] = table.push[BlobIndex](?sig.index, BlobIndex{type: kind.ok, offset: off.ok});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    var span: Reader            = @r;
    val sub:  res[Reader, Fail] = reader.sub(r, 0, length.ok::u64);
    if (sel sub.err) { ret err[Fail].err{sub.err}; }
    span = sub.ok;
    val head: err[Fail] = cover.add(cv, reader.here(r), 0, (SUPER_HEADER_SIZE + count.ok::usize * INDEX_SIZE)::u64);
    if (sel head.err) { ret head; }
    i = 0;
    for (i < count.ok::usize) {
        val ix: *BlobIndex        = table.at[BlobIndex](?sig.index, table.nth[BlobIndex](i));
        val b:  res[CsBlob, Fail] = decode_blob(a, ?span, ix.offset::u64);
        if (sel b.err) { ret err[Fail].err{fail.in_indexed(b.err, "signature blob", i::u64)}; }
        val c: err[Fail] = cover.add(cv, reader.here(r), ix.offset::u64, b.ok.length::u64);
        if (sel c.err) { ret c; }
        val p: res[Id[CsBlob], Fail] = table.push[CsBlob](?sig.blobs, b.ok);
        if (sel p.err) {
            val dropped: err[Fail] = release_body(?b.ok.body);
            ret err[Fail].err{p.err};
        }
        i = i + 1;
    }
    ret collect_gaps(cv, ?span, sig);
}

# the stretches between the covered ones that hold any byte but zero become gaps
fun collect_gaps(cv: *Cover, r: *Reader, sig: *Signature) err[Fail] {
    val ranges: *cover.Range = table.items[cover.Range](?cv.ranges);
    val count:  usize        = table.count[cover.Range](?cv.ranges);
    var at:     u64          = 0;
    var i:      usize        = 0;
    for (i <= count) {
        var stop: u64 = r.len::u64;
        if (i < count) { stop = ranges[i].start; }
        if (stop < at) {
            ret err[Fail].err{fail.at_offset(fail.in_file(fail.unsupported("parts of the signature overlap"), r.file), r.base + stop)};
        }
        var used: bool = false;
        var k:    u64  = at;
        for (k < stop) {
            if (r.data[k::usize] != 0) { used = true; }
            k = k + 1;
        }
        if (used) {
            val p: res[Id[Gap], Fail] = table.push[Gap](?sig.gaps, Gap{at: at, bytes: held(r, at::usize, (stop - at)::usize)});
            if (sel p.err) { ret err[Fail].err{p.err}; }
        }
        if (i < count) { at = ranges[i].end; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun release_body(b: *CsBody) err[Fail] {
    if (sel b.directory) { ret table.release[Scatter](?b.directory.scatter); }
    if (sel b.requirements) {
        val x: err[Fail] = table.release[BlobIndex](?b.requirements.index);
        val y: err[Fail] = table.release[Held](?b.requirements.items);
        if (sel x.err) { ret x; }
        ret y;
    }
    ret err[Fail].ok{};
}

# the blob at `pos` of the superblob `r` spans
fun decode_blob(a: *A.Allocator, r: *Reader, pos: u64) res[CsBlob, Fail] {
    val head: res[Reader, Fail] = reader.sub(r, pos, BLOB_HEADER_SIZE::u64);
    if (sel head.err) { ret res[CsBlob, Fail].err{head.err}; }
    var h:      Reader         = head.ok;
    val magic:  res[u32, Fail] = reader.u32(?h);
    val length: res[u32, Fail] = reader.u32(?h);
    if (sel magic.err)  { ret res[CsBlob, Fail].err{magic.err}; }
    if (sel length.err) { ret res[CsBlob, Fail].err{length.err}; }
    if (length.ok::usize < BLOB_HEADER_SIZE) {
        ret res[CsBlob, Fail].err{at_here(fail.malformed("blob is shorter than its header"), ?h)};
    }
    val whole: res[Reader, Fail] = reader.sub(r, pos, length.ok::u64);
    if (sel whole.err) { ret res[CsBlob, Fail].err{whole.err}; }
    var w:       Reader           = whole.ok;
    val skipped: res[usize, Fail] = reader.seek(?w, BLOB_HEADER_SIZE::u64);
    if (sel skipped.err) { ret res[CsBlob, Fail].err{skipped.err}; }
    var out: CsBlob = CsBlob{magic: magic.ok, length: length.ok};
    if (is(magic.ok, ?tables.CSMAGIC_CODEDIRECTORY)) {
        val d: res[Directory, Fail] = decode_directory(a, ?w);
        if (sel d.err) {
            if (fail.is_refused(d.err)) { ret res[CsBlob, Fail].err{d.err}; }
            out.body = raw_body(?w, Why.unsupported{});
        }
        or (sel d.ok) {
            out.body = CsBody.directory{d.ok};
        }
    }
    or (is(magic.ok, ?tables.CSMAGIC_REQUIREMENTS)) {
        val q: res[Requirements, Fail] = decode_requirements(a, ?w);
        if (sel q.err) {
            if (fail.is_refused(q.err)) { ret res[CsBlob, Fail].err{q.err}; }
            out.body = raw_body(?w, Why.unsupported{});
        }
        or (sel q.ok) {
            out.body = CsBody.requirements{q.ok};
        }
    }
    or (is(magic.ok, ?tables.CSMAGIC_EMBEDDED_ENTITLEMENTS)) {
        out.body = CsBody.entitlements{held(?w, BLOB_HEADER_SIZE, w.len - BLOB_HEADER_SIZE)};
    }
    or (is(magic.ok, ?tables.CSMAGIC_EMBEDDED_DER_ENTITLEMENTS)) {
        out.body = CsBody.der_entitlements{held(?w, BLOB_HEADER_SIZE, w.len - BLOB_HEADER_SIZE)};
    }
    or (is(magic.ok, ?tables.CSMAGIC_BLOBWRAPPER)) {
        out.body = CsBody.wrapper{held(?w, BLOB_HEADER_SIZE, w.len - BLOB_HEADER_SIZE)};
    }
    or (is(magic.ok, ?tables.CSMAGIC_EMBEDDED_LAUNCH_CONSTRAINT)) {
        out.body = CsBody.constraint{held(?w, BLOB_HEADER_SIZE, w.len - BLOB_HEADER_SIZE)};
    }
    or {
        out.body = raw_body(?w, Why.opaque{});
    }
    if (sel out.body.directory || sel out.body.requirements) {
        val same: res[bool, Fail] = reproduces(a, ?out, ?w);
        if (sel same.err) { ret res[CsBlob, Fail].err{same.err}; }
        if (!same.ok) {
            val dropped: err[Fail] = release_body(?out.body);
            out.body = raw_body(?w, Why.irreproducible{});
        }
    }
    ret res[CsBlob, Fail].ok{out};
}

fun raw_body(w: *Reader, why: Why) CsBody {
    ret CsBody.raw{Raw{bytes: held(w, BLOB_HEADER_SIZE, w.len - BLOB_HEADER_SIZE), why: why}};
}

# whether encoding the blob gives the bytes of `w`, which spans it whole
fun reproduces(a: *A.Allocator, b: *CsBlob, w: *Reader) res[bool, Fail] {
    var s:    Sink      = sink.make(a, BIG);
    var st:   Store     = store.make(a);
    val e:    err[Fail] = write_blob(?s, a, ?st, b);
    var same: bool      = !(sel e.err) && sink.len(?s) == w.len;
    var i:    usize     = 0;
    for (same && i < w.len) {
        same = sink.data(?s)[i] == w.data[i];
        i    = i + 1;
    }
    val x: err[Fail] = sink.release(?s);
    val y: err[Fail] = store.release(?st);
    if (sel e.err) {
        if (fail.is_refused(e.err)) { ret res[bool, Fail].err{e.err}; }
    }
    if (sel x.err) { ret res[bool, Fail].err{x.err}; }
    if (sel y.err) { ret res[bool, Fail].err{y.err}; }
    ret res[bool, Fail].ok{same};
}

fun cstring(r: *Reader, pos: u64, out: *Held, c: *Cover) err[Fail] {
    if (pos >= r.len::u64) { ret err[Fail].err{at_here(fail.truncated("string lies outside the blob"), r)}; }
    var i: usize = pos::usize;
    for (i < r.len && r.data[i] != 0) { i = i + 1; }
    if (i >= r.len) { ret err[Fail].err{at_here(fail.truncated("string is not terminated"), r)}; }
    @out = held(r, pos::usize, i - pos::usize);
    ret cover.add(c, reader.here(r), pos, (i - pos::usize + 1)::u64);
}

# `n` hashes of `size` bytes at `pos`
fun hashes(r: *Reader, c: *Cover, pos: u64, count: u64, size: u64, out: *Held) err[Fail] {
    val len: res[u64, Fail] = checked.mul(reader.here(r), count, size);
    if (sel len.err) { ret err[Fail].err{len.err}; }
    val end: res[u64, Fail] = checked.add(reader.here(r), pos, len.ok);
    if (sel end.err)         { ret err[Fail].err{end.err}; }
    if (end.ok > r.len::u64) { ret err[Fail].err{at_here(fail.truncated("hashes lie outside the blob"), r)}; }
    @out = held(r, pos::usize, len.ok::usize);
    ret cover.add(c, reader.here(r), pos, len.ok);
}

fun read_u32(r: *Reader, out: *u32) err[Fail] {
    val v: res[u32, Fail] = reader.u32(r);
    if (sel v.err) { ret err[Fail].err{v.err}; }
    @out = v.ok;
    ret err[Fail].ok{};
}

fun read_u8(r: *Reader, out: *u8) err[Fail] {
    val v: res[u8, Fail] = reader.u8(r);
    if (sel v.err) { ret err[Fail].err{v.err}; }
    @out = v.ok;
    ret err[Fail].ok{};
}

fun read_u64(r: *Reader, out: *u64) err[Fail] {
    val v: res[u64, Fail] = reader.u64(r);
    if (sel v.err) { ret err[Fail].err{v.err}; }
    @out = v.ok;
    ret err[Fail].ok{};
}

# the code directory in the blob `r` spans, after its magic and length
fun decode_directory(a: *A.Allocator, r: *Reader) res[Directory, Fail] {
    var d: Directory;
    d.scatter = table.make[Scatter](a);
    var cv:  Cover     = cover.make(a);
    val ran: err[Fail] = cover.settle(?cv, run_directory(?d, r, ?cv));
    if (sel ran.err) {
        val dropped: err[Fail] = table.release[Scatter](?d.scatter);
        ret res[Directory, Fail].err{ran.err};
    }
    ret res[Directory, Fail].ok{d};
}

fun run_directory(d: *Directory, r: *Reader, cv: *Cover) err[Fail] {
    val ver: err[Fail] = read_u32(r, ?d.version);
    if (sel ver.err) { ret ver; }
    val end: u64 = header_end(d.version);
    if (d.version::u64 > tables.CS_SUPPORTSLINKAGE.value) {
        ret err[Fail].err{at_here(fail.unsupported("code directory is newer than the revision mink implements"), r)};
    }
    if (end > r.len::u64) { ret err[Fail].err{at_here(fail.truncated("code directory header lies outside its blob"), r)}; }
    val words: [6]*u32 = [6]*u32{?d.flags, ?d.hash_offset, ?d.ident_offset, ?d.n_special_slots, ?d.n_code_slots, ?d.code_limit};
    var i:     usize   = 0;
    for (i < 6) {
        val x: err[Fail] = read_u32(r, words[i]);
        if (sel x.err) { ret x; }
        i = i + 1;
    }
    val bytes: [4]*u8 = [4]*u8{?d.hash_size, ?d.hash_type, ?d.platform, ?d.page_size};
    i = 0;
    for (i < 4) {
        val x: err[Fail] = read_u8(r, bytes[i]);
        if (sel x.err) { ret x; }
        i = i + 1;
    }
    val spare2: err[Fail] = read_u32(r, ?d.spare2);
    if (sel spare2.err) { ret spare2; }
    if (end >= 48) {
        val x: err[Fail] = read_u32(r, ?d.scatter_offset);
        if (sel x.err) { ret x; }
    }
    if (end >= 52) {
        val x: err[Fail] = read_u32(r, ?d.team_offset);
        if (sel x.err) { ret x; }
    }
    if (end >= 64) {
        val x: err[Fail] = read_u32(r, ?d.spare3);
        if (sel x.err) { ret x; }
        val y: err[Fail] = read_u64(r, ?d.code_limit64);
        if (sel y.err) { ret y; }
    }
    if (end >= 88) {
        val x: err[Fail] = read_u64(r, ?d.exec_seg_base);
        if (sel x.err) { ret x; }
        val y: err[Fail] = read_u64(r, ?d.exec_seg_limit);
        if (sel y.err) { ret y; }
        val z: err[Fail] = read_u64(r, ?d.exec_seg_flags);
        if (sel z.err) { ret z; }
    }
    if (end >= 96) {
        val x: err[Fail] = read_u32(r, ?d.runtime);
        if (sel x.err) { ret x; }
        val y: err[Fail] = read_u32(r, ?d.pre_encrypt_offset);
        if (sel y.err) { ret y; }
    }
    if (end >= 108) {
        val x: err[Fail] = read_u8(r, ?d.linkage_hash_type);
        if (sel x.err) { ret x; }
        val y: err[Fail] = read_u8(r, ?d.linkage_application_type);
        if (sel y.err) { ret y; }
        val z: res[u16, Fail] = reader.u16(r);
        if (sel z.err) { ret err[Fail].err{z.err}; }
        d.linkage_application_subtype = z.ok;
        val w: err[Fail] = read_u32(r, ?d.linkage_offset);
        if (sel w.err) { ret w; }
        val v: err[Fail] = read_u32(r, ?d.linkage_size);
        if (sel v.err) { ret v; }
    }
    val head: err[Fail] = cover.add(cv, reader.here(r), 0, end);
    if (sel head.err) { ret head; }
    val ident: err[Fail] = cstring(r, d.ident_offset::u64, ?d.ident, cv);
    if (sel ident.err) { ret ident; }
    if (end >= 52 && d.team_offset != 0) {
        val x: err[Fail] = cstring(r, d.team_offset::u64, ?d.team, cv);
        if (sel x.err) { ret x; }
    }
    val first: res[u64, Fail] = checked.mul(reader.here(r), d.n_special_slots::u64, d.hash_size::u64);
    if (sel first.err) { ret err[Fail].err{first.err}; }
    val start: res[u64, Fail] = checked.sub(reader.here(r), d.hash_offset::u64, first.ok);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    val total: res[u64, Fail] = checked.add(reader.here(r), d.n_special_slots::u64, d.n_code_slots::u64);
    if (sel total.err) { ret err[Fail].err{total.err}; }
    val hs: err[Fail] = hashes(r, cv, start.ok, total.ok, d.hash_size::u64, ?d.hashes);
    if (sel hs.err) { ret hs; }
    if (end >= 48 && d.scatter_offset != 0) {
        val x: err[Fail] = decode_scatter(r, d, cv);
        if (sel x.err) { ret x; }
    }
    if (end >= 96 && d.pre_encrypt_offset != 0) {
        val x: err[Fail] = hashes(r, cv, d.pre_encrypt_offset::u64, d.n_code_slots::u64, d.hash_size::u64, ?d.pre_encrypt);
        if (sel x.err) { ret x; }
    }
    if (end >= 108 && d.linkage_offset != 0) {
        val x: err[Fail] = hashes(r, cv, d.linkage_offset::u64, d.linkage_size::u64, 1, ?d.linkage);
        if (sel x.err) { ret x; }
    }
    ret cover.check(cv, r);
}

# the scatter vector, whose zero count ends it
fun decode_scatter(r: *Reader, d: *Directory, cv: *Cover) err[Fail] {
    val sk: res[usize, Fail] = reader.seek(r, d.scatter_offset::u64);
    if (sel sk.err) { ret err[Fail].err{sk.err}; }
    var n: u64 = 0;
    for {
        val count: res[u32, Fail] = reader.u32(r);
        if (sel count.err) { ret err[Fail].err{count.err}; }
        val base: res[u32, Fail] = reader.u32(r);
        if (sel base.err) { ret err[Fail].err{base.err}; }
        val target: res[u64, Fail] = reader.u64(r);
        if (sel target.err) { ret err[Fail].err{target.err}; }
        val spare: res[u64, Fail] = reader.u64(r);
        if (sel spare.err) { ret err[Fail].err{spare.err}; }
        n = n + 1;
        if (count.ok == 0) { brk; }
        val p: res[Id[Scatter], Fail] = table.push[Scatter](?d.scatter, Scatter{count: count.ok, base: base.ok, target_offset: target.ok, spare: spare.ok});
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    ret cover.add(cv, reader.here(r), d.scatter_offset::u64, n * SCATTER_SIZE::u64);
}

fun decode_requirements(a: *A.Allocator, r: *Reader) res[Requirements, Fail] {
    var q:   Requirements = Requirements{index: table.make[BlobIndex](a), items: table.make[Held](a)};
    var cv:  Cover        = cover.make(a);
    val ran: err[Fail]    = cover.settle(?cv, run_requirements(?q, r, ?cv));
    if (sel ran.err) {
        val x: err[Fail] = table.release[BlobIndex](?q.index);
        val y: err[Fail] = table.release[Held](?q.items);
        ret res[Requirements, Fail].err{ran.err};
    }
    ret res[Requirements, Fail].ok{q};
}

fun run_requirements(q: *Requirements, r: *Reader, cv: *Cover) err[Fail] {
    val count: err[Fail] = read_u32(r, ?q.count);
    if (sel count.err) { ret count; }
    if (q.count::usize > (r.len - r.pos) / INDEX_SIZE) {
        ret err[Fail].err{at_here(fail.truncated("requirement index lies outside the blob"), r)};
    }
    var i: usize = 0;
    for (i < q.count::usize) {
        val kind: res[u32, Fail] = reader.u32(r);
        if (sel kind.err) { ret err[Fail].err{kind.err}; }
        val off: res[u32, Fail] = reader.u32(r);
        if (sel off.err) { ret err[Fail].err{off.err}; }
        val p: res[Id[BlobIndex], Fail] = table.push[BlobIndex](?q.index, BlobIndex{type: kind.ok, offset: off.ok});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    val top: err[Fail] = cover.add(cv, reader.here(r), 0, (BLOB_HEADER_SIZE + 4 + q.count::usize * INDEX_SIZE)::u64);
    if (sel top.err) { ret top; }
    i = 0;
    for (i < q.count::usize) {
        val pos:  u64               = table.at[BlobIndex](?q.index, table.nth[BlobIndex](i)).offset::u64;
        val head: res[Reader, Fail] = reader.sub(r, pos, BLOB_HEADER_SIZE::u64);
        if (sel head.err) { ret err[Fail].err{head.err}; }
        var h:      Reader         = head.ok;
        val magic:  res[u32, Fail] = reader.u32(?h);
        val length: res[u32, Fail] = reader.u32(?h);
        if (sel magic.err)  { ret err[Fail].err{magic.err}; }
        if (sel length.err) { ret err[Fail].err{length.err}; }
        if (length.ok::usize < BLOB_HEADER_SIZE || pos > r.len::u64 || length.ok::u64 > r.len::u64 - pos) {
            ret err[Fail].err{at_here(fail.malformed("requirement lies outside its blob"), ?h)};
        }
        val c: err[Fail] = cover.add(cv, reader.here(r), pos, length.ok::u64);
        if (sel c.err) { ret c; }
        val p: res[Id[Held], Fail] = table.push[Held](?q.items, held(r, pos::usize, length.ok::usize));
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret cover.check(cv, r);
}

# a part of a blob an encoder writes at an offset
# ---
# offset: where it lies
# kind:   which part it is, PART_*
# index:  which entry of a table it is
rec Part {
    offset: u64;
    kind:   u8;
    index:  u32;
}

val PART_IDENT:       u8 = 0;
val PART_TEAM:        u8 = 1;
val PART_HASHES:      u8 = 2;
val PART_SCATTER:     u8 = 3;
val PART_PRE_ENCRYPT: u8 = 4;
val PART_LINKAGE:     u8 = 5;

fun by_offset(a: *Part, b: *Part) i64 {
    if (a.offset < b.offset) { ret -1; }
    if (a.offset > b.offset) { ret 1; }
    ret 0;
}

fun push_part(t: *Table[Part], offset: u64, kind: u8, index: u32) err[Fail] {
    val p: res[Id[Part], Fail] = table.push[Part](t, Part{offset: offset, kind: kind, index: index});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the zero bytes up to `offset` bytes into the blob that began at `start`
fun reach(s: *Sink, start: usize, offset: u64) err[Fail] {
    val have: u64 = (sink.len(s) - start)::u64;
    if (offset < have) { ret err[Fail].err{fail.malformed("parts of the signature overlap")}; }
    ret sink.zeros(s, (offset - have)::usize);
}

# the blob that began at `start` ended at `length` bytes
fun finish(s: *Sink, start: usize, length: u32) err[Fail] {
    val have: u64 = (sink.len(s) - start)::u64;
    if (have > length::u64) { ret err[Fail].err{fail.malformed("signature part runs past its length")}; }
    ret sink.zeros(s, (length::u64 - have)::usize);
}

# the signature in big endian, whatever order `s` writes in. byte strings are
# read through `st`
pub fun encode(s: *Sink, a: *A.Allocator, st: *Store, sig: *Signature) err[Fail] {
    val saved: Order = s.order;
    s.order = BIG;
    val w: err[Fail] = write_signature(s, a, st, sig);
    s.order = saved;
    ret w;
}

fun write_signature(s: *Sink, a: *A.Allocator, st: *Store, sig: *Signature) err[Fail] {
    val c: err[Fail] = counted(sig);
    if (sel c.err) { ret c; }
    val start: usize     = sink.len(s);
    val h1:    err[Fail] = sink.u32(s, sig.magic);
    if (sel h1.err) { ret h1; }
    val h2: err[Fail] = sink.u32(s, sig.length);
    if (sel h2.err) { ret h2; }
    val h3: err[Fail] = sink.u32(s, sig.count);
    if (sel h3.err) { ret h3; }
    var i: usize = 0;
    for (i < table.count[BlobIndex](?sig.index)) {
        val ix: *BlobIndex = table.at[BlobIndex](?sig.index, table.nth[BlobIndex](i));
        val x:  err[Fail]  = sink.u32(s, ix.type);
        if (sel x.err) { ret x; }
        val y: err[Fail] = sink.u32(s, ix.offset);
        if (sel y.err) { ret y; }
        i = i + 1;
    }
    var g: usize = 0;
    i = 0;
    for (i < table.count[CsBlob](?sig.blobs)) {
        val ix:     *BlobIndex = table.at[BlobIndex](?sig.index, table.nth[BlobIndex](i));
        val before: err[Fail]  = write_gaps(s, st, start, sig, ?g, ix.offset::u64);
        if (sel before.err) { ret before; }
        val r: err[Fail] = reach(s, start, ix.offset::u64);
        if (sel r.err) { ret r; }
        val w: err[Fail] = write_blob(s, a, st, table.at[CsBlob](?sig.blobs, table.nth[CsBlob](i)));
        if (sel w.err) { ret err[Fail].err{fail.in_indexed(w.err, "signature blob", i::u64)}; }
        i = i + 1;
    }
    val after: err[Fail] = write_gaps(s, st, start, sig, ?g, sig.length::u64);
    if (sel after.err) { ret after; }
    ret finish(s, start, sig.length);
}

# the gaps from `next` that begin before `limit`
fun write_gaps(s: *Sink, st: *Store, start: usize, sig: *Signature, next: *usize, limit: u64) err[Fail] {
    for (@next < table.count[Gap](?sig.gaps) && table.at[Gap](?sig.gaps, table.nth[Gap](@next)).at < limit) {
        val gap: *Gap      = table.at[Gap](?sig.gaps, table.nth[Gap](@next));
        val r:   err[Fail] = reach(s, start, gap.at);
        if (sel r.err) { ret r; }
        val w: err[Fail] = write_held(s, st, ?gap.bytes);
        if (sel w.err) { ret w; }
        @next = @next + 1;
    }
    ret err[Fail].ok{};
}

fun write_blob(s: *Sink, a: *A.Allocator, st: *Store, b: *CsBlob) err[Fail] {
    val start: usize     = sink.len(s);
    val m:     err[Fail] = sink.u32(s, b.magic);
    if (sel m.err) { ret m; }
    val l: err[Fail] = sink.u32(s, b.length);
    if (sel l.err) { ret l; }
    var w: err[Fail] = err[Fail].ok{};
    if (sel b.body.directory)        { w = write_directory(s, a, st, start, ?b.body.directory); }
    or (sel b.body.requirements)     { w = write_requirements(s, st, start, ?b.body.requirements); }
    or (sel b.body.entitlements)     { w = write_held(s, st, ?b.body.entitlements); }
    or (sel b.body.der_entitlements) { w = write_held(s, st, ?b.body.der_entitlements); }
    or (sel b.body.wrapper)          { w = write_held(s, st, ?b.body.wrapper); }
    or (sel b.body.constraint)       { w = write_held(s, st, ?b.body.constraint); }
    or (sel b.body.raw)              { w = write_held(s, st, ?b.body.raw.bytes); }
    if (sel w.err)                   { ret w; }
    ret finish(s, start, b.length);
}

fun write_held(s: *Sink, st: *Store, h: *Held) err[Fail] {
    val b: Bytes = store.bytes(st, h);
    ret sink.bytes(s, b.data, b.len);
}

# a byte string and its NUL
fun write_text(s: *Sink, st: *Store, h: *Held) err[Fail] {
    val w: err[Fail] = write_held(s, st, h);
    if (sel w.err) { ret w; }
    ret sink.u8(s, 0);
}

fun write_requirements(s: *Sink, st: *Store, start: usize, q: *Requirements) err[Fail] {
    if (table.count[BlobIndex](?q.index)::u64 != q.count::u64 || table.count[Held](?q.items)::u64 != q.count::u64) {
        ret err[Fail].err{fail.malformed("requirements count disagrees with its tables")};
    }
    val c: err[Fail] = sink.u32(s, q.count);
    if (sel c.err) { ret c; }
    var i: usize = 0;
    for (i < q.count::usize) {
        val ix: *BlobIndex = table.at[BlobIndex](?q.index, table.nth[BlobIndex](i));
        val x:  err[Fail]  = sink.u32(s, ix.type);
        if (sel x.err) { ret x; }
        val y: err[Fail] = sink.u32(s, ix.offset);
        if (sel y.err) { ret y; }
        i = i + 1;
    }
    i = 0;
    for (i < q.count::usize) {
        val r: err[Fail] = reach(s, start, table.at[BlobIndex](?q.index, table.nth[BlobIndex](i)).offset::u64);
        if (sel r.err) { ret r; }
        val w: err[Fail] = write_held(s, st, table.at[Held](?q.items, table.nth[Held](i)));
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun write_directory(s: *Sink, a: *A.Allocator, st: *Store, start: usize, d: *Directory) err[Fail] {
    val end: u64 = header_end(d.version);
    if (d.version::u64 > tables.CS_SUPPORTSLINKAGE.value) {
        ret err[Fail].err{fail.unsupported("code directory is newer than the revision mink implements")};
    }
    val words: [7]u32 = [7]u32{d.version, d.flags, d.hash_offset, d.ident_offset, d.n_special_slots, d.n_code_slots, d.code_limit};
    var i:     usize  = 0;
    for (i < 7) {
        val x: err[Fail] = sink.u32(s, words[i]);
        if (sel x.err) { ret x; }
        i = i + 1;
    }
    val bytes: [4]u8 = [4]u8{d.hash_size, d.hash_type, d.platform, d.page_size};
    i = 0;
    for (i < 4) {
        val x: err[Fail] = sink.u8(s, bytes[i]);
        if (sel x.err) { ret x; }
        i = i + 1;
    }
    val sp: err[Fail] = sink.u32(s, d.spare2);
    if (sel sp.err) { ret sp; }
    if (end >= 48) {
        val x: err[Fail] = sink.u32(s, d.scatter_offset);
        if (sel x.err) { ret x; }
    }
    if (end >= 52) {
        val x: err[Fail] = sink.u32(s, d.team_offset);
        if (sel x.err) { ret x; }
    }
    if (end >= 64) {
        val x: err[Fail] = sink.u32(s, d.spare3);
        if (sel x.err) { ret x; }
        val y: err[Fail] = sink.u64(s, d.code_limit64);
        if (sel y.err) { ret y; }
    }
    if (end >= 88) {
        val x: err[Fail] = sink.u64(s, d.exec_seg_base);
        if (sel x.err) { ret x; }
        val y: err[Fail] = sink.u64(s, d.exec_seg_limit);
        if (sel y.err) { ret y; }
        val z: err[Fail] = sink.u64(s, d.exec_seg_flags);
        if (sel z.err) { ret z; }
    }
    if (end >= 96) {
        val x: err[Fail] = sink.u32(s, d.runtime);
        if (sel x.err) { ret x; }
        val y: err[Fail] = sink.u32(s, d.pre_encrypt_offset);
        if (sel y.err) { ret y; }
    }
    if (end >= 108) {
        val x: err[Fail] = sink.u8(s, d.linkage_hash_type);
        if (sel x.err) { ret x; }
        val y: err[Fail] = sink.u8(s, d.linkage_application_type);
        if (sel y.err) { ret y; }
        val z: err[Fail] = sink.u16(s, d.linkage_application_subtype);
        if (sel z.err) { ret z; }
        val w: err[Fail] = sink.u32(s, d.linkage_offset);
        if (sel w.err) { ret w; }
        val v: err[Fail] = sink.u32(s, d.linkage_size);
        if (sel v.err) { ret v; }
    }
    var parts:   Table[Part] = table.make[Part](a);
    val planned: err[Fail]   = plan_directory(?parts, d, end);
    if (sel planned.err) {
        val dropped: err[Fail] = table.release[Part](?parts);
        ret planned;
    }
    sort.sort_by[Part](table.items[Part](?parts), table.count[Part](?parts), by_offset);
    var failed: err[Fail] = err[Fail].ok{};
    i = 0;
    for (i < table.count[Part](?parts) && !sel failed.err) {
        failed = write_part(s, st, start, d, table.at[Part](?parts, table.nth[Part](i)));
        i      = i + 1;
    }
    val dropped: err[Fail] = table.release[Part](?parts);
    if (sel failed.err) { ret failed; }
    ret dropped;
}

fun plan_directory(parts: *Table[Part], d: *Directory, end: u64) err[Fail] {
    val ident: err[Fail] = push_part(parts, d.ident_offset::u64, PART_IDENT, 0);
    if (sel ident.err) { ret ident; }
    if (end >= 52 && d.team_offset != 0) {
        val x: err[Fail] = push_part(parts, d.team_offset::u64, PART_TEAM, 0);
        if (sel x.err) { ret x; }
    }
    val first: res[u64, Fail] = checked.mul(Location{}, d.n_special_slots::u64, d.hash_size::u64);
    if (sel first.err) { ret err[Fail].err{first.err}; }
    val at: res[u64, Fail] = checked.sub(Location{}, d.hash_offset::u64, first.ok);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val hs: err[Fail] = push_part(parts, at.ok, PART_HASHES, 0);
    if (sel hs.err) { ret hs; }
    if (end >= 48 && d.scatter_offset != 0) {
        val x: err[Fail] = push_part(parts, d.scatter_offset::u64, PART_SCATTER, 0);
        if (sel x.err) { ret x; }
    }
    if (end >= 96 && d.pre_encrypt_offset != 0) {
        val x: err[Fail] = push_part(parts, d.pre_encrypt_offset::u64, PART_PRE_ENCRYPT, 0);
        if (sel x.err) { ret x; }
    }
    if (end >= 108 && d.linkage_offset != 0) {
        val x: err[Fail] = push_part(parts, d.linkage_offset::u64, PART_LINKAGE, 0);
        if (sel x.err) { ret x; }
    }
    ret err[Fail].ok{};
}

fun write_part(s: *Sink, st: *Store, start: usize, d: *Directory, p: *Part) err[Fail] {
    val r: err[Fail] = reach(s, start, p.offset);
    if (sel r.err)                  { ret r; }
    if (p.kind == PART_IDENT)       { ret write_text(s, st, ?d.ident); }
    if (p.kind == PART_TEAM)        { ret write_text(s, st, ?d.team); }
    if (p.kind == PART_HASHES)      { ret write_held(s, st, ?d.hashes); }
    if (p.kind == PART_PRE_ENCRYPT) { ret write_held(s, st, ?d.pre_encrypt); }
    if (p.kind == PART_LINKAGE)     { ret write_held(s, st, ?d.linkage); }
    var i: usize = 0;
    for (i < table.count[Scatter](?d.scatter)) {
        val e: *Scatter = table.at[Scatter](?d.scatter, table.nth[Scatter](i));
        if (e.count == 0) { ret err[Fail].err{fail.malformed("scatter entry with no pages ends the vector early")}; }
        val a: err[Fail] = sink.u32(s, e.count);
        if (sel a.err) { ret a; }
        val b: err[Fail] = sink.u32(s, e.base);
        if (sel b.err) { ret b; }
        val c: err[Fail] = sink.u64(s, e.target_offset);
        if (sel c.err) { ret c; }
        val x: err[Fail] = sink.u64(s, e.spare);
        if (sel x.err) { ret x; }
        i = i + 1;
    }
    ret sink.zeros(s, SCATTER_SIZE);
}

# the bytes of the image the code slots cover, which end at the code limit
pub fun code_limit(d: *Directory) u64 {
    if (d.code_limit == 0 && d.version::u64 >= tables.CS_SUPPORTSCODELIMIT64.value) { ret d.code_limit64; }
    ret d.code_limit::u64;
}

# how many bytes a code slot covers: a page, or the whole image when the page
# size is zero
pub fun page_bytes(d: *Directory) res[u64, Fail] {
    if (d.page_size == 0)  { ret res[u64, Fail].ok{code_limit(d)}; }
    if (d.page_size >= 64) { ret res[u64, Fail].err{fail.malformed("code directory page size is not a power of two a size holds")}; }
    ret res[u64, Fail].ok{(1::u64) << d.page_size::u64};
}

# how many code slots cover the image
pub fun slot_count(d: *Directory) res[u64, Fail] {
    val page: res[u64, Fail] = page_bytes(d);
    if (sel page.err) { ret res[u64, Fail].err{page.err}; }
    val limit: u64 = code_limit(d);
    if (limit == 0) { ret res[u64, Fail].ok{0}; }
    val up: res[u64, Fail] = checked.add(Location{}, limit, page.ok - 1);
    if (sel up.err) { ret res[u64, Fail].err{up.err}; }
    ret res[u64, Fail].ok{up.ok / page.ok};
}

# a code slot hash type: the code the hash type table names, the width of the
# digest std gives for it and the hash that gives it. a directory keeps the
# first hash size bytes of each digest
rec Hasher {
    type:  *Constant;
    width: usize;
    run:   fun(*u8, usize, *u8);
}

val HASHER_COUNT: usize = 4;

val HASHERS: [HASHER_COUNT]Hasher = [HASHER_COUNT]Hasher{
    Hasher{type: ?tables.CS_HASHTYPE_SHA1, width: sha1.DIGEST_SIZE, run: sha1.hash},
    Hasher{type: ?tables.CS_HASHTYPE_SHA256, width: sha256.DIGEST_SIZE, run: sha256.hash},
    Hasher{type: ?tables.CS_HASHTYPE_SHA256_TRUNCATED, width: sha256.DIGEST_SIZE, run: sha256.hash},
    Hasher{type: ?tables.CS_HASHTYPE_SHA384, width: sha512.DIGEST_SIZE_384, run: sha512.hash384},
};

# the hash the slots of `d` are made with. a type with no row is refused, and
# so is a hash size its digest does not hold
fun hasher(d: *Directory) res[*Hasher, Fail] {
    var i: usize = 0;
    for (i < HASHER_COUNT) {
        val h: *Hasher = ?HASHERS[i];
        if (d.hash_type::u64 == h.type.value) {
            if (d.hash_size == 0 || d.hash_size::usize > h.width) {
                ret res[*Hasher, Fail].err{fail.valued(fail.malformed("code directory hash size is not one its hash type's digest holds"), d.hash_size::i128)};
            }
            ret res[*Hasher, Fail].ok{h};
        }
        i = i + 1;
    }
    ret res[*Hasher, Fail].err{fail.valued(fail.unsupported("code directory hash type is not one mink hashes"), d.hash_type::i128)};
}

# append the first `size` bytes of the digest `h` gives of the `len` bytes at `data`
fun digest(s: *Sink, h: *Hasher, size: usize, data: *u8, len: usize) err[Fail] {
    var out: [tables.CS_HASH_MAX_SIZE.value]u8;
    h.run(data, len, ?out[0]);
    ret sink.bytes(s, ?out[0], size);
}

# append the code slot hashes of the `len` bytes of the image at `data`: one
# digest in the directory's hash type per page of the page size it states, the
# last covering only what remains up to the code limit
pub fun hash_pages(s: *Sink, d: *Directory, data: *u8, len: usize) err[Fail] {
    val h: res[*Hasher, Fail] = hasher(d);
    if (sel h.err) { ret err[Fail].err{h.err}; }
    val limit: u64 = code_limit(d);
    if (limit > len::u64) { ret err[Fail].err{fail.truncated("code limit lies past the image")}; }
    val page: res[u64, Fail] = page_bytes(d);
    if (sel page.err) { ret err[Fail].err{page.err}; }
    var at: u64 = 0;
    for (at < limit) {
        var n: u64 = page.ok;
        if (limit - at < n) { n = limit - at; }
        val w: err[Fail] = digest(s, h.ok, d.hash_size::usize, ?data[at::usize], n::usize);
        if (sel w.err) { ret w; }
        at = at + n;
    }
    ret err[Fail].ok{};
}

# a special slot whose blob the superblob holds: the slot, which is the blob's
# type in the blob index, and the magic that blob carries
rec Special {
    slot:  *Constant;
    magic: *Constant;
}

val SPECIAL_COUNT: usize = 7;

val SPECIALS: [SPECIAL_COUNT]Special = [SPECIAL_COUNT]Special{
    Special{slot: ?tables.CSSLOT_REQUIREMENTS, magic: ?tables.CSMAGIC_REQUIREMENTS},
    Special{slot: ?tables.CSSLOT_ENTITLEMENTS, magic: ?tables.CSMAGIC_EMBEDDED_ENTITLEMENTS},
    Special{slot: ?tables.CSSLOT_DER_ENTITLEMENTS, magic: ?tables.CSMAGIC_EMBEDDED_DER_ENTITLEMENTS},
    Special{slot: ?tables.CSSLOT_LAUNCH_CONSTRAINT_SELF, magic: ?tables.CSMAGIC_EMBEDDED_LAUNCH_CONSTRAINT},
    Special{slot: ?tables.CSSLOT_LAUNCH_CONSTRAINT_PARENT, magic: ?tables.CSMAGIC_EMBEDDED_LAUNCH_CONSTRAINT},
    Special{slot: ?tables.CSSLOT_LAUNCH_CONSTRAINT_RESPONSIBLE, magic: ?tables.CSMAGIC_EMBEDDED_LAUNCH_CONSTRAINT},
    Special{slot: ?tables.CSSLOT_LIBRARY_CONSTRAINT, magic: ?tables.CSMAGIC_EMBEDDED_LAUNCH_CONSTRAINT},
};

# whether a row names `slot` as hashing a blob of `magic`
fun identifies(slot: u64, magic: u32) bool {
    var i: usize = 0;
    for (i < SPECIAL_COUNT) {
        if (SPECIALS[i].slot.value == slot) { ret SPECIALS[i].magic.value == magic::u64; }
        i = i + 1;
    }
    ret false;
}

fun counted(sig: *Signature) err[Fail] {
    if (table.count[BlobIndex](?sig.index)::u64 != sig.count::u64 || table.count[CsBlob](?sig.blobs)::u64 != sig.count::u64) {
        ret err[Fail].err{fail.malformed("superblob count disagrees with its tables")};
    }
    ret err[Fail].ok{};
}

# for each of the first `n` special slots, where the superblob holds its blob,
# plus one, or zero where it holds none
fun place_specials(at: *Table[u32], sig: *Signature, n: usize) err[Fail] {
    val g: res[Id[u32], Fail] = table.grow[u32](at, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < table.count[BlobIndex](?sig.index)) {
        val ix: *BlobIndex = table.at[BlobIndex](?sig.index, table.nth[BlobIndex](i));
        if (ix.type != 0 && ix.type::u64 <= n::u64) {
            val p: *u32 = table.at[u32](at, table.nth[u32]((ix.type - 1)::usize));
            if (@p != 0) { ret err[Fail].err{fail.valued(fail.malformed("superblob holds two blobs of one special slot"), ix.type::i128)}; }
            @p = (i + 1)::u32;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# append the special slots of `d`, from its highest slot down to the first: each
# the digest of the blob `sig` holds of that slot's type, or zeroes where it
# holds none. a blob no row identifies for its slot is refused, and so is a slot
# hashing a blob the superblob does not hold, since neither can be made again
fun special_slots(s: *Sink, a: *A.Allocator, st: *Store, sig: *Signature, d: *Directory) err[Fail] {
    val h: res[*Hasher, Fail] = hasher(d);
    if (sel h.err) { ret err[Fail].err{h.err}; }
    val c: err[Fail] = counted(sig);
    if (sel c.err) { ret c; }
    val size: usize          = d.hash_size::usize;
    val n:    usize          = d.n_special_slots::usize;
    val want: res[u64, Fail] = checked.mul(Location{}, n::u64, size::u64);
    if (sel want.err) { ret err[Fail].err{want.err}; }
    val held: Bytes = store.bytes(st, ?d.hashes);
    if (held.len::u64 < want.ok) {
        ret err[Fail].err{fail.in_record(fail.malformed("code directory holds fewer special slots than it states"), "code directory")};
    }
    var at: Table[u32] = table.make[u32](a);
    var w:  err[Fail]  = place_specials(?at, sig, n);
    var k:  usize      = n;
    for (!(sel w.err) && k > 0) {
        w = special_slot(s, a, st, sig, h.ok, size, k, @table.at[u32](?at, table.nth[u32](k - 1)), ?held.data[(n - k) * size]);
        k = k - 1;
    }
    val dropped: err[Fail] = table.release[u32](?at);
    if (sel w.err) { ret w; }
    ret dropped;
}

fun special_slot(s: *Sink, a: *A.Allocator, st: *Store, sig: *Signature, h: *Hasher, size: usize, slot: usize, place: u32, held: *u8) err[Fail] {
    if (place == 0) {
        var i: usize = 0;
        for (i < size) {
            if (held[i] != 0) { ret err[Fail].err{fail.valued(fail.unsupported("special slot hashes a blob the signature does not hold"), slot::i128)}; }
            i = i + 1;
        }
        ret sink.zeros(s, size);
    }
    val b: *CsBlob = table.at[CsBlob](?sig.blobs, table.nth[CsBlob]((place - 1)::usize));
    if (!identifies(slot::u64, b.magic)) {
        ret err[Fail].err{fail.valued(fail.unsupported("special slot holds a blob mink does not identify"), slot::i128)};
    }
    var enc: Sink      = sink.make(a, BIG);
    var w:   err[Fail] = write_blob(?enc, a, st, b);
    if (!(sel w.err)) { w = digest(s, h, size, sink.data(?enc), sink.len(?enc)); }
    val dropped: err[Fail] = sink.release(?enc);
    if (sel w.err) { ret w; }
    ret dropped;
}

# append the slots of `d`: its special slots from the blobs `sig` holds, then
# its code slots hashed over the `len` bytes of the image at `data`, or zeroes
# in their place when `data` is nil
fun slots(s: *Sink, a: *A.Allocator, st: *Store, sig: *Signature, d: *Directory, data: *u8, len: usize) err[Fail] {
    val n: res[u64, Fail] = slot_count(d);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    if (n.ok != d.n_code_slots::u64) {
        ret err[Fail].err{fail.in_record(fail.malformed("code directory states a count of code slots its code limit does not give"), "code directory")};
    }
    val sp: err[Fail] = special_slots(s, a, st, sig, d);
    if (sel sp.err)  { ret sp; }
    if (data != nil) { ret hash_pages(s, d, data, len); }
    val z: res[u64, Fail] = checked.mul(Location{}, n.ok, d.hash_size::u64);
    if (sel z.err) { ret err[Fail].err{z.err}; }
    ret sink.zeros(s, z.ok::usize);
}

# the signature `sig` encoded into `s` with the slots of every code directory
# made again, each in its own hash type: its special slots from the blobs `sig`
# holds and its code slots hashed over the `len` bytes of the image at `data`. a
# nil image sizes the signature with the code slots zeroed. the directories hold
# their own slots again when this returns
pub fun encode_signed(s: *Sink, a: *A.Allocator, st: *Store, sig: *Signature, data: *u8, len: usize) err[Fail] {
    var saved: Table[Held] = table.make[Held](a);
    var made:  Table[Sink] = table.make[Sink](a);
    var first: err[Fail]   = substitute(a, st, sig, ?saved, ?made, data, len);
    if (!(sel first.err)) { first = encode(s, a, st, sig); }
    restore(sig, ?saved);
    var i: usize = 0;
    for (i < table.count[Sink](?made)) {
        first = fail.kept(first, sink.release(table.at[Sink](?made, table.nth[Sink](i))));
        i     = i + 1;
    }
    first = fail.kept(first, table.release[Sink](?made));
    ret fail.kept(first, table.release[Held](?saved));
}

fun substitute(a: *A.Allocator, st: *Store, sig: *Signature, saved: *Table[Held], made: *Table[Sink], data: *u8, len: usize) err[Fail] {
    var i: usize = 0;
    for (i < table.count[CsBlob](?sig.blobs)) {
        val b: *CsBlob = table.at[CsBlob](?sig.blobs, table.nth[CsBlob](i));
        if (sel b.body.directory) {
            val d:  *Directory = ?b.body.directory;
            var hs: Sink       = sink.make(a, BIG);
            var w:  err[Fail]  = slots(?hs, a, st, sig, d, data, len);
            if (!(sel w.err) && data != nil) { w = remade(st, sig, d, ?hs); }
            if (sel w.err) {
                val dropped: err[Fail] = sink.release(?hs);
                ret err[Fail].err{fail.in_indexed(w.err, "signature blob", i::u64)};
            }
            val p1: res[Id[Sink], Fail] = table.push[Sink](made, hs);
            if (sel p1.err) {
                val dropped: err[Fail] = sink.release(?hs);
                ret err[Fail].err{p1.err};
            }
            val p2: res[Id[Held], Fail] = table.push[Held](saved, d.hashes);
            if (sel p2.err) { ret err[Fail].err{p2.err}; }
            val m: *Sink = table.at[Sink](made, p1.ok);
            d.hashes = Held.borrowed{Bytes{data: sink.data(m), len: sink.len(m)}};
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# whether the superblob holds a CMS signature that signs anything
fun signed(sig: *Signature) bool {
    var i: usize = 0;
    for (i < table.count[BlobIndex](?sig.index)) {
        val ix: *BlobIndex = table.at[BlobIndex](?sig.index, table.nth[BlobIndex](i));
        if (ix.type::u64 == tables.CSSLOT_SIGNATURESLOT.value && table.at[CsBlob](?sig.blobs, table.nth[CsBlob](i)).length::usize > BLOB_HEADER_SIZE) { ret true; }
        i = i + 1;
    }
    ret false;
}

# slots of `d` that differ from those it holds are refused where something mink
# does not make again covers them: the CMS signature or the pre-encryption hashes
fun remade(st: *Store, sig: *Signature, d: *Directory, made: *Sink) err[Fail] {
    val held: Bytes = store.bytes(st, ?d.hashes);
    if (held.len == sink.len(made) && same_bytes(held.data, sink.data(made), held.len)) { ret err[Fail].ok{}; }
    if (header_end(d.version) >= 96 && d.pre_encrypt_offset != 0) {
        ret err[Fail].err{fail.in_record(fail.unsupported("making pre-encryption hashes again is not supported"), "code directory")};
    }
    if (signed(sig)) { ret err[Fail].err{fail.in_record(fail.unsupported("re-signing a CMS signature is not supported"), "code directory")}; }
    ret err[Fail].ok{};
}

# give each directory the slots it held before they were substituted
fun restore(sig: *Signature, saved: *Table[Held]) {
    var done: usize = 0;
    var i:    usize = 0;
    for (done < table.count[Held](saved)) {
        val b: *CsBlob = table.at[CsBlob](?sig.blobs, table.nth[CsBlob](i));
        if (sel b.body.directory) {
            b.body.directory.hashes = @table.at[Held](saved, table.nth[Held](done));
            done                    = done + 1;
        }
        i = i + 1;
    }
}

fun same_bytes(p: *u8, q: *u8, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (p[i] != q[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_digest(s: *Sink, slot: usize, data: *u8, len: usize) bool {
    var want: [32]u8;
    sha256.hash(data, len, ?want[0]);
    ret same_bytes(?sink.data(s)[slot * 32], ?want[0], 32);
}

test signature__code_directory_hashes_a_partial_last_page {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    var image: [12000]u8;
    var i:     usize = 0;
    for (i < 12000) {
        image[i] = (i * 7 + 3)::u8;
        i        = i + 1;
    }
    var d: Directory = Directory{
        version:    tables.CS_SUPPORTSEXECSEG.value::u32,
        hash_size:  tables.CS_SHA256_LEN.value::u8,
        hash_type:  tables.CS_HASHTYPE_SHA256.value::u8,
        page_size:  12,
        code_limit: 10000,
    };
    val n: res[u64, Fail] = slot_count(?d);
    if (sel n.err) { ret 1; }
    if (n.ok != 3) { ret 1; }

    var s: Sink      = sink.make(a, BIG);
    val e: err[Fail] = hash_pages(?s, ?d, ?image[0], 12000);
    if (sel e.err)                               { ret 1; }
    if (sink.len(?s) != 96)                      { ret 1; }
    if (!same_digest(?s, 0, ?image[0], 4096))    { ret 1; }
    if (!same_digest(?s, 1, ?image[4096], 4096)) { ret 1; }
    if (!same_digest(?s, 2, ?image[8192], 1808)) { ret 1; }

    i = 10000;
    for (i < 12000) {
        image[i] = 0xff;
        i        = i + 1;
    }
    var again: Sink      = sink.make(a, BIG);
    val e2:    err[Fail] = hash_pages(?again, ?d, ?image[0], 12000);
    if (sel e2.err)             { ret 1; }
    if (sink.len(?again) != 96) { ret 1; }
    i = 0;
    for (i < 96) {
        if (sink.data(?s)[i] != sink.data(?again)[i]) { ret 1; }
        i = i + 1;
    }

    d.page_size = 0;
    val whole: res[u64, Fail] = slot_count(?d);
    if (sel whole.err) { ret 1; }
    if (whole.ok != 1) { ret 1; }

    val raw: [44]u8 = [44]u8{
        0xfa, 0xde, 0x0c, 0xc0, 0, 0, 0, 0x2c, 0, 0, 0, 1, 0, 0, 0, 2, 0, 0, 0, 0x14,
        0xfa, 0xde, 0x0c, 0x01, 0, 0, 0, 0x14, 0, 0, 0, 1, 0, 0, 0, 3, 0, 0, 1, 0,
        0xde, 0xad, 0xbe, 0xef,
    };
    var rd: Reader               = reader.make("t", ?raw[0], 44, LITTLE);
    val ds: res[Signature, Fail] = decode(a, ?rd);
    if (sel ds.err) { ret 1; }
    var sig: Signature = ds.ok;
    if (table.count[CsBlob](?sig.blobs) != 1 || table.count[Gap](?sig.gaps) != 1) { ret 1; }
    val first: *CsBlob = table.at[CsBlob](?sig.blobs, table.nth[CsBlob](0));
    if (!sel first.body.raw) { ret 1; }
    var st:  Store     = store.make(a);
    var out: Sink      = sink.make(a, LITTLE);
    val es:  err[Fail] = encode(?out, a, ?st, ?sig);
    if (sel es.err)           { ret 1; }
    if (sink.len(?out) != 44) { ret 1; }
    i = 0;
    for (i < 44) {
        if (sink.data(?out)[i] != raw[i]) { ret 1; }
        i = i + 1;
    }
    val q1: err[Fail] = model.release_signature(?sig);
    val q2: err[Fail] = store.release(?st);
    val q3: err[Fail] = sink.release(?out);

    val r1: err[Fail] = sink.release(?s);
    val r2: err[Fail] = sink.release(?again);
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

# a code directory of the earliest version, its identifier "x" and then its
# slots, whose hashes are the `(special + code) * size` bytes at `zero`
fun test_directory(a: *A.Allocator, kind: *Constant, size: u32, special: u32, code: u32, limit: u32, zero: *u8) CsBlob {
    val d: Directory = Directory{
        version:         0x20001,
        hash_offset:     46 + special * size,
        ident_offset:    44,
        n_special_slots: special,
        n_code_slots:    code,
        code_limit:      limit,
        hash_size:       size::u8,
        hash_type:       kind.value::u8,
        page_size:       12,
        ident:           Held.borrowed{Bytes{data: "x", len: 1}},
        hashes:          Held.borrowed{Bytes{data: zero, len: ((special + code) * size)::usize}},
        scatter:         table.make[Scatter](a),
    };
    ret CsBlob{magic: tables.CSMAGIC_CODEDIRECTORY.value::u32, length: 46 + (special + code) * size, body: CsBody.directory{d}};
}

# a superblob of `count` blobs laid end to end after its index
fun test_signature(a: *A.Allocator, types: *u32, blobs: *CsBlob, count: u32) res[Signature, Fail] {
    var sig: Signature = Signature{index: table.make[BlobIndex](a), blobs: table.make[CsBlob](a), gaps: table.make[Gap](a)};
    sig.magic = tables.CSMAGIC_EMBEDDED_SIGNATURE.value::u32;
    sig.count = count;
    var at: u32   = SUPER_HEADER_SIZE::u32 + count * INDEX_SIZE::u32;
    var i:  usize = 0;
    for (i < count::usize) {
        val x: res[Id[BlobIndex], Fail] = table.push[BlobIndex](?sig.index, BlobIndex{type: types[i], offset: at});
        val y: res[Id[CsBlob], Fail]    = table.push[CsBlob](?sig.blobs, blobs[i]);
        if (sel x.err || sel y.err) { ret res[Signature, Fail].err{release_sig(?sig, fail.malformed("test signature"))}; }
        at = at + blobs[i].length;
        i  = i + 1;
    }
    sig.length = at;
    ret res[Signature, Fail].ok{sig};
}

test signature__sha1_code_slots_are_recomputed {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    var image: [10000]u8;
    var i:     usize = 0;
    for (i < 10000) {
        image[i] = (i * 13 + 5)::u8;
        i        = i + 1;
    }
    var d: Directory = Directory{
        version:    tables.CS_SUPPORTSEXECSEG.value::u32,
        hash_size:  tables.CS_SHA1_LEN.value::u8,
        hash_type:  tables.CS_HASHTYPE_SHA1.value::u8,
        page_size:  12,
        code_limit: 10000,
    };
    var s: Sink      = sink.make(a, BIG);
    val e: err[Fail] = hash_pages(?s, ?d, ?image[0], 10000);
    if (sel e.err)          { ret 1; }
    if (sink.len(?s) != 60) { ret 1; }
    var want: [20]u8;
    var page: usize = 0;
    for (page < 3) {
        var n: usize = 4096;
        if (page == 2) { n = 10000 - 8192; }
        sha1.hash(?image[page * 4096], n, ?want[0]);
        if (!same_bytes(?sink.data(?s)[page * 20], ?want[0], 20)) { ret 1; }
        page = page + 1;
    }

    val r: err[Fail] = sink.release(?s);
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test signature__every_code_directory_is_recomputed_in_its_own_hash_type {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    var image: [10000]u8;
    var i:     usize = 0;
    for (i < 10000) {
        image[i] = (i * 7 + 3)::u8;
        i        = i + 1;
    }
    var zero:  [96]u8;
    val types: [2]u32    = [2]u32{tables.CSSLOT_CODEDIRECTORY.value::u32, tables.CSSLOT_ALTERNATE_CODEDIRECTORIES.value::u32};
    var blobs: [2]CsBlob = [2]CsBlob{
        test_directory(a, ?tables.CS_HASHTYPE_SHA1, 20, 0, 3, 10000, ?zero[0]),
        test_directory(a, ?tables.CS_HASHTYPE_SHA256, 32, 0, 3, 10000, ?zero[0]),
    };
    val built: res[Signature, Fail] = test_signature(a, ?types[0], ?blobs[0], 2);
    if (sel built.err) { ret 1; }
    var sig: Signature = built.ok;
    var st:  Store     = store.make(a);
    var out: Sink      = sink.make(a, LITTLE);
    val e:   err[Fail] = encode_signed(?out, a, ?st, ?sig, ?image[0], 10000);
    if (sel e.err) { ret 1; }

    var rd:    Reader               = reader.make("t", sink.data(?out), sink.len(?out), LITTLE);
    val again: res[Signature, Fail] = decode(a, ?rd);
    if (sel again.err) { ret 1; }
    var back:   Signature = again.ok;
    val widths: [2]usize  = [2]usize{20, 32};
    var b:      usize     = 0;
    for (b < 2) {
        val blob: *CsBlob = table.at[CsBlob](?back.blobs, table.nth[CsBlob](b));
        if (!sel blob.body.directory) { ret 1; }
        val got: Bytes = store.bytes(?st, ?blob.body.directory.hashes);
        if (got.len != 3 * widths[b]) { ret 1; }
        var page: usize = 0;
        for (page < 3) {
            var n: usize = 4096;
            if (page == 2) { n = 10000 - 8192; }
            var want: [32]u8;
            if (b == 0)                                                        { sha1.hash(?image[page * 4096], n, ?want[0]); }
            or                                                                 { sha256.hash(?image[page * 4096], n, ?want[0]); }
            if (!same_bytes(?got.data[page * widths[b]], ?want[0], widths[b])) { ret 1; }
            page = page + 1;
        }
        b = b + 1;
    }

    val q1: err[Fail] = model.release_signature(?back);
    val q2: err[Fail] = model.release_signature(?sig);
    val q3: err[Fail] = store.release(?st);
    val q4: err[Fail] = sink.release(?out);
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test signature__special_slot_is_recomputed_after_its_blob_changes {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    var zero:  [160]u8;
    val first: [12]u8    = [12]u8{0xfa, 0xde, 0x71, 0x71, 0, 0, 0, 12, '<', 'a', '/', '>'};
    val later: [12]u8    = [12]u8{0xfa, 0xde, 0x71, 0x71, 0, 0, 0, 12, '<', 'b', '/', '>'};
    val types: [2]u32    = [2]u32{tables.CSSLOT_CODEDIRECTORY.value::u32, tables.CSSLOT_ENTITLEMENTS.value::u32};
    var blobs: [2]CsBlob = [2]CsBlob{
        test_directory(a, ?tables.CS_HASHTYPE_SHA256, 32, 5, 0, 0, ?zero[0]),
        CsBlob{magic: tables.CSMAGIC_EMBEDDED_ENTITLEMENTS.value::u32, length: 12, body: CsBody.entitlements{Held.borrowed{Bytes{data: ?first[8], len: 4}}}},
    };
    val built: res[Signature, Fail] = test_signature(a, ?types[0], ?blobs[0], 2);
    if (sel built.err) { ret 1; }
    var sig:   Signature = built.ok;
    var st:    Store     = store.make(a);
    var want:  [32]u8;
    var round: usize     = 0;
    for (round < 2) {
        if (round == 1) {
            table.at[CsBlob](?sig.blobs, table.nth[CsBlob](1)).body = CsBody.entitlements{Held.borrowed{Bytes{data: ?later[8], len: 4}}};
            sha256.hash(?later[0], 12, ?want[0]);
        }
        or {
            sha256.hash(?first[0], 12, ?want[0]);
        }
        var out: Sink      = sink.make(a, BIG);
        val e:   err[Fail] = encode_signed(?out, a, ?st, ?sig, nil, 0);
        if (sel e.err) { ret 1; }
        # the slots begin after the superblob's head and the directory's identifier
        val slots_at: usize = 28 + 46;
        if (!same_bytes(?sink.data(?out)[slots_at], ?want[0], 32))       { ret 1; }
        if (!same_bytes(?sink.data(?out)[slots_at + 32], ?zero[0], 128)) { ret 1; }
        val r: err[Fail] = sink.release(?out);
        round = round + 1;
    }

    val q1: err[Fail] = model.release_signature(?sig);
    val q2: err[Fail] = store.release(?st);
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test signature__changed_slots_under_a_cms_signature_are_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    var image: [100]u8;
    var i:     usize = 0;
    for (i < 100) {
        image[i] = (i * 3 + 1)::u8;
        i        = i + 1;
    }
    var zero:  [32]u8;
    val cms:   [4]u8     = [4]u8{0x30, 0x80, 0x06, 0x09};
    val types: [2]u32    = [2]u32{tables.CSSLOT_CODEDIRECTORY.value::u32, tables.CSSLOT_SIGNATURESLOT.value::u32};
    var blobs: [2]CsBlob = [2]CsBlob{
        test_directory(a, ?tables.CS_HASHTYPE_SHA256, 32, 0, 1, 100, ?zero[0]),
        CsBlob{magic: tables.CSMAGIC_BLOBWRAPPER.value::u32, length: 12, body: CsBody.wrapper{Held.borrowed{Bytes{data: ?cms[0], len: 4}}}},
    };
    val built: res[Signature, Fail] = test_signature(a, ?types[0], ?blobs[0], 2);
    if (sel built.err) { ret 1; }
    var sig: Signature = built.ok;
    var st:  Store     = store.make(a);
    var out: Sink      = sink.make(a, BIG);
    val e:   err[Fail] = encode_signed(?out, a, ?st, ?sig, ?image[0], 100);
    if (!(sel e.err))                   { ret 1; }
    if (!(sel e.err.cause.unsupported)) { ret 1; }
    if (sink.len(?out) != 0)            { ret 1; }
    val d: *CsBlob = table.at[CsBlob](?sig.blobs, table.nth[CsBlob](0));
    if (!sel d.body.directory) { ret 1; }
    val kept: Bytes = store.bytes(?st, ?d.body.directory.hashes);
    if (kept.data != ?zero[0] || kept.len != 32) { ret 1; }

    val q1: err[Fail] = model.release_signature(?sig);
    val q2: err[Fail] = store.release(?st);
    val q3: err[Fail] = sink.release(?out);
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
