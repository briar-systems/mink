# the code signature superblob of LC_CODE_SIGNATURE
#
# a superblob is a blob index and the blobs it names. the decoder reads the
# code directory, the requirements and the plain blobs into entries, and holds
# every byte string they point at borrowed from the payload. the encoder writes
# each part at the offset the entries state, zero between, so a signature comes
# back byte for byte. a signature holding bytes no field covers is refused,
# since the entries could not give them back. everything in a signature is big
# endian whatever the image is, so both codecs take the byte order from here.
#
# code slot hashes are digests of each page of the image up to the code limit,
# the page size read from the directory and the last page only as long as the
# image is. special slot hashes are digests of the blobs the superblob holds,
# by slot. each directory hashes in its own type, a row of the hash types.

use crypto.hash.sha256;
use crypto.hash.sha512;
use std.collections.vector;
use std.collections.vector.Vector;
use std.compat.sha1;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.sort;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Raw;
use mink.base.store.Store;
use mink.base.store.Why;
use mink.base.vectors;
use mink.bytes.reader;
use mink.bytes.reader.BIG;
use mink.bytes.reader.Order;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.macho.model.cover;
use mink.format.macho.model.cover.Cover;
use mink.format.macho.model.model;
use mink.format.macho.model.model.BlobIndex;
use mink.format.macho.model.model.CsBlob;
use mink.format.macho.model.model.CsBody;
use mink.format.macho.model.model.Directory;
use mink.format.macho.model.model.Gap;
use mink.format.macho.model.model.Requirements;
use mink.format.macho.model.model.Scatter;
use mink.format.macho.model.model.Signature;
use mink.format.macho.model.tables;
use mink.format.macho.model.tables.Constant;

# the width of a blob's magic and length
pub val BLOB_HEADER_SIZE: usize = 8;

# the width of a superblob's magic, length and count
pub val SUPER_HEADER_SIZE: usize = 12;

# the width of a blob index entry and of a scatter entry
pub val INDEX_SIZE:   usize = 8;
val     SCATTER_SIZE: usize = 24;

# the bytes a code directory takes from its magic, by version
# ---
# since: the version that added the fields, nil for the first
# end:   where the fields end
rec Step {
    since: *Constant;
    end:   u64;
}

val STEP_COUNT: usize = 7;

val STEPS: [STEP_COUNT]Step = [STEP_COUNT]Step{
    Step{since: nil, end: 44},
    Step{since: ?tables.CS_SUPPORTSSCATTER, end: 48},
    Step{since: ?tables.CS_SUPPORTSTEAMID, end: 52},
    Step{since: ?tables.CS_SUPPORTSCODELIMIT64, end: 64},
    Step{since: ?tables.CS_SUPPORTSEXECSEG, end: 88},
    Step{since: ?tables.CS_SUPPORTSRUNTIME, end: 96},
    Step{since: ?tables.CS_SUPPORTSLINKAGE, end: 108},
};

# where the fields of a directory of `version` end
pub fun header_end(version: u32) u64 {
    var end: u64   = STEPS[0].end;
    var i:   usize = 1;
    for (i < STEP_COUNT) {
        if (version::u64 >= STEPS[i].since.value) { end = STEPS[i].end; }
        i = i + 1;
    }
    ret end;
}

fun at_here(f: Fail, r: *Reader) Fail {
    ret fail.at_offset(fail.in_file(f, r.file), reader.offset(r));
}

fun is(magic: u32, c: *Constant) bool {
    ret magic::u64 == c.value;
}

fun held(r: *Reader, start: usize, n: usize) Held {
    if (n == 0) { ret Held.borrowed{Bytes{data: nil, len: 0}}; }
    ret Held.borrowed{Bytes{data: ?r.data[start], len: n}};
}

fun signature_dnit(s: *Signature, f: Fail) Fail {
    val err_dropped: err[Fail] = model.signature_dnit(s);
    ret f;
}

# the signature the reader spans, which starts at the superblob's magic. `a`
# holds its tables
pub fun decode(a: *A.Allocator, r: *Reader) res[Signature, Fail] {
    var sig: Signature = Signature{index: vector.init[BlobIndex](a), blobs: vector.init[CsBlob](a), gaps: vector.init[Gap](a)};
    var be:  Reader    = @r;
    be.order = BIG;
    var cv:      Cover     = cover.init(a);
    val err_ran: err[Fail] = cover.settle(?cv, run(a, ?sig, ?be, ?cv));
    if (sel err_ran.err) { ret res[Signature, Fail].err{signature_dnit(?sig, err_ran.err)}; }
    ret res[Signature, Fail].ok{sig};
}

fun run(a: *A.Allocator, sig: *Signature, r: *Reader, cv: *Cover) err[Fail] {
    val res_seek: res[usize, Fail] = reader.seek(r, 0);
    if (sel res_seek.err) { ret err[Fail].err{res_seek.err}; }
    val res_magic: res[u32, Fail] = reader.u32(r);
    if (sel res_magic.err) { ret err[Fail].err{res_magic.err}; }
    if (!is(res_magic.ok, ?tables.CSMAGIC_EMBEDDED_SIGNATURE)) {
        ret err[Fail].err{at_here(fail.unsupported("superblob is not an embedded signature"), r)};
    }
    val res_length: res[u32, Fail] = reader.u32(r);
    if (sel res_length.err) { ret err[Fail].err{res_length.err}; }
    val res_count: res[u32, Fail] = reader.u32(r);
    if (sel res_count.err) { ret err[Fail].err{res_count.err}; }
    sig.magic  = res_magic.ok;
    sig.length = res_length.ok;
    sig.count  = res_count.ok;
    if (res_length.ok::usize > r.len || res_length.ok::usize < SUPER_HEADER_SIZE) {
        ret err[Fail].err{at_here(fail.malformed("superblob length lies outside the payload"), r)};
    }
    if (res_count.ok::usize > (res_length.ok::usize - SUPER_HEADER_SIZE) / INDEX_SIZE) {
        ret err[Fail].err{at_here(fail.truncated("blob index lies outside the superblob"), r)};
    }
    var i: usize = 0;
    for (i < res_count.ok::usize) {
        val res_kind: res[u32, Fail] = reader.u32(r);
        if (sel res_kind.err) { ret err[Fail].err{res_kind.err}; }
        val res_off: res[u32, Fail] = reader.u32(r);
        if (sel res_off.err) { ret err[Fail].err{res_off.err}; }
        val err_index_pushed: err[Fail] = vectors.push[BlobIndex](?sig.index, BlobIndex{type: res_kind.ok, offset: res_off.ok});
        if (sel err_index_pushed.err) { ret err[Fail].err{err_index_pushed.err}; }
        i = i + 1;
    }
    var span:    Reader            = @r;
    val res_sub: res[Reader, Fail] = reader.sub(r, 0, res_length.ok::u64);
    if (sel res_sub.err) { ret err[Fail].err{res_sub.err}; }
    span = res_sub.ok;
    val err_head: err[Fail] = cover.add(cv, reader.here(r), 0, (SUPER_HEADER_SIZE + res_count.ok::usize * INDEX_SIZE)::u64);
    if (sel err_head.err) { ret err_head; }
    i = 0;
    for (i < res_count.ok::usize) {
        val ix:              *BlobIndex        = ?sig.index.data[i];
        val res_decode_blob: res[CsBlob, Fail] = decode_blob(a, ?span, ix.offset::u64);
        if (sel res_decode_blob.err) { ret err[Fail].err{fail.in_indexed(res_decode_blob.err, "signature blob", i::u64)}; }
        val err_here_added: err[Fail] = cover.add(cv, reader.here(r), ix.offset::u64, res_decode_blob.ok.length::u64);
        if (sel err_here_added.err) { ret err_here_added; }
        val err_blobs_pushed: err[Fail] = vectors.push[CsBlob](?sig.blobs, res_decode_blob.ok);
        if (sel err_blobs_pushed.err) {
            val err_dropped: err[Fail] = body_dnit(?res_decode_blob.ok.body);
            ret err[Fail].err{err_blobs_pushed.err};
        }
        i = i + 1;
    }
    ret collect_gaps(cv, ?span, sig);
}

# the stretches between the covered ones that hold any byte but zero become gaps
fun collect_gaps(cv: *Cover, r: *Reader, sig: *Signature) err[Fail] {
    val ranges: *cover.Range = cv.ranges.data;
    val count:  usize        = vector.length[cover.Range](?cv.ranges);
    var at:     u64          = 0;
    var i:      usize        = 0;
    for (i <= count) {
        var stop: u64 = r.len::u64;
        if (i < count) { stop = ranges[i].start; }
        if (stop < at) {
            ret err[Fail].err{fail.at_offset(fail.in_file(fail.unsupported("parts of the signature overlap"), r.file), r.base + stop)};
        }
        var used: bool = false;
        var k:    u64  = at;
        for (k < stop) {
            if (r.data[k::usize] != 0) { used = true; }
            k = k + 1;
        }
        if (used) {
            val err_gaps_pushed: err[Fail] = vectors.push[Gap](?sig.gaps, Gap{at: at, bytes: held(r, at::usize, (stop - at)::usize)});
            if (sel err_gaps_pushed.err) { ret err[Fail].err{err_gaps_pushed.err}; }
        }
        if (i < count) { at = ranges[i].end; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun body_dnit(b: *CsBody) err[Fail] {
    if (sel b.directory) { ret vectors.dnit[Scatter](?b.directory.scatter); }
    if (sel b.requirements) {
        val err_release:       err[Fail] = vectors.dnit[BlobIndex](?b.requirements.index);
        val err_release_items: err[Fail] = vectors.dnit[Held](?b.requirements.items);
        if (sel err_release.err) { ret err_release; }
        ret err_release_items;
    }
    ret err[Fail].ok{};
}

# the blob at `pos` of the superblob `r` spans
fun decode_blob(a: *A.Allocator, r: *Reader, pos: u64) res[CsBlob, Fail] {
    val res_head: res[Reader, Fail] = reader.sub(r, pos, BLOB_HEADER_SIZE::u64);
    if (sel res_head.err) { ret res[CsBlob, Fail].err{res_head.err}; }
    var h:          Reader         = res_head.ok;
    val res_magic:  res[u32, Fail] = reader.u32(?h);
    val res_length: res[u32, Fail] = reader.u32(?h);
    if (sel res_magic.err)  { ret res[CsBlob, Fail].err{res_magic.err}; }
    if (sel res_length.err) { ret res[CsBlob, Fail].err{res_length.err}; }
    if (res_length.ok::usize < BLOB_HEADER_SIZE) {
        ret res[CsBlob, Fail].err{at_here(fail.malformed("blob is shorter than its header"), ?h)};
    }
    val res_whole: res[Reader, Fail] = reader.sub(r, pos, res_length.ok::u64);
    if (sel res_whole.err) { ret res[CsBlob, Fail].err{res_whole.err}; }
    var w:           Reader           = res_whole.ok;
    val res_skipped: res[usize, Fail] = reader.seek(?w, BLOB_HEADER_SIZE::u64);
    if (sel res_skipped.err) { ret res[CsBlob, Fail].err{res_skipped.err}; }
    var out: CsBlob = CsBlob{magic: res_magic.ok, length: res_length.ok};
    if (is(res_magic.ok, ?tables.CSMAGIC_CODEDIRECTORY)) {
        val res_decode_directory: res[Directory, Fail] = decode_directory(a, ?w);
        if (sel res_decode_directory.err) {
            if (fail.is_refused(res_decode_directory.err)) { ret res[CsBlob, Fail].err{res_decode_directory.err}; }
            out.body = raw_body(?w, Why.unsupported{});
        }
        or (sel res_decode_directory.ok) {
            out.body = CsBody.directory{res_decode_directory.ok};
        }
    }
    or (is(res_magic.ok, ?tables.CSMAGIC_REQUIREMENTS)) {
        val res_decode_requirements: res[Requirements, Fail] = decode_requirements(a, ?w);
        if (sel res_decode_requirements.err) {
            if (fail.is_refused(res_decode_requirements.err)) { ret res[CsBlob, Fail].err{res_decode_requirements.err}; }
            out.body = raw_body(?w, Why.unsupported{});
        }
        or (sel res_decode_requirements.ok) {
            out.body = CsBody.requirements{res_decode_requirements.ok};
        }
    }
    or (is(res_magic.ok, ?tables.CSMAGIC_EMBEDDED_ENTITLEMENTS)) {
        out.body = CsBody.entitlements{held(?w, BLOB_HEADER_SIZE, w.len - BLOB_HEADER_SIZE)};
    }
    or (is(res_magic.ok, ?tables.CSMAGIC_EMBEDDED_DER_ENTITLEMENTS)) {
        out.body = CsBody.der_entitlements{held(?w, BLOB_HEADER_SIZE, w.len - BLOB_HEADER_SIZE)};
    }
    or (is(res_magic.ok, ?tables.CSMAGIC_BLOBWRAPPER)) {
        out.body = CsBody.wrapper{held(?w, BLOB_HEADER_SIZE, w.len - BLOB_HEADER_SIZE)};
    }
    or (is(res_magic.ok, ?tables.CSMAGIC_EMBEDDED_LAUNCH_CONSTRAINT)) {
        out.body = CsBody.constraint{held(?w, BLOB_HEADER_SIZE, w.len - BLOB_HEADER_SIZE)};
    }
    or {
        out.body = raw_body(?w, Why.opaque{});
    }
    if (sel out.body.directory || sel out.body.requirements) {
        val res_same: res[bool, Fail] = reproduces(a, ?out, ?w);
        if (sel res_same.err) { ret res[CsBlob, Fail].err{res_same.err}; }
        if (!res_same.ok) {
            val err_dropped: err[Fail] = body_dnit(?out.body);
            out.body = raw_body(?w, Why.irreproducible{});
        }
    }
    ret res[CsBlob, Fail].ok{out};
}

fun raw_body(w: *Reader, why: Why) CsBody {
    ret CsBody.raw{Raw{bytes: held(w, BLOB_HEADER_SIZE, w.len - BLOB_HEADER_SIZE), why: why}};
}

# whether encoding the blob gives the bytes of `w`, which spans it whole
fun reproduces(a: *A.Allocator, b: *CsBlob, w: *Reader) res[bool, Fail] {
    var s:              Sink      = sink.init(a, BIG);
    var st:             Store     = store.init(a);
    val err_write_blob: err[Fail] = write_blob(?s, a, ?st, b);
    var same:           bool      = !(sel err_write_blob.err) && sink.len(?s) == w.len;
    var i:              usize     = 0;
    for (same && i < w.len) {
        same = sink.data(?s)[i] == w.data[i];
        i    = i + 1;
    }
    val err_release:        err[Fail] = sink.dnit(?s);
    val err_store_released: err[Fail] = store.dnit(?st);
    if (sel err_write_blob.err) {
        if (fail.is_refused(err_write_blob.err)) { ret res[bool, Fail].err{err_write_blob.err}; }
    }
    if (sel err_release.err)        { ret res[bool, Fail].err{err_release.err}; }
    if (sel err_store_released.err) { ret res[bool, Fail].err{err_store_released.err}; }
    ret res[bool, Fail].ok{same};
}

fun cstring(r: *Reader, pos: u64, out: *Held, c: *Cover) err[Fail] {
    if (pos >= r.len::u64) { ret err[Fail].err{at_here(fail.truncated("string lies outside the blob"), r)}; }
    var i: usize = pos::usize;
    for (i < r.len && r.data[i] != 0) { i = i + 1; }
    if (i >= r.len) { ret err[Fail].err{at_here(fail.truncated("string is not terminated"), r)}; }
    @out = held(r, pos::usize, i - pos::usize);
    ret cover.add(c, reader.here(r), pos, (i - pos::usize + 1)::u64);
}

# `n` hashes of `size` bytes at `pos`
fun hashes(r: *Reader, c: *Cover, pos: u64, count: u64, size: u64, out: *Held) err[Fail] {
    val res_len: res[u64, Fail] = checked.mul(reader.here(r), count, size);
    if (sel res_len.err) { ret err[Fail].err{res_len.err}; }
    val res_end: res[u64, Fail] = checked.add(reader.here(r), pos, res_len.ok);
    if (sel res_end.err)         { ret err[Fail].err{res_end.err}; }
    if (res_end.ok > r.len::u64) { ret err[Fail].err{at_here(fail.truncated("hashes lie outside the blob"), r)}; }
    @out = held(r, pos::usize, res_len.ok::usize);
    ret cover.add(c, reader.here(r), pos, res_len.ok);
}

fun read_u32(r: *Reader, out: *u32) err[Fail] {
    val res_u32: res[u32, Fail] = reader.u32(r);
    if (sel res_u32.err) { ret err[Fail].err{res_u32.err}; }
    @out = res_u32.ok;
    ret err[Fail].ok{};
}

fun read_u8(r: *Reader, out: *u8) err[Fail] {
    val res_u8: res[u8, Fail] = reader.u8(r);
    if (sel res_u8.err) { ret err[Fail].err{res_u8.err}; }
    @out = res_u8.ok;
    ret err[Fail].ok{};
}

fun read_u64(r: *Reader, out: *u64) err[Fail] {
    val res_u64: res[u64, Fail] = reader.u64(r);
    if (sel res_u64.err) { ret err[Fail].err{res_u64.err}; }
    @out = res_u64.ok;
    ret err[Fail].ok{};
}

# the code directory in the blob `r` spans, after its magic and length
fun decode_directory(a: *A.Allocator, r: *Reader) res[Directory, Fail] {
    var d: Directory;
    d.scatter = vector.init[Scatter](a);
    var cv:      Cover     = cover.init(a);
    val err_ran: err[Fail] = cover.settle(?cv, run_directory(?d, r, ?cv));
    if (sel err_ran.err) {
        val err_dropped: err[Fail] = vectors.dnit[Scatter](?d.scatter);
        ret res[Directory, Fail].err{err_ran.err};
    }
    ret res[Directory, Fail].ok{d};
}

fun run_directory(d: *Directory, r: *Reader, cv: *Cover) err[Fail] {
    val err_ver: err[Fail] = read_u32(r, ?d.version);
    if (sel err_ver.err) { ret err_ver; }
    val end: u64 = header_end(d.version);
    if (d.version::u64 > tables.CS_SUPPORTSLINKAGE.value) {
        ret err[Fail].err{at_here(fail.unsupported("code directory is newer than the revision mink implements"), r)};
    }
    if (end > r.len::u64) { ret err[Fail].err{at_here(fail.truncated("code directory header lies outside its blob"), r)}; }
    val words: [6]*u32 = [6]*u32{?d.flags, ?d.hash_offset, ?d.ident_offset, ?d.n_special_slots, ?d.n_code_slots, ?d.code_limit};
    var i:     usize   = 0;
    for (i < 6) {
        val err_read_u32: err[Fail] = read_u32(r, words[i]);
        if (sel err_read_u32.err) { ret err_read_u32; }
        i = i + 1;
    }
    val bytes: [4]*u8 = [4]*u8{?d.hash_size, ?d.hash_type, ?d.platform, ?d.page_size};
    i = 0;
    for (i < 4) {
        val err_read_u8: err[Fail] = read_u8(r, bytes[i]);
        if (sel err_read_u8.err) { ret err_read_u8; }
        i = i + 1;
    }
    val err_spare2: err[Fail] = read_u32(r, ?d.spare2);
    if (sel err_spare2.err) { ret err_spare2; }
    if (end >= 48) {
        val err_read_u32: err[Fail] = read_u32(r, ?d.scatter_offset);
        if (sel err_read_u32.err) { ret err_read_u32; }
    }
    if (end >= 52) {
        val err_read_u32: err[Fail] = read_u32(r, ?d.team_offset);
        if (sel err_read_u32.err) { ret err_read_u32; }
    }
    if (end >= 64) {
        val err_read_u32: err[Fail] = read_u32(r, ?d.spare3);
        if (sel err_read_u32.err) { ret err_read_u32; }
        val err_read_u64: err[Fail] = read_u64(r, ?d.code_limit64);
        if (sel err_read_u64.err) { ret err_read_u64; }
    }
    if (end >= 88) {
        val err_read_u64: err[Fail] = read_u64(r, ?d.exec_seg_base);
        if (sel err_read_u64.err) { ret err_read_u64; }
        val err_read_u64_exec_seg_limit: err[Fail] = read_u64(r, ?d.exec_seg_limit);
        if (sel err_read_u64_exec_seg_limit.err) { ret err_read_u64_exec_seg_limit; }
        val err_read_u64_exec_seg_flags: err[Fail] = read_u64(r, ?d.exec_seg_flags);
        if (sel err_read_u64_exec_seg_flags.err) { ret err_read_u64_exec_seg_flags; }
    }
    if (end >= 96) {
        val err_read_u32: err[Fail] = read_u32(r, ?d.runtime);
        if (sel err_read_u32.err) { ret err_read_u32; }
        val err_read_u32_pre_encrypt_offset: err[Fail] = read_u32(r, ?d.pre_encrypt_offset);
        if (sel err_read_u32_pre_encrypt_offset.err) { ret err_read_u32_pre_encrypt_offset; }
    }
    if (end >= 108) {
        val err_read_u8: err[Fail] = read_u8(r, ?d.linkage_hash_type);
        if (sel err_read_u8.err) { ret err_read_u8; }
        val err_read_u8_linkage_application_type: err[Fail] = read_u8(r, ?d.linkage_application_type);
        if (sel err_read_u8_linkage_application_type.err) { ret err_read_u8_linkage_application_type; }
        val res_u16: res[u16, Fail] = reader.u16(r);
        if (sel res_u16.err) { ret err[Fail].err{res_u16.err}; }
        d.linkage_application_subtype = res_u16.ok;
        val err_read_u32: err[Fail] = read_u32(r, ?d.linkage_offset);
        if (sel err_read_u32.err) { ret err_read_u32; }
        val err_read_u32_linkage_size: err[Fail] = read_u32(r, ?d.linkage_size);
        if (sel err_read_u32_linkage_size.err) { ret err_read_u32_linkage_size; }
    }
    val err_head: err[Fail] = cover.add(cv, reader.here(r), 0, end);
    if (sel err_head.err) { ret err_head; }
    val err_ident: err[Fail] = cstring(r, d.ident_offset::u64, ?d.ident, cv);
    if (sel err_ident.err) { ret err_ident; }
    if (end >= 52 && d.team_offset != 0) {
        val err_cstring: err[Fail] = cstring(r, d.team_offset::u64, ?d.team, cv);
        if (sel err_cstring.err) { ret err_cstring; }
    }
    val res_first: res[u64, Fail] = checked.mul(reader.here(r), d.n_special_slots::u64, d.hash_size::u64);
    if (sel res_first.err) { ret err[Fail].err{res_first.err}; }
    val res_start: res[u64, Fail] = checked.sub(reader.here(r), d.hash_offset::u64, res_first.ok);
    if (sel res_start.err) { ret err[Fail].err{res_start.err}; }
    val res_total: res[u64, Fail] = checked.add(reader.here(r), d.n_special_slots::u64, d.n_code_slots::u64);
    if (sel res_total.err) { ret err[Fail].err{res_total.err}; }
    val err_hashes: err[Fail] = hashes(r, cv, res_start.ok, res_total.ok, d.hash_size::u64, ?d.hashes);
    if (sel err_hashes.err) { ret err_hashes; }
    if (end >= 48 && d.scatter_offset != 0) {
        val err_decode_scatter: err[Fail] = decode_scatter(r, d, cv);
        if (sel err_decode_scatter.err) { ret err_decode_scatter; }
    }
    if (end >= 96 && d.pre_encrypt_offset != 0) {
        val err_hashes: err[Fail] = hashes(r, cv, d.pre_encrypt_offset::u64, d.n_code_slots::u64, d.hash_size::u64, ?d.pre_encrypt);
        if (sel err_hashes.err) { ret err_hashes; }
    }
    if (end >= 108 && d.linkage_offset != 0) {
        val err_hashes: err[Fail] = hashes(r, cv, d.linkage_offset::u64, d.linkage_size::u64, 1, ?d.linkage);
        if (sel err_hashes.err) { ret err_hashes; }
    }
    ret cover.check(cv, r);
}

# the scatter vector, whose zero count ends it
fun decode_scatter(r: *Reader, d: *Directory, cv: *Cover) err[Fail] {
    val res_seek: res[usize, Fail] = reader.seek(r, d.scatter_offset::u64);
    if (sel res_seek.err) { ret err[Fail].err{res_seek.err}; }
    var n: u64 = 0;
    for {
        val res_count: res[u32, Fail] = reader.u32(r);
        if (sel res_count.err) { ret err[Fail].err{res_count.err}; }
        val res_base: res[u32, Fail] = reader.u32(r);
        if (sel res_base.err) { ret err[Fail].err{res_base.err}; }
        val res_target: res[u64, Fail] = reader.u64(r);
        if (sel res_target.err) { ret err[Fail].err{res_target.err}; }
        val res_spare: res[u64, Fail] = reader.u64(r);
        if (sel res_spare.err) { ret err[Fail].err{res_spare.err}; }
        n = n + 1;
        if (res_count.ok == 0) { brk; }
        val err_scatter_pushed: err[Fail] = vectors.push[Scatter](?d.scatter, Scatter{count: res_count.ok, base: res_base.ok, target_offset: res_target.ok, spare: res_spare.ok});
        if (sel err_scatter_pushed.err) { ret err[Fail].err{err_scatter_pushed.err}; }
    }
    ret cover.add(cv, reader.here(r), d.scatter_offset::u64, n * SCATTER_SIZE::u64);
}

fun decode_requirements(a: *A.Allocator, r: *Reader) res[Requirements, Fail] {
    var q:       Requirements = Requirements{index: vector.init[BlobIndex](a), items: vector.init[Held](a)};
    var cv:      Cover        = cover.init(a);
    val err_ran: err[Fail]    = cover.settle(?cv, run_requirements(?q, r, ?cv));
    if (sel err_ran.err) {
        val err_release:       err[Fail] = vectors.dnit[BlobIndex](?q.index);
        val err_release_items: err[Fail] = vectors.dnit[Held](?q.items);
        ret res[Requirements, Fail].err{err_ran.err};
    }
    ret res[Requirements, Fail].ok{q};
}

fun run_requirements(q: *Requirements, r: *Reader, cv: *Cover) err[Fail] {
    val err_count: err[Fail] = read_u32(r, ?q.count);
    if (sel err_count.err) { ret err_count; }
    if (q.count::usize > (r.len - r.pos) / INDEX_SIZE) {
        ret err[Fail].err{at_here(fail.truncated("requirement index lies outside the blob"), r)};
    }
    var i: usize = 0;
    for (i < q.count::usize) {
        val res_kind: res[u32, Fail] = reader.u32(r);
        if (sel res_kind.err) { ret err[Fail].err{res_kind.err}; }
        val res_off: res[u32, Fail] = reader.u32(r);
        if (sel res_off.err) { ret err[Fail].err{res_off.err}; }
        val err_index_pushed: err[Fail] = vectors.push[BlobIndex](?q.index, BlobIndex{type: res_kind.ok, offset: res_off.ok});
        if (sel err_index_pushed.err) { ret err[Fail].err{err_index_pushed.err}; }
        i = i + 1;
    }
    val err_top: err[Fail] = cover.add(cv, reader.here(r), 0, (BLOB_HEADER_SIZE + 4 + q.count::usize * INDEX_SIZE)::u64);
    if (sel err_top.err) { ret err_top; }
    i = 0;
    for (i < q.count::usize) {
        val pos:      u64               = q.index.data[i].offset::u64;
        val res_head: res[Reader, Fail] = reader.sub(r, pos, BLOB_HEADER_SIZE::u64);
        if (sel res_head.err) { ret err[Fail].err{res_head.err}; }
        var h:          Reader         = res_head.ok;
        val res_magic:  res[u32, Fail] = reader.u32(?h);
        val res_length: res[u32, Fail] = reader.u32(?h);
        if (sel res_magic.err)  { ret err[Fail].err{res_magic.err}; }
        if (sel res_length.err) { ret err[Fail].err{res_length.err}; }
        if (res_length.ok::usize < BLOB_HEADER_SIZE || pos > r.len::u64 || res_length.ok::u64 > r.len::u64 - pos) {
            ret err[Fail].err{at_here(fail.malformed("requirement lies outside its blob"), ?h)};
        }
        val err_here_added: err[Fail] = cover.add(cv, reader.here(r), pos, res_length.ok::u64);
        if (sel err_here_added.err) { ret err_here_added; }
        val err_items_pushed: err[Fail] = vectors.push[Held](?q.items, held(r, pos::usize, res_length.ok::usize));
        if (sel err_items_pushed.err) { ret err[Fail].err{err_items_pushed.err}; }
        i = i + 1;
    }
    ret cover.check(cv, r);
}

# a part of a blob an encoder writes at an offset
# ---
# offset: where it lies
# kind:   which part it is, PART_*
# index:  which entry of a table it is
rec Part {
    offset: u64;
    kind:   u8;
    index:  u32;
}

val PART_IDENT:       u8 = 0;
val PART_TEAM:        u8 = 1;
val PART_HASHES:      u8 = 2;
val PART_SCATTER:     u8 = 3;
val PART_PRE_ENCRYPT: u8 = 4;
val PART_LINKAGE:     u8 = 5;

fun by_offset(a: *Part, b: *Part) i64 {
    if (a.offset < b.offset) { ret -1; }
    if (a.offset > b.offset) { ret 1; }
    ret 0;
}

fun push_part(t: *Vector[Part], offset: u64, kind: u8, index: u32) err[Fail] {
    val err_part_pushed: err[Fail] = vectors.push[Part](t, Part{offset: offset, kind: kind, index: index});
    if (sel err_part_pushed.err) { ret err[Fail].err{err_part_pushed.err}; }
    ret err[Fail].ok{};
}

# the zero bytes up to `offset` bytes into the blob that began at `start`
fun reach(s: *Sink, start: usize, offset: u64) err[Fail] {
    val have: u64 = (sink.len(s) - start)::u64;
    if (offset < have) { ret err[Fail].err{fail.malformed("parts of the signature overlap")}; }
    ret sink.zeros(s, (offset - have)::usize);
}

# the blob that began at `start` ended at `length` bytes
fun finish(s: *Sink, start: usize, length: u32) err[Fail] {
    val have: u64 = (sink.len(s) - start)::u64;
    if (have > length::u64) { ret err[Fail].err{fail.malformed("signature part runs past its length")}; }
    ret sink.zeros(s, (length::u64 - have)::usize);
}

# the signature in big endian, whatever order `s` writes in. byte strings are
# read through `st`
pub fun encode(s: *Sink, a: *A.Allocator, st: *Store, sig: *Signature) err[Fail] {
    val saved: Order = s.order;
    s.order = BIG;
    val err_write_signature: err[Fail] = write_signature(s, a, st, sig);
    s.order = saved;
    ret err_write_signature;
}

fun write_signature(s: *Sink, a: *A.Allocator, st: *Store, sig: *Signature) err[Fail] {
    val err_counted: err[Fail] = counted(sig);
    if (sel err_counted.err) { ret err_counted; }
    val start:             usize     = sink.len(s);
    val err_magic_written: err[Fail] = sink.u32(s, sig.magic);
    if (sel err_magic_written.err) { ret err_magic_written; }
    val err_length_written: err[Fail] = sink.u32(s, sig.length);
    if (sel err_length_written.err) { ret err_length_written; }
    val err_count_written: err[Fail] = sink.u32(s, sig.count);
    if (sel err_count_written.err) { ret err_count_written; }
    var i: usize = 0;
    for (i < vector.length[BlobIndex](?sig.index)) {
        val ix:      *BlobIndex = ?sig.index.data[i];
        val err_u32: err[Fail]  = sink.u32(s, ix.type);
        if (sel err_u32.err) { ret err_u32; }
        val err_u32_offset: err[Fail] = sink.u32(s, ix.offset);
        if (sel err_u32_offset.err) { ret err_u32_offset; }
        i = i + 1;
    }
    var g: usize = 0;
    i = 0;
    for (i < vector.length[CsBlob](?sig.blobs)) {
        val ix:         *BlobIndex = ?sig.index.data[i];
        val err_before: err[Fail]  = write_gaps(s, st, start, sig, ?g, ix.offset::u64);
        if (sel err_before.err) { ret err_before; }
        val err_reach: err[Fail] = reach(s, start, ix.offset::u64);
        if (sel err_reach.err) { ret err_reach; }
        val err_write_blob: err[Fail] = write_blob(s, a, st, ?sig.blobs.data[i]);
        if (sel err_write_blob.err) { ret err[Fail].err{fail.in_indexed(err_write_blob.err, "signature blob", i::u64)}; }
        i = i + 1;
    }
    val err_after: err[Fail] = write_gaps(s, st, start, sig, ?g, sig.length::u64);
    if (sel err_after.err) { ret err_after; }
    ret finish(s, start, sig.length);
}

# the gaps from `next` that begin before `limit`
fun write_gaps(s: *Sink, st: *Store, start: usize, sig: *Signature, next: *usize, limit: u64) err[Fail] {
    for (@next < vector.length[Gap](?sig.gaps) && sig.gaps.data[@next].at < limit) {
        val gap:       *Gap      = ?sig.gaps.data[@next];
        val err_reach: err[Fail] = reach(s, start, gap.at);
        if (sel err_reach.err) { ret err_reach; }
        val err_write_held: err[Fail] = write_held(s, st, ?gap.bytes);
        if (sel err_write_held.err) { ret err_write_held; }
        @next = @next + 1;
    }
    ret err[Fail].ok{};
}

fun write_blob(s: *Sink, a: *A.Allocator, st: *Store, b: *CsBlob) err[Fail] {
    val start:   usize     = sink.len(s);
    val err_u32: err[Fail] = sink.u32(s, b.magic);
    if (sel err_u32.err) { ret err_u32; }
    val err_u32_length: err[Fail] = sink.u32(s, b.length);
    if (sel err_u32_length.err) { ret err_u32_length; }
    var err_write_directory: err[Fail] = err[Fail].ok{};
    if (sel b.body.directory)        { err_write_directory = write_directory(s, a, st, start, ?b.body.directory); }
    or (sel b.body.requirements)     { err_write_directory = write_requirements(s, st, start, ?b.body.requirements); }
    or (sel b.body.entitlements)     { err_write_directory = write_held(s, st, ?b.body.entitlements); }
    or (sel b.body.der_entitlements) { err_write_directory = write_held(s, st, ?b.body.der_entitlements); }
    or (sel b.body.wrapper)          { err_write_directory = write_held(s, st, ?b.body.wrapper); }
    or (sel b.body.constraint)       { err_write_directory = write_held(s, st, ?b.body.constraint); }
    or (sel b.body.raw)              { err_write_directory = write_held(s, st, ?b.body.raw.bytes); }
    if (sel err_write_directory.err) { ret err_write_directory; }
    ret finish(s, start, b.length);
}

fun write_held(s: *Sink, st: *Store, h: *Held) err[Fail] {
    val b: Bytes = store.bytes(st, h);
    ret sink.bytes(s, b.data, b.len);
}

# a byte string and its NUL
fun write_text(s: *Sink, st: *Store, h: *Held) err[Fail] {
    val err_write_held: err[Fail] = write_held(s, st, h);
    if (sel err_write_held.err) { ret err_write_held; }
    ret sink.u8(s, 0);
}

fun write_requirements(s: *Sink, st: *Store, start: usize, q: *Requirements) err[Fail] {
    if (vector.length[BlobIndex](?q.index)::u64 != q.count::u64 || vector.length[Held](?q.items)::u64 != q.count::u64) {
        ret err[Fail].err{fail.malformed("requirements count disagrees with its tables")};
    }
    val err_u32: err[Fail] = sink.u32(s, q.count);
    if (sel err_u32.err) { ret err_u32; }
    var i: usize = 0;
    for (i < q.count::usize) {
        val ix:      *BlobIndex = ?q.index.data[i];
        val err_u32: err[Fail]  = sink.u32(s, ix.type);
        if (sel err_u32.err) { ret err_u32; }
        val err_u32_offset: err[Fail] = sink.u32(s, ix.offset);
        if (sel err_u32_offset.err) { ret err_u32_offset; }
        i = i + 1;
    }
    i = 0;
    for (i < q.count::usize) {
        val err_reach: err[Fail] = reach(s, start, q.index.data[i].offset::u64);
        if (sel err_reach.err) { ret err_reach; }
        val err_write_held: err[Fail] = write_held(s, st, ?q.items.data[i]);
        if (sel err_write_held.err) { ret err_write_held; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun write_directory(s: *Sink, a: *A.Allocator, st: *Store, start: usize, d: *Directory) err[Fail] {
    val end: u64 = header_end(d.version);
    if (d.version::u64 > tables.CS_SUPPORTSLINKAGE.value) {
        ret err[Fail].err{fail.unsupported("code directory is newer than the revision mink implements")};
    }
    val words: [7]u32 = [7]u32{d.version, d.flags, d.hash_offset, d.ident_offset, d.n_special_slots, d.n_code_slots, d.code_limit};
    var i:     usize  = 0;
    for (i < 7) {
        val err_u32: err[Fail] = sink.u32(s, words[i]);
        if (sel err_u32.err) { ret err_u32; }
        i = i + 1;
    }
    val bytes: [4]u8 = [4]u8{d.hash_size, d.hash_type, d.platform, d.page_size};
    i = 0;
    for (i < 4) {
        val err_u8: err[Fail] = sink.u8(s, bytes[i]);
        if (sel err_u8.err) { ret err_u8; }
        i = i + 1;
    }
    val err_u32: err[Fail] = sink.u32(s, d.spare2);
    if (sel err_u32.err) { ret err_u32; }
    if (end >= 48) {
        val err_u32: err[Fail] = sink.u32(s, d.scatter_offset);
        if (sel err_u32.err) { ret err_u32; }
    }
    if (end >= 52) {
        val err_u32: err[Fail] = sink.u32(s, d.team_offset);
        if (sel err_u32.err) { ret err_u32; }
    }
    if (end >= 64) {
        val err_u32: err[Fail] = sink.u32(s, d.spare3);
        if (sel err_u32.err) { ret err_u32; }
        val err_u64: err[Fail] = sink.u64(s, d.code_limit64);
        if (sel err_u64.err) { ret err_u64; }
    }
    if (end >= 88) {
        val err_u64: err[Fail] = sink.u64(s, d.exec_seg_base);
        if (sel err_u64.err) { ret err_u64; }
        val err_u64_exec_seg_limit: err[Fail] = sink.u64(s, d.exec_seg_limit);
        if (sel err_u64_exec_seg_limit.err) { ret err_u64_exec_seg_limit; }
        val err_u64_exec_seg_flags: err[Fail] = sink.u64(s, d.exec_seg_flags);
        if (sel err_u64_exec_seg_flags.err) { ret err_u64_exec_seg_flags; }
    }
    if (end >= 96) {
        val err_u32: err[Fail] = sink.u32(s, d.runtime);
        if (sel err_u32.err) { ret err_u32; }
        val err_u32_pre_encrypt_offset: err[Fail] = sink.u32(s, d.pre_encrypt_offset);
        if (sel err_u32_pre_encrypt_offset.err) { ret err_u32_pre_encrypt_offset; }
    }
    if (end >= 108) {
        val err_u8: err[Fail] = sink.u8(s, d.linkage_hash_type);
        if (sel err_u8.err) { ret err_u8; }
        val err_u8_linkage_application_type: err[Fail] = sink.u8(s, d.linkage_application_type);
        if (sel err_u8_linkage_application_type.err) { ret err_u8_linkage_application_type; }
        val err_u16: err[Fail] = sink.u16(s, d.linkage_application_subtype);
        if (sel err_u16.err) { ret err_u16; }
        val err_u32: err[Fail] = sink.u32(s, d.linkage_offset);
        if (sel err_u32.err) { ret err_u32; }
        val err_u32_linkage_size: err[Fail] = sink.u32(s, d.linkage_size);
        if (sel err_u32_linkage_size.err) { ret err_u32_linkage_size; }
    }
    var parts:       Vector[Part] = vector.init[Part](a);
    val err_planned: err[Fail]    = plan_directory(?parts, d, end);
    if (sel err_planned.err) {
        val err_dropped: err[Fail] = vectors.dnit[Part](?parts);
        ret err_planned;
    }
    sort.sort_by[Part](parts.data, vector.length[Part](?parts), by_offset);
    var err_failed: err[Fail] = err[Fail].ok{};
    i = 0;
    for (i < vector.length[Part](?parts) && !sel err_failed.err) {
        err_failed = write_part(s, st, start, d, ?parts.data[i]);
        i          = i + 1;
    }
    val err_dropped: err[Fail] = vectors.dnit[Part](?parts);
    if (sel err_failed.err) { ret err_failed; }
    ret err_dropped;
}

fun plan_directory(parts: *Vector[Part], d: *Directory, end: u64) err[Fail] {
    val err_ident: err[Fail] = push_part(parts, d.ident_offset::u64, PART_IDENT, 0);
    if (sel err_ident.err) { ret err_ident; }
    if (end >= 52 && d.team_offset != 0) {
        val err_push_part: err[Fail] = push_part(parts, d.team_offset::u64, PART_TEAM, 0);
        if (sel err_push_part.err) { ret err_push_part; }
    }
    val res_first: res[u64, Fail] = checked.mul(Location{}, d.n_special_slots::u64, d.hash_size::u64);
    if (sel res_first.err) { ret err[Fail].err{res_first.err}; }
    val res_sub: res[u64, Fail] = checked.sub(Location{}, d.hash_offset::u64, res_first.ok);
    if (sel res_sub.err) { ret err[Fail].err{res_sub.err}; }
    val err_push_part: err[Fail] = push_part(parts, res_sub.ok, PART_HASHES, 0);
    if (sel err_push_part.err) { ret err_push_part; }
    if (end >= 48 && d.scatter_offset != 0) {
        val err_push_part: err[Fail] = push_part(parts, d.scatter_offset::u64, PART_SCATTER, 0);
        if (sel err_push_part.err) { ret err_push_part; }
    }
    if (end >= 96 && d.pre_encrypt_offset != 0) {
        val err_push_part: err[Fail] = push_part(parts, d.pre_encrypt_offset::u64, PART_PRE_ENCRYPT, 0);
        if (sel err_push_part.err) { ret err_push_part; }
    }
    if (end >= 108 && d.linkage_offset != 0) {
        val err_push_part: err[Fail] = push_part(parts, d.linkage_offset::u64, PART_LINKAGE, 0);
        if (sel err_push_part.err) { ret err_push_part; }
    }
    ret err[Fail].ok{};
}

fun write_part(s: *Sink, st: *Store, start: usize, d: *Directory, p: *Part) err[Fail] {
    val err_reach: err[Fail] = reach(s, start, p.offset);
    if (sel err_reach.err)          { ret err_reach; }
    if (p.kind == PART_IDENT)       { ret write_text(s, st, ?d.ident); }
    if (p.kind == PART_TEAM)        { ret write_text(s, st, ?d.team); }
    if (p.kind == PART_HASHES)      { ret write_held(s, st, ?d.hashes); }
    if (p.kind == PART_PRE_ENCRYPT) { ret write_held(s, st, ?d.pre_encrypt); }
    if (p.kind == PART_LINKAGE)     { ret write_held(s, st, ?d.linkage); }
    var i: usize = 0;
    for (i < vector.length[Scatter](?d.scatter)) {
        val e: *Scatter = ?d.scatter.data[i];
        if (e.count == 0) { ret err[Fail].err{fail.malformed("scatter entry with no pages ends the vector early")}; }
        val err_u32: err[Fail] = sink.u32(s, e.count);
        if (sel err_u32.err) { ret err_u32; }
        val err_u32_base: err[Fail] = sink.u32(s, e.base);
        if (sel err_u32_base.err) { ret err_u32_base; }
        val err_u64: err[Fail] = sink.u64(s, e.target_offset);
        if (sel err_u64.err) { ret err_u64; }
        val err_u64_spare: err[Fail] = sink.u64(s, e.spare);
        if (sel err_u64_spare.err) { ret err_u64_spare; }
        i = i + 1;
    }
    ret sink.zeros(s, SCATTER_SIZE);
}

# the bytes of the image the code slots cover, which end at the code limit
pub fun code_limit(d: *Directory) u64 {
    if (d.code_limit == 0 && d.version::u64 >= tables.CS_SUPPORTSCODELIMIT64.value) { ret d.code_limit64; }
    ret d.code_limit::u64;
}

# how many bytes a code slot covers: a page, or the whole image when the page
# size is zero
pub fun page_bytes(d: *Directory) res[u64, Fail] {
    if (d.page_size == 0)  { ret res[u64, Fail].ok{code_limit(d)}; }
    if (d.page_size >= 64) { ret res[u64, Fail].err{fail.malformed("code directory page size is not a power of two a size holds")}; }
    ret res[u64, Fail].ok{(1::u64) << d.page_size::u64};
}

# how many code slots cover the image
pub fun slot_count(d: *Directory) res[u64, Fail] {
    val res_page: res[u64, Fail] = page_bytes(d);
    if (sel res_page.err) { ret res[u64, Fail].err{res_page.err}; }
    val limit: u64 = code_limit(d);
    if (limit == 0) { ret res[u64, Fail].ok{0}; }
    val res_location_added: res[u64, Fail] = checked.add(Location{}, limit, res_page.ok - 1);
    if (sel res_location_added.err) { ret res[u64, Fail].err{res_location_added.err}; }
    ret res[u64, Fail].ok{res_location_added.ok / res_page.ok};
}

# a code slot hash type: the code the hash type table names, the width of the
# digest std gives for it and the hash that gives it. a directory keeps the
# first hash size bytes of each digest
rec Hasher {
    type:  *Constant;
    width: usize;
    run:   fun(*u8, usize, *u8);
}

val HASHER_COUNT: usize = 4;

val HASHERS: [HASHER_COUNT]Hasher = [HASHER_COUNT]Hasher{
    Hasher{type: ?tables.CS_HASHTYPE_SHA1, width: sha1.DIGEST_SIZE, run: sha1.hash},
    Hasher{type: ?tables.CS_HASHTYPE_SHA256, width: sha256.DIGEST_SIZE, run: sha256.hash},
    Hasher{type: ?tables.CS_HASHTYPE_SHA256_TRUNCATED, width: sha256.DIGEST_SIZE, run: sha256.hash},
    Hasher{type: ?tables.CS_HASHTYPE_SHA384, width: sha512.DIGEST_SIZE_384, run: sha512.hash384},
};

# the hash the slots of `d` are made with. a type with no row is refused, and
# so is a hash size its digest does not hold
fun hasher(d: *Directory) res[*Hasher, Fail] {
    var i: usize = 0;
    for (i < HASHER_COUNT) {
        val h: *Hasher = ?HASHERS[i];
        if (d.hash_type::u64 == h.type.value) {
            if (d.hash_size == 0 || d.hash_size::usize > h.width) {
                ret res[*Hasher, Fail].err{fail.valued(fail.malformed("code directory hash size is not one its hash type's digest holds"), d.hash_size::i128)};
            }
            ret res[*Hasher, Fail].ok{h};
        }
        i = i + 1;
    }
    ret res[*Hasher, Fail].err{fail.valued(fail.unsupported("code directory hash type is not one mink hashes"), d.hash_type::i128)};
}

# append the first `size` bytes of the digest `h` gives of the `len` bytes at `data`
fun digest(s: *Sink, h: *Hasher, size: usize, data: *u8, len: usize) err[Fail] {
    var out: [tables.CS_HASH_MAX_SIZE.value]u8;
    h.run(data, len, ?out[0]);
    ret sink.bytes(s, ?out[0], size);
}

# append the code slot hashes of the `len` bytes of the image at `data`: one
# digest in the directory's hash type per page of the page size it states, the
# last covering only what remains up to the code limit
pub fun hash_pages(s: *Sink, d: *Directory, data: *u8, len: usize) err[Fail] {
    val res_hasher: res[*Hasher, Fail] = hasher(d);
    if (sel res_hasher.err) { ret err[Fail].err{res_hasher.err}; }
    val limit: u64 = code_limit(d);
    if (limit > len::u64) { ret err[Fail].err{fail.truncated("code limit lies past the image")}; }
    val res_page: res[u64, Fail] = page_bytes(d);
    if (sel res_page.err) { ret err[Fail].err{res_page.err}; }
    var at: u64 = 0;
    for (at < limit) {
        var n: u64 = res_page.ok;
        if (limit - at < n) { n = limit - at; }
        val err_digest: err[Fail] = digest(s, res_hasher.ok, d.hash_size::usize, ?data[at::usize], n::usize);
        if (sel err_digest.err) { ret err_digest; }
        at = at + n;
    }
    ret err[Fail].ok{};
}

# a special slot whose blob the superblob holds: the slot, which is the blob's
# type in the blob index, and the magic that blob carries
rec Special {
    slot:  *Constant;
    magic: *Constant;
}

val SPECIAL_COUNT: usize = 7;

val SPECIALS: [SPECIAL_COUNT]Special = [SPECIAL_COUNT]Special{
    Special{slot: ?tables.CSSLOT_REQUIREMENTS, magic: ?tables.CSMAGIC_REQUIREMENTS},
    Special{slot: ?tables.CSSLOT_ENTITLEMENTS, magic: ?tables.CSMAGIC_EMBEDDED_ENTITLEMENTS},
    Special{slot: ?tables.CSSLOT_DER_ENTITLEMENTS, magic: ?tables.CSMAGIC_EMBEDDED_DER_ENTITLEMENTS},
    Special{slot: ?tables.CSSLOT_LAUNCH_CONSTRAINT_SELF, magic: ?tables.CSMAGIC_EMBEDDED_LAUNCH_CONSTRAINT},
    Special{slot: ?tables.CSSLOT_LAUNCH_CONSTRAINT_PARENT, magic: ?tables.CSMAGIC_EMBEDDED_LAUNCH_CONSTRAINT},
    Special{slot: ?tables.CSSLOT_LAUNCH_CONSTRAINT_RESPONSIBLE, magic: ?tables.CSMAGIC_EMBEDDED_LAUNCH_CONSTRAINT},
    Special{slot: ?tables.CSSLOT_LIBRARY_CONSTRAINT, magic: ?tables.CSMAGIC_EMBEDDED_LAUNCH_CONSTRAINT},
};

# whether a row names `slot` as hashing a blob of `magic`
fun identifies(slot: u64, magic: u32) bool {
    var i: usize = 0;
    for (i < SPECIAL_COUNT) {
        if (SPECIALS[i].slot.value == slot) { ret SPECIALS[i].magic.value == magic::u64; }
        i = i + 1;
    }
    ret false;
}

fun counted(sig: *Signature) err[Fail] {
    if (vector.length[BlobIndex](?sig.index)::u64 != sig.count::u64 || vector.length[CsBlob](?sig.blobs)::u64 != sig.count::u64) {
        ret err[Fail].err{fail.malformed("superblob count disagrees with its tables")};
    }
    ret err[Fail].ok{};
}

# for each of the first `n` special slots, where the superblob holds its blob,
# plus one, or zero where it holds none
fun place_specials(at: *Vector[u32], sig: *Signature, n: usize) err[Fail] {
    val err_grow: err[Fail] = vectors.grow[u32](at, n);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < vector.length[BlobIndex](?sig.index)) {
        val ix: *BlobIndex = ?sig.index.data[i];
        if (ix.type != 0 && ix.type::u64 <= n::u64) {
            val p: *u32 = ?at.data[(ix.type - 1)::usize];
            if (@p != 0) { ret err[Fail].err{fail.valued(fail.malformed("superblob holds two blobs of one special slot"), ix.type::i128)}; }
            @p = (i + 1)::u32;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# append the special slots of `d`, from its highest slot down to the first: each
# the digest of the blob `sig` holds of that slot's type, or zeroes where it
# holds none. a blob no row identifies for its slot is refused, and so is a slot
# hashing a blob the superblob does not hold, since neither can be made again
fun special_slots(s: *Sink, a: *A.Allocator, st: *Store, sig: *Signature, d: *Directory) err[Fail] {
    val res_hasher: res[*Hasher, Fail] = hasher(d);
    if (sel res_hasher.err) { ret err[Fail].err{res_hasher.err}; }
    val err_counted: err[Fail] = counted(sig);
    if (sel err_counted.err) { ret err_counted; }
    val size:     usize          = d.hash_size::usize;
    val n:        usize          = d.n_special_slots::usize;
    val res_want: res[u64, Fail] = checked.mul(Location{}, n::u64, size::u64);
    if (sel res_want.err) { ret err[Fail].err{res_want.err}; }
    val held: Bytes = store.bytes(st, ?d.hashes);
    if (held.len::u64 < res_want.ok) {
        ret err[Fail].err{fail.in_record(fail.malformed("code directory holds fewer special slots than it states"), "code directory")};
    }
    var at:                 Vector[u32] = vector.init[u32](a);
    var err_place_specials: err[Fail]   = place_specials(?at, sig, n);
    var k:                  usize       = n;
    for (!(sel err_place_specials.err) && k > 0) {
        err_place_specials = special_slot(s, a, st, sig, res_hasher.ok, size, k, at.data[k - 1], ?held.data[(n - k) * size]);
        k                  = k - 1;
    }
    val err_dropped: err[Fail] = vectors.dnit[u32](?at);
    if (sel err_place_specials.err) { ret err_place_specials; }
    ret err_dropped;
}

fun special_slot(s: *Sink, a: *A.Allocator, st: *Store, sig: *Signature, h: *Hasher, size: usize, slot: usize, place: u32, held: *u8) err[Fail] {
    if (place == 0) {
        var i: usize = 0;
        for (i < size) {
            if (held[i] != 0) { ret err[Fail].err{fail.valued(fail.unsupported("special slot hashes a blob the signature does not hold"), slot::i128)}; }
            i = i + 1;
        }
        ret sink.zeros(s, size);
    }
    val b: *CsBlob = ?sig.blobs.data[(place - 1)::usize];
    if (!identifies(slot::u64, b.magic)) {
        ret err[Fail].err{fail.valued(fail.unsupported("special slot holds a blob mink does not identify"), slot::i128)};
    }
    var enc:            Sink      = sink.init(a, BIG);
    var err_write_blob: err[Fail] = write_blob(?enc, a, st, b);
    if (!(sel err_write_blob.err)) { err_write_blob = digest(s, h, size, sink.data(?enc), sink.len(?enc)); }
    val err_dropped: err[Fail] = sink.dnit(?enc);
    if (sel err_write_blob.err) { ret err_write_blob; }
    ret err_dropped;
}

# append the slots of `d`: its special slots from the blobs `sig` holds, then
# its code slots hashed over the `len` bytes of the image at `data`, or zeroes
# in their place when `data` is nil
fun slots(s: *Sink, a: *A.Allocator, st: *Store, sig: *Signature, d: *Directory, data: *u8, len: usize) err[Fail] {
    val res_slot_count: res[u64, Fail] = slot_count(d);
    if (sel res_slot_count.err) { ret err[Fail].err{res_slot_count.err}; }
    if (res_slot_count.ok != d.n_code_slots::u64) {
        ret err[Fail].err{fail.in_record(fail.malformed("code directory states a count of code slots its code limit does not give"), "code directory")};
    }
    val err_special_slots: err[Fail] = special_slots(s, a, st, sig, d);
    if (sel err_special_slots.err) { ret err_special_slots; }
    if (data != nil)               { ret hash_pages(s, d, data, len); }
    val res_mul: res[u64, Fail] = checked.mul(Location{}, res_slot_count.ok, d.hash_size::u64);
    if (sel res_mul.err) { ret err[Fail].err{res_mul.err}; }
    ret sink.zeros(s, res_mul.ok::usize);
}

# the signature `sig` encoded into `s` with the slots of every code directory
# made again, each in its own hash type: its special slots from the blobs `sig`
# holds and its code slots hashed over the `len` bytes of the image at `data`. a
# nil image sizes the signature with the code slots zeroed. the directories hold
# their own slots again when this returns
pub fun encode_signed(s: *Sink, a: *A.Allocator, st: *Store, sig: *Signature, data: *u8, len: usize) err[Fail] {
    var saved:     Vector[Held] = vector.init[Held](a);
    var made:      Vector[Sink] = vector.init[Sink](a);
    var err_first: err[Fail]    = substitute(a, st, sig, ?saved, ?made, data, len);
    if (!(sel err_first.err)) { err_first = encode(s, a, st, sig); }
    restore(sig, ?saved);
    var i: usize = 0;
    for (i < vector.length[Sink](?made)) {
        err_first = fail.kept(err_first, sink.dnit(?made.data[i]));
        i         = i + 1;
    }
    err_first = fail.kept(err_first, vectors.dnit[Sink](?made));
    ret fail.kept(err_first, vectors.dnit[Held](?saved));
}

fun substitute(a: *A.Allocator, st: *Store, sig: *Signature, saved: *Vector[Held], made: *Vector[Sink], data: *u8, len: usize) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[CsBlob](?sig.blobs)) {
        val b: *CsBlob = ?sig.blobs.data[i];
        if (sel b.body.directory) {
            val d:         *Directory = ?b.body.directory;
            var hs:        Sink       = sink.init(a, BIG);
            var err_slots: err[Fail]  = slots(?hs, a, st, sig, d, data, len);
            if (!(sel err_slots.err) && data != nil) { err_slots = remade(st, sig, d, ?hs); }
            if (sel err_slots.err) {
                val err_dropped: err[Fail] = sink.dnit(?hs);
                ret err[Fail].err{fail.in_indexed(err_slots.err, "signature blob", i::u64)};
            }
            val err_made_pushed: err[Fail] = vectors.push[Sink](made, hs);
            if (sel err_made_pushed.err) {
                val err_dropped: err[Fail] = sink.dnit(?hs);
                ret err[Fail].err{err_made_pushed.err};
            }
            val err_saved_pushed: err[Fail] = vectors.push[Held](saved, d.hashes);
            if (sel err_saved_pushed.err) { ret err[Fail].err{err_saved_pushed.err}; }
            val m: *Sink = ?made.data[vector.length[Sink](made) - 1];
            d.hashes = Held.borrowed{Bytes{data: sink.data(m), len: sink.len(m)}};
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# whether the superblob holds a CMS signature that signs anything
fun signed(sig: *Signature) bool {
    var i: usize = 0;
    for (i < vector.length[BlobIndex](?sig.index)) {
        val ix: *BlobIndex = ?sig.index.data[i];
        if (ix.type::u64 == tables.CSSLOT_SIGNATURESLOT.value && sig.blobs.data[i].length::usize > BLOB_HEADER_SIZE) { ret true; }
        i = i + 1;
    }
    ret false;
}

# slots of `d` that differ from those it holds are refused where something mink
# does not make again covers them: the CMS signature or the pre-encryption hashes
fun remade(st: *Store, sig: *Signature, d: *Directory, made: *Sink) err[Fail] {
    val held: Bytes = store.bytes(st, ?d.hashes);
    if (held.len == sink.len(made) && same_bytes(held.data, sink.data(made), held.len)) { ret err[Fail].ok{}; }
    if (header_end(d.version) >= 96 && d.pre_encrypt_offset != 0) {
        ret err[Fail].err{fail.in_record(fail.unsupported("making pre-encryption hashes again is not supported"), "code directory")};
    }
    if (signed(sig)) { ret err[Fail].err{fail.in_record(fail.unsupported("re-signing a CMS signature is not supported"), "code directory")}; }
    ret err[Fail].ok{};
}

# give each directory the slots it held before they were substituted
fun restore(sig: *Signature, saved: *Vector[Held]) {
    var done: usize = 0;
    var i:    usize = 0;
    for (done < vector.length[Held](saved)) {
        val b: *CsBlob = ?sig.blobs.data[i];
        if (sel b.body.directory) {
            b.body.directory.hashes = saved.data[done];
            done                    = done + 1;
        }
        i = i + 1;
    }
}

fun same_bytes(p: *u8, q: *u8, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (p[i] != q[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}
