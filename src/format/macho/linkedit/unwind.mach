# the compact unwind data of a Mach-O file
#
# `__compact_unwind` holds one fixed record per function in an object, and
# `__unwind_info` the table dyld and libunwind read at run time: the common
# encodings, the personalities, a first-level index of pages, the language
# specific data areas and the second-level pages, regular or compressed. both
# codecs are pure functions over bytes and entries, and the second reads and
# writes every part at the offset the entries state, zero between, so a table
# comes back byte for byte.

use std.collections.sort;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.vectors;
use mink.bytes.reader;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.macho.model.cover;
use mink.format.macho.model.cover.Cover;
use mink.format.macho.model.model;
use mink.format.macho.model.model.Unwind;
use mink.format.macho.model.model.UnwindCompressed;
use mink.format.macho.model.model.UnwindEntry;
use mink.format.macho.model.model.UnwindIndex;
use mink.format.macho.model.model.UnwindInfo;
use mink.format.macho.model.model.UnwindLsda;
use mink.format.macho.model.model.UnwindPage;
use mink.format.macho.model.model.UnwindRegular;

# the width of the __unwind_info header, of a first-level index entry, of a
# language specific data entry and of a regular page entry
pub val HEADER_SIZE:       usize = 28;
pub val INDEX_SIZE:        usize = 12;
pub val LSDA_SIZE:         usize = 8;
pub val REGULAR_ENTRY:     usize = 8;
pub val REGULAR_HEADER:    usize = 8;
pub val COMPRESSED_HEADER: usize = 12;

# the kind of a second-level page
pub val PAGE_REGULAR:    u32 = 2;
pub val PAGE_COMPRESSED: u32 = 3;

# a compressed entry packs a function offset in its low bits and the index of
# its encoding in the rest
pub val COMPRESSED_OFFSET_BITS: u32 = 24;
pub val COMPRESSED_OFFSET_MASK: u32 = 0x00ff_ffff;

# the width of a __compact_unwind record for a pointer of `ptr` bytes
pub fun record_size(ptr: usize) usize {
    ret 3 * ptr + 8;
}

# the records of the __compact_unwind section the reader spans. `ptr` is the
# width of a pointer in bytes
pub fun decode_compact(a: *A.Allocator, r: *Reader, ptr: usize) res[Vector[Unwind], Fail] {
    var out:  Vector[Unwind] = vector.init[Unwind](a);
    val size: usize          = record_size(ptr);
    if (reader.remaining(r) % size != 0) {
        ret res[Vector[Unwind], Fail].err{fail.at_offset(fail.in_file(fail.unsupported("compact unwind is not a whole number of records"), r.file), reader.offset(r))};
    }
    val n:        usize     = reader.remaining(r) / size;
    val err_grow: err[Fail] = vectors.grow[Unwind](?out, n);
    if (sel err_grow.err) { ret res[Vector[Unwind], Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < n) {
        val e:               *Unwind   = ?out.data[i];
        val err_read_record: err[Fail] = read_record(r, ptr, e);
        if (sel err_read_record.err) {
            val err_dropped: err[Fail] = vectors.dnit[Unwind](?out);
            ret res[Vector[Unwind], Fail].err{err_read_record.err};
        }
        i = i + 1;
    }
    ret res[Vector[Unwind], Fail].ok{out};
}

fun read_record(r: *Reader, ptr: usize, e: *Unwind) err[Fail] {
    val res_start: res[u64, Fail] = reader.uint(r, ptr);
    if (sel res_start.err) { ret err[Fail].err{res_start.err}; }
    val res_length: res[u32, Fail] = reader.u32(r);
    if (sel res_length.err) { ret err[Fail].err{res_length.err}; }
    val res_encoding: res[u32, Fail] = reader.u32(r);
    if (sel res_encoding.err) { ret err[Fail].err{res_encoding.err}; }
    val res_personality: res[u64, Fail] = reader.uint(r, ptr);
    if (sel res_personality.err) { ret err[Fail].err{res_personality.err}; }
    val res_lsda: res[u64, Fail] = reader.uint(r, ptr);
    if (sel res_lsda.err) { ret err[Fail].err{res_lsda.err}; }
    e.start       = res_start.ok;
    e.length      = res_length.ok;
    e.encoding    = res_encoding.ok;
    e.personality = res_personality.ok;
    e.lsda        = res_lsda.ok;
    ret err[Fail].ok{};
}

# the __compact_unwind records for `entries`, `ptr` bytes to a pointer
pub fun encode_compact(s: *Sink, entries: *Vector[Unwind], ptr: usize) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Unwind](entries)) {
        val e: *Unwind = ?entries.data[i];
        if (ptr < 8 && (e.start >> (ptr::u64 * 8) != 0 || e.personality >> (ptr::u64 * 8) != 0 || e.lsda >> (ptr::u64 * 8) != 0)) {
            ret err[Fail].err{fail.malformed("compact unwind address does not fit a pointer")};
        }
        val err_uint: err[Fail] = sink.uint(s, e.start, ptr);
        if (sel err_uint.err) { ret err_uint; }
        val err_u32: err[Fail] = sink.u32(s, e.length);
        if (sel err_u32.err) { ret err_u32; }
        val err_u32_encoding: err[Fail] = sink.u32(s, e.encoding);
        if (sel err_u32_encoding.err) { ret err_u32_encoding; }
        val err_uint_personality: err[Fail] = sink.uint(s, e.personality, ptr);
        if (sel err_uint_personality.err) { ret err_uint_personality; }
        val err_uint_lsda: err[Fail] = sink.uint(s, e.lsda, ptr);
        if (sel err_uint_lsda.err) { ret err_uint_lsda; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun at_here(f: Fail, r: *Reader) Fail {
    ret fail.at_offset(fail.in_file(f, r.file), reader.offset(r));
}

# the table of the section the reader spans. `r` starts at the header
pub fun decode(a: *A.Allocator, r: *Reader) res[UnwindInfo, Fail] {
    var info: UnwindInfo = UnwindInfo{
        common:        vector.init[u32](a),
        personalities: vector.init[u32](a),
        index:         vector.init[UnwindIndex](a),
        lsdas:         vector.init[UnwindLsda](a),
        pages:         vector.init[UnwindPage](a),
    };
    var cv:      Cover     = cover.init(a);
    val err_ran: err[Fail] = cover.settle(?cv, run(?info, r, ?cv));
    if (sel err_ran.err) {
        val err_dropped: err[Fail] = model.unwind_info_dnit(?info);
        ret res[UnwindInfo, Fail].err{err_ran.err};
    }
    ret res[UnwindInfo, Fail].ok{info};
}

# `count` words at `pos` into `out`
fun words(r: *Reader, pos: u64, count: u32, out: *Vector[u32]) err[Fail] {
    val res_seek: res[usize, Fail] = reader.seek(r, pos);
    if (sel res_seek.err)                       { ret err[Fail].err{res_seek.err}; }
    if (count::usize > reader.remaining(r) / 4) { ret err[Fail].err{at_here(fail.truncated("encodings lie outside the section"), r)}; }
    val err_grow: err[Fail] = vectors.grow[u32](out, count::usize);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < count::usize) {
        val res_u32: res[u32, Fail] = reader.u32(r);
        if (sel res_u32.err) { ret err[Fail].err{res_u32.err}; }
        val cell: *u32 = ?out.data[i];
        @cell = res_u32.ok;
        i     = i + 1;
    }
    ret err[Fail].ok{};
}

fun run(info: *UnwindInfo, r: *Reader, cv: *Cover) err[Fail] {
    val res_seek: res[usize, Fail] = reader.seek(r, 0);
    if (sel res_seek.err) { ret err[Fail].err{res_seek.err}; }
    var common_count:      u32     = 0;
    var personality_count: u32     = 0;
    var index_count:       u32     = 0;
    val vals:              [7]*u32 = [7]*u32{?info.version, ?info.common_offset, ?common_count, ?info.personality_offset, ?personality_count, ?info.index_offset, ?index_count};
    var i:                 usize   = 0;
    for (i < 7) {
        val res_u32: res[u32, Fail] = reader.u32(r);
        if (sel res_u32.err) { ret err[Fail].err{res_u32.err}; }
        @vals[i] = res_u32.ok;
        i        = i + 1;
    }
    info.size = r.len::u32;
    val err_here_added: err[Fail] = cover.add(cv, reader.here(r), 0, HEADER_SIZE::u64);
    if (sel err_here_added.err) { ret err_here_added; }
    val err_common_read: err[Fail] = words(r, info.common_offset::u64, common_count, ?info.common);
    if (sel err_common_read.err) { ret err_common_read; }
    val err_common_covered: err[Fail] = cover.add(cv, reader.here(r), info.common_offset::u64, common_count::u64 * 4);
    if (sel err_common_covered.err) { ret err_common_covered; }
    val err_personalities_read: err[Fail] = words(r, info.personality_offset::u64, personality_count, ?info.personalities);
    if (sel err_personalities_read.err) { ret err_personalities_read; }
    val err_personalities_covered: err[Fail] = cover.add(cv, reader.here(r), info.personality_offset::u64, personality_count::u64 * 4);
    if (sel err_personalities_covered.err) { ret err_personalities_covered; }
    val err_run_index: err[Fail] = run_index(info, r, index_count, cv);
    if (sel err_run_index.err) { ret err_run_index; }
    ret cover.check(cv, r);
}

fun run_index(info: *UnwindInfo, r: *Reader, count: u32, cv: *Cover) err[Fail] {
    val res_seek: res[usize, Fail] = reader.seek(r, info.index_offset::u64);
    if (sel res_seek.err) { ret err[Fail].err{res_seek.err}; }
    if (count::usize > reader.remaining(r) / INDEX_SIZE) {
        ret err[Fail].err{at_here(fail.truncated("first-level index lies outside the section"), r)};
    }
    val err_grow: err[Fail] = vectors.grow[UnwindIndex](?info.index, count::usize);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < count::usize) {
        val res_u32: res[u32, Fail] = reader.u32(r);
        if (sel res_u32.err) { ret err[Fail].err{res_u32.err}; }
        val res_page: res[u32, Fail] = reader.u32(r);
        if (sel res_page.err) { ret err[Fail].err{res_page.err}; }
        val res_lsda: res[u32, Fail] = reader.u32(r);
        if (sel res_lsda.err) { ret err[Fail].err{res_lsda.err}; }
        info.index.data[i].function = res_u32.ok;
        info.index.data[i].page     = res_page.ok;
        info.index.data[i].lsda     = res_lsda.ok;
        i                           = i + 1;
    }
    val err_here_added: err[Fail] = cover.add(cv, reader.here(r), info.index_offset::u64, count::u64 * INDEX_SIZE::u64);
    if (sel err_here_added.err) { ret err_here_added; }
    if (count == 0)             { ret err[Fail].ok{}; }
    val first: u32 = info.index.data[0].lsda;
    val last:  u32 = info.index.data[count::usize - 1].lsda;
    if (last < first || (last - first)::usize % LSDA_SIZE != 0) {
        ret err[Fail].err{at_here(fail.unsupported("language specific data bounds do not hold whole entries"), r)};
    }
    val err_lsdas: err[Fail] = run_lsdas(info, r, first, (last - first) / LSDA_SIZE::u32, cv);
    if (sel err_lsdas.err) { ret err_lsdas; }
    i = 0;
    for (i + 1 < count::usize) {
        val pos: u32 = info.index.data[i].page;
        if (pos != 0) {
            val err_run_page: err[Fail] = run_page(info, r, pos::u64, cv);
            if (sel err_run_page.err) { ret err[Fail].err{fail.in_indexed(err_run_page.err, "second-level page", i::u64)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun run_lsdas(info: *UnwindInfo, r: *Reader, first: u32, count: u32, cv: *Cover) err[Fail] {
    val res_seek: res[usize, Fail] = reader.seek(r, first::u64);
    if (sel res_seek.err) { ret err[Fail].err{res_seek.err}; }
    if (count::usize > reader.remaining(r) / LSDA_SIZE) {
        ret err[Fail].err{at_here(fail.truncated("language specific data lies outside the section"), r)};
    }
    val err_grow: err[Fail] = vectors.grow[UnwindLsda](?info.lsdas, count::usize);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < count::usize) {
        val res_u32: res[u32, Fail] = reader.u32(r);
        if (sel res_u32.err) { ret err[Fail].err{res_u32.err}; }
        val res_lsda: res[u32, Fail] = reader.u32(r);
        if (sel res_lsda.err) { ret err[Fail].err{res_lsda.err}; }
        info.lsdas.data[i].function = res_u32.ok;
        info.lsdas.data[i].lsda     = res_lsda.ok;
        i                           = i + 1;
    }
    ret cover.add(cv, reader.here(r), first::u64, count::u64 * LSDA_SIZE::u64);
}

fun run_page(info: *UnwindInfo, r: *Reader, pos: u64, cv: *Cover) err[Fail] {
    val res_seek: res[usize, Fail] = reader.seek(r, pos);
    if (sel res_seek.err) { ret err[Fail].err{res_seek.err}; }
    val res_kind: res[u32, Fail] = reader.u32(r);
    if (sel res_kind.err) { ret err[Fail].err{res_kind.err}; }
    val res_entry_offset: res[u16, Fail] = reader.u16(r);
    if (sel res_entry_offset.err) { ret err[Fail].err{res_entry_offset.err}; }
    val res_entry_count: res[u16, Fail] = reader.u16(r);
    if (sel res_entry_count.err) { ret err[Fail].err{res_entry_count.err}; }
    if (res_kind.ok == PAGE_REGULAR) {
        var pg:      UnwindRegular = UnwindRegular{entry_offset: res_entry_offset.ok, entries: vector.init[UnwindEntry](info.pages.a)};
        val err_ran: err[Fail]     = regular_entries(r, pos, res_entry_count.ok, ?pg, cv);
        if (sel err_ran.err) {
            val err_dropped: err[Fail] = vectors.dnit[UnwindEntry](?pg.entries);
            ret err_ran;
        }
        val err_pages_pushed: err[Fail] = vectors.push[UnwindPage](?info.pages, UnwindPage.regular{pg});
        if (sel err_pages_pushed.err) {
            val err_dropped: err[Fail] = vectors.dnit[UnwindEntry](?pg.entries);
            ret err[Fail].err{err_pages_pushed.err};
        }
        ret err[Fail].ok{};
    }
    if (res_kind.ok == PAGE_COMPRESSED) {
        val res_encodings_offset: res[u16, Fail] = reader.u16(r);
        if (sel res_encodings_offset.err) { ret err[Fail].err{res_encodings_offset.err}; }
        val res_encodings_count: res[u16, Fail] = reader.u16(r);
        if (sel res_encodings_count.err) { ret err[Fail].err{res_encodings_count.err}; }
        var pg: UnwindCompressed = UnwindCompressed{
            entry_offset:     res_entry_offset.ok,
            encodings_offset: res_encodings_offset.ok,
            entries:          vector.init[u32](info.pages.a),
            encodings:        vector.init[u32](info.pages.a),
        };
        val err_ran: err[Fail] = compressed_entries(r, pos, res_entry_count.ok, res_encodings_count.ok, ?pg, cv);
        if (sel err_ran.err) {
            val err_release:           err[Fail] = vectors.dnit[u32](?pg.entries);
            val err_release_encodings: err[Fail] = vectors.dnit[u32](?pg.encodings);
            ret err_ran;
        }
        val err_pages_pushed: err[Fail] = vectors.push[UnwindPage](?info.pages, UnwindPage.compressed{pg});
        if (sel err_pages_pushed.err) {
            val err_release:           err[Fail] = vectors.dnit[u32](?pg.entries);
            val err_release_encodings: err[Fail] = vectors.dnit[u32](?pg.encodings);
            ret err[Fail].err{err_pages_pushed.err};
        }
        ret err[Fail].ok{};
    }
    ret err[Fail].err{at_here(fail.unsupported("second-level page kind is neither regular nor compressed"), r)};
}

fun regular_entries(r: *Reader, pos: u64, count: u16, pg: *UnwindRegular, cv: *Cover) err[Fail] {
    val err_head: err[Fail] = cover.add(cv, reader.here(r), pos, REGULAR_HEADER::u64);
    if (sel err_head.err) { ret err_head; }
    val res_here_added: res[u64, Fail] = checked.add(reader.here(r), pos, pg.entry_offset::u64);
    if (sel res_here_added.err) { ret err[Fail].err{res_here_added.err}; }
    val res_seek: res[usize, Fail] = reader.seek(r, res_here_added.ok);
    if (sel res_seek.err) { ret err[Fail].err{res_seek.err}; }
    if (count::usize > reader.remaining(r) / REGULAR_ENTRY) {
        ret err[Fail].err{at_here(fail.truncated("page entries lie outside the section"), r)};
    }
    val err_grow: err[Fail] = vectors.grow[UnwindEntry](?pg.entries, count::usize);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < count::usize) {
        val res_u32: res[u32, Fail] = reader.u32(r);
        if (sel res_u32.err) { ret err[Fail].err{res_u32.err}; }
        val res_encoding: res[u32, Fail] = reader.u32(r);
        if (sel res_encoding.err) { ret err[Fail].err{res_encoding.err}; }
        pg.entries.data[i].function = res_u32.ok;
        pg.entries.data[i].encoding = res_encoding.ok;
        i                           = i + 1;
    }
    ret cover.add(cv, reader.here(r), res_here_added.ok, count::u64 * REGULAR_ENTRY::u64);
}

fun compressed_entries(r: *Reader, pos: u64, count: u16, encodings: u16, pg: *UnwindCompressed, cv: *Cover) err[Fail] {
    val err_head: err[Fail] = cover.add(cv, reader.here(r), pos, COMPRESSED_HEADER::u64);
    if (sel err_head.err) { ret err_head; }
    val res_here_added: res[u64, Fail] = checked.add(reader.here(r), pos, pg.entry_offset::u64);
    if (sel res_here_added.err) { ret err[Fail].err{res_here_added.err}; }
    val err_words: err[Fail] = words(r, res_here_added.ok, count::u32, ?pg.entries);
    if (sel err_words.err) { ret err_words; }
    val err_here_added: err[Fail] = cover.add(cv, reader.here(r), res_here_added.ok, count::u64 * 4);
    if (sel err_here_added.err) { ret err_here_added; }
    val res_here_added_pos: res[u64, Fail] = checked.add(reader.here(r), pos, pg.encodings_offset::u64);
    if (sel res_here_added_pos.err) { ret err[Fail].err{res_here_added_pos.err}; }
    val err_words_u32: err[Fail] = words(r, res_here_added_pos.ok, encodings::u32, ?pg.encodings);
    if (sel err_words_u32.err) { ret err_words_u32; }
    ret cover.add(cv, reader.here(r), res_here_added_pos.ok, encodings::u64 * 4);
}

# a part of the section an encoder writes at an offset
# ---
# offset: where it lies
# kind:   which part it is, PART_*
# index:  which table entry it is
rec Part {
    offset: u64;
    kind:   u8;
    index:  u32;
}

val PART_HEADER:        u8 = 0;
val PART_COMMON:        u8 = 1;
val PART_PERSONALITIES: u8 = 2;
val PART_INDEX:         u8 = 3;
val PART_LSDAS:         u8 = 4;
val PART_PAGE:          u8 = 5;

fun by_offset(a: *Part, b: *Part) i64 {
    if (a.offset < b.offset) { ret -1; }
    if (a.offset > b.offset) { ret 1; }
    ret 0;
}

fun push_part(t: *Vector[Part], offset: u64, kind: u8, index: u32) err[Fail] {
    val err_part_pushed: err[Fail] = vectors.push[Part](t, Part{offset: offset, kind: kind, index: index});
    if (sel err_part_pushed.err) { ret err[Fail].err{err_part_pushed.err}; }
    ret err[Fail].ok{};
}

# zero bytes up to `offset` bytes after `start`
fun reach(s: *Sink, start: usize, offset: u64) err[Fail] {
    val have: u64 = (sink.len(s) - start)::u64;
    if (offset < have) { ret err[Fail].err{fail.malformed("parts of the unwind info overlap")}; }
    ret sink.zeros(s, (offset - have)::usize);
}

# the section for `info`, each part at the offset it states and zeros between
pub fun encode(s: *Sink, a: *A.Allocator, info: *UnwindInfo) err[Fail] {
    var parts:       Vector[Part] = vector.init[Part](a);
    val err_planned: err[Fail]    = plan(?parts, info);
    if (sel err_planned.err) {
        val err_dropped: err[Fail] = vectors.dnit[Part](?parts);
        ret err_planned;
    }
    sort.sort_by[Part](parts.data, vector.length[Part](?parts), by_offset);
    val start:      usize     = sink.len(s);
    var err_failed: err[Fail] = err[Fail].ok{};
    var i:          usize     = 0;
    for (i < vector.length[Part](?parts) && !sel err_failed.err) {
        err_failed = write_part(s, start, info, ?parts.data[i]);
        i          = i + 1;
    }
    val err_dropped: err[Fail] = vectors.dnit[Part](?parts);
    if (sel err_failed.err)  { ret err_failed; }
    if (sel err_dropped.err) { ret err_dropped; }
    val have: u64 = (sink.len(s) - start)::u64;
    if (have > info.size::u64) { ret err[Fail].err{fail.malformed("unwind info runs past its size")}; }
    ret sink.zeros(s, (info.size::u64 - have)::usize);
}

fun plan(parts: *Vector[Part], info: *UnwindInfo) err[Fail] {
    val n:     usize = vector.length[UnwindIndex](?info.index);
    var paged: usize = 0;
    var i:     usize = 0;
    for (i + 1 < n) {
        if (info.index.data[i].page != 0) { paged = paged + 1; }
        i = i + 1;
    }
    if (paged != vector.length[UnwindPage](?info.pages)) {
        ret err[Fail].err{fail.malformed("unwind info pages disagree with its index")};
    }
    if (n > 0) {
        val first: u32 = info.index.data[0].lsda;
        val last:  u32 = info.index.data[n - 1].lsda;
        if (last < first || (last - first)::usize != vector.length[UnwindLsda](?info.lsdas) * LSDA_SIZE) {
            ret err[Fail].err{fail.malformed("unwind info language specific data disagrees with its index")};
        }
    }
    val err_push_part: err[Fail] = push_part(parts, 0, PART_HEADER, 0);
    if (sel err_push_part.err) { ret err_push_part; }
    if (vector.length[u32](?info.common) > 0) {
        val err_push_part: err[Fail] = push_part(parts, info.common_offset::u64, PART_COMMON, 0);
        if (sel err_push_part.err) { ret err_push_part; }
    }
    if (vector.length[u32](?info.personalities) > 0) {
        val err_push_part: err[Fail] = push_part(parts, info.personality_offset::u64, PART_PERSONALITIES, 0);
        if (sel err_push_part.err) { ret err_push_part; }
    }
    if (n > 0) {
        val err_push_part: err[Fail] = push_part(parts, info.index_offset::u64, PART_INDEX, 0);
        if (sel err_push_part.err) { ret err_push_part; }
    }
    if (vector.length[UnwindLsda](?info.lsdas) > 0) {
        val err_push_part: err[Fail] = push_part(parts, info.index.data[0].lsda::u64, PART_LSDAS, 0);
        if (sel err_push_part.err) { ret err_push_part; }
    }
    i = 0;
    var page: u32 = 0;
    for (i + 1 < n) {
        val pos: u32 = info.index.data[i].page;
        if (pos != 0) {
            val err_push_part: err[Fail] = push_part(parts, pos::u64, PART_PAGE, page);
            if (sel err_push_part.err) { ret err_push_part; }
            page = page + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun write_words(s: *Sink, t: *Vector[u32]) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[u32](t)) {
        val err_u32: err[Fail] = sink.u32(s, t.data[i]);
        if (sel err_u32.err) { ret err_u32; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun write_part(s: *Sink, start: usize, info: *UnwindInfo, p: *Part) err[Fail] {
    val err_reach: err[Fail] = reach(s, start, p.offset);
    if (sel err_reach.err) { ret err_reach; }
    if (p.kind == PART_HEADER) {
        val vals: [7]u32 = [7]u32{
            info.version,
            info.common_offset,
            vector.length[u32](?info.common)::u32,
            info.personality_offset,
            vector.length[u32](?info.personalities)::u32,
            info.index_offset,
            vector.length[UnwindIndex](?info.index)::u32,
        };
        var i: usize = 0;
        for (i < 7) {
            val err_u32: err[Fail] = sink.u32(s, vals[i]);
            if (sel err_u32.err) { ret err_u32; }
            i = i + 1;
        }
        ret err[Fail].ok{};
    }
    if (p.kind == PART_COMMON)        { ret write_words(s, ?info.common); }
    if (p.kind == PART_PERSONALITIES) { ret write_words(s, ?info.personalities); }
    if (p.kind == PART_INDEX) {
        var i: usize = 0;
        for (i < vector.length[UnwindIndex](?info.index)) {
            val e:       *UnwindIndex = ?info.index.data[i];
            val err_u32: err[Fail]    = sink.u32(s, e.function);
            if (sel err_u32.err) { ret err_u32; }
            val err_u32_page: err[Fail] = sink.u32(s, e.page);
            if (sel err_u32_page.err) { ret err_u32_page; }
            val err_u32_lsda: err[Fail] = sink.u32(s, e.lsda);
            if (sel err_u32_lsda.err) { ret err_u32_lsda; }
            i = i + 1;
        }
        ret err[Fail].ok{};
    }
    if (p.kind == PART_LSDAS) {
        var i: usize = 0;
        for (i < vector.length[UnwindLsda](?info.lsdas)) {
            val e:       *UnwindLsda = ?info.lsdas.data[i];
            val err_u32: err[Fail]   = sink.u32(s, e.function);
            if (sel err_u32.err) { ret err_u32; }
            val err_u32_lsda: err[Fail] = sink.u32(s, e.lsda);
            if (sel err_u32_lsda.err) { ret err_u32_lsda; }
            i = i + 1;
        }
        ret err[Fail].ok{};
    }
    ret write_page(s, ?info.pages.data[p.index::usize]);
}

fun write_page(s: *Sink, pg: *UnwindPage) err[Fail] {
    val start: usize = sink.len(s);
    if (sel pg.regular) {
        val n: usize = vector.length[UnwindEntry](?pg.regular.entries);
        if (n > 0xffff) { ret err[Fail].err{fail.malformed("regular page holds more entries than its count")}; }
        val err_u32: err[Fail] = sink.u32(s, PAGE_REGULAR);
        if (sel err_u32.err) { ret err_u32; }
        val err_u16: err[Fail] = sink.u16(s, pg.regular.entry_offset);
        if (sel err_u16.err) { ret err_u16; }
        val err_regular_count_written: err[Fail] = sink.u16(s, n::u16);
        if (sel err_regular_count_written.err) { ret err_regular_count_written; }
        val err_reach: err[Fail] = reach(s, start, pg.regular.entry_offset::u64);
        if (sel err_reach.err) { ret err_reach; }
        var i: usize = 0;
        for (i < n) {
            val e:       *UnwindEntry = ?pg.regular.entries.data[i];
            val err_u32: err[Fail]    = sink.u32(s, e.function);
            if (sel err_u32.err) { ret err_u32; }
            val err_u32_encoding: err[Fail] = sink.u32(s, e.encoding);
            if (sel err_u32_encoding.err) { ret err_u32_encoding; }
            i = i + 1;
        }
        ret err[Fail].ok{};
    }
    if (sel pg.compressed) {
        val n: usize = vector.length[u32](?pg.compressed.entries);
        val m: usize = vector.length[u32](?pg.compressed.encodings);
        if (n > 0xffff || m > 0xffff) { ret err[Fail].err{fail.malformed("compressed page holds more entries than its count")}; }
        val err_u32: err[Fail] = sink.u32(s, PAGE_COMPRESSED);
        if (sel err_u32.err) { ret err_u32; }
        val err_u16: err[Fail] = sink.u16(s, pg.compressed.entry_offset);
        if (sel err_u16.err) { ret err_u16; }
        val err_compressed_count_written: err[Fail] = sink.u16(s, n::u16);
        if (sel err_compressed_count_written.err) { ret err_compressed_count_written; }
        val err_u16_encodings_offset: err[Fail] = sink.u16(s, pg.compressed.encodings_offset);
        if (sel err_u16_encodings_offset.err) { ret err_u16_encodings_offset; }
        val err_encodings_count_written: err[Fail] = sink.u16(s, m::u16);
        if (sel err_encodings_count_written.err) { ret err_encodings_count_written; }
        if (pg.compressed.entry_offset <= pg.compressed.encodings_offset) {
            val err_entries_reached: err[Fail] = reach(s, start, pg.compressed.entry_offset::u64);
            if (sel err_entries_reached.err) { ret err_entries_reached; }
            val err_entries_written: err[Fail] = write_words(s, ?pg.compressed.entries);
            if (sel err_entries_written.err) { ret err_entries_written; }
            val err_encodings_reached: err[Fail] = reach(s, start, pg.compressed.encodings_offset::u64);
            if (sel err_encodings_reached.err) { ret err_encodings_reached; }
            ret write_words(s, ?pg.compressed.encodings);
        }
        val err_encodings_reached: err[Fail] = reach(s, start, pg.compressed.encodings_offset::u64);
        if (sel err_encodings_reached.err) { ret err_encodings_reached; }
        val err_encodings_written: err[Fail] = write_words(s, ?pg.compressed.encodings);
        if (sel err_encodings_written.err) { ret err_encodings_written; }
        val err_entries_reached: err[Fail] = reach(s, start, pg.compressed.entry_offset::u64);
        if (sel err_entries_reached.err) { ret err_entries_reached; }
        ret write_words(s, ?pg.compressed.entries);
    }
    ret err[Fail].err{fail.internal("unwind info page holds no entries")};
}
