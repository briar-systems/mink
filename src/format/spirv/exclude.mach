# how a SPIR-V module carries the sections a link drops
#
# a module has no section flags, so a section the link drops is named by the
# id it defines, decorated `OpDecorateString %id UserSemantic "mink.exclude"`.
# the specification gives UserSemantic no semantic impact, a string a tool
# attaches to an id, and an annotation may name an id defined after it, so
# one form names a type, a constant, a global, a function declaration and a
# function definition alike, and needs no fresh id and no type. the
# decoration and its opcode are core from version 1.4, and below it
# SPV_GOOGLE_hlsl_functionality1 enables both, as the grammar states, so a
# module below 1.4 that carries an exclusion declares that extension and the
# reader drops it again. an object below 1.4 that states the extension
# itself is refused when its module would carry an exclusion, as the reader
# could not tell the two declarations apart. a section that defines no id is
# about the section it lives through, as a decoration, a name or an execution
# mode is about the id its first operand names, so it is excluded exactly
# when that section is, and that section's decoration carries both. a
# section about nothing, an entry point, a source or a processing record,
# has no id to carry its exclusion and is refused excluded.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.format.spirv.grammar;
use mink.format.spirv.grammar.Grammar;
use mink.format.spirv.grammar.Op;
use mink.format.spirv.model;
use mink.format.spirv.model.Instruction;
use mink.format.spirv.model.Module;
use mink.format.spirv.tables;

# the string the decoration states
pub val SEMANTIC: str = "mink.exclude";

# the extension that enables the decoration below the version it is core in
pub val EXTENSION: str = "SPV_GOOGLE_hlsl_functionality1";

# the version OpDecorateString and UserSemantic are core from
pub val CORE_SINCE: u32 = 0x0001_0400;

# whether a module of `version` declares the extension to carry an exclusion
pub fun extended(version: u32) bool {
    ret version < CORE_SINCE;
}

# whether `name` names the extension
pub fun is_extension(name: Bytes) bool {
    ret store.same_bytes(name, Bytes{data: EXTENSION::*u8, len: str_len(EXTENSION)});
}

# how many operand words the decoration takes
pub fun operand_words() usize {
    ret 2 + model.string_words(str_len(SEMANTIC));
}

# whether the instruction of `opcode`, whose `count` operand words lie at
# `words`, is the decoration
pub fun decoration(opcode: u32, words: *u32, count: usize) bool {
    if (opcode != tables.OP_DECORATE_STRING || count != operand_words()) { ret false; }
    if (words[1] != tables.DECORATION_USER_SEMANTIC)                     { ret false; }
    val n: usize = str_len(SEMANTIC);
    var i: usize = 0;
    for (i < (count - 2) * model.WORD) {
        val byte: u8 = ((words[2 + i / model.WORD] >> ((i % model.WORD) * 8)::u32) & 0xFF)::u8;
        var want: u8 = 0;
        if (i < n)        { want = SEMANTIC[i]; }
        if (byte != want) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the module `m` holds the decoration
pub fun carries(m: *Module) bool {
    var i: usize = 0;
    for (i < model.count(m)) {
        val ins: *Instruction = model.at(m, i);
        if (decoration(ins.opcode::u32, model.operands(m, ins), ins.count)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the id whose decoration carries the exclusion of a section of the `n`
# words at `words`, each id word holding its id: the id an excluded section
# defines, none for a section not excluded and for one that lives through
# another. `excluded` is whether the section is excluded and `owner` whether
# the section it lives through is, none for a section that lives through
# none. refused: a section living through another whose exclusion differs
# from that one's, an excluded section that lives through none and defines
# no id, and an excluded section of more than one module-scope instruction
# or function, as its decoration names one id
pub fun carrier(g: *Grammar, words: *u32, n: usize, excluded: bool, owner: opt[bool]) res[opt[u32], Fail] {
    if (sel owner.some) {
        if (owner.some != excluded) { ret res[opt[u32], Fail].err{fail.unsupported("a SPIR-V section that defines no id is excluded exactly when the section it is about is")}; }
        ret res[opt[u32], Fail].ok{opt[u32].none{}};
    }
    if (!excluded) { ret res[opt[u32], Fail].ok{opt[u32].none{}}; }
    var at: usize = 0;
    for (at < n) {
        val count: usize = (words[at] >> 16)::usize;
        if (count == 0 || count > n - at) { ret res[opt[u32], Fail].err{fail.at_offset(fail.malformed("an instruction of a section runs past its end"), (at * model.WORD)::u64)}; }
        val op: u32 = words[at] & 0xFFFF;
        if (op != tables.OP_LINE && op != tables.OP_NO_LINE) { brk; }
        at = at + count;
    }
    if (at >= n) { ret res[opt[u32], Fail].err{fail.unsupported("an excluded SPIR-V section holds no instruction to name it by")}; }
    val lead:  u32              = words[at];
    val op:    u32              = lead & 0xFFFF;
    val count: usize            = (lead >> 16)::usize;
    val end:   res[usize, Fail] = piece_end(words, n, at);
    if (sel end.err) { ret res[opt[u32], Fail].err{end.err}; }
    if (end.ok != n) { ret res[opt[u32], Fail].err{fail.unsupported("an excluded SPIR-V section holds more than one instruction or function, and its decoration names one id")}; }
    val defined: res[opt[usize], Fail] = result_word(g, op);
    if (sel defined.err) { ret res[opt[u32], Fail].err{defined.err}; }
    val word: opt[usize] = defined.ok;
    if (sel word.none)          { ret res[opt[u32], Fail].err{fail.unsupported("an excluded SPIR-V section defines no id and is about none, so nothing names it")}; }
    if (word.some + 1 >= count) { ret res[opt[u32], Fail].err{fail.at_offset(fail.malformed("an instruction holds no id where its opcode defines one"), (at * model.WORD)::u64)}; }
    ret res[opt[u32], Fail].ok{opt[u32].some{words[at + 1 + word.some]}};
}

# where the module-scope instruction or function that starts at word `at`
# ends among the `n` words at `words`
fun piece_end(words: *u32, n: usize, at: usize) res[usize, Fail] {
    val count: usize = (words[at] >> 16)::usize;
    if ((words[at] & 0xFFFF) != tables.OP_FUNCTION) { ret res[usize, Fail].ok{at + count}; }
    var i: usize = at + count;
    for (i < n) {
        val c: usize = (words[i] >> 16)::usize;
        if (c == 0 || c > n - i) { ret res[usize, Fail].err{fail.at_offset(fail.malformed("an instruction of a section runs past its end"), (i * model.WORD)::u64)}; }
        i = i + c;
        if ((words[i - c] & 0xFFFF) == tables.OP_FUNCTION_END) { ret res[usize, Fail].ok{i}; }
    }
    ret res[usize, Fail].err{fail.malformed("a function runs past the end of its section")};
}

# which operand word of an instruction of `op` holds the id it defines, none
# for an opcode that defines none
fun result_word(g: *Grammar, op: u32) res[opt[usize], Fail] {
    val found: res[*Op, Fail] = grammar.op(g, op);
    if (sel found.err) { ret res[opt[usize], Fail].err{found.err}; }
    val o: *Op   = found.ok;
    var i: usize = 0;
    for (i < o.count && i < 2) {
        if (sel o.operands[i].kind.shape.result) { ret res[opt[usize], Fail].ok{opt[usize].some{i}}; }
        i = i + 1;
    }
    ret res[opt[usize], Fail].ok{opt[usize].none{}};
}
