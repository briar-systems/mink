# the SPIR-V module reader
#
# the magic number tells the byte order, and every word after it is read in
# that order. the reader bounds the module by the word count each
# instruction states and by nothing else, so an opcode the grammar does not
# know is kept as written. what it refuses stops it bounding the module, each
# failure placed at its offset:
# - malformed: a module that is not a whole number of words, a magic number
#   that is not SPIR-V's in either byte order, a schema word other than zero,
#   since an instruction schema would change how instructions are bounded,
#   and an instruction stating a word count of zero, which bounds nothing
# - truncated: a module shorter than its header, and an instruction whose
#   word count runs past the end of the module

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.encoding.binary;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.bytes.reader;
use mink.bytes.reader.BIG;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Order;
use mink.bytes.reader.Reader;
use mink.format.contract.Input;
use mink.format.shell;
use mink.format.spirv.model;
use mink.format.spirv.model.Header;
use mink.format.spirv.model.Module;

fun refuse(f: Fail, record: str, offset: u64) res[*Module, Fail] {
    ret res[*Module, Fail].err{fail.at_offset(fail.in_record(f, record), offset)};
}

# the module `in` holds, given back with model.release
pub fun read(a: *A.Allocator, in: *Input) res[*Module, Fail] {
    val header_len: usize = model.HEADER_WORDS * model.WORD;
    if (in.len < header_len) { ret refuse(fail.truncated("the module is shorter than its header"), "header", 0); }
    val tail: usize = in.len % model.WORD;
    if (tail != 0) {
        ret refuse(fail.malformed("the module is not a whole number of words"), "module", (in.len - tail)::u64);
    }
    val magic: u32   = binary.get_uint(in.data, model.WORD, LITTLE)::u32;
    var order: Order = LITTLE;
    if (magic == model.MAGIC_SWAPPED) { order = BIG; }
    or (magic != model.MAGIC) {
        ret refuse(fail.valued(fail.malformed("the magic number is not SPIR-V's"), magic::i128), "header", 0);
    }
    var r:       Reader           = shell.open(in, order);
    val skipped: res[usize, Fail] = reader.seek(?r, model.WORD::u64);
    if (sel skipped.err) { ret res[*Module, Fail].err{skipped.err}; }
    var fields: [4]u32;
    var i:      usize = 0;
    for (i < 4) {
        val w: res[u32, Fail] = reader.u32(?r);
        if (sel w.err) { ret res[*Module, Fail].err{w.err}; }
        fields[i] = w.ok;
        i         = i + 1;
    }
    if (fields[3] != 0) {
        ret refuse(fail.valued(fail.malformed("the schema word is reserved and must be zero"), fields[3]::i128), "header", 16);
    }
    val made: res[*Module, Fail] = model.make(a, order, Header{version: fields[0], generator: fields[1], bound: fields[2], schema: fields[3]});
    if (sel made.err) { ret made; }
    val m:    *Module   = made.ok;
    val body: err[Fail] = instructions(m, ?r);
    if (sel body.err) {
        val dropped: err[Fail] = model.release(m);
        ret res[*Module, Fail].err{body.err};
    }
    ret res[*Module, Fail].ok{m};
}

# every instruction after the header, read into `m`
fun instructions(m: *Module, r: *Reader) err[Fail] {
    val room: err[Fail] = table.reserve[u32](?m.words, reader.remaining(r) / model.WORD);
    if (sel room.err) { ret room; }
    var index: u64 = 0;
    for (reader.remaining(r) > 0) {
        val at: u64            = reader.offset(r);
        val w:  res[u32, Fail] = reader.u32(r);
        if (sel w.err) { ret err[Fail].err{w.err}; }
        val words:  usize = (w.ok >> 16)::usize;
        val opcode: u16   = (w.ok & 0xFFFF)::u16;
        if (words == 0) {
            ret err[Fail].err{fail.at_offset(fail.in_indexed(fail.malformed("an instruction states a word count of zero"), "instruction", index), at)};
        }
        val count: usize = words - 1;
        if (count * model.WORD > reader.remaining(r)) {
            ret err[Fail].err{fail.valued(fail.at_offset(fail.in_indexed(fail.truncated("an instruction runs past the end of the module"), "instruction", index), at), words::i128)};
        }
        val operands: res[*u32, Fail] = model.append(m, opcode, count);
        if (sel operands.err) { ret err[Fail].err{fail.at_offset(fail.in_indexed(operands.err, "instruction", index), at)}; }
        var k: usize = 0;
        for (k < count) {
            val o: res[u32, Fail] = reader.u32(r);
            if (sel o.err) { ret err[Fail].err{o.err}; }
            operands.ok[k] = o.ok;
            k              = k + 1;
        }
        index = index + 1;
    }
    ret err[Fail].ok{};
}
