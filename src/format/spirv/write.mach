# the SPIR-V module writer
#
# the header, then every instruction as its word count and opcode and its
# operand words, each word in the module's byte order. a module read from
# bytes writes back the same bytes.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.spirv.model;
use mink.format.spirv.model.Instruction;
use mink.format.spirv.model.Module;

# the bytes of `m`, refused for an instruction whose word count cannot state
# it
pub fun write(a: *A.Allocator, m: *Module) res[Sink, Fail] {
    var s: Sink      = sink.make(a, m.order);
    val e: err[Fail] = emit(m, ?s);
    if (sel e.err) {
        val dropped: err[Fail] = sink.release(?s);
        ret res[Sink, Fail].err{e.err};
    }
    ret res[Sink, Fail].ok{s};
}

fun emit(m: *Module, s: *Sink) err[Fail] {
    val header: [5]u32 = [5]u32{model.MAGIC, m.header.version, m.header.generator, m.header.bound, m.header.schema};
    var i:      usize  = 0;
    for (i < model.HEADER_WORDS) {
        val w: err[Fail] = sink.u32(s, header[i]);
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    i = 0;
    for (i < model.count(m)) {
        val ins:   *Instruction   = model.at(m, i);
        val first: res[u32, Fail] = model.lead(ins.opcode, ins.count);
        if (sel first.err) { ret err[Fail].err{fail.in_indexed(first.err, "instruction", i::u64)}; }
        val lead: err[Fail] = sink.u32(s, first.ok);
        if (sel lead.err) { ret lead; }
        val words: *u32  = model.operands(m, ins);
        var k:     usize = 0;
        for (k < ins.count) {
            val w: err[Fail] = sink.u32(s, words[k]);
            if (sel w.err) { ret w; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}
