# a small SPIR-V instruction stream the tests build modules from
#
# a compute shader's stream as an assembler writes it, header aside: an
# entry point `main` with a local size of one, a void function type and a
# function that returns. it defines ids 1 to 4, so a module of it is bound by
# 5. the object states the version 1.3 and the logical GLSL450 memory model
# as traits and the Shader capability as a fact, so the stream holds no
# memory model instruction and no capability. it may state the Linkage
# capability too, which makes a module of it an object a link takes. a module
# of it is the stream behind a little endian version 1.3 header, the Shader
# capability and the logical GLSL450 memory model.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table.Id;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.spirv;
use mink.catalog.format;
use mink.catalog.trait.Setting;
use mink.format.spirv.model;
use mink.format.spirv.rules;
use mink.format.spirv.tables;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Fact;
use mink.model.object.Object;

# how many words the stream holds
pub val WORD_COUNT: usize = 25;

# how many ids it defines
pub val ID_COUNT: usize = 4;

val WORDS: [WORD_COUNT]u32 = [WORD_COUNT]u32{
    0x0005_000F, 5, 3, 0x6E69_616D, 0,
    0x0006_0010, 3, 17, 1, 1, 1,
    0x0002_0013, 1,
    0x0003_0021, 2, 1,
    0x0005_0036, 1, 3, 0, 2,
    0x0002_00F8, 4,
    0x0001_00FD,
    0x0001_0038,
};

# the header of a module of the stream: its magic, version 1.3, generator
# zero, its bound and a zero schema
val HEADER: [5]u32 = [5]u32{model.MAGIC, 0x0001_0300, 0, (ID_COUNT + 1)::u32, 0};

# the instructions declaring the Shader and the Linkage capabilities
val SHADER:  [2]u32 = [2]u32{0x0002_0011, 1};
val LINKAGE: [2]u32 = [2]u32{0x0002_0011, 5};

# the instruction stating the logical GLSL450 memory model
val MEMORY_MODEL: [3]u32 = [3]u32{0x0003_000E, 0, 1};

# a module of the stream into `out`, its header, its capabilities, its memory
# model and the stream, declaring Linkage when `linkage`
pub fun module(out: *Sink, linkage: bool) err[Fail] {
    var e: err[Fail] = err[Fail].ok{};
    var i: usize     = 0;
    for (i < 5) {
        e = fail.kept(e, sink.u32(out, HEADER[i]));
        i = i + 1;
    }
    e = fail.kept(e, sink.u32(out, SHADER[0]));
    e = fail.kept(e, sink.u32(out, SHADER[1]));
    if (linkage) {
        e = fail.kept(e, sink.u32(out, LINKAGE[0]));
        e = fail.kept(e, sink.u32(out, LINKAGE[1]));
    }
    i = 0;
    for (i < 3) {
        e = fail.kept(e, sink.u32(out, MEMORY_MODEL[i]));
        i = i + 1;
    }
    ret fail.kept(e, compute(out));
}

# the stream into `out`, in its byte order
pub fun compute(out: *Sink) err[Fail] {
    var e: err[Fail] = err[Fail].ok{};
    var i: usize     = 0;
    for (i < WORD_COUNT) {
        e = fail.kept(e, sink.u32(out, WORDS[i]));
        i = i + 1;
    }
    ret e;
}

fun capability(o: *Object, value: u32) err[Fail] {
    val f: res[Id[Fact], Fail] = object.add_fact(o, Fact{format: ?format.SPIRV, key: rules.CAPABILITY, value: value::u64, data: Contents.zero{0}});
    if (sel f.err) { ret err[Fail].err{f.err}; }
    ret err[Fail].ok{};
}

# state on `o` the traits and capabilities the stream is written to, the
# Linkage capability when `linkage`
pub fun state(o: *Object, linkage: bool) err[Fail] {
    var e: err[Fail] = object.state(o, ?spirv.SPIRV_VERSION, Setting.choice{?spirv.SPIRV_1_3});
    e = fail.kept(e, object.state(o, ?spirv.SPIRV_ADDRESSING_MODEL, Setting.choice{?spirv.SPIRV_LOGICAL}));
    e = fail.kept(e, object.state(o, ?spirv.SPIRV_MEMORY_MODEL, Setting.choice{?spirv.SPIRV_GLSL450}));
    e = fail.kept(e, capability(o, tables.CAPABILITY_SHADER));
    if (linkage) { e = fail.kept(e, capability(o, tables.CAPABILITY_LINKAGE)); }
    ret e;
}
