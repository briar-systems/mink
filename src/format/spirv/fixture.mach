# a small SPIR-V instruction stream the tests build modules from
#
# a compute shader's stream as an assembler writes it, header aside: the
# Shader capability, the logical GLSL450 memory model, an entry point `main`
# with a local size of one, a void function type and a function that returns.
# it defines ids 1 to 4, so a module of it is bound by 5.

use std.types.error.err;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

# how many words the stream holds
pub val WORD_COUNT: usize = 30;

# how many ids it defines
pub val ID_COUNT: usize = 4;

val WORDS: [WORD_COUNT]u32 = [WORD_COUNT]u32{
    0x0002_0011, 1,
    0x0003_000E, 0, 1,
    0x0005_000F, 5, 3, 0x6E69_616D, 0,
    0x0006_0010, 3, 17, 1, 1, 1,
    0x0002_0013, 1,
    0x0003_0021, 2, 1,
    0x0005_0036, 1, 3, 0, 2,
    0x0002_00F8, 4,
    0x0001_00FD,
    0x0001_0038,
};

# the stream into `out`, in its byte order
pub fun compute(out: *Sink) err[Fail] {
    var e: err[Fail] = err[Fail].ok{};
    var i: usize     = 0;
    for (i < WORD_COUNT) {
        e = fail.kept(e, sink.u32(out, WORDS[i]));
        i = i + 1;
    }
    ret e;
}
