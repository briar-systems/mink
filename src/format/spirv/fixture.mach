# a small SPIR-V instruction stream the tests build modules from
#
# a compute shader's stream as an assembler writes it, header aside: the
# Shader capability, an entry point `main` with a local size of one, a void
# function type and a function that returns. it defines ids 1 to 4, so a
# module of it is bound by 5. it may declare the Linkage capability too,
# which makes a module of it an object a link takes. the object states the
# version 1.3 and the logical GLSL450 memory model as traits, so the stream
# holds no memory model instruction.

use std.types.bool.bool;
use std.types.error.err;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.spirv;
use mink.catalog.trait.Setting;
use mink.model.object;
use mink.model.object.Object;

# how many words the stream holds, Linkage aside
pub val WORD_COUNT: usize = 27;

# how many ids it defines
pub val ID_COUNT: usize = 4;

val WORDS: [WORD_COUNT]u32 = [WORD_COUNT]u32{
    0x0002_0011, 1,
    0x0005_000F, 5, 3, 0x6E69_616D, 0,
    0x0006_0010, 3, 17, 1, 1, 1,
    0x0002_0013, 1,
    0x0003_0021, 2, 1,
    0x0005_0036, 1, 3, 0, 2,
    0x0002_00F8, 4,
    0x0001_00FD,
    0x0001_0038,
};

# the instruction declaring the Linkage capability, which follows Shader
val LINKAGE: [2]u32 = [2]u32{0x0002_0011, 5};

# the stream into `out`, in its byte order, declaring Linkage when `linkage`
pub fun compute(out: *Sink, linkage: bool) err[Fail] {
    var e: err[Fail] = err[Fail].ok{};
    var i: usize     = 0;
    for (i < WORD_COUNT) {
        e = fail.kept(e, sink.u32(out, WORDS[i]));
        i = i + 1;
        if (i == 2 && linkage) {
            e = fail.kept(e, sink.u32(out, LINKAGE[0]));
            e = fail.kept(e, sink.u32(out, LINKAGE[1]));
        }
    }
    ret e;
}

# state on `o` the traits the stream is written to
pub fun state(o: *Object) err[Fail] {
    var e: err[Fail] = object.state(o, ?spirv.SPIRV_VERSION, Setting.choice{?spirv.SPIRV_1_3});
    e = fail.kept(e, object.state(o, ?spirv.SPIRV_ADDRESSING_MODEL, Setting.choice{?spirv.SPIRV_LOGICAL}));
    ret fail.kept(e, object.state(o, ?spirv.SPIRV_MEMORY_MODEL, Setting.choice{?spirv.SPIRV_GLSL450}));
}
