# the walk that finds every id of a SPIR-V instruction
#
# an instruction's words say nothing of which are ids, so the walk reads its
# opcode's operand shapes from the grammar and follows them word by word:
# through optional and repeated operands, strings, the parameters an enum
# value or mask adds, pairs, the operands of an extended instruction and of
# the opcode a spec constant op names. two shapes need what the module said
# before: a selector literal is as wide as its selector's type, and an
# extended instruction's operands are its set's. so a walker is run over a
# module's instructions in order and learns, after each, the extended sets it
# imports and the scalar types its values take. an instruction whose words
# its shapes do not cover is refused.

use std.collections.map;
use std.collections.map.Map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.format.spirv.grammar;
use mink.format.spirv.grammar.Enum;
use mink.format.spirv.grammar.Enumerant;
use mink.format.spirv.grammar.Grammar;
use mink.format.spirv.grammar.Kind;
use mink.format.spirv.grammar.Op;
use mink.format.spirv.grammar.Operand;
use mink.format.spirv.grammar.Set;
use mink.format.spirv.model;
use mink.format.spirv.model.Header;
use mink.format.spirv.model.Instruction;
use mink.format.spirv.model.Module;
use mink.format.spirv.tables;

# what an id an operand word holds is to its instruction
# ---
# result_type: the type of the result
# result:      the id the instruction defines
# reference:   an id it uses
pub tag Role: u8 {
    result_type;
    result;
    reference;
}

# word: the operand word's index among the instruction's operands
# role: what the id is to the instruction
pub rec Found {
    word: usize;
    role: Role;
}

# what an OpExtInstImport imports
# ---
# set:     a set the grammar carries
# ids:     a non-semantic set, every operand of whose instructions is an id
# unknown: a set mink carries nothing of
pub tag Imported: u8 {
    set: *Set;
    ids;
    unknown;
}

# grammar: the grammar the walk follows
# sets:    what each OpExtInstImport walked imports, by its result
# widths:  how many words a literal of each scalar type walked takes, by the
#          type's id
# typed:   how many words a literal of each value's scalar type takes, by the
#          value's id
# name:    scratch for an imported set's name
pub rec Walker {
    grammar: *Grammar;
    sets:    Map[u32, Imported];
    widths:  Map[u32, u32];
    typed:   Map[u32, u32];
    name:    Table[u8];
}

# a walker over `g` that has seen nothing yet, given back with `release`
pub fun make(a: *A.Allocator, g: *Grammar) Walker {
    ret Walker{grammar: g, sets: map.init[u32, Imported](a), widths: map.init[u32, u32](a), typed: map.init[u32, u32](a), name: table.make[u8](a)};
}

pub fun release(w: *Walker) err[Fail] {
    val s: err[A.Error] = map.dnit[u32, Imported](?w.sets);
    val d: err[A.Error] = map.dnit[u32, u32](?w.widths);
    val t: err[A.Error] = map.dnit[u32, u32](?w.typed);
    val n: err[Fail]    = table.release[u8](?w.name);
    if (sel s.err) { ret err[Fail].err{fail.refused(s.err)}; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    if (sel t.err) { ret err[Fail].err{fail.refused(t.err)}; }
    ret n;
}

# the operand words of one instruction and how far the walk has read them
# ---
# words: the operand words
# count: how many
# at:    the next word to read
# last:  the value of the last id read, which an extended instruction's
#        number follows
# out:   where each id found goes
rec Cursor {
    w:     *Walker;
    words: *u32;
    count: usize;
    at:    usize;
    last:  u32;
    out:   *Table[Found];
}

fun short() err[Fail] {
    ret err[Fail].err{fail.malformed("an instruction holds fewer operands than its opcode takes")};
}

fun found(c: *Cursor, role: Role) err[Fail] {
    if (c.at >= c.count) { ret short(); }
    c.last = c.words[c.at];
    val p: res[Id[Found], Fail] = table.push[Found](c.out, Found{word: c.at, role: role});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    c.at = c.at + 1;
    ret err[Fail].ok{};
}

fun skip(c: *Cursor, n: usize) err[Fail] {
    if (n == 0 || n > c.count - c.at) { ret short(); }
    c.at = c.at + n;
    ret err[Fail].ok{};
}

# whether the word `w` holds a zero byte, which ends a string
fun ends(w: u32) bool {
    ret (w & 0xFF) == 0 || (w & 0xFF00) == 0 || (w & 0xFF_0000) == 0 || (w & 0xFF00_0000) == 0;
}

fun string(c: *Cursor) err[Fail] {
    for (c.at < c.count) {
        val w: u32 = c.words[c.at];
        c.at = c.at + 1;
        if (ends(w)) { ret err[Fail].ok{}; }
    }
    ret err[Fail].err{fail.malformed("a string runs past the end of its instruction")};
}

# the operands of `e` the enumerant `value` adds
fun parameters(c: *Cursor, e: *Enum, value: u32) err[Fail] {
    val n: *Enumerant = grammar.enumerant(e, value);
    if (n == nil) { ret err[Fail].ok{}; }
    ret list(c, n.operands, n.count);
}

fun mask(c: *Cursor, e: *Enum) err[Fail] {
    if (c.at >= c.count) { ret short(); }
    val bits: u32 = c.words[c.at];
    c.at = c.at + 1;
    var bit: u32 = 1;
    for (bit != 0) {
        if ((bits & bit) != 0) {
            val r: err[Fail] = parameters(c, e, bit);
            if (sel r.err) { ret r; }
        }
        bit = bit << 1;
    }
    ret err[Fail].ok{};
}

# the operands of the extended instruction whose number is next, of the set
# the last id read imports
fun extended(c: *Cursor) err[Fail] {
    if (c.at >= c.count) { ret short(); }
    val number: u32 = c.words[c.at];
    c.at = c.at + 1;
    val set: u32            = c.last;
    val got: opt[*Imported] = map.get[u32, Imported](?c.w.sets, ?set);
    if (sel got.none) { ret err[Fail].err{fail.valued(fail.malformed("an extended instruction names a set no OpExtInstImport before it imports"), set::i128)}; }
    val i: *Imported = got.some;
    if (sel i.ids) {
        for (c.at < c.count) {
            val r: err[Fail] = found(c, Role.reference{});
            if (sel r.err) { ret r; }
        }
        ret err[Fail].ok{};
    }
    or (sel i.unknown) {
        ret err[Fail].err{fail.valued(fail.unsupported("an extended instruction is of a set mink carries no grammar of"), set::i128)};
    }
    val n: res[*grammar.Instruction, Fail] = grammar.instruction(i.set, number);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    ret list(c, n.ok.operands, n.ok.count);
}

# the operands, past its result type and result, of the opcode named next
fun spec_op(c: *Cursor) err[Fail] {
    if (c.at >= c.count) { ret short(); }
    val code: u32 = c.words[c.at];
    c.at = c.at + 1;
    val op: res[*Op, Fail] = grammar.op(c.w.grammar, code);
    if (sel op.err) { ret err[Fail].err{op.err}; }
    val o: *Op = op.ok;
    if (o.count < 2 || !sel o.operands[0].kind.shape.result_type || !sel o.operands[1].kind.shape.result) {
        ret err[Fail].err{fail.valued(fail.malformed("a spec constant op names an opcode with no result"), code::i128)};
    }
    ret list(c, ?o.operands[2], o.count - 2);
}

# the words of a selector literal, as many as the type of the instruction's
# first operand takes
fun selector(c: *Cursor) err[Fail] {
    if (c.count == 0) { ret short(); }
    val id:    u32       = c.words[0];
    val words: opt[*u32] = map.get[u32, u32](?c.w.typed, ?id);
    if (sel words.none) { ret err[Fail].err{fail.valued(fail.malformed("a selector is of no scalar type the module declares before it"), id::i128)}; }
    ret skip(c, words.some[0]::usize);
}

# one operand of the kind `k`
fun one(c: *Cursor, k: *Kind) err[Fail] {
    val s: grammar.Shape = k.shape;
    if (sel s.result_type) { ret found(c, Role.result_type{}); }
    or (sel s.result)      { ret found(c, Role.result{}); }
    or (sel s.id)          { ret found(c, Role.reference{}); }
    or (sel s.word)        { ret skip(c, 1); }
    or (sel s.string)      { ret string(c); }
    or (sel s.number)      { ret skip(c, c.count - c.at); }
    or (sel s.selector)    { ret selector(c); }
    or (sel s.instruction) { ret extended(c); }
    or (sel s.opcode)      { ret spec_op(c); }
    or (sel s.bits)        { ret mask(c, s.bits); }
    or (sel s.value) {
        if (c.at >= c.count) { ret short(); }
        val v: u32 = c.words[c.at];
        c.at = c.at + 1;
        ret parameters(c, s.value, v);
    }
    val first: err[Fail] = one(c, s.pair.first);
    if (sel first.err) { ret first; }
    ret one(c, s.pair.second);
}

fun list(c: *Cursor, ops: *Operand, n: usize) err[Fail] {
    var i: usize = 0;
    for (i < n) {
        val o: *Operand = ?ops[i];
        i = i + 1;
        if (sel o.quantifier.one) {
            val r: err[Fail] = one(c, o.kind);
            if (sel r.err) { ret r; }
            cnt;
        }
        or (sel o.quantifier.optional) {
            if (c.at < c.count) {
                val r: err[Fail] = one(c, o.kind);
                if (sel r.err) { ret r; }
            }
            cnt;
        }
        for (c.at < c.count) {
            val r: err[Fail] = one(c, o.kind);
            if (sel r.err) { ret r; }
        }
    }
    ret err[Fail].ok{};
}

fun begins(b: Bytes, prefix: *u8) bool {
    val n: usize = str_len(prefix);
    if (b.len < n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (b.data[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# what the instruction `ins`, whose ids `ids` from `first` are, tells the
# walk of the module
fun learn(w: *Walker, m: *Module, ins: *Instruction, ids: *Table[Found], first: usize) err[Fail] {
    val words: *u32 = model.operands(m, ins);
    val op:    u32  = ins.opcode::u32;
    if (op == tables.OP_EXT_INST_IMPORT && ins.count >= 2) {
        val name: res[Bytes, Fail] = model.string(?w.name, words, 1, ins.count);
        if (sel name.err) { ret err[Fail].err{name.err}; }
        var what: Imported        = Imported.unknown{};
        val set:  res[*Set, Fail] = grammar.set(w.grammar, name.ok);
        if (sel set.ok)                      { what = Imported.set{set.ok}; }
        or (begins(name.ok, "NonSemantic.")) { what = Imported.ids{}; }
        val r: res[bool, A.Error] = map.insert[u32, Imported](?w.sets, words[0], what);
        if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
        ret err[Fail].ok{};
    }
    if ((op == tables.OP_TYPE_INT || op == tables.OP_TYPE_FLOAT) && ins.count >= 2) {
        val width: u32                = words[1];
        val r:     res[bool, A.Error] = map.insert[u32, u32](?w.widths, words[0], (width + 31) / 32);
        if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
        ret err[Fail].ok{};
    }
    var result_type: opt[u32] = opt[u32].none{};
    var result:      opt[u32] = opt[u32].none{};
    var i:           usize    = first;
    for (i < table.count[Found](ids)) {
        val f: *Found = table.at[Found](ids, table.nth[Found](i));
        if (sel f.role.result_type) { result_type = opt[u32].some{words[f.word]}; }
        if (sel f.role.result)      { result = opt[u32].some{words[f.word]}; }
        i = i + 1;
    }
    if (sel result_type.none) { ret err[Fail].ok{}; }
    if (sel result.none)      { ret err[Fail].ok{}; }
    val ty:    u32       = result_type.some;
    val width: opt[*u32] = map.get[u32, u32](?w.widths, ?ty);
    if (sel width.none) { ret err[Fail].ok{}; }
    val r: res[bool, A.Error] = map.insert[u32, u32](?w.typed, result.some, width.some[0]);
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}

# append to `out` every id the `index`th instruction of `m` holds, in word
# order, and learn what it tells of the module. instructions are walked in
# module order. a refusal names the instruction and leaves `out` as it was
pub fun walk(w: *Walker, m: *Module, index: usize, out: *Table[Found]) err[Fail] {
    val ins:  *Instruction = model.at(m, index);
    val mark: usize        = table.count[Found](out);
    val r:    err[Fail]    = follow(w, m, ins, out, mark);
    if (sel r.err) {
        table.truncate[Found](out, mark);
        ret err[Fail].err{fail.at_offset(fail.in_indexed(r.err, "instruction", index::u64), model.offset(index, ins))};
    }
    ret r;
}

fun follow(w: *Walker, m: *Module, ins: *Instruction, out: *Table[Found], mark: usize) err[Fail] {
    val op: res[*Op, Fail] = grammar.op(w.grammar, ins.opcode::u32);
    if (sel op.err) { ret err[Fail].err{op.err}; }
    var c:      Cursor    = Cursor{w: w, words: model.operands(m, ins), count: ins.count, out: out};
    val walked: err[Fail] = list(?c, op.ok.operands, op.ok.count);
    if (sel walked.err)  { ret err[Fail].err{fail.about(walked.err, op.ok.name)}; }
    if (c.at != c.count) { ret err[Fail].err{fail.about(fail.malformed("an instruction holds more operands than its opcode takes"), op.ok.name)}; }
    ret learn(w, m, ins, out, mark);
}

# append the instruction `opcode` of the `count` words at `words` to `m`
#[testing]
fun add(m: *Module, opcode: u16, words: *u32, count: usize) bool {
    val at: res[*u32, Fail] = model.append(m, opcode, count);
    if (sel at.err) { ret false; }
    var i: usize = 0;
    for (i < count) {
        at.ok[i] = words[i];
        i        = i + 1;
    }
    ret true;
}

# whether walking the `index`th instruction of `m` finds ids at exactly the
# `n` words `at`, the roles `roles` naming result type, result and use as 0,
# 1 and 2
#[testing]
fun finds(w: *Walker, m: *Module, index: usize, at: *usize, roles: *u8, n: usize, out: *Table[Found]) bool {
    table.clear[Found](out);
    val r: err[Fail] = walk(w, m, index, out);
    if (sel r.err || table.count[Found](out) != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        val f:    *Found = table.at[Found](out, table.nth[Found](i));
        var role: u8     = 2;
        if (sel f.role.result_type)              { role = 0; }
        or (sel f.role.result)                   { role = 1; }
        if (f.word != at[i] || role != roles[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test walk__finds_the_ids_every_shape_of_operand_holds {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator       = T.allocator_of(?t);
    val m: res[*Module, Fail] = model.make(a, LITTLE, Header{bound: 40});
    if (sel m.err) { ret 1; }
    val mod: *Module = m.ok;

    # OpDecorate %5 LinkageAttributes "foo" Export: a value's parameters, a
    # string among them
    val decorate: [4]u32 = [4]u32{5, 41, 0x006F_6F66, 0};
    # OpDecorateId %5 AlignmentId %7: a parameter that is an id
    val decorate_id: [3]u32 = [3]u32{5, 46, 7};
    # OpTypeInt %2 64 0, OpConstant %2 %3 and its two words, then
    # OpSwitch %3 %10 with two targets of two-word literals
    val int64:  [3]u32 = [3]u32{2, 64, 0};
    val value:  [4]u32 = [4]u32{2, 3, 1, 0};
    val switch: [8]u32 = [8]u32{3, 10, 1, 0, 11, 2, 0, 12};
    # OpExtInstImport %20 "GLSL.std.450", then OpExtInst %2 %21 %20 Sqrt %3
    val import: [5]u32 = [5]u32{20, 0x4C53_4C47, 0x6474_732E, 0x3035_342E, 0};
    val glsl:   [5]u32 = [5]u32{2, 21, 20, 31, 3};
    # OpLoad %2 %30 %31 Aligned 4: a mask whose bit adds a literal
    val load: [5]u32 = [5]u32{2, 30, 31, 2, 4};
    # OpSpecConstantOp %2 %32 IAdd %3 %3: the named opcode's operands
    val spec: [5]u32 = [5]u32{2, 32, 128, 3, 3};
    # OpEntryPoint GLCompute %33 "m" %34 %35: ids after a string
    val entry: [5]u32 = [5]u32{5, 33, 0x6D, 34, 35};
    if (!add(mod, 71, ?decorate[0], 4) || !add(mod, 332, ?decorate_id[0], 3) || !add(mod, 21, ?int64[0], 3)) { ret 2; }
    if (!add(mod, 43, ?value[0], 4) || !add(mod, 251, ?switch[0], 8) || !add(mod, 11, ?import[0], 5))        { ret 2; }
    if (!add(mod, 12, ?glsl[0], 5) || !add(mod, 61, ?load[0], 5) || !add(mod, 52, ?spec[0], 5))              { ret 2; }
    if (!add(mod, 15, ?entry[0], 5))                                                                         { ret 2; }

    var w:   Walker       = make(a, ?tables.GRAMMAR);
    var out: Table[Found] = table.make[Found](a);
    val a0:  [1]usize     = [1]usize{0};
    val u1:  [1]u8        = [1]u8{2};
    if (!finds(?w, mod, 0, ?a0[0], ?u1[0], 1, ?out)) { ret 3; }
    val a1: [2]usize = [2]usize{0, 2};
    val u2: [2]u8    = [2]u8{2, 2};
    if (!finds(?w, mod, 1, ?a1[0], ?u2[0], 2, ?out)) { ret 4; }
    val r1: [1]u8 = [1]u8{1};
    if (!finds(?w, mod, 2, ?a0[0], ?r1[0], 1, ?out)) { ret 5; }
    val a3: [2]usize = [2]usize{0, 1};
    val t3: [2]u8    = [2]u8{0, 1};
    if (!finds(?w, mod, 3, ?a3[0], ?t3[0], 2, ?out)) { ret 6; }
    val a4: [4]usize = [4]usize{0, 1, 4, 7};
    val u4: [4]u8    = [4]u8{2, 2, 2, 2};
    if (!finds(?w, mod, 4, ?a4[0], ?u4[0], 4, ?out)) { ret 7; }
    if (!finds(?w, mod, 5, ?a0[0], ?r1[0], 1, ?out)) { ret 8; }
    val a6: [4]usize = [4]usize{0, 1, 2, 4};
    val t6: [4]u8    = [4]u8{0, 1, 2, 2};
    if (!finds(?w, mod, 6, ?a6[0], ?t6[0], 4, ?out)) { ret 9; }
    val a7: [3]usize = [3]usize{0, 1, 2};
    val t7: [3]u8    = [3]u8{0, 1, 2};
    if (!finds(?w, mod, 7, ?a7[0], ?t7[0], 3, ?out)) { ret 10; }
    val a8: [4]usize = [4]usize{0, 1, 3, 4};
    if (!finds(?w, mod, 8, ?a8[0], ?t6[0], 4, ?out)) { ret 11; }
    val a9: [3]usize = [3]usize{1, 3, 4};
    val u9: [3]u8    = [3]u8{2, 2, 2};
    if (!finds(?w, mod, 9, ?a9[0], ?u9[0], 3, ?out)) { ret 12; }

    val freed: err[Fail] = table.release[Found](?out);
    val gone:  err[Fail] = release(?w);
    val rel:   err[Fail] = model.release(mod);
    if (sel freed.err || sel gone.err || sel rel.err) { ret 13; }
    if (T.live_count(?t) != 0)                        { ret 14; }
    T.dnit(?t);
    ret 0;
}

# whether every operand of `o` is one id or one literal word
fun plain(o: *Op) bool {
    var i: usize = 0;
    for (i < o.count) {
        val x: *Operand      = ?o.operands[i];
        val s: grammar.Shape = x.kind.shape;
        if (!sel x.quantifier.one)                                          { ret false; }
        if (!(sel s.result_type || sel s.result || sel s.id || sel s.word)) { ret false; }
        i = i + 1;
    }
    ret true;
}

test walk__finds_each_id_of_every_opcode_of_the_table_and_refuses_words_its_shapes_do_not_cover {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator       = T.allocator_of(?t);
    val g: *Grammar           = ?tables.GRAMMAR;
    val m: res[*Module, Fail] = model.make(a, LITTLE, Header{bound: 8});
    if (sel m.err) { ret 1; }
    val mod:  *Module      = m.ok;
    var w:    Walker       = make(a, g);
    var out:  Table[Found] = table.make[Found](a);
    var seen: usize        = 0;
    var i:    usize        = 0;
    for (i < g.count) {
        val o: *Op = ?g.ops[i];
        i = i + 1;
        if (!plain(o)) { cnt; }
        var words: [16]u32;
        val n:     usize = o.count;
        if (n > 16) { ret 2; }
        val index: usize = model.count(mod);
        if (!add(mod, o.code::u16, ?words[0], n)) { ret 2; }
        table.clear[Found](?out);
        val r: err[Fail] = walk(?w, mod, index, ?out);
        if (sel r.err) { ret 3; }
        var k: usize = 0;
        var f: usize = 0;
        for (k < n) {
            val s: grammar.Shape = o.operands[k].kind.shape;
            if (!sel s.word) {
                if (f >= table.count[Found](?out)) { ret 4; }
                val got: *Found = table.at[Found](?out, table.nth[Found](f));
                if (got.word != k)                                     { ret 4; }
                if ((sel s.result_type) != (sel got.role.result_type)) { ret 5; }
                if ((sel s.result) != (sel got.role.result))           { ret 5; }
                f = f + 1;
            }
            k = k + 1;
        }
        if (f != table.count[Found](?out)) { ret 6; }
        seen = seen + 1;
    }
    if (seen < 100) { ret 7; }

    # OpIAdd takes four operands: three are too few and five too many
    var short: [5]u32 = [5]u32{1, 2, 3, 4, 5};
    val at:    usize  = model.count(mod);
    if (!add(mod, 128, ?short[0], 3) || !add(mod, 128, ?short[0], 5)) { ret 8; }
    val few:  err[Fail] = walk(?w, mod, at, ?out);
    val many: err[Fail] = walk(?w, mod, at + 1, ?out);
    if (sel few.ok) { ret 9; }
    val f: Fail = few.err;
    if (!sel f.cause.malformed || !f.at.indexed || f.at.index != at::u64) { ret 9; }
    if (sel many.ok)                                                      { ret 10; }
    val g2: Fail = many.err;
    if (!sel g2.cause.malformed) { ret 10; }

    val freed: err[Fail] = table.release[Found](?out);
    val gone:  err[Fail] = release(?w);
    val rel:   err[Fail] = model.release(mod);
    if (sel freed.err || sel gone.err || sel rel.err) { ret 11; }
    if (T.live_count(?t) != 0)                        { ret 12; }
    T.dnit(?t);
    ret 0;
}
