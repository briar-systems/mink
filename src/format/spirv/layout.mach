# the logical layout of a SPIR-V module
#
# the specification lays a module out in blocks, each holding instructions
# of its own opcodes, in a fixed order: capabilities, extensions, extended
# set imports, the memory model, entry points, execution modes, the three
# blocks of debug instructions, annotations, then types, constants and
# global variables, then function declarations and function definitions. a
# module-scope instruction whose opcode no block below claims is a global,
# and a function is a declaration when it has no body. a link keeps this
# order, block by block. each instruction becomes, or joins, a section of a
# link, whose kind and garbage collection disposition its opcode's row
# names: a decoration, a name or an execution mode lives with what it is
# about, an entry point, a source or a string is a root, as debug
# information marks nothing it names, and the rest is kept while something
# refers to it.

use std.types.size.usize;
use std.types.string.str;

use mink.format.spirv.tables;
use mink.model.section;
use mink.model.section.Disposition;
use mink.model.section.Kind;

# name: the block's spelling in a diagnostic
# rank: where it lies in the layout, lower first
pub rec Block {
    name: str;
    rank: u8;
}

pub val CAPABILITIES:    Block = Block{name: "capabilities", rank: 1};
pub val EXTENSIONS:      Block = Block{name: "extensions", rank: 2};
pub val IMPORTS:         Block = Block{name: "extended instruction set imports", rank: 3};
pub val MEMORY_MODEL:    Block = Block{name: "memory model", rank: 4};
pub val ENTRY_POINTS:    Block = Block{name: "entry points", rank: 5};
pub val EXECUTION_MODES: Block = Block{name: "execution modes", rank: 6};
pub val SOURCES:         Block = Block{name: "debug sources and strings", rank: 7};
pub val NAMES:           Block = Block{name: "debug names", rank: 8};
pub val PROCESSES:       Block = Block{name: "module processing", rank: 9};
pub val ANNOTATIONS:     Block = Block{name: "annotations", rank: 10};
pub val GLOBALS:         Block = Block{name: "types, constants and globals", rank: 11};
pub val DECLARATIONS:    Block = Block{name: "function declarations", rank: 12};
pub val DEFINITIONS:     Block = Block{name: "function definitions", rank: 13};

# every rank below this, zero ranking a run of no instruction ahead of every
# block
pub val RANKS: usize = 14;

# where an opcode's instructions go at module scope
# ---
# opcode:      the opcode
# block:       the block they take
# kind:        the kind of section they become
# disposition: how garbage collection treats it. a dependent one lives with
#              the section defining the id of its first operand
pub rec Placed {
    opcode:      u32;
    block:       *Block;
    kind:        *Kind;
    disposition: *Disposition;
}

# ascending by opcode
val PLACED_COUNT: usize                = 24;
val PLACED:       [PLACED_COUNT]Placed = [PLACED_COUNT]Placed{
    Placed{opcode: tables.OP_SOURCE_CONTINUED, block: ?SOURCES, kind: ?section.DEBUG_INFO, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_SOURCE, block: ?SOURCES, kind: ?section.DEBUG_INFO, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_SOURCE_EXTENSION, block: ?SOURCES, kind: ?section.DEBUG_INFO, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_NAME, block: ?NAMES, kind: ?section.DEBUG_INFO, disposition: ?section.DEPENDENT},
    Placed{opcode: tables.OP_MEMBER_NAME, block: ?NAMES, kind: ?section.DEBUG_INFO, disposition: ?section.DEPENDENT},
    Placed{opcode: tables.OP_STRING, block: ?SOURCES, kind: ?section.DEBUG_INFO, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_EXTENSION, block: ?EXTENSIONS, kind: ?section.METADATA, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_EXT_INST_IMPORT, block: ?IMPORTS, kind: ?section.METADATA, disposition: ?section.WHOLE},
    Placed{opcode: tables.OP_EXT_INST, block: ?GLOBALS, kind: ?section.METADATA, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_MEMORY_MODEL, block: ?MEMORY_MODEL, kind: ?section.METADATA, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_ENTRY_POINT, block: ?ENTRY_POINTS, kind: ?section.METADATA, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_EXECUTION_MODE, block: ?EXECUTION_MODES, kind: ?section.METADATA, disposition: ?section.DEPENDENT},
    Placed{opcode: tables.OP_CAPABILITY, block: ?CAPABILITIES, kind: ?section.METADATA, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_VARIABLE, block: ?GLOBALS, kind: ?section.DATA, disposition: ?section.WHOLE},
    Placed{opcode: tables.OP_DECORATE, block: ?ANNOTATIONS, kind: ?section.METADATA, disposition: ?section.DEPENDENT},
    Placed{opcode: tables.OP_MEMBER_DECORATE, block: ?ANNOTATIONS, kind: ?section.METADATA, disposition: ?section.DEPENDENT},
    Placed{opcode: tables.OP_DECORATION_GROUP, block: ?ANNOTATIONS, kind: ?section.METADATA, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_GROUP_DECORATE, block: ?ANNOTATIONS, kind: ?section.METADATA, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_GROUP_MEMBER_DECORATE, block: ?ANNOTATIONS, kind: ?section.METADATA, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_MODULE_PROCESSED, block: ?PROCESSES, kind: ?section.DEBUG_INFO, disposition: ?section.ROOT},
    Placed{opcode: tables.OP_EXECUTION_MODE_ID, block: ?EXECUTION_MODES, kind: ?section.METADATA, disposition: ?section.DEPENDENT},
    Placed{opcode: tables.OP_DECORATE_ID, block: ?ANNOTATIONS, kind: ?section.METADATA, disposition: ?section.DEPENDENT},
    Placed{opcode: tables.OP_DECORATE_STRING, block: ?ANNOTATIONS, kind: ?section.METADATA, disposition: ?section.DEPENDENT},
    Placed{opcode: tables.OP_MEMBER_DECORATE_STRING, block: ?ANNOTATIONS, kind: ?section.METADATA, disposition: ?section.DEPENDENT},
};

# a module-scope instruction no row names: a type, a constant or another global
val GLOBAL: Placed = Placed{block: ?GLOBALS, kind: ?section.RODATA, disposition: ?section.WHOLE};

# a function with a body, from OpFunction to OpFunctionEnd
pub val FUNCTION: Placed = Placed{block: ?DEFINITIONS, kind: ?section.TEXT, disposition: ?section.WHOLE};

# a function without a body, which a module defines elsewhere or imports
pub val DECLARATION: Placed = Placed{block: ?DECLARATIONS, kind: ?section.TEXT, disposition: ?section.WHOLE};

# where an instruction of `opcode` goes at module scope, outside a function
pub fun placed(opcode: u32) *Placed {
    var lo: usize = 0;
    var hi: usize = PLACED_COUNT;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val at:  u32   = PLACED[mid].opcode;
        if (at == opcode) { ret ?PLACED[mid]; }
        if (at < opcode)  { lo = mid + 1; }
        or                { hi = mid; }
    }
    ret ?GLOBAL;
}
