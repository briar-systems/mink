# the facts a SPIR-V module states of itself and how a link combines them
#
# a module states its generator, each capability and each extension it
# declares as a fact. the generator names the tool that wrote one module, so
# it travels with its input and a linked module states none. capabilities,
# told apart by value, and extensions, told apart by their names, are each
# carried once, the union of what every input declares.

use std.types.size.usize;

use mink.catalog.merge;
use mink.catalog.merge.Rule;
use mink.catalog.merge.Rules;

# the facts a module states of itself, by key
# ---
# GENERATOR:  its header's generator word, none for a generator of zero
# CAPABILITY: a capability it declares, the value naming it
# EXTENSION:  an extension it declares, the data naming it
pub val GENERATOR:  u32 = 1;
pub val CAPABILITY: u32 = 2;
pub val EXTENSION:  u32 = 3;

val FACT_COUNT: usize            = 3;
val FACT_ROWS:  [FACT_COUNT]Rule = [FACT_COUNT]Rule{
    Rule{key: GENERATOR, by: ?merge.BY_KEY, merge: ?merge.LOCAL},
    Rule{key: CAPABILITY, by: ?merge.BY_VALUE, merge: ?merge.UNION},
    Rule{key: EXTENSION, by: ?merge.BY_DATA, merge: ?merge.UNION},
};

pub val FACTS: Rules = Rules{rows: ?FACT_ROWS[0], count: FACT_COUNT};
