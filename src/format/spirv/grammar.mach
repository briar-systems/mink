# the shape of the SPIR-V grammar mink carries
#
# a linker finds every id of every instruction to renumber it, and the
# words of an instruction say nothing of which they are, so mink carries the
# operand shapes of the grammar: for each opcode the kinds of its operands in
# order, for each enumerant that takes parameters the operands they add, and
# for each extended instruction set its instructions' operands. nothing else
# of the grammar is carried. the rows are generated into
# mink.format.spirv.tables from the vendored grammar, and these are their
# records and lookups.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;

# how many times an operand occurs
# ---
# one:      exactly once
# optional: once or not at all, and only trailing operands follow it
# many:     any number of times, the last operand of its list
pub tag Quantifier: u8 {
    one;
    optional;
    many;
}

# what the words of an operand of a kind are
# ---
# result_type: one word, the id of the result's type
# result:      one word, the id the instruction defines
# id:          one word, an id the instruction uses
# word:        one literal word
# string:      a nul-terminated string padded with zeros to a whole word
# number:      a literal as many words wide as the instruction's result type
# selector:    a literal as many words wide as the type of the instruction's
#              first operand, as OpSwitch's are
# instruction: one word naming an instruction of the extended set the
#              preceding id imports, whose operands follow
# opcode:      one word naming an opcode, whose operands past its result type
#              and result follow
# value:       one word, a value of the enum, followed by the operands of the
#              enumerant it names
# bits:        one word, a mask of the enum, followed by the operands of each
#              enumerant whose bit it sets, lowest bit first
# pair:        two operands, of the pair's kinds in order
pub tag Shape: u8 {
    result_type;
    result;
    id;
    word;
    string;
    number;
    selector;
    instruction;
    opcode;
    value: *Enum;
    bits:  *Enum;
    pair:  *Pair;
}

# name:  the kind's name in the grammar
# shape: what its words are
pub rec Kind {
    name:  str;
    shape: Shape;
}

# the two kinds a pair is
pub rec Pair {
    first:  *Kind;
    second: *Kind;
}

pub rec Operand {
    kind:       *Kind;
    quantifier: Quantifier;
}

# an enumerant that takes parameters, as one that takes none adds no operand
# ---
# value:    its value, or its bit for a mask
# name:     its name in the grammar
# operands: the operands it adds
# count:    how many
pub rec Enumerant {
    value:    u32;
    name:     str;
    operands: *Operand;
    count:    usize;
}

# the enumerants of an enum that take parameters, ascending by value
pub rec Enum {
    enumerants: *Enumerant;
    count:      usize;
}

# code:     the opcode
# name:     its name in the grammar, for a diagnostic
# operands: its operands in order
# count:    how many
pub rec Op {
    code:     u32;
    name:     str;
    operands: *Operand;
    count:    usize;
}

# an instruction of an extended instruction set
# ---
# number:   its number in the set
# name:     its name in the set's grammar
# operands: the operands that follow its number
# count:    how many
pub rec Instruction {
    number:   u32;
    name:     str;
    operands: *Operand;
    count:    usize;
}

# an extended instruction set
# ---
# name:         the name an OpExtInstImport imports it by
# instructions: its instructions, ascending by number
# count:        how many
pub rec Set {
    name:         str;
    instructions: *Instruction;
    count:        usize;
}

# ops:       every opcode, ascending by code
# count:     how many
# sets:      the extended instruction sets, ascending by name
# set_count: how many
pub rec Grammar {
    ops:       *Op;
    count:     usize;
    sets:      *Set;
    set_count: usize;
}

# the opcode `code`, refused naming it when the grammar has none
pub fun op(g: *Grammar, code: u32) res[*Op, Fail] {
    var lo: usize = 0;
    var hi: usize = g.count;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val at:  *Op   = ?g.ops[mid];
        if (at.code == code) { ret res[*Op, Fail].ok{at}; }
        if (at.code < code)  { lo = mid + 1; }
        or                   { hi = mid; }
    }
    ret res[*Op, Fail].err{fail.valued(fail.unsupported("the SPIR-V grammar has no such opcode"), code::i128)};
}

# how the string `s` orders against the bytes `b`, byte by byte and then the
# shorter first
fun compare_name(s: str, b: Bytes) i64 {
    var i: usize = 0;
    for (i < b.len) {
        if (s[i] == 0)        { ret -1; }
        if (s[i] < b.data[i]) { ret -1; }
        if (s[i] > b.data[i]) { ret 1; }
        i = i + 1;
    }
    if (s[i] != 0) { ret 1; }
    ret 0;
}

# the extended instruction set imported by `name`, refused when the grammar
# carries none of that name
pub fun set(g: *Grammar, name: Bytes) res[*Set, Fail] {
    var lo: usize = 0;
    var hi: usize = g.set_count;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val at:  *Set  = ?g.sets[mid];
        val c:   i64   = compare_name(at.name, name);
        if (c == 0) { ret res[*Set, Fail].ok{at}; }
        if (c < 0)  { lo = mid + 1; }
        or          { hi = mid; }
    }
    ret res[*Set, Fail].err{fail.unsupported("the SPIR-V grammar has no such extended instruction set")};
}

# the instruction `number` of `s`, refused naming it when the set has none
pub fun instruction(s: *Set, number: u32) res[*Instruction, Fail] {
    var lo: usize = 0;
    var hi: usize = s.count;
    for (lo < hi) {
        val mid: usize        = lo + (hi - lo) / 2;
        val at:  *Instruction = ?s.instructions[mid];
        if (at.number == number) { ret res[*Instruction, Fail].ok{at}; }
        if (at.number < number)  { lo = mid + 1; }
        or                       { hi = mid; }
    }
    ret res[*Instruction, Fail].err{fail.about(fail.valued(fail.unsupported("the extended instruction set has no such instruction"), number::i128), s.name)};
}

# the enumerant `value` of `e` that takes parameters, nil for a value whose
# enumerant takes none
pub fun enumerant(e: *Enum, value: u32) *Enumerant {
    var lo: usize = 0;
    var hi: usize = e.count;
    for (lo < hi) {
        val mid: usize      = lo + (hi - lo) / 2;
        val at:  *Enumerant = ?e.enumerants[mid];
        if (at.value == value) { ret at; }
        if (at.value < value)  { lo = mid + 1; }
        or                     { hi = mid; }
    }
    ret nil;
}

# whether the enumerants of `e` ascend by value and their operands are sound
fun sound_enum(e: *Enum) bool {
    var i: usize = 0;
    for (i < e.count) {
        val n: *Enumerant = ?e.enumerants[i];
        if (i > 0 && e.enumerants[i - 1].value >= n.value) { ret false; }
        if (!sound_operands(n.operands, n.count))          { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the `count` operands at `at` each name a sound kind, only the last
# may repeat, and only operands that may be absent follow one that may be
fun sound_operands(at: *Operand, count: usize) bool {
    var absent: bool  = false;
    var i:      usize = 0;
    for (i < count) {
        val o: *Operand = ?at[i];
        if (o.kind == nil)                           { ret false; }
        if (sel o.quantifier.many && i + 1 != count) { ret false; }
        if (sel o.quantifier.one && absent)          { ret false; }
        if (!sel o.quantifier.one)                   { absent = true; }
        val k: *Kind = o.kind;
        if (sel k.shape.value && !sound_enum(k.shape.value))                               { ret false; }
        if (sel k.shape.bits && !sound_enum(k.shape.bits))                                 { ret false; }
        if (sel k.shape.pair && (k.shape.pair.first == nil || k.shape.pair.second == nil)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether `g` is sound: its opcodes, sets, instructions and enumerants ascend
# by their keys and every operand names a kind
pub fun sound(g: *Grammar) bool {
    var i: usize = 0;
    for (i < g.count) {
        val o: *Op = ?g.ops[i];
        if (i > 0 && g.ops[i - 1].code >= o.code) { ret false; }
        if (!sound_operands(o.operands, o.count)) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < g.set_count) {
        val s: *Set = ?g.sets[i];
        if (i > 0 && str_compare(g.sets[i - 1].name, s.name) >= 0) { ret false; }
        var k: usize = 0;
        for (k < s.count) {
            val n: *Instruction = ?s.instructions[k];
            if (k > 0 && s.instructions[k - 1].number >= n.number) { ret false; }
            if (!sound_operands(n.operands, n.count))              { ret false; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret true;
}
