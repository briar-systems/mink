# the SPIR-V grammar mink carries
#
# a linker finds every id of every instruction to renumber it, and the
# words of an instruction say nothing of which they are, so mink carries the
# operand shapes of the grammar: for each opcode the kinds of its operands in
# order, for each enumerant the operands it adds, and for each extended
# instruction set its instructions' operands. beside the shapes it carries
# the rest of what the grammar states: every enumerant's name and value, the
# availability and aliases of every instruction and enumerant, each
# instruction's class, operand names and the grammar's version, so an
# encoder or an assembler of SPIR-V reads the grammar from mink alone. the
# rows are generated into mink.format.spirv.tables from the vendored
# grammar, and these are their records and lookups. both modules are public.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;

# how many times an operand occurs
# ---
# one:      exactly once
# optional: once or not at all, and only trailing operands follow it
# many:     any number of times, the last operand of its list
pub tag Quantifier: u8 {
    one;
    optional;
    many;
}

# what the words of an operand of a kind are
# ---
# result_type: one word, the id of the result's type
# result:      one word, the id the instruction defines
# id:          one word, an id the instruction uses
# word:        one literal word
# string:      a nul-terminated string padded with zeros to a whole word
# number:      a literal as many words wide as the instruction's result type
# selector:    a literal as many words wide as the type of the instruction's
#              first operand, as OpSwitch's are
# instruction: one word naming an instruction of the extended set the
#              preceding id imports, whose operands follow
# opcode:      one word naming an opcode, whose operands past its result type
#              and result follow
# value:       one word, a value of the enum, followed by the operands of the
#              enumerant it names
# bits:        one word, a mask of the enum, followed by the operands of each
#              enumerant whose bit it sets, lowest bit first
# pair:        two operands, of the pair's kinds in order
pub tag Shape: u8 {
    result_type;
    result;
    id;
    word;
    string;
    number;
    selector;
    instruction;
    opcode;
    value: *Enum;
    bits:  *Enum;
    pair:  *Pair;
}

# name:  the kind's name in the grammar
# shape: what its words are
pub rec Kind {
    name:  str;
    shape: Shape;
}

# the two kinds a pair is
pub rec Pair {
    first:  *Kind;
    second: *Kind;
}

# kind:       its kind
# quantifier: how many times it occurs
# name:       its name in the grammar, nil where the grammar names none
pub rec Operand {
    kind:       *Kind;
    quantifier: Quantifier;
    name:       str;
}

# what makes an instruction or an enumerant available, as the grammar states
# it. a version is written as the version word of a module's header encodes
# one (SPIR-V 2.3, Physical Layout): the major number in bits 16 to 23 and
# the minor in bits 8 to 15
# ---
# version:          the first core version that holds it, 0 for none, as
#                   the grammar states for what only an extension brings
# last:             the last core version that holds it, 0 for every one
#                   since
# extensions:       the extensions that bring it
# extension_count:  how many
# capabilities:     the capabilities, any one of which enables it
# capability_count: how many
pub rec Availability {
    version:          u32;
    last:             u32;
    extensions:       *str;
    extension_count:  usize;
    capabilities:     *str;
    capability_count: usize;
}

# an enumerant of an enum
# ---
# value:        its value, or its bit for a mask
# name:         its name in the grammar
# operands:     the operands it adds, none for most
# count:        how many
# availability: what makes it available
# aliases:      its further names
# alias_count:  how many
pub rec Enumerant {
    value:        u32;
    name:         str;
    operands:     *Operand;
    count:        usize;
    availability: Availability;
    aliases:      *str;
    alias_count:  usize;
}

# every enumerant of an enum, ascending by value
pub rec Enum {
    enumerants: *Enumerant;
    count:      usize;
}

# code:         the opcode
# name:         its name in the grammar
# class:        the class the grammar files it under, as Memory or Atomic
# operands:     its operands in order
# count:        how many
# availability: what makes it available
# aliases:      its further names
# alias_count:  how many
pub rec Op {
    code:         u32;
    name:         str;
    class:        str;
    operands:     *Operand;
    count:        usize;
    availability: Availability;
    aliases:      *str;
    alias_count:  usize;
}

# an instruction of an extended instruction set
# ---
# number:       its number in the set
# name:         its name in the set's grammar
# operands:     the operands that follow its number
# count:        how many
# availability: what makes it available
pub rec Instruction {
    number:       u32;
    name:         str;
    operands:     *Operand;
    count:        usize;
    availability: Availability;
}

# an extended instruction set
# ---
# name:         the name an OpExtInstImport imports it by
# version:      the version its grammar states
# revision:     the revision its grammar states
# instructions: its instructions, ascending by number
# count:        how many
pub rec Set {
    name:         str;
    version:      u32;
    revision:     u32;
    instructions: *Instruction;
    count:        usize;
}

# major:      the major number of the SPIR-V version the grammar states
# minor:      its minor number
# revision:   the grammar's revision
# kinds:      every operand kind, ascending by name
# kind_count: how many
# ops:        every opcode, ascending by code
# count:      how many
# sets:       the extended instruction sets, ascending by name
# set_count:  how many
pub rec Grammar {
    major:      u32;
    minor:      u32;
    revision:   u32;
    kinds:      **Kind;
    kind_count: usize;
    ops:        *Op;
    count:      usize;
    sets:       *Set;
    set_count:  usize;
}

# the major number of the version word `version`
pub fun version_major(version: u32) u32 {
    ret (version >> 16) & 0xFF;
}

# the minor number of the version word `version`
pub fun version_minor(version: u32) u32 {
    ret (version >> 8) & 0xFF;
}

# the operand kind named `name`, refused when the grammar declares none
pub fun kind(g: *Grammar, name: str) res[*Kind, Fail] {
    var lo: usize = 0;
    var hi: usize = g.kind_count;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val at:  *Kind = g.kinds[mid];
        val c:   i64   = str_compare(at.name, name);
        if (c == 0) { ret res[*Kind, Fail].ok{at}; }
        if (c < 0)  { lo = mid + 1; }
        or          { hi = mid; }
    }
    ret res[*Kind, Fail].err{fail.about(fail.unsupported("the SPIR-V grammar has no such operand kind"), name)};
}

# the opcode `code`, refused naming it when the grammar has none
pub fun op(g: *Grammar, code: u32) res[*Op, Fail] {
    var lo: usize = 0;
    var hi: usize = g.count;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val at:  *Op   = ?g.ops[mid];
        if (at.code == code) { ret res[*Op, Fail].ok{at}; }
        if (at.code < code)  { lo = mid + 1; }
        or                   { hi = mid; }
    }
    ret res[*Op, Fail].err{fail.valued(fail.unsupported("the SPIR-V grammar has no such opcode"), code::i128)};
}

# the extended instruction set imported by `name`, refused when the grammar
# carries none of that name
pub fun set(g: *Grammar, name: Bytes) res[*Set, Fail] {
    var lo: usize = 0;
    var hi: usize = g.set_count;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val at:  *Set  = ?g.sets[mid];
        val c:   i64   = store.compare_text(at.name, name);
        if (c == 0) { ret res[*Set, Fail].ok{at}; }
        if (c < 0)  { lo = mid + 1; }
        or          { hi = mid; }
    }
    ret res[*Set, Fail].err{fail.unsupported("the SPIR-V grammar has no such extended instruction set")};
}

# the instruction `number` of `s`, refused naming it when the set has none
pub fun instruction(s: *Set, number: u32) res[*Instruction, Fail] {
    var lo: usize = 0;
    var hi: usize = s.count;
    for (lo < hi) {
        val mid: usize        = lo + (hi - lo) / 2;
        val at:  *Instruction = ?s.instructions[mid];
        if (at.number == number) { ret res[*Instruction, Fail].ok{at}; }
        if (at.number < number)  { lo = mid + 1; }
        or                       { hi = mid; }
    }
    ret res[*Instruction, Fail].err{fail.about(fail.valued(fail.unsupported("the extended instruction set has no such instruction"), number::i128), s.name)};
}

# the enumerant `value` of `e`, nil for a value the enum names none for
pub fun enumerant(e: *Enum, value: u32) *Enumerant {
    var lo: usize = 0;
    var hi: usize = e.count;
    for (lo < hi) {
        val mid: usize      = lo + (hi - lo) / 2;
        val at:  *Enumerant = ?e.enumerants[mid];
        if (at.value == value) { ret at; }
        if (at.value < value)  { lo = mid + 1; }
        or                     { hi = mid; }
    }
    ret nil;
}

# whether the enumerants of `e` ascend by value and their operands are sound
fun sound_enum(e: *Enum) bool {
    var i: usize = 0;
    for (i < e.count) {
        val n: *Enumerant = ?e.enumerants[i];
        if (i > 0 && e.enumerants[i - 1].value >= n.value) { ret false; }
        if (!sound_operands(n.operands, n.count))          { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the `count` operands at `at` each name a sound kind, only the last
# may repeat, and only operands that may be absent follow one that may be
fun sound_operands(at: *Operand, count: usize) bool {
    var absent: bool  = false;
    var i:      usize = 0;
    for (i < count) {
        val o: *Operand = ?at[i];
        if (o.kind == nil)                           { ret false; }
        if (sel o.quantifier.many && i + 1 != count) { ret false; }
        if (sel o.quantifier.one && absent)          { ret false; }
        if (!sel o.quantifier.one)                   { absent = true; }
        val k: *Kind = o.kind;
        if (sel k.shape.value && !sound_enum(k.shape.value))                               { ret false; }
        if (sel k.shape.bits && !sound_enum(k.shape.bits))                                 { ret false; }
        if (sel k.shape.pair && (k.shape.pair.first == nil || k.shape.pair.second == nil)) { ret false; }
        i = i + 1;
    }
    ret true;
}
