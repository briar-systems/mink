# a SPIR-V module assembled from runs of instruction words
#
# what a module states outside its sections comes first, as its logical
# layout puts it: the capabilities and extensions the caller states, then
# each run of instructions in the order given, and the memory model
# instruction, written from the addressing and memory models the caller
# states, before the first instruction of a block after its own. the
# caller states those three, so a run holding a capability, an extension or
# a memory model instruction of its own is refused. a module built from one
# neutral object and a module a link writes are both assembled here, each
# arranging its runs by the block that `rank_of` says they open.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.format.spirv.layout;
use mink.format.spirv.model;
use mink.format.spirv.model.Module;
use mink.format.spirv.tables;

# m:          the module the instructions are appended to, borrowed
# addressing: the addressing model word the memory model instruction holds
# memory:     the memory model word it holds
# begun:      whether a run has been appended
# modelled:   whether the memory model instruction is written yet
pub rec Assembler {
    m:          *Module;
    addressing: u32;
    memory:     u32;
    begun:      bool;
    modelled:   bool;
}

pub fun make(m: *Module, addressing: u32, memory: u32) Assembler {
    ret Assembler{m: m, addressing: addressing, memory: memory, begun: false, modelled: false};
}

# append the capability `value`, refused once a run is appended
pub fun capability(s: *Assembler, value: u32) err[Fail] {
    if (s.begun) { ret err[Fail].err{fail.internal("a capability follows the instructions of a module")}; }
    val at: res[*u32, Fail] = model.append(s.m, tables.OP_CAPABILITY::u16, 1);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    at.ok[0] = value;
    ret err[Fail].ok{};
}

# append the extension named `name`, refused once a run is appended
pub fun extension(s: *Assembler, name: Bytes) err[Fail] {
    if (s.begun) { ret err[Fail].err{fail.internal("an extension follows the instructions of a module")}; }
    val n:  usize           = model.string_words(name.len);
    val at: res[*u32, Fail] = model.append(s.m, tables.OP_EXTENSION::u16, n);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    var i: usize = 0;
    for (i < name.len) {
        at.ok[i / model.WORD] = at.ok[i / model.WORD] | (name.data[i]::u32 << ((i % model.WORD) * 8)::u32);
        i                     = i + 1;
    }
    ret err[Fail].ok{};
}

fun model_memory(s: *Assembler) err[Fail] {
    val at: res[*u32, Fail] = model.append(s.m, tables.OP_MEMORY_MODEL::u16, 2);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    at.ok[0]   = s.addressing;
    at.ok[1]   = s.memory;
    s.modelled = true;
    ret err[Fail].ok{};
}

# append the instructions of the run of `n` words at `words`, each led by its
# word count and opcode, the memory model instruction before the first of a
# block after its own. a refusal names the offset in the run
pub fun run(s: *Assembler, words: *u32, n: usize) err[Fail] {
    s.begun = true;
    var i: usize = 0;
    for (i < n) {
        val lead:  u32   = words[i];
        val count: usize = (lead >> 16)::usize;
        val at:    u64   = (i * model.WORD)::u64;
        if (count == 0 || count > n - i) { ret err[Fail].err{fail.at_offset(fail.malformed("an instruction of a section runs past its end"), at)}; }
        val op: u32 = lead & 0xFFFF;
        if (op == tables.OP_MEMORY_MODEL) { ret err[Fail].err{fail.at_offset(fail.malformed("a section holds a memory model instruction, which the object's traits state"), at)}; }
        if (op == tables.OP_CAPABILITY)   { ret err[Fail].err{fail.at_offset(fail.malformed("a section holds a capability, which the object's facts state"), at)}; }
        if (op == tables.OP_EXTENSION)    { ret err[Fail].err{fail.at_offset(fail.malformed("a section holds an extension, which the object's facts state"), at)}; }
        if (!s.modelled && layout.placed(op).block.rank > layout.MEMORY_MODEL.rank) {
            val modelled: err[Fail] = model_memory(s);
            if (sel modelled.err) { ret modelled; }
        }
        val to: res[*u32, Fail] = model.append(s.m, op::u16, count - 1);
        if (sel to.err) { ret err[Fail].err{to.err}; }
        var j: usize = 1;
        for (j < count) {
            to.ok[j - 1] = words[i + j];
            j            = j + 1;
        }
        i = i + count;
    }
    ret err[Fail].ok{};
}

# append the memory model instruction when no run held a later block
pub fun finish(s: *Assembler) err[Fail] {
    if (s.modelled) { ret err[Fail].ok{}; }
    ret model_memory(s);
}

# the `i`th word of the little endian words `c`
pub fun word_at(c: Bytes, i: usize) u32 {
    val p: *u8 = ?c.data[i * model.WORD];
    ret p[0]::u32 | (p[1]::u32 << 8) | (p[2]::u32 << 16) | (p[3]::u32 << 24);
}

# the rank of the block the little endian words `c` open, by their first
# instruction that is no line instruction, zero for words of none
pub fun rank_of(c: Bytes) u8 {
    val n: usize = c.len / model.WORD;
    var i: usize = 0;
    for (i < n) {
        val lead:  u32   = word_at(c, i);
        val op:    u32   = lead & 0xFFFF;
        val words: usize = (lead >> 16)::usize;
        if (words == 0) { ret 0; }
        if (op == tables.OP_LINE || op == tables.OP_NO_LINE) {
            i = i + words;
            cnt;
        }
        if (op != tables.OP_FUNCTION) { ret layout.placed(op).block.rank; }
        for (i < n) {
            val inner: u32   = word_at(c, i);
            val count: usize = (inner >> 16)::usize;
            if ((inner & 0xFFFF) == tables.OP_LABEL) { ret layout.FUNCTION.block.rank; }
            if (count == 0)                          { ret 0; }
            i = i + count;
        }
        ret layout.DECLARATION.block.rank;
    }
    ret 0;
}
