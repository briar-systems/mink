# the SPIR-V module model
#
# a module is a header of five words and a stream of instructions, each a
# word holding its word count and opcode followed by its operand words. the
# model keeps every word as written, decoded to numbers, and the byte order
# the module was written in, so writing it gives back the bytes it was read
# from in either order. the operand words of every instruction lie in one
# table in instruction order, so where an instruction lies in the module
# follows from where its operands lie.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.Order;
use mink.catalog.arch;
use mink.catalog.arch.Stated;
use mink.catalog.format;

# the magic number, the first word of every module
pub val MAGIC: u32 = 0x0723_0203;
# the magic number as a module of the other byte order reads
pub val MAGIC_SWAPPED: u32   = 0x0302_2307;
pub val HEADER_WORDS:  usize = 5;
pub val WORD:          usize = 4;
# the most words an instruction's word count states
pub val MAX_WORDS: usize = 0xFFFF;

# the header words after the magic number
# ---
# version:   the version of the specification, as 0, major, minor, 0
# generator: the tool that generated the module
# bound:     every id of the module is below it
# schema:    reserved for an instruction schema, zero
pub rec Header {
    version:   u32;
    generator: u32;
    bound:     u32;
    schema:    u32;
}

# opcode: its opcode, as written
# first:  where its first operand word lies among the module's words
# count:  how many operand words it holds
pub rec Instruction {
    opcode: u16;
    first:  usize;
    count:  usize;
}

# a:            the allocator it lives in
# order:        the byte order it is written in
# header:       its header
# words:        the operand words of every instruction, in instruction order
# instructions: its instructions, in module order
pub rec Module {
    a:            *A.Allocator;
    order:        Order;
    header:       Header;
    words:        Table[u32];
    instructions: Table[Instruction];
}

# an empty module of `header` in `order`, given back with `release`
# what a module states in the field SPIR-V codes an architecture by, its
# magic number, which every module states and the reader reads in the
# module's byte order
pub fun stated(m: *Module) Stated {
    var s: Stated = Stated{format: ?format.SPIRV, count: 1};
    s.values[arch.SPIRV_MAGIC::usize] = MAGIC::u64;
    ret s;
}

pub fun make(a: *A.Allocator, order: Order, header: Header) res[*Module, Fail] {
    val m: res[*Module, A.Error] = A.allocate[Module](a, 1);
    if (sel m.err) { ret res[*Module, Fail].err{fail.refused(m.err)}; }
    @m.ok = Module{a: a, order: order, header: header, words: table.make[u32](a), instructions: table.make[Instruction](a)};
    ret res[*Module, Fail].ok{m.ok};
}

# the first word of an instruction `opcode` of `count` operand words, its word
# count and opcode, refused when the word count cannot state it
pub fun lead(opcode: u16, count: usize) res[u32, Fail] {
    if (count >= MAX_WORDS) {
        ret res[u32, Fail].err{fail.valued(fail.overflow("an instruction holds more words than its word count states"), count::i128)};
    }
    ret res[u32, Fail].ok{(((count + 1)::u32) << 16) | opcode::u32};
}

# append the instruction `opcode` of `count` operand words, zeroed for the
# caller to fill, and give back where they lie, valid until the module next
# grows. refused when its word count cannot state it, and leaving the module
# as it was on any refusal
pub fun append(m: *Module, opcode: u16, count: usize) res[*u32, Fail] {
    val stated: res[u32, Fail] = lead(opcode, count);
    if (sel stated.err) { ret res[*u32, Fail].err{stated.err}; }
    val first: usize     = table.count[u32](?m.words);
    val room:  err[Fail] = table.reserve[Instruction](?m.instructions, 1);
    if (sel room.err) { ret res[*u32, Fail].err{room.err}; }
    val grown: res[Id[u32], Fail] = table.grow[u32](?m.words, count);
    if (sel grown.err) { ret res[*u32, Fail].err{grown.err}; }
    val p: res[Id[Instruction], Fail] = table.push[Instruction](?m.instructions, Instruction{opcode: opcode, first: first, count: count});
    if (sel p.err) {
        table.truncate[u32](?m.words, first);
        ret res[*u32, Fail].err{p.err};
    }
    ret res[*u32, Fail].ok{?table.items[u32](?m.words)[first]};
}

pub fun count(m: *Module) usize {
    ret table.count[Instruction](?m.instructions);
}

# the `index`th instruction
pub fun at(m: *Module, index: usize) *Instruction {
    ret table.at[Instruction](?m.instructions, table.nth[Instruction](index));
}

# the operand words of `i`, valid until the module next grows
pub fun operands(m: *Module, i: *Instruction) *u32 {
    ret ?table.items[u32](?m.words)[i.first];
}

# the byte offset in the module of the `index`th instruction, `i`
pub fun offset(index: usize, i: *Instruction) u64 {
    ret ((HEADER_WORDS + i.first + index) * WORD)::u64;
}

# the string the words of `words` from `from` up to `count` hold, its bytes
# decoded into `scratch` without the nul, valid until `scratch` next changes
pub fun string(scratch: *Table[u8], words: *u32, from: usize, count: usize) res[Bytes, Fail] {
    table.clear[u8](scratch);
    var k: usize = from;
    for (k < count) {
        var b: u32 = 0;
        for (b < 4) {
            val byte: u8 = ((words[k] >> (b * 8)) & 0xFF)::u8;
            if (byte == 0) { ret res[Bytes, Fail].ok{Bytes{data: table.items[u8](scratch), len: table.count[u8](scratch)}}; }
            val p: res[Id[u8], Fail] = table.push[u8](scratch, byte);
            if (sel p.err) { ret res[Bytes, Fail].err{p.err}; }
            b = b + 1;
        }
        k = k + 1;
    }
    ret res[Bytes, Fail].err{fail.malformed("a string runs past the end of its instruction")};
}

# how many words a string of `len` bytes takes with its nul
pub fun string_words(len: usize) usize {
    ret len / WORD + 1;
}

pub fun release(m: *Module) err[Fail] {
    val a: *A.Allocator = m.a;
    val w: err[Fail]    = table.release[u32](?m.words);
    val i: err[Fail]    = table.release[Instruction](?m.instructions);
    val r: err[A.Error] = A.deallocate[Module](a, m, 1);
    if (sel w.err) { ret w; }
    if (sel i.err) { ret i; }
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}
