# the SPIR-V relocation row and its pair
#
# a SPIR-V module has no addresses: every reference is an id, one word, and
# a link renumbers them. so the pair has one row, an id word that holds the
# index its target takes in the id space, written in the module's words.

use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail.Fail;

use mink.catalog.arch.spirv;
use mink.catalog.format;
use mink.format.pair;
use mink.format.pair.Pair;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.compute;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row;
use mink.reloc.row.Addend;
use mink.reloc.row.FieldChoice;
use mink.reloc.row.Row;

# an id word, the index of its target in the id space
pub val ID: Kind = Kind{name: "id", caps: reloc.INDEX, takes: ?reloc.NAMED};

# the key the id row is written and read by. a module holds no relocation
# records, so the key is the pair's own
pub val ID_KEY: u32 = 0;

val WORD_PIECE: [1]Piece       = [1]Piece{Piece{at: 0, width: 32}};
val WORD:       Field          = Field{bytes: 4, pieces: ?WORD_PIECE[0], count: 1};
val WORD_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?WORD}};
val U32:        Range          = Range{check: field.Check.unsigned{}, bits: 32, align: 1};

val ROWS: [1]Row = [1]Row{
    Row{key: ID_KEY, name: "id", kind: ?ID, fields: ?WORD_FIELD[0], field_count: 1, value: ?compute.INDEX, range: U32, addend: Addend.none{}},
};

val KINDS: [1]*Kind = [1]*Kind{?ID};

pub val RELOCS: row.Set = row.Set{format: ?format.SPIRV, arch: ?spirv.SPIRV, rows: ?ROWS[0], count: 1, kinds: ?KINDS[0], kind_count: 1};

pub val PAIR_COUNT: usize            = 1;
pub val PAIRS:      [PAIR_COUNT]Pair = [PAIR_COUNT]Pair{
    Pair{arch: ?spirv.SPIRV, code: ?spirv.SPIRV_CODES[0], key_of: pair.code_key, relocs: ?RELOCS},
};

# an index of the pair's relocation rows, for a test below the format
# registry, which owns the one index a process converts with. the index is
# released with `row.release`
#[testing]
pub fun index(a: *A.Allocator) res[row.Registry, Fail] {
    var sets: [1]*row.Set = [1]*row.Set{?RELOCS};
    ret row.make(a, ?sets[0], 1);
}
