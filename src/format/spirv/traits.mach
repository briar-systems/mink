# how a SPIR-V module encodes the trait axes of its architecture
#
# the header's version word states the version, the memory model
# instruction states the addressing model and the memory model, and the
# magic number states the byte order, each a word one row below maps to a
# choice of its axis, the byte order's word the order itself. a module states
# all four, though an object may leave the byte order to its axis's absent
# value, and no section of a module holds traits, so an assembler states them
# on the object and never writes the memory model instruction itself.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table.Table;
use mink.bytes.reader.BIG;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Order;
use mink.catalog.arch.Arch;
use mink.catalog.arch.spirv;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Choice;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.format.contract.Encoding;
use mink.format.contract.Tag;
use mink.format.contract.TraitCodec;
use mink.format.contract.Written;
use mink.format.spirv.tables;

# a word a module writes for a choice of an axis
pub rec Word {
    axis:   *Axis;
    choice: *Choice;
    word:   u32;
}

# every word of every axis, by axis then word
val WORD_COUNT: usize            = 17;
val WORDS:      [WORD_COUNT]Word = [WORD_COUNT]Word{
    Word{axis: ?spirv.SPIRV_ADDRESSING_MODEL, choice: ?spirv.SPIRV_LOGICAL, word: tables.ADDRESSING_LOGICAL},
    Word{axis: ?spirv.SPIRV_ADDRESSING_MODEL, choice: ?spirv.SPIRV_PHYSICAL32, word: tables.ADDRESSING_PHYSICAL32},
    Word{axis: ?spirv.SPIRV_ADDRESSING_MODEL, choice: ?spirv.SPIRV_PHYSICAL64, word: tables.ADDRESSING_PHYSICAL64},
    Word{axis: ?spirv.SPIRV_ADDRESSING_MODEL, choice: ?spirv.SPIRV_PHYSICAL_STORAGE_BUFFER64, word: tables.ADDRESSING_PHYSICAL_STORAGE_BUFFER64},
    Word{axis: ?spirv.SPIRV_BYTE_ORDER, choice: ?spirv.SPIRV_LITTLE_ENDIAN, word: LITTLE::u32},
    Word{axis: ?spirv.SPIRV_BYTE_ORDER, choice: ?spirv.SPIRV_BIG_ENDIAN, word: BIG::u32},
    Word{axis: ?spirv.SPIRV_MEMORY_MODEL, choice: ?spirv.SPIRV_SIMPLE, word: tables.MEMORY_MODEL_SIMPLE},
    Word{axis: ?spirv.SPIRV_MEMORY_MODEL, choice: ?spirv.SPIRV_GLSL450, word: tables.MEMORY_MODEL_GLSL450},
    Word{axis: ?spirv.SPIRV_MEMORY_MODEL, choice: ?spirv.SPIRV_OPENCL, word: tables.MEMORY_MODEL_OPENCL},
    Word{axis: ?spirv.SPIRV_MEMORY_MODEL, choice: ?spirv.SPIRV_VULKAN, word: tables.MEMORY_MODEL_VULKAN},
    Word{axis: ?spirv.SPIRV_VERSION, choice: ?spirv.SPIRV_1_0, word: 0x0001_0000},
    Word{axis: ?spirv.SPIRV_VERSION, choice: ?spirv.SPIRV_1_1, word: 0x0001_0100},
    Word{axis: ?spirv.SPIRV_VERSION, choice: ?spirv.SPIRV_1_2, word: 0x0001_0200},
    Word{axis: ?spirv.SPIRV_VERSION, choice: ?spirv.SPIRV_1_3, word: 0x0001_0300},
    Word{axis: ?spirv.SPIRV_VERSION, choice: ?spirv.SPIRV_1_4, word: 0x0001_0400},
    Word{axis: ?spirv.SPIRV_VERSION, choice: ?spirv.SPIRV_1_5, word: 0x0001_0500},
    Word{axis: ?spirv.SPIRV_VERSION, choice: ?spirv.SPIRV_1_6, word: 0x0001_0600},
};

val VERSION:    Encoding = Encoding{axis: ?spirv.SPIRV_VERSION, required: true};
val ADDRESSING: Encoding = Encoding{axis: ?spirv.SPIRV_ADDRESSING_MODEL, required: true};
val MEMORY:     Encoding = Encoding{axis: ?spirv.SPIRV_MEMORY_MODEL, required: true};
val BYTE_ORDER: Encoding = Encoding{axis: ?spirv.SPIRV_BYTE_ORDER, required: false};

# ascending by axis name
val ENCODING_COUNT: usize                     = 4;
val ENCODINGS:      [ENCODING_COUNT]*Encoding = [ENCODING_COUNT]*Encoding{?ADDRESSING, ?BYTE_ORDER, ?MEMORY, ?VERSION};

# the choice of `x` the word `word` states, refusing a word no row maps
pub fun choice_of(x: *Axis, word: u32) res[*Choice, Fail] {
    var i: usize = 0;
    for (i < WORD_COUNT) {
        if (WORDS[i].axis == x && WORDS[i].word == word) { ret res[*Choice, Fail].ok{WORDS[i].choice}; }
        i = i + 1;
    }
    ret res[*Choice, Fail].err{fail.valued(fail.about(fail.unsupported("no SPIR-V word of the trait axis has this value"), x.name), word::i128)};
}

# the word a module writes for the choice `c` of `x`
pub fun word_of(x: *Axis, c: *Choice) res[u32, Fail] {
    var i: usize = 0;
    for (i < WORD_COUNT) {
        if (WORDS[i].axis == x && WORDS[i].choice == c) { ret res[u32, Fail].ok{WORDS[i].word}; }
        i = i + 1;
    }
    ret res[u32, Fail].err{fail.about(fail.about(fail.internal("a choice of a SPIR-V trait axis has no word"), c.name), x.name)};
}

# the word a module writes for `s`, the setting stated on `x`, refusing an
# axis left unstated
pub fun stated_word(x: *Axis, s: opt[Setting]) res[u32, Fail] {
    if (sel s.none) { ret res[u32, Fail].err{fail.about(fail.unsupported("no value is stated of a trait axis every SPIR-V module states"), x.name)}; }
    val v: Setting = s.some;
    if (sel v.choice) { ret word_of(x, v.choice); }
    ret res[u32, Fail].err{fail.about(fail.internal("a SPIR-V trait axis holds a value of no choice"), x.name)};
}

# the byte order `s`, the setting stated on the byte order axis, writes a
# module in, the axis's absent value when it states none
pub fun order_of(s: opt[Setting]) res[Order, Fail] {
    val absent: trait.Absent   = spirv.SPIRV_BYTE_ORDER.absent;
    var w:      res[u32, Fail] = stated_word(?spirv.SPIRV_BYTE_ORDER, s);
    if (sel s.none) {
        if (sel absent.value) { w = stated_word(?spirv.SPIRV_BYTE_ORDER, opt[Setting].some{absent.value}); }
    }
    if (sel w.err) { ret res[Order, Fail].err{w.err}; }
    ret res[Order, Fail].ok{w.ok::Order};
}

# a module names its traits by no attribute
fun attribute(a: *Arch, t: Tag) opt[*Axis] {
    ret opt[*Axis].none{};
}

# the choice the word written for `x` states
fun setting(x: *Axis, v: Written) res[Setting, Fail] {
    if (sel v.text)             { ret res[Setting, Fail].err{fail.about(fail.unsupported("a SPIR-V trait is written as a word"), x.name)}; }
    if (v.number > 0xFFFF_FFFF) { ret res[Setting, Fail].err{fail.valued(fail.about(fail.unsupported("no SPIR-V word of the trait axis has this value"), x.name), v.number::i128)}; }
    val c: res[*Choice, Fail] = choice_of(x, v.number::u32);
    if (sel c.err) { ret res[Setting, Fail].err{c.err}; }
    ret res[Setting, Fail].ok{Setting.choice{c.ok}};
}

fun holds(a: *Arch, name: Bytes) bool {
    ret false;
}

fun raise(a: *Arch, name: Bytes, data: Bytes, out: *Table[Trait]) err[Fail] {
    ret err[Fail].err{fail.about(fail.unsupported("a SPIR-V module holds its traits in no section"), a.name)};
}

pub val TRAITS: TraitCodec = TraitCodec{encodings: ?ENCODINGS[0], count: ENCODING_COUNT, attribute: attribute, setting: setting, holds: holds, raise: raise};
