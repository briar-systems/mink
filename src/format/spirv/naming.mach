# the name an assembler gives the SPIR-V instruction stream
#
# a SPIR-V module names no sections. its instructions are one stream, which
# an assembler writes into one code section named as the gnu assembler's
# first section is, and the neutral conversion builds a module from that
# section as it stands. the sections the reader gives a module's
# instructions are nameless and take their kinds from the logical layout,
# never from a name, and a module is built from them by their opcodes, named
# or not. so the stream is the only row, and every other kind has no name.
# merged strings and constants of every size are refused too: a module holds
# a constant as an instruction of the stream, as the LLVM SPIR-V backend
# writes a string or a constant array as OpConstantComposite, never as bytes
# of a section, so it has no merging form and no read-only data to fall back
# to.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.store.Bytes;
use mink.format.contract;
use mink.format.contract.Naming;
use mink.model.section;

# kind: the neutral kind
# name: the name a section of the kind that states none takes
pub rec Row {
    kind: *section.Kind;
    name: str;
}

val TEXT_ROW: Row = Row{kind: ?section.TEXT, name: ".text"};

val ROW_COUNT: usize = 1;

# the rows ascending by kind name
val KINDS: [ROW_COUNT]*Row = [ROW_COUNT]*Row{?TEXT_ROW};

# the rows ascending by name, for the convention that a section named so
# takes the row's kind
val NAME_COUNT: usize            = 1;
val NAMES:      [NAME_COUNT]*Row = [NAME_COUNT]*Row{?TEXT_ROW};

fun order(a: **Row, b: **Row) i64 {
    ret str_compare(a[0].kind.name, b[0].kind.name);
}

# the row of key `k`. the stream is keyed by no element size, so a keyed kind
# finds no row
pub fun row_of(k: section.Key) res[*Row, Fail] {
    var probe: Row       = Row{kind: k.kind};
    val row:   opt[*Row] = index.find[Row](?KINDS[0], ROW_COUNT, ?probe, order);
    if (sel row.none) { ret res[*Row, Fail].err{fail.about(fail.unsupported("SPIR-V names no section of this kind"), k.kind.name)}; }
    ret res[*Row, Fail].ok{row.some};
}

# the name a section of key `k` that states none is written with
pub fun name_of(k: section.Key) res[str, Fail] {
    val row: res[*Row, Fail] = row_of(k);
    if (sel row.err) { ret res[str, Fail].err{row.err}; }
    ret res[str, Fail].ok{row.ok.name};
}

fun spelling(r: *Row) str {
    ret r.name;
}

# the key a section named `name` takes by the convention
pub fun kind_of(name: Bytes) opt[section.Key] {
    val r: opt[*Row] = contract.spelled[Row](?NAMES[0], NAME_COUNT, name, 0, spelling);
    if (sel r.none) { ret opt[section.Key].none{}; }
    ret opt[section.Key].some{section.Key{kind: r.some.kind}};
}

# the key of a section named `name`, as a naming row spells the name. a
# SPIR-V module has no section headers and its reader classifies by opcode,
# so `type`, `flags` and `entsize` are not read and a name no row spells is
# refused
pub fun kind_for(name: Bytes, type: str, flags: section.Flags, entsize: u64) res[section.Key, Fail] {
    val k: opt[section.Key] = kind_of(name);
    if (sel k.none) { ret res[section.Key, Fail].err{fail.unsupported("SPIR-V classifies no section by its header, and no naming row spells the name")}; }
    ret res[section.Key, Fail].ok{k.some};
}

# how SPIR-V names sections, for the registration
pub val NAMING: Naming = Naming{kind_of: kind_of, kind_for: kind_for, name_of: name_of};
