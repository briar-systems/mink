# the SPIR-V codec, the row the SPIR-V registration names
#
# a module is told apart by its magic number in either byte order. its kind
# is what a link takes it as: a module that declares the Linkage capability
# is an object a later link joins, and one that does not is a module a
# runtime instantiates as it is.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.table;
use mink.bytes.reader.BIG;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Order;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Stated;
use mink.catalog.format;
use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.format.contract;
use mink.format.contract.Codec;
use mink.format.contract.Identify;
use mink.format.contract.Input;
use mink.format.contract.Magic;
use mink.format.contract.Magics;
use mink.format.contract.Model;
use mink.format.contract.Reader;
use mink.format.dump.Dumper;
use mink.format.shell;
use mink.format.spirv.dump;
use mink.format.spirv.model;
use mink.format.spirv.model.Instruction;
use mink.format.spirv.model.Module;
use mink.format.spirv.read;
use mink.format.spirv.tables;
use mink.format.spirv.write;
use mink.reloc.row;

val MAGIC_LITTLE: [4]u8 = [4]u8{0x03, 0x02, 0x23, 0x07};
val MAGIC_BIG:    [4]u8 = [4]u8{0x07, 0x23, 0x02, 0x03};

val MAGICS: [2]Magic = [2]Magic{
    Magic{offset: 0, bytes: ?MAGIC_LITTLE[0], len: 4},
    Magic{offset: 0, bytes: ?MAGIC_BIG[0], len: 4},
};

pub val CODEC: Codec = Codec{
    identify: Identify.magics{Magics{rows: ?MAGICS[0], count: 2}},
    read:     read_ops,
    write:    write_ops,
    dump:     dump_ops,
    kind:     kind_ops,
    stated:   stated_ops,
    locate:   locate_ops,
    release:  release_ops,
};

# what the registry reads a module with, which the tests below read through
#[testing]
val READER: Reader = Reader{format: ?format.SPIRV, codec: ?CODEC, fields: ?dump.FIELDS[0], field_count: dump.FIELD_COUNT};

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val m: res[*Module, Fail] = read.read(a, in);
    if (sel m.err) { ret res[ptr, Fail].err{m.err}; }
    ret res[ptr, Fail].ok{m.ok::ptr};
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret write.write(a, m::*Module);
}

fun dump_ops(m: ptr, rows: *row.Registry, d: *Dumper) err[Fail] {
    ret dump.describe(m::*Module, d);
}

# relocatable when the module declares the Linkage capability, a module
# otherwise. a capability instruction that holds no single capability leaves
# the kind untold and is refused
fun kind_ops(m: ptr) res[*Kind, Fail] {
    val mod: *Module = m::*Module;
    var i:   usize   = 0;
    for (i < model.count(mod)) {
        val ins: *Instruction = model.at(mod, i);
        if (ins.opcode::u32 == tables.OP_CAPABILITY) {
            if (ins.count != 1) {
                ret res[*Kind, Fail].err{fail.at_offset(fail.in_indexed(fail.malformed("a capability instruction does not hold one capability"), "instruction", i::u64), model.offset(i, ins))};
            }
            if (model.operands(mod, ins)[0] == tables.CAPABILITY_LINKAGE) { ret res[*Kind, Fail].ok{?kind.RELOCATABLE}; }
        }
        i = i + 1;
    }
    ret res[*Kind, Fail].ok{?kind.MODULE};
}

fun stated_ops(m: ptr) opt[Stated] {
    ret opt[Stated].some{model.stated(m::*Module)};
}

# the header, or the instruction whose words hold byte `offset`
fun locate_ops(m: ptr, offset: u64) Location {
    val mod:  *Module = m::*Module;
    val head: u64     = (model.HEADER_WORDS * model.WORD)::u64;
    if (offset < head) { ret Location{record: "header", offset: 0, placed: true}; }
    var lo: usize = 0;
    var hi: usize = model.count(mod);
    for (lo < hi) {
        val mid:   usize        = lo + (hi - lo) / 2;
        val ins:   *Instruction = model.at(mod, mid);
        val start: u64          = model.offset(mid, ins);
        val end:   u64          = start + ((ins.count + 1) * model.WORD)::u64;
        if (offset < start) { hi = mid; }
        or (offset >= end)  { lo = mid + 1; }
        or                  { ret Location{record: "instruction", index: mid::u64, indexed: true, offset: start, placed: true}; }
    }
    ret Location{};
}

fun release_ops(a: *A.Allocator, m: ptr) err[Fail] {
    ret model.release(m::*Module);
}

# the bytes of a module in `order`: a capability, Linkage too when `linkage`
# holds, a memory model, a name and an opcode the grammar does not know
#[testing]
fun fixture(t: *T.Testing, order: Order, linkage: bool) res[Sink, Fail] {
    var s:     Sink    = sink.make(T.allocator_of(t), order);
    val words: [17]u32 = [17]u32{
        model.MAGIC, 0x0001_0600, 0, 2, 0,
        0x0002_0011, 1,
        0x0002_0011, tables.CAPABILITY_LINKAGE,
        0x0003_000E, 0, 1,
        0x0003_0005, 1, 0x0000_6261,
        0x0002_FFF0, 7,
    };
    var i: usize = 0;
    for (i < 17) {
        if (linkage || i < 7 || i > 8) {
            val w: err[Fail] = sink.u32(?s, words[i]);
            if (sel w.err) { ret res[Sink, Fail].err{w.err}; }
        }
        i = i + 1;
    }
    ret res[Sink, Fail].ok{s};
}

#[testing]
fun read_bytes(t: *T.Testing, data: *u8, len: usize) res[Model, Fail] {
    var in: Input = Input{file: "a.spv", data: data, len: len};
    ret shell.run(?READER, T.allocator_of(t), ?in);
}

test spirv__a_module_round_trips_in_either_byte_order {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val orders: [2]Order = [2]Order{LITTLE, BIG};
    var k:      usize    = 0;
    for (k < 2) {
        val built: res[Sink, Fail] = fixture(?t, orders[k], true);
        if (sel built.err) { ret 1; }
        var in: Sink             = built.ok;
        var m:  res[Model, Fail] = read_bytes(?t, sink.data(?in), sink.len(?in));
        if (sel m.err) { ret 2; }
        val mod: *Module = m.ok.data::*Module;
        if (mod.order != orders[k] || model.count(mod) != 5 || mod.header.bound != 2) { ret 3; }
        val w: res[Sink, Fail] = contract.write(?m.ok);
        if (sel w.err) { ret 4; }
        var out: Sink = w.ok;
        if (sink.len(?out) != sink.len(?in)) { ret 5; }
        var i: usize = 0;
        for (i < sink.len(?in)) {
            if (sink.data(?in)[i] != sink.data(?out)[i]) { ret 5; }
            i = i + 1;
        }
        val where: Location = contract.locate(?m.ok, 0x34);
        if (!where.indexed || where.index != 3 || where.offset != 0x30) { ret 6; }
        val r1: err[Fail] = sink.release(?out);
        val r2: err[Fail] = contract.release(?m.ok);
        val r3: err[Fail] = sink.release(?in);
        if (sel r1.err || sel r2.err || sel r3.err) { ret 7; }
        k = k + 1;
    }
    if (T.live_count(?t) != 0) { ret 8; }
    T.dnit(?t);
    ret 0;
}

# a refusal of the module `data` holds, checked for its cause, record and
# offset
#[testing]
fun refused(t: *T.Testing, data: *u8, len: usize, truncated: bool, record: str, offset: u64) bool {
    val m: res[Model, Fail] = read_bytes(t, data, len);
    if (sel m.ok) {
        var got:     Model     = m.ok;
        val dropped: err[Fail] = contract.release(?got);
        ret false;
    }
    val f: Fail = m.err;
    if (truncated != sel f.cause.truncated)                                        { ret false; }
    if (!truncated && !sel f.cause.malformed)                                      { ret false; }
    if (!str_equals(f.at.record, record) || !f.at.placed || f.at.offset != offset) { ret false; }
    ret f.at.file != nil;
}

test spirv__a_module_that_cannot_be_bounded_is_refused_at_its_offset {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val built: res[Sink, Fail] = fixture(?t, LITTLE, false);
    if (sel built.err) { ret 1; }
    var s: Sink  = built.ok;
    val n: usize = sink.len(?s);

    # shorter than the header, and not a whole number of words
    if (!refused(?t, sink.data(?s), 12, true, "header", 0))                { ret 2; }
    if (!refused(?t, sink.data(?s), n - 2, false, "module", (n - 4)::u64)) { ret 3; }

    # a magic number that is not SPIR-V's, and a schema word that is not zero
    sink.data(?s)[0] = 0x04;
    if (!refused(?t, sink.data(?s), n, false, "header", 0)) { ret 4; }
    sink.data(?s)[0]  = 0x03;
    sink.data(?s)[16] = 1;
    if (!refused(?t, sink.data(?s), n, false, "header", 16)) { ret 5; }
    sink.data(?s)[16] = 0;

    # an instruction stating a word count of zero, and one running past the end
    val zero: err[Fail] = sink.u32(?s, 0x0000_0011);
    if (sel zero.err)                                                     { ret 1; }
    if (!refused(?t, sink.data(?s), n + 4, false, "instruction", n::u64)) { ret 6; }
    val long: err[Fail] = sink.patch(?s, n, 0x0003_0011, 4);
    if (sel long.err)                                                    { ret 1; }
    if (!refused(?t, sink.data(?s), n + 4, true, "instruction", n::u64)) { ret 7; }

    val r: err[Fail] = sink.release(?s);
    if (sel r.err)             { ret 1; }
    if (T.live_count(?t) != 0) { ret 8; }
    T.dnit(?t);
    ret 0;
}

test spirv__a_module_is_relocatable_iff_it_declares_linkage {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var k: usize = 0;
    for (k < 2) {
        val built: res[Sink, Fail] = fixture(?t, LITTLE, k == 1);
        if (sel built.err) { ret 1; }
        var in: Sink             = built.ok;
        var m:  res[Model, Fail] = read_bytes(?t, sink.data(?in), sink.len(?in));
        if (sel m.err) { ret 2; }
        val got: res[*Kind, Fail] = contract.kind(?m.ok);
        if (sel got.err)                           { ret 3; }
        if (k == 0 && got.ok != ?kind.MODULE)      { ret 4; }
        if (k == 1 && got.ok != ?kind.RELOCATABLE) { ret 5; }
        val r1: err[Fail] = contract.release(?m.ok);
        val r2: err[Fail] = sink.release(?in);
        if (sel r1.err || sel r2.err) { ret 6; }
        k = k + 1;
    }
    if (T.live_count(?t) != 0) { ret 7; }
    T.dnit(?t);
    ret 0;
}
