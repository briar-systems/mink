# the SPIR-V module as a neutral object and back
#
# a module's ids are the entries of the id space, in ascending id order, each
# placed at the instruction that defines it. its instructions become
# sections: each module-scope instruction one section, with the line
# instructions before it, and each function one section from OpFunction to
# OpFunctionEnd, of the kind and disposition the module's logical layout
# gives its opcode. every operand word holding an id is an id relocation to
# its entry, and the word itself holds zero. a LinkageAttributes decoration
# stays a section of its own and names its id by a symbol too: an export
# defined at its id's entry, a link-once one weakly, and an import an
# undefined symbol every use of its id refers to instead, its id's entry an
# import the symbol resolves. an import's declaration is a root, so a link
# reads its type whether or not anything uses it. the header's version and
# the memory model instruction's addressing and memory models are the
# object's traits, each capability and extension a fact, and the header's
# generator a fact, none of those instructions becoming a section.
#
# a module is built back from the sections in the order of the layout's
# blocks, each section's own order kept, whatever sections the object holds:
# one section holding a whole instruction stream is a module as it stands.
# each entry of the id space is the id one past the entries before it, the
# undefined symbol an import entry names taking its entry's, an undefined
# symbol a relocation names and no entry does takes the next, and the bound
# is one past the last. an id word no relocation patches keeps the id it
# holds, and every id of the module built must lie below the bound. the
# capabilities, extensions and memory model instruction are written from the
# object's facts and traits where the logical layout puts them, and a
# section holding one of its own is refused.

use std.collections.map;
use std.collections.map.Map;
use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Stated;
use arch_list: mink.catalog.arch.list;
use mink.catalog.arch.spirv;
use mink.catalog.format;
use catalog_kind: mink.catalog.kind;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Choice;
use mink.catalog.trait.Setting;
use mink.format.spirv.assemble;
use mink.format.spirv.assemble.Assembler;
use mink.format.spirv.fixture;
use mink.format.spirv.layout;
use mink.format.spirv.layout.Placed;
use mink.format.spirv.model;
use mink.format.spirv.model.Header;
use mink.format.spirv.model.Instruction;
use mink.format.spirv.model.Module;
use mink.format.spirv.reloc;
use mink.format.spirv.rules;
use mink.format.spirv.tables;
use mink.format.spirv.traits;
use mink.format.spirv.walk;
use mink.format.spirv.walk.Found;
use mink.format.spirv.walk.Walker;
use mink.lower.Lowering;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Definition;
use mink.model.object.Entry;
use mink.model.object.Fact;
use mink.model.object.Import;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Reloc;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.object.Target;
