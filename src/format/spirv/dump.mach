# the text form of a SPIR-V module
#
# the header, then each instruction in module order with its offset, its
# opcode named by the grammar where it knows it, its word count and its
# operand words as written.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.bytes.reader.LITTLE;
use mink.format.dump;
use mink.format.dump.Dumper;
use mink.format.spirv.grammar;
use mink.format.spirv.grammar.Op;
use mink.format.spirv.model;
use mink.format.spirv.model.Instruction;
use mink.format.spirv.model.Module;
use mink.format.spirv.tables;

pub val MODULE:      u32 = 0;
pub val MAGIC:       u32 = 1;
pub val BYTE_ORDER:  u32 = 2;
pub val VERSION:     u32 = 3;
pub val GENERATOR:   u32 = 4;
pub val BOUND:       u32 = 5;
pub val SCHEMA:      u32 = 6;
pub val INSTRUCTION: u32 = 7;
pub val OFFSET:      u32 = 8;
pub val OPCODE:      u32 = 9;
pub val WORD_COUNT:  u32 = 10;
pub val OPERANDS:    u32 = 11;

pub val FIELD_COUNT: usize   = 12;
pub val FIELDS:      [12]str = [12]str{
    "Module", "Magic", "ByteOrder", "Version", "Generator", "Bound", "Schema",
    "Instruction", "Offset", "Opcode", "WordCount", "Operands",
};

pub fun describe(m: *Module, d: *Dumper) err[Fail] {
    val w1: err[Fail] = dump.open(d, MODULE);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = dump.hex(d, MAGIC, model.MAGIC::u64);
    if (sel w2.err) { ret w2; }
    var order: str = "big";
    if (m.order == LITTLE) { order = "little"; }
    val w3: err[Fail] = dump.string(d, BYTE_ORDER, order::*u8, str_len(order));
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = dump.hex(d, VERSION, m.header.version::u64);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = dump.hex(d, GENERATOR, m.header.generator::u64);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = dump.decimal(d, BOUND, m.header.bound::u64);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = dump.decimal(d, SCHEMA, m.header.schema::u64);
    if (sel w7.err) { ret w7; }
    var i: usize = 0;
    for (i < model.count(m)) {
        val w8: err[Fail] = instruction(m, d, i);
        if (sel w8.err) { ret w8; }
        i = i + 1;
    }
    ret dump.close(d);
}

fun instruction(m: *Module, d: *Dumper, index: usize) err[Fail] {
    val ins: *Instruction = model.at(m, index);
    val w1:  err[Fail]    = dump.open(d, INSTRUCTION);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = dump.hex(d, OFFSET, model.offset(index, ins));
    if (sel w2.err) { ret w2; }
    var name: opt[str]       = opt[str].none{};
    val op:   res[*Op, Fail] = grammar.op(?tables.GRAMMAR, ins.opcode::u32);
    if (sel op.ok) { name = opt[str].some{op.ok.name}; }
    val w3: err[Fail] = dump.named(d, OPCODE, ins.opcode::u64, name);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = dump.decimal(d, WORD_COUNT, (ins.count + 1)::u64);
    if (sel w4.err) { ret w4; }
    if (ins.count > 0) {
        val w5: err[Fail] = dump.field(d, OPERANDS);
        if (sel w5.err) { ret w5; }
        val words: *u32  = model.operands(m, ins);
        var k:     usize = 0;
        for (k < ins.count) {
            if (k > 0) {
                val ws: err[Fail] = dump.text(d, " ");
                if (sel ws.err) { ret ws; }
            }
            val wv: err[Fail] = dump.hex_value(d, words[k]::u64);
            if (sel wv.err) { ret wv; }
            k = k + 1;
        }
        val wn: err[Fail] = dump.text(d, "\n");
        if (sel wn.err) { ret wn; }
    }
    ret dump.close(d);
}

test tables__the_generated_grammar_is_sound_and_refuses_an_opcode_it_lacks {
    if (!grammar.sound(?tables.GRAMMAR)) { ret 1; }
    val known: res[*Op, Fail] = grammar.op(?tables.GRAMMAR, tables.OP_CAPABILITY);
    if (sel known.err)                              { ret 2; }
    if (!str_equals(known.ok.name, "OpCapability")) { ret 2; }
    val unknown: res[*Op, Fail] = grammar.op(?tables.GRAMMAR, 0xFFFF);
    if (sel unknown.ok)                                                    { ret 3; }
    if (!sel unknown.err.cause.unsupported)                                { ret 3; }
    if (!(sel unknown.err.value.some && unknown.err.value.some == 0xFFFF)) { ret 3; }
    val glsl: [12]u8                  = [12]u8{'G', 'L', 'S', 'L', '.', 's', 't', 'd', '.', '4', '5', '0'};
    val set:  res[*grammar.Set, Fail] = grammar.set(?tables.GRAMMAR, Bytes{data: ?glsl[0], len: 12});
    if (sel set.err) { ret 4; }
    ret 0;
}
