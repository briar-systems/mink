# the SPIR-V image writer's tests through a whole link
#
# a link reaches the writer only through the registry, which lists the
# SPIR-V registration above the writer, so the tests that link sit here,
# above both. each module is given as its words after the header, the
# version 1.3 and its bound.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.spirv;
use mink.catalog.format;
use mink.catalog.os.System;
use os_spirv: mink.catalog.os.spirv;
use mink.catalog.output;
use mink.format.contract.Input;
use mink.format.contract.Reader;
use mink.format.readers.Readers;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.format.spirv.model;
use mink.format.spirv.model.Instruction;
use mink.format.spirv.model.Module;
use mink.format.spirv.read;
use mink.format.spirv.tables;
use mink.link.input.Source;
use mink.link.options.Options;
use mink.link.state;
use mink.link.state.State;
use mink.model.target.Target;

# name:  the module's file name
# words: its words after the header
# count: how many
# bound: its bound
rec Given {
    name:  str;
    words: *u32;
    count: usize;
    bound: u32;
}

# exports the function f: void(), returning
val EXPORT_COUNT: usize             = 26;
val EXPORT:       [EXPORT_COUNT]u32 = [EXPORT_COUNT]u32{
    0x0002_0011, 1,
    0x0002_0011, 5,
    0x0003_000E, 0, 1,
    0x0005_0047, 3, 41, 0x66, 0,
    0x0002_0013, 1,
    0x0003_0021, 2, 1,
    0x0005_0036, 1, 3, 0, 2,
    0x0002_00F8, 4,
    0x0001_00FD,
    0x0001_0038,
};

# a compute entry point main that calls f, imported as a function of the
# same type, its ids overlapping those of EXPORT
val IMPORT_COUNT: usize             = 47;
val IMPORT:       [IMPORT_COUNT]u32 = [IMPORT_COUNT]u32{
    0x0002_0011, 1,
    0x0002_0011, 5,
    0x0003_000E, 0, 1,
    0x0005_000F, 5, 4, 0x6E69_616D, 0,
    0x0006_0010, 4, 17, 1, 1, 1,
    0x0005_0047, 3, 41, 0x66, 1,
    0x0002_0013, 1,
    0x0003_0021, 2, 1,
    0x0005_0036, 1, 3, 0, 2,
    0x0001_0038,
    0x0005_0036, 1, 4, 0, 2,
    0x0002_00F8, 5,
    0x0004_0039, 1, 6, 3,
    0x0001_00FD,
    0x0001_0038,
};

# imports f as a private integer variable, which EXPORT defines as a function
val VARIABLE_COUNT: usize               = 24;
val VARIABLE:       [VARIABLE_COUNT]u32 = [VARIABLE_COUNT]u32{
    0x0002_0011, 1,
    0x0002_0011, 5,
    0x0003_000E, 0, 1,
    0x0005_0047, 3, 41, 0x66, 1,
    0x0004_0015, 1, 32, 0,
    0x0004_0020, 2, 6, 1,
    0x0004_003B, 2, 3, 6,
};

# Shader, Linkage and Int8, and the extension SPV_A
val FIRST_COUNT: usize            = 12;
val FIRST:       [FIRST_COUNT]u32 = [FIRST_COUNT]u32{
    0x0002_0011, 1,
    0x0002_0011, 5,
    0x0002_0011, 39,
    0x0003_000A, 0x5F56_5053, 0x41,
    0x0003_000E, 0, 1,
};

# Shader, Linkage and Int16, and the extensions SPV_B and SPV_A
val SECOND_COUNT: usize             = 15;
val SECOND:       [SECOND_COUNT]u32 = [SECOND_COUNT]u32{
    0x0002_0011, 1,
    0x0002_0011, 5,
    0x0002_0011, 22,
    0x0003_000A, 0x5F56_5053, 0x42,
    0x0003_000A, 0x5F56_5053, 0x41,
    0x0003_000E, 0, 1,
};

# the Vulkan memory model, which EXPORT's GLSL450 contradicts
val VULKAN_COUNT: usize             = 7;
val VULKAN:       [VULKAN_COUNT]u32 = [VULKAN_COUNT]u32{
    0x0002_0011, 1,
    0x0002_0011, 5,
    0x0003_000E, 0, 3,
};

# the bytes of the module `g`
fun bytes_of(g: *Given, out: *Sink) err[Fail] {
    val header: [5]u32    = [5]u32{model.MAGIC, 0x0001_0300, 0, g.bound, 0};
    var e:      err[Fail] = err[Fail].ok{};
    var i:      usize     = 0;
    for (i < 5) {
        e = fail.kept(e, sink.u32(out, header[i]));
        i = i + 1;
    }
    i = 0;
    for (i < g.count) {
        e = fail.kept(e, sink.u32(out, g.words[i]));
        i = i + 1;
    }
    ret e;
}

# link the `n` modules at `given` as `kind` for vulkan into `st`, the module
# bytes in `bufs`, writing what a refusal cannot carry to `notes`, all of
# which the caller releases whatever happens
fun test_link(a: *A.Allocator, kind: *output.Kind, given: *Given, n: usize, st: *State, reg: *Registry, notes: *Sink, bufs: *Sink) err[Fail] {
    @notes  = sink.make(a, LITTLE);
    bufs[0] = sink.make(a, LITTLE);
    bufs[1] = sink.make(a, LITTLE);
    @reg    = Registry{readers: Readers{rows: table.make[Reader](a)}};
    val built: res[Registry, Fail] = registry.builtin(a);
    if (sel built.err) { ret err[Fail].err{built.err}; }
    @reg = built.ok;
    val o:      Options   = Options{kind: kind, format: ?format.SPIRV, target: Target{arch: ?spirv.SPIRV, system: opt[*System].some{?os_spirv.VULKAN}}};
    val opened: err[Fail] = state.open(st, a, reg, o);
    if (sel opened.err) { ret opened; }
    var sources: [2]Source;
    var i:       usize = 0;
    for (i < n) {
        val b: err[Fail] = bytes_of(?given[i], ?bufs[i]);
        if (sel b.err) { ret b; }
        sources[i] = Source.bytes{Input{file: given[i].name, data: sink.data(?bufs[i]), len: sink.len(?bufs[i])}};
        i          = i + 1;
    }
    ret state.run(st, ?sources[0], n, notes);
}

fun test_release(st: *State, reg: *Registry, notes: *Sink, bufs: *Sink) bool {
    var e: err[Fail] = state.release(st);
    e = fail.kept(e, registry.release(reg));
    e = fail.kept(e, sink.release(notes));
    e = fail.kept(e, sink.release(?bufs[0]));
    e = fail.kept(e, sink.release(?bufs[1]));
    ret sel e.ok;
}

# the module `st` wrote, read back
fun test_module(a: *A.Allocator, st: *State, out: *Sink) res[*Module, Fail] {
    @out = state.take(st);
    var in: Input = Input{file: "linked.spv", data: sink.data(out), len: sink.len(out)};
    ret read.read(a, ?in);
}

# how many instructions of `op` `m` holds
fun count_of(m: *Module, op: u32) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < model.count(m)) {
        if (model.at(m, i).opcode::u32 == op) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# how many instructions of `op` `m` holds whose first operand is `word`
fun count_with(m: *Module, op: u32, at: usize, word: u32) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < model.count(m)) {
        val ins: *Instruction = model.at(m, i);
        i = i + 1;
        if (ins.opcode::u32 == op && ins.count > at && model.operands(m, ins)[at] == word) { n = n + 1; }
    }
    ret n;
}

# the `at`th operand of the first instruction of `op` in `m`, zero for none
fun operand_of(m: *Module, op: u32, at: usize) u32 {
    var i: usize = 0;
    for (i < model.count(m)) {
        val ins: *Instruction = model.at(m, i);
        i = i + 1;
        if (ins.opcode::u32 == op && ins.count > at) { ret model.operands(m, ins)[at]; }
    }
    ret 0;
}

fun done(t: *T.Testing, m: *Module, out: *Sink, st: *State, reg: *Registry, notes: *Sink, bufs: *Sink) i32 {
    val rm: err[Fail] = model.release(m);
    val ro: err[Fail] = sink.release(out);
    if (sel rm.err || sel ro.err)            { ret 90; }
    if (!test_release(st, reg, notes, bufs)) { ret 91; }
    if (T.live_count(t) != 0)                { ret 92; }
    T.dnit(t);
    ret 0;
}

fun export_import(given: *Given) {
    given[0] = Given{name: "export.spv", words: ?EXPORT[0], count: EXPORT_COUNT, bound: 5};
    given[1] = Given{name: "import.spv", words: ?IMPORT[0], count: IMPORT_COUNT, bound: 7};
}

test linked__an_import_binds_its_export {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:     *A.Allocator = T.allocator_of(?t);
    var given: [2]Given;
    export_import(?given[0]);
    var st:     State;
    var reg:    Registry;
    var notes:  Sink;
    var bufs:   [2]Sink;
    val linked: err[Fail] = test_link(a, ?output.MODULE, ?given[0], 2, ?st, ?reg, ?notes, ?bufs[0]);
    if (sel linked.err) { ret 2; }
    var out: Sink;
    val m:   res[*Module, Fail] = test_module(a, ?st, ?out);
    if (sel m.err) { ret 3; }

    # the import's declaration and both linkage decorations are gone, with
    # the Linkage capability, and main calls the export's definition
    if (count_of(m.ok, tables.OP_FUNCTION) != 2)                                            { ret 4; }
    if (count_with(m.ok, tables.OP_DECORATE, 1, tables.DECORATION_LINKAGE_ATTRIBUTES) != 0) { ret 5; }
    if (count_with(m.ok, tables.OP_CAPABILITY, 0, tables.CAPABILITY_LINKAGE) != 0)          { ret 6; }
    val main:   u32 = operand_of(m.ok, tables.OP_ENTRY_POINT, 1);
    val callee: u32 = operand_of(m.ok, tables.OP_FUNCTION_CALL, 2);
    if (callee == 0 || callee == main)                        { ret 7; }
    if (count_with(m.ok, tables.OP_FUNCTION, 1, callee) != 1) { ret 8; }
    ret done(?t, m.ok, ?out, ?st, ?reg, ?notes, ?bufs[0]);
}

test linked__the_ids_of_every_input_are_renumbered_without_collision {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:     *A.Allocator = T.allocator_of(?t);
    var given: [2]Given;
    export_import(?given[0]);
    var st:     State;
    var reg:    Registry;
    var notes:  Sink;
    var bufs:   [2]Sink;
    val linked: err[Fail] = test_link(a, ?output.MODULE, ?given[0], 2, ?st, ?reg, ?notes, ?bufs[0]);
    if (sel linked.err) { ret 2; }
    var out: Sink;
    val m:   res[*Module, Fail] = test_module(a, ?st, ?out);
    if (sel m.err) { ret 3; }

    # both inputs number their ids from one, and the module defines each id
    # it holds once, every one below its bound
    var seen: Table[bool]               = table.make[bool](a);
    val g:    res[table.Id[bool], Fail] = table.grow[bool](?seen, m.ok.header.bound::usize);
    if (sel g.err) { ret 4; }
    var bad: bool  = false;
    var i:   usize = 0;
    for (i < model.count(m.ok)) {
        val ins: *Instruction = model.at(m.ok, i);
        i = i + 1;
        val op: u32   = ins.opcode::u32;
        var at: usize = 1;
        if (op == tables.OP_TYPE_VOID || op == tables.OP_TYPE_FUNCTION || op == tables.OP_LABEL) { at = 0; }
        or (op != tables.OP_FUNCTION && op != tables.OP_FUNCTION_CALL)                           { cnt; }
        val id: u32 = model.operands(m.ok, ins)[at];
        if (id == 0 || id >= m.ok.header.bound || table.items[bool](?seen)[id]) { bad = true; }
        or                                                                      { table.items[bool](?seen)[id] = true; }
    }
    val rs: err[Fail] = table.release[bool](?seen);
    if (sel rs.err) { ret 5; }
    if (bad)        { ret 6; }
    ret done(?t, m.ok, ?out, ?st, ?reg, ?notes, ?bufs[0]);
}

test linked__capabilities_and_extensions_are_unioned {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:     *A.Allocator = T.allocator_of(?t);
    var given: [2]Given     = [2]Given{
        Given{name: "first.spv", words: ?FIRST[0], count: FIRST_COUNT, bound: 1},
        Given{name: "second.spv", words: ?SECOND[0], count: SECOND_COUNT, bound: 1},
    };
    var st:     State;
    var reg:    Registry;
    var notes:  Sink;
    var bufs:   [2]Sink;
    val linked: err[Fail] = test_link(a, ?output.MODULE, ?given[0], 2, ?st, ?reg, ?notes, ?bufs[0]);
    if (sel linked.err) { ret 2; }
    var out: Sink;
    val m:   res[*Module, Fail] = test_module(a, ?st, ?out);
    if (sel m.err) { ret 3; }

    # Shader, Int16 and Int8 once each, the module keeping no linkage, then
    # SPV_A and SPV_B once each
    if (count_of(m.ok, tables.OP_CAPABILITY) != 3 || count_of(m.ok, tables.OP_EXTENSION) != 2) { ret 4; }
    if (count_with(m.ok, tables.OP_CAPABILITY, 0, 1) != 1)                                     { ret 5; }
    if (count_with(m.ok, tables.OP_CAPABILITY, 0, 22) != 1)                                    { ret 5; }
    if (count_with(m.ok, tables.OP_CAPABILITY, 0, 39) != 1)                                    { ret 5; }
    if (count_with(m.ok, tables.OP_EXTENSION, 1, 0x41) != 1)                                   { ret 6; }
    if (count_with(m.ok, tables.OP_EXTENSION, 1, 0x42) != 1)                                   { ret 6; }
    ret done(?t, m.ok, ?out, ?st, ?reg, ?notes, ?bufs[0]);
}

test linked__a_duplicate_type_is_merged {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:     *A.Allocator = T.allocator_of(?t);
    var given: [2]Given;
    export_import(?given[0]);
    var st:     State;
    var reg:    Registry;
    var notes:  Sink;
    var bufs:   [2]Sink;
    val linked: err[Fail] = test_link(a, ?output.MODULE, ?given[0], 2, ?st, ?reg, ?notes, ?bufs[0]);
    if (sel linked.err) { ret 2; }
    var out: Sink;
    val m:   res[*Module, Fail] = test_module(a, ?st, ?out);
    if (sel m.err) { ret 3; }

    # both inputs declare void and void(), which the module holds once, and
    # every function names that one function type
    if (count_of(m.ok, tables.OP_TYPE_VOID) != 1 || count_of(m.ok, tables.OP_TYPE_FUNCTION) != 1) { ret 4; }
    val fn: u32 = operand_of(m.ok, tables.OP_TYPE_FUNCTION, 0);
    if (count_with(m.ok, tables.OP_FUNCTION, 3, fn) != 2) { ret 5; }
    ret done(?t, m.ok, ?out, ?st, ?reg, ?notes, ?bufs[0]);
}

# whether `s` holds the bytes of `want`
fun holds(s: *Sink, want: str) bool {
    val n: usize = str_len(want);
    val d: *u8   = sink.data(s);
    var i: usize = 0;
    for (i + n <= sink.len(s)) {
        var k: usize = 0;
        for (k < n && d[i + k] == want[k]) {
            k = k + 1;
        }
        if (k == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

test linked__an_unresolved_import_is_refused_naming_it_and_kept_for_relocatable_output {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:     *A.Allocator = T.allocator_of(?t);
    var given: [2]Given;
    export_import(?given[0]);

    # alone, the import of f is refused, and the notes name f
    var bare:       State;
    var bare_reg:   Registry;
    var bare_notes: Sink;
    var bare_bufs:  [2]Sink;
    val refused:    err[Fail] = test_link(a, ?output.MODULE, ?given[1], 1, ?bare, ?bare_reg, ?bare_notes, ?bare_bufs[0]);
    if (sel refused.ok)                                              { ret 2; }
    if (!sel refused.err.cause.malformed)                            { ret 2; }
    if (!holds(?bare_notes, "f: nothing defines the symbol"))        { ret 3; }
    if (!test_release(?bare, ?bare_reg, ?bare_notes, ?bare_bufs[0])) { ret 4; }

    # a relocatable output keeps the import's declaration, its decoration and
    # the Linkage capability
    var st:     State;
    var reg:    Registry;
    var notes:  Sink;
    var bufs:   [2]Sink;
    val linked: err[Fail] = test_link(a, ?output.RELOCATABLE, ?given[1], 1, ?st, ?reg, ?notes, ?bufs[0]);
    if (sel linked.err) { ret 5; }
    var out: Sink;
    val m:   res[*Module, Fail] = test_module(a, ?st, ?out);
    if (sel m.err)                                                                          { ret 6; }
    if (count_of(m.ok, tables.OP_FUNCTION) != 2)                                            { ret 7; }
    if (count_with(m.ok, tables.OP_DECORATE, 1, tables.DECORATION_LINKAGE_ATTRIBUTES) != 1) { ret 8; }
    if (count_with(m.ok, tables.OP_CAPABILITY, 0, tables.CAPABILITY_LINKAGE) != 1)          { ret 9; }
    val f: u32 = operand_of(m.ok, tables.OP_DECORATE, 0);
    if (operand_of(m.ok, tables.OP_FUNCTION_CALL, 2) != f) { ret 10; }
    ret done(?t, m.ok, ?out, ?st, ?reg, ?notes, ?bufs[0]);
}

test linked__a_linkage_type_mismatch_is_refused_naming_both_inputs {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:     *A.Allocator = T.allocator_of(?t);
    var given: [2]Given     = [2]Given{
        Given{name: "export.spv", words: ?EXPORT[0], count: EXPORT_COUNT, bound: 5},
        Given{name: "variable.spv", words: ?VARIABLE[0], count: VARIABLE_COUNT, bound: 4},
    };
    var st:      State;
    var reg:     Registry;
    var notes:   Sink;
    var bufs:    [2]Sink;
    val refused: err[Fail] = test_link(a, ?output.MODULE, ?given[0], 2, ?st, ?reg, ?notes, ?bufs[0]);
    if (sel refused.ok)                                   { ret 2; }
    if (!sel refused.err.cause.malformed)                 { ret 3; }
    if (!str_equals(refused.err.at.file, "variable.spv")) { ret 4; }
    if (!str_equals(refused.err.at.record, "export.spv")) { ret 5; }
    if (!test_release(?st, ?reg, ?notes, ?bufs[0]))       { ret 6; }
    if (T.live_count(?t) != 0)                            { ret 7; }
    T.dnit(?t);
    ret 0;
}

test linked__a_memory_model_mismatch_is_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:     *A.Allocator = T.allocator_of(?t);
    var given: [2]Given     = [2]Given{
        Given{name: "export.spv", words: ?EXPORT[0], count: EXPORT_COUNT, bound: 5},
        Given{name: "vulkan.spv", words: ?VULKAN[0], count: VULKAN_COUNT, bound: 1},
    };
    var st:      State;
    var reg:     Registry;
    var notes:   Sink;
    var bufs:    [2]Sink;
    val refused: err[Fail] = test_link(a, ?output.RELOCATABLE, ?given[0], 2, ?st, ?reg, ?notes, ?bufs[0]);
    if (sel refused.ok)                                                  { ret 2; }
    if (!sel refused.err.cause.malformed)                                { ret 3; }
    if (!str_equals(refused.err.subject, spirv.SPIRV_MEMORY_MODEL.name)) { ret 4; }
    if (!str_equals(refused.err.at.file, "vulkan.spv"))                  { ret 5; }
    if (!test_release(?st, ?reg, ?notes, ?bufs[0]))                      { ret 6; }
    if (T.live_count(?t) != 0)                                           { ret 7; }
    T.dnit(?t);
    ret 0;
}
