# the text form of any format's model
#
# a format's dump walks its model in model order and names each field by a
# key into the format's own field table, so the names can follow what
# llvm-readobj prints. records nest as `Name {` ... `}`, one field per line,
# indented two spaces a level. names are quoted with every byte outside
# printable ascii, and every quote and backslash, written as an escape. the
# dumper keeps the first failure of a dump and writes nothing after it, so a
# format's walk calls its writes one after another and the dump's owner asks
# for the failure once, at the end.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Why;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

# out:         where the text goes
# fields:      the format's field names, by key
# field_count: how many
# depth:       how many records are open
# failed:      the first failure of the dump, after which every write does
#              nothing
pub rec Dumper {
    out:         *Sink;
    fields:      *str;
    field_count: usize;
    depth:       usize;
    failed:      opt[Fail];
}

pub fun make(out: *Sink, fields: *str, field_count: usize) Dumper {
    ret Dumper{out: out, fields: fields, field_count: field_count, failed: opt[Fail].none{}};
}

# keep `f` as the dump's failure unless an earlier one is kept
pub fun keep(d: *Dumper, f: Fail) {
    if (!failed(d)) { d.failed = opt[Fail].some{f}; }
}

# keep the failure of `w`, when it failed, unless an earlier one is kept
pub fun keep_outcome(d: *Dumper, w: err[Fail]) {
    if (sel w.err) { keep(d, w.err); }
}

# whether the dump has failed
fun failed(d: *Dumper) bool {
    ret sel d.failed.some;
}

# the first failure of the dump, ok when it wrote everything
pub fun result(d: *Dumper) err[Fail] {
    if (sel d.failed.some) { ret err[Fail].err{d.failed.some}; }
    ret err[Fail].ok{};
}

# open a record named by `key`
pub fun open(d: *Dumper, key: u32) {
    lead(d, key);
    d.depth = d.depth + 1;
    put_text(d, " {\n");
}

# open a record named by `prefix` and the `n` bytes at `p`, `prefix NAME {`
pub fun open_labelled(d: *Dumper, prefix: str, p: *u8, n: usize) {
    indent(d);
    put_text(d, prefix);
    put_bytes(d, p, n);
    d.depth = d.depth + 1;
    put_text(d, " {\n");
}

# close the innermost record
pub fun close(d: *Dumper) {
    if (d.depth == 0) {
        keep(d, fail.internal("dump closes a record it never opened"));
        ret;
    }
    d.depth = d.depth - 1;
    indent(d);
    put_text(d, "}\n");
}

# open a list named by `key`, `Key [`, whose items follow one per line
pub fun open_list(d: *Dumper, key: u32) {
    lead(d, key);
    d.depth = d.depth + 1;
    put_text(d, " [\n");
}

# open a list named by `key` that carries a value, `Key [ (0x..)`
pub fun open_valued_list(d: *Dumper, key: u32, v: u64) {
    lead(d, key);
    d.depth = d.depth + 1;
    put_text(d, " [ (");
    hex_value(d, v);
    put_text(d, ")\n");
}

# open a nested level without a record of its own, for a caller that writes its
# own lead line and closes it with close_list
pub fun nest(d: *Dumper) {
    d.depth = d.depth + 1;
}

# open a block named by `key`, `Key (`, whose lines follow one per line
pub fun open_block(d: *Dumper, key: u32) {
    lead(d, key);
    d.depth = d.depth + 1;
    put_text(d, " (\n");
}

# close the innermost block
pub fun close_block(d: *Dumper) {
    if (d.depth == 0) {
        keep(d, fail.internal("dump closes a block it never opened"));
        ret;
    }
    d.depth = d.depth - 1;
    indent(d);
    put_text(d, ")\n");
}

# the indentation of a line the caller writes itself, inside a block or a list
pub fun row(d: *Dumper) {
    indent(d);
}

# close the innermost list
pub fun close_list(d: *Dumper) {
    if (d.depth == 0) {
        keep(d, fail.internal("dump closes a list it never opened"));
        ret;
    }
    d.depth = d.depth - 1;
    indent(d);
    put_text(d, "]\n");
}

# one item of a list, `Name (0x..)`, the name as the caller spells it
pub fun item(d: *Dumper, name: str, v: u64) {
    indent(d);
    put_text(d, name);
    put_text(d, " (");
    hex_value(d, v);
    put_text(d, ")\n");
}

pub fun decimal(d: *Dumper, key: u32, v: u64) {
    field(d, key);
    put_number(d, v, 10);
    put_text(d, "\n");
}

pub fun signed(d: *Dumper, key: u32, v: i64) {
    field(d, key);
    var mag: u64 = v::u64;
    if (v < 0) {
        put_text(d, "-");
        mag = ~(v::u64) + 1;
    }
    put_number(d, mag, 10);
    put_text(d, "\n");
}

pub fun hex(d: *Dumper, key: u32, v: u64) {
    field(d, key);
    hex_value(d, v);
    put_text(d, "\n");
}

# one single-bit constant `name` of `bit`, printed when `rest` holds its bit and
# cleared from `rest`. a multi-bit constant is a mask, not a flag, and is skipped
pub fun flag(d: *Dumper, rest: *u64, bit: u64, name: str) {
    if (bit == 0 || (bit & (bit - 1)) != 0 || (@rest & bit) == 0) { ret; }
    put_text(d, name);
    put_text(d, " ");
    @rest = @rest & ~bit;
}

# one value `name` of a field of several bits, printed when the bits of `rest`
# under `mask` hold `value` and cleared from `rest`. a value of no bits names
# nothing set and is skipped
pub fun masked(d: *Dumper, rest: *u64, mask: u64, value: u64, name: str) {
    if (value == 0 || (@rest & mask) != value) { ret; }
    put_text(d, name);
    put_text(d, " ");
    @rest = @rest & ~mask;
}

# the bits `rest` keeps after the flags named, then the whole value `v`, closing
# a flags field whose lead `field` printed
pub fun flags_rest(d: *Dumper, rest: u64, v: u64) {
    if (rest != 0) {
        hex_value(d, rest);
        put_text(d, " ");
    }
    put_text(d, "(");
    hex_value(d, v);
    put_text(d, ")\n");
}

# a number that prints its name before it, `Key: NAME (0x..)`, or `Key: 0x..`
# when it has none
pub fun named(d: *Dumper, key: u32, v: u64, name: opt[str]) {
    field(d, key);
    if (sel name.some) {
        put_text(d, name.some);
        put_text(d, " (");
        hex_value(d, v);
        put_text(d, ")\n");
        ret;
    }
    hex_value(d, v);
    put_text(d, "\n");
}

# a number with the bytes `label` before it, `Key: LABEL (N)`, for a value
# that names a string of the file
pub fun labelled(d: *Dumper, key: u32, v: u64, label: *u8, n: usize) {
    field(d, key);
    put_bytes(d, label, n);
    put_text(d, " (");
    put_number(d, v, 10);
    put_text(d, ")\n");
}

# the `n` bytes at `p` as one run of hex digits, no separators
pub fun digits(d: *Dumper, key: u32, p: *u8, n: usize) {
    field(d, key);
    var i: usize = 0;
    for (i < n) {
        digits2(d, p[i]);
        i = i + 1;
    }
    put_text(d, "\n");
}

# the `n` bytes at `p` as a value, unquoted, for a name a format prints as it is
pub fun string(d: *Dumper, key: u32, p: *u8, n: usize) {
    field(d, key);
    put_bytes(d, p, n);
    put_text(d, "\n");
}

# the `n` bytes at `p`, as they are and with no key or line end
pub fun raw(d: *Dumper, p: *u8, n: usize) {
    put_bytes(d, p, n);
}

# one byte of text, as it is
pub fun char(d: *Dumper, c: u8) {
    put_u8(d, c);
}

# `v` in decimal, with no key or line end
pub fun decimal_value(d: *Dumper, v: u64) {
    put_number(d, v, 10);
}

# the text `t`, as it is, for a value a format prints by hand
pub fun text(d: *Dumper, t: str) {
    put_text(d, t);
}

# `v` in hexadecimal with its 0x prefix, and no key or line end
pub fun hex_value(d: *Dumper, v: u64) {
    put_text(d, "0x");
    put_number(d, v, 16);
}

# the `n` bytes at `p` as a quoted, escaped name
pub fun name(d: *Dumper, key: u32, p: *u8, n: usize) {
    field(d, key);
    put_text(d, "\"");
    var i: usize = 0;
    for (i < n) {
        escaped(d, p[i]);
        i = i + 1;
    }
    put_text(d, "\"\n");
}

# the `n` bytes at `p` as space-separated hex pairs
pub fun bytes(d: *Dumper, key: u32, p: *u8, n: usize) {
    field(d, key);
    put_text(d, "(");
    var i: usize = 0;
    for (i < n) {
        put_u8(d, ' ');
        digits2(d, p[i]);
        i = i + 1;
    }
    put_text(d, " )\n");
}

# indentation and `Name: `, the lead of a field whose value the caller prints
pub fun field(d: *Dumper, key: u32) {
    lead(d, key);
    put_text(d, ": ");
}

# the field `key` naming why a piece is held raw
pub fun reason(d: *Dumper, key: u32, w: *Why) {
    field(d, key);
    put_text(d, store.why_name(w));
    put_text(d, "\n");
}

# indentation and the name of `key`
fun lead(d: *Dumper, key: u32) {
    if (key::usize >= d.field_count) {
        keep(d, fail.internal("dump names a field outside the format's field table"));
        ret;
    }
    indent(d);
    put_text(d, d.fields[key]);
}

fun indent(d: *Dumper) {
    var i: usize = 0;
    for (i < d.depth) {
        put_text(d, "  ");
        i = i + 1;
    }
}

fun escaped(d: *Dumper, b: u8) {
    if (b == '"' || b == '\\') {
        put_u8(d, '\\');
        put_u8(d, b);
        ret;
    }
    if (b >= 0x20 && b < 0x7f) {
        put_u8(d, b);
        ret;
    }
    put_text(d, "\\x");
    digits2(d, b);
}

# `b` as two lowercase hex digits
fun digits2(d: *Dumper, b: u8) {
    put_u8(d, nibble(b >> 4));
    put_u8(d, nibble(b & 0xf));
}

fun nibble(v: u8) u8 {
    if (v < 10) { ret '0' + v; }
    ret 'a' + v - 10;
}

# the writes to the sink, the only place a write fails. each does nothing once
# the dump has failed
fun put_bytes(d: *Dumper, p: *u8, n: usize) {
    if (sel d.failed.none) { keep_outcome(d, sink.bytes(d.out, p, n)); }
}

fun put_text(d: *Dumper, t: str) {
    if (sel d.failed.none) { keep_outcome(d, sink.text(d.out, t)); }
}

fun put_u8(d: *Dumper, c: u8) {
    if (sel d.failed.none) { keep_outcome(d, sink.u8(d.out, c)); }
}

fun put_number(d: *Dumper, v: u64, radix: u64) {
    if (sel d.failed.none) { keep_outcome(d, sink.number(d.out, v, radix)); }
}
