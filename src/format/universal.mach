# the universal format and its registration
#
# a fat Mach-O file is a container of thin files, one per architecture. its
# model is the fat model, read and written by the Mach-O modules, and its
# members are its slices, each named by the architecture row its entry codes
# and handed over with that code, so whoever takes a member chooses it by the
# exact row. the dump prints the header, the architecture table and every
# slice as the thin file it holds.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store;
use mink.base.store.Bytes;
