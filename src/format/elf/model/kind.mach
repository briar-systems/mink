# the kind of file an ELF model is
#
# one row per e_type, looked up by code. a row states its kind, or that the
# dynamic entries decide it, as for ET_DYN: one whose DT_FLAGS_1 has DF_1_PIE
# is a PIE, one with no entry point is a shared object, and one with an entry
# point and no DF_1_PIE is both, as libc and the dynamic loader are. an ET_DYN
# with an entry point whose dynamic entries are not held is refused, as
# whether it is a PIE cannot be told. ET_NONE and the OS and processor ranges
# have no row and are refused.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.format.elf.model.model;
use mink.format.elf.model.model.Body;
use mink.format.elf.model.model.Dyn;
use mink.format.elf.model.model.Elf;
use mink.format.elf.model.model.Header;
use mink.format.elf.model.model.Section;
use mink.format.elf.model.model.Segment;
use mink.format.elf.model.model.Shape;
use mink.format.elf.model.tables;
use mink.format.elf.model.tables.Constant;

# how a row decides the kind
# ---
# fixed:   the e_type alone
# dynamic: the dynamic entries and the entry point
tag Decides: u8 {
    fixed: *Kind;
    dynamic;
}

# code:    the e_type
# decides: how the kind of a file of that type is decided
rec Type {
    code:    *Constant;
    decides: Decides;
}

val REL:  Type = Type{code: ?tables.ET_REL, decides: Decides.fixed{?kind.RELOCATABLE}};
val EXEC: Type = Type{code: ?tables.ET_EXEC, decides: Decides.fixed{?kind.EXECUTABLE}};
val DYN:  Type = Type{code: ?tables.ET_DYN, decides: Decides.dynamic{}};
val CORE: Type = Type{code: ?tables.ET_CORE, decides: Decides.fixed{?kind.CORE}};

val ROW_COUNT: usize            = 4;
val ROWS:      [ROW_COUNT]*Type = [ROW_COUNT]*Type{?REL, ?EXEC, ?DYN, ?CORE};

# the rows ascending by code
val CODES: [ROW_COUNT]*Type = [ROW_COUNT]*Type{?REL, ?EXEC, ?DYN, ?CORE};

# the e_types refused as having no kind
val REFUSED_COUNT: usize                    = 5;
val REFUSED:       [REFUSED_COUNT]*Constant = [REFUSED_COUNT]*Constant{?tables.ET_NONE, ?tables.ET_LOOS, ?tables.ET_HIOS, ?tables.ET_LOPROC, ?tables.ET_HIPROC};

fun order_codes(a: **Type, b: **Type) i64 {
    val x: u64 = a[0].code.value;
    val y: u64 = b[0].code.value;
    if (x < y) { ret -1; }
    if (x > y) { ret 1; }
    ret 0;
}

fun row_of(code: u64) opt[*Type] {
    var c:     Constant = Constant{value: code};
    var probe: Type     = Type{code: ?c};
    ret index.find[Type](?CODES[0], ROW_COUNT, ?probe, order_codes);
}

pub fun of(m: *Elf) res[*Kind, Fail] {
    val t:   u64        = m.header.type::u64;
    val row: opt[*Type] = row_of(t);
    if (sel row.none) {
        ret res[*Kind, Fail].err{fail.valued(fail.in_record(fail.unsupported("no kind of file has this e_type"), "file header"), t::i128)};
    }
    val d: Decides = row.some.decides;
    if (sel d.fixed) { ret res[*Kind, Fail].ok{d.fixed}; }
    ret dynamic(m);
}

# the kind of an ET_DYN
fun dynamic(m: *Elf) res[*Kind, Fail] {
    var held:  bool  = false;
    var flags: u64   = 0;
    var i:     usize = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = table.at[Section](?m.sections, table.nth[Section](i));
        if (sel s.body.dynamic) {
            held = true;
            var k: usize = 0;
            for (k < table.count[Dyn](?s.body.dynamic)) {
                val d: *Dyn = table.at[Dyn](?s.body.dynamic, table.nth[Dyn](k));
                if (d.kind::u64 == tables.DT_FLAGS_1.value) { flags = flags | d.value; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    if ((flags & tables.DF_1_PIE.value) != 0) { ret res[*Kind, Fail].ok{?kind.PIE}; }
    if (m.header.entry == 0)                  { ret res[*Kind, Fail].ok{?kind.SHARED}; }
    if (!held && has_dynamic(m)) {
        ret res[*Kind, Fail].err{fail.in_record(fail.unsupported("the dynamic entries are not held, so whether the ET_DYN is a PIE cannot be told"), "file header")};
    }
    ret res[*Kind, Fail].ok{?kind.PIE_SHARED};
}

# whether `m` has dynamic entries, as a segment or a section
fun has_dynamic(m: *Elf) bool {
    var i: usize = 0;
    for (i < table.count[Segment](?m.segments)) {
        if (table.at[Segment](?m.segments, table.nth[Segment](i)).type::u64 == tables.PT_DYNAMIC.value) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Section](?m.sections)) {
        if (table.at[Section](?m.sections, table.nth[Section](i)).type::u64 == tables.SHT_DYNAMIC.value) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the kind of an ET_DYN with entry point `entry` and a dynamic section whose
# DT_FLAGS_1 is `flags`, or only a PT_DYNAMIC segment when `segment_only`
fun dyn_kind(a: *A.Allocator, entry: u64, flags: u64, segment_only: bool) res[*Kind, Fail] {
    var m: Elf = model.make(a, Shape{class: ?model.CLASS64, order: LITTLE});
    m.header = Header{type: tables.ET_DYN.value::u16, entry: entry};
    var got: res[*Kind, Fail] = res[*Kind, Fail].err{fail.internal("not built")};
    if (segment_only) {
        val p: res[Id[Segment], Fail] = table.push[Segment](?m.segments, Segment{type: tables.PT_DYNAMIC.value::u32});
        if (sel p.ok) { got = of(?m); }
    }
    or {
        var dyn: Table[Dyn]             = table.make[Dyn](a);
        val f:   res[Id[Dyn], Fail]     = table.push[Dyn](?dyn, Dyn{kind: tables.DT_FLAGS_1.value::i64, value: flags});
        val s:   res[Id[Section], Fail] = table.push[Section](?m.sections, Section{type: tables.SHT_DYNAMIC.value::u32, body: Body.dynamic{dyn}});
        if (sel f.ok && sel s.ok) { got = of(?m); }
    }
    val r: err[Fail] = model.release(?m);
    if (sel r.err) { ret res[*Kind, Fail].err{r.err}; }
    ret got;
}

fun is(r: res[*Kind, Fail], k: *Kind) bool {
    if (sel r.ok) { ret r.ok == k; }
    ret false;
}

fun unsupported(r: res[*Kind, Fail]) bool {
    if (sel r.err) { ret sel r.err.cause.unsupported; }
    ret false;
}

test kind__every_elf_type_has_one_row_or_is_refused {
    val rows:  [ROW_COUNT]*Type = ROWS;
    val built: err[Fail]        = index.verify[Type](?CODES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_codes);
    if (sel built.err) { ret 1; }
    var i: usize = 0;
    for (i < tables.ET.count) {
        val code:    *Constant  = tables.ET.rows[i];
        val row:     opt[*Type] = row_of(code.value);
        var refused: usize      = 0;
        var k:       usize      = 0;
        for (k < REFUSED_COUNT) {
            if (REFUSED[k] == code) { refused = refused + 1; }
            k = k + 1;
        }
        if (sel row.some) {
            if (row.some.code != code || refused != 0) { ret 2; }
        }
        or (refused != 1) {
            ret 3;
        }
        i = i + 1;
    }
    val inside: opt[*Type] = row_of(tables.ET_LOOS.value + 1);
    if (!sel inside.none) { ret 4; }
    ret 0;
}

test kind__an_elf_type_is_its_kind_and_an_et_dyn_is_told_apart {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);
    var m: Elf          = model.make(a, Shape{class: ?model.CLASS64, order: LITTLE});
    m.header.type = tables.ET_REL.value::u16;
    if (!is(of(?m), ?kind.RELOCATABLE)) { ret 1; }
    m.header.type = tables.ET_EXEC.value::u16;
    if (!is(of(?m), ?kind.EXECUTABLE)) { ret 1; }
    m.header.type = tables.ET_CORE.value::u16;
    if (!is(of(?m), ?kind.CORE)) { ret 1; }
    m.header.type = tables.ET_NONE.value::u16;
    if (!unsupported(of(?m)))                                              { ret 1; }
    if (!is(dyn_kind(a, 0x1000, tables.DF_1_PIE.value, false), ?kind.PIE)) { ret 2; }
    if (!is(dyn_kind(a, 0, 0, false), ?kind.SHARED))                       { ret 3; }
    if (!is(dyn_kind(a, 0x1000, 0, false), ?kind.PIE_SHARED))              { ret 4; }
    if (!is(dyn_kind(a, 0, 0, true), ?kind.SHARED))                        { ret 5; }
    if (!unsupported(dyn_kind(a, 0x1000, 0, true)))                        { ret 6; }
    val r: err[Fail] = model.release(?m);
    if (sel r.err)             { ret 7; }
    if (T.live_count(?t) != 0) { ret 8; }
    T.dnit(?t);
    ret 0;
}
