# the ELF model, every byte of an ELF file
#
# one model serves both classes and both byte orders. a Shape names the class,
# whose rows give every record's size and the place of each field, and the
# byte order. every field is held as its raw number, so a value in a reserved,
# processor specific or system specific range is kept as it was. what the
# numbers mean is the tables', never the model's.
#
# the file is an ordered list of extents tiling it from its first byte to its
# last: the file header, the program header table, the section header table,
# a section's bytes, or raw bytes no record covers, such as padding and gaps.
# a typed section body tiles its section exactly, record after record with
# the padding its specification fixes. a section no typed body tiles is held
# as raw bytes, so a writer gives back every input byte for byte.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Raw;
use mink.base.store.Store;
use mink.base.store.Why;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.BIG;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Order;
use mink.bytes.slot.Slot;
use mink.bytes.slot.field;
use mink.bytes.slot.set_field;
use mink.format.elf.model.tables;

# the e_ident bytes after the magic, at the same place in both classes
pub rec IdentShape {
    size:       usize;
    class:      Slot;
    data:       Slot;
    version:    Slot;
    osabi:      Slot;
    abiversion: Slot;
    pad:        Slot;
}

pub rec HeaderShape {
    size:      usize;
    type:      Slot;
    machine:   Slot;
    version:   Slot;
    entry:     Slot;
    phoff:     Slot;
    shoff:     Slot;
    flags:     Slot;
    ehsize:    Slot;
    phentsize: Slot;
    phnum:     Slot;
    shentsize: Slot;
    shnum:     Slot;
    shstrndx:  Slot;
}

pub rec SegmentShape {
    size:   usize;
    type:   Slot;
    flags:  Slot;
    offset: Slot;
    vaddr:  Slot;
    paddr:  Slot;
    filesz: Slot;
    memsz:  Slot;
    align:  Slot;
}

pub rec SectionShape {
    size:      usize;
    name:      Slot;
    type:      Slot;
    flags:     Slot;
    addr:      Slot;
    offset:    Slot;
    length:    Slot;
    link:      Slot;
    info:      Slot;
    addralign: Slot;
    entsize:   Slot;
}

pub rec SymbolShape {
    size:  usize;
    name:  Slot;
    info:  Slot;
    other: Slot;
    shndx: Slot;
    value: Slot;
    bytes: Slot;
}

# a REL record leaves the addend slot empty
pub rec RelocShape {
    size:   usize;
    offset: Slot;
    info:   Slot;
    addend: Slot;
}

pub rec DynShape {
    size:  usize;
    kind:  Slot;
    value: Slot;
}

pub rec ChdrShape {
    size:      usize;
    type:      Slot;
    reserved:  Slot;
    length:    Slot;
    addralign: Slot;
}

# one file class: the width of an address and the shape of every record whose
# shape follows the class
# ---
# addr:       the width of an address, an offset and a RELR or bloom word
# info_shift: where a relocation's info splits into symbol above and type below
pub rec Class {
    addr:       usize;
    info_shift: u8;
    header:     HeaderShape;
    segment:    SegmentShape;
    section:    SectionShape;
    symbol:     SymbolShape;
    rel:        RelocShape;
    rela:       RelocShape;
    dyn:        DynShape;
    chdr:       ChdrShape;
}

# a file's class and byte order
pub rec Shape {
    class: *Class;
    order: Order;
}

pub val IDENT: IdentShape = IdentShape{
    size:       16,
    class:      Slot{offset: 4, width: 1},
    data:       Slot{offset: 5, width: 1},
    version:    Slot{offset: 6, width: 1},
    osabi:      Slot{offset: 7, width: 1},
    abiversion: Slot{offset: 8, width: 1},
    pad:        Slot{offset: 9, width: 7},
};

