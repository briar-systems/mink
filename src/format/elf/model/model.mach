# the records whose shape is the same in both classes
pub rec NoteShape {
    size:   usize;
    namesz: Slot;
    descsz: Slot;
    type:   Slot;
}

pub rec PropertyShape {
    size:   usize;
    type:   Slot;
    datasz: Slot;
}

pub rec VerdefShape {
    size:    usize;
    version: Slot;
    flags:   Slot;
    ndx:     Slot;
    cnt:     Slot;
    hash:    Slot;
    aux:     Slot;
    next:    Slot;
}

pub rec VerdauxShape {
    size: usize;
    name: Slot;
    next: Slot;
}

pub rec VerneedShape {
    size:    usize;
    version: Slot;
    cnt:     Slot;
    file:    Slot;
    aux:     Slot;
    next:    Slot;
}

pub rec VernauxShape {
    size:  usize;
    hash:  Slot;
    flags: Slot;
    other: Slot;
    name:  Slot;
    next:  Slot;
}

pub val NOTE: NoteShape = NoteShape{
    size:   12,
    namesz: Slot{offset: 0, width: 4},
    descsz: Slot{offset: 4, width: 4},
    type:   Slot{offset: 8, width: 4},
};

pub val PROPERTY: PropertyShape = PropertyShape{
    size:   8,
    type:   Slot{offset: 0, width: 4},
    datasz: Slot{offset: 4, width: 4},
};

pub val VERDEF: VerdefShape = VerdefShape{
    size:    20,
    version: Slot{offset: 0, width: 2},
    flags:   Slot{offset: 2, width: 2},
    ndx:     Slot{offset: 4, width: 2},
    cnt:     Slot{offset: 6, width: 2},
    hash:    Slot{offset: 8, width: 4},
    aux:     Slot{offset: 12, width: 4},
    next:    Slot{offset: 16, width: 4},
};

pub val VERDAUX: VerdauxShape = VerdauxShape{
    size: 8,
    name: Slot{offset: 0, width: 4},
    next: Slot{offset: 4, width: 4},
};

pub val VERNEED: VerneedShape = VerneedShape{
    size:    16,
    version: Slot{offset: 0, width: 2},
    cnt:     Slot{offset: 2, width: 2},
    file:    Slot{offset: 4, width: 4},
    aux:     Slot{offset: 8, width: 4},
    next:    Slot{offset: 12, width: 4},
};

pub val VERNAUX: VernauxShape = VernauxShape{
    size:  16,
    hash:  Slot{offset: 0, width: 4},
    flags: Slot{offset: 4, width: 2},
    other: Slot{offset: 6, width: 2},
    name:  Slot{offset: 8, width: 4},
    next:  Slot{offset: 12, width: 4},
};

# the width of a .gnu.version entry, a group word, a hash word and an
# extended section index
pub val HALF: usize = 2;
pub val WORD: usize = 4;

# the symbol index a relocation's info holds as written. a consumer resolves it
# only through rel_symbol and rela_symbol
fun info_symbol_number(c: *Class, info: u64) u64 {
    ret info >> c.info_shift::u64;
}

# the relocation type a relocation's info names
pub fun reloc_type(c: *Class, info: u64) u64 {
    ret info & ((1::u64 << c.info_shift::u64) - 1);
}

pub fun reloc_info(c: *Class, symbol: u64, type: u64) u64 {
    ret (symbol << c.info_shift::u64) | type;
}

# the e_ident bytes the class and data encoding do not already state
pub rec Ident {
    version:    u8;
    osabi:      u8;
    abiversion: u8;
    pad:        [7]u8;
}

# the file header. e_phnum, e_shnum and e_shstrndx are held as written, and
# read through the accessors that resolve extended numbering
pub rec Header {
    ident:     Ident;
    type:      u16;
    machine:   u16;
    version:   u32;
    entry:     u64;
    phoff:     u64;
    shoff:     u64;
    flags:     u32;
    ehsize:    u16;
    phentsize: u16;
    phnum:     u16;
    shentsize: u16;
    shnum:     u16;
    shstrndx:  u16;
}

# a program header
pub rec Segment {
    type:   u32;
    flags:  u32;
    offset: u64;
    vaddr:  u64;
    paddr:  u64;
    filesz: u64;
    memsz:  u64;
    align:  u64;
}

# a symbol table entry. `bytes` is st_size. `name` and `shndx` are held as
# written for the writer, and a consumer resolves them only through symbol_name
# and symbol_section
pub rec Symbol {
    name:  u32;
    info:  u8;
    other: u8;
    shndx: u16;
    value: u64;
    bytes: u64;
}

# a REL relocation. the symbol index in `info` is held as written for the
# writer, and a consumer resolves it only through rel_symbol
pub rec Rel {
    offset: u64;
    info:   u64;
}

# a RELA relocation. the symbol index in `info` is held as written for the
# writer, and a consumer resolves it only through rela_symbol
pub rec Rela {
    offset: u64;
    info:   u64;
    addend: i64;
}

# a dynamic entry: d_tag and d_val or d_ptr. a string offset in `value` is held
# as written for the writer, and a consumer resolves it only through
# dynamic_string
pub rec Dyn {
    kind:  i64;
    value: u64;
}

# one property of a GNU property note, followed by the padding its class sets
pub rec Property {
    type:   u32;
    datasz: u32;
    data:   Held;
}

# a note descriptor, raw with its reason, or parsed into properties when it is a GNU
# property note. a build id descriptor is its raw bytes
pub tag Desc: u8 {
    raw:        Raw;
    properties: Table[Property];
}

# a note entry. its name is padded to four bytes and its descriptor to the
# section's alignment
pub rec Note {
    namesz: u32;
    descsz: u32;
    type:   u32;
    name:   Held;
    desc:   Desc;
}

pub rec Verdef {
    version: u16;
    flags:   u16;
    ndx:     u16;
    cnt:     u16;
    hash:    u32;
    aux:     u32;
    next:    u32;
}

# a version definition's name. `name` is held as written for the writer, and a
# consumer resolves it only through definition_name
pub rec Verdaux {
    name: u32;
    next: u32;
}

# a record of .gnu.version_d, in section order
pub tag Definition: u8 {
    verdef:  Verdef;
    verdaux: Verdaux;
}

# a version requirement. `file` is held as written for the writer, and a
# consumer resolves it only through requirement_file
pub rec Verneed {
    version: u16;
    cnt:     u16;
    file:    u32;
    aux:     u32;
    next:    u32;
}

# a needed version. `name` is held as written for the writer, and a consumer
# resolves it only through requirement_name
pub rec Vernaux {
    hash:  u32;
    flags: u16;
    other: u16;
    name:  u32;
    next:  u32;
}

# a record of .gnu.version_r, in section order
pub tag Need: u8 {
    verneed: Verneed;
    vernaux: Vernaux;
}

# an SHT_GROUP section: its flag word and the indexes of its members. the
# indexes are held as written for the writer, and a consumer resolves them only
# through group_member
pub rec Group {
    flags:   u32;
    members: Table[u32];
}

# a SysV hash table. nbucket and nchain are the counts of the two tables
pub rec Hash {
    buckets: Table[u32];
    chains:  Table[u32];
}

# a GNU hash table. nbuckets and bloom_size are the counts of their tables,
# and the chain runs to the end of the section
pub rec GnuHash {
    symoffset: u32;
    shift:     u32;
    bloom:     Table[u64];
    buckets:   Table[u32];
    chain:     Table[u32];
}

# a compression header and the compressed bytes after it, held compressed
pub rec Compressed {
    type:      u32;
    reserved:  u32;
    length:    u64;
    addralign: u64;
    data:      Held;
}

# what a section's bytes hold
# ---
# empty:      no bytes in the file, as for SHT_NULL and SHT_NOBITS
# overlaid:   bytes other extents hold, for a section that overlaps another
# raw:        bytes no typed body tiles, and why
# symbols:    .symtab or .dynsym
# shndx:      .symtab_shndx, the extended section index of each symbol
# rel:        REL relocations
# rela:       RELA relocations
# relr:       RELR words, each the class's address width
# dynamic:    dynamic entries
# notes:      note entries
# versym:     .gnu.version
# verdef:     .gnu.version_d
# verneed:    .gnu.version_r
# group:      an SHT_GROUP section
# hash:       a SysV hash table
# gnu_hash:   a GNU hash table
# compressed: an SHF_COMPRESSED section
pub tag Body: u8 {
    empty;
    overlaid;
    raw:        Raw;
    symbols:    Table[Symbol];
    shndx:      Table[u32];
    rel:        Table[Rel];
    rela:       Table[Rela];
    relr:       Table[u64];
    dynamic:    Table[Dyn];
    notes:      Table[Note];
    versym:     Table[u16];
    verdef:     Table[Definition];
    verneed:    Table[Need];
    group:      Group;
    hash:       Hash;
    gnu_hash:   GnuHash;
    compressed: Compressed;
}

# a section header and what its bytes hold. `length` is sh_size. `name`, and
# `link` and `info` where they name a section or a symbol, are held as written
# for the writer, and a consumer resolves them only through section_name,
# linked_section, info_section, linked_symbols and info_symbol
pub rec Section {
    name:      u32;
    type:      u32;
    flags:     u64;
    addr:      u64;
    offset:    u64;
    length:    u64;
    link:      u32;
    info:      u32;
    addralign: u64;
    entsize:   u64;
    body:      Body;
}

# one extent of the file, in file order
# ---
# header:   the file header
# segments: the program header table
# sections: the section header table
# section:  a section's bytes
# raw:      bytes no record covers, and why
pub tag Extent: u8 {
    header;
    segments;
    sections;
    section: Id[Section];
    raw:     Raw;
}

# a section index as a builder writes it for a symbol: a section's number, or
# a reserved value such as an absolute or common marker
pub tag Index: u8 {
    section:  u32;
    reserved: u16;
}

# what a section index names
# ---
# undefined: no section, as for a symbol defined elsewhere
# absolute:  a value that is no address
# common:    a common block the link allocates
# section:   a section of the table
# reserved:  another value of the range the tables' SHN_LORESERVE row starts
pub tag SectionRef: u8 {
    undefined;
    absolute;
    common;
    section:  Id[Section];
    reserved: u16;
}

# a symbol table and what its symbols resolve through: the string table of
# their names and its SHT_SYMTAB_SHNDX words, when it has them. the table
# pointers stay valid until the section table next grows
pub rec Symbols {
    section:  Id[Section];
    symbols:  *Table[Symbol];
    strings:  Id[Section];
    extended: opt[*Table[u32]];
}

# a whole ELF file
# ---
# a:        the allocator every table lives in
# shape:    its class and byte order
# header:   the file header
# segments: the program headers, in table order
# sections: the section headers, in table order
# extents:  the file, in file order
# store:    the bytes the model owns
pub rec Elf {
    a:        *A.Allocator;
    shape:    Shape;
    header:   Header;
    segments: Table[Segment];
    sections: Table[Section];
    extents:  Table[Extent];
    store:    Store;
}

pub fun make(a: *A.Allocator, shape: Shape) Elf {
    ret Elf{
        a:        a,
        shape:    shape,
        segments: table.make[Segment](a),
        sections: table.make[Section](a),
        extents:  table.make[Extent](a),
        store:    store.make(a),
    };
}

# give everything the model owns back, reporting the first refusal
pub fun release(m: *Elf) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[Section](?m.sections)) {
        first = fail.kept(first, release_body(?table.at[Section](?m.sections, table.nth[Section](i)).body));
        i     = i + 1;
    }
    first = fail.kept(first, table.release[Segment](?m.segments));
    first = fail.kept(first, table.release[Section](?m.sections));
    first = fail.kept(first, table.release[Extent](?m.extents));
    ret fail.kept(first, store.release(?m.store));
}

# a copy of the `n` bytes at `p` the model owns
pub fun own(m: *Elf, p: *u8, n: usize) res[Held, Fail] {
    ret store.own(?m.store, p, n);
}

# the bytes of `h`. owned bytes stay valid until the model next owns bytes
pub fun bytes(m: *Elf, h: *Held) Bytes {
    ret store.bytes(?m.store, h);
}

pub fun segment_at(m: *Elf, id: Id[Segment]) *Segment {
    ret table.at[Segment](?m.segments, id);
}

pub fun section_at(m: *Elf, id: Id[Section]) *Section {
    ret table.at[Section](?m.sections, id);
}

# the number of section headers, read through section header 0 when e_shnum
# overflows
pub fun section_count(m: *Elf) res[u64, Fail] {
    if (m.header.shnum != 0 || m.header.shoff == 0) { ret res[u64, Fail].ok{m.header.shnum::u64}; }
    val zero: res[*Section, Fail] = first_section(m);
    if (sel zero.err) { ret res[u64, Fail].err{zero.err}; }
    ret res[u64, Fail].ok{zero.ok.length};
}

# the number of program headers, read through section header 0 when e_phnum
# overflows
pub fun segment_count(m: *Elf) res[u64, Fail] {
    if (m.header.phnum != tables.PN_XNUM.value::u16) { ret res[u64, Fail].ok{m.header.phnum::u64}; }
    val zero: res[*Section, Fail] = first_section(m);
    if (sel zero.err) { ret res[u64, Fail].err{zero.err}; }
    ret res[u64, Fail].ok{zero.ok.info::u64};
}

# write the counts of the header tables and the section name table `strings`
# into the header, overflowing into section header 0 as the gABI sets
pub fun renumber(m: *Elf, strings: opt[Id[Section]]) err[Fail] {
    val shnum: u64 = table.count[Section](?m.sections)::u64;
    val phnum: u64 = table.count[Segment](?m.segments)::u64;
    var index: u64 = tables.SHN_UNDEF.value::u16::u64;
    if (sel strings.some) { index = strings.some.index::u64; }
    if (shnum == 0) {
        if (phnum >= tables.PN_XNUM.value::u16::u64) {
            ret err[Fail].err{fail.in_record(fail.malformed("program header count overflows with no section header 0"), "file header")};
        }
        if (index != tables.SHN_UNDEF.value::u16::u64) {
            ret err[Fail].err{fail.in_record(fail.malformed("section name table names a section of none"), "file header")};
        }
        m.header.shnum    = 0;
        m.header.shstrndx = tables.SHN_UNDEF.value::u16;
        m.header.phnum    = phnum::u16;
        ret err[Fail].ok{};
    }
    val zero: *Section = section_at(m, table.nth[Section](0));
    zero.length    = 0;
    zero.link      = 0;
    zero.info      = 0;
    m.header.shnum = shnum::u16;
    if (shnum >= tables.SHN_LORESERVE.value::u16::u64) {
        m.header.shnum = 0;
        zero.length    = shnum;
    }
    m.header.shstrndx = index::u16;
    if (index >= tables.SHN_LORESERVE.value::u16::u64) {
        m.header.shstrndx = tables.SHN_XINDEX.value::u16;
        zero.link         = index::u32;
    }
    m.header.phnum = phnum::u16;
    if (phnum >= tables.PN_XNUM.value::u16::u64) {
        m.header.phnum = tables.PN_XNUM.value::u16;
        zero.info      = phnum::u32;
    }
    ret err[Fail].ok{};
}

# the bytes of the empty name
val NO_NAME: [1]u8 = [1]u8{0};

# the dynamic entries whose value is an offset into the dynamic string table
val STRING_TAGS: [6]*tables.DynTag = [6]*tables.DynTag{
    ?tables.DT_NEEDED,
    ?tables.DT_SONAME,
    ?tables.DT_RPATH,
    ?tables.DT_RUNPATH,
    ?tables.DT_AUXILIARY,
    ?tables.DT_FILTER,
};

# the section `number` names, absent for SHN_UNDEF
fun resolve_section(m: *Elf, number: u64, record: str, index: u64) res[opt[Id[Section]], Fail] {
    if (number == tables.SHN_UNDEF.value) { ret res[opt[Id[Section]], Fail].ok{opt[Id[Section]].none{}}; }
    if (number >= table.count[Section](?m.sections)::u64) {
        ret res[opt[Id[Section]], Fail].err{fail.malformed_at("section index is outside the section table", record, index, number::i128)};
    }
    ret res[opt[Id[Section]], Fail].ok{opt[Id[Section]].some{table.nth[Section](number::usize)}};
}

# the string table section `at` links, as a symbol table, a dynamic section or a
# version section links its names
fun linked_strings(m: *Elf, at: Id[Section]) res[Id[Section], Fail] {
    val link: u32 = section_at(m, at).link;
    if (link::usize >= table.count[Section](?m.sections)) {
        ret res[Id[Section], Fail].err{fail.malformed_at("string table index is outside the section table", "section header", at.index::u64, link::i128)};
    }
    ret res[Id[Section], Fail].ok{table.nth[Section](link::usize)};
}

# the NUL terminated string at `offset` of the string table `strings`, without
# its terminator. offset zero is the empty string every string table starts with
fun resolve_string(m: *Elf, strings: Id[Section], offset: u64, record: str, index: u64) res[Bytes, Fail] {
    if (offset == 0) { ret res[Bytes, Fail].ok{Bytes{data: ?NO_NAME[0], len: 0}}; }
    val s: *Section = section_at(m, strings);
    if (!sel s.body.raw) { ret res[Bytes, Fail].err{fail.malformed_at("string table holds no bytes", record, index, offset::i128)}; }
    val b: Bytes = bytes(m, ?s.body.raw.bytes);
    if (offset >= b.len::u64) { ret res[Bytes, Fail].err{fail.malformed_at("string offset is outside its string table", record, index, offset::i128)}; }
    var end: usize = offset::usize;
    for (end < b.len && b.data[end] != 0) { end = end + 1; }
    if (end == b.len) { ret res[Bytes, Fail].err{fail.malformed_at("string has no terminator", record, index, offset::i128)}; }
    ret res[Bytes, Fail].ok{Bytes{data: ?b.data[offset::usize], len: end - offset::usize}};
}

# the symbol `number` of a relocation names in the symbol table section `rels`
# links, absent for symbol zero
fun resolve_reloc(m: *Elf, rels: Id[Section], info: u64, index: u64) res[opt[Id[Symbol]], Fail] {
    val number: u64 = info_symbol_number(m.shape.class, info);
    if (number == 0) { ret res[opt[Id[Symbol]], Fail].ok{opt[Id[Symbol]].none{}}; }
    val link: u32 = section_at(m, rels).link;
    if (link::usize >= table.count[Section](?m.sections)) {
        ret res[opt[Id[Symbol]], Fail].err{fail.malformed_at("symbol table index is outside the section table", "section header", rels.index::u64, link::i128)};
    }
    val t: *Section = section_at(m, table.nth[Section](link::usize));
    if (!sel t.body.symbols) { ret res[opt[Id[Symbol]], Fail].err{fail.malformed_at("relocation names a symbol and its section links no symbol table", "relocation", index, number::i128)}; }
    if (number >= table.count[Symbol](?t.body.symbols)::u64) {
        ret res[opt[Id[Symbol]], Fail].err{fail.malformed_at("symbol index is outside the symbol table", "relocation", index, number::i128)};
    }
    ret res[opt[Id[Symbol]], Fail].ok{opt[Id[Symbol]].some{table.nth[Symbol](number::usize)}};
}

# the reference accessors below are how a consumer follows a number the file
# holds as written. each takes the record, which is the `at`th of its table, and
# a number outside the table it names is malformed at that record and index,
# carrying the number as written

# the section name string table, absent when the file has none, read through
# section header 0 when e_shstrndx overflows
pub fun section_names(m: *Elf) res[opt[Id[Section]], Fail] {
    if (m.header.shstrndx == tables.SHN_UNDEF.value::u16) { ret res[opt[Id[Section]], Fail].ok{opt[Id[Section]].none{}}; }
    var number: u64 = m.header.shstrndx::u64;
    if (m.header.shstrndx == tables.SHN_XINDEX.value::u16) {
        val zero: res[*Section, Fail] = first_section(m);
        if (sel zero.err) { ret res[opt[Id[Section]], Fail].err{zero.err}; }
        number = zero.ok.link::u64;
    }
    if (number >= table.count[Section](?m.sections)::u64) {
        ret res[opt[Id[Section]], Fail].err{fail.valued(fail.in_record(fail.malformed("section name table index is outside the section table"), "file header"), number::i128)};
    }
    ret res[opt[Id[Section]], Fail].ok{opt[Id[Section]].some{table.nth[Section](number::usize)}};
}

# the name of section `at`, in the section name string table
pub fun section_name(m: *Elf, at: Id[Section]) res[Bytes, Fail] {
    val s:     *Section                    = section_at(m, at);
    val names: res[opt[Id[Section]], Fail] = section_names(m);
    if (sel names.err) { ret res[Bytes, Fail].err{names.err}; }
    if (sel names.ok.none) {
        if (s.name != 0) { ret res[Bytes, Fail].err{fail.malformed_at("section names a string and the file has no section name table", "section header", at.index::u64, s.name::i128)}; }
        ret res[Bytes, Fail].ok{Bytes{data: ?NO_NAME[0], len: 0}};
    }
    val strings: Id[Section] = names.ok.some;
    ret resolve_string(m, strings, s.name::u64, "section header", at.index::u64);
}

# the section sh_link of section `at` names, absent when zero, for a section
# whose type or flags make sh_link a section index
pub fun linked_section(m: *Elf, at: Id[Section]) res[opt[Id[Section]], Fail] {
    ret resolve_section(m, section_at(m, at).link::u64, "section header", at.index::u64);
}

# the section sh_info of section `at` names, absent when zero, for a section
# whose type or flags make sh_info a section index
pub fun info_section(m: *Elf, at: Id[Section]) res[opt[Id[Section]], Fail] {
    ret resolve_section(m, section_at(m, at).info::u64, "section header", at.index::u64);
}

# the symbol table `syms` of section `symtab`, with the string table it links
# and the SHT_SYMTAB_SHNDX section that links it, when one does
pub fun symbols(m: *Elf, symtab: Id[Section], syms: *Table[Symbol]) res[Symbols, Fail] {
    val strings: res[Id[Section], Fail] = linked_strings(m, symtab);
    if (sel strings.err) { ret res[Symbols, Fail].err{strings.err}; }
    var extended: opt[*Table[u32]] = opt[*Table[u32]].none{};
    var i:        usize            = 0;
    for (i < table.count[Section](?m.sections)) {
        val x: *Section = section_at(m, table.nth[Section](i));
        if (sel x.body.shndx) {
            if (x.link == symtab.index) {
                extended = opt[*Table[u32]].some{?x.body.shndx};
                brk;
            }
        }
        i = i + 1;
    }
    ret res[Symbols, Fail].ok{Symbols{section: symtab, symbols: syms, strings: strings.ok, extended: extended}};
}

# the symbol table section `at` links, as a relocation, group, hash, version or
# extended index section links its symbols
pub fun linked_symbols(m: *Elf, at: Id[Section]) res[Symbols, Fail] {
    val link: u32 = section_at(m, at).link;
    if (link::usize >= table.count[Section](?m.sections)) {
        ret res[Symbols, Fail].err{fail.malformed_at("symbol table index is outside the section table", "section header", at.index::u64, link::i128)};
    }
    val id: Id[Section] = table.nth[Section](link::usize);
    val t:  *Section    = section_at(m, id);
    if (!sel t.body.symbols) { ret res[Symbols, Fail].err{fail.malformed_at("section links a section that holds no symbol table", "section header", at.index::u64, link::i128)}; }
    ret symbols(m, id, ?t.body.symbols);
}

# the name of symbol `at` of `t`
pub fun symbol_name(m: *Elf, t: *Symbols, at: Id[Symbol]) res[Bytes, Fail] {
    ret resolve_string(m, t.strings, table.at[Symbol](t.symbols, at).name::u64, "symbol", at.index::u64);
}

# the section symbol `at` of `t` is defined in, read through the table's
# extended section indexes when st_shndx is SHN_XINDEX
pub fun symbol_section(m: *Elf, t: *Symbols, at: Id[Symbol]) res[SectionRef, Fail] {
    val shndx:  u16 = table.at[Symbol](t.symbols, at).shndx;
    var number: u64 = shndx::u64;
    if (shndx == tables.SHN_XINDEX.value::u16) {
        if (sel t.extended.none) { ret res[SectionRef, Fail].err{fail.malformed_at("extended section index with no extended index section", "symbol", at.index::u64, number::i128)}; }
        val words: *Table[u32] = t.extended.some;
        if (at.index::usize >= table.count[u32](words)) {
            ret res[SectionRef, Fail].err{fail.malformed_at("symbol has no extended section index", "symbol", at.index::u64, number::i128)};
        }
        number = (@table.at[u32](words, table.nth[u32](at.index::usize)))::u64;
    }
    or (shndx == tables.SHN_ABS.value::u16)       { ret res[SectionRef, Fail].ok{SectionRef.absolute{}}; }
    or (shndx == tables.SHN_COMMON.value::u16)    { ret res[SectionRef, Fail].ok{SectionRef.common{}}; }
    or (shndx >= tables.SHN_LORESERVE.value::u16) { ret res[SectionRef, Fail].ok{SectionRef.reserved{shndx}}; }
    val r: res[opt[Id[Section]], Fail] = resolve_section(m, number, "symbol", at.index::u64);
    if (sel r.err)     { ret res[SectionRef, Fail].err{r.err}; }
    if (sel r.ok.none) { ret res[SectionRef, Fail].ok{SectionRef.undefined{}}; }
    val id: Id[Section] = r.ok.some;
    ret res[SectionRef, Fail].ok{SectionRef.section{id}};
}

# the symbol sh_info of section `at` names in `t`, the symbol table `at` links,
# as a group names its signature
pub fun info_symbol(m: *Elf, t: *Symbols, at: Id[Section]) res[Id[Symbol], Fail] {
    val info: u32 = section_at(m, at).info;
    if (info::usize >= table.count[Symbol](t.symbols)) {
        ret res[Id[Symbol], Fail].err{fail.malformed_at("symbol index is outside the symbol table", "section header", at.index::u64, info::i128)};
    }
    ret res[Id[Symbol], Fail].ok{table.nth[Symbol](info::usize)};
}

# the symbol REL relocation `r`, the `at`th of section `rels`, names in the
# symbol table that section links, absent for symbol zero
pub fun rel_symbol(m: *Elf, rels: Id[Section], at: Id[Rel], r: *Rel) res[opt[Id[Symbol]], Fail] {
    ret resolve_reloc(m, rels, r.info, at.index::u64);
}

# the symbol RELA relocation `r`, the `at`th of section `rels`, names in the
# symbol table that section links, absent for symbol zero
pub fun rela_symbol(m: *Elf, rels: Id[Section], at: Id[Rela], r: *Rela) res[opt[Id[Symbol]], Fail] {
    ret resolve_reloc(m, rels, r.info, at.index::u64);
}

# the string dynamic entry `e`, the `at`th of section `dynamic`, names in the
# string table that section links, absent when its tag names no string
pub fun dynamic_string(m: *Elf, dynamic: Id[Section], at: Id[Dyn], e: *Dyn) res[opt[Bytes], Fail] {
    var named: bool  = false;
    var i:     usize = 0;
    for (i < 6) {
        if (STRING_TAGS[i].value == e.kind::u64) { named = true; }
        i = i + 1;
    }
    if (!named) { ret res[opt[Bytes], Fail].ok{opt[Bytes].none{}}; }
    val strings: res[Id[Section], Fail] = linked_strings(m, dynamic);
    if (sel strings.err) { ret res[opt[Bytes], Fail].err{strings.err}; }
    val s: res[Bytes, Fail] = resolve_string(m, strings.ok, e.value, "dynamic entry", at.index::u64);
    if (sel s.err) { ret res[opt[Bytes], Fail].err{s.err}; }
    ret res[opt[Bytes], Fail].ok{opt[Bytes].some{s.ok}};
}

# the section group member `member`, the `at`th of its group, names
pub fun group_member(m: *Elf, at: Id[u32], member: u32) res[Id[Section], Fail] {
    if (member::usize >= table.count[Section](?m.sections)) {
        ret res[Id[Section], Fail].err{fail.malformed_at("group member is outside the section table", "group member", at.index::u64, member::i128)};
    }
    ret res[Id[Section], Fail].ok{table.nth[Section](member::usize)};
}

# the name of version definition name `a`, the `at`th record of section
# `verdef`, in the string table that section links
pub fun definition_name(m: *Elf, verdef: Id[Section], at: Id[Definition], a: *Verdaux) res[Bytes, Fail] {
    val strings: res[Id[Section], Fail] = linked_strings(m, verdef);
    if (sel strings.err) { ret res[Bytes, Fail].err{strings.err}; }
    ret resolve_string(m, strings.ok, a.name::u64, "version definition", at.index::u64);
}

# the file name of version requirement `v`, the `at`th record of section
# `verneed`, in the string table that section links
pub fun requirement_file(m: *Elf, verneed: Id[Section], at: Id[Need], v: *Verneed) res[Bytes, Fail] {
    val strings: res[Id[Section], Fail] = linked_strings(m, verneed);
    if (sel strings.err) { ret res[Bytes, Fail].err{strings.err}; }
    ret resolve_string(m, strings.ok, v.file::u64, "version requirement", at.index::u64);
}

# the name of needed version `a`, the `at`th record of section `verneed`, in
# the string table that section links
pub fun requirement_name(m: *Elf, verneed: Id[Section], at: Id[Need], a: *Vernaux) res[Bytes, Fail] {
    val strings: res[Id[Section], Fail] = linked_strings(m, verneed);
    if (sel strings.err) { ret res[Bytes, Fail].err{strings.err}; }
    ret resolve_string(m, strings.ok, a.name::u64, "version requirement", at.index::u64);
}

fun first_section(m: *Elf) res[*Section, Fail] {
    if (table.count[Section](?m.sections) == 0) {
        ret res[*Section, Fail].err{fail.in_record(fail.malformed("extended numbering with no section header 0"), "file header")};
    }
    ret res[*Section, Fail].ok{section_at(m, table.nth[Section](0))};
}

# where in `m` byte `offset` of the file falls, nothing for a byte no extent
# holds and for a model that holds no extents
pub fun locate(m: *Elf, offset: u64) Location {
    var at:  Location = Location{offset: offset, placed: true};
    var pos: u64      = 0;
    var i:   usize    = 0;
    for (i < table.count[Extent](?m.extents)) {
        val e:    *Extent = table.at[Extent](?m.extents, table.nth[Extent](i));
        var size: u64     = 0;
        var name: str     = nil;
        var each: u64     = 0;
        if (sel e.header) {
            size = m.shape.class.header.size::u64;
            name = "file header";
        }
        or (sel e.segments) {
            each = m.shape.class.segment.size::u64;
            size = table.count[Segment](?m.segments)::u64 * each;
            name = "program header";
        }
        or (sel e.sections) {
            each = m.shape.class.section.size::u64;
            size = table.count[Section](?m.sections)::u64 * each;
            name = "section header";
        }
        or (sel e.section) {
            size = section_at(m, e.section).length;
            name = "section";
        }
        or (sel e.raw) {
            size = bytes(m, ?e.raw.bytes).len::u64;
            name = "raw bytes";
        }
        if (offset - pos < size && offset >= pos) {
            at.record = name;
            if (each != 0) {
                at.index   = (offset - pos) / each;
                at.indexed = true;
            }
            if (sel e.section) {
                at.index   = e.section.index::u64;
                at.indexed = true;
            }
            ret at;
        }
        pos = pos + size;
        i   = i + 1;
    }
    ret Location{offset: offset, placed: true};
}

# give back what a section body owns
pub fun release_body(b: *Body) err[Fail] {
    if (sel b.symbols) { ret table.release[Symbol](?b.symbols); }
    if (sel b.shndx)   { ret table.release[u32](?b.shndx); }
    if (sel b.rel)     { ret table.release[Rel](?b.rel); }
    if (sel b.rela)    { ret table.release[Rela](?b.rela); }
    if (sel b.relr)    { ret table.release[u64](?b.relr); }
    if (sel b.dynamic) { ret table.release[Dyn](?b.dynamic); }
    if (sel b.versym)  { ret table.release[u16](?b.versym); }
    if (sel b.verdef)  { ret table.release[Definition](?b.verdef); }
    if (sel b.verneed) { ret table.release[Need](?b.verneed); }
    if (sel b.group)   { ret table.release[u32](?b.group.members); }
    if (sel b.hash) {
        val buckets: err[Fail] = table.release[u32](?b.hash.buckets);
        ret fail.kept(buckets, table.release[u32](?b.hash.chains));
    }
    if (sel b.gnu_hash) {
        var first: err[Fail] = table.release[u64](?b.gnu_hash.bloom);
        first = fail.kept(first, table.release[u32](?b.gnu_hash.buckets));
        ret fail.kept(first, table.release[u32](?b.gnu_hash.chain));
    }
    if (sel b.notes) {
        var first: err[Fail] = err[Fail].ok{};
        var i:     usize     = 0;
        for (i < table.count[Note](?b.notes)) {
            val n: *Note = table.at[Note](?b.notes, table.nth[Note](i));
            if (sel n.desc.properties) { first = fail.kept(first, table.release[Property](?n.desc.properties)); }
            i = i + 1;
        }
        ret fail.kept(first, table.release[Note](?b.notes));
    }
    ret err[Fail].ok{};
}
