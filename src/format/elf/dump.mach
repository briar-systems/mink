# the field keys of the dump, and the name each one prints, by key
pub val ELF_HEADER:           u32 = 0;
pub val IDENT:                u32 = 1;
pub val CLASS:                u32 = 2;
pub val DATA_ENCODING:        u32 = 3;
pub val FILE_VERSION:         u32 = 4;
pub val OSABI:                u32 = 5;
pub val ABI_VERSION:          u32 = 6;
pub val UNUSED:               u32 = 7;
pub val TYPE:                 u32 = 8;
pub val MACHINE:              u32 = 9;
pub val VERSION:              u32 = 10;
pub val ENTRY:                u32 = 11;
pub val PH_OFFSET:            u32 = 12;
pub val SH_OFFSET:            u32 = 13;
pub val FLAGS:                u32 = 14;
pub val HEADER_SIZE:          u32 = 15;
pub val PH_ENTSIZE:           u32 = 16;
pub val PH_COUNT:             u32 = 17;
pub val SH_ENTSIZE:           u32 = 18;
pub val SH_COUNT:             u32 = 19;
pub val STRTAB_INDEX:         u32 = 20;
pub val PROGRAM_HEADERS:      u32 = 21;
pub val PROGRAM_HEADER:       u32 = 22;
pub val OFFSET:               u32 = 23;
pub val VADDR:                u32 = 24;
pub val PADDR:                u32 = 25;
pub val FILE_SIZE:            u32 = 26;
pub val MEM_SIZE:             u32 = 27;
pub val ALIGNMENT:            u32 = 28;
pub val SECTIONS:             u32 = 29;
pub val SECTION:              u32 = 30;
pub val INDEX:                u32 = 31;
pub val NAME:                 u32 = 32;
pub val ADDRESS:              u32 = 33;
pub val SIZE:                 u32 = 34;
pub val LINK:                 u32 = 35;
pub val INFO:                 u32 = 36;
pub val ADDRALIGN:            u32 = 37;
pub val ENTSIZE:              u32 = 38;
pub val COMPRESSION:          u32 = 39;
pub val RESERVED:             u32 = 40;
pub val SYMBOLS:              u32 = 41;
pub val DYNAMIC_SYMBOLS:      u32 = 42;
pub val SYMBOL:               u32 = 43;
pub val VALUE:                u32 = 44;
pub val BINDING:              u32 = 45;
pub val OTHER:                u32 = 46;
pub val RELOCATIONS:          u32 = 47;
pub val RELOCATION:           u32 = 48;
pub val ADDEND:               u32 = 49;
pub val WORD:                 u32 = 50;
pub val DYNAMIC_SECTION:      u32 = 51;
pub val TAG:                  u32 = 52;
pub val NOTE_SECTIONS:        u32 = 53;
pub val NOTE_SECTION:         u32 = 54;
pub val NOTE:                 u32 = 55;
pub val OWNER:                u32 = 56;
pub val DATA_SIZE:            u32 = 57;
pub val DESCRIPTION:          u32 = 58;
pub val PROPERTIES:           u32 = 59;
pub val PROPERTY:             u32 = 60;
pub val VERSION_SYMBOLS:      u32 = 61;
pub val VERSION_DEFINITIONS:  u32 = 62;
pub val DEFINITION:           u32 = 63;
pub val AUXILIARY:            u32 = 64;
pub val HASH:                 u32 = 65;
pub val VERSION_REQUIREMENTS: u32 = 66;
pub val DEPENDENCY:           u32 = 67;
pub val COUNT:                u32 = 68;
pub val FILE:                 u32 = 69;
pub val GROUPS:               u32 = 70;
pub val GROUP:                u32 = 71;
pub val MEMBERS:              u32 = 72;
pub val MEMBER:               u32 = 73;
pub val HASH_TABLE:           u32 = 74;
pub val BUCKETS:              u32 = 75;
pub val CHAINS:               u32 = 76;
pub val GNU_HASH_TABLE:       u32 = 77;
pub val SYMBOL_OFFSET:        u32 = 78;
pub val BLOOM_SHIFT:          u32 = 79;
pub val BLOOM_FILTERS:        u32 = 80;

pub val HIDDEN:      u32 = 81;
pub val OS:          u32 = 82;
pub val ABI:         u32 = 83;
pub val BUILD_ID:    u32 = 84;
pub val SIGNATURE:   u32 = 85;
pub val PREDECESSOR: u32 = 86;
pub val ENTRIES:     u32 = 87;

pub val REASON:    u32 = 88;
pub val RAW_BYTES: u32 = 89;

pub val FIELD_COUNT: usize   = 90;
pub val FIELDS:      [90]str = [90]str{
    "ElfHeader", "Ident", "Class", "DataEncoding", "FileVersion", "OS/ABI", "ABIVersion", "Unused",
    "Type", "Machine", "Version", "Entry", "ProgramHeaderOffset", "SectionHeaderOffset", "Flags",
    "HeaderSize", "ProgramHeaderEntrySize", "ProgramHeaderCount", "SectionHeaderEntrySize",
    "SectionHeaderCount", "StringTableSectionIndex", "ProgramHeaders", "ProgramHeader", "Offset",
    "VirtualAddress", "PhysicalAddress", "FileSize", "MemSize", "Alignment", "Sections", "Section",
    "Index", "Name", "Address", "Size", "Link", "Info", "AddressAlignment", "EntrySize",
    "CompressionHeader", "Reserved", "Symbols", "DynamicSymbols", "Symbol", "Value", "Binding",
    "Other", "Relocations", "Relocation", "Addend", "Word", "DynamicSection", "Tag",
    "NoteSections", "NoteSection", "Note", "Owner", "Data size", "Description", "Properties",
    "Property", "VersionSymbols", "VersionDefinitions", "Definition", "Auxiliary", "Hash",
    "VersionRequirements", "Dependency", "Count", "FileName", "Groups", "Group", "Members", "Member",
    "HashTable", "Buckets", "Chains", "GnuHashTable", "SymbolOffset", "BloomShift", "BloomFilters",
    "Hidden", "OS", "ABI", "Build ID", "Signature", "Predecessor", "Entries",
    "Reason", "RawBytes",
};

# the symbol of a relocation that names no symbol
val DASH: [1]u8 = [1]u8{'-'};

# the constant tables of the machines whose tables mink carries, and the
# tables of each one: nil where the machine has none of that kind
rec Own {
    sht:   *Set;
    shf:   *Set;
    pt:    *Set;
    nt:    *Set;
    gnu:   *Set;
    dt:    *DynSet;
    rel64: *row.Set;
    rel32: *row.Set;
}

rec Machine {
    code: *Constant;
    own:  Own;
}

val MACHINE_COUNT: usize                  = 4;
val MACHINES:      [MACHINE_COUNT]Machine = [MACHINE_COUNT]Machine{
    Machine{code: ?tables.EM_X86_64, own: Own{sht: ?tables.SHT_X86_64, shf: ?tables.SHF_X86_64, nt: ?tables.NT_X86_64, gnu: ?tables.GNU_PROPERTY_X86_64, rel64: ?x86.X86_64, rel32: nil}},
    Machine{code: ?tables.EM_386, own: Own{rel64: nil, rel32: ?x86.X86}},
    Machine{code: ?tables.EM_AARCH64, own: Own{sht: ?tables.SHT_AARCH64, shf: ?tables.SHF_AARCH64, pt: ?tables.PT_AARCH64, nt: ?tables.NT_AARCH64, gnu: ?tables.GNU_PROPERTY_AARCH64, dt: ?tables.DT_AARCH64, rel64: ?aarch64.SET, rel32: nil}},
    Machine{code: ?tables.EM_RISCV, own: Own{sht: ?tables.SHT_RISCV, pt: ?tables.PT_RISCV, gnu: ?tables.GNU_PROPERTY_RISCV, dt: ?tables.DT_RISCV, rel64: ?riscv.RV64, rel32: ?riscv.RV32}},
};

# what a dump walks: the model, the dumper, the tables of its machine and its
# architecture, none for a machine no architecture row names
rec Ctx {
    m:    *Elf;
    d:    *Dumper;
    own:  Own;
    rel:  *row.Lookup;
    arch: opt[*Arch];
}

# the file as the model holds it, in file order: the file header, the program
# headers, the section headers, then the contents of the sections that hold
# records, each kind of content under the name llvm-readobj gives it
# ---
# m:    the model to print
# rows: the registry's index, which holds the relocation rows of its machine
# d:    the dumper that prints it
pub fun describe(m: *Elf, rows: *row.Registry, d: *Dumper) {
    var own: Own      = own_of(m.header.machine::u64);
    var c:   Ctx      = Ctx{m: m, d: d, own: own, arch: arch_of(m)};
    val set: *row.Set = rel_set(?own, m.shape.class.addr);
    if (set != nil) {
        val found: res[*row.Lookup, Fail] = row.find(rows, set.format, set.arch);
        if (sel found.err) {
            format_dump.keep(d, found.err);
            ret;
        }
        c.rel = found.ok;
    }
    walk(?c);
}

fun walk(c: *Ctx) {
    header(c);
    segments(c);
    sections(c);
    symbols(c);
    relocations(c);
    dynamics(c);
    notes(c);
    versions(c);
    groups(c);
    hashes(c);
    raw_extents(c);
}

# the bytes of the file no record covers, at their file offset
fun raw_extents(c: *Ctx) {
    val shape: *Class = c.m.shape.class;
    var at:    u64    = 0;
    var i:     usize  = 0;
    for (i < vector.length[Extent](?c.m.extents)) {
        val e: *Extent = ?c.m.extents.data[i];
        if (sel e.header)   { at = at + shape.header.size::u64; }
        if (sel e.segments) { at = at + table.count[Segment](?c.m.segments)::u64 * shape.segment.size::u64; }
        if (sel e.sections) { at = at + table.count[Section](?c.m.sections)::u64 * shape.section.size::u64; }
        if (sel e.section)  { at = at + model.section_at(c.m, e.section).length; }
        if (sel e.raw) {
            val size: u64 = model.bytes(c.m, ?e.raw.bytes).len::u64;
            format_dump.open(c.d, RAW_BYTES);
            format_dump.hex(c.d, OFFSET, at);
            format_dump.decimal(c.d, SIZE, size);
            format_dump.reason(c.d, REASON, ?e.raw.why);
            format_dump.close(c.d);
            at = at + size;
        }
        i = i + 1;
    }
}

# the dump of a model of this format, for the format's registration
pub fun dump(m: ptr, rows: *row.Registry, d: *Dumper) {
    describe(m::*Elf, rows, d);
}

# the relocation table of a file of `addr`-byte addresses
fun rel_set(own: *Own, addr: usize) *row.Set {
    if (addr == 8) { ret own.rel64; }
    ret own.rel32;
}

fun arch_of(m: *Elf) opt[*Arch] {
    val a: res[*Arch, Fail] = traits.arch_of(m);
    if (sel a.ok) { ret opt[*Arch].some{a.ok}; }
    ret opt[*Arch].none{};
}

fun own_of(machine: u64) Own {
    var i: usize = 0;
    for (i < MACHINE_COUNT) {
        if (MACHINES[i].code.value == machine) { ret MACHINES[i].own; }
        i = i + 1;
    }
    ret Own{};
}

fun header(c: *Ctx) {
    format_dump.open(c.d, ELF_HEADER);
    ident(c);
    format_dump.named(c.d, TYPE, c.m.header.type::u64, name_in(?tables.ET, nil, c.m.header.type::u64));
    format_dump.named(c.d, MACHINE, c.m.header.machine::u64, name_in(?tables.EM, nil, c.m.header.machine::u64));
    format_dump.decimal(c.d, VERSION, c.m.header.version::u64);
    format_dump.hex(c.d, ENTRY, c.m.header.entry);
    format_dump.hex(c.d, PH_OFFSET, c.m.header.phoff);
    format_dump.hex(c.d, SH_OFFSET, c.m.header.shoff);
    e_flags(c);
    format_dump.decimal(c.d, HEADER_SIZE, c.m.header.ehsize::u64);
    format_dump.decimal(c.d, PH_ENTSIZE, c.m.header.phentsize::u64);
    val pn: res[u64, Fail] = model.segment_count(c.m);
    if (sel pn.err) {
        format_dump.keep(c.d, pn.err);
        ret;
    }
    format_dump.decimal(c.d, PH_COUNT, pn.ok);
    format_dump.decimal(c.d, SH_ENTSIZE, c.m.header.shentsize::u64);
    val sn: res[u64, Fail] = model.section_count(c.m);
    if (sel sn.err) {
        format_dump.keep(c.d, sn.err);
        ret;
    }
    format_dump.decimal(c.d, SH_COUNT, sn.ok);
    format_dump.decimal(c.d, STRTAB_INDEX, c.m.header.shstrndx::u64);
    format_dump.close(c.d);
}

fun ident(c: *Ctx) {
    format_dump.open(c.d, IDENT);
    var cls: u64 = tables.ELFCLASS32.value::u64;
    if (c.m.shape.class.addr == 8) { cls = tables.ELFCLASS64.value::u64; }
    format_dump.named(c.d, CLASS, cls, name_in(?tables.ELFCLASS, nil, cls));
    var data: u64 = tables.ELFDATA2LSB.value::u64;
    if (c.m.shape.order == BIG) { data = tables.ELFDATA2MSB.value::u64; }
    format_dump.named(c.d, DATA_ENCODING, data, name_in(?tables.ELFDATA, nil, data));
    format_dump.decimal(c.d, FILE_VERSION, c.m.header.ident.version::u64);
    format_dump.named(c.d, OSABI, c.m.header.ident.osabi::u64, name_in(?tables.ELFOSABI, nil, c.m.header.ident.osabi::u64));
    format_dump.decimal(c.d, ABI_VERSION, c.m.header.ident.abiversion::u64);
    format_dump.bytes(c.d, UNUSED, ?c.m.header.ident.pad[0], 7);
    format_dump.close(c.d);
}

fun segments(c: *Ctx) {
    val n: usize = table.count[Segment](?c.m.segments);
    if (n == 0) { ret; }
    format_dump.open(c.d, PROGRAM_HEADERS);
    var i: usize = 0;
    for (i < n) {
        segment(c, model.segment_at(c.m, table.nth[Segment](i)));
        i = i + 1;
    }
    format_dump.close(c.d);
}

fun segment(c: *Ctx, s: *Segment) {
    format_dump.open(c.d, PROGRAM_HEADER);
    format_dump.named(c.d, TYPE, s.type::u64, name_in(?tables.PT, c.own.pt, s.type::u64));
    format_dump.hex(c.d, OFFSET, s.offset);
    format_dump.hex(c.d, VADDR, s.vaddr);
    format_dump.hex(c.d, PADDR, s.paddr);
    format_dump.hex(c.d, FILE_SIZE, s.filesz);
    format_dump.hex(c.d, MEM_SIZE, s.memsz);
    flags(c.d, FLAGS, s.flags::u64, ?tables.PF, nil);
    format_dump.decimal(c.d, ALIGNMENT, s.align);
    format_dump.close(c.d);
}

fun sections(c: *Ctx) {
    val n: usize = table.count[Section](?c.m.sections);
    if (n == 0) { ret; }
    format_dump.open(c.d, SECTIONS);
    var i: usize = 0;
    for (i < n) {
        section(c, table.nth[Section](i), model.section_at(c.m, table.nth[Section](i)));
        i = i + 1;
    }
    format_dump.close(c.d);
}

fun section(c: *Ctx, at: Id[Section], s: *Section) {
    format_dump.open(c.d, SECTION);
    format_dump.decimal(c.d, INDEX, at.index::u64);
    name_field(c, NAME, at);
    format_dump.named(c.d, TYPE, s.type::u64, name_in(?tables.SHT, c.own.sht, s.type::u64));
    flags(c.d, FLAGS, s.flags, ?tables.SHF, c.own.shf);
    format_dump.hex(c.d, ADDRESS, s.addr);
    format_dump.hex(c.d, OFFSET, s.offset);
    format_dump.decimal(c.d, SIZE, s.length);
    format_dump.decimal(c.d, LINK, s.link::u64);
    format_dump.decimal(c.d, INFO, s.info::u64);
    format_dump.decimal(c.d, ADDRALIGN, s.addralign);
    format_dump.decimal(c.d, ENTSIZE, s.entsize);
    if (sel s.body.compressed) {
        compression(c, ?s.body.compressed);
    }
    if (sel s.body.raw) {
        format_dump.reason(c.d, REASON, ?s.body.raw.why);
    }
    format_dump.close(c.d);
}

fun compression(c: *Ctx, z: *Compressed) {
    format_dump.open(c.d, COMPRESSION);
    format_dump.named(c.d, TYPE, z.type::u64, name_in(?tables.ELFCOMPRESS, nil, z.type::u64));
    format_dump.decimal(c.d, RESERVED, z.reserved::u64);
    format_dump.hex(c.d, SIZE, z.length);
    format_dump.decimal(c.d, ADDRALIGN, z.addralign);
    format_dump.close(c.d);
}

# every symbol table, .symtab as Symbols and .dynsym as DynamicSymbols
fun symbols(c: *Ctx) {
    var i: usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val sid: Id[Section] = table.nth[Section](i);
        val s:   *Section    = model.section_at(c.m, sid);
        if (sel s.body.symbols) {
            var key: u32 = SYMBOLS;
            if (s.type == tables.SHT_DYNSYM.value::u32) { key = DYNAMIC_SYMBOLS; }
            symbol_table(c, sid, key, ?s.body.symbols);
        }
        i = i + 1;
    }
}

fun symbol_table(c: *Ctx, sid: Id[Section], key: u32, syms: *Table[Symbol]) {
    val view: res[Symbols, Fail] = model.symbols(c.m, sid, syms);
    if (sel view.err) {
        format_dump.keep(c.d, view.err);
        ret;
    }
    var t: Symbols = view.ok;
    format_dump.open(c.d, key);
    var i: usize = 0;
    for (i < table.count[Symbol](syms)) {
        symbol(c, ?t, table.nth[Symbol](i), table.at[Symbol](syms, table.nth[Symbol](i)));
        i = i + 1;
    }
    format_dump.close(c.d);
}

fun symbol(c: *Ctx, t: *Symbols, at: Id[Symbol], s: *Symbol) {
    format_dump.open(c.d, SYMBOL);
    val sn: res[Bytes, Fail] = symbol_label(c, t, at);
    if (sel sn.err) {
        format_dump.keep(c.d, sn.err);
        ret;
    }
    format_dump.labelled(c.d, NAME, s.name::u64, sn.ok.data, sn.ok.len);
    format_dump.hex(c.d, VALUE, s.value);
    format_dump.decimal(c.d, SIZE, s.bytes);
    format_dump.named(c.d, BINDING, (s.info >> 4)::u64, name_in(?tables.STB, nil, (s.info >> 4)::u64));
    format_dump.named(c.d, TYPE, (s.info & 0xf)::u64, name_in(?tables.STT, nil, (s.info & 0xf)::u64));
    format_dump.decimal(c.d, OTHER, s.other::u64);
    val where: res[SectionRef, Fail] = model.symbol_section(c.m, t, at);
    if (sel where.err) {
        format_dump.keep(c.d, where.err);
        ret;
    }
    val place: SectionRef = where.ok;
    var shn:   u64        = tables.SHN_UNDEF.value;
    if (sel place.section) {
        name_field(c, SECTION, place.section);
        format_dump.close(c.d);
        ret;
    }
    or (sel place.absolute) { shn = tables.SHN_ABS.value; }
    or (sel place.common)   { shn = tables.SHN_COMMON.value; }
    or (sel place.reserved) { shn = place.reserved::u64; }
    format_dump.named(c.d, SECTION, shn, name_in(?tables.SHN, nil, shn));
    format_dump.close(c.d);
}

# the relocations of every relocation section, each section under its index
fun relocations(c: *Ctx) {
    var opened: bool  = false;
    var i:      usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s: *Section = model.section_at(c.m, table.nth[Section](i));
        if (sel s.body.rel || sel s.body.rela || sel s.body.relr) {
            if (!opened) {
                format_dump.open(c.d, RELOCATIONS);
                opened = true;
            }
            reloc_section(c, table.nth[Section](i), s);
        }
        i = i + 1;
    }
    if (opened) { format_dump.close(c.d); }
}

fun reloc_section(c: *Ctx, at: Id[Section], s: *Section) {
    format_dump.open(c.d, SECTION);
    format_dump.decimal(c.d, INDEX, at.index::u64);
    name_field(c, NAME, at);
    var syms: opt[Symbols] = opt[Symbols].none{};
    if (sel s.body.rel) {
        val tab: *Table[Rel] = ?s.body.rel;
        var k:   usize       = 0;
        for (k < table.count[Rel](tab)) {
            val r:   *Rel                       = table.at[Rel](tab, table.nth[Rel](k));
            val sym: res[opt[Id[Symbol]], Fail] = model.rel_symbol(c.m, at, table.nth[Rel](k), r);
            reloc_record(c, at, ?syms, r.offset, r.info, sym, opt[u64].none{});
            k = k + 1;
        }
    }
    if (sel s.body.rela) {
        val tab: *Table[Rela] = ?s.body.rela;
        var k:   usize        = 0;
        for (k < table.count[Rela](tab)) {
            val r:   *Rela                      = table.at[Rela](tab, table.nth[Rela](k));
            val sym: res[opt[Id[Symbol]], Fail] = model.rela_symbol(c.m, at, table.nth[Rela](k), r);
            reloc_record(c, at, ?syms, r.offset, r.info, sym, opt[u64].some{r.addend::u64});
            k = k + 1;
        }
    }
    if (sel s.body.relr) {
        relr_relocs(c, ?s.body.relr);
    }
    format_dump.close(c.d);
}

# one REL or RELA record of section `rels`, its symbol `sym` named from the
# symbol table that section links to, which `syms` holds once it is resolved
fun reloc_record(c: *Ctx, rels: Id[Section], syms: *opt[Symbols], offset: u64, info: u64, sym: res[opt[Id[Symbol]], Fail], addend: opt[u64]) {
    format_dump.open(c.d, RELOCATION);
    format_dump.hex(c.d, OFFSET, offset);
    val code: u64 = model.reloc_type(c.m.shape.class, info);
    format_dump.named(c.d, TYPE, code, reloc_name(c, code));
    symbol_field(c, rels, syms, sym);
    if (sel addend.some) {
        format_dump.hex(c.d, ADDEND, addend.some);
    }
    format_dump.close(c.d);
}

# the RELR words of a section, each decoded to the addresses it relocates: an
# even word is one address and the next word follows it, an odd word is a
# bitmap over the words after the last address, bit k meaning the word k
# words past the one before
fun relr_relocs(c: *Ctx, tab: *Vector[u64]) {
    val width: u64   = c.m.shape.class.addr::u64;
    val bits:  u64   = width * 8 - 1;
    var base:  u64   = 0;
    var k:     usize = 0;
    for (k < vector.length[u64](tab)) {
        val e: u64 = (tab.data[k]);
        if ((e & 1) == 0) {
            relr_reloc(c, e);
            base = e + width;
        }
        or {
            var bitmap: u64 = e >> 1;
            var i:      u64 = 0;
            for (bitmap != 0) {
                if ((bitmap & 1) != 0) {
                    relr_reloc(c, base + i * width);
                }
                bitmap = bitmap >> 1;
                i      = i + 1;
            }
            base = base + bits * width;
        }
        k = k + 1;
    }
}

# one RELR address, a relative relocation with no symbol
fun relr_reloc(c: *Ctx, at: u64) {
    format_dump.open(c.d, RELOCATION);
    format_dump.hex(c.d, OFFSET, at);
    val rel: opt[*Row] = relative(c);
    if (sel rel.some) {
        format_dump.named(c.d, TYPE, rel.some.key::u64, opt[str].some{rel.some.name});
    }
    format_dump.labelled(c.d, SYMBOL, 0, ?DASH[0], 1);
    format_dump.close(c.d);
}

# the symbol field of a relocation of section `rels`: `-` for no symbol, else
# the name of the symbol in the table that section links, resolved into `syms`
# the first time a record names one
fun symbol_field(c: *Ctx, rels: Id[Section], syms: *opt[Symbols], sym: res[opt[Id[Symbol]], Fail]) {
    if (sel sym.err) {
        format_dump.keep(c.d, sym.err);
        ret;
    }
    if (sel sym.ok.none) {
        format_dump.labelled(c.d, SYMBOL, 0, ?DASH[0], 1);
        ret;
    }
    val at: Id[Symbol] = sym.ok.some;
    if (sel syms.some) {
        symbol_text(c, ?syms.some, at);
        ret;
    }
    val view: res[Symbols, Fail] = model.linked_symbols(c.m, rels);
    if (sel view.err) {
        format_dump.keep(c.d, view.err);
        ret;
    }
    var t: Symbols = view.ok;
    @syms = opt[Symbols].some{t};
    symbol_text(c, ?t, at);
}

# the symbol field naming symbol `at` of `t`
fun symbol_text(c: *Ctx, t: *Symbols, at: Id[Symbol]) {
    val name: res[Bytes, Fail] = symbol_label(c, t, at);
    if (sel name.err) {
        format_dump.keep(c.d, name.err);
        ret;
    }
    format_dump.labelled(c.d, SYMBOL, at.index::u64, name.ok.data, name.ok.len);
}

# the name symbol `at` of `t` prints with. a section symbol is named by its
# section, as llvm-readobj names it
fun symbol_label(c: *Ctx, t: *Symbols, at: Id[Symbol]) res[Bytes, Fail] {
    val sym: *Symbol = table.at[Symbol](t.symbols, at);
    if ((sym.info & 0xf)::u64 == tables.STT_SECTION.value) {
        val where: res[SectionRef, Fail] = model.symbol_section(c.m, t, at);
        if (sel where.err) { ret res[Bytes, Fail].err{where.err}; }
        val place: SectionRef = where.ok;
        if (sel place.section) { ret model.section_name(c.m, place.section); }
    }
    ret model.symbol_name(c.m, t, at);
}

# a name field of a section: the name, then its offset
fun name_field(c: *Ctx, key: u32, at: Id[Section]) {
    val n: res[Bytes, Fail] = model.section_name(c.m, at);
    if (sel n.err) {
        format_dump.keep(c.d, n.err);
        ret;
    }
    format_dump.labelled(c.d, key, model.section_at(c.m, at).name::u64, n.ok.data, n.ok.len);
}

# the relocation type `code` in the machine's table, none when there is none
fun reloc_name(c: *Ctx, code: u64) opt[str] {
    if (c.rel == nil) { ret opt[str].none{}; }
    val r: res[*Row, Fail] = row.by_key(c.rel, code::u32);
    if (sel r.ok) { ret opt[str].some{r.ok.name}; }
    ret opt[str].none{};
}

# the machine's relative relocation row, none when the machine has no table
fun relative(c: *Ctx) opt[*Row] {
    if (c.rel == nil) { ret opt[*Row].none{}; }
    val r: res[*Row, Fail] = row.by_kind(c.rel, ?kinds.RELATIVE);
    if (sel r.ok) { ret opt[*Row].some{r.ok}; }
    ret opt[*Row].none{};
}

# the dynamic entries of every SHT_DYNAMIC section, string entries named from
# the string table that section links to
fun dynamics(c: *Ctx) {
    var i: usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s: *Section = model.section_at(c.m, table.nth[Section](i));
        if (sel s.body.dynamic) {
            val tab: *Table[Dyn] = ?s.body.dynamic;
            format_dump.open(c.d, DYNAMIC_SECTION);
            var k: usize = 0;
            for (k < table.count[Dyn](tab)) {
                dyn_entry(c, table.nth[Section](i), table.nth[Dyn](k), table.at[Dyn](tab, table.nth[Dyn](k)));
                k = k + 1;
            }
            format_dump.close(c.d);
        }
        i = i + 1;
    }
}

fun dyn_entry(c: *Ctx, dynamic: Id[Section], at: Id[Dyn], e: *Dyn) {
    val kind: u64 = e.kind::u64;
    format_dump.open(c.d, ENTRY);
    format_dump.hex(c.d, TAG, kind);
    format_dump.named(c.d, TYPE, kind, dyn_name(?tables.DT, c.own.dt, kind));
    format_dump.hex(c.d, VALUE, e.value);
    val nm: res[opt[Bytes], Fail] = model.dynamic_string(c.m, dynamic, at, e);
    if (sel nm.err) {
        format_dump.keep(c.d, nm.err);
        ret;
    }
    if (sel nm.ok.some) {
        format_dump.labelled(c.d, NAME, e.value, nm.ok.some.data, nm.ok.some.len);
    }
    format_dump.close(c.d);
}

# the note entries of every SHT_NOTE section, each section under its index
fun notes(c: *Ctx) {
    var opened: bool  = false;
    var i:      usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s: *Section = model.section_at(c.m, table.nth[Section](i));
        if (sel s.body.notes) {
            val tab: *Vector[Note] = ?s.body.notes;
            if (!opened) {
                format_dump.open(c.d, NOTE_SECTIONS);
                opened = true;
            }
            note_section(c, table.nth[Section](i), s, tab);
        }
        i = i + 1;
    }
    if (opened) { format_dump.close(c.d); }
}

fun note_section(c: *Ctx, at: Id[Section], s: *Section, tab: *Vector[Note]) {
    format_dump.open(c.d, NOTE_SECTION);
    name_field(c, NAME, at);
    format_dump.decimal(c.d, INDEX, at.index::u64);
    format_dump.hex(c.d, OFFSET, s.offset);
    format_dump.hex(c.d, SIZE, s.length);
    var k: usize = 0;
    for (k < vector.length[Note](tab)) {
        note(c, ?tab.data[k]);
        k = k + 1;
    }
    format_dump.close(c.d);
}

fun note(c: *Ctx, n: *Note) {
    val owner: Bytes = model.bytes(c.m, ?n.name);
    var len:   usize = owner.len;
    if (len > 0 && owner.data[len - 1] == 0) { len = len - 1; }
    val gnu: bool = owner_is(owner.data, len, "GNU");
    format_dump.open(c.d, NOTE);
    format_dump.string(c.d, OWNER, owner.data, len);
    format_dump.hex(c.d, DATA_SIZE, n.descsz::u64);
    format_dump.named(c.d, TYPE, n.type::u64, name_in(note_set(owner.data, len, c.own), nil, n.type::u64));
    if (sel n.desc.raw) {
        val desc: Bytes = model.bytes(c.m, ?n.desc.raw.bytes);
        note_desc(c, gnu, n.type::u64, desc);
        format_dump.reason(c.d, REASON, ?n.desc.raw.why);
    }
    if (sel n.desc.properties) {
        properties(c, ?n.desc.properties);
    }
    format_dump.close(c.d);
}

# a GNU note's descriptor decoded, its build ID as hex digits and its ABI tag
# as the operating system and version, and any other descriptor as bytes
fun note_desc(c: *Ctx, gnu: bool, ntype: u64, desc: Bytes) {
    if (gnu && ntype == tables.NT_GNU_ABI_TAG.value::u64) {
        abi_tag(c, desc);
        ret;
    }
    if (gnu && ntype == tables.NT_GNU_BUILD_ID.value::u64) {
        format_dump.digits(c.d, BUILD_ID, desc.data, desc.len);
        ret;
    }
    format_dump.bytes(c.d, DESCRIPTION, desc.data, desc.len);
}

# the four words of an ABI tag in the file's byte order: the operating system,
# then the major, minor and subminor version of the kernel
fun abi_tag(c: *Ctx, desc: Bytes) {
    if (desc.len < 16) {
        format_dump.keep(c.d, fail.in_record(fail.malformed("the ABI tag is shorter than its four words"), "note"));
        ret;
    }
    val order: Order = c.m.shape.order;
    val os:    u64   = slot.field(desc.data, Slot{offset: 0, width: 4}, order);
    val major: u64   = slot.field(desc.data, Slot{offset: 4, width: 4}, order);
    val minor: u64   = slot.field(desc.data, Slot{offset: 8, width: 4}, order);
    val sub:   u64   = slot.field(desc.data, Slot{offset: 12, width: 4}, order);
    format_dump.named(c.d, OS, os, name_in(?abi.OS, nil, os));
    format_dump.field(c.d, ABI);
    format_dump.decimal_value(c.d, major);
    format_dump.text(c.d, ".");
    format_dump.decimal_value(c.d, minor);
    format_dump.text(c.d, ".");
    format_dump.decimal_value(c.d, sub);
    format_dump.text(c.d, "\n");
}

fun note_set(owner: *u8, len: usize, own: Own) *Set {
    if (owner_is(owner, len, "GNU"))  { ret ?tables.NT_GNU; }
    if (owner_is(owner, len, "CORE")) { ret ?tables.NT_CORE; }
    ret own.nt;
}

fun owner_is(p: *u8, n: usize, want: str) bool {
    if (n != str_len(want)) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (p[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun properties(c: *Ctx, tab: *Vector[Property]) {
    format_dump.open(c.d, PROPERTIES);
    var k: usize = 0;
    for (k < vector.length[Property](tab)) {
        val p:    *Property = ?tab.data[k];
        val data: Bytes     = model.bytes(c.m, ?p.data);
        format_dump.open(c.d, PROPERTY);
        format_dump.named(c.d, TYPE, p.type::u64, name_in(?tables.GNU_PROPERTY, c.own.gnu, p.type::u64));
        format_dump.hex(c.d, DATA_SIZE, p.datasz::u64);
        format_dump.bytes(c.d, VALUE, data.data, data.len);
        format_dump.close(c.d);
        k = k + 1;
    }
    format_dump.close(c.d);
}

# the version sections: symbol versions, definitions and requirements, each
# name read through the string table or symbol table its section links
fun versions(c: *Ctx) {
    var names: Vector[Version] = vector.init[Version](c.m.a);
    version_sections(c, ?names);
    format_dump.keep_outcome(c.d, vectors.release[Version](?names));
}

fun version_sections(c: *Ctx, names: *Vector[Version]) {
    version_names(c, names);
    var i: usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val at: Id[Section] = table.nth[Section](i);
        val s:  *Section    = model.section_at(c.m, at);
        if (sel s.body.versym) {
            versym(c, names, at, ?s.body.versym);
        }
        if (sel s.body.verdef) {
            verdefs(c, at, ?s.body.verdef);
        }
        if (sel s.body.verneed) {
            verneeds(c, at, ?s.body.verneed);
        }
        i = i + 1;
    }
}

# a requirement entry that names a version index
rec NeedAt {
    section: Id[Section];
    at:      Id[Need];
    entry:   *Vernaux;
}

# a definition that names a version index, and how many names follow it
rec DefAt {
    section: Id[Section];
    tab:     *Table[Definition];
    at:      Id[Definition];
    names:   usize;
}

# what names a version index: nothing, the first requirement entry with that
# index, or else the first definition with it
tag Version: u8 {
    none;
    needed:  NeedAt;
    defined: DefAt;
}

# the record naming each version index a symbol version entry can hold, by
# index, from every requirement and definition section in section order
fun version_names(c: *Ctx, names: *Vector[Version]) {
    var i: usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val at: Id[Section] = table.nth[Section](i);
        val s:  *Section    = model.section_at(c.m, at);
        if (sel s.body.verneed) {
            need_names(c.d, names, at, ?s.body.verneed);
        }
        if (sel s.body.verdef) {
            def_names(c.d, names, at, ?s.body.verdef);
        }
        i = i + 1;
    }
}

# a requirement entry names its index unless an earlier one does
fun need_names(d: *Dumper, names: *Vector[Version], at: Id[Section], tab: *Table[Need]) {
    var k: usize = 0;
    for (k < table.count[Need](tab)) {
        val x: *Need = table.at[Need](tab, table.nth[Need](k));
        if (sel x.vernaux) {
            val slot: res[*Version, Fail] = version_slot(names, x.vernaux.other::u64);
            if (sel slot.err) {
                format_dump.keep(d, slot.err);
                ret;
            }
            if (slot.ok != nil && !sel slot.ok.needed) {
                @slot.ok = Version.needed{NeedAt{section: at, at: table.nth[Need](k), entry: ?x.vernaux}};
            }
        }
        k = k + 1;
    }
}

# a definition names its index unless a requirement entry or an earlier
# definition does
fun def_names(d: *Dumper, names: *Vector[Version], at: Id[Section], tab: *Table[Definition]) {
    var k: usize = 0;
    for (k < table.count[Definition](tab)) {
        val x: *Definition = table.at[Definition](tab, table.nth[Definition](k));
        if (sel x.verdef) {
            val slot: res[*Version, Fail] = version_slot(names, x.verdef.ndx::u64);
            if (sel slot.err) {
                format_dump.keep(d, slot.err);
                ret;
            }
            if (slot.ok != nil && sel slot.ok.none) {
                @slot.ok = Version.defined{DefAt{section: at, tab: tab, at: table.nth[Definition](k), names: x.verdef.cnt::usize}};
            }
        }
        k = k + 1;
    }
}

# the entry for version index `n`, the table grown to hold it, nil for an
# index past what a symbol version entry can hold
fun version_slot(names: *Vector[Version], n: u64) res[*Version, Fail] {
    if (n > tables.VERSYM_VERSION.value) { ret res[*Version, Fail].ok{nil}; }
    val held: usize = vector.length[Version](names);
    if (n::usize >= held) {
        val res_grown: err[Fail] = vectors.grow[Version](names, n::usize + 1 - held);
        if (sel res_grown.err) { ret res[*Version, Fail].err{res_grown.err}; }
    }
    ret res[*Version, Fail].ok{?names.data[n::usize]};
}

# the version of each symbol of the symbol table section `at` links, one entry
# per symbol
fun versym(c: *Ctx, names: *Vector[Version], at: Id[Section], tab: *Vector[u16]) {
    val view: res[Symbols, Fail] = model.linked_symbols(c.m, at);
    if (sel view.err) {
        format_dump.keep(c.d, view.err);
        ret;
    }
    var t: Symbols = view.ok;
    if (vector.length[u16](tab) > table.count[Symbol](t.symbols)) {
        format_dump.keep(c.d, fail.malformed_at("symbol versions outnumber the symbols they version", "section header", at.index::u64, vector.length[u16](tab)::i128));
        ret;
    }
    format_dump.open(c.d, VERSION_SYMBOLS);
    var k: usize = 0;
    for (k < vector.length[u16](tab)) {
        val raw: u64 = (tab.data[k])::u64;
        versym_entry(c, names, ?t, k, raw);
        k = k + 1;
    }
    format_dump.close(c.d);
}

# one symbol's version: its index with the hidden bit apart, and its name with
# the version suffix llvm-readobj gives it
fun versym_entry(c: *Ctx, names: *Vector[Version], t: *Symbols, k: usize, raw: u64) {
    val hidden:  bool             = (raw & tables.VERSYM_HIDDEN.value) != 0;
    val version: u64              = raw & tables.VERSYM_VERSION.value;
    val name:    res[Bytes, Fail] = symbol_label(c, t, table.nth[Symbol](k));
    if (sel name.err) {
        format_dump.keep(c.d, name.err);
        ret;
    }
    val sfx: res[opt[Suffix], Fail] = suffix(c, names, version, hidden);
    if (sel sfx.err) {
        format_dump.keep(c.d, sfx.err);
        ret;
    }
    format_dump.open(c.d, SYMBOL);
    format_dump.decimal(c.d, VERSION, version);
    format_dump.decimal(c.d, HIDDEN, hidden::u64);
    format_dump.field(c.d, NAME);
    format_dump.raw(c.d, name.ok.data, name.ok.len);
    if (sel sfx.ok.some) {
        format_dump.text(c.d, sfx.ok.some.sep);
        format_dump.raw(c.d, sfx.ok.some.name.data, sfx.ok.some.name.len);
    }
    format_dump.text(c.d, "\n");
    format_dump.close(c.d);
}

# the separator and the version name a symbol's version index adds to its name:
# `@` and a needed version's name, or `@@` and a defined version's name when the
# version is not hidden, or `@` when it is. the local and global indexes add nothing
rec Suffix {
    sep:  str;
    name: Bytes;
}

fun suffix(c: *Ctx, names: *Vector[Version], version: u64, hidden: bool) res[opt[Suffix], Fail] {
    if (version <= tables.VER_NDX_GLOBAL.value::u64) { ret res[opt[Suffix], Fail].ok{opt[Suffix].none{}}; }
    if (version >= vector.length[Version](names)::u64) {
        ret res[opt[Suffix], Fail].err{fail.in_record(fail.malformed("a symbol's version index names no version"), "version symbols")};
    }
    val v: *Version = ?names.data[version::usize];
    if (sel v.needed) {
        val need: res[Bytes, Fail] = need_name(c, v.needed);
        if (sel need.err) { ret res[opt[Suffix], Fail].err{need.err}; }
        ret res[opt[Suffix], Fail].ok{opt[Suffix].some{Suffix{sep: "@", name: need.ok}}};
    }
    if (sel v.defined) {
        val def: res[Bytes, Fail] = def_name(c, v.defined);
        if (sel def.err) { ret res[opt[Suffix], Fail].err{def.err}; }
        var sep: str = "@@";
        if (hidden) { sep = "@"; }
        ret res[opt[Suffix], Fail].ok{opt[Suffix].some{Suffix{sep: sep, name: def.ok}}};
    }
    ret res[opt[Suffix], Fail].err{fail.in_record(fail.malformed("a symbol's version index names no version"), "version symbols")};
}

# the name of the needed version requirement entry `n` holds
fun need_name(c: *Ctx, n: NeedAt) res[Bytes, Fail] {
    ret model.requirement_name(c.m, n.section, n.at, n.entry);
}

# the name of the defined version definition `n` holds, its first name
fun def_name(c: *Ctx, n: DefAt) res[Bytes, Fail] {
    val tab: *Table[Definition] = n.tab;
    val k:   usize              = n.at.index::usize;
    if (n.names == 0 || k + 1 >= table.count[Definition](tab)) {
        ret res[Bytes, Fail].err{fail.in_record(fail.malformed("a version definition has no name"), "version definitions")};
    }
    val y: *Definition = table.at[Definition](tab, table.nth[Definition](k + 1));
    if (!sel y.verdaux) {
        ret res[Bytes, Fail].err{fail.in_record(fail.malformed("a version definition's name is not an auxiliary entry"), "version definitions")};
    }
    ret model.definition_name(c.m, n.section, table.nth[Definition](k + 1), ?y.verdaux);
}

# each definition, its first name and the names of the versions it follows,
# which are the auxiliary entries after it in the section
fun verdefs(c: *Ctx, at: Id[Section], tab: *Table[Definition]) {
    format_dump.open(c.d, VERSION_DEFINITIONS);
    var k: usize = 0;
    for (k < table.count[Definition](tab)) {
        val x: *Definition = table.at[Definition](tab, table.nth[Definition](k));
        if (!sel x.verdef) {
            format_dump.keep(c.d, fail.in_record(fail.malformed("a version definition's name comes before its definition"), "version definitions"));
            ret;
        }
        val d: *Verdef = ?x.verdef;
        format_dump.open(c.d, DEFINITION);
        format_dump.decimal(c.d, VERSION, d.version::u64);
        flags(c.d, FLAGS, d.flags::u64, ?tables.VER_FLG, nil);
        format_dump.decimal(c.d, INDEX, d.ndx::u64);
        format_dump.decimal(c.d, HASH, d.hash::u64);
        verdef_names(c, at, tab, k, d.cnt::usize);
        format_dump.close(c.d);
        k = k + 1 + d.cnt::usize;
    }
    format_dump.close(c.d);
}

# the `cnt` names after definition `k`: the first as the definition's name, the
# rest as its predecessors
fun verdef_names(c: *Ctx, at: Id[Section], tab: *Table[Definition], k: usize, cnt: usize) {
    var a: usize = 0;
    for (a < cnt) {
        if (k + 1 + a >= table.count[Definition](tab)) {
            format_dump.keep(c.d, fail.in_record(fail.malformed("a version definition has fewer names than it counts"), "version definitions"));
            ret;
        }
        val y: *Definition = table.at[Definition](tab, table.nth[Definition](k + 1 + a));
        if (!sel y.verdaux) {
            format_dump.keep(c.d, fail.in_record(fail.malformed("a version definition's names are not its auxiliary entries"), "version definitions"));
            ret;
        }
        val nm: res[Bytes, Fail] = model.definition_name(c.m, at, table.nth[Definition](k + 1 + a), ?y.verdaux);
        if (sel nm.err) {
            format_dump.keep(c.d, nm.err);
            ret;
        }
        if (a == 0) {
            format_dump.string(c.d, NAME, nm.ok.data, nm.ok.len);
        }
        or {
            format_dump.string(c.d, PREDECESSOR, nm.ok.data, nm.ok.len);
        }
        a = a + 1;
    }
}

# each requirement: its file name, then its entries
fun verneeds(c: *Ctx, at: Id[Section], tab: *Table[Need]) {
    format_dump.open(c.d, VERSION_REQUIREMENTS);
    var k: usize = 0;
    for (k < table.count[Need](tab)) {
        val x: *Need = table.at[Need](tab, table.nth[Need](k));
        if (!sel x.verneed) {
            format_dump.keep(c.d, fail.in_record(fail.malformed("a version requirement's entry comes before its dependency"), "version requirements"));
            ret;
        }
        val v: *Verneed = ?x.verneed;
        format_dump.open(c.d, DEPENDENCY);
        format_dump.decimal(c.d, VERSION, v.version::u64);
        format_dump.decimal(c.d, COUNT, v.cnt::u64);
        val fname: res[Bytes, Fail] = model.requirement_file(c.m, at, table.nth[Need](k), v);
        if (sel fname.err) {
            format_dump.keep(c.d, fname.err);
            ret;
        }
        format_dump.string(c.d, FILE, fname.ok.data, fname.ok.len);
        verneed_entries(c, at, tab, k, v.cnt::usize);
        format_dump.close(c.d);
        k = k + 1 + v.cnt::usize;
    }
    format_dump.close(c.d);
}

# the `cnt` entries after requirement `k`, nested under it
fun verneed_entries(c: *Ctx, at: Id[Section], tab: *Table[Need], k: usize, cnt: usize) {
    format_dump.open(c.d, ENTRIES);
    var a: usize = 0;
    for (a < cnt) {
        if (k + 1 + a >= table.count[Need](tab)) {
            format_dump.keep(c.d, fail.in_record(fail.malformed("a version requirement has fewer entries than it counts"), "version requirements"));
            ret;
        }
        val y: *Need = table.at[Need](tab, table.nth[Need](k + 1 + a));
        if (!sel y.vernaux) {
            format_dump.keep(c.d, fail.in_record(fail.malformed("a version requirement's entries are not auxiliary entries"), "version requirements"));
            ret;
        }
        val va: *Vernaux         = ?y.vernaux;
        val nm: res[Bytes, Fail] = model.requirement_name(c.m, at, table.nth[Need](k + 1 + a), va);
        if (sel nm.err) {
            format_dump.keep(c.d, nm.err);
            ret;
        }
        format_dump.open(c.d, ENTRY);
        format_dump.decimal(c.d, HASH, va.hash::u64);
        flags(c.d, FLAGS, va.flags::u64, ?tables.VER_FLG, nil);
        format_dump.decimal(c.d, INDEX, va.other::u64);
        format_dump.string(c.d, NAME, nm.ok.data, nm.ok.len);
        format_dump.close(c.d);
        a = a + 1;
    }
    format_dump.close(c.d);
}

# the SHT_GROUP sections: each with its name, its link and info, its flags, the
# signature symbol and the sections it holds
fun groups(c: *Ctx) {
    var opened: bool  = false;
    var i:      usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s: *Section = model.section_at(c.m, table.nth[Section](i));
        if (sel s.body.group) {
            val g: *Group = ?s.body.group;
            if (!opened) {
                format_dump.open(c.d, GROUPS);
                opened = true;
            }
            group(c, table.nth[Section](i), g);
        }
        i = i + 1;
    }
    if (opened) { format_dump.close(c.d); }
}

fun group(c: *Ctx, at: Id[Section], g: *Group) {
    val s: *Section = model.section_at(c.m, at);
    format_dump.open(c.d, GROUP);
    name_field(c, NAME, at);
    format_dump.decimal(c.d, INDEX, at.index::u64);
    format_dump.decimal(c.d, LINK, s.link::u64);
    format_dump.decimal(c.d, INFO, s.info::u64);
    format_dump.named(c.d, TYPE, g.flags::u64, name_in(?tables.GRP, nil, g.flags::u64));
    val view: res[Symbols, Fail] = model.linked_symbols(c.m, at);
    if (sel view.err) {
        format_dump.keep(c.d, view.err);
        ret;
    }
    var t:     Symbols               = view.ok;
    val owner: res[Id[Symbol], Fail] = model.info_symbol(c.m, ?t, at);
    if (sel owner.err) {
        format_dump.keep(c.d, owner.err);
        ret;
    }
    val sig: res[Bytes, Fail] = symbol_label(c, ?t, owner.ok);
    if (sel sig.err) {
        format_dump.keep(c.d, sig.err);
        ret;
    }
    format_dump.string(c.d, SIGNATURE, sig.ok.data, sig.ok.len);
    format_dump.open(c.d, MEMBERS);
    var k: usize = 0;
    for (k < vector.length[u32](?g.members)) {
        val mi: res[Id[Section], Fail] = model.group_member(c.m, k, g.members.data[k]);
        if (sel mi.err) {
            format_dump.keep(c.d, mi.err);
            ret;
        }
        format_dump.open(c.d, MEMBER);
        name_field(c, NAME, mi.ok);
        format_dump.close(c.d);
        k = k + 1;
    }
    format_dump.close(c.d);
    format_dump.close(c.d);
}

# the hash tables, each as the counts of its tables
fun hashes(c: *Ctx) {
    var i: usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s: *Section = model.section_at(c.m, table.nth[Section](i));
        if (sel s.body.hash) {
            val h: *Hash = ?s.body.hash;
            format_dump.open(c.d, HASH_TABLE);
            format_dump.decimal(c.d, BUCKETS, vector.length[u32](?h.buckets)::u64);
            format_dump.decimal(c.d, CHAINS, vector.length[u32](?h.chains)::u64);
            format_dump.close(c.d);
        }
        if (sel s.body.gnu_hash) {
            val g: *GnuHash = ?s.body.gnu_hash;
            format_dump.open(c.d, GNU_HASH_TABLE);
            format_dump.decimal(c.d, SYMBOL_OFFSET, g.symoffset::u64);
            format_dump.decimal(c.d, BLOOM_SHIFT, g.shift::u64);
            format_dump.decimal(c.d, BLOOM_FILTERS, vector.length[u64](?g.bloom)::u64);
            format_dump.decimal(c.d, BUCKETS, vector.length[u32](?g.buckets)::u64);
            format_dump.decimal(c.d, CHAINS, vector.length[u32](?g.chain)::u64);
            format_dump.close(c.d);
        }
        i = i + 1;
    }
}

# the name of `v` in the generic table or else in the machine's own, none when
# neither has it. a nil table has no names
fun name_in(generic: *Set, own: *Set, v: u64) opt[str] {
    val g: opt[str] = constant(generic, v);
    if (sel g.some) { ret g; }
    ret constant(own, v);
}

fun constant(s: *Set, v: u64) opt[str] {
    if (s == nil) { ret opt[str].none{}; }
    val c: opt[*Constant] = tables.name_of(s, v);
    if (sel c.some) { ret opt[str].some{c.some.name}; }
    ret opt[str].none{};
}

fun dyn_name(generic: *DynSet, own: *DynSet, v: u64) opt[str] {
    val g: opt[str] = dyn_constant(generic, v);
    if (sel g.some) { ret g; }
    ret dyn_constant(own, v);
}

fun dyn_constant(s: *DynSet, v: u64) opt[str] {
    if (s == nil) { ret opt[str].none{}; }
    val c: opt[*DynTag] = tables.dyn_name_of(s, v);
    if (sel c.some) { ret opt[str].some{c.some.name}; }
    ret opt[str].none{};
}

# a flags field: the names of the single-bit constants set in `v`, then what
# no name covers, then the value
fun flags(d: *Dumper, key: u32, v: u64, generic: *Set, own: *Set) {
    format_dump.field(d, key);
    var rest: u64 = v;
    named_bits(d, generic, ?rest);
    named_bits(d, own, ?rest);
    format_dump.flags_rest(d, rest, v);
}

# e_flags, each value an e_flags trait row of the architecture encodes named
# by its constant and the bits no row maps printed raw
fun e_flags(c: *Ctx) {
    format_dump.field(c.d, FLAGS);
    val v:    u64 = c.m.header.flags::u64;
    var rest: u64 = v;
    if (sel c.arch.some) {
        val a: *Arch = c.arch.some;
        var i: usize = 0;
        for (i < a.axis_count) {
            val rows: traits.Rows = traits.encodings_of(a.axes[i]);
            var j:    usize       = 0;
            i = i + 1;
            for (j < rows.count) {
                val e: *traits.Row = rows.at[j];
                j = j + 1;
                if (!sel e.field.flags) { cnt; }
                var k: usize = 0;
                for (k < e.count) {
                    val code: *Constant = e.codes[k].value;
                    format_dump.masked(c.d, ?rest, e.field.flags, code.value, code.name);
                    k = k + 1;
                }
            }
        }
    }
    format_dump.flags_rest(c.d, rest, v);
}

# print the name of each single-bit constant of `s` set in `rest`, clearing its bit
fun named_bits(d: *Dumper, s: *Set, rest: *u64) {
    if (s == nil) { ret; }
    var i: usize = 0;
    for (i < s.count) {
        format_dump.flag(d, rest, s.rows[i].value, s.rows[i].name);
        i = i + 1;
    }
}
