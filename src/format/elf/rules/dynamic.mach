# the measures of the dynamic tables
pub val INTERP:     Measure = Measure{name: "program loader path"};
pub val SYMBOLS:    Measure = Measure{name: "dynamic symbols"};
pub val STRINGS:    Measure = Measure{name: "dynamic strings"};
pub val HASH:       Measure = Measure{name: "SysV hash table"};
pub val GNU_HASH:   Measure = Measure{name: "GNU hash table"};
pub val RELOCS:     Measure = Measure{name: "loader relocations"};
pub val DYNAMIC:    Measure = Measure{name: "dynamic section"};
pub val VERSYM:     Measure = Measure{name: "symbol versions"};
pub val VERDEF:     Measure = Measure{name: "version definitions"};
pub val VERNEED:    Measure = Measure{name: "version needs"};
pub val PLT_RELOCS: Measure = Measure{name: "lazily bound relocations"};

# the size of one entry of a table
# ---
# none:   it has no entries of one size
# half:   a 16-bit half word
# word:   a 32-bit word
# symbol: a symbol of the class
# rel:    a REL record of the class
# rela:   a RELA record of the class
# entry:  a dynamic entry of the class
pub tag Width: u8 {
    none;
    half;
    word;
    symbol;
    rel;
    rela;
    entry;
}

# what an image holds a dynamic table for
# ---
# always:  every image whose kind imports
# entered: an image the loader starts, whose program loader is named
# version: an image that writes symbol versions
# defines: an image that defines versions, as a shared library defines its
#          base version
# needs:   an image that needs versions of the libraries it loads
# lazy:    an image whose calls go through PLT entries the loader binds
#          lazily
pub tag When: u8 {
    always;
    entered;
    version;
    defines;
    needs;
    lazy;
}

# a dynamic table
# ---
# name:    its section's name
# kind:    the role its section plays
# flags:   its flags
# region:  the region whose end layout puts it at
# type:    its sh_type
# measure: what sizes it
# align:   its alignment, zero for the width of the class's addresses
# width:   the size of one of its entries
# link:    the table its sh_link names, nil for none
# locals:  its sh_info counts its local symbols, the null symbol alone
# counted: its sh_info counts the definitions or needs it holds
# when:    what the image holds it for
# reason:  why one past the limit is refused
# anchor:  the key a template or a bound symbol finds it by, none for none
# applies: the slot role of the table its relocations apply to alone, whose
#          section its sh_info names under SHF_INFO_LINK as the gABI states
#          for a relocation section, none for relocations of many sections
pub rec Part {
    name:    str;
    kind:    *section.Kind;
    flags:   section.Flags;
    region:  *reserve.Region;
    type:    *Constant;
    measure: *Measure;
    align:   u64;
    width:   Width;
    link:    *Part;
    locals:  bool;
    counted: bool;
    when:    When;
    reason:  str;
    anchor:  opt[*Anchor];
    applies: opt[*SlotRole];
}

val INTERP_PART:   Part = Part{name: ".interp", kind: ?section.RODATA, flags: section.ALLOC, region: ?reserve.CONST_END, type: ?tables.SHT_PROGBITS, measure: ?INTERP, align: 1, width: Width.none{}, link: nil, when: When.entered{}, reason: "the program loader's path passes 4 GiB"};
val DYNSTR_PART:   Part = Part{name: ".dynstr", kind: ?section.RODATA, flags: section.ALLOC, region: ?reserve.CONST_END, type: ?tables.SHT_STRTAB, measure: ?STRINGS, align: 1, width: Width.none{}, link: nil, reason: "the dynamic strings pass 4 GiB"};
val DYNSYM_PART:   Part = Part{name: ".dynsym", kind: ?section.RODATA, flags: section.ALLOC, region: ?reserve.CONST_END, type: ?tables.SHT_DYNSYM, measure: ?SYMBOLS, align: 0, width: Width.symbol{}, link: ?DYNSTR_PART, locals: true, reason: "the dynamic symbols pass 4 GiB"};
val HASH_PART:     Part = Part{name: ".hash", kind: ?section.RODATA, flags: section.ALLOC, region: ?reserve.CONST_END, type: ?tables.SHT_HASH, measure: ?HASH, align: 4, width: Width.word{}, link: ?DYNSYM_PART, reason: "the SysV hash table passes 4 GiB"};
val GNU_HASH_PART: Part = Part{name: ".gnu.hash", kind: ?section.RODATA, flags: section.ALLOC, region: ?reserve.CONST_END, type: ?tables.SHT_GNU_HASH, measure: ?GNU_HASH, align: 0, width: Width.none{}, link: ?DYNSYM_PART, reason: "the GNU hash table passes 4 GiB"};
val VERSYM_PART:   Part = Part{name: ".gnu.version", kind: ?section.RODATA, flags: section.ALLOC, region: ?reserve.CONST_END, type: ?tables.SHT_GNU_versym, measure: ?VERSYM, align: 2, width: Width.half{}, link: ?DYNSYM_PART, when: When.version{}, reason: "the symbol versions pass 4 GiB"};
val VERDEF_PART:   Part = Part{name: ".gnu.version_d", kind: ?section.RODATA, flags: section.ALLOC, region: ?reserve.CONST_END, type: ?tables.SHT_GNU_verdef, measure: ?VERDEF, align: 4, width: Width.none{}, link: ?DYNSTR_PART, counted: true, when: When.defines{}, reason: "the version definitions pass 4 GiB"};
val VERNEED_PART:  Part = Part{name: ".gnu.version_r", kind: ?section.RODATA, flags: section.ALLOC, region: ?reserve.CONST_END, type: ?tables.SHT_GNU_verneed, measure: ?VERNEED, align: 4, width: Width.none{}, link: ?DYNSTR_PART, counted: true, when: When.needs{}, reason: "the version needs pass 4 GiB"};
val RELA_PART:     Part = Part{name: ".rela.dyn", kind: ?section.RODATA, flags: section.ALLOC, region: ?reserve.CONST_END, type: ?tables.SHT_RELA, measure: ?RELOCS, align: 0, width: Width.rela{}, link: ?DYNSYM_PART, reason: "the loader relocations pass 4 GiB"};
val REL_PART:      Part = Part{name: ".rel.dyn", kind: ?section.RODATA, flags: section.ALLOC, region: ?reserve.CONST_END, type: ?tables.SHT_REL, measure: ?RELOCS, align: 0, width: Width.rel{}, link: ?DYNSYM_PART, reason: "the loader relocations pass 4 GiB"};
val DYNAMIC_PART:  Part = Part{name: ".dynamic", kind: ?section.RELRO_DATA, flags: section.ALLOC | section.WRITE, region: ?reserve.RELRO_END, type: ?tables.SHT_DYNAMIC, measure: ?DYNAMIC, align: 0, width: Width.entry{}, link: ?DYNSTR_PART, reason: "the dynamic section passes 4 GiB", anchor: opt[*Anchor].some{?template.DYNAMIC_SECTION}};
val RELA_PLT_PART: Part = Part{name: ".rela.plt", kind: ?section.RODATA, flags: section.ALLOC, region: ?reserve.CONST_END, type: ?tables.SHT_RELA, measure: ?PLT_RELOCS, align: 0, width: Width.rela{}, link: ?DYNSYM_PART, when: When.lazy{}, reason: "the lazily bound relocations pass 4 GiB", anchor: opt[*Anchor].some{?template.LAZY_RELOCATIONS}, applies: opt[*SlotRole].some{?slot.GOT_PLT}};
val REL_PLT_PART:  Part = Part{name: ".rel.plt", kind: ?section.RODATA, flags: section.ALLOC, region: ?reserve.CONST_END, type: ?tables.SHT_REL, measure: ?PLT_RELOCS, align: 0, width: Width.rel{}, link: ?DYNSYM_PART, when: When.lazy{}, reason: "the lazily bound relocations pass 4 GiB", anchor: opt[*Anchor].some{?template.LAZY_RELOCATIONS}, applies: opt[*SlotRole].some{?slot.GOT_PLT}};

# where the loader's relocations keep their addends, which the pair's
# RELATIVE row states
# ---
# part:   the relocation table
# lazy:   the table of the relocations the loader binds lazily
# record: each record holds its addend, as RELA records do
# table, size, entry:
#           the dynamic tags of the table's address, its size and the size
#           of one record, the table's tag also naming the form in DT_PLTREL
pub rec Form {
    part:   *Part;
    lazy:   *Part;
    record: bool;
    table:  *DynTag;
    size:   *DynTag;
    entry:  *DynTag;
}

val RELA_FORM: Form = Form{part: ?RELA_PART, lazy: ?RELA_PLT_PART, record: true, table: ?tables.DT_RELA, size: ?tables.DT_RELASZ, entry: ?tables.DT_RELAENT};
val REL_FORM:  Form = Form{part: ?REL_PART, lazy: ?REL_PLT_PART, record: false, table: ?tables.DT_REL, size: ?tables.DT_RELSZ, entry: ?tables.DT_RELENT};

# which of the tables an image holds only for some images it holds
# ---
# imports: its kind imports
# entered: the loader starts it
# defines: it defines symbol versions
# needs:   it needs versions of the libraries it loads
# lazy:    it imports and a call goes through a PLT entry the loader binds
#          lazily
pub rec Present {
    imports: bool;
    entered: bool;
    defines: bool;
    needs:   bool;
    lazy:    bool;
}

# whether an image of `p` holds a table held for `w`
fun holds(p: Present, w: When) bool {
    if (!p.imports)    { ret false; }
    if (sel w.entered) { ret p.entered; }
    if (sel w.version) { ret p.defines || p.needs; }
    if (sel w.defines) { ret p.defines; }
    if (sel w.needs)   { ret p.needs; }
    if (sel w.lazy)    { ret p.lazy; }
    ret true;
}

# which tables an image of kind `k` with the dynamic record `d` holds: the
# program loader's path when the loader starts it, version definitions for a
# library the loader maps, which defines its base version, or for an image
# exporting a versioned symbol, version needs for an import of a version, and
# the lazily bound relocations where a call goes through a PLT entry
pub fun present(k: *output.Kind, d: *dynamic.Dynamic) Present {
    var p: Present = Present{imports: output.has(k, output.IMPORTS), entered: output.has(k, output.ENTERED), defines: output.has(k, output.LOADED)};
    p.lazy = p.imports && table.count[dynamic.Entry](dynamic.entries_of(d, ?slot.GOT_PLT)) != 0;
    var i: usize = 0;
    for (i < table.count[Export](?d.exports) && !p.defines) {
        val v: opt[Id[Name]] = table.at[Export](?d.exports, table.nth[Export](i)).version;
        p.defines = sel v.some;
        i         = i + 1;
    }
    i = 0;
    for (i < table.count[Import](?d.imports) && !p.needs) {
        val im: *Import       = table.at[Import](?d.imports, table.nth[Import](i));
        val v:  opt[Id[Name]] = table.at[Offer](?d.offers, im.offer).version;
        p.needs = sel v.some;
        i       = i + 1;
    }
    ret p;
}

# the dynamic tables an image of `form` holding those of `p` holds, in the
# order they are declared, how many
val PART_COUNT: usize = 11;

fun parts(form: *Form, p: Present, out: *[PART_COUNT]*Part) usize {
    val all: [PART_COUNT]*Part = [PART_COUNT]*Part{?INTERP_PART, ?DYNSYM_PART, ?DYNSTR_PART, ?HASH_PART, ?GNU_HASH_PART, ?VERSYM_PART, ?VERDEF_PART, ?VERNEED_PART, form.part, form.lazy, ?DYNAMIC_PART};
    var n:   usize             = 0;
    var i:   usize             = 0;
    for (i < PART_COUNT) {
        if (holds(p, all[i].when)) {
            out[0][n] = all[i];
            n         = n + 1;
        }
        i = i + 1;
    }
    ret n;
}

# a relocation kind by the address width of the image's class
# ---
# word32: the kind of an image of four byte addresses
# word64: the kind of an image of eight byte addresses
pub rec Words {
    word32: *Kind;
    word64: *Kind;
}

# the relocation kind the loader applies at a site
# ---
# kind:  this kind
# words: the kind of the image's address width
# own:   the kind of the relocation whose field the site is
pub tag Applied: u8 {
    kind:  *Kind;
    words: Words;
    own;
}

# the table a loader relocation is written to
# ---
# loader: the loader's relocation table
# lazy:   the table of the relocations the loader binds lazily
pub tag Run: u8 {
    loader;
    lazy;
}

# what the loader does at a site, the way a row states it
# ---
# rebase: it moves the address the site holds
# bind:   it binds the site to its name
pub tag Act: u8 {
    rebase;
    bind;
}

# the ELF dynamic rows: the relocation a site takes and the table it goes to,
# by its place and what the loader does there, one row per pair of the two,
# every pair
# ---
# role:    the slot role of the table the site is a slot of, none for a
#          relocation's field
# act:     what the loader does there
# word:    the word of its slot the site is, from zero
# applied: the relocation it takes
# run:     the table it is written to
# held:    how many words past the site the word lies that holds the addend
#          of a rebase, which the link wrote there, as a thread-local
#          descriptor's argument holds the offset its resolver reads
pub rec Loader {
    role:    opt[*SlotRole];
    act:     Act;
    word:    u8;
    applied: Applied;
    run:     Run;
    held:    u8;
}

val TPOFF:  Words = Words{word32: ?kinds.TPOFF32_DYN, word64: ?kinds.TPOFF64};
val DTPMOD: Words = Words{word32: ?kinds.DTPMOD32, word64: ?kinds.DTPMOD64};
val DTPOFF: Words = Words{word32: ?kinds.DTPOFF32_DYN, word64: ?kinds.DTPOFF64};

# a general dynamic pair the loader binds takes its module index and its
# offset, one for the image's own block its module index, the local dynamic
# module slot the image's module index, and a descriptor one TLSDESC whose
# addend for the image's own block is the offset its argument holds
val LOADER_COUNT: usize                = 14;
val LOADERS:      [LOADER_COUNT]Loader = [LOADER_COUNT]Loader{
    Loader{role: opt[*SlotRole].none{}, act: Act.rebase{}, applied: Applied.kind{?kinds.RELATIVE}, run: Run.loader{}},
    Loader{role: opt[*SlotRole].none{}, act: Act.bind{}, applied: Applied.own{}, run: Run.loader{}},
    Loader{role: opt[*SlotRole].some{?slot.GOT}, act: Act.rebase{}, applied: Applied.kind{?kinds.RELATIVE}, run: Run.loader{}},
    Loader{role: opt[*SlotRole].some{?slot.GOT}, act: Act.bind{}, applied: Applied.kind{?kinds.GLOB_DAT}, run: Run.loader{}},
    Loader{role: opt[*SlotRole].some{?slot.GOT_PLT}, act: Act.bind{}, applied: Applied.kind{?kinds.JUMP_SLOT}, run: Run.lazy{}},
    Loader{role: opt[*SlotRole].some{?slot.COPY}, act: Act.bind{}, applied: Applied.kind{?kinds.COPY}, run: Run.loader{}},
    Loader{role: opt[*SlotRole].some{?slot.TLS_IE}, act: Act.rebase{}, applied: Applied.words{TPOFF}, run: Run.loader{}},
    Loader{role: opt[*SlotRole].some{?slot.TLS_IE}, act: Act.bind{}, applied: Applied.words{TPOFF}, run: Run.loader{}},
    Loader{role: opt[*SlotRole].some{?slot.TLS_GD}, act: Act.bind{}, applied: Applied.words{DTPMOD}, run: Run.loader{}},
    Loader{role: opt[*SlotRole].some{?slot.TLS_GD}, act: Act.bind{}, word: 1, applied: Applied.words{DTPOFF}, run: Run.loader{}},
    Loader{role: opt[*SlotRole].some{?slot.TLS_GD}, act: Act.rebase{}, applied: Applied.words{DTPMOD}, run: Run.loader{}},
    Loader{role: opt[*SlotRole].some{?slot.TLS_LD}, act: Act.rebase{}, applied: Applied.words{DTPMOD}, run: Run.loader{}},
    Loader{role: opt[*SlotRole].some{?slot.TLSDESC}, act: Act.bind{}, applied: Applied.kind{?kinds.TLSDESC}, run: Run.loader{}},
    Loader{role: opt[*SlotRole].some{?slot.TLSDESC}, act: Act.rebase{}, applied: Applied.kind{?kinds.TLSDESC}, run: Run.loader{}, held: 1},
};

# when a flag row sets its bit
# ---
# thread: a loader relocation site holds a thread pointer offset
pub tag Sets: u8 {
    thread;
}

# a bit of DT_FLAGS an image sets
# ---
# bit:    the bit
# output: over the output kind's capabilities
# sets:   which of the image's loader relocation sites set it
pub rec Flag {
    bit:    *Constant;
    output: Axis;
    sets:   Sets;
}

# a library whose initial exec slots the loader fills is refused by a loader
# that maps it after start, as DF_STATIC_TLS states
val FLAG_COUNT: usize            = 1;
val FLAGS:      [FLAG_COUNT]Flag = [FLAG_COUNT]Flag{
    Flag{bit: ?tables.DF_STATIC_TLS, output: Axis{need: output.LOADED}, sets: Sets.thread{}},
};

# what an image's symbol value counts from
# ---
# address: its address
# block:   the start of the image's thread-local block, the PT_TLS template
pub tag Origin: u8 {
    address;
    block;
}

# where an image writes a symbol's value from, in .symtab and .dynsym alike
# ---
# name:   the row's name
# kind:   over the symbol kind's capabilities
# origin: what its value counts from
pub rec Valued {
    name:   str;
    kind:   Axis;
    origin: Origin;
}

# a symbol naming thread-local data holds its offset in the image's
# thread-local block, as the gABI states for executables and shared objects
val VALUED_COUNT: usize                = 2;
val VALUED:       [VALUED_COUNT]Valued = [VALUED_COUNT]Valued{
    Valued{name: "address", kind: Axis{deny: symbol.THREAD}, origin: Origin.address{}},
    Valued{name: "thread-local", kind: Axis{need: symbol.THREAD}, origin: Origin.block{}},
};

# the symbols an ELF link defines at places of its layout: the GOT base the
# psABIs name _GLOBAL_OFFSET_TABLE_, hidden so the image's symbol table
# writes it local, the ends of an output section where it runs and where its
# bytes load, by which startup code copies a section from where it loads to
# where it runs, the run ends protected and the load ends default, and the
# module base a descriptor access of the x86 psABIs counts a module's
# offsets from, the start of the image's thread-local block, hidden
# thread-local data. none but the module base states a type
val BOUND_COUNT: usize                       = 6;
val BOUND_ROWS:  [BOUND_COUNT]boundary.Bound = [BOUND_COUNT]boundary.Bound{
    boundary.Bound{name: "_GLOBAL_OFFSET_TABLE_", place: boundary.Place.got_base{}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.HIDDEN, kind: ?symbol.NOTYPE},
    boundary.Bound{name: "__run_start_", prefix: true, place: boundary.Place.section_start{}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.PROTECTED, kind: ?symbol.NOTYPE},
    boundary.Bound{name: "__run_stop_", prefix: true, place: boundary.Place.section_end{}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.PROTECTED, kind: ?symbol.NOTYPE},
    boundary.Bound{name: "__load_start_", prefix: true, place: boundary.Place.load_start{}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.NOTYPE},
    boundary.Bound{name: "__load_stop_", prefix: true, place: boundary.Place.load_end{}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.NOTYPE},
    boundary.Bound{name: "_TLS_MODULE_BASE_", place: boundary.Place.block_start{}, align: 1, binding: ?symbol.GLOBAL, visibility: ?symbol.HIDDEN, kind: ?symbol.TLS},
};

pub val BOUNDS: boundary.Bounds = boundary.Bounds{rows: ?BOUND_ROWS[0], count: BOUND_COUNT};

# the GNU hash table's shift of the second bloom bit
val SHIFT2: u32 = 26;
# the bloom filter's bits per hashed symbol
val BLOOM_BITS: u64 = 12;
# the hashed symbols per GNU hash bucket
val PER_BUCKET: u64 = 4;
# a dynamic table's largest size
val LIMIT: u64 = 0xffff_ffff;

# the dynamic tables an ELF image whose kind imports holds
pub val TABLES: Declarer = Declarer{declare: declare};

# the form of the loader's relocations of the pair `relocs`
pub fun form_of(relocs: *row.Lookup) res[*Form, Fail] {
    if (relocs == nil) { ret res[*Form, Fail].err{fail.internal("the link names no relocation rows of its pair")}; }
    val r: res[*row.Row, Fail] = row.writing(relocs, ?kinds.RELATIVE);
    if (sel r.err) { ret res[*Form, Fail].err{r.err}; }
    val a: row.Addend = r.ok.addend;
    if (sel a.record) { ret res[*Form, Fail].ok{?RELA_FORM}; }
    if (sel a.field)  { ret res[*Form, Fail].ok{?REL_FORM}; }
    ret res[*Form, Fail].err{fail.about(fail.internal("the pair's RELATIVE row keeps its addend neither in its record nor in its field"), r.ok.name)};
}

# the program loader's path of `h`, refused naming the host when it names
# none
pub fun interpreter(h: *Host) res[str, Fail] {
    if (h.interpreter == nil) {
        ret res[str, Fail].err{fail.about(fail.in_record(fail.unsupported("a dynamic image needs an environment that names a program loader"), h.arch.name), h.system.name)};
    }
    ret res[str, Fail].ok{h.interpreter};
}

# the alignment of `p` in an image of class `c`
fun align_of(c: *Class, p: *Part) u64 {
    if (p.align == 0) { ret c.addr::u64; }
    ret p.align;
}

# the size of one entry of `p` in an image of class `c`
fun width_of(c: *Class, p: *Part) u64 {
    val w: Width = p.width;
    if (sel w.half)   { ret model.HALF::u64; }
    if (sel w.word)   { ret model.WORD::u64; }
    if (sel w.symbol) { ret c.symbol.size::u64; }
    if (sel w.rel)    { ret c.rel.size::u64; }
    if (sel w.rela)   { ret c.rela.size::u64; }
    if (sel w.entry)  { ret c.dyn.size::u64; }
    ret 0;
}

# reserve every dynamic table an image holds, refused for an image the
# loader starts for a host that names no program loader
fun declare(in: *reserve.In, out: *Reserved) err[Fail] {
    val held: Present = present(in.kind, in.dynamic);
    if (!held.imports) { ret err[Fail].ok{}; }
    if (held.imports && held.entered) {
        val path: res[str, Fail] = interpreter(in.host);
        if (sel path.err) { ret err[Fail].err{path.err}; }
    }
    val m: res[Machine, Fail] = traits.machine_of(in.arch);
    if (sel m.err) { ret err[Fail].err{m.err}; }
    val f: res[*Form, Fail] = form_of(in.relocs);
    if (sel f.err) { ret err[Fail].err{f.err}; }
    var list: [PART_COUNT]*Part;
    val n:    usize  = parts(f.ok, held, ?list);
    val c:    *Class = m.ok.shape.class;
    var i:    usize  = 0;
    for (i < n) {
        val p: *Part = list[i];
        i = i + 1;
        val d: res[Id[Reservation], Fail] = reserve.declare(in, out, reserve.Shape{
            name:       p.name,
            kind:       p.kind,
            flags:      p.flags,
            align:      align_of(c, p),
            sizing:     reserve.Sizing.measured{p.measure},
            entry_size: width_of(c, p),
            placement:  reserve.Placement.region_end{p.region},
            limit:      LIMIT,
            reason:     p.reason,
            anchor:     p.anchor,
        });
        if (sel d.err) { ret err[Fail].err{d.err}; }
    }
    ret err[Fail].ok{};
}

# what a dynamic symbol is
# ---
# imported: the import the loader binds it to
# absent:   a name nothing defines, which a site binds
# exported: a definition the image exports
# copied:   an import the image keeps a copy of, which it defines and
#           exports at the copy so every image binds the one copy
pub tag From: u8 {
    imported: Id[Import];
    absent:   Id[Name];
    exported: Id[Export];
    copied:   Copied;
}

# an import the image keeps a copy of
# ---
# import: the import
# slot:   its copy, among the entries of the copy role
pub rec Copied {
    import: Id[Import];
    slot:   u32;
}

# a dynamic symbol after the null symbol
# ---
# name:   its link name
# from:   what it is
# hash:   its GNU hash, for a hashed symbol
# bucket: its GNU hash bucket, for a hashed symbol
# at:     its place among the hashed symbols before they are ordered
pub rec Dynsym {
    name:   Id[Name];
    from:   From;
    hash:   u32;
    bucket: u32;
    at:     u32;
}

# a version the image defines
# ---
# name:   its name, in the link's names
# string: its name in the string table
pub rec Defined {
    name:   Id[Name];
    string: Id[Name];
}

# a version of a library the image loads that an import needs
# ---
# name:   its name, in the link's names
# index:  the version index its symbols' .gnu.version entries hold
# string: its name in the string table
# next:   the next version the same library is needed at, plus one, zero for
#         none
pub rec Needed {
    name:   Id[Name];
    index:  u16;
    string: Id[Name];
    next:   u32;
}

# the entry of its own a fixed image names an import at, as its PLT entry
# stands for a library function whose address it takes
# ---
# role: the slot role of the entry
# at:   the entry's index among the role's entries plus one, zero for none
pub rec Addressed {
    role: *SlotRole;
    at:   u32;
}

# what the dynamic tables hold, which the measures and the writer read
# ---
# libraries: the loader names of the libraries the image loads, in order
# symbols:   the dynamic symbols after the null symbol, the hashed last
# hashed:    how many hashed symbols end the symbols
# imports:   per import, the index of its dynamic symbol
# copies:    per import that heads the imports bound alike, its copy plus
#            one, zero for an import the image keeps no copy of
# addressed: per import that heads the imports bound alike, the entry the
#            image names it at
# absent:    per name of the link, the index of its dynamic symbol, zero for
#            none
# exported:  per binding, the index of its dynamic symbol, zero for none
# strings:   the dynamic string table
# names:     per library then per symbol, its name in the string table
# buckets:   how many GNU hash buckets
# words:     how many bloom filter words
# present:   the tables the image holds only for some images
# soname:    the name the image is known by, the file it is written to, in
#            the string table: a library the loader maps states it, and an
#            image that defines versions names its base version by it. none
#            for an image that does neither
# defined:   the versions the image defines past its base version, in the
#            order its exports first define them
# needed:    the versions the image needs of the libraries it loads
# heads:     per library, its first needed version plus one, zero for none
# versions:  per symbol, its .gnu.version entry
pub rec Plan {
    libraries: Table[Id[Name]];
    symbols:   Table[Dynsym];
    hashed:    u32;
    imports:   Table[u32];
    copies:    Table[u32];
    addressed: Table[Addressed];
    absent:    Table[u32];
    exported:  Table[u32];
    strings:   Strtab;
    names:     Table[Id[Name]];
    buckets:   u32;
    words:     u32;
    present:   Present;
    soname:    opt[Id[Name]];
    defined:   Table[Defined];
    needed:    Table[Needed];
    heads:     Table[u32];
    versions:  Table[u16];
}

pub fun make_plan(a: *A.Allocator) Plan {
    ret Plan{
        libraries: table.make[Id[Name]](a),
        symbols:   table.make[Dynsym](a),
        imports:   table.make[u32](a),
        copies:    table.make[u32](a),
        addressed: table.make[Addressed](a),
        absent:    table.make[u32](a),
        exported:  table.make[u32](a),
        strings:   strtab.make(a, strtab.Convention{lead: true, term: strtab.NUL}),
        names:     table.make[Id[Name]](a),
        defined:   table.make[Defined](a),
        needed:    table.make[Needed](a),
        heads:     table.make[u32](a),
        versions:  table.make[u16](a),
    };
}

pub fun release_plan(p: *Plan) err[Fail] {
    var first: err[Fail] = table.release[Id[Name]](?p.libraries);
    first = fail.kept(first, table.release[Dynsym](?p.symbols));
    first = fail.kept(first, table.release[u32](?p.imports));
    first = fail.kept(first, table.release[u32](?p.copies));
    first = fail.kept(first, table.release[Addressed](?p.addressed));
    first = fail.kept(first, table.release[u32](?p.absent));
    first = fail.kept(first, table.release[u32](?p.exported));
    first = fail.kept(first, strtab.release(?p.strings));
    first = fail.kept(first, table.release[Id[Name]](?p.names));
    first = fail.kept(first, table.release[Defined](?p.defined));
    first = fail.kept(first, table.release[Needed](?p.needed));
    first = fail.kept(first, table.release[u32](?p.heads));
    first = fail.kept(first, table.release[u16](?p.versions));
    ret first;
}

# the plan of the dynamic tables of `img`
pub fun plan(img: *Image, c: *Class, out: *Plan) err[Fail] {
    out.present = present(img.kind, img.dynamic);
    val l: err[Fail] = libraries_of(img, out);
    if (sel l.err) { ret l; }
    val k: err[Fail] = copies_of(img, out);
    if (sel k.err) { ret k; }
    val ad: err[Fail] = addressed_of(img, out);
    if (sel ad.err) { ret ad; }
    val i: err[Fail] = imports_of(img, out);
    if (sel i.err) { ret i; }
    val s: err[Fail] = absent_of(img, out);
    if (sel s.err) { ret s; }
    val e: err[Fail] = exports_of(img, c, out);
    if (sel e.err) { ret e; }
    val v: err[Fail] = versions_of(img, out);
    if (sel v.err) { ret v; }
    ret strings_of(img, out);
}

# the libraries the image loads, in the order the link first names each, since
# the loader searches DT_NEEDED in that order
fun libraries_of(img: *Image, out: *Plan) err[Fail] {
    val d: *dynamic.Dynamic = img.dynamic;
    var i: usize            = 0;
    for (i < table.count[Library](?d.libraries)) {
        val lib: *Library = table.at[Library](?d.libraries, table.nth[Library](i));
        i = i + 1;
        if (!lib.loaded) { cnt; }
        val p: res[Id[Id[Name]], Fail] = table.push[Id[Name]](?out.libraries, lib.loader);
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    ret err[Fail].ok{};
}

# the copy each import the image keeps one of takes, by the import that
# heads the imports bound alike
fun copies_of(img: *Image, out: *Plan) err[Fail] {
    val d: *dynamic.Dynamic = img.dynamic;
    val n: usize            = table.count[Import](?d.imports);
    if (n == 0) { ret err[Fail].ok{}; }
    val g: res[Id[u32], Fail] = table.grow[u32](?out.copies, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    val entries: *Table[dynamic.Entry] = dynamic.entries_of(d, ?slot.COPY);
    var k:       usize                 = 0;
    for (k < table.count[dynamic.Entry](entries)) {
        val aim: Aim = table.at[dynamic.Entry](entries, table.nth[dynamic.Entry](k)).aim;
        k = k + 1;
        if (!sel aim.imported) { ret err[Fail].err{fail.in_indexed(fail.internal("a copy is of no import"), "copy", (k - 1)::u64)}; }
        val head: Id[Import] = table.at[Import](?d.imports, aim.imported).binds;
        table.items[u32](?out.copies)[head.index::usize] = k::u32;
    }
    ret err[Fail].ok{};
}

# the entry each import whose address a reference takes as an entry's is
# named at, by the import that heads the imports bound alike, from the
# entries of every slot role
fun addressed_of(img: *Image, out: *Plan) err[Fail] {
    val d: *dynamic.Dynamic = img.dynamic;
    val n: usize            = table.count[Import](?d.imports);
    if (n == 0) { ret err[Fail].ok{}; }
    val g: res[Id[Addressed], Fail] = table.grow[Addressed](?out.addressed, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < slot.SLOT_ROLES) {
        val r:       *SlotRole             = slot.at(i);
        val entries: *Table[dynamic.Entry] = dynamic.entries_of(d, r);
        i = i + 1;
        var k: usize = 0;
        for (k < table.count[dynamic.Entry](entries)) {
            val e:   *dynamic.Entry = table.at[dynamic.Entry](entries, table.nth[dynamic.Entry](k));
            val aim: Aim            = e.aim;
            k = k + 1;
            if (!e.address)        { cnt; }
            if (!sel aim.imported) { ret err[Fail].err{fail.about(fail.internal("an entry stands for the address of no import"), r.name)}; }
            val head: Id[Import] = table.at[Import](?d.imports, aim.imported).binds;
            val at:   *Addressed = ?table.items[Addressed](?out.addressed)[head.index::usize];
            if (at.at != 0) { ret err[Fail].err{fail.about(fail.internal("two entries stand for the address of one import"), r.name)}; }
            at.role = r;
            at.at   = k::u32;
        }
    }
    ret err[Fail].ok{};
}

# a dynamic symbol for each import that heads the imports the loader binds
# alike, the others taking its symbol, but for one the image keeps a copy
# of, which it exports
fun imports_of(img: *Image, out: *Plan) err[Fail] {
    val d: *dynamic.Dynamic = img.dynamic;
    val n: usize            = table.count[Import](?d.imports);
    if (n == 0) { ret err[Fail].ok{}; }
    val g: res[Id[u32], Fail] = table.grow[u32](?out.imports, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < n) {
        val im: *Import = table.at[Import](?d.imports, table.nth[Import](i));
        if (im.binds.index::usize > i) { ret err[Fail].err{fail.in_indexed(fail.internal("an import binds as a later import does"), "import", i::u64)}; }
        if (im.binds.index::usize < i) {
            table.items[u32](?out.imports)[i] = table.items[u32](?out.imports)[im.binds.index::usize];
            i                                 = i + 1;
            cnt;
        }
        if (table.items[u32](?out.copies)[i] != 0) {
            i = i + 1;
            cnt;
        }
        val at: res[u32, Fail] = push_symbol(out, Dynsym{name: im.name, from: From.imported{table.nth[Import](i)}});
        if (sel at.err) { ret err[Fail].err{at.err}; }
        table.items[u32](?out.imports)[i] = at.ok;
        i                                 = i + 1;
    }
    ret err[Fail].ok{};
}

# a dynamic symbol for each name nothing defines that a site binds, once, in
# the order of the sites
fun absent_of(img: *Image, out: *Plan) err[Fail] {
    val n: usize = intern.count(img.names);
    if (n != 0) {
        val g: res[Id[u32], Fail] = table.grow[u32](?out.absent, n);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    var i: usize = 0;
    for (i < table.count[Site](?img.sites.list)) {
        val s:   *Site = table.at[Site](?img.sites.list, table.nth[Site](i));
        val aim: Aim   = s.aim;
        i = i + 1;
        if (!sel s.kind.bind) { cnt; }
        if (sel aim.absent) {
            val name: Id[Name] = aim.absent;
            if (name.index::usize >= n) { ret err[Fail].err{fail.in_indexed(fail.internal("a site binds a name the link does not hold"), "loader relocation site", (i - 1)::u64)}; }
            if (table.items[u32](?out.absent)[name.index::usize] == 0) {
                val at: res[u32, Fail] = push_symbol(out, Dynsym{name: name, from: From.absent{name}});
                if (sel at.err) { ret err[Fail].err{at.err}; }
                table.items[u32](?out.absent)[name.index::usize] = at.ok;
            }
        }
    }
    ret err[Fail].ok{};
}

# a dynamic symbol for each export and then each copy, hashed, ordered by
# its GNU hash bucket and within one by that order, with the GNU hash
# table's geometry
fun exports_of(img: *Image, c: *Class, out: *Plan) err[Fail] {
    val d:      *dynamic.Dynamic      = img.dynamic;
    val copies: *Table[dynamic.Entry] = dynamic.entries_of(d, ?slot.COPY);
    val shared: usize                 = table.count[Export](?d.exports);
    val n:      usize                 = shared + table.count[dynamic.Entry](copies);
    val first:  usize                 = table.count[Dynsym](?out.symbols);
    if (n > 0xffff_ffff - first - 1) { ret err[Fail].err{fail.overflow("the dynamic symbols pass 32-bit indexes")}; }
    var buckets: u64 = n::u64 / PER_BUCKET;
    if (buckets == 0) { buckets = 1; }
    out.buckets = buckets::u32;
    out.hashed  = n::u32;
    out.words   = bloom_words(n::u64, c);
    var i: usize = 0;
    for (i < shared) {
        val e:  *Export        = table.at[Export](?d.exports, table.nth[Export](i));
        val bd: *Binding       = table.at[Binding](?img.resolved.bindings, e.binding);
        val h:  u32            = gnu_hash(intern.bytes_of(img.names, bd.name));
        val at: res[u32, Fail] = push_symbol(out, Dynsym{name: bd.name, from: From.exported{table.nth[Export](i)}, hash: h, bucket: h % out.buckets, at: i::u32});
        if (sel at.err) { ret err[Fail].err{at.err}; }
        i = i + 1;
    }
    for (i < n) {
        val k:   usize = i - shared;
        val aim: Aim   = table.at[dynamic.Entry](copies, table.nth[dynamic.Entry](k)).aim;
        if (!sel aim.imported) { ret err[Fail].err{fail.in_indexed(fail.internal("a copy is of no import"), "copy", k::u64)}; }
        val name: Id[Name]       = table.at[Import](?d.imports, aim.imported).name;
        val h:    u32            = gnu_hash(intern.bytes_of(img.names, name));
        val at:   res[u32, Fail] = push_symbol(out, Dynsym{name: name, from: From.copied{Copied{import: aim.imported, slot: k::u32}}, hash: h, bucket: h % out.buckets, at: i::u32});
        if (sel at.err) { ret err[Fail].err{at.err}; }
        i = i + 1;
    }
    if (n != 0) { sort.sort_by[Dynsym](?table.items[Dynsym](?out.symbols)[first], n, order_hashed); }
    val count: usize = table.count[Binding](?img.resolved.bindings);
    if (count != 0) {
        val g: res[Id[u32], Fail] = table.grow[u32](?out.exported, count);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    i = first;
    for (i < table.count[Dynsym](?out.symbols)) {
        val s: *Dynsym = table.at[Dynsym](?out.symbols, table.nth[Dynsym](i));
        val f: From    = s.from;
        i = i + 1;
        if (sel f.copied) {
            val head: Id[Import] = table.at[Import](?d.imports, f.copied.import).binds;
            table.items[u32](?out.imports)[head.index::usize] = i::u32;
            cnt;
        }
        if (!sel f.exported) { ret err[Fail].err{fail.internal("a hashed dynamic symbol is neither an export nor a copy")}; }
        val bd: Id[Binding] = table.at[Export](?d.exports, f.exported).binding;
        table.items[u32](?out.exported)[bd.index::usize] = i::u32;
    }
    copied_alike(d, out);
    ret err[Fail].ok{};
}

# give each import bound alike as a copied one the copy's dynamic symbol
fun copied_alike(d: *dynamic.Dynamic, out: *Plan) {
    var i: usize = 0;
    for (i < table.count[Import](?d.imports)) {
        val head: Id[Import] = table.at[Import](?d.imports, table.nth[Import](i)).binds;
        if (head.index::usize != i && table.items[u32](?out.copies)[head.index::usize] != 0) {
            table.items[u32](?out.imports)[i] = table.items[u32](?out.imports)[head.index::usize];
        }
        i = i + 1;
    }
}

fun order_hashed(a: *Dynsym, b: *Dynsym) i64 {
    if (a.bucket < b.bucket) { ret -1; }
    if (a.bucket > b.bucket) { ret 1; }
    if (a.at < b.at)         { ret -1; }
    if (a.at > b.at)         { ret 1; }
    ret 0;
}

# the bloom filter words for `n` hashed symbols in a class of `c`: twelve
# bits a symbol in words of the class's address width, rounded up to the
# next power of two above, one when nothing is hashed
fun bloom_words(n: u64, c: *Class) u32 {
    if (n == 0) { ret 1; }
    val bits: u64 = n * BLOOM_BITS / (c.addr::u64 * 8);
    var w:    u64 = 1;
    for (w <= bits) { w = w << 1; }
    ret w::u32;
}

# push `s`, the index of its dynamic symbol
fun push_symbol(out: *Plan, s: Dynsym) res[u32, Fail] {
    val p: res[Id[Dynsym], Fail] = table.push[Dynsym](?out.symbols, s);
    if (sel p.err) { ret res[u32, Fail].err{p.err}; }
    ret res[u32, Fail].ok{p.ok.index + 1};
}

# the name an image is known by: the file name of the path it is written to,
# refused when the link states none
pub fun soname_of(img: *Image) res[View, Fail] {
    val path: str = img.output;
    if (path == nil) { ret res[View, Fail].err{fail.unsupported("the image is known by the file it is written to, which the link states none of")}; }
    val p:     *u8   = path::*u8;
    val n:     usize = str_len(path);
    var start: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (p[i] == '/') { start = i + 1; }
        i = i + 1;
    }
    if (start == n) { ret res[View, Fail].err{fail.about(fail.unsupported("the path the image is written to names no file, which it is known by"), path)}; }
    ret res[View, Fail].ok{View{data: ?p[start], len: n - start}};
}

# the versions the image defines and needs, and each symbol's version: an
# import of a version needs its library's version, an export of a version
# defines it, hidden where it is not the default, and every other symbol is
# of the base version. the defined versions take the indexes after the base
# version's, then the needed ones library by library
fun versions_of(img: *Image, out: *Plan) err[Fail] {
    if (!out.present.defines && !out.present.needs) { ret err[Fail].ok{}; }
    var named: Table[u32] = table.make[u32](img.inputs.a);
    var wants: Table[u32] = table.make[u32](img.inputs.a);
    val r:     err[Fail]  = versions_in(img, out, ?named, ?wants);
    ret fail.kept(fail.kept(r, table.release[u32](?named)), table.release[u32](?wants));
}

# the versions through `named`, each defined version's index plus one by its
# name, and `wants`, each import's needed version plus one
fun versions_in(img: *Image, out: *Plan, named: *Table[u32], wants: *Table[u32]) err[Fail] {
    val n: err[Fail] = zeroed(named, intern.count(img.names));
    if (sel n.err) { ret n; }
    val w: err[Fail] = zeroed(wants, table.count[Import](?img.dynamic.imports));
    if (sel w.err) { ret w; }
    val d: err[Fail] = defined_of(img, out, named);
    if (sel d.err) { ret d; }
    val e: err[Fail] = needed_of(img, out, wants);
    if (sel e.err) { ret e; }
    ret symbol_versions(img, out, named, wants);
}

# `n` zeros into the empty `t`
fun zeroed(t: *Table[u32], n: usize) err[Fail] {
    if (n == 0) { ret err[Fail].ok{}; }
    val g: res[Id[u32], Fail] = table.grow[u32](t, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    ret err[Fail].ok{};
}

# each version an export defines, once, in export order, `named` holding
# each one's index plus one by its name
fun defined_of(img: *Image, out: *Plan, named: *Table[u32]) err[Fail] {
    val d: *dynamic.Dynamic = img.dynamic;
    var i: usize            = 0;
    for (i < table.count[Export](?d.exports)) {
        val v: opt[Id[Name]] = table.at[Export](?d.exports, table.nth[Export](i)).version;
        i = i + 1;
        if (sel v.none) { cnt; }
        val name: Id[Name] = v.some;
        if (table.items[u32](named)[name.index::usize] != 0) { cnt; }
        val p: res[Id[Defined], Fail] = table.push[Defined](?out.defined, Defined{name: name});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        table.items[u32](named)[name.index::usize] = p.ok.index + 1;
    }
    ret err[Fail].ok{};
}

# each version of a library an import needs, once per library, chained by
# library in the order the image loads them and numbered in that order, with
# the version each import needs plus one in `wants`
fun needed_of(img: *Image, out: *Plan, wants: *Table[u32]) err[Fail] {
    val d:     *dynamic.Dynamic = img.dynamic;
    val count: usize            = table.count[Id[Name]](?out.libraries);
    if (count != 0) {
        val g: res[Id[u32], Fail] = table.grow[u32](?out.heads, count);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    var at: Table[u32] = table.make[u32](img.inputs.a);
    var r:  err[Fail]  = positions(img, out, ?at);
    var i:  usize      = 0;
    for (i < table.count[Import](?d.imports) && sel r.ok) {
        val im: *Import = table.at[Import](?d.imports, table.nth[Import](i));
        i = i + 1;
        if (im.binds.index::usize != i - 1) { cnt; }
        val off: *Offer        = table.at[Offer](?d.offers, im.offer);
        val v:   opt[Id[Name]] = off.version;
        if (sel v.none) { cnt; }
        val loader: Id[Name] = table.at[Library](?d.libraries, off.library).loader;
        val pos:    u32      = table.items[u32](?at)[loader.index::usize];
        if (pos == 0) {
            r = err[Fail].err{fail.in_indexed(fail.internal("an import needs a version of a library the image does not load"), "import", (i - 1)::u64)};
            brk;
        }
        val k: res[u32, Fail] = need(out, pos - 1, v.some);
        if (sel k.err) {
            r = err[Fail].err{k.err};
            brk;
        }
        table.items[u32](wants)[i - 1] = k.ok + 1;
    }
    r = fail.kept(r, table.release[u32](?at));
    if (sel r.err) { ret r; }
    var next: u64 = table.count[Defined](?out.defined)::u64 + 2;
    i = 0;
    for (i < count) {
        var k: u32 = table.items[u32](?out.heads)[i];
        i = i + 1;
        for (k != 0) {
            if (next > tables.VERSYM_VERSION.value) { ret err[Fail].err{fail.overflow("the versions the image defines and needs pass the indexes a version entry holds")}; }
            val e: *Needed = table.at[Needed](?out.needed, table.nth[Needed]((k - 1)::usize));
            e.index = next::u16;
            next    = next + 1;
            k       = e.next;
        }
    }
    ret err[Fail].ok{};
}

# per loader name, the library's place among those the image loads plus one
fun positions(img: *Image, out: *Plan, at: *Table[u32]) err[Fail] {
    val n: usize = intern.count(img.names);
    if (n != 0) {
        val g: res[Id[u32], Fail] = table.grow[u32](at, n);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    var i: usize = 0;
    for (i < table.count[Id[Name]](?out.libraries)) {
        table.items[u32](at)[table.items[Id[Name]](?out.libraries)[i].index::usize] = (i + 1)::u32;
        i                                                                           = i + 1;
    }
    ret err[Fail].ok{};
}

# the version `v` of the `lib`th library the image loads, needed once, at
# the end of the library's chain, its index among the needed versions
fun need(out: *Plan, lib: u32, v: Id[Name]) res[u32, Fail] {
    var last: *u32 = ?table.items[u32](?out.heads)[lib::usize];
    for (@last != 0) {
        val e: *Needed = table.at[Needed](?out.needed, table.nth[Needed]((@last - 1)::usize));
        if (e.name.index == v.index) { ret res[u32, Fail].ok{@last - 1}; }
        last = ?e.next;
    }
    val p: res[Id[Needed], Fail] = table.push[Needed](?out.needed, Needed{name: v});
    if (sel p.err) { ret res[u32, Fail].err{p.err}; }
    @last = p.ok.index + 1;
    ret res[u32, Fail].ok{p.ok.index};
}

# each dynamic symbol's .gnu.version entry, a copy taking the version its
# import needs
fun symbol_versions(img: *Image, out: *Plan, named: *Table[u32], wants: *Table[u32]) err[Fail] {
    val d: *dynamic.Dynamic = img.dynamic;
    val n: usize            = table.count[Dynsym](?out.symbols);
    if (n != 0) {
        val g: res[Id[u16], Fail] = table.grow[u16](?out.versions, n);
        if (sel g.err) { ret err[Fail].err{g.err}; }
    }
    var i: usize = 0;
    for (i < n) {
        val f: From = table.items[Dynsym](?out.symbols)[i].from;
        var v: u16  = tables.VER_NDX_GLOBAL.value::u16;
        if (sel f.imported) {
            val k: u32 = table.items[u32](wants)[f.imported.index::usize];
            if (k != 0) { v = table.at[Needed](?out.needed, table.nth[Needed]((k - 1)::usize)).index; }
        }
        or (sel f.copied) {
            val k: u32 = table.items[u32](wants)[f.copied.import.index::usize];
            if (k != 0) { v = table.at[Needed](?out.needed, table.nth[Needed]((k - 1)::usize)).index; }
        }
        or (sel f.exported) {
            val e: *Export = table.at[Export](?d.exports, f.exported);
            if (sel e.version.some) {
                val k: u32 = table.items[u32](named)[e.version.some.index::usize];
                if (k == 0) { ret err[Fail].err{fail.in_indexed(fail.internal("an export's version is not defined"), "dynamic symbol", (i + 1)::u64)}; }
                v = (k + 1)::u16;
                if (!e.default) { v = v | tables.VERSYM_HIDDEN.value::u16; }
            }
        }
        table.items[u16](?out.versions)[i] = v;
        i                                  = i + 1;
    }
    ret err[Fail].ok{};
}

# the libraries' names, then the symbols' names, then the name a library is
# known by and the versions' names, into the string table
fun strings_of(img: *Image, out: *Plan) err[Fail] {
    val e: res[Id[Name], Fail] = strtab.add_str(?out.strings, "");
    if (sel e.err) { ret err[Fail].err{e.err}; }
    var i: usize = 0;
    for (i < table.count[Id[Name]](?out.libraries)) {
        val r: err[Fail] = string_of(img, out, table.items[Id[Name]](?out.libraries)[i]);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "library", i::u64)}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Dynsym](?out.symbols)) {
        val r: err[Fail] = string_of(img, out, table.items[Dynsym](?out.symbols)[i].name);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "dynamic symbol", (i + 1)::u64)}; }
        i = i + 1;
    }
    if (output.has(img.kind, output.LOADED) || out.present.defines) {
        val so: res[View, Fail] = soname_of(img);
        if (sel so.err) { ret err[Fail].err{so.err}; }
        val id: res[Id[Name], Fail] = strtab.add(?out.strings, so.ok.data, so.ok.len);
        if (sel id.err) { ret err[Fail].err{id.err}; }
        out.soname = opt[Id[Name]].some{id.ok};
    }
    i = 0;
    for (i < table.count[Defined](?out.defined)) {
        val e:  *Defined            = table.at[Defined](?out.defined, table.nth[Defined](i));
        val v:  View                = intern.bytes_of(img.names, e.name);
        val id: res[Id[Name], Fail] = strtab.add(?out.strings, v.data, v.len);
        if (sel id.err) { ret err[Fail].err{id.err}; }
        e.string = id.ok;
        i        = i + 1;
    }
    i = 0;
    for (i < table.count[Needed](?out.needed)) {
        val e:  *Needed             = table.at[Needed](?out.needed, table.nth[Needed](i));
        val v:  View                = intern.bytes_of(img.names, e.name);
        val id: res[Id[Name], Fail] = strtab.add(?out.strings, v.data, v.len);
        if (sel id.err) { ret err[Fail].err{id.err}; }
        e.string = id.ok;
        i        = i + 1;
    }
    ret strtab.finish(?out.strings);
}

fun string_of(img: *Image, out: *Plan, name: Id[Name]) err[Fail] {
    val v:  View                = intern.bytes_of(img.names, name);
    val id: res[Id[Name], Fail] = strtab.add(?out.strings, v.data, v.len);
    if (sel id.err) { ret err[Fail].err{id.err}; }
    val p: res[Id[Id[Name]], Fail] = table.push[Id[Name]](?out.names, id.ok);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the GNU hash of `v`
pub fun gnu_hash(v: View) u32 {
    var h: u32   = 5381;
    var i: usize = 0;
    for (i < v.len) {
        h = h * 33 + v.data[i]::u32;
        i = i + 1;
    }
    ret h;
}

# the SysV ELF hash of `v`
pub fun sysv_hash(v: View) u32 {
    var h: u32   = 0;
    var i: usize = 0;
    for (i < v.len) {
        h = (h << 4) + v.data[i]::u32;
        val g: u32 = h & 0xf000_0000;
        if (g != 0) { h = h ^ (g >> 24); }
        h = h & ~g;
        i = i + 1;
    }
    ret h;
}

# how many dynamic symbols, the null symbol among them
fun symbol_count(p: *Plan) u64 {
    ret table.count[Dynsym](?p.symbols)::u64 + 1;
}

# the offset of the name `id` in the string table of `p`, refused past 32
# bits
fun string_offset(p: *Plan, id: Id[Name]) res[u32, Fail] {
    val at: u64 = strtab.offset(?p.strings, id);
    if (at > 0xffff_ffff) { ret res[u32, Fail].err{fail.overflow("the dynamic strings pass 4 GiB")}; }
    ret res[u32, Fail].ok{at::u32};
}

# the class of the image `img`
fun class_of(img: *Image) res[*Class, Fail] {
    val m: res[Machine, Fail] = traits.machine_of(img.target.arch);
    if (sel m.err) { ret res[*Class, Fail].err{m.err}; }
    ret res[*Class, Fail].ok{m.ok.shape.class};
}

# the size of the table measured by `key` in the image `img`, through its
# plan
fun planned(img: *Image, key: *Measure) res[u64, Fail] {
    val c: res[*Class, Fail] = class_of(img);
    if (sel c.err) { ret res[u64, Fail].err{c.err}; }
    var p:    Plan           = make_plan(img.inputs.a);
    val r:    err[Fail]      = plan(img, c.ok, ?p);
    var size: res[u64, Fail] = res[u64, Fail].err{fail.internal("a dynamic table was not measured")};
    if (sel r.err) { size = res[u64, Fail].err{r.err}; }
    or             { size = size_of(img, c.ok, ?p, key); }
    val rel: err[Fail] = release_plan(?p);
    if (sel size.err) { ret size; }
    if (sel rel.err)  { ret res[u64, Fail].err{rel.err}; }
    ret size;
}

# the size of the table `key` measures, from the plan `p` of `img`
fun size_of(img: *Image, c: *Class, p: *Plan, key: *Measure) res[u64, Fail] {
    val at: Location = Location{record: key.name};
    val n:  u64      = symbol_count(p);
    if (key == ?SYMBOLS) { ret checked.mul(at, n, c.symbol.size::u64); }
    if (key == ?STRINGS) { ret res[u64, Fail].ok{strtab.size(?p.strings)}; }
    if (key == ?HASH) {
        val words: res[u64, Fail] = checked.mul(at, n, 2);
        if (sel words.err) { ret words; }
        val bytes: res[u64, Fail] = checked.mul(at, words.ok + 2, model.WORD::u64);
        ret bytes;
    }
    if (key == ?GNU_HASH) {
        val bloom: res[u64, Fail] = checked.mul(at, p.words::u64, c.addr::u64);
        if (sel bloom.err) { ret bloom; }
        val words: res[u64, Fail] = checked.mul(at, p.buckets::u64 + p.hashed::u64, model.WORD::u64);
        if (sel words.err) { ret words; }
        ret checked.add(at, 16 + bloom.ok, words.ok);
    }
    if (key == ?VERSYM) { ret checked.mul(at, n, model.HALF::u64); }
    if (key == ?VERDEF) { ret checked.mul(at, definitions(p)::u64, (model.VERDEF.size + model.VERDAUX.size)::u64); }
    if (key == ?VERNEED) {
        val files: res[u64, Fail] = checked.mul(at, files_needed(p)::u64, model.VERNEED.size::u64);
        if (sel files.err) { ret files; }
        val each: res[u64, Fail] = checked.mul(at, table.count[Needed](?p.needed)::u64, model.VERNAUX.size::u64);
        if (sel each.err) { ret each; }
        ret checked.add(at, files.ok, each.ok);
    }
    if (key == ?DYNAMIC) {
        var list: Table[model.Dyn] = table.make[model.Dyn](img.inputs.a);
        val r:    err[Fail]        = entries(img, c, p, ?list);
        val k:    u64              = table.count[model.Dyn](?list)::u64;
        val rel:  err[Fail]        = table.release[model.Dyn](?list);
        if (sel r.err)   { ret res[u64, Fail].err{r.err}; }
        if (sel rel.err) { ret res[u64, Fail].err{rel.err}; }
        ret checked.mul(at, k, c.dyn.size::u64);
    }
    ret res[u64, Fail].err{fail.about(fail.internal("no dynamic table has this measure"), key.name)};
}

pub fun measure_symbols(img: *Image) res[u64, Fail] {
    ret planned(img, ?SYMBOLS);
}

pub fun measure_strings(img: *Image) res[u64, Fail] {
    ret planned(img, ?STRINGS);
}

pub fun measure_hash(img: *Image) res[u64, Fail] {
    ret planned(img, ?HASH);
}

pub fun measure_gnu_hash(img: *Image) res[u64, Fail] {
    ret planned(img, ?GNU_HASH);
}

pub fun measure_dynamic(img: *Image) res[u64, Fail] {
    ret planned(img, ?DYNAMIC);
}

pub fun measure_versym(img: *Image) res[u64, Fail] {
    ret planned(img, ?VERSYM);
}

pub fun measure_verdef(img: *Image) res[u64, Fail] {
    ret planned(img, ?VERDEF);
}

pub fun measure_verneed(img: *Image) res[u64, Fail] {
    ret planned(img, ?VERNEED);
}

# how many version definitions, the base version among them
fun definitions(p: *Plan) usize {
    ret table.count[Defined](?p.defined) + 1;
}

# how many libraries the image needs a version of
fun files_needed(p: *Plan) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < table.count[u32](?p.heads)) {
        if (table.items[u32](?p.heads)[i] != 0) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the program loader's path and its terminating NUL
pub fun measure_interp(img: *Image) res[u64, Fail] {
    val path: res[str, Fail] = interpreter(img.host);
    if (sel path.err) { ret res[u64, Fail].err{path.err}; }
    ret res[u64, Fail].ok{str_len(path.ok)::u64 + 1};
}

# a record for each loader relocation site of the loader's table
pub fun measure_relocs(img: *Image) res[u64, Fail] {
    ret run_bytes(img, Run.loader{}, ?RELOCS);
}

# a record for each loader relocation site the loader binds lazily
pub fun measure_plt_relocs(img: *Image) res[u64, Fail] {
    ret run_bytes(img, Run.lazy{}, ?PLT_RELOCS);
}

# the bytes the records of the sites of the run `r` take
fun run_bytes(img: *Image, r: Run, key: *Measure) res[u64, Fail] {
    val c: res[*Class, Fail] = class_of(img);
    if (sel c.err) { ret res[u64, Fail].err{c.err}; }
    val f: res[*Form, Fail] = form_of(img.relocs);
    if (sel f.err) { ret res[u64, Fail].err{f.err}; }
    val n: res[u64, Fail] = run_count(img, r);
    if (sel n.err) { ret n; }
    ret checked.mul(Location{record: key.name}, n.ok, width_of(c.ok, f.ok.part));
}

# how many loader relocation sites go to the run `r`
fun run_count(img: *Image, r: Run) res[u64, Fail] {
    val c: res[*Class, Fail] = class_of(img);
    if (sel c.err) { ret res[u64, Fail].err{c.err}; }
    var n: u64   = 0;
    var i: usize = 0;
    for (i < table.count[Site](?img.sites.list)) {
        val ld: res[*Loader, Fail] = loader_of(table.at[Site](?img.sites.list, table.nth[Site](i)), c.ok.addr::u64);
        if (sel ld.err)             { ret res[u64, Fail].err{fail.in_indexed(ld.err, "loader relocation site", i::u64)}; }
        if (same_run(ld.ok.run, r)) { n = n + 1; }
        i = i + 1;
    }
    ret res[u64, Fail].ok{n};
}

fun same_run(a: Run, b: Run) bool {
    if (sel a.loader) { ret sel b.loader; }
    ret sel b.lazy;
}

fun same_act(a: Act, b: Act) bool {
    if (sel a.rebase) { ret sel b.rebase; }
    ret sel b.bind;
}

# what the loader does at the site `s`, as a row states it
fun act_of(s: *Site) Act {
    if (sel s.kind.rebase) { ret Act.rebase{}; }
    ret Act.bind{};
}

# the address of the table the format's row for role `r` laid, none when it
# laid none
fun table_address(img: *Image, r: *SlotRole) res[opt[u64], Fail] {
    val t: opt[Id[Reservation]] = img.reserved.held[r.at::usize];
    if (sel t.none) { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    val sp: res[layout.Span, Fail] = layout.span_of(img.layout, img.reserved, t.some);
    if (sel sp.err) { ret res[opt[u64], Fail].err{sp.err}; }
    ret res[opt[u64], Fail].ok{opt[u64].some{sp.ok.address}};
}

# the reservation of the dynamic table `p` of `img`, none when the image
# holds none
fun reserved_of(img: *Image, p: *Part) opt[Id[Reservation]] {
    val r:  *Reserved     = img.reserved;
    val nm: opt[Id[Name]] = intern.find(img.names, p.name::*u8, str_len(p.name));
    if (sel nm.none) { ret opt[Id[Reservation]].none{}; }
    var i: usize = 0;
    for (i < table.count[Reservation](?r.tables)) {
        val rv: *Reservation = table.at[Reservation](?r.tables, table.nth[Reservation](i));
        i = i + 1;
        val ms: opt[*Measure] = rv.measure;
        if (rv.name.index != nm.some.index) { cnt; }
        if (sel ms.none)                    { cnt; }
        if (ms.some == p.measure)           { ret opt[Id[Reservation]].some{table.nth[Reservation](i - 1)}; }
    }
    ret opt[Id[Reservation]].none{};
}

# the arrays of functions the loader runs at start and exit, each found by
# the role its output section plays
# ---
# role:  the role
# table: the dynamic tag of its address
# size:  the dynamic tag of its size
rec Array {
    role:  section.Roles;
    table: *DynTag;
    size:  *DynTag;
}

val ARRAY_COUNT: usize              = 3;
val ARRAYS:      [ARRAY_COUNT]Array = [ARRAY_COUNT]Array{
    Array{role: section.PREINIT, table: ?tables.DT_PREINIT_ARRAY, size: ?tables.DT_PREINIT_ARRAYSZ},
    Array{role: section.INIT, table: ?tables.DT_INIT_ARRAY, size: ?tables.DT_INIT_ARRAYSZ},
    Array{role: section.FINI, table: ?tables.DT_FINI_ARRAY, size: ?tables.DT_FINI_ARRAYSZ},
};

# the functions the loader of a dynamic image calls at start and exit, which
# DT_INIT and DT_FINI name, as the gABI states. the gABI names no symbol for
# them, so the System V convention's names hold, _init and _fini, which the
# .init and .fini code of the C runtime's crti.o and crtn.o frame
pub val INIT: Called = Called{name: "_init", output: Axis{need: output.IMPORTS}};
pub val FINI: Called = Called{name: "_fini", output: Axis{need: output.IMPORTS}};

val CALLED_COUNT: usize                 = 2;
val CALLED:       [CALLED_COUNT]*Called = [CALLED_COUNT]*Called{?INIT, ?FINI};

pub val CALLS: collect.Calls = collect.Calls{rows: ?CALLED[0], count: CALLED_COUNT};

# a function the loader calls and the dynamic tag naming its address
rec Calling {
    called: *Called;
    tag:    *DynTag;
}

val CALLING: [CALLED_COUNT]Calling = [CALLED_COUNT]Calling{
    Calling{called: ?INIT, tag: ?tables.DT_INIT},
    Calling{called: ?FINI, tag: ?tables.DT_FINI},
};

# where layout put a dynamic table
# ---
# merged:  the output section holding it
# offset:  where in that section it starts
# address: its address
# file:    its offset in the file
pub rec Laid {
    merged:  Id[Merged];
    offset:  u64;
    address: u64;
    file:    u64;
}

# where layout put the dynamic table `p` of `img`
fun laid(img: *Image, p: *Part) res[Laid, Fail] {
    val l:  *Layout              = img.layout;
    val id: opt[Id[Reservation]] = reserved_of(img, p);
    if (sel id.none)                                          { ret res[Laid, Fail].err{fail.about(fail.internal("a dynamic table is not reserved"), p.name)}; }
    if (id.some.index::usize >= table.count[Spot](?l.tables)) { ret res[Laid, Fail].err{fail.about(fail.internal("a dynamic table was never placed"), p.name)}; }
    val sp: Spot = table.items[Spot](?l.tables)[id.some.index::usize];
    if (!sel sp.section) { ret res[Laid, Fail].err{fail.about(fail.internal("a dynamic table lies in no output section"), p.name)}; }
    val m:  *Merged        = table.at[Merged](?l.merged, sp.section.merged);
    val at: Location       = Location{record: p.name};
    val a:  res[u64, Fail] = checked.add(at, m.address, sp.section.offset);
    if (sel a.err) { ret res[Laid, Fail].err{a.err}; }
    val f: res[u64, Fail] = checked.add(at, m.offset, sp.section.offset);
    if (sel f.err) { ret res[Laid, Fail].err{f.err}; }
    ret res[Laid, Fail].ok{Laid{merged: sp.section.merged, offset: sp.section.offset, address: a.ok, file: f.ok}};
}

fun address_of(img: *Image, p: *Part) res[u64, Fail] {
    val at: res[Laid, Fail] = laid(img, p);
    if (sel at.err) { ret res[u64, Fail].err{at.err}; }
    ret res[u64, Fail].ok{at.ok.address};
}

fun entry(out: *Table[model.Dyn], tag: *DynTag, value: u64) err[Fail] {
    val p: res[Id[model.Dyn], Fail] = table.push[model.Dyn](out, model.Dyn{kind: tag.value::i64, value: value});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun table_entry(img: *Image, out: *Table[model.Dyn], tag: *DynTag, p: *Part) err[Fail] {
    val a: res[u64, Fail] = address_of(img, p);
    if (sel a.err) { ret err[Fail].err{a.err}; }
    ret entry(out, tag, a.ok);
}

# the entries of the dynamic section of `img` from its plan `p`, into `out`
fun entries(img: *Image, c: *Class, p: *Plan, out: *Table[model.Dyn]) err[Fail] {
    val f: res[*Form, Fail] = form_of(img.relocs);
    if (sel f.err) { ret err[Fail].err{f.err}; }
    var i: usize = 0;
    for (i < table.count[Id[Name]](?p.libraries)) {
        val at: res[u32, Fail] = string_offset(p, table.items[Id[Name]](?p.names)[i]);
        if (sel at.err) { ret err[Fail].err{at.err}; }
        val e: err[Fail] = entry(out, ?tables.DT_NEEDED, at.ok::u64);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    val so: opt[Id[Name]] = p.soname;
    if (sel so.some) {
        if (output.has(img.kind, output.LOADED)) {
            val at: res[u32, Fail] = string_offset(p, so.some);
            if (sel at.err) { ret err[Fail].err{at.err}; }
            val e: err[Fail] = entry(out, ?tables.DT_SONAME, at.ok::u64);
            if (sel e.err) { ret e; }
        }
    }
    i = 0;
    for (i < CALLED_COUNT) {
        val e: err[Fail] = called_entry(img, ?CALLING[i], out);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    i = 0;
    for (i < ARRAY_COUNT) {
        val e: err[Fail] = array_entries(img, ?ARRAYS[i], out);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    val h: err[Fail] = table_entry(img, out, ?tables.DT_HASH, ?HASH_PART);
    if (sel h.err) { ret h; }
    val g: err[Fail] = table_entry(img, out, ?tables.DT_GNU_HASH, ?GNU_HASH_PART);
    if (sel g.err) { ret g; }
    val s: err[Fail] = table_entry(img, out, ?tables.DT_STRTAB, ?DYNSTR_PART);
    if (sel s.err) { ret s; }
    val y: err[Fail] = table_entry(img, out, ?tables.DT_SYMTAB, ?DYNSYM_PART);
    if (sel y.err) { ret y; }
    val sz: err[Fail] = entry(out, ?tables.DT_STRSZ, strtab.size(?p.strings));
    if (sel sz.err) { ret sz; }
    val se: err[Fail] = entry(out, ?tables.DT_SYMENT, c.symbol.size::u64);
    if (sel se.err) { ret se; }
    val v: err[Fail] = version_entries(img, p, out);
    if (sel v.err) { ret v; }
    val rt: err[Fail] = table_entry(img, out, f.ok.table, f.ok.part);
    if (sel rt.err) { ret rt; }
    val width: u64            = width_of(c, f.ok.part);
    val dyn:   res[u64, Fail] = run_count(img, Run.loader{});
    if (sel dyn.err) { ret err[Fail].err{dyn.err}; }
    val bytes: res[u64, Fail] = checked.mul(Location{record: RELOCS.name}, dyn.ok, width);
    if (sel bytes.err) { ret err[Fail].err{bytes.err}; }
    val rs: err[Fail] = entry(out, f.ok.size, bytes.ok);
    if (sel rs.err) { ret rs; }
    val re: err[Fail] = entry(out, f.ok.entry, width);
    if (sel re.err) { ret re; }
    val lazy_held: opt[Id[Reservation]] = reserved_of(img, f.ok.lazy);
    if (sel lazy_held.some) {
        val jr: err[Fail] = table_entry(img, out, ?tables.DT_JMPREL, f.ok.lazy);
        if (sel jr.err) { ret jr; }
        val lazy: res[u64, Fail] = run_bytes(img, Run.lazy{}, ?PLT_RELOCS);
        if (sel lazy.err) { ret err[Fail].err{lazy.err}; }
        val ps: err[Fail] = entry(out, ?tables.DT_PLTRELSZ, lazy.ok);
        if (sel ps.err) { ret ps; }
        val got: res[opt[u64], Fail] = table_address(img, ?slot.GOT_PLT);
        if (sel got.err)     { ret err[Fail].err{got.err}; }
        if (sel got.ok.none) { ret err[Fail].err{fail.internal("an image binds lazily through no GOT of the PLT")}; }
        val pg: err[Fail] = entry(out, ?tables.DT_PLTGOT, got.ok.some);
        if (sel pg.err) { ret pg; }
        val pr: err[Fail] = entry(out, ?tables.DT_PLTREL, f.ok.table.value);
        if (sel pr.err) { ret pr; }
    }
    val bits: u64 = flags_of(img);
    if (bits != 0) {
        val fl: err[Fail] = entry(out, ?tables.DT_FLAGS, bits);
        if (sel fl.err) { ret fl; }
    }
    if (!output.has(img.kind, output.LOADED)) {
        val d: err[Fail] = entry(out, ?tables.DT_DEBUG, 0);
        if (sel d.err) { ret d; }
        if (output.has(img.kind, output.PIC)) {
            val pie: err[Fail] = entry(out, ?tables.DT_FLAGS_1, tables.DF_1_PIE.value);
            if (sel pie.err) { ret pie; }
        }
    }
    ret entry(out, ?tables.DT_NULL, 0);
}

# the DT_FLAGS bits of the flag rows that hold for the image `img`
fun flags_of(img: *Image) u64 {
    var thread: bool  = false;
    var i:      usize = 0;
    for (i < table.count[Site](?img.sites.list) && !thread) {
        thread = table.at[Site](?img.sites.list, table.nth[Site](i)).thread;
        i      = i + 1;
    }
    var bits: u64 = 0;
    i = 0;
    for (i < FLAG_COUNT) {
        val w: *Flag = ?FLAGS[i];
        i = i + 1;
        if (!rule.holds(?w.output, img.kind.caps)) { cnt; }
        if (sel w.sets.thread && thread)           { bits = bits | w.bit.value; }
    }
    ret bits;
}

# the version tables' entries: the version table, then the definitions and
# their count, then the needs and the count of libraries they name
fun version_entries(img: *Image, p: *Plan, out: *Table[model.Dyn]) err[Fail] {
    if (!holds(p.present, When.version{})) { ret err[Fail].ok{}; }
    val vs: err[Fail] = table_entry(img, out, ?tables.DT_VERSYM, ?VERSYM_PART);
    if (sel vs.err) { ret vs; }
    if (p.present.defines) {
        val d: err[Fail] = table_entry(img, out, ?tables.DT_VERDEF, ?VERDEF_PART);
        if (sel d.err) { ret d; }
        val dn: err[Fail] = entry(out, ?tables.DT_VERDEFNUM, definitions(p)::u64);
        if (sel dn.err) { ret dn; }
    }
    if (!p.present.needs) { ret err[Fail].ok{}; }
    val n: err[Fail] = table_entry(img, out, ?tables.DT_VERNEED, ?VERNEED_PART);
    if (sel n.err) { ret n; }
    ret entry(out, ?tables.DT_VERNEEDNUM, files_needed(p)::u64);
}

# the entry naming the address of the function `w` calls, none when the
# image defines it nowhere: no input defines it, or a library does, whose
# own loader calls its own. one the image defines with no address is
# refused, as the loader calls an address
fun called_entry(img: *Image, w: *Calling, out: *Table[model.Dyn]) err[Fail] {
    if (!rule.holds(?w.called.output, img.kind.caps)) { ret err[Fail].ok{}; }
    val name: str           = w.called.name;
    val nm:   opt[Id[Name]] = intern.find(img.names, name::*u8, str_len(name));
    if (sel nm.none) { ret err[Fail].ok{}; }
    val won: opt[resolve.Won] = resolve.bound(img.resolved, nm.some);
    if (sel won.none) { ret err[Fail].ok{}; }
    val bd: *Binding = won.some.binding;
    if (resolve.library(img.resolved, bd.input)) { ret err[Fail].ok{}; }
    val at: opt[u64] = layout.value_of(img.layout, bd.input, bd.symbol);
    if (sel at.none) { ret err[Fail].err{fail.about(fail.malformed("the function the loader calls by this name has no address in the image"), name)}; }
    ret entry(out, w.tag, at.some);
}

# the address and size of the output section that plays the role of `r`,
# none when no section holding bytes does. two such sections are refused,
# as the dynamic section names one
fun array_entries(img: *Image, r: *Array, out: *Table[model.Dyn]) err[Fail] {
    val l:     *Layout = img.layout;
    var found: *Merged = nil;
    var i:     usize   = 0;
    for (i < table.count[Id[Merged]](?l.order)) {
        val m: *Merged = table.at[Merged](?l.merged, table.items[Id[Merged]](?l.order)[i]);
        i = i + 1;
        if (!section.has(m.kind, r.role) || m.size == 0) { cnt; }
        if (found != nil)                                { ret err[Fail].err{fail.about(fail.unsupported("two output sections hold one kind of the arrays the loader runs, which the dynamic section names once"), r.table.name)}; }
        found = m;
    }
    if (found == nil) { ret err[Fail].ok{}; }
    val a: err[Fail] = entry(out, r.table, found.address);
    if (sel a.err) { ret a; }
    ret entry(out, r.size, found.size);
}

# a dynamic table as the image writer places it: the output section it fills
# alone, and that section's header fields and body
# ---
# part:    the table
# laid:    where layout put it
# type:    its sh_type
# link:    its sh_link
# info:    its sh_info
# linked:  its sh_info is a section index, which SHF_INFO_LINK marks
# entsize: its sh_entsize
# size:    the bytes its body takes
# body:    its body, which the model takes once given
# given:   the model holds the body
pub rec Written {
    part:    *Part;
    laid:    Laid;
    type:    u32;
    link:    u32;
    info:    u32;
    linked:  bool;
    entsize: u64;
    size:    u64;
    body:    Body;
    given:   bool;
}

# the dynamic tables of an image, in the order they are declared
pub rec Tables {
    list: Table[Written];
}

pub fun make_tables(a: *A.Allocator) Tables {
    ret Tables{list: table.make[Written](a)};
}

pub fun release_tables(t: *Tables) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[Written](?t.list)) {
        val w: *Written = table.at[Written](?t.list, table.nth[Written](i));
        if (!w.given) { first = fail.kept(first, model.release_body(?w.body)); }
        i = i + 1;
    }
    ret fail.kept(first, table.release[Written](?t.list));
}

# the dynamic table that fills the output section `id`, none for one that
# holds none
pub fun written_in(t: *Tables, id: Id[Merged]) opt[*Written] {
    var i: usize = 0;
    for (i < table.count[Written](?t.list)) {
        val w: *Written = table.at[Written](?t.list, table.nth[Written](i));
        if (w.laid.merged.index == id.index) { ret opt[*Written].some{w}; }
        i = i + 1;
    }
    ret opt[*Written].none{};
}

# the dynamic table `p` of `t`, refused when the image holds none
pub fun written(t: *Tables, p: *Part) res[*Written, Fail] {
    var i: usize = 0;
    for (i < table.count[Written](?t.list)) {
        val w: *Written = table.at[Written](?t.list, table.nth[Written](i));
        if (w.part == p) { ret res[*Written, Fail].ok{w}; }
        i = i + 1;
    }
    ret res[*Written, Fail].err{fail.about(fail.internal("the image holds no such dynamic table"), p.name)};
}

# the program loader's path, which PT_INTERP locates, none for an image the
# loader does not start
pub fun interp_of(t: *Tables) opt[*Written] {
    val w: res[*Written, Fail] = written(t, ?INTERP_PART);
    if (sel w.err) { ret opt[*Written].none{}; }
    ret opt[*Written].some{w.ok};
}

# the dynamic section, which PT_DYNAMIC locates
pub fun dynamic_of(t: *Tables) res[*Written, Fail] {
    ret written(t, ?DYNAMIC_PART);
}

# build every dynamic table of `img` for the model `m` of the machine `mc`,
# into `out`, each body held until the model takes it
pub fun write(img: *Image, m: *Elf, mc: *Machine, out: *Tables) err[Fail] {
    val c:      *Class    = mc.shape.class;
    val filled: err[Fail] = sites.addressed(img.sites);
    if (sel filled.err) { ret filled; }
    val f: res[*Form, Fail] = form_of(img.relocs);
    if (sel f.err) { ret err[Fail].err{f.err}; }
    var p: Plan      = make_plan(img.inputs.a);
    val r: err[Fail] = plan(img, c, ?p);
    var w: err[Fail] = r;
    if (sel r.ok) { w = bodies(img, m, mc, f.ok, ?p, out); }
    val rel: err[Fail] = release_plan(?p);
    if (sel w.err)   { ret w; }
    if (sel rel.err) { ret rel; }
    ret headers(img, m, c, out);
}

# the body of each dynamic table the image holds
fun bodies(img: *Image, m: *Elf, mc: *Machine, f: *Form, p: *Plan, out: *Tables) err[Fail] {
    var list: [PART_COUNT]*Part;
    val n:    usize = parts(f, p.present, ?list);
    var i:    usize = 0;
    for (i < n) {
        val part: *Part           = list[i];
        val body: res[Body, Fail] = body_of(img, m, mc, f, p, part);
        if (sel body.err) { ret err[Fail].err{fail.in_record(body.err, part.name)}; }
        var b:  Body                   = body.ok;
        val at: res[Id[Written], Fail] = table.push[Written](?out.list, Written{part: part, body: b});
        if (sel at.err) {
            val dropped: err[Fail] = model.release_body(?b);
            ret err[Fail].err{at.err};
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun body_of(img: *Image, m: *Elf, mc: *Machine, f: *Form, p: *Plan, part: *Part) res[Body, Fail] {
    if (part == ?INTERP_PART)   { ret interp_body(img, m, mc); }
    if (part == ?DYNSYM_PART)   { ret symbols_body(img, mc.shape.class, p); }
    if (part == ?DYNSTR_PART)   { ret strings_body(m, mc, p); }
    if (part == ?HASH_PART)     { ret hash_body(img, p); }
    if (part == ?GNU_HASH_PART) { ret gnu_hash_body(img, mc.shape.class, p); }
    if (part == ?VERSYM_PART)   { ret versym_body(img, p); }
    if (part == ?VERDEF_PART)   { ret verdef_body(img, p); }
    if (part == ?VERNEED_PART)  { ret verneed_body(img, p); }
    if (part == f.part)         { ret relocs_body(img, mc, f, p, Run.loader{}); }
    if (part == f.lazy)         { ret relocs_body(img, mc, f, p, Run.lazy{}); }
    if (part == ?DYNAMIC_PART)  { ret dynamic_body(img, mc.shape.class, p); }
    ret res[Body, Fail].err{fail.internal("no dynamic table is made this way")};
}

# the section header fields of each dynamic table, refused for one that does
# not fill its output section alone
fun headers(img: *Image, m: *Elf, c: *Class, out: *Tables) err[Fail] {
    val l: *Layout = img.layout;
    var i: usize   = 0;
    for (i < table.count[Written](?out.list)) {
        val w:  *Written        = table.at[Written](?out.list, table.nth[Written](i));
        val at: res[Laid, Fail] = laid(img, w.part);
        if (sel at.err) { ret err[Fail].err{at.err}; }
        w.laid = at.ok;
        val sz: res[u64, Fail] = size_of_body(m, c, w);
        if (sel sz.err) { ret err[Fail].err{fail.in_record(sz.err, w.part.name)}; }
        w.size = sz.ok;
        val into: *Merged = table.at[Merged](?l.merged, at.ok.merged);
        if (at.ok.offset != 0 || into.size != w.size) { ret err[Fail].err{fail.about(fail.internal("a dynamic table does not fill its output section alone"), w.part.name)}; }
        w.type    = w.part.type.value::u32;
        w.entsize = width_of(c, w.part);
        if (w.part.locals)  { w.info = 1; }
        if (w.part.counted) { w.info = records_of(?w.body); }
        val applies: opt[*SlotRole] = w.part.applies;
        if (sel applies.some) {
            val ix: res[u32, Fail] = table_index(img, applies.some);
            if (sel ix.err) { ret err[Fail].err{fail.in_record(ix.err, w.part.name)}; }
            w.info   = ix.ok;
            w.linked = true;
        }
        if (w.part.link != nil) {
            val to: res[*Written, Fail] = written(out, w.part.link);
            if (sel to.err) { ret err[Fail].err{to.err}; }
            val ix: res[u32, Fail] = index_of(l, to.ok.part, img);
            if (sel ix.err) { ret err[Fail].err{ix.err}; }
            w.link = ix.ok;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the section index of the output section the dynamic table `p` fills
fun index_of(l: *Layout, p: *Part, img: *Image) res[u32, Fail] {
    val at: res[Laid, Fail] = laid(img, p);
    if (sel at.err) { ret res[u32, Fail].err{at.err}; }
    val ix: opt[u64] = layout.section_index(l, at.ok.merged);
    if (sel ix.none)           { ret res[u32, Fail].err{fail.internal("layout numbers no output section")}; }
    if (ix.some > 0xffff_ffff) { ret res[u32, Fail].err{fail.overflow("a section index passes 32 bits")}; }
    ret res[u32, Fail].ok{ix.some::u32};
}

# the section index of the output section holding the table the format's
# row for role `r` laid
fun table_index(img: *Image, r: *SlotRole) res[u32, Fail] {
    val t: opt[Id[Reservation]] = img.reserved.held[r.at::usize];
    if (sel t.none) { ret res[u32, Fail].err{fail.about(fail.internal("the table relocations apply to was not laid"), r.name)}; }
    val p: res[Position, Fail] = layout.table_position(img.layout, t.some);
    if (sel p.err) { ret res[u32, Fail].err{p.err}; }
    val ix: opt[u64] = layout.section_index(img.layout, p.ok.merged);
    if (sel ix.none)           { ret res[u32, Fail].err{fail.internal("layout numbers no output section")}; }
    if (ix.some > 0xffff_ffff) { ret res[u32, Fail].err{fail.overflow("a section index passes 32 bits")}; }
    ret res[u32, Fail].ok{ix.some::u32};
}

# the bytes the body of `w` takes, as the measure of its table sized it
fun size_of_body(m: *Elf, c: *Class, w: *Written) res[u64, Fail] {
    val at: Location = Location{record: w.part.name};
    val b:  *Body    = ?w.body;
    if (sel b.raw)     { ret res[u64, Fail].ok{model.bytes(m, ?b.raw.bytes).len::u64}; }
    if (sel b.symbols) { ret checked.mul(at, table.count[model.Symbol](?b.symbols)::u64, c.symbol.size::u64); }
    if (sel b.rela)    { ret checked.mul(at, table.count[model.Rela](?b.rela)::u64, c.rela.size::u64); }
    if (sel b.rel)     { ret checked.mul(at, table.count[model.Rel](?b.rel)::u64, c.rel.size::u64); }
    if (sel b.dynamic) { ret checked.mul(at, table.count[model.Dyn](?b.dynamic)::u64, c.dyn.size::u64); }
    if (sel b.hash)    { ret checked.mul(at, (table.count[u32](?b.hash.buckets) + table.count[u32](?b.hash.chains) + 2)::u64, model.WORD::u64); }
    if (sel b.versym)  { ret checked.mul(at, table.count[u16](?b.versym)::u64, model.HALF::u64); }
    if (sel b.verdef) {
        val heads: u64 = records_of(b)::u64;
        val names: u64 = table.count[model.Definition](?b.verdef)::u64 - heads;
        ret checked.add(at, heads * model.VERDEF.size::u64, names * model.VERDAUX.size::u64);
    }
    if (sel b.verneed) {
        val heads: u64 = records_of(b)::u64;
        val names: u64 = table.count[model.Need](?b.verneed)::u64 - heads;
        ret checked.add(at, heads * model.VERNEED.size::u64, names * model.VERNAUX.size::u64);
    }
    if (sel b.gnu_hash) {
        val bloom: res[u64, Fail] = checked.mul(at, table.count[u64](?b.gnu_hash.bloom)::u64, c.addr::u64);
        if (sel bloom.err) { ret bloom; }
        val words: res[u64, Fail] = checked.mul(at, (table.count[u32](?b.gnu_hash.buckets) + table.count[u32](?b.gnu_hash.chain))::u64, model.WORD::u64);
        if (sel words.err) { ret words; }
        ret checked.add(at, 16 + bloom.ok, words.ok);
    }
    ret res[u64, Fail].err{fail.internal("a dynamic table has a body of no size")};
}

# how many version definitions or needs `b` holds, their names apart
fun records_of(b: *Body) u32 {
    var n: u32   = 0;
    var i: usize = 0;
    if (sel b.verdef) {
        for (i < table.count[model.Definition](?b.verdef)) {
            val e: *model.Definition = table.at[model.Definition](?b.verdef, table.nth[model.Definition](i));
            if (sel e.verdef) { n = n + 1; }
            i = i + 1;
        }
    }
    or (sel b.verneed) {
        for (i < table.count[model.Need](?b.verneed)) {
            val e: *model.Need = table.at[model.Need](?b.verneed, table.nth[model.Need](i));
            if (sel e.verneed) { n = n + 1; }
            i = i + 1;
        }
    }
    ret n;
}

# the version entry of the null symbol, which is local, then each dynamic
# symbol's
fun versym_body(img: *Image, p: *Plan) res[Body, Fail] {
    var t: Table[u16]         = table.make[u16](img.inputs.a);
    val z: res[Id[u16], Fail] = table.push[u16](?t, tables.VER_NDX_LOCAL.value::u16);
    var r: err[Fail]          = err[Fail].ok{};
    if (sel z.err) { r = err[Fail].err{z.err}; }
    or (table.count[u16](?p.versions) != 0) {
        val e: res[Id[u16], Fail] = table.extend[u16](?t, table.items[u16](?p.versions), table.count[u16](?p.versions));
        if (sel e.err) { r = err[Fail].err{e.err}; }
    }
    if (sel r.err) {
        val dropped: err[Fail] = table.release[u16](?t);
        ret res[Body, Fail].err{r.err};
    }
    ret res[Body, Fail].ok{Body.versym{t}};
}

# the base version, named as the library is known, then each version the
# image defines, each followed by its name
fun verdef_body(img: *Image, p: *Plan) res[Body, Fail] {
    var t: Table[model.Definition] = table.make[model.Definition](img.inputs.a);
    val r: err[Fail]               = verdef_into(img, p, ?t);
    if (sel r.err) {
        val dropped: err[Fail] = table.release[model.Definition](?t);
        ret res[Body, Fail].err{r.err};
    }
    ret res[Body, Fail].ok{Body.verdef{t}};
}

fun verdef_into(img: *Image, p: *Plan, t: *Table[model.Definition]) err[Fail] {
    val so: opt[Id[Name]] = p.soname;
    if (sel so.none) { ret err[Fail].err{fail.internal("an image that defines versions names no base version")}; }
    val base: res[View, Fail] = soname_of(img);
    if (sel base.err) { ret err[Fail].err{base.err}; }
    val count: usize = definitions(p);
    var i:     usize = 0;
    for (i < count) {
        var flags: u16      = 0;
        var name:  Id[Name] = so.some;
        var hash:  u32      = 0;
        if (i == 0) {
            flags = tables.VER_FLG_BASE.value::u16;
            hash  = sysv_hash(base.ok);
        }
        or {
            val e: *Defined = table.at[Defined](?p.defined, table.nth[Defined](i - 1));
            name = e.string;
            hash = sysv_hash(intern.bytes_of(img.names, e.name));
        }
        val at: res[u32, Fail] = string_offset(p, name);
        if (sel at.err) { ret err[Fail].err{at.err}; }
        var next: u32 = 0;
        if (i + 1 < count) { next = (model.VERDEF.size + model.VERDAUX.size)::u32; }
        val d: res[Id[model.Definition], Fail] = table.push[model.Definition](t, model.Definition.verdef{model.Verdef{version: tables.VER_DEF_CURRENT.value::u16, flags: flags, ndx: (i + 1)::u16, cnt: 1, hash: hash, aux: model.VERDEF.size::u32, next: next}});
        if (sel d.err) { ret err[Fail].err{d.err}; }
        val a: res[Id[model.Definition], Fail] = table.push[model.Definition](t, model.Definition.verdaux{model.Verdaux{name: at.ok, next: 0}});
        if (sel a.err) { ret err[Fail].err{a.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# for each library the image needs a version of, in the order it loads them,
# a need naming the library, followed by each version it needs
fun verneed_body(img: *Image, p: *Plan) res[Body, Fail] {
    var t: Table[model.Need] = table.make[model.Need](img.inputs.a);
    val r: err[Fail]         = verneed_into(img, p, ?t);
    if (sel r.err) {
        val dropped: err[Fail] = table.release[model.Need](?t);
        ret res[Body, Fail].err{r.err};
    }
    ret res[Body, Fail].ok{Body.verneed{t}};
}

fun verneed_into(img: *Image, p: *Plan, t: *Table[model.Need]) err[Fail] {
    var left: usize = files_needed(p);
    var i:    usize = 0;
    for (i < table.count[u32](?p.heads)) {
        val head: u32 = table.items[u32](?p.heads)[i];
        i = i + 1;
        if (head == 0) { cnt; }
        left = left - 1;
        var cnt: u64 = 0;
        var k:   u32 = head;
        for (k != 0) {
            cnt = cnt + 1;
            k   = table.at[Needed](?p.needed, table.nth[Needed]((k - 1)::usize)).next;
        }
        if (cnt > 0xffff) { ret err[Fail].err{fail.in_indexed(fail.overflow("a library is needed at more versions than a need counts"), "library", (i - 1)::u64)}; }
        val file: res[u32, Fail] = string_offset(p, table.items[Id[Name]](?p.names)[i - 1]);
        if (sel file.err) { ret err[Fail].err{file.err}; }
        var next: u32 = 0;
        if (left != 0) { next = (model.VERNEED.size::u64 + cnt * model.VERNAUX.size::u64)::u32; }
        val n: res[Id[model.Need], Fail] = table.push[model.Need](t, model.Need.verneed{model.Verneed{version: tables.VER_NEED_CURRENT.value::u16, cnt: cnt::u16, file: file.ok, aux: model.VERNEED.size::u32, next: next}});
        if (sel n.err) { ret err[Fail].err{n.err}; }
        k = head;
        for (k != 0) {
            val e:  *Needed        = table.at[Needed](?p.needed, table.nth[Needed]((k - 1)::usize));
            val at: res[u32, Fail] = string_offset(p, e.string);
            if (sel at.err) { ret err[Fail].err{at.err}; }
            k = e.next;
            var after: u32 = 0;
            if (k != 0) { after = model.VERNAUX.size::u32; }
            val a: res[Id[model.Need], Fail] = table.push[model.Need](t, model.Need.vernaux{model.Vernaux{hash: sysv_hash(intern.bytes_of(img.names, e.name)), other: e.index, name: at.ok, next: after}});
            if (sel a.err) { ret err[Fail].err{a.err}; }
        }
    }
    ret err[Fail].ok{};
}

# the bytes `n` at `data` and a NUL, held by the model
fun held(m: *Elf, mc: *Machine, data: *u8, n: usize) res[Body, Fail] {
    var s: Sink      = sink.make(m.a, mc.shape.order);
    val w: err[Fail] = sink.bytes(?s, data, n);
    var z: err[Fail] = w;
    if (sel w.ok) { z = sink.u8(?s, 0); }
    var h: res[Held, Fail] = res[Held, Fail].err{fail.internal("a dynamic table's bytes were not held")};
    if (sel z.err) { h = res[Held, Fail].err{z.err}; }
    or             { h = model.own(m, sink.data(?s), sink.len(?s)); }
    val rel: err[Fail] = sink.release(?s);
    if (sel h.err)   { ret res[Body, Fail].err{h.err}; }
    if (sel rel.err) { ret res[Body, Fail].err{rel.err}; }
    ret res[Body, Fail].ok{Body.raw{Raw{bytes: h.ok, why: Why.opaque{}}}};
}

fun interp_body(img: *Image, m: *Elf, mc: *Machine) res[Body, Fail] {
    val path: res[str, Fail] = interpreter(img.host);
    if (sel path.err) { ret res[Body, Fail].err{path.err}; }
    ret held(m, mc, path.ok::*u8, str_len(path.ok));
}

fun strings_body(m: *Elf, mc: *Machine, p: *Plan) res[Body, Fail] {
    var s: Sink            = sink.make(m.a, mc.shape.order);
    val w: err[Fail]       = strtab.write(?p.strings, ?s);
    var h: res[Held, Fail] = res[Held, Fail].err{fail.internal("the dynamic strings were not held")};
    if (sel w.err) { h = res[Held, Fail].err{w.err}; }
    or             { h = model.own(m, sink.data(?s), sink.len(?s)); }
    val rel: err[Fail] = sink.release(?s);
    if (sel h.err)   { ret res[Body, Fail].err{h.err}; }
    if (sel rel.err) { ret res[Body, Fail].err{rel.err}; }
    ret res[Body, Fail].ok{Body.raw{Raw{bytes: h.ok, why: Why.opaque{}}}};
}

# the null symbol, then each dynamic symbol of the plan
fun symbols_body(img: *Image, c: *Class, p: *Plan) res[Body, Fail] {
    var t: Table[model.Symbol] = table.make[model.Symbol](img.inputs.a);
    val r: err[Fail]           = symbols_into(img, p, ?t);
    if (sel r.err) {
        val dropped: err[Fail] = table.release[model.Symbol](?t);
        ret res[Body, Fail].err{r.err};
    }
    ret res[Body, Fail].ok{Body.symbols{t}};
}

fun symbols_into(img: *Image, p: *Plan, t: *Table[model.Symbol]) err[Fail] {
    val z: res[Id[model.Symbol], Fail] = table.push[model.Symbol](t, model.Symbol{});
    if (sel z.err) { ret err[Fail].err{z.err}; }
    val first: usize = table.count[Id[Name]](?p.libraries);
    var i:     usize = 0;
    for (i < table.count[Dynsym](?p.symbols)) {
        val s: *Dynsym                 = table.at[Dynsym](?p.symbols, table.nth[Dynsym](i));
        val y: res[model.Symbol, Fail] = symbol_of(img, p, s);
        if (sel y.err) { ret err[Fail].err{fail.in_indexed(y.err, "dynamic symbol", (i + 1)::u64)}; }
        val at: res[u32, Fail] = string_offset(p, table.items[Id[Name]](?p.names)[first + i]);
        if (sel at.err) { ret err[Fail].err{at.err}; }
        var e: model.Symbol = y.ok;
        e.name = at.ok;
        val pushed: res[Id[model.Symbol], Fail] = table.push[model.Symbol](t, e);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the symbol record of `s` of the plan `p`, its name left to the caller: an
# import undefined, weak where every reference to it is, of its library's
# symbol's kind, valued at the entry the image names it at, a name
# nothing defines undefined and weak, and an export in its output section at
# the value its kind's value row writes
fun symbol_of(img: *Image, p: *Plan, s: *Dynsym) res[model.Symbol, Fail] {
    val f:     From         = s.from;
    var undef: model.Symbol = model.Symbol{shndx: tables.SHN_UNDEF.value::u16};
    if (sel f.imported) {
        val d:    *dynamic.Dynamic = img.dynamic;
        val im:   *Import          = table.at[Import](?d.imports, f.imported);
        val off:  *Offer           = table.at[Offer](?d.offers, im.offer);
        val sym:  *Symbol          = object.symbol_at(input.object_of(img.inputs, off.input), off.symbol);
        var bind: *symbol.Binding  = ?symbol.GLOBAL;
        if (im.weak) { bind = ?symbol.WEAKLY; }
        val codes: res[Coded, Fail] = elf_neutral.symbol_codes(bind, sym.kind, ?symbol.DEFAULT);
        if (sel codes.err) { ret res[model.Symbol, Fail].err{codes.err}; }
        undef.info  = codes.ok.info;
        undef.other = codes.ok.other;
        val named: Addressed = table.items[Addressed](?p.addressed)[f.imported.index::usize];
        if (named.at != 0) {
            val at: res[u64, Fail] = layout.slot_address(img.layout, img.reserved, named.role, named.at - 1);
            if (sel at.err) { ret res[model.Symbol, Fail].err{at.err}; }
            undef.value = at.ok;
        }
        ret res[model.Symbol, Fail].ok{undef};
    }
    or (sel f.absent) {
        val codes: res[Coded, Fail] = elf_neutral.symbol_codes(?symbol.WEAKLY, ?symbol.NOTYPE, ?symbol.DEFAULT);
        if (sel codes.err) { ret res[model.Symbol, Fail].err{codes.err}; }
        undef.info  = codes.ok.info;
        undef.other = codes.ok.other;
        ret res[model.Symbol, Fail].ok{undef};
    }
    or (sel f.copied) {
        ret copy_symbol(img, f.copied);
    }
    val e:   *Export  = table.at[Export](?img.dynamic.exports, f.exported);
    val bd:  *Binding = table.at[Binding](?img.resolved.bindings, e.binding);
    val sym: *Symbol  = object.symbol_at(input.object_of(img.inputs, bd.input), bd.symbol);
    val at:  opt[u64] = layout.value_of(img.layout, bd.input, bd.symbol);
    if (sel at.none) { ret res[model.Symbol, Fail].err{fail.internal("an export has no value in the image")}; }
    val value: res[u64, Fail] = symbol_value(img.layout, sym, at.some);
    if (sel value.err) { ret res[model.Symbol, Fail].err{value.err}; }
    val codes: res[Coded, Fail] = elf_neutral.symbol_codes(sym.binding, sym.kind, bd.visibility);
    if (sel codes.err) { ret res[model.Symbol, Fail].err{codes.err}; }
    val index: res[Index, Fail] = symbol_index(img.layout, sym, bd.input);
    if (sel index.err) { ret res[model.Symbol, Fail].err{index.err}; }
    var out: model.Symbol = model.Symbol{info: codes.ok.info, other: codes.ok.other, value: value.ok};
    if (sel sym.size.some) { out.bytes = sym.size.some; }
    val ix: Index = index.ok;
    if (sel ix.reserved) { out.shndx = ix.reserved; }
    or (sel ix.section) {
        if (ix.section >= tables.SHN_LORESERVE.value::u32) { ret res[model.Symbol, Fail].err{fail.unsupported("a dynamic symbol's section index needs extended numbering, which the dynamic symbols do not hold")}; }
        out.shndx = ix.section::u16;
    }
    ret res[model.Symbol, Fail].ok{out};
}

# the symbol of an import the image keeps a copy of: global, of its
# library's symbol's kind and size, defined at the copy
fun copy_symbol(img: *Image, k: Copied) res[model.Symbol, Fail] {
    val d:   *dynamic.Dynamic    = img.dynamic;
    val im:  *Import             = table.at[Import](?d.imports, k.import);
    val off: *Offer              = table.at[Offer](?d.offers, im.offer);
    val sym: *Symbol             = object.symbol_at(input.object_of(img.inputs, off.input), off.symbol);
    val at:  res[Position, Fail] = layout.slot_position(img.layout, img.reserved, ?slot.COPY, k.slot);
    if (sel at.err) { ret res[model.Symbol, Fail].err{at.err}; }
    val ix: opt[u64] = layout.section_index(img.layout, at.ok.merged);
    if (sel ix.none)                           { ret res[model.Symbol, Fail].err{fail.internal("layout numbers no output section")}; }
    if (ix.some >= tables.SHN_LORESERVE.value) { ret res[model.Symbol, Fail].err{fail.unsupported("a dynamic symbol's section index needs extended numbering, which the dynamic symbols do not hold")}; }
    val codes: res[Coded, Fail] = elf_neutral.symbol_codes(?symbol.GLOBAL, sym.kind, ?symbol.DEFAULT);
    if (sel codes.err) { ret res[model.Symbol, Fail].err{codes.err}; }
    var out: model.Symbol = model.Symbol{info: codes.ok.info, other: codes.ok.other, value: at.ok.address, shndx: ix.some::u16};
    if (sel sym.size.some) { out.bytes = sym.size.some; }
    ret res[model.Symbol, Fail].ok{out};
}

# the index of the section a symbol's value lies in, or the reserved index
# of an absolute one
pub fun symbol_index(l: *Layout, s: *Symbol, in: Id[input.Input]) res[Index, Fail] {
    val d: Definition = s.def;
    if (sel d.absolute) { ret res[Index, Fail].ok{Index.reserved{tables.SHN_ABS.value::u16}}; }
    var merged: opt[Id[Merged]] = opt[Id[Merged]].none{};
    if (sel d.placed) {
        val g: opt[Id[Landing]] = layout.landing_of(l, Ref{input: in, section: d.placed.section});
        if (sel g.some) { merged = opt[Id[Merged]].some{table.at[Landing](?l.landings, g.some).merged}; }
    }
    if (sel merged.none) { ret res[Index, Fail].err{fail.internal("a symbol with a value lies in no output section")}; }
    val at: opt[u64] = layout.section_index(l, merged.some);
    if (sel at.none)           { ret res[Index, Fail].err{fail.internal("layout numbers no output section")}; }
    if (at.some > 0xffff_ffff) { ret res[Index, Fail].err{fail.overflow("a section index passes 32 bits")}; }
    ret res[Index, Fail].ok{Index.section{at.some::u32}};
}

# the value an image writes for the symbol `s` that layout put at `at`, by
# the value row of its kind
pub fun symbol_value(l: *Layout, s: *Symbol, at: u64) res[u64, Fail] {
    var row: *Valued = nil;
    var i:   usize   = 0;
    for (i < VALUED_COUNT) {
        if (rule.holds(?VALUED[i].kind, s.kind.caps)) { row = ?VALUED[i]; }
        i = i + 1;
    }
    if (row == nil) { ret res[u64, Fail].err{fail.internal("no value row writes a symbol of its kind")}; }
    val o: Origin = row.origin;
    if (sel o.block) { ret layout.block_offset(l, at); }
    ret res[u64, Fail].ok{at};
}

# the SysV hash table: a bucket and a chain per dynamic symbol
fun hash_body(img: *Image, p: *Plan) res[Body, Fail] {
    var h: model.Hash = model.Hash{buckets: table.make[u32](img.inputs.a), chains: table.make[u32](img.inputs.a)};
    val r: err[Fail]  = hash_into(img, p, ?h);
    if (sel r.err) {
        var b:       Body      = Body.hash{h};
        val dropped: err[Fail] = model.release_body(?b);
        ret res[Body, Fail].err{r.err};
    }
    ret res[Body, Fail].ok{Body.hash{h}};
}

fun hash_into(img: *Image, p: *Plan, h: *model.Hash) err[Fail] {
    val n:  usize              = symbol_count(p)::usize;
    val gb: res[Id[u32], Fail] = table.grow[u32](?h.buckets, n);
    if (sel gb.err) { ret err[Fail].err{gb.err}; }
    val gc: res[Id[u32], Fail] = table.grow[u32](?h.chains, n);
    if (sel gc.err) { ret err[Fail].err{gc.err}; }
    val buckets: *u32  = table.items[u32](?h.buckets);
    val chains:  *u32  = table.items[u32](?h.chains);
    var i:       usize = 1;
    for (i < n) {
        val k: u32 = sysv_hash(intern.bytes_of(img.names, table.items[Dynsym](?p.symbols)[i - 1].name)) % n::u32;
        chains[i]  = buckets[k];
        buckets[k] = i::u32;
        i          = i + 1;
    }
    ret err[Fail].ok{};
}

# the GNU hash table over the hashed symbols that end the dynamic symbols
fun gnu_hash_body(img: *Image, c: *Class, p: *Plan) res[Body, Fail] {
    var g: model.GnuHash = model.GnuHash{shift: SHIFT2, bloom: table.make[u64](img.inputs.a), buckets: table.make[u32](img.inputs.a), chain: table.make[u32](img.inputs.a)};
    val r: err[Fail]     = gnu_hash_into(c, p, ?g);
    if (sel r.err) {
        var b:       Body      = Body.gnu_hash{g};
        val dropped: err[Fail] = model.release_body(?b);
        ret res[Body, Fail].err{r.err};
    }
    ret res[Body, Fail].ok{Body.gnu_hash{g}};
}

fun gnu_hash_into(c: *Class, p: *Plan, g: *model.GnuHash) err[Fail] {
    val n:     usize = p.hashed::usize;
    val first: usize = table.count[Dynsym](?p.symbols) - n;
    g.symoffset = (first + 1)::u32;
    val gw: res[Id[u64], Fail] = table.grow[u64](?g.bloom, p.words::usize);
    if (sel gw.err) { ret err[Fail].err{gw.err}; }
    val gb: res[Id[u32], Fail] = table.grow[u32](?g.buckets, p.buckets::usize);
    if (sel gb.err) { ret err[Fail].err{gb.err}; }
    if (n != 0) {
        val gc: res[Id[u32], Fail] = table.grow[u32](?g.chain, n);
        if (sel gc.err) { ret err[Fail].err{gc.err}; }
    }
    val bits:  u32     = (c.addr * 8)::u32;
    val syms:  *Dynsym = table.items[Dynsym](?p.symbols);
    val bloom: *u64    = table.items[u64](?g.bloom);
    var k:     usize   = 0;
    for (k < n) {
        val s:    *Dynsym = ?syms[first + k];
        val word: usize   = ((s.hash / bits) & (p.words - 1))::usize;
        bloom[word] = bloom[word] | (1u64 << (s.hash % bits)::u64) | (1u64 << ((s.hash >> SHIFT2) % bits)::u64);
        val last: bool = k + 1 == n || syms[first + k + 1].bucket != s.bucket;
        if (last)                                               { table.items[u32](?g.chain)[k] = s.hash | 1; }
        or                                                      { table.items[u32](?g.chain)[k] = s.hash & ~1u32; }
        if (table.items[u32](?g.buckets)[s.bucket::usize] == 0) { table.items[u32](?g.buckets)[s.bucket::usize] = (first + 1 + k)::u32; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the dynamic section's entries
fun dynamic_body(img: *Image, c: *Class, p: *Plan) res[Body, Fail] {
    var t: Table[model.Dyn] = table.make[model.Dyn](img.inputs.a);
    val r: err[Fail]        = entries(img, c, p, ?t);
    if (sel r.err) {
        val dropped: err[Fail] = table.release[model.Dyn](?t);
        ret res[Body, Fail].err{r.err};
    }
    ret res[Body, Fail].ok{Body.dynamic{t}};
}

# a relocation for each loader relocation site of the run `run`, in the
# order of the sites
fun relocs_body(img: *Image, mc: *Machine, f: *Form, p: *Plan, run: Run) res[Body, Fail] {
    if (f.record) {
        var rela: Table[model.Rela] = table.make[model.Rela](img.inputs.a);
        val r:    err[Fail]         = relocs_into(img, mc, f, p, run, ?rela, nil);
        if (sel r.err) {
            val dropped: err[Fail] = table.release[model.Rela](?rela);
            ret res[Body, Fail].err{r.err};
        }
        ret res[Body, Fail].ok{Body.rela{rela}};
    }
    var rel: Table[model.Rel] = table.make[model.Rel](img.inputs.a);
    val r:   err[Fail]        = relocs_into(img, mc, f, p, run, nil, ?rel);
    if (sel r.err) {
        val dropped: err[Fail] = table.release[model.Rel](?rel);
        ret res[Body, Fail].err{r.err};
    }
    ret res[Body, Fail].ok{Body.rel{rel}};
}

fun relocs_into(img: *Image, mc: *Machine, f: *Form, p: *Plan, run: Run, rela: *Table[model.Rela], rel: *Table[model.Rel]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Site](?img.sites.list)) {
        val s:  *Site              = table.at[Site](?img.sites.list, table.nth[Site](i));
        val ld: res[*Loader, Fail] = loader_of(s, mc.shape.class.addr::u64);
        if (sel ld.err) { ret err[Fail].err{fail.in_indexed(ld.err, "loader relocation site", i::u64)}; }
        i = i + 1;
        if (!same_run(ld.ok.run, run)) { cnt; }
        val e: err[Fail] = reloc_of(img, mc, f, p, s, ld.ok, rela, rel);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "loader relocation site", (i - 1)::u64)}; }
    }
    ret err[Fail].ok{};
}

# the dynamic row of the site `s`: the one of its place's slot role and the
# word of its slot it is, the image's addresses `addr` bytes, or of a
# relocation's field, and of what the loader does there
fun loader_of(s: *Site, addr: u64) res[*Loader, Fail] {
    val place:  sites.Place = s.place;
    var role:   *SlotRole   = nil;
    var within: u64         = 0;
    if (sel place.slotted) {
        role   = place.slotted.role;
        within = place.slotted.within;
    }
    val act: Act   = act_of(s);
    var i:   usize = 0;
    for (i < LOADER_COUNT) {
        val w:  *Loader        = ?LOADERS[i];
        val at: opt[*SlotRole] = w.role;
        i = i + 1;
        if (!same_act(w.act, act) || w.word::u64 * addr != within) { cnt; }
        if (sel at.none) {
            if (role == nil) { ret res[*Loader, Fail].ok{w}; }
            cnt;
        }
        if (at.some == role) { ret res[*Loader, Fail].ok{w}; }
    }
    if (role != nil) { ret res[*Loader, Fail].err{fail.about(fail.unsupported("no ELF dynamic row writes a loader relocation site of this slot role"), role.name)}; }
    ret res[*Loader, Fail].err{fail.internal("no dynamic row writes a loader relocation site")};
}

# the relocation of the site `s`, of the dynamic row `ld`, into `rela` or
# `rel` as `f` keeps addends. a rebase holds the word the link wrote at the
# site as its addend, the address it moves
fun reloc_of(img: *Image, mc: *Machine, f: *Form, p: *Plan, s: *Site, ld: *Loader, rela: *Table[model.Rela], rel: *Table[model.Rel]) err[Fail] {
    val c:     *Class      = mc.shape.class;
    val place: sites.Place = s.place;
    var own:   *Reloc      = nil;
    if (sel place.patched) { own = table.at[Reloc](?input.object_of(img.inputs, place.patched.input).relocs, place.patched.reloc); }
    val applied: Applied = ld.applied;
    var kind:    *Kind   = nil;
    if (sel applied.kind) { kind = applied.kind; }
    or (sel applied.words) {
        if (c.addr == 4) { kind = applied.words.word32; }
        or (c.addr == 8) { kind = applied.words.word64; }
        or               { ret err[Fail].err{fail.internal("a loader relocation is chosen by an address width no class has")}; }
    }
    or {
        if (own == nil) { ret err[Fail].err{fail.internal("a slot takes the relocation of no field")}; }
        kind = own.kind;
    }
    val w: res[*row.Row, Fail] = row.writing(img.relocs, kind);
    if (sel w.err) { ret err[Fail].err{w.err}; }
    val a: row.Addend = w.ok.addend;
    if ((sel a.record) != f.record) { ret err[Fail].err{fail.about(fail.unsupported("a loader relocation keeps its addend other than the image's relocation table does"), w.ok.name)}; }
    var sym: u32 = 0;
    if (sel s.kind.bind) {
        val at: res[u32, Fail] = symbol_at(p, s.aim);
        if (sel at.err) { ret err[Fail].err{at.err}; }
        sym = at.ok;
    }
    if ((sym::u64 >> (c.addr::u64 * 8 - c.info_shift::u64)) != 0) { ret err[Fail].err{fail.overflow("a dynamic symbol's index passes a relocation's info")}; }
    val info: u64 = model.reloc_info(c, sym::u64, w.ok.key::u64);
    if (!f.record) {
        val pr: res[Id[model.Rel], Fail] = table.push[model.Rel](rel, model.Rel{offset: s.address, info: info});
        if (sel pr.err) { ret err[Fail].err{pr.err}; }
        ret err[Fail].ok{};
    }
    var addend: i64 = 0;
    if (sel s.kind.rebase) {
        val v: res[u64, Fail] = word_at(img, mc, s, ld.held::u64 * c.addr::u64);
        if (sel v.err) { ret err[Fail].err{v.err}; }
        addend = v.ok:~i64;
    }
    or (own != nil) {
        addend = own.addend;
    }
    val pa: res[Id[model.Rela], Fail] = table.push[model.Rela](rela, model.Rela{offset: s.address, info: info, addend: addend});
    if (sel pa.err) { ret err[Fail].err{pa.err}; }
    ret err[Fail].ok{};
}

# the index of the dynamic symbol a bind aims at
fun symbol_at(p: *Plan, aim: Aim) res[u32, Fail] {
    var at: u32 = 0;
    if (sel aim.imported) { at = table.items[u32](?p.imports)[aim.imported.index::usize]; }
    or (sel aim.absent)   { at = table.items[u32](?p.absent)[aim.absent.index::usize]; }
    or (sel aim.bound) {
        if (aim.bound.index::usize < table.count[u32](?p.exported)) { at = table.items[u32](?p.exported)[aim.bound.index::usize]; }
        if (at == 0)                                                { ret res[u32, Fail].err{fail.internal("a site binds a definition the image does not export")}; }
    }
    or           { ret res[u32, Fail].err{fail.internal("a site binds what has no dynamic symbol")}; }
    if (at == 0) { ret res[u32, Fail].err{fail.internal("a site binds a name that has no dynamic symbol")}; }
    ret res[u32, Fail].ok{at};
}

# the address word the link wrote `past` bytes after the site `s`, which the
# loader moves or reads as its addend
fun word_at(img: *Image, mc: *Machine, s: *Site, past: u64) res[u64, Fail] {
    val pos: res[Position, Fail] = sites.position(img.layout, img.pieces, img.reserved, s);
    if (sel pos.err) { ret res[u64, Fail].err{pos.err}; }
    val bytes: *Table[u8]       = ?img.relocated.bytes;
    var r:     Reader           = reader.make("relocated image", table.items[u8](bytes), table.count[u8](bytes), mc.shape.order);
    val at:    res[usize, Fail] = reader.seek(?r, pos.ok.file + past);
    if (sel at.err) { ret res[u64, Fail].err{fail.internal("a loader relocation site lies past the relocated bytes")}; }
    val v: res[u64, Fail] = reader.uint(?r, mc.shape.class.addr);
    if (sel v.err) { ret res[u64, Fail].err{fail.internal("a loader relocation site lies past the relocated bytes")}; }
    ret v;
}
