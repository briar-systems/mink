# the traits a section of an ELF object holds, raised from its bytes
#
# a producer that writes a section the format holds the traits of, as an
# assembler does from directives that spell the GNU property note or the
# build attributes, learns the traits the bytes encode through the parser and
# the rows the reader decodes the section with. the reader keeps what no row
# maps as a fact or the section's bytes, and a producer's object holds no such
# fact, so here a property, a bit or an attribute no row maps is refused by
# name. a section states only what it holds: of an axis with an encoding in
# another section, as AArch64 states branch protection in both, it states only
# its own, and reconciling the two is the reader's.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_len;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.reader;
use mink.bytes.reader.Reader;
use mink.catalog.arch.Arch;
use mink.catalog.trait.Trait;
use mink.format.contract;
use mink.format.contract.Reading;
use mink.format.elf.model.model;
use mink.format.elf.model.model.Body;
use mink.format.elf.model.model.Note;
use mink.format.elf.model.model.Shape;
use mink.format.elf.read;
use mink.format.elf.rules.attributes;
use mink.format.elf.rules.attributes.Attribute;
use mink.format.elf.rules.attributes.Part;
use mink.format.elf.rules.property;
use mink.format.elf.rules.traits;
use mink.format.elf.rules.traits.Machine;
use mink.format.elf.rules.traits.PROPERTY_SECTION;
use mink.format.elf.rules.traits.Unread;
use mink.format.elf.rules.traits.Word;
use mink.format.elf.rules.traits.Words;

# state on `out` the traits of an object for `a` the section named `name`
# holds in `data`: the GNU property note or the architecture's build
# attributes section, laid out as an object for `a` lays them out. a section
# that holds no traits of `a` is refused, as are bytes that do not parse and,
# by name, a property, a bit or an attribute no row maps. a text is borrowed
# from `data`, and a refusal leaves `out` as it was
pub fun raise(a: *Arch, name: Bytes, data: Bytes, out: *Table[Trait]) err[Fail] {
    val m: res[Machine, Fail] = traits.machine_of(a);
    if (sel m.err) { ret err[Fail].err{m.err}; }
    val note: Bytes = Bytes{data: PROPERTY_SECTION::*u8, len: str_len(PROPERTY_SECTION)};
    if (store.same_bytes(name, note) && traits.holds_traits(a, name)) {
        val r: err[Fail] = raised_notes(a, m.ok.shape, data, out);
        if (sel r.err) { ret err[Fail].err{fail.in_record(r.err, PROPERTY_SECTION)}; }
        ret r;
    }
    val s: opt[*attributes.Section] = traits.section_of(a);
    if (sel s.some) {
        val v: *attributes.Section = s.some;
        if (store.same_bytes(name, Bytes{data: v.name::*u8, len: str_len(v.name)})) {
            val r: err[Fail] = raised_attributes(a, m.ok.shape, v, data, out);
            if (sel r.err) { ret err[Fail].err{fail.in_record(r.err, v.name)}; }
            ret r;
        }
    }
    ret err[Fail].err{fail.about(fail.unsupported("the section holds no traits of the architecture"), a.name)};
}

# the traits the GNU property notes `data` state, the notes padded to the
# address size of the class as an object lays them out
fun raised_notes(a: *Arch, shape: Shape, data: Bytes, out: *Table[Trait]) err[Fail] {
    var rd: Reader                      = reader.make(nil, data.data, data.len, shape.order);
    val n:  res[opt[Table[Note]], Fail] = read.notes_of(out.a, shape, ?rd, data.len::u64, shape.class.addr::u64);
    if (sel n.err)     { ret err[Fail].err{n.err}; }
    if (sel n.ok.none) { ret err[Fail].err{fail.unsupported("the notes do not tile the section")}; }
    var notes:    Body           = Body.notes{n.ok.some};
    var props:    property.Set   = property.make(out.a);
    var words:    Words          = traits.make_words(out.a, 0);
    var readings: Table[Reading] = table.make[Reading](out.a);
    var r:        err[Fail]      = notes_read(a, shape, ?n.ok.some, ?props, ?words, ?readings);
    if (!(sel r.err)) { r = contract.reconcile(?readings, nil, out); }
    r = fail.kept(r, table.release[Reading](?readings));
    r = fail.kept(r, traits.release_words(?words));
    r = fail.kept(r, property.release(?props));
    r = fail.kept(r, model.release_body(?notes));
    ret r;
}

# what the GNU property notes `notes` state of the traits, as readings,
# refusing a note that holds no properties and a property, or a bit of one,
# no row of `a` maps
fun notes_read(a: *Arch, shape: Shape, notes: *Table[Note], props: *property.Set, words: *Words, out: *Table[Reading]) err[Fail] {
    var k: usize = 0;
    for (k < table.count[Note](notes)) {
        val e: *Note = table.at[Note](notes, table.nth[Note](k));
        if (!sel e.desc.properties) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a note of the section holds no GNU properties"), "note", k::u64)}; }
        k = k + 1;
    }
    var count: usize     = 0;
    val g:     err[Fail] = property.gather_notes(notes, nil, shape.order, a, props, ?count);
    if (sel g.err) { ret g; }
    var i: usize = 0;
    for (i < table.count[property.Merged](?props.merged)) {
        val p: *property.Merged = table.at[property.Merged](?props.merged, table.nth[property.Merged](i));
        i = i + 1;
        if (p.data.len != 4 || !traits.maps_property(a, p.type)) {
            ret err[Fail].err{fail.in_indexed(fail.unsupported("a GNU property no trait row maps"), "GNU property", p.type::u64)};
        }
    }
    val w: err[Fail] = property.words(props, words);
    if (sel w.err) { ret w; }
    val d: err[Fail] = traits.decode_properties(a, words, out);
    if (sel d.err) { ret d; }
    var j: usize = 0;
    for (j < table.count[Word](?words.properties)) {
        val left: *Word = table.at[Word](?words.properties, table.nth[Word](j));
        j = j + 1;
        if (left.value != 0) { ret err[Fail].err{traits.stray(left.type, left.value::u64)}; }
    }
    ret err[Fail].ok{};
}

# the traits the build attributes section `s` states in `data`
fun raised_attributes(a: *Arch, shape: Shape, s: *attributes.Section, data: Bytes, out: *Table[Trait]) err[Fail] {
    var parts:    Table[Part]      = table.make[Part](out.a);
    var list:     Table[Attribute] = table.make[Attribute](out.a);
    var readings: Table[Reading]   = table.make[Reading](out.a);
    var left:     Table[Unread]    = table.make[Unread](out.a);
    var r:        err[Fail]        = attributes_read(a, shape, s, data, ?parts, ?list, ?readings, ?left);
    if (!(sel r.err)) { r = contract.reconcile(?readings, nil, out); }
    r = fail.kept(r, table.release[Unread](?left));
    r = fail.kept(r, table.release[Reading](?readings));
    r = fail.kept(r, table.release[Attribute](?list));
    r = fail.kept(r, table.release[Part](?parts));
    ret r;
}

# what the build attributes in `data` state of the traits, as readings, when
# they parse and every attribute is one a row reads
fun attributes_read(a: *Arch, shape: Shape, s: *attributes.Section, data: Bytes, parts: *Table[Part], list: *Table[Attribute], out: *Table[Reading], left: *Table[Unread]) err[Fail] {
    val p: res[bool, Fail] = attributes.parse(out.a, s, ?traits.VENDORS[0], traits.VENDOR_COUNT, data, shape.order, parts, list);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    if (!p.ok)     { ret err[Fail].err{fail.unsupported("the build attributes are not in the one shape mink reads")}; }
    val read: res[opt[Fail], Fail] = traits.read_attributes(a, s, parts, list, out, left);
    if (sel read.err)     { ret err[Fail].err{read.err}; }
    if (sel read.ok.some) { ret err[Fail].err{read.ok.some}; }
    if (table.count[Unread](left) != 0) {
        val u: *Unread = table.at[Unread](left, table.nth[Unread](0));
        ret err[Fail].err{traits.unmapped(u.vendor, u.attribute.tag)};
    }
    ret err[Fail].ok{};
}
