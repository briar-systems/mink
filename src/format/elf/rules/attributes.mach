# the build attributes section of an ELF object
#
# a build attributes section begins with the format version `A`, then holds
# subsections, each its length and its name. the section's layout gives what
# a subsection holds after its name. in the scoped layout, as the RISC-V
# psABI lays out `.riscv.attributes` and the Arm ABI addenda the aeabi
# subsection of `.ARM.attributes`, a subsection is a vendor's and holds
# sub-subsections of a scope tag and their size, the file's attributes in the
# one of the vendor's file scope. in the flagged layout, as the Arm AArch64
# build attributes (buildattr64) lay out `.ARM.attributes`, a subsection
# states whether a consumer that does not know it may ignore it and the kind
# of every value it holds, then holds the attributes. an attribute is a
# ULEB128 tag and its value. mink reads the one shape it writes back to the
# same bytes: each subsection's tags ascending, each once, and in the scoped
# layout one file sub-subsection of a vendor whose row it has. a section of
# any other shape is held as it is.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.reader;
use mink.bytes.reader.Order;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.elf.model.tables;
use mink.format.elf.model.tables.Constant;

# how a tag's value is encoded
# ---
# number: a ULEB128 number
# text:   a NUL-terminated string
# pair:   a ULEB128 number then a NUL-terminated string
pub tag Kind: u8 {
    number;
    text;
    pair;
}

# how a section lays out what a subsection holds after its name
# ---
# scoped:  sub-subsections of a scope tag and their size
# flagged: the subsection's optional flag and parameter type, then the
#          attributes
pub tag Layout: u8 {
    scoped;
    flagged;
}

# the build attributes section of an architecture
# ---
# layout:  how its subsections are laid out
# type:    its sh_type
# name:    its name
# segment: the p_type of the program header that locates it in an
#          executable, nil for none
pub rec Section {
    layout:  Layout;
    type:    *Constant;
    name:    str;
    segment: *Constant;
}

# how a subsection gives each tag's value its kind
# ---
# parity: a tag at or above this is a string when odd and a number when
#         even, and a tag below it is a number
# every:  every value is of this kind
pub tag Rule: u8 {
    parity: u64;
    every:  Kind;
}

# a tag whose value is not of the kind the subsection's rule gives it
pub rec Typed {
    tag:  u64;
    kind: Kind;
}

# a subsection of a build attributes section, a vendor's in the scoped layout
# ---
# section:     the section that holds it
# name:        its name
# scope:       scoped: the tag of the sub-subsection that holds the file's
#              attributes
# optional:    flagged: whether a consumer that does not know it may ignore
#              it
# rule:        how a tag's value is given its kind
# typed:       the tags whose values are of another kind, ascending by tag
# typed_count: how many
pub rec Vendor {
    section:     *Section;
    name:        str;
    scope:       u64;
    optional:    bool;
    rule:        Rule;
    typed:       *Typed;
    typed_count: usize;
}

# the optional flag of a subsection of the flagged layout
pub val REQUIRED: Constant = Constant{name: "required", value: 0, source: "buildattr64"};
pub val OPTIONAL: Constant = Constant{name: "optional", value: 1, source: "buildattr64"};
# the parameter type of a subsection of the flagged layout, the kind of
# every value it holds
pub val ULEB128: Constant = Constant{name: "ULEB128", value: 0, source: "buildattr64"};
pub val NTBS:    Constant = Constant{name: "NTBS", value: 1, source: "buildattr64"};

# a kind of value and the parameter type that states it
rec Parameter {
    kind: Kind;
    code: *Constant;
}

val PARAMETER_COUNT: usize                      = 2;
val PARAMETERS:      [PARAMETER_COUNT]Parameter = [PARAMETER_COUNT]Parameter{
    Parameter{kind: Kind.number{}, code: ?ULEB128},
    Parameter{kind: Kind.text{}, code: ?NTBS},
};

# a number and a string, its bytes without the NUL
pub rec Pair {
    number: u64;
    text:   Bytes;
}

# the value of an attribute
# ---
# number: a number's
# text:   a string's, its bytes without the NUL
# pair:   a pair's
pub tag Value: u8 {
    number: u64;
    text:   Bytes;
    pair:   Pair;
}

pub rec Attribute {
    tag:   u64;
    value: Value;
}

# a subsection as a file holds it
# ---
# vendor:   its row, nil when the rows given name none of its name in its
#           section
# name:     its name, its bytes without the NUL
# optional: flagged: whether a consumer that does not know it may ignore it
# kind:     flagged: the kind of every value it holds
# count:    how many attributes it holds, which follow those of the
#           subsections before it
pub rec Part {
    vendor:   *Vendor;
    name:     Bytes;
    optional: bool;
    kind:     Kind;
    count:    usize;
}

fun same_kind(a: Kind, b: Kind) bool {
    if (sel a.number) { ret sel b.number; }
    or (sel a.text)   { ret sel b.text; }
    ret sel b.pair;
}

# the kind the rule of `v` gives `tag`
fun ruled(v: *Vendor, tag: u64) Kind {
    if (sel v.rule.every)                       { ret v.rule.every; }
    if (tag >= v.rule.parity && (tag & 1) == 1) { ret Kind.text{}; }
    ret Kind.number{};
}

fun order_typed(a: *Typed, b: *Typed) i64 {
    if (a.tag < b.tag) { ret -1; }
    if (a.tag > b.tag) { ret 1; }
    ret 0;
}

# the kind of the value of `tag` in the attributes of `v`
pub fun kind_of(v: *Vendor, tag: u64) Kind {
    var probe: Typed          = Typed{tag: tag};
    val at:    SearchPosition = sort.binary_search_by[Typed](v.typed, v.typed_count, ?probe, order_typed);
    if (sel at.found) { ret v.typed[at.found].kind; }
    ret ruled(v, tag);
}

# whether `value` is of the kind `k`
pub fun fits(k: Kind, value: Value) bool {
    if (sel k.number) { ret sel value.number; }
    or (sel k.text)   { ret sel value.text; }
    ret sel value.pair;
}

# the parameter type that states `k`, none for a kind no parameter type states
pub fun parameter_of(k: Kind) opt[*Constant] {
    var i: usize = 0;
    for (i < PARAMETER_COUNT) {
        if (same_kind(PARAMETERS[i].kind, k)) { ret opt[*Constant].some{PARAMETERS[i].code}; }
        i = i + 1;
    }
    ret opt[*Constant].none{};
}

# the kind the parameter type `code` states, none for a code no row names
fun kind_coded(code: u64) opt[Kind] {
    var i: usize = 0;
    for (i < PARAMETER_COUNT) {
        if (PARAMETERS[i].code.value == code) { ret opt[Kind].some{PARAMETERS[i].kind}; }
        i = i + 1;
    }
    ret opt[Kind].none{};
}

# whether a vendor row is consistent: a scoped vendor gives kinds by parity,
# its typed tags ascending, each once and of another kind than parity gives
# it, and a flagged one gives every value one kind a parameter type states
# and lists no typed tag
pub fun consistent(v: *Vendor) bool {
    if (sel v.section.layout.flagged) {
        if (v.typed_count != 0 || v.scope != 0) { ret false; }
        if (sel v.rule.every) {
            val code: opt[*Constant] = parameter_of(v.rule.every);
            ret sel code.some;
        }
        ret false;
    }
    if (sel v.rule.every) { ret false; }
    if (v.optional)       { ret false; }
    var i: usize = 0;
    for (i < v.typed_count) {
        if (i != 0 && v.typed[i - 1].tag >= v.typed[i].tag)       { ret false; }
        if (same_kind(ruled(v, v.typed[i].tag), v.typed[i].kind)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the subsection the row `v` states, holding no attributes yet
pub fun part_of(v: *Vendor) Part {
    var kind: Kind = Kind.number{};
    if (sel v.rule.every) { kind = v.rule.every; }
    ret Part{vendor: v, name: Bytes{data: v.name::*u8, len: str_len(v.name)}, optional: v.optional, kind: kind};
}

# whether the subsection `p` of section `s` a file holds is as its row
# states it: in the flagged layout, of the row's optional flag and kind
pub fun matches(s: *Section, p: *Part) bool {
    if (p.vendor == nil)                 { ret false; }
    if (sel s.layout.scoped)             { ret true; }
    if (p.optional != p.vendor.optional) { ret false; }
    if (sel p.vendor.rule.every)         { ret same_kind(p.kind, p.vendor.rule.every); }
    ret false;
}

# the NUL-terminated string at the reader's place, which the reader reads,
# its bytes without the NUL
fun string(rd: *Reader) res[Bytes, Fail] {
    val at: usize = rd.pos;
    var k:  usize = 0;
    for (at + k < rd.len && rd.data[at + k] != 0) {
        k = k + 1;
    }
    if (at + k == rd.len) { ret res[Bytes, Fail].err{fail.truncated("a build attribute string is not terminated")}; }
    val skipped: res[*u8, Fail] = reader.bytes(rd, (k + 1)::u64);
    if (sel skipped.err) { ret res[Bytes, Fail].err{skipped.err}; }
    ret res[Bytes, Fail].ok{Bytes{data: ?rd.data[at], len: k}};
}

# the value of kind `k` at the reader's place, a string borrowed from where
# the reader reads
fun value_at(rd: *Reader, k: Kind) res[Value, Fail] {
    if (sel k.text) {
        val t: res[Bytes, Fail] = string(rd);
        if (sel t.err) { ret res[Value, Fail].err{t.err}; }
        ret res[Value, Fail].ok{Value.text{t.ok}};
    }
    val n: res[u64, Fail] = reader.uleb(rd);
    if (sel n.err)    { ret res[Value, Fail].err{n.err}; }
    if (sel k.number) { ret res[Value, Fail].ok{Value.number{n.ok}}; }
    val t: res[Bytes, Fail] = string(rd);
    if (sel t.err) { ret res[Value, Fail].err{t.err}; }
    ret res[Value, Fail].ok{Value.pair{Pair{number: n.ok, text: t.ok}}};
}

# write the encoding of `value` to `out`
pub fun encode(out: *Sink, value: Value) err[Fail] {
    if (sel value.number) { ret sink.uleb(out, value.number); }
    var text: Bytes = Bytes{data: nil, len: 0};
    if (sel value.text) { text = value.text; }
    or (sel value.pair) {
        val n: err[Fail] = sink.uleb(out, value.pair.number);
        if (sel n.err) { ret n; }
        text = value.pair.text;
    }
    val b: err[Fail] = sink.bytes(out, text.data, text.len);
    if (sel b.err) { ret b; }
    ret sink.u8(out, 0);
}

# the value of the attribute `tag` of `v` whose whole encoding is `data`, a
# string borrowed from `data`
pub fun decode(v: *Vendor, tag: u64, data: Bytes) res[Value, Fail] {
    var rd: Reader           = reader.make(nil, data.data, data.len, reader.LITTLE);
    val r:  res[Value, Fail] = value_at(?rd, kind_of(v, tag));
    if (sel r.err)                  { ret r; }
    if (reader.remaining(?rd) != 0) { ret res[Value, Fail].err{fail.malformed("a build attribute value has bytes past its end")}; }
    ret r;
}

fun same_name(name: str, b: Bytes) bool {
    if (str_len(name) != b.len) { ret false; }
    var i: usize = 0;
    for (i < b.len) {
        if (name[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the row among the `n` vendors at `vendors` of section `s` named `name`, nil
# for none
pub fun vendor_named(s: *Section, vendors: **Vendor, n: usize, name: Bytes) *Vendor {
    var i: usize = 0;
    for (i < n) {
        if (vendors[i].section == s && same_name(vendors[i].name, name)) { ret vendors[i]; }
        i = i + 1;
    }
    ret nil;
}

# the subsections of the section `s` in its bytes `data`, added to `parts`
# in the order the file holds them, and their attributes in tag order added
# to `out`, a subsection's row found among the `nv` vendors at `vendors`.
# false, with nothing added, when the section is not of the one shape mink
# reads or does not write back to the same bytes
pub fun parse(a: *A.Allocator, s: *Section, vendors: **Vendor, nv: usize, data: Bytes, order: Order, parts: *Table[Part], out: *Table[Attribute]) res[bool, Fail] {
    val held: usize           = table.count[Part](parts);
    val mark: usize           = table.count[Attribute](out);
    val r:    res[bool, Fail] = parsed(a, s, vendors, nv, data, order, parts, out);
    var kept: bool            = false;
    if (sel r.ok) { kept = r.ok; }
    if (!kept) {
        table.truncate[Part](parts, held);
        table.truncate[Attribute](out, mark);
    }
    ret r;
}

fun parsed(a: *A.Allocator, s: *Section, vendors: **Vendor, nv: usize, data: Bytes, order: Order, parts: *Table[Part], out: *Table[Attribute]) res[bool, Fail] {
    val held:  usize         = table.count[Part](parts);
    val mark:  usize         = table.count[Attribute](out);
    var rd:    Reader        = reader.make(nil, data.data, data.len, order);
    val first: res[u8, Fail] = reader.u8(?rd);
    if (sel first.err)   { ret res[bool, Fail].ok{false}; }
    if (first.ok != 'A') { ret res[bool, Fail].ok{false}; }
    for (reader.remaining(?rd) != 0) {
        val start:  u64            = reader.offset(?rd);
        val length: res[u32, Fail] = reader.u32(?rd);
        if (sel length.err)                                                { ret res[bool, Fail].ok{false}; }
        if (length.ok < 4 || length.ok::usize - 4 > reader.remaining(?rd)) { ret res[bool, Fail].ok{false}; }
        val body: res[Reader, Fail] = reader.sub(?rd, start + 4, length.ok::u64 - 4);
        if (sel body.err) { ret res[bool, Fail].ok{false}; }
        var sub:  Reader           = body.ok;
        val skip: res[usize, Fail] = reader.seek(?rd, start + length.ok::u64);
        if (sel skip.err) { ret res[bool, Fail].ok{false}; }
        val p: res[bool, Fail] = subsection(s, vendors, nv, ?sub, parts, out);
        if (sel p.err) { ret p; }
        if (!p.ok)     { ret p; }
    }
    var back: Sink      = sink.make(a, order);
    val w:    err[Fail] = write(s, ?table.items[Part](parts)[held], table.count[Part](parts) - held, ?table.items[Attribute](out)[mark], table.count[Attribute](out) - mark, ?back);
    var same: bool      = false;
    if (sel w.ok && sink.len(?back) == data.len) {
        same = true;
        var k: usize = 0;
        for (k < data.len) {
            if (sink.data(?back)[k] != data.data[k]) { same = false; }
            k = k + 1;
        }
    }
    val rel: err[Fail] = sink.release(?back);
    if (sel rel.err) { ret res[bool, Fail].err{rel.err}; }
    ret res[bool, Fail].ok{same};
}

# the subsection the reader holds the bytes of past its length, added to
# `parts` with its attributes added to `out`
fun subsection(s: *Section, vendors: **Vendor, nv: usize, rd: *Reader, parts: *Table[Part], out: *Table[Attribute]) res[bool, Fail] {
    val name: res[Bytes, Fail] = string(rd);
    if (sel name.err) { ret res[bool, Fail].ok{false}; }
    var part: Part = Part{vendor: vendor_named(s, vendors, nv, name.ok), name: name.ok};
    if (sel s.layout.flagged) {
        val optional: res[u8, Fail] = reader.u8(rd);
        if (sel optional.err)                                                         { ret res[bool, Fail].ok{false}; }
        if (optional.ok::u64 != REQUIRED.value && optional.ok::u64 != OPTIONAL.value) { ret res[bool, Fail].ok{false}; }
        val type: res[u8, Fail] = reader.u8(rd);
        if (sel type.err) { ret res[bool, Fail].ok{false}; }
        val kind: opt[Kind] = kind_coded(type.ok::u64);
        if (sel kind.none) { ret res[bool, Fail].ok{false}; }
        part.optional = optional.ok::u64 == OPTIONAL.value;
        part.kind     = kind.some;
    }
    or {
        if (part.vendor == nil) { ret res[bool, Fail].ok{false}; }
        val start: u64            = reader.offset(rd);
        val tag:   res[u64, Fail] = reader.uleb(rd);
        if (sel tag.err)                 { ret res[bool, Fail].ok{false}; }
        if (tag.ok != part.vendor.scope) { ret res[bool, Fail].ok{false}; }
        val size: res[u32, Fail] = reader.u32(rd);
        if (sel size.err)                                                          { ret res[bool, Fail].ok{false}; }
        if (size.ok::u64 != reader.offset(rd) - start + reader.remaining(rd)::u64) { ret res[bool, Fail].ok{false}; }
    }
    val mark: usize = table.count[Attribute](out);
    for (reader.remaining(rd) != 0) {
        val t: res[u64, Fail] = reader.uleb(rd);
        if (sel t.err) { ret res[bool, Fail].ok{false}; }
        val held: usize = table.count[Attribute](out);
        if (held != mark && table.at[Attribute](out, table.nth[Attribute](held - 1)).tag >= t.ok) { ret res[bool, Fail].ok{false}; }
        var kind: Kind = part.kind;
        if (sel s.layout.scoped) { kind = kind_of(part.vendor, t.ok); }
        val value: res[Value, Fail] = value_at(rd, kind);
        if (sel value.err) { ret res[bool, Fail].ok{false}; }
        val pushed: res[table.Id[Attribute], Fail] = table.push[Attribute](out, Attribute{tag: t.ok, value: value.ok});
        if (sel pushed.err) { ret res[bool, Fail].err{pushed.err}; }
    }
    part.count = table.count[Attribute](out) - mark;
    val added: res[table.Id[Part], Fail] = table.push[Part](parts, part);
    if (sel added.err) { ret res[bool, Fail].err{added.err}; }
    ret res[bool, Fail].ok{true};
}

# the kind of the value of `tag` in the subsection `p` of section `s`
fun part_kind(s: *Section, p: *Part, tag: u64) Kind {
    if (sel s.layout.flagged) { ret p.kind; }
    ret kind_of(p.vendor, tag);
}

# write the section `s` holding the `np` subsections at `parts` and the `n`
# attributes at `at`, each subsection's ascending by tag, to `out`. a scoped
# subsection with no vendor row, a flagged one whose kind no parameter type
# states, a value not of its tag's kind and counts that do not add up are
# refused
pub fun write(s: *Section, parts: *Part, np: usize, at: *Attribute, n: usize, out: *Sink) err[Fail] {
    var total: usize = 0;
    var i:     usize = 0;
    for (i < np) {
        val p: *Part = ?parts[i];
        if ((sel s.layout.scoped) && p.vendor == nil) {
            ret err[Fail].err{fail.malformed("a build attribute subsection of the scoped layout has no vendor row")};
        }
        if (sel s.layout.flagged) {
            val code: opt[*Constant] = parameter_of(p.kind);
            if (sel code.none) { ret err[Fail].err{fail.malformed("no parameter type states the kind of a build attribute subsection")}; }
        }
        var k: usize = 0;
        for (k < p.count) {
            if (total + k >= n) { ret err[Fail].err{fail.internal("build attribute subsections hold more attributes than are given")}; }
            val e: *Attribute = ?at[total + k];
            if (!fits(part_kind(s, p, e.tag), e.value)) {
                ret err[Fail].err{fail.valued(fail.malformed("a build attribute value is not of its tag's kind"), e.tag::i128)};
            }
            k = k + 1;
        }
        total = total + p.count;
        i     = i + 1;
    }
    if (total != n) { ret err[Fail].err{fail.internal("build attribute subsections hold fewer attributes than are given")}; }
    val f: err[Fail] = sink.u8(out, 'A');
    if (sel f.err) { ret f; }
    total = 0;
    i     = 0;
    for (i < np) {
        val w: err[Fail] = subsection_out(s, ?parts[i], ?at[total], out);
        if (sel w.err) { ret w; }
        total = total + parts[i].count;
        i     = i + 1;
    }
    ret err[Fail].ok{};
}

fun subsection_out(s: *Section, p: *Part, at: *Attribute, out: *Sink) err[Fail] {
    val base: usize     = sink.len(out);
    val l:    err[Fail] = sink.u32(out, 0);
    if (sel l.err) { ret l; }
    val name: err[Fail] = sink.bytes(out, p.name.data, p.name.len);
    if (sel name.err) { ret name; }
    val nul: err[Fail] = sink.u8(out, 0);
    if (sel nul.err) { ret nul; }
    var sub:  usize = 0;
    var size: usize = 0;
    if (sel s.layout.flagged) {
        var flag: u64 = REQUIRED.value;
        if (p.optional) { flag = OPTIONAL.value; }
        val o: err[Fail] = sink.u8(out, flag::u8);
        if (sel o.err) { ret o; }
        val code: opt[*Constant] = parameter_of(p.kind);
        if (sel code.none) { ret err[Fail].err{fail.internal("a subsection's kind lost its parameter type")}; }
        val t: err[Fail] = sink.u8(out, code.some.value::u8);
        if (sel t.err) { ret t; }
    }
    or {
        sub = sink.len(out);
        val t: err[Fail] = sink.uleb(out, p.vendor.scope);
        if (sel t.err) { ret t; }
        size = sink.len(out);
        val z: err[Fail] = sink.u32(out, 0);
        if (sel z.err) { ret z; }
    }
    var i: usize = 0;
    for (i < p.count) {
        val wt: err[Fail] = sink.uleb(out, at[i].tag);
        if (sel wt.err) { ret wt; }
        val wv: err[Fail] = encode(out, at[i].value);
        if (sel wv.err) { ret wv; }
        i = i + 1;
    }
    val end: usize     = sink.len(out);
    val pl:  err[Fail] = sink.patch(out, base, (end - base)::u64, 4);
    if (sel pl.err)           { ret pl; }
    if (sel s.layout.flagged) { ret err[Fail].ok{}; }
    ret sink.patch(out, size, (end - sub)::u64, 4);
}

test attributes__a_vendor_row_states_its_scope_and_value_kinds {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # the aeabi subsection of `.ARM.attributes`: tags below 32 are numbers but
    # for Tag_CPU_raw_name and Tag_CPU_name, and Tag_compatibility is a flag
    # and a vendor's name
    val arm:   Section  = Section{layout: Layout.scoped{}, name: ".ARM.attributes"};
    val typed: [3]Typed = [3]Typed{
        Typed{tag: 4, kind: Kind.text{}},
        Typed{tag: 5, kind: Kind.text{}},
        Typed{tag: 32, kind: Kind.pair{}},
    };
    val aeabi:   Vendor     = Vendor{section: ?arm, name: "aeabi", scope: 1, rule: Rule.parity{32}, typed: ?typed[0], typed_count: 3};
    val vendors: [1]*Vendor = [1]*Vendor{?aeabi};
    if (!consistent(?aeabi)) { ret 1; }

    # Tag_CPU_raw_name "x", Tag_CPU_name "y", Tag_CPU_arch 10,
    # Tag_ABI_PCS_wchar_t 4, Tag_compatibility 1 "gnu" and Tag_conformance
    # "2.09", in the aeabi layout of the Arm ABI addenda
    val bytes: [38]u8 = [38]u8{
        'A', 37, 0, 0, 0, 'a', 'e', 'a', 'b', 'i', 0,
        1, 27, 0, 0, 0,
        4, 'x', 0, 5, 'y', 0, 6, 10, 18, 4,
        32, 1, 'g', 'n', 'u', 0,
        67, '2', '.', '0', '9', 0,
    };
    val data:  Bytes            = Bytes{data: ?bytes[0], len: 38};
    var parts: Table[Part]      = table.make[Part](a);
    var list:  Table[Attribute] = table.make[Attribute](a);
    val p:     res[bool, Fail]  = parse(a, ?arm, ?vendors[0], 1, data, reader.LITTLE, ?parts, ?list);
    if (sel p.err)                                     { ret 2; }
    if (!p.ok)                                         { ret 2; }
    if (table.count[Part](?parts) != 1)                { ret 2; }
    if (table.count[Attribute](?list) != 6)            { ret 2; }
    if (table.items[Part](?parts)[0].vendor != ?aeabi) { ret 2; }
    val at: *Attribute = table.items[Attribute](?list);
    if (!(sel at[0].value.text) || !(sel at[1].value.text))    { ret 3; }
    if (!(sel at[2].value.number && at[2].value.number == 10)) { ret 3; }
    if (!(sel at[3].value.number && at[3].value.number == 4))  { ret 3; }
    if (!(sel at[4].value.pair))                               { ret 4; }
    if (at[4].value.pair.number != 1)                          { ret 4; }
    if (at[4].value.pair.text.len != 3)                        { ret 4; }
    if (!(sel at[5].value.text && at[5].value.text.len == 4))  { ret 5; }

    # parity from tag 0 reads tag 4 as a number, so the same bytes do not parse
    val parity:  Vendor           = Vendor{section: ?arm, name: "aeabi", scope: 1, rule: Rule.parity{0}};
    val by_tag:  [1]*Vendor       = [1]*Vendor{?parity};
    var noparts: Table[Part]      = table.make[Part](a);
    var none:    Table[Attribute] = table.make[Attribute](a);
    val q:       res[bool, Fail]  = parse(a, ?arm, ?by_tag[0], 1, data, reader.LITTLE, ?noparts, ?none);
    if (sel q.err)                        { ret 6; }
    if (q.ok)                             { ret 6; }
    if (table.count[Part](?noparts) != 0) { ret 6; }

    # a value not of its tag's kind is refused
    var out:   Sink      = sink.make(a, reader.LITTLE);
    val wrong: Attribute = Attribute{tag: 6, value: Value.text{Bytes{data: ?bytes[17], len: 1}}};
    val one:   Part      = Part{vendor: ?aeabi, name: Bytes{data: "aeabi"::*u8, len: 5}, count: 1};
    val w:     err[Fail] = write(?arm, ?one, 1, ?wrong, 1, ?out);
    if (sel w.ok) { ret 7; }

    val r1: err[Fail] = table.release[Attribute](?list);
    val r2: err[Fail] = table.release[Attribute](?none);
    val r3: err[Fail] = sink.release(?out);
    val r4: err[Fail] = table.release[Part](?parts);
    val r5: err[Fail] = table.release[Part](?noparts);
    if (sel r1.err || sel r2.err || sel r3.err || sel r4.err || sel r5.err) { ret 1; }
    if (T.live_count(?t) != 0)                                              { ret 1; }
    T.dnit(?t);
    ret 0;
}

test attributes__an_aarch64_section_round_trips_its_subsections {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # as llvm-mc assembles the buildattr64 directives: aeabi_pauthabi,
    # required and ULEB128, with Tag_PAuth_Platform 1 and Tag_PAuth_Schema 5,
    # aeabi_feature_and_bits, optional and ULEB128, with Tag_Feature_BTI 1,
    # Tag_Feature_PAC 0 and Tag_Feature_GCS 1, then a subsection no row
    # names, optional and NTBS, with tag 3 "hi"
    val aarch64: Section = Section{layout: Layout.flagged{}, type: ?tables.SHT_AARCH64_ATTRIBUTES, name: ".ARM.attributes"};
    val bytes:   [73]u8  = [73]u8{
        'A',
        25, 0, 0, 0, 'a', 'e', 'a', 'b', 'i', '_', 'p', 'a', 'u', 't', 'h', 'a', 'b', 'i', 0, 0, 0,
        1, 1, 2, 5,
        35, 0, 0, 0, 'a', 'e', 'a', 'b', 'i', '_', 'f', 'e', 'a', 't', 'u', 'r', 'e', '_', 'a', 'n', 'd', '_', 'b', 'i', 't', 's', 0, 1, 0,
        0, 1, 1, 0, 2, 1,
        12, 0, 0, 0, 'x', 0, 1, 1,
        3, 'h', 'i', 0,
    };
    val data:  Bytes            = Bytes{data: ?bytes[0], len: 73};
    var parts: Table[Part]      = table.make[Part](a);
    var list:  Table[Attribute] = table.make[Attribute](a);
    val p:     res[bool, Fail]  = parse(a, ?aarch64, nil, 0, data, reader.LITTLE, ?parts, ?list);
    if (sel p.err)                          { ret 2; }
    if (!p.ok)                              { ret 2; }
    if (table.count[Part](?parts) != 3)     { ret 2; }
    if (table.count[Attribute](?list) != 6) { ret 2; }
    val ps: *Part = table.items[Part](?parts);
    if (!same_name("aeabi_pauthabi", ps[0].name) || ps[0].optional || !(sel ps[0].kind.number) || ps[0].count != 2) { ret 3; }
    if (!same_name("aeabi_feature_and_bits", ps[1].name) || !ps[1].optional || ps[1].count != 3)                    { ret 3; }
    if (!same_name("x", ps[2].name) || !ps[2].optional || !(sel ps[2].kind.text) || ps[2].count != 1)               { ret 3; }
    val at: *Attribute = table.items[Attribute](?list);
    if (at[1].tag != 2 || !(sel at[1].value.number && at[1].value.number == 5)) { ret 4; }
    if (at[3].tag != 1 || !(sel at[3].value.number && at[3].value.number == 0)) { ret 4; }
    if (at[5].tag != 3 || !(sel at[5].value.text && at[5].value.text.len == 2)) { ret 4; }

    # an optional flag no row names does not parse, and a number in a
    # subsection of strings is refused
    var bad: [73]u8 = bytes;
    bad[20] = 2;
    var noparts: Table[Part]      = table.make[Part](a);
    var none:    Table[Attribute] = table.make[Attribute](a);
    val q:       res[bool, Fail]  = parse(a, ?aarch64, nil, 0, Bytes{data: ?bad[0], len: 73}, reader.LITTLE, ?noparts, ?none);
    if (sel q.err)                        { ret 5; }
    if (q.ok)                             { ret 5; }
    if (table.count[Part](?noparts) != 0) { ret 5; }
    var out:   Sink      = sink.make(a, reader.LITTLE);
    val wrong: Attribute = Attribute{tag: 3, value: Value.number{1}};
    val w:     err[Fail] = write(?aarch64, ?ps[2], 1, ?wrong, 1, ?out);
    if (sel w.ok) { ret 6; }

    val r1: err[Fail] = table.release[Attribute](?list);
    val r2: err[Fail] = table.release[Attribute](?none);
    val r3: err[Fail] = sink.release(?out);
    val r4: err[Fail] = table.release[Part](?parts);
    val r5: err[Fail] = table.release[Part](?noparts);
    if (sel r1.err || sel r2.err || sel r3.err || sel r4.err || sel r5.err) { ret 1; }
    if (T.live_count(?t) != 0)                                              { ret 1; }
    T.dnit(?t);
    ret 0;
}
