# the traits a section of an ELF object holds, raised from its bytes
#
# a producer that writes a section the format holds the traits of, as an
# assembler does from directives that spell the GNU property note or the
# build attributes, learns the traits the bytes encode through the parser and
# the rows the reader decodes the section with. the reader keeps what no row
# maps as a fact or the section's bytes, and a producer's object holds no such
# fact, so here a property, a bit or an attribute no row maps is refused by
# name. a section states only what it holds: of an axis with an encoding in
# another section, as AArch64 states branch protection in both, it states only
# its own, and reconciling the two is the reader's.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_len;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.vectors;
use mink.bytes.reader;
use mink.bytes.reader.Reader;
use mink.catalog.arch.Arch;
use mink.catalog.trait.Trait;
use mink.format.contract;
use mink.format.contract.Reading;
use mink.format.elf.attributes;
use mink.format.elf.attributes.Attribute;
use mink.format.elf.attributes.Part;
use mink.format.elf.model.model;
use mink.format.elf.model.model.Body;
use mink.format.elf.model.model.Note;
use mink.format.elf.model.model.Shape;
use mink.format.elf.property;
use mink.format.elf.read;
use mink.format.elf.traits;
use mink.format.elf.traits.Machine;
use mink.format.elf.traits.PROPERTY_SECTION;
use mink.format.elf.traits.Unread;
use mink.format.elf.traits.Word;
use mink.format.elf.traits.Words;

use std.collections.vector;
use std.collections.vector.Vector;

# state on `out` the traits of an object for `a` the section named `name`
# holds in `data`: the GNU property note or the architecture's build
# attributes section, laid out as an object for `a` lays them out. a section
# that holds no traits of `a` is refused, as are bytes that do not parse and,
# by name, a property, a bit or an attribute no row maps. a text is borrowed
# from `data`, and a refusal leaves `out` as it was
pub fun raise(a: *Arch, name: Bytes, data: Bytes, out: *Vector[Trait]) err[Fail] {
    val res_machine_of: res[Machine, Fail] = traits.machine_of(a);
    if (sel res_machine_of.err) { ret err[Fail].err{res_machine_of.err}; }
    val note: Bytes = Bytes{data: PROPERTY_SECTION::*u8, len: str_len(PROPERTY_SECTION)};
    if (store.same_bytes(name, note) && traits.holds_traits(a, name)) {
        val err_raised_notes: err[Fail] = raised_notes(a, res_machine_of.ok.shape, data, out);
        if (sel err_raised_notes.err) { ret err[Fail].err{fail.in_record(err_raised_notes.err, PROPERTY_SECTION)}; }
        ret err_raised_notes;
    }
    val opt_section_of: opt[*attributes.Section] = traits.section_of(a);
    if (sel opt_section_of.some) {
        val v: *attributes.Section = opt_section_of.some;
        if (store.same_bytes(name, Bytes{data: v.name::*u8, len: str_len(v.name)})) {
            val err_raised_attributes: err[Fail] = raised_attributes(a, res_machine_of.ok.shape, v, data, out);
            if (sel err_raised_attributes.err) { ret err[Fail].err{fail.in_record(err_raised_attributes.err, v.name)}; }
            ret err_raised_attributes;
        }
    }
    ret err[Fail].err{fail.about(fail.unsupported("the section holds no traits of the architecture"), a.name)};
}

# the traits the GNU property notes `data` state, the notes padded to the
# address size of the class as an object lays them out
fun raised_notes(a: *Arch, shape: Shape, data: Bytes, out: *Vector[Trait]) err[Fail] {
    var rd:           Reader                       = reader.make(nil, data.data, data.len, shape.order);
    val res_notes_of: res[opt[Vector[Note]], Fail] = read.notes_of(out.a, shape, ?rd, data.len::u64, shape.class.addr::u64);
    if (sel res_notes_of.err)     { ret err[Fail].err{res_notes_of.err}; }
    if (sel res_notes_of.ok.none) { ret err[Fail].err{fail.unsupported("the notes do not tile the section")}; }
    var notes:          Body            = Body.notes{res_notes_of.ok.some};
    var props:          property.Set    = property.init(out.a);
    var words:          Words           = traits.words_init(out.a, 0);
    var readings:       Vector[Reading] = vector.init[Reading](out.a);
    var err_notes_read: err[Fail]       = notes_read(a, shape, ?res_notes_of.ok.some, ?props, ?words, ?readings);
    if (!(sel err_notes_read.err)) { err_notes_read = contract.reconcile(?readings, nil, out); }
    err_notes_read = fail.kept(err_notes_read, vectors.dnit[Reading](?readings));
    err_notes_read = fail.kept(err_notes_read, traits.words_dnit(?words));
    err_notes_read = fail.kept(err_notes_read, property.dnit(?props));
    err_notes_read = fail.kept(err_notes_read, model.body_dnit(?notes));
    ret err_notes_read;
}

# what the GNU property notes `notes` state of the traits, as readings,
# refusing a note that holds no properties and a property, or a bit of one,
# no row of `a` maps
fun notes_read(a: *Arch, shape: Shape, notes: *Vector[Note], props: *property.Set, words: *Words, out: *Vector[Reading]) err[Fail] {
    var k: usize = 0;
    for (k < vector.length[Note](notes)) {
        val e: *Note = ?notes.data[k];
        if (!sel e.desc.properties) { ret err[Fail].err{fail.in_indexed(fail.unsupported("a note of the section holds no GNU properties"), "note", k::u64)}; }
        k = k + 1;
    }
    var count:            usize     = 0;
    val err_gather_notes: err[Fail] = property.gather_notes(notes, nil, shape.order, a, props, ?count);
    if (sel err_gather_notes.err) { ret err_gather_notes; }
    var i: usize = 0;
    for (i < vector.length[property.Merged](?props.merged)) {
        val p: *property.Merged = ?props.merged.data[i];
        i = i + 1;
        if (p.data.len != 4 || !traits.maps_property(a, p.type)) {
            ret err[Fail].err{fail.in_indexed(fail.unsupported("a GNU property no trait row maps"), "GNU property", p.type::u64)};
        }
    }
    val err_words: err[Fail] = property.words(props, words);
    if (sel err_words.err) { ret err_words; }
    val err_decode_properties: err[Fail] = traits.decode_properties(a, words, out);
    if (sel err_decode_properties.err) { ret err_decode_properties; }
    var j: usize = 0;
    for (j < vector.length[Word](?words.properties)) {
        val left: *Word = ?words.properties.data[j];
        j = j + 1;
        if (left.value != 0) { ret err[Fail].err{traits.stray(left.type, left.value::u64)}; }
    }
    ret err[Fail].ok{};
}

# the traits the build attributes section `s` states in `data`
fun raised_attributes(a: *Arch, shape: Shape, s: *attributes.Section, data: Bytes, out: *Vector[Trait]) err[Fail] {
    var parts:               Vector[Part]      = vector.init[Part](out.a);
    var list:                Vector[Attribute] = vector.init[Attribute](out.a);
    var readings:            Vector[Reading]   = vector.init[Reading](out.a);
    var left:                Vector[Unread]    = vector.init[Unread](out.a);
    var err_attributes_read: err[Fail]         = attributes_read(a, shape, s, data, ?parts, ?list, ?readings, ?left);
    if (!(sel err_attributes_read.err)) { err_attributes_read = contract.reconcile(?readings, nil, out); }
    err_attributes_read = fail.kept(err_attributes_read, vectors.dnit[Unread](?left));
    err_attributes_read = fail.kept(err_attributes_read, vectors.dnit[Reading](?readings));
    err_attributes_read = fail.kept(err_attributes_read, vectors.dnit[Attribute](?list));
    err_attributes_read = fail.kept(err_attributes_read, vectors.dnit[Part](?parts));
    ret err_attributes_read;
}

# what the build attributes in `data` state of the traits, as readings, when
# they parse and every attribute is one a row reads
fun attributes_read(a: *Arch, shape: Shape, s: *attributes.Section, data: Bytes, parts: *Vector[Part], list: *Vector[Attribute], out: *Vector[Reading], left: *Vector[Unread]) err[Fail] {
    val res_parse: res[bool, Fail] = attributes.parse(out.a, s, ?traits.VENDORS[0], traits.VENDOR_COUNT, data, shape.order, parts, list);
    if (sel res_parse.err) { ret err[Fail].err{res_parse.err}; }
    if (!res_parse.ok)     { ret err[Fail].err{fail.unsupported("the build attributes are not in the one shape mink reads")}; }
    val res_read: res[opt[Fail], Fail] = traits.read_attributes(a, s, parts, list, out, left);
    if (sel res_read.err)     { ret err[Fail].err{res_read.err}; }
    if (sel res_read.ok.some) { ret err[Fail].err{res_read.ok.some}; }
    if (vector.length[Unread](left) != 0) {
        val u: *Unread = ?left.data[0];
        ret err[Fail].err{traits.unmapped(u.vendor, u.attribute.tag)};
    }
    ret err[Fail].ok{};
}
