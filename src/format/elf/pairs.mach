# the (ELF, architecture) pairs: what ELF states for each architecture it
# names, which the ELF registration lists
#
# a record's row key is its r_type, written back as it is. every pair writes
# symbol table index 0 for a relocation that names no target, and C symbol
# names carry no prefix. the thread pointer of x86 ends the thread-local
# block, as the variant II layout of the TLS ABI has it, and the others lead
# the block with their control block, as variant I has it. an image keeps the
# assembler's local labels on x86 and AArch64, and RISC-V, whose relaxation
# makes many, leaves them out. AArch64 and RISC-V mark code and data with `$x`
# and `$d`, and x86 marks neither. the GOT base starts the GOT of the PLT on
# x86 and the GOT elsewhere, where the psABIs place `_GLOBAL_OFFSET_TABLE_`.

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail.Fail;
use mink.catalog.arch.Arch;
use mink.catalog.arch.aarch64;
use mink.catalog.arch.riscv;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.slot;
use mink.catalog.slot.GotBase;
use mink.format.elf.neutral.naming;
use elf_aarch64:   mink.format.elf.reloc.aarch64;
use elf_riscv:     mink.format.elf.reloc.riscv;
use elf_x86:       mink.format.elf.reloc.x86;
use elf_templates: mink.format.elf.templates;
use mink.format.pair;
use mink.format.pair.Mapping;
use mink.format.pair.Pair;
use mink.format.pair.Temporaries;
use mink.link.template;
use mink.link.thread.Side;
use mink.link.thread.Thread;

val VARIANT_II_X86_64: Thread = Thread{side: Side.below{}, source: "ELF Handling For Thread-Local Storage, variant II, as the x86-64 psABI adopts it"};
val VARIANT_II_X86:    Thread = Thread{side: Side.below{}, source: "ELF Handling For Thread-Local Storage, variant II, as the i386 psABI adopts it"};
val VARIANT_I_AARCH64: Thread = Thread{side: Side.above{}, tcb: 16, source: "ELF for the Arm 64-bit Architecture, thread-local storage, variant 1 with a 16 byte thread control block"};
val VARIANT_I_RISCV:   Thread = Thread{side: Side.above{}, dtp_bias: 0x800, source: "RISC-V ELF psABI, thread-local storage, variant I with the dynamic thread vector offset 0x800"};

val ARM_MAPPING:   Mapping = Mapping{code: "$x", data: "$d", per_view: false, source: "ELF for the Arm 64-bit Architecture, mapping symbols"};
val RISCV_MAPPING: Mapping = Mapping{code: "$x", data: "$d", per_view: true, source: "RISC-V ELF psABI, mapping symbol"};

val AT_GOT_PLT: GotBase = GotBase{role: ?slot.GOT_PLT, source: "the x86 psABIs, whose GOT base is the GOT that holds the PLT's reserved entries, .got.plt"};
val AT_GOT:     GotBase = GotBase{role: ?slot.GOT, source: "the AArch64 and RISC-V psABIs, whose GOT base is the start of .got"};

val KEPT:      Temporaries = Temporaries{prefix: naming.TEMPORARY, discarded: false, source: "an image keeps an input's local labels"};
val DISCARDED: Temporaries = Temporaries{prefix: naming.TEMPORARY, discarded: true, source: "RISC-V relaxation makes many local labels, so an image leaves them out"};

pub val COUNT: usize = 7;

pub val PAIRS: [COUNT]Pair = [COUNT]Pair{
    Pair{arch: ?x86.X86_64, code: ?x86.X86_64_CODES[0], key_of: pair.code_key, relocs: ?elf_x86.X86_64, templates: opt[*template.Set].some{?elf_templates.X86_64}, temporaries: opt[*Temporaries].some{?KEPT}, nameless: opt[u64].some{0}, thread: opt[*Thread].some{?VARIANT_II_X86_64}, got: opt[*GotBase].some{?AT_GOT_PLT}},
    Pair{arch: ?x86.X86, code: ?x86.X86_CODES[0], key_of: pair.code_key, relocs: ?elf_x86.X86, templates: opt[*template.Set].some{?elf_templates.X86}, temporaries: opt[*Temporaries].some{?KEPT}, nameless: opt[u64].some{0}, thread: opt[*Thread].some{?VARIANT_II_X86}, got: opt[*GotBase].some{?AT_GOT_PLT}},
    Pair{arch: ?aarch64.AARCH64, code: ?aarch64.AARCH64_CODES[0], key_of: pair.code_key, relocs: ?elf_aarch64.SET, templates: opt[*template.Set].some{?elf_templates.AARCH64}, temporaries: opt[*Temporaries].some{?KEPT}, nameless: opt[u64].some{0}, thread: opt[*Thread].some{?VARIANT_I_AARCH64}, mapping: opt[*Mapping].some{?ARM_MAPPING}, got: opt[*GotBase].some{?AT_GOT}},
    Pair{arch: ?riscv.RISCV64, code: ?riscv.RV64_CODES[0], key_of: pair.code_key, relocs: ?elf_riscv.RV64, templates: opt[*template.Set].some{?elf_templates.RV64}, temporaries: opt[*Temporaries].some{?DISCARDED}, nameless: opt[u64].some{0}, thread: opt[*Thread].some{?VARIANT_I_RISCV}, mapping: opt[*Mapping].some{?RISCV_MAPPING}, got: opt[*GotBase].some{?AT_GOT}},
    Pair{arch: ?riscv.RISCV32, code: ?riscv.RV32_CODES[0], key_of: pair.code_key, relocs: ?elf_riscv.RV32, templates: opt[*template.Set].some{?elf_templates.RV32}, temporaries: opt[*Temporaries].some{?DISCARDED}, nameless: opt[u64].some{0}, thread: opt[*Thread].some{?VARIANT_I_RISCV}, mapping: opt[*Mapping].some{?RISCV_MAPPING}, got: opt[*GotBase].some{?AT_GOT}},
    Pair{arch: ?riscv.RISCV64E, code: ?riscv.RV64E_CODES[0], key_of: pair.code_key, relocs: ?elf_riscv.RV64E, temporaries: opt[*Temporaries].some{?DISCARDED}, nameless: opt[u64].some{0}, thread: opt[*Thread].some{?VARIANT_I_RISCV}, mapping: opt[*Mapping].some{?RISCV_MAPPING}, got: opt[*GotBase].some{?AT_GOT}},
    Pair{arch: ?riscv.RISCV32E, code: ?riscv.RV32E_CODES[0], key_of: pair.code_key, relocs: ?elf_riscv.RV32E, temporaries: opt[*Temporaries].some{?DISCARDED}, nameless: opt[u64].some{0}, thread: opt[*Thread].some{?VARIANT_I_RISCV}, mapping: opt[*Mapping].some{?RISCV_MAPPING}, got: opt[*GotBase].some{?AT_GOT}},
};

# the pair of `a`
pub fun of(a: *Arch) res[*Pair, Fail] {
    ret pair.of(?format.ELF, ?PAIRS[0], COUNT, a);
}
