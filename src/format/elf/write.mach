# e_ident class and data encoding values
val ELFCLASS32:  u8 = 1;
val ELFCLASS64:  u8 = 2;
val ELFDATA2LSB: u8 = 1;
val ELFDATA2MSB: u8 = 2;

# the width of a note name's padding, whatever the section's alignment
val NOTE_NAME_ALIGN: u64 = 4;

val LABEL_HEADER:   str = "file header";
val LABEL_SEGMENTS: str = "program header table";
val LABEL_SECTIONS: str = "section header table";
val LABEL_SECTION:  str = "section contents";
val LABEL_RAW:      str = "raw bytes";

# the file being written
# ---
# a:        the allocator of the output and the working tables
# m:        the model
# c:        its class
# built:    whether the model held no extents and is laid out here
# items:    the extents to write, the model's or the ones laid out here
# synth:    the extents laid out here
# ids:      the region of each extent
# layout:   the sealed plan
# laid:     whether the plan was sealed
# segments: whether the program header table was placed
# sections: whether the section header table was placed
# seen:     per section, whether its contents were placed
rec Job {
    a:        *A.Allocator;
    m:        *Elf;
    c:        *Class;
    built:    bool;
    items:    *Vector[Extent];
    synth:    Vector[Extent];
    ids:      Vector[Id[Region]];
    layout:   Layout;
    laid:     bool;
    segments: bool;
    sections: bool;
    seen:     Vector[u8];
}

# write `m` as an ELF file in its class and byte order. a model with no
# extents is laid out and completed: its offsets, lengths and header counts
# are set to what was written
pub fun write(a: *A.Allocator, m: *Elf) res[Sink, Fail] {
    var j: Job = Job{
        a:     a,
        m:     m,
        c:     m.shape.class,
        synth: vector.init[Extent](a),
        ids:   vector.init[Id[Region]](a),
        seen:  vector.init[u8](a),
    };
    var out:         Sink      = sink.init(a, m.shape.order);
    val err_out_run: err[Fail] = run(?j, ?out);
    val err_rel:     err[Fail] = finish(?j);
    if (sel err_out_run.err) {
        val err_dropped: err[Fail] = sink.dnit(?out);
        ret res[Sink, Fail].err{err_out_run.err};
    }
    if (sel err_rel.err) {
        val err_dropped: err[Fail] = sink.dnit(?out);
        ret res[Sink, Fail].err{err_rel.err};
    }
    ret res[Sink, Fail].ok{out};
}

# append to `out` the bytes section `index` of `m` holds, its body written as
# `write` writes it. a section with no bytes appends none
pub fun section_bytes(a: *A.Allocator, m: *Elf, index: u32, out: *Sink) err[Fail] {
    var j: Job      = Job{a: a, m: m, c: m.shape.class};
    val s: *Section = model.section_at(m, table.nth[Section](index::usize));
    if (!holds(s)) { ret err[Fail].err{fail.in_indexed(fail.malformed("section holds no bytes"), LABEL_SECTION, index::u64)}; }
    val res_size: res[u64, Fail] = body_size(?j, s);
    if (sel res_size.err) { ret err[Fail].err{fail.in_indexed(res_size.err, LABEL_SECTION, index::u64)}; }
    val res_to_usize: res[usize, Fail] = checked.to_usize(Location{}, res_size.ok);
    if (sel res_to_usize.err) { ret err[Fail].err{fail.in_indexed(res_to_usize.err, LABEL_SECTION, index::u64)}; }
    val start:     usize     = sink.len(out);
    val err_zeros: err[Fail] = sink.zeros(out, res_to_usize.ok);
    if (sel err_zeros.err) { ret err_zeros; }
    val res_written: res[u64, Fail] = put_body(?j, s, at_pos(sink.data(out), start::u64));
    if (sel res_written.err)           { ret err[Fail].err{fail.in_indexed(res_written.err, LABEL_SECTION, index::u64)}; }
    if (res_written.ok != res_size.ok) { ret err[Fail].err{fail.in_indexed(fail.internal("section body wrote other than its size"), LABEL_SECTION, index::u64)}; }
    ret err[Fail].ok{};
}

fun finish(j: *Job) err[Fail] {
    var err_first: err[Fail] = vectors.dnit[Extent](?j.synth);
    err_first = fail.kept(err_first, vectors.dnit[Id[Region]](?j.ids));
    err_first = fail.kept(err_first, vectors.dnit[u8](?j.seen));
    if (j.laid) { err_first = fail.kept(err_first, plan.layout_dnit(?j.layout)); }
    ret err_first;
}

fun run(j: *Job, out: *Sink) err[Fail] {
    j.items = ?j.m.extents;
    j.built = vector.length[Extent](?j.m.extents) == 0;
    if (j.built) {
        val err_arrange: err[Fail] = arrange(j);
        if (sel err_arrange.err) { ret err_arrange; }
    }
    val err_check: err[Fail] = check(j);
    if (sel err_check.err) { ret err_check; }
    val err_place_all: err[Fail] = place_all(j);
    if (sel err_place_all.err) { ret err_place_all; }
    if (j.built)               { fixup(j); }
    ret emit(j, out);
}

# give a model with no extents its header sizes and counts and the extents it
# is laid out in
fun arrange(j: *Job) err[Fail] {
    val c:    *Class = j.c;
    val m:    *Elf   = j.m;
    val nseg: usize  = table.count[Segment](?m.segments);
    val nsec: usize  = table.count[Section](?m.sections);
    m.header.ehsize    = c.header.size::u16;
    m.header.phentsize = 0;
    m.header.shentsize = 0;
    if (nseg != 0) { m.header.phentsize = c.segment.size::u16; }
    if (nsec != 0) { m.header.shentsize = c.section.size::u16; }
    val res_strings: res[opt[Id[Section]], Fail] = model.section_names(m);
    if (sel res_strings.err) { ret err[Fail].err{res_strings.err}; }
    val err_numbered: err[Fail] = model.renumber(m, res_strings.ok);
    if (sel err_numbered.err) { ret err_numbered; }
    j.items = ?j.synth;
    val err_synth_pushed: err[Fail] = vectors.push[Extent](?j.synth, Extent.header{});
    if (sel err_synth_pushed.err) { ret err[Fail].err{err_synth_pushed.err}; }
    if (nseg != 0) {
        val err_synth_pushed: err[Fail] = vectors.push[Extent](?j.synth, Extent.segments{});
        if (sel err_synth_pushed.err) { ret err[Fail].err{err_synth_pushed.err}; }
    }
    var i: usize = 0;
    for (i < nsec) {
        val s: *Section = model.section_at(m, table.nth[Section](i));
        if (sel s.body.overlaid) {
            ret err[Fail].err{fail.in_indexed(fail.unsupported("a section overlaying another cannot be laid out"), "section header", i::u64)};
        }
        if (!sel s.body.empty) {
            val err_synth_pushed: err[Fail] = vectors.push[Extent](?j.synth, Extent.section{table.nth[Section](i)});
            if (sel err_synth_pushed.err) { ret err[Fail].err{err_synth_pushed.err}; }
        }
        i = i + 1;
    }
    if (nsec != 0) {
        val err_synth_pushed: err[Fail] = vectors.push[Extent](?j.synth, Extent.sections{});
        if (sel err_synth_pushed.err) { ret err[Fail].err{err_synth_pushed.err}; }
    }
    ret err[Fail].ok{};
}

# the counts and sizes the header states must match the tables
fun check(j: *Job) err[Fail] {
    val c:    *Class = j.c;
    val m:    *Elf   = j.m;
    val nseg: usize  = table.count[Segment](?m.segments);
    val nsec: usize  = table.count[Section](?m.sections);
    if (!j.built) {
        val res_segs: res[u64, Fail] = model.segment_count(m);
        if (sel res_segs.err) { ret err[Fail].err{res_segs.err}; }
        if (res_segs.ok != nseg::u64) {
            ret err[Fail].err{fail.in_record(fail.malformed("program header count does not match the program headers"), LABEL_HEADER)};
        }
        val res_secs: res[u64, Fail] = model.section_count(m);
        if (sel res_secs.err) { ret err[Fail].err{res_secs.err}; }
        if (res_secs.ok != nsec::u64) {
            ret err[Fail].err{fail.in_record(fail.malformed("section count does not match the section headers"), LABEL_HEADER)};
        }
        if (nseg != 0 && m.header.phentsize::usize != c.segment.size) {
            ret err[Fail].err{fail.in_record(fail.malformed("program header size does not match the class"), LABEL_HEADER)};
        }
        if (nsec != 0 && m.header.shentsize::usize != c.section.size) {
            ret err[Fail].err{fail.in_record(fail.malformed("section header size does not match the class"), LABEL_HEADER)};
        }
    }
    val res_names: res[opt[Id[Section]], Fail] = model.section_names(m);
    if (sel res_names.err) { ret err[Fail].err{res_names.err}; }
    ret err[Fail].ok{};
}

fun limit(c: *Class) u64 {
    if (c.addr == 4) { ret plan.LIMIT_32; }
    ret plan.LIMIT_64;
}

fun place_all(j: *Job) err[Fail] {
    var p:               Plan      = plan.init(j.a, limit(j.c));
    val err_place_items: err[Fail] = place_items(j, ?p);
    val err_release:     err[Fail] = plan.dnit(?p);
    if (sel err_place_items.err) { ret err_place_items; }
    ret err_release;
}

fun place_items(j: *Job, p: *Plan) err[Fail] {
    val nseg:     usize     = table.count[Segment](?j.m.segments);
    val nsec:     usize     = table.count[Section](?j.m.sections);
    val count:    usize     = vector.length[Extent](j.items);
    val err_grow: err[Fail] = vectors.grow[u8](?j.seen, nsec);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var i: usize = 0;
    for (i < count) {
        val e:              *Extent               = ?j.items.data[i];
        val res_place_item: res[Id[Region], Fail] = place_item(j, p, e, i);
        if (sel res_place_item.err) { ret err[Fail].err{res_place_item.err}; }
        val err_pushed: err[Fail] = vectors.push[Id[Region]](?j.ids, res_place_item.ok);
        if (sel err_pushed.err) { ret err[Fail].err{err_pushed.err}; }
        i = i + 1;
    }
    if (nseg != 0 && !j.segments) {
        ret err[Fail].err{fail.in_record(fail.malformed("program headers with no extent for their table"), LABEL_SEGMENTS)};
    }
    if (nsec != 0 && !j.sections) {
        ret err[Fail].err{fail.in_record(fail.malformed("section headers with no extent for their table"), LABEL_SECTIONS)};
    }
    var k: usize = 0;
    for (k < nsec) {
        val s: *Section = model.section_at(j.m, table.nth[Section](k));
        if (holds(s) && j.seen.data[k] == 0) {
            ret err[Fail].err{fail.in_indexed(fail.malformed("section contents with no extent"), LABEL_SECTION, k::u64)};
        }
        k = k + 1;
    }
    val res_sealed: res[Layout, Fail] = plan.seal(p);
    if (sel res_sealed.err) { ret err[Fail].err{res_sealed.err}; }
    j.layout = res_sealed.ok;
    j.laid   = true;
    ret err[Fail].ok{};
}

# whether a section's body places bytes in the file
fun holds(s: *Section) bool {
    ret !sel s.body.empty && !sel s.body.overlaid;
}

fun place_item(j: *Job, p: *Plan, e: *Extent, index: usize) res[Id[Region], Fail] {
    val c:        *Class   = j.c;
    val opt_none: opt[u32] = opt[u32].none{};
    if (index == 0 && !sel e.header) {
        ret res[Id[Region], Fail].err{fail.in_record(fail.malformed("the first extent is not the file header"), LABEL_HEADER)};
    }
    if (sel e.header) {
        if (index != 0) {
            ret res[Id[Region], Fail].err{fail.in_record(fail.malformed("the file header is not the first extent"), LABEL_HEADER)};
        }
        ret plan.place_at(p, LABEL_HEADER, opt_none, 0, c.header.size::u64);
    }
    if (sel e.segments) {
        val n: usize = table.count[Segment](?j.m.segments);
        if (j.segments || n == 0) {
            ret res[Id[Region], Fail].err{fail.in_record(fail.malformed("extent for a program header table that is not there or is repeated"), LABEL_SEGMENTS)};
        }
        j.segments = true;
        val res_size: res[u64, Fail] = checked.mul(Location{record: LABEL_SEGMENTS}, n::u64, c.segment.size::u64);
        if (sel res_size.err) { ret res[Id[Region], Fail].err{res_size.err}; }
        ret arranged(j, p, LABEL_SEGMENTS, opt_none, j.m.header.phoff, c.addr::u64, res_size.ok);
    }
    if (sel e.sections) {
        val n: usize = table.count[Section](?j.m.sections);
        if (j.sections || n == 0) {
            ret res[Id[Region], Fail].err{fail.in_record(fail.malformed("extent for a section header table that is not there or is repeated"), LABEL_SECTIONS)};
        }
        j.sections = true;
        val res_size: res[u64, Fail] = checked.mul(Location{record: LABEL_SECTIONS}, n::u64, c.section.size::u64);
        if (sel res_size.err) { ret res[Id[Region], Fail].err{res_size.err}; }
        ret arranged(j, p, LABEL_SECTIONS, opt_none, j.m.header.shoff, c.addr::u64, res_size.ok);
    }
    if (sel e.section) {
        val idx: u32 = e.section.index;
        if (idx::usize >= table.count[Section](?j.m.sections)) {
            ret res[Id[Region], Fail].err{fail.in_record(fail.internal("extent names a section past the section headers"), LABEL_SECTION)};
        }
        val s:    *Section = model.section_at(j.m, e.section);
        val seen: *u8      = ?j.seen.data[idx::usize];
        if (!holds(s) || @seen != 0) {
            ret res[Id[Region], Fail].err{fail.in_indexed(fail.malformed("extent for a section with no contents or one that is repeated"), LABEL_SECTION, idx::u64)};
        }
        @seen = 1;
        val res_size: res[u64, Fail] = body_size(j, s);
        if (sel res_size.err) { ret res[Id[Region], Fail].err{fail.in_indexed(res_size.err, LABEL_SECTION, idx::u64)}; }
        if (!j.built && s.length != res_size.ok) {
            ret res[Id[Region], Fail].err{fail.in_indexed(fail.malformed("section length does not match its contents"), LABEL_SECTION, idx::u64)};
        }
        var align: u64 = s.addralign;
        if (align == 0) { align = 1; }
        ret arranged(j, p, LABEL_SECTION, opt[u32].some{idx}, s.offset, align, res_size.ok);
    }
    if (sel e.raw) {
        ret plan.place(p, LABEL_RAW, opt_none, 1, held_size(j, ?e.raw.bytes));
    }
    ret res[Id[Region], Fail].err{fail.internal("unknown extent")};
}

# a region placed at the alignment it asks for in a model laid out here, and
# at the offset its model records otherwise
fun arranged(j: *Job, p: *Plan, label: str, section: opt[u32], recorded: u64, align: u64, size: u64) res[Id[Region], Fail] {
    if (j.built) { ret plan.place(p, label, section, align, size); }
    if (recorded > plan.cursor(p)) {
        ret res[Id[Region], Fail].err{fail.at_offset(fail.in_record(fail.malformed("region starts past the end of the extents ahead of it"), label), recorded)};
    }
    ret plan.place_at(p, label, section, recorded, size);
}

# the offsets and lengths the plan fixed for a model laid out here
fun fixup(j: *Job) {
    var i: usize = 0;
    for (i < vector.length[Extent](j.items)) {
        val e: *Extent = ?j.items.data[i];
        val r: Region  = plan.region_of(?j.layout, j.ids.data[i]);
        if (sel e.segments) { j.m.header.phoff = r.offset; }
        if (sel e.sections) { j.m.header.shoff = r.offset; }
        if (sel e.section) {
            val s: *Section = model.section_at(j.m, e.section);
            s.offset = r.offset;
            s.length = r.size;
        }
        i = i + 1;
    }
}

fun emit(j: *Job, out: *Sink) err[Fail] {
    val res_to_usize: res[usize, Fail] = checked.to_usize(Location{}, plan.total(?j.layout));
    if (sel res_to_usize.err) { ret err[Fail].err{res_to_usize.err}; }
    val err_zeros: err[Fail] = sink.zeros(out, res_to_usize.ok);
    if (sel err_zeros.err) { ret err_zeros; }
    val base: *u8   = sink.data(out);
    var i:    usize = 0;
    for (i < vector.length[Extent](j.items)) {
        val e:              *Extent    = ?j.items.data[i];
        val id:             Id[Region] = j.ids.data[i];
        val r:              Region     = plan.region_of(?j.layout, id);
        val at:             *u8        = ?base[r.offset::usize];
        var err_put_header: err[Fail]  = err[Fail].ok{};
        if (sel e.header)   { err_put_header = put_header(j, at); }
        if (sel e.segments) { err_put_header = put_segments(j, at); }
        if (sel e.sections) { err_put_header = put_sections(j, at); }
        if (sel e.raw)      { err_put_header = put_held(j, ?e.raw.bytes, r.size, at, LABEL_RAW); }
        if (sel e.section) {
            val s:           *Section       = model.section_at(j.m, e.section);
            val res_written: res[u64, Fail] = put_body(j, s, at);
            if (sel res_written.err) { ret err[Fail].err{fail.in_indexed(res_written.err, LABEL_SECTION, e.section.index::u64)}; }
            err_put_header = plan.close_size(?j.layout, id, res_written.ok);
        }
        if (sel err_put_header.err) { ret err_put_header; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun ident_class(c: *Class) u8 {
    if (c == ?model.CLASS32) { ret ELFCLASS32; }
    ret ELFCLASS64;
}

fun ident_data(o: Order) u8 {
    if (o == LITTLE) { ret ELFDATA2LSB; }
    ret ELFDATA2MSB;
}

fun put_header(j: *Job, p: *u8) err[Fail] {
    val c: *Class        = j.c;
    val h: *model.Header = ?j.m.header;
    val o: Order         = j.m.shape.order;
    p[0] = 0x7f;
    p[1] = 'E';
    p[2] = 'L';
    p[3] = 'F';
    var w: slot.Cell = slot.cell(p, o);
    slot.put(?w, model.IDENT.class, ident_class(c)::u64);
    slot.put(?w, model.IDENT.data, ident_data(o)::u64);
    slot.put(?w, model.IDENT.version, h.ident.version::u64);
    slot.put(?w, model.IDENT.osabi, h.ident.osabi::u64);
    slot.put(?w, model.IDENT.abiversion, h.ident.abiversion::u64);
    var i: usize = 0;
    for (i < model.IDENT.pad.width::usize) {
        p[model.IDENT.pad.offset::usize + i] = h.ident.pad[i];
        i                                    = i + 1;
    }
    slot.put(?w, c.header.type, h.type::u64);
    slot.put(?w, c.header.machine, h.machine::u64);
    slot.put(?w, c.header.version, h.version::u64);
    slot.put(?w, c.header.entry, h.entry);
    slot.put(?w, c.header.phoff, h.phoff);
    slot.put(?w, c.header.shoff, h.shoff);
    slot.put(?w, c.header.flags, h.flags::u64);
    slot.put(?w, c.header.ehsize, h.ehsize::u64);
    slot.put(?w, c.header.phentsize, h.phentsize::u64);
    slot.put(?w, c.header.phnum, h.phnum::u64);
    slot.put(?w, c.header.shentsize, h.shentsize::u64);
    slot.put(?w, c.header.shnum, h.shnum::u64);
    slot.put(?w, c.header.shstrndx, h.shstrndx::u64);
    if (w.bad) { ret err[Fail].err{fail.in_record(w.first, LABEL_HEADER)}; }
    ret err[Fail].ok{};
}

fun at_pos(base: *u8, pos: u64) *u8 {
    ret ?base[pos::usize];
}

fun put_segments(j: *Job, p: *u8) err[Fail] {
    val c: *Class = j.c;
    val n: usize  = table.count[Segment](?j.m.segments);
    var i: usize  = 0;
    for (i < n) {
        val s: *Segment  = model.segment_at(j.m, table.nth[Segment](i));
        var w: slot.Cell = slot.cell(at_pos(p, i::u64 * c.segment.size::u64), j.m.shape.order);
        slot.put(?w, c.segment.type, s.type::u64);
        slot.put(?w, c.segment.flags, s.flags::u64);
        slot.put(?w, c.segment.offset, s.offset);
        slot.put(?w, c.segment.vaddr, s.vaddr);
        slot.put(?w, c.segment.paddr, s.paddr);
        slot.put(?w, c.segment.filesz, s.filesz);
        slot.put(?w, c.segment.memsz, s.memsz);
        slot.put(?w, c.segment.align, s.align);
        val err_done: err[Fail] = slot.done(?w, "program header", i::u64);
        if (sel err_done.err) { ret err_done; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun put_sections(j: *Job, p: *u8) err[Fail] {
    val c: *Class = j.c;
    val n: usize  = table.count[Section](?j.m.sections);
    var i: usize  = 0;
    for (i < n) {
        val s: *Section  = model.section_at(j.m, table.nth[Section](i));
        var w: slot.Cell = slot.cell(at_pos(p, i::u64 * c.section.size::u64), j.m.shape.order);
        slot.put(?w, c.section.name, s.name::u64);
        slot.put(?w, c.section.type, s.type::u64);
        slot.put(?w, c.section.flags, s.flags);
        slot.put(?w, c.section.addr, s.addr);
        slot.put(?w, c.section.offset, s.offset);
        slot.put(?w, c.section.length, s.length);
        slot.put(?w, c.section.link, s.link::u64);
        slot.put(?w, c.section.info, s.info::u64);
        slot.put(?w, c.section.addralign, s.addralign);
        slot.put(?w, c.section.entsize, s.entsize);
        val err_done: err[Fail] = slot.done(?w, "section header", i::u64);
        if (sel err_done.err) { ret err_done; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# `want` bytes of `h` at `dst`
fun put_held(j: *Job, h: *Held, want: u64, dst: *u8, what: str) err[Fail] {
    val b: Bytes = model.bytes(j.m, h);
    if (b.len::u64 != want) { ret err[Fail].err{fail.in_record(fail.malformed("held bytes do not match the size stated for them"), what)}; }
    if (b.len != 0)         { memory.copy[u8](dst, b.data, b.len); }
    ret err[Fail].ok{};
}

fun held_size(j: *Job, h: *Held) u64 {
    ret model.bytes(j.m, h).len::u64;
}

# `n` records of `size` bytes
fun times(n: usize, size: usize) res[u64, Fail] {
    ret checked.mul(Location{}, n::u64, size::u64);
}

fun up(v: u64, align: u64) res[u64, Fail] {
    ret checked.align_up(Location{}, v, align);
}

fun sum(a: res[u64, Fail], b: u64) res[u64, Fail] {
    if (sel a.err) { ret a; }
    ret checked.add(Location{}, a.ok, b);
}

# the bytes a section's body writes
fun body_size(j: *Job, s: *Section) res[u64, Fail] {
    val c: *Class = j.c;
    if (sel s.body.raw)     { ret res[u64, Fail].ok{held_size(j, ?s.body.raw.bytes)}; }
    if (sel s.body.symbols) { ret times(table.count[Symbol](?s.body.symbols), c.symbol.size); }
    if (sel s.body.rel)     { ret times(table.count[Rel](?s.body.rel), c.rel.size); }
    if (sel s.body.rela)    { ret times(table.count[Rela](?s.body.rela), c.rela.size); }
    if (sel s.body.relr)    { ret times(vector.length[u64](?s.body.relr), c.addr); }
    if (sel s.body.dynamic) { ret times(table.count[Dyn](?s.body.dynamic), c.dyn.size); }
    if (sel s.body.shndx)   { ret times(vector.length[u32](?s.body.shndx), model.WORD); }
    if (sel s.body.versym)  { ret times(vector.length[u16](?s.body.versym), model.HALF); }
    if (sel s.body.verdef)  { ret definitions_size(?s.body.verdef); }
    if (sel s.body.verneed) { ret needs_size(?s.body.verneed); }
    if (sel s.body.notes)   { ret notes_size(j, s, ?s.body.notes); }
    if (sel s.body.group) {
        val res_members: res[u64, Fail] = times(vector.length[u32](?s.body.group.members), model.WORD);
        ret sum(res_members, model.WORD::u64);
    }
    if (sel s.body.hash) {
        val res_words: res[u64, Fail] = times(vector.length[u32](?s.body.hash.buckets) + vector.length[u32](?s.body.hash.chains), model.WORD);
        ret sum(res_words, 8);
    }
    if (sel s.body.gnu_hash) { ret gnu_hash_size(j, ?s.body.gnu_hash); }
    if (sel s.body.compressed) {
        ret res[u64, Fail].ok{c.chdr.size::u64 + held_size(j, ?s.body.compressed.data)};
    }
    ret res[u64, Fail].ok{0};
}

fun definitions_size(t: *Table[Definition]) res[u64, Fail] {
    var total: u64   = 0;
    var i:     usize = 0;
    for (i < table.count[Definition](t)) {
        val e:    *Definition = table.at[Definition](t, table.nth[Definition](i));
        var size: usize       = model.VERDAUX.size;
        if (sel e.verdef) { size = model.VERDEF.size; }
        val res_next: res[u64, Fail] = checked.add(Location{}, total, size::u64);
        if (sel res_next.err) { ret res_next; }
        total = res_next.ok;
        i     = i + 1;
    }
    ret res[u64, Fail].ok{total};
}

fun needs_size(t: *Table[Need]) res[u64, Fail] {
    var total: u64   = 0;
    var i:     usize = 0;
    for (i < table.count[Need](t)) {
        val e:    *Need = table.at[Need](t, table.nth[Need](i));
        var size: usize = model.VERNAUX.size;
        if (sel e.verneed) { size = model.VERNEED.size; }
        val res_next: res[u64, Fail] = checked.add(Location{}, total, size::u64);
        if (sel res_next.err) { ret res_next; }
        total = res_next.ok;
        i     = i + 1;
    }
    ret res[u64, Fail].ok{total};
}

fun gnu_hash_size(j: *Job, g: *GnuHash) res[u64, Fail] {
    val res_bloom: res[u64, Fail] = times(vector.length[u64](?g.bloom), j.c.addr);
    val res_words: res[u64, Fail] = times(vector.length[u32](?g.buckets) + vector.length[u32](?g.chain), model.WORD);
    if (sel res_bloom.err) { ret res_bloom; }
    if (sel res_words.err) { ret res_words; }
    val res_fixed: res[u64, Fail] = checked.add(Location{}, res_bloom.ok, res_words.ok);
    ret sum(res_fixed, 16);
}

# the alignment a note section pads its descriptors to
fun note_align(s: *Section) res[u64, Fail] {
    if (s.addralign != 4 && s.addralign != 8) {
        ret res[u64, Fail].err{fail.in_record(fail.unsupported("note section alignment must be 4 or 8"), LABEL_SECTION)};
    }
    ret res[u64, Fail].ok{s.addralign};
}

fun notes_size(j: *Job, s: *Section, t: *Vector[Note]) res[u64, Fail] {
    val res_align: res[u64, Fail] = note_align(s);
    if (sel res_align.err) { ret res_align; }
    var total: u64   = 0;
    var i:     usize = 0;
    for (i < vector.length[Note](t)) {
        val n:        *Note          = ?t.data[i];
        val res_name: res[u64, Fail] = up(n.namesz::u64, NOTE_NAME_ALIGN);
        val res_desc: res[u64, Fail] = up(n.descsz::u64, res_align.ok);
        if (sel res_name.err) { ret res_name; }
        if (sel res_desc.err) { ret res_desc; }
        val res_head: res[u64, Fail] = checked.add(Location{}, model.NOTE.size::u64, res_name.ok);
        if (sel res_head.err) { ret res_head; }
        val res_one: res[u64, Fail] = checked.add(Location{}, res_head.ok, res_desc.ok);
        if (sel res_one.err) { ret res_one; }
        val res_next: res[u64, Fail] = checked.add(Location{}, total, res_one.ok);
        if (sel res_next.err) { ret res_next; }
        total = res_next.ok;
        i     = i + 1;
    }
    ret res[u64, Fail].ok{total};
}

# write a section's body at `p`, returning the bytes written
fun put_body(j: *Job, s: *Section, p: *u8) res[u64, Fail] {
    if (sel s.body.raw) {
        val size:         u64       = held_size(j, ?s.body.raw.bytes);
        val err_put_held: err[Fail] = put_held(j, ?s.body.raw.bytes, size, p, LABEL_SECTION);
        if (sel err_put_held.err) { ret res[u64, Fail].err{err_put_held.err}; }
        ret res[u64, Fail].ok{size};
    }
    if (sel s.body.symbols)    { ret put_symbols(j, ?s.body.symbols, p); }
    if (sel s.body.rel)        { ret put_rels(j, ?s.body.rel, p); }
    if (sel s.body.rela)       { ret put_relas(j, ?s.body.rela, p); }
    if (sel s.body.relr)       { ret put_words(j, ?s.body.relr, j.c.addr, p); }
    if (sel s.body.dynamic)    { ret put_dynamics(j, ?s.body.dynamic, p); }
    if (sel s.body.shndx)      { ret put_u32s(j, ?s.body.shndx, p, 0); }
    if (sel s.body.versym)     { ret put_versyms(j, ?s.body.versym, p); }
    if (sel s.body.verdef)     { ret put_definitions(j, ?s.body.verdef, p); }
    if (sel s.body.verneed)    { ret put_needs(j, ?s.body.verneed, p); }
    if (sel s.body.notes)      { ret put_notes(j, s, ?s.body.notes, p); }
    if (sel s.body.group)      { ret put_group(j, ?s.body.group, p); }
    if (sel s.body.hash)       { ret put_hash(j, ?s.body.hash, p); }
    if (sel s.body.gnu_hash)   { ret put_gnu_hash(j, ?s.body.gnu_hash, p); }
    if (sel s.body.compressed) { ret put_compressed(j, ?s.body.compressed, p); }
    ret res[u64, Fail].ok{0};
}

fun put_symbols(j: *Job, t: *Table[Symbol], p: *u8) res[u64, Fail] {
    val c:     *Class  = j.c;
    val items: *Symbol = table.items[Symbol](t);
    val n:     usize   = table.count[Symbol](t);
    var k:     usize   = 0;
    for (k < n) {
        val e: *Symbol   = ?items[k];
        var w: slot.Cell = slot.cell(at_pos(p, k::u64 * c.symbol.size::u64), j.m.shape.order);
        slot.put(?w, c.symbol.name, e.name::u64);
        slot.put(?w, c.symbol.info, e.info::u64);
        slot.put(?w, c.symbol.other, e.other::u64);
        slot.put(?w, c.symbol.shndx, e.shndx::u64);
        slot.put(?w, c.symbol.value, e.value);
        slot.put(?w, c.symbol.bytes, e.bytes);
        val err_done: err[Fail] = slot.done(?w, "symbol", k::u64);
        if (sel err_done.err) { ret res[u64, Fail].err{err_done.err}; }
        k = k + 1;
    }
    ret res[u64, Fail].ok{n::u64 * c.symbol.size::u64};
}

fun put_rels(j: *Job, t: *Table[Rel], p: *u8) res[u64, Fail] {
    val c:     *Class = j.c;
    val items: *Rel   = table.items[Rel](t);
    val n:     usize  = table.count[Rel](t);
    var k:     usize  = 0;
    for (k < n) {
        var w: slot.Cell = slot.cell(at_pos(p, k::u64 * c.rel.size::u64), j.m.shape.order);
        slot.put(?w, c.rel.offset, items[k].offset);
        slot.put(?w, c.rel.info, items[k].info);
        val err_done: err[Fail] = slot.done(?w, "relocation", k::u64);
        if (sel err_done.err) { ret res[u64, Fail].err{err_done.err}; }
        k = k + 1;
    }
    ret res[u64, Fail].ok{n::u64 * c.rel.size::u64};
}

fun put_relas(j: *Job, t: *Table[Rela], p: *u8) res[u64, Fail] {
    val c:     *Class = j.c;
    val items: *Rela  = table.items[Rela](t);
    val n:     usize  = table.count[Rela](t);
    var k:     usize  = 0;
    for (k < n) {
        var w: slot.Cell = slot.cell(at_pos(p, k::u64 * c.rela.size::u64), j.m.shape.order);
        slot.put(?w, c.rela.offset, items[k].offset);
        slot.put(?w, c.rela.info, items[k].info);
        slot.put_signed(?w, c.rela.addend, items[k].addend);
        val err_done: err[Fail] = slot.done(?w, "relocation", k::u64);
        if (sel err_done.err) { ret res[u64, Fail].err{err_done.err}; }
        k = k + 1;
    }
    ret res[u64, Fail].ok{n::u64 * c.rela.size::u64};
}

fun put_dynamics(j: *Job, t: *Table[Dyn], p: *u8) res[u64, Fail] {
    val c:     *Class = j.c;
    val items: *Dyn   = table.items[Dyn](t);
    val n:     usize  = table.count[Dyn](t);
    var k:     usize  = 0;
    for (k < n) {
        var w: slot.Cell = slot.cell(at_pos(p, k::u64 * c.dyn.size::u64), j.m.shape.order);
        slot.put_signed(?w, c.dyn.kind, items[k].kind);
        slot.put(?w, c.dyn.value, items[k].value);
        val err_done: err[Fail] = slot.done(?w, "dynamic entry", k::u64);
        if (sel err_done.err) { ret res[u64, Fail].err{err_done.err}; }
        k = k + 1;
    }
    ret res[u64, Fail].ok{n::u64 * c.dyn.size::u64};
}

# the words of `t`, each `width` bytes
fun put_words(j: *Job, t: *Vector[u64], width: usize, p: *u8) res[u64, Fail] {
    val items: *u64  = t.data;
    val n:     usize = vector.length[u64](t);
    var k:     usize = 0;
    for (k < n) {
        var w: slot.Cell = slot.cell(at_pos(p, k::u64 * width::u64), j.m.shape.order);
        slot.put(?w, Slot{offset: 0, width: width::u8}, items[k]);
        val err_done: err[Fail] = slot.done(?w, "word", k::u64);
        if (sel err_done.err) { ret res[u64, Fail].err{err_done.err}; }
        k = k + 1;
    }
    ret res[u64, Fail].ok{n::u64 * width::u64};
}

# the 32-bit words of `t` after `skip` bytes
fun put_u32s(j: *Job, t: *Vector[u32], p: *u8, skip: u64) res[u64, Fail] {
    val items: *u32  = t.data;
    val n:     usize = vector.length[u32](t);
    var k:     usize = 0;
    for (k < n) {
        binary.put_uint(at_pos(p, skip + k::u64 * model.WORD::u64), items[k]::u64, model.WORD, j.m.shape.order);
        k = k + 1;
    }
    ret res[u64, Fail].ok{skip + n::u64 * model.WORD::u64};
}

fun put_versyms(j: *Job, t: *Vector[u16], p: *u8) res[u64, Fail] {
    val items: *u16  = t.data;
    val n:     usize = vector.length[u16](t);
    var k:     usize = 0;
    for (k < n) {
        binary.put_uint(at_pos(p, k::u64 * model.HALF::u64), items[k]::u64, model.HALF, j.m.shape.order);
        k = k + 1;
    }
    ret res[u64, Fail].ok{n::u64 * model.HALF::u64};
}

fun put_group(j: *Job, g: *Group, p: *u8) res[u64, Fail] {
    binary.put_uint(p, g.flags::u64, model.WORD, j.m.shape.order);
    ret put_u32s(j, ?g.members, p, model.WORD::u64);
}

fun put_hash(j: *Job, h: *Hash, p: *u8) res[u64, Fail] {
    val o: Order = j.m.shape.order;
    binary.put_uint(p, vector.length[u32](?h.buckets)::u64, model.WORD, o);
    binary.put_uint(at_pos(p, 4), vector.length[u32](?h.chains)::u64, model.WORD, o);
    val res_buckets: res[u64, Fail] = put_u32s(j, ?h.buckets, at_pos(p, 8), 0);
    if (sel res_buckets.err) { ret res_buckets; }
    ret put_u32s(j, ?h.chains, p, 8 + res_buckets.ok);
}

fun put_gnu_hash(j: *Job, g: *GnuHash, p: *u8) res[u64, Fail] {
    val o: Order = j.m.shape.order;
    binary.put_uint(p, vector.length[u32](?g.buckets)::u64, model.WORD, o);
    binary.put_uint(at_pos(p, 4), g.symoffset::u64, model.WORD, o);
    binary.put_uint(at_pos(p, 8), vector.length[u64](?g.bloom)::u64, model.WORD, o);
    binary.put_uint(at_pos(p, 12), g.shift::u64, model.WORD, o);
    val res_bloom: res[u64, Fail] = put_words(j, ?g.bloom, j.c.addr, at_pos(p, 16));
    if (sel res_bloom.err) { ret res_bloom; }
    val res_buckets: res[u64, Fail] = put_u32s(j, ?g.buckets, p, 16 + res_bloom.ok);
    if (sel res_buckets.err) { ret res_buckets; }
    val res_chain: res[u64, Fail] = put_u32s(j, ?g.chain, at_pos(p, res_buckets.ok), 0);
    if (sel res_chain.err) { ret res_chain; }
    ret res[u64, Fail].ok{res_buckets.ok + res_chain.ok};
}

fun put_compressed(j: *Job, z: *model.Compressed, p: *u8) res[u64, Fail] {
    val c: *Class    = j.c;
    var w: slot.Cell = slot.cell(p, j.m.shape.order);
    slot.put(?w, c.chdr.type, z.type::u64);
    slot.put(?w, c.chdr.reserved, z.reserved::u64);
    slot.put(?w, c.chdr.length, z.length);
    slot.put(?w, c.chdr.addralign, z.addralign);
    val err_done: err[Fail] = slot.done(?w, "compression header", 0);
    if (sel err_done.err) { ret res[u64, Fail].err{err_done.err}; }
    val size:         u64       = held_size(j, ?z.data);
    val err_put_held: err[Fail] = put_held(j, ?z.data, size, at_pos(p, c.chdr.size::u64), LABEL_SECTION);
    if (sel err_put_held.err) { ret res[u64, Fail].err{err_put_held.err}; }
    ret res[u64, Fail].ok{c.chdr.size::u64 + size};
}

fun put_definitions(j: *Job, t: *Table[Definition], p: *u8) res[u64, Fail] {
    val d:   model.VerdefShape  = model.VERDEF;
    val a:   model.VerdauxShape = model.VERDAUX;
    var pos: u64                = 0;
    var k:   usize              = 0;
    for (k < table.count[Definition](t)) {
        val e: *Definition = table.at[Definition](t, table.nth[Definition](k));
        var w: slot.Cell   = slot.cell(at_pos(p, pos), j.m.shape.order);
        if (sel e.verdef) {
            slot.put(?w, d.version, e.verdef.version::u64);
            slot.put(?w, d.flags, e.verdef.flags::u64);
            slot.put(?w, d.ndx, e.verdef.ndx::u64);
            slot.put(?w, d.cnt, e.verdef.cnt::u64);
            slot.put(?w, d.hash, e.verdef.hash::u64);
            slot.put(?w, d.aux, e.verdef.aux::u64);
            slot.put(?w, d.next, e.verdef.next::u64);
            pos = pos + d.size::u64;
        }
        if (sel e.verdaux) {
            slot.put(?w, a.name, e.verdaux.name::u64);
            slot.put(?w, a.next, e.verdaux.next::u64);
            pos = pos + a.size::u64;
        }
        val err_done: err[Fail] = slot.done(?w, "version definition", k::u64);
        if (sel err_done.err) { ret res[u64, Fail].err{err_done.err}; }
        k = k + 1;
    }
    ret res[u64, Fail].ok{pos};
}

fun put_needs(j: *Job, t: *Table[Need], p: *u8) res[u64, Fail] {
    val d:   model.VerneedShape = model.VERNEED;
    val a:   model.VernauxShape = model.VERNAUX;
    var pos: u64                = 0;
    var k:   usize              = 0;
    for (k < table.count[Need](t)) {
        val e: *Need     = table.at[Need](t, table.nth[Need](k));
        var w: slot.Cell = slot.cell(at_pos(p, pos), j.m.shape.order);
        if (sel e.verneed) {
            slot.put(?w, d.version, e.verneed.version::u64);
            slot.put(?w, d.cnt, e.verneed.cnt::u64);
            slot.put(?w, d.file, e.verneed.file::u64);
            slot.put(?w, d.aux, e.verneed.aux::u64);
            slot.put(?w, d.next, e.verneed.next::u64);
            pos = pos + d.size::u64;
        }
        if (sel e.vernaux) {
            slot.put(?w, a.hash, e.vernaux.hash::u64);
            slot.put(?w, a.flags, e.vernaux.flags::u64);
            slot.put(?w, a.other, e.vernaux.other::u64);
            slot.put(?w, a.name, e.vernaux.name::u64);
            slot.put(?w, a.next, e.vernaux.next::u64);
            pos = pos + a.size::u64;
        }
        val err_done: err[Fail] = slot.done(?w, "version need", k::u64);
        if (sel err_done.err) { ret res[u64, Fail].err{err_done.err}; }
        k = k + 1;
    }
    ret res[u64, Fail].ok{pos};
}

fun put_notes(j: *Job, s: *Section, t: *Vector[Note], p: *u8) res[u64, Fail] {
    val res_align: res[u64, Fail] = note_align(s);
    if (sel res_align.err) { ret res_align; }
    val shape: model.NoteShape = model.NOTE;
    var pos:   u64             = 0;
    var k:     usize           = 0;
    for (k < vector.length[Note](t)) {
        val n: *Note     = ?t.data[k];
        var w: slot.Cell = slot.cell(at_pos(p, pos), j.m.shape.order);
        slot.put(?w, shape.namesz, n.namesz::u64);
        slot.put(?w, shape.descsz, n.descsz::u64);
        slot.put(?w, shape.type, n.type::u64);
        val err_done: err[Fail] = slot.done(?w, "note", k::u64);
        if (sel err_done.err) { ret res[u64, Fail].err{err_done.err}; }
        pos = pos + shape.size::u64;
        val err_name: err[Fail] = put_held(j, ?n.name, n.namesz::u64, at_pos(p, pos), "note name");
        if (sel err_name.err) { ret res[u64, Fail].err{fail.in_indexed(err_name.err, "note", k::u64)}; }
        val res_name_pad: res[u64, Fail] = up(n.namesz::u64, NOTE_NAME_ALIGN);
        if (sel res_name_pad.err) { ret res_name_pad; }
        pos = pos + res_name_pad.ok;
        if (sel n.desc.raw) {
            val err_desc: err[Fail] = put_held(j, ?n.desc.raw.bytes, n.descsz::u64, at_pos(p, pos), "note descriptor");
            if (sel err_desc.err) { ret res[u64, Fail].err{fail.in_indexed(err_desc.err, "note", k::u64)}; }
        }
        if (sel n.desc.properties) {
            val res_props: res[u64, Fail] = put_properties(j, ?n.desc.properties, at_pos(p, pos));
            if (sel res_props.err) { ret res[u64, Fail].err{fail.in_indexed(res_props.err, "note", k::u64)}; }
            if (res_props.ok != n.descsz::u64) {
                ret res[u64, Fail].err{fail.in_indexed(fail.malformed("properties do not fill the descriptor size"), "note", k::u64)};
            }
        }
        val res_desc_pad: res[u64, Fail] = up(n.descsz::u64, res_align.ok);
        if (sel res_desc_pad.err) { ret res_desc_pad; }
        pos = pos + res_desc_pad.ok;
        k   = k + 1;
    }
    ret res[u64, Fail].ok{pos};
}

# the properties of a GNU property descriptor, each padded to the class width
fun put_properties(j: *Job, t: *Vector[Property], p: *u8) res[u64, Fail] {
    val shape: model.PropertyShape = model.PROPERTY;
    var pos:   u64                 = 0;
    var k:     usize               = 0;
    for (k < vector.length[Property](t)) {
        val e: *Property = ?t.data[k];
        var w: slot.Cell = slot.cell(at_pos(p, pos), j.m.shape.order);
        slot.put(?w, shape.type, e.type::u64);
        slot.put(?w, shape.datasz, e.datasz::u64);
        val err_done: err[Fail] = slot.done(?w, "property", k::u64);
        if (sel err_done.err) { ret res[u64, Fail].err{err_done.err}; }
        pos = pos + shape.size::u64;
        val err_data: err[Fail] = put_held(j, ?e.data, e.datasz::u64, at_pos(p, pos), "property data");
        if (sel err_data.err) { ret res[u64, Fail].err{fail.in_indexed(err_data.err, "property", k::u64)}; }
        val res_pad: res[u64, Fail] = up(e.datasz::u64, j.c.addr::u64);
        if (sel res_pad.err) { ret res_pad; }
        pos = pos + res_pad.ok;
        k   = k + 1;
    }
    ret res[u64, Fail].ok{pos};
}
