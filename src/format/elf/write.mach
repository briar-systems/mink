# the ELF writer, the ELF model into bytes
#
# every part of the file is a region of the layout plan, placed in extent
# order: the file header, the program header table, each section's bytes, the
# section header table and the raw bytes between them. the plan is sealed, the
# sealed total is allocated once, and each region is written at its recorded
# offset in the model's class and byte order. a model that holds extents, as a
# read one does, gives back its own layout, so every recorded offset must be
# where its extent lies and a region that overlaps another is refused. a model
# with no extents is laid out here: each region is placed at the alignment it
# asks for, the offsets and lengths follow from the plan, and the header
# counts are written with extended numbering when they need it. a section
# that takes no room in the file, such as SHT_NOBITS, keeps the offset its
# model holds. every value is checked against the width of its field before a
# byte is written.

use std.collections.vector;
use std.collections.vector.Vector;
use std.encoding.binary;
use std.memory;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.checked;
use mink.base.vectors;
use mink.format.elf.model.model;
use mink.format.elf.model.model.Class;
use mink.format.elf.model.model.Definition;
use mink.format.elf.model.model.Dyn;
use mink.format.elf.model.model.Elf;
use mink.format.elf.model.model.Extent;
use mink.format.elf.model.model.GnuHash;
use mink.format.elf.model.model.Group;
use mink.format.elf.model.model.Hash;
use mink.format.elf.model.model.Need;
use mink.format.elf.model.model.Note;
use mink.format.elf.model.model.Property;
use mink.format.elf.model.model.Rel;
use mink.format.elf.model.model.Rela;
use mink.format.elf.model.model.Section;
use mink.format.elf.model.model.Segment;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.plan;
use mink.bytes.plan.Layout;
use mink.bytes.plan.Plan;
use mink.bytes.plan.Region;
