# the forms the AArch64 ELF rows relax to, as lld's AArch64Relaxer rewrites
# them once layout gives addresses
#
# an ADRP with the ADD or the GOT load after it that completes its address
# becomes NOP and ADR where the target lies within the ADR's reach, and an
# ADRP and GOT load of a symbol the image defines becomes ADRP and ADD where
# the ADRP's page reach holds, or NOP and ADR where the ADR's does, the
# second taken over the first. each pair is two consecutive records of one
# target and no addend over two adjacent instructions of one register, as
# tryRelaxAdrpAdd and tryRelaxAdrpLdr ask, and a symbol's GOT loads in a
# section relax all or none, as an unpaired load may read the slot through
# an ADRP a pair shares. every form is chosen by the range
# of its value, so the GOT slot the load reaches is laid before layout and
# stays filled when a form drops the load. none applies inside a
# constant-time range, as each drops an instruction's dependency.

use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

use mink.base.rule.Axis;
use mink.catalog.output;
use aarch64_kinds: mink.format.elf.reloc.aarch64.kinds;
use mink.model.binding;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.field.Check;
use mink.reloc.field.Range;
use mink.reloc.row.Bytes;
use mink.reloc.row.Condition;
use mink.reloc.row.Copy;
use mink.reloc.row.Emit;
use mink.reloc.row.Equal;
use mink.reloc.row.InsnPattern;
use mink.reloc.row.Partner;
use mink.reloc.row.Rewrite;

# the page reach of an ADRP and the reach of an ADR
val PAGE: Range = Range{check: Check.signed{}, bits: 33, align: 0x1000};
val NEAR: Range = Range{check: Check.signed{}, bits: 21, align: 1};

# adrp xN, then add xN, xN or ldr xN, [xN] at the next word
val ADRP_ADD:     [2]InsnPattern = [2]InsnPattern{InsnPattern{at: 0, mask: 0x9f000000, value: 0x90000000, len: 4}, InsnPattern{at: 4, mask: 0xffc00000, value: 0x91000000, len: 4}};
val ADRP_LDR:     [2]InsnPattern = [2]InsnPattern{InsnPattern{at: 0, mask: 0x9f000000, value: 0x90000000, len: 4}, InsnPattern{at: 4, mask: 0xbb000000, value: 0xb9000000, len: 4}};
val ONE_REGISTER: [2]Equal       = [2]Equal{Equal{at: 0, shift: 0, other: 4, other_shift: 0, len: 4, width: 5}, Equal{at: 0, shift: 0, other: 4, other_shift: 5, len: 4, width: 5}};
val ADD_HALF:     [1]Partner     = [1]Partner{Partner{kind: ?reloc.LO12_ADD, at: 4, same: true}};
val GOT_HALF:     [1]Partner     = [1]Partner{Partner{kind: ?reloc.GOT_LO12, at: 4, same: true}};
val NO_ADDEND:    opt[i64]       = opt[i64].some{0};

# nop, then adr xN with the ADRP's register. the dropped ADRP's record moves
# to the ADR, so its value is the ADR's distance
val NOP_ADR:      [8]u8    = [8]u8{0x1f, 0x20, 0x03, 0xd5, 0x00, 0x00, 0x00, 0x10};
val ADR_REGISTER: [1]Copy  = [1]Copy{Copy{from: 4, into: 4, len: 4, shift: 0, to: 0, width: 5}};
val TO_ADR_KINDS: [2]*Kind = [2]*Kind{?aarch64_kinds.ADRP_RELAXED, ?reloc.ADR_PREL_LO21};
val NOP_ADR_EMIT: Emit     = Emit{bytes: Bytes{at: 0, data: ?NOP_ADR[0], len: 8}, copies: ?ADR_REGISTER[0], copy_count: 1, moves: 4};

# add xN, xN in place of the load, keeping its registers
val ADD:           [4]u8    = [4]u8{0x00, 0x00, 0x00, 0x91};
val ADD_REGISTERS: [1]Copy  = [1]Copy{Copy{from: 4, into: 0, len: 4, shift: 0, to: 0, width: 10}};
val TO_ADD_KINDS:  [2]*Kind = [2]*Kind{?reloc.PAGE21, ?reloc.LO12_ADD};
val ADRP_ADD_EMIT: Emit     = Emit{bytes: Bytes{at: 4, data: ?ADD[0], len: 4}, copies: ?ADD_REGISTERS[0], copy_count: 1};

# a GOT load reaches its target directly where it is a definition of the
# image no other image preempts, and in a position
# independent image no absolute value, which ADRP and ADR count from the place
val DEFINED:  Axis = Axis{need: binding.DEFINED, deny: binding.PREEMPTIBLE | binding.BOUND | binding.UNDEFINED | binding.ABSOLUTE};
val ABSOLUTE: Axis = Axis{need: binding.DEFINED | binding.ABSOLUTE, deny: binding.PREEMPTIBLE | binding.BOUND | binding.UNDEFINED};
val NOT_PIC:  Axis = Axis{deny: output.PIC};

val ADRP_TO_ADR: Rewrite = Rewrite{
    name:       "to nop adr",
    when:       Condition{range: opt[Range].some{NEAR}, shape: ?ADRP_ADD[0], shape_count: 2, equal: ?ONE_REGISTER[0], equal_count: 2, partners: ?ADD_HALF[0], addend: NO_ADDEND},
    span:       1,
    emit:       NOP_ADR_EMIT,
    kinds:      ?TO_ADR_KINDS[0],
    kind_count: 2,
};

val GOT_TO_ADR: Rewrite = Rewrite{
    name:       "to nop adr",
    when:       Condition{target: DEFINED, range: opt[Range].some{NEAR}, shape: ?ADRP_LDR[0], shape_count: 2, equal: ?ONE_REGISTER[0], equal_count: 2, partners: ?GOT_HALF[0], addend: NO_ADDEND, uniform: true},
    span:       1,
    emit:       NOP_ADR_EMIT,
    kinds:      ?TO_ADR_KINDS[0],
    kind_count: 2,
    rank:       1,
};
val GOT_TO_ADR_ABSOLUTE: Rewrite = Rewrite{
    name:       "to nop adr",
    when:       Condition{target: ABSOLUTE, output: NOT_PIC, range: opt[Range].some{NEAR}, shape: ?ADRP_LDR[0], shape_count: 2, equal: ?ONE_REGISTER[0], equal_count: 2, partners: ?GOT_HALF[0], addend: NO_ADDEND, uniform: true},
    span:       1,
    emit:       NOP_ADR_EMIT,
    kinds:      ?TO_ADR_KINDS[0],
    kind_count: 2,
    rank:       1,
};
val GOT_TO_ADD: Rewrite = Rewrite{
    name:       "to adrp add",
    when:       Condition{target: DEFINED, range: opt[Range].some{PAGE}, shape: ?ADRP_LDR[0], shape_count: 2, equal: ?ONE_REGISTER[0], equal_count: 2, partners: ?GOT_HALF[0], addend: NO_ADDEND, uniform: true},
    span:       1,
    emit:       ADRP_ADD_EMIT,
    kinds:      ?TO_ADD_KINDS[0],
    kind_count: 2,
};
val GOT_TO_ADD_ABSOLUTE: Rewrite = Rewrite{
    name:       "to adrp add",
    when:       Condition{target: ABSOLUTE, output: NOT_PIC, range: opt[Range].some{PAGE}, shape: ?ADRP_LDR[0], shape_count: 2, equal: ?ONE_REGISTER[0], equal_count: 2, partners: ?GOT_HALF[0], addend: NO_ADDEND, uniform: true},
    span:       1,
    emit:       ADRP_ADD_EMIT,
    kinds:      ?TO_ADD_KINDS[0],
    kind_count: 2,
};

# the forms of R_AARCH64_ADR_PREL_PG_HI21
pub val PAGE_COUNT: usize                = 1;
pub val PAGE_FORMS: [PAGE_COUNT]*Rewrite = [PAGE_COUNT]*Rewrite{?ADRP_TO_ADR};

# the forms of R_AARCH64_ADR_GOT_PAGE
pub val GOT_PAGE_COUNT: usize                    = 4;
pub val GOT_PAGE_FORMS: [GOT_PAGE_COUNT]*Rewrite = [GOT_PAGE_COUNT]*Rewrite{?GOT_TO_ADR, ?GOT_TO_ADR_ABSOLUTE, ?GOT_TO_ADD, ?GOT_TO_ADD_ABSOLUTE};

# the thread-local model transitions of an executable, as lld's
# relaxTlsGdToLe, relaxTlsGdToIe and relaxTlsIeToLe write them, each record
# alone. a target the image defines and no other image preempts takes local
# exec, one the loader binds initial exec. the descriptor's adrp and load
# become movz and movk x0 of the target's thread pointer offset, or adrp and
# ldr x0 of its initial exec slot, and its add and call become nops. an
# initial exec adrp and load become movz and movk of their own register.
# each drops a load or a call, so none applies in a constant-time range
val EXEC:       Axis = Axis{need: output.ENTERED};
val LOCAL_EXEC: Axis = Axis{need: binding.DEFINED, deny: binding.BOUND | binding.UNDEFINED | binding.PREEMPTIBLE | binding.BASE};
val INITIAL:    Axis = Axis{need: binding.BOUND};

val MOVZ_X0:         [4]u8    = [4]u8{0x00, 0x00, 0xa0, 0xd2};
val MOVK_X0:         [4]u8    = [4]u8{0x00, 0x00, 0x80, 0xf2};
val ADRP_X0:         [4]u8    = [4]u8{0x00, 0x00, 0x00, 0x90};
val LDR_X0:          [4]u8    = [4]u8{0x00, 0x00, 0x40, 0xf9};
val NOP:             [4]u8    = [4]u8{0x1f, 0x20, 0x03, 0xd5};
val OWN_REGISTER:    [1]Copy  = [1]Copy{Copy{from: 0, into: 0, len: 4, shift: 0, to: 0, width: 5}};
val TO_HIGH_KINDS:   [1]*Kind = [1]*Kind{?aarch64_kinds.TLSLE_MOVW_TPREL_G1};
val TO_LOW_KINDS:    [1]*Kind = [1]*Kind{?aarch64_kinds.TLSLE_MOVW_TPREL_G0_NC};
val TO_IE_PAGE:      [1]*Kind = [1]*Kind{?reloc.TLSIE_ADR_GOTTPREL_PAGE21};
val TO_IE_LO12:      [1]*Kind = [1]*Kind{?reloc.TLSIE_LD64_GOTTPREL_LO12_NC};
val TO_NOTHING:      [1]*Kind = [1]*Kind{?reloc.NONE};
val DESC_PAGE_TO_LE: Rewrite  = Rewrite{
    name:       "descriptor to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC},
    emit:       Emit{bytes: Bytes{at: 0, data: ?MOVZ_X0[0], len: 4}},
    kinds:      ?TO_HIGH_KINDS[0],
    kind_count: 1,
};
val DESC_PAGE_TO_IE: Rewrite = Rewrite{
    name:       "descriptor to initial exec",
    when:       Condition{target: INITIAL, output: EXEC},
    emit:       Emit{bytes: Bytes{at: 0, data: ?ADRP_X0[0], len: 4}},
    kinds:      ?TO_IE_PAGE[0],
    kind_count: 1,
};
val DESC_LD_TO_LE: Rewrite = Rewrite{
    name:       "descriptor to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC},
    emit:       Emit{bytes: Bytes{at: 0, data: ?MOVK_X0[0], len: 4}},
    kinds:      ?TO_LOW_KINDS[0],
    kind_count: 1,
};
val DESC_LD_TO_IE: Rewrite = Rewrite{
    name:       "descriptor to initial exec",
    when:       Condition{target: INITIAL, output: EXEC},
    emit:       Emit{bytes: Bytes{at: 0, data: ?LDR_X0[0], len: 4}},
    kinds:      ?TO_IE_LO12[0],
    kind_count: 1,
};
val DESC_TO_NOP: Rewrite = Rewrite{
    name:       "descriptor to nop",
    when:       Condition{output: EXEC},
    emit:       Emit{bytes: Bytes{at: 0, data: ?NOP[0], len: 4}},
    kinds:      ?TO_NOTHING[0],
    kind_count: 1,
};
val IE_PAGE_TO_LE: Rewrite = Rewrite{
    name:       "initial exec to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC},
    emit:       Emit{bytes: Bytes{at: 0, data: ?MOVZ_X0[0], len: 4}, copies: ?OWN_REGISTER[0], copy_count: 1},
    kinds:      ?TO_HIGH_KINDS[0],
    kind_count: 1,
};
val IE_LO12_TO_LE: Rewrite = Rewrite{
    name:       "initial exec to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC},
    emit:       Emit{bytes: Bytes{at: 0, data: ?MOVK_X0[0], len: 4}, copies: ?OWN_REGISTER[0], copy_count: 1},
    kinds:      ?TO_LOW_KINDS[0],
    kind_count: 1,
};

# the forms of R_AARCH64_TLSDESC_ADR_PAGE21
pub val TLSDESC_PAGE_COUNT: usize                        = 2;
pub val TLSDESC_PAGE_FORMS: [TLSDESC_PAGE_COUNT]*Rewrite = [TLSDESC_PAGE_COUNT]*Rewrite{?DESC_PAGE_TO_LE, ?DESC_PAGE_TO_IE};

# the forms of R_AARCH64_TLSDESC_LD64_LO12
pub val TLSDESC_LD_COUNT: usize                      = 2;
pub val TLSDESC_LD_FORMS: [TLSDESC_LD_COUNT]*Rewrite = [TLSDESC_LD_COUNT]*Rewrite{?DESC_LD_TO_LE, ?DESC_LD_TO_IE};

# the forms of R_AARCH64_TLSDESC_ADD_LO12
pub val TLSDESC_ADD_COUNT: usize                       = 1;
pub val TLSDESC_ADD_FORMS: [TLSDESC_ADD_COUNT]*Rewrite = [TLSDESC_ADD_COUNT]*Rewrite{?DESC_TO_NOP};

# the forms of R_AARCH64_TLSDESC_CALL
pub val TLSDESC_CALL_COUNT: usize                        = 1;
pub val TLSDESC_CALL_FORMS: [TLSDESC_CALL_COUNT]*Rewrite = [TLSDESC_CALL_COUNT]*Rewrite{?DESC_TO_NOP};

# the forms of R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21
pub val TLSIE_PAGE_COUNT: usize                      = 1;
pub val TLSIE_PAGE_FORMS: [TLSIE_PAGE_COUNT]*Rewrite = [TLSIE_PAGE_COUNT]*Rewrite{?IE_PAGE_TO_LE};

# the forms of R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC
pub val TLSIE_LO12_COUNT: usize                      = 1;
pub val TLSIE_LO12_FORMS: [TLSIE_LO12_COUNT]*Rewrite = [TLSIE_LO12_COUNT]*Rewrite{?IE_LO12_TO_LE};

# add xN, xN, #hi12 of a thread pointer offset whose high twelve bits are
# zero becomes nop, as lld writes it. the W form zero-extends, so only the X
# form of one register drops
val HIGH_ZERO:   Range          = Range{check: Check.unsigned{}, bits: 12, align: 1};
val ADD_X:       [1]InsnPattern = [1]InsnPattern{InsnPattern{at: 0, mask: 0x80000000, value: 0x80000000, len: 4}};
val SAME_ADD:    [1]Equal       = [1]Equal{Equal{at: 0, shift: 0, other: 0, other_shift: 5, len: 4, width: 5}};
val HIGH_TO_NOP: Rewrite        = Rewrite{
    name:       "to nop",
    when:       Condition{range: opt[Range].some{HIGH_ZERO}, shape: ?ADD_X[0], shape_count: 1, equal: ?SAME_ADD[0], equal_count: 1},
    emit:       Emit{bytes: Bytes{at: 0, data: ?NOP[0], len: 4}},
    kinds:      ?TO_NOTHING[0],
    kind_count: 1,
};

# the forms of R_AARCH64_TLSLE_ADD_TPREL_HI12
pub val TLSLE_HI12_COUNT: usize                      = 1;
pub val TLSLE_HI12_FORMS: [TLSLE_HI12_COUNT]*Rewrite = [TLSLE_HI12_COUNT]*Rewrite{?HIGH_TO_NOP};
