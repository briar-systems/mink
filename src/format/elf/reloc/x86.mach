    Row{key: 28, name: "R_386_TLS_LDM_32", kind: ?x86_kinds.TLS_LDM_32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_SLOT, range: E32, addend: Addend.field{}, rewrites: ?TO_NONE_ONLY[0], rewrite_count: 1},
    Row{key: 29, name: "R_386_TLS_LDM_PUSH", kind: ?x86_kinds.TLS_LDM_PUSH, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.field{}},
    Row{key: 30, name: "R_386_TLS_LDM_CALL", kind: ?x86_kinds.TLS_LDM_CALL, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.field{}},
    Row{key: 31, name: "R_386_TLS_LDM_POP", kind: ?x86_kinds.TLS_LDM_POP, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.field{}},
    Row{key: 32, name: "R_386_TLS_LDO_32", kind: ?x86_kinds.DTPOFF32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.DTPOFF, range: E32, addend: Addend.field{}, rewrites: ?TO_TPOFF32_REV_ONLY[0], rewrite_count: 1},
    Row{key: 33, name: "R_386_TLS_IE_32", kind: ?x86_kinds.TLS_IE_32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_SLOT, range: E32, addend: Addend.field{}, rewrites: ?TO_TPOFF32_REV_ONLY[0], rewrite_count: 1},
