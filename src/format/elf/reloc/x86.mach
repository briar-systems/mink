    Row{code: 32, name: "R_386_TLS_LDO_32", kind: ?reloc.DTPOFF32, field: ?B32, value: ?compute.DTPOFF, range: E32, addend: Addend.field{}, relax: opt[Relax].some{Relax{to: 34, keeps: true}}},
    Row{code: 33, name: "R_386_TLS_IE_32", kind: ?reloc.TLS_IE_32, field: ?B32, value: ?compute.GOT_SLOT, range: E32, addend: Addend.field{}, relax: opt[Relax].some{Relax{to: 34, keeps: true}}},
