val X86_64_KINDS: [50]*Kind = [50]*Kind{?reloc.NONE, ?reloc.ABS64, ?reloc.PC32, ?x86_kinds.GOT32, ?kinds.PLT32, ?kinds.COPY, ?kinds.GLOB_DAT, ?kinds.JUMP_SLOT, ?kinds.RELATIVE, ?kinds.GOTPCREL32, ?reloc.ABS32, ?x86_kinds.ABS32S, ?reloc.ABS16, ?reloc.PC16, ?reloc.ABS8, ?reloc.PC8, ?kinds.DTPMOD64, ?kinds.DTPOFF64, ?kinds.TPOFF64, ?x86_kinds.TLSGD32, ?x86_kinds.TLSLD32, ?x86_kinds.DTPOFF32, ?x86_kinds.GOTTPOFF32, ?x86_kinds.TPOFF32, ?reloc.PC64, ?x86_kinds.GOTOFF64, ?x86_kinds.GOTPC32, ?x86_kinds.GOT64, ?x86_kinds.GOTPCREL64, ?x86_kinds.GOTPC64, ?x86_kinds.GOTPLT64, ?x86_kinds.PLTOFF64, ?x86_kinds.SIZE32, ?x86_kinds.SIZE64, ?x86_kinds.GOTPC32_TLSDESC, ?kinds.TLSDESC_CALL, ?kinds.TLSDESC, ?kinds.IRELATIVE, ?x86_kinds.RELATIVE64, ?x86_kinds.GOTPCREL32_RELAXABLE, ?x86_kinds.REX_GOTPCREL32_RELAXABLE, ?x86_kinds.CODE_4_GOTPCREL32_RELAXABLE, ?x86_kinds.CODE_4_GOTTPOFF32, ?x86_kinds.CODE_4_GOTPC32_TLSDESC, ?x86_kinds.CODE_5_GOTPCREL32_RELAXABLE, ?x86_kinds.CODE_5_GOTTPOFF32, ?x86_kinds.CODE_5_GOTPC32_TLSDESC, ?x86_kinds.CODE_6_GOTPCREL32_RELAXABLE, ?x86_kinds.CODE_6_GOTTPOFF32, ?x86_kinds.CODE_6_GOTPC32_TLSDESC};
val X86_KINDS:    [42]*Kind = [42]*Kind{?reloc.NONE, ?reloc.ABS32, ?reloc.PC32, ?x86_kinds.GOT32, ?kinds.PLT32, ?kinds.COPY, ?kinds.GLOB_DAT, ?kinds.JUMP_SLOT, ?kinds.RELATIVE, ?x86_kinds.GOTOFF32, ?x86_kinds.GOTPC32, ?x86_kinds.PLT_ABS32, ?kinds.TPOFF32_DYN, ?x86_kinds.TLS_IE, ?x86_kinds.TLS_GOTIE, ?x86_kinds.TPOFF32, ?x86_kinds.TLS_GD, ?x86_kinds.TLS_LDM, ?reloc.ABS16, ?reloc.PC16, ?reloc.ABS8, ?reloc.PC8, ?x86_kinds.TLS_GD_32, ?x86_kinds.TLS_GD_PUSH, ?x86_kinds.TLS_GD_CALL, ?x86_kinds.TLS_GD_POP, ?x86_kinds.TLS_LDM_32, ?x86_kinds.TLS_LDM_PUSH, ?x86_kinds.TLS_LDM_CALL, ?x86_kinds.TLS_LDM_POP, ?x86_kinds.DTPOFF32, ?x86_kinds.TLS_IE_32, ?x86_kinds.TPOFF32_REV, ?kinds.DTPMOD32, ?kinds.DTPOFF32_DYN, ?x86_kinds.TPOFF32_REV_DYN, ?x86_kinds.SIZE32, ?x86_kinds.TLS_GOTDESC, ?x86_kinds.TLS_DESC_CALL, ?x86_kinds.TLS_DESC, ?kinds.IRELATIVE, ?x86_kinds.GOT32_RELAXABLE};

# the rows of the ELF and x86-64 pair
pub val X86_64: Set = Set{format: ?format.ELF, arch: ?x86.X86_64, rows: ?X86_64_ROWS[0], count: 50, kinds: ?X86_64_KINDS[0], kind_count: 50};

# the rows of the ELF and x86 pair
pub val X86: Set = Set{format: ?format.ELF, arch: ?x86.X86, rows: ?X86_ROWS[0], count: 42, kinds: ?X86_KINDS[0], kind_count: 42};

# the set holds exactly the `n` codes at `want`, each under its name, with its
# addend where the pair keeps it
fun walk(l: *row.Lookup, want: *Code, n: usize, record: bool) bool {
    if (l.set.count != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        val got: res[*Row, Fail] = row.by_key(l, want[i].value);
        if (sel got.err)                            { ret false; }
        if (!str_equals(got.ok.name, want[i].name)) { ret false; }
        val r:      *Row = got.ok;
        val is_rec: bool = sel r.addend.record;
        if (is_rec != record) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the signed thread offsets: TPOFF and LE negative, TPOFF32 and LE_32 positive
fun offsets(l: *row.Lookup) bool {
    val x:    compute.Inputs = compute.Inputs{s: 0x1000, a: 4, tp: 0x3000};
    val code: [4]u32         = [4]u32{14, 17, 34, 37};
    val want: [4]i128        = [4]i128{-0x1ffc, -0x1ffc, 0x1ffc, 0x1ffc};
    var i:    usize          = 0;
    for (i < 4) {
        val r: res[*Row, Fail] = row.by_key(l, code[i]);
        if (sel r.err) { ret false; }
        val v: res[i128, Fail] = r.ok.value.value(?x);
        if (sel v.err)       { ret false; }
        if (v.ok != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test x86__every_psabi_relocation_has_a_row {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    val a:   *A.Allocator          = testing.allocator_of(?t);
    val l64: res[row.Lookup, Fail] = row.build(a, ?X86_64);
    if (sel l64.err) { ret 1; }
    val l32: res[row.Lookup, Fail] = row.build(a, ?X86);
    if (sel l32.err) { ret 1; }
    var wide:   row.Lookup = l64.ok;
    var narrow: row.Lookup = l32.ok;
    if (!walk(?wide, ?x86_codes.X86_64[0], x86_codes.X86_64_COUNT, true)) { ret 1; }
    if (!walk(?narrow, ?x86_codes.X86[0], x86_codes.X86_COUNT, false))    { ret 1; }
    if (!offsets(?narrow))                                                { ret 1; }
    val f64: err[Fail] = row.release_lookup(?wide);
    val f32: err[Fail] = row.release_lookup(?narrow);
    if (sel f64.err || sel f32.err) { ret 1; }
    testing.dnit(?t);
    ret 0;
}
