};

val X86_ROWS: [42]Row = [42]Row{
    Row{key: 0, name: "R_386_NONE", kind: ?reloc.NONE, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.field{}},
    Row{key: 1, name: "R_386_32", kind: ?reloc.ABS32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.ABS, range: E32, addend: Addend.field{}},
    Row{key: 2, name: "R_386_PC32", kind: ?reloc.PC32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: E32, addend: Addend.field{}},
    Row{key: 3, name: "R_386_GOT32", kind: ?x86_kinds.GOT32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_SLOT, range: E32, addend: Addend.field{}},
    Row{key: 4, name: "R_386_PLT32", kind: ?kinds.PLT32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PLT, range: E32, addend: Addend.field{}},
    Row{key: 5, name: "R_386_COPY", kind: ?kinds.COPY, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.field{}},
    Row{key: 6, name: "R_386_GLOB_DAT", kind: ?kinds.GLOB_DAT, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.SYMBOL, range: WRAP, addend: Addend.field{}},
    Row{key: 7, name: "R_386_JUMP_SLOT", kind: ?kinds.JUMP_SLOT, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.SYMBOL, range: WRAP, addend: Addend.field{}},
    Row{key: 8, name: "R_386_RELATIVE", kind: ?kinds.RELATIVE, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.BASE, range: WRAP, addend: Addend.field{}},
    Row{key: 9, name: "R_386_GOTOFF", kind: ?x86_kinds.GOTOFF32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_OFF, range: E32, addend: Addend.field{}},
    Row{key: 10, name: "R_386_GOTPC", kind: ?x86_kinds.GOTPC32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_BASE, range: E32, addend: Addend.field{}},
    Row{key: 11, name: "R_386_32PLT", kind: ?x86_kinds.PLT_ABS32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PLT_ABS, range: E32, addend: Addend.field{}},
    Row{key: 14, name: "R_386_TLS_TPOFF", kind: ?kinds.TPOFF32_DYN, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.TPOFF, range: WRAP, addend: Addend.field{}},
    Row{key: 15, name: "R_386_TLS_IE", kind: ?x86_kinds.TLS_IE, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT, range: E32, addend: Addend.field{}, rewrites: ?TO_TPOFF32_ONLY[0], rewrite_count: 1},
    Row{key: 16, name: "R_386_TLS_GOTIE", kind: ?x86_kinds.TLS_GOTIE, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_SLOT, range: E32, addend: Addend.field{}, rewrites: ?TO_TPOFF32_REV_ONLY[0], rewrite_count: 1},
    # LE (@ntpoff) is the negative offset and LE_32 (@tpoff) the positive one, as in Drepper, ELF Handling For Thread-Local Storage
    Row{key: 17, name: "R_386_TLS_LE", kind: ?x86_kinds.TPOFF32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.TPOFF, range: E32, addend: Addend.field{}},
    Row{key: 18, name: "R_386_TLS_GD", kind: ?x86_kinds.TLS_GD, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_SLOT, range: E32, addend: Addend.field{}, rewrites: ?TO_TLS_IE_32_ONLY[0], rewrite_count: 1},
    Row{key: 19, name: "R_386_TLS_LDM", kind: ?x86_kinds.TLS_LDM, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_SLOT, range: E32, addend: Addend.field{}, rewrites: ?TO_NONE_ONLY[0], rewrite_count: 1},
    Row{key: 20, name: "R_386_16", kind: ?reloc.ABS16, fields: ?B16_FIELD[0], field_count: 1, value: ?compute.ABS, range: WRAP, addend: Addend.field{}},
    Row{key: 21, name: "R_386_PC16", kind: ?reloc.PC16, fields: ?B16_FIELD[0], field_count: 1, value: ?compute.PC, range: S16, addend: Addend.field{}},
    Row{key: 22, name: "R_386_8", kind: ?reloc.ABS8, fields: ?B8_FIELD[0], field_count: 1, value: ?compute.ABS, range: WRAP, addend: Addend.field{}},
    Row{key: 23, name: "R_386_PC8", kind: ?reloc.PC8, fields: ?B8_FIELD[0], field_count: 1, value: ?compute.PC, range: S8, addend: Addend.field{}},
    Row{key: 24, name: "R_386_TLS_GD_32", kind: ?x86_kinds.TLS_GD_32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_SLOT, range: E32, addend: Addend.field{}, rewrites: ?TO_TLS_IE_32_ONLY[0], rewrite_count: 1},
    Row{key: 25, name: "R_386_TLS_GD_PUSH", kind: ?x86_kinds.TLS_GD_PUSH, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.field{}},
    Row{key: 26, name: "R_386_TLS_GD_CALL", kind: ?x86_kinds.TLS_GD_CALL, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.field{}},
