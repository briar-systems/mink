# the ELF relocation tables of the x86-64 and i386 pairs
#
# every relocation the x86-64 psABI and the i386 psABI define has a row in the
# set of its pair, listed in x86_codes.mach, together with the codes the LLVM
# lists name. x86-64 keeps addends in the record and i386 in the field, both
# little endian. the kinds only these pairs state are their kinds module's.
# a relaxation is a rewrite to the kind of the form one step less general
# that keeps the length of the sequence, so none of them changes the timing
# class of the code it rewrites.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_equals;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.format.elf.reloc.kinds;
use x86_kinds: mink.format.elf.reloc.x86.kinds;
use mink.format.elf.reloc.x86_codes;
use mink.format.elf.reloc.x86_codes.Code;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.compute;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row;
use mink.reloc.row.Addend;
use mink.reloc.row.Bytes;
use mink.reloc.row.Emit;
use mink.reloc.row.FieldChoice;
use mink.reloc.row.Rewrite;
use mink.reloc.row.Row;
use mink.reloc.row.Set;

use A: std.allocator;
use std.allocator.testing;

val P8:    [1]Piece = [1]Piece{Piece{at: 0, width: 8}};
val P16:   [1]Piece = [1]Piece{Piece{at: 0, width: 16}};
val P32:   [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val P64:   [1]Piece = [1]Piece{Piece{at: 0, width: 64}};
val P2X32: [2]Piece = [2]Piece{Piece{at: 0, width: 32}, Piece{at: 32, width: 32}};
val P2X64: [2]Piece = [2]Piece{Piece{at: 0, width: 64}, Piece{at: 64, width: 64}};

val N0:   Field = Field{bytes: 0, pieces: nil, count: 0};
val B8:   Field = Field{bytes: 1, pieces: ?P8[0], count: 1};
val B16:  Field = Field{bytes: 2, pieces: ?P16[0], count: 1};
val B32:  Field = Field{bytes: 4, pieces: ?P32[0], count: 1};
val B64:  Field = Field{bytes: 8, pieces: ?P64[0], count: 1};
val D64:  Field = Field{bytes: 8, pieces: ?P2X32[0], count: 2};
val D128: Field = Field{bytes: 16, pieces: ?P2X64[0], count: 2};

val B16_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B16}};
val B32_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B32}};
val B64_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B64}};
val B8_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B8}};
val N0_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?N0}};

val WRAP: Range = Range{check: field.Check.wrap{}, bits: 0, align: 1};
val S8:   Range = Range{check: field.Check.signed{}, bits: 8, align: 1};
val S16:  Range = Range{check: field.Check.signed{}, bits: 16, align: 1};
val S32:  Range = Range{check: field.Check.signed{}, bits: 32, align: 1};
val U32:  Range = Range{check: field.Check.unsigned{}, bits: 32, align: 1};
val E32:  Range = Range{check: field.Check.either{}, bits: 32, align: 1};

val TO_NONE_KINDS:              [1]*Kind    = [1]*Kind{?reloc.NONE};
val TO_NONE:                    Rewrite     = Rewrite{name: "to none", emit: Emit.bytes{Bytes{}}, kinds: ?TO_NONE_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_NONE_ONLY:               [1]*Rewrite = [1]*Rewrite{?TO_NONE};
val TO_PC32_KINDS:              [1]*Kind    = [1]*Kind{?reloc.PC32};
val TO_PC32:                    Rewrite     = Rewrite{name: "to pc32", emit: Emit.bytes{Bytes{}}, kinds: ?TO_PC32_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_PC32_ONLY:               [1]*Rewrite = [1]*Rewrite{?TO_PC32};
val TO_TPOFF32_KINDS:           [1]*Kind    = [1]*Kind{?x86_kinds.TPOFF32};
val TO_TPOFF32:                 Rewrite     = Rewrite{name: "to tpoff32", emit: Emit.bytes{Bytes{}}, kinds: ?TO_TPOFF32_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_TPOFF32_ONLY:            [1]*Rewrite = [1]*Rewrite{?TO_TPOFF32};
val TO_GOTTPOFF32_KINDS:        [1]*Kind    = [1]*Kind{?x86_kinds.GOTTPOFF32};
val TO_GOTTPOFF32:              Rewrite     = Rewrite{name: "to gottpoff32", emit: Emit.bytes{Bytes{}}, kinds: ?TO_GOTTPOFF32_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_GOTTPOFF32_ONLY:         [1]*Rewrite = [1]*Rewrite{?TO_GOTTPOFF32};
val TO_CODE_4_GOTTPOFF32_KINDS: [1]*Kind    = [1]*Kind{?x86_kinds.CODE_4_GOTTPOFF32};
val TO_CODE_4_GOTTPOFF32:       Rewrite     = Rewrite{name: "to code_4_gottpoff32", emit: Emit.bytes{Bytes{}}, kinds: ?TO_CODE_4_GOTTPOFF32_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_CODE_4_GOTTPOFF32_ONLY:  [1]*Rewrite = [1]*Rewrite{?TO_CODE_4_GOTTPOFF32};
val TO_CODE_5_GOTTPOFF32_KINDS: [1]*Kind    = [1]*Kind{?x86_kinds.CODE_5_GOTTPOFF32};
val TO_CODE_5_GOTTPOFF32:       Rewrite     = Rewrite{name: "to code_5_gottpoff32", emit: Emit.bytes{Bytes{}}, kinds: ?TO_CODE_5_GOTTPOFF32_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_CODE_5_GOTTPOFF32_ONLY:  [1]*Rewrite = [1]*Rewrite{?TO_CODE_5_GOTTPOFF32};
val TO_CODE_6_GOTTPOFF32_KINDS: [1]*Kind    = [1]*Kind{?x86_kinds.CODE_6_GOTTPOFF32};
val TO_CODE_6_GOTTPOFF32:       Rewrite     = Rewrite{name: "to code_6_gottpoff32", emit: Emit.bytes{Bytes{}}, kinds: ?TO_CODE_6_GOTTPOFF32_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_CODE_6_GOTTPOFF32_ONLY:  [1]*Rewrite = [1]*Rewrite{?TO_CODE_6_GOTTPOFF32};
val TO_GOTOFF32_KINDS:          [1]*Kind    = [1]*Kind{?x86_kinds.GOTOFF32};
val TO_GOTOFF32:                Rewrite     = Rewrite{name: "to gotoff32", emit: Emit.bytes{Bytes{}}, kinds: ?TO_GOTOFF32_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_GOTOFF32_ONLY:           [1]*Rewrite = [1]*Rewrite{?TO_GOTOFF32};
val TO_TPOFF32_REV_KINDS:       [1]*Kind    = [1]*Kind{?x86_kinds.TPOFF32_REV};
val TO_TPOFF32_REV:             Rewrite     = Rewrite{name: "to tpoff32_rev", emit: Emit.bytes{Bytes{}}, kinds: ?TO_TPOFF32_REV_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_TPOFF32_REV_ONLY:        [1]*Rewrite = [1]*Rewrite{?TO_TPOFF32_REV};
val TO_TLS_IE_32_KINDS:         [1]*Kind    = [1]*Kind{?x86_kinds.TLS_IE_32};
val TO_TLS_IE_32:               Rewrite     = Rewrite{name: "to tls_ie_32", emit: Emit.bytes{Bytes{}}, kinds: ?TO_TLS_IE_32_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_TLS_IE_32_ONLY:          [1]*Rewrite = [1]*Rewrite{?TO_TLS_IE_32};

val X86_64_ROWS: [50]Row = [50]Row{
    Row{key: 0, name: "R_X86_64_NONE", kind: ?reloc.NONE, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.record{}},
    Row{key: 1, name: "R_X86_64_64", kind: ?reloc.ABS64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.ABS, range: WRAP, addend: Addend.record{}},
    Row{key: 2, name: "R_X86_64_PC32", kind: ?reloc.PC32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PC, range: S32, addend: Addend.record{}},
    Row{key: 3, name: "R_X86_64_GOT32", kind: ?x86_kinds.GOT32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_SLOT, range: S32, addend: Addend.record{}},
    Row{key: 4, name: "R_X86_64_PLT32", kind: ?kinds.PLT32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.PLT, range: S32, addend: Addend.record{}},
    Row{key: 5, name: "R_X86_64_COPY", kind: ?kinds.COPY, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.record{}},
    Row{key: 6, name: "R_X86_64_GLOB_DAT", kind: ?kinds.GLOB_DAT, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.SYMBOL, range: WRAP, addend: Addend.record{}},
    Row{key: 7, name: "R_X86_64_JUMP_SLOT", kind: ?kinds.JUMP_SLOT, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.SYMBOL, range: WRAP, addend: Addend.record{}},
    Row{key: 8, name: "R_X86_64_RELATIVE", kind: ?kinds.RELATIVE, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.BASE, range: WRAP, addend: Addend.record{}},
    Row{key: 9, name: "R_X86_64_GOTPCREL", kind: ?kinds.GOTPCREL32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}},
    Row{key: 10, name: "R_X86_64_32", kind: ?reloc.ABS32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.ABS, range: U32, addend: Addend.record{}},
    Row{key: 11, name: "R_X86_64_32S", kind: ?x86_kinds.ABS32S, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.ABS, range: S32, addend: Addend.record{}},
    Row{key: 12, name: "R_X86_64_16", kind: ?reloc.ABS16, fields: ?B16_FIELD[0], field_count: 1, value: ?compute.ABS, range: WRAP, addend: Addend.record{}},
    Row{key: 13, name: "R_X86_64_PC16", kind: ?reloc.PC16, fields: ?B16_FIELD[0], field_count: 1, value: ?compute.PC, range: S16, addend: Addend.record{}},
    Row{key: 14, name: "R_X86_64_8", kind: ?reloc.ABS8, fields: ?B8_FIELD[0], field_count: 1, value: ?compute.ABS, range: WRAP, addend: Addend.record{}},
    Row{key: 15, name: "R_X86_64_PC8", kind: ?reloc.PC8, fields: ?B8_FIELD[0], field_count: 1, value: ?compute.PC, range: S8, addend: Addend.record{}},
    Row{key: 16, name: "R_X86_64_DTPMOD64", kind: ?kinds.DTPMOD64, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.INDEX, range: WRAP, addend: Addend.record{}},
    Row{key: 17, name: "R_X86_64_DTPOFF64", kind: ?kinds.DTPOFF64, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.DTPOFF, range: WRAP, addend: Addend.record{}},
    Row{key: 18, name: "R_X86_64_TPOFF64", kind: ?kinds.TPOFF64, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.TPOFF, range: WRAP, addend: Addend.record{}},
    Row{key: 19, name: "R_X86_64_TLSGD", kind: ?x86_kinds.TLSGD32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_GOTTPOFF32_ONLY[0], rewrite_count: 1},
    Row{key: 20, name: "R_X86_64_TLSLD", kind: ?x86_kinds.TLSLD32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_NONE_ONLY[0], rewrite_count: 1},
    Row{key: 21, name: "R_X86_64_DTPOFF32", kind: ?x86_kinds.DTPOFF32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.DTPOFF, range: S32, addend: Addend.record{}, rewrites: ?TO_TPOFF32_ONLY[0], rewrite_count: 1},
    Row{key: 22, name: "R_X86_64_GOTTPOFF", kind: ?x86_kinds.GOTTPOFF32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_TPOFF32_ONLY[0], rewrite_count: 1},
    Row{key: 23, name: "R_X86_64_TPOFF32", kind: ?x86_kinds.TPOFF32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.TPOFF, range: S32, addend: Addend.record{}},
    Row{key: 24, name: "R_X86_64_PC64", kind: ?reloc.PC64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.PC, range: WRAP, addend: Addend.record{}},
    Row{key: 25, name: "R_X86_64_GOTOFF64", kind: ?x86_kinds.GOTOFF64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.GOT_OFF, range: WRAP, addend: Addend.record{}},
    Row{key: 26, name: "R_X86_64_GOTPC32", kind: ?x86_kinds.GOTPC32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_BASE, range: S32, addend: Addend.record{}},
    Row{key: 27, name: "R_X86_64_GOT64", kind: ?x86_kinds.GOT64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.GOT_SLOT, range: WRAP, addend: Addend.record{}},
    Row{key: 28, name: "R_X86_64_GOTPCREL64", kind: ?x86_kinds.GOTPCREL64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: WRAP, addend: Addend.record{}},
    Row{key: 29, name: "R_X86_64_GOTPC64", kind: ?x86_kinds.GOTPC64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.GOT_BASE, range: WRAP, addend: Addend.record{}},
    Row{key: 30, name: "R_X86_64_GOTPLT64", kind: ?x86_kinds.GOTPLT64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.GOT_SLOT, range: WRAP, addend: Addend.record{}},
    Row{key: 31, name: "R_X86_64_PLTOFF64", kind: ?x86_kinds.PLTOFF64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.PLT_OFF, range: WRAP, addend: Addend.record{}},
    Row{key: 32, name: "R_X86_64_SIZE32", kind: ?x86_kinds.SIZE32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.SIZE, range: E32, addend: Addend.record{}},
    Row{key: 33, name: "R_X86_64_SIZE64", kind: ?x86_kinds.SIZE64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.SIZE, range: WRAP, addend: Addend.record{}},
    Row{key: 34, name: "R_X86_64_GOTPC32_TLSDESC", kind: ?x86_kinds.GOTPC32_TLSDESC, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_GOTTPOFF32_ONLY[0], rewrite_count: 1},
    Row{key: 35, name: "R_X86_64_TLSDESC_CALL", kind: ?kinds.TLSDESC_CALL, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.record{}, rewrites: ?TO_NONE_ONLY[0], rewrite_count: 1},
    Row{key: 36, name: "R_X86_64_TLSDESC", kind: ?kinds.TLSDESC, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.NONE, range: WRAP, addend: Addend.record{}},
    Row{key: 37, name: "R_X86_64_IRELATIVE", kind: ?kinds.IRELATIVE, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.BASE, range: WRAP, addend: Addend.record{}},
    Row{key: 38, name: "R_X86_64_RELATIVE64", kind: ?x86_kinds.RELATIVE64, fields: ?N0_FIELD[0], field_count: 1, value: ?compute.BASE, range: WRAP, addend: Addend.record{}},
    Row{key: 41, name: "R_X86_64_GOTPCRELX", kind: ?x86_kinds.GOTPCREL32_RELAXABLE, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_PC32_ONLY[0], rewrite_count: 1},
    Row{key: 42, name: "R_X86_64_REX_GOTPCRELX", kind: ?x86_kinds.REX_GOTPCREL32_RELAXABLE, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_PC32_ONLY[0], rewrite_count: 1},
    Row{key: 43, name: "R_X86_64_CODE_4_GOTPCRELX", kind: ?x86_kinds.CODE_4_GOTPCREL32_RELAXABLE, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_PC32_ONLY[0], rewrite_count: 1},
    Row{key: 44, name: "R_X86_64_CODE_4_GOTTPOFF", kind: ?x86_kinds.CODE_4_GOTTPOFF32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_TPOFF32_ONLY[0], rewrite_count: 1},
    Row{key: 45, name: "R_X86_64_CODE_4_GOTPC32_TLSDESC", kind: ?x86_kinds.CODE_4_GOTPC32_TLSDESC, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_CODE_4_GOTTPOFF32_ONLY[0], rewrite_count: 1},
    Row{key: 46, name: "R_X86_64_CODE_5_GOTPCRELX", kind: ?x86_kinds.CODE_5_GOTPCREL32_RELAXABLE, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_PC32_ONLY[0], rewrite_count: 1},
    Row{key: 47, name: "R_X86_64_CODE_5_GOTTPOFF", kind: ?x86_kinds.CODE_5_GOTTPOFF32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_TPOFF32_ONLY[0], rewrite_count: 1},
    Row{key: 48, name: "R_X86_64_CODE_5_GOTPC32_TLSDESC", kind: ?x86_kinds.CODE_5_GOTPC32_TLSDESC, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_CODE_5_GOTTPOFF32_ONLY[0], rewrite_count: 1},
    Row{key: 49, name: "R_X86_64_CODE_6_GOTPCRELX", kind: ?x86_kinds.CODE_6_GOTPCREL32_RELAXABLE, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, rewrites: ?TO_PC32_ONLY[0], rewrite_count: 1},
