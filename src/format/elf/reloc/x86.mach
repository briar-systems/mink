    Row{code: 35, name: "R_X86_64_TLSDESC_CALL", kind: ?reloc.TLSDESC_CALL, field: ?N0, value: ?compute.NONE, range: WRAP, addend: Addend.record{}, relax: opt[Relax].some{Relax{to: 0, keeps: true}}},
    Row{code: 36, name: "R_X86_64_TLSDESC", kind: ?reloc.TLSDESC, field: ?N0, value: ?compute.NONE, range: WRAP, addend: Addend.record{}},
