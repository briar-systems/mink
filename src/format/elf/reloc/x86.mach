    Row{code: 42, name: "R_X86_64_REX_GOTPCRELX", kind: ?reloc.REX_GOTPCREL32_RELAXABLE, field: ?B32, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, relax: opt[Relax].some{Relax{to: 2, keeps: true}}},
