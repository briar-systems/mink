# the ELF relocation tables of the x86-64 and i386 pairs
#
# every relocation the x86-64 psABI and the i386 psABI define has a row in the
# set of its pair, listed in x86_codes.mach, together with the codes the LLVM
# lists name. x86-64 keeps addends in the record and i386 in the field, both
# little endian. the kinds only these pairs state are their kinds module's.
# a relaxation is a rewrite to the kind of the form one step less general
# that keeps the length of the sequence. one that drops a load or a call
# through memory changes the timing class of the code it rewrites, so it is
# not applied inside a constant-time range.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_equals;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.rule.Axis;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.output;
use mink.format.elf.reloc.kinds;
use x86_kinds: mink.format.elf.reloc.x86.kinds;
use mink.format.elf.reloc.x86_codes;
use mink.format.elf.reloc.x86_codes.Code;
use mink.model.binding;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.compute;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row;
use mink.reloc.row.Addend;
use mink.reloc.row.Bytes;
use mink.reloc.row.Condition;
use mink.reloc.row.Copy;
use mink.reloc.row.Emit;
use mink.reloc.row.FieldChoice;
use mink.reloc.row.InsnPattern;
use mink.reloc.row.Refusal;
use mink.reloc.row.Rewrite;
use mink.reloc.row.Row;
use mink.reloc.row.Set;

use A: std.allocator;
use std.allocator.testing;

val P8:    [1]Piece = [1]Piece{Piece{at: 0, width: 8}};
val P16:   [1]Piece = [1]Piece{Piece{at: 0, width: 16}};
val P32:   [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val P64:   [1]Piece = [1]Piece{Piece{at: 0, width: 64}};
val P2X32: [2]Piece = [2]Piece{Piece{at: 0, width: 32}, Piece{at: 32, width: 32}};
val P2X64: [2]Piece = [2]Piece{Piece{at: 0, width: 64}, Piece{at: 64, width: 64}};

val N0:   Field = Field{bytes: 0, pieces: nil, count: 0};
val B8:   Field = Field{bytes: 1, pieces: ?P8[0], count: 1};
val B16:  Field = Field{bytes: 2, pieces: ?P16[0], count: 1};
val B32:  Field = Field{bytes: 4, pieces: ?P32[0], count: 1};
val B64:  Field = Field{bytes: 8, pieces: ?P64[0], count: 1};
val D64:  Field = Field{bytes: 8, pieces: ?P2X32[0], count: 2};
val D128: Field = Field{bytes: 16, pieces: ?P2X64[0], count: 2};

val B16_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B16}};
val B32_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B32}};
val B64_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B64}};
val B8_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B8}};
val N0_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?N0}};

val WRAP: Range = Range{check: field.Check.wrap{}, bits: 0, align: 1};
val S8:   Range = Range{check: field.Check.signed{}, bits: 8, align: 1};
val S16:  Range = Range{check: field.Check.signed{}, bits: 16, align: 1};
val S32:  Range = Range{check: field.Check.signed{}, bits: 32, align: 1};
val U32:  Range = Range{check: field.Check.unsigned{}, bits: 32, align: 1};
val E32:  Range = Range{check: field.Check.either{}, bits: 32, align: 1};

val TO_NONE_KINDS: [1]*Kind    = [1]*Kind{?reloc.NONE};
val TO_PC32_KINDS: [1]*Kind    = [1]*Kind{?reloc.PC32};
val TO_PC32:       Rewrite     = Rewrite{name: "to pc32", when: row.INERT, kinds: ?TO_PC32_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_PC32_ONLY:  [1]*Rewrite = [1]*Rewrite{?TO_PC32};

# a GOTPCRELX load, call or jump reaches its target directly where lld's
# relaxGot does: the target is a definition of the image no other image
# preempts, and no indirect function, absolute value or thread-local data,
# which lld's isAbsoluteValue keeps loading, and the record's addend is -4,
# so the instruction loads the whole slot. the opcode and ModRM byte before
# the field say which instruction it is
val DIRECT:       Axis     = Axis{need: binding.DEFINED, deny: binding.PREEMPTIBLE | binding.BOUND | binding.UNDEFINED | binding.ABSOLUTE | binding.RESOLVER | binding.THREAD};
val NOT_PIC:      Axis     = Axis{deny: output.PIC};
val WHOLE_SLOT:   opt[i64] = opt[i64].some{-4};
val TO_PC_KINDS:  [1]*Kind = [1]*Kind{?reloc.PC32};
val TO_ABS_KINDS: [1]*Kind = [1]*Kind{?reloc.ABS32S};

# mov foo@GOTPCREL(%rip), %reg becomes lea foo(%rip), %reg
val MOV:    [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -2, mask: 0x00ff, value: 0x008b, len: 2}};
val LEA:    [1]u8          = [1]u8{0x8d};
val TO_LEA: Rewrite        = Rewrite{
    name:       "to lea",
    when:       Condition{target: DIRECT, shape: ?MOV[0], shape_count: 1, addend: WHOLE_SLOT},
    emit:       Emit{bytes: Bytes{at: -2, data: ?LEA[0], len: 1}},
    kinds:      ?TO_PC_KINDS[0],
    kind_count: 1,
};

# call *foo@GOTPCREL(%rip) becomes addr32 call foo, one instruction as lld
# writes it
val CALL:    [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -2, mask: 0xffff, value: 0x15ff, len: 2}};
val CALLED:  [2]u8          = [2]u8{0x67, 0xe8};
val TO_CALL: Rewrite        = Rewrite{
    name:       "to call",
    when:       Condition{target: DIRECT, shape: ?CALL[0], shape_count: 1, addend: WHOLE_SLOT},
    emit:       Emit{bytes: Bytes{at: -2, data: ?CALLED[0], len: 2}},
    kinds:      ?TO_PC_KINDS[0],
    kind_count: 1,
};

# jmp *foo@GOTPCREL(%rip) becomes jmp foo; nop, whose field starts a byte
# earlier and so counts to the same end
val JMP:    [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -2, mask: 0xffff, value: 0x25ff, len: 2}};
val JUMPED: [6]u8          = [6]u8{0xe9, 0x00, 0x00, 0x00, 0x00, 0x90};
val TO_JMP: Rewrite        = Rewrite{
    name:       "to jmp",
    when:       Condition{target: DIRECT, shape: ?JMP[0], shape_count: 1, addend: WHOLE_SLOT},
    emit:       Emit{bytes: Bytes{at: -2, data: ?JUMPED[0], len: 6}, moves: -1},
    kinds:      ?TO_PC_KINDS[0],
    kind_count: 1,
};

# in an image that is not position independent, test and the binary
# operations of a REX or REX2 form take the target's address as an
# immediate, as lld's relaxGotNoPic: the ModRM register field moves to its
# r/m field, the prefix's R bits to its B bits, a binary operation's
# opcode extension comes from its opcode, and the immediate is the target
# alone, the addend's -4 compensated
val TEST:      [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -2, mask: 0x00ff, value: 0x0085, len: 2}};
val BINOP:     [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -2, mask: 0x00c7, value: 0x0003, len: 2}};
val TESTED:    [3]u8          = [3]u8{0x00, 0xf7, 0xc0};
val OPERATED:  [3]u8          = [3]u8{0x00, 0x81, 0xc0};
val REX_TEST:  [4]Copy        = [4]Copy{Copy{from: -3, into: 0, len: 1, shift: 3, to: 3, width: 5}, Copy{from: -3, into: 0, len: 1, shift: 1, to: 1, width: 1}, Copy{from: -3, into: 0, len: 1, shift: 2, to: 0, width: 1}, Copy{from: -1, into: 2, len: 1, shift: 3, to: 0, width: 3}};
val REX_BINOP: [5]Copy        = [5]Copy{Copy{from: -3, into: 0, len: 1, shift: 3, to: 3, width: 5}, Copy{from: -3, into: 0, len: 1, shift: 1, to: 1, width: 1}, Copy{from: -3, into: 0, len: 1, shift: 2, to: 0, width: 1}, Copy{from: -1, into: 2, len: 1, shift: 3, to: 0, width: 3}, Copy{from: -2, into: 2, len: 1, shift: 3, to: 3, width: 3}};
val REX2_TEST: [7]Copy        = [7]Copy{
    Copy{from: -3, into: 0, len: 1, shift: 7, to: 7, width: 1},
    Copy{from: -3, into: 0, len: 1, shift: 5, to: 5, width: 1},
    Copy{from: -3, into: 0, len: 1, shift: 6, to: 4, width: 1},
    Copy{from: -3, into: 0, len: 1, shift: 3, to: 3, width: 1},
    Copy{from: -3, into: 0, len: 1, shift: 1, to: 1, width: 1},
    Copy{from: -3, into: 0, len: 1, shift: 2, to: 0, width: 1},
    Copy{from: -1, into: 2, len: 1, shift: 3, to: 0, width: 3},
};
val REX2_BINOP: [8]Copy = [8]Copy{
    Copy{from: -3, into: 0, len: 1, shift: 7, to: 7, width: 1},
    Copy{from: -3, into: 0, len: 1, shift: 5, to: 5, width: 1},
    Copy{from: -3, into: 0, len: 1, shift: 6, to: 4, width: 1},
    Copy{from: -3, into: 0, len: 1, shift: 3, to: 3, width: 1},
    Copy{from: -3, into: 0, len: 1, shift: 1, to: 1, width: 1},
    Copy{from: -3, into: 0, len: 1, shift: 2, to: 0, width: 1},
    Copy{from: -1, into: 2, len: 1, shift: 3, to: 0, width: 3},
    Copy{from: -2, into: 2, len: 1, shift: 3, to: 3, width: 3},
};
val TO_TEST: Rewrite = Rewrite{
    name:       "to test immediate",
    when:       Condition{target: DIRECT, output: NOT_PIC, shape: ?TEST[0], shape_count: 1, addend: WHOLE_SLOT},
    emit:       Emit{bytes: Bytes{at: -3, data: ?TESTED[0], len: 3}, copies: ?REX_TEST[0], copy_count: 4, addend: 4},
    kinds:      ?TO_ABS_KINDS[0],
    kind_count: 1,
};
val TO_BINOP: Rewrite = Rewrite{
    name:       "to binop immediate",
    when:       Condition{target: DIRECT, output: NOT_PIC, shape: ?BINOP[0], shape_count: 1, addend: WHOLE_SLOT},
    emit:       Emit{bytes: Bytes{at: -3, data: ?OPERATED[0], len: 3}, copies: ?REX_BINOP[0], copy_count: 5, addend: 4},
    kinds:      ?TO_ABS_KINDS[0],
    kind_count: 1,
};
val TO_TEST_REX2: Rewrite = Rewrite{
    name:       "to test immediate",
    when:       Condition{target: DIRECT, output: NOT_PIC, shape: ?TEST[0], shape_count: 1, addend: WHOLE_SLOT},
    emit:       Emit{bytes: Bytes{at: -3, data: ?TESTED[0], len: 3}, copies: ?REX2_TEST[0], copy_count: 7, addend: 4},
    kinds:      ?TO_ABS_KINDS[0],
    kind_count: 1,
};
val TO_BINOP_REX2: Rewrite = Rewrite{
    name:       "to binop immediate",
    when:       Condition{target: DIRECT, output: NOT_PIC, shape: ?BINOP[0], shape_count: 1, addend: WHOLE_SLOT},
    emit:       Emit{bytes: Bytes{at: -3, data: ?OPERATED[0], len: 3}, copies: ?REX2_BINOP[0], copy_count: 8, addend: 4},
    kinds:      ?TO_ABS_KINDS[0],
    kind_count: 1,
};

# an undefined weak symbol resolves to zero in an image no loader binds, so
# a load of its slot becomes mov $0, %reg and its slot is dropped, as GNU
# ld's elf_x86_64_convert_load_reloc does: the ModRM register field moves to
# its r/m field and the prefix's R bits to its B bits. a 64-bit load keeps
# its REX.W and a sign-extended immediate, a 32-bit one a zero-extended one
val WEAK_ZERO:     Axis           = Axis{need: binding.UNDEFINED, deny: binding.BOUND | binding.ABSOLUTE | binding.RESOLVER};
val MOVED:         [2]u8          = [2]u8{0xc7, 0xc0};
val MOVED_REX:     [3]u8          = [3]u8{0x00, 0xc7, 0xc0};
val TO_ZERO_KINDS: [1]*Kind       = [1]*Kind{?reloc.ABS32};
val MODRM_ONLY:    [1]Copy        = [1]Copy{Copy{from: -1, into: 1, len: 1, shift: 3, to: 0, width: 3}};
val WIDE_REX:      [2]InsnPattern = [2]InsnPattern{InsnPattern{at: -2, mask: 0x00ff, value: 0x008b, len: 2}, InsnPattern{at: -3, mask: 0xf8, value: 0x48, len: 1}};
val NARROW_REX:    [2]InsnPattern = [2]InsnPattern{InsnPattern{at: -2, mask: 0x00ff, value: 0x008b, len: 2}, InsnPattern{at: -3, mask: 0xf8, value: 0x40, len: 1}};
val WIDE_REX2:     [2]InsnPattern = [2]InsnPattern{InsnPattern{at: -2, mask: 0x00ff, value: 0x008b, len: 2}, InsnPattern{at: -3, mask: 0x08, value: 0x08, len: 1}};
val NARROW_REX2:   [2]InsnPattern = [2]InsnPattern{InsnPattern{at: -2, mask: 0x00ff, value: 0x008b, len: 2}, InsnPattern{at: -3, mask: 0x08, value: 0x00, len: 1}};
val TO_ZERO:       Rewrite        = Rewrite{
    name:       "to mov zero",
    when:       Condition{target: WEAK_ZERO, output: NOT_PIC, shape: ?MOV[0], shape_count: 1, addend: WHOLE_SLOT},
    emit:       Emit{bytes: Bytes{at: -2, data: ?MOVED[0], len: 2}, copies: ?MODRM_ONLY[0], copy_count: 1, addend: 4},
    kinds:      ?TO_ZERO_KINDS[0],
    kind_count: 1,
};
val TO_WIDE_ZERO: Rewrite = Rewrite{
    name:       "to mov zero",
    when:       Condition{target: WEAK_ZERO, output: NOT_PIC, shape: ?WIDE_REX[0], shape_count: 2, addend: WHOLE_SLOT},
    emit:       Emit{bytes: Bytes{at: -3, data: ?MOVED_REX[0], len: 3}, copies: ?REX_TEST[0], copy_count: 4, addend: 4},
    kinds:      ?TO_ABS_KINDS[0],
    kind_count: 1,
};
val TO_NARROW_ZERO: Rewrite = Rewrite{
    name:       "to mov zero",
    when:       Condition{target: WEAK_ZERO, output: NOT_PIC, shape: ?NARROW_REX[0], shape_count: 2, addend: WHOLE_SLOT},
    emit:       Emit{bytes: Bytes{at: -3, data: ?MOVED_REX[0], len: 3}, copies: ?REX_TEST[0], copy_count: 4, addend: 4},
    kinds:      ?TO_ZERO_KINDS[0],
    kind_count: 1,
};
val TO_WIDE_ZERO_REX2: Rewrite = Rewrite{
    name:       "to mov zero",
    when:       Condition{target: WEAK_ZERO, output: NOT_PIC, shape: ?WIDE_REX2[0], shape_count: 2, addend: WHOLE_SLOT},
    emit:       Emit{bytes: Bytes{at: -3, data: ?MOVED_REX[0], len: 3}, copies: ?REX2_TEST[0], copy_count: 7, addend: 4},
    kinds:      ?TO_ABS_KINDS[0],
    kind_count: 1,
};
val TO_NARROW_ZERO_REX2: Rewrite = Rewrite{
    name:       "to mov zero",
    when:       Condition{target: WEAK_ZERO, output: NOT_PIC, shape: ?NARROW_REX2[0], shape_count: 2, addend: WHOLE_SLOT},
    emit:       Emit{bytes: Bytes{at: -3, data: ?MOVED_REX[0], len: 3}, copies: ?REX2_TEST[0], copy_count: 7, addend: 4},
    kinds:      ?TO_ZERO_KINDS[0],
    kind_count: 1,
};

# GOTPCRELX states no prefix, so it takes neither the immediate forms nor a
# prefix's bits, as lld's adjustGotPcExpr. REX_GOTPCRELX and
# CODE_4_GOTPCRELX carry a REX and a REX2 prefix
val GOTPCRELX_FORMS:      [4]*Rewrite = [4]*Rewrite{?TO_LEA, ?TO_CALL, ?TO_JMP, ?TO_ZERO};
val REX_GOTPCRELX_FORMS:  [7]*Rewrite = [7]*Rewrite{?TO_LEA, ?TO_CALL, ?TO_JMP, ?TO_TEST, ?TO_BINOP, ?TO_WIDE_ZERO, ?TO_NARROW_ZERO};
val REX2_GOTPCRELX_FORMS: [7]*Rewrite = [7]*Rewrite{?TO_LEA, ?TO_CALL, ?TO_JMP, ?TO_TEST_REX2, ?TO_BINOP_REX2, ?TO_WIDE_ZERO_REX2, ?TO_NARROW_ZERO_REX2};

# an i386 GOT32 or GOT32X operand with no base register, ModRM mod 00 and r/m
# 101, computes the slot's absolute address G+A rather than its offset from
# the GOT base, as the psABI states and lld's getRelExpr reads the ModRM
# byte. it is part of the computation, so it must apply
val NO_BASE:           [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -1, mask: 0xc7, value: 0x05, len: 1}};
val TO_ABSOLUTE_KINDS: [1]*Kind       = [1]*Kind{?x86_kinds.GOT32_ABSOLUTE};
val TO_ABSOLUTE:       Rewrite        = Rewrite{
    name:       "to g+a",
    when:       Condition{output: NOT_PIC, shape: ?NO_BASE[0], shape_count: 1},
    kinds:      ?TO_ABSOLUTE_KINDS[0],
    kind_count: 1,
    keeps_ct:   true,
    must:       true,
};
val TO_ABSOLUTE_ONLY:           [1]*Rewrite = [1]*Rewrite{?TO_ABSOLUTE};
val TO_CODE_4_GOTTPOFF32_KINDS: [1]*Kind    = [1]*Kind{?x86_kinds.CODE_4_GOTTPOFF32};
val TO_CODE_4_GOTTPOFF32:       Rewrite     = Rewrite{name: "to code_4_gottpoff32", when: row.INERT, kinds: ?TO_CODE_4_GOTTPOFF32_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_CODE_4_GOTTPOFF32_ONLY:  [1]*Rewrite = [1]*Rewrite{?TO_CODE_4_GOTTPOFF32};
val TO_TPOFF32_KINDS:           [1]*Kind    = [1]*Kind{?x86_kinds.TPOFF32};
val TO_TPOFF32:                 Rewrite     = Rewrite{name: "to tpoff32", when: row.INERT, kinds: ?TO_TPOFF32_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_TPOFF32_ONLY:            [1]*Rewrite = [1]*Rewrite{?TO_TPOFF32};

# the thread-local model transitions of an executable, as lld's
# relaxTlsGdToLe, relaxTlsGdToIe, relaxTlsLdToLe and relaxTlsIeToLe write
# them. a target the image defines and no other image preempts takes local
# exec, one the loader binds initial exec, and the module base a descriptor
# access counts from has the thread pointer offset zero. a local dynamic
# access and its offsets take local exec whatever they name. each drops a
# load or a call through the GOT, so none applies in a constant-time range
val EXEC:        Axis = Axis{need: output.ENTERED};
val LOCAL_EXEC:  Axis = Axis{need: binding.DEFINED, deny: binding.BOUND | binding.UNDEFINED | binding.PREEMPTIBLE | binding.BASE};
val INITIAL:     Axis = Axis{need: binding.BOUND};
val MODULE_BASE: Axis = Axis{need: binding.DEFINED | binding.BASE, deny: binding.BOUND | binding.UNDEFINED};
val UNBOUND:     Axis = Axis{deny: binding.BOUND};

val TO_LE_KINDS:   [2]*Kind       = [2]*Kind{?x86_kinds.TPOFF32, ?reloc.NONE};
val TO_IE_KINDS:   [2]*Kind       = [2]*Kind{?x86_kinds.GOTTPOFF32, ?reloc.NONE};
val TO_NONE_PAIR:  [2]*Kind       = [2]*Kind{?reloc.NONE, ?reloc.NONE};
val PLT_CALL_AT_8: [1]row.Partner = [1]row.Partner{row.Partner{kind: ?reloc.BRANCH32, at: 8}};
val GOT_CALL_AT_8: [1]row.Partner = [1]row.Partner{row.Partner{kind: ?x86_kinds.GOTPCREL32_RELAXABLE, at: 8}};
val PLT_CALL_AT_5: [1]row.Partner = [1]row.Partner{row.Partner{kind: ?reloc.BRANCH32, at: 5}};
val GOT_CALL_AT_6: [1]row.Partner = [1]row.Partner{row.Partner{kind: ?x86_kinds.GOTPCREL32_RELAXABLE, at: 6}};
val OLD_CALL_AT_8: [1]row.Partner = [1]row.Partner{row.Partner{kind: ?kinds.GOTPCREL32, at: 8}};
val OLD_CALL_AT_6: [1]row.Partner = [1]row.Partner{row.Partner{kind: ?kinds.GOTPCREL32, at: 6}};

# data16 lea x@tlsgd(%rip), %rdi; data16 data16 rex64 call __tls_get_addr
# becomes mov %fs:0, %rax with lea x@tpoff(%rax), %rax or add
# x@gottpoff(%rip), %rax, whose field lies eight bytes on. the call names
# __tls_get_addr through the PLT or the GOT, relaxable or not
val GD_LEA:    [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -4, mask: 0xffff_ffff, value: 0x3d8d_4866, len: 4}};
val GD_TO_LE:  [16]u8         = [16]u8{0x64, 0x48, 0x8b, 0x04, 0x25, 0x00, 0x00, 0x00, 0x00, 0x48, 0x8d, 0x80, 0x00, 0x00, 0x00, 0x00};
val GD_TO_IE:  [16]u8         = [16]u8{0x64, 0x48, 0x8b, 0x04, 0x25, 0x00, 0x00, 0x00, 0x00, 0x48, 0x03, 0x05, 0x00, 0x00, 0x00, 0x00};
val GD_LE_PLT: Rewrite        = Rewrite{
    name:       "general dynamic to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?GD_LEA[0], shape_count: 1, partners: ?PLT_CALL_AT_8[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -4, data: ?GD_TO_LE[0], len: 16}, moves: 8, addend: 4},
    kinds:      ?TO_LE_KINDS[0],
    kind_count: 2,
};
val GD_LE_GOT: Rewrite = Rewrite{
    name:       "general dynamic to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?GD_LEA[0], shape_count: 1, partners: ?GOT_CALL_AT_8[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -4, data: ?GD_TO_LE[0], len: 16}, moves: 8, addend: 4},
    kinds:      ?TO_LE_KINDS[0],
    kind_count: 2,
};
val GD_LE_OLD: Rewrite = Rewrite{
    name:       "general dynamic to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?GD_LEA[0], shape_count: 1, partners: ?OLD_CALL_AT_8[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -4, data: ?GD_TO_LE[0], len: 16}, moves: 8, addend: 4},
    kinds:      ?TO_LE_KINDS[0],
    kind_count: 2,
};
val GD_IE_PLT: Rewrite = Rewrite{
    name:       "general dynamic to initial exec",
    when:       Condition{target: INITIAL, output: EXEC, shape: ?GD_LEA[0], shape_count: 1, partners: ?PLT_CALL_AT_8[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -4, data: ?GD_TO_IE[0], len: 16}, moves: 8},
    kinds:      ?TO_IE_KINDS[0],
    kind_count: 2,
};
val GD_IE_GOT: Rewrite = Rewrite{
    name:       "general dynamic to initial exec",
    when:       Condition{target: INITIAL, output: EXEC, shape: ?GD_LEA[0], shape_count: 1, partners: ?GOT_CALL_AT_8[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -4, data: ?GD_TO_IE[0], len: 16}, moves: 8},
    kinds:      ?TO_IE_KINDS[0],
    kind_count: 2,
};
val GD_IE_OLD: Rewrite = Rewrite{
    name:       "general dynamic to initial exec",
    when:       Condition{target: INITIAL, output: EXEC, shape: ?GD_LEA[0], shape_count: 1, partners: ?OLD_CALL_AT_8[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -4, data: ?GD_TO_IE[0], len: 16}, moves: 8},
    kinds:      ?TO_IE_KINDS[0],
    kind_count: 2,
};
val TLSGD_FORMS: [6]*Rewrite = [6]*Rewrite{?GD_LE_PLT, ?GD_LE_GOT, ?GD_LE_OLD, ?GD_IE_PLT, ?GD_IE_GOT, ?GD_IE_OLD};

# lea x@tlsld(%rip), %rdi; call __tls_get_addr becomes padding and
# mov %fs:0, %rax, the call through the GOT one byte longer
val LD_LEA:       [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -3, mask: 0xff_ffff, value: 0x3d_8d48, len: 3}};
val LD_TO_LE_PLT: [12]u8         = [12]u8{0x66, 0x66, 0x66, 0x64, 0x48, 0x8b, 0x04, 0x25, 0x00, 0x00, 0x00, 0x00};
val LD_TO_LE_GOT: [13]u8         = [13]u8{0x66, 0x66, 0x66, 0x66, 0x64, 0x48, 0x8b, 0x04, 0x25, 0x00, 0x00, 0x00, 0x00};
val LD_LE_PLT:    Rewrite        = Rewrite{
    name:       "local dynamic to local exec",
    when:       Condition{target: UNBOUND, output: EXEC, shape: ?LD_LEA[0], shape_count: 1, partners: ?PLT_CALL_AT_5[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -3, data: ?LD_TO_LE_PLT[0], len: 12}},
    kinds:      ?TO_NONE_PAIR[0],
    kind_count: 2,
};
val LD_LE_GOT: Rewrite = Rewrite{
    name:       "local dynamic to local exec",
    when:       Condition{target: UNBOUND, output: EXEC, shape: ?LD_LEA[0], shape_count: 1, partners: ?GOT_CALL_AT_6[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -3, data: ?LD_TO_LE_GOT[0], len: 13}},
    kinds:      ?TO_NONE_PAIR[0],
    kind_count: 2,
};
val LD_LE_OLD: Rewrite = Rewrite{
    name:       "local dynamic to local exec",
    when:       Condition{target: UNBOUND, output: EXEC, shape: ?LD_LEA[0], shape_count: 1, partners: ?OLD_CALL_AT_6[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -3, data: ?LD_TO_LE_GOT[0], len: 13}},
    kinds:      ?TO_NONE_PAIR[0],
    kind_count: 2,
};
val TLSLD_FORMS: [3]*Rewrite = [3]*Rewrite{?LD_LE_PLT, ?LD_LE_GOT, ?LD_LE_OLD};

# an offset in the module's block becomes the target's thread pointer offset
val DTP_TO_TP:      Rewrite     = Rewrite{name: "offset to local exec", when: Condition{output: EXEC}, kinds: ?TO_TPOFF32_KINDS[0], kind_count: 1};
val DTP_TO_TP_ONLY: [1]*Rewrite = [1]*Rewrite{?DTP_TO_TP};

# movq x@gottpoff(%rip), %reg becomes movq $x, %reg, and addq becomes leaq
# x(%reg), %reg, or addq $x, %reg for %rsp and %r12, whose lea is longer.
# the prefix's R bit moves to its B bit, the ModRM register field to its r/m
# field, and the immediate is the target alone, the addend's -4 compensated
val IE_MOV:      [2]InsnPattern = [2]InsnPattern{InsnPattern{at: -2, mask: 0xff, value: 0x8b, len: 1}, InsnPattern{at: -3, mask: 0xfb, value: 0x48, len: 1}};
val IE_ADD:      [2]InsnPattern = [2]InsnPattern{InsnPattern{at: -2, mask: 0xff, value: 0x03, len: 1}, InsnPattern{at: -3, mask: 0xfb, value: 0x48, len: 1}};
val IE_ADD_SP:   [2]InsnPattern = [2]InsnPattern{InsnPattern{at: -2, mask: 0xffff, value: 0x2503, len: 2}, InsnPattern{at: -3, mask: 0xfb, value: 0x48, len: 1}};
val MOV_IMM:     [3]u8          = [3]u8{0x48, 0xc7, 0xc0};
val LEA_SELF:    [3]u8          = [3]u8{0x48, 0x8d, 0x80};
val ADD_SP_IMM:  [3]u8          = [3]u8{0x48, 0x81, 0xc4};
val R_TO_B:      [1]Copy        = [1]Copy{Copy{from: -3, into: 0, len: 1, shift: 2, to: 0, width: 1}};
val REG_TO_RM:   [2]Copy        = [2]Copy{Copy{from: -3, into: 0, len: 1, shift: 2, to: 0, width: 1}, Copy{from: -1, into: 2, len: 1, shift: 3, to: 0, width: 3}};
val REG_TO_BOTH: [4]Copy        = [4]Copy{
    Copy{from: -3, into: 0, len: 1, shift: 2, to: 0, width: 1},
    Copy{from: -3, into: 0, len: 1, shift: 2, to: 2, width: 1},
    Copy{from: -1, into: 2, len: 1, shift: 3, to: 0, width: 3},
    Copy{from: -1, into: 2, len: 1, shift: 3, to: 3, width: 3},
};
val IE_LE_MOV: Rewrite = Rewrite{
    name:       "initial exec to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?IE_MOV[0], shape_count: 2},
    emit:       Emit{bytes: Bytes{at: -3, data: ?MOV_IMM[0], len: 3}, copies: ?REG_TO_RM[0], copy_count: 2, addend: 4},
    kinds:      ?TO_TPOFF32_KINDS[0],
    kind_count: 1,
};
val IE_LE_ADD: Rewrite = Rewrite{
    name:       "initial exec to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?IE_ADD[0], shape_count: 2},
    emit:       Emit{bytes: Bytes{at: -3, data: ?LEA_SELF[0], len: 3}, copies: ?REG_TO_BOTH[0], copy_count: 4, addend: 4},
    kinds:      ?TO_TPOFF32_KINDS[0],
    kind_count: 1,
};
val IE_LE_ADD_SP: Rewrite = Rewrite{
    name:       "initial exec to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?IE_ADD_SP[0], shape_count: 2},
    emit:       Emit{bytes: Bytes{at: -3, data: ?ADD_SP_IMM[0], len: 3}, copies: ?R_TO_B[0], copy_count: 1, addend: 4},
    kinds:      ?TO_TPOFF32_KINDS[0],
    kind_count: 1,
    rank:       1,
};
val GOTTPOFF_FORMS: [3]*Rewrite = [3]*Rewrite{?IE_LE_MOV, ?IE_LE_ADD, ?IE_LE_ADD_SP};

# leaq x@tlsdesc(%rip), %reg becomes movq $x@tpoff, %reg or movq
# x@gottpoff(%rip), %reg, and call *x@tlscall(%rax) a two byte nop. the
# module base's thread pointer offset is zero, written into the immediate.
# the binding selects the transition, so a lea of another shape is refused
# as lld refuses it, and the call takes its nop only where the lea of its
# target in its section takes a transition, through their uniform forms
# over the same target axes
val DESC_LEA:  [3]InsnPattern = [3]InsnPattern{InsnPattern{at: -3, mask: 0xfb, value: 0x48, len: 1}, InsnPattern{at: -2, mask: 0xff, value: 0x8d, len: 1}, InsnPattern{at: -1, mask: 0xc7, value: 0x05, len: 1}};
val MOV_ZERO:  [7]u8          = [7]u8{0x48, 0xc7, 0xc0, 0x00, 0x00, 0x00, 0x00};
val LOAD:      [1]u8          = [1]u8{0x8b};
val TO_IE_ONE: [1]*Kind       = [1]*Kind{?x86_kinds.GOTTPOFF32};
val DESC_LE:   Rewrite        = Rewrite{
    name:       "descriptor to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?DESC_LEA[0], shape_count: 3, uniform: true},
    emit:       Emit{bytes: Bytes{at: -3, data: ?MOV_IMM[0], len: 3}, copies: ?REG_TO_RM[0], copy_count: 2, addend: 4},
    kinds:      ?TO_TPOFF32_KINDS[0],
    kind_count: 1,
    required:   true,
};
val DESC_LE_BASE: Rewrite = Rewrite{
    name:       "descriptor of the module base to local exec",
    when:       Condition{target: MODULE_BASE, output: EXEC, shape: ?DESC_LEA[0], shape_count: 3, uniform: true},
    emit:       Emit{bytes: Bytes{at: -3, data: ?MOV_ZERO[0], len: 7}, copies: ?REG_TO_RM[0], copy_count: 2},
    kinds:      ?TO_NONE_KINDS[0],
    kind_count: 1,
    required:   true,
};
val DESC_IE: Rewrite = Rewrite{
    name:       "descriptor to initial exec",
    when:       Condition{target: INITIAL, output: EXEC, shape: ?DESC_LEA[0], shape_count: 3, uniform: true},
    emit:       Emit{bytes: Bytes{at: -2, data: ?LOAD[0], len: 1}},
    kinds:      ?TO_IE_ONE[0],
    kind_count: 1,
    required:   true,
};
val GOTPC32_TLSDESC_FORMS: [3]*Rewrite    = [3]*Rewrite{?DESC_LE, ?DESC_LE_BASE, ?DESC_IE};
val DESC_CALL:             [1]InsnPattern = [1]InsnPattern{InsnPattern{at: 0, mask: 0xffff, value: 0x10ff, len: 2}};
val NOP2:                  [2]u8          = [2]u8{0x66, 0x90};
val CALL_LE_TO_NOP:        Rewrite        = Rewrite{
    name:       "descriptor call to nop for local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?DESC_CALL[0], shape_count: 1, uniform: true},
    emit:       Emit{bytes: Bytes{at: 0, data: ?NOP2[0], len: 2}},
    kinds:      ?TO_NONE_KINDS[0],
    kind_count: 1,
};
val CALL_BASE_TO_NOP: Rewrite = Rewrite{
    name:       "descriptor call of the module base to nop",
    when:       Condition{target: MODULE_BASE, output: EXEC, shape: ?DESC_CALL[0], shape_count: 1, uniform: true},
    emit:       Emit{bytes: Bytes{at: 0, data: ?NOP2[0], len: 2}},
    kinds:      ?TO_NONE_KINDS[0],
    kind_count: 1,
};
val CALL_IE_TO_NOP: Rewrite = Rewrite{
    name:       "descriptor call to nop for initial exec",
    when:       Condition{target: INITIAL, output: EXEC, shape: ?DESC_CALL[0], shape_count: 1, uniform: true},
    emit:       Emit{bytes: Bytes{at: 0, data: ?NOP2[0], len: 2}},
    kinds:      ?TO_NONE_KINDS[0],
    kind_count: 1,
};
val TLSDESC_CALL_FORMS: [3]*Rewrite = [3]*Rewrite{?CALL_LE_TO_NOP, ?CALL_BASE_TO_NOP, ?CALL_IE_TO_NOP};

# the i386 transitions. leal x@tlsgd(,%ebx,1), %eax; call ___tls_get_addr
# and leal x@tlsgd(%reg), %eax; call *___tls_get_addr@GOT(%reg) become
# movl %gs:0, %eax with subl $x@tpoff, %eax or addl x@gotntpoff(%reg),
# %eax. lld adds through %ebx after the register form, which holds the GOT
# only where the register is %ebx, so the add takes the lea's register
val GD32_SIB:      [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -3, mask: 0xff_ffff, value: 0x1d_048d, len: 3}};
val GD32_REG:      [2]InsnPattern = [2]InsnPattern{InsnPattern{at: -2, mask: 0xff, value: 0x8d, len: 1}, InsnPattern{at: -1, mask: 0xc0, value: 0x80, len: 1}};
val PLT32_AT_5:    [1]row.Partner = [1]row.Partner{row.Partner{kind: ?kinds.PLT32, at: 5}};
val GOT32X_AT_6:   [1]row.Partner = [1]row.Partner{row.Partner{kind: ?x86_kinds.GOT32_RELAXABLE, at: 6}};
val GOT32_AT_6:    [1]row.Partner = [1]row.Partner{row.Partner{kind: ?x86_kinds.GOT32, at: 6}};
val GD32_TO_LE:    [12]u8         = [12]u8{0x65, 0xa1, 0x00, 0x00, 0x00, 0x00, 0x81, 0xe8, 0x00, 0x00, 0x00, 0x00};
val GD32_TO_IE:    [12]u8         = [12]u8{0x65, 0xa1, 0x00, 0x00, 0x00, 0x00, 0x03, 0x83, 0x00, 0x00, 0x00, 0x00};
val GD32_TO_IE_AT: [12]u8         = [12]u8{0x65, 0xa1, 0x00, 0x00, 0x00, 0x00, 0x03, 0x80, 0x00, 0x00, 0x00, 0x00};
val BASE_TO_RM:    [1]Copy        = [1]Copy{Copy{from: -1, into: 7, len: 1, shift: 0, to: 0, width: 3}};
val TO_LE32_KINDS: [2]*Kind       = [2]*Kind{?x86_kinds.TPOFF32_REV, ?reloc.NONE};
val TO_IE32_KINDS: [2]*Kind       = [2]*Kind{?x86_kinds.TLS_GOTIE, ?reloc.NONE};
val GD32_LE_SIB:   Rewrite        = Rewrite{
    name:       "general dynamic to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?GD32_SIB[0], shape_count: 1, partners: ?PLT32_AT_5[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -3, data: ?GD32_TO_LE[0], len: 12}, moves: 5},
    kinds:      ?TO_LE32_KINDS[0],
    kind_count: 2,
};
val GD32_LE_REG: Rewrite = Rewrite{
    name:       "general dynamic to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?GD32_REG[0], shape_count: 2, partners: ?GOT32X_AT_6[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -2, data: ?GD32_TO_LE[0], len: 12}, moves: 6},
    kinds:      ?TO_LE32_KINDS[0],
    kind_count: 2,
};
val GD32_LE_GOT: Rewrite = Rewrite{
    name:       "general dynamic to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?GD32_REG[0], shape_count: 2, partners: ?GOT32_AT_6[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -2, data: ?GD32_TO_LE[0], len: 12}, moves: 6},
    kinds:      ?TO_LE32_KINDS[0],
    kind_count: 2,
};
val GD32_IE_SIB: Rewrite = Rewrite{
    name:       "general dynamic to initial exec",
    when:       Condition{target: INITIAL, output: EXEC, shape: ?GD32_SIB[0], shape_count: 1, partners: ?PLT32_AT_5[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -3, data: ?GD32_TO_IE[0], len: 12}, moves: 5},
    kinds:      ?TO_IE32_KINDS[0],
    kind_count: 2,
};
val GD32_IE_REG: Rewrite = Rewrite{
    name:       "general dynamic to initial exec",
    when:       Condition{target: INITIAL, output: EXEC, shape: ?GD32_REG[0], shape_count: 2, partners: ?GOT32X_AT_6[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -2, data: ?GD32_TO_IE_AT[0], len: 12}, copies: ?BASE_TO_RM[0], copy_count: 1, moves: 6},
    kinds:      ?TO_IE32_KINDS[0],
    kind_count: 2,
};
val GD32_IE_GOT: Rewrite = Rewrite{
    name:       "general dynamic to initial exec",
    when:       Condition{target: INITIAL, output: EXEC, shape: ?GD32_REG[0], shape_count: 2, partners: ?GOT32_AT_6[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -2, data: ?GD32_TO_IE_AT[0], len: 12}, copies: ?BASE_TO_RM[0], copy_count: 1, moves: 6},
    kinds:      ?TO_IE32_KINDS[0],
    kind_count: 2,
};
val TLS_GD_FORMS: [6]*Rewrite = [6]*Rewrite{?GD32_LE_SIB, ?GD32_LE_REG, ?GD32_LE_GOT, ?GD32_IE_SIB, ?GD32_IE_REG, ?GD32_IE_GOT};

# leal x@tlsldm(%reg), %eax; call ___tls_get_addr becomes movl %gs:0, %eax
# and padding
val LD32_LEA:       [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -2, mask: 0xff, value: 0x8d, len: 1}};
val LD32_TO_LE_PLT: [11]u8         = [11]u8{0x65, 0xa1, 0x00, 0x00, 0x00, 0x00, 0x90, 0x8d, 0x74, 0x26, 0x00};
val LD32_TO_LE_GOT: [12]u8         = [12]u8{0x65, 0xa1, 0x00, 0x00, 0x00, 0x00, 0x8d, 0xb6, 0x00, 0x00, 0x00, 0x00};
val LD32_LE_PLT:    Rewrite        = Rewrite{
    name:       "local dynamic to local exec",
    when:       Condition{target: UNBOUND, output: EXEC, shape: ?LD32_LEA[0], shape_count: 1, partners: ?PLT32_AT_5[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -2, data: ?LD32_TO_LE_PLT[0], len: 11}},
    kinds:      ?TO_NONE_PAIR[0],
    kind_count: 2,
};
val LD32_LE_GOT: Rewrite = Rewrite{
    name:       "local dynamic to local exec",
    when:       Condition{target: UNBOUND, output: EXEC, shape: ?LD32_LEA[0], shape_count: 1, partners: ?GOT32X_AT_6[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -2, data: ?LD32_TO_LE_GOT[0], len: 12}},
    kinds:      ?TO_NONE_PAIR[0],
    kind_count: 2,
};
val LD32_LE_OLD: Rewrite = Rewrite{
    name:       "local dynamic to local exec",
    when:       Condition{target: UNBOUND, output: EXEC, shape: ?LD32_LEA[0], shape_count: 1, partners: ?GOT32_AT_6[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: -2, data: ?LD32_TO_LE_GOT[0], len: 12}},
    kinds:      ?TO_NONE_PAIR[0],
    kind_count: 2,
};
val TLS_LDM_FORMS: [3]*Rewrite = [3]*Rewrite{?LD32_LE_PLT, ?LD32_LE_GOT, ?LD32_LE_OLD};

# movl x@indntpoff, %eax becomes movl $x, %eax, movl and addl x@indntpoff,
# %reg take the immediate, and of x@gotntpoff(%reg) movl takes the immediate
# and addl becomes leal x(%reg), %reg
val ABS_A1:       [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -1, mask: 0xff, value: 0xa1, len: 1}};
val ABS_MOV:      [2]InsnPattern = [2]InsnPattern{InsnPattern{at: -2, mask: 0xff, value: 0x8b, len: 1}, InsnPattern{at: -1, mask: 0xc7, value: 0x05, len: 1}};
val ABS_ADD:      [2]InsnPattern = [2]InsnPattern{InsnPattern{at: -2, mask: 0xff, value: 0x03, len: 1}, InsnPattern{at: -1, mask: 0xc7, value: 0x05, len: 1}};
val GOT_MOV:      [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -2, mask: 0xff, value: 0x8b, len: 1}};
val GOT_ADD:      [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -2, mask: 0xff, value: 0x03, len: 1}};
val MOV_EAX_IMM:  [1]u8          = [1]u8{0xb8};
val MOV32_IMM:    [2]u8          = [2]u8{0xc7, 0xc0};
val ADD32_IMM:    [2]u8          = [2]u8{0x81, 0xc0};
val LEA32_SELF:   [2]u8          = [2]u8{0x8d, 0x80};
val REG32_TO_RM:  [1]Copy        = [1]Copy{Copy{from: -1, into: 1, len: 1, shift: 3, to: 0, width: 3}};
val REG32_TO_ALL: [2]Copy        = [2]Copy{Copy{from: -1, into: 1, len: 1, shift: 3, to: 0, width: 3}, Copy{from: -1, into: 1, len: 1, shift: 3, to: 3, width: 3}};
val IE32_LE_A1:   Rewrite        = Rewrite{
    name:       "initial exec to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?ABS_A1[0], shape_count: 1},
    emit:       Emit{bytes: Bytes{at: -1, data: ?MOV_EAX_IMM[0], len: 1}},
    kinds:      ?TO_TPOFF32_KINDS[0],
    kind_count: 1,
};
val IE32_LE_MOV: Rewrite = Rewrite{
    name:       "initial exec to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?ABS_MOV[0], shape_count: 2},
    emit:       Emit{bytes: Bytes{at: -2, data: ?MOV32_IMM[0], len: 2}, copies: ?REG32_TO_RM[0], copy_count: 1},
    kinds:      ?TO_TPOFF32_KINDS[0],
    kind_count: 1,
};
val IE32_LE_ADD: Rewrite = Rewrite{
    name:       "initial exec to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?ABS_ADD[0], shape_count: 2},
    emit:       Emit{bytes: Bytes{at: -2, data: ?ADD32_IMM[0], len: 2}, copies: ?REG32_TO_RM[0], copy_count: 1},
    kinds:      ?TO_TPOFF32_KINDS[0],
    kind_count: 1,
};
val TLS_IE_FORMS:   [3]*Rewrite = [3]*Rewrite{?IE32_LE_A1, ?IE32_LE_MOV, ?IE32_LE_ADD};
val GOTIE32_LE_MOV: Rewrite     = Rewrite{
    name:       "initial exec to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?GOT_MOV[0], shape_count: 1},
    emit:       Emit{bytes: Bytes{at: -2, data: ?MOV32_IMM[0], len: 2}, copies: ?REG32_TO_RM[0], copy_count: 1},
    kinds:      ?TO_TPOFF32_KINDS[0],
    kind_count: 1,
};
val GOTIE32_LE_ADD: Rewrite = Rewrite{
    name:       "initial exec to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?GOT_ADD[0], shape_count: 1},
    emit:       Emit{bytes: Bytes{at: -2, data: ?LEA32_SELF[0], len: 2}, copies: ?REG32_TO_ALL[0], copy_count: 2},
    kinds:      ?TO_TPOFF32_KINDS[0],
    kind_count: 1,
};
val TLS_GOTIE_FORMS: [2]*Rewrite = [2]*Rewrite{?GOTIE32_LE_MOV, ?GOTIE32_LE_ADD};

# leal x@tlsdesc(%ebx), %eax becomes leal x@ntpoff, %eax or movl
# x@gotntpoff(%ebx), %eax, and call *x@tlscall(%eax) a two byte nop, a lea
# of another shape refused and the call coupled to the lea as on x86-64
val DESC32_LEA:     [1]InsnPattern = [1]InsnPattern{InsnPattern{at: -2, mask: 0xffff, value: 0x838d, len: 2}};
val NO_BASE_MODRM:  [1]u8          = [1]u8{0x05};
val NO_BASE_ZERO:   [5]u8          = [5]u8{0x05, 0x00, 0x00, 0x00, 0x00};
val TO_GOTIE_KINDS: [1]*Kind       = [1]*Kind{?x86_kinds.TLS_GOTIE};
val DESC32_LE:      Rewrite        = Rewrite{
    name:       "descriptor to local exec",
    when:       Condition{target: LOCAL_EXEC, output: EXEC, shape: ?DESC32_LEA[0], shape_count: 1, uniform: true},
    emit:       Emit{bytes: Bytes{at: -1, data: ?NO_BASE_MODRM[0], len: 1}},
    kinds:      ?TO_TPOFF32_KINDS[0],
    kind_count: 1,
    required:   true,
};
val DESC32_LE_BASE: Rewrite = Rewrite{
    name:       "descriptor of the module base to local exec",
    when:       Condition{target: MODULE_BASE, output: EXEC, shape: ?DESC32_LEA[0], shape_count: 1, uniform: true},
    emit:       Emit{bytes: Bytes{at: -1, data: ?NO_BASE_ZERO[0], len: 5}},
    kinds:      ?TO_NONE_KINDS[0],
    kind_count: 1,
    required:   true,
};
val DESC32_IE: Rewrite = Rewrite{
    name:       "descriptor to initial exec",
    when:       Condition{target: INITIAL, output: EXEC, shape: ?DESC32_LEA[0], shape_count: 1, uniform: true},
    emit:       Emit{bytes: Bytes{at: -2, data: ?LOAD[0], len: 1}},
    kinds:      ?TO_GOTIE_KINDS[0],
    kind_count: 1,
    required:   true,
};
val TLS_GOTDESC_FORMS: [3]*Rewrite = [3]*Rewrite{?DESC32_LE, ?DESC32_LE_BASE, ?DESC32_IE};

