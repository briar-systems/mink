    Row{code: 19, name: "R_386_TLS_LDM", kind: ?reloc.TLS_LDM, field: ?B32, value: ?compute.GOT_SLOT, range: E32, addend: Addend.field{}, relax: opt[Relax].some{Relax{to: 0, keeps: true}}},
    Row{code: 20, name: "R_386_16", kind: ?reloc.ABS16, field: ?B16, value: ?compute.ABS, range: WRAP, addend: Addend.field{}},
