# the ELF relocation tables of the x86-64 and i386 pairs
#
# every relocation the x86-64 psABI and the i386 psABI define has a row in the
# set of its pair, listed in x86_codes.mach, together with the codes the LLVM
# lists name. x86-64 keeps addends in the record and i386 in the field, both
# little endian. a relaxation names the form one step less general and keeps
# the length of the sequence, so none of them changes the timing class of the
# code it rewrites.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_equals;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.catalog.arch;
use mink.catalog.format;
use mink.format.elf.reloc.x86_codes;
use mink.format.elf.reloc.x86_codes.Code;
use mink.model.reloc;
use mink.reloc.compute;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row;
use mink.reloc.row.Addend;
use mink.reloc.row.Relax;
use mink.reloc.row.Row;
use mink.reloc.row.Set;

use A: std.allocator;
use std.allocator.testing;

val P8:    [1]Piece = [1]Piece{Piece{at: 0, width: 8}};
val P16:   [1]Piece = [1]Piece{Piece{at: 0, width: 16}};
val P32:   [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val P64:   [1]Piece = [1]Piece{Piece{at: 0, width: 64}};
val P2X32: [2]Piece = [2]Piece{Piece{at: 0, width: 32}, Piece{at: 32, width: 32}};
val P2X64: [2]Piece = [2]Piece{Piece{at: 0, width: 64}, Piece{at: 64, width: 64}};

val N0:   Field = Field{bytes: 0, pieces: nil, count: 0};
val B8:   Field = Field{bytes: 1, pieces: ?P8[0], count: 1};
val B16:  Field = Field{bytes: 2, pieces: ?P16[0], count: 1};
val B32:  Field = Field{bytes: 4, pieces: ?P32[0], count: 1};
val B64:  Field = Field{bytes: 8, pieces: ?P64[0], count: 1};
val D64:  Field = Field{bytes: 8, pieces: ?P2X32[0], count: 2};
val D128: Field = Field{bytes: 16, pieces: ?P2X64[0], count: 2};

val WRAP: Range = Range{check: field.Check.wrap{}, bits: 0, align: 1};
val S8:   Range = Range{check: field.Check.signed{}, bits: 8, align: 1};
val S16:  Range = Range{check: field.Check.signed{}, bits: 16, align: 1};
val S32:  Range = Range{check: field.Check.signed{}, bits: 32, align: 1};
val U32:  Range = Range{check: field.Check.unsigned{}, bits: 32, align: 1};
val E32:  Range = Range{check: field.Check.either{}, bits: 32, align: 1};

val X86_64_ROWS: [50]Row = [50]Row{
    Row{code: 0, name: "R_X86_64_NONE", kind: ?reloc.NONE, field: ?N0, value: ?compute.NONE, range: WRAP, addend: Addend.record{}},
    Row{code: 1, name: "R_X86_64_64", kind: ?reloc.ABS64, field: ?B64, value: ?compute.ABS, range: WRAP, addend: Addend.record{}},
    Row{code: 2, name: "R_X86_64_PC32", kind: ?reloc.PC32, field: ?B32, value: ?compute.PC, range: S32, addend: Addend.record{}},
    Row{code: 3, name: "R_X86_64_GOT32", kind: ?reloc.GOT32, field: ?B32, value: ?compute.GOT_SLOT, range: S32, addend: Addend.record{}},
    Row{code: 4, name: "R_X86_64_PLT32", kind: ?reloc.PLT32, field: ?B32, value: ?compute.PLT, range: S32, addend: Addend.record{}},
    Row{code: 5, name: "R_X86_64_COPY", kind: ?reloc.COPY, field: ?N0, value: ?compute.NONE, range: WRAP, addend: Addend.record{}},
    Row{code: 6, name: "R_X86_64_GLOB_DAT", kind: ?reloc.GLOB_DAT, field: ?N0, value: ?compute.SYMBOL, range: WRAP, addend: Addend.record{}},
    Row{code: 7, name: "R_X86_64_JUMP_SLOT", kind: ?reloc.JUMP_SLOT, field: ?N0, value: ?compute.SYMBOL, range: WRAP, addend: Addend.record{}},
    Row{code: 8, name: "R_X86_64_RELATIVE", kind: ?reloc.RELATIVE, field: ?N0, value: ?compute.BASE, range: WRAP, addend: Addend.record{}},
    Row{code: 9, name: "R_X86_64_GOTPCREL", kind: ?reloc.GOTPCREL32, field: ?B32, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}},
    Row{code: 10, name: "R_X86_64_32", kind: ?reloc.ABS32, field: ?B32, value: ?compute.ABS, range: U32, addend: Addend.record{}},
    Row{code: 11, name: "R_X86_64_32S", kind: ?reloc.ABS32S, field: ?B32, value: ?compute.ABS, range: S32, addend: Addend.record{}},
    Row{code: 12, name: "R_X86_64_16", kind: ?reloc.ABS16, field: ?B16, value: ?compute.ABS, range: WRAP, addend: Addend.record{}},
    Row{code: 13, name: "R_X86_64_PC16", kind: ?reloc.PC16, field: ?B16, value: ?compute.PC, range: S16, addend: Addend.record{}},
    Row{code: 14, name: "R_X86_64_8", kind: ?reloc.ABS8, field: ?B8, value: ?compute.ABS, range: WRAP, addend: Addend.record{}},
    Row{code: 15, name: "R_X86_64_PC8", kind: ?reloc.PC8, field: ?B8, value: ?compute.PC, range: S8, addend: Addend.record{}},
    Row{code: 16, name: "R_X86_64_DTPMOD64", kind: ?reloc.DTPMOD64, field: ?N0, value: ?compute.INDEX, range: WRAP, addend: Addend.record{}},
    Row{code: 17, name: "R_X86_64_DTPOFF64", kind: ?reloc.DTPOFF64, field: ?N0, value: ?compute.DTPOFF, range: WRAP, addend: Addend.record{}},
    Row{code: 18, name: "R_X86_64_TPOFF64", kind: ?reloc.TPOFF64, field: ?N0, value: ?compute.TPOFF, range: WRAP, addend: Addend.record{}},
    Row{code: 19, name: "R_X86_64_TLSGD", kind: ?reloc.TLSGD32, field: ?B32, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, relax: opt[Relax].some{Relax{to: 22, keeps: true}}},
    Row{code: 20, name: "R_X86_64_TLSLD", kind: ?reloc.TLSLD32, field: ?B32, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, relax: opt[Relax].some{Relax{to: 0, keeps: true}}},
    Row{code: 21, name: "R_X86_64_DTPOFF32", kind: ?reloc.DTPOFF32, field: ?B32, value: ?compute.DTPOFF, range: S32, addend: Addend.record{}, relax: opt[Relax].some{Relax{to: 23, keeps: true}}},
    Row{code: 22, name: "R_X86_64_GOTTPOFF", kind: ?reloc.GOTTPOFF32, field: ?B32, value: ?compute.GOT_PC, range: S32, addend: Addend.record{}, relax: opt[Relax].some{Relax{to: 23, keeps: true}}},
    Row{code: 23, name: "R_X86_64_TPOFF32", kind: ?reloc.TPOFF32, field: ?B32, value: ?compute.TPOFF, range: S32, addend: Addend.record{}},
    Row{code: 24, name: "R_X86_64_PC64", kind: ?reloc.PC64, field: ?B64, value: ?compute.PC, range: WRAP, addend: Addend.record{}},
    Row{code: 25, name: "R_X86_64_GOTOFF64", kind: ?reloc.GOTOFF64, field: ?B64, value: ?compute.GOT_OFF, range: WRAP, addend: Addend.record{}},
    Row{code: 26, name: "R_X86_64_GOTPC32", kind: ?reloc.GOTPC32, field: ?B32, value: ?compute.GOT_BASE, range: S32, addend: Addend.record{}},
    Row{code: 27, name: "R_X86_64_GOT64", kind: ?reloc.GOT64, field: ?B64, value: ?compute.GOT_SLOT, range: WRAP, addend: Addend.record{}},
    Row{code: 28, name: "R_X86_64_GOTPCREL64", kind: ?reloc.GOTPCREL64, field: ?B64, value: ?compute.GOT_PC, range: WRAP, addend: Addend.record{}},
    Row{code: 29, name: "R_X86_64_GOTPC64", kind: ?reloc.GOTPC64, field: ?B64, value: ?compute.GOT_BASE, range: WRAP, addend: Addend.record{}},
    Row{code: 30, name: "R_X86_64_GOTPLT64", kind: ?reloc.GOTPLT64, field: ?B64, value: ?compute.GOT_SLOT, range: WRAP, addend: Addend.record{}},
    Row{code: 31, name: "R_X86_64_PLTOFF64", kind: ?reloc.PLTOFF64, field: ?B64, value: ?compute.PLT_OFF, range: WRAP, addend: Addend.record{}},
