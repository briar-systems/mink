        key:         0x414,
        name:        "R_AARCH64_AUTH_IRELATIVE",
        kind:        ?AUTH_IRELATIVE,
        fields:      ?C_NONE[0],
        field_count: 1,
        value:       ?compute.BASE,
        range:       Range{check: field.Check.wrap{}, bits: 1, align: 0x1},
        addend:      Addend.record{},
    },
};

val KIND_COUNT: usize             = 149;
val KINDS:      [KIND_COUNT]*Kind = [KIND_COUNT]*Kind{?reloc.NONE, ?reloc.ABS64, ?reloc.ABS32, ?reloc.ABS16, ?reloc.PC64, ?reloc.PC32, ?reloc.PC16, ?MOVW_UABS_G0, ?MOVW_UABS_G0_NC, ?MOVW_UABS_G1, ?MOVW_UABS_G1_NC, ?MOVW_UABS_G2, ?MOVW_UABS_G2_NC, ?MOVW_UABS_G3, ?MOVW_SABS_G0, ?MOVW_SABS_G1, ?MOVW_SABS_G2, ?LD_PREL_LO19, ?ADR_PREL_LO21, ?PAGE21, ?ADR_PREL_PG_HI21_NC, ?LO12_ADD, ?LO12_LDST8, ?BRANCH14, ?BRANCH19, ?JUMP26, ?CALL26, ?LO12_LDST16, ?LO12_LDST32, ?LO12_LDST64, ?MOVW_PREL_G0, ?MOVW_PREL_G0_NC, ?MOVW_PREL_G1, ?MOVW_PREL_G1_NC, ?MOVW_PREL_G2, ?MOVW_PREL_G2_NC, ?MOVW_PREL_G3, ?LO12_LDST128, ?MOVW_GOTOFF_G0, ?MOVW_GOTOFF_G0_NC, ?MOVW_GOTOFF_G1, ?MOVW_GOTOFF_G1_NC, ?MOVW_GOTOFF_G2, ?MOVW_GOTOFF_G2_NC, ?MOVW_GOTOFF_G3, ?GOTREL64, ?GOTREL32, ?GOT_LD_PREL19, ?LD64_GOTOFF_LO15, ?GOT_PAGE21, ?GOT_LO12, ?LD64_GOTPAGE_LO15, ?kinds.PLT32, ?kinds.GOTPCREL32, ?PATCHINST, ?FUNCINIT64, ?TLSGD_ADR_PREL21, ?TLSGD_ADR_PAGE21, ?TLSGD_ADD_LO12_NC, ?TLSGD_MOVW_G1, ?TLSGD_MOVW_G0_NC, ?TLSLD_ADR_PREL21, ?TLSLD_ADR_PAGE21, ?TLSLD_ADD_LO12_NC, ?TLSLD_MOVW_G1, ?TLSLD_MOVW_G0_NC, ?TLSLD_LD_PREL19, ?TLSLD_MOVW_DTPREL_G2, ?TLSLD_MOVW_DTPREL_G1, ?TLSLD_MOVW_DTPREL_G1_NC, ?TLSLD_MOVW_DTPREL_G0, ?TLSLD_MOVW_DTPREL_G0_NC, ?TLSLD_ADD_DTPREL_HI12, ?TLSLD_ADD_DTPREL_LO12, ?TLSLD_ADD_DTPREL_LO12_NC, ?TLSLD_LDST8_DTPREL_LO12, ?TLSLD_LDST8_DTPREL_LO12_NC, ?TLSLD_LDST16_DTPREL_LO12, ?TLSLD_LDST16_DTPREL_LO12_NC, ?TLSLD_LDST32_DTPREL_LO12, ?TLSLD_LDST32_DTPREL_LO12_NC, ?TLSLD_LDST64_DTPREL_LO12, ?TLSLD_LDST64_DTPREL_LO12_NC, ?TLSIE_MOVW_GOTTPREL_G1, ?TLSIE_MOVW_GOTTPREL_G0_NC, ?TLSIE_ADR_GOTTPREL_PAGE21, ?TLSIE_LD64_GOTTPREL_LO12_NC, ?TLSIE_LD_GOTTPREL_PREL19, ?TLSLE_MOVW_TPREL_G2, ?TLSLE_MOVW_TPREL_G1, ?TLSLE_MOVW_TPREL_G1_NC, ?TLSLE_MOVW_TPREL_G0, ?TLSLE_MOVW_TPREL_G0_NC, ?TLSLE_ADD_TPREL_HI12, ?TLSLE_ADD_TPREL_LO12, ?TLSLE_ADD_TPREL_LO12_NC, ?TLSLE_LDST8_TPREL_LO12, ?TLSLE_LDST8_TPREL_LO12_NC, ?TLSLE_LDST16_TPREL_LO12, ?TLSLE_LDST16_TPREL_LO12_NC, ?TLSLE_LDST32_TPREL_LO12, ?TLSLE_LDST32_TPREL_LO12_NC, ?TLSLE_LDST64_TPREL_LO12, ?TLSLE_LDST64_TPREL_LO12_NC, ?TLSDESC_LD_PREL19, ?TLSDESC_ADR_PREL21, ?TLSDESC_ADR_PAGE21, ?TLSDESC_LD64_LO12, ?TLSDESC_ADD_LO12, ?TLSDESC_OFF_G1, ?TLSDESC_OFF_G0_NC, ?TLSDESC_LDR, ?TLSDESC_ADD, ?kinds.TLSDESC_CALL, ?TLSLE_LDST128_TPREL_LO12, ?TLSLE_LDST128_TPREL_LO12_NC, ?TLSLD_LDST128_DTPREL_LO12, ?TLSLD_LDST128_DTPREL_LO12_NC, ?kinds.COPY, ?kinds.GLOB_DAT, ?kinds.JUMP_SLOT, ?kinds.RELATIVE, ?kinds.DTPMOD64, ?kinds.DTPOFF64, ?kinds.TPOFF64, ?kinds.TLSDESC, ?kinds.IRELATIVE, ?AUTH_ABS64, ?AUTH_MOVW_GOTOFF_G0, ?AUTH_MOVW_GOTOFF_G0_NC, ?AUTH_MOVW_GOTOFF_G1, ?AUTH_MOVW_GOTOFF_G1_NC, ?AUTH_MOVW_GOTOFF_G2, ?AUTH_MOVW_GOTOFF_G2_NC, ?AUTH_MOVW_GOTOFF_G3, ?AUTH_GOT_LD_PREL19, ?AUTH_LD64_GOTOFF_LO15, ?AUTH_ADR_GOT_PAGE, ?AUTH_LD64_GOT_LO12_NC, ?AUTH_LD64_GOTPAGE_LO15, ?AUTH_GOT_ADD_LO12_NC, ?AUTH_GOT_ADR_PREL_LO21, ?AUTH_TLSDESC_ADR_PAGE21, ?AUTH_TLSDESC_LD64_LO12, ?AUTH_TLSDESC_ADD_LO12, ?AUTH_RELATIVE, ?AUTH_GLOB_DAT, ?AUTH_TLSDESC, ?AUTH_IRELATIVE};

# the relocations of the ELF and AArch64 pair
pub val SET: Set = Set{format: ?format.ELF, arch: ?aarch64.AARCH64, rows: ?ROWS[0], count: ROW_COUNT, kinds: ?KINDS[0], kind_count: KIND_COUNT};

#[embed("../../../../vendor/llvm/AArch64.def")]
val DEFINITION: [_]u8;

fun starts(at: usize, lead: str) bool {
    var i: usize = 0;
    for (lead[i] != 0) {
        if (at + i >= $length_of(DEFINITION) || DEFINITION[at + i] != lead[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the number after the comma at `at`, decimal or hexadecimal
fun number(at: usize) u32 {
    var r: usize = at + 1;
    var v: u32   = 0;
    for (DEFINITION[r] == ' ') { r = r + 1; }
    if (DEFINITION[r + 1] == 'x') {
        r = r + 2;
        for (DEFINITION[r] != ')') {
            val c: u8 = DEFINITION[r];
            if (c <= '9') { v = v * 16 + (c - '0')::u32; }
            or            { v = v * 16 + ((c | 0x20) - 'a' + 10)::u32; }
            r = r + 1;
        }
        ret v;
    }
    for (DEFINITION[r] != ')') {
        v = v * 10 + (DEFINITION[r] - '0')::u32;
        r = r + 1;
    }
    ret v;
}

test aarch64__every_source_relocation_has_its_row {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    val built: res[row.Lookup, Fail] = row.build(testing.allocator_of(?t), ?SET);
    if (sel built.err) { ret 1; }
    var l:    row.Lookup = built.ok;
    var seen: usize      = 0;
    var at:   usize      = 0;
    for (at < $length_of(DEFINITION)) {
        val head: usize = at + 10;
        at = at + 1;
        if (!starts(head - 10, "ELF_RELOC(R_AARCH64_") || starts(head, "R_AARCH64_P32_")) { cnt; }
        var q: usize = head;
        for (DEFINITION[q] != ',') { q = q + 1; }
        val found: res[*Row, Fail] = row.by_key(?l, number(q));
        if (sel found.err) { ret 1; }
        val name: str   = found.ok.name;
        var k:    usize = 0;
        for (k < q - head) {
            if (name[k] != DEFINITION[head + k]) { ret 1; }
            k = k + 1;
        }
        if (name[k] != 0) { ret 1; }
        seen = seen + 1;
    }
    if (seen != ROW_COUNT) { ret 1; }
    val freed: err[Fail] = row.release_lookup(?l);
    if (sel freed.err) { ret 1; }
    testing.dnit(?t);
    ret 0;
}
