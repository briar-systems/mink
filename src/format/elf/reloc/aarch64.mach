use mink.reloc.row.Set;

val P_DATA64:   [1]Piece = [1]Piece{Piece{at: 0, width: 64}};
val P_DATA32:   [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val P_DATA16:   [1]Piece = [1]Piece{Piece{at: 0, width: 16}};
val P_MOVK0:    [1]Piece = [1]Piece{Piece{at: 5, width: 16}};
val P_MOVK1:    [1]Piece = [1]Piece{Piece{at: 5, width: 16}};
val P_MOVK2:    [1]Piece = [1]Piece{Piece{at: 5, width: 16}};
val P_MOVK3:    [1]Piece = [1]Piece{Piece{at: 5, width: 16}};
val P_MOVN0:    [1]Piece = [1]Piece{Piece{at: 5, width: 16}};
val P_MOVN1:    [1]Piece = [1]Piece{Piece{at: 5, width: 16}};
val P_MOVN2:    [1]Piece = [1]Piece{Piece{at: 5, width: 16}};
val P_LD19:     [1]Piece = [1]Piece{Piece{at: 5, width: 19}};
val P_ADR21:    [2]Piece = [2]Piece{Piece{at: 29, width: 2}, Piece{at: 5, width: 19}};
val P_ADRP:     [2]Piece = [2]Piece{Piece{at: 29, width: 2}, Piece{at: 5, width: 19}};
val P_LO12_1:   [1]Piece = [1]Piece{Piece{at: 10, width: 12}};
val P_BRANCH14: [1]Piece = [1]Piece{Piece{at: 5, width: 14}};
val P_BRANCH26: [1]Piece = [1]Piece{Piece{at: 0, width: 26}};
val P_LO12_2:   [1]Piece = [1]Piece{Piece{at: 10, width: 11}};
val P_LO12_4:   [1]Piece = [1]Piece{Piece{at: 10, width: 10}};
val P_LO12_8:   [1]Piece = [1]Piece{Piece{at: 10, width: 9}};
val P_LO12_16:  [1]Piece = [1]Piece{Piece{at: 10, width: 8}};
val P_LO15:     [1]Piece = [1]Piece{Piece{at: 10, width: 12}};
val P_ADDHI12:  [1]Piece = [1]Piece{Piece{at: 10, width: 12}};

val F_NONE:     Field = Field{bytes: 0};
val F_DATA64:   Field = Field{bytes: 8, pieces: ?P_DATA64[0], count: 1};
val F_DATA32:   Field = Field{bytes: 4, pieces: ?P_DATA32[0], count: 1};
val F_DATA16:   Field = Field{bytes: 2, pieces: ?P_DATA16[0], count: 1};
val F_MOVK0:    Field = Field{bytes: 4, pieces: ?P_MOVK0[0], count: 1, insn: true};
val F_MOVK1:    Field = Field{bytes: 4, pieces: ?P_MOVK1[0], count: 1, shift: 16, insn: true};
val F_MOVK2:    Field = Field{bytes: 4, pieces: ?P_MOVK2[0], count: 1, shift: 32, insn: true};
val F_MOVK3:    Field = Field{bytes: 4, pieces: ?P_MOVK3[0], count: 1, shift: 48, insn: true};
val F_MOVN0:    Field = Field{bytes: 4, pieces: ?P_MOVN0[0], count: 1, insn: true, sign: opt[Sign].some{Sign{at: 29, width: 2, neg: 0, pos: 2}}};
val F_MOVN1:    Field = Field{bytes: 4, pieces: ?P_MOVN1[0], count: 1, shift: 16, insn: true, sign: opt[Sign].some{Sign{at: 29, width: 2, neg: 0, pos: 2}}};
val F_MOVN2:    Field = Field{bytes: 4, pieces: ?P_MOVN2[0], count: 1, shift: 32, insn: true, sign: opt[Sign].some{Sign{at: 29, width: 2, neg: 0, pos: 2}}};
val F_LD19:     Field = Field{bytes: 4, pieces: ?P_LD19[0], count: 1, shift: 2, insn: true};
val F_ADR21:    Field = Field{bytes: 4, pieces: ?P_ADR21[0], count: 2, insn: true};
val F_ADRP:     Field = Field{bytes: 4, pieces: ?P_ADRP[0], count: 2, shift: 12, insn: true};
val F_LO12_1:   Field = Field{bytes: 4, pieces: ?P_LO12_1[0], count: 1, insn: true};
val F_BRANCH14: Field = Field{bytes: 4, pieces: ?P_BRANCH14[0], count: 1, shift: 2, insn: true};
val F_BRANCH26: Field = Field{bytes: 4, pieces: ?P_BRANCH26[0], count: 1, shift: 2, insn: true};
val F_LO12_2:   Field = Field{bytes: 4, pieces: ?P_LO12_2[0], count: 1, shift: 1, insn: true};
val F_LO12_4:   Field = Field{bytes: 4, pieces: ?P_LO12_4[0], count: 1, shift: 2, insn: true};
val F_LO12_8:   Field = Field{bytes: 4, pieces: ?P_LO12_8[0], count: 1, shift: 3, insn: true};
val F_LO12_16:  Field = Field{bytes: 4, pieces: ?P_LO12_16[0], count: 1, shift: 4, insn: true};
val F_LO15:     Field = Field{bytes: 4, pieces: ?P_LO15[0], count: 1, shift: 3, insn: true};
val F_ADDHI12:  Field = Field{bytes: 4, pieces: ?P_ADDHI12[0], count: 1, shift: 12, insn: true};

val C_NONE:     [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_NONE}};
val C_DATA64:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_DATA64}};
val C_DATA32:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_DATA32}};
