val TO_PAGE21_KINDS:                 [1]*Kind    = [1]*Kind{?aarch64_kinds.PAGE21};
val TO_PAGE21:                       Rewrite     = Rewrite{name: "to page21", emit: Emit.bytes{Bytes{}}, kinds: ?TO_PAGE21_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_PAGE21_ONLY:                  [1]*Rewrite = [1]*Rewrite{?TO_PAGE21};
val TO_LO12_ADD_KINDS:               [1]*Kind    = [1]*Kind{?aarch64_kinds.LO12_ADD};
