# the relocations of the Arm 64-bit ELF ABI, LP64
#
# one row for every relocation the vendored definition file lists, applied as
# RELA records. generated by vendor/llvm/gen-elf-aarch64.py. the instruction
# fields are bit ranges of a 32-bit little endian word, the checked move-wide
# forms hold their sign in the opcode, scaled low-12 forms check the alignment
# of the access, and the dynamic and marker codes hold no static field. a
# relaxation names the kind of the form it rewrites to. the kinds only this
# pair states are its kinds module's.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.allocator.testing;

use mink.base.fail.Fail;
use mink.catalog.arch.aarch64;
use mink.catalog.format;
use aarch64_kinds: mink.format.elf.reloc.aarch64.kinds;
use mink.format.elf.reloc.kinds;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.compute;
use mink.reloc.field;
