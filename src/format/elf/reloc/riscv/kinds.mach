# the relocation kinds only the RISC-V ELF pair states
#
# the handles a producer names a RISC-V relocation by, for RV32 and RV64
# alike. the rows that apply them are the pair module's.

use std.types.option.opt;

use mink.catalog.slot;
use mink.catalog.slot.SlotRole;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.model.reloc.Tls;

pub val HI20:                    Kind = Kind{name: "hi20", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val LO12_I:                  Kind = Kind{name: "lo12_i", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val LO12_S:                  Kind = Kind{name: "lo12_s", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val PCREL_HI20:              Kind = Kind{name: "pcrel_hi20", caps: reloc.PC, takes: ?reloc.NAMED};
pub val PCREL_LO12_I:            Kind = Kind{name: "pcrel_lo12_i", caps: reloc.PC | reloc.PARTNER, takes: ?reloc.NAMED};
pub val PCREL_LO12_S:            Kind = Kind{name: "pcrel_lo12_s", caps: reloc.PC | reloc.PARTNER, takes: ?reloc.NAMED};
pub val GOT_PCREL_HI20:          Kind = Kind{name: "got_pcrel_hi20", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val CALL_PAIR:               Kind = Kind{name: "call_pair", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.PLT}};
pub val JAL20:                   Kind = Kind{name: "jal20", caps: reloc.PC, takes: ?reloc.NAMED};
pub val BRANCH12:                Kind = Kind{name: "branch12", caps: reloc.PC, takes: ?reloc.NAMED};
pub val RELAX:                   Kind = Kind{name: "relax", caps: reloc.MARKER | reloc.RESIZES, takes: ?reloc.NAMELESS};
pub val ALIGN:                   Kind = Kind{name: "align", caps: reloc.MARKER | reloc.RESIZES, takes: ?reloc.NAMELESS};
pub val CALL_PLT_PAIR:           Kind = Kind{name: "call_plt_pair", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.PLT}};
pub val TLS_GOT_PCREL_HI20:      Kind = Kind{name: "tls_got_pcrel_hi20", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
pub val TLS_GD_PCREL_HI20:       Kind = Kind{name: "tls_gd_pcrel_hi20", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.gd{}, slot: opt[*SlotRole].some{?slot.TLS_GD}};
pub val TPREL_HI20:              Kind = Kind{name: "tprel_hi20", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.le{}};
pub val TPREL_LO12_I:            Kind = Kind{name: "tprel_lo12_i", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.le{}};
pub val TPREL_LO12_S:            Kind = Kind{name: "tprel_lo12_s", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.le{}};
pub val TPREL_ADD:               Kind = Kind{name: "tprel_add", caps: reloc.MARKER, takes: ?reloc.NAMED};
pub val ADD8:                    Kind = Kind{name: "add8", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val ADD16:                   Kind = Kind{name: "add16", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val ADD32:                   Kind = Kind{name: "add32", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val ADD64:                   Kind = Kind{name: "add64", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SUB8:                    Kind = Kind{name: "sub8", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SUB16:                   Kind = Kind{name: "sub16", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SUB32:                   Kind = Kind{name: "sub32", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SUB64:                   Kind = Kind{name: "sub64", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SET6:                    Kind = Kind{name: "set6", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SUB6:                    Kind = Kind{name: "sub6", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SET8:                    Kind = Kind{name: "set8", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SET16:                   Kind = Kind{name: "set16", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SET32:                   Kind = Kind{name: "set32", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val SET_ULEB128:             Kind = Kind{name: "set_uleb128", caps: reloc.ABS | reloc.PARTNER, takes: ?reloc.NAMED};
pub val SUB_ULEB128:             Kind = Kind{name: "sub_uleb128", caps: reloc.ABS | reloc.PARTNER, takes: ?reloc.NAMED};
pub val RVC_BRANCH:              Kind = Kind{name: "rvc_branch", caps: reloc.PC, takes: ?reloc.NAMED};
pub val RVC_JUMP:                Kind = Kind{name: "rvc_jump", caps: reloc.PC, takes: ?reloc.NAMED};
pub val TLSDESC_HI20:            Kind = Kind{name: "tlsdesc_hi20", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val TLSDESC_PCREL_LOAD_LO12: Kind = Kind{name: "tlsdesc_pcrel_load_lo12", caps: reloc.PC | reloc.PARTNER, takes: ?reloc.NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val TLSDESC_PCREL_ADD_LO12:  Kind = Kind{name: "tlsdesc_pcrel_add_lo12", caps: reloc.PC | reloc.PARTNER, takes: ?reloc.NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val TLSDESC_PCREL_CALL:      Kind = Kind{name: "tlsdesc_pcrel_call", caps: reloc.MARKER | reloc.PARTNER, takes: ?reloc.NAMED};
pub val VENDOR:                  Kind = Kind{name: "vendor", caps: reloc.MARKER, takes: ?reloc.NAMED};
