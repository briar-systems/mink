# the x86-64 and i386 relocation codes, generated by vendor/llvm/gen-x86-reloc-codes.py
# from the LLVM x86_64.def and i386.def pinned in vendor/llvm/REVISION and the codes
# the psABIs add to them.

use std.types.size.usize;
use std.types.string.str;

# one relocation code: its name as the specification spells it, its number and the
# list that defines it
pub rec Code {
    name:   str;
    value:  u32;
    source: str;
}

