# the relocation kinds every ELF pair shares
#
# the loader kinds the dynamic section's relocations carry and the kinds more
# than one architecture's psABI defines alike. a kind of one architecture is a
# row of its own pair module.

use std.types.option.opt;

use mink.catalog.slot;
use mink.catalog.slot.SlotRole;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.model.reloc.Tls;

pub val COPY:         Kind = Kind{name: "copy", caps: reloc.MARKER | reloc.LOADER, takes: ?reloc.NAMED};
pub val DTPMOD32:     Kind = Kind{name: "dtpmod32", caps: reloc.ABS | reloc.LOADER, takes: ?reloc.EITHER, tls: Tls.gd{}};
pub val DTPMOD64:     Kind = Kind{name: "dtpmod64", caps: reloc.ABS | reloc.LOADER, takes: ?reloc.EITHER, tls: Tls.gd{}};
pub val DTPOFF32_DYN: Kind = Kind{name: "dtpoff32_dyn", caps: reloc.ABS | reloc.LOADER, takes: ?reloc.EITHER, tls: Tls.gd{}};
pub val DTPOFF64:     Kind = Kind{name: "dtpoff64", caps: reloc.ABS | reloc.LOADER, takes: ?reloc.EITHER, tls: Tls.gd{}};
pub val GLOB_DAT:     Kind = Kind{name: "glob_dat", caps: reloc.ABS | reloc.LOADER, takes: ?reloc.NAMED};
pub val GOTPCREL32:   Kind = Kind{name: "gotpcrel32", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val IRELATIVE:    Kind = Kind{name: "irelative", caps: reloc.IMAGE | reloc.LOADER, takes: ?reloc.NAMELESS};
pub val JUMP_SLOT:    Kind = Kind{name: "jump_slot", caps: reloc.ABS | reloc.LOADER, takes: ?reloc.NAMED};
pub val PLT32:        Kind = Kind{name: "plt32", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.PLT}};
pub val RELATIVE:     Kind = Kind{name: "relative", caps: reloc.IMAGE | reloc.LOADER, takes: ?reloc.NAMELESS};
pub val TLSDESC:      Kind = Kind{name: "tlsdesc", caps: reloc.ABS | reloc.LOADER, takes: ?reloc.EITHER, tls: Tls.desc{}};
pub val TLSDESC_CALL: Kind = Kind{name: "tlsdesc_call", caps: reloc.MARKER, takes: ?reloc.NAMED};
pub val TPOFF32_DYN:  Kind = Kind{name: "tpoff32_dyn", caps: reloc.ABS | reloc.LOADER, takes: ?reloc.EITHER, tls: Tls.ie{}};
pub val TPOFF64:      Kind = Kind{name: "tpoff64", caps: reloc.ABS | reloc.LOADER, takes: ?reloc.EITHER, tls: Tls.ie{}};
