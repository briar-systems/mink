# the relocation kinds only the x86-64 and i386 ELF pairs state
#
# the handles a producer names an x86 relocation by. the rows that apply them
# are the pair module's.

use std.types.option.opt;

use mink.catalog.slot;
use mink.catalog.slot.SlotRole;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.model.reloc.Tls;

pub val ABS32S:                      Kind = Kind{name: "abs32s", caps: reloc.ABS, takes: ?reloc.NAMED};
pub val GOT32:                       Kind = Kind{name: "got32", caps: reloc.ABS, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val GOTPC32:                     Kind = Kind{name: "gotpc32", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val GOTPCREL32_RELAXABLE:        Kind = Kind{name: "gotpcrel32_relaxable", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val GOTPCREL64:                  Kind = Kind{name: "gotpcrel64", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val TPOFF32:                     Kind = Kind{name: "tpoff32", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.le{}};
pub val GOTTPOFF32:                  Kind = Kind{name: "gottpoff32", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
pub val TLSGD32:                     Kind = Kind{name: "tlsgd32", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.gd{}, slot: opt[*SlotRole].some{?slot.TLS_GD}};
pub val TLSLD32:                     Kind = Kind{name: "tlsld32", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.ld{}, slot: opt[*SlotRole].some{?slot.TLS_LD}};
pub val DTPOFF32:                    Kind = Kind{name: "dtpoff32", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.ld{}};
pub val RELATIVE64:                  Kind = Kind{name: "relative64", caps: reloc.IMAGE | reloc.LOADER, takes: ?reloc.NAMELESS};
pub val GOT64:                       Kind = Kind{name: "got64", caps: reloc.ABS, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val GOTOFF64:                    Kind = Kind{name: "gotoff64", caps: reloc.ABS, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val GOTPC64:                     Kind = Kind{name: "gotpc64", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val GOTPLT64:                    Kind = Kind{name: "gotplt64", caps: reloc.ABS, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val PLTOFF64:                    Kind = Kind{name: "pltoff64", caps: reloc.ABS, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.PLT}};
pub val SIZE32:                      Kind = Kind{name: "size32", caps: reloc.SIZE, takes: ?reloc.NAMED};
pub val SIZE64:                      Kind = Kind{name: "size64", caps: reloc.SIZE, takes: ?reloc.NAMED};
pub val GOTPC32_TLSDESC:             Kind = Kind{name: "gotpc32_tlsdesc", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val REX_GOTPCREL32_RELAXABLE:    Kind = Kind{name: "rex_gotpcrel32_relaxable", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val CODE_4_GOTPCREL32_RELAXABLE: Kind = Kind{name: "code_4_gotpcrel32_relaxable", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val CODE_5_GOTPCREL32_RELAXABLE: Kind = Kind{name: "code_5_gotpcrel32_relaxable", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val CODE_6_GOTPCREL32_RELAXABLE: Kind = Kind{name: "code_6_gotpcrel32_relaxable", caps: reloc.PC, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val CODE_4_GOTTPOFF32:           Kind = Kind{name: "code_4_gottpoff32", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
pub val CODE_5_GOTTPOFF32:           Kind = Kind{name: "code_5_gottpoff32", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
pub val CODE_6_GOTTPOFF32:           Kind = Kind{name: "code_6_gottpoff32", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
pub val CODE_4_GOTPC32_TLSDESC:      Kind = Kind{name: "code_4_gotpc32_tlsdesc", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val CODE_5_GOTPC32_TLSDESC:      Kind = Kind{name: "code_5_gotpc32_tlsdesc", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val CODE_6_GOTPC32_TLSDESC:      Kind = Kind{name: "code_6_gotpc32_tlsdesc", caps: reloc.PC, takes: ?reloc.NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val GOTOFF32:                    Kind = Kind{name: "gotoff32", caps: reloc.ABS, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val PLT_ABS32:                   Kind = Kind{name: "plt_abs32", caps: reloc.ABS, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.PLT}};
pub val GOT32_RELAXABLE:             Kind = Kind{name: "got32_relaxable", caps: reloc.ABS, takes: ?reloc.NAMED, slot: opt[*SlotRole].some{?slot.GOT}};
pub val TPOFF32_REV:                 Kind = Kind{name: "tpoff32_rev", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.le{}};
pub val TPOFF32_REV_DYN:             Kind = Kind{name: "tpoff32_rev_dyn", caps: reloc.ABS | reloc.LOADER, takes: ?reloc.EITHER, tls: Tls.ie{}};
pub val TLS_IE:                      Kind = Kind{name: "tls_ie", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
pub val TLS_GOTIE:                   Kind = Kind{name: "tls_gotie", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
pub val TLS_IE_32:                   Kind = Kind{name: "tls_ie_32", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.ie{}, slot: opt[*SlotRole].some{?slot.TLS_IE}};
pub val TLS_GD:                      Kind = Kind{name: "tls_gd", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.gd{}, slot: opt[*SlotRole].some{?slot.TLS_GD}};
pub val TLS_GD_32:                   Kind = Kind{name: "tls_gd_32", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.gd{}, slot: opt[*SlotRole].some{?slot.TLS_GD}};
pub val TLS_GD_PUSH:                 Kind = Kind{name: "tls_gd_push", caps: reloc.MARKER, takes: ?reloc.NAMED};
pub val TLS_GD_CALL:                 Kind = Kind{name: "tls_gd_call", caps: reloc.MARKER, takes: ?reloc.NAMED};
pub val TLS_GD_POP:                  Kind = Kind{name: "tls_gd_pop", caps: reloc.MARKER, takes: ?reloc.NAMED};
pub val TLS_LDM:                     Kind = Kind{name: "tls_ldm", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.ld{}, slot: opt[*SlotRole].some{?slot.TLS_LD}};
pub val TLS_LDM_32:                  Kind = Kind{name: "tls_ldm_32", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.ld{}, slot: opt[*SlotRole].some{?slot.TLS_LD}};
pub val TLS_LDM_PUSH:                Kind = Kind{name: "tls_ldm_push", caps: reloc.MARKER, takes: ?reloc.NAMED};
pub val TLS_LDM_CALL:                Kind = Kind{name: "tls_ldm_call", caps: reloc.MARKER, takes: ?reloc.NAMED};
pub val TLS_LDM_POP:                 Kind = Kind{name: "tls_ldm_pop", caps: reloc.MARKER, takes: ?reloc.NAMED};
pub val TLS_GOTDESC:                 Kind = Kind{name: "tls_gotdesc", caps: reloc.ABS, takes: ?reloc.NAMED, tls: Tls.desc{}, slot: opt[*SlotRole].some{?slot.TLSDESC}};
pub val TLS_DESC_CALL:               Kind = Kind{name: "tls_desc_call", caps: reloc.MARKER, takes: ?reloc.NAMED};
pub val TLS_DESC:                    Kind = Kind{name: "tls_desc", caps: reloc.ABS | reloc.LOADER, takes: ?reloc.EITHER, tls: Tls.desc{}};
