# the relocations of the RISC-V ELF psABI
#
# one table serves RV32 and RV64: no reading row differs by class, the loader
# kinds having no fields, so each set is the whole array, and only the writing
# row of a bound GOT slot takes the class's address width. the codes and
# names are checked against the psABI list generated from the pinned LLVM
# RISCV.def.
# the kinds only this pair states are its kinds module's, and a relaxation is
# a rewrite to the kind of the form it relaxes to.

use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_equals;

use mink.base.fail.Fail;
use mink.catalog.arch.riscv;
use mink.catalog.format;
use mink.catalog.os;
use mink.catalog.trait.Setting;
use mink.format.elf.model.tables.Constant;
use mink.format.elf.reloc.kinds;
