# a difference is an ADD record naming the target and a SUB record naming the
# symbol subtracted at one place, which a linker that deletes bytes
# recomputes. the 6-bit one is a SET6 record, as the field shares its byte
# with an opcode and no ADD6 exists
val DIFFERENCE_COUNT: usize                        = 5;
val DIFFERENCES:      [DIFFERENCE_COUNT]Difference = [DIFFERENCE_COUNT]Difference{
    Difference{kind: ?riscv_kinds.DIFF6, plus: 53, minus: 52},
    Difference{kind: ?reloc.DIFF8, plus: 33, minus: 37},
    Difference{kind: ?reloc.DIFF16, plus: 34, minus: 38},
    Difference{kind: ?reloc.DIFF32, plus: 35, minus: 39},
    Difference{kind: ?reloc.DIFF64, plus: 36, minus: 40},
};

val KINDS: [64]*Kind = [64]*Kind{?reloc.BRANCH32, ?kinds.RELATIVE, ?kinds.GLOB_DAT, ?kinds.JUMP_SLOT, ?kinds.IRELATIVE, ?reloc.NONE, ?reloc.ABS32, ?reloc.ABS64, ?kinds.COPY, ?kinds.DTPMOD32, ?kinds.DTPMOD64, ?kinds.DTPOFF32_DYN, ?kinds.DTPOFF64, ?kinds.TPOFF32_DYN, ?kinds.TPOFF64, ?kinds.TLSDESC, ?riscv_kinds.BRANCH12, ?riscv_kinds.JAL20, ?riscv_kinds.CALL_PAIR, ?riscv_kinds.CALL_PLT_PAIR, ?riscv_kinds.GOT_PCREL_HI20, ?riscv_kinds.TLS_GOT_PCREL_HI20, ?riscv_kinds.TLS_GD_PCREL_HI20, ?riscv_kinds.PCREL_HI20, ?riscv_kinds.PCREL_LO12_I, ?riscv_kinds.PCREL_LO12_S, ?riscv_kinds.HI20, ?riscv_kinds.LO12_I, ?riscv_kinds.LO12_S, ?riscv_kinds.TPREL_HI20, ?riscv_kinds.TPREL_LO12_I, ?riscv_kinds.TPREL_LO12_S, ?riscv_kinds.TPREL_ADD, ?riscv_kinds.HI20_RELAXED, ?riscv_kinds.TPREL_RELAXED, ?riscv_kinds.ADD8, ?riscv_kinds.ADD16, ?riscv_kinds.ADD32, ?riscv_kinds.ADD64, ?riscv_kinds.SUB8, ?riscv_kinds.SUB16, ?riscv_kinds.SUB32, ?riscv_kinds.SUB64, ?kinds.GOTPCREL32, ?riscv_kinds.ALIGN, ?riscv_kinds.RVC_BRANCH, ?riscv_kinds.RVC_JUMP, ?riscv_kinds.JAL20_PLT, ?riscv_kinds.RVC_JUMP_PLT, ?riscv_kinds.RELAX, ?riscv_kinds.SUB6, ?riscv_kinds.SET6, ?riscv_kinds.SET8, ?riscv_kinds.SET16, ?riscv_kinds.SET32, ?reloc.PC32, ?kinds.PLT32, ?riscv_kinds.SET_ULEB128, ?riscv_kinds.SUB_ULEB128, ?riscv_kinds.TLSDESC_HI20, ?riscv_kinds.TLSDESC_PCREL_LOAD_LO12, ?riscv_kinds.TLSDESC_PCREL_ADD_LO12, ?riscv_kinds.TLSDESC_PCREL_CALL, ?riscv_kinds.VENDOR};

# a branch that may reach a stub is written as CALL_PLT, which reads back as
# its own kind. the psABI has no GLOB_DAT, so a GOT slot the loader binds is
# written as the absolute relocation of the class's address width, which reads
# back as that absolute kind. an upper half relaxation deleted is written as
# R_RISCV_RELAX, as lld retypes it, keeping the value of the half it replaced.
# a relaxed call is written as the jump it became, computed through the PLT
# entry the call reached. a 64-bit set takes the first six rows and a 32-bit
# set the last six
val WRITES: [7]Row = [7]Row{
    Row{key: 2, name: "R_RISCV_64", kind: ?kinds.GLOB_DAT, fields: ?DATA64_FIELD[0], field_count: 1, value: ?compute.ABS, range: WRAP, addend: Addend.record{}},
    Row{key: 19, name: "R_RISCV_CALL_PLT", kind: ?reloc.BRANCH32, fields: ?CALLF_FIELD[0], field_count: 1, value: ?compute.PLT, range: S32, addend: Addend.record{}},
    Row{key: 51, name: "R_RISCV_RELAX", kind: ?riscv_kinds.HI20_RELAXED, fields: ?EMPTY_FIELD[0], field_count: 1, value: ?compute.ABS, range: WRAP, addend: Addend.record{}},
    Row{key: 51, name: "R_RISCV_RELAX", kind: ?riscv_kinds.TPREL_RELAXED, fields: ?EMPTY_FIELD[0], field_count: 1, value: ?compute.TPOFF, range: WRAP, addend: Addend.record{}},
    Row{key: 17, name: "R_RISCV_JAL", kind: ?riscv_kinds.JAL20_PLT, fields: ?JTYPE_FIELD[0], field_count: 1, value: ?compute.PLT, range: JMP, addend: Addend.record{}},
    Row{key: 45, name: "R_RISCV_RVC_JUMP", kind: ?riscv_kinds.RVC_JUMP_PLT, fields: ?CJTYPE_FIELD[0], field_count: 1, value: ?compute.PLT, range: RVJ, addend: Addend.record{}},
    Row{key: 1, name: "R_RISCV_32", kind: ?kinds.GLOB_DAT, fields: ?DATA32_FIELD[0], field_count: 1, value: ?compute.ABS, range: ANY32, addend: Addend.record{}},
};

# both classes and both base integer ISAs read the same rows
val REFUSALS_COUNT: usize                   = 6;
val REFUSALS:       [REFUSALS_COUNT]Refusal = [REFUSALS_COUNT]Refusal{
    Refusal{kind: ?reloc.ABS32S, why: "R_RISCV_32 writes a data word no instruction sign-extends, checked as either signedness, and a sign-extended absolute is a HI20 and LO12 pair", source: "RISC-V psABI"},
    Refusal{kind: ?reloc.ABS8, why: "R_RISCV_SET8 writes the low byte with no range check, so no relocation holds an absolute value to an 8-bit field", source: "RISC-V psABI"},
    Refusal{kind: ?reloc.ABS16, why: "R_RISCV_SET16 writes the low half with no range check, so no relocation holds an absolute value to a 16-bit field", source: "RISC-V psABI"},
    Refusal{kind: ?reloc.PC8, why: "no place-relative relocation writes an 8-bit field", source: "RISC-V psABI"},
    Refusal{kind: ?reloc.PC16, why: "no place-relative relocation writes a 16-bit field", source: "RISC-V psABI"},
    Refusal{kind: ?reloc.PC64, why: "no place-relative relocation writes a 64-bit field", source: "RISC-V psABI"},
};

pub val RV64:  Set = Set{format: ?format.ELF, arch: ?riscv.RISCV64, rows: ?ROWS[0], count: 58, kinds: ?KINDS[0], kind_count: 64, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT, refusals: ?REFUSALS[0], refusal_count: REFUSALS_COUNT, writes: ?WRITES[0], write_count: 6, shared: ?late.ROWS[0], shared_count: late.COUNT};
pub val RV32:  Set = Set{format: ?format.ELF, arch: ?riscv.RISCV32, rows: ?ROWS[0], count: 58, kinds: ?KINDS[0], kind_count: 64, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT, refusals: ?REFUSALS[0], refusal_count: REFUSALS_COUNT, writes: ?WRITES[1], write_count: 6, shared: ?late.ROWS[0], shared_count: late.COUNT};
pub val RV64E: Set = Set{format: ?format.ELF, arch: ?riscv.RISCV64E, rows: ?ROWS[0], count: 58, kinds: ?KINDS[0], kind_count: 64, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT, refusals: ?REFUSALS[0], refusal_count: REFUSALS_COUNT, writes: ?WRITES[0], write_count: 6, shared: ?late.ROWS[0], shared_count: late.COUNT};
pub val RV32E: Set = Set{format: ?format.ELF, arch: ?riscv.RISCV32E, rows: ?ROWS[0], count: 58, kinds: ?KINDS[0], kind_count: 64, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT, refusals: ?REFUSALS[0], refusal_count: REFUSALS_COUNT, writes: ?WRITES[1], write_count: 6, shared: ?late.ROWS[0], shared_count: late.COUNT};

val SETS: [4]*Set = [4]*Set{?RV64, ?RV32, ?RV64E, ?RV32E};

test riscv__rows_match_the_psabi_list {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    var i: usize = 0;
    for (i < 4) {
        val s:    *Set                    = SETS[i];
        val sets: [1]*row.Set             = [1]*row.Set{s};
        var g:    res[row.Registry, Fail] = row.make(testing.allocator_of(?t), ?sets[0], 1);
        if (sel g.err) { ret 1; }
        val found: res[*row.Lookup, Fail] = row.find(?g.ok, s.format, s.arch);
        if (sel found.err) { ret 1; }
        val l: *row.Lookup = found.ok;
        if (s.count != riscv_source.SOURCE.count) { ret 1; }
        var k: usize = 0;
        for (k < riscv_source.SOURCE.count) {
            val want: *Constant       = riscv_source.SOURCE.rows[k];
            val got:  res[*Row, Fail] = row.by_key(l, want.value::u32);
            if (sel got.err)                         { ret 1; }
            if (!str_equals(got.ok.name, want.name)) { ret 1; }
            k = k + 1;
        }
        k = 0;
        for (k < s.count) {
            val r: *Row = ?s.rows[k];
            if (reloc.has(r.kind, reloc.PARTNER) != sel r.pair.some) { ret 1; }
            k = k + 1;
        }
        val freed: err[Fail] = row.release(?g.ok);
        if (sel freed.err) { ret 1; }
        i = i + 1;
    }
    testing.dnit(?t);
    ret 0;
}
