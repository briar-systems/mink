# the relocations of the RISC-V ELF psABI
#
# one table serves RV32 and RV64: no row differs by class, the loader kinds
# having no fields, so each set is the whole array. the codes and names are
# checked against the psABI list generated from the pinned LLVM RISCV.def.
# the kinds only this pair states are its kinds module's, and a relaxation is
# a rewrite to the kind of the form it relaxes to.

use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_equals;

use mink.base.fail.Fail;
use mink.catalog.arch.riscv;
use mink.catalog.format;
use mink.format.elf.model.tables.Constant;
use mink.format.elf.reloc.kinds;
use riscv_kinds: mink.format.elf.reloc.riscv.kinds;
use mink.format.elf.reloc.riscv_source;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.compute;
use mink.reloc.field.Check;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row;
use mink.reloc.row.Addend;
use mink.reloc.row.Bytes;
use mink.reloc.row.Difference;
use mink.reloc.row.Emit;
