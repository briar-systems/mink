use mink.reloc.row.Rewrite;
use mink.reloc.row.Role;
use mink.reloc.row.Row;
use mink.reloc.row.Set;

use A: std.allocator;
use std.allocator.testing;

val DATA8_PIECES:  [1]Piece  = [1]Piece{Piece{at: 0, width: 8}};
val DATA16_PIECES: [1]Piece  = [1]Piece{Piece{at: 0, width: 16}};
val DATA32_PIECES: [1]Piece  = [1]Piece{Piece{at: 0, width: 32}};
val DATA64_PIECES: [1]Piece  = [1]Piece{Piece{at: 0, width: 64}};
val DATA6_PIECES:  [1]Piece  = [1]Piece{Piece{at: 0, width: 6}};
val UTYPE_PIECES:  [1]Piece  = [1]Piece{Piece{at: 12, width: 20}};
val ITYPE_PIECES:  [1]Piece  = [1]Piece{Piece{at: 20, width: 12}};
val STYPE_PIECES:  [2]Piece  = [2]Piece{Piece{at: 7, width: 5}, Piece{at: 25, width: 7}};
val BTYPE_PIECES:  [4]Piece  = [4]Piece{Piece{at: 8, width: 4}, Piece{at: 25, width: 6}, Piece{at: 7, width: 1}, Piece{at: 31, width: 1}};
val JTYPE_PIECES:  [4]Piece  = [4]Piece{Piece{at: 21, width: 10}, Piece{at: 20, width: 1}, Piece{at: 12, width: 8}, Piece{at: 31, width: 1}};
val CALL_PIECES:   [2]Piece  = [2]Piece{Piece{at: 52, width: 12}, Piece{at: 12, width: 20}};
val CBTYPE_PIECES: [5]Piece  = [5]Piece{Piece{at: 3, width: 2}, Piece{at: 10, width: 2}, Piece{at: 2, width: 1}, Piece{at: 5, width: 2}, Piece{at: 12, width: 1}};
val CJTYPE_PIECES: [8]Piece  = [8]Piece{Piece{at: 3, width: 3}, Piece{at: 11, width: 1}, Piece{at: 2, width: 1}, Piece{at: 7, width: 1}, Piece{at: 6, width: 1}, Piece{at: 9, width: 2}, Piece{at: 8, width: 1}, Piece{at: 12, width: 1}};
val ULEB_PIECES:   [10]Piece = [10]Piece{Piece{at: 0, width: 7}, Piece{at: 8, width: 7}, Piece{at: 16, width: 7}, Piece{at: 24, width: 7}, Piece{at: 32, width: 7}, Piece{at: 40, width: 7}, Piece{at: 48, width: 7}, Piece{at: 56, width: 7}, Piece{at: 64, width: 7}, Piece{at: 72, width: 7}};

val DATA6:  Field = Field{bytes: 1, pieces: ?DATA6_PIECES[0], count: 1};
val DATA8:  Field = Field{bytes: 1, pieces: ?DATA8_PIECES[0], count: 1};
val DATA16: Field = Field{bytes: 2, pieces: ?DATA16_PIECES[0], count: 1};
val DATA32: Field = Field{bytes: 4, pieces: ?DATA32_PIECES[0], count: 1};
val DATA64: Field = Field{bytes: 8, pieces: ?DATA64_PIECES[0], count: 1};
val EMPTY:  Field = Field{bytes: 0, pieces: nil, count: 0};
val UTYPE:  Field = Field{bytes: 4, pieces: ?UTYPE_PIECES[0], count: 1, shift: 12, round: true, insn: true};
val ITYPE:  Field = Field{bytes: 4, pieces: ?ITYPE_PIECES[0], count: 1, insn: true};
val STYPE:  Field = Field{bytes: 4, pieces: ?STYPE_PIECES[0], count: 2, insn: true};
val BTYPE:  Field = Field{bytes: 4, pieces: ?BTYPE_PIECES[0], count: 4, shift: 1, insn: true};
val JTYPE:  Field = Field{bytes: 4, pieces: ?JTYPE_PIECES[0], count: 4, shift: 1, insn: true};
val CALLF:  Field = Field{bytes: 8, pieces: ?CALL_PIECES[0], count: 2, split: 12, insn: true};
val CBTYPE: Field = Field{bytes: 2, pieces: ?CBTYPE_PIECES[0], count: 5, shift: 1, insn: true};
val CJTYPE: Field = Field{bytes: 2, pieces: ?CJTYPE_PIECES[0], count: 8, shift: 1, insn: true};
val ULEB:   Field = Field{bytes: 10, pieces: ?ULEB_PIECES[0], count: 10, run: true};

val BTYPE_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?BTYPE}};
val CALLF_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?CALLF}};
val CBTYPE_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?CBTYPE}};
val CJTYPE_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?CJTYPE}};
val DATA16_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?DATA16}};
val DATA32_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?DATA32}};
val DATA6_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?DATA6}};
val DATA64_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?DATA64}};
val DATA8_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?DATA8}};
val EMPTY_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?EMPTY}};
val ITYPE_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?ITYPE}};
val JTYPE_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?JTYPE}};
val STYPE_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?STYPE}};
val ULEB_FIELD:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?ULEB}};
val UTYPE_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?UTYPE}};

val WRAP:  Range = Range{check: Check.wrap{}, bits: 0, align: 1};
val ANY32: Range = Range{check: Check.either{}, bits: 32, align: 1};
val S32:   Range = Range{check: Check.signed{}, bits: 32, align: 1};
val U64:   Range = Range{check: Check.unsigned{}, bits: 64, align: 1};
val BR:    Range = Range{check: Check.signed{}, bits: 13, align: 2};
val JMP:   Range = Range{check: Check.signed{}, bits: 21, align: 2};
val RVB:   Range = Range{check: Check.signed{}, bits: 9, align: 2};
val RVJ:   Range = Range{check: Check.signed{}, bits: 12, align: 2};

val PCREL_HIS:     [4]u32 = [4]u32{23, 20, 21, 22};
val TLSDESC_HIS:   [1]u32 = [1]u32{62};
val SUB_ULEB_CODE: [1]u32 = [1]u32{61};
val SUB_ULEB_FROM: [1]u32 = [1]u32{60};

# a relaxation applies only where an R_RISCV_RELAX record follows at the same
# place, which it consumes and leaves a marker, as lld relaxes only a record
# whose next one is R_RISCV_RELAX
val RELAX_PARTNER: [1]Partner = [1]Partner{Partner{kind: ?riscv_kinds.RELAX}};
val S12:           Range      = Range{check: Check.signed{}, bits: 12, align: 1};

# auipc+jalr becomes jal when the target lies within its 21 bits, keeping the
# jalr's link register, and c.j when the link register is zero, the link
# carries the compressed extension and the target lies within 12 bits, as
# lld's relaxCall. the rewritten jump reaches the target's PLT entry where
# the call would, so a target the loader binds is jumped to at its entry and
# the range weighed is the entry's, as lld keeps the call's R_PLT_PC
val JAL:          [4]u8    = [4]u8{0x6f, 0x00, 0x00, 0x00};
val JAL_RD:       [1]Copy  = [1]Copy{Copy{from: 4, into: 0, len: 4, shift: 7, to: 7, width: 5}};
val TO_JAL_KINDS: [2]*Kind = [2]*Kind{?riscv_kinds.JAL20_PLT, ?riscv_kinds.RELAX};
val TO_JAL:       Rewrite  = Rewrite{
    name:       "to jal",
    when:       Condition{range: opt[Range].some{JMP}, partners: ?RELAX_PARTNER[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: 0, data: ?JAL[0], len: 4}, copies: ?JAL_RD[0], copy_count: 1, removal: Removal.bytes{Delete{at: 4, len: 4}}},
    kinds:      ?TO_JAL_KINDS[0],
    kind_count: 2,
    keeps_ct:   true,
};
val C_J:          [2]u8          = [2]u8{0x01, 0xa0};
val RVC_ON:       [1]os.When     = [1]os.When{os.When{axis: ?riscv.RISCV_RVC, setting: Setting.flag{true}}};
val JALR_RD_ZERO: [1]InsnPattern = [1]InsnPattern{InsnPattern{at: 4, mask: 0xf80, value: 0, len: 4}};
val TO_C_J_KINDS: [2]*Kind       = [2]*Kind{?riscv_kinds.RVC_JUMP_PLT, ?riscv_kinds.RELAX};
val TO_C_J:       Rewrite        = Rewrite{
    name:       "to c.j",
    when:       Condition{range: opt[Range].some{RVJ}, traits: ?RVC_ON[0], trait_count: 1, shape: ?JALR_RD_ZERO[0], shape_count: 1, partners: ?RELAX_PARTNER[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: 0, data: ?C_J[0], len: 2}, removal: Removal.bytes{Delete{at: 2, len: 6}}},
    kinds:      ?TO_C_J_KINDS[0],
    kind_count: 2,
    keeps_ct:   true,
};
val CALL_FORMS: [2]*Rewrite = [2]*Rewrite{?TO_JAL, ?TO_C_J};

# the register field of an I or S instruction is rewritten to a fixed base,
# the rest of the instruction carried, and its immediate written by the
# record's own row
val KEEP_BUT_RS1: [2]Copy = [2]Copy{Copy{from: 0, into: 0, len: 4, shift: 0, to: 0, width: 15}, Copy{from: 0, into: 0, len: 4, shift: 20, to: 20, width: 12}};
val RS1_ZERO:     [4]u8   = [4]u8{0x00, 0x00, 0x00, 0x00};
val RS1_TP:       [4]u8   = [4]u8{0x00, 0x00, 0x02, 0x00};

# lui+addi or lui+load/store of an address within 12 signed bits drops the
# lui and bases the low half on the zero register, as lld's relaxHi20Lo12
val TO_X0_HI_KINDS: [2]*Kind = [2]*Kind{?riscv_kinds.HI20_RELAXED, ?riscv_kinds.RELAX};
val TO_X0_HI:       Rewrite  = Rewrite{
    name:       "to x0 dropped",
    when:       Condition{range: opt[Range].some{S12}, partners: ?RELAX_PARTNER[0]},
    span:       1,
    emit:       Emit{removal: Removal.bytes{Delete{at: 0, len: 4}}},
    kinds:      ?TO_X0_HI_KINDS[0],
    kind_count: 2,
    keeps_ct:   true,
};
val TO_X0_HI_ONLY: [1]*Rewrite = [1]*Rewrite{?TO_X0_HI};
val TO_X0_I_KINDS: [2]*Kind    = [2]*Kind{?riscv_kinds.LO12_I, ?riscv_kinds.RELAX};
val TO_X0_I:       Rewrite     = Rewrite{
    name:       "to x0 based",
    when:       Condition{range: opt[Range].some{S12}, partners: ?RELAX_PARTNER[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: 0, data: ?RS1_ZERO[0], len: 4}, copies: ?KEEP_BUT_RS1[0], copy_count: 2},
    kinds:      ?TO_X0_I_KINDS[0],
    kind_count: 2,
    keeps_ct:   true,
};
val TO_X0_I_ONLY:  [1]*Rewrite = [1]*Rewrite{?TO_X0_I};
val TO_X0_S_KINDS: [2]*Kind    = [2]*Kind{?riscv_kinds.LO12_S, ?riscv_kinds.RELAX};
val TO_X0_S:       Rewrite     = Rewrite{
    name:       "to x0 based",
    when:       Condition{range: opt[Range].some{S12}, partners: ?RELAX_PARTNER[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: 0, data: ?RS1_ZERO[0], len: 4}, copies: ?KEEP_BUT_RS1[0], copy_count: 2},
    kinds:      ?TO_X0_S_KINDS[0],
    kind_count: 2,
    keeps_ct:   true,
};
val TO_X0_S_ONLY: [1]*Rewrite = [1]*Rewrite{?TO_X0_S};

# lui+add+addi or lui+add+load/store of a thread-pointer offset within 12
# signed bits drops the lui and the add and bases the low half on tp, as
# lld's relaxTlsLe
val TO_TP_DROPPED_KINDS: [2]*Kind = [2]*Kind{?riscv_kinds.TPREL_RELAXED, ?riscv_kinds.RELAX};
val TO_TP_DROPPED:       Rewrite  = Rewrite{
    name:       "to tp dropped",
    when:       Condition{range: opt[Range].some{S12}, partners: ?RELAX_PARTNER[0]},
    span:       1,
    emit:       Emit{removal: Removal.bytes{Delete{at: 0, len: 4}}},
    kinds:      ?TO_TP_DROPPED_KINDS[0],
    kind_count: 2,
    keeps_ct:   true,
};
val TO_TP_DROPPED_ONLY: [1]*Rewrite = [1]*Rewrite{?TO_TP_DROPPED};
val TO_TP_I_KINDS:      [2]*Kind    = [2]*Kind{?riscv_kinds.TPREL_LO12_I, ?riscv_kinds.RELAX};
val TO_TP_I:            Rewrite     = Rewrite{
    name:       "to tp based",
    when:       Condition{range: opt[Range].some{S12}, partners: ?RELAX_PARTNER[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: 0, data: ?RS1_TP[0], len: 4}, copies: ?KEEP_BUT_RS1[0], copy_count: 2},
    kinds:      ?TO_TP_I_KINDS[0],
    kind_count: 2,
    keeps_ct:   true,
};
val TO_TP_I_ONLY:  [1]*Rewrite = [1]*Rewrite{?TO_TP_I};
val TO_TP_S_KINDS: [2]*Kind    = [2]*Kind{?riscv_kinds.TPREL_LO12_S, ?riscv_kinds.RELAX};
val TO_TP_S:       Rewrite     = Rewrite{
    name:       "to tp based",
    when:       Condition{range: opt[Range].some{S12}, partners: ?RELAX_PARTNER[0]},
    span:       1,
    emit:       Emit{bytes: Bytes{at: 0, data: ?RS1_TP[0], len: 4}, copies: ?KEEP_BUT_RS1[0], copy_count: 2},
    kinds:      ?TO_TP_S_KINDS[0],
    kind_count: 2,
    keeps_ct:   true,
};
val TO_TP_S_ONLY: [1]*Rewrite = [1]*Rewrite{?TO_TP_S};

# the padding an ALIGN states is deleted down to what its alignment needs, the
# least power of two at or above its addend plus the two bytes of the least
# instruction, as the psABI rounds the padding up to the next power of two and
# lld takes PowerOf2Ceil(addend + 2). the bytes kept are written with nop and
# then c.nop, as lld writes them. it must apply, as the bytes after it rely on
# their alignment
val NOP:              [4]u8       = [4]u8{0x13, 0x00, 0x00, 0x00};
val C_NOP:            [2]u8       = [2]u8{0x01, 0x00};
val FILLS:            [2]Bytes    = [2]Bytes{Bytes{data: ?NOP[0], len: 4}, Bytes{data: ?C_NOP[0], len: 2}};
val TO_ALIGNED_KINDS: [1]*Kind    = [1]*Kind{?riscv_kinds.ALIGN};
val TO_ALIGNED:       Rewrite     = Rewrite{name: "to aligned", emit: Emit{removal: Removal.pad{Pad{unit: 2, fills: ?FILLS[0], fill_count: 2}}}, kinds: ?TO_ALIGNED_KINDS[0], kind_count: 1, keeps_ct: true, must: true};
val TO_ALIGNED_ONLY:  [1]*Rewrite = [1]*Rewrite{?TO_ALIGNED};

val ROWS: [58]Row = [58]Row{
    Row{
        key:    3,
        name:   "R_RISCV_RELATIVE",
        kind:   ?kinds.RELATIVE,
        fields: ?EMPTY_FIELD[0], field_count: 1,
        value:  ?compute.BASE,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    5,
        name:   "R_RISCV_JUMP_SLOT",
        kind:   ?kinds.JUMP_SLOT,
        fields: ?EMPTY_FIELD[0], field_count: 1,
        value:  ?compute.SYMBOL,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    58,
        name:   "R_RISCV_IRELATIVE",
        kind:   ?kinds.IRELATIVE,
        fields: ?EMPTY_FIELD[0], field_count: 1,
        value:  ?compute.BASE,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    0,
        name:   "R_RISCV_NONE",
        kind:   ?reloc.NONE,
        fields: ?EMPTY_FIELD[0], field_count: 1,
        value:  ?compute.NONE,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    1,
        name:   "R_RISCV_32",
        kind:   ?reloc.ABS32,
        fields: ?DATA32_FIELD[0], field_count: 1,
        value:  ?compute.ABS,
        range:  ANY32,
        addend: Addend.record{},
    },
    Row{
        key:    2,
        name:   "R_RISCV_64",
        kind:   ?reloc.ABS64,
        fields: ?DATA64_FIELD[0], field_count: 1,
        value:  ?compute.ABS,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    4,
        name:   "R_RISCV_COPY",
        kind:   ?kinds.COPY,
        fields: ?EMPTY_FIELD[0], field_count: 1,
        value:  ?compute.NONE,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    6,
        name:   "R_RISCV_TLS_DTPMOD32",
        kind:   ?kinds.DTPMOD32,
        fields: ?EMPTY_FIELD[0], field_count: 1,
        value:  ?compute.INDEX,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    7,
        name:   "R_RISCV_TLS_DTPMOD64",
        kind:   ?kinds.DTPMOD64,
        fields: ?EMPTY_FIELD[0], field_count: 1,
        value:  ?compute.INDEX,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    8,
        name:   "R_RISCV_TLS_DTPREL32",
        kind:   ?kinds.DTPOFF32_DYN,
        fields: ?EMPTY_FIELD[0], field_count: 1,
        value:  ?compute.DTPOFF,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    9,
        name:   "R_RISCV_TLS_DTPREL64",
        kind:   ?kinds.DTPOFF64,
        fields: ?EMPTY_FIELD[0], field_count: 1,
        value:  ?compute.DTPOFF,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    10,
        name:   "R_RISCV_TLS_TPREL32",
        kind:   ?kinds.TPOFF32_DYN,
        fields: ?EMPTY_FIELD[0], field_count: 1,
        value:  ?compute.TPOFF,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    11,
        name:   "R_RISCV_TLS_TPREL64",
        kind:   ?kinds.TPOFF64,
        fields: ?EMPTY_FIELD[0], field_count: 1,
        value:  ?compute.TPOFF,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    12,
        name:   "R_RISCV_TLSDESC",
        kind:   ?kinds.TLSDESC,
        fields: ?EMPTY_FIELD[0], field_count: 1,
        value:  ?compute.NONE,
        range:  WRAP,
        addend: Addend.record{},
    },
    Row{
        key:    16,
        name:   "R_RISCV_BRANCH",
        kind:   ?riscv_kinds.BRANCH12,
        fields: ?BTYPE_FIELD[0], field_count: 1,
        value:  ?compute.PC,
        range:  BR,
        addend: Addend.record{},
    },
    Row{
        key:    17,
        name:   "R_RISCV_JAL",
        kind:   ?riscv_kinds.JAL20,
        fields: ?JTYPE_FIELD[0], field_count: 1,
        value:  ?compute.PC,
        range:  JMP,
        addend: Addend.record{},
    },
    Row{
        key:      18,
        name:     "R_RISCV_CALL",
        kind:     ?riscv_kinds.CALL_PAIR,
        fields:   ?CALLF_FIELD[0], field_count: 1,
        value:    ?compute.PC,
        range:    S32,
        addend:   Addend.record{},
        rewrites: ?CALL_FORMS[0], rewrite_count: 2,
    },
    Row{
        key:      19,
        name:     "R_RISCV_CALL_PLT",
        kind:     ?riscv_kinds.CALL_PLT_PAIR,
        fields:   ?CALLF_FIELD[0], field_count: 1,
        value:    ?compute.PLT,
        range:    S32,
        addend:   Addend.record{},
        rewrites: ?CALL_FORMS[0], rewrite_count: 2,
    },
    Row{
        key:    20,
        name:   "R_RISCV_GOT_HI20",
        kind:   ?riscv_kinds.GOT_PCREL_HI20,
        fields: ?UTYPE_FIELD[0], field_count: 1,
        value:  ?compute.GOT_PC,
        range:  S32,
        addend: Addend.record{},
    },
    Row{
        key:    21,
        name:   "R_RISCV_TLS_GOT_HI20",
        kind:   ?riscv_kinds.TLS_GOT_PCREL_HI20,
        fields: ?UTYPE_FIELD[0], field_count: 1,
        value:  ?compute.GOT_PC,
        range:  S32,
        addend: Addend.record{},
    },
    Row{
        key:    22,
        name:   "R_RISCV_TLS_GD_HI20",
        kind:   ?riscv_kinds.TLS_GD_PCREL_HI20,
        fields: ?UTYPE_FIELD[0], field_count: 1,
        value:  ?compute.GOT_PC,
        range:  S32,
        addend: Addend.record{},
    },
    Row{
        key:    23,
        name:   "R_RISCV_PCREL_HI20",
