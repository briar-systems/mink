# a difference is an ADD record naming the target and a SUB record naming the
# symbol subtracted at one place, which a linker that deletes bytes recomputes
val DIFFERENCE_COUNT: usize                        = 4;
val DIFFERENCES:      [DIFFERENCE_COUNT]Difference = [DIFFERENCE_COUNT]Difference{
    Difference{kind: ?reloc.DIFF8, plus: 33, minus: 37},
    Difference{kind: ?reloc.DIFF16, plus: 34, minus: 38},
    Difference{kind: ?reloc.DIFF32, plus: 35, minus: 39},
    Difference{kind: ?reloc.DIFF64, plus: 36, minus: 40},
};

val KINDS: [58]*Kind = [58]*Kind{?kinds.RELATIVE, ?kinds.JUMP_SLOT, ?kinds.IRELATIVE, ?reloc.NONE, ?reloc.ABS32, ?reloc.ABS64, ?kinds.COPY, ?kinds.DTPMOD32, ?kinds.DTPMOD64, ?kinds.DTPOFF32_DYN, ?kinds.DTPOFF64, ?kinds.TPOFF32_DYN, ?kinds.TPOFF64, ?kinds.TLSDESC, ?riscv_kinds.BRANCH12, ?riscv_kinds.JAL20, ?riscv_kinds.CALL_PAIR, ?riscv_kinds.CALL_PLT_PAIR, ?riscv_kinds.GOT_PCREL_HI20, ?riscv_kinds.TLS_GOT_PCREL_HI20, ?riscv_kinds.TLS_GD_PCREL_HI20, ?riscv_kinds.PCREL_HI20, ?riscv_kinds.PCREL_LO12_I, ?riscv_kinds.PCREL_LO12_S, ?riscv_kinds.HI20, ?riscv_kinds.LO12_I, ?riscv_kinds.LO12_S, ?riscv_kinds.TPREL_HI20, ?riscv_kinds.TPREL_LO12_I, ?riscv_kinds.TPREL_LO12_S, ?riscv_kinds.TPREL_ADD, ?riscv_kinds.ADD8, ?riscv_kinds.ADD16, ?riscv_kinds.ADD32, ?riscv_kinds.ADD64, ?riscv_kinds.SUB8, ?riscv_kinds.SUB16, ?riscv_kinds.SUB32, ?riscv_kinds.SUB64, ?kinds.GOTPCREL32, ?riscv_kinds.ALIGN, ?riscv_kinds.RVC_BRANCH, ?riscv_kinds.RVC_JUMP, ?riscv_kinds.RELAX, ?riscv_kinds.SUB6, ?riscv_kinds.SET6, ?riscv_kinds.SET8, ?riscv_kinds.SET16, ?riscv_kinds.SET32, ?reloc.PC32, ?kinds.PLT32, ?riscv_kinds.SET_ULEB128, ?riscv_kinds.SUB_ULEB128, ?riscv_kinds.TLSDESC_HI20, ?riscv_kinds.TLSDESC_PCREL_LOAD_LO12, ?riscv_kinds.TLSDESC_PCREL_ADD_LO12, ?riscv_kinds.TLSDESC_PCREL_CALL, ?riscv_kinds.VENDOR};

# both classes and both base integer ISAs read the same rows
pub val RV64:  Set = Set{format: ?format.ELF, arch: ?riscv.RISCV64, rows: ?ROWS[0], count: 58, kinds: ?KINDS[0], kind_count: 58, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT};
pub val RV32:  Set = Set{format: ?format.ELF, arch: ?riscv.RISCV32, rows: ?ROWS[0], count: 58, kinds: ?KINDS[0], kind_count: 58, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT};
pub val RV64E: Set = Set{format: ?format.ELF, arch: ?riscv.RISCV64E, rows: ?ROWS[0], count: 58, kinds: ?KINDS[0], kind_count: 58, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT};
pub val RV32E: Set = Set{format: ?format.ELF, arch: ?riscv.RISCV32E, rows: ?ROWS[0], count: 58, kinds: ?KINDS[0], kind_count: 58, differences: ?DIFFERENCES[0], difference_count: DIFFERENCE_COUNT};

val SETS: [4]*Set = [4]*Set{?RV64, ?RV32, ?RV64E, ?RV32E};

test riscv__rows_match_the_psabi_list {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    var i: usize = 0;
    for (i < 4) {
        val s: *Set                  = SETS[i];
        val c: res[row.Lookup, Fail] = row.build(testing.allocator_of(?t), s);
        if (sel c.err) { ret 1; }
        var l: row.Lookup = c.ok;
        if (s.count != riscv_source.SOURCE.count) { ret 1; }
        var k: usize = 0;
        for (k < riscv_source.SOURCE.count) {
            val want: *Constant       = riscv_source.SOURCE.rows[k];
            val got:  res[*Row, Fail] = row.by_key(?l, want.value::u32);
            if (sel got.err)                         { ret 1; }
            if (!str_equals(got.ok.name, want.name)) { ret 1; }
            k = k + 1;
        }
        k = 0;
        for (k < s.count) {
            val r: *Row = ?s.rows[k];
            if (reloc.has(r.kind, reloc.PARTNER) != sel r.pair.some) { ret 1; }
            k = k + 1;
        }
        val freed: err[Fail] = row.release_lookup(?l);
        if (sel freed.err) { ret 1; }
        i = i + 1;
    }
    testing.dnit(?t);
    ret 0;
}
