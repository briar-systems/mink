use mink.reloc.row.Row;
use mink.reloc.row.Set;

use A: std.allocator;
use std.allocator.testing;

val DATA8_PIECES:  [1]Piece  = [1]Piece{Piece{at: 0, width: 8}};
val DATA16_PIECES: [1]Piece  = [1]Piece{Piece{at: 0, width: 16}};
val DATA32_PIECES: [1]Piece  = [1]Piece{Piece{at: 0, width: 32}};
val DATA64_PIECES: [1]Piece  = [1]Piece{Piece{at: 0, width: 64}};
val DATA6_PIECES:  [1]Piece  = [1]Piece{Piece{at: 0, width: 6}};
val UTYPE_PIECES:  [1]Piece  = [1]Piece{Piece{at: 12, width: 20}};
val ITYPE_PIECES:  [1]Piece  = [1]Piece{Piece{at: 20, width: 12}};
val STYPE_PIECES:  [2]Piece  = [2]Piece{Piece{at: 7, width: 5}, Piece{at: 25, width: 7}};
val BTYPE_PIECES:  [4]Piece  = [4]Piece{Piece{at: 8, width: 4}, Piece{at: 25, width: 6}, Piece{at: 7, width: 1}, Piece{at: 31, width: 1}};
val JTYPE_PIECES:  [4]Piece  = [4]Piece{Piece{at: 21, width: 10}, Piece{at: 20, width: 1}, Piece{at: 12, width: 8}, Piece{at: 31, width: 1}};
val CALL_PIECES:   [2]Piece  = [2]Piece{Piece{at: 52, width: 12}, Piece{at: 12, width: 20}};
val CBTYPE_PIECES: [5]Piece  = [5]Piece{Piece{at: 3, width: 2}, Piece{at: 10, width: 2}, Piece{at: 2, width: 1}, Piece{at: 5, width: 2}, Piece{at: 12, width: 1}};
val CJTYPE_PIECES: [8]Piece  = [8]Piece{Piece{at: 3, width: 3}, Piece{at: 11, width: 1}, Piece{at: 2, width: 1}, Piece{at: 7, width: 1}, Piece{at: 6, width: 1}, Piece{at: 9, width: 2}, Piece{at: 8, width: 1}, Piece{at: 12, width: 1}};
val ULEB_PIECES:   [10]Piece = [10]Piece{Piece{at: 0, width: 7}, Piece{at: 8, width: 7}, Piece{at: 16, width: 7}, Piece{at: 24, width: 7}, Piece{at: 32, width: 7}, Piece{at: 40, width: 7}, Piece{at: 48, width: 7}, Piece{at: 56, width: 7}, Piece{at: 64, width: 7}, Piece{at: 72, width: 7}};

val DATA6:  Field = Field{bytes: 1, pieces: ?DATA6_PIECES[0], count: 1};
val DATA8:  Field = Field{bytes: 1, pieces: ?DATA8_PIECES[0], count: 1};
val DATA16: Field = Field{bytes: 2, pieces: ?DATA16_PIECES[0], count: 1};
val DATA32: Field = Field{bytes: 4, pieces: ?DATA32_PIECES[0], count: 1};
val DATA64: Field = Field{bytes: 8, pieces: ?DATA64_PIECES[0], count: 1};
val EMPTY:  Field = Field{bytes: 0, pieces: nil, count: 0};
val UTYPE:  Field = Field{bytes: 4, pieces: ?UTYPE_PIECES[0], count: 1, shift: 12, round: true, insn: true};
val ITYPE:  Field = Field{bytes: 4, pieces: ?ITYPE_PIECES[0], count: 1, insn: true};
val STYPE:  Field = Field{bytes: 4, pieces: ?STYPE_PIECES[0], count: 2, insn: true};
val BTYPE:  Field = Field{bytes: 4, pieces: ?BTYPE_PIECES[0], count: 4, shift: 1, insn: true};
val JTYPE:  Field = Field{bytes: 4, pieces: ?JTYPE_PIECES[0], count: 4, shift: 1, insn: true};
val CALLF:  Field = Field{bytes: 8, pieces: ?CALL_PIECES[0], count: 2, split: 12, insn: true};
val CBTYPE: Field = Field{bytes: 2, pieces: ?CBTYPE_PIECES[0], count: 5, shift: 1, insn: true};
val CJTYPE: Field = Field{bytes: 2, pieces: ?CJTYPE_PIECES[0], count: 8, shift: 1, insn: true};
val ULEB:   Field = Field{bytes: 10, pieces: ?ULEB_PIECES[0], count: 10, run: true};

val BTYPE_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?BTYPE}};
val CALLF_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?CALLF}};
val CBTYPE_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?CBTYPE}};
val CJTYPE_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?CJTYPE}};
val DATA16_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?DATA16}};
val DATA32_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?DATA32}};
val DATA6_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?DATA6}};
val DATA64_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?DATA64}};
val DATA8_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?DATA8}};
val EMPTY_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?EMPTY}};
val ITYPE_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?ITYPE}};
val JTYPE_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?JTYPE}};
val STYPE_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?STYPE}};
val ULEB_FIELD:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?ULEB}};
val UTYPE_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?UTYPE}};

val WRAP:  Range = Range{check: Check.wrap{}, bits: 0, align: 1};
val ANY32: Range = Range{check: Check.either{}, bits: 32, align: 1};
val S32:   Range = Range{check: Check.signed{}, bits: 32, align: 1};
val U64:   Range = Range{check: Check.unsigned{}, bits: 64, align: 1};
val BR:    Range = Range{check: Check.signed{}, bits: 13, align: 2};
val JMP:   Range = Range{check: Check.signed{}, bits: 21, align: 2};
val RVB:   Range = Range{check: Check.signed{}, bits: 9, align: 2};
val RVJ:   Range = Range{check: Check.signed{}, bits: 12, align: 2};

val PCREL_HIS:     [4]u32 = [4]u32{23, 20, 21, 22};
val TLSDESC_HIS:   [1]u32 = [1]u32{62};
val SUB_ULEB_CODE: [1]u32 = [1]u32{61};
val SUB_ULEB_FROM: [1]u32 = [1]u32{60};

val TO_NONE_KINDS:               [1]*Kind    = [1]*Kind{?reloc.NONE};
val TO_NONE:                     Rewrite     = Rewrite{name: "to none", emit: Emit.bytes{Bytes{}}, kinds: ?TO_NONE_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_NONE_ONLY:                [1]*Rewrite = [1]*Rewrite{?TO_NONE};
val TO_JAL20_KINDS:              [1]*Kind    = [1]*Kind{?riscv_kinds.JAL20};
val TO_JAL20:                    Rewrite     = Rewrite{name: "to jal20", emit: Emit.bytes{Bytes{}}, kinds: ?TO_JAL20_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_JAL20_ONLY:               [1]*Rewrite = [1]*Rewrite{?TO_JAL20};
val TO_TLS_GOT_PCREL_HI20_KINDS: [1]*Kind    = [1]*Kind{?riscv_kinds.TLS_GOT_PCREL_HI20};
val TO_TLS_GOT_PCREL_HI20:       Rewrite     = Rewrite{name: "to tls_got_pcrel_hi20", emit: Emit.bytes{Bytes{}}, kinds: ?TO_TLS_GOT_PCREL_HI20_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_TLS_GOT_PCREL_HI20_ONLY:  [1]*Rewrite = [1]*Rewrite{?TO_TLS_GOT_PCREL_HI20};
val TO_TPREL_HI20_KINDS:         [1]*Kind    = [1]*Kind{?riscv_kinds.TPREL_HI20};
val TO_TPREL_HI20:               Rewrite     = Rewrite{name: "to tprel_hi20", emit: Emit.bytes{Bytes{}}, kinds: ?TO_TPREL_HI20_KINDS[0], kind_count: 1, keeps_ct: true};
val TO_TPREL_HI20_ONLY:          [1]*Rewrite = [1]*Rewrite{?TO_TPREL_HI20};

