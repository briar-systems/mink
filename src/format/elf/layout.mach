# how ELF lays an image out
#
# an input section merges into the output section its name stems from, as
# .text.hot into .text, and output sections load by class: code, read-only
# data, data read-only after relocation, thread-local data, then data with
# its zero fill last. the thread-local zero fill closes the segment that
# loads read-only after relocation, so no data the file holds follows it there
# and it takes no file space.

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.base.rule.Axis;
use mink.format.elf.neutral.naming;
use mink.format.layout.Class;
use mink.format.layout.Load;
use mink.format.layout.Opening;
use mink.format.layout.Rules;
use mink.model.section;

val STEM_COUNT: usize           = 11;
val STEMS:      [STEM_COUNT]str = [STEM_COUNT]str{
    ".text", ".rodata", ".data.rel.ro", ".data", ".bss", ".tdata", ".tbss",
    ".init_array", ".fini_array", ".preinit_array", ".gcc_except_table",
};

val CODE:  Load = Load{name: "code", flags: section.ALLOC | section.EXEC};
val CONST: Load = Load{name: "rodata", flags: section.ALLOC};
val RELRO: Load = Load{name: "relro", flags: section.ALLOC | section.WRITE};
val DATA:  Load = Load{name: "data", flags: section.ALLOC | section.WRITE};

val TLS:       section.Flags = section.ALLOC | section.WRITE | section.TLS;
val WRITTEN:   section.Flags = section.ALLOC | section.WRITE;
val UNWRITTEN: section.Flags = section.EXEC | section.TLS;

val CLASS_COUNT: usize              = 8;
val CLASSES:     [CLASS_COUNT]Class = [CLASS_COUNT]Class{
    Class{name: "code", rank: 0, flags: Axis{need: section.ALLOC | section.EXEC, deny: section.WRITE}, load: opt[*Load].some{?CODE}},
    Class{name: "rodata", rank: 1, flags: Axis{need: section.ALLOC, deny: section.WRITE | section.EXEC}, load: opt[*Load].some{?CONST}},
    Class{name: "relro", rank: 2, flags: Axis{need: WRITTEN, deny: UNWRITTEN}, roles: Axis{need: section.RELRO}, load: opt[*Load].some{?RELRO}},
    Class{name: "tdata", rank: 3, flags: Axis{need: TLS, deny: section.EXEC}, roles: Axis{need: section.BITS}, load: opt[*Load].some{?RELRO}},
    Class{name: "tbss", rank: 4, flags: Axis{need: TLS, deny: section.EXEC}, roles: Axis{deny: section.BITS}, load: opt[*Load].some{?RELRO}},
    Class{name: "data", rank: 5, flags: Axis{need: WRITTEN, deny: UNWRITTEN}, roles: Axis{need: section.BITS, deny: section.RELRO}, load: opt[*Load].some{?DATA}},
    Class{name: "bss", rank: 6, flags: Axis{need: WRITTEN, deny: UNWRITTEN}, roles: Axis{deny: section.BITS | section.RELRO}, load: opt[*Load].some{?DATA}},
    Class{name: "unloaded", rank: 7, flags: Axis{deny: section.ALLOC}, load: opt[*Load].none{}},
};
pub val LAYOUT: Rules = Rules{
    name:          "elf",
    stems:         ?STEMS[0],
    stem_count:    STEM_COUNT,
    joint:         '.',
    cut:           0,
    classes:       ?CLASSES[0],
    class_count:   CLASS_COUNT,
    commons:       ".bss",
    opens:         Opening.congruent{},
    section_align: 1,
    file_align:    1,
    sections:      opt[u64].some{1},
    naming:        naming.name_of,
};
