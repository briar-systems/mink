# the compression types of SHF_COMPRESSED sections and the methods that code
# them
#
# a compressed section's bytes decompress to exactly the size its compression
# header states, and a type no row names is unsupported. a compressed body
# made here aligns its header to the class's address size, and states the
# alignment of the bytes it holds in the header.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.bytes.compress;
use mink.bytes.compress.Method;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.elf.model.model;
use mink.format.elf.model.model.Compressed;
use mink.format.elf.model.model.Elf;
use mink.format.elf.model.tables;
use mink.format.elf.model.tables.Constant;

# a compression type and the method it names
rec Row {
    code:   *Constant;
    method: *Method;
}

val ROW_COUNT: usize          = 2;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{code: ?tables.ELFCOMPRESS_ZLIB, method: ?compress.ZLIB},
    Row{code: ?tables.ELFCOMPRESS_ZSTD, method: ?compress.ZSTD},
};

# the method of compression type `code`
pub fun method_of(code: u32) res[*Method, Fail] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].code.value == code::u64) { ret res[*Method, Fail].ok{ROWS[i].method}; }
        i = i + 1;
    }
    ret res[*Method, Fail].err{fail.valued(fail.unsupported("compression type names no method"), code::i128)};
}

# the compression type of method `m`
pub fun code_of(m: *Method) res[u32, Fail] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].method == m) { ret res[u32, Fail].ok{ROWS[i].code.value::u32}; }
        i = i + 1;
    }
    ret res[u32, Fail].err{fail.about(fail.unsupported("ELF states no compression type for the method"), m.name)};
}

# the bytes of compressed body `z` of model `m`, decompressed onto `out`
pub fun inflate(a: *A.Allocator, m: *Elf, z: *Compressed, out: *Sink) err[Fail] {
    val method: res[*Method, Fail] = method_of(z.type);
    if (sel method.err) { ret err[Fail].err{method.err}; }
    val size: res[usize, Fail] = checked.to_usize(Location{record: "compression header"}, z.length);
    if (sel size.err) { ret err[Fail].err{size.err}; }
    val src: Bytes = model.bytes(m, ?z.data);
    ret compress.inflate(method.ok, a, src.data, src.len, size.ok, out);
}

# the `n` bytes at `src` compressed by `method` into a body held by model
# `m`, of bytes aligned to `align`
pub fun deflate(a: *A.Allocator, m: *Elf, method: *Method, src: *u8, n: usize, align: u64) res[Compressed, Fail] {
    val code: res[u32, Fail] = code_of(method);
    if (sel code.err) { ret res[Compressed, Fail].err{code.err}; }
    var out: Sink      = sink.make(a, m.shape.order);
    val w:   err[Fail] = compress.deflate(method, a, src, n, ?out);
    if (sel w.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret res[Compressed, Fail].err{w.err};
    }
    val held: res[Held, Fail] = model.own(m, sink.data(?out), sink.len(?out));
    val rel:  err[Fail]       = sink.release(?out);
    if (sel held.err) { ret res[Compressed, Fail].err{held.err}; }
    if (sel rel.err)  { ret res[Compressed, Fail].err{rel.err}; }
    ret res[Compressed, Fail].ok{Compressed{type: code.ok, reserved: 0, length: n::u64, addralign: align, data: held.ok}};
}
