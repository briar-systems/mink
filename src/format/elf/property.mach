# the GNU properties of an ELF file as one set
#
# a file may state its GNU properties in several notes, as gcc and gas each
# write one, and their properties are one set of facts. a type one note
# states is the file's as that note states it. a word type several notes
# state merges bit by bit through the trait rows, each bit by its axis's
# rule, and a bit no row maps carries nothing, so it must be clear in every
# note. any other type several notes state carries nothing either, so its
# data must be all zero bytes in every note. what is refused names the type.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.vectors;
use mink.bytes.reader;
use mink.bytes.reader.Order;
use mink.bytes.reader.Reader;
use mink.catalog.arch.Arch;
use mink.format.elf.model.model;
use mink.format.elf.model.model.Elf;
use mink.format.elf.model.model.Note;
use mink.format.elf.model.model.Property;
use mink.format.elf.model.model.Section;
use mink.format.elf.traits;
use mink.format.elf.traits.Word;
use mink.format.elf.traits.Words;

# a GNU property of a file, what its notes state merged
# ---
# type: its type
# data: its data as the first note that states it holds it, borrowed from the model
# word: its merged value when its data is one word
# note: the last note that states it, counted across the file
pub rec Merged {
    type: u32;
    data: Bytes;
    word: u32;
    note: usize;
}

# merged: every type once, in the order of the types
# order:  the types in the order the file first states them
pub rec Set {
    merged: Vector[Merged];
    order:  Vector[u32];
}

# an empty set of properties
# ---
# a:   the allocator the set grows in
# ret: the set, which the caller releases with dnit
pub fun init(a: *A.Allocator) Set {
    ret Set{merged: vector.init[Merged](a), order: vector.init[u32](a)};
}

# give back the storage of a set, both vectors even when the first refuses
# ---
# s:   the set
# ret: the first refusal of either release, or ok
pub fun dnit(s: *Set) err[Fail] {
    val err_release:       err[Fail] = vectors.dnit[Merged](?s.merged);
    val err_release_order: err[Fail] = vectors.dnit[u32](?s.order);
    if (sel err_release.err) { ret err_release; }
    ret err_release_order;
}

fun order_merged(a: *Merged, b: *Merged) i64 {
    if (a.type < b.type) { ret -1; }
    if (a.type > b.type) { ret 1; }
    ret 0;
}

fun position(s: *Set, type: u32) SearchPosition {
    var probe: Merged = Merged{type: type};
    ret sort.binary_search_by[Merged](s.merged.data, vector.length[Merged](?s.merged), ?probe, order_merged);
}

# the property of `type` in `s`, none when the file states none
pub fun find(s: *Set, type: u32) opt[*Merged] {
    val at: SearchPosition = position(s, type);
    if (sel at.found) { ret opt[*Merged].some{?s.merged.data[at.found]}; }
    ret opt[*Merged].none{};
}

# add to `out` the properties of every GNU property note of `m`, a file for
# `a`, merged. a type one note states twice is malformed, and notes whose
# values of a type do not merge are refused, naming it
pub fun gather(m: *Elf, a: *Arch, out: *Set) err[Fail] {
    var n: usize = 0;
    var i: usize = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = model.section_at(m, table.nth[Section](i));
        i = i + 1;
        if (!sel s.body.notes) { cnt; }
        val err_gather_notes: err[Fail] = gather_notes(?s.body.notes, store.base(?m.store), m.shape.order, a, out, ?n);
        if (sel err_gather_notes.err) { ret err_gather_notes; }
    }
    ret err[Fail].ok{};
}

# add to `out` the properties of each GNU property note of `notes`, of a file
# for `a` in byte order `order`, merged as `gather` merges them. what the
# notes hold and own lies at `base`, and `n` counts the notes across the file
pub fun gather_notes(notes: *Vector[Note], base: *u8, order: Order, a: *Arch, out: *Set, n: *usize) err[Fail] {
    var k: usize = 0;
    for (k < vector.length[Note](notes)) {
        val note: *Note = ?notes.data[k];
        k = k + 1;
        if (!sel note.desc.properties) { cnt; }
        @n = @n + 1;
        var j: usize = 0;
        for (j < vector.length[Property](?note.desc.properties)) {
            val p:              *Property = ?note.desc.properties.data[j];
            val err_base_taken: err[Fail] = take(base, order, a, out, @n, p);
            if (sel err_base_taken.err) { ret err_base_taken; }
            j = j + 1;
        }
    }
    ret err[Fail].ok{};
}

# take property `p` of note `n` into `out`
fun take(base: *u8, order: Order, a: *Arch, out: *Set, n: usize, p: *Property) err[Fail] {
    val data: Bytes          = store.at(base, ?p.data);
    var word: u32            = 0;
    val at:   SearchPosition = position(out, p.type);
    if (data.len == 4) {
        var rd:      Reader         = reader.make(nil, data.data, data.len, order);
        val res_u32: res[u32, Fail] = reader.u32(?rd);
        if (sel res_u32.err) { ret err[Fail].err{res_u32.err}; }
        word = res_u32.ok;
    }
    if (sel at.insertion) {
        val err_put: err[Fail] = vectors.insert[Merged](?out.merged, at.insertion, Merged{type: p.type, data: data, word: word, note: n});
        if (sel err_put.err) { ret err_put; }
        val err_first: err[Fail] = vectors.push[u32](?out.order, p.type);
        if (sel err_first.err) { ret err[Fail].err{err_first.err}; }
        ret err[Fail].ok{};
    }
    val e: *Merged = ?out.merged.data[at.found];
    if (e.note == n) { ret err[Fail].err{fail.valued(fail.malformed("a GNU property type is held twice in one note"), p.type::i128)}; }
    e.note = n;
    if (e.data.len == 4 && data.len == 4) {
        val res_merge_word: res[u32, Fail] = traits.merge_word(a, p.type, e.word, word);
        if (sel res_merge_word.err) { ret err[Fail].err{res_merge_word.err}; }
        e.word = res_merge_word.ok;
        ret err[Fail].ok{};
    }
    if (zero(e.data) && zero(data)) { ret err[Fail].ok{}; }
    ret err[Fail].err{fail.valued(fail.unsupported("GNU property notes state data of a type no trait row maps"), p.type::i128)};
}

fun zero(b: Bytes) bool {
    var i: usize = 0;
    for (i < b.len) {
        if (b.data[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# add to `out` every property of `s` whose data is one word, the part of the
# notes the trait rows read
pub fun words(s: *Set, out: *Words) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Merged](?s.merged)) {
        val p: *Merged = ?s.merged.data[i];
        i = i + 1;
        if (p.data.len != 4) { cnt; }
        val err_added: err[Fail] = traits.add_word(out, Word{type: p.type, value: p.word});
        if (sel err_added.err) { ret err_added; }
    }
    ret err[Fail].ok{};
}
