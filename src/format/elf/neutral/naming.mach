# the ELF section each neutral section kind is written as
#
# one row per kind, and per element size of a kind keyed by one, looked up by
# the kind's name and that size. a row states the section type and the name a
# section that states only its key takes. merged strings and constants are
# named from their element size as GCC and clang write them, .rodata.str<w>.<w>
# and .rodata.cst<n>, and carry SHF_MERGE, SHF_STRINGS for strings, and their
# size as sh_entsize from the section's own flags and entsize. a note, a
# debugging table or metadata says by its own name what it holds, and a link
# warning is named for its symbol, so those kinds have no name of their own
# and a nameless section of one is refused.
# the flags come from the section, which starts with its kind's.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;
use std.types.string.str_len;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.store.Bytes;
use mink.format.contract;
use mink.format.contract.Naming;
use mink.format.elf.model.tables;
use mink.format.elf.model.tables.Constant;
use mink.model.section;

# kind:    the neutral kind
# entsize: the element size of a keyed kind's row, zero for another kind
# type:    the section type it is written as when no fact states another
# name:   the name a section of the kind that states none takes, none when
#         the kind has no name of its own
# family: for a kind with no name of its own, the start of the names the
#         assembler convention gives it, none for none
pub rec Row {
    kind:    *section.Kind;
    entsize: u64;
    type:    *Constant;
    name:    opt[str];
    family:  opt[str];
}

# the start of the names ELF assemblers give the local labels they make for
# their own use
pub val TEMPORARY: str = ".L";

val TEXT:          Row = Row{kind: ?section.TEXT, type: ?tables.SHT_PROGBITS, name: opt[str].some{".text"}};
val RODATA:        Row = Row{kind: ?section.RODATA, type: ?tables.SHT_PROGBITS, name: opt[str].some{".rodata"}};
val DATA:          Row = Row{kind: ?section.DATA, type: ?tables.SHT_PROGBITS, name: opt[str].some{".data"}};
val RELRO_DATA:    Row = Row{kind: ?section.RELRO_DATA, type: ?tables.SHT_PROGBITS, name: opt[str].some{".data.rel.ro"}};
val BSS:           Row = Row{kind: ?section.BSS, type: ?tables.SHT_NOBITS, name: opt[str].some{".bss"}};
val TLS_DATA:      Row = Row{kind: ?section.TLS_DATA, type: ?tables.SHT_PROGBITS, name: opt[str].some{".tdata"}};
val TLS_BSS:       Row = Row{kind: ?section.TLS_BSS, type: ?tables.SHT_NOBITS, name: opt[str].some{".tbss"}};
val INIT_ARRAY:    Row = Row{kind: ?section.INIT_ARRAY, type: ?tables.SHT_INIT_ARRAY, name: opt[str].some{".init_array"}};
val FINI_ARRAY:    Row = Row{kind: ?section.FINI_ARRAY, type: ?tables.SHT_FINI_ARRAY, name: opt[str].some{".fini_array"}};
val PREINIT_ARRAY: Row = Row{kind: ?section.PREINIT_ARRAY, type: ?tables.SHT_PREINIT_ARRAY, name: opt[str].some{".preinit_array"}};
val UNWIND_INFO:   Row = Row{kind: ?section.UNWIND_INFO, type: ?tables.SHT_PROGBITS, name: opt[str].some{".eh_frame"}};
val NOTE_INFO:     Row = Row{kind: ?section.NOTE_INFO, type: ?tables.SHT_NOTE, name: opt[str].none{}, family: opt[str].some{".note"}};
val DEBUG_INFO:    Row = Row{kind: ?section.DEBUG_INFO, type: ?tables.SHT_PROGBITS, name: opt[str].none{}, family: opt[str].some{".debug"}};
val METADATA:      Row = Row{kind: ?section.METADATA, type: ?tables.SHT_PROGBITS, name: opt[str].none{}};
val ADDRSIG:       Row = Row{kind: ?section.ADDRSIG_TABLE, type: ?tables.SHT_LLVM_ADDRSIG, name: opt[str].some{".llvm_addrsig"}};
val COMMENT:       Row = Row{kind: ?section.COMMENT_STRINGS, type: ?tables.SHT_PROGBITS, name: opt[str].some{".comment"}};
val STACK:         Row = Row{kind: ?section.STACK_NOTE, type: ?tables.SHT_PROGBITS, name: opt[str].some{".note.GNU-stack"}};
val WARNING:       Row = Row{kind: ?section.LINK_WARNING, type: ?tables.SHT_PROGBITS, name: opt[str].none{}};
val STR1:          Row = Row{kind: ?section.MERGED_STRINGS, entsize: 1, type: ?tables.SHT_PROGBITS, name: opt[str].some{".rodata.str1.1"}};
val STR2:          Row = Row{kind: ?section.MERGED_STRINGS, entsize: 2, type: ?tables.SHT_PROGBITS, name: opt[str].some{".rodata.str2.2"}};
val STR4:          Row = Row{kind: ?section.MERGED_STRINGS, entsize: 4, type: ?tables.SHT_PROGBITS, name: opt[str].some{".rodata.str4.4"}};
val CST4:          Row = Row{kind: ?section.MERGED_CONSTANTS, entsize: 4, type: ?tables.SHT_PROGBITS, name: opt[str].some{".rodata.cst4"}};
val CST8:          Row = Row{kind: ?section.MERGED_CONSTANTS, entsize: 8, type: ?tables.SHT_PROGBITS, name: opt[str].some{".rodata.cst8"}};
val CST16:         Row = Row{kind: ?section.MERGED_CONSTANTS, entsize: 16, type: ?tables.SHT_PROGBITS, name: opt[str].some{".rodata.cst16"}};
val CST32:         Row = Row{kind: ?section.MERGED_CONSTANTS, entsize: 32, type: ?tables.SHT_PROGBITS, name: opt[str].some{".rodata.cst32"}};

val ROW_COUNT: usize           = 25;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{
    ?TEXT, ?RODATA, ?DATA, ?RELRO_DATA, ?BSS, ?TLS_DATA, ?TLS_BSS, ?INIT_ARRAY,
    ?FINI_ARRAY, ?PREINIT_ARRAY, ?UNWIND_INFO, ?NOTE_INFO, ?DEBUG_INFO, ?METADATA,
    ?ADDRSIG, ?COMMENT, ?STACK, ?WARNING, ?STR1, ?STR2, ?STR4, ?CST4, ?CST8, ?CST16,
    ?CST32,
};

# the rows ascending by kind name, then by element size
val KINDS: [ROW_COUNT]*Row = [ROW_COUNT]*Row{
    ?ADDRSIG, ?BSS, ?COMMENT, ?DATA, ?DEBUG_INFO, ?FINI_ARRAY, ?INIT_ARRAY,
    ?CST4, ?CST8, ?CST16, ?CST32, ?STR1, ?STR2, ?STR4, ?METADATA, ?NOTE_INFO,
    ?PREINIT_ARRAY, ?RELRO_DATA, ?RODATA, ?STACK, ?TLS_BSS, ?TLS_DATA, ?TEXT,
    ?UNWIND_INFO, ?WARNING,
};

# the rows a name or family spells, ascending by it, for the assembler
# convention that a section named so, or so and then a dot and more, takes
# the row's kind. the GNU assembler gives a merged section's name no merge
# flags, so those rows spell nothing and the name reads as read-only data
val NAME_COUNT: usize            = 16;
val NAMES:      [NAME_COUNT]*Row = [NAME_COUNT]*Row{
    ?BSS, ?COMMENT, ?DATA, ?RELRO_DATA, ?DEBUG_INFO, ?UNWIND_INFO, ?FINI_ARRAY, ?INIT_ARRAY,
    ?ADDRSIG, ?NOTE_INFO, ?STACK, ?PREINIT_ARRAY, ?RODATA, ?TLS_BSS, ?TLS_DATA, ?TEXT,
};

# the keys ELF has no row for
val REFUSED_COUNT: usize                       = 1;
val REFUSED:       [REFUSED_COUNT]section.Key = [REFUSED_COUNT]section.Key{section.Key{kind: ?section.UNWIND_RECORDS}};

fun order(a: **Row, b: **Row) i64 {
    ret section.order(section.Key{kind: a[0].kind, entsize: a[0].entsize}, section.Key{kind: b[0].kind, entsize: b[0].entsize});
}

# the row of key `k`
pub fun row_of(k: section.Key) res[*Row, Fail] {
    var probe: Row       = Row{kind: k.kind, entsize: k.entsize};
    val row:   opt[*Row] = index.find[Row](?KINDS[0], ROW_COUNT, ?probe, order);
    if (sel row.none) { ret res[*Row, Fail].err{fail.valued(fail.about(fail.unsupported("ELF has no section for this kind and element size"), k.kind.name), k.entsize::i128)}; }
    ret res[*Row, Fail].ok{row.some};
}

# the name a section of key `k` that states none is written with
pub fun name_of(k: section.Key) res[str, Fail] {
    val row: res[*Row, Fail] = row_of(k);
    if (sel row.err) { ret res[str, Fail].err{row.err}; }
    val name: opt[str] = row.ok.name;
    if (sel name.none) { ret res[str, Fail].err{fail.about(fail.unsupported("ELF has no name for a nameless section of this kind"), k.kind.name)}; }
    ret res[str, Fail].ok{name.some};
}

# the name or family that spells `r`, nil for none
fun spelling(r: *Row) str {
    if (sel r.name.some)   { ret r.name.some; }
    if (sel r.family.some) { ret r.family.some; }
    ret nil;
}

# the key a section named `name` takes by the assembler convention
pub fun kind_of(name: Bytes) opt[section.Key] {
    val r: opt[*Row] = contract.spelled[Row](?NAMES[0], NAME_COUNT, name, '.', spelling);
    if (sel r.none) { ret opt[section.Key].none{}; }
    ret opt[section.Key].some{section.Key{kind: r.some.kind, entsize: r.some.entsize}};
}

# what a section type is to a neutral object
# ---
# named:     a neutral section whose name and flags set its kind
# kind:      a neutral section of this kind, or of thread-local zero fill
#            for zero fill with the TLS flag
# frame:     no neutral section, as it only structures the file
# directive: no neutral section, as what it holds are the object's directives
# refused:   no place in an object, as the text states
pub tag Reads: u8 {
    named;
    kind: *section.Kind;
    frame;
    directive;
    refused: str;
}

# a section type an object may hold and what it is to a neutral object
# ---
# word:  its name as an assembler spells it, without the type prefix
# type:  its sh_type
# reads: what it is
pub rec Type {
    word:  str;
    type:  *Constant;
    reads: Reads;
}

val TYPE_COUNT: usize            = 15;
val TYPES:      [TYPE_COUNT]Type = [TYPE_COUNT]Type{
    Type{word: "null", type: ?tables.SHT_NULL, reads: Reads.frame{}},
    Type{word: "progbits", type: ?tables.SHT_PROGBITS, reads: Reads.named{}},
    Type{word: "symtab", type: ?tables.SHT_SYMTAB, reads: Reads.frame{}},
    Type{word: "rela", type: ?tables.SHT_RELA, reads: Reads.frame{}},
    Type{word: "note", type: ?tables.SHT_NOTE, reads: Reads.kind{?section.NOTE_INFO}},
    Type{word: "nobits", type: ?tables.SHT_NOBITS, reads: Reads.kind{?section.BSS}},
    Type{word: "rel", type: ?tables.SHT_REL, reads: Reads.frame{}},
    Type{word: "init_array", type: ?tables.SHT_INIT_ARRAY, reads: Reads.kind{?section.INIT_ARRAY}},
    Type{word: "fini_array", type: ?tables.SHT_FINI_ARRAY, reads: Reads.kind{?section.FINI_ARRAY}},
    Type{word: "preinit_array", type: ?tables.SHT_PREINIT_ARRAY, reads: Reads.kind{?section.PREINIT_ARRAY}},
    Type{word: "group", type: ?tables.SHT_GROUP, reads: Reads.frame{}},
    Type{word: "symtab_shndx", type: ?tables.SHT_SYMTAB_SHNDX, reads: Reads.frame{}},
    Type{word: "relr", type: ?tables.SHT_RELR, reads: Reads.refused{"RELR relocations have no place in an object"}},
    Type{word: "llvm_addrsig", type: ?tables.SHT_LLVM_ADDRSIG, reads: Reads.kind{?section.ADDRSIG_TABLE}},
    Type{word: "llvm_dependent_libraries", type: ?tables.SHT_LLVM_DEPENDENT_LIBRARIES, reads: Reads.directive{}},
};

# the row of the section type `type`, none for a type no row names, whose
# section's name and flags set its kind
pub fun type_of(type: u32) opt[*Type] {
    var i: usize = 0;
    for (i < TYPE_COUNT) {
        if (TYPES[i].type.value == type::u64) { ret opt[*Type].some{?TYPES[i]}; }
        i = i + 1;
    }
    ret opt[*Type].none{};
}

# the row of the type an assembler spells `word`, none for none
fun spelled_type(word: str) opt[*Type] {
    var i: usize = 0;
    for (i < TYPE_COUNT) {
        if (str_equals(TYPES[i].word, word)) { ret opt[*Type].some{?TYPES[i]}; }
        i = i + 1;
    }
    ret opt[*Type].none{};
}

# a section name that sets the kind of a section whose type sets none,
# read before the flags are. no two rows take one name
# ---
# prefix: what the name starts with, or all of it when exact
rec Named {
    prefix: str;
    exact:  bool;
    kind:   *section.Kind;
}

val NAMED_COUNT: usize              = 9;
val NAMED:       [NAMED_COUNT]Named = [NAMED_COUNT]Named{
    Named{prefix: ".comment", exact: true, kind: ?section.COMMENT_STRINGS},
    Named{prefix: ".note.GNU-stack", exact: true, kind: ?section.STACK_NOTE},
    Named{prefix: ".gnu.warning", exact: true, kind: ?section.LINK_WARNING},
    Named{prefix: ".gnu.warning.", exact: false, kind: ?section.LINK_WARNING},
    Named{prefix: ".eh_frame", exact: true, kind: ?section.UNWIND_INFO},
    Named{prefix: ".data.rel.ro", exact: false, kind: ?section.RELRO_DATA},
    Named{prefix: ".debug", exact: false, kind: ?section.DEBUG_INFO},
    Named{prefix: ".zdebug", exact: false, kind: ?section.DEBUG_INFO},
    Named{prefix: ".stab", exact: false, kind: ?section.DEBUG_INFO},
};

fun starts(name: Bytes, prefix: str) bool {
    val n: usize = str_len(prefix);
    if (name.len < n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (name.data[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the key of a section named `name` of the type an assembler spells `type`,
# the neutral flags `flags` and the element size `entsize`, as the reader
# gives a section of that header. a word no type row spells is refused naming
# it, valid while `type` lives, and a type that is no neutral section is
# refused naming its word
pub fun kind_for(name: Bytes, type: str, flags: section.Flags, entsize: u64) res[section.Key, Fail] {
    val t: opt[*Type] = spelled_type(type);
    if (sel t.none) { ret res[section.Key, Fail].err{fail.about(fail.unsupported("ELF has no section type of this name"), type)}; }
    val k: res[*section.Kind, Fail] = classify(name, opt[*Type].some{t.some}, flags, entsize);
    if (sel k.err) { ret res[section.Key, Fail].err{k.err}; }
    ret res[section.Key, Fail].ok{section.key_of(k.ok, entsize)};
}

# the kind the reader gives a section named `name` of the type row `t`, none
# for a type no row names, the neutral flags `flags` and the element size
# `entsize`: by its type, then by its name, then by its flags. loaded
# read-only entries to merge of a size a merged kind takes are that kind, and
# any other loaded read-only section is read-only data, as lld merges no
# section of a zero sh_entsize. a type that is no neutral section is refused
# naming its word
pub fun classify(name: Bytes, t: opt[*Type], flags: section.Flags, entsize: u64) res[*section.Kind, Fail] {
    val tls: bool = (flags & section.TLS) != 0;
    if (sel t.some) {
        val row: *Type = t.some;
        if (sel row.reads.kind) {
            if (row.reads.kind == ?section.BSS && tls) { ret res[*section.Kind, Fail].ok{?section.TLS_BSS}; }
            ret res[*section.Kind, Fail].ok{row.reads.kind};
        }
        if (!sel row.reads.named) { ret res[*section.Kind, Fail].err{fail.about(fail.unsupported("a section of the type is no neutral section"), row.word)}; }
    }
    var i: usize = 0;
    for (i < NAMED_COUNT) {
        val r: *Named = ?NAMED[i];
        if (r.exact && name.len == str_len(r.prefix) && starts(name, r.prefix)) { ret res[*section.Kind, Fail].ok{r.kind}; }
        if (!r.exact && starts(name, r.prefix))                                 { ret res[*section.Kind, Fail].ok{r.kind}; }
        i = i + 1;
    }
    if ((flags & section.ALLOC) == 0) { ret res[*section.Kind, Fail].ok{?section.METADATA}; }
    if (tls)                          { ret res[*section.Kind, Fail].ok{?section.TLS_DATA}; }
    if ((flags & section.EXEC) != 0)  { ret res[*section.Kind, Fail].ok{?section.TEXT}; }
    if ((flags & section.WRITE) != 0) { ret res[*section.Kind, Fail].ok{?section.DATA}; }
    val merged: opt[*section.Kind] = section.merged(flags, entsize);
    if (sel merged.some) { ret res[*section.Kind, Fail].ok{merged.some}; }
    ret res[*section.Kind, Fail].ok{?section.RODATA};
}

# how ELF names sections, for the registration
pub val NAMING: Naming = Naming{kind_of: kind_of, kind_for: kind_for, name_of: name_of};

test naming__every_key_has_one_row_or_is_refused {
    val rows:  [ROW_COUNT]*Row = ROWS;
    val built: err[Fail]       = index.verify[Row](?KINDS[0], ROW_COUNT, ?rows[0], ROW_COUNT, order);
    if (sel built.err) { ret 1; }
    var keys: [ROW_COUNT + REFUSED_COUNT]section.Key;
    var i:    usize = 0;
    for (i < ROW_COUNT) {
        keys[i] = section.Key{kind: ROWS[i].kind, entsize: ROWS[i].entsize};
        i       = i + 1;
    }
    var j: usize = 0;
    for (j < REFUSED_COUNT) {
        keys[ROW_COUNT + j] = REFUSED[j];
        val refused: res[*Row, Fail] = row_of(REFUSED[j]);
        if (!sel refused.err)                   { ret 3; }
        if (!sel refused.err.cause.unsupported) { ret 3; }
        j = j + 1;
    }
    if (!section.once_each(?keys[0], ROW_COUNT + REFUSED_COUNT)) { ret 2; }
    # the spelled rows ascend strictly, so each spelling has one kind
    var n: usize = 0;
    for (n < NAME_COUNT) {
        if (spelling(NAMES[n]) == nil)                                             { ret 4; }
        if (n > 0 && str_compare(spelling(NAMES[n - 1]), spelling(NAMES[n])) >= 0) { ret 4; }
        n = n + 1;
    }
    ret 0;
}
