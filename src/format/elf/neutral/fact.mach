# the facts only ELF states, and what they state for a file's header
#
# a fact is keyed by one of ELF's own keys below. the header facts give the
# e_flags bits no trait row maps, EI_OSABI and EI_ABIVERSION, and each GNU
# property fact one property of the GNU property note. a header is built from
# the facts in the order they are stated, then the traits are encoded over the
# bits the facts give through the trait rows. an object's writer builds its
# header from the object's facts and traits, and an image's writer from the
# link's settled ones, both through this one builder.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.reader;
use mink.bytes.reader.Order;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use mink.catalog.trait.Trait;
use mink.format.elf.model.tables;
use mink.format.elf.rules.traits;
use mink.format.elf.rules.traits.Word;
use mink.format.elf.rules.traits.Words;
use mink.model.object.Fact;

# the keys of the facts only ELF states
# ---
# FLAGS:           e_flags
# OSABI:           EI_OSABI
# ABIVERSION:      EI_ABIVERSION
# PROPERTY:        one GNU property, its type the value and its data the data
# SECTION_TYPE:    a section whose sh_type is not the one its kind has: the
#                  section's index in the high word and the type in the low
# SECTION_FLAGS:   a section's sh_flags bits no neutral flag holds: the
#                  section's index the value and the eight bytes of the bits
#                  the data, little endian
# SECTION_SYMBOLS: a section whose sh_link is the symbol table: the section's
#                  index
# SYMBOL_OTHER:    a symbol's st_other bits past the visibility: the neutral
#                  symbol's index in the high bits and the bits in the low byte
# PROPERTY_NOTE:   the section the GNU property note is written in: the
#                  section's index
# ATTRIBUTE:       one build attribute no row knows that a tool must not
#                  ignore: its tag the value and its value the data, as the
#                  section encodes it
# ATTRIBUTES:      the section the build attributes are written in: the
#                  section's index
# IGNORABLE:       one build attribute no row knows that a tool may ignore,
#                  stated as ATTRIBUTE is
pub val FLAGS:           u32 = 0;
pub val OSABI:           u32 = 1;
pub val ABIVERSION:      u32 = 2;
pub val PROPERTY:        u32 = 3;
pub val SECTION_TYPE:    u32 = 4;
pub val SECTION_FLAGS:   u32 = 5;
pub val SECTION_SYMBOLS: u32 = 6;
pub val SYMBOL_OTHER:    u32 = 7;
pub val PROPERTY_NOTE:   u32 = 8;
pub val ATTRIBUTE:       u32 = 9;
pub val ATTRIBUTES:      u32 = 10;
pub val IGNORABLE:       u32 = 11;

# whether `key` is the key of a build attribute no row knows
pub fun attribute(key: u32) bool {
    ret key == ATTRIBUTE || key == IGNORABLE;
}

# the owner of the GNU property note
val PROPERTY_OWNER: str = "GNU";

# a GNU property the facts state
# ---
# type: its type
# word: its data is one word, whose value is the header's word of its type
# data: its data when it is not one word, borrowed from the facts' owner
rec Stated {
    type: u32;
    word: bool;
    data: Bytes;
}

# what facts and traits state for a file's header and its GNU property note
# ---
# flags:      e_flags
# osabi:      EI_OSABI, none when no fact states it
# abiversion: EI_ABIVERSION
# words:      e_flags and the one word GNU properties, the facts' and the
#             traits' together
# known:      the one word GNU properties the facts state
# stated:     every GNU property the facts state, in the order they state them
# raws:       how many of them are not one word
pub rec Header {
    flags:      u32;
    osabi:      opt[u8];
    abiversion: u8;
    words:      Words;
    known:      Words;
    stated:     Table[Stated];
    raws:       usize;
}

pub fun make(a: *A.Allocator) Header {
    ret Header{words: traits.make_words(a, 0), known: traits.make_words(a, 0), stated: table.make[Stated](a)};
}

pub fun release(h: *Header) err[Fail] {
    val w: err[Fail] = traits.release_words(?h.words);
    val k: err[Fail] = traits.release_words(?h.known);
    val s: err[Fail] = table.release[Stated](?h.stated);
    if (sel w.err) { ret w; }
    if (sel k.err) { ret k; }
    ret s;
}

# take the fact `f`, whose data is `data` read in `order`, into the header:
# true for a header or GNU property fact, false for any other key, which the
# header leaves alone. the data of a property that is not one word stays
# borrowed until the note is written
pub fun take(h: *Header, f: *Fact, data: Bytes, order: Order) res[bool, Fail] {
    val v: u64 = f.value;
    if (f.key == FLAGS || f.key == OSABI || f.key == ABIVERSION) {
        var limit: u64 = 0xffff_ffff;
        if (f.key != FLAGS) { limit = 0xff; }
        if (v > limit)      { ret res[bool, Fail].err{fail.overflow("ELF fact is wider than its field")}; }
        if (f.key == FLAGS) { h.flags = v::u32; }
        or (f.key == OSABI) { h.osabi = opt[u8].some{v::u8}; }
        or                  { h.abiversion = v::u8; }
        ret res[bool, Fail].ok{true};
    }
    if (f.key != PROPERTY) { ret res[bool, Fail].ok{false}; }
    if (v > 0xffff_ffff)   { ret res[bool, Fail].err{fail.overflow("GNU property type is wider than its field")}; }
    if (data.len != 4) {
        val raw: res[table.Id[Stated], Fail] = table.push[Stated](?h.stated, Stated{type: v::u32, data: data});
        if (sel raw.err) { ret res[bool, Fail].err{raw.err}; }
        h.raws = h.raws + 1;
        ret res[bool, Fail].ok{true};
    }
    var rd: Reader         = reader.make(nil, data.data, data.len, order);
    val w:  res[u32, Fail] = reader.u32(?rd);
    if (sel w.err) { ret res[bool, Fail].err{w.err}; }
    val first: err[Fail] = traits.add_word(?h.known, Word{type: v::u32, value: w.ok});
    if (sel first.err) { ret res[bool, Fail].err{first.err}; }
    val put: err[Fail] = traits.add_word(?h.words, Word{type: v::u32, value: w.ok});
    if (sel put.err) { ret res[bool, Fail].err{put.err}; }
    val p: res[table.Id[Stated], Fail] = table.push[Stated](?h.stated, Stated{type: v::u32, word: true});
    if (sel p.err) { ret res[bool, Fail].err{p.err}; }
    ret res[bool, Fail].ok{true};
}

# encode the traits `ts` of a file for `a` over the bits the facts give, so
# e_flags and the words hold every bit of e_flags and every one word property
pub fun encode(h: *Header, a: *Arch, ts: *Table[Trait]) err[Fail] {
    h.words.flags = h.flags;
    val e: err[Fail] = traits.encode(a, ts, ?h.words);
    if (sel e.err) { ret e; }
    h.flags = h.words.flags;
    ret err[Fail].ok{};
}

# how many GNU properties the note holds once the traits are encoded
pub fun properties(h: *Header) usize {
    ret table.count[Word](?h.words.properties) + h.raws;
}

# write the GNU property note to `out`, in its byte order: the note header
# and every property, each padded to `pad`. the properties the facts state
# come first in their order, each one word property with the value the traits
# left it, then the words the traits added, by type
pub fun note(h: *Header, out: *Sink, pad: usize) err[Fail] {
    var size: usize = 0;
    var i:    usize = 0;
    for (i < table.count[Stated](?h.stated)) {
        val s: *Stated = table.at[Stated](?h.stated, table.nth[Stated](i));
        var n: usize   = 4;
        if (!s.word) { n = s.data.len; }
        size = size + 8 + padded(n, pad);
        i    = i + 1;
    }
    i = 0;
    for (i < table.count[Word](?h.words.properties)) {
        val x:     *Word      = table.at[Word](?h.words.properties, table.nth[Word](i));
        val known: opt[*Word] = traits.word(?h.known, x.type);
        if (sel known.none) { size = size + 8 + padded(4, pad); }
        i = i + 1;
    }
    val owner: usize     = str_len(PROPERTY_OWNER) + 1;
    val w1:    err[Fail] = sink.uint(out, owner::u64, 4);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = sink.uint(out, size::u64, 4);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = sink.uint(out, tables.NT_GNU_PROPERTY_TYPE_0.value, 4);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = sink.text(out, PROPERTY_OWNER);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = sink.zeros(out, padded(owner, 4) - str_len(PROPERTY_OWNER));
    if (sel w5.err) { ret w5; }
    i = 0;
    for (i < table.count[Stated](?h.stated)) {
        val s: *Stated = table.at[Stated](?h.stated, table.nth[Stated](i));
        i = i + 1;
        if (!s.word) {
            val r: err[Fail] = raw_put(out, s.type, s.data, pad);
            if (sel r.err) { ret r; }
            cnt;
        }
        val x: opt[*Word] = traits.word(?h.words, s.type);
        if (sel x.none) { ret err[Fail].err{fail.internal("a stated property is not among the words")}; }
        val r: err[Fail] = word_put(out, x.some, pad);
        if (sel r.err) { ret r; }
    }
    i = 0;
    for (i < table.count[Word](?h.words.properties)) {
        val x: *Word = table.at[Word](?h.words.properties, table.nth[Word](i));
        i = i + 1;
        val known: opt[*Word] = traits.word(?h.known, x.type);
        if (sel known.some) { cnt; }
        val r: err[Fail] = word_put(out, x, pad);
        if (sel r.err) { ret r; }
    }
    ret err[Fail].ok{};
}

fun padded(n: usize, pad: usize) usize {
    ret (n + pad - 1) / pad * pad;
}

# one property that is not one word: its type, its size and its data
fun raw_put(out: *Sink, type: u32, data: Bytes, pad: usize) err[Fail] {
    val a1: err[Fail] = sink.uint(out, type::u64, 4);
    if (sel a1.err) { ret a1; }
    val a2: err[Fail] = sink.uint(out, data.len::u64, 4);
    if (sel a2.err) { ret a2; }
    val a3: err[Fail] = sink.bytes(out, data.data, data.len);
    if (sel a3.err) { ret a3; }
    ret sink.zeros(out, padded(data.len, pad) - data.len);
}

# one property of one word
fun word_put(out: *Sink, x: *Word, pad: usize) err[Fail] {
    val a1: err[Fail] = sink.uint(out, x.type::u64, 4);
    if (sel a1.err) { ret a1; }
    val a2: err[Fail] = sink.uint(out, 4, 4);
    if (sel a2.err) { ret a2; }
    val a3: err[Fail] = sink.uint(out, x.value::u64, 4);
    if (sel a3.err) { ret a3; }
    ret sink.zeros(out, padded(4, pad) - 4);
}
