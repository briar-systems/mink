# where an ELF file holds the mink note
#
# the note is a section of its own, a non-alloc SHT_NOTE named
# `.note.mink.ct` holding one note of the owner "mink" whose descriptor is the
# payload model.mark encodes. the section is no neutral section: from_neutral
# writes it from the object's constant-time ranges and to_neutral decodes it
# onto the object. a file without it carries no constant-time code.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Raw;
use mink.base.store.Why;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.format.elf.model.model;
use mink.format.elf.model.model.Body;
use mink.format.elf.model.model.Desc;
use mink.format.elf.model.model.Elf;
use mink.format.elf.model.model.Note;
use mink.format.elf.model.tables;

# the name of the section that holds the note
pub val SECTION: str = ".note.mink.ct";

# the note's type among the notes of the owner "mink"
pub val NT_MINK_CT: u32 = 1;

# the owner's name and its NUL, as the note's name field holds it
val OWNER_LEN: usize         = 5;
val OWNER:     [OWNER_LEN]u8 = [OWNER_LEN]u8{'m', 'i', 'n', 'k', 0};

# the bytes the owner's name takes, padded to four
val NAME_FIELD: u64 = 8;

# the alignment of the note's descriptor
val ALIGN: u64 = 4;

# whether the section `s`, named `name`, is the one that holds the note
pub fun holds(name: Bytes, s: *model.Section) bool {
    if (s.type != tables.SHT_NOTE.value::u32) { ret false; }
    ret store.same_bytes(name, Bytes{data: SECTION::*u8, len: str_len(SECTION)});
}

# the payload of a note section and where its first byte lies in the file
pub rec Payload {
    bytes:  Bytes;
    offset: u64;
}

# the payload the note section `s` of `m` holds, borrowed from `m`, refusing a
# section that holds anything but the one note of the owner "mink" and its
# type
pub fun payload(m: *Elf, s: *model.Section) res[Payload, Fail] {
    if (!sel s.body.notes) { ret res[Payload, Fail].err{fail.malformed("the mink note section holds no notes")}; }
    if (table.count[Note](?s.body.notes) != 1) {
        ret res[Payload, Fail].err{fail.malformed("the mink note section holds other than one note")};
    }
    val n:     *Note = table.at[Note](?s.body.notes, table.nth[Note](0));
    val owner: Bytes = model.bytes(m, ?n.name);
    if (!store.same_bytes(owner, Bytes{data: ?OWNER[0], len: OWNER_LEN}) || n.type != NT_MINK_CT) {
        ret res[Payload, Fail].err{fail.malformed("the mink note section holds a note of another owner or type")};
    }
    if (!sel n.desc.raw) { ret res[Payload, Fail].err{fail.malformed("the mink note holds no descriptor bytes")}; }
    val at: u64 = s.offset + model.NOTE.size::u64 + NAME_FIELD;
    ret res[Payload, Fail].ok{Payload{bytes: model.bytes(m, ?n.desc.raw.bytes), offset: at}};
}

# the section that holds the note of the payload `p`, its bytes owned by `m`
pub fun section(m: *Elf, p: Bytes) res[model.Section, Fail] {
    if (p.len::u64 > 0xffff_ffff) { ret res[model.Section, Fail].err{fail.overflow("the mink note payload is too large for its note")}; }
    val name: res[Held, Fail] = model.own(m, ?OWNER[0], OWNER_LEN);
    if (sel name.err) { ret res[model.Section, Fail].err{name.err}; }
    val desc: res[Held, Fail] = model.own(m, p.data, p.len);
    if (sel desc.err) { ret res[model.Section, Fail].err{desc.err}; }
    var notes:  Table[Note]         = table.make[Note](m.a);
    val note:   Note                = Note{namesz: OWNER_LEN::u32, descsz: p.len::u32, type: NT_MINK_CT, name: name.ok, desc: Desc.raw{Raw{bytes: desc.ok, why: Why.opaque{}}}};
    val pushed: res[Id[Note], Fail] = table.push[Note](?notes, note);
    if (sel pushed.err) { ret res[model.Section, Fail].err{pushed.err}; }
    ret res[model.Section, Fail].ok{model.Section{type: tables.SHT_NOTE.value::u32, addralign: ALIGN, body: Body.notes{notes}}};
}
