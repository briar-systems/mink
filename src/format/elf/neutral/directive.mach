# the directives an ELF object carries
#
# a dependent libraries section, SHT_LLVM_DEPENDENT_LIBRARIES, holds the
# names of libraries the link takes, each NUL-terminated. each is a library
# directive of the neutral object, and from_neutral writes them back as one
# `.deplibs` section in order. ELF has no form for the other kinds.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.riscv;
use mink.model.directive;
use mink.model.object;
use mink.model.object.Directive;
use mink.model.object.Object;

# add a library directive to `o` for each name the `len` bytes at `data` hold,
# refusing a name that is not terminated
pub fun libraries_in(o: *Object, data: *u8, len: usize) err[Fail] {
    var start: usize = 0;
    var i:     usize = 0;
    for (i < len) {
        if (data[i] == 0) {
            val n: res[Id[Name], Fail] = object.name(o, ?data[start], i - start);
            if (sel n.err) { ret err[Fail].err{n.err}; }
            val d: res[Id[Directive], Fail] = object.add_directive(o, Directive{kind: ?directive.LIBRARY, text: n.ok, symbol: opt[Id[Name]].none{}});
            if (sel d.err) { ret err[Fail].err{d.err}; }
            start = i + 1;
        }
        i = i + 1;
    }
    if (start != len) { ret err[Fail].err{fail.at_offset(fail.malformed("a dependent library name is not terminated"), start::u64)}; }
    ret err[Fail].ok{};
}

# write the names of `o`'s library directives into `out`, each NUL-terminated,
# and say how many there are. a directive of a kind ELF has no form for is
# refused naming the kind
pub fun libraries_of(o: *Object, out: *Sink) res[usize, Fail] {
    var found: usize = 0;
    var i:     usize = 0;
    for (i < table.count[Directive](?o.directives)) {
        val d: *Directive = table.at[Directive](?o.directives, table.nth[Directive](i));
        i = i + 1;
        if (d.kind != ?directive.LIBRARY) {
            ret res[usize, Fail].err{fail.in_indexed(fail.about(fail.unsupported("ELF has no form for this directive"), d.kind.name), "directive", (i - 1)::u64)};
        }
        if (sel d.symbol.some) {
            ret res[usize, Fail].err{fail.in_indexed(fail.unsupported("ELF has no form for a library directive about a symbol"), "directive", (i - 1)::u64)};
        }
        val v: View      = object.name_of(o, d.text);
        val w: err[Fail] = sink.bytes(out, v.data, v.len);
        if (sel w.err) { ret res[usize, Fail].err{w.err}; }
        val z: err[Fail] = sink.u8(out, 0);
        if (sel z.err) { ret res[usize, Fail].err{z.err}; }
        found = found + 1;
    }
    ret res[usize, Fail].ok{found};
}

val TWO:   [8]u8 = [8]u8{'m', 0, 'c', 'r', 'y', 'p', 't', 0};
val LOOSE: [3]u8 = [3]u8{'m', 0, 'c'};

test directive__dependent_libraries_are_library_directives_and_written_back {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);
    var o: Object       = object.make(a, ?riscv.RISCV64);
    val r: err[Fail]    = libraries_in(?o, ?TWO[0], 8);
    if (sel r.err)                                  { ret 1; }
    if (table.count[Directive](?o.directives) != 2) { ret 1; }
    var out:   Sink             = sink.make(a, LITTLE);
    val wrote: res[usize, Fail] = libraries_of(?o, ?out);
    if (!sel wrote.ok)                        { ret 2; }
    if (wrote.ok != 2 || sink.len(?out) != 8) { ret 2; }
    var i: usize = 0;
    for (i < 8) {
        if (sink.data(?out)[i] != TWO[i]) { ret 2; }
        i = i + 1;
    }
    val loose: err[Fail] = libraries_in(?o, ?LOOSE[0], 3);
    if (!sel loose.err) { ret 3; }

    # a directive ELF has no form for is refused naming its kind
    val n: res[Id[Name], Fail] = object.name_str(?o, "f");
    if (sel n.err) { ret 4; }
    val e: res[Id[Directive], Fail] = object.add_directive(?o, Directive{kind: ?directive.EXPORT, text: n.ok, symbol: opt[Id[Name]].none{}});
    if (sel e.err) { ret 4; }
    var again:   Sink             = sink.make(a, LITTLE);
    val refused: res[usize, Fail] = libraries_of(?o, ?again);
    if (!sel refused.err)                   { ret 5; }
    if (!sel refused.err.cause.unsupported) { ret 5; }

    val r1: err[Fail] = sink.release(?out);
    val r2: err[Fail] = sink.release(?again);
    val r3: err[Fail] = object.release(?o);
    if (sel r1.err || sel r2.err || sel r3.err) { ret 6; }
    if (T.live_count(?t) != 0)                  { ret 6; }
    T.dnit(?t);
    ret 0;
}
