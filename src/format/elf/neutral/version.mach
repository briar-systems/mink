# a symbol's version as a relocatable ELF object states it
#
# an assembler writes a symbol version into the symbol's name, as `.symver`
# gives it: `name@@VER` defines the default version, `name@VER` defines another
# or refers to one. the name ends at its first `@`, so a name that holds one
# states a version and a neutral name that holds one has no form here. a
# version that is empty or holds an `@`, and a default version on an undefined
# symbol, have no form either and are refused. images state versions in their
# own sections instead.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.table.Id;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.bytes.strtab;
use mink.bytes.strtab.Strtab;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Symbol;
use mink.model.object.Version;

# the byte that starts a version in a symbol's name
pub val SEPARATOR: u8 = '@';

# name:    the symbol's name without its version
# version: the version the name states, none for a name that states none
pub rec Named {
    name:    Id[Name];
    version: opt[Version];
}

# where the first `@` of the `len` bytes at `p` is, none for none
fun separator_in(p: *u8, len: usize) opt[usize] {
    var i: usize = 0;
    for (i < len) {
        if (p[i] == SEPARATOR) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# the name and version of the ELF symbol name of `len` bytes at `data`,
# interned in `o`. `defined` is whether the symbol has a definition
pub fun named_in(o: *Object, data: *u8, len: usize, defined: bool) res[Named, Fail] {
    val at: opt[usize] = separator_in(data, len);
    if (sel at.none) {
        val whole: res[Id[Name], Fail] = object.name(o, data, len);
        if (sel whole.err) { ret res[Named, Fail].err{whole.err}; }
        ret res[Named, Fail].ok{Named{name: whole.ok, version: opt[Version].none{}}};
    }
    val cut:   usize = at.some;
    var start: usize = cut + 1;
    var dflt:  bool  = false;
    if (start < len && data[start] == SEPARATOR) {
        dflt  = true;
        start = start + 1;
    }
    if (start == len) { ret res[Named, Fail].err{fail.unsupported("a symbol's version is empty")}; }
    val left: opt[usize] = separator_in(?data[start], len - start);
    if (sel left.some)    { ret res[Named, Fail].err{fail.unsupported("a symbol's version holds `@`")}; }
    if (dflt && !defined) { ret res[Named, Fail].err{fail.unsupported("an undefined symbol names a default version, which only a definition states")}; }
    val name: res[Id[Name], Fail] = object.name(o, data, cut);
    if (sel name.err) { ret res[Named, Fail].err{name.err}; }
    val ver: res[Id[Name], Fail] = object.name(o, ?data[start], len - start);
    if (sel ver.err) { ret res[Named, Fail].err{ver.err}; }
    ret res[Named, Fail].ok{Named{name: name.ok, version: opt[Version].some{Version{name: ver.ok, default: dflt}}}};
}

# add the ELF symbol name of `s` of `o` to `t`, its version written into it,
# refusing a name or version that has no form in a relocatable object
pub fun name_out(a: *A.Allocator, o: *Object, s: *Symbol, t: *Strtab) res[Id[Name], Fail] {
    val v:  View       = object.name_of(o, s.name);
    val at: opt[usize] = separator_in(v.data, v.len);
    if (sel at.some) {
        ret res[Id[Name], Fail].err{fail.unsupported("a symbol's name holds `@`, which a relocatable ELF object reads as a version")};
    }
    val ver: opt[Version] = s.version;
    if (sel ver.none) { ret strtab.add(t, v.data, v.len); }
    val vn:  View       = object.name_of(o, ver.some.name);
    val vin: opt[usize] = separator_in(vn.data, vn.len);
    if (vn.len == 0)                             { ret res[Id[Name], Fail].err{fail.unsupported("a symbol's version is empty")}; }
    if (sel vin.some)                            { ret res[Id[Name], Fail].err{fail.unsupported("a symbol's version holds `@`")}; }
    if (ver.some.default && sel s.def.undefined) { ret res[Id[Name], Fail].err{fail.unsupported("an undefined symbol names a default version, which only a definition states")}; }
    var out: Sink                = sink.make(a, LITTLE);
    val id:  res[Id[Name], Fail] = joined(?out, o, s.name, ver.some, t);
    val rel: err[Fail]           = sink.release(?out);
    if (sel id.err)  { ret id; }
    if (sel rel.err) { ret res[Id[Name], Fail].err{rel.err}; }
    ret id;
}

# add `name` with `ver` written into it to `t`, through `out`
fun joined(out: *Sink, o: *Object, name: Id[Name], ver: Version, t: *Strtab) res[Id[Name], Fail] {
    val n:  View      = object.name_of(o, name);
    val wn: err[Fail] = sink.bytes(out, n.data, n.len);
    if (sel wn.err) { ret res[Id[Name], Fail].err{wn.err}; }
    val s1: err[Fail] = sink.u8(out, SEPARATOR);
    if (sel s1.err) { ret res[Id[Name], Fail].err{s1.err}; }
    if (ver.default) {
        val s2: err[Fail] = sink.u8(out, SEPARATOR);
        if (sel s2.err) { ret res[Id[Name], Fail].err{s2.err}; }
    }
    val vn: View      = object.name_of(o, ver.name);
    val wv: err[Fail] = sink.bytes(out, vn.data, vn.len);
    if (sel wv.err) { ret res[Id[Name], Fail].err{wv.err}; }
    ret strtab.add(t, sink.data(out), sink.len(out));
}
