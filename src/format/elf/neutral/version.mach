# a symbol's version as a relocatable ELF object states it
#
# an assembler writes a symbol version into the symbol's name, as `.symver`
# gives it: `name@@VER` defines the default version, `name@VER` defines another
# or refers to one. the name ends at its first `@`, so a name that holds one
# states a version and a neutral name that holds one has no form here. a
# version that is empty or holds an `@`, and a default version on an undefined
# symbol, have no form either and are refused. images state versions in their
# own sections instead.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.table.Id;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.bytes.strtab;
use mink.bytes.strtab.Strtab;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Symbol;
use mink.model.object.Version;

# the byte that starts a version in a symbol's name
pub val SEPARATOR: u8 = '@';

# name:    the symbol's name without its version
# version: the version the name states, none for a name that states none
pub rec Named {
    name:    Id[Name];
    version: opt[Version];
}

# where the first `@` of the `len` bytes at `p` is, none for none
fun separator_in(p: *u8, len: usize) opt[usize] {
    var i: usize = 0;
    for (i < len) {
        if (p[i] == SEPARATOR) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# the name and version of the ELF symbol name of `len` bytes at `data`,
# interned in `o`. `defined` is whether the symbol has a definition
pub fun named_in(o: *Object, data: *u8, len: usize, defined: bool) res[Named, Fail] {
    val opt_separator_in: opt[usize] = separator_in(data, len);
    if (sel opt_separator_in.none) {
        val res_whole: res[Id[Name], Fail] = object.name(o, data, len);
        if (sel res_whole.err) { ret res[Named, Fail].err{res_whole.err}; }
        ret res[Named, Fail].ok{Named{name: res_whole.ok, version: opt[Version].none{}}};
    }
    val cut:   usize = opt_separator_in.some;
    var start: usize = cut + 1;
    var dflt:  bool  = false;
    if (start < len && data[start] == SEPARATOR) {
        dflt  = true;
        start = start + 1;
    }
    if (start == len) { ret res[Named, Fail].err{fail.unsupported("a symbol's version is empty")}; }
    val opt_left: opt[usize] = separator_in(?data[start], len - start);
    if (sel opt_left.some) { ret res[Named, Fail].err{fail.unsupported("a symbol's version holds `@`")}; }
    if (dflt && !defined)  { ret res[Named, Fail].err{fail.unsupported("an undefined symbol names a default version, which only a definition states")}; }
    val res_name: res[Id[Name], Fail] = object.name(o, data, cut);
    if (sel res_name.err) { ret res[Named, Fail].err{res_name.err}; }
    val res_ver: res[Id[Name], Fail] = object.name(o, ?data[start], len - start);
    if (sel res_ver.err) { ret res[Named, Fail].err{res_ver.err}; }
    ret res[Named, Fail].ok{Named{name: res_name.ok, version: opt[Version].some{Version{name: res_ver.ok, default: dflt}}}};
}

# add the ELF symbol name of `s` of `o` to `t`, its version written into it,
# refusing a name or version that has no form in a relocatable object
pub fun name_out(a: *A.Allocator, o: *Object, s: *Symbol, t: *Strtab) res[Id[Name], Fail] {
    val v:                View       = object.name_of(o, s.name);
    val opt_separator_in: opt[usize] = separator_in(v.data, v.len);
    if (sel opt_separator_in.some) {
        ret res[Id[Name], Fail].err{fail.unsupported("a symbol's name holds `@`, which a relocatable ELF object reads as a version")};
    }
    val opt_ver: opt[Version] = s.version;
    if (sel opt_ver.none) { ret strtab.add(t, v.data, v.len); }
    val vn:      View       = object.name_of(o, opt_ver.some.name);
    val opt_vin: opt[usize] = separator_in(vn.data, vn.len);
    if (vn.len == 0)                                 { ret res[Id[Name], Fail].err{fail.unsupported("a symbol's version is empty")}; }
    if (sel opt_vin.some)                            { ret res[Id[Name], Fail].err{fail.unsupported("a symbol's version holds `@`")}; }
    if (opt_ver.some.default && sel s.def.undefined) { ret res[Id[Name], Fail].err{fail.unsupported("an undefined symbol names a default version, which only a definition states")}; }
    var out:        Sink                = sink.make(a, LITTLE);
    val res_joined: res[Id[Name], Fail] = joined(?out, o, s.name, opt_ver.some, t);
    val err_rel:    err[Fail]           = sink.release(?out);
    if (sel res_joined.err) { ret res_joined; }
    if (sel err_rel.err)    { ret res[Id[Name], Fail].err{err_rel.err}; }
    ret res_joined;
}

# add `name` with `ver` written into it to `t`, through `out`
fun joined(out: *Sink, o: *Object, name: Id[Name], ver: Version, t: *Strtab) res[Id[Name], Fail] {
    val n:         View      = object.name_of(o, name);
    val err_bytes: err[Fail] = sink.bytes(out, n.data, n.len);
    if (sel err_bytes.err) { ret res[Id[Name], Fail].err{err_bytes.err}; }
    val err_separator_written: err[Fail] = sink.u8(out, SEPARATOR);
    if (sel err_separator_written.err) { ret res[Id[Name], Fail].err{err_separator_written.err}; }
    if (ver.default) {
        val err_default_separator_written: err[Fail] = sink.u8(out, SEPARATOR);
        if (sel err_default_separator_written.err) { ret res[Id[Name], Fail].err{err_default_separator_written.err}; }
    }
    val vn:            View      = object.name_of(o, ver.name);
    val err_bytes_out: err[Fail] = sink.bytes(out, vn.data, vn.len);
    if (sel err_bytes_out.err) { ret res[Id[Name], Fail].err{err_bytes_out.err}; }
    ret strtab.add(t, sink.data(out), sink.len(out));
}
