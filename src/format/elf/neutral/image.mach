# an ELF image to the neutral object and back
#
# an image has no form as an object to link: its symbols hold addresses, its
# relocations are applied or are its loader's and its layout is settled. so
# its neutral object states what the file states and nothing recovered. each
# section is a neutral section of its bytes, of the kind its name and flags
# give, the tables a loader reads among them as bytes, with .symtab, .dynsym
# and .rela.dyn untouched, so a stripped table reads as the absent one it is
# and a relocation already applied is never undone by guesswork. a section
# overlaid on bytes another extent holds has no bytes of its own. the header,
# every program header and section header, and each extent in file order are
# facts, so a file with no section headers reads as its raw extents. a shared
# object describes its library as well, which is what a link takes of it.
#
# from_neutral rebuilds the file from those facts around the sections' bytes,
# so a section that keeps its size carries an edit back, and one that does not
# is refused by the writer, as its extents no longer tile the file. an object
# with no image facts is refused, as there is no layout to give it. a raw
# section's bytes are borrowed from the file, so the model outlives the object.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Raw;
use mink.base.store.Why;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.base.vectors;
use mink.bytes.reader;
use mink.bytes.reader.BIG;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use mink.catalog.format;
use mink.catalog.kind.Kind;
use mink.format.elf.model.model;
use mink.format.elf.model.model.Body;
use mink.format.elf.model.model.Dyn;
use mink.format.elf.model.model.Elf;
use mink.format.elf.model.model.Extent;
use mink.format.elf.model.model.Section;
use mink.format.elf.model.model.Segment;
use mink.format.elf.model.model.Shape;
