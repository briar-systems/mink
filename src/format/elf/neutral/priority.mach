# the priority an ELF section name states
#
# a table of functions the loader runs states where it orders among the
# tables of its kind by its name: `.init_array.N` and `.fini_array.N`, a lower
# N first. the neutral section carries N as its priority, and a section that
# states no name is written with its kind's name and N, five digits wide, as
# GCC writes it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.model.section;

# kind:   the kind of table
# prefix: the name a table of the kind takes, which a priority follows
rec Row {
    kind:   *section.Kind;
    prefix: str;
}

val ROW_COUNT: usize          = 2;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{kind: ?section.INIT_ARRAY, prefix: ".init_array"},
    Row{kind: ?section.FINI_ARRAY, prefix: ".fini_array"},
};

# the width GCC writes a priority in
val WIDTH: usize = 5;

fun row_of(k: *section.Kind) opt[*Row] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].kind == k) { ret opt[*Row].some{?ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# the priority the name of `len` bytes at `name` states for a section of kind
# `k`, none when the kind has none or the name states none
pub fun stated(k: *section.Kind, name: *u8, len: usize) opt[u32] {
    val row: opt[*Row] = row_of(k);
    if (sel row.none) { ret opt[u32].none{}; }
    val p: str   = row.some.prefix;
    val n: usize = str_len(p);
    if (len < n + 2) { ret opt[u32].none{}; }
    var i: usize = 0;
    for (i < n) {
        if (name[i] != p[i]) { ret opt[u32].none{}; }
        i = i + 1;
    }
    if (name[n] != '.') { ret opt[u32].none{}; }
    var v: u64 = 0;
    i = n + 1;
    for (i < len) {
        val d: u8 = name[i];
        if (d < '0' || d > '9') { ret opt[u32].none{}; }
        v = v * 10 + (d - '0')::u64;
        if (v > 0xffff_ffff) { ret opt[u32].none{}; }
        i = i + 1;
    }
    ret opt[u32].some{v::u32};
}

# whether the name of `len` bytes at `name` states the priority `p` for a
# section of kind `k`
pub fun agrees(k: *section.Kind, name: *u8, len: usize, p: opt[u32]) bool {
    val s: opt[u32] = stated(k, name, len);
    if (sel p.none) { ret sel s.none; }
    if (sel s.none) { ret false; }
    ret s.some == p.some;
}

# write the name a section of kind `k` with priority `p` that states no name
# takes, refusing a kind ELF states no priority for
pub fun name_into(k: *section.Kind, p: u32, out: *Sink) err[Fail] {
    val row: opt[*Row] = row_of(k);
    if (sel row.none) { ret err[Fail].err{fail.about(fail.unsupported("ELF states a priority only for a table of functions the loader runs"), k.name)}; }
    val t: err[Fail] = sink.text(out, row.some.prefix);
    if (sel t.err) { ret t; }
    val d: err[Fail] = sink.u8(out, '.');
    if (sel d.err) { ret d; }
    var digits: usize = 1;
    var rest:   u32   = p / 10;
    for (rest != 0) {
        digits = digits + 1;
        rest   = rest / 10;
    }
    for (digits < WIDTH) {
        val z: err[Fail] = sink.u8(out, '0');
        if (sel z.err) { ret z; }
        digits = digits + 1;
    }
    ret sink.number(out, p::u64, 10);
}
