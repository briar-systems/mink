use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.store.Bytes;
use mink.base.store.Held;
use mink.base.store.Raw;
use mink.base.store.Why;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.base.vectors;
use mink.bytes.reader;
use mink.bytes.reader.BIG;
use mink.bytes.reader.LITTLE;
use mink.bytes.reader.Order;
use mink.bytes.reader.Reader;
use mink.bytes.slot;
use mink.bytes.slot.Slot;
use mink.format.contract.Input;
use mink.format.elf.model.model;
use mink.format.elf.model.model.Body;
use mink.format.elf.model.model.Class;
use mink.format.elf.model.model.Compressed;
use mink.format.elf.model.model.Definition;
use mink.format.elf.model.model.Desc;
use mink.format.elf.model.model.Dyn;
use mink.format.elf.model.model.Elf;
use mink.format.elf.model.model.Extent;
use mink.format.elf.model.model.GnuHash;
use mink.format.elf.model.model.Group;
use mink.format.elf.model.model.Hash;
use mink.format.elf.model.model.Need;
use mink.format.elf.model.model.Note;
use mink.format.elf.model.model.Property;
use mink.format.elf.model.model.Rel;
use mink.format.elf.model.model.Rela;
use mink.format.elf.model.model.Section;
use mink.format.elf.model.model.Segment;
use mink.format.elf.model.model.Shape;
use mink.format.elf.model.model.Symbol;
use mink.format.elf.model.model.Verdaux;
use mink.format.elf.model.model.Verdef;
use mink.format.elf.model.model.Vernaux;
use mink.format.elf.model.model.Verneed;
use mink.format.elf.model.tables;
use mink.format.shell;

# the padding of a note name, whatever the section's alignment
val NOTE_NAME_ALIGN: u64 = 4;

# what an extent range holds
val KIND_HEADER:   u8 = 0;
val KIND_SEGMENTS: u8 = 1;
val KIND_SECTIONS: u8 = 2;
val KIND_SECTION:  u8 = 3;

# the file being read
# ---
# in:    the input, borrowed by the model
# file:  the whole input
# m:     the model being filled
# c:     the file's class
# order: the file's byte order
# count: the number of sections
# nuls:  per section, one more than the position after its last NUL byte, or
#        zero while not yet scanned
rec Ctx {
    in:    *Input;
    file:  Reader;
    m:     *Elf;
    c:     *Class;
    order: Order;
    count: u64;
    nuls:  Vector[u64];
}

# a place in the file
rec Range {
    start: u64;
    end:   u64;
    kind:  u8;
    id:    u32;
}

# read `in` as an ELF file. the model borrows the bytes of `in` and every
# table of it lives in `a`, so give it back with model.dnit
pub fun read(a: *A.Allocator, in: *Input) res[Elf, Fail] {
    val res_shape: res[Shape, Fail] = shape_of(in);
    if (sel res_shape.err) { ret res[Elf, Fail].err{fail.in_file(res_shape.err, in.file)}; }
    var m:        Elf       = model.init(a, res_shape.ok);
    var x:        Ctx       = Ctx{in: in, file: shell.reader_make(in, res_shape.ok.order), m: ?m, c: res_shape.ok.class, order: res_shape.ok.order, nuls: vector.init[u64](a)};
    val err_fill: err[Fail] = fill(?x);
    val err_nuls: err[Fail] = vectors.dnit[u64](?x.nuls);
    if (sel err_fill.err) {
        val err_dropped: err[Fail] = model.dnit(?m);
        ret res[Elf, Fail].err{fail.in_file(err_fill.err, in.file)};
    }
    if (sel err_nuls.err) {
        val err_dropped: err[Fail] = model.dnit(?m);
        ret res[Elf, Fail].err{fail.in_file(err_nuls.err, in.file)};
    }
    ret res[Elf, Fail].ok{m};
}

# whether `in` is a shared object, told from its e_type alone
pub fun binds(in: *Input) res[bool, Fail] {
    val res_shape: res[Shape, Fail] = shape_of(in);
    if (sel res_shape.err) { ret res[bool, Fail].err{fail.in_file(res_shape.err, in.file)}; }
    var r:       Reader            = shell.reader_make(in, res_shape.ok.order);
    val res_sub: res[Reader, Fail] = reader.sub(?r, 0, res_shape.ok.class.header.size::u64);
    if (sel res_sub.err) { ret res[bool, Fail].err{fail.in_record(res_sub.err, "file header")}; }
    var hr:        Reader         = res_sub.ok;
    val res_bytes: res[*u8, Fail] = reader.bytes(?hr, res_shape.ok.class.header.size::u64);
    if (sel res_bytes.err) { ret res[bool, Fail].err{fail.in_record(res_bytes.err, "file header")}; }
    ret res[bool, Fail].ok{slot.field(res_bytes.ok, res_shape.ok.class.header.type, res_shape.ok.order) == tables.ET_DYN.value};
}

# the class and byte order e_ident names
fun shape_of(in: *Input) res[Shape, Fail] {
    var r:         Reader         = shell.reader_make(in, LITTLE);
    val res_bytes: res[*u8, Fail] = reader.bytes(?r, model.IDENT.size::u64);
    if (sel res_bytes.err) { ret res[Shape, Fail].err{fail.in_record(res_bytes.err, "file header")}; }
    val p: *u8 = res_bytes.ok;
    if (p[0] != 0x7f || p[1] != 'E' || p[2] != 'L' || p[3] != 'F') {
        ret res[Shape, Fail].err{at(fail.malformed("not an ELF file"), 0)};
    }
    var shape: Shape;
    val class: u8 = p[model.IDENT.class.offset::usize];
    if (class == tables.ELFCLASS32.value::u8) { shape.class = ?model.CLASS32; }
    or (class == tables.ELFCLASS64.value::u8) { shape.class = ?model.CLASS64; }
    or {
        ret res[Shape, Fail].err{at(fail.malformed("unknown file class"), model.IDENT.class.offset::u64)};
    }
    val data: u8 = p[model.IDENT.data.offset::usize];
    if (data == tables.ELFDATA2LSB.value::u8) { shape.order = LITTLE; }
    or (data == tables.ELFDATA2MSB.value::u8) { shape.order = BIG; }
    or {
        ret res[Shape, Fail].err{at(fail.malformed("unknown data encoding"), model.IDENT.data.offset::u64)};
    }
    ret res[Shape, Fail].ok{shape};
}

fun fill(x: *Ctx) err[Fail] {
    val err_read_header: err[Fail] = read_header(x);
    if (sel err_read_header.err) { ret err_read_header; }
    val err_read_sections: err[Fail] = read_sections(x);
    if (sel err_read_sections.err) { ret err_read_sections; }
    val err_read_segments: err[Fail] = read_segments(x);
    if (sel err_read_segments.err) { ret err_read_segments; }
    val err_grow: err[Fail] = vectors.grow[u64](?x.nuls, x.count::usize);
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    val err_check_sections: err[Fail] = check_sections(x);
    if (sel err_check_sections.err) { ret err_check_sections; }
    val err_layout: err[Fail] = layout(x);
    if (sel err_layout.err) { ret err_layout; }
    ret read_bodies(x);
}

fun read_header(x: *Ctx) err[Fail] {
    val c:       *Class            = x.c;
    val res_sub: res[Reader, Fail] = reader.sub(?x.file, 0, c.header.size::u64);
    if (sel res_sub.err) { ret err[Fail].err{fail.in_record(res_sub.err, "file header")}; }
    var hr:        Reader         = res_sub.ok;
    val res_bytes: res[*u8, Fail] = reader.bytes(?hr, c.header.size::u64);
    if (sel res_bytes.err) { ret err[Fail].err{fail.in_record(res_bytes.err, "file header")}; }
    val p: *u8           = res_bytes.ok;
    val o: Order         = x.order;
    val h: *model.Header = ?x.m.header;
    h.ident.version    = slot.field(p, model.IDENT.version, o)::u8;
    h.ident.osabi      = slot.field(p, model.IDENT.osabi, o)::u8;
    h.ident.abiversion = slot.field(p, model.IDENT.abiversion, o)::u8;
    var i: usize = 0;
    for (i < model.IDENT.pad.width::usize) {
        h.ident.pad[i] = p[model.IDENT.pad.offset::usize + i];
        i              = i + 1;
    }
    h.type      = slot.field(p, c.header.type, o)::u16;
    h.machine   = slot.field(p, c.header.machine, o)::u16;
    h.version   = slot.field(p, c.header.version, o)::u32;
    h.entry     = slot.field(p, c.header.entry, o);
    h.phoff     = slot.field(p, c.header.phoff, o);
    h.shoff     = slot.field(p, c.header.shoff, o);
    h.flags     = slot.field(p, c.header.flags, o)::u32;
    h.ehsize    = slot.field(p, c.header.ehsize, o)::u16;
    h.phentsize = slot.field(p, c.header.phentsize, o)::u16;
    h.phnum     = slot.field(p, c.header.phnum, o)::u16;
    h.shentsize = slot.field(p, c.header.shentsize, o)::u16;
    h.shnum     = slot.field(p, c.header.shnum, o)::u16;
    h.shstrndx  = slot.field(p, c.header.shstrndx, o)::u16;
    ret err[Fail].ok{};
}

fun read_sections(x: *Ctx) err[Fail] {
    val c: *Class        = x.c;
    val h: *model.Header = ?x.m.header;
    if (h.shoff == 0) {
        if (h.shnum != 0) { ret err[Fail].err{header_field(fail.malformed("section count with no section header table"), x, c.header.shnum)}; }
        x.count = 0;
        ret err[Fail].ok{};
    }
    if (h.shentsize::usize != c.section.size) {
        ret err[Fail].err{header_field(fail.malformed("section header size does not match the class"), x, c.header.shentsize)};
    }
    var count: u64 = h.shnum::u64;
    if (count == 0) {
        val res_first: res[Reader, Fail] = shell.table(?x.file, "section header", h.shoff, 1, c.section.size::u64);
        if (sel res_first.err) { ret err[Fail].err{res_first.err}; }
        var fr:       Reader             = res_first.ok;
        val res_zero: res[Section, Fail] = read_section(x, ?fr, 0);
        if (sel res_zero.err) { ret err[Fail].err{res_zero.err}; }
        count = res_zero.ok.length;
        if (count == 0) { ret err[Fail].err{header_field(fail.malformed("section header table of no sections"), x, c.header.shnum)}; }
    }
    val res_table: res[Reader, Fail] = shell.table(?x.file, "section header", h.shoff, count, c.section.size::u64);
    if (sel res_table.err) { ret err[Fail].err{res_table.err}; }
    var tr:           Reader           = res_table.ok;
    val res_to_usize: res[usize, Fail] = checked.to_usize(reader.here(?x.file), count);
    if (sel res_to_usize.err) { ret err[Fail].err{res_to_usize.err}; }
    val err_reserve: err[Fail] = table.reserve[Section](?x.m.sections, res_to_usize.ok);
    if (sel err_reserve.err) { ret err_reserve; }
    var i: u64 = 0;
    for (i < count) {
        val res_read_section: res[Section, Fail] = read_section(x, ?tr, i);
        if (sel res_read_section.err) { ret err[Fail].err{res_read_section.err}; }
        val res_pushed: res[Id[Section], Fail] = table.push[Section](?x.m.sections, res_read_section.ok);
        if (sel res_pushed.err) { ret err[Fail].err{res_pushed.err}; }
        i = i + 1;
    }
    x.count = count;
    ret err[Fail].ok{};
}

fun read_section(x: *Ctx, t: *Reader, i: u64) res[Section, Fail] {
    val c:           *Class            = x.c;
    val res_element: res[Reader, Fail] = shell.element(t, "section header", i, c.section.size::u64);
    if (sel res_element.err) { ret res[Section, Fail].err{res_element.err}; }
    var er:        Reader         = res_element.ok;
    val res_bytes: res[*u8, Fail] = reader.bytes(?er, c.section.size::u64);
    if (sel res_bytes.err) { ret res[Section, Fail].err{fail.in_indexed(res_bytes.err, "section header", i)}; }
    val p: *u8   = res_bytes.ok;
    val o: Order = x.order;
    var s: Section;
    s.name      = slot.field(p, c.section.name, o)::u32;
    s.type      = slot.field(p, c.section.type, o)::u32;
    s.flags     = slot.field(p, c.section.flags, o);
    s.addr      = slot.field(p, c.section.addr, o);
    s.offset    = slot.field(p, c.section.offset, o);
    s.length    = slot.field(p, c.section.length, o);
    s.link      = slot.field(p, c.section.link, o)::u32;
    s.info      = slot.field(p, c.section.info, o)::u32;
    s.addralign = slot.field(p, c.section.addralign, o);
    s.entsize   = slot.field(p, c.section.entsize, o);
    ret res[Section, Fail].ok{s};
}

fun read_segments(x: *Ctx) err[Fail] {
    val c:                 *Class         = x.c;
    val h:                 *model.Header  = ?x.m.header;
    val res_segment_count: res[u64, Fail] = model.segment_count(x.m);
    if (sel res_segment_count.err) { ret err[Fail].err{res_segment_count.err}; }
    if (res_segment_count.ok == 0) { ret err[Fail].ok{}; }
    if (h.phoff == 0)              { ret err[Fail].err{header_field(fail.malformed("program header count with no program header table"), x, c.header.phnum)}; }
    if (h.phentsize::usize != c.segment.size) {
        ret err[Fail].err{header_field(fail.malformed("program header size does not match the class"), x, c.header.phentsize)};
    }
    val res_table: res[Reader, Fail] = shell.table(?x.file, "program header", h.phoff, res_segment_count.ok, c.segment.size::u64);
    if (sel res_table.err) { ret err[Fail].err{res_table.err}; }
    var tr:       Reader                 = res_table.ok;
    val res_grow: res[Id[Segment], Fail] = table.grow[Segment](?x.m.segments, res_segment_count.ok::usize);
    if (sel res_grow.err) { ret err[Fail].err{res_grow.err}; }
    val items: *Segment = table.items[Segment](?x.m.segments);
    val o:     Order    = x.order;
    var i:     u64      = 0;
    for (i < res_segment_count.ok) {
        val res_rec: res[*u8, Fail] = record(?tr, "program header", i, c.segment.size);
        if (sel res_rec.err) { ret err[Fail].err{res_rec.err}; }
        val p: *u8      = res_rec.ok;
        val s: *Segment = ?items[i::usize];
        s.type   = slot.field(p, c.segment.type, o)::u32;
        s.flags  = slot.field(p, c.segment.flags, o)::u32;
        s.offset = slot.field(p, c.segment.offset, o);
        s.vaddr  = slot.field(p, c.segment.vaddr, o);
        s.paddr  = slot.field(p, c.segment.paddr, o);
        s.filesz = slot.field(p, c.segment.filesz, o);
        s.memsz  = slot.field(p, c.segment.memsz, o);
        s.align  = slot.field(p, c.segment.align, o);
        i        = i + 1;
    }
    ret err[Fail].ok{};
}

fun check_sections(x: *Ctx) err[Fail] {
    var i: u64 = 0;
    for (i < x.count) {
        val s:                 *Section  = section(x, i);
        val err_check_section: err[Fail] = check_section(x, i, s);
        if (sel err_check_section.err) { ret err[Fail].err{fail.in_indexed(err_check_section.err, "section header", i)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bytes a section places in the file must lie in it
fun check_section(x: *Ctx, i: u64, s: *Section) err[Fail] {
    val c: *Class = x.c;
    if (!holds_bytes(s) || s.length == 0) { ret err[Fail].ok{}; }
    val res_end: res[u64, Fail] = checked.add(Location{file: x.in.file, offset: sh_at(x, i, c.section.offset), placed: true}, s.offset, s.length);
    if (sel res_end.err) { ret err[Fail].err{res_end.err}; }
    if (res_end.ok > x.in.len::u64) {
        ret err[Fail].err{at(fail.truncated("section contents run past the end of the file"), sh_at(x, i, c.section.offset))};
    }
    ret err[Fail].ok{};
}

fun holds_bytes(s: *Section) bool {
    ret s.type != tables.SHT_NULL.value::u32 && s.type != tables.SHT_NOBITS.value::u32;
}

# whether `name` lies in the string table in section `strings` and ends before
# the table does
fun resolves(x: *Ctx, strings: u32, name: u32) res[bool, Fail] {
    if (name == 0) { ret res[bool, Fail].ok{true}; }
    val s:    *Section = section(x, strings::u64);
    var size: u64      = 0;
    if (holds_bytes(s))    { size = s.length; }
    if (name::u64 >= size) { ret res[bool, Fail].ok{false}; }
    val res_nul: res[u64, Fail] = after_last_nul(x, strings::u64, s);
    if (sel res_nul.err) { ret res[bool, Fail].err{res_nul.err}; }
    ret res[bool, Fail].ok{name::u64 < res_nul.ok};
}

# the position after the last NUL byte of the non-empty string table `s`,
# zero when it has none
fun after_last_nul(x: *Ctx, i: u64, s: *Section) res[u64, Fail] {
    val memo: *u64 = ?x.nuls.data[i::usize];
    if (@memo != 0) { ret res[u64, Fail].ok{@memo - 1}; }
    val res_sub: res[Reader, Fail] = reader.sub(?x.file, s.offset, s.length);
    if (sel res_sub.err) { ret res[u64, Fail].err{res_sub.err}; }
    var sr:        Reader         = res_sub.ok;
    val res_bytes: res[*u8, Fail] = reader.bytes(?sr, s.length);
    if (sel res_bytes.err) { ret res[u64, Fail].err{res_bytes.err}; }
    var k: u64 = s.length;
    for (k > 0) {
        if (res_bytes.ok[(k - 1)::usize] == 0) { brk; }
        k = k - 1;
    }
    @memo = k + 1;
    ret res[u64, Fail].ok{k};
}

# decide which sections own their bytes and which overlay others, then tile
# the file with extents
fun layout(x: *Ctx) err[Fail] {
    val c:      *Class        = x.c;
    val h:      *model.Header = ?x.m.header;
    val nseg:   usize         = table.count[Segment](?x.m.segments);
    var fixed:  [3]Range;
    var nfixed: usize         = 0;
    fixed[0] = Range{start: 0, end: c.header.size::u64, kind: KIND_HEADER};
    nfixed   = 1;
    if (nseg != 0) {
        fixed[nfixed] = Range{start: h.phoff, end: h.phoff + nseg::u64 * c.segment.size::u64, kind: KIND_SEGMENTS};
        nfixed        = nfixed + 1;
    }
    if (x.count != 0) {
        fixed[nfixed] = Range{start: h.shoff, end: h.shoff + x.count * c.section.size::u64, kind: KIND_SECTIONS};
        nfixed        = nfixed + 1;
    }
    var a: usize = 0;
    for (a < nfixed) {
        var b: usize = a + 1;
        for (b < nfixed) {
            if (overlaps(fixed[a], fixed[b])) {
                ret err[Fail].err{at(fail.in_record(fail.malformed("file header and tables overlap"), "file layout"), fixed[b].start)};
            }
            b = b + 1;
        }
        a = a + 1;
    }

    var all:       Vector[Range] = vector.init[Range](x.m.a);
    val err_place: err[Fail]     = place(x, ?fixed[0], nfixed, ?all);
    if (sel err_place.err) {
        val err_dropped: err[Fail] = vectors.dnit[Range](?all);
        ret err_place;
    }
    val err_emit: err[Fail] = emit(x, ?all);
    val err_rel:  err[Fail] = vectors.dnit[Range](?all);
    if (sel err_emit.err) { ret err_emit; }
    ret err_rel;
}

# gather the fixed ranges and the sections that own their bytes into `all`,
# in file order, marking every other section overlaid
fun place(x: *Ctx, fixed: *Range, nfixed: usize, all: *Vector[Range]) err[Fail] {
    var i: u64 = 0;
    for (i < x.count) {
        val s: *Section = section(x, i);
        if (holds_bytes(s) && s.length != 0) {
            val err_all_pushed: err[Fail] = vectors.push[Range](all, Range{start: s.offset, end: s.offset + s.length, kind: KIND_SECTION, id: i::u32});
            if (sel err_all_pushed.err) { ret err[Fail].err{err_all_pushed.err}; }
        }
        i = i + 1;
    }
    val n: usize = vector.length[Range](all);
    sort.sort_by[Range](all.data, n, by_start);
    var cursor: u64    = 0;
    var kept:   usize  = 0;
    var k:      usize  = 0;
    val items:  *Range = all.data;
    for (k < n) {
        val r:    Range = items[k];
        var over: bool  = r.start < cursor;
        var f:    usize = 0;
        for (f < nfixed) {
            if (overlaps(r, fixed[f])) { over = true; }
            f = f + 1;
        }
        if (over) { section(x, r.id::u64).body = Body.overlaid{}; }
        or {
            items[kept] = r;
            kept        = kept + 1;
            cursor      = r.end;
        }
        k = k + 1;
    }
    vectors.truncate[Range](all, kept);
    var f: usize = 0;
    for (f < nfixed) {
        val err_all_pushed: err[Fail] = vectors.push[Range](all, fixed[f]);
        if (sel err_all_pushed.err) { ret err[Fail].err{err_all_pushed.err}; }
        f = f + 1;
    }
    sort.sort_by[Range](all.data, vector.length[Range](all), by_start);
    ret err[Fail].ok{};
}

fun emit(x: *Ctx, all: *Vector[Range]) err[Fail] {
    var cursor: u64   = 0;
    var k:      usize = 0;
    for (k < vector.length[Range](all)) {
        val r: Range = all.data[k];
        if (r.start > cursor) {
            val err_push_raw: err[Fail] = push_raw(x, cursor, r.start);
            if (sel err_push_raw.err) { ret err_push_raw; }
        }
        var e: Extent;
        if (r.kind == KIND_HEADER)   { e = Extent.header{}; }
        or (r.kind == KIND_SEGMENTS) { e = Extent.segments{}; }
        or (r.kind == KIND_SECTIONS) { e = Extent.sections{}; }
        or                           { e = Extent.section{table.nth[Section](r.id::usize)}; }
        val err_extents_pushed: err[Fail] = vectors.push[Extent](?x.m.extents, e);
        if (sel err_extents_pushed.err) { ret err[Fail].err{err_extents_pushed.err}; }
        cursor = r.end;
        k      = k + 1;
    }
    if (cursor < x.in.len::u64) { ret push_raw(x, cursor, x.in.len::u64); }
    ret err[Fail].ok{};
}

fun push_raw(x: *Ctx, start: u64, end: u64) err[Fail] {
    val res_held: res[Held, Fail] = held(?x.file, start, end - start);
    if (sel res_held.err) { ret err[Fail].err{res_held.err}; }
    val err_extents_pushed: err[Fail] = vectors.push[Extent](?x.m.extents, Extent.raw{Raw{bytes: res_held.ok, why: Why.opaque{}}});
    if (sel err_extents_pushed.err) { ret err[Fail].err{err_extents_pushed.err}; }
    ret err[Fail].ok{};
}

fun by_start(a: *Range, b: *Range) i64 {
    if (a.start != b.start) {
        if (a.start < b.start) { ret -1; }
        ret 1;
    }
    if (a.kind != b.kind) { ret a.kind::i64 - b.kind::i64; }
    ret a.id::i64 - b.id::i64;
}

fun overlaps(a: Range, b: Range) bool {
    ret a.start < b.end && b.start < a.end;
}

fun read_bodies(x: *Ctx) err[Fail] {
    var i: u64 = 0;
    for (i < x.count) {
        val s: *Section = section(x, i);
        if (!sel s.body.overlaid && holds_bytes(s) && s.length != 0) {
            val res_read_body: res[Body, Fail] = read_body(x, s);
            if (sel res_read_body.err) { ret err[Fail].err{fail.in_indexed(res_read_body.err, "section header", i)}; }
            s.body = res_read_body.ok;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the body of a section that owns bytes: typed when a typed body tiles it, raw
# otherwise, unsupported when a codec declined the bytes and opaque when no codec
# is named for the section
fun read_body(x: *Ctx, s: *Section) res[Body, Fail] {
    val res_sub: res[Reader, Fail] = reader.sub(?x.file, s.offset, s.length);
    if (sel res_sub.err) { ret res[Body, Fail].err{res_sub.err}; }
    var rd:        Reader               = res_sub.ok;
    var why:       Why                  = Why.unsupported{};
    val res_typed: res[opt[Body], Fail] = typed_body(x, s, ?rd, ?why);
    if (sel res_typed.err)     { ret res[Body, Fail].err{res_typed.err}; }
    if (sel res_typed.ok.some) { ret res[Body, Fail].ok{res_typed.ok.some}; }
    val res_held: res[Held, Fail] = held(?rd, 0, s.length);
    if (sel res_held.err) { ret res[Body, Fail].err{res_held.err}; }
    ret res[Body, Fail].ok{Body.raw{Raw{bytes: res_held.ok, why: why}}};
}

fun typed_body(x: *Ctx, s: *Section, rd: *Reader, why: *Why) res[opt[Body], Fail] {
    val t: u32 = s.type;
    if ((s.flags & tables.SHF_COMPRESSED.value::u64) != 0)                      { ret compressed(x, s, rd); }
    if (t == tables.SHT_SYMTAB.value::u32 || t == tables.SHT_DYNSYM.value::u32) { ret symbols(x, s, rd); }
    if (t == tables.SHT_REL.value::u32)                                         { ret rels(x, s, rd); }
    if (t == tables.SHT_RELA.value::u32)                                        { ret relas(x, s, rd); }
    if (t == tables.SHT_RELR.value::u32)                                        { ret relrs(x, s, rd); }
    if (t == tables.SHT_DYNAMIC.value::u32)                                     { ret dynamics(x, s, rd); }
    if (t == tables.SHT_NOTE.value::u32)                                        { ret notes(x, s, rd); }
    if (t == tables.SHT_SYMTAB_SHNDX.value::u32)                                { ret words(x, s, rd, false); }
    if (t == tables.SHT_GNU_versym.value::u32)                                  { ret versyms(x, s, rd); }
    if (t == tables.SHT_GNU_verdef.value::u32)                                  { ret verdefs(x, s, rd); }
    if (t == tables.SHT_GNU_verneed.value::u32)                                 { ret verneeds(x, s, rd); }
    if (t == tables.SHT_GROUP.value::u32)                                       { ret words(x, s, rd, true); }
    if (t == tables.SHT_HASH.value::u32)                                        { ret hashes(x, s, rd); }
    if (t == tables.SHT_GNU_HASH.value::u32)                                    { ret gnu_hashes(x, s, rd); }
    @why = Why.opaque{};
    ret untiled();
}

fun typed(b: Body) res[opt[Body], Fail] {
    ret res[opt[Body], Fail].ok{opt[Body].some{b}};
}

fun untiled() res[opt[Body], Fail] {
    ret res[opt[Body], Fail].ok{opt[Body].none{}};
}

# the count of `size` byte records that tile `s`, none when the section's entry
# size is not `size` or they do not tile it
fun records(s: *Section, size: usize) opt[u64] {
    if (s.entsize != size::u64) { ret opt[u64].none{}; }
    ret tiles(s.length, size);
}

fun tiles(length: u64, size: usize) opt[u64] {
    if (length % size::u64 != 0) { ret opt[u64].none{}; }
    ret opt[u64].some{length / size::u64};
}

fun symbols(x: *Ctx, s: *Section, rd: *Reader) res[opt[Body], Fail] {
    val c:           *Class   = x.c;
    val opt_records: opt[u64] = records(s, c.symbol.size);
    if (sel opt_records.none)   { ret untiled(); }
    if (s.link::u64 >= x.count) { ret untiled(); }
    var tab:      Table[Symbol]         = table.init[Symbol](x.m.a);
    val res_grow: res[Id[Symbol], Fail] = table.grow[Symbol](?tab, opt_records.some::usize);
    if (sel res_grow.err) { ret lost[Symbol](?tab.vec, res_grow.err); }
    val items: *Symbol = table.items[Symbol](?tab);
    val o:     Order   = x.order;
    var k:     u64     = 0;
    for (k < opt_records.some) {
        val res_rec: res[*u8, Fail] = record(rd, "symbol", k, c.symbol.size);
        if (sel res_rec.err) { ret lost[Symbol](?tab.vec, res_rec.err); }
        val p: *u8     = res_rec.ok;
        val e: *Symbol = ?items[k::usize];
        e.name  = slot.field(p, c.symbol.name, o)::u32;
        e.info  = slot.field(p, c.symbol.info, o)::u8;
        e.other = slot.field(p, c.symbol.other, o)::u8;
        e.shndx = slot.field(p, c.symbol.shndx, o)::u16;
        e.value = slot.field(p, c.symbol.value, o);
        e.bytes = slot.field(p, c.symbol.bytes, o);
        val res_named: res[bool, Fail] = resolves(x, s.link, e.name);
        if (sel res_named.err) { ret lost[Symbol](?tab.vec, res_named.err); }
        if (!res_named.ok)     { ret dropped[Symbol](?tab.vec); }
        k = k + 1;
    }
    ret typed(Body.symbols{tab});
}

fun rels(x: *Ctx, s: *Section, rd: *Reader) res[opt[Body], Fail] {
    val c:           *Class   = x.c;
    val opt_records: opt[u64] = records(s, c.rel.size);
    if (sel opt_records.none) { ret untiled(); }
    var tab:      Table[Rel]         = table.init[Rel](x.m.a);
    val res_grow: res[Id[Rel], Fail] = table.grow[Rel](?tab, opt_records.some::usize);
    if (sel res_grow.err) { ret lost[Rel](?tab.vec, res_grow.err); }
    val items: *Rel = table.items[Rel](?tab);
    var k:     u64  = 0;
    for (k < opt_records.some) {
        val res_rec: res[*u8, Fail] = record(rd, "relocation", k, c.rel.size);
        if (sel res_rec.err) { ret lost[Rel](?tab.vec, res_rec.err); }
        items[k::usize] = Rel{offset: slot.field(res_rec.ok, c.rel.offset, x.order), info: slot.field(res_rec.ok, c.rel.info, x.order)};
        k               = k + 1;
    }
    ret typed(Body.rel{tab});
}

fun relas(x: *Ctx, s: *Section, rd: *Reader) res[opt[Body], Fail] {
    val c:           *Class   = x.c;
    val opt_records: opt[u64] = records(s, c.rela.size);
    if (sel opt_records.none) { ret untiled(); }
    var tab:      Table[Rela]         = table.init[Rela](x.m.a);
    val res_grow: res[Id[Rela], Fail] = table.grow[Rela](?tab, opt_records.some::usize);
    if (sel res_grow.err) { ret lost[Rela](?tab.vec, res_grow.err); }
    val items: *Rela = table.items[Rela](?tab);
    var k:     u64   = 0;
    for (k < opt_records.some) {
        val res_rec: res[*u8, Fail] = record(rd, "relocation", k, c.rela.size);
        if (sel res_rec.err) { ret lost[Rela](?tab.vec, res_rec.err); }
        val p: *u8 = res_rec.ok;
        items[k::usize] = Rela{
            offset: slot.field(p, c.rela.offset, x.order),
            info:   slot.field(p, c.rela.info, x.order),
            addend: signed(slot.field(p, c.rela.addend, x.order), c.rela.addend.width),
        };
        k = k + 1;
    }
    ret typed(Body.rela{tab});
}

fun relrs(x: *Ctx, s: *Section, rd: *Reader) res[opt[Body], Fail] {
    val c:           *Class   = x.c;
    val opt_records: opt[u64] = records(s, c.addr);
    if (sel opt_records.none) { ret untiled(); }
    var tab:      Vector[u64] = vector.init[u64](x.m.a);
    val err_grow: err[Fail]   = vectors.grow[u64](?tab, opt_records.some::usize);
    if (sel err_grow.err) { ret lost[u64](?tab, err_grow.err); }
    val items: *u64 = tab.data;
    var k:     u64  = 0;
    for (k < opt_records.some) {
        val res_uint: res[u64, Fail] = reader.uint(rd, c.addr);
        if (sel res_uint.err) { ret lost[u64](?tab, res_uint.err); }
        items[k::usize] = res_uint.ok;
        k               = k + 1;
    }
    ret typed(Body.relr{tab});
}

fun dynamics(x: *Ctx, s: *Section, rd: *Reader) res[opt[Body], Fail] {
    val c:           *Class   = x.c;
    val opt_records: opt[u64] = records(s, c.dyn.size);
    if (sel opt_records.none) { ret untiled(); }
    var tab:      Table[Dyn]         = table.init[Dyn](x.m.a);
    val res_grow: res[Id[Dyn], Fail] = table.grow[Dyn](?tab, opt_records.some::usize);
    if (sel res_grow.err) { ret lost[Dyn](?tab.vec, res_grow.err); }
    val items: *Dyn = table.items[Dyn](?tab);
    var k:     u64  = 0;
    for (k < opt_records.some) {
        val res_rec: res[*u8, Fail] = record(rd, "dynamic entry", k, c.dyn.size);
        if (sel res_rec.err) { ret lost[Dyn](?tab.vec, res_rec.err); }
        items[k::usize] = Dyn{
            kind:  signed(slot.field(res_rec.ok, c.dyn.kind, x.order), c.dyn.kind.width),
            value: slot.field(res_rec.ok, c.dyn.value, x.order),
        };
        k = k + 1;
    }
    ret typed(Body.dynamic{tab});
}

# the words of `s` as a section group when `grouped`, whose first word is its
# flags, and as the extended section indexes of its symbols otherwise
fun words(x: *Ctx, s: *Section, rd: *Reader, grouped: bool) res[opt[Body], Fail] {
    val w:    u64 = model.WORD::u64;
    var skip: u64 = 0;
    if (grouped)                                       { skip = w; }
    if (s.length < skip || (s.length - skip) % w != 0) { ret untiled(); }
    var flags: u32 = 0;
    if (grouped) {
        val res_u32: res[u32, Fail] = reader.u32(rd);
        if (sel res_u32.err) { ret res[opt[Body], Fail].err{res_u32.err}; }
        flags = res_u32.ok;
    }
    val res_tab: res[Vector[u32], Fail] = u32s(x, (s.length - skip) / w, rd);
    if (sel res_tab.err) { ret res[opt[Body], Fail].err{res_tab.err}; }
    if (grouped)         { ret typed(Body.group{Group{flags: flags, members: res_tab.ok}}); }
    ret typed(Body.shndx{res_tab.ok});
}

fun versyms(x: *Ctx, s: *Section, rd: *Reader) res[opt[Body], Fail] {
    val opt_tiles: opt[u64] = tiles(s.length, model.HALF);
    if (sel opt_tiles.none) { ret untiled(); }
    var tab:      Vector[u16] = vector.init[u16](x.m.a);
    val err_grow: err[Fail]   = vectors.grow[u16](?tab, opt_tiles.some::usize);
    if (sel err_grow.err) { ret lost[u16](?tab, err_grow.err); }
    val items: *u16 = tab.data;
    var k:     u64  = 0;
    for (k < opt_tiles.some) {
        val res_u16: res[u16, Fail] = reader.u16(rd);
        if (sel res_u16.err) { ret lost[u16](?tab, res_u16.err); }
        items[k::usize] = res_u16.ok;
        k               = k + 1;
    }
    ret typed(Body.versym{tab});
}

# `n` words from `rd`
fun u32s(x: *Ctx, n: u64, rd: *Reader) res[Vector[u32], Fail] {
    var tab:      Vector[u32] = vector.init[u32](x.m.a);
    val err_grow: err[Fail]   = vectors.grow[u32](?tab, n::usize);
    if (sel err_grow.err) {
        val err_dropped: err[Fail] = vectors.dnit[u32](?tab);
        ret res[Vector[u32], Fail].err{err_grow.err};
    }
    val items: *u32 = tab.data;
    var k:     u64  = 0;
    for (k < n) {
        val res_u32: res[u32, Fail] = reader.u32(rd);
        if (sel res_u32.err) {
            val err_dropped: err[Fail] = vectors.dnit[u32](?tab);
            ret res[Vector[u32], Fail].err{res_u32.err};
        }
        items[k::usize] = res_u32.ok;
        k               = k + 1;
    }
    ret res[Vector[u32], Fail].ok{tab};
}

fun hashes(x: *Ctx, s: *Section, rd: *Reader) res[opt[Body], Fail] {
    if (s.length < 8) { ret untiled(); }
    val res_u32: res[u32, Fail] = reader.u32(rd);
    if (sel res_u32.err) { ret res[opt[Body], Fail].err{res_u32.err}; }
    val res_nchain: res[u32, Fail] = reader.u32(rd);
    if (sel res_nchain.err)                                         { ret res[opt[Body], Fail].err{res_nchain.err}; }
    if (8 + 4 * (res_u32.ok::u64 + res_nchain.ok::u64) != s.length) { ret untiled(); }
    var res_buckets: res[Vector[u32], Fail] = u32s(x, res_u32.ok::u64, rd);
    if (sel res_buckets.err) { ret res[opt[Body], Fail].err{res_buckets.err}; }
    val res_chains: res[Vector[u32], Fail] = u32s(x, res_nchain.ok::u64, rd);
    if (sel res_chains.err) {
        val err_dropped: err[Fail] = vectors.dnit[u32](?res_buckets.ok);
        ret res[opt[Body], Fail].err{res_chains.err};
    }
    ret typed(Body.hash{Hash{buckets: res_buckets.ok, chains: res_chains.ok}});
}

fun gnu_hashes(x: *Ctx, s: *Section, rd: *Reader) res[opt[Body], Fail] {
    val c: *Class = x.c;
    if (s.length < 16) { ret untiled(); }
    val res_u32: res[u32, Fail] = reader.u32(rd);
    if (sel res_u32.err) { ret res[opt[Body], Fail].err{res_u32.err}; }
    val res_sym: res[u32, Fail] = reader.u32(rd);
    if (sel res_sym.err) { ret res[opt[Body], Fail].err{res_sym.err}; }
    val res_bloom: res[u32, Fail] = reader.u32(rd);
    if (sel res_bloom.err) { ret res[opt[Body], Fail].err{res_bloom.err}; }
    val res_shift: res[u32, Fail] = reader.u32(rd);
    if (sel res_shift.err) { ret res[opt[Body], Fail].err{res_shift.err}; }
    val fixed: u64 = 16 + res_bloom.ok::u64 * c.addr::u64 + res_u32.ok::u64 * 4;
    if (fixed > s.length || (s.length - fixed) % 4 != 0) { ret untiled(); }
    var words:    Vector[u64] = vector.init[u64](x.m.a);
    val err_grow: err[Fail]   = vectors.grow[u64](?words, res_bloom.ok::usize);
    if (sel err_grow.err) { ret lost[u64](?words, err_grow.err); }
    val items: *u64 = words.data;
    var k:     u64  = 0;
    for (k < res_bloom.ok::u64) {
        val res_uint: res[u64, Fail] = reader.uint(rd, c.addr);
        if (sel res_uint.err) { ret lost[u64](?words, res_uint.err); }
        items[k::usize] = res_uint.ok;
        k               = k + 1;
    }
    var res_buckets: res[Vector[u32], Fail] = u32s(x, res_u32.ok::u64, rd);
    if (sel res_buckets.err) { ret lost[u64](?words, res_buckets.err); }
    val res_chain: res[Vector[u32], Fail] = u32s(x, (s.length - fixed) / 4, rd);
    if (sel res_chain.err) {
        val err_dropped: err[Fail] = vectors.dnit[u32](?res_buckets.ok);
        ret lost[u64](?words, res_chain.err);
    }
    ret typed(Body.gnu_hash{GnuHash{symoffset: res_sym.ok, shift: res_shift.ok, bloom: words, buckets: res_buckets.ok, chain: res_chain.ok}});
}

fun compressed(x: *Ctx, s: *Section, rd: *Reader) res[opt[Body], Fail] {
    val c:    *Class = x.c;
    val size: u64    = c.chdr.size::u64;
    if (s.length < size) { ret untiled(); }
    val res_view: res[*u8, Fail] = view(rd, 0, size);
    if (sel res_view.err) { ret res[opt[Body], Fail].err{res_view.err}; }
    val res_data: res[Held, Fail] = held(rd, size, s.length - size);
    if (sel res_data.err) { ret res[opt[Body], Fail].err{res_data.err}; }
    val o: Order = x.order;
    ret typed(Body.compressed{Compressed{
        type:      slot.field(res_view.ok, c.chdr.type, o)::u32,
        reserved:  slot.field(res_view.ok, c.chdr.reserved, o)::u32,
        length:    slot.field(res_view.ok, c.chdr.length, o),
        addralign: slot.field(res_view.ok, c.chdr.addralign, o),
        data:      res_data.ok,
    }});
}

fun verdefs(x: *Ctx, s: *Section, rd: *Reader) res[opt[Body], Fail] {
    val o:   Order              = x.order;
    val d:   model.VerdefShape  = model.VERDEF;
    val a:   model.VerdauxShape = model.VERDAUX;
    var tab: Table[Definition]  = table.init[Definition](x.m.a);
    var pos: u64                = 0;
    for (pos < s.length) {
        if (s.length - pos < d.size::u64) { ret dropped[Definition](?tab.vec); }
        val res_view: res[*u8, Fail] = view(rd, pos, d.size::u64);
        if (sel res_view.err) { ret lost[Definition](?tab.vec, res_view.err); }
        val def: Verdef = Verdef{
            version: slot.field(res_view.ok, d.version, o)::u16,
            flags:   slot.field(res_view.ok, d.flags, o)::u16,
            ndx:     slot.field(res_view.ok, d.ndx, o)::u16,
            cnt:     slot.field(res_view.ok, d.cnt, o)::u16,
            hash:    slot.field(res_view.ok, d.hash, o)::u32,
            aux:     slot.field(res_view.ok, d.aux, o)::u32,
            next:    slot.field(res_view.ok, d.next, o)::u32,
        };
        val res_first: res[Id[Definition], Fail] = table.push[Definition](?tab, Definition.verdef{def});
        if (sel res_first.err) { ret lost[Definition](?tab.vec, res_first.err); }
        val cnt: u64 = def.cnt::u64;
        if (cnt != 0 && def.aux != d.size::u32) { ret dropped[Definition](?tab.vec); }
        val end: u64 = pos + d.size::u64 + cnt * a.size::u64;
        if (end > s.length) { ret dropped[Definition](?tab.vec); }
        var k: u64 = 0;
        for (k < cnt) {
            val res_view: res[*u8, Fail] = view(rd, pos + d.size::u64 + k * a.size::u64, a.size::u64);
            if (sel res_view.err) { ret lost[Definition](?tab.vec, res_view.err); }
            val aux:        Verdaux                   = Verdaux{name: slot.field(res_view.ok, a.name, o)::u32, next: slot.field(res_view.ok, a.next, o)::u32};
            val res_pushed: res[Id[Definition], Fail] = table.push[Definition](?tab, Definition.verdaux{aux});
            if (sel res_pushed.err) { ret lost[Definition](?tab.vec, res_pushed.err); }
            k = k + 1;
        }
        if (def.next == 0 && end != s.length)            { ret dropped[Definition](?tab.vec); }
        if (def.next != 0 && def.next::u64 != end - pos) { ret dropped[Definition](?tab.vec); }
        pos = end;
    }
    ret typed(Body.verdef{tab});
}

fun verneeds(x: *Ctx, s: *Section, rd: *Reader) res[opt[Body], Fail] {
    val o:   Order              = x.order;
    val d:   model.VerneedShape = model.VERNEED;
    val a:   model.VernauxShape = model.VERNAUX;
    var tab: Table[Need]        = table.init[Need](x.m.a);
    var pos: u64                = 0;
    for (pos < s.length) {
        if (s.length - pos < d.size::u64) { ret dropped[Need](?tab.vec); }
        val res_view: res[*u8, Fail] = view(rd, pos, d.size::u64);
        if (sel res_view.err) { ret lost[Need](?tab.vec, res_view.err); }
        val need: Verneed = Verneed{
            version: slot.field(res_view.ok, d.version, o)::u16,
            cnt:     slot.field(res_view.ok, d.cnt, o)::u16,
            file:    slot.field(res_view.ok, d.file, o)::u32,
            aux:     slot.field(res_view.ok, d.aux, o)::u32,
            next:    slot.field(res_view.ok, d.next, o)::u32,
        };
        val res_first: res[Id[Need], Fail] = table.push[Need](?tab, Need.verneed{need});
        if (sel res_first.err) { ret lost[Need](?tab.vec, res_first.err); }
        val cnt: u64 = need.cnt::u64;
        if (cnt != 0 && need.aux != d.size::u32) { ret dropped[Need](?tab.vec); }
        val end: u64 = pos + d.size::u64 + cnt * a.size::u64;
        if (end > s.length) { ret dropped[Need](?tab.vec); }
        var k: u64 = 0;
        for (k < cnt) {
            val res_view: res[*u8, Fail] = view(rd, pos + d.size::u64 + k * a.size::u64, a.size::u64);
            if (sel res_view.err) { ret lost[Need](?tab.vec, res_view.err); }
            val aux: Vernaux = Vernaux{
                hash:  slot.field(res_view.ok, a.hash, o)::u32,
                flags: slot.field(res_view.ok, a.flags, o)::u16,
                other: slot.field(res_view.ok, a.other, o)::u16,
                name:  slot.field(res_view.ok, a.name, o)::u32,
                next:  slot.field(res_view.ok, a.next, o)::u32,
            };
            val res_pushed: res[Id[Need], Fail] = table.push[Need](?tab, Need.vernaux{aux});
            if (sel res_pushed.err) { ret lost[Need](?tab.vec, res_pushed.err); }
            k = k + 1;
        }
        if (need.next == 0 && end != s.length)             { ret dropped[Need](?tab.vec); }
        if (need.next != 0 && need.next::u64 != end - pos) { ret dropped[Need](?tab.vec); }
        pos = end;
    }
    ret typed(Body.verneed{tab});
}

# what one note and its padding span
rec Parsed {
    note: Note;
    next: u64;
}

fun notes(x: *Ctx, s: *Section, rd: *Reader) res[opt[Body], Fail] {
    val res_notes_of: res[opt[Vector[Note]], Fail] = notes_of(x.m.a, x.m.shape, rd, s.length, s.addralign);
    if (sel res_notes_of.err)     { ret res[opt[Body], Fail].err{res_notes_of.err}; }
    if (sel res_notes_of.ok.none) { ret untiled(); }
    ret typed(Body.notes{res_notes_of.ok.some});
}

# the notes that tile the `length` bytes of `rd` in a file of `shape`, each
# descriptor padded to `align`, none when the alignment is neither four nor
# eight or the notes do not tile the bytes. a GNU property note holds its
# properties when they tile its descriptor. the notes borrow the bytes of
# `rd` and their tables live in `a`
pub fun notes_of(a: *A.Allocator, shape: Shape, rd: *Reader, length: u64, align: u64) res[opt[Vector[Note]], Fail] {
    if (align != 4 && align != 8) { ret res[opt[Vector[Note]], Fail].ok{opt[Vector[Note]].none{}}; }
    var tab: Vector[Note] = vector.init[Note](a);
    var pos: u64          = 0;
    for (pos < length) {
        val res_note: res[opt[Parsed], Fail] = note(a, shape, rd, length, pos, align);
        if (sel res_note.err) {
            val err_dropped: err[Fail] = notes_dnit(?tab);
            ret res[opt[Vector[Note]], Fail].err{res_note.err};
        }
        if (sel res_note.ok.none) {
            val err_drop_notes: err[Fail] = notes_dnit(?tab);
            if (sel err_drop_notes.err) { ret res[opt[Vector[Note]], Fail].err{err_drop_notes.err}; }
            ret res[opt[Vector[Note]], Fail].ok{opt[Vector[Note]].none{}};
        }
        val err_pushed: err[Fail] = vectors.push[Note](?tab, res_note.ok.some.note);
        if (sel err_pushed.err) {
            val err_lost:    err[Fail] = desc_dnit(?res_note.ok.some.note);
            val err_dropped: err[Fail] = notes_dnit(?tab);
            ret res[opt[Vector[Note]], Fail].err{err_pushed.err};
        }
        pos = res_note.ok.some.next;
    }
    ret res[opt[Vector[Note]], Fail].ok{opt[Vector[Note]].some{tab}};
}

# the note at `pos`, none when it does not tile. its name is padded to four
# bytes and its descriptor to `align`, with zeros
fun note(a: *A.Allocator, sh: Shape, rd: *Reader, length: u64, pos: u64, align: u64) res[opt[Parsed], Fail] {
    val o:     Order           = sh.order;
    val shape: model.NoteShape = model.NOTE;
    if (length - pos < shape.size::u64) { ret res[opt[Parsed], Fail].ok{opt[Parsed].none{}}; }
    val res_view: res[*u8, Fail] = view(rd, pos, shape.size::u64);
    if (sel res_view.err) { ret res[opt[Parsed], Fail].err{res_view.err}; }
    val namesz:  u64 = slot.field(res_view.ok, shape.namesz, o);
    val descsz:  u64 = slot.field(res_view.ok, shape.descsz, o);
    val type:    u64 = slot.field(res_view.ok, shape.type, o);
    val name_at: u64 = pos + shape.size::u64;
    val desc_at: u64 = name_at + padded(namesz, NOTE_NAME_ALIGN);
    val next:    u64 = desc_at + padded(descsz, align);
    if (next > length) { ret res[opt[Parsed], Fail].ok{opt[Parsed].none{}}; }
    val res_name_pad_zeroed: res[bool, Fail] = zeros(rd, name_at + namesz, desc_at);
    if (sel res_name_pad_zeroed.err) { ret res[opt[Parsed], Fail].err{res_name_pad_zeroed.err}; }
    val res_desc_pad_zeroed: res[bool, Fail] = zeros(rd, desc_at + descsz, next);
    if (sel res_desc_pad_zeroed.err)                        { ret res[opt[Parsed], Fail].err{res_desc_pad_zeroed.err}; }
    if (!res_name_pad_zeroed.ok || !res_desc_pad_zeroed.ok) { ret res[opt[Parsed], Fail].ok{opt[Parsed].none{}}; }
    val res_name: res[Held, Fail] = held(rd, name_at, namesz);
    if (sel res_name.err) { ret res[opt[Parsed], Fail].err{res_name.err}; }
    val res_raw: res[Held, Fail] = held(rd, desc_at, descsz);
    if (sel res_raw.err) { ret res[opt[Parsed], Fail].err{res_raw.err}; }
    val res_gnu: res[bool, Fail] = is_gnu(rd, name_at, namesz);
    if (sel res_gnu.err) { ret res[opt[Parsed], Fail].err{res_gnu.err}; }
    val props_note: bool = res_gnu.ok && type::u32 == tables.NT_GNU_PROPERTY_TYPE_0.value::u32;
    var why:        Why  = Why.opaque{};
    if (props_note) { why = Why.unsupported{}; }
    var n: Note = Note{namesz: namesz::u32, descsz: descsz::u32, type: type::u32, name: res_name.ok, desc: Desc.raw{Raw{bytes: res_raw.ok, why: why}}};
    if (props_note) {
        val res_props: res[opt[Vector[Property]], Fail] = properties(a, sh, rd, desc_at, descsz);
        if (sel res_props.err)     { ret res[opt[Parsed], Fail].err{res_props.err}; }
        if (sel res_props.ok.some) { n.desc = Desc.properties{res_props.ok.some}; }
    }
    ret res[opt[Parsed], Fail].ok{opt[Parsed].some{Parsed{note: n, next: next}}};
}

# the properties of a GNU property descriptor, none when they do not tile it
fun properties(a: *A.Allocator, sh: Shape, rd: *Reader, at: u64, size: u64) res[opt[Vector[Property]], Fail] {
    val o:     Order               = sh.order;
    val shape: model.PropertyShape = model.PROPERTY;
    val pad:   u64                 = sh.class.addr::u64;
    var tab:   Vector[Property]    = vector.init[Property](a);
    var pos:   u64                 = 0;
    for (pos < size) {
        if (size - pos < shape.size::u64) { ret abandoned(?tab); }
        val res_view: res[*u8, Fail] = view(rd, at + pos, shape.size::u64);
        if (sel res_view.err) { ret failed(?tab, res_view.err); }
        val datasz: u64 = slot.field(res_view.ok, shape.datasz, o);
        val end:    u64 = pos + shape.size::u64 + padded(datasz, pad);
        if (end > size) { ret abandoned(?tab); }
        val res_zeros: res[bool, Fail] = zeros(rd, at + pos + shape.size::u64 + datasz, at + end);
        if (sel res_zeros.err) { ret failed(?tab, res_zeros.err); }
        if (!res_zeros.ok)     { ret abandoned(?tab); }
        val res_data: res[Held, Fail] = held(rd, at + pos + shape.size::u64, datasz);
        if (sel res_data.err) { ret failed(?tab, res_data.err); }
        val err_pushed: err[Fail] = vectors.push[Property](?tab, Property{type: slot.field(res_view.ok, shape.type, o)::u32, datasz: datasz::u32, data: res_data.ok});
        if (sel err_pushed.err) { ret failed(?tab, err_pushed.err); }
        pos = end;
    }
    ret res[opt[Vector[Property]], Fail].ok{opt[Vector[Property]].some{tab}};
}

fun abandoned(t: *Vector[Property]) res[opt[Vector[Property]], Fail] {
    val err_release: err[Fail] = vectors.dnit[Property](t);
    if (sel err_release.err) { ret res[opt[Vector[Property]], Fail].err{err_release.err}; }
    ret res[opt[Vector[Property]], Fail].ok{opt[Vector[Property]].none{}};
}

fun failed(t: *Vector[Property], f: Fail) res[opt[Vector[Property]], Fail] {
    val err_release: err[Fail] = vectors.dnit[Property](t);
    ret res[opt[Vector[Property]], Fail].err{f};
}

# whether the note name at `at` is "GNU" and its NUL
fun is_gnu(rd: *Reader, at: u64, size: u64) res[bool, Fail] {
    if (size != 4) { ret res[bool, Fail].ok{false}; }
    val res_view: res[*u8, Fail] = view(rd, at, 4);
    if (sel res_view.err) { ret res[bool, Fail].err{res_view.err}; }
    ret res[bool, Fail].ok{res_view.ok[0] == 'G' && res_view.ok[1] == 'N' && res_view.ok[2] == 'U' && res_view.ok[3] == 0};
}

# whether every byte from `from` to `to` is zero
fun zeros(rd: *Reader, from: u64, to: u64) res[bool, Fail] {
    if (to == from) { ret res[bool, Fail].ok{true}; }
    val res_view: res[*u8, Fail] = view(rd, from, to - from);
    if (sel res_view.err) { ret res[bool, Fail].err{res_view.err}; }
    var k: u64 = 0;
    for (k < to - from) {
        if (res_view.ok[k::usize] != 0) { ret res[bool, Fail].ok{false}; }
        k = k + 1;
    }
    ret res[bool, Fail].ok{true};
}

fun padded(v: u64, align: u64) u64 {
    ret (v + align - 1) & ~(align - 1);
}

fun desc_dnit(n: *Note) err[Fail] {
    if (sel n.desc.properties) { ret vectors.dnit[Property](?n.desc.properties); }
    ret err[Fail].ok{};
}

fun notes_dnit(t: *Vector[Note]) err[Fail] {
    var b:                Body      = Body.notes{@t};
    val err_release_body: err[Fail] = model.body_dnit(?b);
    ret err_release_body;
}

fun lost[T](t: *Vector[T], f: Fail) res[opt[Body], Fail] {
    val err_release: err[Fail] = vectors.dnit[T](t);
    ret res[opt[Body], Fail].err{f};
}

fun dropped[T](t: *Vector[T]) res[opt[Body], Fail] {
    val err_release: err[Fail] = vectors.dnit[T](t);
    if (sel err_release.err) { ret res[opt[Body], Fail].err{err_release.err}; }
    ret untiled();
}

# the `size` bytes at `pos` of `rd`
fun view(rd: *Reader, pos: u64, size: u64) res[*u8, Fail] {
    val res_sub: res[Reader, Fail] = reader.sub(rd, pos, size);
    if (sel res_sub.err) { ret res[*u8, Fail].err{res_sub.err}; }
    var sr: Reader = res_sub.ok;
    ret reader.bytes(?sr, size);
}

fun held(rd: *Reader, pos: u64, size: u64) res[Held, Fail] {
    val res_view: res[*u8, Fail] = view(rd, pos, size);
    if (sel res_view.err) { ret res[Held, Fail].err{res_view.err}; }
    ret res[Held, Fail].ok{Held.borrowed{Bytes{data: res_view.ok, len: size::usize}}};
}

# the `index`th record of `size` bytes of the table `t`
fun record(t: *Reader, name: str, index: u64, size: usize) res[*u8, Fail] {
    val res_element: res[Reader, Fail] = shell.element(t, name, index, size::u64);
    if (sel res_element.err) { ret res[*u8, Fail].err{res_element.err}; }
    var er:        Reader         = res_element.ok;
    val res_bytes: res[*u8, Fail] = reader.bytes(?er, size::u64);
    if (sel res_bytes.err) { ret res[*u8, Fail].err{fail.in_indexed(res_bytes.err, name, index)}; }
    ret res_bytes;
}

# `v` of `width` bytes, sign extended
fun signed(v: u64, width: u8) i64 {
    if (width == 4) {
        val w: u32 = v::u32;
        val s: i32 = w:~i32;
        ret s::i64;
    }
    ret v:~i64;
}

fun section(x: *Ctx, i: u64) *Section {
    ret model.section_at(x.m, table.nth[Section](i::usize));
}

fun at(f: Fail, offset: u64) Fail {
    ret fail.at_offset(f, offset);
}

# the file offset of field `slot` of section header `i`
fun sh_at(x: *Ctx, i: u64, slot: Slot) u64 {
    ret x.m.header.shoff + i * x.c.section.size::u64 + slot.offset::u64;
}

fun header_field(f: Fail, x: *Ctx, slot: Slot) Fail {
    ret fail.at_offset(fail.in_record(f, "file header"), slot.offset::u64);
}
