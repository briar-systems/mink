# the COFF format
#
# the exact revision of each specification the COFF modules implement, so a
# change to any of them is a visible version bump. one registration covers the
# regular object, the bigobj, the PE image and the short import object, which the
# reader returns as its own record and the registration models alongside the others.
# a short import object converts to the neutral object describing its library.

use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
