pub val REVISION_COUNT: usize = 2;

pub val REVISIONS: [REVISION_COUNT]Revision = [REVISION_COUNT]Revision{
    Revision{spec: "Microsoft PE Format, with the ARM64 and ARM64EC additions", revision: "page of 10 September 2026"},
    Revision{spec: "Windows SDK winnt.h layouts (IMAGE_LOAD_CONFIG_DIRECTORY32 and 64, IMAGE_ARM64EC_METADATA, IMAGE_CHPE_METADATA_X86), as mirrored by Wine include/winnt.h", revision: "Wine commit d38598c894f6 of 27 August 2026"},
};

# the conversion takes a relocatable object and the stub a short import
# object is
val KINDS:   [2]*Kind = [2]*Kind{?kind.RELOCATABLE, ?kind.STUB};
val NEUTRAL: Neutral  = Neutral{to: to_neutral_ops, from: from_neutral_ops, ct: Carry.note{}, kinds: Kinds{rows: ?KINDS[0], count: 2}, normalize: opt[Normalize].none{}};

val CODEC: Codec = Codec{
    identify: Identify.magics{Magics{rows: ?tables.MAGICS[0], count: tables.MAGIC_COUNT}},
    read:     read_ops,
    write:    write_ops,
    dump:     dump_ops,
    kind:     kind_ops,
    stated:   stated_ops,
    locate:   locate,
    release:  release_ops,
};

# the sections that are not image content a COFF link takes, the resource
# trees among them, which the image writer merges with the inputs' resources
val USE_COUNT: usize                   = 4;
val USES:      [USE_COUNT]*consume.Row = [USE_COUNT]*consume.Row{?consume.SIGNIFICANCE, ?consume.STRINGS, ?consume.STACK, ?consume.RESOURCE_TREES};

# the image writer exports what an export directive names
val DIRECTIVES: [1]*directive.Kind = [1]*directive.Kind{?directive.EXPORT};

val DECLARER_COUNT: usize                     = 3;
val DECLARERS:      [DECLARER_COUNT]*Declarer = [DECLARER_COUNT]*Declarer{?reserve.HEADER_TABLE, ?coff_image.TABLES, ?coff_convention.SLOTS};

val SYNTHESIZER_COUNT: usize                               = 3;
val SYNTHESIZERS:      [SYNTHESIZER_COUNT]*synthesizer.Row = [SYNTHESIZER_COUNT]*synthesizer.Row{?common.ROW, ?coff_image.CALLBACK_BOUNDS, ?needs.ROW};

# thunks send a branch past its reach through a veneer in an island
val PARTICIPANT_COUNT: usize                           = 1;
val PARTICIPANTS:      [PARTICIPANT_COUNT]*Participant = [PARTICIPANT_COUNT]*Participant{?thunk.THUNKS};

# every archive is searched again while a name is left undefined. whether a
# common definition pulls a member that defines its name as data is not
# verified, so the row leaves it off. an undefined weak reference takes its
# fallback. COFF inputs hold no merged strings, so no tails are shared.
# sections nothing reaches are left out. an image imports only from the DLLs a
# reference binds to. the link defines _tls_index where no input does, in the
# index cell of an image that supplies its own TLS directory. a DLL exports
# what its inputs' export directives name, as COFF symbols carry no
# visibility that exports them
val LINKING: Linking = Linking{
    caps:         linking.DIRECTED_EXPORTS,
    search:       resolve.REVISIT,
    hooks:        ?resolve.PLAIN,
    weak:         Weak.fallback{},
    folds:        fold.NONE,
    layout:       opt[*layout.Rules].some{?coff_convention.LAYOUT},
    tails:        false,
    collects:     true,
    dynamic:      ?coff_convention.DYNAMIC,
    loads_all:    false,
    facts:        ?coff_convention.FACTS,
    writer:       opt[*Writer].some{?coff_image.WRITER},
    declarers:    Declarers{rows: ?DECLARERS[0], count: DECLARER_COUNT},
    measures:     coff_image.MEASURES,
    uses:         consume.Uses{rows: ?USES[0], count: USE_COUNT, directives: ?DIRECTIVES[0], directive_count: 1, resources: true},
    synthesizers: Synthesizers{rows: ?SYNTHESIZERS[0], count: SYNTHESIZER_COUNT},
    participants: Participants{rows: ?PARTICIPANTS[0], count: PARTICIPANT_COUNT},
    bounds:       coff_image.BOUNDS,
};

pub val REGISTRATION: Registration = Registration{
    format:         ?format.COFF,
    codec:          opt[*Codec].some{?CODEC},
    traits:         opt[*TraitCodec].some{?contract.NO_TRAITS},
    naming:         opt[*Naming].some{?naming.NAMING},
    neutral:        opt[*Neutral].some{?NEUTRAL},
    lowering:       opt[*Lowering].some{?neutral.LOWERING},
    pairs:          ?pairs.PAIRS[0],
    pair_count:     pairs.COUNT,
    link:           opt[*Linking].some{?LINKING},
    revisions:      ?REVISIONS[0],
    revision_count: REVISION_COUNT,
    fields:         ?coff_dump.FIELDS[0],
    field_count:    coff_dump.FIELD_COUNT,
};

# a parsed file moved to the heap, which the registration hands around as a
# pointer
fun boxed(a: *A.Allocator, m: Parsed) res[ptr, Fail] {
    val p: res[*Parsed, A.Error] = A.allocate[Parsed](a, 1);
    if (sel p.err) {
        var dead:    Parsed    = m;
        val dropped: err[Fail] = release_parsed(?dead);
        ret res[ptr, Fail].err{fail.refused(p.err)};
    }
    val mp: *Parsed = p.ok;
    @mp = m;
    ret res[ptr, Fail].ok{mp::ptr};
}

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val r: res[Parsed, Fail] = read.read(a, in);
    if (sel r.err) { ret res[ptr, Fail].err{r.err}; }
    ret boxed(a, r.ok);
}

# a short import object is the library object of its one export
fun to_neutral_ops(m: ptr, rows: *row.Registry, o: *Object) err[Fail] {
    val p: *Parsed = m::*Parsed;
    if (sel p.object) { ret neutral.to_neutral(?p.object, rows, o); }
    or (sel p.short)  { ret library.to_neutral(?p.short, o); }
}

# an object describing a library is a short import object
fun from_neutral_ops(a: *A.Allocator, rows: *row.Registry, o: *Object, t: *Target, l: opt[*Lowering]) res[ptr, Fail] {
    val lib: opt[Library] = o.library;
    if (sel lib.some) {
        val i: res[import.Import, Fail] = library.from_neutral(a, o, lib.some, t);
        if (sel i.err) { ret res[ptr, Fail].err{i.err}; }
        ret boxed(a, Parsed.short{i.ok});
    }
    val m: res[model.Coff, Fail] = neutral.from_neutral(a, rows, o, t, l);
    if (sel m.err) { ret res[ptr, Fail].err{m.err}; }
    ret boxed(a, Parsed.object{m.ok});
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret write.write_parsed(a, m::*Parsed);
}

fun dump_ops(m: ptr, rows: *row.Registry, d: *Dumper) err[Fail] {
    ret coff_dump.describe_parsed(m::*Parsed, d);
}

fun kind_ops(m: ptr) res[*Kind, Fail] {
    ret coff_kind.of(m::*Parsed);
}

# the machine of the file header, or of a short import object's header
fun stated_ops(m: ptr) opt[Stated] {
    val p: *Parsed = m::*Parsed;
    if (sel p.object) { ret opt[Stated].some{model.stated(p.object.header.machine)}; }
    or (sel p.short)  { ret opt[Stated].some{model.stated(p.short.machine)}; }
}

# where the byte lies, from the layout of the extents
fun locate(m: ptr, offset: u64) Location {
    ret place.locate_parsed(m::*Parsed, offset);
}

fun release_ops(a: *A.Allocator, m: ptr) err[Fail] {
    val pp: *Parsed      = m::*Parsed;
    val r:  err[Fail]    = release_parsed(pp);
    val d:  err[A.Error] = A.deallocate[Parsed](a, pp, 1);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}

# give back what the model read as `p` owns
fun release_parsed(p: *Parsed) err[Fail] {
    if (sel p.object) { ret model.release(?p.object); }
    or (sel p.short)  { ret import.release(?p.short); }
}
