use mink.reloc.row;

pub val REVISION_COUNT: usize = 2;

pub val REVISIONS: [REVISION_COUNT]Revision = [REVISION_COUNT]Revision{
    Revision{spec: "Microsoft PE Format, with the ARM64 and ARM64EC additions", revision: "page of 10 September 2026"},
    Revision{spec: "Windows SDK winnt.h layouts (IMAGE_LOAD_CONFIG_DIRECTORY32 and 64, IMAGE_ARM64EC_METADATA, IMAGE_CHPE_METADATA_X86), as mirrored by Wine include/winnt.h", revision: "Wine commit d38598c894f6 of 27 August 2026"},
};

# the llvm-readobj flags for the directories and tables the dump prints
val REFERENCE_FLAG_COUNT: usize                     = 7;
val REFERENCE_FLAGS:      [REFERENCE_FLAG_COUNT]str = [REFERENCE_FLAG_COUNT]str{
    "--coff-imports", "--coff-exports", "--coff-basereloc", "--coff-debug-directory",
    "--coff-tls-directory", "--coff-load-config", "--coff-resources",
};

# a relocatable object is the one kind of file its conversion takes
val KINDS:   [1]*Kind = [1]*Kind{?kind.RELOCATABLE};
val NEUTRAL: Neutral  = Neutral{to: to_neutral_ops, from: from_neutral_ops, ct: Carry.note{}, kinds: Kinds{rows: ?KINDS[0], count: 1}};

val CODEC: Codec = Codec{
    identify: Identify.magics{Magics{rows: ?tables.MAGICS[0], count: tables.MAGIC_COUNT}},
    read:     read_ops,
    write:    write_ops,
    dump:     dump_ops,
    kind:     kind_ops,
    stated:   stated_ops,
    locate:   locate,
    release:  release_ops,
};

# the sections that are not image content a COFF link takes
val USE_COUNT: usize                   = 3;
val USES:      [USE_COUNT]*consume.Row = [USE_COUNT]*consume.Row{?consume.SIGNIFICANCE, ?consume.STRINGS, ?consume.STACK};

val DECLARER_COUNT: usize                     = 1;
val DECLARERS:      [DECLARER_COUNT]*Declarer = [DECLARER_COUNT]*Declarer{?reserve.HEADER_TABLE};

val SYNTHESIZER_COUNT: usize                               = 1;
val SYNTHESIZERS:      [SYNTHESIZER_COUNT]*synthesizer.Row = [SYNTHESIZER_COUNT]*synthesizer.Row{?common.ROW};

# link.exe searches every archive again while a name is left undefined. whether
# a common definition pulls a member that defines its name as data is not
# verified, so the row leaves it off. an undefined weak reference takes its
# fallback. COFF inputs hold no merged strings, so no tails are shared
val LINKING: Linking = Linking{
    caps:         0,
    search:       resolve.REVISIT,
    hooks:        ?resolve.PLAIN,
    weak:         Weak.fallback{},
    folds:        fold.NONE,
    layout:       opt[*layout.Rules].some{?coff_convention.LAYOUT},
    tails:        false,
    dynamic:      ?coff_convention.DYNAMIC,
    facts:        ?coff_convention.FACTS,
    writer:       opt[*Writer].some{?coff_image.WRITER},
    declarers:    Declarers{rows: ?DECLARERS[0], count: DECLARER_COUNT},
    measures:     coff_image.MEASURES,
    uses:         consume.Uses{rows: ?USES[0], count: USE_COUNT},
    synthesizers: Synthesizers{rows: ?SYNTHESIZERS[0], count: SYNTHESIZER_COUNT},
};

pub val REGISTRATION: Registration = Registration{
    format:         ?format.COFF,
    codec:          opt[*Codec].some{?CODEC},
    traits:         opt[*TraitCodec].some{?contract.NO_TRAITS},
    naming:         opt[*Naming].some{?naming.NAMING},
    neutral:        opt[*Neutral].some{?NEUTRAL},
    lowering:       opt[*Lowering].some{?neutral.LOWERING},
    pairs:          ?pairs.PAIRS[0],
    pair_count:     pairs.COUNT,
    link:           opt[*Linking].some{?LINKING},
    revisions:      ?REVISIONS[0],
    revision_count: REVISION_COUNT,
    fields:         ?coff_dump.FIELDS[0],
    field_count:    coff_dump.FIELD_COUNT,
    reference:      opt[Reference].some{Reference{flags: ?REFERENCE_FLAGS[0], count: REFERENCE_FLAG_COUNT}},
};

# a parsed file moved to the heap, which the registration hands around as a
# pointer
fun boxed(a: *A.Allocator, m: Parsed) res[ptr, Fail] {
    val p: res[*Parsed, A.Error] = A.allocate[Parsed](a, 1);
    if (sel p.err) {
        var dead:    Parsed    = m;
        val dropped: err[Fail] = release_parsed(?dead);
        ret res[ptr, Fail].err{fail.refused(p.err)};
    }
    val mp: *Parsed = p.ok;
    @mp = m;
    ret res[ptr, Fail].ok{mp::ptr};
}

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val r: res[Parsed, Fail] = read.read(a, in);
    if (sel r.err) { ret res[ptr, Fail].err{r.err}; }
    ret boxed(a, r.ok);
}

# a short import object has no neutral form, as it is no object to link but
# the record of one import
fun to_neutral_ops(m: ptr, rows: *row.Registry, o: *Object) err[Fail] {
    val p: *Parsed = m::*Parsed;
    if (sel p.object) { ret neutral.to_neutral(?p.object, rows, o); }
    ret err[Fail].err{fail.unsupported("a short import object has no neutral form")};
}

fun from_neutral_ops(a: *A.Allocator, rows: *row.Registry, o: *Object, t: *Target, l: opt[*Lowering]) res[ptr, Fail] {
    val m: res[model.Coff, Fail] = neutral.from_neutral(a, rows, o, t, l);
    if (sel m.err) { ret res[ptr, Fail].err{m.err}; }
    ret boxed(a, Parsed.object{m.ok});
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret write.write_parsed(a, m::*Parsed);
}

fun dump_ops(m: ptr, rows: *row.Registry, d: *Dumper) err[Fail] {
    ret coff_dump.describe_parsed(m::*Parsed, d);
}

fun kind_ops(m: ptr) res[*Kind, Fail] {
    ret coff_kind.of(m::*Parsed);
}

# the machine of the file header, or of a short import object's header
fun stated_ops(m: ptr) opt[Stated] {
    val p: *Parsed = m::*Parsed;
    if (sel p.object) { ret opt[Stated].some{model.stated(p.object.header.machine)}; }
    or (sel p.short)  { ret opt[Stated].some{model.stated(p.short.machine)}; }
}

# where the byte lies, from the layout of the extents
fun locate(m: ptr, offset: u64) Location {
    ret place.locate_parsed(m::*Parsed, offset);
}

fun release_ops(a: *A.Allocator, m: ptr) err[Fail] {
    val pp: *Parsed      = m::*Parsed;
    val r:  err[Fail]    = release_parsed(pp);
    val d:  err[A.Error] = A.deallocate[Parsed](a, pp, 1);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}

# give back what the model read as `p` owns
fun release_parsed(p: *Parsed) err[Fail] {
    if (sel p.object) { ret model.release(?p.object); }
    or (sel p.short)  { ret import.release(?p.short); }
}

# each catalog subsystem and the optional header constant it writes
rec SubsystemCode {
    row:      *Subsystem;
    constant: *tables.Constant;
}

val SUBSYSTEM_CODE_COUNT: usize                               = 10;
val SUBSYSTEM_CODES:      [SUBSYSTEM_CODE_COUNT]SubsystemCode = [SUBSYSTEM_CODE_COUNT]SubsystemCode{
    SubsystemCode{row: ?subsystem.NATIVE, constant: ?tables.IMAGE_SUBSYSTEM_NATIVE},
    SubsystemCode{row: ?subsystem.WINDOWS, constant: ?tables.IMAGE_SUBSYSTEM_WINDOWS_GUI},
    SubsystemCode{row: ?subsystem.CONSOLE, constant: ?tables.IMAGE_SUBSYSTEM_WINDOWS_CUI},
    SubsystemCode{row: ?subsystem.POSIX, constant: ?tables.IMAGE_SUBSYSTEM_POSIX_CUI},
    SubsystemCode{row: ?subsystem.EFI_APPLICATION, constant: ?tables.IMAGE_SUBSYSTEM_EFI_APPLICATION},
    SubsystemCode{row: ?subsystem.EFI_BOOT_SERVICE_DRIVER, constant: ?tables.IMAGE_SUBSYSTEM_EFI_BOOT_SERVICE_DRIVER},
    SubsystemCode{row: ?subsystem.EFI_RUNTIME_DRIVER, constant: ?tables.IMAGE_SUBSYSTEM_EFI_RUNTIME_DRIVER},
    SubsystemCode{row: ?subsystem.EFI_ROM, constant: ?tables.IMAGE_SUBSYSTEM_EFI_ROM},
    SubsystemCode{row: ?subsystem.XBOX, constant: ?tables.IMAGE_SUBSYSTEM_XBOX},
    SubsystemCode{row: ?subsystem.BOOT_APPLICATION, constant: ?tables.IMAGE_SUBSYSTEM_WINDOWS_BOOT_APPLICATION},
};

test coff__each_catalog_subsystem_writes_its_optional_header_constant {
    if (subsystem.count() != SUBSYSTEM_CODE_COUNT) { ret 1; }
    var i: usize = 0;
    for (i < subsystem.count()) {
        val row:  *Subsystem = subsystem.at(i);
        var seen: usize      = 0;
        var k:    usize      = 0;
        for (k < SUBSYSTEM_CODE_COUNT) {
            if (SUBSYSTEM_CODES[k].row == row) {
                seen = seen + 1;
                if (row.number::u64 != SUBSYSTEM_CODES[k].constant.value) { ret 3; }
            }
            k = k + 1;
        }
        if (seen != 1) { ret 2; }
        i = i + 1;
    }
    ret 0;
}
