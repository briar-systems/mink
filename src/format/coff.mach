# the COFF format
#
# the exact revision of each specification the COFF modules implement, so a
# change to any of them is a visible version bump. one registration covers the
# regular object, the bigobj, the PE image and the short import object, which the
# reader returns as its own record and the registration models alongside the others.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.bytes.sink.Sink;
use mink.catalog.format;
use mink.catalog.kind.Kind;
use mink.catalog.merge;
use coff_dump: mink.format.coff.dump;
use mink.format.coff.import.import;
use coff_kind: mink.format.coff.model.kind;
use mink.format.coff.model.model;
use mink.format.coff.model.place;
use mink.format.coff.model.tables;
use mink.format.coff.read;
use mink.format.coff.read.Parsed;
use coff_convention: mink.format.coff.rules.convention;
use mink.format.contract.Codec;
use mink.format.contract.Identify;
use mink.format.contract.Input;
use mink.format.contract.Magics;
use mink.format.contract.Reference;
use mink.format.contract.Revision;
use mink.format.dump.Dumper;
use mink.format.registration.Registration;
use mink.link.common;
use mink.link.consume;
use mink.link.linking.Linking;
use mink.link.linking.Synthesizers;
use mink.link.relocate.Weak;
use mink.link.reserve;
use mink.link.reserve.Declarer;
use mink.link.reserve.Declarers;
use mink.link.resolve;
use mink.link.synthesizer;

pub val REVISION_COUNT: usize = 2;

pub val REVISIONS: [REVISION_COUNT]Revision = [REVISION_COUNT]Revision{
    Revision{spec: "Microsoft PE Format, with the ARM64 and ARM64EC additions", revision: "page of 10 September 2026"},
    Revision{spec: "Windows SDK winnt.h layouts (IMAGE_LOAD_CONFIG_DIRECTORY32 and 64, IMAGE_ARM64EC_METADATA, IMAGE_CHPE_METADATA_X86), as mirrored by Wine include/winnt.h", revision: "Wine commit d38598c894f6 of 27 August 2026"},
};

# the llvm-readobj flags for the directories and tables the dump prints
val REFERENCE_FLAG_COUNT: usize                     = 6;
val REFERENCE_FLAGS:      [REFERENCE_FLAG_COUNT]str = [REFERENCE_FLAG_COUNT]str{
    "--coff-imports", "--coff-basereloc", "--coff-debug-directory",
    "--coff-tls-directory", "--coff-load-config", "--coff-resources",
};

val CODEC: Codec = Codec{
    identify: Identify.magics{Magics{rows: ?tables.MAGICS[0], count: tables.MAGIC_COUNT}},
    read:     read_ops,
    write:    write_ops,
    dump:     dump_ops,
    kind:     kind_ops,
    locate:   locate,
    release:  release_ops,
};

# the sections that are not image content a COFF link takes
val USE_COUNT: usize                   = 3;
val USES:      [USE_COUNT]*consume.Row = [USE_COUNT]*consume.Row{?consume.SIGNIFICANCE, ?consume.STRINGS, ?consume.STACK};

val DECLARER_COUNT: usize                     = 1;
val DECLARERS:      [DECLARER_COUNT]*Declarer = [DECLARER_COUNT]*Declarer{?reserve.HEADER_TABLE};

val SYNTHESIZER_COUNT: usize                               = 1;
val SYNTHESIZERS:      [SYNTHESIZER_COUNT]*synthesizer.Row = [SYNTHESIZER_COUNT]*synthesizer.Row{?common.ROW};

# link.exe searches every archive again while a name is left undefined. whether
# a common definition pulls a member that defines its name as data is not
# verified, so the row leaves it off. an undefined weak reference takes its
# fallback. no image writer is built yet
val LINKING: Linking = Linking{
    caps:         0,
    search:       resolve.REVISIT,
    hooks:        ?resolve.PLAIN,
    weak:         Weak.fallback{},
    layout:       ?coff_convention.LAYOUT,
    dynamic:      ?coff_convention.DYNAMIC,
    facts:        ?merge.NONE,
    declarers:    Declarers{rows: ?DECLARERS[0], count: DECLARER_COUNT},
    measures:     coff_convention.MEASURES,
    uses:         consume.Uses{rows: ?USES[0], count: USE_COUNT},
    synthesizers: Synthesizers{rows: ?SYNTHESIZERS[0], count: SYNTHESIZER_COUNT},
};

# no relocation rows are built for the format yet, so it states no pair
pub val REGISTRATION: Registration = Registration{
    format:         ?format.COFF,
    codec:          opt[*Codec].some{?CODEC},
    link:           opt[*Linking].some{?LINKING},
    revisions:      ?REVISIONS[0],
    revision_count: REVISION_COUNT,
    fields:         ?coff_dump.FIELDS[0],
    field_count:    coff_dump.FIELD_COUNT,
    reference:      opt[Reference].some{Reference{flags: ?REFERENCE_FLAGS[0], count: REFERENCE_FLAG_COUNT}},
};

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val r: res[Parsed, Fail] = read.read(a, in);
    if (sel r.err) { ret res[ptr, Fail].err{r.err}; }
    val p: res[*Parsed, A.Error] = A.allocate[Parsed](a, 1);
    if (sel p.err) { ret res[ptr, Fail].err{fail.refused(p.err)}; }
    val mp: *Parsed = p.ok;
    @mp = r.ok;
    ret res[ptr, Fail].ok{mp::ptr};
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret res[Sink, Fail].err{fail.unsupported("the PE/COFF writer is not built")};
}

fun dump_ops(m: ptr, d: *Dumper) err[Fail] {
    ret coff_dump.describe_parsed(m::*Parsed, d);
}

fun kind_ops(m: ptr) res[*Kind, Fail] {
    ret coff_kind.of(m::*Parsed);
}

# where the byte lies, from the layout of the extents
fun locate(m: ptr, offset: u64) Location {
    ret place.locate_parsed(m::*Parsed, offset);
}

fun release_ops(a: *A.Allocator, m: ptr) err[Fail] {
    val pp: *Parsed      = m::*Parsed;
    val r:  err[Fail]    = release_parsed(pp);
    val d:  err[A.Error] = A.deallocate[Parsed](a, pp, 1);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}

# give back what the model read as `p` owns
fun release_parsed(p: *Parsed) err[Fail] {
    if (sel p.object) { ret model.release(?p.object); }
    or (sel p.short)  { ret import.release(?p.short); }
}
