# one registration per format, its only footprint outside its own module
#
# a format module declares its rows: its codec, its neutral conversion, its
# container operations, its lowering and its pairs. its registration, in
# format/<f>.mach, names those rows, and the registry lists the
# registrations, one line each. how a format links is the link's own row,
# keyed by format in mink.link.formats, so nothing here names the link.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail.Fail;
use mink.catalog.arch.Arch;
use mink.catalog.format.Format;
use mink.format.ar.write.Variant;
use mink.format.contract.Naming;
use mink.format.contract.Neutral;
use mink.format.contract.Reader;
use mink.format.contract.Revision;
use mink.format.contract.TraitCodec;
use mink.format.pair;
use mink.format.pair.Pair;
use mink.lower.Lowering;

# format:         the format's identity
# reader:         how it reads, writes, dumps and converts its files, none for
#                 a format mink only writes
# traits:         how it encodes the trait axes an object states, none for a
#                 format with no objects
# naming:         how it names sections, none for a format with no sections
# pairs:          what it states for each architecture it names
# pair_count:     how many
# archive:        the variant a static library of its objects is written in,
#                 none for a format whose objects mink archives in no variant.
#                 a format that links as another states none, its objects
#                 being that format's
# revisions:      the specifications it implements, at their exact revision
# revision_count: how many
pub rec Registration {
    format:         *Format;
    reader:         opt[*Reader];
    traits:         opt[*TraitCodec];
    naming:         opt[*Naming];
    pairs:          *Pair;
    pair_count:     usize;
    archive:        opt[*Variant];
    revisions:      *Revision;
    revision_count: usize;
}

# how the format converts its objects to neutral objects and back, none for
# a format with no objects or no conversion built
pub fun neutral(r: *Registration) opt[*Neutral] {
    val rd: opt[*Reader] = r.reader;
    if (sel rd.none) { ret opt[*Neutral].none{}; }
    ret rd.some.neutral;
}

# the encodings the format writes the records a neutral object states in,
# none for a format with no encoding of them
pub fun lowering(r: *Registration) opt[*Lowering] {
    val rd: opt[*Reader] = r.reader;
    if (sel rd.none) { ret opt[*Lowering].none{}; }
    ret rd.some.lowering;
}

# the pair of `a`, refused when the format states nothing for it
pub fun pair_of(r: *Registration, a: *Arch) res[*Pair, Fail] {
    ret pair.of(r.format, r.pairs, r.pair_count, a);
}
