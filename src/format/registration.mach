# one registration per format, its only footprint outside its own module
#
# a format module declares its rows below the link: its codec, its neutral
# conversion, its container operations, its lowering and its pairs. its
# registration, in format/<f>.mach, names those rows with how the format
# links, and the registry lists the registrations, one line each. the
# registration sits above the link phases, since its linking row is typed by
# them, so a model and every phase hold the rows it names and never the
# registration itself.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.catalog.arch.Arch;
use mink.catalog.format.Format;
use mink.format.contract;
use mink.format.contract.Codec;
use mink.format.contract.Container;
use mink.format.contract.Lowering;
use mink.format.contract.Naming;
use mink.format.contract.Neutral;
use mink.format.contract.Reader;
use mink.format.contract.Reference;
use mink.format.contract.Revision;
use mink.format.contract.TraitCodec;
use mink.format.pair;
use mink.format.pair.Pair;
use mink.link.linking.Linking;
use mink.model.object.Object;

# format:         the format's identity
# codec:          how it reads, writes and dumps its files, none for a format
#                 mink only writes
# neutral:        how it converts its objects to neutral objects and back, none
#                 for a format with no objects or no conversion built
# container:      the member operations of a format whose files hold other
#                 files, none for the rest
# traits:         how it encodes the trait axes an object states, none for a
#                 format with no objects
# naming:         how it names sections, none for a format with no sections
# lowering:       how it encodes the records a neutral object states, none for
#                 a format with no encoding of them
# pairs:          what it states for each architecture it names
# pair_count:     how many
# link:           how it links, none for a format mink links no image of
# revisions:      the specifications it implements, at their exact revision
# revision_count: how many
# fields:         the names its dump prints, indexed by the module's own field
#                 keys
# field_count:    how many
# reference:      the reference flags the format's dump is compared with, none
#                 for a format compared with the common flags alone
pub rec Registration {
    format:         *Format;
    codec:          opt[*Codec];
    neutral:        opt[*Neutral];
    container:      opt[*Container];
    traits:         opt[*TraitCodec];
    naming:         opt[*Naming];
    lowering:       opt[*Lowering];
    pairs:          *Pair;
    pair_count:     usize;
    link:           opt[*Linking];
    revisions:      *Revision;
    revision_count: usize;
    fields:         *str;
    field_count:    usize;
    reference:      opt[Reference];
}

# what reading the format's files takes, none for a format mink only writes
pub fun reader_of(r: *Registration) opt[Reader] {
    if (sel r.codec.none) { ret opt[Reader].none{}; }
    ret opt[Reader].some{Reader{format: r.format, codec: r.codec.some, neutral: r.neutral, container: r.container, fields: r.fields, field_count: r.field_count}};
}

# the pair of `a`, refused when the format states nothing for it
pub fun pair_of(r: *Registration, a: *Arch) res[*Pair, Fail] {
    ret pair.of(r.format, r.pairs, r.pair_count, a);
}

# how the format links, refused for a format mink links no image of
pub fun linking(r: *Registration) res[*Linking, Fail] {
    if (sel r.link.none) { ret res[*Linking, Fail].err{fail.in_record(fail.unsupported("the format has no linking rules"), r.format.name)}; }
    ret res[*Linking, Fail].ok{r.link.some};
}

# lower the records `o` states in place in the format's encoding
pub fun lower(r: *Registration, o: *Object) err[Fail] {
    ret contract.lower(r.format, r.lowering, o);
}
