# a bounded cursor over a byte span
#
# every read is checked against the span's end and a read past it is a
# truncated failure at the absolute offset it was asked for. the reader knows
# nothing of any format: endianness is a parameter, not a type.

use std.encoding.binary;
use std.encoding.leb128;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;

pub def Order: binary.Order;
pub val LITTLE: Order = binary.LITTLE;
pub val BIG:    Order = binary.BIG;

# file:  the input's name, carried into every failure
# data:  the span's first byte
# len:   the span's length
# pos:   the next byte to read, relative to data
# base:  the absolute offset of data in the file
# order: the byte order of multi-byte reads
pub rec Reader {
    file:  str;
    data:  *u8;
    len:   usize;
    pos:   usize;
    base:  u64;
    order: Order;
}

pub fun make(file: str, data: *u8, len: usize, order: Order) Reader {
    ret Reader{file: file, data: data, len: len, order: order};
}

# the absolute offset of the next byte
pub fun offset(r: *Reader) u64 {
    ret r.base + r.pos::u64;
}

# the location of the next byte
pub fun here(r: *Reader) Location {
    ret Location{file: r.file, offset: offset(r), placed: true};
}

pub fun remaining(r: *Reader) usize {
    ret r.len - r.pos;
}

# move to `pos` in the span, which may be its end
pub fun seek(r: *Reader, pos: u64) res[usize, Fail] {
    if (pos > r.len::u64) { ret res[usize, Fail].err{past(r, pos)}; }
    r.pos = pos::usize;
    ret res[usize, Fail].ok{r.pos};
}

# the `n` bytes at `pos` as a reader of their own, reporting absolute offsets
pub fun sub(r: *Reader, pos: u64, n: u64) res[Reader, Fail] {
    if (pos > r.len::u64 || n > r.len::u64 - pos) { ret res[Reader, Fail].err{past(r, pos)}; }
    var out: Reader = @r;
    out.data = ?r.data[pos::usize];
    out.len  = n::usize;
    out.pos  = 0;
    out.base = r.base + pos;
    ret res[Reader, Fail].ok{out};
}

# the next `n` bytes, borrowed from the span
pub fun bytes(r: *Reader, n: u64) res[*u8, Fail] {
    val g: res[usize, Fail] = take(r, n);
    if (sel g.err) { ret res[*u8, Fail].err{g.err}; }
    ret res[*u8, Fail].ok{?r.data[g.ok]};
}

pub fun u8(r: *Reader) res[u8, Fail] {
    val v: res[u64, Fail] = uint(r, 1);
    if (sel v.err) { ret res[u8, Fail].err{v.err}; }
    ret res[u8, Fail].ok{v.ok::u8};
}

pub fun u16(r: *Reader) res[u16, Fail] {
    val v: res[u64, Fail] = uint(r, 2);
    if (sel v.err) { ret res[u16, Fail].err{v.err}; }
    ret res[u16, Fail].ok{v.ok::u16};
}

pub fun u32(r: *Reader) res[u32, Fail] {
    val v: res[u64, Fail] = uint(r, 4);
    if (sel v.err) { ret res[u32, Fail].err{v.err}; }
    ret res[u32, Fail].ok{v.ok::u32};
}

pub fun u64(r: *Reader) res[u64, Fail] {
    ret uint(r, 8);
}

# an unsigned integer of `size` bytes, 1 to 8, in the reader's order
pub fun uint(r: *Reader, size: usize) res[u64, Fail] {
    val g: res[usize, Fail] = take(r, size::u64);
    if (sel g.err) { ret res[u64, Fail].err{g.err}; }
    ret res[u64, Fail].ok{binary.get_uint(?r.data[g.ok], size, r.order)};
}

pub fun uleb(r: *Reader) res[u64, Fail] {
    val at: u64                                = offset(r);
    val v:  res[leb128.Unsigned, leb128.Error] = leb128.get_unsigned(?r.data[r.pos], remaining(r));
    if (sel v.err) { ret res[u64, Fail].err{leb_fail(r, at, v.err)}; }
    r.pos = r.pos + v.ok.size;
    ret res[u64, Fail].ok{v.ok.value};
}

pub fun sleb(r: *Reader) res[i64, Fail] {
    val at: u64                              = offset(r);
    val v:  res[leb128.Signed, leb128.Error] = leb128.get_signed(?r.data[r.pos], remaining(r));
    if (sel v.err) { ret res[i64, Fail].err{leb_fail(r, at, v.err)}; }
    r.pos = r.pos + v.ok.size;
    ret res[i64, Fail].ok{v.ok.value};
}

# claim the next `n` bytes, returning the position of the first
fun take(r: *Reader, n: u64) res[usize, Fail] {
    if (n > remaining(r)::u64) { ret res[usize, Fail].err{past(r, r.pos::u64)}; }
    val at: usize = r.pos;
    r.pos = r.pos + n::usize;
    ret res[usize, Fail].ok{at};
}

# a read at span position `pos` that runs past the end
fun past(r: *Reader, pos: u64) Fail {
    ret fail.at_offset(fail.in_file(fail.truncated("read past the end of the data"), r.file), r.base + pos);
}

fun leb_fail(r: *Reader, at: u64, e: leb128.Error) Fail {
    var f: Fail = fail.malformed("LEB128 value exceeds 64 bits");
    if (sel e.short) { f = fail.truncated("read past the end of the data"); }
    ret fail.at_offset(fail.in_file(f, r.file), at);
}

test reader__reads_both_orders_and_refuses_past_end {
    val data: [6]u8  = [6]u8{0x12, 0x34, 0x56, 0x78, 0xe5, 0x8e};
    var le:   Reader = make("a.o", ?data[0], 6, LITTLE);
    le.base = 0x100;
    val a: res[u32, Fail] = u32(?le);
    if (sel a.err)          { ret 1; }
    if (a.ok != 0x78563412) { ret 1; }
    var be: Reader         = make("a.o", ?data[0], 6, BIG);
    val b:  res[u16, Fail] = u16(?be);
    if (sel b.err)      { ret 1; }
    if (b.ok != 0x1234) { ret 1; }
    val past_end: res[u32, Fail] = u32(?le);
    if (sel past_end.ok)                   { ret 1; }
    if (!sel past_end.err.cause.truncated) { ret 1; }
    if (past_end.err.at.offset != 0x104)   { ret 1; }
    if (le.pos != 4)                       { ret 1; }
    ret 0;
}
