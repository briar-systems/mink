# the encodings a format lowers a neutral object's records in
#
# a producer states records on the neutral object, line sequences and frames,
# and the format the object is written or linked as encodes them as sections
# of bytes and relocations, as line and frame tables are tied to the final
# offsets of the code and a linker consumes and rewrites them. a format's
# registration names its row here, which encoding of each kind of record it
# writes, and its conversion and the link read the row, never the format's
# identity. the modules under src/lower own the bytes of each encoding, and
# lower.encode picks the one the row names. a format's row offers frames one
# or more destinations, and an object states which of them its frames lower
# to. debugging content that is not tied to code offsets, such as DWARF info
# or CodeView symbols, is the producer's own sections and no record here.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.lower.unwind.anchor.Anchor;
use mink.lower.unwind.pointer;
use mink.model.frame;
use mink.model.object.Object;
use mink.model.section;

# a DWARF line table
# ---
# version: the DWARF version it is written in
# section: the name of the section that holds it
pub rec DwarfLine {
    version: u8;
    section: str;
}

# how a format writes line records
# ---
# dwarf:    a DWARF line table
# codeview: CodeView DEBUG_S_LINES subsections
pub tag LineForm: u8 {
    dwarf: DwarfLine;
    codeview;
}

# how an FDE names its CIE
# ---
# back:      the distance from the field back to the CIE, as .eh_frame does
# offset:    the CIE's offset in the section, a number
# relocated: the CIE's offset in the section, relocated from a label at the
#            CIE with the absolute kind of the field's 4 bytes, as ELF's
#            .debug_frame does
pub tag CieLink: u8 {
    back;
    offset;
    relocated;
}

# a DWARF call frame table, the row the one DWARF frame encoder writes every
# destination through
# ---
# section:     the name of the section that holds it
# kind:        the section's kind
# disposition: how garbage collection treats the section
# mapped:      whether the section's start takes the pair's mapping symbol
#              for data
# cie_id:      the id a CIE states in the place an FDE names its CIE
# version:     the version a CIE states. from version 4 on a CIE states the
#              address and segment selector sizes, and from version 3 on its
#              return address column is a ULEB128
# augmented:   whether a CIE states a `z` augmentation, which carries the
#              pointer encodings, a personality, an LSDA and a signal frame.
#              a table with none leaves the last three out, as only a
#              runtime unwinder reads them
# link:        how an FDE names its CIE
# pad:         the alignment of each CIE and FDE, padded with DW_CFA_nop
# encodings:   the DW_EH_PE codes the table writes and reads, the one owner
#              of the byte
# address:     how an FDE's start is written, and its length in the same
#              format relocated as a difference where it is not fixed
# personality: how a personality routine is written, none for a table that
#              writes none, which refuses a frame's when it has an
#              augmentation
# lsda:        how language specific data is written, none likewise
# anchor:      what an FDE's start is relocated from over fixed code
pub rec DwarfFrame {
    section:     str;
    kind:        *section.Kind;
    disposition: *section.Disposition;
    mapped:      bool;
    cie_id:      u32;
    version:     u8;
    augmented:   bool;
    link:        CieLink;
    pad:         pointer.Width;
    encodings:   *pointer.Encodings;
    address:     pointer.Field;
    personality: opt[pointer.Field];
    lsda:        opt[pointer.Field];
    anchor:      Anchor;
}

# a compact unwind table, one fixed entry per function, which a function its
# encodings cannot describe defers to an FDE of a DWARF table
# ---
# section:     the name of the section that holds it
# kind:        the section's kind
# disposition: how garbage collection treats the section
# fallback:    the DWARF table a function compact unwind cannot describe is
#              written to, a dwarf_eh or dwarf_debug form
# anchor:      what an entry's start is relocated from over fixed code
pub rec CompactTable {
    section:     str;
    kind:        *section.Kind;
    disposition: *section.Disposition;
    fallback:    *FrameForm;
    anchor:      Anchor;
}

# how a format writes frame records to one destination
# ---
# dwarf_eh:    DWARF call frame information for a runtime unwinder
# dwarf_debug: DWARF call frame information for a debugger
# win64:       UNWIND_INFO with .pdata function entries
# arm64_xdata: packed or full .xdata records with epilogue scopes
# compact:     compact unwind, a function it cannot describe written to the
#              DWARF table its row names
# windows:     a .pdata function table and .xdata unwind data, written in the
#              form, win64 or arm64_xdata, the machine's function table row
#              names
pub tag FrameForm: u8 {
    dwarf_eh:    DwarfFrame;
    dwarf_debug: DwarfFrame;
    win64;
    arm64_xdata;
    compact: CompactTable;
    windows;
}

# a destination a format offers an object's frames, and how it writes them
# there
pub rec FrameOffer {
    destination: *frame.Destination;
    form:        FrameForm;
}

# the destinations a format offers frame records
# ---
# offers:  each destination it offers, once each, static
# count:   how many
# default: where the frames of an object that states no destinations lower
#          to, each one offered
pub rec FrameTables {
    offers:  *FrameOffer;
    count:   usize;
    default: frame.Destinations;
}

# the encodings a format writes a neutral object's records in
# ---
# line:  how it writes line records, none for a format with no line table
# frame: where and how it writes frame records, none for a format with no
#        frame table
pub rec Lowering {
    line:  opt[LineForm];
    frame: opt[FrameTables];
}

# the offer `f` makes of the destination `d`, none when it offers none
pub fun offer(f: *FrameTables, d: *frame.Destination) opt[*FrameOffer] {
    var i: usize = 0;
    for (i < f.count) {
        if (f.offers[i].destination == d) { ret opt[*FrameOffer].some{?f.offers[i]}; }
        i = i + 1;
    }
    ret opt[*FrameOffer].none{};
}

# the destinations the frames of `o` lower to under `l`: the ones `o` states,
# or the format's default when it states none. a stated destination the
# format does not offer is refused naming it, as is one no row names
pub fun destinations(l: opt[*Lowering], o: *Object) res[frame.Destinations, Fail] {
    var tables: opt[*FrameTables] = opt[*FrameTables].none{};
    if (sel l.some) {
        if (sel l.some.frame.some) { tables = opt[*FrameTables].some{?l.some.frame.some}; }
    }
    val stated: opt[frame.Destinations] = o.frame_to;
    if (sel stated.some) { ret offered(tables, stated.some); }
    if (sel tables.some) { ret res[frame.Destinations, Fail].ok{tables.some.default}; }
    ret res[frame.Destinations, Fail].ok{frame.NOWHERE};
}

# `want`, when the format of the frame tables `tables` offers each of its
# destinations
fun offered(tables: opt[*FrameTables], want: frame.Destinations) res[frame.Destinations, Fail] {
    var known: frame.Destinations = frame.NOWHERE;
    var i:     usize              = 0;
    for (i < frame.DESTINATION_COUNT) {
        val d: *frame.Destination = frame.DESTINATIONS[i];
        i     = i + 1;
        known = frame.with(known, d);
        if (!frame.has(want, d)) { cnt; }
        if (sel tables.none)     { ret res[frame.Destinations, Fail].err{fail.about(fail.unsupported("the format has no frame table"), d.name)}; }
        val o: opt[*FrameOffer] = offer(tables.some, d);
        if (sel o.none) { ret res[frame.Destinations, Fail].err{fail.about(fail.unsupported("the format offers no such frame destination"), d.name)}; }
    }
    if ((want.bits & ~known.bits) != 0) {
        ret res[frame.Destinations, Fail].err{fail.valued(fail.malformed("the object states a frame destination no row names"), want.bits::i128)};
    }
    ret res[frame.Destinations, Fail].ok{want};
}
