# the ELF encoding of trait axes
#
# one row per trait axis ELF writes, keyed by the axis row of the trait
# catalog, giving where its value lives and the constant that encodes each
# value. a value lives in bits of e_flags or in bits of a GNU property whose
# data is one word, as the and and or feature properties are. the writer
# encodes an object's traits through these rows and the reader decodes them
# back, so a bit a row maps is the row's alone and is never also kept raw.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_compare;

use A: std.allocator;
use T: std.allocator.testing;

use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.format;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.elf.model;
use mink.elf.model.Elf;
use mink.elf.model.Note;
use mink.elf.model.Property;
use mink.elf.model.Section;
use mink.elf.tables;
use mink.elf.tables.Constant;
use mink.fail;
use mink.fail.Fail;
use mink.index;
use mink.reader;
use mink.reader.Reader;
use mink.store.Bytes;
use mink.table;
use mink.table.Table;

# what the writer does with an object that states nothing on an axis
# ---
# refuse: the file has no way to leave the axis unstated, because no bits
#         read back as one of its values
# omit:   no bits are written, which reads back as a clear flag
pub tag Absent: u8 {
    refuse;
    omit;
}

# bits of the one-word data of the GNU property of type `type`
pub rec Bits {
    type: *Constant;
    mask: u64;
}

# where an axis's value lives in the file
# ---
# flags:    the bits of e_flags under this mask
# property: bits of a GNU property. a file without the property holds none
#           of them
pub tag Field: u8 {
    flags:    u64;
    property: Bits;
}

# a value of an axis and the constant whose bits encode it
pub rec Code {
    setting: Setting;
    value:   *Constant;
}

# axis:   the trait axis
# field:  where its value lives
# codes:  the encoding of each value. a flag lists only its set value, and is
#         clear when none of its bits are set
# count:  how many
# absent: what the writer does when the axis is not stated
pub rec Encoding {
    axis:   *Axis;
    field:  Field;
    codes:  *Code;
    count:  usize;
    absent: Absent;
}

# a GNU property whose data is one word
pub rec Word {
    type:  u32;
    value: u32;
}

# the parts of a file the rows encode into
# ---
# flags:      e_flags
# properties: the GNU properties of one word, in the order of their types
pub rec Words {
    flags:      u32;
    properties: Table[Word];
}

val RISCV_FLOAT_ABI_CODES: [4]Code = [4]Code{
    Code{setting: Setting.choice{?arch.RISCV_SOFT}, value: ?tables.EF_RISCV_FLOAT_ABI_SOFT},
    Code{setting: Setting.choice{?arch.RISCV_SINGLE}, value: ?tables.EF_RISCV_FLOAT_ABI_SINGLE},
    Code{setting: Setting.choice{?arch.RISCV_DOUBLE}, value: ?tables.EF_RISCV_FLOAT_ABI_DOUBLE},
    Code{setting: Setting.choice{?arch.RISCV_QUAD}, value: ?tables.EF_RISCV_FLOAT_ABI_QUAD},
};
val RISCV_RVC_CODES:   [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.EF_RISCV_RVC}};
val RISCV_RVE_CODES:   [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.EF_RISCV_RVE}};
val RISCV_TSO_CODES:   [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.EF_RISCV_TSO}};
val AARCH64_BTI_CODES: [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.GNU_PROPERTY_AARCH64_FEATURE_1_BTI}};
val AARCH64_PAC_CODES: [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.GNU_PROPERTY_AARCH64_FEATURE_1_PAC}};

val RISCV_FLOAT_ABI_ROW: Encoding = Encoding{axis: ?arch.RISCV_FLOAT_ABI, field: Field.flags{tables.EF_RISCV_FLOAT_ABI.value}, codes: ?RISCV_FLOAT_ABI_CODES[0], count: 4, absent: Absent.refuse{}};
val RISCV_RVC_ROW:       Encoding = Encoding{axis: ?arch.RISCV_RVC, field: Field.flags{tables.EF_RISCV_RVC.value}, codes: ?RISCV_RVC_CODES[0], count: 1, absent: Absent.omit{}};
val RISCV_RVE_ROW:       Encoding = Encoding{axis: ?arch.RISCV_RVE, field: Field.flags{tables.EF_RISCV_RVE.value}, codes: ?RISCV_RVE_CODES[0], count: 1, absent: Absent.omit{}};
val RISCV_TSO_ROW:       Encoding = Encoding{axis: ?arch.RISCV_TSO, field: Field.flags{tables.EF_RISCV_TSO.value}, codes: ?RISCV_TSO_CODES[0], count: 1, absent: Absent.omit{}};
val AARCH64_BTI_ROW:     Encoding = Encoding{
    axis:   ?arch.AARCH64_BTI,
    field:  Field.property{Bits{type: ?tables.GNU_PROPERTY_AARCH64_FEATURE_1_AND, mask: tables.GNU_PROPERTY_AARCH64_FEATURE_1_BTI.value}},
    codes:  ?AARCH64_BTI_CODES[0],
    count:  1,
    absent: Absent.omit{},
};
val AARCH64_PAC_ROW: Encoding = Encoding{
    axis:   ?arch.AARCH64_PAC,
    field:  Field.property{Bits{type: ?tables.GNU_PROPERTY_AARCH64_FEATURE_1_AND, mask: tables.GNU_PROPERTY_AARCH64_FEATURE_1_PAC.value}},
    codes:  ?AARCH64_PAC_CODES[0],
    count:  1,
    absent: Absent.omit{},
};

val ROW_COUNT: usize                = 6;
val ROWS:      [ROW_COUNT]*Encoding = [ROW_COUNT]*Encoding{?RISCV_FLOAT_ABI_ROW, ?RISCV_RVC_ROW, ?RISCV_RVE_ROW, ?RISCV_TSO_ROW, ?AARCH64_BTI_ROW, ?AARCH64_PAC_ROW};
# the rows by axis name
val AXES: [ROW_COUNT]*Encoding = [ROW_COUNT]*Encoding{?AARCH64_BTI_ROW, ?AARCH64_PAC_ROW, ?RISCV_FLOAT_ABI_ROW, ?RISCV_RVC_ROW, ?RISCV_RVE_ROW, ?RISCV_TSO_ROW};

fun order_axes(a: **Encoding, b: **Encoding) i64 {
    ret str_compare(a[0].axis.name, b[0].axis.name);
}

# the row of `x`, none where ELF has no encoding for it
pub fun encoding_of(x: *Axis) opt[*Encoding] {
    var probe: Encoding       = Encoding{axis: x};
    val row:   opt[*Encoding] = index.find[Encoding](?AXES[0], ROW_COUNT, ?probe, order_axes);
    if (sel row.some && row.some.axis == x) { ret row; }
    ret opt[*Encoding].none{};
}

# the bits of its field the row owns
pub fun mask(e: *Encoding) u64 {
    if (sel e.field.flags) { ret e.field.flags; }
    ret e.field.property.mask;
}

# the architecture of `m`, by its machine and class
pub fun arch_of(m: *Elf) res[*Arch, Fail] {
    var cls: u64 = tables.ELFCLASS32.value::u64;
    if (m.shape.class.addr == 8) { cls = tables.ELFCLASS64.value::u64; }
    ret arch.by_code(?format.ELF, m.header.machine::u32, cls::u32);
}

# add to `out` e_flags and every GNU property of `m` whose data is one word,
# the parts of the file the rows read. a property of another size holds no
# trait and is not added
pub fun words_of(m: *Elf, out: *Words) err[Fail] {
    out.flags = m.header.flags;
    var i: usize = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = model.section_at(m, table.nth[Section](i));
        i = i + 1;
        if (!sel s.body.notes) { cnt; }
        var k: usize = 0;
        for (k < table.count[Note](?s.body.notes)) {
            val n: *Note = table.at[Note](?s.body.notes, table.nth[Note](k));
            k = k + 1;
            if (!sel n.desc.properties) { cnt; }
            val r: err[Fail] = property_words(m, ?n.desc.properties, out);
            if (sel r.err) { ret r; }
        }
    }
    ret err[Fail].ok{};
}

fun property_words(m: *Elf, t: *Table[Property], out: *Words) err[Fail] {
    var j: usize = 0;
    for (j < table.count[Property](t)) {
        val p: *Property = table.at[Property](t, table.nth[Property](j));
        j = j + 1;
        if (p.datasz != 4) { cnt; }
        val data: Bytes          = model.bytes(m, ?p.data);
        var rd:   Reader         = reader.make(nil, data.data, data.len, m.shape.order);
        val v:    res[u32, Fail] = reader.u32(?rd);
        if (sel v.err) { ret err[Fail].err{v.err}; }
        val added: err[Fail] = add_word(out, Word{type: p.type, value: v.ok});
        if (sel added.err) { ret added; }
    }
    ret err[Fail].ok{};
}

pub fun make_words(a: *A.Allocator, flags: u32) Words {
    ret Words{flags: flags, properties: table.make[Word](a)};
}

pub fun release_words(w: *Words) err[Fail] {
    ret table.release[Word](?w.properties);
}

fun order_words(a: *Word, b: *Word) i64 {
    if (a.type < b.type) { ret -1; }
    if (a.type > b.type) { ret 1; }
    ret 0;
}

fun word_at(w: *Words, type: u32) SearchPosition {
    var probe: Word = Word{type: type};
    ret sort.binary_search_by[Word](table.items[Word](?w.properties), table.count[Word](?w.properties), ?probe, order_words);
}

# the property of `type` in `w`, none when the file has none
pub fun word(w: *Words, type: u32) opt[*Word] {
    val at: SearchPosition = word_at(w, type);
    if (sel at.found) { ret opt[*Word].some{table.at[Word](?w.properties, table.nth[Word](at.found))}; }
    ret opt[*Word].none{};
}

# add the property `p` the file holds, refusing a type it holds twice
pub fun add_word(w: *Words, p: Word) err[Fail] {
    val at: SearchPosition = word_at(w, p.type);
    if (sel at.found) { ret err[Fail].err{fail.valued(fail.malformed("a GNU property type is held twice"), p.type::i128)}; }
    ret table.insert[Word](?w.properties, at.insertion, p);
}

# the bits of `w` in the row's field
pub fun bits_in(e: *Encoding, w: *Words) u64 {
    if (sel e.field.flags) { ret w.flags::u64 & e.field.flags; }
    val p: opt[*Word] = word(w, e.field.property.type.value::u32);
    if (sel p.some) { ret p.some.value::u64 & e.field.property.mask; }
    ret 0;
}

# the code whose bits are `bits`, none when no code of the row has them
pub fun held(e: *Encoding, bits: u64) opt[*Code] {
    var i: usize = 0;
    for (i < e.count) {
        if (e.codes[i].value.value == bits) { ret opt[*Code].some{?e.codes[i]}; }
        i = i + 1;
    }
    ret opt[*Code].none{};
}

# what the field bits `bits` state on the row's axis, none when they hold no
# value the row maps
pub fun decoded(e: *Encoding, bits: u64) opt[Setting] {
    val c: opt[*Code] = held(e, bits);
    if (sel c.some)               { ret opt[Setting].some{c.some.setting}; }
    if (e.axis.flag && bits == 0) { ret opt[Setting].some{Setting.flag{false}}; }
    ret opt[Setting].none{};
}

# the bits that encode `s`, none where the row lists no code for it. a clear
# flag is encoded as no bits
fun bits_of(e: *Encoding, s: Setting) opt[u64] {
    var i: usize = 0;
    for (i < e.count) {
        if (trait.same(e.codes[i].setting, s)) { ret opt[u64].some{e.codes[i].value.value}; }
        i = i + 1;
    }
    if (sel s.flag && !s.flag) { ret opt[u64].some{0}; }
    ret opt[u64].none{};
}

# what encoding `x` writes, none for nothing, or the refusal
fun encoded(a: *Arch, ts: *Table[Trait], w: *Words, x: *Axis) res[opt[u64], Fail] {
    val e: opt[*Encoding] = encoding_of(x);
    val t: opt[*Trait]    = trait.find(ts, x);
    if (sel e.none) {
        if (sel t.some) { ret res[opt[u64], Fail].err{fail.about(fail.unsupported("ELF has no encoding for this trait axis"), x.name)}; }
        ret res[opt[u64], Fail].ok{opt[u64].none{}};
    }
    if (bits_in(e.some, w) != 0) {
        ret res[opt[u64], Fail].err{fail.about(fail.malformed("raw bits of the file hold bits a trait row maps"), x.name)};
    }
    if (sel t.none) {
        if (sel e.some.absent.refuse) {
            ret res[opt[u64], Fail].err{fail.about(fail.malformed("the object does not state a trait axis ELF cannot leave unstated"), x.name)};
        }
        ret res[opt[u64], Fail].ok{opt[u64].none{}};
    }
    val b: opt[u64] = bits_of(e.some, t.some.setting);
    if (sel b.none) { ret res[opt[u64], Fail].err{fail.about(fail.unsupported("ELF has no encoding for this trait value"), x.name)}; }
    ret res[opt[u64], Fail].ok{b};
}

# encode the traits `ts` of an object for `a` into `w`, which holds the raw
# bits no row maps. raw bits a row maps are refused, as are a trait the file
# cannot encode and an unstated axis whose row refuses one. a property is
# added only when it has bits to hold. a refusal leaves `w` as it was
pub fun encode(a: *Arch, ts: *Table[Trait], w: *Words) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Trait](ts)) {
        val t: *Trait = table.at[Trait](ts, table.nth[Trait](i));
        if (!arch.has_axis(a, t.axis)) {
            ret err[Fail].err{fail.about(fail.malformed("the architecture has no such trait axis"), t.axis.name)};
        }
        i = i + 1;
    }
    var flags: u64   = 0;
    var added: usize = 0;
    i = 0;
    for (i < a.axis_count) {
        val x: *Axis               = a.axes[i];
        val b: res[opt[u64], Fail] = encoded(a, ts, w, x);
        i = i + 1;
        if (sel b.err)     { ret err[Fail].err{b.err}; }
        if (sel b.ok.none) { cnt; }
        val e: opt[*Encoding] = encoding_of(x);
        if (sel e.some && sel e.some.field.flags) { flags = flags | b.ok.some; }
        or                                        { added = added + 1; }
    }
    val room: err[Fail] = table.reserve[Word](?w.properties, added);
    if (sel room.err) { ret room; }
    i = 0;
    for (i < a.axis_count) {
        val x: *Axis          = a.axes[i];
        val e: opt[*Encoding] = encoding_of(x);
        val t: opt[*Trait]    = trait.find(ts, x);
        i = i + 1;
        if (sel e.none)             { cnt; }
        if (sel t.none)             { cnt; }
        if (sel e.some.field.flags) { cnt; }
        val b: opt[u64] = bits_of(e.some, t.some.setting);
        if (sel b.none)  { cnt; }
        if (b.some == 0) { cnt; }
        val type: u32        = e.some.field.property.type.value::u32;
        val p:    opt[*Word] = word(w, type);
        if (sel p.some) {
            p.some.value = p.some.value | b.some::u32;
            cnt;
        }
        val put: err[Fail] = add_word(w, Word{type: type, value: b.some::u32});
        if (sel put.err) { ret put; }
    }
    w.flags = w.flags | flags::u32;
    ret err[Fail].ok{};
}

# add the traits `w` states for an object for `a` to `out`, and clear their
# bits from `w`, which keeps the bits no row maps. a field whose bits hold no
# value its row lists states nothing and stays raw, and a missing property
# states its flags clear. a refusal changes neither `out` nor `w`
pub fun decode(a: *Arch, w: *Words, out: *Table[Trait]) err[Fail] {
    var n: usize = 0;
    var i: usize = 0;
    for (i < a.axis_count) {
        val x: *Axis          = a.axes[i];
        val e: opt[*Encoding] = encoding_of(x);
        i = i + 1;
        if (sel e.none) { cnt; }
        val s: opt[Setting] = decoded(e.some, bits_in(e.some, w));
        if (sel s.none) { cnt; }
        val known: opt[*Trait] = trait.find(out, x);
        if (sel known.some) { ret err[Fail].err{fail.about(fail.malformed("a trait axis is stated twice"), x.name)}; }
        n = n + 1;
    }
    val room: err[Fail] = table.reserve[Trait](out, n);
    if (sel room.err) { ret room; }
    i = 0;
    for (i < a.axis_count) {
        val x: *Axis          = a.axes[i];
        val e: opt[*Encoding] = encoding_of(x);
        i = i + 1;
        if (sel e.none) { cnt; }
        val s: opt[Setting] = decoded(e.some, bits_in(e.some, w));
        if (sel s.none) { cnt; }
        val r: err[Fail] = trait.add(out, Trait{axis: x, setting: s.some});
        if (sel r.err) { ret r; }
        if (sel e.some.field.flags) {
            w.flags = w.flags & ~(e.some.field.flags::u32);
            cnt;
        }
        val p: opt[*Word] = word(w, e.some.field.property.type.value::u32);
        if (sel p.some) { p.some.value = p.some.value & ~(e.some.field.property.mask::u32); }
    }
    ret err[Fail].ok{};
}

# whether the rows of a field share no bit, each code fits its axis and lies
# in its row's bits, and a flag has one code with bits
fun consistent(e: *Encoding) bool {
    var i: usize = 0;
    for (i < e.count) {
        val c: *Code = ?e.codes[i];
        if (!trait.fits(e.axis, c.setting))                      { ret false; }
        if ((c.value.value & ~mask(e)) != 0)                     { ret false; }
        if (e.axis.flag && (e.count != 1 || c.value.value == 0)) { ret false; }
        i = i + 1;
    }
    var k: usize = 0;
    for (k < ROW_COUNT) {
        val o: *Encoding = ROWS[k];
        if (o != e && shares(o, e) && (mask(o) & mask(e)) != 0) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether two rows write the same field
fun shares(a: *Encoding, b: *Encoding) bool {
    if (sel a.field.flags) { ret sel b.field.flags; }
    if (sel b.field.flags) { ret false; }
    ret a.field.property.type == b.field.property.type;
}

test traits__rows_are_consistent_and_the_index_holds {
    val rows: [ROW_COUNT]*Encoding = ROWS;
    var i:    usize                = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        i = i + 1;
    }
    val built: err[Fail] = index.verify[Encoding](?AXES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_axes);
    if (sel built.err) { ret 1; }
    ret 0;
}

test traits__flags_and_properties_round_trip_through_the_rows {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # double float and compressed code are 0x5, beside a raw bit no row maps
    var ts:  Table[Trait] = table.make[Trait](a);
    val fa:  err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_FLOAT_ABI, setting: Setting.choice{?arch.RISCV_DOUBLE}});
    val rvc: err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_RVC, setting: Setting.flag{true}});
    if (sel fa.err || sel rvc.err) { ret 1; }
    var w:  Words     = make_words(a, 0);
    val w0: err[Fail] = encode(?arch.RISCV64, ?ts, ?w);
    if (sel w0.err || w.flags != 0x5) { ret 1; }
    w.flags = 0x100;
    val w1: err[Fail] = encode(?arch.RISCV64, ?ts, ?w);
    if (sel w1.err || w.flags != 0x105) { ret 1; }

    var back: Table[Trait] = table.make[Trait](a);
    val r:    err[Fail]    = decode(?arch.RISCV64, ?w, ?back);
    if (sel r.err || w.flags != 0x100)  { ret 1; }
    if (table.count[Trait](?back) != 4) { ret 1; }
    val f: opt[*Trait] = trait.find(?back, ?arch.RISCV_FLOAT_ABI);
    if (sel f.none)                                                      { ret 1; }
    if (!trait.same(f.some.setting, Setting.choice{?arch.RISCV_DOUBLE})) { ret 1; }
    val c: opt[*Trait] = trait.find(?back, ?arch.RISCV_RVC);
    if (sel c.none)                                      { ret 1; }
    if (!trait.same(c.some.setting, Setting.flag{true})) { ret 1; }
    val e: opt[*Trait] = trait.find(?back, ?arch.RISCV_RVE);
    if (sel e.none)                                       { ret 1; }
    if (!trait.same(e.some.setting, Setting.flag{false})) { ret 1; }

    # quad is the whole field, never single and double together
    val q: opt[Setting] = decoded(?RISCV_FLOAT_ABI_ROW, 0x6);
    if (sel q.none)                                            { ret 1; }
    if (!trait.same(q.some, Setting.choice{?arch.RISCV_QUAD})) { ret 1; }

    # raw bits a row maps, and an unstated float ABI, are refused
    w.flags = 0x1;
    val owned: err[Fail] = encode(?arch.RISCV64, ?ts, ?w);
    if (sel owned.ok || w.flags != 0x1) { ret 1; }
    var bare:     Table[Trait] = table.make[Trait](a);
    var none:     Words        = make_words(a, 0);
    val unstated: err[Fail]    = encode(?arch.RISCV64, ?bare, ?none);
    if (sel unstated.ok) { ret 1; }

    # bti is a bit of the and feature property, which encode adds and decode
    # clears, and a file without the property states bti and pac clear
    var feat: Table[Trait] = table.make[Trait](a);
    val bti:  err[Fail]    = trait.add(?feat, Trait{axis: ?arch.AARCH64_BTI, setting: Setting.flag{true}});
    val pac:  err[Fail]    = trait.add(?feat, Trait{axis: ?arch.AARCH64_PAC, setting: Setting.flag{false}});
    if (sel bti.err || sel pac.err) { ret 1; }
    var pw: Words     = make_words(a, 0);
    val p0: err[Fail] = encode(?arch.AARCH64, ?feat, ?pw);
    if (sel p0.err) { ret 1; }
    val and: opt[*Word] = word(?pw, tables.GNU_PROPERTY_AARCH64_FEATURE_1_AND.value::u32);
    if (sel and.none)          { ret 1; }
    if (and.some.value != 0x1) { ret 1; }
    var pback: Table[Trait] = table.make[Trait](a);
    val p1:    err[Fail]    = decode(?arch.AARCH64, ?pw, ?pback);
    if (sel p1.err || and.some.value != 0) { ret 1; }
    val bb: opt[*Trait] = trait.find(?pback, ?arch.AARCH64_BTI);
    if (sel bb.none)                                      { ret 1; }
    if (!trait.same(bb.some.setting, Setting.flag{true})) { ret 1; }
    var empty:   Words        = make_words(a, 0);
    var cleared: Table[Trait] = table.make[Trait](a);
    val p2:      err[Fail]    = decode(?arch.AARCH64, ?empty, ?cleared);
    if (sel p2.err || table.count[Trait](?cleared) != 2) { ret 1; }
    val cb: opt[*Trait] = trait.find(?cleared, ?arch.AARCH64_BTI);
    if (sel cb.none)                                       { ret 1; }
    if (!trait.same(cb.some.setting, Setting.flag{false})) { ret 1; }

    val r1: err[Fail] = table.release[Trait](?ts);
    val r2: err[Fail] = table.release[Trait](?back);
    val r3: err[Fail] = table.release[Trait](?bare);
    val r4: err[Fail] = table.release[Trait](?feat);
    val r5: err[Fail] = table.release[Trait](?pback);
    val r6: err[Fail] = table.release[Trait](?cleared);
    if (sel r1.err || sel r2.err || sel r3.err || sel r4.err || sel r5.err || sel r6.err) { ret 1; }
    val r7:  err[Fail] = release_words(?w);
    val r8:  err[Fail] = release_words(?none);
    val r9:  err[Fail] = release_words(?pw);
    val r10: err[Fail] = release_words(?empty);
    if (sel r7.err || sel r8.err || sel r9.err || sel r10.err) { ret 1; }
    if (T.live_count(?t) != 0)                                 { ret 1; }
    T.dnit(?t);
    ret 0;
}
