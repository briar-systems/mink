val RISCV_ATOMIC_ABI_ROW:   Encoding = Encoding{axis: ?arch.RISCV_ATOMIC_ABI, field: Field.attribute{Tagged{vendor: ?RISCV_VENDOR, tag: 14}}, codes: ?RISCV_ATOMIC_ABI_CODES[0], count: 4};
val RISCV_X3_REG_USAGE_ROW: Encoding = Encoding{axis: ?arch.RISCV_X3_REG_USAGE, field: Field.attribute{Tagged{vendor: ?RISCV_VENDOR, tag: 16}}, codes: ?RISCV_X3_REG_USAGE_CODES[0], count: 4};

val ROW_COUNT: usize                = 54;
val ROWS:      [ROW_COUNT]*Encoding = [ROW_COUNT]*Encoding{?RISCV_FLOAT_ABI_ROW, ?RISCV_RVC_ROW, ?RISCV_RVE_ROW, ?RISCV_TSO_ROW, ?AARCH64_BTI_ROW, ?AARCH64_PAC_ROW, ?AARCH64_GCS_ROW, ?X86_IBT_ROW, ?X86_SHSTK_ROW, ?X86_LAM_U48_ROW, ?X86_LAM_U57_ROW, ?X86_ISA_NEEDED_BASELINE_ROW, ?X86_ISA_NEEDED_V2_ROW, ?X86_ISA_NEEDED_V3_ROW, ?X86_ISA_NEEDED_V4_ROW, ?X86_ISA_USED_BASELINE_ROW, ?X86_ISA_USED_V2_ROW, ?X86_ISA_USED_V3_ROW, ?X86_ISA_USED_V4_ROW, ?X86_FEATURE_NEEDED_X86_ROW, ?X86_FEATURE_NEEDED_X87_ROW, ?X86_FEATURE_NEEDED_MMX_ROW, ?X86_FEATURE_NEEDED_XMM_ROW, ?X86_FEATURE_NEEDED_YMM_ROW, ?X86_FEATURE_NEEDED_ZMM_ROW, ?X86_FEATURE_NEEDED_FXSR_ROW, ?X86_FEATURE_NEEDED_XSAVE_ROW, ?X86_FEATURE_NEEDED_XSAVEOPT_ROW, ?X86_FEATURE_NEEDED_XSAVEC_ROW, ?X86_FEATURE_NEEDED_TMM_ROW, ?X86_FEATURE_NEEDED_MASK_ROW, ?X86_FEATURE_USED_X86_ROW, ?X86_FEATURE_USED_X87_ROW, ?X86_FEATURE_USED_MMX_ROW, ?X86_FEATURE_USED_XMM_ROW, ?X86_FEATURE_USED_YMM_ROW, ?X86_FEATURE_USED_ZMM_ROW, ?X86_FEATURE_USED_FXSR_ROW, ?X86_FEATURE_USED_XSAVE_ROW, ?X86_FEATURE_USED_XSAVEOPT_ROW, ?X86_FEATURE_USED_XSAVEC_ROW, ?X86_FEATURE_USED_TMM_ROW, ?X86_FEATURE_USED_MASK_ROW, ?RISCV_STACK_ALIGN_ROW, ?RISCV_ARCH_ROW, ?RISCV_UNALIGNED_ACCESS_ROW, ?RISCV_PRIV_SPEC_ROW, ?RISCV_PRIV_SPEC_MINOR_ROW, ?RISCV_PRIV_SPEC_REVISION_ROW, ?RISCV_ATOMIC_ABI_ROW, ?RISCV_X3_REG_USAGE_ROW, ?RISCV_CFI_LP_UNLABELED_ROW, ?RISCV_CFI_SS_ROW, ?RISCV_CFI_LP_FUNC_SIG_ROW};
# the rows by axis name
val AXES: [ROW_COUNT]*Encoding = [ROW_COUNT]*Encoding{?AARCH64_BTI_ROW, ?AARCH64_GCS_ROW, ?AARCH64_PAC_ROW, ?RISCV_ARCH_ROW, ?RISCV_ATOMIC_ABI_ROW, ?RISCV_CFI_LP_FUNC_SIG_ROW, ?RISCV_CFI_LP_UNLABELED_ROW, ?RISCV_CFI_SS_ROW, ?RISCV_FLOAT_ABI_ROW, ?RISCV_PRIV_SPEC_ROW, ?RISCV_PRIV_SPEC_MINOR_ROW, ?RISCV_PRIV_SPEC_REVISION_ROW, ?RISCV_RVC_ROW, ?RISCV_RVE_ROW, ?RISCV_STACK_ALIGN_ROW, ?RISCV_TSO_ROW, ?RISCV_UNALIGNED_ACCESS_ROW, ?RISCV_X3_REG_USAGE_ROW, ?X86_FEATURE_NEEDED_FXSR_ROW, ?X86_FEATURE_NEEDED_MASK_ROW, ?X86_FEATURE_NEEDED_MMX_ROW, ?X86_FEATURE_NEEDED_TMM_ROW, ?X86_FEATURE_NEEDED_X86_ROW, ?X86_FEATURE_NEEDED_X87_ROW, ?X86_FEATURE_NEEDED_XMM_ROW, ?X86_FEATURE_NEEDED_XSAVE_ROW, ?X86_FEATURE_NEEDED_XSAVEC_ROW, ?X86_FEATURE_NEEDED_XSAVEOPT_ROW, ?X86_FEATURE_NEEDED_YMM_ROW, ?X86_FEATURE_NEEDED_ZMM_ROW, ?X86_FEATURE_USED_FXSR_ROW, ?X86_FEATURE_USED_MASK_ROW, ?X86_FEATURE_USED_MMX_ROW, ?X86_FEATURE_USED_TMM_ROW, ?X86_FEATURE_USED_X86_ROW, ?X86_FEATURE_USED_X87_ROW, ?X86_FEATURE_USED_XMM_ROW, ?X86_FEATURE_USED_XSAVE_ROW, ?X86_FEATURE_USED_XSAVEC_ROW, ?X86_FEATURE_USED_XSAVEOPT_ROW, ?X86_FEATURE_USED_YMM_ROW, ?X86_FEATURE_USED_ZMM_ROW, ?X86_IBT_ROW, ?X86_ISA_NEEDED_BASELINE_ROW, ?X86_ISA_NEEDED_V2_ROW, ?X86_ISA_NEEDED_V3_ROW, ?X86_ISA_NEEDED_V4_ROW, ?X86_ISA_USED_BASELINE_ROW, ?X86_ISA_USED_V2_ROW, ?X86_ISA_USED_V3_ROW, ?X86_ISA_USED_V4_ROW, ?X86_LAM_U48_ROW, ?X86_LAM_U57_ROW, ?X86_SHSTK_ROW};

fun order_axes(a: **Encoding, b: **Encoding) i64 {
    ret str_compare(a[0].axis.name, b[0].axis.name);
}

# the row of `x`, none where ELF has no encoding for it
pub fun encoding_of(x: *Axis) opt[*Encoding] {
    var probe: Encoding       = Encoding{axis: x};
    val row:   opt[*Encoding] = index.find[Encoding](?AXES[0], ROW_COUNT, ?probe, order_axes);
    if (sel row.some && row.some.axis == x) { ret row; }
    ret opt[*Encoding].none{};
}

# the bits of its field the row owns, none for an attribute
pub fun mask(e: *Encoding) u64 {
    if (sel e.field.flags)     { ret e.field.flags; }
    or (sel e.field.attribute) { ret 0; }
    ret e.field.property.mask;
}

# the ELF machine code of an architecture and the class and byte order its
# files take
pub rec Machine {
    code:  format.Code;
    shape: Shape;
}

# the machine of `a`, refused for an architecture ELF has no code for
pub fun machine_of(a: *Arch) res[Machine, Fail] {
    val code: opt[format.Code] = arch.code(a, ?format.ELF);
    if (sel code.none) { ret res[Machine, Fail].err{fail.unsupported("the architecture has no ELF code")}; }
    var class: *model.Class = ?model.CLASS32;
    if (code.some.qualifier == tables.ELFCLASS64.value::u32) { class = ?model.CLASS64; }
    ret res[Machine, Fail].ok{Machine{code: code.some, shape: Shape{class: class, order: a.order}}};
}

# append to `out` every axis of `a` an ELF file encodes through a row, each
# required as its row is, refusing an architecture ELF has no code for
pub fun encodes(a: *Arch, out: *Table[Encoded]) err[Fail] {
    val m: res[Machine, Fail] = machine_of(a);
    if (sel m.err) { ret err[Fail].err{fail.about(m.err, a.name)}; }
    var n: usize = 0;
    var i: usize = 0;
    for (i < a.axis_count) {
        val e: opt[*Encoding] = encoding_of(a.axes[i]);
        i = i + 1;
        if (sel e.some) { n = n + 1; }
    }
    val room: err[Fail] = table.reserve[Encoded](out, n);
    if (sel room.err) { ret room; }
    i = 0;
    for (i < a.axis_count) {
        val e: opt[*Encoding] = encoding_of(a.axes[i]);
        i = i + 1;
        if (sel e.none) { cnt; }
        val put: res[table.Id[Encoded], Fail] = table.push[Encoded](out, Encoded{axis: e.some.axis, required: required(e.some)});
        if (sel put.err) { ret err[Fail].err{put.err}; }
    }
    ret err[Fail].ok{};
}

# whether the row's value lives in e_flags or a GNU property word
fun worded(e: *Encoding) bool {
    ret !(sel e.field.attribute);
}

# the architecture of `m`, by its machine and class
pub fun arch_of(m: *Elf) res[*Arch, Fail] {
    var cls: u64 = tables.ELFCLASS32.value::u64;
    if (m.shape.class.addr == 8) { cls = tables.ELFCLASS64.value::u64; }
    ret arch.by_code(?format.ELF, m.header.machine::u32, cls::u32);
}

# the word of the GNU property `type` of a file for `a` whose notes state
# `held` and `next`. each bit a row maps merges by its axis's rule, and a bit
# no row maps carries nothing, so one set in either is refused naming the
# type and the bit
pub fun merge_word(a: *Arch, type: u32, held: u32, next: u32) res[u32, Fail] {
    var out:    u64   = 0;
    var mapped: u64   = 0;
    var i:      usize = 0;
    for (i < a.axis_count) {
        val e: opt[*Encoding] = encoding_of(a.axes[i]);
        i = i + 1;
        if (sel e.none)                                    { cnt; }
        if (!(sel e.some.field.property))                  { cnt; }
        if (e.some.field.property.type.value::u32 != type) { cnt; }
        val m:  u64          = e.some.field.property.mask;
        val sh: opt[Setting] = decoded(e.some, held::u64 & m);
        val sn: opt[Setting] = decoded(e.some, next::u64 & m);
        if (sel sh.none) { ret res[u32, Fail].err{fail.about(fail.unsupported("GNU property notes hold bits that state no value of a trait axis"), e.some.axis.name)}; }
        if (sel sn.none) { ret res[u32, Fail].err{fail.about(fail.unsupported("GNU property notes hold bits that state no value of a trait axis"), e.some.axis.name)}; }
        val s: opt[Setting] = trait.merge(e.some.axis, sh.some, sn.some);
        if (sel s.none) { ret res[u32, Fail].err{fail.about(fail.unsupported("GNU property notes state values of a trait axis that do not merge"), e.some.axis.name)}; }
        val b: opt[u64] = bits_of(e.some, s.some);
        if (sel b.none) { ret res[u32, Fail].err{fail.about(fail.unsupported("ELF has no encoding for this trait value"), e.some.axis.name)}; }
        out    = out | b.some;
        mapped = mapped | m;
    }
    val left: u64 = (held::u64 | next::u64) & ~mapped;
    if (left != 0) {
        ret res[u32, Fail].err{fail.valued(fail.in_indexed(fail.unsupported("GNU property notes hold a bit no trait row maps"), "GNU property", type::u64), (left & (~left + 1))::i128)};
    }
    ret res[u32, Fail].ok{out::u32};
}

pub fun make_words(a: *A.Allocator, flags: u32) Words {
    ret Words{flags: flags, properties: table.make[Word](a)};
}

pub fun release_words(w: *Words) err[Fail] {
    ret table.release[Word](?w.properties);
}

fun order_words(a: *Word, b: *Word) i64 {
    if (a.type < b.type) { ret -1; }
    if (a.type > b.type) { ret 1; }
    ret 0;
}

fun word_at(w: *Words, type: u32) SearchPosition {
    var probe: Word = Word{type: type};
    ret sort.binary_search_by[Word](table.items[Word](?w.properties), table.count[Word](?w.properties), ?probe, order_words);
}

# the property of `type` in `w`, none when the file has none
pub fun word(w: *Words, type: u32) opt[*Word] {
    val at: SearchPosition = word_at(w, type);
    if (sel at.found) { ret opt[*Word].some{table.at[Word](?w.properties, table.nth[Word](at.found))}; }
    ret opt[*Word].none{};
}

# add the property `p` the file holds, refusing a type it holds twice
pub fun add_word(w: *Words, p: Word) err[Fail] {
    val at: SearchPosition = word_at(w, p.type);
    if (sel at.found) { ret err[Fail].err{fail.valued(fail.malformed("a GNU property type is held twice"), p.type::i128)}; }
    ret table.insert[Word](?w.properties, at.insertion, p);
}

# the bits of `w` in the row's field, none for an attribute
pub fun bits_in(e: *Encoding, w: *Words) u64 {
    if (sel e.field.flags)     { ret w.flags::u64 & e.field.flags; }
    or (sel e.field.attribute) { ret 0; }
    val p: opt[*Word] = word(w, e.field.property.type.value::u32);
    if (sel p.some) { ret p.some.value::u64 & e.field.property.mask; }
    ret 0;
}

# the code whose bits are `bits`, none when no code of the row has them
pub fun held(e: *Encoding, bits: u64) opt[*Code] {
    var i: usize = 0;
    for (i < e.count) {
        if (e.codes[i].value.value == bits) { ret opt[*Code].some{?e.codes[i]}; }
        i = i + 1;
    }
    ret opt[*Code].none{};
}

# what the field bits `bits` state on the row's axis, none when they hold no
# value the row maps
pub fun decoded(e: *Encoding, bits: u64) opt[Setting] {
    val c: opt[*Code] = held(e, bits);
    if (sel c.some)                           { ret opt[Setting].some{c.some.setting}; }
    if ((sel e.axis.value.flag) && bits == 0) { ret opt[Setting].some{Setting.flag{false}}; }
    ret opt[Setting].none{};
}

# whether the file cannot leave the row's axis unstated, as its field holding
# no bits reads back as a value, the way a missing flag reads back clear. an
# attribute is left out of the file, so its axis can be
pub fun required(e: *Encoding) bool {
    if (!worded(e)) { ret false; }
    val s: opt[Setting] = decoded(e, 0);
    ret sel s.some;
}

# the bits that encode `s`, none where the row lists no code for it. a clear
# flag is encoded as no bits
fun bits_of(e: *Encoding, s: Setting) opt[u64] {
    var i: usize = 0;
    for (i < e.count) {
        if (trait.same(e.codes[i].setting, s)) { ret opt[u64].some{e.codes[i].value.value}; }
        i = i + 1;
    }
    if (sel s.flag && !s.flag) { ret opt[u64].some{0}; }
    ret opt[u64].none{};
}

# what encoding `x` writes, none for nothing, or the refusal
fun encoded(a: *Arch, ts: *Table[Trait], w: *Words, x: *Axis) res[opt[u64], Fail] {
    val e: opt[*Encoding] = encoding_of(x);
    val t: opt[*Trait]    = trait.find(ts, x);
    if (sel e.none) {
        if (sel t.some) { ret res[opt[u64], Fail].err{fail.about(fail.unsupported("ELF has no encoding for this trait axis"), x.name)}; }
        ret res[opt[u64], Fail].ok{opt[u64].none{}};
    }
    if (!worded(e.some)) { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    if (bits_in(e.some, w) != 0) {
        ret res[opt[u64], Fail].err{fail.about(fail.malformed("raw bits of the file hold bits a trait row maps"), x.name)};
    }
    if (sel t.none) {
        if (required(e.some)) {
            ret res[opt[u64], Fail].err{fail.about(fail.unsupported("the object leaves unstated a trait axis ELF cannot leave unstated"), x.name)};
        }
        ret res[opt[u64], Fail].ok{opt[u64].none{}};
    }
    val b: opt[u64] = bits_of(e.some, t.some.setting);
    if (sel b.none) { ret res[opt[u64], Fail].err{fail.about(fail.unsupported("ELF has no encoding for this trait value"), x.name)}; }
    ret res[opt[u64], Fail].ok{b};
}

# encode the traits `ts` of an object for `a` into `w`, which holds the raw
# bits no row maps. raw bits a row maps are refused, as are a trait the file
# cannot encode and an unstated axis the file cannot leave unstated. a
# property is added only when it has bits to hold. a refusal leaves `w` as it
# was
pub fun encode(a: *Arch, ts: *Table[Trait], w: *Words) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Trait](ts)) {
        val t: *Trait = table.at[Trait](ts, table.nth[Trait](i));
        if (!arch.has_axis(a, t.axis)) {
            ret err[Fail].err{fail.about(fail.malformed("the architecture has no such trait axis"), t.axis.name)};
        }
        i = i + 1;
    }
    var flags: u64   = 0;
    var added: usize = 0;
    i = 0;
    for (i < a.axis_count) {
        val x: *Axis               = a.axes[i];
        val b: res[opt[u64], Fail] = encoded(a, ts, w, x);
        i = i + 1;
        if (sel b.err)     { ret err[Fail].err{b.err}; }
        if (sel b.ok.none) { cnt; }
        val e: opt[*Encoding] = encoding_of(x);
        if (sel e.some && sel e.some.field.flags) { flags = flags | b.ok.some; }
        or                                        { added = added + 1; }
    }
    val room: err[Fail] = table.reserve[Word](?w.properties, added);
    if (sel room.err) { ret room; }
    i = 0;
    for (i < a.axis_count) {
        val x: *Axis          = a.axes[i];
        val e: opt[*Encoding] = encoding_of(x);
        val t: opt[*Trait]    = trait.find(ts, x);
        i = i + 1;
        if (sel e.none)                 { cnt; }
        if (sel t.none)                 { cnt; }
        if (sel e.some.field.flags)     { cnt; }
        or (sel e.some.field.attribute) { cnt; }
        val b: opt[u64] = bits_of(e.some, t.some.setting);
        if (sel b.none)  { cnt; }
        if (b.some == 0) { cnt; }
        val type: u32        = e.some.field.property.type.value::u32;
        val p:    opt[*Word] = word(w, type);
        if (sel p.some) {
            p.some.value = p.some.value | b.some::u32;
            cnt;
        }
        val put: err[Fail] = add_word(w, Word{type: type, value: b.some::u32});
        if (sel put.err) { ret put; }
    }
    w.flags = w.flags | flags::u32;
    ret err[Fail].ok{};
}

# add the traits `w` states for an object for `a` to `out`, and clear their
# bits from `w`, which keeps the bits no row maps. a field whose bits hold no
# value its row lists states nothing and stays raw, and a missing property
# states its flags clear. a refusal changes neither `out` nor `w`
pub fun decode(a: *Arch, w: *Words, out: *Table[Trait]) err[Fail] {
    var n: usize = 0;
    var i: usize = 0;
    for (i < a.axis_count) {
        val x: *Axis          = a.axes[i];
        val e: opt[*Encoding] = encoding_of(x);
        i = i + 1;
        if (sel e.none)      { cnt; }
        if (!worded(e.some)) { cnt; }
        val s: opt[Setting] = decoded(e.some, bits_in(e.some, w));
        if (sel s.none) { cnt; }
        val known: opt[*Trait] = trait.find(out, x);
        if (sel known.some) { ret err[Fail].err{fail.about(fail.malformed("a trait axis is stated twice"), x.name)}; }
        n = n + 1;
    }
    val room: err[Fail] = table.reserve[Trait](out, n);
    if (sel room.err) { ret room; }
    i = 0;
    for (i < a.axis_count) {
        val x: *Axis          = a.axes[i];
        val e: opt[*Encoding] = encoding_of(x);
        i = i + 1;
        if (sel e.none)      { cnt; }
        if (!worded(e.some)) { cnt; }
        val s: opt[Setting] = decoded(e.some, bits_in(e.some, w));
        if (sel s.none) { cnt; }
        val r: err[Fail] = trait.add(out, Trait{axis: x, setting: s.some});
        if (sel r.err) { ret r; }
        if (sel e.some.field.flags) {
            w.flags = w.flags & ~(e.some.field.flags::u32);
            cnt;
        }
        or (sel e.some.field.attribute) { cnt; }
        val p: opt[*Word] = word(w, e.some.field.property.type.value::u32);
        if (sel p.some) { p.some.value = p.some.value & ~(e.some.field.property.mask::u32); }
    }
    ret err[Fail].ok{};
}

# whether a row is consistent: each code fits its axis, the rows of a field
# share no bit and no attribute, a value in bits lies in its row's bits and a
# flag in bits has one code with bits, a value in bits is a flag or a choice,
# an attribute of a choice lists one code of its own number for each choice
# and other attributes list none, and an attribute's vendor encodes its tag
# as a string exactly when its value is a text and as a number otherwise
fun consistent(e: *Encoding) bool {
    val bits: bool  = worded(e);
    var i:    usize = 0;
    for (i < e.count) {
        val c: *Code = ?e.codes[i];
        if (!trait.fits(e.axis, c.setting))          { ret false; }
        if (bits && (c.value.value & ~mask(e)) != 0) { ret false; }
        i = i + 1;
    }
    if (bits && (sel e.axis.value.number || sel e.axis.value.text))                       { ret false; }
    if (bits && (sel e.axis.value.flag) && (e.count != 1 || e.codes[0].value.value == 0)) { ret false; }
    if (sel e.field.attribute) {
        val kind: attributes.Kind = attributes.kind_of(e.field.attribute.vendor, e.field.attribute.tag);
        if (!(sel e.axis.value.choice) && e.count != 0)           { ret false; }
        if ((sel e.axis.value.choice) && e.count != e.axis.count) { ret false; }
        if ((sel kind.text) != (sel e.axis.value.text))           { ret false; }
        if (sel kind.pair)                                        { ret false; }
        if (!attributes.consistent(e.field.attribute.vendor))     { ret false; }
        var c: usize = 0;
        for (c < e.count) {
            var d: usize = 0;
            for (d < c) {
                if (e.codes[d].value.value == e.codes[c].value.value)   { ret false; }
                if (trait.same(e.codes[d].setting, e.codes[c].setting)) { ret false; }
                d = d + 1;
            }
            c = c + 1;
        }
    }
    var k: usize = 0;
    for (k < ROW_COUNT) {
        val o: *Encoding = ROWS[k];
        if (o != e && shares(o, e) && (!bits || (mask(o) & mask(e)) != 0)) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether two rows write the same field, for attributes the same attribute
fun shares(a: *Encoding, b: *Encoding) bool {
    if (sel a.field.flags) { ret sel b.field.flags; }
    or (sel a.field.attribute) {
        if (sel b.field.attribute) { ret a.field.attribute.vendor == b.field.attribute.vendor && a.field.attribute.tag == b.field.attribute.tag; }
        ret false;
    }
    if (sel b.field.property) { ret a.field.property.type == b.field.property.type; }
    ret false;
}

# the vendor whose build attributes hold traits of `a`, none when no row of
# its axes is an attribute. the attribute rows of one architecture's axes
# name one vendor
pub fun vendor_of(a: *Arch) opt[*Vendor] {
    var i: usize = 0;
    for (i < a.axis_count) {
        val e: opt[*Encoding] = encoding_of(a.axes[i]);
        i = i + 1;
        if (sel e.some) {
            if (sel e.some.field.attribute) { ret opt[*Vendor].some{e.some.field.attribute.vendor}; }
        }
    }
    ret opt[*Vendor].none{};
}

# the row of the attribute `tag` of `v` among the axes of `a`, none when no
# row maps it
pub fun attribute_row(a: *Arch, v: *Vendor, tag: u64) opt[*Encoding] {
    var i: usize = 0;
    for (i < a.axis_count) {
        val e: opt[*Encoding] = encoding_of(a.axes[i]);
        i = i + 1;
        if (sel e.some) {
            if (sel e.some.field.attribute) {
                if (e.some.field.attribute.vendor == v && e.some.field.attribute.tag == tag) { ret e; }
            }
        }
    }
    ret opt[*Encoding].none{};
}

# what the attribute value `v` states on the axis of the attribute row `e`,
# none when it is not a value the row reads. a text is borrowed from where
# the value lies
pub fun attribute_setting(e: *Encoding, v: attributes.Value) opt[Setting] {
    if (sel v.text) {
        if (sel e.axis.value.text) { ret opt[Setting].some{Setting.text{Held.borrowed{v.text}}}; }
        ret opt[Setting].none{};
    }
    or (sel v.pair)              { ret opt[Setting].none{}; }
    if (sel e.axis.value.number) { ret opt[Setting].some{Setting.number{v.number}}; }
    if (sel e.axis.value.flag) {
        if (v.number == 0) { ret opt[Setting].some{Setting.flag{false}}; }
        if (v.number == 1) { ret opt[Setting].some{Setting.flag{true}}; }
        ret opt[Setting].none{};
    }
    val c: opt[*Code] = held(e, v.number);
    if (sel c.some) { ret opt[Setting].some{c.some.setting}; }
    ret opt[Setting].none{};
}

# the value the attribute row `e` writes for `s`, whose bytes are `text` for a
# text, none where the row has no value for it
pub fun attribute_value(e: *Encoding, s: Setting, text: Bytes) opt[attributes.Value] {
    if (sel s.text)   { ret opt[attributes.Value].some{attributes.Value.text{text}}; }
    if (sel s.number) { ret opt[attributes.Value].some{attributes.Value.number{s.number}}; }
    if (sel s.flag) {
        if (s.flag) { ret opt[attributes.Value].some{attributes.Value.number{1}}; }
        ret opt[attributes.Value].some{attributes.Value.number{0}};
    }
    val b: opt[u64] = bits_of(e, s);
    if (sel b.some) { ret opt[attributes.Value].some{attributes.Value.number{b.some}}; }
    ret opt[attributes.Value].none{};
}

test traits__rows_are_consistent_and_the_index_holds {
    val rows: [ROW_COUNT]*Encoding = ROWS;
    var i:    usize                = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        i = i + 1;
    }
    val built: err[Fail] = index.verify[Encoding](?AXES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_axes);
    if (sel built.err) { ret 1; }
    ret 0;
}

test traits__flags_and_properties_round_trip_through_the_rows {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # double float and compressed code are 0x5, beside a raw bit no row maps
    var ts:  Table[Trait] = table.make[Trait](a);
    val fa:  err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_FLOAT_ABI, setting: Setting.choice{?arch.RISCV_DOUBLE}});
    val rvc: err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_RVC, setting: Setting.flag{true}});
    val rve: err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_RVE, setting: Setting.flag{false}});
    val tso: err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_TSO, setting: Setting.flag{false}});
    val lp:  err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_CFI_LP_UNLABELED, setting: Setting.flag{false}});
    val ss:  err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_CFI_SS, setting: Setting.flag{false}});
    val sig: err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_CFI_LP_FUNC_SIG, setting: Setting.flag{false}});
    if (sel fa.err || sel rvc.err || sel rve.err || sel tso.err) { ret 1; }
    if (sel lp.err || sel ss.err || sel sig.err)                 { ret 1; }
    var w:  Words     = make_words(a, 0);
    val w0: err[Fail] = encode(?arch.RISCV64, ?ts, ?w);
    if (sel w0.err || w.flags != 0x5) { ret 1; }
    w.flags = 0x100;
    val w1: err[Fail] = encode(?arch.RISCV64, ?ts, ?w);
    if (sel w1.err || w.flags != 0x105) { ret 1; }

    var back: Table[Trait] = table.make[Trait](a);
    val r:    err[Fail]    = decode(?arch.RISCV64, ?w, ?back);
    if (sel r.err || w.flags != 0x100)  { ret 1; }
    if (table.count[Trait](?back) != 7) { ret 1; }
    val f: opt[*Trait] = trait.find(?back, ?arch.RISCV_FLOAT_ABI);
    if (sel f.none)                                                      { ret 1; }
    if (!trait.same(f.some.setting, Setting.choice{?arch.RISCV_DOUBLE})) { ret 1; }
    val c: opt[*Trait] = trait.find(?back, ?arch.RISCV_RVC);
    if (sel c.none)                                      { ret 1; }
    if (!trait.same(c.some.setting, Setting.flag{true})) { ret 1; }
    val e: opt[*Trait] = trait.find(?back, ?arch.RISCV_RVE);
    if (sel e.none)                                       { ret 1; }
    if (!trait.same(e.some.setting, Setting.flag{false})) { ret 1; }

    # quad is the whole field, never single and double together
    val q: opt[Setting] = decoded(?RISCV_FLOAT_ABI_ROW, 0x6);
    if (sel q.none)                                            { ret 1; }
    if (!trait.same(q.some, Setting.choice{?arch.RISCV_QUAD})) { ret 1; }

    # raw bits a row maps, and an unstated float ABI, are refused
    w.flags = 0x1;
    val owned: err[Fail] = encode(?arch.RISCV64, ?ts, ?w);
    if (sel owned.ok || w.flags != 0x1) { ret 1; }
    var bare:     Table[Trait] = table.make[Trait](a);
    var none:     Words        = make_words(a, 0);
    val unstated: err[Fail]    = encode(?arch.RISCV64, ?bare, ?none);
    if (sel unstated.ok) { ret 1; }

    # bti is a bit of the and feature property, which encode adds and decode
    # clears, and a file without the property states bti, pac and gcs clear
    var feat: Table[Trait] = table.make[Trait](a);
    val bti:  err[Fail]    = trait.add(?feat, Trait{axis: ?arch.AARCH64_BTI, setting: Setting.flag{true}});
    val pac:  err[Fail]    = trait.add(?feat, Trait{axis: ?arch.AARCH64_PAC, setting: Setting.flag{false}});
    val gcs:  err[Fail]    = trait.add(?feat, Trait{axis: ?arch.AARCH64_GCS, setting: Setting.flag{false}});
    if (sel bti.err || sel pac.err || sel gcs.err) { ret 1; }
    var pw: Words     = make_words(a, 0);
    val p0: err[Fail] = encode(?arch.AARCH64, ?feat, ?pw);
    if (sel p0.err) { ret 1; }
    val and: opt[*Word] = word(?pw, tables.GNU_PROPERTY_AARCH64_FEATURE_1_AND.value::u32);
    if (sel and.none)          { ret 1; }
    if (and.some.value != 0x1) { ret 1; }
    var pback: Table[Trait] = table.make[Trait](a);
    val p1:    err[Fail]    = decode(?arch.AARCH64, ?pw, ?pback);
    if (sel p1.err || and.some.value != 0) { ret 1; }
    val bb: opt[*Trait] = trait.find(?pback, ?arch.AARCH64_BTI);
    if (sel bb.none)                                      { ret 1; }
    if (!trait.same(bb.some.setting, Setting.flag{true})) { ret 1; }
    var empty:   Words        = make_words(a, 0);
    var cleared: Table[Trait] = table.make[Trait](a);
    val p2:      err[Fail]    = decode(?arch.AARCH64, ?empty, ?cleared);
    if (sel p2.err || table.count[Trait](?cleared) != 3) { ret 1; }
    val cb: opt[*Trait] = trait.find(?cleared, ?arch.AARCH64_BTI);
    if (sel cb.none)                                       { ret 1; }
    if (!trait.same(cb.some.setting, Setting.flag{false})) { ret 1; }

    val r1: err[Fail] = table.release[Trait](?ts);
    val r2: err[Fail] = table.release[Trait](?back);
    val r3: err[Fail] = table.release[Trait](?bare);
    val r4: err[Fail] = table.release[Trait](?feat);
    val r5: err[Fail] = table.release[Trait](?pback);
    val r6: err[Fail] = table.release[Trait](?cleared);
    if (sel r1.err || sel r2.err || sel r3.err || sel r4.err || sel r5.err || sel r6.err) { ret 1; }
    val r7:  err[Fail] = release_words(?w);
    val r8:  err[Fail] = release_words(?none);
    val r9:  err[Fail] = release_words(?pw);
    val r10: err[Fail] = release_words(?empty);
    if (sel r7.err || sel r8.err || sel r9.err || sel r10.err) { ret 1; }
    if (T.live_count(?t) != 0)                                 { ret 1; }
    T.dnit(?t);
    ret 0;
}

test traits__encodes_the_axes_of_its_rows_with_their_requirement {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # every row of a riscv64 axis is answered once, as required as the row is
    var out: Table[Encoded] = table.make[Encoded](a);
    val r:   err[Fail]      = encodes(?arch.RISCV64, ?out);
    if (sel r.err) { ret 1; }
    var want: usize = 0;
    var k:    usize = 0;
    for (k < ROW_COUNT) {
        val e: *Encoding = ROWS[k];
        k = k + 1;
        if (!arch.has_axis(?arch.RISCV64, e.axis)) { cnt; }
        want = want + 1;
        var found: usize = 0;
        var i:     usize = 0;
        for (i < table.count[Encoded](?out)) {
            val got: *Encoded = table.at[Encoded](?out, table.nth[Encoded](i));
            i = i + 1;
            if (got.axis != e.axis)          { cnt; }
            if (got.required != required(e)) { ret 1; }
            found = found + 1;
        }
        if (found != 1) { ret 1; }
    }
    if (want == 0 || table.count[Encoded](?out) != want) { ret 1; }

    val freed: err[Fail] = table.release[Encoded](?out);
    if (sel freed.err)         { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
