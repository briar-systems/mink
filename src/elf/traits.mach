# the ELF encoding of trait axes
#
# one row per trait axis ELF writes, keyed by the axis row of the trait
# catalog, giving where its value lives and the constant that encodes each
# value. the writer encodes an object's traits through these rows and the
# reader decodes them back, so a bit a row maps is the row's alone and is
# never also kept raw.

use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.elf.tables;
use mink.elf.tables.Constant;
use mink.fail;
use mink.fail.Fail;
use mink.table;
use mink.table.Table;

# what the writer does with an object that states nothing on an axis
# ---
# refuse: the file has no way to leave the axis unstated, because no bits
#         read back as one of its values
# omit:   no bits are written, which reads back as a clear flag
pub tag Absent: u8 {
    refuse;
    omit;
}

# a value of an axis and the constant whose bits encode it
pub rec Code {
    setting: Setting;
    value:   *Constant;
}

# axis:   the trait axis
# mask:   the e_flags bits its value lives in
# codes:  the encoding of each value. a flag lists only its set value, and is
#         clear when none of its bits are set
# count:  how many
# absent: what the writer does when the axis is not stated
pub rec Encoding {
    axis:   *Axis;
    mask:   u64;
    codes:  *Code;
    count:  usize;
    absent: Absent;
}

val RISCV_FLOAT_ABI_CODES: [4]Code = [4]Code{
    Code{setting: Setting.choice{?arch.RISCV_SOFT}, value: ?tables.EF_RISCV_FLOAT_ABI_SOFT},
    Code{setting: Setting.choice{?arch.RISCV_SINGLE}, value: ?tables.EF_RISCV_FLOAT_ABI_SINGLE},
    Code{setting: Setting.choice{?arch.RISCV_DOUBLE}, value: ?tables.EF_RISCV_FLOAT_ABI_DOUBLE},
    Code{setting: Setting.choice{?arch.RISCV_QUAD}, value: ?tables.EF_RISCV_FLOAT_ABI_QUAD},
};
val RISCV_RVC_CODES: [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.EF_RISCV_RVC}};
val RISCV_RVE_CODES: [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.EF_RISCV_RVE}};
val RISCV_TSO_CODES: [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.EF_RISCV_TSO}};

val ROW_COUNT: usize               = 4;
val ROWS:      [ROW_COUNT]Encoding = [ROW_COUNT]Encoding{
    Encoding{axis: ?arch.RISCV_FLOAT_ABI, mask: tables.EF_RISCV_FLOAT_ABI.value, codes: ?RISCV_FLOAT_ABI_CODES[0], count: 4, absent: Absent.refuse{}},
    Encoding{axis: ?arch.RISCV_RVC, mask: tables.EF_RISCV_RVC.value, codes: ?RISCV_RVC_CODES[0], count: 1, absent: Absent.omit{}},
    Encoding{axis: ?arch.RISCV_RVE, mask: tables.EF_RISCV_RVE.value, codes: ?RISCV_RVE_CODES[0], count: 1, absent: Absent.omit{}},
    Encoding{axis: ?arch.RISCV_TSO, mask: tables.EF_RISCV_TSO.value, codes: ?RISCV_TSO_CODES[0], count: 1, absent: Absent.omit{}},
};

# the row of `x`, none where ELF has no encoding for it
pub fun encoding_of(x: *Axis) opt[*Encoding] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].axis == x) { ret opt[*Encoding].some{?ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Encoding].none{};
}

# the code whose bits `flags` holds under the row's mask, none when they hold
# no value the row lists
pub fun held(e: *Encoding, flags: u64) opt[*Code] {
    val bits: u64   = flags & e.mask;
    var i:    usize = 0;
    for (i < e.count) {
        if (e.codes[i].value.value == bits) { ret opt[*Code].some{?e.codes[i]}; }
        i = i + 1;
    }
    ret opt[*Code].none{};
}

# what `flags` states on the row's axis, none when its bits hold no value the
# row maps
pub fun decoded(e: *Encoding, flags: u64) opt[Setting] {
    val c: opt[*Code] = held(e, flags);
    if (sel c.some)                           { ret opt[Setting].some{c.some.setting}; }
    if (e.axis.flag && (flags & e.mask) == 0) { ret opt[Setting].some{Setting.flag{false}}; }
    ret opt[Setting].none{};
}

# the bits that encode `s`, none where the row lists no code for it. a clear
# flag is encoded as no bits
fun bits_of(e: *Encoding, s: Setting) opt[u64] {
    var i: usize = 0;
    for (i < e.count) {
        if (trait.same(e.codes[i].setting, s)) { ret opt[u64].some{e.codes[i].value.value}; }
        i = i + 1;
    }
    if (sel s.flag && !s.flag) { ret opt[u64].some{0}; }
    ret opt[u64].none{};
}

# the e_flags of an object for `a` that states `ts` and keeps `rest` raw, the
# bits no row maps. raw bits a row maps are refused, as is a trait the file
# cannot encode and an unstated axis whose row refuses one
pub fun encode(a: *Arch, ts: *Table[Trait], rest: u32) res[u32, Fail] {
    var i: usize = 0;
    for (i < table.count[Trait](ts)) {
        val t: *Trait = table.at[Trait](ts, table.nth[Trait](i));
        if (!arch.has_axis(a, t.axis)) {
            ret res[u32, Fail].err{fail.about(fail.malformed("the architecture has no such trait axis"), t.axis.name)};
        }
        i = i + 1;
    }
    var out: u64 = rest::u64;
    i = 0;
    for (i < a.axis_count) {
        val x: *Axis          = a.axes[i];
        val e: opt[*Encoding] = encoding_of(x);
        val t: opt[*Trait]    = trait.find(ts, x);
        i = i + 1;
        if (sel e.none) {
            if (sel t.some) { ret res[u32, Fail].err{fail.about(fail.unsupported("ELF has no encoding for this trait axis"), x.name)}; }
            cnt;
        }
        if ((rest::u64 & e.some.mask) != 0) {
            ret res[u32, Fail].err{fail.about(fail.malformed("raw e_flags hold bits a trait row maps"), x.name)};
        }
        if (sel t.none) {
            if (sel e.some.absent.refuse) {
                ret res[u32, Fail].err{fail.about(fail.malformed("the object does not state a trait axis ELF cannot leave unstated"), x.name)};
            }
            cnt;
        }
        val b: opt[u64] = bits_of(e.some, t.some.setting);
        if (sel b.none) { ret res[u32, Fail].err{fail.about(fail.unsupported("ELF has no encoding for this trait value"), x.name)}; }
        out = out | b.some;
    }
    ret res[u32, Fail].ok{out::u32};
}

# add the traits `flags` states for an object for `a` to `out`, and give back
# the bits no row maps, which the object keeps raw. a field whose bits hold no
# value its row lists states nothing and stays raw. a refusal adds nothing
pub fun decode(a: *Arch, flags: u32, out: *Table[Trait]) res[u32, Fail] {
    val before: usize = table.count[Trait](out);
    var rest:   u64   = flags::u64;
    var i:      usize = 0;
    for (i < a.axis_count) {
        val x: *Axis          = a.axes[i];
        val e: opt[*Encoding] = encoding_of(x);
        i = i + 1;
        if (sel e.none) { cnt; }
        val s: opt[Setting] = decoded(e.some, flags::u64);
        if (sel s.none) { cnt; }
        val r: err[Fail] = trait.add(out, Trait{axis: x, setting: s.some});
        if (sel r.err) {
            table.truncate[Trait](out, before);
            ret res[u32, Fail].err{r.err};
        }
        rest = rest & ~e.some.mask;
    }
    ret res[u32, Fail].ok{rest::u32};
}

test traits__riscv_flags_round_trip_through_the_rows {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # double float and compressed code, beside a raw bit no row maps
    var ts:  Table[Trait] = table.make[Trait](a);
    val fa:  err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_FLOAT_ABI, setting: Setting.choice{?arch.RISCV_DOUBLE}});
    val rvc: err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_RVC, setting: Setting.flag{true}});
    if (sel fa.err || sel rvc.err) { ret 1; }
    val w: res[u32, Fail] = encode(?arch.RISCV64, ?ts, 0x100);
    if (sel w.err)     { ret 1; }
    if (w.ok != 0x105) { ret 1; }

    var back: Table[Trait]   = table.make[Trait](a);
    val r:    res[u32, Fail] = decode(?arch.RISCV64, w.ok, ?back);
    if (sel r.err)                      { ret 1; }
    if (r.ok != 0x100)                  { ret 1; }
    if (table.count[Trait](?back) != 4) { ret 1; }
    val f: opt[*Trait] = trait.find(?back, ?arch.RISCV_FLOAT_ABI);
    if (sel f.none)                                                      { ret 1; }
    if (!trait.same(f.some.setting, Setting.choice{?arch.RISCV_DOUBLE})) { ret 1; }
    val c: opt[*Trait] = trait.find(?back, ?arch.RISCV_RVC);
    if (sel c.none)                                      { ret 1; }
    if (!trait.same(c.some.setting, Setting.flag{true})) { ret 1; }
    val e: opt[*Trait] = trait.find(?back, ?arch.RISCV_RVE);
    if (sel e.none)                                       { ret 1; }
    if (!trait.same(e.some.setting, Setting.flag{false})) { ret 1; }

    # quad is the whole field, never single and double together
    val row: opt[*Encoding] = encoding_of(?arch.RISCV_FLOAT_ABI);
    if (sel row.none) { ret 1; }
    val q: opt[Setting] = decoded(row.some, 0x6);
    if (sel q.none)                                            { ret 1; }
    if (!trait.same(q.some, Setting.choice{?arch.RISCV_QUAD})) { ret 1; }

    # raw bits a row maps, and an unstated float ABI, are refused
    val owned: res[u32, Fail] = encode(?arch.RISCV64, ?ts, 0x1);
    if (sel owned.ok) { ret 1; }
    var bare:     Table[Trait]   = table.make[Trait](a);
    val unstated: res[u32, Fail] = encode(?arch.RISCV64, ?bare, 0);
    if (sel unstated.ok) { ret 1; }

    val r1: err[Fail] = table.release[Trait](?ts);
    val r2: err[Fail] = table.release[Trait](?back);
    val r3: err[Fail] = table.release[Trait](?bare);
    if (sel r1.err || sel r2.err || sel r3.err) { ret 1; }
    if (T.live_count(?t) != 0)                  { ret 1; }
    T.dnit(?t);
    ret 0;
}
