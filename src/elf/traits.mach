# the ELF encoding of trait axes
#
# one row per encoding ELF has of a trait axis, keyed by the axis row of the
# trait catalog and the kind of its field, giving where its value lives and
# the constant that encodes each value. a value lives in bits of e_flags, in
# bits of a GNU property whose data is one word, as the and and or feature
# properties are, or in an attribute of a subsection of the build attributes
# section. an axis may have several encodings, as AArch64 states branch
# protection both in a GNU property and in a build attribute. the writer
# encodes an object's traits through every row of each axis, and the reader
# decodes each row, refusing a file whose encodings of one axis state
# different values, so a bit or attribute a row maps is the row's alone and
# is never also kept raw.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;

use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.format;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.elf.attributes;
use mink.elf.attributes.Kind;
use mink.elf.attributes.Layout;
use mink.elf.attributes.Rule;
use mink.elf.attributes.Vendor;
use mink.elf.model;
use mink.elf.model.Elf;
use mink.elf.model.Shape;
use mink.elf.tables;
use mink.elf.tables.Constant;
use mink.fail;
use mink.fail.Fail;
use mink.index;
use mink.store;
use mink.store.Bytes;
use mink.store.Held;
use mink.table;
use mink.table.Table;

# bits of the one-word data of the GNU property of type `type`
pub rec Bits {
    type: *Constant;
    mask: u64;
}

# the attribute of tag `tag` in the subsection `vendor` of the build
# attributes section
pub rec Tagged {
    vendor: *Vendor;
    tag:    *Constant;
}

# where an axis's value lives in the file
# ---
# flags:     the bits of e_flags under this mask
# property:  bits of a GNU property. a file without the property holds none
#            of them
# attribute: an attribute. a flag is the number 1 when set and 0 when clear,
#            a number or a text is the attribute's value, and a choice is the
#            number of its code
pub tag Field: u8 {
    flags:     u64;
    property:  Bits;
    attribute: Tagged;
}

# a value of an axis and the constant whose bits, or number, encode it
pub rec Code {
    setting: Setting;
    value:   *Constant;
}

# axis:  the trait axis
# field: where its value lives
# codes: the encoding of each value. a flag in bits lists only its set
#        value, and is clear when none of its bits are set. an attribute
#        lists codes only for an axis of one of N
# count: how many
pub rec Encoding {
    axis:  *Axis;
    field: Field;
    codes: *Code;
    count: usize;
}

# a GNU property whose data is one word
pub rec Word {
    type:  u32;
    value: u32;
}

# the parts of a file the rows encode into
# ---
# flags:      e_flags
# properties: the GNU properties of one word, in the order of their types
pub rec Words {
    flags:      u32;
    properties: Table[Word];
}

# feature bits of GNU_PROPERTY_X86_FEATURE_2_NEEDED and _USED the pinned LLVM
# tables do not name
val X86_FEATURE_2_TMM:  Constant = Constant{name: "GNU_PROPERTY_X86_FEATURE_2_TMM", value: 0x400, source: "x86-64 psABI"};
val X86_FEATURE_2_MASK: Constant = Constant{name: "GNU_PROPERTY_X86_FEATURE_2_MASK", value: 0x800, source: "x86-64 psABI"};
# feature bits of GNU_PROPERTY_X86_FEATURE_1_AND the pinned LLVM tables do not name
val X86_FEATURE_1_LAM_U48: Constant = Constant{name: "GNU_PROPERTY_X86_FEATURE_1_LAM_U48", value: 0x4, source: "x86-64 psABI"};
val X86_FEATURE_1_LAM_U57: Constant = Constant{name: "GNU_PROPERTY_X86_FEATURE_1_LAM_U57", value: 0x8, source: "x86-64 psABI"};

# the RISC-V build attributes section, whose one subsection is the riscv
# vendor's: the file's attributes are in Tag_File, and every tag's value is a
# string when odd and a number when even
pub val RISCV_ATTRIBUTES: attributes.Section = attributes.Section{layout: Layout.scoped{}, type: ?tables.SHT_RISCV_ATTRIBUTES, name: ".riscv.attributes", segment: ?tables.PT_RISCV_ATTRIBUTES};
pub val RISCV_VENDOR:     Vendor             = Vendor{section: ?RISCV_ATTRIBUTES, name: "riscv", scope: 1, rule: Rule.parity{0}};

# the AArch64 build attributes section, laid out as buildattr64 gives, which
# no program header locates. aeabi_feature_and_bits states the branch
# protection features, and a consumer that does not know it may ignore it.
# aeabi_pauthabi states the pointer authentication ABI, and a consumer must
# know it. every value of both is a number
pub val AARCH64_ATTRIBUTES:       attributes.Section = attributes.Section{layout: Layout.flagged{}, type: ?tables.SHT_AARCH64_ATTRIBUTES, name: ".ARM.attributes"};
pub val AARCH64_FEATURE_AND_BITS: Vendor             = Vendor{section: ?AARCH64_ATTRIBUTES, name: "aeabi_feature_and_bits", optional: true, rule: Rule.every{Kind.number{}}};
pub val AARCH64_PAUTHABI:         Vendor             = Vendor{section: ?AARCH64_ATTRIBUTES, name: "aeabi_pauthabi", rule: Rule.every{Kind.number{}}};

# every subsection row
pub val VENDOR_COUNT: usize                 = 3;
pub val VENDORS:      [VENDOR_COUNT]*Vendor = [VENDOR_COUNT]*Vendor{?AARCH64_FEATURE_AND_BITS, ?AARCH64_PAUTHABI, ?RISCV_VENDOR};

# the tags of the build attributes the rows map. the pinned LLVM tables name
# none of them
val TAG_RISCV_STACK_ALIGN:        Constant = Constant{name: "Tag_RISCV_stack_align", value: 4, source: "RISC-V psABI"};
val TAG_RISCV_ARCH:               Constant = Constant{name: "Tag_RISCV_arch", value: 5, source: "RISC-V psABI"};
val TAG_RISCV_UNALIGNED_ACCESS:   Constant = Constant{name: "Tag_RISCV_unaligned_access", value: 6, source: "RISC-V psABI"};
val TAG_RISCV_PRIV_SPEC:          Constant = Constant{name: "Tag_RISCV_priv_spec", value: 8, source: "RISC-V psABI"};
val TAG_RISCV_PRIV_SPEC_MINOR:    Constant = Constant{name: "Tag_RISCV_priv_spec_minor", value: 10, source: "RISC-V psABI"};
val TAG_RISCV_PRIV_SPEC_REVISION: Constant = Constant{name: "Tag_RISCV_priv_spec_revision", value: 12, source: "RISC-V psABI"};
val TAG_RISCV_ATOMIC_ABI:         Constant = Constant{name: "Tag_RISCV_atomic_abi", value: 14, source: "RISC-V psABI"};
val TAG_RISCV_X3_REG_USAGE:       Constant = Constant{name: "Tag_RISCV_x3_reg_usage", value: 16, source: "RISC-V psABI"};
val TAG_FEATURE_BTI:              Constant = Constant{name: "Tag_Feature_BTI", value: 0, source: "buildattr64"};
val TAG_FEATURE_PAC:              Constant = Constant{name: "Tag_Feature_PAC", value: 1, source: "buildattr64"};
val TAG_FEATURE_GCS:              Constant = Constant{name: "Tag_Feature_GCS", value: 2, source: "buildattr64"};
val TAG_PAUTH_PLATFORM:           Constant = Constant{name: "Tag_PAuth_Platform", value: 1, source: "buildattr64"};
val TAG_PAUTH_SCHEMA:             Constant = Constant{name: "Tag_PAuth_Schema", value: 2, source: "buildattr64"};

