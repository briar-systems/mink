# the ELF encoding of trait axes
#
# one row per trait axis ELF writes, keyed by the axis row of the trait
# catalog, giving where its value lives and the constant that encodes each
# value. a value lives in bits of e_flags, in bits of a GNU property whose
# data is one word, as the and and or feature properties are, or in an
# attribute of a vendor's build attributes section. the writer encodes an
# object's traits through these rows and the reader decodes them back, so a
# bit or attribute a row maps is the row's alone and is never also kept raw.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_compare;

use A: std.allocator;
use T: std.allocator.testing;

use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.format;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.elf.attributes;
use mink.elf.attributes.Vendor;
use mink.elf.model;
use mink.elf.model.Elf;
use mink.elf.model.Shape;
use mink.elf.tables;
use mink.elf.tables.Constant;
use mink.fail;
use mink.fail.Fail;
use mink.format.contract.Encoded;
use mink.index;
use mink.store.Bytes;
use mink.store.Held;
use mink.table;
use mink.table.Table;

# bits of the one-word data of the GNU property of type `type`
pub rec Bits {
    type: *Constant;
    mask: u64;
}

# the attribute of tag `tag` in the build attributes section of `vendor`
pub rec Tagged {
    vendor: *Vendor;
    tag:    u64;
}

# where an axis's value lives in the file
# ---
# flags:     the bits of e_flags under this mask
# property:  bits of a GNU property. a file without the property holds none
#            of them
# attribute: an attribute. a flag is the number 1 when set and 0 when clear,
#            a number or a text is the attribute's value, and a choice is the
#            number of its code
pub tag Field: u8 {
    flags:     u64;
    property:  Bits;
    attribute: Tagged;
}

# a value of an axis and the constant whose bits, or number, encode it
pub rec Code {
    setting: Setting;
    value:   *Constant;
}

# axis:  the trait axis
# field: where its value lives
# codes: the encoding of each value. a flag in bits lists only its set
#        value, and is clear when none of its bits are set. an attribute
#        lists codes only for an axis of one of N
# count: how many
pub rec Encoding {
    axis:  *Axis;
    field: Field;
    codes: *Code;
    count: usize;
}

# a GNU property whose data is one word
pub rec Word {
    type:  u32;
    value: u32;
}

# the parts of a file the rows encode into
# ---
# flags:      e_flags
# properties: the GNU properties of one word, in the order of their types
pub rec Words {
    flags:      u32;
    properties: Table[Word];
}

# feature bits of GNU_PROPERTY_X86_FEATURE_2_NEEDED and _USED the pinned LLVM
# tables do not name
val X86_FEATURE_2_TMM:  Constant = Constant{name: "GNU_PROPERTY_X86_FEATURE_2_TMM", value: 0x400, source: "x86-64 psABI"};
val X86_FEATURE_2_MASK: Constant = Constant{name: "GNU_PROPERTY_X86_FEATURE_2_MASK", value: 0x800, source: "x86-64 psABI"};
# feature bits of GNU_PROPERTY_X86_FEATURE_1_AND the pinned LLVM tables do not name
val X86_FEATURE_1_LAM_U48: Constant = Constant{name: "GNU_PROPERTY_X86_FEATURE_1_LAM_U48", value: 0x4, source: "x86-64 psABI"};
val X86_FEATURE_1_LAM_U57: Constant = Constant{name: "GNU_PROPERTY_X86_FEATURE_1_LAM_U57", value: 0x8, source: "x86-64 psABI"};

# the RISC-V build attributes section: the file's attributes are in Tag_File,
# and every tag's value is a string when odd and a number when even
pub val RISCV_VENDOR: Vendor = Vendor{name: "riscv", scope: 1, parity: 0, type: ?tables.SHT_RISCV_ATTRIBUTES, section: ".riscv.attributes", segment: ?tables.PT_RISCV_ATTRIBUTES};

val RISCV_FLOAT_ABI_CODES: [4]Code = [4]Code{
    Code{setting: Setting.choice{?arch.RISCV_SOFT}, value: ?tables.EF_RISCV_FLOAT_ABI_SOFT},
    Code{setting: Setting.choice{?arch.RISCV_SINGLE}, value: ?tables.EF_RISCV_FLOAT_ABI_SINGLE},
    Code{setting: Setting.choice{?arch.RISCV_DOUBLE}, value: ?tables.EF_RISCV_FLOAT_ABI_DOUBLE},
    Code{setting: Setting.choice{?arch.RISCV_QUAD}, value: ?tables.EF_RISCV_FLOAT_ABI_QUAD},
};
val RISCV_RVC_CODES:   [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.EF_RISCV_RVC}};
val RISCV_RVE_CODES:   [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.EF_RISCV_RVE}};
val RISCV_TSO_CODES:   [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.EF_RISCV_TSO}};
val AARCH64_BTI_CODES: [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.GNU_PROPERTY_AARCH64_FEATURE_1_BTI}};
val AARCH64_PAC_CODES: [1]Code = [1]Code{Code{setting: Setting.flag{true}, value: ?tables.GNU_PROPERTY_AARCH64_FEATURE_1_PAC}};

val RISCV_FLOAT_ABI_ROW: Encoding = Encoding{axis: ?arch.RISCV_FLOAT_ABI, field: Field.flags{tables.EF_RISCV_FLOAT_ABI.value}, codes: ?RISCV_FLOAT_ABI_CODES[0], count: 4};
val RISCV_RVC_ROW:       Encoding = Encoding{axis: ?arch.RISCV_RVC, field: Field.flags{tables.EF_RISCV_RVC.value}, codes: ?RISCV_RVC_CODES[0], count: 1};
