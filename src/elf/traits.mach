val ROW_COUNT: usize                = 59;
val ROWS:      [ROW_COUNT]*Encoding = [ROW_COUNT]*Encoding{?RISCV_FLOAT_ABI_ROW, ?RISCV_RVC_ROW, ?RISCV_RVE_ROW, ?RISCV_TSO_ROW, ?AARCH64_BTI_ROW, ?AARCH64_PAC_ROW, ?AARCH64_GCS_ROW, ?X86_IBT_ROW, ?X86_SHSTK_ROW, ?X86_LAM_U48_ROW, ?X86_LAM_U57_ROW, ?X86_ISA_NEEDED_BASELINE_ROW, ?X86_ISA_NEEDED_V2_ROW, ?X86_ISA_NEEDED_V3_ROW, ?X86_ISA_NEEDED_V4_ROW, ?X86_ISA_USED_BASELINE_ROW, ?X86_ISA_USED_V2_ROW, ?X86_ISA_USED_V3_ROW, ?X86_ISA_USED_V4_ROW, ?X86_FEATURE_NEEDED_X86_ROW, ?X86_FEATURE_NEEDED_X87_ROW, ?X86_FEATURE_NEEDED_MMX_ROW, ?X86_FEATURE_NEEDED_XMM_ROW, ?X86_FEATURE_NEEDED_YMM_ROW, ?X86_FEATURE_NEEDED_ZMM_ROW, ?X86_FEATURE_NEEDED_FXSR_ROW, ?X86_FEATURE_NEEDED_XSAVE_ROW, ?X86_FEATURE_NEEDED_XSAVEOPT_ROW, ?X86_FEATURE_NEEDED_XSAVEC_ROW, ?X86_FEATURE_NEEDED_TMM_ROW, ?X86_FEATURE_NEEDED_MASK_ROW, ?X86_FEATURE_USED_X86_ROW, ?X86_FEATURE_USED_X87_ROW, ?X86_FEATURE_USED_MMX_ROW, ?X86_FEATURE_USED_XMM_ROW, ?X86_FEATURE_USED_YMM_ROW, ?X86_FEATURE_USED_ZMM_ROW, ?X86_FEATURE_USED_FXSR_ROW, ?X86_FEATURE_USED_XSAVE_ROW, ?X86_FEATURE_USED_XSAVEOPT_ROW, ?X86_FEATURE_USED_XSAVEC_ROW, ?X86_FEATURE_USED_TMM_ROW, ?X86_FEATURE_USED_MASK_ROW, ?RISCV_STACK_ALIGN_ROW, ?RISCV_ARCH_ROW, ?RISCV_UNALIGNED_ACCESS_ROW, ?RISCV_PRIV_SPEC_ROW, ?RISCV_PRIV_SPEC_MINOR_ROW, ?RISCV_PRIV_SPEC_REVISION_ROW, ?RISCV_ATOMIC_ABI_ROW, ?RISCV_X3_REG_USAGE_ROW, ?RISCV_CFI_LP_UNLABELED_ROW, ?RISCV_CFI_SS_ROW, ?RISCV_CFI_LP_FUNC_SIG_ROW, ?AARCH64_BTI_ATTRIBUTE_ROW, ?AARCH64_PAC_ATTRIBUTE_ROW, ?AARCH64_GCS_ATTRIBUTE_ROW, ?AARCH64_PAUTH_PLATFORM_ROW, ?AARCH64_PAUTH_VERSION_ROW};
# the rows by axis name, then by the kind of their field
val AXES: [ROW_COUNT]*Encoding = [ROW_COUNT]*Encoding{?AARCH64_BTI_ROW, ?AARCH64_BTI_ATTRIBUTE_ROW, ?AARCH64_GCS_ROW, ?AARCH64_GCS_ATTRIBUTE_ROW, ?AARCH64_PAC_ROW, ?AARCH64_PAC_ATTRIBUTE_ROW, ?AARCH64_PAUTH_PLATFORM_ROW, ?AARCH64_PAUTH_VERSION_ROW, ?RISCV_ARCH_ROW, ?RISCV_ATOMIC_ABI_ROW, ?RISCV_CFI_LP_FUNC_SIG_ROW, ?RISCV_CFI_LP_UNLABELED_ROW, ?RISCV_CFI_SS_ROW, ?RISCV_FLOAT_ABI_ROW, ?RISCV_PRIV_SPEC_ROW, ?RISCV_PRIV_SPEC_MINOR_ROW, ?RISCV_PRIV_SPEC_REVISION_ROW, ?RISCV_RVC_ROW, ?RISCV_RVE_ROW, ?RISCV_STACK_ALIGN_ROW, ?RISCV_TSO_ROW, ?RISCV_UNALIGNED_ACCESS_ROW, ?RISCV_X3_REG_USAGE_ROW, ?X86_FEATURE_NEEDED_FXSR_ROW, ?X86_FEATURE_NEEDED_MASK_ROW, ?X86_FEATURE_NEEDED_MMX_ROW, ?X86_FEATURE_NEEDED_TMM_ROW, ?X86_FEATURE_NEEDED_X86_ROW, ?X86_FEATURE_NEEDED_X87_ROW, ?X86_FEATURE_NEEDED_XMM_ROW, ?X86_FEATURE_NEEDED_XSAVE_ROW, ?X86_FEATURE_NEEDED_XSAVEC_ROW, ?X86_FEATURE_NEEDED_XSAVEOPT_ROW, ?X86_FEATURE_NEEDED_YMM_ROW, ?X86_FEATURE_NEEDED_ZMM_ROW, ?X86_FEATURE_USED_FXSR_ROW, ?X86_FEATURE_USED_MASK_ROW, ?X86_FEATURE_USED_MMX_ROW, ?X86_FEATURE_USED_TMM_ROW, ?X86_FEATURE_USED_X86_ROW, ?X86_FEATURE_USED_X87_ROW, ?X86_FEATURE_USED_XMM_ROW, ?X86_FEATURE_USED_XSAVE_ROW, ?X86_FEATURE_USED_XSAVEC_ROW, ?X86_FEATURE_USED_XSAVEOPT_ROW, ?X86_FEATURE_USED_YMM_ROW, ?X86_FEATURE_USED_ZMM_ROW, ?X86_IBT_ROW, ?X86_ISA_NEEDED_BASELINE_ROW, ?X86_ISA_NEEDED_V2_ROW, ?X86_ISA_NEEDED_V3_ROW, ?X86_ISA_NEEDED_V4_ROW, ?X86_ISA_USED_BASELINE_ROW, ?X86_ISA_USED_V2_ROW, ?X86_ISA_USED_V3_ROW, ?X86_ISA_USED_V4_ROW, ?X86_LAM_U48_ROW, ?X86_LAM_U57_ROW, ?X86_SHSTK_ROW};

# the order of the kinds of field, the second key of the rows of one axis
fun rank(e: *Encoding) u8 {
    if (sel e.field.flags)    { ret 0; }
    or (sel e.field.property) { ret 1; }
    ret 2;
}

fun order_axes(a: **Encoding, b: **Encoding) i64 {
    val names: i64 = str_compare(a[0].axis.name, b[0].axis.name);
    if (names != 0)              { ret names; }
    if (rank(a[0]) < rank(b[0])) { ret -1; }
    if (rank(a[0]) > rank(b[0])) { ret 1; }
    ret 0;
}

# the rows of an axis, one for each encoding ELF has of it
# ---
# at:    the first, nil for none
# count: how many
pub rec Rows {
    at:    **Encoding;
    count: usize;
}

# the rows of `x`, none where ELF has no encoding for it
pub fun encodings_of(x: *Axis) Rows {
    var lo: usize = 0;
    var hi: usize = ROW_COUNT;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (str_compare(AXES[mid].axis.name, x.name) < 0) { lo = mid + 1; }
        or                                                { hi = mid; }
    }
    var n: usize = 0;
    for (lo + n < ROW_COUNT && AXES[lo + n].axis == x) {
        n = n + 1;
    }
    if (n == 0) { ret Rows{at: nil, count: 0}; }
    ret Rows{at: ?AXES[lo], count: n};
}

# the name of what holds the row's value in the file: an attribute's tag, a
# flag's bit, or the GNU property or e_flags that holds the bits
pub fun place(e: *Encoding) str {
    if (sel e.field.attribute)                   { ret e.field.attribute.tag.name; }
    if ((sel e.axis.value.flag) && e.count == 1) { ret e.codes[0].value.name; }
    if (sel e.field.property)                    { ret e.field.property.type.name; }
    ret "e_flags";
}

# the bits of its field the row owns, none for an attribute
pub fun mask(e: *Encoding) u64 {
    if (sel e.field.flags)     { ret e.field.flags; }
    or (sel e.field.attribute) { ret 0; }
    ret e.field.property.mask;
}

# the ELF machine code of an architecture and the class and byte order its
# files take
pub rec Machine {
    code:  format.Code;
    shape: Shape;
}

# the machine of `a`, refused for an architecture ELF has no code for
pub fun machine_of(a: *Arch) res[Machine, Fail] {
    val code: opt[format.Code] = arch.code(a, ?format.ELF);
    if (sel code.none) { ret res[Machine, Fail].err{fail.unsupported("the architecture has no ELF code")}; }
    var class: *model.Class = ?model.CLASS32;
    if (code.some.qualifier == tables.ELFCLASS64.value::u32) { class = ?model.CLASS64; }
    ret res[Machine, Fail].ok{Machine{code: code.some, shape: Shape{class: class, order: a.order}}};
}

# whether the row's value lives in e_flags or a GNU property word
fun worded(e: *Encoding) bool {
    ret !(sel e.field.attribute);
}

# the architecture of `m`, by its machine and class
pub fun arch_of(m: *Elf) res[*Arch, Fail] {
    var cls: u64 = tables.ELFCLASS32.value::u64;
    if (m.shape.class.addr == 8) { cls = tables.ELFCLASS64.value::u64; }
    ret arch.by_code(?format.ELF, m.header.machine::u32, cls::u32);
}

# the word of the GNU property `type` of a file for `a` whose notes state
# `held` and `next`. each bit a row maps merges by its axis's rule, and a bit
# no row maps carries nothing, so one set in either is refused naming the
# type and the bit
pub fun merge_word(a: *Arch, type: u32, held: u32, next: u32) res[u32, Fail] {
    var out:    u64   = 0;
    var mapped: u64   = 0;
    var i:      usize = 0;
    for (i < a.axis_count) {
        val rows: Rows  = encodings_of(a.axes[i]);
        var k:    usize = 0;
        i = i + 1;
        for (k < rows.count) {
            val e: *Encoding = rows.at[k];
            k = k + 1;
            if (!(sel e.field.property))                  { cnt; }
            if (e.field.property.type.value::u32 != type) { cnt; }
            val m:  u64          = e.field.property.mask;
            val sh: opt[Setting] = decoded(e, held::u64 & m);
            val sn: opt[Setting] = decoded(e, next::u64 & m);
            if (sel sh.none) { ret res[u32, Fail].err{fail.about(fail.unsupported("GNU property notes hold bits that state no value of a trait axis"), e.axis.name)}; }
            if (sel sn.none) { ret res[u32, Fail].err{fail.about(fail.unsupported("GNU property notes hold bits that state no value of a trait axis"), e.axis.name)}; }
            val s: opt[Setting] = trait.merge(e.axis, sh.some, sn.some);
            if (sel s.none) { ret res[u32, Fail].err{fail.about(fail.unsupported("GNU property notes state values of a trait axis that do not merge"), e.axis.name)}; }
            val b: opt[u64] = bits_of(e, s.some);
            if (sel b.none) { ret res[u32, Fail].err{fail.about(fail.unsupported("ELF has no encoding for this trait value"), e.axis.name)}; }
            out    = out | b.some;
            mapped = mapped | m;
        }
    }
    val left: u64 = (held::u64 | next::u64) & ~mapped;
    if (left != 0) {
        ret res[u32, Fail].err{fail.valued(fail.in_indexed(fail.unsupported("GNU property notes hold a bit no trait row maps"), "GNU property", type::u64), (left & (~left + 1))::i128)};
    }
    ret res[u32, Fail].ok{out::u32};
}

pub fun make_words(a: *A.Allocator, flags: u32) Words {
    ret Words{flags: flags, properties: table.make[Word](a)};
}

pub fun release_words(w: *Words) err[Fail] {
    ret table.release[Word](?w.properties);
}

fun order_words(a: *Word, b: *Word) i64 {
    if (a.type < b.type) { ret -1; }
    if (a.type > b.type) { ret 1; }
    ret 0;
}

fun word_at(w: *Words, type: u32) SearchPosition {
    var probe: Word = Word{type: type};
    ret sort.binary_search_by[Word](table.items[Word](?w.properties), table.count[Word](?w.properties), ?probe, order_words);
}

# the property of `type` in `w`, none when the file has none
pub fun word(w: *Words, type: u32) opt[*Word] {
    val at: SearchPosition = word_at(w, type);
    if (sel at.found) { ret opt[*Word].some{table.at[Word](?w.properties, table.nth[Word](at.found))}; }
    ret opt[*Word].none{};
}

# add the property `p` the file holds, refusing a type it holds twice
pub fun add_word(w: *Words, p: Word) err[Fail] {
    val at: SearchPosition = word_at(w, p.type);
    if (sel at.found) { ret err[Fail].err{fail.valued(fail.malformed("a GNU property type is held twice"), p.type::i128)}; }
    ret table.insert[Word](?w.properties, at.insertion, p);
}

# the bits of `w` in the row's field, none for an attribute
pub fun bits_in(e: *Encoding, w: *Words) u64 {
    if (sel e.field.flags)     { ret w.flags::u64 & e.field.flags; }
    or (sel e.field.attribute) { ret 0; }
    val p: opt[*Word] = word(w, e.field.property.type.value::u32);
    if (sel p.some) { ret p.some.value::u64 & e.field.property.mask; }
    ret 0;
}

# the code whose bits are `bits`, none when no code of the row has them
pub fun held(e: *Encoding, bits: u64) opt[*Code] {
    var i: usize = 0;
    for (i < e.count) {
        if (e.codes[i].value.value == bits) { ret opt[*Code].some{?e.codes[i]}; }
        i = i + 1;
    }
    ret opt[*Code].none{};
}

# what the field bits `bits` state on the row's axis, none when they hold no
# value the row maps
pub fun decoded(e: *Encoding, bits: u64) opt[Setting] {
    val c: opt[*Code] = held(e, bits);
    if (sel c.some)                           { ret opt[Setting].some{c.some.setting}; }
    if ((sel e.axis.value.flag) && bits == 0) { ret opt[Setting].some{Setting.flag{false}}; }
    ret opt[Setting].none{};
}

# whether the file cannot leave the row's axis unstated, as its field holding
# no bits reads back as a value, the way a missing flag reads back clear. an
# attribute is left out of the file, so its axis can be
pub fun required(e: *Encoding) bool {
    if (!worded(e)) { ret false; }
    val s: opt[Setting] = decoded(e, 0);
    ret sel s.some;
}

# the bits that encode `s`, none where the row lists no code for it. a clear
# flag is encoded as no bits
fun bits_of(e: *Encoding, s: Setting) opt[u64] {
    var i: usize = 0;
    for (i < e.count) {
        if (trait.same(e.codes[i].setting, s)) { ret opt[u64].some{e.codes[i].value.value}; }
        i = i + 1;
    }
    if (sel s.flag && !s.flag) { ret opt[u64].some{0}; }
    ret opt[u64].none{};
}

# what the row `e` of e_flags or a GNU property writes for the trait `t` of
# its axis, none for nothing, or the refusal
fun encoded(e: *Encoding, t: opt[*Trait], w: *Words) res[opt[u64], Fail] {
    if (bits_in(e, w) != 0) {
        ret res[opt[u64], Fail].err{fail.about(fail.malformed("raw bits of the file hold bits a trait row maps"), e.axis.name)};
    }
    if (sel t.none) {
        if (required(e)) {
            ret res[opt[u64], Fail].err{fail.about(fail.unsupported("the object leaves unstated a trait axis ELF cannot leave unstated"), e.axis.name)};
        }
        ret res[opt[u64], Fail].ok{opt[u64].none{}};
    }
    val b: opt[u64] = bits_of(e, t.some.setting);
    if (sel b.none) { ret res[opt[u64], Fail].err{fail.about(fail.unsupported("ELF has no encoding for this trait value"), e.axis.name)}; }
    ret res[opt[u64], Fail].ok{b};
}

# encode the traits `ts` of an object for `a` into `w`, which holds the raw
# bits no row maps, through every row of each axis in e_flags or a GNU
# property. raw bits a row maps are refused, as are a trait the file cannot
# encode and an unstated axis the file cannot leave unstated. a property is
# added only when it has bits to hold. a refusal leaves `w` as it was
pub fun encode(a: *Arch, ts: *Table[Trait], w: *Words) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Trait](ts)) {
        val t: *Trait = table.at[Trait](ts, table.nth[Trait](i));
        if (!arch.has_axis(a, t.axis)) {
            ret err[Fail].err{fail.about(fail.malformed("the architecture has no such trait axis"), t.axis.name)};
        }
        i = i + 1;
    }
    var flags: u64   = 0;
    var added: usize = 0;
    i = 0;
    for (i < a.axis_count) {
        val x:    *Axis       = a.axes[i];
        val rows: Rows        = encodings_of(x);
        val t:    opt[*Trait] = trait.find(ts, x);
        i = i + 1;
        if (rows.count == 0 && sel t.some) {
            ret err[Fail].err{fail.about(fail.unsupported("ELF has no encoding for this trait axis"), x.name)};
        }
        var k: usize = 0;
        for (k < rows.count) {
            val e: *Encoding = rows.at[k];
            k = k + 1;
            if (!worded(e)) { cnt; }
            val b: res[opt[u64], Fail] = encoded(e, t, w);
            if (sel b.err)         { ret err[Fail].err{b.err}; }
            if (sel b.ok.none)     { cnt; }
            if (sel e.field.flags) { flags = flags | b.ok.some; }
            or                     { added = added + 1; }
        }
    }
    val room: err[Fail] = table.reserve[Word](?w.properties, added);
    if (sel room.err) { ret room; }
    i = 0;
    for (i < a.axis_count) {
        val rows: Rows        = encodings_of(a.axes[i]);
        val t:    opt[*Trait] = trait.find(ts, a.axes[i]);
        i = i + 1;
        if (sel t.none) { cnt; }
        var k: usize = 0;
        for (k < rows.count) {
            val e: *Encoding = rows.at[k];
            k = k + 1;
            if (!(sel e.field.property)) { cnt; }
            val b: opt[u64] = bits_of(e, t.some.setting);
            if (sel b.none)  { cnt; }
            if (b.some == 0) { cnt; }
            val type: u32        = e.field.property.type.value::u32;
            val p:    opt[*Word] = word(w, type);
            if (sel p.some) {
                p.some.value = p.some.value | b.some::u32;
                cnt;
            }
            val put: err[Fail] = add_word(w, Word{type: type, value: b.some::u32});
            if (sel put.err) { ret put; }
        }
    }
    w.flags = w.flags | flags::u32;
    ret err[Fail].ok{};
}

# what one encoding of an axis states in a file
pub rec Reading {
    row:     *Encoding;
    setting: Setting;
}

# add to `out` what each row in e_flags or a GNU property states for an
# object for `a` through `w`, and clear their bits from `w`, which keeps the
# bits no row maps. a field whose bits hold no value its row lists states
# nothing and stays raw, and a missing property states its flags clear. a
# refusal changes neither `out` nor `w`
pub fun decode(a: *Arch, w: *Words, out: *Table[Reading]) err[Fail] {
    var n: usize = 0;
    var i: usize = 0;
    for (i < a.axis_count) {
        val rows: Rows  = encodings_of(a.axes[i]);
        var k:    usize = 0;
        i = i + 1;
        for (k < rows.count) {
            val e: *Encoding = rows.at[k];
            k = k + 1;
            if (!worded(e)) { cnt; }
            val s: opt[Setting] = decoded(e, bits_in(e, w));
            if (sel s.some) { n = n + 1; }
        }
    }
    val room: err[Fail] = table.reserve[Reading](out, n);
    if (sel room.err) { ret room; }
    i = 0;
    for (i < a.axis_count) {
        val rows: Rows  = encodings_of(a.axes[i]);
        var k:    usize = 0;
        i = i + 1;
        for (k < rows.count) {
            val e: *Encoding = rows.at[k];
            k = k + 1;
            if (!worded(e)) { cnt; }
            val s: opt[Setting] = decoded(e, bits_in(e, w));
            if (sel s.none) { cnt; }
            val r: res[table.Id[Reading], Fail] = table.push[Reading](out, Reading{row: e, setting: s.some});
            if (sel r.err) { ret err[Fail].err{r.err}; }
            clear(e, w);
        }
    }
    ret err[Fail].ok{};
}

# clear from `w` the bits the row `e` of e_flags or a GNU property owns
fun clear(e: *Encoding, w: *Words) {
    if (sel e.field.flags) {
        w.flags = w.flags & ~(e.field.flags::u32);
        ret;
    }
    or (sel e.field.attribute) { ret; }
    val p: opt[*Word] = word(w, e.field.property.type.value::u32);
    if (sel p.some) { p.some.value = p.some.value & ~(e.field.property.mask::u32); }
}

fun order_readings(a: *Reading, b: *Reading) i64 {
    var x: *Encoding = a.row;
    var y: *Encoding = b.row;
    ret order_axes(?x, ?y);
}

# whether two readings state the same value, texts by their bytes, which lie
# at `base` when owned
fun agree(base: *u8, a: *Reading, b: *Reading) bool {
    if (sel a.setting.text) {
        if (sel b.setting.text) { ret trait.same_bytes(store.at(base, ?a.setting.text), store.at(base, ?b.setting.text)); }
        ret false;
    }
    ret trait.same(a.setting, b.setting);
}

# state on `out` each axis the readings `rs` state, which this sorts by axis.
# the texts they own lie at `base`. readings of one axis that state
# different values are refused, naming the places of both, as are a setting
# its axis does not have and an axis `out` already states. a refusal leaves
# `out` as it was
pub fun reconcile(rs: *Table[Reading], base: *u8, out: *Table[Trait]) err[Fail] {
    val n: usize = table.count[Reading](rs);
    sort.sort_by[Reading](table.items[Reading](rs), n, order_readings);
    val at:   *Reading = table.items[Reading](rs);
    var axes: usize    = 0;
    var i:    usize    = 0;
    for (i < n) {
        val r: *Reading = ?at[i];
        i = i + 1;
        if (i > 1 && at[i - 2].row.axis == r.row.axis) {
            if (!agree(base, ?at[i - 2], r)) {
                ret err[Fail].err{fail.about(fail.in_record(fail.unsupported("two encodings of a trait axis state different values"), place(at[i - 2].row)), place(r.row))};
            }
            cnt;
        }
        if (!trait.fits(r.row.axis, r.setting)) {
            ret err[Fail].err{fail.about(fail.malformed("the setting is not a value of its trait axis"), r.row.axis.name)};
        }
        val known: opt[*Trait] = trait.find(out, r.row.axis);
        if (sel known.some) { ret err[Fail].err{fail.about(fail.malformed("a trait axis is stated twice"), r.row.axis.name)}; }
        axes = axes + 1;
    }
    val room: err[Fail] = table.reserve[Trait](out, axes);
    if (sel room.err) { ret room; }
    i = 0;
    for (i < n) {
        val r: *Reading = ?at[i];
        i = i + 1;
        if (i > 1 && at[i - 2].row.axis == r.row.axis) { cnt; }
        val added: err[Fail] = trait.add(out, Trait{axis: r.row.axis, setting: r.setting});
        if (sel added.err) { ret added; }
    }
    ret err[Fail].ok{};
}

# whether a row is consistent: each code fits its axis, the rows of a field
# share no bit and no attribute, a value in bits lies in its row's bits and a
# flag in bits has one code with bits, a value in bits is a flag or a choice,
# an attribute of a choice lists one code of its own number for each choice
# and other attributes list none, and an attribute's vendor encodes its tag
# as a string exactly when its value is a text and as a number otherwise. a
# pair, as the Arm aeabi Tag_compatibility holds, is no axis's value and
# stays a fact: no architecture row has one, and its merge, a flag and the
# toolchain the code is compatible with, is none of the catalog's rules
fun consistent(e: *Encoding) bool {
    val bits: bool  = worded(e);
    var i:    usize = 0;
    for (i < e.count) {
        val c: *Code = ?e.codes[i];
        if (!trait.fits(e.axis, c.setting))          { ret false; }
        if (bits && (c.value.value & ~mask(e)) != 0) { ret false; }
        i = i + 1;
    }
    if (bits && (sel e.axis.value.number || sel e.axis.value.text))                       { ret false; }
    if (bits && (sel e.axis.value.flag) && (e.count != 1 || e.codes[0].value.value == 0)) { ret false; }
    if (sel e.field.attribute) {
        val kind: Kind = attributes.kind_of(e.field.attribute.vendor, e.field.attribute.tag.value);
        if (!(sel e.axis.value.choice) && e.count != 0)           { ret false; }
        if ((sel e.axis.value.choice) && e.count != e.axis.count) { ret false; }
        if ((sel kind.text) != (sel e.axis.value.text))           { ret false; }
        if (sel kind.pair)                                        { ret false; }
        if (!attributes.consistent(e.field.attribute.vendor))     { ret false; }
        var c: usize = 0;
        for (c < e.count) {
            var d: usize = 0;
            for (d < c) {
                if (e.codes[d].value.value == e.codes[c].value.value)   { ret false; }
                if (trait.same(e.codes[d].setting, e.codes[c].setting)) { ret false; }
                d = d + 1;
            }
            c = c + 1;
        }
    }
    var k: usize = 0;
    for (k < ROW_COUNT) {
        val o: *Encoding = ROWS[k];
        if (o != e && shares(o, e) && (!bits || (mask(o) & mask(e)) != 0)) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether two rows write the same field, for attributes the same attribute
fun shares(a: *Encoding, b: *Encoding) bool {
    if (sel a.field.flags) { ret sel b.field.flags; }
    or (sel a.field.attribute) {
        if (sel b.field.attribute) { ret a.field.attribute.vendor == b.field.attribute.vendor && a.field.attribute.tag.value == b.field.attribute.tag.value; }
        ret false;
    }
    if (sel b.field.property) { ret a.field.property.type == b.field.property.type; }
    ret false;
}

# the build attributes section that holds traits of `a`, none when no row of
# its axes is an attribute. the attribute rows of one architecture's axes
# name subsections of one section
pub fun section_of(a: *Arch) opt[*attributes.Section] {
    var i: usize = 0;
    for (i < a.axis_count) {
        val rows: Rows  = encodings_of(a.axes[i]);
        var k:    usize = 0;
        i = i + 1;
        for (k < rows.count) {
            val e: *Encoding = rows.at[k];
            k = k + 1;
            if (sel e.field.attribute) { ret opt[*attributes.Section].some{e.field.attribute.vendor.section}; }
        }
    }
    ret opt[*attributes.Section].none{};
}

# the one subsection row of section `s`, which holds the attributes no row
# maps, none when it has more than one
pub fun sole_vendor(s: *attributes.Section) opt[*Vendor] {
    var one: *Vendor = nil;
    var i:   usize   = 0;
    for (i < VENDOR_COUNT) {
        if (VENDORS[i].section == s) {
            if (one != nil) { ret opt[*Vendor].none{}; }
            one = VENDORS[i];
        }
        i = i + 1;
    }
    if (one == nil) { ret opt[*Vendor].none{}; }
    ret opt[*Vendor].some{one};
}

# the row of the attribute `tag` of `v` among the axes of `a`, none when no
# row maps it
pub fun attribute_row(a: *Arch, v: *Vendor, tag: u64) opt[*Encoding] {
    var i: usize = 0;
    for (i < a.axis_count) {
        val rows: Rows  = encodings_of(a.axes[i]);
        var k:    usize = 0;
        i = i + 1;
        for (k < rows.count) {
            val e: *Encoding = rows.at[k];
            k = k + 1;
            if (sel e.field.attribute) {
                if (e.field.attribute.vendor == v && e.field.attribute.tag.value == tag) { ret opt[*Encoding].some{e}; }
            }
        }
    }
    ret opt[*Encoding].none{};
}

# what the attribute value `v` states on the axis of the attribute row `e`,
# none when it is not a value the row reads. a text is borrowed from where
# the value lies
pub fun attribute_setting(e: *Encoding, v: attributes.Value) opt[Setting] {
    if (sel v.text) {
        if (sel e.axis.value.text) { ret opt[Setting].some{Setting.text{Held.borrowed{v.text}}}; }
        ret opt[Setting].none{};
    }
    or (sel v.pair)              { ret opt[Setting].none{}; }
    if (sel e.axis.value.number) { ret opt[Setting].some{Setting.number{v.number}}; }
    if (sel e.axis.value.flag) {
        if (v.number == 0) { ret opt[Setting].some{Setting.flag{false}}; }
        if (v.number == 1) { ret opt[Setting].some{Setting.flag{true}}; }
        ret opt[Setting].none{};
    }
    val c: opt[*Code] = held(e, v.number);
    if (sel c.some) { ret opt[Setting].some{c.some.setting}; }
    ret opt[Setting].none{};
}

# the value the attribute row `e` writes for `s`, whose bytes are `text` for a
# text, none where the row has no value for it
pub fun attribute_value(e: *Encoding, s: Setting, text: Bytes) opt[attributes.Value] {
    if (sel s.text)   { ret opt[attributes.Value].some{attributes.Value.text{text}}; }
    if (sel s.number) { ret opt[attributes.Value].some{attributes.Value.number{s.number}}; }
    if (sel s.flag) {
        if (s.flag) { ret opt[attributes.Value].some{attributes.Value.number{1}}; }
        ret opt[attributes.Value].some{attributes.Value.number{0}};
    }
    val b: opt[u64] = bits_of(e, s);
    if (sel b.some) { ret opt[attributes.Value].some{attributes.Value.number{b.some}}; }
    ret opt[attributes.Value].none{};
}

# whether `v` is one of the subsection rows
fun listed(v: *Vendor) bool {
    var i: usize = 0;
    for (i < VENDOR_COUNT) {
        if (VENDORS[i] == v) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether every attribute row of the axes of `a` names a subsection of one section
fun one_section(a: *Arch) bool {
    val s: opt[*attributes.Section] = section_of(a);
    var i: usize                    = 0;
    for (i < a.axis_count) {
        val rows: Rows  = encodings_of(a.axes[i]);
        var k:    usize = 0;
        i = i + 1;
        for (k < rows.count) {
            val e: *Encoding = rows.at[k];
            k = k + 1;
            if (sel e.field.attribute) {
                if (!(sel s.some && s.some == e.field.attribute.vendor.section)) { ret false; }
            }
        }
    }
    ret true;
}

test traits__rows_are_consistent_and_the_index_holds {
    val rows: [ROW_COUNT]*Encoding = ROWS;
    var i:    usize                = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        val e: *Encoding = ROWS[i];
        if (sel e.field.attribute) {
            if (!listed(e.field.attribute.vendor)) { ret 2; }
        }
        i = i + 1;
    }
    val built: err[Fail] = index.verify[Encoding](?AXES[0], ROW_COUNT, ?rows[0], ROW_COUNT, order_axes);
    if (sel built.err) { ret 1; }
    i = 0;
    for (i < VENDOR_COUNT) {
        if (!attributes.consistent(VENDORS[i])) { ret 3; }
        var j: usize = 0;
        for (j < i) {
            if (VENDORS[j] == VENDORS[i]) { ret 3; }
            j = j + 1;
        }
        i = i + 1;
    }
    val archs: [5]*Arch = [5]*Arch{?arch.X86_64, ?arch.X86, ?arch.AARCH64, ?arch.RISCV64, ?arch.RISCV32};
    i = 0;
    for (i < 5) {
        if (!one_section(archs[i])) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

# decode `w` for `x` and state what it reads on `out`
fun read_words(a: *A.Allocator, x: *Arch, w: *Words, out: *Table[Trait]) err[Fail] {
    var rs: Table[Reading] = table.make[Reading](a);
    var r:  err[Fail]      = decode(x, w, ?rs);
    if (!(sel r.err)) { r = reconcile(?rs, nil, out); }
    val rel: err[Fail] = table.release[Reading](?rs);
    if (sel r.err) { ret r; }
    ret rel;
}

test traits__flags_and_properties_round_trip_through_the_rows {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # double float and compressed code are 0x5, beside a raw bit no row maps
    var ts:  Table[Trait] = table.make[Trait](a);
    val fa:  err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_FLOAT_ABI, setting: Setting.choice{?arch.RISCV_DOUBLE}});
    val rvc: err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_RVC, setting: Setting.flag{true}});
    val rve: err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_RVE, setting: Setting.flag{false}});
    val tso: err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_TSO, setting: Setting.flag{false}});
    val lp:  err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_CFI_LP_UNLABELED, setting: Setting.flag{false}});
    val ss:  err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_CFI_SS, setting: Setting.flag{false}});
    val sig: err[Fail]    = trait.add(?ts, Trait{axis: ?arch.RISCV_CFI_LP_FUNC_SIG, setting: Setting.flag{false}});
    if (sel fa.err || sel rvc.err || sel rve.err || sel tso.err) { ret 1; }
    if (sel lp.err || sel ss.err || sel sig.err)                 { ret 1; }
    var w:  Words     = make_words(a, 0);
    val w0: err[Fail] = encode(?arch.RISCV64, ?ts, ?w);
    if (sel w0.err || w.flags != 0x5) { ret 1; }
    w.flags = 0x100;
    val w1: err[Fail] = encode(?arch.RISCV64, ?ts, ?w);
    if (sel w1.err || w.flags != 0x105) { ret 1; }

    var back: Table[Trait] = table.make[Trait](a);
    val r:    err[Fail]    = read_words(a, ?arch.RISCV64, ?w, ?back);
    if (sel r.err || w.flags != 0x100)  { ret 1; }
    if (table.count[Trait](?back) != 7) { ret 1; }
    val f: opt[*Trait] = trait.find(?back, ?arch.RISCV_FLOAT_ABI);
    if (sel f.none)                                                      { ret 1; }
    if (!trait.same(f.some.setting, Setting.choice{?arch.RISCV_DOUBLE})) { ret 1; }
    val c: opt[*Trait] = trait.find(?back, ?arch.RISCV_RVC);
    if (sel c.none)                                      { ret 1; }
    if (!trait.same(c.some.setting, Setting.flag{true})) { ret 1; }
    val e: opt[*Trait] = trait.find(?back, ?arch.RISCV_RVE);
    if (sel e.none)                                       { ret 1; }
    if (!trait.same(e.some.setting, Setting.flag{false})) { ret 1; }

    # quad is the whole field, never single and double together
    val q: opt[Setting] = decoded(?RISCV_FLOAT_ABI_ROW, 0x6);
    if (sel q.none)                                            { ret 1; }
    if (!trait.same(q.some, Setting.choice{?arch.RISCV_QUAD})) { ret 1; }

    # raw bits a row maps, and an unstated float ABI, are refused
    w.flags = 0x1;
    val owned: err[Fail] = encode(?arch.RISCV64, ?ts, ?w);
    if (sel owned.ok || w.flags != 0x1) { ret 1; }
    var bare:     Table[Trait] = table.make[Trait](a);
    var none:     Words        = make_words(a, 0);
    val unstated: err[Fail]    = encode(?arch.RISCV64, ?bare, ?none);
    if (sel unstated.ok) { ret 1; }

    # bti is a bit of the and feature property, which encode adds and decode
    # clears, and a file without the property states bti, pac and gcs clear
    var feat: Table[Trait] = table.make[Trait](a);
    val bti:  err[Fail]    = trait.add(?feat, Trait{axis: ?arch.AARCH64_BTI, setting: Setting.flag{true}});
    val pac:  err[Fail]    = trait.add(?feat, Trait{axis: ?arch.AARCH64_PAC, setting: Setting.flag{false}});
    val gcs:  err[Fail]    = trait.add(?feat, Trait{axis: ?arch.AARCH64_GCS, setting: Setting.flag{false}});
    if (sel bti.err || sel pac.err || sel gcs.err) { ret 1; }
    var pw: Words     = make_words(a, 0);
    val p0: err[Fail] = encode(?arch.AARCH64, ?feat, ?pw);
    if (sel p0.err) { ret 1; }
    val and: opt[*Word] = word(?pw, tables.GNU_PROPERTY_AARCH64_FEATURE_1_AND.value::u32);
    if (sel and.none)          { ret 1; }
    if (and.some.value != 0x1) { ret 1; }
    var pback: Table[Trait] = table.make[Trait](a);
    val p1:    err[Fail]    = read_words(a, ?arch.AARCH64, ?pw, ?pback);
    if (sel p1.err || and.some.value != 0) { ret 1; }
    val bb: opt[*Trait] = trait.find(?pback, ?arch.AARCH64_BTI);
    if (sel bb.none)                                      { ret 1; }
    if (!trait.same(bb.some.setting, Setting.flag{true})) { ret 1; }
    var empty:   Words        = make_words(a, 0);
    var cleared: Table[Trait] = table.make[Trait](a);
    val p2:      err[Fail]    = read_words(a, ?arch.AARCH64, ?empty, ?cleared);
    if (sel p2.err || table.count[Trait](?cleared) != 3) { ret 1; }
    val cb: opt[*Trait] = trait.find(?cleared, ?arch.AARCH64_BTI);
    if (sel cb.none)                                       { ret 1; }
    if (!trait.same(cb.some.setting, Setting.flag{false})) { ret 1; }

    val r1: err[Fail] = table.release[Trait](?ts);
    val r2: err[Fail] = table.release[Trait](?back);
    val r3: err[Fail] = table.release[Trait](?bare);
    val r4: err[Fail] = table.release[Trait](?feat);
    val r5: err[Fail] = table.release[Trait](?pback);
    val r6: err[Fail] = table.release[Trait](?cleared);
    if (sel r1.err || sel r2.err || sel r3.err || sel r4.err || sel r5.err || sel r6.err) { ret 1; }
    val r7:  err[Fail] = release_words(?w);
    val r8:  err[Fail] = release_words(?none);
    val r9:  err[Fail] = release_words(?pw);
    val r10: err[Fail] = release_words(?empty);
    if (sel r7.err || sel r8.err || sel r9.err || sel r10.err) { ret 1; }
    if (T.live_count(?t) != 0)                                 { ret 1; }
    T.dnit(?t);
    ret 0;
}

test traits__a_property_and_an_attribute_that_disagree_are_refused_naming_both {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # a file without the and feature property states bti clear, and its
    # Tag_Feature_BTI 1 states it set
    var w:   Words          = make_words(a, 0);
    var rs:  Table[Reading] = table.make[Reading](a);
    val got: err[Fail]      = decode(?arch.AARCH64, ?w, ?rs);
    if (sel got.err) { ret 1; }
    val set: opt[Setting] = attribute_setting(?AARCH64_BTI_ATTRIBUTE_ROW, attributes.Value.number{1});
    if (sel set.none) { ret 1; }
    val pushed: res[table.Id[Reading], Fail] = table.push[Reading](?rs, Reading{row: ?AARCH64_BTI_ATTRIBUTE_ROW, setting: set.some});
    if (sel pushed.err) { ret 1; }
    var out: Table[Trait] = table.make[Trait](a);
    val r:   err[Fail]    = reconcile(?rs, nil, ?out);
    if (sel r.ok)                                                                     { ret 2; }
    if (!sel r.err.cause.unsupported)                                                 { ret 2; }
    if (!str_equals(r.err.at.record, tables.GNU_PROPERTY_AARCH64_FEATURE_1_BTI.name)) { ret 3; }
    if (!str_equals(r.err.subject, TAG_FEATURE_BTI.name))                             { ret 3; }
    if (table.count[Trait](?out) != 0)                                                { ret 4; }

    # the two agreeing state the axis once
    table.items[Reading](?rs)[1].setting = Setting.flag{false};
    var same: Table[Trait] = table.make[Trait](a);
    val ok:   err[Fail]    = reconcile(?rs, nil, ?same);
    if (sel ok.err)                     { ret 5; }
    if (table.count[Trait](?same) != 3) { ret 5; }

    val r1: err[Fail] = table.release[Reading](?rs);
    val r2: err[Fail] = table.release[Trait](?out);
    val r3: err[Fail] = table.release[Trait](?same);
    val r4: err[Fail] = release_words(?w);
    if (sel r1.err || sel r2.err || sel r3.err || sel r4.err) { ret 1; }
    if (T.live_count(?t) != 0)                                { ret 1; }
    T.dnit(?t);
    ret 0;
}
