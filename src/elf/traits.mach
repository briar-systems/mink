# values of Tag_RISCV_atomic_abi and Tag_RISCV_x3_reg_usage the pinned LLVM
# tables do not name
val RISCV_ATOMIC_ABI_UNKNOWN:        Constant = Constant{name: "Tag_RISCV_atomic_abi UNKNOWN", value: 0, source: "RISC-V psABI"};
val RISCV_ATOMIC_ABI_A6C:            Constant = Constant{name: "Tag_RISCV_atomic_abi A6C", value: 1, source: "RISC-V psABI"};
