# the ELF writer, the ELF model into bytes
#
# every part of the file is a region of the layout plan, placed in extent
# order: the file header, the program header table, each section's bytes, the
# section header table and the raw bytes between them. the plan is sealed, the
# sealed total is allocated once, and each region is written at its recorded
# offset in the model's class and byte order. a model that holds extents, as a
# read one does, gives back its own layout, so every recorded offset must be
# where its extent lies and a region that overlaps another is refused. a model
# with no extents is laid out here: each region is placed at the alignment it
# asks for, the offsets and lengths follow from the plan, and the header
# counts are written with extended numbering when they need it. a section
# that takes no room in the file, such as SHT_NOBITS, keeps the offset its
# model holds. every value is checked against the width of its field before a
# byte is written.

use std.encoding.binary;
use std.memory;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;

use mink.checked;
use mink.elf.model;
use mink.elf.model.Body;
use mink.elf.model.Class;
use mink.elf.model.Definition;
use mink.elf.model.Dyn;
use mink.elf.model.Elf;
use mink.elf.model.Extent;
use mink.elf.model.GnuHash;
use mink.elf.model.Group;
use mink.elf.model.Hash;
use mink.elf.model.Need;
use mink.elf.model.Note;
use mink.elf.model.Property;
use mink.elf.model.Rel;
use mink.elf.model.Rela;
use mink.elf.model.Section;
use mink.elf.model.Segment;
use mink.elf.model.Shape;

use mink.elf.model.Symbol;
use mink.elf.read;
use mink.fail;
use mink.fail.Fail;
use mink.fail.Location;
use mink.format.contract.Input;
use mink.plan;
use mink.plan.Layout;
use mink.plan.Plan;
use mink.plan.Region;
use mink.reader.BIG;
use mink.reader.LITTLE;
use mink.reader.Order;
use mink.sink;
use mink.sink.Sink;
use mink.slot;
