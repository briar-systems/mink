# the operating systems an NT_GNU_ABI_TAG note names, by the number in its
# first word, as glibc's elf.h numbers them
use mink.elf.tables.Constant;
use mink.elf.tables.Set;

val OS_LINUX:   Constant = Constant{name: "Linux", value: 0, source: "glibc elf.h"};
val OS_GNU:     Constant = Constant{name: "GNU", value: 1, source: "glibc elf.h"};
val OS_SOLARIS: Constant = Constant{name: "Solaris", value: 2, source: "glibc elf.h"};
val OS_FREEBSD: Constant = Constant{name: "FreeBSD", value: 3, source: "glibc elf.h"};

val OS_ROWS: [4]*Constant = [4]*Constant{?OS_LINUX, ?OS_GNU, ?OS_SOLARIS, ?OS_FREEBSD};

pub val OS: Set = Set{count: 4, rows: ?OS_ROWS[0]};
