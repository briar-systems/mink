use mink.table.Table;

# the keys of the facts only ELF states
# ---
# FLAGS:           e_flags
# OSABI:           EI_OSABI
# ABIVERSION:      EI_ABIVERSION
# PROPERTY:        one GNU property, its type the value and its data the data
# SECTION_TYPE:    a section whose sh_type is not the one its kind has: the
#                  section's index in the high word and the type in the low
# SECTION_FLAGS:   a section's sh_flags bits no neutral flag holds: the
#                  section's index the value and the eight bytes of the bits
#                  the data, little endian
# SECTION_SYMBOLS: a section whose sh_link is the symbol table: the section's
#                  index
# SYMBOL_OTHER:    a symbol's st_other bits past the visibility: the symbol's
#                  index in the high bits and the bits in the low byte
# PROPERTY_NOTE:   the section the GNU property note is written in: the
#                  section's index
# ATTRIBUTE:       one build attribute no trait row maps: its tag the value
#                  and its value the data, as the section encodes it
# ATTRIBUTES:      the section the build attributes are written in: the
#                  section's index
pub val FLAGS:           u32 = 0;
pub val OSABI:           u32 = 1;
pub val ABIVERSION:      u32 = 2;
pub val PROPERTY:        u32 = 3;
pub val SECTION_TYPE:    u32 = 4;
pub val SECTION_FLAGS:   u32 = 5;
pub val SECTION_SYMBOLS: u32 = 6;
pub val SYMBOL_OTHER:    u32 = 7;
pub val PROPERTY_NOTE:   u32 = 8;
pub val ATTRIBUTE:       u32 = 9;
pub val ATTRIBUTES:      u32 = 10;

# an ELF code and the neutral row it maps to
rec Map {
    elf: *Constant;
    row: ptr;
}

val BINDING_COUNT: usize              = 4;
val BINDINGS:      [BINDING_COUNT]Map = [BINDING_COUNT]Map{
    Map{elf: ?tables.STB_LOCAL, row: ?symbol.LOCAL},
    Map{elf: ?tables.STB_GLOBAL, row: ?symbol.GLOBAL},
    Map{elf: ?tables.STB_WEAK, row: ?symbol.WEAKLY},
    Map{elf: ?tables.STB_GNU_UNIQUE, row: ?symbol.UNIQUELY},
};

val VISIBILITY_COUNT: usize                 = 4;
val VISIBILITIES:     [VISIBILITY_COUNT]Map = [VISIBILITY_COUNT]Map{
    Map{elf: ?tables.STV_DEFAULT, row: ?symbol.DEFAULT},
    Map{elf: ?tables.STV_INTERNAL, row: ?symbol.INTERNAL},
    Map{elf: ?tables.STV_HIDDEN, row: ?symbol.HIDDEN},
    Map{elf: ?tables.STV_PROTECTED, row: ?symbol.PROTECTED},
};

val KIND_COUNT: usize           = 8;
val KINDS:      [KIND_COUNT]Map = [KIND_COUNT]Map{
    Map{elf: ?tables.STT_NOTYPE, row: ?symbol.NOTYPE},
    Map{elf: ?tables.STT_OBJECT, row: ?symbol.DATA},
    Map{elf: ?tables.STT_FUNC, row: ?symbol.FUNCTION},
    Map{elf: ?tables.STT_SECTION, row: ?symbol.SECTIONS},
    Map{elf: ?tables.STT_FILE, row: ?symbol.SOURCE},
    Map{elf: ?tables.STT_COMMON, row: ?symbol.COMMONS},
    Map{elf: ?tables.STT_TLS, row: ?symbol.TLS},
    Map{elf: ?tables.STT_GNU_IFUNC, row: ?symbol.IFUNC},
};

# the section types that name a kind, the first row of a type the kind it is
# read as and the first row of a kind the type it is written as
val TYPE_COUNT: usize           = 6;
val TYPES:      [TYPE_COUNT]Map = [TYPE_COUNT]Map{
    Map{elf: ?tables.SHT_NOTE, row: ?section.NOTE_INFO},
    Map{elf: ?tables.SHT_INIT_ARRAY, row: ?section.INIT_ARRAY},
    Map{elf: ?tables.SHT_FINI_ARRAY, row: ?section.FINI_ARRAY},
    Map{elf: ?tables.SHT_PREINIT_ARRAY, row: ?section.PREINIT_ARRAY},
    Map{elf: ?tables.SHT_NOBITS, row: ?section.BSS},
    Map{elf: ?tables.SHT_NOBITS, row: ?section.TLS_BSS},
};

# the section flags a neutral flag holds
rec FlagRow {
    elf:  *Constant;
    flag: section.Flags;
}

val FLAG_COUNT: usize               = 7;
val FLAGS_MAP:  [FLAG_COUNT]FlagRow = [FLAG_COUNT]FlagRow{
    FlagRow{elf: ?tables.SHF_ALLOC, flag: section.ALLOC},
    FlagRow{elf: ?tables.SHF_WRITE, flag: section.WRITE},
    FlagRow{elf: ?tables.SHF_EXECINSTR, flag: section.EXEC},
    FlagRow{elf: ?tables.SHF_GNU_RETAIN, flag: section.RETAIN},
    FlagRow{elf: ?tables.SHF_MERGE, flag: section.MERGE},
    FlagRow{elf: ?tables.SHF_STRINGS, flag: section.STRINGS},
    FlagRow{elf: ?tables.SHF_TLS, flag: section.TLS},
};

# a section name that sets its kind, read before the flags are
# ---
# prefix: what the name starts with, or all of it when exact
rec NameRow {
    prefix: str;
    exact:  bool;
    kind:   *section.Kind;
}

val NAME_COUNT: usize               = 5;
val NAMES:      [NAME_COUNT]NameRow = [NAME_COUNT]NameRow{
    NameRow{prefix: ".eh_frame", exact: true, kind: ?section.UNWIND_INFO},
    NameRow{prefix: ".data.rel.ro", exact: false, kind: ?section.RELRO_DATA},
    NameRow{prefix: ".debug", exact: false, kind: ?section.DEBUG_INFO},
    NameRow{prefix: ".zdebug", exact: false, kind: ?section.DEBUG_INFO},
    NameRow{prefix: ".stab", exact: false, kind: ?section.DEBUG_INFO},
};

# the name of the section GNU properties are written in
val PROPERTY_SECTION: str = ".note.gnu.property";
val PROPERTY_OWNER:   str = "GNU";

# the section roles of a file being read
val ROLE_SECTION: u8 = 0;
val ROLE_FRAME:   u8 = 1;

# the file being converted
# ---
# m:      the model
# o:      the object it is added to
# reg:    the relocation sets
# set:    the relocation rows of the file's architecture
# have:   whether the file has a symbol table
# symtab: its section index
# strtab: the section index of its names
# nsyms:  how many symbols it holds
# syms:   its symbols
# role:   per section, what it is to the neutral object
# map:    per section, the neutral section index plus one, or zero
# words:  e_flags and the GNU property words, which hold what the traits and the facts leave
# note:   the section index of the GNU property note, when the file has one
# attrs:  the section index of the build attributes the object states, when
#         the file has them in the shape mink reads
rec Conv {
    m:      *Elf;
    o:      *Object;
    reg:    Registry;
    set:    *Lookup;
    have:   bool;
    symtab: u32;
    strtab: u32;
    nsyms:  usize;
    syms:   *Table[model.Symbol];
    role:   Table[u8];
    map:    Table[u32];
    words:  Words;
    note:   opt[u32];
    attrs:  opt[u32];
}

fun pick(rows: *Map, n: usize, code: u64) ptr {
    var i: usize = 0;
    for (i < n) {
        if (rows[i].elf.value == code) { ret rows[i].row; }
        i = i + 1;
    }
    ret nil;
}

fun code_of(rows: *Map, n: usize, row: ptr) opt[u64] {
    var i: usize = 0;
    for (i < n) {
        if (rows[i].row == row) { ret opt[u64].some{rows[i].elf.value}; }
        i = i + 1;
    }
    ret opt[u64].none{};
}

fun neutral_flags(f: u64) section.Flags {
    var out: section.Flags = 0;
    var i:   usize         = 0;
    for (i < FLAG_COUNT) {
        if ((f & FLAGS_MAP[i].elf.value) != 0) { out = out | FLAGS_MAP[i].flag; }
        i = i + 1;
    }
    ret out;
}

fun elf_flags(f: section.Flags) u64 {
    var out: u64   = 0;
    var i:   usize = 0;
    for (i < FLAG_COUNT) {
        if ((f & FLAGS_MAP[i].flag) != 0) { out = out | FLAGS_MAP[i].elf.value; }
        i = i + 1;
    }
    ret out;
}

# the sh_flags bits a neutral flag holds
fun held_flags() u64 {
    var out: u64   = 0;
    var i:   usize = 0;
    for (i < FLAG_COUNT) {
        out = out | FLAGS_MAP[i].elf.value;
        i   = i + 1;
    }
    ret out;
}

fun starts(name: Bytes, prefix: str) bool {
    val n: usize = str_len(prefix);
    if (name.len < n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (name.data[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the kind of a section by its type, its name and its flags
fun kind_of(type: u32, flags: u64, name: Bytes) *section.Kind {
    val tls: bool = (flags & tables.SHF_TLS.value) != 0;
    val row: ptr  = pick(?TYPES[0], TYPE_COUNT, type::u64);
    if (row != nil) {
        val k: *section.Kind = row::*section.Kind;
        if (k == ?section.BSS && tls) { ret ?section.TLS_BSS; }
        ret k;
    }
    var i: usize = 0;
    for (i < NAME_COUNT) {
        val r: *NameRow = ?NAMES[i];
        if (r.exact && name.len == str_len(r.prefix) && starts(name, r.prefix)) { ret r.kind; }
        if (!r.exact && starts(name, r.prefix))                                 { ret r.kind; }
        i = i + 1;
    }
    if ((flags & tables.SHF_ALLOC.value) == 0)     { ret ?section.METADATA; }
    if (tls)                                       { ret ?section.TLS_DATA; }
    if ((flags & tables.SHF_EXECINSTR.value) != 0) { ret ?section.TEXT; }
    if ((flags & tables.SHF_WRITE.value) != 0)     { ret ?section.DATA; }
    ret ?section.RODATA;
}

# the type a section of kind `k` is written as when no fact states another
fun type_of(k: *section.Kind) u32 {
    var i: usize = 0;
    for (i < TYPE_COUNT) {
        if (TYPES[i].row == k::ptr) { ret TYPES[i].elf.value::u32; }
        i = i + 1;
    }
    ret tables.SHT_PROGBITS.value::u32;
}

# how garbage collection treats a section: unwind records live with the code
# they describe, a link-order section with the section it orders, bytes
# nothing loads are kept whole, and the rest is kept or dropped as one
fun disposition_of(k: *section.Kind, flags: section.Flags, owned: bool) *section.Disposition {
    if (section.has(k, section.UNWIND)) { ret ?section.RECORDS; }
    if (owned)                          { ret ?section.DEPENDENT; }
    if ((flags & section.ALLOC) == 0)   { ret ?section.ROOT; }
    ret ?section.WHOLE;
}

# how many GNU property notes section `s` holds. a section that also holds
# another note has no neutral form, as its properties are the object's facts and traits
fun property_notes(s: *model.Section) res[usize, Fail] {
    if (!sel s.body.notes) { ret res[usize, Fail].ok{0}; }
    var found: usize = 0;
    var k:     usize = 0;
    for (k < table.count[model.Note](?s.body.notes)) {
        val n: *model.Note = table.at[model.Note](?s.body.notes, table.nth[model.Note](k));
        if (sel n.desc.properties) { found = found + 1; }
        k = k + 1;
    }
    if (found != 0 && found != table.count[model.Note](?s.body.notes)) {
        ret res[usize, Fail].err{fail.unsupported("a GNU property note shares its section with another note")};
    }
    ret res[usize, Fail].ok{found};
}

fun roles_of(c: *Conv) err[Fail] {
    val count: usize             = table.count[model.Section](?c.m.sections);
    val gr:    res[Id[u8], Fail] = table.grow[u8](?c.role, count);
    if (sel gr.err) { ret err[Fail].err{gr.err}; }
    val gm: res[Id[u32], Fail] = table.grow[u32](?c.map, count);
    if (sel gm.err) { ret err[Fail].err{gm.err}; }
    val roles: *u8   = table.items[u8](?c.role);
    var i:     usize = 0;
    for (i < count) {
        val s: *model.Section = model.section_at(c.m, table.nth[model.Section](i));
        if (s.type == tables.SHT_SYMTAB.value::u32) {
            if (c.have)                 { ret err[Fail].err{fail.in_indexed(fail.unsupported("more than one symbol table"), "section header", i::u64)}; }
            if (!sel s.body.symbols)    { ret err[Fail].err{fail.in_indexed(fail.malformed("symbol table has no symbols"), "section header", i::u64)}; }
            if (s.link::usize >= count) { ret err[Fail].err{fail.in_indexed(fail.malformed("symbol table names no string table"), "section header", i::u64)}; }
            c.have   = true;
            c.symtab = i::u32;
            c.strtab = s.link;
            c.syms   = ?s.body.symbols;
            c.nsyms  = table.count[model.Symbol](c.syms);
        }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        val s: *model.Section = model.section_at(c.m, table.nth[model.Section](i));
        val t: u64            = s.type::u64;
        if (t == tables.SHT_RELR.value) { ret err[Fail].err{fail.in_indexed(fail.unsupported("RELR relocations have no place in an object"), "section header", i::u64)}; }
        if (t == tables.SHT_NULL.value || t == tables.SHT_SYMTAB.value || t == tables.SHT_SYMTAB_SHNDX.value || t == tables.SHT_REL.value || t == tables.SHT_RELA.value || t == tables.SHT_GROUP.value) {
            roles[i] = ROLE_FRAME;
        }
        if (c.have && i::u32 == c.strtab) { roles[i] = ROLE_FRAME; }
        i = i + 1;
    }
    var noted: usize = 0;
    i = 0;
    for (i < count) {
        val s: *model.Section   = model.section_at(c.m, table.nth[model.Section](i));
        val n: res[usize, Fail] = property_notes(s);
        if (sel n.err) { ret err[Fail].err{fail.in_indexed(n.err, "section header", i::u64)}; }
        if (n.ok != 0) { c.note = opt[u32].some{i::u32}; }
        noted = noted + n.ok;
        i     = i + 1;
    }
    if (noted > 1) { ret err[Fail].err{fail.unsupported("more than one GNU property note")}; }
    val names: res[opt[u32], Fail] = model.string_section(c.m);
    if (sel names.err) { ret err[Fail].err{names.err}; }
    if (sel names.ok.some) {
        if (names.ok.some::usize >= count) { ret err[Fail].err{fail.in_record(fail.malformed("section name table index out of range"), "file header")}; }
        roles[names.ok.some::usize] = ROLE_FRAME;
    }
    ret err[Fail].ok{};
}

# the NUL-terminated string at `at` in section `strings`
fun string_in(m: *Elf, strings: u32, at: u64) res[Bytes, Fail] {
    val s: *model.Section = model.section_at(m, table.nth[model.Section](strings::usize));
    if (!sel s.body.raw) { ret res[Bytes, Fail].err{fail.in_indexed(fail.malformed("string table holds no bytes"), "section header", strings::u64)}; }
    val b: Bytes = model.bytes(m, ?s.body.raw.bytes);
    if (at >= b.len::u64) { ret res[Bytes, Fail].err{fail.in_indexed(fail.malformed("string index past its table"), "section header", strings::u64)}; }
    var n: usize = 0;
    for (at::usize + n < b.len && b.data[at::usize + n] != 0) {
        n = n + 1;
    }
    if (at::usize + n >= b.len) { ret res[Bytes, Fail].err{fail.in_indexed(fail.malformed("string is not terminated"), "section header", strings::u64)}; }
    ret res[Bytes, Fail].ok{Bytes{data: ?b.data[at::usize], len: n}};
}

fun section_name(c: *Conv, s: *model.Section) res[Bytes, Fail] {
    val names: res[opt[u32], Fail] = model.string_section(c.m);
    if (sel names.err) { ret res[Bytes, Fail].err{names.err}; }
    if (sel names.ok.none) {
        if (s.name != 0) { ret res[Bytes, Fail].err{fail.in_record(fail.malformed("section has a name and the file no name table"), "section header")}; }
        val empty: str = "";
        ret res[Bytes, Fail].ok{Bytes{data: empty::*u8, len: 0}};
    }
    ret string_in(c.m, names.ok.some, s.name::u64);
}

fun add_fact(c: *Conv, key: u32, value: u64, data: Contents) err[Fail] {
    val r: res[Id[Fact], Fail] = object.add_fact(c.o, Fact{format: ?format.ELF, key: key, value: value, data: data});
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

fun own_bytes(c: *Conv, p: *u8, n: usize) res[Contents, Fail] {
    ret object.own(c.o, p, n);
}

fun header_facts(c: *Conv) err[Fail] {
    val h:    *model.Header = ?c.m.header;
    val keys: [3]u32        = [3]u32{FLAGS, OSABI, ABIVERSION};
    val vals: [3]u64        = [3]u64{c.words.flags::u64, h.ident.osabi::u64, h.ident.abiversion::u64};
    var i:    usize         = 0;
    for (i < 3) {
        if (vals[i] != 0) {
            val r: err[Fail] = add_fact(c, keys[i], vals[i], Contents.zero{0});
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the data of property `e` as the object states it: a one word property holds
# the bits the traits left, any other its bytes
fun property_data(c: *Conv, e: *Property) res[Contents, Fail] {
    val b: Bytes = model.bytes(c.m, ?e.data);
    if (e.datasz != 4) { ret own_bytes(c, b.data, b.len); }
    val w: opt[*Word] = traits.word(?c.words, e.type);
    if (sel w.none) { ret res[Contents, Fail].err{fail.internal("a one word property is not among the words")}; }
    var out: Sink      = sink.make(c.m.a, c.m.shape.order);
    val put: err[Fail] = sink.uint(?out, w.some.value::u64, 4);
    if (sel put.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret res[Contents, Fail].err{put.err};
    }
    val got: res[Contents, Fail] = own_bytes(c, sink.data(?out), sink.len(?out));
    val rel: err[Fail]           = sink.release(?out);
    if (sel got.err) { ret got; }
    if (sel rel.err) { ret res[Contents, Fail].err{rel.err}; }
    ret got;
}

fun note_facts(c: *Conv, t: *Table[model.Note]) err[Fail] {
    var k: usize = 0;
    for (k < table.count[model.Note](t)) {
        val n: *model.Note = table.at[model.Note](t, table.nth[model.Note](k));
        if (sel n.desc.properties) {
            var p: usize = 0;
            for (p < table.count[Property](?n.desc.properties)) {
                val e:    *Property           = table.at[Property](?n.desc.properties, table.nth[Property](p));
                val data: res[Contents, Fail] = property_data(c, e);
                if (sel data.err) { ret err[Fail].err{data.err}; }
                val r: err[Fail] = add_fact(c, PROPERTY, e.type::u64, data.ok);
                if (sel r.err) { ret r; }
                p = p + 1;
            }
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

fun property_facts(c: *Conv) err[Fail] {
    var i: usize = 0;
    for (i < table.count[model.Section](?c.m.sections)) {
        val s: *model.Section = model.section_at(c.m, table.nth[model.Section](i));
        if (sel s.body.notes) {
            val r: err[Fail] = note_facts(c, ?s.body.notes);
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# whether section `i` is the GNU property note
fun is_note(c: *Conv, i: usize) bool {
    ret sel c.note.some && c.note.some::usize == i;
}

# whether section `i` holds the build attributes the object states
fun is_attrs(c: *Conv, i: usize) bool {
    ret sel c.attrs.some && c.attrs.some::usize == i;
}

# the traits and facts of the build attributes of the architecture's vendor,
# when the file holds one section of them in the shape mink reads and every
# attribute a row maps holds a value its row reads. otherwise the section is
# held as its bytes
fun attributes_in(c: *Conv) err[Fail] {
    val v: opt[*Vendor] = traits.vendor_of(c.o.arch);
    if (sel v.none) { ret err[Fail].ok{}; }
    var at:    usize = 0;
    var found: usize = 0;
    var i:     usize = 0;
    for (i < table.count[model.Section](?c.m.sections)) {
        val s: *model.Section = model.section_at(c.m, table.nth[model.Section](i));
        if (table.items[u8](?c.role)[i] == ROLE_SECTION && s.type == v.some.type.value::u32) {
            at    = i;
            found = found + 1;
        }
        i = i + 1;
    }
    if (found != 1) { ret err[Fail].ok{}; }
    val s: *model.Section = model.section_at(c.m, table.nth[model.Section](at));
    if (!sel s.body.raw) { ret err[Fail].ok{}; }
    var list: Table[Attribute] = table.make[Attribute](c.m.a);
    val r:    err[Fail]        = attributes_decoded(c, v.some, at, model.bytes(c.m, ?s.body.raw.bytes), ?list);
    val rel:  err[Fail]        = table.release[Attribute](?list);
    if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section header", at::u64)}; }
    ret rel;
}

fun attributes_decoded(c: *Conv, v: *Vendor, at: usize, data: Bytes, list: *Table[Attribute]) err[Fail] {
    val p: res[bool, Fail] = attributes.parse(c.m.a, v, data, c.m.shape.order, list);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    if (!p.ok)     { ret err[Fail].ok{}; }
    val n: usize = table.count[Attribute](list);
    var i: usize = 0;
    for (i < n) {
        val e:   *Attribute            = table.at[Attribute](list, table.nth[Attribute](i));
        val row: opt[*traits.Encoding] = traits.attribute_row(c.o.arch, v, e.tag);
        i = i + 1;
        if (sel row.none) { cnt; }
        val s: opt[Setting] = traits.attribute_setting(row.some, e.value);
        if (sel s.none) { ret err[Fail].ok{}; }
    }
    i = 0;
    for (i < n) {
        val e:   *Attribute            = table.at[Attribute](list, table.nth[Attribute](i));
        val row: opt[*traits.Encoding] = traits.attribute_row(c.o.arch, v, e.tag);
        i = i + 1;
        if (sel row.some) {
            val r: err[Fail] = attribute_trait(c, row.some, e.value);
            if (sel r.err) { ret r; }
            cnt;
        }
        val f: err[Fail] = attribute_fact(c, e);
        if (sel f.err) { ret f; }
    }
    c.attrs = opt[u32].some{at::u32};
    ret err[Fail].ok{};
}

# the trait the attribute value `v` states through `row`, its text owned by the object
fun attribute_trait(c: *Conv, row: *traits.Encoding, v: attributes.Value) err[Fail] {
    val s: opt[Setting] = traits.attribute_setting(row, v);
    if (sel s.none) { ret err[Fail].err{fail.internal("an attribute setting decoded once does not decode again")}; }
    var setting: Setting = s.some;
    if (sel v.text) {
        val owned: res[Held, Fail] = store.own(?c.o.store, v.text.data, v.text.len);
        if (sel owned.err) { ret err[Fail].err{owned.err}; }
        setting = Setting.text{owned.ok};
    }
    ret trait.add(?c.o.traits, Trait{axis: row.axis, setting: setting});
}

# the fact of an attribute no row maps, its value as the section encodes it
fun attribute_fact(c: *Conv, e: *Attribute) err[Fail] {
    var out: Sink      = sink.make(c.m.a, c.m.shape.order);
    var w:   err[Fail] = err[Fail].ok{};
    if (sel e.value.text) {
        val t: err[Fail] = sink.bytes(?out, e.value.text.data, e.value.text.len);
        w = t;
        if (sel t.ok) { w = sink.u8(?out, 0); }
    }
    or (sel e.value.number) { w = sink.uleb(?out, e.value.number); }
    if (sel w.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret w;
    }
    val got: res[Contents, Fail] = own_bytes(c, sink.data(?out), sink.len(?out));
    val rel: err[Fail]           = sink.release(?out);
    if (sel got.err) { ret err[Fail].err{got.err}; }
    if (sel rel.err) { ret rel; }
    ret add_fact(c, ATTRIBUTE, e.tag, got.ok);
}

# the bytes of section `i`, copied into the object. the GNU property note and
# the build attributes have none, as what they hold is the object's
fun section_contents(c: *Conv, i: usize, s: *model.Section) res[Contents, Fail] {
    if (is_note(c, i) || is_attrs(c, i))        { ret own_bytes(c, nil, 0); }
    if (s.type == tables.SHT_NOBITS.value::u32) { ret res[Contents, Fail].ok{Contents.zero{s.length}}; }
    if (sel s.body.raw) {
        val b: Bytes = model.bytes(c.m, ?s.body.raw.bytes);
        ret own_bytes(c, b.data, b.len);
    }
    if (sel s.body.empty) { ret own_bytes(c, nil, 0); }
    var out: Sink      = sink.make(c.m.a, c.m.shape.order);
    val w:   err[Fail] = write.section_bytes(c.m.a, c.m, i::u32, ?out);
    if (sel w.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret res[Contents, Fail].err{w.err};
    }
    val got: res[Contents, Fail] = own_bytes(c, sink.data(?out), sink.len(?out));
    val rel: err[Fail]           = sink.release(?out);
    if (sel got.err) { ret got; }
    if (sel rel.err) { ret res[Contents, Fail].err{rel.err}; }
    ret got;
}

fun sections_in(c: *Conv) err[Fail] {
    val count: usize = table.count[model.Section](?c.m.sections);
    var i:     usize = 0;
    for (i < count) {
        if (table.items[u8](?c.role)[i] == ROLE_SECTION) {
            val r: err[Fail] = section_in(c, i);
            if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section header", i::u64)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun section_in(c: *Conv, i: usize) err[Fail] {
    val s: *model.Section   = model.section_at(c.m, table.nth[model.Section](i));
    val n: res[Bytes, Fail] = section_name(c, s);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val id: res[Id[Name], Fail] = object.name(c.o, n.ok.data, n.ok.len);
    if (sel id.err) { ret err[Fail].err{id.err}; }
    if (s.addralign != 0 && (s.addralign & (s.addralign - 1)) != 0) {
        ret err[Fail].err{fail.malformed("section alignment is not a power of two")};
    }
    var align: u64 = s.addralign;
    if (align == 0) { align = 1; }
    val contents: res[Contents, Fail] = section_contents(c, i, s);
    if (sel contents.err) { ret err[Fail].err{contents.err}; }
    val kind:  *section.Kind                 = kind_of(s.type, s.flags, n.ok);
    val flags: section.Flags                 = neutral_flags(s.flags);
    val added: res[Id[object.Section], Fail] = object.add_section(c.o, object.Section{
        name:        id.ok,
        kind:        kind,
        flags:       flags,
        align:       align,
        entsize:     s.entsize,
        contents:    contents.ok,
        disposition: disposition_of(kind, flags, false),
    });
    if (sel added.err) { ret err[Fail].err{added.err}; }
    table.items[u32](?c.map)[i] = added.ok.index + 1;
    if (is_note(c, i))  { ret add_fact(c, PROPERTY_NOTE, added.ok.index::u64, Contents.zero{0}); }
    if (is_attrs(c, i)) { ret add_fact(c, ATTRIBUTES, added.ok.index::u64, Contents.zero{0}); }
    ret err[Fail].ok{};
}

# the null symbol is every symbol with nothing to say
fun symbols_in(c: *Conv) err[Fail] {
    if (!c.have) { ret err[Fail].ok{}; }
    var k: usize = 0;
    for (k < c.nsyms) {
        val r: err[Fail] = symbol_in(c, k, table.at[model.Symbol](c.syms, table.nth[model.Symbol](k)));
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "symbol", k::u64)}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

fun symbol_in(c: *Conv, k: usize, e: *model.Symbol) err[Fail] {
    val name: res[Bytes, Fail] = string_in(c.m, c.strtab, e.name::u64);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    val id: res[Id[Name], Fail] = object.name(c.o, name.ok.data, name.ok.len);
    if (sel id.err) { ret err[Fail].err{id.err}; }
    val binding: ptr = pick(?BINDINGS[0], BINDING_COUNT, (e.info >> 4)::u64);
    if (binding == nil) { ret err[Fail].err{fail.unsupported("symbol binding has no neutral form")}; }
    val vis:  ptr = pick(?VISIBILITIES[0], VISIBILITY_COUNT, (e.other & 3)::u64);
    val kind: ptr = pick(?KINDS[0], KIND_COUNT, (e.info & 0xf)::u64);
    if (kind == nil) { ret err[Fail].err{fail.unsupported("symbol type has no neutral form")}; }
    val located: res[Index, Fail] = model.symbol_section(c.m, table.nth[model.Section](c.symtab::usize), k::u32);
    if (sel located.err) { ret err[Fail].err{located.err}; }
    var def: Definition = Definition.undefined{};
    val ix:  Index      = located.ok;
    if (sel ix.section) {
        if (ix.section != tables.SHN_UNDEF.value::u32) {
            if (ix.section::usize >= table.count[model.Section](?c.m.sections)) {
                ret err[Fail].err{fail.malformed("symbol names a section past the section headers")};
            }
            val mapped: u32 = table.items[u32](?c.map)[ix.section::usize];
            if (mapped == 0) { ret err[Fail].err{fail.unsupported("symbol is defined in a section that has no neutral form")}; }
            def = Definition.placed{Place{section: Id[object.Section]{index: mapped - 1}, offset: e.value}};
        }
    }
    or (sel ix.reserved) {
        if (ix.reserved == tables.SHN_ABS.value::u16)    { def = Definition.absolute{e.value}; }
        or (ix.reserved == tables.SHN_COMMON.value::u16) { def = Definition.common{object.Common{size: e.bytes, align: e.value}}; }
        or                                               { ret err[Fail].err{fail.unsupported("symbol section index has no neutral form")}; }
    }
    val added: res[Id[object.Symbol], Fail] = object.add_symbol(c.o, object.Symbol{
        name:       id.ok,
        binding:    binding::*symbol.Binding,
        visibility: vis::*symbol.Visibility,
        kind:       kind::*symbol.Kind,
        def:        def,
        size:       opt[u64].some{e.bytes},
    });
    if (sel added.err) { ret err[Fail].err{added.err}; }
    ret err[Fail].ok{};
}

# the sections that order or follow others, and the groups
fun links_in(c: *Conv) err[Fail] {
    val count: usize = table.count[model.Section](?c.m.sections);
    var i:     usize = 0;
    for (i < count) {
        val s: *model.Section = model.section_at(c.m, table.nth[model.Section](i));
        if (table.items[u8](?c.role)[i] == ROLE_SECTION) {
            val r: err[Fail] = owner_in(c, i, s);
            if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section header", i::u64)}; }
        }
        if (s.type == tables.SHT_GROUP.value::u32) {
            val r: err[Fail] = group_in(c, i, s);
            if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section header", i::u64)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun owner_in(c: *Conv, i: usize, s: *model.Section) err[Fail] {
    if (s.info != 0) { ret err[Fail].err{fail.unsupported("section info has no neutral form")}; }
    if (s.link == 0) { ret err[Fail].ok{}; }
    val here: Id[object.Section] = Id[object.Section]{index: table.items[u32](?c.map)[i] - 1};
    if (s.link::usize < table.count[model.Section](?c.m.sections)) {
        val to: u32 = table.items[u32](?c.map)[s.link::usize];
        if ((s.flags & tables.SHF_LINK_ORDER.value) != 0 && to != 0) {
            val sec: *object.Section = object.section_at(c.o, here);
            sec.owner       = opt[Id[object.Section]].some{Id[object.Section]{index: to - 1}};
            sec.disposition = disposition_of(sec.kind, sec.flags, true);
            ret err[Fail].ok{};
        }
    }
    if (c.have && s.link == c.symtab) { ret err[Fail].ok{}; }
    ret err[Fail].err{fail.unsupported("section link has no neutral form")};
}

fun group_in(c: *Conv, i: usize, s: *model.Section) err[Fail] {
    if (!c.have || s.link != c.symtab)                      { ret err[Fail].err{fail.malformed("group names no symbol table")}; }
    if (!sel s.body.group)                                  { ret err[Fail].err{fail.malformed("group section holds no group")}; }
    if (s.body.group.flags != tables.GRP_COMDAT.value::u32) { ret err[Fail].err{fail.unsupported("group is not a COMDAT group")}; }
    if (s.info::usize >= c.nsyms)                           { ret err[Fail].err{fail.malformed("group signature symbol is past the symbol table")}; }
    val sig: Id[Name]                    = object.symbol_at(c.o, Id[object.Symbol]{index: s.info}).name;
    val g:   res[Id[object.Group], Fail] = object.add_group(c.o, object.Group{signature: sig, rule: ?group.ANY});
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var k: usize = 0;
    for (k < table.count[u32](?s.body.group.members)) {
        val at: u32 = @table.at[u32](?s.body.group.members, table.nth[u32](k));
        if (at::usize >= table.count[model.Section](?c.m.sections)) {
            ret err[Fail].err{fail.in_indexed(fail.malformed("group member is past the section headers"), "group member", k::u64)};
        }
        val member: *model.Section = model.section_at(c.m, table.nth[model.Section](at::usize));
        val to:     u32            = table.items[u32](?c.map)[at::usize];
        if (to == 0 && (member.type == tables.SHT_REL.value::u32 || member.type == tables.SHT_RELA.value::u32)) {
            k = k + 1;
            cnt;
        }
        if (to == 0) { ret err[Fail].err{fail.in_indexed(fail.unsupported("group member has no neutral form"), "group member", k::u64)}; }
        val sec: *object.Section = object.section_at(c.o, Id[object.Section]{index: to - 1});
        if (sel sec.group.some) { ret err[Fail].err{fail.in_indexed(fail.unsupported("section is in more than one group"), "group member", k::u64)}; }
        val joined: *object.Section = object.section_at(c.o, Id[object.Section]{index: to - 1});
        joined.group = opt[Id[object.Group]].some{g.ok};
        k            = k + 1;
    }
    ret err[Fail].ok{};
}

fun section_facts(c: *Conv) err[Fail] {
    val count: usize = table.count[model.Section](?c.m.sections);
    var i:     usize = 0;
    for (i < count) {
        val mapped: u32 = table.items[u32](?c.map)[i];
        if (mapped != 0) {
            val r: err[Fail] = section_fact(c, model.section_at(c.m, table.nth[model.Section](i)), mapped - 1);
            if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section header", i::u64)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun section_fact(c: *Conv, s: *model.Section, n: u32) err[Fail] {
    val sec:     *object.Section = object.section_at(c.o, Id[object.Section]{index: n});
    var derived: u64             = 0;
    if (sel sec.group.some) { derived = derived | tables.SHF_GROUP.value; }
    if (sel sec.owner.some) { derived = derived | tables.SHF_LINK_ORDER.value; }
    val extra: u64 = s.flags & ~(held_flags() | derived);
    if (extra != 0) {
        var bits: [8]u8;
        var k:    usize = 0;
        for (k < 8) {
            bits[k] = ((extra >> (k::u64 * 8)) & 0xff)::u8;
            k       = k + 1;
        }
        val data: res[Contents, Fail] = own_bytes(c, ?bits[0], 8);
        if (sel data.err) { ret err[Fail].err{data.err}; }
        val r: err[Fail] = add_fact(c, SECTION_FLAGS, n::u64, data.ok);
        if (sel r.err) { ret r; }
    }
    if (s.type != type_of(sec.kind)) {
        val r: err[Fail] = add_fact(c, SECTION_TYPE, (n::u64 << 32) | s.type::u64, Contents.zero{0});
        if (sel r.err) { ret r; }
    }
    if (c.have && s.link == c.symtab && s.link != 0 && sel sec.owner.none) {
        val r: err[Fail] = add_fact(c, SECTION_SYMBOLS, n::u64, Contents.zero{0});
        if (sel r.err) { ret r; }
    }
    ret err[Fail].ok{};
}

fun symbol_facts(c: *Conv) err[Fail] {
    if (!c.have) { ret err[Fail].ok{}; }
    var k: usize = 0;
    for (k < c.nsyms) {
        val e:     *model.Symbol = table.at[model.Symbol](c.syms, table.nth[model.Symbol](k));
        val extra: u8            = e.other & ~3;
        if (extra != 0) {
            val r: err[Fail] = add_fact(c, SYMBOL_OTHER, (k::u64 << 8) | extra::u64, Contents.zero{0});
            if (sel r.err) { ret r; }
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

fun relocs_in(c: *Conv) err[Fail] {
    val count: usize = table.count[model.Section](?c.m.sections);
    var i:     usize = 0;
    for (i < count) {
        val s: *model.Section = model.section_at(c.m, table.nth[model.Section](i));
        if (s.type == tables.SHT_REL.value::u32 || s.type == tables.SHT_RELA.value::u32) {
            val r: err[Fail] = reloc_section(c, i, s);
            if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section header", i::u64)}; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the bytes a REL section's implicit addends are read from: the target's
# contents, or its inflated contents when the target is compressed
fun fields_of(c: *Conv, target: u32, plain: *Sink) Bytes {
    if (sink.len(plain) != 0) { ret Bytes{data: sink.data(plain), len: sink.len(plain)}; }
    val sec: *object.Section = object.section_at(c.o, Id[object.Section]{index: target});
    ret object.bytes(c.o, ?sec.contents);
}

# inflate the section a REL section applies to into `plain`, when it is compressed
fun inflate_target(c: *Conv, s: *model.Section, plain: *Sink) err[Fail] {
    if (s.type != tables.SHT_REL.value::u32) { ret err[Fail].ok{}; }
    val t: *model.Section = model.section_at(c.m, table.nth[model.Section](s.info::usize));
    if (!sel t.body.compressed) { ret err[Fail].ok{}; }
    if (t.body.compressed.type != tables.ELFCOMPRESS_ZLIB.value::u32) {
        ret err[Fail].err{fail.unsupported("only zlib compressed sections can have relocations read")};
    }
    val n: res[usize, Fail] = checked.to_usize(Location{}, t.body.compressed.length);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val z: err[Fail] = sink.zeros(plain, n.ok);
    if (sel z.err) { ret z; }
    val src: Bytes                      = model.bytes(c.m, ?t.body.compressed.data);
    val got: res[usize, I.InflateError] = zlib.decompress_into(c.m.a, src.data, src.len, sink.data(plain), n.ok);
    if (sel got.err)    { ret err[Fail].err{fail.malformed("compressed section does not inflate")}; }
    if (got.ok != n.ok) { ret err[Fail].err{fail.malformed("compressed section does not inflate to its stated size")}; }
    ret err[Fail].ok{};
}

fun reloc_section(c: *Conv, i: usize, s: *model.Section) err[Fail] {
    if (!c.have || s.link != c.symtab)                              { ret err[Fail].err{fail.malformed("relocation section names no symbol table")}; }
    if (s.info::usize >= table.count[model.Section](?c.m.sections)) { ret err[Fail].err{fail.malformed("relocation section applies to a section past the section headers")}; }
    val target: u32 = table.items[u32](?c.map)[s.info::usize];
    if (target == 0) { ret err[Fail].err{fail.unsupported("relocation section applies to a section with no neutral form")}; }
    val name: res[Bytes, Fail] = section_name(c, s);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    var n: usize = 0;
    if (sel s.body.rela) { n = table.count[model.Rela](?s.body.rela); }
    or (sel s.body.rel)  { n = table.count[model.Rel](?s.body.rel); }
    or                   { ret err[Fail].err{fail.malformed("relocation section holds no relocations")}; }
    var plain:    Sink      = sink.make(c.m.a, c.m.shape.order);
    val inflated: err[Fail] = inflate_target(c, s, ?plain);
    if (sel inflated.err) {
        val dropped: err[Fail] = sink.release(?plain);
        ret inflated;
    }
    val data: Bytes = fields_of(c, target - 1, ?plain);
    var k:    usize = 0;
    for (k < n) {
        var offset: u64 = 0;
        var info:   u64 = 0;
        var addend: i64 = 0;
        var width:  u64 = c.m.shape.class.rel.size::u64;
        if (sel s.body.rela) {
            val e: *model.Rela = table.at[model.Rela](?s.body.rela, table.nth[model.Rela](k));
            offset = e.offset;
            info   = e.info;
            addend = e.addend;
            width  = c.m.shape.class.rela.size::u64;
        }
        or (sel s.body.rel) {
            val e: *model.Rel = table.at[model.Rel](?s.body.rel, table.nth[model.Rel](k));
            offset = e.offset;
            info   = e.info;
        }
        val at: u64       = s.offset + k::u64 * width;
        val r:  err[Fail] = reloc_in(c, name.ok, data, sel s.body.rela, target - 1, offset, info, addend);
        if (sel r.err) {
            val dropped: err[Fail] = sink.release(?plain);
            ret err[Fail].err{fail.at_offset(fail.in_indexed(r.err, name.ok.data::str, k::u64), at)};
        }
        k = k + 1;
    }
    ret sink.release(?plain);
}

fun reloc_in(c: *Conv, name: Bytes, data: Bytes, rela: bool, target: u32, offset: u64, info: u64, record: i64) err[Fail] {
    val sym: u64 = model.reloc_symbol(c.m.shape.class, info);
    if (sym >= c.nsyms::u64) { ret err[Fail].err{fail.malformed("relocation names a symbol past the symbol table")}; }
    var refers:   object.Target = object.Target.symbol{Id[object.Symbol]{index: sym::u32}};
    val nameless: bool          = format.reads_nameless(?format.ELF, sym);
    if (nameless) { refers = object.Target.none{}; }
    val code:  u64             = model.reloc_type(c.m.shape.class, info);
    val found: res[*Row, Fail] = row.by_code(c.set, code::u32);
    if (sel found.err) { ret err[Fail].err{fail.unsupported("no relocation row has this code")}; }
    var addend: i64 = record;
    if (!rela) {
        if (sel found.ok.addend.record) { ret err[Fail].err{fail.unsupported("relocation without an addend for a code that keeps it in the record")}; }
        val site: Site           = Site{section: name.data::str, data: data.data, size: data.len::u64, offset: offset, order: c.m.shape.order};
        val got:  res[i64, Fail] = engine.extract(found.ok, ?site);
        if (sel got.err) { ret err[Fail].err{got.err}; }
        addend = got.ok;
    }
    val added: res[Id[object.Reloc], Fail] = object.add_reloc(c.o, object.Reloc{
        section: Id[object.Section]{index: target},
        offset:  offset,
        kind:    found.ok.kind,
        target:  refers,
        addend:  addend,
    });
    if (sel added.err) { ret err[Fail].err{added.err}; }
    ret err[Fail].ok{};
}

# add what the model holds to `o`, which holds nothing yet. the conversion
# builds a blank object and commits it to `o` once it succeeds, so a refusal
# leaves `o` as it was
pub fun to_neutral(m: *Elf, o: *Object) err[Fail] {
    if (!object.empty(o)) { ret err[Fail].err{fail.internal("a model converts into an empty neutral object")}; }
    val reg: res[Registry, Fail] = builtin.registry(m.a);
    if (sel reg.err) { ret err[Fail].err{reg.err}; }
    var built: Object    = object.blank(o);
    var c:     Conv      = Conv{m: m, o: ?built, reg: reg.ok, role: table.make[u8](m.a), map: table.make[u32](m.a), words: traits.make_words(m.a, 0)};
    var r:     err[Fail] = convert(?c);
    r = kept(r, table.release[u8](?c.role));
    r = kept(r, table.release[u32](?c.map));
    r = kept(r, traits.release_words(?c.words));
    r = kept(r, row.release(?c.reg));
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?built);
        ret r;
    }
    ret object.commit(o, ?built);
}

fun begin(c: *Conv) err[Fail] {
    val m: *Elf = c.m;
    if (table.count[model.Segment](?m.segments) != 0) {
        ret err[Fail].err{fail.in_record(fail.unsupported("a relocatable file with program headers has no neutral form"), "file header")};
    }
    var class: u32 = tables.ELFCLASS32.value::u32;
    if (m.shape.class == ?model.CLASS64) { class = tables.ELFCLASS64.value::u32; }
    val a: res[*Arch, Fail] = arch.by_code(?format.ELF, m.header.machine::u32, class);
    if (sel a.err) { ret err[Fail].err{fail.in_record(a.err, "file header")}; }
    if (a.ok.order != m.shape.order) {
        ret err[Fail].err{fail.in_record(fail.unsupported("the file's byte order is not the architecture's"), "file header")};
    }
    c.o.arch = a.ok;
    val set: res[*Lookup, Fail] = row.find(?c.reg, ?format.ELF, a.ok);
    if (sel set.err) { ret err[Fail].err{set.err}; }
    c.set = set.ok;
    ret err[Fail].ok{};
}

# the traits e_flags and the GNU properties state, leaving in the words the bits no trait row maps
fun traits_in(c: *Conv) err[Fail] {
    val w: err[Fail] = traits.words_of(c.m, ?c.words);
    if (sel w.err) { ret err[Fail].err{fail.in_record(w.err, "file header")}; }
    ret traits.decode(c.o.arch, ?c.words, ?c.o.traits);
}

fun convert(c: *Conv) err[Fail] {
    val b: err[Fail] = begin(c);
    if (sel b.err) { ret b; }
    val r: err[Fail] = roles_of(c);
    if (sel r.err) { ret r; }
    val t: err[Fail] = traits_in(c);
    if (sel t.err) { ret t; }
    val at: err[Fail] = attributes_in(c);
    if (sel at.err) { ret at; }
    val h: err[Fail] = header_facts(c);
    if (sel h.err) { ret h; }
    val p: err[Fail] = property_facts(c);
    if (sel p.err) { ret p; }
    val s: err[Fail] = sections_in(c);
    if (sel s.err) { ret s; }
    val y: err[Fail] = symbols_in(c);
    if (sel y.err) { ret y; }
    val l: err[Fail] = links_in(c);
    if (sel l.err) { ret l; }
    val sf: err[Fail] = section_facts(c);
    if (sel sf.err) { ret sf; }
    val yf: err[Fail] = symbol_facts(c);
    if (sel yf.err) { ret yf; }
    ret relocs_in(c);
}

# a section's facts
# ---
# typed:   whether a fact states its type
# symbols: whether its link is the symbol table
rec Pending {
    typed:   bool;
    type:    u32;
    extra:   u64;
    symbols: bool;
}

# a relocation section to write: the neutral section it applies to, whether
# its records carry the addend, and its index in the model
rec RelSec {
    target: u32;
    rela:   bool;
    index:  u32;
}

# the model being built
# ---
# reg:         the relocation sets
# set:         the relocation rows of the architecture
# code:        the architecture's ELF code
# nsec:        how many neutral sections there are
# nsym:        how many neutral symbols there are
# synth:       whether an ELF null symbol is added ahead of them
# perm:        per neutral symbol, its index in the symbol table
# pend:        per neutral section, its facts
# other:       per neutral symbol, its st_other bits past the visibility
# rows:        per relocation, its row
# rel_of:      per neutral section and addend form, the index of its relocation section, or zero
# rels:        the relocation sections, in model order
# ids:         per model section, its name in the section name table
# names:       the section name table
# snames:      the symbol name table
# sym_ids:     per model symbol, its name in the symbol name table
# syms:        the symbol table
# shndx:       the extended section indexes, empty when no symbol needs one
# flags:       the e_flags, osabi and abi version the facts state
# words:       e_flags and the one word GNU properties, the facts' and the traits' together
# stated:      the one word GNU properties the facts state, which keep their place in the note
# raws:        how many GNU properties the facts state that are not one word
# props:       how many GNU properties the note holds
# note_in:     the neutral section the facts name to hold the GNU property note
# noted:       whether a neutral section the facts do not name is the GNU property
#              note, which then holds its properties as bytes
# vendor:      the vendor whose build attributes the architecture's traits are in
# attrs:       the build attributes the object states, in tag order
# attrs_in:    the neutral section the facts name to hold the build attributes
# attrs_noted: whether a neutral section the facts do not name has the name
#              of the build attributes section
# props_at, attrs_at, rels_at, groups_at, symtab_at, strtab_at, shstr_at, shndx_at:
#          the model index of each section the build adds, zero for none
# first:        per name, the first symbol of the name plus one, a defined one before an undefined
# gstart:       per group, where its members start in gmem
# gmem:         the neutral sections of each group, group after group
# first_global: the index of the first symbol that is not local
rec Build {
    a:            *A.Allocator;
    o:            *Object;
    m:            Elf;
    reg:          Registry;
    set:          *Lookup;
    code:         Code;
    nsec:         usize;
    nsym:         usize;
    synth:        bool;
    perm:         Table[u32];
    pend:         Table[Pending];
    other:        Table[u8];
    rows:         Table[*Row];
    rel_of:       Table[u32];
    rels:         Table[RelSec];
    ids:          Table[Id[Name]];
    names:        Strtab;
    snames:       Strtab;
    sym_ids:      Table[Id[Name]];
    syms:         Table[model.Symbol];
    shndx:        Table[u32];
    first:        Table[u32];
    gstart:       Table[u32];
    gmem:         Table[u32];
    flags:        u32;
    osabi:        u8;
    abiversion:   u8;
    words:        Words;
    stated:       Words;
    raws:         usize;
    props:        usize;
    note_in:      opt[u32];
    noted:        bool;
    vendor:       opt[*Vendor];
    attrs:        Table[Attribute];
    attrs_in:     opt[u32];
    attrs_noted:  bool;
    props_at:     u32;
    attrs_at:     u32;
    rels_at:      u32;
    groups_at:    u32;
    symtab_at:    u32;
    strtab_at:    u32;
    shstr_at:     u32;
    shndx_at:     u32;
    first_global: u32;
    syms_given:   bool;
    shndx_given:  bool;
}

fun is_local(b: *Build, k: usize) bool {
    ret !symbol.binds(object.symbol_at(b.o, Id[object.Symbol]{index: k::u32}).binding, symbol.EXTERNAL);
}

# the symbol the file's null symbol is: one that says nothing
fun is_null(o: *Object, k: usize) bool {
    val s: *object.Symbol = object.symbol_at(o, Id[object.Symbol]{index: k::u32});
    ret object.name_of(o, s.name).len == 0 && s.binding == ?symbol.LOCAL && s.kind == ?symbol.NOTYPE && s.visibility == ?symbol.DEFAULT && sel s.def.undefined;
}

fun facts_out(b: *Build) err[Fail] {
    val gp: res[Id[Pending], Fail] = table.grow[Pending](?b.pend, b.nsec);
    if (sel gp.err) { ret err[Fail].err{gp.err}; }
    val go: res[Id[u8], Fail] = table.grow[u8](?b.other, b.nsym);
    if (sel go.err) { ret err[Fail].err{go.err}; }
    var i: usize = 0;
    for (i < table.count[object.Fact](?b.o.facts)) {
        val f: *object.Fact = table.at[object.Fact](?b.o.facts, table.nth[object.Fact](i));
        i = i + 1;
        if (f.format != ?format.ELF) { cnt; }
        val r: err[Fail] = fact_out(b, f);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "fact", (i - 1)::u64)}; }
    }
    b.vendor = traits.vendor_of(b.o.arch);
    var n: usize = 0;
    for (n < b.nsec) {
        val v: View = object.name_of(b.o, object.section_at(b.o, Id[object.Section]{index: n::u32}).name);
        if (named(v, PROPERTY_SECTION) && !is_note_in(b, n)) { b.noted = true; }
        if (sel b.vendor.some) {
            if (named(v, b.vendor.some.section) && !is_attrs_in(b, n)) { b.attrs_noted = true; }
        }
        n = n + 1;
    }
    ret err[Fail].ok{};
}

fun named(v: View, name: str) bool {
    ret v.len == str_len(name) && starts(Bytes{data: v.data, len: v.len}, name);
}

# whether neutral section `n` is the one the facts name to hold the build attributes
fun is_attrs_in(b: *Build, n: usize) bool {
    ret sel b.attrs_in.some && b.attrs_in.some::usize == n;
}

# whether neutral section `n` is the one the facts name to hold the GNU property note
fun is_note_in(b: *Build, n: usize) bool {
    ret sel b.note_in.some && b.note_in.some::usize == n;
}

fun fact_out(b: *Build, f: *object.Fact) err[Fail] {
    val v: u64 = f.value;
    if (f.key == FLAGS || f.key == OSABI || f.key == ABIVERSION) {
        var limit: u64 = 0xffff_ffff;
        if (f.key != FLAGS) { limit = 0xff; }
        if (v > limit)      { ret err[Fail].err{fail.overflow("ELF fact is wider than its field")}; }
        if (f.key == FLAGS) { b.flags = v::u32; }
        or (f.key == OSABI) { b.osabi = v::u8; }
        or                  { b.abiversion = v::u8; }
        ret err[Fail].ok{};
    }
    if (f.key == PROPERTY) {
        if (v > 0xffff_ffff) { ret err[Fail].err{fail.overflow("GNU property type is wider than its field")}; }
        val d: Bytes = object.bytes(b.o, ?f.data);
        if (d.len != 4) {
            b.raws = b.raws + 1;
            ret err[Fail].ok{};
        }
        var rd: Reader         = reader.make(nil, d.data, d.len, b.m.shape.order);
        val w:  res[u32, Fail] = reader.u32(?rd);
        if (sel w.err) { ret err[Fail].err{w.err}; }
        val first: err[Fail] = traits.add_word(?b.stated, Word{type: v::u32, value: w.ok});
        if (sel first.err) { ret first; }
        ret traits.add_word(?b.words, Word{type: v::u32, value: w.ok});
    }
    if (f.key == SECTION_TYPE || f.key == SECTION_FLAGS || f.key == SECTION_SYMBOLS) {
        var n: u64 = v;
        if (f.key == SECTION_TYPE) { n = v >> 32; }
        if (n >= b.nsec::u64)      { ret err[Fail].err{fail.malformed("fact names a section the object does not have")}; }
        val p: *Pending = table.at[Pending](?b.pend, table.nth[Pending](n::usize));
        if (f.key == SECTION_TYPE) {
            p.typed = true;
            p.type  = (v & 0xffff_ffff)::u32;
            ret err[Fail].ok{};
        }
        if (f.key == SECTION_SYMBOLS) {
            p.symbols = true;
            ret err[Fail].ok{};
        }
        val bits: Bytes = object.bytes(b.o, ?f.data);
        if (bits.len != 8) { ret err[Fail].err{fail.malformed("section flags fact does not hold eight bytes")}; }
        var k: usize = 0;
        for (k < 8) {
            p.extra = p.extra | (bits.data[k]::u64 << (k::u64 * 8));
            k       = k + 1;
        }
        ret err[Fail].ok{};
    }
    if (f.key == SYMBOL_OTHER) {
        if ((v >> 8) >= b.nsym::u64) { ret err[Fail].err{fail.malformed("fact names a symbol the object does not have")}; }
        table.items[u8](?b.other)[(v >> 8)::usize] = (v & 0xff)::u8;
        ret err[Fail].ok{};
    }
    if (f.key == PROPERTY_NOTE) {
        if (v >= b.nsec::u64) { ret err[Fail].err{fail.malformed("fact names a section the object does not have")}; }
        val taken: bool = sel b.note_in.some;
        if (taken) { ret err[Fail].err{fail.malformed("more than one section holds the GNU property note")}; }
        val sec: *object.Section = object.section_at(b.o, Id[object.Section]{index: v::u32});
        if (!sel sec.contents.held || object.bytes(b.o, ?sec.contents).len != 0) {
            ret err[Fail].err{fail.malformed("the section that holds the GNU property note has bytes of its own")};
        }
        b.note_in = opt[u32].some{v::u32};
        ret err[Fail].ok{};
    }
    if (f.key == ATTRIBUTE) { ret err[Fail].ok{}; }
    if (f.key == ATTRIBUTES) {
        if (v >= b.nsec::u64) { ret err[Fail].err{fail.malformed("fact names a section the object does not have")}; }
        val taken: bool = sel b.attrs_in.some;
        if (taken) { ret err[Fail].err{fail.malformed("more than one section holds the build attributes")}; }
        val sec: *object.Section = object.section_at(b.o, Id[object.Section]{index: v::u32});
        if (!sel sec.contents.held || object.bytes(b.o, ?sec.contents).len != 0) {
            ret err[Fail].err{fail.malformed("the section that holds the build attributes has bytes of its own")};
        }
        b.attrs_in = opt[u32].some{v::u32};
        ret err[Fail].ok{};
    }
    ret err[Fail].err{fail.unsupported("ELF fact has no meaning")};
}

# encode the object's traits over the words its facts state, which then hold
# every bit of e_flags and every one word property
fun traits_out(b: *Build) err[Fail] {
    b.words.flags = b.flags;
    val e: err[Fail] = traits.encode(b.o.arch, ?b.o.traits, ?b.words);
    if (sel e.err) { ret e; }
    b.flags = b.words.flags;
    b.props = table.count[Word](?b.words.properties) + b.raws;
    if (b.noted && b.props != 0) { ret err[Fail].err{fail.unsupported("the object states GNU properties and holds the note that holds them")}; }
    ret err[Fail].ok{};
}

# the build attributes the object's traits and facts state
fun attributes_out(b: *Build) err[Fail] {
    if (sel b.vendor.none) {
        val noted: opt[*Fact] = object.fact(b.o, ?format.ELF, ATTRIBUTE);
        if (sel b.attrs_in.some || sel noted.some) { ret err[Fail].err{fail.malformed("the object states build attributes its architecture has none of")}; }
        ret err[Fail].ok{};
    }
    val r: err[Fail] = attributes_of(b.o.arch, b.vendor.some, ?b.o.traits, ?b.o.facts, store.base(?b.o.store), ?b.attrs);
    if (sel r.err) { ret r; }
    if (b.attrs_noted && table.count[Attribute](?b.attrs) != 0) {
        ret err[Fail].err{fail.unsupported("the object states build attributes and holds the section that holds them")};
    }
    ret err[Fail].ok{};
}

fun order_attributes(a: *Attribute, b: *Attribute) i64 {
    if (a.tag < b.tag) { ret -1; }
    if (a.tag > b.tag) { ret 1; }
    ret 0;
}

# add to `out`, in tag order, the build attributes of `v` that the traits `ts`
# of an object for `a` and the ELF facts `facts` state, the bytes they own
# beginning at `base`. a value a row cannot write and a tag stated twice are
# refused. a text is borrowed from where its owner keeps it
pub fun attributes_of(a: *Arch, v: *Vendor, ts: *Table[Trait], facts: *Table[Fact], base: *u8, out: *Table[Attribute]) err[Fail] {
    val mark: usize     = table.count[Attribute](out);
    val r:    err[Fail] = attributes_listed(a, v, ts, facts, base, out);
    if (sel r.err) {
        table.truncate[Attribute](out, mark);
        ret r;
    }
    val n: usize = table.count[Attribute](out) - mark;
    sort.sort_by[Attribute](?table.items[Attribute](out)[mark], n, order_attributes);
    var i: usize = 1;
    for (i < n) {
        val prev: *Attribute = ?table.items[Attribute](out)[mark + i - 1];
        val next: *Attribute = ?table.items[Attribute](out)[mark + i];
        if (prev.tag == next.tag) {
            val tag: u64 = next.tag;
            table.truncate[Attribute](out, mark);
            ret err[Fail].err{fail.valued(fail.malformed("a build attribute is stated twice"), tag::i128)};
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun attributes_listed(a: *Arch, v: *Vendor, ts: *Table[Trait], facts: *Table[Fact], base: *u8, out: *Table[Attribute]) err[Fail] {
    var i: usize = 0;
    for (i < a.axis_count) {
        val x: *Axis                 = a.axes[i];
        val e: opt[*traits.Encoding] = traits.encoding_of(x);
        val t: opt[*Trait]           = trait.find(ts, x);
        i = i + 1;
        if (sel e.none) { cnt; }
        if (sel t.none) { cnt; }
        if (sel e.some.field.attribute) {
            if (e.some.field.attribute.vendor == v) {
                val r: err[Fail] = attribute_listed(e.some, e.some.field.attribute.tag, t.some, base, out);
                if (sel r.err) { ret r; }
            }
        }
    }
    i = 0;
    for (i < table.count[Fact](facts)) {
        val f: *Fact = table.at[Fact](facts, table.nth[Fact](i));
        i = i + 1;
        if (f.format != ?format.ELF || f.key != ATTRIBUTE) { cnt; }
        if (sel f.data.zero)                               { ret err[Fail].err{fail.valued(fail.malformed("a build attribute fact holds no value"), f.value::i128)}; }
        val d:     Bytes                       = store.at(base, ?f.data.held);
        val value: res[attributes.Value, Fail] = attribute_value_of(f.value, d);
        if (sel value.err) { ret err[Fail].err{fail.valued(value.err, f.value::i128)}; }
        val p: res[Id[Attribute], Fail] = table.push[Attribute](out, Attribute{tag: f.value, value: value.ok});
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    ret err[Fail].ok{};
}

# add the attribute `tag` that the trait `t` states through the row `e`
fun attribute_listed(e: *traits.Encoding, tag: u64, t: *Trait, base: *u8, out: *Table[Attribute]) err[Fail] {
    var text: Bytes = Bytes{data: nil, len: 0};
    if (sel t.setting.text) { text = store.at(base, ?t.setting.text); }
    val value: opt[attributes.Value] = traits.attribute_value(e, t.setting, text);
    if (sel value.none) { ret err[Fail].err{fail.about(fail.unsupported("ELF has no encoding for this trait value"), t.axis.name)}; }
    val p: res[Id[Attribute], Fail] = table.push[Attribute](out, Attribute{tag: tag, value: value.some});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the value of the attribute `tag` the section encoding `d` holds
fun attribute_value_of(tag: u64, d: Bytes) res[attributes.Value, Fail] {
    if (attributes.texted(tag)) {
        if (d.len == 0 || d.data[d.len - 1] != 0) { ret res[attributes.Value, Fail].err{fail.malformed("a build attribute string is not terminated")}; }
        ret res[attributes.Value, Fail].ok{attributes.Value.text{Bytes{data: d.data, len: d.len - 1}}};
    }
    var rd: Reader         = reader.make(nil, d.data, d.len, reader.LITTLE);
    val u:  res[u64, Fail] = reader.uleb(?rd);
    if (sel u.err)                  { ret res[attributes.Value, Fail].err{u.err}; }
    if (reader.remaining(?rd) != 0) { ret res[attributes.Value, Fail].err{fail.malformed("a build attribute number has bytes past its end")}; }
    ret res[attributes.Value, Fail].ok{attributes.Value.number{u.ok}};
}

# the row of every relocation, and the relocation section each lands in
fun rels_out(b: *Build) err[Fail] {
    val g: res[Id[u32], Fail] = table.grow[u32](?b.rel_of, b.nsec * 2);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var i: usize = 0;
    for (i < table.count[object.Reloc](?b.o.relocs)) {
        val r: *object.Reloc = table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](i));
        if (sel r.target.entry) { ret err[Fail].err{fail.in_indexed(fail.unsupported("ELF has no index spaces to relocate against"), "relocation", i::u64)}; }
        if (sel r.minus.some)   { ret err[Fail].err{fail.in_indexed(fail.unsupported("ELF relocations name no second symbol"), "relocation", i::u64)}; }
        if (r.section.index::usize >= b.nsec || (sel r.target.symbol && r.target.symbol.index::usize >= b.nsym)) {
            ret err[Fail].err{fail.in_indexed(fail.malformed("relocation names a section or symbol the object does not have"), "relocation", i::u64)};
        }
        val found: res[*Row, Fail] = row.by_kind(b.set, r.kind);
        if (sel found.err) { ret err[Fail].err{fail.in_indexed(found.err, "relocation", i::u64)}; }
        val pushed: res[Id[*Row], Fail] = table.push[*Row](?b.rows, found.ok);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        var key:  usize = r.section.index::usize * 2;
        val rela: bool  = sel found.ok.addend.record;
        if (rela) { key = key + 1; }
        val slot: *u32 = ?table.items[u32](?b.rel_of)[key];
        if (@slot == 0) {
            val added: res[Id[RelSec], Fail] = table.push[RelSec](?b.rels, RelSec{target: r.section.index, rela: rela});
            if (sel added.err) { ret err[Fail].err{added.err}; }
            @slot = added.ok.index + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the model index of every section the build adds
fun plan_out(b: *Build) err[Fail] {
    var at: u32 = 1 + b.nsec::u32;
    if (b.props > 0 && sel b.note_in.none) {
        b.props_at = at;
        at         = at + 1;
    }
    if (table.count[Attribute](?b.attrs) != 0 && sel b.attrs_in.none) {
        b.attrs_at = at;
        at         = at + 1;
    }
    b.rels_at = at;
    var i: usize = 0;
    for (i < table.count[RelSec](?b.rels)) {
        table.at[RelSec](?b.rels, table.nth[RelSec](i)).index = at;
        at                                                    = at + 1;
        i                                                     = i + 1;
    }
    b.groups_at = at;
    at          = at + table.count[object.Group](?b.o.groups)::u32;
    if (b.nsym > 0) {
        b.symtab_at = at;
        b.strtab_at = at + 1;
        at          = at + 2;
    }
    or (table.count[RelSec](?b.rels) != 0 || table.count[object.Group](?b.o.groups) != 0) {
        ret err[Fail].err{fail.malformed("relocations or groups with no symbols")};
    }
    b.shstr_at = at;
    ret err[Fail].ok{};
}

fun symbols_out(b: *Build) err[Fail] {
    if (b.nsym == 0) { ret err[Fail].ok{}; }
    b.synth = !is_null(b.o, 0);
    var total: usize = b.nsym;
    var next:  u32   = 0;
    if (b.synth) {
        total = total + 1;
        next  = 1;
    }
    val gp: res[Id[u32], Fail] = table.grow[u32](?b.perm, b.nsym);
    if (sel gp.err) { ret err[Fail].err{gp.err}; }
    val gs: res[Id[model.Symbol], Fail] = table.grow[model.Symbol](?b.syms, total);
    if (sel gs.err) { ret err[Fail].err{gs.err}; }
    val gi: res[Id[Id[Name]], Fail] = table.grow[Id[Name]](?b.sym_ids, total);
    if (sel gi.err) { ret err[Fail].err{gi.err}; }
    var pass: u8 = 0;
    for (pass < 2) {
        var k: usize = 0;
        for (k < b.nsym) {
            if (is_local(b, k) == (pass == 0)) {
                table.items[u32](?b.perm)[k] = next;
                next                         = next + 1;
            }
            k = k + 1;
        }
        if (pass == 0) { b.first_global = next; }
        pass = pass + 1;
    }
    val empty: res[Id[Name], Fail] = strtab.add_str(?b.snames, "");
    if (sel empty.err) { ret err[Fail].err{empty.err}; }
    table.items[Id[Name]](?b.sym_ids)[0] = empty.ok;
    var k: usize = 0;
    for (k < b.nsym) {
        val r: err[Fail] = symbol_out(b, k);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "symbol", k::u64)}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

fun symbol_out(b: *Build, k: usize) err[Fail] {
    val s:  *object.Symbol      = object.symbol_at(b.o, Id[object.Symbol]{index: k::u32});
    val at: usize               = table.items[u32](?b.perm)[k]::usize;
    val e:  *model.Symbol       = table.at[model.Symbol](?b.syms, table.nth[model.Symbol](at));
    val v:  View                = object.name_of(b.o, s.name);
    val id: res[Id[Name], Fail] = strtab.add(?b.snames, v.data, v.len);
    if (sel id.err) { ret err[Fail].err{id.err}; }
    table.items[Id[Name]](?b.sym_ids)[at] = id.ok;
    val bind: opt[u64] = code_of(?BINDINGS[0], BINDING_COUNT, s.binding::ptr);
    val kind: opt[u64] = code_of(?KINDS[0], KIND_COUNT, s.kind::ptr);
    val vis:  opt[u64] = code_of(?VISIBILITIES[0], VISIBILITY_COUNT, s.visibility::ptr);
    if (sel bind.none) { ret err[Fail].err{fail.unsupported("symbol binding has no ELF form")}; }
    if (sel kind.none) { ret err[Fail].err{fail.unsupported("symbol kind has no ELF form")}; }
    if (sel vis.none)  { ret err[Fail].err{fail.unsupported("symbol visibility has no ELF form")}; }
    e.info  = ((bind.some << 4) | kind.some)::u8;
    e.other = vis.some::u8 | table.items[u8](?b.other)[k];
    if (sel s.size.some) { e.bytes = s.size.some; }
    val d: Definition = s.def;
    if (sel d.entry) { ret err[Fail].err{fail.unsupported("ELF has no index spaces")}; }
    if (sel d.absolute) {
        e.shndx = tables.SHN_ABS.value::u16;
        e.value = d.absolute;
    }
    if (sel d.common) {
        e.shndx = tables.SHN_COMMON.value::u16;
        e.value = d.common.align;
        e.bytes = d.common.size;
    }
    if (sel d.placed) {
        if (d.placed.section.index::usize >= b.nsec) { ret err[Fail].err{fail.malformed("symbol is placed in a section the object does not have")}; }
        val index: u32 = d.placed.section.index + 1;
        e.value = d.placed.offset;
        e.shndx = index::u16;
        if (index >= tables.SHN_LORESERVE.value::u32) {
            e.shndx = tables.SHN_XINDEX.value::u16;
            if (table.count[u32](?b.shndx) == 0) {
                val g: res[Id[u32], Fail] = table.grow[u32](?b.shndx, table.count[model.Symbol](?b.syms));
                if (sel g.err) { ret err[Fail].err{g.err}; }
            }
            table.items[u32](?b.shndx)[at] = index;
        }
    }
    ret err[Fail].ok{};
}

# push a section and the name it takes in the section name table
fun push(b: *Build, s: model.Section, name: Id[Name]) err[Fail] {
    val r: res[Id[model.Section], Fail] = table.push[model.Section](?b.m.sections, s);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    val n: res[Id[Id[Name]], Fail] = table.push[Id[Name]](?b.ids, name);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    ret err[Fail].ok{};
}

fun push_named(b: *Build, s: model.Section, name: str) err[Fail] {
    val id: res[Id[Name], Fail] = strtab.add_str(?b.names, name);
    if (sel id.err) { ret err[Fail].err{id.err}; }
    ret push(b, s, id.ok);
}

fun sections_out(b: *Build) err[Fail] {
    val c: *Class    = b.m.shape.class;
    val z: err[Fail] = push_named(b, model.Section{body: Body.empty{}}, "");
    if (sel z.err) { ret z; }
    var n: usize = 0;
    for (n < b.nsec) {
        val r: err[Fail] = neutral_out(b, n);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section", n::u64)}; }
        n = n + 1;
    }
    if (sel b.note_in.some) {
        val r: err[Fail] = note_out(b, b.note_in.some + 1);
        if (sel r.err) { ret r; }
    }
    or (b.props > 0) {
        val r: err[Fail] = properties_out(b);
        if (sel r.err) { ret r; }
    }
    if (sel b.vendor.some) {
        if (sel b.attrs_in.some) {
            val r: err[Fail] = attributes_into(b, b.vendor.some, b.attrs_in.some + 1);
            if (sel r.err) { ret r; }
        }
        or (table.count[Attribute](?b.attrs) != 0) {
            val r: err[Fail] = attributes_section(b, b.vendor.some);
            if (sel r.err) { ret r; }
        }
    }
    var i: usize = 0;
    for (i < table.count[RelSec](?b.rels)) {
        val r: err[Fail] = rel_out(b, table.at[RelSec](?b.rels, table.nth[RelSec](i)));
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[object.Group](?b.o.groups)) {
        val r: err[Fail] = group_out(b, i);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "group", i::u64)}; }
        i = i + 1;
    }
    if (b.nsym > 0) {
        b.syms_given = true;
        val st: err[Fail] = push_named(b, model.Section{
            type:      tables.SHT_SYMTAB.value::u32,
            link:      b.strtab_at,
            info:      b.first_global,
            addralign: c.addr::u64,
            entsize:   c.symbol.size::u64,
            body:      Body.symbols{b.syms},
        }, ".symtab");
        if (sel st.err) { ret st; }
        val sr: err[Fail] = push_named(b, model.Section{type: tables.SHT_STRTAB.value::u32, addralign: 1, body: Body.empty{}}, ".strtab");
        if (sel sr.err) { ret sr; }
    }
    val sh: err[Fail] = push_named(b, model.Section{type: tables.SHT_STRTAB.value::u32, addralign: 1, body: Body.empty{}}, ".shstrtab");
    if (sel sh.err)                      { ret sh; }
    if (table.count[u32](?b.shndx) == 0) { ret err[Fail].ok{}; }
    b.shndx_given = true;
    ret push_named(b, model.Section{
        type:      tables.SHT_SYMTAB_SHNDX.value::u32,
        link:      b.symtab_at,
        addralign: model.WORD::u64,
        entsize:   model.WORD::u64,
        body:      Body.shndx{b.shndx},
    }, ".symtab_shndx");
}

fun neutral_out(b: *Build, n: usize) err[Fail] {
    val sec: *object.Section     = object.section_at(b.o, Id[object.Section]{index: n::u32});
    val v:   View                = object.name_of(b.o, sec.name);
    val id:  res[Id[Name], Fail] = strtab.add(?b.names, v.data, v.len);
    if (sel id.err) { ret err[Fail].err{id.err}; }
    val p:     *Pending = table.at[Pending](?b.pend, table.nth[Pending](n));
    var flags: u64      = elf_flags(sec.flags) | p.extra;
    var link:  u32      = 0;
    if (sel sec.group.some) { flags = flags | tables.SHF_GROUP.value; }
    if (sel sec.owner.some) {
        flags = flags | tables.SHF_LINK_ORDER.value;
        link  = sec.owner.some.index + 1;
    }
    or (p.symbols) {
        if (b.nsym == 0) { ret err[Fail].err{fail.malformed("section is linked to a symbol table the object does not have")}; }
        link = b.symtab_at;
    }
    var s: model.Section = model.Section{
        flags:     flags,
        link:      link,
        addralign: sec.align,
        entsize:   sec.entsize,
        body:      Body.empty{},
    };
    if (sel sec.contents.zero) {
        s.type   = tables.SHT_NOBITS.value::u32;
        s.length = sec.contents.zero;
    }
    or {
        val bytes: Bytes           = object.bytes(b.o, ?sec.contents);
        val held:  res[Held, Fail] = model.own(?b.m, bytes.data, bytes.len);
        if (sel held.err) { ret err[Fail].err{held.err}; }
        s.body = Body.raw{Raw{bytes: held.ok, why: Why.opaque{}}};
        s.type = type_of(sec.kind);
        if (p.typed)                                { s.type = p.type; }
        or (s.type == tables.SHT_NOBITS.value::u32) { s.type = tables.SHT_PROGBITS.value::u32; }
    }
    ret push(b, s, id.ok);
}

# the GNU property note, its properties in the order the facts state them,
# held by the model
fun note_bytes(b: *Build) res[Held, Fail] {
    var out: Sink      = sink.make(b.a, b.m.shape.order);
    val r:   err[Fail] = property_bytes(b, ?out, b.m.shape.class.addr);
    if (sel r.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret res[Held, Fail].err{r.err};
    }
    val held: res[Held, Fail] = model.own(?b.m, sink.data(?out), sink.len(?out));
    val rel:  err[Fail]       = sink.release(?out);
    if (sel held.err) { ret held; }
    if (sel rel.err)  { ret res[Held, Fail].err{rel.err}; }
    ret held;
}

# the GNU property note written into the section at model index `at`
fun note_out(b: *Build, at: u32) err[Fail] {
    val held: res[Held, Fail] = note_bytes(b);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    model.section_at(?b.m, table.nth[model.Section](at::usize)).body = Body.raw{Raw{bytes: held.ok, why: Why.opaque{}}};
    ret err[Fail].ok{};
}

# the build attributes section, held by the model
fun attributes_bytes(b: *Build, v: *Vendor) res[Held, Fail] {
    var out: Sink      = sink.make(b.a, b.m.shape.order);
    val r:   err[Fail] = attributes.write(v, table.items[Attribute](?b.attrs), table.count[Attribute](?b.attrs), ?out);
    if (sel r.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret res[Held, Fail].err{r.err};
    }
    val held: res[Held, Fail] = model.own(?b.m, sink.data(?out), sink.len(?out));
    val rel:  err[Fail]       = sink.release(?out);
    if (sel held.err) { ret held; }
    if (sel rel.err)  { ret res[Held, Fail].err{rel.err}; }
    ret held;
}

# the build attributes written into the section at model index `at`
fun attributes_into(b: *Build, v: *Vendor, at: u32) err[Fail] {
    val held: res[Held, Fail] = attributes_bytes(b, v);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    model.section_at(?b.m, table.nth[model.Section](at::usize)).body = Body.raw{Raw{bytes: held.ok, why: Why.opaque{}}};
    ret err[Fail].ok{};
}

# the build attributes as a section of their own, for an object whose facts
# name no section to hold them
fun attributes_section(b: *Build, v: *Vendor) err[Fail] {
    val held: res[Held, Fail] = attributes_bytes(b, v);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    ret push_named(b, model.Section{
        type:      v.type.value::u32,
        addralign: 1,
        body:      Body.raw{Raw{bytes: held.ok, why: Why.opaque{}}},
    }, v.section);
}

# the GNU property note as a section of its own, for an object whose facts
# name no section to hold it
fun properties_out(b: *Build) err[Fail] {
    val held: res[Held, Fail] = note_bytes(b);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    ret push_named(b, model.Section{
        type:      tables.SHT_NOTE.value::u32,
        flags:     tables.SHF_ALLOC.value,
        addralign: b.m.shape.class.addr::u64,
        body:      Body.raw{Raw{bytes: held.ok, why: Why.opaque{}}},
    }, PROPERTY_SECTION);
}

fun property_bytes(b: *Build, out: *Sink, pad: usize) err[Fail] {
    var body: Sink      = sink.make(b.a, b.m.shape.order);
    val r:    err[Fail] = property_body(b, ?body, pad);
    if (sel r.err) {
        val dropped: err[Fail] = sink.release(?body);
        ret r;
    }
    val w:   err[Fail] = property_note(out, sink.data(?body), sink.len(?body));
    val rel: err[Fail] = sink.release(?body);
    if (sel w.err) { ret w; }
    ret rel;
}

# the note header and the descriptor `data`
fun property_note(out: *Sink, data: *u8, len: usize) err[Fail] {
    val owner: usize     = str_len(PROPERTY_OWNER) + 1;
    val w1:    err[Fail] = sink.uint(out, owner::u64, 4);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = sink.uint(out, len::u64, 4);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = sink.uint(out, tables.NT_GNU_PROPERTY_TYPE_0.value, 4);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = sink.text(out, PROPERTY_OWNER);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = sink.zeros(out, 4 - str_len(PROPERTY_OWNER));
    if (sel w5.err) { ret w5; }
    ret sink.bytes(out, data, len);
}

# one property: its type, its size and its data padded to `pad`
fun property_put(out: *Sink, type: u64, data: Bytes, pad: usize) err[Fail] {
    val a1: err[Fail] = sink.uint(out, type, 4);
    if (sel a1.err) { ret a1; }
    val a2: err[Fail] = sink.uint(out, data.len::u64, 4);
    if (sel a2.err) { ret a2; }
    val a3: err[Fail] = sink.bytes(out, data.data, data.len);
    if (sel a3.err) { ret a3; }
    ret sink.zeros(out, (data.len + pad - 1) / pad * pad - data.len);
}

# one word property
fun word_put(b: *Build, out: *Sink, x: *Word, pad: usize) err[Fail] {
    var one:   Sink      = sink.make(b.a, b.m.shape.order);
    val put:   err[Fail] = sink.uint(?one, x.value::u64, 4);
    var wrote: err[Fail] = put;
    if (!sel put.err) { wrote = property_put(out, x.type::u64, Bytes{data: sink.data(?one), len: sink.len(?one)}, pad); }
    val rel: err[Fail] = sink.release(?one);
    if (sel wrote.err) { ret wrote; }
    ret rel;
}

# the properties in the order the facts state them, each word with the value
# the traits left it, then the words the traits added, by type
fun property_body(b: *Build, out: *Sink, pad: usize) err[Fail] {
    var i: usize = 0;
    for (i < table.count[object.Fact](?b.o.facts)) {
        val f: *object.Fact = table.at[object.Fact](?b.o.facts, table.nth[object.Fact](i));
        i = i + 1;
        if (f.format != ?format.ELF || f.key != PROPERTY) { cnt; }
        val d: Bytes = object.bytes(b.o, ?f.data);
        if (d.len != 4) {
            val r: err[Fail] = property_put(out, f.value, d, pad);
            if (sel r.err) { ret r; }
            cnt;
        }
        val w: opt[*Word] = traits.word(?b.words, f.value::u32);
        if (sel w.none) { ret err[Fail].err{fail.internal("a stated property is not among the words")}; }
        val r: err[Fail] = word_put(b, out, w.some, pad);
        if (sel r.err) { ret r; }
    }
    var k: usize = 0;
    for (k < table.count[Word](?b.words.properties)) {
        val x: *Word = table.at[Word](?b.words.properties, table.nth[Word](k));
        k = k + 1;
        val known: opt[*Word] = traits.word(?b.stated, x.type);
        if (sel known.some) { cnt; }
        val r: err[Fail] = word_put(b, out, x, pad);
        if (sel r.err) { ret r; }
    }
    ret err[Fail].ok{};
}

# the relocation section of one section and addend form
fun rel_out(b: *Build, r: *RelSec) err[Fail] {
    val c:    *Class          = b.m.shape.class;
    val sec:  *object.Section = object.section_at(b.o, Id[object.Section]{index: r.target});
    val v:    View            = object.name_of(b.o, sec.name);
    var name: Sink            = sink.make(b.a, b.m.shape.order);
    var lead: str             = ".rel";
    if (r.rela) { lead = ".rela"; }
    var w: err[Fail] = sink.text(?name, lead);
    if (sel w.err) {
        val dropped: err[Fail] = sink.release(?name);
        ret w;
    }
    val w2: err[Fail] = sink.bytes(?name, v.data, v.len);
    if (sel w2.err) {
        val dropped: err[Fail] = sink.release(?name);
        ret w2;
    }
    val id:  res[Id[Name], Fail] = strtab.add(?b.names, sink.data(?name), sink.len(?name));
    val rel: err[Fail]           = sink.release(?name);
    if (sel id.err)  { ret err[Fail].err{id.err}; }
    if (sel rel.err) { ret rel; }
    var s: model.Section = model.Section{
        flags:     tables.SHF_INFO_LINK.value,
        link:      b.symtab_at,
        info:      r.target + 1,
        addralign: c.addr::u64,
    };
    if (sel sec.group.some) { s.flags = s.flags | tables.SHF_GROUP.value; }
    if (r.rela) {
        s.type    = tables.SHT_RELA.value::u32;
        s.entsize = c.rela.size::u64;
        s.body    = Body.rela{table.make[Rela](b.a)};
    }
    or {
        s.type    = tables.SHT_REL.value::u32;
        s.entsize = c.rel.size::u64;
        s.body    = Body.rel{table.make[Rel](b.a)};
    }
    ret push(b, s, id.ok);
}

fun group_out(b: *Build, g: usize) err[Fail] {
    val c:   *Class        = b.m.shape.class;
    val grp: *object.Group = object.group_at(b.o, Id[object.Group]{index: g::u32});
    if (grp.rule != ?group.ANY || sel grp.leader.some) { ret err[Fail].err{fail.unsupported("ELF holds only COMDAT groups that keep any one copy")}; }
    val sig: res[u32, Fail] = signature_of(b, grp.signature);
    if (sel sig.err) { ret err[Fail].err{sig.err}; }
    var members: Table[u32] = table.make[u32](b.a);
    val r:       err[Fail]  = members_of(b, Id[object.Group]{index: g::u32}, ?members);
    if (sel r.err) {
        val dropped: err[Fail] = table.release[u32](?members);
        ret r;
    }
    val pushed: err[Fail] = push_named(b, model.Section{
        type:      tables.SHT_GROUP.value::u32,
        link:      b.symtab_at,
        info:      sig.ok,
        addralign: model.WORD::u64,
        entsize:   model.WORD::u64,
        body:      Body.group{model.Group{flags: tables.GRP_COMDAT.value::u32, members: members}},
    }, ".group");
    if (sel pushed.err) {
        val dropped: err[Fail] = table.release[u32](?members);
        ret pushed;
    }
    ret err[Fail].ok{};
}

# the symbol table index of the first symbol named `name`
fun signature_of(b: *Build, name: Id[Name]) res[u32, Fail] {
    if (name.index::usize >= table.count[u32](?b.first) || table.items[u32](?b.first)[name.index::usize] == 0) {
        ret res[u32, Fail].err{fail.malformed("group signature names no symbol")};
    }
    ret res[u32, Fail].ok{table.items[u32](?b.perm)[(table.items[u32](?b.first)[name.index::usize] - 1)::usize]};
}

fun firsts_out(b: *Build) err[Fail] {
    val g: res[Id[u32], Fail] = table.grow[u32](?b.first, intern.count(?b.o.names));
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var k: usize = 0;
    for (k < b.nsym) {
        val s:    *object.Symbol = object.symbol_at(b.o, Id[object.Symbol]{index: k::u32});
        val slot: *u32           = ?table.items[u32](?b.first)[s.name.index::usize];
        if (@slot == 0) { @slot = k::u32 + 1; }
        or {
            val held: *object.Symbol = object.symbol_at(b.o, Id[object.Symbol]{index: @slot - 1});
            if (sel held.def.undefined && !sel s.def.undefined) { @slot = k::u32 + 1; }
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the neutral sections of each group, group after group
fun groups_prep(b: *Build) err[Fail] {
    val ng: usize              = table.count[object.Group](?b.o.groups);
    val g:  res[Id[u32], Fail] = table.grow[u32](?b.gstart, ng + 1);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var n: usize = 0;
    for (n < b.nsec) {
        val sec: *object.Section = object.section_at(b.o, Id[object.Section]{index: n::u32});
        if (sel sec.group.some) {
            if (sec.group.some.index::usize >= ng) { ret err[Fail].err{fail.malformed("section is in a group the object does not have")}; }
            table.items[u32](?b.gstart)[sec.group.some.index::usize + 1] = table.items[u32](?b.gstart)[sec.group.some.index::usize + 1] + 1;
        }
        n = n + 1;
    }
    var i: usize = 0;
    for (i < ng) {
        table.items[u32](?b.gstart)[i + 1] = table.items[u32](?b.gstart)[i + 1] + table.items[u32](?b.gstart)[i];
        i                                  = i + 1;
    }
    val total: usize              = table.items[u32](?b.gstart)[ng]::usize;
    val gm:    res[Id[u32], Fail] = table.grow[u32](?b.gmem, total);
    if (sel gm.err) { ret err[Fail].err{gm.err}; }
    var cursor: Table[u32]         = table.make[u32](b.a);
    val gc:     res[Id[u32], Fail] = table.grow[u32](?cursor, ng + 1);
    if (sel gc.err) {
        val dropped: err[Fail] = table.release[u32](?cursor);
        ret err[Fail].err{gc.err};
    }
    n = 0;
    for (n < b.nsec) {
        val sec: *object.Section = object.section_at(b.o, Id[object.Section]{index: n::u32});
        if (sel sec.group.some) {
            val at:   usize = sec.group.some.index::usize;
            val slot: *u32  = ?table.items[u32](?cursor)[at];
            table.items[u32](?b.gmem)[table.items[u32](?b.gstart)[at]::usize + (@slot)::usize] = n::u32;
            @slot                                                                              = @slot + 1;
        }
        n = n + 1;
    }
    ret table.release[u32](?cursor);
}

# the members of group `g`: each section in it, then its relocation sections
fun members_of(b: *Build, g: Id[object.Group], out: *Table[u32]) err[Fail] {
    var j: usize = table.items[u32](?b.gstart)[g.index::usize]::usize;
    for (j < table.items[u32](?b.gstart)[g.index::usize + 1]::usize) {
        val n: u32                = table.items[u32](?b.gmem)[j];
        val m: res[Id[u32], Fail] = table.push[u32](out, n + 1);
        if (sel m.err) { ret err[Fail].err{m.err}; }
        var form: usize = 0;
        for (form < 2) {
            val ord: u32 = table.items[u32](?b.rel_of)[n::usize * 2 + form];
            if (ord != 0) {
                val r: res[Id[u32], Fail] = table.push[u32](out, table.at[RelSec](?b.rels, table.nth[RelSec]((ord - 1)::usize)).index);
                if (sel r.err) { ret err[Fail].err{r.err}; }
            }
            form = form + 1;
        }
        j = j + 1;
    }
    ret err[Fail].ok{};
}

fun relocs_out(b: *Build) err[Fail] {
    var i: usize = 0;
    for (i < table.count[object.Reloc](?b.o.relocs)) {
        val r: err[Fail] = reloc_out(b, i);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "relocation", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun reloc_out(b: *Build, i: usize) err[Fail] {
    val c:  *Class        = b.m.shape.class;
    val r:  *object.Reloc = table.at[object.Reloc](?b.o.relocs, table.nth[object.Reloc](i));
    val rw: *Row          = table.items[*Row](?b.rows)[i];
    val tg: object.Target = r.target;
    if (sel tg.entry) { ret err[Fail].err{fail.unsupported("ELF has no index spaces to relocate against")}; }
    var sym: u64 = 0;
    if (sel tg.symbol) { sym = table.items[u32](?b.perm)[tg.symbol.index::usize]::u64; }
    or {
        val none: res[u64, Fail] = format.write_nameless(?format.ELF);
        if (sel none.err) { ret err[Fail].err{none.err}; }
        sym = none.ok;
    }
    if ((rw.code::u64 >> c.info_shift::u64) != 0) { ret err[Fail].err{fail.overflow("relocation code is wider than the record holds")}; }
    val info: u64   = model.reloc_info(c, sym, rw.code::u64);
    var key:  usize = r.section.index::usize * 2;
    val rela: bool  = sel rw.addend.record;
    if (rela) { key = key + 1; }
    val ord: *RelSec        = table.at[RelSec](?b.rels, table.nth[RelSec]((table.items[u32](?b.rel_of)[key] - 1)::usize));
    val dst: *model.Section = model.section_at(?b.m, table.nth[model.Section](ord.index::usize));
    if (rela) {
        if (!sel dst.body.rela) { ret err[Fail].err{fail.internal("relocation section holds no RELA records")}; }
        val p: res[Id[Rela], Fail] = table.push[Rela](?dst.body.rela, Rela{offset: r.offset, info: info, addend: r.addend});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        ret err[Fail].ok{};
    }
    if (!sel dst.body.rel) { ret err[Fail].err{fail.internal("relocation section holds no REL records")}; }
    val facts: *Pending = table.at[Pending](?b.pend, table.nth[Pending](r.section.index::usize));
    if ((facts.extra & tables.SHF_COMPRESSED.value) == 0) {
        val tgt: *model.Section = model.section_at(?b.m, table.nth[model.Section](r.section.index::usize + 1));
        if (!sel tgt.body.raw) { ret err[Fail].err{fail.malformed("relocation in a section with no bytes")}; }
        val bytes: Bytes     = model.bytes(?b.m, ?tgt.body.raw.bytes);
        val site:  Site      = Site{data: bytes.data, size: bytes.len::u64, offset: r.offset, order: b.m.shape.order};
        val put:   err[Fail] = engine.insert(rw, ?site, r.addend::i128);
        if (sel put.err) { ret put; }
    }
    val p: res[Id[Rel], Fail] = table.push[Rel](?dst.body.rel, Rel{offset: r.offset, info: info});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun offset_u32(t: *Strtab, id: Id[Name]) res[u32, Fail] {
    val at: u64 = strtab.offset(t, id);
    if (at > 0xffff_ffff) { ret res[u32, Fail].err{fail.overflow("string table is too large for its offsets")}; }
    ret res[u32, Fail].ok{at::u32};
}

# fix the names of both string tables and fill their sections
fun names_out(b: *Build) err[Fail] {
    val f: err[Fail] = strtab.finish(?b.names);
    if (sel f.err) { ret f; }
    var i: usize = 0;
    for (i < table.count[model.Section](?b.m.sections)) {
        val at: res[u32, Fail] = offset_u32(?b.names, table.items[Id[Name]](?b.ids)[i]);
        if (sel at.err) { ret err[Fail].err{at.err}; }
        model.section_at(?b.m, table.nth[model.Section](i)).name = at.ok;
        i                                                        = i + 1;
    }
    val w: err[Fail] = names_body(b, ?b.names, b.shstr_at);
    if (sel w.err)   { ret w; }
    if (b.nsym == 0) { ret err[Fail].ok{}; }
    val fs: err[Fail] = strtab.finish(?b.snames);
    if (sel fs.err) { ret fs; }
    var k: usize = 0;
    for (k < table.count[model.Symbol](?b.syms)) {
        val at: res[u32, Fail] = offset_u32(?b.snames, table.items[Id[Name]](?b.sym_ids)[k]);
        if (sel at.err) { ret err[Fail].err{at.err}; }
        table.at[model.Symbol](?b.syms, table.nth[model.Symbol](k)).name = at.ok;
        k                                                                = k + 1;
    }
    ret names_body(b, ?b.snames, b.strtab_at);
}

fun names_body(b: *Build, t: *Strtab, at: u32) err[Fail] {
    var out: Sink      = sink.make(b.a, b.m.shape.order);
    val w:   err[Fail] = strtab.write(t, ?out);
    if (sel w.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret w;
    }
    val held: res[Held, Fail] = model.own(?b.m, sink.data(?out), sink.len(?out));
    val rel:  err[Fail]       = sink.release(?out);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    if (sel rel.err)  { ret rel; }
    model.section_at(?b.m, table.nth[model.Section](at::usize)).body = Body.raw{Raw{bytes: held.ok, why: Why.opaque{}}};
    ret err[Fail].ok{};
}

fun begin_build(b: *Build) err[Fail] {
    val o: *Object = b.o;
    if (table.count[object.Entry](?o.entries) != 0) {
        ret err[Fail].err{fail.unsupported("ELF has no index spaces")};
    }
    if (table.count[object.Note](?o.notes) != 0) {
        ret err[Fail].err{fail.unsupported("ELF holds notes only in note sections")};
    }
    val code: opt[Code] = arch.code(o.arch, ?format.ELF);
    if (sel code.none) { ret err[Fail].err{fail.unsupported("the architecture has no ELF code")}; }
    b.code = code.some;
    var class: *Class = ?model.CLASS32;
    if (code.some.qualifier == tables.ELFCLASS64.value::u32) { class = ?model.CLASS64; }
    b.m = model.make(b.a, Shape{class: class, order: o.arch.order});
    val set: res[*Lookup, Fail] = row.find(?b.reg, ?format.ELF, o.arch);
    if (sel set.err) { ret err[Fail].err{set.err}; }
    b.set = set.ok;
    ret err[Fail].ok{};
}

fun build(b: *Build) err[Fail] {
    val s: err[Fail] = begin_build(b);
    if (sel s.err) { ret s; }
    val f: err[Fail] = facts_out(b);
    if (sel f.err) { ret f; }
    val t: err[Fail] = traits_out(b);
    if (sel t.err) { ret t; }
    val at: err[Fail] = attributes_out(b);
    if (sel at.err) { ret at; }
    val r: err[Fail] = rels_out(b);
    if (sel r.err) { ret r; }
    val p: err[Fail] = plan_out(b);
    if (sel p.err) { ret p; }
    val y: err[Fail] = symbols_out(b);
    if (sel y.err) { ret y; }
    val fi: err[Fail] = firsts_out(b);
    if (sel fi.err) { ret fi; }
    val gp: err[Fail] = groups_prep(b);
    if (sel gp.err) { ret gp; }
    val sc: err[Fail] = sections_out(b);
    if (sel sc.err) { ret sc; }
    val rl: err[Fail] = relocs_out(b);
    if (sel rl.err) { ret rl; }
    val nm: err[Fail] = names_out(b);
    if (sel nm.err) { ret nm; }
    val h: model.Header = header_out(b);
    b.m.header = h;
    ret model.renumber(?b.m, opt[u32].some{b.shstr_at});
}

fun header_out(b: *Build) model.Header {
    var h: model.Header;
    h.ident.version    = tables.EV_CURRENT.value::u8;
    h.ident.osabi      = b.osabi;
    h.ident.abiversion = b.abiversion;
    h.type             = tables.ET_REL.value::u16;
    h.machine          = b.code.value::u16;
    h.version          = tables.EV_CURRENT.value::u32;
    h.flags            = b.flags;
    ret h;
}

fun release_build(b: *Build) err[Fail] {
    var first: err[Fail] = table.release[u32](?b.perm);
    first = kept(first, table.release[Pending](?b.pend));
    first = kept(first, table.release[u8](?b.other));
    first = kept(first, table.release[*Row](?b.rows));
    first = kept(first, table.release[u32](?b.rel_of));
    first = kept(first, table.release[RelSec](?b.rels));
    first = kept(first, table.release[Id[Name]](?b.ids));
    first = kept(first, table.release[Id[Name]](?b.sym_ids));
    first = kept(first, table.release[u32](?b.first));
    first = kept(first, table.release[u32](?b.gstart));
    first = kept(first, table.release[u32](?b.gmem));
    first = kept(first, traits.release_words(?b.words));
    first = kept(first, traits.release_words(?b.stated));
    first = kept(first, table.release[Attribute](?b.attrs));
    first = kept(first, row.release(?b.reg));
    first = kept(first, strtab.release(?b.names));
    first = kept(first, strtab.release(?b.snames));
    if (!b.syms_given)  { first = kept(first, table.release[model.Symbol](?b.syms)); }
    if (!b.shndx_given) { first = kept(first, table.release[u32](?b.shndx)); }
    ret first;
}

fun kept(first: err[Fail], next: err[Fail]) err[Fail] {
    if (sel first.err) { ret first; }
    ret next;
}

# the model of `o`, laid out by the writer
pub fun from_neutral(a: *A.Allocator, o: *Object) res[Elf, Fail] {
    val conv: strtab.Convention   = strtab.Convention{lead: true, term: strtab.NUL};
    val reg:  res[Registry, Fail] = builtin.registry(a);
    if (sel reg.err) { ret res[Elf, Fail].err{reg.err}; }
    var b: Build = Build{
        a:       a,
        o:       o,
        reg:     reg.ok,
        m:       model.make(a, Shape{class: ?model.CLASS32, order: reader.LITTLE}),
        nsec:    table.count[object.Section](?o.sections),
        nsym:    table.count[object.Symbol](?o.symbols),
        perm:    table.make[u32](a),
        pend:    table.make[Pending](a),
        other:   table.make[u8](a),
        rows:    table.make[*Row](a),
        rel_of:  table.make[u32](a),
        rels:    table.make[RelSec](a),
        ids:     table.make[Id[Name]](a),
        names:   strtab.make(a, conv),
        snames:  strtab.make(a, conv),
        sym_ids: table.make[Id[Name]](a),
        syms:    table.make[model.Symbol](a),
        shndx:   table.make[u32](a),
        first:   table.make[u32](a),
        gstart:  table.make[u32](a),
        gmem:    table.make[u32](a),
        words:   traits.make_words(a, 0),
        stated:  traits.make_words(a, 0),
        attrs:   table.make[Attribute](a),
    };
    val r:   err[Fail] = build(?b);
    val rel: err[Fail] = release_build(?b);
    if (sel r.err) {
        val dropped: err[Fail] = model.release(?b.m);
        ret res[Elf, Fail].err{r.err};
    }
    if (sel rel.err) {
        val dropped: err[Fail] = model.release(?b.m);
        ret res[Elf, Fail].err{rel.err};
    }
    ret res[Elf, Fail].ok{b.m};
}

val CALL: [8]u8 = [8]u8{0x55, 0x48, 0x89, 0xe5, 0xe8, 0, 0, 0};
val ONE:  [8]u8 = [8]u8{1, 0, 0, 0, 0, 0, 0, 0};
val RET:  [8]u8 = [8]u8{0xc3, 0, 0, 0, 0, 0, 0, 0};
val ZERO: [8]u8 = [8]u8{0, 0, 0, 0, 0, 0, 0, 0};
# a TLSDESC call sequence: auipc a0, ld a1, addi a0, jalr t0
val TLSDESC_SEQUENCE: [16]u8 = [16]u8{0x17, 0x05, 0, 0, 0x83, 0x35, 0x05, 0, 0x13, 0x05, 0x05, 0, 0xe7, 0x82, 0x05, 0};

fun add_section(o: *Object, name: str, k: *section.Kind, flags: section.Flags, bytes: *u8, size: u64) res[Id[object.Section], Fail] {
    val nm: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel nm.err) { ret res[Id[object.Section], Fail].err{nm.err}; }
    var contents: Contents = Contents.zero{size};
    if (bytes != nil) {
        val held: res[Contents, Fail] = object.own(o, bytes, size::usize);
        if (sel held.err) { ret res[Id[object.Section], Fail].err{held.err}; }
        contents = held.ok;
    }
    ret object.add_section(o, object.Section{
        name:        nm.ok,
        kind:        k,
        flags:       flags,
        align:       8,
        contents:    contents,
        disposition: disposition_of(k, flags, false),
    });
}

fun add_symbol(o: *Object, name: str, b: *symbol.Binding, k: *symbol.Kind, def: Definition) res[Id[object.Symbol], Fail] {
    val nm: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel nm.err) { ret res[Id[object.Symbol], Fail].err{nm.err}; }
    ret object.add_symbol(o, object.Symbol{
        name:       nm.ok,
        binding:    b,
        visibility: ?symbol.DEFAULT,
        kind:       k,
        def:        def,
        size:       opt[u64].some{8},
    });
}

fun add_reloc(o: *Object, sec: Id[object.Section], at: u64, k: *reloc.Kind, sym: Id[object.Symbol], addend: i64) res[Id[object.Reloc], Fail] {
    ret object.add_reloc(o, object.Reloc{section: sec, offset: at, kind: k, target: object.Target.symbol{sym}, addend: addend});
}

# the null symbol every table starts with
fun add_null(o: *Object) res[Id[object.Symbol], Fail] {
    ret add_symbol(o, "", ?symbol.LOCAL, ?symbol.NOTYPE, Definition.undefined{});
}

# an object for `x` stating what a file without e_flags bits or GNU
# properties states
fun bare_object(a: *A.Allocator, x: *Arch) res[Object, Fail] {
    var o:   Object    = object.make(a, x);
    var w:   Words     = traits.make_words(a, 0);
    val r:   err[Fail] = traits.decode(x, ?w, ?o.traits);
    val rel: err[Fail] = traits.release_words(?w);
    var f:   err[Fail] = rel;
    if (sel r.err) { f = r; }
    if (sel f.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{f.err};
    }
    ret res[Object, Fail].ok{o};
}

# `o` as an ELF file in memory, read back and converted again
fun through_file(a: *A.Allocator, o: *Object) res[Object, Fail] {
    val built: res[Elf, Fail] = from_neutral(a, o);
    if (sel built.err) { ret res[Object, Fail].err{built.err}; }
    var m:        Elf             = built.ok;
    val w:        res[Sink, Fail] = write.write(a, ?m);
    val released: err[Fail]       = model.release(?m);
    if (sel w.err) { ret res[Object, Fail].err{w.err}; }
    var s:  Sink           = w.ok;
    var in: Input          = Input{file: "t.o", data: sink.data(?s), len: sink.len(?s)};
    val rd: res[Elf, Fail] = read.read(a, ?in);
    if (sel rd.err) {
        val dropped: err[Fail] = sink.release(?s);
        ret res[Object, Fail].err{rd.err};
    }
    var x:    Elf       = rd.ok;
    var back: Object    = object.make(a, o.arch);
    val conv: err[Fail] = to_neutral(?x, ?back);
    val r1:   err[Fail] = model.release(?x);
    val r2:   err[Fail] = sink.release(?s);
    if (sel conv.err) { ret res[Object, Fail].err{conv.err}; }
    ret res[Object, Fail].ok{back};
}

# whether `o` is the same object after a trip through an ELF file
fun survives(a: *A.Allocator, o: *Object) bool {
    val back: res[Object, Fail] = through_file(a, o);
    if (sel back.err) { ret false; }
    var again: Object    = back.ok;
    val same:  bool      = compare.difference(o, ?again) == nil;
    val rel:   err[Fail] = object.release(?again);
    ret same && !sel rel.err;
}

# the first section of `m` of `type`
fun first_of(m: *Elf, type: u32) opt[*model.Section] {
    var i: usize = 0;
    for (i < table.count[model.Section](?m.sections)) {
        val s: *model.Section = model.section_at(m, table.nth[model.Section](i));
        if (s.type == type) { ret opt[*model.Section].some{s}; }
        i = i + 1;
    }
    ret opt[*model.Section].none{};
}

test neutral__sections_symbols_and_relocations_convert_both_ways {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator      = T.allocator_of(?t);
    val bare: res[Object, Fail] = bare_object(a, ?arch.X86_64);
    if (sel bare.err) { ret 1; }
    var o:    Object                        = bare.ok;
    val code: res[Id[object.Section], Fail] = add_section(?o, ".text", ?section.TEXT, section.ALLOC | section.EXEC, ?CALL[0], 8);
    val data: res[Id[object.Section], Fail] = add_section(?o, ".data", ?section.DATA, section.ALLOC | section.WRITE, ?ONE[0], 8);
    val bss:  res[Id[object.Section], Fail] = add_section(?o, ".bss", ?section.BSS, section.ALLOC | section.WRITE, nil, 16);
    if (sel code.err) { ret 1; }
    if (sel data.err) { ret 1; }
    if (sel bss.err)  { ret 1; }
    val none:  res[Id[object.Symbol], Fail] = add_null(?o);
    val local: res[Id[object.Symbol], Fail] = add_symbol(?o, "counter", ?symbol.LOCAL, ?symbol.DATA, Definition.placed{object.Place{section: data.ok, offset: 0}});
    val main:  res[Id[object.Symbol], Fail] = add_symbol(?o, "main", ?symbol.GLOBAL, ?symbol.FUNCTION, Definition.placed{object.Place{section: code.ok, offset: 0}});
    val ext:   res[Id[object.Symbol], Fail] = add_symbol(?o, "puts", ?symbol.GLOBAL, ?symbol.NOTYPE, Definition.undefined{});
    if (sel none.err)  { ret 1; }
    if (sel local.err) { ret 1; }
    if (sel main.err)  { ret 1; }
    if (sel ext.err)   { ret 1; }
    val call: res[Id[object.Reloc], Fail] = add_reloc(?o, code.ok, 5, ?reloc.PLT32, ext.ok, -4);
    val abs:  res[Id[object.Reloc], Fail] = add_reloc(?o, data.ok, 0, ?reloc.ABS64, main.ok, 0);
    if (sel call.err) { ret 1; }
    if (sel abs.err)  { ret 1; }

    val built: res[Elf, Fail] = from_neutral(a, ?o);
    if (sel built.err) { ret 1; }
    var m:    Elf                 = built.ok;
    val rela: opt[*model.Section] = first_of(?m, tables.SHT_RELA.value::u32);
    val tab:  opt[*model.Section] = first_of(?m, tables.SHT_SYMTAB.value::u32);
    if (sel rela.none) { ret 1; }
    if (sel tab.none)  { ret 1; }
    val rs: *model.Section = rela.some;
    val ts: *model.Section = tab.some;
    if (!sel rs.body.rela)                                                          { ret 1; }
    if (!sel ts.body.symbols)                                                       { ret 1; }
    if (table.count[model.Rela](?rs.body.rela) != 1)                                { ret 1; }
    if (table.at[model.Rela](?rs.body.rela, table.nth[model.Rela](0)).addend != -4) { ret 1; }
    if (ts.info != 2 || table.count[model.Symbol](?ts.body.symbols) != 4)           { ret 1; }
    val released: err[Fail] = model.release(?m);
    if (sel released.err) { ret 1; }

    if (!survives(a, ?o)) { ret 1; }
    val rel: err[Fail] = object.release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test neutral__a_refused_conversion_leaves_the_object_empty {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator                  = T.allocator_of(?t);
    var o:    Object                        = object.make(a, ?arch.X86_64);
    val code: res[Id[object.Section], Fail] = add_section(?o, ".text", ?section.TEXT, section.ALLOC | section.EXEC, ?CALL[0], 8);
    if (sel code.err) { ret 1; }
    val none: res[Id[object.Symbol], Fail] = add_null(?o);
    val ext:  res[Id[object.Symbol], Fail] = add_symbol(?o, "puts", ?symbol.GLOBAL, ?symbol.NOTYPE, Definition.undefined{});
    if (sel none.err) { ret 1; }
    if (sel ext.err)  { ret 1; }
    val call: res[Id[object.Reloc], Fail] = add_reloc(?o, code.ok, 5, ?reloc.PLT32, ext.ok, -4);
    if (sel call.err) { ret 1; }
    val built: res[Elf, Fail] = from_neutral(a, ?o);
    if (sel built.err) { ret 1; }
    var m:    Elf                 = built.ok;
    val rela: opt[*model.Section] = first_of(?m, tables.SHT_RELA.value::u32);
    if (sel rela.none)            { ret 1; }
    if (!sel rela.some.body.rela) { ret 1; }
    val e: *model.Rela = table.at[model.Rela](?rela.some.body.rela, table.nth[model.Rela](0));
    e.info = (e.info & ~0xffff_ffff) | 0xff;

    var back:   Object    = object.make(a, nil);
    val before: usize     = T.live_count(?t);
    val conv:   err[Fail] = to_neutral(?m, ?back);
    if (sel conv.ok)                              { ret 1; }
    if (!sel conv.err.cause.unsupported)          { ret 1; }
    if (!object.empty(?back) || back.arch != nil) { ret 1; }
    if (T.live_count(?t) != before)               { ret 1; }

    val r1: err[Fail] = model.release(?m);
    val r2: err[Fail] = object.release(?back);
    val r3: err[Fail] = object.release(?o);
    if (sel r1.err || sel r2.err || sel r3.err) { ret 1; }
    if (T.live_count(?t) != 0)                  { ret 1; }
    T.dnit(?t);
    ret 0;
}

test neutral__a_group_is_an_elf_comdat_group_and_back {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator      = T.allocator_of(?t);
    val bare: res[Object, Fail] = bare_object(a, ?arch.X86_64);
    if (sel bare.err) { ret 1; }
    var o:    Object                        = bare.ok;
    val code: res[Id[object.Section], Fail] = add_section(?o, ".text.f", ?section.TEXT, section.ALLOC | section.EXEC, ?RET[0], 8);
    val data: res[Id[object.Section], Fail] = add_section(?o, ".data.f", ?section.DATA, section.ALLOC | section.WRITE, ?ZERO[0], 8);
    if (sel code.err) { ret 1; }
    if (sel data.err) { ret 1; }
    val none: res[Id[object.Symbol], Fail] = add_null(?o);
    val f:    res[Id[object.Symbol], Fail] = add_symbol(?o, "f", ?symbol.WEAKLY, ?symbol.FUNCTION, Definition.placed{object.Place{section: code.ok, offset: 0}});
    if (sel none.err) { ret 1; }
    if (sel f.err)    { ret 1; }
    val rl:  res[Id[object.Reloc], Fail] = add_reloc(?o, data.ok, 0, ?reloc.ABS64, f.ok, 0);
    val sig: res[Id[Name], Fail]         = object.name_str(?o, "f");
    if (sel rl.err)  { ret 1; }
    if (sel sig.err) { ret 1; }
    val g: res[Id[object.Group], Fail] = object.add_group(?o, object.Group{signature: sig.ok, rule: ?group.ANY});
    if (sel g.err) { ret 1; }
    object.section_at(?o, code.ok).group = opt[Id[object.Group]].some{g.ok};
    object.section_at(?o, data.ok).group = opt[Id[object.Group]].some{g.ok};

    val built: res[Elf, Fail] = from_neutral(a, ?o);
    if (sel built.err) { ret 1; }
    var m:   Elf                 = built.ok;
    val grp: opt[*model.Section] = first_of(?m, tables.SHT_GROUP.value::u32);
    if (sel grp.none) { ret 1; }
    val gs: *model.Section = grp.some;
    if (!sel gs.body.group)                                  { ret 1; }
    if (gs.body.group.flags != tables.GRP_COMDAT.value::u32) { ret 1; }
    if (table.count[u32](?gs.body.group.members) != 3)       { ret 1; }
    if ((gs.flags & tables.SHF_GROUP.value) != 0)            { ret 1; }
    val member: *model.Section = model.section_at(?m, table.nth[model.Section](1));
    if ((member.flags & tables.SHF_GROUP.value) == 0) { ret 1; }
    val released: err[Fail] = model.release(?m);
    if (sel released.err) { ret 1; }

    if (!survives(a, ?o)) { ret 1; }
    val rel: err[Fail] = object.release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test neutral__retain_is_an_elf_flag_and_back {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator      = T.allocator_of(?t);
    val bare: res[Object, Fail] = bare_object(a, ?arch.X86_64);
    if (sel bare.err) { ret 1; }
    var o:    Object                        = bare.ok;
    val kept: res[Id[object.Section], Fail] = add_section(?o, ".keep", ?section.DATA, section.ALLOC | section.WRITE | section.RETAIN, ?ONE[0], 8);
    if (sel kept.err) { ret 1; }

    val built: res[Elf, Fail] = from_neutral(a, ?o);
    if (sel built.err) { ret 1; }
    var m: Elf            = built.ok;
    val s: *model.Section = model.section_at(?m, table.nth[model.Section](1));
    if ((s.flags & tables.SHF_GNU_RETAIN.value) == 0) { ret 1; }
    var back:     Object    = object.make(a, ?arch.X86_64);
    val conv:     err[Fail] = to_neutral(?m, ?back);
    val released: err[Fail] = model.release(?m);
    if (sel conv.err)                                                                         { ret 1; }
    if (sel released.err)                                                                     { ret 1; }
    if ((object.section_at(?back, table.nth[object.Section](0)).flags & section.RETAIN) == 0) { ret 1; }
    if (compare.difference(?o, ?back) != nil)                                                 { ret 1; }

    val r1: err[Fail] = object.release(?back);
    val r2: err[Fail] = object.release(?o);
    if (sel r1.err)            { ret 1; }
    if (sel r2.err)            { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test neutral__common_and_absolute_symbols_keep_their_forms {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator      = T.allocator_of(?t);
    val bare: res[Object, Fail] = bare_object(a, ?arch.X86_64);
    if (sel bare.err) { ret 1; }
    var o:    Object                       = bare.ok;
    val none: res[Id[object.Symbol], Fail] = add_null(?o);
    val blk:  res[Id[object.Symbol], Fail] = add_symbol(?o, "block", ?symbol.GLOBAL, ?symbol.DATA, Definition.common{object.Common{size: 24, align: 16}});
    val abs:  res[Id[object.Symbol], Fail] = add_symbol(?o, "magic", ?symbol.GLOBAL, ?symbol.NOTYPE, Definition.absolute{0x1234});
    if (sel none.err) { ret 1; }
    if (sel blk.err)  { ret 1; }
    if (sel abs.err)  { ret 1; }
    object.symbol_at(?o, blk.ok).size = opt[u64].some{24};

    val built: res[Elf, Fail] = from_neutral(a, ?o);
    if (sel built.err) { ret 1; }
    var m:   Elf                 = built.ok;
    val tab: opt[*model.Section] = first_of(?m, tables.SHT_SYMTAB.value::u32);
    if (sel tab.none) { ret 1; }
    val ts: *model.Section = tab.some;
    if (!sel ts.body.symbols) { ret 1; }
    val c: *model.Symbol = table.at[model.Symbol](?ts.body.symbols, table.nth[model.Symbol](1));
    val x: *model.Symbol = table.at[model.Symbol](?ts.body.symbols, table.nth[model.Symbol](2));
    if (c.shndx != tables.SHN_COMMON.value::u16 || c.value != 16 || c.bytes != 24) { ret 1; }
    if (x.shndx != tables.SHN_ABS.value::u16 || x.value != 0x1234)                 { ret 1; }
    val released: err[Fail] = model.release(?m);
    if (sel released.err) { ret 1; }

    if (!survives(a, ?o)) { ret 1; }
    val rel: err[Fail] = object.release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test neutral__traits_own_the_flags_and_markers_name_no_symbol {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator                  = T.allocator_of(?t);
    var o:    Object                        = object.make(a, ?arch.RISCV64);
    val code: res[Id[object.Section], Fail] = add_section(?o, ".text", ?section.TEXT, section.ALLOC | section.EXEC, ?ZERO[0], 8);
    if (sel code.err) { ret 1; }
    val none: res[Id[object.Symbol], Fail] = add_null(?o);
    if (sel none.err) { ret 1; }
    val relax: res[Id[object.Reloc], Fail] = object.add_reloc(?o, object.Reloc{section: code.ok, offset: 0, kind: ?reloc.RELAX, target: object.Target.none{}, addend: 0});
    val align: res[Id[object.Reloc], Fail] = object.add_reloc(?o, object.Reloc{section: code.ok, offset: 4, kind: ?reloc.ALIGN, target: object.Target.none{}, addend: 4});
    if (sel relax.err) { ret 1; }
    if (sel align.err) { ret 1; }
    val abi: err[Fail] = object.state(?o, ?arch.RISCV_FLOAT_ABI, Setting.choice{?arch.RISCV_DOUBLE});
    val rvc: err[Fail] = object.state(?o, ?arch.RISCV_RVC, Setting.flag{true});
    val rve: err[Fail] = object.state(?o, ?arch.RISCV_RVE, Setting.flag{false});
    val tso: err[Fail] = object.state(?o, ?arch.RISCV_TSO, Setting.flag{false});
    if (sel abi.err) { ret 1; }
    if (sel rvc.err) { ret 1; }
    if (sel rve.err) { ret 1; }
    if (sel tso.err) { ret 1; }

    val built: res[Elf, Fail] = from_neutral(a, ?o);
    if (sel built.err) { ret 1; }
    var m:   Elf                 = built.ok;
    val tab: opt[*model.Section] = first_of(?m, tables.SHT_RELA.value::u32);
    if (m.header.flags != 0x5) { ret 1; }
    if (sel tab.none)          { ret 1; }
    val rs: *model.Section = tab.some;
    if (!sel rs.body.rela)                                                             { ret 1; }
    if (table.at[model.Rela](?rs.body.rela, table.nth[model.Rela](0)).info >> 32 != 0) { ret 1; }
    val released: err[Fail] = model.release(?m);
    if (sel released.err) { ret 1; }

    var back:  Object         = object.make(a, ?arch.RISCV64);
    val again: res[Elf, Fail] = from_neutral(a, ?o);
    if (sel again.err) { ret 1; }
    var n:    Elf       = again.ok;
    val conv: err[Fail] = to_neutral(?n, ?back);
    val rn:   err[Fail] = model.release(?n);
    if (sel conv.err) { ret 1; }
    if (sel rn.err)   { ret 1; }
    val flags: opt[*Fact] = object.fact(?back, ?format.ELF, FLAGS);
    if (sel flags.some) { ret 1; }
    val r1: err[Fail] = object.release(?back);
    if (sel r1.err) { ret 1; }

    if (!survives(a, ?o)) { ret 1; }
    val rel: err[Fail] = object.release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test neutral__a_riscv_tlsdesc_sequence_keeps_its_label {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator                  = T.allocator_of(?t);
    var o:    Object                        = object.make(a, ?arch.RISCV64);
    val code: res[Id[object.Section], Fail] = add_section(?o, ".text", ?section.TEXT, section.ALLOC | section.EXEC, ?TLSDESC_SEQUENCE[0], 16);
    if (sel code.err) { ret 1; }
    val none:  res[Id[object.Symbol], Fail] = add_null(?o);
    val label: res[Id[object.Symbol], Fail] = add_symbol(?o, ".Lh", ?symbol.LOCAL, ?symbol.NOTYPE, Definition.placed{object.Place{section: code.ok, offset: 0}});
    val x:     res[Id[object.Symbol], Fail] = add_symbol(?o, "x", ?symbol.GLOBAL, ?symbol.TLS, Definition.undefined{});
    if (sel none.err)  { ret 1; }
    if (sel label.err) { ret 1; }
    if (sel x.err)     { ret 1; }
    val hi:   res[Id[object.Reloc], Fail] = add_reloc(?o, code.ok, 0, ?reloc.TLSDESC_HI20, x.ok, 0);
    val load: res[Id[object.Reloc], Fail] = add_reloc(?o, code.ok, 4, ?reloc.TLSDESC_PCREL_LOAD_LO12, label.ok, 0);
    val add:  res[Id[object.Reloc], Fail] = add_reloc(?o, code.ok, 8, ?reloc.TLSDESC_PCREL_ADD_LO12, label.ok, 0);
    val call: res[Id[object.Reloc], Fail] = add_reloc(?o, code.ok, 12, ?reloc.TLSDESC_PCREL_CALL, label.ok, 0);
    if (sel hi.err || sel load.err || sel add.err || sel call.err) { ret 1; }

    val abi: err[Fail] = object.state(?o, ?arch.RISCV_FLOAT_ABI, Setting.choice{?arch.RISCV_DOUBLE});
    val rvc: err[Fail] = object.state(?o, ?arch.RISCV_RVC, Setting.flag{false});
    val rve: err[Fail] = object.state(?o, ?arch.RISCV_RVE, Setting.flag{false});
    val tso: err[Fail] = object.state(?o, ?arch.RISCV_TSO, Setting.flag{false});
    if (sel abi.err || sel rvc.err || sel rve.err || sel tso.err) { ret 1; }

    val back: res[Object, Fail] = through_file(a, ?o);
    if (sel back.err) { ret 2; }
    var b:  Object        = back.ok;
    val r:  *object.Reloc = table.at[object.Reloc](?b.relocs, table.nth[object.Reloc](3));
    val tg: object.Target = r.target;
    if (r.kind != ?reloc.TLSDESC_PCREL_CALL || r.offset != 12) { ret 3; }
    if (!sel tg.symbol)                                        { ret 3; }
    val s: *object.Symbol = object.symbol_at(?b, tg.symbol);
    if (s.kind != ?symbol.NOTYPE || object.name_of(?b, s.name).len != 3) { ret 4; }
    if (compare.difference(?o, ?b) != nil)                               { ret 5; }

    val r1: err[Fail] = object.release(?b);
    val r2: err[Fail] = object.release(?o);
    if (sel r1.err || sel r2.err) { ret 1; }
    if (T.live_count(?t) != 0)    { ret 1; }
    T.dnit(?t);
    ret 0;
}
