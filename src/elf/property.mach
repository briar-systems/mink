# the GNU properties of an ELF file as one set
#
# a file may state its GNU properties in several notes, as gcc and gas each
# write one, and their properties are one set of facts. a type one note
# states is the file's as that note states it. a word type several notes
# state merges bit by bit through the trait rows, each bit by its axis's
# rule, and a bit no row maps carries nothing, so it must be clear in every
# note. any other type several notes state carries nothing either, so its
# data must be all zero bytes in every note. what is refused names the type.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.elf.model;
use mink.elf.model.Body;
use mink.elf.model.Desc;
use mink.elf.model.Elf;
use mink.elf.model.Note;
use mink.elf.model.Property;
use mink.elf.model.Section;
use mink.elf.model.Shape;
use mink.elf.tables;
use mink.elf.tables.Constant;
use mink.elf.traits;
use mink.elf.traits.Word;
use mink.elf.traits.Words;
use mink.fail;
use mink.fail.Fail;
use mink.reader;
use mink.reader.Reader;
use mink.store.Bytes;
use mink.store.Held;
use mink.table;
use mink.table.Table;

# a GNU property of a file, what its notes state merged
# ---
# type: its type
# data: its data as the first note that states it holds it, borrowed from the model
# word: its merged value when its data is one word
# note: the last note that states it, counted across the file
pub rec Merged {
    type: u32;
    data: Bytes;
    word: u32;
    note: usize;
}

# merged: every type once, in the order of the types
# order:  the types in the order the file first states them
pub rec Set {
    merged: Table[Merged];
    order:  Table[u32];
}

pub fun make(a: *A.Allocator) Set {
    ret Set{merged: table.make[Merged](a), order: table.make[u32](a)};
}

pub fun release(s: *Set) err[Fail] {
    val m: err[Fail] = table.release[Merged](?s.merged);
    val o: err[Fail] = table.release[u32](?s.order);
    if (sel m.err) { ret m; }
    ret o;
}

fun order_merged(a: *Merged, b: *Merged) i64 {
    if (a.type < b.type) { ret -1; }
    if (a.type > b.type) { ret 1; }
    ret 0;
}

fun position(s: *Set, type: u32) SearchPosition {
    var probe: Merged = Merged{type: type};
    ret sort.binary_search_by[Merged](table.items[Merged](?s.merged), table.count[Merged](?s.merged), ?probe, order_merged);
}

# the property of `type` in `s`, none when the file states none
pub fun find(s: *Set, type: u32) opt[*Merged] {
    val at: SearchPosition = position(s, type);
    if (sel at.found) { ret opt[*Merged].some{table.at[Merged](?s.merged, table.nth[Merged](at.found))}; }
    ret opt[*Merged].none{};
}

# add to `out` the properties of every GNU property note of `m`, a file for
# `a`, merged. a type one note states twice is malformed, and notes whose
# values of a type do not merge are refused, naming it
pub fun gather(m: *Elf, a: *Arch, out: *Set) err[Fail] {
    var n: usize = 0;
    var i: usize = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = model.section_at(m, table.nth[Section](i));
        i = i + 1;
        if (!sel s.body.notes) { cnt; }
        var k: usize = 0;
        for (k < table.count[Note](?s.body.notes)) {
            val note: *Note = table.at[Note](?s.body.notes, table.nth[Note](k));
            k = k + 1;
            if (!sel note.desc.properties) { cnt; }
            n = n + 1;
            var j: usize = 0;
            for (j < table.count[Property](?note.desc.properties)) {
                val p: *Property = table.at[Property](?note.desc.properties, table.nth[Property](j));
                val r: err[Fail] = take(m, a, out, n, p);
                if (sel r.err) { ret r; }
                j = j + 1;
            }
        }
    }
    ret err[Fail].ok{};
}

# take property `p` of note `n` into `out`
fun take(m: *Elf, a: *Arch, out: *Set, n: usize, p: *Property) err[Fail] {
    val data: Bytes          = model.bytes(m, ?p.data);
    var word: u32            = 0;
    val at:   SearchPosition = position(out, p.type);
    if (data.len == 4) {
        var rd: Reader         = reader.make(nil, data.data, data.len, m.shape.order);
        val w:  res[u32, Fail] = reader.u32(?rd);
        if (sel w.err) { ret err[Fail].err{w.err}; }
        word = w.ok;
    }
    if (sel at.insertion) {
        val put: err[Fail] = table.insert[Merged](?out.merged, at.insertion, Merged{type: p.type, data: data, word: word, note: n});
        if (sel put.err) { ret put; }
        val first: res[table.Id[u32], Fail] = table.push[u32](?out.order, p.type);
        if (sel first.err) { ret err[Fail].err{first.err}; }
        ret err[Fail].ok{};
    }
    val e: *Merged = table.at[Merged](?out.merged, table.nth[Merged](at.found));
    if (e.note == n) { ret err[Fail].err{fail.valued(fail.malformed("a GNU property type is held twice in one note"), p.type::i128)}; }
    e.note = n;
    if (e.data.len == 4 && data.len == 4) {
        val w: res[u32, Fail] = traits.merge_word(a, p.type, e.word, word);
        if (sel w.err) { ret err[Fail].err{w.err}; }
        e.word = w.ok;
        ret err[Fail].ok{};
    }
    if (zero(e.data) && zero(data)) { ret err[Fail].ok{}; }
    ret err[Fail].err{fail.valued(fail.unsupported("GNU property notes state data of a type no trait row maps"), p.type::i128)};
}

fun zero(b: Bytes) bool {
    var i: usize = 0;
    for (i < b.len) {
        if (b.data[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# add to `out` e_flags of `m` and every property of `s` whose data is one
# word, the parts of the file the trait rows read
pub fun words(m: *Elf, s: *Set, out: *Words) err[Fail] {
    out.flags = m.header.flags;
    var i: usize = 0;
    for (i < table.count[Merged](?s.merged)) {
        val p: *Merged = table.at[Merged](?s.merged, table.nth[Merged](i));
        i = i + 1;
        if (p.data.len != 4) { cnt; }
        val added: err[Fail] = traits.add_word(out, Word{type: p.type, value: p.word});
        if (sel added.err) { ret added; }
    }
    ret err[Fail].ok{};
}

val ONE:   [4]u8 = [4]u8{1, 0, 0, 0};
val TWO:   [4]u8 = [4]u8{2, 0, 0, 0};
val THREE: [4]u8 = [4]u8{3, 0, 0, 0};
val SMALL: [8]u8 = [8]u8{0, 0x10, 0, 0, 0, 0, 0, 0};
val LARGE: [8]u8 = [8]u8{0, 0x20, 0, 0, 0, 0, 0, 0};

fun stated(type: *Constant, data: *u8, len: usize) Property {
    ret Property{type: type.value::u32, datasz: len::u32, data: Held.borrowed{Bytes{data: data, len: len}}};
}

# add to `notes` a GNU property note of the `n` properties at `props`
fun add_note(a: *A.Allocator, notes: *Table[Note], props: *Property, n: usize) err[Fail] {
    var t: Table[Property] = table.make[Property](a);
    var i: usize           = 0;
    for (i < n) {
        val p: res[table.Id[Property], Fail] = table.push[Property](?t, props[i]);
        if (sel p.err) {
            val dropped: err[Fail] = table.release[Property](?t);
            ret err[Fail].err{p.err};
        }
        i = i + 1;
    }
    val pushed: res[table.Id[Note], Fail] = table.push[Note](notes, Note{type: tables.NT_GNU_PROPERTY_TYPE_0.value::u32, desc: Desc.properties{t}});
    if (sel pushed.err) {
        val dropped: err[Fail] = table.release[Property](?t);
        ret err[Fail].err{pushed.err};
    }
    ret err[Fail].ok{};
}

# an x86-64 model of one section holding the notes of `first` and `second`
fun two_notes(a: *A.Allocator, first: *Property, nfirst: usize, second: *Property, nsecond: usize) res[Elf, Fail] {
    var m: Elf = model.make(a, Shape{class: ?model.CLASS64, order: reader.LITTLE});
    m.header.machine = tables.EM_X86_64.value::u16;
    var notes: Table[Note] = table.make[Note](a);
    val n1:    err[Fail]   = add_note(a, ?notes, first, nfirst);
    var r:     err[Fail]   = n1;
    if (!sel n1.err) { r = add_note(a, ?notes, second, nsecond); }
    var body: Body = Body.notes{notes};
    if (sel r.err) {
        val dropped: err[Fail] = model.release_body(?body);
        ret res[Elf, Fail].err{r.err};
    }
    val s: res[table.Id[Section], Fail] = table.push[Section](?m.sections, Section{type: tables.SHT_NOTE.value::u32, body: body});
    if (sel s.err) {
        val dropped: err[Fail] = model.release_body(?body);
        ret res[Elf, Fail].err{s.err};
    }
    ret res[Elf, Fail].ok{m};
}

fun word_is(s: *Set, type: *Constant, want: u32) bool {
    val p: opt[*Merged] = find(s, type.value::u32);
    if (sel p.none) { ret false; }
    ret p.some.word == want;
}

test property__two_notes_in_one_section_merge_by_their_rules {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    # the and word keeps the bits both notes set, the used words every bit either sets
    val first: [2]Property = [2]Property{
        stated(?tables.GNU_PROPERTY_X86_FEATURE_1_AND, ?THREE[0], 4),
        stated(?tables.GNU_PROPERTY_X86_ISA_1_USED, ?ONE[0], 4),
    };
    val second: [3]Property = [3]Property{
        stated(?tables.GNU_PROPERTY_X86_FEATURE_1_AND, ?ONE[0], 4),
        stated(?tables.GNU_PROPERTY_X86_FEATURE_2_USED, ?ONE[0], 4),
        stated(?tables.GNU_PROPERTY_X86_ISA_1_USED, ?TWO[0], 4),
    };
    val built: res[Elf, Fail] = two_notes(a, ?first[0], 2, ?second[0], 3);
    if (sel built.err) { ret 1; }
    var m: Elf       = built.ok;
    var s: Set       = make(a);
    val g: err[Fail] = gather(?m, ?arch.X86_64, ?s);
    if (sel g.err)                                                { ret 1; }
    if (table.count[Merged](?s.merged) != 3)                      { ret 1; }
    if (!word_is(?s, ?tables.GNU_PROPERTY_X86_FEATURE_1_AND, 1))  { ret 1; }
    if (!word_is(?s, ?tables.GNU_PROPERTY_X86_ISA_1_USED, 3))     { ret 1; }
    if (!word_is(?s, ?tables.GNU_PROPERTY_X86_FEATURE_2_USED, 1)) { ret 1; }
    val order: *u32 = table.items[u32](?s.order);
    if (table.count[u32](?s.order) != 3)                                                                                                                                                            { ret 1; }
    if (order[0] != tables.GNU_PROPERTY_X86_FEATURE_1_AND.value::u32 || order[1] != tables.GNU_PROPERTY_X86_ISA_1_USED.value::u32 || order[2] != tables.GNU_PROPERTY_X86_FEATURE_2_USED.value::u32) { ret 1; }

    val r1: err[Fail] = release(?s);
    val r2: err[Fail] = model.release(?m);
    if (sel r1.err || sel r2.err) { ret 1; }
    if (T.live_count(?t) != 0)    { ret 1; }
    T.dnit(?t);
    ret 0;
}

test property__notes_disagreeing_on_a_type_with_no_rule_are_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    val first:  [1]Property    = [1]Property{stated(?tables.GNU_PROPERTY_STACK_SIZE, ?SMALL[0], 8)};
    val second: [1]Property    = [1]Property{stated(?tables.GNU_PROPERTY_STACK_SIZE, ?LARGE[0], 8)};
    val built:  res[Elf, Fail] = two_notes(a, ?first[0], 1, ?second[0], 1);
    if (sel built.err) { ret 1; }
    var m: Elf       = built.ok;
    var s: Set       = make(a);
    val g: err[Fail] = gather(?m, ?arch.X86_64, ?s);
    if (sel g.ok)                     { ret 1; }
    if (!sel g.err.cause.unsupported) { ret 1; }
    val v: opt[i128] = g.err.value;
    if (sel v.none)                                           { ret 1; }
    if (v.some != tables.GNU_PROPERTY_STACK_SIZE.value::i128) { ret 1; }

    val r1: err[Fail] = release(?s);
    val r2: err[Fail] = model.release(?m);
    if (sel r1.err || sel r2.err) { ret 1; }
    if (T.live_count(?t) != 0)    { ret 1; }
    T.dnit(?t);
    ret 0;
}
