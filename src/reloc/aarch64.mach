# the AArch64 instruction forms a relocation row chooses its field by
#
# a format whose one code serves several instructions, as a page offset serves
# an add and a load or store of any size and a branch serves a jump and a
# call, reads each instruction as its own neutral kind through one row per
# kind, and these are the instruction bits each row chooses by. a load or
# store of an unsigned offset scales it by its access size: the size bits
# 31:30 of a general register load or store, and of a SIMD one (bit 26) the
# same unless opc bit 23 marks a 128-bit access of size zero. any other SIMD
# form of opc bit 23 is unallocated, so no form holds for it. the fields are
# bit ranges of a 32-bit little endian word.

use std.types.bool.true;
use std.types.size.usize;

use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.row.FieldChoice;

# a scaled offset takes the bits of the page offset above its scale, so the
# field reaches no bit past the page
val P_LO12_1:   [1]Piece = [1]Piece{Piece{at: 10, width: 12}};
val P_LO12_2:   [1]Piece = [1]Piece{Piece{at: 10, width: 11}};
val P_LO12_4:   [1]Piece = [1]Piece{Piece{at: 10, width: 10}};
val P_LO12_8:   [1]Piece = [1]Piece{Piece{at: 10, width: 9}};
val P_LO12_16:  [1]Piece = [1]Piece{Piece{at: 10, width: 8}};
val P_BRANCH26: [1]Piece = [1]Piece{Piece{at: 0, width: 26}};

val F_LO12_1:   Field = Field{bytes: 4, pieces: ?P_LO12_1[0], count: 1, insn: true};
val F_LO12_2:   Field = Field{bytes: 4, pieces: ?P_LO12_2[0], count: 1, shift: 1, insn: true};
val F_LO12_4:   Field = Field{bytes: 4, pieces: ?P_LO12_4[0], count: 1, shift: 2, insn: true};
val F_LO12_8:   Field = Field{bytes: 4, pieces: ?P_LO12_8[0], count: 1, shift: 3, insn: true};
val F_LO12_16:  Field = Field{bytes: 4, pieces: ?P_LO12_16[0], count: 1, shift: 4, insn: true};
val F_BRANCH26: Field = Field{bytes: 4, pieces: ?P_BRANCH26[0], count: 1, shift: 2, insn: true};

# the add immediate, and a general and a SIMD load or store
val ADD_MASK:  u64 = 0x7f80_0000;
val ADD_FORM:  u64 = 0x1100_0000;
val GENERAL:   u64 = 0xff00_0000;
val SIMD:      u64 = 0xff80_0000;
val BRANCH:    u64 = 0xfc00_0000;
val JUMP_FORM: u64 = 0x1400_0000;
val CALL_FORM: u64 = 0x9400_0000;

pub val ADD:   [1]FieldChoice = [1]FieldChoice{FieldChoice{insn_mask: ADD_MASK, insn_value: ADD_FORM, field: ?F_LO12_1}};
pub val LDST8: [2]FieldChoice = [2]FieldChoice{
    FieldChoice{insn_mask: GENERAL, insn_value: 0x3900_0000, field: ?F_LO12_1},
    FieldChoice{insn_mask: SIMD, insn_value: 0x3d00_0000, field: ?F_LO12_1},
};
pub val LDST16: [2]FieldChoice = [2]FieldChoice{
    FieldChoice{insn_mask: GENERAL, insn_value: 0x7900_0000, field: ?F_LO12_2},
    FieldChoice{insn_mask: SIMD, insn_value: 0x7d00_0000, field: ?F_LO12_2},
};
pub val LDST32: [2]FieldChoice = [2]FieldChoice{
    FieldChoice{insn_mask: GENERAL, insn_value: 0xb900_0000, field: ?F_LO12_4},
    FieldChoice{insn_mask: SIMD, insn_value: 0xbd00_0000, field: ?F_LO12_4},
};
pub val LDST64: [2]FieldChoice = [2]FieldChoice{
    FieldChoice{insn_mask: GENERAL, insn_value: 0xf900_0000, field: ?F_LO12_8},
    FieldChoice{insn_mask: SIMD, insn_value: 0xfd00_0000, field: ?F_LO12_8},
};
# a 64-bit load or store or an add, as a format whose slot load an add may
# take the address of in place of the load reads both under one code
pub val LDST64_ADD: [3]FieldChoice = [3]FieldChoice{
    FieldChoice{insn_mask: GENERAL, insn_value: 0xf900_0000, field: ?F_LO12_8},
    FieldChoice{insn_mask: SIMD, insn_value: 0xfd00_0000, field: ?F_LO12_8},
    FieldChoice{insn_mask: ADD_MASK, insn_value: ADD_FORM, field: ?F_LO12_1},
};
pub val LDST128: [1]FieldChoice = [1]FieldChoice{FieldChoice{insn_mask: SIMD, insn_value: 0x3d80_0000, field: ?F_LO12_16}};
# how many forms each load or store size has
pub val LDST_FORMS:       usize = 2;
pub val LDST128_FORMS:    usize = 1;
pub val LDST64_ADD_FORMS: usize = 3;
# a branch of either form, and a plain branch and a branch with link
pub val BRANCH26: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?F_BRANCH26}};
pub val JUMP:     [1]FieldChoice = [1]FieldChoice{FieldChoice{insn_mask: BRANCH, insn_value: JUMP_FORM, field: ?F_BRANCH26}};
pub val CALL:     [1]FieldChoice = [1]FieldChoice{FieldChoice{insn_mask: BRANCH, insn_value: CALL_FORM, field: ?F_BRANCH26}};
