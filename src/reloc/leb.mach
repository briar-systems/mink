# the LEB128 of a symbol's value, the one record of it every format shares
#
# a producer that references a value only the writer or the link knows, such
# as a location view, states a relocation of a LEB128 kind at a site padded to
# the kind's fixed width. no format has a relocation for it, so the sets that
# carry it share these folded rows: a relocatable writer folds the value its
# symbol has once lowering defined it, and the link applies the row through
# the engine like any other once its view phase settled the value. a padded
# site keeps its size whatever the value, so it needs no layout pass.

use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Reloc;
use mink.model.object.Symbol;
use mink.model.reloc;
use mink.reloc.compute;
use mink.reloc.compute.Inputs;
use mink.reloc.engine;
use mink.reloc.engine.Site;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row.Addend;
use mink.reloc.row.FieldChoice;
use mink.reloc.row.Row;
use mink.reloc.row.Write;

val PIECES: [10]Piece = [10]Piece{
    Piece{at: 0, width: 7}, Piece{at: 8, width: 7}, Piece{at: 16, width: 7}, Piece{at: 24, width: 7}, Piece{at: 32, width: 7},
    Piece{at: 40, width: 7}, Piece{at: 48, width: 7}, Piece{at: 56, width: 7}, Piece{at: 64, width: 7}, Piece{at: 72, width: 7},
};

val LEB32: Field = Field{bytes: reloc.LEB32_BYTES, pieces: ?PIECES[0], count: reloc.LEB32_BYTES, padded: true};
val LEB64: Field = Field{bytes: reloc.LEB64_BYTES, pieces: ?PIECES[0], count: reloc.LEB64_BYTES, padded: true};

val LEB32_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?LEB32}};
val LEB64_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?LEB64}};

val U32: Range = Range{check: field.Check.unsigned{}, bits: 32, align: 1};
val U64: Range = Range{check: field.Check.unsigned{}, bits: 64, align: 1};
val S32: Range = Range{check: field.Check.signed{}, bits: 32, align: 1};
val S64: Range = Range{check: field.Check.signed{}, bits: 64, align: 1};

# the folded rows of the LEB128 kinds, which every set that carries them
# names as its shared rows
pub val COUNT: usize      = 4;
pub val ROWS:  [COUNT]Row = [COUNT]Row{
    Row{name: "padded uleb32", kind: ?reloc.ULEB32, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.ABS, range: U32, addend: Addend.record{}, write: Write.folded{}},
    Row{name: "padded uleb64", kind: ?reloc.ULEB64, fields: ?LEB64_FIELD[0], field_count: 1, value: ?compute.ABS, range: U64, addend: Addend.record{}, write: Write.folded{}},
    Row{name: "padded sleb32", kind: ?reloc.SLEB32, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.ABS, range: S32, addend: Addend.record{}, write: Write.folded{}},
    Row{name: "padded sleb64", kind: ?reloc.SLEB64, fields: ?LEB64_FIELD[0], field_count: 1, value: ?compute.ABS, range: S64, addend: Addend.record{}, write: Write.folded{}},
};

# fold the relocation `x` of `o`, whose row `r` the writer folds, into its
# site `s`: the value its symbol has as the object is written plus its
# addend, read modulo an address of `width` bytes as the link reads it. a
# relocation that subtracts a symbol or names none is refused as unsupported,
# as is a symbol with no absolute value, undefined or placed where the link
# lays it out, since no format carries it. a value the field cannot hold is
# refused as an overflow
pub fun fold(r: *Row, o: *Object, x: *Reloc, s: *Site, width: opt[u8]) err[Fail] {
    if (sel x.minus.some)                                                { ret err[Fail].err{fail.about(fail.unsupported("a LEB128 of a symbol's value subtracts no second symbol"), r.name)}; }
    if (!sel x.target.symbol)                                            { ret err[Fail].err{fail.about(fail.unsupported("a LEB128 of a symbol's value names no symbol"), r.name)}; }
    if (x.target.symbol.index::usize >= table.count[Symbol](?o.symbols)) { ret err[Fail].err{fail.malformed("relocation names a symbol the object does not have")}; }
    val y: *Symbol = object.symbol_at(o, x.target.symbol);
    if (!sel y.def.absolute) { ret err[Fail].err{fail.about(fail.unsupported("no format has a relocation for the LEB128 of a symbol with no absolute value when the object is written"), r.name)}; }
    var in: Inputs = Inputs{s: y.def.absolute, a: x.addend, width: width};
    ret engine.apply(r, s, ?in);
}
