# the shape of a relocation field
#
# a field is a container of whole bytes in a byte order and the bit ranges of
# it that hold a value. the value is shifted right by `shift`, rounded first
# when the field holds the upper half of a split, and its bits fill the pieces
# from the least significant up, so a scattered immediate is a list of pieces
# and a padded LEB128 is a piece per byte. a shape is bits only: it names no
# format and no architecture.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;

use mink.bytes.reader;
use mink.bytes.reader.Order;

# the widest container, a padded LEB128 of a 64-bit value
pub val MAX_BYTES: u8 = 16;

# a run of container bits, counted from the container's least significant bit
# ---
# at:    the first bit
# width: how many bits
pub rec Piece {
    at:    u8;
    width: u8;
}

# the sign form of a field, as a move-wide immediate has it: a negative value
# is held complemented and `neg` goes in the opcode bits, any other value is
# held as it is and `pos` goes there
# ---
# at:    the first opcode bit
# width: how many opcode bits
# neg:   the opcode bits of a negative value
# pos:   the opcode bits of any other value
pub rec Sign {
    at:    u8;
    width: u8;
    neg:   u8;
    pos:   u8;
}

# bytes:  the container's width in bytes, zero for a field that holds nothing
# pieces: the bit runs holding the value, least significant first
# count:  how many pieces
# shift:  the low bits of the value the field does not hold
# round:  whether half of the dropped low bits is added first, as the upper
#         half of a split takes it
# split:  for a field that holds a low half and a rounded upper half of one
#         value, as two instructions do, how many low value bits the leading
#         pieces hold as they are. the rest of the value is rounded at that
#         bit first, as the upper half of a split takes it. zero for none
# run:    whether the container is a LEB128 run of at most `bytes`, a piece
#         per byte, whose length is that of the encoding already there
# insn:   whether the field is in an instruction rather than plain data
# sign:   the sign form, none for a field that takes the value as it is
pub rec Field {
    bytes:  u8;
    pieces: *Piece;
    count:  u8;
    shift:  u8;
    round:  bool;
    split:  u8;
    run:    bool;
    insn:   bool;
    sign:   opt[Sign];
}

# how a value is held to the range of its field
# ---
# wrap:     not checked, the field takes the low bits
# signed:   a two's complement value of `bits` bits
# unsigned: an unsigned value of `bits` bits
# either:   signed or unsigned, as a plain data word of either sign is
pub tag Check: u8 {
    wrap;
    signed;
    unsigned;
    either;
}

# the values a field accepts. `bits` counts the value before the shift, and
# `align` is a power of two the value is a multiple of
pub rec Range {
    check: Check;
    bits:  u8;
    align: u64;
}

# how many value bits the pieces hold
pub fun width(f: *Field) u32 {
    var w: u32 = 0;
    var i: u8  = 0;
    for (i < f.count) {
        w = w + f.pieces[i].width::u32;
        i = i + 1;
    }
    ret w;
}

# write `bits` into the pieces of the container at `dst`, keeping every other
# bit. value bits past the 64th are `fill`, zero or one
pub fun put(f: *Field, dst: *u8, order: Order, bits: u64, fill: u8) {
    var j: u32 = 0;
    var i: u8  = 0;
    for (i < f.count) {
        var k: u8 = 0;
        for (k < f.pieces[i].width) {
            var b: u8 = fill;
            if (j < 64) { b = ((bits >> j::u64) & 1)::u8; }
            val c:    u32   = f.pieces[i].at::u32 + k::u32;
            val at:   usize = byte_of(f, order, c);
            val mask: u8    = (1::u8 << (c % 8)::u8);
            if (b != 0) { dst[at] = dst[at] | mask; }
            or          { dst[at] = dst[at] & ~mask; }
            j = j + 1;
            k = k + 1;
        }
        i = i + 1;
    }
}

# write the opcode bits of the sign form of `f` into the container at `dst`
pub fun put_sign(f: *Field, g: Sign, dst: *u8, order: Order, negative: bool) {
    var bits: u64 = g.pos::u64;
    if (negative) { bits = g.neg::u64; }
    val piece: Piece = Piece{at: g.at, width: g.width};
    val shape: Field = Field{bytes: f.bytes, pieces: ?piece, count: 1};
    put(?shape, dst, order, bits, 0);
}

# the opcode bits of the sign form of `f` in the container at `src`
pub fun get_sign(f: *Field, g: Sign, src: *u8, order: Order) u8 {
    val piece: Piece = Piece{at: g.at, width: g.width};
    val shape: Field = Field{bytes: f.bytes, pieces: ?piece, count: 1};
    ret get(?shape, src, order)::u8;
}

# the value bits the pieces of the container at `src` hold, the first 64
pub fun get(f: *Field, src: *u8, order: Order) u64 {
    var v: u64 = 0;
    var j: u32 = 0;
    var i: u8  = 0;
    for (i < f.count) {
        var k: u8 = 0;
        for (k < f.pieces[i].width) {
            val c: u32 = f.pieces[i].at::u32 + k::u32;
            val b: u8  = (src[byte_of(f, order, c)] >> (c % 8)::u8) & 1;
            if (j < 64 && b != 0) { v = v | (1::u64 << j::u64); }
            j = j + 1;
            k = k + 1;
        }
        i = i + 1;
    }
    ret v;
}

# the byte of the container holding container bit `c`
fun byte_of(f: *Field, order: Order, c: u32) usize {
    val n: usize = (c / 8)::usize;
    if (order == reader.LITTLE) { ret n; }
    ret f.bytes::usize - 1 - n;
}
