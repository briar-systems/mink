# the one row shape of every relocation table
#
# a row joins two halves. the format half is a format's relocation key, the
# code or the code with the record's other fields as the pair composes it, its
# name and the neutral kind it maps to. the architecture half is how that kind
# is applied to bytes: the field shapes, chosen by the instruction at the
# place, the value computation, the range, the bias the format adds, the
# partner it needs, where its addend lives and the rewrites that may replace
# it. the shape names no format and no architecture, and nothing branches on
# which a row belongs to. a row maps its key and its kind in a direction: each
# key of the pair reads as exactly one kind for each instruction at its place,
# and each kind is written by exactly one row, so a kind several keys read is
# written by one of them and a key several kinds are written as reads back as
# one of them, each written kind keeping its own range. a key several rows
# read is told apart by the instruction alone, as a format whose one code
# takes its access size from the instruction reads the kind of that size, so
# the rows of a key choose their fields by disjoint instruction bits. a set is the rows of one (format, architecture)
# pair, naming the pair by its catalog rows as data, the kinds its rows map
# to, the difference rows saying which two of its records write the
# difference of two symbols, and the vendor sets a vendor symbol selects. the
# registry's generator checks every row, kind, difference and rewrite of a
# set in one walk and writes its lookup, and a registry holds the lookups.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.rule;
use mink.base.rule.Axis;
use mink.base.table;
use mink.base.vectors;
use mink.catalog.arch.Arch;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.compute.Computation;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;

# keys a row names, as a partner's or an addend record's
# ---
# keys:  the keys, static
# count: how many
pub rec Keys {
    keys:  *u32;
    count: usize;
}

# where the addend lives
# ---
# field:   in the bytes the relocation patches, in the field the value is
#          written to, as REL records keep it
# record:  in the relocation record, as RELA records keep it
# partner: in the record of a partner of one of these keys, as a Mach-O
#          ARM64_RELOC_ADDEND record holds the addend of the record it heads
# held:    in the bytes the relocation patches, in a field of its own shape
#          read as a signed byte count, as a COFF ARM64 PAGEBASE_REL21 keeps
#          its addend unscaled where the value written is a page delta
# none:    nowhere, the relocation has no addend
pub tag Addend: u8 {
    field;
    record;
    partner: Keys;
    held:    *Field;
    none;
}

# where a row's partner is found
# ---
# label:    at the place the row's target labels, as a split low half finds
#           the upper half it completes
# next:     the record after, at the same place
# previous: the record before, at the same place
pub tag Link: u8 {
    label;
    next;
    previous;
}

# what a partner is to the row that needs it
# ---
# addend:  it carries the row's addend
# minus:   it is subtracted, and the row writes its own value less the
#          partner's, the one difference the two records state
# plus:    it writes the difference the row's value is subtracted from, so the
#          row writes nothing of its own
# hi_part: it is the upper half whose value the row's low half completes
pub tag Role: u8 {
    addend;
    minus;
    plus;
    hi_part;
}

# a partner the row needs
# ---
# link:  where the partner is found
# keys:  the keys a partner may have
# count: how many keys
# role:  what the partner is to the row
pub rec PairRule {
    link:  Link;
    keys:  *u32;
    count: usize;
    role:  Role;
}

# one field a row writes, chosen when the instruction at the place holds
# `insn_value` in the bits of `insn_mask`. a row's choices are disjoint and
# share their container, so at most one holds for any instruction, and a lone
# choice of mask zero holds for every one
# ---
# insn_mask:  the instruction bits the choice reads, in the container's order
# insn_value: the value they hold
# field:      the field written
# align:      the alignment a value written through this choice must keep
#             besides the row's, as a scaled load or store writes only
#             offsets of its access size, zero for the row's alone
pub rec FieldChoice {
    insn_mask:  u64;
    insn_value: u64;
    field:      *Field;
    align:      u64;
}

# what must hold for a rewrite to apply. a candidate that states a range is
# chosen by the value its rewritten form computes, the rest by facts known
# before layout and by the bytes at the place
# ---
# target:      over the target's binding, the capabilities the dynamic
#              linking model states of it
# output:      over the output kind's capabilities
# arch:        over the architecture's capabilities, as an encoding one
#              width of an instruction set gives another instruction
# range:       the values the rewritten form computes from the last
#              layout pass, a multiple of its alignment held as it is or,
#              for an address computation, modulo the address width, none
#              for any
# traits:      the trait settings the link's merged traits must hold, static
# trait_count: how many
# own:         the trait settings the input holding the relocation must
#              hold, an axis it leaves unstated holding its absent value, as
#              its own code is what the form rewrites, static
# own_count:   how many
# shape:       the instruction bytes at the place, every pattern holding,
#              static, nil for a form any instruction takes
# shape_count: how many patterns
# equal:       the runs of instruction bits that must hold the same bits,
#              as two instructions naming one register, static, nil for none
# equal_count: how many
# partners:    the records the rewrite consumes, the records after the row's
#              own, one per record of the rewrite's span, static, nil when it
#              consumes none
# addend:      the addend the row's record must state, none for any
# uniform:     the form is taken for no record of a target in a section where
#              some record of a row stating uniform forms names that target
#              and may take none of them by every fact but the target's
#              binding, its records, bytes and constant-time ranges included,
#              or a record of a kind such a form consumes names it
#              unconsumed, so a symbol's GOT loads in a section relax all or
#              none. the binding is the symbol's in every record, so
#              rows coupled through their uniform forms state them over the
#              same target axes, as a descriptor call becomes a nop only
#              where its lea takes a transition. a uniform form that must
#              apply where such a record bars it is refused
pub rec Condition {
    target:      Axis;
    output:      Axis;
    arch:        Axis;
    range:       opt[Range];
    traits:      *os.When;
    trait_count: usize;
    own:         *os.When;
    own_count:   usize;
    shape:       *InsnPattern;
    shape_count: usize;
    equal:       *Equal;
    equal_count: usize;
    partners:    *Partner;
    addend:      opt[i64];
    uniform:     bool;
}

# a record a rewrite consumes past the row's own
# ---
# kind: the kind it must have
# at:   how far past the row's place its place lies, before it when negative
# same: it names the row's target and states the row's addend, as the two
#       halves of one address do
pub rec Partner {
    kind: *Kind;
    at:   i8;
    same: bool;
}

# two runs of `width` instruction bits that must be equal: from bit `shift`
# of the `len` byte word `at` past the place, and from bit `other_shift` of
# the `len` byte word `other` past it, before it when negative
pub rec Equal {
    at:          i8;
    shift:       u8;
    other:       i8;
    other_shift: u8;
    len:         u8;
    width:       u8;
}

# the condition of a form whose condition is not stated yet, which no record
# meets, so the form is never taken
pub val INERT: Condition = Condition{target: rule.NEVER};

# instruction bytes a rewrite matches, the `len` byte word from `at` past the
# place, before it when negative, holding `value` in the bits of `mask`
pub rec InsnPattern {
    at:    i8;
    mask:  u64;
    value: u64;
    len:   u8;
}

# bytes a rewrite writes, `len` bytes of `data` from `at` past the place,
# before it when negative, none when `len` is zero
pub rec Bytes {
    at:   i8;
    data: *u8;
    len:  u8;
}

# instruction bits a rewrite carries from the bytes at the place into the
# bytes it writes, as a register field the rewritten form keeps
# ---
# from:  where the source word starts past the place, before it when negative
# into:  where the destination word starts in the written bytes
# len:   the bytes of both words, read in the architecture's order
# shift: the first source bit
# to:    the first destination bit
# width: how many bits
pub rec Copy {
    from:  i8;
    into:  u8;
    len:   u8;
    shift: u8;
    to:    u8;
    width: u8;
}

# bytes a rewrite deletes, `len` from `at` past the place, before it when
# negative
pub rec Delete {
    at:  i8;
    len: u8;
}

# padding a record states by its addend, the bytes of filler from the place
# that bring what follows to an alignment: the least power of two at or above
# the addend plus `unit`. the rewrite keeps the filler the place's address needs,
# writing it with `fills`, the widest that fits first, and deletes the rest,
# so every byte after it is aligned again
# ---
# unit:       the least instruction size, which the alignment exceeds the
#             addend by at least
# fills:      the filler instructions, widest first, static
# fill_count: how many
pub rec Pad {
    unit:       u8;
    fills:      *Bytes;
    fill_count: usize;
}

# what a rewrite removes from the bytes at the place
# ---
# none:  nothing, its form is as long as the one it rewrites
# bytes: a fixed run, so the code after moves back by its length
# pad:   the part of a padding the place's address does not need
pub tag Removal: u8 {
    none;
    bytes: Delete;
    pad:   Pad;
}

# what a rewrite does to the bytes at the place: writes its template, the
# copied bits carried in, and removes what it removes, and its record now
# patches `moves` bytes past where it did, before it when negative, as a
# rewritten form whose field starts earlier, and computes with `addend` more
# than the addend it states, as an absolute form takes the target alone where
# the place-relative form it rewrites counted from the end of its field
# ---
# bytes:      the template written, none when its length is zero
# copies:     the bits carried into the template, static
# copy_count: how many
# removal:    what it removes
# moves:      how far its record's place moves
# addend:     how much its record's addend grows
pub rec Emit {
    bytes:      Bytes;
    copies:     *Copy;
    copy_count: usize;
    removal:    Removal;
    moves:      i8;
    addend:     i64;
}

# a form a relocation may be rewritten to, as relaxation, a thread-local
# model transition or a form choice rewrites it. of a row's forms whose
# conditions hold, the one that removes the most bytes is taken, of those
# that remove as many the one of the highest rank, and no two forms of a row
# that can both hold remove the same bytes at the same rank
# ---
# name:       its spelling in a diagnostic
# when:       what must hold for it to apply
# span:       how many partner records after the row's own it consumes
# emit:       what it does to the bytes
# kinds:      the kinds the records it consumes become, the row's first
# kind_count: how many, one more than the span
# keeps_ct:   whether the rewritten form keeps the constant-time class of
#             the code it rewrites. one that does not is never applied
#             inside a constant-time range
# must:       whether the form is part of the computation rather than an
#             optimization, as an operand with no base register takes a
#             computation of its own. a form that must apply and may not
#             inside a constant-time range is refused
# rank:       orders the forms that remove as many bytes, as one that turns
#             two dependent instructions into one is taken over one that
#             keeps both
# required:   whether its target, output and traits alone select the form,
#             as a thread-local transition is selected by the binding, which
#             then expects the instruction it rewrites. a record they select
#             it for whose records and bytes meet no form of the row so
#             selected is refused
pub rec Rewrite {
    name:       str;
    when:       Condition;
    span:       u8;
    emit:       Emit;
    kinds:      **Kind;
    kind_count: usize;
    keeps_ct:   bool;
    must:       bool;
    rank:       u8;
    required:   bool;
}

# how the writer takes a row for its kind
# ---
# always:   the row writes its kind, the one row of the kind the writer takes
# never:    the row only reads, as another row writes its kind
# placed:   the row only reads, and the writer takes it in place of the row
#           that writes its kind for a record that names its target's section
#           when its reach counts the target from nearer the target's symbol,
#           as a field that counts from the end of a longer instruction does
# resolved: the row writes its kind and reads no key: the writer computes its
#           value from the file's own layout into the field and writes no
#           record, as a Mach-O object holds the place-relative pointers of
#           its __eh_frame, which the linker finds by parsing the table. it
#           is one of its set's writing rows
# started:  the row writes its kind, the offset of the target within its
#           output section, and reads no key: the writer writes the set's
#           difference of the row's width, the target added and the symbol
#           the format's link binds to the start of the output section that
#           holds the target subtracted, so the link takes that offset from
#           the two records, as a Mach-O object states a section offset. a
#           difference adds a symbol, never a section, so its record names
#           its target by a symbol. it is one of its set's writing rows
pub tag Write: u8 {
    always;
    never;
    placed;
    resolved;
    started;
}

# how a record of a row names its target
# ---
# either: by a symbol, or by the section the target lies in with the
#         target's place carried in the field, as the writer finds
# atom:   by the symbol of the atom that holds the target, with the distance
#         from that symbol as the addend, where one precedes the target, by
#         the target's section otherwise, as llvm writes an x86_64 Mach-O
#         branch
# symbol: by a symbol only. a target the format writes as its section is
#         named by the symbol of the atom that holds it, with the distance
#         from that symbol as the addend, as a Mach-O linker resolves an
#         arm64 page reference only through the atom it names
# exact:  by a symbol at exactly the target, as a slot load names the slot of
#         that symbol and carries no distance past it
pub tag Names: u8 {
    either;
    atom;
    symbol;
    exact;
}

# key:           the format's relocation key, as the pair composes it from the
#                record
# name:          the format's name for the key
# kind:          the neutral kind the row maps the key to
# fields:        the fields the value may be written to, static
# field_count:   how many
# value:         the computation giving the value
# range:         the values the field accepts
# addend:        where the addend lives
# bias:          how far the format's count of the addend lies from the
#                place, as a code that counts from past its field holds the
#                neutral addend less this. the engine adds it to the addend it
#                reads and takes it from the addend it writes
# trail:         how many bytes of the instruction follow the point the
#                addend counts from, past which the format counts the target
#                of a record that names its target's section. zero for a
#                format that counts both from one point
# pair:          the partner the row needs, none when it stands alone
# rewrites:      the forms it may be rewritten to, static
# rewrite_count: how many
# write:         whether and when the writer takes the row for its kind
# names:         how its record names its target
pub rec Row {
    key:           u32;
    name:          str;
    kind:          *Kind;
    fields:        *FieldChoice;
    field_count:   usize;
    value:         *Computation;
    range:         Range;
    addend:        Addend;
    bias:          i64;
    trail:         u8;
    pair:          opt[PairRule];
    rewrites:      **Rewrite;
    rewrite_count: usize;
    write:         Write;
    names:         Names;
}

# how a set writes a difference, the target's value less a second symbol's,
# as two records at one place, as a linker that moves code recomputes it
# ---
# kind:        the neutral difference kind
# plus:        the key of the record that adds the target and the addend
# minus:       the key of the record that subtracts the second symbol
# minus_first: whether the subtracting record is written first
pub rec Difference {
    kind:        *Kind;
    plus:        u32;
    minus:       u32;
    minus_first: bool;
}

# the rows a vendor symbol selects for the codes the format leaves to vendors
# ---
# symbol: the vendor's symbol name, as a vendor record names it
# set:    the vendor's rows
pub rec Vendor {
    symbol: str;
    set:    *Set;
}

# a neutral kind a pair has no form for, and why
# ---
# kind:   the neutral kind
# why:    what the pair lacks
# source: the document that defines the pair's relocations without it
pub rec Refusal {
    kind:   *Kind;
    why:    str;
    source: str;
}

# the rows of one (format, architecture) pair
# ---
# format:           the format whose keys the rows carry
# arch:             the architecture whose bytes the rows patch
# rows:             the rows that read, each reading its key as its kind, a
#                   key read by one row or by rows its instruction tells
#                   apart, static
# count:            how many rows
# kinds:            the kinds the rows map to, static
# kind_count:       how many kinds
# differences:      the difference rows, static, nil when the set has none
# difference_count: how many difference rows
# vendors:          the vendor sets, static, nil when the set has none
# vendor_count:     how many vendor sets
# refusals:         the neutral kinds the pair has no form for, static, nil
#                   when it maps every one
# refusal_count:    how many refusals
# writes:           the rows that write a kind under a key a row of `rows`
#                   reads as another kind, and the rows that resolve a kind
#                   in place, static, nil when the set has none
# write_count:      how many
pub rec Set {
    format:           *Format;
    arch:             *Arch;
    rows:             *Row;
    count:            usize;
    kinds:            **Kind;
    kind_count:       usize;
    differences:      *Difference;
    difference_count: usize;
    vendors:          *Vendor;
    vendor_count:     usize;
    refusals:         *Refusal;
    refusal_count:    usize;
    writes:           *Row;
    write_count:      usize;
}

# a difference row with the two rows it writes
# ---
# difference: the row
# plus:       the row of the record that adds the target
# minus:      the row of the record that subtracts the second symbol
# bits:       how many bits the difference is written in, both rows' width
pub rec Pairing {
    difference: *Difference;
    plus:       *Row;
    minus:      *Row;
    bits:       u32;
}

# a difference row and the two rows it writes, by their positions in its set
# ---
# difference: the difference row's position among the set's differences
# plus:       the position among the set's rows of the row that adds
# minus:      the position among the set's rows of the row that subtracts
# bits:       how many bits the difference is written in
pub rec Paired {
    difference: u32;
    plus:       u32;
    minus:      u32;
    bits:       u32;
}

# a set with its rows indexed by key and by kind, as the registry's
# generator writes it once its check of the set holds, so a lookup is static
# and nothing is indexed or checked when mink runs. a position names a row of
# the set: one below the set's count a row of its rows, and one at or past it
# the writing row that far past the count
# ---
# set:          the set
# keys:         the positions of the rows that read, ascending by key, then
#               by the instruction bits of their first field choice
# key_count:    how many, the set's count
# kinds:        the positions of the rows that write, ascending by the name
#               of their kind
# kind_count:   how many
# placed:       the positions of the rows the writer takes to place a
#               target, ascending by the name of their kind, then by reach
# placed_count: how many
# paired:       its difference rows with the rows they write, ascending by
#               width
# paired_kinds: positions in paired, ascending by the name of the kind
# paired_count: how many, the set's difference count
pub rec Lookup {
    set:          *Set;
    keys:         *u32;
    key_count:    usize;
    kinds:        *u32;
    kind_count:   usize;
    placed:       *u32;
    placed_count: usize;
    paired:       *Paired;
    paired_kinds: *u32;
    paired_count: usize;
}

# the row at the position `p` of `l`'s set
pub fun row_at(l: *Lookup, p: u32) *Row {
    val s: *Set = l.set;
    if (p::usize < s.count) { ret ?s.rows[p::usize]; }
    ret ?s.writes[p::usize - s.count];
}

# the reading row at `i` of `l`'s key order
fun keyed(l: *Lookup, i: usize) *Row {
    ret ?l.set.rows[l.keys[i]::usize];
}

# the position in `l`'s key order of the first row that reads `key`, none
# when no row does
fun first_of(l: *Lookup, key: u32) opt[usize] {
    val n:  usize = l.key_count;
    var lo: usize = 0;
    var hi: usize = n;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (keyed(l, mid).key < key) { lo = mid + 1; }
        or                           { hi = mid; }
    }
    if (lo == n || keyed(l, lo).key != key) { ret opt[usize].none{}; }
    ret opt[usize].some{lo};
}

# whether several rows read `key`, so the instruction at the place chooses
pub fun instruction_chooses(l: *Lookup, key: u32) bool {
    val at: opt[usize] = first_of(l, key);
    if (sel at.none) { ret false; }
    val next: usize = at.some + 1;
    ret next < l.key_count && keyed(l, next).key == key;
}

# the row that reads `key`, refused when the instruction at the place
# chooses among several
pub fun by_key(l: *Lookup, key: u32) res[*Row, Fail] {
    val at: opt[usize] = first_of(l, key);
    if (sel at.none)                 { ret res[*Row, Fail].err{fail.unsupported("no relocation row has this code")}; }
    if (instruction_chooses(l, key)) { ret res[*Row, Fail].err{fail.unsupported("the instruction at the place chooses the relocation row of this code")}; }
    ret res[*Row, Fail].ok{keyed(l, at.some)};
}

# the row that reads `key` for the instruction bits `insn` at its place: the
# key's one row, or of its several the one with a field choice that holds
pub fun reading(l: *Lookup, key: u32, insn: u64) res[*Row, Fail] {
    val at: opt[usize] = first_of(l, key);
    if (sel at.none)                  { ret res[*Row, Fail].err{fail.unsupported("no relocation row has this code")}; }
    if (!instruction_chooses(l, key)) { ret res[*Row, Fail].ok{keyed(l, at.some)}; }
    var i: usize = at.some;
    for (i < l.key_count && keyed(l, i).key == key) {
        val r: *Row  = keyed(l, i);
        var c: usize = 0;
        for (c < r.field_count) {
            if (chosen(?r.fields[c], insn)) { ret res[*Row, Fail].ok{r}; }
            c = c + 1;
        }
        i = i + 1;
    }
    ret res[*Row, Fail].err{fail.malformed("no relocation row of this code reads the instruction at its place")};
}

# a row that reads `key`, whose name and container every row of the key
# shares, as a dump names the key by
pub fun any_of(l: *Lookup, key: u32) res[*Row, Fail] {
    val at: opt[usize] = first_of(l, key);
    if (sel at.none) { ret res[*Row, Fail].err{fail.unsupported("no relocation row has this code")}; }
    ret res[*Row, Fail].ok{keyed(l, at.some)};
}

# the position in the `n` positions at `order`, ascending by the name of
# their rows' kind, of the first whose kind's name is not below `k`'s
fun kind_bound(l: *Lookup, order: *u32, n: usize, k: *Kind) usize {
    var lo: usize = 0;
    var hi: usize = n;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (str_compare(row_at(l, order[mid]).kind.name, k.name) < 0) { lo = mid + 1; }
        or                                                            { hi = mid; }
    }
    ret lo;
}

# the row that writes `k`
pub fun by_kind(l: *Lookup, k: *Kind) res[*Row, Fail] {
    val at: usize = kind_bound(l, l.kinds, l.kind_count, k);
    if (at < l.kind_count) {
        val r: *Row = row_at(l, l.kinds[at]);
        if (r.kind == k) { ret res[*Row, Fail].ok{r}; }
    }
    ret res[*Row, Fail].err{fail.unsupported("no relocation row has this kind")};
}

# the failure of a converter that finds no row for `k`: the refusal of the
# pair when it states one, a defect of mink when `k` is a neutral kind the set
# neither maps nor refuses, and `found` otherwise
pub fun absent(l: *Lookup, k: *Kind, found: Fail) Fail {
    var i: usize = 0;
    for (i < l.set.refusal_count) {
        val f: *Refusal = ?l.set.refusals[i];
        if (f.kind == k) { ret fail.cited(fail.about(fail.unsupported(f.why), k.name), f.source); }
        i = i + 1;
    }
    val own:     res[*Row, Fail]    = by_kind(l, k);
    val pairing: res[Pairing, Fail] = difference_of(l, k);
    if (reloc.neutral_for(l.set.arch, k) && sel own.err && sel pairing.err) { ret fail.about(fail.internal("neutral relocation kind is neither mapped nor refused"), k.name); }
    ret fail.about(found, k.name);
}

# the row of the record of `k` a converter writes, as `targeting` with no
# difference
pub fun writing(l: *Lookup, k: *Kind) res[*Row, Fail] {
    val r: res[*Row, Fail] = by_kind(l, k);
    if (sel r.err) { ret res[*Row, Fail].err{absent(l, k, r.err)}; }
    ret r;
}

# how far from the place a field of `r` counts the target of a record that
# names its target's section: the row's bias less the instruction bytes that
# trail the point it counts its addend from
pub fun reach(r: *Row) i64 {
    ret r.bias - r.trail::i64;
}

# the row the writer takes for a record of the kind `r` writes that names its
# target's section and holds the neutral addend `a`: of `r` and the rows that
# place its kind, the one that counts the target from nearest its symbol,
# the greatest reach not above `a` when one is, which counts it from at or
# after the symbol, and the least reach when every one lies above `a`
pub fun placing(l: *Lookup, r: *Row, a: i64) *Row {
    var chosen: *Row = nil;
    var least:  *Row = r;
    if (reach(r) <= a) { chosen = r; }
    var at: usize = kind_bound(l, l.placed, l.placed_count, r.kind);
    for (at < l.placed_count && row_at(l, l.placed[at]).kind == r.kind) {
        val q: *Row = row_at(l, l.placed[at]);
        if (reach(q) <= a && (chosen == nil || reach(q) > reach(chosen))) { chosen = q; }
        if (reach(q) < reach(least))                                      { least = q; }
        at = at + 1;
    }
    if (chosen == nil) { ret least; }
    ret chosen;
}

# the container bytes every field of `r` shares
pub fun container(r: *Row) u8 {
    ret r.fields[0].field.bytes;
}

# whether the choice `c` holds for the instruction bits `insn`
pub fun chosen(c: *FieldChoice, insn: u64) bool {
    ret (insn & c.insn_mask) == c.insn_value;
}

# the pairing `p` of `l` names
fun pairing_of(l: *Lookup, p: *Paired) Pairing {
    ret Pairing{difference: ?l.set.differences[p.difference::usize], plus: ?l.set.rows[p.plus::usize], minus: ?l.set.rows[p.minus::usize], bits: p.bits};
}

# the pairing of the difference kind `k`
pub fun difference_of(l: *Lookup, k: *Kind) res[Pairing, Fail] {
    var lo: usize = 0;
    var hi: usize = l.paired_count;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val d:   *Kind = l.set.differences[l.paired[l.paired_kinds[mid]::usize].difference::usize].kind;
        if (str_compare(d.name, k.name) < 0) { lo = mid + 1; }
        or                                   { hi = mid; }
    }
    if (lo < l.paired_count) {
        val p: *Paired = ?l.paired[l.paired_kinds[lo]::usize];
        if (l.set.differences[p.difference::usize].kind == k) { ret res[Pairing, Fail].ok{pairing_of(l, p)}; }
    }
    ret res[Pairing, Fail].err{fail.unsupported("the relocation set writes no difference of this kind")};
}

# the pairing written in exactly `bits` bits, none when the set has none
pub fun difference_in(l: *Lookup, bits: u32) opt[Pairing] {
    var lo: usize = 0;
    var hi: usize = l.paired_count;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (l.paired[mid].bits < bits) { lo = mid + 1; }
        or                             { hi = mid; }
    }
    if (lo < l.paired_count && l.paired[lo].bits == bits) { ret opt[Pairing].some{pairing_of(l, ?l.paired[lo])}; }
    ret opt[Pairing].none{};
}

# whether `r` is the row a difference of `l` subtracts with
pub fun subtracts(l: *Lookup, r: *Row) bool {
    var i: usize = 0;
    for (i < l.paired_count) {
        if (?l.set.rows[l.paired[i].minus::usize] == r) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the row of the record of a relocation of kind `k` that names its target:
# the kind's own, or when the relocation names a second symbol the adding row
# of the kind's difference
pub fun targeting(l: *Lookup, k: *Kind, difference: bool) res[*Row, Fail] {
    if (!difference) { ret writing(l, k); }
    val p: res[Pairing, Fail] = difference_of(l, k);
    if (sel p.err) { ret res[*Row, Fail].err{absent(l, k, p.err)}; }
    ret res[*Row, Fail].ok{p.ok.plus};
}

# the order of the rows that read: ascending by key, then by the
# instruction bits of their first field choice
pub fun reading_order(a: *Row, b: *Row) i64 {
    if (a.key < b.key) { ret -1; }
    if (a.key > b.key) { ret 1; }
    val x: *FieldChoice = ?a.fields[0];
    val y: *FieldChoice = ?b.fields[0];
    if (x.insn_mask < y.insn_mask)   { ret -1; }
    if (x.insn_mask > y.insn_mask)   { ret 1; }
    if (x.insn_value < y.insn_value) { ret -1; }
    if (x.insn_value > y.insn_value) { ret 1; }
    ret 0;
}

# the order of the rows that write: ascending by the name of their kind
pub fun kind_order(a: *Row, b: *Row) i64 {
    ret str_compare(a.kind.name, b.kind.name);
}

# the order of the rows that place a target: ascending by the name of their
# kind, then by reach
pub fun placed_order(a: *Row, b: *Row) i64 {
    val k: i64 = kind_order(a, b);
    if (k != 0)              { ret k; }
    if (reach(a) < reach(b)) { ret -1; }
    if (reach(a) > reach(b)) { ret 1; }
    ret 0;
}

# whether the row `r` writes its kind, so the kinds order holds it
pub fun writes_kind(r: *Row) bool {
    ret sel r.write.always || sel r.write.resolved || sel r.write.started;
}

# whether the row `r` places a target, so the placed order holds it
pub fun places(r: *Row) bool {
    ret sel r.write.placed;
}

# check the lookup `l` its generator built, refused with a defect of mink: a
# field wider than its container, pieces that overlap, a range the field
# cannot hold, field choices that differ in container or can both hold, a
# choice alignment that is no power of two, a held addend field that is
# missing, unsound or in another container, a partner, addend record or
# rewritten kind with no row, a key two reading rows share, a kind two rows
# write, a kind the set does not list, a listed kind that is unsound, shares
# a name or no row writes, a reading row resolved in place or written from
# its section's start, a row written so that writes no section offset or has
# no difference of its width, a row that writes no record or only places a
# target named as its section and names its target by a symbol only, a
# writing row that only reads or whose key reads back as no row, as its own
# kind or from another container, addend or reach, a placing row whose addend
# is not in its field or whose reach its kind's writing row or another
# placing row shares, a rewrite whose kinds do not number its span, whose
# partners or rewritten kinds have no row, whose patterns, copies or filler
# are malformed, that writes what it deletes, or that shares its row with a
# form that can hold alongside it and removes the same bytes, and a
# difference row whose records have no rows, differ in width or are of a kind
# that is no difference, or whose kind or width another one shares. only the
# registry's generator checks a set, as mink runs on the lookups it wrote
pub fun check(a: *A.Allocator, l: *Lookup) err[Fail] {
    val s: *Set  = l.set;
    var i: usize = 0;
    for (i < s.count) {
        if (sel s.rows[i].write.resolved)                              { ret err[Fail].err{fail.in_indexed(fail.internal("relocation row resolved in place reads no key"), "relocation row", i::u64)}; }
        if (sel s.rows[i].write.started)                               { ret err[Fail].err{fail.in_indexed(fail.internal("relocation row written from its section's start reads no key"), "relocation row", i::u64)}; }
        if (sel s.rows[i].write.placed && !sel s.rows[i].names.either) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation row that places a target named as its section names its target by a symbol only"), "relocation row", i::u64)}; }
        val e: err[Fail] = sound(?s.rows[i]);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "relocation row", i::u64)}; }
        i = i + 1;
    }
    i = 0;
    for (i < s.write_count) {
        val w: *Row = ?s.writes[i];
        if (sel w.write.never)                           { ret err[Fail].err{fail.in_indexed(fail.internal("relocation writing row only reads"), "relocation writing row", i::u64)}; }
        if (sel w.write.resolved && !sel w.names.either) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation row resolved in place writes no record to name a symbol"), "relocation writing row", i::u64)}; }
        val e: err[Fail] = sound(w);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "relocation writing row", i::u64)}; }
        i = i + 1;
    }
    i = 1;
    for (i < l.key_count) {
        if (reading_order(keyed(l, i - 1), keyed(l, i)) == 0) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation code has two reading rows"), "relocation row", l.keys[i]::u64)}; }
        i = i + 1;
    }
    val sg: err[Fail] = grouped(l);
    if (sel sg.err) { ret sg; }
    i = 1;
    for (i < l.kind_count) {
        val r: *Row = row_at(l, l.kinds[i]);
        if (kind_order(row_at(l, l.kinds[i - 1]), r) == 0) { ret err[Fail].err{fail.about(fail.internal("relocation kind has two writing rows"), r.kind.name)}; }
        i = i + 1;
    }
    i = 1;
    for (i < l.placed_count) {
        val r: *Row = row_at(l, l.placed[i]);
        if (placed_order(row_at(l, l.placed[i - 1]), r) == 0) { ret err[Fail].err{fail.about(fail.internal("two relocation rows place one kind from one reach"), r.name)}; }
        i = i + 1;
    }
    i = 0;
    for (i < s.count) {
        val e: err[Fail] = links(l, ?s.rows[i]);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "relocation row", i::u64)}; }
        i = i + 1;
    }
    i = 0;
    for (i < s.write_count) {
        val w: *Row = ?s.writes[i];
        i = i + 1;
        val e: err[Fail] = links(l, w);
        if (sel e.err)                                   { ret err[Fail].err{fail.in_indexed(e.err, "relocation writing row", (i - 1)::u64)}; }
        if (sel w.write.resolved || sel w.write.started) { cnt; }
        val b: err[Fail] = reads_back(l, w);
        if (sel b.err) { ret err[Fail].err{fail.in_indexed(b.err, "relocation writing row", (i - 1)::u64)}; }
    }
    val k: err[Fail] = listed(a, l);
    if (sel k.err) { ret k; }
    val p: err[Fail] = differences(l);
    if (sel p.err) { ret p; }
    ret started(l);
}

# the row `r` is sound, and a row that places a target holds its addend in
# its field
fun sound(r: *Row) err[Fail] {
    val e: err[Fail] = shapes(r);
    if (sel e.err)                                 { ret e; }
    if (sel r.write.placed && !sel r.addend.field) { ret err[Fail].err{fail.internal("relocation row places a target its field holds no addend for")}; }
    ret err[Fail].ok{};
}

# every difference row is of a kind that names a second symbol and writes
# with two records of rows of one width, and no two share a width or a kind
fun differences(l: *Lookup) err[Fail] {
    var i: usize = 0;
    for (i < l.paired_count) {
        val p: Pairing     = pairing_of(l, ?l.paired[i]);
        val d: *Difference = p.difference;
        if (!reloc.has(d.kind, reloc.DIFF | reloc.PAIR)) { ret err[Fail].err{fail.in_indexed(fail.internal("difference row is of a kind that names no second symbol"), "difference row", l.paired[i].difference::u64)}; }
        val plus: res[*Row, Fail] = by_key(l, d.plus);
        if (sel plus.err)      { ret err[Fail].err{fail.in_indexed(fail.internal("difference row adds with a record that has no row"), "difference row", l.paired[i].difference::u64)}; }
        if (plus.ok != p.plus) { ret err[Fail].err{fail.in_indexed(fail.internal("difference row adds with a record that has no row"), "difference row", l.paired[i].difference::u64)}; }
        val minus: res[*Row, Fail] = by_key(l, d.minus);
        if (sel minus.err)       { ret err[Fail].err{fail.in_indexed(fail.internal("difference row subtracts with a record that has no row"), "difference row", l.paired[i].difference::u64)}; }
        if (minus.ok != p.minus) { ret err[Fail].err{fail.in_indexed(fail.internal("difference row subtracts with a record that has no row"), "difference row", l.paired[i].difference::u64)}; }
        val bits: u32 = field.width(p.plus.fields[0].field);
        if (bits == 0 || bits != p.bits || field.width(p.minus.fields[0].field) != bits) { ret err[Fail].err{fail.in_indexed(fail.internal("difference row's records differ in width"), "difference row", l.paired[i].difference::u64)}; }
        if (i > 0 && l.paired[i - 1].bits == p.bits)                                     { ret err[Fail].err{fail.in_record(fail.internal("two difference rows share a width"), "difference row")}; }
        i = i + 1;
    }
    i = 1;
    for (i < l.paired_count) {
        val x: *Kind = l.set.differences[l.paired[l.paired_kinds[i - 1]::usize].difference::usize].kind;
        val y: *Kind = l.set.differences[l.paired[l.paired_kinds[i]::usize].difference::usize].kind;
        if (str_compare(x.name, y.name) == 0) { ret err[Fail].err{fail.in_record(fail.internal("two difference rows share a kind"), "difference row")}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# every row written from its section's start writes a section offset, as a
# difference of a width the set writes, naming its target by a symbol
fun started(l: *Lookup) err[Fail] {
    val s: *Set  = l.set;
    var i: usize = 0;
    for (i < s.write_count) {
        val w: *Row = ?s.writes[i];
        i = i + 1;
        if (!sel w.write.started)             { cnt; }
        if (!reloc.has(w.kind, reloc.SECREL)) { ret err[Fail].err{fail.about(fail.internal("relocation row written from its section's start writes no section offset"), w.name)}; }
        if (sel w.names.either)               { ret err[Fail].err{fail.about(fail.internal("relocation row written from its section's start names its target by its section, which a difference cannot add"), w.name)}; }
        val p: opt[Pairing] = difference_in(l, field.width(w.fields[0].field));
        if (sel p.none) { ret err[Fail].err{fail.about(fail.internal("relocation row written from its section's start has no difference of its width"), w.name)}; }
    }
    ret err[Fail].ok{};
}

fun order_listed(a: **Kind, b: **Kind) i64 {
    if (a[0]::u64 < b[0]::u64) { ret -1; }
    if (a[0]::u64 > b[0]::u64) { ret 1; }
    ret 0;
}

fun order_kind_names(a: **Kind, b: **Kind) i64 {
    ret str_compare(a[0].name, b[0].name);
}

# every kind the set lists is sound, named once and mapped to by a row, and
# every row's kind is listed
fun listed(a: *A.Allocator, l: *Lookup) err[Fail] {
    var byaddr: Vector[*Kind] = vector.init[*Kind](a);
    var byname: Vector[*Kind] = vector.init[*Kind](a);
    val e:      err[Fail]     = listing(l, ?byaddr, ?byname);
    val ra:     err[Fail]     = vectors.release[*Kind](?byaddr);
    val rn:     err[Fail]     = vectors.release[*Kind](?byname);
    if (sel e.err)  { ret e; }
    if (sel ra.err) { ret ra; }
    ret rn;
}

fun listing(l: *Lookup, byaddr: *Vector[*Kind], byname: *Vector[*Kind]) err[Fail] {
    val s: *Set  = l.set;
    var i: usize = 0;
    for (i < s.kind_count) {
        val k: *Kind = s.kinds[i];
        if (k == nil || !reloc.consistent(k)) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation kind is unsound"), "relocation kind", i::u64)}; }
        val m: res[*Row, Fail] = by_kind(l, k);
        if (sel m.err) { ret err[Fail].err{fail.in_indexed(fail.about(fail.internal("relocation kind maps to no row"), k.name), "relocation kind", i::u64)}; }
        val pa: err[Fail] = vectors.push[*Kind](byaddr, k);
        if (sel pa.err) { ret err[Fail].err{pa.err}; }
        val pn: err[Fail] = vectors.push[*Kind](byname, k);
        if (sel pn.err) { ret err[Fail].err{pn.err}; }
        i = i + 1;
    }
    val dup: opt[*Kind] = index.seal[Kind](byaddr.data, s.kind_count, order_listed);
    if (sel dup.some) { ret err[Fail].err{fail.about(fail.internal("relocation kind is listed twice"), dup.some.name)}; }
    val same: opt[*Kind] = index.seal[Kind](byname.data, s.kind_count, order_kind_names);
    if (sel same.some) { ret err[Fail].err{fail.about(fail.internal("two relocation kinds share a name"), same.some.name)}; }
    i = 0;
    for (i < s.count) {
        val found: opt[*Kind] = index.find[Kind](byaddr.data, s.kind_count, s.rows[i].kind, order_listed);
        if (sel found.none) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation row maps to a kind its set does not list"), "relocation row", i::u64)}; }
        i = i + 1;
    }
    i = 0;
    for (i < s.write_count) {
        val found: opt[*Kind] = index.find[Kind](byaddr.data, s.kind_count, s.writes[i].kind, order_listed);
        if (sel found.none) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation writing row maps to a kind its set does not list"), "relocation writing row", i::u64)}; }
        i = i + 1;
    }
    ret placings(l);
}

# every placing row's reach differs from that of the row that writes its kind
fun placings(l: *Lookup) err[Fail] {
    var i: usize = 0;
    for (i < l.placed_count) {
        val p: *Row            = row_at(l, l.placed[i]);
        val w: res[*Row, Fail] = by_kind(l, p.kind);
        if (sel w.err)               { ret err[Fail].err{fail.about(fail.internal("relocation row places a kind no row writes"), p.name)}; }
        if (reach(w.ok) == reach(p)) { ret err[Fail].err{fail.about(fail.internal("relocation row places its kind from the reach of the row that writes it"), p.name)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the writing row `w` writes a key the rows that read it read as other kinds,
# from the same container, with the addend in the same place and counted from
# the same point, so what it writes reads back
fun reads_back(l: *Lookup, w: *Row) err[Fail] {
    val at: opt[usize] = first_of(l, w.key);
    if (sel at.none) { ret err[Fail].err{fail.about(fail.internal("relocation writing row writes a key no row reads"), w.name)}; }
    var i: usize = at.some;
    for (i < l.key_count && keyed(l, i).key == w.key) {
        val r: *Row = keyed(l, i);
        if (r.kind == w.kind)                       { ret err[Fail].err{fail.about(fail.internal("relocation writing row writes the kind its key reads as"), w.name)}; }
        if (container(r) != container(w))           { ret err[Fail].err{fail.about(fail.internal("relocation writing row differs in container from the row its key reads"), w.name)}; }
        if (!same_addend(r, w))                     { ret err[Fail].err{fail.about(fail.internal("relocation writing row keeps its addend apart from the row its key reads"), w.name)}; }
        if (r.bias != w.bias || r.trail != w.trail) { ret err[Fail].err{fail.about(fail.internal("relocation writing row counts its addend from another point than the row its key reads"), w.name)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# whether `a` and `b` keep their addends in the same place
fun same_addend(a: *Row, b: *Row) bool {
    if (sel a.addend.field)   { ret sel b.addend.field; }
    if (sel a.addend.record)  { ret sel b.addend.record; }
    if (sel a.addend.none)    { ret sel b.addend.none; }
    if (sel a.addend.partner) { ret sel b.addend.partner; }
    ret sel b.addend.held;
}

# the rows that share a key share its name and container, and each of their
# field choices reads the instruction and holds where no other row's does, so
# exactly one row reads the key for any instruction at its place
fun grouped(l: *Lookup) err[Fail] {
    val n:     usize = l.key_count;
    var start: usize = 0;
    for (start < n) {
        var end: usize = start + 1;
        for (end < n && keyed(l, end).key == keyed(l, start).key) { end = end + 1; }
        if (end - start > 1) {
            var i: usize = start;
            for (i < end) {
                val r: *Row = keyed(l, i);
                if (str_compare(r.name, keyed(l, start).name) != 0) { ret err[Fail].err{fail.about(fail.internal("relocation rows of one code differ in name"), r.name)}; }
                if (container(r) != container(keyed(l, start)))     { ret err[Fail].err{fail.about(fail.internal("relocation rows of one code differ in container"), r.name)}; }
                var c: usize = 0;
                for (c < r.field_count) {
                    if (r.fields[c].insn_mask == 0) { ret err[Fail].err{fail.about(fail.internal("relocation row of a code several rows read takes every instruction"), r.name)}; }
                    c = c + 1;
                }
                var j: usize = start;
                for (j < i) {
                    if (overlaps(r, keyed(l, j))) { ret err[Fail].err{fail.about(fail.internal("two relocation rows of one code read one instruction"), r.name)}; }
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        start = end;
    }
    ret err[Fail].ok{};
}

# whether a field choice of `a` and one of `b` can both hold
fun overlaps(a: *Row, b: *Row) bool {
    var i: usize = 0;
    for (i < a.field_count) {
        var j: usize = 0;
        for (j < b.field_count) {
            val both: u64 = a.fields[i].insn_mask & b.fields[j].insn_mask;
            if (((a.fields[i].insn_value ^ b.fields[j].insn_value) & both) == 0) { ret true; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret false;
}

# every field choice of `r` is sound, the choices share their container,
# and no two can both hold
fun shapes(r: *Row) err[Fail] {
    if (r.field_count == 0 || r.fields == nil) { ret err[Fail].err{fail.internal("relocation row has no field")}; }
    if (r.bias != 0 && sel r.addend.none)      { ret err[Fail].err{fail.internal("relocation row biases an addend it does not have")}; }
    var i: usize = 0;
    for (i < r.field_count) {
        val c: *FieldChoice = ?r.fields[i];
        val e: err[Fail]    = shape(c.field, r.range);
        if (sel e.err)                                                     { ret e; }
        if ((c.insn_value & ~c.insn_mask) != 0)                            { ret err[Fail].err{fail.internal("relocation field choice holds bits it does not read")}; }
        if (c.field.bytes != r.fields[0].field.bytes)                      { ret err[Fail].err{fail.internal("relocation field choices differ in container")}; }
        if (c.insn_mask != 0 && (c.field.bytes > 8 || c.field.bytes == 0)) { ret err[Fail].err{fail.internal("relocation field choice reads no instruction")}; }
        if ((c.align & (c.align - 1)) != 0)                                { ret err[Fail].err{fail.internal("relocation field choice alignment is not a power of two")}; }
        var j: usize = 0;
        for (j < i) {
            val d:    *FieldChoice = ?r.fields[j];
            val both: u64          = c.insn_mask & d.insn_mask;
            if (((c.insn_value ^ d.insn_value) & both) == 0) { ret err[Fail].err{fail.internal("two relocation field choices can both hold")}; }
            j = j + 1;
        }
        i = i + 1;
    }
    if (sel r.addend.held) {
        val h: *Field = r.addend.held;
        if (h == nil)                           { ret err[Fail].err{fail.internal("relocation addend field is missing")}; }
        if (h.bytes != r.fields[0].field.bytes) { ret err[Fail].err{fail.internal("relocation addend field differs from the value's in container")}; }
        ret shape(h, held_range(h));
    }
    ret err[Fail].ok{};
}

# the range of an addend held in the field `f`: a signed byte count as wide
# as the field holds with its sign, in steps of the bits it shifts out
pub fun held_range(f: *Field) Range {
    var bits: u32 = field.width(f) + f.shift::u32;
    if (sel f.sign.some) { bits = bits + 1; }
    ret Range{check: field.Check.signed{}, bits: bits::u8, align: (1::u64) << f.shift::u64};
}

fun shape(f: *Field, g: Range) err[Fail] {
    if (f.bytes > field.MAX_BYTES) { ret err[Fail].err{fail.internal("relocation field container is too wide")}; }
    val bits: u32 = f.bytes::u32 * 8;
    var i:    u8  = 0;
    for (i < f.count) {
        val p: *Piece = ?f.pieces[i];
        if (p.width == 0 || p.at::u32 + p.width::u32 > bits) {
            ret err[Fail].err{fail.internal("relocation field is wider than its container")};
        }
        var j: u8 = 0;
        for (j < i) {
            val q: *Piece = ?f.pieces[j];
            if (p.at < q.at + q.width && q.at < p.at + p.width) {
                ret err[Fail].err{fail.internal("relocation field bit ranges overlap")};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    if (f.split != 0 && (f.shift != 0 || f.round || f.split::u32 >= field.width(f))) {
        ret err[Fail].err{fail.internal("relocation field splits a value it also shifts or has no upper half")};
    }
    if (f.run) {
        if (f.count != f.bytes) { ret err[Fail].err{fail.internal("relocation run has a piece short of a byte")}; }
        var k: u8 = 0;
        for (k < f.count) {
            if (f.pieces[k].at != k * 8 || f.pieces[k].width != 7) {
                ret err[Fail].err{fail.internal("relocation run piece is not the low seven bits of its byte")};
            }
            k = k + 1;
        }
    }
    var extra: u32 = 0;
    if (sel f.sign.some) {
        val sg: field.Sign = f.sign.some;
        if (sg.width == 0 || sg.at::u32 + sg.width::u32 > bits) {
            ret err[Fail].err{fail.internal("relocation sign bits are wider than the container")};
        }
        var k: u8 = 0;
        for (k < f.count) {
            val p: *Piece = ?f.pieces[k];
            if (sg.at < p.at + p.width && p.at < sg.at + sg.width) {
                ret err[Fail].err{fail.internal("relocation sign bits overlap the field")};
            }
            k = k + 1;
        }
        extra = 1;
    }
    if (g.align == 0 || (g.align & (g.align - 1)) != 0) {
        ret err[Fail].err{fail.internal("relocation alignment is not a power of two")};
    }
    if (sel g.check.wrap) { ret err[Fail].ok{}; }
    if (g.bits == 0 || g.bits > 64 || g.bits::u32 > f.shift::u32 + field.width(f) + extra) {
        ret err[Fail].err{fail.internal("relocation range does not fit its field")};
    }
    ret err[Fail].ok{};
}

fun links(l: *Lookup, r: *Row) err[Fail] {
    if (sel r.pair.some) {
        val p: PairRule = r.pair.some;
        var k: usize    = 0;
        for (k < p.count) {
            val m: opt[usize] = first_of(l, p.keys[k]);
            if (sel m.none) { ret err[Fail].err{fail.internal("relocation partner has no row")}; }
            k = k + 1;
        }
    }
    if (sel r.addend.partner) {
        val p: Keys  = r.addend.partner;
        var k: usize = 0;
        for (k < p.count) {
            val m: opt[usize] = first_of(l, p.keys[k]);
            if (sel m.none) { ret err[Fail].err{fail.internal("relocation addend record has no row")}; }
            k = k + 1;
        }
    }
    ret candidates(l, r);
}

# the forms of `r` each name a row for every kind they rewrite to and every
# partner they consume, are bounded, and no two that can both hold remove the
# same bytes at the same rank, so the one taken is never in doubt
fun candidates(l: *Lookup, r: *Row) err[Fail] {
    var i: usize = 0;
    for (i < r.rewrite_count) {
        val w: *Rewrite  = r.rewrites[i];
        val e: err[Fail] = rewritten(l, r, w);
        if (sel e.err)                                      { ret err[Fail].err{fail.about(e.err, w.name)}; }
        if (sel w.emit.removal.pad && r.rewrite_count != 1) { ret err[Fail].err{fail.about(fail.internal("a rewrite that deletes padding is not its row's only form"), w.name)}; }
        var j: usize = i + 1;
        for (j < r.rewrite_count) {
            val v: *Rewrite = r.rewrites[j];
            if (both_hold(w, v) && ties(w, v)) { ret err[Fail].err{fail.about(fail.in_record(fail.internal("two rewrites of a row can both hold and remove the same bytes at the same rank"), w.name), v.name)}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the offset a record of `w` patches once rewritten: its own place `offset`
# moved by the form's `moves`, refused when that lies before its section
pub fun moved(w: *Rewrite, offset: u64) res[u64, Fail] {
    val moves: i64 = w.emit.moves::i64;
    if (moves < 0 && (-moves)::u64 > offset) { ret res[u64, Fail].err{fail.malformed("a rewritten relocation moves before its section")}; }
    if (moves < 0)                           { ret res[u64, Fail].ok{offset - (-moves)::u64}; }
    ret res[u64, Fail].ok{offset + moves::u64};
}

# the bytes the form `w` removes, padding it keeps the length of apart
pub fun removed(w: *Rewrite) u64 {
    if (sel w.emit.removal.bytes) { ret w.emit.removal.bytes.len::u64; }
    ret 0;
}

# whether the form `a` is taken over `b` where both hold: it removes more
# bytes, or as many at a higher rank
pub fun beats(a: *Rewrite, b: *Rewrite) bool {
    if (removed(a) != removed(b)) { ret removed(a) > removed(b); }
    ret a.rank > b.rank;
}

# whether neither of the forms `a` and `b` is taken over the other
pub fun ties(a: *Rewrite, b: *Rewrite) bool {
    ret removed(a) == removed(b) && a.rank == b.rank;
}

# whether some record can meet the conditions of both `a` and `b`, reading
# their ranges and traits as holding: their target, output and architecture
# axes meet, no two of their patterns over the same word ask different bits,
# and the partners of the one that consumes fewer begin the other's
fun both_hold(a: *Rewrite, b: *Rewrite) bool {
    if (!rule.meets(?a.when.target, ?b.when.target) || !rule.meets(?a.when.output, ?b.when.output) || !rule.meets(?a.when.arch, ?b.when.arch)) { ret false; }
    var i: usize = 0;
    for (i < a.when.shape_count) {
        val x: *InsnPattern = ?a.when.shape[i];
        var j: usize        = 0;
        for (j < b.when.shape_count) {
            val y: *InsnPattern = ?b.when.shape[j];
            if (x.at == y.at && x.len == y.len && ((x.value ^ y.value) & x.mask & y.mask) != 0) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    var fewer: u8 = a.span;
    if (b.span < fewer) { fewer = b.span; }
    var k: u8 = 0;
    for (k < fewer) {
        val x: *Partner = ?a.when.partners[k];
        val y: *Partner = ?b.when.partners[k];
        if (x.kind != y.kind || x.at != y.at) { ret false; }
        k = k + 1;
    }
    if (sel a.when.addend.some) {
        if (sel b.when.addend.some) {
            if (a.when.addend.some != b.when.addend.some) { ret false; }
        }
    }
    ret true;
}

# the rewrite `w` of `r` names a row for every kind it rewrites to, one per
# record it consumes, and for every partner kind it consumes, its patterns,
# copies and template are bounded, its template and its deletion are
# disjoint, and a padding it deletes is stated by a record addend
fun rewritten(l: *Lookup, r: *Row, w: *Rewrite) err[Fail] {
    if (w.kind_count != w.span::usize + 1)     { ret err[Fail].err{fail.internal("rewrite's kinds do not number the records it consumes")}; }
    if (w.span != 0 && w.when.partners == nil) { ret err[Fail].err{fail.internal("rewrite names no kinds for the partners it consumes")}; }
    var k: usize = 0;
    for (k < w.kind_count) {
        val m: res[*Row, Fail] = by_kind(l, w.kinds[k]);
        if (sel m.err) { ret err[Fail].err{fail.internal("rewritten relocation has no row")}; }
        k = k + 1;
    }
    k = 0;
    for (k < w.span::usize) {
        val m: res[*Row, Fail] = by_kind(l, w.when.partners[k].kind);
        if (sel m.err) { ret err[Fail].err{fail.internal("rewrite's partner has no row")}; }
        k = k + 1;
    }
    var p: usize = 0;
    for (p < w.when.shape_count) {
        val x: *InsnPattern = ?w.when.shape[p];
        if (x.len == 0 || x.len > 8 || (x.value & ~x.mask) != 0) { ret err[Fail].err{fail.internal("rewrite pattern is malformed")}; }
        p = p + 1;
    }
    var q: usize = 0;
    for (q < w.when.equal_count) {
        val x:    *Equal = ?w.when.equal[q];
        val bits: u32    = x.len::u32 * 8;
        if (x.len == 0 || x.len > 8 || x.width == 0 || x.width > 63 || x.shift::u32 + x.width::u32 > bits || x.other_shift::u32 + x.width::u32 > bits) {
            ret err[Fail].err{fail.internal("rewrite's equal bits do not fit their words")};
        }
        q = q + 1;
    }
    val e: Emit  = w.emit;
    val b: Bytes = e.bytes;
    if (b.len != 0 && b.data == nil) { ret err[Fail].err{fail.internal("rewrite template holds no bytes")}; }
    var c: usize = 0;
    for (c < e.copy_count) {
        val y:    *Copy = ?e.copies[c];
        val bits: u32   = y.len::u32 * 8;
        if (y.len == 0 || y.len > 8 || y.width == 0 || y.shift::u32 + y.width::u32 > bits || y.to::u32 + y.width::u32 > bits || y.into::u32 + y.len::u32 > b.len::u32) {
            ret err[Fail].err{fail.internal("rewrite copy does not fit its words")};
        }
        c = c + 1;
    }
    if (sel e.removal.bytes) {
        val d: Delete = e.removal.bytes;
        if (d.len == 0)                                                                             { ret err[Fail].err{fail.internal("rewrite deletes no byte")}; }
        if (b.len != 0 && b.at::i64 < d.at::i64 + d.len::i64 && d.at::i64 < b.at::i64 + b.len::i64) { ret err[Fail].err{fail.internal("rewrite writes bytes it deletes")}; }
    }
    if (sel e.removal.pad) {
        val pd: Pad = e.removal.pad;
        if (pd.unit == 0 || pd.fill_count == 0 || pd.fills == nil) { ret err[Fail].err{fail.internal("rewrite pads with no filler")}; }
        if (b.len != 0 || w.span != 0 || e.moves != 0)             { ret err[Fail].err{fail.internal("rewrite that deletes padding writes, consumes or moves more")}; }
        if (!sel r.addend.record)                                  { ret err[Fail].err{fail.internal("rewrite deletes padding no record addend states")}; }
        if (!reloc.has(r.kind, reloc.MARKER))                      { ret err[Fail].err{fail.internal("rewrite deletes padding at a place its row patches")}; }
        var f: usize = 0;
        for (f < pd.fill_count) {
            if (pd.fills[f].len == 0 || pd.fills[f].data == nil)  { ret err[Fail].err{fail.internal("rewrite filler holds no bytes")}; }
            if (f != 0 && pd.fills[f].len >= pd.fills[f - 1].len) { ret err[Fail].err{fail.internal("rewrite fillers are not widest first")}; }
            f = f + 1;
        }
    }
    ret err[Fail].ok{};
}

fun pair_order(l: *Lookup, f: *Format, a: *Arch) i64 {
    val o: i64 = str_compare(l.set.format.name, f.name);
    if (o != 0) { ret o; }
    ret str_compare(l.set.arch.name, a.name);
}

# the lookups of every (format, architecture) pair, ascending by format name,
# then architecture name, as the registry's generator writes them, static
# ---
# lookups: the lookups
# count:   how many
pub rec Registry {
    lookups: *Lookup;
    count:   usize;
}

# the lookup of the pair (`f`, `a`)
pub fun find(g: *Registry, f: *Format, a: *Arch) res[*Lookup, Fail] {
    var lo: usize = 0;
    var hi: usize = g.count;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (pair_order(?g.lookups[mid], f, a) < 0) { lo = mid + 1; }
        or                                         { hi = mid; }
    }
    if (lo < g.count && pair_order(?g.lookups[lo], f, a) == 0) { ret res[*Lookup, Fail].ok{?g.lookups[lo]}; }
    ret res[*Lookup, Fail].err{fail.unsupported("no relocation set for this format and architecture")};
}
