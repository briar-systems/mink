# the one row shape of every relocation table
#
# a row joins two halves. the format half is a format's relocation code and
# name and the neutral kind it maps to. the architecture half is how that kind
# is applied to bytes: the field shape, the value computation, the range, the
# partner it needs, where its addend lives and how it relaxes. the shape names
# no format and no architecture, and nothing branches on which a row belongs
# to. a set is the rows of one (format, architecture) pair, naming the pair by
# its catalog rows as data, and the difference rows saying which two of its
# records write the difference of two symbols. a registry holds the sets,
# checking every row of each as it registers.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;

use A: std.allocator;
use std.allocator.testing;

use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.fail;
use mink.fail.Fail;
use mink.index;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.compute;
use mink.reloc.compute.Computation;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.table;
use mink.table.Id;
use mink.table.Table;

# where the addend lives
# ---
# field:  in the bytes the relocation patches, as REL records keep it
# record: in the relocation record, as RELA records keep it
pub tag Addend: u8 {
    field;
    record;
}

# where a row's partner is found
# ---
# label:    at the place the row's target labels, as a split low half finds
#           the upper half it completes
# next:     the record after, at the same place
# previous: the record before, at the same place
pub tag Link: u8 {
    label;
    next;
    previous;
}

# a partner the row needs
# ---
# link:  where the partner is found
# codes: the codes a partner may have
# count: how many codes
pub rec Pair {
    link:  Link;
    codes: *u32;
    count: usize;
}

# the form a row relaxes to
# ---
# to:    the code of the relaxed row
# keeps: whether the relaxed form keeps the constant-time class of the code it
#        rewrites. one that does not is never applied to constant-time code
pub rec Relax {
    to:    u32;
    keeps: bool;
}

# code:   the format's relocation code
# name:   the format's name for the code
# kind:   the neutral kind the code maps to
# field:  the field the value is written to
# value:  the computation giving the value
# range:  the values the field accepts
# addend: where the addend lives
# pair:   the partner the row needs, none when it stands alone
# relax:  the form the row relaxes to, none when it cannot
pub rec Row {
    code:   u32;
    name:   str;
    kind:   *Kind;
    field:  *Field;
    value:  *Computation;
    range:  Range;
    addend: Addend;
    pair:   opt[Pair];
    relax:  opt[Relax];
}

# how a set writes a difference, the target's value less a second symbol's,
# as two records at one place, as a linker that moves code recomputes it
# ---
# kind:        the neutral difference kind
# plus:        the code of the record that adds the target and the addend
# minus:       the code of the record that subtracts the second symbol
# minus_first: whether the subtracting record is written first
pub rec Difference {
    kind:        *Kind;
    plus:        u32;
    minus:       u32;
    minus_first: bool;
}

# the rows of one (format, architecture) pair
# ---
# format:           the format whose codes the rows carry
# arch:             the architecture whose bytes the rows patch
# rows:             the rows, static
# count:            how many rows
# differences:      the difference rows, static, nil when the set has none
# difference_count: how many difference rows
pub rec Set {
    format:           *Format;
    arch:             *Arch;
    rows:             *Row;
    count:            usize;
    differences:      *Difference;
    difference_count: usize;
}

# a difference row with the two rows it writes
# ---
# difference: the row
# plus:       the row of the record that adds the target
# minus:      the row of the record that subtracts the second symbol
# bits:       how many bits the difference is written in, both rows' width
pub rec Pairing {
    difference: *Difference;
    plus:       *Row;
    minus:      *Row;
    bits:       u32;
}

# a set with its rows indexed by code and by kind
# ---
# set:      the set
# codes:    pointers to its rows, ascending by code
# kinds:    pointers to its rows, ascending by the kind row's address
# pairings: its difference rows, ascending by width
# pairs_by: pointers to its pairings, ascending by the kind row's address
pub rec Lookup {
    set:      *Set;
    codes:    Table[*Row];
    kinds:    Table[*Row];
    pairings: Table[Pairing];
    pairs_by: Table[*Pairing];
}

fun order_codes(a: **Row, b: **Row) i64 {
    if (a[0].code < b[0].code) { ret -1; }
    if (a[0].code > b[0].code) { ret 1; }
    ret 0;
}

fun order_kinds(a: **Row, b: **Row) i64 {
    if (a[0].kind::u64 < b[0].kind::u64) { ret -1; }
    if (a[0].kind::u64 > b[0].kind::u64) { ret 1; }
    ret 0;
}

# the row of `code`
pub fun by_code(l: *Lookup, code: u32) res[*Row, Fail] {
    var probe: Row       = Row{code: code};
    val at:    opt[*Row] = index.find[Row](table.items[*Row](?l.codes), table.count[*Row](?l.codes), ?probe, order_codes);
    if (sel at.none) { ret res[*Row, Fail].err{fail.unsupported("no relocation row has this code")}; }
    ret res[*Row, Fail].ok{at.some};
}

# the row mapping to `k`
pub fun by_kind(l: *Lookup, k: *Kind) res[*Row, Fail] {
    var probe: Row       = Row{kind: k};
    val at:    opt[*Row] = index.find[Row](table.items[*Row](?l.kinds), table.count[*Row](?l.kinds), ?probe, order_kinds);
    if (sel at.none) { ret res[*Row, Fail].err{fail.unsupported("no relocation row has this kind")}; }
    ret res[*Row, Fail].ok{at.some};
}

fun order_bits(a: *Pairing, b: *Pairing) i64 {
    if (a.bits < b.bits) { ret -1; }
    if (a.bits > b.bits) { ret 1; }
    ret 0;
}

fun order_pairing_kinds(a: **Pairing, b: **Pairing) i64 {
    if (a[0].difference.kind::u64 < b[0].difference.kind::u64) { ret -1; }
    if (a[0].difference.kind::u64 > b[0].difference.kind::u64) { ret 1; }
    ret 0;
}

# the pairing of the difference kind `k`
pub fun difference_of(l: *Lookup, k: *Kind) res[*Pairing, Fail] {
    var row:   Difference    = Difference{kind: k};
    var probe: Pairing       = Pairing{difference: ?row};
    val at:    opt[*Pairing] = index.find[Pairing](table.items[*Pairing](?l.pairs_by), table.count[*Pairing](?l.pairs_by), ?probe, order_pairing_kinds);
    if (sel at.none) { ret res[*Pairing, Fail].err{fail.unsupported("the relocation set writes no difference of this kind")}; }
    ret res[*Pairing, Fail].ok{at.some};
}

# the pairing written in exactly `bits` bits, none when the set has none
pub fun difference_in(l: *Lookup, bits: u32) opt[*Pairing] {
    val n: usize = table.count[Pairing](?l.pairings);
    if (n == 0) { ret opt[*Pairing].none{}; }
    var probe: Pairing        = Pairing{bits: bits};
    val pos:   SearchPosition = sort.binary_search_by[Pairing](table.items[Pairing](?l.pairings), n, ?probe, order_bits);
    if (sel pos.found) { ret opt[*Pairing].some{table.at[Pairing](?l.pairings, table.nth[Pairing](pos.found))}; }
    ret opt[*Pairing].none{};
}

# the row of the record of a relocation of kind `k` that names its target:
# the kind's own, or when the relocation names a second symbol the adding row
# of the kind's difference
pub fun targeting(l: *Lookup, k: *Kind, difference: bool) res[*Row, Fail] {
    if (!difference) { ret by_kind(l, k); }
    val p: res[*Pairing, Fail] = difference_of(l, k);
    if (sel p.err) { ret res[*Row, Fail].err{p.err}; }
    ret res[*Row, Fail].ok{p.ok.plus};
}

# the row `r` relaxes to, refused when it cannot relax or, in code marked
# constant-time, when the relaxed form would change its timing class
pub fun relaxed(l: *Lookup, r: *Row, constant_time: bool) res[*Row, Fail] {
    if (sel r.relax.none) { ret res[*Row, Fail].err{fail.unsupported("relocation cannot be relaxed")}; }
    val x: Relax = r.relax.some;
    if (constant_time && !x.keeps) {
        ret res[*Row, Fail].err{fail.unsupported("relaxation would change the timing of constant-time code")};
    }
    ret by_code(l, x.to);
}

# index the rows of a set, refused with a malformed row, a defect of mink: a field wider
# than its container, pieces that overlap, a range the field cannot hold, a
# partner or relaxed form with no row, a code or kind that two rows share, or
# a difference row whose records have no rows, differ in width or are of a
# kind that is no difference, or whose kind or width another one shares.
# the lookup is released with `release_lookup`, and nothing is held after a refusal
pub fun build(a: *A.Allocator, s: *Set) res[Lookup, Fail] {
    var l: Lookup    = Lookup{set: s, codes: table.make[*Row](a), kinds: table.make[*Row](a), pairings: table.make[Pairing](a), pairs_by: table.make[*Pairing](a)};
    val e: err[Fail] = fill(?l);
    if (sel e.err) {
        val c: err[Fail] = release_lookup(?l);
        ret res[Lookup, Fail].err{e.err};
    }
    ret res[Lookup, Fail].ok{l};
}

# give the lookup's tables back
pub fun release_lookup(l: *Lookup) err[Fail] {
    val c: err[Fail] = table.release[*Row](?l.codes);
    val k: err[Fail] = table.release[*Row](?l.kinds);
    val p: err[Fail] = table.release[Pairing](?l.pairings);
    val b: err[Fail] = table.release[*Pairing](?l.pairs_by);
    if (sel c.err) { ret c; }
    if (sel k.err) { ret k; }
    if (sel p.err) { ret p; }
    ret b;
}

# the position of the row `r` in `s`
fun position(s: *Set, r: *Row) u64 {
    var i: usize = 0;
    for (i < s.count) {
        if (?s.rows[i] == r) { ret i::u64; }
        i = i + 1;
    }
    ret s.count::u64;
}

fun fill(l: *Lookup) err[Fail] {
    val s: *Set  = l.set;
    var i: usize = 0;
    for (i < s.count) {
        val e: err[Fail] = shape(?s.rows[i]);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "relocation row", i::u64)}; }
        val c: res[Id[*Row], Fail] = table.push[*Row](?l.codes, ?s.rows[i]);
        if (sel c.err) { ret err[Fail].err{c.err}; }
        val k: res[Id[*Row], Fail] = table.push[*Row](?l.kinds, ?s.rows[i]);
        if (sel k.err) { ret err[Fail].err{k.err}; }
        i = i + 1;
    }
    val sc: opt[*Row] = index.seal[Row](table.items[*Row](?l.codes), s.count, order_codes);
    if (sel sc.some) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation code has two rows"), "relocation row", position(s, sc.some))}; }
    val sk: opt[*Row] = index.seal[Row](table.items[*Row](?l.kinds), s.count, order_kinds);
    if (sel sk.some) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation kind has two rows"), "relocation row", position(s, sk.some))}; }
    i = 0;
    for (i < s.count) {
        val e: err[Fail] = links(l, ?s.rows[i]);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "relocation row", i::u64)}; }
        i = i + 1;
    }
    ret pairings(l);
}

# index the difference rows of the set by width and by kind
fun pairings(l: *Lookup) err[Fail] {
    val s: *Set      = l.set;
    val r: err[Fail] = table.reserve[Pairing](?l.pairings, s.difference_count);
    if (sel r.err) { ret r; }
    var i: usize = 0;
    for (i < s.difference_count) {
        val p: res[Pairing, Fail] = pairing(l, ?s.differences[i]);
        if (sel p.err) { ret err[Fail].err{fail.in_indexed(p.err, "difference row", i::u64)}; }
        val pushed: res[Id[Pairing], Fail] = table.push[Pairing](?l.pairings, p.ok);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        i = i + 1;
    }
    val n: usize = s.difference_count;
    sort.sort_by[Pairing](table.items[Pairing](?l.pairings), n, order_bits);
    i = 0;
    for (i < n) {
        val at: *Pairing = table.at[Pairing](?l.pairings, table.nth[Pairing](i));
        if (i > 0 && table.at[Pairing](?l.pairings, table.nth[Pairing](i - 1)).bits == at.bits) {
            ret err[Fail].err{fail.in_record(fail.internal("two difference rows share a width"), "difference row")};
        }
        val k: res[Id[*Pairing], Fail] = table.push[*Pairing](?l.pairs_by, at);
        if (sel k.err) { ret err[Fail].err{k.err}; }
        i = i + 1;
    }
    val dup: opt[*Pairing] = index.seal[Pairing](table.items[*Pairing](?l.pairs_by), n, order_pairing_kinds);
    if (sel dup.some) { ret err[Fail].err{fail.in_record(fail.internal("two difference rows share a kind"), "difference row")}; }
    ret err[Fail].ok{};
}

fun pairing(l: *Lookup, d: *Difference) res[Pairing, Fail] {
    if (!reloc.has(d.kind, reloc.DIFF)) { ret res[Pairing, Fail].err{fail.internal("difference row is of a kind that is no difference")}; }
    val plus: res[*Row, Fail] = by_code(l, d.plus);
    if (sel plus.err) { ret res[Pairing, Fail].err{fail.internal("difference row adds with a record that has no row")}; }
    val minus: res[*Row, Fail] = by_code(l, d.minus);
    if (sel minus.err) { ret res[Pairing, Fail].err{fail.internal("difference row subtracts with a record that has no row")}; }
    val bits: u32 = field.width(plus.ok.field);
    if (bits == 0 || field.width(minus.ok.field) != bits) {
        ret res[Pairing, Fail].err{fail.internal("difference row's records differ in width")};
    }
    ret res[Pairing, Fail].ok{Pairing{difference: d, plus: plus.ok, minus: minus.ok, bits: bits}};
}

fun shape(r: *Row) err[Fail] {
    val f: *Field = r.field;
    if (f.bytes > field.MAX_BYTES) { ret err[Fail].err{fail.internal("relocation field container is too wide")}; }
    val bits: u32 = f.bytes::u32 * 8;
    var i:    u8  = 0;
    for (i < f.count) {
        val p: *Piece = ?f.pieces[i];
        if (p.width == 0 || p.at::u32 + p.width::u32 > bits) {
            ret err[Fail].err{fail.internal("relocation field is wider than its container")};
        }
        var j: u8 = 0;
        for (j < i) {
            val q: *Piece = ?f.pieces[j];
            if (p.at < q.at + q.width && q.at < p.at + p.width) {
                ret err[Fail].err{fail.internal("relocation field bit ranges overlap")};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    if (f.split != 0 && (f.shift != 0 || f.round || f.split::u32 >= field.width(f))) {
        ret err[Fail].err{fail.internal("relocation field splits a value it also shifts or has no upper half")};
    }
    if (f.run) {
        if (f.count != f.bytes) { ret err[Fail].err{fail.internal("relocation run has a piece short of a byte")}; }
        var k: u8 = 0;
        for (k < f.count) {
            if (f.pieces[k].at != k * 8 || f.pieces[k].width != 7) {
                ret err[Fail].err{fail.internal("relocation run piece is not the low seven bits of its byte")};
            }
            k = k + 1;
        }
    }
    var extra: u32 = 0;
    if (sel f.sign.some) {
        val sg: field.Sign = f.sign.some;
        if (sg.width == 0 || sg.at::u32 + sg.width::u32 > bits) {
            ret err[Fail].err{fail.internal("relocation sign bits are wider than the container")};
        }
        var k: u8 = 0;
        for (k < f.count) {
            val p: *Piece = ?f.pieces[k];
            if (sg.at < p.at + p.width && p.at < sg.at + sg.width) {
                ret err[Fail].err{fail.internal("relocation sign bits overlap the field")};
            }
            k = k + 1;
        }
        extra = 1;
    }
    val g: Range = r.range;
    if (g.align == 0 || (g.align & (g.align - 1)) != 0) {
        ret err[Fail].err{fail.internal("relocation alignment is not a power of two")};
    }
    if (sel g.check.wrap) { ret err[Fail].ok{}; }
    if (g.bits == 0 || g.bits > 64 || g.bits::u32 > f.shift::u32 + field.width(f) + extra) {
        ret err[Fail].err{fail.internal("relocation range does not fit its field")};
    }
    ret err[Fail].ok{};
}

fun links(l: *Lookup, r: *Row) err[Fail] {
    if (sel r.pair.some) {
        val p: Pair  = r.pair.some;
        var k: usize = 0;
        for (k < p.count) {
            val m: res[*Row, Fail] = by_code(l, p.codes[k]);
            if (sel m.err) { ret err[Fail].err{fail.internal("relocation partner has no row")}; }
            k = k + 1;
        }
    }
    if (sel r.relax.some) {
        val m: res[*Row, Fail] = by_code(l, r.relax.some.to);
        if (sel m.err) { ret err[Fail].err{fail.internal("relaxed relocation has no row")}; }
    }
    ret err[Fail].ok{};
}

fun order_pairs(a: **Lookup, b: **Lookup) i64 {
    val f: i64 = str_compare(a[0].set.format.name, b[0].set.format.name);
    if (f != 0) { ret f; }
    ret str_compare(a[0].set.arch.name, b[0].set.arch.name);
}

# the sets of every (format, architecture) pair, one set per pair
# ---
# lookups: the indexed sets, in the order registered
# pairs:   the pairs ascending by format name, then architecture name
pub rec Registry {
    lookups: Table[Lookup];
    pairs:   Table[*Lookup];
}

# a registry of the `count` sets at `sets`, refused when a set is malformed or
# two sets bind one pair. the registry is released with `release`
pub fun make(a: *A.Allocator, sets: **Set, count: usize) res[Registry, Fail] {
    var g: Registry  = Registry{lookups: table.make[Lookup](a), pairs: table.make[*Lookup](a)};
    val e: err[Fail] = admit(a, ?g, sets, count);
    if (sel e.err) {
        val c: err[Fail] = release(?g);
        ret res[Registry, Fail].err{e.err};
    }
    ret res[Registry, Fail].ok{g};
}

fun admit(a: *A.Allocator, g: *Registry, sets: **Set, count: usize) err[Fail] {
    val r: err[Fail] = table.reserve[Lookup](?g.lookups, count);
    if (sel r.err) { ret r; }
    val q: err[Fail] = table.reserve[*Lookup](?g.pairs, count);
    if (sel q.err) { ret q; }
    var i: usize = 0;
    for (i < count) {
        val l: res[Lookup, Fail] = build(a, sets[i]);
        if (sel l.err) { ret err[Fail].err{l.err}; }
        val p: res[Id[Lookup], Fail] = table.push[Lookup](?g.lookups, l.ok);
        if (sel p.err) {
            val c: err[Fail] = release_lookup(?l.ok);
            ret err[Fail].err{p.err};
        }
        val k: res[Id[*Lookup], Fail] = table.push[*Lookup](?g.pairs, table.at[Lookup](?g.lookups, p.ok));
        if (sel k.err) { ret err[Fail].err{k.err}; }
        i = i + 1;
    }
    val dup: opt[*Lookup] = index.seal[Lookup](table.items[*Lookup](?g.pairs), count, order_pairs);
    if (sel dup.some) {
        ret err[Fail].err{fail.in_record(fail.internal("two relocation sets bind one pair"), dup.some.set.format.name)};
    }
    ret err[Fail].ok{};
}

# give the registry's lookups back
pub fun release(g: *Registry) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    val items: *Lookup   = table.items[Lookup](?g.lookups);
    var i:     usize     = 0;
    for (i < table.count[Lookup](?g.lookups)) {
        val e: err[Fail] = release_lookup(?items[i]);
        if (sel first.ok && sel e.err) { first = e; }
        i = i + 1;
    }
    val l: err[Fail] = table.release[Lookup](?g.lookups);
    val p: err[Fail] = table.release[*Lookup](?g.pairs);
    if (sel first.err) { ret first; }
    if (sel l.err)     { ret l; }
    ret p;
}

# the lookup of the pair (`f`, `a`)
pub fun find(g: *Registry, f: *Format, a: *Arch) res[*Lookup, Fail] {
    var set:   Set          = Set{format: f, arch: a};
    var probe: Lookup       = Lookup{set: ?set};
    val got:   opt[*Lookup] = index.find[Lookup](table.items[*Lookup](?g.pairs), table.count[*Lookup](?g.pairs), ?probe, order_pairs);
    if (sel got.none) { ret res[*Lookup, Fail].err{fail.unsupported("no relocation set for this format and architecture")}; }
    ret res[*Lookup, Fail].ok{got.some};
}

val WORD_PIECES: [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val WORD:        Field    = Field{bytes: 4, pieces: ?WORD_PIECES[0], count: 1};
val WIDE_PIECES: [1]Piece = [1]Piece{Piece{at: 4, width: 32}};
val WIDE:        Field    = Field{bytes: 4, pieces: ?WIDE_PIECES[0], count: 1};
val OVER_PIECES: [2]Piece = [2]Piece{Piece{at: 0, width: 16}, Piece{at: 8, width: 16}};
val OVER:        Field    = Field{bytes: 4, pieces: ?OVER_PIECES[0], count: 2};
val HIGH:        [1]u32   = [1]u32{1};
val MISSING:     [1]u32   = [1]u32{9};

val SIGNED32: Range = Range{check: field.Check.signed{}, bits: 32, align: 1};

val GOOD: [3]Row = [3]Row{
    Row{code: 1, name: "hi", kind: ?reloc.PCREL_HI20, field: ?WORD, value: ?compute.PC, range: SIGNED32},
    Row{
        code:   2,
        name:   "lo",
        kind:   ?reloc.PCREL_LO12_I,
        field:  ?WORD,
        value:  ?compute.PC,
        range:  SIGNED32,
        addend: Addend.record{},
        pair:   opt[Pair].some{Pair{link: Link.label{}, codes: ?HIGH[0], count: 1}},
    },
    Row{
        code:  3,
        name:  "pc",
        kind:  ?reloc.PC32,
        field: ?WORD,
        value: ?compute.PC,
        range: SIGNED32,
        relax: opt[Relax].some{Relax{to: 1, keeps: false}},
    },
};

val TOO_WIDE: [1]Row = [1]Row{
    Row{code: 1, name: "wide", kind: ?reloc.PC32, field: ?WIDE, value: ?compute.PC, range: SIGNED32},
};
val OVERLAP: [1]Row = [1]Row{
    Row{code: 1, name: "over", kind: ?reloc.PC32, field: ?OVER, value: ?compute.PC, range: SIGNED32},
};
val ALONE: [1]Row = [1]Row{
    Row{
        code:  1,
        name:  "alone",
        kind:  ?reloc.PCREL_LO12_I,
        field: ?WORD,
        value: ?compute.PC,
        range: SIGNED32,
        pair:  opt[Pair].some{Pair{link: Link.label{}, codes: ?MISSING[0], count: 1}},
    },
};
val TWICE: [2]Row = [2]Row{
    Row{code: 1, name: "one", kind: ?reloc.PC32, field: ?WORD, value: ?compute.PC, range: SIGNED32},
    Row{code: 1, name: "two", kind: ?reloc.ABS32, field: ?WORD, value: ?compute.ABS, range: SIGNED32},
};

val SAME_KIND: [2]Row = [2]Row{
    Row{code: 1, name: "one", kind: ?reloc.PC32, field: ?WORD, value: ?compute.PC, range: SIGNED32},
    Row{code: 2, name: "two", kind: ?reloc.PC32, field: ?WORD, value: ?compute.PC, range: SIGNED32},
};

val GOOD_SET:      Set = Set{format: ?format.ELF, arch: ?arch.X86_64, rows: ?GOOD[0], count: 3};
val TOO_WIDE_SET:  Set = Set{format: ?format.COFF, arch: ?arch.X86_64, rows: ?TOO_WIDE[0], count: 1};
val OVERLAP_SET:   Set = Set{format: ?format.COFF, arch: ?arch.X86_64, rows: ?OVERLAP[0], count: 1};
val ALONE_SET:     Set = Set{format: ?format.COFF, arch: ?arch.X86_64, rows: ?ALONE[0], count: 1};
val TWICE_SET:     Set = Set{format: ?format.COFF, arch: ?arch.X86_64, rows: ?TWICE[0], count: 2};
val SAME_KIND_SET: Set = Set{format: ?format.COFF, arch: ?arch.X86_64, rows: ?SAME_KIND[0], count: 2};

test row__format_half_maps_both_ways {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    val built: res[Lookup, Fail] = build(testing.allocator_of(?t), ?GOOD_SET);
    if (sel built.err) { ret 1; }
    var l: Lookup = built.ok;
    var i: usize  = 0;
    for (i < GOOD_SET.count) {
        val r: *Row            = ?GOOD[i];
        val c: res[*Row, Fail] = by_code(?l, r.code);
        if (sel c.err) { ret 1; }
        if (c.ok != r) { ret 1; }
        val k: res[*Row, Fail] = by_kind(?l, r.kind);
        if (sel k.err) { ret 1; }
        if (k.ok != r) { ret 1; }
        i = i + 1;
    }
    val code: res[*Row, Fail] = by_code(?l, 4);
    if (sel code.ok)                     { ret 1; }
    if (!sel code.err.cause.unsupported) { ret 1; }
    val kind: res[*Row, Fail] = by_kind(?l, ?reloc.ABS64);
    if (sel kind.ok) { ret 1; }
    val freed: err[Fail] = release_lookup(?l);
    if (sel freed.err)               { ret 1; }
    if (testing.live_count(?t) != 0) { ret 1; }
    testing.dnit(?t);
    ret 0;
}

test row__registration_refuses_a_malformed_row {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = testing.allocator_of(?t);

    val good: [1]*Set             = [1]*Set{?GOOD_SET};
    val reg:  res[Registry, Fail] = make(a, ?good[0], 1);
    if (sel reg.err) { ret 1; }
    var g:     Registry           = reg.ok;
    val found: res[*Lookup, Fail] = find(?g, ?format.ELF, ?arch.X86_64);
    if (sel found.err)             { ret 1; }
    if (found.ok.set != ?GOOD_SET) { ret 1; }
    val miss: res[*Lookup, Fail] = find(?g, ?format.COFF, ?arch.X86_64);
    if (sel miss.ok) { ret 1; }
    val freed: err[Fail] = release(?g);
    if (sel freed.err) { ret 1; }

    val bad: [5]*Set = [5]*Set{?TOO_WIDE_SET, ?OVERLAP_SET, ?ALONE_SET, ?TWICE_SET, ?SAME_KIND_SET};
    var i:   usize   = 0;
    for (i < 5) {
        val r: res[Registry, Fail] = make(a, ?bad[i], 1);
        if (sel r.ok)                  { ret 1; }
        if (!sel r.err.cause.internal) { ret 1; }
        if (!r.err.at.indexed)         { ret 1; }
        i = i + 1;
    }
    val pair: [2]*Set             = [2]*Set{?GOOD_SET, ?GOOD_SET};
    val both: res[Registry, Fail] = make(a, ?pair[0], 2);
    if (sel both.ok)                 { ret 1; }
    if (testing.live_count(?t) != 0) { ret 1; }
    testing.dnit(?t);
    ret 0;
}
