# the one row shape of every relocation table
#
# a row joins two halves. the format half is a format's relocation key, the
# code or the code with the record's other fields as the pair composes it, its
# name and the neutral kind it maps to. the architecture half is how that kind
# is applied to bytes: the field shapes, chosen by the instruction at the
# place, the value computation, the range, the bias the format adds, the
# partner it needs, where its addend lives and the rewrites that may replace
# it. the shape names no format and no architecture, and nothing branches on
# which a row belongs to. a row maps its key and its kind in a direction: each
# key of the pair reads as exactly one kind, and each kind is written by
# exactly one row, so a kind several keys read is written by one of them and a
# key several kinds are written as reads back as one of them, each written
# kind keeping its own range. a set is the rows of one (format, architecture)
# pair, naming the pair by its catalog rows as data, the kinds its rows map
# to, the difference rows saying which two of its records write the
# difference of two symbols, and the vendor sets a vendor symbol selects. one
# walk checks every row, kind, difference, rewrite and vendor set of a set as
# a lookup is built, and a registry holds the sets.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_len;

use A: std.allocator;
use std.allocator.testing;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.index;
use mink.base.rule.Axis;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.catalog.arch.Arch;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.catalog.format.Format;
use mink.catalog.os;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.compute;
use mink.reloc.compute.Computation;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;

# keys a row names, as a partner's or an addend record's
# ---
# keys:  the keys, static
# count: how many
pub rec Keys {
    keys:  *u32;
    count: usize;
}

# where the addend lives
# ---
# field:   in the bytes the relocation patches, in the field the value is
#          written to, as REL records keep it
# record:  in the relocation record, as RELA records keep it
# partner: in the record of a partner of one of these keys, as a Mach-O
#          ARM64_RELOC_ADDEND record holds the addend of the record it heads
# held:    in the bytes the relocation patches, in a field of its own shape
#          read as a signed byte count, as a COFF ARM64 PAGEBASE_REL21 keeps
#          its addend unscaled where the value written is a page delta
# none:    nowhere, the relocation has no addend
pub tag Addend: u8 {
    field;
    record;
    partner: Keys;
    held:    *Field;
    none;
}

# where a row's partner is found
# ---
# label:    at the place the row's target labels, as a split low half finds
#           the upper half it completes
# next:     the record after, at the same place
# previous: the record before, at the same place
pub tag Link: u8 {
    label;
    next;
    previous;
}

# what a partner is to the row that needs it
# ---
# addend:  it carries the row's addend
# minus:   the two write a difference, one adding and the other subtracting
# hi_part: it is the upper half whose value the row's low half completes
pub tag Role: u8 {
    addend;
    minus;
    hi_part;
}

# a partner the row needs
# ---
# link:  where the partner is found
# keys:  the keys a partner may have
# count: how many keys
# role:  what the partner is to the row
pub rec PairRule {
    link:  Link;
    keys:  *u32;
    count: usize;
    role:  Role;
}

# one field a row writes, chosen when the instruction at the place holds
# `insn_value` in the bits of `insn_mask`. a row's choices are disjoint and
# share their container, so at most one holds for any instruction, and a lone
# choice of mask zero holds for every one
# ---
# insn_mask:  the instruction bits the choice reads, in the container's order
# insn_value: the value they hold
# field:      the field written
# align:      the alignment a value written through this choice must keep
#             besides the row's, as a scaled load or store writes only
#             offsets of its access size, zero for the row's alone
pub rec FieldChoice {
    insn_mask:  u64;
    insn_value: u64;
    field:      *Field;
    align:      u64;
}

# what must hold for a rewrite to apply
# ---
# target:      over the target's binding, the capabilities the dynamic
#              linking model states of it
# output:      over the output kind's capabilities
# range:       the values the rewritten form takes, none for any
# traits:      the trait settings that must hold, static
# trait_count: how many
pub rec Condition {
    target:      Axis;
    output:      Axis;
    range:       opt[Range];
    traits:      *os.When;
    trait_count: usize;
}

# instruction bytes a rewrite matches, `len` bytes from `at` past the place
# holding `value` in the bits of `mask`
pub rec InsnPattern {
    at:    u8;
    mask:  u64;
    value: u64;
    len:   u8;
}

# bytes a rewrite writes over the matched instruction, `len` bytes of `data`
# from `at` past the place, none when `len` is zero
pub rec Bytes {
    at:   u8;
    data: *u8;
    len:  u8;
}

# bytes a rewrite deletes, `len` from `at` past the place
pub rec Delete {
    at:  u8;
    len: u8;
}

# what a rewrite does to the bytes at the place
# ---
# bytes:  writes a template over them
# delete: deletes them, so the code after moves
pub tag Emit: u8 {
    bytes:  Bytes;
    delete: Delete;
}

# a form a relocation may be rewritten to, as relaxation, a thread-local
# model transition or a form choice rewrites it
# ---
# name:        its spelling in a diagnostic
# when:        what must hold for it to apply
# match:       the instruction bytes it matches, static
# match_count: how many patterns
# span:        how many partner records after the row's own it consumes
# emit:        what it does to the bytes
# kinds:       the kinds the records it consumes become, the row's first
# kind_count:  how many, one more than the span
# keeps_ct:    whether the rewritten form keeps the constant-time class of
#              the code it rewrites. one that does not is never applied
#              inside a constant-time range
pub rec Rewrite {
    name:        str;
    when:        Condition;
    match:       *InsnPattern;
    match_count: usize;
    span:        u8;
    emit:        Emit;
    kinds:       **Kind;
    kind_count:  usize;
    keeps_ct:    bool;
}

# how the writer takes a row for its kind
# ---
# always: the row writes its kind, the one row of the kind the writer takes
# never:  the row only reads, as another row writes its kind
# placed: the row only reads, and the writer takes it in place of the row
#         that writes its kind for a record that names its target's section
#         when its reach counts the target from nearer the target's symbol,
#         as a field that counts from the end of a longer instruction does
pub tag Write: u8 {
    always;
    never;
    placed;
}

# key:           the format's relocation key, as the pair composes it from the
#                record
# name:          the format's name for the key
# kind:          the neutral kind the row maps the key to
# fields:        the fields the value may be written to, static
# field_count:   how many
# value:         the computation giving the value
# range:         the values the field accepts
# addend:        where the addend lives
# bias:          how far the format's count of the addend lies from the
#                place, as a code that counts from past its field holds the
#                neutral addend less this. the engine adds it to the addend it
#                reads and takes it from the addend it writes
# trail:         how many bytes of the instruction follow the point the
#                addend counts from, past which the format counts the target
#                of a record that names its target's section. zero for a
#                format that counts both from one point
# pair:          the partner the row needs, none when it stands alone
# rewrites:      the forms it may be rewritten to, static
# rewrite_count: how many
# write:         whether and when the writer takes the row for its kind
pub rec Row {
    key:           u32;
    name:          str;
    kind:          *Kind;
    fields:        *FieldChoice;
    field_count:   usize;
    value:         *Computation;
    range:         Range;
    addend:        Addend;
    bias:          i64;
    trail:         u8;
    pair:          opt[PairRule];
    rewrites:      **Rewrite;
    rewrite_count: usize;
    write:         Write;
}

# how a set writes a difference, the target's value less a second symbol's,
# as two records at one place, as a linker that moves code recomputes it
# ---
# kind:        the neutral difference kind
# plus:        the key of the record that adds the target and the addend
# minus:       the key of the record that subtracts the second symbol
# minus_first: whether the subtracting record is written first
pub rec Difference {
    kind:        *Kind;
    plus:        u32;
    minus:       u32;
    minus_first: bool;
}

# the rows a vendor symbol selects for the codes the format leaves to vendors
# ---
# symbol: the vendor's symbol name, as a vendor record names it
# set:    the vendor's rows
pub rec Vendor {
    symbol: str;
    set:    *Set;
}

# a neutral kind a pair has no form for, and why
# ---
# kind:   the neutral kind
# why:    what the pair lacks
# source: the document that defines the pair's relocations without it
pub rec Refusal {
    kind:   *Kind;
    why:    str;
    source: str;
}

# the rows of one (format, architecture) pair
# ---
# format:           the format whose keys the rows carry
# arch:             the architecture whose bytes the rows patch
# rows:             the rows, one per key, each reading its key as its kind,
#                   static
# count:            how many rows
# kinds:            the kinds the rows map to, static
# kind_count:       how many kinds
# differences:      the difference rows, static, nil when the set has none
# difference_count: how many difference rows
# vendors:          the vendor sets, static, nil when the set has none
# vendor_count:     how many vendor sets
# refusals:         the neutral kinds the pair has no form for, static, nil
#                   when it maps every one
# refusal_count:    how many refusals
# writes:           the rows that write a kind under a key a row of `rows`
#                   reads as another kind, static, nil when the set has none
# write_count:      how many
pub rec Set {
    format:           *Format;
    arch:             *Arch;
    rows:             *Row;
    count:            usize;
    kinds:            **Kind;
    kind_count:       usize;
    differences:      *Difference;
    difference_count: usize;
    vendors:          *Vendor;
    vendor_count:     usize;
    refusals:         *Refusal;
    refusal_count:    usize;
    writes:           *Row;
    write_count:      usize;
}

# a difference row with the two rows it writes
# ---
# difference: the row
# plus:       the row of the record that adds the target
# minus:      the row of the record that subtracts the second symbol
# bits:       how many bits the difference is written in, both rows' width
pub rec Pairing {
    difference: *Difference;
    plus:       *Row;
    minus:      *Row;
    bits:       u32;
}

# a set with its rows indexed by key and by kind
# ---
# set:      the set
# keys:     pointers to the rows that read, ascending by key
# kinds:    pointers to the rows that write, ascending by the kind row's
#           address
# placed:   pointers to the rows the writer takes to place a target,
#           ascending by the kind row's address, then by reach
# pairings: its difference rows, ascending by width
# pairs_by: pointers to its pairings, ascending by the kind row's address
pub rec Lookup {
    set:      *Set;
    keys:     Table[*Row];
    kinds:    Table[*Row];
    placed:   Table[*Row];
    pairings: Table[Pairing];
    pairs_by: Table[*Pairing];
}

fun order_keys(a: **Row, b: **Row) i64 {
    if (a[0].key < b[0].key) { ret -1; }
    if (a[0].key > b[0].key) { ret 1; }
    ret 0;
}

fun order_kinds(a: **Row, b: **Row) i64 {
    if (a[0].kind::u64 < b[0].kind::u64) { ret -1; }
    if (a[0].kind::u64 > b[0].kind::u64) { ret 1; }
    ret 0;
}

fun order_placed(a: **Row, b: **Row) i64 {
    val k: i64 = order_kinds(a, b);
    if (k != 0)                    { ret k; }
    if (reach(a[0]) < reach(b[0])) { ret -1; }
    if (reach(a[0]) > reach(b[0])) { ret 1; }
    ret 0;
}

# the row that reads `key`
pub fun by_key(l: *Lookup, key: u32) res[*Row, Fail] {
    var probe: Row       = Row{key: key};
    val at:    opt[*Row] = index.find[Row](table.items[*Row](?l.keys), table.count[*Row](?l.keys), ?probe, order_keys);
    if (sel at.none) { ret res[*Row, Fail].err{fail.unsupported("no relocation row has this code")}; }
    ret res[*Row, Fail].ok{at.some};
}

# the row that writes `k`
pub fun by_kind(l: *Lookup, k: *Kind) res[*Row, Fail] {
    var probe: Row       = Row{kind: k};
    val at:    opt[*Row] = index.find[Row](table.items[*Row](?l.kinds), table.count[*Row](?l.kinds), ?probe, order_kinds);
    if (sel at.none) { ret res[*Row, Fail].err{fail.unsupported("no relocation row has this kind")}; }
    ret res[*Row, Fail].ok{at.some};
}

# the failure of a converter that finds no row for `k`: the refusal of the
# pair when it states one, a defect of mink when `k` is a neutral kind the set
# neither maps nor refuses, and `found` otherwise
pub fun absent(l: *Lookup, k: *Kind, found: Fail) Fail {
    var i: usize = 0;
    for (i < l.set.refusal_count) {
        val f: *Refusal = ?l.set.refusals[i];
        if (f.kind == k) { ret fail.cited(fail.about(fail.unsupported(f.why), k.name), f.source); }
        i = i + 1;
    }
    val own:     res[*Row, Fail]     = by_kind(l, k);
    val pairing: res[*Pairing, Fail] = difference_of(l, k);
    if (neutral(k) && sel own.err && sel pairing.err) { ret fail.about(fail.internal("neutral relocation kind is neither mapped nor refused"), k.name); }
    ret fail.about(found, k.name);
}

# the row of the record of `k` a converter writes, as `targeting` with no
# difference
pub fun writing(l: *Lookup, k: *Kind) res[*Row, Fail] {
    val r: res[*Row, Fail] = by_kind(l, k);
    if (sel r.err) { ret res[*Row, Fail].err{absent(l, k, r.err)}; }
    ret r;
}

# how far from the place a field of `r` counts the target of a record that
# names its target's section: the row's bias less the instruction bytes that
# trail the point it counts its addend from
pub fun reach(r: *Row) i64 {
    ret r.bias - r.trail::i64;
}

# the row the writer takes for a record of the kind `r` writes that names its
# target's section and holds the neutral addend `a`: of `r` and the rows that
# place its kind, the one that counts the target from nearest its symbol,
# the greatest reach not above `a` when one is, which counts it from at or
# after the symbol, and the least reach when every one lies above `a`
pub fun placing(l: *Lookup, r: *Row, a: i64) *Row {
    var chosen: *Row = nil;
    var least:  *Row = r;
    if (reach(r) <= a) { chosen = r; }
    val items: **Row = table.items[*Row](?l.placed);
    val n:     usize = table.count[*Row](?l.placed);
    var lo:    usize = 0;
    var hi:    usize = n;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (items[mid].kind::u64 < r.kind::u64) { lo = mid + 1; }
        or                                      { hi = mid; }
    }
    for (lo < n && items[lo].kind == r.kind) {
        val q: *Row = items[lo];
        if (reach(q) <= a && (chosen == nil || reach(q) > reach(chosen))) { chosen = q; }
        if (reach(q) < reach(least))                                      { least = q; }
        lo = lo + 1;
    }
    if (chosen == nil) { ret least; }
    ret chosen;
}

# the container bytes every field of `r` shares
pub fun container(r: *Row) u8 {
    ret r.fields[0].field.bytes;
}

# whether the choice `c` holds for the instruction bits `insn`
pub fun chosen(c: *FieldChoice, insn: u64) bool {
    ret (insn & c.insn_mask) == c.insn_value;
}

fun order_bits(a: *Pairing, b: *Pairing) i64 {
    if (a.bits < b.bits) { ret -1; }
    if (a.bits > b.bits) { ret 1; }
    ret 0;
}

fun order_pairing_kinds(a: **Pairing, b: **Pairing) i64 {
    if (a[0].difference.kind::u64 < b[0].difference.kind::u64) { ret -1; }
    if (a[0].difference.kind::u64 > b[0].difference.kind::u64) { ret 1; }
    ret 0;
}

# the pairing of the difference kind `k`
pub fun difference_of(l: *Lookup, k: *Kind) res[*Pairing, Fail] {
    var row:   Difference    = Difference{kind: k};
    var probe: Pairing       = Pairing{difference: ?row};
    val at:    opt[*Pairing] = index.find[Pairing](table.items[*Pairing](?l.pairs_by), table.count[*Pairing](?l.pairs_by), ?probe, order_pairing_kinds);
    if (sel at.none) { ret res[*Pairing, Fail].err{fail.unsupported("the relocation set writes no difference of this kind")}; }
    ret res[*Pairing, Fail].ok{at.some};
}

# the pairing written in exactly `bits` bits, none when the set has none
pub fun difference_in(l: *Lookup, bits: u32) opt[*Pairing] {
    val n: usize = table.count[Pairing](?l.pairings);
    if (n == 0) { ret opt[*Pairing].none{}; }
    var probe: Pairing        = Pairing{bits: bits};
    val pos:   SearchPosition = sort.binary_search_by[Pairing](table.items[Pairing](?l.pairings), n, ?probe, order_bits);
    if (sel pos.found) { ret opt[*Pairing].some{table.at[Pairing](?l.pairings, table.nth[Pairing](pos.found))}; }
    ret opt[*Pairing].none{};
}

# the row of the record of a relocation of kind `k` that names its target:
# the kind's own, or when the relocation names a second symbol the adding row
# of the kind's difference
pub fun targeting(l: *Lookup, k: *Kind, difference: bool) res[*Row, Fail] {
    if (!difference) { ret writing(l, k); }
    val p: res[*Pairing, Fail] = difference_of(l, k);
    if (sel p.err) { ret res[*Row, Fail].err{absent(l, k, p.err)}; }
    ret res[*Row, Fail].ok{p.ok.plus};
}

# index the rows of a set after one walk over everything it states, refused
# with a defect of mink: a field wider than its container, pieces that
# overlap, a range the field cannot hold, field choices that differ in
# container or can both hold, a choice alignment that is no power of two, a
# held addend field that is missing, unsound or in another container, a
# partner, addend record or rewritten kind with
# no row, a key two reading rows share, a kind two rows write, a kind the set
# does not list, a listed kind that is unsound, shares a name or no row
# writes, a writing row that only reads or whose key reads back as no row,
# as its own kind or from another container, addend or reach, a placing row
# whose addend is not in its field or whose reach its kind's writing row or
# another placing row shares, a rewrite
# whose kinds do not number its span or whose patterns pass the place, a
# difference row whose records have no rows, differ in width or are of a kind
# that is no difference, or whose kind or width another one shares, and a
# vendor set that is itself refused or shares a vendor's name. a lookup is
# only ever built into a registry, which releases it, and nothing is held
# after a refusal
fun build(a: *A.Allocator, s: *Set) res[Lookup, Fail] {
    var l: Lookup    = Lookup{set: s, keys: table.make[*Row](a), kinds: table.make[*Row](a), placed: table.make[*Row](a), pairings: table.make[Pairing](a), pairs_by: table.make[*Pairing](a)};
    val e: err[Fail] = fill(a, ?l);
    if (sel e.err) {
        val c: err[Fail] = release_lookup(?l);
        ret res[Lookup, Fail].err{e.err};
    }
    ret res[Lookup, Fail].ok{l};
}

# give the lookup's tables back
fun release_lookup(l: *Lookup) err[Fail] {
    val c: err[Fail] = table.release[*Row](?l.keys);
    val k: err[Fail] = table.release[*Row](?l.kinds);
    val w: err[Fail] = table.release[*Row](?l.placed);
    val p: err[Fail] = table.release[Pairing](?l.pairings);
    val b: err[Fail] = table.release[*Pairing](?l.pairs_by);
    if (sel c.err) { ret c; }
    if (sel k.err) { ret k; }
    if (sel w.err) { ret w; }
    if (sel p.err) { ret p; }
    ret b;
}

# the position of the row `r` in `s`, for a refusal
fun position(s: *Set, r: *Row) u64 {
    var i: usize = 0;
    for (i < s.count) {
        if (?s.rows[i] == r) { ret i::u64; }
        i = i + 1;
    }
    ret s.count::u64;
}

fun order_listed(a: **Kind, b: **Kind) i64 {
    if (a[0]::u64 < b[0]::u64) { ret -1; }
    if (a[0]::u64 > b[0]::u64) { ret 1; }
    ret 0;
}

fun order_kind_names(a: **Kind, b: **Kind) i64 {
    ret str_compare(a[0].name, b[0].name);
}

fun fill(a: *A.Allocator, l: *Lookup) err[Fail] {
    val s: *Set  = l.set;
    var i: usize = 0;
    for (i < s.count) {
        val e: err[Fail] = indexed(l, ?s.rows[i]);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "relocation row", i::u64)}; }
        val c: res[Id[*Row], Fail] = table.push[*Row](?l.keys, ?s.rows[i]);
        if (sel c.err) { ret err[Fail].err{c.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < s.write_count) {
        val w: *Row = ?s.writes[i];
        if (sel w.write.never) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation writing row only reads"), "relocation writing row", i::u64)}; }
        val e: err[Fail] = indexed(l, w);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "relocation writing row", i::u64)}; }
        i = i + 1;
    }
    val sc: opt[*Row] = index.seal[Row](table.items[*Row](?l.keys), s.count, order_keys);
    if (sel sc.some) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation code has two reading rows"), "relocation row", position(s, sc.some))}; }
    val sk: opt[*Row] = index.seal[Row](table.items[*Row](?l.kinds), table.count[*Row](?l.kinds), order_kinds);
    if (sel sk.some) { ret err[Fail].err{fail.about(fail.internal("relocation kind has two writing rows"), sk.some.kind.name)}; }
    val sp: opt[*Row] = index.seal[Row](table.items[*Row](?l.placed), table.count[*Row](?l.placed), order_placed);
    if (sel sp.some) { ret err[Fail].err{fail.about(fail.internal("two relocation rows place one kind from one reach"), sp.some.name)}; }
    i = 0;
    for (i < s.count) {
        val e: err[Fail] = links(l, ?s.rows[i]);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "relocation row", i::u64)}; }
        i = i + 1;
    }
    i = 0;
    for (i < s.write_count) {
        val e: err[Fail] = links(l, ?s.writes[i]);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "relocation writing row", i::u64)}; }
        val b: err[Fail] = reads_back(l, ?s.writes[i]);
        if (sel b.err) { ret err[Fail].err{fail.in_indexed(b.err, "relocation writing row", i::u64)}; }
        i = i + 1;
    }
    val k: err[Fail] = listed(a, l);
    if (sel k.err) { ret k; }
    val p: err[Fail] = pairings(l);
    if (sel p.err) { ret p; }
    ret vendors(a, s);
}

# every kind the set lists is sound, named once and mapped to by a row, and
# every row's kind is listed
fun listed(a: *A.Allocator, l: *Lookup) err[Fail] {
    var byaddr: Table[*Kind] = table.make[*Kind](a);
    var byname: Table[*Kind] = table.make[*Kind](a);
    val e:      err[Fail]    = listing(l, ?byaddr, ?byname);
    val ra:     err[Fail]    = table.release[*Kind](?byaddr);
    val rn:     err[Fail]    = table.release[*Kind](?byname);
    if (sel e.err)  { ret e; }
    if (sel ra.err) { ret ra; }
    ret rn;
}

fun listing(l: *Lookup, byaddr: *Table[*Kind], byname: *Table[*Kind]) err[Fail] {
    val s: *Set  = l.set;
    var i: usize = 0;
    for (i < s.kind_count) {
        val k: *Kind = s.kinds[i];
        if (k == nil || !reloc.consistent(k)) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation kind is unsound"), "relocation kind", i::u64)}; }
        val m: res[*Row, Fail] = by_kind(l, k);
        if (sel m.err) { ret err[Fail].err{fail.in_indexed(fail.about(fail.internal("relocation kind maps to no row"), k.name), "relocation kind", i::u64)}; }
        val pa: res[Id[*Kind], Fail] = table.push[*Kind](byaddr, k);
        if (sel pa.err) { ret err[Fail].err{pa.err}; }
        val pn: res[Id[*Kind], Fail] = table.push[*Kind](byname, k);
        if (sel pn.err) { ret err[Fail].err{pn.err}; }
        i = i + 1;
    }
    val dup: opt[*Kind] = index.seal[Kind](table.items[*Kind](byaddr), s.kind_count, order_listed);
    if (sel dup.some) { ret err[Fail].err{fail.about(fail.internal("relocation kind is listed twice"), dup.some.name)}; }
    val same: opt[*Kind] = index.seal[Kind](table.items[*Kind](byname), s.kind_count, order_kind_names);
    if (sel same.some) { ret err[Fail].err{fail.about(fail.internal("two relocation kinds share a name"), same.some.name)}; }
    i = 0;
    for (i < s.count) {
        val found: opt[*Kind] = index.find[Kind](table.items[*Kind](byaddr), s.kind_count, s.rows[i].kind, order_listed);
        if (sel found.none) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation row maps to a kind its set does not list"), "relocation row", i::u64)}; }
        i = i + 1;
    }
    i = 0;
    for (i < s.write_count) {
        val found: opt[*Kind] = index.find[Kind](table.items[*Kind](byaddr), s.kind_count, s.writes[i].kind, order_listed);
        if (sel found.none) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation writing row maps to a kind its set does not list"), "relocation writing row", i::u64)}; }
        i = i + 1;
    }
    ret placings(l);
}

# every placing row's reach differs from that of the row that writes its kind
fun placings(l: *Lookup) err[Fail] {
    var i: usize = 0;
    for (i < table.count[*Row](?l.placed)) {
        val p: *Row            = table.items[*Row](?l.placed)[i];
        val w: res[*Row, Fail] = by_kind(l, p.kind);
        if (sel w.err)               { ret err[Fail].err{fail.about(fail.internal("relocation row places a kind no row writes"), p.name)}; }
        if (reach(w.ok) == reach(p)) { ret err[Fail].err{fail.about(fail.internal("relocation row places its kind from the reach of the row that writes it"), p.name)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the row `r` is sound, and is indexed by the kind it writes or places
fun indexed(l: *Lookup, r: *Row) err[Fail] {
    val e: err[Fail] = shapes(r);
    if (sel e.err) { ret e; }
    if (sel r.write.always) {
        val k: res[Id[*Row], Fail] = table.push[*Row](?l.kinds, r);
        if (sel k.err) { ret err[Fail].err{k.err}; }
    }
    or (sel r.write.placed) {
        if (!sel r.addend.field) { ret err[Fail].err{fail.internal("relocation row places a target its field holds no addend for")}; }
        val p: res[Id[*Row], Fail] = table.push[*Row](?l.placed, r);
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    ret err[Fail].ok{};
}

# the writing row `w` writes a key a row reads as another kind, from the same
# container, with its addend in the same place and counted from the same
# point, so what it writes reads back
fun reads_back(l: *Lookup, w: *Row) err[Fail] {
    val m: res[*Row, Fail] = by_key(l, w.key);
    if (sel m.err) { ret err[Fail].err{fail.about(fail.internal("relocation writing row writes a key no row reads"), w.name)}; }
    val r: *Row = m.ok;
    if (r.kind == w.kind)                       { ret err[Fail].err{fail.about(fail.internal("relocation writing row writes the kind its key reads as"), w.name)}; }
    if (container(r) != container(w))           { ret err[Fail].err{fail.about(fail.internal("relocation writing row differs in container from the row its key reads"), w.name)}; }
    if (!same_addend(r, w))                     { ret err[Fail].err{fail.about(fail.internal("relocation writing row keeps its addend apart from the row its key reads"), w.name)}; }
    if (r.bias != w.bias || r.trail != w.trail) { ret err[Fail].err{fail.about(fail.internal("relocation writing row counts its addend from another point than the row its key reads"), w.name)}; }
    ret err[Fail].ok{};
}

# whether `a` and `b` keep their addends in the same place
fun same_addend(a: *Row, b: *Row) bool {
    if (sel a.addend.field)   { ret sel b.addend.field; }
    if (sel a.addend.record)  { ret sel b.addend.record; }
    if (sel a.addend.none)    { ret sel b.addend.none; }
    if (sel a.addend.partner) { ret sel b.addend.partner; }
    ret sel b.addend.held;
}

# every vendor set is sound and every vendor named once
fun vendors(a: *A.Allocator, s: *Set) err[Fail] {
    var i: usize = 0;
    for (i < s.vendor_count) {
        val v: *Vendor = ?s.vendors[i];
        var j: usize   = 0;
        for (j < i) {
            if (str_compare(s.vendors[j].symbol, v.symbol) == 0) { ret err[Fail].err{fail.in_indexed(fail.internal("two vendor sets share a vendor"), "vendor set", i::u64)}; }
            j = j + 1;
        }
        val b: res[Lookup, Fail] = build(a, v.set);
        if (sel b.err) { ret err[Fail].err{fail.in_indexed(b.err, "vendor set", i::u64)}; }
        var built: Lookup    = b.ok;
        val r:     err[Fail] = release_lookup(?built);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# index the difference rows of the set by width and by kind
fun pairings(l: *Lookup) err[Fail] {
    val s: *Set      = l.set;
    val r: err[Fail] = table.reserve[Pairing](?l.pairings, s.difference_count);
    if (sel r.err) { ret r; }
    var i: usize = 0;
    for (i < s.difference_count) {
        val p: res[Pairing, Fail] = pairing(l, ?s.differences[i]);
        if (sel p.err) { ret err[Fail].err{fail.in_indexed(p.err, "difference row", i::u64)}; }
        val pushed: res[Id[Pairing], Fail] = table.push[Pairing](?l.pairings, p.ok);
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        i = i + 1;
    }
    val n: usize = s.difference_count;
    sort.sort_by[Pairing](table.items[Pairing](?l.pairings), n, order_bits);
    i = 0;
    for (i < n) {
        val at: *Pairing = table.at[Pairing](?l.pairings, table.nth[Pairing](i));
        if (i > 0 && table.at[Pairing](?l.pairings, table.nth[Pairing](i - 1)).bits == at.bits) {
            ret err[Fail].err{fail.in_record(fail.internal("two difference rows share a width"), "difference row")};
        }
        val k: res[Id[*Pairing], Fail] = table.push[*Pairing](?l.pairs_by, at);
        if (sel k.err) { ret err[Fail].err{k.err}; }
        i = i + 1;
    }
    val dup: opt[*Pairing] = index.seal[Pairing](table.items[*Pairing](?l.pairs_by), n, order_pairing_kinds);
    if (sel dup.some) { ret err[Fail].err{fail.in_record(fail.internal("two difference rows share a kind"), "difference row")}; }
    ret err[Fail].ok{};
}

fun pairing(l: *Lookup, d: *Difference) res[Pairing, Fail] {
    if (!reloc.has(d.kind, reloc.DIFF)) { ret res[Pairing, Fail].err{fail.internal("difference row is of a kind that is no difference")}; }
    val plus: res[*Row, Fail] = by_key(l, d.plus);
    if (sel plus.err) { ret res[Pairing, Fail].err{fail.internal("difference row adds with a record that has no row")}; }
    val minus: res[*Row, Fail] = by_key(l, d.minus);
    if (sel minus.err) { ret res[Pairing, Fail].err{fail.internal("difference row subtracts with a record that has no row")}; }
    val bits: u32 = field.width(plus.ok.fields[0].field);
    if (bits == 0 || field.width(minus.ok.fields[0].field) != bits) {
        ret res[Pairing, Fail].err{fail.internal("difference row's records differ in width")};
    }
    ret res[Pairing, Fail].ok{Pairing{difference: d, plus: plus.ok, minus: minus.ok, bits: bits}};
}

# every field choice of `r` is sound, the choices share their container,
# and no two can both hold
fun shapes(r: *Row) err[Fail] {
    if (r.field_count == 0 || r.fields == nil) { ret err[Fail].err{fail.internal("relocation row has no field")}; }
    if (r.bias != 0 && sel r.addend.none)      { ret err[Fail].err{fail.internal("relocation row biases an addend it does not have")}; }
    var i: usize = 0;
    for (i < r.field_count) {
        val c: *FieldChoice = ?r.fields[i];
        val e: err[Fail]    = shape(c.field, r.range);
        if (sel e.err)                                                     { ret e; }
        if ((c.insn_value & ~c.insn_mask) != 0)                            { ret err[Fail].err{fail.internal("relocation field choice holds bits it does not read")}; }
        if (c.field.bytes != r.fields[0].field.bytes)                      { ret err[Fail].err{fail.internal("relocation field choices differ in container")}; }
        if (c.insn_mask != 0 && (c.field.bytes > 8 || c.field.bytes == 0)) { ret err[Fail].err{fail.internal("relocation field choice reads no instruction")}; }
        if ((c.align & (c.align - 1)) != 0)                                { ret err[Fail].err{fail.internal("relocation field choice alignment is not a power of two")}; }
        var j: usize = 0;
        for (j < i) {
            val d:    *FieldChoice = ?r.fields[j];
            val both: u64          = c.insn_mask & d.insn_mask;
            if (((c.insn_value ^ d.insn_value) & both) == 0) { ret err[Fail].err{fail.internal("two relocation field choices can both hold")}; }
            j = j + 1;
        }
        i = i + 1;
    }
    if (sel r.addend.held) {
        val h: *Field = r.addend.held;
        if (h == nil)                           { ret err[Fail].err{fail.internal("relocation addend field is missing")}; }
        if (h.bytes != r.fields[0].field.bytes) { ret err[Fail].err{fail.internal("relocation addend field differs from the value's in container")}; }
        ret shape(h, held_range(h));
    }
    ret err[Fail].ok{};
}

# the range of an addend held in the field `f`: a signed byte count as wide
# as the field holds with its sign, in steps of the bits it shifts out
pub fun held_range(f: *Field) Range {
    var bits: u32 = field.width(f) + f.shift::u32;
    if (sel f.sign.some) { bits = bits + 1; }
    ret Range{check: field.Check.signed{}, bits: bits::u8, align: (1::u64) << f.shift::u64};
}

fun shape(f: *Field, g: Range) err[Fail] {
    if (f.bytes > field.MAX_BYTES) { ret err[Fail].err{fail.internal("relocation field container is too wide")}; }
    val bits: u32 = f.bytes::u32 * 8;
    var i:    u8  = 0;
    for (i < f.count) {
        val p: *Piece = ?f.pieces[i];
        if (p.width == 0 || p.at::u32 + p.width::u32 > bits) {
            ret err[Fail].err{fail.internal("relocation field is wider than its container")};
        }
        var j: u8 = 0;
        for (j < i) {
            val q: *Piece = ?f.pieces[j];
            if (p.at < q.at + q.width && q.at < p.at + p.width) {
                ret err[Fail].err{fail.internal("relocation field bit ranges overlap")};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    if (f.split != 0 && (f.shift != 0 || f.round || f.split::u32 >= field.width(f))) {
        ret err[Fail].err{fail.internal("relocation field splits a value it also shifts or has no upper half")};
    }
    if (f.run) {
        if (f.count != f.bytes) { ret err[Fail].err{fail.internal("relocation run has a piece short of a byte")}; }
        var k: u8 = 0;
        for (k < f.count) {
            if (f.pieces[k].at != k * 8 || f.pieces[k].width != 7) {
                ret err[Fail].err{fail.internal("relocation run piece is not the low seven bits of its byte")};
            }
            k = k + 1;
        }
    }
    var extra: u32 = 0;
    if (sel f.sign.some) {
        val sg: field.Sign = f.sign.some;
        if (sg.width == 0 || sg.at::u32 + sg.width::u32 > bits) {
            ret err[Fail].err{fail.internal("relocation sign bits are wider than the container")};
        }
        var k: u8 = 0;
        for (k < f.count) {
            val p: *Piece = ?f.pieces[k];
            if (sg.at < p.at + p.width && p.at < sg.at + sg.width) {
                ret err[Fail].err{fail.internal("relocation sign bits overlap the field")};
            }
            k = k + 1;
        }
        extra = 1;
    }
    if (g.align == 0 || (g.align & (g.align - 1)) != 0) {
        ret err[Fail].err{fail.internal("relocation alignment is not a power of two")};
    }
    if (sel g.check.wrap) { ret err[Fail].ok{}; }
    if (g.bits == 0 || g.bits > 64 || g.bits::u32 > f.shift::u32 + field.width(f) + extra) {
        ret err[Fail].err{fail.internal("relocation range does not fit its field")};
    }
    ret err[Fail].ok{};
}

fun links(l: *Lookup, r: *Row) err[Fail] {
    if (sel r.pair.some) {
        val p: PairRule = r.pair.some;
        var k: usize    = 0;
        for (k < p.count) {
            val m: res[*Row, Fail] = by_key(l, p.keys[k]);
            if (sel m.err) { ret err[Fail].err{fail.internal("relocation partner has no row")}; }
            k = k + 1;
        }
    }
    if (sel r.addend.partner) {
        val p: Keys  = r.addend.partner;
        var k: usize = 0;
        for (k < p.count) {
            val m: res[*Row, Fail] = by_key(l, p.keys[k]);
            if (sel m.err) { ret err[Fail].err{fail.internal("relocation addend record has no row")}; }
            k = k + 1;
        }
    }
    var i: usize = 0;
    for (i < r.rewrite_count) {
        val e: err[Fail] = rewritten(l, r.rewrites[i]);
        if (sel e.err) { ret err[Fail].err{fail.about(e.err, r.rewrites[i].name)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the rewrite `w` names a row for every kind it rewrites to, one per record
# it consumes, and its patterns and deleted bytes are bounded
fun rewritten(l: *Lookup, w: *Rewrite) err[Fail] {
    if (w.kind_count != w.span::usize + 1) { ret err[Fail].err{fail.internal("rewrite's kinds do not number the records it consumes")}; }
    var k: usize = 0;
    for (k < w.kind_count) {
        val m: res[*Row, Fail] = by_kind(l, w.kinds[k]);
        if (sel m.err) { ret err[Fail].err{fail.internal("rewritten relocation has no row")}; }
        k = k + 1;
    }
    var p: usize = 0;
    for (p < w.match_count) {
        val x: *InsnPattern = ?w.match[p];
        if (x.len == 0 || x.len > 8 || (x.value & ~x.mask) != 0) { ret err[Fail].err{fail.internal("rewrite pattern is malformed")}; }
        p = p + 1;
    }
    if (sel w.emit.delete && w.emit.delete.len == 0) { ret err[Fail].err{fail.internal("rewrite deletes no byte")}; }
    if (sel w.emit.bytes) {
        val b: Bytes = w.emit.bytes;
        if (b.len != 0 && b.data == nil) { ret err[Fail].err{fail.internal("rewrite template holds no bytes")}; }
    }
    ret err[Fail].ok{};
}

# whether the set of `l` accounts for every neutral kind: the one row that
# writes it or a difference row maps it, or exactly one refusal states why the
# pair has no form for it and names its source. a refusal of a kind that is no
# neutral kind, or of one a row maps, is a defect of mink. the lookup's build
# has refused a set where a key reads as two kinds, two rows write one kind or
# a written key reads back as no row, so a mapped neutral kind is written by
# exactly one key that reads back as exactly one kind
pub fun accounts(l: *Lookup) err[Fail] {
    val s: *Set  = l.set;
    var i: usize = 0;
    for (i < s.refusal_count) {
        val f: *Refusal = ?s.refusals[i];
        if (f.why == nil || f.source == nil || str_len(f.why) == 0 || str_len(f.source) == 0) { ret err[Fail].err{fail.in_indexed(fail.internal("relocation refusal states no reason or no source"), "relocation refusal", i::u64)}; }
        if (!neutral(f.kind))                                                                 { ret err[Fail].err{fail.in_indexed(fail.internal("relocation refusal names no neutral kind"), "relocation refusal", i::u64)}; }
        i = i + 1;
    }
    i = 0;
    for (i < reloc.NEUTRAL_COUNT) {
        val k:       *Kind               = reloc.NEUTRAL[i];
        val own:     res[*Row, Fail]     = by_kind(l, k);
        val pairing: res[*Pairing, Fail] = difference_of(l, k);
        val mapped:  bool                = sel own.ok || sel pairing.ok;
        val refused: usize               = refusals_of(s, k);
        if (refused > 1)             { ret err[Fail].err{fail.about(fail.internal("neutral relocation kind is refused twice"), k.name)}; }
        if (mapped && refused != 0)  { ret err[Fail].err{fail.about(fail.internal("neutral relocation kind is both mapped and refused"), k.name)}; }
        if (!mapped && refused == 0) { ret err[Fail].err{fail.about(fail.internal("neutral relocation kind is neither mapped nor refused"), k.name)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun neutral(k: *Kind) bool {
    var i: usize = 0;
    for (i < reloc.NEUTRAL_COUNT) {
        if (reloc.NEUTRAL[i] == k) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun refusals_of(s: *Set, k: *Kind) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < s.refusal_count) {
        if (s.refusals[i].kind == k) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun order_pairs(a: **Lookup, b: **Lookup) i64 {
    val f: i64 = str_compare(a[0].set.format.name, b[0].set.format.name);
    if (f != 0) { ret f; }
    ret str_compare(a[0].set.arch.name, b[0].set.arch.name);
}

# the sets of every (format, architecture) pair, one set per pair
# ---
# lookups: the indexed sets, in the order registered
# pairs:   the pairs ascending by format name, then architecture name
pub rec Registry {
    lookups: Table[Lookup];
    pairs:   Table[*Lookup];
}

# a registry of the `count` sets at `sets`, refused when a set is malformed or
# two sets bind one pair. the registry is released with `release`
pub fun make(a: *A.Allocator, sets: **Set, count: usize) res[Registry, Fail] {
    var g: Registry  = Registry{lookups: table.make[Lookup](a), pairs: table.make[*Lookup](a)};
    val e: err[Fail] = admit(a, ?g, sets, count);
    if (sel e.err) {
        val c: err[Fail] = release(?g);
        ret res[Registry, Fail].err{e.err};
    }
    ret res[Registry, Fail].ok{g};
}

fun admit(a: *A.Allocator, g: *Registry, sets: **Set, count: usize) err[Fail] {
    val r: err[Fail] = table.reserve[Lookup](?g.lookups, count);
    if (sel r.err) { ret r; }
    val q: err[Fail] = table.reserve[*Lookup](?g.pairs, count);
    if (sel q.err) { ret q; }
    var i: usize = 0;
    for (i < count) {
        val l: res[Lookup, Fail] = build(a, sets[i]);
        if (sel l.err) { ret err[Fail].err{l.err}; }
        val p: res[Id[Lookup], Fail] = table.push[Lookup](?g.lookups, l.ok);
        if (sel p.err) {
            val c: err[Fail] = release_lookup(?l.ok);
            ret err[Fail].err{p.err};
        }
        val k: res[Id[*Lookup], Fail] = table.push[*Lookup](?g.pairs, table.at[Lookup](?g.lookups, p.ok));
        if (sel k.err) { ret err[Fail].err{k.err}; }
        i = i + 1;
    }
    val dup: opt[*Lookup] = index.seal[Lookup](table.items[*Lookup](?g.pairs), count, order_pairs);
    if (sel dup.some) {
        ret err[Fail].err{fail.in_record(fail.internal("two relocation sets bind one pair"), dup.some.set.format.name)};
    }
    ret err[Fail].ok{};
}

# give the registry's lookups back
pub fun release(g: *Registry) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    val items: *Lookup   = table.items[Lookup](?g.lookups);
    var i:     usize     = 0;
    for (i < table.count[Lookup](?g.lookups)) {
        val e: err[Fail] = release_lookup(?items[i]);
        if (sel first.ok && sel e.err) { first = e; }
        i = i + 1;
    }
    val l: err[Fail] = table.release[Lookup](?g.lookups);
    val p: err[Fail] = table.release[*Lookup](?g.pairs);
    if (sel first.err) { ret first; }
    if (sel l.err)     { ret l; }
    ret p;
}

# the lookup of the pair (`f`, `a`)
pub fun find(g: *Registry, f: *Format, a: *Arch) res[*Lookup, Fail] {
    var set:   Set          = Set{format: f, arch: a};
    var probe: Lookup       = Lookup{set: ?set};
    val got:   opt[*Lookup] = index.find[Lookup](table.items[*Lookup](?g.pairs), table.count[*Lookup](?g.pairs), ?probe, order_pairs);
    if (sel got.none) { ret res[*Lookup, Fail].err{fail.unsupported("no relocation set for this format and architecture")}; }
    ret res[*Lookup, Fail].ok{got.some};
}

val WORD_PIECES: [1]Piece       = [1]Piece{Piece{at: 0, width: 32}};
val WORD:        Field          = Field{bytes: 4, pieces: ?WORD_PIECES[0], count: 1};
val WORD_ONLY:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?WORD}};
val WIDE_PIECES: [1]Piece       = [1]Piece{Piece{at: 4, width: 32}};
val WIDE:        Field          = Field{bytes: 4, pieces: ?WIDE_PIECES[0], count: 1};
val WIDE_ONLY:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?WIDE}};
val OVER_PIECES: [2]Piece       = [2]Piece{Piece{at: 0, width: 16}, Piece{at: 8, width: 16}};
val OVER:        Field          = Field{bytes: 4, pieces: ?OVER_PIECES[0], count: 2};
val OVER_ONLY:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?OVER}};
val HALF_PIECES: [1]Piece       = [1]Piece{Piece{at: 0, width: 16}};
val HALF:        Field          = Field{bytes: 4, pieces: ?HALF_PIECES[0], count: 1};
# two forms told apart by bit 31, and two that can both hold
val FORMS: [2]FieldChoice = [2]FieldChoice{
    FieldChoice{insn_mask: 0x8000_0000, insn_value: 0, field: ?WORD},
    FieldChoice{insn_mask: 0x8000_0000, insn_value: 0x8000_0000, field: ?HALF},
};
val CLASH: [2]FieldChoice = [2]FieldChoice{
    FieldChoice{insn_mask: 0x8000_0000, insn_value: 0, field: ?WORD},
    FieldChoice{insn_mask: 0x4000_0000, insn_value: 0, field: ?HALF},
};
val HIGH:    [1]u32 = [1]u32{1};
val MISSING: [1]u32 = [1]u32{9};

val SIGNED32: Range = Range{check: field.Check.signed{}, bits: 32, align: 1};

val HI_KIND: Kind = Kind{name: "hi", caps: reloc.PC, takes: ?reloc.NAMED};
val LO_KIND: Kind = Kind{name: "lo", caps: reloc.PC | reloc.PARTNER, takes: ?reloc.NAMED};
val TWIN:    Kind = Kind{name: "pc32", caps: reloc.PC, takes: ?reloc.NAMED};

val TO_HI_KINDS:  [1]*Kind    = [1]*Kind{?HI_KIND};
val TO_HI:        Rewrite     = Rewrite{name: "to hi", emit: Emit.bytes{Bytes{}}, kinds: ?TO_HI_KINDS[0], kind_count: 1};
val TO_HI_ONLY:   [1]*Rewrite = [1]*Rewrite{?TO_HI};
val SPANNED:      Rewrite     = Rewrite{name: "spanned", span: 1, emit: Emit.bytes{Bytes{}}, kinds: ?TO_HI_KINDS[0], kind_count: 1};
val SPANNED_ONLY: [1]*Rewrite = [1]*Rewrite{?SPANNED};

val GOOD: [3]Row = [3]Row{
    Row{key: 1, name: "hi", kind: ?HI_KIND, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32},
    Row{
        key:         2,
        name:        "lo",
        kind:        ?LO_KIND,
        fields:      ?WORD_ONLY[0],
        field_count: 1,
        value:       ?compute.PC,
        range:       SIGNED32,
        addend:      Addend.record{},
        pair:        opt[PairRule].some{PairRule{link: Link.label{}, keys: ?HIGH[0], count: 1, role: Role.hi_part{}}},
    },
    Row{
        key:           3,
        name:          "pc",
        kind:          ?reloc.PC32,
        fields:        ?FORMS[0],
        field_count:   2,
        value:         ?compute.PC,
        range:         Range{check: field.Check.signed{}, bits: 16, align: 1},
        rewrites:      ?TO_HI_ONLY[0],
        rewrite_count: 1,
    },
};
val GOOD_KINDS: [3]*Kind = [3]*Kind{?HI_KIND, ?LO_KIND, ?reloc.PC32};

val TOO_WIDE: [1]Row = [1]Row{
    Row{key: 1, name: "wide", kind: ?reloc.PC32, fields: ?WIDE_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32},
};
val OVERLAP: [1]Row = [1]Row{
    Row{key: 1, name: "over", kind: ?reloc.PC32, fields: ?OVER_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32},
};
val ALONE: [1]Row = [1]Row{
    Row{
        key:         1,
        name:        "alone",
        kind:        ?LO_KIND,
        fields:      ?WORD_ONLY[0],
        field_count: 1,
        value:       ?compute.PC,
        range:       SIGNED32,
        pair:        opt[PairRule].some{PairRule{link: Link.label{}, keys: ?MISSING[0], count: 1, role: Role.hi_part{}}},
    },
};
val TWICE: [2]Row = [2]Row{
    Row{key: 1, name: "one", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32},
    Row{key: 1, name: "two", kind: ?reloc.ABS32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.ABS, range: SIGNED32},
};
val SAME_KIND: [2]Row = [2]Row{
    Row{key: 1, name: "one", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32},
    Row{key: 2, name: "two", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32},
};
val CLASHING: [1]Row = [1]Row{
    Row{key: 1, name: "clash", kind: ?reloc.PC32, fields: ?CLASH[0], field_count: 2, value: ?compute.PC, range: Range{check: field.Check.signed{}, bits: 16, align: 1}},
};
val SPANS: [2]Row = [2]Row{
    Row{key: 1, name: "hi", kind: ?HI_KIND, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32},
    Row{key: 2, name: "pc", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32, rewrites: ?SPANNED_ONLY[0], rewrite_count: 1},
};
val PC_ONLY:  [1]*Kind = [1]*Kind{?reloc.PC32};
val PC_ABS:   [2]*Kind = [2]*Kind{?reloc.PC32, ?reloc.ABS32};
val HI_PC:    [2]*Kind = [2]*Kind{?HI_KIND, ?reloc.PC32};
val NAMESAKE: [2]*Kind = [2]*Kind{?reloc.PC32, ?TWIN};
val ONE_ROW:  [1]Row   = [1]Row{
    Row{key: 1, name: "one", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32},
};
val TWIN_ROWS: [2]Row = [2]Row{
    Row{key: 1, name: "one", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32},
    Row{key: 2, name: "two", kind: ?TWIN, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32},
};

val AFTER_FIELD: Addend = Addend.field{};
val DIRECTED:    [5]Row = [5]Row{
    Row{key: 1, name: "near", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32, addend: AFTER_FIELD, bias: -4},
    Row{key: 2, name: "far1", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32, addend: AFTER_FIELD, bias: -4, trail: 1, write: Write.placed{}},
    Row{key: 3, name: "far4", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32, addend: AFTER_FIELD, bias: -4, trail: 4, write: Write.placed{}},
    Row{key: 5, name: "abs", kind: ?reloc.ABS32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.ABS, range: Range{check: field.Check.unsigned{}, bits: 32, align: 1}, addend: AFTER_FIELD},
    Row{key: 6, name: "abs old", kind: ?reloc.ABS32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.ABS, range: SIGNED32, addend: AFTER_FIELD, write: Write.never{}},
};
val DIRECTED_WRITES: [2]Row = [2]Row{
    Row{key: 5, name: "abs signed", kind: ?reloc.ABS32S, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.ABS, range: SIGNED32, addend: AFTER_FIELD},
    Row{key: 1, name: "near call", kind: ?reloc.BRANCH32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PLT, range: SIGNED32, addend: AFTER_FIELD, bias: -4},
};
val DIRECTED_KINDS: [4]*Kind = [4]*Kind{?reloc.PC32, ?reloc.ABS32, ?reloc.ABS32S, ?reloc.BRANCH32};
# a writing row whose key no row reads, one that only reads, one counting
# from another point, one writing the kind its key reads, two placing rows of
# one reach, and a placing row of its writing row's reach
val STRAY_WRITE:   [1]Row = [1]Row{Row{key: 9, name: "stray", kind: ?reloc.ABS32S, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.ABS, range: SIGNED32, addend: AFTER_FIELD}};
val READING_WRITE: [1]Row = [1]Row{Row{key: 5, name: "reads", kind: ?reloc.ABS32S, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.ABS, range: SIGNED32, addend: AFTER_FIELD, write: Write.never{}}};
val BIASED_WRITE:  [1]Row = [1]Row{Row{key: 5, name: "biased", kind: ?reloc.ABS32S, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.ABS, range: SIGNED32, addend: AFTER_FIELD, bias: -4}};
val OWN_WRITE:     [1]Row = [1]Row{Row{key: 1, name: "own", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32, addend: AFTER_FIELD, bias: -4}};
val UNWRITTEN:     [2]Row = [2]Row{
    Row{key: 1, name: "near", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32, addend: AFTER_FIELD, bias: -4},
    Row{key: 6, name: "abs old", kind: ?reloc.ABS32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.ABS, range: SIGNED32, addend: AFTER_FIELD, write: Write.never{}},
};
val UNWRITTEN_KINDS: [2]*Kind = [2]*Kind{?reloc.PC32, ?reloc.ABS32};
val TWO_PLACED:      [3]Row   = [3]Row{
    Row{key: 1, name: "near", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32, addend: AFTER_FIELD, bias: -4},
    Row{key: 2, name: "far1", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32, addend: AFTER_FIELD, bias: -4, trail: 1, write: Write.placed{}},
    Row{key: 3, name: "far1 again", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32, addend: AFTER_FIELD, bias: -4, trail: 1, write: Write.placed{}},
};
val SAME_REACH: [2]Row = [2]Row{
    Row{key: 1, name: "near", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32, addend: AFTER_FIELD, bias: -4},
    Row{key: 2, name: "near again", kind: ?reloc.PC32, fields: ?WORD_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32, addend: AFTER_FIELD, bias: -4, write: Write.placed{}},
};

val GOOD_SET:       Set       = Set{format: ?format.ELF, arch: ?x86.X86_64, rows: ?GOOD[0], count: 3, kinds: ?GOOD_KINDS[0], kind_count: 3};
val TOO_WIDE_SET:   Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?TOO_WIDE[0], count: 1, kinds: ?PC_ONLY[0], kind_count: 1};
val OVERLAP_SET:    Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?OVERLAP[0], count: 1, kinds: ?PC_ONLY[0], kind_count: 1};
val ALONE_SET:      Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?ALONE[0], count: 1, kinds: ?GOOD_KINDS[1], kind_count: 1};
val TWICE_SET:      Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?TWICE[0], count: 2, kinds: ?PC_ABS[0], kind_count: 2};
val SAME_KIND_SET:  Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?SAME_KIND[0], count: 2, kinds: ?PC_ONLY[0], kind_count: 1};
val CLASH_SET:      Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?CLASHING[0], count: 1, kinds: ?PC_ONLY[0], kind_count: 1};
val SPAN_SET:       Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?SPANS[0], count: 2, kinds: ?HI_PC[0], kind_count: 2};
val UNLISTED_SET:   Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?ONE_ROW[0], count: 1};
val UNMAPPED_SET:   Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?ONE_ROW[0], count: 1, kinds: ?PC_ABS[0], kind_count: 2};
val NAMESAKE_SET:   Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?TWIN_ROWS[0], count: 2, kinds: ?NAMESAKE[0], kind_count: 2};
val DIRECTED_SET:   Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?DIRECTED[0], count: 5, kinds: ?DIRECTED_KINDS[0], kind_count: 4, writes: ?DIRECTED_WRITES[0], write_count: 2};
val STRAY_SET:      Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?DIRECTED[0], count: 5, kinds: ?DIRECTED_KINDS[0], kind_count: 3, writes: ?STRAY_WRITE[0], write_count: 1};
val READING_SET:    Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?DIRECTED[0], count: 5, kinds: ?DIRECTED_KINDS[0], kind_count: 3, writes: ?READING_WRITE[0], write_count: 1};
val BIASED_SET:     Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?DIRECTED[0], count: 5, kinds: ?DIRECTED_KINDS[0], kind_count: 3, writes: ?BIASED_WRITE[0], write_count: 1};
val OWN_SET:        Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?DIRECTED[0], count: 5, kinds: ?DIRECTED_KINDS[0], kind_count: 2, writes: ?OWN_WRITE[0], write_count: 1};
val UNWRITTEN_SET:  Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?UNWRITTEN[0], count: 2, kinds: ?UNWRITTEN_KINDS[0], kind_count: 2};
val TWO_PLACED_SET: Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?TWO_PLACED[0], count: 3, kinds: ?PC_ONLY[0], kind_count: 1};
val SAME_REACH_SET: Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?SAME_REACH[0], count: 2, kinds: ?PC_ONLY[0], kind_count: 1};
val VENDORS:        [2]Vendor = [2]Vendor{Vendor{symbol: "acme", set: ?GOOD_SET}, Vendor{symbol: "acme", set: ?GOOD_SET}};
val VENDOR_SET:     Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?ONE_ROW[0], count: 1, kinds: ?PC_ONLY[0], kind_count: 1, vendors: ?VENDORS[0], vendor_count: 1};
val TWO_VENDORS:    Set       = Set{format: ?format.COFF, arch: ?x86.X86_64, rows: ?ONE_ROW[0], count: 1, kinds: ?PC_ONLY[0], kind_count: 1, vendors: ?VENDORS[0], vendor_count: 2};

test row__format_half_maps_both_ways {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    val built: res[Lookup, Fail] = build(testing.allocator_of(?t), ?GOOD_SET);
    if (sel built.err) { ret 1; }
    var l: Lookup = built.ok;
    var i: usize  = 0;
    for (i < GOOD_SET.count) {
        val r: *Row            = ?GOOD[i];
        val c: res[*Row, Fail] = by_key(?l, r.key);
        if (sel c.err) { ret 1; }
        if (c.ok != r) { ret 1; }
        val k: res[*Row, Fail] = by_kind(?l, r.kind);
        if (sel k.err) { ret 1; }
        if (k.ok != r) { ret 1; }
        i = i + 1;
    }
    val key: res[*Row, Fail] = by_key(?l, 4);
    if (sel key.ok)                     { ret 1; }
    if (!sel key.err.cause.unsupported) { ret 1; }
    val kind: res[*Row, Fail] = by_kind(?l, ?reloc.ABS64);
    if (sel kind.ok)                                                       { ret 1; }
    if (!chosen(?FORMS[1], 0x8000_1234) || chosen(?FORMS[0], 0x8000_1234)) { ret 1; }
    val freed: err[Fail] = release_lookup(?l);
    if (sel freed.err)               { ret 1; }
    if (testing.live_count(?t) != 0) { ret 1; }
    testing.dnit(?t);
    ret 0;
}

test row__one_walk_refuses_every_malformed_part_of_a_set {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = testing.allocator_of(?t);

    val good: [2]*Set             = [2]*Set{?GOOD_SET, ?VENDOR_SET};
    val reg:  res[Registry, Fail] = make(a, ?good[0], 2);
    if (sel reg.err) { ret 1; }
    var g:     Registry           = reg.ok;
    val found: res[*Lookup, Fail] = find(?g, ?format.ELF, ?x86.X86_64);
    if (sel found.err)             { ret 1; }
    if (found.ok.set != ?GOOD_SET) { ret 1; }
    val miss: res[*Lookup, Fail] = find(?g, ?format.MACHO, ?x86.X86_64);
    if (sel miss.ok) { ret 1; }
    val freed: err[Fail] = release(?g);
    if (sel freed.err) { ret 1; }

    val bad: [18]*Set = [18]*Set{
        ?TOO_WIDE_SET, ?OVERLAP_SET, ?ALONE_SET, ?TWICE_SET, ?SAME_KIND_SET, ?CLASH_SET, ?SPAN_SET, ?UNLISTED_SET,
        ?UNMAPPED_SET, ?NAMESAKE_SET, ?TWO_VENDORS, ?STRAY_SET, ?READING_SET, ?BIASED_SET, ?OWN_SET, ?TWO_PLACED_SET,
        ?SAME_REACH_SET, ?UNWRITTEN_SET,
    };
    var i: usize = 0;
    for (i < 18) {
        val r: res[Registry, Fail] = make(a, ?bad[i], 1);
        if (sel r.ok)                  { ret 2; }
        if (!sel r.err.cause.internal) { ret 3; }
        i = i + 1;
    }
    val pair: [2]*Set             = [2]*Set{?GOOD_SET, ?GOOD_SET};
    val both: res[Registry, Fail] = make(a, ?pair[0], 2);
    if (sel both.ok)                 { ret 4; }
    if (testing.live_count(?t) != 0) { ret 5; }
    testing.dnit(?t);
    ret 0;
}

# the kind a key reads as
fun read_as(l: *Lookup, key: u32) *Kind {
    val r: res[*Row, Fail] = by_key(l, key);
    if (sel r.err) { ret nil; }
    ret r.ok.kind;
}

# the key of the row that writes `k`, or of the row placing it for addend `a`
fun written_as(l: *Lookup, k: *Kind, placed: bool, a: i64) u32 {
    val r: res[*Row, Fail] = by_kind(l, k);
    if (sel r.err) { ret 0; }
    if (!placed)   { ret r.ok.key; }
    ret placing(l, r.ok, a).key;
}

test row__a_key_reads_one_kind_and_one_row_writes_each_kind {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    val built: res[Lookup, Fail] = build(testing.allocator_of(?t), ?DIRECTED_SET);
    if (sel built.err) { ret 1; }
    var l: Lookup = built.ok;
    # a key read by several kinds reads back as its own, the others' rows
    # write it with their own range
    if (read_as(?l, 1) != ?reloc.PC32 || read_as(?l, 2) != ?reloc.PC32 || read_as(?l, 3) != ?reloc.PC32) { ret 2; }
    if (read_as(?l, 5) != ?reloc.ABS32 || read_as(?l, 6) != ?reloc.ABS32)                                { ret 2; }
    if (written_as(?l, ?reloc.PC32, false, 0) != 1 || written_as(?l, ?reloc.BRANCH32, false, 0) != 1)    { ret 3; }
    if (written_as(?l, ?reloc.ABS32, false, 0) != 5 || written_as(?l, ?reloc.ABS32S, false, 0) != 5)     { ret 3; }
    val signed: res[*Row, Fail] = by_kind(?l, ?reloc.ABS32S);
    if (sel signed.err)                    { ret 3; }
    if (!sel signed.ok.range.check.signed) { ret 3; }
    # a target named by its section is counted from the greatest reach not
    # above its addend, from the least below every reach, and a kind no row
    # places is written by its own row
    if (written_as(?l, ?reloc.PC32, true, 8) != 1 || written_as(?l, ?reloc.PC32, true, -4) != 1)  { ret 4; }
    if (written_as(?l, ?reloc.PC32, true, -5) != 2 || written_as(?l, ?reloc.PC32, true, -6) != 3) { ret 4; }
    if (written_as(?l, ?reloc.PC32, true, -8) != 3 || written_as(?l, ?reloc.PC32, true, -9) != 3) { ret 4; }
    if (written_as(?l, ?reloc.ABS32, true, -9) != 5)                                              { ret 4; }
    val freed: err[Fail] = release_lookup(?l);
    if (sel freed.err)               { ret 6; }
    if (testing.live_count(?t) != 0) { ret 6; }
    testing.dnit(?t);
    ret 0;
}
