# the value computations of relocations
#
# a row of a relocation table names the computation that gives its value, a
# member of this table. a computation reads the addresses of one relocation
# and gives an exact value, wider than any field, that the engine then holds
# to the field's range. a new computation is a new member, never a branch.

use std.types.bool.bool;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.fail;
use mink.fail.Fail;

# the addresses and numbers one relocation is computed from
# ---
# s:       the target's address
# a:       the addend
# p:       the place's address
# b:       the subtracted symbol's address
# g:       the address of the target's GOT entry
# got:     the GOT's address
# l:       the address of the target's PLT entry or stub
# base:    the image base
# section: the address of the target's section
# index:   the target's index in its section table or index space
# tp:      the address thread pointer offsets count from
# dtp:     the address dynamic thread vector offsets count from
# page:    the page granule of page computations, a power of two
# z:       the size of the target symbol
# cur:     the value the field holds before the relocation, as the forms that
#          add to or subtract from it read it
# partner: the value the relocation's partner computed, as a split low half
#          takes it from its upper half
pub rec Inputs {
    s:       u64;
    a:       i64;
    p:       u64;
    b:       u64;
    g:       u64;
    got:     u64;
    l:       u64;
    base:    u64;
    section: u64;
    index:   u64;
    tp:      u64;
    dtp:     u64;
    page:    u64;
    z:       u64;
    cur:     i64;
    partner: i64;
}

pub def Fn: fun(*Inputs) res[i128, Fail];

pub def Needs: u64;

# the target's address
pub val NEEDS_S: Needs = 0x1;
# the address of the target's GOT entry
pub val NEEDS_G: Needs = 0x2;
# the GOT's address
pub val NEEDS_GOT: Needs = 0x4;
# the address of the target's PLT entry or stub
pub val NEEDS_L: Needs = 0x8;
# the target's index in its section table or index space
pub val NEEDS_INDEX: Needs = 0x10;
# the address thread pointer offsets count from
pub val NEEDS_TP: Needs = 0x20;
# the address dynamic thread vector offsets count from
pub val NEEDS_DTP: Needs = 0x40;
# the value the field holds before the relocation
pub val NEEDS_CUR: Needs = 0x80;

# name:  the computation, spelled as its psABI formula
# value: the computation
# needs: the anchors it reads, which the linker publishes and a relocation
#        takes from its reach. an input a computation does not read is not
#        looked for
pub rec Computation {
    name:  str;
    value: Fn;
    needs: Needs;
}

pub fun needs(c: *Computation, n: Needs) bool {
    ret (c.needs & n) == n;
}

pub val NONE:         Computation = Computation{name: "0", value: none};
pub val ABS:          Computation = Computation{name: "s+a", value: abs, needs: NEEDS_S};
pub val PC:           Computation = Computation{name: "s+a-p", value: pc, needs: NEEDS_S};
pub val PAGE:         Computation = Computation{name: "page(s+a)-page(p)", value: page, needs: NEEDS_S};
pub val SYMBOL:       Computation = Computation{name: "s", value: symbol, needs: NEEDS_S};
pub val BASE:         Computation = Computation{name: "base+a", value: base};
pub val SIZE:         Computation = Computation{name: "z+a", value: size};
pub val GOT:          Computation = Computation{name: "g+a", value: got, needs: NEEDS_G};
pub val GOT_PC:       Computation = Computation{name: "g+a-p", value: got_pc, needs: NEEDS_G};
pub val GOT_PAGE:     Computation = Computation{name: "page(g+a)-page(p)", value: got_page, needs: NEEDS_G};
pub val GOT_SLOT:     Computation = Computation{name: "g+a-got", value: got_slot, needs: NEEDS_G | NEEDS_GOT};
pub val GOT_PAGE_OFF: Computation = Computation{name: "g+a-page(got)", value: got_page_off, needs: NEEDS_G | NEEDS_GOT};
pub val GOT_BASE:     Computation = Computation{name: "got+a-p", value: got_base, needs: NEEDS_GOT};
pub val GOT_OFF:      Computation = Computation{name: "s+a-got", value: got_off, needs: NEEDS_S | NEEDS_GOT};
pub val PLT:          Computation = Computation{name: "l+a-p", value: plt, needs: NEEDS_L};
pub val PLT_ABS:      Computation = Computation{name: "l+a", value: plt_abs, needs: NEEDS_L};
pub val PLT_OFF:      Computation = Computation{name: "l+a-got", value: plt_off, needs: NEEDS_L | NEEDS_GOT};
pub val IMAGE:        Computation = Computation{name: "s+a-base", value: image, needs: NEEDS_S};
pub val SECREL:       Computation = Computation{name: "s+a-section", value: secrel, needs: NEEDS_S};
pub val INDEX:        Computation = Computation{name: "index", value: index, needs: NEEDS_INDEX};
pub val DIFF:         Computation = Computation{name: "s+a-b", value: diff, needs: NEEDS_S};
pub val TPOFF:        Computation = Computation{name: "s+a-tp", value: tpoff, needs: NEEDS_S | NEEDS_TP};
pub val DTPOFF:       Computation = Computation{name: "s+a-dtp", value: dtpoff, needs: NEEDS_S | NEEDS_DTP};
pub val TPOFF_REV:    Computation = Computation{name: "tp-s-a", value: tpoff_rev, needs: NEEDS_S | NEEDS_TP};

pub val ADD:    Computation = Computation{name: "field+s+a", value: add, needs: NEEDS_S | NEEDS_CUR};
pub val SUB:    Computation = Computation{name: "field-s-a", value: sub, needs: NEEDS_S | NEEDS_CUR};
pub val LINKED: Computation = Computation{name: "partner", value: linked};

val ROW_COUNT: usize                   = 27;
val ROWS:      [ROW_COUNT]*Computation = [ROW_COUNT]*Computation{
    ?NONE, ?ABS, ?PC, ?PAGE, ?GOT, ?GOT_PC, ?GOT_PAGE, ?GOT_PAGE_OFF, ?GOT_SLOT, ?GOT_BASE, ?GOT_OFF, ?PLT, ?IMAGE,
    ?SECREL, ?INDEX, ?DIFF, ?TPOFF, ?DTPOFF, ?SYMBOL, ?BASE, ?SIZE, ?PLT_ABS, ?PLT_OFF, ?TPOFF_REV, ?ADD, ?SUB, ?LINKED,
};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Computation {
    ret ROWS[index];
}

fun ok(v: i128) res[i128, Fail] {
    ret res[i128, Fail].ok{v};
}

fun sa(x: *Inputs) i128 {
    ret x.s::i128 + x.a::i128;
}

fun ga(x: *Inputs) i128 {
    ret x.g::i128 + x.a::i128;
}

# the distance from the page of `p` to the page of `v`
fun pages(x: *Inputs, v: i128) res[i128, Fail] {
    if (x.page == 0 || (x.page & (x.page - 1)) != 0) {
        ret res[i128, Fail].err{fail.malformed("page granule is not a power of two")};
    }
    val mask: i128 = ~(x.page::i128 - 1);
    ret ok((v & mask) - (x.p::i128 & mask));
}

fun none(x: *Inputs) res[i128, Fail] {
    ret ok(0);
}

fun symbol(x: *Inputs) res[i128, Fail] {
    ret ok(x.s::i128);
}

fun base(x: *Inputs) res[i128, Fail] {
    ret ok(x.base::i128 + x.a::i128);
}

fun size(x: *Inputs) res[i128, Fail] {
    ret ok(x.z::i128 + x.a::i128);
}

fun plt_abs(x: *Inputs) res[i128, Fail] {
    ret ok(x.l::i128 + x.a::i128);
}

fun plt_off(x: *Inputs) res[i128, Fail] {
    ret ok(x.l::i128 + x.a::i128 - x.got::i128);
}

fun tpoff_rev(x: *Inputs) res[i128, Fail] {
    ret ok(x.tp::i128 - sa(x));
}

fun abs(x: *Inputs) res[i128, Fail] {
    ret ok(sa(x));
}

fun pc(x: *Inputs) res[i128, Fail] {
    ret ok(sa(x) - x.p::i128);
}

fun page(x: *Inputs) res[i128, Fail] {
    ret pages(x, sa(x));
}

fun got(x: *Inputs) res[i128, Fail] {
    ret ok(ga(x));
}

fun got_pc(x: *Inputs) res[i128, Fail] {
    ret ok(ga(x) - x.p::i128);
}

fun got_page(x: *Inputs) res[i128, Fail] {
    ret pages(x, ga(x));
}

fun got_page_off(x: *Inputs) res[i128, Fail] {
    if (x.page == 0 || (x.page & (x.page - 1)) != 0) {
        ret res[i128, Fail].err{fail.malformed("page granule is not a power of two")};
    }
    ret ok(ga(x) - (x.got::i128 & ~(x.page::i128 - 1)));
}

fun got_slot(x: *Inputs) res[i128, Fail] {
    ret ok(ga(x) - x.got::i128);
}

fun got_base(x: *Inputs) res[i128, Fail] {
    ret ok(x.got::i128 + x.a::i128 - x.p::i128);
}

fun got_off(x: *Inputs) res[i128, Fail] {
    ret ok(sa(x) - x.got::i128);
}

fun plt(x: *Inputs) res[i128, Fail] {
    ret ok(x.l::i128 + x.a::i128 - x.p::i128);
}

fun image(x: *Inputs) res[i128, Fail] {
    ret ok(sa(x) - x.base::i128);
}

fun secrel(x: *Inputs) res[i128, Fail] {
    ret ok(sa(x) - x.section::i128);
}

fun index(x: *Inputs) res[i128, Fail] {
    ret ok(x.index::i128);
}

fun diff(x: *Inputs) res[i128, Fail] {
    ret ok(sa(x) - x.b::i128);
}

fun tpoff(x: *Inputs) res[i128, Fail] {
    ret ok(sa(x) - x.tp::i128);
}

fun dtpoff(x: *Inputs) res[i128, Fail] {
    ret ok(sa(x) - x.dtp::i128);
}

fun add(x: *Inputs) res[i128, Fail] {
    ret ok(x.cur::i128 + sa(x));
}

fun sub(x: *Inputs) res[i128, Fail] {
    ret ok(x.cur::i128 - sa(x));
}

fun linked(x: *Inputs) res[i128, Fail] {
    ret ok(x.partner::i128);
}

test compute__each_computation_gives_its_result {
    var x: Inputs = Inputs{
        s:       0x40_1234,
        a:       -0x34,
        p:       0x40_3010,
        b:       0x40_0800,
        g:       0x60_0018,
        got:     0x60_0000,
        l:       0x50_0040,
        base:    0x40_0000,
        section: 0x40_1000,
        index:   7,
        tp:      0x40_0f00,
        dtp:     0x40_0e00,
        page:    0x1000,
        z:       0x40,
        cur:     0x100,
        partner: -0x24,
    };
    val want: [ROW_COUNT]i128 = [ROW_COUNT]i128{
        0, 0x40_1200, -0x1e10, -0x2000, 0x60_0018 - 0x34, 0x60_0018 - 0x34 - 0x40_3010,
        0x5f_f000 - 0x40_3000, 0x60_0018 - 0x34 - 0x60_0000, 0x18 - 0x34, 0x60_0000 - 0x34 - 0x40_3010, 0x40_1200 - 0x60_0000,
        0x50_0040 - 0x34 - 0x40_3010, 0x1200, 0x200, 7, 0xa00, 0x300, 0x400, 0x40_1234, 0x3f_ffcc, 0xc,
        0x50_0040 - 0x34, 0x50_0040 - 0x34 - 0x60_0000, 0x40_0f00 - 0x40_1200,
        0x100 + 0x40_1200, 0x100 - 0x40_1200, -0x24,
    };
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val r: res[i128, Fail] = ROWS[i].value(?x);
        if (sel r.err)       { ret 1; }
        if (r.ok != want[i]) { ret 1; }
        i = i + 1;
    }
    x.page = 0x1800;
    val bad: res[i128, Fail] = PAGE.value(?x);
    if (sel bad.ok) { ret 1; }
    ret 0;
}
