# the late values of an object, the one owner of how they are written
#
# a late value is the value of a local symbol the producer states with no
# definition, as a location view's symbol is. no other object can define it:
# the lowering of the object's records gives it its value as a relocatable
# writer writes the object, and the link in its view phase once its layout
# settles. a relocation whose target is a late value takes the folded row its
# kind has here, which every set that carries them shares: the writer folds
# the value into the field and writes no record, and the link applies the row
# through the engine after its view phase. the kinds are the fixed-width
# absolute ones, as `.byte` writes a view, and the LEB128 of a symbol's value
# padded to the kind's fixed width, so its site keeps its size whatever the
# value and needs no layout pass. no format has a relocation for the LEB128
# kinds, so their folded rows write them for any target, and a fixed-width
# kind against a target that is no late value takes the format's own row. a
# late symbol no written record names is left out of the object's symbol
# table, as an assembler leaves out its local labels.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Reloc;
use mink.model.object.Symbol;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.model.symbol;
use mink.reloc.compute;
use mink.reloc.compute.Inputs;
use mink.reloc.engine;
use mink.reloc.engine.Site;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row;
use mink.reloc.row.Addend;
use mink.reloc.row.FieldChoice;
use mink.reloc.row.Lookup;
use mink.reloc.row.Row;
use mink.reloc.row.Write;

val PIECES: [10]Piece = [10]Piece{
    Piece{at: 0, width: 7}, Piece{at: 8, width: 7}, Piece{at: 16, width: 7}, Piece{at: 24, width: 7}, Piece{at: 32, width: 7},
    Piece{at: 40, width: 7}, Piece{at: 48, width: 7}, Piece{at: 56, width: 7}, Piece{at: 64, width: 7}, Piece{at: 72, width: 7},
};

val LEB32: Field = Field{bytes: reloc.LEB32_BYTES, pieces: ?PIECES[0], count: reloc.LEB32_BYTES, padded: true};
val LEB64: Field = Field{bytes: reloc.LEB64_BYTES, pieces: ?PIECES[0], count: reloc.LEB64_BYTES, padded: true};

val LEB32_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?LEB32}};
val LEB64_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?LEB64}};

val P8:  [1]Piece = [1]Piece{Piece{at: 0, width: 8}};
val P16: [1]Piece = [1]Piece{Piece{at: 0, width: 16}};
val P32: [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val P64: [1]Piece = [1]Piece{Piece{at: 0, width: 64}};

val B8:  Field = Field{bytes: 1, pieces: ?P8[0], count: 1};
val B16: Field = Field{bytes: 2, pieces: ?P16[0], count: 1};
val B32: Field = Field{bytes: 4, pieces: ?P32[0], count: 1};
val B64: Field = Field{bytes: 8, pieces: ?P64[0], count: 1};

val B8_FIELD:  [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B8}};
val B16_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B16}};
val B32_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B32}};
val B64_FIELD: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?B64}};

# a plain data word of either sign, as an assembler holds a value it folds
val E8:  Range = Range{check: field.Check.either{}, bits: 8, align: 1};
val E16: Range = Range{check: field.Check.either{}, bits: 16, align: 1};
val E32: Range = Range{check: field.Check.either{}, bits: 32, align: 1};
val E64: Range = Range{check: field.Check.either{}, bits: 64, align: 1};

val U32: Range = Range{check: field.Check.unsigned{}, bits: 32, align: 1};
val U64: Range = Range{check: field.Check.unsigned{}, bits: 64, align: 1};
val S32: Range = Range{check: field.Check.signed{}, bits: 32, align: 1};
val S64: Range = Range{check: field.Check.signed{}, bits: 64, align: 1};

# the folded rows of the late values, which every set that carries them
# names as its shared rows
pub val COUNT: usize      = 8;
pub val ROWS:  [COUNT]Row = [COUNT]Row{
    Row{name: "padded uleb32", kind: ?reloc.ULEB32, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.ABS, range: U32, addend: Addend.record{}, write: Write.folded{}},
    Row{name: "padded uleb64", kind: ?reloc.ULEB64, fields: ?LEB64_FIELD[0], field_count: 1, value: ?compute.ABS, range: U64, addend: Addend.record{}, write: Write.folded{}},
    Row{name: "padded sleb32", kind: ?reloc.SLEB32, fields: ?LEB32_FIELD[0], field_count: 1, value: ?compute.ABS, range: S32, addend: Addend.record{}, write: Write.folded{}},
    Row{name: "padded sleb64", kind: ?reloc.SLEB64, fields: ?LEB64_FIELD[0], field_count: 1, value: ?compute.ABS, range: S64, addend: Addend.record{}, write: Write.folded{}},
    Row{name: "late abs8", kind: ?reloc.ABS8, fields: ?B8_FIELD[0], field_count: 1, value: ?compute.ABS, range: E8, addend: Addend.record{}, write: Write.folded{}},
    Row{name: "late abs16", kind: ?reloc.ABS16, fields: ?B16_FIELD[0], field_count: 1, value: ?compute.ABS, range: E16, addend: Addend.record{}, write: Write.folded{}},
    Row{name: "late abs32", kind: ?reloc.ABS32, fields: ?B32_FIELD[0], field_count: 1, value: ?compute.ABS, range: E32, addend: Addend.record{}, write: Write.folded{}},
    Row{name: "late abs64", kind: ?reloc.ABS64, fields: ?B64_FIELD[0], field_count: 1, value: ?compute.ABS, range: E64, addend: Addend.record{}, write: Write.folded{}},
};

# whether the symbol `y`, as the producer states it, is a late value: a
# local symbol with no definition
pub fun is_late(y: *Symbol) bool {
    if (symbol.binds(y.binding, symbol.EXTERNAL)) { ret false; }
    ret sel y.def.undefined;
}

# whether the target of `x` is a late value of `given`, the object the
# producer handed over, whose symbols lead those of the object written from
# it. a symbol past them is one the lowering added
pub fun targets_late(given: *Object, x: *Reloc) bool {
    if (!sel x.target.symbol) { ret false; }
    val s: Id[Symbol] = x.target.symbol;
    if (s.index::usize >= table.count[Symbol](?given.symbols)) { ret false; }
    ret is_late(object.symbol_at(given, s));
}

# the row of `l` a relocation of kind `k` takes: the kind's folded row when
# its target is a late value, as `late` says, and it names no second symbol,
# as `difference` says, and the row row.targeting finds otherwise
pub fun row_of(l: *Lookup, k: *Kind, difference: bool, late: bool) res[*Row, Fail] {
    if (late && !difference) {
        val f: opt[*Row] = row.folding(l, k);
        if (sel f.some) { ret res[*Row, Fail].ok{f.some}; }
    }
    ret row.targeting(l, k, difference);
}

# mark in `out`, per symbol of `o`, a late value of `given` no record written
# from `o` names, which the writer leaves out of the symbol table: each late
# symbol unless a relocation of `o` that writes a record, as its row of `l`
# says, names it as its target or its second symbol. `given` is the object
# the producer handed over, and `o` the one written from it, its lowered
# copy or `given` itself
pub fun unwritten(given: *Object, o: *Object, l: *Lookup, out: *Table[bool]) err[Fail] {
    val n: usize               = table.count[Symbol](?o.symbols);
    val g: res[Id[bool], Fail] = table.grow[bool](out, n);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var k: usize = 0;
    for (k < n && k < table.count[Symbol](?given.symbols)) {
        table.items[bool](out)[k] = is_late(object.symbol_at(given, table.nth[Symbol](k)));
        k                         = k + 1;
    }
    var i: usize = 0;
    for (i < table.count[Reloc](?o.relocs)) {
        val x: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc](i));
        i = i + 1;
        if (!sel x.target.symbol) { cnt; }
        if (sel x.minus.none) {
            val r: res[*Row, Fail] = row_of(l, x.kind, false, targets_late(given, x));
            if (sel r.err)             { ret err[Fail].err{fail.in_indexed(r.err, "relocation", (i - 1)::u64)}; }
            if (sel r.ok.write.folded) { cnt; }
        }
        named(out, n, x.target.symbol);
        if (sel x.minus.some) { named(out, n, x.minus.some); }
    }
    ret err[Fail].ok{};
}

# a record names the symbol `s`, which stays when it is among the `n`
fun named(out: *Table[bool], n: usize, s: Id[Symbol]) {
    if (s.index::usize < n) { table.items[bool](out)[s.index::usize] = false; }
}

# fold the relocation `x` of `o`, whose row `r` the writer folds, into its
# site `s`: the value its symbol has as the object is written plus its
# addend, read modulo an address of `width` bytes as the link reads it. a
# relocation that subtracts a symbol or names none is refused as unsupported,
# as is a symbol with no absolute value, undefined or placed where the link
# lays it out, since no format carries it. a value the field cannot hold is
# refused as an overflow naming the symbol
pub fun fold(r: *Row, o: *Object, x: *Reloc, s: *Site, width: opt[u8]) err[Fail] {
    if (sel x.minus.some)     { ret err[Fail].err{fail.about(fail.unsupported("a folded value subtracts no second symbol"), r.name)}; }
    if (!sel x.target.symbol) { ret err[Fail].err{fail.about(fail.unsupported("a folded value names no symbol"), r.name)}; }
    val sid: Id[Symbol] = x.target.symbol;
    if (sid.index::usize >= table.count[Symbol](?o.symbols)) { ret err[Fail].err{fail.malformed("relocation names a symbol the object does not have")}; }
    val y: *Symbol = object.symbol_at(o, sid);
    if (!sel y.def.absolute) { ret err[Fail].err{fail.about(fail.unsupported("no format has a relocation for the folded value of a symbol with no absolute value when the object is written"), r.name)}; }
    var in: Inputs    = Inputs{s: y.def.absolute, a: x.addend, width: width};
    val e:  err[Fail] = engine.apply(r, s, ?in);
    if (sel e.err) { ret err[Fail].err{overflowing(e.err, sid)}; }
    ret e;
}

# the failure `f` of a folded value, an overflow naming the symbol `sid`
# whose value the field cannot hold
pub fun overflowing(f: Fail, sid: Id[Symbol]) Fail {
    if (!sel f.cause.overflow) { ret f; }
    var out: Fail = f;
    out.at.record  = "symbol";
    out.at.index   = sid.index::u64;
    out.at.indexed = true;
    out.at.placed  = false;
    ret out;
}
