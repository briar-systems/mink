# the relocation engine: rows applied to bytes
#
# the engine reads only a row. it computes a row's value, holds it to the
# row's range, writes it into the field the instruction at the place chooses
# and reads a field back as the implicit addend, moved by the row's bias to
# count from the place as every neutral addend does, and it finds the
# partner a paired row needs. every refusal names the file, the section as the
# record and the field's offset.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.bytes.reader;
use mink.bytes.reader.Order;
use mink.catalog.arch.x86;
use mink.catalog.format;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.reloc.compute;
use mink.reloc.compute.Inputs;
use mink.reloc.field;
use mink.reloc.field.Field;
use mink.reloc.field.Piece;
use mink.reloc.field.Range;
use mink.reloc.row;
use mink.reloc.row.FieldChoice;
use mink.reloc.row.Lookup;
use mink.reloc.row.Row;
use mink.reloc.row.Set;
use A: std.allocator;
use T: std.allocator.testing;

use mink.base.table;
use mink.base.table.Table;

# where a field lives
# ---
# file:    the input's name
# section: the name of the section holding the field
# data:    the section's bytes
# size:    how many bytes the section holds
# base:    the absolute offset of the section's bytes, zero when unplaced
# offset:  the field's offset in the section
# order:   the byte order of the field's container
pub rec Site {
    file:    str;
    section: str;
    data:    *u8;
    size:    u64;
    base:    u64;
    offset:  u64;
    order:   Order;
}

# the value `r` computes from `x`, a refusal naming the row
pub fun value(r: *Row, s: *Site, x: *Inputs) res[i128, Fail] {
    val v: res[i128, Fail] = r.value.value(x);
    if (sel v.err) { ret res[i128, Fail].err{fail.about(placed(v.err, s), r.name)}; }
    ret res[i128, Fail].ok{v.ok};
}

# the field choice of `r` the instruction at `s` chooses: its lone choice
# when it holds for every instruction, the one whose bits the instruction
# holds otherwise
fun choice_at(r: *Row, s: *Site) res[*FieldChoice, Fail] {
    if (r.field_count == 1 && r.fields[0].insn_mask == 0) { ret res[*FieldChoice, Fail].ok{?r.fields[0]}; }
    val got: res[u64, Fail] = insn_at(row.container(r), s);
    if (sel got.err) { ret res[*FieldChoice, Fail].err{got.err}; }
    val insn: u64   = got.ok;
    var i:    usize = 0;
    for (i < r.field_count) {
        if (row.chosen(?r.fields[i], insn)) { ret res[*FieldChoice, Fail].ok{?r.fields[i]}; }
        i = i + 1;
    }
    ret res[*FieldChoice, Fail].err{fail.about(placed(fail.malformed("no field form of the relocation matches the instruction at its place"), s), r.name)};
}

# the instruction bits of the `n` byte container at `s`
fun insn_at(n: u8, s: *Site) res[u64, Fail] {
    if (s.offset > s.size || n::u64 > s.size - s.offset) {
        ret res[u64, Fail].err{placed(fail.truncated("relocation field runs past its section"), s)};
    }
    var insn: u64 = 0;
    var k:    u8  = 0;
    for (k < n) {
        var at: usize = s.offset::usize + k::usize;
        if (s.order != reader.LITTLE) { at = s.offset::usize + (n - 1 - k)::usize; }
        insn = insn | (s.data[at]::u64 << (k::u64 * 8));
        k    = k + 1;
    }
    ret res[u64, Fail].ok{insn};
}

# the row of `l` that reads `key` at `s`: the key's one row, or of the rows
# the instruction tells apart the one it chooses, refused naming the place
pub fun reading(l: *Lookup, key: u32, s: *Site) res[*Row, Fail] {
    if (!row.instruction_chooses(l, key)) { ret row.by_key(l, key); }
    val any: res[*Row, Fail] = row.any_of(l, key);
    if (sel any.err) { ret any; }
    val got: res[u64, Fail] = insn_at(row.container(any.ok), s);
    if (sel got.err) { ret res[*Row, Fail].err{fail.about(got.err, any.ok.name)}; }
    val r: res[*Row, Fail] = row.reading(l, key, got.ok);
    if (sel r.err) { ret res[*Row, Fail].err{fail.about(placed(r.err, s), any.ok.name)}; }
    ret r;
}

# write `v` into the field of `r` at `s`, refusing a value out of the row's
# range or off its alignment or the chosen field's. the value is held as it
# is, never read modulo an address width
pub fun insert(r: *Row, s: *Site, v: i128) err[Fail] {
    ret place(r, s, v, opt[u8].none{});
}

# write `v` into the field of `r` at `s` as `insert` does, a value that is out
# of range as it is held by its representative modulo an address of `width`
# bytes when one fits
fun place(r: *Row, s: *Site, v: i128, width: opt[u8]) err[Fail] {
    val chosen: res[*FieldChoice, Fail] = choice_at(r, s);
    if (sel chosen.err) { ret err[Fail].err{chosen.err}; }
    val align: u64 = chosen.ok.align;
    if (align != 0 && (v & (align::i128 - 1)) != 0) {
        ret err[Fail].err{fail.valued(fail.about(placed(fail.malformed("relocation value is misaligned for its instruction form"), s), r.name), v)};
    }
    ret put(chosen.ok.field, r.range, r.name, s, v, width);
}

# write `v` into the field `chosen` at `s`, held to the range `g` as it is or
# by its representative modulo an address of `width` bytes, a refusal naming
# the row `name`
fun put(chosen: *Field, g: Range, name: str, s: *Site, v: i128, width: opt[u8]) err[Fail] {
    val held: res[Field, Fail] = spanned(chosen, s);
    if (sel held.err) { ret err[Fail].err{held.err}; }
    var f: Field = held.ok;
    if ((v & (g.align::i128 - 1)) != 0) {
        ret err[Fail].err{fail.valued(fail.about(placed(fail.malformed("relocation value is misaligned"), s), name), v)};
    }
    var rounded: i128 = v;
    if (f.round && f.shift != 0) { rounded = rounded + ((1::i128) << (f.shift - 1)::i128); }
    if (f.split != 0)            { rounded = rounded + ((1::i128) << (f.split - 1)::i128); }
    val kept: opt[i128] = held_by(g, rounded, width);
    if (sel kept.none) { ret err[Fail].err{fail.valued(fail.about(placed(fail.overflow("relocation value is out of range"), s), name), v)}; }
    val e:    i128 = kept.some;
    var bits: i128 = e >> f.shift::i128;
    if (f.split != 0) {
        val low: i128 = (1::i128 << f.split::i128) - 1;
        bits = ((e >> f.split::i128) << f.split::i128) | (v & low);
    }
    if (f.run && (bits < 0 || (bits >> field.width(?f)::i128) != 0)) {
        ret err[Fail].err{fail.valued(fail.about(placed(fail.overflow("relocation value does not fit its encoding"), s), name), v)};
    }
    val negative: bool = bits < 0;
    if (sel f.sign.some && negative) { bits = ~bits; }
    var fill: u8 = 0;
    if (bits < 0) { fill = 1; }
    field.put(?f, ?s.data[s.offset::usize], s.order, bits::u64, fill);
    if (sel f.sign.some) { field.put_sign(?f, f.sign.some, ?s.data[s.offset::usize], s.order, negative); }
    ret err[Fail].ok{};
}

# the value the field of `r` at `s` holds, its implicit addend
pub fun extract(r: *Row, s: *Site) res[i64, Fail] {
    val chosen: res[*FieldChoice, Fail] = choice_at(r, s);
    if (sel chosen.err) { ret res[i64, Fail].err{chosen.err}; }
    ret get(chosen.ok.field, sel r.range.check.signed || sel r.range.check.either, s);
}

# the value the field `chosen` at `s` holds, sign extended when `signed`
fun get(chosen: *Field, signed: bool, s: *Site) res[i64, Fail] {
    val held: res[Field, Fail] = spanned(chosen, s);
    if (sel held.err) { ret res[i64, Fail].err{held.err}; }
    var f:     Field = held.ok;
    val total: u32   = field.width(?f) + f.shift::u32;
    val raw:   u64   = field.get(?f, ?s.data[s.offset::usize], s.order);
    if (f.split != 0) {
        val up: u32 = total - f.split::u32;
        var hi: u64 = raw >> f.split::u64;
        var lo: u64 = raw & ((1::u64 << f.split::u64) - 1);
        if (up != 0 && up < 64 && ((hi >> (up - 1)::u64) & 1) != 0) { hi = hi | ~((1::u64 << up::u64) - 1); }
        if (((lo >> (f.split - 1)::u64) & 1) != 0)                  { lo = lo | ~((1::u64 << f.split::u64) - 1); }
        ret res[i64, Fail].ok{((hi << f.split::u64) + lo):~i64};
    }
    var v: u64 = raw;
    if (sel f.sign.some) {
        if (field.get_sign(?f, f.sign.some, ?s.data[s.offset::usize], s.order)::u64 == f.sign.some.neg::u64) { v = ~v; }
        ret res[i64, Fail].ok{(v << f.shift::u64):~i64};
    }
    v = v << f.shift::u64;
    if (signed && total != 0 && total < 64 && ((v >> (total - 1)::u64) & 1) != 0) {
        v = v | ~((1::u64 << total::u64) - 1);
    }
    ret res[i64, Fail].ok{v:~i64};
}

# the neutral addend of the addend `held` a field of `r` holds: the format
# counts it from past the field, so the row's bias moves it to the place
pub fun neutral_of(r: *Row, held: i64) res[i64, Fail] {
    val a:   i128 = held::i128 + r.bias::i128;
    val top: i128 = (1::i128) << 63;
    if (a < -top || a >= top) { ret res[i64, Fail].err{fail.valued(fail.about(fail.overflow("the addend with its row's bias does not fit 64 bits"), r.name), a)}; }
    ret res[i64, Fail].ok{a::i64};
}

# the addend a field of `r` holds for the neutral addend `a`, the inverse of
# `neutral_of`
pub fun held_of(r: *Row, a: i64) i128 {
    ret a::i128 - r.bias::i128;
}

# how far past its section's start lies the target a field of `r` locates for
# a record that names the target's section, given `distance`, the field less
# the value the row computes for the section's start: the format counts the
# target from the row's reach before the place
pub fun target_offset(r: *Row, distance: i64) i128 {
    ret distance::i128 - row.reach(r)::i128;
}

# the neutral addend of a target that lies `at` past the symbol a field of
# `r` names it by, the inverse of `target_offset`
pub fun placed_addend(r: *Row, at: i64) res[i64, Fail] {
    val a:   i128 = at::i128 + row.reach(r)::i128;
    val top: i128 = (1::i128) << 63;
    if (a < -top || a >= top) { ret res[i64, Fail].err{fail.valued(fail.about(fail.overflow("the addend with its row's reach does not fit 64 bits"), r.name), a)}; }
    ret res[i64, Fail].ok{a::i64};
}

# the neutral addend of a relocation: its field's when the row keeps it in
# the field its value is written to, the field of its own shape's when it
# holds it there, each with the row's bias, the record's when the record
# holds it or a partner record held it, which the format's conversion folded
# into the record, and zero when the relocation has none
pub fun addend(r: *Row, s: *Site, record: i64) res[i64, Fail] {
    if (sel r.addend.none) { ret res[i64, Fail].ok{0}; }
    var held: res[i64, Fail] = res[i64, Fail].ok{record};
    if (sel r.addend.field) { held = extract(r, s); }
    or (sel r.addend.held)  { held = get(r.addend.held, true, s); }
    if (sel held.err)       { ret held; }
    ret neutral_of(r, held.ok);
}

# write the addend `a` of a relocation of `r` into the bytes at `s` where the
# row keeps it, the write `addend` reads back. a row that keeps its addend in
# a record writes nothing to the bytes and is refused, as is a nonzero addend
# for a row that has none
pub fun put_addend(r: *Row, s: *Site, a: i64) err[Fail] {
    if (sel r.addend.field) { ret insert(r, s, held_of(r, a)); }
    if (sel r.addend.held) {
        val h: *Field = r.addend.held;
        ret put(h, row.held_range(h), r.name, s, held_of(r, a), opt[u8].none{});
    }
    if (sel r.addend.none) {
        if (a != 0) { ret err[Fail].err{fail.valued(fail.about(placed(fail.malformed("the relocation keeps no addend"), s), r.name), a::i128)}; }
        ret err[Fail].ok{};
    }
    if (sel r.addend.partner) { ret err[Fail].err{fail.about(placed(fail.unsupported("an addend a partner record holds is not written yet"), s), r.name)}; }
    ret err[Fail].err{fail.about(placed(fail.internal("the relocation keeps its addend in its record, not in the bytes"), s), r.name)};
}

# compute the value of `r` from `x` and write it to its field at `s`, the
# value of an address computation read modulo the address width `x` states
pub fun apply(r: *Row, s: *Site, x: *Inputs) err[Fail] {
    var y: Inputs = @x;
    if (row.container(r) != 0) {
        val cur: res[i64, Fail] = extract(r, s);
        if (sel cur.err) { ret err[Fail].err{cur.err}; }
        y.cur = cur.ok;
    }
    val v: res[i128, Fail] = value(r, s, ?y);
    if (sel v.err)        { ret err[Fail].err{v.err}; }
    if (!r.value.address) { ret insert(r, s, v.ok); }
    if (sel x.width.none) { ret err[Fail].err{fail.about(placed(fail.internal("an address computation has no address width to wrap to"), s), r.name)}; }
    ret place(r, s, v.ok, x.width);
}

# whether the value `v` of `r` lies in `g`: a multiple of its alignment, held
# as it is or, for an address computation, by its representative modulo the
# address width `x` states
pub fun within(r: *Row, g: Range, v: i128, x: *Inputs) res[bool, Fail] {
    if ((v & (g.align::i128 - 1)) != 0) { ret res[bool, Fail].ok{false}; }
    var width: opt[u8] = opt[u8].none{};
    if (r.value.address) {
        if (sel x.width.none) { ret res[bool, Fail].err{fail.about(fail.internal("an address computation has no address width to wrap to"), r.name)}; }
        width = x.width;
    }
    val kept: opt[i128] = held_by(g, v, width);
    ret res[bool, Fail].ok{sel kept.some};
}

# the value of `r` a record it pairs with reads, held to 64 bits: the value of
# an address computation by its representative modulo the address width `x`
# states, any other value as it is
pub fun partner_value(r: *Row, s: *Site, x: *Inputs) res[i64, Fail] {
    val v: res[i128, Fail] = value(r, s, x);
    if (sel v.err) { ret res[i64, Fail].err{v.err}; }
    var width: opt[u8] = opt[u8].none{};
    if (r.value.address) {
        if (sel x.width.none) { ret res[i64, Fail].err{fail.about(placed(fail.internal("an address computation has no address width to wrap to"), s), r.name)}; }
        width = x.width;
    }
    val kept: opt[i128] = held_by(PARTNER, v.ok, width);
    if (sel kept.none) { ret res[i64, Fail].err{fail.valued(fail.about(placed(fail.overflow("the value of a relocation's partner does not fit 64 bits"), s), r.name), v.ok)}; }
    ret res[i64, Fail].ok{kept.some::i64};
}

# whether a row of the pair rule `p` writes its field: a row whose partner
# adds writes nothing, as the partner writes their difference
pub fun writes(p: *row.PairRule) bool {
    ret !sel p.role.plus;
}

# take the value `v` of the partner of a row of the pair rule `p` into the
# inputs `x`: a subtracted partner's as the value the row subtracts, any
# other's as its partner's value
pub fun take_partner(p: *row.PairRule, x: *Inputs, v: i64) {
    if (sel p.role.minus) {
        x.b = v:~u64;
        ret;
    }
    x.partner = v;
}

# one relocation as pairing sees it
# ---
# row:   its row
# place: the address of the field it patches
# label: the address its target labels
pub rec Mark {
    row:   *Row;
    place: u64;
    label: u64;
}

# a mark in the order partner lookups search it
# ---
# place: the address of its field
# mark:  its index among the marks
pub rec Slot {
    place: u64;
    mark:  u32;
}

fun by_place(a: *Slot, b: *Slot) i64 {
    if (a.place != b.place) {
        if (a.place < b.place) { ret -1; }
        ret 1;
    }
    if (a.mark < b.mark) { ret -1; }
    if (a.mark > b.mark) { ret 1; }
    ret 0;
}

# order the `count` marks by place into `out`, which holds nothing before, so
# a label lookup is a binary search
pub fun order(marks: *Mark, count: usize, out: *Table[Slot]) err[Fail] {
    table.clear[Slot](out);
    var i: usize = 0;
    for (i < count) {
        val p: res[table.Id[Slot], Fail] = table.push[Slot](out, Slot{place: marks[i].place, mark: i::u32});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    sort.sort_by[Slot](table.items[Slot](out), count, by_place);
    ret err[Fail].ok{};
}

# the index of the partner the `index`th of `count` marks needs, refused when
# its row takes none or none matches. `slots` is order's of the same marks
pub fun partner(marks: *Mark, count: usize, slots: *Table[Slot], index: usize, at: Location) res[usize, Fail] {
    val m: *Mark = ?marks[index];
    if (sel m.row.pair.none) {
        ret res[usize, Fail].err{located(fail.unsupported("relocation takes no partner"), at)};
    }
    val p: row.PairRule = m.row.pair.some;
    if (sel p.link.label) {
        val items: *Slot = table.items[Slot](slots);
        var lo:    usize = 0;
        var hi:    usize = count;
        for (lo < hi) {
            val mid: usize = lo + (hi - lo) / 2;
            if (items[mid].place < m.label) { lo = mid + 1; }
            or                              { hi = mid; }
        }
        for (lo < count && items[lo].place == m.label) {
            val j: usize = items[lo].mark::usize;
            if (j != index && accepts(?p, marks[j].row)) { ret res[usize, Fail].ok{j}; }
            lo = lo + 1;
        }
    }
    or (sel p.link.next) {
        val j: usize = index + 1;
        if (j < count && marks[j].place == m.place && accepts(?p, marks[j].row)) { ret res[usize, Fail].ok{j}; }
    }
    or (sel p.link.previous && index > 0) {
        val j: usize = index - 1;
        if (marks[j].place == m.place && accepts(?p, marks[j].row)) { ret res[usize, Fail].ok{j}; }
    }
    ret res[usize, Fail].err{located(fail.malformed("relocation has no partner"), at)};
}

fun accepts(p: *row.PairRule, r: *Row) bool {
    var k: usize = 0;
    for (k < p.count) {
        if (p.keys[k] == r.key) { ret true; }
        k = k + 1;
    }
    ret false;
}

val PARTNER: Range = Range{check: field.Check.signed{}, bits: 64, align: 1};

# the value `g` holds for `e`: `e` itself when it is in range, otherwise its
# representative modulo an address of `width` bytes that is in range, as
# wrapping address arithmetic reads it, none when no such value is
fun held_by(g: Range, e: i128, width: opt[u8]) opt[i128] {
    if (fits(g, e))     { ret opt[i128].some{e}; }
    if (sel width.none) { ret opt[i128].none{}; }
    val m: i128 = (1::i128) << (width.some::i128 * 8);
    val u: i128 = e & (m - 1);
    if (fits(g, u))     { ret opt[i128].some{u}; }
    if (fits(g, u - m)) { ret opt[i128].some{u - m}; }
    ret opt[i128].none{};
}

# whether `e` is in `g`
fun fits(g: Range, e: i128) bool {
    if (sel g.check.wrap) { ret true; }
    val top: i128 = (1::i128) << g.bits::i128;
    val mid: i128 = (1::i128) << (g.bits - 1)::i128;
    if (sel g.check.signed)   { ret e >= -mid && e < mid; }
    if (sel g.check.unsigned) { ret e >= 0 && e < top; }
    ret e >= -mid && e < top;
}

# the field as it lies at `s`: itself, or for a LEB128 run the bytes of the
# encoding already there
fun spanned(f: *Field, s: *Site) res[Field, Fail] {
    var out: Field = @f;
    if (!f.run) {
        val b: err[Fail] = bounds(f, s);
        if (sel b.err) { ret res[Field, Fail].err{b.err}; }
        ret res[Field, Fail].ok{out};
    }
    var room: u64 = 0;
    if (s.offset < s.size) { room = s.size - s.offset; }
    var n: u8 = 0;
    for (n < f.bytes && n::u64 < room) {
        val last: bool = (s.data[s.offset::usize + n::usize] & 0x80) == 0;
        n = n + 1;
        if (last) {
            out.bytes = n;
            out.count = n;
            ret res[Field, Fail].ok{out};
        }
    }
    ret res[Field, Fail].err{placed(fail.malformed("LEB128 field is not terminated"), s)};
}

fun bounds(f: *Field, s: *Site) err[Fail] {
    if (s.offset > s.size || f.bytes::u64 > s.size - s.offset) {
        ret err[Fail].err{placed(fail.truncated("relocation field runs past its section"), s)};
    }
    ret err[Fail].ok{};
}

fun placed(f: Fail, s: *Site) Fail {
    ret fail.at_offset(fail.in_record(fail.in_file(f, s.file), s.section), s.base + s.offset);
}

fun located(f: Fail, at: Location) Fail {
    var out: Fail = f;
    out.at = at;
    ret out;
}

# a field shape with its range, a value and what reads back
rec Case {
    field: *Field;
    range: Range;
    order: Order;
    value: i128;
    back:  u64;
    word:  u64;
}

val DATA32_PIECES: [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val DATA16_PIECES: [1]Piece = [1]Piece{Piece{at: 0, width: 16}};
val DATA64_PIECES: [1]Piece = [1]Piece{Piece{at: 0, width: 64}};
val BRANCH_PIECES: [1]Piece = [1]Piece{Piece{at: 0, width: 26}};
val PAGE_PIECES:   [2]Piece = [2]Piece{Piece{at: 29, width: 2}, Piece{at: 5, width: 19}};
val B_PIECES:      [4]Piece = [4]Piece{
    Piece{at: 8, width: 4}, Piece{at: 25, width: 6}, Piece{at: 7, width: 1}, Piece{at: 31, width: 1},
};
val J_PIECES: [4]Piece = [4]Piece{
    Piece{at: 21, width: 10}, Piece{at: 20, width: 1}, Piece{at: 12, width: 8}, Piece{at: 31, width: 1},
};
val HI_PIECES:   [1]Piece = [1]Piece{Piece{at: 12, width: 20}};
val LO_S_PIECES: [2]Piece = [2]Piece{Piece{at: 7, width: 5}, Piece{at: 25, width: 7}};
val LDST_PIECES: [1]Piece = [1]Piece{Piece{at: 10, width: 9}};
val CALL_PIECES: [2]Piece = [2]Piece{Piece{at: 52, width: 12}, Piece{at: 12, width: 20}};
val LEB5_PIECES: [5]Piece = [5]Piece{
    Piece{at: 0, width: 7}, Piece{at: 8, width: 7}, Piece{at: 16, width: 7}, Piece{at: 24, width: 7},
    Piece{at: 32, width: 7},
};
val LEB10_PIECES: [10]Piece = [10]Piece{
    Piece{at: 0, width: 7}, Piece{at: 8, width: 7}, Piece{at: 16, width: 7}, Piece{at: 24, width: 7},
    Piece{at: 32, width: 7}, Piece{at: 40, width: 7}, Piece{at: 48, width: 7}, Piece{at: 56, width: 7},
    Piece{at: 64, width: 7}, Piece{at: 72, width: 7},
};

val MOVW_PIECES: [1]Piece = [1]Piece{Piece{at: 5, width: 16}};
val MOVW:        Field    = Field{
    bytes:  4,
    pieces: ?MOVW_PIECES[0],
    count:  1,
    insn:   true,
    sign:   opt[field.Sign].some{field.Sign{at: 29, width: 2, neg: 0, pos: 2}},
};

val DATA32:  Field = Field{bytes: 4, pieces: ?DATA32_PIECES[0], count: 1};
val DATA16:  Field = Field{bytes: 2, pieces: ?DATA16_PIECES[0], count: 1};
val DATA64:  Field = Field{bytes: 8, pieces: ?DATA64_PIECES[0], count: 1};
val BRANCH:  Field = Field{bytes: 4, pieces: ?BRANCH_PIECES[0], count: 1, shift: 2, insn: true};
val PAGE:    Field = Field{bytes: 4, pieces: ?PAGE_PIECES[0], count: 2, shift: 12, insn: true};
val B:       Field = Field{bytes: 4, pieces: ?B_PIECES[0], count: 4, shift: 1, insn: true};
val J:       Field = Field{bytes: 4, pieces: ?J_PIECES[0], count: 4, shift: 1, insn: true};
val HI:      Field = Field{bytes: 4, pieces: ?HI_PIECES[0], count: 1, shift: 12, round: true, insn: true};
val LO_S:    Field = Field{bytes: 4, pieces: ?LO_S_PIECES[0], count: 2, insn: true};
val LDST:    Field = Field{bytes: 4, pieces: ?LDST_PIECES[0], count: 1, shift: 3, insn: true};
val CALL:    Field = Field{bytes: 8, pieces: ?CALL_PIECES[0], count: 2, split: 12, insn: true};
val LEB5:    Field = Field{bytes: 5, pieces: ?LEB5_PIECES[0], count: 5};
val LEB10:   Field = Field{bytes: 10, pieces: ?LEB10_PIECES[0], count: 10};
val LEB_RUN: Field = Field{bytes: 10, pieces: ?LEB10_PIECES[0], count: 10, run: true};

fun range(check: field.Check, bits: u8, align: u64) Range {
    ret Range{check: check, bits: bits, align: align};
}

fun shape_row(c: *FieldChoice, g: Range) Row {
    ret Row{key: 1, name: "shape", kind: ?reloc.ABS32, fields: c, field_count: 1, value: ?compute.ABS, range: g};
}

test engine__insert_and_extract_round_trip_every_field_shape {
    val signed:   field.Check = field.Check.signed{};
    val unsigned: field.Check = field.Check.unsigned{};
    val wrap:     field.Check = field.Check.wrap{};
    val cases:    [13]Case    = [13]Case{
        Case{field: ?DATA32, range: range(signed, 32, 1), order: reader.LITTLE, value: -5, back: 0xffff_ffff_ffff_fffb, word: 0xffff_fffb},
        Case{field: ?DATA16, range: range(unsigned, 16, 1), order: reader.BIG, value: 0xbeef, back: 0xbeef, word: 0xefbe},
        Case{
            field: ?DATA64,
            range: range(wrap, 64, 1),
            order: reader.LITTLE,
            value: 0xdead_beef_0123_4567u64::i128,
            back:  0xdead_beef_0123_4567,
            word:  0xdead_beef_0123_4567,
        },
        Case{field: ?BRANCH, range: range(signed, 28, 4), order: reader.LITTLE, value: -0x1000, back: 0xffff_ffff_ffff_f000, word: 0x3ff_fc00},
        Case{field: ?PAGE, range: range(signed, 33, 0x1000), order: reader.LITTLE, value: 0x1234_5000, back: 0x1234_5000, word: 0x2009_1a20},
        Case{field: ?B, range: range(signed, 13, 2), order: reader.LITTLE, value: -2050, back: 0xffff_ffff_ffff_f7fe, word: 0xfe00_0f00},
        Case{field: ?J, range: range(signed, 21, 2), order: reader.LITTLE, value: 0x7_5432, back: 0x7_5432, word: 0x4327_5000},
        Case{field: ?HI, range: range(signed, 32, 1), order: reader.LITTLE, value: 0x1234_5800, back: 0x1234_6000, word: 0x1234_6000},
        Case{
            field: ?CALL,
            range: range(signed, 32, 1),
            order: reader.LITTLE,
            value: 0x1234_5800,
            back:  0x1234_5800,
            word:  0x8000_0000_1234_6000,
        },
        Case{field: ?LO_S, range: range(wrap, 12, 1), order: reader.LITTLE, value: 0x1234_5678, back: 0x678, word: 0x6600_0c00},
        Case{field: ?LDST, range: range(wrap, 12, 8), order: reader.LITTLE, value: 0x1234_5ab8, back: 0xab8, word: 0x5_5c00},
        Case{field: ?LEB5, range: range(unsigned, 32, 1), order: reader.LITTLE, value: 0xdead_beef, back: 0xdead_beef, word: 0xd_7536_7d6f},
        Case{field: ?LEB10, range: range(signed, 64, 1), order: reader.LITTLE, value: -3, back: 0xffff_ffff_ffff_fffd, word: 0x7f7f_7f7f_7f7f_7f7d},
    };
    var i: usize = 0;
    for (i < 13) {
        val c:   *Case       = ?cases[i];
        var ch:  FieldChoice = FieldChoice{field: c.field};
        val r:   Row         = shape_row(?ch, c.range);
        var buf: [16]u8;
        var s:   Site        = Site{file: "a.o", section: ".text", data: ?buf[0], size: 16, order: c.order};
        val put: err[Fail]   = insert(?r, ?s, c.value);
        if (sel put.err) { ret 1; }
        var n: usize = c.field.bytes::usize;
        if (n > 8) { n = 8; }
        var word: u64   = 0;
        var k:    usize = 0;
        for (k < n) {
            word = word | (buf[k]::u64 << (k * 8)::u64);
            k    = k + 1;
        }
        if (word != c.word) { ret 1; }
        val got: res[i64, Fail] = extract(?r, ?s);
        if (sel got.err)           { ret 1; }
        if (got.ok:~u64 != c.back) { ret 1; }

        # zero into a container of ones clears the field's bits and only those
        k = 0;
        for (k < 16) {
            buf[k] = 0xff;
            k      = k + 1;
        }
        val zero: err[Fail] = insert(?r, ?s, 0);
        if (sel zero.err) { ret 1; }
        var clear: u32 = 0;
        k = 0;
        for (k < 16) {
            var bit: u8 = 0;
            for (bit < 8) {
                if (((buf[k] >> bit) & 1) == 0) { clear = clear + 1; }
                bit = bit + 1;
            }
            k = k + 1;
        }
        if (clear != field.width(c.field)) { ret 1; }
        i = i + 1;
    }

    # a LEB128 run spans the encoding already there and keeps what follows it
    var lc:  FieldChoice = FieldChoice{field: ?LEB_RUN};
    val leb: Row         = shape_row(?lc, range(unsigned, 64, 1));
    var run: [6]u8       = [6]u8{0x80, 0x80, 0x00, 0x55, 0x80, 0x00};
    var at:  Site        = Site{file: "a.o", section: ".debug", data: ?run[0], size: 6, order: reader.LITTLE};
    val fit: err[Fail]   = insert(?leb, ?at, 300);
    if (sel fit.err)                                                       { ret 1; }
    if (run[0] != 0xac || run[1] != 0x82 || run[2] != 0 || run[3] != 0x55) { ret 1; }
    val back: res[i64, Fail] = extract(?leb, ?at);
    if (sel back.err)   { ret 1; }
    if (back.ok != 300) { ret 1; }
    val wide: err[Fail] = insert(?leb, ?at, (1::i128) << 21);
    if (sel wide.ok)                  { ret 1; }
    if (!sel wide.err.cause.overflow) { ret 1; }
    at.offset = 4;
    val one: err[Fail] = insert(?leb, ?at, (1::i128) << 14);
    if (sel one.ok)                  { ret 1; }
    if (!sel one.err.cause.overflow) { ret 1; }

    # a move-wide immediate holds a negative value complemented under its own opcode
    var mc:   FieldChoice = FieldChoice{field: ?MOVW};
    val mv:   Row         = shape_row(?mc, range(field.Check.signed{}, 17, 1));
    val want: [2]u32      = [2]u32{0x80, 0x4000_0000 | (0x1234 << 5)};
    val vals: [2]i128     = [2]i128{-5, 0x1234};
    var j:    usize       = 0;
    for (j < 2) {
        var buf: [4]u8;
        var s:   Site      = Site{file: "a.o", section: ".text", data: ?buf[0], size: 4, order: reader.LITTLE};
        val put: err[Fail] = insert(?mv, ?s, vals[j]);
        if (sel put.err) { ret 1; }
        val word: u32 = buf[0]::u32 | (buf[1]::u32 << 8) | (buf[2]::u32 << 16) | (buf[3]::u32 << 24);
        if (word != want[j]) { ret 1; }
        val got: res[i64, Fail] = extract(?mv, ?s);
        if (sel got.err)             { ret 1; }
        if (got.ok::i128 != vals[j]) { ret 1; }
        j = j + 1;
    }
    var big: [4]u8;
    var bs:  Site      = Site{file: "a.o", section: ".text", data: ?big[0], size: 4, order: reader.LITTLE};
    val far: err[Fail] = insert(?mv, ?bs, 0x1_0000);
    if (sel far.ok) { ret 1; }
    ret 0;
}

test engine__out_of_range_value_is_refused_with_its_location {
    var bc:  FieldChoice = FieldChoice{field: ?BRANCH};
    val r:   Row         = shape_row(?bc, range(field.Check.signed{}, 28, 4));
    var buf: [8]u8       = [8]u8{0, 0, 0, 0, 0, 0, 0, 0x94};
    var s:   Site        = Site{file: "a.o", section: ".text", data: ?buf[0], size: 8, base: 0x40, offset: 4, order: reader.LITTLE};
    val x:   Inputs      = Inputs{s: 0x900_0000, p: 0x1000, page: 0x1000, width: opt[u8].some{8}};
    val far: err[Fail]   = apply(?r, ?s, ?x);
    if (sel far.ok)                                      { ret 1; }
    if (!sel far.err.cause.overflow)                     { ret 1; }
    if (far.err.at.file != s.file)                       { ret 1; }
    if (far.err.at.record != s.section)                  { ret 1; }
    if (!far.err.at.placed || far.err.at.offset != 0x44) { ret 1; }
    if (buf[7] != 0x94)                                  { ret 1; }
    ret 0;
}

test engine__a_value_wraps_to_the_address_width_before_its_range_check {
    var dc:  FieldChoice = FieldChoice{field: ?DATA32};
    val r:   Row         = shape_row(?dc, range(field.Check.signed{}, 32, 1));
    var buf: [4]u8       = [4]u8{0, 0, 0, 0};
    var s:   Site        = Site{file: "a.o", section: ".text", data: ?buf[0], size: 4, order: reader.LITTLE};
    val top: Inputs      = Inputs{s: 0xffff_ffff_8000_0010, width: opt[u8].some{8}};
    val ok:  err[Fail]   = apply(?r, ?s, ?top);
    if (sel ok.err)                                                     { ret 1; }
    if (buf[0] != 0x10 || buf[1] != 0 || buf[2] != 0 || buf[3] != 0x80) { ret 1; }
    val below: Inputs    = Inputs{s: 0xffff_ffff_7fff_fff0, width: opt[u8].some{8}};
    val far:   err[Fail] = apply(?r, ?s, ?below);
    if (sel far.ok)                       { ret 2; }
    if (!sel far.err.cause.overflow)      { ret 2; }
    if (buf[0] != 0x10 || buf[3] != 0x80) { ret 2; }
    val bare:     Inputs    = Inputs{s: 0x10};
    val unstated: err[Fail] = apply(?r, ?s, ?bare);
    if (sel unstated.ok)                  { ret 3; }
    if (!sel unstated.err.cause.internal) { ret 3; }
    ret 0;
}

val HI_KEYS:  [1]u32 = [1]u32{1};
val UNS_KEYS: [1]u32 = [1]u32{4};

val HI_ONLY:     [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?HI}};
val LO_S_ONLY:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?LO_S}};
val DATA64_ONLY: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?DATA64}};

val HI_KIND:  Kind = Kind{name: "hi", caps: reloc.PC, takes: ?reloc.NAMED};
val LO_KIND:  Kind = Kind{name: "lo", caps: reloc.PC | reloc.PARTNER, takes: ?reloc.NAMED};
val SUB_KIND: Kind = Kind{name: "sub", caps: reloc.ABS | reloc.PARTNER, takes: ?reloc.NAMED};

val SIGNED32: Range = Range{check: field.Check.signed{}, bits: 32, align: 1};
val LOW12:    Range = Range{check: field.Check.wrap{}, bits: 12, align: 1};

val PAIRED: [4]Row = [4]Row{
    Row{key: 1, name: "hi", kind: ?HI_KIND, fields: ?HI_ONLY[0], field_count: 1, value: ?compute.PC, range: SIGNED32},
    Row{
        key:         2,
        name:        "lo",
        kind:        ?LO_KIND,
        fields:      ?LO_S_ONLY[0],
        field_count: 1,
        value:       ?compute.PC,
        range:       LOW12,
        pair:        opt[row.PairRule].some{row.PairRule{link: row.Link.label{}, keys: ?HI_KEYS[0], count: 1, role: row.Role.hi_part{}}},
    },
    Row{
        key:         3,
        name:        "sub",
        kind:        ?SUB_KIND,
        fields:      ?DATA64_ONLY[0],
        field_count: 1,
        value:       ?compute.SUB,
        range:       SIGNED32,
        pair:        opt[row.PairRule].some{row.PairRule{link: row.Link.next{}, keys: ?UNS_KEYS[0], count: 1, role: row.Role.minus{}}},
    },
    Row{key: 4, name: "uns", kind: ?reloc.ABS64, fields: ?DATA64_ONLY[0], field_count: 1, value: ?compute.ABS, range: SIGNED32},
};
val PAIRED_KINDS: [4]*Kind = [4]*Kind{?HI_KIND, ?LO_KIND, ?SUB_KIND, ?reloc.ABS64};

test engine__paired_row_finds_its_partner_and_unmatched_is_refused {
    var tt:   T.Testing;
    val made: err[A.Error] = T.make(?tt);
    if (sel made.err) { ret 1; }
    var slots: Table[Slot]             = table.make[Slot](T.allocator_of(?tt));
    val set:   Set                     = Set{format: ?format.ELF, arch: ?x86.X86_64, rows: ?PAIRED[0], count: 4, kinds: ?PAIRED_KINDS[0], kind_count: 4};
    val sets:  [1]*Set                 = [1]*Set{?set};
    var good:  res[row.Registry, Fail] = row.make(T.allocator_of(?tt), ?sets[0], 1);
    if (sel good.err) { ret 1; }
    val at:    Location = Location{file: "a.o", offset: 0x108, placed: true};
    val marks: [4]Mark  = [4]Mark{
        Mark{row: ?PAIRED[0], place: 0x100},
        Mark{row: ?PAIRED[1], place: 0x108, label: 0x100},
        Mark{row: ?PAIRED[2], place: 0x200},
        Mark{row: ?PAIRED[3], place: 0x200},
    };
    val ordered: err[Fail] = order(?marks[0], 4, ?slots);
    if (sel ordered.err) { ret 1; }
    val lo: res[usize, Fail] = partner(?marks[0], 4, ?slots, 1, at);
    if (sel lo.err) { ret 1; }
    if (lo.ok != 0) { ret 1; }
    val sub: res[usize, Fail] = partner(?marks[0], 4, ?slots, 2, at);
    if (sel sub.err) { ret 1; }
    if (sub.ok != 3) { ret 1; }

    val lone: [2]Mark = [2]Mark{
        Mark{row: ?PAIRED[1], place: 0x108, label: 0x104},
        Mark{row: ?PAIRED[2], place: 0x200},
    };
    val reordered: err[Fail] = order(?lone[0], 2, ?slots);
    if (sel reordered.err) { ret 1; }
    val nolo: res[usize, Fail] = partner(?lone[0], 2, ?slots, 0, at);
    if (sel nolo.ok)                   { ret 1; }
    if (!sel nolo.err.cause.malformed) { ret 1; }
    if (nolo.err.at.offset != 0x108)   { ret 1; }
    val nosub: res[usize, Fail] = partner(?lone[0], 2, ?slots, 1, at);
    if (sel nosub.ok) { ret 1; }
    val rel: err[Fail] = table.release[Slot](?slots);
    if (sel rel.err) { ret 1; }
    val freed: err[Fail] = row.release(?good.ok);
    if (sel freed.err) { ret 1; }
    T.dnit(?tt);
    ret 0;
}

# two forms of one relocation told apart by bit 31 of the instruction: a
# 16-bit field low and a 12-bit field shifted by four
val FORM_LOW_PIECES:  [1]Piece       = [1]Piece{Piece{at: 0, width: 16}};
val FORM_HIGH_PIECES: [1]Piece       = [1]Piece{Piece{at: 4, width: 12}};
val FORM_LOW:         Field          = Field{bytes: 4, pieces: ?FORM_LOW_PIECES[0], count: 1, insn: true};
val FORM_HIGH:        Field          = Field{bytes: 4, pieces: ?FORM_HIGH_PIECES[0], count: 1, insn: true};
val FORMS:            [2]FieldChoice = [2]FieldChoice{
    FieldChoice{insn_mask: 0x8000_0000, insn_value: 0, field: ?FORM_LOW},
    FieldChoice{insn_mask: 0x8000_0000, insn_value: 0x8000_0000, field: ?FORM_HIGH},
};
val BIASED: Row = Row{
    key:         1,
    name:        "biased",
    kind:        ?reloc.PC32,
    fields:      ?FORMS[0],
    field_count: 2,
    value:       ?compute.PC,
    range:       Range{check: field.Check.signed{}, bits: 12, align: 1},
    bias:        -2,
};

test engine__the_instruction_chooses_the_field_and_the_addend_carries_the_bias {
    val x:   Inputs    = Inputs{s: 0x1010, p: 0x1000, width: opt[u8].some{8}};
    var low: [4]u8     = [4]u8{0, 0, 0, 0};
    var s:   Site      = Site{file: "a.o", section: ".text", data: ?low[0], size: 4, order: reader.LITTLE};
    val a:   err[Fail] = apply(?BIASED, ?s, ?x);
    if (sel a.err)                     { ret 1; }
    if (low[0] != 0x10 || low[1] != 0) { ret 2; }
    var high: [4]u8     = [4]u8{0, 0, 0, 0x80};
    var t:    Site      = Site{file: "a.o", section: ".text", data: ?high[0], size: 4, order: reader.LITTLE};
    val b:    err[Fail] = apply(?BIASED, ?t, ?x);
    if (sel b.err)                                          { ret 3; }
    if (high[0] != 0x00 || high[1] != 1 || high[3] != 0x80) { ret 4; }
    # the field counts from past itself, so it holds the neutral addend less
    # the bias and reads back as the neutral addend
    val w: err[Fail] = put_addend(?BIASED, ?s, -2);
    if (sel w.err)                  { ret 5; }
    if (low[0] != 0 || low[1] != 0) { ret 5; }
    val back: res[i64, Fail] = addend(?BIASED, ?s, 0);
    if (sel back.err)  { ret 6; }
    if (back.ok != -2) { ret 6; }
    ret 0;
}

val SCALED_ONLY: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?LDST, align: 8}};
val SCALED:      Row            = Row{key: 1, name: "scaled", kind: ?reloc.ABS32, fields: ?SCALED_ONLY[0], field_count: 1, value: ?compute.ABS, range: Range{check: field.Check.wrap{}, bits: 64, align: 1}};

test engine__a_choice_refuses_a_value_off_its_own_alignment {
    var b:    [4]u8     = [4]u8{0, 0, 0, 0};
    var s:    Site      = Site{file: "a.o", section: ".text", data: ?b[0], size: 4, order: reader.LITTLE};
    val skew: err[Fail] = insert(?SCALED, ?s, 0x1004);
    if (sel skew.ok)                                                              { ret 1; }
    if (!sel skew.err.cause.malformed || !str_equals(skew.err.subject, "scaled")) { ret 1; }
    if (b[0] != 0 || b[1] != 0 || b[2] != 0 || b[3] != 0)                         { ret 1; }
    val kept: err[Fail] = insert(?SCALED, ?s, 0x1008);
    if (sel kept.err) { ret 2; }
    val back: res[i64, Fail] = extract(?SCALED, ?s);
    if (sel back.err) { ret 2; }
    if (back.ok != 8) { ret 2; }
    ret 0;
}

val ADR21:      Field          = Field{bytes: 4, pieces: ?PAGE_PIECES[0], count: 2, insn: true};
val PAGED_ONLY: [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?PAGE}};
val PAGED:      Row            = Row{key: 1, name: "paged", kind: ?reloc.ABS32, fields: ?PAGED_ONLY[0], field_count: 1, value: ?compute.PAGE, range: Range{check: field.Check.signed{}, bits: 33, align: 0x1000}, addend: row.Addend.held{?ADR21}};

test engine__a_held_addend_round_trips_apart_from_the_value_s_field {
    var b: [4]u8     = [4]u8{0, 0, 0, 0x90};
    var s: Site      = Site{file: "a.o", section: ".text", data: ?b[0], size: 4, order: reader.LITTLE};
    val w: err[Fail] = put_addend(?PAGED, ?s, -0x123);
    if (sel w.err) { ret 1; }
    val a: res[i64, Fail] = addend(?PAGED, ?s, 0);
    if (sel a.err)          { ret 1; }
    if (a.ok != -0x123)     { ret 1; }
    if ((b[3] & 0x80) == 0) { ret 1; }
    val v: err[Fail] = insert(?PAGED, ?s, -0x5000);
    if (sel v.err) { ret 2; }
    val back: res[i64, Fail] = extract(?PAGED, ?s);
    if (sel back.err)       { ret 2; }
    if (back.ok != -0x5000) { ret 2; }
    val wide: err[Fail] = put_addend(?PAGED, ?s, 0x10_0000);
    if (sel wide.ok) { ret 3; }
    ret 0;
}

val DATA32_ONLY:   [1]FieldChoice = [1]FieldChoice{FieldChoice{field: ?DATA32}};
val UNDEFINED_ROW: Row            = Row{key: 1, name: "undefined", kind: ?reloc.ABS32, fields: ?DATA32_ONLY[0], field_count: 1, value: ?compute.UNDEFINED, range: Range{check: field.Check.wrap{}, bits: 32, align: 1}};

test engine__a_row_with_no_defined_value_is_refused_naming_it {
    val x: Inputs    = Inputs{s: 0x1010, p: 0x1000};
    var b: [4]u8     = [4]u8{0, 0, 0, 0};
    var s: Site      = Site{file: "a.o", section: ".text", data: ?b[0], size: 4, order: reader.LITTLE};
    val e: err[Fail] = apply(?UNDEFINED_ROW, ?s, ?x);
    if (sel e.ok)                                                                { ret 1; }
    if (!sel e.err.cause.unsupported || !str_equals(e.err.subject, "undefined")) { ret 1; }
    if (e.err.at.file == nil || !str_equals(e.err.at.file, "a.o"))               { ret 1; }
    ret 0;
}
