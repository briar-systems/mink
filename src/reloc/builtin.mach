# the relocation sets mink is built with
#
# a set lives in the module of its format, and this list names them, one line
# each, so a format module can use the row shape without depending on the list.

use A: std.allocator;
use std.types.result.res;
use std.types.size.usize;

use mink.elf.reloc.aarch64;
use mink.elf.reloc.riscv;
use mink.elf.reloc.x86;
use mink.fail.Fail;
use mink.reloc.row;
use mink.reloc.row.Registry;
use mink.reloc.row.Set;

val COUNT: usize       = 5;
val SETS:  [COUNT]*Set = [COUNT]*Set{?aarch64.SET, ?riscv.RV64, ?riscv.RV32, ?x86.X86_64, ?x86.X86};

pub fun registry(a: *A.Allocator) res[Registry, Fail] {
    ret row.make(a, ?SETS[0], COUNT);
}
