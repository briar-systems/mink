# the one file layout every format writer sizes its output through
#
# a writer places every region it will write in a Plan, seals it, allocates
# exactly the sealed total once, and writes each region at the offset the plan
# recorded. nothing after sealing recomputes an offset: sealing moves the
# regions into a Layout, which has queries and no mutator. a region written
# through a running cursor is closed against its planned end, so a measure pass
# and a write pass that drift apart is a failure, never a corrupt file.
#
# placement is checked and a refusal names its region. nothing is clamped.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;

use mink.lib.checked;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;
use mink.lib.table;
use mink.lib.table.Id;
use mink.lib.table.Table;

# the largest size of a format with 32-bit offsets and sizes
pub val LIMIT_32: u64 = 0xffff_ffff;

# the largest size a 64-bit format can carry
pub val LIMIT_64: u64 = 0xffff_ffff_ffff_ffff;

# label:   what the region is, for diagnostics
# section: the section that owns the region, when one does
# align:   the alignment the region was placed at
# offset:  where the region starts in the file
# size:    how many bytes the region holds
pub rec Region {
    label:   str;
    section: opt[u32];
    align:   u64;
    offset:  u64;
    size:    u64;
}

# regions: what has been placed, in order
# cursor:  the next unplaced offset
# limit:   the largest end any region may have
# sealed:  whether the plan was sealed
pub rec Plan {
    regions: Table[Region];
    cursor:  u64;
    limit:   u64;
    sealed:  bool;
}

# a sealed plan: every offset is fixed
# ---
# regions: the placed regions, in order
# total:   the size of the file
pub rec Layout {
    regions: Table[Region];
    total:   u64;
}

# a plan of a format whose regions end at or before `limit`
pub fun make(a: *A.Allocator, limit: u64) Plan {
    ret Plan{regions: table.make[Region](a), limit: limit};
}

# place a region at the next offset that satisfies `align`, the gap padding
pub fun place(p: *Plan, label: str, section: opt[u32], align: u64, size: u64) res[Id[Region], Fail] {
    val open: err[Fail] = unsealed(p, label);
    if (sel open.err) { ret res[Id[Region], Fail].err{open.err}; }
    val offset: res[u64, Fail] = checked.align_up(at(label), p.cursor, align);
    if (sel offset.err) { ret res[Id[Region], Fail].err{offset.err}; }
    ret push(p, Region{label: label, section: section, align: align, offset: offset.ok, size: size});
}

# place a region at the stated `offset`, the gap padding. it may not start
# before the end of the regions ahead of it
pub fun place_at(p: *Plan, label: str, section: opt[u32], offset: u64, size: u64) res[Id[Region], Fail] {
    val open: err[Fail] = unsealed(p, label);
    if (sel open.err) { ret res[Id[Region], Fail].err{open.err}; }
    if (offset < p.cursor) {
        ret res[Id[Region], Fail].err{named(fail.malformed("region starts before the regions ahead of it end"), label, offset)};
    }
    ret push(p, Region{label: label, section: section, align: 1, offset: offset, size: size});
}

# advance the cursor to a multiple of `align` without placing a region
pub fun pad(p: *Plan, label: str, align: u64) err[Fail] {
    val open: err[Fail] = unsealed(p, label);
    if (sel open.err) { ret open; }
    val offset: res[u64, Fail] = checked.align_up(at(label), p.cursor, align);
    if (sel offset.err) { ret err[Fail].err{offset.err}; }
    ret advance(p, label, offset.ok);
}

# advance the cursor to `offset` without placing a region
pub fun pad_to(p: *Plan, label: str, offset: u64) err[Fail] {
    val open: err[Fail] = unsealed(p, label);
    if (sel open.err) { ret open; }
    if (offset < p.cursor) {
        ret err[Fail].err{named(fail.malformed("padding starts before the regions ahead of it end"), label, offset)};
    }
    ret advance(p, label, offset);
}

# fix every offset. the plan is spent and its regions are the layout's
pub fun seal(p: *Plan) res[Layout, Fail] {
    val open: err[Fail] = unsealed(p, "plan");
    if (sel open.err) { ret res[Layout, Fail].err{open.err}; }
    val l: Layout = Layout{regions: p.regions, total: p.cursor};
    p.regions = table.make[Region](p.regions.a);
    p.sealed  = true;
    ret res[Layout, Fail].ok{l};
}

# the next unplaced offset
pub fun cursor(p: *Plan) u64 {
    ret p.cursor;
}

# a region placed in `p`, for a writer that sizes a later region from it
pub fun region(p: *Plan, id: Id[Region]) Region {
    ret @table.at[Region](?p.regions, id);
}

pub fun release(p: *Plan) err[Fail] {
    ret table.release[Region](?p.regions);
}

pub fun total(l: *Layout) u64 {
    ret l.total;
}

pub fun region_of(l: *Layout, id: Id[Region]) Region {
    ret @table.at[Region](?l.regions, id);
}

pub fun offset(l: *Layout, id: Id[Region]) u64 {
    ret region_of(l, id).offset;
}

pub fun size(l: *Layout, id: Id[Region]) u64 {
    ret region_of(l, id).size;
}

pub fun end(l: *Layout, id: Id[Region]) u64 {
    val r: Region = region_of(l, id);
    ret r.offset + r.size;
}

# the address of a region in a mapping: `address_base` plus the region's
# distance from `file_base` in the file
pub fun address(l: *Layout, id: Id[Region], file_base: u64, address_base: u64) res[u64, Fail] {
    val r:     Region         = region_of(l, id);
    val delta: res[u64, Fail] = checked.sub(at(r.label), r.offset, file_base);
    if (sel delta.err) { ret delta; }
    ret checked.add(at(r.label), address_base, delta.ok);
}

# a region written through a running cursor ends where it was planned to
pub fun close(l: *Layout, id: Id[Region], cursor: u64) err[Fail] {
    val r: Region = region_of(l, id);
    if (cursor != r.offset + r.size) {
        ret err[Fail].err{named(fail.malformed("cursor is not at the planned end of the region"), r.label, cursor)};
    }
    ret err[Fail].ok{};
}

# a region filled by a writer that reports the bytes it produced
pub fun close_size(l: *Layout, id: Id[Region], written: u64) err[Fail] {
    val r: Region = region_of(l, id);
    if (written != r.size) {
        ret err[Fail].err{named(fail.malformed("written size is not the planned size of the region"), r.label, written)};
    }
    ret err[Fail].ok{};
}

pub fun release_layout(l: *Layout) err[Fail] {
    ret table.release[Region](?l.regions);
}

pub fun field_u8(what: str, v: u64) res[u8, Fail] {
    if (v > 0xff) { ret res[u8, Fail].err{narrowing(what, v, "value exceeds an 8-bit field")}; }
    ret res[u8, Fail].ok{v::u8};
}

pub fun field_u16(what: str, v: u64) res[u16, Fail] {
    if (v > 0xffff) { ret res[u16, Fail].err{narrowing(what, v, "value exceeds a 16-bit field")}; }
    ret res[u16, Fail].ok{v::u16};
}

pub fun field_u32(what: str, v: u64) res[u32, Fail] {
    if (v > 0xffff_ffff) { ret res[u32, Fail].err{narrowing(what, v, "value exceeds a 32-bit field")}; }
    ret res[u32, Fail].ok{v::u32};
}

fun at(label: str) Location {
    ret Location{record: label};
}

fun named(f: Fail, label: str, offset: u64) Fail {
    ret fail.at_offset(fail.in_record(f, label), offset);
}

fun narrowing(what: str, v: u64, text: str) Fail {
    ret fail.in_record(fail.overflow(text), what);
}

fun unsealed(p: *Plan, label: str) err[Fail] {
    if (p.sealed) { ret err[Fail].err{fail.in_record(fail.malformed("plan is sealed"), label)}; }
    ret err[Fail].ok{};
}

fun advance(p: *Plan, label: str, offset: u64) err[Fail] {
    if (offset > p.limit) {
        ret err[Fail].err{named(fail.overflow("offset exceeds the format's size limit"), label, offset)};
    }
    p.cursor = offset;
    ret err[Fail].ok{};
}

fun push(p: *Plan, r: Region) res[Id[Region], Fail] {
    val end: res[u64, Fail] = checked.add(at(r.label), r.offset, r.size);
    if (sel end.err) { ret res[Id[Region], Fail].err{end.err}; }
    if (end.ok > p.limit) {
        ret res[Id[Region], Fail].err{named(fail.overflow("region exceeds the format's size limit"), r.label, r.offset)};
    }
    val id: res[Id[Region], Fail] = table.push[Region](?p.regions, r);
    if (sel id.err) { ret id; }
    p.cursor = end.ok;
    ret id;
}

test plan__places_regions_in_order_with_alignment_and_padding {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var p: Plan = make(T.allocator_of(?t), LIMIT_32);

    val none: opt[u32]              = opt[u32].none{};
    val a:    res[Id[Region], Fail] = place(?p, "header", none, 1, 3);
    if (sel a.err) { ret 1; }
    val b: res[Id[Region], Fail] = place(?p, "text", opt[u32].some{7}, 8, 4);
    if (sel b.err) { ret 1; }
    val padded: err[Fail] = pad(?p, "gap", 16);
    if (sel padded.err) { ret 1; }
    val c: res[Id[Region], Fail] = place_at(?p, "data", none, 40, 5);
    if (sel c.err) { ret 1; }
    val early: res[Id[Region], Fail] = place_at(?p, "early", none, 44, 1);
    if (sel early.ok) { ret 1; }

    if (region(?p, b.ok).align != 8) { ret 1; }
    val sealed: res[Layout, Fail] = seal(?p);
    if (sel sealed.err) { ret 1; }
    var l: Layout = sealed.ok;
    if (total(?l) != 45)        { ret 1; }
    if (offset(?l, a.ok) != 0)  { ret 1; }
    if (offset(?l, b.ok) != 8)  { ret 1; }
    if (end(?l, b.ok) != 12)    { ret 1; }
    if (offset(?l, c.ok) != 40) { ret 1; }
    if (size(?l, c.ok) != 5)    { ret 1; }
    val addr: res[u64, Fail] = address(?l, c.ok, 8, 0x1000);
    if (sel addr.err)      { ret 1; }
    if (addr.ok != 0x1020) { ret 1; }
    val rr: Region = region_of(?l, b.ok);
    if (sel rr.section.none)  { ret 1; }
    if (rr.section.some != 7) { ret 1; }

    val closed: err[Fail] = close(?l, c.ok, 45);
    if (sel closed.err) { ret 1; }
    val drift: err[Fail] = close(?l, c.ok, 44);
    if (sel drift.ok)                             { ret 1; }
    if (!str_equals(drift.err.at.record, "data")) { ret 1; }
    val again: res[Layout, Fail] = seal(?p);
    if (sel again.ok) { ret 1; }
    val late: res[Id[Region], Fail] = place(?p, "late", none, 1, 1);
    if (sel late.ok) { ret 1; }

    val r1: err[Fail] = release_layout(?l);
    if (sel r1.err) { ret 1; }
    val r2: err[Fail] = release(?p);
    if (sel r2.err)            { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test plan__refuses_a_bad_alignment_naming_the_region {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var p:    Plan     = make(T.allocator_of(?t), LIMIT_64);
    val none: opt[u32] = opt[u32].none{};

    val zero: res[Id[Region], Fail] = place(?p, "zeroed", none, 0, 1);
    if (sel zero.ok)                               { ret 1; }
    if (!str_equals(zero.err.at.record, "zeroed")) { ret 1; }
    val three: res[Id[Region], Fail] = place(?p, "odd", none, 3, 1);
    if (sel three.ok)                            { ret 1; }
    if (!sel three.err.cause.malformed)          { ret 1; }
    if (!str_equals(three.err.at.record, "odd")) { ret 1; }
    val padded: err[Fail] = pad(?p, "gap", 6);
    if (sel padded.ok)                        { ret 1; }
    if (table.count[Region](?p.regions) != 0) { ret 1; }

    val rel: err[Fail] = release(?p);
    if (sel rel.err) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test plan__refuses_an_overflowing_offset_or_size {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var wide: Plan     = make(T.allocator_of(?t), LIMIT_64);
    val none: opt[u32] = opt[u32].none{};

    val big: res[Id[Region], Fail] = place(?wide, "big", none, 1, LIMIT_64 - 8);
    if (sel big.err) { ret 1; }
    val past: res[Id[Region], Fail] = place(?wide, "past", none, 1, 16);
    if (sel past.ok)                             { ret 1; }
    if (!sel past.err.cause.overflow)            { ret 1; }
    if (!str_equals(past.err.at.record, "past")) { ret 1; }
    val round: res[Id[Region], Fail] = place(?wide, "round", none, 16, 1);
    if (sel round.ok)                  { ret 1; }
    if (!sel round.err.cause.overflow) { ret 1; }
    if (cursor(?wide) != LIMIT_64 - 8) { ret 1; }

    var narrow: Plan                  = make(T.allocator_of(?t), LIMIT_32);
    val huge:   res[Id[Region], Fail] = place(?narrow, "huge", none, 1, 0x1_0000_0000);
    if (sel huge.ok)                             { ret 1; }
    if (!sel huge.err.cause.overflow)            { ret 1; }
    if (!str_equals(huge.err.at.record, "huge")) { ret 1; }

    val r1: err[Fail] = release(?wide);
    if (sel r1.err) { ret 1; }
    val r2: err[Fail] = release(?narrow);
    if (sel r2.err) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test plan__refuses_a_value_past_its_field_width {
    val ok32: res[u32, Fail] = field_u32("count", 0xffff_ffff);
    if (sel ok32.err)           { ret 1; }
    if (ok32.ok != 0xffff_ffff) { ret 1; }
    val bad32: res[u32, Fail] = field_u32("count", 0x1_0000_0000);
    if (sel bad32.ok)                              { ret 1; }
    if (!str_equals(bad32.err.at.record, "count")) { ret 1; }
    val bad16: res[u16, Fail] = field_u16("shnum", 0x1_0000);
    if (sel bad16.ok) { ret 1; }
    val ok16: res[u16, Fail] = field_u16("shnum", 0xffff);
    if (sel ok16.err) { ret 1; }
    val bad8: res[u8, Fail] = field_u8("class", 256);
    if (sel bad8.ok)                  { ret 1; }
    if (!sel bad8.err.cause.overflow) { ret 1; }
    ret 0;
}
