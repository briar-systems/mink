# the one row shape of every relocation table
#
# a row joins two halves. the format half is a format's relocation code and
# name and the neutral kind it maps to. the architecture half is how that kind
# is applied to bytes: the field shape, the value computation, the range, the
# partner it needs, where its addend lives and how it relaxes. the shape names
# no format and no architecture, and nothing branches on which a row belongs
# to. a set is the rows of one (format, architecture) pair, and a registry
# holds the sets, checking each as it registers.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use T: std.allocator.testing;

use mink.lib.catalog.arch;
use mink.lib.catalog.arch.Arch;
use mink.lib.catalog.format;
use mink.lib.catalog.format.Format;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.model.reloc;
use mink.lib.model.reloc.Kind;
use mink.lib.reloc.compute;
use mink.lib.reloc.compute.Computation;
use mink.lib.reloc.field;
use mink.lib.reloc.field.Field;
use mink.lib.reloc.field.Piece;
use mink.lib.reloc.field.Range;
use mink.lib.table;
use mink.lib.table.Id;
use mink.lib.table.Table;

# where the addend lives
# ---
# field:  in the bytes the relocation patches, as REL records keep it
# record: in the relocation record, as RELA records keep it
pub tag Addend: u8 {
    field;
    record;
}

# where a row's partner is found
# ---
# label:    at the place the row's target labels, as a split low half finds
#           the upper half it completes
# next:     the record after, at the same place
# previous: the record before, at the same place
pub tag Link: u8 {
    label;
    next;
    previous;
}

# a partner the row needs
# ---
# link:  where the partner is found
# codes: the codes a partner may have
# count: how many codes
pub rec Pair {
    link:  Link;
    codes: *u32;
    count: usize;
}

# the form a row relaxes to
# ---
# to:    the code of the relaxed row
# keeps: whether the relaxed form keeps the constant-time class of the code it
#        rewrites. one that does not is never applied to constant-time code
pub rec Relax {
    to:    u32;
    keeps: bool;
}

# code:   the format's relocation code
# name:   the format's name for the code
# kind:   the neutral kind the code maps to
# field:  the field the value is written to
# value:  the computation giving the value
# range:  the values the field accepts
# addend: where the addend lives
# pair:   the partner the row needs, none when it stands alone
# relax:  the form the row relaxes to, none when it cannot
pub rec Row {
    code:   u32;
    name:   str;
    kind:   *Kind;
    field:  *Field;
    value:  *Computation;
    range:  Range;
    addend: Addend;
    pair:   opt[Pair];
    relax:  opt[Relax];
}

# the rows of one (format, architecture) pair
# ---
# format: the format whose codes the rows carry
# arch:   the architecture whose bytes the rows patch
# rows:   the rows, static
# count:  how many rows
pub rec Set {
    format: *Format;
    arch:   *Arch;
    rows:   *Row;
    count:  usize;
}

# the row of `code`
pub fun by_code(s: *Set, code: u32) res[*Row, Fail] {
    var i: usize = 0;
    for (i < s.count) {
        if (s.rows[i].code == code) { ret res[*Row, Fail].ok{?s.rows[i]}; }
        i = i + 1;
    }
    ret res[*Row, Fail].err{fail.unsupported("no relocation row has this code")};
}

# the row mapping to `k`
pub fun by_kind(s: *Set, k: *Kind) res[*Row, Fail] {
    var i: usize = 0;
    for (i < s.count) {
        if (s.rows[i].kind == k) { ret res[*Row, Fail].ok{?s.rows[i]}; }
        i = i + 1;
    }
    ret res[*Row, Fail].err{fail.unsupported("no relocation row has this kind")};
}

# the row `r` relaxes to, refused when it cannot relax or, in code marked
# constant-time, when the relaxed form would change its timing class
pub fun relaxed(s: *Set, r: *Row, constant_time: bool) res[*Row, Fail] {
    if (sel r.relax.none) { ret res[*Row, Fail].err{fail.unsupported("relocation cannot be relaxed")}; }
    val x: Relax = r.relax.some;
    if (constant_time && !x.keeps) {
        ret res[*Row, Fail].err{fail.unsupported("relaxation would change the timing of constant-time code")};
    }
    ret by_code(s, x.to);
}

# refuse a set with a malformed row: a field wider than its container, pieces
# that overlap, a range the field cannot hold, a partner or relaxed form with
# no row, or a code or kind that two rows share
pub fun check(s: *Set) err[Fail] {
    var i: usize = 0;
    for (i < s.count) {
        val e: err[Fail] = sound(s, i);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "relocation row", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun sound(s: *Set, i: usize) err[Fail] {
    val f: err[Fail] = shape(?s.rows[i]);
    if (sel f.err) { ret f; }
    val l: err[Fail] = links(s, ?s.rows[i]);
    if (sel l.err) { ret l; }
    ret unique(s, i);
}

fun shape(r: *Row) err[Fail] {
    val f: *Field = r.field;
    if (f.bytes > field.MAX_BYTES) { ret err[Fail].err{fail.malformed("relocation field container is too wide")}; }
    val bits: u32 = f.bytes::u32 * 8;
    var i:    u8  = 0;
    for (i < f.count) {
        val p: *Piece = ?f.pieces[i];
        if (p.width == 0 || p.at::u32 + p.width::u32 > bits) {
            ret err[Fail].err{fail.malformed("relocation field is wider than its container")};
        }
        var j: u8 = 0;
        for (j < i) {
            val q: *Piece = ?f.pieces[j];
            if (p.at < q.at + q.width && q.at < p.at + p.width) {
                ret err[Fail].err{fail.malformed("relocation field bit ranges overlap")};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    val g: Range = r.range;
    if (g.align == 0 || (g.align & (g.align - 1)) != 0) {
        ret err[Fail].err{fail.malformed("relocation alignment is not a power of two")};
    }
    if (sel g.check.wrap) { ret err[Fail].ok{}; }
    if (g.bits == 0 || g.bits > 64 || g.bits::u32 > f.shift::u32 + field.width(f)) {
        ret err[Fail].err{fail.malformed("relocation range does not fit its field")};
    }
    ret err[Fail].ok{};
}

fun links(s: *Set, r: *Row) err[Fail] {
    if (sel r.pair.some) {
        val p: Pair  = r.pair.some;
        var k: usize = 0;
        for (k < p.count) {
            val m: res[*Row, Fail] = by_code(s, p.codes[k]);
            if (sel m.err) { ret err[Fail].err{fail.malformed("relocation partner has no row")}; }
            k = k + 1;
        }
    }
    if (sel r.relax.some) {
        val m: res[*Row, Fail] = by_code(s, r.relax.some.to);
        if (sel m.err) { ret err[Fail].err{fail.malformed("relaxed relocation has no row")}; }
    }
    ret err[Fail].ok{};
}

# a code or a kind the row at `i` shares with a later row
fun unique(s: *Set, i: usize) err[Fail] {
    var j: usize = i + 1;
    for (j < s.count) {
        if (s.rows[j].code == s.rows[i].code) { ret err[Fail].err{fail.malformed("relocation code has two rows")}; }
        if (s.rows[j].kind == s.rows[i].kind) { ret err[Fail].err{fail.malformed("relocation kind has two rows")}; }
        j = j + 1;
    }
    ret err[Fail].ok{};
}

# the sets registered, one per (format, architecture) pair
pub rec Registry {
    sets: Table[*Set];
}

pub fun make(a: *A.Allocator) Registry {
    ret Registry{sets: table.make[*Set](a)};
}

# check `s` and hold it, refusing a malformed set or a pair already bound
pub fun register(g: *Registry, s: *Set) err[Fail] {
    val c: err[Fail] = check(s);
    if (sel c.err) { ret c; }
    val held: res[*Set, Fail] = find(g, s.format, s.arch);
    if (sel held.ok) { ret err[Fail].err{fail.malformed("relocation set is already registered for this pair")}; }
    val r: res[Id[*Set], Fail] = table.push[*Set](?g.sets, s);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    ret err[Fail].ok{};
}

# the set of the pair (`f`, `a`)
pub fun find(g: *Registry, f: *Format, a: *Arch) res[*Set, Fail] {
    var i: usize = 0;
    for (i < table.count[*Set](?g.sets)) {
        val s: *Set = @table.at[*Set](?g.sets, table.nth[*Set](i));
        if (s.format == f && s.arch == a) { ret res[*Set, Fail].ok{s}; }
        i = i + 1;
    }
    ret res[*Set, Fail].err{fail.unsupported("no relocation set for this format and architecture")};
}

pub fun release(g: *Registry) err[Fail] {
    ret table.release[*Set](?g.sets);
}

val WORD_PIECES: [1]Piece = [1]Piece{Piece{at: 0, width: 32}};
val WORD:        Field    = Field{bytes: 4, pieces: ?WORD_PIECES[0], count: 1};
val WIDE_PIECES: [1]Piece = [1]Piece{Piece{at: 4, width: 32}};
val WIDE:        Field    = Field{bytes: 4, pieces: ?WIDE_PIECES[0], count: 1};
val OVER_PIECES: [2]Piece = [2]Piece{Piece{at: 0, width: 16}, Piece{at: 8, width: 16}};
val OVER:        Field    = Field{bytes: 4, pieces: ?OVER_PIECES[0], count: 2};
val HIGH:        [1]u32   = [1]u32{1};
val MISSING:     [1]u32   = [1]u32{9};

val SIGNED32: Range = Range{check: field.Check.signed{}, bits: 32, align: 1};

val GOOD: [3]Row = [3]Row{
    Row{code: 1, name: "hi", kind: ?reloc.PCREL_HI20, field: ?WORD, value: ?compute.PC, range: SIGNED32},
    Row{
        code:   2,
        name:   "lo",
        kind:   ?reloc.PCREL_LO12_I,
        field:  ?WORD,
        value:  ?compute.PC,
        range:  SIGNED32,
        addend: Addend.record{},
        pair:   opt[Pair].some{Pair{link: Link.label{}, codes: ?HIGH[0], count: 1}},
    },
    Row{
        code:  3,
        name:  "pc",
        kind:  ?reloc.PC32,
        field: ?WORD,
        value: ?compute.PC,
        range: SIGNED32,
        relax: opt[Relax].some{Relax{to: 1, keeps: false}},
    },
};

val TOO_WIDE: [1]Row = [1]Row{
    Row{code: 1, name: "wide", kind: ?reloc.PC32, field: ?WIDE, value: ?compute.PC, range: SIGNED32},
};
val OVERLAP: [1]Row = [1]Row{
    Row{code: 1, name: "over", kind: ?reloc.PC32, field: ?OVER, value: ?compute.PC, range: SIGNED32},
};
val ALONE: [1]Row = [1]Row{
    Row{
        code:  1,
        name:  "alone",
        kind:  ?reloc.PCREL_LO12_I,
        field: ?WORD,
        value: ?compute.PC,
        range: SIGNED32,
        pair:  opt[Pair].some{Pair{link: Link.label{}, codes: ?MISSING[0], count: 1}},
    },
};
val TWICE: [2]Row = [2]Row{
    Row{code: 1, name: "one", kind: ?reloc.PC32, field: ?WORD, value: ?compute.PC, range: SIGNED32},
    Row{code: 1, name: "two", kind: ?reloc.ABS32, field: ?WORD, value: ?compute.ABS, range: SIGNED32},
};

test row__format_half_maps_both_ways {
    val s: Set   = Set{format: ?format.ELF, arch: arch.at(0), rows: ?GOOD[0], count: 3};
    var i: usize = 0;
    for (i < s.count) {
        val r: *Row            = ?GOOD[i];
        val c: res[*Row, Fail] = by_code(?s, r.code);
        if (sel c.err) { ret 1; }
        if (c.ok != r) { ret 1; }
        val k: res[*Row, Fail] = by_kind(?s, r.kind);
        if (sel k.err) { ret 1; }
        if (k.ok != r) { ret 1; }
        i = i + 1;
    }
    val code: res[*Row, Fail] = by_code(?s, 4);
    if (sel code.ok)                     { ret 1; }
    if (!sel code.err.cause.unsupported) { ret 1; }
    val kind: res[*Row, Fail] = by_kind(?s, ?reloc.ABS64);
    if (sel kind.ok) { ret 1; }
    ret 0;
}

test row__registration_refuses_a_malformed_row {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var g:     Registry  = make(T.allocator_of(?t));
    val good:  Set       = Set{format: ?format.ELF, arch: arch.at(0), rows: ?GOOD[0], count: 3};
    val first: err[Fail] = register(?g, ?good);
    if (sel first.err) { ret 1; }
    val found: res[*Set, Fail] = find(?g, ?format.ELF, arch.at(0));
    if (sel found.err)     { ret 1; }
    if (found.ok != ?good) { ret 1; }
    val again: err[Fail] = register(?g, ?good);
    if (sel again.ok) { ret 1; }

    val bad: [4]Set = [4]Set{
        Set{format: ?format.COFF, arch: arch.at(0), rows: ?TOO_WIDE[0], count: 1},
        Set{format: ?format.COFF, arch: arch.at(0), rows: ?OVERLAP[0], count: 1},
        Set{format: ?format.COFF, arch: arch.at(0), rows: ?ALONE[0], count: 1},
        Set{format: ?format.COFF, arch: arch.at(0), rows: ?TWICE[0], count: 2},
    };
    var i: usize = 0;
    for (i < 4) {
        val r: err[Fail] = register(?g, ?bad[i]);
        if (sel r.ok)                   { ret 1; }
        if (!sel r.err.cause.malformed) { ret 1; }
        if (!r.err.at.indexed)          { ret 1; }
        i = i + 1;
    }
    val none: res[*Set, Fail] = find(?g, ?format.COFF, arch.at(0));
    if (sel none.ok) { ret 1; }

    val done: err[Fail] = release(?g);
    if (sel done.err)          { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
