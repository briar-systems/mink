# the relocation sets mink is built with
#
# a set lives in the module of its format, and this list names them, one line
# each, so a format module can use the row shape without depending on the list.

use std.types.result.res;
use std.types.size.usize;

use mink.lib.elf.reloc.x86;
use mink.lib.fail.Fail;
use mink.lib.reloc.row;
use mink.lib.reloc.row.Registry;
use mink.lib.reloc.row.Set;

val COUNT: usize       = 2;
val SETS:  [COUNT]*Set = [COUNT]*Set{?x86.X86_64, ?x86.X86};

pub fun registry() res[Registry, Fail] {
    ret row.make(?SETS[0], COUNT);
}
