# the relocation sets mink is built with
#
# every (format, architecture) pair mink can relocate is one set here, its only
# footprint outside its own module.

use std.types.result.res;
use std.types.size.usize;

use mink.lib.elf.reloc.riscv;
use mink.lib.fail.Fail;
use mink.lib.reloc.row;
use mink.lib.reloc.row.Registry;
use mink.lib.reloc.row.Set;

val BUILTIN_COUNT: usize               = 2;
val BUILTIN:       [BUILTIN_COUNT]*Set = [BUILTIN_COUNT]*Set{?riscv.RV64, ?riscv.RV32};

# the registry of the sets mink is built with
pub fun builtin() res[Registry, Fail] {
    ret row.make(?BUILTIN[0], BUILTIN_COUNT);
}
