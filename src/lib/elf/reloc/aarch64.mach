val F_LO15:     Field = Field{bytes: 4, pieces: ?P_LO15[0], count: 1, shift: 3, insn: true};
val F_ADDHI12:  Field = Field{bytes: 4, pieces: ?P_ADDHI12[0], count: 1, shift: 12, insn: true};

