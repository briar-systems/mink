# the relocations of the Arm 64-bit ELF ABI, LP64
#
# one row for every relocation the vendored definition file lists, applied as
# RELA records. generated by vendor/llvm/gen-elf-aarch64.py. the instruction
# fields are bit ranges of a 32-bit little endian word, the checked move-wide
# forms hold their sign in the opcode, scaled low-12 forms check the alignment
# of the access, and the dynamic and marker codes hold no static field.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.lib.catalog.arch;
use mink.lib.catalog.format;
use mink.lib.fail.Fail;
use mink.lib.model.reloc;
use mink.lib.reloc.compute;
use mink.lib.reloc.field;
use mink.lib.reloc.field.Field;
use mink.lib.reloc.field.Piece;
use mink.lib.reloc.field.Range;
use mink.lib.reloc.field.Sign;
use mink.lib.reloc.row;
use mink.lib.reloc.row.Addend;
use mink.lib.reloc.row.Relax;
use mink.lib.reloc.row.Row;
use mink.lib.reloc.row.Set;

