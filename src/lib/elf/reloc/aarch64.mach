val P_MOVK3:    [1]Piece = [1]Piece{Piece{at: 5, width: 16}};
val P_MOVN0:    [1]Piece = [1]Piece{Piece{at: 5, width: 16}};
val P_MOVN1:    [1]Piece = [1]Piece{Piece{at: 5, width: 16}};
val P_MOVN2:    [1]Piece = [1]Piece{Piece{at: 5, width: 16}};
val P_LD19:     [1]Piece = [1]Piece{Piece{at: 5, width: 19}};
val P_ADR21:    [2]Piece = [2]Piece{Piece{at: 29, width: 2}, Piece{at: 5, width: 19}};
val P_ADRP:     [2]Piece = [2]Piece{Piece{at: 29, width: 2}, Piece{at: 5, width: 19}};
val P_LO12_1:   [1]Piece = [1]Piece{Piece{at: 10, width: 12}};
val P_BRANCH14: [1]Piece = [1]Piece{Piece{at: 5, width: 14}};
val P_BRANCH26: [1]Piece = [1]Piece{Piece{at: 0, width: 26}};
