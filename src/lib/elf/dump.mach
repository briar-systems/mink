# the field keys of the dump, and the name each one prints, by key
pub val ELF_HEADER:           u32 = 0;
pub val IDENT:                u32 = 1;
pub val CLASS:                u32 = 2;
pub val DATA_ENCODING:        u32 = 3;
pub val FILE_VERSION:         u32 = 4;
pub val OSABI:                u32 = 5;
pub val ABI_VERSION:          u32 = 6;
pub val UNUSED:               u32 = 7;
pub val TYPE:                 u32 = 8;
pub val MACHINE:              u32 = 9;
pub val VERSION:              u32 = 10;
pub val ENTRY:                u32 = 11;
pub val PH_OFFSET:            u32 = 12;
pub val SH_OFFSET:            u32 = 13;
pub val FLAGS:                u32 = 14;
pub val HEADER_SIZE:          u32 = 15;
pub val PH_ENTSIZE:           u32 = 16;
pub val PH_COUNT:             u32 = 17;
pub val SH_ENTSIZE:           u32 = 18;
pub val SH_COUNT:             u32 = 19;
pub val STRTAB_INDEX:         u32 = 20;
pub val PROGRAM_HEADERS:      u32 = 21;
pub val PROGRAM_HEADER:       u32 = 22;
pub val OFFSET:               u32 = 23;
pub val VADDR:                u32 = 24;
pub val PADDR:                u32 = 25;
pub val FILE_SIZE:            u32 = 26;
pub val MEM_SIZE:             u32 = 27;
pub val ALIGNMENT:            u32 = 28;
pub val SECTIONS:             u32 = 29;
pub val SECTION:              u32 = 30;
pub val INDEX:                u32 = 31;
pub val NAME:                 u32 = 32;
pub val ADDRESS:              u32 = 33;
pub val SIZE:                 u32 = 34;
pub val LINK:                 u32 = 35;
pub val INFO:                 u32 = 36;
pub val ADDRALIGN:            u32 = 37;
pub val ENTSIZE:              u32 = 38;
pub val COMPRESSION:          u32 = 39;
pub val RESERVED:             u32 = 40;
pub val SYMBOLS:              u32 = 41;
pub val DYNAMIC_SYMBOLS:      u32 = 42;
pub val SYMBOL:               u32 = 43;
pub val VALUE:                u32 = 44;
pub val BINDING:              u32 = 45;
pub val OTHER:                u32 = 46;
pub val RELOCATIONS:          u32 = 47;
pub val RELOCATION:           u32 = 48;
pub val ADDEND:               u32 = 49;
pub val WORD:                 u32 = 50;
pub val DYNAMIC_SECTION:      u32 = 51;
pub val TAG:                  u32 = 52;
pub val NOTE_SECTIONS:        u32 = 53;
pub val NOTE_SECTION:         u32 = 54;
pub val NOTE:                 u32 = 55;
pub val OWNER:                u32 = 56;
pub val DATA_SIZE:            u32 = 57;
pub val DESCRIPTION:          u32 = 58;
pub val PROPERTIES:           u32 = 59;
pub val PROPERTY:             u32 = 60;
pub val VERSION_SYMBOLS:      u32 = 61;
pub val VERSION_DEFINITIONS:  u32 = 62;
pub val DEFINITION:           u32 = 63;
pub val AUXILIARY:            u32 = 64;
pub val HASH:                 u32 = 65;
pub val VERSION_REQUIREMENTS: u32 = 66;
pub val DEPENDENCY:           u32 = 67;
pub val COUNT:                u32 = 68;
pub val FILE:                 u32 = 69;
pub val GROUPS:               u32 = 70;
pub val GROUP:                u32 = 71;
pub val MEMBERS:              u32 = 72;
pub val MEMBER:               u32 = 73;
pub val HASH_TABLE:           u32 = 74;
pub val BUCKETS:              u32 = 75;
pub val CHAINS:               u32 = 76;
pub val GNU_HASH_TABLE:       u32 = 77;
pub val SYMBOL_OFFSET:        u32 = 78;
pub val BLOOM_SHIFT:          u32 = 79;
pub val BLOOM_FILTERS:        u32 = 80;

pub val HIDDEN:   u32 = 81;
pub val OS:       u32 = 82;
pub val ABI:      u32 = 83;
pub val BUILD_ID: u32 = 84;

pub val FIELD_COUNT: usize   = 85;
pub val FIELDS:      [85]str = [85]str{
    "ElfHeader", "Ident", "Class", "DataEncoding", "FileVersion", "OS/ABI", "ABIVersion", "Unused",
    "Type", "Machine", "Version", "Entry", "ProgramHeaderOffset", "SectionHeaderOffset", "Flags",
    "HeaderSize", "ProgramHeaderEntrySize", "ProgramHeaderCount", "SectionHeaderEntrySize",
    "SectionHeaderCount", "StringTableSectionIndex", "ProgramHeaders", "ProgramHeader", "Offset",
    "VirtualAddress", "PhysicalAddress", "FileSize", "MemSize", "Alignment", "Sections", "Section",
    "Index", "Name", "Address", "Size", "Link", "Info", "AddressAlignment", "EntrySize",
    "CompressionHeader", "Reserved", "Symbols", "DynamicSymbols", "Symbol", "Value", "Binding",
    "Other", "Relocations", "Relocation", "Addend", "Word", "DynamicSection", "Tag",
    "NoteSections", "NoteSection", "Note", "Owner", "Data size", "Description", "Properties",
    "Property", "VersionSymbols", "VersionDefinitions", "Definition", "Auxiliary", "Hash",
    "VersionRequirements", "Dependency", "Count", "File", "Groups", "Group", "Members", "Member",
    "HashTable", "Buckets", "Chains", "GnuHashTable", "SymbolOffset", "BloomShift", "BloomFilters",
    "Hidden", "OS", "ABI", "Build ID",
};

# the symbol of a relocation that names no symbol
val DASH: [1]u8 = [1]u8{'-'};

# the constant tables of the machines whose tables mink carries, and the
# tables of each one: nil where the machine has none of that kind
rec Own {
    sht:   *Set;
    shf:   *Set;
    pt:    *Set;
    ef:    *Set;
    nt:    *Set;
    gnu:   *Set;
    dt:    *DynSet;
    rel64: *row.Set;
    rel32: *row.Set;
}

rec Machine {
    code: *Constant;
    own:  Own;
}

val MACHINE_COUNT: usize                  = 4;
val MACHINES:      [MACHINE_COUNT]Machine = [MACHINE_COUNT]Machine{
    Machine{code: ?tables.EM_X86_64, own: Own{sht: ?tables.SHT_X86_64, shf: ?tables.SHF_X86_64, nt: ?tables.NT_X86_64, gnu: ?tables.GNU_PROPERTY_X86_64, rel64: ?x86.X86_64, rel32: nil}},
    Machine{code: ?tables.EM_386, own: Own{rel64: nil, rel32: ?x86.X86}},
    Machine{code: ?tables.EM_AARCH64, own: Own{sht: ?tables.SHT_AARCH64, shf: ?tables.SHF_AARCH64, pt: ?tables.PT_AARCH64, nt: ?tables.NT_AARCH64, gnu: ?tables.GNU_PROPERTY_AARCH64, dt: ?tables.DT_AARCH64, rel64: ?aarch64.SET, rel32: nil}},
    Machine{code: ?tables.EM_RISCV, own: Own{sht: ?tables.SHT_RISCV, pt: ?tables.PT_RISCV, ef: ?tables.EF_RISCV, gnu: ?tables.GNU_PROPERTY_RISCV, dt: ?tables.DT_RISCV, rel64: ?riscv.RV64, rel32: ?riscv.RV32}},
};

# what a dump walks: the model, the dumper and the tables of its machine
rec Ctx {
    m:   *Elf;
    d:   *Dumper;
    own: Own;
    rel: *row.Set;
}

# the file as the model holds it, in file order: the file header, the program
# headers, the section headers, then the contents of the sections that hold
# records, each kind of content under the name llvm-readobj gives it
# ---
# m: the model to print
# d: the dumper that prints it
pub fun describe(m: *Elf, d: *Dumper) err[Fail] {
    var own: Own       = own_of(m.header.machine::u64);
    var c:   Ctx       = Ctx{m: m, d: d, own: own, rel: rel_set(?own, m.shape.class.addr)};
    val w1:  err[Fail] = header(?c);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = segments(?c);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = sections(?c);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = symbols(?c);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = relocations(?c);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = dynamics(?c);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = notes(?c);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = versions(?c);
    if (sel w8.err) { ret w8; }
    val w9: err[Fail] = groups(?c);
    if (sel w9.err) { ret w9; }
    ret hashes(?c);
}

# the dump of a model of this format, for the format's registration
pub fun dump(m: ptr, d: *Dumper) err[Fail] {
    ret describe(m::*Elf, d);
}

# the relocation table of a file of `addr`-byte addresses
fun rel_set(own: *Own, addr: usize) *row.Set {
    if (addr == 8) { ret own.rel64; }
    ret own.rel32;
}

fun own_of(machine: u64) Own {
    var i: usize = 0;
    for (i < MACHINE_COUNT) {
        if (MACHINES[i].code.value == machine) { ret MACHINES[i].own; }
        i = i + 1;
    }
    ret Own{};
}

fun header(c: *Ctx) err[Fail] {
    val w1: err[Fail] = format_dump.open(c.d, ELF_HEADER);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = ident(c);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.named(c.d, TYPE, c.m.header.type::u64, name_in(?tables.ET, nil, c.m.header.type::u64));
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.named(c.d, MACHINE, c.m.header.machine::u64, name_in(?tables.EM, nil, c.m.header.machine::u64));
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.decimal(c.d, VERSION, c.m.header.version::u64);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.hex(c.d, ENTRY, c.m.header.entry);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = format_dump.hex(c.d, PH_OFFSET, c.m.header.phoff);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = format_dump.hex(c.d, SH_OFFSET, c.m.header.shoff);
    if (sel w8.err) { ret w8; }
    val w9: err[Fail] = flags(c.d, FLAGS, c.m.header.flags::u64, nil, c.own.ef);
    if (sel w9.err) { ret w9; }
    val w10: err[Fail] = format_dump.decimal(c.d, HEADER_SIZE, c.m.header.ehsize::u64);
    if (sel w10.err) { ret w10; }
    val w11: err[Fail] = format_dump.decimal(c.d, PH_ENTSIZE, c.m.header.phentsize::u64);
    if (sel w11.err) { ret w11; }
    val pn: res[u64, Fail] = model.segment_count(c.m);
    if (sel pn.err) { ret err[Fail].err{pn.err}; }
    val w12: err[Fail] = format_dump.decimal(c.d, PH_COUNT, pn.ok);
    if (sel w12.err) { ret w12; }
    val w13: err[Fail] = format_dump.decimal(c.d, SH_ENTSIZE, c.m.header.shentsize::u64);
    if (sel w13.err) { ret w13; }
    val sn: res[u64, Fail] = model.section_count(c.m);
    if (sel sn.err) { ret err[Fail].err{sn.err}; }
    val w14: err[Fail] = format_dump.decimal(c.d, SH_COUNT, sn.ok);
    if (sel w14.err) { ret w14; }
    val w15: err[Fail] = format_dump.decimal(c.d, STRTAB_INDEX, c.m.header.shstrndx::u64);
    if (sel w15.err) { ret w15; }
    ret format_dump.close(c.d);
}

fun ident(c: *Ctx) err[Fail] {
    val w1: err[Fail] = format_dump.open(c.d, IDENT);
    if (sel w1.err) { ret w1; }
    var cls: u64 = tables.ELFCLASS32.value::u64;
    if (c.m.shape.class.addr == 8) { cls = tables.ELFCLASS64.value::u64; }
    val w2: err[Fail] = format_dump.named(c.d, CLASS, cls, name_in(?tables.ELFCLASS, nil, cls));
    if (sel w2.err) { ret w2; }
    var data: u64 = tables.ELFDATA2LSB.value::u64;
    if (c.m.shape.order == BIG) { data = tables.ELFDATA2MSB.value::u64; }
    val w3: err[Fail] = format_dump.named(c.d, DATA_ENCODING, data, name_in(?tables.ELFDATA, nil, data));
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.decimal(c.d, FILE_VERSION, c.m.header.ident.version::u64);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.named(c.d, OSABI, c.m.header.ident.osabi::u64, name_in(?tables.ELFOSABI, nil, c.m.header.ident.osabi::u64));
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.decimal(c.d, ABI_VERSION, c.m.header.ident.abiversion::u64);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = format_dump.bytes(c.d, UNUSED, ?c.m.header.ident.pad[0], 7);
    if (sel w7.err) { ret w7; }
    ret format_dump.close(c.d);
}

fun segments(c: *Ctx) err[Fail] {
    val n: usize = table.count[Segment](?c.m.segments);
    if (n == 0) { ret err[Fail].ok{}; }
    val w1: err[Fail] = format_dump.open(c.d, PROGRAM_HEADERS);
    if (sel w1.err) { ret w1; }
    var i: usize = 0;
    for (i < n) {
        val w2: err[Fail] = segment(c, model.segment_at(c.m, table.nth[Segment](i)));
        if (sel w2.err) { ret w2; }
        i = i + 1;
    }
    ret format_dump.close(c.d);
}

fun segment(c: *Ctx, s: *Segment) err[Fail] {
    val w1: err[Fail] = format_dump.open(c.d, PROGRAM_HEADER);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = format_dump.named(c.d, TYPE, s.type::u64, name_in(?tables.PT, c.own.pt, s.type::u64));
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.hex(c.d, OFFSET, s.offset);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.hex(c.d, VADDR, s.vaddr);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.hex(c.d, PADDR, s.paddr);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.hex(c.d, FILE_SIZE, s.filesz);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = format_dump.hex(c.d, MEM_SIZE, s.memsz);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = flags(c.d, FLAGS, s.flags::u64, ?tables.PF, nil);
    if (sel w8.err) { ret w8; }
    val w9: err[Fail] = format_dump.decimal(c.d, ALIGNMENT, s.align);
    if (sel w9.err) { ret w9; }
    ret format_dump.close(c.d);
}

fun sections(c: *Ctx) err[Fail] {
    val n: usize = table.count[Section](?c.m.sections);
    if (n == 0) { ret err[Fail].ok{}; }
    val w1: err[Fail] = format_dump.open(c.d, SECTIONS);
    if (sel w1.err) { ret w1; }
    var i: usize = 0;
    for (i < n) {
        val w2: err[Fail] = section(c, i, model.section_at(c.m, table.nth[Section](i)));
        if (sel w2.err) { ret w2; }
        i = i + 1;
    }
    ret format_dump.close(c.d);
}

fun section(c: *Ctx, index: usize, s: *Section) err[Fail] {
    val w1: err[Fail] = format_dump.open(c.d, SECTION);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = format_dump.decimal(c.d, INDEX, index::u64);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.decimal(c.d, NAME, s.name::u64);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.named(c.d, TYPE, s.type::u64, name_in(?tables.SHT, c.own.sht, s.type::u64));
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = flags(c.d, FLAGS, s.flags, ?tables.SHF, c.own.shf);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.hex(c.d, ADDRESS, s.addr);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = format_dump.hex(c.d, OFFSET, s.offset);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = format_dump.decimal(c.d, SIZE, s.length);
    if (sel w8.err) { ret w8; }
    val w9: err[Fail] = format_dump.decimal(c.d, LINK, s.link::u64);
    if (sel w9.err) { ret w9; }
    val w10: err[Fail] = format_dump.decimal(c.d, INFO, s.info::u64);
    if (sel w10.err) { ret w10; }
    val w11: err[Fail] = format_dump.decimal(c.d, ADDRALIGN, s.addralign);
    if (sel w11.err) { ret w11; }
    val w12: err[Fail] = format_dump.decimal(c.d, ENTSIZE, s.entsize);
    if (sel w12.err) { ret w12; }
    if (sel s.body.compressed) {
        val wz: err[Fail] = compression(c, ?s.body.compressed);
        if (sel wz.err) { ret wz; }
    }
    ret format_dump.close(c.d);
}

fun compression(c: *Ctx, z: *Compressed) err[Fail] {
    val w1: err[Fail] = format_dump.open(c.d, COMPRESSION);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = format_dump.named(c.d, TYPE, z.type::u64, name_in(?tables.ELFCOMPRESS, nil, z.type::u64));
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.decimal(c.d, RESERVED, z.reserved::u64);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.hex(c.d, SIZE, z.length);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.decimal(c.d, ADDRALIGN, z.addralign);
    if (sel w5.err) { ret w5; }
    ret format_dump.close(c.d);
}

# every symbol table, .symtab as Symbols and .dynsym as DynamicSymbols
fun symbols(c: *Ctx) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val sid: Id[Section] = table.nth[Section](i);
        val s:   *Section    = model.section_at(c.m, sid);
        if (sel s.body.symbols) {
            var key: u32 = SYMBOLS;
            if (s.type == tables.SHT_DYNSYM.value::u32) { key = DYNAMIC_SYMBOLS; }
            val w: err[Fail] = symbol_table(c, sid, key, ?s.body.symbols);
            if (sel w.err) { ret w; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun symbol_table(c: *Ctx, sid: Id[Section], key: u32, syms: *Table[Symbol]) err[Fail] {
    val w1: err[Fail] = format_dump.open(c.d, key);
    if (sel w1.err) { ret w1; }
    var i: usize = 0;
    for (i < table.count[Symbol](syms)) {
        val w2: err[Fail] = symbol(c, sid, i, table.at[Symbol](syms, table.nth[Symbol](i)));
        if (sel w2.err) { ret w2; }
        i = i + 1;
    }
    ret format_dump.close(c.d);
}

fun symbol(c: *Ctx, sid: Id[Section], index: usize, s: *Symbol) err[Fail] {
    val w1: err[Fail] = format_dump.open(c.d, SYMBOL);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = format_dump.decimal(c.d, NAME, s.name::u64);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.hex(c.d, VALUE, s.value);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.decimal(c.d, SIZE, s.bytes);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.named(c.d, BINDING, (s.info >> 4)::u64, name_in(?tables.STB, nil, (s.info >> 4)::u64));
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.named(c.d, TYPE, (s.info & 0xf)::u64, name_in(?tables.STT, nil, (s.info & 0xf)::u64));
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = format_dump.decimal(c.d, OTHER, s.other::u64);
    if (sel w7.err) { ret w7; }
    val where: res[Index, Fail] = model.symbol_section(c.m, sid, index::u32);
    if (sel where.err) { ret err[Fail].err{where.err}; }
    val place: Index = where.ok;
    if (sel place.section) {
        val wi: err[Fail] = format_dump.decimal(c.d, SECTION, place.section::u64);
        if (sel wi.err) { ret wi; }
    }
    or (sel place.reserved) {
        val wr: err[Fail] = format_dump.named(c.d, SECTION, place.reserved::u64, name_in(?tables.SHN, nil, place.reserved::u64));
        if (sel wr.err) { ret wr; }
    }
    ret format_dump.close(c.d);
}

# the relocations of every relocation section, each section under its index
fun relocations(c: *Ctx) err[Fail] {
    var opened: bool  = false;
    var i:      usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s: *Section = model.section_at(c.m, table.nth[Section](i));
        if (sel s.body.rel || sel s.body.rela || sel s.body.relr) {
            if (!opened) {
                val wo: err[Fail] = format_dump.open(c.d, RELOCATIONS);
                if (sel wo.err) { ret wo; }
                opened = true;
            }
            val wr: err[Fail] = reloc_section(c, i, s);
            if (sel wr.err) { ret wr; }
        }
        i = i + 1;
    }
    if (opened) { ret format_dump.close(c.d); }
    ret err[Fail].ok{};
}

fun reloc_section(c: *Ctx, index: usize, s: *Section) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, SECTION);
    if (sel wo.err) { ret wo; }
    val wi: err[Fail] = format_dump.decimal(c.d, INDEX, index::u64);
    if (sel wi.err) { ret wi; }
    val wn: err[Fail] = format_dump.decimal(c.d, NAME, s.name::u64);
    if (sel wn.err) { ret wn; }
    if (sel s.body.rel) {
        val tab: *Table[Rel] = ?s.body.rel;
        var k:   usize       = 0;
        for (k < table.count[Rel](tab)) {
            val r:  *Rel      = table.at[Rel](tab, table.nth[Rel](k));
            val wr: err[Fail] = reloc_record(c, s, r.offset, r.info, opt[u64].none{});
            if (sel wr.err) { ret wr; }
            k = k + 1;
        }
    }
    if (sel s.body.rela) {
        val tab: *Table[Rela] = ?s.body.rela;
        var k:   usize        = 0;
        for (k < table.count[Rela](tab)) {
            val r:  *Rela     = table.at[Rela](tab, table.nth[Rela](k));
            val wr: err[Fail] = reloc_record(c, s, r.offset, r.info, opt[u64].some{r.addend::u64});
            if (sel wr.err) { ret wr; }
            k = k + 1;
        }
    }
    if (sel s.body.relr) {
        val wq: err[Fail] = relr_relocs(c, ?s.body.relr);
        if (sel wq.err) { ret wq; }
    }
    ret format_dump.close(c.d);
}

# one REL or RELA record of section `s`, its symbol named from the symbol table
# that section links to
fun reloc_record(c: *Ctx, s: *Section, offset: u64, info: u64, addend: opt[u64]) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, RELOCATION);
    if (sel wo.err) { ret wo; }
    val wf: err[Fail] = format_dump.hex(c.d, OFFSET, offset);
    if (sel wf.err) { ret wf; }
    val code: u64       = model.reloc_type(c.m.shape.class, info);
    val wt:   err[Fail] = format_dump.named(c.d, TYPE, code, reloc_name(c, code));
    if (sel wt.err) { ret wt; }
    val ws: err[Fail] = symbol_field(c, s.link, model.reloc_symbol(c.m.shape.class, info));
    if (sel ws.err) { ret ws; }
    if (sel addend.some) {
        val wa: err[Fail] = format_dump.hex(c.d, ADDEND, addend.some);
        if (sel wa.err) { ret wa; }
    }
    ret format_dump.close(c.d);
}

# the RELR words of a section, each decoded to the addresses it relocates: an
# even word is one address and the next word follows it, an odd word is a
# bitmap over the words after the last address, bit k meaning the word k
# words past the one before
fun relr_relocs(c: *Ctx, tab: *Table[u64]) err[Fail] {
    val width: u64   = c.m.shape.class.addr::u64;
    val bits:  u64   = width * 8 - 1;
    var base:  u64   = 0;
    var k:     usize = 0;
    for (k < table.count[u64](tab)) {
        val e: u64 = (@table.at[u64](tab, table.nth[u64](k)));
        if ((e & 1) == 0) {
            val wa: err[Fail] = relr_reloc(c, e);
            if (sel wa.err) { ret wa; }
            base = e + width;
        }
        or {
            var bitmap: u64 = e >> 1;
            var i:      u64 = 0;
            for (bitmap != 0) {
                if ((bitmap & 1) != 0) {
                    val wb: err[Fail] = relr_reloc(c, base + i * width);
                    if (sel wb.err) { ret wb; }
                }
                bitmap = bitmap >> 1;
                i      = i + 1;
            }
            base = base + bits * width;
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# one RELR address, a relative relocation with no symbol
fun relr_reloc(c: *Ctx, at: u64) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, RELOCATION);
    if (sel wo.err) { ret wo; }
    val wf: err[Fail] = format_dump.hex(c.d, OFFSET, at);
    if (sel wf.err) { ret wf; }
    val rel: opt[*Row] = relative(c);
    if (sel rel.some) {
        val wt: err[Fail] = format_dump.named(c.d, TYPE, rel.some.code::u64, opt[str].some{rel.some.name});
        if (sel wt.err) { ret wt; }
    }
    val ws: err[Fail] = symbol_field(c, 0, 0);
    if (sel ws.err) { ret ws; }
    ret format_dump.close(c.d);
}

# the symbol field of a relocation: `-` for symbol 0, else the name of symbol
# `k` in the symbol table at section `symtab`
fun symbol_field(c: *Ctx, symtab: u32, k: u64) err[Fail] {
    if (k == 0) { ret format_dump.labelled(c.d, SYMBOL, 0, ?DASH[0], 1); }
    val name: res[Bytes, Fail] = symbol_name(c, symtab, k);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    ret format_dump.labelled(c.d, SYMBOL, k, name.ok.data, name.ok.len);
}

fun symbol_name(c: *Ctx, symtab: u32, k: u64) res[Bytes, Fail] {
    val sec: res[*Section, Fail] = section_index(c, symtab::u64);
    if (sel sec.err) { ret res[Bytes, Fail].err{sec.err}; }
    val s: *Section = sec.ok;
    if (!sel s.body.symbols) {
        ret res[Bytes, Fail].err{fail.in_record(fail.malformed("a relocation links a section that is no symbol table"), "relocation")};
    }
    val tab: *Table[Symbol] = ?s.body.symbols;
    if (k >= table.count[Symbol](tab)::u64) {
        ret res[Bytes, Fail].err{fail.in_record(fail.malformed("a relocation names a symbol past its table"), "relocation")};
    }
    val sym: *Symbol = table.at[Symbol](tab, table.nth[Symbol](k::usize));
    ret string_at(c, s.link, sym.name::u64);
}

# the NUL-terminated string at byte `at` of the raw section `index`, without
# its terminator
fun string_at(c: *Ctx, index: u32, at: u64) res[Bytes, Fail] {
    val sec: res[*Section, Fail] = section_index(c, index::u64);
    if (sel sec.err) { ret res[Bytes, Fail].err{sec.err}; }
    val s: *Section = sec.ok;
    if (!sel s.body.raw) {
        ret res[Bytes, Fail].err{fail.in_record(fail.malformed("a string table is not held as raw bytes"), "string table")};
    }
    val held: Bytes = model.bytes(c.m, ?s.body.raw);
    if (at >= held.len::u64) {
        ret res[Bytes, Fail].err{fail.in_record(fail.malformed("a string starts past its table"), "string table")};
    }
    var end: usize = at::usize;
    for (end < held.len && held.data[end] != 0) { end = end + 1; }
    if (end == held.len) {
        ret res[Bytes, Fail].err{fail.in_record(fail.malformed("a string has no terminator"), "string table")};
    }
    ret res[Bytes, Fail].ok{Bytes{data: ?held.data[at::usize], len: end - at::usize}};
}

fun section_index(c: *Ctx, index: u64) res[*Section, Fail] {
    if (index >= table.count[Section](?c.m.sections)::u64) {
        ret res[*Section, Fail].err{fail.in_record(fail.malformed("a section link names a section past the section table"), "section")};
    }
    ret res[*Section, Fail].ok{model.section_at(c.m, table.nth[Section](index::usize))};
}

# the relocation type `code` in the machine's table, none when there is none
fun reloc_name(c: *Ctx, code: u64) opt[str] {
    if (c.rel == nil) { ret opt[str].none{}; }
    val r: res[*Row, Fail] = row.by_code(c.rel, code::u32);
    if (sel r.ok) { ret opt[str].some{r.ok.name}; }
    ret opt[str].none{};
}

# the machine's relative relocation row, none when the machine has no table
fun relative(c: *Ctx) opt[*Row] {
    if (c.rel == nil) { ret opt[*Row].none{}; }
    val r: res[*Row, Fail] = row.by_kind(c.rel, ?reloc.RELATIVE);
    if (sel r.ok) { ret opt[*Row].some{r.ok}; }
    ret opt[*Row].none{};
}

# the dynamic entries of every SHT_DYNAMIC section, string entries named from
# the string table that section links to
fun dynamics(c: *Ctx) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s: *Section = model.section_at(c.m, table.nth[Section](i));
        if (sel s.body.dynamic) {
            val tab: *Table[Dyn] = ?s.body.dynamic;
            val wo:  err[Fail]   = format_dump.open(c.d, DYNAMIC_SECTION);
            if (sel wo.err) { ret wo; }
            var k: usize = 0;
            for (k < table.count[Dyn](tab)) {
                val wd: err[Fail] = dyn_entry(c, s, table.at[Dyn](tab, table.nth[Dyn](k)));
                if (sel wd.err) { ret wd; }
                k = k + 1;
            }
            val wc: err[Fail] = format_dump.close(c.d);
            if (sel wc.err) { ret wc; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun dyn_entry(c: *Ctx, s: *Section, e: *Dyn) err[Fail] {
    val kind: u64       = e.kind::u64;
    val wo:   err[Fail] = format_dump.open(c.d, ENTRY);
    if (sel wo.err) { ret wo; }
    val wt: err[Fail] = format_dump.hex(c.d, TAG, kind);
    if (sel wt.err) { ret wt; }
    val wy: err[Fail] = format_dump.named(c.d, TYPE, kind, dyn_name(?tables.DT, c.own.dt, kind));
    if (sel wy.err) { ret wy; }
    val wv: err[Fail] = format_dump.hex(c.d, VALUE, e.value);
    if (sel wv.err) { ret wv; }
    if (is_string_tag(kind)) {
        val nm: res[Bytes, Fail] = string_at(c, s.link, e.value);
        if (sel nm.err) { ret err[Fail].err{nm.err}; }
        val wn: err[Fail] = format_dump.labelled(c.d, NAME, e.value, nm.ok.data, nm.ok.len);
        if (sel wn.err) { ret wn; }
    }
    ret format_dump.close(c.d);
}

# the entries whose value is an offset into the string table
fun is_string_tag(kind: u64) bool {
    ret kind == tables.DT_NEEDED.value::u64 || kind == tables.DT_SONAME.value::u64 || kind == tables.DT_RPATH.value::u64 || kind == tables.DT_RUNPATH.value::u64 || kind == tables.DT_AUXILIARY.value::u64 || kind == tables.DT_FILTER.value::u64;
}

# the note entries of every SHT_NOTE section, each section under its index
fun notes(c: *Ctx) err[Fail] {
    var opened: bool  = false;
    var i:      usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s: *Section = model.section_at(c.m, table.nth[Section](i));
        if (sel s.body.notes) {
            val tab: *Table[Note] = ?s.body.notes;
            if (!opened) {
                val wo: err[Fail] = format_dump.open(c.d, NOTE_SECTIONS);
                if (sel wo.err) { ret wo; }
                opened = true;
            }
            val wn: err[Fail] = note_section(c, i, s, tab);
            if (sel wn.err) { ret wn; }
        }
        i = i + 1;
    }
    if (opened) { ret format_dump.close(c.d); }
    ret err[Fail].ok{};
}

fun note_section(c: *Ctx, index: usize, s: *Section, tab: *Table[Note]) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, NOTE_SECTION);
    if (sel wo.err) { ret wo; }
    val wi: err[Fail] = format_dump.decimal(c.d, INDEX, index::u64);
    if (sel wi.err) { ret wi; }
    val wf: err[Fail] = format_dump.hex(c.d, OFFSET, s.offset);
    if (sel wf.err) { ret wf; }
    val wz: err[Fail] = format_dump.hex(c.d, SIZE, s.length);
    if (sel wz.err) { ret wz; }
    var k: usize = 0;
    for (k < table.count[Note](tab)) {
        val wn: err[Fail] = note(c, table.at[Note](tab, table.nth[Note](k)));
        if (sel wn.err) { ret wn; }
        k = k + 1;
    }
    ret format_dump.close(c.d);
}

fun note(c: *Ctx, n: *Note) err[Fail] {
    val owner: Bytes = model.bytes(c.m, ?n.name);
    var len:   usize = owner.len;
    if (len > 0 && owner.data[len - 1] == 0) { len = len - 1; }
    val gnu: bool      = owner_is(owner.data, len, "GNU");
    val wo:  err[Fail] = format_dump.open(c.d, NOTE);
    if (sel wo.err) { ret wo; }
    val wn: err[Fail] = format_dump.name(c.d, OWNER, owner.data, len);
    if (sel wn.err) { ret wn; }
    val wz: err[Fail] = format_dump.hex(c.d, DATA_SIZE, n.descsz::u64);
    if (sel wz.err) { ret wz; }
    val wt: err[Fail] = format_dump.named(c.d, TYPE, n.type::u64, name_in(note_set(owner.data, len, c.own), nil, n.type::u64));
    if (sel wt.err) { ret wt; }
    if (sel n.desc.raw) {
        val desc: Bytes     = model.bytes(c.m, ?n.desc.raw);
        val wd:   err[Fail] = note_desc(c, gnu, n.type::u64, desc);
        if (sel wd.err) { ret wd; }
    }
    if (sel n.desc.properties) {
        val wp: err[Fail] = properties(c, ?n.desc.properties);
        if (sel wp.err) { ret wp; }
    }
    ret format_dump.close(c.d);
}

# a GNU note's descriptor decoded, its build ID as hex digits and its ABI tag
# as the operating system and version, and any other descriptor as bytes
fun note_desc(c: *Ctx, gnu: bool, ntype: u64, desc: Bytes) err[Fail] {
    if (gnu && ntype == tables.NT_GNU_ABI_TAG.value::u64)  { ret abi_tag(c, desc); }
    if (gnu && ntype == tables.NT_GNU_BUILD_ID.value::u64) { ret format_dump.digits(c.d, BUILD_ID, desc.data, desc.len); }
    ret format_dump.bytes(c.d, DESCRIPTION, desc.data, desc.len);
}

# the four words of an ABI tag in the file's byte order: the operating system,
# then the major, minor and subminor version of the kernel
fun abi_tag(c: *Ctx, desc: Bytes) err[Fail] {
    if (desc.len < 16) {
        ret err[Fail].err{fail.in_record(fail.malformed("the ABI tag is shorter than its four words"), "note")};
    }
    val order: Order     = c.m.shape.order;
    val os:    u64       = slot.field(desc.data, Slot{offset: 0, width: 4}, order);
    val major: u64       = slot.field(desc.data, Slot{offset: 4, width: 4}, order);
    val minor: u64       = slot.field(desc.data, Slot{offset: 8, width: 4}, order);
    val sub:   u64       = slot.field(desc.data, Slot{offset: 12, width: 4}, order);
    val wo:    err[Fail] = format_dump.named(c.d, OS, os, name_in(?abi.OS, nil, os));
    if (sel wo.err) { ret wo; }
    val wf: err[Fail] = format_dump.field(c.d, ABI);
    if (sel wf.err) { ret wf; }
    val w1: err[Fail] = format_dump.decimal_value(c.d, major);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = format_dump.text(c.d, ".");
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.decimal_value(c.d, minor);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.text(c.d, ".");
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.decimal_value(c.d, sub);
    if (sel w5.err) { ret w5; }
    ret format_dump.text(c.d, "\n");
}

fun note_set(owner: *u8, len: usize, own: Own) *Set {
    if (owner_is(owner, len, "GNU"))  { ret ?tables.NT_GNU; }
    if (owner_is(owner, len, "CORE")) { ret ?tables.NT_CORE; }
    ret own.nt;
}

fun owner_is(p: *u8, n: usize, want: str) bool {
    if (n != str_len(want)) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (p[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun properties(c: *Ctx, tab: *Table[Property]) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, PROPERTIES);
    if (sel wo.err) { ret wo; }
    var k: usize = 0;
    for (k < table.count[Property](tab)) {
        val p:    *Property = table.at[Property](tab, table.nth[Property](k));
        val data: Bytes     = model.bytes(c.m, ?p.data);
        val wp:   err[Fail] = format_dump.open(c.d, PROPERTY);
        if (sel wp.err) { ret wp; }
        val wt: err[Fail] = format_dump.named(c.d, TYPE, p.type::u64, name_in(?tables.GNU_PROPERTY, c.own.gnu, p.type::u64));
        if (sel wt.err) { ret wt; }
        val wz: err[Fail] = format_dump.hex(c.d, DATA_SIZE, p.datasz::u64);
        if (sel wz.err) { ret wz; }
        val wv: err[Fail] = format_dump.bytes(c.d, VALUE, data.data, data.len);
        if (sel wv.err) { ret wv; }
        val wc: err[Fail] = format_dump.close(c.d);
        if (sel wc.err) { ret wc; }
        k = k + 1;
    }
    ret format_dump.close(c.d);
}

# the version sections: symbol versions, definitions and requirements
fun versions(c: *Ctx) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s: *Section = model.section_at(c.m, table.nth[Section](i));
        if (sel s.body.versym) {
            val wv: err[Fail] = versym(c, ?s.body.versym);
            if (sel wv.err) { ret wv; }
        }
        if (sel s.body.verdef) {
            val wd: err[Fail] = verdefs(c, ?s.body.verdef);
            if (sel wd.err) { ret wd; }
        }
        if (sel s.body.verneed) {
            val wn: err[Fail] = verneeds(c, ?s.body.verneed);
            if (sel wn.err) { ret wn; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun versym(c: *Ctx, tab: *Table[u16]) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, VERSION_SYMBOLS);
    if (sel wo.err) { ret wo; }
    var k: usize = 0;
    for (k < table.count[u16](tab)) {
        val raw: u64       = (@table.at[u16](tab, table.nth[u16](k)))::u64;
        val wy:  err[Fail] = versym_entry(c, raw);
        if (sel wy.err) { ret wy; }
        k = k + 1;
    }
    ret format_dump.close(c.d);
}

# one symbol's version index, with its hidden bit apart
fun versym_entry(c: *Ctx, raw: u64) err[Fail] {
    var hidden: u64 = 0;
    if ((raw & tables.VERSYM_HIDDEN.value) != 0) { hidden = 1; }
    val wo: err[Fail] = format_dump.open(c.d, SYMBOL);
    if (sel wo.err) { ret wo; }
    val wv: err[Fail] = format_dump.decimal(c.d, VERSION, raw & tables.VERSYM_VERSION.value);
    if (sel wv.err) { ret wv; }
    val wh: err[Fail] = format_dump.decimal(c.d, HIDDEN, hidden);
    if (sel wh.err) { ret wh; }
    ret format_dump.close(c.d);
}

fun verdefs(c: *Ctx, tab: *Table[Definition]) err[Fail] {
    val w1: err[Fail] = format_dump.open(c.d, VERSION_DEFINITIONS);
    if (sel w1.err) { ret w1; }
    var k: usize = 0;
    for (k < table.count[Definition](tab)) {
        val x: *Definition = table.at[Definition](tab, table.nth[Definition](k));
        if (sel x.verdef) {
            val v:  *Verdef   = ?x.verdef;
            val w2: err[Fail] = format_dump.open(c.d, DEFINITION);
            if (sel w2.err) { ret w2; }
            val w3: err[Fail] = format_dump.decimal(c.d, VERSION, v.version::u64);
            if (sel w3.err) { ret w3; }
            val w4: err[Fail] = flags(c.d, FLAGS, v.flags::u64, ?tables.VER_FLG, nil);
            if (sel w4.err) { ret w4; }
            val w5: err[Fail] = format_dump.decimal(c.d, INDEX, v.ndx::u64);
            if (sel w5.err) { ret w5; }
            val w6: err[Fail] = format_dump.decimal(c.d, HASH, v.hash::u64);
            if (sel w6.err) { ret w6; }
            val w7: err[Fail] = format_dump.close(c.d);
            if (sel w7.err) { ret w7; }
        }
        or (sel x.verdaux) {
            val a:  *Verdaux  = ?x.verdaux;
            val w8: err[Fail] = format_dump.open(c.d, AUXILIARY);
            if (sel w8.err) { ret w8; }
            val w9: err[Fail] = format_dump.decimal(c.d, NAME, a.name::u64);
            if (sel w9.err) { ret w9; }
            val w10: err[Fail] = format_dump.close(c.d);
            if (sel w10.err) { ret w10; }
        }
        k = k + 1;
    }
    ret format_dump.close(c.d);
}

fun verneeds(c: *Ctx, tab: *Table[Need]) err[Fail] {
    val w1: err[Fail] = format_dump.open(c.d, VERSION_REQUIREMENTS);
    if (sel w1.err) { ret w1; }
    var k: usize = 0;
    for (k < table.count[Need](tab)) {
        val x: *Need = table.at[Need](tab, table.nth[Need](k));
        if (sel x.verneed) {
            val v:  *Verneed  = ?x.verneed;
            val w2: err[Fail] = format_dump.open(c.d, DEPENDENCY);
            if (sel w2.err) { ret w2; }
            val w3: err[Fail] = format_dump.decimal(c.d, VERSION, v.version::u64);
            if (sel w3.err) { ret w3; }
            val w4: err[Fail] = format_dump.decimal(c.d, COUNT, v.cnt::u64);
            if (sel w4.err) { ret w4; }
            val w5: err[Fail] = format_dump.decimal(c.d, FILE, v.file::u64);
            if (sel w5.err) { ret w5; }
            val w6: err[Fail] = format_dump.close(c.d);
            if (sel w6.err) { ret w6; }
        }
        or (sel x.vernaux) {
            val a:  *Vernaux  = ?x.vernaux;
            val w7: err[Fail] = format_dump.open(c.d, ENTRY);
            if (sel w7.err) { ret w7; }
            val w8: err[Fail] = format_dump.decimal(c.d, HASH, a.hash::u64);
            if (sel w8.err) { ret w8; }
            val w9: err[Fail] = flags(c.d, FLAGS, a.flags::u64, ?tables.VER_FLG, nil);
            if (sel w9.err) { ret w9; }
            val w10: err[Fail] = format_dump.decimal(c.d, INDEX, a.other::u64);
            if (sel w10.err) { ret w10; }
            val w11: err[Fail] = format_dump.decimal(c.d, NAME, a.name::u64);
            if (sel w11.err) { ret w11; }
            val w12: err[Fail] = format_dump.close(c.d);
            if (sel w12.err) { ret w12; }
        }
        k = k + 1;
    }
    ret format_dump.close(c.d);
}

# the SHT_GROUP sections, each with its flags and the indexes of its members
fun groups(c: *Ctx) err[Fail] {
    var opened: bool  = false;
    var i:      usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s: *Section = model.section_at(c.m, table.nth[Section](i));
        if (sel s.body.group) {
            val g: *Group = ?s.body.group;
            if (!opened) {
                val w1: err[Fail] = format_dump.open(c.d, GROUPS);
                if (sel w1.err) { ret w1; }
                opened = true;
            }
            val w2: err[Fail] = format_dump.open(c.d, GROUP);
            if (sel w2.err) { ret w2; }
            val w3: err[Fail] = format_dump.decimal(c.d, INDEX, i::u64);
            if (sel w3.err) { ret w3; }
            val w4: err[Fail] = format_dump.named(c.d, TYPE, g.flags::u64, name_in(?tables.GRP, nil, g.flags::u64));
            if (sel w4.err) { ret w4; }
            var k: usize = 0;
            for (k < table.count[u32](?g.members)) {
                val w5: err[Fail] = format_dump.open(c.d, MEMBER);
                if (sel w5.err) { ret w5; }
                val w6: err[Fail] = format_dump.decimal(c.d, INDEX, (@table.at[u32](?g.members, table.nth[u32](k)))::u64);
                if (sel w6.err) { ret w6; }
                val w7: err[Fail] = format_dump.close(c.d);
                if (sel w7.err) { ret w7; }
                k = k + 1;
            }
            val w8: err[Fail] = format_dump.close(c.d);
            if (sel w8.err) { ret w8; }
        }
        i = i + 1;
    }
    if (opened) { ret format_dump.close(c.d); }
    ret err[Fail].ok{};
}

# the hash tables, each as the counts of its tables
fun hashes(c: *Ctx) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s:  *Section  = model.section_at(c.m, table.nth[Section](i));
        val w1: err[Fail] = err[Fail].ok{};
        if (sel s.body.hash) {
            val h:  *Hash     = ?s.body.hash;
            val w2: err[Fail] = format_dump.open(c.d, HASH_TABLE);
            if (sel w2.err) { ret w2; }
            val w3: err[Fail] = format_dump.decimal(c.d, BUCKETS, table.count[u32](?h.buckets)::u64);
            if (sel w3.err) { ret w3; }
            val w4: err[Fail] = format_dump.decimal(c.d, CHAINS, table.count[u32](?h.chains)::u64);
            if (sel w4.err) { ret w4; }
            val w5: err[Fail] = format_dump.close(c.d);
            if (sel w5.err) { ret w5; }
        }
        if (sel s.body.gnu_hash) {
            val g:  *GnuHash  = ?s.body.gnu_hash;
            val w6: err[Fail] = format_dump.open(c.d, GNU_HASH_TABLE);
            if (sel w6.err) { ret w6; }
            val w7: err[Fail] = format_dump.decimal(c.d, SYMBOL_OFFSET, g.symoffset::u64);
            if (sel w7.err) { ret w7; }
            val w8: err[Fail] = format_dump.decimal(c.d, BLOOM_SHIFT, g.shift::u64);
            if (sel w8.err) { ret w8; }
            val w9: err[Fail] = format_dump.decimal(c.d, BLOOM_FILTERS, table.count[u64](?g.bloom)::u64);
            if (sel w9.err) { ret w9; }
            val w10: err[Fail] = format_dump.decimal(c.d, BUCKETS, table.count[u32](?g.buckets)::u64);
            if (sel w10.err) { ret w10; }
            val w11: err[Fail] = format_dump.decimal(c.d, CHAINS, table.count[u32](?g.chain)::u64);
            if (sel w11.err) { ret w11; }
            val w12: err[Fail] = format_dump.close(c.d);
            if (sel w12.err) { ret w12; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the name of `v` in the generic table or else in the machine's own, none when
# neither has it. a nil table has no names
fun name_in(generic: *Set, own: *Set, v: u64) opt[str] {
    val g: opt[str] = constant(generic, v);
    if (sel g.some) { ret g; }
    ret constant(own, v);
}

fun constant(s: *Set, v: u64) opt[str] {
    if (s == nil) { ret opt[str].none{}; }
    val c: opt[*Constant] = tables.name_of(s, v);
    if (sel c.some) { ret opt[str].some{c.some.name}; }
    ret opt[str].none{};
}

fun dyn_name(generic: *DynSet, own: *DynSet, v: u64) opt[str] {
    val g: opt[str] = dyn_constant(generic, v);
    if (sel g.some) { ret g; }
    ret dyn_constant(own, v);
}

fun dyn_constant(s: *DynSet, v: u64) opt[str] {
    if (s == nil) { ret opt[str].none{}; }
    val c: opt[*DynTag] = tables.dyn_name_of(s, v);
    if (sel c.some) { ret opt[str].some{c.some.name}; }
    ret opt[str].none{};
}

# a flags field: the names of the single-bit constants set in `v`, then what
# no name covers, then the value
fun flags(d: *Dumper, key: u32, v: u64, generic: *Set, own: *Set) err[Fail] {
    val w1: err[Fail] = format_dump.field(d, key);
    if (sel w1.err) { ret w1; }
    var rest: u64       = v;
    val w2:   err[Fail] = named_bits(d, generic, ?rest);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = named_bits(d, own, ?rest);
    if (sel w3.err) { ret w3; }
    if (rest != 0) {
        val w4: err[Fail] = format_dump.hex_value(d, rest);
        if (sel w4.err) { ret w4; }
        val w5: err[Fail] = format_dump.text(d, " ");
        if (sel w5.err) { ret w5; }
    }
    val w6: err[Fail] = format_dump.text(d, "(");
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = format_dump.hex_value(d, v);
    if (sel w7.err) { ret w7; }
    ret format_dump.text(d, ")\n");
}

# print the name of each single-bit constant of `s` set in `rest`, and clear
# its bit from `rest`. a multi-bit constant is a mask, not a flag
fun named_bits(d: *Dumper, s: *Set, rest: *u64) err[Fail] {
    if (s == nil) { ret err[Fail].ok{}; }
    var i: usize = 0;
    for (i < s.count) {
        val b: u64 = s.rows[i].value;
        if (b != 0 && (b & (b - 1)) == 0 && (@rest & b) != 0) {
            val w1: err[Fail] = format_dump.text(d, s.rows[i].name);
            if (sel w1.err) { ret w1; }
            val w2: err[Fail] = format_dump.text(d, " ");
            if (sel w2.err) { ret w2; }
            @rest = @rest & ~b;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

test dump__header_sections_and_symbols_under_llvm_names {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);
    var m: Elf          = model.make(a, Shape{class: ?model.CLASS64, order: LITTLE});
    m.header = Header{ident: Ident{version: 1}, type: 1, machine: 62, version: 1, shoff: 0x40, ehsize: 64, shentsize: 64, shnum: 4, shstrndx: 3};

    val text: Section               = Section{name: 1, type: 1, flags: 6, offset: 0x40, length: 4, addralign: 4};
    var syms: Table[Symbol]         = table.make[Symbol](a);
    val s0:   res[Id[Symbol], Fail] = table.push[Symbol](?syms, Symbol{});
    val s1:   res[Id[Symbol], Fail] = table.push[Symbol](?syms, Symbol{name: 1, info: 0x12, shndx: 1, value: 0, bytes: 4});
    val s2:   res[Id[Symbol], Fail] = table.push[Symbol](?syms, Symbol{name: 6, info: 0x01, shndx: 0xfff1, value: 0x2a});
    if (sel s0.err || sel s1.err || sel s2.err) { ret 1; }
    val symtab: Section                = Section{name: 7, type: 2, offset: 0x44, length: 72, link: 3, info: 1, addralign: 8, entsize: 24, body: Body.symbols{syms}};
    val strtab: Section                = Section{name: 15, type: 3, offset: 0x90, length: 8, addralign: 1};
    val p0:     res[Id[Section], Fail] = table.push[Section](?m.sections, Section{});
    val p1:     res[Id[Section], Fail] = table.push[Section](?m.sections, text);
    val p2:     res[Id[Section], Fail] = table.push[Section](?m.sections, symtab);
    val p3:     res[Id[Section], Fail] = table.push[Section](?m.sections, strtab);
    if (sel p0.err || sel p1.err || sel p2.err || sel p3.err) { ret 1; }

    var out: Sink      = sink.make(a, LITTLE);
    var d:   Dumper    = format_dump.make(?out, ?FIELDS[0], FIELD_COUNT);
    val w:   err[Fail] = describe(?m, ?d);
    if (sel w.err) { ret 1; }
    val want: str   = "ElfHeader {\n  Ident {\n    Class: ELFCLASS64 (0x2)\n    DataEncoding: ELFDATA2LSB (0x1)\n    FileVersion: 1\n    OS/ABI: ELFOSABI_NONE (0x0)\n    ABIVersion: 0\n    Unused: ( 00 00 00 00 00 00 00 )\n  }\n  Type: ET_REL (0x1)\n  Machine: EM_X86_64 (0x3e)\n  Version: 1\n  Entry: 0x0\n  ProgramHeaderOffset: 0x0\n  SectionHeaderOffset: 0x40\n  Flags: (0x0)\n  HeaderSize: 64\n  ProgramHeaderEntrySize: 0\n  ProgramHeaderCount: 0\n  SectionHeaderEntrySize: 64\n  SectionHeaderCount: 4\n  StringTableSectionIndex: 3\n}\nSections {\n  Section {\n    Index: 0\n    Name: 0\n    Type: SHT_NULL (0x0)\n    Flags: (0x0)\n    Address: 0x0\n    Offset: 0x0\n    Size: 0\n    Link: 0\n    Info: 0\n    AddressAlignment: 0\n    EntrySize: 0\n  }\n  Section {\n    Index: 1\n    Name: 1\n    Type: SHT_PROGBITS (0x1)\n    Flags: SHF_ALLOC SHF_EXECINSTR (0x6)\n    Address: 0x0\n    Offset: 0x40\n    Size: 4\n    Link: 0\n    Info: 0\n    AddressAlignment: 4\n    EntrySize: 0\n  }\n  Section {\n    Index: 2\n    Name: 7\n    Type: SHT_SYMTAB (0x2)\n    Flags: (0x0)\n    Address: 0x0\n    Offset: 0x44\n    Size: 72\n    Link: 3\n    Info: 1\n    AddressAlignment: 8\n    EntrySize: 24\n  }\n  Section {\n    Index: 3\n    Name: 15\n    Type: SHT_STRTAB (0x3)\n    Flags: (0x0)\n    Address: 0x0\n    Offset: 0x90\n    Size: 8\n    Link: 0\n    Info: 0\n    AddressAlignment: 1\n    EntrySize: 0\n  }\n}\nSymbols {\n  Symbol {\n    Name: 0\n    Value: 0x0\n    Size: 0\n    Binding: STB_LOCAL (0x0)\n    Type: STT_NOTYPE (0x0)\n    Other: 0\n    Section: 0\n  }\n  Symbol {\n    Name: 1\n    Value: 0x0\n    Size: 4\n    Binding: STB_GLOBAL (0x1)\n    Type: STT_FUNC (0x2)\n    Other: 0\n    Section: 1\n  }\n  Symbol {\n    Name: 6\n    Value: 0x2a\n    Size: 0\n    Binding: STB_LOCAL (0x0)\n    Type: STT_OBJECT (0x1)\n    Other: 0\n    Section: SHN_ABS (0xfff1)\n  }\n}\n";
    val n:    usize = str_len(want);
    if (sink.len(?out) != n)                                   { ret 1; }
    if (!memory.raw_equal(sink.data(?out)::ptr, want::ptr, n)) { ret 1; }
    val rel: err[Fail] = sink.release(?out);
    if (sel rel.err) { ret 1; }
    val mrel: err[Fail] = model.release(?m);
    if (sel mrel.err)          { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
