# the linking rules of ELF: how an image is laid out and bound
#
# an input section merges into the output section its name stems from, as
# .text.hot into .text, and output sections load by class: code, read-only
# data, thread-local data, data read-only after relocation, then data with
# its zero fill last. the headers and program headers load at the start of
# the first segment.
#
# one lookup is flat across every image, so a default definition in a shared
# library may be preempted, a fixed executable copies a library's data it
# refers to directly, and symbols carry versions. an indirect function is
# reached through an IPLT entry its resolver fills, at start in an image no
# loader runs and by the loader otherwise. the rows follow the System V gABI
# and the psABIs as lld and GNU ld apply them, first match deciding.

use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.lib.catalog.arch.Arch;
use mink.lib.fail.Fail;
use mink.lib.link.dynamic;
use mink.lib.link.dynamic.Axis;
use mink.lib.link.dynamic.Reference;
use mink.lib.link.dynamic.Row;
use mink.lib.link.kind;
use mink.lib.link.kind.Kind;
use mink.lib.link.layout.Class;
use mink.lib.link.layout.Load;
use mink.lib.link.layout.Rules;
use mink.lib.model.reloc;
use mink.lib.model.section;

val STEM_COUNT: usize           = 11;
val STEMS:      [STEM_COUNT]str = [STEM_COUNT]str{
    ".text", ".rodata", ".data.rel.ro", ".data", ".bss", ".tdata", ".tbss",
    ".init_array", ".fini_array", ".preinit_array", ".gcc_except_table",
};

val CODE:  Load = Load{name: "code", flags: section.ALLOC | section.EXEC};
val CONST: Load = Load{name: "rodata", flags: section.ALLOC};
val RELRO: Load = Load{name: "relro", flags: section.ALLOC | section.WRITE};
val DATA:  Load = Load{name: "data", flags: section.ALLOC | section.WRITE};

val LOADED: section.Flags = section.ALLOC | section.WRITE | section.EXEC;
val TLS:    section.Flags = section.ALLOC | section.WRITE | section.TLS;

val CLASS_COUNT: usize              = 8;
val CLASSES:     [CLASS_COUNT]Class = [CLASS_COUNT]Class{
    Class{flags: section.ALLOC | section.EXEC, flag_mask: LOADED, load: opt[*Load].some{?CODE}},
    Class{flags: section.ALLOC, flag_mask: LOADED, load: opt[*Load].some{?CONST}},
    Class{flags: TLS, flag_mask: LOADED | section.TLS, roles: section.BITS, role_mask: section.BITS, load: opt[*Load].some{?RELRO}},
    Class{flags: TLS, flag_mask: LOADED | section.TLS, roles: 0, role_mask: section.BITS, load: opt[*Load].some{?RELRO}},
    Class{flags: section.ALLOC | section.WRITE, flag_mask: LOADED, roles: section.RELRO, role_mask: section.RELRO, load: opt[*Load].some{?RELRO}},
    Class{flags: section.ALLOC | section.WRITE, flag_mask: LOADED, roles: section.BITS, role_mask: section.BITS, load: opt[*Load].some{?DATA}},
    Class{flags: section.ALLOC | section.WRITE, flag_mask: LOADED, roles: 0, role_mask: section.BITS, load: opt[*Load].some{?DATA}},
    Class{flags: 0, flag_mask: section.ALLOC, load: opt[*Load].none{}},
};

# program headers beyond one per load segment: PT_PHDR, PT_INTERP,
# PT_DYNAMIC, PT_NOTE, PT_TLS, PT_GNU_RELRO, PT_GNU_STACK and PT_GNU_EH_FRAME
val EXTRA_HEADERS: u64 = 8;

# the ELF header and the program headers, ELF64's or ELF32's
fun header(a: *Arch, segments: u64, sections: u64) u64 {
    if (a.pointer_bytes == 8) { ret 64 + 56 * (segments + EXTRA_HEADERS); }
    ret 52 + 32 * (segments + EXTRA_HEADERS);
}

pub val LAYOUT: Rules = Rules{
    stems:         ?STEMS[0],
    stem_count:    STEM_COUNT,
    joint:         '.',
    cut:           0,
    classes:       ?CLASSES[0],
    class_count:   CLASS_COUNT,
    commons:       ".bss",
    congruent:     true,
    section_align: 1,
    file_align:    1,
    header:        header,
};

val LATE:     u64 = dynamic.BOUND;
val IFUNC:    u64 = dynamic.RESOLVER;
val FIXED:    u64 = dynamic.ABSOLUTE | dynamic.UNDEFINED;
val SPELLED:  u64 = dynamic.WORD | dynamic.WRITABLE;
val LIB_DATA: u64 = dynamic.BOUND | dynamic.IMPORTED | dynamic.DATA;

val DYNAMIC_COUNT: usize              = 32;
val DYNAMIC_ROWS:  [DYNAMIC_COUNT]Row = [DYNAMIC_COUNT]Row{
    Row{kind: Axis{need: reloc.MARKER}, outcome: ?dynamic.STATIC},
    Row{kind: Axis{need: reloc.LOADER}, outcome: ?dynamic.REFUSED, reason: "an object holds a relocation only a loader applies"},
    Row{target: Axis{need: dynamic.IMPORTED}, output: Axis{deny: kind.IMPORTS}, outcome: ?dynamic.REFUSED, reason: "an output no loader binds cannot import from a shared library"},
    Row{target: Axis{need: dynamic.THREAD | LATE}, outcome: ?dynamic.UNSUPPORTED, reason: "thread-local data another image binds is not supported yet"},
    Row{kind: Axis{need: reloc.TLS}, output: Axis{need: kind.INTERPOSED}, outcome: ?dynamic.UNSUPPORTED, reason: "thread-local references in a shared library are not supported yet"},
    Row{kind: Axis{need: reloc.TLS | reloc.GOT}, outcome: ?dynamic.GOT_STATIC},
    Row{kind: Axis{need: reloc.TLS}, outcome: ?dynamic.STATIC},
    Row{kind: Axis{need: reloc.GOT}, target: Axis{need: IFUNC, deny: LATE}, output: Axis{deny: kind.IMPORTS}, outcome: ?dynamic.GOT_RESOLVE_START},
    Row{target: Axis{need: IFUNC, deny: LATE}, output: Axis{deny: kind.IMPORTS}, outcome: ?dynamic.PLT_RESOLVE_START},
    Row{kind: Axis{need: reloc.GOT}, target: Axis{need: IFUNC, deny: LATE}, output: Axis{need: kind.IMPORTS}, outcome: ?dynamic.GOT_RESOLVE},
    Row{
        kind:    Axis{need: reloc.ABS},
        site:    Axis{need: SPELLED},
        target:  Axis{need: IFUNC, deny: LATE},
        output:  Axis{need: kind.IMPORTS | kind.PIC},
        outcome: ?dynamic.PLT_RESOLVE_REBASE,
    },
    Row{
        kind:    Axis{need: reloc.ABS},
        site:    Axis{deny: dynamic.LOW},
        target:  Axis{need: IFUNC, deny: LATE},
        output:  Axis{need: kind.PIC},
        outcome: ?dynamic.REFUSED,
        reason:  "an absolute reference outside writable data cannot be made position independent",
    },
    Row{target: Axis{need: IFUNC, deny: LATE}, output: Axis{need: kind.IMPORTS}, outcome: ?dynamic.PLT_RESOLVE},
    Row{kind: Axis{need: reloc.GOT}, target: Axis{need: LATE}, outcome: ?dynamic.GOT_BIND},
    Row{kind: Axis{need: reloc.GOT}, target: Axis{need: dynamic.ABSOLUTE}, outcome: ?dynamic.GOT_STATIC},
    Row{kind: Axis{need: reloc.GOT}, target: Axis{need: dynamic.UNDEFINED}, outcome: ?dynamic.GOT_STATIC},
    Row{kind: Axis{need: reloc.GOT}, output: Axis{need: kind.PIC}, outcome: ?dynamic.GOT_REBASE},
    Row{kind: Axis{need: reloc.GOT}, outcome: ?dynamic.GOT_STATIC},
    Row{kind: Axis{need: reloc.PLT}, target: Axis{need: LATE}, outcome: ?dynamic.PLT_BIND},
    Row{kind: Axis{need: reloc.PLT}, outcome: ?dynamic.STATIC},
    Row{target: Axis{need: LIB_DATA}, output: Axis{deny: kind.PIC}, format: Axis{need: dynamic.COPIES}, outcome: ?dynamic.COPY},
    Row{kind: Axis{need: reloc.ABS}, site: Axis{need: SPELLED}, target: Axis{need: LATE | dynamic.DATA}, outcome: ?dynamic.BIND},
    Row{target: Axis{need: LIB_DATA}, output: Axis{need: kind.PIC}, outcome: ?dynamic.REFUSED, reason: "a copy relocation cannot be made in position-independent output"},
    Row{target: Axis{need: LATE | dynamic.CODE}, output: Axis{deny: kind.PIC}, outcome: ?dynamic.PLT_BIND},
    Row{kind: Axis{need: reloc.ABS}, site: Axis{need: SPELLED}, target: Axis{need: LATE}, outcome: ?dynamic.BIND},
    Row{kind: Axis{need: reloc.ABS}, site: Axis{need: dynamic.WORD}, target: Axis{need: LATE}, outcome: ?dynamic.REFUSED, reason: "an address in read-only data cannot be bound by the loader"},
    Row{target: Axis{need: LATE}, outcome: ?dynamic.REFUSED, reason: "a reference of this kind cannot reach a symbol the loader binds"},
    Row{kind: Axis{need: reloc.ABS}, site: Axis{need: SPELLED}, target: Axis{deny: FIXED}, output: Axis{need: kind.PIC}, outcome: ?dynamic.REBASE},
    Row{kind: Axis{need: reloc.ABS}, site: Axis{need: dynamic.LOW}, outcome: ?dynamic.STATIC},
    Row{kind: Axis{need: reloc.ABS}, site: Axis{need: dynamic.WORD}, target: Axis{deny: FIXED}, output: Axis{need: kind.PIC}, outcome: ?dynamic.REFUSED, reason: "an address in read-only data needs a text relocation"},
    Row{kind: Axis{need: reloc.ABS}, target: Axis{deny: FIXED}, output: Axis{need: kind.PIC}, outcome: ?dynamic.REFUSED, reason: "an absolute reference narrower than an address cannot be made position independent"},
    Row{outcome: ?dynamic.STATIC},
};

pub val DYNAMIC: dynamic.Rules = dynamic.Rules{
    name:  "elf",
    caps:  dynamic.INTERPOSES | dynamic.COPIES | dynamic.VERSIONED,
    rows:  ?DYNAMIC_ROWS[0],
    count: DYNAMIC_COUNT,
};

# the outcome DYNAMIC gives a direct reference to a library's data from an
# output of kind `k`, nil when no row decides it
fun data_reference(k: *Kind) *dynamic.Outcome {
    var f: Reference       = Reference{kind: ?reloc.PC32, target: dynamic.IMPORTED | dynamic.BOUND | dynamic.DATA};
    val w: res[*Row, Fail] = dynamic.decide(?DYNAMIC, ?f, k);
    if (sel w.err) { ret nil; }
    ret w.ok.outcome;
}

test rules__a_copy_relocation_is_chosen_in_an_executable_and_refused_in_position_independent_output {
    if (data_reference(?kind.DYNAMIC) != ?dynamic.COPY)   { ret 1; }
    if (data_reference(?kind.PIE) != ?dynamic.REFUSED)    { ret 1; }
    if (data_reference(?kind.SHARED) != ?dynamic.REFUSED) { ret 1; }
    ret 0;
}
