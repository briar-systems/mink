# the gather phase: the caller's sources become the link's inputs
#
# a given neutral object enters as it is. bytes are sniffed through the format
# registry, read into their format's model and converted to a neutral object,
# and the set keeps both. a container is kept whole for resolve to load its
# members, except one whose members are chosen by architecture, which gives
# the member for the link's architecture in its place. what this phase appends
# is owned by the set the moment it is made, so a failure part way leaves
# nothing unowned.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;

use mink.lib.catalog.arch;
use mink.lib.catalog.arch.Arch;
use mink.lib.catalog.format;
use mink.lib.catalog.format.Code;
use mink.lib.catalog.format.Format;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;
use mink.lib.format.contract;
use mink.lib.format.contract.Container;
use mink.lib.format.contract.Index;
use mink.lib.format.contract.Magic;
use mink.lib.format.contract.Member;
use mink.lib.format.contract.Model;
use mink.lib.format.contract.Ops;
use mink.lib.format.contract.Registration;
use mink.lib.format.contract.Revision;
use mink.lib.format.dump.Dumper;
use mink.lib.format.registry;
use mink.lib.format.registry.Registry;
use mink.lib.intern.Name;
use mink.lib.link.input;
use mink.lib.link.input.Inputs;
use mink.lib.link.input.Source;
use mink.lib.model.object;
use mink.lib.model.object.Object;
use mink.lib.model.object.Section;
use mink.lib.model.section;
use mink.lib.sink.Sink;
use mink.lib.store.Bytes;
use mink.lib.table;
use mink.lib.table.Id;
use mink.lib.table.Table;

# registry: the formats sources are sniffed through
# arch:     the architecture a converted object starts with
# sources:  what the caller hands over, in order
# count:    how many
pub rec In {
    registry: *Registry;
    arch:     *Arch;
    sources:  *Source;
    count:    usize;
}

pub fun run(in: *In, out: *Inputs) err[Fail] {
    var i: usize = 0;
    for (i < in.count) {
        val g: err[Fail] = gather(in, ?in.sources[i], out);
        if (sel g.err) { ret g; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun gather(in: *In, s: *Source, out: *Inputs) err[Fail] {
    if (sel s.object) {
        val b: res[Id[input.Input], Fail] = input.borrow(out, s.object);
        if (sel b.err) { ret err[Fail].err{b.err}; }
        ret err[Fail].ok{};
    }
    or (sel s.bytes) {
        ret load(in.registry, in.arch, s.bytes, out);
    }
    ret searched(in, s.searched, out);
}

# append what the bytes `src` of a library found by searching hold, each
# input they give marked searched
fun searched(in: *In, src: contract.Input, out: *Inputs) err[Fail] {
    val first: usize     = input.count(out);
    val l:     err[Fail] = load(in.registry, in.arch, src, out);
    if (sel l.err) { ret l; }
    var i: usize = first;
    for (i < input.count(out)) {
        input.at(out, table.nth[input.Input](i)).searched = true;
        i                                                 = i + 1;
    }
    ret err[Fail].ok{};
}

# append what the bytes `src` hold to `out`, sniffed through `r`, an object
# converted for the architecture `target` and a container kept whole
pub fun load(r: *Registry, target: *Arch, src: contract.Input, out: *Inputs) err[Fail] {
    var bytes: contract.Input   = src;
    val read:  res[Model, Fail] = registry.read(r, out.a, ?bytes);
    if (sel read.err) { ret err[Fail].err{read.err}; }
    val m: res[Id[Model], Fail] = input.keep(out, read.ok);
    if (sel m.err)                                                 { ret err[Fail].err{m.err}; }
    if (contract.is_container(table.at[Model](?out.models, m.ok))) { ret container(r, target, bytes.file, m.ok, out); }
    val e: res[Id[input.Input], Fail] = input.take(out, bytes.file, object.make(out.a, target), opt[Id[Model]].some{m.ok});
    if (sel e.err) { ret err[Fail].err{e.err}; }
    val model: *Model    = table.at[Model](?out.models, m.ok);
    val conv:  err[Fail] = contract.to_neutral(model, input.object_of(out, e.ok));
    if (sel conv.err) { ret err[Fail].err{fail.in_file(conv.err, bytes.file)}; }
    ret err[Fail].ok{};
}

# the container `m` named `file`: kept whole, or the member for the link's
# architecture when its members carry architecture codes
fun container(r: *Registry, target: *Arch, file: str, m: Id[Model], out: *Inputs) err[Fail] {
    var members: Table[Member] = table.make[Member](out.a);
    val listed:  err[Fail]     = contract.members(table.at[Model](?out.models, m), file, ?members);
    if (sel listed.err) {
        val dropped: err[Fail] = table.release[Member](?members);
        ret listed;
    }
    var coded: bool                = false;
    var pick:  opt[contract.Input] = opt[contract.Input].none{};
    var i:     usize               = 0;
    for (i < table.count[Member](?members)) {
        val member: *Member = table.at[Member](?members, table.nth[Member](i));
        if (sel member.arch.some) {
            coded = true;
            if (sel pick.none && for_arch(target, ?member.arch.some)) { pick = opt[contract.Input].some{member.input}; }
        }
        i = i + 1;
    }
    val dropped: err[Fail] = table.release[Member](?members);
    if (sel dropped.err) { ret dropped; }
    if (!coded) {
        val e: res[Id[input.Input], Fail] = input.contain(out, file, m);
        if (sel e.err) { ret err[Fail].err{e.err}; }
        ret err[Fail].ok{};
    }
    if (sel pick.none) {
        ret err[Fail].err{fail.in_file(fail.unsupported("the container holds no member for the link's architecture"), file)};
    }
    ret load(r, target, pick.some, out);
}

# whether `c` names the architecture `a`
fun for_arch(a: *Arch, c: *Code) bool {
    val row: res[*Arch, Fail] = arch.by_code(c.format, c.value, c.qualifier);
    ret sel row.ok && row.ok == a;
}

# a stub object format a test gathers: "OBJ!" and an alignment, converted to
# one text section of that alignment
val OBJ_FORMAT:    Format       = Format{name: "obj"};
val OBJ_BYTES:     [4]u8        = [4]u8{'O', 'B', 'J', '!'};
val OBJ_MAGICS:    [1]Magic     = [1]Magic{Magic{offset: 0, bytes: ?OBJ_BYTES[0], len: 4}};
val STUB_REVISION: [1]Revision  = [1]Revision{Revision{spec: "stub", revision: "1"}};
val OBJ:           Registration = Registration{
    format:         ?OBJ_FORMAT,
    ops:            Ops{read: obj_read, write: stub_write, dump: stub_dump, to_neutral: obj_to_neutral, from_neutral: stub_from_neutral, locate: stub_locate, release: stub_release},
    magics:         ?OBJ_MAGICS[0],
    magic_count:    1,
    revisions:      ?STUB_REVISION[0],
    revision_count: 1,
};

# a stub container format whose members are chosen by architecture: "FAT!",
# holding one object for x86_64 and one for aarch64
val FAT_FORMAT: Format       = Format{name: "fat"};
val FAT_BYTES:  [4]u8        = [4]u8{'F', 'A', 'T', '!'};
val FAT_MAGICS: [1]Magic     = [1]Magic{Magic{offset: 0, bytes: ?FAT_BYTES[0], len: 4}};
val FAT:        Registration = Registration{
    format:         ?FAT_FORMAT,
    ops:            Ops{read: fat_read, write: stub_write, dump: stub_dump, to_neutral: fat_to_neutral, from_neutral: stub_from_neutral, locate: stub_locate, release: stub_release},
    magics:         ?FAT_MAGICS[0],
    magic_count:    1,
    revisions:      ?STUB_REVISION[0],
    revision_count: 1,
    container:      opt[Container].some{Container{members: fat_members, index: opt[Index].none{}}},
};

val SLICE_X86_64:  [5]u8 = [5]u8{'O', 'B', 'J', '!', 16};
val SLICE_AARCH64: [5]u8 = [5]u8{'O', 'B', 'J', '!', 4};

fun obj_read(a: *A.Allocator, in: *contract.Input) res[ptr, Fail] {
    if (in.len < 5) { ret res[ptr, Fail].err{fail.truncated("no alignment")}; }
    val m: res[*u64, A.Error] = A.allocate[u64](a, 1);
    if (sel m.err) { ret res[ptr, Fail].err{fail.refused(m.err)}; }
    @m.ok = in.data[4]::u64;
    ret res[ptr, Fail].ok{m.ok::ptr};
}

fun obj_to_neutral(m: ptr, o: *Object) err[Fail] {
    val nm: res[Id[Name], Fail] = object.name_str(o, ".text");
    if (sel nm.err) { ret err[Fail].err{nm.err}; }
    val s: res[Id[Section], Fail] = object.add_section(o, Section{name: nm.ok, kind: ?section.TEXT, flags: section.TEXT.flags, align: @(m::*u64)});
    if (sel s.err) { ret err[Fail].err{s.err}; }
    ret err[Fail].ok{};
}

fun fat_read(a: *A.Allocator, in: *contract.Input) res[ptr, Fail] {
    val m: res[*u64, A.Error] = A.allocate[u64](a, 1);
    if (sel m.err) { ret res[ptr, Fail].err{fail.refused(m.err)}; }
    ret res[ptr, Fail].ok{m.ok::ptr};
}

fun fat_to_neutral(m: ptr, o: *Object) err[Fail] {
    ret err[Fail].err{fail.unsupported("a container has no neutral form")};
}

fun fat_members(m: ptr, file: str, out: *Table[Member]) err[Fail] {
    val x: res[Id[Member], Fail] = table.push[Member](out, Member{
        name:  Bytes{data: "x86_64"::*u8, len: 6},
        input: contract.Input{file: file, data: ?SLICE_X86_64[0], len: 5},
        arch:  opt[Code].some{Code{format: ?format.ELF, value: 62, qualifier: 2}},
    });
    if (sel x.err) { ret err[Fail].err{x.err}; }
    val y: res[Id[Member], Fail] = table.push[Member](out, Member{
        name:  Bytes{data: "aarch64"::*u8, len: 7},
        input: contract.Input{file: file, data: ?SLICE_AARCH64[0], len: 5},
        arch:  opt[Code].some{Code{format: ?format.ELF, value: 183, qualifier: 2}},
    });
    if (sel y.err) { ret err[Fail].err{y.err}; }
    ret err[Fail].ok{};
}

fun stub_write(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret res[Sink, Fail].err{fail.unsupported("the stub format is read only")};
}

fun stub_dump(m: ptr, d: *Dumper) err[Fail] {
    ret err[Fail].ok{};
}

fun stub_from_neutral(a: *A.Allocator, o: *Object) res[ptr, Fail] {
    ret res[ptr, Fail].err{fail.unsupported("the stub format is read only")};
}

fun stub_locate(m: ptr, offset: u64) Location {
    ret Location{offset: offset, placed: true};
}

fun stub_release(a: *A.Allocator, m: ptr) err[Fail] {
    val r: err[A.Error] = A.deallocate[u64](a, m::*u64, 1);
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}

# the alignment of the one section of the one input gathering the fat stub for
# `target` gives, zero when gathering is refused as having no member for it
fun gathered(t: *T.Testing, r: *Registry, target: *Arch) res[u64, Fail] {
    val fat:    [4]u8          = [4]u8{'F', 'A', 'T', '!'};
    var source: Source         = Source.bytes{contract.Input{file: "u.fat", data: ?fat[0], len: 4}};
    var in:     In             = In{registry: r, arch: target, sources: ?source, count: 1};
    var out:    Inputs         = input.make(T.allocator_of(t));
    val g:      err[Fail]      = run(?in, ?out);
    var align:  res[u64, Fail] = res[u64, Fail].ok{0};
    if (sel g.err) {
        if (!sel g.err.cause.unsupported || g.err.at.file == nil || !str_equals(g.err.at.file, "u.fat")) { align = res[u64, Fail].err{g.err}; }
    }
    or (input.count(?out) != 1) {
        align = res[u64, Fail].err{fail.internal("one input")};
    }
    or {
        val o:       *Object       = input.object_of(?out, table.nth[input.Input](0));
        val e:       *input.Input  = input.at(?out, table.nth[input.Input](0));
        var members: Table[Member] = table.make[Member](T.allocator_of(t));
        var refused: bool          = false;
        if (sel e.model.some) {
            val listed: err[Fail] = contract.members(table.at[Model](?out.models, e.model.some), "x.o", ?members);
            refused = sel listed.err && sel listed.err.cause.unsupported;
        }
        if (!refused || table.count[Member](?members) != 0)     { align = res[u64, Fail].err{fail.internal("an object is not a container")}; }
        or (o == nil || table.count[Section](?o.sections) != 1) { align = res[u64, Fail].err{fail.internal("one section")}; }
        or                                                      { align = res[u64, Fail].ok{object.section_at(o, table.nth[Section](0)).align}; }
        val dropped: err[Fail] = table.release[Member](?members);
        if (sel dropped.err) { align = res[u64, Fail].err{dropped.err}; }
    }
    val rel: err[Fail] = input.release(?out);
    if (sel rel.err) { ret res[u64, Fail].err{rel.err}; }
    ret align;
}

test gather__picks_the_member_for_the_link_architecture {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val declared: opt[Container] = OBJ.container;
    if (!sel declared.none) { ret 1; }
    val entries: [2]*Registration    = [2]*Registration{?FAT, ?OBJ};
    var r:       res[Registry, Fail] = registry.make(?entries[0], 2);
    if (sel r.err) { ret 1; }
    val x: res[u64, Fail] = gathered(?t, ?r.ok, ?arch.X86_64);
    if (sel x.err)  { ret 1; }
    if (x.ok != 16) { ret 1; }
    val y: res[u64, Fail] = gathered(?t, ?r.ok, ?arch.AARCH64);
    if (sel y.err) { ret 1; }
    if (y.ok != 4) { ret 1; }
    val none: res[u64, Fail] = gathered(?t, ?r.ok, ?arch.RISCV64);
    if (sel none.err)          { ret 1; }
    if (none.ok != 0)          { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
