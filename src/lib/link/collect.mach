# the garbage collection phase: the sections reachable from the roots survive

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.link.input;
use mink.lib.link.input.Appended;
use mink.lib.link.input.Input;
use mink.lib.link.input.Inputs;
use mink.lib.link.kind.Kind;
use mink.lib.link.resolve.Resolved;
use mink.lib.model.object.Object;
use mink.lib.model.object.Section;
use mink.lib.table;
use mink.lib.table.Id;
use mink.lib.table.Table;

# entry: the entry symbol, a root, nil where the link has none
pub rec In {
    inputs:   *Inputs;
    resolved: *Resolved;
    kind:     *Kind;
    entry:    str;
}

# a section of an input
pub rec Ref {
    input:   Id[Input];
    section: Id[Section];
}

# kept: every section that survived
pub rec Live {
    kept: Table[Ref];
}

pub fun make(a: *A.Allocator) Live {
    ret Live{kept: table.make[Ref](a)};
}

pub fun run(in: *In, out: *Live) err[Fail] {
    ret err[Fail].err{fail.unsupported("collecting garbage is not supported yet")};
}

# keep every section of the inputs `made` appended after collection, which
# were made from what survived and are not collected again
pub fun adopt(l: *Live, s: *Inputs, made: Appended) err[Fail] {
    var i: usize = made.first;
    for (i < made.first + made.count) {
        val id: Id[Input] = table.nth[Input](i);
        val o:  *Object   = input.object_of(s, id);
        var k:  usize     = 0;
        if (o != nil) {
            for (k < table.count[Section](?o.sections)) {
                val pushed: res[Id[Ref], Fail] = table.push[Ref](?l.kept, Ref{input: id, section: table.nth[Section](k)});
                if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

pub fun release(l: *Live) err[Fail] {
    ret table.release[Ref](?l.kept);
}
