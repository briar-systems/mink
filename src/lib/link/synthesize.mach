# the synthesize phase: linker-made inputs, appended to the input set as
# ordinary inputs at each moment the link makes them
#
# the table below is the one way the link makes an input itself. a row is
# added to it and names the stage it runs at, and the phase does not change.
# the state's phase table runs the phase once for each stage, at that stage's
# moment, so it stays the one owner of the order.
#
# what a stage made is resolved as the stage declares. before resolution the
# resolve phase takes it with every other input. after it, extend resolves
# only the new inputs against the answers already bound, no archive is
# searched again and a new input holds no group. after collection, the new
# inputs also keep every section, since collection is over.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use mink.lib.fail.Fail;
use mink.lib.link.collect;
use mink.lib.link.common;
use mink.lib.link.input.Appended;
use mink.lib.link.resolve;
use mink.lib.link.synthesizer;
use mink.lib.link.synthesizer.Context;
use mink.lib.link.synthesizer.Row;
use mink.lib.link.synthesizer.Stage;

# context: what every synthesizer reads, whose inputs the phase appends to
# resolve: how the inputs a stage after resolution made are resolved, nil
#          before resolve
pub rec In {
    context: Context;
    resolve: *resolve.In;
}

# appended: the inputs each stage appended, in the stage table's order
pub rec Synthesized {
    appended: [synthesizer.STAGE_COUNT]Appended;
}

val ROW_COUNT: usize           = 1;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{?common.ROW};

# run the rows of `stage`
pub fun run(in: *In, out: *Synthesized, stage: *Stage) err[Fail] {
    val r: res[Appended, Fail] = synthesizer.apply(?in.context, ?ROWS[0], ROW_COUNT, stage);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    out.appended[synthesizer.position(stage)] = r.ok;
    if (r.ok.count == 0) { ret err[Fail].ok{}; }
    if (stage.resolves) {
        val e: err[Fail] = resolve.extend(in.resolve, in.context.resolved, r.ok.first);
        if (sel e.err) { ret e; }
    }
    if (stage.keeps) { ret collect.adopt(in.context.live, in.context.inputs, r.ok); }
    ret err[Fail].ok{};
}
