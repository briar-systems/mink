# the synthesize phase: linker-made inputs that must exist before garbage
# collection, appended to the input set as ordinary inputs

use std.types.error.err;

use mink.lib.catalog.arch.Arch;
use mink.lib.catalog.os.Host;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.link.input.Appended;
use mink.lib.link.input.Inputs;
use mink.lib.link.kind.Kind;
use mink.lib.link.settle.Settled;

# inputs:  the set synthesized inputs are appended to
# settled: the settled facts
pub rec In {
    inputs:  *Inputs;
    settled: *Settled;
    kind:    *Kind;
    arch:    *Arch;
    host:    *Host;
}

# appended: the inputs this phase appended
pub rec Synthesized {
    appended: Appended;
}

pub fun run(in: *In, out: *Synthesized) err[Fail] {
    ret err[Fail].err{fail.unsupported("synthesizing inputs awaits mink-39")};
}
