# the synthesize phase: linker-made inputs that must exist before garbage
# collection, appended to the input set as ordinary inputs
#
# the table below is the one way the link makes an input itself. a row is
# added to it and the phase does not change.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use mink.lib.fail.Fail;
use mink.lib.link.common;
use mink.lib.link.input.Appended;
use mink.lib.link.synthesizer;
use mink.lib.link.synthesizer.Context;
use mink.lib.link.synthesizer.Row;

# the context every synthesizer reads, whose inputs the phase appends to
pub def In: Context;

# appended: the inputs this phase appended
pub rec Synthesized {
    appended: Appended;
}

val ROW_COUNT: usize           = 1;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{?common.ROW};

pub fun run(in: *In, out: *Synthesized) err[Fail] {
    val r: res[Appended, Fail] = synthesizer.apply(in, ?ROWS[0], ROW_COUNT);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    out.appended = r.ok;
    ret err[Fail].ok{};
}
