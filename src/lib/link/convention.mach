# how each output format's linker resolves symbols
#
# one row per format: how its linker searches archives and the hooks its own
# resolution rules join the resolve phase through. the phase reads the row
# and never asks which format it is.

use std.types.result.res;
use std.types.size.usize;

use mink.lib.catalog.format;
use mink.lib.catalog.format.Format;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.link.resolve;
use mink.lib.link.resolve.Hooks;

# format: the output format
# search: how its linker searches archives
# hooks:  its resolution rules
pub rec Convention {
    format: *Format;
    search: resolve.Caps;
    hooks:  *Hooks;
}

# GNU ld searches an archive once where it stands, link.exe, ld64 and wasm-ld
# search every archive again while a name is left undefined
val ELF:   Convention = Convention{format: ?format.ELF, search: 0, hooks: ?resolve.PLAIN};
val COFF:  Convention = Convention{format: ?format.COFF, search: resolve.REVISIT, hooks: ?resolve.PLAIN};
val MACHO: Convention = Convention{format: ?format.MACHO, search: resolve.REVISIT, hooks: ?resolve.PLAIN};
val WASM:  Convention = Convention{format: ?format.WASM, search: resolve.REVISIT, hooks: ?resolve.PLAIN};
val SPIRV: Convention = Convention{format: ?format.SPIRV, search: 0, hooks: ?resolve.PLAIN};
val FLAT:  Convention = Convention{format: ?format.FLAT, search: 0, hooks: ?resolve.PLAIN};

val ROW_COUNT: usize                  = 6;
val ROWS:      [ROW_COUNT]*Convention = [ROW_COUNT]*Convention{?ELF, ?COFF, ?MACHO, ?WASM, ?SPIRV, ?FLAT};

# the convention of the output format `f`
pub fun of(f: *Format) res[*Convention, Fail] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].format == f) { ret res[*Convention, Fail].ok{ROWS[i]}; }
        i = i + 1;
    }
    ret res[*Convention, Fail].err{fail.in_record(fail.unsupported("the format has no symbol resolution convention"), f.name)};
}
