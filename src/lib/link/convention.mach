# how each output format's linker resolves and binds symbols
#
# one row per format: how its linker searches archives, the hooks its own
# resolution rules join the resolve phase through, and the rules that decide
# what each reference needs across the image's boundary. the phases read the
# row and never ask which format it is.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use mink.lib.catalog.format;
use mink.lib.catalog.format.Format;
use coff_rules: mink.lib.coff.rules;
use elf_rules:  mink.lib.elf.rules;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.link.dynamic;
use mink.lib.link.dynamic.Rules;
use mink.lib.link.resolve;
use mink.lib.link.resolve.Hooks;
use macho_rules: mink.lib.macho.rules;

# format:  the output format
# search:  how its linker searches archives, and whether a common definition
#          pulls an archive member that defines its name as data
# hooks:   its resolution rules
# dynamic: its dynamic linking rules
pub rec Convention {
    format:  *Format;
    search:  resolve.Caps;
    hooks:   *Hooks;
    dynamic: *Rules;
}

# GNU ld searches an archive once where it stands, link.exe, ld64 and wasm-ld
# search every archive again while a name is left undefined.
#
# a common definition pulls a member that defines its name as data in GNU ld,
# whose archive search includes the member when it defines a symbol held as
# common (elf_link_add_archive_symbols in bfd/elflink.c). lld does so only
# with --fortran-common, which the ELF row does not follow, since a mink link
# takes GNU ld as the reference. whether link.exe and ld64 do so is not
# verified, so the COFF and Mach-O rows leave the capability off. wasm objects
# have no common symbols and a SPIR-V or flat image has no archive search
val ELF:   Convention = Convention{format: ?format.ELF, search: resolve.COMMON_PULL, hooks: ?resolve.PLAIN, dynamic: ?elf_rules.DYNAMIC};
val COFF:  Convention = Convention{format: ?format.COFF, search: resolve.REVISIT, hooks: ?resolve.PLAIN, dynamic: ?coff_rules.DYNAMIC};
val MACHO: Convention = Convention{format: ?format.MACHO, search: resolve.REVISIT, hooks: ?resolve.PLAIN, dynamic: ?macho_rules.DYNAMIC};
val WASM:  Convention = Convention{format: ?format.WASM, search: resolve.REVISIT, hooks: ?resolve.PLAIN, dynamic: ?dynamic.UNBOUND};
val SPIRV: Convention = Convention{format: ?format.SPIRV, search: 0, hooks: ?resolve.PLAIN, dynamic: ?dynamic.UNBOUND};
val FLAT:  Convention = Convention{format: ?format.FLAT, search: 0, hooks: ?resolve.PLAIN, dynamic: ?dynamic.UNBOUND};

val ROW_COUNT: usize                  = 6;
val ROWS:      [ROW_COUNT]*Convention = [ROW_COUNT]*Convention{?ELF, ?COFF, ?MACHO, ?WASM, ?SPIRV, ?FLAT};

# the convention of the output format `f`
pub fun of(f: *Format) res[*Convention, Fail] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].format == f) { ret res[*Convention, Fail].ok{ROWS[i]}; }
        i = i + 1;
    }
    ret res[*Convention, Fail].err{fail.in_record(fail.unsupported("the format has no symbol resolution convention"), f.name)};
}

test convention__every_dynamic_decision_table_is_sound {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val e: err[Fail] = dynamic.check(ROWS[i].dynamic);
        if (sel e.err) { ret 1; }
        i = i + 1;
    }
    ret 0;
}
