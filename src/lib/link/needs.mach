# the runtime needs phase: program-wide requirements decided over the code
# that survived garbage collection, their support appended as ordinary inputs

use std.types.error.err;

use mink.lib.catalog.os.Host;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.link.collect.Live;
use mink.lib.link.input.Appended;
use mink.lib.link.input.Inputs;
use mink.lib.link.kind.Kind;

# inputs: the set support inputs are appended to
# live:   what survived garbage collection, the only code needs are read from
pub rec In {
    inputs: *Inputs;
    live:   *Live;
    kind:   *Kind;
    host:   *Host;
}

# appended: the support inputs this phase appended
pub rec Needs {
    appended: Appended;
}

pub fun run(in: *In, out: *Needs) err[Fail] {
    ret err[Fail].err{fail.unsupported("deciding runtime needs is not supported yet")};
}
