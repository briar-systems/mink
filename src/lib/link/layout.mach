# the layout phase: surviving sections merge into output sections and
# segments and take their addresses, relaxation and thunks iterating until
# nothing moves. it reads no address an earlier run left, so running it again
# after a later phase grows a table lays everything out afresh

use std.types.error.err;

use A: std.allocator;

use mink.lib.catalog.arch.Arch;
use mink.lib.catalog.os.Host;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.intern.Interner;
use mink.lib.intern.Name;
use mink.lib.link.collect.Live;
use mink.lib.link.collect.Ref;
use mink.lib.link.input.Inputs;
use mink.lib.link.kind.Kind;
use mink.lib.link.reserve.Reserved;
use mink.lib.link.resolve.Resolved;
use mink.lib.model.section;
use mink.lib.table;
use mink.lib.table.Id;
use mink.lib.table.Table;

pub rec In {
    inputs:   *Inputs;
    names:    *Interner;
    resolved: *Resolved;
    live:     *Live;
    reserved: *Reserved;
    kind:     *Kind;
    arch:     *Arch;
    host:     *Host;
}

# an output section
# ---
# name:    its name, in the link's names
# kind:    the role it plays
# flags:   the flags it carries
# align:   its alignment
# size:    its size in memory
# address: where it is loaded
# offset:  where its bytes sit in the file
pub rec Merged {
    name:    Id[Name];
    kind:    *section.Kind;
    flags:   section.Flags;
    align:   u64;
    size:    u64;
    address: u64;
    offset:  u64;
}

# where an input section landed: the output section and its offset there
pub rec Landing {
    at:     Ref;
    merged: Id[Merged];
    offset: u64;
}

# rounds: how many passes relaxation took to reach its fixed point
pub rec Layout {
    merged:   Table[Merged];
    landings: Table[Landing];
    rounds:   u32;
}

pub fun make(a: *A.Allocator) Layout {
    ret Layout{merged: table.make[Merged](a), landings: table.make[Landing](a)};
}

pub fun run(in: *In, out: *Layout) err[Fail] {
    ret err[Fail].err{fail.unsupported("laying out sections is not supported yet")};
}

pub fun release(l: *Layout) err[Fail] {
    val rm: err[Fail] = table.release[Merged](?l.merged);
    val rl: err[Fail] = table.release[Landing](?l.landings);
    if (sel rm.err) { ret rm; }
    ret rl;
}
