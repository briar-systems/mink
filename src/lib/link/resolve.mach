# the resolve phase: every reference binds to exactly one definition, and
# archives contribute the members the link needs

use std.types.error.err;

use A: std.allocator;

use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.intern.Interner;
use mink.lib.intern.Name;
use mink.lib.link.input.Input;
use mink.lib.link.input.Inputs;
use mink.lib.model.object.Symbol;
use mink.lib.table;
use mink.lib.table.Id;
use mink.lib.table.Table;

# inputs: the set to resolve, which archive members are appended to
# names:  the link's names
pub rec In {
    inputs: *Inputs;
    names:  *Interner;
}

# where a name is defined: the winning symbol of an input
pub rec Binding {
    name:   Id[Name];
    input:  Id[Input];
    symbol: Id[Symbol];
}

# a name a loader binds at run time, and the library that defines it
pub rec Import {
    name:    Id[Name];
    library: Id[Name];
}

# an archive member the link loaded: the archive's input and the member's
pub rec Member {
    archive: Id[Input];
    loaded:  Id[Input];
}

pub rec Resolved {
    bindings: Table[Binding];
    imports:  Table[Import];
    members:  Table[Member];
}

pub fun make(a: *A.Allocator) Resolved {
    ret Resolved{
        bindings: table.make[Binding](a),
        imports:  table.make[Import](a),
        members:  table.make[Member](a),
    };
}

pub fun run(in: *In, out: *Resolved) err[Fail] {
    ret err[Fail].err{fail.unsupported("resolving symbols is not supported yet")};
}

pub fun release(r: *Resolved) err[Fail] {
    val rb: err[Fail] = table.release[Binding](?r.bindings);
    val ri: err[Fail] = table.release[Import](?r.imports);
    val rm: err[Fail] = table.release[Member](?r.members);
    if (sel rb.err) { ret rb; }
    if (sel ri.err) { ret ri; }
    ret rm;
}
