# the relocate phase: every relocation of a surviving section is applied to
# the bytes of the output section it landed in

use std.types.error.err;

use A: std.allocator;

use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.link.input.Inputs;
use mink.lib.link.layout.Layout;
use mink.lib.link.reserve.Reserved;
use mink.lib.link.resolve.Resolved;
use mink.lib.table;
use mink.lib.table.Table;

pub rec In {
    inputs:   *Inputs;
    resolved: *Resolved;
    reserved: *Reserved;
    layout:   *Layout;
}

# bytes: the contents of the output sections, relocated, each at its file
#        offset
pub rec Relocated {
    bytes: Table[u8];
}

pub fun make(a: *A.Allocator) Relocated {
    ret Relocated{bytes: table.make[u8](a)};
}

pub fun run(in: *In, out: *Relocated) err[Fail] {
    ret err[Fail].err{fail.unsupported("applying relocations awaits mink-44")};
}

pub fun release(r: *Relocated) err[Fail] {
    ret table.release[u8](?r.bytes);
}
