    Row{code: ?tables.LC_NOTE, parse: parse_note},
    Row{code: ?tables.LC_BUILD_VERSION, parse: parse_build_version},
    Row{code: ?tables.LC_FILESET_ENTRY, parse: parse_fileset_entry},
    Row{code: ?tables.LC_TARGET_TRIPLE, parse: parse_target_triple},
