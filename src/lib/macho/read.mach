fun parse_source_version(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val v: u64 = w64(k);
    ret loaded(k, Load.source_version{v});
}

fun parse_linker_option(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val n: u32 = w32(k);
    ret loaded(k, Load.linker_option{n});
}

fun parse_note(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var n: Note;
    wbytes(k, ?n.owner[0], 16);
    n.offset = w64(k);
    n.size   = w64(k);
    ret loaded(k, Load.note{n});
}

fun parse_build_version(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var b: BuildVersion;
    b.platform = w32(k);
    b.minos    = w32(k);
    b.sdk      = w32(k);
    b.ntools   = w32(k);
    if (k.failed) { ret res[Load, Fail].err{k.why}; }
    val room: u64 = b.ntools::u64 * TOOL_SIZE;
    if (room > reader.remaining(?k.r)::u64) {
        ret res[Load, Fail].err{at(fail.malformed("tool versions run past their load command"), k.r.base + k.r.pos::u64)};
    }
    b.tools = table.make[Tool](x.m.a);
    var i: u32 = 0;
    for (i < b.ntools) {
        var t: Tool;
        t.tool    = w32(k);
        t.version = w32(k);
        val pushed: res[Id[Tool], Fail] = table.push[Tool](?b.tools, t);
        if (sel pushed.err) {
            val r: err[Fail] = table.release[Tool](?b.tools);
            ret res[Load, Fail].err{pushed.err};
        }
        i = i + 1;
    }
    ret res[Load, Fail].ok{Load.build_version{b}};
}

fun parse_fileset_entry(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var f: FilesetEntry;
    f.vmaddr   = w64(k);
    f.fileoff  = w64(k);
    f.entry_id = wname(k);
    f.reserved = w32(k);
    ret loaded(k, Load.fileset_entry{f});
}

fun parse_target_triple(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val n: Name = wname(k);
    ret loaded(k, Load.target_triple{n});
}

fun layout(x: *Ctx) err[Fail] {
    var all: Table[Range] = table.make[Range](x.m.a);
    val r:   err[Fail]    = collect(x, ?all);
    if (sel r.err) {
        val dropped: err[Fail] = table.release[Range](?all);
        ret r;
    }
    sort.sort_by[Range](table.items[Range](?all), table.count[Range](?all), by_start);
    val e:   err[Fail] = emit(x, ?all);
    val rel: err[Fail] = table.release[Range](?all);
    if (sel e.err) { ret e; }
    ret rel;
}

# gather every range the commands name
fun collect(x: *Ctx, all: *Table[Range]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Command](?x.m.commands)) {
        val c: *Command  = model.command_at(x.m, table.nth[Command](i));
        val r: err[Fail] = place_command(x, all, i, c);
        if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "load command", i::u64)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun place_command(x: *Ctx, all: *Table[Range], i: usize, c: *Command) err[Fail] {
    val cls:    *Class = x.c;
    val at_cmd: u64    = table.items[u64](?x.offsets)[i];
    val base:   Range  = Range{cmd: i::u32, part: Part.symbols{}};
    if (sel c.body.segment) {
        var j: usize = 0;
        for (j < table.count[Section](?c.body.segment.sections)) {
            val s:      *Section = table.at[Section](?c.body.segment.sections, table.nth[Section](j));
            val header: u64      = at_cmd + cls.segment.size::u64 + j::u64 * cls.section.size::u64;
            var one:    Range    = base;
            one.sect = j::u32;
            if (!zerofill(s)) {
                one.kind = KIND_SECTION;
                val b: err[Fail] = put_counted(x, all, one, s.offset::u64, s.length, 1, header + cls.section.offset.offset::u64);
                if (sel b.err) { ret err[Fail].err{fail.in_indexed(b.err, "section", j::u64)}; }
            }
            one.kind = KIND_RELOCS;
            val r: err[Fail] = put_counted(x, all, one, s.reloff::u64, s.nreloc::u64, RELOC_SIZE, header + cls.section.reloff.offset::u64);
            if (sel r.err) { ret err[Fail].err{fail.in_indexed(r.err, "section", j::u64)}; }
            j = j + 1;
        }
        ret err[Fail].ok{};
    }
    if (sel c.body.symtab) {
        val a: err[Fail] = part(x, all, base, Part.symbols{}, c, at_cmd);
        if (sel a.err) { ret a; }
        ret part(x, all, base, Part.strings{}, c, at_cmd);
    }
    if (sel c.body.dysymtab)  { ret place_dysymtab(x, all, base, c, ?c.body.dysymtab, at_cmd); }
    if (sel c.body.hints)     { ret part(x, all, base, Part.hints{}, c, at_cmd); }
    if (sel c.body.dyld_info) { ret place_dyld_info(x, all, base, c, ?c.body.dyld_info, at_cmd); }
    if (sel c.body.linkedit)  { ret part(x, all, base, Part.data{}, c, at_cmd); }
    if (sel c.body.note)      { ret part(x, all, base, Part.note{}, c, at_cmd); }
    if (sel c.body.symseg)    { ret part(x, all, base, Part.symseg{}, c, at_cmd); }
    ret err[Fail].ok{};
}

fun place_dysymtab(x: *Ctx, all: *Table[Range], base: Range, c: *Command, d: *Dysymtab, at_cmd: u64) err[Fail] {
    val r1: err[Fail] = symbol_range(x, d.ilocalsym, d.nlocalsym, at_cmd);
    if (sel r1.err) { ret r1; }
    val r2: err[Fail] = symbol_range(x, d.iextdefsym, d.nextdefsym, at_cmd);
    if (sel r2.err) { ret r2; }
    val r3: err[Fail] = symbol_range(x, d.iundefsym, d.nundefsym, at_cmd);
    if (sel r3.err) { ret r3; }
    val r4: err[Fail] = part(x, all, base, Part.toc{}, c, at_cmd);
    if (sel r4.err) { ret r4; }
    val r5: err[Fail] = part(x, all, base, Part.modules{}, c, at_cmd);
    if (sel r5.err) { ret r5; }
    val r6: err[Fail] = part(x, all, base, Part.refs{}, c, at_cmd);
    if (sel r6.err) { ret r6; }
    val r7: err[Fail] = part(x, all, base, Part.indirect{}, c, at_cmd);
    if (sel r7.err) { ret r7; }
    val r8: err[Fail] = part(x, all, base, Part.extrel{}, c, at_cmd);
    if (sel r8.err) { ret r8; }
    ret part(x, all, base, Part.locrel{}, c, at_cmd);
}

# `n` symbols from `first` must lie in the symbol table
fun symbol_range(x: *Ctx, first: u32, n: u32, at_cmd: u64) err[Fail] {
    val end: res[u64, Fail] = checked.add(loc(x, at_cmd), first::u64, n::u64);
    if (sel end.err)      { ret err[Fail].err{end.err}; }
    if (end.ok > x.nsyms) { ret err[Fail].err{at(fail.malformed("symbol range runs past the symbol table"), at_cmd)}; }
    ret err[Fail].ok{};
}

fun place_dyld_info(x: *Ctx, all: *Table[Range], base: Range, c: *Command, d: *DyldInfo, at_cmd: u64) err[Fail] {
    val r1: err[Fail] = part(x, all, base, Part.rebase{}, c, at_cmd);
    if (sel r1.err) { ret r1; }
    val r2: err[Fail] = part(x, all, base, Part.bind{}, c, at_cmd);
    if (sel r2.err) { ret r2; }
    val r3: err[Fail] = part(x, all, base, Part.weak_bind{}, c, at_cmd);
    if (sel r3.err) { ret r3; }
    val r4: err[Fail] = part(x, all, base, Part.lazy_bind{}, c, at_cmd);
    if (sel r4.err) { ret r4; }
    ret part(x, all, base, Part.exports{}, c, at_cmd);
}

fun part(x: *Ctx, all: *Table[Range], base: Range, p: Part, c: *Command, at_cmd: u64) err[Fail] {
    val sp: res[Span, Fail] = model.part_span(x.c, c, p, loc(x, at_cmd));
    if (sel sp.err) { ret err[Fail].err{sp.err}; }
    var r: Range = base;
    r.kind = KIND_BLOB;
    r.part = p;
    ret put(x, all, r, sp.ok, at_cmd);
}

# add the range of `count` records of `size` bytes at `offset`, which must
# lie in the file. an empty range names no bytes and is not added
fun put(x: *Ctx, all: *Table[Range], what: Range, sp: Span, at_field: u64) err[Fail] {
    if (sp.size == 0) { ret err[Fail].ok{}; }
    val end: res[u64, Fail] = checked.add(loc(x, at_field), sp.offset, sp.size);
    if (sel end.err) { ret err[Fail].err{end.err}; }
    if (end.ok > x.in.len::u64) {
        ret err[Fail].err{at(fail.truncated("bytes run past the end of the file"), at_field)};
    }
    var r: Range = what;
    r.start = sp.offset;
    r.end   = end.ok;
    val pushed: res[Id[Range], Fail] = table.push[Range](all, r);
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

# `put` for `count` records of `size` bytes at `offset`
fun put_counted(x: *Ctx, all: *Table[Range], what: Range, offset: u64, count: u64, size: u64, at_field: u64) err[Fail] {
    val sp: res[Span, Fail] = model.counted(loc(x, at_field), offset, count, size);
    if (sel sp.err) { ret err[Fail].err{sp.err}; }
    ret put(x, all, what, sp.ok, at_field);
}

fun by_start(a: *Range, b: *Range) i64 {
    if (a.start != b.start) {
        if (a.start < b.start) { ret -1; }
        ret 1;
    }
    if (a.kind != b.kind) { ret a.kind::i64 - b.kind::i64; }
    if (a.cmd != b.cmd)   { ret a.cmd::i64 - b.cmd::i64; }
    ret a.sect::i64 - b.sect::i64;
}

# tile the file after the commands with extents, in file order
fun emit(x: *Ctx, all: *Table[Range]) err[Fail] {
    var cursor: u64   = x.end;
    var k:      usize = 0;
    for (k < table.count[Range](all)) {
        val r: Range = table.items[Range](all)[k];
        if (r.start < cursor) {
            ret err[Fail].err{at(fail.in_record(fail.malformed("bytes belong to two records"), "file layout"), r.start)};
        }
        if (r.start > cursor) {
            val g: err[Fail] = push_raw(x, cursor, r.start);
            if (sel g.err) { ret g; }
        }
        val e: err[Fail] = emit_range(x, r);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "load command", r.cmd::u64)}; }
        cursor = r.end;
        k      = k + 1;
    }
    if (cursor < x.in.len::u64) { ret push_raw(x, cursor, x.in.len::u64); }
    ret err[Fail].ok{};
}

fun push_raw(x: *Ctx, start: u64, end: u64) err[Fail] {
    val h: res[Held, Fail] = held(?x.file, start, end - start);
    if (sel h.err) { ret err[Fail].err{h.err}; }
    ret push_extent(x, Extent.raw{h.ok});
}

fun push_extent(x: *Ctx, e: Extent) err[Fail] {
    val p: res[Id[Extent], Fail] = table.push[Extent](?x.m.extents, e);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun emit_range(x: *Ctx, r: Range) err[Fail] {
    val sub: res[Reader, Fail] = reader.sub(?x.file, r.start, r.end - r.start);
    if (sel sub.err) { ret err[Fail].err{sub.err}; }
    var rd: Reader = sub.ok;
    if (r.kind == KIND_BLOB) { ret emit_blob(x, r, ?rd); }
    val ref: SectionRef          = SectionRef{command: table.nth[Command](r.cmd::usize), index: r.sect};
    val sec: res[*Section, Fail] = model.section(x.m, ref);
    if (sel sec.err) { ret err[Fail].err{sec.err}; }
    if (r.kind == KIND_SECTION) {
        val b: res[Body, Fail] = read_body(x, sec.ok, ?rd);
        if (sel b.err) { ret err[Fail].err{fail.in_indexed(b.err, "section", r.sect::u64)}; }
        sec.ok.body = b.ok;
        ret push_extent(x, Extent.section{ref});
    }
    val n: res[Table[Reloc], Fail] = relocs(x, ?rd, rd.len::u64 / RELOC_SIZE);
    if (sel n.err) { ret err[Fail].err{fail.in_indexed(n.err, "section", r.sect::u64)}; }
    sec.ok.relocs = n.ok;
    ret push_extent(x, Extent.relocs{ref});
}

# the body of a section that owns bytes: typed when its type says so and the
# records tile it, raw otherwise
fun read_body(x: *Ctx, s: *Section, rd: *Reader) res[Body, Fail] {
    val size: u64 = x.c.tlv.size::u64;
    if (model.section_type(s) == tables.S_THREAD_LOCAL_VARIABLES.value::u32) {
        if (rd.len::u64 % size != 0) { ret body_raw(rd, res[Why, Fail].ok{Why.unsupported{}}); }
        ret tlvs(x, rd, rd.len::u64 / size);
    }
    if (model.section_named(s, tables.SEG_TEXT.text, tables.SECT_UNWIND_INFO.text))  { ret unwind_info(x, rd); }
    if (model.section_named(s, tables.SEG_LD.text, tables.SECT_COMPACT_UNWIND.text)) { ret compact_unwind(x, rd); }
    ret body_raw(rd, res[Why, Fail].ok{Why.opaque{}});
}

# the bytes of `rd` held raw for `why`, or the failure that is no reason
fun body_raw(rd: *Reader, why: res[Why, Fail]) res[Body, Fail] {
    val r: res[Raw, Fail] = raw_of(rd, why);
    if (sel r.err) { ret res[Body, Fail].err{r.err}; }
    ret res[Body, Fail].ok{Body.raw{r.ok}};
}

fun data_raw(rd: *Reader, why: res[Why, Fail]) res[Data, Fail] {
    val r: res[Raw, Fail] = raw_of(rd, why);
    if (sel r.err) { ret res[Data, Fail].err{r.err}; }
    ret res[Data, Fail].ok{Data.raw{r.ok}};
}

fun raw_of(rd: *Reader, why: res[Why, Fail]) res[Raw, Fail] {
    if (sel why.err) { ret res[Raw, Fail].err{why.err}; }
    val h: res[Held, Fail] = held(rd, 0, rd.len::u64);
    if (sel h.err) { ret res[Raw, Fail].err{h.err}; }
    ret res[Raw, Fail].ok{Raw{bytes: h.ok, why: why.ok}};
}

# why a codec held bytes back: it declined them, or it failed and the file is refused
fun reason(f: Fail) res[Why, Fail] {
    if (sel f.cause.unsupported) { ret res[Why, Fail].ok{Why.unsupported{}}; }
    ret res[Why, Fail].err{f};
}

# whether the sink holds the first `n` bytes of `rd`, given back by the sink. an
# encoder that declined its entries reproduces nothing, and any other failure
# of it is the file's
fun verdict(rd: *Reader, s: *Sink, e: err[Fail], n: usize) res[bool, Fail] {
    var same: bool  = !(sel e.err) && sink.len(s) == n && n <= rd.len;
    var i:    usize = 0;
    for (same && i < n) {
        same = sink.data(s)[i] == rd.data[i];
        i    = i + 1;
    }
    val dropped: err[Fail] = sink.release(s);
    if (sel e.err) {
        if (fail.is_refused(e.err)) { ret res[bool, Fail].err{e.err}; }
    }
    if (sel dropped.err) { ret res[bool, Fail].err{dropped.err}; }
    ret res[bool, Fail].ok{same};
}

fun unwind_info(x: *Ctx, rd: *Reader) res[Body, Fail] {
    val d: res[UnwindInfo, Fail] = unwind.decode(x.m.a, rd);
    if (sel d.err) { ret body_raw(rd, reason(d.err)); }
    var info: UnwindInfo      = d.ok;
    var s:    Sink            = sink.make(x.m.a, x.order);
    val e:    err[Fail]       = unwind.encode(?s, x.m.a, ?info);
    val same: res[bool, Fail] = verdict(rd, ?s, e, rd.len);
    if (sel same.err) {
        val r: err[Fail] = model.release_unwind_info(?info);
        ret res[Body, Fail].err{same.err};
    }
    if (!same.ok) {
        val r: err[Fail] = model.release_unwind_info(?info);
        if (sel r.err) { ret res[Body, Fail].err{r.err}; }
        ret body_raw(rd, res[Why, Fail].ok{Why.irreproducible{}});
    }
    ret res[Body, Fail].ok{Body.info{info}};
}

fun compact_unwind(x: *Ctx, rd: *Reader) res[Body, Fail] {
    val ptr: usize                    = x.c.addr;
    val d:   res[Table[Unwind], Fail] = unwind.decode_compact(x.m.a, rd, ptr);
    if (sel d.err) { ret body_raw(rd, reason(d.err)); }
    var t:    Table[Unwind]   = d.ok;
    var s:    Sink            = sink.make(x.m.a, x.order);
    val e:    err[Fail]       = unwind.encode_compact(?s, ?t, ptr);
    val same: res[bool, Fail] = verdict(rd, ?s, e, rd.len);
    if (sel same.err) {
        val r: err[Fail] = table.release[Unwind](?t);
        ret res[Body, Fail].err{same.err};
    }
    if (!same.ok) {
        val r: err[Fail] = table.release[Unwind](?t);
        if (sel r.err) { ret res[Body, Fail].err{r.err}; }
        ret body_raw(rd, res[Why, Fail].ok{Why.irreproducible{}});
    }
    ret res[Body, Fail].ok{Body.unwind{t}};
}

fun tlvs(x: *Ctx, rd: *Reader, n: u64) res[Body, Fail] {
    val c:   *Class           = x.c;
    var tab: Table[Tlv]       = table.make[Tlv](x.m.a);
    val cnt: res[usize, Fail] = checked.to_usize(reader.here(rd), n);
    if (sel cnt.err) { ret res[Body, Fail].err{cnt.err}; }
    val g: res[Id[Tlv], Fail] = table.grow[Tlv](?tab, cnt.ok);
    if (sel g.err) {
        val r: err[Fail] = table.release[Tlv](?tab);
        ret res[Body, Fail].err{g.err};
    }
    val items: *Tlv = table.items[Tlv](?tab);
    var k:     u64  = 0;
    for (k < n) {
        val rec: res[*u8, Fail] = record(rd, "thread local variable", k, c.tlv.size);
        if (sel rec.err) {
            val r: err[Fail] = table.release[Tlv](?tab);
            ret res[Body, Fail].err{rec.err};
        }
        val e: *Tlv = ?items[k::usize];
        e.thunk  = slot.field(rec.ok, c.tlv.thunk, x.order);
        e.key    = slot.field(rec.ok, c.tlv.key, x.order);
        e.offset = slot.field(rec.ok, c.tlv.offset, x.order);
        k        = k + 1;
    }
    ret res[Body, Fail].ok{Body.tlv{tab}};
}

fun emit_blob(x: *Ctx, r: Range, rd: *Reader) err[Fail] {
    val c:     *Command            = model.command_at(x.m, table.nth[Command](r.cmd::usize));
    val empty: Raw                 = Raw{bytes: Held.borrowed{Bytes{data: nil, len: 0}}, why: Why.opaque{}};
    val id:    res[Id[Blob], Fail] = table.push[Blob](?x.m.blobs, Blob{command: table.nth[Command](r.cmd::usize), part: r.part, data: Data.raw{empty}, gaps: table.make[Gap](x.m.a)});
    if (sel id.err) { ret err[Fail].err{id.err}; }
    val d: res[Data, Fail] = decode(x, r.part, rd, c);
    if (sel d.err) { ret err[Fail].err{d.err}; }
    val b: *Blob = model.blob_at(x.m, id.ok);
    b.data = d.ok;
    if (sel b.data.signature) {
        val tail: err[Fail] = signature_tail(b, rd, b.data.signature.length::u64);
        if (sel tail.err) { ret tail; }
    }
    ret push_extent(x, Extent.blob{id.ok});
}

# what the bytes of one field pair of a command hold
fun decode(x: *Ctx, p: Part, rd: *Reader, c: *Command) res[Data, Fail] {
    val n: u64 = rd.len::u64;
    if (sel p.symbols) { ret symbols(x, rd, c); }
    if (sel p.toc)     { ret tocs(x, rd, n / TOC_SIZE); }
    if (sel p.modules) { ret modules(x, rd, n / x.c.module.size::u64); }
    if (sel p.refs) {
        val w: res[Table[u32], Fail] = words(x, rd, n / WORD_SIZE, "reference");
        if (sel w.err) { ret res[Data, Fail].err{w.err}; }
        ret res[Data, Fail].ok{Data.refs{w.ok}};
    }
    if (sel p.indirect) {
        val w: res[Table[u32], Fail] = words(x, rd, n / WORD_SIZE, "indirect symbol");
        if (sel w.err) { ret res[Data, Fail].err{w.err}; }
        ret res[Data, Fail].ok{Data.indirect{w.ok}};
    }
    if (sel p.hints) {
        val w: res[Table[u32], Fail] = words(x, rd, n / WORD_SIZE, "hint");
        if (sel w.err) { ret res[Data, Fail].err{w.err}; }
        ret res[Data, Fail].ok{Data.hints{w.ok}};
    }
    if (sel p.extrel || sel p.locrel) {
        val t: res[Table[Reloc], Fail] = relocs(x, rd, n / RELOC_SIZE);
        if (sel t.err) { ret res[Data, Fail].err{t.err}; }
        ret res[Data, Fail].ok{Data.relocs{t.ok}};
    }
    if (sel p.rebase)    { ret rebases(x, rd); }
    if (sel p.bind)      { ret binds(x, rd, Flavor.regular{}); }
    if (sel p.weak_bind) { ret binds(x, rd, Flavor.weak{}); }
    if (sel p.lazy_bind) { ret binds(x, rd, Flavor.lazy{}); }
    if (sel p.exports)   { ret export_trie(x, rd); }
    if (sel p.data)      { ret linkedit(x, rd, c); }
    val h: res[Held, Fail] = held(rd, 0, n);
    if (sel h.err)     { ret res[Data, Fail].err{h.err}; }
    if (sel p.strings) { ret res[Data, Fail].ok{Data.strings{h.ok}}; }
    ret data_raw(rd, res[Why, Fail].ok{Why.opaque{}});
}

# what the bytes of a linkedit_data_command hold
fun linkedit(x: *Ctx, rd: *Reader, c: *Command) res[Data, Fail] {
    val cmd: u64 = c.cmd::u64;
    if (cmd == tables.LC_FUNCTION_STARTS.value)     { ret function_starts(x, rd); }
    if (cmd == tables.LC_DATA_IN_CODE.value)        { ret data_in_code(x, rd); }
    if (cmd == tables.LC_DYLD_EXPORTS_TRIE.value)   { ret export_trie(x, rd); }
    if (cmd == tables.LC_DYLD_CHAINED_FIXUPS.value) { ret chained(x, rd); }
    if (cmd == tables.LC_CODE_SIGNATURE.value)      { ret code_signature(x, rd); }
    ret data_raw(rd, res[Why, Fail].ok{Why.opaque{}});
}

# the entries when encoding them gives the bytes back, the bytes raw otherwise.
# `t` is released on every path but the first
fun table_or_raw[T](rd: *Reader, t: *Table[T], same: res[bool, Fail], kept: Data) res[Data, Fail] {
    if (sel same.err) { ret lost[T](t, same.err); }
    if (!same.ok)     { ret dropped[T](t, irreproducible(rd)); }
    ret res[Data, Fail].ok{kept};
}

fun irreproducible(rd: *Reader) res[Data, Fail] {
    ret data_raw(rd, res[Why, Fail].ok{Why.irreproducible{}});
}

# `then`, once the table is given back
fun dropped[T](t: *Table[T], then: res[Data, Fail]) res[Data, Fail] {
    val r: err[Fail] = table.release[T](t);
    if (sel r.err) { ret res[Data, Fail].err{r.err}; }
    ret then;
}

fun rebases(x: *Ctx, rd: *Reader) res[Data, Fail] {
    val ptr: usize                    = x.c.addr;
    val d:   res[Table[Rebase], Fail] = opcode.decode_rebases(x.m.a, rd, ptr::u64);
    if (sel d.err) { ret data_raw(rd, reason(d.err)); }
    var t: Table[Rebase] = d.ok;
    var s: Sink          = sink.make(x.m.a, x.order);
    val e: err[Fail]     = opcode.encode_rebases(?s, x.m.a, ?t, ptr::u64, ptr);
    ret table_or_raw[Rebase](rd, ?t, verdict(rd, ?s, e, rd.len), Data.rebases{t});
}

fun binds(x: *Ctx, rd: *Reader, flavor: Flavor) res[Data, Fail] {
    val ptr:    usize                  = x.c.addr;
    val stream: Bytes                  = Bytes{data: rd.data, len: rd.len};
    val d:      res[Table[Bind], Fail] = opcode.decode_binds(x.m.a, rd, flavor, ptr::u64);
    if (sel d.err) { ret data_raw(rd, reason(d.err)); }
    var t:    Table[Bind]     = d.ok;
    var s:    Sink            = sink.make(x.m.a, x.order);
    val e:    err[Fail]       = opcode.encode_binds(?s, x.m.a, ?t, stream, flavor, ptr::u64, ptr);
    val same: res[bool, Fail] = verdict(rd, ?s, e, rd.len);
    if (sel same.err) { ret lost[Bind](?t, same.err); }
    if (!same.ok)     { ret dropped[Bind](?t, irreproducible(rd)); }
    val names: res[Held, Fail] = own_names(x, ?t, stream);
    if (sel names.err) { ret lost[Bind](?t, names.err); }
    ret res[Data, Fail].ok{Data.binds{Binds{entries: t, names: names.ok}}};
}

# the names the entries index, owned by the model, and the entries pointed at them
fun own_names(x: *Ctx, entries: *Table[Bind], stream: Bytes) res[Held, Fail] {
    var pool: Sink      = sink.make(x.m.a, x.order);
    val w:    err[Fail] = opcode.pool_names(?pool, entries, stream);
    if (sel w.err) {
        val dropped: err[Fail] = sink.release(?pool);
        ret res[Held, Fail].err{w.err};
    }
    val h:       res[Held, Fail] = model.own(x.m, sink.data(?pool), sink.len(?pool));
    val dropped: err[Fail]       = sink.release(?pool);
    if (sel h.err)       { ret h; }
    if (sel dropped.err) { ret res[Held, Fail].err{dropped.err}; }
    ret h;
}

# the exports when their trie encodes back to the bytes. the names are decoded
# into a store of their own, and the model owns them only on a match
fun export_trie(x: *Ctx, rd: *Reader) res[Data, Fail] {
    val ptr: usize                    = x.c.addr;
    var st:  Store                    = store.make(x.m.a);
    val d:   res[Table[Export], Fail] = trie.decode(x.m.a, ?st, rd);
    if (sel d.err) { ret scratch_gone(?st, data_raw(rd, reason(d.err))); }
    var t:     Table[Export]         = d.ok;
    val style: res[opt[Style], Fail] = trie.matching_style(x.m.a, ?st, ?t, Bytes{data: rd.data, len: rd.len}, ptr);
    if (sel style.err)     { ret scratch_gone(?st, lost[Export](?t, style.err)); }
    if (sel style.ok.none) { ret scratch_gone(?st, dropped[Export](?t, irreproducible(rd))); }
    val adopted: err[Fail] = adopt_names(x, ?st, ?t);
    if (sel adopted.err) { ret scratch_gone(?st, lost[Export](?t, adopted.err)); }
    ret scratch_gone(?st, res[Data, Fail].ok{Data.exports{Trie{style: style.ok.some, exports: t}}});
}

# `then`, once the scratch store is given back
fun scratch_gone(st: *Store, then: res[Data, Fail]) res[Data, Fail] {
    val r: err[Fail] = store.release(st);
    if (sel r.err) { ret res[Data, Fail].err{r.err}; }
    ret then;
}

# the names of the exports, moved from the store they were decoded into to the model
fun adopt_names(x: *Ctx, from: *Store, exports: *Table[Export]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Export](exports)) {
        val e: *Export = table.at[Export](exports, table.nth[Export](i));
        i = i + 1;
        val name: Bytes           = store.bytes(from, ?e.name);
        val n:    res[Held, Fail] = model.own(x.m, name.data, name.len);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        val imp: Bytes           = store.bytes(from, ?e.import);
        val m:   res[Held, Fail] = model.own(x.m, imp.data, imp.len);
        if (sel m.err) { ret err[Fail].err{m.err}; }
        e.name   = n.ok;
        e.import = m.ok;
    }
    ret err[Fail].ok{};
}

fun function_starts(x: *Ctx, rd: *Reader) res[Data, Fail] {
    val ptr: usize                 = x.c.addr;
    val d:   res[Table[u64], Fail] = starts.decode_starts(x.m.a, rd);
    if (sel d.err) { ret data_raw(rd, reason(d.err)); }
    var t: Table[u64] = d.ok;
    var s: Sink       = sink.make(x.m.a, x.order);
    val e: err[Fail]  = starts.encode_starts(?s, ?t, ptr);
    ret table_or_raw[u64](rd, ?t, verdict(rd, ?s, e, rd.len), Data.starts{t});
}

fun data_in_code(x: *Ctx, rd: *Reader) res[Data, Fail] {
    val d: res[Table[DataInCode], Fail] = starts.decode_data_in_code(x.m.a, rd);
    if (sel d.err) { ret data_raw(rd, reason(d.err)); }
    var t: Table[DataInCode] = d.ok;
    var s: Sink              = sink.make(x.m.a, x.order);
    val e: err[Fail]         = starts.encode_data_in_code(?s, ?t);
    ret table_or_raw[DataInCode](rd, ?t, verdict(rd, ?s, e, rd.len), Data.data_in_code{t});
}

fun chained(x: *Ctx, rd: *Reader) res[Data, Fail] {
    val d: res[Chained, Fail] = fixups.decode(x.m.a, rd);
    if (sel d.err) { ret data_raw(rd, reason(d.err)); }
    var c:    Chained         = d.ok;
    var s:    Sink            = sink.make(x.m.a, x.order);
    val e:    err[Fail]       = fixups.encode(?s, x.m.a, ?c, model.bytes(x.m, ?c.symbols));
    val same: res[bool, Fail] = verdict(rd, ?s, e, rd.len);
    if (sel same.err) {
        val r: err[Fail] = model.release_chained(?c);
        ret res[Data, Fail].err{same.err};
    }
    if (!same.ok) {
        val r: err[Fail] = model.release_chained(?c);
        if (sel r.err) { ret res[Data, Fail].err{r.err}; }
        ret irreproducible(rd);
    }
    ret res[Data, Fail].ok{Data.fixups{c}};
}

# the signature when encoding it gives its bytes back. its length may be
# short of the blob, the rest being a gap of the blob
fun code_signature(x: *Ctx, rd: *Reader) res[Data, Fail] {
    val d: res[Signature, Fail] = signature.decode(x.m.a, rd);
    if (sel d.err) { ret data_raw(rd, reason(d.err)); }
    var sig:  Signature       = d.ok;
    var s:    Sink            = sink.make(x.m.a, x.order);
    val e:    err[Fail]       = signature.encode(?s, x.m.a, ?x.m.store, ?sig);
    val same: res[bool, Fail] = verdict(rd, ?s, e, sig.length::usize);
    if (sel same.err) {
        val r: err[Fail] = model.release_signature(?sig);
        ret res[Data, Fail].err{same.err};
    }
    if (!same.ok) {
        val r: err[Fail] = model.release_signature(?sig);
        if (sel r.err) { ret res[Data, Fail].err{r.err}; }
        ret irreproducible(rd);
    }
    ret res[Data, Fail].ok{Data.signature{sig}};
}

# the bytes of the blob past the end of its signature
fun signature_tail(b: *Blob, rd: *Reader, used: u64) err[Fail] {
    if (used >= rd.len::u64) { ret err[Fail].ok{}; }
    val h: res[Held, Fail] = held(rd, used, rd.len::u64 - used);
    if (sel h.err) { ret err[Fail].err{h.err}; }
    val p: res[Id[Gap], Fail] = table.push[Gap](?b.gaps, Gap{at: used, bytes: h.ok});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun lost[T](t: *Table[T], f: Fail) res[Data, Fail] {
    val r: err[Fail] = table.release[T](t);
    ret res[Data, Fail].err{f};
}

fun symbols(x: *Ctx, rd: *Reader, c: *Command) res[Data, Fail] {
    if (!sel c.body.symtab) { ret res[Data, Fail].err{fail.internal("symbols of a command that is no symbol table")}; }
    val cls: *Class         = x.c;
    val o:   Order          = x.order;
    val nul: res[u64, Fail] = after_last_nul(x, ?c.body.symtab);
    if (sel nul.err) { ret res[Data, Fail].err{nul.err}; }
    val n:   u64              = rd.len::u64 / cls.symbol.size::u64;
    var tab: Table[Nlist]     = table.make[Nlist](x.m.a);
    val cnt: res[usize, Fail] = checked.to_usize(reader.here(rd), n);
    if (sel cnt.err) { ret res[Data, Fail].err{cnt.err}; }
    val g: res[Id[Nlist], Fail] = table.grow[Nlist](?tab, cnt.ok);
    if (sel g.err) { ret lost[Nlist](?tab, g.err); }
    val items: *Nlist = table.items[Nlist](?tab);
    var k:     u64    = 0;
    for (k < n) {
        val rec: res[*u8, Fail] = record(rd, "symbol", k, cls.symbol.size);
        if (sel rec.err) { ret lost[Nlist](?tab, rec.err); }
        val p:    *u8    = rec.ok;
        val e:    *Nlist = ?items[k::usize];
        val base: u64    = rd.base + k * cls.symbol.size::u64;
        e.strx  = slot.field(p, cls.symbol.strx, o)::u32;
        e.type  = slot.field(p, cls.symbol.type, o)::u8;
        e.sect  = slot.field(p, cls.symbol.sect, o)::u8;
        e.desc  = slot.field(p, cls.symbol.desc, o)::u16;
        e.value = slot.field(p, cls.symbol.value, o);
        if (e.strx != 0 && e.strx::u64 >= nul.ok) {
            ret lost[Nlist](?tab, at(fail.in_indexed(fail.malformed("string index outside the string table"), "symbol", k), base + cls.symbol.strx.offset::u64));
        }
        if (model.stab(e) == 0 && model.symbol_type(e) == tables.N_SECT.value::u8 && (e.sect == tables.NO_SECT.value::u8 || e.sect::u64 > x.nsects)) {
            ret lost[Nlist](?tab, at(fail.in_indexed(fail.malformed("symbol names a section the file does not have"), "symbol", k), base + cls.symbol.sect.offset::u64));
        }
        k = k + 1;
    }
    ret res[Data, Fail].ok{Data.symbols{tab}};
}

# the position after the last NUL byte of the string table `st` names, zero
# when it has none
fun after_last_nul(x: *Ctx, st: *Symtab) res[u64, Fail] {
    val sub: res[Reader, Fail] = reader.sub(?x.file, st.stroff::u64, st.strsize::u64);
    if (sel sub.err) { ret res[u64, Fail].err{fail.in_record(sub.err, "string table")}; }
    var sr: Reader         = sub.ok;
    val b:  res[*u8, Fail] = reader.bytes(?sr, st.strsize::u64);
    if (sel b.err) { ret res[u64, Fail].err{b.err}; }
    var k: u64 = st.strsize::u64;
    for (k > 0) {
        if (b.ok[(k - 1)::usize] == 0) { brk; }
        k = k - 1;
    }
    ret res[u64, Fail].ok{k};
}

fun tocs(x: *Ctx, rd: *Reader, n: u64) res[Data, Fail] {
    var tab: Table[Toc]       = table.make[Toc](x.m.a);
    val cnt: res[usize, Fail] = checked.to_usize(reader.here(rd), n);
    if (sel cnt.err) { ret res[Data, Fail].err{cnt.err}; }
    val g: res[Id[Toc], Fail] = table.grow[Toc](?tab, cnt.ok);
    if (sel g.err) { ret lost[Toc](?tab, g.err); }
    val items: *Toc = table.items[Toc](?tab);
    var k:     u64  = 0;
    for (k < n) {
        val a: res[u32, Fail] = reader.u32(rd);
        if (sel a.err) { ret lost[Toc](?tab, fail.in_indexed(a.err, "table of contents entry", k)); }
        val b: res[u32, Fail] = reader.u32(rd);
        if (sel b.err) { ret lost[Toc](?tab, fail.in_indexed(b.err, "table of contents entry", k)); }
        items[k::usize] = Toc{symbol_index: a.ok, module_index: b.ok};
        k               = k + 1;
    }
    ret res[Data, Fail].ok{Data.toc{tab}};
}

fun modules(x: *Ctx, rd: *Reader, n: u64) res[Data, Fail] {
    val c:   *Class           = x.c;
    val o:   Order            = x.order;
    var tab: Table[Module]    = table.make[Module](x.m.a);
    val cnt: res[usize, Fail] = checked.to_usize(reader.here(rd), n);
    if (sel cnt.err) { ret res[Data, Fail].err{cnt.err}; }
    val g: res[Id[Module], Fail] = table.grow[Module](?tab, cnt.ok);
    if (sel g.err) { ret lost[Module](?tab, g.err); }
    val items: *Module = table.items[Module](?tab);
    var k:     u64     = 0;
    for (k < n) {
        val rec: res[*u8, Fail] = record(rd, "module", k, c.module.size);
        if (sel rec.err) { ret lost[Module](?tab, rec.err); }
        val p: *u8     = rec.ok;
        val e: *Module = ?items[k::usize];
        e.module_name = slot.field(p, c.module.module_name, o)::u32;
        e.iextdefsym  = slot.field(p, c.module.iextdefsym, o)::u32;
        e.nextdefsym  = slot.field(p, c.module.nextdefsym, o)::u32;
        e.irefsym     = slot.field(p, c.module.irefsym, o)::u32;
        e.nrefsym     = slot.field(p, c.module.nrefsym, o)::u32;
        e.ilocalsym   = slot.field(p, c.module.ilocalsym, o)::u32;
        e.nlocalsym   = slot.field(p, c.module.nlocalsym, o)::u32;
        e.iextrel     = slot.field(p, c.module.iextrel, o)::u32;
        e.nextrel     = slot.field(p, c.module.nextrel, o)::u32;
        e.iinit_iterm = slot.field(p, c.module.iinit_iterm, o)::u32;
        e.ninit_nterm = slot.field(p, c.module.ninit_nterm, o)::u32;
        e.objc_addr   = slot.field(p, c.module.objc_addr, o);
        e.objc_size   = slot.field(p, c.module.objc_size, o)::u32;
        k             = k + 1;
    }
    ret res[Data, Fail].ok{Data.modules{tab}};
}

fun words(x: *Ctx, rd: *Reader, n: u64, name: str) res[Table[u32], Fail] {
    var tab: Table[u32]       = table.make[u32](x.m.a);
    val cnt: res[usize, Fail] = checked.to_usize(reader.here(rd), n);
    if (sel cnt.err) { ret res[Table[u32], Fail].err{cnt.err}; }
    val g: res[Id[u32], Fail] = table.grow[u32](?tab, cnt.ok);
    if (sel g.err) { ret res[Table[u32], Fail].err{g.err}; }
    val items: *u32 = table.items[u32](?tab);
    var k:     u64  = 0;
    for (k < n) {
        val w: res[u32, Fail] = reader.u32(rd);
        if (sel w.err) {
            val r: err[Fail] = table.release[u32](?tab);
            ret res[Table[u32], Fail].err{fail.in_indexed(w.err, name, k)};
        }
        items[k::usize] = w.ok;
        k               = k + 1;
    }
    ret res[Table[u32], Fail].ok{tab};
}

# `n` relocation entries, a scattered one told by the top bit of its first word
fun relocs(x: *Ctx, rd: *Reader, n: u64) res[Table[Reloc], Fail] {
    var packed: *Packed = ?PACKED_LITTLE;
    if (x.order == BIG) { packed = ?PACKED_BIG; }
    var tab: Table[Reloc]     = table.make[Reloc](x.m.a);
    val cnt: res[usize, Fail] = checked.to_usize(reader.here(rd), n);
    if (sel cnt.err) { ret res[Table[Reloc], Fail].err{cnt.err}; }
    val g: res[Id[Reloc], Fail] = table.grow[Reloc](?tab, cnt.ok);
    if (sel g.err) { ret res[Table[Reloc], Fail].err{g.err}; }
    val items: *Reloc = table.items[Reloc](?tab);
    var k:     u64    = 0;
    for (k < n) {
        val w0: res[u32, Fail] = reader.u32(rd);
        if (sel w0.err) {
            val r: err[Fail] = table.release[Reloc](?tab);
            ret res[Table[Reloc], Fail].err{fail.in_indexed(w0.err, "relocation", k)};
        }
        val w1: res[u32, Fail] = reader.u32(rd);
        if (sel w1.err) {
            val r: err[Fail] = table.release[Reloc](?tab);
            ret res[Table[Reloc], Fail].err{fail.in_indexed(w1.err, "relocation", k)};
        }
        val a: u64 = w0.ok::u64;
        val b: u64 = w1.ok::u64;
        if ((w0.ok & tables.R_SCATTERED.value::u32) != 0) {
            items[k::usize] = Reloc.scattered{Scattered{
                address: model.bits(a, SCATTER_ADDRESS)::u32,
                type:    model.bits(a, SCATTER_TYPE)::u8,
                length:  model.bits(a, SCATTER_LENGTH)::u8,
                pcrel:   model.bits(a, SCATTER_PCREL)::u8,
                value:   w1.ok,
            }};
        }
        or {
            items[k::usize] = Reloc.plain{Plain{
                address:   w0.ok,
                symbolnum: model.bits(b, packed.symbolnum)::u32,
                pcrel:     model.bits(b, packed.pcrel)::u8,
                length:    model.bits(b, packed.length)::u8,
                external:  model.bits(b, packed.external)::u8,
                type:      model.bits(b, packed.type)::u8,
            }};
        }
        k = k + 1;
    }
    ret res[Table[Reloc], Fail].ok{tab};
}

# the `size` bytes at `pos` of `rd`
fun view(rd: *Reader, pos: u64, size: u64) res[*u8, Fail] {
    val s: res[Reader, Fail] = reader.sub(rd, pos, size);
    if (sel s.err) { ret res[*u8, Fail].err{s.err}; }
    var sr: Reader = s.ok;
    ret reader.bytes(?sr, size);
}

fun held(rd: *Reader, pos: u64, size: u64) res[Held, Fail] {
    val v: res[*u8, Fail] = view(rd, pos, size);
    if (sel v.err) { ret res[Held, Fail].err{v.err}; }
    ret res[Held, Fail].ok{Held.borrowed{Bytes{data: v.ok, len: size::usize}}};
}

# the `index`th record of `size` bytes of the table `t`
fun record(t: *Reader, name: str, index: u64, size: usize) res[*u8, Fail] {
    val e: res[Reader, Fail] = shell.element(t, name, index, size::u64);
    if (sel e.err) { ret res[*u8, Fail].err{e.err}; }
    var er: Reader         = e.ok;
    val b:  res[*u8, Fail] = reader.bytes(?er, size::u64);
    if (sel b.err) { ret res[*u8, Fail].err{fail.in_indexed(b.err, name, index)}; }
    ret b;
}

fun loc(x: *Ctx, offset: u64) Location {
    ret Location{file: x.in.file, offset: offset, placed: true};
}

fun at(f: Fail, offset: u64) Fail {
    ret fail.at_offset(f, offset);
}

# a range of a fat file
rec Cut {
    start: u64;
    end:   u64;
    slice: u32;
}

fun fill_fat(in: *Input, m: *Fat) err[Fail] {
    var file: Reader         = shell.open(in, BIG);
    val hb:   res[*u8, Fail] = view(?file, 0, fat.HEADER.size::u64);
    if (sel hb.err) { ret err[Fail].err{fail.in_record(hb.err, "fat header")}; }
    m.magic     = slot.field(hb.ok, fat.HEADER.magic, BIG)::u32;
    m.nfat_arch = slot.field(hb.ok, fat.HEADER.nfat_arch, BIG)::u32;
    val a: *fat.ArchShape    = m.arch;
    val t: res[Reader, Fail] = shell.table(?file, "fat architecture", fat.HEADER.size::u64, m.nfat_arch::u64, a.size::u64);
    if (sel t.err) { ret err[Fail].err{t.err}; }
    var tr: Reader               = t.ok;
    val g:  res[Id[Slice], Fail] = table.grow[Slice](?m.slices, m.nfat_arch::usize);
    if (sel g.err) { ret err[Fail].err{g.err}; }
    var cuts: Table[Cut] = table.make[Cut](m.a);
    val r:    err[Fail]  = read_slices(in, m, ?file, ?tr, ?cuts);
    if (sel r.err) {
        val dropped: err[Fail] = table.release[Cut](?cuts);
        ret r;
    }
    val e:   err[Fail] = emit_fat(in, m, ?file, ?cuts, fat.HEADER.size::u64 + tr.len::u64);
    val rel: err[Fail] = table.release[Cut](?cuts);
    if (sel e.err) { ret e; }
    ret rel;
}

fun read_slices(in: *Input, m: *Fat, file: *Reader, tr: *Reader, cuts: *Table[Cut]) err[Fail] {
    val a:     *fat.ArchShape = m.arch;
    val items: *Slice         = table.items[Slice](?m.slices);
    var i:     u64            = 0;
    for (i < m.nfat_arch::u64) {
        val rec: res[*u8, Fail] = record(tr, "fat architecture", i, a.size);
        if (sel rec.err) { ret err[Fail].err{rec.err}; }
        val p:    *u8    = rec.ok;
        val s:    *Slice = ?items[i::usize];
        val base: u64    = tr.base + i * a.size::u64;
        s.cputype    = slot.field(p, a.cputype, BIG)::u32;
        s.cpusubtype = slot.field(p, a.cpusubtype, BIG)::u32;
        s.offset     = slot.field(p, a.offset, BIG);
        s.length     = slot.field(p, a.length, BIG);
        s.align      = slot.field(p, a.align, BIG)::u32;
        s.reserved   = slot.field(p, a.reserved, BIG)::u32;
        val at_off: u64            = base + a.offset.offset::u64;
        val end:    res[u64, Fail] = checked.add(Location{file: in.file, offset: at_off, placed: true}, s.offset, s.length);
        if (sel end.err) { ret err[Fail].err{fail.in_indexed(end.err, "fat architecture", i)}; }
        if (end.ok > in.len::u64) {
            ret err[Fail].err{at(fail.in_indexed(fail.truncated("slice runs past the end of the file"), "fat architecture", i), at_off)};
        }
        val h: res[Held, Fail] = held(file, s.offset, s.length);
        if (sel h.err) { ret err[Fail].err{fail.in_indexed(h.err, "fat architecture", i)}; }
        s.bytes = h.ok;
        val pushed: res[Id[Cut], Fail] = table.push[Cut](cuts, Cut{start: s.offset, end: end.ok, slice: i::u32});
        if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun cut_order(a: *Cut, b: *Cut) i64 {
    if (a.start != b.start) {
        if (a.start < b.start) { ret -1; }
        ret 1;
    }
    if (a.end != b.end) {
        if (a.end < b.end) { ret -1; }
        ret 1;
    }
    ret a.slice::i64 - b.slice::i64;
}

# tile the file with the header, the architecture table, the slices in file
# order and the bytes between them
fun emit_fat(in: *Input, m: *Fat, file: *Reader, cuts: *Table[Cut], head: u64) err[Fail] {
    sort.sort_by[Cut](table.items[Cut](cuts), table.count[Cut](cuts), cut_order);
    val hd: err[Fail] = push_fat(m, fat.Extent.header{});
    if (sel hd.err) { ret hd; }
    val ar: err[Fail] = push_fat(m, fat.Extent.arches{});
    if (sel ar.err) { ret ar; }
    var cursor: u64   = head;
    var k:      usize = 0;
    for (k < table.count[Cut](cuts)) {
        val c: Cut = table.items[Cut](cuts)[k];
        if (c.start < cursor) {
            ret err[Fail].err{at(fail.in_indexed(fail.malformed("slice overlaps the bytes before it"), "fat architecture", c.slice::u64), c.start)};
        }
        if (c.start > cursor) {
            val h: res[Held, Fail] = held(file, cursor, c.start - cursor);
            if (sel h.err) { ret err[Fail].err{h.err}; }
            val p: err[Fail] = push_fat(m, fat.Extent.raw{h.ok});
            if (sel p.err) { ret p; }
        }
        val sl: err[Fail] = push_fat(m, fat.Extent.slice{table.nth[Slice](c.slice::usize)});
        if (sel sl.err) { ret sl; }
        cursor = c.end;
        k      = k + 1;
    }
    if (cursor < in.len::u64) {
        val h: res[Held, Fail] = held(file, cursor, in.len::u64 - cursor);
        if (sel h.err) { ret err[Fail].err{h.err}; }
        ret push_fat(m, fat.Extent.raw{h.ok});
    }
    ret err[Fail].ok{};
}

fun push_fat(m: *Fat, e: fat.Extent) err[Fail] {
    val p: res[Id[fat.Extent], Fail] = table.push[fat.Extent](?m.extents, e);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# a file under construction: bytes, then load commands
rec Fix {
    buf:   [2048]u8;
    len:   usize;
    c:     *Class;
    order: Order;
    ncmds: u32;
    cmds:  usize;
}

val SYMTAB_SIZE: usize = 24;
val W4:          Slot  = Slot{offset: 0, width: 4};
val W8:          Slot  = Slot{offset: 0, width: 8};

fun fx_start(f: *Fix, c: *Class, order: Order) {
    f.c     = c;
    f.order = order;
    f.len   = c.header.size;
}

fun fx_set(f: *Fix, pos: usize, s: Slot, v: u64) {
    slot.set_field(?f.buf[pos], s, f.order, v);
}

fun fx_word(f: *Fix, v: u64) {
    fx_set(f, f.len, W4, v);
    f.len = f.len + 4;
}

fun fx_text(f: *Fix, pos: usize, s: Slot, text: str, n: usize) {
    var i: usize = 0;
    for (i < n && text[i] != 0) {
        f.buf[pos + s.offset::usize + i] = text[i];
        i                                = i + 1;
    }
}

fun fx_begin(f: *Fix, cmd: u64) usize {
    val at: usize = f.len;
    fx_set(f, at, W4, cmd);
    f.len = at + 8;
    ret at;
}

fun fx_end(f: *Fix, start: usize) {
    fx_set(f, start + 4, W4, (f.len - start)::u64);
    f.ncmds = f.ncmds + 1;
    f.cmds  = f.len;
}

fun fx_segment(f: *Fix, name: str, vmaddr: u64, vmsize: u64, fileoff: u64, filesize: u64, nsects: u64) usize {
    val c:   *Class = f.c;
    var cmd: u64    = tables.LC_SEGMENT.value;
    if (c.addr == 8) { cmd = tables.LC_SEGMENT_64.value; }
    val at: usize = fx_begin(f, cmd);
    fx_text(f, at, c.segment.segname, name, 16);
    fx_set(f, at, c.segment.vmaddr, vmaddr);
    fx_set(f, at, c.segment.vmsize, vmsize);
    fx_set(f, at, c.segment.fileoff, fileoff);
    fx_set(f, at, c.segment.filesize, filesize);
    fx_set(f, at, c.segment.nsects, nsects);
    f.len = at + c.segment.size;
    ret at;
}

fun fx_section(f: *Fix, name: str, seg: str, addr: u64, size: u64, offset: u64, reloff: u64, nreloc: u64) usize {
    val c:  *Class = f.c;
    val at: usize  = f.len;
    fx_text(f, at, c.section.sectname, name, 16);
    fx_text(f, at, c.section.segname, seg, 16);
    fx_set(f, at, c.section.addr, addr);
    fx_set(f, at, c.section.length, size);
    fx_set(f, at, c.section.offset, offset);
    fx_set(f, at, c.section.reloff, reloff);
    fx_set(f, at, c.section.nreloc, nreloc);
    f.len = at + c.section.size;
    ret at;
}

fun fx_symtab(f: *Fix, symoff: u64, nsyms: u64, stroff: u64, strsize: u64) {
    val at: usize = fx_begin(f, tables.LC_SYMTAB.value);
    fx_word(f, symoff);
    fx_word(f, nsyms);
    fx_word(f, stroff);
    fx_word(f, strsize);
    fx_end(f, at);
}

# one nlist entry at `pos`
fun fx_nlist(f: *Fix, pos: usize, strx: u64, type: u64, sect: u64) {
    fx_set(f, pos, f.c.symbol.strx, strx);
    fx_set(f, pos, f.c.symbol.type, type);
    fx_set(f, pos, f.c.symbol.sect, sect);
}

# write the header over the commands built so far and return the input
fun fx_finish(f: *Fix, filetype: u64, cputype: u64, size: usize) Input {
    val c:     *Class = f.c;
    var magic: u64    = tables.MH_MAGIC.value;
    if (c.addr == 8) { magic = tables.MH_MAGIC_64.value; }
    fx_set(f, 0, c.header.magic, magic);
    fx_set(f, 0, c.header.cputype, cputype);
    fx_set(f, 0, c.header.filetype, filetype);
    fx_set(f, 0, c.header.ncmds, f.ncmds::u64);
    fx_set(f, 0, c.header.sizeofcmds, (f.cmds - c.header.size)::u64);
    ret Input{file: "t.o", data: ?f.buf[0], len: size};
}

# a relocatable file of one section of 8 bytes with a relocation, and a
# symbol table of one symbol
fun fx_object(f: *Fix, c: *Class, order: Order, cputype: u64) Input {
    fx_start(f, c, order);
    val seg: usize = fx_segment(f, "", 0, 8, 0, 16, 1);
    val sec: usize = fx_section(f, "__text", "__TEXT", 0, 8, 0, 0, 1);
    fx_end(f, seg);
    val data: usize = f.len + SYMTAB_SIZE + 4;
    val syms: usize = data + 16;
    val strs: usize = syms + c.symbol.size + 4;
    fx_symtab(f, syms::u64, 1, strs::u64, 8);
    fx_set(f, seg, c.segment.fileoff, data::u64);
    fx_set(f, sec, c.section.offset, data::u64);
    fx_set(f, sec, c.section.reloff, (data + 8)::u64);
    var i: usize = 0;
    for (i < 8) {
        f.buf[data + i] = (i + 1)::u8;
        i               = i + 1;
    }
    val packed: *Packed = if_big(order);
    fx_set(f, data + 8, W4, 4);
    fx_set(f, data + 12, W4, (1::u64 << packed.pcrel.shift::u64) | (2::u64 << packed.length.shift::u64) | (1::u64 << packed.external.shift::u64) | (2::u64 << packed.type.shift::u64));
    fx_nlist(f, syms, 1, 0x0f, 1);
    f.buf[strs + 1] = '_';
    f.buf[strs + 2] = 'f';
    f.len           = strs + 8;
    ret fx_finish(f, tables.MH_OBJECT.value, cputype, f.len);
}

fun if_big(order: Order) *Packed {
    if (order == BIG) { ret ?PACKED_BIG; }
    ret ?PACKED_LITTLE;
}

# an executable of page zero, text, link-edit data, a main, dyld info, a
# symbol table and a library. dyld info names a rebase stream ld64 would write,
# a bind stream that lacks its DONE and an export trie that stops short of its padding
fun fx_executable(f: *Fix) Input {
    val c: *Class = ?model.CLASS64;
    fx_start(f, c, LITTLE);
    val base: u64   = 0x1_0000_0000;
    var at:   usize = fx_segment(f, "__PAGEZERO", 0, base, 0, 0, 0);
    fx_end(f, at);
    at = fx_segment(f, "__TEXT", base, 0x4000, 0, 0x200, 1);
    fx_section(f, "__text", "__TEXT", base + 0x1d0, 16, 0x1d0, 0, 0);
    fx_end(f, at);
    at = fx_segment(f, "__LINKEDIT", base + 0x4000, 0x4000, 0x200, 0x40, 0);
    fx_end(f, at);
    at = fx_begin(f, tables.LC_MAIN.value);
    fx_word(f, 0x1d0);
    fx_word(f, 0);
    fx_word(f, 0);
    fx_word(f, 0);
    fx_end(f, at);
    at = fx_begin(f, tables.LC_DYLD_INFO_ONLY.value);
    fx_word(f, 0x200);
    fx_word(f, 8);
    fx_word(f, 0x220);
    fx_word(f, 9);
    f.len = f.len + 16;
    fx_word(f, 0x230);
    fx_word(f, 10);
    fx_end(f, at);
    fx_symtab(f, 0x208, 1, 0x218, 8);
    at = fx_begin(f, tables.LC_LOAD_DYLIB.value);
    fx_word(f, 24);
    fx_word(f, 2);
    fx_word(f, 0x10000);
    fx_word(f, 0x10000);
    fx_text(f, f.len, Slot{}, "libSystem.dylib", 16);
    f.len = f.len + 16;
    fx_end(f, at);
    fx_nlist(f, 0x208, 1, 0x0f, 1);
    f.buf[0x219] = '_';
    val rebase: [4]u8  = [4]u8{0x11, 0x22, 0x10, 0x53};
    val bind:   [9]u8  = [9]u8{0x11, 0x40, '_', 'a', 0, 0x51, 0x72, 0x10, 0x90};
    val trie:   [10]u8 = [10]u8{0x00, 0x01, '_', 'a', 0, 0x06, 0x02, 0x00, 0x10, 0x00};
    var i:      usize  = 0;
    for (i < 10) {
        f.buf[0x230 + i] = trie[i];
        i                = i + 1;
    }
    i = 0;
    for (i < 4) {
        f.buf[0x200 + i] = rebase[i];
        i                = i + 1;
    }
    i = 0;
    for (i < 9) {
        f.buf[0x220 + i] = bind[i];
        i                = i + 1;
    }
    ret fx_finish(f, tables.MH_EXECUTE.value, 0x0100_000c, 0x240);
}

# the bytes the extents of `m` cover
fun covered(m: *MachO) u64 {
    var total: u64   = m.header.sizeofcmds::u64 + m.shape.class.header.size::u64;
    var i:     usize = 0;
    for (i < table.count[Extent](?m.extents)) {
        val e: *Extent = table.at[Extent](?m.extents, table.nth[Extent](i));
        if (sel e.section) {
            val s: res[*Section, Fail] = model.section(m, e.section);
            if (sel s.err) { ret 0; }
            total = total + s.ok.length;
        }
        if (sel e.relocs) {
            val s: res[*Section, Fail] = model.section(m, e.relocs);
            if (sel s.err) { ret 0; }
            total = total + s.ok.nreloc::u64 * RELOC_SIZE;
        }
        if (sel e.raw) { total = total + model.bytes(m, ?e.raw).len::u64; }
        if (sel e.blob) {
            val b: *Blob = model.blob_at(m, e.blob);
            if (sel b.data.symbols) { total = total + table.count[Nlist](?b.data.symbols)::u64 * m.shape.class.symbol.size::u64; }
            if (sel b.data.strings) { total = total + model.bytes(m, ?b.data.strings).len::u64; }
            val c: *Command = model.command_at(m, b.command);
            if (sel b.data.rebases) {
                if (sel c.body.dyld_info) { total = total + c.body.dyld_info.rebase_size::u64; }
            }
            if (sel b.data.raw) { total = total + model.bytes(m, ?b.data.raw.bytes).len::u64; }
        }
        i = i + 1;
    }
    ret total;
}

test read__object_of_each_width_and_order {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val classes: [2]*Class = [2]*Class{?model.CLASS32, ?model.CLASS64};
    val orders:  [2]Order  = [2]Order{LITTLE, BIG};
    var i:       usize     = 0;
    for (i < 4) {
        var f:  Fix;
        val in: Input            = fx_object(?f, classes[i / 2], orders[i % 2], 7);
        val r:  res[MachO, Fail] = read(T.allocator_of(?t), ?in);
        if (sel r.err) { ret 1; }
        var m: MachO = r.ok;
        if (m.shape.class != classes[i / 2] || m.shape.order != orders[i % 2]) { ret 1; }
        if (m.header.cputype != 7 || m.header.ncmds != 2)                      { ret 1; }
        if (table.count[Command](?m.commands) != 2)                            { ret 1; }
        val seg: *Command = model.command_at(?m, table.nth[Command](0));
        if (!sel seg.body.segment)                                 { ret 1; }
        if (table.count[Section](?seg.body.segment.sections) != 1) { ret 1; }
        val text: *Section = table.at[Section](?seg.body.segment.sections, table.nth[Section](0));
        if (text.length != 8)   { ret 1; }
        if (!sel text.body.raw) { ret 1; }
        val held: Held = text.body.raw.bytes;
        if (!sel held.borrowed)                    { ret 1; }
        if (held.borrowed.data[7] != 8)            { ret 1; }
        if (table.count[Reloc](?text.relocs) != 1) { ret 1; }
        val rel: *Reloc = table.at[Reloc](?text.relocs, table.nth[Reloc](0));
        if (!sel rel.plain)                                                                                  { ret 1; }
        if (rel.plain.address != 4 || rel.plain.symbolnum != 0)                                              { ret 1; }
        if (rel.plain.pcrel != 1 || rel.plain.length != 2 || rel.plain.external != 1 || rel.plain.type != 2) { ret 1; }
        if (table.count[model.Blob](?m.blobs) != 2)                                                          { ret 1; }
        val syms: *Blob = model.blob_at(?m, table.nth[Blob](0));
        if (!sel syms.data.symbols)                      { ret 1; }
        if (table.count[Nlist](?syms.data.symbols) != 1) { ret 1; }
        val sym: *Nlist = table.at[Nlist](?syms.data.symbols, table.nth[Nlist](0));
        if (sym.strx != 1 || sym.type != 0x0f || sym.sect != 1) { ret 1; }
        if (covered(?m) != in.len::u64)                         { ret 1; }
        val released: err[Fail] = model.release(?m);
        if (sel released.err) { ret 1; }
        i = i + 1;
    }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test read__executable_with_link_edit_data {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f:  Fix;
    val in: Input            = fx_executable(?f);
    val r:  res[MachO, Fail] = read(T.allocator_of(?t), ?in);
    if (sel r.err) { ret 1; }
    var m: MachO = r.ok;
    if (m.header.ncmds != 7 || table.count[Command](?m.commands) != 7) { ret 1; }
    val main: res[*model.Entry, Fail] = model.entry(?m, table.nth[Command](3));
    if (sel main.err)              { ret 1; }
    if (main.ok.entryoff != 0x1d0) { ret 1; }
    val lib: res[*model.Dylib, Fail] = model.dylib(?m, table.nth[Command](6));
    if (sel lib.err) { ret 1; }
    val name: res[Bytes, Fail] = model.string(?m, table.nth[Command](6), lib.ok.name);
    if (sel name.err)                     { ret 1; }
    if (name.ok.len != 15)                { ret 1; }
    if (name.ok.data[0] != 'l')           { ret 1; }
    if (table.count[Blob](?m.blobs) != 5) { ret 1; }
    val exports: *Blob = model.blob_at(?m, table.nth[Blob](4));
    if (!sel exports.part.exports)                { ret 1; }
    if (!sel exports.data.raw)                    { ret 1; }
    if (!sel exports.data.raw.why.irreproducible) { ret 1; }
    if (m.store.bytes.len != 0)                   { ret 1; }
    if (covered(?m) != in.len::u64)               { ret 1; }
    val released: err[Fail] = model.release(?m);
    if (sel released.err)      { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test read__blob_that_re_encodes_is_held_as_entries_alone {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f:  Fix;
    val in: Input            = fx_executable(?f);
    val r:  res[MachO, Fail] = read(T.allocator_of(?t), ?in);
    if (sel r.err) { ret 1; }
    var m:      MachO = r.ok;
    val rebase: *Blob = model.blob_at(?m, table.nth[Blob](0));
    if (!sel rebase.part.rebase)                        { ret 1; }
    if (!sel rebase.data.rebases)                       { ret 1; }
    if (table.count[Rebase](?rebase.data.rebases) != 3) { ret 1; }
    val last: *Rebase = table.at[Rebase](?rebase.data.rebases, table.nth[Rebase](2));
    if (last.segment != 2 || last.offset != 0x20 || last.type != 1) { ret 1; }
    val released: err[Fail] = model.release(?m);
    if (sel released.err)      { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test read__bind_stream_without_done_is_held_raw_as_irreproducible {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f:  Fix;
    val in: Input            = fx_executable(?f);
    val r:  res[MachO, Fail] = read(T.allocator_of(?t), ?in);
    if (sel r.err) { ret 1; }
    var m:    MachO = r.ok;
    val bind: *Blob = model.blob_at(?m, table.nth[Blob](3));
    if (!sel bind.part.bind)                   { ret 1; }
    if (!sel bind.data.raw)                    { ret 1; }
    if (!sel bind.data.raw.why.irreproducible) { ret 1; }
    val bytes: Bytes = model.bytes(?m, ?bind.data.raw.bytes);
    if (bytes.len != 9 || bytes.data[8] != 0x90) { ret 1; }
    val released: err[Fail] = model.release(?m);
    if (sel released.err)      { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test read__fat_file_of_two_slices {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var a:   Fix;
    var b:   Fix;
    val ia:  Input = fx_object(?a, ?model.CLASS64, LITTLE, 0x0100_000c);
    val ib:  Input = fx_object(?b, ?model.CLASS64, LITTLE, 0x0100_0007);
    var buf: [1024]u8;
    var i:   usize = 0;
    for (i < ia.len) {
        buf[0x100 + i] = a.buf[i];
        buf[0x200 + i] = b.buf[i];
        i              = i + 1;
    }
    slot.set_field(?buf[0], fat.HEADER.magic, BIG, tables.FAT_MAGIC.value);
    slot.set_field(?buf[0], fat.HEADER.nfat_arch, BIG, 2);
    val sizes: [2]u64 = [2]u64{0x0100_000c, 0x0100_0007};
    i = 0;
    for (i < 2) {
        val at: usize = fat.HEADER.size + i * fat.FAT32.size;
        slot.set_field(?buf[at], fat.FAT32.cputype, BIG, sizes[i]);
        slot.set_field(?buf[at], fat.FAT32.offset, BIG, 0x100 * (i + 1)::u64);
        slot.set_field(?buf[at], fat.FAT32.length, BIG, ia.len::u64);
        slot.set_field(?buf[at], fat.FAT32.align, BIG, 8);
        i = i + 1;
    }
    val in: Input          = Input{file: "t.fat", data: ?buf[0], len: 0x200 + ia.len};
    val r:  res[Fat, Fail] = read_fat(T.allocator_of(?t), ?in);
    if (sel r.err) { ret 1; }
    var m: Fat = r.ok;
    if (m.nfat_arch != 2 || table.count[Slice](?m.slices) != 2) { ret 1; }
    if (table.count[fat.Extent](?m.extents) != 5)               { ret 1; }
    i = 0;
    for (i < 2) {
        val s: *Slice = fat.slice_at(?m, table.nth[Slice](i));
        if (s.cputype::u64 != sizes[i] || s.length != ia.len::u64) { ret 1; }
        val thin: res[MachO, Fail] = read_slice(T.allocator_of(?t), ?m, table.nth[Slice](i), "t.fat");
        if (sel thin.err) { ret 1; }
        var tm: MachO = thin.ok;
        if (tm.header.cputype::u64 != sizes[i]) { ret 1; }
        val rt: err[Fail] = model.release(?tm);
        if (sel rt.err) { ret 1; }
        i = i + 1;
    }
    val released: err[Fail] = fat.release(?m);
    if (sel released.err)      { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test read__load_command_past_sizeofcmds_is_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f:      Fix;
    val c:      *Class = ?model.CLASS64;
    val in:     Input  = fx_object(?f, c, LITTLE, 7);
    val symtab: usize  = c.header.size + c.segment.size + c.section.size;
    fx_set(?f, symtab + 4, W4, 0x1000);
    val r: res[MachO, Fail] = read(T.allocator_of(?t), ?in);
    if (sel r.ok)                                                 { ret 1; }
    if (!sel r.err.cause.malformed)                               { ret 1; }
    if (!r.err.at.indexed || r.err.at.index != 1)                 { ret 1; }
    if (!r.err.at.placed || r.err.at.offset != (symtab + 4)::u64) { ret 1; }
    if (T.live_count(?t) != 0)                                    { ret 1; }
    T.dnit(?t);
    ret 0;
}

test read__section_outside_its_segment_is_refused {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var f:   Fix;
    val c:   *Class = ?model.CLASS64;
    val in:  Input  = fx_object(?f, c, LITTLE, 7);
    val sec: usize  = c.header.size + c.segment.size;
    fx_set(?f, sec, c.section.addr, 0x100);
    val r: res[MachO, Fail] = read(T.allocator_of(?t), ?in);
    if (sel r.ok)                                                                         { ret 1; }
    if (!sel r.err.cause.malformed)                                                       { ret 1; }
    if (!r.err.at.indexed || r.err.at.index != 0)                                         { ret 1; }
    if (!r.err.at.placed || r.err.at.offset != (sec + c.section.addr.offset::usize)::u64) { ret 1; }
    if (T.live_count(?t) != 0)                                                            { ret 1; }
    T.dnit(?t);
    ret 0;
}
