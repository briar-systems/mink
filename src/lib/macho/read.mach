# a range of the file after the load commands
# ---
# start: the first byte
# end:   the byte after the last
# kind:  what the range holds
# cmd:   the load command it belongs to
# sect:  the section of that command, for a section or its relocations
# part:  the field pair of that command, for a blob
rec Range {
    start: u64;
    end:   u64;
    kind:  u8;
    cmd:   u32;
    sect:  u32;
    part:  Part;
}

# read `in` as a thin Mach-O file. the model borrows the bytes of `in` and
# every table of it lives in `a`, so give it back with model.release
pub fun read(a: *A.Allocator, in: *Input) res[MachO, Fail] {
    val shape: res[Shape, Fail] = shape_of(in);
    if (sel shape.err) { ret res[MachO, Fail].err{fail.in_file(shape.err, in.file)}; }
    var m:    MachO     = model.make(a, shape.ok);
    var x:    Ctx       = Ctx{in: in, file: shell.open(in, shape.ok.order), m: ?m, c: shape.ok.class, order: shape.ok.order, offsets: table.make[u64](a)};
    val r:    err[Fail] = fill(?x);
    val offs: err[Fail] = table.release[u64](?x.offsets);
    if (sel r.err) {
        val dropped: err[Fail] = model.release(?m);
        ret res[MachO, Fail].err{fail.in_file(r.err, in.file)};
    }
    if (sel offs.err) {
        val dropped: err[Fail] = model.release(?m);
        ret res[MachO, Fail].err{fail.in_file(offs.err, in.file)};
    }
    ret res[MachO, Fail].ok{m};
}

# read `in` as a fat Mach-O file. the model borrows the bytes of `in`. each
# slice is held as its bytes, and read_slice reads one as a thin file
pub fun read_fat(a: *A.Allocator, in: *Input) res[Fat, Fail] {
    var r: Reader         = shell.open(in, BIG);
    val v: res[u32, Fail] = reader.u32(?r);
    if (sel v.err) { ret res[Fat, Fail].err{fail.in_file(fail.in_record(v.err, "fat header"), in.file)}; }
    var arch: *fat.ArchShape;
    if (v.ok == tables.FAT_MAGIC.value)    { arch = ?fat.FAT32; }
    or (v.ok == tables.FAT_MAGIC_64.value) { arch = ?fat.FAT64; }
    or {
        ret res[Fat, Fail].err{fail.in_file(fail.at_offset(fail.in_record(fail.malformed("not a fat Mach-O file"), "fat header"), 0), in.file)};
    }
    var m: Fat       = fat.make(a, arch);
    val f: err[Fail] = fill_fat(in, ?m);
    if (sel f.err) {
        val dropped: err[Fail] = fat.release(?m);
        ret res[Fat, Fail].err{fail.in_file(f.err, in.file)};
    }
    ret res[Fat, Fail].ok{m};
}

# read the slice `id` of `f` as a thin file named `file`. the model borrows
# the bytes of the fat file
pub fun read_slice(a: *A.Allocator, f: *Fat, id: Id[Slice], file: str) res[MachO, Fail] {
    val b:  Bytes = fat.bytes(f, ?fat.slice_at(f, id).bytes);
    val in: Input = Input{file: file, data: b.data, len: b.len};
    ret read(a, ?in);
}

# the width and byte order the magic names
fun shape_of(in: *Input) res[Shape, Fail] {
    var r: Reader         = shell.open(in, LITTLE);
    val v: res[u32, Fail] = reader.u32(?r);
    if (sel v.err) { ret res[Shape, Fail].err{fail.in_record(v.err, "file header")}; }
    var shape: Shape;
    if (v.ok == tables.MH_MAGIC.value) {
        shape.class = ?model.CLASS32;
        shape.order = LITTLE;
    }
    or (v.ok == tables.MH_CIGAM.value) {
        shape.class = ?model.CLASS32;
        shape.order = BIG;
    }
    or (v.ok == tables.MH_MAGIC_64.value) {
        shape.class = ?model.CLASS64;
        shape.order = LITTLE;
    }
    or (v.ok == tables.MH_CIGAM_64.value) {
        shape.class = ?model.CLASS64;
        shape.order = BIG;
    }
    or (v.ok == tables.FAT_MAGIC.value || v.ok == tables.FAT_CIGAM.value || v.ok == tables.FAT_MAGIC_64.value || v.ok == tables.FAT_CIGAM_64.value) {
        ret res[Shape, Fail].err{at(fail.in_record(fail.malformed("fat file where a thin Mach-O file is expected"), "file header"), 0)};
    }
    or {
        ret res[Shape, Fail].err{at(fail.in_record(fail.malformed("not a Mach-O file"), "file header"), 0)};
    }
    ret res[Shape, Fail].ok{shape};
}

fun fill(x: *Ctx) err[Fail] {
    val h: err[Fail] = read_header(x);
    if (sel h.err) { ret h; }
    val c: err[Fail] = read_commands(x);
    if (sel c.err) { ret c; }
    ret layout(x);
}

fun read_header(x: *Ctx) err[Fail] {
    val c:   *Class            = x.c;
    val sub: res[Reader, Fail] = reader.sub(?x.file, 0, c.header.size::u64);
    if (sel sub.err) { ret err[Fail].err{fail.in_record(sub.err, "file header")}; }
    var hr: Reader         = sub.ok;
    val b:  res[*u8, Fail] = reader.bytes(?hr, c.header.size::u64);
    if (sel b.err) { ret err[Fail].err{fail.in_record(b.err, "file header")}; }
    val p: *u8           = b.ok;
    val o: Order         = x.order;
    val h: *model.Header = ?x.m.header;
    h.magic      = slot.field(p, c.header.magic, o)::u32;
    h.cputype    = slot.field(p, c.header.cputype, o)::u32;
    h.cpusubtype = slot.field(p, c.header.cpusubtype, o)::u32;
    h.filetype   = slot.field(p, c.header.filetype, o)::u32;
    h.ncmds      = slot.field(p, c.header.ncmds, o)::u32;
    h.sizeofcmds = slot.field(p, c.header.sizeofcmds, o)::u32;
    h.flags      = slot.field(p, c.header.flags, o)::u32;
    h.reserved   = slot.field(p, c.header.reserved, o)::u32;
    ret err[Fail].ok{};
}

fun read_commands(x: *Ctx) err[Fail] {
    val c:     *Class            = x.c;
    val h:     *model.Header     = ?x.m.header;
    val hsize: u64               = c.header.size::u64;
    val t:     res[Reader, Fail] = shell.table(?x.file, "load commands", hsize, 1, h.sizeofcmds::u64);
    if (sel t.err) { ret err[Fail].err{t.err}; }
    val room: res[u64, Fail] = checked.mul(loc(x, c.header.ncmds.offset::u64), h.ncmds::u64, COMMAND_HEAD::u64);
    if (sel room.err) { ret err[Fail].err{room.err}; }
    if (room.ok > h.sizeofcmds::u64) {
        ret err[Fail].err{at(fail.in_record(fail.malformed("load command count exceeds the room for load commands"), "file header"), c.header.ncmds.offset::u64)};
    }
    var lr:  Reader = t.ok;
    var pos: u64    = 0;
    var i:   u64    = 0;
    for (i < h.ncmds::u64) {
        val one: res[u64, Fail] = read_command(x, ?lr, pos);
        if (sel one.err) { ret err[Fail].err{fail.in_indexed(one.err, "load command", i)}; }
        pos = pos + one.ok;
        i   = i + 1;
    }
    x.end = hsize + pos;
    ret err[Fail].ok{};
}

# the load command at `pos` of the commands `lr`, returning its size
fun read_command(x: *Ctx, lr: *Reader, pos: u64) res[u64, Fail] {
    val off:  u64 = lr.base + pos;
    val left: u64 = lr.len::u64 - pos;
    if (left < COMMAND_HEAD::u64) {
        ret res[u64, Fail].err{at(fail.malformed("load command runs past sizeofcmds"), off)};
    }
    val head: res[Reader, Fail] = reader.sub(lr, pos, COMMAND_HEAD::u64);
    if (sel head.err) { ret res[u64, Fail].err{head.err}; }
    var hr:  Reader         = head.ok;
    val cmd: res[u32, Fail] = reader.u32(?hr);
    if (sel cmd.err) { ret res[u64, Fail].err{cmd.err}; }
    val size: res[u32, Fail] = reader.u32(?hr);
    if (sel size.err) { ret res[u64, Fail].err{size.err}; }
    val size_at: u64 = off + WORD_SIZE;
    if (size.ok::usize < COMMAND_HEAD) {
        ret res[u64, Fail].err{at(fail.malformed("command size is smaller than a load command header"), size_at)};
    }
    if (size.ok::u64 % x.c.addr::u64 != 0) {
        ret res[u64, Fail].err{at(fail.malformed("command size is not a multiple of the file's alignment"), size_at)};
    }
    if (size.ok::u64 > left) {
        ret res[u64, Fail].err{at(fail.malformed("load command runs past sizeofcmds"), size_at)};
    }
    val body: res[Reader, Fail] = reader.sub(lr, pos, size.ok::u64);
    if (sel body.err) { ret res[u64, Fail].err{body.err}; }
    val id: res[Id[Command], Fail] = table.push[Command](?x.m.commands, Command{cmd: cmd.ok, cmdsize: size.ok, body: Load.raw{}});
    if (sel id.err) { ret res[u64, Fail].err{id.err}; }
    val recorded: res[Id[u64], Fail] = table.push[u64](?x.offsets, off);
    if (sel recorded.err) { ret res[u64, Fail].err{recorded.err}; }
    var k: Cursor = Cursor{r: body.ok};
    k.r.pos = COMMAND_HEAD;
    var l: res[Load, Fail] = res[Load, Fail].ok{Load.raw{}};
    var i: usize           = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].code.value == cmd.ok::u64) {
            l = ROWS[i].parse(x, ?k, cmd.ok);
            brk;
        }
        i = i + 1;
    }
    if (sel l.err) { ret res[u64, Fail].err{at(l.err, off)}; }
    val c: *Command = model.command_at(x.m, id.ok);
    c.body = l.ok;
    c.rest = Held.borrowed{Bytes{data: ?k.r.data[k.r.pos], len: k.r.len - k.r.pos}};
    ret res[u64, Fail].ok{size.ok::u64};
}

fun loaded(k: *Cursor, l: Load) res[Load, Fail] {
    if (k.failed) { ret res[Load, Fail].err{k.why}; }
    ret res[Load, Fail].ok{l};
}

fun stuck(k: *Cursor, f: Fail) {
    if (k.failed) { ret; }
    k.failed = true;
    k.why    = f;
    if (sel f.cause.truncated) { k.why = Fail{cause: Cause.malformed{}, text: SHORT, at: f.at}; }
}

fun w32(k: *Cursor) u32 {
    if (k.failed) { ret 0; }
    val v: res[u32, Fail] = reader.u32(?k.r);
    if (sel v.err) {
        stuck(k, v.err);
        ret 0;
    }
    ret v.ok;
}

fun w64(k: *Cursor) u64 {
    if (k.failed) { ret 0; }
    val v: res[u64, Fail] = reader.u64(?k.r);
    if (sel v.err) {
        stuck(k, v.err);
        ret 0;
    }
    ret v.ok;
}

# an lc_str, whose offset must lie inside the command
fun wname(k: *Cursor) Name {
    val v: u32 = w32(k);
    if (!k.failed && v::usize >= k.r.len) {
        stuck(k, at(fail.malformed("string offset lies outside its load command"), k.r.base + k.r.pos::u64 - WORD_SIZE));
    }
    ret Name{offset: v};
}

# the next `n` bytes of the command copied into `out`
fun wbytes(k: *Cursor, out: *u8, n: usize) {
    if (k.failed) { ret; }
    val b: res[*u8, Fail] = reader.bytes(?k.r, n::u64);
    if (sel b.err) {
        stuck(k, b.err);
        ret;
    }
    var i: usize = 0;
    for (i < n) {
        out[i] = b.ok[i];
        i      = i + 1;
    }
}

# the command's first `size` bytes, a record whose shape follows the width
fun fixed(k: *Cursor, size: usize) res[*u8, Fail] {
    if (size > k.r.len) { ret res[*u8, Fail].err{at(fail.malformed(SHORT), k.r.base)}; }
    k.r.pos = size;
    ret res[*u8, Fail].ok{k.r.data};
}

fun parse_segment(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val c:    *Class = x.c;
    var want: u32    = tables.LC_SEGMENT.value::u32;
    if (c.addr == 8) { want = tables.LC_SEGMENT_64.value::u32; }
    if (cmd != want) { ret res[Load, Fail].err{fail.malformed("segment command does not match the width of the file")}; }
    val fx: res[*u8, Fail] = fixed(k, c.segment.size);
    if (sel fx.err) { ret res[Load, Fail].err{fx.err}; }
    val p:      *u8   = fx.ok;
    val o:      Order = x.order;
    val cmd_at: u64   = k.r.base;
    var seg:    Segment;
    copy16(?seg.segname[0], p, c.segment.segname);
    seg.vmaddr   = slot.field(p, c.segment.vmaddr, o);
    seg.vmsize   = slot.field(p, c.segment.vmsize, o);
    seg.fileoff  = slot.field(p, c.segment.fileoff, o);
    seg.filesize = slot.field(p, c.segment.filesize, o);
    seg.maxprot  = slot.field(p, c.segment.maxprot, o)::u32;
    seg.initprot = slot.field(p, c.segment.initprot, o)::u32;
    seg.nsects   = slot.field(p, c.segment.nsects, o)::u32;
    seg.flags    = slot.field(p, c.segment.flags, o)::u32;
    val fend: res[u64, Fail] = checked.add(loc(x, cmd_at + c.segment.fileoff.offset::u64), seg.fileoff, seg.filesize);
    if (sel fend.err) { ret res[Load, Fail].err{fend.err}; }
    if (fend.ok > x.in.len::u64) {
        ret res[Load, Fail].err{at(fail.truncated("segment runs past the end of the file"), cmd_at + c.segment.fileoff.offset::u64)};
    }
    val vend: res[u64, Fail] = checked.add(loc(x, cmd_at + c.segment.vmaddr.offset::u64), seg.vmaddr, seg.vmsize);
    if (sel vend.err) { ret res[Load, Fail].err{vend.err}; }
    val room: res[u64, Fail] = checked.mul(loc(x, cmd_at + c.segment.nsects.offset::u64), seg.nsects::u64, c.section.size::u64);
    if (sel room.err) { ret res[Load, Fail].err{room.err}; }
    if (room.ok > reader.remaining(?k.r)::u64) {
        ret res[Load, Fail].err{at(fail.malformed("section headers run past their load command"), cmd_at + c.segment.nsects.offset::u64)};
    }
    seg.sections = table.make[Section](x.m.a);
    var i: u32 = 0;
    for (i < seg.nsects) {
        val at_sect: u64            = k.r.base + k.r.pos::u64;
        val sb:      res[*u8, Fail] = reader.bytes(?k.r, c.section.size::u64);
        if (sel sb.err) { ret lost_sections(?seg, fail.in_indexed(sb.err, "section", i::u64)); }
        val s: Section   = read_section(x, sb.ok);
        val v: err[Fail] = check_section(x, ?seg, vend.ok, ?s, at_sect);
        if (sel v.err) { ret lost_sections(?seg, fail.in_indexed(v.err, "section", i::u64)); }
        val pushed: res[Id[Section], Fail] = table.push[Section](?seg.sections, s);
        if (sel pushed.err) { ret lost_sections(?seg, pushed.err); }
        i = i + 1;
    }
    x.nsects = x.nsects + seg.nsects::u64;
    ret res[Load, Fail].ok{Load.segment{seg}};
}

fun lost_sections(seg: *Segment, f: Fail) res[Load, Fail] {
    val r: err[Fail] = table.release[Section](?seg.sections);
    ret res[Load, Fail].err{f};
}

fun read_section(x: *Ctx, p: *u8) Section {
    val c: *Class = x.c;
    val o: Order  = x.order;
    var s: Section;
    copy16(?s.sectname[0], p, c.section.sectname);
    copy16(?s.segname[0], p, c.section.segname);
    s.addr      = slot.field(p, c.section.addr, o);
    s.length    = slot.field(p, c.section.length, o);
    s.offset    = slot.field(p, c.section.offset, o)::u32;
    s.align     = slot.field(p, c.section.align, o)::u32;
    s.reloff    = slot.field(p, c.section.reloff, o)::u32;
    s.nreloc    = slot.field(p, c.section.nreloc, o)::u32;
    s.flags     = slot.field(p, c.section.flags, o)::u32;
    s.reserved1 = slot.field(p, c.section.reserved1, o)::u32;
    s.reserved2 = slot.field(p, c.section.reserved2, o)::u32;
    s.reserved3 = slot.field(p, c.section.reserved3, o)::u32;
    s.relocs    = table.make[Reloc](x.m.a);
    s.body      = Body.empty{};
    ret s;
}

fun copy16(out: *u8, p: *u8, s: Slot) {
    var i: usize = 0;
    for (i < NAME_SIZE) {
        out[i] = p[s.offset::usize + i];
        i      = i + 1;
    }
}

# a section must lie inside its segment's address range and, unless it has no
# file bytes, inside its file range
fun check_section(x: *Ctx, seg: *Segment, vend: u64, s: *Section, header: u64) err[Fail] {
    val c:    *Class         = x.c;
    val aend: res[u64, Fail] = checked.add(loc(x, header + c.section.addr.offset::u64), s.addr, s.length);
    if (sel aend.err) { ret err[Fail].err{aend.err}; }
    if (s.addr < seg.vmaddr || aend.ok > vend) {
        ret err[Fail].err{at(fail.malformed("section lies outside the address range of its segment"), header + c.section.addr.offset::u64)};
    }
    if (zerofill(s) || s.length == 0) { ret err[Fail].ok{}; }
    val at_off: u64            = header + c.section.offset.offset::u64;
    val fend:   res[u64, Fail] = checked.add(loc(x, at_off), s.offset::u64, s.length);
    if (sel fend.err) { ret err[Fail].err{fend.err}; }
    val send: res[u64, Fail] = checked.add(loc(x, at_off), seg.fileoff, seg.filesize);
    if (sel send.err) { ret err[Fail].err{send.err}; }
    if (s.offset::u64 < seg.fileoff || fend.ok > send.ok) {
        ret err[Fail].err{at(fail.malformed("section lies outside the file range of its segment"), at_off)};
    }
    ret err[Fail].ok{};
}

# whether `s` has no bytes in the file
fun zerofill(s: *Section) bool {
    val t: u32 = model.section_type(s);
    ret t == tables.S_ZEROFILL.value::u32 || t == tables.S_GB_ZEROFILL.value::u32 || t == tables.S_THREAD_LOCAL_ZEROFILL.value::u32;
}

fun parse_symtab(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var s: Symtab;
    s.symoff  = w32(k);
    s.nsyms   = w32(k);
    s.stroff  = w32(k);
    s.strsize = w32(k);
    if (!x.symtab) {
        x.symtab = true;
        x.nsyms  = s.nsyms::u64;
    }
    ret loaded(k, Load.symtab{s});
}

fun parse_symseg(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var s: Symseg;
    s.offset = w32(k);
    s.size   = w32(k);
    ret loaded(k, Load.symseg{s});
}

fun parse_thread(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var states: Thread = Thread{states: table.make[ThreadState](x.m.a)};
    for (reader.remaining(?k.r)::u64 >= STATE_HEAD) {
        val at_state: u64 = k.r.base + k.r.pos::u64;
        var st:       ThreadState;
        st.flavor = w32(k);
        st.count  = w32(k);
        val size: u64 = st.count::u64 * WORD_SIZE;
        if (k.failed || size > reader.remaining(?k.r)::u64) {
            val r: err[Fail] = table.release[ThreadState](?states.states);
            if (k.failed) { ret res[Load, Fail].err{k.why}; }
            ret res[Load, Fail].err{at(fail.malformed("thread state runs past its load command"), at_state)};
        }
        val b: res[*u8, Fail] = reader.bytes(?k.r, size);
        if (sel b.err) {
            val r: err[Fail] = table.release[ThreadState](?states.states);
            ret res[Load, Fail].err{b.err};
        }
        st.state = Held.borrowed{Bytes{data: b.ok, len: size::usize}};
        val pushed: res[Id[ThreadState], Fail] = table.push[ThreadState](?states.states, st);
        if (sel pushed.err) {
            val r: err[Fail] = table.release[ThreadState](?states.states);
            ret res[Load, Fail].err{pushed.err};
        }
    }
    ret res[Load, Fail].ok{Load.thread{states}};
}

fun parse_fvmlib(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var f: Fvmlib;
    f.name          = wname(k);
    f.minor_version = w32(k);
    f.header_addr   = w32(k);
    ret loaded(k, Load.fvmlib{f});
}

fun parse_ident(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    ret res[Load, Fail].ok{Load.ident{}};
}

fun parse_fvmfile(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
