    Row{code: ?tables.LC_DYLIB_CODE_SIGN_DRS, parse: parse_linkedit},
    Row{code: ?tables.LC_LINKER_OPTIMIZATION_HINT, parse: parse_linkedit},
    Row{code: ?tables.LC_DYLD_EXPORTS_TRIE, parse: parse_linkedit},
    Row{code: ?tables.LC_DYLD_CHAINED_FIXUPS, parse: parse_linkedit},
    Row{code: ?tables.LC_ATOM_INFO, parse: parse_linkedit},
    Row{code: ?tables.LC_FUNCTION_VARIANTS, parse: parse_linkedit},
    Row{code: ?tables.LC_FUNCTION_VARIANT_FIXUPS, parse: parse_linkedit},
    Row{code: ?tables.LC_LAZY_LOAD_DYLIB_INFO, parse: parse_linkedit},
    Row{code: ?tables.LC_ENCRYPTION_INFO, parse: parse_encryption},
    Row{code: ?tables.LC_ENCRYPTION_INFO_64, parse: parse_encryption},
    Row{code: ?tables.LC_DYLD_INFO, parse: parse_dyld_info},
