val COMMAND_HEAD: usize = 8;
val NAME_SIZE:    usize = 16;
val STATE_HEAD:   u64   = 8;
val TOOL_SIZE:    u64   = 8;

val SHORT: str = "command size is smaller than its fixed fields";

# what an extent range holds
val KIND_SECTION: u8 = 0;
val KIND_RELOCS:  u8 = 1;
val KIND_BLOB:    u8 = 2;

# the bitfields of a relocation_info word after r_address, which a producer
# lays out from the other end of the word when the file is big-endian
rec Packed {
    symbolnum: Bits;
    pcrel:     Bits;
    length:    Bits;
    external:  Bits;
    type:      Bits;
}

val PACKED_LITTLE: Packed = Packed{
    symbolnum: Bits{shift: 0, width: 24},
    pcrel:     Bits{shift: 24, width: 1},
    length:    Bits{shift: 25, width: 2},
    external:  Bits{shift: 27, width: 1},
    type:      Bits{shift: 28, width: 4},
};

val PACKED_BIG: Packed = Packed{
    symbolnum: Bits{shift: 8, width: 24},
    pcrel:     Bits{shift: 7, width: 1},
    length:    Bits{shift: 5, width: 2},
    external:  Bits{shift: 4, width: 1},
    type:      Bits{shift: 0, width: 4},
};

# the bitfields of the first word of a scattered_relocation_info
val SCATTER_ADDRESS: Bits = Bits{shift: 0, width: 24};
val SCATTER_TYPE:    Bits = Bits{shift: 24, width: 4};
val SCATTER_LENGTH:  Bits = Bits{shift: 28, width: 2};
val SCATTER_PCREL:   Bits = Bits{shift: 30, width: 1};

# the file being read
# ---
# in:      the input, borrowed by the model
# file:    the whole input
# m:       the model being filled
# c:       the file's width
# order:   the file's byte order
# offsets: the file offset of each load command
# end:     the file offset after the last load command
# nsects:  the number of sections over every segment
# nsyms:   the symbol count of the first symbol table
# symtab:  whether a symbol table was seen
rec Ctx {
    in:      *Input;
    file:    Reader;
    m:       *MachO;
    c:       *Class;
    order:   Order;
    offsets: Table[u64];
    end:     u64;
    nsects:  u64;
    nsyms:   u64;
    symtab:  bool;
}

# a load command's fields read in order. the first failure sticks and every
# later read gives zero, so a parser checks once at the end
rec Cursor {
    r:      Reader;
    failed: bool;
    why:    Fail;
}

def Parse: fun(*Ctx, *Cursor, u32) res[Load, Fail];

# the typed parser of one load command
rec Row {
    code:  *Constant;
    parse: Parse;
}

val ROW_COUNT: usize = 58;

val ROWS: [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{code: ?tables.LC_SEGMENT, parse: parse_segment},
    Row{code: ?tables.LC_SEGMENT_64, parse: parse_segment},
    Row{code: ?tables.LC_SYMTAB, parse: parse_symtab},
    Row{code: ?tables.LC_SYMSEG, parse: parse_symseg},
    Row{code: ?tables.LC_THREAD, parse: parse_thread},
    Row{code: ?tables.LC_UNIXTHREAD, parse: parse_thread},
    Row{code: ?tables.LC_LOADFVMLIB, parse: parse_fvmlib},
    Row{code: ?tables.LC_IDFVMLIB, parse: parse_fvmlib},
    Row{code: ?tables.LC_IDENT, parse: parse_ident},
    Row{code: ?tables.LC_FVMFILE, parse: parse_fvmfile},
    Row{code: ?tables.LC_DYSYMTAB, parse: parse_dysymtab},
    Row{code: ?tables.LC_LOAD_DYLIB, parse: parse_dylib},
    Row{code: ?tables.LC_ID_DYLIB, parse: parse_dylib},
    Row{code: ?tables.LC_LOAD_WEAK_DYLIB, parse: parse_dylib},
    Row{code: ?tables.LC_REEXPORT_DYLIB, parse: parse_dylib},
    Row{code: ?tables.LC_LOAD_UPWARD_DYLIB, parse: parse_dylib},
    Row{code: ?tables.LC_LAZY_LOAD_DYLIB, parse: parse_dylib},
    Row{code: ?tables.LC_LOAD_DYLINKER, parse: parse_dylinker},
    Row{code: ?tables.LC_ID_DYLINKER, parse: parse_dylinker},
    Row{code: ?tables.LC_DYLD_ENVIRONMENT, parse: parse_dylinker},
    Row{code: ?tables.LC_PREBOUND_DYLIB, parse: parse_prebound},
    Row{code: ?tables.LC_ROUTINES, parse: parse_routines},
    Row{code: ?tables.LC_ROUTINES_64, parse: parse_routines},
    Row{code: ?tables.LC_SUB_FRAMEWORK, parse: parse_sub},
    Row{code: ?tables.LC_SUB_UMBRELLA, parse: parse_sub},
    Row{code: ?tables.LC_SUB_CLIENT, parse: parse_sub},
    Row{code: ?tables.LC_SUB_LIBRARY, parse: parse_sub},
    Row{code: ?tables.LC_TWOLEVEL_HINTS, parse: parse_hints},
    Row{code: ?tables.LC_PREBIND_CKSUM, parse: parse_cksum},
    Row{code: ?tables.LC_UUID, parse: parse_uuid},
