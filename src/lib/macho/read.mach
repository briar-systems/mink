}

fun parse_dysymtab(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var d: Dysymtab;
    d.ilocalsym      = w32(k);
    d.nlocalsym      = w32(k);
    d.iextdefsym     = w32(k);
    d.nextdefsym     = w32(k);
    d.iundefsym      = w32(k);
    d.nundefsym      = w32(k);
    d.tocoff         = w32(k);
    d.ntoc           = w32(k);
    d.modtaboff      = w32(k);
    d.nmodtab        = w32(k);
    d.extrefsymoff   = w32(k);
    d.nextrefsyms    = w32(k);
    d.indirectsymoff = w32(k);
    d.nindirectsyms  = w32(k);
    d.extreloff      = w32(k);
    d.nextrel        = w32(k);
    d.locreloff      = w32(k);
    d.nlocrel        = w32(k);
    ret loaded(k, Load.dysymtab{d});
}

fun parse_dylib(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val name:   Name = wname(k);
    val stamp:  u32  = w32(k);
    val cur:    u32  = w32(k);
    val compat: u32  = w32(k);
    if (stamp == tables.DYLIB_USE_MARKER.value::u32) {
        val flags: u32 = w32(k);
        ret loaded(k, Load.dylib_use{DylibUse{name: name, marker: stamp, current_version: cur, compat_version: compat, flags: flags}});
    }
    ret loaded(k, Load.dylib{Dylib{name: name, timestamp: stamp, current_version: cur, compatibility_version: compat}});
}

fun parse_dylinker(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val n: Name = wname(k);
    ret loaded(k, Load.dylinker{n});
}

fun parse_prebound(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    var p: Prebound;
    p.name           = wname(k);
    p.nmodules       = w32(k);
    p.linked_modules = wname(k);
    ret loaded(k, Load.prebound{p});
}

fun parse_routines(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val c:    *Class = x.c;
    var want: u32    = tables.LC_ROUTINES.value::u32;
    if (c.addr == 8) { want = tables.LC_ROUTINES_64.value::u32; }
    if (cmd != want) { ret res[Load, Fail].err{fail.malformed("routines command does not match the width of the file")}; }
    val fx: res[*u8, Fail] = fixed(k, c.routines.size);
    if (sel fx.err) { ret res[Load, Fail].err{fx.err}; }
    var r: Routines;
    r.init_address = slot.field(fx.ok, c.routines.init_address, x.order);
    r.init_module  = slot.field(fx.ok, c.routines.init_module, x.order);
    var i: usize = 0;
    for (i < 6) {
        r.reserved[i] = slot.field(fx.ok, Slot{offset: c.routines.reserved.offset + (i * c.addr)::u8, width: c.addr::u8}, x.order);
        i             = i + 1;
    }
    ret res[Load, Fail].ok{Load.routines{r}};
}

fun parse_sub(x: *Ctx, k: *Cursor, cmd: u32) res[Load, Fail] {
    val n: Name = wname(k);
    ret loaded(k, Load.sub{n});
}

