# the function starts and the data in code of the link-edit data
#
# function starts are a ULEB delta list from the start of __TEXT, ended by a
# zero delta and zero padded. data in code is a table of fixed records. both
# are pure functions over bytes and entries.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mink.lib.checked;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.macho.model.DataInCode;
use mink.lib.reader;
use mink.lib.reader.LITTLE;
use mink.lib.reader.Reader;
use mink.lib.sink;
use mink.lib.sink.Sink;
use mink.lib.table;
use mink.lib.table.Id;
use mink.lib.table.Table;

# the width of a data in code record
pub val DATA_IN_CODE_SIZE: usize = 8;

# the most function starts one list may decode to
val MAX_STARTS: usize = 0x400_0000;

# the offsets from the start of __TEXT the reader's list of deltas names
pub fun decode_starts(a: *A.Allocator, r: *Reader) res[Table[u64], Fail] {
    var out: Table[u64] = table.make[u64](a);
    val ran: err[Fail]  = run_starts(?out, r);
    if (sel ran.err) {
        val dropped: err[Fail] = table.release[u64](?out);
        ret res[Table[u64], Fail].err{ran.err};
    }
    ret res[Table[u64], Fail].ok{out};
}

fun run_starts(out: *Table[u64], r: *Reader) err[Fail] {
    var at: u64 = 0;
    for (reader.remaining(r) > 0) {
        val here:  u64            = reader.offset(r);
        val delta: res[u64, Fail] = reader.uleb(r);
        if (sel delta.err) { ret err[Fail].err{delta.err}; }
        if (delta.ok == 0) {
            for (reader.remaining(r) > 0) {
                val b: res[u8, Fail] = reader.u8(r);
                if (sel b.err) { ret err[Fail].err{b.err}; }
                if (b.ok != 0) { ret err[Fail].err{fail.at_offset(fail.in_file(fail.unsupported("bytes follow the end of the function starts"), r.file), reader.offset(r) - 1)}; }
            }
            ret err[Fail].ok{};
        }
        val sum: res[u64, Fail] = checked.add(reader.here(r), at, delta.ok);
        if (sel sum.err) { ret err[Fail].err{sum.err}; }
        if (table.count[u64](out) >= MAX_STARTS) {
            ret err[Fail].err{fail.at_offset(fail.in_file(fail.unsupported("function starts list is longer than mink holds"), r.file), here)};
        }
        at = sum.ok;
        val p: res[Id[u64], Fail] = table.push[u64](out, at);
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    ret err[Fail].ok{};
}

# the list of deltas for `offsets`, which ascend, ended by a zero delta and
# zero padded to `align`
pub fun encode_starts(s: *Sink, offsets: *Table[u64], align: usize) err[Fail] {
    if (table.count[u64](offsets) == 0) { ret err[Fail].ok{}; }
    var prev: u64   = 0;
    var i:    usize = 0;
    for (i < table.count[u64](offsets)) {
        val at: u64 = @table.at[u64](offsets, table.nth[u64](i));
        if (at <= prev) { ret err[Fail].err{fail.malformed("function starts do not ascend")}; }
        val w: err[Fail] = sink.uleb(s, at - prev);
        if (sel w.err) { ret w; }
        prev = at;
        i    = i + 1;
    }
    val end: err[Fail] = sink.u8(s, 0);
    if (sel end.err) { ret end; }
    ret sink.pad_to(s, align);
}

# the data in code entries the reader spans
pub fun decode_data_in_code(a: *A.Allocator, r: *Reader) res[Table[DataInCode], Fail] {
    var out: Table[DataInCode] = table.make[DataInCode](a);
    if (reader.remaining(r) % DATA_IN_CODE_SIZE != 0) {
        ret res[Table[DataInCode], Fail].err{fail.at_offset(fail.in_file(fail.malformed("data in code is not a whole number of records"), r.file), reader.offset(r))};
    }
    val g: res[Id[DataInCode], Fail] = table.grow[DataInCode](?out, reader.remaining(r) / DATA_IN_CODE_SIZE);
    if (sel g.err) { ret res[Table[DataInCode], Fail].err{g.err}; }
    var i: usize = 0;
    for (i < table.count[DataInCode](?out)) {
        val offset: res[u32, Fail] = reader.u32(r);
        val length: res[u16, Fail] = reader.u16(r);
        val kind:   res[u16, Fail] = reader.u16(r);
        if (sel offset.err) { ret res[Table[DataInCode], Fail].err{drop_dic(?out, offset.err)}; }
        if (sel length.err) { ret res[Table[DataInCode], Fail].err{drop_dic(?out, length.err)}; }
        if (sel kind.err)   { ret res[Table[DataInCode], Fail].err{drop_dic(?out, kind.err)}; }
        table.at[DataInCode](?out, table.nth[DataInCode](i)).offset = offset.ok;
        table.at[DataInCode](?out, table.nth[DataInCode](i)).length = length.ok;
        table.at[DataInCode](?out, table.nth[DataInCode](i)).kind   = kind.ok;
        i                                                           = i + 1;
    }
    ret res[Table[DataInCode], Fail].ok{out};
}

fun drop_dic(t: *Table[DataInCode], f: Fail) Fail {
    val dropped: err[Fail] = table.release[DataInCode](t);
    ret f;
}

pub fun encode_data_in_code(s: *Sink, entries: *Table[DataInCode]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[DataInCode](entries)) {
        val e: *DataInCode = table.at[DataInCode](entries, table.nth[DataInCode](i));
        val a: err[Fail]   = sink.u32(s, e.offset);
        if (sel a.err) { ret a; }
        val b: err[Fail] = sink.u16(s, e.length);
        if (sel b.err) { ret b; }
        val c: err[Fail] = sink.u16(s, e.kind);
        if (sel c.err) { ret c; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

test starts__function_starts_and_data_in_code_round_trip {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    var offsets: Table[u64] = table.make[u64](a);
    val at:      [5]u64     = [5]u64{0x10, 0x30, 0x1030, 0x4_0000, 0x4_0004};
    var i:       usize      = 0;
    for (i < 5) {
        val p: res[Id[u64], Fail] = table.push[u64](?offsets, at[i]);
        if (sel p.err) { ret 1; }
        i = i + 1;
    }
    var s: Sink      = sink.make(a, LITTLE);
    val e: err[Fail] = encode_starts(?s, ?offsets, 8);
    if (sel e.err) { ret 1; }
    val want: [16]u8 = [16]u8{0x10, 0x20, 0x80, 0x20, 0xd0, 0xdf, 0x0f, 0x04, 0x00, 0, 0, 0, 0, 0, 0, 0};
    if (sink.len(?s) != 16) { ret 1; }
    i = 0;
    for (i < 16) {
        if (sink.data(?s)[i] != want[i]) { ret 1; }
        i = i + 1;
    }
    var r: Reader                = reader.make("t", sink.data(?s), sink.len(?s), LITTLE);
    val d: res[Table[u64], Fail] = decode_starts(a, ?r);
    if (sel d.err) { ret 1; }
    var back: Table[u64] = d.ok;
    if (table.count[u64](?back) != 5) { ret 1; }
    i = 0;
    for (i < 5) {
        if (@table.at[u64](?back, table.nth[u64](i)) != at[i]) { ret 1; }
        i = i + 1;
    }

    var entries: Table[DataInCode]         = table.make[DataInCode](a);
    val p1:      res[Id[DataInCode], Fail] = table.push[DataInCode](?entries, DataInCode{offset: 0x40, length: 16, kind: 4});
    val p2:      res[Id[DataInCode], Fail] = table.push[DataInCode](?entries, DataInCode{offset: 0x1000, length: 3, kind: 1});
    if (sel p1.err || sel p2.err) { ret 1; }
    var b:  Sink      = sink.make(a, LITTLE);
    val e2: err[Fail] = encode_data_in_code(?b, ?entries);
    if (sel e2.err) { ret 1; }
    var q:  Reader                       = reader.make("t", sink.data(?b), sink.len(?b), LITTLE);
    val d2: res[Table[DataInCode], Fail] = decode_data_in_code(a, ?q);
    if (sel d2.err) { ret 1; }
    var again: Table[DataInCode] = d2.ok;
    var c:     Sink              = sink.make(a, LITTLE);
    val e3:    err[Fail]         = encode_data_in_code(?c, ?again);
    if (sel e3.err)                               { ret 1; }
    if (sink.len(?b) != 16 || sink.len(?c) != 16) { ret 1; }
    i = 0;
    for (i < 16) {
        if (sink.data(?b)[i] != sink.data(?c)[i]) { ret 1; }
        i = i + 1;
    }

    val r1: err[Fail] = table.release[u64](?offsets);
    val r2: err[Fail] = table.release[u64](?back);
    val r3: err[Fail] = table.release[DataInCode](?entries);
    val r4: err[Fail] = table.release[DataInCode](?again);
    val r5: err[Fail] = sink.release(?s);
    val r6: err[Fail] = sink.release(?b);
    val r7: err[Fail] = sink.release(?c);
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
