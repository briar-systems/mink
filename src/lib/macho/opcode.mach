# the rebase and bind opcode streams of LC_DYLD_INFO
#
# a decoder runs a stream through the machine dyld runs and yields one entry
# per location, and an encoder turns entries back into the stream. the
# encoder picks the compact opcodes ld64 picks, so the stream ld64 wrote for
# a set of locations comes back byte for byte, its terminating DONE and its
# zero padding included. a stream another linker compacted differently decodes
# to the same entries and encodes to ld64's choice of bytes, so the model that
# must give back its input keeps the stream beside the entries.
#
# both codecs are pure functions over bytes and entries. the reader spans
# exactly the stream and starts at its first byte, so a symbol name's offset is
# its position in the reader.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mink.lib.checked;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;
use mink.lib.macho.model.Bind;
use mink.lib.macho.model.Rebase;
use mink.lib.macho.tables;
use mink.lib.macho.tables.Constant;
use mink.lib.reader;
use mink.lib.reader.LITTLE;
use mink.lib.reader.Reader;
use mink.lib.sink;
use mink.lib.sink.Sink;
use mink.lib.store.Bytes;
use mink.lib.table;
use mink.lib.table.Id;
use mink.lib.table.Table;

# which of the three bind streams
# ---
# regular: the binds dyld resolves at load, each naming its dylib
# lazy:    the binds a stub resolves on first call, each ended by its own DONE
# weak:    the weak definitions and the locations that coalesce on them, with no dylib
pub tag Flavor: u8 {
    regular;
    lazy;
    weak;
}

# the most locations one stream may decode to
val MAX_LOCATIONS: usize = 0x400_0000;

# the shortest run of identical add-and-step ops each stream folds into one
val MIN_REBASE_RUN: usize = 3;
val MIN_BIND_RUN:   usize = 2;

# the most a segment index, a type and a flag may hold, one nibble
val NIBBLE: u64 = 0xf;

# the position of a machine in the address space of the image
# ---
# segment: the segment index the offset lies in
# offset:  the byte offset in that segment
# type:    the type the next location is bound or rebased as
# placed:  whether a segment and offset was set
rec Cursor {
    segment: u32;
    offset:  u64;
    type:    u8;
    placed:  bool;
}

# one step of an encoder's temporary form
rec Op {
    code: u64;
    a:    u64;
    b:    u64;
    name: u32;
}

fun is(op: u64, c: *Constant) bool {
    ret op == c.value;
}

fun opcode(b: u8) u64 {
    ret (b::u64) & tables.REBASE_OPCODE_MASK.value;
}

fun immediate(b: u8) u64 {
    ret (b::u64) & tables.REBASE_IMMEDIATE_MASK.value;
}

# the stream after a DONE holds nothing but the zero padding of its blob
fun zero_tail(r: *Reader) err[Fail] {
    for (reader.remaining(r) > 0) {
        val at: Location      = reader.here(r);
        val b:  res[u8, Fail] = reader.u8(r);
        if (sel b.err) { ret err[Fail].err{b.err}; }
        if (b.ok != 0) { ret err[Fail].err{fail.unsupported("bytes follow the end of an opcode stream")}; }
    }
    ret err[Fail].ok{};
}

fun placed(c: *Cursor, at: Location) err[Fail] {
    if (!c.placed) { ret err[Fail].err{placed_at(fail.unsupported("opcode moves before a segment and offset is set"), at)}; }
    ret err[Fail].ok{};
}

fun placed_at(f: Fail, at: Location) Fail {
    ret fail.at_offset(fail.in_file(f, at.file), at.offset);
}

# the offset advanced by `n` bytes
fun advance(c: *Cursor, at: Location, n: u64) err[Fail] {
    val sum: res[u64, Fail] = checked.add(at, c.offset, n);
    if (sel sum.err) { ret err[Fail].err{sum.err}; }
    c.offset = sum.ok;
    ret err[Fail].ok{};
}

# the offset moved by an ADD_ADDR operand, a two's complement delta as dyld takes it
fun shift(c: *Cursor, at: Location, v: u64) err[Fail] {
    if (v < 0x8000_0000_0000_0000) { ret advance(c, at, v); }
    val back: u64 = ~v + 1;
    if (back > c.offset) { ret err[Fail].err{placed_at(fail.overflow("opcode moves before the start of its segment"), at)}; }
    c.offset = c.offset - back;
    ret err[Fail].ok{};
}

# the offset advanced past one pointer and then moved by `skip`
fun advance_pointers(c: *Cursor, at: Location, skip: u64, ptr: u64) err[Fail] {
    val past: err[Fail] = advance(c, at, ptr);
    if (sel past.err) { ret past; }
    ret shift(c, at, skip);
}

fun too_many(at: Location) Fail {
    ret placed_at(fail.unsupported("stream decodes to more locations than mink holds"), at);
}

fun release_all[T](t: *Table[T], f: Fail) Fail {
    val dropped: err[Fail] = table.release[T](t);
    if (sel dropped.err) { ret dropped.err; }
    ret f;
}

# the locations a rebase stream rebases. `ptr` is the width of a pointer in bytes
pub fun decode_rebases(a: *A.Allocator, r: *Reader, ptr: u64) res[Table[Rebase], Fail] {
    var out: Table[Rebase] = table.make[Rebase](a);
    val ran: err[Fail]     = run_rebases(?out, r, ptr);
    if (sel ran.err) { ret res[Table[Rebase], Fail].err{release_all[Rebase](?out, ran.err)}; }
    ret res[Table[Rebase], Fail].ok{out};
}

fun rebase_times(out: *Table[Rebase], c: *Cursor, at: Location, times: u64, skip: u64, ptr: u64) err[Fail] {
    val ok: err[Fail] = placed(c, at);
    if (sel ok.err)                                              { ret ok; }
    if (times > (MAX_LOCATIONS - table.count[Rebase](out))::u64) { ret err[Fail].err{too_many(at)}; }
    var i: u64 = 0;
    for (i < times) {
        val p: res[Id[Rebase], Fail] = table.push[Rebase](out, Rebase{segment: c.segment, offset: c.offset, type: c.type});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        val m: err[Fail] = advance_pointers(c, at, skip, ptr);
        if (sel m.err) { ret m; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun run_rebases(out: *Table[Rebase], r: *Reader, ptr: u64) err[Fail] {
    var c: Cursor;
    for (reader.remaining(r) > 0) {
        val at: Location      = reader.here(r);
        val b:  res[u8, Fail] = reader.u8(r);
        if (sel b.err) { ret err[Fail].err{b.err}; }
        val op:  u64 = opcode(b.ok);
        val imm: u64 = immediate(b.ok);
        if (is(op, ?tables.REBASE_OPCODE_DONE)) {
            if (imm != 0) { ret err[Fail].err{placed_at(fail.unsupported("DONE opcode carries an immediate"), at)}; }
            ret zero_tail(r);
        }
        or (is(op, ?tables.REBASE_OPCODE_SET_TYPE_IMM)) {
            c.type = imm::u8;
        }
        or (is(op, ?tables.REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB)) {
            val v: res[u64, Fail] = reader.uleb(r);
            if (sel v.err) { ret err[Fail].err{v.err}; }
            c.segment = imm::u32;
            c.offset  = v.ok;
            c.placed  = true;
        }
        or (is(op, ?tables.REBASE_OPCODE_ADD_ADDR_ULEB)) {
            val v: res[u64, Fail] = reader.uleb(r);
            if (sel v.err) { ret err[Fail].err{v.err}; }
            val ok: err[Fail] = placed(?c, at);
            if (sel ok.err) { ret ok; }
            val m: err[Fail] = shift(?c, at, v.ok);
            if (sel m.err) { ret m; }
        }
        or (is(op, ?tables.REBASE_OPCODE_ADD_ADDR_IMM_SCALED)) {
            val ok: err[Fail] = placed(?c, at);
            if (sel ok.err) { ret ok; }
            val m: err[Fail] = advance(?c, at, imm * ptr);
            if (sel m.err) { ret m; }
        }
        or (is(op, ?tables.REBASE_OPCODE_DO_REBASE_IMM_TIMES)) {
            val m: err[Fail] = rebase_times(out, ?c, at, imm, 0, ptr);
            if (sel m.err) { ret m; }
        }
        or (is(op, ?tables.REBASE_OPCODE_DO_REBASE_ULEB_TIMES)) {
            val v: res[u64, Fail] = reader.uleb(r);
            if (sel v.err) { ret err[Fail].err{v.err}; }
            val m: err[Fail] = rebase_times(out, ?c, at, v.ok, 0, ptr);
            if (sel m.err) { ret m; }
        }
        or (is(op, ?tables.REBASE_OPCODE_DO_REBASE_ADD_ADDR_ULEB)) {
            val v: res[u64, Fail] = reader.uleb(r);
            if (sel v.err) { ret err[Fail].err{v.err}; }
            val m: err[Fail] = rebase_times(out, ?c, at, 1, v.ok, ptr);
            if (sel m.err) { ret m; }
        }
        or (is(op, ?tables.REBASE_OPCODE_DO_REBASE_ULEB_TIMES_SKIPPING_ULEB)) {
            val times: res[u64, Fail] = reader.uleb(r);
            if (sel times.err) { ret err[Fail].err{times.err}; }
            val skip: res[u64, Fail] = reader.uleb(r);
            if (sel skip.err) { ret err[Fail].err{skip.err}; }
            val m: err[Fail] = rebase_times(out, ?c, at, times.ok, skip.ok, ptr);
            if (sel m.err) { ret m; }
        }
        or {
            ret err[Fail].err{placed_at(fail.unsupported("unknown rebase opcode"), at)};
        }
    }
    ret err[Fail].ok{};
}

fun put_op(s: *Sink, op: u64, imm: u64) err[Fail] {
    ret sink.u8(s, (op | imm)::u8);
}

fun put_uleb_op(s: *Sink, op: u64, imm: u64, v: u64) err[Fail] {
    val w: err[Fail] = put_op(s, op, imm);
    if (sel w.err) { ret w; }
    ret sink.uleb(s, v);
}

fun put_uleb2_op(s: *Sink, op: u64, a: u64, b: u64) err[Fail] {
    val w: err[Fail] = put_uleb_op(s, op, 0, a);
    if (sel w.err) { ret w; }
    ret sink.uleb(s, b);
}

fun put_sleb_op(s: *Sink, op: u64, v: i64) err[Fail] {
    val w: err[Fail] = put_op(s, op, 0);
    if (sel w.err) { ret w; }
    ret sink.sleb(s, v);
}

fun pad(s: *Sink, align: usize) err[Fail] {
    ret sink.pad_to(s, align);
}

fun push_op(t: *Table[Op], code: u64, a: u64, b: u64) err[Fail] {
    val p: res[Id[Op], Fail] = table.push[Op](t, Op{code: code, a: a, b: b});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# whether an add of `v` bytes fits the scaled immediate of a pointer width
fun scalable(v: u64, ptr: u64) bool {
    ret v % ptr == 0 && v < NIBBLE * ptr;
}

# the stream for `entries`, in the order given, the way ld64 compacts it,
# ended by DONE and zero padded to `align`
pub fun encode_rebases(s: *Sink, a: *A.Allocator, entries: *Table[Rebase], ptr: u64, align: usize) err[Fail] {
    if (table.count[Rebase](entries) == 0) { ret err[Fail].ok{}; }
    var mid: Table[Op] = table.make[Op](a);
    val ran: err[Fail] = build_rebases(?mid, entries, ptr);
    if (sel ran.err) { ret err[Fail].err{release_all[Op](?mid, ran.err)}; }
    compact_rebases(?mid, ptr);
    val w:       err[Fail] = emit_rebases(s, ?mid);
    val dropped: err[Fail] = table.release[Op](?mid);
    if (sel w.err)       { ret w; }
    if (sel dropped.err) { ret dropped; }
    val done: err[Fail] = sink.u8(s, tables.REBASE_OPCODE_DONE.value::u8);
    if (sel done.err) { ret done; }
    ret pad(s, align);
}

fun build_rebases(mid: *Table[Op], entries: *Table[Rebase], ptr: u64) err[Fail] {
    var type:    u8    = 0;
    var segment: u32   = 0;
    var offset:  u64   = 0;
    var have:    bool  = false;
    var i:       usize = 0;
    for (i < table.count[Rebase](entries)) {
        val e: *Rebase = table.at[Rebase](entries, table.nth[Rebase](i));
        if (e.type::u64 > NIBBLE || e.segment::u64 > NIBBLE) {
            ret err[Fail].err{fail.malformed("rebase type or segment does not fit an opcode")};
        }
        if (e.type != type) {
            val w: err[Fail] = push_op(mid, tables.REBASE_OPCODE_SET_TYPE_IMM.value, e.type::u64, 0);
            if (sel w.err) { ret w; }
            type = e.type;
        }
        if (!have || e.segment != segment) {
            val w: err[Fail] = push_op(mid, tables.REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB.value, e.segment::u64, e.offset);
            if (sel w.err) { ret w; }
        }
        or (e.offset != offset) {
            val w: err[Fail] = push_op(mid, tables.REBASE_OPCODE_ADD_ADDR_ULEB.value, e.offset - offset, 0);
            if (sel w.err) { ret w; }
        }
        val w: err[Fail] = push_op(mid, tables.REBASE_OPCODE_DO_REBASE_IMM_TIMES.value, 1, 0);
        if (sel w.err) { ret w; }
        have    = true;
        segment = e.segment;
        offset  = e.offset + ptr;
        i       = i + 1;
    }
    ret err[Fail].ok{};
}

# the passes ld64 runs over the plain form, each rewriting the table in place
fun compact_rebases(mid: *Table[Op], ptr: u64) {
    val n:   usize = table.count[Op](mid);
    val o:   *Op   = table.items[Op](mid);
    var src: usize = 0;
    var dst: usize = 0;

    for (src < n) {
        o[dst] = o[src];
        if (o[src].code == tables.REBASE_OPCODE_DO_REBASE_IMM_TIMES.value) {
            for (src + 1 < n && o[src + 1].code == tables.REBASE_OPCODE_DO_REBASE_IMM_TIMES.value) {
                o[dst].a = o[dst].a + o[src + 1].a;
                src      = src + 1;
            }
        }
        src = src + 1;
        dst = dst + 1;
    }
    mid.count = dst;

    src = 0;
    dst = 0;
    val m: usize = table.count[Op](mid);
    for (src < m) {
        o[dst] = o[src];
        if (o[src].code == tables.REBASE_OPCODE_DO_REBASE_IMM_TIMES.value && o[src].a == 1
            && src + 1 < m && o[src + 1].code == tables.REBASE_OPCODE_ADD_ADDR_ULEB.value) {
            o[dst].code = tables.REBASE_OPCODE_DO_REBASE_ADD_ADDR_ULEB.value;
            o[dst].a    = o[src + 1].a;
            src         = src + 1;
        }
        src = src + 1;
        dst = dst + 1;
    }
    mid.count = dst;

    src = 0;
    for (src < dst) {
        if (o[src].code == tables.REBASE_OPCODE_ADD_ADDR_ULEB.value && scalable(o[src].a, ptr)) {
            o[src].code = tables.REBASE_OPCODE_ADD_ADDR_IMM_SCALED.value;
            o[src].a    = o[src].a / ptr;
        }
        src = src + 1;
    }

    mid.count = skip_runs(o, dst, tables.REBASE_OPCODE_DO_REBASE_ADD_ADDR_ULEB.value, tables.REBASE_OPCODE_DO_REBASE_ULEB_TIMES_SKIPPING_ULEB.value, MIN_REBASE_RUN);
}

# how many ops from `at` repeat the op `code` with one operand
fun run_of(o: *Op, n: usize, at: usize, code: u64) usize {
    var k: usize = at;
    for (k < n && o[k].code == code && o[k].a == o[at].a) { k = k + 1; }
    ret k - at;
}

# runs of `code` ops with one operand, `min` or longer, become one `skipping`
# op, and the new length of the table
fun skip_runs(o: *Op, n: usize, code: u64, skipping: u64, min: usize) usize {
    var src: usize = 0;
    var dst: usize = 0;
    for (src < n) {
        val run: usize = run_of(o, n, src, code);
        if (o[src].code == code && run >= min) {
            o[dst] = Op{code: skipping, a: run::u64, b: o[src].a};
            src    = src + run;
        }
        or {
            o[dst] = o[src];
            src    = src + 1;
        }
        dst = dst + 1;
    }
    ret dst;
}

fun emit_rebases(s: *Sink, mid: *Table[Op]) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Op](mid)) {
        val o: *Op       = table.at[Op](mid, table.nth[Op](i));
        var w: err[Fail] = err[Fail].ok{};
        if (o.code == tables.REBASE_OPCODE_SET_TYPE_IMM.value)                { w = put_op(s, o.code, o.a); }
        or (o.code == tables.REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB.value) { w = put_uleb_op(s, o.code, o.a, o.b); }
        or (o.code == tables.REBASE_OPCODE_ADD_ADDR_ULEB.value)               { w = put_uleb_op(s, o.code, 0, o.a); }
        or (o.code == tables.REBASE_OPCODE_ADD_ADDR_IMM_SCALED.value)         { w = put_op(s, o.code, o.a); }
        or (o.code == tables.REBASE_OPCODE_DO_REBASE_IMM_TIMES.value) {
            if (o.a < NIBBLE) { w = put_op(s, o.code, o.a); }
            or                { w = put_uleb_op(s, tables.REBASE_OPCODE_DO_REBASE_ULEB_TIMES.value, 0, o.a); }
        }
        or (o.code == tables.REBASE_OPCODE_DO_REBASE_ADD_ADDR_ULEB.value) { w = put_uleb_op(s, o.code, 0, o.a); }
        or (o.code == tables.REBASE_OPCODE_DO_REBASE_ULEB_TIMES_SKIPPING_ULEB.value) {
            w = put_uleb2_op(s, o.code, o.a, o.b);
        }
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the state of the machine a bind stream runs
# ---
# at:      the cursor
# ordinal: the dylib ordinal, special ordinals below zero
# flags:   the flags of the symbol set last
# addend:  the addend
# name:    the offset of the symbol name set last
# named:   whether a symbol was set
# pending: whether the symbol was set and nothing was bound to it since
rec Machine {
    at:      Cursor;
    ordinal: i64;
    flags:   u8;
    addend:  i64;
    name:    u32;
    named:   bool;
    pending: bool;
}

# the locations a bind stream of `flavor` binds. `ptr` is the width of a pointer in bytes
pub fun decode_binds(a: *A.Allocator, r: *Reader, flavor: Flavor, ptr: u64) res[Table[Bind], Fail] {
    var out: Table[Bind] = table.make[Bind](a);
    val ran: err[Fail]   = run_binds(?out, r, flavor, ptr);
    if (sel ran.err) { ret res[Table[Bind], Fail].err{release_all[Bind](?out, ran.err)}; }
    ret res[Table[Bind], Fail].ok{out};
}

fun push_bind(out: *Table[Bind], m: *Machine, at: Location, unbound: bool) err[Fail] {
    if (table.count[Bind](out) >= MAX_LOCATIONS) { ret err[Fail].err{too_many(at)}; }
    var e: Bind = Bind{
        type:    m.at.type,
        ordinal: m.ordinal,
        flags:   m.flags,
        addend:  m.addend,
        name:    m.name,
        unbound: unbound,
    };
    if (!unbound) {
        e.segment = m.at.segment;
        e.offset  = m.at.offset;
    }
    val p: res[Id[Bind], Fail] = table.push[Bind](out, e);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    m.pending = false;
    ret err[Fail].ok{};
}

# a symbol set and never bound is declared for the stream alone
fun flush(out: *Table[Bind], m: *Machine, at: Location) err[Fail] {
    if (!m.pending) { ret err[Fail].ok{}; }
    ret push_bind(out, m, at, true);
}

fun bind_times(out: *Table[Bind], m: *Machine, at: Location, times: u64, skip: u64, ptr: u64) err[Fail] {
    val ok: err[Fail] = placed(?m.at, at);
    if (sel ok.err)                                            { ret ok; }
    if (!m.named)                                              { ret err[Fail].err{placed_at(fail.unsupported("bind opcode runs before a symbol is set"), at)}; }
    if (times > (MAX_LOCATIONS - table.count[Bind](out))::u64) { ret err[Fail].err{too_many(at)}; }
    var i: u64 = 0;
    for (i < times) {
        val p: err[Fail] = push_bind(out, m, at, false);
        if (sel p.err) { ret p; }
        val adv: err[Fail] = advance_pointers(?m.at, at, skip, ptr);
        if (sel adv.err) { ret adv; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the offset of the NUL-terminated name at the reader, which moves past it
fun take_name(r: *Reader) res[u32, Fail] {
    val at:    Location = reader.here(r);
    val start: usize    = r.pos;
    var i:     usize    = start;
    for (i < r.len && r.data[i] != 0) { i = i + 1; }
    if (i >= r.len)          { ret res[u32, Fail].err{placed_at(fail.truncated("symbol name is not terminated"), at)}; }
    if (start > 0xffff_ffff) { ret res[u32, Fail].err{placed_at(fail.overflow("symbol name lies past the range of an offset"), at)}; }
    r.pos = i + 1;
    ret res[u32, Fail].ok{start::u32};
}

fun ordinal_of(at: Location, v: u64) res[i64, Fail] {
    if (v > 0x7fff_ffff_ffff_ffff) { ret res[i64, Fail].err{placed_at(fail.overflow("dylib ordinal exceeds 63 bits"), at)}; }
    ret res[i64, Fail].ok{v:~i64};
}

fun run_binds(out: *Table[Bind], r: *Reader, flavor: Flavor, ptr: u64) err[Fail] {
    var m: Machine;
    if (sel flavor.lazy) { m.at.type = tables.BIND_TYPE_POINTER.value::u8; }
    for (reader.remaining(r) > 0) {
        val at: Location      = reader.here(r);
        val b:  res[u8, Fail] = reader.u8(r);
        if (sel b.err) { ret err[Fail].err{b.err}; }
        val op:  u64 = opcode(b.ok);
        val imm: u64 = immediate(b.ok);
        if (is(op, ?tables.BIND_OPCODE_DONE)) {
            if (imm != 0) { ret err[Fail].err{placed_at(fail.unsupported("DONE opcode carries an immediate"), at)}; }
            val f: err[Fail] = flush(out, ?m, at);
            if (sel f.err)        { ret f; }
            if (!sel flavor.lazy) { ret zero_tail(r); }
        }
        or (is(op, ?tables.BIND_OPCODE_SET_DYLIB_ORDINAL_IMM)) {
            m.ordinal = imm::i64;
        }
        or (is(op, ?tables.BIND_OPCODE_SET_DYLIB_ORDINAL_ULEB)) {
            val v: res[u64, Fail] = reader.uleb(r);
            if (sel v.err) { ret err[Fail].err{v.err}; }
            val o: res[i64, Fail] = ordinal_of(at, v.ok);
            if (sel o.err) { ret err[Fail].err{o.err}; }
            m.ordinal = o.ok;
        }
        or (is(op, ?tables.BIND_OPCODE_SET_DYLIB_SPECIAL_IMM)) {
            m.ordinal = 0;
            if (imm != 0) { m.ordinal = ((imm | 0xf0)::u8):~i8::i64; }
        }
        or (is(op, ?tables.BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM)) {
            val f: err[Fail] = flush(out, ?m, at);
            if (sel f.err) { ret f; }
            val n: res[u32, Fail] = take_name(r);
            if (sel n.err) { ret err[Fail].err{n.err}; }
            m.flags   = imm::u8;
            m.name    = n.ok;
            m.named   = true;
            m.pending = true;
        }
        or (is(op, ?tables.BIND_OPCODE_SET_TYPE_IMM)) {
            m.at.type = imm::u8;
        }
        or (is(op, ?tables.BIND_OPCODE_SET_ADDEND_SLEB)) {
            val v: res[i64, Fail] = reader.sleb(r);
            if (sel v.err) { ret err[Fail].err{v.err}; }
            m.addend = v.ok;
        }
        or (is(op, ?tables.BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB)) {
            val v: res[u64, Fail] = reader.uleb(r);
            if (sel v.err) { ret err[Fail].err{v.err}; }
            m.at.segment = imm::u32;
            m.at.offset  = v.ok;
            m.at.placed  = true;
        }
        or (is(op, ?tables.BIND_OPCODE_ADD_ADDR_ULEB)) {
            val v: res[u64, Fail] = reader.uleb(r);
            if (sel v.err) { ret err[Fail].err{v.err}; }
            val ok: err[Fail] = placed(?m.at, at);
            if (sel ok.err) { ret ok; }
            val adv: err[Fail] = shift(?m.at, at, v.ok);
            if (sel adv.err) { ret adv; }
        }
        or (is(op, ?tables.BIND_OPCODE_DO_BIND)) {
            val adv: err[Fail] = bind_times(out, ?m, at, 1, 0, ptr);
            if (sel adv.err) { ret adv; }
        }
        or (is(op, ?tables.BIND_OPCODE_DO_BIND_ADD_ADDR_ULEB)) {
            val v: res[u64, Fail] = reader.uleb(r);
            if (sel v.err) { ret err[Fail].err{v.err}; }
            val adv: err[Fail] = bind_times(out, ?m, at, 1, v.ok, ptr);
            if (sel adv.err) { ret adv; }
        }
        or (is(op, ?tables.BIND_OPCODE_DO_BIND_ADD_ADDR_IMM_SCALED)) {
            val adv: err[Fail] = bind_times(out, ?m, at, 1, imm * ptr, ptr);
            if (sel adv.err) { ret adv; }
        }
        or (is(op, ?tables.BIND_OPCODE_DO_BIND_ULEB_TIMES_SKIPPING_ULEB)) {
            val times: res[u64, Fail] = reader.uleb(r);
            if (sel times.err) { ret err[Fail].err{times.err}; }
            val skip: res[u64, Fail] = reader.uleb(r);
            if (sel skip.err) { ret err[Fail].err{skip.err}; }
            val adv: err[Fail] = bind_times(out, ?m, at, times.ok, skip.ok, ptr);
            if (sel adv.err) { ret adv; }
        }
        or (is(op, ?tables.BIND_OPCODE_THREADED)) {
            ret err[Fail].err{placed_at(fail.unsupported("threaded binds are not decoded"), at)};
        }
        or {
            ret err[Fail].err{placed_at(fail.unsupported("unknown bind opcode"), at)};
        }
    }
    ret flush(out, ?m, reader.here(r));
}

# the length of the NUL-terminated name at `off` in `names`
fun name_len(names: Bytes, off: u32) res[usize, Fail] {
    var i: usize = off::usize;
    for (i < names.len && names.data[i] != 0) { i = i + 1; }
    if (off::usize >= names.len || i >= names.len) { ret res[usize, Fail].err{fail.malformed("symbol name lies outside the name bytes")}; }
    ret res[usize, Fail].ok{i - off::usize};
}

fun same_name(names: Bytes, a: u32, b: u32) bool {
    if (a == b) { ret true; }
    var i: usize = 0;
    for {
        val x: u8 = names.data[a::usize + i];
        if (x != names.data[b::usize + i]) { ret false; }
        if (x == 0)                        { ret true; }
        i = i + 1;
    }
    ret false;
}

fun put_symbol(s: *Sink, names: Bytes, flags: u64, name: u32) err[Fail] {
    val w: err[Fail] = put_op(s, tables.BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM.value, flags);
    if (sel w.err) { ret w; }
    ret put_name(s, names, name);
}

fun put_name(s: *Sink, names: Bytes, off: u32) err[Fail] {
    val n: res[usize, Fail] = name_len(names, off);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    ret sink.bytes(s, ?names.data[off::usize], n.ok + 1);
}

# the ordinal as an opcode and its operand
fun put_ordinal(s: *Sink, ordinal: i64) err[Fail] {
    if (ordinal <= 0) {
        if (ordinal < -16) { ret err[Fail].err{fail.malformed("special dylib ordinal does not fit an opcode")}; }
        ret put_op(s, tables.BIND_OPCODE_SET_DYLIB_SPECIAL_IMM.value, (ordinal::u64) & NIBBLE);
    }
    if (ordinal <= NIBBLE::i64) { ret put_op(s, tables.BIND_OPCODE_SET_DYLIB_ORDINAL_IMM.value, ordinal::u64); }
    ret put_uleb_op(s, tables.BIND_OPCODE_SET_DYLIB_ORDINAL_ULEB.value, 0, ordinal::u64);
}

# the stream for `entries` in the order given, ended by DONE and zero padded
# to `align`. `names` holds the bytes the entries' name offsets index. the
# way ld64 compacts a regular or weak stream, and the way it writes a lazy
# one, entry by entry
pub fun encode_binds(s: *Sink, a: *A.Allocator, entries: *Table[Bind], names: Bytes, flavor: Flavor, ptr: u64, align: usize) err[Fail] {
    if (table.count[Bind](entries) == 0) { ret err[Fail].ok{}; }
    if (sel flavor.lazy) {
        val w: err[Fail] = emit_lazy(s, entries, names);
        if (sel w.err) { ret w; }
        ret pad(s, align);
    }
    var mid: Table[Op] = table.make[Op](a);
    val ran: err[Fail] = build_binds(?mid, entries, names, flavor, ptr);
    if (sel ran.err) { ret err[Fail].err{release_all[Op](?mid, ran.err)}; }
    compact_binds(?mid, ptr);
    val w:       err[Fail] = emit_binds(s, ?mid, names);
    val dropped: err[Fail] = table.release[Op](?mid);
    if (sel w.err)       { ret w; }
    if (sel dropped.err) { ret dropped; }
    val done: err[Fail] = sink.u8(s, tables.BIND_OPCODE_DONE.value::u8);
    if (sel done.err) { ret done; }
    ret pad(s, align);
}

fun emit_lazy(s: *Sink, entries: *Table[Bind], names: Bytes) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Bind](entries)) {
        val e: *Bind = table.at[Bind](entries, table.nth[Bind](i));
        if (e.unbound || e.type::u64 != tables.BIND_TYPE_POINTER.value || e.addend != 0) {
            ret err[Fail].err{fail.unsupported("a lazy bind is a pointer with no addend")};
        }
        if (e.segment::u64 > NIBBLE || e.flags::u64 > NIBBLE) {
            ret err[Fail].err{fail.malformed("lazy bind segment or flags do not fit an opcode")};
        }
        val w1: err[Fail] = put_uleb_op(s, tables.BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB.value, e.segment::u64, e.offset);
        if (sel w1.err) { ret w1; }
        val w2: err[Fail] = put_ordinal(s, e.ordinal);
        if (sel w2.err) { ret w2; }
        val w3: err[Fail] = put_symbol(s, names, e.flags::u64, e.name);
        if (sel w3.err) { ret w3; }
        val w4: err[Fail] = put_op(s, tables.BIND_OPCODE_DO_BIND.value, 0);
        if (sel w4.err) { ret w4; }
        val w5: err[Fail] = sink.u8(s, tables.BIND_OPCODE_DONE.value::u8);
        if (sel w5.err) { ret w5; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun push_symbol(mid: *Table[Op], flags: u8, name: u32) err[Fail] {
    if (flags::u64 > NIBBLE) { ret err[Fail].err{fail.malformed("symbol flags do not fit an opcode")}; }
    val p: res[Id[Op], Fail] = table.push[Op](mid, Op{code: tables.BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM.value, a: flags::u64, name: name});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun build_binds(mid: *Table[Op], entries: *Table[Bind], names: Bytes, flavor: Flavor, ptr: u64) err[Fail] {
    var ordinal: i64   = 0;
    var ordered: bool  = false;
    var name:    u32   = 0;
    var flags:   u8    = 0;
    var named:   bool  = false;
    var type:    u8    = 0;
    var addend:  i64   = 0;
    var segment: u32   = 0;
    var offset:  u64   = 0;
    var have:    bool  = false;
    var i:       usize = 0;
    for (i < table.count[Bind](entries)) {
        val e: *Bind = table.at[Bind](entries, table.nth[Bind](i));
        i = i + 1;
        if (e.unbound) {
            val w: err[Fail] = push_symbol(mid, e.flags, e.name);
            if (sel w.err) { ret w; }
            name  = e.name;
            flags = e.flags;
            named = true;
            cnt;
        }
        if (e.type::u64 > NIBBLE || e.segment::u64 > NIBBLE) {
            ret err[Fail].err{fail.malformed("bind type or segment does not fit an opcode")};
        }
        if (!sel flavor.weak && (!ordered || e.ordinal != ordinal)) {
            val w: err[Fail] = push_op(mid, tables.BIND_OPCODE_SET_DYLIB_ORDINAL_IMM.value, e.ordinal:~u64, 0);
            if (sel w.err) { ret w; }
            ordinal = e.ordinal;
            ordered = true;
        }
        if (!named || e.flags != flags || !same_name(names, name, e.name)) {
            val n: res[usize, Fail] = name_len(names, e.name);
            if (sel n.err) { ret err[Fail].err{n.err}; }
            val w: err[Fail] = push_symbol(mid, e.flags, e.name);
            if (sel w.err) { ret w; }
            name  = e.name;
            flags = e.flags;
            named = true;
        }
        if (e.type != type) {
            val w: err[Fail] = push_op(mid, tables.BIND_OPCODE_SET_TYPE_IMM.value, e.type::u64, 0);
            if (sel w.err) { ret w; }
            type = e.type;
        }
        if (!have || e.segment != segment) {
            val w: err[Fail] = push_op(mid, tables.BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB.value, e.segment::u64, e.offset);
            if (sel w.err) { ret w; }
        }
        or (e.offset != offset) {
            val w: err[Fail] = push_op(mid, tables.BIND_OPCODE_ADD_ADDR_ULEB.value, e.offset - offset, 0);
            if (sel w.err) { ret w; }
        }
        if (e.addend != addend) {
            val w: err[Fail] = push_op(mid, tables.BIND_OPCODE_SET_ADDEND_SLEB.value, e.addend:~u64, 0);
            if (sel w.err) { ret w; }
            addend = e.addend;
        }
        val w: err[Fail] = push_op(mid, tables.BIND_OPCODE_DO_BIND.value, 0, 0);
        if (sel w.err) { ret w; }
        have    = true;
        segment = e.segment;
        offset  = e.offset + ptr;
    }
    ret err[Fail].ok{};
}

fun compact_binds(mid: *Table[Op], ptr: u64) {
    val n:   usize = table.count[Op](mid);
    val o:   *Op   = table.items[Op](mid);
    var src: usize = 0;
    var dst: usize = 0;
    for (src < n) {
        o[dst] = o[src];
        if (o[src].code == tables.BIND_OPCODE_DO_BIND.value
            && src + 1 < n && o[src + 1].code == tables.BIND_OPCODE_ADD_ADDR_ULEB.value) {
            o[dst].code = tables.BIND_OPCODE_DO_BIND_ADD_ADDR_ULEB.value;
            o[dst].a    = o[src + 1].a;
            src         = src + 1;
        }
        src = src + 1;
        dst = dst + 1;
    }
    dst       = skip_runs(o, dst, tables.BIND_OPCODE_DO_BIND_ADD_ADDR_ULEB.value, tables.BIND_OPCODE_DO_BIND_ULEB_TIMES_SKIPPING_ULEB.value, MIN_BIND_RUN);
    mid.count = dst;
    src       = 0;
    for (src < dst) {
        if (o[src].code == tables.BIND_OPCODE_DO_BIND_ADD_ADDR_ULEB.value && scalable(o[src].a, ptr)) {
            o[src].code = tables.BIND_OPCODE_DO_BIND_ADD_ADDR_IMM_SCALED.value;
            o[src].a    = o[src].a / ptr;
        }
        src = src + 1;
    }
}

fun emit_binds(s: *Sink, mid: *Table[Op], names: Bytes) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Op](mid)) {
        val o: *Op       = table.at[Op](mid, table.nth[Op](i));
        var w: err[Fail] = err[Fail].ok{};
        if (o.code == tables.BIND_OPCODE_SET_DYLIB_ORDINAL_IMM.value) { w = put_ordinal(s, o.a:~i64); }
        or (o.code == tables.BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM.value) {
            w = put_symbol(s, names, o.a, o.name);
        }
        or (o.code == tables.BIND_OPCODE_SET_TYPE_IMM.value) { w = put_op(s, o.code, o.a); }
        or (o.code == tables.BIND_OPCODE_SET_ADDEND_SLEB.value) {
            w = put_sleb_op(s, o.code, o.a:~i64);
        }
        or (o.code == tables.BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB.value)      { w = put_uleb_op(s, o.code, o.a, o.b); }
        or (o.code == tables.BIND_OPCODE_ADD_ADDR_ULEB.value)                    { w = put_uleb_op(s, o.code, 0, o.a); }
        or (o.code == tables.BIND_OPCODE_DO_BIND.value)                          { w = put_op(s, o.code, 0); }
        or (o.code == tables.BIND_OPCODE_DO_BIND_ADD_ADDR_ULEB.value)            { w = put_uleb_op(s, o.code, 0, o.a); }
        or (o.code == tables.BIND_OPCODE_DO_BIND_ADD_ADDR_IMM_SCALED.value)      { w = put_op(s, o.code, o.a); }
        or (o.code == tables.BIND_OPCODE_DO_BIND_ULEB_TIMES_SKIPPING_ULEB.value) { w = put_uleb2_op(s, o.code, o.a, o.b); }
        if (sel w.err)                                                           { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun done(e: err[Fail]) bool {
    ret sel e.ok;
}

fun add_rebase(t: *Table[Rebase], segment: u32, offset: u64, type: u8) bool {
    val p: res[Id[Rebase], Fail] = table.push[Rebase](t, Rebase{segment: segment, offset: offset, type: type});
    ret sel p.ok;
}

fun add_bind(t: *Table[Bind], segment: u32, offset: u64, ordinal: i64, name: u32, flags: u8, addend: i64) bool {
    val p: res[Id[Bind], Fail] = table.push[Bind](t, Bind{segment: segment, offset: offset, type: 1, ordinal: ordinal, flags: flags, addend: addend, name: name});
    ret sel p.ok;
}

fun same_rebases(a: *Table[Rebase], b: *Table[Rebase]) bool {
    if (table.count[Rebase](a) != table.count[Rebase](b)) { ret false; }
    var i: usize = 0;
    for (i < table.count[Rebase](a)) {
        val x: *Rebase = table.at[Rebase](a, table.nth[Rebase](i));
        val y: *Rebase = table.at[Rebase](b, table.nth[Rebase](i));
        if (x.segment != y.segment || x.offset != y.offset || x.type != y.type) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the entries agree and each name is the same text in its own bytes
fun same_binds(a: *Table[Bind], an: Bytes, b: *Table[Bind], bn: Bytes) bool {
    if (table.count[Bind](a) != table.count[Bind](b)) { ret false; }
    var i: usize = 0;
    for (i < table.count[Bind](a)) {
        val x: *Bind = table.at[Bind](a, table.nth[Bind](i));
        val y: *Bind = table.at[Bind](b, table.nth[Bind](i));
        if (x.unbound != y.unbound || x.flags != y.flags || x.name::usize >= an.len || y.name::usize >= bn.len)                                   { ret false; }
        if (!x.unbound && (x.segment != y.segment || x.offset != y.offset || x.type != y.type || x.ordinal != y.ordinal || x.addend != y.addend)) { ret false; }
        var k: usize = 0;
        for {
            if (an.data[x.name::usize + k] != bn.data[y.name::usize + k]) { ret false; }
            if (an.data[x.name::usize + k] == 0)                          { brk; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun same_bytes(a: *Sink, b: *Sink) bool {
    if (sink.len(a) != sink.len(b)) { ret false; }
    var i: usize = 0;
    for (i < sink.len(a)) {
        if (sink.data(a)[i] != sink.data(b)[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a stream decodes to the entries it was made of and encodes to the same bytes
fun binds_round_trip(a: *A.Allocator, entries: *Table[Bind], names: Bytes, flavor: Flavor) bool {
    var first: Sink      = sink.make(a, LITTLE);
    val e1:    err[Fail] = encode_binds(?first, a, entries, names, flavor, 8, 8);
    if (sel e1.err) { ret false; }
    var r: Reader                 = reader.make("t", sink.data(?first), sink.len(?first), LITTLE);
    val d: res[Table[Bind], Fail] = decode_binds(a, ?r, flavor, 8);
    if (sel d.err) { ret false; }
    var back:   Table[Bind] = d.ok;
    var second: Sink        = sink.make(a, LITTLE);
    val stream: Bytes       = Bytes{data: sink.data(?first), len: sink.len(?first)};
    val e2:     err[Fail]   = encode_binds(?second, a, ?back, stream, flavor, 8, 8);
    var ok:     bool        = !(sel e2.err) && same_binds(entries, names, ?back, stream) && same_bytes(?first, ?second);
    val r1:     err[Fail]   = table.release[Bind](?back);
    val r2:     err[Fail]   = sink.release(?first);
    val r3:     err[Fail]   = sink.release(?second);
    ret ok && !(sel r1.err) && !(sel r2.err) && !(sel r3.err);
}

test opcode__rebase_and_bind_streams_round_trip {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    var rebases: Table[Rebase] = table.make[Rebase](a);
    var i:       u64           = 0;
    for (i < 3) {
        if (!add_rebase(?rebases, 2, 0x10 + i * 8, 1)) { ret 1; }
        i = i + 1;
    }
    if (!add_rebase(?rebases, 2, 0x40, 1)) { ret 1; }
    i = 0;
    for (i < 20) {
        if (!add_rebase(?rebases, 2, 0x100 + i * 8, 1)) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < 4) {
        if (!add_rebase(?rebases, 2, 0x300 + i * 16, 1)) { ret 1; }
        i = i + 1;
    }
    if (!add_rebase(?rebases, 3, 0x8, 1) || !add_rebase(?rebases, 3, 0x20, 3)) { ret 1; }

    var s: Sink = sink.make(a, LITTLE);
    if (!done(encode_rebases(?s, a, ?rebases, 8, 8))) { ret 1; }
    var r: Reader                   = reader.make("t", sink.data(?s), sink.len(?s), LITTLE);
    val d: res[Table[Rebase], Fail] = decode_rebases(a, ?r, 8);
    if (sel d.err) { ret 1; }
    var back:  Table[Rebase] = d.ok;
    var again: Sink          = sink.make(a, LITTLE);
    if (!done(encode_rebases(?again, a, ?back, 8, 8)))             { ret 1; }
    if (!same_rebases(?rebases, ?back) || !same_bytes(?s, ?again)) { ret 1; }

    var small: Table[Rebase] = table.make[Rebase](a);
    var gold:  Sink          = sink.make(a, LITTLE);
    if (!add_rebase(?small, 2, 0x10, 1) || !add_rebase(?small, 2, 0x18, 1) || !add_rebase(?small, 2, 0x20, 1)) { ret 1; }
    if (!done(encode_rebases(?gold, a, ?small, 8, 8)))                                                         { ret 1; }
    val want: [8]u8 = [8]u8{0x11, 0x22, 0x10, 0x53, 0x00, 0x00, 0x00, 0x00};
    if (sink.len(?gold) != 8) { ret 1; }
    i = 0;
    for (i < 8) {
        if (sink.data(?gold)[i::usize] != want[i::usize]) { ret 1; }
        i = i + 1;
    }

    val text:  [14]u8      = [14]u8{'_', 'a', 0, '_', 'b', 0, '_', 'c', 0, '_', 'd', 'd', 0, 0};
    val names: Bytes       = Bytes{data: ?text[0], len: 14};
    var binds: Table[Bind] = table.make[Bind](a);
    if (!add_bind(?binds, 2, 0x10, 1, 0, 0, 0) || !add_bind(?binds, 2, 0x18, 1, 0, 0, 0))   { ret 1; }
    if (!add_bind(?binds, 2, 0x40, 2, 3, 1, 0) || !add_bind(?binds, 2, 0x20, 2, 3, 1, 7))   { ret 1; }
    if (!add_bind(?binds, 2, 0x28, 17, 6, 0, -9) || !add_bind(?binds, 3, 0x0, -2, 9, 0, 0)) { ret 1; }
    i = 0;
    for (i < 4) {
        if (!add_bind(?binds, 3, 0x100 + i * 16, 0, 6, 0, 0)) { ret 1; }
        i = i + 1;
    }
    if (!binds_round_trip(a, ?binds, names, Flavor.regular{})) { ret 1; }

    var lazy: Table[Bind] = table.make[Bind](a);
    if (!add_bind(?lazy, 2, 0x10, 1, 0, 0, 0) || !add_bind(?lazy, 2, 0x18, 20, 3, 1, 0) || !add_bind(?lazy, 2, 0x20, -3, 6, 0, 0)) { ret 1; }
    if (!binds_round_trip(a, ?lazy, names, Flavor.lazy{}))                                                                         { ret 1; }

    var weak:   Table[Bind]         = table.make[Bind](a);
    val strong: Bind                = Bind{name: 9, flags: 8, unbound: true};
    val w:      res[Id[Bind], Fail] = table.push[Bind](?weak, strong);
    if (sel w.err)                                                                                                               { ret 1; }
    if (!add_bind(?weak, 2, 0x10, 0, 0, 0, 0) || !add_bind(?weak, 2, 0x18, 0, 0, 0, 0) || !add_bind(?weak, 2, 0x20, 0, 3, 0, 0)) { ret 1; }
    if (!binds_round_trip(a, ?weak, names, Flavor.weak{}))                                                                       { ret 1; }

    val rel:  err[Fail] = table.release[Rebase](?rebases);
    val rel2: err[Fail] = table.release[Rebase](?back);
    val rel3: err[Fail] = table.release[Rebase](?small);
    val rel4: err[Fail] = table.release[Bind](?binds);
    val rel5: err[Fail] = table.release[Bind](?lazy);
    val rel6: err[Fail] = table.release[Bind](?weak);
    val rel7: err[Fail] = sink.release(?s);
    val rel8: err[Fail] = sink.release(?again);
    val rel9: err[Fail] = sink.release(?gold);
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test opcode__refuses_a_uleb_that_overflows_64_bits {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);

    val bytes: [12]u8                   = [12]u8{0x21, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x01};
    var r:     Reader                   = reader.make("t", ?bytes[0], 12, LITTLE);
    val d:     res[Table[Rebase], Fail] = decode_rebases(a, ?r, 8);
    if (sel d.ok)                   { ret 1; }
    if (!sel d.err.cause.malformed) { ret 1; }
    if (T.live_count(?t) != 0)      { ret 1; }
    T.dnit(?t);
    ret 0;
}
