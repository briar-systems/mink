# the bytes a model holds
#
# a model holds bytes one way: borrowed from an input that outlives it, or
# owned in its store. owned bytes are named by their place in the store, so
# they stay valid as the store grows.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.lib.buffer;
use mink.lib.buffer.Buffer;
use mink.lib.fail.Fail;

# bytes borrowed from an input
pub rec Bytes {
    data: *u8;
    len:  usize;
}

# bytes in a store
pub rec Span {
    start: usize;
    len:   usize;
}

# bytes a model holds
# ---
# borrowed: bytes of an input
# owned:    bytes in the model's store
pub tag Held: u8 {
    borrowed: Bytes;
    owned:    Span;
}

pub rec Store {
    bytes: Buffer;
}

pub fun make(a: *A.Allocator) Store {
    ret Store{bytes: buffer.make(a)};
}

# a copy of the `n` bytes at `p` the store owns
pub fun own(s: *Store, p: *u8, n: usize) res[Held, Fail] {
    val start: res[usize, Fail] = buffer.extend(?s.bytes, p, n);
    if (sel start.err) { ret res[Held, Fail].err{start.err}; }
    ret res[Held, Fail].ok{Held.owned{Span{start: start.ok, len: n}}};
}

# the bytes of `h`. owned bytes stay valid until the store next owns bytes
pub fun bytes(s: *Store, h: *Held) Bytes {
    if (sel h.borrowed) { ret h.borrowed; }
    ret Bytes{data: buffer.at(?s.bytes, h.owned.start), len: h.owned.len};
}

pub fun release(s: *Store) err[Fail] {
    ret buffer.release(?s.bytes);
}
