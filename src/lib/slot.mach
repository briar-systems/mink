# where a field lies in a fixed record
#
# a format's shape tables name each field of a record by its slot, so one
# record layout serves every class and byte order of the format.

use std.encoding.binary;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;

use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.reader.Order;

# where a field lies in its record. a width of zero is a field the record
# does not have
pub rec Slot {
    offset: u8;
    width:  u8;
}

# the field `s` of the record at `p`, in `order`
pub fun field(p: *u8, s: Slot, order: Order) u64 {
    if (s.width == 0) { ret 0; }
    ret binary.get_uint(?p[s.offset::usize], s.width::usize, order);
}

# set the field `s` of the record at `p` to the low bytes of `v`, in `order`
pub fun set_field(p: *u8, s: Slot, order: Order, v: u64) {
    if (s.width == 0) { ret; }
    binary.put_uint(?p[s.offset::usize], v, s.width::usize, order);
}

# the fields of one record being written, the first refusal kept
pub rec Cell {
    p:     *u8;
    order: Order;
    bad:   bool;
    first: Fail;
}

pub fun cell(p: *u8, order: Order) Cell {
    ret Cell{p: p, order: order};
}

# set the field `s` to `v`, refusing a value its width cannot hold
pub fun put(w: *Cell, s: Slot, v: u64) {
    if (w.bad) { ret; }
    if (s.width == 0) {
        if (v != 0) {
            w.first = fail.overflow("value in a field the class does not have");
            w.bad   = true;
        }
        ret;
    }
    if (s.width < 8 && (v >> (s.width::u64 * 8)) != 0) {
        w.first = fail.overflow("value exceeds the width of its field");
        w.bad   = true;
        ret;
    }
    set_field(w.p, s, w.order, v);
}

pub fun put_signed(w: *Cell, s: Slot, v: i64) {
    if (w.bad) { ret; }
    if (s.width == 0 || s.width == 8) {
        put(w, s, v:~u64);
        ret;
    }
    val bound: i64 = 1::i64 << (s.width::i64 * 8 - 1);
    if (v < 0 - bound || v >= bound) {
        w.first = fail.overflow("value exceeds the width of its field");
        w.bad   = true;
        ret;
    }
    put(w, s, (v:~u64) & ((1::u64 << (s.width::u64 * 8)) - 1));
}

# the first refusal of the record `index` of `record`, or ok
pub fun done(w: *Cell, record: str, index: u64) err[Fail] {
    if (w.bad) { ret err[Fail].err{fail.in_indexed(w.first, record, index)}; }
    ret err[Fail].ok{};
}
