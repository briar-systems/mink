# the contract every format module fills
#
# a format is one module and one registration. the module owns its complete
# model, which holds every byte of an input so a read and a write give back
# the same bytes, and reaches the rest of mink only through its registration:
# the operations below, the magic that identifies its files, the revision of
# each specification it implements and the names its dump prints.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.lib.catalog.format.Format;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;
use mink.lib.format.dump;
use mink.lib.format.dump.Dumper;
use mink.lib.model.object.Object;
use mink.lib.sink.Sink;

# an input: its name, for every failure, and its bytes, borrowed for as long
# as any model read from it lives
pub rec Input {
    file: str;
    data: *u8;
    len:  usize;
}

# the bytes at `offset` that identify a format's files, compared under `mask`,
# where a nil mask compares every bit
pub rec Magic {
    offset: usize;
    bytes:  *u8;
    mask:   *u8;
    len:    usize;
}

# the exact revision of one specification a format implements
pub rec Revision {
    spec:     str;
    revision: str;
}

# what a format module does, over its own model behind an opaque pointer
# ---
# read:         parse an input into a model, refusing what the specification
#               forbids with a located failure
# write:        lay a model out through the layout plan and return its bytes,
#               in a sink the format builds in its own byte order
# dump:         describe a model, field by field in model order
# to_neutral:   add what a model holds to a neutral object
# from_neutral: build a model from a neutral object
# locate:       the model record holding byte `offset` of the bytes the model
#               reads and writes, its offset placed, and a nil record for an
#               offset no record covers
# release:      give back everything a model owns
pub rec Ops {
    read:         fun(*A.Allocator, *Input) res[ptr, Fail];
    write:        fun(*A.Allocator, ptr) res[Sink, Fail];
    dump:         fun(ptr, *Dumper) err[Fail];
    to_neutral:   fun(ptr, *Object) err[Fail];
    from_neutral: fun(*A.Allocator, *Object) res[ptr, Fail];
    locate:       fun(ptr, u64) Location;
    release:      fun(*A.Allocator, ptr) err[Fail];
}

# format:         the format's identity row
# ops:            what the module does
# magics:         every magic that identifies its files
# magic_count:    how many
# revisions:      the specifications it implements, at their exact revision
# revision_count: how many
# fields:         the names its dump prints, indexed by the module's own field keys
# field_count:    how many
pub rec Registration {
    format:         *Format;
    ops:            Ops;
    magics:         *Magic;
    magic_count:    usize;
    revisions:      *Revision;
    revision_count: usize;
    fields:         *str;
    field_count:    usize;
}

# a model read or built by a registered format
# ---
# reg:  the format it belongs to
# a:    the allocator it lives in
# data: the format's own model
pub rec Model {
    reg:  *Registration;
    a:    *A.Allocator;
    data: ptr;
}

pub fun write(m: *Model) res[Sink, Fail] {
    ret m.reg.ops.write(m.a, m.data);
}

# the dump of `m`, appended to `out`
pub fun describe(m: *Model, out: *Sink) err[Fail] {
    var d: Dumper = dump.make(out, m.reg.fields, m.reg.field_count);
    ret m.reg.ops.dump(m.data, ?d);
}

# where in `m` byte `offset` falls
pub fun locate(m: *Model, offset: u64) Location {
    ret m.reg.ops.locate(m.data, offset);
}

pub fun to_neutral(m: *Model, o: *Object) err[Fail] {
    ret m.reg.ops.to_neutral(m.data, o);
}

pub fun release(m: *Model) err[Fail] {
    val data: ptr = m.data;
    m.data = nil;
    if (data == nil) { ret err[Fail].ok{}; }
    ret m.reg.ops.release(m.a, data);
}
