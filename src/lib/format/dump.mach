# the text form of any format's model
#
# a format's dump walks its model in model order and names each field by a
# key into the format's own field table, so the names can follow what
# llvm-readobj prints. records nest as `Name {` ... `}`, one field per line,
# indented two spaces a level. names are quoted with every byte outside
# printable ascii, and every quote and backslash, written as an escape.

use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use T: std.allocator.testing;
use std.memory;

use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.reader.LITTLE;
use mink.lib.sink;
use mink.lib.sink.Sink;

# out:         where the text goes
# fields:      the format's field names, by key
# field_count: how many
# depth:       how many records are open
pub rec Dumper {
    out:         *Sink;
    fields:      *str;
    field_count: usize;
    depth:       usize;
}

pub fun make(out: *Sink, fields: *str, field_count: usize) Dumper {
    ret Dumper{out: out, fields: fields, field_count: field_count};
}

# open a record named by `key`
pub fun open(d: *Dumper, key: u32) err[Fail] {
    val wl: err[Fail] = lead(d, key);
    if (sel wl.err) { ret wl; }
    d.depth = d.depth + 1;
    ret sink.text(d.out, " {\n");
}

# open a record named by `prefix` and the `n` bytes at `p`, `prefix NAME {`
pub fun open_labelled(d: *Dumper, prefix: str, p: *u8, n: usize) err[Fail] {
    val wi: err[Fail] = indent(d);
    if (sel wi.err) { ret wi; }
    val wp: err[Fail] = sink.text(d.out, prefix);
    if (sel wp.err) { ret wp; }
    val wb: err[Fail] = sink.bytes(d.out, p, n);
    if (sel wb.err) { ret wb; }
    d.depth = d.depth + 1;
    ret sink.text(d.out, " {\n");
}

# close the innermost record
pub fun close(d: *Dumper) err[Fail] {
    if (d.depth == 0) { ret err[Fail].err{fail.internal("dump closes a record it never opened")}; }
    d.depth = d.depth - 1;
    val wi: err[Fail] = indent(d);
    if (sel wi.err) { ret wi; }
    ret sink.text(d.out, "}\n");
}

# open a list named by `key`, `Key [`, whose items follow one per line
pub fun open_list(d: *Dumper, key: u32) err[Fail] {
    val wl: err[Fail] = lead(d, key);
    if (sel wl.err) { ret wl; }
    d.depth = d.depth + 1;
    ret sink.text(d.out, " [\n");
}

# open a list named by `key` that carries a value, `Key [ (0x..)`
pub fun open_valued_list(d: *Dumper, key: u32, v: u64) err[Fail] {
    val wl: err[Fail] = lead(d, key);
    if (sel wl.err) { ret wl; }
    d.depth = d.depth + 1;
    val wp: err[Fail] = sink.text(d.out, " [ (");
    if (sel wp.err) { ret wp; }
    val wv: err[Fail] = hex_value(d, v);
    if (sel wv.err) { ret wv; }
    ret sink.text(d.out, ")\n");
}

# open a nested level without a record of its own, for a caller that writes its
# own lead line and closes it with close_list
pub fun nest(d: *Dumper) {
    d.depth = d.depth + 1;
}

# open a block named by `key`, `Key (`, whose lines follow one per line
pub fun open_block(d: *Dumper, key: u32) err[Fail] {
    val wl: err[Fail] = lead(d, key);
    if (sel wl.err) { ret wl; }
    d.depth = d.depth + 1;
    ret sink.text(d.out, " (\n");
}

# close the innermost block
pub fun close_block(d: *Dumper) err[Fail] {
    if (d.depth == 0) { ret err[Fail].err{fail.internal("dump closes a block it never opened")}; }
    d.depth = d.depth - 1;
    val wi: err[Fail] = indent(d);
    if (sel wi.err) { ret wi; }
    ret sink.text(d.out, ")\n");
}

# the indentation of a line the caller writes itself, inside a block or a list
pub fun row(d: *Dumper) err[Fail] {
    ret indent(d);
}

# close the innermost list
pub fun close_list(d: *Dumper) err[Fail] {
    if (d.depth == 0) { ret err[Fail].err{fail.internal("dump closes a list it never opened")}; }
    d.depth = d.depth - 1;
    val wi: err[Fail] = indent(d);
    if (sel wi.err) { ret wi; }
    ret sink.text(d.out, "]\n");
}

# one item of a list, `Name (0x..)`, the name as the caller spells it
pub fun item(d: *Dumper, name: str, v: u64) err[Fail] {
    val wi: err[Fail] = indent(d);
    if (sel wi.err) { ret wi; }
    val wn: err[Fail] = sink.text(d.out, name);
    if (sel wn.err) { ret wn; }
    val wp: err[Fail] = sink.text(d.out, " (");
    if (sel wp.err) { ret wp; }
    val wv: err[Fail] = hex_value(d, v);
    if (sel wv.err) { ret wv; }
    ret sink.text(d.out, ")\n");
}

pub fun decimal(d: *Dumper, key: u32, v: u64) err[Fail] {
    val wl: err[Fail] = field(d, key);
    if (sel wl.err) { ret wl; }
    val wn: err[Fail] = sink.number(d.out, v, 10);
    if (sel wn.err) { ret wn; }
    ret sink.text(d.out, "\n");
}

pub fun signed(d: *Dumper, key: u32, v: i64) err[Fail] {
    val wl: err[Fail] = field(d, key);
    if (sel wl.err) { ret wl; }
    var mag: u64 = v::u64;
    if (v < 0) {
        val wm: err[Fail] = sink.text(d.out, "-");
        if (sel wm.err) { ret wm; }
        mag = ~(v::u64) + 1;
    }
    val wn: err[Fail] = sink.number(d.out, mag, 10);
    if (sel wn.err) { ret wn; }
    ret sink.text(d.out, "\n");
}

pub fun hex(d: *Dumper, key: u32, v: u64) err[Fail] {
    val wl: err[Fail] = field(d, key);
    if (sel wl.err) { ret wl; }
    val wv: err[Fail] = hex_value(d, v);
    if (sel wv.err) { ret wv; }
    ret sink.text(d.out, "\n");
}

# one single-bit constant `name` of `bit`, printed when `rest` holds its bit and
# cleared from `rest`. a multi-bit constant is a mask, not a flag, and is skipped
pub fun flag(d: *Dumper, rest: *u64, bit: u64, name: str) err[Fail] {
    if (bit == 0 || (bit & (bit - 1)) != 0 || (@rest & bit) == 0) { ret err[Fail].ok{}; }
    val w1: err[Fail] = text(d, name);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = text(d, " ");
    if (sel w2.err) { ret w2; }
    @rest = @rest & ~bit;
    ret err[Fail].ok{};
}

# the bits `rest` keeps after the flags named, then the whole value `v`, closing
# a flags field whose lead `field` printed
pub fun flags_rest(d: *Dumper, rest: u64, v: u64) err[Fail] {
    if (rest != 0) {
        val w1: err[Fail] = hex_value(d, rest);
        if (sel w1.err) { ret w1; }
        val w2: err[Fail] = text(d, " ");
        if (sel w2.err) { ret w2; }
    }
    val w3: err[Fail] = text(d, "(");
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = hex_value(d, v);
    if (sel w4.err) { ret w4; }
    ret text(d, ")\n");
}

# a number that prints its name before it, `Key: NAME (0x..)`, or `Key: 0x..`
# when it has none
pub fun named(d: *Dumper, key: u32, v: u64, name: opt[str]) err[Fail] {
    val wl: err[Fail] = field(d, key);
    if (sel wl.err) { ret wl; }
    if (sel name.some) {
        val wn: err[Fail] = sink.text(d.out, name.some);
        if (sel wn.err) { ret wn; }
        val wp: err[Fail] = sink.text(d.out, " (");
        if (sel wp.err) { ret wp; }
        val wv: err[Fail] = hex_value(d, v);
        if (sel wv.err) { ret wv; }
        ret sink.text(d.out, ")\n");
    }
    val wv: err[Fail] = hex_value(d, v);
    if (sel wv.err) { ret wv; }
    ret sink.text(d.out, "\n");
}

# a number with the bytes `label` before it, `Key: LABEL (N)`, for a value
# that names a string of the file
pub fun labelled(d: *Dumper, key: u32, v: u64, label: *u8, n: usize) err[Fail] {
    val wl: err[Fail] = field(d, key);
    if (sel wl.err) { ret wl; }
    val wb: err[Fail] = sink.bytes(d.out, label, n);
    if (sel wb.err) { ret wb; }
    val wp: err[Fail] = sink.text(d.out, " (");
    if (sel wp.err) { ret wp; }
    val wn: err[Fail] = sink.number(d.out, v, 10);
    if (sel wn.err) { ret wn; }
    ret sink.text(d.out, ")\n");
}

# the `n` bytes at `p` as one run of hex digits, no separators
pub fun digits(d: *Dumper, key: u32, p: *u8, n: usize) err[Fail] {
    val wl: err[Fail] = field(d, key);
    if (sel wl.err) { ret wl; }
    var i: usize = 0;
    for (i < n) {
        val wb: err[Fail] = digits2(d.out, p[i]);
        if (sel wb.err) { ret wb; }
        i = i + 1;
    }
    ret sink.text(d.out, "\n");
}

# the `n` bytes at `p` as a value, unquoted, for a name a format prints as it is
pub fun string(d: *Dumper, key: u32, p: *u8, n: usize) err[Fail] {
    val wl: err[Fail] = field(d, key);
    if (sel wl.err) { ret wl; }
    val wb: err[Fail] = sink.bytes(d.out, p, n);
    if (sel wb.err) { ret wb; }
    ret sink.text(d.out, "\n");
}

# the `n` bytes at `p`, as they are and with no key or line end
pub fun raw(d: *Dumper, p: *u8, n: usize) err[Fail] {
    ret sink.bytes(d.out, p, n);
}

# one byte of text, as it is
pub fun char(d: *Dumper, c: u8) err[Fail] {
    ret sink.u8(d.out, c);
}

# `v` in decimal, with no key or line end
pub fun decimal_value(d: *Dumper, v: u64) err[Fail] {
    ret sink.number(d.out, v, 10);
}

# the text `t`, as it is, for a value a format prints by hand
pub fun text(d: *Dumper, t: str) err[Fail] {
    ret sink.text(d.out, t);
}

# `v` in hexadecimal with its 0x prefix, and no key or line end
pub fun hex_value(d: *Dumper, v: u64) err[Fail] {
    val wp: err[Fail] = sink.text(d.out, "0x");
    if (sel wp.err) { ret wp; }
    ret sink.number(d.out, v, 16);
}

# the `n` bytes at `p` as a quoted, escaped name
pub fun name(d: *Dumper, key: u32, p: *u8, n: usize) err[Fail] {
    val wl: err[Fail] = field(d, key);
    if (sel wl.err) { ret wl; }
    val wq: err[Fail] = sink.text(d.out, "\"");
    if (sel wq.err) { ret wq; }
    var i: usize = 0;
    for (i < n) {
        val we: err[Fail] = escaped(d.out, p[i]);
        if (sel we.err) { ret we; }
        i = i + 1;
    }
    ret sink.text(d.out, "\"\n");
}

# the `n` bytes at `p` as space-separated hex pairs
pub fun bytes(d: *Dumper, key: u32, p: *u8, n: usize) err[Fail] {
    val wl: err[Fail] = field(d, key);
    if (sel wl.err) { ret wl; }
    val wo: err[Fail] = sink.text(d.out, "(");
    if (sel wo.err) { ret wo; }
    var i: usize = 0;
    for (i < n) {
        val wb: err[Fail] = pair(d.out, p[i]);
        if (sel wb.err) { ret wb; }
        i = i + 1;
    }
    ret sink.text(d.out, " )\n");
}

# indentation and `Name: `, the lead of a field whose value the caller prints
pub fun field(d: *Dumper, key: u32) err[Fail] {
    val wl: err[Fail] = lead(d, key);
    if (sel wl.err) { ret wl; }
    ret sink.text(d.out, ": ");
}

# indentation and the name of `key`
fun lead(d: *Dumper, key: u32) err[Fail] {
    if (key::usize >= d.field_count) {
        ret err[Fail].err{fail.internal("dump names a field outside the format's field table")};
    }
    val wi: err[Fail] = indent(d);
    if (sel wi.err) { ret wi; }
    val wn: err[Fail] = sink.text(d.out, d.fields[key]);
    if (sel wn.err) { ret wn; }
    ret err[Fail].ok{};
}

fun indent(d: *Dumper) err[Fail] {
    var i: usize = 0;
    for (i < d.depth) {
        val w: err[Fail] = sink.text(d.out, "  ");
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun escaped(out: *Sink, b: u8) err[Fail] {
    if (b == '"' || b == '\\') {
        val w: err[Fail] = sink.u8(out, '\\');
        if (sel w.err) { ret w; }
        ret sink.u8(out, b);
    }
    if (b >= 0x20 && b < 0x7f) { ret sink.u8(out, b); }
    val wx: err[Fail] = sink.text(out, "\\x");
    if (sel wx.err) { ret wx; }
    ret digits2(out, b);
}

fun pair(out: *Sink, b: u8) err[Fail] {
    val ws: err[Fail] = sink.u8(out, ' ');
    if (sel ws.err) { ret ws; }
    ret digits2(out, b);
}

# `b` as two lowercase hex digits
fun digits2(out: *Sink, b: u8) err[Fail] {
    val hi: err[Fail] = sink.u8(out, nibble(b >> 4));
    if (sel hi.err) { ret hi; }
    ret sink.u8(out, nibble(b & 0xf));
}

fun nibble(v: u8) u8 {
    if (v < 10) { ret '0' + v; }
    ret 'a' + v - 10;
}

test dump__prints_fields_in_model_order_with_escaping {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var out:    Sink   = sink.make(T.allocator_of(?t), LITTLE);
    val fields: [5]str = [5]str{"Header", "Name", "Size", "Bytes", "Delta"};
    var d:      Dumper = make(?out, ?fields[0], 5);
    val raw:    [4]u8  = [4]u8{'a', '"', 0x7f, 0};

    val w0: err[Fail] = open(?d, 0);
    if (sel w0.err) { ret 1; }
    val w1: err[Fail] = name(?d, 1, ?raw[0], 4);
    if (sel w1.err) { ret 1; }
    val w2: err[Fail] = hex(?d, 2, 0x40);
    if (sel w2.err) { ret 1; }
    val w3: err[Fail] = bytes(?d, 3, ?raw[0], 2);
    if (sel w3.err) { ret 1; }
    val w4: err[Fail] = signed(?d, 4, -3);
    if (sel w4.err) { ret 1; }
    val w5: err[Fail] = close(?d);
    if (sel w5.err) { ret 1; }
    val past: err[Fail] = decimal(?d, 9, 1);
    if (sel past.ok) { ret 1; }

    val want: str   = "Header {\n  Name: \"a\\\"\\x7f\\x00\"\n  Size: 0x40\n  Bytes: ( 61 22 )\n  Delta: -3\n}\n";
    val n:    usize = 77;
    if (sink.len(?out) != n)                                   { ret 1; }
    if (!memory.raw_equal(sink.data(?out)::ptr, want::ptr, n)) { ret 1; }
    val rel: err[Fail] = sink.release(?out);
    if (sel rel.err) { ret 1; }
    T.dnit(?t);
    ret 0;
}
