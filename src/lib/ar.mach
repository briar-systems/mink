# the archive format
#
# one registration for every archive variant a linker meets: System V and GNU,
# BSD and darwin, GNU thin and Windows. an archive is a container whose
# members convert through their own formats, so it has no neutral form.

use std.types.error.err;
use std.types.result.res;

use A: std.allocator;

use mink.lib.ar.dump;
use mink.lib.ar.model;
use mink.lib.ar.model.Archive;
use mink.lib.ar.read;
use mink.lib.ar.write;
use mink.lib.catalog.format;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;
use mink.lib.format.contract.Input;
use mink.lib.format.contract.Magic;
use mink.lib.format.contract.Ops;
use mink.lib.format.contract.Registration;
use mink.lib.format.contract.Revision;
use mink.lib.format.dump.Dumper;
use mink.lib.model.object.Object;
use mink.lib.sink.Sink;

val MAGICS: [2]Magic = [2]Magic{
    Magic{offset: 0, bytes: ?model.MAGIC_ARCH[0], len: 8},
    Magic{offset: 0, bytes: ?model.MAGIC_THIN[0], len: 8},
};

val REVISIONS: [3]Revision = [3]Revision{
    Revision{spec: "System V and GNU ar archive, as GNU ar writes it", revision: "binutils 2.47"},
    Revision{spec: "BSD and darwin ar archive, as llvm-ar writes it", revision: "LLVM 23.1.1"},
    Revision{spec: "Microsoft PE Format, Archive (Library) File Format", revision: "2026-09-10"},
};

pub val REGISTRATION: Registration = Registration{
    format: ?format.AR,
    ops:    Ops{
        read:         read_ops,
        write:        write_ops,
        dump:         dump_ops,
        to_neutral:   to_neutral,
        from_neutral: from_neutral,
        locate:       locate,
        release:      release_ops,
    },
    magics:         ?MAGICS[0],
    magic_count:    2,
    revisions:      ?REVISIONS[0],
    revision_count: 3,
    fields:         ?dump.FIELDS[0],
    field_count:    dump.FIELD_COUNT,
};

fun read_ops(a: *A.Allocator, in: *Input) res[ptr, Fail] {
    val m: res[*Archive, Fail] = read.read(a, in);
    if (sel m.err) { ret res[ptr, Fail].err{m.err}; }
    ret res[ptr, Fail].ok{m.ok::ptr};
}

fun write_ops(a: *A.Allocator, m: ptr) res[Sink, Fail] {
    ret write.write(a, m::*Archive);
}

fun dump_ops(m: ptr, d: *Dumper) err[Fail] {
    ret dump.describe(m::*Archive, d);
}

fun to_neutral(m: ptr, o: *Object) err[Fail] {
    ret err[Fail].err{fail.unsupported("an archive is a container, its members convert through their own formats")};
}

fun from_neutral(a: *A.Allocator, o: *Object) res[ptr, Fail] {
    ret res[ptr, Fail].err{fail.unsupported("an archive is a container, its members convert through their own formats")};
}

fun locate(m: ptr, offset: u64) Location {
    ret model.locate(m::*Archive, offset);
}

fun release_ops(a: *A.Allocator, m: ptr) err[Fail] {
    val arch: *Archive     = m::*Archive;
    val r:    err[Fail]    = model.release(arch);
    val d:    err[A.Error] = A.deallocate[Archive](a, arch, 1);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    ret err[Fail].ok{};
}
