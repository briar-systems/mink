# the neutral object, the form the linker works in
#
# every format converts its own model to and from this one, and every
# producer hands mink an object in this form. it is shaped against the union
# of the formats: no field is named after one, and a fact only one format has
# is a format fact keyed by that format. a fact an input does not state is
# absent, never a default.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use T: std.allocator.testing;

use mink.lib.catalog.arch;
use mink.lib.catalog.arch.Arch;
use mink.lib.catalog.format;
use mink.lib.catalog.format.Format;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.intern;
use mink.lib.intern.Interner;
use mink.lib.intern.Name;
use mink.lib.model.group;
use mink.lib.model.group.Rule;
use mink.lib.model.reloc;
use mink.lib.model.section;
use mink.lib.model.space.Space;
use mink.lib.model.symbol;
use mink.lib.table;
use mink.lib.table.Id;
use mink.lib.table.Table;

# bytes borrowed from an input that outlives the object
pub rec Bytes {
    data: *u8;
    len:  usize;
}

# bytes the object owns, in its store
pub rec Span {
    start: usize;
    len:   usize;
}

# what a section or record holds
# ---
# zero:     a zero fill of this many bytes, with nothing in the file
# borrowed: bytes of an input
# owned:    bytes in the object's store
pub tag Contents: u8 {
    zero:     u64;
    borrowed: Bytes;
    owned:    Span;
}

# name:     the section's name
# kind:     the role it plays
# flags:    the flags it carries
# align:    its alignment, a power of two
# entsize:  the size of one entry of a merge section, zero otherwise
# contents: its bytes or zero fill
# owner:    the section it depends on, as a COFF associative member or an ELF
#           link-order section does
# group:    the group it is a member of
pub rec Section {
    name:     Id[Name];
    kind:     *section.Kind;
    flags:    section.Flags;
    align:    u64;
    entsize:  u64;
    contents: Contents;
    owner:    opt[Id[Section]];
    group:    opt[Id[Group]];
}

# a place in a section
pub rec Place {
    section: Id[Section];
    offset:  u64;
}

# a common block the linker allocates
pub rec Common {
    size:  u64;
    align: u64;
}

# where a symbol's value comes from
# ---
# undefined: another object defines it
# placed:    a place in a section
# absolute:  a fixed value
# common:    a common block
# entry:     an entry of an index space
pub tag Definition: u8 {
    undefined;
    placed:   Place;
    absolute: u64;
    common:   Common;
    entry:    Id[Entry];
}

# size: the size the input states, absent when it states none
pub rec Symbol {
    name:       Id[Name];
    binding:    *symbol.Binding;
    visibility: *symbol.Visibility;
    kind:       *symbol.Kind;
    def:        Definition;
    size:       opt[u64];
}

# what a relocation refers to
pub tag Target: u8 {
    symbol: Id[Symbol];
    entry:  Id[Entry];
}

# section: the section the relocation patches
# offset:  the place within it
# kind:    what it computes
# target:  what it refers to
# addend:  the addend, read from the record or from the field
# minus:   the symbol subtracted, for a difference kind
pub rec Reloc {
    section: Id[Section];
    offset:  u64;
    kind:    *reloc.Kind;
    target:  Target;
    addend:  i64;
    minus:   opt[Id[Symbol]];
}

# signature: the name copies of the group are matched by
# rule:      how a copy is chosen
# leader:    for an associative group, the section it is kept with
pub rec Group {
    signature: Id[Name];
    rule:      *Rule;
    leader:    opt[Id[Section]];
}

# a system note: an owner's name, its type and its descriptor
pub rec Note {
    owner: Id[Name];
    kind:  u32;
    desc:  Contents;
}

# a fact only one format carries, keyed by that format, as ELF e_flags or a
# Mach-O build version is. `key` is the format's own
pub rec Fact {
    format: *Format;
    key:    u32;
    value:  u64;
    data:   Contents;
}

# an imported entry: the module and the field it comes from
pub rec Import {
    module: Id[Name];
    field:  Id[Name];
}

# an entry of an index space
# ---
# space:     the space it is in
# name:      its name, absent when it has none
# import:    where it comes from, absent when the object defines it
# body:      where its definition sits, absent for an import
# signature: its entry in the type space, absent where the space has no types
pub rec Entry {
    space:     *Space;
    name:      opt[Id[Name]];
    import:    opt[Import];
    body:      opt[Place];
    signature: opt[Id[Entry]];
}

pub rec Object {
    arch:     *Arch;
    names:    Interner;
    store:    Table[u8];
    sections: Table[Section];
    symbols:  Table[Symbol];
    relocs:   Table[Reloc];
    groups:   Table[Group];
    notes:    Table[Note];
    facts:    Table[Fact];
    entries:  Table[Entry];
}

pub fun make(a: *A.Allocator, target: *Arch) Object {
    ret Object{
        arch:     target,
        names:    intern.make(a),
        store:    table.make[u8](a),
        sections: table.make[Section](a),
        symbols:  table.make[Symbol](a),
        relocs:   table.make[Reloc](a),
        groups:   table.make[Group](a),
        notes:    table.make[Note](a),
        facts:    table.make[Fact](a),
        entries:  table.make[Entry](a),
    };
}

# give everything the object owns back, reporting the first refusal
pub fun release(o: *Object) err[Fail] {
    var first: err[Fail] = intern.release(?o.names);
    first = kept(first, table.release[u8](?o.store));
    first = kept(first, table.release[Section](?o.sections));
    first = kept(first, table.release[Symbol](?o.symbols));
    first = kept(first, table.release[Reloc](?o.relocs));
    first = kept(first, table.release[Group](?o.groups));
    first = kept(first, table.release[Note](?o.notes));
    first = kept(first, table.release[Fact](?o.facts));
    ret kept(first, table.release[Entry](?o.entries));
}

pub fun name(o: *Object, p: *u8, n: usize) res[Id[Name], Fail] {
    ret intern.intern(?o.names, p, n);
}

pub fun name_str(o: *Object, s: str) res[Id[Name], Fail] {
    ret intern.intern_str(?o.names, s);
}

# the bytes of a name, valid until the next name is interned
pub fun name_of(o: *Object, id: Id[Name]) View {
    ret intern.bytes_of(?o.names, id);
}

# a copy of the `n` bytes at `p` the object owns
pub fun own(o: *Object, p: *u8, n: usize) res[Contents, Fail] {
    val start: res[Id[u8], Fail] = table.extend[u8](?o.store, p, n);
    if (sel start.err) { ret res[Contents, Fail].err{start.err}; }
    ret res[Contents, Fail].ok{Contents.owned{Span{start: start.ok.index::usize, len: n}}};
}

# the bytes of `c`, nil for a zero fill. owned bytes stay valid until the
# object next owns bytes
pub fun bytes(o: *Object, c: *Contents) Bytes {
    if (sel c.borrowed) { ret c.borrowed; }
    if (sel c.owned)    { ret Bytes{data: ?table.items[u8](?o.store)[c.owned.start], len: c.owned.len}; }
    ret Bytes{data: nil, len: 0};
}

pub fun add_section(o: *Object, s: Section) res[Id[Section], Fail] {
    ret table.push[Section](?o.sections, s);
}

pub fun add_symbol(o: *Object, s: Symbol) res[Id[Symbol], Fail] {
    ret table.push[Symbol](?o.symbols, s);
}

pub fun add_reloc(o: *Object, r: Reloc) res[Id[Reloc], Fail] {
    ret table.push[Reloc](?o.relocs, r);
}

pub fun add_group(o: *Object, g: Group) res[Id[Group], Fail] {
    ret table.push[Group](?o.groups, g);
}

pub fun add_note(o: *Object, n: Note) res[Id[Note], Fail] {
    ret table.push[Note](?o.notes, n);
}

pub fun add_fact(o: *Object, f: Fact) res[Id[Fact], Fail] {
    ret table.push[Fact](?o.facts, f);
}

pub fun add_entry(o: *Object, e: Entry) res[Id[Entry], Fail] {
    ret table.push[Entry](?o.entries, e);
}

pub fun section_at(o: *Object, id: Id[Section]) *Section {
    ret table.at[Section](?o.sections, id);
}

pub fun symbol_at(o: *Object, id: Id[Symbol]) *Symbol {
    ret table.at[Symbol](?o.symbols, id);
}

pub fun group_at(o: *Object, id: Id[Group]) *Group {
    ret table.at[Group](?o.groups, id);
}

# the fact `f` states under `key`, none when it states none
pub fun fact(o: *Object, f: *Format, key: u32) opt[*Fact] {
    var i: usize = 0;
    for (i < table.count[Fact](?o.facts)) {
        val x: *Fact = table.at[Fact](?o.facts, table.nth[Fact](i));
        if (x.format == f && x.key == key) { ret opt[*Fact].some{x}; }
        i = i + 1;
    }
    ret opt[*Fact].none{};
}

# the section whose fate `s` shares: `s` itself, or for a member of an
# associative group, the section that group is kept with, followed to the end.
# a chain that comes back on itself is malformed
pub fun leader_of(o: *Object, s: Id[Section]) res[Id[Section], Fail] {
    var at:    Id[Section] = s;
    var steps: usize       = 0;
    for {
        val g: opt[Id[Group]] = section_at(o, at).group;
        if (sel g.none) { ret res[Id[Section], Fail].ok{at}; }
        val grp: *Group = group_at(o, g.some);
        if (!group.has(grp.rule, group.ASSOCIATIVE)) { ret res[Id[Section], Fail].ok{at}; }
        if (sel grp.leader.none) {
            ret res[Id[Section], Fail].err{fail.malformed("associative group has no leader section")};
        }
        steps = steps + 1;
        if (steps > table.count[Section](?o.sections)) {
            ret res[Id[Section], Fail].err{fail.malformed("associative groups form a cycle")};
        }
        at = grp.leader.some;
    }
    ret res[Id[Section], Fail].ok{at};
}

fun kept(first: err[Fail], next: err[Fail]) err[Fail] {
    if (sel first.err) { ret first; }
    ret next;
}

# a fresh object for a test over `t`
fun scratch(t: *T.Testing) res[Object, Fail] {
    val x: res[*Arch, Fail] = arch.by_name("x86_64");
    if (sel x.err) { ret res[Object, Fail].err{x.err}; }
    ret res[Object, Fail].ok{make(T.allocator_of(t), x.ok)};
}

# a section named `n` of kind text
fun text(o: *Object, n: str) res[Id[Section], Fail] {
    val nm: res[Id[Name], Fail] = name_str(o, n);
    if (sel nm.err) { ret res[Id[Section], Fail].err{nm.err}; }
    ret add_section(o, Section{name: nm.ok, kind: ?section.TEXT, flags: section.TEXT.flags, align: 16});
}

test object__an_absent_fact_stays_absent {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val s: res[Id[Section], Fail] = text(?o, ".text");
    if (sel s.err) { ret 1; }
    val nm: res[Id[Name], Fail] = name_str(?o, "f");
    if (sel nm.err) { ret 1; }
    val sym: res[Id[Symbol], Fail] = add_symbol(?o, Symbol{
        name:       nm.ok,
        binding:    ?symbol.GLOBAL,
        visibility: ?symbol.DEFAULT,
        kind:       ?symbol.FUNCTION,
        def:        Definition.placed{Place{section: s.ok, offset: 0}},
    });
    if (sel sym.err) { ret 1; }
    val stored: *Symbol = symbol_at(?o, sym.ok);
    if (sel stored.size.some) { ret 1; }
    val none: Symbol = Symbol{};
    if (sel none.size.some)      { ret 1; }
    if (!sel none.def.undefined) { ret 1; }
    val flags: opt[*Fact] = fact(?o, ?format.ELF, 0);
    if (sel flags.some) { ret 1; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err)           { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test object__an_associative_member_is_kept_with_its_leader {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val lead: res[Id[Section], Fail] = text(?o, ".text$f");
    if (sel lead.err) { ret 1; }
    val member: res[Id[Section], Fail] = text(?o, ".pdata$f");
    if (sel member.err) { ret 1; }
    val sig: res[Id[Name], Fail] = name_str(?o, "f");
    if (sel sig.err) { ret 1; }
    val any: res[Id[Group], Fail] = add_group(?o, Group{signature: sig.ok, rule: ?group.ANY});
    if (sel any.err) { ret 1; }
    val assoc: res[Id[Group], Fail] = add_group(?o, Group{
        signature: sig.ok,
        rule:      ?group.ASSOCIATE,
        leader:    opt[Id[Section]].some{lead.ok},
    });
    if (sel assoc.err) { ret 1; }
    section_at(?o, lead.ok).group   = opt[Id[Group]].some{any.ok};
    section_at(?o, member.ok).group = opt[Id[Group]].some{assoc.ok};
    section_at(?o, member.ok).owner = opt[Id[Section]].some{lead.ok};

    val l: res[Id[Section], Fail] = leader_of(?o, member.ok);
    if (sel l.err)                   { ret 1; }
    if (l.ok.index != lead.ok.index) { ret 1; }
    val self: res[Id[Section], Fail] = leader_of(?o, lead.ok);
    if (sel self.err)                   { ret 1; }
    if (self.ok.index != lead.ok.index) { ret 1; }

    group_at(?o, assoc.ok).leader = opt[Id[Section]].some{member.ok};
    val cycle: res[Id[Section], Fail] = leader_of(?o, member.ok);
    if (sel cycle.ok) { ret 1; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err) { ret 1; }
    T.dnit(?t);
    ret 0;
}

test object__ids_stay_stable_as_the_model_grows {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val got: res[Object, Fail] = scratch(?t);
    if (sel got.err) { ret 1; }
    var o: Object = got.ok;

    val first: res[Id[Section], Fail] = text(?o, ".text.first");
    if (sel first.err) { ret 1; }
    val nm: res[Id[Name], Fail] = name_str(?o, "first");
    if (sel nm.err) { ret 1; }
    val sym: res[Id[Symbol], Fail] = add_symbol(?o, Symbol{
        name:       nm.ok,
        binding:    ?symbol.LOCAL,
        visibility: ?symbol.DEFAULT,
        kind:       ?symbol.DATA,
        def:        Definition.absolute{7},
    });
    if (sel sym.err) { ret 1; }
    var i: usize = 0;
    for (i < 500) {
        val more: res[Id[Section], Fail] = text(?o, ".text.more");
        if (sel more.err) { ret 1; }
        val s: res[Id[Symbol], Fail] = add_symbol(?o, Symbol{name: nm.ok, binding: ?symbol.LOCAL, visibility: ?symbol.DEFAULT, kind: ?symbol.NOTYPE});
        if (sel s.err) { ret 1; }
        i = i + 1;
    }
    val v: View = name_of(?o, section_at(?o, first.ok).name);
    if (v.len != 11 || v.data[10] != 't') { ret 1; }
    val d: Definition = symbol_at(?o, sym.ok).def;
    if (!sel d.absolute) { ret 1; }
    if (d.absolute != 7) { ret 1; }

    val rel: err[Fail] = release(?o);
    if (sel rel.err) { ret 1; }
    T.dnit(?t);
    ret 0;
}
