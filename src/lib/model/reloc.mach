pub val TLS_GOT_PCREL_HI20:   Kind = Kind{name: "tls_got_pcrel_hi20", caps: PC | GOT | TLS};
pub val TLS_GD_PCREL_HI20:    Kind = Kind{name: "tls_gd_pcrel_hi20", caps: PC | GOT | TLS};
pub val TPREL_HI20:           Kind = Kind{name: "tprel_hi20", caps: ABS | TLS};
pub val TPREL_LO12_I:         Kind = Kind{name: "tprel_lo12_i", caps: ABS | TLS};
pub val TPREL_LO12_S:         Kind = Kind{name: "tprel_lo12_s", caps: ABS | TLS};
pub val TPREL_ADD:            Kind = Kind{name: "tprel_add", caps: MARKER};
pub val ADD8:                 Kind = Kind{name: "add8", caps: ABS};
pub val ADD16:                Kind = Kind{name: "add16", caps: ABS};
pub val ADD32:                Kind = Kind{name: "add32", caps: ABS};
pub val ADD64:                Kind = Kind{name: "add64", caps: ABS};
pub val SUB8:                 Kind = Kind{name: "sub8", caps: ABS};
pub val SUB16:                Kind = Kind{name: "sub16", caps: ABS};
pub val SUB32:                Kind = Kind{name: "sub32", caps: ABS};
pub val SUB64:                Kind = Kind{name: "sub64", caps: ABS};
pub val SET6:                 Kind = Kind{name: "set6", caps: ABS};
pub val SUB6:                 Kind = Kind{name: "sub6", caps: ABS};
pub val SET8:                 Kind = Kind{name: "set8", caps: ABS};
pub val SET16:                Kind = Kind{name: "set16", caps: ABS};
pub val SET32:                Kind = Kind{name: "set32", caps: ABS};
pub val SET_ULEB128:          Kind = Kind{name: "set_uleb128", caps: ABS | PARTNER};
pub val SUB_ULEB128:          Kind = Kind{name: "sub_uleb128", caps: ABS | PARTNER};
pub val RVC_BRANCH:           Kind = Kind{name: "rvc_branch", caps: PC};
pub val RVC_JUMP:             Kind = Kind{name: "rvc_jump", caps: PC};
pub val TLSDESC_HI20:         Kind = Kind{name: "tlsdesc_hi20", caps: PC | GOT | TLS};
pub val TLSDESC_LOAD_LO12:    Kind = Kind{name: "tlsdesc_load_lo12", caps: PC | GOT | TLS | PARTNER};
pub val TLSDESC_ADD_LO12:     Kind = Kind{name: "tlsdesc_add_lo12", caps: PC | GOT | TLS | PARTNER};
pub val TLSDESC_CALL:         Kind = Kind{name: "tlsdesc_call", caps: MARKER};
pub val VENDOR:               Kind = Kind{name: "vendor", caps: MARKER};

val ROW_COUNT: usize            = 110;
val ROWS:      [ROW_COUNT]*Kind = [ROW_COUNT]*Kind{
    ?NONE, ?ABS8, ?ABS16, ?ABS32, ?ABS32S, ?ABS64, ?PC8, ?PC16, ?PC32, ?PC64, ?PLT32, ?GOT32,
    ?GOTPC32, ?GOTPCREL32, ?GOTPCREL32_RELAXABLE, ?GOTPCREL64, ?RVA32, ?SECREL32, ?SECTION16,
    ?DIFF8, ?DIFF16, ?DIFF32, ?DIFF64, ?TPOFF32, ?TPOFF64, ?GOTTPOFF32, ?TLSGD32, ?TLSLD32,
    ?DTPOFF32, ?DTPOFF64, ?DTPMOD64, ?PAGE21, ?GOT_PAGE21, ?LO12_ADD, ?LO12_LDST8, ?LO12_LDST16,
    ?LO12_LDST32, ?LO12_LDST64, ?LO12_LDST128, ?GOT_LO12, ?JUMP26, ?CALL26, ?BRANCH19, ?BRANCH14,
    ?HI20, ?LO12_I, ?LO12_S, ?PCREL_HI20, ?PCREL_LO12_I, ?PCREL_LO12_S, ?GOT_PCREL_HI20, ?CALL_PAIR,
    ?JAL20, ?BRANCH12, ?RELAX, ?ALIGN, ?FUNCTION_INDEX_LEB, ?TABLE_INDEX_SLEB, ?TABLE_INDEX_I32,
    ?TABLE_INDEX_SLEB64, ?TABLE_INDEX_I64, ?MEMORY_ADDR_LEB, ?MEMORY_ADDR_SLEB, ?MEMORY_ADDR_I32,
    ?MEMORY_ADDR_LEB64, ?MEMORY_ADDR_SLEB64, ?MEMORY_ADDR_I64, ?TYPE_INDEX_LEB, ?GLOBAL_INDEX_LEB,
    ?GLOBAL_INDEX_I32, ?TAG_INDEX_LEB, ?TABLE_NUMBER_LEB, ?FUNCTION_OFFSET_I32,
    ?FUNCTION_OFFSET_I64, ?SECTION_OFFSET_I32,
    ?RELATIVE, ?COPY, ?JUMP_SLOT, ?IRELATIVE, ?TLSDESC, ?DTPMOD32, ?CALL_PLT_PAIR, ?TLS_GOT_PCREL_HI20, ?TLS_GD_PCREL_HI20, ?TPREL_HI20, ?TPREL_LO12_I, ?TPREL_LO12_S, ?TPREL_ADD, ?ADD8, ?ADD16, ?ADD32, ?ADD64, ?SUB8, ?SUB16, ?SUB32, ?SUB64, ?SET6, ?SUB6, ?SET8, ?SET16, ?SET32, ?SET_ULEB128, ?SUB_ULEB128, ?RVC_BRANCH, ?RVC_JUMP, ?TLSDESC_HI20, ?TLSDESC_LOAD_LO12, ?TLSDESC_ADD_LO12, ?TLSDESC_CALL, ?VENDOR,
};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Kind {
    ret ROWS[index];
}

pub fun by_name(name: str) res[*Kind, Fail] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].name, name)) { ret res[*Kind, Fail].ok{ROWS[i]}; }
        i = i + 1;
    }
    ret res[*Kind, Fail].err{fail.unsupported("no relocation kind has this name")};
}

pub fun has(k: *Kind, c: Caps) bool {
    ret (k.caps & c) == c;
}

# one basis, a second symbol exactly for differences, and the linker-made
# entries only for values that reach a target by address
fun consistent(k: *Kind) bool {
    val basis: Caps = k.caps & BASES;
    if (basis == 0 || (basis & (basis - 1)) != 0)                        { ret false; }
    if (has(k, PAIR) != has(k, DIFF))                                    { ret false; }
    if ((k.caps & (GOT | PLT | PAGE)) != 0 && (basis & (ABS | PC)) == 0) { ret false; }
    if (has(k, MARKER) && k.caps != MARKER)                              { ret false; }
    ret true;
}

test reloc__kinds_are_unique_and_consistent {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        var j: usize = i + 1;
        for (j < ROW_COUNT) {
            if (str_equals(ROWS[i].name, ROWS[j].name)) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}
