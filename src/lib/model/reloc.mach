pub val SET6:                    Kind = Kind{name: "set6", caps: ABS};
pub val SUB6:                    Kind = Kind{name: "sub6", caps: ABS};
pub val SET8:                    Kind = Kind{name: "set8", caps: ABS};
pub val SET16:                   Kind = Kind{name: "set16", caps: ABS};
pub val SET32:                   Kind = Kind{name: "set32", caps: ABS};
pub val SET_ULEB128:             Kind = Kind{name: "set_uleb128", caps: ABS | PARTNER};
pub val SUB_ULEB128:             Kind = Kind{name: "sub_uleb128", caps: ABS | PARTNER};
pub val RVC_BRANCH:              Kind = Kind{name: "rvc_branch", caps: PC};
pub val RVC_JUMP:                Kind = Kind{name: "rvc_jump", caps: PC};
pub val TLSDESC_HI20:            Kind = Kind{name: "tlsdesc_hi20", caps: PC | GOT | TLS};
pub val TLSDESC_PCREL_LOAD_LO12: Kind = Kind{name: "tlsdesc_pcrel_load_lo12", caps: PC | GOT | TLS | PARTNER};
pub val TLSDESC_PCREL_ADD_LO12:  Kind = Kind{name: "tlsdesc_pcrel_add_lo12", caps: PC | GOT | TLS | PARTNER};
pub val VENDOR:                  Kind = Kind{name: "vendor", caps: MARKER};

val ROW_COUNT: usize            = 228;
val ROWS:      [ROW_COUNT]*Kind = [ROW_COUNT]*Kind{
    ?NONE, ?ABS8, ?ABS16, ?ABS32, ?ABS32S, ?ABS64, ?PC8, ?PC16, ?PC32, ?PC64, ?PLT32, ?GOT32,
    ?GOTPC32, ?GOTPCREL32, ?GOTPCREL32_RELAXABLE, ?GOTPCREL64, ?RVA32, ?SECREL32, ?SECTION16,
    ?DIFF8, ?DIFF16, ?DIFF32, ?DIFF64, ?TPOFF32, ?TPOFF64, ?GOTTPOFF32, ?TLSGD32, ?TLSLD32,
    ?DTPOFF32, ?DTPOFF64, ?DTPMOD64, ?PAGE21, ?GOT_PAGE21, ?LO12_ADD, ?LO12_LDST8, ?LO12_LDST16,
    ?LO12_LDST32, ?LO12_LDST64, ?LO12_LDST128, ?GOT_LO12, ?JUMP26, ?CALL26, ?BRANCH19, ?BRANCH14,
    ?HI20, ?LO12_I, ?LO12_S, ?PCREL_HI20, ?PCREL_LO12_I, ?PCREL_LO12_S, ?GOT_PCREL_HI20, ?CALL_PAIR,
    ?JAL20, ?BRANCH12, ?RELAX, ?ALIGN, ?FUNCTION_INDEX_LEB, ?TABLE_INDEX_SLEB, ?TABLE_INDEX_I32,
    ?TABLE_INDEX_SLEB64, ?TABLE_INDEX_I64, ?MEMORY_ADDR_LEB, ?MEMORY_ADDR_SLEB, ?MEMORY_ADDR_I32,
    ?MEMORY_ADDR_LEB64, ?MEMORY_ADDR_SLEB64, ?MEMORY_ADDR_I64, ?TYPE_INDEX_LEB, ?GLOBAL_INDEX_LEB,
    ?GLOBAL_INDEX_I32, ?TAG_INDEX_LEB, ?TABLE_NUMBER_LEB, ?FUNCTION_OFFSET_I32,
    ?FUNCTION_OFFSET_I64, ?SECTION_OFFSET_I32,
    ?MOVW_UABS_G0, ?MOVW_UABS_G0_NC, ?MOVW_UABS_G1, ?MOVW_UABS_G1_NC, ?MOVW_UABS_G2, ?MOVW_UABS_G2_NC, ?MOVW_UABS_G3, ?MOVW_SABS_G0, ?MOVW_SABS_G1, ?MOVW_SABS_G2, ?LD_PREL_LO19, ?ADR_PREL_LO21, ?ADR_PREL_PG_HI21_NC, ?MOVW_PREL_G0, ?MOVW_PREL_G0_NC, ?MOVW_PREL_G1, ?MOVW_PREL_G1_NC, ?MOVW_PREL_G2, ?MOVW_PREL_G2_NC, ?MOVW_PREL_G3, ?MOVW_GOTOFF_G0, ?MOVW_GOTOFF_G0_NC, ?MOVW_GOTOFF_G1, ?MOVW_GOTOFF_G1_NC, ?MOVW_GOTOFF_G2, ?MOVW_GOTOFF_G2_NC, ?MOVW_GOTOFF_G3, ?GOTREL64, ?GOTREL32, ?GOT_LD_PREL19, ?LD64_GOTOFF_LO15, ?LD64_GOTPAGE_LO15, ?PATCHINST, ?FUNCINIT64, ?TLSGD_ADR_PREL21, ?TLSGD_ADR_PAGE21, ?TLSGD_ADD_LO12_NC, ?TLSGD_MOVW_G1, ?TLSGD_MOVW_G0_NC, ?TLSLD_ADR_PREL21, ?TLSLD_ADR_PAGE21, ?TLSLD_ADD_LO12_NC, ?TLSLD_MOVW_G1, ?TLSLD_MOVW_G0_NC, ?TLSLD_LD_PREL19, ?TLSLD_MOVW_DTPREL_G2, ?TLSLD_MOVW_DTPREL_G1, ?TLSLD_MOVW_DTPREL_G1_NC, ?TLSLD_MOVW_DTPREL_G0, ?TLSLD_MOVW_DTPREL_G0_NC, ?TLSLD_ADD_DTPREL_HI12, ?TLSLD_ADD_DTPREL_LO12, ?TLSLD_ADD_DTPREL_LO12_NC, ?TLSLD_LDST8_DTPREL_LO12, ?TLSLD_LDST8_DTPREL_LO12_NC, ?TLSLD_LDST16_DTPREL_LO12, ?TLSLD_LDST16_DTPREL_LO12_NC, ?TLSLD_LDST32_DTPREL_LO12, ?TLSLD_LDST32_DTPREL_LO12_NC, ?TLSLD_LDST64_DTPREL_LO12, ?TLSLD_LDST64_DTPREL_LO12_NC, ?TLSIE_MOVW_GOTTPREL_G1, ?TLSIE_MOVW_GOTTPREL_G0_NC, ?TLSIE_ADR_GOTTPREL_PAGE21, ?TLSIE_LD64_GOTTPREL_LO12_NC, ?TLSIE_LD_GOTTPREL_PREL19, ?TLSLE_MOVW_TPREL_G2, ?TLSLE_MOVW_TPREL_G1, ?TLSLE_MOVW_TPREL_G1_NC, ?TLSLE_MOVW_TPREL_G0, ?TLSLE_MOVW_TPREL_G0_NC, ?TLSLE_ADD_TPREL_HI12, ?TLSLE_ADD_TPREL_LO12, ?TLSLE_ADD_TPREL_LO12_NC, ?TLSLE_LDST8_TPREL_LO12, ?TLSLE_LDST8_TPREL_LO12_NC, ?TLSLE_LDST16_TPREL_LO12, ?TLSLE_LDST16_TPREL_LO12_NC, ?TLSLE_LDST32_TPREL_LO12, ?TLSLE_LDST32_TPREL_LO12_NC, ?TLSLE_LDST64_TPREL_LO12, ?TLSLE_LDST64_TPREL_LO12_NC, ?TLSDESC_LD_PREL19, ?TLSDESC_ADR_PREL21, ?TLSDESC_ADR_PAGE21, ?TLSDESC_LD64_LO12, ?TLSDESC_ADD_LO12, ?TLSDESC_OFF_G1, ?TLSDESC_OFF_G0_NC, ?TLSDESC_LDR, ?TLSDESC_ADD, ?TLSDESC_CALL, ?TLSLE_LDST128_TPREL_LO12, ?TLSLE_LDST128_TPREL_LO12_NC, ?TLSLD_LDST128_DTPREL_LO12, ?TLSLD_LDST128_DTPREL_LO12_NC, ?COPY, ?GLOB_DAT, ?JUMP_SLOT, ?RELATIVE, ?TLSDESC, ?IRELATIVE, ?AUTH_ABS64, ?AUTH_MOVW_GOTOFF_G0, ?AUTH_MOVW_GOTOFF_G0_NC, ?AUTH_MOVW_GOTOFF_G1, ?AUTH_MOVW_GOTOFF_G1_NC, ?AUTH_MOVW_GOTOFF_G2, ?AUTH_MOVW_GOTOFF_G2_NC, ?AUTH_MOVW_GOTOFF_G3, ?AUTH_GOT_LD_PREL19, ?AUTH_LD64_GOTOFF_LO15, ?AUTH_ADR_GOT_PAGE, ?AUTH_LD64_GOT_LO12_NC, ?AUTH_LD64_GOTPAGE_LO15, ?AUTH_GOT_ADD_LO12_NC, ?AUTH_GOT_ADR_PREL_LO21, ?AUTH_TLSDESC_ADR_PAGE21, ?AUTH_TLSDESC_LD64_LO12, ?AUTH_TLSDESC_ADD_LO12, ?AUTH_RELATIVE, ?AUTH_GLOB_DAT, ?AUTH_TLSDESC, ?AUTH_IRELATIVE,
    ?DTPMOD32, ?CALL_PLT_PAIR, ?TLS_GOT_PCREL_HI20, ?TLS_GD_PCREL_HI20, ?TPREL_HI20, ?TPREL_LO12_I, ?TPREL_LO12_S, ?TPREL_ADD, ?ADD8, ?ADD16, ?ADD32, ?ADD64, ?SUB8, ?SUB16, ?SUB32, ?SUB64, ?SET6, ?SUB6, ?SET8, ?SET16, ?SET32, ?SET_ULEB128, ?SUB_ULEB128, ?RVC_BRANCH, ?RVC_JUMP, ?TLSDESC_HI20, ?TLSDESC_PCREL_LOAD_LO12, ?TLSDESC_PCREL_ADD_LO12, ?VENDOR,
};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Kind {
    ret ROWS[index];
}

pub fun by_name(name: str) res[*Kind, Fail] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].name, name)) { ret res[*Kind, Fail].ok{ROWS[i]}; }
        i = i + 1;
    }
    ret res[*Kind, Fail].err{fail.unsupported("no relocation kind has this name")};
}

pub fun has(k: *Kind, c: Caps) bool {
    ret (k.caps & c) == c;
}

# one basis, a second symbol exactly for differences, and the linker-made
# entries only for values that reach a target by address
fun consistent(k: *Kind) bool {
    val basis: Caps = k.caps & BASES;
    if (basis == 0 || (basis & (basis - 1)) != 0)                        { ret false; }
    if (has(k, PAIR) != has(k, DIFF))                                    { ret false; }
    if ((k.caps & (GOT | PLT | PAGE)) != 0 && (basis & (ABS | PC)) == 0) { ret false; }
    if (has(k, MARKER) && k.caps != MARKER)                              { ret false; }
    ret true;
}

test reloc__kinds_are_unique_and_consistent {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!consistent(ROWS[i])) { ret 1; }
        var j: usize = i + 1;
        for (j < ROW_COUNT) {
            if (str_equals(ROWS[i].name, ROWS[j].name)) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}
