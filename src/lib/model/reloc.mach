# the relocation kinds of the neutral model
#
# a kind is what a relocation computes and asks of the linker. a format maps
# each of its relocation codes to a kind and back, and how a kind is applied to
# the bytes of one architecture is that pair's relocation table. kinds are as
# fine as the format codes they map, so a code maps back to itself.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mink.lib.fail;
use mink.lib.fail.Fail;

pub def Caps: u64;

# the value a kind computes is relative to exactly one basis
# ---
# ABS:    the target's address, S+A
# PC:     the distance from the place, S+A-P
# IMAGE:  the distance from the image base
# SECREL: the offset within the target's section
# SECIDX: the index of the target's section
# DIFF:   the difference of two symbols
# INDEX:  the target's index in its index space
# MARKER: nothing, the row marks the place for the linker
pub val ABS:    Caps = 0x1;
pub val PC:     Caps = 0x2;
pub val IMAGE:  Caps = 0x4;
pub val SECREL: Caps = 0x8;
pub val SECIDX: Caps = 0x10;
pub val DIFF:   Caps = 0x20;
pub val INDEX:  Caps = 0x40;
pub val MARKER: Caps = 0x80;

# the target is reached through a GOT entry the linker reserves
pub val GOT: Caps = 0x100;
# the target may be reached through a PLT entry or a stub
pub val PLT: Caps = 0x200;
# the value is a thread-local offset or descriptor
pub val TLS: Caps = 0x400;
# the value is taken at page granularity
pub val PAGE: Caps = 0x800;
# the relocation names a second symbol to subtract
pub val PAIR: Caps = 0x1000;
# the relocation needs a partner relocation at another place
pub val PARTNER: Caps = 0x2000;

val BASES: Caps = ABS | PC | IMAGE | SECREL | SECIDX | DIFF | INDEX | MARKER;

pub rec Kind {
    name: str;
    caps: Caps;
}

pub val NONE:                 Kind = Kind{name: "none", caps: MARKER};
pub val ABS8:                 Kind = Kind{name: "abs8", caps: ABS};
pub val ABS16:                Kind = Kind{name: "abs16", caps: ABS};
pub val ABS32:                Kind = Kind{name: "abs32", caps: ABS};
pub val ABS32S:               Kind = Kind{name: "abs32s", caps: ABS};
pub val ABS64:                Kind = Kind{name: "abs64", caps: ABS};
pub val PC8:                  Kind = Kind{name: "pc8", caps: PC};
pub val PC16:                 Kind = Kind{name: "pc16", caps: PC};
pub val PC32:                 Kind = Kind{name: "pc32", caps: PC};
pub val PC64:                 Kind = Kind{name: "pc64", caps: PC};
pub val PLT32:                Kind = Kind{name: "plt32", caps: PC | PLT};
pub val GOT32:                Kind = Kind{name: "got32", caps: ABS | GOT};
pub val GOTPC32:              Kind = Kind{name: "gotpc32", caps: PC | GOT};
pub val GOTPCREL32:           Kind = Kind{name: "gotpcrel32", caps: PC | GOT};
pub val GOTPCREL32_RELAXABLE: Kind = Kind{name: "gotpcrel32_relaxable", caps: PC | GOT};
pub val GOTPCREL64:           Kind = Kind{name: "gotpcrel64", caps: PC | GOT};
pub val RVA32:                Kind = Kind{name: "rva32", caps: IMAGE};
pub val SECREL32:             Kind = Kind{name: "secrel32", caps: SECREL};
pub val SECTION16:            Kind = Kind{name: "section16", caps: SECIDX};
pub val DIFF8:                Kind = Kind{name: "diff8", caps: DIFF | PAIR};
pub val DIFF16:               Kind = Kind{name: "diff16", caps: DIFF | PAIR};
pub val DIFF32:               Kind = Kind{name: "diff32", caps: DIFF | PAIR};
pub val DIFF64:               Kind = Kind{name: "diff64", caps: DIFF | PAIR};
pub val TPOFF32:              Kind = Kind{name: "tpoff32", caps: ABS | TLS};
pub val TPOFF64:              Kind = Kind{name: "tpoff64", caps: ABS | TLS};
pub val GOTTPOFF32:           Kind = Kind{name: "gottpoff32", caps: PC | GOT | TLS};
pub val TLSGD32:              Kind = Kind{name: "tlsgd32", caps: PC | GOT | TLS};
pub val TLSLD32:              Kind = Kind{name: "tlsld32", caps: PC | GOT | TLS};
pub val DTPOFF32:             Kind = Kind{name: "dtpoff32", caps: ABS | TLS};
pub val DTPOFF64:             Kind = Kind{name: "dtpoff64", caps: ABS | TLS};
pub val DTPMOD64:             Kind = Kind{name: "dtpmod64", caps: ABS | TLS};
pub val PAGE21:               Kind = Kind{name: "page21", caps: PC | PAGE};
pub val GOT_PAGE21:           Kind = Kind{name: "got_page21", caps: PC | PAGE | GOT};
pub val LO12_ADD:             Kind = Kind{name: "lo12_add", caps: ABS};
pub val LO12_LDST8:           Kind = Kind{name: "lo12_ldst8", caps: ABS};
pub val LO12_LDST16:          Kind = Kind{name: "lo12_ldst16", caps: ABS};
pub val LO12_LDST32:          Kind = Kind{name: "lo12_ldst32", caps: ABS};
pub val LO12_LDST64:          Kind = Kind{name: "lo12_ldst64", caps: ABS};
pub val LO12_LDST128:         Kind = Kind{name: "lo12_ldst128", caps: ABS};
pub val GOT_LO12:             Kind = Kind{name: "got_lo12", caps: ABS | GOT};
pub val JUMP26:               Kind = Kind{name: "jump26", caps: PC | PLT};
pub val CALL26:               Kind = Kind{name: "call26", caps: PC | PLT};
pub val BRANCH19:             Kind = Kind{name: "branch19", caps: PC};
pub val BRANCH14:             Kind = Kind{name: "branch14", caps: PC};
pub val HI20:                 Kind = Kind{name: "hi20", caps: ABS};
pub val LO12_I:               Kind = Kind{name: "lo12_i", caps: ABS};
pub val LO12_S:               Kind = Kind{name: "lo12_s", caps: ABS};
pub val PCREL_HI20:           Kind = Kind{name: "pcrel_hi20", caps: PC};
pub val PCREL_LO12_I:         Kind = Kind{name: "pcrel_lo12_i", caps: PC | PARTNER};
pub val PCREL_LO12_S:         Kind = Kind{name: "pcrel_lo12_s", caps: PC | PARTNER};
pub val GOT_PCREL_HI20:       Kind = Kind{name: "got_pcrel_hi20", caps: PC | GOT};
pub val CALL_PAIR:            Kind = Kind{name: "call_pair", caps: PC | PLT};
pub val JAL20:                Kind = Kind{name: "jal20", caps: PC};
pub val BRANCH12:             Kind = Kind{name: "branch12", caps: PC};
pub val RELAX:                Kind = Kind{name: "relax", caps: MARKER};
pub val ALIGN:                Kind = Kind{name: "align", caps: MARKER};
pub val FUNCTION_INDEX_LEB:   Kind = Kind{name: "function_index_leb", caps: INDEX};
pub val TABLE_INDEX_SLEB:     Kind = Kind{name: "table_index_sleb", caps: INDEX};
pub val TABLE_INDEX_I32:      Kind = Kind{name: "table_index_i32", caps: INDEX};
pub val TABLE_INDEX_SLEB64:   Kind = Kind{name: "table_index_sleb64", caps: INDEX};
pub val TABLE_INDEX_I64:      Kind = Kind{name: "table_index_i64", caps: INDEX};
pub val MEMORY_ADDR_LEB:      Kind = Kind{name: "memory_addr_leb", caps: ABS};
pub val MEMORY_ADDR_SLEB:     Kind = Kind{name: "memory_addr_sleb", caps: ABS};
pub val MEMORY_ADDR_I32:      Kind = Kind{name: "memory_addr_i32", caps: ABS};
pub val MEMORY_ADDR_LEB64:    Kind = Kind{name: "memory_addr_leb64", caps: ABS};
pub val MEMORY_ADDR_SLEB64:   Kind = Kind{name: "memory_addr_sleb64", caps: ABS};
pub val MEMORY_ADDR_I64:      Kind = Kind{name: "memory_addr_i64", caps: ABS};
pub val TYPE_INDEX_LEB:       Kind = Kind{name: "type_index_leb", caps: INDEX};
pub val GLOBAL_INDEX_LEB:     Kind = Kind{name: "global_index_leb", caps: INDEX};
pub val GLOBAL_INDEX_I32:     Kind = Kind{name: "global_index_i32", caps: INDEX};
pub val TAG_INDEX_LEB:        Kind = Kind{name: "tag_index_leb", caps: INDEX};
pub val TABLE_NUMBER_LEB:     Kind = Kind{name: "table_number_leb", caps: INDEX};
pub val FUNCTION_OFFSET_I32:  Kind = Kind{name: "function_offset_i32", caps: SECREL};
pub val FUNCTION_OFFSET_I64:  Kind = Kind{name: "function_offset_i64", caps: SECREL};
pub val SECTION_OFFSET_I32:   Kind = Kind{name: "section_offset_i32", caps: SECREL};
pub val RELATIVE:             Kind = Kind{name: "relative", caps: ABS};
pub val COPY:                 Kind = Kind{name: "copy", caps: MARKER};
