# the index spaces of the neutral model
#
# a module format that names its entries by index rather than by address, as
# wasm does, keeps them in index spaces. imports come first in each space,
# then definitions.

use std.types.size.usize;
use std.types.string.str;

pub rec Space {
    name: str;
}

pub val FUNCTIONS: Space = Space{name: "function"};
pub val GLOBALS:   Space = Space{name: "global"};
pub val TABLES:    Space = Space{name: "table"};
pub val MEMORIES:  Space = Space{name: "memory"};
pub val TAGS:      Space = Space{name: "tag"};
pub val TYPES:     Space = Space{name: "type"};
pub val SEGMENTS:  Space = Space{name: "data_segment"};
pub val ELEMENTS:  Space = Space{name: "element_segment"};

val ROW_COUNT: usize             = 8;
val ROWS:      [ROW_COUNT]*Space = [ROW_COUNT]*Space{
    ?FUNCTIONS, ?GLOBALS, ?TABLES, ?MEMORIES, ?TAGS, ?TYPES, ?SEGMENTS, ?ELEMENTS,
};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Space {
    ret ROWS[index];
}
