# the COFF format
#
# the exact revision of each specification the COFF modules implement, so a
# change to any of them is a visible version bump.

use std.types.size.usize;

use mink.lib.format.contract.Revision;

pub val REVISION_COUNT: usize = 1;

pub val REVISIONS: [REVISION_COUNT]Revision = [REVISION_COUNT]Revision{
    Revision{spec: "Microsoft PE Format, with the ARM64 and ARM64EC additions", revision: "page of 10 September 2026"},
};
