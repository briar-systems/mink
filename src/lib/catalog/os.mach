# the operating system catalog
#
# a system is a row of loader facts, read through the same accessors whatever
# the system. code branches on what a row declares, never on which system it
# is. calling conventions and data layout are mirl's and have no field here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mink.lib.catalog.arch;
use mink.lib.catalog.arch.Arch;
use mink.lib.catalog.format;
use mink.lib.catalog.format.Code;
use mink.lib.catalog.format.Format;
use mink.lib.fail;
use mink.lib.fail.Fail;

pub def Caps: u64;

# executables are position independent unless asked otherwise
pub val PIE_DEFAULT: Caps = 1;
# the system runs AArch64 code with data independent timing enabled
pub val DIT_GUARANTEED: Caps = 2;

# a version as a format writes it, such as LC_BUILD_VERSION's minos
pub rec Version {
    major: u16;
    minor: u8;
    patch: u8;
}

# what a system says for one architecture it runs
# ---
# arch:         the architecture
# interpreter:  the program loader's path, nil where there is none
# libdirs:      the directories searched for libraries, in order
# libdir_count: how many
# image_base:   the address an image is linked at by default
# page_size:    the page size images are aligned to
# caps:         the capabilities the system declares for this architecture
pub rec Host {
    arch:         *Arch;
    interpreter:  str;
    libdirs:      *str;
    libdir_count: usize;
    image_base:   u64;
    page_size:    u64;
    caps:         Caps;
}

# name:                the system's spelling
# codes:               how each format names the system, such as ELF's
#                      EI_OSABI, a Mach-O platform or a PE subsystem
# code_count:          how many codes
# hosts:               the architectures the system runs
# host_count:          how many
# entry:               the entry symbol, nil where the system fixes none
# mapped:              whether a loader maps the image at all
# formats:             the output formats the system accepts, the default first
# format_count:        how many
# libraries:           the libraries a program links by default
# library_count:       how many
# framework_dirs:      the directories searched for frameworks
# framework_dir_count: how many
# min_version:         the oldest system version an image declares it runs on
pub rec Os {
    name:                str;
    codes:               *Code;
    code_count:          usize;
    hosts:               *Host;
    host_count:          usize;
    entry:               str;
    mapped:              bool;
    formats:             **Format;
    format_count:        usize;
    libraries:           *str;
    library_count:       usize;
    framework_dirs:      *str;
    framework_dir_count: usize;
    min_version:         Version;
}

# linux: elf osabi is ELFOSABI_NONE, which linkers write. loaders and library
# directories are the glibc paths from the psABIs and glibc's multiarch layout
val LINUX_CODES:   [1]Code    = [1]Code{Code{format: ?format.ELF, value: 0}};
val LINUX_FORMATS: [1]*Format = [1]*Format{?format.ELF};

val LINUX_X86_64_LIBDIRS: [6]str = [6]str{"/lib64", "/usr/lib64", "/lib/x86_64-linux-gnu", "/usr/lib/x86_64-linux-gnu", "/usr/lib", "/lib"};
# i386 psABI interpreter path; library directories from glibc's i386 multiarch layout
val LINUX_X86_LIBDIRS:     [6]str = [6]str{"/lib32", "/usr/lib32", "/lib/i386-linux-gnu", "/usr/lib/i386-linux-gnu", "/usr/lib", "/lib"};
val LINUX_AARCH64_LIBDIRS: [6]str = [6]str{"/lib/aarch64-linux-gnu", "/usr/lib/aarch64-linux-gnu", "/lib64", "/usr/lib64", "/usr/lib", "/lib"};
val LINUX_RISCV64_LIBDIRS: [6]str = [6]str{"/lib/riscv64-linux-gnu", "/usr/lib/riscv64-linux-gnu", "/lib64", "/usr/lib64", "/usr/lib", "/lib"};
# glibc's riscv32 ilp32d loader name, in glibc since 2.33; linux has no mainline riscv32 port
val LINUX_RISCV32_LIBDIRS: [6]str = [6]str{"/lib/riscv32-linux-gnu", "/usr/lib/riscv32-linux-gnu", "/lib32", "/usr/lib32", "/usr/lib", "/lib"};

val LINUX_HOSTS: [5]Host = [5]Host{
    Host{arch: ?arch.X86_64, interpreter: "/lib64/ld-linux-x86-64.so.2", libdirs: ?LINUX_X86_64_LIBDIRS[0], libdir_count: 6, image_base: 0x400000, page_size: 0x1000, caps: 0},
    Host{arch: ?arch.X86, interpreter: "/lib/ld-linux.so.2", libdirs: ?LINUX_X86_LIBDIRS[0], libdir_count: 6, image_base: 0x400000, page_size: 0x1000, caps: 0},
    Host{arch: ?arch.AARCH64, interpreter: "/lib/ld-linux-aarch64.so.1", libdirs: ?LINUX_AARCH64_LIBDIRS[0], libdir_count: 6, image_base: 0x400000, page_size: 0x1_0000, caps: DIT_GUARANTEED},
    Host{arch: ?arch.RISCV64, interpreter: "/lib/ld-linux-riscv64-lp64d.so.1", libdirs: ?LINUX_RISCV64_LIBDIRS[0], libdir_count: 6, image_base: 0x400000, page_size: 0x1000, caps: 0},
    Host{arch: ?arch.RISCV32, interpreter: "/lib/ld-linux-riscv32-ilp32d.so.1", libdirs: ?LINUX_RISCV32_LIBDIRS[0], libdir_count: 6, image_base: 0x400000, page_size: 0x1000, caps: 0},
};

# darwin: PLATFORM_MACOS in LC_BUILD_VERSION, and the minimum macOS 11.0
val DARWIN_CODES:          [1]Code    = [1]Code{Code{format: ?format.MACHO, value: 1}};
val DARWIN_FORMATS:        [1]*Format = [1]*Format{?format.MACHO};
val DARWIN_LIBDIRS:        [2]str     = [2]str{"/usr/lib", "/usr/local/lib"};
val DARWIN_LIBRARIES:      [1]str     = [1]str{"/usr/lib/libSystem.B.dylib"};
val DARWIN_FRAMEWORK_DIRS: [1]str     = [1]str{"/System/Library/Frameworks"};

# the aarch64 host declares position independent executables and PSTATE.DIT; x86_64 declares neither
val DARWIN_HOSTS: [2]Host = [2]Host{
    Host{arch: ?arch.X86_64, interpreter: "", libdirs: ?DARWIN_LIBDIRS[0], libdir_count: 2, image_base: 0x100000000, page_size: 0x1000, caps: 0},
    Host{arch: ?arch.AARCH64, interpreter: "", libdirs: ?DARWIN_LIBDIRS[0], libdir_count: 2, image_base: 0x100000000, page_size: 0x4000, caps: PIE_DEFAULT | DIT_GUARANTEED},
};

# windows: IMAGE_SUBSYSTEM_WINDOWS_CUI in the PE optional header
val WINDOWS_CODES:     [1]Code    = [1]Code{Code{format: ?format.COFF, value: 3}};
val WINDOWS_FORMATS:   [1]*Format = [1]*Format{?format.COFF};
val WINDOWS_LIBDIRS:   [1]str     = [1]str{"C:\\Windows\\System32"};
val WINDOWS_LIBRARIES: [1]str     = [1]str{"kernel32.dll"};

val WINDOWS_HOSTS: [2]Host = [2]Host{
    Host{arch: ?arch.X86_64, interpreter: "", libdirs: ?WINDOWS_LIBDIRS[0], libdir_count: 1, image_base: 0x140000000, page_size: 0x1000, caps: PIE_DEFAULT},
    Host{arch: ?arch.AARCH64, interpreter: "", libdirs: ?WINDOWS_LIBDIRS[0], libdir_count: 1, image_base: 0x140000000, page_size: 0x1000, caps: 0},
};

# freestanding: no loader maps the image, so the format and the isa pick the page
val FREESTANDING_FORMATS: [2]*Format = [2]*Format{?format.ELF, ?format.FLAT};

val FREESTANDING_HOSTS: [4]Host = [4]Host{
    Host{arch: ?arch.X86_64, interpreter: "", libdirs: nil, libdir_count: 0, image_base: 0, page_size: 0, caps: 0},
    Host{arch: ?arch.AARCH64, interpreter: "", libdirs: nil, libdir_count: 0, image_base: 0, page_size: 0, caps: 0},
    Host{arch: ?arch.RISCV64, interpreter: "", libdirs: nil, libdir_count: 0, image_base: 0, page_size: 0, caps: 0},
    Host{arch: ?arch.RISCV32, interpreter: "", libdirs: nil, libdir_count: 0, image_base: 0, page_size: 0, caps: 0},
};

# wasi preview1: a wasm32 module importing from wasi_snapshot_preview1, the
# import module its runtime resolves, entry _start. no loader maps the module
val WASI_FORMATS:   [1]*Format = [1]*Format{?format.WASM};
val WASI_LIBRARIES: [1]str     = [1]str{"wasi_snapshot_preview1"};

val WASI_HOSTS: [1]Host = [1]Host{
    Host{arch: ?arch.WASM32, interpreter: "", libdirs: nil, libdir_count: 0, image_base: 0, page_size: 0x1_0000, caps: 0},
};

# vulkan and opencl: spir-v modules only, whose entry points the module names
# itself, so no entry is fixed. no loader maps them
val SPIRV_FORMATS: [1]*Format = [1]*Format{?format.SPIRV};

val SPIRV_HOSTS: [1]Host = [1]Host{
    Host{arch: ?arch.SPIRV, interpreter: "", libdirs: nil, libdir_count: 0, image_base: 0, page_size: 0, caps: 0},
};

val ROW_COUNT: usize         = 7;
val ROWS:      [ROW_COUNT]Os = [ROW_COUNT]Os{
    Os{
        name:                "linux",
        codes:               ?LINUX_CODES[0],
        code_count:          1,
        hosts:               ?LINUX_HOSTS[0],
        host_count:          5,
        entry:               "_start",
        mapped:              true,
        formats:             ?LINUX_FORMATS[0],
        format_count:        1,
        libraries:           nil,
        library_count:       0,
        framework_dirs:      nil,
        framework_dir_count: 0,
        min_version:         Version{major: 0, minor: 0, patch: 0},
    },
    Os{
        name:                "darwin",
        codes:               ?DARWIN_CODES[0],
        code_count:          1,
        hosts:               ?DARWIN_HOSTS[0],
        host_count:          2,
        entry:               "start",
        mapped:              true,
        formats:             ?DARWIN_FORMATS[0],
        format_count:        1,
        libraries:           ?DARWIN_LIBRARIES[0],
        library_count:       1,
        framework_dirs:      ?DARWIN_FRAMEWORK_DIRS[0],
        framework_dir_count: 1,
        min_version:         Version{major: 11, minor: 0, patch: 0},
    },
    Os{
        name:                "windows",
        codes:               ?WINDOWS_CODES[0],
        code_count:          1,
        hosts:               ?WINDOWS_HOSTS[0],
        host_count:          2,
        entry:               "mainCRTStartup",
        mapped:              true,
        formats:             ?WINDOWS_FORMATS[0],
        format_count:        1,
        libraries:           ?WINDOWS_LIBRARIES[0],
        library_count:       1,
        framework_dirs:      nil,
        framework_dir_count: 0,
        min_version:         Version{major: 0, minor: 0, patch: 0},
    },
    Os{
        name:                "freestanding",
        codes:               nil,
        code_count:          0,
        hosts:               ?FREESTANDING_HOSTS[0],
        host_count:          4,
        entry:               "_start",
        mapped:              false,
        formats:             ?FREESTANDING_FORMATS[0],
        format_count:        2,
        libraries:           nil,
        library_count:       0,
        framework_dirs:      nil,
        framework_dir_count: 0,
        min_version:         Version{major: 0, minor: 0, patch: 0},
    },
    Os{
        name:                "wasi",
        codes:               nil,
        code_count:          0,
        hosts:               ?WASI_HOSTS[0],
        host_count:          1,
        entry:               "_start",
        mapped:              false,
        formats:             ?WASI_FORMATS[0],
        format_count:        1,
        libraries:           ?WASI_LIBRARIES[0],
        library_count:       1,
        framework_dirs:      nil,
        framework_dir_count: 0,
        min_version:         Version{major: 0, minor: 0, patch: 0},
    },
    Os{
        name:                "vulkan",
        codes:               nil,
        code_count:          0,
        hosts:               ?SPIRV_HOSTS[0],
        host_count:          1,
        entry:               nil,
        mapped:              false,
        formats:             ?SPIRV_FORMATS[0],
        format_count:        1,
        libraries:           nil,
        library_count:       0,
        framework_dirs:      nil,
        framework_dir_count: 0,
        min_version:         Version{major: 0, minor: 0, patch: 0},
    },
    Os{
        name:                "opencl",
        codes:               nil,
        code_count:          0,
        hosts:               ?SPIRV_HOSTS[0],
        host_count:          1,
        entry:               nil,
        mapped:              false,
        formats:             ?SPIRV_FORMATS[0],
        format_count:        1,
        libraries:           nil,
        library_count:       0,
        framework_dirs:      nil,
        framework_dir_count: 0,
        min_version:         Version{major: 0, minor: 0, patch: 0},
    },
};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Os {
    ret ?ROWS[index];
}

pub fun by_name(name: str) res[*Os, Fail] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].name, name)) { ret res[*Os, Fail].ok{?ROWS[i]}; }
        i = i + 1;
    }
    ret res[*Os, Fail].err{fail.unsupported("no operating system has this name")};
}

# what `o` says for `a`, refused when the system does not run it
pub fun host(o: *Os, a: *Arch) res[*Host, Fail] {
    var i: usize = 0;
    for (i < o.host_count) {
        if (o.hosts[i].arch == a) { ret res[*Host, Fail].ok{?o.hosts[i]}; }
        i = i + 1;
    }
    ret res[*Host, Fail].err{fail.unsupported("the operating system does not run this architecture")};
}

# how `f` names `o`, none when it does not
pub fun code(o: *Os, f: *Format) opt[Code] {
    var k: usize = 0;
    for (k < o.code_count) {
        if (o.codes[k].format == f) { ret opt[Code].some{o.codes[k]}; }
        k = k + 1;
    }
    ret opt[Code].none{};
}

# whether `o` accepts `f` as an output format
pub fun accepts(o: *Os, f: *Format) bool {
    var k: usize = 0;
    for (k < o.format_count) {
        if (o.formats[k] == f) { ret true; }
        k = k + 1;
    }
    ret false;
}

# whether host `h` declares every bit of `c`
pub fun host_has(h: *Host, c: Caps) bool {
    ret (h.caps & c) == c;
}

# whether `got` holds the `want_n` directories `want` names, in order
fun dirs_are(got: *str, n: usize, want: *str, want_n: usize) bool {
    if (n != want_n) { ret false; }
    var k: usize = 0;
    for (k < n) {
        if (!str_equals(got[k], want[k])) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether `h` runs `a` with this interpreter, image base, page and caps
fun host_is(h: *Host, a: *Arch, interp: str, base: u64, page: u64, caps: Caps) bool {
    ret h.arch == a && str_equals(h.interpreter, interp) && h.image_base == base && h.page_size == page && h.caps == caps;
}

test os__system_rows_match_the_compiler {
    if (ROW_COUNT != 7) { ret 1; }

    val lin:     *Os    = ?ROWS[0];
    val lin_x64: [6]str = [6]str{"/lib64", "/usr/lib64", "/lib/x86_64-linux-gnu", "/usr/lib/x86_64-linux-gnu", "/usr/lib", "/lib"};
    val lin_x86: [6]str = [6]str{"/lib32", "/usr/lib32", "/lib/i386-linux-gnu", "/usr/lib/i386-linux-gnu", "/usr/lib", "/lib"};
    val lin_a64: [6]str = [6]str{"/lib/aarch64-linux-gnu", "/usr/lib/aarch64-linux-gnu", "/lib64", "/usr/lib64", "/usr/lib", "/lib"};
    val lin_r64: [6]str = [6]str{"/lib/riscv64-linux-gnu", "/usr/lib/riscv64-linux-gnu", "/lib64", "/usr/lib64", "/usr/lib", "/lib"};
    val lin_r32: [6]str = [6]str{"/lib/riscv32-linux-gnu", "/usr/lib/riscv32-linux-gnu", "/lib32", "/usr/lib32", "/usr/lib", "/lib"};
    if (!str_equals(lin.name, "linux") || !str_equals(lin.entry, "_start") || !lin.mapped)                        { ret 1; }
    if (lin.code_count != 1 || lin.codes[0].format != ?format.ELF || lin.codes[0].value != 0)                     { ret 1; }
    if (lin.format_count != 1 || lin.formats[0] != ?format.ELF)                                                   { ret 1; }
    if (lin.library_count != 0 || lin.framework_dir_count != 0)                                                   { ret 1; }
    if (lin.min_version.major != 0)                                                                               { ret 1; }
    if (lin.host_count != 5)                                                                                      { ret 1; }
    if (!host_is(?lin.hosts[0], ?arch.X86_64, "/lib64/ld-linux-x86-64.so.2", 0x400000, 0x1000, 0))                { ret 1; }
    if (!dirs_are(lin.hosts[0].libdirs, lin.hosts[0].libdir_count, ?lin_x64[0], 6))                               { ret 1; }
    if (!host_is(?lin.hosts[1], ?arch.X86, "/lib/ld-linux.so.2", 0x400000, 0x1000, 0))                            { ret 1; }
    if (!dirs_are(lin.hosts[1].libdirs, lin.hosts[1].libdir_count, ?lin_x86[0], 6))                               { ret 1; }
    if (!host_is(?lin.hosts[2], ?arch.AARCH64, "/lib/ld-linux-aarch64.so.1", 0x400000, 0x1_0000, DIT_GUARANTEED)) { ret 1; }
    if (!dirs_are(lin.hosts[2].libdirs, lin.hosts[2].libdir_count, ?lin_a64[0], 6))                               { ret 1; }
    if (!host_is(?lin.hosts[3], ?arch.RISCV64, "/lib/ld-linux-riscv64-lp64d.so.1", 0x400000, 0x1000, 0))          { ret 1; }
    if (!dirs_are(lin.hosts[3].libdirs, lin.hosts[3].libdir_count, ?lin_r64[0], 6))                               { ret 1; }
    if (!host_is(?lin.hosts[4], ?arch.RISCV32, "/lib/ld-linux-riscv32-ilp32d.so.1", 0x400000, 0x1000, 0))         { ret 1; }
    if (!dirs_are(lin.hosts[4].libdirs, lin.hosts[4].libdir_count, ?lin_r32[0], 6))                               { ret 1; }

    val dar:      *Os    = ?ROWS[1];
    val dar_dirs: [2]str = [2]str{"/usr/lib", "/usr/local/lib"};
    if (!str_equals(dar.name, "darwin") || !str_equals(dar.entry, "start") || !dar.mapped)                { ret 1; }
    if (dar.code_count != 1 || dar.codes[0].format != ?format.MACHO || dar.codes[0].value != 1)           { ret 1; }
    if (dar.format_count != 1 || dar.formats[0] != ?format.MACHO)                                         { ret 1; }
    if (dar.library_count != 1 || !str_equals(dar.libraries[0], "/usr/lib/libSystem.B.dylib"))            { ret 1; }
    if (dar.framework_dir_count != 1 || !str_equals(dar.framework_dirs[0], "/System/Library/Frameworks")) { ret 1; }
    if (dar.min_version.major != 11 || dar.min_version.minor != 0 || dar.min_version.patch != 0)          { ret 1; }
    if (dar.host_count != 2)                                                                              { ret 1; }
    if (!host_is(?dar.hosts[0], ?arch.X86_64, "", 0x100000000, 0x1000, 0))                                { ret 1; }
    if (!dirs_are(dar.hosts[0].libdirs, dar.hosts[0].libdir_count, ?dar_dirs[0], 2))                      { ret 1; }
    if (!host_is(?dar.hosts[1], ?arch.AARCH64, "", 0x100000000, 0x4000, PIE_DEFAULT | DIT_GUARANTEED))    { ret 1; }
    if (!dirs_are(dar.hosts[1].libdirs, dar.hosts[1].libdir_count, ?dar_dirs[0], 2))                      { ret 1; }

    val win:      *Os    = ?ROWS[2];
    val win_dirs: [1]str = [1]str{"C:\\Windows\\System32"};
    if (!str_equals(win.name, "windows") || !str_equals(win.entry, "mainCRTStartup") || !win.mapped) { ret 1; }
    if (win.code_count != 1 || win.codes[0].format != ?format.COFF || win.codes[0].value != 3)       { ret 1; }
    if (win.format_count != 1 || win.formats[0] != ?format.COFF)                                     { ret 1; }
    if (win.library_count != 1 || !str_equals(win.libraries[0], "kernel32.dll"))                     { ret 1; }
    if (win.framework_dir_count != 0 || win.min_version.major != 0)                                  { ret 1; }
    if (win.host_count != 2)                                                                         { ret 1; }
    if (!host_is(?win.hosts[0], ?arch.X86_64, "", 0x140000000, 0x1000, PIE_DEFAULT))                 { ret 1; }
    if (!dirs_are(win.hosts[0].libdirs, win.hosts[0].libdir_count, ?win_dirs[0], 1))                 { ret 1; }
    if (!host_is(?win.hosts[1], ?arch.AARCH64, "", 0x140000000, 0x1000, 0))                          { ret 1; }
    if (!dirs_are(win.hosts[1].libdirs, win.hosts[1].libdir_count, ?win_dirs[0], 1))                 { ret 1; }

    val fs: *Os = ?ROWS[3];
    if (!str_equals(fs.name, "freestanding") || !str_equals(fs.entry, "_start") || fs.mapped)                        { ret 1; }
    if (fs.code_count != 0 || fs.format_count != 2 || fs.formats[0] != ?format.ELF || fs.formats[1] != ?format.FLAT) { ret 1; }
    if (fs.library_count != 0 || fs.framework_dir_count != 0)                                                        { ret 1; }
    if (fs.host_count != 4)                                                                                          { ret 1; }
    if (!host_is(?fs.hosts[0], ?arch.X86_64, "", 0, 0, 0))                                                           { ret 1; }
    if (!host_is(?fs.hosts[1], ?arch.AARCH64, "", 0, 0, 0))                                                          { ret 1; }
    if (!host_is(?fs.hosts[2], ?arch.RISCV64, "", 0, 0, 0))                                                          { ret 1; }
    if (!host_is(?fs.hosts[3], ?arch.RISCV32, "", 0, 0, 0))                                                          { ret 1; }

    val wasi: *Os = ?ROWS[4];
    if (!str_equals(wasi.name, "wasi") || !str_equals(wasi.entry, "_start") || wasi.mapped)  { ret 1; }
    if (wasi.code_count != 0 || wasi.format_count != 1 || wasi.formats[0] != ?format.WASM)   { ret 1; }
    if (wasi.library_count != 1 || !str_equals(wasi.libraries[0], "wasi_snapshot_preview1")) { ret 1; }
    if (wasi.host_count != 1 || !host_is(?wasi.hosts[0], ?arch.WASM32, "", 0, 0x1_0000, 0))  { ret 1; }

    val vk: *Os = ?ROWS[5];
    if (!str_equals(vk.name, "vulkan") || vk.entry != nil || vk.mapped)                                  { ret 1; }
    if (vk.code_count != 0 || vk.format_count != 1 || vk.formats[0] != ?format.SPIRV)                    { ret 1; }
    if (vk.library_count != 0 || vk.host_count != 1 || !host_is(?vk.hosts[0], ?arch.SPIRV, "", 0, 0, 0)) { ret 1; }

    val cl: *Os = ?ROWS[6];
    if (!str_equals(cl.name, "opencl") || cl.entry != nil || cl.mapped)                                  { ret 1; }
    if (cl.code_count != 0 || cl.format_count != 1 || cl.formats[0] != ?format.SPIRV)                    { ret 1; }
    if (cl.library_count != 0 || cl.host_count != 1 || !host_is(?cl.hosts[0], ?arch.SPIRV, "", 0, 0, 0)) { ret 1; }
    ret 0;
}
