# the identity of every format mink knows
#
# a format is named here once and everything that crosses formats, the codes
# an architecture or a system carries in each, refers to its row.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

# name:      how the format is spelled on the command line and in a dump
# qualified: whether a code's qualifier takes part in telling rows apart, as
#            ELF's file class tells RV32 from RV64 under one machine number
pub rec Format {
    name:      str;
    qualified: bool;
}

pub val ELF:   Format = Format{name: "elf", qualified: true};
pub val COFF:  Format = Format{name: "coff", qualified: false};
pub val MACHO: Format = Format{name: "macho", qualified: false};
pub val AR:    Format = Format{name: "ar", qualified: false};
pub val WASM:  Format = Format{name: "wasm", qualified: false};
pub val SPIRV: Format = Format{name: "spirv", qualified: false};
pub val FLAT:  Format = Format{name: "flat", qualified: false};

val ROW_COUNT: usize              = 7;
val ROWS:      [ROW_COUNT]*Format = [ROW_COUNT]*Format{?ELF, ?COFF, ?MACHO, ?AR, ?WASM, ?SPIRV, ?FLAT};

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun at(index: usize) *Format {
    ret ROWS[index];
}

# how a row names itself in one format: the format's own code for it, and a
# qualifier the format reads beside the code, such as ELF's EI_CLASS or a
# Mach-O cpu subtype. a row a format does not name has no code for it
pub rec Code {
    format:    *Format;
    value:     u32;
    qualifier: u32;
}

# whether `c` names what a format's (value, qualifier) pair names
pub fun matches(c: *Code, f: *Format, value: u32, qualifier: u32) bool {
    if (c.format != f || c.value != value) { ret false; }
    ret !f.qualified || c.qualifier == qualifier;
}
