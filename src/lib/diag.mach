# renders a failure as one diagnostic line
#
# every diagnostic of mink starts with the one prefix `mink:`, then the
# location the failure names, then its text:
#
#     mink: a.o: section header 7, offset 0x1c8: read past the end of the data
#
# a failure about an item and a number names them before its text, each
# omitted when absent:
#
#     mink: a.o: section 3, offset 0x10: R_X86_64_PC32, value 4294967296: relocation value is out of range

use std.types.bool.bool;
use std.types.error.err;
use std.types.size.usize;

use A: std.allocator;
use std.allocator.testing;
use std.memory;

use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;
use mink.lib.reader.LITTLE;
use mink.lib.sink;
use mink.lib.sink.Sink;

pub val PREFIX: *u8 = "mink: ";

# append the diagnostic for `f` and a newline to `out`
pub fun render(f: Fail, out: *Sink) err[Fail] {
    val wp: err[Fail] = sink.text(out, PREFIX);
    if (sel wp.err) { ret wp; }
    val wl: err[Fail] = location(f.at, out);
    if (sel wl.err) { ret wl; }
    val wj: err[Fail] = about(f, out);
    if (sel wj.err) { ret wj; }
    val wt: err[Fail] = sink.text(out, f.text);
    if (sel wt.err) { ret wt; }
    ret sink.text(out, "\n");
}

# the subject and the value, each followed by `, ` or the last by `: `
fun about(f: Fail, out: *Sink) err[Fail] {
    val named: bool = f.subject != nil;
    if (named) {
        val ws: err[Fail] = sink.text(out, f.subject);
        if (sel ws.err) { ret ws; }
    }
    if (sel f.value.some) {
        if (named) {
            val wc: err[Fail] = sink.text(out, ", ");
            if (sel wc.err) { ret wc; }
        }
        val wl: err[Fail] = sink.text(out, "value ");
        if (sel wl.err) { ret wl; }
        val wv: err[Fail] = decimal(f.value.some, out);
        if (sel wv.err) { ret wv; }
    }
    if (!named && sel f.value.none) { ret err[Fail].ok{}; }
    ret sink.text(out, ": ");
}

# `v` in decimal, signed
fun decimal(v: i128, out: *Sink) err[Fail] {
    var digits: [40]u8;
    var n:      usize = 40;
    var m:      u128  = v::u128;
    if (v < 0) { m = (0::u128) - v::u128; }
    for {
        n         = n - 1;
        digits[n] = '0' + (m % 10)::u8;
        m         = m / 10;
        if (m == 0) { brk; }
    }
    if (v < 0) {
        val wm: err[Fail] = sink.text(out, "-");
        if (sel wm.err) { ret wm; }
    }
    ret sink.bytes(out, ?digits[n], 40 - n);
}

# `file: `, then `record index` and `offset 0xN` joined by a comma, then `: `
fun location(at: Location, out: *Sink) err[Fail] {
    if (at.file != nil) {
        val wf: err[Fail] = sink.text(out, at.file);
        if (sel wf.err) { ret wf; }
        val ws: err[Fail] = sink.text(out, ": ");
        if (sel ws.err) { ret ws; }
    }
    if (at.record != nil) {
        val wr: err[Fail] = sink.text(out, at.record);
        if (sel wr.err) { ret wr; }
        if (at.indexed) {
            val wi: err[Fail] = sink.text(out, " ");
            if (sel wi.err) { ret wi; }
            val wn: err[Fail] = sink.number(out, at.index, 10);
            if (sel wn.err) { ret wn; }
        }
        if (!at.placed) { ret sink.text(out, ": "); }
        val wc: err[Fail] = sink.text(out, ", ");
        if (sel wc.err) { ret wc; }
    }
    if (!at.placed) { ret err[Fail].ok{}; }
    val wo: err[Fail] = sink.text(out, "offset 0x");
    if (sel wo.err) { ret wo; }
    val wv: err[Fail] = sink.number(out, at.offset, 16);
    if (sel wv.err) { ret wv; }
    ret sink.text(out, ": ");
}

test diag__renders_prefix_file_record_and_offset {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    var out: Sink = sink.make(testing.allocator_of(?t), LITTLE);
    var f:   Fail = fail.at_offset(fail.truncated("read past the end of the data"), 0x1c8);
    f = fail.in_file(fail.in_indexed(f, "section header", 7), "a.o");
    val w: err[Fail] = render(f, ?out);
    if (sel w.err) { ret 1; }
    val want: *u8   = "mink: a.o: section header 7, offset 0x1c8: read past the end of the data\n";
    val n:    usize = 73;
    if (sink.len(?out) != n)                                   { ret 1; }
    if (!memory.raw_equal(sink.data(?out)::ptr, want::ptr, n)) { ret 1; }
    val up: err[Fail] = sink.release(?out);
    if (sel up.err) { ret 1; }

    # a subject and a value come before the text, each omitted when absent
    out = sink.make(testing.allocator_of(?t), LITTLE);
    var g: Fail = fail.at_offset(fail.in_indexed(fail.in_file(fail.overflow("relocation value is out of range"), "a.o"), "section", 3), 0x10);
    g = fail.valued(fail.about(g, "R_X86_64_PC32"), 0x1_0000_0000);
    g = fail.valued(fail.about(g, "other"), 7);
    val wg: err[Fail] = render(g, ?out);
    if (sel wg.err) { ret 1; }
    val want2: *u8 = "mink: a.o: section 3, offset 0x10: R_X86_64_PC32, value 4294967296: relocation value is out of range\n";
    if (sink.len(?out) != 101)                                    { ret 1; }
    if (!memory.raw_equal(sink.data(?out)::ptr, want2::ptr, 101)) { ret 1; }
    val rel: err[Fail] = sink.release(?out);
    if (sel rel.err) { ret 1; }
    testing.dnit(?t);
    ret 0;
}
