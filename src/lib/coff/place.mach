# where each extent of a PE/COFF file lies, and the record that holds a byte
#
# the reader's extents tile the file in file order, so the offset of each extent is the
# sum of the lengths before it. the index is built for each lookup and searched by binary
# search over the offsets it holds. a byte no extent holds has no record.

use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.lib.checked;
use mink.lib.coff.import;
use mink.lib.coff.import.Import;
use mink.lib.coff.model;
use mink.lib.coff.model.Coff;
use mink.lib.coff.model.Extent;
use mink.lib.coff.read.Parsed;
use mink.lib.coff.tables;
use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;
use mink.lib.store.Bytes;
use mink.lib.table;
use mink.lib.table.Id;
use mink.lib.table.Table;

# the size of a short import object header
val IMPORT_HEADER_SIZE: u64 = 20;

# an extent and the file offset it starts at
rec Place {
    offset: u64;
    extent: usize;
}

# the location of byte `offset` of a file read as `p`
pub fun locate_parsed(p: *Parsed, offset: u64) Location {
    if (sel p.object) { ret locate(?p.object, offset); }
    or (sel p.short)  { ret locate_import(?p.short, offset); }
}

# the record of a short import object that holds byte `offset`: its header, then its
# symbol name, its DLL name, its third name when the name type takes one, and the rest
pub fun locate_import(i: *Import, offset: u64) Location {
    if (offset < IMPORT_HEADER_SIZE) { ret Location{record: "import header", offset: offset, placed: true}; }
    var start: u64   = IMPORT_HEADER_SIZE;
    val sym:   Bytes = import.bytes(i, ?i.symbol);
    if (offset - start < sym.len::u64 + 1) { ret Location{record: "symbol name", offset: offset - start, placed: true}; }
    start = start + sym.len::u64 + 1;
    val dll: Bytes = import.bytes(i, ?i.dll);
    if (offset - start < dll.len::u64 + 1) { ret Location{record: "DLL name", offset: offset - start, placed: true}; }
    start = start + dll.len::u64 + 1;
    if (sel i.export_as.some) {
        val extra: Bytes = import.bytes(i, ?i.export_as.some);
        if (offset - start < extra.len::u64 + 1) { ret Location{record: "export name", offset: offset - start, placed: true}; }
        start = start + extra.len::u64 + 1;
    }
    ret Location{record: "import data", offset: offset - start, placed: true};
}

# the location of byte `offset` of the file, its record and its offset in that record,
# or no record when no extent holds the byte
pub fun locate(m: *Coff, offset: u64) Location {
    val built: res[Table[Place], Fail] = index(m);
    if (sel built.err) { ret Location{offset: offset, record: built.err.text, placed: true}; }
    var t:  Table[Place] = built.ok;
    var lo: usize        = 0;
    var hi: usize        = table.count[Place](?t);
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (table.at[Place](?t, table.nth[Place](mid)).offset <= offset) { lo = mid + 1; }
        or                                                               { hi = mid; }
    }
    var out: Location = Location{offset: offset};
    if (lo > 0) {
        val p:   *Place         = table.at[Place](?t, table.nth[Place](lo - 1));
        val len: res[u64, Fail] = model.extent_len(m, table.at[Extent](?m.extents, table.nth[Extent](p.extent)));
        if (sel len.err) { out = Location{offset: offset, record: len.err.text, placed: true}; }
        or (sel len.ok) {
            if (offset - p.offset < len.ok) {
                out = named(m, p.extent, offset - p.offset);
            }
        }
    }
    val rel: err[Fail] = table.release[Place](?t);
    if (sel rel.err) { ret Location{offset: offset, record: rel.err.text, placed: true}; }
    ret out;
}

# the extents of `m` with the offset each starts at
fun index(m: *Coff) res[Table[Place], Fail] {
    var t:  Table[Place] = table.make[Place](m.a);
    var at: u64          = 0;
    var i:  usize        = 0;
    for (i < table.count[Extent](?m.extents)) {
        val len: res[u64, Fail] = model.extent_len(m, table.at[Extent](?m.extents, table.nth[Extent](i)));
        if (sel len.err) { ret res[Table[Place], Fail].err{len.err}; }
        val pushed: res[Id[Place], Fail] = table.push[Place](?t, Place{offset: at, extent: i});
        if (sel pushed.err) { ret res[Table[Place], Fail].err{pushed.err}; }
        val end: res[u64, Fail] = checked.add(Location{}, at, len.ok);
        if (sel end.err) { ret res[Table[Place], Fail].err{end.err}; }
        at = end.ok;
        i  = i + 1;
    }
    ret res[Table[Place], Fail].ok{t};
}

# the record of extent `i`, with the offset in it
fun named(m: *Coff, i: usize, offset: u64) Location {
    val e: *Extent = table.at[Extent](?m.extents, table.nth[Extent](i));
    if (sel e.dos)       { ret Location{record: "DOS header", offset: offset, placed: true}; }
    or (sel e.signature) { ret Location{record: "PE signature", offset: offset, placed: true}; }
    or (sel e.header)    { ret Location{record: "file header", offset: offset, placed: true}; }
    or (sel e.optional)  { ret Location{record: "optional header", offset: offset, placed: true}; }
    or (sel e.sections)  { ret Location{record: "section table", offset: offset, placed: true}; }
    or (sel e.section)   { ret indexed("section", e.section.index::u64, offset); }
    or (sel e.lines)     { ret indexed("line numbers", e.lines.index::u64, offset); }
    or (sel e.relocs)    { ret indexed("relocations", e.relocs.index::u64, offset); }
    or (sel e.symbols)   { ret Location{record: "symbol table", offset: offset, placed: true}; }
    or (sel e.strings)   { ret Location{record: "string table", offset: offset, placed: true}; }
    or (sel e.tiled)     { ret Location{record: "typed records", offset: offset, placed: true}; }
    or                   { ret Location{record: "raw", offset: offset, placed: true}; }
}

fun indexed(record: str, index: u64, offset: u64) Location {
    ret Location{record: record, index: index, indexed: true, offset: offset, placed: true};
}
