pub fun dump(m: ptr, d: *Dumper) err[Fail] {
    ret describe(m::*Coff, d);
}

# what a dump walks: the model and the dumper
rec Ctx {
    m: *Coff;
    d: *Dumper;
}

# the relocation table of a machine, by its file header code. the ARM64 rows share one
# table, and a machine mink has no table for has none
rec Machine {
    code: *Constant;
    rel:  *Set;
}

val MACHINE_COUNT: usize                  = 6;
val MACHINES:      [MACHINE_COUNT]Machine = [MACHINE_COUNT]Machine{
    Machine{code: ?tables.IMAGE_FILE_MACHINE_AMD64, rel: ?tables.REL_AMD64},
    Machine{code: ?tables.IMAGE_FILE_MACHINE_I386, rel: ?tables.REL_I386},
    Machine{code: ?tables.IMAGE_FILE_MACHINE_ARM, rel: ?tables.REL_ARM},
    Machine{code: ?tables.IMAGE_FILE_MACHINE_ARM64, rel: ?tables.REL_ARM64},
    Machine{code: ?tables.IMAGE_FILE_MACHINE_ARM64EC, rel: ?tables.REL_ARM64},
    Machine{code: ?tables.IMAGE_FILE_MACHINE_ARM64X, rel: ?tables.REL_ARM64},
};

# the bytes left in a load configuration's size, the offset reached and the width of
# a pointer-sized field. a field past the size is not in the file
rec Layout {
    off:  u64;
    size: u64;
}

# the file as the model holds it, in file order, each part under the name llvm-readobj
# gives it
# ---
# m: the model to print
# d: the dumper that prints it
pub fun describe(m: *Coff, d: *Dumper) err[Fail] {
    var c:  Ctx       = Ctx{m: m, d: d};
    val w1: err[Fail] = dos_header(?c);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = file_header(?c);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = optional_header(?c);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = sections(?c);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = relocations(?c);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = symbols(?c);
    if (sel w6.err) { ret w6; }
    ret directories(?c);
}

# the constant named `v` in table `s`, none when the table has no row for it
fun name_in(s: *Set, v: u64) opt[str] {
    if (s == nil) { ret opt[str].none{}; }
    val c: opt[*Constant] = tables.name_of(s, v);
    if (sel c.some) { ret opt[str].some{c.some.name}; }
    ret opt[str].none{};
}

# the name of `v` in table `s` with the prefix every row of the table carries dropped
fun short_in(s: *Set, v: u64, prefix: str) opt[str] {
    val n: opt[str] = name_in(s, v);
    if (sel n.some) { ret opt[str].some{strip(n.some, prefix)}; }
    ret opt[str].none{};
}

# `name` without its leading `prefix`, or `name` when it does not start with it
fun strip(name: str, prefix: str) str {
    val n: usize = str_len(prefix);
    if (str_len(name) < n) { ret name; }
    var i: usize = 0;
    for (i < n) {
        if (name[i] != prefix[i]) { ret name; }
        i = i + 1;
    }
    ret ?name[n];
}

# whether flag `e` is set in `v`. under `mask`, a row whose bits lie in the mask is one
# field, set when the masked bits of `v` equal it
fun flag_set(v: u64, e: u64, mask: u64) bool {
    if (mask != 0 && (e & ~mask) == 0) { ret (v & mask) == e; }
    ret (v & e) == e;
}

# a flags field: each row of `s` set in `v`, named with the prefix dropped
fun flags(d: *Dumper, key: u32, v: u64, s: *Set, prefix: str, mask: u64) err[Fail] {
    val wo: err[Fail] = format_dump.open_valued_list(d, key, v);
    if (sel wo.err) { ret wo; }
    var i: usize = 0;
    for (i < s.count) {
        val e: u64 = s.rows[i].value;
        if (e != 0 && flag_set(v, e, mask)) {
            val wi: err[Fail] = format_dump.item(d, strip(s.rows[i].name, prefix), e);
            if (sel wi.err) { ret wi; }
        }
        i = i + 1;
    }
    ret format_dump.close_list(d);
}

# a value with its name from `s`, the prefix dropped, and its number
fun named_short(d: *Dumper, key: u32, v: u64, s: *Set, prefix: str) err[Fail] {
    ret format_dump.named(d, key, v, short_in(s, v, prefix));
}

# the name of a row with the prefix dropped and each word spelled as llvm-readobj spells the
# names of these tables: the first letter of a word capitalised, the rest lower case, the
# underscores between words dropped
fun display(d: *Dumper, name: str, prefix: str) err[Fail] {
    var up: bool  = true;
    var i:  usize = str_len(prefix);
    for (i < str_len(name)) {
        val ch: u8 = name[i];
        if (ch == '_') {
            up = true;
        }
        or {
            var out: u8 = ch;
            if (up && ch >= 'a' && ch <= 'z')  { out = ch - 32; }
            if (!up && ch >= 'A' && ch <= 'Z') { out = ch + 32; }
            val wc: err[Fail] = format_dump.char(d, out);
            if (sel wc.err) { ret wc; }
            up = false;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# a value with its row's name spelled by `display`, and its number
fun named_display(d: *Dumper, key: u32, v: u64, s: *Set, prefix: str) err[Fail] {
    val wf: err[Fail] = format_dump.field(d, key);
    if (sel wf.err) { ret wf; }
    val row: opt[*Constant] = tables.name_of(s, v);
    if (sel row.some) {
        val wn: err[Fail] = display(d, row.some.name, prefix);
        if (sel wn.err) { ret wn; }
        val wp: err[Fail] = format_dump.text(d, " (");
        if (sel wp.err) { ret wp; }
    }
    val wv: err[Fail] = format_dump.hex_value(d, v);
    if (sel wv.err)   { ret wv; }
    if (sel row.some) { ret format_dump.text(d, ")\n"); }
    ret format_dump.text(d, "\n");
}

# a value with its name from `s` as the table spells it, and its number
fun named_full(d: *Dumper, key: u32, v: u64, s: *Set) err[Fail] {
    ret format_dump.named(d, key, v, name_in(s, v));
}

# `n` uppercase hex digits of `v` written at `at`
fun upper(out: *u8, at: usize, v: u64, n: usize) {
    var k: usize = 0;
    for (k < n) {
        val sh:  u64 = (4 * (n - 1 - k))::u64;
        val nib: u64 = (v >> sh) & 0xf;
        if (nib < 10) { out[at + k] = '0' + nib::u8; }
        or            { out[at + k] = 'A' + (nib - 10)::u8; }
        k = k + 1;
    }
}

# `n` decimal digits of `v`, zero padded, written at `at`
fun digits(out: *u8, at: usize, v: u64, n: usize) {
    var x: u64   = v;
    var k: usize = 0;
    for (k < n) {
        out[at + n - 1 - k] = '0' + (x % 10)::u8;
        x                   = x / 10;
        k                   = k + 1;
    }
}

# the UTC date and time of `t` seconds since the epoch, as YYYY-MM-DD HH:MM:SS written
# into the 19 bytes at `out`
fun civil(t: u64, out: *u8) {
    val days: u64 = t / 86400;
    val secs: u64 = t % 86400;
    val z:    u64 = days + 719468;
    val era:  u64 = z / 146097;
    val doe:  u64 = z - era * 146097;
    val yoe:  u64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    val doy:  u64 = doe - (365 * yoe + yoe / 4 - yoe / 100);
    val mp:   u64 = (5 * doy + 2) / 153;
    val day:  u64 = doy - (153 * mp + 2) / 5 + 1;
    var mon:  u64 = mp + 3;
    var year: u64 = yoe + era * 400;
    if (mp >= 10) { mon = mp - 9; }
    if (mon <= 2) { year = year + 1; }
    digits(out, 0, year, 4);
    out[4] = '-';
    digits(out, 5, mon, 2);
    out[7] = '-';
    digits(out, 8, day, 2);
    out[10] = ' ';
    digits(out, 11, secs / 3600, 2);
    out[13] = ':';
    digits(out, 14, (secs % 3600) / 60, 2);
    out[16] = ':';
    digits(out, 17, secs % 60, 2);
}

# a time stamp, `Key: YYYY-MM-DD HH:MM:SS (0x..)`
fun stamp(d: *Dumper, key: u32, v: u32) err[Fail] {
    var buf: [19]u8;
    civil(v::u64, ?buf[0]);
    val wl: err[Fail] = format_dump.field(d, key);
    if (sel wl.err) { ret wl; }
    val wb: err[Fail] = format_dump.raw(d, ?buf[0], 19);
    if (sel wb.err) { ret wb; }
    val wp: err[Fail] = format_dump.text(d, " (");
    if (sel wp.err) { ret wp; }
    val wv: err[Fail] = format_dump.hex_value(d, v::u64);
    if (sel wv.err) { ret wv; }
    ret format_dump.text(d, ")\n");
}

# the bytes at `p` up to a NUL, which must lie within `n` bytes, without the NUL
fun cstring(p: *u8, n: usize) res[Bytes, Fail] {
    var k: usize = 0;
    for (k < n && p[k] != 0) { k = k + 1; }
    if (k == n) { ret res[Bytes, Fail].err{fail.malformed("a name has no terminating NUL")}; }
    ret res[Bytes, Fail].ok{Bytes{data: p, len: k}};
}

# the file offset of relative virtual address `rva`, which lies in the headers or in a
# section's bytes
fun file_at(m: *Coff, rva: u64) res[u64, Fail] {
    val where: res[opt[Mapping], Fail] = model.map_rva(m, rva);
    if (sel where.err)     { ret res[u64, Fail].err{where.err}; }
    if (sel where.ok.none) { ret res[u64, Fail].err{fail.malformed("an address lies outside every section")}; }
    val at:  Mapping = where.ok.some;
    var off: u64     = 0;
    if (sel at.headers) { off = at.headers; }
    or (sel at.section) {
        val file: opt[u64] = at.section.file;
        if (sel file.none) { ret res[u64, Fail].err{fail.malformed("an address lies in zero fill")}; }
        off = file.some;
    }
    ret res[u64, Fail].ok{off};
}

# the NUL-terminated name at relative virtual address `rva`, held raw in the file
fun name_at(m: *Coff, rva: u64) res[Bytes, Fail] {
    val at: res[u64, Fail] = file_at(m, rva);
    if (sel at.err) { ret res[Bytes, Fail].err{at.err}; }
    val raw: res[opt[Bytes], Fail] = model.raw_at(m, at.ok);
    if (sel raw.err)     { ret res[Bytes, Fail].err{raw.err}; }
    if (sel raw.ok.none) { ret res[Bytes, Fail].err{fail.malformed("a name is not held as raw bytes")}; }
    ret cstring(raw.ok.some.data, raw.ok.some.len);
}

# the typed piece that starts at relative virtual address `rva`
fun piece_at_rva(m: *Coff, rva: u64, record: str) res[*Piece, Fail] {
    val at: res[u64, Fail] = file_at(m, rva);
    if (sel at.err) { ret res[*Piece, Fail].err{at.err}; }
    val p: res[opt[*Piece], Fail] = model.piece_at(m, at.ok);
    if (sel p.err)     { ret res[*Piece, Fail].err{p.err}; }
    if (sel p.ok.none) { ret res[*Piece, Fail].err{fail.in_record(fail.malformed("the address is not on a typed record"), record)}; }
    ret res[*Piece, Fail].ok{p.ok.some};
}

# the data directory `dir` of the image, a refusal for a file with no image
fun image_directory(c: *Ctx, dir: *Constant) res[DataDirectory, Fail] {
    if (sel c.m.optional.image) {
        val img: *Image = ?c.m.optional.image;
        ret res[DataDirectory, Fail].ok{@table.at[DataDirectory](?img.dirs, table.nth[DataDirectory](dir.value::usize))};
    }
    ret res[DataDirectory, Fail].err{fail.internal("data directory of a file with no image optional header")};
}

# the DOS header, which is the bytes the model holds before the PE signature
fun dos_header(c: *Ctx) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Extent](?c.m.extents)) {
        val e: *Extent = table.at[Extent](?c.m.extents, table.nth[Extent](i));
        if (sel e.dos) { ret dos_fields(c, model.bytes(c.m, ?e.dos)); }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun dos_fields(c: *Ctx, b: Bytes) err[Fail] {
    if (b.len < 64) { ret err[Fail].err{fail.in_record(fail.malformed("the DOS header is shorter than its fields"), "DOS header")}; }
    val p:  *u8       = b.data;
    val wo: err[Fail] = format_dump.open(c.d, DOS_HEADER);
    if (sel wo.err) { ret wo; }
    val wm: err[Fail] = format_dump.string(c.d, MAGIC, p, 2);
    if (sel wm.err) { ret wm; }
    val w1: err[Fail] = format_dump.decimal(c.d, USED_LAST_PAGE, slot.field(p, Slot{offset: 2, width: 2}, LITTLE));
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = format_dump.decimal(c.d, PAGES, slot.field(p, Slot{offset: 4, width: 2}, LITTLE));
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.decimal(c.d, RELOC_ITEMS, slot.field(p, Slot{offset: 6, width: 2}, LITTLE));
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.decimal(c.d, HEADER_PARAGRAPHS, slot.field(p, Slot{offset: 8, width: 2}, LITTLE));
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.decimal(c.d, MIN_EXTRA, slot.field(p, Slot{offset: 10, width: 2}, LITTLE));
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.decimal(c.d, MAX_EXTRA, slot.field(p, Slot{offset: 12, width: 2}, LITTLE));
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = format_dump.decimal(c.d, INITIAL_SS, slot.field(p, Slot{offset: 14, width: 2}, LITTLE));
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = format_dump.hex(c.d, INITIAL_SP, slot.field(p, Slot{offset: 16, width: 2}, LITTLE));
    if (sel w8.err) { ret w8; }
    val w9: err[Fail] = format_dump.hex(c.d, DOS_CHECKSUM, slot.field(p, Slot{offset: 18, width: 2}, LITTLE));
    if (sel w9.err) { ret w9; }
    val wa: err[Fail] = format_dump.hex(c.d, INITIAL_IP, slot.field(p, Slot{offset: 20, width: 2}, LITTLE));
    if (sel wa.err) { ret wa; }
    val wb: err[Fail] = format_dump.decimal(c.d, INITIAL_CS, slot.field(p, Slot{offset: 22, width: 2}, LITTLE));
    if (sel wb.err) { ret wb; }
    val wc: err[Fail] = format_dump.decimal(c.d, RELOC_TABLE, slot.field(p, Slot{offset: 24, width: 2}, LITTLE));
    if (sel wc.err) { ret wc; }
    val wd: err[Fail] = format_dump.decimal(c.d, OVERLAY, slot.field(p, Slot{offset: 26, width: 2}, LITTLE));
    if (sel wd.err) { ret wd; }
    val we: err[Fail] = format_dump.decimal(c.d, OEM_ID, slot.field(p, Slot{offset: 36, width: 2}, LITTLE));
    if (sel we.err) { ret we; }
    val wf: err[Fail] = format_dump.decimal(c.d, OEM_INFO, slot.field(p, Slot{offset: 38, width: 2}, LITTLE));
    if (sel wf.err) { ret wf; }
    val wg: err[Fail] = format_dump.decimal(c.d, NEW_HEADER, slot.field(p, Slot{offset: 60, width: 4}, LITTLE));
    if (sel wg.err) { ret wg; }
    if (b.len > 64) {
        val wstub: err[Fail] = format_dump.bytes(c.d, BYTES, ?p[64], b.len - 64);
        if (sel wstub.err) { ret wstub; }
    }
    ret format_dump.close(c.d);
}

# the size word of the string table and the bytes it counts, zero when there is none
fun strtab_size(m: *Coff) u64 {
    val strings: opt[Bytes] = read.string_table(m);
    if (sel strings.some) { ret 4 + strings.some.len::u64; }
    ret 0;
}

# the file header, regular or bigobj
fun file_header(c: *Ctx) err[Fail] {
    val h: *Header = ?c.m.header;
    if (c.m.shape.object == ?model.BIGOBJ) { ret bigobj_header(c); }
    val wo: err[Fail] = format_dump.open(c.d, FILE_HEADER);
    if (sel wo.err) { ret wo; }
    val wm: err[Fail] = named_full(c.d, MACHINE, h.machine::u64, ?tables.MACHINE);
    if (sel wm.err) { ret wm; }
    val w1: err[Fail] = format_dump.decimal(c.d, SECTION_COUNT, h.nsections::u64);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = stamp(c.d, TIMESTAMP, h.timestamp);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.hex(c.d, SYMTAB_POINTER, h.symtab_ptr::u64);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.decimal(c.d, SYMBOL_COUNT, h.nsymbols::u64);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.decimal(c.d, STRTAB_SIZE, strtab_size(c.m));
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.decimal(c.d, OPTIONAL_SIZE, h.opt_size::u64);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = flags(c.d, CHARACTERISTICS, h.characteristics::u64, ?tables.CHARACTERISTICS, "", 0);
    if (sel w7.err) { ret w7; }
    ret format_dump.close(c.d);
}

fun bigobj_header(c: *Ctx) err[Fail] {
    val h:  *Header   = ?c.m.header;
    val wo: err[Fail] = format_dump.open(c.d, BIGOBJ_HEADER);
    if (sel wo.err) { ret wo; }
    val w1: err[Fail] = format_dump.decimal(c.d, VERSION, h.version::u64);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = named_full(c.d, MACHINE, h.machine::u64, ?tables.MACHINE);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = stamp(c.d, TIMESTAMP, h.timestamp);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.decimal(c.d, SECTION_COUNT, h.nsections::u64);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.hex(c.d, SYMTAB_POINTER, h.symtab_ptr::u64);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.decimal(c.d, SYMBOL_COUNT, h.nsymbols::u64);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = format_dump.decimal(c.d, STRTAB_SIZE, strtab_size(c.m));
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = format_dump.bytes(c.d, CLASS_ID, ?h.class_id[0], 16);
    if (sel w8.err) { ret w8; }
    val w9: err[Fail] = format_dump.decimal(c.d, SIZE_OF_DATA, h.size_of_data::u64);
    if (sel w9.err) { ret w9; }
    val wa: err[Fail] = format_dump.hex(c.d, FLAGS, h.flags::u64);
    if (sel wa.err) { ret wa; }
    val wb: err[Fail] = format_dump.decimal(c.d, META_SIZE, h.meta_size::u64);
    if (sel wb.err) { ret wb; }
    val wc: err[Fail] = format_dump.hex(c.d, META_OFFSET, h.meta_offset::u64);
    if (sel wc.err) { ret wc; }
    ret format_dump.close(c.d);
}

# the optional header of an image, or the bytes the model holds for one it cannot read
fun optional_header(c: *Ctx) err[Fail] {
    if (sel c.m.optional.raw) {
        val raw: Bytes     = model.bytes(c.m, ?c.m.optional.raw);
        val wo:  err[Fail] = format_dump.open(c.d, OPTIONAL_HEADER);
        if (sel wo.err) { ret wo; }
        val wb: err[Fail] = format_dump.bytes(c.d, BYTES, raw.data, raw.len);
        if (sel wb.err) { ret wb; }
        ret format_dump.close(c.d);
    }
    if (sel c.m.optional.image) {
        val img: *Image    = ?c.m.optional.image;
        val wo:  err[Fail] = format_dump.open(c.d, OPTIONAL_HEADER);
        if (sel wo.err) { ret wo; }
        val width: res[u64, Fail] = image_width(c.m);
        if (sel width.err) { ret err[Fail].err{width.err}; }
        val wf: err[Fail] = image_fields(c.d, img, width.ok);
        if (sel wf.err) { ret wf; }
        val wn: err[Fail] = format_dump.decimal(c.d, DIRECTORY_COUNT, table.count[DataDirectory](?img.dirs)::u64);
        if (sel wn.err) { ret wn; }
        val wd: err[Fail] = directory_table(c.d, img);
        if (sel wd.err) { ret wd; }
        val trailing: Bytes = model.bytes(c.m, ?img.trailing);
        if (trailing.len > 0) {
            val wt: err[Fail] = format_dump.bytes(c.d, BYTES, trailing.data, trailing.len);
            if (sel wt.err) { ret wt; }
        }
        ret format_dump.close(c.d);
    }
    ret err[Fail].ok{};
}

# the width of an address of the image's layout, a refusal for a file with no image layout
fun image_width(m: *Coff) res[u64, Fail] {
    if (sel m.shape.image.some) { ret res[u64, Fail].ok{m.shape.image.some.addr::u64}; }
    ret res[u64, Fail].err{fail.internal("address width of a file with no image layout")};
}

# the image base of an image, a refusal for a file with no image layout
fun image_base(m: *Coff) res[u64, Fail] {
    if (sel m.optional.image) { ret res[u64, Fail].ok{m.optional.image.image_base}; }
    ret res[u64, Fail].err{fail.internal("image base of a file with no image optional header")};
}

fun image_fields(d: *Dumper, img: *Image, addr: u64) err[Fail] {
    val w1: err[Fail] = format_dump.hex(d, MAGIC, img.magic::u64);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = format_dump.decimal(d, MAJOR_LINKER, img.linker_major::u64);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.decimal(d, MINOR_LINKER, img.linker_minor::u64);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.decimal(d, CODE_SIZE, img.code_size::u64);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.decimal(d, INITIALIZED_SIZE, img.init_data_size::u64);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.decimal(d, UNINITIALIZED_SIZE, img.uninit_data_size::u64);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = format_dump.hex(d, ENTRY_POINT, img.entry::u64);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = format_dump.hex(d, BASE_OF_CODE, img.code_base::u64);
    if (sel w8.err) { ret w8; }
    if (addr == 4) {
        val w9: err[Fail] = format_dump.hex(d, BASE_OF_DATA, img.data_base::u64);
        if (sel w9.err) { ret w9; }
    }
    val wa: err[Fail] = format_dump.hex(d, IMAGE_BASE, img.image_base);
    if (sel wa.err) { ret wa; }
    val wb: err[Fail] = format_dump.decimal(d, SECTION_ALIGNMENT, img.section_alignment::u64);
    if (sel wb.err) { ret wb; }
    val wc: err[Fail] = format_dump.decimal(d, FILE_ALIGNMENT, img.file_alignment::u64);
    if (sel wc.err) { ret wc; }
    val wd: err[Fail] = format_dump.decimal(d, OS_MAJOR, img.os_major::u64);
    if (sel wd.err) { ret wd; }
    val we: err[Fail] = format_dump.decimal(d, OS_MINOR, img.os_minor::u64);
    if (sel we.err) { ret we; }
    val wg: err[Fail] = format_dump.decimal(d, IMAGE_MAJOR, img.image_major::u64);
    if (sel wg.err) { ret wg; }
    val wh: err[Fail] = format_dump.decimal(d, IMAGE_MINOR, img.image_minor::u64);
    if (sel wh.err) { ret wh; }
    val wi: err[Fail] = format_dump.decimal(d, SUBSYSTEM_MAJOR, img.subsystem_major::u64);
    if (sel wi.err) { ret wi; }
    val wj: err[Fail] = format_dump.decimal(d, SUBSYSTEM_MINOR, img.subsystem_minor::u64);
    if (sel wj.err) { ret wj; }
    val wk: err[Fail] = format_dump.hex(d, WIN32_VERSION, img.win32_version::u64);
    if (sel wk.err) { ret wk; }
    val wl: err[Fail] = format_dump.decimal(d, IMAGE_SIZE, img.image_size::u64);
    if (sel wl.err) { ret wl; }
    val wm: err[Fail] = format_dump.decimal(d, HEADERS_SIZE, img.headers_size::u64);
    if (sel wm.err) { ret wm; }
    val wn: err[Fail] = format_dump.hex(d, CHECKSUM, img.checksum::u64);
    if (sel wn.err) { ret wn; }
    val wo: err[Fail] = named_full(d, SUBSYSTEM, img.subsystem::u64, ?tables.SUBSYSTEM);
    if (sel wo.err) { ret wo; }
    val wp: err[Fail] = flags(d, CHARACTERISTICS, img.dll_flags::u64, ?tables.DLLCHAR, "", 0);
    if (sel wp.err) { ret wp; }
    val wq: err[Fail] = format_dump.decimal(d, STACK_RESERVE, img.stack_reserve);
    if (sel wq.err) { ret wq; }
    val wr: err[Fail] = format_dump.decimal(d, STACK_COMMIT, img.stack_commit);
    if (sel wr.err) { ret wr; }
    val ws: err[Fail] = format_dump.decimal(d, HEAP_RESERVE, img.heap_reserve);
    if (sel ws.err) { ret ws; }
    val wt: err[Fail] = format_dump.decimal(d, HEAP_COMMIT, img.heap_commit);
    if (sel wt.err) { ret wt; }
    ret format_dump.hex(d, LOADER_FLAGS, img.loader_flags::u64);
}

# the data directories, each as its relative virtual address and its size
fun directory_table(d: *Dumper, img: *Image) err[Fail] {
    val wo: err[Fail] = format_dump.open(d, DATA_DIRECTORY);
    if (sel wo.err) { ret wo; }
    var i: usize = 0;
    for (i < table.count[DataDirectory](?img.dirs)) {
        val dir: DataDirectory = @table.at[DataDirectory](?img.dirs, table.nth[DataDirectory](i));
        val key: u32           = DIR_EXPORT_RVA + (2 * i)::u32;
        val wr:  err[Fail]     = format_dump.hex(d, key, dir.rva::u64);
        if (sel wr.err) { ret wr; }
        val ws: err[Fail] = format_dump.hex(d, key + 1, dir.size::u64);
        if (sel ws.err) { ret ws; }
        i = i + 1;
    }
    ret format_dump.close(d);
}

# the section headers, each under the number it has in the file
fun sections(c: *Ctx) err[Fail] {
    val strings: opt[Bytes] = read.string_table(c.m);
    val wo:      err[Fail]  = format_dump.open_list(c.d, SECTIONS);
    if (sel wo.err) { ret wo; }
    var i: usize = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s: *Section  = model.section_at(c.m, table.nth[Section](i));
        val w: err[Fail] = section(c, i, s, strings);
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret format_dump.close_list(c.d);
}

fun section(c: *Ctx, index: usize, s: *Section, strings: opt[Bytes]) err[Fail] {
    val name: res[Bytes, Fail] = read.section_name(strings, s);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    val wo: err[Fail] = format_dump.open(c.d, SECTION);
    if (sel wo.err) { ret wo; }
    val wn: err[Fail] = format_dump.decimal(c.d, NUMBER, index::u64 + 1);
    if (sel wn.err) { ret wn; }
    val wt: err[Fail] = format_dump.string(c.d, NAME, name.ok.data, name.ok.len);
    if (sel wt.err) { ret wt; }
    val w1: err[Fail] = format_dump.hex(c.d, VIRTUAL_SIZE, s.virtual_size::u64);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = format_dump.hex(c.d, VIRTUAL_ADDRESS, s.virtual_address::u64);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.decimal(c.d, RAW_SIZE, s.raw_size::u64);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.hex(c.d, RAW_POINTER, s.raw_ptr::u64);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.hex(c.d, RELOC_POINTER, s.reloc_ptr::u64);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.hex(c.d, LINE_POINTER, s.line_ptr::u64);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = format_dump.decimal(c.d, RELOC_COUNT, s.nreloc::u64);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = format_dump.decimal(c.d, LINE_COUNT, s.nlines::u64);
    if (sel w8.err) { ret w8; }
    val w9: err[Fail] = flags(c.d, CHARACTERISTICS, s.flags::u64, ?tables.SCN, "", tables.SCN_ALIGN_MASK.value);
    if (sel w9.err) { ret w9; }
    ret format_dump.close(c.d);
}

# the relocations of each section that has any, under the section's number and name
fun relocations(c: *Ctx) err[Fail] {
    val strings: opt[Bytes] = read.string_table(c.m);
    val machine: *Set       = rel_set(c.m);
    var opened:  bool       = false;
    var i:       usize      = 0;
    for (i < table.count[Section](?c.m.sections)) {
        val s: *Section = model.section_at(c.m, table.nth[Section](i));
        if (table.count[Reloc](?s.relocs) != 0) {
            if (!opened) {
                val wl: err[Fail] = format_dump.open_list(c.d, RELOCATIONS);
                if (sel wl.err) { ret wl; }
                opened = true;
            }
            val w: err[Fail] = reloc_section(c, i, s, strings, machine);
            if (sel w.err) { ret w; }
        }
        i = i + 1;
    }
    if (opened) { ret format_dump.close_list(c.d); }
    ret err[Fail].ok{};
}

fun reloc_section(c: *Ctx, index: usize, s: *Section, strings: opt[Bytes], machine: *Set) err[Fail] {
    val name: res[Bytes, Fail] = read.section_name(strings, s);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    val wo: err[Fail] = format_dump.open(c.d, SECTION);
    if (sel wo.err) { ret wo; }
    val wn: err[Fail] = format_dump.decimal(c.d, NUMBER, index::u64 + 1);
    if (sel wn.err) { ret wn; }
    val wt: err[Fail] = format_dump.string(c.d, NAME, name.ok.data, name.ok.len);
    if (sel wt.err) { ret wt; }
    var k: usize = 0;
    for (k < table.count[Reloc](?s.relocs)) {
        val r:  *Reloc    = table.at[Reloc](?s.relocs, table.nth[Reloc](k));
        val wr: err[Fail] = reloc_record(c, r, machine);
        if (sel wr.err) { ret wr; }
        k = k + 1;
    }
    ret format_dump.close(c.d);
}

fun reloc_record(c: *Ctx, r: *Reloc, machine: *Set) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, RELOCATION);
    if (sel wo.err) { ret wo; }
    val wa: err[Fail] = format_dump.hex(c.d, RELOC_ADDRESS, r.vaddr::u64);
    if (sel wa.err) { ret wa; }
    val wt: err[Fail] = named_full(c.d, TYPE, r.type::u64, machine);
    if (sel wt.err) { ret wt; }
    val wy: err[Fail] = format_dump.decimal(c.d, RELOC_SYMBOL_INDEX, r.symbol::u64);
    if (sel wy.err) { ret wy; }
    ret format_dump.close(c.d);
}

# the relocation table of the machine the file is for, nil when mink has none
fun rel_set(m: *Coff) *Set {
    var i: usize = 0;
    for (i < MACHINE_COUNT) {
        if (MACHINES[i].code.value == m.header.machine::u64) { ret MACHINES[i].rel; }
        i = i + 1;
    }
    ret nil;
}

# the symbol table, each symbol followed by its auxiliary records
fun symbols(c: *Ctx) err[Fail] {
    val strings: opt[Bytes] = read.string_table(c.m);
    val wo:      err[Fail]  = format_dump.open_list(c.d, SYMBOLS);
    if (sel wo.err) { ret wo; }
    val count: usize = table.count[Entry](?c.m.symbols);
    var i:     usize = 0;
    for (i < count) {
        val e: *Entry = table.at[Entry](?c.m.symbols, table.nth[Entry](i));
        if (!sel e.symbol) { ret err[Fail].err{fail.in_indexed(fail.malformed("an auxiliary record is not after its symbol"), "symbol", i::u64)}; }
        val naux: usize = e.symbol.naux::usize;
        if (i + naux >= count) { ret err[Fail].err{fail.in_indexed(fail.malformed("auxiliary records run past the symbol table"), "symbol", i::u64)}; }
        val w: err[Fail] = symbol(c, i, ?e.symbol, naux, strings);
        if (sel w.err) { ret w; }
        i = i + 1 + naux;
    }
    ret format_dump.close_list(c.d);
}

fun symbol(c: *Ctx, index: usize, s: *Symbol, naux: usize, strings: opt[Bytes]) err[Fail] {
    val name: res[Bytes, Fail] = symbol_name(s, strings);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    val wo: err[Fail] = format_dump.open(c.d, SYMBOL);
    if (sel wo.err) { ret wo; }
    val wn: err[Fail] = format_dump.string(c.d, SYM_NAME, name.ok.data, name.ok.len);
    if (sel wn.err) { ret wn; }
    val wv: err[Fail] = format_dump.decimal(c.d, VALUE, s.value::u64);
    if (sel wv.err) { ret wv; }
    val ws: err[Fail] = section_field(c, SYM_SECTION, s.section);
    if (sel ws.err) { ret ws; }
    val wb: err[Fail] = named_display(c.d, BASE_TYPE, (s.type & 0xf)::u64, ?tables.SYM_TYPE, "IMAGE_SYM_TYPE_");
    if (sel wb.err) { ret wb; }
    val wc: err[Fail] = named_display(c.d, COMPLEX_TYPE, ((s.type >> 4) & 0x3)::u64, ?tables.SYM_DTYPE, "IMAGE_SYM_DTYPE_");
    if (sel wc.err) { ret wc; }
    val wk: err[Fail] = named_display(c.d, STORAGE_CLASS, s.class::u64, ?tables.SYM_CLASS, "IMAGE_SYM_CLASS_");
    if (sel wk.err) { ret wk; }
    val wa: err[Fail] = format_dump.decimal(c.d, AUX_COUNT, naux::u64);
    if (sel wa.err) { ret wa; }
    var k: usize = 1;
    for (k <= naux) {
        val e: *Entry = table.at[Entry](?c.m.symbols, table.nth[Entry](index + k));
        if (!sel e.aux) { ret err[Fail].err{fail.in_indexed(fail.malformed("a symbol's auxiliary record is a symbol"), "symbol", index::u64)}; }
        val wx: err[Fail] = aux(c, ?e.aux);
        if (sel wx.err) { ret wx; }
        k = k + 1;
    }
    ret format_dump.close(c.d);
}

# the name of a symbol: its eight bytes, or the string table entry its last four name
# when its first four are zero
fun symbol_name(s: *Symbol, strings: opt[Bytes]) res[Bytes, Fail] {
    if (s.name[0] != 0 || s.name[1] != 0 || s.name[2] != 0 || s.name[3] != 0) {
        var n: usize = 0;
        for (n < 8 && s.name[n] != 0) { n = n + 1; }
        ret res[Bytes, Fail].ok{Bytes{data: ?s.name[0], len: n}};
    }
    if (sel strings.none) { ret res[Bytes, Fail].err{fail.malformed("a symbol names a string table that the file lacks")}; }
    val at: u64   = slot.field(?s.name[0], Slot{offset: 4, width: 4}, LITTLE);
    val t:  Bytes = strings.some;
    if (at < 4 || at - 4 >= t.len::u64) { ret res[Bytes, Fail].err{fail.malformed("a symbol name lies outside the string table")}; }
    val first: usize = (at - 4)::usize;
    ret cstring(?t.data[first], t.len - first);
}

# a symbol's section number: a section by its number, a special value by its name
fun section_field(c: *Ctx, key: u32, number: i32) err[Fail] {
    if (number > 0) { ret format_dump.decimal(c.d, key, number::u64); }
    val n: opt[str] = name_in(?tables.SYM_SECTION, number::u64);
    if (sel n.none) { ret format_dump.signed(c.d, key, number::i64); }
    val wf: err[Fail] = format_dump.field(c.d, key);
    if (sel wf.err) { ret wf; }
    val wn: err[Fail] = format_dump.text(c.d, n.some);
    if (sel wn.err) { ret wn; }
    val wp: err[Fail] = format_dump.text(c.d, " (");
    if (sel wp.err) { ret wp; }
    if (number < 0) {
        val wx: err[Fail] = format_dump.text(c.d, "-");
        if (sel wx.err) { ret wx; }
    }
    var mag: u64 = number::u64;
    if (number < 0) { mag = (~number::u64) + 1; }
    val wv: err[Fail] = format_dump.decimal_value(c.d, mag);
    if (sel wv.err) { ret wv; }
    ret format_dump.text(c.d, ")\n");
}

# one auxiliary record of a symbol, by the kind the reader gave it
fun aux(c: *Ctx, a: *Aux) err[Fail] {
    if (sel a.section) { ret section_aux(c, ?a.section); }
    or (sel a.function) {
        val f:  *FunctionAux = ?a.function;
        val wo: err[Fail]    = format_dump.open(c.d, AUX_FUNCTION);
        if (sel wo.err) { ret wo; }
        val w1: err[Fail] = format_dump.decimal(c.d, TAG_INDEX, f.tag_index::u64);
        if (sel w1.err) { ret w1; }
        val w2: err[Fail] = format_dump.decimal(c.d, TOTAL_SIZE, f.total_size::u64);
        if (sel w2.err) { ret w2; }
        val w3: err[Fail] = format_dump.hex(c.d, LINE_NUMBER_POINTER, f.line_ptr::u64);
        if (sel w3.err) { ret w3; }
        val w4: err[Fail] = format_dump.decimal(c.d, NEXT_FUNCTION, f.next_function::u64);
        if (sel w4.err) { ret w4; }
        ret format_dump.close(c.d);
    }
    or (sel a.block) {
        val b:  *BlockAux = ?a.block;
        val wo: err[Fail] = format_dump.open(c.d, AUX_BLOCK);
        if (sel wo.err) { ret wo; }
        val w1: err[Fail] = format_dump.decimal(c.d, BLOCK_LINE, b.line::u64);
        if (sel w1.err) { ret w1; }
        val w2: err[Fail] = format_dump.decimal(c.d, NEXT_FUNCTION, b.next_function::u64);
        if (sel w2.err) { ret w2; }
        ret format_dump.close(c.d);
    }
    or (sel a.weak) {
        val w:  *WeakAux  = ?a.weak;
        val wo: err[Fail] = format_dump.open(c.d, AUX_WEAK);
        if (sel wo.err) { ret wo; }
        val w1: err[Fail] = format_dump.decimal(c.d, LINKED, w.tag_index::u64);
        if (sel w1.err) { ret w1; }
        val w2: err[Fail] = named_display(c.d, SEARCH, w.characteristics::u64, ?tables.WEAK_EXTERN, "IMAGE_WEAK_EXTERN_SEARCH_");
        if (sel w2.err) { ret w2; }
        ret format_dump.close(c.d);
    }
    or (sel a.file) {
        val name: res[Bytes, Fail] = cstring(?a.file[0], 20);
        if (sel name.err) { ret err[Fail].err{name.err}; }
        val wo: err[Fail] = format_dump.open(c.d, AUX_FILE);
        if (sel wo.err) { ret wo; }
        val w1: err[Fail] = format_dump.string(c.d, FILE_NAME, name.ok.data, name.ok.len);
        if (sel w1.err) { ret w1; }
        ret format_dump.close(c.d);
    }
    or (sel a.clr) {
        val k:  *ClrAux   = ?a.clr;
        val wo: err[Fail] = format_dump.open(c.d, AUX_CLR);
        if (sel wo.err) { ret wo; }
        val w1: err[Fail] = format_dump.decimal(c.d, AUX_TYPE, k.aux_type::u64);
        if (sel w1.err) { ret w1; }
        val w2: err[Fail] = format_dump.decimal(c.d, RESERVED, k.reserved::u64);
        if (sel w2.err) { ret w2; }
        val w3: err[Fail] = format_dump.decimal(c.d, SYMBOL_TABLE_INDEX, k.symbol_index::u64);
        if (sel w3.err) { ret w3; }
        ret format_dump.close(c.d);
    }
    or (sel a.raw) {
        val wo: err[Fail] = format_dump.open(c.d, AUX_RAW);
        if (sel wo.err) { ret wo; }
        val wb: err[Fail] = format_dump.bytes(c.d, BYTES, ?a.raw[0], 20);
        if (sel wb.err) { ret wb; }
        ret format_dump.close(c.d);
    }
}

# a section definition: its length, relocation and line counts, checksum, number and
# COMDAT selection, and for an associative selection the section it is associated with
fun section_aux(c: *Ctx, a: *SectionAux) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, AUX_SECTION);
    if (sel wo.err) { ret wo; }
    val w1: err[Fail] = format_dump.decimal(c.d, LENGTH, a.length::u64);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = format_dump.decimal(c.d, RELOC_COUNT, a.nreloc::u64);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.decimal(c.d, LINE_COUNT, a.nlines::u64);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.hex(c.d, AUX_CHECKSUM, a.checksum::u64);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.decimal(c.d, NUMBER, a.number::u64);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = named_display(c.d, SELECTION, a.selection::u64, ?tables.COMDAT, "IMAGE_COMDAT_SELECT_");
    if (sel w6.err) { ret w6; }
    if (a.selection == 5) {
        val w7: err[Fail] = section_field(c, ASSOC_SECTION, a.number::i32);
        if (sel w7.err) { ret w7; }
    }
    ret format_dump.close(c.d);
}

# the directories the model holds typed, in the order llvm-readobj prints them. a
# directory whose structure the reader held raw prints its bytes raw
fun directories(c: *Ctx) err[Fail] {
    if (!sel c.m.optional.image) { ret err[Fail].ok{}; }
    val w1: err[Fail] = directory(c, ?tables.IMAGE_DIRECTORY_ENTRY_IMPORT);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = directory(c, ?tables.IMAGE_DIRECTORY_ENTRY_EXPORT);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = directory(c, ?tables.IMAGE_DIRECTORY_ENTRY_BASERELOC);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = directory(c, ?tables.IMAGE_DIRECTORY_ENTRY_DEBUG);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = directory(c, ?tables.IMAGE_DIRECTORY_ENTRY_TLS);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = directory(c, ?tables.IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = directory(c, ?tables.IMAGE_DIRECTORY_ENTRY_RESOURCE);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = directory(c, ?tables.IMAGE_DIRECTORY_ENTRY_EXCEPTION);
    if (sel w8.err) { ret w8; }
    ret directory(c, ?tables.IMAGE_DIRECTORY_ENTRY_DELAY_IMPORT);
}

fun directory(c: *Ctx, dir: *Constant) err[Fail] {
    val p: res[opt[*Piece], Fail] = model.directory_piece(c.m, dir);
    if (sel p.err)     { ret err[Fail].err{p.err}; }
    if (sel p.ok.none) { ret err[Fail].ok{}; }
    val piece: *Piece = p.ok.some;
    if (sel piece.raw)           { ret raw_directory(c, dir, ?piece.raw); }
    if (sel piece.imports)       { ret import_directory(c, ?piece.imports); }
    if (sel piece.delay_imports) { ret delay_directory(c, ?piece.delay_imports); }
    if (sel piece.exports)       { ret export_directory(c, ?piece.exports, dir); }
    if (sel piece.relocations)   { ret base_relocations(c, ?piece.relocations); }
    if (sel piece.debug)         { ret debug_directory(c, ?piece.debug); }
    if (sel piece.tls)           { ret tls_directory(c, ?piece.tls); }
    if (sel piece.load_config)   { ret load_config(c, ?piece.load_config); }
    if (sel piece.exceptions)    { ret exceptions(c, ?piece.exceptions); }
    if (sel piece.resource_dir)  { ret resources(c, ?piece.resource_dir); }
    ret err[Fail].err{fail.in_indexed(fail.malformed("data directory holds a record of another kind"), "data directory", dir.value)};
}

# a directory held raw, its bytes printed raw and named by the directory
fun raw_directory(c: *Ctx, dir: *Constant, h: *Held) err[Fail] {
    val b:  Bytes     = model.bytes(c.m, h);
    val wo: err[Fail] = format_dump.open(c.d, RAW_DIRECTORY);
    if (sel wo.err) { ret wo; }
    val wd: err[Fail] = format_dump.labelled(c.d, DIRECTORY, dir.value, dir.name, str_len(dir.name));
    if (sel wd.err) { ret wd; }
    val wb: err[Fail] = format_dump.bytes(c.d, BYTES, b.data, b.len);
    if (sel wb.err) { ret wb; }
    ret format_dump.close(c.d);
}

# a name at relative virtual address `rva`, printed under `key`
fun name_field(c: *Ctx, key: u32, rva: u32) err[Fail] {
    val n: res[Bytes, Fail] = name_at(c.m, rva::u64);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    ret format_dump.string(c.d, key, n.ok.data, n.ok.len);
}

# the import descriptors, each with the names its lookup table holds. the last
# descriptor is all zero and ends the table
fun import_directory(c: *Ctx, tab: *Table[ImportDescriptor]) err[Fail] {
    var k: usize = 0;
    for (k < table.count[ImportDescriptor](tab)) {
        val d: *ImportDescriptor = table.at[ImportDescriptor](tab, table.nth[ImportDescriptor](k));
        if (d.lookup_rva == 0 && d.timestamp == 0 && d.forwarder_chain == 0 && d.name_rva == 0 && d.thunk_rva == 0) { ret err[Fail].ok{}; }
        val wo: err[Fail] = format_dump.open(c.d, IMPORT);
        if (sel wo.err) { ret wo; }
        val wn: err[Fail] = name_field(c, IMPORT_NAME, d.name_rva);
        if (sel wn.err) { ret wn; }
        val wl: err[Fail] = format_dump.hex(c.d, LOOKUP_RVA, d.lookup_rva::u64);
        if (sel wl.err) { ret wl; }
        val wa: err[Fail] = format_dump.hex(c.d, ADDRESS_RVA, d.thunk_rva::u64);
        if (sel wa.err) { ret wa; }
        val ws: err[Fail] = thunk_names(c, d.lookup_rva, d.thunk_rva);
        if (sel ws.err) { ret ws; }
        val wc: err[Fail] = format_dump.close(c.d);
        if (sel wc.err) { ret wc; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the delay import descriptors, each with the names its name table holds. the last
# descriptor is all zero and ends the table
fun delay_directory(c: *Ctx, tab: *Table[DelayImport]) err[Fail] {
    var k: usize = 0;
    for (k < table.count[DelayImport](tab)) {
        val d: *DelayImport = table.at[DelayImport](tab, table.nth[DelayImport](k));
        if (d.attributes == 0 && d.name_rva == 0 && d.module_rva == 0 && d.thunk_rva == 0 && d.lookup_rva == 0 && d.bound_rva == 0 && d.unload_rva == 0 && d.timestamp == 0) { ret err[Fail].ok{}; }
        val wo: err[Fail] = format_dump.open(c.d, DELAY_IMPORT);
        if (sel wo.err) { ret wo; }
        val wa: err[Fail] = format_dump.hex(c.d, ATTRIBUTES, d.attributes::u64);
        if (sel wa.err) { ret wa; }
        val wn: err[Fail] = name_field(c, IMPORT_NAME, d.name_rva);
        if (sel wn.err) { ret wn; }
        val wm: err[Fail] = format_dump.hex(c.d, MODULE_HANDLE, d.module_rva::u64);
        if (sel wm.err) { ret wm; }
        val wt: err[Fail] = format_dump.hex(c.d, DELAY_ADDRESS_TABLE, d.thunk_rva::u64);
        if (sel wt.err) { ret wt; }
        val wl: err[Fail] = format_dump.hex(c.d, DELAY_NAME_TABLE, d.lookup_rva::u64);
        if (sel wl.err) { ret wl; }
        val wb: err[Fail] = format_dump.hex(c.d, BOUND_TABLE, d.bound_rva::u64);
        if (sel wb.err) { ret wb; }
        val wu: err[Fail] = format_dump.hex(c.d, UNLOAD_TABLE, d.unload_rva::u64);
        if (sel wu.err) { ret wu; }
        val wp: err[Fail] = stamp(c.d, DELAY_TIMESTAMP, d.timestamp);
        if (sel wp.err) { ret wp; }
        val ws: err[Fail] = thunk_names(c, d.lookup_rva, d.thunk_rva);
        if (sel ws.err) { ret ws; }
        val wc: err[Fail] = format_dump.close(c.d);
        if (sel wc.err) { ret wc; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the names of an import table: each entry is an ordinal, or a hint and a name. the
# lookup table is the thunk table when the descriptor has none
fun thunk_names(c: *Ctx, lookup: u32, thunk: u32) err[Fail] {
    var rva: u64 = lookup::u64;
    if (rva == 0) { rva = thunk::u64; }
    if (rva == 0) { ret err[Fail].ok{}; }
    val at: res[*Piece, Fail] = piece_at_rva(c.m, rva, "import lookup table");
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val p: *Piece = at.ok;
    if (!sel p.pointers) { ret err[Fail].err{fail.malformed("an import lookup table is not a table of thunks")}; }
    val tab: *Table[u64] = ?p.pointers;
    var k:   usize       = 0;
    for (k < table.count[u64](tab)) {
        val v: u64 = @table.at[u64](tab, table.nth[u64](k));
        if (v == 0) { ret err[Fail].ok{}; }
        val w: err[Fail] = thunk_name(c, v);
        if (sel w.err) { ret w; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# one thunk: an ordinal, or the hint and name it points at
fun thunk_name(c: *Ctx, v: u64) err[Fail] {
    var flag:  u64            = tables.ORDINAL_FLAG64.value;
    val width: res[u64, Fail] = image_width(c.m);
    if (sel width.err)   { ret err[Fail].err{width.err}; }
    if (width.ok == 4)   { flag = tables.ORDINAL_FLAG32.value; }
    if ((v & flag) != 0) { ret format_dump.labelled(c.d, IMPORT_SYMBOL, v & 0xffff, "", 0); }
    val at: res[*Piece, Fail] = piece_at_rva(c.m, v & tables.HINT_RVA_MASK.value, "import hint and name");
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val p: *Piece = at.ok;
    if (!sel p.hint_name) { ret err[Fail].err{fail.malformed("an import name is not a hint and a name")}; }
    val hint: u64              = p.hint_name.hint::u64;
    val raw:  Bytes            = model.bytes(c.m, ?p.hint_name.name);
    val name: res[Bytes, Fail] = cstring(raw.data, raw.len);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    ret format_dump.labelled(c.d, IMPORT_SYMBOL, hint, name.ok.data, name.ok.len);
}

# the export directory: each address of its address table, with its ordinal, its name
# when a name reaches it, and its address or the forwarder it names
fun export_directory(c: *Ctx, e: *ExportDirectory, dir: *Constant) err[Fail] {
    val own: res[DataDirectory, Fail] = image_directory(c, dir);
    if (sel own.err)          { ret err[Fail].err{own.err}; }
    if (e.address_count == 0) { ret err[Fail].ok{}; }
    val wp: res[*Piece, Fail] = piece_at_rva(c.m, e.address_rva::u64, "export address table");
    if (sel wp.err) { ret err[Fail].err{wp.err}; }
    val words: *Piece = wp.ok;
    if (!sel words.export_words) { ret err[Fail].err{fail.malformed("an export address table is not a table of words")}; }
    val tab: *Table[u32] = ?words.export_words;
    if (e.name_count == 0) { ret export_entries(c, e, tab, nil, own.ok); }
    val np: res[*Piece, Fail] = piece_at_rva(c.m, e.name_rva_table::u64, "export name table");
    if (sel np.err) { ret err[Fail].err{np.err}; }
    val names: *Piece = np.ok;
    if (!sel names.export_words) { ret err[Fail].err{fail.malformed("an export name table is not a table of words")}; }
    val op: res[*Piece, Fail] = piece_at_rva(c.m, e.ordinal_rva::u64, "export ordinal table");
    if (sel op.err) { ret err[Fail].err{op.err}; }
    val ords: *Piece = op.ok;
    if (!sel ords.ordinals) { ret err[Fail].err{fail.malformed("an export ordinal table is not a table of halfwords")}; }
    val named: res[Table[u32], Fail] = named_by_ordinal(c, e.address_count::usize, ?names.export_words, ?ords.ordinals);
    if (sel named.err) { ret err[Fail].err{named.err}; }
    var index: Table[u32] = named.ok;
    val w:     err[Fail]  = export_entries(c, e, tab, ?index, own.ok);
    val r:     err[Fail]  = table.release[u32](?index);
    if (sel w.err) { ret w; }
    ret r;
}

# the name of each address by its index in the address table, zero where no name reaches
# it. the ordinals are checked before the table is made, so a refusal leaves nothing
fun named_by_ordinal(c: *Ctx, count: usize, names: *Table[u32], ords: *Table[u16]) res[Table[u32], Fail] {
    if (table.count[u16](ords) != table.count[u32](names)) { ret res[Table[u32], Fail].err{fail.malformed("export name and ordinal tables differ in length")}; }
    var k: usize = 0;
    for (k < table.count[u16](ords)) {
        val ord: u64 = (@table.at[u16](ords, table.nth[u16](k)))::u64;
        if (ord >= count::u64) { ret res[Table[u32], Fail].err{fail.in_indexed(fail.malformed("an export name names an ordinal past the address table"), "export name", k::u64)}; }
        k = k + 1;
    }
    var tab:   Table[u32]         = table.make[u32](c.m.a);
    val grown: res[Id[u32], Fail] = table.grow[u32](?tab, count);
    if (sel grown.err) { ret res[Table[u32], Fail].err{grown.err}; }
    k = 0;
    for (k < table.count[u16](ords)) {
        val ord:  usize = (@table.at[u16](ords, table.nth[u16](k)))::usize;
        val slot: *u32  = table.at[u32](?tab, table.nth[u32](ord));
        @slot = @table.at[u32](names, table.nth[u32](k));
        k     = k + 1;
    }
    ret res[Table[u32], Fail].ok{tab};
}

# the exports of an address table, in ordinal order
fun export_entries(c: *Ctx, e: *ExportDirectory, words: *Table[u32], named: *Table[u32], own: DataDirectory) err[Fail] {
    var i: usize = 0;
    for (i < table.count[u32](words)) {
        val rva:  u32 = @table.at[u32](words, table.nth[u32](i));
        var name: u32 = 0;
        if (named != nil) { name = @table.at[u32](named, table.nth[u32](i)); }
        val w: err[Fail] = export_record(c, e, i::u64, rva, name, own);
        if (sel w.err) { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun export_record(c: *Ctx, e: *ExportDirectory, index: u64, rva: u32, name: u32, own: DataDirectory) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, EXPORT);
    if (sel wo.err) { ret wo; }
    val wv: err[Fail] = format_dump.decimal(c.d, EXPORT_ORDINAL, e.ordinal_base::u64 + index);
    if (sel wv.err) { ret wv; }
    if (name != 0) {
        val wn: err[Fail] = name_field(c, EXPORT_NAME, name);
        if (sel wn.err) { ret wn; }
    }
    if (rva::u64 >= own.rva::u64 && rva::u64 - own.rva::u64 < own.size::u64) {
        val wf: err[Fail] = name_field(c, FORWARDED_TO, rva);
        if (sel wf.err) { ret wf; }
    }
    or {
        val wr: err[Fail] = format_dump.hex(c.d, EXPORT_RVA, rva::u64);
        if (sel wr.err) { ret wr; }
    }
    ret format_dump.close(c.d);
}

# the base relocations, one entry per relocation of each block, its padding included
fun base_relocations(c: *Ctx, tab: *Table[RelocBlock]) err[Fail] {
    val wo: err[Fail] = format_dump.open_list(c.d, BASE_RELOCATIONS);
    if (sel wo.err) { ret wo; }
    var k: usize = 0;
    for (k < table.count[RelocBlock](tab)) {
        val b: *RelocBlock = table.at[RelocBlock](tab, table.nth[RelocBlock](k));
        var j: usize       = 0;
        for (j < table.count[u16](?b.entries)) {
            val e:   u16       = @table.at[u16](?b.entries, table.nth[u16](j));
            val typ: u64       = (e >> 12)::u64;
            val w:   err[Fail] = base_entry(c, typ, b.page_rva::u64 + (e & 0xfff)::u64);
            if (sel w.err) { ret w; }
            j = j + 1;
        }
        k = k + 1;
    }
    ret format_dump.close_list(c.d);
}

fun base_entry(c: *Ctx, typ: u64, addr: u64) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, BASE_ENTRY);
    if (sel wo.err) { ret wo; }
    val n: opt[str] = short_in(?tables.REL_BASED, typ, "IMAGE_REL_BASED_");
    if (sel n.some) {
        val wf: err[Fail] = format_dump.field(c.d, BASE_TYPE_NAME);
        if (sel wf.err) { ret wf; }
        val wt: err[Fail] = format_dump.text(c.d, n.some);
        if (sel wt.err) { ret wt; }
        val wl: err[Fail] = format_dump.text(c.d, "\n");
        if (sel wl.err) { ret wl; }
    }
    or {
        val wh: err[Fail] = format_dump.hex(c.d, BASE_TYPE_NAME, typ);
        if (sel wh.err) { ret wh; }
    }
    val wa: err[Fail] = format_dump.hex(c.d, BASE_ADDRESS, addr);
    if (sel wa.err) { ret wa; }
    ret format_dump.close(c.d);
}

# the debug directory entries, each with its CodeView record when it has one
fun debug_directory(c: *Ctx, tab: *Table[DebugEntry]) err[Fail] {
    val wo: err[Fail] = format_dump.open_list(c.d, DEBUG_DIRECTORY);
    if (sel wo.err) { ret wo; }
    var k: usize = 0;
    for (k < table.count[DebugEntry](tab)) {
        val e: *DebugEntry = table.at[DebugEntry](tab, table.nth[DebugEntry](k));
        val w: err[Fail]   = debug_entry(c, e);
        if (sel w.err) { ret w; }
        k = k + 1;
    }
    ret format_dump.close_list(c.d);
}

fun debug_entry(c: *Ctx, e: *DebugEntry) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, DEBUG_ENTRY);
    if (sel wo.err) { ret wo; }
    val w1: err[Fail] = format_dump.hex(c.d, CHARACTERISTICS, e.characteristics::u64);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = stamp(c.d, TIMESTAMP, e.timestamp);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.hex(c.d, MAJOR_VERSION, e.major::u64);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.hex(c.d, MINOR_VERSION, e.minor::u64);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = named_short(c.d, TYPE, e.type::u64, ?tables.DEBUG_TYPE, "IMAGE_DEBUG_TYPE_");
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.hex(c.d, DEBUG_SIZE, e.size::u64);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = format_dump.hex(c.d, ADDRESS_OF_RAW, e.rva::u64);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = format_dump.hex(c.d, RAW_POINTER, e.pointer::u64);
    if (sel w8.err) { ret w8; }
    val at: res[opt[*Piece], Fail] = model.piece_at(c.m, e.pointer::u64);
    if (sel at.err) { ret err[Fail].err{at.err}; }
    if (sel at.ok.some) {
        val p: *Piece = at.ok.some;
        if (sel p.codeview) {
            val wp: err[Fail] = pdb_info(c, ?p.codeview);
            if (sel wp.err) { ret wp; }
        }
    }
    ret format_dump.close(c.d);
}

# the CodeView RSDS record: its signature, its GUID in braces, its age and its path
fun pdb_info(c: *Ctx, r: *Rsds) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, PDB_INFO);
    if (sel wo.err) { ret wo; }
    val w1: err[Fail] = format_dump.hex(c.d, PDB_SIGNATURE, r.signature::u64);
    if (sel w1.err) { ret w1; }
    var guid: [38]u8;
    guid_text(?guid[0], ?r.guid[0]);
    val w2: err[Fail] = format_dump.field(c.d, PDB_GUID);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.raw(c.d, ?guid[0], 38);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.text(c.d, "\n");
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.decimal(c.d, PDB_AGE, r.age::u64);
    if (sel w5.err) { ret w5; }
    val path: Bytes            = model.bytes(c.m, ?r.path);
    val name: res[Bytes, Fail] = cstring(path.data, path.len);
    if (sel name.err) { ret err[Fail].err{name.err}; }
    val w6: err[Fail] = format_dump.string(c.d, PDB_FILE_NAME, name.ok.data, name.ok.len);
    if (sel w6.err) { ret w6; }
    ret format_dump.close(c.d);
}

# the GUID at `g` as {DATA1-DATA2-DATA3-DATA4} in uppercase hex, with its first three
# fields read little-endian, written into the 38 bytes at `out`
fun guid_text(out: *u8, g: *u8) {
    val d1: u64   = slot.field(g, Slot{offset: 0, width: 4}, LITTLE);
    val d2: u64   = slot.field(g, Slot{offset: 4, width: 2}, LITTLE);
    val d3: u64   = slot.field(g, Slot{offset: 6, width: 2}, LITTLE);
    val d4: u64   = ((g[8]::u64) << 8) | (g[9]::u64);
    var d5: u64   = 0;
    var k:  usize = 0;
    for (k < 6) {
        d5 = (d5 << 8) | (g[10 + k]::u64);
        k  = k + 1;
    }
    out[0] = '{';
    upper(out, 1, d1, 8);
    out[9] = '-';
    upper(out, 10, d2, 4);
    out[14] = '-';
    upper(out, 15, d3, 4);
    out[19] = '-';
    upper(out, 20, d4, 4);
    out[24] = '-';
    upper(out, 25, d5, 12);
    out[37] = '}';
}

# the thread local storage directory
fun tls_directory(c: *Ctx, t: *Tls) err[Fail] {
    val wo: err[Fail] = format_dump.open(c.d, TLS_DIRECTORY);
    if (sel wo.err) { ret wo; }
    val w1: err[Fail] = format_dump.hex(c.d, START_OF_RAW, t.raw_start);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = format_dump.hex(c.d, END_OF_RAW, t.raw_end);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = format_dump.hex(c.d, INDEX_ADDRESS, t.index_address);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = format_dump.hex(c.d, CALLBACKS_ADDRESS, t.callbacks);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = format_dump.hex(c.d, ZERO_FILL_SIZE, t.zero_fill::u64);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = format_dump.hex(c.d, CHARACTERISTICS, t.characteristics::u64);
    if (sel w6.err) { ret w6; }
    ret format_dump.close(c.d);
}

# whether a field of width `w` lies within the size, moving past it either way
fun take(l: *Layout, w: u64) bool {
    val end: u64 = l.off + w;
    l.off = end;
    ret end <= l.size;
}

fun lc_hex(d: *Dumper, l: *Layout, key: u32, w: u64, v: u64) err[Fail] {
    if (!take(l, w)) { ret err[Fail].ok{}; }
    ret format_dump.hex(d, key, v);
}

fun lc_dec(d: *Dumper, l: *Layout, key: u32, w: u64, v: u64) err[Fail] {
    if (!take(l, w)) { ret err[Fail].ok{}; }
    ret format_dump.decimal(d, key, v);
}

fun lc_stamp(d: *Dumper, l: *Layout, key: u32, v: u32) err[Fail] {
    if (!take(l, 4)) { ret err[Fail].ok{}; }
    ret stamp(d, key, v);
}

# the guard flags of a load configuration, a valued list with no names of its own
fun lc_guard_flags(d: *Dumper, l: *Layout, v: u32) err[Fail] {
    if (!take(l, 4)) { ret err[Fail].ok{}; }
    val wo: err[Fail] = format_dump.open_valued_list(d, LC_GUARD_FLAGS, v::u64);
    if (sel wo.err) { ret wo; }
    ret format_dump.close_list(d);
}

# the load configuration, its fields in the order the layout gives, pointer-sized
# fields as wide as the image's addresses
fun load_config(c: *Ctx, lc: *LoadConfig) err[Fail] {
    val width: res[u64, Fail] = image_width(c.m);
    if (sel width.err) { ret err[Fail].err{width.err}; }
    val p:  u64       = width.ok;
    var l:  Layout    = Layout{off: 0, size: lc.size::u64};
    val wo: err[Fail] = format_dump.open(c.d, LOAD_CONFIG);
    if (sel wo.err) { ret wo; }
    val w1: err[Fail] = lc_hex(c.d, ?l, LC_SIZE, 4, lc.size::u64);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = lc_stamp(c.d, ?l, LC_TIMESTAMP, lc.timestamp);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = lc_hex(c.d, ?l, LC_MAJOR, 2, lc.major::u64);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = lc_hex(c.d, ?l, LC_MINOR, 2, lc.minor::u64);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = lc_hex(c.d, ?l, LC_GLOBAL_FLAGS_CLEAR, 4, lc.global_flags_clear::u64);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = lc_hex(c.d, ?l, LC_GLOBAL_FLAGS_SET, 4, lc.global_flags_set::u64);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = lc_hex(c.d, ?l, LC_CRITICAL_SECTION_TIMEOUT, 4, lc.critical_section_timeout::u64);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = lc_hex(c.d, ?l, LC_DECOMMIT_FREE_THRESHOLD, p, lc.decommit_free_threshold);
    if (sel w8.err) { ret w8; }
    val w9: err[Fail] = lc_hex(c.d, ?l, LC_DECOMMIT_TOTAL_FREE, p, lc.decommit_total_free);
    if (sel w9.err) { ret w9; }
    val w10: err[Fail] = lc_hex(c.d, ?l, LC_LOCK_PREFIX_TABLE, p, lc.lock_prefix_table);
    if (sel w10.err) { ret w10; }
    val w11: err[Fail] = lc_hex(c.d, ?l, LC_MAX_ALLOCATION, p, lc.max_allocation);
    if (sel w11.err) { ret w11; }
    val w12: err[Fail] = lc_hex(c.d, ?l, LC_VIRTUAL_MEMORY_THRESHOLD, p, lc.virtual_memory_threshold);
    if (sel w12.err) { ret w12; }
    val w13: err[Fail] = lc_hex(c.d, ?l, LC_AFFINITY_MASK, p, lc.affinity_mask);
    if (sel w13.err) { ret w13; }
    val w14: err[Fail] = lc_hex(c.d, ?l, LC_HEAP_FLAGS, 4, lc.heap_flags::u64);
    if (sel w14.err) { ret w14; }
    val w15: err[Fail] = lc_hex(c.d, ?l, LC_CSD_VERSION, 2, lc.csd_version::u64);
    if (sel w15.err) { ret w15; }
    val w16: err[Fail] = lc_hex(c.d, ?l, LC_DEPENDENT_LOAD_FLAGS, 2, lc.dependent_load_flags::u64);
    if (sel w16.err) { ret w16; }
    val w17: err[Fail] = lc_hex(c.d, ?l, LC_EDIT_LIST, p, lc.edit_list);
    if (sel w17.err) { ret w17; }
    val w18: err[Fail] = lc_hex(c.d, ?l, LC_SECURITY_COOKIE, p, lc.security_cookie);
    if (sel w18.err) { ret w18; }
    val w19: err[Fail] = lc_hex(c.d, ?l, LC_SEH_TABLE, p, lc.seh_table);
    if (sel w19.err) { ret w19; }
    val w20: err[Fail] = lc_dec(c.d, ?l, LC_SEH_COUNT, p, lc.seh_count);
    if (sel w20.err) { ret w20; }
    val w21: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_CF_CHECK, p, lc.guard_cf_check);
    if (sel w21.err) { ret w21; }
    val w22: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_CF_DISPATCH, p, lc.guard_cf_dispatch);
    if (sel w22.err) { ret w22; }
    val w23: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_CF_TABLE, p, lc.guard_cf_table);
    if (sel w23.err) { ret w23; }
    val w24: err[Fail] = lc_dec(c.d, ?l, LC_GUARD_CF_COUNT, p, lc.guard_cf_count);
    if (sel w24.err) { ret w24; }
    val w25: err[Fail] = lc_guard_flags(c.d, ?l, lc.guard_flags);
    if (sel w25.err) { ret w25; }
    val w26: err[Fail] = lc_hex(c.d, ?l, LC_INTEGRITY_FLAGS, 2, lc.integrity_flags::u64);
    if (sel w26.err) { ret w26; }
    val w27: err[Fail] = lc_hex(c.d, ?l, LC_INTEGRITY_CATALOG, 2, lc.integrity_catalog::u64);
    if (sel w27.err) { ret w27; }
    val w28: err[Fail] = lc_hex(c.d, ?l, LC_INTEGRITY_CATALOG_OFFSET, 4, lc.integrity_catalog_offset::u64);
    if (sel w28.err) { ret w28; }
    val w29: err[Fail] = lc_hex(c.d, ?l, LC_INTEGRITY_RESERVED, 4, lc.integrity_reserved::u64);
    if (sel w29.err) { ret w29; }
    val w30: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_IAT_TABLE, p, lc.guard_iat_table);
    if (sel w30.err) { ret w30; }
    val w31: err[Fail] = lc_dec(c.d, ?l, LC_GUARD_IAT_COUNT, p, lc.guard_iat_count);
    if (sel w31.err) { ret w31; }
    val w32: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_LONGJMP_TABLE, p, lc.guard_longjmp_table);
    if (sel w32.err) { ret w32; }
    val w33: err[Fail] = lc_dec(c.d, ?l, LC_GUARD_LONGJMP_COUNT, p, lc.guard_longjmp_count);
    if (sel w33.err) { ret w33; }
    val w34: err[Fail] = lc_hex(c.d, ?l, LC_DYNAMIC_RELOC_TABLE, p, lc.dynamic_reloc_table);
    if (sel w34.err) { ret w34; }
    val w35: err[Fail] = lc_hex(c.d, ?l, LC_CHPE_METADATA, p, lc.chpe_metadata);
    if (sel w35.err) { ret w35; }
    val w36: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_RF_FAILURE, p, lc.guard_rf_failure);
    if (sel w36.err) { ret w36; }
    val w37: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_RF_FAILURE_POINTER, p, lc.guard_rf_failure_pointer);
    if (sel w37.err) { ret w37; }
    val w38: err[Fail] = lc_hex(c.d, ?l, LC_DYNAMIC_RELOC_OFFSET, 4, lc.dynamic_reloc_offset::u64);
    if (sel w38.err) { ret w38; }
    val w39: err[Fail] = lc_dec(c.d, ?l, LC_DYNAMIC_RELOC_SECTION, 2, lc.dynamic_reloc_section::u64);
    if (sel w39.err) { ret w39; }
    val w40: err[Fail] = lc_hex(c.d, ?l, LC_RESERVED2, 2, lc.reserved2::u64);
    if (sel w40.err) { ret w40; }
    val w41: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_RF_VERIFY_STACK, p, lc.guard_rf_verify_stack);
    if (sel w41.err) { ret w41; }
    val w42: err[Fail] = lc_hex(c.d, ?l, LC_HOT_PATCH_OFFSET, 4, lc.hot_patch_offset::u64);
    if (sel w42.err) { ret w42; }
    val w43: err[Fail] = lc_hex(c.d, ?l, LC_RESERVED3, 4, lc.reserved3::u64);
    if (sel w43.err) { ret w43; }
    val w44: err[Fail] = lc_hex(c.d, ?l, LC_ENCLAVE, p, lc.enclave);
    if (sel w44.err) { ret w44; }
    val w45: err[Fail] = lc_hex(c.d, ?l, LC_VOLATILE_METADATA, p, lc.volatile_metadata);
    if (sel w45.err) { ret w45; }
    val w46: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_EH_TABLE, p, lc.guard_eh_table);
    if (sel w46.err) { ret w46; }
    val w47: err[Fail] = lc_dec(c.d, ?l, LC_GUARD_EH_COUNT, p, lc.guard_eh_count);
    if (sel w47.err) { ret w47; }
    val w48: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_XFG_CHECK, p, lc.guard_xfg_check);
    if (sel w48.err) { ret w48; }
    val w49: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_XFG_DISPATCH, p, lc.guard_xfg_dispatch);
    if (sel w49.err) { ret w49; }
    val w50: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_XFG_TABLE_DISPATCH, p, lc.guard_xfg_table_dispatch);
    if (sel w50.err) { ret w50; }
    val w51: err[Fail] = lc_hex(c.d, ?l, LC_CAST_GUARD_MODE, p, lc.cast_guard_mode);
    if (sel w51.err) { ret w51; }
    val w52: err[Fail] = lc_hex(c.d, ?l, LC_GUARD_MEMCPY, p, lc.guard_memcpy);
    if (sel w52.err) { ret w52; }
    ret format_dump.close(c.d);
}

# the exception table: each runtime function with its addresses, absolute from the image base
fun exceptions(c: *Ctx, ex: *Exceptions) err[Fail] {
    val img: res[u64, Fail] = image_base(c.m);
    if (sel img.err) { ret err[Fail].err{img.err}; }
    val base: u64       = img.ok;
    val wo:   err[Fail] = format_dump.open_list(c.d, UNWIND_INFORMATION);
    if (sel wo.err) { ret wo; }
    if (sel ex.x64) {
        var k: usize = 0;
        for (k < table.count[RuntimeFunction](?ex.x64)) {
            val f: *RuntimeFunction = table.at[RuntimeFunction](?ex.x64, table.nth[RuntimeFunction](k));
            val w: err[Fail]        = runtime_function(c.d, base + f.begin::u64, base + f.end::u64, base + f.unwind::u64, true);
            if (sel w.err) { ret w; }
            k = k + 1;
        }
    }
    or (sel ex.arm64) {
        var k: usize = 0;
        for (k < table.count[RuntimeFunctionArm64](?ex.arm64)) {
            val f: *RuntimeFunctionArm64 = table.at[RuntimeFunctionArm64](?ex.arm64, table.nth[RuntimeFunctionArm64](k));
            val w: err[Fail]             = runtime_function(c.d, base + f.begin::u64, 0, base + f.unwind::u64, false);
            if (sel w.err) { ret w; }
            k = k + 1;
        }
    }
    ret format_dump.close_list(c.d);
}

fun runtime_function(d: *Dumper, begin: u64, end: u64, unwind: u64, has_end: bool) err[Fail] {
    val wo: err[Fail] = format_dump.open(d, RUNTIME_FUNCTION);
    if (sel wo.err) { ret wo; }
    val w1: err[Fail] = format_dump.hex(d, START_ADDRESS, begin);
    if (sel w1.err) { ret w1; }
    if (has_end) {
        val w2: err[Fail] = format_dump.hex(d, END_ADDRESS, end);
        if (sel w2.err) { ret w2; }
    }
    val w3: err[Fail] = format_dump.hex(d, UNWIND_ADDRESS, unwind);
    if (sel w3.err) { ret w3; }
    ret format_dump.close(d);
}

# the resource tree from its root, each level's entries named by their type, name or
# language, and each data entry with its bytes
fun resources(c: *Ctx, root: *ResourceDirectory) err[Fail] {
    val dir: res[DataDirectory, Fail] = image_directory(c, ?tables.IMAGE_DIRECTORY_ENTRY_RESOURCE);
    if (sel dir.err) { ret err[Fail].err{dir.err}; }
    val base:  u64            = dir.ok.rva::u64;
    val total: res[u64, Fail] = data_count(c, root, base);
    if (sel total.err) { ret err[Fail].err{total.err}; }
    val wo: err[Fail] = format_dump.open_list(c.d, RESOURCES);
    if (sel wo.err) { ret wo; }
    val wt: err[Fail] = format_dump.decimal(c.d, RES_TOTAL, total.ok);
    if (sel wt.err) { ret wt; }
    val fb: res[u64, Fail] = file_at(c.m, base);
    if (sel fb.err) { ret err[Fail].err{fb.err}; }
    val wb: err[Fail] = format_dump.hex(c.d, RES_BASE, fb.ok);
    if (sel wb.err) { ret wb; }
    val w: err[Fail] = resource_dir(c, root, base, 0);
    if (sel w.err) { ret w; }
    ret format_dump.close_list(c.d);
}

# the data entries under a directory, through its subdirectories
fun data_count(c: *Ctx, dir: *ResourceDirectory, base: u64) res[u64, Fail] {
    var n: u64   = 0;
    var k: usize = 0;
    for (k < table.count[ResourceEntry](?dir.entries)) {
        val e: *ResourceEntry = table.at[ResourceEntry](?dir.entries, table.nth[ResourceEntry](k));
        if ((e.offset::u64 & tables.RESOURCE_HIGH_BIT.value) != 0) {
            val sub: res[*ResourceDirectory, Fail] = resource_child(c, base, e.offset);
            if (sel sub.err) { ret res[u64, Fail].err{sub.err}; }
            val m: res[u64, Fail] = data_count(c, sub.ok, base);
            if (sel m.err) { ret res[u64, Fail].err{m.err}; }
            n = n + m.ok;
        }
        or {
            n = n + 1;
        }
        k = k + 1;
    }
    ret res[u64, Fail].ok{n};
}

# the resource directory at offset `offset` of the resource table, whose high bit the
# caller has already checked
fun resource_child(c: *Ctx, base: u64, offset: u32) res[*ResourceDirectory, Fail] {
    val rva: u64               = base + (offset::u64 & tables.RESOURCE_OFFSET_MASK.value);
    val p:   res[*Piece, Fail] = piece_at_rva(c.m, rva, "resource directory");
    if (sel p.err) { ret res[*ResourceDirectory, Fail].err{p.err}; }
    val piece: *Piece = p.ok;
    if (!sel piece.resource_dir) { ret res[*ResourceDirectory, Fail].err{fail.malformed("a resource subdirectory is not a resource directory")}; }
    ret res[*ResourceDirectory, Fail].ok{?piece.resource_dir};
}

# one directory of the resource tree: its counts, then its entries at level `level`
fun resource_dir(c: *Ctx, dir: *ResourceDirectory, base: u64, level: u64) err[Fail] {
    val named: usize = dir.named::usize;
    val total: usize = table.count[ResourceEntry](?dir.entries);
    if (named > total) { ret err[Fail].err{fail.in_record(fail.malformed("a resource directory names more entries than it holds"), "resource directory")}; }
    val wn: err[Fail] = format_dump.decimal(c.d, RES_STRING_COUNT, named::u64);
    if (sel wn.err) { ret wn; }
    val wi: err[Fail] = format_dump.decimal(c.d, RES_ID_COUNT, (total - named)::u64);
    if (sel wi.err) { ret wi; }
    var k: usize = 0;
    for (k < total) {
        val e: *ResourceEntry = table.at[ResourceEntry](?dir.entries, table.nth[ResourceEntry](k));
        val w: err[Fail]      = resource_entry(c, base, e, level);
        if (sel w.err) { ret w; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# one entry of a level: its label, then the subdirectory or data it names
fun resource_entry(c: *Ctx, base: u64, e: *ResourceEntry, level: u64) err[Fail] {
    var key: u32 = TYPE;
    if (level == 1) { key = NAME; }
    or (level == 2) { key = RES_LANGUAGE; }
    val wo: err[Fail] = entry_open(c, base, key, e.name, level);
    if (sel wo.err) { ret wo; }
    if ((e.offset::u64 & tables.RESOURCE_HIGH_BIT.value) != 0) {
        val wt: err[Fail] = format_dump.hex(c.d, RES_TABLE_OFFSET, e.offset::u64 & tables.RESOURCE_OFFSET_MASK.value);
        if (sel wt.err) { ret wt; }
        val sub: res[*ResourceDirectory, Fail] = resource_child(c, base, e.offset);
        if (sel sub.err) { ret err[Fail].err{sub.err}; }
        val ws: err[Fail] = resource_dir(c, sub.ok, base, level + 1);
        if (sel ws.err) { ret ws; }
    }
    or {
        val we: err[Fail] = format_dump.hex(c.d, RES_ENTRY_OFFSET, e.offset::u64);
        if (sel we.err) { ret we; }
        val wd: err[Fail] = resource_data(c, base, e.offset::u64);
        if (sel wd.err) { ret wd; }
    }
    ret format_dump.close_list(c.d);
}

# the key and the label of an entry that opens a list: a name string, or an id spelled
# as `(ID n)` with a level-zero type's name before it
fun entry_open(c: *Ctx, base: u64, key: u32, name: u32, level: u64) err[Fail] {
    val wf: err[Fail] = format_dump.field(c.d, key);
    if (sel wf.err) { ret wf; }
    if ((name::u64 & tables.RESOURCE_HIGH_BIT.value) != 0) {
        val wn: err[Fail] = resource_string(c, base, name::u64 & tables.RESOURCE_OFFSET_MASK.value);
        if (sel wn.err) { ret wn; }
    }
    or {
        val id:    u64      = name::u64 & 0xffff;
        var named: opt[str] = opt[str].none{};
        if (level == 0) { named = short_in(?tables.RT, id, "RT_"); }
        if (sel named.some) {
            val wt: err[Fail] = format_dump.text(c.d, named.some);
            if (sel wt.err) { ret wt; }
            val wp: err[Fail] = format_dump.text(c.d, " (ID ");
            if (sel wp.err) { ret wp; }
            val wv: err[Fail] = format_dump.decimal_value(c.d, id);
            if (sel wv.err) { ret wv; }
            val wq: err[Fail] = format_dump.text(c.d, ")");
            if (sel wq.err) { ret wq; }
        }
        or (level == 0) {
            val wu: err[Fail] = format_dump.text(c.d, "ID ");
            if (sel wu.err) { ret wu; }
            val wv: err[Fail] = format_dump.decimal_value(c.d, id);
            if (sel wv.err) { ret wv; }
        }
        or {
            val wp: err[Fail] = format_dump.text(c.d, "(ID ");
            if (sel wp.err) { ret wp; }
            val wv: err[Fail] = format_dump.decimal_value(c.d, id);
            if (sel wv.err) { ret wv; }
            val wq: err[Fail] = format_dump.text(c.d, ")");
            if (sel wq.err) { ret wq; }
        }
    }
    val wc: err[Fail] = format_dump.text(c.d, " [\n");
    if (sel wc.err) { ret wc; }
    format_dump.nest(c.d);
    ret err[Fail].ok{};
}

# a resource name: a 16-bit count and that many UTF-16 units, written as UTF-8. a name
# must lie in one raw piece, and a lone surrogate is refused
fun resource_string(c: *Ctx, base: u64, offset: u64) err[Fail] {
    val file: res[u64, Fail] = file_at(c.m, base + offset);
    if (sel file.err) { ret err[Fail].err{file.err}; }
    val raw: res[opt[Bytes], Fail] = model.raw_at(c.m, file.ok);
    if (sel raw.err)     { ret err[Fail].err{raw.err}; }
    if (sel raw.ok.none) { ret err[Fail].err{fail.malformed("a resource name is not held raw")}; }
    val held: Bytes = raw.ok.some;
    if (held.len < 2) { ret err[Fail].err{fail.malformed("a resource name lacks its count")}; }
    val count: u64 = unit_at(held.data, 0);
    if (held.len::u64 < 2 + 2 * count) { ret err[Fail].err{fail.malformed("a resource name spans more than one raw piece")}; }
    var k: u64 = 0;
    for (k < count) {
        val unit: u64 = unit_at(held.data, (2 + 2 * k)::usize);
        var cp:   u64 = unit;
        if (unit >= 0xd800 && unit < 0xdc00) {
            if (k + 1 >= count) { ret err[Fail].err{fail.malformed("a resource name ends in a lone surrogate")}; }
            val low: u64 = unit_at(held.data, (4 + 2 * k)::usize);
            if (low < 0xdc00 || low >= 0xe000) { ret err[Fail].err{fail.malformed("a resource name has a lone surrogate")}; }
            cp = 0x10000 + ((unit - 0xd800) << 10) + (low - 0xdc00);
            k  = k + 1;
        }
        or (unit >= 0xdc00 && unit < 0xe000) {
            ret err[Fail].err{fail.malformed("a resource name has a lone surrogate")};
        }
        val w: err[Fail] = utf8(c.d, cp);
        if (sel w.err) { ret w; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the UTF-16 code unit at byte `at` of `p`, little-endian
fun unit_at(p: *u8, at: usize) u64 {
    ret (p[at]::u64) | ((p[at + 1]::u64) << 8);
}

# the UTF-8 bytes of code point `cp`
fun utf8(d: *Dumper, cp: u64) err[Fail] {
    if (cp < 0x80) { ret format_dump.char(d, cp::u8); }
    if (cp < 0x800) {
        val a: err[Fail] = format_dump.char(d, (0xc0 | (cp >> 6))::u8);
        if (sel a.err) { ret a; }
        ret format_dump.char(d, (0x80 | (cp & 0x3f))::u8);
    }
    if (cp < 0x10000) {
        val b: err[Fail] = format_dump.char(d, (0xe0 | (cp >> 12))::u8);
        if (sel b.err) { ret b; }
        val c2: err[Fail] = format_dump.char(d, (0x80 | ((cp >> 6) & 0x3f))::u8);
        if (sel c2.err) { ret c2; }
        ret format_dump.char(d, (0x80 | (cp & 0x3f))::u8);
    }
    val e: err[Fail] = format_dump.char(d, (0xf0 | (cp >> 18))::u8);
    if (sel e.err) { ret e; }
    val f: err[Fail] = format_dump.char(d, (0x80 | ((cp >> 12) & 0x3f))::u8);
    if (sel f.err) { ret f; }
    val g: err[Fail] = format_dump.char(d, (0x80 | ((cp >> 6) & 0x3f))::u8);
    if (sel g.err) { ret g; }
    ret format_dump.char(d, (0x80 | (cp & 0x3f))::u8);
}

# a data entry: its address, size, code page, and the bytes it names, which must lie in one
# raw piece
fun resource_data(c: *Ctx, base: u64, offset: u64) err[Fail] {
    val at: res[*Piece, Fail] = piece_at_rva(c.m, base + offset, "resource data");
    if (sel at.err) { ret err[Fail].err{at.err}; }
    val p: *Piece = at.ok;
    if (!sel p.resource_data) { ret err[Fail].err{fail.malformed("a resource data entry is not a data entry")}; }
    val rd: *ResourceData = ?p.resource_data;
    val wo: err[Fail]     = format_dump.open_list(c.d, RES_DATA);
    if (sel wo.err) { ret wo; }
    val wr: err[Fail] = format_dump.hex(c.d, RES_DATA_RVA, rd.rva::u64);
    if (sel wr.err) { ret wr; }
    val ws: err[Fail] = format_dump.decimal(c.d, RES_DATA_SIZE, rd.size::u64);
    if (sel ws.err) { ret ws; }
    val wc: err[Fail] = format_dump.decimal(c.d, RES_CODEPAGE, rd.codepage::u64);
    if (sel wc.err) { ret wc; }
    val wv: err[Fail] = format_dump.decimal(c.d, RESERVED, rd.reserved::u64);
    if (sel wv.err) { ret wv; }
    val file: res[u64, Fail] = file_at(c.m, rd.rva::u64);
    if (sel file.err) { ret err[Fail].err{file.err}; }
    val raw: res[opt[Bytes], Fail] = model.raw_at(c.m, file.ok);
    if (sel raw.err)     { ret err[Fail].err{raw.err}; }
    if (sel raw.ok.none) { ret err[Fail].err{fail.malformed("resource data is not held raw")}; }
    val held: Bytes = raw.ok.some;
    if (held.len::u64 < rd.size::u64) { ret err[Fail].err{fail.malformed("resource data spans more than one raw piece")}; }
    val wb: err[Fail] = format_dump.bytes(c.d, BYTES, held.data, rd.size::usize);
    if (sel wb.err) { ret wb; }
    ret format_dump.close_list(c.d);
}

test dump__headers_sections_and_symbols_under_llvm_names {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);
    var m: Coff         = model.make(a, Shape{object: ?model.REGULAR, image: opt[*ImageShape].none{}});
    m.header = Header{machine: 0x8664, nsections: 1, symtab_ptr: 0x200, nsymbols: 2};
    var text: Section = model.make_section(a);
    text.name     = [8]u8{'.', 't', 'e', 'x', 't', 0, 0, 0};
    text.raw_size = 4;
    text.raw_ptr  = 0x40;
    text.flags    = 0x60500020;
    val p0: res[Id[Section], Fail] = table.push[Section](?m.sections, text);
    if (sel p0.err) { ret 1; }
    var aux: SectionAux           = SectionAux{length: 4, checksum: 0x12345678, number: 1};
    val s0:  res[Id[Entry], Fail] = table.push[Entry](?m.symbols, Entry.symbol{Symbol{name: [8]u8{'.', 't', 'e', 'x', 't', 0, 0, 0}, section: 1, class: 3, naux: 1}});
    val s1:  res[Id[Entry], Fail] = table.push[Entry](?m.symbols, Entry.aux{Aux.section{aux}});
    val s2:  res[Id[Entry], Fail] = table.push[Entry](?m.symbols, Entry.symbol{Symbol{name: [8]u8{'m', 'a', 'i', 'n', 0, 0, 0, 0}, section: 1, type: 0x20, class: 2}});
    if (sel s0.err || sel s1.err || sel s2.err) { ret 1; }

    var out: Sink      = sink.make(a, LITTLE);
    var d:   Dumper    = format_dump.make(?out, ?FIELDS[0], FIELD_COUNT);
    val w:   err[Fail] = describe(?m, ?d);
    if (sel w.err) { ret 1; }
    val want: str   = "ImageFileHeader {\n  Machine: IMAGE_FILE_MACHINE_AMD64 (0x8664)\n  SectionCount: 1\n  TimeDateStamp: 1970-01-01 00:00:00 (0x0)\n  PointerToSymbolTable: 0x200\n  SymbolCount: 2\n  StringTableSize: 0\n  OptionalHeaderSize: 0\n  Characteristics [ (0x0)\n  ]\n}\nSections [\n  Section {\n    Number: 1\n    Name: .text\n    VirtualSize: 0x0\n    VirtualAddress: 0x0\n    RawDataSize: 4\n    PointerToRawData: 0x40\n    PointerToRelocations: 0x0\n    PointerToLineNumbers: 0x0\n    RelocationCount: 0\n    LineNumberCount: 0\n    Characteristics [ (0x60500020)\n      IMAGE_SCN_CNT_CODE (0x20)\n      IMAGE_SCN_ALIGN_16BYTES (0x500000)\n      IMAGE_SCN_MEM_EXECUTE (0x20000000)\n      IMAGE_SCN_MEM_READ (0x40000000)\n    ]\n  }\n]\nSymbols [\n  Symbol {\n    Name: .text\n    Value: 0\n    Section: 1\n    BaseType: Null (0x0)\n    ComplexType: Null (0x0)\n    StorageClass: Static (0x3)\n    AuxSymbolCount: 1\n    AuxSectionDef {\n      Length: 4\n      RelocationCount: 0\n      LineNumberCount: 0\n      Checksum: 0x12345678\n      Number: 1\n      Selection: 0x0\n    }\n  }\n  Symbol {\n    Name: main\n    Value: 0\n    Section: 1\n    BaseType: Null (0x0)\n    ComplexType: Function (0x2)\n    StorageClass: External (0x2)\n    AuxSymbolCount: 0\n  }\n]\n";
    val n:    usize = str_len(want);
    if (sink.len(?out) != n)                                   { ret 1; }
    if (!memory.raw_equal(sink.data(?out)::ptr, want::ptr, n)) { ret 1; }
    val rel: err[Fail] = sink.release(?out);
    if (sel rel.err) { ret 1; }
    val mrel: err[Fail] = model.release(?m);
    if (sel mrel.err)          { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
