    if (!walk(?SYM_SECTION, ?SYM_SECTION_WANT[0], 3))                                    { ret 1; }
    if (!walk(?SYM_TYPE, ?SYM_TYPE_WANT[0], 17))                                         { ret 1; }
    if (!walk(?SYM_DTYPE, ?SYM_DTYPE_WANT[0], 4))                                        { ret 1; }
    if (!walk(?SYM_CLASS, ?SYM_CLASS_WANT[0], 28))                                       { ret 1; }
    if (!walk(?COMDAT, ?COMDAT_WANT[0], 7))                                              { ret 1; }
    if (!walk(?WEAK_EXTERN, ?WEAK_EXTERN_WANT[0], 3))                                    { ret 1; }
    if (!walk(?DEBUG_TYPE, ?DEBUG_TYPE_WANT[0], 18))                                     { ret 1; }
    if (!walk(?REL_BASED, ?REL_BASED_WANT[0], 16))                                       { ret 1; }
