test tables__rows_match_source {
    if (!blob_matches(?BIGOBJ_CLASS_ID, ?BIGOBJ_CLASS_ID_WANT[0], 16))                   { ret 1; }
    if (!blob_matches(?IMPORT_PREFIX_CHARS, ?IMPORT_PREFIX_CHARS_WANT[0], 3))            { ret 1; }
    if (!blob_matches(?IMPORT_POINTER_PREFIX, ?IMPORT_POINTER_PREFIX_WANT[0], 6))        { ret 1; }
    if (!blob_matches(?IMPORT_DESCRIPTOR_PREFIX, ?IMPORT_DESCRIPTOR_PREFIX_WANT[0], 20)) { ret 1; }
    if (!blob_matches(?NULL_IMPORT_DESCRIPTOR, ?NULL_IMPORT_DESCRIPTOR_WANT[0], 24))     { ret 1; }
    if (!blob_matches(?NULL_THUNK_PREFIX, ?NULL_THUNK_PREFIX_WANT[0], 1))                { ret 1; }
    if (!blob_matches(?NULL_THUNK_SUFFIX, ?NULL_THUNK_SUFFIX_WANT[0], 16))               { ret 1; }
    if (!blob_matches(?IDATA_STEM, ?IDATA_STEM_WANT[0], 7))                              { ret 1; }
    if (!walk(?MACHINE, ?MACHINE_WANT[0], 41))                                           { ret 1; }
    if (!walk(?CHARACTERISTICS, ?CHARACTERISTICS_WANT[0], 15))                           { ret 1; }
    if (!walk(?SCN, ?SCN_WANT[0], 35))                                                   { ret 1; }
    if (!walk(?SUBSYSTEM, ?SUBSYSTEM_WANT[0], 14))                                       { ret 1; }
    if (!walk(?DLLCHAR, ?DLLCHAR_WANT[0], 11))                                           { ret 1; }
    if (!walk(?DLLCHAR_EX, ?DLLCHAR_EX_WANT[0], 2))                                      { ret 1; }
