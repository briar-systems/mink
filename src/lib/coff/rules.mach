# the linking rules of PE/COFF: how an image is laid out
#
# an input section merges into the output section named by its name up to a
# $, ordered there by what follows it, as .CRT$XCA before .CRT$XCU. every
# loaded section starts on a section alignment boundary in memory and a file
# alignment boundary in the file, so offsets and addresses need not agree.

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;

use mink.lib.catalog.arch.Arch;
use mink.lib.link.layout.Class;
use mink.lib.link.layout.Load;
use mink.lib.link.layout.Rules;
use mink.lib.model.section;

val CODE:  Load = Load{name: "code", flags: section.ALLOC | section.EXEC};
val CONST: Load = Load{name: "rdata", flags: section.ALLOC};
val DATA:  Load = Load{name: "data", flags: section.ALLOC | section.WRITE};

val LOADED: section.Flags = section.ALLOC | section.WRITE | section.EXEC;

val CLASS_COUNT: usize              = 6;
val CLASSES:     [CLASS_COUNT]Class = [CLASS_COUNT]Class{
    Class{flags: section.ALLOC | section.EXEC, flag_mask: LOADED, load: opt[*Load].some{?CODE}},
    Class{flags: section.ALLOC, flag_mask: LOADED, load: opt[*Load].some{?CONST}},
    Class{flags: section.ALLOC | section.WRITE, flag_mask: LOADED, roles: section.RELRO, role_mask: section.RELRO, load: opt[*Load].some{?DATA}},
    Class{flags: section.ALLOC | section.WRITE, flag_mask: LOADED, roles: section.BITS, role_mask: section.BITS, load: opt[*Load].some{?DATA}},
    Class{flags: section.ALLOC | section.WRITE, flag_mask: LOADED, roles: 0, role_mask: section.BITS, load: opt[*Load].some{?DATA}},
    Class{flags: 0, flag_mask: section.ALLOC, load: opt[*Load].none{}},
};

# the DOS header and stub, the PE signature, the COFF header, the optional
# header of PE32+ or PE32 with its data directories, and a section header for
# every output section
fun header(a: *Arch, segments: u64, sections: u64) u64 {
    if (a.pointer_bytes == 8) { ret 64 + 64 + 4 + 20 + 240 + 40 * sections; }
    ret 64 + 64 + 4 + 20 + 224 + 40 * sections;
}

# the default SectionAlignment and FileAlignment of the PE specification
pub val LAYOUT: Rules = Rules{
    stems:         nil,
    stem_count:    0,
    joint:         0,
    cut:           '$',
    classes:       ?CLASSES[0],
    class_count:   CLASS_COUNT,
    commons:       ".bss",
    congruent:     false,
    section_align: 0x1000,
    file_align:    0x200,
    header:        header,
};
