# the one table of mink: a growable array of T indexed by a typed id
#
# every parallel array in mink, sections, symbols, relocations and rows alike,
# is a Table. ids are issued by push and are only meaningful in the table that
# issued them. a table is released once, by release, and is empty after it.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.allocator.testing;
use std.memory;

use mink.base.fail;
use mink.base.fail.Fail;

# the index of a T in its table
pub rec Id[T] {
    index: u32;
}

# a:     the allocator the items live in
# items: the storage, nil before the first push
# count: how many items are held
# cap:   how many items the storage holds
pub rec Table[T] {
    a:     *A.Allocator;
    items: *T;
    count: usize;
    cap:   usize;
}

pub fun make[T](a: *A.Allocator) Table[T] {
    ret Table[T]{a: a};
}

# the id of the `index`th item, for a walk over 0 to count
pub fun nth[T](index: usize) Id[T] {
    ret Id[T]{index: index::u32};
}

pub fun count[T](t: *Table[T]) usize {
    ret t.count;
}

# the item `id` names. `id` was issued by this table
pub fun at[T](t: *Table[T], id: Id[T]) *T {
    ret ?t.items[id.index];
}

# the storage of every item, valid until the table next grows
pub fun items[T](t: *Table[T]) *T {
    ret t.items;
}

# room for `n` more items without growing
pub fun reserve[T](t: *Table[T], n: usize) err[Fail] {
    if (n > MAX_COUNT || t.count > MAX_COUNT - n) {
        ret err[Fail].err{fail.overflow("table exceeds its id range")};
    }
    val need: usize = t.count + n;
    if (need <= t.cap) { ret err[Fail].ok{}; }
    var cap: usize = t.cap * 2;
    if (cap < 8)         { cap = 8; }
    if (cap < need)      { cap = need; }
    if (cap > MAX_COUNT) { cap = MAX_COUNT; }
    val r: res[*T, A.Error] = A.reallocate[T](t.a, t.items, t.cap, cap);
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    t.items = r.ok;
    t.cap   = cap;
    ret err[Fail].ok{};
}

pub fun push[T](t: *Table[T], v: T) res[Id[T], Fail] {
    val g: err[Fail] = reserve[T](t, 1);
    if (sel g.err) { ret res[Id[T], Fail].err{g.err}; }
    t.items[t.count] = v;
    val id: Id[T] = Id[T]{index: t.count::u32};
    t.count = t.count + 1;
    ret res[Id[T], Fail].ok{id};
}

# put `v` at index `at`, moving the items from there on up by one, for a
# table kept in key order. ids of the moved items name other items after
pub fun insert[T](t: *Table[T], at: usize, v: T) err[Fail] {
    if (at > t.count) { ret err[Fail].err{fail.internal("a table insert lies past its end")}; }
    val g: err[Fail] = reserve[T](t, 1);
    if (sel g.err)    { ret g; }
    if (at < t.count) { memory.move[T](?t.items[at + 1], ?t.items[at], t.count - at); }
    t.items[at] = v;
    t.count     = t.count + 1;
    ret err[Fail].ok{};
}

# take out the item at index `at`, moving the items after it down by one, for
# a table kept in key order. ids of the moved items name other items after
pub fun remove[T](t: *Table[T], at: usize) err[Fail] {
    if (at >= t.count)    { ret err[Fail].err{fail.internal("a table remove lies past its end")}; }
    if (at + 1 < t.count) { memory.move[T](?t.items[at], ?t.items[at + 1], t.count - at - 1); }
    t.count = t.count - 1;
    ret err[Fail].ok{};
}

# append the `n` items at `p`, returning the id of the first
pub fun extend[T](t: *Table[T], p: *T, n: usize) res[Id[T], Fail] {
    val g: err[Fail] = reserve[T](t, n);
    if (sel g.err) { ret res[Id[T], Fail].err{g.err}; }
    val id: Id[T] = Id[T]{index: t.count::u32};
    if (n != 0) { memory.copy[T](?t.items[t.count], p, n); }
    t.count = t.count + n;
    ret res[Id[T], Fail].ok{id};
}

# append `n` zeroed items, returning the id of the first
pub fun grow[T](t: *Table[T], n: usize) res[Id[T], Fail] {
    val g: err[Fail] = reserve[T](t, n);
    if (sel g.err) { ret res[Id[T], Fail].err{g.err}; }
    val id: Id[T] = Id[T]{index: t.count::u32};
    if (n != 0) { memory.zero[T](?t.items[t.count], n); }
    t.count = t.count + n;
    ret res[Id[T], Fail].ok{id};
}

# drop the items from the `n`th on and keep the storage. a table that holds
# `n` items or fewer is unchanged
pub fun truncate[T](t: *Table[T], n: usize) {
    if (n < t.count) { t.count = n; }
}

# drop every item and keep the storage
pub fun clear[T](t: *Table[T]) {
    t.count = 0;
}

# give the storage back. the table is empty after, and releasing it again
# gives back nothing
pub fun release[T](t: *Table[T]) err[Fail] {
    val items: *T    = t.items;
    val cap:   usize = t.cap;
    t.items = nil;
    t.count = 0;
    t.cap   = 0;
    val r: err[A.Error] = A.deallocate[T](t.a, items, cap);
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}

# ids are u32, the widest index any object format declares
val MAX_COUNT: usize = 0xffff_ffff;

test table__pushes_grows_and_releases_once {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    var tab: Table[u64] = make[u64](testing.allocator_of(?t));
    var i:   usize      = 0;
    for (i < 100) {
        val r: res[Id[u64], Fail] = push[u64](?tab, (i * 3)::u64);
        if (sel r.err)            { ret 1; }
        if (r.ok.index != i::u32) { ret 1; }
        i = i + 1;
    }
    if (count[u64](?tab) != 100)             { ret 1; }
    if (@at[u64](?tab, nth[u64](57)) != 171) { ret 1; }
    truncate[u64](?tab, 200);
    if (count[u64](?tab) != 100) { ret 1; }
    truncate[u64](?tab, 40);
    if (count[u64](?tab) != 40) { ret 1; }
    val first: err[Fail] = release[u64](?tab);
    if (sel first.err) { ret 1; }
    val again: err[Fail] = release[u64](?tab);
    if (sel again.err)                      { ret 1; }
    if (count[u64](?tab) != 0)              { ret 1; }
    if (testing.live_count(?t) != 0)        { ret 1; }
    if (testing.double_free_count(?t) != 0) { ret 1; }
    testing.dnit(?t);
    ret 0;
}
