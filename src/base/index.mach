# the sorted indexes every catalog and relocation set is looked up through
#
# an index is an array of pointers to the rows themselves, sorted by a key the
# comparator reads from each row, so no key and no position is copied out of a
# row. lookups are std's binary search over it. a catalog's index is static
# and written beside its rows, and `verify` proves it sorted, free of a key
# twice and complete: every row once. a set of rows that is itself data is
# indexed when it is registered, into a table the registry owns, and `seal`
# sorts it and finds a key two rows share. a key that two rows share is refused
# when the index is made, so a lookup never depends on row order.

use std.collections.sort;
use std.collections.sort.SearchPosition;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;

# the row of `at` that `probe` orders equal to under `cmp`, by binary search.
# `probe` is a row with only the fields `cmp` reads set
pub fun find[T](at: **T, len: usize, probe: *T, cmp: fun(**T, **T) i64) opt[*T] {
    if (len == 0) { ret opt[*T].none{}; }
    var target: *T             = probe;
    val pos:    SearchPosition = sort.binary_search_by[*T](at, len, ?target, cmp);
    if (sel pos.found) { ret opt[*T].some{at[pos.found]}; }
    ret opt[*T].none{};
}

# sort the `len` rows at `at` under `cmp`, returning a row that orders equal to
# the one before it, none when every key is distinct
pub fun seal[T](at: **T, len: usize, cmp: fun(**T, **T) i64) opt[*T] {
    sort.sort_by[*T](at, len, cmp);
    var i: usize = 1;
    for (i < len) {
        if (cmp(?at[i - 1], ?at[i]) == 0) { ret opt[*T].some{at[i]}; }
        i = i + 1;
    }
    ret opt[*T].none{};
}

# whether the static index `at` of `len` entries is strictly ascending under
# `cmp` and holds each of the `count` rows at `rows` once
pub fun verify[T](at: **T, len: usize, rows: **T, count: usize, cmp: fun(**T, **T) i64) err[Fail] {
    var i: usize = 1;
    for (i < len) {
        if (cmp(?at[i - 1], ?at[i]) >= 0) {
            ret err[Fail].err{fail.internal("an index is not ascending or holds a key twice")};
        }
        i = i + 1;
    }
    var k: usize = 0;
    for (k < count) {
        var seen: usize = 0;
        i = 0;
        for (i < len) {
            if (at[i] == rows[k]) { seen = seen + 1; }
            i = i + 1;
        }
        if (seen != 1) { ret err[Fail].err{fail.internal("an index does not hold a row exactly once")}; }
        k = k + 1;
    }
    if (len != count) { ret err[Fail].err{fail.internal("an index holds a row that is not one of the rows")}; }
    ret err[Fail].ok{};
}

rec Probe {
    key: u32;
}

val P0: Probe = Probe{key: 0};
val P1: Probe = Probe{key: 1};
val P2: Probe = Probe{key: 2};

val T_ROWS:      [3]*Probe = [3]*Probe{?P0, ?P1, ?P2};
val T_SORTED:    [3]*Probe = [3]*Probe{?P0, ?P1, ?P2};
val T_DUPLICATE: [3]*Probe = [3]*Probe{?P0, ?P1, ?P1};

fun order_probe(a: **Probe, b: **Probe) i64 {
    if (a[0].key < b[0].key) { ret -1; }
    if (a[0].key > b[0].key) { ret 1; }
    ret 0;
}

test index__a_key_finds_its_row_and_a_duplicate_is_refused {
    var probe: Probe       = Probe{key: 1};
    val hit:   opt[*Probe] = find[Probe](?T_SORTED[0], 3, ?probe, order_probe);
    if (sel hit.none)    { ret 1; }
    if (hit.some != ?P1) { ret 1; }
    probe.key = 9;
    val miss: opt[*Probe] = find[Probe](?T_SORTED[0], 3, ?probe, order_probe);
    if (sel miss.some) { ret 2; }
    val good: err[Fail] = verify[Probe](?T_SORTED[0], 3, ?T_ROWS[0], 3, order_probe);
    if (sel good.err) { ret 3; }
    val dup: err[Fail] = verify[Probe](?T_DUPLICATE[0], 3, ?T_ROWS[0], 3, order_probe);
    if (sel dup.ok) { ret 4; }
    var loose: [3]*Probe   = [3]*Probe{?P2, ?P0, ?P0};
    val twice: opt[*Probe] = seal[Probe](?loose[0], 3, order_probe);
    if (sel twice.none) { ret 5; }
    ret 0;
}
