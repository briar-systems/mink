# rule tables: rows a table selects among by capability masks
#
# a row asks of each of its axes that a capability set hold every capability
# the axis needs and none it denies. the rows of one table are pairwise
# disjoint, so at most one row holds for any input and the order rows are
# written in carries no meaning. two rows overlap when, on every axis, neither
# needs what the other denies, since some set then holds both. a refusal of
# an overlapping pair names the first pair by the order rows are written in,
# both rows of it.
#
# a table a lookup runs on per input looks its rows up through an `Index`,
# built once from the rows by `index`. the index is a tree of key bits, each
# node reading the capability that splits its rows most evenly, chosen from
# the rows alone, and a lookup follows the input's bits down to one bucket.
# two rows that can both hold share the bucket of every input holding both,
# so building the index proves the rows disjoint by checking pairs within
# buckets only. `disjoint` checks every pair, for a table nothing looks up per
# input and for a test that proves a table disjoint without its index.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;

# what one axis of a row asks of a capability set: every capability of `need`
# and none of `deny`. a zero axis holds for any set
pub rec Axis {
    need: u64;
    deny: u64;
}

# whether the capability set `c` holds every capability `x` needs and none it
# denies
pub fun holds(x: *Axis, c: u64) bool {
    ret (c & x.need) == x.need && (c & x.deny) == 0;
}

# whether some capability set holds both `a` and `b`
pub fun meets(a: *Axis, b: *Axis) bool {
    ret (a.need & b.deny) == 0 && (b.need & a.deny) == 0;
}

# refuse the `count` rows from `rows` when two of them can both hold, naming
# the first of the pair as the record and the second as the subject
# ---
# meet: whether some input holds both rows, by `meets` on every axis
# name: a row's name
pub fun disjoint[R](rows: *R, count: usize, meet: fun(*R, *R) bool, name: fun(*R) str) err[Fail] {
    var i: usize = 0;
    for (i < count) {
        var j: usize = i + 1;
        for (j < count) {
            if (meet(?rows[i], ?rows[j])) { ret err[Fail].err{overlap[R](rows, i, j, name)}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the refusal of rows `i` and `j` of `rows` both holding, naming the first as
# the record and the second as the subject
fun overlap[R](rows: *R, i: usize, j: usize, name: fun(*R) str) Fail {
    val f: Fail = fail.in_record(fail.internal("two rows of a rule table can both hold"), name(?rows[i]));
    ret fail.about(f, name(?rows[j]));
}

# the most key bits a lookup reads before it reaches a bucket
val DEPTH_LIMIT: usize = 12;

# the most rows one bucket of an index holds, so a lookup reads at most this
# many rows. a table whose rows split no finer is refused
val BUCKET_LIMIT: usize = 8;

# the most nodes or entries an index holds
val ENTRY_LIMIT: usize = 0xffffffff;

# one capability of one axis an index keys its rows on
pub rec Bit {
    axis: usize;
    mask: u64;
}

# a node that reads one key bit
# ---
# bit:     the capability it reads
# without: the node an input lacking it reads next
# with:    the node an input holding it reads next
pub rec Split {
    bit:     Bit;
    without: u32;
    with:    u32;
}

# a node no key bit splits further: the rows from start up to end of entries
pub rec Bucket {
    start: u32;
    end:   u32;
}

pub tag Node: u8 {
    split:  Split;
    bucket: Bucket;
}

# the rows of a disjoint table as a tree of key bits. a bucket holds every row
# an input reaching it may hold, in the order the table writes them
# ---
# nodes:   the nodes, every split after the nodes it reads next
# entries: each bucket's rows by index
# root:    the node a lookup reads first
pub rec Index {
    nodes:   Table[Node];
    entries: Table[u32];
    root:    u32;
}

# index the `count` rows from `rows` of the table named `table_name`, each
# with `axes` axes, refusing two rows that can both hold and rows that leave a
# bucket past its ceiling
# ---
# axis: the axis of a row by its place, 0 up to axes
# name: a row's name
pub fun index[R](a: *A.Allocator, table_name: str, rows: *R, count: usize, axes: usize, axis: fun(*R, usize) *Axis, name: fun(*R) str) res[Index, Fail] {
    var x:    Index      = Index{nodes: table.make[Node](a), entries: table.make[u32](a)};
    var held: Table[u32] = table.make[u32](a);
    val e:    err[Fail]  = every(?held, count);
    if (sel e.err) {
        val rh: err[Fail] = table.release[u32](?held);
        ret refused(?x, e.err);
    }
    val g:  res[u32, Fail] = grow[R](?x, rows, axes, axis, ?held, 0);
    val rh: err[Fail]      = table.release[u32](?held);
    if (sel g.err)  { ret refused(?x, g.err); }
    if (sel rh.err) { ret refused(?x, rh.err); }
    x.root = g.ok;
    val p: err[Fail] = apart[R](?x, rows, axes, axis, name);
    if (sel p.err) { ret refused(?x, p.err); }
    val c: err[Fail] = ceiling(?x, table_name);
    if (sel c.err) { ret refused(?x, c.err); }
    ret res[Index, Fail].ok{x};
}

# the refusal `f` of building `x`, once what `x` holds is released. `f` is
# the cause, so a failure to release behind it is not reported
fun refused(x: *Index, f: Fail) res[Index, Fail] {
    val r: err[Fail] = release(x);
    ret res[Index, Fail].err{f};
}

# the place of the one row of `rows`, as indexed by `x`, whose every axis
# holds the capability set `caps` holds at that axis's place
pub fun find[R](x: *Index, rows: *R, axes: usize, axis: fun(*R, usize) *Axis, caps: *u64) opt[usize] {
    val nodes:   *Node = table.items[Node](?x.nodes);
    val entries: *u32  = table.items[u32](?x.entries);
    var at:      usize = x.root::usize;
    for {
        val n: *Node = ?nodes[at];
        if (sel n.split) {
            at = n.split.without::usize;
            if ((caps[n.split.bit.axis] & n.split.bit.mask) != 0) { at = n.split.with::usize; }
        }
        or (sel n.bucket) {
            var i: usize = n.bucket.start::usize;
            for (i < n.bucket.end::usize) {
                val w: usize = entries[i]::usize;
                if (all[R](?rows[w], axes, axis, caps)) { ret opt[usize].some{w}; }
                i = i + 1;
            }
            ret opt[usize].none{};
        }
    }
}

pub fun release(x: *Index) err[Fail] {
    val n: err[Fail] = table.release[Node](?x.nodes);
    val e: err[Fail] = table.release[u32](?x.entries);
    if (sel n.err) { ret n; }
    ret e;
}

fun all[R](w: *R, axes: usize, axis: fun(*R, usize) *Axis, caps: *u64) bool {
    var ax: usize = 0;
    for (ax < axes) {
        if (!holds(axis(w, ax), caps[ax])) { ret false; }
        ax = ax + 1;
    }
    ret true;
}

# list every row of a table of `count` rows in `held`
fun every(held: *Table[u32], count: usize) err[Fail] {
    if (count > ENTRY_LIMIT) { ret err[Fail].err{fail.internal("a rule table has more rows than an index holds")}; }
    var i: usize = 0;
    for (i < count) {
        val p: res[Id[u32], Fail] = table.push[u32](held, i::u32);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the node of `x` that sorts the rows `held` lists, `depth` key bits deep: a
# split by the bit that leaves both sides fewer rows, or a bucket when no bit
# does or the depth is at its limit
fun grow[R](x: *Index, rows: *R, axes: usize, axis: fun(*R, usize) *Axis, held: *Table[u32], depth: usize) res[u32, Fail] {
    if (depth < DEPTH_LIMIT) {
        val k: opt[Bit] = choose[R](rows, axes, axis, held);
        if (sel k.some) { ret fork[R](x, rows, axes, axis, held, depth, k.some); }
    }
    ret leaf(x, held);
}

fun leaf(x: *Index, held: *Table[u32]) res[u32, Fail] {
    val n:     usize = table.count[u32](held);
    val start: usize = table.count[u32](?x.entries);
    if (n > ENTRY_LIMIT - start) { ret res[u32, Fail].err{fail.internal("a rule table's index outgrows its entries")}; }
    val e: res[Id[u32], Fail] = table.extend[u32](?x.entries, table.items[u32](held), n);
    if (sel e.err) { ret res[u32, Fail].err{e.err}; }
    ret node(x, Node.bucket{Bucket{start: start::u32, end: (start + n)::u32}});
}

fun fork[R](x: *Index, rows: *R, axes: usize, axis: fun(*R, usize) *Axis, held: *Table[u32], depth: usize, k: Bit) res[u32, Fail] {
    val without: res[u32, Fail] = side[R](x, rows, axes, axis, held, depth, k, false);
    if (sel without.err) { ret without; }
    val with: res[u32, Fail] = side[R](x, rows, axes, axis, held, depth, k, true);
    if (sel with.err) { ret with; }
    ret node(x, Node.split{Split{bit: k, without: without.ok, with: with.ok}});
}

fun node(x: *Index, n: Node) res[u32, Fail] {
    if (table.count[Node](?x.nodes) >= ENTRY_LIMIT) { ret res[u32, Fail].err{fail.internal("a rule table's index outgrows its nodes")}; }
    val p: res[Id[Node], Fail] = table.push[Node](?x.nodes, n);
    if (sel p.err) { ret res[u32, Fail].err{p.err}; }
    ret res[u32, Fail].ok{p.ok.index};
}

# the node of the rows `held` lists that an input lacking the key bit `k`, or
# holding it when `v`, may hold
fun side[R](x: *Index, rows: *R, axes: usize, axis: fun(*R, usize) *Axis, held: *Table[u32], depth: usize, k: Bit, v: bool) res[u32, Fail] {
    var part:  Table[u32] = table.make[u32](held.a);
    val items: *u32       = table.items[u32](held);
    var i:     usize      = 0;
    for (i < table.count[u32](held)) {
        if (fits(axis(?rows[items[i]::usize], k.axis), k.mask, v)) {
            val p: res[Id[u32], Fail] = table.push[u32](?part, items[i]);
            if (sel p.err) {
                val rp: err[Fail] = table.release[u32](?part);
                ret res[u32, Fail].err{p.err};
            }
        }
        i = i + 1;
    }
    val g: res[u32, Fail] = grow[R](x, rows, axes, axis, ?part, depth + 1);
    val r: err[Fail]      = table.release[u32](?part);
    if (sel g.err) { ret g; }
    if (sel r.err) { ret res[u32, Fail].err{r.err}; }
    ret g;
}

# whether an input lacking the capability `m`, or holding it when `v`, may
# hold the axis `w`
fun fits(w: *Axis, m: u64, v: bool) bool {
    if (v) { ret (w.deny & m) == 0; }
    ret (w.need & m) == 0;
}

# the key bit whose larger side holds the fewest of the rows `held` lists,
# then the fewest rows on both sides together, none when every bit leaves a
# side with all of them
fun choose[R](rows: *R, axes: usize, axis: fun(*R, usize) *Axis, held: *Table[u32]) opt[Bit] {
    val items: *u32  = table.items[u32](held);
    val n:     usize = table.count[u32](held);
    var best:  Bit   = Bit{};
    var found: bool  = false;
    var big:   usize = n;
    var both:  usize = 0;
    var ax:    usize = 0;
    for (ax < axes) {
        var named: u64   = 0;
        var i:     usize = 0;
        for (i < n) {
            val w: *Axis = axis(?rows[items[i]::usize], ax);
            named = named | w.need | w.deny;
            i     = i + 1;
        }
        var p: u64 = 0;
        for (p < 64) {
            val m: u64 = 1u64 << p;
            p = p + 1;
            if ((named & m) == 0) { cnt; }
            var c0: usize = 0;
            var c1: usize = 0;
            i = 0;
            for (i < n) {
                val w: *Axis = axis(?rows[items[i]::usize], ax);
                if (fits(w, m, false)) { c0 = c0 + 1; }
                if (fits(w, m, true))  { c1 = c1 + 1; }
                i = i + 1;
            }
            var larger: usize = c0;
            if (c1 > c0) { larger = c1; }
            if (larger < big || (found && larger == big && c0 + c1 < both)) {
                best  = Bit{axis: ax, mask: m};
                big   = larger;
                both  = c0 + c1;
                found = true;
            }
        }
        ax = ax + 1;
    }
    if (!found) { ret opt[Bit].none{}; }
    ret opt[Bit].some{best};
}

fun ceiling(x: *Index, table_name: str) err[Fail] {
    val nodes: *Node = table.items[Node](?x.nodes);
    var at:    usize = 0;
    for (at < table.count[Node](?x.nodes)) {
        val b: *Node = ?nodes[at];
        if (sel b.bucket) {
            val n: usize = (b.bucket.end - b.bucket.start)::usize;
            if (n > BUCKET_LIMIT) {
                val f: Fail = fail.in_record(fail.internal("the rows of a rule table leave an index bucket past its ceiling"), table_name);
                ret err[Fail].err{fail.valued(f, n::i128)};
            }
        }
        at = at + 1;
    }
    ret err[Fail].ok{};
}

# refuse the first pair of rows, by the order the table writes them, that can
# both hold. such a pair shares the bucket of every input holding both, so
# only pairs within one are read
fun apart[R](x: *Index, rows: *R, axes: usize, axis: fun(*R, usize) *Axis, name: fun(*R) str) err[Fail] {
    val nodes:   *Node = table.items[Node](?x.nodes);
    val entries: *u32  = table.items[u32](?x.entries);
    var first:   usize = 0;
    var second:  usize = 0;
    var found:   bool  = false;
    var at:      usize = 0;
    for (at < table.count[Node](?x.nodes)) {
        val b: *Node = ?nodes[at];
        at = at + 1;
        if (sel b.bucket) {
            var i: usize = b.bucket.start::usize;
            for (i < b.bucket.end::usize) {
                var j: usize = i + 1;
                for (j < b.bucket.end::usize) {
                    val ri: usize = entries[i]::usize;
                    val rj: usize = entries[j]::usize;
                    j = j + 1;
                    if (found && (ri > first || (ri == first && rj >= second))) { cnt; }
                    if (rows_meet[R](?rows[ri], ?rows[rj], axes, axis)) {
                        first  = ri;
                        second = rj;
                        found  = true;
                    }
                }
                i = i + 1;
            }
        }
    }
    if (found) { ret err[Fail].err{overlap[R](rows, first, second, name)}; }
    ret err[Fail].ok{};
}

# whether some input holds both rows `p` and `q`, each with `axes` axes
pub fun rows_meet[R](p: *R, q: *R, axes: usize, axis: fun(*R, usize) *Axis) bool {
    var ax: usize = 0;
    for (ax < axes) {
        if (!meets(axis(p, ax), axis(q, ax))) { ret false; }
        ax = ax + 1;
    }
    ret true;
}

rec Sample {
    name: str;
    a:    Axis;
    b:    Axis;
}

fun sample_meet(x: *Sample, y: *Sample) bool {
    ret meets(?x.a, ?y.a) && meets(?x.b, ?y.b);
}

fun sample_name(x: *Sample) str {
    ret x.name;
}

test rule__overlapping_rows_are_refused_naming_both {
    val rows: [3]Sample = [3]Sample{
        Sample{name: "first", a: Axis{need: 0x1}, b: Axis{deny: 0x4}},
        Sample{name: "second", a: Axis{deny: 0x1}},
        Sample{name: "third", a: Axis{need: 0x2}, b: Axis{need: 0x8}},
    };
    val e: err[Fail] = disjoint[Sample](?rows[0], 3, sample_meet, sample_name);
    if (!(sel e.err))                          { ret 1; }
    if (!str_equals(e.err.at.record, "first")) { ret 1; }
    if (!str_equals(e.err.subject, "third"))   { ret 1; }
    ret 0;
}
