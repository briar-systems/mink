# the one growable byte buffer of mink
#
# every byte store, a model's owned bytes, a writer's output and the
# interner's names alike, is a Buffer. it is addressed by usize offsets, so
# it holds as many bytes as the host can, never capped by a table's ids. a
# buffer is released once, by release, and is empty after it.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.memory;

use mink.base.fail;
use mink.base.fail.Fail;

# a:    the allocator the bytes live in
# data: the storage, nil before the first byte
# len:  how many bytes are held
# cap:  how many bytes the storage holds
pub rec Buffer {
    a:    *A.Allocator;
    data: *u8;
    len:  usize;
    cap:  usize;
}

pub fun make(a: *A.Allocator) Buffer {
    ret Buffer{a: a};
}

pub fun len(b: *Buffer) usize {
    ret b.len;
}

# the byte at `offset`, valid until the buffer next grows
pub fun at(b: *Buffer, offset: usize) *u8 {
    ret ?b.data[offset];
}

# room for `n` more bytes without growing
pub fun reserve(b: *Buffer, n: usize) err[Fail] {
    if (n > MAX_LEN - b.len) {
        ret err[Fail].err{fail.overflow("buffer exceeds the address space")};
    }
    val need: usize = b.len + n;
    if (need <= b.cap) { ret err[Fail].ok{}; }
    var cap: usize = MAX_LEN;
    if (b.cap <= MAX_LEN / 2) { cap = b.cap * 2; }
    if (cap < 64)             { cap = 64; }
    if (cap < need)           { cap = need; }
    val r: res[*u8, A.Error] = A.reallocate[u8](b.a, b.data, b.cap, cap);
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    b.data = r.ok;
    b.cap  = cap;
    ret err[Fail].ok{};
}

# append the `n` bytes at `p`, returning the offset of the first
pub fun extend(b: *Buffer, p: *u8, n: usize) res[usize, Fail] {
    val g: err[Fail] = reserve(b, n);
    if (sel g.err) { ret res[usize, Fail].err{g.err}; }
    val start: usize = b.len;
    if (n != 0) { memory.copy[u8](?b.data[start], p, n); }
    b.len = start + n;
    ret res[usize, Fail].ok{start};
}

# append `n` zero bytes, returning the offset of the first
pub fun grow(b: *Buffer, n: usize) res[usize, Fail] {
    val g: err[Fail] = reserve(b, n);
    if (sel g.err) { ret res[usize, Fail].err{g.err}; }
    val start: usize = b.len;
    if (n != 0) { memory.zero[u8](?b.data[start], n); }
    b.len = start + n;
    ret res[usize, Fail].ok{start};
}

# drop the bytes from offset `n` on and keep the storage. a buffer that holds
# `n` bytes or fewer is unchanged
pub fun truncate(b: *Buffer, n: usize) {
    if (n < b.len) { b.len = n; }
}

# give the storage back. the buffer is empty after, and releasing it again
# gives back nothing
pub fun release(b: *Buffer) err[Fail] {
    val data: *u8   = b.data;
    val cap:  usize = b.cap;
    b.data = nil;
    b.len  = 0;
    b.cap  = 0;
    val r: err[A.Error] = A.deallocate[u8](b.a, data, cap);
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}

# the most bytes any span of memory can hold
val MAX_LEN: usize = 0x7fff_ffff_ffff_ffff;
