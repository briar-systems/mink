# growth over a std vector that fails as a Fail, for lists nothing names by id
#
# a vector of plain values is a std vector, and bytes written out are a Sink.
# every growth here refuses as `refused` with the allocator's error, and a
# refused growth leaves the vector as it was.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.slice;
use std.collections.slice.Slice;
use std.collections.vector;
use std.collections.vector.Vector;
use std.collections.vector.VectorError;
use std.memory;

use mink.base.fail;
use mink.base.fail.Fail;

# room for `n` more items without growing
pub fun reserve[T](v: *Vector[T], n: usize) err[Fail] {
    val r: res[usize, A.Error] = vector.reserve[T](v, n);
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}

pub fun push[T](v: *Vector[T], x: T) err[Fail] {
    val r: res[usize, A.Error] = vector.push[T](v, x);
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}

# put `x` at index `at`, moving the items from there on up by one
pub fun insert[T](v: *Vector[T], at: usize, x: T) err[Fail] {
    val r: res[usize, VectorError] = vector.insert[T](v, at, x);
    if (sel r.err) {
        if (sel r.err.alloc) { ret err[Fail].err{fail.refused(r.err.alloc)}; }
        ret err[Fail].err{fail.internal("a vector insert lies past its end")};
    }
    ret err[Fail].ok{};
}

# take out the item at index `at`, moving the items after it down by one
pub fun remove[T](v: *Vector[T], at: usize) err[Fail] {
    val r: opt[T] = vector.remove[T](v, at);
    if (sel r.none) { ret err[Fail].err{fail.internal("a vector remove lies past its end")}; }
    ret err[Fail].ok{};
}

# append the `n` items at `p`
pub fun extend[T](v: *Vector[T], p: *T, n: usize) err[Fail] {
    val r: res[usize, A.Error] = vector.extend[T](v, slice.make[T](p, n));
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}

# append `n` zeroed items
pub fun grow[T](v: *Vector[T], n: usize) err[Fail] {
    val g: err[Fail] = reserve[T](v, n);
    if (sel g.err) { ret g; }
    val room: Slice[T] = vector.spare[T](v);
    if (n != 0) { memory.zero[T](room.data, n); }
    val r: res[usize, VectorError] = vector.commit[T](v, n);
    if (sel r.err) { ret err[Fail].err{fail.internal("a vector grows past its reserve")}; }
    ret err[Fail].ok{};
}

# give back every item pushed since its length read `mark`, keeping the
# storage, so the vector holds what it held then. a mark at or above the
# length leaves it unchanged
pub fun truncate[T](v: *Vector[T], mark: usize) {
    if (mark < vector.length[T](v)) { vector.truncate[T](v, mark); }
}

# give the storage back. the vector is empty after, and releasing it again
# gives back nothing. a refused release leaves the vector as it was
pub fun release[T](v: *Vector[T]) err[Fail] {
    val r: err[A.Error] = vector.dnit[T](v);
    if (sel r.err) { ret err[Fail].err{fail.refused(r.err)}; }
    ret err[Fail].ok{};
}
