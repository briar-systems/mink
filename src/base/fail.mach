# the one failure of mink
#
# a failure never allocates, so building one cannot itself fail, and it stays
# small, as every fallible call returns one by value. its text, reason and cite
# are static. its file, record and subject are borrowed: static, or owned by
# the scope that called the operation returning it, and a failure lives no
# longer than the names it borrows.
#
# so no operation frees what a failure it returns borrows. the link owns names
# it fails on and frees them as it returns, so what it returns is a `Detached`,
# the one failure that owns its names, which needs nothing kept alive and holds
# for as long as the caller holds it.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

# why an operation failed
# ---
# malformed:   the input breaks its specification
# unsupported: the input is valid but asks for what mink does not do
# truncated:   a read past the end of its span
# overflow:    arithmetic over untrusted counts, sizes or offsets overflowed
# refused:     an allocation or a release was refused
# io:          the file system refused to open, read or write a file
# missing:     a file or library the input names does not exist
# internal:    mink broke an invariant of its own
pub tag Cause: u8 {
    malformed;
    unsupported;
    truncated;
    overflow;
    refused: A.Error;
    io;
    missing;
    internal;
}

# where a failure points: a file, a record within it and a byte offset. each
# part is optional, a nil file or record is absent
# ---
# file:    the input's name, borrowed
# record:  the record the failure is in, such as "section header", borrowed
# index:   the record's index, when indexed
# indexed: whether the record names an index
# offset:  the absolute byte offset of the bad field, when placed
# placed:  whether an offset is known
pub rec Location {
    file:    str;
    record:  str;
    index:   u64;
    indexed: bool;
    offset:  u64;
    placed:  bool;
}

# cause:   what went wrong
# text:    the message, static
# at:      where it went wrong
# subject: the name of the item it is about, borrowed, nil when absent
# value:   the one number it is about, absent when none
# reason:  why the host refused, static, nil when absent
# cite:    the authority a refusal rests on, static, nil when absent
pub rec Fail {
    cause:   Cause;
    text:    str;
    at:      Location;
    subject: str;
    value:   opt[i128];
    reason:  str;
    cite:    str;
}

pub fun malformed(text: str) Fail {
    ret Fail{cause: Cause.malformed{}, text: text};
}

pub fun unsupported(text: str) Fail {
    ret Fail{cause: Cause.unsupported{}, text: text};
}

pub fun truncated(text: str) Fail {
    ret Fail{cause: Cause.truncated{}, text: text};
}

pub fun overflow(text: str) Fail {
    ret Fail{cause: Cause.overflow{}, text: text};
}

pub fun refused(e: A.Error) Fail {
    ret Fail{cause: Cause.refused{e}, text: "allocation refused"};
}

pub fun io(text: str) Fail {
    ret Fail{cause: Cause.io{}, text: text};
}

pub fun missing(text: str) Fail {
    ret Fail{cause: Cause.missing{}, text: text};
}

pub fun internal(text: str) Fail {
    ret Fail{cause: Cause.internal{}, text: text};
}

# the same failure in `file`. a failure that already names a file keeps it
pub fun in_file(f: Fail, file: str) Fail {
    var out: Fail = f;
    if (out.at.file == nil) { out.at.file = file; }
    ret out;
}

# the same failure inside the record `record`, the innermost record winning
pub fun in_record(f: Fail, record: str) Fail {
    var out: Fail = f;
    if (out.at.record == nil) { out.at.record = record; }
    ret out;
}

# the same failure inside the `index`th `record`, the innermost record winning
pub fun in_indexed(f: Fail, record: str, index: u64) Fail {
    var out: Fail = f;
    if (out.at.record == nil) {
        out.at.record  = record;
        out.at.index   = index;
        out.at.indexed = true;
    }
    ret out;
}

# the same failure at byte `offset`, the innermost offset winning
pub fun at_offset(f: Fail, offset: u64) Fail {
    var out: Fail = f;
    if (!out.at.placed) {
        out.at.offset = offset;
        out.at.placed = true;
    }
    ret out;
}

# the same failure about `subject`, the innermost subject winning
pub fun about(f: Fail, subject: str) Fail {
    var out: Fail = f;
    if (out.subject == nil) { out.subject = subject; }
    ret out;
}

# the same failure resting on the authority `cite`, the innermost winning
pub fun cited(f: Fail, cite: str) Fail {
    var out: Fail = f;
    if (out.cite == nil) { out.cite = cite; }
    ret out;
}

# the same failure for the host's reason `reason`, the innermost winning
pub fun because(f: Fail, reason: str) Fail {
    var out: Fail = f;
    if (out.reason == nil) { out.reason = reason; }
    ret out;
}

# the same failure about the number `v`, the innermost number winning
pub fun valued(f: Fail, v: i128) Fail {
    var out:    Fail = f;
    val absent: bool = sel out.value.none;
    if (absent) { out.value = opt[i128].some{v}; }
    ret out;
}

# whether the failure is a refused allocation or release
pub fun is_refused(f: Fail) bool {
    ret sel f.cause.refused;
}

# the most bytes a detached failure keeps of one name, its terminator included:
# a path of any host fits, and a longer name is cut and ends in `...`
val NAME_ROOM: usize = 4096;
val CUT_BYTES: usize = 3;

# a name a detached failure owns, zero terminated
# ---
# bytes: its spelling
# held:  whether the failure names it at all
rec Kept {
    bytes: [NAME_ROOM]u8;
    held:  bool;
}

# a failure that owns its names, which outlives everything that made it. it
# holds no pointer but its static text, reason and cite, so it is copied and
# kept like any value. it is large, so it stands at the edge of an operation
# and never in the fallible calls inside one
# ---
# fail:    the failure, naming no file, record or subject of its own
# file:    the file it names
# record:  the record it names
# subject: the subject it names
pub rec Detached {
    fail:    Fail;
    file:    Kept;
    record:  Kept;
    subject: Kept;
}

fun kept_name(to: *Kept, name: str) {
    if (name == nil) { ret; }
    to.held = true;
    var i: usize = 0;
    for (i < NAME_ROOM - 1 && name[i] != 0) {
        to.bytes[i] = name[i];
        i           = i + 1;
    }
    if (name[i] == 0) { ret; }
    for (i > NAME_ROOM - 1 - CUT_BYTES) {
        i           = i - 1;
        to.bytes[i] = '.';
    }
}

# the failure `f` with a copy of every name it borrows, taken before what it
# borrows from is freed
pub fun detach(f: Fail) Detached {
    var d: Detached;
    d.fail           = f;
    d.fail.at.file   = nil;
    d.fail.at.record = nil;
    d.fail.subject   = nil;
    kept_name(?d.file, f.at.file);
    kept_name(?d.record, f.at.record);
    kept_name(?d.subject, f.subject);
    ret d;
}

# the failure `d` holds, borrowing its names from `d`
pub fun view(d: *Detached) Fail {
    var out: Fail = d.fail;
    if (d.file.held)    { out.at.file = ?d.file.bytes[0]; }
    if (d.record.held)  { out.at.record = ?d.record.bytes[0]; }
    if (d.subject.held) { out.subject = ?d.subject.bytes[0]; }
    ret out;
}

# the outcome of two steps run in turn whatever the first gave: the first
# failure, or `next` when `first` did not fail
pub fun kept(first: err[Fail], next: err[Fail]) err[Fail] {
    if (sel first.err) { ret first; }
    ret next;
}

# the input breaks its specification at the `index`th `record`, which holds the
# number `v` as written, such as an index outside the table it names
pub fun malformed_at(text: str, record: str, index: u64, v: i128) Fail {
    ret valued(in_indexed(malformed(text), record, index), v);
}
