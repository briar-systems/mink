# renders a failure, or a note of what a run did, in the form of mach's
# command line: a headline of the tool's code and the message, then the place
# after `@`, then what a refused part accepts as a note
#
#     error[mink] read past the end of the data
#       @ a.o, section header 7, offset 0x1c8
#
# a message is a sentence. where it names the item it is about, `{}` stands for
# the item, the subject or else the text given for the refused part, written in
# backticks; where it names the file as its actor, `{at}` stands for the file.
# an item or a file the message names leaves the place, and what the message
# does not name stays there:
#
#     error[target] no system is named `bogus`
#       @ target, sys
#       note it accepts linux, darwin, ...
#     note[mink] main.o refers to `memcpy`
#
# a failure the host refused names the host's reason after the message, and a
# failure resting on an authority names it last, each in parentheses:
#
#     error[mink] cannot read the file (not found)
#       @ a.o
#
# a note of what a run did is one line, what is left of its place in
# parentheses, and a failure set into another tool's message is one line of the
# same parts with no head: `summary`

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_len;
use std.types.view.View;

use mink.base.fail;
use mink.base.fail.Accepts;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.fail.Refused;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

# what a message names itself, so the place leaves it out
# ---
# item: the message names the item it is about, the subject or the given part
# file: the message names the file as its actor
rec Named {
    item: bool;
    file: bool;
}

# mink's own code, which heads every failure mink prints
pub val PREFIX: *u8 = "error[mink] ";

# the head of every note of what a run did
pub val NOTE: *u8 = "note[mink] ";

# append the diagnostic for `f`, headed by the caller's `code` as it spells
# it, nothing where nil, each of its lines ending in a newline, to `out`
pub fun render(code: str, f: Fail, out: *Sink) err[Fail] {
    val subject:  opt[View] = at_subject(f.subject);
    val named:    Named     = names(held(f));
    var err_text: err[Fail] = err[Fail].ok{};
    if (code != nil) { err_text = sink.text(out, code); }
    err_text = fail.kept(err_text, message(f, subject, out));
    err_text = fail.kept(err_text, sink.text(out, "\n"));
    if (placed(f.at, subject, f.value, f.refused, named)) {
        err_text = fail.kept(err_text, sink.text(out, "  @ "));
        err_text = fail.kept(err_text, place(f.at, subject, f.value, f.refused, named, out));
        err_text = fail.kept(err_text, sink.text(out, "\n"));
    }
    if (sel f.refused.some) {
        if (sel f.refused.some.accepts.some) {
            err_text = fail.kept(err_text, sink.text(out, "  note it accepts "));
            err_text = fail.kept(err_text, accepted(f.refused.some.accepts.some, out));
            err_text = fail.kept(err_text, sink.text(out, "\n"));
        }
    }
    ret err_text;
}

# append the diagnostic for `f` as one line with no head and no newline, for a
# tool that sets it into a message of its own: the message, then the place in
# parentheses, then what a refused part accepts
pub fun summary(f: Fail, out: *Sink) err[Fail] {
    val subject:  opt[View] = at_subject(f.subject);
    val named:    Named     = names(held(f));
    var err_text: err[Fail] = message(f, subject, out);
    if (placed(f.at, subject, f.value, f.refused, named)) {
        err_text = fail.kept(err_text, sink.text(out, " ("));
        err_text = fail.kept(err_text, place(f.at, subject, f.value, f.refused, named, out));
        err_text = fail.kept(err_text, sink.text(out, ")"));
    }
    if (sel f.refused.some) {
        if (sel f.refused.some.accepts.some) {
            err_text = fail.kept(err_text, sink.text(out, ", and it accepts "));
            err_text = fail.kept(err_text, accepted(f.refused.some.accepts.some, out));
        }
    }
    ret err_text;
}

# append the message of `f` alone, its item and file set in, with the host's reason
# and the authority, for a tool that writes the place in its own way
pub fun said(f: Fail, out: *Sink) err[Fail] {
    ret message(f, at_subject(f.subject), out);
}

# whether the message of `f` names the item it is about, so a tool leaves it out of the place
pub fun names_item(f: Fail) bool {
    ret names(held(f)).item;
}

# append a note of what a run did rather than a failure, about `subject` at
# `at`, and a newline to `out`
pub fun note(at: Location, subject: str, text: str, out: *Sink) err[Fail] {
    ret note_line(at, at_subject(subject), opt[i128].none{}, text, out);
}

# append a note about the name `name`, whose bytes are borrowed only for the
# call, as `note` does
pub fun note_named(at: Location, name: View, text: str, out: *Sink) err[Fail] {
    ret note_line(at, opt[View].some{name}, opt[i128].none{}, text, out);
}

# append a note about `subject` and its value `value` at `at`, as `note` does
pub fun note_valued(at: Location, subject: str, value: i128, text: str, out: *Sink) err[Fail] {
    ret note_line(at, at_subject(subject), opt[i128].some{value}, text, out);
}

fun note_line(at: Location, subject: opt[View], value: opt[i128], text: str, out: *Sink) err[Fail] {
    val named:    Named     = names(text);
    var err_text: err[Fail] = sink.text(out, NOTE);
    err_text = fail.kept(err_text, sentence(text, subject, at.file, out));
    if (placed(at, subject, value, opt[Refused].none{}, named)) {
        err_text = fail.kept(err_text, sink.text(out, " ("));
        err_text = fail.kept(err_text, place(at, subject, value, opt[Refused].none{}, named, out));
        err_text = fail.kept(err_text, sink.text(out, ")"));
    }
    ret fail.kept(err_text, sink.text(out, "\n"));
}

# the words of `f` with their holes, which only this module reads
fun held(f: Fail) str {
    ret f.words.held::str;
}

# the bytes of a subject, none when nil
fun at_subject(subject: str) opt[View] {
    if (subject == nil) { ret opt[View].none{}; }
    ret opt[View].some{View{data: subject::*u8, len: str_len(subject)}};
}

# which of the item and the file the message `text` names
fun names(text: str) Named {
    ret Named{item: str_contains(text, "{}"), file: str_contains(text, "{at}")};
}

# the item a failure is about: its subject, else the text given for the part it refuses
fun item_of(subject: opt[View], refused: opt[Refused]) opt[View] {
    if (sel subject.some) { ret subject; }
    if (sel refused.some) {
        if (refused.some.given.len > 0) { ret opt[View].some{refused.some.given}; }
    }
    ret opt[View].none{};
}

# the message `text` with the item in backticks for each `{}` and `file` for each `{at}`
fun sentence(text: str, item: opt[View], file: str, out: *Sink) err[Fail] {
    val s:        *u8       = text::*u8;
    var err_text: err[Fail] = err[Fail].ok{};
    var start:    usize     = 0;
    var i:        usize     = 0;
    for (s[i] != 0) {
        if (s[i] == '{' && s[i + 1] == '}') {
            err_text = fail.kept(err_text, sink.bytes(out, ?s[start], i - start));
            err_text = fail.kept(err_text, quoted(item, out));
            i        = i + 2;
            start    = i;
            cnt;
        }
        if (s[i] == '{' && s[i + 1] == 'a' && s[i + 2] == 't' && s[i + 3] == '}') {
            err_text = fail.kept(err_text, sink.bytes(out, ?s[start], i - start));
            if (file != nil) { err_text = fail.kept(err_text, sink.text(out, file)); }
            or               { err_text = fail.kept(err_text, sink.text(out, "an input")); }
            i     = i + 4;
            start = i;
            cnt;
        }
        i = i + 1;
    }
    ret fail.kept(err_text, sink.bytes(out, ?s[start], i - start));
}

# the item in backticks, or `it` where the failure names none
fun quoted(item: opt[View], out: *Sink) err[Fail] {
    if (sel item.none) { ret sink.text(out, "it"); }
    var err_text: err[Fail] = sink.text(out, "`");
    err_text = fail.kept(err_text, sink.bytes(out, item.some.data, item.some.len));
    ret fail.kept(err_text, sink.text(out, "`"));
}

# the sentence of `f`, then the host's reason and the authority, each in parentheses
fun message(f: Fail, subject: opt[View], out: *Sink) err[Fail] {
    val reason:   str       = f.reason;
    val cite:     str       = f.cite;
    var err_text: err[Fail] = sentence(held(f), item_of(subject, f.refused), f.at.file, out);
    if (reason != nil) {
        err_text = fail.kept(err_text, sink.text(out, " ("));
        err_text = fail.kept(err_text, sink.text(out, reason));
        err_text = fail.kept(err_text, sink.text(out, ")"));
    }
    if (cite != nil) {
        err_text = fail.kept(err_text, sink.text(out, " ("));
        err_text = fail.kept(err_text, sink.text(out, cite));
        err_text = fail.kept(err_text, sink.text(out, ")"));
    }
    ret err_text;
}

# whether a failure has a place or an item left that its message does not name
fun placed(at: Location, subject: opt[View], value: opt[i128], refused: opt[Refused], named: Named) bool {
    if (at.file != nil && !named.file)   { ret true; }
    if (sel subject.some && !named.item) { ret true; }
    ret at.record != nil || at.placed || sel value.some || sel refused.some;
}

# the file, `record index`, `offset 0xN`, the subject, `value N` and the part
# refused with the text given for it, each present one the message does not
# name joined to the last by a comma
fun place(at: Location, subject: opt[View], value: opt[i128], refused: opt[Refused], named: Named, out: *Sink) err[Fail] {
    var err_text: err[Fail] = err[Fail].ok{};
    var sep:      str       = "";
    if (at.file != nil && !named.file) {
        err_text = fail.kept(err_text, sink.text(out, at.file));
        sep      = ", ";
    }
    if (at.record != nil) {
        err_text = fail.kept(err_text, sink.text(out, sep));
        err_text = fail.kept(err_text, record(at, out));
        sep      = ", ";
    }
    if (at.placed) {
        err_text = fail.kept(err_text, sink.text(out, sep));
        err_text = fail.kept(err_text, sink.text(out, "offset 0x"));
        err_text = fail.kept(err_text, sink.number(out, at.offset, 16));
        sep      = ", ";
    }
    if (sel subject.some) {
        if (!named.item) {
            err_text = fail.kept(err_text, sink.text(out, sep));
            err_text = fail.kept(err_text, sink.bytes(out, subject.some.data, subject.some.len));
            sep      = ", ";
        }
    }
    if (sel value.some) {
        err_text = fail.kept(err_text, sink.text(out, sep));
        err_text = fail.kept(err_text, sink.text(out, "value "));
        err_text = fail.kept(err_text, sink.signed(out, value.some));
        sep      = ", ";
    }
    if (sel refused.some) {
        err_text = fail.kept(err_text, sink.text(out, sep));
        err_text = fail.kept(err_text, sink.text(out, refused.some.part));
        val shown: bool = named.item && sel subject.none;
        if (refused.some.given.len > 0 && !shown) {
            err_text = fail.kept(err_text, sink.text(out, " `"));
            err_text = fail.kept(err_text, sink.bytes(out, refused.some.given.data, refused.some.given.len));
            err_text = fail.kept(err_text, sink.text(out, "`"));
        }
    }
    ret err_text;
}

# the names a part accepts joined by commas, or `none` where it accepts none
fun accepted(listed: Accepts, out: *Sink) err[Fail] {
    var a: Accepts = listed;
    if (a.name(?a, 0) == nil) { ret sink.text(out, "none"); }
    var err_text: err[Fail] = err[Fail].ok{};
    var i:        usize     = 0;
    for (a.name(?a, i) != nil) {
        if (i > 0) { err_text = fail.kept(err_text, sink.text(out, ", ")); }
        err_text = fail.kept(err_text, sink.text(out, a.name(?a, i)));
        i        = i + 1;
    }
    ret err_text;
}

# append the record `at` names, as `record` or `record index`, as every
# diagnostic writes it
pub fun record(at: Location, out: *Sink) err[Fail] {
    val err_text: err[Fail] = sink.text(out, at.record);
    if (sel err_text.err) { ret err_text; }
    if (!at.indexed)      { ret err[Fail].ok{}; }
    val err_text_out: err[Fail] = sink.text(out, " ");
    if (sel err_text_out.err) { ret err_text_out; }
    ret sink.number(out, at.index, 10);
}
