# renders a failure, or a note of what a run did, as one diagnostic line
#
# every diagnostic of mink starts with the one prefix `mink:`, then the
# location the failure names, then its text:
#
#     mink: a.o: section header 7, offset 0x1c8: read past the end of the data
#
# a failure resting on an authority names it after the text, in parentheses:
#
#     mink: ABS8: no form for this size (RISC-V psABI)
#
# a failure about an item and a number names them before its text, each
# omitted when absent:
#
#     mink: a.o: section 3, offset 0x10: R_X86_64_PC32, value 4294967296: relocation value is out of range

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.allocator.testing;
use std.memory;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

pub val PREFIX: *u8 = "mink: ";

# append the diagnostic for `f` and a newline to `out`
pub fun render(f: Fail, out: *Sink) err[Fail] {
    ret line(at_subject(f.subject), f.at, f.value, f.text, f.cite, out);
}

# append a line of the same shape that reports what a run did rather than a
# failure, about `subject` at `at`, and a newline to `out`
pub fun note(at: Location, subject: str, text: str, out: *Sink) err[Fail] {
    ret line(at_subject(subject), at, opt[i128].none{}, text, nil, out);
}

# append a note about the name `name`, whose bytes are borrowed only for the
# call, as `note` does
pub fun note_named(at: Location, name: View, text: str, out: *Sink) err[Fail] {
    ret line(opt[View].some{name}, at, opt[i128].none{}, text, nil, out);
}

# append a note about `subject` and its value `value` at `at`, as `note` does
pub fun note_valued(at: Location, subject: str, value: i128, text: str, out: *Sink) err[Fail] {
    ret line(at_subject(subject), at, opt[i128].some{value}, text, nil, out);
}

# append a line of the same shape that reports a warning an input asks the
# link to give, about the name `name` when some, at `at`: `warning: ` and the
# input's text, whose bytes are borrowed only for the call, and a newline
pub fun warning(at: Location, name: opt[View], text: View, out: *Sink) err[Fail] {
    val wh: err[Fail] = head(name, at, opt[i128].none{}, out);
    if (sel wh.err) { ret wh; }
    val ww: err[Fail] = sink.text(out, "warning: ");
    if (sel ww.err) { ret ww; }
    val wt: err[Fail] = sink.bytes(out, text.data, text.len);
    if (sel wt.err) { ret wt; }
    ret sink.text(out, "\n");
}

# the bytes of a static subject, none when nil
fun at_subject(subject: str) opt[View] {
    if (subject == nil) { ret opt[View].none{}; }
    ret opt[View].some{View{data: subject::*u8, len: str_len(subject)}};
}

fun line(subject: opt[View], at: Location, value: opt[i128], text: str, cite: str, out: *Sink) err[Fail] {
    val wh: err[Fail] = head(subject, at, value, out);
    if (sel wh.err) { ret wh; }
    val wt: err[Fail] = sink.text(out, text);
    if (sel wt.err) { ret wt; }
    if (cite != nil) {
        val wc: err[Fail] = sink.text(out, " (");
        if (sel wc.err) { ret wc; }
        val wn: err[Fail] = sink.text(out, cite);
        if (sel wn.err) { ret wn; }
        val wz: err[Fail] = sink.text(out, ")");
        if (sel wz.err) { ret wz; }
    }
    ret sink.text(out, "\n");
}

# the prefix, the location, the subject and the value of a line
fun head(subject: opt[View], at: Location, value: opt[i128], out: *Sink) err[Fail] {
    val wp: err[Fail] = sink.text(out, PREFIX);
    if (sel wp.err) { ret wp; }
    val wl: err[Fail] = location(at, out);
    if (sel wl.err) { ret wl; }
    ret about(subject, value, out);
}

# the subject and the value, each followed by `, ` or the last by `: `
fun about(subject: opt[View], value: opt[i128], out: *Sink) err[Fail] {
    val named: bool = sel subject.some;
    if (sel subject.some) {
        val ws: err[Fail] = sink.bytes(out, subject.some.data, subject.some.len);
        if (sel ws.err) { ret ws; }
    }
    if (sel value.some) {
        if (named) {
            val wc: err[Fail] = sink.text(out, ", ");
            if (sel wc.err) { ret wc; }
        }
        val wl: err[Fail] = sink.text(out, "value ");
        if (sel wl.err) { ret wl; }
        val wv: err[Fail] = sink.signed(out, value.some);
        if (sel wv.err) { ret wv; }
    }
    if (!named && sel value.none) { ret err[Fail].ok{}; }
    ret sink.text(out, ": ");
}

# append the record `at` names, as `record` or `record index`, as every
# diagnostic writes it
pub fun record(at: Location, out: *Sink) err[Fail] {
    val wr: err[Fail] = sink.text(out, at.record);
    if (sel wr.err)  { ret wr; }
    if (!at.indexed) { ret err[Fail].ok{}; }
    val wi: err[Fail] = sink.text(out, " ");
    if (sel wi.err) { ret wi; }
    ret sink.number(out, at.index, 10);
}

# `file: `, then `record index` and `offset 0xN` joined by a comma, then `: `
fun location(at: Location, out: *Sink) err[Fail] {
    if (at.file != nil) {
        val wf: err[Fail] = sink.text(out, at.file);
        if (sel wf.err) { ret wf; }
        val ws: err[Fail] = sink.text(out, ": ");
        if (sel ws.err) { ret ws; }
    }
    if (at.record != nil) {
        val wr: err[Fail] = record(at, out);
        if (sel wr.err) { ret wr; }
        if (!at.placed) { ret sink.text(out, ": "); }
        val wc: err[Fail] = sink.text(out, ", ");
        if (sel wc.err) { ret wc; }
    }
    if (!at.placed) { ret err[Fail].ok{}; }
    val wo: err[Fail] = sink.text(out, "offset 0x");
    if (sel wo.err) { ret wo; }
    val wv: err[Fail] = sink.number(out, at.offset, 16);
    if (sel wv.err) { ret wv; }
    ret sink.text(out, ": ");
}

test diag__renders_prefix_file_record_and_offset {
    var t:    testing.Testing;
    val made: err[A.Error] = testing.make(?t);
    if (sel made.err) { ret 1; }
    var out: Sink = sink.make(testing.allocator_of(?t), LITTLE);
    var f:   Fail = fail.at_offset(fail.truncated("read past the end of the data"), 0x1c8);
    f = fail.in_file(fail.in_indexed(f, "section header", 7), "a.o");
    val w: err[Fail] = render(f, ?out);
    if (sel w.err) { ret 1; }
    val want: *u8   = "mink: a.o: section header 7, offset 0x1c8: read past the end of the data\n";
    val n:    usize = 73;
    if (sink.len(?out) != n)                                   { ret 1; }
    if (!memory.raw_equal(sink.data(?out)::ptr, want::ptr, n)) { ret 1; }
    val up: err[Fail] = sink.release(?out);
    if (sel up.err) { ret 1; }

    # a subject and a value come before the text, each omitted when absent
    out = sink.make(testing.allocator_of(?t), LITTLE);
    var g: Fail = fail.at_offset(fail.in_indexed(fail.in_file(fail.overflow("relocation value is out of range"), "a.o"), "section", 3), 0x10);
    g = fail.valued(fail.about(g, "R_X86_64_PC32"), 0x1_0000_0000);
    g = fail.valued(fail.about(g, "other"), 7);
    val wg: err[Fail] = render(g, ?out);
    if (sel wg.err) { ret 1; }
    val want2: *u8 = "mink: a.o: section 3, offset 0x10: R_X86_64_PC32, value 4294967296: relocation value is out of range\n";
    if (sink.len(?out) != 101)                                    { ret 1; }
    if (!memory.raw_equal(sink.data(?out)::ptr, want2::ptr, 101)) { ret 1; }
    val rel: err[Fail] = sink.release(?out);
    if (sel rel.err) { ret 1; }

    # a cited authority follows the text
    out = sink.make(testing.allocator_of(?t), LITTLE);
    val c:  Fail      = fail.cited(fail.about(fail.unsupported("no form"), "ABS8"), "psABI");
    val wc: err[Fail] = render(c, ?out);
    if (sel wc.err) { ret 1; }
    val want3: *u8 = "mink: ABS8: no form (psABI)\n";
    if (sink.len(?out) != 28)                                    { ret 1; }
    if (!memory.raw_equal(sink.data(?out)::ptr, want3::ptr, 28)) { ret 1; }
    val rel3: err[Fail] = sink.release(?out);
    if (sel rel3.err) { ret 1; }
    testing.dnit(?t);
    ret 0;
}
