# renders a failure, or a note of what a run did, as one diagnostic line
#
# every diagnostic starts with the code of the tool that prints it, `mink: `
# for mink's own, then the location the failure names, then its text:
#
#     mink: a.o: section header 7, offset 0x1c8: read past the end of the data
#
# a tool printing a failure of mink's under its own code passes that code as
# it spells it, or nil where it has written its own head:
#
#     error[target]: target: abi `lp64q`: the architecture has no calling convention of this name, accepted: lp64d, lp64f, lp64
#
# a failure the host refused names the host's reason after the text:
#
#     mink: a.o: cannot read the file: not found
#
# a failure resting on an authority names it after the text, in parentheses:
#
#     mink: ABS8: no form for this size (RISC-V psABI)
#
# a failure about an item and a number names them before its text, each
# omitted when absent:
#
#     mink: a.o: section 3, offset 0x10: R_X86_64_PC32, value 4294967296: relocation value is out of range
#
# a failure refusing a value given for a part names the part and the value
# before its text, and what the part accepts after it:
#
#     mink: target: abi `lp64q`: the architecture has no calling convention of this name, accepted: lp64d, lp64f, lp64

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use mink.base.fail.Accepts;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.fail.Refused;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

# mink's own code, which heads every line mink prints
pub val PREFIX: *u8 = "mink: ";

# append the diagnostic for `f`, headed by the caller's `code` as it spells
# it, nothing where nil, and a newline to `out`
pub fun render(code: str, f: Fail, out: *Sink) err[Fail] {
    ret line(code, at_subject(f.subject), f.at, f.value, f.refused, f.text, f.reason, f.cite, out);
}

# append a line of the same shape that reports what a run did rather than a
# failure, about `subject` at `at`, and a newline to `out`
pub fun note(at: Location, subject: str, text: str, out: *Sink) err[Fail] {
    ret line(PREFIX, at_subject(subject), at, opt[i128].none{}, opt[Refused].none{}, text, nil, nil, out);
}

# append a note about the name `name`, whose bytes are borrowed only for the
# call, as `note` does
pub fun note_named(at: Location, name: View, text: str, out: *Sink) err[Fail] {
    ret line(PREFIX, opt[View].some{name}, at, opt[i128].none{}, opt[Refused].none{}, text, nil, nil, out);
}

# append a note about `subject` and its value `value` at `at`, as `note` does
pub fun note_valued(at: Location, subject: str, value: i128, text: str, out: *Sink) err[Fail] {
    ret line(PREFIX, at_subject(subject), at, opt[i128].some{value}, opt[Refused].none{}, text, nil, nil, out);
}

# the bytes of a subject, none when nil
fun at_subject(subject: str) opt[View] {
    if (subject == nil) { ret opt[View].none{}; }
    ret opt[View].some{View{data: subject::*u8, len: str_len(subject)}};
}

fun line(code: str, subject: opt[View], at: Location, value: opt[i128], refused: opt[Refused], text: str, reason: str, cite: str, out: *Sink) err[Fail] {
    if (code != nil) {
        val err_text: err[Fail] = sink.text(out, code);
        if (sel err_text.err) { ret err_text; }
    }
    val err_location: err[Fail] = location(at, out);
    if (sel err_location.err) { ret err_location; }
    val err_about: err[Fail] = about(subject, value, out);
    if (sel err_about.err) { ret err_about; }
    if (sel refused.some) {
        val err_given: err[Fail] = given(refused.some, out);
        if (sel err_given.err) { ret err_given; }
    }
    val err_text: err[Fail] = sink.text(out, text);
    if (sel err_text.err) { ret err_text; }
    if (sel refused.some) {
        val err_accepted: err[Fail] = accepted(refused.some.accepts, out);
        if (sel err_accepted.err) { ret err_accepted; }
    }
    if (reason != nil) {
        val err_text: err[Fail] = sink.text(out, ": ");
        if (sel err_text.err) { ret err_text; }
        val err_text_out: err[Fail] = sink.text(out, reason);
        if (sel err_text_out.err) { ret err_text_out; }
    }
    if (cite != nil) {
        val err_text: err[Fail] = sink.text(out, " (");
        if (sel err_text.err) { ret err_text; }
        val err_text_out: err[Fail] = sink.text(out, cite);
        if (sel err_text_out.err) { ret err_text_out; }
        val err_close_written: err[Fail] = sink.text(out, ")");
        if (sel err_close_written.err) { ret err_close_written; }
    }
    ret sink.text(out, "\n");
}

# the subject and the value, each followed by `, ` or the last by `: `
fun about(subject: opt[View], value: opt[i128], out: *Sink) err[Fail] {
    val named: bool = sel subject.some;
    if (sel subject.some) {
        val err_bytes: err[Fail] = sink.bytes(out, subject.some.data, subject.some.len);
        if (sel err_bytes.err) { ret err_bytes; }
    }
    if (sel value.some) {
        if (named) {
            val err_text: err[Fail] = sink.text(out, ", ");
            if (sel err_text.err) { ret err_text; }
        }
        val err_text: err[Fail] = sink.text(out, "value ");
        if (sel err_text.err) { ret err_text; }
        val err_signed: err[Fail] = sink.signed(out, value.some);
        if (sel err_signed.err) { ret err_signed; }
    }
    if (!named && sel value.none) { ret err[Fail].ok{}; }
    ret sink.text(out, ": ");
}

# the part refused and the text given for it, then `: `
fun given(r: Refused, out: *Sink) err[Fail] {
    val err_text: err[Fail] = sink.text(out, r.part);
    if (sel err_text.err) { ret err_text; }
    if (r.given.len > 0) {
        val err_text: err[Fail] = sink.text(out, " `");
        if (sel err_text.err) { ret err_text; }
        val err_bytes: err[Fail] = sink.bytes(out, r.given.data, r.given.len);
        if (sel err_bytes.err) { ret err_bytes; }
        val err_text_out: err[Fail] = sink.text(out, "`");
        if (sel err_text_out.err) { ret err_text_out; }
    }
    ret sink.text(out, ": ");
}

# `, accepted: ` and the names the part accepts joined by commas, or that it
# accepts none, nothing where it lists nothing
fun accepted(listed: opt[Accepts], out: *Sink) err[Fail] {
    if (sel listed.none) { ret err[Fail].ok{}; }
    var a: Accepts = listed.some;
    if (a.name(?a, 0) == nil) { ret sink.text(out, ", and it accepts none"); }
    val err_text: err[Fail] = sink.text(out, ", accepted: ");
    if (sel err_text.err) { ret err_text; }
    var i: usize = 0;
    for (a.name(?a, i) != nil) {
        if (i > 0) {
            val err_text: err[Fail] = sink.text(out, ", ");
            if (sel err_text.err) { ret err_text; }
        }
        val err_text: err[Fail] = sink.text(out, a.name(?a, i));
        if (sel err_text.err) { ret err_text; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# append the record `at` names, as `record` or `record index`, as every
# diagnostic writes it
pub fun record(at: Location, out: *Sink) err[Fail] {
    val err_text: err[Fail] = sink.text(out, at.record);
    if (sel err_text.err) { ret err_text; }
    if (!at.indexed)      { ret err[Fail].ok{}; }
    val err_text_out: err[Fail] = sink.text(out, " ");
    if (sel err_text_out.err) { ret err_text_out; }
    ret sink.number(out, at.index, 10);
}

# `file: `, then `record index` and `offset 0xN` joined by a comma, then `: `
fun location(at: Location, out: *Sink) err[Fail] {
    if (at.file != nil) {
        val err_text: err[Fail] = sink.text(out, at.file);
        if (sel err_text.err) { ret err_text; }
        val err_text_out: err[Fail] = sink.text(out, ": ");
        if (sel err_text_out.err) { ret err_text_out; }
    }
    if (at.record != nil) {
        val err_record: err[Fail] = record(at, out);
        if (sel err_record.err) { ret err_record; }
        if (!at.placed)         { ret sink.text(out, ": "); }
        val err_text: err[Fail] = sink.text(out, ", ");
        if (sel err_text.err) { ret err_text; }
    }
    if (!at.placed) { ret err[Fail].ok{}; }
    val err_text: err[Fail] = sink.text(out, "offset 0x");
    if (sel err_text.err) { ret err_text; }
    val err_number: err[Fail] = sink.number(out, at.offset, 16);
    if (sel err_number.err) { ret err_number; }
    ret sink.text(out, ": ");
}
