# where a field lies in a fixed record
#
# a format's shape tables name each field of a record by its slot, so one
# record layout serves every class and byte order of the format.

use std.encoding.binary;
use std.types.size.usize;

use mink.lib.reader.Order;

# where a field lies in its record. a width of zero is a field the record
# does not have
pub rec Slot {
    offset: u8;
    width:  u8;
}

# the field `s` of the record at `p`, in `order`
pub fun field(p: *u8, s: Slot, order: Order) u64 {
    if (s.width == 0) { ret 0; }
    ret binary.get_uint(?p[s.offset::usize], s.width::usize, order);
}

# set the field `s` of the record at `p` to the low bytes of `v`, in `order`
pub fun set_field(p: *u8, s: Slot, order: Order, v: u64) {
    if (s.width == 0) { ret; }
    binary.put_uint(?p[s.offset::usize], v, s.width::usize, order);
}
