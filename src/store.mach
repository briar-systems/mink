# the bytes a model holds
#
# a model holds bytes one way: borrowed from an input that outlives it, or
# owned in its store. owned bytes are named by their place in the store, so
# they stay valid as the store grows.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.buffer;
use mink.buffer.Buffer;
use mink.fail.Fail;

# bytes borrowed from an input
pub rec Bytes {
    data: *u8;
    len:  usize;
}

# bytes in a store
pub rec Span {
    start: usize;
    len:   usize;
}

# bytes a model holds
# ---
# borrowed: bytes of an input
# owned:    bytes in the model's store
pub tag Held: u8 {
    borrowed: Bytes;
    owned:    Span;
}

# why bytes are held raw
# ---
# opaque:         no codec decodes bytes of this kind
# unsupported:    a codec declined bytes of a kind it decodes
# irreproducible: a codec decoded them, but its entries do not encode back to these bytes
pub tag Why: u8 {
    opaque;
    unsupported;
    irreproducible;
}

# bytes held as they were read, and why
pub rec Raw {
    bytes: Held;
    why:   Why;
}

# the word a reason is printed as
pub fun why_name(w: *Why) str {
    if (sel w.opaque)      { ret "opaque"; }
    if (sel w.unsupported) { ret "unsupported"; }
    ret "irreproducible";
}

pub rec Store {
    bytes: Buffer;
}

pub fun make(a: *A.Allocator) Store {
    ret Store{bytes: buffer.make(a)};
}

# a copy of the `n` bytes at `p` the store owns
pub fun own(s: *Store, p: *u8, n: usize) res[Held, Fail] {
    val start: res[usize, Fail] = buffer.extend(?s.bytes, p, n);
    if (sel start.err) { ret res[Held, Fail].err{start.err}; }
    ret res[Held, Fail].ok{Held.owned{Span{start: start.ok, len: n}}};
}

# the bytes of `h`. owned bytes stay valid until the store next owns bytes
pub fun bytes(s: *Store, h: *Held) Bytes {
    ret at(base(s), h);
}

# where the store's owned bytes begin, valid until it next owns bytes
pub fun base(s: *Store) *u8 {
    ret buffer.at(?s.bytes, 0);
}

# the bytes of `h` when the owned bytes of whoever holds it begin at `base`,
# as a store's or a table of bytes' do
pub fun at(base: *u8, h: *Held) Bytes {
    if (sel h.borrowed) { ret h.borrowed; }
    ret Bytes{data: ?base[h.owned.start], len: h.owned.len};
}

pub fun release(s: *Store) err[Fail] {
    ret buffer.release(?s.bytes);
}
