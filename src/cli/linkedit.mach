use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.heap;

use mink.fail.Fail;
use mink.format.file;
use mink.format.file.Loaded;
use mink.macho.fat;
use mink.macho.fat.Fat;
use mink.macho.fat.Slice;
use mink.macho.fixups;
use mink.macho.fixups.Link;
use mink.macho.model;
use mink.macho.model.Bind;
use mink.macho.model.Blob;
use mink.macho.model.Chained;
use mink.macho.model.Command;
use mink.macho.model.CsBlob;
use mink.macho.model.DataInCode;
use mink.macho.model.Export;
use mink.macho.model.MachO;
use mink.macho.model.Part;
use mink.macho.model.PointerFormat;
use mink.macho.model.Rebase;
use mink.macho.model.Section;
use mink.macho.model.SegmentInfo;
use mink.macho.model.Signature;
use mink.macho.model.Unwind;
use mink.macho.model.UnwindInfo;
use mink.macho.model.Why;
use mink.macho.opcode;
use mink.macho.opcode.Flavor;
use mink.macho.read;
use mink.macho.signature;
use mink.macho.starts;
use mink.macho.tables;
use mink.macho.trie;
use mink.macho.unwind;
use mink.reader;
use mink.reader.LITTLE;
use mink.reader.Reader;
use mink.sink;
use mink.sink.Sink;
use mink.store;
use mink.store.Bytes;
use mink.store.Store;
use mink.table;
use mink.table.Table;

fun diff(a: *u8, an: usize, b: *u8, bn: usize) i64 {
    if (an != bn) { print.printlnf("length {} vs {}", an, bn); }
    var i: usize = 0;
    var n: usize = an;
    if (bn < n) { n = bn; }
    for (i < n) {
        if (a[i] != b[i]) {
            print.printlnf("first difference at {}: {:x} vs {:x}", i, a[i], b[i]);
            ret 1;
        }
        i = i + 1;
    }
    if (an != bn) { ret 1; }
    ret 0;
}

fun why_name(w: *Why) str {
    if (sel w.opaque)      { ret "opaque"; }
    if (sel w.unsupported) { ret "unsupported"; }
    ret "irreproducible";
}

fun part_name(p: *Part) str {
    if (sel p.symbols)   { ret "symbols"; }
    if (sel p.strings)   { ret "strings"; }
    if (sel p.toc)       { ret "toc"; }
    if (sel p.modules)   { ret "modules"; }
    if (sel p.refs)      { ret "refs"; }
    if (sel p.indirect)  { ret "indirect"; }
    if (sel p.extrel)    { ret "extrel"; }
    if (sel p.locrel)    { ret "locrel"; }
    if (sel p.hints)     { ret "hints"; }
    if (sel p.rebase)    { ret "rebase"; }
    if (sel p.bind)      { ret "bind"; }
    if (sel p.weak_bind) { ret "weak_bind"; }
    if (sel p.lazy_bind) { ret "lazy_bind"; }
    if (sel p.exports)   { ret "exports"; }
    if (sel p.data)      { ret "data"; }
    if (sel p.note)      { ret "note"; }
    ret "symseg";
}

fun report_signature(sig: *Signature) {
    var i: usize = 0;
    for (i < table.count[CsBlob](?sig.blobs)) {
        val c: *CsBlob = table.at[CsBlob](?sig.blobs, table.nth[CsBlob](i));
        if (sel c.body.raw) { print.printlnf("raw signature_blob {}", why_name(?c.body.raw.why)); }
        or {
            print.println("entries signature_blob");
        }
        i = i + 1;
    }
}

fun report_blob(m: *MachO, b: *Blob) {
    val cmd: u32 = model.command_at(m, b.command).cmd;
    if (sel b.data.raw) {
        print.printlnf("raw {} {:x} {}", part_name(?b.part), cmd, why_name(?b.data.raw.why));
        ret;
    }
    if (sel b.data.rebases || sel b.data.binds || sel b.data.exports || sel b.data.starts || sel b.data.data_in_code || sel b.data.fixups || sel b.data.signature) {
        print.printlnf("entries {} {:x}", part_name(?b.part), cmd);
    }
    if (sel b.data.signature) { report_signature(?b.data.signature); }
}

fun report_section(s: *Section) {
    if (sel s.body.info)                                                             { print.println("entries unwind_info"); }
    if (sel s.body.unwind)                                                           { print.println("entries compact_unwind"); }
    if (!sel s.body.raw)                                                             { ret; }
    if (model.section_named(s, tables.SEG_TEXT.text, tables.SECT_UNWIND_INFO.text))  { print.printlnf("raw unwind_info {}", why_name(?s.body.raw.why)); }
    if (model.section_named(s, tables.SEG_LD.text, tables.SECT_COMPACT_UNWIND.text)) { print.printlnf("raw compact_unwind {}", why_name(?s.body.raw.why)); }
}

fun report(m: *MachO) {
    var i: usize = 0;
    for (i < table.count[Blob](?m.blobs)) {
        report_blob(m, model.blob_at(m, table.nth[Blob](i)));
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Command](?m.commands)) {
        val c: *Command = model.command_at(m, table.nth[Command](i));
        i = i + 1;
        if (!sel c.body.segment) { cnt; }
        var k: usize = 0;
        for (k < table.count[Section](?c.body.segment.sections)) {
            report_section(table.at[Section](?c.body.segment.sections, table.nth[Section](k)));
            k = k + 1;
        }
    }
}

# every slice of the Mach-O file at `path`, thin or fat
fun read_file(a: *A.Allocator, path: str) i64 {
    val l: res[Loaded, Fail] = file.load(a, path);
    if (sel l.err) {
        print.println("cannot load");
        ret 2;
    }
    var ld: Loaded         = l.ok;
    val f:  res[Fat, Fail] = read.read_fat(a, ?ld.input);
    if (sel f.err) {
        val m: res[MachO, Fail] = read.read(a, ?ld.input);
        if (sel m.err) {
            print.printlnf("read: {}", m.err.text);
            ret 1;
        }
        var thin: MachO = m.ok;
        report(?thin);
        ret 0;
    }
    var fm:   Fat   = f.ok;
    var i:    usize = 0;
    var code: i64   = 0;
    for (i < table.count[Slice](?fm.slices)) {
        val m: res[MachO, Fail] = read.read_slice(a, ?fm, table.nth[Slice](i), path);
        i = i + 1;
        if (sel m.err) {
            print.printlnf("read: {}", m.err.text);
            code = 1;
            cnt;
        }
        var slice: MachO = m.ok;
        report(?slice);
    }
    ret code;
}

fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    val kind: str = argv[1]::str;
    if (str_equals(kind, "read")) {
        if (argc < 3) {
            print.println("usage: linkedit read <file>");
            ret 2;
        }
        ret read_file(a, argv[2]::str);
    }
    val l: res[Loaded, Fail] = file.load(a, argv[2]::str);
    if (sel l.err) {
        print.println("cannot load");
        ret 2;
    }
    var ld:  Loaded = l.ok;
    var r:   Reader = reader.make(argv[2]::str, ld.input.data, ld.input.len, LITTLE);
    var s:   Sink   = sink.make(a, LITTLE);
    var ptr: u64    = 8;
    if (argc < 4) {
        print.println("usage: linkedit <kind> <blob> <pointer width> [segment prefix]");
        ret 2;
    }
    if (argv[3][0] == '4') { ptr = 4; }
    if (str_equals(kind, "rebase")) {
        val d: res[Table[Rebase], Fail] = opcode.decode_rebases(a, ?r, ptr);
        if (sel d.err) {
            print.printlnf("decode: {}", d.err.text);
            ret 1;
        }
        var t: Table[Rebase] = d.ok;
        print.printlnf("{} entries", table.count[Rebase](?t));
        val e: err[Fail] = opcode.encode_rebases(?s, a, ?t, ptr, ptr::usize);
        if (sel e.err) {
            print.printlnf("encode: {}", e.err.text);
            ret 1;
        }
    }
    or (str_equals(kind, "chained")) {
        val d: res[Chained, Fail] = fixups.decode(a, ?r);
        if (sel d.err) {
            print.printlnf("decode: {}", d.err.text);
            ret 1;
        }
        var c: Chained   = d.ok;
        val e: err[Fail] = fixups.encode(?s, a, ?c, Bytes{data: ?ld.input.data[c.symbols_offset::usize], len: ld.input.len - c.symbols_offset::usize});
        if (sel e.err) {
            print.printlnf("encode: {}", e.err.text);
            ret 1;
        }
        var i: usize = 0;
        for (i < table.count[SegmentInfo](?c.segments)) {
            val info: *SegmentInfo = table.at[SegmentInfo](?c.segments, table.nth[SegmentInfo](i));
            if (sel info.starts.some) {
                if (argc < 5) {
                    print.println("no segment prefix");
                    ret 2;
                }
                var path: [512]u8;
                var k:    usize = 0;
                for (argv[4][k] != 0) {
                    path[k] = argv[4][k];
                    k       = k + 1;
                }
                if (i >= 10) {
                    path[k] = '0' + (i / 10)::u8;
                    k       = k + 1;
                }
                path[k]     = '0' + (i % 10)::u8;
                path[k + 1] = 0;
                val sl: res[Loaded, Fail] = file.load(a, ?path[0]);
                if (sel sl.err) {
                    print.println("no segment file");
                    ret 2;
                }
                var seg:   Loaded      = sl.ok;
                var links: Table[Link] = table.make[Link](a);
                val w:     err[Fail]   = fixups.walk_segment(?info.starts.some, seg.input.data, seg.input.len, LITTLE, ?links);
                if (sel w.err) {
                    print.printlnf("walk: {}", w.err.text);
                    ret 1;
                }
                val pf: res[*PointerFormat, Fail] = model.pointer_format(info.starts.some.pointer_format);
                if (sel pf.err) {
                    print.println("format");
                    ret 1;
                }
                var bad: usize = 0;
                var j:   usize = 0;
                for (j < table.count[Link](?links)) {
                    val l:   *Link          = table.at[Link](?links, table.nth[Link](j));
                    val raw: res[u64, Fail] = fixups.encode_pointer(pf.ok, ?l.pointer);
                    j = j + 1;
                    if (sel raw.err) {
                        bad = bad + 1;
                        cnt;
                    }
                    if (raw.ok != l.raw) { bad = bad + 1; }
                }
                print.printlnf("segment {}: {} pointers, {} not reproduced", i, table.count[Link](?links), bad);
            }
            i = i + 1;
        }
    }
    or (str_equals(kind, "sig")) {
        val d: res[Signature, Fail] = signature.decode(a, ?r);
        if (sel d.err) {
            print.printlnf("decode: {}", d.err.text);
            ret 1;
        }
        var c:  Signature = d.ok;
        var st: Store     = store.make(a);
        val e:  err[Fail] = signature.encode(?s, a, ?st, ?c);
        if (sel e.err) {
            print.printlnf("encode: {}", e.err.text);
            ret 1;
        }
        print.printlnf("{} blobs, length {} of {}", c.count, c.length, ld.input.len);
        ret diff(ld.input.data, c.length::usize, sink.data(?s), sink.len(?s));
    }
    or (str_equals(kind, "unwind_info")) {
        val d: res[UnwindInfo, Fail] = unwind.decode(a, ?r);
        if (sel d.err) {
            print.printlnf("decode: {}", d.err.text);
            ret 1;
        }
        var c: UnwindInfo = d.ok;
        val e: err[Fail]  = unwind.encode(?s, a, ?c);
        if (sel e.err) {
            print.printlnf("encode: {}", e.err.text);
            ret 1;
        }
        print.printlnf("{} index {} pages {} lsdas", table.count[model.UnwindIndex](?c.index), table.count[model.UnwindPage](?c.pages), table.count[model.UnwindLsda](?c.lsdas));
    }
    or (str_equals(kind, "compact_unwind")) {
        val d: res[Table[Unwind], Fail] = unwind.decode_compact(a, ?r, ptr::usize);
        if (sel d.err) {
            print.printlnf("decode: {}", d.err.text);
            ret 1;
        }
        var c: Table[Unwind] = d.ok;
        val e: err[Fail]     = unwind.encode_compact(?s, ?c, ptr::usize);
        if (sel e.err) {
            print.printlnf("encode: {}", e.err.text);
            ret 1;
        }
        print.printlnf("{} records", table.count[Unwind](?c));
    }
    or (str_equals(kind, "starts")) {
        val d: res[Table[u64], Fail] = starts.decode_starts(a, ?r);
        if (sel d.err) {
            print.printlnf("decode: {}", d.err.text);
            ret 1;
        }
        var t: Table[u64] = d.ok;
        print.printlnf("{} entries", table.count[u64](?t));
        val e: err[Fail] = starts.encode_starts(?s, ?t, ptr::usize);
        if (sel e.err) {
            print.printlnf("encode: {}", e.err.text);
            ret 1;
        }
    }
    or (str_equals(kind, "dic")) {
        val d: res[Table[DataInCode], Fail] = starts.decode_data_in_code(a, ?r);
        if (sel d.err) {
            print.printlnf("decode: {}", d.err.text);
            ret 1;
        }
        var t: Table[DataInCode] = d.ok;
        val e: err[Fail]         = starts.encode_data_in_code(?s, ?t);
        if (sel e.err) {
            print.printlnf("encode: {}", e.err.text);
            ret 1;
        }
    }
    or (str_equals(kind, "export")) {
        var st: Store                    = store.make(a);
        val d:  res[Table[Export], Fail] = trie.decode(a, ?st, ?r);
        if (sel d.err) {
            print.printlnf("decode: {}", d.err.text);
            ret 1;
        }
        var t: Table[Export] = d.ok;
        print.printlnf("{} entries", table.count[Export](?t));
        val m: res[opt[model.Style], Fail] = trie.matching_style(a, ?st, ?t, Bytes{data: ld.input.data, len: ld.input.len}, ptr::usize);
        if (sel m.err) {
            print.println("matching failed");
            ret 1;
        }
        var st_style: model.Style = model.Style.ld64{};
        if (sel m.ok.none) { print.println("no style matches"); }
        if (sel m.ok.some) {
            st_style = m.ok.some;
            print.println("style matched");
        }
        val e: err[Fail] = trie.encode(?s, a, ?st, ?t, st_style, ptr::usize);
        if (sel e.err) {
            print.printlnf("encode: {}", e.err.text);
            ret 1;
        }
    }
    or (str_equals(kind, "bind") || str_equals(kind, "lazy") || str_equals(kind, "weak")) {
        var f: Flavor = Flavor.regular{};
        if (str_equals(kind, "lazy")) { f = Flavor.lazy{}; }
        if (str_equals(kind, "weak")) { f = Flavor.weak{}; }
        val d: res[Table[Bind], Fail] = opcode.decode_binds(a, ?r, f, ptr);
        if (sel d.err) {
            print.printlnf("decode: {}", d.err.text);
            ret 1;
        }
        var t: Table[Bind] = d.ok;
        print.printlnf("{} entries", table.count[Bind](?t));
        val e: err[Fail] = opcode.encode_binds(?s, a, ?t, Bytes{data: ld.input.data, len: ld.input.len}, f, ptr, ptr::usize);
        if (sel e.err) {
            print.printlnf("encode: {}", e.err.text);
            ret 1;
        }
    }
    or {
        print.println("unknown kind");
        ret 2;
    }
    ret diff(ld.input.data, ld.input.len, sink.data(?s), sink.len(?s));
}

pub fun main(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret 2; }
    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret 2; }
    ret run(?a, argc, argv);
}
