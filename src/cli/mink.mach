# mink, the linker of the mach toolchain

use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.args;
use std.args.help;

use A: std.allocator;
use std.allocator.heap;

use mink.base.fail.Fail;
use mink.cli.context;
use mink.cli.context.Run;
use mink.format.registry;
use mink.format.registry.Registry;

use mink.cli.cmds.dump;
use mink.cli.cmds.formats;
use mink.cli.cmds.link;
use mink.cli.cmds.sniff;

# the flag every command takes, asking for its page
val HELP_FLAG:  args.FlagSpec = args.FlagSpec{name: "--help", value: "", arity: args.ARITY_FLAG, doc: "show a command's page", default: "", negatable: false, occurs: args.Occurs.once{}, alias_of: nil};
val HELP_SHORT: args.FlagSpec = args.FlagSpec{name: "-h", value: "", arity: args.ARITY_FLAG, doc: "short for --help", default: "", negatable: false, occurs: args.Occurs.once{}, alias_of: ?HELP_FLAG};

val COMMON_ROW_COUNT: usize                            = 2;
val COMMON_ROWS:      [COMMON_ROW_COUNT]*args.FlagSpec = [COMMON_ROW_COUNT]*args.FlagSpec{?HELP_FLAG, ?HELP_SHORT};

# the tables every command takes
val COMMON_COUNT: usize                       = 1;
val COMMON:       [COMMON_COUNT]args.TableRef = [COMMON_COUNT]args.TableRef{
    args.TableRef{rows: ?COMMON_ROWS[0], n: COMMON_ROW_COUNT, accepted: nil, docs: nil},
};

# the help command, whose page is the overview and which names a command to
# show the page of
val HELP_COMMAND: args.CommandSpec = args.CommandSpec{
    name:            "help",
    id:              0,
    aliases:         nil,
    alias_n:         0,
    grammar:         " [command]",
    summary:         "show this page, or a command's",
    effect:          "show the overview, or the page of the command named",
    exits:           nil,
    exit_n:          0,
    terminator:      "",
    tables:          nil,
    table_n:         0,
    refused:         nil,
    refused_n:       0,
    refusal:         "",
    relations:       nil,
    relation_n:      0,
    constraints:     nil,
    constraint_n:    0,
    operand_min:     0,
    operand_max:     1,
    truncate_at_sep: false,
    actions:         nil,
    action_n:        0,
    examples:        nil,
    example_n:       0
};

# `--help` or `-h` in the command word's place asks the help command, so for
# the overview
val GLOBAL_COUNT: usize                     = 1;
val GLOBALS:      [GLOBAL_COUNT]args.Global = [GLOBAL_COUNT]args.Global{
    args.Global{row: ?HELP_FLAG, command: ?HELP_COMMAND},
};

# mink's commands, in the overview's order
val SPEC_COUNT: usize                         = 5;
val SPECS:      [SPEC_COUNT]*args.CommandSpec = [SPEC_COUNT]*args.CommandSpec{?dump.SPEC, ?sniff.SPEC, ?formats.SPEC, ?link.SPEC, ?HELP_COMMAND};

val SET: args.CommandSet = args.CommandSet{
    program:    "mink",
    title:      "mink, the linker of the mach toolchain",
    footer:     "see `mink help <command>` for a command's page",
    specs:      ?SPECS[0],
    n:          SPEC_COUNT,
    help:       ?HELP_COMMAND,
    help_flag:  ?HELP_FLAG,
    common:     ?COMMON[0],
    common_n:   COMMON_COUNT,
    relations:  nil,
    relation_n: 0,
    removed:    nil,
    removed_n:  0,
    exits:      ?context.EXITS[0],
    exit_n:     context.EXIT_COUNT,
    globals:    ?GLOBALS[0],
    global_n:   GLOBAL_COUNT
};

# a command and what runs it
# ---
# spec: its registration in the set
# run:  what it does
rec Verb {
    spec: *args.CommandSpec;
    run:  fun(*Run) i64;
}

val VERB_COUNT: usize            = 4;
val VERBS:      [VERB_COUNT]Verb = [VERB_COUNT]Verb{
    Verb{spec: ?dump.SPEC, run: dump.run},
    Verb{spec: ?sniff.SPEC, run: sniff.run},
    Verb{spec: ?formats.SPEC, run: formats.run},
    Verb{spec: ?link.SPEC, run: link.run},
};

# the verb that runs `spec`, none for the help command
fun verb_of(spec: *args.CommandSpec) opt[*Verb] {
    var i: usize = 0;
    for (i < VERB_COUNT) {
        if (VERBS[i].spec == spec) { ret opt[*Verb].some{?VERBS[i]}; }
        i = i + 1;
    }

    ret opt[*Verb].none{};
}

# the page `mink help` names: the overview, or the page of the command its
# operand names
fun help_page(r: *Run) i64 {
    val topic: opt[str] = context.operand(r, 0);
    if (sel topic.none) { ret context.page(r.a, ?SET, help.Page{command: nil, action: nil}); }

    val named: *args.CommandSpec = args.command_for(?SET, topic.some);
    if (named == nil) { ret context.usage(r.a, topic.some, "unknown command"); }

    ret context.page(r.a, ?SET, help.Page{command: named, action: nil});
}

# dispatch the command line to the right command entry
# ---
# a:    the allocator to allocate the run in
# argc: the number of arguments, including the program name
# argv: the arguments, including the program name
# ret:  the command's exit code, one of context's EXIT_ codes
fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    # create builtin format registry instance
    val reg: res[Registry, Fail] = registry.builtin(a);
    if (sel reg.err) { ret context.report(a, reg.err); }

    # read the whole command line against mink's commands
    var r: Run = Run{
        a:    a,
        reg:  reg.ok,
        line: args.parse(?SET, args.of(argc::usize, argv), 1)
    };

    if (sel r.line.refusal.some)      { ret context.refused(a, ?r.line); }
    if (r.line.command == nil)        { ret context.page(a, ?SET, help.Page{command: nil, action: nil}); }
    if (args.help_requested(?r.line)) { ret context.page(a, ?SET, help.page_of(?r.line)); }

    val v: opt[*Verb] = verb_of(r.line.command);
    if (sel v.none) { ret help_page(?r); }

    ret v.some.run(?r);
}

# primary entry point for the mink binary
# ---
# argc: the number of arguments, including the program name
# argv: the arguments, including the program name
pub fun dispatch(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;

    # whole-application heap allocator
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret context.EXIT_MEM_INIT; }

    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret context.EXIT_MEM_INIT; }

    # dispatch the command line to the right command entry
    val code: i64 = run(?a, argc, argv);

    val d: err[A.Error] = heap.dnit(?h);
    if (sel d.err) { ret context.EXIT_MEM_DNIT; }

    ret code;
}
