# mink, the linker of the mach toolchain

use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.args;
use std.collections.slice.Slice;

use A: std.allocator;
use std.allocator.heap;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.cli.context;
use mink.cli.context.Run;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.link.command;

use mink.cli.cmds.dump;
use mink.cli.cmds.formats;
use mink.cli.cmds.link;

# the flag the root lists asking for mink's version alone on one line
val VERSION: args.Flag = args.Flag{long: "version", short: 0, value: nil, repeat: false, negatable: false, help: "print the version"};

val HELP_FLAG_COUNT: usize                       = 1;
val HELP_FLAGS:      [HELP_FLAG_COUNT]*args.Flag = [HELP_FLAG_COUNT]*args.Flag{?command.HELP};

# `mink help [<command>]`, the overview or a command's page
val HELP_COMMAND: args.Command = args.Command{
    name:        "help",
    help:        "show help for a command",
    usage:       "[<command>]",
    flags:       Slice[*args.Flag]{data: ?HELP_FLAGS[0], size: HELP_FLAG_COUNT},
    operand_min: 0,
    operand_max: 1,
};

val ROOT_FLAG_COUNT: usize                       = 2;
val ROOT_FLAGS:      [ROOT_FLAG_COUNT]*args.Flag = [ROOT_FLAG_COUNT]*args.Flag{?command.HELP, ?VERSION};

# mink's commands, in the overview's order
val COMMAND_COUNT: usize                        = 4;
val COMMANDS:      [COMMAND_COUNT]*args.Command = [COMMAND_COUNT]*args.Command{?dump.COMMAND, ?formats.COMMAND, ?link.COMMAND, ?HELP_COMMAND};

val ROOT: args.Command = args.Command{
    name:        "mink",
    help:        "the linker of the mach toolchain",
    usage:       nil,
    flags:       Slice[*args.Flag]{data: ?ROOT_FLAGS[0], size: ROOT_FLAG_COUNT},
    commands:    Slice[*args.Command]{data: ?COMMANDS[0], size: COMMAND_COUNT},
    operand_min: 0,
    operand_max: 0,
};

# a command and what runs it
# ---
# command: the command
# run:     what it does
rec Verb {
    command: *args.Command;
    run:     fun(*Run) i64;
}

val VERB_COUNT: usize            = 3;
val VERBS:      [VERB_COUNT]Verb = [VERB_COUNT]Verb{
    Verb{command: ?dump.COMMAND, run: dump.run},
    Verb{command: ?formats.COMMAND, run: formats.run},
    Verb{command: ?link.COMMAND, run: link.run},
};

# the verb that runs `command`, none for one no verb runs
fun verb_of(command: *args.Command) opt[*Verb] {
    var i: usize = 0;
    for (i < VERB_COUNT) {
        if (VERBS[i].command == command) { ret opt[*Verb].some{?VERBS[i]}; }
        i = i + 1;
    }

    ret opt[*Verb].none{};
}

# the page `mink help` names: the overview, or the page of the command its
# operand names, read as that command's own line without its operands
fun help_page(a: *A.Allocator, line: *args.Parsed) i64 {
    val topic: opt[str] = args.operand(line, 0);
    if (sel topic.none) {
        var root: args.Parsed = args.parse(?ROOT, args.of(1, line.args.argv));
        ret context.page(a, ?root);
    }

    var words: [3]*u8      = [3]*u8{line.args.argv[0], topic.some::*u8, nil};
    var named: args.Parsed = args.parse(?ROOT, args.of(2, ?words[0]));
    if (sel named.refusal.some) {
        val why: args.Refusal = named.refusal.some;
        if (sel why.unknown_command) { ret context.refused(a, ?named); }
    }

    ret context.page(a, ?named);
}

# dispatch the command line to the right command entry: a refusal, a page or
# the version are answered here, and every other line runs its command
# ---
# a:    the allocator to allocate the run in
# argc: the number of arguments, including the program name
# argv: the arguments, including the program name
# ret:  the command's exit code, one of context's EXIT_ codes
fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    var line: args.Parsed = args.parse(?ROOT, args.of(argc::usize, argv));
    if (sel line.refusal.some)            { ret context.refused(a, ?line); }
    if (args.given(?line, ?command.HELP)) { ret context.page(a, ?line); }
    if (line.command == ?HELP_COMMAND)    { ret help_page(a, ?line); }
    if (line.command == ?ROOT) {
        if (args.given(?line, ?VERSION)) { ret context.say_line(a, $project.version); }
        val shown: i64 = context.page(a, ?line);
        if (shown != context.EXIT_OK) { ret shown; }
        ret context.EXIT_USER;
    }

    val v: opt[*Verb] = verb_of(line.command);
    if (sel v.none) { ret context.report(a, fail.internal("a command of mink has no verb")); }

    # create builtin format registry instance
    val reg: res[Registry, Fail] = registry.builtin(a);
    if (sel reg.err) { ret context.report(a, reg.err); }

    var r: Run = Run{a: a, reg: reg.ok, line: ?line};
    ret v.some.run(?r);
}

# primary entry point for the mink binary
# ---
# argc: the number of arguments, including the program name
# argv: the arguments, including the program name
pub fun dispatch(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;

    # whole-application heap allocator
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret context.EXIT_ENVIRONMENT; }

    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret context.EXIT_ENVIRONMENT; }

    # dispatch the command line to the right command entry
    val code: i64 = run(?a, argc, argv);

    val d: err[A.Error] = heap.dnit(?h);
    if (sel d.err) { ret context.EXIT_ENVIRONMENT; }

    ret code;
}
