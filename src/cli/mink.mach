# mink, the linker of the mach toolchain

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.args;

use A: std.allocator;
use std.allocator.heap;
use std.collections.vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.cli.context;
use mink.cli.context.Run;
use mink.format.registry;
use mink.format.registry.Registry;

use mink.cli.cmds.dump;
use mink.cli.cmds.formats;
use mink.cli.cmds.link;
use mink.cli.cmds.sniff;

# the flag every command takes
val FLAG_HELP: args.Flag = args.Flag{
    name:      "--help",
    short:     "-h",
    kind:      args.SWITCH,
    negatable: false,
    occurs:    args.Occurs.once{},
    value:     nil,
    doc:       "show a command's page"
};

# the help pages of every command
val HELP_OVERVIEW: str = "mink, the linker of the mach toolchain\n\nusage: mink <command> [operands] [options]\n\ncommands:\n  dump <file>                 print the model of an object file, field by field\n  sniff <file>                print the format of a file\n  formats                     list every format and what mink does with it\n  link <input>... [options]   link input files into one image, see `mink help link`. exit 4 when the link needs what mink does not build yet\n  help [command]              show this page, or a command's\n\noptions:\n  -h, --help                  show a command's page\n";

# a verb, a command word and what it does
# ---
# name:     its word
# page:     its help page
# operands: how many operands it takes
# run:      what it does
rec Verb {
    name:     str;
    page:     str;
    operands: usize;
    run:      fun(*Run) i64;
}

val VERB_COUNT: usize            = 3;
val VERBS:      [VERB_COUNT]Verb = [VERB_COUNT]Verb{
    Verb{name: "dump", page: dump.HELP, operands: 1, run: dump.run},
    Verb{name: "sniff", page: sniff.HELP, operands: 1, run: sniff.run},
    Verb{name: "formats", page: formats.HELP, operands: 0, run: formats.run},
};

# find the verb named `word`, or none when unknown
fun verb_named(word: str) opt[*Verb] {
    var i: usize = 0;
    for (i < VERB_COUNT) {
        if (str_equals(VERBS[i].name, word)) { ret opt[*Verb].some{?VERBS[i]}; }
        i = i + 1;
    }

    ret opt[*Verb].none{};
}

# print the refusal of the arguments on stderr
fun refusal(e: args.Error) Fail {
    if (sel e.unknown)       { ret fail.in_record(fail.malformed("unknown option"), e.unknown.flag); }
    or (sel e.missing_value) { ret fail.in_record(fail.malformed("needs a value"), e.missing_value.flag); }

    ret fail.in_record(fail.malformed("given more than once"), e.repeated.flag);
}

# read the arguments after the command word against `flags`, the operands
# into the run and --help answered
fun read(r: *Run, flags: **args.Flag, n: usize, help: *bool) err[Fail] {
    var settings: [1]args.Setting;
    var rd:       args.Reader = args.reader(r.args, 2, flags, n, ?settings[0]);

    for {
        val e: res[args.Event, args.Error] = args.read(?rd);
        if (sel e.err)     { ret err[Fail].err{refusal(e.err)}; }
        if (sel e.ok.done) { brk; }
        if (sel e.ok.operand) {
            val p: res[usize, A.Error] = vector.push[str](?r.operands, r.args.argv[e.ok.operand]::str);
            if (sel p.err) { ret err[Fail].err{fail.refused(p.err)}; }
        }
        or (sel e.ok.hit) {
            if (e.ok.hit.flag == ?FLAG_HELP) { @help = true; }
        }
    }

    ret err[Fail].ok{};
}

# dispatch the command line to the right command entry
# ---
# a:    the allocator to allocate the run in
# argc: the number of arguments, including the program name
# argv: the arguments, including the program name
# ret:  the command's exit code, one of context's EXIT_ codes
fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    # create builtin format registry instance
    val reg: res[Registry, Fail] = registry.builtin(a);
    if (sel reg.err) { ret context.report(a, reg.err); }

    var r: Run = Run{
        a:        a,
        reg:      reg.ok,
        args:     args.of(argc::usize, argv),
        operands: vector.init[str](a)
    };

    # dispatch the command word to the right command entry
    if (argc < 2) { ret context.say(a, HELP_OVERVIEW); }

    val word: str = argv[1]::str;

    # the `link` command is special, because it takes a variable number of
    # operands and mink does not build every link yet. so it is handled first,
    # and the rest of the commands are handled by the verb table
    if (str_equals(word, "link")) { ret link.run(?r); }

    # the rest of the commands are handled by the verb table, and they take a
    # fixed number of operands, and they all take --help
    var flags: [1]*args.Flag = [1]*args.Flag{?FLAG_HELP};
    var help:  bool          = false;

    # if the command word is `help`, then the next operand is the command to
    # show the page of, and it takes no operands
    if (str_equals(word, "help") || str_equals(word, "--help") || str_equals(word, "-h")) {
        # read the arguments after `help` against the flags
        val h: err[Fail] = read(?r, ?flags[0], 1, ?help);
        if (sel h.err) { ret context.report(a, h.err); }

        # if no command is given, show the overview page. if more than one
        # command is given, show a usage message
        if (vector.length[str](?r.operands) == 0) { ret context.say(a, HELP_OVERVIEW); }
        if (vector.length[str](?r.operands) > 1)  { ret context.usage(a, "help", "takes one command"); }

        # if the command is `link`, show the link page otherwise show usage
        val topic: str = context.operand(?r, 0);
        if (str_equals(topic, "link")) { ret link.page(a); }

        # if the command is known, show its page. if it is unknown, show usage
        val v: opt[*Verb] = verb_named(topic);
        if (sel v.none) { ret context.usage(a, topic, "unknown command"); }

        ret context.say(a, v.some.page);
    }

    val v: opt[*Verb] = verb_named(word);
    if (sel v.none) { ret context.usage(a, word, "unknown command"); }

    val got: err[Fail] = read(?r, ?flags[0], 1, ?help);
    if (sel got.err) { ret context.report(a, got.err); }

    if (help)                                               { ret context.say(a, v.some.page); }
    if (vector.length[str](?r.operands) != v.some.operands) { ret context.usage(a, word, "wrong number of operands, see `mink help`"); }

    ret v.some.run(?r);
}

# primary entry point for the mink binary
# ---
# argc: the number of arguments, including the program name
# argv: the arguments, including the program name
pub fun dispatch(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;

    # whole-application heap allocator
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret context.EXIT_MEM_INIT; }

    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret context.EXIT_MEM_INIT; }

    # dispatch the command line to the right command entry
    val code: i64 = run(?a, argc, argv);

    val d: err[A.Error] = heap.dnit(?h);
    if (sel d.err) { ret context.EXIT_MEM_DNIT; }

    ret code;
}
