# mink, the linker of the mach toolchain

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.args;

use A: std.allocator;
use std.allocator.heap;
use fs: std.filesystem;
use std.text.parse;

use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Arch;
use mink.catalog.arch.Stated;
use arch_list: mink.catalog.arch.list;
use mink.catalog.format;
use mink.catalog.kind;
use mink.catalog.kind.Kind;
use mink.catalog.output;
use mink.format.ar.fixture;
use mink.format.contract;
use mink.format.contract.Input;
use mink.format.contract.Member;
use mink.format.contract.Model;
use mink.format.contract.Reference;
use mink.format.file;
use mink.format.file.Loaded;
use mink.format.registration.Registration;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.link.command;
use mink.link.command.Command;
use mink.model.compare;
use mink.model.object;
use mink.model.object.Object;

val HELP:   args.Flag = args.Flag{name: "--help", short: "-h", kind: args.SWITCH, negatable: false, occurs: args.Occurs.once{}, value: nil, doc: "show a command's page"};
val OUTPUT: args.Flag = args.Flag{name: "--output", short: "-o", kind: args.VALUE, negatable: false, occurs: args.Occurs.once{}, value: "path", doc: "write the output here"};

val OVERVIEW: str = "mink, the linker of the mach toolchain\n\nusage: mink <command> [operands] [options]\n\ncommands:\n  dump <file>                 print the model of an object file, field by field\n  sniff <file>                print the format of a file\n  locate <file> <offset>      print the record of a file's model that holds a byte\n  formats                     list every format and whether mink is built with it\n  roundtrip <file> -o <path>  read a file and write its model back out\n  neutral <file> [-o <path>]  convert a file to the neutral object, back to its format and to the neutral object again, and compare\n  members <file> -o <dir>     write the files a container holds to a directory\n  reference <format>          print the reference flags a format's dump is compared with\n  link <input>... [options]   link input files into one image, see `mink help link`. exit 4 when the link needs what mink does not build yet\n  help [command]              show this page, or a command's\n\noptions:\n  -h, --help                  show a command's page\n";

val DUMP_PAGE:      str = "usage: mink dump <file>\n\nread a file as the format its magic names and print its model, one field per line\n";
val SNIFF_PAGE:     str = "usage: mink sniff <file>\n\nprint the name of the format a file's magic names\n";
val LOCATE_PAGE:    str = "usage: mink locate <file> <offset>\n\nread a file and print the record of its model that holds the byte at offset, as `record` or `record index`\nan offset no record holds prints nothing and fails\n";
val REFERENCE_PAGE: str = "usage: mink reference <format>\n\nprint the reference flags a format declares, one per line, for the readobj lane. a format with none prints nothing\n";
val FORMATS_PAGE:   str = "usage: mink formats\n\nprint every registered format as `name registered`, or `name unregistered` for one mink reads no files of\n";
val NEUTRAL_PAGE:   str = "usage: mink neutral <file> [-o <path>]\n\nread a file, convert it to the neutral object, build its format's file from that, read it and convert it again\nprint nothing and exit 0 when the two neutral objects are the same, print what differs and exit 1 when they are not\nexit 3 when the file is a container, whose members are files of their own\nexit 4 when the file is of a kind its format's neutral conversion does not take, printing `conversion`, or one whose stated machine code no architecture row encodes, printing `architecture`\n\noptions:\n  -o, --output <path>  write the file built from the neutral object here\n";
val ROUNDTRIP_PAGE: str = "usage: mink roundtrip <file> -o <path>\n\nread a file and write its model back to a path, byte for byte as the writer lays it out\n\noptions:\n  -o, --output <path>  write the file here\n";

val MEMBERS_PAGE: str = "usage: mink members <file> -o <dir>\n\nread a container and write each file it holds to the directory, named by its position: 0, 1, and so on\nprint `position name` for each, one per line\n\noptions:\n  -o, --output <dir>  write the files here, the directory must exist\n";

# a:        the allocator every command allocates in
# reg:      the formats
# args:     the process arguments
# operands: the operands after the command word, in order
# output:   the value of --output, nil when not given
rec Run {
    a:        *A.Allocator;
    reg:      Registry;
    args:     args.Args;
    operands: Table[str];
    output:   str;
}

# a command of the program
# ---
# name:     its word
# page:     its help page
# operands: how many operands it takes
# output:   how it takes --output
# run:      what it does
rec Verb {
    name:     str;
    page:     str;
    operands: usize;
    output:   Takes;
    run:      fun(*Run) i64;
}

# how a command takes --output
# ---
# none:     it takes none
# optional: it may be given one
# required: it needs one
tag Takes: u8 {
    none;
    optional;
    required;
}

# print the diagnostic of `f` on stderr
fun report(a: *A.Allocator, f: Fail) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val r: err[Fail] = diag.render(f, ?s);
    if (sel r.err) { ret 2; }
    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    if (sel e.err) { ret 2; }
    ret 1;
}

fun say(a: *A.Allocator, text: str) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val t: err[Fail] = sink.text(?s, text);
    if (sel t.err) { ret report(a, t.err); }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret report(a, e.err); }
    ret 0;
}

fun usage(a: *A.Allocator, bad: str, why: str) i64 {
    ret report(a, fail.in_record(fail.malformed(why), bad));
}

fun read_file(r: *Run, path: str, loaded: *Loaded, m: *Model) i64 {
    val l: res[Loaded, Fail] = file.load(r.a, path);
    if (sel l.err) { ret report(r.a, l.err); }
    @loaded = l.ok;
    val g: res[Model, Fail] = registry.read(?r.reg, r.a, ?loaded.input);
    if (sel g.err) { ret report(r.a, g.err); }
    @m = g.ok;
    ret 0;
}

fun cmd_dump(r: *Run) i64 {
    val path:   str = operand(r, 0);
    var loaded: Loaded;
    var m:      Model;
    val code:   i64 = read_file(r, path, ?loaded, ?m);
    if (code != 0) { ret code; }
    var s: Sink      = sink.make(r.a, LITTLE);
    val d: err[Fail] = contract.describe(?m, ?r.reg.relocs, ?s);
    if (sel d.err) { ret report(r.a, d.err); }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret report(r.a, e.err); }
    ret 0;
}

fun cmd_sniff(r: *Run) i64 {
    val path: str               = operand(r, 0);
    val l:    res[Loaded, Fail] = file.load(r.a, path);
    if (sel l.err) { ret report(r.a, l.err); }
    var loaded: Loaded                   = l.ok;
    val reg:    res[*Registration, Fail] = registry.sniff(?r.reg, ?loaded.input);
    if (sel reg.err) { ret report(r.a, reg.err); }
    var s: Sink      = sink.make(r.a, LITTLE);
    val t: err[Fail] = sink.text(?s, reg.ok.format.name);
    if (sel t.err) { ret report(r.a, t.err); }
    val n: err[Fail] = sink.text(?s, "\n");
    if (sel n.err) { ret report(r.a, n.err); }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret report(r.a, e.err); }
    ret 0;
}

fun cmd_locate(r: *Run) i64 {
    val path: str                        = operand(r, 0);
    val at:   str                        = operand(r, 1);
    val n:    res[u64, parse.ParseError] = parse.parse_u64_exact(at, 0);
    if (sel n.err) { ret usage(r.a, at, "is not an offset"); }
    var loaded: Loaded;
    var m:      Model;
    val code:   i64 = read_file(r, path, ?loaded, ?m);
    if (code != 0) { ret code; }
    val where: Location = contract.locate(?m, n.ok);
    if (where.record == nil) { ret report(r.a, fail.in_file(fail.at_offset(fail.malformed("no record of the model holds this offset"), n.ok), path)); }
    var s:  Sink      = sink.make(r.a, LITTLE);
    val wr: err[Fail] = diag.record(where, ?s);
    if (sel wr.err) { ret report(r.a, wr.err); }
    val wn: err[Fail] = sink.text(?s, "\n");
    if (sel wn.err) { ret report(r.a, wn.err); }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret report(r.a, e.err); }
    ret 0;
}

fun cmd_reference(r: *Run) i64 {
    val got: res[*Registration, Fail] = registry.by_name(?r.reg, operand(r, 0));
    if (sel got.err) { ret report(r.a, got.err); }
    var s:   Sink           = sink.make(r.a, LITTLE);
    val ref: opt[Reference] = got.ok.reference;
    if (sel ref.some) {
        val set: Reference = ref.some;
        var k:   usize     = 0;
        for (k < set.count) {
            val wf: err[Fail] = sink.text(?s, set.flags[k]);
            if (sel wf.err) { ret report(r.a, wf.err); }
            val wn: err[Fail] = sink.text(?s, "\n");
            if (sel wn.err) { ret report(r.a, wn.err); }
            k = k + 1;
        }
    }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret report(r.a, e.err); }
    ret 0;
}

fun cmd_formats(r: *Run) i64 {
    var s: Sink  = sink.make(r.a, LITTLE);
    var i: usize = 0;
    for (i < registry.count(?r.reg)) {
        val reg:  *Registration = registry.at(?r.reg, i);
        var tail: str           = " unregistered\n";
        if (sel reg.codec.some) { tail = " registered\n"; }
        val wn: err[Fail] = sink.text(?s, reg.format.name);
        if (sel wn.err) { ret report(r.a, wn.err); }
        val wt: err[Fail] = sink.text(?s, tail);
        if (sel wt.err) { ret report(r.a, wt.err); }
        i = i + 1;
    }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret report(r.a, e.err); }
    ret 0;
}

fun cmd_roundtrip(r: *Run) i64 {
    val path:   str = operand(r, 0);
    var loaded: Loaded;
    var m:      Model;
    val code:   i64 = read_file(r, path, ?loaded, ?m);
    if (code != 0) { ret code; }
    val w: res[Sink, Fail] = contract.write(?m);
    if (sel w.err) { ret report(r.a, w.err); }
    var s: Sink      = w.ok;
    val e: err[Fail] = file.save(r.output, ?s);
    if (sel e.err) { ret report(r.a, e.err); }
    ret 0;
}

# the codes of a container, which has no neutral form of its own, and of a
# file of a kind its format does not convert, apart from the one of a failure
val OUT_OF_SCOPE: i64 = 3;
val UNBUILT:      i64 = 4;

# exit UNBUILT, printing on stdout what is not built
fun unbuilt(r: *Run, what: str) i64 {
    val said: i64 = say(r.a, what);
    if (said != 0) { ret said; }
    ret UNBUILT;
}

fun cmd_neutral(r: *Run) i64 {
    val path:   str = operand(r, 0);
    var loaded: Loaded;
    var m:      Model;
    val code:   i64 = read_file(r, path, ?loaded, ?m);
    if (code != 0) { ret code; }
    ret neutral(r, path, ?m);
}

# the code `mink neutral` exits with for the model `m` read from `path`. a
# file of a kind its format does not convert, and one whose stated machine
# code no architecture row encodes, is not built, decided before converting
fun neutral(r: *Run, path: str, m: *Model) i64 {
    val k: res[*Kind, Fail] = contract.kind(m);
    if (sel k.err) {
        val shown: i64 = report(r.a, fail.in_file(k.err, path));
        if (sel k.err.cause.unsupported) { ret OUT_OF_SCOPE; }
        ret shown;
    }
    if (kind.has(k.ok, kind.CONTAINER)) {
        val shown: i64 = report(r.a, fail.about(fail.in_file(fail.unsupported("a container, whose members are files of their own"), path), k.ok.name));
        ret OUT_OF_SCOPE;
    }
    if (!contract.converts(m.reader, k.ok)) {
        val shown: i64 = report(r.a, fail.about(fail.in_record(fail.in_file(fail.unsupported("the format's neutral conversion of this kind is not built"), path), m.reader.format.name), k.ok.name));
        ret unbuilt(r, "conversion\n");
    }
    val st: opt[Stated] = contract.stated(m);
    if (sel st.none) {
        ret report(r.a, fail.about(fail.in_file(fail.internal("a file its format converts states no architecture"), path), m.reader.format.name));
    }
    var stated: Stated           = st.some;
    val row:    res[*Arch, Fail] = arch_list.by_code(?stated);
    if (sel row.err) {
        if (!sel row.err.cause.unsupported) { ret report(r.a, fail.in_file(row.err, path)); }
        val shown: i64 = report(r.a, fail.valued(fail.about(fail.in_file(fail.unsupported("no architecture row encodes the machine code the object states"), path), m.reader.format.name), stated.values[0]::i128));
        ret unbuilt(r, "architecture\n");
    }
    var first: Object    = object.make(r.a, nil, nil);
    val c1:    err[Fail] = contract.to_neutral(m, ?r.reg.relocs, ?first);
    if (sel c1.err) { ret report(r.a, fail.in_file(c1.err, path)); }
    val built: res[Model, Fail] = contract.from_neutral(m.reader, r.a, ?r.reg.relocs, ?first);
    if (sel built.err) { ret report(r.a, fail.in_file(built.err, path)); }
    var again: Model           = built.ok;
    val w:     res[Sink, Fail] = contract.write(?again);
    if (sel w.err) { ret report(r.a, fail.in_file(w.err, path)); }
    var bytes: Sink = w.ok;
    if (r.output != nil) {
        val saved: err[Fail] = file.save(r.output, ?bytes);
        if (sel saved.err) { ret report(r.a, saved.err); }
    }
    var in:   Input            = Input{file: path, data: sink.data(?bytes), len: sink.len(?bytes)};
    val back: res[Model, Fail] = registry.read(?r.reg, r.a, ?in);
    if (sel back.err) { ret report(r.a, fail.in_file(back.err, path)); }
    var second: Model     = back.ok;
    var next:   Object    = object.make(r.a, nil, nil);
    val c2:     err[Fail] = contract.to_neutral(?second, ?r.reg.relocs, ?next);
    if (sel c2.err) { ret report(r.a, fail.in_file(c2.err, path)); }
    val diff: res[str, Fail] = compare.difference(r.a, ?first, ?next);
    if (sel diff.err)   { ret report(r.a, fail.in_file(diff.err, path)); }
    if (diff.ok == nil) { ret 0; }
    ret report(r.a, fail.about(fail.in_file(fail.malformed("the neutral object changed in a round trip"), path), diff.ok));
}

fun cmd_members(r: *Run) i64 {
    val path:   str = operand(r, 0);
    val dir:    str = r.output;
    var loaded: Loaded;
    var m:      Model;
    val code:   i64 = read_file(r, path, ?loaded, ?m);
    if (code != 0) { ret code; }
    var found: Table[Member] = table.make[Member](r.a);
    val g:     err[Fail]     = contract.members(?m, path, ?found);
    if (sel g.err) { ret report(r.a, g.err); }
    var list: Sink  = sink.make(r.a, LITTLE);
    var i:    usize = 0;
    for (i < table.count[Member](?found)) {
        val mem: *Member   = table.at[Member](?found, table.nth[Member](i));
        var to:  Sink      = sink.make(r.a, LITTLE);
        val w1:  err[Fail] = sink.text(?to, dir);
        if (sel w1.err) { ret report(r.a, w1.err); }
        val w2: err[Fail] = sink.text(?to, "/");
        if (sel w2.err) { ret report(r.a, w2.err); }
        val w3: err[Fail] = sink.number(?to, i::u64, 10);
        if (sel w3.err) { ret report(r.a, w3.err); }
        val w4: err[Fail] = sink.u8(?to, 0);
        if (sel w4.err) { ret report(r.a, w4.err); }
        var body: Sink      = sink.make(r.a, LITTLE);
        val w5:   err[Fail] = sink.bytes(?body, mem.input.data, mem.input.len);
        if (sel w5.err) { ret report(r.a, w5.err); }
        val w6: err[Fail] = file.save(sink.data(?to)::str, ?body);
        if (sel w6.err) { ret report(r.a, w6.err); }
        val l1: err[Fail] = sink.number(?list, i::u64, 10);
        if (sel l1.err) { ret report(r.a, l1.err); }
        val l2: err[Fail] = sink.text(?list, " ");
        if (sel l2.err) { ret report(r.a, l2.err); }
        val l3: err[Fail] = sink.bytes(?list, mem.name.data, mem.name.len);
        if (sel l3.err) { ret report(r.a, l3.err); }
        val l4: err[Fail] = sink.text(?list, "\n");
        if (sel l4.err) { ret report(r.a, l4.err); }
        i = i + 1;
    }
    val e: err[Fail] = file.emit(fs.STDOUT, ?list);
    if (sel e.err) { ret report(r.a, e.err); }
    ret 0;
}

# link the input files the command line names into the image it names. a
# link refused for what mink does not build yet exits UNBUILT. a refusal is
# printed before the notes that explain it, as lld prints them
fun cmd_link(r: *Run) i64 {
    var c: Command;
    val p: err[Fail] = command.parse(?c, r.a, ?r.reg, r.args, 2);
    if (sel p.err) {
        val dropped: err[Fail] = command.release(?c);
        ret report(r.a, p.err);
    }
    if (c.help) {
        val dropped: err[Fail] = command.release(?c);
        ret page_of_link(r.a);
    }
    var notes: Sink            = sink.make(r.a, LITTLE);
    var out:   res[Sink, Fail] = command.link(?c, nil, 0, ?notes);
    if (sel out.err) {
        var code:  i64       = report(r.a, out.err);
        val shown: err[Fail] = file.emit(fs.STDERR, ?notes);
        if (sel shown.err)                 { code = report(r.a, shown.err); }
        if (sel out.err.cause.unsupported) { ret UNBUILT; }
        ret code;
    }
    val shown: err[Fail] = file.emit(fs.STDERR, ?notes);
    if (sel shown.err) { ret report(r.a, shown.err); }
    var mode: i32 = file.MODE;
    if (output.has(c.options.kind, output.ENTERED) || output.has(c.options.kind, output.LOADED)) { mode = file.RUNNABLE; }
    val sv: err[Fail] = file.save_mode(c.options.output, ?out.ok, mode);
    if (sel sv.err) { ret report(r.a, sv.err); }
    ret 0;
}

fun page_of_link(a: *A.Allocator) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val h: err[Fail] = command.help(?s);
    if (sel h.err) { ret report(a, h.err); }
    val e: err[Fail] = file.emit(fs.STDOUT, ?s);
    if (sel e.err) { ret report(a, e.err); }
    ret 0;
}

val VERB_COUNT: usize            = 8;
val VERBS:      [VERB_COUNT]Verb = [VERB_COUNT]Verb{
    Verb{name: "dump", page: DUMP_PAGE, operands: 1, output: Takes.none{}, run: cmd_dump},
    Verb{name: "sniff", page: SNIFF_PAGE, operands: 1, output: Takes.none{}, run: cmd_sniff},
    Verb{name: "locate", page: LOCATE_PAGE, operands: 2, output: Takes.none{}, run: cmd_locate},
    Verb{name: "formats", page: FORMATS_PAGE, operands: 0, output: Takes.none{}, run: cmd_formats},
    Verb{name: "roundtrip", page: ROUNDTRIP_PAGE, operands: 1, output: Takes.required{}, run: cmd_roundtrip},
    Verb{name: "neutral", page: NEUTRAL_PAGE, operands: 1, output: Takes.optional{}, run: cmd_neutral},
    Verb{name: "members", page: MEMBERS_PAGE, operands: 1, output: Takes.required{}, run: cmd_members},
    Verb{name: "reference", page: REFERENCE_PAGE, operands: 1, output: Takes.none{}, run: cmd_reference},
};

# the operand at `i`, which the verb's count makes present
fun operand(r: *Run, i: usize) str {
    ret @table.at[str](?r.operands, table.nth[str](i));
}

fun verb_named(word: str) opt[*Verb] {
    var i: usize = 0;
    for (i < VERB_COUNT) {
        if (str_equals(VERBS[i].name, word)) { ret opt[*Verb].some{?VERBS[i]}; }
        i = i + 1;
    }
    ret opt[*Verb].none{};
}

fun refusal(e: args.Error) Fail {
    if (sel e.unknown)       { ret fail.in_record(fail.malformed("unknown option"), e.unknown.flag); }
    or (sel e.missing_value) { ret fail.in_record(fail.malformed("needs a value"), e.missing_value.flag); }
    ret fail.in_record(fail.malformed("given more than once"), e.repeated.flag);
}

# read the arguments after the command word against `flags`, the operands
# into the run, the value of --output kept and --help answered
fun read(r: *Run, flags: **args.Flag, n: usize, help: *bool) err[Fail] {
    var settings: [2]args.Setting;
    var rd:       args.Reader = args.reader(r.args, 2, flags, n, ?settings[0]);
    for {
        val e: res[args.Event, args.Error] = args.read(?rd);
        if (sel e.err)     { ret err[Fail].err{refusal(e.err)}; }
        if (sel e.ok.done) { brk; }
        if (sel e.ok.operand) {
            val p: res[table.Id[str], Fail] = table.push[str](?r.operands, r.args.argv[e.ok.operand]::str);
            if (sel p.err) { ret err[Fail].err{p.err}; }
        }
        or (sel e.ok.hit) {
            if (e.ok.hit.flag == ?HELP) { @help = true; }
            or                          { r.output = e.ok.hit.value; }
        }
    }
    ret err[Fail].ok{};
}

fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    val reg: res[Registry, Fail] = registry.builtin(a);
    if (sel reg.err) { ret report(a, reg.err); }
    var r: Run = Run{a: a, reg: reg.ok, args: args.of(argc::usize, argv), operands: table.make[str](a)};
    if (argc < 2) { ret say(a, OVERVIEW); }
    val word: str = argv[1]::str;
    if (str_equals(word, "link")) { ret cmd_link(?r); }
    var flags: [2]*args.Flag = [2]*args.Flag{?HELP, ?OUTPUT};
    var help:  bool          = false;
    if (str_equals(word, "help") || str_equals(word, "--help") || str_equals(word, "-h")) {
        val h: err[Fail] = read(?r, ?flags[0], 1, ?help);
        if (sel h.err)                          { ret report(a, h.err); }
        if (table.count[str](?r.operands) == 0) { ret say(a, OVERVIEW); }
        if (table.count[str](?r.operands) > 1)  { ret usage(a, "help", "takes one command"); }
        val topic: str = operand(?r, 0);
        if (str_equals(topic, "link")) { ret page_of_link(a); }
        val v: opt[*Verb] = verb_named(topic);
        if (sel v.none) { ret usage(a, topic, "unknown command"); }
        ret say(a, v.some.page);
    }
    val v: opt[*Verb] = verb_named(word);
    if (sel v.none) { ret usage(a, word, "unknown command"); }
    var n: usize = 1;
    if (!sel v.some.output.none) { n = 2; }
    val got: err[Fail] = read(?r, ?flags[0], n, ?help);
    if (sel got.err)                                      { ret report(a, got.err); }
    if (help)                                             { ret say(a, v.some.page); }
    if (table.count[str](?r.operands) != v.some.operands) { ret usage(a, word, "wrong number of operands, see `mink help`"); }
    if (sel v.some.output.required && r.output == nil)    { ret usage(a, word, "needs --output"); }
    ret v.some.run(?r);
}

# every allocation lives in the heap, which is given back whole when the command ends
pub fun main(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret 2; }
    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret 2; }
    val code: i64          = run(?a, argc, argv);
    val d:    err[A.Error] = heap.dnit(?h);
    if (sel d.err) { ret 2; }
    ret code;
}

# the code `mink neutral` exits with for the one member of a static library
# holding a COFF object of `machine` with nothing in it
#[testing]
fun neutral_member(machine: u16) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret 100; }
    val made: err[A.Error] = heap.make(?a, ?h);
    if (sel made.err) { ret 100; }
    val code: i64          = neutral_member_in(?a, machine);
    val d:    err[A.Error] = heap.dnit(?h);
    if (sel d.err) { ret 100; }
    ret code;
}

#[testing]
fun neutral_member_in(a: *A.Allocator, machine: u16) i64 {
    var obj: [20]u8;
    obj[0] = (machine & 0xff)::u8;
    obj[1] = (machine >> 8)::u8;
    var lib: Sink      = sink.make(a, LITTLE);
    val b:   err[Fail] = fixture.begin(?lib, false);
    if (sel b.err) { ret 101; }
    val w: err[Fail] = fixture.member(?lib, "a.obj/", 20, ?obj[0], 20);
    if (sel w.err) { ret 101; }
    val reg: res[Registry, Fail] = registry.builtin(a);
    if (sel reg.err) { ret 102; }
    var r:       Run              = Run{a: a, reg: reg.ok, operands: table.make[str](a)};
    var in:      Input            = Input{file: "lib.a", data: sink.data(?lib), len: sink.len(?lib)};
    val archive: res[Model, Fail] = registry.read(?r.reg, a, ?in);
    if (sel archive.err) { ret 103; }
    var lm:      Model         = archive.ok;
    var members: Table[Member] = table.make[Member](a);
    val listed:  err[Fail]     = contract.members(?lm, "lib.a", ?members);
    if (sel listed.err)                     { ret 104; }
    if (table.count[Member](?members) != 1) { ret 104; }
    val mb:  *Member          = table.at[Member](?members, table.nth[Member](0));
    val got: res[Model, Fail] = registry.read(?r.reg, a, ?mb.input);
    if (sel got.err) { ret 105; }
    var m: Model = got.ok;
    ret neutral(?r, "lib.a(a.obj)", ?m);
}

test mink__an_armnt_coff_member_is_not_built {
    if (neutral_member(0x1c4) != UNBUILT) { ret 1; }
    ret 0;
}

test mink__an_x86_64_coff_member_converts {
    if (neutral_member(0x8664) != 0) { ret 1; }
    ret 0;
}
