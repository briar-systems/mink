# how every line mink prints for a person is laid out: a result, a log line
# and a fact beneath one, and the one written form of a duration, a size, a
# count and a path, the forms mach's readout writes
#
# a result is a verb from one closed table and what it acted on, on one line,
# then its fields beneath it, one a line, indented INDENT, each key padded to
# the widest key shown and GAP before its value. a field with nothing to say
# is left out, so a count of zero is never printed.
#
# a log line is a stamp, the seconds since the command began to a hundredth
# in brackets, then a label in LABEL_W columns and a time right-aligned in
# TIME_W, and what follows them is the caller's. an item a stage processed is
# indented two inside the label's column. a fact is indented to where a log
# line's text starts, FACT_LEAD, its key in FACT_KEY_W columns and then its
# value.
#
# a number is rounded to the nearest of its last digit, and shows a tenth
# while it is under ten of its unit: a size is exact bytes below a KiB, then
# KiB, MiB or GiB (`1.5 KiB`, `51 KiB`); a duration is microseconds below a
# millisecond, milliseconds below a second (`1.5ms`, `468ms`), seconds to a
# tenth below a minute (`18.5s`), then minutes and whole seconds. a count of
# one takes the singular noun. a path drops its leading `./`.

use std.types.bool.bool;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use chrono_duration: std.chrono.duration;
use std.chrono.duration.Duration;
use std_format: std.format;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

# the room one written number, duration or size takes, its terminator
# included
pub val TEXT_CAP: usize = 48;

# storage one written value lives in while its line is written
pub rec Text {
    bytes: [TEXT_CAP]u8;
}

# a count in decimal
pub fun count(t: *Text, n: u64) str {
    ret finish(t, put_u64(t, 0, n));
}

# a count as a field's value: nil for none, which leaves the field out
pub fun nonzero(t: *Text, n: u64) str {
    if (n == 0) { ret nil; }
    ret count(t, n);
}

# a measured duration, rounded to the nearest of its last digit: a tenth below
# ten of microseconds or milliseconds and whole above, seconds to a tenth
# below a minute, then minutes and whole seconds. zero is `0us`
pub fun duration(t: *Text, d: Duration) str {
    if (d <= 0) { ret finish(t, put(t, 0, "0us")); }
    val n:  u64 = d::u64;
    val us: u64 = chrono_duration.MICROSECOND::u64;
    val ms: u64 = chrono_duration.MILLISECOND::u64;
    val s:  u64 = chrono_duration.SECOND::u64;
    if (tenths(n, us) < 100) { ret finish(t, put(t, put_tenths(t, tenths(n, us)), "us")); }
    if (whole(n, us) < 1000) { ret finish(t, put(t, put_u64(t, 0, whole(n, us)), "us")); }
    if (tenths(n, ms) < 100) { ret finish(t, put(t, put_tenths(t, tenths(n, ms)), "ms")); }
    if (whole(n, ms) < 1000) { ret finish(t, put(t, put_u64(t, 0, whole(n, ms)), "ms")); }
    if (tenths(n, s) < 600)  { ret finish(t, put(t, put_tenths(t, tenths(n, s)), "s")); }
    val all: u64   = whole(n, s);
    var l:   usize = put_u64(t, 0, all / 60);
    l = put(t, l, "m");
    l = put_u64(t, l, all % 60);
    ret finish(t, put(t, l, "s"));
}

# a size in bytes: exact below a KiB, then the largest binary unit it holds
# one of, rounded to the nearest tenth below ten of the unit and to the
# nearest whole above
pub fun size(t: *Text, bytes: u64) str {
    val ki: u64 = 1024;
    if (bytes < ki) { ret finish(t, put(t, put_u64(t, 0, bytes), " B")); }
    val units: [3]str = [3]str{" KiB", " MiB", " GiB"};
    var per:   u64    = ki;
    var k:     usize  = 0;
    for (k < 2 && whole(bytes, per) >= ki) {
        per = per * ki;
        k   = k + 1;
    }
    if (tenths(bytes, per) < 100) { ret finish(t, put(t, put_tenths(t, tenths(bytes, per)), units[k])); }
    ret finish(t, put(t, put_u64(t, 0, whole(bytes, per)), units[k]));
}

# the noun a count takes
pub fun noun(n: u64, one: str, many: str) str {
    if (n == 1) { ret one; }
    ret many;
}

# a path as a line shows it, without a leading `./`
pub fun path(p: str) str {
    if (str_starts_with(p, "./")) { ret (p::usize + 2)::str; }
    ret p;
}

# the last component of the path `p`, borrowed from it, as a result names
# the file it wrote
pub fun last(p: str) str {
    var start: usize = str_len(p);
    for (start > 0 && p[start - 1] != '/') {
        start = start - 1;
    }
    ret (p::usize + start)::str;
}

# n in tenths of `per`, rounded to nearest
fun tenths(n: u64, per: u64) u64 {
    ret (n * 10 + per / 2) / per;
}

# n in wholes of `per`, rounded to nearest
fun whole(n: u64, per: u64) u64 {
    ret (n + per / 2) / per;
}

# tenths written as `<whole>.<tenth>` at the start of t
fun put_tenths(t: *Text, n: u64) usize {
    var l: usize = put_u64(t, 0, n / 10);
    l = put(t, l, ".");
    ret put_u64(t, l, n % 10);
}

fun put_u64(t: *Text, at: usize, n: u64) usize {
    ret at + std_format.put_u64(?t.bytes[at], n);
}

fun put(t: *Text, at: usize, s: str) usize {
    var l: usize = at;
    var i: usize = 0;
    for (s[i] != 0) {
        t.bytes[l] = s[i];
        l          = l + 1;
        i          = i + 1;
    }
    ret l;
}

fun finish(t: *Text, l: usize) str {
    t.bytes[l] = 0;
    ret (?t.bytes[0])::str;
}

# what a result says was done, the word that opens it
pub def Verb: u8;

pub val LINKED: Verb = 0;
pub val FAILED: Verb = 1;

val VERB_COUNT: usize = 2;

val VERBS: [VERB_COUNT]str = [VERB_COUNT]str{"linked", "failed"};

# one line of a result's block: what the value is, then the value
# ---
# key:   the field's name, as `time`
# value: what the result has for it, nil or empty for nothing, which leaves
#        the field out
pub rec Field {
    key:   str;
    value: str;
}

# the spaces a result's fields are indented by
pub val INDENT: usize = 2;

# the spaces between a field's padded key and its value
pub val GAP: usize = 2;

# append a result to `out`: its verb and what it acted on on one line, then
# each of the `n` fields at `fields` that has a value on a line of its own,
# indented INDENT, its key padded to the widest key shown and GAP before its
# value
pub fun result(out: *Sink, v: Verb, subject: str, fields: *Field, n: usize) err[Fail] {
    var err_text: err[Fail] = sink.text(out, VERBS[v]);
    err_text = fail.kept(err_text, sink.text(out, " "));
    err_text = fail.kept(err_text, sink.text(out, subject));
    err_text = fail.kept(err_text, sink.text(out, "\n"));
    var width: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (shown(?fields[i]) && str_len(fields[i].key) > width) { width = str_len(fields[i].key); }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        val f: *Field = ?fields[i];
        i = i + 1;
        if (!shown(f)) { cnt; }
        err_text = fail.kept(err_text, sink.fill(out, ' ', INDENT));
        err_text = fail.kept(err_text, sink.text(out, f.key));
        err_text = fail.kept(err_text, sink.fill(out, ' ', width - str_len(f.key) + GAP));
        err_text = fail.kept(err_text, sink.text(out, f.value));
        err_text = fail.kept(err_text, sink.text(out, "\n"));
    }
    ret err_text;
}

fun shown(f: *Field) bool {
    ret f.value != nil && f.value[0] != 0;
}

# a log line's label column, its time column, the stamp's digits, and the
# lead and key column of a fact beneath a log line
pub val LABEL_W:    usize = 11;
pub val TIME_W:     usize = 6;
pub val STAMP_W:    usize = 6;
pub val FACT_LEAD:  usize = 28;
pub val FACT_KEY_W: usize = 12;

# append a log line's lead to `out`: the stamp of `since`, the time since the
# command began, then `label`, indented two for an item a stage processed,
# in its column, then `time` right-aligned in its column. what follows on
# the line is the caller's
pub fun lead(out: *Sink, since: Duration, item: bool, label: str, time: str) err[Fail] {
    var err_text: err[Fail] = stamp(out, since);
    var used:     usize     = str_len(label);
    if (item) {
        err_text = fail.kept(err_text, sink.fill(out, ' ', 2));
        used     = used + 2;
    }
    err_text = fail.kept(err_text, sink.text(out, label));
    if (used < LABEL_W) { err_text = fail.kept(err_text, sink.fill(out, ' ', LABEL_W - used)); }
    ret fail.kept(err_text, right(out, time, TIME_W));
}

# `[  0.07] `: a duration in seconds to two places, right-aligned in its
# brackets
fun stamp(out: *Sink, d: Duration) err[Fail] {
    var cs: u64 = 0;
    if (d > 0) { cs = (d::u64 + 5000000) / 10000000; }
    var t: Text;
    var l: usize = put_u64(?t, 0, cs / 100);
    l = put(?t, l, ".");
    if (cs % 100 < 10) { l = put(?t, l, "0"); }
    l = put_u64(?t, l, cs % 100);
    var err_text: err[Fail] = sink.text(out, "[");
    err_text = fail.kept(err_text, right(out, finish(?t, l), STAMP_W));
    ret fail.kept(err_text, sink.text(out, "] "));
}

# append `s` right-aligned in `width`
fun right(out: *Sink, s: str, width: usize) err[Fail] {
    val l:        usize     = str_len(s);
    var err_text: err[Fail] = err[Fail].ok{};
    if (l < width) { err_text = sink.fill(out, ' ', width - l); }
    ret fail.kept(err_text, sink.text(out, s));
}

# append a fact beneath a log line to `out`: its key in a column, then its
# value
pub fun fact(out: *Sink, key: str, value: str) err[Fail] {
    var err_text: err[Fail] = sink.fill(out, ' ', FACT_LEAD);
    err_text = fail.kept(err_text, sink.text(out, key));
    val l: usize = str_len(key);
    if (l < FACT_KEY_W) { err_text = fail.kept(err_text, sink.fill(out, ' ', FACT_KEY_W - l)); }
    err_text = fail.kept(err_text, sink.text(out, value));
    ret fail.kept(err_text, sink.text(out, "\n"));
}
