use mink.link.plan;
use mink.link.search;
use mink.link.state;
use mink.link.write;
use mink.link.write.Written;

# a link as its command line states it
# ---
# a:         the allocator its tables live in
# registry:  the formats the link reads and writes
# options:   the link's options
# inputs:    the input files, libraries and frameworks, in the order they
#            are named
# keep:      the names kept, which options.keep points into
# sections:  the sections placed ahead of the rest, which options.sections
#            points into
# regions:   the memory regions stated, which options.regions points into
# runs:      the sections stated to run in a region, by the region's name
# loads:     the sections stated to load in a region, by the region's name
# ran:       the runs with their regions resolved, which options.runs
#            points into
# loaded:    the loads with their regions resolved, which options.loads
#            points into
# offsets:   the sections stated at an offset, which options.offsets points
#            into
# pieces:    the fields copied out of values, each a zero after it, which
#            the statements point into
# plan:      the layout file read, whose text the values it stated point into
# line:      the command line read, while parse reads it
# stated:    how many layout lines stated each row
# target:    the target's spelling, resolved under the narrowing once every
#            flag is read
# narrowing: what the narrowing flags state, its extensions pointing into ext
# ext:       the extensions stated, in the order named
# include:   how a library named from here on is included, as the as-needed
#            switch last stated
# prefer:    which files a library named from here on is searched for, as
#            the library kind last stated
# libdirs:   the library directories stated, which options.libdirs
#            points into
# fwdirs:    the framework directories stated, which options.fwdirs
#            points into
# found:     what the link's search makes, which its sources point into
# interface: the path the interface file of a library is written to, nil
#            where the command line states none
# kind:      what `--kind` spells, none while the command line names none
rec Command {
    a:         *A.Allocator;
    registry:  *Registry;
    options:   Options;
    inputs:    Vector[Request];
    keep:      Vector[str];
    sections:  Vector[str];
    regions:   Vector[Area];
    runs:      Vector[Named];
    loads:     Vector[Named];
    ran:       Vector[Within];
    loaded:    Vector[Within];
    offsets:   Vector[Offset];
    pieces:    Vector[str];
    plan:      plan.Plan;
    line:      *args.Parsed;
    stated:    [ROW_COUNT]usize;
    target:    str;
    narrowing: target.Narrowing;
    ext:       Vector[str];
    include:   Include;
    prefer:    Prefer;
    libdirs:   Vector[str];
    fwdirs:    Vector[str];
    found:     search.Found;
    interface: str;
    kind:      opt[Spelled];
}

# an output section stated to lie in the region of a name
rec Named {
    section: str;
    region:  str;
}

# one flag and the field it writes
# ---
# flag:      the flag as std.args reads it
# placement: the row states where the image's bytes go, and is a key of a
#            layout file, spelled as its long name without the dashes
# option:    the option of the link the row writes, which a refusal of it
#            names, NO_OPTION for a row that writes none
# set:       write the flag's value, nil for a switch, into the command, with
#            whether a switch was given rather than negated
rec Row {
    flag:      args.Flag;
    placement: bool;
    option:    fail.Option;
    set:       fun(*Command, str, bool) err[Fail];
}

val OUTPUT:        Row = Row{flag: args.Flag{long: "output", short: 'o', value: "path", repeat: false, negatable: false, help: "write the image here"}, placement: false, option: link_options.OUTPUT, set: set_output};
val INTERFACE:     Row = Row{flag: args.Flag{long: "interface", short: 0, value: "path", repeat: false, negatable: false, help: "write the import library here"}, placement: false, option: fail.NO_OPTION, set: set_interface};
val KIND:          Row = Row{flag: args.Flag{long: "kind", short: 'k', value: "bin|static|shared|object|module", repeat: false, negatable: false, help: "what the link makes"}, placement: false, option: link_options.KIND, set: set_kind};
val LINKAGE:       Row = Row{flag: args.Flag{long: "linkage", short: 0, value: "pie|dynamic|static", repeat: false, negatable: false, help: "how an executable links (default: the target's)"}, placement: false, option: fail.NO_OPTION, set: set_linkage};
val TARGET:        Row = Row{flag: args.Flag{long: "target", short: 't', value: "sys-arch", repeat: false, negatable: false, help: "the target, as `mach info targets` spells it"}, placement: false, option: link_options.TARGET, set: set_target};
val ENV:           Row = Row{flag: args.Flag{long: "env", short: 0, value: "name", repeat: false, negatable: false, help: "the environment (default: the target's)"}, placement: false, option: fail.NO_OPTION, set: set_env};
val ABI:           Row = Row{flag: args.Flag{long: "abi", short: 0, value: "name", repeat: false, negatable: false, help: "the calling convention (default: the target's)"}, placement: false, option: fail.NO_OPTION, set: set_abi};
val ISA:           Row = Row{flag: args.Flag{long: "isa", short: 0, value: "selection", repeat: false, negatable: false, help: "the instruction set (default: the target's)"}, placement: false, option: fail.NO_OPTION, set: set_isa};
val EXT:           Row = Row{flag: args.Flag{long: "ext", short: 0, value: "name", repeat: true, negatable: false, help: "add an instruction set extension, once each"}, placement: false, option: fail.NO_OPTION, set: set_ext};
val CODE_MODEL:    Row = Row{flag: args.Flag{long: "code-model", short: 0, value: "name", repeat: false, negatable: false, help: "the code model (default: the target's)"}, placement: false, option: fail.NO_OPTION, set: set_code_model};
val FORMAT:        Row = Row{flag: args.Flag{long: "format", short: 0, value: "format", repeat: false, negatable: false, help: "the output format (default: the target's)"}, placement: false, option: fail.NO_OPTION, set: set_format};
val SYS_VERSION:   Row = Row{flag: args.Flag{long: "sys-version", short: 0, value: "x.y[.z]", repeat: false, negatable: false, help: "the oldest system version the image runs on"}, placement: false, option: link_options.VERSION, set: set_sys_version};
val SDK_VERSION:   Row = Row{flag: args.Flag{long: "sdk-version", short: 0, value: "x.y[.z]", repeat: false, negatable: false, help: "the SDK version the image builds against"}, placement: false, option: link_options.SDK, set: set_sdk_version};
val SUBSYSTEM:     Row = Row{flag: args.Flag{long: "subsystem", short: 0, value: "subsystem", repeat: false, negatable: false, help: "the PE subsystem (default: the target's)"}, placement: false, option: link_options.SUBSYSTEM, set: set_subsystem};
val ENTRY:         Row = Row{flag: args.Flag{long: "entry", short: 0, value: "symbol", repeat: false, negatable: false, help: "the entry symbol (default: the target's)"}, placement: false, option: link_options.ENTRY, set: set_entry};
val KEEP:          Row = Row{flag: args.Flag{long: "keep", short: 0, value: "symbol", repeat: true, negatable: false, help: "keep this symbol even when unreferenced"}, placement: false, option: link_options.KEEP, set: set_keep};
val GC_SECTIONS:   Row = Row{flag: args.Flag{long: "gc-sections", short: 0, value: nil, repeat: true, negatable: true, help: "drop sections nothing reaches (default: the target's)"}, placement: false, option: link_options.GC_SECTIONS, set: set_gc_sections};
val TEMPORARIES:   Row = Row{flag: args.Flag{long: "temporaries", short: 0, value: nil, repeat: false, negatable: true, help: "keep the assemblers' local labels (default: the target's)"}, placement: false, option: link_options.KEEP_TEMPORARIES, set: set_temporaries};
val TAIL_MERGE:    Row = Row{flag: args.Flag{long: "tail-merge", short: 0, value: nil, repeat: false, negatable: true, help: "share the tails of merged strings (default: the target's)"}, placement: false, option: link_options.TAIL_MERGE, set: set_tail_merge};
val COMPRESS:      Row = Row{flag: args.Flag{long: "compress-debug-sections", short: 0, value: "none|zlib|zstd", repeat: false, negatable: false, help: "compress the debug sections"}, placement: false, option: link_options.COMPRESS, set: set_compress};
val BASE:          Row = Row{flag: args.Flag{long: "base", short: 0, value: "address", repeat: false, negatable: false, help: "the image base (default: the target's)"}, placement: true, option: link_options.BASE, set: set_base};
val SECTION:       Row = Row{flag: args.Flag{long: "section", short: 0, value: "name", repeat: true, negatable: false, help: "place this output section ahead of the rest, in the order named, once per section"}, placement: true, option: link_options.SECTIONS, set: set_section};
val REGION:        Row = Row{flag: args.Flag{long: "region", short: 0, value: "name,origin,length,rwx", repeat: true, negatable: false, help: "state a memory region: its name, start, size in bytes and the access it allows of r, w and x, once per region"}, placement: true, option: link_options.REGIONS, set: set_region};
val RUN_REGION:    Row = Row{flag: args.Flag{long: "run-region", short: 0, value: "section,region", repeat: true, negatable: false, help: "run this output section in this region, once per section"}, placement: true, option: link_options.RUNS, set: set_run_region};
val LOAD_REGION:   Row = Row{flag: args.Flag{long: "load-region", short: 0, value: "section,region", repeat: true, negatable: false, help: "load this output section's bytes in this region, where it runs when not given, once per section"}, placement: true, option: link_options.LOADS, set: set_load_region};
val OFFSET:        Row = Row{flag: args.Flag{long: "offset", short: 0, value: "section,offset", repeat: true, negatable: false, help: "start this output section at this offset from the start of the region it runs in, from the image base when it runs in none, once per section"}, placement: true, option: link_options.OFFSETS, set: set_offset};
val SIZE:          Row = Row{flag: args.Flag{long: "size", short: 0, value: "bytes", repeat: false, negatable: false, help: "the most bytes the image loads from its base, refusing a larger one, and a flat image is padded to exactly this many"}, placement: true, option: link_options.SIZE, set: set_size};
val FILL:          Row = Row{flag: args.Flag{long: "fill", short: 0, value: "byte", repeat: false, negatable: false, help: "the byte every byte of a flat image no section loads holds, zero when not given"}, placement: true, option: link_options.FILL, set: set_fill};
val STACK_RESERVE: Row = Row{flag: args.Flag{long: "stack-reserve", short: 0, value: "bytes", repeat: false, negatable: false, help: "the stack bytes to reserve (default: the target's)"}, placement: false, option: link_options.STACK_RESERVE, set: set_stack_reserve};
val STACK_COMMIT:  Row = Row{flag: args.Flag{long: "stack-commit", short: 0, value: "bytes", repeat: false, negatable: false, help: "the stack bytes to commit (default: the target's)"}, placement: false, option: link_options.STACK_COMMIT, set: set_stack_commit};
val LIBRARY:       Row = Row{flag: args.Flag{long: "library", short: 'l', value: "name", repeat: true, negatable: false, help: "link this library where it stands among the inputs"}, placement: false, option: fail.NO_OPTION, set: set_library};
val FRAMEWORK:     Row = Row{flag: args.Flag{long: "framework", short: 0, value: "name", repeat: true, negatable: false, help: "link this framework where it stands among the inputs"}, placement: false, option: fail.NO_OPTION, set: set_framework};
val LIBRARY_DIR:   Row = Row{flag: args.Flag{long: "library-dir", short: 'L', value: "dir", repeat: true, negatable: false, help: "search this directory for libraries first"}, placement: false, option: link_options.LIBDIRS, set: set_library_dir};
val FRAMEWORK_DIR: Row = Row{flag: args.Flag{long: "framework-dir", short: 'F', value: "dir", repeat: true, negatable: false, help: "search this directory for frameworks first"}, placement: false, option: link_options.FWDIRS, set: set_framework_dir};
val SYSROOT:       Row = Row{flag: args.Flag{long: "sysroot", short: 0, value: "path", repeat: false, negatable: false, help: "search the system's directories under this root"}, placement: false, option: link_options.SYSROOT, set: set_sysroot};
val AS_NEEDED:     Row = Row{flag: args.Flag{long: "as-needed", short: 0, value: nil, repeat: true, negatable: true, help: "load the libraries after it only when used (default: the target's)"}, placement: false, option: fail.NO_OPTION, set: set_as_needed};
val LIBRARY_KIND:  Row = Row{flag: args.Flag{long: "library-kind", short: 0, value: "shared|static", repeat: true, negatable: false, help: "take the libraries after it only as this kind"}, placement: false, option: fail.NO_OPTION, set: set_library_kind};
val THREADS:       Row = Row{flag: args.Flag{long: "threads", short: 0, value: "n", repeat: false, negatable: false, help: "how many threads the link runs on (default: host CPUs)"}, placement: false, option: link_options.THREADS, set: set_threads};
val LAYOUT:        Row = Row{flag: args.Flag{long: "layout", short: 0, value: "path", repeat: false, negatable: false, help: "read placement from this layout file"}, placement: false, option: fail.NO_OPTION, set: set_layout};

val ROW_COUNT: usize           = 39;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{?OUTPUT, ?INTERFACE, ?KIND, ?LINKAGE, ?TARGET, ?ENV, ?ABI, ?ISA, ?EXT, ?CODE_MODEL, ?FORMAT, ?SYS_VERSION, ?SDK_VERSION, ?SUBSYSTEM, ?ENTRY, ?KEEP, ?GC_SECTIONS, ?TEMPORARIES, ?TAIL_MERGE, ?COMPRESS, ?BASE, ?SECTION, ?REGION, ?RUN_REGION, ?LOAD_REGION, ?OFFSET, ?SIZE, ?FILL, ?STACK_RESERVE, ?STACK_COMMIT, ?LIBRARY, ?FRAMEWORK, ?LIBRARY_DIR, ?FRAMEWORK_DIR, ?SYSROOT, ?AS_NEEDED, ?LIBRARY_KIND, ?THREADS, ?LAYOUT};

# every flag of a link in help order, the help flag first
val FLAG_COUNT: usize                  = 32;
val FLAGS:      [FLAG_COUNT]*args.Flag = [FLAG_COUNT]*args.Flag{?context.HELP, ?OUTPUT.flag, ?INTERFACE.flag, ?KIND.flag, ?LINKAGE.flag, ?TARGET.flag, ?ENV.flag, ?ABI.flag, ?ISA.flag, ?EXT.flag, ?CODE_MODEL.flag, ?FORMAT.flag, ?SYS_VERSION.flag, ?SDK_VERSION.flag, ?SUBSYSTEM.flag, ?ENTRY.flag, ?KEEP.flag, ?GC_SECTIONS.flag, ?TEMPORARIES.flag, ?TAIL_MERGE.flag, ?COMPRESS.flag, ?STACK_RESERVE.flag, ?STACK_COMMIT.flag, ?LIBRARY.flag, ?FRAMEWORK.flag, ?LIBRARY_DIR.flag, ?FRAMEWORK_DIR.flag, ?SYSROOT.flag, ?AS_NEEDED.flag, ?LIBRARY_KIND.flag, ?THREADS.flag, ?LAYOUT.flag};

# the link's flags, which the command that runs a link lists
val LIST: Slice[*args.Flag] = Slice[*args.Flag]{data: ?FLAGS[0], size: FLAG_COUNT};

# a flag's failure inside the flag's record, but a refusal names its own part
fun flagged(f: Fail, flag: str) Fail {
    if (sel f.refused.some) { ret f; }
    ret fail.in_record(f, flag);
}

# the failure `f` about `value`, the text a flag or a layout line gave
fun bad_value(f: Fail, value: str) err[Fail] {
    ret err[Fail].err{fail.about(f, value)};
}

fun set_output(c: *Command, v: str, on: bool) err[Fail] {
    c.options.output = v;
    ret err[Fail].ok{};
}

fun set_interface(c: *Command, v: str, on: bool) err[Fail] {
    c.interface = v;
    ret err[Fail].ok{};
}

fun set_kind(c: *Command, v: str, on: bool) err[Fail] {
    val res_spelled: res[Spelled, Fail] = output.spelled(v);
    if (sel res_spelled.err) { ret err[Fail].err{res_spelled.err}; }
    c.kind = opt[Spelled].some{res_spelled.ok};
    ret err[Fail].ok{};
}

fun set_linkage(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.linkage = v;
    ret err[Fail].ok{};
}

fun set_format(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.format = v;
    ret err[Fail].ok{};
}

fun set_target(c: *Command, v: str, on: bool) err[Fail] {
    c.target = v;
    ret err[Fail].ok{};
}

fun set_env(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.env = v;
    ret err[Fail].ok{};
}

fun set_abi(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.abi = v;
    ret err[Fail].ok{};
}

fun set_isa(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.isa = v;
    ret err[Fail].ok{};
}

fun set_ext(c: *Command, v: str, on: bool) err[Fail] {
    val err_ext_pushed: err[Fail] = vectors.push[str](?c.ext, v);
    if (sel err_ext_pushed.err) { ret err[Fail].err{err_ext_pushed.err}; }
    ret err[Fail].ok{};
}

fun set_code_model(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.code_model = v;
    ret err[Fail].ok{};
}

fun set_sys_version(c: *Command, v: str, on: bool) err[Fail] {
    val res_version: res[Version, Fail] = version(v);
    if (sel res_version.err) { ret err[Fail].err{res_version.err}; }
    c.options.version = opt[Version].some{res_version.ok};
    ret err[Fail].ok{};
}

fun set_sdk_version(c: *Command, v: str, on: bool) err[Fail] {
    val res_version: res[Version, Fail] = version(v);
    if (sel res_version.err) { ret err[Fail].err{res_version.err}; }
    c.options.sdk = opt[Version].some{res_version.ok};
    ret err[Fail].ok{};
}

fun set_subsystem(c: *Command, v: str, on: bool) err[Fail] {
    val res_by_name: res[*Subsystem, Fail] = subsystem.by_name(v);
    if (sel res_by_name.err) { ret bad_value(res_by_name.err, v); }
    c.options.subsystem = opt[*Subsystem].some{res_by_name.ok};
    ret err[Fail].ok{};
}

fun set_entry(c: *Command, v: str, on: bool) err[Fail] {
    c.options.entry = v;
    ret err[Fail].ok{};
}

fun set_keep(c: *Command, v: str, on: bool) err[Fail] {
    val err_keep_pushed: err[Fail] = vectors.push[str](?c.keep, v);
    if (sel err_keep_pushed.err) { ret err[Fail].err{err_keep_pushed.err}; }
    ret err[Fail].ok{};
}

fun set_gc_sections(c: *Command, v: str, on: bool) err[Fail] {
    c.options.gc_sections = opt[bool].some{on};
    ret err[Fail].ok{};
}

fun set_temporaries(c: *Command, v: str, on: bool) err[Fail] {
    c.options.keep_temporaries = opt[bool].some{on};
    ret err[Fail].ok{};
}

fun set_tail_merge(c: *Command, v: str, on: bool) err[Fail] {
    c.options.tail_merge = opt[bool].some{on};
    ret err[Fail].ok{};
}

fun set_compress(c: *Command, v: str, on: bool) err[Fail] {
    if (str_equals(v, "none")) {
        c.options.compress = opt[*Method].none{};
        ret err[Fail].ok{};
    }
    val res_by_name: res[*Method, Fail] = compress.by_name(v);
    if (sel res_by_name.err) { ret err[Fail].err{res_by_name.err}; }
    val err_writes: err[Fail] = compress.writes(res_by_name.ok);
    if (sel err_writes.err) { ret bad_value(err_writes.err, v); }
    c.options.compress = opt[*Method].some{res_by_name.ok};
    ret err[Fail].ok{};
}

# the number `v` writes, in decimal or after a 0x, 0o or 0b prefix
fun number(v: str) res[u64, Fail] {
    val res_parse_u64_exact: res[u64, ParseError] = parse_u64_exact(v, 0);
    if (sel res_parse_u64_exact.err) {
        val e: ParseError = res_parse_u64_exact.err;
        if (sel e.overflow) { ret res[u64, Fail].err{fail.about(fail.overflow("a number does not fit in 64 bits"), v)}; }
        ret res[u64, Fail].err{fail.about(fail.malformed("a number is written in decimal or after a 0x, 0o or 0b prefix"), v)};
    }
    ret res[u64, Fail].ok{res_parse_u64_exact.ok};
}

# a thread count is from 1 to 65536, as the compiler takes one
fun set_threads(c: *Command, v: str, on: bool) err[Fail] {
    val res_number: res[u64, Fail] = number(v);
    if (sel res_number.err)                          { ret err[Fail].err{res_number.err}; }
    if (res_number.ok == 0 || res_number.ok > 65536) { ret bad_value(fail.malformed("a thread count is from 1 to 65536"), v); }
    c.options.threads = res_number.ok::u32;
    ret err[Fail].ok{};
}

fun set_base(c: *Command, v: str, on: bool) err[Fail] {
    val res_number: res[u64, Fail] = number(v);
    if (sel res_number.err) { ret err[Fail].err{res_number.err}; }
    c.options.base = opt[u64].some{res_number.ok};
    ret err[Fail].ok{};
}

fun set_section(c: *Command, v: str, on: bool) err[Fail] {
    val err_sections_pushed: err[Fail] = vectors.push[str](?c.sections, v);
    if (sel err_sections_pushed.err) { ret err[Fail].err{err_sections_pushed.err}; }
    ret err[Fail].ok{};
}

# the most fields a value holds
val FIELDS: usize = 4;

# split `v` into `n` fields, two or more, at its last `n - 1` commas into
# `out`, the last
# borrowed from `v` and every other copied into the command's pieces. a
# value with fewer commas or an empty field is refused as `grammar` states
fun fields(c: *Command, v: str, n: usize, grammar: str, out: *str) err[Fail] {
    val len:  usize = str_len(v);
    var stop: usize = len;
    var k:    usize = n;
    for (k > 1) {
        var at:    usize = stop;
        var found: bool  = false;
        for (at > 0 && !found) {
            at = at - 1;
            if (v[at] == ',') { found = true; }
        }
        if (!found || at + 1 == stop) { ret bad_value(fail.malformed(grammar), v); }
        if (k == n)                   { out[k - 1] = (?v[at + 1])::str; }
        or {
            val res_piece: res[str, Fail] = piece(c, v, at + 1, stop - at - 1);
            if (sel res_piece.err) { ret err[Fail].err{res_piece.err}; }
            out[k - 1] = res_piece.ok;
        }
        stop = at;
        k    = k - 1;
    }
    if (stop == 0) { ret bad_value(fail.malformed(grammar), v); }
    val res_piece: res[str, Fail] = piece(c, v, 0, stop);
    if (sel res_piece.err) { ret err[Fail].err{res_piece.err}; }
    out[0] = res_piece.ok;
    ret err[Fail].ok{};
}

# the `len` bytes of `v` from `at`, copied with a zero after them into the
# command's pieces
fun piece(c: *Command, v: str, at: usize, len: usize) res[str, Fail] {
    val res_str_copy_slice: res[str, StrError] = str_copy_slice(c.a, v, at, len);
    if (sel res_str_copy_slice.err) {
        val e: StrError = res_str_copy_slice.err;
        if (sel e.alloc) { ret res[str, Fail].err{fail.refused(e.alloc)}; }
        ret res[str, Fail].err{fail.internal("a field lies outside its value")};
    }
    val err_pieces_pushed: err[Fail] = vectors.push[str](?c.pieces, res_str_copy_slice.ok);
    if (sel err_pieces_pushed.err) {
        val err_deallocate: err[A.Error] = A.deallocate[char](c.a, res_str_copy_slice.ok, len + 1);
        ret res[str, Fail].err{err_pieces_pushed.err};
    }
    ret res[str, Fail].ok{res_str_copy_slice.ok};
}

# the access `v` writes as r, w and x, each at most once
fun access(v: str) res[u8, Fail] {
    var bits: u8    = 0;
    var i:    usize = 0;
    for (v[i] != 0) {
        var bit: u8 = 0;
        if (v[i] == 'r')                   { bit = layout.READABLE; }
        or (v[i] == 'w')                   { bit = layout.WRITABLE; }
        or (v[i] == 'x')                   { bit = layout.EXECUTABLE; }
        if (bit == 0 || (bits & bit) != 0) { ret res[u8, Fail].err{fail.about(fail.malformed("a region's access is some of r, w and x, each once"), v)}; }
        bits = bits | bit;
        i    = i + 1;
    }
    if (bits == 0) { ret res[u8, Fail].err{fail.about(fail.malformed("a region's access is some of r, w and x, each once"), v)}; }
    ret res[u8, Fail].ok{bits};
}

fun set_region(c: *Command, v: str, on: bool) err[Fail] {
    var f:          [FIELDS]str;
    val err_fields: err[Fail] = fields(c, v, 4, "a region is `name,origin,length,access`", ?f[0]);
    if (sel err_fields.err) { ret err_fields; }
    val res_origin: res[u64, Fail] = number(f[1]);
    if (sel res_origin.err) { ret err[Fail].err{res_origin.err}; }
    val res_length: res[u64, Fail] = number(f[2]);
    if (sel res_length.err) { ret err[Fail].err{res_length.err}; }
    val res_bits: res[u8, Fail] = access(f[3]);
    if (sel res_bits.err) { ret err[Fail].err{res_bits.err}; }
    val err_regions_pushed: err[Fail] = vectors.push[Area](?c.regions, Area{name: f[0], origin: res_origin.ok, length: res_length.ok, access: res_bits.ok});
    if (sel err_regions_pushed.err) { ret err[Fail].err{err_regions_pushed.err}; }
    ret err[Fail].ok{};
}

# the section and the region's name `v` states, into `into`
fun named_region(c: *Command, v: str, into: *Vector[Named]) err[Fail] {
    var f:          [FIELDS]str;
    val err_fields: err[Fail] = fields(c, v, 2, "a section in a region is `section,region`", ?f[0]);
    if (sel err_fields.err) { ret err_fields; }
    val err_into_pushed: err[Fail] = vectors.push[Named](into, Named{section: f[0], region: f[1]});
    if (sel err_into_pushed.err) { ret err[Fail].err{err_into_pushed.err}; }
    ret err[Fail].ok{};
}

fun set_run_region(c: *Command, v: str, on: bool) err[Fail] {
    ret named_region(c, v, ?c.runs);
}

fun set_load_region(c: *Command, v: str, on: bool) err[Fail] {
    ret named_region(c, v, ?c.loads);
}

fun set_offset(c: *Command, v: str, on: bool) err[Fail] {
    var f:          [FIELDS]str;
    val err_fields: err[Fail] = fields(c, v, 2, "a section's offset is `section,offset`", ?f[0]);
    if (sel err_fields.err) { ret err_fields; }
    val res_number: res[u64, Fail] = number(f[1]);
    if (sel res_number.err) { ret err[Fail].err{res_number.err}; }
    val err_offsets_pushed: err[Fail] = vectors.push[Offset](?c.offsets, Offset{section: f[0], offset: res_number.ok});
    if (sel err_offsets_pushed.err) { ret err[Fail].err{err_offsets_pushed.err}; }
    ret err[Fail].ok{};
}

fun set_size(c: *Command, v: str, on: bool) err[Fail] {
    val res_number: res[u64, Fail] = number(v);
    if (sel res_number.err) { ret err[Fail].err{res_number.err}; }
    c.options.size = opt[u64].some{res_number.ok};
    ret err[Fail].ok{};
}

fun set_fill(c: *Command, v: str, on: bool) err[Fail] {
    val res_number: res[u64, Fail] = number(v);
    if (sel res_number.err)   { ret err[Fail].err{res_number.err}; }
    if (res_number.ok > 0xff) { ret bad_value(fail.overflow("a fill is one byte"), v); }
    c.options.fill = opt[u8].some{res_number.ok::u8};
    ret err[Fail].ok{};
}

fun set_stack_reserve(c: *Command, v: str, on: bool) err[Fail] {
    val res_number: res[u64, Fail] = number(v);
    if (sel res_number.err) { ret err[Fail].err{res_number.err}; }
    c.options.stack_reserve = opt[u64].some{res_number.ok};
    ret err[Fail].ok{};
}

fun set_stack_commit(c: *Command, v: str, on: bool) err[Fail] {
    val res_number: res[u64, Fail] = number(v);
    if (sel res_number.err) { ret err[Fail].err{res_number.err}; }
    c.options.stack_commit = opt[u64].some{res_number.ok};
    ret err[Fail].ok{};
}

# read the layout file at `v` and apply each of its lines through its key's row
fun set_layout(c: *Command, v: str, on: bool) err[Fail] {
    val err_read: err[Fail] = plan.read(?c.plan, c.a, v);
    if (sel err_read.err) { ret err_read; }
    var i: usize = 0;
    for (i < vector.length[plan.Line](?c.plan.lines)) {
        val l:          *plan.Line = ?c.plan.lines.data[i];
        val err_stated: err[Fail]  = stated(c, l);
        if (sel err_stated.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(err_stated.err, "line", l.line), v)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the index of the row whose long name is `key`
fun key_row(key: str) opt[usize] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].flag.long, key)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# apply the layout line `l` through the placement row its key names, counted
# with the flags' occurrences of that row
fun stated(c: *Command, l: *plan.Line) err[Fail] {
    val opt_key_row: opt[usize] = key_row(l.key);
    if (sel opt_key_row.none) { ret bad_value(fail.malformed("a layout key names a placement"), l.key); }
    val row: *Row = ROWS[opt_key_row.some];
    if (!row.placement) { ret bad_value(fail.malformed("a layout key names a placement"), l.key); }
    val takes: bool = args.takes_value(?row.flag);
    if (!takes && l.value != nil) { ret bad_value(fail.malformed("a switch takes no value"), l.key); }
    if (takes && l.value == nil)  { ret bad_value(fail.malformed("needs a value"), l.key); }
    val given: usize = args.occurrences(c.line, ?row.flag) + c.stated[opt_key_row.some];
    if (!row.flag.repeat && given != 0) { ret bad_value(fail.malformed("given more than once"), l.key); }
    c.stated[opt_key_row.some] = c.stated[opt_key_row.some] + 1;
    ret row.set(c, l.value, true);
}

# append the request `r` to the inputs, where it stands among them
fun named(c: *Command, r: Request) err[Fail] {
    val err_inputs_pushed: err[Fail] = vectors.push[Request](?c.inputs, r);
    if (sel err_inputs_pushed.err) { ret err[Fail].err{err_inputs_pushed.err}; }
    ret err[Fail].ok{};
}

fun set_library(c: *Command, v: str, on: bool) err[Fail] {
    ret named(c, Request.library{Wanted{form: Form.system{}, name: v, include: c.include, prefer: c.prefer}});
}

fun set_framework(c: *Command, v: str, on: bool) err[Fail] {
    ret named(c, Request.library{Wanted{form: Form.framework{}, name: v, include: c.include, prefer: c.prefer}});
}

fun set_library_dir(c: *Command, v: str, on: bool) err[Fail] {
    val err_libdirs_pushed: err[Fail] = vectors.push[str](?c.libdirs, v);
    if (sel err_libdirs_pushed.err) { ret err[Fail].err{err_libdirs_pushed.err}; }
    ret err[Fail].ok{};
}

fun set_framework_dir(c: *Command, v: str, on: bool) err[Fail] {
    val err_fwdirs_pushed: err[Fail] = vectors.push[str](?c.fwdirs, v);
    if (sel err_fwdirs_pushed.err) { ret err[Fail].err{err_fwdirs_pushed.err}; }
    ret err[Fail].ok{};
}

fun set_sysroot(c: *Command, v: str, on: bool) err[Fail] {
    c.options.sysroot = v;
    ret err[Fail].ok{};
}

fun set_as_needed(c: *Command, v: str, on: bool) err[Fail] {
    if (on) { c.include = Include.referenced{}; }
    or      { c.include = Include.always{}; }
    ret err[Fail].ok{};
}

fun set_library_kind(c: *Command, v: str, on: bool) err[Fail] {
    if (str_equals(v, "shared")) { c.prefer = Prefer.shared_only{}; }
    or (str_equals(v, "static")) { c.prefer = Prefer.static_only{}; }
    or                           { ret err[Fail].err{fail.about(fail.malformed("--library-kind takes shared or static"), v)}; }
    ret err[Fail].ok{};
}

# the decimal number of `text[at..]` up to a dot or the end, at most `max`,
# with `next` left at the byte after it
fun component(text: str, at: usize, max: u64, next: *usize) res[u64, Fail] {
    var i: usize = at;
    var n: u64   = 0;
    for (text[i] >= '0' && text[i] <= '9') {
        n = n * 10 + (text[i] - '0')::u64;
        if (n > max) { ret res[u64, Fail].err{fail.overflow("a version component is too large")}; }
        i = i + 1;
    }
    if (i == at) { ret res[u64, Fail].err{fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal")}; }
    @next = i;
    ret res[u64, Fail].ok{n};
}

# the version `text` writes as `major.minor` or `major.minor.patch`, a patch
# not written being zero as the notation states
fun version(text: str) res[Version, Fail] {
    var at:        usize          = 0;
    val res_major: res[u64, Fail] = component(text, at, 0xffff, ?at);
    if (sel res_major.err) { ret res[Version, Fail].err{fail.about(res_major.err, text)}; }
    if (text[at] != '.')   { ret res[Version, Fail].err{fail.about(fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal"), text)}; }
    val res_minor: res[u64, Fail] = component(text, at + 1, 0xff, ?at);
    if (sel res_minor.err) { ret res[Version, Fail].err{fail.about(res_minor.err, text)}; }
    var patch: u64 = 0;
    if (text[at] == '.') {
        val res_component: res[u64, Fail] = component(text, at + 1, 0xff, ?at);
        if (sel res_component.err) { ret res[Version, Fail].err{fail.about(res_component.err, text)}; }
        patch = res_component.ok;
    }
    if (text[at] != 0) { ret res[Version, Fail].err{fail.about(fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal"), text)}; }
    ret res[Version, Fail].ok{Version{major: res_major.ok::u16, minor: res_minor.ok::u8, patch: patch::u8}};
}

# the refusal of a link that leaves out the option `row` writes
fun needs(row: *Row) err[Fail] {
    ret err[Fail].err{fail.about(fail.malformed("the link needs the option {}"), row.flag.long)};
}

# the row whose canonical flag is `f`, none for a flag of another table the
# command composes. a scan of the rows, the cost std.args pays per token too
fun row_of(f: *args.Flag) opt[*Row] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (?ROWS[i].flag == f) { ret opt[*Row].some{ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# resolve the target under the narrowing
fun targeted(c: *Command) err[Fail] {
    if (c.target == nil) { ret needs(?TARGET); }
    val res_spec: res[Spec, Fail] = target.parse(c.target);
    if (sel res_spec.err) { ret err[Fail].err{res_spec.err}; }
    val err_linked: err[Fail] = linked_only(c);
    if (sel err_linked.err) { ret err_linked; }
    c.narrowing.ext       = c.ext.data;
    c.narrowing.ext_count = vector.length[str](?c.ext);
    val res_resolve: res[target.Target, Fail] = target.resolve(res_spec.ok, ?c.narrowing);
    if (sel res_resolve.err) { ret err[Fail].err{res_resolve.err}; }
    c.options.target = res_resolve.ok;
    ret made_of(c, ?c.options.target);
}

# refuse a linkage given with a kind other than the executables, naming both,
# as only an executable is linked as one
fun linked_only(c: *Command) err[Fail] {
    val given:    str          = c.narrowing.linkage;
    val opt_kind: opt[Spelled] = c.kind;
    if (given == nil)      { ret err[Fail].ok{}; }
    if (sel opt_kind.none) { ret err[Fail].ok{}; }
    val spelled: Spelled = opt_kind.some;
    if (sel spelled.executable) { ret err[Fail].ok{}; }
    val res_both: res[str, StrError] = str_join(c.a, "--kind ", spelled.row.spelled, " --linkage ", given);
    if (sel res_both.err) {
        val e: StrError = res_both.err;
        if (sel e.alloc) { ret err[Fail].err{fail.refused(e.alloc)}; }
        ret err[Fail].err{fail.internal("the refusal's subject could not be joined")};
    }
    val err_kept: err[Fail] = vectors.push[str](?c.pieces, res_both.ok);
    if (sel err_kept.err) {
        val err_deallocate: err[A.Error] = A.deallocate[char](c.a, res_both.ok, str_len(res_both.ok) + 1);
        ret err[Fail].err{err_kept.err};
    }
    ret err[Fail].err{fail.about(fail.malformed("a linkage applies only to --kind bin, as only an executable is linked as one"), res_both.ok)};
}

# the output kind `--kind` resolves to on `t`: an executable's the target's
# linkage picks, and any other the one row it spells
fun made_of(c: *Command, t: *target.Target) err[Fail] {
    val opt_kind: opt[Spelled] = c.kind;
    if (sel opt_kind.none) { ret needs(?KIND); }
    val spelled: Spelled = opt_kind.some;
    if (sel spelled.row) {
        c.options.kind = spelled.row;
        ret err[Fail].ok{};
    }
    val res_executable: res[*Kind, Fail] = target.executable(t);
    if (sel res_executable.err) { ret err[Fail].err{res_executable.err}; }
    c.options.kind = res_executable.ok;
    ret err[Fail].ok{};
}

# check what the flags stated together, and resolve the target
fun finish(c: *Command) err[Fail] {
    val err_targeted: err[Fail] = targeted(c);
    if (sel err_targeted.err)                   { ret err_targeted; }
    if (c.options.output == nil)                { ret needs(?OUTPUT); }
    if (vector.length[Request](?c.inputs) == 0) { ret err[Fail].err{fail.malformed("the link names no input file")}; }
    if (c.options.threads == 0)                 { c.options.threads = host_threads(); }
    c.options.keep          = c.keep.data;
    c.options.keep_count    = vector.length[str](?c.keep);
    c.options.sections      = c.sections.data;
    c.options.section_count = vector.length[str](?c.sections);
    c.options.libdirs       = c.libdirs.data;
    c.options.libdir_count  = vector.length[str](?c.libdirs);
    c.options.fwdirs        = c.fwdirs.data;
    c.options.fwdir_count   = vector.length[str](?c.fwdirs);
    ret placements(c);
}

# the host's processors, the threads a link runs on when the command line
# names no count
fun host_threads() u32 {
    val n: i64 = os.cpu_count();
    if (n > 1) { ret n::u32; }
    ret 1;
}

fun name_hash(k: *str) u64 {
    ret fnv1a.step_bytes(fnv1a.FNV_INIT, (@k)::*u8, str_len(@k));
}

fun name_equal(a: *str, b: *str) bool {
    ret str_equals(@a, @b);
}

# resolve the regions the runs and the loads name against the regions
# stated, each region stated once, and hand the statements to the options
fun placements(c: *Command) err[Fail] {
    var by:           MapBy[str, usize] = map.init_by[str, usize](c.a, name_hash, name_equal);
    val err_resolved: err[Fail]         = resolved(c, ?by);
    val err_dnit_by:  err[A.Error]      = map.dnit_by[str, usize](?by);
    if (sel err_resolved.err) { ret err_resolved; }
    if (sel err_dnit_by.err)  { ret err[Fail].err{fail.refused(err_dnit_by.err)}; }
    c.options.regions      = c.regions.data;
    c.options.region_count = vector.length[Area](?c.regions);
    c.options.runs         = c.ran.data;
    c.options.run_count    = vector.length[Within](?c.ran);
    c.options.loads        = c.loaded.data;
    c.options.load_count   = vector.length[Within](?c.loaded);
    c.options.offsets      = c.offsets.data;
    c.options.offset_count = vector.length[Offset](?c.offsets);
    ret err[Fail].ok{};
}

# map each region stated to its index in `by`, refusing a name stated twice,
# then resolve the runs and the loads through it
fun resolved(c: *Command, by: *MapBy[str, usize]) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Area](?c.regions)) {
        val name:    str                = c.regions.data[i].name;
        val res_put: res[bool, A.Error] = map.insert_by[str, usize](by, name, i);
        if (sel res_put.err) { ret err[Fail].err{fail.refused(res_put.err)}; }
        if (!res_put.ok)     { ret err[Fail].err{fail.in_record(fail.about(fail.malformed("a region is stated more than once"), name), REGION.flag.long)}; }
        i = i + 1;
    }
    val err_within: err[Fail] = within(by, ?c.runs, RUN_REGION.flag.long, ?c.ran);
    if (sel err_within.err) { ret err_within; }
    ret within(by, ?c.loads, LOAD_REGION.flag.long, ?c.loaded);
}

# each statement of `from` with its region resolved through `by`, into `out`
fun within(by: *MapBy[str, usize], from: *Vector[Named], flag: str, out: *Vector[Within]) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Named](from)) {
        val n:         *Named      = ?from.data[i];
        var probe:     str         = n.region;
        val opt_found: opt[*usize] = map.get_by[str, usize](by, ?probe);
        if (sel opt_found.none) { ret err[Fail].err{fail.in_record(fail.about(fail.malformed("names no region the link states"), n.region), flag)}; }
        val err_out_pushed: err[Fail] = vectors.push[Within](out, Within{section: n.section, region: @opt_found.some});
        if (sel err_out_pushed.err) { ret err[Fail].err{err_out_pushed.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# read the command line `line` into `c`, whose tables live in `alloc` and
# whose formats are those of `g`. `line` is read against a command that
# lists LIST, without a refusal and not asking for help, and the help flag is
# left to the caller. a flag that does not repeat given twice is refused. `c` is released by dnit whether
# or not reading succeeds
fun parse(c: *Command, alloc: *A.Allocator, g: *Registry, line: *args.Parsed) err[Fail] {
    @c = Command{
        a:        alloc,
        registry: g,
        inputs:   vector.init[Request](alloc),
        keep:     vector.init[str](alloc),
        sections: vector.init[str](alloc),
        regions:  vector.init[Area](alloc),
        runs:     vector.init[Named](alloc),
        loads:    vector.init[Named](alloc),
        ran:      vector.init[Within](alloc),
        loaded:   vector.init[Within](alloc),
        offsets:  vector.init[Offset](alloc),
        pieces:   vector.init[str](alloc),
        plan:     plan.init(alloc),
        line:     line,
        libdirs:  vector.init[str](alloc),
        fwdirs:   vector.init[str](alloc),
        ext:      vector.init[str](alloc),
        found:    search.init(alloc),
    };
    if (sel line.refusal.some) { ret err[Fail].err{fail.internal("the link reads a command line std.args refused")}; }
    var once: usize = 0;
    for (once < ROW_COUNT) {
        val row: *Row = ROWS[once];
        once = once + 1;
        if (!row.flag.repeat && args.occurrences(line, ?row.flag) > 1) { ret err[Fail].err{fail.in_record(fail.malformed("given more than once"), row.flag.long)}; }
    }
    var w: args.Walk = args.walk(line);
    for {
        val e: args.Event = args.step(?w);
        if (sel e.done) { brk; }
        if (sel e.operand) {
            val err_named: err[Fail] = named(c, Request.file{File{path: line.args.argv[e.operand]::str, include: c.include}});
            if (sel err_named.err) { ret err_named; }
        }
        or (sel e.hit) {
            val opt_row: opt[*Row] = row_of(e.hit.flag);
            if (sel opt_row.some) {
                val err_value_set: err[Fail] = opt_row.some.set(c, e.hit.value, e.hit.on);
                if (sel err_value_set.err) { ret err[Fail].err{flagged(err_value_set.err, opt_row.some.flag.long)}; }
            }
        }
    }
    ret finish(c);
}

# give back the command's tables
fun dnit(c: *Command) err[Fail] {
    var err_first: err[Fail] = vectors.dnit[Request](?c.inputs);
    err_first = fail.kept(err_first, vectors.dnit[str](?c.keep));
    err_first = fail.kept(err_first, vectors.dnit[str](?c.sections));
    err_first = fail.kept(err_first, vectors.dnit[Area](?c.regions));
    err_first = fail.kept(err_first, vectors.dnit[Named](?c.runs));
    err_first = fail.kept(err_first, vectors.dnit[Named](?c.loads));
    err_first = fail.kept(err_first, vectors.dnit[Within](?c.ran));
    err_first = fail.kept(err_first, vectors.dnit[Within](?c.loaded));
    err_first = fail.kept(err_first, vectors.dnit[Offset](?c.offsets));
    err_first = fail.kept(err_first, vectors.dnit[str](?c.libdirs));
    err_first = fail.kept(err_first, vectors.dnit[str](?c.fwdirs));
    err_first = fail.kept(err_first, vectors.dnit[str](?c.ext));
    err_first = fail.kept(err_first, search.dnit(?c.found));
    var i: usize = 0;
    for (i < vector.length[str](?c.pieces)) {
        val s:              str          = c.pieces.data[i];
        val err_deallocate: err[A.Error] = A.deallocate[char](c.a, s, str_len(s) + 1);
        if (sel err_deallocate.err) { err_first = fail.kept(err_first, err[Fail].err{fail.refused(err_deallocate.err)}); }
        i = i + 1;
    }
    err_first = fail.kept(err_first, vectors.dnit[str](?c.pieces));
    ret fail.kept(err_first, plan.dnit(?c.plan));
}

# the command
pub val COMMAND: args.Command = args.Command{
    name:        "link",
    help:        "link input files into one image",
    usage:       "<input>... -o <path> -t <sys>-<arch> -k <kind>",
    flags:       LIST,
    operand_min: 0,
    operand_max: args.OPERANDS_ANY,
};

# link the input files the command line names into the image it names. a
# refused target is printed with what its part accepts, and a refused link
# before the notes that explain it
# ---
# r:   the run context
# ret: EXIT_OK, or the code of reporting why the link failed
pub fun run(r: *Run) i64 {
    var c:         Command;
    val err_parse: err[Fail] = parse(?c, r.a, r.reg, r.line);
    var code:      i64       = context.EXIT_OK;
    if (sel err_parse.err) { code = context.report(r.a, err_parse.err); }
    or                     { code = linked(r, ?c); }

    ret context.released(r.a, code, dnit(?c));
}

# link the input files the valid command `c` names into the output file it
# names, the notes the link leaves printed on stderr after a refusal
# ---
# r:   the run context
# c:   the command
# ret: EXIT_OK, or the code of reporting why the link failed
fun linked(r: *Run, c: *Command) i64 {
    var notes:   Sink               = sink.init(r.a, LITTLE);
    var res_out: res[Written, Fail] = state.link(?c.found, c.registry, c.options, c.inputs.data, vector.length[Request](?c.inputs), ?notes);
    var code:    i64                = context.EXIT_OK;
    if (sel res_out.err) { code = report_stated(r.a, c, res_out.err); }

    val err_shown: err[Fail] = file.emit(fs.STDERR, ?notes);
    if (sel err_shown.err) { code = context.report(r.a, err_shown.err); }
    code = context.released(r.a, code, sink.dnit(?notes));
    if (sel res_out.err) { ret code; }

    var written: Written = res_out.ok;
    if (code == context.EXIT_OK) {
        val err_save: err[Fail] = save(c, ?written);
        if (sel err_save.err) { code = context.report(r.a, err_save.err); }
    }

    ret context.released(r.a, code, write.dnit(?written));
}

# write the image to the output path, and its interface file to the path the
# command line names for it, refused for an image that has none
fun save(c: *Command, written: *Written) err[Fail] {
    val err_save_mode: err[Fail] = file.save_mode(c.options.output, ?written.image, file.mode_of(c.options.kind));
    if (sel err_save_mode.err) { ret err_save_mode; }
    if (c.interface == nil)    { ret err[Fail].ok{}; }
    if (sel written.interface.none) {
        ret err[Fail].err{fail.in_record(fail.unsupported("the image has no interface file, as what the link makes exports nothing or its format's links bind against the image itself"), c.options.kind.spelled)};
    }
    ret file.save(c.interface, ?written.interface.some);
}

# print the diagnostic of a refused link on stderr, and after it the line naming the option the
# refusal names as the command line or the layout file states it, the statement counted from 1
# where it names one of several. an option neither states, which the link defaulted, gets no line:
#
#       note --stack-reserve states it
#       note the layout's region, statement 2, states it
# ---
# a:   the allocator to allocate the sink in
# c:   the command whose line and layout stated the options
# f:   the failure to print
# ret: the code context.report gives `f`
fun report_stated(a: *A.Allocator, c: *Command, f: Fail) i64 {
    val code:    i64        = context.report(a, f);
    val opt_row: opt[usize] = row_of_option(f.option.row);
    if (sel opt_row.none) { ret code; }
    val row:   *Row  = ROWS[opt_row.some];
    val given: usize = args.occurrences(c.line, ?row.flag) + c.stated[opt_row.some];
    if (given == 0) { ret code; }
    var s:             Sink      = sink.init(a, LITTLE);
    var stated:        i64       = code;
    val err_stated_by: err[Fail] = stated_by(row, f.option, ?s);
    if (sel err_stated_by.err) { stated = context.EXIT_ENVIRONMENT; }
    or {
        val err_emit: err[Fail] = file.emit(fs.STDERR, ?s);
        if (sel err_emit.err) { stated = context.EXIT_ENVIRONMENT; }
    }
    val err_dnit: err[Fail] = sink.dnit(?s);
    if (sel err_dnit.err) { ret context.EXIT_ENVIRONMENT; }
    ret stated;
}

# the index of the row that writes the option `o`, none for NO_OPTION or an option no row writes
fun row_of_option(o: fail.Option) opt[usize] {
    if (o == fail.NO_OPTION) { ret opt[usize].none{}; }
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].option == o) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# append the note naming where the option of `row` was stated, as
# report_stated shows it
fun stated_by(row: *Row, asked: fail.Asked, out: *Sink) err[Fail] {
    val err_text_out: err[Fail] = sink.text(out, "  note ");
    if (sel err_text_out.err) { ret err_text_out; }
    var head: str = "--";
    if (row.placement) { head = "the layout's "; }
    val err_text_head: err[Fail] = sink.text(out, head);
    if (sel err_text_head.err) { ret err_text_head; }
    val err_text_long: err[Fail] = sink.text(out, row.flag.long);
    if (sel err_text_long.err) { ret err_text_long; }
    if (asked.indexed) {
        val err_text: err[Fail] = sink.text(out, ", statement ");
        if (sel err_text.err) { ret err_text; }
        val err_number: err[Fail] = sink.number(out, asked.index + 1, 10);
        if (sel err_number.err) { ret err_number; }
        val err_comma: err[Fail] = sink.text(out, ",");
        if (sel err_comma.err) { ret err_comma; }
    }
    ret sink.text(out, " states it\n");
}
