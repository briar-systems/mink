# `mink link`: link input files into one image

use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.args;

use fs: std.filesystem;

use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.output;
use mink.cli.context;
use mink.cli.context.Run;
use mink.format.file;
use mink.link.command;
use mink.link.command.Command;

# the codes a link exits with beside every command's
val EXIT_COUNT: usize                 = 1;
val EXITS:      [EXIT_COUNT]args.Exit = [EXIT_COUNT]args.Exit{
    args.Exit{code: context.EXIT_UNIMPLEMENTED, meaning: "the link needs what mink does not build yet"},
};

# the command's registration
pub val SPEC: args.CommandSpec = args.CommandSpec{
    name:            "link",
    id:              0,
    aliases:         nil,
    alias_n:         0,
    grammar:         " <input>... -o <path> --kind <kind> --format <format> --arch <arch> --sys <sys> [options]",
    summary:         "link input files into one image",
    effect:          "link the input files, objects, archives and libraries, in the order they are named, into one image",
    exits:           ?EXITS[0],
    exit_n:          EXIT_COUNT,
    terminator:      "",
    tables:          ?command.TABLE,
    table_n:         1,
    refused:         nil,
    refused_n:       0,
    refusal:         "",
    relations:       nil,
    relation_n:      0,
    constraints:     nil,
    constraint_n:    0,
    operand_min:     0,
    operand_max:     args.OPERANDS_ANY,
    truncate_at_sep: false,
    actions:         nil,
    action_n:        0,
    examples:        nil,
    example_n:       0
};

# link the input files the command line names into the image it names. a link
# refused for what mink does not build yet exits EXIT_UNIMPLEMENTED. a refusal
# is printed before the notes that explain it
# ---
# r:   the run context
# ret: EXIT_OK, EXIT_UNIMPLEMENTED, or the code of reporting why the link failed
pub fun run(r: *Run) i64 {
    var c: Command;
    val p: err[Fail] = command.parse(?c, r.a, ?r.reg, ?r.line);

    if (sel p.err) {
        val code:    i64       = context.report(r.a, p.err);
        val dropped: err[Fail] = command.release(?c);
        ret code;
    }

    # the command line is valid, so link the input files into the output file
    var notes: Sink            = sink.make(r.a, LITTLE);
    var out:   res[Sink, Fail] = command.link(?c, nil, 0, ?notes);
    if (sel out.err) {
        var code:  i64       = context.report(r.a, out.err);
        val shown: err[Fail] = file.emit(fs.STDERR, ?notes);
        if (sel shown.err)                 { code = context.report(r.a, shown.err); }
        if (sel out.err.cause.unsupported) { ret context.EXIT_UNIMPLEMENTED; }

        ret code;
    }

    val shown: err[Fail] = file.emit(fs.STDERR, ?notes);
    if (sel shown.err) { ret context.report(r.a, shown.err); }

    var mode: i32 = file.MODE;
    if (output.has(c.options.kind, output.ENTERED) || output.has(c.options.kind, output.LOADED)) { mode = file.RUNNABLE; }

    val sv: err[Fail] = file.save_mode(c.options.output, ?out.ok, mode);
    if (sel sv.err) { ret context.report(r.a, sv.err); }

    ret context.EXIT_OK;
}
