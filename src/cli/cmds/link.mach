# `mink link`: link input files into one image

use std.types.error.err;
use std.types.result.res;

use std.args;

use fs: std.filesystem;

use mink.base.fail;
use mink.base.fail.Detached;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.output;
use mink.cli.context;
use mink.cli.context.Run;
use mink.format.file;
use mink.link.command;
use mink.link.command.Command;
use mink.link.write.Written;

# the command
pub val COMMAND: args.Command = args.Command{
    name:        "link",
    help:        "link input files into one image",
    usage:       "<input>... -o <path> -t <sys>-<arch> -k <kind>",
    flags:       command.LIST,
    operand_min: 0,
    operand_max: args.OPERANDS_ANY,
};

# link the input files the command line names into the image it names. a
# refused target is printed with what its part accepts, and a refused link
# before the notes that explain it
# ---
# r:   the run context
# ret: EXIT_OK, or the code of reporting why the link failed
pub fun run(r: *Run) i64 {
    var c: Command;
    val p: err[Fail] = command.parse(?c, r.a, ?r.reg, r.line);

    if (sel p.err) {
        var code: i64 = 0;
        if (sel c.refused.some) { code = context.refuse_target(r.a, ?c.refused.some); }
        or                      { code = context.report(r.a, p.err); }
        val dropped: err[Fail] = command.release(?c);
        ret code;
    }

    # the command line is valid, so link the input files into the output file
    var notes: Sink                   = sink.make(r.a, LITTLE);
    var out:   res[Written, Detached] = command.link(?c, nil, 0, ?notes);
    if (sel out.err) {
        val refused: Fail      = fail.view(?out.err);
        var code:    i64       = context.report(r.a, refused);
        val shown:   err[Fail] = file.emit(fs.STDERR, ?notes);
        if (sel shown.err) { code = context.report(r.a, shown.err); }

        ret code;
    }

    val shown: err[Fail] = file.emit(fs.STDERR, ?notes);
    if (sel shown.err) { ret context.report(r.a, shown.err); }

    var written: Written   = out.ok;
    val sv:      err[Fail] = save(?c, ?written);
    if (sel sv.err) { ret context.report(r.a, sv.err); }

    ret context.EXIT_OK;
}

# write the image to the output path, and its interface file to the path the
# command line names for it, refused for an image that has none
fun save(c: *Command, written: *Written) err[Fail] {
    var mode: i32 = file.MODE;
    if (c.options.kind != nil && (output.has(c.options.kind, output.ENTERED) || output.has(c.options.kind, output.LOADED))) { mode = file.RUNNABLE; }

    val sv: err[Fail] = file.save_mode(c.options.output, ?written.image, mode);
    if (sel sv.err)         { ret sv; }
    if (c.interface == nil) { ret err[Fail].ok{}; }
    if (sel written.interface.none) {
        ret err[Fail].err{fail.in_record(fail.unsupported("the image has no interface file, as what the link makes exports nothing or its format's links bind against the image itself"), c.product.name)};
    }
    ret file.save(c.interface, ?written.interface.some);
}
