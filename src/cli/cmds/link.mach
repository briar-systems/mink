# `mink link`: link input files into one image, as the command line states
# the link
#
# one row table whose rows each write one field of the link's options or of
# the command. the operands are the input files, and libraries and frameworks
# are named by flags among them, all read in the order they are named. the
# rows a command lists to std.args are its flags, std.args refuses a flag no
# row names and renders the help page from the same rows, and parse refuses a
# flag that does not repeat given twice. a value no catalog row names is
# refused here, and a fact the link must be told is never filled in.
#
# the placement rows are the keys of a layout file, the only way to state
# placement, and no placement row is a flag. a layout line is applied
# through the row its key names, where the layout flag stands among the flags.
# a key no placement row names is refused. a value of several fields
# separates them by commas, the fields after the first split from the right,
# so a section's name may hold a comma. a region a statement names resolves
# once every flag is read. the link the command line states runs through the
# one entry of mink.link.state, as every other caller's does.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use std.args;
use std.collections.map;
use std.collections.map.MapBy;
use std.collections.slice.Slice;
use std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.hash.fnv1a;
use fs: std.filesystem;
use std.text.parse.ParseError;
use std.text.parse.parse_u64_exact;

use mink.base.fail;
use mink.base.fail.Detached;
use mink.base.fail.Fail;
use mink.base.vectors;
use mink.bytes.compress;
use mink.bytes.compress.Method;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.os.Version;
use mink.catalog.output;
use mink.catalog.output.Kind;
use mink.catalog.output.Spelled;
use mink.catalog.subsystem;
use mink.catalog.subsystem.Subsystem;
use mink.catalog.target;
use mink.catalog.target.Refusal;
use mink.catalog.target.Spec;
use mink.cli.context;
use mink.cli.context.Run;
use mink.format.file;
use mink.format.registry.Registry;
use mink.link.input.File;
use mink.link.input.Form;
use mink.link.input.Include;
use mink.link.input.Prefer;
use mink.link.input.Request;
use mink.link.input.Wanted;
use mink.link.layout;
use mink.link.options.Area;
use mink.link.options.Offset;
use mink.link.options.Options;
use mink.link.options.Within;
use mink.link.plan;
use mink.link.search;
use mink.link.state;
use mink.link.write.Written;

# a link as its command line states it
# ---
# a:         the allocator its tables live in
# registry:  the formats the link reads and writes
# options:   the link's options
# inputs:    the input files, libraries and frameworks, in the order they
#            are named
# keep:      the names kept, which options.keep points into
# sections:  the sections placed ahead of the rest, which options.sections
#            points into
# regions:   the memory regions stated, which options.regions points into
# runs:      the sections stated to run in a region, by the region's name
# loads:     the sections stated to load in a region, by the region's name
# ran:       the runs with their regions resolved, which options.runs
#            points into
# loaded:    the loads with their regions resolved, which options.loads
#            points into
# offsets:   the sections stated at an offset, which options.offsets points
#            into
# pieces:    the fields copied out of values, each a zero after it, which
#            the statements point into
# plan:      the layout file read, whose text the values it stated point into
# line:      the command line read, while parse reads it
# stated:    how many layout lines stated each row
# target:    the target's spelling, resolved under the narrowing once every
#            flag is read
# narrowing: what the narrowing flags state, its extensions pointing into ext
# ext:       the extensions stated, in the order named
# refused:   why the target was refused, none while it is not
# include:   how a library named from here on is included, as the as-needed
#            switch last stated
# prefer:    which files a library named from here on is searched for, as
#            the library kind last stated
# libdirs:   the library directories stated, which options.libdirs
#            points into
# fwdirs:    the framework directories stated, which options.fwdirs
#            points into
# found:     what the link's search makes, which its sources point into
# interface: the path the interface file of a library is written to, nil
#            where the command line states none
# kind:      what `--kind` spells, none while the command line names none
rec Command {
    a:         *A.Allocator;
    registry:  *Registry;
    options:   Options;
    inputs:    Vector[Request];
    keep:      Vector[str];
    sections:  Vector[str];
    regions:   Vector[Area];
    runs:      Vector[Named];
    loads:     Vector[Named];
    ran:       Vector[Within];
    loaded:    Vector[Within];
    offsets:   Vector[Offset];
    pieces:    Vector[str];
    plan:      plan.Plan;
    line:      *args.Parsed;
    stated:    [ROW_COUNT]usize;
    target:    str;
    narrowing: target.Narrowing;
    ext:       Vector[str];
    refused:   opt[Refusal];
    include:   Include;
    prefer:    Prefer;
    libdirs:   Vector[str];
    fwdirs:    Vector[str];
    found:     search.Found;
    interface: str;
    kind:      opt[Spelled];
}

# an output section stated to lie in the region of a name
rec Named {
    section: str;
    region:  str;
}

# one flag and the field it writes
# ---
# flag:      the flag as std.args reads it
# placement: the row states where the image's bytes go, and is a key of a
#            layout file, spelled as its long name without the dashes
# set:       write the flag's value, nil for a switch, into the command, with
#            whether a switch was given rather than negated
rec Row {
    flag:      args.Flag;
    placement: bool;
    set:       fun(*Command, str, bool) err[Fail];
}

val OUTPUT:        Row = Row{flag: args.Flag{long: "output", short: 'o', value: "path", repeat: false, negatable: false, help: "write the image here"}, placement: false, set: set_output};
val INTERFACE:     Row = Row{flag: args.Flag{long: "interface", short: 0, value: "path", repeat: false, negatable: false, help: "write the import library here"}, placement: false, set: set_interface};
val KIND:          Row = Row{flag: args.Flag{long: "kind", short: 'k', value: "bin|static|shared|object|module", repeat: false, negatable: false, help: "what the link makes"}, placement: false, set: set_kind};
val LINKAGE:       Row = Row{flag: args.Flag{long: "linkage", short: 0, value: "pie|dynamic|static", repeat: false, negatable: false, help: "how an executable links (default: the target's)"}, placement: false, set: set_linkage};
val TARGET:        Row = Row{flag: args.Flag{long: "target", short: 't', value: "sys-arch", repeat: false, negatable: false, help: "the target, as `mach info targets` spells it"}, placement: false, set: set_target};
val ENV:           Row = Row{flag: args.Flag{long: "env", short: 0, value: "env", repeat: false, negatable: false, help: "the environment (default: the target's)"}, placement: false, set: set_env};
val ABI:           Row = Row{flag: args.Flag{long: "abi", short: 0, value: "abi", repeat: false, negatable: false, help: "the calling convention (default: the target's)"}, placement: false, set: set_abi};
val ISA:           Row = Row{flag: args.Flag{long: "isa", short: 0, value: "isa", repeat: false, negatable: false, help: "the instruction set (default: the target's)"}, placement: false, set: set_isa};
val EXT:           Row = Row{flag: args.Flag{long: "ext", short: 0, value: "name", repeat: true, negatable: false, help: "add an instruction set extension"}, placement: false, set: set_ext};
val CODE_MODEL:    Row = Row{flag: args.Flag{long: "code-model", short: 0, value: "name", repeat: false, negatable: false, help: "the code model (default: the target's)"}, placement: false, set: set_code_model};
val FORMAT:        Row = Row{flag: args.Flag{long: "format", short: 0, value: "format", repeat: false, negatable: false, help: "the output format (default: the target's)"}, placement: false, set: set_format};
val SYS_VERSION:   Row = Row{flag: args.Flag{long: "sys-version", short: 0, value: "x.y[.z]", repeat: false, negatable: false, help: "the oldest system version the image runs on"}, placement: false, set: set_sys_version};
val SDK_VERSION:   Row = Row{flag: args.Flag{long: "sdk-version", short: 0, value: "x.y[.z]", repeat: false, negatable: false, help: "the SDK version the image builds against"}, placement: false, set: set_sdk_version};
val SUBSYSTEM:     Row = Row{flag: args.Flag{long: "subsystem", short: 0, value: "subsystem", repeat: false, negatable: false, help: "the PE subsystem (default: the target's)"}, placement: false, set: set_subsystem};
val ENTRY:         Row = Row{flag: args.Flag{long: "entry", short: 0, value: "symbol", repeat: false, negatable: false, help: "the entry symbol (default: the target's)"}, placement: false, set: set_entry};
val KEEP:          Row = Row{flag: args.Flag{long: "keep", short: 0, value: "symbol", repeat: true, negatable: false, help: "keep this symbol even when unreferenced"}, placement: false, set: set_keep};
val GC_SECTIONS:   Row = Row{flag: args.Flag{long: "gc-sections", short: 0, value: nil, repeat: true, negatable: true, help: "drop sections nothing reaches (default: the target's)"}, placement: false, set: set_gc_sections};
val TEMPORARIES:   Row = Row{flag: args.Flag{long: "temporaries", short: 0, value: nil, repeat: false, negatable: true, help: "keep the assemblers' local labels (default: the target's)"}, placement: false, set: set_temporaries};
val TAIL_MERGE:    Row = Row{flag: args.Flag{long: "tail-merge", short: 0, value: nil, repeat: false, negatable: true, help: "share the tails of merged strings (default: the target's)"}, placement: false, set: set_tail_merge};
val COMPRESS:      Row = Row{flag: args.Flag{long: "compress-debug-sections", short: 0, value: "none|zlib|zstd", repeat: false, negatable: false, help: "compress the debug sections"}, placement: false, set: set_compress};
val BASE:          Row = Row{flag: args.Flag{long: "base", short: 0, value: "address", repeat: false, negatable: false, help: "the image base (default: the target's)"}, placement: true, set: set_base};
val SECTION:       Row = Row{flag: args.Flag{long: "section", short: 0, value: "name", repeat: true, negatable: false, help: "place this output section ahead of the rest, in the order named, once per section"}, placement: true, set: set_section};
val REGION:        Row = Row{flag: args.Flag{long: "region", short: 0, value: "name,origin,length,rwx", repeat: true, negatable: false, help: "state a memory region: its name, start, size in bytes and the access it allows of r, w and x, once per region"}, placement: true, set: set_region};
val RUN_REGION:    Row = Row{flag: args.Flag{long: "run-region", short: 0, value: "section,region", repeat: true, negatable: false, help: "run this output section in this region, once per section"}, placement: true, set: set_run_region};
val LOAD_REGION:   Row = Row{flag: args.Flag{long: "load-region", short: 0, value: "section,region", repeat: true, negatable: false, help: "load this output section's bytes in this region, where it runs when not given, once per section"}, placement: true, set: set_load_region};
val OFFSET:        Row = Row{flag: args.Flag{long: "offset", short: 0, value: "section,offset", repeat: true, negatable: false, help: "start this output section at this offset from the start of the region it runs in, from the image base when it runs in none, once per section"}, placement: true, set: set_offset};
val SIZE:          Row = Row{flag: args.Flag{long: "size", short: 0, value: "bytes", repeat: false, negatable: false, help: "the most bytes the image loads from its base, refusing a larger one, and a flat image is padded to exactly this many"}, placement: true, set: set_size};
val FILL:          Row = Row{flag: args.Flag{long: "fill", short: 0, value: "byte", repeat: false, negatable: false, help: "the byte every byte of a flat image no section loads holds, zero when not given"}, placement: true, set: set_fill};
val STACK_RESERVE: Row = Row{flag: args.Flag{long: "stack-reserve", short: 0, value: "bytes", repeat: false, negatable: false, help: "the stack bytes to reserve (default: the target's)"}, placement: false, set: set_stack_reserve};
val STACK_COMMIT:  Row = Row{flag: args.Flag{long: "stack-commit", short: 0, value: "bytes", repeat: false, negatable: false, help: "the stack bytes to commit (default: the target's)"}, placement: false, set: set_stack_commit};
val LIBRARY:       Row = Row{flag: args.Flag{long: "library", short: 'l', value: "name", repeat: true, negatable: false, help: "link this library where it stands among the inputs"}, placement: false, set: set_library};
val FRAMEWORK:     Row = Row{flag: args.Flag{long: "framework", short: 0, value: "name", repeat: true, negatable: false, help: "link this framework where it stands among the inputs"}, placement: false, set: set_framework};
val LIBRARY_DIR:   Row = Row{flag: args.Flag{long: "library-dir", short: 'L', value: "dir", repeat: true, negatable: false, help: "search this directory for libraries first"}, placement: false, set: set_library_dir};
val FRAMEWORK_DIR: Row = Row{flag: args.Flag{long: "framework-dir", short: 'F', value: "dir", repeat: true, negatable: false, help: "search this directory for frameworks first"}, placement: false, set: set_framework_dir};
val SYSROOT:       Row = Row{flag: args.Flag{long: "sysroot", short: 0, value: "path", repeat: false, negatable: false, help: "search the system's directories under this root"}, placement: false, set: set_sysroot};
val AS_NEEDED:     Row = Row{flag: args.Flag{long: "as-needed", short: 0, value: nil, repeat: true, negatable: true, help: "load the libraries after it only when used (default: the target's)"}, placement: false, set: set_as_needed};
val LIBRARY_KIND:  Row = Row{flag: args.Flag{long: "library-kind", short: 0, value: "shared|static", repeat: true, negatable: false, help: "take the libraries after it only as this kind"}, placement: false, set: set_library_kind};
val TIMING_MODE:   Row = Row{flag: args.Flag{long: "require-timing-mode", short: 0, value: nil, repeat: false, negatable: true, help: "require the data independent timing mode"}, placement: false, set: set_timing_mode};
val LAYOUT:        Row = Row{flag: args.Flag{long: "layout", short: 0, value: "path", repeat: false, negatable: false, help: "read placement from this layout file"}, placement: false, set: set_layout};

val ROW_COUNT: usize           = 39;
val ROWS:      [ROW_COUNT]*Row = [ROW_COUNT]*Row{?OUTPUT, ?INTERFACE, ?KIND, ?LINKAGE, ?TARGET, ?ENV, ?ABI, ?ISA, ?EXT, ?CODE_MODEL, ?FORMAT, ?SYS_VERSION, ?SDK_VERSION, ?SUBSYSTEM, ?ENTRY, ?KEEP, ?GC_SECTIONS, ?TEMPORARIES, ?TAIL_MERGE, ?COMPRESS, ?BASE, ?SECTION, ?REGION, ?RUN_REGION, ?LOAD_REGION, ?OFFSET, ?SIZE, ?FILL, ?STACK_RESERVE, ?STACK_COMMIT, ?LIBRARY, ?FRAMEWORK, ?LIBRARY_DIR, ?FRAMEWORK_DIR, ?SYSROOT, ?AS_NEEDED, ?LIBRARY_KIND, ?TIMING_MODE, ?LAYOUT};

# every flag of a link in help order, the help flag first
val FLAG_COUNT: usize                  = 32;
val FLAGS:      [FLAG_COUNT]*args.Flag = [FLAG_COUNT]*args.Flag{?context.HELP, ?OUTPUT.flag, ?INTERFACE.flag, ?KIND.flag, ?LINKAGE.flag, ?TARGET.flag, ?ENV.flag, ?ABI.flag, ?ISA.flag, ?EXT.flag, ?CODE_MODEL.flag, ?FORMAT.flag, ?SYS_VERSION.flag, ?SDK_VERSION.flag, ?SUBSYSTEM.flag, ?ENTRY.flag, ?KEEP.flag, ?GC_SECTIONS.flag, ?TEMPORARIES.flag, ?TAIL_MERGE.flag, ?COMPRESS.flag, ?STACK_RESERVE.flag, ?STACK_COMMIT.flag, ?LIBRARY.flag, ?FRAMEWORK.flag, ?LIBRARY_DIR.flag, ?FRAMEWORK_DIR.flag, ?SYSROOT.flag, ?AS_NEEDED.flag, ?LIBRARY_KIND.flag, ?TIMING_MODE.flag, ?LAYOUT.flag};

# the link's flags, which the command that runs a link lists
val LIST: Slice[*args.Flag] = Slice[*args.Flag]{data: ?FLAGS[0], size: FLAG_COUNT};

fun bad_value(f: Fail, value: str) err[Fail] {
    ret err[Fail].err{fail.about(f, value)};
}

fun set_output(c: *Command, v: str, on: bool) err[Fail] {
    c.options.output = v;
    ret err[Fail].ok{};
}

fun set_interface(c: *Command, v: str, on: bool) err[Fail] {
    c.interface = v;
    ret err[Fail].ok{};
}

fun set_kind(c: *Command, v: str, on: bool) err[Fail] {
    val k: res[Spelled, Fail] = output.spelled(v);
    if (sel k.err) { ret bad_value(k.err, v); }
    c.kind = opt[Spelled].some{k.ok};
    ret err[Fail].ok{};
}

fun set_linkage(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.linkage = v;
    ret err[Fail].ok{};
}

fun set_format(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.format = v;
    ret err[Fail].ok{};
}

fun set_target(c: *Command, v: str, on: bool) err[Fail] {
    c.target = v;
    ret err[Fail].ok{};
}

fun set_env(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.env = v;
    ret err[Fail].ok{};
}

fun set_abi(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.abi = v;
    ret err[Fail].ok{};
}

fun set_isa(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.isa = v;
    ret err[Fail].ok{};
}

fun set_ext(c: *Command, v: str, on: bool) err[Fail] {
    val p: err[Fail] = vectors.push[str](?c.ext, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_code_model(c: *Command, v: str, on: bool) err[Fail] {
    c.narrowing.code_model = v;
    ret err[Fail].ok{};
}

fun set_sys_version(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[Version, Fail] = version(v);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    c.options.version = opt[Version].some{r.ok};
    ret err[Fail].ok{};
}

fun set_sdk_version(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[Version, Fail] = version(v);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    c.options.sdk = opt[Version].some{r.ok};
    ret err[Fail].ok{};
}

fun set_subsystem(c: *Command, v: str, on: bool) err[Fail] {
    val r: res[*Subsystem, Fail] = subsystem.by_name(v);
    if (sel r.err) { ret bad_value(r.err, v); }
    c.options.subsystem = opt[*Subsystem].some{r.ok};
    ret err[Fail].ok{};
}

fun set_entry(c: *Command, v: str, on: bool) err[Fail] {
    c.options.entry = v;
    ret err[Fail].ok{};
}

fun set_keep(c: *Command, v: str, on: bool) err[Fail] {
    val p: err[Fail] = vectors.push[str](?c.keep, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_gc_sections(c: *Command, v: str, on: bool) err[Fail] {
    c.options.gc_sections = opt[bool].some{on};
    ret err[Fail].ok{};
}

fun set_temporaries(c: *Command, v: str, on: bool) err[Fail] {
    c.options.keep_temporaries = opt[bool].some{on};
    ret err[Fail].ok{};
}

fun set_tail_merge(c: *Command, v: str, on: bool) err[Fail] {
    c.options.tail_merge = opt[bool].some{on};
    ret err[Fail].ok{};
}

fun set_compress(c: *Command, v: str, on: bool) err[Fail] {
    if (str_equals(v, "none")) {
        c.options.compress = opt[*Method].none{};
        ret err[Fail].ok{};
    }
    val m: res[*Method, Fail] = compress.by_name(v);
    if (sel m.err) { ret err[Fail].err{m.err}; }
    val w: err[Fail] = compress.writes(m.ok);
    if (sel w.err) { ret bad_value(w.err, v); }
    c.options.compress = opt[*Method].some{m.ok};
    ret err[Fail].ok{};
}

# the number `v` writes, in decimal or after a 0x, 0o or 0b prefix
fun number(v: str) res[u64, Fail] {
    val n: res[u64, ParseError] = parse_u64_exact(v, 0);
    if (sel n.err) {
        val e: ParseError = n.err;
        if (sel e.overflow) { ret res[u64, Fail].err{fail.about(fail.overflow("a number does not fit in 64 bits"), v)}; }
        ret res[u64, Fail].err{fail.about(fail.malformed("a number is written in decimal or after a 0x, 0o or 0b prefix"), v)};
    }
    ret res[u64, Fail].ok{n.ok};
}

fun set_base(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    c.options.base = opt[u64].some{n.ok};
    ret err[Fail].ok{};
}

fun set_section(c: *Command, v: str, on: bool) err[Fail] {
    val p: err[Fail] = vectors.push[str](?c.sections, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the most fields a value holds
val FIELDS: usize = 4;

# split `v` into `n` fields, two or more, at its last `n - 1` commas into
# `out`, the last
# borrowed from `v` and every other copied into the command's pieces. a
# value with fewer commas or an empty field is refused as `grammar` states
fun fields(c: *Command, v: str, n: usize, grammar: str, out: *str) err[Fail] {
    val len:  usize = str_len(v);
    var stop: usize = len;
    var k:    usize = n;
    for (k > 1) {
        var at:    usize = stop;
        var found: bool  = false;
        for (at > 0 && !found) {
            at = at - 1;
            if (v[at] == ',') { found = true; }
        }
        if (!found || at + 1 == stop) { ret bad_value(fail.malformed(grammar), v); }
        if (k == n)                   { out[k - 1] = (?v[at + 1])::str; }
        or {
            val p: res[str, Fail] = piece(c, v, at + 1, stop - at - 1);
            if (sel p.err) { ret err[Fail].err{p.err}; }
            out[k - 1] = p.ok;
        }
        stop = at;
        k    = k - 1;
    }
    if (stop == 0) { ret bad_value(fail.malformed(grammar), v); }
    val p: res[str, Fail] = piece(c, v, 0, stop);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    out[0] = p.ok;
    ret err[Fail].ok{};
}

# the `len` bytes of `v` from `at`, copied with a zero after them into the
# command's pieces
fun piece(c: *Command, v: str, at: usize, len: usize) res[str, Fail] {
    val s: res[str, StrError] = str_copy_slice(c.a, v, at, len);
    if (sel s.err) {
        val e: StrError = s.err;
        if (sel e.alloc) { ret res[str, Fail].err{fail.refused(e.alloc)}; }
        ret res[str, Fail].err{fail.internal("a field lies outside its value")};
    }
    val p: err[Fail] = vectors.push[str](?c.pieces, s.ok);
    if (sel p.err) {
        val d: err[A.Error] = A.deallocate[char](c.a, s.ok, len + 1);
        ret res[str, Fail].err{p.err};
    }
    ret res[str, Fail].ok{s.ok};
}

# the access `v` writes as r, w and x, each at most once
fun access(v: str) res[u8, Fail] {
    var bits: u8    = 0;
    var i:    usize = 0;
    for (v[i] != 0) {
        var bit: u8 = 0;
        if (v[i] == 'r')                   { bit = layout.READABLE; }
        or (v[i] == 'w')                   { bit = layout.WRITABLE; }
        or (v[i] == 'x')                   { bit = layout.EXECUTABLE; }
        if (bit == 0 || (bits & bit) != 0) { ret res[u8, Fail].err{fail.about(fail.malformed("a region's access is some of r, w and x, each once"), v)}; }
        bits = bits | bit;
        i    = i + 1;
    }
    if (bits == 0) { ret res[u8, Fail].err{fail.about(fail.malformed("a region's access is some of r, w and x, each once"), v)}; }
    ret res[u8, Fail].ok{bits};
}

fun set_region(c: *Command, v: str, on: bool) err[Fail] {
    var f: [FIELDS]str;
    val s: err[Fail] = fields(c, v, 4, "a region is `name,origin,length,access`", ?f[0]);
    if (sel s.err) { ret s; }
    val origin: res[u64, Fail] = number(f[1]);
    if (sel origin.err) { ret err[Fail].err{origin.err}; }
    val length: res[u64, Fail] = number(f[2]);
    if (sel length.err) { ret err[Fail].err{length.err}; }
    val bits: res[u8, Fail] = access(f[3]);
    if (sel bits.err) { ret err[Fail].err{bits.err}; }
    val p: err[Fail] = vectors.push[Area](?c.regions, Area{name: f[0], origin: origin.ok, length: length.ok, access: bits.ok});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the section and the region's name `v` states, into `into`
fun named_region(c: *Command, v: str, into: *Vector[Named]) err[Fail] {
    var f: [FIELDS]str;
    val s: err[Fail] = fields(c, v, 2, "a section in a region is `section,region`", ?f[0]);
    if (sel s.err) { ret s; }
    val p: err[Fail] = vectors.push[Named](into, Named{section: f[0], region: f[1]});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_run_region(c: *Command, v: str, on: bool) err[Fail] {
    ret named_region(c, v, ?c.runs);
}

fun set_load_region(c: *Command, v: str, on: bool) err[Fail] {
    ret named_region(c, v, ?c.loads);
}

fun set_offset(c: *Command, v: str, on: bool) err[Fail] {
    var f: [FIELDS]str;
    val s: err[Fail] = fields(c, v, 2, "a section's offset is `section,offset`", ?f[0]);
    if (sel s.err) { ret s; }
    val n: res[u64, Fail] = number(f[1]);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val p: err[Fail] = vectors.push[Offset](?c.offsets, Offset{section: f[0], offset: n.ok});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_timing_mode(c: *Command, v: str, on: bool) err[Fail] {
    c.options.timing_mode = on;
    ret err[Fail].ok{};
}

fun set_size(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    c.options.size = opt[u64].some{n.ok};
    ret err[Fail].ok{};
}

fun set_fill(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err)   { ret err[Fail].err{n.err}; }
    if (n.ok > 0xff) { ret bad_value(fail.overflow("a fill is one byte"), v); }
    c.options.fill = opt[u8].some{n.ok::u8};
    ret err[Fail].ok{};
}

fun set_stack_reserve(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    c.options.stack_reserve = opt[u64].some{n.ok};
    ret err[Fail].ok{};
}

fun set_stack_commit(c: *Command, v: str, on: bool) err[Fail] {
    val n: res[u64, Fail] = number(v);
    if (sel n.err) { ret err[Fail].err{n.err}; }
    c.options.stack_commit = opt[u64].some{n.ok};
    ret err[Fail].ok{};
}

# read the layout file at `v` and apply each of its lines through its key's row
fun set_layout(c: *Command, v: str, on: bool) err[Fail] {
    val r: err[Fail] = plan.read(?c.plan, c.a, v);
    if (sel r.err) { ret r; }
    var i: usize = 0;
    for (i < vector.length[plan.Line](?c.plan.lines)) {
        val l: *plan.Line = ?c.plan.lines.data[i];
        val s: err[Fail]  = stated(c, l);
        if (sel s.err) { ret err[Fail].err{fail.in_file(fail.in_indexed(s.err, "line", l.line), v)}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the index of the row whose long name is `key`
fun key_row(key: str) opt[usize] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].flag.long, key)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# apply the layout line `l` through the placement row its key names, counted
# with the flags' occurrences of that row
fun stated(c: *Command, l: *plan.Line) err[Fail] {
    val k: opt[usize] = key_row(l.key);
    if (sel k.none) { ret bad_value(fail.malformed("a layout key names a placement"), l.key); }
    val row: *Row = ROWS[k.some];
    if (!row.placement) { ret bad_value(fail.malformed("a layout key names a placement"), l.key); }
    val takes: bool = args.takes_value(?row.flag);
    if (!takes && l.value != nil) { ret bad_value(fail.malformed("a switch takes no value"), l.key); }
    if (takes && l.value == nil)  { ret bad_value(fail.malformed("needs a value"), l.key); }
    val given: usize = args.occurrences(c.line, ?row.flag) + c.stated[k.some];
    if (!row.flag.repeat && given != 0) { ret bad_value(fail.malformed("given more than once"), l.key); }
    c.stated[k.some] = c.stated[k.some] + 1;
    ret row.set(c, l.value, true);
}

# append the request `r` to the inputs, where it stands among them
fun named(c: *Command, r: Request) err[Fail] {
    val p: err[Fail] = vectors.push[Request](?c.inputs, r);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_library(c: *Command, v: str, on: bool) err[Fail] {
    ret named(c, Request.library{Wanted{form: Form.system{}, name: v, include: c.include, prefer: c.prefer}});
}

fun set_framework(c: *Command, v: str, on: bool) err[Fail] {
    ret named(c, Request.library{Wanted{form: Form.framework{}, name: v, include: c.include, prefer: c.prefer}});
}

fun set_library_dir(c: *Command, v: str, on: bool) err[Fail] {
    val p: err[Fail] = vectors.push[str](?c.libdirs, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_framework_dir(c: *Command, v: str, on: bool) err[Fail] {
    val p: err[Fail] = vectors.push[str](?c.fwdirs, v);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun set_sysroot(c: *Command, v: str, on: bool) err[Fail] {
    c.options.sysroot = v;
    ret err[Fail].ok{};
}

fun set_as_needed(c: *Command, v: str, on: bool) err[Fail] {
    if (on) { c.include = Include.referenced{}; }
    or      { c.include = Include.always{}; }
    ret err[Fail].ok{};
}

fun set_library_kind(c: *Command, v: str, on: bool) err[Fail] {
    if (str_equals(v, "shared")) { c.prefer = Prefer.shared_only{}; }
    or (str_equals(v, "static")) { c.prefer = Prefer.static_only{}; }
    or                           { ret err[Fail].err{fail.about(fail.malformed("--library-kind takes shared or static"), v)}; }
    ret err[Fail].ok{};
}

# the decimal number of `text[at..]` up to a dot or the end, at most `max`,
# with `next` left at the byte after it
fun component(text: str, at: usize, max: u64, next: *usize) res[u64, Fail] {
    var i: usize = at;
    var n: u64   = 0;
    for (text[i] >= '0' && text[i] <= '9') {
        n = n * 10 + (text[i] - '0')::u64;
        if (n > max) { ret res[u64, Fail].err{fail.overflow("a version component is too large")}; }
        i = i + 1;
    }
    if (i == at) { ret res[u64, Fail].err{fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal")}; }
    @next = i;
    ret res[u64, Fail].ok{n};
}

# the version `text` writes as `major.minor` or `major.minor.patch`, a patch
# not written being zero as the notation states
fun version(text: str) res[Version, Fail] {
    var at:    usize          = 0;
    val major: res[u64, Fail] = component(text, at, 0xffff, ?at);
    if (sel major.err)   { ret res[Version, Fail].err{fail.about(major.err, text)}; }
    if (text[at] != '.') { ret res[Version, Fail].err{fail.about(fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal"), text)}; }
    val minor: res[u64, Fail] = component(text, at + 1, 0xff, ?at);
    if (sel minor.err) { ret res[Version, Fail].err{fail.about(minor.err, text)}; }
    var patch: u64 = 0;
    if (text[at] == '.') {
        val p: res[u64, Fail] = component(text, at + 1, 0xff, ?at);
        if (sel p.err) { ret res[Version, Fail].err{fail.about(p.err, text)}; }
        patch = p.ok;
    }
    if (text[at] != 0) { ret res[Version, Fail].err{fail.about(fail.malformed("a version is `major.minor` or `major.minor.patch` in decimal"), text)}; }
    ret res[Version, Fail].ok{Version{major: major.ok::u16, minor: minor.ok::u8, patch: patch::u8}};
}

fun needs(row: *Row) err[Fail] {
    ret err[Fail].err{fail.in_record(fail.malformed("the link needs this flag"), row.flag.long)};
}

# the row whose canonical flag is `f`, none for a flag of another table the
# command composes. a scan of the rows, the cost std.args pays per token too
fun row_of(f: *args.Flag) opt[*Row] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (?ROWS[i].flag == f) { ret opt[*Row].some{ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# the refusal `r` of the target, kept for the caller to write whole and
# given back as a failure
fun refuse(c: *Command, r: Refusal) err[Fail] {
    var kept: Refusal = r;
    c.refused = opt[Refusal].some{r};
    ret err[Fail].err{target.as_fail(?kept)};
}

# resolve the target under the narrowing
fun targeted(c: *Command) err[Fail] {
    if (c.target == nil) { ret needs(?TARGET); }
    val spec: res[Spec, Refusal] = target.parse(c.target);
    if (sel spec.err) { ret refuse(c, spec.err); }
    val linked: err[Fail] = linked_only(c);
    if (sel linked.err) { ret linked; }
    c.narrowing.ext       = c.ext.data;
    c.narrowing.ext_count = vector.length[str](?c.ext);
    val t: res[target.Target, Refusal] = target.resolve(spec.ok, ?c.narrowing);
    if (sel t.err) { ret refuse(c, t.err); }
    c.options.target = t.ok;
    ret made_of(c, ?c.options.target);
}

# refuse a linkage given with a kind other than the executables, naming both,
# as only an executable is linked as one
fun linked_only(c: *Command) err[Fail] {
    val given: str          = c.narrowing.linkage;
    val kind:  opt[Spelled] = c.kind;
    if (given == nil)  { ret err[Fail].ok{}; }
    if (sel kind.none) { ret err[Fail].ok{}; }
    val spelled: Spelled = kind.some;
    if (sel spelled.executable) { ret err[Fail].ok{}; }
    val both: res[str, StrError] = str_join(c.a, "--kind ", spelled.row.spelled, " --linkage ", given);
    if (sel both.err) {
        val e: StrError = both.err;
        if (sel e.alloc) { ret err[Fail].err{fail.refused(e.alloc)}; }
        ret err[Fail].err{fail.internal("the refusal's subject could not be joined")};
    }
    val kept: err[Fail] = vectors.push[str](?c.pieces, both.ok);
    if (sel kept.err) {
        val d: err[A.Error] = A.deallocate[char](c.a, both.ok, str_len(both.ok) + 1);
        ret err[Fail].err{kept.err};
    }
    ret err[Fail].err{fail.about(fail.malformed("a linkage applies only to --kind bin, as only an executable is linked as one"), both.ok)};
}

# the output kind `--kind` resolves to on `t`: an executable's the target's
# linkage picks, and any other the one row it spells
fun made_of(c: *Command, t: *target.Target) err[Fail] {
    val kind: opt[Spelled] = c.kind;
    if (sel kind.none) { ret needs(?KIND); }
    val spelled: Spelled = kind.some;
    if (sel spelled.row) {
        c.options.kind = spelled.row;
        ret err[Fail].ok{};
    }
    val l: res[*Kind, Refusal] = target.executable(t);
    if (sel l.err) { ret refuse(c, l.err); }
    c.options.kind = l.ok;
    ret err[Fail].ok{};
}

# check what the flags stated together, and resolve the target
fun finish(c: *Command) err[Fail] {
    val t: err[Fail] = targeted(c);
    if (sel t.err)                              { ret t; }
    if (c.options.output == nil)                { ret needs(?OUTPUT); }
    if (vector.length[Request](?c.inputs) == 0) { ret err[Fail].err{fail.malformed("the link names no input file")}; }
    c.options.keep          = c.keep.data;
    c.options.keep_count    = vector.length[str](?c.keep);
    c.options.sections      = c.sections.data;
    c.options.section_count = vector.length[str](?c.sections);
    c.options.libdirs       = c.libdirs.data;
    c.options.libdir_count  = vector.length[str](?c.libdirs);
    c.options.fwdirs        = c.fwdirs.data;
    c.options.fwdir_count   = vector.length[str](?c.fwdirs);
    ret placements(c);
}

fun name_hash(k: *str) u64 {
    ret fnv1a.step_bytes(fnv1a.FNV_INIT, (@k)::*u8, str_len(@k));
}

fun name_equal(a: *str, b: *str) bool {
    ret str_equals(@a, @b);
}

# resolve the regions the runs and the loads name against the regions
# stated, each region stated once, and hand the statements to the options
fun placements(c: *Command) err[Fail] {
    var by: MapBy[str, usize] = map.init_by[str, usize](c.a, name_hash, name_equal);
    val r:  err[Fail]         = resolved(c, ?by);
    val d:  err[A.Error]      = map.dnit_by[str, usize](?by);
    if (sel r.err) { ret r; }
    if (sel d.err) { ret err[Fail].err{fail.refused(d.err)}; }
    c.options.regions      = c.regions.data;
    c.options.region_count = vector.length[Area](?c.regions);
    c.options.runs         = c.ran.data;
    c.options.run_count    = vector.length[Within](?c.ran);
    c.options.loads        = c.loaded.data;
    c.options.load_count   = vector.length[Within](?c.loaded);
    c.options.offsets      = c.offsets.data;
    c.options.offset_count = vector.length[Offset](?c.offsets);
    ret err[Fail].ok{};
}

fun resolved(c: *Command, by: *MapBy[str, usize]) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Area](?c.regions)) {
        val name: str                = c.regions.data[i].name;
        val put:  res[bool, A.Error] = map.insert_by[str, usize](by, name, i);
        if (sel put.err) { ret err[Fail].err{fail.refused(put.err)}; }
        if (!put.ok)     { ret err[Fail].err{fail.in_record(fail.about(fail.malformed("a region is stated more than once"), name), REGION.flag.long)}; }
        i = i + 1;
    }
    val rs: err[Fail] = within(by, ?c.runs, RUN_REGION.flag.long, ?c.ran);
    if (sel rs.err) { ret rs; }
    ret within(by, ?c.loads, LOAD_REGION.flag.long, ?c.loaded);
}

# each statement of `from` with its region resolved through `by`, into `out`
fun within(by: *MapBy[str, usize], from: *Vector[Named], flag: str, out: *Vector[Within]) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Named](from)) {
        val n:     *Named      = ?from.data[i];
        var probe: str         = n.region;
        val found: opt[*usize] = map.get_by[str, usize](by, ?probe);
        if (sel found.none) { ret err[Fail].err{fail.in_record(fail.about(fail.malformed("names no region the link states"), n.region), flag)}; }
        val p: err[Fail] = vectors.push[Within](out, Within{section: n.section, region: @found.some});
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# read the command line `line` into `c`, whose tables live in `alloc` and
# whose formats are those of `g`. `line` is read against a command that
# lists LIST, without a refusal and not asking for help, and the help flag is
# left to the caller. a flag that does not repeat given twice is refused. `c` is released by release whether
# or not reading succeeds
fun parse(c: *Command, alloc: *A.Allocator, g: *Registry, line: *args.Parsed) err[Fail] {
    @c = Command{
        a:        alloc,
        registry: g,
        inputs:   vector.init[Request](alloc),
        keep:     vector.init[str](alloc),
        sections: vector.init[str](alloc),
        regions:  vector.init[Area](alloc),
        runs:     vector.init[Named](alloc),
        loads:    vector.init[Named](alloc),
        ran:      vector.init[Within](alloc),
        loaded:   vector.init[Within](alloc),
        offsets:  vector.init[Offset](alloc),
        pieces:   vector.init[str](alloc),
        plan:     plan.make(alloc),
        line:     line,
        libdirs:  vector.init[str](alloc),
        fwdirs:   vector.init[str](alloc),
        ext:      vector.init[str](alloc),
        found:    search.make(alloc),
    };
    if (sel line.refusal.some) { ret err[Fail].err{fail.internal("the link reads a command line std.args refused")}; }
    var once: usize = 0;
    for (once < ROW_COUNT) {
        val row: *Row = ROWS[once];
        once = once + 1;
        if (!row.flag.repeat && args.occurrences(line, ?row.flag) > 1) { ret err[Fail].err{fail.in_record(fail.malformed("given more than once"), row.flag.long)}; }
    }
    var w: args.Walk = args.walk(line);
    for {
        val e: args.Event = args.step(?w);
        if (sel e.done) { brk; }
        if (sel e.operand) {
            val p: err[Fail] = named(c, Request.file{File{path: line.args.argv[e.operand]::str, include: c.include}});
            if (sel p.err) { ret p; }
        }
        or (sel e.hit) {
            val row: opt[*Row] = row_of(e.hit.flag);
            if (sel row.some) {
                val s: err[Fail] = row.some.set(c, e.hit.value, e.hit.on);
                if (sel s.err) { ret err[Fail].err{fail.in_record(s.err, row.some.flag.long)}; }
            }
        }
    }
    ret finish(c);
}

# give back the command's tables
fun release(c: *Command) err[Fail] {
    var first: err[Fail] = vectors.release[Request](?c.inputs);
    first = fail.kept(first, vectors.release[str](?c.keep));
    first = fail.kept(first, vectors.release[str](?c.sections));
    first = fail.kept(first, vectors.release[Area](?c.regions));
    first = fail.kept(first, vectors.release[Named](?c.runs));
    first = fail.kept(first, vectors.release[Named](?c.loads));
    first = fail.kept(first, vectors.release[Within](?c.ran));
    first = fail.kept(first, vectors.release[Within](?c.loaded));
    first = fail.kept(first, vectors.release[Offset](?c.offsets));
    first = fail.kept(first, vectors.release[str](?c.libdirs));
    first = fail.kept(first, vectors.release[str](?c.fwdirs));
    first = fail.kept(first, vectors.release[str](?c.ext));
    first = fail.kept(first, search.release(?c.found));
    var i: usize = 0;
    for (i < vector.length[str](?c.pieces)) {
        val s: str          = c.pieces.data[i];
        val d: err[A.Error] = A.deallocate[char](c.a, s, str_len(s) + 1);
        if (sel d.err) { first = fail.kept(first, err[Fail].err{fail.refused(d.err)}); }
        i = i + 1;
    }
    first = fail.kept(first, vectors.release[str](?c.pieces));
    ret fail.kept(first, plan.release(?c.plan));
}

# the command
pub val COMMAND: args.Command = args.Command{
    name:        "link",
    help:        "link input files into one image",
    usage:       "<input>... -o <path> -t <sys>-<arch> -k <kind>",
    flags:       LIST,
    operand_min: 0,
    operand_max: args.OPERANDS_ANY,
};

# link the input files the command line names into the image it names. a
# refused target is printed with what its part accepts, and a refused link
# before the notes that explain it
# ---
# r:   the run context
# ret: EXIT_OK, or the code of reporting why the link failed
pub fun run(r: *Run) i64 {
    var c: Command;
    val p: err[Fail] = parse(?c, r.a, r.reg, r.line);

    if (sel p.err) {
        var code: i64 = 0;
        if (sel c.refused.some) { code = context.refuse_target(r.a, ?c.refused.some); }
        or                      { code = context.report(r.a, p.err); }
        val dropped: err[Fail] = release(?c);
        ret code;
    }

    # the command line is valid, so link the input files into the output file
    var notes: Sink                   = sink.make(r.a, LITTLE);
    var out:   res[Written, Detached] = state.link(?c.found, c.registry, c.options, c.inputs.data, vector.length[Request](?c.inputs), ?notes);
    if (sel out.err) {
        val refused: Fail      = fail.view(?out.err);
        var code:    i64       = context.report(r.a, refused);
        val shown:   err[Fail] = file.emit(fs.STDERR, ?notes);
        if (sel shown.err) { code = context.report(r.a, shown.err); }

        ret code;
    }

    val shown: err[Fail] = file.emit(fs.STDERR, ?notes);
    if (sel shown.err) { ret context.report(r.a, shown.err); }

    var written: Written   = out.ok;
    val sv:      err[Fail] = save(?c, ?written);
    if (sel sv.err) { ret context.report(r.a, sv.err); }

    ret context.EXIT_OK;
}

# write the image to the output path, and its interface file to the path the
# command line names for it, refused for an image that has none
fun save(c: *Command, written: *Written) err[Fail] {
    var mode: i32 = file.MODE;
    if (output.has(c.options.kind, output.ENTERED) || output.has(c.options.kind, output.LOADED)) { mode = file.RUNNABLE; }

    val sv: err[Fail] = file.save_mode(c.options.output, ?written.image, mode);
    if (sel sv.err)         { ret sv; }
    if (c.interface == nil) { ret err[Fail].ok{}; }
    if (sel written.interface.none) {
        ret err[Fail].err{fail.in_record(fail.unsupported("the image has no interface file, as what the link makes exports nothing or its format's links bind against the image itself"), c.options.kind.spelled)};
    }
    ret file.save(c.interface, ?written.interface.some);
}
