# `mink formats`: what mink does with each format it knows

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.args;
use std.collections.slice.Slice;

use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.cli.context;
use mink.cli.context.Run;
use mink.format.contract.Neutral;
use mink.format.registration;
use mink.format.registration.Registration;
use mink.format.registry;
use mink.link.formats;
use mink.link.formats.Entry;

val FLAG_COUNT: usize                  = 1;
val FLAGS:      [FLAG_COUNT]*args.Flag = [FLAG_COUNT]*args.Flag{?context.HELP};

# the command
pub val COMMAND: args.Command = args.Command{
    name:        "formats",
    help:        "list the formats mink knows and what it does with each",
    flags:       Slice[*args.Flag]{data: ?FLAGS[0], size: FLAG_COUNT},
    operand_min: 0,
    operand_max: 0,
};

val COLUMN_GAP:   usize = 2;
val HEAD_FORMAT:  str   = "format";
val HEAD_CODEC:   str   = "read/write";
val HEAD_NEUTRAL: str   = "neutral";
val HEAD_LINK:    str   = "link";
val HEAD_ARCHES:  str   = "architectures";

# print a table of every format and what mink does with it
# ---
# r:   the run context
# ret: EXIT_OK, or the code of reporting why the table could not be printed
pub fun run(r: *Run) i64 {
    var s: Sink = sink.make(r.a, LITTLE);

    # the format column is as wide as its widest name
    var width: usize = str_len(HEAD_FORMAT);
    var i:     usize = 0;
    for (i < registry.count(r.reg)) {
        val n: usize = str_len(registry.at(r.reg, i).format.name);
        if (n > width) { width = n; }

        i = i + 1;
    }

    val h: err[Fail] = header(?s, width);
    if (sel h.err) { ret context.report(r.a, h.err); }

    i = 0;
    for (i < registry.count(r.reg)) {
        val w: err[Fail] = row(?s, registry.at(r.reg, i), width);
        if (sel w.err) { ret context.report(r.a, w.err); }

        i = i + 1;
    }

    ret context.emit(r.a, ?s);
}

# the column names
fun header(s: *Sink, width: usize) err[Fail] {
    val wf: err[Fail] = cell(s, HEAD_FORMAT, width);
    if (sel wf.err) { ret wf; }

    val wc: err[Fail] = cell(s, HEAD_CODEC, str_len(HEAD_CODEC));
    if (sel wc.err) { ret wc; }

    val wn: err[Fail] = cell(s, HEAD_NEUTRAL, str_len(HEAD_NEUTRAL));
    if (sel wn.err) { ret wn; }

    val wl: err[Fail] = cell(s, HEAD_LINK, str_len(HEAD_LINK));
    if (sel wl.err) { ret wl; }

    val wa: err[Fail] = sink.text(s, HEAD_ARCHES);
    if (sel wa.err) { ret wa; }

    ret sink.text(s, "\n");
}

# one format's line: its name, a yes or no per capability, its architectures
fun row(s: *Sink, reg: *Registration, width: usize) err[Fail] {
    val wf: err[Fail] = cell(s, reg.format.name, width);
    if (sel wf.err) { ret wf; }

    val wc: err[Fail] = cell(s, yes_no(sel reg.reader.some), str_len(HEAD_CODEC));
    if (sel wc.err) { ret wc; }

    val neutral: opt[*Neutral] = registration.neutral(reg);
    val wn:      err[Fail]     = cell(s, yes_no(sel neutral.some), str_len(HEAD_NEUTRAL));
    if (sel wn.err) { ret wn; }

    val links: res[*Entry, Fail] = formats.of(reg.format);
    val wl:    err[Fail]         = cell(s, yes_no(sel links.ok), str_len(HEAD_LINK));
    if (sel wl.err) { ret wl; }

    val wa: err[Fail] = arches(s, reg);
    if (sel wa.err) { ret wa; }

    ret sink.text(s, "\n");
}

# the architectures of a format's pairs, each once, `-` when it has none
fun arches(s: *Sink, reg: *Registration) err[Fail] {
    if (reg.pair_count == 0) { ret sink.text(s, "-"); }

    var i: usize = 0;
    for (i < reg.pair_count) {
        # a format may pair one architecture more than once, name it the first time
        var seen: bool  = false;
        var k:    usize = 0;
        for (k < i && !seen) {
            seen = reg.pairs[k].arch == reg.pairs[i].arch;
            k    = k + 1;
        }

        if (!seen) {
            if (i != 0) {
                val ws: err[Fail] = sink.text(s, " ");
                if (sel ws.err) { ret ws; }
            }

            val wa: err[Fail] = sink.text(s, reg.pairs[i].arch.name);
            if (sel wa.err) { ret wa; }
        }

        i = i + 1;
    }

    ret err[Fail].ok{};
}

# `text` padded with spaces to `width`, then the gap to the next column
fun cell(s: *Sink, text: str, width: usize) err[Fail] {
    val wt: err[Fail] = sink.text(s, text);
    if (sel wt.err) { ret wt; }

    ret sink.fill(s, ' ', width - str_len(text) + COLUMN_GAP);
}

fun yes_no(v: bool) str {
    if (v) { ret "yes"; }
    ret "no";
}
