# `mink dump`: print the model of a file field by field, or only the format
# its magic names

use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.args;

use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.cli.context;
use mink.cli.context.Run;
use mink.format.contract;
use mink.format.contract.Model;
use mink.format.file;
use mink.format.file.Loaded;
use mink.format.registration.Registration;
use mink.format.registry;

# the switch that asks for the format alone, which reads the magic and
# nothing else, so it names a file whose model does not read
val FORMAT_ONLY: args.FlagSpec = args.FlagSpec{name: "--format-only", value: "", arity: args.ARITY_FLAG, doc: "print only the name of the format the file's magic names, without reading the rest of it", default: "", negatable: false, occurs: args.Occurs.once{}, alias_of: nil};

val ROW_COUNT: usize                     = 1;
val ROWS:      [ROW_COUNT]*args.FlagSpec = [ROW_COUNT]*args.FlagSpec{?FORMAT_ONLY};

val TABLE: args.TableRef = args.TableRef{rows: ?ROWS[0], n: ROW_COUNT, accepted: nil, docs: nil};

# the command's registration
pub val SPEC: args.CommandSpec = args.CommandSpec{
    name:            "dump",
    id:              0,
    aliases:         nil,
    alias_n:         0,
    grammar:         " <file> [--format-only]",
    summary:         "print the model of an object file, field by field",
    effect:          "read a file as the format its magic names and print its model, one field per line, or with --format-only print only the format's name",
    exits:           nil,
    exit_n:          0,
    terminator:      "",
    tables:          ?TABLE,
    table_n:         1,
    refused:         nil,
    refused_n:       0,
    refusal:         "",
    relations:       nil,
    relation_n:      0,
    constraints:     nil,
    constraint_n:    0,
    operand_min:     1,
    operand_max:     1,
    truncate_at_sep: false,
    actions:         nil,
    action_n:        0,
    examples:        nil,
    example_n:       0
};

# load a file and print the name of the format its magic names
fun format_only(r: *Run, path: str) i64 {
    val l: res[Loaded, Fail] = file.load(r.a, path);
    if (sel l.err) { ret context.report(r.a, l.err); }

    var loaded: Loaded                   = l.ok;
    val reg:    res[*Registration, Fail] = registry.sniff(?r.reg, ?loaded.input);
    if (sel reg.err) { ret context.report(r.a, reg.err); }

    var s: Sink      = sink.make(r.a, LITTLE);
    val t: err[Fail] = sink.text(?s, reg.ok.format.name);
    if (sel t.err) { ret context.report(r.a, t.err); }

    val n: err[Fail] = sink.text(?s, "\n");
    if (sel n.err) { ret context.report(r.a, n.err); }

    ret context.emit(r.a, ?s);
}

# read a file, load it, read its model, and print the model field by field,
# or only the format its magic names
# ---
# r:   the run context
# ret: EXIT_OK, or the code of reporting why the model could not be read or printed
pub fun run(r: *Run) i64 {
    val path: opt[str] = context.operand(r, 0);
    if (sel path.none)                        { ret context.usage(r.a, SPEC.name, "takes the file to print"); }
    if (args.occurred(?r.line, ?FORMAT_ONLY)) { ret format_only(r, path.some); }

    var loaded: Loaded;
    var m:      Model;
    val code:   i64 = context.read_file(r, path.some, ?loaded, ?m);
    if (code != context.EXIT_OK) { ret code; }

    var s: Sink = sink.make(r.a, LITTLE);

    val d: err[Fail] = contract.describe(?m, ?r.reg.relocs, ?s);
    if (sel d.err) { ret context.report(r.a, d.err); }

    ret context.emit(r.a, ?s);
}
