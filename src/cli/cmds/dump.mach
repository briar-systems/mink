# `mink dump`: print the model of a file field by field, or only the format
# its magic names

use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.args;
use std.collections.slice.Slice;

use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.cli.context;
use mink.cli.context.Run;
use mink.format.contract;
use mink.format.file;
use mink.format.file.Loaded;
use mink.format.registration.Registration;
use mink.format.registry;
use mink.link.command;

# the switch that asks for the format alone, which reads the magic and
# nothing else, so it names a file whose model does not read
val FORMAT_ONLY: args.Flag = args.Flag{long: "format-only", short: 0, value: nil, repeat: false, negatable: false, help: "print only the file's format"};

val FLAG_COUNT: usize                  = 2;
val FLAGS:      [FLAG_COUNT]*args.Flag = [FLAG_COUNT]*args.Flag{?command.HELP, ?FORMAT_ONLY};

# the command
pub val COMMAND: args.Command = args.Command{
    name:        "dump",
    help:        "print a file's model, one field per line",
    usage:       "<file>",
    flags:       Slice[*args.Flag]{data: ?FLAGS[0], size: FLAG_COUNT},
    operand_min: 1,
    operand_max: 1,
};

# load a file and print the name of the format its magic names
fun format_only(r: *Run, path: str) i64 {
    val l: res[Loaded, Fail] = file.load(r.a, path);
    if (sel l.err) { ret context.report(r.a, l.err); }

    var loaded: Loaded                   = l.ok;
    val reg:    res[*Registration, Fail] = registry.sniff(r.reg, ?loaded.input);
    if (sel reg.err) { ret context.report(r.a, reg.err); }

    var s: Sink      = sink.make(r.a, LITTLE);
    val t: err[Fail] = sink.text(?s, reg.ok.format.name);
    if (sel t.err) { ret context.report(r.a, t.err); }

    val n: err[Fail] = sink.text(?s, "\n");
    if (sel n.err) { ret context.report(r.a, n.err); }

    ret context.emit(r.a, ?s);
}

# load a file, read its model, and print the model field by field,
# or only the format its magic names
# ---
# r:   the run context
# ret: EXIT_OK, or the code of reporting why the model could not be read or printed
pub fun run(r: *Run) i64 {
    val path: opt[str] = context.operand(r, 0);
    if (sel path.none)                    { ret context.usage(r.a, COMMAND.name, "takes the file to print"); }
    if (args.given(r.line, ?FORMAT_ONLY)) { ret format_only(r, path.some); }

    val l: res[registry.Loaded, Fail] = registry.load(r.reg, r.a, path.some);
    if (sel l.err) { ret context.report(r.a, l.err); }

    var loaded: registry.Loaded = l.ok;

    var s: Sink = sink.make(r.a, LITTLE);

    val d: err[Fail] = contract.describe(?loaded.model, ?r.reg.relocs, ?s);
    if (sel d.err) { ret context.report(r.a, d.err); }

    ret context.emit(r.a, ?s);
}
