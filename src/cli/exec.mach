# the oracle lane of static ELF executables, one link per run
#
# `exec <arch> <output> <input>...` links the input objects and archives into
# a static linux executable for the architecture named, with the system's
# entry symbol, and writes it to the output. the link's report goes to
# standard error. test/exec.sh drives it. it runs
# locally and is never part of CI.

use std.print;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.allocator.heap;
use fs: std.filesystem;

use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.format;
use mink.catalog.os;
use mink.catalog.output;
use mink.format.file;
use mink.format.file.Loaded;
use link_builtin: mink.link.builtin;
use mink.link.input.Source;
use mink.link.state;
use mink.link.state.Options;

val USAGE: str = "usage: exec <arch> <output> <input>...\n";

fun report(a: *A.Allocator, f: Fail) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val r: err[Fail] = diag.render(f, ?s);
    if (sel r.err) { ret 2; }
    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    ret 1;
}

# link the loaded inputs into the output
fun linked(a: *A.Allocator, argv: **u8, loaded: *Table[Loaded], sources: *Table[Source]) i64 {
    val target: res[*Arch, Fail] = arch.by_name(argv[1]);
    if (sel target.err) { ret report(a, fail.about(target.err, argv[1])); }
    val o: res[Options, Fail] = link_builtin.options(?output.STATIC, ?format.ELF, target.ok, ?os.LINUX);
    if (sel o.err) { ret report(a, o.err); }
    var i: usize = 0;
    for (i < table.count[Loaded](loaded)) {
        val p: res[table.Id[Source], Fail] = table.push[Source](sources, Source.bytes{table.at[Loaded](loaded, table.nth[Loaded](i)).input});
        if (sel p.err) { ret report(a, p.err); }
        i = i + 1;
    }
    var notes: Sink            = sink.make(a, LITTLE);
    var out:   res[Sink, Fail] = state.link(a, o.ok, table.items[Source](sources), table.count[Source](sources), ?notes);
    val shown: err[Fail]       = file.emit(fs.STDERR, ?notes);
    val rn:    err[Fail]       = sink.release(?notes);
    if (sel out.err)   { ret report(a, out.err); }
    if (sel shown.err) { ret report(a, shown.err); }
    if (sel rn.err)    { ret report(a, rn.err); }
    val sv: err[Fail] = file.save(argv[2], ?out.ok);
    val rl: err[Fail] = sink.release(?out.ok);
    if (sel sv.err) { ret report(a, sv.err); }
    if (sel rl.err) { ret report(a, rl.err); }
    ret 0;
}

fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    if (argc < 4) {
        print.print(USAGE);
        ret 2;
    }
    var loaded:  Table[Loaded] = table.make[Loaded](a);
    var sources: Table[Source] = table.make[Source](a);
    var code:    i64           = 0;
    var k:       i64           = 3;
    for (k < argc && code == 0) {
        val l: res[Loaded, Fail] = file.load(a, argv[k]);
        if (sel l.ok) {
            val p: res[table.Id[Loaded], Fail] = table.push[Loaded](?loaded, l.ok);
            if (sel p.err) { code = report(a, p.err); }
        }
        or (sel l.err) { code = report(a, l.err); }
        k = k + 1;
    }
    if (code == 0) { code = linked(a, argv, ?loaded, ?sources); }
    var i: usize = 0;
    for (i < table.count[Loaded](?loaded)) {
        val u: err[Fail] = file.unload(table.at[Loaded](?loaded, table.nth[Loaded](i)));
        i = i + 1;
    }
    val rl: err[Fail] = table.release[Loaded](?loaded);
    val rs: err[Fail] = table.release[Source](?sources);
    ret code;
}

# every allocation lives in the heap, which is given back whole when the run ends
pub fun main(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret 2; }
    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret 2; }
    val code: i64          = run(?a, argc, argv);
    val dn:   err[A.Error] = heap.dnit(?h);
    if (sel dn.err) { ret 2; }
    ret code;
}
