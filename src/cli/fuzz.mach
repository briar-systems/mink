# a reader that is not registered yet: its format, the magic that claims a
# file, and a read that releases what it made. a format found in the registry
# is read through its registration and its row here is ignored
rec Extra {
    format:    *Format;
    magic:     *u8;
    magic_len: usize;
    read:      fun(*A.Allocator, *Input) err[Fail];
}

val ELF_MAGIC: [4]u8 = [4]u8{0x7f, 'E', 'L', 'F'};
val MZ_MAGIC:  [2]u8 = [2]u8{'M', 'Z'};
val AR_MAGIC:  [7]u8 = [7]u8{'!', '<', 'a', 'r', 'c', 'h', '>'};

val EXTRA_COUNT: usize              = 2;
val EXTRA:       [EXTRA_COUNT]Extra = [EXTRA_COUNT]Extra{
    Extra{format: ?format.ELF, magic: ?ELF_MAGIC[0], magic_len: 4, read: read_elf},
    Extra{format: ?format.COFF, magic: ?MZ_MAGIC[0], magic_len: 2, read: read_coff},
};

val PROT_NONE: u32 = 0;

val EXIT_READ:    i64 = 0;
val EXIT_REFUSED: i64 = 1;
val EXIT_USAGE:   i64 = 2;
val EXIT_DEFECT:  i64 = 3;

fun read_elf(a: *A.Allocator, in: *Input) err[Fail] {
    val r: res[Elf, Fail] = read.read(a, in);
    if (sel r.err) { ret err[Fail].err{r.err}; }
    var m: Elf = r.ok;
    ret model.release(?m);
}

# the bytes the extents of `m` take, which are the file when they tile it
fun covered(m: *Coff) u64 {
    var total: u64   = 0;
    var i:     usize = 0;
    for (i < table.count[Extent](?m.extents)) {
        val n: res[u64, Fail] = coff_model.extent_len(m, table.at[Extent](?m.extents, table.nth[Extent](i)));
        if (sel n.err) { ret 0; }
        total = total + n.ok;
        i     = i + 1;
    }
    ret total;
}

fun read_coff(a: *A.Allocator, in: *Input) err[Fail] {
    val r: res[Parsed, Fail] = coff_read.read(a, in);
    if (sel r.err)      { ret err[Fail].err{r.err}; }
    if (sel r.ok.short) { ret import.release(?r.ok.short); }
    var m: Coff = r.ok.object;
    if (covered(?m) != in.len::u64) {
        val dropped: err[Fail] = coff_model.release(?m);
        ret err[Fail].err{fail.internal("the extents do not tile the file")};
    }
    ret coff_model.release(?m);
}

# the data directories of an image that stayed raw bytes, one per line
fun held(a: *A.Allocator, path: str) i64 {
    var in: Input;
    if (!load(a, path, ?in)) { ret EXIT_USAGE; }
    val r: res[Parsed, Fail] = coff_read.read(a, ?in);
    if (sel r.err) { ret EXIT_REFUSED; }
    if (sel r.ok.short) {
        val shorn: err[Fail] = import.release(?r.ok.short);
        if (sel shorn.err) { ret EXIT_DEFECT; }
        ret EXIT_READ;
    }
    var m: Coff = r.ok.object;
    if (sel m.optional.image) {
        var i: usize = 0;
        for (i < tables.DIRECTORY.count) {
            val row:   *Constant             = tables.DIRECTORY.rows[i];
            val dirs:  *Table[DataDirectory] = ?m.optional.image.dirs;
            val typed: bool                  = row != ?tables.IMAGE_DIRECTORY_ENTRY_ARCHITECTURE && row != ?tables.IMAGE_DIRECTORY_ENTRY_GLOBALPTR;
            if (typed && row.value::usize < table.count[DataDirectory](dirs)) {
                val d: DataDirectory = @table.at[DataDirectory](dirs, table.nth[DataDirectory](row.value::usize));
                if (d.rva != 0 || d.size != 0) {
                    val p: res[opt[*coff_model.Piece], Fail] = coff_model.directory_piece(?m, row);
                    if (sel p.err) { print.println(row.name); }
                }
            }
            i = i + 1;
        }
    }
    val d: err[Fail] = coff_model.release(?m);
    if (sel d.err) { ret EXIT_DEFECT; }
    ret EXIT_READ;
}

fun cause_name(f: Fail) str {
    if (sel f.cause.malformed)   { ret "malformed"; }
    or (sel f.cause.unsupported) { ret "unsupported"; }
    or (sel f.cause.truncated)   { ret "truncated"; }
    or (sel f.cause.overflow)    { ret "overflow"; }
    or (sel f.cause.refused)     { ret "refused"; }
    or (sel f.cause.io)          { ret "io"; }
    ret "internal";
}

fun line(id: str, status: str) {
    print.print(id);
    print.print("\t");
    print.print(status);
}

fun count(label: str, n: usize) {
    print.print(" ");
    print.print(label);
    print.print("=");
    print.u64(n::u64);
}

fun refusal(id: str, f: Fail) {
    line(id, "refused");
    print.print(" ");
    print.print(cause_name(f));
    print.print(" ");
    print.println(f.text);
}

fun shape_elf(a: *A.Allocator, id: str, in: *Input) {
    val r: res[Elf, Fail] = read.read(a, in);
    if (sel r.err) {
        refusal(id, r.err);
        ret;
    }
    var m:       Elf   = r.ok;
    var typed:   usize = 0;
    var raw:     usize = 0;
    var overlay: usize = 0;
    var i:       usize = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = model.section_at(?m, table.nth[Section](i));
        if (sel s.body.raw)      { raw = raw + 1; }
        or (sel s.body.overlaid) { overlay = overlay + 1; }
        or (!sel s.body.empty)   { typed = typed + 1; }
        i = i + 1;
    }
    line(id, "read");
    count("typed", typed);
    count("raw", raw);
    count("overlaid", overlay);
    print.println("");
    val d: err[Fail] = model.release(?m);
}

fun shape_coff(a: *A.Allocator, id: str, in: *Input) {
    val r: res[Parsed, Fail] = coff_read.read(a, in);
    if (sel r.err) {
        refusal(id, r.err);
        ret;
    }
    if (sel r.ok.short) {
        line(id, "read");
        print.println("import");
        val d: err[Fail] = import.release(?r.ok.short);
        ret;
    }
    var m:     Coff  = r.ok.object;
    var typed: usize = 0;
    var raw:   u64   = 0;
    var i:     usize = 0;
    for (i < table.count[Extent](?m.extents)) {
        val e:   *Extent        = table.at[Extent](?m.extents, table.nth[Extent](i));
        val len: res[u64, Fail] = coff_model.extent_len(?m, e);
        if (sel len.err) {
            refusal(id, len.err);
            ret;
        }
        if (sel e.raw) { raw = raw + len.ok; }
        if (sel e.section) {
            val s: *coff_model.Section = coff_model.section_at(?m, e.section);
            if (sel s.body.raw)   { raw = raw + len.ok; }
            or (sel s.body.tiled) { shape_pieces(?m, ?s.body.tiled, ?typed, ?raw); }
        }
        if (sel e.tiled) { shape_pieces(?m, ?e.tiled, ?typed, ?raw); }
        i = i + 1;
    }
    line(id, "read");
    count("sections", table.count[coff_model.Section](?m.sections));
    count("typed", typed);
    count("rawbytes", raw::usize);
    print.println("");
    val d: err[Fail] = coff_model.release(?m);
}

fun shape_pieces(m: *Coff, tiles: *Table[coff_model.Piece], typed: *usize, raw: *u64) {
    var k: usize = 0;
    for (k < table.count[coff_model.Piece](tiles)) {
        val p:   *coff_model.Piece = table.at[coff_model.Piece](tiles, table.nth[coff_model.Piece](k));
        val len: res[u64, Fail]    = coff_model.piece_len(m, p);
        if (sel len.err) { ret; }
        if (sel p.raw)   { @raw = @raw + len.ok; }
        or               { @typed = @typed + 1; }
        k = k + 1;
    }
}

fun shape_macho(id: str, r: res[MachO, Fail]) {
    if (sel r.err) {
        refusal(id, r.err);
        ret;
    }
    var m:    MachO = r.ok;
    var raw:  usize = 0;
    var rawd: usize = 0;
    var i:    usize = 0;
    for (i < table.count[Command](?m.commands)) {
        val c: *Command = macho_model.command_at(?m, table.nth[Command](i));
        if (sel c.body.raw) { raw = raw + 1; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Blob](?m.blobs)) {
        val b: *Blob = macho_model.blob_at(?m, table.nth[Blob](i));
        if (sel b.data.raw) { rawd = rawd + 1; }
        i = i + 1;
    }
    line(id, "read");
    count("commands", table.count[Command](?m.commands));
    count("rawcommands", raw);
    count("blobs", table.count[Blob](?m.blobs));
    count("rawblobs", rawd);
    print.println("");
    val d: err[Fail] = macho_model.release(?m);
}

fun shape_fat(a: *A.Allocator, id: str, in: *Input) {
    val r: res[Fat, Fail] = macho_read.read_fat(a, in);
    if (sel r.err) {
        refusal(id, r.err);
        ret;
    }
    var f: Fat = r.ok;
    line(id, "read");
    count("slices", table.count[Slice](?f.slices));
    print.println("");
    var i: usize = 0;
    for (i < table.count[Slice](?f.slices)) {
        print.print(id);
        print.print("[slice ");
        print.u64(i::u64);
        print.print("]");
        val m: res[MachO, Fail] = macho_read.read_slice(a, ?f, table.nth[Slice](i), in.file);
        shape_macho("", m);
        i = i + 1;
    }
    val d: err[Fail] = universal_model.release(?f);
}

fun shape_archive(a: *A.Allocator, id: str, in: *Input) {
    val r: res[*Archive, Fail] = ar_read.read(a, in);
    if (sel r.err) {
        refusal(id, r.err);
        ret;
    }
    val arch: *Archive = r.ok;
    line(id, "read");
    count("members", table.count[Member](?arch.members));
    print.println("");
    var i: usize = 0;
    for (i < table.count[Member](?arch.members)) {
        val m: *Member = table.at[Member](?arch.members, table.nth[Member](i));
        if (m.held && m.role == ?ar_model.OBJECT) {
            val body: Bytes = ar_model.payload(arch, m);
            var mi:   Input = Input{file: in.file, data: body.data, len: body.len};
            print.print(id);
            print.print("(member ");
            print.u64(i::u64);
            print.print(")");
            shape_of(a, "", ?mi);
        }
        i = i + 1;
    }
    val d: err[Fail]    = ar_model.release(arch);
    val z: err[A.Error] = A.deallocate[Archive](a, arch, 1);
}

fun be32(in: *Input) u32 {
    ret (in.data[0]::u32 << 24) | (in.data[1]::u32 << 16) | (in.data[2]::u32 << 8) | in.data[3]::u32;
}

fun le32(in: *Input) u32 {
    ret (in.data[3]::u32 << 24) | (in.data[2]::u32 << 16) | (in.data[1]::u32 << 8) | in.data[0]::u32;
}

# one line for what `in` is and how it read, none for a file no reader claims
fun shape_of(a: *A.Allocator, id: str, in: *Input) {
    if (in.len < 8) {
        line(id, "unclaimed");
        print.println("");
        ret;
    }
    val le: u32 = le32(in);
    val be: u32 = be32(in);
    if (claims(?ELF_MAGIC[0], 4, in)) { shape_elf(a, id, in); }
    or (le == macho_tables.MH_MAGIC.value || le == macho_tables.MH_CIGAM.value || le == macho_tables.MH_MAGIC_64.value || le == macho_tables.MH_CIGAM_64.value) {
        shape_macho(id, macho_read.read(a, in));
    }
    or (be == macho_tables.FAT_MAGIC.value || be == macho_tables.FAT_MAGIC_64.value) { shape_fat(a, id, in); }
    or (claims(?AR_MAGIC[0], 7, in))                                                 { shape_archive(a, id, in); }
    or (claims(?MZ_MAGIC[0], 2, in))                                                 { shape_coff(a, id, in); }
    or {
        line(id, "unclaimed");
        print.println("");
    }
}

fun shape(a: *A.Allocator, path: str) i64 {
    var in: Input;
    if (!load(a, path, ?in)) { ret EXIT_USAGE; }
    shape_of(a, "", ?in);
    ret EXIT_READ;
}

fun registered(reg: *Registry, f: *Format) bool {
    val got: res[*Registration, Fail] = registry.by_format(reg, f);
    ret sel got.ok;
}

fun claims(magic: *u8, len: usize, in: *Input) bool {
    if (in.len < len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (in.data[i] != magic[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the input copied flush against an unmapped page
fun fence(in: *Input, out: *Input) bool {
    val page: usize = os.page_size();
    val body: usize = ((in.len + page - 1) / page) * page;
    val base: ptr   = os.allocate(body + page);
    if (base == nil) { ret false; }
    val edge: usize = base::usize + body;
    if (os.protect(edge::ptr, page, PROT_NONE) != 0) { ret false; }
    val at: *u8 = (edge - in.len)::*u8;
    memory.raw_copy(at::ptr, in.data::ptr, in.len);
    @out = Input{file: in.file, data: at, len: in.len};
    ret true;
}

fun list(reg: *Registry) i64 {
    var i: usize = 0;
    for (i < reg.count) {
        print.println(reg.entries[i].format.name);
        i = i + 1;
    }
    i = 0;
    for (i < EXTRA_COUNT) {
        if (!registered(reg, EXTRA[i].format)) { print.println(EXTRA[i].format.name); }
        i = i + 1;
    }
    ret EXIT_READ;
}

fun load(a: *A.Allocator, path: str, out: *Input) bool {
    val l: res[Loaded, Fail] = file.load(a, path);
    if (sel l.err) {
        print.eprintln("fuzz: cannot read the input");
        ret false;
    }
    var loaded: Loaded = l.ok;
    if (!fence(?loaded.input, out)) {
        print.eprintln("fuzz: cannot fence the input");
        ret false;
    }
    ret true;
}

fun sniff(a: *A.Allocator, reg: *Registry, path: str) i64 {
    var in: Input;
    if (!load(a, path, ?in)) { ret EXIT_USAGE; }
    val got: res[*Registration, Fail] = registry.sniff(reg, ?in);
    if (sel got.ok) {
        print.println(got.ok.format.name);
        ret EXIT_READ;
    }
    var i: usize = 0;
    for (i < EXTRA_COUNT) {
        if (!registered(reg, EXTRA[i].format) && claims(EXTRA[i].magic, EXTRA[i].magic_len, ?in)) {
            print.println(EXTRA[i].format.name);
            ret EXIT_READ;
        }
        i = i + 1;
    }
    ret EXIT_REFUSED;
}

fun read_one(a: *A.Allocator, reg: *Registry, name: str, path: str) i64 {
    var in: Input;
    if (!load(a, path, ?in)) { ret EXIT_USAGE; }
    var i: usize = 0;
    for (i < reg.count) {
        val r: *Registration = reg.entries[i];
        if (str_equals(r.format.name, name)) {
            val m: res[Model, Fail] = shell.run(r, a, ?in);
            if (sel m.err) { ret EXIT_REFUSED; }
            var model: Model     = m.ok;
            val d:     err[Fail] = contract.release(?model);
            if (sel d.err) { ret EXIT_REFUSED; }
            ret EXIT_READ;
        }
        i = i + 1;
    }
    i = 0;
    for (i < EXTRA_COUNT) {
        if (str_equals(EXTRA[i].format.name, name)) {
            val e: err[Fail] = EXTRA[i].read(a, ?in);
            if (sel e.err) {
                if (sel e.err.cause.internal) { ret EXIT_DEFECT; }
                ret EXIT_REFUSED;
            }
            ret EXIT_READ;
        }
        i = i + 1;
    }
    print.eprintln("fuzz: no such reader");
    ret EXIT_USAGE;
}

fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    val reg: res[Registry, Fail] = registry.builtin();
    if (sel reg.err) { ret EXIT_USAGE; }
    var r: Registry = reg.ok;
    if (argc == 2 && str_equals(argv[1]::str, "readers")) { ret list(?r); }
    if (argc == 3 && str_equals(argv[1]::str, "sniff"))   { ret sniff(a, ?r, argv[2]::str); }
    if (argc == 3 && str_equals(argv[1]::str, "held"))    { ret held(a, argv[2]::str); }
    if (argc == 3 && str_equals(argv[1]::str, "shape"))   { ret shape(a, argv[2]::str); }
    if (argc == 4 && str_equals(argv[1]::str, "read"))    { ret read_one(a, ?r, argv[2]::str, argv[3]::str); }
    print.eprintln("usage: fuzz readers | sniff <file> | read <reader> <file> | shape <file> | held <image>");
    ret EXIT_USAGE;
}

pub fun main(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret EXIT_USAGE; }
    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret EXIT_USAGE; }
    ret run(?a, argc, argv);
}
