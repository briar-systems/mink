# the command line grammar of mink
#
# a command is `mink <command> [operands] [options]`. an option is a row of a
# table the command declares: `--key value` or `-k value` for a value, `--key`
# for a binary fact and `--no-key` for its negation. `--` ends the options.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

pub def Arity: u8;
pub val FLAG:  Arity = 0;
pub val VALUE: Arity = 1;

# name:  the long spelling, such as `--output`
# short: the short spelling, or nil
# value: the help placeholder of a value
# arity: whether the option is a fact or takes a value
# doc:   one line of help
pub rec Option {
    name:  str;
    short: str;
    value: str;
    arity: Arity;
    doc:   str;
}

pub val MAX_OPERANDS: usize = 8;
pub val MAX_OPTIONS:  usize = 8;

# operands: the words that are not options, in order
# values:   the value of each value option, nil when not given
# facts:    1 for a fact given as `--key`, 2 given as `--no-key`, 0 absent
# bad:      the argument that broke the grammar, nil when none did
# why:      what is wrong with it
pub rec Parsed {
    operands:      [MAX_OPERANDS]str;
    operand_count: usize;
    values:        [MAX_OPTIONS]str;
    facts:         [MAX_OPTIONS]u8;
    bad:           str;
    why:           str;
}

fun refuse(p: *Parsed, arg: str, why: str) {
    p.bad = arg;
    p.why = why;
}

# the row `arg` spells, with `negated` set when it spells `--no-key`
fun find(opts: *Option, n: usize, arg: str, negated: *bool) usize {
    var i: usize = 0;
    for (i < n) {
        val o: *Option = ?opts[i];
        if (str_equals(arg, o.name) || (o.short != nil && str_equals(arg, o.short))) {
            @negated = false;
            ret i;
        }
        i = i + 1;
    }
    if (str_starts_with(arg, "--no-")) {
        i = 0;
        for (i < n) {
            val o: *Option = ?opts[i];
            if (o.arity == FLAG && str_equals((arg::usize + 5)::str, (o.name::usize + 2)::str)) {
                @negated = true;
                ret i;
            }
            i = i + 1;
        }
    }
    ret n;
}

# parse `argv[from..argc]` against `opts`, the problem left in `p`
pub fun parse(argc: usize, argv: **u8, from: usize, opts: *Option, n: usize, p: *Parsed) {
    var i:    usize = from;
    var done: bool  = false;
    for (i < argc) {
        val arg: str = argv[i]::str;
        i = i + 1;
        if (done || arg[0] != '-' || str_len(arg) == 1) {
            if (p.operand_count == MAX_OPERANDS) {
                refuse(p, arg, "too many operands");
                ret;
            }
            p.operands[p.operand_count] = arg;
            p.operand_count             = p.operand_count + 1;
            cnt;
        }
        if (str_equals(arg, "--")) {
            done = true;
            cnt;
        }
        var negated: bool  = false;
        val at:      usize = find(opts, n, arg, ?negated);
        if (at == n) {
            refuse(p, arg, "unknown option");
            ret;
        }
        if (opts[at].arity == FLAG) {
            if (negated) { p.facts[at] = 2; }
            or           { p.facts[at] = 1; }
            cnt;
        }
        if (i == argc) {
            refuse(p, arg, "needs a value");
            ret;
        }
        p.values[at] = argv[i]::str;
        i            = i + 1;
    }
}
