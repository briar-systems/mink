# the oracle lane of the merged section kinds, one object per run
#
# `merged <input>` reads an object of any registered format, converts it to
# the neutral object and prints one line per section of a kind keyed by its
# element size:
# `section <name> kind <kind> entsize <n> strings <yes|no> named <name>`,
# where named is the name the format's naming gives a nameless section of the
# same key. test/merged.sh drives it and judges each line against
# llvm-readobj's view of the same file. it runs locally and is never part of
# CI.

use std.print;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.allocator.heap;
use fs: std.filesystem;

use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.contract;
use mink.format.contract.Model;
use mink.format.contract.Naming;
use mink.format.file;
use mink.format.file.Loaded;
use mink.format.registry;
use mink.format.registry.Registry;
use mink.model.object;
use mink.model.object.Object;
use mink.model.section;

val USAGE: str = "usage: merged <input>\n";

fun report(a: *A.Allocator, f: Fail) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val r: err[Fail] = diag.render(f, ?s);
    if (sel r.err) { ret 2; }
    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    ret 1;
}

# print the line of section `s`, its name `v` and the name `named` its key
# takes
fun show(a: *A.Allocator, s: *object.Section, v: View, named: str) err[Fail] {
    var line: Sink      = sink.make(a, LITTLE);
    val wb:   err[Fail] = sink.bytes(?line, v.data, v.len);
    val wz:   err[Fail] = sink.u8(?line, 0);
    var got:  err[Fail] = err[Fail].ok{};
    if (sel wb.err) { got = wb; }
    or (sel wz.err) { got = wz; }
    or {
        var strings: str = "no";
        if ((s.flags & section.STRINGS) != 0) { strings = "yes"; }
        print.printlnf("section {} kind {} entsize {} strings {} named {}", sink.data(?line)::str, s.kind.name, s.entsize, strings, named);
    }
    val rel: err[Fail] = sink.release(?line);
    if (sel got.err) { ret got; }
    ret rel;
}

fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    if (argc != 2) {
        print.print(USAGE);
        ret 2;
    }
    val l: res[Loaded, Fail] = file.load(a, argv[1]);
    if (sel l.err) { ret report(a, l.err); }
    var ld: Loaded              = l.ok;
    var g:  res[Registry, Fail] = registry.builtin(a);
    if (sel g.err) { ret report(a, g.err); }
    val m: res[Model, Fail] = registry.read(?g.ok, a, ?ld.input);
    if (sel m.err) { ret report(a, m.err); }
    var model: Model              = m.ok;
    val n:     res[*Naming, Fail] = registry.naming(?g.ok, model.reader.format);
    if (sel n.err) { ret report(a, n.err); }
    var o: Object    = object.make(a, nil);
    val c: err[Fail] = contract.to_neutral(?model, ?g.ok.relocs, ?o);
    if (sel c.err) { ret report(a, fail.in_file(c.err, argv[1])); }
    var i: usize = 0;
    for (i < table.count[object.Section](?o.sections)) {
        val s: *object.Section = object.section_at(?o, table.nth[object.Section](i));
        i = i + 1;
        if (!section.keyed(s.kind)) { cnt; }
        if (sel s.name.none)        { cnt; }
        val named: res[str, Fail] = n.ok.name_of(section.key_of(s.kind, s.entsize));
        if (sel named.err) { ret report(a, fail.in_file(fail.in_indexed(named.err, "section", (i - 1)::u64), argv[1])); }
        val w: err[Fail] = show(a, s, object.name_of(?o, s.name.some), named.ok);
        if (sel w.err) { ret report(a, w.err); }
    }
    ret 0;
}

# every allocation lives in the heap, which is given back whole when the run ends
pub fun main(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret 2; }
    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret 2; }
    val code: i64          = run(?a, argc, argv);
    val dn:   err[A.Error] = heap.dnit(?h);
    if (sel dn.err) { ret 2; }
    ret code;
}
