# what every command of the mink command line shares: its run context, its
# exit codes, printing to stdout and stderr, help pages and refusals of the
# command line

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.args;
use std.args.help;

use A:  std.allocator;
use fs: std.filesystem;
use std.io.writer.WriteError;
use std.io.writer.Writer;

use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.contract.Model;
use mink.format.file;
use mink.format.file.Loaded;
use mink.format.registry;
use mink.format.registry.Registry;

pub val EXIT_OK:            i64 = 0; # the command did what it was asked
pub val EXIT_FAILED:        i64 = 1; # the command failed, and the failure was printed
pub val EXIT_UNREPORTED:    i64 = 2; # the command failed, and printing the failure failed too
pub val EXIT_MEM_DNIT:      i64 = 3; # the heap could not be released after the command
pub val EXIT_UNIMPLEMENTED: i64 = 4; # a link needs what mink does not build yet
pub val EXIT_MEM_INIT:      i64 = 5; # the heap could not be made, so nothing ran

# the codes every command exits with, as help pages state them
pub val EXIT_COUNT: usize                 = 5;
pub val EXITS:      [EXIT_COUNT]args.Exit = [EXIT_COUNT]args.Exit{
    args.Exit{code: EXIT_OK, meaning: "the command did what it was asked"},
    args.Exit{code: EXIT_FAILED, meaning: "the command failed, and the failure was printed"},
    args.Exit{code: EXIT_UNREPORTED, meaning: "the command failed, and printing the failure failed too"},
    args.Exit{code: EXIT_MEM_DNIT, meaning: "the heap could not be released after the command"},
    args.Exit{code: EXIT_MEM_INIT, meaning: "the heap could not be made, so nothing ran"},
};

# basic CLI entry context
# ---
# a:    the allocator every command allocates in
# reg:  the formats
# line: the command line, read against mink's commands
pub rec Run {
    a:    *A.Allocator;
    reg:  Registry;
    line: args.Invocation;
}

# the operand at `i` of the command line, none when it has fewer
pub fun operand(r: *Run, i: usize) opt[str] {
    val at: opt[usize] = args.operand(?r.line, i);
    if (sel at.none) { ret opt[str].none{}; }
    ret opt[str].some{r.line.args.argv[at.some]::str};
}

# print the diagnostic of `f` on stderr
# ---
# a:   the allocator to allocate the sink in
# f:   the failure to print
# ret: EXIT_FAILED, or EXIT_UNREPORTED when the failure could not be printed
pub fun report(a: *A.Allocator, f: Fail) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val r: err[Fail] = diag.render(f, ?s);
    if (sel r.err) { ret EXIT_UNREPORTED; }

    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    if (sel e.err) { ret EXIT_UNREPORTED; }

    ret EXIT_FAILED;
}

# print `text` on stdout
# ---
# a:    the allocator to allocate the sink in
# text: the text to print
# ret:  EXIT_OK, or the code of reporting why it could not be printed
pub fun say(a: *A.Allocator, text: str) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val t: err[Fail] = sink.text(?s, text);
    if (sel t.err) { ret report(a, t.err); }

    ret emit(a, ?s);
}

# print what `s` holds on stdout
# ---
# a:   the allocator to report a failure in
# s:   the text to print
# ret: EXIT_OK, or the code of reporting why it could not be printed
pub fun emit(a: *A.Allocator, s: *Sink) i64 {
    val e: err[Fail] = file.emit(fs.STDOUT, s);
    if (sel e.err) { ret report(a, e.err); }

    ret EXIT_OK;
}

# print a usage message on stderr
# ---
# a:   the allocator to allocate the sink in
# bad: the command word that was given wrong
# why: the reason it was wrong
# ret: the code of reporting it
pub fun usage(a: *A.Allocator, bad: str, why: str) i64 {
    ret report(a, fail.in_record(fail.malformed(why), bad));
}

# read a file, load it, and read its model
# ---
# r:      the run context
# path:   the path to the file
# loaded: the loaded file, set on success
# m:      the model of the file, set on success
# ret:    EXIT_OK, or the code of reporting why the file or its model could not be read
pub fun read_file(r: *Run, path: str, loaded: *Loaded, m: *Model) i64 {
    val l: res[Loaded, Fail] = file.load(r.a, path);
    if (sel l.err) { ret report(r.a, l.err); }

    @loaded = l.ok;

    val g: res[Model, Fail] = registry.read(?r.reg, r.a, ?loaded.input);
    if (sel g.err) { ret report(r.a, g.err); }

    @m = g.ok;

    ret EXIT_OK;
}

# print the page `p` of the commands `set` on stdout, wrapped to the terminal
# ---
# a:   the allocator to allocate the sink in
# set: the commands
# p:   the page
# ret: EXIT_OK, or the code of reporting why the page could not be printed
pub fun page(a: *A.Allocator, set: *args.CommandSet, p: help.Page) i64 {
    var s: Sink   = sink.make(a, LITTLE);
    var w: Writer = sink.writer(?s);

    val h: err[help.HelpError] = help.render(set, ?w, p, help.terminal_width());
    if (sel h.err) {
        val e: help.HelpError = h.err;
        if (sel e.malformed) { ret report(a, fail.about(fail.internal("mink's command table breaks the std.args contract"), e.malformed.why)); }
        ret report(a, file.written(e.write, "cannot write the help page"));
    }

    ret emit(a, ?s);
}

# print why std.args refused the command line `line` on stderr
# ---
# a:    the allocator to allocate the sink in
# line: the refused command line
# ret:  EXIT_FAILED, or EXIT_UNREPORTED when the refusal could not be printed
pub fun refused(a: *A.Allocator, line: *args.Invocation) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    var w: Writer    = sink.writer(?s);
    val p: err[Fail] = sink.text(?s, "mink: ");
    if (sel p.err) { ret EXIT_UNREPORTED; }

    val d: err[WriteError] = args.describe(line, ?w);
    if (sel d.err) { ret EXIT_UNREPORTED; }

    val n: err[Fail] = sink.text(?s, "\n");
    if (sel n.err) { ret EXIT_UNREPORTED; }

    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    if (sel e.err) { ret EXIT_UNREPORTED; }

    ret EXIT_FAILED;
}
