# what every command of the mink command line shares: its run context, its
# exit codes, printing to stdout and stderr, help pages and refusals of the
# command line. mink declares its own help, version and exit codes, kept the
# same as mach, mirl and masc by hand

use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use std.args;
use std.args.help;

use A:  std.allocator;
use fs: std.filesystem;
use std.io.writer.WriteError;
use std.io.writer.Writer;

use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.target;
use mink.catalog.target.Refusal;
use mink.format.file;
use mink.format.registry.Registry;

# the codes every command exits with, the same in mach, mirl, masc and mink
pub val EXIT_OK:          i64 = 0; # the command did what it was asked
pub val EXIT_USER:        i64 = 1; # the command line or the input the user controls is wrong
pub val EXIT_INTERNAL:    i64 = 2; # mink broke an invariant of its own, or does not do a valid request yet
pub val EXIT_ENVIRONMENT: i64 = 3; # the machine refused: a file, an allocation or a write

# basic CLI entry context
# ---
# a:    the allocator every command allocates in
# reg:  the formats
# line: the command line, read against mink's commands
pub rec Run {
    a:    *A.Allocator;
    reg:  *Registry;
    line: *args.Parsed;
}

# the operand at `i` of the command line, none when it has fewer
pub fun operand(r: *Run, i: usize) opt[str] {
    ret args.operand(r.line, i);
}

# the code a command exits with for the failure `f`: the user's for input
# that breaks its specification or a file it names that does not exist, the
# environment's for a file that exists but cannot be read, an output that
# cannot be written or an allocation the machine refused, and mink's own for
# an invariant it broke or a valid request it does not do yet
pub fun exit_for(f: Fail) i64 {
    val c: fail.Cause = f.cause;
    if (sel c.internal || sel c.unsupported) { ret EXIT_INTERNAL; }
    or (sel c.io || sel c.refused)           { ret EXIT_ENVIRONMENT; }
    ret EXIT_USER;
}

# print the diagnostic of `f` on stderr
# ---
# a:   the allocator to allocate the sink in
# f:   the failure to print
# ret: the code exit_for gives `f`, or EXIT_ENVIRONMENT when it could not be
#      printed
pub fun report(a: *A.Allocator, f: Fail) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val r: err[Fail] = diag.render(f, ?s);
    if (sel r.err) { ret EXIT_ENVIRONMENT; }

    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    if (sel e.err) { ret EXIT_ENVIRONMENT; }

    ret exit_for(f);
}

# print the refusal `r` of a target on stderr, with what its part accepts
# ---
# a:   the allocator to allocate the sink in
# r:   the refusal
# ret: EXIT_USER, or EXIT_ENVIRONMENT when it could not be printed
pub fun refuse_target(a: *A.Allocator, r: *Refusal) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val p: err[Fail] = sink.text(?s, "mink: ");
    if (sel p.err) { ret EXIT_ENVIRONMENT; }

    val w: err[Fail] = target.write(r, ?s);
    if (sel w.err) { ret EXIT_ENVIRONMENT; }

    val n: err[Fail] = sink.text(?s, "\n");
    if (sel n.err) { ret EXIT_ENVIRONMENT; }

    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    if (sel e.err) { ret EXIT_ENVIRONMENT; }

    ret EXIT_USER;
}

# print `text` on stdout
# ---
# a:    the allocator to allocate the sink in
# text: the text to print
# ret:  EXIT_OK, or the code of reporting why it could not be printed
pub fun say(a: *A.Allocator, text: str) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val t: err[Fail] = sink.text(?s, text);
    if (sel t.err) { ret report(a, t.err); }

    ret emit(a, ?s);
}

# print `text` alone on one line on stdout
# ---
# a:    the allocator to allocate the sink in
# text: the text to print
# ret:  EXIT_OK, or the code of reporting why it could not be printed
pub fun say_line(a: *A.Allocator, text: str) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val t: err[Fail] = sink.text(?s, text);
    if (sel t.err) { ret report(a, t.err); }

    val n: err[Fail] = sink.text(?s, "\n");
    if (sel n.err) { ret report(a, n.err); }

    ret emit(a, ?s);
}

# print what `s` holds on stdout
# ---
# a:   the allocator to report a failure in
# s:   the text to print
# ret: EXIT_OK, or the code of reporting why it could not be printed
pub fun emit(a: *A.Allocator, s: *Sink) i64 {
    val e: err[Fail] = file.emit(fs.STDOUT, s);
    if (sel e.err) { ret report(a, e.err); }

    ret EXIT_OK;
}

# print a usage message on stderr
# ---
# a:   the allocator to allocate the sink in
# bad: the command word that was given wrong
# why: the reason it was wrong
# ret: the code of reporting it
pub fun usage(a: *A.Allocator, bad: str, why: str) i64 {
    ret report(a, fail.in_record(fail.malformed(why), bad));
}

# print the page of the command `line` matched on stdout, wrapped to the
# terminal
# ---
# a:    the allocator to allocate the sink in
# line: the command line
# ret:  EXIT_OK, or the code of reporting why the page could not be printed
pub fun page(a: *A.Allocator, line: *args.Parsed) i64 {
    var s: Sink   = sink.make(a, LITTLE);
    var w: Writer = sink.writer(?s);

    val h: err[WriteError] = help.render(line, ?w, help.terminal_width());
    if (sel h.err) { ret report(a, file.written(h.err, "cannot write the help page")); }

    ret emit(a, ?s);
}

# print why std.args refused the command line `line` on stderr
# ---
# a:    the allocator to allocate the sink in
# line: the refused command line
# ret:  EXIT_USER, or EXIT_ENVIRONMENT when the refusal could not be printed
pub fun refused(a: *A.Allocator, line: *args.Parsed) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    var w: Writer    = sink.writer(?s);
    val p: err[Fail] = sink.text(?s, "mink: ");
    if (sel p.err) { ret EXIT_ENVIRONMENT; }

    val d: err[WriteError] = args.describe(line, ?w);
    if (sel d.err) { ret EXIT_ENVIRONMENT; }

    val n: err[Fail] = sink.text(?s, "\n");
    if (sel n.err) { ret EXIT_ENVIRONMENT; }

    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    if (sel e.err) { ret EXIT_ENVIRONMENT; }

    ret EXIT_USER;
}
