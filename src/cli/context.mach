# what every command of the mink command line shares: its run context, its
# exit codes, and printing to stdout and stderr

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.args;

use A: std.allocator;
use std.collections.vector.Vector;
use fs: std.filesystem;

use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.contract.Model;
use mink.format.file;
use mink.format.file.Loaded;
use mink.format.registry;
use mink.format.registry.Registry;

pub val EXIT_OK:            i64 = 0; # the command did what it was asked
pub val EXIT_FAILED:        i64 = 1; # the command failed, and the failure was printed
pub val EXIT_UNREPORTED:    i64 = 2; # the command failed, and printing the failure failed too
pub val EXIT_MEM_DNIT:      i64 = 3; # the heap could not be released after the command
pub val EXIT_UNIMPLEMENTED: i64 = 4; # a link needs what mink does not build yet
pub val EXIT_MEM_INIT:      i64 = 5; # the heap could not be made, so nothing ran

# basic CLI entry context
# ---
# a:        the allocator every command allocates in
# reg:      the formats
# args:     the process arguments
# operands: the operands after the command word, in order
pub rec Run {
    a:        *A.Allocator;
    reg:      Registry;
    args:     args.Args;
    operands: Vector[str];
}

# the operand at `i`, which the command's operand count makes present
pub fun operand(r: *Run, i: usize) str {
    ret r.operands.data[i];
}

# print the diagnostic of `f` on stderr
# ---
# a:   the allocator to allocate the sink in
# f:   the failure to print
# ret: EXIT_FAILED, or EXIT_UNREPORTED when the failure could not be printed
pub fun report(a: *A.Allocator, f: Fail) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val r: err[Fail] = diag.render(f, ?s);
    if (sel r.err) { ret EXIT_UNREPORTED; }

    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    if (sel e.err) { ret EXIT_UNREPORTED; }

    ret EXIT_FAILED;
}

# print `text` on stdout
# ---
# a:    the allocator to allocate the sink in
# text: the text to print
# ret:  EXIT_OK, or the code of reporting why it could not be printed
pub fun say(a: *A.Allocator, text: str) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val t: err[Fail] = sink.text(?s, text);
    if (sel t.err) { ret report(a, t.err); }

    ret emit(a, ?s);
}

# print what `s` holds on stdout
# ---
# a:   the allocator to report a failure in
# s:   the text to print
# ret: EXIT_OK, or the code of reporting why it could not be printed
pub fun emit(a: *A.Allocator, s: *Sink) i64 {
    val e: err[Fail] = file.emit(fs.STDOUT, s);
    if (sel e.err) { ret report(a, e.err); }

    ret EXIT_OK;
}

# print a usage message on stderr
# ---
# a:   the allocator to allocate the sink in
# bad: the command word that was given wrong
# why: the reason it was wrong
# ret: the code of reporting it
pub fun usage(a: *A.Allocator, bad: str, why: str) i64 {
    ret report(a, fail.in_record(fail.malformed(why), bad));
}

# read a file, load it, and read its model
# ---
# r:      the run context
# path:   the path to the file
# loaded: the loaded file, set on success
# m:      the model of the file, set on success
# ret:    EXIT_OK, or the code of reporting why the file or its model could not be read
pub fun read_file(r: *Run, path: str, loaded: *Loaded, m: *Model) i64 {
    val l: res[Loaded, Fail] = file.load(r.a, path);
    if (sel l.err) { ret report(r.a, l.err); }

    @loaded = l.ok;

    val g: res[Model, Fail] = registry.read(?r.reg, r.a, ?loaded.input);
    if (sel g.err) { ret report(r.a, g.err); }

    @m = g.ok;

    ret EXIT_OK;
}
