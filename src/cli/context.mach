# what every command of the mink command line shares: its run context, its
# exit codes, printing to stdout and stderr, help pages and refusals of the
# command line. mink declares its own help, version and exit codes, kept the
# same as mach, mirl and masc by hand

use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use std.args;
use std.args.help;

use A:  std.allocator;
use fs: std.filesystem;
use std.io.writer;
use std.io.writer.WriteError;
use std.io.writer.Writer;

use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.format.file;
use mink.format.registry.Registry;

# the flag every mink command lists asking for its page in place of a run,
# which the command line's caller answers and a command's run ignores
pub val HELP: args.Flag = args.Flag{long: "help", short: 'h', value: nil, repeat: false, negatable: false, help: "show help"};

# the codes every command exits with, the same in mach, mirl, masc and mink
pub val EXIT_OK:          i64 = 0; # the command did what it was asked
pub val EXIT_USER:        i64 = 1; # the command line or the input the user controls is wrong, or asks what mink does not do yet
pub val EXIT_INTERNAL:    i64 = 2; # mink broke an invariant of its own
pub val EXIT_ENVIRONMENT: i64 = 3; # the machine refused: a file, an allocation or a write

# basic CLI entry context
# ---
# a:    the allocator every command allocates in
# reg:  the formats
# line: the command line, read against mink's commands
pub rec Run {
    a:    *A.Allocator;
    reg:  *Registry;
    line: *args.Parsed;
}

# the operand at `i` of the command line, none when it has fewer
pub fun operand(r: *Run, i: usize) opt[str] {
    ret args.operand(r.line, i);
}

# the code a command exits with for the failure `f`: the user's for input
# that breaks its specification, a file it names that does not exist or a path
# too long for the host, the environment's for a file that exists but cannot
# be read, an output that cannot be written or an allocation the machine
# refused, and mink's own for an invariant it broke. a valid request mink does
# not do yet is the user's, who asked for it
pub fun exit_for(f: Fail) i64 {
    val c: fail.Cause = f.cause;
    if (sel c.internal)            { ret EXIT_INTERNAL; }
    or (sel c.io || sel c.refused) { ret EXIT_ENVIRONMENT; }
    ret EXIT_USER;
}

# print the diagnostic of `f` on stderr, a blank line after it
# ---
# a:   the allocator to allocate the sink in
# f:   the failure to print
# ret: the code exit_for gives `f`, or EXIT_ENVIRONMENT when it could not be
#      printed
pub fun report(a: *A.Allocator, f: Fail) i64 {
    var s:          Sink      = sink.init(a, LITTLE);
    var err_render: err[Fail] = diag.render(diag.PREFIX, f, ?s);
    err_render = fail.kept(err_render, sink.text(?s, "\n"));
    ret shown(f, ?s, err_render);
}

# print the diagnostic of `f` built in `s` as `built` ended on stderr, and
# give `s` back
# ---
# f:     the failure it reports
# s:     the diagnostic, a blank line after it
# built: how building it ended
# ret:   the code exit_for gives `f`, or EXIT_ENVIRONMENT when it could not be
#        printed
pub fun shown(f: Fail, s: *Sink, built: err[Fail]) i64 {
    var err_out: err[Fail] = built;
    if (sel built.ok) { err_out = file.emit(fs.STDERR, s); }
    err_out = fail.kept(err_out, sink.dnit(s));
    if (sel err_out.err) { ret EXIT_ENVIRONMENT; }
    ret exit_for(f);
}

# append each note of `notes` to `out` beneath the diagnostic it explains,
# one a line as `  note <text>`
pub fun attached(notes: *Sink, out: *Sink) err[Fail] {
    var err_text: err[Fail] = err[Fail].ok{};
    var at:       usize     = 0;
    for (at < sink.len(notes)) {
        val l: diag.Line = diag.line(notes, at);
        err_text = fail.kept(err_text, sink.text(out, "  note "));
        err_text = fail.kept(err_text, sink.bytes(out, l.text.data::*u8, l.text.len));
        err_text = fail.kept(err_text, sink.text(out, "\n"));
        at       = l.next;
    }
    ret err_text;
}

# print each note of `notes` on stderr as a diagnostic of its own, headed by
# the note head, a blank line after each
# ---
# a:     the allocator to allocate the sink in
# notes: what a run that held left to say
# ret:   EXIT_OK, or the code of reporting why the notes could not be printed
pub fun told(a: *A.Allocator, notes: *Sink) i64 {
    if (sink.len(notes) == 0) { ret EXIT_OK; }
    var s:        Sink      = sink.init(a, LITTLE);
    var err_text: err[Fail] = err[Fail].ok{};
    var at:       usize     = 0;
    for (at < sink.len(notes)) {
        val l: diag.Line = diag.line(notes, at);
        err_text = fail.kept(err_text, sink.text(?s, diag.NOTE));
        err_text = fail.kept(err_text, sink.bytes(?s, l.text.data::*u8, l.text.len));
        err_text = fail.kept(err_text, sink.text(?s, "\n\n"));
        at       = l.next;
    }
    var err_out: err[Fail] = err_text;
    if (sel err_text.ok) { err_out = file.emit(fs.STDERR, ?s); }
    err_out = fail.kept(err_out, sink.dnit(?s));
    if (sel err_out.err) { ret report(a, err_out.err); }
    ret EXIT_OK;
}

# the code a command exits with once it has released what it holds, where a
# refused release is reported only for a command that has not already failed
# ---
# a:    the allocator to report a failure in
# code: the code the command exits with so far
# e:    the outcome of the release
# ret:  `code`, or the code of reporting the refused release where `code` is EXIT_OK
pub fun released(a: *A.Allocator, code: i64, e: err[Fail]) i64 {
    if (sel e.err) {
        if (code == EXIT_OK) { ret report(a, e.err); }
    }
    ret code;
}

# print `text` alone on one line on stdout
# ---
# a:    the allocator to allocate the sink in
# text: the text to print
# ret:  EXIT_OK, or the code of reporting why it could not be printed
pub fun say_line(a: *A.Allocator, text: str) i64 {
    var s:        Sink      = sink.init(a, LITTLE);
    val err_text: err[Fail] = sink.text(?s, text);
    if (sel err_text.err) { ret report(a, err_text.err); }

    val err_newline_written: err[Fail] = sink.text(?s, "\n");
    if (sel err_newline_written.err) { ret report(a, err_newline_written.err); }

    ret emit(a, ?s);
}

# print what `s` holds on stdout
# ---
# a:   the allocator to report a failure in
# s:   the text to print
# ret: EXIT_OK, or the code of reporting why it could not be printed
pub fun emit(a: *A.Allocator, s: *Sink) i64 {
    var w:       Writer          = fs.writer(fs.STDOUT);
    val err_out: err[WriteError] = writer.write_all(?w, sink.data(s), sink.len(s));
    if (sel err_out.err) { ret report(a, file.written(err_out.err, "cannot write standard output")); }

    ret EXIT_OK;
}

# print a usage message on stderr
# ---
# a:   the allocator to allocate the sink in
# bad: the command word that was given wrong
# why: the reason it was wrong
# ret: the code of reporting it
pub fun usage(a: *A.Allocator, bad: str, why: str) i64 {
    ret report(a, fail.in_record(fail.malformed(why), bad));
}

# print the page of the command `line` matched on stdout, wrapped to the
# terminal
# ---
# a:    the allocator to allocate the sink in
# line: the command line
# ret:  EXIT_OK, or the code of reporting why the page could not be printed
pub fun page(a: *A.Allocator, line: *args.Parsed) i64 {
    var s: Sink   = sink.init(a, LITTLE);
    var w: Writer = sink.writer(?s);

    val err_render: err[WriteError] = help.render(line, ?w, help.terminal_width());
    if (sel err_render.err) { ret report(a, file.written(err_render.err, "cannot write the help page")); }

    ret emit(a, ?s);
}

# print why std.args refused the command line `line` on stderr
# ---
# a:    the allocator to allocate the sink in
# line: the refused command line
# ret:  EXIT_USER, or EXIT_ENVIRONMENT when the refusal could not be printed
pub fun refused(a: *A.Allocator, line: *args.Parsed) i64 {
    var s:        Sink      = sink.init(a, LITTLE);
    var w:        Writer    = sink.writer(?s);
    val err_text: err[Fail] = sink.text(?s, diag.PREFIX);
    if (sel err_text.err) { ret EXIT_ENVIRONMENT; }

    val err_describe: err[WriteError] = args.describe(line, ?w);
    if (sel err_describe.err) { ret EXIT_ENVIRONMENT; }

    val err_newline_written: err[Fail] = sink.text(?s, "\n\n");
    if (sel err_newline_written.err) { ret EXIT_ENVIRONMENT; }

    val err_emit: err[Fail] = file.emit(fs.STDERR, ?s);
    if (sel err_emit.err) { ret EXIT_ENVIRONMENT; }

    ret EXIT_USER;
}
