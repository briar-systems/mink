# the oracle lane of the ELF trait encodings, one object per run
#
# `traits <input> <output> [<axis> <value>]...` reads an ELF object, converts
# it to the neutral object and prints the traits it states and the e_flags bits
# no row maps, then builds an ELF file from the neutral object stating exactly
# the traits named on the command line, as a producer states them. a value is a
# choice of the axis, `set` or `clear` for a flag, or a decimal number for a
# number axis. a text axis is printed and not stated. it then reads the file
# it wrote back and compares the object read with the one it built through
# compare.difference, printing
# `difference none` or what differs, and `trait-difference <axis>` for each
# axis the two state differently. test/traits.sh drives it. it runs locally
# and is never part of CI.

use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.heap;
use fs: std.filesystem;

use mink.base.diag;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store;
use mink.base.store.Bytes;
use mink.base.table;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.arch.list;
use mink.catalog.format;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Choice;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.format.contract.Input;
use mink.format.elf.model.model.Elf;
use mink.format.elf.neutral.fact;
use elf_neutral: mink.format.elf.neutral.neutral;
use mink.format.elf.read;
use elf_write: mink.format.elf.write;
use mink.format.file;
use mink.format.file.Loaded;
use mink.lower.Lowering;
use mink.model.compare;
use mink.model.object;
use mink.model.object.Fact;
use mink.model.object.Object;

val USAGE: str = "usage: traits <input> <output> [<axis> <value>]...\n";

fun report(a: *A.Allocator, f: Fail) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val r: err[Fail] = diag.render(f, ?s);
    if (sel r.err) { ret 2; }
    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    ret 1;
}

# print what `o` holds on each axis of its architecture, a value it leaves
# unstated whose absence means one included, and an axis that places no
# constraint left out
fun show(a: *A.Allocator, o: *Object) {
    val x: *Arch = o.target.arch;
    var i: usize = 0;
    for (i < x.axis_count) {
        val ax: *Axis        = x.axes[i];
        val v:  opt[Setting] = object.effective(o, ax);
        i = i + 1;
        if (sel v.none) { cnt; }
        val s: Setting = v.some;
        if (sel s.choice) {
            print.printlnf("{} {}", ax.name, s.choice.name);
            cnt;
        }
        or (sel s.number) {
            print.printlnf("{} {}", ax.name, s.number);
            cnt;
        }
        or (sel s.text) {
            show_bytes(a, ax.name, store.bytes(?o.store, ?s.text));
            cnt;
        }
        or (sel s.set) {
            show_bytes(a, ax.name, store.bytes(?o.store, ?s.set));
            cnt;
        }
        or (sel s.pair) {
            print.printlnf("{} {}", ax.name, s.pair.number);
            show_bytes(a, ax.name, store.bytes(?o.store, ?s.pair.text));
            cnt;
        }
        if (s.flag) { print.printlnf("{} set", ax.name); }
        or          { print.printlnf("{} clear", ax.name); }
    }
}

# print `name` and the bytes `b` as text
fun show_bytes(a: *A.Allocator, name: str, b: Bytes) {
    var line: Sink      = sink.make(a, LITTLE);
    val wb:   err[Fail] = sink.bytes(?line, b.data, b.len);
    val wz:   err[Fail] = sink.u8(?line, 0);
    if (sel wb.ok && sel wz.ok) { print.printlnf("{} {}", name, sink.data(?line)::str); }
    val rel: err[Fail] = sink.release(?line);
}

# the decimal number `value` spells, none when it spells none or passes 64 bits
fun decimal(value: str) opt[u64] {
    var n: u64   = 0;
    var i: usize = 0;
    for (value[i] != 0) {
        val d: u8 = value[i];
        if (d < '0' || d > '9')                                { ret opt[u64].none{}; }
        if (n > (0xffff_ffff_ffff_ffff - (d - '0')::u64) / 10) { ret opt[u64].none{}; }
        n = n * 10 + (d - '0')::u64;
        i = i + 1;
    }
    if (i == 0) { ret opt[u64].none{}; }
    ret opt[u64].some{n};
}

# the setting `value` names on `x`
fun setting_of(x: *Axis, value: str) res[Setting, Fail] {
    val flag: bool = sel x.value.flag;
    if (flag && str_equals(value, "set"))   { ret res[Setting, Fail].ok{Setting.flag{true}}; }
    if (flag && str_equals(value, "clear")) { ret res[Setting, Fail].ok{Setting.flag{false}}; }
    if (sel x.value.number) {
        val n: opt[u64] = decimal(value);
        if (sel n.some) { ret res[Setting, Fail].ok{Setting.number{n.some}}; }
    }
    val c: opt[*Choice] = trait.choice_named(x, value);
    if (sel c.some) { ret res[Setting, Fail].ok{Setting.choice{c.some}}; }
    ret res[Setting, Fail].err{fail.about(fail.malformed("the trait axis has no such value"), x.name)};
}

# state on `o` the traits the `n` operand pairs at `argv` name, as a
# producer states them
fun stated(o: *Object, argv: **u8, n: usize) err[Fail] {
    var i: usize = 0;
    for (i + 1 < n) {
        val x: res[*Axis, Fail] = list.axis_by_name(argv[i]);
        if (sel x.err) { ret err[Fail].err{fail.about(x.err, argv[i])}; }
        val s: res[Setting, Fail] = setting_of(x.ok, argv[i + 1]);
        if (sel s.err) { ret err[Fail].err{s.err}; }
        val r: err[Fail] = object.state(o, x.ok, s.ok);
        if (sel r.err) { ret r; }
        i = i + 2;
    }
    if (i != n) { ret err[Fail].err{fail.malformed("an axis is named without a value")}; }
    ret err[Fail].ok{};
}

# whether `a` and `b` state the same value on `x`, or both leave it unstated
fun same_on(a: *Object, b: *Object, x: *Axis) bool {
    val p: opt[Setting] = object.stated(a, x);
    val q: opt[Setting] = object.stated(b, x);
    if (sel p.none) { ret sel q.none; }
    if (sel q.none) { ret false; }
    ret compare.same_setting(a, p.some, b, q.some);
}

# print what differs between `built` and `back`, the object the file written
# from it reads back as, and the axes they state differently
fun differences(a: *A.Allocator, built: *Object, back: *Object) i64 {
    val d: res[str, Fail] = compare.difference(a, built, back);
    if (sel d.err)   { ret report(a, d.err); }
    if (d.ok == nil) { print.println("difference none"); }
    or               { print.printlnf("difference {}", d.ok); }
    var i: usize = 0;
    for (i < built.target.arch.axis_count) {
        val x: *Axis = built.target.arch.axes[i];
        i = i + 1;
        if (!same_on(built, back, x)) { print.printlnf("trait-difference {}", x.name); }
    }
    ret 0;
}

# the e_flags bits the object states beside its traits
fun raw_flags(o: *Object) u64 {
    val f: opt[*Fact] = object.fact(o, ?format.ELF, fact.FLAGS);
    if (sel f.some) { ret f.some.value; }
    ret 0;
}

fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    if (argc < 3) {
        print.print(USAGE);
        ret 2;
    }
    val l: res[Loaded, Fail] = file.load(a, argv[1]);
    if (sel l.err) { ret report(a, l.err); }
    var ld: Loaded         = l.ok;
    val r:  res[Elf, Fail] = read.read(a, ?ld.input);
    if (sel r.err) { ret report(a, r.err); }
    var m: Elf       = r.ok;
    var o: Object    = object.make(a, nil);
    val c: err[Fail] = elf_neutral.to_neutral(?m, ?o);
    if (sel c.err) { ret report(a, fail.in_file(c.err, argv[1])); }
    print.printlnf("input {} e_flags 0x{:x}", o.target.arch.name, m.header.flags);
    show(a, ?o);
    print.printlnf("raw e_flags 0x{:x}", raw_flags(?o));

    table.clear[Trait](?o.traits);
    val st: err[Fail] = stated(?o, ?argv[3], (argc - 3)::usize);
    if (sel st.err) { ret report(a, st.err); }
    val built: res[Elf, Fail] = elf_neutral.from_neutral(a, ?o, ?o.target, opt[*Lowering].some{?elf_neutral.LOWERING});
    if (sel built.err) { ret report(a, fail.in_file(built.err, argv[2])); }
    var out: Elf             = built.ok;
    val w:   res[Sink, Fail] = elf_write.write(a, ?out);
    if (sel w.err) { ret report(a, fail.in_file(w.err, argv[2])); }
    var bytes: Sink      = w.ok;
    val sv:    err[Fail] = file.save(argv[2], ?bytes);
    if (sel sv.err) { ret report(a, sv.err); }
    print.printlnf("output e_flags 0x{:x}", out.header.flags);
    show(a, ?o);

    var in: Input          = Input{file: argv[2], data: sink.data(?bytes), len: sink.len(?bytes)};
    val rd: res[Elf, Fail] = read.read(a, ?in);
    if (sel rd.err) { ret report(a, rd.err); }
    var again: Elf       = rd.ok;
    var back:  Object    = object.make(a, nil);
    val cb:    err[Fail] = elf_neutral.to_neutral(?again, ?back);
    if (sel cb.err) { ret report(a, fail.in_file(cb.err, argv[2])); }
    ret differences(a, ?o, ?back);
}

# every allocation lives in the heap, which is given back whole when the run ends
pub fun main(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret 2; }
    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret 2; }
    val code: i64          = run(?a, argc, argv);
    val dn:   err[A.Error] = heap.dnit(?h);
    if (sel dn.err) { ret 2; }
    ret code;
}
