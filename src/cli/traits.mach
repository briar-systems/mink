# the oracle lane of the ELF trait encodings, one object per run
#
# `traits <input> <output> [<axis> <value>]...` reads an ELF object, converts
# it to the neutral object and prints the traits it states and the e_flags bits
# no row maps, then builds an ELF file from the neutral object stating exactly
# the traits named on the command line, as a producer states them. a value is a
# choice of the axis, or `set` or `clear` for a flag. test/traits.sh drives it. it runs locally and is never part of
# CI.

use std.print;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.heap;
use fs: std.filesystem;

use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.format;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Choice;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.diag;
use mink.elf.model.Elf;
use elf_neutral: mink.elf.neutral;
use mink.elf.read;
use elf_write: mink.elf.write;
use mink.fail;
use mink.fail.Fail;
use mink.format.file;
use mink.format.file.Loaded;
use mink.model.object;
use mink.model.object.Fact;
use mink.model.object.Object;
use mink.reader.LITTLE;
use mink.sink;
use mink.sink.Sink;
use mink.table;
use mink.table.Table;

val USAGE: str = "usage: traits <input> <output> [<axis> <value>]...\n";

fun report(a: *A.Allocator, f: Fail) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val r: err[Fail] = diag.render(f, ?s);
    if (sel r.err) { ret 2; }
    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    ret 1;
}

fun show(ts: *Table[Trait]) {
    var i: usize = 0;
    for (i < table.count[Trait](ts)) {
        val t: *Trait = table.at[Trait](ts, table.nth[Trait](i));
        i = i + 1;
        if (sel t.setting.choice) {
            print.printlnf("{} {}", t.axis.name, t.setting.choice.name);
            cnt;
        }
        if (t.setting.flag) { print.printlnf("{} set", t.axis.name); }
        or                  { print.printlnf("{} clear", t.axis.name); }
    }
}

# the setting `value` names on `x`
fun setting_of(x: *Axis, value: str) res[Setting, Fail] {
    if (x.flag && str_equals(value, "set"))   { ret res[Setting, Fail].ok{Setting.flag{true}}; }
    if (x.flag && str_equals(value, "clear")) { ret res[Setting, Fail].ok{Setting.flag{false}}; }
    val c: opt[*Choice] = trait.choice_named(x, value);
    if (sel c.some) { ret res[Setting, Fail].ok{Setting.choice{c.some}}; }
    ret res[Setting, Fail].err{fail.about(fail.malformed("the trait axis has no such value"), x.name)};
}

# the traits the `n` operand pairs at `argv` state for an object for `a`
fun stated(a: *Arch, argv: **u8, n: usize, out: *Table[Trait]) err[Fail] {
    var i: usize = 0;
    for (i + 1 < n) {
        val x: res[*Axis, Fail] = arch.axis_by_name(argv[i]);
        if (sel x.err) { ret err[Fail].err{fail.about(x.err, argv[i])}; }
        if (!arch.has_axis(a, x.ok)) {
            ret err[Fail].err{fail.about(fail.malformed("the architecture has no such trait axis"), x.ok.name)};
        }
        val s: res[Setting, Fail] = setting_of(x.ok, argv[i + 1]);
        if (sel s.err) { ret err[Fail].err{s.err}; }
        val r: err[Fail] = trait.add(out, Trait{axis: x.ok, setting: s.ok});
        if (sel r.err) { ret r; }
        i = i + 2;
    }
    if (i != n) { ret err[Fail].err{fail.malformed("an axis is named without a value")}; }
    ret err[Fail].ok{};
}

# the e_flags bits the object states beside its traits
fun raw_flags(o: *Object) u64 {
    val f: opt[*Fact] = object.fact(o, ?format.ELF, elf_neutral.FLAGS);
    if (sel f.some) { ret f.some.value; }
    ret 0;
}

fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    if (argc < 3) {
        print.print(USAGE);
        ret 2;
    }
    val l: res[Loaded, Fail] = file.load(a, argv[1]);
    if (sel l.err) { ret report(a, l.err); }
    var ld: Loaded         = l.ok;
    val r:  res[Elf, Fail] = read.read(a, ?ld.input);
    if (sel r.err) { ret report(a, r.err); }
    var m: Elf       = r.ok;
    var o: Object    = object.make(a, nil);
    val c: err[Fail] = elf_neutral.to_neutral(?m, ?o);
    if (sel c.err) { ret report(a, fail.in_file(c.err, argv[1])); }
    print.printlnf("input {} e_flags 0x{:x}", o.arch.name, m.header.flags);
    show(?o.traits);
    print.printlnf("raw e_flags 0x{:x}", raw_flags(?o));

    table.clear[Trait](?o.traits);
    val st: err[Fail] = stated(o.arch, ?argv[3], (argc - 3)::usize, ?o.traits);
    if (sel st.err) { ret report(a, st.err); }
    val built: res[Elf, Fail] = elf_neutral.from_neutral(a, ?o);
    if (sel built.err) { ret report(a, fail.in_file(built.err, argv[2])); }
    var out: Elf             = built.ok;
    val w:   res[Sink, Fail] = elf_write.write(a, ?out);
    if (sel w.err) { ret report(a, fail.in_file(w.err, argv[2])); }
    val sv: err[Fail] = file.save(argv[2], ?w.ok);
    if (sel sv.err) { ret report(a, sv.err); }
    print.printlnf("output e_flags 0x{:x}", out.header.flags);
    show(?o.traits);
    ret 0;
}

# every allocation lives in the heap, which is given back whole when the run ends
pub fun main(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret 2; }
    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret 2; }
    val code: i64          = run(?a, argc, argv);
    val dn:   err[A.Error] = heap.dnit(?h);
    if (sel dn.err) { ret 2; }
    ret code;
}
