# the oracle lane of the ELF trait encodings, one object per run
#
# `traits <input> <output> [<axis> <value>]...` reads an ELF object, prints
# the traits its e_flags and GNU properties state and the e_flags bits no row
# maps, then writes it to the output stating exactly the traits named on the
# command line, as a producer states them, over those raw bits. a value is a
# choice of the axis, or `set` or `clear` for a flag. the lane writes e_flags
# only, so a trait that needs a GNU property the input does not hold as it is
# is refused. test/traits.sh drives it. it runs locally and is never part of
# CI.

use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.heap;
use fs: std.filesystem;

use mink.catalog.arch;
use mink.catalog.arch.Arch;
use mink.catalog.trait;
use mink.catalog.trait.Axis;
use mink.catalog.trait.Choice;
use mink.catalog.trait.Setting;
use mink.catalog.trait.Trait;
use mink.diag;
use mink.elf.model.Elf;
use mink.elf.read;
use mink.elf.traits;
use mink.elf.traits.Word;
use mink.elf.traits.Words;
use elf_write: mink.elf.write;
use mink.fail;
use mink.fail.Fail;
use mink.format.file;
use mink.format.file.Loaded;
use mink.reader.LITTLE;
use mink.sink;
use mink.sink.Sink;
use mink.table;
use mink.table.Table;

val USAGE: str = "usage: traits <input> <output> [<axis> <value>]...\n";

fun report(a: *A.Allocator, f: Fail) i64 {
    var s: Sink      = sink.make(a, LITTLE);
    val r: err[Fail] = diag.render(f, ?s);
    if (sel r.err) { ret 2; }
    val e: err[Fail] = file.emit(fs.STDERR, ?s);
    ret 1;
}

fun show(ts: *Table[Trait]) {
    var i: usize = 0;
    for (i < table.count[Trait](ts)) {
        val t: *Trait = table.at[Trait](ts, table.nth[Trait](i));
        i = i + 1;
        if (sel t.setting.choice) {
            print.printlnf("{} {}", t.axis.name, t.setting.choice.name);
            cnt;
        }
        if (t.setting.flag) { print.printlnf("{} set", t.axis.name); }
        or                  { print.printlnf("{} clear", t.axis.name); }
    }
}

# the setting `value` names on `x`
fun setting_of(x: *Axis, value: str) res[Setting, Fail] {
    if (x.flag && str_equals(value, "set"))   { ret res[Setting, Fail].ok{Setting.flag{true}}; }
    if (x.flag && str_equals(value, "clear")) { ret res[Setting, Fail].ok{Setting.flag{false}}; }
    val c: opt[*Choice] = trait.choice_named(x, value);
    if (sel c.some) { ret res[Setting, Fail].ok{Setting.choice{c.some}}; }
    ret res[Setting, Fail].err{fail.about(fail.malformed("the trait axis has no such value"), x.name)};
}

# the traits the `n` operand pairs at `argv` state for an object for `a`
fun stated(a: *Arch, argv: **u8, n: usize, out: *Table[Trait]) err[Fail] {
    var i: usize = 0;
    for (i + 1 < n) {
        val x: res[*Axis, Fail] = arch.axis_by_name(argv[i]);
        if (sel x.err) { ret err[Fail].err{fail.about(x.err, argv[i])}; }
        if (!arch.has_axis(a, x.ok)) {
            ret err[Fail].err{fail.about(fail.malformed("the architecture has no such trait axis"), x.ok.name)};
        }
        val s: res[Setting, Fail] = setting_of(x.ok, argv[i + 1]);
        if (sel s.err) { ret err[Fail].err{s.err}; }
        val r: err[Fail] = trait.add(out, Trait{axis: x.ok, setting: s.ok});
        if (sel r.err) { ret r; }
        i = i + 2;
    }
    if (i != n) { ret err[Fail].err{fail.malformed("an axis is named without a value")}; }
    ret err[Fail].ok{};
}

# whether `w` holds the same one-word properties as `was`
fun same_words(w: *Words, was: *Words) bool {
    if (table.count[Word](?w.properties) != table.count[Word](?was.properties)) { ret false; }
    var i: usize = 0;
    for (i < table.count[Word](?w.properties)) {
        val p: *Word = table.at[Word](?w.properties, table.nth[Word](i));
        val q: *Word = table.at[Word](?was.properties, table.nth[Word](i));
        if (p.type != q.type || p.value != q.value) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun run(a: *A.Allocator, argc: i64, argv: **u8) i64 {
    if (argc < 3) {
        print.print(USAGE);
        ret 2;
    }
    val l: res[Loaded, Fail] = file.load(a, argv[1]);
    if (sel l.err) { ret report(a, l.err); }
    var ld: Loaded         = l.ok;
    val r:  res[Elf, Fail] = read.read(a, ?ld.input);
    if (sel r.err) { ret report(a, r.err); }
    var m:  Elf              = r.ok;
    val at: res[*Arch, Fail] = traits.arch_of(?m);
    if (sel at.err) { ret report(a, fail.in_file(at.err, argv[1])); }

    var held: Words        = traits.make_words(a, 0);
    var read: Table[Trait] = table.make[Trait](a);
    val ws:   err[Fail]    = traits.words_of(?m, ?held);
    if (sel ws.err) { ret report(a, fail.in_file(ws.err, argv[1])); }
    var was: Words     = traits.make_words(a, 0);
    val wc:  err[Fail] = traits.words_of(?m, ?was);
    if (sel wc.err) { ret report(a, fail.in_file(wc.err, argv[1])); }
    val d: err[Fail] = traits.decode(at.ok, ?held, ?read);
    if (sel d.err) { ret report(a, fail.in_file(d.err, argv[1])); }
    print.printlnf("input {} e_flags 0x{:x}", at.ok.name, m.header.flags);
    show(?read);
    print.printlnf("raw e_flags 0x{:x}", held.flags);

    var want: Table[Trait] = table.make[Trait](a);
    val st:   err[Fail]    = stated(at.ok, ?argv[3], (argc - 3)::usize, ?want);
    if (sel st.err) { ret report(a, st.err); }
    val e: err[Fail] = traits.encode(at.ok, ?want, ?held);
    if (sel e.err) { ret report(a, fail.in_file(e.err, argv[2])); }
    if (!same_words(?held, ?was)) {
        ret report(a, fail.in_file(fail.unsupported("the lane writes e_flags, not GNU property notes"), argv[2]));
    }
    m.header.flags = held.flags;
    var out: res[Sink, Fail] = elf_write.write(a, ?m);
    if (sel out.err) { ret report(a, fail.in_file(out.err, argv[2])); }
    val sv: err[Fail] = file.save(argv[2], ?out.ok);
    if (sel sv.err) { ret report(a, sv.err); }
    print.printlnf("output e_flags 0x{:x}", m.header.flags);
    show(?want);
    ret 0;
}

# every allocation lives in the heap, which is given back whole when the run ends
pub fun main(argc: i64, argv: **u8) i64 {
    var src: heap.Source;
    var h:   heap.Heap;
    var a:   A.Allocator;
    heap.native_source(?src);
    val i: err[A.Error] = heap.init(?h, ?src, 0);
    if (sel i.err) { ret 2; }
    val m: err[A.Error] = heap.make(?a, ?h);
    if (sel m.err) { ret 2; }
    val code: i64          = run(?a, argc, argv);
    val dn:   err[A.Error] = heap.dnit(?h);
    if (sel dn.err) { ret 2; }
    ret code;
}
