# distances over code the linker may resize, one owner for every lowering
#
# a relocation whose kind lets the linker resize the code it marks, as RISC-V
# relaxation deletes bytes, leaves no fixed distance between two places of its
# section it lies between until the link lays it out. a lowering writes such a
# distance as a difference relocation between labels at the two places, which
# the format writes as its set's pair of records and the linker recomputes.
# the width is the narrowest the set has a difference row for among those the
# encoding takes, never one an architecture names. a distance over code with
# no such relocation is fixed, and a lowering writes it as a number.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.sort;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.vectors;
use mink.lower.lowered;
use mink.lower.lowered.Added;
use mink.lower.lowered.Aim;
use mink.lower.lowered.Fixup;
use mink.lower.lowered.Lowered;
use mink.model.object.Object;
use mink.model.object.Reloc;
use mink.model.object.Section;
use mink.model.reloc;
use mink.reloc.row;
use mink.reloc.row.Lookup;
use mink.reloc.row.Pairing;

# where the linker may resize the code of an object: the place of each
# relocation whose kind lets it, ascending by section and offset, made in one
# pass over the relocations and one sort
pub rec Resizing {
    places: Vector[Resizable];
}

# section: the section the relocation lies in
# offset:  where in it
pub rec Resizable {
    section: u32;
    offset:  u64;
}

fun order_places(a: *Resizable, b: *Resizable) i64 {
    if (a.section < b.section) { ret -1; }
    if (a.section > b.section) { ret 1; }
    if (a.offset < b.offset)   { ret -1; }
    if (a.offset > b.offset)   { ret 1; }
    ret 0;
}

pub fun resizing(a: *A.Allocator, o: *Object) res[Resizing, Fail] {
    var r: Resizing = Resizing{places: vector.init[Resizable](a)};
    val n: usize    = table.count[Section](?o.sections);
    var i: usize    = 0;
    for (i < table.count[Reloc](?o.relocs)) {
        val x: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc](i));
        i = i + 1;
        if (!reloc.has(x.kind, reloc.RESIZES)) { cnt; }
        if (x.section.index::usize >= n) {
            val dropped: err[Fail] = release(?r);
            ret res[Resizing, Fail].err{fail.in_indexed(fail.malformed("relocation names a section the object does not have"), "relocation", (i - 1)::u64)};
        }
        val p: err[Fail] = vectors.push[Resizable](?r.places, Resizable{section: x.section.index, offset: x.offset});
        if (sel p.err) {
            val dropped: err[Fail] = release(?r);
            ret res[Resizing, Fail].err{p.err};
        }
    }
    sort.sort_by[Resizable](r.places.data, vector.length[Resizable](?r.places), order_places);
    ret res[Resizing, Fail].ok{r};
}

# the index of the first place of `r` at or past `offset` of section `s`
fun first_at(r: *Resizing, s: Id[Section], offset: u64) usize {
    val probe: Resizable = Resizable{section: s.index, offset: offset};
    var lo:    usize     = 0;
    var hi:    usize     = vector.length[Resizable](?r.places);
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (order_places(?r.places.data[mid], ?probe) < 0) { lo = mid + 1; }
        or                                                 { hi = mid; }
    }
    ret lo;
}

# whether the linker may resize any code of section `s`
pub fun resizes(r: *Resizing, s: Id[Section]) bool {
    val at: usize = first_at(r, s, 0);
    ret at < vector.length[Resizable](?r.places) && r.places.data[at].section == s.index;
}

# whether the linker may resize code of section `s` from offset `from` up to
# `to`, so the distance between the two is not fixed until the link
pub fun resizes_between(r: *Resizing, s: Id[Section], from: u64, to: u64) bool {
    val at: usize = first_at(r, s, from);
    ret at < vector.length[Resizable](?r.places) && r.places.data[at].section == s.index && r.places.data[at].offset < to;
}

pub fun release(r: *Resizing) err[Fail] {
    ret vectors.release[Resizable](?r.places);
}

# the narrowest difference `set` writes among the `n` widths at `widths`,
# ascending bit counts the encoding takes, that holds `span`. none when the set
# has no difference of any of them that holds it
pub fun pick(set: *Lookup, widths: *u32, n: usize, span: u64) opt[Pairing] {
    var i: usize = 0;
    for (i < n) {
        val bits: u32 = widths[i];
        i = i + 1;
        if (bits < 64 && (span >> bits::u64) != 0) { cnt; }
        val p: opt[Pairing] = row.difference_in(set, bits);
        if (sel p.some) { ret p; }
    }
    ret opt[Pairing].none{};
}

# record in `out` the distance from `from` to `to` as the difference `p`,
# written at `offset` of the added section `sec`
pub fun record(out: *Lowered, sec: Id[Added], offset: u64, p: *Pairing, to: Aim, from: Aim) err[Fail] {
    val f: res[Id[Fixup], Fail] = lowered.add_fixup(out, Fixup{
        section: sec,
        offset:  offset,
        kind:    p.difference.kind,
        target:  to,
        minus:   opt[Aim].some{from},
    });
    if (sel f.err) { ret err[Fail].err{f.err}; }
    ret err[Fail].ok{};
}
