# distances over code the linker may resize, one owner for every lowering
#
# a section that holds a relocation whose kind lets the linker resize the code
# it marks, as RISC-V relaxation deletes bytes, has no fixed distance between
# two of its places until the link lays it out. a lowering writes such a
# distance as a difference relocation between labels at the two places, which
# the format writes as its set's pair of records and the linker recomputes.
# the width is the narrowest the set has a difference row for among those the
# encoding takes, never one an architecture names. a distance in a section
# with no such relocation is fixed, and a lowering writes it as a number.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.lower.lowered;
use mink.lower.lowered.Added;
use mink.lower.lowered.Fixup;
use mink.lower.lowered.Lowered;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Reloc;
use mink.model.object.Section;
use mink.model.reloc;
use mink.reloc.row;
use mink.reloc.row.Lookup;
use mink.reloc.row.Pairing;

# per section of an object, one when it holds a relocation that lets the
# linker resize its code, made in one pass over the relocations
pub rec Resizing {
    marked: Table[u8];
}

pub fun resizing(a: *A.Allocator, o: *Object) res[Resizing, Fail] {
    var r: Resizing          = Resizing{marked: table.make[u8](a)};
    val g: res[Id[u8], Fail] = table.grow[u8](?r.marked, table.count[Section](?o.sections));
    if (sel g.err) {
        val dropped: err[Fail] = release(?r);
        ret res[Resizing, Fail].err{g.err};
    }
    var i: usize = 0;
    for (i < table.count[Reloc](?o.relocs)) {
        val x: *Reloc = table.at[Reloc](?o.relocs, table.nth[Reloc](i));
        i = i + 1;
        if (!reloc.has(x.kind, reloc.RESIZES)) { cnt; }
        if (x.section.index::usize >= table.count[u8](?r.marked)) {
            val dropped: err[Fail] = release(?r);
            ret res[Resizing, Fail].err{fail.in_indexed(fail.malformed("relocation names a section the object does not have"), "relocation", (i - 1)::u64)};
        }
        table.items[u8](?r.marked)[x.section.index::usize] = 1;
    }
    ret res[Resizing, Fail].ok{r};
}

# whether the linker may resize the code of section `s`
pub fun resizes(r: *Resizing, s: Id[Section]) bool {
    ret table.items[u8](?r.marked)[s.index::usize] != 0;
}

pub fun release(r: *Resizing) err[Fail] {
    ret table.release[u8](?r.marked);
}

# the narrowest difference `set` writes among the `n` widths at `widths`,
# ascending bit counts the encoding takes, that holds `span`. none when the set
# has no difference of any of them that holds it
pub fun pick(set: *Lookup, widths: *u32, n: usize, span: u64) opt[*Pairing] {
    var i: usize = 0;
    for (i < n) {
        val bits: u32 = widths[i];
        i = i + 1;
        if (bits < 64 && (span >> bits::u64) != 0) { cnt; }
        val p: opt[*Pairing] = row.difference_in(set, bits);
        if (sel p.some) { ret p; }
    }
    ret opt[*Pairing].none{};
}

# record in `out` the distance from the label `from` to the label `to` as the
# difference `p`, written at `offset` of the added section `sec`
pub fun record(out: *Lowered, sec: Id[Added], offset: u64, p: *Pairing, to: Id[Place], from: Id[Place]) err[Fail] {
    val f: res[Id[Fixup], Fail] = lowered.add_fixup(out, Fixup{
        section: sec,
        offset:  offset,
        kind:    p.difference.kind,
        target:  to,
        minus:   opt[Id[Place]].some{from},
    });
    if (sel f.err) { ret err[Fail].err{f.err}; }
    ret err[Fail].ok{};
}
