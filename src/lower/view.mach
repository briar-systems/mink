# the DWARF location views of line rows, the one owner of how they count
#
# a consumer counts a row's view from the line program: zero at a sequence's
# start, after DW_LNE_set_address and after an advance that moves the address,
# one more than the row before after none, so a view tells apart the rows at
# one address. a reset row is zero, the table setting the address before it
# wherever the advance into it might not move the address. the line
# table of a sequence with a view advances by a number where the distance is
# fixed once the object is written, and where the linker may resize the code
# by a LEB128 difference it recomputes, which moves the address exactly when
# the final distance is not zero. a view after a number is counted when the table is written, and one
# after a difference only once the code is laid out, so a lowering for a link
# hands the rows of each sequence with a view to the link, which counts them
# on the final addresses once its layout settles.

use std.types.bool.bool;
use std.types.error.err;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.model.object.Place;
use mink.model.object.RowView;

# a row of a sequence with a view, as the link counts it
# ---
# at:    the row's place
# start: the row begins its sequence, after DW_LNE_set_address
# moves: the advance into the row is a difference the link recomputes. a row
#        after a number advances by its distance from the row before, and a
#        reset row by DW_LNE_set_address
# view:  what the row states of its view
pub rec Counted {
    at:    Place;
    start: bool;
    moves: bool;
    view:  RowView;
}

# how a lowering counts the views of its rows
# ---
# written: as the table is written, for an object no link of mink recounts. a
#          view past an advance over code the linker may resize has no count
#          yet and is refused
# linked:  by the link that lowers the object, once its layout settles. the
#          rows of each sequence with a view are appended to the table
pub tag Counting: u8 {
    written;
    linked: *Table[Counted];
}

# the view of a row stating `v` whose sequence's previous row has the view
# `previous`: zero at the sequence's start, at a reset or where the advance
# into it moved the address, and one more otherwise
pub fun next(previous: u64, start: bool, moved: bool, v: RowView) u64 {
    if (start || moved || sel v.reset) { ret 0; }
    ret previous + 1;
}

# refuse as malformed a row asserting a zero view whose view is `n`
pub fun holds(v: RowView, n: u64) err[Fail] {
    if (sel v.zero && n != 0) { ret err[Fail].err{fail.valued(fail.malformed("the row asserts a zero view and its view is not zero"), n::i128)}; }
    ret err[Fail].ok{};
}

# how many rows the counting holds, to give back what a refused lowering
# appended
pub fun mark(c: Counting) usize {
    if (sel c.linked) { ret table.count[Counted](c.linked); }
    ret 0;
}

# give back the rows appended since `m`
pub fun rollback(c: Counting, m: usize) {
    if (sel c.linked) { table.truncate[Counted](c.linked, m); }
}
