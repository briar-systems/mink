use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.model.section;
use mink.reloc.row;
use mink.reloc.row.Lookup;
use mink.reloc.row.Pairing;

val TAG_ARRAY:        u16 = 0x01;
val TAG_ENUMERATION:  u16 = 0x04;
val TAG_PARAMETER:    u16 = 0x05;
val TAG_MEMBER:       u16 = 0x0d;
val TAG_POINTER:      u16 = 0x0f;
val TAG_COMPILE_UNIT: u16 = 0x11;
val TAG_STRUCTURE:    u16 = 0x13;
val TAG_SUBROUTINE:   u16 = 0x15;
val TAG_UNION:        u16 = 0x17;
val TAG_VARIANT:      u16 = 0x19;
val TAG_INLINED:      u16 = 0x1d;
val TAG_SUBRANGE:     u16 = 0x21;
val TAG_BASE:         u16 = 0x24;
val TAG_ENUMERATOR:   u16 = 0x28;
val TAG_SUBPROGRAM:   u16 = 0x2e;
val TAG_VARIANT_PART: u16 = 0x33;
val TAG_VARIABLE:     u16 = 0x34;
val TAG_UNSPECIFIED:  u16 = 0x3b;

val AT_LOCATION:      u16 = 0x02;
val AT_NAME:          u16 = 0x03;
val AT_BYTE_SIZE:     u16 = 0x0b;
val AT_BIT_SIZE:      u16 = 0x0d;
val AT_STMT_LIST:     u16 = 0x10;
val AT_LOW_PC:        u16 = 0x11;
val AT_HIGH_PC:       u16 = 0x12;
val AT_LANGUAGE:      u16 = 0x13;
val AT_DISCR:         u16 = 0x15;
val AT_DISCR_VALUE:   u16 = 0x16;
val AT_COMP_DIR:      u16 = 0x1b;
val AT_CONST_VALUE:   u16 = 0x1c;
val AT_INLINE:        u16 = 0x20;
val AT_PRODUCER:      u16 = 0x25;
val AT_PROTOTYPED:    u16 = 0x27;
val AT_ABSTRACT:      u16 = 0x31;
val AT_COUNT:         u16 = 0x37;
val AT_MEMBER_AT:     u16 = 0x38;
val AT_DECL_FILE:     u16 = 0x3a;
val AT_DECL_LINE:     u16 = 0x3b;
val AT_DECLARATION:   u16 = 0x3c;
val AT_ENCODING:      u16 = 0x3e;
val AT_EXTERNAL:      u16 = 0x3f;
val AT_FRAME_BASE:    u16 = 0x40;
val AT_TYPE:          u16 = 0x49;
val AT_RANGES:        u16 = 0x55;
val AT_CALL_COLUMN:   u16 = 0x57;
val AT_CALL_FILE:     u16 = 0x58;
val AT_CALL_LINE:     u16 = 0x59;
val AT_STR_OFFSETS:   u16 = 0x72;
val AT_ADDR_BASE:     u16 = 0x73;
val AT_RNGLISTS_BASE: u16 = 0x74;
val AT_LOCLISTS_BASE: u16 = 0x8c;

val FORM_ADDR:     u8 = 0x01;
val FORM_DATA2:    u8 = 0x05;
val FORM_DATA4:    u8 = 0x06;
val FORM_DATA1:    u8 = 0x0b;
val FORM_FLAG:     u8 = 0x0c;
val FORM_UDATA:    u8 = 0x0f;
val FORM_REF4:     u8 = 0x13;
val FORM_SEC:      u8 = 0x17;
val FORM_EXPRLOC:  u8 = 0x18;
val FORM_PRESENT:  u8 = 0x19;
val FORM_STRX:     u8 = 0x1a;
val FORM_ADDRX:    u8 = 0x1b;
val FORM_LOCLISTX: u8 = 0x22;
val FORM_RNGLISTX: u8 = 0x23;

val OP_CONST4U:     u8 = 0x0c;
val OP_CONST8U:     u8 = 0x0e;
val OP_CONSTU:      u8 = 0x10;
val OP_AND:         u8 = 0x1a;
val OP_MINUS:       u8 = 0x1c;
val OP_PLUS:        u8 = 0x22;
val OP_SHL:         u8 = 0x24;
val OP_SHRA:        u8 = 0x26;
val OP_REG0:        u8 = 0x50;
val OP_BREG0:       u8 = 0x70;
val OP_REGX:        u8 = 0x90;
val OP_FBREG:       u8 = 0x91;
val OP_BREGX:       u8 = 0x92;
val OP_PIECE:       u8 = 0x93;
val OP_TLS_ADDRESS: u8 = 0x9b;
val OP_CFA:         u8 = 0x9c;
val OP_BIT_PIECE:   u8 = 0x9d;
val OP_STACK_VALUE: u8 = 0x9f;
val OP_ADDRX:       u8 = 0xa1;

# the registers below this number have an operation of their own
val SHORT_REGISTERS: u32 = 32;

# a webassembly location, the tool conventions' DW_OP_WASM_location and the
# kinds of index it takes
val OP_WASM_LOCATION: u8 = 0xed;
val WASM_LOCAL:       u8 = 0;
val WASM_OPERAND:     u8 = 2;

val LLE_END:         u8 = 0x00;
val LLE_STARTX_ENDX: u8 = 0x02;
val RLE_END:         u8 = 0x00;
val RLE_STARTX_ENDX: u8 = 0x02;

val ATE_ADDRESS:   u8 = 0x01;
val ATE_BOOLEAN:   u8 = 0x02;
val ATE_FLOAT:     u8 = 0x04;
val ATE_SIGNED:    u8 = 0x05;
val ATE_UNSIGNED:  u8 = 0x07;
val ATE_CHARACTER: u8 = 0x10;

val UT_COMPILE: u8  = 0x01;
val VERSION:    u16 = 5;
val INLINED:    u8  = 0x01;

# the bytes of a section offset in the 32-bit DWARF format
val OFFSET: u8 = 4;

# where each base attribute points past its section's header
val OFFSETS_BASE: i64 = 8;
val ADDRS_BASE:   i64 = 8;
val LISTS_BASE:   i64 = 12;

# the widths, in bits, a function's size may be written as a difference in
val SIZE_WIDTHS: [1]u32 = [1]u32{32};

rec Spec {
    at:   u16;
    form: u8;
}

# an abbreviation, whose code is its row's position plus one
# ---
# tag:      the tag of the entries it abbreviates
# children: whether they have children
# specs:    their attributes, in the order each entry writes them
# count:    how many
rec Abbrev {
    tag:      u16;
    children: bool;
    specs:    *Spec;
    count:    usize;
}

# a unit's language leads its attributes, so the abbreviation of a unit that
# states none is the same specs from the second
val UNIT_SPECS: [9]Spec = [9]Spec{
    Spec{at: AT_LANGUAGE, form: FORM_DATA2}, Spec{at: AT_PRODUCER, form: FORM_STRX}, Spec{at: AT_NAME, form: FORM_STRX},
    Spec{at: AT_COMP_DIR, form: FORM_STRX}, Spec{at: AT_LOW_PC, form: FORM_ADDR}, Spec{at: AT_RANGES, form: FORM_RNGLISTX},
    Spec{at: AT_STR_OFFSETS, form: FORM_SEC}, Spec{at: AT_ADDR_BASE, form: FORM_SEC}, Spec{at: AT_RNGLISTS_BASE, form: FORM_SEC},
};
val UNIT_LINE_SPECS: [11]Spec = [11]Spec{
    Spec{at: AT_LANGUAGE, form: FORM_DATA2}, Spec{at: AT_PRODUCER, form: FORM_STRX}, Spec{at: AT_NAME, form: FORM_STRX},
    Spec{at: AT_COMP_DIR, form: FORM_STRX}, Spec{at: AT_LOW_PC, form: FORM_ADDR}, Spec{at: AT_RANGES, form: FORM_RNGLISTX},
    Spec{at: AT_STR_OFFSETS, form: FORM_SEC}, Spec{at: AT_ADDR_BASE, form: FORM_SEC}, Spec{at: AT_RNGLISTS_BASE, form: FORM_SEC},
    Spec{at: AT_LOCLISTS_BASE, form: FORM_SEC}, Spec{at: AT_STMT_LIST, form: FORM_SEC},
};
val UNIT_LOC_SPECS: [10]Spec = [10]Spec{
    Spec{at: AT_LANGUAGE, form: FORM_DATA2}, Spec{at: AT_PRODUCER, form: FORM_STRX}, Spec{at: AT_NAME, form: FORM_STRX},
    Spec{at: AT_COMP_DIR, form: FORM_STRX}, Spec{at: AT_LOW_PC, form: FORM_ADDR}, Spec{at: AT_RANGES, form: FORM_RNGLISTX},
    Spec{at: AT_STR_OFFSETS, form: FORM_SEC}, Spec{at: AT_ADDR_BASE, form: FORM_SEC}, Spec{at: AT_RNGLISTS_BASE, form: FORM_SEC},
    Spec{at: AT_LOCLISTS_BASE, form: FORM_SEC},
};
val SUBPROGRAM_SPECS: [4]Spec = [4]Spec{
    Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_LOW_PC, form: FORM_ADDRX}, Spec{at: AT_HIGH_PC, form: FORM_DATA4},
    Spec{at: AT_FRAME_BASE, form: FORM_EXPRLOC},
};
val NAMED_SPECS:    [2]Spec = [2]Spec{Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_TYPE, form: FORM_REF4}};
val LOCATED_SPECS:  [3]Spec = [3]Spec{Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_LOCATION, form: FORM_LOCLISTX}};
val DECLARED_SPECS: [4]Spec = [4]Spec{Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_DECL_FILE, form: FORM_DATA4}, Spec{at: AT_DECL_LINE, form: FORM_UDATA}};
val PLACED_SPECS:   [5]Spec = [5]Spec{
    Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_DECL_FILE, form: FORM_DATA4},
    Spec{at: AT_DECL_LINE, form: FORM_UDATA}, Spec{at: AT_LOCATION, form: FORM_LOCLISTX},
};
val BASE_SPECS:          [3]Spec = [3]Spec{Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_ENCODING, form: FORM_DATA1}, Spec{at: AT_BYTE_SIZE, form: FORM_UDATA}};
val BITS_SPECS:          [3]Spec = [3]Spec{Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_ENCODING, form: FORM_DATA1}, Spec{at: AT_BIT_SIZE, form: FORM_UDATA}};
val AGGREGATE_SPECS:     [2]Spec = [2]Spec{Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_BYTE_SIZE, form: FORM_UDATA}};
val MEMBER_SPECS:        [3]Spec = [3]Spec{Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_MEMBER_AT, form: FORM_UDATA}};
val PART_SPECS:          [1]Spec = [1]Spec{Spec{at: AT_DISCR, form: FORM_REF4}};
val VARIANT_SPECS:       [1]Spec = [1]Spec{Spec{at: AT_DISCR_VALUE, form: FORM_UDATA}};
val ENUM_SPECS:          [3]Spec = [3]Spec{Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_BYTE_SIZE, form: FORM_UDATA}};
val ENUMERATOR_SPECS:    [2]Spec = [2]Spec{Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_CONST_VALUE, form: FORM_UDATA}};
val TYPED_SPECS:         [1]Spec = [1]Spec{Spec{at: AT_TYPE, form: FORM_REF4}};
val COUNT_SPECS:         [1]Spec = [1]Spec{Spec{at: AT_COUNT, form: FORM_UDATA}};
val POINTER_SPECS:       [2]Spec = [2]Spec{Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_BYTE_SIZE, form: FORM_UDATA}};
val DECLARED_TYPE_SPECS: [2]Spec = [2]Spec{Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_DECLARATION, form: FORM_PRESENT}};
val UNSPECIFIED_SPECS:   [1]Spec = [1]Spec{Spec{at: AT_NAME, form: FORM_STRX}};
val SIZED_SPECS:         [1]Spec = [1]Spec{Spec{at: AT_BYTE_SIZE, form: FORM_UDATA}};
val ROUTINE_SPECS:       [2]Spec = [2]Spec{Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_PROTOTYPED, form: FORM_PRESENT}};
val VOID_SPECS:          [1]Spec = [1]Spec{Spec{at: AT_PROTOTYPED, form: FORM_PRESENT}};
val ABSTRACT_SPECS:      [2]Spec = [2]Spec{Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_INLINE, form: FORM_DATA1}};
val INLINED_SPECS:       [2]Spec = [2]Spec{Spec{at: AT_ABSTRACT, form: FORM_REF4}, Spec{at: AT_RANGES, form: FORM_RNGLISTX}};
val CALLED_SPECS:        [5]Spec = [5]Spec{
    Spec{at: AT_ABSTRACT, form: FORM_REF4}, Spec{at: AT_RANGES, form: FORM_RNGLISTX}, Spec{at: AT_CALL_FILE, form: FORM_DATA4},
    Spec{at: AT_CALL_LINE, form: FORM_UDATA}, Spec{at: AT_CALL_COLUMN, form: FORM_UDATA},
};
# a global at the unit's scope: located, then with no location for the bare
# abbreviation, and declared, each with its declaration's place for a unit of
# line records
val GLOBAL_SPECS: [4]Spec = [4]Spec{
    Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_EXTERNAL, form: FORM_FLAG},
    Spec{at: AT_LOCATION, form: FORM_EXPRLOC},
};
val GLOBAL_DECLARED_SPECS: [4]Spec = [4]Spec{
    Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_EXTERNAL, form: FORM_FLAG},
    Spec{at: AT_DECLARATION, form: FORM_PRESENT},
};
val GLOBAL_LINE_SPECS: [6]Spec = [6]Spec{
    Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_EXTERNAL, form: FORM_FLAG},
    Spec{at: AT_DECL_FILE, form: FORM_DATA4}, Spec{at: AT_DECL_LINE, form: FORM_UDATA}, Spec{at: AT_LOCATION, form: FORM_EXPRLOC},
};
val GLOBAL_LINE_DECLARED_SPECS: [6]Spec = [6]Spec{
    Spec{at: AT_NAME, form: FORM_STRX}, Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_EXTERNAL, form: FORM_FLAG},
    Spec{at: AT_DECL_FILE, form: FORM_DATA4}, Spec{at: AT_DECL_LINE, form: FORM_UDATA}, Spec{at: AT_DECLARATION, form: FORM_PRESENT},
};

# the abbreviation codes, each its row's position in ABBREVS plus one
val A_UNIT_LOC:   u32 = 2;
val A_UNIT_LINE:  u32 = 3;
val A_SUBPROGRAM: u32 = 4;
# a variable, then a parameter, each named, located, declared, and both
val A_VARIABLE:   u32 = 5;
val A_PARAMETER:  u32 = 9;
val A_BASE:       u32 = 13;
val A_STRUCTURE:  u32 = 14;
val A_UNION:      u32 = 15;
val A_MEMBER:     u32 = 16;
val A_PART:       u32 = 17;
val A_VARIANT:    u32 = 18;
val A_ENUM:       u32 = 19;
val A_ENUMERATOR: u32 = 20;
val A_ARRAY:      u32 = 21;
val A_SUBRANGE:   u32 = 22;
val A_POINTER:    u32 = 23;
val A_OPAQUE:     u32 = 24;
val A_ROUTINE:    u32 = 25;
val A_VOID:       u32 = 26;
val A_ARGUMENT:   u32 = 27;
val A_ABSTRACT:   u32 = 28;
val A_INLINED:    u32 = 29;
val A_CALLED:     u32 = 30;
# a base type of a width no whole number of bytes holds
val A_BITS: u32 = 31;
# a unit that states no source language
val A_UNIT_LOC_UNSTATED:  u32 = 32;
val A_UNIT_LINE_UNSTATED: u32 = 33;
# a global located, bare and declared, then each with its declaration's place
val A_GLOBAL:        u32 = 34;
val GLOBAL_LOCATED:  u32 = 0;
val GLOBAL_BARE:     u32 = 1;
val GLOBAL_DECLARED: u32 = 2;
val GLOBAL_PLACED:   u32 = 3;
# a type declared and never defined
val A_STRUCTURE_DECLARED: u32 = 40;
val A_UNION_DECLARED:     u32 = 41;
val A_ENUM_DECLARED:      u32 = 42;
val A_UNSPECIFIED:        u32 = 43;

val ABBREV_COUNT: usize = 43;

val ABBREVS: [ABBREV_COUNT]Abbrev = [ABBREV_COUNT]Abbrev{
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_SPECS[0], count: 9},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_LOC_SPECS[0], count: 10},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_LINE_SPECS[0], count: 11},
    Abbrev{tag: TAG_SUBPROGRAM, children: true, specs: ?SUBPROGRAM_SPECS[0], count: 4},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?NAMED_SPECS[0], count: 2},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?LOCATED_SPECS[0], count: 3},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?DECLARED_SPECS[0], count: 4},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?PLACED_SPECS[0], count: 5},
    Abbrev{tag: TAG_PARAMETER, children: false, specs: ?NAMED_SPECS[0], count: 2},
    Abbrev{tag: TAG_PARAMETER, children: false, specs: ?LOCATED_SPECS[0], count: 3},
    Abbrev{tag: TAG_PARAMETER, children: false, specs: ?DECLARED_SPECS[0], count: 4},
    Abbrev{tag: TAG_PARAMETER, children: false, specs: ?PLACED_SPECS[0], count: 5},
    Abbrev{tag: TAG_BASE, children: false, specs: ?BASE_SPECS[0], count: 3},
    Abbrev{tag: TAG_STRUCTURE, children: true, specs: ?AGGREGATE_SPECS[0], count: 2},
    Abbrev{tag: TAG_UNION, children: true, specs: ?AGGREGATE_SPECS[0], count: 2},
    Abbrev{tag: TAG_MEMBER, children: false, specs: ?MEMBER_SPECS[0], count: 3},
    Abbrev{tag: TAG_VARIANT_PART, children: true, specs: ?PART_SPECS[0], count: 1},
    Abbrev{tag: TAG_VARIANT, children: true, specs: ?VARIANT_SPECS[0], count: 1},
    Abbrev{tag: TAG_ENUMERATION, children: true, specs: ?ENUM_SPECS[0], count: 3},
    Abbrev{tag: TAG_ENUMERATOR, children: false, specs: ?ENUMERATOR_SPECS[0], count: 2},
    Abbrev{tag: TAG_ARRAY, children: true, specs: ?TYPED_SPECS[0], count: 1},
    Abbrev{tag: TAG_SUBRANGE, children: false, specs: ?COUNT_SPECS[0], count: 1},
    Abbrev{tag: TAG_POINTER, children: false, specs: ?POINTER_SPECS[0], count: 2},
    Abbrev{tag: TAG_POINTER, children: false, specs: ?SIZED_SPECS[0], count: 1},
    Abbrev{tag: TAG_SUBROUTINE, children: true, specs: ?ROUTINE_SPECS[0], count: 2},
    Abbrev{tag: TAG_SUBROUTINE, children: true, specs: ?VOID_SPECS[0], count: 1},
    Abbrev{tag: TAG_PARAMETER, children: false, specs: ?TYPED_SPECS[0], count: 1},
    Abbrev{tag: TAG_SUBPROGRAM, children: false, specs: ?ABSTRACT_SPECS[0], count: 2},
    Abbrev{tag: TAG_INLINED, children: true, specs: ?INLINED_SPECS[0], count: 2},
    Abbrev{tag: TAG_INLINED, children: true, specs: ?CALLED_SPECS[0], count: 5},
    Abbrev{tag: TAG_BASE, children: false, specs: ?BITS_SPECS[0], count: 3},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_LOC_SPECS[1], count: 9},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_LINE_SPECS[1], count: 10},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?GLOBAL_SPECS[0], count: 4},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?GLOBAL_SPECS[0], count: 3},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?GLOBAL_DECLARED_SPECS[0], count: 4},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?GLOBAL_LINE_SPECS[0], count: 6},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?GLOBAL_LINE_SPECS[0], count: 5},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?GLOBAL_LINE_DECLARED_SPECS[0], count: 6},
    Abbrev{tag: TAG_STRUCTURE, children: false, specs: ?DECLARED_TYPE_SPECS[0], count: 2},
    Abbrev{tag: TAG_UNION, children: false, specs: ?DECLARED_TYPE_SPECS[0], count: 2},
    Abbrev{tag: TAG_ENUMERATION, children: false, specs: ?DECLARED_TYPE_SPECS[0], count: 2},
    Abbrev{tag: TAG_UNSPECIFIED, children: false, specs: ?UNSPECIFIED_SPECS[0], count: 1},
};

# the order the sections are added in, each its id's offset from the first
val S_ABBREV:  u32 = 0;
val S_INFO:    u32 = 1;
val S_STRINGS: u32 = 2;
val S_OFFSETS: u32 = 3;
val S_ADDRS:   u32 = 4;
val S_LOCS:    u32 = 5;
val S_RNGS:    u32 = 6;

# a reference to a type's entry waiting for the entry's offset
rec Wait {
    at:   usize;
    type: Id[debug.Type];
}

# what one encoding shares
# ---
# o:         the object
# d:         its debug records
# set:       the relocations the object's pair writes
# row:       the format's row
# address:   the bytes of an address
# out:       the record the sections are added to
# unit:      the unit the records describe
# first:     the id the first section takes in `out`
# lines:     whether the object's line records lowered to a DWARF line
#            table, which DW_AT_stmt_list names and a declaration's file
#            indexes
# absolute:  the kind an address datum is relocated with
# resizing:  where the linker may resize code
# info:      the information entries
# abbrev:    the abbreviations
# strings:   the strings
# offsets:   the string offsets, one per string
# addrs:     the address table, one datum per mark or symbol
# locs:      the location lists, before their header
# rngs:      the range lists, before their header
# lists:     the list being written
# expr:      the expression being written
# named:     per name, its string's index plus one, zero for one not yet
#            written
# strings_n: how many strings are written
# at_mark:   per mark, its address's index plus one
# at_symbol: per symbol, its address's index plus one
# addresses: how many addresses are written
# labels:    per mark, its label in `out` plus one
# loclists:  each location list's offset from the first, in index order
# rnglists:  each range list's offset from the first, in index order
# entries:   each type's entry offset
# waits:     the references waiting for a type's offset
# origins:   per name, the offset of the abstract entry of the callee of
#            that name plus one
# stamps:    per site, the scope it was last seen in
# scope:     the last scope given out
rec Ctx {
    o:         *Object;
    d:         *Debug;
    set:       *Lookup;
    row:       *DwarfInfo;
    address:   u8;
    out:       *Lowered;
    unit:      debug.Unit;
    first:     u32;
    lines:     bool;
    absolute:  *Kind;
    resizing:  Resizing;
    info:      Sink;
    abbrev:    Sink;
    strings:   Sink;
    offsets:   Sink;
    addrs:     Sink;
    locs:      Sink;
    rngs:      Sink;
    lists:     Sink;
    expr:      Sink;
    named:     Vector[u32];
    strings_n: u32;
    at_mark:   Vector[u32];
    at_symbol: Vector[u32];
    addresses: u32;
    labels:    Vector[u32];
    loclists:  Vector[u32];
    rnglists:  Vector[u32];
    entries:   Vector[u32];
    waits:     Vector[Wait];
    origins:   Vector[u32];
    stamps:    Vector[u32];
    scope:     u32;
}

# encode the debug records of `o` into `out` as DWARF 5 debugging
# information in the sections `row` names, for a target of `address`-byte
# addresses whose relocations `set` writes, after its line table when its
# line records lowered to one. an object with no debug records adds nothing.
# a refusal adds nothing either:
# - malformed for a record naming a type, member, case, enumerator,
#   parameter, step, piece, variable, range, site, mark, symbol or file past
#   its table, for a function whose marks lie in two sections or end before
#   it starts, and for a site chain that loops
# - unsupported for a function over code the linker may resize when `set`
#   has no 32-bit difference, and for an address size no absolute kind has
# - overflow for sections larger than 32-bit DWARF offsets reach
pub fun encode(o: *Object, set: *Lookup, row: *DwarfInfo, address: u8, out: *Lowered) err[Fail] {
    val stated: opt[debug.Unit] = o.debug.unit;
    if (sel stated.none) { ret err[Fail].ok{}; }
    val unit: debug.Unit          = stated.some;
    val a:    *A.Allocator        = o.a;
    val rz:   res[Resizing, Fail] = difference.resizing(a, o);
    if (sel rz.err) { ret err[Fail].err{rz.err}; }
    var c: Ctx = Ctx{
        o:         o,
        d:         ?o.debug,
        set:       set,
        row:       row,
        address:   address,
        out:       out,
        unit:      unit,
        first:     lowered.next_section(out).index,
        lines:     sel out.lines.some,
        absolute:  ?reloc.ABS64,
        resizing:  rz.ok,
        info:      sink.make(a, o.target.arch.order),
        abbrev:    sink.make(a, o.target.arch.order),
        strings:   sink.make(a, o.target.arch.order),
        offsets:   sink.make(a, o.target.arch.order),
        addrs:     sink.make(a, o.target.arch.order),
        locs:      sink.make(a, o.target.arch.order),
        rngs:      sink.make(a, o.target.arch.order),
        lists:     sink.make(a, o.target.arch.order),
        expr:      sink.make(a, o.target.arch.order),
        named:     vector.init[u32](a),
        strings_n: 0,
        at_mark:   vector.init[u32](a),
        at_symbol: vector.init[u32](a),
        addresses: 0,
        labels:    vector.init[u32](a),
        loclists:  vector.init[u32](a),
        rnglists:  vector.init[u32](a),
        entries:   vector.init[u32](a),
        waits:     vector.init[Wait](a),
        origins:   vector.init[u32](a),
        stamps:    vector.init[u32](a),
        scope:     0,
    };
    val m:    Mark      = lowered.mark(out);
    val made: err[Fail] = written(?c);
    var r:    err[Fail] = made;
    if (sel made.ok) { r = added(?c); }
    or {
        r = fail.kept(r, sink.release(?c.info));
        r = fail.kept(r, sink.release(?c.abbrev));
        r = fail.kept(r, sink.release(?c.strings));
        r = fail.kept(r, sink.release(?c.offsets));
        r = fail.kept(r, sink.release(?c.addrs));
        r = fail.kept(r, sink.release(?c.locs));
        r = fail.kept(r, sink.release(?c.rngs));
    }
    val kept: err[Fail] = released(?c);
    if (sel r.err) {
        lowered.truncate(out, m);
        ret r;
    }
    ret kept;
}

fun released(c: *Ctx) err[Fail] {
    var r: err[Fail] = difference.release(?c.resizing);
    r = fail.kept(r, sink.release(?c.lists));
    r = fail.kept(r, sink.release(?c.expr));
    r = fail.kept(r, vectors.release[u32](?c.named));
    r = fail.kept(r, vectors.release[u32](?c.at_mark));
    r = fail.kept(r, vectors.release[u32](?c.at_symbol));
    r = fail.kept(r, vectors.release[u32](?c.labels));
    r = fail.kept(r, vectors.release[u32](?c.loclists));
    r = fail.kept(r, vectors.release[u32](?c.rnglists));
    r = fail.kept(r, vectors.release[u32](?c.entries));
    r = fail.kept(r, vectors.release[Wait](?c.waits));
    r = fail.kept(r, vectors.release[u32](?c.origins));
    ret fail.kept(r, vectors.release[u32](?c.stamps));
}

# the section of `index` of the encoding
fun sec(c: *Ctx, index: u32) Id[Added] {
    ret Id[Added]{index: c.first + index};
}

# add the sections in their order, each owned by `out` from then on
fun added(c: *Ctx) err[Fail] {
    val names: *InfoNames = c.row.names;
    var r:     err[Fail]  = add(c, names.abbrev, c.abbrev, S_ABBREV);
    r = fail.kept(r, add(c, names.info, c.info, S_INFO));
    r = fail.kept(r, add(c, names.strings, c.strings, S_STRINGS));
    r = fail.kept(r, add(c, names.offsets, c.offsets, S_OFFSETS));
    r = fail.kept(r, add(c, names.addresses, c.addrs, S_ADDRS));
    r = fail.kept(r, add(c, names.locations, c.locs, S_LOCS));
    ret fail.kept(r, add(c, names.ranges, c.rngs, S_RNGS));
}

fun add(c: *Ctx, name: str, bytes: Sink, index: u32) err[Fail] {
    val id: res[Id[Added], Fail] = lowered.add_section(c.out, Added{name: name, kind: ?section.DEBUG_INFO, flags: section.DEBUG_INFO.flags, align: 1, disposition: ?section.WHOLE, bytes: bytes, leader: opt[Id[object.Section]].none{}});
    if (sel id.err)                     { ret err[Fail].err{id.err}; }
    if (id.ok.index != c.first + index) { ret err[Fail].err{fail.internal("a debug section takes another id than its fixups name")}; }
    ret err[Fail].ok{};
}

# every section's bytes and fixups
fun written(c: *Ctx) err[Fail] {
    val k: res[*Kind, Fail] = reloc.absolute_of(c.address);
    if (sel k.err) { ret err[Fail].err{k.err}; }
    c.absolute = k.ok;
    val n:  usize     = intern.count(?c.o.names);
    var gr: err[Fail] = vectors.grow[u32](?c.named, n);
    gr = fail.kept(gr, vectors.grow[u32](?c.origins, n));
    gr = fail.kept(gr, vectors.grow[u32](?c.at_mark, table.count[Place](?c.d.marks)));
    gr = fail.kept(gr, vectors.grow[u32](?c.labels, table.count[Place](?c.d.marks)));
    gr = fail.kept(gr, vectors.grow[u32](?c.at_symbol, table.count[Symbol](?c.o.symbols)));
    gr = fail.kept(gr, vectors.grow[u32](?c.entries, table.count[debug.Type](?c.d.types)));
    gr = fail.kept(gr, vectors.grow[u32](?c.stamps, table.count[debug.Site](?c.d.sites)));
    if (sel gr.err) { ret gr; }
    var h: err[Fail] = sink.u32(?c.offsets, 0);
    h = fail.kept(h, sink.u16(?c.offsets, VERSION));
    h = fail.kept(h, sink.u16(?c.offsets, 0));
    h = fail.kept(h, sink.u32(?c.addrs, 0));
    h = fail.kept(h, sink.u16(?c.addrs, VERSION));
    h = fail.kept(h, sink.u8(?c.addrs, c.address));
    h = fail.kept(h, sink.u8(?c.addrs, 0));
    if (sel h.err) { ret h; }
    val e: err[Fail] = entries(c);
    if (sel e.err) { ret e; }
    val ab: err[Fail] = abbreviations(c);
    if (sel ab.err) { ret ab; }
    var p: err[Fail] = length(?c.offsets);
    p = fail.kept(p, length(?c.addrs));
    if (sel p.err) { ret p; }
    val locs: res[Sink, Fail] = listed(c, ?c.locs, ?c.loclists);
    if (sel locs.err) { ret err[Fail].err{locs.err}; }
    c.locs = locs.ok;
    val rngs: res[Sink, Fail] = listed(c, ?c.rngs, ?c.rnglists);
    if (sel rngs.err) { ret err[Fail].err{rngs.err}; }
    c.rngs = rngs.ok;
    ret err[Fail].ok{};
}

# the unit length at the start of `s`
fun length(s: *Sink) err[Fail] {
    val n: usize = sink.len(s);
    if (n::u64 - 4 > 0xffff_fff0) { ret err[Fail].err{fail.overflow("a debug section is larger than 32-bit DWARF offsets reach")}; }
    ret sink.patch(s, 0, (n - 4)::u64, 4);
}

# a list section: its header and offsets table, then the lists `lists` holds,
# which it gives back once it holds them, and leaves to the caller on a refusal
fun listed(c: *Ctx, lists: *Sink, offsets: *Vector[u32]) res[Sink, Fail] {
    val count: usize     = vector.length[u32](offsets);
    val head:  usize     = 12 + 4 * count;
    var out:   Sink      = sink.make(c.o.a, c.o.target.arch.order);
    var w:     err[Fail] = sink.u32(?out, (head - 4 + sink.len(lists))::u32);
    w = fail.kept(w, sink.u16(?out, VERSION));
    w = fail.kept(w, sink.u8(?out, c.address));
    w = fail.kept(w, sink.u8(?out, 0));
    w = fail.kept(w, sink.u32(?out, count::u32));
    var i: usize = 0;
    for (i < count) {
        w = fail.kept(w, sink.u32(?out, (4 * count + offsets.data[i]::usize)::u32));
        i = i + 1;
    }
    w = fail.kept(w, sink.bytes(?out, sink.data(lists), sink.len(lists)));
    if (sel w.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret res[Sink, Fail].err{w.err};
    }
    val gone: err[Fail] = sink.release(lists);
    if (sel gone.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret res[Sink, Fail].err{gone.err};
    }
    ret res[Sink, Fail].ok{out};
}

# the abbreviations, each row in order, and the table's end
fun abbreviations(c: *Ctx) err[Fail] {
    val s: *Sink     = ?c.abbrev;
    var w: err[Fail] = err[Fail].ok{};
    var i: usize     = 0;
    for (i < ABBREV_COUNT) {
        val a: *Abbrev = ?ABBREVS[i];
        w = fail.kept(w, sink.uleb(s, (i + 1)::u64));
        w = fail.kept(w, sink.uleb(s, a.tag::u64));
        var children: u8 = 0;
        if (a.children) { children = 1; }
        w = fail.kept(w, sink.u8(s, children));
        var k: usize = 0;
        for (k < a.count) {
            w = fail.kept(w, sink.uleb(s, a.specs[k].at::u64));
            w = fail.kept(w, sink.uleb(s, a.specs[k].form::u64));
            k = k + 1;
        }
        w = fail.kept(w, sink.u8(s, 0));
        w = fail.kept(w, sink.u8(s, 0));
        i = i + 1;
    }
    ret fail.kept(w, sink.u8(s, 0));
}

# a fixup of `width` zero bytes at the end of the section `index`
fun fix(c: *Ctx, s: *Sink, index: u32, width: u8, kind: *Kind, target: Aim, addend: i64) err[Fail] {
    val f: res[Id[Fixup], Fail] = lowered.add_fixup(c.out, Fixup{section: sec(c, index), offset: sink.len(s)::u64, kind: kind, target: target, addend: addend});
    if (sel f.err) { ret err[Fail].err{f.err}; }
    ret sink.zeros(s, width::usize);
}

# an offset into the section `to`, at the end of the section `index`
fun offset_into(c: *Ctx, s: *Sink, index: u32, to: u32, addend: i64) err[Fail] {
    ret fix(c, s, index, OFFSET, ?reloc.SECREL32, Aim.added{sec(c, to)}, addend);
}

fun code(c: *Ctx, a: u32) err[Fail] {
    ret sink.uleb(?c.info, a::u64);
}

fun udata(c: *Ctx, v: u64) err[Fail] {
    ret sink.uleb(?c.info, v);
}

# a string attribute: its index, the string added the first time it is named
fun strx(c: *Ctx, n: Id[Name]) err[Fail] {
    if (n.index::usize >= vector.length[u32](?c.named)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a debug record names a name the object does not hold"), "name", n.index::u64)}; }
    var index: u32 = c.named.data[n.index::usize];
    if (index == 0) {
        val at: usize     = sink.len(?c.strings);
        val v:  View      = object.name_of(c.o, n);
        var w:  err[Fail] = sink.bytes(?c.strings, v.data, v.len);
        w = fail.kept(w, sink.u8(?c.strings, 0));
        if (sel w.err) { ret w; }
        val f: err[Fail] = offset_into(c, ?c.offsets, S_OFFSETS, S_STRINGS, at::i64);
        if (sel f.err) { ret f; }
        c.strings_n                  = c.strings_n + 1;
        index                        = c.strings_n;
        c.named.data[n.index::usize] = index;
    }
    ret udata(c, (index - 1)::u64);
}

# the label of the mark `m`, made the first time it is named
fun label_of(c: *Ctx, m: Id[Place]) res[Id[Place], Fail] {
    if (m.index::usize >= vector.length[u32](?c.labels)) { ret res[Id[Place], Fail].err{fail.in_indexed(fail.malformed("a debug record names a mark the object does not hold"), "mark", m.index::u64)}; }
    val known: u32 = c.labels.data[m.index::usize];
    if (known != 0) { ret res[Id[Place], Fail].ok{Id[Place]{index: known - 1}}; }
    val l: res[Id[Place], Fail] = lowered.label(c.out, @table.at[Place](?c.d.marks, m));
    if (sel l.err) { ret l; }
    c.labels.data[m.index::usize] = l.ok.index + 1;
    ret l;
}

# the index of the mark `m` in the address table, added the first time it
# is named
fun mark_address(c: *Ctx, m: Id[Place]) res[u32, Fail] {
    val l: res[Id[Place], Fail] = label_of(c, m);
    if (sel l.err) { ret res[u32, Fail].err{l.err}; }
    val known: u32 = c.at_mark.data[m.index::usize];
    if (known != 0) { ret res[u32, Fail].ok{known - 1}; }
    val f: err[Fail] = fix(c, ?c.addrs, S_ADDRS, c.address, c.absolute, Aim.label{l.ok}, 0);
    if (sel f.err) { ret res[u32, Fail].err{f.err}; }
    c.addresses                    = c.addresses + 1;
    c.at_mark.data[m.index::usize] = c.addresses;
    ret res[u32, Fail].ok{c.addresses - 1};
}

# the index of the symbol `s` in the address table, added the first time it
# is named
fun symbol_address(c: *Ctx, s: Id[Symbol]) res[u32, Fail] {
    if (s.index::usize >= vector.length[u32](?c.at_symbol)) { ret res[u32, Fail].err{fail.in_indexed(fail.malformed("a debug record names a symbol the object does not hold"), "symbol", s.index::u64)}; }
    val known: u32 = c.at_symbol.data[s.index::usize];
    if (known != 0) { ret res[u32, Fail].ok{known - 1}; }
    val f: err[Fail] = fix(c, ?c.addrs, S_ADDRS, c.address, c.absolute, Aim.symbol{s}, 0);
    if (sel f.err) { ret res[u32, Fail].err{f.err}; }
    c.addresses                      = c.addresses + 1;
    c.at_symbol.data[s.index::usize] = c.addresses;
    ret res[u32, Fail].ok{c.addresses - 1};
}

# a reference to a type's entry, filled once every type's entry is written
fun type_ref(c: *Ctx, t: Id[debug.Type]) err[Fail] {
    if (t.index::usize >= vector.length[u32](?c.entries)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a debug record names a type the object does not hold"), "type", t.index::u64)}; }
    val p: err[Fail] = vectors.push[Wait](?c.waits, Wait{at: sink.len(?c.info), type: t});
    if (sel p.err) { ret p; }
    ret sink.u32(?c.info, 0);
}

# a declaration's file, as the line table's file of its index
fun file_of(c: *Ctx, p: Position) res[u64, Fail] {
    if (p.file.index::usize >= table.count[File](?c.o.files)) { ret res[u64, Fail].err{fail.in_indexed(fail.malformed("a debug record names a file the object does not hold"), "file", p.file.index::u64)}; }
    ret res[u64, Fail].ok{p.file.index::u64};
}

# a declaration's file and line
fun declared(c: *Ctx, p: Position) err[Fail] {
    val f: res[u64, Fail] = file_of(c, p);
    if (sel f.err) { ret err[Fail].err{f.err}; }
    val w: err[Fail] = sink.u32(?c.info, f.ok::u32);
    if (sel w.err) { ret w; }
    ret udata(c, p.line::u64);
}

# whether `r` lies within a table of `count` items
fun within_table(r: Run, count: usize) bool {
    ret r.first <= count && r.count <= count - r.first;
}

fun outside(what: str) Fail {
    ret fail.about(fail.malformed("a debug record names a run past its table"), what);
}

fun end_children(c: *Ctx) err[Fail] {
    ret sink.u8(?c.info, 0);
}

# the unit's entry, its children and every reference to a type filled
fun entries(c: *Ctx) err[Fail] {
    val s: *Sink     = ?c.info;
    var w: err[Fail] = sink.u32(s, 0);
    w = fail.kept(w, sink.u16(s, VERSION));
    w = fail.kept(w, sink.u8(s, UT_COMPILE));
    w = fail.kept(w, sink.u8(s, c.address));
    if (sel w.err) { ret w; }
    val ab: err[Fail] = offset_into(c, s, S_INFO, S_ABBREV, 0);
    if (sel ab.err) { ret ab; }
    val u: debug.Unit = c.unit;
    # the unit's ranges: every function's code
    sink.truncate(?c.lists, 0);
    var i: usize = 0;
    for (i < table.count[Subprogram](?c.d.functions)) {
        val p: *Subprogram = table.at[Subprogram](?c.d.functions, table.nth[Subprogram](i));
        val e: err[Fail]   = range_entry(c, p.start, p.end);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    val ranges: res[u32, Fail] = range_list(c);
    if (sel ranges.err) { ret err[Fail].err{ranges.err}; }
    var unit: u32 = A_UNIT_LOC_UNSTATED;
    if (c.lines) { unit = A_UNIT_LINE_UNSTATED; }
    val language: opt[u16] = u.language;
    if (sel language.some) {
        unit = A_UNIT_LOC;
        if (c.lines) { unit = A_UNIT_LINE; }
    }
    var h: err[Fail] = code(c, unit);
    if (sel language.some) { h = fail.kept(h, sink.u16(s, language.some)); }
    if (sel h.err)         { ret h; }
    var a: err[Fail] = strx(c, u.producer);
    a = fail.kept(a, strx(c, u.name));
    a = fail.kept(a, strx(c, u.directory));
    if (sel a.err) { ret a; }
    var b: err[Fail] = sink.uint(s, 0, c.address::usize);
    b = fail.kept(b, udata(c, ranges.ok::u64));
    if (sel b.err) { ret b; }
    var bases: err[Fail] = offset_into(c, s, S_INFO, S_OFFSETS, OFFSETS_BASE);
    bases = fail.kept(bases, offset_into(c, s, S_INFO, S_ADDRS, ADDRS_BASE));
    bases = fail.kept(bases, offset_into(c, s, S_INFO, S_RNGS, LISTS_BASE));
    bases = fail.kept(bases, offset_into(c, s, S_INFO, S_LOCS, LISTS_BASE));
    if (sel bases.err) { ret bases; }
    if (c.lines) {
        val table_of: opt[Id[Added]] = c.out.lines;
        if (sel table_of.some) {
            val st: err[Fail] = fix(c, s, S_INFO, OFFSET, ?reloc.SECREL32, Aim.added{table_of.some}, 0);
            if (sel st.err) { ret st; }
        }
    }
    # every type, then the globals, then the callees inlined, then the functions
    i = 0;
    for (i < table.count[debug.Type](?c.d.types)) {
        val t: err[Fail] = type_entry(c, table.nth[debug.Type](i));
        if (sel t.err) { ret err[Fail].err{fail.in_indexed(t.err, "debug type", i::u64)}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Global](?c.d.globals)) {
        val g: err[Fail] = global_entry(c, table.at[Global](?c.d.globals, table.nth[Global](i)));
        if (sel g.err) { ret err[Fail].err{fail.in_indexed(g.err, "debug global", i::u64)}; }
        i = i + 1;
    }
    val origins: err[Fail] = abstracts(c);
    if (sel origins.err) { ret origins; }
    i = 0;
    for (i < table.count[Subprogram](?c.d.functions)) {
        val f: err[Fail] = subprogram(c, table.at[Subprogram](?c.d.functions, table.nth[Subprogram](i)));
        if (sel f.err) { ret err[Fail].err{fail.in_indexed(f.err, "debug function", i::u64)}; }
        i = i + 1;
    }
    val end: err[Fail] = end_children(c);
    if (sel end.err) { ret end; }
    i = 0;
    for (i < vector.length[Wait](?c.waits)) {
        val x: Wait      = c.waits.data[i];
        val p: err[Fail] = sink.patch(s, x.at, c.entries.data[x.type.index::usize]::u64, 4);
        if (sel p.err) { ret p; }
        i = i + 1;
    }
    ret length(s);
}

# the entry of a member, at its offset
fun member(c: *Ctx, m: debug.Member) err[Fail] {
    var w: err[Fail] = code(c, A_MEMBER);
    w = fail.kept(w, strx(c, m.name));
    w = fail.kept(w, type_ref(c, m.type));
    w = fail.kept(w, udata(c, m.offset));
    ret w;
}

fun encoding_of(e: debug.Encoding) u8 {
    if (sel e.signed)    { ret ATE_SIGNED; }
    if (sel e.unsigned)  { ret ATE_UNSIGNED; }
    if (sel e.float)     { ret ATE_FLOAT; }
    if (sel e.boolean)   { ret ATE_BOOLEAN; }
    if (sel e.character) { ret ATE_CHARACTER; }
    ret ATE_ADDRESS;
}

# a tagged union: a structure of its discriminant and a variant part of its
# cases, whose variants hold their payloads
fun tagged(c: *Ctx, name: Id[Name], t: debug.Tagged) err[Fail] {
    if (!within_table(t.cases, table.count[debug.Case](?c.d.cases))) { ret err[Fail].err{outside("cases")}; }
    var s: err[Fail] = code(c, A_STRUCTURE);
    s = fail.kept(s, strx(c, name));
    s = fail.kept(s, udata(c, t.size));
    if (sel s.err) { ret s; }
    val disc: usize     = sink.len(?c.info);
    val head: err[Fail] = member(c, t.discriminant);
    if (sel head.err) { ret head; }
    var d: err[Fail] = code(c, A_PART);
    d = fail.kept(d, sink.u32(?c.info, disc::u32));
    if (sel d.err) { ret d; }
    var i: usize = 0;
    for (i < t.cases.count) {
        val k: *debug.Case = table.at[debug.Case](?c.d.cases, table.nth[debug.Case](t.cases.first + i));
        var v: err[Fail]   = code(c, A_VARIANT);
        v = fail.kept(v, udata(c, k.value));
        if (sel v.err) { ret v; }
        val carried: opt[debug.Member] = k.payload;
        if (sel carried.some) {
            val m: err[Fail] = member(c, carried.some);
            if (sel m.err) { ret m; }
        }
        val e: err[Fail] = end_children(c);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    val part: err[Fail] = end_children(c);
    if (sel part.err) { ret part; }
    ret end_children(c);
}

# the entry of one type, and its children
fun type_entry(c: *Ctx, id: Id[debug.Type]) err[Fail] {
    c.entries.data[id.index::usize] = sink.len(?c.info)::u32;
    val t: *debug.Type = table.at[debug.Type](?c.d.types, id);
    val s: Shape       = t.shape;
    if (sel s.declared)    { ret declared_type(c, t.name, s.declared); }
    or (sel s.base)        { ret base(c, t.name, s.base); }
    or (sel s.tagged)      { ret tagged(c, t.name, s.tagged); }
    or (sel s.structure)   { ret aggregate(c, A_STRUCTURE, t.name, s.structure); }
    or (sel s.union)       { ret aggregate(c, A_UNION, t.name, s.union); }
    or (sel s.enumeration) { ret enumeration(c, t.name, s.enumeration); }
    or (sel s.array)       { ret array(c, s.array); }
    or (sel s.pointer)     { ret pointer(c, s.pointer); }
    ret routine(c, s.routine);
}

# a type declared and never defined: a structure, union or enumeration with
# no size or members, and a named type that is unspecified for any other kind
fun declared_type(c: *Ctx, name: Id[Name], d: debug.Declared) err[Fail] {
    var a: u32 = A_UNSPECIFIED;
    if (sel d.structure)   { a = A_STRUCTURE_DECLARED; }
    or (sel d.union)       { a = A_UNION_DECLARED; }
    or (sel d.enumeration) { a = A_ENUM_DECLARED; }
    val w: err[Fail] = code(c, a);
    ret fail.kept(w, strx(c, name));
}

# a scalar, its size in bytes, or in bits when no whole number of bytes
# holds it
fun base(c: *Ctx, name: Id[Name], b: debug.Base) err[Fail] {
    var a:    u32 = A_BITS;
    var size: u64 = b.bits::u64;
    if (b.bits % 8 == 0) {
        a    = A_BASE;
        size = (b.bits / 8)::u64;
    }
    var w: err[Fail] = code(c, a);
    w = fail.kept(w, strx(c, name));
    w = fail.kept(w, sink.u8(?c.info, encoding_of(b.encoding)));
    ret fail.kept(w, udata(c, size));
}

fun enumeration(c: *Ctx, name: Id[Name], e: debug.Enumeration) err[Fail] {
    if (!within_table(e.enumerators, table.count[debug.Enumerator](?c.d.enumerators))) { ret err[Fail].err{outside("enumerators")}; }
    var w: err[Fail] = code(c, A_ENUM);
    w = fail.kept(w, strx(c, name));
    w = fail.kept(w, type_ref(c, e.base));
    w = fail.kept(w, udata(c, e.size));
    if (sel w.err) { ret w; }
    var i: usize = 0;
    for (i < e.enumerators.count) {
        val v: *debug.Enumerator = table.at[debug.Enumerator](?c.d.enumerators, table.nth[debug.Enumerator](e.enumerators.first + i));
        var x: err[Fail]         = code(c, A_ENUMERATOR);
        x = fail.kept(x, strx(c, v.name));
        x = fail.kept(x, udata(c, v.value));
        if (sel x.err) { ret x; }
        i = i + 1;
    }
    ret end_children(c);
}

fun array(c: *Ctx, a: debug.Array) err[Fail] {
    var w: err[Fail] = code(c, A_ARRAY);
    w = fail.kept(w, type_ref(c, a.element));
    w = fail.kept(w, code(c, A_SUBRANGE));
    w = fail.kept(w, udata(c, a.count));
    ret fail.kept(w, end_children(c));
}

# a pointer, the size of an address, to its target or to nothing stated
fun pointer(c: *Ctx, target: opt[Id[debug.Type]]) err[Fail] {
    if (sel target.some) {
        var w: err[Fail] = code(c, A_POINTER);
        w = fail.kept(w, type_ref(c, target.some));
        ret fail.kept(w, udata(c, c.address::u64));
    }
    val w: err[Fail] = code(c, A_OPAQUE);
    ret fail.kept(w, udata(c, c.address::u64));
}

fun aggregate(c: *Ctx, a: u32, name: Id[Name], g: debug.Aggregate) err[Fail] {
    if (!within_table(g.members, table.count[debug.Member](?c.d.members))) { ret err[Fail].err{outside("members")}; }
    var w: err[Fail] = code(c, a);
    w = fail.kept(w, strx(c, name));
    w = fail.kept(w, udata(c, g.size));
    if (sel w.err) { ret w; }
    var i: usize = 0;
    for (i < g.members.count) {
        val m: err[Fail] = member(c, @table.at[debug.Member](?c.d.members, table.nth[debug.Member](g.members.first + i)));
        if (sel m.err) { ret m; }
        i = i + 1;
    }
    ret end_children(c);
}

fun routine(c: *Ctx, f: debug.Routine) err[Fail] {
    if (!within_table(f.params, table.count[Id[debug.Type]](?c.d.params))) { ret err[Fail].err{outside("parameters")}; }
    val result: opt[Id[debug.Type]] = f.result;
    var w:      err[Fail]           = err[Fail].ok{};
    if (sel result.some) {
        w = code(c, A_ROUTINE);
        w = fail.kept(w, type_ref(c, result.some));
    }
    or             { w = code(c, A_VOID); }
    if (sel w.err) { ret w; }
    var i: usize = 0;
    for (i < f.params.count) {
        var x: err[Fail] = code(c, A_ARGUMENT);
        x = fail.kept(x, type_ref(c, @table.at[Id[debug.Type]](?c.d.params, table.nth[Id[debug.Type]](f.params.first + i))));
        if (sel x.err) { ret x; }
        i = i + 1;
    }
    ret end_children(c);
}

# the kind and width a thread-local's offset is written as under the
# format's row, none when the row states a kind the object's relocations
# write none of
fun tls_kind(c: *Ctx) opt[TlsKind] {
    val t: TlsOffset = c.row.tls;
    if (sel t.address) { ret opt[TlsKind].some{TlsKind{kind: c.absolute, width: c.address}}; }
    var i: usize = 0;
    for (i < t.relocated.count) {
        val k: TlsKind             = t.relocated.kinds[i];
        val r: res[*row.Row, Fail] = row.by_kind(c.set, k.kind);
        if (sel r.ok) { ret opt[TlsKind].some{k}; }
        i = i + 1;
    }
    ret opt[TlsKind].none{};
}

# the entry of one global, at the unit's scope
fun global_entry(c: *Ctx, g: *Global) err[Fail] {
    var form:  u32            = GLOBAL_BARE;
    var tls:   opt[TlsKind]   = opt[TlsKind].none{};
    var index: u32            = 0;
    var sym:   Id[Symbol]     = Id[Symbol]{index: 0};
    val st:    object.Storage = g.storage;
    if (sel st.declaration) { form = GLOBAL_DECLARED; }
    or (sel st.thread) {
        if (st.thread.index::usize >= table.count[Symbol](?c.o.symbols)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a debug record names a symbol the object does not hold"), "symbol", st.thread.index::u64)}; }
        sym = st.thread;
        tls = tls_kind(c);
        if (sel tls.some) { form = GLOBAL_LOCATED; }
    }
    or (sel st.address) {
        val at: res[u32, Fail] = symbol_address(c, st.address);
        if (sel at.err) { ret err[Fail].err{at.err}; }
        index = at.ok;
        form  = GLOBAL_LOCATED;
    }
    var a: u32 = A_GLOBAL + form;
    if (c.lines) { a = a + GLOBAL_PLACED; }
    var external: u8 = 0;
    if (g.external) { external = 1; }
    var w: err[Fail] = code(c, a);
    w = fail.kept(w, strx(c, g.name));
    w = fail.kept(w, type_ref(c, g.type));
    w = fail.kept(w, sink.u8(?c.info, external));
    if (c.lines)                { w = fail.kept(w, declared(c, g.declared)); }
    if (sel w.err)              { ret w; }
    if (form != GLOBAL_LOCATED) { ret err[Fail].ok{}; }
    val s: *Sink = ?c.info;
    if (sel tls.some) {
        val k:  TlsKind = tls.some;
        var op: u8      = OP_CONST8U;
        if (k.width == 4) { op = OP_CONST4U; }
        var x: err[Fail] = sink.uleb(s, (2 + k.width::u32)::u64);
        x = fail.kept(x, sink.u8(s, op));
        x = fail.kept(x, fix(c, s, S_INFO, k.width, k.kind, Aim.symbol{sym}, 0));
        x = fail.kept(x, sink.u8(s, OP_TLS_ADDRESS));
        ret x;
    }
    var size: u64 = 1;
    var rest: u64 = index::u64 >> 7;
    for (rest != 0) {
        size = size + 1;
        rest = rest >> 7;
    }
    var x: err[Fail] = sink.uleb(s, 1 + size);
    x = fail.kept(x, sink.u8(s, OP_ADDRX));
    x = fail.kept(x, sink.uleb(s, index::u64));
    ret x;
}

# the site `s` refused when it lies past the sites table
fun site_at(c: *Ctx, s: Id[debug.Site]) res[*debug.Site, Fail] {
    if (s.index::usize >= table.count[debug.Site](?c.d.sites)) { ret res[*debug.Site, Fail].err{fail.in_indexed(fail.malformed("a debug record names a site the object does not hold"), "site", s.index::u64)}; }
    ret res[*debug.Site, Fail].ok{table.at[debug.Site](?c.d.sites, s)};
}

fun looping() Fail {
    ret fail.malformed("a chain of inlining sites loops");
}

# the abstract entry of every callee whose code a function holds inlined,
# each the first time a site chain names it
fun abstracts(c: *Ctx) err[Fail] {
    val bound: usize = table.count[debug.Site](?c.d.sites);
    var f:     usize = 0;
    for (f < table.count[Subprogram](?c.d.functions)) {
        val p: *Subprogram = table.at[Subprogram](?c.d.functions, table.nth[Subprogram](f));
        f = f + 1;
        if (!within_table(p.inlined, table.count[Inlined](?c.d.inlined))) { ret err[Fail].err{outside("inlined runs")}; }
        var i: usize = 0;
        for (i < p.inlined.count) {
            var at:    Id[debug.Site] = table.at[Inlined](?c.d.inlined, table.nth[Inlined](p.inlined.first + i)).site;
            var depth: usize          = 0;
            for {
                if (depth > bound) { ret err[Fail].err{looping()}; }
                val got: res[*debug.Site, Fail] = site_at(c, at);
                if (sel got.err) { ret err[Fail].err{got.err}; }
                val callee: Id[Name] = got.ok.callee;
                if (callee.index::usize >= vector.length[u32](?c.origins)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a debug record names a name the object does not hold"), "name", callee.index::u64)}; }
                if (c.origins.data[callee.index::usize] == 0) {
                    c.origins.data[callee.index::usize] = sink.len(?c.info)::u32 + 1;
                    var w: err[Fail] = code(c, A_ABSTRACT);
                    w = fail.kept(w, strx(c, callee));
                    w = fail.kept(w, sink.u8(?c.info, INLINED));
                    if (sel w.err) { ret w; }
                }
                val up: opt[Id[debug.Site]] = got.ok.parent;
                if (sel up.none) { brk; }
                at    = up.some;
                depth = depth + 1;
            }
            i = i + 1;
        }
    }
    ret err[Fail].ok{};
}

# the entry of one function, its variables and the code inlined in it
fun subprogram(c: *Ctx, p: *Subprogram) err[Fail] {
    if (!within_table(p.variables, table.count[debug.Variable](?c.d.variables))) { ret err[Fail].err{outside("variables")}; }
    val start: res[u32, Fail] = mark_address(c, p.start);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    var w: err[Fail] = code(c, A_SUBPROGRAM);
    w = fail.kept(w, strx(c, p.name));
    w = fail.kept(w, udata(c, start.ok::u64));
    w = fail.kept(w, size_of(c, p));
    w = fail.kept(w, sink.uleb(?c.info, 1));
    w = fail.kept(w, sink.u8(?c.info, OP_CFA));
    if (sel w.err) { ret w; }
    var i: usize = 0;
    for (i < p.variables.count) {
        val v: err[Fail] = variable(c, table.at[debug.Variable](?c.d.variables, table.nth[debug.Variable](p.variables.first + i)));
        if (sel v.err) { ret err[Fail].err{fail.in_indexed(v.err, "debug variable", (p.variables.first + i)::u64)}; }
        i = i + 1;
    }
    val scope: u32 = fresh(c);
    i = 0;
    for (i < p.inlined.count) {
        val r:    *Inlined                       = table.at[Inlined](?c.d.inlined, table.nth[Inlined](p.inlined.first + i));
        val root: res[opt[Id[debug.Site]], Fail] = child_of(c, r.site, opt[Id[debug.Site]].none{});
        if (sel root.err) { ret err[Fail].err{root.err}; }
        val found: opt[Id[debug.Site]] = root.ok;
        if (sel found.some) {
            if (c.stamps.data[found.some.index::usize] != scope) {
                c.stamps.data[found.some.index::usize] = scope;
                val nested: err[Fail] = inlined(c, p, found.some);
                if (sel nested.err) { ret nested; }
            }
        }
        i = i + 1;
    }
    ret end_children(c);
}

# a scope no seen site is stamped with yet
fun fresh(c: *Ctx) u32 {
    c.scope = c.scope + 1;
    ret c.scope;
}

# the size of a function's code: a number when the linker may resize no code
# between its marks, and a difference between them when it may
fun size_of(c: *Ctx, p: *Subprogram) err[Fail] {
    val from: res[Id[Place], Fail] = label_of(c, p.start);
    if (sel from.err) { ret err[Fail].err{from.err}; }
    val to: res[Id[Place], Fail] = label_of(c, p.end);
    if (sel to.err) { ret err[Fail].err{to.err}; }
    val a: Place = @table.at[Place](?c.d.marks, p.start);
    val b: Place = @table.at[Place](?c.d.marks, p.end);
    if (a.section.index != b.section.index) { ret err[Fail].err{fail.malformed("a function's marks lie in two sections")}; }
    if (b.offset < a.offset)                { ret err[Fail].err{fail.malformed("a function ends before it starts")}; }
    val span: u64 = b.offset - a.offset;
    if (a.section.index::usize >= table.count[object.Section](?c.o.sections)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a debug mark names a section the object does not hold"), "section", a.section.index::u64)}; }
    if (!difference.resizes_between(?c.resizing, a.section, a.offset, b.offset)) {
        if ((span >> 32) != 0) { ret err[Fail].err{fail.valued(fail.overflow("a function is larger than a 32-bit size holds"), span::i128)}; }
        ret sink.u32(?c.info, span::u32);
    }
    val p32: opt[Pairing] = difference.pick(c.set, ?SIZE_WIDTHS[0], 1, span);
    if (sel p32.none) { ret err[Fail].err{fail.unsupported("the target writes no 32-bit difference a function's size over code the linker may resize needs")}; }
    var pair: Pairing   = p32.some;
    val r:    err[Fail] = difference.record(c.out, sec(c, S_INFO), sink.len(?c.info)::u64, ?pair, Aim.label{to.ok}, Aim.label{from.ok});
    if (sel r.err) { ret r; }
    ret sink.zeros(?c.info, row.container(pair.plus)::usize);
}

# whether the site `s` lies on the chain from `inner` out
fun within(c: *Ctx, inner: Id[debug.Site], s: Id[debug.Site]) res[bool, Fail] {
    val bound: usize          = table.count[debug.Site](?c.d.sites);
    var here:  Id[debug.Site] = inner;
    var depth: usize          = 0;
    for {
        if (depth > bound)         { ret res[bool, Fail].err{looping()}; }
        if (here.index == s.index) { ret res[bool, Fail].ok{true}; }
        val got: res[*debug.Site, Fail] = site_at(c, here);
        if (sel got.err) { ret res[bool, Fail].err{got.err}; }
        val up: opt[Id[debug.Site]] = got.ok.parent;
        if (sel up.none) { ret res[bool, Fail].ok{false}; }
        here  = up.some;
        depth = depth + 1;
    }
    ret res[bool, Fail].ok{false};
}

# the site on the chain from `inner` out whose parent is `parent`, the
# outermost site for a parent of none, and none for a chain `parent` is not on
fun child_of(c: *Ctx, inner: Id[debug.Site], parent: opt[Id[debug.Site]]) res[opt[Id[debug.Site]], Fail] {
    val bound: usize          = table.count[debug.Site](?c.d.sites);
    var at:    Id[debug.Site] = inner;
    var depth: usize          = 0;
    for {
        if (depth > bound) { ret res[opt[Id[debug.Site]], Fail].err{looping()}; }
        val got: res[*debug.Site, Fail] = site_at(c, at);
        if (sel got.err) { ret res[opt[Id[debug.Site]], Fail].err{got.err}; }
        val up: opt[Id[debug.Site]] = got.ok.parent;
        if (sel parent.none) {
            if (sel up.none) { ret res[opt[Id[debug.Site]], Fail].ok{opt[Id[debug.Site]].some{at}}; }
        }
        or {
            if (sel up.some) {
                if (up.some.index == parent.some.index) { ret res[opt[Id[debug.Site]], Fail].ok{opt[Id[debug.Site]].some{at}}; }
            }
        }
        if (sel up.none) { ret res[opt[Id[debug.Site]], Fail].ok{opt[Id[debug.Site]].none{}}; }
        at    = up.some;
        depth = depth + 1;
    }
    ret res[opt[Id[debug.Site]], Fail].ok{opt[Id[debug.Site]].none{}};
}

# the inlined subroutine of a site and the sites inlined within it, nested
fun inlined(c: *Ctx, p: *Subprogram, s: Id[debug.Site]) err[Fail] {
    val got: res[*debug.Site, Fail] = site_at(c, s);
    if (sel got.err) { ret err[Fail].err{got.err}; }
    val site: debug.Site = @got.ok;
    sink.truncate(?c.lists, 0);
    var i: usize = 0;
    for (i < p.inlined.count) {
        val r:  *Inlined        = table.at[Inlined](?c.d.inlined, table.nth[Inlined](p.inlined.first + i));
        val in: res[bool, Fail] = within(c, r.site, s);
        if (sel in.err) { ret err[Fail].err{in.err}; }
        if (in.ok) {
            val e: err[Fail] = range_entry(c, r.start, r.end);
            if (sel e.err) { ret e; }
        }
        i = i + 1;
    }
    val list: res[u32, Fail] = range_list(c);
    if (sel list.err) { ret err[Fail].err{list.err}; }
    val from: u32 = c.origins.data[site.callee.index::usize];
    if (from == 0) { ret err[Fail].ok{}; }
    var w: err[Fail] = err[Fail].ok{};
    if (c.lines) {
        w = code(c, A_CALLED);
        w = fail.kept(w, sink.u32(?c.info, from - 1));
        w = fail.kept(w, udata(c, list.ok::u64));
        w = fail.kept(w, declared(c, site.call));
        w = fail.kept(w, udata(c, site.call.column::u64));
    }
    or {
        w = code(c, A_INLINED);
        w = fail.kept(w, sink.u32(?c.info, from - 1));
        w = fail.kept(w, udata(c, list.ok::u64));
    }
    if (sel w.err) { ret w; }
    val scope: u32 = fresh(c);
    i = 0;
    for (i < p.inlined.count) {
        val r:     *Inlined                       = table.at[Inlined](?c.d.inlined, table.nth[Inlined](p.inlined.first + i));
        val child: res[opt[Id[debug.Site]], Fail] = child_of(c, r.site, opt[Id[debug.Site]].some{s});
        if (sel child.err) { ret err[Fail].err{child.err}; }
        val found: opt[Id[debug.Site]] = child.ok;
        if (sel found.some) {
            if (c.stamps.data[found.some.index::usize] != scope) {
                c.stamps.data[found.some.index::usize] = scope;
                val nested: err[Fail] = inlined(c, p, found.some);
                if (sel nested.err) { ret nested; }
            }
        }
        i = i + 1;
    }
    ret end_children(c);
}

# the entry of one variable of a function
fun variable(c: *Ctx, v: *debug.Variable) err[Fail] {
    val list: res[opt[u32], Fail] = location_list(c, v.ranges);
    if (sel list.err) { ret err[Fail].err{list.err}; }
    var a: u32 = A_VARIABLE;
    if (v.parameter)      { a = A_PARAMETER; }
    if (sel list.ok.some) { a = a + 1; }
    if (c.lines)          { a = a + 2; }
    var w: err[Fail] = code(c, a);
    w = fail.kept(w, strx(c, v.name));
    w = fail.kept(w, type_ref(c, v.type));
    if (c.lines)   { w = fail.kept(w, declared(c, v.declared)); }
    if (sel w.err) { ret w; }
    val held: opt[u32] = list.ok;
    if (sel held.some) { ret udata(c, held.some::u64); }
    ret err[Fail].ok{};
}

# the location list of a variable's ranges, none when DWARF states none of them
fun location_list(c: *Ctx, ranges: Run) res[opt[u32], Fail] {
    if (!within_table(ranges, table.count[Range](?c.d.ranges))) { ret res[opt[u32], Fail].err{outside("ranges")}; }
    sink.truncate(?c.lists, 0);
    var count: u32   = 0;
    var i:     usize = 0;
    for (i < ranges.count) {
        val r: *Range = table.at[Range](?c.d.ranges, table.nth[Range](ranges.first + i));
        sink.truncate(?c.expr, 0);
        val stated: res[bool, Fail] = expression(c, r.location);
        if (sel stated.err) { ret res[opt[u32], Fail].err{stated.err}; }
        if (stated.ok) {
            val start: res[u32, Fail] = mark_address(c, r.start);
            if (sel start.err) { ret res[opt[u32], Fail].err{start.err}; }
            val end: res[u32, Fail] = mark_address(c, r.end);
            if (sel end.err) { ret res[opt[u32], Fail].err{end.err}; }
            var w: err[Fail] = sink.u8(?c.lists, LLE_STARTX_ENDX);
            w = fail.kept(w, sink.uleb(?c.lists, start.ok::u64));
            w = fail.kept(w, sink.uleb(?c.lists, end.ok::u64));
            w = fail.kept(w, sink.uleb(?c.lists, sink.len(?c.expr)::u64));
            w = fail.kept(w, sink.bytes(?c.lists, sink.data(?c.expr), sink.len(?c.expr)));
            if (sel w.err) { ret res[opt[u32], Fail].err{w.err}; }
            count = count + 1;
        }
        i = i + 1;
    }
    if (count == 0) { ret res[opt[u32], Fail].ok{opt[u32].none{}}; }
    val ended: err[Fail] = sink.u8(?c.lists, LLE_END);
    if (sel ended.err) { ret res[opt[u32], Fail].err{ended.err}; }
    val placed: res[u32, Fail] = place_list(c, ?c.locs, ?c.loclists);
    if (sel placed.err) { ret res[opt[u32], Fail].err{placed.err}; }
    ret res[opt[u32], Fail].ok{opt[u32].some{placed.ok}};
}

# the list being written appended to `to`, its offset noted, and its index
fun place_list(c: *Ctx, to: *Sink, offsets: *Vector[u32]) res[u32, Fail] {
    val index: u32       = vector.length[u32](offsets)::u32;
    val noted: err[Fail] = vectors.push[u32](offsets, sink.len(to)::u32);
    if (sel noted.err) { ret res[u32, Fail].err{noted.err}; }
    val copied: err[Fail] = sink.bytes(to, sink.data(?c.lists), sink.len(?c.lists));
    if (sel copied.err) { ret res[u32, Fail].err{copied.err}; }
    ret res[u32, Fail].ok{index};
}

# one range of a range list in the list being written
fun range_entry(c: *Ctx, start: Id[Place], end: Id[Place]) err[Fail] {
    val s: res[u32, Fail] = mark_address(c, start);
    if (sel s.err) { ret err[Fail].err{s.err}; }
    val e: res[u32, Fail] = mark_address(c, end);
    if (sel e.err) { ret err[Fail].err{e.err}; }
    var w: err[Fail] = sink.u8(?c.lists, RLE_STARTX_ENDX);
    w = fail.kept(w, sink.uleb(?c.lists, s.ok::u64));
    ret fail.kept(w, sink.uleb(?c.lists, e.ok::u64));
}

fun range_list(c: *Ctx) res[u32, Fail] {
    val ended: err[Fail] = sink.u8(?c.lists, RLE_END);
    if (sel ended.err) { ret res[u32, Fail].err{ended.err}; }
    ret place_list(c, ?c.rngs, ?c.rnglists);
}

# a location as a DWARF expression in `c.expr`, answering false for one it
# cannot state
fun expression(c: *Ctx, l: Location) res[bool, Fail] {
    if (sel l.single) { ret single(c, l.single); }
    val pieces: Run = l.pieces;
    if (!within_table(pieces, table.count[debug.Piece](?c.d.pieces))) { ret res[bool, Fail].err{outside("pieces")}; }
    val s:   *Sink = ?c.expr;
    var any: bool  = false;
    var i:   usize = 0;
    for (i < pieces.count) {
        val p:  *debug.Piece = table.at[debug.Piece](?c.d.pieces, table.nth[debug.Piece](pieces.first + i));
        val at: opt[Located] = p.located;
        if (sel at.some) {
            val stated: res[bool, Fail] = single(c, at.some);
            if (sel stated.err) { ret stated; }
            if (stated.ok)      { any = true; }
        }
        var w: err[Fail] = err[Fail].ok{};
        if (p.bits % 8 == 0) {
            w = sink.u8(s, OP_PIECE);
            w = fail.kept(w, sink.uleb(s, p.bits / 8));
        }
        or {
            w = sink.u8(s, OP_BIT_PIECE);
            w = fail.kept(w, sink.uleb(s, p.bits));
            w = fail.kept(w, sink.uleb(s, 0));
        }
        if (sel w.err) { ret res[bool, Fail].err{w.err}; }
        i = i + 1;
    }
    ret res[bool, Fail].ok{any};
}

# a register's operation: the short one below SHORT_REGISTERS, the long one
# with its number otherwise
fun register_op(s: *Sink, short: u8, long: u8, n: u32) err[Fail] {
    if (n < SHORT_REGISTERS) { ret sink.u8(s, short + n::u8); }
    val w: err[Fail] = sink.u8(s, long);
    if (sel w.err) { ret w; }
    ret sink.uleb(s, n::u64);
}

# a location that is not pieces as a DWARF expression, the steps over what it
# holds, answering false for one DWARF does not state: a frame slot or a
# webassembly location with steps over it
fun single(c: *Ctx, l: Located) res[bool, Fail] {
    if (!within_table(l.steps, table.count[debug.Step](?c.d.steps))) { ret res[bool, Fail].err{outside("steps")}; }
    val s:    *Sink     = ?c.expr;
    val bare: bool      = l.steps.count == 0;
    val at:   Where     = l.where;
    var w:    err[Fail] = err[Fail].ok{};
    if (sel at.register) {
        if (bare) { w = register_op(s, OP_REG0, OP_REGX, at.register); }
        or {
            w = register_op(s, OP_BREG0, OP_BREGX, at.register);
            w = fail.kept(w, sink.sleb(s, 0));
            w = fail.kept(w, steps(c, l.steps));
            w = fail.kept(w, sink.u8(s, OP_STACK_VALUE));
        }
    }
    or (sel at.frame) {
        if (!bare) { ret res[bool, Fail].ok{false}; }
        w = sink.u8(s, OP_FBREG);
        w = fail.kept(w, sink.sleb(s, at.frame));
    }
    or (sel at.local) {
        if (!bare) { ret res[bool, Fail].ok{false}; }
        w = wasm_location(s, WASM_LOCAL, at.local);
    }
    or (sel at.operand) {
        if (!bare) { ret res[bool, Fail].ok{false}; }
        w = wasm_location(s, WASM_OPERAND, at.operand);
    }
    or (sel at.constant) {
        w = sink.u8(s, OP_CONSTU);
        w = fail.kept(w, sink.uleb(s, at.constant));
        w = fail.kept(w, steps(c, l.steps));
        w = fail.kept(w, sink.u8(s, OP_STACK_VALUE));
    }
    if (sel w.err) { ret res[bool, Fail].err{w.err}; }
    ret res[bool, Fail].ok{true};
}

fun wasm_location(s: *Sink, kind: u8, index: u32) err[Fail] {
    var w: err[Fail] = sink.u8(s, OP_WASM_LOCATION);
    w = fail.kept(w, sink.u8(s, kind));
    ret fail.kept(w, sink.uleb(s, index::u64));
}

# the low `bits` bits of the value on the stack, nothing for a whole word
fun mask(s: *Sink, bits: u32) err[Fail] {
    if (bits >= 64) { ret err[Fail].ok{}; }
    var w: err[Fail] = sink.u8(s, OP_CONSTU);
    w = fail.kept(w, sink.uleb(s, ((1::u64) << bits::u64) - 1));
    ret fail.kept(w, sink.u8(s, OP_AND));
}

# the steps of a run over the value on the stack, in order
fun steps(c: *Ctx, r: Run) err[Fail] {
    val s: *Sink = ?c.expr;
    var i: usize = 0;
    for (i < r.count) {
        val step: debug.Step = @table.at[debug.Step](?c.d.steps, table.nth[debug.Step](r.first + i));
        var w:    err[Fail]  = err[Fail].ok{};
        if (sel step.plus) {
            w = sink.u8(s, OP_CONSTU);
            w = fail.kept(w, sink.uleb(s, step.plus));
            w = fail.kept(w, sink.u8(s, OP_PLUS));
        }
        or (sel step.minus) {
            w = sink.u8(s, OP_CONSTU);
            w = fail.kept(w, sink.uleb(s, step.minus));
            w = fail.kept(w, sink.u8(s, OP_MINUS));
        }
        or (sel step.extend_signed) {
            val from: u32 = step.extend_signed.from;
            if (from < 64) {
                val shift: u64 = (64 - from)::u64;
                w = sink.u8(s, OP_CONSTU);
                w = fail.kept(w, sink.uleb(s, shift));
                w = fail.kept(w, sink.u8(s, OP_SHL));
                w = fail.kept(w, sink.u8(s, OP_CONSTU));
                w = fail.kept(w, sink.uleb(s, shift));
                w = fail.kept(w, sink.u8(s, OP_SHRA));
            }
            w = fail.kept(w, mask(s, step.extend_signed.to));
        }
        or (sel step.extend_unsigned) { w = mask(s, step.extend_unsigned.from); }
        or (sel step.truncate)        { w = mask(s, step.truncate.to); }
        if (sel w.err)                { ret w; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}
