val TAG_ARRAY:        u16 = 0x01;
val TAG_ENUMERATION:  u16 = 0x04;
val TAG_PARAMETER:    u16 = 0x05;
val TAG_MEMBER:       u16 = 0x0d;
val TAG_POINTER:      u16 = 0x0f;
val TAG_COMPILE_UNIT: u16 = 0x11;
val TAG_STRUCTURE:    u16 = 0x13;
val TAG_SUBROUTINE:   u16 = 0x15;
val TAG_UNION:        u16 = 0x17;
val TAG_VARIANT:      u16 = 0x19;
val TAG_INLINED:      u16 = 0x1d;
val TAG_SUBRANGE:     u16 = 0x21;
val TAG_BASE:         u16 = 0x24;
val TAG_ENUMERATOR:   u16 = 0x28;
val TAG_SUBPROGRAM:   u16 = 0x2e;
val TAG_VARIANT_PART: u16 = 0x33;
val TAG_VARIABLE:     u16 = 0x34;
val TAG_UNSPECIFIED:  u16 = 0x3b;
val TAG_TYPE_UNIT:    u16 = 0x41;

val AT_LOCATION:    u16 = 0x02;
val AT_NAME:        u16 = 0x03;
val AT_BYTE_SIZE:   u16 = 0x0b;
val AT_BIT_SIZE:    u16 = 0x0d;
val AT_STMT_LIST:   u16 = 0x10;
val AT_LOW_PC:      u16 = 0x11;
val AT_HIGH_PC:     u16 = 0x12;
val AT_LANGUAGE:    u16 = 0x13;
val AT_DISCR:       u16 = 0x15;
val AT_DISCR_VALUE: u16 = 0x16;
val AT_COMP_DIR:    u16 = 0x1b;
val AT_CONST_VALUE: u16 = 0x1c;
val AT_INLINE:      u16 = 0x20;
val AT_PRODUCER:    u16 = 0x25;
val AT_PROTOTYPED:  u16 = 0x27;
val AT_ABSTRACT:    u16 = 0x31;
val AT_COUNT:       u16 = 0x37;
val AT_MEMBER_AT:   u16 = 0x38;
val AT_DECL_FILE:   u16 = 0x3a;
val AT_DECL_LINE:   u16 = 0x3b;
val AT_DECLARATION: u16 = 0x3c;
val AT_ENCODING:    u16 = 0x3e;
val AT_EXTERNAL:    u16 = 0x3f;
val AT_FRAME_BASE:  u16 = 0x40;
val AT_TYPE:        u16 = 0x49;
val AT_RANGES:      u16 = 0x55;
val AT_CALL_COLUMN: u16 = 0x57;
val AT_CALL_FILE:   u16 = 0x58;
val AT_CALL_LINE:   u16 = 0x59;
val AT_SIGNATURE:   u16 = 0x69;

val FORM_ADDR:      u8 = 0x01;
val FORM_DATA2:     u8 = 0x05;
val FORM_DATA4:     u8 = 0x06;
val FORM_STRING:    u8 = 0x08;
val FORM_DATA1:     u8 = 0x0b;
val FORM_FLAG:      u8 = 0x0c;
val FORM_UDATA:     u8 = 0x0f;
val FORM_REF_ADDR:  u8 = 0x10;
val FORM_REF4:      u8 = 0x13;
val FORM_SEC:       u8 = 0x17;
val FORM_EXPRLOC:   u8 = 0x18;
val FORM_PRESENT:   u8 = 0x19;
val FORM_LINE_STRP: u8 = 0x1f;
val FORM_REF_SIG8:  u8 = 0x20;

val OP_ADDR:        u8 = 0x03;
val OP_CONST4U:     u8 = 0x0c;
val OP_CONST8U:     u8 = 0x0e;
val OP_CONSTU:      u8 = 0x10;
val OP_AND:         u8 = 0x1a;
val OP_MINUS:       u8 = 0x1c;
val OP_PLUS:        u8 = 0x22;
val OP_SHL:         u8 = 0x24;
val OP_SHRA:        u8 = 0x26;
val OP_REG0:        u8 = 0x50;
val OP_BREG0:       u8 = 0x70;
val OP_REGX:        u8 = 0x90;
val OP_FBREG:       u8 = 0x91;
val OP_BREGX:       u8 = 0x92;
val OP_PIECE:       u8 = 0x93;
val OP_TLS_ADDRESS: u8 = 0x9b;
val OP_CFA:         u8 = 0x9c;
val OP_BIT_PIECE:   u8 = 0x9d;
val OP_STACK_VALUE: u8 = 0x9f;

# the registers below this number have an operation of their own
val SHORT_REGISTERS: u32 = 32;

# a webassembly location, the tool conventions' DW_OP_WASM_location and the
# kinds of index it takes
val OP_WASM_LOCATION: u8 = 0xed;
val WASM_LOCAL:       u8 = 0;
val WASM_OPERAND:     u8 = 2;

val LLE_END:          u8 = 0x00;
val LLE_OFFSET_PAIR:  u8 = 0x04;
val LLE_BASE_ADDRESS: u8 = 0x06;
val LLE_START_END:    u8 = 0x07;
val RLE_END:          u8 = 0x00;
val RLE_OFFSET_PAIR:  u8 = 0x04;
val RLE_START_END:    u8 = 0x06;
val RLE_START_LENGTH: u8 = 0x07;

val ATE_ADDRESS:   u8 = 0x01;
val ATE_BOOLEAN:   u8 = 0x02;
val ATE_FLOAT:     u8 = 0x04;
val ATE_SIGNED:    u8 = 0x05;
val ATE_UNSIGNED:  u8 = 0x07;
val ATE_CHARACTER: u8 = 0x10;

val UT_COMPILE: u8  = 0x01;
val UT_TYPE:    u8  = 0x02;
val VERSION:    u16 = 5;
val INLINED:    u8  = 0x01;

# the bytes of a section offset in the 32-bit DWARF format
val OFFSET: u8 = 4;

# the widths, in bits, a function's size may be written as a difference in
val SIZE_WIDTHS: [1]u32 = [1]u32{32};

# one attribute of an abbreviation
# ---
# at:   its DW_AT code
# form: the DW_FORM it is written in
rec Spec {
    at:   u16;
    form: u8;
}

# an abbreviation, whose code is its row's position plus one
# ---
# tag:      the tag of the entries it abbreviates
# children: whether they have children
# specs:    their attributes, in the order each entry writes them
# count:    how many
rec Abbrev {
    tag:      u16;
    children: bool;
    specs:    *Spec;
    count:    usize;
}

# a unit's language leads its attributes and its line table ends them, so the
# abbreviation of a unit that states no language is the same specs from the
# second, and of one with no line table the same specs but the last
val UNIT_ONE_SPECS: [7]Spec = [7]Spec{
    Spec{at: AT_LANGUAGE, form: FORM_DATA2}, Spec{at: AT_PRODUCER, form: FORM_LINE_STRP}, Spec{at: AT_NAME, form: FORM_LINE_STRP},
    Spec{at: AT_COMP_DIR, form: FORM_LINE_STRP}, Spec{at: AT_LOW_PC, form: FORM_ADDR}, Spec{at: AT_HIGH_PC, form: FORM_DATA4},
    Spec{at: AT_STMT_LIST, form: FORM_SEC},
};
val UNIT_MANY_SPECS: [7]Spec = [7]Spec{
    Spec{at: AT_LANGUAGE, form: FORM_DATA2}, Spec{at: AT_PRODUCER, form: FORM_LINE_STRP}, Spec{at: AT_NAME, form: FORM_LINE_STRP},
    Spec{at: AT_COMP_DIR, form: FORM_LINE_STRP}, Spec{at: AT_LOW_PC, form: FORM_ADDR}, Spec{at: AT_RANGES, form: FORM_SEC},
    Spec{at: AT_STMT_LIST, form: FORM_SEC},
};
val UNIT_DATA_SPECS: [5]Spec = [5]Spec{
    Spec{at: AT_LANGUAGE, form: FORM_DATA2}, Spec{at: AT_PRODUCER, form: FORM_LINE_STRP}, Spec{at: AT_NAME, form: FORM_LINE_STRP},
    Spec{at: AT_COMP_DIR, form: FORM_LINE_STRP}, Spec{at: AT_STMT_LIST, form: FORM_SEC},
};
val SUBPROGRAM_SPECS: [4]Spec = [4]Spec{
    Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_LOW_PC, form: FORM_ADDR}, Spec{at: AT_HIGH_PC, form: FORM_DATA4},
    Spec{at: AT_FRAME_BASE, form: FORM_EXPRLOC},
};
val NAMED_SPECS:    [2]Spec = [2]Spec{Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_TYPE, form: FORM_REF_ADDR}};
val LOCATED_SPECS:  [3]Spec = [3]Spec{Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_TYPE, form: FORM_REF_ADDR}, Spec{at: AT_LOCATION, form: FORM_SEC}};
val EXPR_SPECS:     [3]Spec = [3]Spec{Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_TYPE, form: FORM_REF_ADDR}, Spec{at: AT_LOCATION, form: FORM_EXPRLOC}};
val DECLARED_SPECS: [4]Spec = [4]Spec{Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_TYPE, form: FORM_REF_ADDR}, Spec{at: AT_DECL_FILE, form: FORM_DATA4}, Spec{at: AT_DECL_LINE, form: FORM_UDATA}};
val PLACED_SPECS:   [5]Spec = [5]Spec{
    Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_TYPE, form: FORM_REF_ADDR}, Spec{at: AT_DECL_FILE, form: FORM_DATA4},
    Spec{at: AT_DECL_LINE, form: FORM_UDATA}, Spec{at: AT_LOCATION, form: FORM_SEC},
};
val PLACED_EXPR_SPECS: [5]Spec = [5]Spec{
    Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_TYPE, form: FORM_REF_ADDR}, Spec{at: AT_DECL_FILE, form: FORM_DATA4},
    Spec{at: AT_DECL_LINE, form: FORM_UDATA}, Spec{at: AT_LOCATION, form: FORM_EXPRLOC},
};
val BASE_SPECS:          [3]Spec = [3]Spec{Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_ENCODING, form: FORM_DATA1}, Spec{at: AT_BYTE_SIZE, form: FORM_UDATA}};
val BITS_SPECS:          [3]Spec = [3]Spec{Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_ENCODING, form: FORM_DATA1}, Spec{at: AT_BIT_SIZE, form: FORM_UDATA}};
val AGGREGATE_SPECS:     [2]Spec = [2]Spec{Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_BYTE_SIZE, form: FORM_UDATA}};
val MEMBER_SPECS:        [3]Spec = [3]Spec{Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_MEMBER_AT, form: FORM_UDATA}};
val PART_SPECS:          [1]Spec = [1]Spec{Spec{at: AT_DISCR, form: FORM_REF4}};
val VARIANT_SPECS:       [1]Spec = [1]Spec{Spec{at: AT_DISCR_VALUE, form: FORM_UDATA}};
val ENUM_SPECS:          [3]Spec = [3]Spec{Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_BYTE_SIZE, form: FORM_UDATA}};
val ENUMERATOR_SPECS:    [2]Spec = [2]Spec{Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_CONST_VALUE, form: FORM_UDATA}};
val TYPED_SPECS:         [1]Spec = [1]Spec{Spec{at: AT_TYPE, form: FORM_REF4}};
val COUNT_SPECS:         [1]Spec = [1]Spec{Spec{at: AT_COUNT, form: FORM_UDATA}};
val POINTER_SPECS:       [2]Spec = [2]Spec{Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_BYTE_SIZE, form: FORM_UDATA}};
val DECLARED_TYPE_SPECS: [2]Spec = [2]Spec{Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_DECLARATION, form: FORM_PRESENT}};
val UNSPECIFIED_SPECS:   [1]Spec = [1]Spec{Spec{at: AT_NAME, form: FORM_STRING}};
# a type unit states its language, and one that states none nothing
val TYPE_UNIT_SPECS: [1]Spec = [1]Spec{Spec{at: AT_LANGUAGE, form: FORM_DATA2}};
val SIGNED_SPECS:    [2]Spec = [2]Spec{Spec{at: AT_DECLARATION, form: FORM_PRESENT}, Spec{at: AT_SIGNATURE, form: FORM_REF_SIG8}};
val SIZED_SPECS:     [1]Spec = [1]Spec{Spec{at: AT_BYTE_SIZE, form: FORM_UDATA}};
val ROUTINE_SPECS:   [2]Spec = [2]Spec{Spec{at: AT_TYPE, form: FORM_REF4}, Spec{at: AT_PROTOTYPED, form: FORM_PRESENT}};
val VOID_SPECS:      [1]Spec = [1]Spec{Spec{at: AT_PROTOTYPED, form: FORM_PRESENT}};
val ABSTRACT_SPECS:  [2]Spec = [2]Spec{Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_INLINE, form: FORM_DATA1}};
val INLINED_SPECS:   [2]Spec = [2]Spec{Spec{at: AT_ABSTRACT, form: FORM_REF4}, Spec{at: AT_RANGES, form: FORM_SEC}};
val CALLED_SPECS:    [5]Spec = [5]Spec{
    Spec{at: AT_ABSTRACT, form: FORM_REF4}, Spec{at: AT_RANGES, form: FORM_SEC}, Spec{at: AT_CALL_FILE, form: FORM_DATA4},
    Spec{at: AT_CALL_LINE, form: FORM_UDATA}, Spec{at: AT_CALL_COLUMN, form: FORM_UDATA},
};
# a global: located, then with no location for the bare abbreviation, and
# declared, each with its declaration's place for a unit of line records
val GLOBAL_SPECS: [4]Spec = [4]Spec{
    Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_TYPE, form: FORM_REF_ADDR}, Spec{at: AT_EXTERNAL, form: FORM_FLAG},
    Spec{at: AT_LOCATION, form: FORM_EXPRLOC},
};
val GLOBAL_DECLARED_SPECS: [4]Spec = [4]Spec{
    Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_TYPE, form: FORM_REF_ADDR}, Spec{at: AT_EXTERNAL, form: FORM_FLAG},
    Spec{at: AT_DECLARATION, form: FORM_PRESENT},
};
val GLOBAL_LINE_SPECS: [6]Spec = [6]Spec{
    Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_TYPE, form: FORM_REF_ADDR}, Spec{at: AT_EXTERNAL, form: FORM_FLAG},
    Spec{at: AT_DECL_FILE, form: FORM_DATA4}, Spec{at: AT_DECL_LINE, form: FORM_UDATA}, Spec{at: AT_LOCATION, form: FORM_EXPRLOC},
};
val GLOBAL_LINE_DECLARED_SPECS: [6]Spec = [6]Spec{
    Spec{at: AT_NAME, form: FORM_STRING}, Spec{at: AT_TYPE, form: FORM_REF_ADDR}, Spec{at: AT_EXTERNAL, form: FORM_FLAG},
    Spec{at: AT_DECL_FILE, form: FORM_DATA4}, Spec{at: AT_DECL_LINE, form: FORM_UDATA}, Spec{at: AT_DECLARATION, form: FORM_PRESENT},
};

# the abbreviation codes, each its row's position in ABBREVS plus one. a unit
# of one function, of several and of globals alone, each with its language
# and line table, with its language alone, with its line table alone and
# with neither
val A_UNIT_ONE:   u32 = 1;
val A_UNIT_MANY:  u32 = 5;
val A_UNIT_DATA:  u32 = 9;
val A_SUBPROGRAM: u32 = 13;
# a variable, then a parameter, each named, located, declared, and both
val A_VARIABLE:   u32 = 14;
val A_PARAMETER:  u32 = 18;
val A_BASE:       u32 = 22;
val A_STRUCTURE:  u32 = 23;
val A_UNION:      u32 = 24;
val A_MEMBER:     u32 = 25;
val A_PART:       u32 = 26;
val A_VARIANT:    u32 = 27;
val A_ENUM:       u32 = 28;
val A_ENUMERATOR: u32 = 29;
val A_ARRAY:      u32 = 30;
val A_SUBRANGE:   u32 = 31;
val A_POINTER:    u32 = 32;
val A_OPAQUE:     u32 = 33;
val A_ROUTINE:    u32 = 34;
val A_VOID:       u32 = 35;
val A_ARGUMENT:   u32 = 36;
val A_ABSTRACT:   u32 = 37;
val A_INLINED:    u32 = 38;
val A_CALLED:     u32 = 39;
# a base type of a width no whole number of bytes holds
val A_BITS: u32 = 40;
# a global located, bare and declared, then each with its declaration's place
val A_GLOBAL:        u32 = 41;
val GLOBAL_LOCATED:  u32 = 0;
val GLOBAL_BARE:     u32 = 1;
val GLOBAL_DECLARED: u32 = 2;
val GLOBAL_PLACED:   u32 = 3;
# a type declared and never defined
val A_STRUCTURE_DECLARED: u32 = 47;
val A_UNION_DECLARED:     u32 = 48;
val A_ENUM_DECLARED:      u32 = 49;
val A_UNSPECIFIED:        u32 = 50;
# a variable, then a parameter, each located by an expression alone, bare
# and declared
val A_VARIABLE_EXPR:  u32 = 51;
val A_PARAMETER_EXPR: u32 = 53;
# a function with no variables and no code inlined in it
val A_LEAF: u32 = 55;
# a type unit, then one that states no source language
val A_TYPE_UNIT:          u32 = 56;
val A_TYPE_UNIT_UNSTATED: u32 = 57;
# a declaration of a structure, union or enumeration its type unit defines
val A_STRUCTURE_SIGNED: u32 = 58;
val A_UNION_SIGNED:     u32 = 59;
val A_ENUM_SIGNED:      u32 = 60;
# a variant with no payload
val A_VARIANT_BARE: u32 = 61;

val ABBREV_COUNT: usize = 61;

val ABBREVS: [ABBREV_COUNT]Abbrev = [ABBREV_COUNT]Abbrev{
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_ONE_SPECS[0], count: 7},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_ONE_SPECS[0], count: 6},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_ONE_SPECS[1], count: 6},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_ONE_SPECS[1], count: 5},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_MANY_SPECS[0], count: 7},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_MANY_SPECS[0], count: 6},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_MANY_SPECS[1], count: 6},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_MANY_SPECS[1], count: 5},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_DATA_SPECS[0], count: 5},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_DATA_SPECS[0], count: 4},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_DATA_SPECS[1], count: 4},
    Abbrev{tag: TAG_COMPILE_UNIT, children: true, specs: ?UNIT_DATA_SPECS[1], count: 3},
    Abbrev{tag: TAG_SUBPROGRAM, children: true, specs: ?SUBPROGRAM_SPECS[0], count: 4},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?NAMED_SPECS[0], count: 2},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?LOCATED_SPECS[0], count: 3},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?DECLARED_SPECS[0], count: 4},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?PLACED_SPECS[0], count: 5},
    Abbrev{tag: TAG_PARAMETER, children: false, specs: ?NAMED_SPECS[0], count: 2},
    Abbrev{tag: TAG_PARAMETER, children: false, specs: ?LOCATED_SPECS[0], count: 3},
    Abbrev{tag: TAG_PARAMETER, children: false, specs: ?DECLARED_SPECS[0], count: 4},
    Abbrev{tag: TAG_PARAMETER, children: false, specs: ?PLACED_SPECS[0], count: 5},
    Abbrev{tag: TAG_BASE, children: false, specs: ?BASE_SPECS[0], count: 3},
    Abbrev{tag: TAG_STRUCTURE, children: true, specs: ?AGGREGATE_SPECS[0], count: 2},
    Abbrev{tag: TAG_UNION, children: true, specs: ?AGGREGATE_SPECS[0], count: 2},
    Abbrev{tag: TAG_MEMBER, children: false, specs: ?MEMBER_SPECS[0], count: 3},
    Abbrev{tag: TAG_VARIANT_PART, children: true, specs: ?PART_SPECS[0], count: 1},
    Abbrev{tag: TAG_VARIANT, children: true, specs: ?VARIANT_SPECS[0], count: 1},
    Abbrev{tag: TAG_ENUMERATION, children: true, specs: ?ENUM_SPECS[0], count: 3},
    Abbrev{tag: TAG_ENUMERATOR, children: false, specs: ?ENUMERATOR_SPECS[0], count: 2},
    Abbrev{tag: TAG_ARRAY, children: true, specs: ?TYPED_SPECS[0], count: 1},
    Abbrev{tag: TAG_SUBRANGE, children: false, specs: ?COUNT_SPECS[0], count: 1},
    Abbrev{tag: TAG_POINTER, children: false, specs: ?POINTER_SPECS[0], count: 2},
    Abbrev{tag: TAG_POINTER, children: false, specs: ?SIZED_SPECS[0], count: 1},
    Abbrev{tag: TAG_SUBROUTINE, children: true, specs: ?ROUTINE_SPECS[0], count: 2},
    Abbrev{tag: TAG_SUBROUTINE, children: true, specs: ?VOID_SPECS[0], count: 1},
    Abbrev{tag: TAG_PARAMETER, children: false, specs: ?TYPED_SPECS[0], count: 1},
    Abbrev{tag: TAG_SUBPROGRAM, children: false, specs: ?ABSTRACT_SPECS[0], count: 2},
    Abbrev{tag: TAG_INLINED, children: true, specs: ?INLINED_SPECS[0], count: 2},
    Abbrev{tag: TAG_INLINED, children: true, specs: ?CALLED_SPECS[0], count: 5},
    Abbrev{tag: TAG_BASE, children: false, specs: ?BITS_SPECS[0], count: 3},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?GLOBAL_SPECS[0], count: 4},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?GLOBAL_SPECS[0], count: 3},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?GLOBAL_DECLARED_SPECS[0], count: 4},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?GLOBAL_LINE_SPECS[0], count: 6},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?GLOBAL_LINE_SPECS[0], count: 5},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?GLOBAL_LINE_DECLARED_SPECS[0], count: 6},
    Abbrev{tag: TAG_STRUCTURE, children: false, specs: ?DECLARED_TYPE_SPECS[0], count: 2},
    Abbrev{tag: TAG_UNION, children: false, specs: ?DECLARED_TYPE_SPECS[0], count: 2},
    Abbrev{tag: TAG_ENUMERATION, children: false, specs: ?DECLARED_TYPE_SPECS[0], count: 2},
    Abbrev{tag: TAG_UNSPECIFIED, children: false, specs: ?UNSPECIFIED_SPECS[0], count: 1},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?EXPR_SPECS[0], count: 3},
    Abbrev{tag: TAG_VARIABLE, children: false, specs: ?PLACED_EXPR_SPECS[0], count: 5},
    Abbrev{tag: TAG_PARAMETER, children: false, specs: ?EXPR_SPECS[0], count: 3},
    Abbrev{tag: TAG_PARAMETER, children: false, specs: ?PLACED_EXPR_SPECS[0], count: 5},
    Abbrev{tag: TAG_SUBPROGRAM, children: false, specs: ?SUBPROGRAM_SPECS[0], count: 4},
    Abbrev{tag: TAG_TYPE_UNIT, children: true, specs: ?TYPE_UNIT_SPECS[0], count: 1},
    Abbrev{tag: TAG_TYPE_UNIT, children: true, specs: ?TYPE_UNIT_SPECS[0], count: 0},
    Abbrev{tag: TAG_STRUCTURE, children: false, specs: ?SIGNED_SPECS[0], count: 2},
    Abbrev{tag: TAG_UNION, children: false, specs: ?SIGNED_SPECS[0], count: 2},
    Abbrev{tag: TAG_ENUMERATION, children: false, specs: ?SIGNED_SPECS[0], count: 2},
    Abbrev{tag: TAG_VARIANT, children: false, specs: ?VARIANT_SPECS[0], count: 1},
};

# the type a unit is written for when it is not a type unit
val NO_HOME: u32 = 0xffff_ffff;

# a slot of a unit's contributions not taken
val NO_SLOT: u32 = 0xffff_ffff;

# the most contributions a unit makes: its information, line table and two
# list sections
val SLOTS: u32 = 4;

# a unit's shape: one extent of code, several, or none
val ONE:  u8 = 0;
val MANY: u8 = 1;
val DATA: u8 = 2;

# a reference to a type's entry waiting for the entry's offset
rec Wait {
    at:   usize;
    type: Id[debug.Type];
}

# one extent of a unit's code, from the label `from` at `start` to the label
# `to` at `end`
rec Extent {
    start: Place;
    end:   Place;
    from:  Id[Place];
    to:    Id[Place];
}

# what one encoding shares
# ---
# o:           the object
# d:           its debug records
# set:         the relocations the object's pair writes
# row:         the format's row
# address:     the bytes of an address
# out:         the record the sections are added to
# unit:        the unit the records describe
# lines:       whether the object has line records, so every unit names a
#              line table and a declaration its file
# absolute:    the kind an address datum is relocated with
# resizing:    where the linker may resize code
# fixed:       how many fixups `out` held before the encoding's
# abbrev_at:   the object's abbreviations
# abbrev_aim:  what a unit's abbreviation offset is relocated against: the
#              abbreviations' section, or where the format's links keep one
#              copy of a group, a symbol a link binds to the one copy it keeps
#              of the table every object holds alike
# info_at:     the object's .debug_info, which holds its unit
# table_at:    the object's line table, when it has line records
# locs_id:     the id the units' location lists are written for where the
#              format owns no section, a section of the object's added once
#              they are whole when a unit writes any
# rngs_id:     the id the units' range lists are written for likewise
# tail_id:     the id the units' information is written for where the format
#              owns no section, appended to the object's once it is whole
# lines_id:    the id the units' line tables are written for likewise
# strings:     the line strings
# writer:      what the line tables share
# files:       the files the unit being written names
# object:      the object's unit and its own type units
# table:       the object's line table, and each unit's after it where the
#              format owns no section
# tail:        each unit's information where the format owns no section
# line_tail:   each unit's line table likewise
# all_locs:    each unit's location lists, likewise
# all_rngs:    each unit's range lists, likewise
# info:        the entries being written
# info_id:     the section `info` is written for
# at_object:   whether `info` is the object's unit
# line_s:      the unit's line table
# locs:        the unit's location lists, from their header
# rngs:        the unit's range lists, from their header
# expr:        the expression being written
# u_base:      the id of the unit's first contribution
# slots:       how many contributions the unit makes
# line_slot:   the slot of its line table, NO_SLOT for none
# locs_slot:   the slot of its location lists, NO_SLOT for none
# rngs_slot:   the slot of its range lists, NO_SLOT for none
# unit_fixed:  how many fixups `out` held before the unit's
# one:         whether the unit is one function's, whose start is its base
# mapped:      whether a declaration's file is the unit's own line table's
# extents:     the unit's code
# seqs:        the unit's sequences
# labels:      per mark, its label in `out` plus one
# entries:     each type's entry offset in the unit being written, zero for one
#              not written in it
# written:     the types written in the unit being written
# waits:       the references waiting for a type's offset in the unit being
#              written
# addr_waits:  the references of a unit's entries to a type in the object's
#              unit
# home:        the type the unit being written is the type unit of, NO_HOME
#              for any other unit
# base:        where the unit being written starts in `info`, which its
#              offsets count from
# object_open: whether the object's unit is begun
# sigs:        per type, the signature of the type unit that describes it, zero
#              for a type no type unit describes
# type_at:     per type, the id of its shared type unit's section plus one
# origins:     per name, the offset of the abstract entry of the callee of
#              that name in the unit being written plus one
# touched:     the names `origins` holds an offset for
# stamps:      per site, the scope it was last seen in
# scope:       the last scope given out
# fn_head:     per section, its first function plus one
# fn_next:     per function, the next of its section plus one
# gl_head:     per section, its first located global plus one
# gl_next:     per global, the next of its section plus one
# sq_head:     per section, its first sequence plus one
# sq_next:     per sequence, the next of its section plus one
rec Ctx {
    o:           *Object;
    d:           *Debug;
    set:         *Lookup;
    row:         *DwarfInfo;
    address:     u8;
    out:         *Lowered;
    unit:        debug.Unit;
    lines:       bool;
    absolute:    *Kind;
    resizing:    Resizing;
    fixed:       usize;
    abbrev_at:   Id[Added];
    abbrev_aim:  Aim;
    info_at:     Id[Added];
    table_at:    Id[Added];
    locs_id:     Id[Added];
    rngs_id:     Id[Added];
    tail_id:     Id[Added];
    lines_id:    Id[Added];
    strings:     Strings;
    writer:      Writer;
    files:       Files;
    object:      Sink;
    table:       Sink;
    tail:        Sink;
    line_tail:   Sink;
    all_locs:    Sink;
    all_rngs:    Sink;
    info:        Sink;
    info_id:     Id[Added];
    at_object:   bool;
    line_s:      Sink;
    locs:        Sink;
    rngs:        Sink;
    expr:        Sink;
    u_base:      u32;
    slots:       u32;
    line_slot:   u32;
    locs_slot:   u32;
    rngs_slot:   u32;
    unit_fixed:  usize;
    one:         bool;
    mapped:      bool;
    extents:     Vector[Extent];
    seqs:        Vector[u32];
    labels:      Vector[u32];
    entries:     Vector[u32];
    written:     Vector[u32];
    waits:       Vector[Wait];
    addr_waits:  Vector[Wait];
    home:        u32;
    base:        usize;
    object_open: bool;
    sigs:        Vector[u64];
    type_at:     Vector[u32];
    origins:     Vector[u32];
    touched:     Vector[u32];
    stamps:      Vector[u32];
    scope:       u32;
    fn_head:     Vector[u32];
    fn_next:     Vector[u32];
    gl_head:     Vector[u32];
    gl_next:     Vector[u32];
    sq_head:     Vector[u32];
    sq_next:     Vector[u32];
}

# encode the debug records of `o` into `out` as DWARF 5 debugging
# information in the sections `row` names, for a target of `address`-byte
# addresses whose relocations `set` writes, with a line table for each unit
# when `lines` says the object's line records lower to DWARF line tables. an
# object with no debug records adds nothing. a refusal adds nothing either:
# - malformed for a record naming a type, member, case, enumerator,
#   parameter, step, piece, variable, range, site, mark, symbol or file past
#   its table, for a function whose marks lie in two sections or end before
#   it starts, and for a site chain that loops
# - unsupported for a function over code the linker may resize when `set`
#   has no 32-bit difference, and for an address size no absolute kind has
# - overflow for sections larger than 32-bit DWARF offsets reach
pub fun encode(o: *Object, set: *Lookup, row: *DwarfInfo, lines: bool, address: u8, out: *Lowered) err[Fail] {
    val opt_stated: opt[debug.Unit] = o.debug.unit;
    if (sel opt_stated.none) { ret err[Fail].ok{}; }
    val a:            *A.Allocator        = o.a;
    val res_resizing: res[Resizing, Fail] = difference.resizing(a, o);
    if (sel res_resizing.err) { ret err[Fail].err{res_resizing.err}; }
    val res_files: res[Files, Fail] = line.files_init(o);
    if (sel res_files.err) {
        var held:        Resizing  = res_resizing.ok;
        val err_dropped: err[Fail] = difference.dnit(?held);
        ret err[Fail].err{res_files.err};
    }
    var c: Ctx = Ctx{
        o:          o,
        d:          ?o.debug,
        set:        set,
        row:        row,
        address:    address,
        out:        out,
        unit:       opt_stated.some,
        lines:      lines,
        absolute:   ?reloc.ABS64,
        resizing:   res_resizing.ok,
        fixed:      table.count[Fixup](?out.fixups),
        strings:    Strings{s: sink.init(a, o.target.arch.order), at: vector.init[u32](a)},
        files:      res_files.ok,
        object:     sink.init(a, o.target.arch.order),
        table:      sink.init(a, o.target.arch.order),
        tail:       sink.init(a, o.target.arch.order),
        line_tail:  sink.init(a, o.target.arch.order),
        all_locs:   sink.init(a, o.target.arch.order),
        all_rngs:   sink.init(a, o.target.arch.order),
        info:       sink.init(a, o.target.arch.order),
        line_s:     sink.init(a, o.target.arch.order),
        locs:       sink.init(a, o.target.arch.order),
        rngs:       sink.init(a, o.target.arch.order),
        expr:       sink.init(a, o.target.arch.order),
        extents:    vector.init[Extent](a),
        seqs:       vector.init[u32](a),
        labels:     vector.init[u32](a),
        entries:    vector.init[u32](a),
        written:    vector.init[u32](a),
        waits:      vector.init[Wait](a),
        addr_waits: vector.init[Wait](a),
        home:       NO_HOME,
        base:       0,
        sigs:       vector.init[u64](a),
        type_at:    vector.init[u32](a),
        origins:    vector.init[u32](a),
        touched:    vector.init[u32](a),
        stamps:     vector.init[u32](a),
        scope:      0,
        fn_head:    vector.init[u32](a),
        fn_next:    vector.init[u32](a),
        gl_head:    vector.init[u32](a),
        gl_next:    vector.init[u32](a),
        sq_head:    vector.init[u32](a),
        sq_next:    vector.init[u32](a),
    };
    val m:           Mark      = lowered.mark(out);
    val err_encoded: err[Fail] = written(?c);
    val err_kept:    err[Fail] = released(?c);
    if (sel err_encoded.err) {
        lowered.truncate(out, m);
        ret err_encoded;
    }
    ret err_kept;
}

# release what the encoding held, reporting the first refusal
fun released(c: *Ctx) err[Fail] {
    var err_release: err[Fail] = difference.dnit(?c.resizing);
    err_release = fail.kept(err_release, line.strings_dnit(?c.strings));
    err_release = fail.kept(err_release, line.files_dnit(?c.files));
    err_release = fail.kept(err_release, sink.dnit(?c.object));
    err_release = fail.kept(err_release, sink.dnit(?c.table));
    err_release = fail.kept(err_release, sink.dnit(?c.tail));
    err_release = fail.kept(err_release, sink.dnit(?c.line_tail));
    err_release = fail.kept(err_release, sink.dnit(?c.all_locs));
    err_release = fail.kept(err_release, sink.dnit(?c.all_rngs));
    err_release = fail.kept(err_release, sink.dnit(?c.info));
    err_release = fail.kept(err_release, sink.dnit(?c.line_s));
    err_release = fail.kept(err_release, sink.dnit(?c.locs));
    err_release = fail.kept(err_release, sink.dnit(?c.rngs));
    err_release = fail.kept(err_release, sink.dnit(?c.expr));
    err_release = fail.kept(err_release, vectors.dnit[Extent](?c.extents));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.seqs));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.labels));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.entries));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.written));
    err_release = fail.kept(err_release, vectors.dnit[Wait](?c.waits));
    err_release = fail.kept(err_release, vectors.dnit[Wait](?c.addr_waits));
    err_release = fail.kept(err_release, vectors.dnit[u64](?c.sigs));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.type_at));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.origins));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.touched));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.stamps));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.fn_head));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.fn_next));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.gl_head));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.gl_next));
    err_release = fail.kept(err_release, vectors.dnit[u32](?c.sq_head));
    ret fail.kept(err_release, vectors.dnit[u32](?c.sq_next));
}

# a fresh sink of the object's byte order
fun fresh_sink(c: *Ctx) Sink {
    ret sink.init(c.o.a, c.o.target.arch.order);
}

# reserve the next section of `out`, its bytes filled once they are whole,
# kept once in the group `once` when it names one
fun reserved(c: *Ctx, name: str, once: opt[Id[Name]]) res[Id[Added], Fail] {
    ret lowered.add_section(c.out, Added{name: name, kind: ?section.DEBUG_INFO, flags: section.DEBUG_INFO.flags, align: 1, disposition: ?section.WHOLE, bytes: fresh_sink(c), once: once});
}

# fill the reserved section `at` with `bytes`, which it owns from then on,
# leaving `bytes` empty
fun filled(c: *Ctx, at: Id[Added], bytes: *Sink) err[Fail] {
    val x:           *Added    = lowered.section_at(c.out, at);
    val err_dropped: err[Fail] = sink.dnit(?x.bytes);
    x.bytes = @bytes;
    @bytes  = fresh_sink(c);
    ret err_dropped;
}

# the name of a group of signature `sig` a section named `prefix` is kept
# once in: the section's name, a dot and the signature in hexadecimal
fun signature_name(c: *Ctx, prefix: str, sig: u64) res[Id[Name], Fail] {
    val n:    usize = str_len(prefix);
    var text: [64]u8;
    if (n + 17 > 64) { ret res[Id[Name], Fail].err{fail.internal("a section name is too long to sign a group")}; }
    var i: usize = 0;
    for (i < n) {
        text[i] = prefix[i];
        i       = i + 1;
    }
    text[n] = '.';
    i       = 0;
    for (i < 16) {
        val nibble: u8 = ((sig >> ((60 - 4 * i)::u64)) & 0xf)::u8;
        var d:      u8 = '0' + nibble;
        if (nibble >= 10) { d = 'a' + nibble - 10; }
        text[n + 1 + i] = d;
        i               = i + 1;
    }
    ret object.name(c.o, ?text[0], n + 17);
}

# every section's bytes and fixups: the object's sections reserved, its
# unit begun, a unit per section the records name, then the object's unit
# closed, its type units and its tables
fun written(c: *Ctx) err[Fail] {
    val res_absolute_of: res[*Kind, Fail] = reloc.absolute_of(c.address);
    if (sel res_absolute_of.err) { ret err[Fail].err{res_absolute_of.err}; }
    c.absolute = res_absolute_of.ok;
    val nsec:     usize     = table.count[object.Section](?c.o.sections);
    var err_grow: err[Fail] = vectors.grow[u32](?c.origins, intern.count(?c.o.names));
    err_grow = fail.kept(err_grow, vectors.grow[u32](?c.labels, table.count[Place](?c.d.marks)));
    err_grow = fail.kept(err_grow, vectors.grow[u32](?c.entries, table.count[debug.Type](?c.d.types)));
    err_grow = fail.kept(err_grow, vectors.grow[u64](?c.sigs, table.count[debug.Type](?c.d.types)));
    err_grow = fail.kept(err_grow, vectors.grow[u32](?c.type_at, table.count[debug.Type](?c.d.types)));
    err_grow = fail.kept(err_grow, vectors.grow[u32](?c.stamps, table.count[debug.Site](?c.d.sites)));
    err_grow = fail.kept(err_grow, vectors.grow[u32](?c.fn_head, nsec));
    err_grow = fail.kept(err_grow, vectors.grow[u32](?c.gl_head, nsec));
    err_grow = fail.kept(err_grow, vectors.grow[u32](?c.sq_head, nsec));
    err_grow = fail.kept(err_grow, vectors.grow[u32](?c.fn_next, table.count[Subprogram](?c.d.functions)));
    err_grow = fail.kept(err_grow, vectors.grow[u32](?c.gl_next, table.count[Global](?c.d.globals)));
    err_grow = fail.kept(err_grow, vectors.grow[u32](?c.sq_next, table.count[Sequence](?c.o.sequences)));
    if (sel err_grow.err) { ret err_grow; }
    val err_signed: err[Fail] = signatures(c);
    if (sel err_signed.err) { ret err_signed; }
    val err_chained: err[Fail] = chained(c);
    if (sel err_chained.err) { ret err_chained; }
    val err_reserved: err[Fail] = reservations(c);
    if (sel err_reserved.err) { ret err_reserved; }
    c.writer   = Writer{o: c.o, set: c.set, address: c.address, out: c.out, resizing: ?c.resizing, absolute: c.absolute, strings: ?c.strings};
    c.tail_id  = lowered.next_section(c.out);
    c.lines_id = Id[Added]{index: c.tail_id.index + 1};
    c.locs_id  = Id[Added]{index: c.tail_id.index + SLOTS};
    c.rngs_id  = Id[Added]{index: c.tail_id.index + SLOTS + 1};
    var s: usize = 0;
    for (s < nsec) {
        if (c.fn_head.data[s] != 0 || c.gl_head.data[s] != 0 || c.sq_head.data[s] != 0) {
            val err_unit: err[Fail] = unit_out(c, s::u32);
            if (sel err_unit.err) { ret err[Fail].err{fail.in_indexed(err_unit.err, "section", s::u64)}; }
        }
        s = s + 1;
    }
    enter_object(c);
    val err_closed: err[Fail] = object_closed(c);
    leave_object(c);
    if (sel err_closed.err) { ret err_closed; }
    ret tables_filled(c);
}

# the object's unit ended: its globals with no place, every type its units
# name, then the object's own type units after it and its shared ones in
# their sections
fun object_closed(c: *Ctx) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Global](?c.d.globals)) {
        val g: *Global = table.at[Global](?c.d.globals, table.nth[Global](i));
        if (!placed_global(c, g)) {
            val err_opened: err[Fail] = object_opened(c);
            if (sel err_opened.err) { ret err_opened; }
            val err_global_entry: err[Fail] = global_entry(c, g);
            if (sel err_global_entry.err) { ret err[Fail].err{fail.in_indexed(err_global_entry.err, "debug global", i::u64)}; }
        }
        i = i + 1;
    }
    val err_resolved: err[Fail] = addresses_resolved(c, c.info_at);
    if (sel err_resolved.err) { ret err_resolved; }
    if (c.object_open) {
        val err_closed: err[Fail] = closed(c);
        if (sel err_closed.err) { ret err_closed; }
    }
    unwritten(c);
    var u: usize = 0;
    for (u < table.count[debug.Type](?c.d.types)) {
        if (unit_typed(c, table.at[debug.Type](?c.d.types, table.nth[debug.Type](u)))) {
            val err_type_unit: err[Fail] = type_unit(c, table.nth[debug.Type](u));
            if (sel err_type_unit.err) { ret err[Fail].err{fail.in_indexed(err_type_unit.err, "debug type", u::u64)}; }
        }
        u = u + 1;
    }
    ret err[Fail].ok{};
}

# the object's sections filled: the object's line table first when its unit
# was opened, then, where the format owns no section, each unit's line table
# and information appended to the object's, and each kind of list a unit
# wrote in a section of the object's
fun tables_filled(c: *Ctx) err[Fail] {
    if (c.lines && c.object_open) {
        val err_all: err[Fail] = line.files_all(?c.files, c.o);
        if (sel err_all.err) { ret err_all; }
        vector.truncate[u32](?c.seqs, 0);
        val err_table: err[Fail] = line.table_of(?c.writer, ?c.files, ?c.seqs, ?c.table, c.table_at);
        if (sel err_table.err) { ret err_table; }
    }
    if (!c.row.owned) {
        moved(c, c.fixed, c.lines_id, c.table_at, sink.len(?c.table)::u64);
        val err_lines: err[Fail] = sink.bytes(?c.table, sink.data(?c.line_tail), sink.len(?c.line_tail));
        if (sel err_lines.err)                     { ret err_lines; }
        if (sink.len(?c.table)::u64 > 0xffff_fff0) { ret err[Fail].err{fail.overflow("a debug section is larger than 32-bit DWARF offsets reach")}; }
        moved(c, c.fixed, c.tail_id, c.info_at, sink.len(?c.object)::u64);
        val err_bytes: err[Fail] = sink.bytes(?c.object, sink.data(?c.tail), sink.len(?c.tail));
        if (sel err_bytes.err)                      { ret err_bytes; }
        if (sink.len(?c.object)::u64 > 0xffff_fff0) { ret err[Fail].err{fail.overflow("a debug section is larger than 32-bit DWARF offsets reach")}; }
        val err_locs: err[Fail] = listed(c, c.locs_id, c.row.names.locations, ?c.all_locs);
        if (sel err_locs.err) { ret err_locs; }
        val err_rngs: err[Fail] = listed(c, c.rngs_id, c.row.names.ranges, ?c.all_rngs);
        if (sel err_rngs.err) { ret err_rngs; }
    }
    var err_filled: err[Fail] = filled(c, c.strings.added, ?c.strings.s);
    err_filled = fail.kept(err_filled, filled(c, c.info_at, ?c.object));
    if (c.lines) { err_filled = fail.kept(err_filled, filled(c, c.table_at, ?c.table)); }
    ret err_filled;
}

# per section, the functions, located globals and sequences it holds, each
# chain in order
fun chained(c: *Ctx) err[Fail] {
    val nsec:  usize = table.count[object.Section](?c.o.sections);
    val marks: usize = table.count[Place](?c.d.marks);
    var i:     usize = table.count[Subprogram](?c.d.functions);
    for (i > 0) {
        i = i - 1;
        val p: *Subprogram = table.at[Subprogram](?c.d.functions, table.nth[Subprogram](i));
        if (p.start.index::usize >= marks) { ret err[Fail].err{fail.in_indexed(fail.in_indexed(fail.malformed("a debug record names a mark the object does not hold"), "mark", p.start.index::u64), "debug function", i::u64)}; }
        val at: usize = table.at[Place](?c.d.marks, p.start).section.index::usize;
        if (at >= nsec) { ret err[Fail].err{fail.in_indexed(fail.in_indexed(fail.malformed("a debug mark names a section the object does not hold"), "section", at::u64), "debug function", i::u64)}; }
        c.fn_next.data[i]  = c.fn_head.data[at];
        c.fn_head.data[at] = (i + 1)::u32;
    }
    i = table.count[Global](?c.d.globals);
    for (i > 0) {
        i = i - 1;
        val opt_at: opt[u32] = global_section(c, table.at[Global](?c.d.globals, table.nth[Global](i)));
        if (sel opt_at.some) {
            c.gl_next.data[i]                  = c.gl_head.data[opt_at.some::usize];
            c.gl_head.data[opt_at.some::usize] = (i + 1)::u32;
        }
    }
    i = table.count[Sequence](?c.o.sequences);
    for (i > 0) {
        i = i - 1;
        val at: usize = object.sequence_at(c.o, table.nth[Sequence](i)).start.section.index::usize;
        if (at >= nsec) { ret err[Fail].err{fail.in_indexed(fail.malformed("a line sequence lies in a section the object does not hold"), "line sequence", i::u64)}; }
        c.sq_next.data[i]  = c.sq_head.data[at];
        c.sq_head.data[at] = (i + 1)::u32;
    }
    ret err[Fail].ok{};
}

# the section of the object a global's symbol is placed in, none for a
# global placed in none of them
fun global_section(c: *Ctx, g: *Global) opt[u32] {
    val st:  object.Storage = g.storage;
    var sym: Id[Symbol]     = Id[Symbol]{index: 0};
    if (sel st.address)                                        { sym = st.address; }
    or (sel st.thread)                                         { sym = st.thread; }
    or                                                         { ret opt[u32].none{}; }
    if (sym.index::usize >= table.count[Symbol](?c.o.symbols)) { ret opt[u32].none{}; }
    val d: Definition = object.symbol_at(c.o, sym).def;
    if (!sel d.placed)                                                               { ret opt[u32].none{}; }
    if (d.placed.section.index::usize >= table.count[object.Section](?c.o.sections)) { ret opt[u32].none{}; }
    ret opt[u32].some{d.placed.section.index};
}

# whether a global is written in the unit of its section
fun placed_global(c: *Ctx, g: *Global) bool {
    val opt_at: opt[u32] = global_section(c, g);
    ret sel opt_at.some;
}

# the object's sections, reserved in order before any unit's: its
# abbreviations, line strings, information and line table, then each shared
# type unit's
fun reservations(c: *Ctx) err[Fail] {
    val names:           *InfoNames = c.row.names;
    var abbrev:          Sink       = fresh_sink(c);
    val err_abbreviated: err[Fail]  = abbreviations(?abbrev);
    if (sel err_abbreviated.err) {
        val err_dropped: err[Fail] = sink.dnit(?abbrev);
        ret err_abbreviated;
    }
    var opt_once: opt[Id[Name]] = opt[Id[Name]].none{};
    if (c.row.units) {
        var h: u64 = fnv1a.step_bytes(fnv1a.FNV_INIT, sink.data(?abbrev), sink.len(?abbrev));
        if (h == 0) { h = 1; }
        val res_group: res[Id[Name], Fail] = signature_name(c, names.abbrev, h);
        if (sel res_group.err) {
            val err_dropped: err[Fail] = sink.dnit(?abbrev);
            ret err[Fail].err{res_group.err};
        }
        opt_once = opt[Id[Name]].some{res_group.ok};
    }
    val res_abbrev_at: res[Id[Added], Fail] = reserved(c, names.abbrev, opt_once);
    if (sel res_abbrev_at.err) {
        val err_dropped: err[Fail] = sink.dnit(?abbrev);
        ret err[Fail].err{res_abbrev_at.err};
    }
    c.abbrev_at  = res_abbrev_at.ok;
    c.abbrev_aim = Aim.added{c.abbrev_at};
    val err_filled: err[Fail] = fail.kept(filled(c, c.abbrev_at, ?abbrev), sink.dnit(?abbrev));
    if (sel err_filled.err) { ret err_filled; }
    if (sel opt_once.some) {
        val res_defined: res[u32, Fail] = lowered.add_defined(c.out, c.abbrev_at, opt_once.some);
        if (sel res_defined.err) { ret err[Fail].err{res_defined.err}; }
        c.abbrev_aim = Aim.defined{res_defined.ok};
    }
    val res_strings_at: res[Id[Added], Fail] = reserved(c, names.strings, opt[Id[Name]].none{});
    if (sel res_strings_at.err) { ret err[Fail].err{res_strings_at.err}; }
    val res_strings: res[Strings, Fail] = line.strings_init(c.o, res_strings_at.ok);
    if (sel res_strings.err) { ret err[Fail].err{res_strings.err}; }
    val err_dropped: err[Fail] = line.strings_dnit(?c.strings);
    c.strings = res_strings.ok;
    if (sel err_dropped.err) { ret err_dropped; }
    val res_info_at: res[Id[Added], Fail] = reserved(c, names.info, opt[Id[Name]].none{});
    if (sel res_info_at.err) { ret err[Fail].err{res_info_at.err}; }
    c.info_at = res_info_at.ok;
    if (c.lines) {
        val res_table_at: res[Id[Added], Fail] = reserved(c, names.line, opt[Id[Name]].none{});
        if (sel res_table_at.err) { ret err[Fail].err{res_table_at.err}; }
        c.table_at = res_table_at.ok;
    }
    var u: usize = 0;
    for (u < table.count[debug.Type](?c.d.types)) {
        val t: *debug.Type = table.at[debug.Type](?c.d.types, table.nth[debug.Type](u));
        if (unit_typed(c, t) && sel t.home.shared) {
            val res_group: res[Id[Name], Fail] = signature_name(c, names.info, c.sigs.data[u]);
            if (sel res_group.err) { ret err[Fail].err{res_group.err}; }
            val res_unit_at: res[Id[Added], Fail] = reserved(c, names.info, opt[Id[Name]].some{res_group.ok});
            if (sel res_unit_at.err) { ret err[Fail].err{res_unit_at.err}; }
            c.type_at.data[u] = res_unit_at.ok.index + 1;
        }
        u = u + 1;
    }
    ret err[Fail].ok{};
}

# make the object's unit the one being written
fun enter_object(c: *Ctx) {
    val held: Sink = c.info;
    c.info      = c.object;
    c.object    = held;
    c.info_id   = c.info_at;
    c.at_object = true;
}

# give back the unit `enter_object` left
fun leave_object(c: *Ctx) {
    val held: Sink = c.info;
    c.info      = c.object;
    c.object    = held;
    c.at_object = false;
}

# point every fixup from the `from`th on that is written in, or aims at, the
# section `was` at the section `now`, `shift` bytes further in
fun moved(c: *Ctx, from: usize, was: Id[Added], now: Id[Added], shift: u64) {
    var f: usize = from;
    for (f < table.count[Fixup](?c.out.fixups)) {
        val x: *Fixup = lowered.fixup_at(c.out, table.nth[Fixup](f));
        f = f + 1;
        if (x.section.index == was.index) {
            x.section = now;
            x.offset  = x.offset + shift;
        }
        val t: Aim = x.target;
        if (sel t.added && t.added.index == was.index) {
            x.target = Aim.added{now};
            x.addend = x.addend + shift::i64;
        }
    }
}

# the length of the unit at `at` in `s`, which runs to its end
fun length(s: *Sink, at: usize) err[Fail] {
    val n: usize = sink.len(s) - at;
    if (n::u64 - 4 > 0xffff_fff0) { ret err[Fail].err{fail.overflow("a debug section is larger than 32-bit DWARF offsets reach")}; }
    ret sink.patch(s, at, (n - 4)::u64, 4);
}

# the abbreviations, each row in order, and the table's end
fun abbreviations(s: *Sink) err[Fail] {
    var err_kept: err[Fail] = err[Fail].ok{};
    var i:        usize     = 0;
    for (i < ABBREV_COUNT) {
        val a: *Abbrev = ?ABBREVS[i];
        err_kept = fail.kept(err_kept, sink.uleb(s, (i + 1)::u64));
        err_kept = fail.kept(err_kept, sink.uleb(s, a.tag::u64));
        var children: u8 = 0;
        if (a.children) { children = 1; }
        err_kept = fail.kept(err_kept, sink.u8(s, children));
        var k: usize = 0;
        for (k < a.count) {
            err_kept = fail.kept(err_kept, sink.uleb(s, a.specs[k].at::u64));
            err_kept = fail.kept(err_kept, sink.uleb(s, a.specs[k].form::u64));
            k        = k + 1;
        }
        err_kept = fail.kept(err_kept, sink.u8(s, 0));
        err_kept = fail.kept(err_kept, sink.u8(s, 0));
        i        = i + 1;
    }
    ret fail.kept(err_kept, sink.u8(s, 0));
}

# a fixup of `width` zero bytes at the end of `s`, which the section `at`
# holds
fun fix(c: *Ctx, s: *Sink, at: Id[Added], width: u8, kind: *Kind, target: Aim, addend: i64) err[Fail] {
    val res_add_fixup: res[Id[Fixup], Fail] = lowered.add_fixup(c.out, Fixup{section: at, offset: sink.len(s)::u64, kind: kind, target: target, addend: addend});
    if (sel res_add_fixup.err) { ret err[Fail].err{res_add_fixup.err}; }
    ret sink.zeros(s, width::usize);
}

# an offset `addend` into the section `to`, at the end of `s`, which the
# section `at` holds
fun offset_into(c: *Ctx, s: *Sink, at: Id[Added], to: Id[Added], addend: i64) err[Fail] {
    ret fix(c, s, at, OFFSET, ?reloc.SECREL32, Aim.added{to}, addend);
}

# an entry's abbreviation code
fun code(c: *Ctx, a: u32) err[Fail] {
    ret sink.uleb(?c.info, a::u64);
}

# a ULEB128 attribute of `v`
fun udata(c: *Ctx, v: u64) err[Fail] {
    ret sink.uleb(?c.info, v);
}

# a string attribute, the bytes of the name in place and a NUL
fun string(c: *Ctx, n: Id[Name]) err[Fail] {
    if (n.index::usize >= intern.count(?c.o.names)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a debug record names a name the object does not hold"), "name", n.index::u64)}; }
    val v:         View      = object.name_of(c.o, n);
    val err_bytes: err[Fail] = sink.bytes(?c.info, v.data, v.len);
    ret fail.kept(err_bytes, sink.u8(?c.info, 0));
}

# a string attribute as a DW_FORM_line_strp of the name `n`
fun strp(c: *Ctx, n: Id[Name]) err[Fail] {
    val res_string_at: res[u32, Fail] = line.string_at(?c.strings, c.o, n);
    if (sel res_string_at.err) { ret err[Fail].err{res_string_at.err}; }
    ret offset_into(c, ?c.info, c.info_id, c.strings.added, res_string_at.ok::i64);
}

# the label of the mark `m`, made the first time it is named
fun label_of(c: *Ctx, m: Id[Place]) res[Id[Place], Fail] {
    if (m.index::usize >= vector.length[u32](?c.labels)) { ret res[Id[Place], Fail].err{fail.in_indexed(fail.malformed("a debug record names a mark the object does not hold"), "mark", m.index::u64)}; }
    val known: u32 = c.labels.data[m.index::usize];
    if (known != 0) { ret res[Id[Place], Fail].ok{Id[Place]{index: known - 1}}; }
    val res_label: res[Id[Place], Fail] = lowered.label(c.out, @table.at[Place](?c.d.marks, m));
    if (sel res_label.err) { ret res_label; }
    c.labels.data[m.index::usize] = res_label.ok.index + 1;
    ret res_label;
}

# the address of the label `l`, a datum at the end of `s`, which the section
# `at` holds
fun address_datum(c: *Ctx, s: *Sink, at: Id[Added], l: Id[Place]) err[Fail] {
    ret fix(c, s, at, c.address, c.absolute, Aim.label{l}, 0);
}

# the address of the mark `m`, a datum at the end of `s`, which the section
# `at` holds
fun mark_datum(c: *Ctx, s: *Sink, at: Id[Added], m: Id[Place]) err[Fail] {
    val res_label_of: res[Id[Place], Fail] = label_of(c, m);
    if (sel res_label_of.err) { ret err[Fail].err{res_label_of.err}; }
    ret address_datum(c, s, at, res_label_of.ok);
}

# a reference to a type's entry within the unit being written, filled once
# every type's entry is written
fun type_ref(c: *Ctx, t: Id[debug.Type]) err[Fail] {
    if (t.index::usize >= vector.length[u32](?c.entries)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a debug record names a type the object does not hold"), "type", t.index::u64)}; }
    val err_waits_pushed: err[Fail] = vectors.push[Wait](?c.waits, Wait{at: sink.len(?c.info), type: t});
    if (sel err_waits_pushed.err) { ret err_waits_pushed; }
    ret sink.u32(?c.info, 0);
}

# a reference of an entry outside the type tables to a type's entry in the
# object's unit, relocated once the unit's entries are written
fun type_addr(c: *Ctx, t: Id[debug.Type]) err[Fail] {
    if (t.index::usize >= vector.length[u32](?c.entries)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a debug record names a type the object does not hold"), "type", t.index::u64)}; }
    val err_waits_pushed: err[Fail] = vectors.push[Wait](?c.addr_waits, Wait{at: sink.len(?c.info), type: t});
    if (sel err_waits_pushed.err) { ret err_waits_pushed; }
    ret sink.u32(?c.info, 0);
}

# the type `t` written in the object's unit when it is not yet
fun ensure_type(c: *Ctx, t: Id[debug.Type]) err[Fail] {
    if (c.entries.data[t.index::usize] != 0) { ret err[Fail].ok{}; }
    if (c.at_object) {
        val err_opened: err[Fail] = object_opened(c);
        if (sel err_opened.err) { ret err_opened; }
        ret write_type(c, t);
    }
    val outer: Id[Added] = c.info_id;
    enter_object(c);
    val err_opened:     err[Fail] = object_opened(c);
    var err_write_type: err[Fail] = err_opened;
    if (sel err_opened.ok) { err_write_type = write_type(c, t); }
    leave_object(c);
    c.info_id = outer;
    ret err_write_type;
}

# the object's unit begun, its header and entry, the first time a type or a
# global with no place is written in it
fun object_opened(c: *Ctx) err[Fail] {
    if (c.object_open) { ret err[Fail].ok{}; }
    c.object_open = true;
    ret unit_opened(c, DATA, c.info_at, c.table_at);
}

# every reference the entries of the unit just written, which the section
# `at` holds, make to a type, each type written in the object's unit and the
# reference relocated against it
fun addresses_resolved(c: *Ctx, at: Id[Added]) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Wait](?c.addr_waits)) {
        val x:          Wait      = c.addr_waits.data[i];
        val err_ensure: err[Fail] = ensure_type(c, x.type);
        if (sel err_ensure.err) { ret err[Fail].err{fail.in_indexed(err_ensure.err, "debug type", x.type.index::u64)}; }
        val res_add_fixup: res[Id[Fixup], Fail] = lowered.add_fixup(c.out, Fixup{section: at, offset: x.at::u64, kind: ?reloc.SECREL32, target: Aim.added{c.info_at}, addend: c.entries.data[x.type.index::usize]::i64});
        if (sel res_add_fixup.err) { ret err[Fail].err{res_add_fixup.err}; }
        i = i + 1;
    }
    vector.truncate[Wait](?c.addr_waits, 0);
    ret err[Fail].ok{};
}

# a declaration's file, as the file the unit's line table names it as
fun file_of(c: *Ctx, p: Position) res[u64, Fail] {
    if (p.file.index::usize >= table.count[File](?c.o.files)) { ret res[u64, Fail].err{fail.in_indexed(fail.malformed("a debug record names a file the object does not hold"), "file", p.file.index::u64)}; }
    if (c.mapped)                                             { ret line.file_index(?c.files, p.file); }
    ret res[u64, Fail].ok{line.whole_index(p.file)};
}

# a declaration's file and line
fun declared(c: *Ctx, p: Position) err[Fail] {
    val res_file_of: res[u64, Fail] = file_of(c, p);
    if (sel res_file_of.err) { ret err[Fail].err{res_file_of.err}; }
    val err_u32: err[Fail] = sink.u32(?c.info, res_file_of.ok::u32);
    if (sel err_u32.err) { ret err_u32; }
    ret udata(c, p.line::u64);
}

# whether `r` lies within a table of `count` items
fun within_table(r: Run, count: usize) bool {
    ret r.first <= count && r.count <= count - r.first;
}

# the refusal of a record naming a run past the table of `what`
fun outside(what: str) Fail {
    ret fail.about(fail.malformed("a debug record names a run past its table"), what);
}

# the end of the children of the entry last opened
fun end_children(c: *Ctx) err[Fail] {
    ret sink.u8(?c.info, 0);
}

# the abbreviation of a unit of `base`, with its language and line table when
# it states them
fun unit_code(base: u32, language: bool, lines: bool) u32 {
    var a: u32 = base;
    if (!language) { a = a + 2; }
    if (!lines)    { a = a + 1; }
    ret a;
}

# a unit's header and entry in `c.info`, which the section `at` holds, of
# `shape`, naming the line table at the start of the section `table_id`
fun unit_opened(c: *Ctx, shape: u8, at: Id[Added], table_id: Id[Added]) err[Fail] {
    val s:       *Sink     = ?c.info;
    var err_u32: err[Fail] = sink.u32(s, 0);
    err_u32 = fail.kept(err_u32, sink.u16(s, VERSION));
    err_u32 = fail.kept(err_u32, sink.u8(s, UT_COMPILE));
    err_u32 = fail.kept(err_u32, sink.u8(s, c.address));
    err_u32 = fail.kept(err_u32, fix(c, s, at, OFFSET, ?reloc.SECREL32, c.abbrev_aim, 0));
    if (sel err_u32.err) { ret err_u32; }
    var ranges: usize = 0;
    if (shape == MANY) {
        val res_ranges: res[usize, Fail] = unit_ranges(c);
        if (sel res_ranges.err) { ret err[Fail].err{res_ranges.err}; }
        ranges = res_ranges.ok;
    }
    var base: u32 = A_UNIT_DATA;
    if (shape == ONE)  { base = A_UNIT_ONE; }
    if (shape == MANY) { base = A_UNIT_MANY; }
    val u:            debug.Unit = c.unit;
    val opt_language: opt[u16]   = u.language;
    var err_code:     err[Fail]  = code(c, unit_code(base, sel opt_language.some, c.lines));
    if (sel opt_language.some) { err_code = fail.kept(err_code, sink.u16(s, opt_language.some)); }
    err_code = fail.kept(err_code, strp(c, u.producer));
    err_code = fail.kept(err_code, strp(c, u.name));
    err_code = fail.kept(err_code, strp(c, u.directory));
    if (sel err_code.err) { ret err_code; }
    if (shape == ONE) {
        val e:         *Extent   = ?c.extents.data[0];
        val err_datum: err[Fail] = address_datum(c, s, at, e.from);
        if (sel err_datum.err) { ret err_datum; }
        val err_span: err[Fail] = span(c, e);
        if (sel err_span.err) { ret err_span; }
    }
    if (shape == MANY) {
        val err_uint: err[Fail] = sink.uint(s, 0, c.address::usize);
        if (sel err_uint.err) { ret err_uint; }
        val err_ranged: err[Fail] = list_ref(c, c.rngs_slot, ranges);
        if (sel err_ranged.err) { ret err_ranged; }
    }
    if (c.lines) { ret offset_into(c, s, at, table_id, 0); }
    ret err[Fail].ok{};
}

# the range list of every extent of the unit's code, its offset in the
# unit's range lists
fun unit_ranges(c: *Ctx) res[usize, Fail] {
    val err_begun: err[Fail] = lists_begun(c, ?c.rngs_slot, ?c.rngs);
    if (sel err_begun.err) { ret res[usize, Fail].err{err_begun.err}; }
    val begun: usize = sink.len(?c.rngs);
    var i:     usize = 0;
    for (i < vector.length[Extent](?c.extents)) {
        val e:      *Extent   = ?c.extents.data[i];
        val err_at: err[Fail] = range_at(c, e.start, e.from, e.end, e.to);
        if (sel err_at.err) { ret res[usize, Fail].err{err_at.err}; }
        i = i + 1;
    }
    val err_ended: err[Fail] = sink.u8(?c.rngs, RLE_END);
    if (sel err_ended.err) { ret res[usize, Fail].err{err_ended.err}; }
    ret res[usize, Fail].ok{begun};
}

# a range from the label `from` at `a` to the label `to` at `b` by its start
# and length over code of fixed size, by its two addresses over code the
# linker may resize
fun range_at(c: *Ctx, a: Place, from: Id[Place], b: Place, to: Id[Place]) err[Fail] {
    val at: Id[Added] = slot_id(c, c.rngs_slot);
    if (!difference.resizes_between(?c.resizing, a.section, a.offset, b.offset)) {
        var err_u8: err[Fail] = sink.u8(?c.rngs, RLE_START_LENGTH);
        err_u8 = fail.kept(err_u8, address_datum(c, ?c.rngs, at, from));
        ret fail.kept(err_u8, sink.uleb(?c.rngs, b.offset - a.offset));
    }
    var err_u8: err[Fail] = sink.u8(?c.rngs, RLE_START_END);
    err_u8 = fail.kept(err_u8, address_datum(c, ?c.rngs, at, from));
    ret fail.kept(err_u8, address_datum(c, ?c.rngs, at, to));
}

# the id the unit's contribution in `slot` takes
fun slot_id(c: *Ctx, slot: u32) Id[Added] {
    ret Id[Added]{index: c.u_base + slot};
}

# the header of a list section of the unit, when its list section `s` is
# not yet begun, taking the next slot into `slot`
fun lists_begun(c: *Ctx, slot: *u32, s: *Sink) err[Fail] {
    if (@slot != NO_SLOT) { ret err[Fail].ok{}; }
    @slot   = c.slots;
    c.slots = c.slots + 1;
    var err_u32: err[Fail] = sink.u32(s, 0);
    err_u32 = fail.kept(err_u32, sink.u16(s, VERSION));
    err_u32 = fail.kept(err_u32, sink.u8(s, c.address));
    err_u32 = fail.kept(err_u32, sink.u8(s, 0));
    ret fail.kept(err_u32, sink.u32(s, 0));
}

# a reference to the list at `offset` of the unit's list section of `slot`
fun list_ref(c: *Ctx, slot: u32, offset: usize) err[Fail] {
    ret offset_into(c, ?c.info, c.info_id, slot_id(c, slot), offset::i64);
}

# the size of an extent of code: a number when the linker may resize no code
# in it, and a difference between its labels when it may
fun span(c: *Ctx, e: *Extent) err[Fail] {
    val a: Place = e.start;
    val b: Place = e.end;
    if (b.offset < a.offset) { ret err[Fail].err{fail.malformed("a function ends before it starts")}; }
    val size: u64 = b.offset - a.offset;
    if (!difference.resizes_between(?c.resizing, a.section, a.offset, b.offset)) {
        if ((size >> 32) != 0) { ret err[Fail].err{fail.valued(fail.overflow("a function is larger than a 32-bit size holds"), size::i128)}; }
        ret sink.u32(?c.info, size::u32);
    }
    val opt_pick: opt[Pairing] = difference.pick(c.set, ?SIZE_WIDTHS[0], 1, size);
    if (sel opt_pick.none) { ret err[Fail].err{fail.unsupported("the target writes no 32-bit difference a function's size over code the linker may resize needs")}; }
    var pair:       Pairing   = opt_pick.some;
    val err_record: err[Fail] = difference.record(c.out, c.info_id, sink.len(?c.info)::u64, ?pair, Aim.label{e.to}, Aim.label{e.from});
    if (sel err_record.err) { ret err_record; }
    ret sink.zeros(?c.info, row.container(pair.plus)::usize);
}

# the extent of the function `p`, refused when its marks lie in two sections
# or it ends before it starts
fun function_extent(c: *Ctx, p: *Subprogram) res[Extent, Fail] {
    val res_from: res[Id[Place], Fail] = label_of(c, p.start);
    if (sel res_from.err) { ret res[Extent, Fail].err{res_from.err}; }
    val res_to: res[Id[Place], Fail] = label_of(c, p.end);
    if (sel res_to.err) { ret res[Extent, Fail].err{res_to.err}; }
    val a: Place = @table.at[Place](?c.d.marks, p.start);
    val b: Place = @table.at[Place](?c.d.marks, p.end);
    if (a.section.index != b.section.index) { ret res[Extent, Fail].err{fail.malformed("a function's marks lie in two sections")}; }
    if (b.offset < a.offset)                { ret res[Extent, Fail].err{fail.malformed("a function ends before it starts")}; }
    ret res[Extent, Fail].ok{Extent{start: a, end: b, from: res_from.ok, to: res_to.ok}};
}

# the extent of the sequence `q`
fun sequence_extent(c: *Ctx, q: *Sequence) res[Extent, Fail] {
    val b: Place = Place{section: q.start.section, offset: q.end};
    if (q.end < q.start.offset) { ret res[Extent, Fail].err{fail.malformed("a line sequence ends before it starts")}; }
    val res_from: res[Id[Place], Fail] = lowered.label(c.out, q.start);
    if (sel res_from.err) { ret res[Extent, Fail].err{res_from.err}; }
    val res_to: res[Id[Place], Fail] = lowered.label(c.out, b);
    if (sel res_to.err) { ret res[Extent, Fail].err{res_to.err}; }
    ret res[Extent, Fail].ok{Extent{start: q.start, end: b, from: res_from.ok, to: res_to.ok}};
}

# the unit of the section `sec`: its code's extents, the files it names, its
# entry and children, its line table, then its contributions placed
fun unit_out(c: *Ctx, sec: u32) err[Fail] {
    c.u_base     = lowered.next_section(c.out).index;
    c.slots      = 1;
    c.line_slot  = NO_SLOT;
    c.locs_slot  = NO_SLOT;
    c.rngs_slot  = NO_SLOT;
    c.unit_fixed = table.count[Fixup](?c.out.fixups);
    c.info_id    = slot_id(c, 0);
    origins_cleared(c);
    vector.truncate[Extent](?c.extents, 0);
    vector.truncate[u32](?c.seqs, 0);
    var f: u32 = c.fn_head.data[sec::usize];
    for (f != 0) {
        val p:          *Subprogram       = table.at[Subprogram](?c.d.functions, table.nth[Subprogram]((f - 1)::usize));
        val res_extent: res[Extent, Fail] = function_extent(c, p);
        if (sel res_extent.err) { ret err[Fail].err{fail.in_indexed(res_extent.err, "debug function", (f - 1)::u64)}; }
        val err_pushed: err[Fail] = vectors.push[Extent](?c.extents, res_extent.ok);
        if (sel err_pushed.err) { ret err_pushed; }
        f = c.fn_next.data[(f - 1)::usize];
    }
    var q: u32 = c.sq_head.data[sec::usize];
    for (q != 0) {
        val err_pushed: err[Fail] = vectors.push[u32](?c.seqs, q - 1);
        if (sel err_pushed.err) { ret err_pushed; }
        if (c.fn_head.data[sec::usize] == 0) {
            val res_extent: res[Extent, Fail] = sequence_extent(c, object.sequence_at(c.o, table.nth[Sequence]((q - 1)::usize)));
            if (sel res_extent.err) { ret err[Fail].err{fail.in_indexed(res_extent.err, "line sequence", (q - 1)::u64)}; }
            val err_extent_pushed: err[Fail] = vectors.push[Extent](?c.extents, res_extent.ok);
            if (sel err_extent_pushed.err) { ret err_extent_pushed; }
        }
        q = c.sq_next.data[(q - 1)::usize];
    }
    val extents: usize = vector.length[Extent](?c.extents);
    var shape:   u8    = DATA;
    if (extents == 1) { shape = ONE; }
    if (extents > 1)  { shape = MANY; }
    c.one    = shape == ONE;
    c.mapped = false;
    var table_id: Id[Added] = c.table_at;
    if (c.lines) {
        c.line_slot = 1;
        c.slots     = 2;
        table_id    = slot_id(c, c.line_slot);
        val err_files: err[Fail] = unit_files(c, sec);
        if (sel err_files.err) { ret err_files; }
        c.mapped = true;
    }
    val err_opened: err[Fail] = unit_opened(c, shape, c.info_id, table_id);
    if (sel err_opened.err) { ret err_opened; }
    val err_children: err[Fail] = children(c, sec);
    if (sel err_children.err) { ret err_children; }
    val err_end: err[Fail] = end_children(c);
    if (sel err_end.err) { ret err_end; }
    val err_length: err[Fail] = length(?c.info, 0);
    if (sel err_length.err) { ret err_length; }
    val err_resolved: err[Fail] = addresses_resolved(c, slot_id(c, 0));
    if (sel err_resolved.err) { ret err_resolved; }
    if (c.line_slot != NO_SLOT) {
        val err_table: err[Fail] = line.table_of(?c.writer, ?c.files, ?c.seqs, ?c.line_s, table_id);
        if (sel err_table.err) { ret err_table; }
    }
    if (c.locs_slot != NO_SLOT) {
        val err_locs: err[Fail] = length(?c.locs, 0);
        if (sel err_locs.err) { ret err_locs; }
    }
    if (c.rngs_slot != NO_SLOT) {
        val err_rngs: err[Fail] = length(?c.rngs, 0);
        if (sel err_rngs.err) { ret err_rngs; }
    }
    if (c.row.owned) { ret owned_placed(c, sec); }
    ret appended(c);
}

# the abstract entries of the callees inlined in the unit, its functions and
# its globals
fun children(c: *Ctx, sec: u32) err[Fail] {
    var f: u32 = c.fn_head.data[sec::usize];
    for (f != 0) {
        val err_origins: err[Fail] = abstracts(c, table.at[Subprogram](?c.d.functions, table.nth[Subprogram]((f - 1)::usize)));
        if (sel err_origins.err) { ret err[Fail].err{fail.in_indexed(err_origins.err, "debug function", (f - 1)::u64)}; }
        f = c.fn_next.data[(f - 1)::usize];
    }
    f = c.fn_head.data[sec::usize];
    for (f != 0) {
        val err_subprogram: err[Fail] = subprogram(c, table.at[Subprogram](?c.d.functions, table.nth[Subprogram]((f - 1)::usize)));
        if (sel err_subprogram.err) { ret err[Fail].err{fail.in_indexed(err_subprogram.err, "debug function", (f - 1)::u64)}; }
        f = c.fn_next.data[(f - 1)::usize];
    }
    var g: u32 = c.gl_head.data[sec::usize];
    for (g != 0) {
        val err_global_entry: err[Fail] = global_entry(c, table.at[Global](?c.d.globals, table.nth[Global]((g - 1)::usize)));
        if (sel err_global_entry.err) { ret err[Fail].err{fail.in_indexed(err_global_entry.err, "debug global", (g - 1)::u64)}; }
        g = c.gl_next.data[(g - 1)::usize];
    }
    ret err[Fail].ok{};
}

# the files the unit of the section `sec` names: the object's first, then
# each its rows, its variables, the sites inlined in it and its globals name
fun unit_files(c: *Ctx, sec: u32) err[Fail] {
    line.files_clear(?c.files);
    if (table.count[File](?c.o.files) != 0) {
        val err_first: err[Fail] = line.files_add(?c.files, table.nth[File](0));
        if (sel err_first.err) { ret err_first; }
    }
    var i: usize = 0;
    for (i < vector.length[u32](?c.seqs)) {
        val q: *Sequence = object.sequence_at(c.o, table.nth[Sequence](c.seqs.data[i]::usize));
        var k: usize     = 0;
        for (k < vector.length[Row](?q.rows)) {
            val err_row: err[Fail] = line.files_add(?c.files, q.rows.data[k].file);
            if (sel err_row.err) { ret err[Fail].err{fail.in_indexed(err_row.err, "line sequence", c.seqs.data[i]::u64)}; }
            k = k + 1;
        }
        i = i + 1;
    }
    var f: u32 = c.fn_head.data[sec::usize];
    for (f != 0) {
        val err_named: err[Fail] = function_files(c, table.at[Subprogram](?c.d.functions, table.nth[Subprogram]((f - 1)::usize)));
        if (sel err_named.err) { ret err[Fail].err{fail.in_indexed(err_named.err, "debug function", (f - 1)::u64)}; }
        f = c.fn_next.data[(f - 1)::usize];
    }
    var g: u32 = c.gl_head.data[sec::usize];
    for (g != 0) {
        val err_global: err[Fail] = line.files_add(?c.files, table.at[Global](?c.d.globals, table.nth[Global]((g - 1)::usize)).declared.file);
        if (sel err_global.err) { ret err[Fail].err{fail.in_indexed(err_global.err, "debug global", (g - 1)::u64)}; }
        g = c.gl_next.data[(g - 1)::usize];
    }
    ret err[Fail].ok{};
}

# the files a function's variables and the sites inlined in it name
fun function_files(c: *Ctx, p: *Subprogram) err[Fail] {
    if (!within_table(p.variables, table.count[debug.Variable](?c.d.variables))) { ret err[Fail].err{outside("variables")}; }
    if (!within_table(p.inlined, table.count[Inlined](?c.d.inlined)))            { ret err[Fail].err{outside("inlined runs")}; }
    var i: usize = 0;
    for (i < p.variables.count) {
        val err_add: err[Fail] = line.files_add(?c.files, table.at[debug.Variable](?c.d.variables, table.nth[debug.Variable](p.variables.first + i)).declared.file);
        if (sel err_add.err) { ret err_add; }
        i = i + 1;
    }
    val bound: usize = table.count[debug.Site](?c.d.sites);
    i = 0;
    for (i < p.inlined.count) {
        var at:    Id[debug.Site] = table.at[Inlined](?c.d.inlined, table.nth[Inlined](p.inlined.first + i)).site;
        var depth: usize          = 0;
        for {
            if (depth > bound) { ret err[Fail].err{looping()}; }
            val res_site_at: res[*debug.Site, Fail] = site_at(c, at);
            if (sel res_site_at.err) { ret err[Fail].err{res_site_at.err}; }
            val err_add: err[Fail] = line.files_add(?c.files, res_site_at.ok.call.file);
            if (sel err_add.err) { ret err_add; }
            val opt_parent: opt[Id[debug.Site]] = res_site_at.ok.parent;
            if (sel opt_parent.none) { brk; }
            at    = opt_parent.some;
            depth = depth + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the unit's contribution in `slot`: its section's name and bytes
fun slot_sink(c: *Ctx, slot: u32) *Sink {
    if (slot == c.line_slot) { ret ?c.line_s; }
    if (slot == c.locs_slot) { ret ?c.locs; }
    if (slot == c.rngs_slot) { ret ?c.rngs; }
    ret ?c.info;
}

fun slot_name(c: *Ctx, slot: u32) str {
    if (slot == c.line_slot) { ret c.row.names.line; }
    if (slot == c.locs_slot) { ret c.row.names.locations; }
    if (slot == c.rngs_slot) { ret c.row.names.ranges; }
    ret c.row.names.info;
}

# each of the unit's contributions added as a section owned by the section
# `sec`, in the order of their slots
fun owned_placed(c: *Ctx, sec: u32) err[Fail] {
    var k: u32 = 0;
    for (k < c.slots) {
        val bytes:     *Sink                = slot_sink(c, k);
        val res_added: res[Id[Added], Fail] = lowered.add_section(c.out, Added{name: slot_name(c, k), kind: ?section.DEBUG_INFO, flags: section.DEBUG_INFO.flags, align: 1, disposition: ?section.DEPENDENT, bytes: @bytes, owner: opt[Id[object.Section]].some{Id[object.Section]{index: sec}}});
        @bytes = fresh_sink(c);
        if (sel res_added.err)                  { ret err[Fail].err{res_added.err}; }
        if (res_added.ok.index != c.u_base + k) { ret err[Fail].err{fail.internal("a debug section takes another id than its fixups name")}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# each of the unit's contributions appended to the object's section of its
# kind, its fixups moved with it
fun appended(c: *Ctx) err[Fail] {
    var k: u32 = 0;
    for (k < c.slots) {
        var to:  *Sink     = ?c.tail;
        var now: Id[Added] = c.tail_id;
        if (k == c.line_slot) {
            to  = ?c.line_tail;
            now = c.lines_id;
        }
        or (k == c.locs_slot) {
            to  = ?c.all_locs;
            now = c.locs_id;
        }
        or (k == c.rngs_slot) {
            to  = ?c.all_rngs;
            now = c.rngs_id;
        }
        val bytes: *Sink = slot_sink(c, k);
        moved(c, c.unit_fixed, slot_id(c, k), now, sink.len(to)::u64);
        val err_bytes: err[Fail] = sink.bytes(to, sink.data(bytes), sink.len(bytes));
        sink.truncate(bytes, 0);
        if (sel err_bytes.err)               { ret err_bytes; }
        if (sink.len(to)::u64 > 0xffff_fff0) { ret err[Fail].err{fail.overflow("a debug section is larger than 32-bit DWARF offsets reach")}; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the lists `bytes` holds added as the object's section named `name`, the
# fixups written for `id` moved to it, nothing added when no unit wrote one
fun listed(c: *Ctx, id: Id[Added], name: str, bytes: *Sink) err[Fail] {
    if (sink.len(bytes) == 0) { ret err[Fail].ok{}; }
    val res_at: res[Id[Added], Fail] = reserved(c, name, opt[Id[Name]].none{});
    if (sel res_at.err) { ret err[Fail].err{res_at.err}; }
    moved(c, c.fixed, id, res_at.ok, 0);
    ret filled(c, res_at.ok, bytes);
}

# forget the abstract entries of the unit before
fun origins_cleared(c: *Ctx) {
    var i: usize = 0;
    for (i < vector.length[u32](?c.touched)) {
        c.origins.data[c.touched.data[i]::usize] = 0;
        i                                        = i + 1;
    }
    vector.truncate[u32](?c.touched, 0);
}

# every type the unit being written names written in it, its children ended,
# every reference to a type filled and its length stated
fun closed(c: *Ctx) err[Fail] {
    var i: usize = 0;
    for (i < vector.length[Wait](?c.waits)) {
        val t: Id[debug.Type] = c.waits.data[i].type;
        if (c.entries.data[t.index::usize] == 0) {
            val err_write_type: err[Fail] = write_type(c, t);
            if (sel err_write_type.err) { ret err[Fail].err{fail.in_indexed(err_write_type.err, "debug type", t.index::u64)}; }
        }
        i = i + 1;
    }
    val err_end: err[Fail] = end_children(c);
    if (sel err_end.err) { ret err_end; }
    i = 0;
    for (i < vector.length[Wait](?c.waits)) {
        val x:         Wait      = c.waits.data[i];
        val err_patch: err[Fail] = sink.patch(?c.info, x.at, c.entries.data[x.type.index::usize]::u64, 4);
        if (sel err_patch.err) { ret err_patch; }
        i = i + 1;
    }
    ret length(?c.info, c.base);
}

# forget where the unit just written put each type
fun unwritten(c: *Ctx) {
    var i: usize = 0;
    for (i < vector.length[u32](?c.written)) {
        c.entries.data[c.written.data[i]::usize] = 0;
        i                                        = i + 1;
    }
    vector.truncate[u32](?c.written, 0);
}

# the entry of a type in the unit being written: a declaration naming the
# type unit that describes it for a type another object describes or a type
# unit other than the one being written, else the type
fun write_type(c: *Ctx, id: Id[debug.Type]) err[Fail] {
    c.entries.data[id.index::usize] = (sink.len(?c.info) - c.base)::u32;
    val err_written_pushed: err[Fail] = vectors.push[u32](?c.written, id.index);
    if (sel err_written_pushed.err) { ret err_written_pushed; }
    val sig: u64 = c.sigs.data[id.index::usize];
    if (sig != 0 && id.index != c.home) {
        val err_code: err[Fail] = code(c, signed_code(table.at[debug.Type](?c.d.types, id).shape));
        ret fail.kept(err_code, sink.u64(?c.info, sig));
    }
    ret type_entry(c, id);
}

# the abbreviation of a declaration naming the type unit of a type of shape `s`
fun signed_code(s: Shape) u32 {
    if (sel s.union)       { ret A_UNION_SIGNED; }
    if (sel s.enumeration) { ret A_ENUM_SIGNED; }
    if (sel s.declared) {
        val d: debug.Declared = s.declared;
        if (sel d.union)       { ret A_UNION_SIGNED; }
        if (sel d.enumeration) { ret A_ENUM_SIGNED; }
    }
    ret A_STRUCTURE_SIGNED;
}

# the type unit of `t`: after the units before it in the object's section
# for the object's own type, else in the section reserved for it
fun type_unit(c: *Ctx, t: Id[debug.Type]) err[Fail] {
    val home: debug.Home = table.at[debug.Type](?c.d.types, t).home;
    if (sel home.own) {
        val held: Vector[Wait] = c.waits;
        c.waits = vector.init[Wait](c.o.a);
        c.home  = t.index;
        c.base  = sink.len(?c.info);
        var err_unit_written: err[Fail] = unit_written(c, t, c.info_at);
        err_unit_written = fail.kept(err_unit_written, vectors.dnit[Wait](?c.waits));
        unwritten(c);
        c.waits = held;
        c.home  = NO_HOME;
        c.base  = 0;
        ret err_unit_written;
    }
    val at:    Id[Added]    = Id[Added]{index: c.type_at.data[t.index::usize] - 1};
    val outer: Sink         = c.info;
    val held:  Vector[Wait] = c.waits;
    c.info    = fresh_sink(c);
    c.info_id = at;
    c.waits   = vector.init[Wait](c.o.a);
    c.home    = t.index;
    var err_unit_written: err[Fail] = unit_written(c, t, at);
    err_unit_written = fail.kept(err_unit_written, vectors.dnit[Wait](?c.waits));
    unwritten(c);
    var unit: Sink = c.info;
    c.info    = outer;
    c.info_id = c.info_at;
    c.waits   = held;
    c.home    = NO_HOME;
    if (sel err_unit_written.err) {
        val err_dropped: err[Fail] = sink.dnit(?unit);
        ret err_unit_written;
    }
    val err_filled: err[Fail] = filled(c, at, ?unit);
    ret fail.kept(err_filled, sink.dnit(?unit));
}

# the header, unit entry and entries of the type unit of `t`, which the
# section `at` holds
fun unit_written(c: *Ctx, t: Id[debug.Type], at: Id[Added]) err[Fail] {
    val s:       *Sink     = ?c.info;
    var err_u32: err[Fail] = sink.u32(s, 0);
    err_u32 = fail.kept(err_u32, sink.u16(s, VERSION));
    err_u32 = fail.kept(err_u32, sink.u8(s, UT_TYPE));
    err_u32 = fail.kept(err_u32, sink.u8(s, c.address));
    err_u32 = fail.kept(err_u32, fix(c, s, at, OFFSET, ?reloc.SECREL32, c.abbrev_aim, 0));
    err_u32 = fail.kept(err_u32, sink.u64(s, c.sigs.data[t.index::usize]));
    val typed: usize = sink.len(s);
    err_u32 = fail.kept(err_u32, sink.u32(s, 0));
    val opt_language: opt[u16] = c.unit.language;
    if (sel opt_language.some) {
        err_u32 = fail.kept(err_u32, code(c, A_TYPE_UNIT));
        err_u32 = fail.kept(err_u32, sink.u16(s, opt_language.some));
    }
    or                   { err_u32 = fail.kept(err_u32, code(c, A_TYPE_UNIT_UNSTATED)); }
    if (sel err_u32.err) { ret err_u32; }
    val err_patch: err[Fail] = sink.patch(s, typed, (sink.len(s) - c.base)::u64, 4);
    if (sel err_patch.err) { ret err_patch; }
    val err_write_type: err[Fail] = write_type(c, t);
    if (sel err_write_type.err) { ret err_write_type; }
    ret closed(c);
}

# whether a type is one a type unit of this object describes: a structure,
# union, tagged union or enumeration with a key that is the object's own, or
# shared where the format's links keep one copy of a group
fun unit_typed(c: *Ctx, t: *debug.Type) bool {
    val s: Shape = t.shape;
    if (!(sel s.structure || sel s.union || sel s.tagged || sel s.enumeration)) { ret false; }
    if (object.name_of(c.o, t.key).len == 0)                                    { ret false; }
    if (sel t.home.own)                                                         { ret true; }
    ret sel t.home.shared && c.row.units;
}

# the signature of each type a type unit describes, this object's or
# another's: the hash of its key, so every object names it alike. never zero
fun signatures(c: *Ctx) err[Fail] {
    val n: usize = table.count[debug.Type](?c.d.types);
    var i: usize = 0;
    for (i < n) {
        val t: *debug.Type = table.at[debug.Type](?c.d.types, table.nth[debug.Type](i));
        if (sel t.home.outside || unit_typed(c, t)) {
            val k: View = object.name_of(c.o, t.key);
            if (k.len == 0) { ret err[Fail].err{fail.in_indexed(fail.malformed("a debug type another object describes has no key"), "debug type", i::u64)}; }
            var h: u64 = fnv1a.step_bytes(fnv1a.FNV_INIT, k.data, k.len);
            if (h == 0) { h = 1; }
            c.sigs.data[i] = h;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the entry of a member, at its offset
fun member(c: *Ctx, m: debug.Member) err[Fail] {
    var err_code: err[Fail] = code(c, A_MEMBER);
    err_code = fail.kept(err_code, string(c, m.name));
    err_code = fail.kept(err_code, type_ref(c, m.type));
    err_code = fail.kept(err_code, udata(c, m.offset));
    ret err_code;
}

# the DW_ATE code of the encoding `e`
fun encoding_of(e: debug.Encoding) u8 {
    if (sel e.signed)    { ret ATE_SIGNED; }
    if (sel e.unsigned)  { ret ATE_UNSIGNED; }
    if (sel e.float)     { ret ATE_FLOAT; }
    if (sel e.boolean)   { ret ATE_BOOLEAN; }
    if (sel e.character) { ret ATE_CHARACTER; }
    ret ATE_ADDRESS;
}

# a tagged union: a structure of its discriminant and a variant part of its
# cases, whose variants hold their payloads
fun tagged(c: *Ctx, name: Id[Name], t: debug.Tagged) err[Fail] {
    if (!within_table(t.cases, table.count[debug.Case](?c.d.cases))) { ret err[Fail].err{outside("cases")}; }
    var err_code: err[Fail] = code(c, A_STRUCTURE);
    err_code = fail.kept(err_code, string(c, name));
    err_code = fail.kept(err_code, udata(c, t.size));
    if (sel err_code.err) { ret err_code; }
    val disc:     usize     = sink.len(?c.info) - c.base;
    val err_head: err[Fail] = member(c, t.discriminant);
    if (sel err_head.err) { ret err_head; }
    var err_code_a_part: err[Fail] = code(c, A_PART);
    err_code_a_part = fail.kept(err_code_a_part, sink.u32(?c.info, disc::u32));
    if (sel err_code_a_part.err) { ret err_code_a_part; }
    var i: usize = 0;
    for (i < t.cases.count) {
        val k:           *debug.Case       = table.at[debug.Case](?c.d.cases, table.nth[debug.Case](t.cases.first + i));
        val opt_carried: opt[debug.Member] = k.payload;
        i = i + 1;
        if (sel opt_carried.none) {
            var err_code: err[Fail] = code(c, A_VARIANT_BARE);
            err_code = fail.kept(err_code, udata(c, k.value));
            if (sel err_code.err) { ret err_code; }
            cnt;
        }
        var err_code: err[Fail] = code(c, A_VARIANT);
        err_code = fail.kept(err_code, udata(c, k.value));
        err_code = fail.kept(err_code, member(c, opt_carried.some));
        err_code = fail.kept(err_code, end_children(c));
        if (sel err_code.err) { ret err_code; }
    }
    val err_part: err[Fail] = end_children(c);
    if (sel err_part.err) { ret err_part; }
    ret end_children(c);
}

# the entry of one type, and its children
fun type_entry(c: *Ctx, id: Id[debug.Type]) err[Fail] {
    val t: *debug.Type = table.at[debug.Type](?c.d.types, id);
    val s: Shape       = t.shape;
    if (sel s.declared)    { ret declared_type(c, t.name, s.declared); }
    or (sel s.base)        { ret base(c, t.name, s.base); }
    or (sel s.tagged)      { ret tagged(c, t.name, s.tagged); }
    or (sel s.structure)   { ret aggregate(c, A_STRUCTURE, t.name, s.structure); }
    or (sel s.union)       { ret aggregate(c, A_UNION, t.name, s.union); }
    or (sel s.enumeration) { ret enumeration(c, t.name, s.enumeration); }
    or (sel s.array)       { ret array(c, s.array); }
    or (sel s.pointer)     { ret pointer(c, s.pointer); }
    ret routine(c, s.routine);
}

# a type declared and never defined: a structure, union or enumeration with
# no size or members, and a named type that is unspecified for any other kind
fun declared_type(c: *Ctx, name: Id[Name], d: debug.Declared) err[Fail] {
    var a: u32 = A_UNSPECIFIED;
    if (sel d.structure)   { a = A_STRUCTURE_DECLARED; }
    or (sel d.union)       { a = A_UNION_DECLARED; }
    or (sel d.enumeration) { a = A_ENUM_DECLARED; }
    val err_code: err[Fail] = code(c, a);
    ret fail.kept(err_code, string(c, name));
}

# a scalar, its size in bytes, or in bits when no whole number of bytes
# holds it
fun base(c: *Ctx, name: Id[Name], b: debug.Base) err[Fail] {
    var a:    u32 = A_BITS;
    var size: u64 = b.bits::u64;
    if (b.bits % 8 == 0) {
        a    = A_BASE;
        size = (b.bits / 8)::u64;
    }
    var err_code: err[Fail] = code(c, a);
    err_code = fail.kept(err_code, string(c, name));
    err_code = fail.kept(err_code, sink.u8(?c.info, encoding_of(b.encoding)));
    ret fail.kept(err_code, udata(c, size));
}

# an enumeration, its base type and size, and its enumerators as children
fun enumeration(c: *Ctx, name: Id[Name], e: debug.Enumeration) err[Fail] {
    if (!within_table(e.enumerators, table.count[debug.Enumerator](?c.d.enumerators))) { ret err[Fail].err{outside("enumerators")}; }
    var err_code: err[Fail] = code(c, A_ENUM);
    err_code = fail.kept(err_code, string(c, name));
    err_code = fail.kept(err_code, type_ref(c, e.base));
    err_code = fail.kept(err_code, udata(c, e.size));
    if (sel err_code.err) { ret err_code; }
    var i: usize = 0;
    for (i < e.enumerators.count) {
        val v:        *debug.Enumerator = table.at[debug.Enumerator](?c.d.enumerators, table.nth[debug.Enumerator](e.enumerators.first + i));
        var err_code: err[Fail]         = code(c, A_ENUMERATOR);
        err_code = fail.kept(err_code, string(c, v.name));
        err_code = fail.kept(err_code, udata(c, v.value));
        if (sel err_code.err) { ret err_code; }
        i = i + 1;
    }
    ret end_children(c);
}

# an array of its element type, with one subrange of its count
fun array(c: *Ctx, a: debug.Array) err[Fail] {
    var err_code: err[Fail] = code(c, A_ARRAY);
    err_code = fail.kept(err_code, type_ref(c, a.element));
    err_code = fail.kept(err_code, code(c, A_SUBRANGE));
    err_code = fail.kept(err_code, udata(c, a.count));
    ret fail.kept(err_code, end_children(c));
}

# a pointer, the size of an address, to its target or to nothing stated
fun pointer(c: *Ctx, target: opt[Id[debug.Type]]) err[Fail] {
    if (sel target.some) {
        var err_code: err[Fail] = code(c, A_POINTER);
        err_code = fail.kept(err_code, type_ref(c, target.some));
        ret fail.kept(err_code, udata(c, c.address::u64));
    }
    val err_code: err[Fail] = code(c, A_OPAQUE);
    ret fail.kept(err_code, udata(c, c.address::u64));
}

# a structure or union of abbreviation `a`, its size and its members as
# children
fun aggregate(c: *Ctx, a: u32, name: Id[Name], g: debug.Aggregate) err[Fail] {
    if (!within_table(g.members, table.count[debug.Member](?c.d.members))) { ret err[Fail].err{outside("members")}; }
    var err_code: err[Fail] = code(c, a);
    err_code = fail.kept(err_code, string(c, name));
    err_code = fail.kept(err_code, udata(c, g.size));
    if (sel err_code.err) { ret err_code; }
    var i: usize = 0;
    for (i < g.members.count) {
        val err_member: err[Fail] = member(c, @table.at[debug.Member](?c.d.members, table.nth[debug.Member](g.members.first + i)));
        if (sel err_member.err) { ret err_member; }
        i = i + 1;
    }
    ret end_children(c);
}

# a subroutine type, its result when it has one and a child per parameter
fun routine(c: *Ctx, f: debug.Routine) err[Fail] {
    if (!within_table(f.params, table.count[Id[debug.Type]](?c.d.params))) { ret err[Fail].err{outside("parameters")}; }
    val opt_result_type: opt[Id[debug.Type]] = f.result;
    var err_code:        err[Fail]           = err[Fail].ok{};
    if (sel opt_result_type.some) {
        err_code = code(c, A_ROUTINE);
        err_code = fail.kept(err_code, type_ref(c, opt_result_type.some));
    }
    or                    { err_code = code(c, A_VOID); }
    if (sel err_code.err) { ret err_code; }
    var i: usize = 0;
    for (i < f.params.count) {
        var err_code: err[Fail] = code(c, A_ARGUMENT);
        err_code = fail.kept(err_code, type_ref(c, @table.at[Id[debug.Type]](?c.d.params, table.nth[Id[debug.Type]](f.params.first + i))));
        if (sel err_code.err) { ret err_code; }
        i = i + 1;
    }
    ret end_children(c);
}

# the kind and width a thread-local's offset is written as under the
# format's row, none when the row states a kind the object's relocations
# write none of
fun tls_kind(c: *Ctx) opt[TlsKind] {
    val t: TlsOffset = c.row.tls;
    if (sel t.address) { ret opt[TlsKind].some{TlsKind{kind: c.absolute, width: c.address}}; }
    var i: usize = 0;
    for (i < t.relocated.count) {
        val k:           TlsKind             = t.relocated.kinds[i];
        val res_by_kind: res[*row.Row, Fail] = row.by_kind(c.set, k.kind);
        if (sel res_by_kind.ok) { ret opt[TlsKind].some{k}; }
        i = i + 1;
    }
    ret opt[TlsKind].none{};
}

# the entry of one global in the unit being written
fun global_entry(c: *Ctx, g: *Global) err[Fail] {
    var form:    u32            = GLOBAL_BARE;
    var opt_tls: opt[TlsKind]   = opt[TlsKind].none{};
    var sym:     Id[Symbol]     = Id[Symbol]{index: 0};
    val st:      object.Storage = g.storage;
    if (sel st.declaration) { form = GLOBAL_DECLARED; }
    or (sel st.thread) {
        if (st.thread.index::usize >= table.count[Symbol](?c.o.symbols)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a debug record names a symbol the object does not hold"), "symbol", st.thread.index::u64)}; }
        sym     = st.thread;
        opt_tls = tls_kind(c);
        if (sel opt_tls.some) { form = GLOBAL_LOCATED; }
    }
    or (sel st.address) {
        if (st.address.index::usize >= table.count[Symbol](?c.o.symbols)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a debug record names a symbol the object does not hold"), "symbol", st.address.index::u64)}; }
        sym  = st.address;
        form = GLOBAL_LOCATED;
    }
    var a: u32 = A_GLOBAL + form;
    if (c.lines) { a = a + GLOBAL_PLACED; }
    var external: u8 = 0;
    if (g.external) { external = 1; }
    var err_code: err[Fail] = code(c, a);
    err_code = fail.kept(err_code, string(c, g.name));
    err_code = fail.kept(err_code, type_addr(c, g.type));
    err_code = fail.kept(err_code, sink.u8(?c.info, external));
    if (c.lines)                { err_code = fail.kept(err_code, declared(c, g.declared)); }
    if (sel err_code.err)       { ret err_code; }
    if (form != GLOBAL_LOCATED) { ret err[Fail].ok{}; }
    val s: *Sink = ?c.info;
    if (sel opt_tls.some) {
        val k:  TlsKind = opt_tls.some;
        var op: u8      = OP_CONST8U;
        if (k.width == 4) { op = OP_CONST4U; }
        var err_uleb: err[Fail] = sink.uleb(s, (2 + k.width::u32)::u64);
        err_uleb = fail.kept(err_uleb, sink.u8(s, op));
        err_uleb = fail.kept(err_uleb, fix(c, s, c.info_id, k.width, k.kind, Aim.symbol{sym}, 0));
        err_uleb = fail.kept(err_uleb, sink.u8(s, OP_TLS_ADDRESS));
        ret err_uleb;
    }
    var err_uleb: err[Fail] = sink.uleb(s, (1 + c.address::u32)::u64);
    err_uleb = fail.kept(err_uleb, sink.u8(s, OP_ADDR));
    err_uleb = fail.kept(err_uleb, fix(c, s, c.info_id, c.address, c.absolute, Aim.symbol{sym}, 0));
    ret err_uleb;
}

# the site `s` refused when it lies past the sites table
fun site_at(c: *Ctx, s: Id[debug.Site]) res[*debug.Site, Fail] {
    if (s.index::usize >= table.count[debug.Site](?c.d.sites)) { ret res[*debug.Site, Fail].err{fail.in_indexed(fail.malformed("a debug record names a site the object does not hold"), "site", s.index::u64)}; }
    ret res[*debug.Site, Fail].ok{table.at[debug.Site](?c.d.sites, s)};
}

# the refusal of a chain of inlining sites that loops
fun looping() Fail {
    ret fail.malformed("a chain of inlining sites loops");
}

# the abstract entry of every callee whose code the function `p` holds
# inlined, each the first time a site chain of the unit names it
fun abstracts(c: *Ctx, p: *Subprogram) err[Fail] {
    val bound: usize = table.count[debug.Site](?c.d.sites);
    if (!within_table(p.inlined, table.count[Inlined](?c.d.inlined))) { ret err[Fail].err{outside("inlined runs")}; }
    var i: usize = 0;
    for (i < p.inlined.count) {
        var at:    Id[debug.Site] = table.at[Inlined](?c.d.inlined, table.nth[Inlined](p.inlined.first + i)).site;
        var depth: usize          = 0;
        for {
            if (depth > bound) { ret err[Fail].err{looping()}; }
            val res_site_at: res[*debug.Site, Fail] = site_at(c, at);
            if (sel res_site_at.err) { ret err[Fail].err{res_site_at.err}; }
            val callee: Id[Name] = res_site_at.ok.callee;
            if (callee.index::usize >= vector.length[u32](?c.origins)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a debug record names a name the object does not hold"), "name", callee.index::u64)}; }
            if (c.origins.data[callee.index::usize] == 0) {
                c.origins.data[callee.index::usize] = sink.len(?c.info)::u32 + 1;
                var err_code: err[Fail] = vectors.push[u32](?c.touched, callee.index);
                err_code = fail.kept(err_code, code(c, A_ABSTRACT));
                err_code = fail.kept(err_code, string(c, callee));
                err_code = fail.kept(err_code, sink.u8(?c.info, INLINED));
                if (sel err_code.err) { ret err_code; }
            }
            val opt_parent: opt[Id[debug.Site]] = res_site_at.ok.parent;
            if (sel opt_parent.none) { brk; }
            at    = opt_parent.some;
            depth = depth + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the entry of one function, its variables and the code inlined in it
fun subprogram(c: *Ctx, p: *Subprogram) err[Fail] {
    if (!within_table(p.variables, table.count[debug.Variable](?c.d.variables))) { ret err[Fail].err{outside("variables")}; }
    val res_extent: res[Extent, Fail] = function_extent(c, p);
    if (sel res_extent.err) { ret err[Fail].err{res_extent.err}; }
    var e:    Extent = res_extent.ok;
    val leaf: bool   = p.variables.count == 0 && p.inlined.count == 0;
    var a:    u32    = A_SUBPROGRAM;
    if (leaf) { a = A_LEAF; }
    var err_code: err[Fail] = code(c, a);
    err_code = fail.kept(err_code, string(c, p.name));
    err_code = fail.kept(err_code, address_datum(c, ?c.info, c.info_id, e.from));
    err_code = fail.kept(err_code, span(c, ?e));
    err_code = fail.kept(err_code, sink.uleb(?c.info, 1));
    err_code = fail.kept(err_code, sink.u8(?c.info, OP_CFA));
    if (sel err_code.err) { ret err_code; }
    if (leaf)             { ret err[Fail].ok{}; }
    var f: Code  = Code{start: e.start, end: e.end, from: e.from, fixed: !difference.resizes_between(?c.resizing, e.start.section, e.start.offset, e.end.offset), based: c.one};
    var i: usize = 0;
    for (i < p.variables.count) {
        val err_variable: err[Fail] = variable(c, ?f, table.at[debug.Variable](?c.d.variables, table.nth[debug.Variable](p.variables.first + i)));
        if (sel err_variable.err) { ret err[Fail].err{fail.in_indexed(err_variable.err, "debug variable", (p.variables.first + i)::u64)}; }
        i = i + 1;
    }
    val scope: u32 = fresh(c);
    i = 0;
    for (i < p.inlined.count) {
        val r:        *Inlined                       = table.at[Inlined](?c.d.inlined, table.nth[Inlined](p.inlined.first + i));
        val res_root: res[opt[Id[debug.Site]], Fail] = child_of(c, r.site, opt[Id[debug.Site]].none{});
        if (sel res_root.err) { ret err[Fail].err{res_root.err}; }
        val opt_found: opt[Id[debug.Site]] = res_root.ok;
        if (sel opt_found.some) {
            if (c.stamps.data[opt_found.some.index::usize] != scope) {
                c.stamps.data[opt_found.some.index::usize] = scope;
                val err_nested: err[Fail] = inlined(c, p, ?f, opt_found.some);
                if (sel err_nested.err) { ret err_nested; }
            }
        }
        i = i + 1;
    }
    ret end_children(c);
}

# a scope no seen site is stamped with yet
fun fresh(c: *Ctx) u32 {
    c.scope = c.scope + 1;
    ret c.scope;
}

# whether the site `s` lies on the chain from `inner` out
fun within(c: *Ctx, inner: Id[debug.Site], s: Id[debug.Site]) res[bool, Fail] {
    val bound: usize          = table.count[debug.Site](?c.d.sites);
    var here:  Id[debug.Site] = inner;
    var depth: usize          = 0;
    for {
        if (depth > bound)         { ret res[bool, Fail].err{looping()}; }
        if (here.index == s.index) { ret res[bool, Fail].ok{true}; }
        val res_site_at: res[*debug.Site, Fail] = site_at(c, here);
        if (sel res_site_at.err) { ret res[bool, Fail].err{res_site_at.err}; }
        val opt_parent: opt[Id[debug.Site]] = res_site_at.ok.parent;
        if (sel opt_parent.none) { ret res[bool, Fail].ok{false}; }
        here  = opt_parent.some;
        depth = depth + 1;
    }
    ret res[bool, Fail].ok{false};
}

# the site on the chain from `inner` out whose parent is `parent`, the
# outermost site for a parent of none, and none for a chain `parent` is not on
fun child_of(c: *Ctx, inner: Id[debug.Site], parent: opt[Id[debug.Site]]) res[opt[Id[debug.Site]], Fail] {
    val bound: usize          = table.count[debug.Site](?c.d.sites);
    var at:    Id[debug.Site] = inner;
    var depth: usize          = 0;
    for {
        if (depth > bound) { ret res[opt[Id[debug.Site]], Fail].err{looping()}; }
        val res_site_at: res[*debug.Site, Fail] = site_at(c, at);
        if (sel res_site_at.err) { ret res[opt[Id[debug.Site]], Fail].err{res_site_at.err}; }
        val opt_parent: opt[Id[debug.Site]] = res_site_at.ok.parent;
        if (sel parent.none) {
            if (sel opt_parent.none) { ret res[opt[Id[debug.Site]], Fail].ok{opt[Id[debug.Site]].some{at}}; }
        }
        or {
            if (sel opt_parent.some) {
                if (opt_parent.some.index == parent.some.index) { ret res[opt[Id[debug.Site]], Fail].ok{opt[Id[debug.Site]].some{at}}; }
            }
        }
        if (sel opt_parent.none) { ret res[opt[Id[debug.Site]], Fail].ok{opt[Id[debug.Site]].none{}}; }
        at    = opt_parent.some;
        depth = depth + 1;
    }
    ret res[opt[Id[debug.Site]], Fail].ok{opt[Id[debug.Site]].none{}};
}

# the inlined subroutine of a site and the sites inlined within it, nested,
# in the function `p` over the code `f`
fun inlined(c: *Ctx, p: *Subprogram, f: *Code, s: Id[debug.Site]) err[Fail] {
    val res_site_at: res[*debug.Site, Fail] = site_at(c, s);
    if (sel res_site_at.err) { ret err[Fail].err{res_site_at.err}; }
    val site:      debug.Site = @res_site_at.ok;
    val err_begun: err[Fail]  = lists_begun(c, ?c.rngs_slot, ?c.rngs);
    if (sel err_begun.err) { ret err_begun; }
    val begun: usize = sink.len(?c.rngs);
    var i:     usize = 0;
    for (i < p.inlined.count) {
        val r:          *Inlined        = table.at[Inlined](?c.d.inlined, table.nth[Inlined](p.inlined.first + i));
        val res_within: res[bool, Fail] = within(c, r.site, s);
        if (sel res_within.err) { ret err[Fail].err{res_within.err}; }
        if (res_within.ok) {
            val err_range_entry: err[Fail] = range_entry(c, f, r.start, r.end);
            if (sel err_range_entry.err) { ret err_range_entry; }
        }
        i = i + 1;
    }
    val err_ended: err[Fail] = sink.u8(?c.rngs, RLE_END);
    if (sel err_ended.err) { ret err_ended; }
    val from: u32 = c.origins.data[site.callee.index::usize];
    if (from == 0) { ret err[Fail].ok{}; }
    var err_code: err[Fail] = err[Fail].ok{};
    if (c.lines) {
        err_code = code(c, A_CALLED);
        err_code = fail.kept(err_code, sink.u32(?c.info, from - 1));
        err_code = fail.kept(err_code, list_ref(c, c.rngs_slot, begun));
        err_code = fail.kept(err_code, declared(c, site.call));
        err_code = fail.kept(err_code, udata(c, site.call.column::u64));
    }
    or {
        err_code = code(c, A_INLINED);
        err_code = fail.kept(err_code, sink.u32(?c.info, from - 1));
        err_code = fail.kept(err_code, list_ref(c, c.rngs_slot, begun));
    }
    if (sel err_code.err) { ret err_code; }
    val scope: u32 = fresh(c);
    i = 0;
    for (i < p.inlined.count) {
        val r:         *Inlined                       = table.at[Inlined](?c.d.inlined, table.nth[Inlined](p.inlined.first + i));
        val res_child: res[opt[Id[debug.Site]], Fail] = child_of(c, r.site, opt[Id[debug.Site]].some{s});
        if (sel res_child.err) { ret err[Fail].err{res_child.err}; }
        val opt_found: opt[Id[debug.Site]] = res_child.ok;
        if (sel opt_found.some) {
            if (c.stamps.data[opt_found.some.index::usize] != scope) {
                c.stamps.data[opt_found.some.index::usize] = scope;
                val err_nested: err[Fail] = inlined(c, p, f, opt_found.some);
                if (sel err_nested.err) { ret err_nested; }
            }
        }
        i = i + 1;
    }
    ret end_children(c);
}

# a function's code as its variables' locations and inlined ranges are
# stated over it
# ---
# start: its first place
# end:   the place past its last
# from:  the label at its start
# fixed: whether the linker may resize none of it, so a place's offset from
#        its start is the same in the image
# based: whether its start is its unit's base address
rec Code {
    start: Place;
    end:   Place;
    from:  Id[Place];
    fixed: bool;
    based: bool;
}

# the place of the mark `m` of a range of the function over `f`, refused
# outside its code
fun within_code(c: *Ctx, f: *Code, m: Id[Place]) res[Place, Fail] {
    if (m.index::usize >= table.count[Place](?c.d.marks)) { ret res[Place, Fail].err{fail.in_indexed(fail.malformed("a debug record names a mark the object does not hold"), "mark", m.index::u64)}; }
    val at: Place = @table.at[Place](?c.d.marks, m);
    if (at.section.index != f.start.section.index || at.offset < f.start.offset || at.offset > f.end.offset) { ret res[Place, Fail].err{fail.malformed("a variable's range lies outside its function")}; }
    ret res[Place, Fail].ok{at};
}

# the entry of one variable of the function over `f`
fun variable(c: *Ctx, f: *Code, v: *debug.Variable) err[Fail] {
    if (!within_table(v.ranges, table.count[Range](?c.d.ranges))) { ret err[Fail].err{outside("ranges")}; }
    val res_whole: res[bool, Fail] = whole_code(c, f, v.ranges);
    if (sel res_whole.err) { ret err[Fail].err{res_whole.err}; }
    var opt_list: opt[usize] = opt[usize].none{};
    if (!res_whole.ok) {
        val res_listed: res[opt[usize], Fail] = location_list(c, f, v.ranges);
        if (sel res_listed.err) { ret err[Fail].err{res_listed.err}; }
        opt_list = res_listed.ok;
    }
    var a: u32 = A_VARIABLE;
    if (res_whole.ok) {
        a = A_VARIABLE_EXPR;
        if (v.parameter) { a = A_PARAMETER_EXPR; }
        if (c.lines)     { a = a + 1; }
    }
    or {
        if (v.parameter)       { a = A_PARAMETER; }
        if (sel opt_list.some) { a = a + 1; }
        if (c.lines)           { a = a + 2; }
    }
    var err_code: err[Fail] = code(c, a);
    err_code = fail.kept(err_code, string(c, v.name));
    err_code = fail.kept(err_code, type_addr(c, v.type));
    if (c.lines)          { err_code = fail.kept(err_code, declared(c, v.declared)); }
    if (sel err_code.err) { ret err_code; }
    if (res_whole.ok) {
        var err_uleb: err[Fail] = sink.uleb(?c.info, sink.len(?c.expr)::u64);
        ret fail.kept(err_uleb, sink.bytes(?c.info, sink.data(?c.expr), sink.len(?c.expr)));
    }
    if (sel opt_list.some) { ret list_ref(c, c.locs_slot, opt_list.some); }
    ret err[Fail].ok{};
}

# whether a variable's ranges are one over all of its function's code at a
# location DWARF states, its expression left in `c.expr`
fun whole_code(c: *Ctx, f: *Code, ranges: Run) res[bool, Fail] {
    if (ranges.count != 1) { ret res[bool, Fail].ok{false}; }
    val r:        *Range           = table.at[Range](?c.d.ranges, table.nth[Range](ranges.first));
    val res_from: res[Place, Fail] = within_code(c, f, r.start);
    if (sel res_from.err) { ret res[bool, Fail].err{res_from.err}; }
    val res_within_code: res[Place, Fail] = within_code(c, f, r.end);
    if (sel res_within_code.err)                                                           { ret res[bool, Fail].err{res_within_code.err}; }
    if (res_from.ok.offset != f.start.offset || res_within_code.ok.offset != f.end.offset) { ret res[bool, Fail].ok{false}; }
    sink.truncate(?c.expr, 0);
    ret expression(c, r.location);
}

# the location list of a variable's ranges over the function's code `f`,
# its offset in the unit's location lists, none when DWARF states none of
# them
fun location_list(c: *Ctx, f: *Code, ranges: Run) res[opt[usize], Fail] {
    val err_begun: err[Fail] = lists_begun(c, ?c.locs_slot, ?c.locs);
    if (sel err_begun.err) { ret res[opt[usize], Fail].err{err_begun.err}; }
    val at:    Id[Added] = slot_id(c, c.locs_slot);
    val begun: usize     = sink.len(?c.locs);
    var count: u32       = 0;
    var i:     usize     = 0;
    for (i < ranges.count) {
        val r: *Range = table.at[Range](?c.d.ranges, table.nth[Range](ranges.first + i));
        i = i + 1;
        val res_from: res[Place, Fail] = within_code(c, f, r.start);
        if (sel res_from.err) { ret res[opt[usize], Fail].err{res_from.err}; }
        val res_within_code: res[Place, Fail] = within_code(c, f, r.end);
        if (sel res_within_code.err) { ret res[opt[usize], Fail].err{res_within_code.err}; }
        sink.truncate(?c.expr, 0);
        val res_stated: res[bool, Fail] = expression(c, r.location);
        if (sel res_stated.err) { ret res[opt[usize], Fail].err{res_stated.err}; }
        if (!res_stated.ok)     { cnt; }
        var err_u8: err[Fail] = err[Fail].ok{};
        if (f.fixed) {
            if (count == 0 && !f.based) {
                err_u8 = sink.u8(?c.locs, LLE_BASE_ADDRESS);
                err_u8 = fail.kept(err_u8, address_datum(c, ?c.locs, at, f.from));
            }
            err_u8 = fail.kept(err_u8, sink.u8(?c.locs, LLE_OFFSET_PAIR));
            err_u8 = fail.kept(err_u8, sink.uleb(?c.locs, res_from.ok.offset - f.start.offset));
            err_u8 = fail.kept(err_u8, sink.uleb(?c.locs, res_within_code.ok.offset - f.start.offset));
        }
        or {
            err_u8 = sink.u8(?c.locs, LLE_START_END);
            err_u8 = fail.kept(err_u8, mark_datum(c, ?c.locs, at, r.start));
            err_u8 = fail.kept(err_u8, mark_datum(c, ?c.locs, at, r.end));
        }
        err_u8 = fail.kept(err_u8, sink.uleb(?c.locs, sink.len(?c.expr)::u64));
        err_u8 = fail.kept(err_u8, sink.bytes(?c.locs, sink.data(?c.expr), sink.len(?c.expr)));
        if (sel err_u8.err) { ret res[opt[usize], Fail].err{err_u8.err}; }
        count = count + 1;
    }
    if (count == 0) { ret res[opt[usize], Fail].ok{opt[usize].none{}}; }
    val err_ended: err[Fail] = sink.u8(?c.locs, LLE_END);
    if (sel err_ended.err) { ret res[opt[usize], Fail].err{err_ended.err}; }
    ret res[opt[usize], Fail].ok{opt[usize].some{begun}};
}

# one range of the inlined range list being written over the function's code
# `f`: its offsets from the function's start over code of fixed size whose
# start is the unit's base, else its start and length over code of fixed
# size, and its start and end over code the linker may resize
fun range_entry(c: *Ctx, f: *Code, start: Id[Place], end: Id[Place]) err[Fail] {
    val res_from: res[Place, Fail] = within_code(c, f, start);
    if (sel res_from.err) { ret err[Fail].err{res_from.err}; }
    val res_to: res[Place, Fail] = within_code(c, f, end);
    if (sel res_to.err) { ret err[Fail].err{res_to.err}; }
    val a: Place = res_from.ok;
    val b: Place = res_to.ok;
    if (b.offset < a.offset) { ret err[Fail].err{fail.malformed("a range ends before it starts")}; }
    if (f.fixed && f.based) {
        var err_u8: err[Fail] = sink.u8(?c.rngs, RLE_OFFSET_PAIR);
        err_u8 = fail.kept(err_u8, sink.uleb(?c.rngs, a.offset - f.start.offset));
        ret fail.kept(err_u8, sink.uleb(?c.rngs, b.offset - f.start.offset));
    }
    val res_label_from: res[Id[Place], Fail] = label_of(c, start);
    if (sel res_label_from.err) { ret err[Fail].err{res_label_from.err}; }
    val res_label_to: res[Id[Place], Fail] = label_of(c, end);
    if (sel res_label_to.err) { ret err[Fail].err{res_label_to.err}; }
    ret range_at(c, a, res_label_from.ok, b, res_label_to.ok);
}

# a location as a DWARF expression in `c.expr`, answering false for one it
# cannot state
fun expression(c: *Ctx, l: Location) res[bool, Fail] {
    if (sel l.single) { ret single(c, l.single); }
    val pieces: Run = l.pieces;
    if (!within_table(pieces, table.count[debug.Piece](?c.d.pieces))) { ret res[bool, Fail].err{outside("pieces")}; }
    val s:   *Sink = ?c.expr;
    var any: bool  = false;
    var i:   usize = 0;
    for (i < pieces.count) {
        val p:           *debug.Piece = table.at[debug.Piece](?c.d.pieces, table.nth[debug.Piece](pieces.first + i));
        val opt_located: opt[Located] = p.located;
        if (sel opt_located.some) {
            val res_stated: res[bool, Fail] = single(c, opt_located.some);
            if (sel res_stated.err) { ret res_stated; }
            if (res_stated.ok)      { any = true; }
        }
        var err_u8: err[Fail] = err[Fail].ok{};
        if (p.bits % 8 == 0) {
            err_u8 = sink.u8(s, OP_PIECE);
            err_u8 = fail.kept(err_u8, sink.uleb(s, p.bits / 8));
        }
        or {
            err_u8 = sink.u8(s, OP_BIT_PIECE);
            err_u8 = fail.kept(err_u8, sink.uleb(s, p.bits));
            err_u8 = fail.kept(err_u8, sink.uleb(s, 0));
        }
        if (sel err_u8.err) { ret res[bool, Fail].err{err_u8.err}; }
        i = i + 1;
    }
    ret res[bool, Fail].ok{any};
}

# a register's operation: the short one below SHORT_REGISTERS, the long one
# with its number otherwise
fun register_op(s: *Sink, short: u8, long: u8, n: u32) err[Fail] {
    if (n < SHORT_REGISTERS) { ret sink.u8(s, short + n::u8); }
    val err_u8: err[Fail] = sink.u8(s, long);
    if (sel err_u8.err) { ret err_u8; }
    ret sink.uleb(s, n::u64);
}

# a location that is not pieces as a DWARF expression, the steps over what it
# holds, answering false for one DWARF does not state: a frame slot or a
# webassembly location with steps over it
fun single(c: *Ctx, l: Located) res[bool, Fail] {
    if (!within_table(l.steps, table.count[debug.Step](?c.d.steps))) { ret res[bool, Fail].err{outside("steps")}; }
    val s:               *Sink     = ?c.expr;
    val bare:            bool      = l.steps.count == 0;
    val at:              Where     = l.where;
    var err_register_op: err[Fail] = err[Fail].ok{};
    if (sel at.register) {
        if (bare) { err_register_op = register_op(s, OP_REG0, OP_REGX, at.register); }
        or {
            err_register_op = register_op(s, OP_BREG0, OP_BREGX, at.register);
            err_register_op = fail.kept(err_register_op, sink.sleb(s, 0));
            err_register_op = fail.kept(err_register_op, steps(c, l.steps));
            err_register_op = fail.kept(err_register_op, sink.u8(s, OP_STACK_VALUE));
        }
    }
    or (sel at.frame) {
        if (!bare) { ret res[bool, Fail].ok{false}; }
        err_register_op = sink.u8(s, OP_FBREG);
        err_register_op = fail.kept(err_register_op, sink.sleb(s, at.frame));
    }
    or (sel at.local) {
        if (!bare) { ret res[bool, Fail].ok{false}; }
        err_register_op = wasm_location(s, WASM_LOCAL, at.local);
    }
    or (sel at.operand) {
        if (!bare) { ret res[bool, Fail].ok{false}; }
        err_register_op = wasm_location(s, WASM_OPERAND, at.operand);
    }
    or (sel at.constant) {
        err_register_op = sink.u8(s, OP_CONSTU);
        err_register_op = fail.kept(err_register_op, sink.uleb(s, at.constant));
        err_register_op = fail.kept(err_register_op, steps(c, l.steps));
        err_register_op = fail.kept(err_register_op, sink.u8(s, OP_STACK_VALUE));
    }
    if (sel err_register_op.err) { ret res[bool, Fail].err{err_register_op.err}; }
    ret res[bool, Fail].ok{true};
}

# DW_OP_WASM_location of the index kind `kind` and the index `index`
fun wasm_location(s: *Sink, kind: u8, index: u32) err[Fail] {
    var err_u8: err[Fail] = sink.u8(s, OP_WASM_LOCATION);
    err_u8 = fail.kept(err_u8, sink.u8(s, kind));
    ret fail.kept(err_u8, sink.uleb(s, index::u64));
}

# the low `bits` bits of the value on the stack, nothing for a whole word
fun mask(s: *Sink, bits: u32) err[Fail] {
    if (bits >= 64) { ret err[Fail].ok{}; }
    var err_u8: err[Fail] = sink.u8(s, OP_CONSTU);
    err_u8 = fail.kept(err_u8, sink.uleb(s, ((1::u64) << bits::u64) - 1));
    ret fail.kept(err_u8, sink.u8(s, OP_AND));
}

# the steps of a run over the value on the stack, in order
fun steps(c: *Ctx, r: Run) err[Fail] {
    val s: *Sink = ?c.expr;
    var i: usize = 0;
    for (i < r.count) {
        val step:   debug.Step = @table.at[debug.Step](?c.d.steps, table.nth[debug.Step](r.first + i));
        var err_u8: err[Fail]  = err[Fail].ok{};
        if (sel step.plus) {
            err_u8 = sink.u8(s, OP_CONSTU);
            err_u8 = fail.kept(err_u8, sink.uleb(s, step.plus));
            err_u8 = fail.kept(err_u8, sink.u8(s, OP_PLUS));
        }
        or (sel step.minus) {
            err_u8 = sink.u8(s, OP_CONSTU);
            err_u8 = fail.kept(err_u8, sink.uleb(s, step.minus));
            err_u8 = fail.kept(err_u8, sink.u8(s, OP_MINUS));
        }
        or (sel step.extend_signed) {
            val from: u32 = step.extend_signed.from;
            if (from < 64) {
                val shift: u64 = (64 - from)::u64;
                err_u8 = sink.u8(s, OP_CONSTU);
                err_u8 = fail.kept(err_u8, sink.uleb(s, shift));
                err_u8 = fail.kept(err_u8, sink.u8(s, OP_SHL));
                err_u8 = fail.kept(err_u8, sink.u8(s, OP_CONSTU));
                err_u8 = fail.kept(err_u8, sink.uleb(s, shift));
                err_u8 = fail.kept(err_u8, sink.u8(s, OP_SHRA));
            }
            err_u8 = fail.kept(err_u8, mask(s, step.extend_signed.to));
        }
        or (sel step.extend_unsigned) { err_u8 = mask(s, step.extend_unsigned.from); }
        or (sel step.truncate)        { err_u8 = mask(s, step.truncate.to); }
        if (sel err_u8.err)           { ret err_u8; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}
