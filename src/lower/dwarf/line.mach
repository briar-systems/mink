# the object's line records as a DWARF 5 line table
#
# the file table becomes the header's directory and file tables and each line
# sequence one sequence of the line program, which starts with
# DW_LNE_set_address relocated against a label at its start. directory 0 is
# the producer's own directory, which the records leave unnamed, so it is
# written empty and a file stating no directory names it. file entry k is the
# object's file k, the first being the primary source file. an advance in a
# section the linker may resize is DW_LNS_fixed_advance_pc with a difference
# relocation between labels at its two places, through lower.difference. any
# other advance takes the shortest encoding: a special opcode when the address
# and line advances fit one, otherwise the standard opcodes. a row at its
# sequence's end is written there, and DW_LNE_end_sequence follows it with no
# advance. the table is 32-bit DWARF with a minimum instruction length of 1
# and, since no row states an operation index, one operation per instruction.
# a row's end column has no place in DWARF and is not written.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.kind;
use mink.lower.difference;
use mink.lower.difference.Resizing;
use mink.lower.lowered;
use mink.lower.lowered.Added;
use mink.lower.lowered.Aim;
use mink.lower.lowered.Fixup;
use mink.lower.lowered.Lowered;
use mink.lower.lowered.Mark;
use mink.model.line;
use mink.model.line.File;
use mink.model.line.FileKey;
use mink.model.line.Row;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Sequence;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.model.section;

use mink.reloc.row;
use mink.reloc.row.Lookup;
use mink.reloc.row.Pairing;

val VERSION: u16 = 5;

# address advances count bytes, one operation per instruction, and a row is a
# statement unless it says otherwise
val MIN_INSTRUCTION_LENGTH: u8 = 1;
val MAX_OPERATIONS:         u8 = 1;
val DEFAULT_IS_STMT:        u8 = 1;

val LINE_BASE:   i64 = -5;
val LINE_RANGE:  u64 = 14;
val OPCODE_BASE: u64 = 13;
# the operands each standard opcode takes, 1 through OPCODE_BASE - 1
val STANDARD_LENGTHS: [12]u8 = [12]u8{0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1};
# the largest address advance a special opcode holds with no line advance
val MAX_SPECIAL_ADVANCE: u64 = (255 - OPCODE_BASE) / LINE_RANGE;

val DW_LNS_COPY:               u8 = 0x01;
val DW_LNS_ADVANCE_PC:         u8 = 0x02;
val DW_LNS_ADVANCE_LINE:       u8 = 0x03;
val DW_LNS_SET_FILE:           u8 = 0x04;
val DW_LNS_SET_COLUMN:         u8 = 0x05;
val DW_LNS_NEGATE_STMT:        u8 = 0x06;
val DW_LNS_SET_BASIC_BLOCK:    u8 = 0x07;
val DW_LNS_CONST_ADD_PC:       u8 = 0x08;
val DW_LNS_FIXED_ADVANCE_PC:   u8 = 0x09;
val DW_LNS_SET_PROLOGUE_END:   u8 = 0x0a;
val DW_LNS_SET_EPILOGUE_BEGIN: u8 = 0x0b;
val DW_LNS_SET_ISA:            u8 = 0x0c;

val DW_LNE_END_SEQUENCE:      u8 = 0x01;
val DW_LNE_SET_ADDRESS:       u8 = 0x02;
val DW_LNE_SET_DISCRIMINATOR: u8 = 0x04;

val DW_LNCT_PATH:            u64 = 0x1;
val DW_LNCT_DIRECTORY_INDEX: u64 = 0x2;
val DW_LNCT_MD5:             u64 = 0x5;

val DW_FORM_STRING: u64 = 0x08;
val DW_FORM_UDATA:  u64 = 0x0f;
val DW_FORM_DATA16: u64 = 0x1e;

# DW_LNS_fixed_advance_pc takes a 16-bit operand, so a longer advance is
# written as several
pub val FIXED_ADVANCE_MAX: u64 = 0xffff;
# the widths, in bits, a fixed advance's difference may be written in
val FIXED_WIDTHS: [1]u32 = [1]u32{16};

# the most a 32-bit unit length counts
val UNIT_MAX: u64 = 0xffff_fff0;

# how a sequence advances its address
# ---
# number: by the distance, fixed once the object is written
# moving: by DW_LNS_fixed_advance_pc and a 16-bit difference between labels
#         the linker recomputes, the code being resizable
tag Advance: u8 {
    number;
    moving: *Pairing;
}

# the line state machine's registers the encoder tracks
rec State {
    address: u64;
    file:    u64;
    line:    u32;
    column:  u32;
    stmt:    bool;
    isa:     u32;
}

# o:        the object
# set:      the relocation set the target writes
# address:  the target address size in bytes
# out:      the record the table is added to
# section:  the id the table takes in `out`
# s:        the table's bytes
# resizing: which sections the linker may resize
# absolute: the kind DW_LNE_set_address is relocated with
# dirs:     per file, its index in the directory table
rec Ctx {
    o:        *Object;
    set:      *Lookup;
    address:  u8;
    out:      *Lowered;
    section:  Id[Added];
    s:        Sink;
    resizing: Resizing;
    absolute: *Kind;
    dirs:     Table[u64];
}

# encode the line records of `o` into `out` as the DWARF 5 line table `name`,
# for a target of `address`-byte addresses whose relocations `set` writes. an
# object with no line sequence adds nothing. a refusal adds nothing either:
# - malformed, naming the sequence and the row, for a row or sequence end past
#   its section's size, now that the size is final
# - unsupported for files of which only some state an MD5, which one file
#   table cannot hold, for an address size no absolute kind has, and for an
#   advance over code the linker may resize when `set` has no 16-bit
#   difference
# - malformed for a name holding a NUL byte
# - overflow for a table larger than a 32-bit unit length counts
pub fun encode(o: *Object, set: *Lookup, address: u8, name: str, out: *Lowered) err[Fail] {
    if (table.count[Sequence](?o.sequences) == 0) { ret err[Fail].ok{}; }
    val a:  *A.Allocator        = o.a;
    val rz: res[Resizing, Fail] = difference.resizing(a, o);
    if (sel rz.err) { ret err[Fail].err{rz.err}; }
    var c: Ctx = Ctx{
        o:        o,
        set:      set,
        address:  address,
        out:      out,
        section:  lowered.next_section(out),
        s:        sink.make(a, o.target.arch.order),
        resizing: rz.ok,
        dirs:     table.make[u64](a),
    };
    val m:  Mark      = lowered.mark(out);
    val r:  err[Fail] = table_out(?c);
    val r1: err[Fail] = difference.release(?c.resizing);
    val r2: err[Fail] = table.release[u64](?c.dirs);
    val e:  err[Fail] = fail.kept(fail.kept(r, r1), r2);
    if (sel e.err) {
        val dropped: err[Fail] = sink.release(?c.s);
        val back:    err[Fail] = lowered.rollback(out, m);
        ret e;
    }
    val added: res[Id[Added], Fail] = lowered.add_section(out, Added{name: name, kind: ?section.DEBUG_INFO, flags: section.DEBUG_INFO.flags, align: 1, disposition: ?section.ROOT, bytes: c.s});
    if (sel added.err) {
        val back: err[Fail] = lowered.rollback(out, m);
        ret err[Fail].err{added.err};
    }
    ret err[Fail].ok{};
}

fun table_out(c: *Ctx) err[Fail] {
    val k: res[*Kind, Fail] = reloc.absolute_of(c.address);
    if (sel k.err) { ret err[Fail].err{k.err}; }
    c.absolute = k.ok;
    val s: *Sink     = ?c.s;
    val w: err[Fail] = sink.u32(s, 0);
    if (sel w.err) { ret w; }
    val v: err[Fail] = sink.u16(s, VERSION);
    if (sel v.err) { ret v; }
    val sz: err[Fail] = sink.u8(s, c.address);
    if (sel sz.err) { ret sz; }
    val sg: err[Fail] = sink.u8(s, 0);
    if (sel sg.err) { ret sg; }
    val hl: err[Fail] = sink.u32(s, 0);
    if (sel hl.err) { ret hl; }
    val after_length: usize     = sink.len(s);
    val h:            err[Fail] = header_out(c);
    if (sel h.err) { ret h; }
    val hp: err[Fail] = patch_length(s, after_length - 4, sink.len(s) - after_length);
    if (sel hp.err) { ret hp; }
    var q: usize = 0;
    for (q < table.count[Sequence](?c.o.sequences)) {
        val r: err[Fail] = sequence_out(c, table.nth[Sequence](q));
        if (sel r.err) { ret err[Fail].err{fail.valued(fail.about(fail.in_indexed(r.err, "line sequence", q::u64), "line sequence"), q::i128)}; }
        q = q + 1;
    }
    ret patch_length(s, 0, sink.len(s) - 4);
}

# write the 32-bit length `n` at `at`
fun patch_length(s: *Sink, at: usize, n: usize) err[Fail] {
    if (n::u64 > UNIT_MAX) { ret err[Fail].err{fail.overflow("the line table is larger than a 32-bit unit length counts")}; }
    ret sink.patch(s, at, n::u64, 4);
}

fun header_out(c: *Ctx) err[Fail] {
    val s:     *Sink     = ?c.s;
    val fixed: [6]u8     = [6]u8{MIN_INSTRUCTION_LENGTH, MAX_OPERATIONS, DEFAULT_IS_STMT, (256 + LINE_BASE)::u8, LINE_RANGE::u8, OPCODE_BASE::u8};
    val wf:    err[Fail] = sink.bytes(s, ?fixed[0], 6);
    if (sel wf.err) { ret wf; }
    val wl: err[Fail] = sink.bytes(s, ?STANDARD_LENGTHS[0], 12);
    if (sel wl.err) { ret wl; }
    val d: err[Fail] = directories_out(c);
    if (sel d.err) { ret d; }
    ret files_out(c);
}

fun ulebs(s: *Sink, a: u64, b: u64) err[Fail] {
    val x: err[Fail] = sink.uleb(s, a);
    if (sel x.err) { ret x; }
    ret sink.uleb(s, b);
}

# the bytes of `id` and a NUL, refusing a name that holds one
fun string_out(c: *Ctx, id: Id[Name]) err[Fail] {
    val v: View  = object.name_of(c.o, id);
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == 0) { ret err[Fail].err{fail.malformed("a file or directory name holds a NUL byte")}; }
        i = i + 1;
    }
    val w: err[Fail] = sink.bytes(?c.s, v.data, v.len);
    if (sel w.err) { ret w; }
    ret sink.u8(?c.s, 0);
}

# the directory table: the producer's own directory, unnamed, then each
# directory a file states once, as the file index orders them, giving every
# file its directory's index
fun directories_out(c: *Ctx) err[Fail] {
    val s:  *Sink              = ?c.s;
    val n:  usize              = table.count[FileKey](?c.o.file_index);
    val gd: res[Id[u64], Fail] = table.grow[u64](?c.dirs, table.count[File](?c.o.files));
    if (sel gd.err) { ret err[Fail].err{gd.err}; }
    var count: u64   = 1;
    var i:     usize = 0;
    for (i < n) {
        val k: *FileKey = table.at[FileKey](?c.o.file_index, table.nth[FileKey](i));
        if (sel k.directory.some && (i == 0 || !same_directory(table.at[FileKey](?c.o.file_index, table.nth[FileKey](i - 1)), k))) { count = count + 1; }
        i = i + 1;
    }
    val fw: err[Fail] = sink.u8(s, 1);
    if (sel fw.err) { ret fw; }
    val ff: err[Fail] = ulebs(s, DW_LNCT_PATH, DW_FORM_STRING);
    if (sel ff.err) { ret ff; }
    val wc: err[Fail] = sink.uleb(s, count);
    if (sel wc.err) { ret wc; }
    val w0: err[Fail] = sink.u8(s, 0);
    if (sel w0.err) { ret w0; }
    var at: u64 = 0;
    i = 0;
    for (i < n) {
        val k: *FileKey = table.at[FileKey](?c.o.file_index, table.nth[FileKey](i));
        if (sel k.directory.some) {
            if (i == 0 || !same_directory(table.at[FileKey](?c.o.file_index, table.nth[FileKey](i - 1)), k)) {
                at = at + 1;
                val w: err[Fail] = string_out(c, k.directory.some);
                if (sel w.err) { ret err[Fail].err{fail.in_indexed(w.err, "file", k.file.index::u64)}; }
            }
            table.items[u64](?c.dirs)[k.file.index::usize] = at;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun same_directory(a: *FileKey, b: *FileKey) bool {
    if (sel a.directory.none) { ret sel b.directory.none; }
    if (sel b.directory.none) { ret false; }
    ret a.directory.some.index == b.directory.some.index;
}

# the file table, each file's name, directory index and, when every file
# states one, MD5
fun files_out(c: *Ctx) err[Fail] {
    val s:       *Sink = ?c.s;
    val n:       usize = table.count[File](?c.o.files);
    var digests: usize = 0;
    var i:       usize = 0;
    for (i < n) {
        val f: *File = object.file_at(c.o, table.nth[File](i));
        if (sel f.md5.some) { digests = digests + 1; }
        i = i + 1;
    }
    if (digests != 0 && digests != n) {
        ret err[Fail].err{fail.unsupported("only some files state an MD5, which one DWARF 5 file table cannot hold")};
    }
    var formats: u8 = 2;
    if (digests != 0) { formats = 3; }
    val wf: err[Fail] = sink.u8(s, formats);
    if (sel wf.err) { ret wf; }
    val fp: err[Fail] = ulebs(s, DW_LNCT_PATH, DW_FORM_STRING);
    if (sel fp.err) { ret fp; }
    val fd: err[Fail] = ulebs(s, DW_LNCT_DIRECTORY_INDEX, DW_FORM_UDATA);
    if (sel fd.err) { ret fd; }
    if (digests != 0) {
        val fm: err[Fail] = ulebs(s, DW_LNCT_MD5, DW_FORM_DATA16);
        if (sel fm.err) { ret fm; }
    }
    val wc: err[Fail] = sink.uleb(s, n::u64);
    if (sel wc.err) { ret wc; }
    i = 0;
    for (i < n) {
        val f: *File     = object.file_at(c.o, table.nth[File](i));
        val w: err[Fail] = string_out(c, f.name);
        if (sel w.err) { ret err[Fail].err{fail.in_indexed(w.err, "file", i::u64)}; }
        val d: err[Fail] = sink.uleb(s, table.items[u64](?c.dirs)[i]);
        if (sel d.err) { ret d; }
        if (sel f.md5.some) {
            val m: err[Fail] = sink.bytes(s, ?f.md5.some.bytes[0], 16);
            if (sel m.err) { ret m; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun row_fault(f: Fail, index: usize, at: u64) Fail {
    ret fail.at_offset(fail.in_indexed(f, "line row", index::u64), at);
}

fun sequence_out(c: *Ctx, id: Id[Sequence]) err[Fail] {
    val q:    *Sequence = object.sequence_at(c.o, id);
    val size: u64       = object.size_of(c.o, object.section_at(c.o, q.start.section));
    val n:    usize     = table.count[Row](?q.rows);
    var i:    usize     = 0;
    for (i < n) {
        val r: *Row = table.at[Row](?q.rows, table.nth[Row](i));
        if (r.at > size) { ret err[Fail].err{row_fault(fail.malformed("the row is past the end of its section"), i, r.at)}; }
        i = i + 1;
    }
    if (q.end > size) { ret err[Fail].err{fail.at_offset(fail.malformed("the line sequence ends past the end of its section"), q.end)}; }
    val how: res[Advance, Fail] = advance_of(c, q);
    if (sel how.err) { ret err[Fail].err{how.err}; }
    val by:    Advance              = how.ok;
    val start: res[Id[Place], Fail] = lowered.label(c.out, q.start);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    val sa: err[Fail] = set_address(c, start.ok);
    if (sel sa.err) { ret sa; }
    var st:   State     = State{address: q.start.offset, file: 1, line: 1, stmt: DEFAULT_IS_STMT != 0};
    var last: Id[Place] = start.ok;
    i = 0;
    for (i < n) {
        val r: *Row      = table.at[Row](?q.rows, table.nth[Row](i));
        val e: err[Fail] = row_out(c, q, ?st, ?last, ?by, r);
        if (sel e.err) { ret err[Fail].err{row_fault(e.err, i, r.at)}; }
        i = i + 1;
    }
    val at:    Location       = Location{record: "line sequence", offset: q.end, placed: true};
    val delta: res[u64, Fail] = checked.sub(at, q.end, st.address);
    if (sel delta.err) { ret err[Fail].err{delta.err}; }
    if (sel by.moving) {
        if (delta.ok != 0) {
            val end: res[Id[Place], Fail] = lowered.label(c.out, Place{section: q.start.section, offset: q.end});
            if (sel end.err) { ret err[Fail].err{end.err}; }
            val f: err[Fail] = moving_advance(c, q, by.moving, last, st.address, end.ok, q.end);
            if (sel f.err) { ret f; }
        }
    }
    or (delta.ok == MAX_SPECIAL_ADVANCE) {
        val w: err[Fail] = sink.u8(?c.s, DW_LNS_CONST_ADD_PC);
        if (sel w.err) { ret w; }
    }
    or (delta.ok != 0) {
        val w: err[Fail] = sink.u8(?c.s, DW_LNS_ADVANCE_PC);
        if (sel w.err) { ret w; }
        val u: err[Fail] = sink.uleb(?c.s, delta.ok);
        if (sel u.err) { ret u; }
    }
    ret extended(c, DW_LNE_END_SEQUENCE, 0);
}

# the extended opcode `op` with an operand of `size` bytes to follow
fun extended(c: *Ctx, op: u8, size: u64) err[Fail] {
    val w: err[Fail] = sink.u8(?c.s, 0);
    if (sel w.err) { ret w; }
    val l: err[Fail] = sink.uleb(?c.s, size + 1);
    if (sel l.err) { ret l; }
    ret sink.u8(?c.s, op);
}

fun set_address(c: *Ctx, start: Id[Place]) err[Fail] {
    val e: err[Fail] = extended(c, DW_LNE_SET_ADDRESS, c.address::u64);
    if (sel e.err) { ret e; }
    val f: res[Id[Fixup], Fail] = lowered.add_fixup(c.out, Fixup{section: c.section, offset: sink.len(?c.s)::u64, kind: c.absolute, target: Aim.label{start}});
    if (sel f.err) { ret err[Fail].err{f.err}; }
    ret sink.zeros(?c.s, c.address::usize);
}

# the bytes of `v` as a ULEB128
fun uleb_size(v: u64) u64 {
    var n: u64 = 1;
    var x: u64 = v >> 7;
    for (x != 0) {
        n = n + 1;
        x = x >> 7;
    }
    ret n;
}

# append the row `r`
fun row_out(c: *Ctx, q: *Sequence, st: *State, last: *Id[Place], by: *Advance, r: *Row) err[Fail] {
    val s: *Sink = ?c.s;
    if (r.file.index::u64 != st.file) {
        val w: err[Fail] = sink.u8(s, DW_LNS_SET_FILE);
        if (sel w.err) { ret w; }
        val u: err[Fail] = sink.uleb(s, r.file.index::u64);
        if (sel u.err) { ret u; }
        st.file = r.file.index::u64;
    }
    if (r.column != st.column) {
        val w: err[Fail] = sink.u8(s, DW_LNS_SET_COLUMN);
        if (sel w.err) { ret w; }
        val u: err[Fail] = sink.uleb(s, r.column::u64);
        if (sel u.err) { ret u; }
        st.column = r.column;
    }
    if (r.isa != st.isa) {
        val w: err[Fail] = sink.u8(s, DW_LNS_SET_ISA);
        if (sel w.err) { ret w; }
        val u: err[Fail] = sink.uleb(s, r.isa::u64);
        if (sel u.err) { ret u; }
        st.isa = r.isa;
    }
    if (r.discriminator != 0) {
        val e: err[Fail] = extended(c, DW_LNE_SET_DISCRIMINATOR, uleb_size(r.discriminator::u64));
        if (sel e.err) { ret e; }
        val u: err[Fail] = sink.uleb(s, r.discriminator::u64);
        if (sel u.err) { ret u; }
    }
    val stmt: bool = (r.flags & line.STATEMENT) != 0;
    if (stmt != st.stmt) {
        val w: err[Fail] = sink.u8(s, DW_LNS_NEGATE_STMT);
        if (sel w.err) { ret w; }
        st.stmt = stmt;
    }
    val marks: [3]line.Flags = [3]line.Flags{line.BLOCK, line.PROLOGUE_END, line.EPILOGUE_BEGIN};
    val ops:   [3]u8         = [3]u8{DW_LNS_SET_BASIC_BLOCK, DW_LNS_SET_PROLOGUE_END, DW_LNS_SET_EPILOGUE_BEGIN};
    var k:     usize         = 0;
    for (k < 3) {
        if ((r.flags & marks[k]) != 0) {
            val w: err[Fail] = sink.u8(s, ops[k]);
            if (sel w.err) { ret w; }
        }
        k = k + 1;
    }
    val at:    Location       = Location{record: "line row", offset: r.at, placed: true};
    val delta: res[u64, Fail] = checked.sub(at, r.at, st.address);
    if (sel delta.err) { ret err[Fail].err{delta.err}; }
    val lines: i64 = r.line::i64 - st.line::i64;
    st.line = r.line;
    if (sel by.number) {
        st.address = r.at;
        ret advance(s, lines, delta.ok);
    }
    val m: *Pairing = by.moving;
    if (delta.ok != 0) {
        val here: res[Id[Place], Fail] = lowered.label(c.out, Place{section: q.start.section, offset: r.at});
        if (sel here.err) { ret err[Fail].err{here.err}; }
        val f: err[Fail] = moving_advance(c, q, m, @last, st.address, here.ok, r.at);
        if (sel f.err) { ret f; }
        @last = here.ok;
    }
    st.address = r.at;
    ret advance(s, lines, 0);
}

# advance from the label `from` at offset `low` to the label `to` at offset
# `high` of the sequence's section, code the linker may resize, as advances
# each a difference no wider than its 16-bit operand
fun moving_advance(c: *Ctx, q: *Sequence, m: *Pairing, from: Id[Place], low: u64, to: Id[Place], high: u64) err[Fail] {
    var at:   u64       = low;
    var mark: Id[Place] = from;
    for (high - at > FIXED_ADVANCE_MAX) {
        at = at + FIXED_ADVANCE_MAX;
        val mid: res[Id[Place], Fail] = lowered.label(c.out, Place{section: q.start.section, offset: at});
        if (sel mid.err) { ret err[Fail].err{mid.err}; }
        val w: err[Fail] = fixed_out(c, m, mid.ok, mark);
        if (sel w.err) { ret w; }
        mark = mid.ok;
    }
    ret fixed_out(c, m, to, mark);
}

# how the sequence `q` advances: over code the linker may resize by 16-bit
# differences, refused when the set has none, and by numbers otherwise
fun advance_of(c: *Ctx, q: *Sequence) res[Advance, Fail] {
    if (!difference.resizes(?c.resizing, q.start.section)) { ret res[Advance, Fail].ok{Advance.number{}}; }
    val p: opt[*Pairing] = difference.pick(c.set, ?FIXED_WIDTHS[0], 1, FIXED_ADVANCE_MAX);
    if (sel p.none) {
        ret res[Advance, Fail].err{fail.unsupported("the relocation set has no 16-bit difference, so no line table can advance over code the linker may resize")};
    }
    val found: *Pairing = p.some;
    ret res[Advance, Fail].ok{Advance.moving{found}};
}

fun fixed_out(c: *Ctx, p: *Pairing, to: Id[Place], from: Id[Place]) err[Fail] {
    val w: err[Fail] = sink.u8(?c.s, DW_LNS_FIXED_ADVANCE_PC);
    if (sel w.err) { ret w; }
    val r: err[Fail] = difference.record(c.out, c.section, sink.len(?c.s)::u64, p, Aim.label{to}, Aim.label{from});
    if (sel r.err) { ret r; }
    ret sink.zeros(?c.s, row.container(p.plus)::usize);
}

# append a row `lines` lines and `bytes` bytes past the last one, in the
# shortest encoding: a special opcode when both advances fit one, the line
# advance by DW_LNS_advance_line when it does not, and the address advance by
# DW_LNS_const_add_pc and a special opcode or else by DW_LNS_advance_pc
pub fun advance(s: *Sink, lines: i64, bytes: u64) err[Fail] {
    var line:   i64  = lines;
    var copy:   bool = false;
    var biased: i64  = line - LINE_BASE;
    if (biased >= LINE_RANGE::i64 || biased < 0) {
        val w: err[Fail] = sink.u8(s, DW_LNS_ADVANCE_LINE);
        if (sel w.err) { ret w; }
        val v: err[Fail] = sink.sleb(s, line);
        if (sel v.err) { ret v; }
        line   = 0;
        biased = 0 - LINE_BASE;
        copy   = true;
    }
    if (line == 0 && bytes == 0) { ret sink.u8(s, DW_LNS_COPY); }
    val base: u64 = biased::u64 + OPCODE_BASE;
    if (bytes < 256 + MAX_SPECIAL_ADVANCE) {
        val op: u64 = base + bytes * LINE_RANGE;
        if (op <= 255) { ret sink.u8(s, op::u8); }
        if (bytes >= MAX_SPECIAL_ADVANCE) {
            val again: u64 = base + (bytes - MAX_SPECIAL_ADVANCE) * LINE_RANGE;
            if (again <= 255) {
                val w: err[Fail] = sink.u8(s, DW_LNS_CONST_ADD_PC);
                if (sel w.err) { ret w; }
                ret sink.u8(s, again::u8);
            }
        }
    }
    val w: err[Fail] = sink.u8(s, DW_LNS_ADVANCE_PC);
    if (sel w.err) { ret w; }
    val u: err[Fail] = sink.uleb(s, bytes);
    if (sel u.err) { ret u; }
    if (copy)      { ret sink.u8(s, DW_LNS_COPY); }
    ret sink.u8(s, base::u8);
}
