# line records as DWARF 5 line tables
#
# a table lists some of the object's files as its header's directory and file
# tables, the first both its file 0 and its file 1, and holds some of its line
# sequences, each one sequence of the line program, which starts with
# DW_LNE_set_address relocated against a label at its start. every sequence
# starts in file 1 (DWARF 5, table 6.4), and readers such as binutils name
# file 1 at every sequence's start whatever the program sets after, so a table
# of one file still lists it twice, as every DWARF 5 producer does. a unit of
# debugging information writes a table of its own, listing the files it names
# and holding the sequences of its section, and an object whose records state
# no unit one table of every file and sequence. every name a table states is a
# DW_FORM_line_strp into the object's line strings, each name held once.
# directory 0 is the producer's own directory, which DW_AT_comp_dir names too:
# the unit's directory where the object states a unit, and empty otherwise,
# since the records then name none. a file stating no directory names it.
# an advance in a section the linker may resize is DW_LNS_fixed_advance_pc
# with a difference relocation between labels at its two places, through
# lower.difference. any other advance takes the shortest encoding: a special
# opcode when the address and line advances fit one, otherwise the standard
# opcodes. a row at its sequence's end is written there, and
# DW_LNE_end_sequence follows it with no advance. the table is 32-bit DWARF
# with a minimum instruction length of 1 and, since no row states an
# operation index, one operation per instruction. a row's end column has no
# place in DWARF and is not written.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.intern;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.base.vectors;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.kind;
use mink.lower.DwarfLine;
use mink.lower.difference;
use mink.lower.difference.Resizing;
use mink.lower.lowered;
use mink.lower.lowered.Added;
use mink.lower.lowered.Aim;
use mink.lower.lowered.Fixup;
use mink.lower.lowered.Lowered;
use mink.lower.lowered.Mark;
use mink.model.debug;
use mink.model.line;
use mink.model.line.File;
use mink.model.line.Row;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Sequence;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.model.section;

use mink.reloc.row;
use mink.reloc.row.Lookup;
use mink.reloc.row.Pairing;

val VERSION: u16 = 5;

# address advances count bytes, one operation per instruction, and a row is a
# statement unless it says otherwise
val MIN_INSTRUCTION_LENGTH: u8 = 1;
val MAX_OPERATIONS:         u8 = 1;
val DEFAULT_IS_STMT:        u8 = 1;

val LINE_BASE:   i64 = -5;
val LINE_RANGE:  u64 = 14;
val OPCODE_BASE: u64 = 13;
# the operands each standard opcode takes, 1 through OPCODE_BASE - 1
val STANDARD_LENGTHS: [12]u8 = [12]u8{0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1};
# the largest address advance a special opcode holds with no line advance
val MAX_SPECIAL_ADVANCE: u64 = (255 - OPCODE_BASE) / LINE_RANGE;

pub val DW_LNS_COPY:               u8 = 0x01;
pub val DW_LNS_ADVANCE_PC:         u8 = 0x02;
pub val DW_LNS_ADVANCE_LINE:       u8 = 0x03;
pub val DW_LNS_SET_FILE:           u8 = 0x04;
pub val DW_LNS_SET_COLUMN:         u8 = 0x05;
pub val DW_LNS_NEGATE_STMT:        u8 = 0x06;
pub val DW_LNS_SET_BASIC_BLOCK:    u8 = 0x07;
pub val DW_LNS_CONST_ADD_PC:       u8 = 0x08;
pub val DW_LNS_FIXED_ADVANCE_PC:   u8 = 0x09;
pub val DW_LNS_SET_PROLOGUE_END:   u8 = 0x0a;
pub val DW_LNS_SET_EPILOGUE_BEGIN: u8 = 0x0b;
pub val DW_LNS_SET_ISA:            u8 = 0x0c;

pub val DW_LNE_END_SEQUENCE:      u8 = 0x01;
pub val DW_LNE_SET_ADDRESS:       u8 = 0x02;
pub val DW_LNE_SET_DISCRIMINATOR: u8 = 0x04;

pub val DW_LNCT_PATH:            u64 = 0x1;
pub val DW_LNCT_DIRECTORY_INDEX: u64 = 0x2;
pub val DW_LNCT_MD5:             u64 = 0x5;

pub val DW_FORM_STRING:    u64 = 0x08;
pub val DW_FORM_UDATA:     u64 = 0x0f;
pub val DW_FORM_DATA16:    u64 = 0x1e;
pub val DW_FORM_LINE_STRP: u64 = 0x1f;

# DW_LNS_fixed_advance_pc takes a 16-bit operand, so a longer advance is
# written as several
pub val FIXED_ADVANCE_MAX: u64 = 0xffff;
# the widths, in bits, a fixed advance's difference may be written in
val FIXED_WIDTHS: [1]u32 = [1]u32{16};

# the most a 32-bit unit length counts
val UNIT_MAX: u64 = 0xffff_fff0;

# how a sequence advances its address
# ---
# number: by the distance, fixed once the object is written
# moving: by DW_LNS_fixed_advance_pc and a 16-bit difference between labels
#         the linker recomputes, the code being resizable
tag Advance: u8 {
    number;
    moving: Pairing;
}

# the line state machine's registers the encoder tracks
rec State {
    address: u64;
    file:    u64;
    line:    u32;
    column:  u32;
    stmt:    bool;
    isa:     u32;
}

# the strings the line tables and the units of an object name, each once in
# its line string section, which offset 0 holds the empty string at
# ---
# s:     the section's bytes
# at:    per name, its offset plus one, zero for one not held yet
# added: the id the section takes in the lowered record
pub rec Strings {
    s:     Sink;
    at:    Vector[u32];
    added: Id[Added];
}

# the strings of `o`, whose section takes the id `added`
pub fun strings_init(o: *Object, added: Id[Added]) res[Strings, Fail] {
    var st:     Strings   = Strings{s: sink.init(o.a, o.target.arch.order), at: vector.init[u32](o.a), added: added};
    val err_u8: err[Fail] = sink.u8(?st.s, 0);
    if (sel err_u8.err) {
        val err_dropped: err[Fail] = strings_dnit(?st);
        ret res[Strings, Fail].err{err_u8.err};
    }
    ret res[Strings, Fail].ok{st};
}

# give back what the strings hold
pub fun strings_dnit(st: *Strings) err[Fail] {
    ret fail.kept(sink.dnit(?st.s), vectors.dnit[u32](?st.at));
}

# the offset of the name `n` in the strings, added the first time it is
# named, refused for a name that holds a NUL byte
pub fun string_at(st: *Strings, o: *Object, n: Id[Name]) res[u32, Fail] {
    val count: usize = intern.count(?o.names);
    if (n.index::usize >= count) { ret res[u32, Fail].err{fail.in_indexed(fail.malformed("a record names a name the object does not hold"), "name", n.index::u64)}; }
    if (vector.length[u32](?st.at) < count) {
        val err_grow: err[Fail] = vectors.grow[u32](?st.at, count - vector.length[u32](?st.at));
        if (sel err_grow.err) { ret res[u32, Fail].err{err_grow.err}; }
    }
    val known: u32 = st.at.data[n.index::usize];
    if (known != 0) { ret res[u32, Fail].ok{known - 1}; }
    val v: View  = object.name_of(o, n);
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == 0) { ret res[u32, Fail].err{fail.malformed("a file or directory name holds a NUL byte")}; }
        i = i + 1;
    }
    val at: usize = sink.len(?st.s);
    if (at::u64 > UNIT_MAX) { ret res[u32, Fail].err{fail.overflow("the line strings are larger than a 32-bit offset reaches")}; }
    var err_bytes: err[Fail] = sink.bytes(?st.s, v.data, v.len);
    err_bytes = fail.kept(err_bytes, sink.u8(?st.s, 0));
    if (sel err_bytes.err) { ret res[u32, Fail].err{err_bytes.err}; }
    st.at.data[n.index::usize] = at::u32 + 1;
    ret res[u32, Fail].ok{at::u32};
}

# the files one line table lists
# ---
# list:  the object's files it lists, in its order, the one at place i its
#        file i + 1 and the first its file 0 as well
# index: per object file, the file the table names it as, its place in the
#        list plus one, zero for one it does not list
pub rec Files {
    list:  Vector[u32];
    index: Vector[u32];
}

# no files, for a table of `o`
pub fun files_init(o: *Object) res[Files, Fail] {
    var f:        Files     = Files{list: vector.init[u32](o.a), index: vector.init[u32](o.a)};
    val err_grow: err[Fail] = vectors.grow[u32](?f.index, table.count[File](?o.files));
    if (sel err_grow.err) {
        val err_dropped: err[Fail] = files_dnit(?f);
        ret res[Files, Fail].err{err_grow.err};
    }
    ret res[Files, Fail].ok{f};
}

# give back what the files hold
pub fun files_dnit(f: *Files) err[Fail] {
    ret fail.kept(vectors.dnit[u32](?f.list), vectors.dnit[u32](?f.index));
}

# list no file again
pub fun files_clear(f: *Files) {
    var i: usize = 0;
    for (i < vector.length[u32](?f.list)) {
        f.index.data[f.list.data[i]::usize] = 0;
        i                                   = i + 1;
    }
    vector.truncate[u32](?f.list, 0);
}

# list the object's file `file` when the table lists it not yet, refused
# for a file past the object's table
pub fun files_add(f: *Files, file: Id[File]) err[Fail] {
    if (file.index::usize >= vector.length[u32](?f.index)) { ret err[Fail].err{fail.in_indexed(fail.malformed("a record names a file the object does not hold"), "file", file.index::u64)}; }
    if (f.index.data[file.index::usize] != 0)              { ret err[Fail].ok{}; }
    val err_pushed: err[Fail] = vectors.push[u32](?f.list, file.index);
    if (sel err_pushed.err) { ret err_pushed; }
    f.index.data[file.index::usize] = vector.length[u32](?f.list)::u32;
    ret err[Fail].ok{};
}

# list every file of the object, each its own index
pub fun files_all(f: *Files, o: *Object) err[Fail] {
    files_clear(f);
    var i: usize = 0;
    for (i < table.count[File](?o.files)) {
        val err_add: err[Fail] = files_add(f, table.nth[File](i));
        if (sel err_add.err) { ret err_add; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the file the table of `f` names the object's file `file` as, file 1 rather
# than file 0 for its first, the file every sequence starts in
pub fun file_index(f: *Files, file: Id[File]) res[u64, Fail] {
    if (file.index::usize >= vector.length[u32](?f.index)) { ret res[u64, Fail].err{fail.in_indexed(fail.malformed("a record names a file the object does not hold"), "file", file.index::u64)}; }
    val at: u32 = f.index.data[file.index::usize];
    if (at == 0) { ret res[u64, Fail].err{fail.in_indexed(fail.internal("a record names a file its line table does not list"), "file", file.index::u64)}; }
    ret res[u64, Fail].ok{at::u64};
}

# the file the table of every file, as files_all lists them, names the
# object's file `file` as
pub fun whole_index(file: Id[File]) u64 {
    ret file.index::u64 + 1;
}

# what every line table of one object shares
# ---
# o:        the object
# set:      the relocation set the target writes
# address:  the target address size in bytes
# out:      the record the tables are added to
# resizing: which sections the linker may resize
# absolute: the kind DW_LNE_set_address is relocated with
# strings:  where the tables' names are held
pub rec Writer {
    o:        *Object;
    set:      *Lookup;
    address:  u8;
    out:      *Lowered;
    resizing: *Resizing;
    absolute: *Kind;
    strings:  *Strings;
}

# one table being written
# ---
# w:       what the object's tables share
# s:       the table's bytes
# section: the id the table's section takes in the lowered record
# dirs:    the directories the table lists after directory 0, by name
rec Ctx {
    w:       *Writer;
    s:       *Sink;
    section: Id[Added];
    dirs:    Vector[u32];
}

# encode the line records of `o` into `out` as one DWARF 5 line table in the
# section `form` names, its names in the section of line strings `form`
# names, both kept whatever a link drops, for a target of `address`-byte
# addresses whose relocations `set` writes: the table of an object whose
# records state no units, a relocation naming the line table being pointed at
# it. an object with no line sequence adds nothing. a refusal adds nothing
# either:
# - malformed, naming the sequence and the row, for a row or sequence end past
#   its section's size, now that the size is final
# - unsupported for files of which only some state an MD5, which one file
#   table cannot hold, for an address size no absolute kind has, and for an
#   advance over code the linker may resize when `set` has no 16-bit
#   difference
# - malformed for a name holding a NUL byte
# - overflow for a table larger than a 32-bit unit length counts
pub fun encode(o: *Object, set: *Lookup, address: u8, form: *DwarfLine, out: *Lowered) err[Fail] {
    if (table.count[Sequence](?o.sequences) == 0) { ret err[Fail].ok{}; }
    val res_resizing: res[Resizing, Fail] = difference.resizing(o.a, o);
    if (sel res_resizing.err) { ret err[Fail].err{res_resizing.err}; }
    var resizing:    Resizing           = res_resizing.ok;
    val m:           Mark               = lowered.mark(out);
    val at:          Id[Added]          = lowered.next_section(out);
    val res_strings: res[Strings, Fail] = strings_init(o, Id[Added]{index: at.index + 1});
    if (sel res_strings.err) {
        val err_dropped: err[Fail] = difference.dnit(?resizing);
        ret err[Fail].err{res_strings.err};
    }
    var strings:   Strings   = res_strings.ok;
    var s:         Sink      = sink.init(o.a, o.target.arch.order);
    val err_whole: err[Fail] = whole(o, set, address, out, ?resizing, ?strings, ?s, at);
    val err_kept:  err[Fail] = fail.kept(err_whole, difference.dnit(?resizing));
    if (sel err_kept.err) {
        val err_dropped: err[Fail] = fail.kept(sink.dnit(?s), strings_dnit(?strings));
        lowered.truncate(out, m);
        ret err_kept;
    }
    val res_added: res[Id[Added], Fail] = lowered.add_section(out, Added{name: form.section, kind: ?section.DEBUG_INFO, flags: section.DEBUG_INFO.flags, align: 1, disposition: ?section.ROOT, bytes: s});
    if (sel res_added.err) {
        val err_dropped: err[Fail] = strings_dnit(?strings);
        lowered.truncate(out, m);
        ret err[Fail].err{res_added.err};
    }
    val err_strings_released: err[Fail]            = vectors.dnit[u32](?strings.at);
    val res_strings_added:    res[Id[Added], Fail] = lowered.add_section(out, Added{name: form.strings, kind: ?section.DEBUG_INFO, flags: section.DEBUG_INFO.flags, align: 1, disposition: ?section.WHOLE, bytes: strings.s});
    if (sel res_strings_added.err) {
        lowered.truncate(out, m);
        ret err[Fail].err{res_strings_added.err};
    }
    if (res_strings_added.ok.index != strings.added.index) {
        lowered.truncate(out, m);
        ret err[Fail].err{fail.internal("the line strings take another id than their fixups name")};
    }
    out.lines = opt[Id[Added]].some{res_added.ok};
    ret err_strings_released;
}

# the one table of every sequence of `o` and every file it holds, in `s`
fun whole(o: *Object, set: *Lookup, address: u8, out: *Lowered, resizing: *Resizing, strings: *Strings, s: *Sink, at: Id[Added]) err[Fail] {
    val res_writer: res[Writer, Fail] = writer(o, set, address, out, resizing, strings);
    if (sel res_writer.err) { ret err[Fail].err{res_writer.err}; }
    var w:         Writer           = res_writer.ok;
    val res_files: res[Files, Fail] = files_init(o);
    if (sel res_files.err) { ret err[Fail].err{res_files.err}; }
    var files:   Files       = res_files.ok;
    var seqs:    Vector[u32] = vector.init[u32](o.a);
    var err_all: err[Fail]   = files_all(?files, o);
    var q:       usize       = 0;
    for (q < table.count[Sequence](?o.sequences)) {
        err_all = fail.kept(err_all, vectors.push[u32](?seqs, q::u32));
        q       = q + 1;
    }
    var err_table: err[Fail] = err_all;
    if (sel err_all.ok) { err_table = table_of(?w, ?files, ?seqs, s, at); }
    err_table = fail.kept(err_table, files_dnit(?files));
    ret fail.kept(err_table, vectors.dnit[u32](?seqs));
}

# what the tables of `o` share, their names held in `strings`
pub fun writer(o: *Object, set: *Lookup, address: u8, out: *Lowered, resizing: *Resizing, strings: *Strings) res[Writer, Fail] {
    val res_absolute_of: res[*Kind, Fail] = reloc.absolute_of(address);
    if (sel res_absolute_of.err) { ret res[Writer, Fail].err{res_absolute_of.err}; }
    ret res[Writer, Fail].ok{Writer{o: o, set: set, address: address, out: out, resizing: resizing, absolute: res_absolute_of.ok, strings: strings}};
}

# the table listing the files `f` lists and holding the sequences `seqs`, in
# that order, appended to `s`, whose section takes the id `section` and whose
# table starts there. a table of no sequence is a header alone
pub fun table_of(w: *Writer, f: *Files, seqs: *Vector[u32], s: *Sink, section: Id[Added]) err[Fail] {
    var c:        Ctx       = Ctx{w: w, s: s, section: section, dirs: vector.init[u32](w.o.a)};
    val err_kept: err[Fail] = fail.kept(table_out(?c, f, seqs), vectors.dnit[u32](?c.dirs));
    ret err_kept;
}

# the table in `c.s`: the unit header, the line program header and each
# sequence, with both lengths patched in after
fun table_out(c: *Ctx, f: *Files, seqs: *Vector[u32]) err[Fail] {
    val s:       *Sink     = c.s;
    val begun:   usize     = sink.len(s);
    var err_u32: err[Fail] = sink.u32(s, 0);
    err_u32 = fail.kept(err_u32, sink.u16(s, VERSION));
    err_u32 = fail.kept(err_u32, sink.u8(s, c.w.address));
    err_u32 = fail.kept(err_u32, sink.u8(s, 0));
    err_u32 = fail.kept(err_u32, sink.u32(s, 0));
    if (sel err_u32.err) { ret err_u32; }
    val after_length:   usize     = sink.len(s);
    val err_header_out: err[Fail] = header_out(c, f);
    if (sel err_header_out.err) { ret err_header_out; }
    val err_patch_length: err[Fail] = patch_length(s, after_length - 4, sink.len(s) - after_length);
    if (sel err_patch_length.err) { ret err_patch_length; }
    var q: usize = 0;
    for (q < vector.length[u32](seqs)) {
        val k:                usize     = seqs.data[q]::usize;
        val err_sequence_out: err[Fail] = sequence_out(c, f, table.nth[Sequence](k));
        if (sel err_sequence_out.err) { ret err[Fail].err{fail.valued(fail.about(fail.in_indexed(err_sequence_out.err, "line sequence", k::u64), "line sequence"), k::i128)}; }
        q = q + 1;
    }
    ret patch_length(s, begun, sink.len(s) - begun - 4);
}

# write the 32-bit length `n` at `at`
fun patch_length(s: *Sink, at: usize, n: usize) err[Fail] {
    if (n::u64 > UNIT_MAX) { ret err[Fail].err{fail.overflow("the line table is larger than a 32-bit unit length counts")}; }
    ret sink.patch(s, at, n::u64, 4);
}

# the line program header after its length: the fixed fields, the standard
# opcode lengths, and the directory and file tables
fun header_out(c: *Ctx, f: *Files) err[Fail] {
    val s:         *Sink     = c.s;
    val fixed:     [6]u8     = [6]u8{MIN_INSTRUCTION_LENGTH, MAX_OPERATIONS, DEFAULT_IS_STMT, (256 + LINE_BASE)::u8, LINE_RANGE::u8, OPCODE_BASE::u8};
    val err_bytes: err[Fail] = sink.bytes(s, ?fixed[0], 6);
    if (sel err_bytes.err) { ret err_bytes; }
    val err_bytes_standard_lengths: err[Fail] = sink.bytes(s, ?STANDARD_LENGTHS[0], 12);
    if (sel err_bytes_standard_lengths.err) { ret err_bytes_standard_lengths; }
    val err_directories_out: err[Fail] = directories_out(c, f);
    if (sel err_directories_out.err) { ret err_directories_out; }
    ret files_out(c, f);
}

fun ulebs(s: *Sink, a: u64, b: u64) err[Fail] {
    val err_uleb: err[Fail] = sink.uleb(s, a);
    if (sel err_uleb.err) { ret err_uleb; }
    ret sink.uleb(s, b);
}

# a DW_FORM_line_strp of the string at `at` of the strings
fun strp_at(c: *Ctx, at: u32) err[Fail] {
    val res_add_fixup: res[Id[Fixup], Fail] = lowered.add_fixup(c.w.out, Fixup{section: c.section, offset: sink.len(c.s)::u64, kind: ?reloc.SECREL32, target: Aim.added{c.w.strings.added}, addend: at::i64});
    if (sel res_add_fixup.err) { ret err[Fail].err{res_add_fixup.err}; }
    ret sink.zeros(c.s, 4);
}

# a DW_FORM_line_strp of the name `id`
fun strp(c: *Ctx, id: Id[Name]) err[Fail] {
    val res_string_at: res[u32, Fail] = string_at(c.w.strings, c.w.o, id);
    if (sel res_string_at.err) { ret err[Fail].err{res_string_at.err}; }
    ret strp_at(c, res_string_at.ok);
}

# the index the table gives the directory of the object's file `file`: 0 for
# a file that states none, the producer's own directory, else its place
# among the directories the table lists
fun directory_of(c: *Ctx, file: u32) u64 {
    val opt_directory: opt[Id[Name]] = object.file_at(c.w.o, table.nth[File](file::usize)).directory;
    if (sel opt_directory.none) { ret 0; }
    var i: usize = 0;
    for (i < vector.length[u32](?c.dirs)) {
        if (c.dirs.data[i] == opt_directory.some.index) { ret (i + 1)::u64; }
        i = i + 1;
    }
    ret 0;
}

# the directory table: the producer's own directory, then each directory a
# listed file states, once, in the order the files list them
fun directories_out(c: *Ctx, f: *Files) err[Fail] {
    val s: *Sink = c.s;
    var i: usize = 0;
    for (i < vector.length[u32](?f.list)) {
        val opt_directory: opt[Id[Name]] = object.file_at(c.w.o, table.nth[File](f.list.data[i]::usize)).directory;
        i = i + 1;
        if (sel opt_directory.none) { cnt; }
        var seen: bool  = false;
        var k:    usize = 0;
        for (k < vector.length[u32](?c.dirs)) {
            if (c.dirs.data[k] == opt_directory.some.index) { seen = true; }
            k = k + 1;
        }
        if (!seen) {
            val err_pushed: err[Fail] = vectors.push[u32](?c.dirs, opt_directory.some.index);
            if (sel err_pushed.err) { ret err_pushed; }
        }
    }
    var err_u8: err[Fail] = sink.u8(s, 1);
    err_u8 = fail.kept(err_u8, ulebs(s, DW_LNCT_PATH, DW_FORM_LINE_STRP));
    err_u8 = fail.kept(err_u8, sink.uleb(s, (vector.length[u32](?c.dirs) + 1)::u64));
    err_u8 = fail.kept(err_u8, own_directory(c));
    if (sel err_u8.err) { ret err_u8; }
    i = 0;
    for (i < vector.length[u32](?c.dirs)) {
        val err_strp: err[Fail] = strp(c, Id[Name]{index: c.dirs.data[i]});
        if (sel err_strp.err) { ret err_strp; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# directory 0, the producer's own: the unit's directory, which its
# DW_AT_comp_dir names, or the empty string for an object stating no unit
fun own_directory(c: *Ctx) err[Fail] {
    val opt_unit: opt[debug.Unit] = c.w.o.debug.unit;
    if (sel opt_unit.some) { ret strp(c, opt_unit.some.directory); }
    ret strp_at(c, 0);
}

# the file table: the first listed file as file 0, then each listed file
# with its name, directory index and, when every listed file states one, MD5
fun files_out(c: *Ctx, f: *Files) err[Fail] {
    val s:       *Sink = c.s;
    val n:       usize = vector.length[u32](?f.list);
    var digests: usize = 0;
    var i:       usize = 0;
    for (i < n) {
        val file: *File = object.file_at(c.w.o, table.nth[File](f.list.data[i]::usize));
        if (sel file.md5.some) { digests = digests + 1; }
        i = i + 1;
    }
    if (digests != 0 && digests != n) {
        ret err[Fail].err{fail.unsupported("only some files state an MD5, which one DWARF 5 file table cannot hold")};
    }
    var formats: u8 = 2;
    if (digests != 0) { formats = 3; }
    var err_u8: err[Fail] = sink.u8(s, formats);
    err_u8 = fail.kept(err_u8, ulebs(s, DW_LNCT_PATH, DW_FORM_LINE_STRP));
    err_u8 = fail.kept(err_u8, ulebs(s, DW_LNCT_DIRECTORY_INDEX, DW_FORM_UDATA));
    if (digests != 0) { err_u8 = fail.kept(err_u8, ulebs(s, DW_LNCT_MD5, DW_FORM_DATA16)); }
    var entries: usize = 0;
    if (n != 0) { entries = n + 1; }
    err_u8 = fail.kept(err_u8, sink.uleb(s, entries::u64));
    if (sel err_u8.err) { ret err_u8; }
    i = 0;
    for (i < entries) {
        var at: usize = 0;
        if (i != 0) { at = i - 1; }
        val err_entry: err[Fail] = file_out(c, f.list.data[at]);
        if (sel err_entry.err) { ret err_entry; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the file table's entry of the object's file `k`
fun file_out(c: *Ctx, k: u32) err[Fail] {
    val file:     *File     = object.file_at(c.w.o, table.nth[File](k::usize));
    val err_strp: err[Fail] = strp(c, file.name);
    if (sel err_strp.err) { ret err[Fail].err{fail.in_indexed(err_strp.err, "file", k::u64)}; }
    val err_uleb: err[Fail] = sink.uleb(c.s, directory_of(c, k));
    if (sel err_uleb.err)  { ret err_uleb; }
    if (sel file.md5.some) { ret sink.bytes(c.s, ?file.md5.some.bytes[0], 16); }
    ret err[Fail].ok{};
}

# `f` naming the `index`th row, at offset `at`
fun row_fault(f: Fail, index: usize, at: u64) Fail {
    ret fail.at_offset(fail.in_indexed(f, "line row", index::u64), at);
}

# the line program of the sequence `id`, from DW_LNE_set_address at its
# start through its rows to DW_LNE_end_sequence at its end
fun sequence_out(c: *Ctx, f: *Files, id: Id[Sequence]) err[Fail] {
    val q:    *Sequence = object.sequence_at(c.w.o, id);
    val size: u64       = object.size_of(c.w.o, object.section_at(c.w.o, q.start.section));
    val n:    usize     = vector.length[Row](?q.rows);
    var i:    usize     = 0;
    for (i < n) {
        val r: *Row = ?q.rows.data[i];
        if (r.at > size) { ret err[Fail].err{row_fault(fail.malformed("the row is past the end of its section"), i, r.at)}; }
        i = i + 1;
    }
    if (q.end > size) { ret err[Fail].err{fail.at_offset(fail.malformed("the line sequence ends past the end of its section"), q.end)}; }
    val res_how: res[Advance, Fail] = advance_of(c, q);
    if (sel res_how.err) { ret err[Fail].err{res_how.err}; }
    val by:        Advance              = res_how.ok;
    val res_start: res[Id[Place], Fail] = lowered.label(c.w.out, q.start);
    if (sel res_start.err) { ret err[Fail].err{res_start.err}; }
    val err_set_address: err[Fail] = set_address(c, res_start.ok);
    if (sel err_set_address.err) { ret err_set_address; }
    var st:   State     = State{address: q.start.offset, file: 1, line: 1, stmt: DEFAULT_IS_STMT != 0};
    var last: Id[Place] = res_start.ok;
    i = 0;
    for (i < n) {
        val r:           *Row      = ?q.rows.data[i];
        val err_row_out: err[Fail] = row_out(c, f, q, ?st, ?last, ?by, r);
        if (sel err_row_out.err) { ret err[Fail].err{row_fault(err_row_out.err, i, r.at)}; }
        i = i + 1;
    }
    val at:        Location       = Location{record: "line sequence", offset: q.end, placed: true};
    val res_delta: res[u64, Fail] = checked.sub(at, q.end, st.address);
    if (sel res_delta.err) { ret err[Fail].err{res_delta.err}; }
    if (sel by.moving) {
        if (res_delta.ok != 0) {
            val res_end: res[Id[Place], Fail] = lowered.label(c.w.out, Place{section: q.start.section, offset: q.end});
            if (sel res_end.err) { ret err[Fail].err{res_end.err}; }
            var m:                  Pairing   = by.moving;
            val err_moving_advance: err[Fail] = moving_advance(c, q, ?m, last, st.address, res_end.ok, q.end);
            if (sel err_moving_advance.err) { ret err_moving_advance; }
        }
    }
    or (res_delta.ok == MAX_SPECIAL_ADVANCE) {
        val err_u8: err[Fail] = sink.u8(c.s, DW_LNS_CONST_ADD_PC);
        if (sel err_u8.err) { ret err_u8; }
    }
    or (res_delta.ok != 0) {
        val err_u8: err[Fail] = sink.u8(c.s, DW_LNS_ADVANCE_PC);
        if (sel err_u8.err) { ret err_u8; }
        val err_uleb: err[Fail] = sink.uleb(c.s, res_delta.ok);
        if (sel err_uleb.err) { ret err_uleb; }
    }
    ret extended(c, DW_LNE_END_SEQUENCE, 0);
}

# the extended opcode `op` with an operand of `size` bytes to follow
fun extended(c: *Ctx, op: u8, size: u64) err[Fail] {
    val err_u8: err[Fail] = sink.u8(c.s, 0);
    if (sel err_u8.err) { ret err_u8; }
    val err_uleb: err[Fail] = sink.uleb(c.s, size + 1);
    if (sel err_uleb.err) { ret err_uleb; }
    ret sink.u8(c.s, op);
}

# DW_LNE_set_address with an operand relocated against the label `start`
fun set_address(c: *Ctx, start: Id[Place]) err[Fail] {
    val err_extended: err[Fail] = extended(c, DW_LNE_SET_ADDRESS, c.w.address::u64);
    if (sel err_extended.err) { ret err_extended; }
    val res_add_fixup: res[Id[Fixup], Fail] = lowered.add_fixup(c.w.out, Fixup{section: c.section, offset: sink.len(c.s)::u64, kind: c.w.absolute, target: Aim.label{start}});
    if (sel res_add_fixup.err) { ret err[Fail].err{res_add_fixup.err}; }
    ret sink.zeros(c.s, c.w.address::usize);
}

# the bytes of `v` as a ULEB128
fun uleb_size(v: u64) u64 {
    var n: u64 = 1;
    var x: u64 = v >> 7;
    for (x != 0) {
        n = n + 1;
        x = x >> 7;
    }
    ret n;
}

# append the row `r`
fun row_out(c: *Ctx, f: *Files, q: *Sequence, st: *State, last: *Id[Place], by: *Advance, r: *Row) err[Fail] {
    val s:              *Sink          = c.s;
    val res_file_index: res[u64, Fail] = file_index(f, r.file);
    if (sel res_file_index.err) { ret err[Fail].err{res_file_index.err}; }
    if (res_file_index.ok != st.file) {
        val err_u8: err[Fail] = sink.u8(s, DW_LNS_SET_FILE);
        if (sel err_u8.err) { ret err_u8; }
        val err_uleb: err[Fail] = sink.uleb(s, res_file_index.ok);
        if (sel err_uleb.err) { ret err_uleb; }
        st.file = res_file_index.ok;
    }
    if (r.column != st.column) {
        val err_u8: err[Fail] = sink.u8(s, DW_LNS_SET_COLUMN);
        if (sel err_u8.err) { ret err_u8; }
        val err_uleb: err[Fail] = sink.uleb(s, r.column::u64);
        if (sel err_uleb.err) { ret err_uleb; }
        st.column = r.column;
    }
    if (r.isa != st.isa) {
        val err_u8: err[Fail] = sink.u8(s, DW_LNS_SET_ISA);
        if (sel err_u8.err) { ret err_u8; }
        val err_uleb: err[Fail] = sink.uleb(s, r.isa::u64);
        if (sel err_uleb.err) { ret err_uleb; }
        st.isa = r.isa;
    }
    if (r.discriminator != 0) {
        val err_extended: err[Fail] = extended(c, DW_LNE_SET_DISCRIMINATOR, uleb_size(r.discriminator::u64));
        if (sel err_extended.err) { ret err_extended; }
        val err_uleb: err[Fail] = sink.uleb(s, r.discriminator::u64);
        if (sel err_uleb.err) { ret err_uleb; }
    }
    val stmt: bool = (r.flags & line.STATEMENT) != 0;
    if (stmt != st.stmt) {
        val err_u8: err[Fail] = sink.u8(s, DW_LNS_NEGATE_STMT);
        if (sel err_u8.err) { ret err_u8; }
        st.stmt = stmt;
    }
    val marks: [3]line.Flags = [3]line.Flags{line.BLOCK, line.PROLOGUE_END, line.EPILOGUE_BEGIN};
    val ops:   [3]u8         = [3]u8{DW_LNS_SET_BASIC_BLOCK, DW_LNS_SET_PROLOGUE_END, DW_LNS_SET_EPILOGUE_BEGIN};
    var k:     usize         = 0;
    for (k < 3) {
        if ((r.flags & marks[k]) != 0) {
            val err_u8: err[Fail] = sink.u8(s, ops[k]);
            if (sel err_u8.err) { ret err_u8; }
        }
        k = k + 1;
    }
    val at:        Location       = Location{record: "line row", offset: r.at, placed: true};
    val res_delta: res[u64, Fail] = checked.sub(at, r.at, st.address);
    if (sel res_delta.err) { ret err[Fail].err{res_delta.err}; }
    val lines: i64 = r.line::i64 - st.line::i64;
    st.line = r.line;
    if (sel by.number) {
        st.address = r.at;
        ret advance(s, lines, res_delta.ok);
    }
    var m: Pairing = by.moving;
    if (res_delta.ok != 0) {
        val res_here: res[Id[Place], Fail] = lowered.label(c.w.out, Place{section: q.start.section, offset: r.at});
        if (sel res_here.err) { ret err[Fail].err{res_here.err}; }
        val err_moving_advance: err[Fail] = moving_advance(c, q, ?m, @last, st.address, res_here.ok, r.at);
        if (sel err_moving_advance.err) { ret err_moving_advance; }
        @last = res_here.ok;
    }
    st.address = r.at;
    ret advance(s, lines, 0);
}

# advance from the label `from` at offset `low` to the label `to` at offset
# `high` of the sequence's section, code the linker may resize, as advances
# each a difference no wider than its 16-bit operand
fun moving_advance(c: *Ctx, q: *Sequence, m: *Pairing, from: Id[Place], low: u64, to: Id[Place], high: u64) err[Fail] {
    var at:   u64       = low;
    var mark: Id[Place] = from;
    for (high - at > FIXED_ADVANCE_MAX) {
        at = at + FIXED_ADVANCE_MAX;
        val res_mid: res[Id[Place], Fail] = lowered.label(c.w.out, Place{section: q.start.section, offset: at});
        if (sel res_mid.err) { ret err[Fail].err{res_mid.err}; }
        val err_fixed_out: err[Fail] = fixed_out(c, m, res_mid.ok, mark);
        if (sel err_fixed_out.err) { ret err_fixed_out; }
        mark = res_mid.ok;
    }
    ret fixed_out(c, m, to, mark);
}

# how the sequence `q` advances: over code the linker may resize by 16-bit
# differences, refused when the set has none, and by numbers otherwise
fun advance_of(c: *Ctx, q: *Sequence) res[Advance, Fail] {
    if (!difference.resizes(c.w.resizing, q.start.section)) { ret res[Advance, Fail].ok{Advance.number{}}; }
    val opt_pick: opt[Pairing] = difference.pick(c.w.set, ?FIXED_WIDTHS[0], 1, FIXED_ADVANCE_MAX);
    if (sel opt_pick.none) {
        ret res[Advance, Fail].err{fail.unsupported("the relocation set has no 16-bit difference, so no line table can advance over code the linker may resize")};
    }
    val found: Pairing = opt_pick.some;
    ret res[Advance, Fail].ok{Advance.moving{found}};
}

# DW_LNS_fixed_advance_pc with its operand the difference `p` from the label
# `from` to the label `to`
fun fixed_out(c: *Ctx, p: *Pairing, to: Id[Place], from: Id[Place]) err[Fail] {
    val err_u8: err[Fail] = sink.u8(c.s, DW_LNS_FIXED_ADVANCE_PC);
    if (sel err_u8.err) { ret err_u8; }
    val err_record: err[Fail] = difference.record(c.w.out, c.section, sink.len(c.s)::u64, p, Aim.label{to}, Aim.label{from});
    if (sel err_record.err) { ret err_record; }
    ret sink.zeros(c.s, row.container(p.plus)::usize);
}

# append a row `lines` lines and `bytes` bytes past the last one, in the
# shortest encoding: a special opcode when both advances fit one, the line
# advance by DW_LNS_advance_line when it does not, and the address advance by
# DW_LNS_const_add_pc and a special opcode or else by DW_LNS_advance_pc
pub fun advance(s: *Sink, lines: i64, bytes: u64) err[Fail] {
    var line:   i64  = lines;
    var copy:   bool = false;
    var biased: i64  = line - LINE_BASE;
    if (biased >= LINE_RANGE::i64 || biased < 0) {
        val err_u8: err[Fail] = sink.u8(s, DW_LNS_ADVANCE_LINE);
        if (sel err_u8.err) { ret err_u8; }
        val err_sleb: err[Fail] = sink.sleb(s, line);
        if (sel err_sleb.err) { ret err_sleb; }
        line   = 0;
        biased = 0 - LINE_BASE;
        copy   = true;
    }
    if (line == 0 && bytes == 0) { ret sink.u8(s, DW_LNS_COPY); }
    val base: u64 = biased::u64 + OPCODE_BASE;
    if (bytes < 256 + MAX_SPECIAL_ADVANCE) {
        val op: u64 = base + bytes * LINE_RANGE;
        if (op <= 255) { ret sink.u8(s, op::u8); }
        if (bytes >= MAX_SPECIAL_ADVANCE) {
            val again: u64 = base + (bytes - MAX_SPECIAL_ADVANCE) * LINE_RANGE;
            if (again <= 255) {
                val err_u8: err[Fail] = sink.u8(s, DW_LNS_CONST_ADD_PC);
                if (sel err_u8.err) { ret err_u8; }
                ret sink.u8(s, again::u8);
            }
        }
    }
    val err_u8: err[Fail] = sink.u8(s, DW_LNS_ADVANCE_PC);
    if (sel err_u8.err) { ret err_u8; }
    val err_uleb: err[Fail] = sink.uleb(s, bytes);
    if (sel err_uleb.err) { ret err_uleb; }
    if (copy)             { ret sink.u8(s, DW_LNS_COPY); }
    ret sink.u8(s, base::u8);
}
