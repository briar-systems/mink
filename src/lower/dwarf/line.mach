# the object's line records as a DWARF 5 line table
#
# the file table becomes the header's directory and file tables and each line
# sequence one sequence of the line program, which starts with
# DW_LNE_set_address relocated against a label at its start. directory 0 is
# the producer's own directory, which the records leave unnamed, so it is
# written empty and a file stating no directory names it. file entry k is the
# object's file k, the first being the primary source file. an advance in a
# section the linker may resize is DW_LNS_fixed_advance_pc with a difference
# relocation between labels at its two places, through lower.difference. any
# other advance takes the shortest encoding: a special opcode when the address
# and line advances fit one, otherwise the standard opcodes. a row at its
# sequence's end is written there, and DW_LNE_end_sequence follows it with no
# advance. the table is 32-bit DWARF with a minimum instruction length of 1
# and, since no row states an operation index, one operation per instruction.
# a row's end column has no place in DWARF and is not written.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink.base.vectors;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.kind;
use mink.lower.difference;
use mink.lower.difference.Resizing;
use mink.lower.lowered;
use mink.lower.lowered.Added;
use mink.lower.lowered.Aim;
use mink.lower.lowered.Fixup;
use mink.lower.lowered.Lowered;
use mink.lower.lowered.Mark;
use mink.model.line;
use mink.model.line.File;
use mink.model.line.FileKey;
use mink.model.line.Row;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Sequence;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.model.section;

use mink.reloc.row;
use mink.reloc.row.Lookup;
use mink.reloc.row.Pairing;

val VERSION: u16 = 5;

# address advances count bytes, one operation per instruction, and a row is a
# statement unless it says otherwise
val MIN_INSTRUCTION_LENGTH: u8 = 1;
val MAX_OPERATIONS:         u8 = 1;
val DEFAULT_IS_STMT:        u8 = 1;

val LINE_BASE:   i64 = -5;
val LINE_RANGE:  u64 = 14;
val OPCODE_BASE: u64 = 13;
# the operands each standard opcode takes, 1 through OPCODE_BASE - 1
val STANDARD_LENGTHS: [12]u8 = [12]u8{0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1};
# the largest address advance a special opcode holds with no line advance
val MAX_SPECIAL_ADVANCE: u64 = (255 - OPCODE_BASE) / LINE_RANGE;

pub val DW_LNS_COPY:               u8 = 0x01;
pub val DW_LNS_ADVANCE_PC:         u8 = 0x02;
pub val DW_LNS_ADVANCE_LINE:       u8 = 0x03;
pub val DW_LNS_SET_FILE:           u8 = 0x04;
pub val DW_LNS_SET_COLUMN:         u8 = 0x05;
pub val DW_LNS_NEGATE_STMT:        u8 = 0x06;
pub val DW_LNS_SET_BASIC_BLOCK:    u8 = 0x07;
pub val DW_LNS_CONST_ADD_PC:       u8 = 0x08;
pub val DW_LNS_FIXED_ADVANCE_PC:   u8 = 0x09;
pub val DW_LNS_SET_PROLOGUE_END:   u8 = 0x0a;
pub val DW_LNS_SET_EPILOGUE_BEGIN: u8 = 0x0b;
pub val DW_LNS_SET_ISA:            u8 = 0x0c;

pub val DW_LNE_END_SEQUENCE:      u8 = 0x01;
pub val DW_LNE_SET_ADDRESS:       u8 = 0x02;
pub val DW_LNE_SET_DISCRIMINATOR: u8 = 0x04;

pub val DW_LNCT_PATH:            u64 = 0x1;
pub val DW_LNCT_DIRECTORY_INDEX: u64 = 0x2;
pub val DW_LNCT_MD5:             u64 = 0x5;

pub val DW_FORM_STRING: u64 = 0x08;
pub val DW_FORM_UDATA:  u64 = 0x0f;
pub val DW_FORM_DATA16: u64 = 0x1e;

# DW_LNS_fixed_advance_pc takes a 16-bit operand, so a longer advance is
# written as several
pub val FIXED_ADVANCE_MAX: u64 = 0xffff;
# the widths, in bits, a fixed advance's difference may be written in
val FIXED_WIDTHS: [1]u32 = [1]u32{16};

# the most a 32-bit unit length counts
val UNIT_MAX: u64 = 0xffff_fff0;

# how a sequence advances its address
# ---
# number: by the distance, fixed once the object is written
# moving: by DW_LNS_fixed_advance_pc and a 16-bit difference between labels
#         the linker recomputes, the code being resizable
tag Advance: u8 {
    number;
    moving: Pairing;
}

# the line state machine's registers the encoder tracks
rec State {
    address: u64;
    file:    u64;
    line:    u32;
    column:  u32;
    stmt:    bool;
    isa:     u32;
}

# o:        the object
# set:      the relocation set the target writes
# address:  the target address size in bytes
# out:      the record the table is added to
# section:  the id the table takes in `out`
# s:        the table's bytes
# resizing: which sections the linker may resize
# absolute: the kind DW_LNE_set_address is relocated with
# dirs:     per file, its index in the directory table
rec Ctx {
    o:        *Object;
    set:      *Lookup;
    address:  u8;
    out:      *Lowered;
    section:  Id[Added];
    s:        Sink;
    resizing: Resizing;
    absolute: *Kind;
    dirs:     Vector[u64];
}

# encode the line records of `o` into `out` as the DWARF 5 line table `name`,
# the section a relocation naming the line table is pointed at,
# for a target of `address`-byte addresses whose relocations `set` writes. an
# object with no line sequence adds nothing. a refusal adds nothing either:
# - malformed, naming the sequence and the row, for a row or sequence end past
#   its section's size, now that the size is final
# - unsupported for files of which only some state an MD5, which one file
#   table cannot hold, for an address size no absolute kind has, and for an
#   advance over code the linker may resize when `set` has no 16-bit
#   difference
# - malformed for a name holding a NUL byte
# - overflow for a table larger than a 32-bit unit length counts
pub fun encode(o: *Object, set: *Lookup, address: u8, name: str, out: *Lowered) err[Fail] {
    if (table.count[Sequence](?o.sequences) == 0) { ret err[Fail].ok{}; }
    val a:            *A.Allocator        = o.a;
    val res_resizing: res[Resizing, Fail] = difference.resizing(a, o);
    if (sel res_resizing.err) { ret err[Fail].err{res_resizing.err}; }
    var c: Ctx = Ctx{
        o:        o,
        set:      set,
        address:  address,
        out:      out,
        section:  lowered.next_section(out),
        s:        sink.init(a, o.target.arch.order),
        resizing: res_resizing.ok,
        dirs:     vector.init[u64](a),
    };
    val m:                     Mark      = lowered.mark(out);
    val err_table_out:         err[Fail] = table_out(?c);
    val err_resizing_released: err[Fail] = difference.dnit(?c.resizing);
    val err_dirs_released:     err[Fail] = vectors.dnit[u64](?c.dirs);
    val err_kept:              err[Fail] = fail.kept(fail.kept(err_table_out, err_resizing_released), err_dirs_released);
    if (sel err_kept.err) {
        val err_dropped: err[Fail] = sink.dnit(?c.s);
        lowered.truncate(out, m);
        ret err_kept;
    }
    val res_added: res[Id[Added], Fail] = lowered.add_section(out, Added{name: name, kind: ?section.DEBUG_INFO, flags: section.DEBUG_INFO.flags, align: 1, disposition: ?section.ROOT, bytes: c.s});
    if (sel res_added.err) {
        lowered.truncate(out, m);
        ret err[Fail].err{res_added.err};
    }
    out.lines = opt[Id[Added]].some{res_added.ok};
    ret err[Fail].ok{};
}

fun table_out(c: *Ctx) err[Fail] {
    val res_absolute_of: res[*Kind, Fail] = reloc.absolute_of(c.address);
    if (sel res_absolute_of.err) { ret err[Fail].err{res_absolute_of.err}; }
    c.absolute = res_absolute_of.ok;
    val s:       *Sink     = ?c.s;
    val err_u32: err[Fail] = sink.u32(s, 0);
    if (sel err_u32.err) { ret err_u32; }
    val err_u16: err[Fail] = sink.u16(s, VERSION);
    if (sel err_u16.err) { ret err_u16; }
    val err_u8: err[Fail] = sink.u8(s, c.address);
    if (sel err_u8.err) { ret err_u8; }
    val err_segment_selector_written: err[Fail] = sink.u8(s, 0);
    if (sel err_segment_selector_written.err) { ret err_segment_selector_written; }
    val err_header_length_written: err[Fail] = sink.u32(s, 0);
    if (sel err_header_length_written.err) { ret err_header_length_written; }
    val after_length:   usize     = sink.len(s);
    val err_header_out: err[Fail] = header_out(c);
    if (sel err_header_out.err) { ret err_header_out; }
    val err_patch_length: err[Fail] = patch_length(s, after_length - 4, sink.len(s) - after_length);
    if (sel err_patch_length.err) { ret err_patch_length; }
    var q: usize = 0;
    for (q < table.count[Sequence](?c.o.sequences)) {
        val err_sequence_out: err[Fail] = sequence_out(c, table.nth[Sequence](q));
        if (sel err_sequence_out.err) { ret err[Fail].err{fail.valued(fail.about(fail.in_indexed(err_sequence_out.err, "line sequence", q::u64), "line sequence"), q::i128)}; }
        q = q + 1;
    }
    ret patch_length(s, 0, sink.len(s) - 4);
}

# write the 32-bit length `n` at `at`
fun patch_length(s: *Sink, at: usize, n: usize) err[Fail] {
    if (n::u64 > UNIT_MAX) { ret err[Fail].err{fail.overflow("the line table is larger than a 32-bit unit length counts")}; }
    ret sink.patch(s, at, n::u64, 4);
}

fun header_out(c: *Ctx) err[Fail] {
    val s:         *Sink     = ?c.s;
    val fixed:     [6]u8     = [6]u8{MIN_INSTRUCTION_LENGTH, MAX_OPERATIONS, DEFAULT_IS_STMT, (256 + LINE_BASE)::u8, LINE_RANGE::u8, OPCODE_BASE::u8};
    val err_bytes: err[Fail] = sink.bytes(s, ?fixed[0], 6);
    if (sel err_bytes.err) { ret err_bytes; }
    val err_bytes_standard_lengths: err[Fail] = sink.bytes(s, ?STANDARD_LENGTHS[0], 12);
    if (sel err_bytes_standard_lengths.err) { ret err_bytes_standard_lengths; }
    val err_directories_out: err[Fail] = directories_out(c);
    if (sel err_directories_out.err) { ret err_directories_out; }
    ret files_out(c);
}

fun ulebs(s: *Sink, a: u64, b: u64) err[Fail] {
    val err_uleb: err[Fail] = sink.uleb(s, a);
    if (sel err_uleb.err) { ret err_uleb; }
    ret sink.uleb(s, b);
}

# the bytes of `id` and a NUL, refusing a name that holds one
fun string_out(c: *Ctx, id: Id[Name]) err[Fail] {
    val v: View  = object.name_of(c.o, id);
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == 0) { ret err[Fail].err{fail.malformed("a file or directory name holds a NUL byte")}; }
        i = i + 1;
    }
    val err_bytes: err[Fail] = sink.bytes(?c.s, v.data, v.len);
    if (sel err_bytes.err) { ret err_bytes; }
    ret sink.u8(?c.s, 0);
}

# the directory table: the producer's own directory, unnamed, then each
# directory a file states once, as the file index orders them, giving every
# file its directory's index
fun directories_out(c: *Ctx) err[Fail] {
    val s:        *Sink     = ?c.s;
    val n:        usize     = vector.length[FileKey](?c.o.file_index);
    val err_grow: err[Fail] = vectors.grow[u64](?c.dirs, table.count[File](?c.o.files));
    if (sel err_grow.err) { ret err[Fail].err{err_grow.err}; }
    var count: u64   = 1;
    var i:     usize = 0;
    for (i < n) {
        val k: *FileKey = ?c.o.file_index.data[i];
        if (sel k.directory.some && (i == 0 || !same_directory(?c.o.file_index.data[i - 1], k))) { count = count + 1; }
        i = i + 1;
    }
    val err_u8: err[Fail] = sink.u8(s, 1);
    if (sel err_u8.err) { ret err_u8; }
    val err_ulebs: err[Fail] = ulebs(s, DW_LNCT_PATH, DW_FORM_STRING);
    if (sel err_ulebs.err) { ret err_ulebs; }
    val err_uleb: err[Fail] = sink.uleb(s, count);
    if (sel err_uleb.err) { ret err_uleb; }
    val err_terminator_written: err[Fail] = sink.u8(s, 0);
    if (sel err_terminator_written.err) { ret err_terminator_written; }
    var at: u64 = 0;
    i = 0;
    for (i < n) {
        val k: *FileKey = ?c.o.file_index.data[i];
        if (sel k.directory.some) {
            if (i == 0 || !same_directory(?c.o.file_index.data[i - 1], k)) {
                at = at + 1;
                val err_string_out: err[Fail] = string_out(c, k.directory.some);
                if (sel err_string_out.err) { ret err[Fail].err{fail.in_indexed(err_string_out.err, "file", k.file.index::u64)}; }
            }
            c.dirs.data[k.file.index::usize] = at;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun same_directory(a: *FileKey, b: *FileKey) bool {
    if (sel a.directory.none) { ret sel b.directory.none; }
    if (sel b.directory.none) { ret false; }
    ret a.directory.some.index == b.directory.some.index;
}

# the file table, each file's name, directory index and, when every file
# states one, MD5
fun files_out(c: *Ctx) err[Fail] {
    val s:       *Sink = ?c.s;
    val n:       usize = table.count[File](?c.o.files);
    var digests: usize = 0;
    var i:       usize = 0;
    for (i < n) {
        val f: *File = object.file_at(c.o, table.nth[File](i));
        if (sel f.md5.some) { digests = digests + 1; }
        i = i + 1;
    }
    if (digests != 0 && digests != n) {
        ret err[Fail].err{fail.unsupported("only some files state an MD5, which one DWARF 5 file table cannot hold")};
    }
    var formats: u8 = 2;
    if (digests != 0) { formats = 3; }
    val err_u8: err[Fail] = sink.u8(s, formats);
    if (sel err_u8.err) { ret err_u8; }
    val err_ulebs: err[Fail] = ulebs(s, DW_LNCT_PATH, DW_FORM_STRING);
    if (sel err_ulebs.err) { ret err_ulebs; }
    val err_ulebs_dw_lnct_directory_index: err[Fail] = ulebs(s, DW_LNCT_DIRECTORY_INDEX, DW_FORM_UDATA);
    if (sel err_ulebs_dw_lnct_directory_index.err) { ret err_ulebs_dw_lnct_directory_index; }
    if (digests != 0) {
        val err_ulebs: err[Fail] = ulebs(s, DW_LNCT_MD5, DW_FORM_DATA16);
        if (sel err_ulebs.err) { ret err_ulebs; }
    }
    val err_uleb: err[Fail] = sink.uleb(s, n::u64);
    if (sel err_uleb.err) { ret err_uleb; }
    i = 0;
    for (i < n) {
        val f:              *File     = object.file_at(c.o, table.nth[File](i));
        val err_string_out: err[Fail] = string_out(c, f.name);
        if (sel err_string_out.err) { ret err[Fail].err{fail.in_indexed(err_string_out.err, "file", i::u64)}; }
        val err_uleb: err[Fail] = sink.uleb(s, c.dirs.data[i]);
        if (sel err_uleb.err) { ret err_uleb; }
        if (sel f.md5.some) {
            val err_bytes: err[Fail] = sink.bytes(s, ?f.md5.some.bytes[0], 16);
            if (sel err_bytes.err) { ret err_bytes; }
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

fun row_fault(f: Fail, index: usize, at: u64) Fail {
    ret fail.at_offset(fail.in_indexed(f, "line row", index::u64), at);
}

fun sequence_out(c: *Ctx, id: Id[Sequence]) err[Fail] {
    val q:    *Sequence = object.sequence_at(c.o, id);
    val size: u64       = object.size_of(c.o, object.section_at(c.o, q.start.section));
    val n:    usize     = vector.length[Row](?q.rows);
    var i:    usize     = 0;
    for (i < n) {
        val r: *Row = ?q.rows.data[i];
        if (r.at > size) { ret err[Fail].err{row_fault(fail.malformed("the row is past the end of its section"), i, r.at)}; }
        i = i + 1;
    }
    if (q.end > size) { ret err[Fail].err{fail.at_offset(fail.malformed("the line sequence ends past the end of its section"), q.end)}; }
    val res_how: res[Advance, Fail] = advance_of(c, q);
    if (sel res_how.err) { ret err[Fail].err{res_how.err}; }
    val by:        Advance              = res_how.ok;
    val res_start: res[Id[Place], Fail] = lowered.label(c.out, q.start);
    if (sel res_start.err) { ret err[Fail].err{res_start.err}; }
    val err_set_address: err[Fail] = set_address(c, res_start.ok);
    if (sel err_set_address.err) { ret err_set_address; }
    var st:   State     = State{address: q.start.offset, file: 1, line: 1, stmt: DEFAULT_IS_STMT != 0};
    var last: Id[Place] = res_start.ok;
    i = 0;
    for (i < n) {
        val r:           *Row      = ?q.rows.data[i];
        val err_row_out: err[Fail] = row_out(c, q, ?st, ?last, ?by, r);
        if (sel err_row_out.err) { ret err[Fail].err{row_fault(err_row_out.err, i, r.at)}; }
        i = i + 1;
    }
    val at:        Location       = Location{record: "line sequence", offset: q.end, placed: true};
    val res_delta: res[u64, Fail] = checked.sub(at, q.end, st.address);
    if (sel res_delta.err) { ret err[Fail].err{res_delta.err}; }
    if (sel by.moving) {
        if (res_delta.ok != 0) {
            val res_end: res[Id[Place], Fail] = lowered.label(c.out, Place{section: q.start.section, offset: q.end});
            if (sel res_end.err) { ret err[Fail].err{res_end.err}; }
            var m:                  Pairing   = by.moving;
            val err_moving_advance: err[Fail] = moving_advance(c, q, ?m, last, st.address, res_end.ok, q.end);
            if (sel err_moving_advance.err) { ret err_moving_advance; }
        }
    }
    or (res_delta.ok == MAX_SPECIAL_ADVANCE) {
        val err_u8: err[Fail] = sink.u8(?c.s, DW_LNS_CONST_ADD_PC);
        if (sel err_u8.err) { ret err_u8; }
    }
    or (res_delta.ok != 0) {
        val err_u8: err[Fail] = sink.u8(?c.s, DW_LNS_ADVANCE_PC);
        if (sel err_u8.err) { ret err_u8; }
        val err_uleb: err[Fail] = sink.uleb(?c.s, res_delta.ok);
        if (sel err_uleb.err) { ret err_uleb; }
    }
    ret extended(c, DW_LNE_END_SEQUENCE, 0);
}

# the extended opcode `op` with an operand of `size` bytes to follow
fun extended(c: *Ctx, op: u8, size: u64) err[Fail] {
    val err_u8: err[Fail] = sink.u8(?c.s, 0);
    if (sel err_u8.err) { ret err_u8; }
    val err_uleb: err[Fail] = sink.uleb(?c.s, size + 1);
    if (sel err_uleb.err) { ret err_uleb; }
    ret sink.u8(?c.s, op);
}

fun set_address(c: *Ctx, start: Id[Place]) err[Fail] {
    val err_extended: err[Fail] = extended(c, DW_LNE_SET_ADDRESS, c.address::u64);
    if (sel err_extended.err) { ret err_extended; }
    val res_add_fixup: res[Id[Fixup], Fail] = lowered.add_fixup(c.out, Fixup{section: c.section, offset: sink.len(?c.s)::u64, kind: c.absolute, target: Aim.label{start}});
    if (sel res_add_fixup.err) { ret err[Fail].err{res_add_fixup.err}; }
    ret sink.zeros(?c.s, c.address::usize);
}

# the bytes of `v` as a ULEB128
fun uleb_size(v: u64) u64 {
    var n: u64 = 1;
    var x: u64 = v >> 7;
    for (x != 0) {
        n = n + 1;
        x = x >> 7;
    }
    ret n;
}

# append the row `r`
fun row_out(c: *Ctx, q: *Sequence, st: *State, last: *Id[Place], by: *Advance, r: *Row) err[Fail] {
    val s: *Sink = ?c.s;
    if (r.file.index::u64 != st.file) {
        val err_u8: err[Fail] = sink.u8(s, DW_LNS_SET_FILE);
        if (sel err_u8.err) { ret err_u8; }
        val err_uleb: err[Fail] = sink.uleb(s, r.file.index::u64);
        if (sel err_uleb.err) { ret err_uleb; }
        st.file = r.file.index::u64;
    }
    if (r.column != st.column) {
        val err_u8: err[Fail] = sink.u8(s, DW_LNS_SET_COLUMN);
        if (sel err_u8.err) { ret err_u8; }
        val err_uleb: err[Fail] = sink.uleb(s, r.column::u64);
        if (sel err_uleb.err) { ret err_uleb; }
        st.column = r.column;
    }
    if (r.isa != st.isa) {
        val err_u8: err[Fail] = sink.u8(s, DW_LNS_SET_ISA);
        if (sel err_u8.err) { ret err_u8; }
        val err_uleb: err[Fail] = sink.uleb(s, r.isa::u64);
        if (sel err_uleb.err) { ret err_uleb; }
        st.isa = r.isa;
    }
    if (r.discriminator != 0) {
        val err_extended: err[Fail] = extended(c, DW_LNE_SET_DISCRIMINATOR, uleb_size(r.discriminator::u64));
        if (sel err_extended.err) { ret err_extended; }
        val err_uleb: err[Fail] = sink.uleb(s, r.discriminator::u64);
        if (sel err_uleb.err) { ret err_uleb; }
    }
    val stmt: bool = (r.flags & line.STATEMENT) != 0;
    if (stmt != st.stmt) {
        val err_u8: err[Fail] = sink.u8(s, DW_LNS_NEGATE_STMT);
        if (sel err_u8.err) { ret err_u8; }
        st.stmt = stmt;
    }
    val marks: [3]line.Flags = [3]line.Flags{line.BLOCK, line.PROLOGUE_END, line.EPILOGUE_BEGIN};
    val ops:   [3]u8         = [3]u8{DW_LNS_SET_BASIC_BLOCK, DW_LNS_SET_PROLOGUE_END, DW_LNS_SET_EPILOGUE_BEGIN};
    var k:     usize         = 0;
    for (k < 3) {
        if ((r.flags & marks[k]) != 0) {
            val err_u8: err[Fail] = sink.u8(s, ops[k]);
            if (sel err_u8.err) { ret err_u8; }
        }
        k = k + 1;
    }
    val at:        Location       = Location{record: "line row", offset: r.at, placed: true};
    val res_delta: res[u64, Fail] = checked.sub(at, r.at, st.address);
    if (sel res_delta.err) { ret err[Fail].err{res_delta.err}; }
    val lines: i64 = r.line::i64 - st.line::i64;
    st.line = r.line;
    if (sel by.number) {
        st.address = r.at;
        ret advance(s, lines, res_delta.ok);
    }
    var m: Pairing = by.moving;
    if (res_delta.ok != 0) {
        val res_here: res[Id[Place], Fail] = lowered.label(c.out, Place{section: q.start.section, offset: r.at});
        if (sel res_here.err) { ret err[Fail].err{res_here.err}; }
        val err_moving_advance: err[Fail] = moving_advance(c, q, ?m, @last, st.address, res_here.ok, r.at);
        if (sel err_moving_advance.err) { ret err_moving_advance; }
        @last = res_here.ok;
    }
    st.address = r.at;
    ret advance(s, lines, 0);
}

# advance from the label `from` at offset `low` to the label `to` at offset
# `high` of the sequence's section, code the linker may resize, as advances
# each a difference no wider than its 16-bit operand
fun moving_advance(c: *Ctx, q: *Sequence, m: *Pairing, from: Id[Place], low: u64, to: Id[Place], high: u64) err[Fail] {
    var at:   u64       = low;
    var mark: Id[Place] = from;
    for (high - at > FIXED_ADVANCE_MAX) {
        at = at + FIXED_ADVANCE_MAX;
        val res_mid: res[Id[Place], Fail] = lowered.label(c.out, Place{section: q.start.section, offset: at});
        if (sel res_mid.err) { ret err[Fail].err{res_mid.err}; }
        val err_fixed_out: err[Fail] = fixed_out(c, m, res_mid.ok, mark);
        if (sel err_fixed_out.err) { ret err_fixed_out; }
        mark = res_mid.ok;
    }
    ret fixed_out(c, m, to, mark);
}

# how the sequence `q` advances: over code the linker may resize by 16-bit
# differences, refused when the set has none, and by numbers otherwise
fun advance_of(c: *Ctx, q: *Sequence) res[Advance, Fail] {
    if (!difference.resizes(?c.resizing, q.start.section)) { ret res[Advance, Fail].ok{Advance.number{}}; }
    val opt_pick: opt[Pairing] = difference.pick(c.set, ?FIXED_WIDTHS[0], 1, FIXED_ADVANCE_MAX);
    if (sel opt_pick.none) {
        ret res[Advance, Fail].err{fail.unsupported("the relocation set has no 16-bit difference, so no line table can advance over code the linker may resize")};
    }
    val found: Pairing = opt_pick.some;
    ret res[Advance, Fail].ok{Advance.moving{found}};
}

fun fixed_out(c: *Ctx, p: *Pairing, to: Id[Place], from: Id[Place]) err[Fail] {
    val err_u8: err[Fail] = sink.u8(?c.s, DW_LNS_FIXED_ADVANCE_PC);
    if (sel err_u8.err) { ret err_u8; }
    val err_record: err[Fail] = difference.record(c.out, c.section, sink.len(?c.s)::u64, p, Aim.label{to}, Aim.label{from});
    if (sel err_record.err) { ret err_record; }
    ret sink.zeros(?c.s, row.container(p.plus)::usize);
}

# append a row `lines` lines and `bytes` bytes past the last one, in the
# shortest encoding: a special opcode when both advances fit one, the line
# advance by DW_LNS_advance_line when it does not, and the address advance by
# DW_LNS_const_add_pc and a special opcode or else by DW_LNS_advance_pc
pub fun advance(s: *Sink, lines: i64, bytes: u64) err[Fail] {
    var line:   i64  = lines;
    var copy:   bool = false;
    var biased: i64  = line - LINE_BASE;
    if (biased >= LINE_RANGE::i64 || biased < 0) {
        val err_u8: err[Fail] = sink.u8(s, DW_LNS_ADVANCE_LINE);
        if (sel err_u8.err) { ret err_u8; }
        val err_sleb: err[Fail] = sink.sleb(s, line);
        if (sel err_sleb.err) { ret err_sleb; }
        line   = 0;
        biased = 0 - LINE_BASE;
        copy   = true;
    }
    if (line == 0 && bytes == 0) { ret sink.u8(s, DW_LNS_COPY); }
    val base: u64 = biased::u64 + OPCODE_BASE;
    if (bytes < 256 + MAX_SPECIAL_ADVANCE) {
        val op: u64 = base + bytes * LINE_RANGE;
        if (op <= 255) { ret sink.u8(s, op::u8); }
        if (bytes >= MAX_SPECIAL_ADVANCE) {
            val again: u64 = base + (bytes - MAX_SPECIAL_ADVANCE) * LINE_RANGE;
            if (again <= 255) {
                val err_u8: err[Fail] = sink.u8(s, DW_LNS_CONST_ADD_PC);
                if (sel err_u8.err) { ret err_u8; }
                ret sink.u8(s, again::u8);
            }
        }
    }
    val err_u8: err[Fail] = sink.u8(s, DW_LNS_ADVANCE_PC);
    if (sel err_u8.err) { ret err_u8; }
    val err_uleb: err[Fail] = sink.uleb(s, bytes);
    if (sel err_uleb.err) { ret err_uleb; }
    if (copy)             { ret sink.u8(s, DW_LNS_COPY); }
    ret sink.u8(s, base::u8);
}
