# a DWARF line table read into the object's file table and line sequences
#
# every unit of the table is read: versions 2 through 5, 32 and 64-bit DWARF,
# the file and directory tables of each and every opcode of its program. an
# opcode a version adds and this does not know is skipped by the operand count
# the header states, and an extended one by its length, as DWARF requires. a
# unit's own numbering stops at the table: each file a row names is the
# object's file of its directory and name, and directory 0 of a DWARF 5 table
# is named as the directory it states, since the object's table leaves no
# place for the producer's own directory. a row's address is a place in a
# section, the place the relocation of its sequence's DW_LNE_set_address
# names, less any distance a difference states over code the linker may
# resize, and a sequence ends with its DW_LNE_end_sequence, which is no row.
#
# what stops a program from being decoded is malformed and refused, naming the
# offset. what is decoded and has no form in the model is unsupported, which
# leaves the table as bytes, whole: a file table with an MD5 for only some
# files, a string in a section not held plain, a form that names one by an
# index, a sequence no relocation places in code of the object, rows out of
# order, or a VLIW table's operation index.
#
# a table is read twice over one walk, as frames are: with no object, to answer
# whether it is decoded and stated, then into the object once its sections
# exist.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader;
use mink.bytes.reader.Reader;
use mink.lower.dwarf.line;
use mink.lower.sites;
use mink.lower.sites.Located;
use mink.lower.sites.Patch;
use mink.lower.sites.Read;
use model_line: mink.model.line;
use mink.model.line.File;
use mink.model.line.Md5;
use mink.model.line.Row;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Section;
use mink.model.object.Sequence;

val ESCAPE: u32 = 0xffff_ffff;

val OLDEST_VERSION: u16 = 2;
val NEWEST_VERSION: u16 = 5;

val DW_LNE_DEFINE_FILE: u8 = 0x03;

val DW_LNCT_TIMESTAMP: u64 = 0x3;
val DW_LNCT_SIZE:      u64 = 0x4;

val DW_FORM_BLOCK2:    u64 = 0x03;
val DW_FORM_BLOCK4:    u64 = 0x04;
val DW_FORM_DATA2:     u64 = 0x05;
val DW_FORM_DATA4:     u64 = 0x06;
val DW_FORM_DATA8:     u64 = 0x07;
val DW_FORM_BLOCK:     u64 = 0x09;
val DW_FORM_BLOCK1:    u64 = 0x0a;
val DW_FORM_DATA1:     u64 = 0x0b;
val DW_FORM_STRP:      u64 = 0x0e;
val DW_FORM_LINE_STRP: u64 = 0x1f;

# the most entry formats a table states
val FORMATS_MAX: usize = 8;

# a directory or file table's description of its entries
rec Format {
    content: u64;
    form:    u64;
}

# a file of a unit
# ---
# name:      its name
# directory: its directory, none for the producer's own
# md5:       its digest, none for none
# id:        the object's file, once the walk has an object
rec Listed {
    name:      Bytes;
    directory: opt[Bytes];
    md5:       opt[Md5];
    id:        Id[File];
}

# the unit a walk is in
# ---
# version: its DWARF version
# offset:  how many bytes an offset takes
# minimum: its minimum instruction length
# stmt:    its default is_stmt
# base:    its line base
# range:   its line range
# opcode:  its opcode base
# lengths: the operand count of each standard opcode from 1
# dirs:    its directories, by index
# files:   its files, by index
rec Unit {
    version: u16;
    offset:  u8;
    minimum: u8;
    stmt:    bool;
    base:    i8;
    range:   u8;
    opcode:  u8;
    lengths: *u8;
    dirs:    Table[opt[Bytes]];
    files:   Table[Listed];
}

# a sequence being read: the rows wait for its end
rec Open {
    section: u32;
    start:   u64;
    size:    u64;
    code:    bool;
    placed:  bool;
    rows:    Table[Row];
}

# the line state machine's registers
rec State {
    address:       u64;
    file:          u64;
    line:          i64;
    column:        u64;
    isa:           u64;
    discriminator: u64;
    flags:         model_line.Flags;
}

# in:      the table
# t:       its bytes
# o:       the object the records go to, nil to only ask
# a:       the allocator of what the walk holds
# digests: how many files read state an MD5
# plain:   how many state none
# seqs:    how many sequences it read
rec Walk {
    in:      *Read;
    t:       Reader;
    o:       *Object;
    a:       *A.Allocator;
    digests: usize;
    plain:   usize;
    seqs:    usize;
}

fun undecoded(text: str, at: u64) err[Fail] {
    ret err[Fail].err{fail.at_offset(fail.in_record(fail.malformed(text), "line program"), at)};
}

fun unstated(text: str, at: u64) err[Fail] {
    ret err[Fail].err{fail.at_offset(fail.in_record(fail.unsupported(text), "line program"), at)};
}

# whether the table `in` is decoded and stated by line records whole. a
# program that stops the walk is refused naming its offset, as is a refused
# allocation, and what the model cannot state answers false
pub fun statable(a: *A.Allocator, in: *Read) res[bool, Fail] {
    val r: err[Fail] = walk(a, in, nil);
    if (sel r.ok) { ret res[bool, Fail].ok{true}; }
    val f: Fail = r.err;
    if (sel f.cause.unsupported) { ret res[bool, Fail].ok{false}; }
    ret res[bool, Fail].err{f};
}

# add the records of the table `in`, which `statable` answered for, to `o`
pub fun state(a: *A.Allocator, in: *Read, o: *Object) err[Fail] {
    ret walk(a, in, o);
}

fun walk(a: *A.Allocator, in: *Read, o: *Object) err[Fail] {
    sites.begin(in);
    var w: Walk      = Walk{in: in, t: reader.make("line table", in.bytes.data, in.bytes.len, in.order), o: o, a: a};
    val r: err[Fail] = units(?w);
    if (sel r.err)                      { ret r; }
    if (w.seqs == 0)                    { ret unstated("the table holds no line sequence", 0); }
    if (w.digests != 0 && w.plain != 0) { ret unstated("only some files state an MD5", 0); }
    ret sites.done(in);
}

fun units(w: *Walk) err[Fail] {
    val size: u64 = w.in.bytes.len::u64;
    var at:   u64 = 0;
    for (at < size) {
        val r: res[u64, Fail] = unit(w, at, size);
        if (sel r.err) { ret err[Fail].err{r.err}; }
        at = r.ok;
    }
    ret err[Fail].ok{};
}

# read the unit at `at`, answering the offset past it
fun unit(w: *Walk, at: u64, size: u64) res[u64, Fail] {
    val sk: res[usize, Fail] = reader.seek(?w.t, at);
    if (sel sk.err) { ret res[u64, Fail].err{sk.err}; }
    val short: res[u32, Fail] = reader.u32(?w.t);
    if (sel short.err) { ret res[u64, Fail].err{short.err}; }
    var length: u64 = short.ok::u64;
    var width:  u8  = 4;
    if (short.ok == ESCAPE) {
        val long: res[u64, Fail] = reader.u64(?w.t);
        if (sel long.err) { ret res[u64, Fail].err{long.err}; }
        length = long.ok;
        width  = 8;
    }
    val body: u64            = reader.offset(?w.t);
    val end:  res[u64, Fail] = checked.add(reader.here(?w.t), body, length);
    if (sel end.err)   { ret end; }
    if (end.ok > size) { ret res[u64, Fail].err{fail.at_offset(fail.in_record(fail.malformed("a line table runs past its section"), "line program"), at)}; }
    var u: Unit      = Unit{offset: width, dirs: table.make[opt[Bytes]](w.a), files: table.make[Listed](w.a)};
    var r: err[Fail] = header(w, ?u, end.ok, at);
    val h: bool      = sel r.err;
    if (!h) { r = program(w, ?u, end.ok); }
    r = fail.kept(r, table.release[opt[Bytes]](?u.dirs));
    r = fail.kept(r, table.release[Listed](?u.files));
    if (sel r.err) { ret res[u64, Fail].err{r.err}; }
    ret res[u64, Fail].ok{end.ok};
}

# the header of the unit, leaving the reader at its program
fun header(w: *Walk, u: *Unit, end: u64, at: u64) err[Fail] {
    val t: *Reader        = ?w.t;
    val v: res[u16, Fail] = reader.u16(t);
    if (sel v.err)                                      { ret err[Fail].err{v.err}; }
    if (v.ok < OLDEST_VERSION || v.ok > NEWEST_VERSION) { ret err[Fail].err{fail.valued(fail.at_offset(fail.in_record(fail.malformed("a line table of this version is not decoded"), "line program"), at), v.ok::i128)}; }
    u.version = v.ok;
    if (v.ok >= 5) {
        val sizes: res[*u8, Fail] = reader.bytes(t, 2);
        if (sel sizes.err)    { ret err[Fail].err{sizes.err}; }
        if (sizes.ok[1] != 0) { ret unstated("a line table states segment selectors", at); }
    }
    val hl: res[u64, Fail] = reader.uint(t, u.offset::usize);
    if (sel hl.err) { ret err[Fail].err{hl.err}; }
    val first: res[u64, Fail] = checked.add(reader.here(t), reader.offset(t), hl.ok);
    if (sel first.err)  { ret err[Fail].err{first.err}; }
    if (first.ok > end) { ret undecoded("a line table's header runs past its unit", at); }
    val mins: res[u8, Fail] = reader.u8(t);
    if (sel mins.err) { ret err[Fail].err{mins.err}; }
    u.minimum = mins.ok;
    if (v.ok >= 4) {
        val ops: res[u8, Fail] = reader.u8(t);
        if (sel ops.err) { ret err[Fail].err{ops.err}; }
        if (ops.ok != 1) { ret unstated("a VLIW table's operation index has no form in a row", at); }
    }
    val stmt: res[u8, Fail] = reader.u8(t);
    if (sel stmt.err) { ret err[Fail].err{stmt.err}; }
    u.stmt = stmt.ok != 0;
    val base: res[u8, Fail] = reader.u8(t);
    if (sel base.err) { ret err[Fail].err{base.err}; }
    u.base = base.ok:~i8;
    val range: res[u8, Fail] = reader.u8(t);
    if (sel range.err) { ret err[Fail].err{range.err}; }
    if (range.ok == 0) { ret undecoded("a line table's line range is zero", at); }
    u.range = range.ok;
    val opcode: res[u8, Fail] = reader.u8(t);
    if (sel opcode.err) { ret err[Fail].err{opcode.err}; }
    if (opcode.ok == 0) { ret undecoded("a line table's opcode base is zero", at); }
    u.opcode = opcode.ok;
    val lengths: res[*u8, Fail] = reader.bytes(t, opcode.ok::u64 - 1);
    if (sel lengths.err) { ret err[Fail].err{lengths.err}; }
    u.lengths = lengths.ok;
    var r: err[Fail] = err[Fail].ok{};
    if (v.ok >= 5) { r = tables_v5(w, u, first.ok); }
    or             { r = tables_old(w, u, first.ok); }
    if (sel r.err) { ret r; }
    val sk: res[usize, Fail] = reader.seek(t, first.ok);
    if (sel sk.err) { ret err[Fail].err{sk.err}; }
    ret err[Fail].ok{};
}

# the NUL-terminated string at the reader, which must end before `end`
fun string(t: *Reader, end: u64) res[Bytes, Fail] {
    val at: u64 = reader.offset(t);
    for {
        if (reader.offset(t) >= end) { ret res[Bytes, Fail].err{fail.at_offset(fail.in_record(fail.malformed("a string runs past the line table's header"), "line program"), at)}; }
        val c: res[u8, Fail] = reader.u8(t);
        if (sel c.err) { ret res[Bytes, Fail].err{c.err}; }
        if (c.ok == 0) { brk; }
    }
    ret res[Bytes, Fail].ok{Bytes{data: ?t.data[(at - t.base)::usize], len: (reader.offset(t) - at - 1)::usize}};
}

# the directory of an old table's index `at`: none for the producer's own at
# zero, and refused for one past the table
fun old_directory(u: *Unit, index: u64, at: u64) res[opt[Bytes], Fail] {
    if (index == 0)                                    { ret res[opt[Bytes], Fail].ok{opt[Bytes].none{}}; }
    if (index > table.count[opt[Bytes]](?u.dirs)::u64) { ret res[opt[Bytes], Fail].err{fail.at_offset(fail.in_record(fail.malformed("a file names a directory past the table"), "line program"), at)}; }
    ret res[opt[Bytes], Fail].ok{table.items[opt[Bytes]](?u.dirs)[(index - 1)::usize]};
}

# one file entry of an old table, its name read, at the reader
fun old_file(w: *Walk, u: *Unit, name: Bytes) err[Fail] {
    val t:  *Reader        = ?w.t;
    val at: u64            = reader.offset(t);
    val d:  res[u64, Fail] = reader.uleb(t);
    if (sel d.err) { ret err[Fail].err{d.err}; }
    val m: res[u64, Fail] = reader.uleb(t);
    if (sel m.err) { ret err[Fail].err{m.err}; }
    val s: res[u64, Fail] = reader.uleb(t);
    if (sel s.err) { ret err[Fail].err{s.err}; }
    val dir: res[opt[Bytes], Fail] = old_directory(u, d.ok, at);
    if (sel dir.err) { ret err[Fail].err{dir.err}; }
    ret listed(w, u, Listed{name: name, directory: dir.ok, md5: opt[Md5].none{}});
}

# the directory and file tables of a version 2 to 4 header. its file numbers
# start at one
fun tables_old(w: *Walk, u: *Unit, end: u64) err[Fail] {
    val t: *Reader = ?w.t;
    for {
        val n: res[Bytes, Fail] = string(t, end);
        if (sel n.err)     { ret err[Fail].err{n.err}; }
        if (n.ok.len == 0) { brk; }
        val p: res[Id[opt[Bytes]], Fail] = table.push[opt[Bytes]](?u.dirs, opt[Bytes].some{n.ok});
        if (sel p.err) { ret err[Fail].err{p.err}; }
    }
    for {
        val n: res[Bytes, Fail] = string(t, end);
        if (sel n.err)     { ret err[Fail].err{n.err}; }
        if (n.ok.len == 0) { brk; }
        val f: err[Fail] = old_file(w, u, n.ok);
        if (sel f.err) { ret f; }
    }
    ret err[Fail].ok{};
}

# the entry formats a version 5 table states, into `out`, answering how many
fun formats(t: *Reader, out: *Format, at: u64) res[usize, Fail] {
    val n: res[u8, Fail] = reader.u8(t);
    if (sel n.err)                 { ret res[usize, Fail].err{n.err}; }
    if (n.ok::usize > FORMATS_MAX) { ret res[usize, Fail].err{fail.at_offset(fail.in_record(fail.unsupported("a line table states more entry formats than any content type"), "line program"), at)}; }
    var i: usize = 0;
    for (i < n.ok::usize) {
        val c: res[u64, Fail] = reader.uleb(t);
        if (sel c.err) { ret res[usize, Fail].err{c.err}; }
        val f: res[u64, Fail] = reader.uleb(t);
        if (sel f.err) { ret res[usize, Fail].err{f.err}; }
        out[i] = Format{content: c.ok, form: f.ok};
        i      = i + 1;
    }
    ret res[usize, Fail].ok{n.ok::usize};
}

# the text the string form `form` names at the reader
fun text(w: *Walk, u: *Unit, form: u64, end: u64) res[Bytes, Fail] {
    val t:  *Reader = ?w.t;
    val at: u64     = reader.offset(t);
    if (form == line.DW_FORM_STRING)                       { ret string(t, end); }
    if (form != DW_FORM_LINE_STRP && form != DW_FORM_STRP) { ret res[Bytes, Fail].err{fail.valued(fail.at_offset(fail.in_record(fail.unsupported("a file table names a string by a form that is not read"), "line program"), at), form::i128)}; }
    val value: res[u64, Fail] = reader.uint(t, u.offset::usize);
    if (sel value.err) { ret res[Bytes, Fail].err{value.err}; }
    val p: res[opt[*Patch], Fail] = sites.plain(w.in, at);
    if (sel p.err) { ret res[Bytes, Fail].err{p.err}; }
    var held:   opt[Bytes] = opt[Bytes].none{};
    var offset: u64        = value.ok;
    if (sel p.ok.some) {
        val l: opt[Located] = sites.target(w.in, p.ok.some);
        if (sel l.some) {
            held   = w.in.source.contents(w.in.source.ctx, l.some.section);
            offset = l.some.offset;
        }
    }
    or (form == DW_FORM_LINE_STRP) { held = w.in.source.by_name(w.in.source.ctx, ".debug_line_str"); }
    or                             { held = w.in.source.by_name(w.in.source.ctx, ".debug_str"); }
    if (sel held.none)             { ret res[Bytes, Fail].err{fail.at_offset(fail.in_record(fail.unsupported("a file table names a string in a section not held plain"), "line program"), at)}; }
    val b:    Bytes = held.some;
    var last: u64   = offset;
    for (last < b.len::u64 && b.data[last::usize] != 0) { last = last + 1; }
    if (last >= b.len::u64) { ret res[Bytes, Fail].err{fail.at_offset(fail.in_record(fail.malformed("a file table's string lies past its section"), "line program"), at)}; }
    ret res[Bytes, Fail].ok{Bytes{data: ?b.data[offset::usize], len: (last - offset)::usize}};
}

# the number the data form `form` holds at the reader
fun number(t: *Reader, form: u64, at: u64) res[u64, Fail] {
    if (form == line.DW_FORM_UDATA) { ret reader.uleb(t); }
    if (form == DW_FORM_DATA1)      { ret reader.uint(t, 1); }
    if (form == DW_FORM_DATA2)      { ret reader.uint(t, 2); }
    if (form == DW_FORM_DATA4)      { ret reader.uint(t, 4); }
    if (form == DW_FORM_DATA8)      { ret reader.uint(t, 8); }
    ret res[u64, Fail].err{fail.valued(fail.at_offset(fail.in_record(fail.unsupported("a file table states a number by a form that is not read"), "line program"), at), form::i128)};
}

# step past a value of `form` nothing here reads
fun skip(w: *Walk, u: *Unit, form: u64, end: u64) err[Fail] {
    val t:  *Reader = ?w.t;
    val at: u64     = reader.offset(t);
    if (form == line.DW_FORM_STRING || form == DW_FORM_LINE_STRP || form == DW_FORM_STRP) {
        val s: res[Bytes, Fail] = text(w, u, form, end);
        if (sel s.err) { ret err[Fail].err{s.err}; }
        ret err[Fail].ok{};
    }
    var n: res[u64, Fail] = res[u64, Fail].ok{16};
    if (form == DW_FORM_BLOCK)  { n = reader.uleb(t); }
    or (form == DW_FORM_BLOCK1) { n = reader.uint(t, 1); }
    or (form == DW_FORM_BLOCK2) { n = reader.uint(t, 2); }
    or (form == DW_FORM_BLOCK4) { n = reader.uint(t, 4); }
    or (form != line.DW_FORM_DATA16) {
        val v: res[u64, Fail] = number(t, form, at);
        if (sel v.err) { ret err[Fail].err{v.err}; }
        ret err[Fail].ok{};
    }
    if (sel n.err) { ret err[Fail].err{n.err}; }
    val b: res[*u8, Fail] = reader.bytes(t, n.ok);
    if (sel b.err) { ret err[Fail].err{b.err}; }
    ret err[Fail].ok{};
}

# one entry of a version 5 table, as its `n` formats at `f` state it
# ---
# name: its path
# dir:  its directory index
# md5:  its digest
rec Entry {
    name: opt[Bytes];
    dir:  u64;
    md5:  opt[Md5];
}

fun entry(w: *Walk, u: *Unit, f: *Format, n: usize, end: u64) res[Entry, Fail] {
    val t:   *Reader = ?w.t;
    var out: Entry   = Entry{name: opt[Bytes].none{}, md5: opt[Md5].none{}};
    var i:   usize   = 0;
    for (i < n) {
        val c:  Format = f[i];
        val at: u64    = reader.offset(t);
        i = i + 1;
        if (c.content == line.DW_LNCT_PATH) {
            val s: res[Bytes, Fail] = text(w, u, c.form, end);
            if (sel s.err) { ret res[Entry, Fail].err{s.err}; }
            out.name = opt[Bytes].some{s.ok};
        }
        or (c.content == line.DW_LNCT_DIRECTORY_INDEX) {
            val v: res[u64, Fail] = number(t, c.form, at);
            if (sel v.err) { ret res[Entry, Fail].err{v.err}; }
            out.dir = v.ok;
        }
        or (c.content == line.DW_LNCT_MD5 && c.form == line.DW_FORM_DATA16) {
            val b: res[*u8, Fail] = reader.bytes(t, 16);
            if (sel b.err) { ret res[Entry, Fail].err{b.err}; }
            var m: Md5;
            var k: usize = 0;
            for (k < 16) {
                m.bytes[k] = b.ok[k];
                k          = k + 1;
            }
            out.md5 = opt[Md5].some{m};
        }
        or {
            val r: err[Fail] = skip(w, u, c.form, end);
            if (sel r.err) { ret res[Entry, Fail].err{r.err}; }
        }
    }
    ret res[Entry, Fail].ok{out};
}

# the directory and file tables of a version 5 header. directory 0 is the
# producer's own, named unless it is empty, and file numbers start at zero
fun tables_v5(w: *Walk, u: *Unit, end: u64) err[Fail] {
    val t:  *Reader          = ?w.t;
    val at: u64              = reader.offset(t);
    var f:  [FORMATS_MAX]Format;
    val nd: res[usize, Fail] = formats(t, ?f[0], at);
    if (sel nd.err) { ret err[Fail].err{nd.err}; }
    val dirs: res[u64, Fail] = reader.uleb(t);
    if (sel dirs.err) { ret err[Fail].err{dirs.err}; }
    var i: u64 = 0;
    for (i < dirs.ok) {
        val e: res[Entry, Fail] = entry(w, u, ?f[0], nd.ok, end);
        if (sel e.err) { ret err[Fail].err{e.err}; }
        var named: opt[Bytes] = e.ok.name;
        if (sel named.some && named.some.len == 0) { named = opt[Bytes].none{}; }
        val p: res[Id[opt[Bytes]], Fail] = table.push[opt[Bytes]](?u.dirs, named);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    val nf: res[usize, Fail] = formats(t, ?f[0], at);
    if (sel nf.err) { ret err[Fail].err{nf.err}; }
    val files: res[u64, Fail] = reader.uleb(t);
    if (sel files.err) { ret err[Fail].err{files.err}; }
    i = 0;
    for (i < files.ok) {
        val where: u64              = reader.offset(t);
        val e:     res[Entry, Fail] = entry(w, u, ?f[0], nf.ok, end);
        if (sel e.err)                                         { ret err[Fail].err{e.err}; }
        if (sel e.ok.name.none)                                { ret undecoded("a file entry states no path", where); }
        if (e.ok.dir >= table.count[opt[Bytes]](?u.dirs)::u64) { ret undecoded("a file names a directory past the table", where); }
        val r: err[Fail] = listed(w, u, Listed{name: e.ok.name.some, directory: table.items[opt[Bytes]](?u.dirs)[e.ok.dir::usize], md5: e.ok.md5});
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# keep the file `l` of the unit, the object's file of its directory and name
# when the walk has an object
fun listed(w: *Walk, u: *Unit, l: Listed) err[Fail] {
    var e: Listed = l;
    if (sel e.md5.some) { w.digests = w.digests + 1; }
    or                  { w.plain = w.plain + 1; }
    if (w.o != nil) {
        val id: res[Id[File], Fail] = objects_file(w.o, ?e);
        if (sel id.err) { ret err[Fail].err{id.err}; }
        e.id = id.ok;
    }
    val p: res[Id[Listed], Fail] = table.push[Listed](?u.files, e);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

fun objects_file(o: *Object, l: *Listed) res[Id[File], Fail] {
    val n: res[Id[Name], Fail] = object.name(o, l.name.data, l.name.len);
    if (sel n.err) { ret res[Id[File], Fail].err{n.err}; }
    var d: opt[Id[Name]] = opt[Id[Name]].none{};
    if (sel l.directory.some) {
        val dn: res[Id[Name], Fail] = object.name(o, l.directory.some.data, l.directory.some.len);
        if (sel dn.err) { ret res[Id[File], Fail].err{dn.err}; }
        d = opt[Id[Name]].some{dn.ok};
    }
    val held: opt[Id[File]] = object.file_named(o, d, n.ok);
    if (sel held.some) { ret res[Id[File], Fail].ok{held.some}; }
    ret object.add_file(o, File{directory: d, name: n.ok, md5: l.md5});
}

# the registers a sequence starts with, as the unit's header states them
fun fresh(u: *Unit) State {
    var s: State = State{file: 1, line: 1};
    if (u.stmt) { s.flags = model_line.STATEMENT; }
    ret s;
}

# take a row of the registers `s`, and clear what a row clears
fun row(w: *Walk, u: *Unit, q: *Open, s: *State, at: u64) err[Fail] {
    if (!q.placed)                          { ret unstated("no relocation places a row of the sequence", at); }
    if (s.line < 0 || s.line > 0xffff_ffff) { ret undecoded("a row's line is wider than a line", at); }
    if (s.column > 0xffff_ffff)             { ret undecoded("a row's column is wider than a column", at); }
    if (s.isa > 0xffff_ffff)                { ret undecoded("a row's instruction set is wider than a number", at); }
    if (s.discriminator > 0xffff_ffff)      { ret undecoded("a row's discriminator is wider than a number", at); }
    var index: u64 = s.file;
    if (u.version < 5) {
        if (index == 0) { ret undecoded("a row names file zero of a table that numbers files from one", at); }
        index = index - 1;
    }
    if (index >= table.count[Listed](?u.files)::u64) { ret undecoded("a row names a file past the table", at); }
    val n: usize = table.count[Row](?q.rows);
    if (s.address > q.size)                                        { ret unstated("a row lies past the end of its section", at); }
    if (n != 0 && s.address < table.items[Row](?q.rows)[n - 1].at) { ret unstated("a row lies below the row before it", at); }
    if (s.address < q.start)                                       { ret unstated("a row lies before its sequence", at); }
    val file: Id[File]           = table.items[Listed](?u.files)[index::usize].id;
    val p:    res[Id[Row], Fail] = table.push[Row](?q.rows, Row{at: s.address, file: file, line: s.line::u32, column: s.column::u32, end_column: opt[u32].none{}, flags: s.flags, isa: s.isa::u32, discriminator: s.discriminator::u32});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    s.discriminator = 0;
    s.flags         = s.flags & model_line.STATEMENT;
    ret err[Fail].ok{};
}

# close the sequence `q` at the address of `s`
fun ended(w: *Walk, q: *Open, s: *State, at: u64) err[Fail] {
    if (!q.placed)          { ret unstated("no relocation places the sequence", at); }
    if (!q.code)            { ret unstated("the sequence is over a section that is not code", at); }
    if (s.address > q.size) { ret unstated("the sequence ends past the end of its section", at); }
    w.seqs = w.seqs + 1;
    if (w.o == nil) {
        table.truncate[Row](?q.rows, 0);
        q.placed = false;
        ret err[Fail].ok{};
    }
    val sec: opt[Id[Section]] = w.in.source.section(w.in.source.ctx, q.section);
    if (sel sec.none) { ret err[Fail].err{fail.at_offset(fail.internal("a sequence's section was read into no neutral section"), at)}; }
    val id: res[Id[Sequence], Fail] = object.add_sequence(w.o, Place{section: sec.some, offset: q.start}, s.address);
    if (sel id.err) { ret err[Fail].err{id.err}; }
    var i: usize = 0;
    for (i < table.count[Row](?q.rows)) {
        val r: res[Id[Row], Fail] = object.add_row(w.o, id.ok, table.items[Row](?q.rows)[i]);
        if (sel r.err) { ret err[Fail].err{r.err}; }
        i = i + 1;
    }
    table.truncate[Row](?q.rows, 0);
    q.placed = false;
    ret err[Fail].ok{};
}

# move the address of `s` on by `by`, which relocation does not move
fun moved(s: *State, by: u64, at: u64) err[Fail] {
    val to: res[u64, Fail] = checked.add(Location{record: "line program", offset: at, placed: true}, s.address, by);
    if (sel to.err) { ret err[Fail].err{to.err}; }
    s.address = to.ok;
    ret err[Fail].ok{};
}

fun factored(u: *Unit, by: u64, at: u64) res[u64, Fail] {
    ret checked.mul(Location{record: "line program", offset: at, placed: true}, by, u.minimum::u64);
}

# the address DW_LNE_set_address at `field` of `size` bytes names, on the
# sequence `q` and the registers `s`
fun set_address(w: *Walk, q: *Open, s: *State, field: u64, size: u64) err[Fail] {
    if (size == 0 || size > 8) { ret undecoded("an address of no width an address has", field); }
    val value: res[u64, Fail] = reader.uint(?w.t, size::usize);
    if (sel value.err) { ret err[Fail].err{value.err}; }
    val p: res[opt[*Patch], Fail] = sites.plain(w.in, field);
    if (sel p.err)     { ret err[Fail].err{p.err}; }
    if (sel p.ok.none) { ret unstated("no relocation places a sequence", field); }
    val l: opt[Located] = sites.target(w.in, p.ok.some);
    if (sel l.none)                              { ret unstated("a sequence lies in no section of the object", field); }
    if (q.placed && q.section != l.some.section) { ret unstated("a sequence crosses sections", field); }
    if (!q.placed) {
        q.section = l.some.section;
        q.start   = l.some.offset;
        q.size    = l.some.size;
        q.code    = l.some.code;
        q.placed  = true;
    }
    s.address = l.some.offset;
    ret err[Fail].ok{};
}

# the extended opcode at the reader, its marker read
fun extended(w: *Walk, u: *Unit, q: *Open, s: *State, end: u64) res[bool, Fail] {
    val t:  *Reader        = ?w.t;
    val at: u64            = reader.offset(t);
    val n:  res[u64, Fail] = reader.uleb(t);
    if (sel n.err) { ret res[bool, Fail].err{n.err}; }
    if (n.ok == 0) { ret res[bool, Fail].err{fail.at_offset(fail.in_record(fail.malformed("an extended opcode has no length"), "line program"), at)}; }
    val body: u64 = reader.offset(t);
    if (n.ok > end - body) { ret res[bool, Fail].err{fail.at_offset(fail.in_record(fail.malformed("an extended opcode runs past its unit"), "line program"), at)}; }
    val op: res[u8, Fail] = reader.u8(t);
    if (sel op.err) { ret res[bool, Fail].err{op.err}; }
    val next:   u64       = body + n.ok;
    var closed: bool      = false;
    var r:      err[Fail] = err[Fail].ok{};
    if (op.ok == line.DW_LNE_END_SEQUENCE) {
        r      = ended(w, q, s, at);
        closed = true;
    }
    or (op.ok == line.DW_LNE_SET_ADDRESS) { r = set_address(w, q, s, body + 1, n.ok - 1); }
    or (op.ok == line.DW_LNE_SET_DISCRIMINATOR) {
        val d: res[u64, Fail] = reader.uleb(t);
        if (sel d.err) { ret res[bool, Fail].err{d.err}; }
        s.discriminator = d.ok;
    }
    or (op.ok == DW_LNE_DEFINE_FILE && u.version < 5) {
        val name: res[Bytes, Fail] = string(t, next);
        if (sel name.err) { ret res[bool, Fail].err{name.err}; }
        r = old_file(w, u, name.ok);
    }
    if (sel r.err) { ret res[bool, Fail].err{r.err}; }
    val sk: res[usize, Fail] = reader.seek(t, next - t.base);
    if (sel sk.err) { ret res[bool, Fail].err{sk.err}; }
    ret res[bool, Fail].ok{closed};
}

# the standard opcode `op` at `at`
fun standard(w: *Walk, u: *Unit, q: *Open, s: *State, op: u8, at: u64) err[Fail] {
    val t: *Reader = ?w.t;
    if (op == line.DW_LNS_COPY) { ret row(w, u, q, s, at); }
    if (op == line.DW_LNS_ADVANCE_PC) {
        val n: res[u64, Fail] = reader.uleb(t);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        val by: res[u64, Fail] = factored(u, n.ok, at);
        if (sel by.err) { ret err[Fail].err{by.err}; }
        ret moved(s, by.ok, at);
    }
    if (op == line.DW_LNS_ADVANCE_LINE) {
        val n: res[i64, Fail] = reader.sleb(t);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        s.line = s.line + n.ok;
        ret err[Fail].ok{};
    }
    if (op == line.DW_LNS_SET_FILE || op == line.DW_LNS_SET_COLUMN || op == line.DW_LNS_SET_ISA) {
        val n: res[u64, Fail] = reader.uleb(t);
        if (sel n.err)                    { ret err[Fail].err{n.err}; }
        if (op == line.DW_LNS_SET_FILE)   { s.file = n.ok; }
        or (op == line.DW_LNS_SET_COLUMN) { s.column = n.ok; }
        or                                { s.isa = n.ok; }
        ret err[Fail].ok{};
    }
    if (op == line.DW_LNS_NEGATE_STMT) {
        s.flags = s.flags ^ model_line.STATEMENT;
        ret err[Fail].ok{};
    }
    if (op == line.DW_LNS_SET_BASIC_BLOCK) {
        s.flags = s.flags | model_line.BLOCK;
        ret err[Fail].ok{};
    }
    if (op == line.DW_LNS_SET_PROLOGUE_END) {
        s.flags = s.flags | model_line.PROLOGUE_END;
        ret err[Fail].ok{};
    }
    if (op == line.DW_LNS_SET_EPILOGUE_BEGIN) {
        s.flags = s.flags | model_line.EPILOGUE_BEGIN;
        ret err[Fail].ok{};
    }
    if (op == line.DW_LNS_CONST_ADD_PC) {
        val adjusted: u64            = (255 - u.opcode::u64) / u.range::u64;
        val by:       res[u64, Fail] = factored(u, adjusted, at);
        if (sel by.err) { ret err[Fail].err{by.err}; }
        ret moved(s, by.ok, at);
    }
    if (op == line.DW_LNS_FIXED_ADVANCE_PC) {
        val field: u64            = reader.offset(t);
        val n:     res[u64, Fail] = reader.uint(t, 2);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        val d: res[opt[u64], Fail] = sites.distance(w.in, field);
        if (sel d.err)     { ret err[Fail].err{d.err}; }
        if (sel d.ok.some) { ret moved(s, d.ok.some, at); }
        ret moved(s, n.ok, at);
    }
    var left: u8 = u.lengths[op::usize - 1];
    for (left != 0) {
        val n: res[u64, Fail] = reader.uleb(t);
        if (sel n.err) { ret err[Fail].err{n.err}; }
        left = left - 1;
    }
    ret err[Fail].ok{};
}

# the special opcode `op` at `at`
fun special(w: *Walk, u: *Unit, q: *Open, s: *State, op: u8, at: u64) err[Fail] {
    val adjusted: u64            = op::u64 - u.opcode::u64;
    val by:       res[u64, Fail] = factored(u, adjusted / u.range::u64, at);
    if (sel by.err) { ret err[Fail].err{by.err}; }
    val m: err[Fail] = moved(s, by.ok, at);
    if (sel m.err) { ret m; }
    s.line = s.line + u.base::i64 + (adjusted % u.range::u64)::i64;
    ret row(w, u, q, s, at);
}

# run the unit's program up to `end`
fun program(w: *Walk, u: *Unit, end: u64) err[Fail] {
    var q: Open      = Open{rows: table.make[Row](w.a)};
    var r: err[Fail] = run(w, u, ?q, end);
    ret fail.kept(r, table.release[Row](?q.rows));
}

fun run(w: *Walk, u: *Unit, q: *Open, end: u64) err[Fail] {
    val t:    *Reader = ?w.t;
    var s:    State   = fresh(u);
    var open: bool    = false;
    for (reader.offset(t) < end) {
        val at: u64           = reader.offset(t);
        val b:  res[u8, Fail] = reader.u8(t);
        if (sel b.err) { ret err[Fail].err{b.err}; }
        open = true;
        if (b.ok >= u.opcode) {
            val e: err[Fail] = special(w, u, q, ?s, b.ok, at);
            if (sel e.err) { ret e; }
            cnt;
        }
        if (b.ok != 0) {
            val e: err[Fail] = standard(w, u, q, ?s, b.ok, at);
            if (sel e.err) { ret e; }
            cnt;
        }
        val x: res[bool, Fail] = extended(w, u, q, ?s, end);
        if (sel x.err) { ret err[Fail].err{x.err}; }
        if (x.ok) {
            s    = fresh(u);
            open = false;
        }
    }
    if (open) { ret undecoded("a line sequence does not end", end); }
    ret err[Fail].ok{};
}
