# what a relocation of unwind data names for a place in a function's code
#
# one rule for every unwind table on every format: a table's row states
# whether a place in its function's fixed code is named by the function's
# own symbol or by the symbol of the function's section, as the format's
# assembler names it, the place's distance from that symbol in the addend.
# no symbol is made for the place itself. over code the linker may resize
# a place has no fixed distance from either, so an encoder that writes
# distances there names a label of its own at it, which the linker moves
# with the code.

use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.lower.lowered.Aim;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Symbol;

# section:  the symbol of the function's section, the place's offset in it
#           the addend, as llvm-mc names a place it holds a temporary label at
# function: the function's own symbol, the place's distance from it the
#           addend, as llvm-mc names a place a Mach-O difference reaches
pub tag Anchor: u8 {
    section;
    function;
}

# target: what the relocation computes from
# addend: what it adds to it
pub rec Aimed {
    target: Aim;
    addend: i64;
}

# what `a` names for the place `p` in the fixed code of the function
# `function` of `o`. refused as malformed for a function defined in no
# section or in another than `p`'s, and as overflow for a distance an addend
# does not hold
pub fun of(o: *Object, a: Anchor, function: Id[Symbol], p: Place) res[Aimed, Fail] {
    if (sel a.section) {
        if (p.offset > 0x7fff_ffff_ffff_ffff) { ret res[Aimed, Fail].err{fail.valued(fail.overflow("the place lies past what an addend holds"), p.offset::i128)}; }
        ret res[Aimed, Fail].ok{Aimed{target: Aim.section{p.section}, addend: p.offset::i64}};
    }
    if (function.index::usize >= table.count[Symbol](?o.symbols)) { ret res[Aimed, Fail].err{fail.malformed("the frame names a function the object does not have")}; }
    val d: object.Definition = object.symbol_at(o, function).def;
    if (!sel d.placed)                             { ret res[Aimed, Fail].err{fail.malformed("the frame's function is placed in no section")}; }
    if (d.placed.section.index != p.section.index) { ret res[Aimed, Fail].err{fail.malformed("the place lies outside its function's section")}; }
    val distance: i128 = p.offset::i128 - d.placed.offset::i128;
    if (distance < -0x8000_0000_0000_0000 || distance > 0x7fff_ffff_ffff_ffff) { ret res[Aimed, Fail].err{fail.valued(fail.overflow("the place lies past what an addend holds from its function"), distance)}; }
    ret res[Aimed, Fail].ok{Aimed{target: Aim.symbol{function}, addend: distance::i64}};
}
