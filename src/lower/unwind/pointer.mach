# DWARF pointer encodings, the DW_EH_PE byte an .eh_frame CIE states its
# pointers in, and how a destination relocates a pointer field
#
# the byte's low four bits are how a value is stored, its next three what it
# is relative to, and its top bit whether it is the address of a slot that
# holds the pointer, as the LSB's exception frames define them. 0xff states
# no pointer. each code is one row here, and a destination's table lists the
# rows it writes and reads, so the frame encoder, a reader of the table and
# an assembler that parses `.cfi_personality` read the byte through one
# table.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;

# how many bytes a stored value takes
# ---
# address: an address of the target
# fixed:   this many
# leb:     a LEB128, as many as its value needs
pub tag Width: u8 {
    address;
    fixed: u8;
    leb;
}

# how a value is stored, the byte's low four bits
pub rec Format {
    name:   str;
    code:   u8;
    width:  Width;
    signed: bool;
}

pub val ABSPTR:  Format = Format{name: "DW_EH_PE_absptr", code: 0x00, width: Width.address{}, signed: false};
pub val ULEB128: Format = Format{name: "DW_EH_PE_uleb128", code: 0x01, width: Width.leb{}, signed: false};
pub val UDATA2:  Format = Format{name: "DW_EH_PE_udata2", code: 0x02, width: Width.fixed{2}, signed: false};
pub val UDATA4:  Format = Format{name: "DW_EH_PE_udata4", code: 0x03, width: Width.fixed{4}, signed: false};
pub val UDATA8:  Format = Format{name: "DW_EH_PE_udata8", code: 0x04, width: Width.fixed{8}, signed: false};
pub val SLEB128: Format = Format{name: "DW_EH_PE_sleb128", code: 0x09, width: Width.leb{}, signed: true};
pub val SDATA2:  Format = Format{name: "DW_EH_PE_sdata2", code: 0x0a, width: Width.fixed{2}, signed: true};
pub val SDATA4:  Format = Format{name: "DW_EH_PE_sdata4", code: 0x0b, width: Width.fixed{4}, signed: true};
pub val SDATA8:  Format = Format{name: "DW_EH_PE_sdata8", code: 0x0c, width: Width.fixed{8}, signed: true};

# what a value is relative to, the byte's bits 4 through 6
pub rec Base {
    name: str;
    code: u8;
}

pub val ABSOLUTE: Base = Base{name: "absolute", code: 0x00};
pub val PCREL:    Base = Base{name: "DW_EH_PE_pcrel", code: 0x10};
pub val TEXTREL:  Base = Base{name: "DW_EH_PE_textrel", code: 0x20};
pub val DATAREL:  Base = Base{name: "DW_EH_PE_datarel", code: 0x30};
pub val FUNCREL:  Base = Base{name: "DW_EH_PE_funcrel", code: 0x40};
pub val ALIGNED:  Base = Base{name: "DW_EH_PE_aligned", code: 0x50};

# the value is the address of a slot that holds the pointer
pub val INDIRECT: u8 = 0x80;
# no pointer follows
pub val OMIT: u8 = 0xff;

val FORMAT_BITS: u8 = 0x0f;
val BASE_BITS:   u8 = 0x70;

# a pointer encoding
pub rec Encoding {
    format:   *Format;
    base:     *Base;
    indirect: bool;
}

# the encodings a destination writes and reads
# ---
# formats:      the formats, static
# format_count: how many
# bases:        the bases, static
# base_count:   how many
# indirect:     whether it states a pointer through a slot holding it
pub rec Encodings {
    formats:      **Format;
    format_count: usize;
    bases:        **Base;
    base_count:   usize;
    indirect:     bool;
}

# how a destination relocates a pointer field
# ---
# kind:       a relocation of the absolute or the place-relative kind of the
#             field's width, as the encoding's base states
# difference: the target less a label at the field, the set's difference of
#             the field's width, for a place-relative base
pub tag Relocated: u8 {
    kind;
    difference;
}

# a pointer field a destination writes: its encoding and how it is relocated
pub rec Field {
    encoding:  Encoding;
    relocated: Relocated;
}

# the byte that states `e`
pub fun code(e: Encoding) u8 {
    var b: u8 = e.format.code | e.base.code;
    if (e.indirect) { b = b | INDIRECT; }
    ret b;
}

# whether `t` lists the format and base of `e`, and a slot when `e` states one
pub fun admits(t: *Encodings, e: Encoding) bool {
    if (e.indirect && !t.indirect) { ret false; }
    ret format_of(t, e.format.code) == e.format && base_of(t, e.base.code) == e.base;
}

fun format_of(t: *Encodings, c: u8) *Format {
    var i: usize = 0;
    for (i < t.format_count) {
        if (t.formats[i].code == c) { ret t.formats[i]; }
        i = i + 1;
    }
    ret nil;
}

fun base_of(t: *Encodings, c: u8) *Base {
    var i: usize = 0;
    for (i < t.base_count) {
        if (t.bases[i].code == c) { ret t.bases[i]; }
        i = i + 1;
    }
    ret nil;
}

# the encoding `t` reads the byte `b` as, none for DW_EH_PE_omit. a byte of
# a format, a base or a slot `t` does not list is refused naming the byte
pub fun decode(t: *Encodings, b: u8) res[opt[Encoding], Fail] {
    if (b == OMIT) { ret res[opt[Encoding], Fail].ok{opt[Encoding].none{}}; }
    val f: *Format = format_of(t, b & FORMAT_BITS);
    if (f == nil) { ret res[opt[Encoding], Fail].err{fail.valued(fail.unsupported("the pointer encoding states a format the table does not list"), b::i128)}; }
    val base: *Base = base_of(t, b & BASE_BITS);
    if (base == nil) { ret res[opt[Encoding], Fail].err{fail.valued(fail.unsupported("the pointer encoding states a base the table does not list"), b::i128)}; }
    val indirect: bool = (b & INDIRECT) != 0;
    if (indirect && !t.indirect) { ret res[opt[Encoding], Fail].err{fail.valued(fail.unsupported("the pointer encoding states a slot the table does not read"), b::i128)}; }
    ret res[opt[Encoding], Fail].ok{opt[Encoding].some{Encoding{format: f, base: base, indirect: indirect}}};
}

# the bytes a value of `f` takes for a target of `address`-byte addresses,
# none for a LEB128, whose length its value decides
pub fun bytes(f: *Format, address: u8) opt[u8] {
    ret bytes_of(f.width, address);
}

# the bytes `w` takes for a target of `address`-byte addresses, none for a
# LEB128
pub fun bytes_of(w: Width, address: u8) opt[u8] {
    if (sel w.address) { ret opt[u8].some{address}; }
    or (sel w.fixed)   { ret opt[u8].some{w.fixed}; }
    ret opt[u8].none{};
}

# every format and base the LSB defines
val FORMATS: [9]*Format = [9]*Format{?ABSPTR, ?ULEB128, ?UDATA2, ?UDATA4, ?UDATA8, ?SLEB128, ?SDATA2, ?SDATA4, ?SDATA8};
val BASES:   [6]*Base   = [6]*Base{?ABSOLUTE, ?PCREL, ?TEXTREL, ?DATAREL, ?FUNCREL, ?ALIGNED};

# every DW_EH_PE code, which a runtime unwinder's table reads
pub val EH: Encodings = Encodings{formats: ?FORMATS[0], format_count: 9, bases: ?BASES[0], base_count: 6, indirect: true};

# the one encoding a debugger's table writes: an absolute address, with no
# byte that states it
val     ABSOLUTE_ONLY: [1]*Base   = [1]*Base{?ABSOLUTE};
val     ADDRESS_ONLY:  [1]*Format = [1]*Format{?ABSPTR};
pub val DEBUG:         Encodings  = Encodings{formats: ?ADDRESS_ONLY[0], format_count: 1, bases: ?ABSOLUTE_ONLY[0], base_count: 1, indirect: false};
