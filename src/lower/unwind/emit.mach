# what an unwind form writes for one function and how it relocates it
#
# a form writes a function's unwind data into the object's unwind data
# section and names, per region of the function, what the region's function
# table entry points at: unwind data at an offset of that section, or unwind
# data packed into the entry itself. every address it writes is an image
# relative one, relocated by the target's image relative kind.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.lower.lowered;
use mink.lower.lowered.Added;
use mink.lower.lowered.Aim;
use mink.lower.lowered.Fixup;
use mink.lower.lowered.Lowered;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.reloc.Kind;

# what a function table entry points at
# ---
# xdata:  unwind data at this offset of the unwind data section
# packed: unwind data packed into the entry's unwind word, its flag bits set
pub tag Unwind: u8 {
    xdata:  u64;
    packed: u32;
}

# a stretch of a function one function table entry covers, from `begin` up
# to `end`, both relative to the function's start
pub rec Region {
    begin:  u64;
    end:    u64;
    unwind: Unwind;
}

# o:       the object
# out:     the record the relocations are added to
# xdata:   the unwind data section's bytes
# section: the id the unwind data section has in `out`
# rva:     the image relative kind
# code:    the section of the function
# start:   the offset in it where the function starts
# regions: the regions the form names, in ascending order
pub rec Out {
    o:       *Object;
    out:     *Lowered;
    xdata:   *Sink;
    section: Id[Added];
    rva:     *Kind;
    code:    Id[Section];
    start:   u64;
    regions: *Table[Region];
}

# a four byte image relative address of `target` plus `addend`, written to
# `s`, the bytes of the added section `sec`
pub fun rva(low: *Lowered, sec: Id[Added], s: *Sink, kind: *Kind, target: Aim, addend: i64) err[Fail] {
    val f: res[Id[Fixup], Fail] = lowered.add_fixup(low, Fixup{section: sec, offset: sink.len(s)::u64, kind: kind, target: target, minus: opt[Aim].none{}, addend: addend});
    if (sel f.err) { ret err[Fail].err{f.err}; }
    ret sink.u32(s, 0);
}

# what an address `at` bytes into the function aims at
pub fun code(c: *Out, at: u64) res[Aim, Fail] {
    val l: res[Id[Place], Fail] = lowered.label(c.out, Place{section: c.code, offset: c.start + at});
    if (sel l.err) { ret res[Aim, Fail].err{l.err}; }
    ret res[Aim, Fail].ok{Aim.label{l.ok}};
}

# the address `at` bytes into the function, written to the unwind data
pub fun code_rva(c: *Out, at: u64) err[Fail] {
    val t: res[Aim, Fail] = code(c, at);
    if (sel t.err) { ret err[Fail].err{t.err}; }
    ret rva(c.out, c.section, c.xdata, c.rva, t.ok, 0);
}

# the address of the symbol `y`, written to the unwind data
pub fun symbol_rva(c: *Out, y: Id[Symbol]) err[Fail] {
    ret rva(c.out, c.section, c.xdata, c.rva, Aim.symbol{y}, 0);
}

# the address of offset `at` of the unwind data, written to the unwind data
pub fun xdata_rva(c: *Out, at: u64) err[Fail] {
    if (at > 0x7fff_ffff) { ret err[Fail].err{fail.overflow("the unwind data is past what an image relative address reaches")}; }
    ret rva(c.out, c.section, c.xdata, c.rva, Aim.added{c.section}, at::i64);
}

# name the region from `begin` up to `end` pointing at `u`
pub fun region(c: *Out, begin: u64, end: u64, u: Unwind) err[Fail] {
    val p: res[Id[Region], Fail] = table.push[Region](c.regions, Region{begin: begin, end: end, unwind: u});
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the bytes of the unwind data written so far, the offset the next is at
pub fun here(c: *Out) u64 {
    ret sink.len(c.xdata)::u64;
}

# the unwind data padded to four bytes, where every record starts
pub fun align(c: *Out) err[Fail] {
    ret sink.pad_to(c.xdata, 4);
}

# the number of regions named so far
pub fun regions(c: *Out) usize {
    ret table.count[Region](c.regions);
}
