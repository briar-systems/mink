# the records of a neutral object in the encodings a format's lowering names
#
# `encode` writes the records into a lowered record and leaves the object as
# it was. `apply` adds them to an object the caller owns, a copy it made of a
# producer's object, so neither a format's conversion nor a link ever changes
# the object a producer handed it.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.catalog.arch;
use mink.format.pair.Mapping;
use mink.lower;
use mink.lower.DwarfInfo;
use mink.lower.DwarfLine;
use mink.lower.FrameForm;
use mink.lower.FrameOffer;
use mink.lower.FrameTables;
use mink.lower.LineForm;
use mink.lower.Lowering;
use codeview_line: mink.lower.codeview.line;
use dwarf_info:    mink.lower.dwarf.info;
use dwarf_line:    mink.lower.dwarf.line;
use mink.lower.lowered;
use mink.lower.lowered.Lowered;
use unwind_compact: mink.lower.unwind.compact;
use unwind_dwarf:   mink.lower.unwind.dwarf;
use mink.model.frame;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Sequence;
use mink.reloc.row.Lookup;

use std.collections.vector.Vector;

# encode the records `o` states into `out` in the encodings `l` names, their
# relocations written by `set`, a table of data marked with the data symbol of
# `mapping` where its row takes one. an object with no records adds nothing. a refusal adds
# nothing either, and is unsupported for records `l` names no encoding of and
# for an encoding not built
pub fun encode(l: opt[*Lowering], o: *Object, set: *Lookup, mapping: opt[*Mapping], out: *Lowered) err[Fail] {
    if (!object.has_records(o)) { ret err[Fail].ok{}; }
    val m:        lowered.Mark = lowered.mark(out);
    val err_both: err[Fail]    = both(l, o, set, mapping, out);
    if (sel err_both.err) { lowered.truncate(out, m); }
    ret err_both;
}

fun both(l: opt[*Lowering], o: *Object, set: *Lookup, mapping: opt[*Mapping], out: *Lowered) err[Fail] {
    if (sel l.none) { ret err[Fail].err{fail.unsupported("the format has no encoding of the records the object states")}; }
    val err_lines: err[Fail] = lines(l.some, o, set, out);
    if (sel err_lines.err) { ret err_lines; }
    val err_debug: err[Fail] = debug(l.some, o, set, out);
    if (sel err_debug.err) { ret err_debug; }
    ret frames(l, o, set, mapping, out);
}

# the debug records, after the line table their declarations name files of
fun debug(l: *Lowering, o: *Object, set: *Lookup, out: *Lowered) err[Fail] {
    if (sel o.debug.unit.none) { ret err[Fail].ok{}; }
    val opt_info: opt[DwarfInfo] = l.info;
    if (sel opt_info.none) { ret err[Fail].err{fail.unsupported("the format has no encoding of debug records")}; }
    val opt_width: opt[u8] = arch.pointer_bytes(o.target.arch);
    if (sel opt_width.none) { ret err[Fail].err{fail.about(fail.unsupported("the architecture has no address width to write debugging information for"), o.target.arch.name)}; }
    var row: DwarfInfo = opt_info.some;
    ret dwarf_info.encode(o, set, ?row, opt_width.some, out);
}

fun lines(l: *Lowering, o: *Object, set: *Lookup, out: *Lowered) err[Fail] {
    if (table.count[Sequence](?o.sequences) == 0) { ret err[Fail].ok{}; }
    val opt_line: opt[LineForm] = l.line;
    if (sel opt_line.none)          { ret err[Fail].err{fail.unsupported("the format has no encoding of line records")}; }
    if (sel opt_line.some.codeview) { ret codeview_line.encode(o, set, out); }
    val form: DwarfLine = opt_line.some.dwarf;
    if (form.version != 5) { ret err[Fail].err{fail.valued(fail.unsupported("only DWARF 5 line tables are built"), form.version::i128)}; }
    val opt_width: opt[u8] = arch.pointer_bytes(o.target.arch);
    if (sel opt_width.none) { ret err[Fail].err{fail.about(fail.unsupported("the architecture has no address width to write a line table for"), o.target.arch.name)}; }
    ret dwarf_line.encode(o, set, opt_width.some, form.section, out);
}

# the frames of `o` in each destination they lower to, in the order the
# destinations' rows list them
fun frames(l: opt[*Lowering], o: *Object, set: *Lookup, mapping: opt[*Mapping], out: *Lowered) err[Fail] {
    if (table.count[object.Frame](?o.frames) == 0) { ret err[Fail].ok{}; }
    val res_destinations: res[frame.Destinations, Fail] = lower.destinations(l, o);
    if (sel res_destinations.err)                       { ret err[Fail].err{res_destinations.err}; }
    if (res_destinations.ok.bits == frame.NOWHERE.bits) { ret err[Fail].ok{}; }
    if (sel l.none)                                     { ret err[Fail].err{fail.unsupported("the format has no frame table")}; }
    if (sel l.some.frame.none)                          { ret err[Fail].err{fail.unsupported("the format has no frame table")}; }
    val tables: *FrameTables = ?l.some.frame.some;
    var i:      usize        = 0;
    for (i < frame.DESTINATION_COUNT) {
        val d: *frame.Destination = frame.DESTINATIONS[i];
        i = i + 1;
        if (!frame.has(res_destinations.ok, d)) { cnt; }
        val opt_offered: opt[*FrameOffer] = lower.offer(tables, d);
        if (sel opt_offered.none) { ret err[Fail].err{fail.about(fail.unsupported("the format offers no such frame destination"), d.name)}; }
        val form:       *FrameForm = ?opt_offered.some.form;
        var err_encode: err[Fail]  = err[Fail].ok{};
        if (sel form.dwarf_eh)    { err_encode = unwind_dwarf.encode(o, set, ?form.dwarf_eh, opt[*Vector[u8]].none{}, mapping, out); }
        or (sel form.dwarf_debug) { err_encode = unwind_dwarf.encode(o, set, ?form.dwarf_debug, opt[*Vector[u8]].none{}, mapping, out); }
        or (sel form.compact)     { err_encode = unwind_compact.encode(o, set, ?form.compact, mapping, out); }
        or (sel form.windows)     { err_encode = form.windows.write(o, set, out); }
        or                        { err_encode = err[Fail].err{fail.about(fail.unsupported("the frame form is not built"), d.name)}; }
        if (sel err_encode.err)   { ret err_encode; }
    }
    ret err[Fail].ok{};
}

# lower the records of `o`, an object the caller owns, in place: add what
# `encode` writes to it and give its records back. a refusal leaves `o` as it
# was
pub fun apply(l: opt[*Lowering], o: *Object, set: *Lookup, mapping: opt[*Mapping]) err[Fail] {
    if (!object.has_records(o)) { ret err[Fail].ok{}; }
    var low:             Lowered   = lowered.make(o.a);
    val err_encode:      err[Fail] = encode(l, o, set, mapping, ?low);
    var err_low_applied: err[Fail] = err_encode;
    if (sel err_encode.ok) { err_low_applied = lowered.apply(o, ?low); }
    val err_rel: err[Fail] = lowered.release(?low);
    if (sel err_low_applied.err) { ret err_low_applied; }
    if (sel err_rel.err)         { ret err_rel; }
    val err_lines_back: err[Fail] = object.drop_lines(o);
    if (sel err_lines_back.err) { ret err_lines_back; }
    val err_debug_back: err[Fail] = object.drop_debug(o);
    if (sel err_debug_back.err) { ret err_debug_back; }
    ret object.drop_frames(o);
}
