# the records of a neutral object in the encodings a format's lowering names
#
# `encode` writes the records into a lowered record and leaves the object as
# it was. `apply` adds them to an object the caller owns, a copy it made of a
# producer's object, so neither a format's conversion nor a link ever changes
# the object a producer handed it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.table;
use mink.base.table.Table;
use mink.catalog.arch;
use mink.format.pair.Mapping;
use mink.lower;
use mink.lower.DwarfLine;
use mink.lower.FrameForm;
use mink.lower.FrameOffer;
use mink.lower.FrameTables;
use mink.lower.LineForm;
use mink.lower.Lowering;
use codeview_line: mink.lower.codeview.line;
use dwarf_line:    mink.lower.dwarf.line;
use mink.lower.lowered;
use mink.lower.lowered.Lowered;
use unwind_compact: mink.lower.unwind.compact;
use unwind_dwarf:   mink.lower.unwind.dwarf;
use mink.model.frame;
use mink.model.object;
use mink.model.object.Object;
use mink.model.object.Sequence;
use mink.reloc.row.Lookup;

# encode the records `o` states into `out` in the encodings `l` names, their
# relocations written by `set` and a table of data marked with the data
# symbol of `mapping` where its row takes one. an object with no records adds
# nothing. a refusal adds nothing either, and is unsupported for records `l`
# names no encoding of and for an encoding not built
pub fun encode(l: opt[*Lowering], o: *Object, set: *Lookup, mapping: opt[*Mapping], out: *Lowered) err[Fail] {
    if (!object.has_records(o)) { ret err[Fail].ok{}; }
    val m: lowered.Mark = lowered.mark(out);
    val r: err[Fail]    = both(l, o, set, mapping, out);
    if (sel r.err) { val back: err[Fail] = lowered.rollback(out, m); }
    ret r;
}

fun both(l: opt[*Lowering], o: *Object, set: *Lookup, mapping: opt[*Mapping], out: *Lowered) err[Fail] {
    if (sel l.none) { ret err[Fail].err{fail.unsupported("the format has no encoding of the records the object states")}; }
    val r: err[Fail] = lines(l.some, o, set, out);
    if (sel r.err) { ret r; }
    ret frames(l, o, set, mapping, out);
}

fun lines(l: *Lowering, o: *Object, set: *Lookup, out: *Lowered) err[Fail] {
    if (table.count[Sequence](?o.sequences) == 0) { ret err[Fail].ok{}; }
    val line: opt[LineForm] = l.line;
    if (sel line.none)          { ret err[Fail].err{fail.unsupported("the format has no encoding of line records")}; }
    if (sel line.some.codeview) { ret codeview_line.encode(o, set, out); }
    val form: DwarfLine = line.some.dwarf;
    if (form.version != 5) { ret err[Fail].err{fail.valued(fail.unsupported("only DWARF 5 line tables are built"), form.version::i128)}; }
    val width: opt[u8] = arch.pointer_bytes(o.target.arch);
    if (sel width.none) { ret err[Fail].err{fail.about(fail.unsupported("the architecture has no address width to write a line table for"), o.target.arch.name)}; }
    ret dwarf_line.encode(o, set, width.some, form.section, out);
}

# whether the format writes frames of the form `f` itself, from rows of its
# own, as COFF writes its function table and unwind data
fun format_owned(f: *FrameForm) bool {
    ret sel f.windows;
}

# whether a destination the frames of `o` lower to under `l` takes a form
# the format writes itself, which reads the frames once `apply` is done
fun leaves_frames(l: opt[*Lowering], o: *Object) res[bool, Fail] {
    if (sel l.none)            { ret res[bool, Fail].ok{false}; }
    if (sel l.some.frame.none) { ret res[bool, Fail].ok{false}; }
    val to: res[frame.Destinations, Fail] = lower.destinations(l, o);
    if (sel to.err) { ret res[bool, Fail].err{to.err}; }
    var i: usize = 0;
    for (i < frame.DESTINATION_COUNT) {
        val d: *frame.Destination = frame.DESTINATIONS[i];
        i = i + 1;
        if (!frame.has(to.ok, d)) { cnt; }
        val offered: opt[*FrameOffer] = lower.offer(?l.some.frame.some, d);
        if (sel offered.some && format_owned(?offered.some.form)) { ret res[bool, Fail].ok{true}; }
    }
    ret res[bool, Fail].ok{false};
}

# the frames of `o` in each destination they lower to, in the order the
# destinations' rows list them, but for a form the format writes itself
fun frames(l: opt[*Lowering], o: *Object, set: *Lookup, mapping: opt[*Mapping], out: *Lowered) err[Fail] {
    if (table.count[object.Frame](?o.frames) == 0) { ret err[Fail].ok{}; }
    val to: res[frame.Destinations, Fail] = lower.destinations(l, o);
    if (sel to.err)                       { ret err[Fail].err{to.err}; }
    if (to.ok.bits == frame.NOWHERE.bits) { ret err[Fail].ok{}; }
    if (sel l.none)                       { ret err[Fail].err{fail.unsupported("the format has no frame table")}; }
    if (sel l.some.frame.none)            { ret err[Fail].err{fail.unsupported("the format has no frame table")}; }
    val tables: *FrameTables = ?l.some.frame.some;
    var i:      usize        = 0;
    for (i < frame.DESTINATION_COUNT) {
        val d: *frame.Destination = frame.DESTINATIONS[i];
        i = i + 1;
        if (!frame.has(to.ok, d)) { cnt; }
        val offered: opt[*FrameOffer] = lower.offer(tables, d);
        if (sel offered.none) { ret err[Fail].err{fail.about(fail.unsupported("the format offers no such frame destination"), d.name)}; }
        val form: *FrameForm = ?offered.some.form;
        var r:    err[Fail]  = err[Fail].ok{};
        if (sel form.dwarf_eh)    { r = unwind_dwarf.encode(o, set, ?form.dwarf_eh, opt[*Table[u8]].none{}, mapping, out); }
        or (sel form.dwarf_debug) { r = unwind_dwarf.encode(o, set, ?form.dwarf_debug, opt[*Table[u8]].none{}, mapping, out); }
        or (sel form.compact)     { r = unwind_compact.encode(o, set, ?form.compact, mapping, out); }
        or (format_owned(form))   { cnt; }
        or                        { r = err[Fail].err{fail.about(fail.unsupported("the frame form is not built"), d.name)}; }
        if (sel r.err)            { ret r; }
    }
    ret err[Fail].ok{};
}

# lower the records of `o`, an object the caller owns, in place: add what
# `encode` writes to it and give its records back, its frames kept when a
# form the format writes itself reads them. a refusal leaves `o` as it was
pub fun apply(l: opt[*Lowering], o: *Object, set: *Lookup, mapping: opt[*Mapping]) err[Fail] {
    if (!object.has_records(o)) { ret err[Fail].ok{}; }
    val left: res[bool, Fail] = leaves_frames(l, o);
    if (sel left.err) { ret err[Fail].err{left.err}; }
    var low: Lowered   = lowered.make(o.sections.a);
    val e:   err[Fail] = encode(l, o, set, mapping, ?low);
    var r:   err[Fail] = e;
    if (sel e.ok) { r = lowered.apply(o, ?low); }
    val rel: err[Fail] = lowered.release(?low);
    if (sel r.err)   { ret r; }
    if (sel rel.err) { ret rel; }
    val lines_back: err[Fail] = object.drop_lines(o);
    if (sel lines_back.err) { ret lines_back; }
    if (left.ok)            { ret err[Fail].ok{}; }
    ret object.drop_frames(o);
}
