# the payload of the mink note, which carries an object's constant-time
# ranges across files
#
# every format that carries the ranges embeds this payload, so the codec is
# written once here and a format states only where its files hold it, the
# width of its fields and its byte order. the payload is a version word, the
# number of ranges, then each range as two fields, its start and its end. a
# format with no flag of its own for a section the link drops carries those
# sections here too: the second version states their number after the
# ranges' and holds after the ranges one field per section, at its start,
# so the reader marks each excluded. a payload with none is the first
# version, byte for byte.
# each field is the place of one relocation of the absolute kind of its
# width, computed from a label at the start of the range's section with the
# range's offset as its addend, so the section a range names comes from the
# relocation's target and never from an index in the bytes. a tool that
# renumbers or merges sections keeps a relocation on its target, and the
# range follows its code. what a field holds is what its relocation leaves
# there, the addend for a format that keeps it in the field. a format whose
# relocations name no such label, one that relocates from a whole section
# holding many ranges' sections, resolves each field's place itself and
# hands the decoder its anchors. the count is stated, so a payload cut short
# at a range's edge is refused rather than read as fewer ranges, and payloads
# a linker concatenated are read one after another by that length.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader;
use mink.bytes.reader.Order;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.x86;
use catalog_kind: mink.catalog.kind;
use mink.lower.lowered;
use mink.lower.lowered.Added;
use mink.lower.lowered.Aim;
use mink.lower.lowered.Fixup;
use mink.lower.lowered.Lowered;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.CtRange;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Reloc;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.reloc;
use mink.model.reloc.Kind;
use mink.model.section;

# the payload version of the ranges alone
pub val VERSION: u32 = 1;

# the payload version of the ranges and the sections the link drops
pub val EXCLUDING: u32 = 2;

# the bytes ahead of the first field of the first version: the version and
# the count
pub val HEAD: u64 = 12;

# the bytes ahead of the first field of the second version: the version and
# the two counts
pub val EXCLUDING_HEAD: u64 = 20;

# the sections of `o` the payload carries as dropped: those the link drops
# when `carries`, the format stating no flag of its own, none otherwise
pub fun dropped(o: *Object, carries: bool) usize {
    if (!carries) { ret 0; }
    var n: usize = 0;
    var i: usize = 0;
    for (i < table.count[Section](?o.sections)) {
        if ((object.section_at(o, table.nth[Section](i)).flags & section.EXCLUDE) != 0) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the bytes of the payload of `o`'s ranges, and of the sections the link
# drops when `carries`, in fields of `width` bytes
pub fun size(o: *Object, width: u8, carries: bool) res[u64, Fail] {
    val n:    usize = dropped(o, carries);
    var head: u64   = HEAD;
    if (n != 0) { head = EXCLUDING_HEAD; }
    val count: res[u64, Fail] = checked.add(Location{}, 2 * table.count[CtRange](?o.ct)::u64, n::u64);
    if (sel count.err) { ret count; }
    val fields: res[u64, Fail] = checked.mul(Location{}, count.ok, width::u64);
    if (sel fields.err) { ret fields; }
    ret checked.add(Location{}, head, fields.ok);
}

# append the payload of `o`'s ranges, and of the sections the link drops
# when `carries`, in fields of `width` bytes, to `out`, the bytes of the
# section `holder` of `low`, and add to `low` the label at the start of each
# section a field names and the relocation of each field. a refusal leaves
# `low` as it was, and `out` is the caller's to drop
pub fun write(o: *Object, width: u8, out: *Sink, low: *Lowered, holder: Id[Added], carries: bool) err[Fail] {
    val kind: res[*Kind, Fail] = reloc.absolute_of(width);
    if (sel kind.err) { ret err[Fail].err{kind.err}; }
    val m:      lowered.Mark = lowered.mark(low);
    var labels: Table[u32]   = table.make[u32](o.ct.a);
    var r:      err[Fail]    = written(o, width, kind.ok, out, low, holder, ?labels, dropped(o, carries));
    r = fail.kept(r, table.release[u32](?labels));
    if (sel r.err) { val back: err[Fail] = lowered.rollback(low, m); }
    ret r;
}

fun written(o: *Object, width: u8, kind: *Kind, out: *Sink, low: *Lowered, holder: Id[Added], labels: *Table[u32], drops: usize) err[Fail] {
    val grown: res[Id[u32], Fail] = table.grow[u32](labels, table.count[Section](?o.sections));
    if (sel grown.err) { ret err[Fail].err{grown.err}; }
    var version: u32 = VERSION;
    if (drops != 0) { version = EXCLUDING; }
    var r: err[Fail] = sink.u32(out, version);
    r = fail.kept(r, sink.u64(out, table.count[CtRange](?o.ct)::u64));
    if (drops != 0) { r = fail.kept(r, sink.u64(out, drops::u64)); }
    if (sel r.err)  { ret r; }
    var i: usize = 0;
    for (i < table.count[CtRange](?o.ct)) {
        val c:     *CtRange             = table.at[CtRange](?o.ct, table.nth[CtRange](i));
        val label: res[Id[Place], Fail] = label_of(o, c.section, low, labels);
        if (sel label.err) { ret err[Fail].err{fail.in_indexed(label.err, "constant-time range", i::u64)}; }
        val s: err[Fail] = field(c.start, width, kind, label.ok, out, low, holder);
        if (sel s.err) { ret err[Fail].err{fail.in_indexed(s.err, "constant-time range", i::u64)}; }
        val e: err[Fail] = field(c.end, width, kind, label.ok, out, low, holder);
        if (sel e.err) { ret err[Fail].err{fail.in_indexed(e.err, "constant-time range", i::u64)}; }
        i = i + 1;
    }
    if (drops == 0) { ret err[Fail].ok{}; }
    i = 0;
    for (i < table.count[Section](?o.sections)) {
        val id: Id[Section] = table.nth[Section](i);
        i = i + 1;
        if ((object.section_at(o, id).flags & section.EXCLUDE) == 0) { cnt; }
        val label: res[Id[Place], Fail] = label_of(o, id, low, labels);
        if (sel label.err) { ret err[Fail].err{fail.in_indexed(label.err, "section", (i - 1)::u64)}; }
        val f: err[Fail] = field(0, width, kind, label.ok, out, low, holder);
        if (sel f.err) { ret err[Fail].err{fail.in_indexed(f.err, "section", (i - 1)::u64)}; }
    }
    ret err[Fail].ok{};
}

# the label at the start of section `s`, made once per section. `labels`
# holds, per section, its label's id plus one, zero for none yet
fun label_of(o: *Object, s: Id[Section], low: *Lowered, labels: *Table[u32]) res[Id[Place], Fail] {
    if (s.index::usize >= table.count[u32](labels)) {
        ret res[Id[Place], Fail].err{fail.malformed("the constant-time range names a section that is not in the object")};
    }
    val known: u32 = table.items[u32](labels)[s.index::usize];
    if (known != 0) { ret res[Id[Place], Fail].ok{Id[Place]{index: known - 1}}; }
    val made: res[Id[Place], Fail] = lowered.label(low, Place{section: s, offset: 0});
    if (sel made.err) { ret made; }
    table.items[u32](labels)[s.index::usize] = made.ok.index + 1;
    ret made;
}

# one field of `width` bytes holding nothing, relocated from `label` by
# `offset`
fun field(offset: u64, width: u8, kind: *Kind, label: Id[Place], out: *Sink, low: *Lowered, holder: Id[Added]) err[Fail] {
    if (offset > 0x7fff_ffff_ffff_ffff) { ret err[Fail].err{fail.overflow("the constant-time range lies past what an addend holds")}; }
    val f: res[Id[Fixup], Fail] = lowered.add_fixup(low, Fixup{section: holder, offset: sink.len(out)::u64, kind: kind, target: Aim.label{label}, minus: opt[Aim].none{}, addend: offset::i64});
    if (sel f.err) { ret err[Fail].err{f.err}; }
    ret sink.zeros(out, width::usize);
}

# how a holder's relocations order: by the offset they patch
pub fun order(a: *Reloc, b: *Reloc) i64 {
    if (a.offset < b.offset) { ret -1; }
    if (a.offset > b.offset) { ret 1; }
    ret 0;
}

# the relocations of the payload that starts at `at` in its holder: where
# the first lies among the holder's, and how many
pub rec Run {
    first: usize;
    count: usize;
}

# the relocations of a holder that anchor its payloads' fields, as a format
# resolves them
# ---
# ctx:    what the two functions read
# count:  how many relocations the holder has
# offset: where relocation `i` patches the holder, ascending in `i`
# place:  the place relocation `i` computes, refused at `at`, its field's
#         offset in the file
pub rec Anchors {
    ctx:    ptr;
    count:  usize;
    offset: fun(ptr, usize) u64;
    place:  fun(ptr, usize, u64) res[Place, Fail];
}

# a decoded payload: the relocations it took and the bytes it spans
pub rec Decoded {
    run: Run;
    len: u64;
}

# relocations each naming a symbol of an object, the place a field computes
# being that symbol's place moved by the addend
rec Symbolic {
    o:      *Object;
    relocs: *Reloc;
    kind:   *Kind;
}

fun symbolic_offset(ctx: ptr, i: usize) u64 {
    val s: *Symbolic = ctx::*Symbolic;
    ret s.relocs[i].offset;
}

# the place relocation `i` computes: its symbol's place moved by the addend,
# for a relocation of the absolute kind of the width from a symbol defined
# in a section
fun symbolic_place(ctx: ptr, i: usize, place: u64) res[Place, Fail] {
    val c: *Symbolic = ctx::*Symbolic;
    val o: *Object   = c.o;
    val r: *Reloc    = ?c.relocs[i];
    if (r.kind != c.kind) {
        ret res[Place, Fail].err{fail.about(fail.at_offset(fail.malformed("a field of the mink note payload is relocated by a kind not the absolute one of its width"), place), r.kind.name)};
    }
    if (!sel r.target.symbol) { ret res[Place, Fail].err{fail.at_offset(fail.malformed("a field of the mink note payload is relocated from no symbol"), place)}; }
    val id: Id[Symbol] = r.target.symbol;
    if (id.index::usize >= table.count[Symbol](?o.symbols)) {
        ret res[Place, Fail].err{fail.at_offset(fail.malformed("a field of the mink note payload is relocated from a symbol not in the object"), place)};
    }
    val s: *Symbol = object.symbol_at(o, id);
    if (!sel s.def.placed) {
        ret res[Place, Fail].err{fail.at_offset(fail.malformed("a field of the mink note payload is relocated from a symbol defined in no section"), place)};
    }
    val p:     Place = s.def.placed;
    val value: i128  = p.offset::i128 + r.addend::i128;
    if (value < 0 || value > 0xffff_ffff_ffff_ffff) {
        ret res[Place, Fail].err{fail.valued(fail.at_offset(fail.malformed("a field of the mink note payload computes an offset outside its section"), place), value)};
    }
    ret res[Place, Fail].ok{Place{section: p.section, offset: value::u64}};
}

# mark on `o` the constant-time ranges, and the sections the link drops, of
# the payload `data`, which starts at `at` in the section holding it and at
# `base` in its file, its fields `width` bytes in the byte order `order`.
# `relocs` are the holder's `n` relocations, ascending by offset, as `order`
# sorts them, each naming a symbol of `o`. refused, at its offset in the
# file: a payload cut short, one of a version this codec does not read,
# bytes past its last field, a field with no relocation, a relocation of the
# payload on no field or of a kind not the absolute one of the width, a
# range whose fields relocate from different sections or from a symbol
# defined in none, a range `object.ct_fits` refuses, and a field naming a
# section the link drops that computes a place past its start. answers
# which of `relocs` the payload took. a refusal leaves `o` as it was
pub fun decode(o: *Object, data: Bytes, at: u64, base: u64, width: u8, order: Order, relocs: *Reloc, n: usize) res[Run, Fail] {
    val kind: res[*Kind, Fail] = reloc.absolute_of(width);
    if (sel kind.err) { ret res[Run, Fail].err{kind.err}; }
    var ctx: Symbolic           = Symbolic{o: o, relocs: relocs, kind: kind.ok};
    var an:  Anchors            = Anchors{ctx: (?ctx)::ptr, count: n, offset: symbolic_offset, place: symbolic_place};
    var dr:  Table[Id[Section]] = table.make[Id[Section]](o.ct.a);
    val d:   res[Decoded, Fail] = payload(o, data, at, base, width, order, ?an, true, ?dr);
    if (sel d.err) {
        val freed: err[Fail] = table.release[Id[Section]](?dr);
        ret res[Run, Fail].err{d.err};
    }
    val e: err[Fail] = excluded(o, ?dr);
    if (sel e.err) { ret res[Run, Fail].err{e.err}; }
    ret res[Run, Fail].ok{d.ok.run};
}

# mark excluded each section of `dr`, and release it
fun excluded(o: *Object, dr: *Table[Id[Section]]) err[Fail] {
    var k: usize = 0;
    for (k < table.count[Id[Section]](dr)) {
        val s: *Section = object.section_at(o, @table.at[Id[Section]](dr, table.nth[Id[Section]](k)));
        s.flags = s.flags | section.EXCLUDE;
        k       = k + 1;
    }
    ret table.release[Id[Section]](dr);
}

# mark on `o` the constant-time ranges of every payload in `data`, the bytes
# of a holder at `base` in its file, read one after another by the length
# each payload's head states until the bytes end, as a linker that merges
# holders leaves them. the fields are `width` bytes in the byte order `order`
# and `anchors` the holder's relocations. refused as `decode` refuses, and
# besides: a tail too short for the payload its head states, and a
# relocation of the holder that patches no payload. a refusal leaves `o` as
# it was
pub fun decode_all(o: *Object, data: Bytes, base: u64, width: u8, order: Order, anchors: *Anchors) err[Fail] {
    val mark:  usize              = table.count[CtRange](?o.ct);
    var dr:    Table[Id[Section]] = table.make[Id[Section]](o.ct.a);
    var at:    u64                = 0;
    var taken: usize              = 0;
    var r:     err[Fail]          = err[Fail].ok{};
    for (at < data.len::u64) {
        val rest: Bytes              = Bytes{data: ?data.data[at::usize], len: data.len - at::usize};
        val d:    res[Decoded, Fail] = payload(o, rest, at, base + at, width, order, anchors, false, ?dr);
        if (sel d.err) {
            r = err[Fail].err{d.err};
            brk;
        }
        taken = taken + d.ok.run.count;
        at    = at + d.ok.len;
    }
    if (!(sel r.err) && taken != anchors.count) { r = err[Fail].err{fail.at_offset(fail.malformed("a relocation of the mink note's holder patches no payload"), base)}; }
    if (sel r.err) {
        table.truncate[CtRange](?o.ct, mark);
        val freed: err[Fail] = table.release[Id[Section]](?dr);
        ret r;
    }
    ret excluded(o, ?dr);
}

# decode the payload at the start of `data`, the rest of its holder from
# `at`, refusing bytes past its last field when it is `whole`, and push onto
# `dr` each section it states the link drops
fun payload(o: *Object, data: Bytes, at: u64, base: u64, width: u8, order: Order, anchors: *Anchors, whole: bool, dr: *Table[Id[Section]]) res[Decoded, Fail] {
    var rd: Reader = reader.make(nil, data.data, data.len, order);
    rd.base = base;
    val version: res[u32, Fail] = reader.u32(?rd);
    if (sel version.err)                                  { ret res[Decoded, Fail].err{version.err}; }
    if (version.ok != VERSION && version.ok != EXCLUDING) { ret res[Decoded, Fail].err{fail.valued(fail.at_offset(fail.unsupported("the mink note payload is of a version mink does not read"), base), version.ok::i128)}; }
    val count: res[u64, Fail] = reader.u64(?rd);
    if (sel count.err) { ret res[Decoded, Fail].err{count.err}; }
    var head:  u64 = HEAD;
    var drops: u64 = 0;
    if (version.ok == EXCLUDING) {
        val n: res[u64, Fail] = reader.u64(?rd);
        if (sel n.err) { ret res[Decoded, Fail].err{n.err}; }
        head  = EXCLUDING_HEAD;
        drops = n.ok;
    }
    val range:  u64            = 2 * width::u64;
    val ranges: res[u64, Fail] = checked.mul(Location{offset: base + 4, placed: true}, count.ok, range);
    if (sel ranges.err) { ret res[Decoded, Fail].err{ranges.err}; }
    val tail: res[u64, Fail] = checked.mul(Location{offset: base + HEAD, placed: true}, drops, width::u64);
    if (sel tail.err) { ret res[Decoded, Fail].err{tail.err}; }
    val size: res[u64, Fail] = checked.add(Location{offset: base + HEAD, placed: true}, ranges.ok, tail.ok);
    if (sel size.err) { ret res[Decoded, Fail].err{size.err}; }
    val left: u64 = reader.remaining(?rd)::u64;
    if (ranges.ok > left)        { ret res[Decoded, Fail].err{fail.at_offset(fail.truncated("the mink note payload ends inside a range"), base + head + left - left % range)}; }
    if (size.ok > left)          { ret res[Decoded, Fail].err{fail.at_offset(fail.truncated("the mink note payload ends inside a field naming a section the link drops"), base + head + left - (left - ranges.ok) % width::u64)}; }
    if (whole && size.ok < left) { ret res[Decoded, Fail].err{fail.at_offset(fail.malformed("the mink note payload has bytes past its last field"), base + head + size.ok)}; }
    val len: u64 = head + size.ok;
    val run: Run = run_of(anchors, at, len);
    if (run.count != 0 && anchors.offset(anchors.ctx, run.first) < at + head) {
        ret res[Decoded, Fail].err{fail.at_offset(fail.malformed("a relocation patches the mink note payload's head"), base + anchors.offset(anchors.ctx, run.first) - at)};
    }
    val c:    usize     = count.ok::usize;
    val mark: usize     = table.count[CtRange](?o.ct);
    val room: err[Fail] = table.reserve[CtRange](?o.ct, c);
    if (sel room.err) { ret res[Decoded, Fail].err{room.err}; }
    val held: usize = table.count[Id[Section]](dr);
    var k:    usize = 0;
    for (k < c) {
        val r: err[Fail] = range_in(o, k, at, base, width, head, anchors, run);
        if (sel r.err) {
            table.truncate[CtRange](?o.ct, mark);
            ret res[Decoded, Fail].err{r.err};
        }
        k = k + 1;
    }
    val fields: usize = 2 * c + drops::usize;
    var j:      usize = 2 * c;
    for (j < fields) {
        val r: err[Fail] = dropped_in(o, j, at, base, width, head, anchors, run, dr);
        if (sel r.err) {
            table.truncate[CtRange](?o.ct, mark);
            table.truncate[Id[Section]](dr, held);
            ret res[Decoded, Fail].err{r.err};
        }
        j = j + 1;
    }
    if (run.count != fields) {
        table.truncate[CtRange](?o.ct, mark);
        table.truncate[Id[Section]](dr, held);
        val stray: u64 = anchors.offset(anchors.ctx, run.first + fields);
        ret res[Decoded, Fail].err{fail.at_offset(fail.malformed("a relocation patches the mink note payload on no field"), base + stray - at)};
    }
    ret res[Decoded, Fail].ok{Decoded{run: run, len: len}};
}

# push onto `dr` the section field `f` names as one the link drops, at whose
# start the field's relocation must compute
fun dropped_in(o: *Object, f: usize, at: u64, base: u64, width: u8, head: u64, anchors: *Anchors, run: Run, dr: *Table[Id[Section]]) err[Fail] {
    val place: u64              = base + head + f::u64 * width::u64;
    val p:     res[Place, Fail] = field_in(f, at, base, width, head, anchors, run);
    if (sel p.err)                                                      { ret err[Fail].err{p.err}; }
    if (p.ok.section.index::usize >= table.count[Section](?o.sections)) { ret err[Fail].err{fail.at_offset(fail.malformed("a field naming a section the link drops names a section that is not in the object"), place)}; }
    if (p.ok.offset != 0)                                               { ret err[Fail].err{fail.valued(fail.at_offset(fail.malformed("a field naming a section the link drops computes a place inside it"), place), p.ok.offset::i128)}; }
    val pushed: res[Id[Id[Section]], Fail] = table.push[Id[Section]](dr, p.ok.section);
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

# the relocations among `anchors` that patch the `len` bytes from `at`
fun run_of(anchors: *Anchors, at: u64, len: u64) Run {
    val n:  usize = anchors.count;
    var lo: usize = 0;
    var hi: usize = n;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (anchors.offset(anchors.ctx, mid) < at) { lo = mid + 1; }
        or                                         { hi = mid; }
    }
    var end: usize = lo;
    for (end < n && anchors.offset(anchors.ctx, end) - at < len) {
        end = end + 1;
    }
    ret Run{first: lo, count: end - lo};
}

# mark on `o` the `k`th range, whose fields the relocations `run` patch in
# field order when the payload is sound
fun range_in(o: *Object, k: usize, at: u64, base: u64, width: u8, head: u64, anchors: *Anchors, run: Run) err[Fail] {
    val first: usize            = 2 * k;
    val start: res[Place, Fail] = field_in(first, at, base, width, head, anchors, run);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    val end: res[Place, Fail] = field_in(first + 1, at, base, width, head, anchors, run);
    if (sel end.err) { ret err[Fail].err{end.err}; }
    val place: u64 = base + head + first::u64 * width::u64;
    if (start.ok.section.index != end.ok.section.index) {
        ret err[Fail].err{fail.at_offset(fail.in_indexed(fail.malformed("the constant-time range starts and ends in different sections"), "constant-time range", k::u64), place)};
    }
    val c: CtRange   = CtRange{section: start.ok.section, start: start.ok.offset, end: end.ok.offset};
    val f: err[Fail] = object.ct_fits(o, c);
    if (sel f.err) { ret err[Fail].err{fail.at_offset(fail.in_indexed(f.err, "constant-time range", k::u64), place)}; }
    val p: res[Id[CtRange], Fail] = table.push[CtRange](?o.ct, c);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# the place field `f` computes, through the relocation that patches it
fun field_in(f: usize, at: u64, base: u64, width: u8, head: u64, anchors: *Anchors, run: Run) res[Place, Fail] {
    val offset: u64 = head + f::u64 * width::u64;
    val place:  u64 = base + offset;
    if (f >= run.count || anchors.offset(anchors.ctx, run.first + f) != at + offset) {
        ret res[Place, Fail].err{fail.at_offset(fail.malformed("a field of the mink note payload carries no relocation"), place)};
    }
    ret anchors.place(anchors.ctx, run.first + f, place);
}

# an object of two 16 byte sections
fun sectioned(a: *A.Allocator) res[Object, Fail] {
    var o: Object    = object.make(a, ?x86.X86_64, ?catalog_kind.RELOCATABLE);
    val r: err[Fail] = fail.kept(text_into(?o, ".text"), text_into(?o, ".text.cold"));
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}

fun text_into(o: *Object, name: str) err[Fail] {
    val nm: res[Id[Name], Fail] = object.name_str(o, name);
    if (sel nm.err) { ret err[Fail].err{nm.err}; }
    val s: res[Id[Section], Fail] = object.add_section(o, Section{name: opt[Id[Name]].some{nm.ok}, kind: ?section.TEXT, flags: section.TEXT.flags, align: 1, contents: Contents.zero{16}});
    if (sel s.err) { ret err[Fail].err{s.err}; }
    ret err[Fail].ok{};
}

# `into`, a copy of `from`'s sections, given the payload of `from`'s ranges
# as its third section, with the labels and relocations that anchor it
fun anchored(a: *A.Allocator, from: *Object, into: *Object) err[Fail] {
    var low: Lowered   = lowered.make(a);
    var out: Sink      = sink.make(a, reader.LITTLE);
    val w:   err[Fail] = write(from, 8, ?out, ?low, lowered.next_section(?low), false);
    var r:   err[Fail] = w;
    if (sel w.err) { val dropped: err[Fail] = sink.release(?out); }
    or {
        val added: res[Id[Added], Fail] = lowered.add_section(?low, Added{name: ".note.mink.ct", kind: ?section.NOTE_INFO, flags: 0, align: 4, disposition: ?section.ROOT, bytes: out});
        if (sel added.err) { r = err[Fail].err{added.err}; }
        or                 { r = lowered.apply(into, ?low); }
    }
    ret fail.kept(r, lowered.release(?low));
}

# decode the payload `anchored` gave `o` back onto it
fun decoded(o: *Object, len: usize) res[Run, Fail] {
    val holder: *Section = object.section_at(o, Id[Section]{index: 2});
    val data:   Bytes    = object.bytes(o, ?holder.contents);
    ret decode(o, Bytes{data: data.data, len: len}, 0, 0x100, 8, reader.LITTLE, table.items[Reloc](?o.relocs), table.count[Reloc](?o.relocs));
}

# an object of two marked ranges, `into` a copy of its sections that holds
# their anchored payload
fun marked_pair(a: *A.Allocator, from: *Object, into: *Object) bool {
    val m1: res[Id[CtRange], Fail] = object.mark_ct(from, CtRange{section: Id[Section]{index: 0}, start: 0, end: 8});
    val m2: res[Id[CtRange], Fail] = object.mark_ct(from, CtRange{section: Id[Section]{index: 1}, start: 12, end: 16});
    if (sel m1.err) { ret false; }
    if (sel m2.err) { ret false; }
    val r: err[Fail] = anchored(a, from, into);
    ret sel r.ok;
}

test mark__the_payload_round_trips_through_its_relocations {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator      = T.allocator_of(?t);
    val from: res[Object, Fail] = sectioned(a);
    if (sel from.err) { ret 1; }
    val to: res[Object, Fail] = sectioned(a);
    if (sel to.err) { ret 1; }
    var o:    Object = from.ok;
    var back: Object = to.ok;
    if (!marked_pair(a, ?o, ?back)) { ret 2; }

    # each range is two fields, each relocated by the absolute kind of its width
    val holder: *Section = object.section_at(?back, Id[Section]{index: 2});
    val len:    usize    = object.bytes(?back, ?holder.contents).len;
    if (len != (HEAD + 4 * 8)::usize)                                            { ret 3; }
    if (table.count[Reloc](?back.relocs) != 4)                                   { ret 3; }
    if (table.at[Reloc](?back.relocs, table.nth[Reloc](0)).kind != ?reloc.ABS64) { ret 3; }

    val run: res[Run, Fail] = decoded(?back, len);
    if (sel run.err)                         { ret 4; }
    if (run.ok.count != 4)                   { ret 4; }
    if (table.count[CtRange](?back.ct) != 2) { ret 5; }
    var i: usize = 0;
    for (i < 2) {
        val x: *CtRange = table.at[CtRange](?o.ct, table.nth[CtRange](i));
        val y: *CtRange = table.at[CtRange](?back.ct, table.nth[CtRange](i));
        if (x.section.index != y.section.index || x.start != y.start || x.end != y.end) { ret 5; }
        i = i + 1;
    }
    val r1: err[Fail] = object.release(?o);
    val r2: err[Fail] = object.release(?back);
    if (sel r1.err)            { ret 6; }
    if (sel r2.err)            { ret 6; }
    if (T.live_count(?t) != 0) { ret 6; }
    T.dnit(?t);
    ret 0;
}
