# the payload of the mink note, which carries an object's constant-time
# ranges across files
#
# every format that carries the ranges embeds these same bytes, so the codec
# is written once here and a format states only where its files hold them.
# the payload is little endian whatever the format's byte order: a version
# word, the number of ranges, then each range as its section, start and end.
# a section is named by its index among the object's sections, its identity
# in a neutral object, which a format keeps from from_neutral to to_neutral.
# the count is stated, so a payload cut short at a range's edge is refused
# rather than read as fewer ranges.

use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mink.base.checked;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.fail.Location;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader;
use mink.bytes.reader.Reader;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.x86;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.CtRange;
use mink.model.object.Object;
use mink.model.object.Section;
use mink.model.section;

# the payload version this codec writes and the only one it reads
pub val VERSION: u32 = 1;

# the bytes ahead of the first range: the version and the count
val HEAD: u64 = 12;

# the bytes of one range: its section, start and end
val RANGE: u64 = 20;

# the payload of the constant-time ranges of `o`, in a sink of its own
pub fun encode(a: *A.Allocator, o: *Object) res[Sink, Fail] {
    var out: Sink      = sink.make(a, reader.LITTLE);
    var r:   err[Fail] = sink.u32(?out, VERSION);
    r = fail.kept(r, sink.u64(?out, table.count[CtRange](?o.ct)::u64));
    var i: usize = 0;
    for (i < table.count[CtRange](?o.ct) && !(sel r.err)) {
        val c: *CtRange = table.at[CtRange](?o.ct, table.nth[CtRange](i));
        r = fail.kept(r, sink.u32(?out, c.section.index));
        r = fail.kept(r, sink.u64(?out, c.start));
        r = fail.kept(r, sink.u64(?out, c.end));
        i = i + 1;
    }
    if (sel r.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret res[Sink, Fail].err{r.err};
    }
    ret res[Sink, Fail].ok{out};
}

# mark on `o` the constant-time ranges the payload `data` states, whose first
# byte lies at `base` in its file, refusing, at its offset in the file, a
# payload cut short, one of a version this codec does not read, bytes past
# its last range and a range `object.ct_fits` refuses. a refusal leaves `o` as
# it was
pub fun decode(o: *Object, data: Bytes, base: u64) err[Fail] {
    var rd: Reader = reader.make(nil, data.data, data.len, reader.LITTLE);
    rd.base = base;
    val version: res[u32, Fail] = reader.u32(?rd);
    if (sel version.err)       { ret err[Fail].err{version.err}; }
    if (version.ok != VERSION) { ret err[Fail].err{fail.valued(fail.at_offset(fail.unsupported("the mink note payload is of a version mink does not read"), base), version.ok::i128)}; }
    val count: res[u64, Fail] = reader.u64(?rd);
    if (sel count.err) { ret err[Fail].err{count.err}; }
    val size: res[u64, Fail] = checked.mul(Location{offset: base + 4, placed: true}, count.ok, RANGE);
    if (sel size.err) { ret err[Fail].err{size.err}; }
    val left: u64 = reader.remaining(?rd)::u64;
    if (size.ok > left) { ret err[Fail].err{fail.at_offset(fail.truncated("the mink note payload ends inside a range"), base + HEAD + left - left % RANGE)}; }
    if (size.ok < left) { ret err[Fail].err{fail.at_offset(fail.malformed("the mink note payload has bytes past its last range"), base + HEAD + size.ok)}; }
    val n:    usize     = count.ok::usize;
    val mark: usize     = table.count[CtRange](?o.ct);
    val room: err[Fail] = table.reserve[CtRange](?o.ct, n);
    if (sel room.err) { ret room; }
    var k: usize = 0;
    for (k < n) {
        val r: err[Fail] = range_in(o, ?rd, k);
        if (sel r.err) {
            table.truncate[CtRange](?o.ct, mark);
            ret r;
        }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# mark on `o` the `k`th range, which `rd` is at
fun range_in(o: *Object, rd: *Reader, k: usize) err[Fail] {
    val at:      u64            = reader.offset(rd);
    val section: res[u32, Fail] = reader.u32(rd);
    if (sel section.err) { ret err[Fail].err{section.err}; }
    val start: res[u64, Fail] = reader.u64(rd);
    if (sel start.err) { ret err[Fail].err{start.err}; }
    val end: res[u64, Fail] = reader.u64(rd);
    if (sel end.err) { ret err[Fail].err{end.err}; }
    val c: CtRange   = CtRange{section: Id[Section]{index: section.ok}, start: start.ok, end: end.ok};
    val f: err[Fail] = object.ct_fits(o, c);
    if (sel f.err) { ret err[Fail].err{fail.at_offset(fail.in_indexed(f.err, "constant-time range", k::u64), at)}; }
    val p: res[Id[CtRange], Fail] = table.push[CtRange](?o.ct, c);
    if (sel p.err) { ret err[Fail].err{p.err}; }
    ret err[Fail].ok{};
}

# an object of one 16 byte section
fun sectioned(a: *A.Allocator) res[Object, Fail] {
    var o: Object    = object.make(a, ?x86.X86_64);
    val r: err[Fail] = text_into(?o);
    if (sel r.err) {
        val dropped: err[Fail] = object.release(?o);
        ret res[Object, Fail].err{r.err};
    }
    ret res[Object, Fail].ok{o};
}

fun text_into(o: *Object) err[Fail] {
    val nm: res[Id[Name], Fail] = object.name_str(o, ".text");
    if (sel nm.err) { ret err[Fail].err{nm.err}; }
    val s: res[Id[Section], Fail] = object.add_section(o, Section{name: opt[Id[Name]].some{nm.ok}, kind: ?section.TEXT, flags: section.TEXT.flags, align: 1, contents: Contents.zero{16}});
    if (sel s.err) { ret err[Fail].err{s.err}; }
    ret err[Fail].ok{};
}

# a payload of `version` holding two ranges of section 0, the second ending
# at `end`
fun written(a: *A.Allocator, version: u32, end: u64) res[Sink, Fail] {
    var out: Sink      = sink.make(a, reader.LITTLE);
    var r:   err[Fail] = sink.u32(?out, version);
    r = fail.kept(r, sink.u64(?out, 2));
    r = fail.kept(r, sink.u32(?out, 0));
    r = fail.kept(r, sink.u64(?out, 0));
    r = fail.kept(r, sink.u64(?out, 8));
    r = fail.kept(r, sink.u32(?out, 0));
    r = fail.kept(r, sink.u64(?out, 8));
    r = fail.kept(r, sink.u64(?out, end));
    if (sel r.err) {
        val dropped: err[Fail] = sink.release(?out);
        ret res[Sink, Fail].err{r.err};
    }
    ret res[Sink, Fail].ok{out};
}

# the refusal of decoding the first `n` bytes of `s` into `o`, when it is at
# `offset` and leaves `o` with no range, none otherwise
fun refused_at(o: *Object, s: *Sink, n: usize, offset: u64) opt[Fail] {
    val r: err[Fail] = decode(o, Bytes{data: sink.data(s), len: n}, 0);
    if (sel r.ok)                                      { ret opt[Fail].none{}; }
    if (!r.err.at.placed || r.err.at.offset != offset) { ret opt[Fail].none{}; }
    if (table.count[CtRange](?o.ct) != 0)              { ret opt[Fail].none{}; }
    ret opt[Fail].some{r.err};
}

test mark__the_payload_round_trips {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator      = T.allocator_of(?t);
    val from: res[Object, Fail] = sectioned(a);
    val to:   res[Object, Fail] = sectioned(a);
    if (sel from.err) { ret 1; }
    if (sel to.err)   { ret 1; }
    var o:    Object                 = from.ok;
    var back: Object                 = to.ok;
    val m1:   res[Id[CtRange], Fail] = object.mark_ct(?o, CtRange{section: Id[Section]{index: 0}, start: 0, end: 8});
    val m2:   res[Id[CtRange], Fail] = object.mark_ct(?o, CtRange{section: Id[Section]{index: 0}, start: 12, end: 16});
    if (sel m1.err || sel m2.err) { ret 2; }
    val e: res[Sink, Fail] = encode(a, ?o);
    if (sel e.err) { ret 3; }
    var s: Sink      = e.ok;
    val d: err[Fail] = decode(?back, Bytes{data: sink.data(?s), len: sink.len(?s)}, 0);
    if (sel d.err)                                 { ret 4; }
    if (sink.len(?s) != (HEAD + 2 * RANGE)::usize) { ret 4; }
    if (table.count[CtRange](?back.ct) != 2)       { ret 5; }
    var i: usize = 0;
    for (i < 2) {
        val x: *CtRange = table.at[CtRange](?o.ct, table.nth[CtRange](i));
        val y: *CtRange = table.at[CtRange](?back.ct, table.nth[CtRange](i));
        if (x.section.index != y.section.index || x.start != y.start || x.end != y.end) { ret 5; }
        i = i + 1;
    }
    val r1: err[Fail] = sink.release(?s);
    val r2: err[Fail] = object.release(?o);
    val r3: err[Fail] = object.release(?back);
    if (sel r1.err || sel r2.err || sel r3.err) { ret 6; }
    if (T.live_count(?t) != 0)                  { ret 6; }
    T.dnit(?t);
    ret 0;
}

test mark__a_bad_payload_is_refused_at_its_offset {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:  *A.Allocator      = T.allocator_of(?t);
    val ob: res[Object, Fail] = sectioned(a);
    if (sel ob.err) { ret 1; }
    var o:    Object          = ob.ok;
    val good: res[Sink, Fail] = written(a, VERSION, 16);
    val new:  res[Sink, Fail] = written(a, VERSION + 1, 16);
    val past: res[Sink, Fail] = written(a, VERSION, 17);
    if (sel good.err) { ret 1; }
    if (sel new.err)  { ret 1; }
    if (sel past.err) { ret 1; }
    var g: Sink = good.ok;
    var v: Sink = new.ok;
    var p: Sink = past.ok;

    # a payload cut inside its second range is refused where that range starts
    val cut: opt[Fail] = refused_at(?o, ?g, sink.len(?g) - 1, HEAD + RANGE);
    if (sel cut.none)                  { ret 2; }
    if (!sel cut.some.cause.truncated) { ret 2; }

    # a payload of another version is refused at its version word
    val other: opt[Fail] = refused_at(?o, ?v, sink.len(?v), 0);
    if (sel other.none)                    { ret 3; }
    if (!sel other.some.cause.unsupported) { ret 3; }

    # a range past the end of its section is refused at that range
    val beyond: opt[Fail] = refused_at(?o, ?p, sink.len(?p), HEAD + RANGE);
    if (sel beyond.none)                  { ret 4; }
    if (!sel beyond.some.cause.malformed) { ret 4; }
    val f: Fail = beyond.some;
    if (!f.at.indexed || f.at.index != 1) { ret 4; }

    # the whole payload decodes
    val whole: err[Fail] = decode(?o, Bytes{data: sink.data(?g), len: sink.len(?g)}, 0);
    if (sel whole.err)                    { ret 5; }
    if (table.count[CtRange](?o.ct) != 2) { ret 5; }

    val r1: err[Fail] = sink.release(?g);
    val r2: err[Fail] = sink.release(?v);
    val r3: err[Fail] = sink.release(?p);
    val r4: err[Fail] = object.release(?o);
    if (sel r1.err || sel r2.err || sel r3.err || sel r4.err) { ret 6; }
    if (T.live_count(?t) != 0)                                { ret 6; }
    T.dnit(?t);
    ret 0;
}
