# what lowering an object's records adds to the file a format writes
#
# a producer states records, such as line sequences, on the neutral object, and
# the format the object is written or linked as lowers them, in its encoding,
# into sections of bytes and relocations of those bytes. a lowering builds
# this record first, leaving the object as it was, and `apply` then adds it to
# the object: its relocations name labels, places in the object's own
# sections, which become local symbols, so a linker that moves code moves what
# they compute with it.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern;
use mink.base.intern.Name;
use mink.base.store;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.model.group;
use mink.model.object;
use mink.model.object.Contents;
use mink.model.object.Definition;
use mink.model.object.Group;
use mink.model.object.Object;
use mink.model.object.Place;
use mink.model.object.Reloc;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.object.Target;
use mink.model.reloc.Kind;
use mink.model.section;
use mink.model.symbol;

# a section a lowering adds
# ---
# name:        its name, static
# kind:        its kind
# flags:       its flags
# align:       its alignment
# disposition: how garbage collection treats it
# bytes:       its contents, owned by the record
# leader:      the section of the object it is kept with, as unwind data of a
#              function in a group is, none for a section kept on its own
pub rec Added {
    name:        str;
    kind:        *section.Kind;
    flags:       section.Flags;
    align:       u64;
    disposition: *section.Disposition;
    bytes:       Sink;
    leader:      opt[Id[Section]];
}

# what a relocation of an added section computes from
# ---
# label:  a label, a place in the object's own sections
# symbol: a symbol of the object, as a handler routine another object defines
# added:  the start of an added section
pub tag Aim: u8 {
    label:  Id[Place];
    symbol: Id[Symbol];
    added:  Id[Added];
}

# a local symbol of no type with a name at the start of an added section, as
# a mapping symbol marks where data starts
pub rec Named {
    section: Id[Added];
    name:    str;
}

# a relocation of an added section
# ---
# section: the added section it patches
# offset:  the place within it
# kind:    what it computes
# target:  what it computes from
# minus:   what is subtracted, for a difference kind
# addend:  the addend
pub rec Fixup {
    section: Id[Added];
    offset:  u64;
    kind:    *Kind;
    target:  Aim;
    minus:   opt[Aim];
    addend:  i64;
}

# sections: the sections added, in the order a format writes them
# labels:   the places relocations name, each written as a local symbol
# fixups:   the relocations of the added sections
# named:    the named symbols in the added sections
pub rec Lowered {
    sections: Table[Added];
    labels:   Table[Place];
    fixups:   Table[Fixup];
    named:    Table[Named];
}

# how much a record held, to give back what a refused lowering added
pub rec Mark {
    sections: usize;
    labels:   usize;
    fixups:   usize;
    named:    usize;
}

pub fun make(a: *A.Allocator) Lowered {
    ret Lowered{sections: table.make[Added](a), labels: table.make[Place](a), fixups: table.make[Fixup](a), named: table.make[Named](a)};
}

# whether nothing was added
pub fun empty(l: *Lowered) bool {
    ret table.count[Added](?l.sections) == 0;
}

# the next id `add_section` gives, for fixups written before the section is
pub fun next_section(l: *Lowered) Id[Added] {
    ret table.nth[Added](table.count[Added](?l.sections));
}

# add the section `s`, which the record owns from then on, even when adding it
# is refused
pub fun add_section(l: *Lowered, s: Added) res[Id[Added], Fail] {
    var held: Added                = s;
    val id:   res[Id[Added], Fail] = table.push[Added](?l.sections, held);
    if (sel id.err) { val dropped: err[Fail] = sink.release(?held.bytes); }
    ret id;
}

# a label at `p`
pub fun label(l: *Lowered, p: Place) res[Id[Place], Fail] {
    ret table.push[Place](?l.labels, p);
}

pub fun add_fixup(l: *Lowered, f: Fixup) res[Id[Fixup], Fail] {
    ret table.push[Fixup](?l.fixups, f);
}

# a symbol named `name` at the start of the added section `s`
pub fun add_named(l: *Lowered, s: Id[Added], name: str) res[Id[Named], Fail] {
    ret table.push[Named](?l.named, Named{section: s, name: name});
}

pub fun section_at(l: *Lowered, id: Id[Added]) *Added {
    ret table.at[Added](?l.sections, id);
}

pub fun label_at(l: *Lowered, id: Id[Place]) *Place {
    ret table.at[Place](?l.labels, id);
}

pub fun fixup_at(l: *Lowered, id: Id[Fixup]) *Fixup {
    ret table.at[Fixup](?l.fixups, id);
}

pub fun mark(l: *Lowered) Mark {
    ret Mark{
        sections: table.count[Added](?l.sections),
        labels:   table.count[Place](?l.labels),
        fixups:   table.count[Fixup](?l.fixups),
        named:    table.count[Named](?l.named),
    };
}

# give back everything added since `m`
pub fun rollback(l: *Lowered, m: Mark) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = m.sections;
    for (i < table.count[Added](?l.sections)) {
        val r: err[Fail] = sink.release(?table.at[Added](?l.sections, table.nth[Added](i)).bytes);
        if (sel r.err && sel first.ok) { first = r; }
        i = i + 1;
    }
    table.truncate[Added](?l.sections, m.sections);
    table.truncate[Place](?l.labels, m.labels);
    table.truncate[Fixup](?l.fixups, m.fixups);
    table.truncate[Named](?l.named, m.named);
    ret first;
}

# add what `l` holds to `o`: each section as a section of `o`, one kept with a
# leader in an associative group of its own name that the leader leads, each
# label as a local symbol with no name at its place, each named symbol as a
# local symbol of no type at its section's start, a local symbol with no name
# at the start of each added section a fixup aims at, and each fixup as a
# relocation of its section naming those symbols. a refusal leaves `o` as it
# was, and an empty record adds nothing
pub fun apply(o: *Object, l: *Lowered) err[Fail] {
    if (empty(l)) { ret err[Fail].ok{}; }
    val names: usize      = intern.count(?o.names);
    val bytes: usize      = store.size(?o.store);
    val secs:  usize      = table.count[Section](?o.sections);
    val syms:  usize      = table.count[Symbol](?o.symbols);
    val rels:  usize      = table.count[Reloc](?o.relocs);
    val grps:  usize      = table.count[Group](?o.groups);
    var at:    Table[u32] = table.make[u32](o.sections.a);
    var r:     err[Fail]  = applied(o, l, secs, syms, ?at);
    r = fail.kept(r, table.release[u32](?at));
    if (sel r.err) {
        val back: err[Fail] = intern.truncate(?o.names, names);
        store.truncate(?o.store, bytes);
        table.truncate[Section](?o.sections, secs);
        table.truncate[Symbol](?o.symbols, syms);
        table.truncate[Reloc](?o.relocs, rels);
        table.truncate[Group](?o.groups, grps);
        if (sel back.err) { ret back; }
    }
    ret r;
}

# the section of `o` that added section `x`, the `i`th, became, kept with its
# leader when it names one
fun led(o: *Object, x: *Added, secs: usize, i: usize, name: Id[Name]) err[Fail] {
    if (sel x.leader.none) { ret err[Fail].ok{}; }
    val lead: Id[Section] = x.leader.some;
    if (lead.index::usize >= secs) { ret err[Fail].err{fail.malformed("an added section is kept with a section the object does not have")}; }
    val g: res[Id[Group], Fail] = object.add_group(o, Group{signature: name, rule: ?group.ASSOCIATE, leader: opt[Id[Section]].some{lead}});
    if (sel g.err) { ret err[Fail].err{g.err}; }
    val s: *Section = object.section_at(o, table.nth[Section](secs + i));
    s.group = opt[Id[Group]].some{g.ok};
    s.owner = opt[Id[Section]].some{lead};
    ret err[Fail].ok{};
}

# a local symbol of no type named `name` at `p`
fun local(o: *Object, name: Id[Name], p: Place) res[Id[Symbol], Fail] {
    ret object.add_symbol(o, Symbol{
        name:       name,
        binding:    ?symbol.LOCAL,
        visibility: ?symbol.DEFAULT,
        kind:       ?symbol.NOTYPE,
        def:        Definition.placed{p},
    });
}

# the symbol a fixup aiming at `t` names, adding the symbol at an added
# section's start the first time a fixup aims at it. `at` holds, per added
# section, that symbol plus one
fun aimed(o: *Object, t: Aim, secs: usize, syms: usize, at: *Table[u32], nameless: Id[Name]) res[Id[Symbol], Fail] {
    if (sel t.label) { ret res[Id[Symbol], Fail].ok{table.nth[Symbol](syms + t.label.index::usize)}; }
    or (sel t.symbol) {
        if (t.symbol.index::usize >= syms) { ret res[Id[Symbol], Fail].err{fail.malformed("a fixup names a symbol the object does not have")}; }
        ret res[Id[Symbol], Fail].ok{t.symbol};
    }
    val k:    usize = t.added.index::usize;
    val slot: *u32  = ?table.items[u32](at)[k];
    if (@slot != 0) { ret res[Id[Symbol], Fail].ok{table.nth[Symbol]((@slot - 1)::usize)}; }
    val y: res[Id[Symbol], Fail] = local(o, nameless, Place{section: table.nth[Section](secs + k), offset: 0});
    if (sel y.err) { ret y; }
    @slot = y.ok.index + 1;
    ret y;
}

fun applied(o: *Object, l: *Lowered, secs: usize, syms: usize, at: *Table[u32]) err[Fail] {
    val rs: err[Fail] = table.reserve[Section](?o.sections, table.count[Added](?l.sections));
    if (sel rs.err) { ret rs; }
    val ry: err[Fail] = table.reserve[Symbol](?o.symbols, table.count[Place](?l.labels) + table.count[Named](?l.named) + table.count[Added](?l.sections));
    if (sel ry.err) { ret ry; }
    val rr: err[Fail] = table.reserve[Reloc](?o.relocs, table.count[Fixup](?l.fixups));
    if (sel rr.err) { ret rr; }
    var i: usize = 0;
    for (i < table.count[Added](?l.sections)) {
        val x:  *Added              = section_at(l, table.nth[Added](i));
        val nm: res[Id[Name], Fail] = object.name_str(o, x.name);
        if (sel nm.err) { ret err[Fail].err{nm.err}; }
        val held: res[Contents, Fail] = object.own(o, sink.data(?x.bytes), sink.len(?x.bytes));
        if (sel held.err) { ret err[Fail].err{held.err}; }
        val s: res[Id[Section], Fail] = object.add_section(o, Section{
            name:        opt[Id[Name]].some{nm.ok},
            kind:        x.kind,
            flags:       x.flags,
            align:       x.align,
            contents:    held.ok,
            disposition: x.disposition,
        });
        if (sel s.err) { ret err[Fail].err{s.err}; }
        val k: err[Fail] = led(o, x, secs, i, nm.ok);
        if (sel k.err) { ret k; }
        i = i + 1;
    }
    val ga: res[Id[u32], Fail] = table.grow[u32](at, table.count[Added](?l.sections));
    if (sel ga.err) { ret err[Fail].err{ga.err}; }
    val nameless: res[Id[Name], Fail] = object.name_str(o, "");
    if (sel nameless.err) { ret err[Fail].err{nameless.err}; }
    i = 0;
    for (i < table.count[Place](?l.labels)) {
        val y: res[Id[Symbol], Fail] = local(o, nameless.ok, @label_at(l, table.nth[Place](i)));
        if (sel y.err) { ret err[Fail].err{y.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Named](?l.named)) {
        val n:  *Named              = table.at[Named](?l.named, table.nth[Named](i));
        val nm: res[Id[Name], Fail] = object.name_str(o, n.name);
        if (sel nm.err) { ret err[Fail].err{nm.err}; }
        val y: res[Id[Symbol], Fail] = local(o, nm.ok, Place{section: table.nth[Section](secs + n.section.index::usize), offset: 0});
        if (sel y.err) { ret err[Fail].err{y.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.count[Fixup](?l.fixups)) {
        val f:     *Fixup          = fixup_at(l, table.nth[Fixup](i));
        var minus: opt[Id[Symbol]] = opt[Id[Symbol]].none{};
        if (sel f.minus.some) {
            val m: res[Id[Symbol], Fail] = aimed(o, f.minus.some, secs, syms, at, nameless.ok);
            if (sel m.err) { ret err[Fail].err{m.err}; }
            minus = opt[Id[Symbol]].some{m.ok};
        }
        val y: res[Id[Symbol], Fail] = aimed(o, f.target, secs, syms, at, nameless.ok);
        if (sel y.err) { ret err[Fail].err{y.err}; }
        val r: res[Id[Reloc], Fail] = object.add_reloc(o, Reloc{
            section: table.nth[Section](secs + f.section.index::usize),
            offset:  f.offset,
            kind:    f.kind,
            target:  Target.symbol{y.ok},
            addend:  f.addend,
            minus:   minus,
        });
        if (sel r.err) { ret err[Fail].err{r.err}; }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# give back every section's bytes and the tables, reporting the first refusal
pub fun release(l: *Lowered) err[Fail] {
    var first: err[Fail] = rollback(l, Mark{});
    val s:     err[Fail] = table.release[Added](?l.sections);
    val b:     err[Fail] = table.release[Place](?l.labels);
    val f:     err[Fail] = table.release[Fixup](?l.fixups);
    val n:     err[Fail] = table.release[Named](?l.named);
    if (sel first.err) { ret first; }
    if (sel s.err)     { ret s; }
    if (sel b.err)     { ret b; }
    if (sel f.err)     { ret f; }
    ret n;
}
