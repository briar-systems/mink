# what a relocated table states of its own fields, for a reader decoding it
#
# a table of an object holds zeros or addends where a relocation will write,
# so a pointer, an advance or a string offset in it means what the relocation
# at its field says. a format's conversion hands a reader the table's bytes,
# its relocations by the format's own symbol numbers and a way to ask what
# those numbers are, and nothing here asks which format the table came from.
# a field two records patch is the distance between their targets, as the
# difference relocations of code the linker may resize are. every record must
# be read: one no field accounts for states something the reader did not.

use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.base.table.Table;
use mink.bytes.reader.Order;
use mink.model.object.Section;
use mink.model.object.Symbol;
use mink.model.reloc.Kind;

# a relocation of the table
# ---
# offset: the field it patches
# kind:   what it computes
# symbol: the symbol it names, as the format numbers its symbols
# addend: its addend
# minus:  it subtracts its target, as a difference's second record does
# taken:  a field of the table accounts for it
pub rec Patch {
    offset: u64;
    kind:   *Kind;
    symbol: u32;
    addend: i64;
    minus:  bool;
    taken:  bool;
}

# where a symbol lies
# ---
# section: the section, as the format numbers its sections
# offset:  its offset there
# size:    the size of the section
# code:    the section holds code
pub rec Located {
    section: u32;
    offset:  u64;
    size:    u64;
    code:    bool;
}

# what a table's reader asks of the format reading the file
# ---
# ctx:      the format's state
# locate:   where a symbol lies, none for a symbol placed in no section of the
#           neutral object
# named:    whether a symbol has a neutral form
# symbol:   the neutral symbol of a symbol, none before the symbols are read
# section:  the neutral section of a section, none before the sections are read
# contents: the bytes of a section, none where they are not held plain
# by_name:  the bytes of the section of a name, none for none
pub rec Source {
    ctx:      ptr;
    locate:   fun(ptr, u32) opt[Located];
    named:    fun(ptr, u32) bool;
    symbol:   fun(ptr, u32) opt[Id[Symbol]];
    section:  fun(ptr, u32) opt[Id[Section]];
    contents: fun(ptr, u32) opt[Bytes];
    by_name:  fun(ptr, str) opt[Bytes];
}

# a table to read
# ---
# bytes:   its bytes
# order:   the byte order they are in
# address: the bytes of an address of the file's architecture
# patches: its relocations, ascending by offset
# source:  what the reader asks the format
pub rec Read {
    bytes:   Bytes;
    order:   Order;
    address: u8;
    patches: Table[Patch];
    source:  Source;
}

fun order_patches(a: *Patch, b: *Patch) i64 {
    if (a.offset < b.offset) { ret -1; }
    if (a.offset > b.offset) { ret 1; }
    ret 0;
}

# put the relocations of `r` in the order its fields are found by
pub fun sorted(r: *Read) {
    sort.sort_by[Patch](table.items[Patch](?r.patches), table.count[Patch](?r.patches), order_patches);
}

# forget which relocations a pass over the table took
pub fun begin(r: *Read) {
    var i: usize = 0;
    for (i < table.count[Patch](?r.patches)) {
        table.items[Patch](?r.patches)[i].taken = false;
        i                                       = i + 1;
    }
}

# the index of the first relocation of `r` at or past `offset`
fun first_at(r: *Read, offset: u64) usize {
    var lo: usize = 0;
    var hi: usize = table.count[Patch](?r.patches);
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (table.items[Patch](?r.patches)[mid].offset < offset) { lo = mid + 1; }
        or                                                       { hi = mid; }
    }
    ret lo;
}

# how many relocations patch the field at `offset`, the first at `at`
fun patching(r: *Read, at: usize, offset: u64) usize {
    var n: usize = 0;
    for (at + n < table.count[Patch](?r.patches) && table.items[Patch](?r.patches)[at + n].offset == offset) { n = n + 1; }
    ret n;
}

# the one relocation that patches the field at `offset`, none for a field
# none patches. a field a difference patches holds no one target, which a
# reader that asks this cannot state
pub fun plain(r: *Read, offset: u64) res[opt[*Patch], Fail] {
    val at: usize = first_at(r, offset);
    val n:  usize = patching(r, at, offset);
    if (n == 0) { ret res[opt[*Patch], Fail].ok{opt[*Patch].none{}}; }
    val p: *Patch = ?table.items[Patch](?r.patches)[at];
    if (n != 1 || p.minus) { ret res[opt[*Patch], Fail].err{fail.at_offset(fail.unsupported("a pointer field holds a difference"), offset)}; }
    p.taken = true;
    ret res[opt[*Patch], Fail].ok{opt[*Patch].some{p}};
}

# where the target of `p` lies, none for a symbol the object places nowhere
pub fun target(r: *Read, p: *Patch) opt[Located] {
    val l: opt[Located] = r.source.locate(r.source.ctx, p.symbol);
    if (sel l.none) { ret l; }
    var out: Located = l.some;
    val at:  i128    = out.offset::i128 + p.addend::i128;
    if (at < 0 || at > 0x7fff_ffff_ffff_ffff) { ret opt[Located].none{}; }
    out.offset = at::u64;
    ret opt[Located].some{out};
}

# the distance a difference states in the field at `offset`, none for a field
# none patches. anything but one difference between two places of one section
# is refused as unsupported
pub fun distance(r: *Read, offset: u64) res[opt[u64], Fail] {
    val at: usize = first_at(r, offset);
    val n:  usize = patching(r, at, offset);
    if (n == 0) { ret res[opt[u64], Fail].ok{opt[u64].none{}}; }
    if (n != 2) { ret res[opt[u64], Fail].err{fail.at_offset(fail.unsupported("a distance is patched by other than one difference"), offset)}; }
    var plus:  *Patch = ?table.items[Patch](?r.patches)[at];
    var minus: *Patch = ?table.items[Patch](?r.patches)[at + 1];
    if (plus.minus) {
        val swap: *Patch = plus;
        plus  = minus;
        minus = swap;
    }
    if (plus.minus || !minus.minus) { ret res[opt[u64], Fail].err{fail.at_offset(fail.unsupported("a distance is patched by other than one difference"), offset)}; }
    val to:   opt[Located] = target(r, plus);
    val from: opt[Located] = target(r, minus);
    if (sel to.none)   { ret res[opt[u64], Fail].err{fail.at_offset(fail.unsupported("a difference names a place the object does not hold"), offset)}; }
    if (sel from.none) { ret res[opt[u64], Fail].err{fail.at_offset(fail.unsupported("a difference names a place the object does not hold"), offset)}; }
    if (to.some.section != from.some.section || to.some.offset < from.some.offset) {
        ret res[opt[u64], Fail].err{fail.at_offset(fail.unsupported("a difference does not run forward within one section"), offset)};
    }
    plus.taken  = true;
    minus.taken = true;
    ret res[opt[u64], Fail].ok{opt[u64].some{to.some.offset - from.some.offset}};
}

# refuse a table with a relocation no field accounted for as unsupported
pub fun done(r: *Read) err[Fail] {
    var i: usize = 0;
    for (i < table.count[Patch](?r.patches)) {
        val p: *Patch = ?table.items[Patch](?r.patches)[i];
        i = i + 1;
        if (!p.taken) { ret err[Fail].err{fail.at_offset(fail.unsupported("a relocation patches a field the reader does not state"), p.offset)}; }
    }
    ret err[Fail].ok{};
}

# whether a failure leaves the table as held bytes: everything but a refused
# allocation, what the rule on the parse shell holds raw and what an optional
# decoding of bytes the object keeps anyway cannot state
pub fun held(f: Fail) bool {
    ret !fail.is_refused(f);
}
