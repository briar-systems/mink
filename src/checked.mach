# checked arithmetic over the counts, sizes and offsets an input declares
#
# every declared quantity is untrusted, so every sum and product over them
# goes through these, and an overflow is a failure at `at`.

use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

use mink.lib.fail;
use mink.lib.fail.Fail;
use mink.lib.fail.Location;

pub fun add(at: Location, a: u64, b: u64) res[u64, Fail] {
    val sum: u64 = a + b;
    if (sum < a) { ret res[u64, Fail].err{placed(fail.overflow("sum overflows 64 bits"), at)}; }
    ret res[u64, Fail].ok{sum};
}

pub fun sub(at: Location, a: u64, b: u64) res[u64, Fail] {
    if (b > a) { ret res[u64, Fail].err{placed(fail.overflow("difference is negative"), at)}; }
    ret res[u64, Fail].ok{a - b};
}

pub fun mul(at: Location, a: u64, b: u64) res[u64, Fail] {
    if (a != 0 && b > 0xffff_ffff_ffff_ffffu64 / a) {
        ret res[u64, Fail].err{placed(fail.overflow("product overflows 64 bits"), at)};
    }
    ret res[u64, Fail].ok{a * b};
}

# `v` rounded up to `align`, a power of two. an alignment that is not one is
# malformed input
pub fun align_up(at: Location, v: u64, align: u64) res[u64, Fail] {
    if (align == 0 || (align & (align - 1)) != 0) {
        ret res[u64, Fail].err{placed(fail.malformed("alignment is not a power of two"), at)};
    }
    val r: res[u64, Fail] = add(at, v, align - 1);
    if (sel r.err) { ret r; }
    ret res[u64, Fail].ok{r.ok & ~(align - 1)};
}

# `v` as a host size
pub fun to_usize(at: Location, v: u64) res[usize, Fail] {
    if (v > (~(0::usize))::u64) {
        ret res[usize, Fail].err{placed(fail.overflow("value exceeds the host address space"), at)};
    }
    ret res[usize, Fail].ok{v::usize};
}

fun placed(f: Fail, at: Location) Fail {
    var out: Fail = f;
    out.at = at;
    ret out;
}

test checked__add_and_mul_refuse_overflow {
    val at:  Location = Location{offset: 8, placed: true};
    val max: u64      = 0xffff_ffff_ffff_ffffu64;

    val s: res[u64, Fail] = add(at, max - 1, 1);
    if (sel s.err)   { ret 1; }
    if (s.ok != max) { ret 1; }
    val so: res[u64, Fail] = add(at, max, 1);
    if (sel so.ok)                  { ret 1; }
    if (!sel so.err.cause.overflow) { ret 1; }
    if (so.err.at.offset != 8)      { ret 1; }

    val p: res[u64, Fail] = mul(at, 0x1_0000_0000, 0xffff_ffff);
    if (sel p.err)                        { ret 1; }
    if (p.ok != 0xffff_ffff_0000_0000u64) { ret 1; }
    val po: res[u64, Fail] = mul(at, 0x1_0000_0000, 0x1_0000_0000);
    if (sel po.ok)                  { ret 1; }
    if (!sel po.err.cause.overflow) { ret 1; }
    ret 0;
}
