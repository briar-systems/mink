# the linking rules of PE/COFF: how an image is laid out and bound
#
# an input section merges into the output section named by its name up to a
# $, ordered there by what follows it, as .CRT$XCA before .CRT$XCU. every
# loaded section starts on a section alignment boundary in memory and a file
# alignment boundary in the file, so offsets and addresses need not agree.
#
# an import binds through the import address table of the DLL that defines
# it, so no definition preempts another image's, nothing is copied and
# symbols carry no versions. a reference to an `__imp_` cell reads the
# import's address table slot, a call to an imported function goes through a
# thunk that jumps through that slot, and imported data is reached only
# through its cell. an address the image holds gets a base relocation,
# writable or not. the rows follow link.exe, first match deciding.

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;

use mink.catalog.arch.Arch;
use mink.link.dynamic;
use mink.link.dynamic.Axis;
use mink.link.dynamic.Row;
use mink.link.kind;
use mink.link.layout.Class;
use mink.link.layout.Load;
use mink.link.layout.Rules;
use mink.model.reloc;
use mink.model.section;

val CODE:  Load = Load{name: "code", flags: section.ALLOC | section.EXEC};
val CONST: Load = Load{name: "rdata", flags: section.ALLOC};
val DATA:  Load = Load{name: "data", flags: section.ALLOC | section.WRITE};

val LOADED: section.Flags = section.ALLOC | section.WRITE | section.EXEC;

val CLASS_COUNT: usize              = 6;
val CLASSES:     [CLASS_COUNT]Class = [CLASS_COUNT]Class{
    Class{flags: section.ALLOC | section.EXEC, flag_mask: LOADED, load: opt[*Load].some{?CODE}},
    Class{flags: section.ALLOC, flag_mask: LOADED, load: opt[*Load].some{?CONST}},
    Class{flags: section.ALLOC | section.WRITE, flag_mask: LOADED, roles: section.RELRO, role_mask: section.RELRO, load: opt[*Load].some{?DATA}},
    Class{flags: section.ALLOC | section.WRITE, flag_mask: LOADED, roles: section.BITS, role_mask: section.BITS, load: opt[*Load].some{?DATA}},
    Class{flags: section.ALLOC | section.WRITE, flag_mask: LOADED, roles: 0, role_mask: section.BITS, load: opt[*Load].some{?DATA}},
    Class{flags: 0, flag_mask: section.ALLOC, load: opt[*Load].none{}},
};

# the DOS header and stub, the PE signature, the COFF header, the optional
# header of PE32+ or PE32 with its data directories, and a section header for
# every output section
fun header(a: *Arch, segments: u64, sections: u64) u64 {
    if (a.pointer_bytes == 8) { ret 64 + 64 + 4 + 20 + 240 + 40 * sections; }
    ret 64 + 64 + 4 + 20 + 224 + 40 * sections;
}

# the default SectionAlignment and FileAlignment of the PE specification
pub val LAYOUT: Rules = Rules{
    stems:         nil,
    stem_count:    0,
    joint:         0,
    cut:           '$',
    classes:       ?CLASSES[0],
    class_count:   CLASS_COUNT,
    commons:       ".bss",
    congruent:     false,
    section_align: 0x1000,
    file_align:    0x200,
    header:        header,
    sections:      opt[u64].some{1},
};

val LATE:  u64 = dynamic.BOUND;
val FIXED: u64 = dynamic.ABSOLUTE | dynamic.UNDEFINED;

val DYNAMIC_COUNT: usize              = 16;
val DYNAMIC_ROWS:  [DYNAMIC_COUNT]Row = [DYNAMIC_COUNT]Row{
    Row{kind: Axis{need: reloc.MARKER}, outcome: ?dynamic.STATIC},
    Row{kind: Axis{need: reloc.LOADER}, outcome: ?dynamic.REFUSED, reason: "an object holds a relocation only a loader applies"},
    Row{target: Axis{need: dynamic.IMPORTED}, output: Axis{deny: kind.IMPORTS}, outcome: ?dynamic.REFUSED, reason: "an output no loader binds cannot import from a shared library"},
    Row{target: Axis{need: dynamic.RESOLVER}, outcome: ?dynamic.REFUSED, reason: "the format has no indirect functions"},
    Row{target: Axis{need: dynamic.THREAD | LATE}, outcome: ?dynamic.REFUSED, reason: "thread-local data of another image cannot be referred to"},
    Row{kind: Axis{need: reloc.GOT}, outcome: ?dynamic.REFUSED, reason: "the format has no GOT"},
    Row{target: Axis{need: dynamic.CELL | LATE}, outcome: ?dynamic.GOT_BIND},
    Row{
        kind:    Axis{need: reloc.ABS},
        site:    Axis{need: dynamic.WORD},
        target:  Axis{need: LATE | dynamic.CODE},
        output:  Axis{need: kind.PIC},
        outcome: ?dynamic.PLT_BIND_REBASE,
    },
    Row{
        kind:    Axis{need: reloc.ABS},
        target:  Axis{need: LATE | dynamic.CODE},
        output:  Axis{need: kind.PIC},
        outcome: ?dynamic.REFUSED,
        reason:  "an absolute reference narrower than an address cannot be made position independent",
    },
    Row{target: Axis{need: LATE | dynamic.CODE}, outcome: ?dynamic.PLT_BIND},
    Row{target: Axis{need: LATE | dynamic.DATA}, outcome: ?dynamic.REFUSED, reason: "imported data is reached only through its import address cell"},
    Row{target: Axis{need: LATE}, outcome: ?dynamic.REFUSED, reason: "a reference of this kind cannot reach a symbol the loader binds"},
    Row{kind: Axis{need: reloc.ABS}, site: Axis{need: dynamic.WORD}, target: Axis{deny: FIXED}, output: Axis{need: kind.PIC}, outcome: ?dynamic.REBASE},
    Row{kind: Axis{need: reloc.ABS}, site: Axis{need: dynamic.LOW}, outcome: ?dynamic.STATIC},
    Row{kind: Axis{need: reloc.ABS}, target: Axis{deny: FIXED}, output: Axis{need: kind.PIC}, outcome: ?dynamic.REFUSED, reason: "an absolute reference narrower than an address cannot be made position independent"},
    Row{outcome: ?dynamic.STATIC},
};

pub val DYNAMIC: dynamic.Rules = dynamic.Rules{name: "coff", caps: 0, rows: ?DYNAMIC_ROWS[0], count: DYNAMIC_COUNT};
