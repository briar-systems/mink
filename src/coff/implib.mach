# the writer of a Windows import library
#
# an import library for a DLL is an archive of the three members that make the
# DLL's import descriptor and one short import object for every export, in the
# Windows archive variant with its two linker members. the descriptor, the
# null descriptor and the null thunk are COFF objects, built here from the
# machine's row of the targets. a symbol table names `__imp_<name>` for every
# export and `<name>` for the exports that are code.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;
use std.memory;

use ar_model: mink.ar.model;
use mink.ar.model.Archive;
use ar_read: mink.ar.read;
use mink.ar.write;
use mink.ar.write.Source;
use mink.checked;
use mink.coff.import;
use mink.coff.import.Export;
use mink.coff.import.Import;
use coff_model: mink.coff.model;
use coff_read:  mink.coff.read;
use mink.coff.read.Parsed;
use mink.coff.tables;
use mink.coff.tables.Blob;
use mink.coff.tables.Constant;
use mink.fail;
use mink.fail.Fail;
use mink.fail.Location;
use mink.format.contract.Input;
use mink.reader.LITTLE;
use mink.sink;
use mink.sink.Sink;
use mink.store.Bytes;
use mink.store.Span;
use mink.table;
use mink.table.Id;
use mink.table.Table;

# what an import descriptor needs of a machine
# ---
# machines: the machine types the row serves
# count:    how many there are
# rebase:   the relocation of an address without the image base
# pointer:  the bytes of a thunk
# align:    the section alignment of a thunk table
# flags:    the header characteristic its objects carry, nil for none
pub rec Target {
    machines: **Constant;
    count:    usize;
    rebase:   *Constant;
    pointer:  usize;
    align:    *Constant;
    flags:    *Constant;
}

val X64_MACHINES:   [1]*Constant = [1]*Constant{?tables.IMAGE_FILE_MACHINE_AMD64};
val ARM64_MACHINES: [2]*Constant = [2]*Constant{?tables.IMAGE_FILE_MACHINE_ARM64, ?tables.IMAGE_FILE_MACHINE_ARM64EC};
val X86_MACHINES:   [1]*Constant = [1]*Constant{?tables.IMAGE_FILE_MACHINE_I386};
val ARM_MACHINES:   [1]*Constant = [1]*Constant{?tables.IMAGE_FILE_MACHINE_ARMNT};

pub val TARGET_COUNT: usize = 4;

pub val TARGETS: [TARGET_COUNT]Target = [TARGET_COUNT]Target{
    Target{machines: ?X64_MACHINES[0], count: 1, rebase: ?tables.IMAGE_REL_AMD64_ADDR32NB, pointer: 8, align: ?tables.IMAGE_SCN_ALIGN_8BYTES},
    Target{machines: ?ARM64_MACHINES[0], count: 2, rebase: ?tables.IMAGE_REL_ARM64_ADDR32NB, pointer: 8, align: ?tables.IMAGE_SCN_ALIGN_8BYTES},
    Target{machines: ?X86_MACHINES[0], count: 1, rebase: ?tables.IMAGE_REL_I386_DIR32NB, pointer: 4, align: ?tables.IMAGE_SCN_ALIGN_4BYTES, flags: ?tables.IMAGE_FILE_32BIT_MACHINE},
    Target{machines: ?ARM_MACHINES[0], count: 1, rebase: ?tables.IMAGE_REL_ARM_ADDR32NB, pointer: 4, align: ?tables.IMAGE_SCN_ALIGN_4BYTES, flags: ?tables.IMAGE_FILE_32BIT_MACHINE},
};

# the row that serves `machine`, none for a machine without one
pub fun target_of(machine: u64) opt[*Target] {
    var t: usize = 0;
    for (t < TARGET_COUNT) {
        var m: usize = 0;
        for (m < TARGETS[t].count) {
            if (TARGETS[t].machines[m].value == machine) { ret opt[*Target].some{?TARGETS[t]}; }
            m = m + 1;
        }
        t = t + 1;
    }
    ret opt[*Target].none{};
}

# a relocation of a section
rec Rel {
    offset: u32;
    symbol: u32;
}

# a section to write: the digit of its `.idata$` name and what it holds
rec Part {
    digit:  u8;
    flags:  u64;
    data:   Bytes;
    nul:    bool;
    relocs: *Rel;
    count:  usize;
}

# the bytes a part takes
fun part_len(p: *Part) usize {
    if (p.nul) { ret p.data.len + 1; }
    ret p.data.len;
}

# the name of the `.idata$` section `digit` in the eight bytes at `name`
fun section_name(digit: u8, name: *u8) {
    var i: usize = 0;
    for (i < tables.IDATA_STEM.len) {
        name[i] = tables.IDATA_STEM.data[i];
        i       = i + 1;
    }
    name[i] = '0' + digit;
}

# a symbol to write
rec Sym {
    name:    Bytes;
    section: u16;
    class:   *Constant;
}

# a COFF object of `parts` and `syms`, relocations of the type `rebase`
fun object(a: *A.Allocator, t: *Target, machine: u16, parts: *Part, np: usize, syms: *Sym, ns: usize, out: *Sink) err[Fail] {
    val at:     Location = Location{record: "import member"};
    val header: u64      = coff_model.REGULAR.header.size::u64;
    var pos:    u64      = header + coff_model.SECTION_SIZE * np::u64;
    var heads:  Sink     = sink.make(a, LITTLE);
    var k:      usize    = 0;
    for (k < np) {
        val p:       *Part = ?parts[k];
        var raw_ptr: u64   = 0;
        if (part_len(p) != 0) { raw_ptr = pos; }
        val after: res[u64, Fail] = checked.add(at, pos, part_len(p)::u64);
        if (sel after.err) {
            val dropped: err[Fail] = sink.release(?heads);
            ret err[Fail].err{after.err};
        }
        var reloc_ptr: u64 = 0;
        if (p.count != 0) { reloc_ptr = after.ok; }
        val next: res[u64, Fail] = checked.add(at, after.ok, p.count::u64 * coff_model.RELOC_SIZE);
        if (sel next.err) {
            val dropped: err[Fail] = sink.release(?heads);
            ret err[Fail].err{next.err};
        }
        pos = next.ok;
        val w: err[Fail] = section_header(?heads, p, raw_ptr, reloc_ptr);
        if (sel w.err) {
            val dropped: err[Fail] = sink.release(?heads);
            ret w;
        }
        k = k + 1;
    }
    var names:  Sink      = sink.make(a, LITTLE);
    var table_: Sink      = sink.make(a, LITTLE);
    val sym:    err[Fail] = symbols(syms, ns, ?table_, ?names);
    var first:  err[Fail] = sym;
    if (sel sym.ok) { first = lay(out, t, machine, parts, np, syms, ns, pos, ?heads, ?table_, ?names); }
    val r1: err[Fail] = sink.release(?heads);
    val r2: err[Fail] = sink.release(?names);
    val r3: err[Fail] = sink.release(?table_);
    if (sel first.err) { ret first; }
    if (sel r1.err)    { ret r1; }
    if (sel r2.err)    { ret r2; }
    ret r3;
}

fun section_header(heads: *Sink, p: *Part, raw_ptr: u64, reloc_ptr: u64) err[Fail] {
    var name: [8]u8;
    section_name(p.digit, ?name[0]);
    val w1: err[Fail] = sink.bytes(heads, ?name[0], 8);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = sink.u32(heads, 0);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = sink.u32(heads, 0);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = sink.u32(heads, part_len(p)::u32);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = sink.u32(heads, raw_ptr::u32);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = sink.u32(heads, reloc_ptr::u32);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = sink.u32(heads, 0);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = sink.u16(heads, p.count::u16);
    if (sel w8.err) { ret w8; }
    val w9: err[Fail] = sink.u16(heads, 0);
    if (sel w9.err) { ret w9; }
    ret sink.u32(heads, p.flags::u32);
}

# the symbol records and the string table that holds the names too long for one
fun symbols(syms: *Sym, ns: usize, records: *Sink, names: *Sink) err[Fail] {
    val w0: err[Fail] = sink.u32(names, 0);
    if (sel w0.err) { ret w0; }
    var k: usize = 0;
    for (k < ns) {
        val s: *Sym = ?syms[k];
        if (s.name.len <= 8) {
            val w1: err[Fail] = sink.bytes(records, s.name.data, s.name.len);
            if (sel w1.err) { ret w1; }
            val w2: err[Fail] = sink.zeros(records, 8 - s.name.len);
            if (sel w2.err) { ret w2; }
        }
        or {
            val w3: err[Fail] = sink.u32(records, 0);
            if (sel w3.err) { ret w3; }
            val w4: err[Fail] = sink.u32(records, sink.len(names)::u32);
            if (sel w4.err) { ret w4; }
            val w5: err[Fail] = sink.bytes(names, s.name.data, s.name.len);
            if (sel w5.err) { ret w5; }
            val w6: err[Fail] = sink.u8(names, 0);
            if (sel w6.err) { ret w6; }
        }
        val w7: err[Fail] = sink.u32(records, 0);
        if (sel w7.err) { ret w7; }
        val w8: err[Fail] = sink.u16(records, s.section);
        if (sel w8.err) { ret w8; }
        val w9: err[Fail] = sink.u16(records, 0);
        if (sel w9.err) { ret w9; }
        val w10: err[Fail] = sink.u8(records, s.class.value::u8);
        if (sel w10.err) { ret w10; }
        val w11: err[Fail] = sink.u8(records, 0);
        if (sel w11.err) { ret w11; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

fun lay(out: *Sink, t: *Target, machine: u16, parts: *Part, np: usize, syms: *Sym, ns: usize, symtab: u64, heads: *Sink, records: *Sink, names: *Sink) err[Fail] {
    val limit: u64 = 0xffff_ffffu64;
    val strs:  u64 = sink.len(names)::u64;
    if (symtab > limit || strs > limit || symtab + sink.len(records)::u64 + strs > limit) {
        ret err[Fail].err{fail.in_record(fail.overflow("import member does not fit 32 bit offsets"), "import member")};
    }
    val w1: err[Fail] = sink.u16(out, machine);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = sink.u16(out, np::u16);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = sink.u32(out, 0);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = sink.u32(out, symtab::u32);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = sink.u32(out, ns::u32);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = sink.u16(out, 0);
    if (sel w6.err) { ret w6; }
    var characteristics: u16 = 0;
    if (t.flags != nil) { characteristics = t.flags.value::u16; }
    val w7: err[Fail] = sink.u16(out, characteristics);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = sink.bytes(out, sink.data(heads), sink.len(heads));
    if (sel w8.err) { ret w8; }
    var k: usize = 0;
    for (k < np) {
        val p:  *Part     = ?parts[k];
        val w9: err[Fail] = sink.bytes(out, p.data.data, p.data.len);
        if (sel w9.err) { ret w9; }
        if (p.nul) {
            val w9b: err[Fail] = sink.u8(out, 0);
            if (sel w9b.err) { ret w9b; }
        }
        var j: usize = 0;
        for (j < p.count) {
            val w10: err[Fail] = sink.u32(out, p.relocs[j].offset);
            if (sel w10.err) { ret w10; }
            val w11: err[Fail] = sink.u32(out, p.relocs[j].symbol);
            if (sel w11.err) { ret w11; }
            val w12: err[Fail] = sink.u16(out, t.rebase.value::u16);
            if (sel w12.err) { ret w12; }
            j = j + 1;
        }
        k = k + 1;
    }
    val w13: err[Fail] = sink.bytes(out, sink.data(records), sink.len(records));
    if (sel w13.err) { ret w13; }
    val w14: err[Fail] = sink.u32(out, strs::u32);
    if (sel w14.err) { ret w14; }
    ret sink.bytes(out, ?sink.data(names)[4], sink.len(names) - 4);
}

# everything an archive is built from: the bytes of every member and of every
# symbol name, and where each member's names lie
# ---
# bodies: the member bytes, one after the other
# labels: the symbol name bytes, one after the other
# pieces: the member bytes and symbol names of every member
# names:  where each symbol name lies in the labels
rec Pool {
    bodies: Sink;
    labels: Sink;
    pieces: Table[Piece];
    names:  Table[Span];
}

# one member: its bytes in the bodies and its first name and how many follow
rec Piece {
    body:  Span;
    first: usize;
    count: usize;
}

fun pool(a: *A.Allocator) Pool {
    ret Pool{bodies: sink.make(a, LITTLE), labels: sink.make(a, LITTLE), pieces: table.make[Piece](a), names: table.make[Span](a)};
}

fun free(p: *Pool) err[Fail] {
    var first: err[Fail] = sink.release(?p.bodies);
    val r1:    err[Fail] = sink.release(?p.labels);
    if (sel first.ok && sel r1.err) { first = r1; }
    val r2: err[Fail] = table.release[Piece](?p.pieces);
    if (sel first.ok && sel r2.err) { first = r2; }
    val r3: err[Fail] = table.release[Span](?p.names);
    if (sel first.ok && sel r3.err) { first = r3; }
    ret first;
}

# a symbol name of `head`, `body` and `tail` that the member being built defines
fun define(p: *Pool, head: Bytes, body: Bytes, tail: Bytes) err[Fail] {
    val start: usize     = sink.len(?p.labels);
    val w1:    err[Fail] = sink.bytes(?p.labels, head.data, head.len);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = sink.bytes(?p.labels, body.data, body.len);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = sink.bytes(?p.labels, tail.data, tail.len);
    if (sel w3.err) { ret w3; }
    val pushed: res[Id[Span], Fail] = table.push[Span](?p.names, Span{start: start, len: sink.len(?p.labels) - start});
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

# the member that starts at `body` and defines the `count` names after `first`
fun seal(p: *Pool, body: usize, first: usize) err[Fail] {
    val pushed: res[Id[Piece], Fail] = table.push[Piece](?p.pieces, Piece{
        body:  Span{start: body, len: sink.len(?p.bodies) - body},
        first: first,
        count: table.count[Span](?p.names) - first,
    });
    if (sel pushed.err) { ret err[Fail].err{pushed.err}; }
    ret err[Fail].ok{};
}

fun flags(align: u64) u64 {
    ret tables.IMAGE_SCN_CNT_INITIALIZED_DATA.value | tables.IMAGE_SCN_MEM_READ.value | tables.IMAGE_SCN_MEM_WRITE.value | align;
}

# the part of the name of the DLL before its last dot
fun stem(dll: Bytes) Bytes {
    var n: usize = dll.len;
    for (n > 1 && dll.data[n - 1] != '.') { n = n - 1; }
    if (n <= 1) { ret dll; }
    ret Bytes{data: dll.data, len: n - 1};
}

fun view(b: Blob) Bytes {
    ret Bytes{data: b.data, len: b.len};
}

# the import descriptor of the DLL: its table addresses and its name
fun descriptor(a: *A.Allocator, t: *Target, machine: u16, dll: Bytes, thunk: Bytes, id: Bytes, out: *Sink) err[Fail] {
    var zero: [20]u8;
    var n2:   [8]u8;
    var n4:   [8]u8;
    var n5:   [8]u8;
    var n6:   [8]u8;
    section_name(tables.IDATA_DESCRIPTOR.value::u8, ?n2[0]);
    section_name(tables.IDATA_LOOKUP.value::u8, ?n4[0]);
    section_name(tables.IDATA_ADDRESS.value::u8, ?n5[0]);
    section_name(tables.IDATA_NAME.value::u8, ?n6[0]);
    val rels:  [3]Rel  = [3]Rel{Rel{offset: 12, symbol: 2}, Rel{offset: 0, symbol: 3}, Rel{offset: 16, symbol: 4}};
    val parts: [2]Part = [2]Part{
        Part{digit: tables.IDATA_DESCRIPTOR.value::u8, flags: flags(tables.IMAGE_SCN_ALIGN_4BYTES.value), data: Bytes{data: ?zero[0], len: 20}, relocs: ?rels[0], count: 3},
        Part{digit: tables.IDATA_NAME.value::u8, flags: flags(tables.IMAGE_SCN_ALIGN_2BYTES.value), data: dll, nul: true},
    };
    val syms: [7]Sym = [7]Sym{
        Sym{name: id, section: 1, class: ?tables.IMAGE_SYM_CLASS_EXTERNAL},
        Sym{name: Bytes{data: ?n2[0], len: 8}, section: 1, class: ?tables.IMAGE_SYM_CLASS_SECTION},
        Sym{name: Bytes{data: ?n6[0], len: 8}, section: 2, class: ?tables.IMAGE_SYM_CLASS_STATIC},
        Sym{name: Bytes{data: ?n4[0], len: 8}, section: 0, class: ?tables.IMAGE_SYM_CLASS_SECTION},
        Sym{name: Bytes{data: ?n5[0], len: 8}, section: 0, class: ?tables.IMAGE_SYM_CLASS_SECTION},
        Sym{name: view(tables.NULL_IMPORT_DESCRIPTOR), section: 0, class: ?tables.IMAGE_SYM_CLASS_EXTERNAL},
        Sym{name: thunk, section: 0, class: ?tables.IMAGE_SYM_CLASS_EXTERNAL},
    };
    ret object(a, t, machine, ?parts[0], 2, ?syms[0], 7, out);
}

# the null import descriptor that ends the descriptors of an image
fun terminator(a: *A.Allocator, t: *Target, machine: u16, out: *Sink) err[Fail] {
    var zero:  [20]u8;
    val parts: [1]Part = [1]Part{
        Part{digit: tables.IDATA_TERMINATOR.value::u8, flags: flags(tables.IMAGE_SCN_ALIGN_4BYTES.value), data: Bytes{data: ?zero[0], len: 20}},
    };
    val syms: [1]Sym = [1]Sym{Sym{name: view(tables.NULL_IMPORT_DESCRIPTOR), section: 1, class: ?tables.IMAGE_SYM_CLASS_EXTERNAL}};
    ret object(a, t, machine, ?parts[0], 1, ?syms[0], 1, out);
}

# the null thunk that ends the tables of the DLL
fun null_thunk(a: *A.Allocator, t: *Target, machine: u16, thunk: Bytes, out: *Sink) err[Fail] {
    var zero:  [8]u8;
    val parts: [2]Part = [2]Part{
        Part{digit: tables.IDATA_ADDRESS.value::u8, flags: flags(t.align.value), data: Bytes{data: ?zero[0], len: t.pointer}},
        Part{digit: tables.IDATA_LOOKUP.value::u8, flags: flags(t.align.value), data: Bytes{data: ?zero[0], len: t.pointer}},
    };
    val syms: [1]Sym = [1]Sym{Sym{name: thunk, section: 1, class: ?tables.IMAGE_SYM_CLASS_EXTERNAL}};
    ret object(a, t, machine, ?parts[0], 2, ?syms[0], 1, out);
}

# an import library of `count` exports of the DLL `dll`, for `machine`. the
# exports and the name of the DLL are borrowed for the call
pub fun build(a: *A.Allocator, machine: u16, dll: Bytes, exports: *Export, count: usize) res[Sink, Fail] {
    val target: opt[*Target] = target_of(machine::u64);
    if (sel target.none) {
        ret res[Sink, Fail].err{fail.in_record(fail.unsupported("no import descriptor layout for this machine"), "import library")};
    }
    if (dll.len == 0 || import.hollow(dll)) {
        ret res[Sink, Fail].err{fail.in_record(fail.malformed("DLL name is empty or holds a NUL byte"), "import library")};
    }
    var p:    Pool      = pool(a);
    val made: err[Fail] = members(a, target.some, machine, dll, exports, count, ?p);
    var out:  res[Sink, Fail];
    if (sel made.err) { out = res[Sink, Fail].err{made.err}; }
    or                { out = archive(a, dll, ?p); }
    val freed: err[Fail] = free(?p);
    if (sel out.err) { ret out; }
    if (sel freed.err) {
        val dropped: err[Fail] = sink.release(?out.ok);
        ret res[Sink, Fail].err{freed.err};
    }
    ret out;
}

val NOTHING: [1]u8 = [1]u8{0};

fun empty() Bytes {
    ret Bytes{data: ?NOTHING[0], len: 0};
}

fun members(a: *A.Allocator, t: *Target, machine: u16, dll: Bytes, exports: *Export, count: usize, p: *Pool) err[Fail] {
    val st:    Bytes     = stem(dll);
    var fixed: Sink      = sink.make(a, LITTLE);
    val made:  err[Fail] = members_in(a, t, machine, dll, st, exports, count, p, ?fixed);
    val freed: err[Fail] = sink.release(?fixed);
    if (sel made.err) { ret made; }
    ret freed;
}

fun members_in(a: *A.Allocator, t: *Target, machine: u16, dll: Bytes, st: Bytes, exports: *Export, count: usize, p: *Pool, fixed: *Sink) err[Fail] {
    val w1: err[Fail] = sink.bytes(fixed, tables.IMPORT_DESCRIPTOR_PREFIX.data, tables.IMPORT_DESCRIPTOR_PREFIX.len);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = sink.bytes(fixed, st.data, st.len);
    if (sel w2.err) { ret w2; }
    val cut: usize     = sink.len(fixed);
    val w3:  err[Fail] = sink.bytes(fixed, tables.NULL_THUNK_PREFIX.data, tables.NULL_THUNK_PREFIX.len);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = sink.bytes(fixed, st.data, st.len);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = sink.bytes(fixed, tables.NULL_THUNK_SUFFIX.data, tables.NULL_THUNK_SUFFIX.len);
    if (sel w5.err) { ret w5; }
    val id:    Bytes = Bytes{data: sink.data(fixed), len: cut};
    val thunk: Bytes = Bytes{data: ?sink.data(fixed)[cut], len: sink.len(fixed) - cut};

    var body:  usize     = sink.len(?p.bodies);
    var first: usize     = table.count[Span](?p.names);
    val n1:    err[Fail] = define(p, id, empty(), empty());
    if (sel n1.err) { ret n1; }
    val m1: err[Fail] = descriptor(a, t, machine, dll, thunk, id, ?p.bodies);
    if (sel m1.err) { ret m1; }
    val s1: err[Fail] = seal(p, body, first);
    if (sel s1.err) { ret s1; }

    body  = sink.len(?p.bodies);
    first = table.count[Span](?p.names);
    val n2: err[Fail] = define(p, view(tables.NULL_IMPORT_DESCRIPTOR), empty(), empty());
    if (sel n2.err) { ret n2; }
    val m2: err[Fail] = terminator(a, t, machine, ?p.bodies);
    if (sel m2.err) { ret m2; }
    val s2: err[Fail] = seal(p, body, first);
    if (sel s2.err) { ret s2; }

    body  = sink.len(?p.bodies);
    first = table.count[Span](?p.names);
    val n3: err[Fail] = define(p, thunk, empty(), empty());
    if (sel n3.err) { ret n3; }
    val m3: err[Fail] = null_thunk(a, t, machine, thunk, ?p.bodies);
    if (sel m3.err) { ret m3; }
    val s3: err[Fail] = seal(p, body, first);
    if (sel s3.err) { ret s3; }

    var k: usize = 0;
    for (k < count) {
        val e: *Export = ?exports[k];
        body  = sink.len(?p.bodies);
        first = table.count[Span](?p.names);
        val imp: res[Import, Fail] = import.make(a, machine, dll, e);
        if (sel imp.err) { ret err[Fail].err{fail.in_indexed(imp.err, "export", k::u64)}; }
        var i:   Import          = imp.ok;
        val out: res[Sink, Fail] = import.write(a, ?i);
        if (sel out.err) {
            val dropped: err[Fail] = import.release(?i);
            ret err[Fail].err{out.err};
        }
        var o:  Sink      = out.ok;
        val w6: err[Fail] = sink.bytes(?p.bodies, sink.data(?o), sink.len(?o));
        val r1: err[Fail] = sink.release(?o);
        val r2: err[Fail] = import.release(?i);
        if (sel w6.err) { ret w6; }
        if (sel r1.err) { ret r1; }
        if (sel r2.err) { ret r2; }
        val n4: err[Fail] = define(p, view(tables.IMPORT_POINTER_PREFIX), e.name, empty());
        if (sel n4.err) { ret n4; }
        if (e.kind::u64 == tables.IMPORT_OBJECT_CODE.value) {
            val n5: err[Fail] = define(p, empty(), e.name, empty());
            if (sel n5.err) { ret n5; }
        }
        val s4: err[Fail] = seal(p, body, first);
        if (sel s4.err) { ret s4; }
        k = k + 1;
    }
    ret err[Fail].ok{};
}

# the archive of the pooled members, all named for the DLL
fun archive(a: *A.Allocator, dll: Bytes, p: *Pool) res[Sink, Fail] {
    var names:   Table[Bytes]    = table.make[Bytes](a);
    var sources: Table[Source]   = table.make[Source](a);
    val built:   res[Sink, Fail] = archive_of(dll, p, ?names, ?sources);
    val r1:      err[Fail]       = table.release[Bytes](?names);
    val r2:      err[Fail]       = table.release[Source](?sources);
    if (sel built.err) { ret built; }
    if (sel r1.err) {
        val dropped: err[Fail] = sink.release(?built.ok);
        ret res[Sink, Fail].err{r1.err};
    }
    if (sel r2.err) {
        val dropped: err[Fail] = sink.release(?built.ok);
        ret res[Sink, Fail].err{r2.err};
    }
    ret built;
}

fun archive_of(dll: Bytes, p: *Pool, names: *Table[Bytes], sources: *Table[Source]) res[Sink, Fail] {
    val spans: *Span = table.items[Span](?p.names);
    var k:     usize = 0;
    for (k < table.count[Span](?p.names)) {
        val pushed: res[Id[Bytes], Fail] = table.push[Bytes](names, Bytes{data: ?sink.data(?p.labels)[spans[k].start], len: spans[k].len});
        if (sel pushed.err) { ret res[Sink, Fail].err{pushed.err}; }
        k = k + 1;
    }
    val pieces: *Piece = table.items[Piece](?p.pieces);
    k = 0;
    for (k < table.count[Piece](?p.pieces)) {
        val pushed: res[Id[Source], Fail] = table.push[Source](sources, Source{
            name:  dll,
            data:  Bytes{data: ?sink.data(?p.bodies)[pieces[k].body.start], len: pieces[k].body.len},
            names: ?table.items[Bytes](names)[pieces[k].first],
            count: pieces[k].count,
        });
        if (sel pushed.err) { ret res[Sink, Fail].err{pushed.err}; }
        k = k + 1;
    }
    ret write.build(names.a, ?write.WINDOWS_AR, table.items[Source](sources), table.count[Source](sources));
}

fun same(b: Bytes, want: str) bool {
    ret b.len == str_len(want) && memory.raw_equal(b.data::ptr, want::ptr, b.len);
}

fun text(s: str) Bytes {
    ret Bytes{data: s::*u8, len: str_len(s)};
}

# the member `at` of an archive read from `in`, its payload as an input
fun member_input(arch: *Archive, at: usize) Input {
    val m: *ar_model.Member = table.at[ar_model.Member](?arch.members, table.nth[ar_model.Member](at));
    val b: Bytes            = ar_model.payload(arch, m);
    ret Input{file: "x.lib", data: b.data, len: b.len};
}

test implib__is_written_from_an_export_list {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:       *A.Allocator = T.allocator_of(?t);
    val exports: [4]Export    = [4]Export{
        Export{name: text("foo"), kind: tables.IMPORT_OBJECT_CODE.value::u16, name_type: tables.IMPORT_OBJECT_NAME.value::u16},
        Export{name: text("_bar@8"), ordinal: 5, kind: tables.IMPORT_OBJECT_CODE.value::u16, name_type: tables.IMPORT_OBJECT_NAME_UNDECORATE.value::u16},
        Export{name: text("dat"), kind: tables.IMPORT_OBJECT_DATA.value::u16, name_type: tables.IMPORT_OBJECT_NAME.value::u16},
        Export{name: text("ord"), ordinal: 7, kind: tables.IMPORT_OBJECT_CODE.value::u16, name_type: tables.IMPORT_OBJECT_ORDINAL.value::u16},
    };
    var lib: res[Sink, Fail] = build(a, tables.IMAGE_FILE_MACHINE_AMD64.value::u16, text("mydll.dll"), ?exports[0], 4);
    if (sel lib.err) { ret 1; }
    var in:  Input               = Input{file: "x.lib", data: sink.data(?lib.ok), len: sink.len(?lib.ok)};
    val got: res[*Archive, Fail] = ar_read.read(a, ?in);
    if (sel got.err) { ret 1; }
    val arch: *Archive = got.ok;
    if (table.count[ar_model.Member](?arch.members) != 9) { ret 1; }
    val first:  *ar_model.Member = table.at[ar_model.Member](?arch.members, table.nth[ar_model.Member](0));
    val second: *ar_model.Member = table.at[ar_model.Member](?arch.members, table.nth[ar_model.Member](1));
    if (first.role != ?ar_model.SYMTAB || second.role != ?ar_model.LINKER2) { ret 1; }
    if (first.entries != 10 || second.entries != 10)                        { ret 1; }
    val e0: *ar_model.Entry = table.at[ar_model.Entry](?arch.entries, table.nth[ar_model.Entry](first.first));
    val e1: *ar_model.Entry = table.at[ar_model.Entry](?arch.entries, table.nth[ar_model.Entry](first.first + 1));
    if (!same(ar_model.bytes(arch, ?e0.name), "__IMPORT_DESCRIPTOR_mydll")) { ret 1; }
    if (!same(ar_model.bytes(arch, ?e1.name), "__NULL_IMPORT_DESCRIPTOR"))  { ret 1; }

    var at: usize = 2;
    for (at < 9) {
        val m: *ar_model.Member = table.at[ar_model.Member](?arch.members, table.nth[ar_model.Member](at));
        if (!same(ar_model.bytes(arch, ?m.name), "mydll.dll")) { ret 1; }
        at = at + 1;
    }
    var desc: Input             = member_input(arch, 2);
    val long: res[Parsed, Fail] = coff_read.read(a, ?desc);
    if (sel long.err)          { ret 1; }
    if (!(sel long.ok.object)) { ret 1; }
    val facts: opt[import.Long] = import.long_import(?long.ok.object);
    if (!(sel facts.some))                        { ret 1; }
    if (facts.some.role != ?import.LONG_ROLES[0]) { ret 1; }
    if (!(sel facts.some.dll.some))               { ret 1; }
    if (!same(facts.some.dll.some, "mydll.dll"))  { ret 1; }
    val rl: err[Fail] = coff_model.release(?long.ok.object);
    if (sel rl.err) { ret 1; }

    var shortin: Input             = member_input(arch, 6);
    val short:   res[Parsed, Fail] = coff_read.read(a, ?shortin);
    if (sel short.err)         { ret 1; }
    if (!(sel short.ok.short)) { ret 1; }
    var imp: Import = short.ok.short;
    if (!same(import.bytes(?imp, ?imp.symbol), "_bar@8") || imp.hint != 5) { ret 1; }
    val named: res[opt[Bytes], Fail] = import.imported_name(?imp);
    if (sel named.err)               { ret 1; }
    if (!(sel named.ok.some))        { ret 1; }
    if (!same(named.ok.some, "bar")) { ret 1; }
    val ri: err[Fail] = import.release(?imp);
    if (sel ri.err) { ret 1; }

    val r1: err[Fail] = ar_model.release(arch);
    if (sel r1.err) { ret 1; }
    val r2: err[A.Error] = A.deallocate[Archive](a, arch, 1);
    if (sel r2.err) { ret 1; }
    val r3: err[Fail] = sink.release(?lib.ok);
    if (sel r3.err)            { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
