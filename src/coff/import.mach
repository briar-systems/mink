# the import members of a Windows import library
#
# a library that lets a program link against a DLL holds two member forms.
# a short import object is an anonymous object of version zero: a header, the
# symbol name and the DLL name, and for one name type a third name. it is not
# a COFF object, so it has a model of its own. a long member is an ordinary
# COFF object whose `.idata$` sections hold the import tables of one symbol or
# of the DLL, and is told by those sections.
#
# the model keeps every header field as written, a reserved bit or an unnamed
# code included, and the bytes after the strings, so writing a model gives back
# the bytes it was read from. what a name type means is a row of the rules
# below, read by its code.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;
use std.memory;

use mink.checked;
use mink.coff.model;
use mink.coff.model.Coff;
use mink.coff.model.Section;
use mink.coff.tables;
use mink.coff.tables.Constant;
use mink.fail;
use mink.fail.Fail;
use mink.fail.Location;
use mink.format.contract.Input;
use mink.format.shell;
use mink.reader;
use mink.reader.LITTLE;
use mink.reader.Reader;
use mink.sink;
use mink.sink.Sink;
use mink.slot;
use mink.slot.Slot;
use mink.store;
use mink.store.Bytes;
use mink.store.Held;
use mink.store.Store;
use mink.table;

val SIG1:      Slot = Slot{offset: 0, width: 2};
val SIG2:      Slot = Slot{offset: 2, width: 2};
val VERSION:   Slot = Slot{offset: 4, width: 2};
val MACHINE:   Slot = Slot{offset: 6, width: 2};
val TIMESTAMP: Slot = Slot{offset: 8, width: 4};
val SIZE:      Slot = Slot{offset: 12, width: 4};
val HINT:      Slot = Slot{offset: 16, width: 2};
val BITS:      Slot = Slot{offset: 18, width: 2};

# a short import object
# ---
# version:   the header version, below the first bigobj version
# machine:   the machine type as written
# timestamp: the time stamp as written
# size:      SizeOfData as written, the bytes the strings lie in
# hint:      the ordinal for an import by ordinal, the hint otherwise
# bits:      the type and name type fields with the reserved bits between
# symbol:    the symbol name, without its NUL
# dll:       the name of the DLL, without its NUL
# export_as: the third name, for the name type that takes one
# rest:      every byte after the strings, the rest of SizeOfData and anything
#            beyond it
# store:     the bytes the model owns
pub rec Import {
    version:   u16;
    machine:   u16;
    timestamp: u32;
    size:      u32;
    hint:      u16;
    bits:      u16;
    symbol:    Held;
    dll:       Held;
    export_as: opt[Held];
    rest:      Held;
    store:     Store;
}

pub fun release(i: *Import) err[Fail] {
    ret store.release(?i.store);
}

# the bytes of `h`
pub fun bytes(i: *Import, h: *Held) Bytes {
    ret store.bytes(?i.store, h);
}

# the import type code, a row of IMPORT_TYPE when it is a known one
pub fun kind(i: *Import) u64 {
    ret i.bits::u64 & tables.IMPORT_TYPE_MASK.value;
}

# the name type code, a row of IMPORT_NAME when it is a known one
pub fun name_type(i: *Import) u64 {
    ret (i.bits::u64 >> tables.IMPORT_NAME_TYPE_SHIFT.value) & tables.IMPORT_NAME_TYPE_MASK.value;
}

# whether an anonymous object header of `version` is a short import object
# and not a bigobj
pub fun is_short(version: u64) bool {
    ret version < tables.BIGOBJ_MIN_VERSION.value;
}

# how a name type derives the name the DLL exports from the symbol name
# ---
# code:       the name type
# named:      whether the DLL exports the symbol by a name at all
# prefixed:   whether a leading prefix character is dropped
# undecorate: whether the name is cut at the first decoration character
# extra:      whether the name is a third string of the object
pub rec NameRule {
    code:       *Constant;
    named:      bool;
    prefixed:   bool;
    undecorate: bool;
    extra:      bool;
}

pub val RULE_COUNT: usize = 5;

# indexed by code
pub val RULES: [RULE_COUNT]NameRule = [RULE_COUNT]NameRule{
    NameRule{code: ?tables.IMPORT_OBJECT_ORDINAL},
    NameRule{code: ?tables.IMPORT_OBJECT_NAME, named: true},
    NameRule{code: ?tables.IMPORT_OBJECT_NAME_NO_PREFIX, named: true, prefixed: true},
    NameRule{code: ?tables.IMPORT_OBJECT_NAME_UNDECORATE, named: true, prefixed: true, undecorate: true},
    NameRule{code: ?tables.IMPORT_OBJECT_NAME_EXPORTAS, named: true, extra: true},
};

# the rule of name type `code`, none for a code the specification does not name
pub fun rule_of(code: u64) opt[*NameRule] {
    if (code >= RULE_COUNT::u64 || RULES[code::usize].code.value != code) { ret opt[*NameRule].none{}; }
    ret opt[*NameRule].some{?RULES[code::usize]};
}

# the name the DLL exports `i` by, none for an import by ordinal. the name is
# a part of the symbol name or the third name, so nothing is copied
pub fun imported_name(i: *Import) res[opt[Bytes], Fail] {
    val rule: opt[*NameRule] = rule_of(name_type(i));
    if (sel rule.none) {
        ret res[opt[Bytes], Fail].err{fail.in_record(fail.unsupported("import name type is not one the specification names"), "import object")};
    }
    val r: *NameRule = rule.some;
    if (!r.named) { ret res[opt[Bytes], Fail].ok{opt[Bytes].none{}}; }
    if (r.extra) {
        if (sel i.export_as.none) {
            ret res[opt[Bytes], Fail].err{fail.in_record(fail.malformed("import name type takes a third name the object lacks"), "import object")};
        }
        ret res[opt[Bytes], Fail].ok{opt[Bytes].some{bytes(i, ?i.export_as.some)}};
    }
    var name: Bytes = bytes(i, ?i.symbol);
    if (r.prefixed && name.len > 0 && prefix(name.data[0])) {
        name = Bytes{data: ?name.data[1], len: name.len - 1};
    }
    if (r.undecorate) {
        var n: usize = 0;
        for (n < name.len && name.data[n] != tables.IMPORT_UNDECORATE_CHAR.value::u8) { n = n + 1; }
        name = Bytes{data: name.data, len: n};
    }
    ret res[opt[Bytes], Fail].ok{opt[Bytes].some{name}};
}

fun prefix(c: u8) bool {
    var k: usize = 0;
    for (k < tables.IMPORT_PREFIX_CHARS.len) {
        if (tables.IMPORT_PREFIX_CHARS.data[k] == c) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the short import object `in` holds. the model borrows its names from `in`
pub fun read(a: *A.Allocator, in: *Input) res[Import, Fail] {
    val m: res[Import, Fail] = parse(a, in);
    if (sel m.err) { ret res[Import, Fail].err{fail.in_file(m.err, in.file)}; }
    ret m;
}

fun parse(a: *A.Allocator, in: *Input) res[Import, Fail] {
    var r:    Reader         = shell.open(in, LITTLE);
    val head: res[*u8, Fail] = reader.bytes(?r, tables.IMPORT_HEADER_SIZE.value);
    if (sel head.err) { ret res[Import, Fail].err{fail.in_record(head.err, "import header")}; }
    val p: *u8 = head.ok;
    if (slot.field(p, SIG1, LITTLE) != tables.ANON_SIG1.value || slot.field(p, SIG2, LITTLE) != tables.ANON_SIG2.value) {
        ret res[Import, Fail].err{fail.at_offset(fail.in_record(fail.malformed("signature of a short import object missing"), "import header"), SIG1.offset::u64)};
    }
    val version: u64 = slot.field(p, VERSION, LITTLE);
    if (!is_short(version)) {
        ret res[Import, Fail].err{fail.at_offset(fail.in_record(fail.malformed("anonymous object is not a short import object"), "import header"), VERSION.offset::u64)};
    }
    var i: Import = Import{
        version:   version::u16,
        machine:   slot.field(p, MACHINE, LITTLE)::u16,
        timestamp: slot.field(p, TIMESTAMP, LITTLE)::u32,
        size:      slot.field(p, SIZE, LITTLE)::u32,
        hint:      slot.field(p, HINT, LITTLE)::u16,
        bits:      slot.field(p, BITS, LITTLE)::u16,
        store:     store.make(a),
    };
    val region: res[Reader, Fail] = reader.sub(?r, tables.IMPORT_HEADER_SIZE.value, i.size::u64);
    if (sel region.err) {
        ret res[Import, Fail].err{fail.at_offset(fail.in_record(fail.truncated("import data runs past the end of the file"), "import header"), SIZE.offset::u64)};
    }
    var x:   Reader           = region.ok;
    val sym: res[Bytes, Fail] = text(?x, "symbol name");
    if (sel sym.err) { ret res[Import, Fail].err{sym.err}; }
    i.symbol = Held.borrowed{sym.ok};
    val dll: res[Bytes, Fail] = text(?x, "DLL name");
    if (sel dll.err) { ret res[Import, Fail].err{dll.err}; }
    i.dll = Held.borrowed{dll.ok};
    val rule: opt[*NameRule] = rule_of(name_type(?i));
    if (sel rule.some) {
        if (rule.some.extra) {
            val extra: res[Bytes, Fail] = text(?x, "export name");
            if (sel extra.err) { ret res[Import, Fail].err{extra.err}; }
            i.export_as = opt[Held].some{Held.borrowed{extra.ok}};
        }
    }
    val at: usize = tables.IMPORT_HEADER_SIZE.value::usize + x.pos;
    i.rest = Held.borrowed{Bytes{data: ?in.data[at], len: in.len - at}};
    ret res[Import, Fail].ok{i};
}

# the NUL terminated string at the reader, which moves past it
fun text(r: *Reader, record: str) res[Bytes, Fail] {
    var end: usize = r.pos;
    for (end < r.len && r.data[end] != 0) { end = end + 1; }
    if (end == r.len) {
        ret res[Bytes, Fail].err{fail.at_offset(fail.in_record(fail.malformed("string is not terminated inside the import data"), record), reader.offset(r))};
    }
    val v: Bytes = Bytes{data: ?r.data[r.pos], len: end - r.pos};
    r.pos = end + 1;
    ret res[Bytes, Fail].ok{v};
}

# the model written as it was read
pub fun write(a: *A.Allocator, i: *Import) res[Sink, Fail] {
    var out: Sink      = sink.make(a, LITTLE);
    val w:   err[Fail] = emit(i, ?out);
    if (sel w.err) {
        val released: err[Fail] = sink.release(?out);
        ret res[Sink, Fail].err{w.err};
    }
    ret res[Sink, Fail].ok{out};
}

fun emit(i: *Import, out: *Sink) err[Fail] {
    val w1: err[Fail] = sink.uint(out, tables.ANON_SIG1.value, SIG1.width::usize);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = sink.uint(out, tables.ANON_SIG2.value, SIG2.width::usize);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = sink.u16(out, i.version);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = sink.u16(out, i.machine);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = sink.u32(out, i.timestamp);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = sink.u32(out, i.size);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = sink.u16(out, i.hint);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = sink.u16(out, i.bits);
    if (sel w8.err) { ret w8; }
    val w9: err[Fail] = string(i, ?i.symbol, out);
    if (sel w9.err) { ret w9; }
    val w10: err[Fail] = string(i, ?i.dll, out);
    if (sel w10.err) { ret w10; }
    if (sel i.export_as.some) {
        val w11: err[Fail] = string(i, ?i.export_as.some, out);
        if (sel w11.err) { ret w11; }
    }
    val rest: Bytes = bytes(i, ?i.rest);
    ret sink.bytes(out, rest.data, rest.len);
}

fun string(i: *Import, h: *Held, out: *Sink) err[Fail] {
    val b: Bytes     = bytes(i, h);
    val w: err[Fail] = sink.bytes(out, b.data, b.len);
    if (sel w.err) { ret w; }
    ret sink.u8(out, 0);
}

# an export of a DLL, as an import library lists it
# ---
# name:      the symbol name an importer spells
# ordinal:   the export ordinal, which is the hint of an import by name
# kind:      the import type code
# name_type: the name type code
# export_as: the name the DLL exports, for the name type that takes one
pub rec Export {
    name:      Bytes;
    ordinal:   u16;
    kind:      u16;
    name_type: u16;
    export_as: opt[Bytes];
}

# the short import object of `e` for `dll`, whose names it borrows
pub fun make(a: *A.Allocator, machine: u16, dll: Bytes, e: *Export) res[Import, Fail] {
    val at:    Location       = Location{record: "import object"};
    val known: opt[*Constant] = tables.name_of(?tables.IMPORT_TYPE, e.kind::u64);
    if (sel known.none) {
        ret res[Import, Fail].err{fail.in_record(fail.malformed("import type is not one the specification names"), "import object")};
    }
    val rule: opt[*NameRule] = rule_of(e.name_type::u64);
    if (sel rule.none) {
        ret res[Import, Fail].err{fail.in_record(fail.malformed("import name type is not one the specification names"), "import object")};
    }
    val r: *NameRule = rule.some;
    if (e.name.len == 0 || dll.len == 0 || hollow(e.name) || hollow(dll)) {
        ret res[Import, Fail].err{fail.in_record(fail.malformed("import names are empty or hold a NUL byte"), "import object")};
    }
    if (!r.named && e.ordinal == 0) {
        ret res[Import, Fail].err{fail.in_record(fail.malformed("import by ordinal has no ordinal"), "import object")};
    }
    if (r.extra != (sel e.export_as.some)) {
        ret res[Import, Fail].err{fail.in_record(fail.malformed("export name does not match the name type"), "import object")};
    }
    var size: u64    = e.name.len::u64 + dll.len::u64 + 2;
    var i:    Import = Import{
        machine: machine,
        hint:    e.ordinal,
        bits:    (e.kind::u64 | (e.name_type::u64 << tables.IMPORT_NAME_TYPE_SHIFT.value))::u16,
        symbol:  Held.borrowed{e.name},
        dll:     Held.borrowed{dll},
        store:   store.make(a),
    };
    if (sel e.export_as.some) {
        if (hollow(e.export_as.some)) {
            ret res[Import, Fail].err{fail.in_record(fail.malformed("import names are empty or hold a NUL byte"), "import object")};
        }
        i.export_as = opt[Held].some{Held.borrowed{e.export_as.some}};
        val sum: res[u64, Fail] = checked.add(at, size, e.export_as.some.len::u64 + 1);
        if (sel sum.err) { ret res[Import, Fail].err{sum.err}; }
        size = sum.ok;
    }
    if (size > 0xffff_ffffu64) { ret res[Import, Fail].err{fail.in_record(fail.overflow("import data does not fit SizeOfData"), "import object")}; }
    i.size = size::u32;
    ret res[Import, Fail].ok{i};
}

# whether `b` holds a NUL byte
pub fun hollow(b: Bytes) bool {
    var k: usize = 0;
    for (k < b.len) {
        if (b.data[k] == 0) { ret true; }
        k = k + 1;
    }
    ret false;
}

# what a long member is, told by the `.idata$` sections it holds
# ---
# name:   how it is spelled
# first:  a section it must hold, named by its digit
# second: another it must hold, nil when none
# hinted: whether the `.idata$6` section is a hint and a name
# dll:    the section that holds the name of the DLL, nil when none does
pub rec LongRole {
    name:   str;
    first:  *Constant;
    second: *Constant;
    hinted: bool;
    dll:    *Constant;
}

pub val LONG_COUNT: usize = 5;

# the first row whose sections the member holds decides
pub val LONG_ROLES: [LONG_COUNT]LongRole = [LONG_COUNT]LongRole{
    LongRole{name: "import descriptor", first: ?tables.IDATA_DESCRIPTOR, dll: ?tables.IDATA_NAME},
    LongRole{name: "import", first: ?tables.IDATA_ADDRESS, second: ?tables.IDATA_NAME, hinted: true},
    LongRole{name: "descriptor tail", first: ?tables.IDATA_DLL, dll: ?tables.IDATA_DLL},
    LongRole{name: "null descriptor", first: ?tables.IDATA_TERMINATOR},
    LongRole{name: "null thunk", first: ?tables.IDATA_LOOKUP, second: ?tables.IDATA_ADDRESS},
};

# what a long member says about its import
# ---
# role: what the member is, nil when no row of the roles holds
# hint: the hint of an import
# name: the name of an import
# dll:  the name of the DLL
pub rec Long {
    role: *LongRole;
    hint: opt[u16];
    name: opt[Bytes];
    dll:  opt[Bytes];
}

# the digit of an `.idata$` section name, none for any other name
fun digit(s: *Section) opt[u8] {
    var k: usize = 0;
    for (k < tables.IDATA_STEM.len) {
        if (s.name[k] != tables.IDATA_STEM.data[k]) { ret opt[u8].none{}; }
        k = k + 1;
    }
    val c: u8 = s.name[k];
    if (c < '0' || c > '9') { ret opt[u8].none{}; }
    ret opt[u8].some{c - '0'};
}

fun held_bytes(m: *Coff, s: *Section) opt[Bytes] {
    if (!(sel s.body.raw)) { ret opt[Bytes].none{}; }
    ret opt[Bytes].some{model.bytes(m, ?s.body.raw)};
}

# the NUL terminated string that starts `b`, none when it has no end
fun terminated(b: Bytes) opt[Bytes] {
    var n: usize = 0;
    for (n < b.len && b.data[n] != 0) { n = n + 1; }
    if (n == b.len) { ret opt[Bytes].none{}; }
    ret opt[Bytes].some{Bytes{data: b.data, len: n}};
}

# what the long import member `m` says, none when it holds no `.idata$`
# section and so is no import member. a fact the member does not state, or
# states in a form that does not parse, is none
pub fun long_import(m: *Coff) opt[Long] {
    var held: [10]opt[Bytes];
    var seen: [10]bool;
    var any:  bool  = false;
    var k:    usize = 0;
    for (k < table.count[Section](?m.sections)) {
        val s: *Section = table.at[Section](?m.sections, table.nth[Section](k));
        val d: opt[u8]  = digit(s);
        if (sel d.some) {
            any          = true;
            seen[d.some] = true;
            held[d.some] = held_bytes(m, s);
        }
        k = k + 1;
    }
    if (!any) { ret opt[Long].none{}; }
    var r: usize = 0;
    for (r < LONG_COUNT) {
        val row: *LongRole = ?LONG_ROLES[r];
        if (seen[row.first.value::usize] && (row.second == nil || seen[row.second.value::usize])) {
            var out: Long = Long{role: row};
            if (row.hinted) { facts(held[tables.IDATA_NAME.value::usize], ?out); }
            if (row.dll != nil) {
                val section: opt[Bytes] = held[row.dll.value::usize];
                if (sel section.some) { out.dll = terminated(section.some); }
            }
            ret opt[Long].some{out};
        }
        r = r + 1;
    }
    ret opt[Long].some{Long{role: nil}};
}

# the hint and the name a hinted section holds
fun facts(b: opt[Bytes], out: *Long) {
    if (!(sel b.some))  { ret; }
    if (b.some.len < 2) { ret; }
    val name: opt[Bytes] = terminated(Bytes{data: ?b.some.data[2], len: b.some.len - 2});
    if (!(sel name.some)) { ret; }
    out.hint = opt[u16].some{(b.some.data[0]::u16) | (b.some.data[1]::u16 << 8)};
    out.name = name;
}

fun same(b: Bytes, want: str) bool {
    ret b.len == str_len(want) && memory.raw_equal(b.data::ptr, want::ptr, b.len);
}

fun view(s: str) Bytes {
    ret Bytes{data: s::*u8, len: str_len(s)};
}

# a short import object with the strings `a`, `b` and, when given, `c`
fun object(out: *Sink, bits: u16, hint: u16, a: str, b: str, c: str) err[Fail] {
    var size: usize = str_len(a) + str_len(b) + 2;
    if (c != nil) { size = size + str_len(c) + 1; }
    val w1: err[Fail] = sink.u16(out, tables.ANON_SIG1.value::u16);
    if (sel w1.err) { ret w1; }
    val w2: err[Fail] = sink.u16(out, tables.ANON_SIG2.value::u16);
    if (sel w2.err) { ret w2; }
    val w3: err[Fail] = sink.u16(out, 0);
    if (sel w3.err) { ret w3; }
    val w4: err[Fail] = sink.u16(out, tables.IMAGE_FILE_MACHINE_AMD64.value::u16);
    if (sel w4.err) { ret w4; }
    val w5: err[Fail] = sink.u32(out, 0);
    if (sel w5.err) { ret w5; }
    val w6: err[Fail] = sink.u32(out, size::u32);
    if (sel w6.err) { ret w6; }
    val w7: err[Fail] = sink.u16(out, hint);
    if (sel w7.err) { ret w7; }
    val w8: err[Fail] = sink.u16(out, bits);
    if (sel w8.err) { ret w8; }
    val w9: err[Fail] = sink.text(out, a);
    if (sel w9.err) { ret w9; }
    val w10: err[Fail] = sink.u8(out, 0);
    if (sel w10.err) { ret w10; }
    val w11: err[Fail] = sink.text(out, b);
    if (sel w11.err) { ret w11; }
    val w12: err[Fail] = sink.u8(out, 0);
    if (sel w12.err) { ret w12; }
    if (c != nil) {
        val w13: err[Fail] = sink.text(out, c);
        if (sel w13.err) { ret w13; }
        ret sink.u8(out, 0);
    }
    ret err[Fail].ok{};
}

test import__short_object_is_read {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator = T.allocator_of(?t);
    val bits: u16          = (tables.IMPORT_OBJECT_DATA.value | (tables.IMPORT_OBJECT_NAME_EXPORTAS.value << tables.IMPORT_NAME_TYPE_SHIFT.value) | 0x100)::u16;
    var out:  Sink         = sink.make(a, LITTLE);
    val b:    err[Fail]    = object(?out, bits, 5, "sym", "my.dll", "other");
    if (sel b.err) { ret 1; }
    val trailer: err[Fail] = sink.u8(?out, 9);
    if (sel trailer.err) { ret 1; }
    var in:  Input             = Input{file: "x.obj", data: sink.data(?out), len: sink.len(?out)};
    val got: res[Import, Fail] = read(a, ?in);
    if (sel got.err) { ret 1; }
    var i: Import = got.ok;
    if (i.version != 0 || i.machine != tables.IMAGE_FILE_MACHINE_AMD64.value || i.hint != 5 || i.bits != bits)    { ret 1; }
    if (kind(?i) != tables.IMPORT_OBJECT_DATA.value || name_type(?i) != tables.IMPORT_OBJECT_NAME_EXPORTAS.value) { ret 1; }
    if (!same(bytes(?i, ?i.symbol), "sym") || !same(bytes(?i, ?i.dll), "my.dll"))                                 { ret 1; }
    if (!(sel i.export_as.some))                                                                                  { ret 1; }
    if (!same(bytes(?i, ?i.export_as.some), "other"))                                                             { ret 1; }
    if (bytes(?i, ?i.rest).len != 1)                                                                              { ret 1; }
    var back: res[Sink, Fail] = write(a, ?i);
    if (sel back.err)                                                                                                              { ret 1; }
    if (sink.len(?back.ok) != sink.len(?out) || !memory.raw_equal(sink.data(?back.ok)::ptr, sink.data(?out)::ptr, sink.len(?out))) { ret 1; }
    val r1: err[Fail] = sink.release(?back.ok);
    if (sel r1.err) { ret 1; }
    val r2: err[Fail] = release(?i);
    if (sel r2.err) { ret 1; }
    val r3: err[Fail] = sink.release(?out);
    if (sel r3.err)            { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

rec Derive {
    code:      *Constant;
    symbol:    str;
    export_as: str;
    want:      str;
}

val DERIVE_COUNT: usize                = 9;
val DERIVES:      [DERIVE_COUNT]Derive = [DERIVE_COUNT]Derive{
    Derive{code: ?tables.IMPORT_OBJECT_ORDINAL, symbol: "_foo@8", want: nil},
    Derive{code: ?tables.IMPORT_OBJECT_NAME, symbol: "_foo@8", want: "_foo@8"},
    Derive{code: ?tables.IMPORT_OBJECT_NAME_NO_PREFIX, symbol: "?foo@@YAXXZ", want: "foo@@YAXXZ"},
    Derive{code: ?tables.IMPORT_OBJECT_NAME_NO_PREFIX, symbol: "_foo@8", want: "foo@8"},
    Derive{code: ?tables.IMPORT_OBJECT_NAME_NO_PREFIX, symbol: "foo", want: "foo"},
    Derive{code: ?tables.IMPORT_OBJECT_NAME_UNDECORATE, symbol: "_foo@8", want: "foo"},
    Derive{code: ?tables.IMPORT_OBJECT_NAME_UNDECORATE, symbol: "@fast@8", want: "fast"},
    Derive{code: ?tables.IMPORT_OBJECT_NAME_UNDECORATE, symbol: "bar", want: "bar"},
    Derive{code: ?tables.IMPORT_OBJECT_NAME_EXPORTAS, symbol: "sym", export_as: "exported", want: "exported"},
};

test import__name_types_derive_the_imported_name {
    var seen: [RULE_COUNT]bool;
    var c:    usize = 0;
    for (c < DERIVE_COUNT) {
        val d: *Derive = ?DERIVES[c];
        var i: Import  = Import{
            bits:   (d.code.value << tables.IMPORT_NAME_TYPE_SHIFT.value)::u16,
            symbol: Held.borrowed{view(d.symbol)},
        };
        if (d.export_as != nil) { i.export_as = opt[Held].some{Held.borrowed{view(d.export_as)}}; }
        val got: res[opt[Bytes], Fail] = imported_name(?i);
        if (sel got.err) { ret 1; }
        if (d.want == nil) {
            if (!(sel got.ok.none)) { ret 1; }
        }
        or {
            if (!(sel got.ok.some))         { ret 1; }
            if (!same(got.ok.some, d.want)) { ret 1; }
        }
        seen[d.code.value::usize] = true;
        c                         = c + 1;
    }
    c = 0;
    for (c < RULE_COUNT) {
        val rule: opt[*NameRule] = rule_of(c::u64);
        if (!seen[c] || sel rule.none) { ret 1; }
        c = c + 1;
    }
    val beyond: opt[*NameRule] = rule_of(RULE_COUNT::u64);
    if (sel beyond.some) { ret 1; }
    ret 0;
}
