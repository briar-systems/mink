# the PE/COFF model, every byte of a COFF object or a PE image
#
# one model serves a regular COFF object, a bigobj and a PE32 or PE32+ image.
# a Shape names the object layout, whose rows give the file header and the
# symbol records, and for an image the optional header layout, whose rows give
# the place of each field and the address width. every field is held as its raw
# number, so a value in a reserved or unnamed range is kept as it was. what the
# numbers mean is the tables', never the model's.
#
# the file is an ordered list of extents tiling it from its first byte to its
# last: the MS-DOS stub, the PE signature, the file header, the optional
# header, the section header table, a section's bytes, a section's relocations
# or line numbers, the symbol table, the string table, records outside every
# section such as the certificate table, or raw bytes no record covers, such as
# padding and gaps. a section's bytes are either raw or a tiling of typed
# pieces, record after record, one piece for every structure a data directory
# names and raw pieces between them. a writer gives back every input byte for
# byte.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;

use mink.checked;
use mink.coff.tables;
use mink.coff.tables.Constant;
use mink.fail;
use mink.fail.Fail;
use mink.fail.Location;
use mink.slot.Slot;
use mink.store;
use mink.store.Bytes;
use mink.store.Held;
use mink.store.Raw;
use mink.store.Store;
use mink.store.Why;
use mink.table;
use mink.table.Id;
use mink.table.Table;

# the file header, regular or bigobj
pub rec HeaderShape {
    size:            usize;
    version:         Slot;
    machine:         Slot;
    nsections:       Slot;
    timestamp:       Slot;
    symtab_ptr:      Slot;
    nsymbols:        Slot;
    opt_size:        Slot;
    characteristics: Slot;
    class_id:        Slot;
    size_of_data:    Slot;
    flags:           Slot;
    meta_size:       Slot;
    meta_offset:     Slot;
}

# a symbol record, whose size is also the size of an auxiliary record
pub rec SymbolShape {
    size:    usize;
    name:    Slot;
    value:   Slot;
    section: Slot;
    type:    Slot;
    class:   Slot;
    naux:    Slot;
}

# the layout of an object file: regular or bigobj
pub rec ObjectShape {
    header: HeaderShape;
    symbol: SymbolShape;
}

# the optional header of an image, up to and including NumberOfRvaAndSizes
# ---
# size:  the bytes before the data directories
# magic: the value of the magic field that selects this layout
# addr:  the width of an address, which is also the width of a thunk
pub rec ImageShape {
    size:              usize;
    magic:             *Constant;
    addr:              usize;
    linker_major:      Slot;
    linker_minor:      Slot;
    code_size:         Slot;
    init_data_size:    Slot;
    uninit_data_size:  Slot;
    entry:             Slot;
    code_base:         Slot;
    data_base:         Slot;
    image_base:        Slot;
    section_alignment: Slot;
    file_alignment:    Slot;
    os_major:          Slot;
    os_minor:          Slot;
    image_major:       Slot;
    image_minor:       Slot;
    subsystem_major:   Slot;
    subsystem_minor:   Slot;
    win32_version:     Slot;
    image_size:        Slot;
    headers_size:      Slot;
    checksum:          Slot;
    subsystem:         Slot;
    dll_flags:         Slot;
    stack_reserve:     Slot;
    stack_commit:      Slot;
    heap_reserve:      Slot;
    heap_commit:       Slot;
    loader_flags:      Slot;
    dir_count:         Slot;
}

# a file's layouts. an object file has no image layout until its optional
# header is read
pub rec Shape {
    object: *ObjectShape;
    image:  opt[*ImageShape];
}

pub val REGULAR: ObjectShape = ObjectShape{
    header: HeaderShape{
        size:            20,
        machine:         Slot{offset: 0, width: 2},
        nsections:       Slot{offset: 2, width: 2},
        timestamp:       Slot{offset: 4, width: 4},
        symtab_ptr:      Slot{offset: 8, width: 4},
        nsymbols:        Slot{offset: 12, width: 4},
        opt_size:        Slot{offset: 16, width: 2},
        characteristics: Slot{offset: 18, width: 2},
    },
    symbol: SymbolShape{
        size:    18,
        name:    Slot{offset: 0, width: 8},
        value:   Slot{offset: 8, width: 4},
        section: Slot{offset: 12, width: 2},
        type:    Slot{offset: 14, width: 2},
        class:   Slot{offset: 16, width: 1},
        naux:    Slot{offset: 17, width: 1},
    },
};

pub val BIGOBJ: ObjectShape = ObjectShape{
    header: HeaderShape{
        size:         56,
        version:      Slot{offset: 4, width: 2},
        machine:      Slot{offset: 6, width: 2},
        timestamp:    Slot{offset: 8, width: 4},
        class_id:     Slot{offset: 12, width: 16},
        size_of_data: Slot{offset: 28, width: 4},
        flags:        Slot{offset: 32, width: 4},
        meta_size:    Slot{offset: 36, width: 4},
        meta_offset:  Slot{offset: 40, width: 4},
        nsections:    Slot{offset: 44, width: 4},
        symtab_ptr:   Slot{offset: 48, width: 4},
        nsymbols:     Slot{offset: 52, width: 4},
    },
    symbol: SymbolShape{
        size:    20,
        name:    Slot{offset: 0, width: 8},
        value:   Slot{offset: 8, width: 4},
        section: Slot{offset: 12, width: 4},
        type:    Slot{offset: 16, width: 2},
        class:   Slot{offset: 18, width: 1},
        naux:    Slot{offset: 19, width: 1},
    },
};

pub val PE32: ImageShape = ImageShape{
    size:              96,
    magic:             ?tables.IMAGE_NT_OPTIONAL_HDR32_MAGIC,
    addr:              4,
    linker_major:      Slot{offset: 2, width: 1},
    linker_minor:      Slot{offset: 3, width: 1},
    code_size:         Slot{offset: 4, width: 4},
    init_data_size:    Slot{offset: 8, width: 4},
    uninit_data_size:  Slot{offset: 12, width: 4},
    entry:             Slot{offset: 16, width: 4},
    code_base:         Slot{offset: 20, width: 4},
    data_base:         Slot{offset: 24, width: 4},
    image_base:        Slot{offset: 28, width: 4},
    section_alignment: Slot{offset: 32, width: 4},
    file_alignment:    Slot{offset: 36, width: 4},
    os_major:          Slot{offset: 40, width: 2},
    os_minor:          Slot{offset: 42, width: 2},
    image_major:       Slot{offset: 44, width: 2},
    image_minor:       Slot{offset: 46, width: 2},
    subsystem_major:   Slot{offset: 48, width: 2},
    subsystem_minor:   Slot{offset: 50, width: 2},
    win32_version:     Slot{offset: 52, width: 4},
    image_size:        Slot{offset: 56, width: 4},
    headers_size:      Slot{offset: 60, width: 4},
    checksum:          Slot{offset: 64, width: 4},
    subsystem:         Slot{offset: 68, width: 2},
    dll_flags:         Slot{offset: 70, width: 2},
    stack_reserve:     Slot{offset: 72, width: 4},
    stack_commit:      Slot{offset: 76, width: 4},
    heap_reserve:      Slot{offset: 80, width: 4},
    heap_commit:       Slot{offset: 84, width: 4},
    loader_flags:      Slot{offset: 88, width: 4},
    dir_count:         Slot{offset: 92, width: 4},
};

pub val PE32PLUS: ImageShape = ImageShape{
    size:              112,
    magic:             ?tables.IMAGE_NT_OPTIONAL_HDR64_MAGIC,
    addr:              8,
    linker_major:      Slot{offset: 2, width: 1},
    linker_minor:      Slot{offset: 3, width: 1},
    code_size:         Slot{offset: 4, width: 4},
    init_data_size:    Slot{offset: 8, width: 4},
    uninit_data_size:  Slot{offset: 12, width: 4},
    entry:             Slot{offset: 16, width: 4},
    code_base:         Slot{offset: 20, width: 4},
    image_base:        Slot{offset: 24, width: 8},
    section_alignment: Slot{offset: 32, width: 4},
    file_alignment:    Slot{offset: 36, width: 4},
    os_major:          Slot{offset: 40, width: 2},
    os_minor:          Slot{offset: 42, width: 2},
    image_major:       Slot{offset: 44, width: 2},
    image_minor:       Slot{offset: 46, width: 2},
    subsystem_major:   Slot{offset: 48, width: 2},
    subsystem_minor:   Slot{offset: 50, width: 2},
    win32_version:     Slot{offset: 52, width: 4},
    image_size:        Slot{offset: 56, width: 4},
    headers_size:      Slot{offset: 60, width: 4},
    checksum:          Slot{offset: 64, width: 4},
    subsystem:         Slot{offset: 68, width: 2},
    dll_flags:         Slot{offset: 70, width: 2},
    stack_reserve:     Slot{offset: 72, width: 8},
    stack_commit:      Slot{offset: 80, width: 8},
    heap_reserve:      Slot{offset: 88, width: 8},
    heap_commit:       Slot{offset: 96, width: 8},
    loader_flags:      Slot{offset: 104, width: 4},
    dir_count:         Slot{offset: 108, width: 4},
};

# the file header. a regular object has no version, class id, data size, flags
# or metadata, and a bigobj has no optional header or characteristics. nsections,
# nsymbols and opt_size are held as written, and the tables hold what they count
pub rec Header {
    version:         u16;
    machine:         u16;
    nsections:       u32;
    timestamp:       u32;
    symtab_ptr:      u32;
    nsymbols:        u32;
    opt_size:        u16;
    characteristics: u16;
    class_id:        [16]u8;
    size_of_data:    u32;
    flags:           u32;
    meta_size:       u32;
    meta_offset:     u32;
}

# one entry of the data directory array
pub rec DataDirectory {
    rva:  u32;
    size: u32;
}

# the optional header of an image. the count of directories is the table's
# count, and `trailing` holds the bytes of the optional header after them. a
# field the layout does not have, such as the base of data of PE32+, is zero
pub rec Image {
    magic:             u16;
    linker_major:      u8;
    linker_minor:      u8;
    code_size:         u32;
    init_data_size:    u32;
    uninit_data_size:  u32;
    entry:             u32;
    code_base:         u32;
    data_base:         u32;
    image_base:        u64;
    section_alignment: u32;
    file_alignment:    u32;
    os_major:          u16;
    os_minor:          u16;
    image_major:       u16;
    image_minor:       u16;
    subsystem_major:   u16;
    subsystem_minor:   u16;
    win32_version:     u32;
    image_size:        u32;
    headers_size:      u32;
    checksum:          u32;
    subsystem:         u16;
    dll_flags:         u16;
    stack_reserve:     u64;
    stack_commit:      u64;
    heap_reserve:      u64;
    heap_commit:       u64;
    loader_flags:      u32;
    dirs:              Table[DataDirectory];
    trailing:          Raw;
}

# the optional header: absent, an image's, or bytes that are neither layout
pub tag Optional: u8 {
    absent;
    image: Image;
    raw:   Raw;
}

# a symbol table entry. `name` is the short name or four zero bytes and a
# string table offset. `section` is the section number sign extended from its
# width. a symbol is followed by `naux` auxiliary records. `section` is held as
# written for the writer, and a consumer resolves it only through symbol_section
pub rec Symbol {
    name:    [8]u8;
    value:   u32;
    section: i32;
    type:    u16;
    class:   u8;
    naux:    u8;
}

# each auxiliary record is the size of a symbol record, and the bytes after the
# last named field are held in `unused`, as many as the larger size leaves. the
# symbol indices, the section number and the line number pointer of the records
# are held as written for the writer, and a consumer resolves them only through
# function_tag, function_next, function_line, block_next, weak_fallback,
# associative_section and clr_symbol

# a function definition
pub rec FunctionAux {
    tag_index:     u32;
    total_size:    u32;
    line_ptr:      u32;
    next_function: u32;
    unused:        [4]u8;
}

# .bf and .ef
pub rec BlockAux {
    unused_head:   [4]u8;
    line:          u16;
    unused_mid:    [6]u8;
    next_function: u32;
    unused_tail:   [4]u8;
}

# a weak external
pub rec WeakAux {
    tag_index:       u32;
    characteristics: u32;
    unused:          [12]u8;
}

# a section definition. `number_high` is the high half of the section number in
# a bigobj and unused bytes in a regular object
pub rec SectionAux {
    length:      u32;
    nreloc:      u16;
    nlines:      u16;
    checksum:    u32;
    number:      u16;
    selection:   u8;
    unused:      u8;
    number_high: u16;
    unused_tail: [2]u8;
}

# a CLR token definition
pub rec ClrAux {
    aux_type:     u8;
    reserved:     u8;
    symbol_index: u32;
    unused:       [14]u8;
}

# an auxiliary record
# ---
# function: a function definition
# block:    .bf and .ef
# weak:     a weak external
# file:     a file name, held as its bytes
# section:  a section definition
# clr:      a CLR token definition
# raw:      an auxiliary record no other variant describes, and why
pub tag Aux: u8 {
    function: FunctionAux;
    block:    BlockAux;
    weak:     WeakAux;
    file:     [20]u8;
    section:  SectionAux;
    clr:      ClrAux;
    raw:      RawAux;
}

# the bytes of an auxiliary record no other variant describes, and why
pub rec RawAux {
    bytes: [20]u8;
    why:   Why;
}

# a record of the symbol table, in file order, so an index into the table is an
# index into this one
pub tag Entry: u8 {
    symbol: Symbol;
    aux:    Aux;
}

# a relocation. `vaddr` is the count of relocations in the first of an extended
# count. `symbol` is held as written for the writer, and a consumer resolves it
# only through reloc_symbol
pub rec Reloc {
    vaddr:  u32;
    symbol: u32;
    type:   u16;
}

# a line number. `key` is a symbol index when `line` is zero and an address
# otherwise. a consumer resolves a symbol index only through line_symbol
pub rec Line {
    key:  u32;
    line: u16;
}

pub rec ExportDirectory {
    characteristics: u32;
    timestamp:       u32;
    major:           u16;
    minor:           u16;
    name_rva:        u32;
    ordinal_base:    u32;
    address_count:   u32;
    name_count:      u32;
    address_rva:     u32;
    name_rva_table:  u32;
    ordinal_rva:     u32;
}

# an import descriptor. the last one of a table is all zero
pub rec ImportDescriptor {
    lookup_rva:      u32;
    timestamp:       u32;
    forwarder_chain: u32;
    name_rva:        u32;
    thunk_rva:       u32;
}

# a hint and a name, `name` holding the name, its terminator and the padding
# that makes the record a whole number of words
pub rec HintName {
    hint: u16;
    name: Held;
}

# a delay import descriptor. the last one of a table is all zero
pub rec DelayImport {
    attributes: u32;
    name_rva:   u32;
    module_rva: u32;
    thunk_rva:  u32;
    lookup_rva: u32;
    bound_rva:  u32;
    unload_rva: u32;
    timestamp:  u32;
}

# a bound import descriptor or a bound forwarder reference, which share a
# layout. `count` is the number of forwarder references that follow a
# descriptor and reserved in a reference. the last descriptor is all zero
pub rec BoundImport {
    timestamp: u32;
    name:      u16;
    count:     u16;
}

# an entry of a resource directory: a name or an id, and the offset of a
# subdirectory or a data entry, each with its high bit as the specification sets
pub rec ResourceEntry {
    name:   u32;
    offset: u32;
}

# a resource directory node. `named` is the number of entries that carry a
# name, which come first, and the rest carry an id
pub rec ResourceDirectory {
    characteristics: u32;
    timestamp:       u32;
    major:           u16;
    minor:           u16;
    named:           u16;
    entries:         Table[ResourceEntry];
}

# a resource data entry
pub rec ResourceData {
    rva:      u32;
    size:     u32;
    codepage: u32;
    reserved: u32;
}

# a .pdata entry of x64
pub rec RuntimeFunction {
    begin:  u32;
    end:    u32;
    unwind: u32;
}

# a .pdata entry of ARM64
pub rec RuntimeFunctionArm64 {
    begin:  u32;
    unwind: u32;
}

# the exception table, whose entry layout the machine sets
pub tag Exceptions: u8 {
    x64:   Table[RuntimeFunction];
    arm64: Table[RuntimeFunctionArm64];
}

# a block of base relocations. the block size follows the entries. each entry
# is a type in its high four bits and an offset in the page below
pub rec RelocBlock {
    page_rva: u32;
    entries:  Table[u16];
}

pub rec DebugEntry {
    characteristics: u32;
    timestamp:       u32;
    major:           u16;
    minor:           u16;
    type:            u32;
    size:            u32;
    rva:             u32;
    pointer:         u32;
}

# a CodeView RSDS record. `path` holds the bytes after the age, to the end of
# the record
pub rec Rsds {
    signature: u32;
    guid:      [16]u8;
    age:       u32;
    path:      Held;
}

# the TLS directory. its four addresses are as wide as the image's address
pub rec Tls {
    raw_start:       u64;
    raw_end:         u64;
    index_address:   u64;
    callbacks:       u64;
    zero_fill:       u32;
    characteristics: u32;
}

# the load configuration directory. `size` is the bytes the file holds, and a
# field past it is zero and not in the file. the fields follow in this order,
# packed, every pointer sized field as wide as the image's address and held as
# a u64, and `extra` holds the bytes after the last field named here. the order
# is that of IMAGE_LOAD_CONFIG_DIRECTORY64. the PE Format page lists the fields
# to the long jump table and winnt.h lists the rest. for PE32 the page orders
# ProcessAffinityMask before ProcessHeapFlags and winnt.h the reverse, which a
# reader of that layout settles
pub rec LoadConfig {
    size:                     u32;
    timestamp:                u32;
    major:                    u16;
    minor:                    u16;
    global_flags_clear:       u32;
    global_flags_set:         u32;
    critical_section_timeout: u32;
    decommit_free_threshold:  u64;
    decommit_total_free:      u64;
    lock_prefix_table:        u64;
    max_allocation:           u64;
    virtual_memory_threshold: u64;
    affinity_mask:            u64;
    heap_flags:               u32;
    csd_version:              u16;
    dependent_load_flags:     u16;
    edit_list:                u64;
    security_cookie:          u64;
    seh_table:                u64;
    seh_count:                u64;
    guard_cf_check:           u64;
    guard_cf_dispatch:        u64;
    guard_cf_table:           u64;
    guard_cf_count:           u64;
    guard_flags:              u32;
    integrity_flags:          u16;
    integrity_catalog:        u16;
    integrity_catalog_offset: u32;
    integrity_reserved:       u32;
    guard_iat_table:          u64;
    guard_iat_count:          u64;
    guard_longjmp_table:      u64;
    guard_longjmp_count:      u64;
    dynamic_reloc_table:      u64;
    chpe_metadata:            u64;
    guard_rf_failure:         u64;
    guard_rf_failure_pointer: u64;
    dynamic_reloc_offset:     u32;
    dynamic_reloc_section:    u16;
    reserved2:                u16;
    guard_rf_verify_stack:    u64;
    hot_patch_offset:         u32;
    reserved3:                u32;
    enclave:                  u64;
    volatile_metadata:        u64;
    guard_eh_table:           u64;
    guard_eh_count:           u64;
    guard_xfg_check:          u64;
    guard_xfg_dispatch:       u64;
    guard_xfg_table_dispatch: u64;
    cast_guard_mode:          u64;
    guard_memcpy:             u64;
    extra:                    Raw;
}

# the ARM64EC metadata a load configuration points at. `size` is the bytes the
# file holds, and a field past it is zero and not in the file. the structure
# states no size of its own, so no bytes trail the named fields
pub rec Arm64ec {
    size:                        u32;
    version:                     u32;
    code_map:                    u32;
    code_map_count:              u32;
    code_ranges_to_entry_points: u32;
    redirection_metadata:        u32;
    dispatch_call_no_redirect:   u32;
    dispatch_ret:                u32;
    dispatch_call:               u32;
    dispatch_icall:              u32;
    dispatch_icall_cfg:          u32;
    alternate_entry_point:       u32;
    auxiliary_iat:               u32;
    entry_points_count:          u32;
    redirection_metadata_count:  u32;
    get_x64_information:         u32;
    set_x64_information:         u32;
    extra_rfe_table:             u32;
    extra_rfe_table_size:        u32;
    dispatch_fptr:               u32;
    auxiliary_iat_copy:          u32;
    helpers:                     [9]u32;
}

# the CHPE metadata of an x86 image, with the same size rule. `unknown` is the
# four words the layout leaves unnamed
pub rec ChpeX86 {
    size:                       u32;
    version:                    u32;
    code_range_offset:          u32;
    code_range_count:           u32;
    exception_handler:          u32;
    dispatch_call:              u32;
    dispatch_indirect_call:     u32;
    dispatch_indirect_call_cfg: u32;
    dispatch_ret:               u32;
    dispatch_ret_leaf:          u32;
    dispatch_jump:              u32;
    compiler_iat:               u32;
    rdtsc:                      u32;
    unknown:                    [4]u32;
}

# an entry of the code map: a start whose low bits are the range's kind
pub rec CodeRange {
    start:  u32;
    length: u32;
}

# an entry of the code ranges to entry points
pub rec EntryRange {
    start: u32;
    end:   u32;
    entry: u32;
}

pub rec Redirection {
    source:      u32;
    destination: u32;
}

# a certificate. its length follows the data, and `pad` holds the bytes that
# round the record to eight
pub rec Certificate {
    revision: u16;
    type:     u16;
    data:     Held;
    pad:      [7]u8;
}

pub rec ClrHeader {
    size:           u32;
    major:          u16;
    minor:          u16;
    metadata:       DataDirectory;
    flags:          u32;
    entry:          u32;
    resources:      DataDirectory;
    strong_name:    DataDirectory;
    code_manager:   DataDirectory;
    vtable_fixups:  DataDirectory;
    export_jumps:   DataDirectory;
    managed_native: DataDirectory;
}

# one structure of an image, as it lies in its bytes
# ---
# raw:           bytes no typed structure covers, such as names and unwind data
# exports:       the export directory
# export_words:  the export address table or the export name pointer table
# ordinals:      the export ordinal table
# imports:       import descriptors
# pointers:      thunks, an import lookup table or address table, or TLS callbacks,
#                each with its terminating zero
# hint_name:     a hint and a name
# delay_imports: delay import descriptors
# bound_imports: bound import descriptors and forwarder references
# resource_dir:  a resource directory node with its entries
# resource_data: a resource data entry
# exceptions:    the exception table
# relocations:   base relocation blocks
# debug:         debug directory entries
# codeview:      a CodeView RSDS record
# tls:           the TLS directory
# load_config:   the load configuration directory
# arm64ec:       the ARM64EC metadata
# chpe_x86:      the x86 CHPE metadata
# code_ranges:   the code map
# entry_ranges:  the code ranges to entry points
# redirections:  the redirection metadata
# certificates:  the certificate table
# clr:           the CLR header
pub tag Piece: u8 {
    raw:           Raw;
    exports:       ExportDirectory;
    export_words:  Table[u32];
    ordinals:      Table[u16];
    imports:       Table[ImportDescriptor];
    pointers:      Table[u64];
    hint_name:     HintName;
    delay_imports: Table[DelayImport];
    bound_imports: Table[BoundImport];
    resource_dir:  ResourceDirectory;
    resource_data: ResourceData;
    exceptions:    Exceptions;
    relocations:   Table[RelocBlock];
    debug:         Table[DebugEntry];
    codeview:      Rsds;
    tls:           Tls;
    load_config:   LoadConfig;
    arm64ec:       Arm64ec;
    chpe_x86:      ChpeX86;
    code_ranges:   Table[CodeRange];
    entry_ranges:  Table[EntryRange];
    redirections:  Table[Redirection];
    certificates:  Table[Certificate];
    clr:           ClrHeader;
}

# what a section's bytes hold
# ---
# empty:    no bytes in the file, as for uninitialized data
# overlaid: bytes other extents hold, for a section that overlaps another
# raw:      bytes no typed structure tiles
# tiled:    pieces tiling the bytes exactly
pub tag Body: u8 {
    empty;
    overlaid;
    raw:   Raw;
    tiled: Table[Piece];
}

# a section header and what its bytes hold. `name` is the eight bytes as
# written, so a long name is `/` and a decimal string table offset, or `//` and
# a base 64 one. nreloc and nlines are held as written, and the tables hold
# what they count
pub rec Section {
    name:            [8]u8;
    virtual_size:    u32;
    virtual_address: u32;
    raw_size:        u32;
    raw_ptr:         u32;
    reloc_ptr:       u32;
    line_ptr:        u32;
    nreloc:          u16;
    nlines:          u16;
    flags:           u32;
    body:            Body;
    relocs:          Table[Reloc];
    lines:           Table[Line];
}

# one extent of the file, in file order
# ---
# dos:       the bytes before the PE signature
# signature: the PE signature
# header:    the file header
# optional:  the optional header
# sections:  the section header table
# section:   a section's bytes
# lines:     a section's line numbers
# relocs:    a section's relocations
# symbols:   the symbol table
# strings:   the string table, holding the bytes after its size word
# tiled:     typed pieces outside every section
# raw:       bytes no record covers
pub tag Extent: u8 {
    dos: Held;
    signature;
    header;
    optional;
    sections;
    section: Id[Section];
    lines:   Id[Section];
    relocs:  Id[Section];
    symbols;
    strings: Held;
    tiled:   Table[Piece];
    raw:     Raw;
}

# where an address lies
# ---
# headers: in the headers, at this file offset
# section: in a section
pub tag Mapping: u8 {
    headers: u64;
    section: Placed;
}

# an address in a section: the section, the offset from its start, and the file
# offset when the offset lies in the section's bytes and none when it lies in
# its zero fill
pub rec Placed {
    section: Id[Section];
    offset:  u64;
    file:    opt[u64];
}

# a whole COFF object or PE image
# ---
# a:         the allocator every table lives in
# shape:     its layouts
# signature: the PE signature, present in an image
# header:    the file header
# optional:  the optional header
# sections:  the section headers, in table order
# symbols:   the symbol table
# extents:   the file, in file order
# store:     the bytes the model owns
pub rec Coff {
    a:         *A.Allocator;
    shape:     Shape;
    signature: opt[u32];
    header:    Header;
    optional:  Optional;
    sections:  Table[Section];
    symbols:   Table[Entry];
    extents:   Table[Extent];
    store:     Store;
}

pub fun make(a: *A.Allocator, shape: Shape) Coff {
    ret Coff{
        a:        a,
        shape:    shape,
        sections: table.make[Section](a),
        symbols:  table.make[Entry](a),
        extents:  table.make[Extent](a),
        store:    store.make(a),
    };
}

# an image optional header with an empty directory array
pub fun make_image(a: *A.Allocator) Image {
    ret Image{dirs: table.make[DataDirectory](a)};
}

# a section header with no bytes and no relocations or line numbers
pub fun make_section(a: *A.Allocator) Section {
    ret Section{body: Body.empty{}, relocs: table.make[Reloc](a), lines: table.make[Line](a)};
}

# give everything the model owns back, reporting the first refusal
pub fun release(m: *Coff) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[Section](?m.sections)) {
        val s: *Section = table.at[Section](?m.sections, table.nth[Section](i));
        if (sel s.body.tiled) { first = kept(first, release_pieces(?s.body.tiled)); }
        first = kept(first, table.release[Reloc](?s.relocs));
        first = kept(first, table.release[Line](?s.lines));
        i     = i + 1;
    }
    i = 0;
    for (i < table.count[Extent](?m.extents)) {
        val e: *Extent = table.at[Extent](?m.extents, table.nth[Extent](i));
        if (sel e.tiled) { first = kept(first, release_pieces(?e.tiled)); }
        i = i + 1;
    }
    if (sel m.optional.image) { first = kept(first, table.release[DataDirectory](?m.optional.image.dirs)); }
    first = kept(first, table.release[Section](?m.sections));
    first = kept(first, table.release[Entry](?m.symbols));
    first = kept(first, table.release[Extent](?m.extents));
    ret kept(first, store.release(?m.store));
}

# a copy of the `n` bytes at `p` the model owns
pub fun own(m: *Coff, p: *u8, n: usize) res[Held, Fail] {
    ret store.own(?m.store, p, n);
}

# the bytes of `h`. owned bytes stay valid until the model next owns bytes
pub fun bytes(m: *Coff, h: *Held) Bytes {
    ret store.bytes(?m.store, h);
}

pub fun section_at(m: *Coff, id: Id[Section]) *Section {
    ret table.at[Section](?m.sections, id);
}

# what a section number names
# ---
# undefined: no section, as for an external symbol defined elsewhere
# absolute:  a value that is no address
# debug:     debugging information
# section:   a section of the table
pub tag SectionRef: u8 {
    undefined;
    absolute;
    debug;
    section: Id[Section];
}

# the section number `number` resolved against the section table
fun resolve_section(m: *Coff, number: i32, record: str, index: u64) res[SectionRef, Fail] {
    val n:    i64 = number::i64;
    val bits: u64 = n:~u64;
    if (bits == tables.IMAGE_SYM_UNDEFINED.value) { ret res[SectionRef, Fail].ok{SectionRef.undefined{}}; }
    if (bits == tables.IMAGE_SYM_ABSOLUTE.value)  { ret res[SectionRef, Fail].ok{SectionRef.absolute{}}; }
    if (bits == tables.IMAGE_SYM_DEBUG.value)     { ret res[SectionRef, Fail].ok{SectionRef.debug{}}; }
    if (n < 0 || n::usize > table.count[Section](?m.sections)) {
        ret res[SectionRef, Fail].err{fail.valued(fail.in_indexed(fail.malformed("section number is outside the section table"), record, index), n::i128)};
    }
    ret res[SectionRef, Fail].ok{SectionRef.section{table.nth[Section]((n - 1)::usize)}};
}

# the symbol table record `number` names, which must be a symbol and no
# auxiliary record
fun resolve_symbol(m: *Coff, number: u64, record: str, index: u64) res[Id[Entry], Fail] {
    if (number >= table.count[Entry](?m.symbols)::u64) {
        ret res[Id[Entry], Fail].err{fail.valued(fail.in_indexed(fail.malformed("symbol index is outside the symbol table"), record, index), number::i128)};
    }
    val id: Id[Entry] = table.nth[Entry](number::usize);
    val e:  *Entry    = table.at[Entry](?m.symbols, id);
    if (!sel e.symbol) {
        ret res[Id[Entry], Fail].err{fail.valued(fail.in_indexed(fail.malformed("symbol index names an auxiliary record"), record, index), number::i128)};
    }
    ret res[Id[Entry], Fail].ok{id};
}

# like resolve_symbol, with zero for no symbol
fun resolve_link(m: *Coff, number: u64, record: str, index: u64) res[opt[Id[Entry]], Fail] {
    if (number == 0) { ret res[opt[Id[Entry]], Fail].ok{opt[Id[Entry]].none{}}; }
    val r: res[Id[Entry], Fail] = resolve_symbol(m, number, record, index);
    if (sel r.err) { ret res[opt[Id[Entry]], Fail].err{r.err}; }
    ret res[opt[Id[Entry]], Fail].ok{opt[Id[Entry]].some{r.ok}};
}

# the reference accessors below are how a consumer follows a number the file
# holds as written. each takes the record, which is the `at`th of its table, and
# a number outside the table it names is malformed at that record and index

# the section symbol `s` is defined in
pub fun symbol_section(m: *Coff, at: Id[Entry], s: *Symbol) res[SectionRef, Fail] {
    ret resolve_section(m, s.section, "symbol", at.index::u64);
}

# the symbol relocation `r` applies to
pub fun reloc_symbol(m: *Coff, at: Id[Reloc], r: *Reloc) res[Id[Entry], Fail] {
    ret resolve_symbol(m, r.symbol::u64, "relocation", at.index::u64);
}

# the symbol a line number record names, absent when the record holds an address
pub fun line_symbol(m: *Coff, at: Id[Line], l: *Line) res[opt[Id[Entry]], Fail] {
    if (l.line != 0) { ret res[opt[Id[Entry]], Fail].ok{opt[Id[Entry]].none{}}; }
    val r: res[Id[Entry], Fail] = resolve_symbol(m, l.key::u64, "line number", at.index::u64);
    if (sel r.err) { ret res[opt[Id[Entry]], Fail].err{r.err}; }
    ret res[opt[Id[Entry]], Fail].ok{opt[Id[Entry]].some{r.ok}};
}

# the symbol a weak external falls back to
pub fun weak_fallback(m: *Coff, at: Id[Entry], a: *WeakAux) res[Id[Entry], Fail] {
    ret resolve_symbol(m, a.tag_index::u64, "auxiliary record", at.index::u64);
}

# the symbol a function definition names as its tag, absent when zero
pub fun function_tag(m: *Coff, at: Id[Entry], a: *FunctionAux) res[opt[Id[Entry]], Fail] {
    ret resolve_link(m, a.tag_index::u64, "auxiliary record", at.index::u64);
}

# the next function symbol of a function definition, absent when zero
pub fun function_next(m: *Coff, at: Id[Entry], a: *FunctionAux) res[opt[Id[Entry]], Fail] {
    ret resolve_link(m, a.next_function::u64, "auxiliary record", at.index::u64);
}

# the next function symbol of a .bf record, absent when zero
pub fun block_next(m: *Coff, at: Id[Entry], a: *BlockAux) res[opt[Id[Entry]], Fail] {
    ret resolve_link(m, a.next_function::u64, "auxiliary record", at.index::u64);
}

# the first line number of a function definition in the line numbers of
# `section`, the section the function symbol is defined in. absent when zero
pub fun function_line(m: *Coff, at: Id[Entry], a: *FunctionAux, section: Id[Section]) res[opt[Id[Line]], Fail] {
    if (a.line_ptr == 0) { ret res[opt[Id[Line]], Fail].ok{opt[Id[Line]].none{}}; }
    val s:     *Section = section_at(m, section);
    val first: u64      = s.line_ptr::u64;
    val ptr:   u64      = a.line_ptr::u64;
    val count: u64      = table.count[Line](?s.lines)::u64;
    if (ptr < first || (ptr - first) % LINE_SIZE != 0 || (ptr - first) / LINE_SIZE >= count) {
        ret res[opt[Id[Line]], Fail].err{fail.valued(fail.in_indexed(fail.malformed("line number pointer is outside the section's line numbers"), "auxiliary record", at.index::u64), ptr::i128)};
    }
    ret res[opt[Id[Line]], Fail].ok{opt[Id[Line]].some{table.nth[Line](((ptr - first) / LINE_SIZE)::usize)}};
}

# the section a section definition is associated with, absent unless its
# selection is associative. the number is one based, and a bigobj holds its high
# half apart
pub fun associative_section(m: *Coff, at: Id[Entry], a: *SectionAux) res[opt[Id[Section]], Fail] {
    if (a.selection::u64 != tables.IMAGE_COMDAT_SELECT_ASSOCIATIVE.value) { ret res[opt[Id[Section]], Fail].ok{opt[Id[Section]].none{}}; }
    var number: u32 = a.number::u32;
    if (m.shape.object.symbol.section.width > 2) { number = number | (a.number_high::u32 << 16); }
    val r: res[SectionRef, Fail] = resolve_section(m, number:~i32, "auxiliary record", at.index::u64);
    if (sel r.err) { ret res[opt[Id[Section]], Fail].err{r.err}; }
    if (!sel r.ok.section) {
        ret res[opt[Id[Section]], Fail].err{fail.valued(fail.in_indexed(fail.malformed("associative section number names no section"), "auxiliary record", at.index::u64), number::i128)};
    }
    ret res[opt[Id[Section]], Fail].ok{opt[Id[Section]].some{r.ok.section}};
}

# the symbol a CLR token definition names
pub fun clr_symbol(m: *Coff, at: Id[Entry], a: *ClrAux) res[Id[Entry], Fail] {
    ret resolve_symbol(m, a.symbol_index::u64, "auxiliary record", at.index::u64);
}

# the export address table entry the name ordinal `ordinal`, which is the `at`th
# of the ordinal table, names
pub fun export_address(dir: *ExportDirectory, at: Id[u16], ordinal: u16) res[Id[u32], Fail] {
    if (ordinal::u32 >= dir.address_count) {
        ret res[Id[u32], Fail].err{fail.valued(fail.in_indexed(fail.malformed("export ordinal is outside the export address table"), "export ordinal", at.index::u64), ordinal::i128)};
    }
    ret res[Id[u32], Fail].ok{table.nth[u32](ordinal::usize)};
}

# the bytes a piece takes in the file
pub fun piece_len(m: *Coff, p: *Piece) res[u64, Fail] {
    if (sel p.raw)           { ret res[u64, Fail].ok{bytes(m, ?p.raw.bytes).len::u64}; }
    if (sel p.exports)       { ret res[u64, Fail].ok{EXPORT_SIZE}; }
    if (sel p.export_words)  { ret res[u64, Fail].ok{table.count[u32](?p.export_words)::u64 * 4}; }
    if (sel p.ordinals)      { ret res[u64, Fail].ok{table.count[u16](?p.ordinals)::u64 * 2}; }
    if (sel p.imports)       { ret res[u64, Fail].ok{table.count[ImportDescriptor](?p.imports)::u64 * IMPORT_SIZE}; }
    if (sel p.hint_name)     { ret res[u64, Fail].ok{2 + bytes(m, ?p.hint_name.name).len::u64}; }
    if (sel p.delay_imports) { ret res[u64, Fail].ok{table.count[DelayImport](?p.delay_imports)::u64 * DELAY_SIZE}; }
    if (sel p.bound_imports) { ret res[u64, Fail].ok{table.count[BoundImport](?p.bound_imports)::u64 * BOUND_SIZE}; }
    if (sel p.resource_dir)  { ret res[u64, Fail].ok{RESOURCE_DIR_SIZE + table.count[ResourceEntry](?p.resource_dir.entries)::u64 * RESOURCE_ENTRY_SIZE}; }
    if (sel p.resource_data) { ret res[u64, Fail].ok{RESOURCE_DATA_SIZE}; }
    if (sel p.debug)         { ret res[u64, Fail].ok{table.count[DebugEntry](?p.debug)::u64 * DEBUG_SIZE}; }
    if (sel p.codeview)      { ret res[u64, Fail].ok{RSDS_SIZE + bytes(m, ?p.codeview.path).len::u64}; }
    if (sel p.load_config)   { ret res[u64, Fail].ok{p.load_config.size::u64}; }
    if (sel p.arm64ec)       { ret res[u64, Fail].ok{p.arm64ec.size::u64}; }
    if (sel p.chpe_x86)      { ret res[u64, Fail].ok{p.chpe_x86.size::u64}; }
    if (sel p.code_ranges)   { ret res[u64, Fail].ok{table.count[CodeRange](?p.code_ranges)::u64 * CODE_RANGE_SIZE}; }
    if (sel p.entry_ranges)  { ret res[u64, Fail].ok{table.count[EntryRange](?p.entry_ranges)::u64 * ENTRY_RANGE_SIZE}; }
    if (sel p.redirections)  { ret res[u64, Fail].ok{table.count[Redirection](?p.redirections)::u64 * REDIRECTION_SIZE}; }
    if (sel p.clr)           { ret res[u64, Fail].ok{CLR_SIZE}; }
    if (sel p.exceptions) {
        if (sel p.exceptions.x64) { ret res[u64, Fail].ok{table.count[RuntimeFunction](?p.exceptions.x64)::u64 * RUNTIME_SIZE}; }
        ret res[u64, Fail].ok{table.count[RuntimeFunctionArm64](?p.exceptions.arm64)::u64 * RUNTIME_ARM64_SIZE};
    }
    if (sel p.relocations) {
        var total: u64   = 0;
        var i:     usize = 0;
        for (i < table.count[RelocBlock](?p.relocations)) {
            val b: *RelocBlock = table.at[RelocBlock](?p.relocations, table.nth[RelocBlock](i));
            total = total + RELOC_BLOCK_SIZE + table.count[u16](?b.entries)::u64 * 2;
            i     = i + 1;
        }
        ret res[u64, Fail].ok{total};
    }
    if (sel p.certificates) {
        var total: u64   = 0;
        var i:     usize = 0;
        for (i < table.count[Certificate](?p.certificates)) {
            val c: *Certificate   = table.at[Certificate](?p.certificates, table.nth[Certificate](i));
            val n: res[u64, Fail] = checked.align_up(Location{}, CERTIFICATE_SIZE + bytes(m, ?c.data).len::u64, 8);
            if (sel n.err) { ret n; }
            total = total + n.ok;
            i     = i + 1;
        }
        ret res[u64, Fail].ok{total};
    }
    val width: res[u64, Fail] = address_width(m);
    if (sel width.err)  { ret width; }
    if (sel p.pointers) { ret res[u64, Fail].ok{table.count[u64](?p.pointers)::u64 * width.ok}; }
    ret res[u64, Fail].ok{4 * width.ok + 8};
}

# the bytes an extent takes in the file
pub fun extent_len(m: *Coff, e: *Extent) res[u64, Fail] {
    if (sel e.dos)       { ret res[u64, Fail].ok{bytes(m, ?e.dos).len::u64}; }
    if (sel e.raw)       { ret res[u64, Fail].ok{bytes(m, ?e.raw.bytes).len::u64}; }
    if (sel e.strings)   { ret res[u64, Fail].ok{4 + bytes(m, ?e.strings).len::u64}; }
    if (sel e.signature) { ret res[u64, Fail].ok{4}; }
    if (sel e.header)    { ret res[u64, Fail].ok{m.shape.object.header.size::u64}; }
    if (sel e.sections)  { ret res[u64, Fail].ok{table.count[Section](?m.sections)::u64 * SECTION_SIZE}; }
    if (sel e.symbols)   { ret res[u64, Fail].ok{table.count[Entry](?m.symbols)::u64 * m.shape.object.symbol.size::u64}; }
    if (sel e.lines)     { ret res[u64, Fail].ok{table.count[Line](?section_at(m, e.lines).lines)::u64 * LINE_SIZE}; }
    if (sel e.relocs)    { ret res[u64, Fail].ok{table.count[Reloc](?section_at(m, e.relocs).relocs)::u64 * RELOC_SIZE}; }
    if (sel e.section) {
        val s: *Section = section_at(m, e.section);
        if (sel s.body.raw)   { ret res[u64, Fail].ok{bytes(m, ?s.body.raw.bytes).len::u64}; }
        if (sel s.body.tiled) { ret tiles_len(m, ?s.body.tiled); }
        ret res[u64, Fail].ok{0};
    }
    if (sel e.tiled) { ret tiles_len(m, ?e.tiled); }
    if (sel m.optional.image) {
        val img:   *Image                 = ?m.optional.image;
        val shape: res[*ImageShape, Fail] = image_shape(m);
        if (sel shape.err) { ret res[u64, Fail].err{shape.err}; }
        ret res[u64, Fail].ok{shape.ok.size::u64 + table.count[DataDirectory](?img.dirs)::u64 * DIRECTORY_SIZE + bytes(m, ?img.trailing.bytes).len::u64};
    }
    if (sel m.optional.raw) { ret res[u64, Fail].ok{bytes(m, ?m.optional.raw.bytes).len::u64}; }
    ret res[u64, Fail].ok{0};
}

# the piece that starts at file offset `offset`, absent when the offset lies in
# bytes no typed structure tiles
pub fun piece_at(m: *Coff, offset: u64) res[opt[*Piece], Fail] {
    var at: u64   = 0;
    var i:  usize = 0;
    for (i < table.count[Extent](?m.extents)) {
        val e:   *Extent        = table.at[Extent](?m.extents, table.nth[Extent](i));
        val len: res[u64, Fail] = extent_len(m, e);
        if (sel len.err) { ret res[opt[*Piece], Fail].err{len.err}; }
        val end: res[u64, Fail] = checked.add(Location{}, at, len.ok);
        if (sel end.err) { ret res[opt[*Piece], Fail].err{end.err}; }
        if (offset < end.ok) {
            val tiles: *Table[Piece] = tiles_of(m, e);
            if (tiles == nil) { ret res[opt[*Piece], Fail].ok{opt[*Piece].none{}}; }
            ret piece_in(m, tiles, at, offset);
        }
        at = end.ok;
        i  = i + 1;
    }
    ret res[opt[*Piece], Fail].ok{opt[*Piece].none{}};
}

# raw bytes and why they are raw
pub rec RawView {
    bytes: Bytes;
    why:   Why;
}

# the raw bytes from file offset `offset` to the end of the raw piece or raw
# extent holding it, with the reason they are raw, absent when no byte covers it or a typed piece holds it
pub fun raw_at(m: *Coff, offset: u64) res[opt[RawView], Fail] {
    var at: u64   = 0;
    var i:  usize = 0;
    for (i < table.count[Extent](?m.extents)) {
        val e:   *Extent        = table.at[Extent](?m.extents, table.nth[Extent](i));
        val len: res[u64, Fail] = extent_len(m, e);
        if (sel len.err) { ret res[opt[RawView], Fail].err{len.err}; }
        val end: res[u64, Fail] = checked.add(Location{}, at, len.ok);
        if (sel end.err) { ret res[opt[RawView], Fail].err{end.err}; }
        if (offset < end.ok) {
            val tiles: *Table[Piece] = tiles_of(m, e);
            if (tiles != nil) { ret raw_in(m, tiles, at, offset); }
            ret res[opt[RawView], Fail].ok{extent_bytes(m, e, at, offset)};
        }
        at = end.ok;
        i  = i + 1;
    }
    ret res[opt[RawView], Fail].ok{opt[RawView].none{}};
}

# the bytes of the raw piece of `tiles`, starting at file offset `start`, that holds `offset`
fun raw_in(m: *Coff, tiles: *Table[Piece], start: u64, offset: u64) res[opt[RawView], Fail] {
    var at: u64   = start;
    var i:  usize = 0;
    for (i < table.count[Piece](tiles)) {
        val p:   *Piece         = table.at[Piece](tiles, table.nth[Piece](i));
        val len: res[u64, Fail] = piece_len(m, p);
        if (sel len.err) { ret res[opt[RawView], Fail].err{len.err}; }
        val end: res[u64, Fail] = checked.add(Location{}, at, len.ok);
        if (sel end.err) { ret res[opt[RawView], Fail].err{end.err}; }
        if (offset < end.ok) {
            if (!sel p.raw) { ret res[opt[RawView], Fail].ok{opt[RawView].none{}}; }
            ret res[opt[RawView], Fail].ok{opt[RawView].some{view_of(m, ?p.raw, at, offset)}};
        }
        at = end.ok;
        i  = i + 1;
    }
    ret res[opt[RawView], Fail].ok{opt[RawView].none{}};
}

# the raw bytes of extent `e`, which starts at file offset `at`, from `offset`,
# absent for an extent that holds no raw bytes
fun extent_bytes(m: *Coff, e: *Extent, at: u64, offset: u64) opt[RawView] {
    if (sel e.dos) { ret opt[RawView].some{RawView{bytes: from(m, ?e.dos, at, offset), why: Why.opaque{}}}; }
    if (sel e.raw) { ret opt[RawView].some{view_of(m, ?e.raw, at, offset)}; }
    if (sel e.strings) {
        if (offset < at + 4) { ret opt[RawView].none{}; }
        ret opt[RawView].some{RawView{bytes: from(m, ?e.strings, at + 4, offset), why: Why.opaque{}}};
    }
    if (sel e.section) {
        val s: *Section = section_at(m, e.section);
        if (sel s.body.raw) { ret opt[RawView].some{view_of(m, ?s.body.raw, at, offset)}; }
    }
    if (sel e.optional) {
        if (sel m.optional.raw) { ret opt[RawView].some{view_of(m, ?m.optional.raw, at, offset)}; }
    }
    ret opt[RawView].none{};
}

# the bytes of `r`, which starts at file offset `start`, from file offset `offset`, and why they are raw
fun view_of(m: *Coff, r: *Raw, start: u64, offset: u64) RawView {
    ret RawView{bytes: from(m, ?r.bytes, start, offset), why: r.why};
}

# the bytes of `h`, which starts at file offset `start`, from file offset `offset`
fun from(m: *Coff, h: *Held, start: u64, offset: u64) Bytes {
    val b:    Bytes = bytes(m, h);
    val skip: usize = (offset - start)::usize;
    ret Bytes{data: ?b.data[skip], len: b.len - skip};
}

# where the relative virtual address `rva` of an image lies, absent when it
# lies in no section nor the headers. a section extends to its virtual size, or
# to its size in the file when the virtual size is zero
pub fun map_rva(m: *Coff, rva: u64) res[opt[Mapping], Fail] {
    if (!sel m.optional.image) { ret res[opt[Mapping], Fail].err{fail.internal("address mapping of a file with no image optional header")}; }
    if (rva < m.optional.image.headers_size::u64) {
        ret res[opt[Mapping], Fail].ok{opt[Mapping].some{Mapping.headers{rva}}};
    }
    var i: usize = 0;
    for (i < table.count[Section](?m.sections)) {
        val id:   Id[Section] = table.nth[Section](i);
        val s:    *Section    = section_at(m, id);
        var size: u64         = s.virtual_size::u64;
        if (size == 0) { size = s.raw_size::u64; }
        val first: u64 = s.virtual_address::u64;
        if (rva >= first && rva - first < size) {
            val offset: u64      = rva - first;
            var file:   opt[u64] = opt[u64].none{};
            if (offset < s.raw_size::u64) {
                val f: res[u64, Fail] = checked.add(Location{}, s.raw_ptr::u64, offset);
                if (sel f.err) { ret res[opt[Mapping], Fail].err{f.err}; }
                file = opt[u64].some{f.ok};
            }
            ret res[opt[Mapping], Fail].ok{opt[Mapping].some{Mapping.section{Placed{section: id, offset: offset, file: file}}}};
        }
        i = i + 1;
    }
    ret res[opt[Mapping], Fail].ok{opt[Mapping].none{}};
}

# whether data directory `dir` holds a file offset where the others hold a relative
# virtual address
pub fun holds_file_offset(dir: *Constant) bool {
    ret dir == ?tables.IMAGE_DIRECTORY_ENTRY_SECURITY;
}

# the piece data directory `dir` names, absent when the image has no such
# directory or it is empty
pub fun directory_piece(m: *Coff, dir: *Constant) res[opt[*Piece], Fail] {
    if (!sel m.optional.image) { ret res[opt[*Piece], Fail].err{fail.internal("data directory of a file with no image optional header")}; }
    val index: usize                 = dir.value::usize;
    val dirs:  *Table[DataDirectory] = ?m.optional.image.dirs;
    if (index >= table.count[DataDirectory](dirs)) { ret res[opt[*Piece], Fail].ok{opt[*Piece].none{}}; }
    val d: DataDirectory = @table.at[DataDirectory](dirs, table.nth[DataDirectory](index));
    if (d.rva == 0 && d.size == 0) { ret res[opt[*Piece], Fail].ok{opt[*Piece].none{}}; }
    var offset: u64 = d.rva::u64;
    if (!holds_file_offset(dir)) {
        val where: res[opt[Mapping], Fail] = map_rva(m, d.rva::u64);
        if (sel where.err) { ret res[opt[*Piece], Fail].err{where.err}; }
        if (sel where.ok.none) {
            ret res[opt[*Piece], Fail].err{fail.in_indexed(fail.malformed("data directory lies outside every section"), "data directory", index::u64)};
        }
        val at: Mapping = where.ok.some;
        if (sel at.headers) { offset = at.headers; }
        or (sel at.section) {
            val file: opt[u64] = at.section.file;
            if (sel file.none) {
                ret res[opt[*Piece], Fail].err{fail.in_indexed(fail.malformed("data directory lies in zero fill"), "data directory", index::u64)};
            }
            offset = file.some;
        }
    }
    val p: res[opt[*Piece], Fail] = piece_at(m, offset);
    if (sel p.err) { ret p; }
    if (sel p.ok.none) {
        ret res[opt[*Piece], Fail].err{fail.in_indexed(fail.malformed("data directory is not on a typed record"), "data directory", index::u64)};
    }
    ret p;
}

# the export directory
pub fun exports(m: *Coff) res[opt[*ExportDirectory], Fail] {
    val r: res[opt[*Piece], Fail] = directory_piece(m, ?tables.IMAGE_DIRECTORY_ENTRY_EXPORT);
    if (sel r.err)     { ret res[opt[*ExportDirectory], Fail].err{r.err}; }
    if (sel r.ok.none) { ret res[opt[*ExportDirectory], Fail].ok{opt[*ExportDirectory].none{}}; }
    val p: *Piece = r.ok.some;
    if (!sel p.exports) { ret res[opt[*ExportDirectory], Fail].err{mismatch(?tables.IMAGE_DIRECTORY_ENTRY_EXPORT)}; }
    ret res[opt[*ExportDirectory], Fail].ok{opt[*ExportDirectory].some{?p.exports}};
}

