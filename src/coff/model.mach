fun mismatch(dir: *Constant) Fail {
    ret fail.in_indexed(fail.malformed("data directory holds another kind of record"), "data directory", dir.value);
}

fun image_shape(m: *Coff) res[*ImageShape, Fail] {
    val image: opt[*ImageShape] = m.shape.image;
    if (sel image.none) { ret res[*ImageShape, Fail].err{fail.internal("image layout of a file with no image optional header")}; }
    ret res[*ImageShape, Fail].ok{image.some};
}

fun address_width(m: *Coff) res[u64, Fail] {
    val s: res[*ImageShape, Fail] = image_shape(m);
    if (sel s.err) { ret res[u64, Fail].err{s.err}; }
    ret res[u64, Fail].ok{s.ok.addr::u64};
}

fun tiles_len(m: *Coff, tiles: *Table[Piece]) res[u64, Fail] {
    var total: u64   = 0;
    var i:     usize = 0;
    for (i < table.count[Piece](tiles)) {
        val n: res[u64, Fail] = piece_len(m, table.at[Piece](tiles, table.nth[Piece](i)));
        if (sel n.err) { ret n; }
        val sum: res[u64, Fail] = checked.add(Location{}, total, n.ok);
        if (sel sum.err) { ret sum; }
        total = sum.ok;
        i     = i + 1;
    }
    ret res[u64, Fail].ok{total};
}

# the pieces an extent is tiled by, nil when it is not tiled
pub fun tiles_of(m: *Coff, e: *Extent) *Table[Piece] {
    if (sel e.tiled) { ret ?e.tiled; }
    if (sel e.section) {
        val s: *Section = section_at(m, e.section);
        if (sel s.body.tiled) { ret ?s.body.tiled; }
    }
    ret nil;
}

# the piece of `tiles`, which start at file offset `start`, that starts at `offset`
fun piece_in(m: *Coff, tiles: *Table[Piece], start: u64, offset: u64) res[opt[*Piece], Fail] {
    var at: u64   = start;
    var i:  usize = 0;
    for (i < table.count[Piece](tiles) && at <= offset) {
        val p: *Piece = table.at[Piece](tiles, table.nth[Piece](i));
        if (at == offset) { ret res[opt[*Piece], Fail].ok{opt[*Piece].some{p}}; }
        val len: res[u64, Fail] = piece_len(m, p);
        if (sel len.err) { ret res[opt[*Piece], Fail].err{len.err}; }
        val end: res[u64, Fail] = checked.add(Location{}, at, len.ok);
        if (sel end.err) { ret res[opt[*Piece], Fail].err{end.err}; }
        at = end.ok;
        i  = i + 1;
    }
    ret res[opt[*Piece], Fail].ok{opt[*Piece].none{}};
}

fun release_pieces(tiles: *Table[Piece]) err[Fail] {
    var first: err[Fail] = err[Fail].ok{};
    var i:     usize     = 0;
    for (i < table.count[Piece](tiles)) {
        first = kept(first, release_piece(table.at[Piece](tiles, table.nth[Piece](i))));
        i     = i + 1;
    }
    ret kept(first, table.release[Piece](tiles));
}

pub fun release_piece(p: *Piece) err[Fail] {
    if (sel p.export_words)  { ret table.release[u32](?p.export_words); }
    if (sel p.ordinals)      { ret table.release[u16](?p.ordinals); }
    if (sel p.imports)       { ret table.release[ImportDescriptor](?p.imports); }
    if (sel p.pointers)      { ret table.release[u64](?p.pointers); }
    if (sel p.delay_imports) { ret table.release[DelayImport](?p.delay_imports); }
    if (sel p.bound_imports) { ret table.release[BoundImport](?p.bound_imports); }
    if (sel p.resource_dir)  { ret table.release[ResourceEntry](?p.resource_dir.entries); }
    if (sel p.debug)         { ret table.release[DebugEntry](?p.debug); }
    if (sel p.code_ranges)   { ret table.release[CodeRange](?p.code_ranges); }
    if (sel p.entry_ranges)  { ret table.release[EntryRange](?p.entry_ranges); }
    if (sel p.redirections)  { ret table.release[Redirection](?p.redirections); }
    if (sel p.certificates)  { ret table.release[Certificate](?p.certificates); }
    if (sel p.exceptions) {
        if (sel p.exceptions.x64) { ret table.release[RuntimeFunction](?p.exceptions.x64); }
        ret table.release[RuntimeFunctionArm64](?p.exceptions.arm64);
    }
    if (sel p.relocations) {
        var first: err[Fail] = err[Fail].ok{};
        var i:     usize     = 0;
        for (i < table.count[RelocBlock](?p.relocations)) {
            first = kept(first, table.release[u16](?table.at[RelocBlock](?p.relocations, table.nth[RelocBlock](i)).entries));
            i     = i + 1;
        }
        ret kept(first, table.release[RelocBlock](?p.relocations));
    }
    ret err[Fail].ok{};
}

fun kept(first: err[Fail], next: err[Fail]) err[Fail] {
    if (sel first.err) { ret first; }
    ret next;
}

# the record sizes of the structures the model and the reader walk, as PE Format
# gives them. every named value of the format is a row of the tables
pub val SECTION_SIZE:        u64 = 40;
pub val RELOC_SIZE:          u64 = 10;
pub val LINE_SIZE:           u64 = 6;
pub val DIRECTORY_SIZE:      u64 = 8;
pub val EXPORT_SIZE:         u64 = 40;
pub val IMPORT_SIZE:         u64 = 20;
pub val DELAY_SIZE:          u64 = 32;
pub val BOUND_SIZE:          u64 = 8;
pub val RESOURCE_DIR_SIZE:   u64 = 16;
pub val RESOURCE_ENTRY_SIZE: u64 = 8;
pub val RESOURCE_DATA_SIZE:  u64 = 16;
pub val RUNTIME_SIZE:        u64 = 12;
pub val RUNTIME_ARM64_SIZE:  u64 = 8;
pub val RELOC_BLOCK_SIZE:    u64 = 8;
pub val DEBUG_SIZE:          u64 = 28;
pub val RSDS_SIZE:           u64 = 24;
pub val CODE_RANGE_SIZE:     u64 = 8;
pub val ENTRY_RANGE_SIZE:    u64 = 12;
pub val REDIRECTION_SIZE:    u64 = 8;
pub val CERTIFICATE_SIZE:    u64 = 8;
pub val CLR_SIZE:            u64 = 72;

# a table of one item
fun one[T](a: *A.Allocator, v: T) Table[T] {
    var t: Table[T]         = table.make[T](a);
    val r: res[Id[T], Fail] = table.push[T](?t, v);
    if (sel r.err) { ret table.make[T](a); }
    ret t;
}

# a section with the given header fields and no bytes
fun header_only(a: *A.Allocator, va: u32, vsize: u32, ptr: u32, raw: u32) Section {
    var s: Section = make_section(a);
    s.virtual_address = va;
    s.virtual_size    = vsize;
    s.raw_ptr         = ptr;
    s.raw_size        = raw;
    ret s;
}

# whether the first entry of an ARM64 exception table unwinds at `want`
fun arm64_unwinds(e: *Exceptions, want: u32) bool {
    if (sel e.arm64) { ret table.at[RuntimeFunctionArm64](?e.arm64, table.nth[RuntimeFunctionArm64](0)).unwind == want; }
    ret false;
}

# whether `o` holds `want`
fun has(o: opt[u64], want: u64) bool {
    if (sel o.some) { ret o.some == want; }
    ret false;
}

# whether `r` succeeded with no address
fun absent(r: res[opt[Mapping], Fail]) bool {
    if (sel r.err) { ret false; }
    ret sel r.ok.none;
}

# the record `r` found, nil when the query failed or the directory is absent
fun unwrap[T](r: res[opt[*T], Fail]) *T {
    if (sel r.err)     { ret nil; }
    if (sel r.ok.none) { ret nil; }
    ret r.ok.some;
}

# whether `r` succeeded with no record
fun missing[T](r: res[opt[*T], Fail]) bool {
    if (sel r.err) { ret false; }
    ret sel r.ok.none;
}

# whether `r` is an address in the headers, and its file offset
fun in_headers(r: res[opt[Mapping], Fail], out: *u64) bool {
    if (sel r.err)     { ret false; }
    if (sel r.ok.none) { ret false; }
    val at: Mapping = r.ok.some;
    if (sel at.headers) {
        @out = at.headers;
        ret true;
    }
    ret false;
}

# whether `r` is an address in a section, and where
fun in_section(r: res[opt[Mapping], Fail], out: *Placed) bool {
    if (sel r.err)     { ret false; }
    if (sel r.ok.none) { ret false; }
    val at: Mapping = r.ok.some;
    if (sel at.section) {
        @out = at.section;
        ret true;
    }
    ret false;
}

test model__rva_maps_to_section_and_offset {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:   *A.Allocator = T.allocator_of(?t);
    var m:   Coff         = make(a, Shape{object: ?REGULAR, image: opt[*ImageShape].some{?PE32PLUS}});
    var img: Image        = make_image(a);
    img.headers_size = 0x200;
    m.optional       = Optional.image{img};
    val data: res[Id[Section], Fail] = table.push[Section](?m.sections, header_only(a, 0x1000, 0x180, 0x200, 0x200));
    val bss:  res[Id[Section], Fail] = table.push[Section](?m.sections, header_only(a, 0x2000, 0x400, 0x400, 0x100));
    if (sel data.err || sel bss.err) { ret 1; }
    val inside_headers: res[opt[Mapping], Fail] = map_rva(?m, 0x10);
    val in_data:        res[opt[Mapping], Fail] = map_rva(?m, 0x1010);
    val in_zero:        res[opt[Mapping], Fail] = map_rva(?m, 0x2200);
    val in_gap:         res[opt[Mapping], Fail] = map_rva(?m, 0x1190);
    val past:           res[opt[Mapping], Fail] = map_rva(?m, 0x5000);
    if (sel inside_headers.err || sel in_data.err || sel in_zero.err || sel in_gap.err || sel past.err) { ret 1; }
    var header_offset: u64 = 0;
    if (!in_headers(inside_headers, ?header_offset) || header_offset != 0x10) { ret 1; }
    var placed: Placed = Placed{};
    if (!in_section(in_data, ?placed))                      { ret 1; }
    if (placed.section.index != 0 || placed.offset != 0x10) { ret 1; }
    val file: opt[u64] = placed.file;
    if (!has(file, 0x210)) { ret 1; }
    var zero: Placed = Placed{};
    if (!in_section(in_zero, ?zero)) { ret 1; }
    val no_file: opt[u64] = zero.file;
    if (zero.section.index != 1 || zero.offset != 0x200 || has(no_file, 0)) { ret 1; }
    if (!absent(in_gap) || !absent(past))                                   { ret 1; }
    val r: err[Fail] = release(?m);
    if (sel r.err)             { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

# append `p` to `tiles` as the directory `d` of an image whose next relative address is `rva`
fun place(m: *Coff, tiles: *Table[Piece], p: Piece, d: *DataDirectory, rva: *u64) bool {
    val len: res[u64, Fail] = piece_len(m, ?p);
    if (sel len.err) { ret false; }
    val r: res[Id[Piece], Fail] = table.push[Piece](tiles, p);
    if (sel r.err) { ret false; }
    d.rva  = (@rva)::u32;
    d.size = len.ok::u32;
    @rva   = @rva + len.ok;
    ret true;
}

test model__data_directories_return_their_typed_records {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:   *A.Allocator = T.allocator_of(?t);
    var m:   Coff         = make(a, Shape{object: ?REGULAR, image: opt[*ImageShape].some{?PE32PLUS}});
    var img: Image        = make_image(a);
    img.headers_size = 0x200;
    val grown: res[Id[DataDirectory], Fail] = table.grow[DataDirectory](?img.dirs, 15);
    if (sel grown.err) { ret 1; }
    val d0: *DataDirectory = table.items[DataDirectory](?img.dirs);
    m.optional = Optional.image{img};
    var sec:   Section      = header_only(a, 0x1000, 0, 0x400, 0);
    var tiles: Table[Piece] = table.make[Piece](a);
    var rva:   u64          = 0x1000;
    var ok:    bool         = true;
    ok = ok && place(?m, ?tiles, Piece.exports{ExportDirectory{timestamp: 0xe1}}, ?d0[tables.IMAGE_DIRECTORY_ENTRY_EXPORT.value::usize], ?rva);
    ok = ok && place(?m, ?tiles, Piece.imports{one[ImportDescriptor](a, ImportDescriptor{name_rva: 0x77})}, ?d0[tables.IMAGE_DIRECTORY_ENTRY_IMPORT.value::usize], ?rva);
    ok = ok && place(?m, ?tiles, Piece.resource_dir{ResourceDirectory{named: 1, entries: one[ResourceEntry](a, ResourceEntry{offset: 0x80000010})}}, ?d0[tables.IMAGE_DIRECTORY_ENTRY_RESOURCE.value::usize], ?rva);
    ok = ok && place(?m, ?tiles, Piece.exceptions{Exceptions.arm64{one[RuntimeFunctionArm64](a, RuntimeFunctionArm64{begin: 0x1000, unwind: 5})}}, ?d0[tables.IMAGE_DIRECTORY_ENTRY_EXCEPTION.value::usize], ?rva);
    ok = ok && place(?m, ?tiles, Piece.relocations{one[RelocBlock](a, RelocBlock{page_rva: 0x1000, entries: one[u16](a, 0xa010)})}, ?d0[tables.IMAGE_DIRECTORY_ENTRY_BASERELOC.value::usize], ?rva);
    ok = ok && place(?m, ?tiles, Piece.debug{one[DebugEntry](a, DebugEntry{type: 2})}, ?d0[tables.IMAGE_DIRECTORY_ENTRY_DEBUG.value::usize], ?rva);
    ok = ok && place(?m, ?tiles, Piece.tls{Tls{zero_fill: 0x10}}, ?d0[tables.IMAGE_DIRECTORY_ENTRY_TLS.value::usize], ?rva);
    ok = ok && place(?m, ?tiles, Piece.load_config{LoadConfig{size: 0x140, security_cookie: 0xc0ffee}}, ?d0[tables.IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG.value::usize], ?rva);
    ok = ok && place(?m, ?tiles, Piece.bound_imports{one[BoundImport](a, BoundImport{timestamp: 9})}, ?d0[tables.IMAGE_DIRECTORY_ENTRY_BOUND_IMPORT.value::usize], ?rva);
    ok = ok && place(?m, ?tiles, Piece.pointers{one[u64](a, 0x1234)}, ?d0[tables.IMAGE_DIRECTORY_ENTRY_IAT.value::usize], ?rva);
    ok = ok && place(?m, ?tiles, Piece.delay_imports{one[DelayImport](a, DelayImport{attributes: 1})}, ?d0[tables.IMAGE_DIRECTORY_ENTRY_DELAY_IMPORT.value::usize], ?rva);
    ok = ok && place(?m, ?tiles, Piece.clr{ClrHeader{size: 72}}, ?d0[tables.IMAGE_DIRECTORY_ENTRY_COM_DESCRIPTOR.value::usize], ?rva);
    val length: u64 = rva - 0x1000;
    sec.virtual_size = length::u32;
    sec.raw_size     = length::u32;
    sec.body         = Body.tiled{tiles};
    var certs: Table[Piece] = table.make[Piece](a);
    d0[tables.IMAGE_DIRECTORY_ENTRY_SECURITY.value::usize].rva  = 0x400 + length::u32;
    d0[tables.IMAGE_DIRECTORY_ENTRY_SECURITY.value::usize].size = 8;
    val signed: res[Id[Piece], Fail]   = table.push[Piece](?certs, Piece.certificates{one[Certificate](a, Certificate{revision: 0x200, type: 2})});
    val pushed: res[Id[Section], Fail] = table.push[Section](?m.sections, sec);
    val front:  Extent                 = Extent.raw{Raw{bytes: Held.borrowed{Bytes{data: nil, len: 0x400}}, why: Why.opaque{}}};
    val e0:     res[Id[Extent], Fail]  = table.push[Extent](?m.extents, front);
    val e1:     res[Id[Extent], Fail]  = table.push[Extent](?m.extents, Extent.section{table.nth[Section](0)});
    val e2:     res[Id[Extent], Fail]  = table.push[Extent](?m.extents, Extent.tiled{certs});
    if (!ok || sel signed.err || sel pushed.err || sel e0.err || sel e1.err || sel e2.err) { ret 1; }
    val ex: *ExportDirectory = unwrap[ExportDirectory](exports(?m));
    if (ex == nil || ex.timestamp != 0xe1) { ret 1; }
    val im: *Table[ImportDescriptor] = unwrap[Table[ImportDescriptor]](imports(?m));
    if (im == nil || table.count[ImportDescriptor](im) != 1)                             { ret 1; }
    if (table.at[ImportDescriptor](im, table.nth[ImportDescriptor](0)).name_rva != 0x77) { ret 1; }
    val rs: *ResourceDirectory = unwrap[ResourceDirectory](resources(?m));
    if (rs == nil || rs.named != 1) { ret 1; }
    val ec: *Exceptions = unwrap[Exceptions](exceptions(?m));
    if (ec == nil || !sel ec.arm64) { ret 1; }
    val ce: *Table[Certificate] = unwrap[Table[Certificate]](certificates(?m));
    if (ce == nil || table.at[Certificate](ce, table.nth[Certificate](0)).revision != 0x200) { ret 1; }
    val br: *Table[RelocBlock] = unwrap[Table[RelocBlock]](base_relocations(?m));
    if (br == nil || table.at[RelocBlock](br, table.nth[RelocBlock](0)).page_rva != 0x1000) { ret 1; }
    val db: *Table[DebugEntry] = unwrap[Table[DebugEntry]](debug(?m));
    if (db == nil || table.at[DebugEntry](db, table.nth[DebugEntry](0)).type != 2) { ret 1; }
    val tl: *Tls = unwrap[Tls](tls(?m));
    if (tl == nil || tl.zero_fill != 0x10) { ret 1; }
    val lc: *LoadConfig = unwrap[LoadConfig](load_config(?m));
    if (lc == nil || lc.security_cookie != 0xc0ffee) { ret 1; }
    val bi: *Table[BoundImport] = unwrap[Table[BoundImport]](bound_imports(?m));
    if (bi == nil || table.at[BoundImport](bi, table.nth[BoundImport](0)).timestamp != 9) { ret 1; }
    val ia: *Table[u64] = unwrap[Table[u64]](iat(?m));
    if (ia == nil || @table.at[u64](ia, table.nth[u64](0)) != 0x1234) { ret 1; }
    val dl: *Table[DelayImport] = unwrap[Table[DelayImport]](delay_imports(?m));
    if (dl == nil || table.at[DelayImport](dl, table.nth[DelayImport](0)).attributes != 1) { ret 1; }
    val cl: *ClrHeader = unwrap[ClrHeader](clr(?m));
    if (cl == nil || cl.size != 72) { ret 1; }
    d0[tables.IMAGE_DIRECTORY_ENTRY_COM_DESCRIPTOR.value::usize].rva  = 0;
    d0[tables.IMAGE_DIRECTORY_ENTRY_COM_DESCRIPTOR.value::usize].size = 0;
    if (!missing[ClrHeader](clr(?m))) { ret 1; }
    val r: err[Fail] = release(?m);
    if (sel r.err)             { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}

# whether `r` failed as malformed at the `index`th `record`
fun refused_at[T](r: res[T, Fail], record: str, index: u64) bool {
    if (!sel r.err) { ret false; }
    val f: Fail = r.err;
    if (!sel f.cause.malformed) { ret false; }
    if (!f.at.indexed)          { ret false; }
    if (f.at.index != index)    { ret false; }
    ret str_equals(f.at.record, record);
}

# whether `r` resolved to the symbol table record `index`
fun is_symbol(r: res[Id[Entry], Fail], index: u32) bool {
    if (sel r.err) { ret false; }
    ret r.ok.index == index;
}

# whether `r` resolved to nothing, or to the table item `index` when `some`
fun is_item[T](r: res[opt[Id[T]], Fail], some: bool, index: u32) bool {
    if (sel r.err)     { ret false; }
    if (!some)         { ret sel r.ok.none; }
    if (sel r.ok.none) { ret false; }
    ret r.ok.some.index == index;
}

# whether `r` resolved to the section `index`
fun is_section(r: res[SectionRef, Fail], index: u32) bool {
    if (sel r.err)         { ret false; }
    if (!sel r.ok.section) { ret false; }
    ret r.ok.section.index == index;
}

# which special number `r` resolved to: 1 undefined, 2 absolute, 3 debug, and 0
# for a failure or a section
fun special(r: res[SectionRef, Fail]) u8 {
    if (sel r.err)          { ret 0; }
    if (sel r.ok.undefined) { ret 1; }
    if (sel r.ok.absolute)  { ret 2; }
    if (sel r.ok.debug)     { ret 3; }
    ret 0;
}

test model__reference_accessors_resolve_in_range_and_refuse_out_of_range {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a: *A.Allocator = T.allocator_of(?t);
    var m: Coff         = make(a, Shape{object: ?REGULAR, image: opt[*ImageShape].none{}});
    var k: usize        = 0;
    for (k < 3) {
        val s: res[Id[Section], Fail] = table.push[Section](?m.sections, header_only(a, 0, 0, 0, 0));
        if (sel s.err) { ret 1; }
        k = k + 1;
    }
    val sec0: *Section = section_at(?m, table.nth[Section](0));
    val sec1: *Section = section_at(?m, table.nth[Section](1));
    sec1.line_ptr = 0x100;
    val ls: [3]Line              = [3]Line{Line{key: 1}, Line{key: 99}, Line{key: 0x50, line: 5}};
    val rs: [3]Reloc             = [3]Reloc{Reloc{symbol: 1}, Reloc{symbol: 50}, Reloc{symbol: 3}};
    val pl: res[Id[Line], Fail]  = table.extend[Line](?sec1.lines, ?ls[0], 3);
    val pr: res[Id[Reloc], Fail] = table.extend[Reloc](?sec0.relocs, ?rs[0], 3);
    if (sel pl.err || sel pr.err) { ret 1; }
    var blank: [20]u8;
    val es:    [4]Entry = [4]Entry{
        Entry.symbol{Symbol{section: 2}},
        Entry.symbol{Symbol{section: 9}},
        Entry.symbol{Symbol{class: tables.IMAGE_SYM_CLASS_WEAK_EXTERNAL.value::u8, naux: 1}},
        Entry.aux{Aux.raw{RawAux{bytes: blank, why: Why.opaque{}}}},
    };
    val pe: res[Id[Entry], Fail] = table.extend[Entry](?m.symbols, ?es[0], 4);
    if (sel pe.err) { ret 1; }
    val at0:  Id[Entry] = table.nth[Entry](0);
    val at1:  Id[Entry] = table.nth[Entry](1);
    var good: Symbol    = Symbol{section: 2};
    var past: Symbol    = Symbol{section: 9};
    if (!is_section(symbol_section(?m, at0, ?good), 1))                       { ret 1; }
    if (!refused_at[SectionRef](symbol_section(?m, at1, ?past), "symbol", 1)) { ret 1; }
    var edge: Symbol = Symbol{section: 4};
    if (!refused_at[SectionRef](symbol_section(?m, at1, ?edge), "symbol", 1)) { ret 1; }
    edge.section = 3;
    if (!is_section(symbol_section(?m, at1, ?edge), 2)) { ret 1; }
    edge.section = -1;
    if (special(symbol_section(?m, at0, ?edge)) != 2) { ret 1; }
    edge.section = -2;
    if (special(symbol_section(?m, at0, ?edge)) != 3) { ret 1; }
    edge.section = 0;
    if (special(symbol_section(?m, at0, ?edge)) != 1) { ret 1; }
    edge.section = -3;
    if (!refused_at[SectionRef](symbol_section(?m, at1, ?edge), "symbol", 1)) { ret 1; }
    val relocs: *Reloc = table.items[Reloc](?sec0.relocs);
    if (!is_symbol(reloc_symbol(?m, table.nth[Reloc](0), ?relocs[0]), 1))                           { ret 1; }
    if (!refused_at[Id[Entry]](reloc_symbol(?m, table.nth[Reloc](1), ?relocs[1]), "relocation", 1)) { ret 1; }
    if (!refused_at[Id[Entry]](reloc_symbol(?m, table.nth[Reloc](2), ?relocs[2]), "relocation", 2)) { ret 1; }
    val lines: *Line = table.items[Line](?sec1.lines);
    if (!is_item[Entry](line_symbol(?m, table.nth[Line](0), ?lines[0]), true, 1))                      { ret 1; }
    if (!refused_at[opt[Id[Entry]]](line_symbol(?m, table.nth[Line](1), ?lines[1]), "line number", 1)) { ret 1; }
    if (!is_item[Entry](line_symbol(?m, table.nth[Line](2), ?lines[2]), false, 0))                     { ret 1; }
    val here: Id[Entry] = table.nth[Entry](3);
    var weak: WeakAux   = WeakAux{tag_index: 1};
    if (!is_symbol(weak_fallback(?m, here, ?weak), 1)) { ret 1; }
    weak.tag_index = 40;
    if (!refused_at[Id[Entry]](weak_fallback(?m, here, ?weak), "auxiliary record", 3)) { ret 1; }
    var func: FunctionAux = FunctionAux{tag_index: 1, next_function: 2, line_ptr: 0x106};
    val sec:  Id[Section] = table.nth[Section](1);
    if (!is_item[Entry](function_tag(?m, here, ?func), true, 1))      { ret 1; }
    if (!is_item[Entry](function_next(?m, here, ?func), true, 2))     { ret 1; }
    if (!is_item[Line](function_line(?m, here, ?func, sec), true, 1)) { ret 1; }
    func = FunctionAux{tag_index: 40, next_function: 41, line_ptr: 0x112};
    if (!refused_at[opt[Id[Entry]]](function_tag(?m, here, ?func), "auxiliary record", 3))      { ret 1; }
    if (!refused_at[opt[Id[Entry]]](function_next(?m, here, ?func), "auxiliary record", 3))     { ret 1; }
    if (!refused_at[opt[Id[Line]]](function_line(?m, here, ?func, sec), "auxiliary record", 3)) { ret 1; }
    func = FunctionAux{};
    if (!is_item[Entry](function_next(?m, here, ?func), false, 0)) { ret 1; }
    var block: BlockAux = BlockAux{next_function: 1};
    if (!is_item[Entry](block_next(?m, here, ?block), true, 1)) { ret 1; }
    block.next_function = 41;
    if (!refused_at[opt[Id[Entry]]](block_next(?m, here, ?block), "auxiliary record", 3)) { ret 1; }
    var def: SectionAux = SectionAux{number: 2, selection: tables.IMAGE_COMDAT_SELECT_ASSOCIATIVE.value::u8};
    if (!is_item[Section](associative_section(?m, here, ?def), true, 1)) { ret 1; }
    def.number = 4;
    if (!refused_at[opt[Id[Section]]](associative_section(?m, here, ?def), "auxiliary record", 3)) { ret 1; }
    def.selection = 1;
    if (!is_item[Section](associative_section(?m, here, ?def), false, 0)) { ret 1; }
    var clr: ClrAux = ClrAux{symbol_index: 2};
    if (!is_symbol(clr_symbol(?m, here, ?clr), 2)) { ret 1; }
    clr.symbol_index = 3;
    if (!refused_at[Id[Entry]](clr_symbol(?m, here, ?clr), "auxiliary record", 3)) { ret 1; }
    val dir: ExportDirectory    = ExportDirectory{address_count: 2};
    val ea0: res[Id[u32], Fail] = export_address(?dir, table.nth[u16](0), 1);
    if (sel ea0.err)                                                                           { ret 1; }
    if (ea0.ok.index != 1)                                                                     { ret 1; }
    if (!refused_at[Id[u32]](export_address(?dir, table.nth[u16](1), 2), "export ordinal", 1)) { ret 1; }
    val r: err[Fail] = release(?m);
    if (sel r.err)             { ret 1; }
    if (T.live_count(?t) != 0) { ret 1; }
    T.dnit(?t);
    ret 0;
}
