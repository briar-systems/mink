# rule tables: rows a table selects among by capability masks
#
# a row asks of each of its axes that a capability set hold every capability
# the axis needs and none it denies. the rows of one table are pairwise
# disjoint, so at most one row holds for any input and the order rows are
# written in carries no meaning. two rows overlap when, on every axis, neither
# needs what the other denies, since some set then holds both. a refusal of
# an overlapping pair names the first pair by the order rows are written in,
# both rows of it.
#
# a table a lookup runs on per input looks its rows up through an `Index`,
# built once from the rows by `index`. the index splits the rows into buckets
# by the capabilities of the axes that split them most, chosen from the rows
# alone, and a lookup reads only the bucket the input's key bits select. two
# rows that can both hold share the bucket of every input holding both, so
# building the index proves the rows disjoint by checking pairs within buckets
# only. a table nothing looks up per input checks its rows with `disjoint`.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;

use mink.fail;
use mink.fail.Fail;
use mink.table;
use mink.table.Id;
use mink.table.Table;

# what one axis of a row asks of a capability set: every capability of `need`
# and none of `deny`. a zero axis holds for any set
pub rec Axis {
    need: u64;
    deny: u64;
}

# whether the capability set `c` holds every capability `x` needs and none it
# denies
pub fun holds(x: *Axis, c: u64) bool {
    ret (c & x.need) == x.need && (c & x.deny) == 0;
}

# whether some capability set holds both `a` and `b`
pub fun meets(a: *Axis, b: *Axis) bool {
    ret (a.need & b.deny) == 0 && (b.need & a.deny) == 0;
}

# refuse the `count` rows from `rows` when two of them can both hold, naming
# the first of the pair as the record and the second as the subject
# ---
# meet: whether some input holds both rows, by `meets` on every axis
# name: a row's name
pub fun disjoint[R](rows: *R, count: usize, meet: fun(*R, *R) bool, name: fun(*R) str) err[Fail] {
    var i: usize = 0;
    for (i < count) {
        var j: usize = i + 1;
        for (j < count) {
            if (meet(?rows[i], ?rows[j])) { ret err[Fail].err{overlap[R](rows, i, j, name)}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[Fail].ok{};
}

# the refusal of rows `i` and `j` of `rows` both holding, naming the first as
# the record and the second as the subject
fun overlap[R](rows: *R, i: usize, j: usize, name: fun(*R) str) Fail {
    val f: Fail = fail.in_record(fail.internal("two rows of a rule table can both hold"), name(?rows[i]));
    ret fail.about(f, name(?rows[j]));
}

# the most key bits an index splits its rows by, so it holds at most 4096
# buckets
val KEY_BITS: usize = 12;

# the most rows one bucket of an index holds, so a lookup reads at most this
# many rows. a table whose rows split no finer is refused
val BUCKET_LIMIT: usize = 8;

# the most entries an index holds
val ENTRY_LIMIT: usize = 0xffffffff;

# one capability of one axis an index keys its rows on
pub rec Bit {
    axis: usize;
    mask: u64;
}

# the rows of a disjoint table by bucket. a bucket is a value of the key bits,
# the first bit chosen the highest, and holds every row the inputs of that
# value may hold
# ---
# bits:    the key bits
# starts:  where each bucket's rows begin in entries, and one past the last
# entries: each bucket's rows by index, in the order the table writes them
pub rec Index {
    bits:    Table[Bit];
    starts:  Table[u32];
    entries: Table[u32];
}

# index the `count` rows from `rows` of the table named `table`, each with
# `axes` axes, refusing two rows that can both hold and rows that leave a
# bucket past its ceiling
# ---
# axis: the axis of a row by its place, 0 up to axes
# name: a row's name
pub fun index[R](a: *A.Allocator, table_name: str, rows: *R, count: usize, axes: usize, axis: fun(*R, usize) *Axis, name: fun(*R) str) res[Index, Fail] {
    var x: Index      = Index{bits: table.make[Bit](a), starts: table.make[u32](a), entries: table.make[u32](a)};
    var e: err[Fail]  = split[R](?x, rows, count, axes, axis);
    if (sel e.ok) { e = ceiling(?x, table_name); }
    if (sel e.ok) { e = apart[R](?x, rows, axes, axis, name); }
    if (sel e.err) {
        val r: err[Fail] = release(?x);
        ret res[Index, Fail].err{e.err};
    }
    ret res[Index, Fail].ok{x};
}

# the place of the one row of `rows`, as indexed by `x`, whose every axis
# holds the capability set `caps` holds at that axis's place
pub fun find[R](x: *Index, rows: *R, axes: usize, axis: fun(*R, usize) *Axis, caps: *u64) opt[usize] {
    val bits: *Bit  = table.items[Bit](?x.bits);
    var key:  usize = 0;
    var k:    usize = 0;
    for (k < table.count[Bit](?x.bits)) {
        key = key * 2 + ((caps[bits[k].axis] & bits[k].mask) != 0)::usize;
        k   = k + 1;
    }
    val starts:  *u32  = table.items[u32](?x.starts);
    val entries: *u32  = table.items[u32](?x.entries);
    var i:       usize = starts[key]::usize;
    for (i < starts[key + 1]::usize) {
        val at: usize = entries[i]::usize;
        if (all[R](?rows[at], axes, axis, caps)) { ret opt[usize].some{at}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

pub fun release(x: *Index) err[Fail] {
    val b: err[Fail] = table.release[Bit](?x.bits);
    val s: err[Fail] = table.release[u32](?x.starts);
    val e: err[Fail] = table.release[u32](?x.entries);
    if (sel b.err) { ret b; }
    if (sel s.err) { ret s; }
    ret e;
}

fun all[R](w: *R, axes: usize, axis: fun(*R, usize) *Axis, caps: *u64) bool {
    var ax: usize = 0;
    for (ax < axes) {
        if (!holds(axis(w, ax), caps[ax])) { ret false; }
        ax = ax + 1;
    }
    ret true;
}

# split the rows by key bit while a bit lowers the sum of the squared bucket
# sizes, the rows a lookup reads weighed by how many inputs reach them
fun split[R](x: *Index, rows: *R, count: usize, axes: usize, axis: fun(*R, usize) *Axis) err[Fail] {
    if (count > ENTRY_LIMIT) { ret err[Fail].err{fail.internal("a rule table has more rows than an index holds")}; }
    val s0: res[Id[u32], Fail] = table.push[u32](?x.starts, 0);
    if (sel s0.err) { ret err[Fail].err{s0.err}; }
    val s1: res[Id[u32], Fail] = table.push[u32](?x.starts, count::u32);
    if (sel s1.err) { ret err[Fail].err{s1.err}; }
    var i: usize = 0;
    for (i < count) {
        val p: res[Id[u32], Fail] = table.push[u32](?x.entries, i::u32);
        if (sel p.err) { ret err[Fail].err{p.err}; }
        i = i + 1;
    }
    for (table.count[Bit](?x.bits) < KEY_BITS) {
        var low:   u64  = squares(x);
        var best:  Bit  = Bit{};
        var found: bool = false;
        var ax:    usize = 0;
        for (ax < axes) {
            var named: u64 = 0;
            i = 0;
            for (i < count) {
                val w: *Axis = axis(?rows[i], ax);
                named = named | w.need | w.deny;
                i     = i + 1;
            }
            var p: u64 = 0;
            for (p < 64) {
                val m: u64 = 1u64 << p;
                p = p + 1;
                if ((named & m) == 0) { cnt; }
                val s: u64 = score[R](x, rows, ax, m, axis);
                if (s < low) {
                    low   = s;
                    best  = Bit{axis: ax, mask: m};
                    found = true;
                }
            }
            ax = ax + 1;
        }
        if (!found) { brk; }
        val e: err[Fail] = apply[R](x, rows, best, axis);
        if (sel e.err) { ret e; }
    }
    ret err[Fail].ok{};
}

fun ceiling(x: *Index, table_name: str) err[Fail] {
    val starts: *u32  = table.items[u32](?x.starts);
    var b:      usize = 0;
    for (b + 1 < table.count[u32](?x.starts)) {
        val n: usize = (starts[b + 1] - starts[b])::usize;
        if (n > BUCKET_LIMIT) {
            val f: Fail = fail.in_record(fail.internal("the rows of a rule table leave an index bucket past its ceiling"), table_name);
            ret err[Fail].err{fail.valued(f, n::i128)};
        }
        b = b + 1;
    }
    ret err[Fail].ok{};
}

fun squares(x: *Index) u64 {
    val starts: *u32  = table.items[u32](?x.starts);
    var s:      u64   = 0;
    var b:      usize = 0;
    for (b + 1 < table.count[u32](?x.starts)) {
        val n: u64 = (starts[b + 1] - starts[b])::u64;
        s = s + n * n;
        b = b + 1;
    }
    ret s;
}

# the sum of the squared bucket sizes once every bucket splits by the
# capability `m` of axis `ax`
fun score[R](x: *Index, rows: *R, ax: usize, m: u64, axis: fun(*R, usize) *Axis) u64 {
    val starts:  *u32  = table.items[u32](?x.starts);
    val entries: *u32  = table.items[u32](?x.entries);
    var s:       u64   = 0;
    var b:       usize = 0;
    for (b + 1 < table.count[u32](?x.starts)) {
        var c0: u64   = 0;
        var c1: u64   = 0;
        var i:  usize = starts[b]::usize;
        for (i < starts[b + 1]::usize) {
            val w: *Axis = axis(?rows[entries[i]::usize], ax);
            if ((w.need & m) == 0) { c0 = c0 + 1; }
            if ((w.deny & m) == 0) { c1 = c1 + 1; }
            i = i + 1;
        }
        s = s + c0 * c0 + c1 * c1;
        b = b + 1;
    }
    ret s;
}

# split every bucket of `x` in two by the key bit `k`, without the capability
# then with it
fun apply[R](x: *Index, rows: *R, k: Bit, axis: fun(*R, usize) *Axis) err[Fail] {
    var starts:  Table[u32] = table.make[u32](x.starts.a);
    var entries: Table[u32] = table.make[u32](x.entries.a);
    val e:       err[Fail]  = halve[R](x, rows, k, axis, ?starts, ?entries);
    if (sel e.err) {
        val rs: err[Fail] = table.release[u32](?starts);
        val re: err[Fail] = table.release[u32](?entries);
        ret e;
    }
    val rs: err[Fail] = table.release[u32](?x.starts);
    val re: err[Fail] = table.release[u32](?x.entries);
    x.starts  = starts;
    x.entries = entries;
    if (sel rs.err) { ret rs; }
    if (sel re.err) { ret re; }
    val b: res[Id[Bit], Fail] = table.push[Bit](?x.bits, k);
    if (sel b.err) { ret err[Fail].err{b.err}; }
    ret err[Fail].ok{};
}

fun halve[R](x: *Index, rows: *R, k: Bit, axis: fun(*R, usize) *Axis, starts: *Table[u32], entries: *Table[u32]) err[Fail] {
    val at:   *u32 = table.items[u32](?x.starts);
    val held: *u32 = table.items[u32](?x.entries);
    val s0:   res[Id[u32], Fail] = table.push[u32](starts, 0);
    if (sel s0.err) { ret err[Fail].err{s0.err}; }
    var b: usize = 0;
    for (b + 1 < table.count[u32](?x.starts)) {
        var v: u64 = 0;
        for (v < 2) {
            var i: usize = at[b]::usize;
            for (i < at[b + 1]::usize) {
                val w: *Axis = axis(?rows[held[i]::usize], k.axis);
                i = i + 1;
                if (v == 0 && (w.need & k.mask) != 0) { cnt; }
                if (v == 1 && (w.deny & k.mask) != 0) { cnt; }
                if (table.count[u32](entries) >= ENTRY_LIMIT) { ret err[Fail].err{fail.internal("a rule table's index outgrows its entries")}; }
                val p: res[Id[u32], Fail] = table.push[u32](entries, held[i - 1]);
                if (sel p.err) { ret err[Fail].err{p.err}; }
            }
            val s: res[Id[u32], Fail] = table.push[u32](starts, table.count[u32](entries)::u32);
            if (sel s.err) { ret err[Fail].err{s.err}; }
            v = v + 1;
        }
        b = b + 1;
    }
    ret err[Fail].ok{};
}

# refuse the first pair of rows, by the order the table writes them, that can
# both hold. such a pair shares a bucket, so only pairs within one are read
fun apart[R](x: *Index, rows: *R, axes: usize, axis: fun(*R, usize) *Axis, name: fun(*R) str) err[Fail] {
    val starts:  *u32  = table.items[u32](?x.starts);
    val entries: *u32  = table.items[u32](?x.entries);
    var first:   usize = 0;
    var second:  usize = 0;
    var found:   bool  = false;
    var b:       usize = 0;
    for (b + 1 < table.count[u32](?x.starts)) {
        var i: usize = starts[b]::usize;
        for (i < starts[b + 1]::usize) {
            var j: usize = i + 1;
            for (j < starts[b + 1]::usize) {
                val ri: usize = entries[i]::usize;
                val rj: usize = entries[j]::usize;
                j = j + 1;
                if (found && (ri > first || (ri == first && rj >= second))) { cnt; }
                if (meet_all[R](?rows[ri], ?rows[rj], axes, axis)) {
                    first  = ri;
                    second = rj;
                    found  = true;
                }
            }
            i = i + 1;
        }
        b = b + 1;
    }
    if (found) { ret err[Fail].err{overlap[R](rows, first, second, name)}; }
    ret err[Fail].ok{};
}

fun meet_all[R](p: *R, q: *R, axes: usize, axis: fun(*R, usize) *Axis) bool {
    var ax: usize = 0;
    for (ax < axes) {
        if (!meets(axis(p, ax), axis(q, ax))) { ret false; }
        ax = ax + 1;
    }
    ret true;
}

rec Sample {
    name: str;
    a:    Axis;
    b:    Axis;
}

fun sample_meet(x: *Sample, y: *Sample) bool {
    ret meets(?x.a, ?y.a) && meets(?x.b, ?y.b);
}

fun sample_name(x: *Sample) str {
    ret x.name;
}

test rule__overlapping_rows_are_refused_naming_both {
    val rows: [3]Sample = [3]Sample{
        Sample{name: "first", a: Axis{need: 0x1}, b: Axis{deny: 0x4}},
        Sample{name: "second", a: Axis{deny: 0x1}},
        Sample{name: "third", a: Axis{need: 0x2}, b: Axis{need: 0x8}},
    };
    val e: err[Fail] = disjoint[Sample](?rows[0], 3, sample_meet, sample_name);
    if (!(sel e.err))                          { ret 1; }
    if (!str_equals(e.err.at.record, "first")) { ret 1; }
    if (!str_equals(e.err.subject, "third"))   { ret 1; }
    ret 0;
}
